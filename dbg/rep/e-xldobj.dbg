     1611   define input parameter p-sheet-num as integer no-undo .
     1612   define buffer buf_lh-sheetf for sheetf.
     1613   define buffer buf_dc-list-hist for dc-list-hist.
     1614     do
     1615     on error undo, return error
     1616     :
     1617       find first buf_dc-list-hist no-lock where buf_dc-list-hist.id = 0 no-error .
     1618       if p-excel then do:
     1619         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1620         FInd first buf_lh-Sheetf where
     1621                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1622         if not avail buf_lh-sheetf then
     1623         create buf_lh-sheetf.
     1624         assign
     1625         buf_lh-Sheetf.Sheet-num = 2
     1626         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1627         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1628         .
     1629         run rep/extitlee.p (input p-sheet-num
     1630                       , input  substitute("История создания списка &1 &2"
     1631                                   ,
     1632   ''
     1633                                   ,(if available buf_dc-list-hist
     1634                                   then buf_dc-list-hist.des
     1635                                   else "БЕЗЫМЯННЫЙ"))
     1636                       ) .
     1637       end.
     1638       if p-text then do:
     1639         Page stream PrnLibStream.
     1640         PUT  STREAM PrnLibStream unformatted
     1641         SPACE(25) substitute("История создания списка &1 &2"
     1642                             , ''
     1643                             ,(if available buf_dc-list-hist
     1644                             then buf_dc-list-hist.des
     1645                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1646         space(25) cur-time-print() skip(1)
     1647         .
     1648         put stream PrnLibStream unformatted
     1649         string("№", "X(9)") chr(32)
     1650         string("Действие", "X(9)") chr(32)
     1651         string("записей", "X(9)") chr(32)
     1652         string(" = итого", "X(12)") chr(32)
     1653         (if page-size(PrnLibStream) > 43
     1654         then string("Множество", "X(" + string(136 - 43) + ")")
     1655         else string("Множество", "X(" + string(198 - 43) + ")")
     1656         )
     1657         skip(0)
     1658         fill('-':U, 9) chr(32)
     1659         fill('-':U, 9) chr(32)
     1660         fill('-':U, 9) chr(32)
     1661         fill('-':U, 12) chr(32)
     1662         (if page-size(PrnLibStream) > 43
     1663         then fill('-':U, 136 - 43)
     1664         else fill('-':U, 198 - 43))
     1665         skip(0)
     1666         .
     1667       end.
     1668       for each buf_dc-list-hist where buf_dc-list-hist.id > 0
     1669       by buf_dc-list-hist.id
     1670       :
     1671         if p-text then do:
     1672           put stream PrnLibStream unformatted
     1673           (if buf_dc-list-hist.line = 0
     1674           then string(buf_dc-list-hist.id, ">>>>>>>>9")
     1675           else fill(chr(32) , 9)
     1676           )  chr(32)
     1677           (if buf_dc-list-hist.item_ <> '':U
     1678           then string(buf_dc-list-hist.hist-mode, "X(8)")
     1679           else fill( chr(32), 8)) chr(32)
     1680           string(buf_dc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1681           string(buf_dc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1682           (if page-size(PrnLibStream) > 43
     1683           then string(buf_dc-list-hist.des, "X(" + string(136 - 43) + ")")
     1684           else string(buf_dc-list-hist.des, "X(" + string(198 - 43) + ")"))
     1685           skip.
     1686         end.
     1687         if p-excel then do:
     1688           if Make-Excel then  put   stream ForExcel unformatted
     1689           (if buf_dc-list-hist.line = 0
     1690           then string(buf_dc-list-hist.id, ">>>>>>>>9")
     1691           else '':U)
     1692           CHR(9)
     1693           (if buf_dc-list-hist.item_ <> '':U
     1694           then buf_dc-list-hist.hist-mode
     1695           else '':U)  CHR(9)
     1696           (if buf_dc-list-hist.item_ <> '':U
     1697           then string(buf_dc-list-hist.num-add, "->>>>>>>>9")
     1698           else '':U)  CHR(9)
     1699           (if buf_dc-list-hist.item_ <> '':U
     1700           then string(buf_dc-list-hist.num-recs, ">>>>>>>>9")
     1701           else '':U)  CHR(9)
     1702           buf_dc-list-hist.des
     1703           skip.
     1704         end.
     1705       end.
     1706     end.
     1707   end procedure.
     1708   define variable     cli-str             as char         no-undo.
     1709   define variable     obj_recids     as char         no-undo.
     1710   define variable     FixGroup            as char         no-undo.
     1711   define variable     FixDCard            as char         no-undo.
     1712   define variable DcardMode as char no-undo init "ALL".
     1713   define variable FIlter-name as char no-undo.
     1714   define variable     ii                      as  integer     no-undo.
     1715   define variable one-firm as logical no-undo init yes.
     1716   define variable     current-gcode   like ub.cli-grp.node-code.
     1717   define variable num-objs as integer no-undo.
     1718   def buffer cli-obj for ub.clients .
     1719   def buffer cli-dcard for ub.clients .
     1720   define variable     Line            as char         no-undo.
     1721   define variable     TotalSum        like ub.dis-obj.gds-tot-rubl no-undo.
     1722   define variable     DiscSum         like ub.dis-obj.gds-dis-rubl no-undo.
     1723   define variable     NettoSum        like ub.dis-obj.pay-tot-rubl no-undo.
     1724   define variable     MustPay         like ub.dis-obj.pay-tot-rubl no-undo.
     1725   define variable     InstantPaySUm   like ub.dis-obj.pay-tot-rubl no-undo.
     1726   define variable     CreditSUm       like ub.dis-obj.pay-tot-rubl no-undo.
     1727   define variable     PaySum          like ub.dis-obj.pay-tot-rubl no-undo.
     1728   define variable     SaldoSUm       like ub.dis-obj.pay-tot-rubl no-undo.
     1729   define variable     MustPayStr      as char no-undo.
     1730   define variable     PaySumStr          as char no-undo.
     1731   define variable     SaldoSUmStr       as char no-undo.
     1732   define variable     FOR-D-PCNT AS CHAR no-undo .
     1733   define variable v-curr-r-b as character no-undo .
     1734   define variable v-dcoveris as character no-undo .
     1735   DEFINE FRAME X123
     1736   ub.dis-obj.d-card     column-label "N карты"
     1737   ub.dis-obj.obj-code   column-label "Маг-н" format "99999"
     1738   sj-cards.cli-name  column-label "Клиент" format "X(28)"
     1739   FOR-d-pcnt   column-label  "Cкидка" format "x(11)"
     1740   TotalSum           column-label "Сумма покупок" format "->>>,>>>,>>9.99"
     1741   DiscSum            column-label "Сумма скидок" format "->>,>>>,>>9.99"
     1742   NettoSum           column-label "Сумма нетто"  format "->>>,>>>,>>9.99"
     1743   InstantPaySum      column-label "Оплачено!на месте"  format "->>>,>>>,>>9.99"
     1744   CreditSum          column-label "В кредит "  format "->,>>>,>>9.99"
     1745   PaySUmStr          column-label "Сумма оплат!по фирме!(данные офиса)"  format "X(15)"
     1746   SaldoSumStr        column-label "Сальдо карты!(данные офиса)"  format "X(15)"
     1747   MustPayStr         column-label "К оплате!по карте!(данные офиса)" format "X(15)"
     1748   ub.dis-obj.num-chk column-label "Чеков" format "-99999"
     1749   HEADER cur-time-print() AT 5 format "x(35)"
     1750                   "Страница " AT 100 PAGE-NUMBER( PrnLibStream )
     1751                       AT 110 FORMAT ">>9" SKIP
     1752               Line format "X(198)" AT 1
     1753   with width 232 down stream-io use-text .
     1754   DEFINE VARIABLE RS-sort AS CHARACTER
     1755        VIEW-AS RADIO-SET VERTICAL
     1756        RADIO-BUTTONS
     1757             "N карты/Магазин", "shop":U,
     1758   "Магазин/N карты", "card":U,
     1759   "Магазин/группа/N карты", "group":U,
     1760   "Сумма покупок (брутто)", "tot":U,
     1761   "Сумма оплат", "sum":U
     1762        SIZE 30.4 BY 3.8 NO-UNDO.
     1763   DEFINE VARIABLE SelectClient AS CHARACTER
     1764        VIEW-AS RADIO-SET VERTICAL
     1765        RADIO-BUTTONS
     1766             "Все", "all":U,
     1767   "Выборочно по группам", "group":U,
     1768   "Выборочно по картам", "card":U
     1769        SIZE 30.6 BY 3.53 NO-UNDO.
     1770   DEFINE RECTANGLE RECT-3
     1771        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1772        SIZE 46.6 BY 5.43.
     1773   DEFINE RECTANGLE RECT-4
     1774        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1775        SIZE 46.4 BY 5.2.
     1776   DEFINE RECTANGLE RECT-5
     1777        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1778        SIZE 46.3 BY 3.
     1779   DEFINE VARIABLE t-legacy AS LOGICAL INITIAL no
     1780        LABEL "С учетом перевыпуска карт"
     1781        VIEW-AS TOGGLE-BOX
     1782        SIZE 28 BY 1 NO-UNDO.
     1783   DEFINE VARIABLE t-subsid AS LOGICAL INITIAL no
     1784        LABEL "С учетом дополн. карт"
     1785        VIEW-AS TOGGLE-BOX
     1786        SIZE 28 BY 1 NO-UNDO.
     1787   DEFINE VARIABLE TotalOnly AS LOGICAL INITIAL no
     1788        LABEL "Только итоги"
     1789        VIEW-AS TOGGLE-BOX
     1790        SIZE 15.8 BY 1 NO-UNDO.
     1791   DEFINE FRAME F-Main
     1792        SelectClient AT ROW 2.67 COL 3.8 NO-LABEL
     1793        RS-sort AT ROW 8.13 COL 4 NO-LABEL
     1794        t-legacy AT ROW 13 COL 19.5
     1795        TotalOnly AT ROW 13.6 COL 4
     1796        t-subsid AT ROW 14.33 COL 19.5
     1797        "Покупатели" VIEW-AS TEXT
     1798             SIZE 31.1 BY .83 AT ROW 1.5 COL 3.6
     1799             FGCOLOR 4
     1800        "Сортировка" VIEW-AS TEXT
     1801             SIZE 30.1 BY .8 AT ROW 7.17 COL 3.9
     1802             FGCOLOR 4
     1803        "Представление" VIEW-AS TEXT
     1804             SIZE 13.9 BY .93 AT ROW 12.6 COL 4.1
     1805             FGCOLOR 4
     1806        RECT-3 AT ROW 1.2 COL 2
     1807        RECT-4 AT ROW 6.97 COL 2.3
     1808        RECT-5 AT ROW 12.47 COL 2.4
     1809       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1810            SIDE-LABELS NO-UNDERLINE THREE-D
     1811            AT COL 1 ROW 1
     1812            SIZE 49 BY 14.58.
     1813   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1814   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1815   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1816   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1817   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1818   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1819   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1820   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1821       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1822   RUN ensure-broker.
     1823   THIS-PROCEDURE:ADM-DATA =
     1824        'ADM1.1~`':U +
     1825        'SmartObject~`':U +
     1826        'FRAME~`':U +
     1827        'NO ~`':U +
     1828        '~`':U +
     1829        '~`':U +
     1830        '~`':U +
     1831        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1832           + "~`":U +
     1833        'Layout,Hide-on-Init~`':U +
     1834        '~`':U +
     1835        '~`':U +
     1836        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1837        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1838            THEN "^^":U
     1839        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1840             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1841   PROCEDURE adm-apply-entry :
     1842     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1843   END PROCEDURE.
     1844   PROCEDURE adm-destroy :
     1845    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1846   END PROCEDURE.
     1847   PROCEDURE adm-disable :
     1848       DISABLE RECT-3 RECT-4 RECT-5 SelectClient RS-sort t-legacy TotalOnly t-subsid WITH FRAME F-Main.
     1849       RUN dispatch ('disable-fields':U).
     1850       RUN set-attribute-list ('ENABLED=no':U).
     1851       RETURN.
     1852   END PROCEDURE.
     1853   PROCEDURE adm-edit-attribute-list :
     1854         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1855         RETURN.
     1856   END PROCEDURE.
     1857   PROCEDURE adm-enable :
     1858       ENABLE UNLESS-HIDDEN RECT-3 RECT-4 RECT-5 SelectClient RS-sort t-legacy TotalOnly t-subsid WITH FRAME F-Main.
     1859       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1860       RUN set-attribute-list ('ENABLED=yes':U).
     1861       RETURN.
     1862   END PROCEDURE.
     1863   PROCEDURE adm-exit :
     1864        RUN notify ('exit':U).
     1865     RETURN.
     1866   END PROCEDURE.
     1867   PROCEDURE adm-hide :
     1868     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1869   END PROCEDURE.
     1870   PROCEDURE adm-initialize :
     1871     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1872   END PROCEDURE.
     1873   PROCEDURE adm-show-errors :
     1874       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1875       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1876           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1877       END.
     1878       RETURN.
     1879   END PROCEDURE.
     1880   PROCEDURE adm-UIB-mode :
     1881     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1882   END PROCEDURE.
     1883   PROCEDURE adm-view :
     1884     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1885   END PROCEDURE.
     1886   PROCEDURE dispatch :
     1887       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1888       RUN broker-dispatch IN adm-broker-hdl
     1889           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1890       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1891   END PROCEDURE.
     1892   PROCEDURE ensure-broker :
     1893   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1894   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1895   DO:
     1896       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1897       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1898   END.
     1899   END PROCEDURE.
     1900   PROCEDURE get-attribute :
     1901     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1902     RUN broker-get-attribute IN adm-broker-hdl
     1903         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1904     RETURN RETURN-VALUE.
     1905   END PROCEDURE.
     1906   PROCEDURE get-attribute-list :
     1907     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1908     RUN broker-get-attribute-list IN adm-broker-hdl
     1909         (INPUT THIS-PROCEDURE,
     1910          INPUT ?,
     1911          OUTPUT p-attr-list) NO-ERROR.
     1912     RETURN.
     1913   END PROCEDURE.
     1914   PROCEDURE new-state :
     1915     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1916     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1917     RETURN.
     1918   END PROCEDURE.
     1919   PROCEDURE notify :
     1920     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1921     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1922     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1923         RETURN "ADM-ERROR":U.
     1924     RETURN.
     1925   END PROCEDURE.
     1926   PROCEDURE set-attribute-list :
     1927     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1928     RUN ensure-broker.
     1929     RUN broker-set-attribute-list IN adm-broker-hdl
     1930         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1931     RETURN.
     1932   END PROCEDURE.
     1933   PROCEDURE set-position :
     1934       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1935       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1936       IF VALID-HANDLE(adm-object-hdl) THEN
     1937       DO:
     1938           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1939           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1940           DO:
     1941             IF p-row = 0 THEN p-row =
     1942               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1943             IF p-col = 0 THEN p-col =
     1944               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1945           END.
     1946           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1947           DO:
     1948             parent-hdl = adm-object-hdl:PARENT.
     1949             IF p-row = 0 THEN p-row =
     1950               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1951                 parent-hdl:ROW.
     1952             IF p-col = 0 THEN p-col =
     1953               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1954                 parent-hdl:COL.
     1955           END.
     1956           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1957           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1958         ASSIGN adm-object-hdl:ROW    =   p-row
     1959                adm-object-hdl:COLUMN =   p-col.
     1960       END.
     1961       RETURN.
     1962   END PROCEDURE.
     1963   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1964       STRING(adm-object-hdl)).
     1965   PAUSE 0 BEFORE-HIDE.
     1966   PROCEDURE adm-change-page :
     1967     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1968     END PROCEDURE.
     1969   PROCEDURE delete-page :
     1970     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1971     RUN broker-delete-page IN adm-broker-hdl
     1972         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1973     END PROCEDURE.
     1974   PROCEDURE init-object :
     1975     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1976     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1977     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1978     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1979     RUN broker-init-object IN adm-broker-hdl
     1980         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1981          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1982     RETURN.
     1983   END PROCEDURE.
     1984   PROCEDURE init-pages :
     1985     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1986     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1987         INPUT p-page-list) NO-ERROR.
     1988     END PROCEDURE.
     1989   PROCEDURE select-page :
     1990     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1991     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1992         INPUT p-page#) NO-ERROR.
     1993     END PROCEDURE.
     1994   PROCEDURE view-page :
     1995     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1996     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1997         INPUT p-page#).
     1998     END PROCEDURE.
     1999   ON VALUE-CHANGED OF SelectClient IN FRAME F-Main
     2000   DO:
     2001   DEFINE buffer for-cli-grp for ub.cli-grp.
     2002   define variable ii as integer no-undo .
     2003   Assign SelectClient.
     2004   CASE SelectCLient:
     2005       when "group":U then do:
     2006          run ref/cli-grps.w ( input my-handle
     2007                              ,input "b-sel"
     2008                              ,input-output cli-str ) .
     2009          if cli-str = "" then do:
     2010              assign
     2011              FixGroup = ""
     2012              FIxdcard = ""
     2013              current-gcode = 0
     2014              SelectClient:screen-value = "all":U
     2015              Dcardmode = "ALL":U
     2016              .
     2017          end.
     2018          else do:
     2019             IF num-entries(cli-str) > 1 then do:
     2020             end.
     2021             else do:
     2022                FIND FIRST ub.cli-grp WHERE recid( ub.cli-grp ) = int( cli-str ) NO-LOCK .
     2023                FIND FIRST for-cli-grp No-LOCK WHERE for-cli-grp.upper-code = ub.cli-grp.node-code No-ERROR.
     2024                assign
     2025                FixGroup = ub.cli-grp.node-name
     2026                FIxdcard = ""
     2027                current-gcode = ub.cli-grp.node-code
     2028                Dcardmode = IF AVAIL for-cli-grp then "GROUP-LIST":U else "GROUP":U
     2029                .
     2030             end.
     2031          end.
     2032       end.
     2033       when "all":U then do:
     2034           assign
     2035           FixGroup = ""
     2036           cli-str = ""
     2037           FIxdcard = ""
     2038           current-gcode = 0
     2039           Dcardmode = "ALL":U
     2040           .
     2041       end.
     2042       when "card":U then do:
     2043         run str/dc-list.w (my-handle, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
     2044         assign
     2045         FixDCard = ""
     2046         DcardMode = "LIST":U
     2047         .
     2048         find first dc-list no-lock no-error .
     2049         if not available dc-list then do:
     2050           message
     2051           "В списке карт нет ни одной карты"
     2052           view-as alert-box WARNING.
     2053           assign
     2054           FixGroup = ""
     2055           cli-str = ""
     2056           current-gcode = 0
     2057           FIxdcard = ""
     2058           DcardMode = "ALL":U
     2059           SelectClient:screen-value = "all":U.
     2060           .
     2061         end.
     2062         else do:
     2063           _dc:
     2064           for each dc-list no-lock:
     2065              ii = ii + 1.
     2066             if ii > 1 then do:
     2067               assign
     2068               FixGroup = ""
     2069               current-gcode = 0
     2070               FixDCard = ""
     2071               Dcardmode = "LIST":U
     2072               .
     2073               leave _dc.
     2074             end.
     2075           end.
     2076           if ii = 1 then do:
     2077             find first dc-list.
     2078             FIND FIRST ub.dis-card WHERE ub.dis-card.d-card = dc-list.d-card NO-LOCK .
     2079             assign
     2080             FixGroup = ""
     2081             cli-str = ""
     2082             current-gcode = 0
     2083             FixDCard = ub.dis-card.d-card
     2084             Dcardmode = "ONE":U
     2085             .
     2086           end.
     2087         end.
     2088       end.
     2089   END CASE.
     2090   END.
     2091   ON VALUE-CHANGED OF t-legacy IN FRAME F-Main
     2092   DO:
     2093     if v-dcoveris = "yes" then
     2094      assign T-legacy .
     2095     else do:
     2096       assign t-legacy = no.
     2097       display
     2098       t-legacy
     2099       with frame F-Main .
     2100     end.
     2101   END.
     2102   ON VALUE-CHANGED OF t-subsid IN FRAME F-Main
     2103   DO:
     2104     if v-dcoveris = "yes" then
     2105      assign T-subsid .
     2106     else do:
     2107       assign t-subsid = no.
     2108       display
     2109       t-subsid
     2110       with frame F-Main .
     2111     end.
     2112   END.
     2113   if not this-procedure :persistent
     2114   then do:
     2115     message
     2116       vss-workfile vss-revision vss-description skip
     2117       "Ошибка при запуске процедуры" skip
     2118       "Данную процедуру следует запускать только с параметром persistent" skip
     2119       view-as alert-box error .
     2120     undo, return error .
     2121   end.
     2122   PROCEDURE adm-create-objects :
     2123   END PROCEDURE.
     2124   PROCEDURE adm-row-available :
     2125     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2126     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2127     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2128     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2129     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2130     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2131     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2132     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2133     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2134     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2135     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2136     IF adm-updating-record THEN RETURN.
     2137     RUN get-attribute ('FIELDS-ENABLED':U).
     2138     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2139     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2140         OUTPUT link-handle) NO-ERROR.
     2141     IF link-handle = "":U THEN
     2142         RETURN.
     2143     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2144     IF NUM-ENTRIES(link-handle) > 1 THEN
     2145         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2146             "encountered more than one RECORD-SOURCE.":U SKIP
     2147             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2148                VIEW-AS ALERT-BOX ERROR.
     2149     RUN get-attribute ('Key-Name':U).
     2150     key-name = RETURN-VALUE.
     2151     IF key-name = "":U THEN key-name = ?.
     2152     IF key-name NE ? THEN DO:
     2153       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2154         NO-ERROR.
     2155       IF key-value NE ? THEN
     2156         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2157     END.
     2158   IF VALID-HANDLE (adm-object-hdl) THEN
     2159       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2160   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2161   END PROCEDURE.
     2162   PROCEDURE cardcycle :
     2163   def buffer bsj-cards for sj-cards.
     2164   if t-legacy or t-subsid then do:
     2165     FOR EACH obj-list no-lock ,
     2166         EACH legacy-obj no-lock WHERE
     2167             legacy-obj.obj-type = obj-list.obj-type AND
     2168             legacy-obj.obj-code = obj-list.obj-code,
     2169         FIRST bsj-cards No-LOCK WHERE
     2170               bsj-cards.card-num-chr  = legacy-obj.card-num-chr
     2171            AND bsj-cards.is-sum = yes
     2172         BREAK
     2173         by legacy-obj.obj-type
     2174         by legacy-obj.obj-code
     2175         by legacy-obj.d-card:
     2176       if one-firm and v-curr-r-b = 'base':U then do:
     2177   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2178   if first-of(legacy-obj.obj-code) AND num-objs > 1 then do:
     2179     if not first(legacy-obj.obj-code) then do:
     2180       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2181       DOWN stream PrnLibStream   with frame X123.
     2182     end.
     2183     FIND FIRST ub.clients No-LOCK WHERE
     2184                 ub.clients.obj-type = 'маг':U AND
     2185                 ub.clients.obj-code = legacy-obj.obj-code NO-ERROR.
     2186     DISPLAY STREAM PrnLibStream
     2187     "Магазин" @ ub.dis-obj.d-card
     2188     clients.obj-name @ sj-cards.cli-name
     2189     WITH FRAME X123.
     2190     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2191     DOWN stream PrnLibStream   with frame X123.
     2192   end.
     2193   ACCUMULATE
     2194   bsj-cards.d-card (COUNT BY legacy-obj.obj-code)
     2195   bsj-cards.num-chk (TOTAL BY legacy-obj.obj-code)
     2196   bsj-cards.tot (TOTAL BY legacy-obj.obj-code)
     2197   bsj-cards.disc (TOTAL BY legacy-obj.obj-code)
     2198   bsj-cards.netto (TOTAL BY legacy-obj.obj-code)
     2199   bsj-cards.instant-pay (TOTAL BY legacy-obj.obj-code)
     2200   bsj-cards.credit-pay (TOTAL BY legacy-obj.obj-code)
     2201   bsj-cards.num-chk (TOTAL BY legacy-obj.obj-code)
     2202   .
     2203   IF NOT TOTALONLY then do:
     2204   assign
     2205   PaySUmStr = string(bsj-cards.pay, "->>>,>>>,>>9.99")
     2206   MustPayStr = STRING(bsj-cards.Must-Pay, "->>>,>>>,>>9.99")
     2207   SaldoSumStr = STRING(bsj-cards.saldo, "->>>,>>>,>>9.99")
     2208   .
     2209     DISPLAY STREAM PrnLibStream
     2210     legacy-obj.d-card @ dis-obj.d-card
     2211     legacy-obj.obj-code @ dis-obj.obj-code
     2212     bsj-cards.cli-name @ sj-cards.cli-name
     2213     (if bsj-cards.obj-qnty > 0 then bsj-cards.d-pcntchr else "") @ for-d-pcnt
     2214     legacy-obj.gds-tot-base @ TotalSum
     2215     legacy-obj.gds-dis-base @ DiscSum
     2216     (legacy-obj.gds-tot-base - legacy-obj.gds-dis-base) @ NettoSum
     2217     legacy-obj.pay-tot-base @ InstantPaySum
     2218     (legacy-obj.gds-tot-base - legacy-obj.gds-dis-base  - legacy-obj.pay-tot-base) @ CreditSum
     2219     PaySUmStr
     2220     SaldoSUmstr
     2221     MustPayStr
     2222     legacy-obj.num-chk @ ub.dis-obj.num-chk
     2223     with frame X123 .
     2224   DOWN stream PrnLibStream   with frame X123.
     2225   END.
     2226   if last-of(legacy-obj.obj-code) AND num-objs > 1 then do:
     2227     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2228     DOWN stream PrnLibStream   with frame X123.
     2229     DISPLAY STREAM PrnLibStream
     2230     "ИТОГО по маг-ну" @ dis-obj.d-card
     2231     (string(ACCUM COUNT by legacy-obj.obj-code (bsj-cards.d-card)) + " карт ") @ sj-cards.cli-name
     2232     "" @ for-d-pcnt
     2233     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.tot) @ TotalSum
     2234     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.disc) @ DiscSum
     2235     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.netto)  @ NettoSum
     2236     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2237     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2238     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.num-chk) @ ub.dis-obj.num-chk
     2239     with frame X123 .
     2240     if last( legacy-obj.obj-code ) then do:
     2241       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2242       DOWN stream PrnLibStream   with frame X123.
     2243     end.
     2244   end.
     2245   if last(legacy-obj.obj-code) then do:
     2246     FIND FIRST sj-cards where sj-cards.d-card = ? NO-ERROR.
     2247     DISPLAY STREAM PrnLibStream
     2248     "ИТОГО" @ dis-obj.d-card
     2249     (string(sj-cards.obj-qnty) + " карт") @ sj-cards.cli-name
     2250     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.tot) @ TotalSum
     2251     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.disc) @ DiscSum
     2252     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.netto)  @ NettoSum
     2253     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2254     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2255     sj-cards.pay @ PaySumStr
     2256     sj-cards.Must-pay @ MustPayStr
     2257     sj-cards.saldo @ SaldoSumStr
     2258     ACCUM TOTAL bsj-cards.num-chk   @ ub.dis-obj.num-chk
     2259     with frame X123 .
     2260     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2261   end.
     2262       end.
     2263       else do:
     2264   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2265   if first-of(legacy-obj.obj-code) AND num-objs > 1 then do:
     2266     if not first(legacy-obj.obj-code) then do:
     2267       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2268       DOWN stream PrnLibStream   with frame X123.
     2269     end.
     2270     FIND FIRST ub.clients No-LOCK WHERE
     2271                 ub.clients.obj-type = 'маг':U AND
     2272                 ub.clients.obj-code = legacy-obj.obj-code NO-ERROR.
     2273     DISPLAY STREAM PrnLibStream
     2274     "Магазин" @ ub.dis-obj.d-card
     2275     clients.obj-name @ sj-cards.cli-name
     2276     WITH FRAME X123.
     2277     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2278     DOWN stream PrnLibStream   with frame X123.
     2279   end.
     2280   ACCUMULATE
     2281   bsj-cards.d-card (COUNT BY legacy-obj.obj-code)
     2282   bsj-cards.num-chk (TOTAL BY legacy-obj.obj-code)
     2283   bsj-cards.tot (TOTAL BY legacy-obj.obj-code)
     2284   bsj-cards.disc (TOTAL BY legacy-obj.obj-code)
     2285   bsj-cards.netto (TOTAL BY legacy-obj.obj-code)
     2286   bsj-cards.instant-pay (TOTAL BY legacy-obj.obj-code)
     2287   bsj-cards.credit-pay (TOTAL BY legacy-obj.obj-code)
     2288   bsj-cards.num-chk (TOTAL BY legacy-obj.obj-code)
     2289   .
     2290   IF NOT TOTALONLY then do:
     2291   assign
     2292   PaySUmStr = string(bsj-cards.pay, "->>>,>>>,>>9.99")
     2293   MustPayStr = STRING(bsj-cards.Must-Pay, "->>>,>>>,>>9.99")
     2294   SaldoSumStr = STRING(bsj-cards.saldo, "->>>,>>>,>>9.99")
     2295   .
     2296     DISPLAY STREAM PrnLibStream
     2297     legacy-obj.d-card @ dis-obj.d-card
     2298     legacy-obj.obj-code @ dis-obj.obj-code
     2299     bsj-cards.cli-name @ sj-cards.cli-name
     2300     (if bsj-cards.obj-qnty > 0 then bsj-cards.d-pcntchr else "") @ for-d-pcnt
     2301     legacy-obj.gds-tot-rubl @ TotalSum
     2302     legacy-obj.gds-dis-rubl @ DiscSum
     2303     (legacy-obj.gds-tot-rubl - legacy-obj.gds-dis-rubl) @ NettoSum
     2304     legacy-obj.pay-tot-rubl @ InstantPaySum
     2305     (legacy-obj.gds-tot-rubl - legacy-obj.gds-dis-rubl  - legacy-obj.pay-tot-rubl) @ CreditSum
     2306     PaySUmStr
     2307     SaldoSUmstr
     2308     MustPayStr
     2309     legacy-obj.num-chk @ ub.dis-obj.num-chk
     2310     with frame X123 .
     2311   DOWN stream PrnLibStream   with frame X123.
     2312   END.
     2313   if last-of(legacy-obj.obj-code) AND num-objs > 1 then do:
     2314     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2315     DOWN stream PrnLibStream   with frame X123.
     2316     DISPLAY STREAM PrnLibStream
     2317     "ИТОГО по маг-ну" @ dis-obj.d-card
     2318     (string(ACCUM COUNT by legacy-obj.obj-code (bsj-cards.d-card)) + " карт ") @ sj-cards.cli-name
     2319     "" @ for-d-pcnt
     2320     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.tot) @ TotalSum
     2321     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.disc) @ DiscSum
     2322     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.netto)  @ NettoSum
     2323     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2324     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2325     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.num-chk) @ ub.dis-obj.num-chk
     2326     with frame X123 .
     2327     if last( legacy-obj.obj-code ) then do:
     2328       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2329       DOWN stream PrnLibStream   with frame X123.
     2330     end.
     2331   end.
     2332   if last(legacy-obj.obj-code) then do:
     2333     FIND FIRST sj-cards where sj-cards.d-card = ? NO-ERROR.
     2334     DISPLAY STREAM PrnLibStream
     2335     "ИТОГО" @ dis-obj.d-card
     2336     (string(sj-cards.obj-qnty) + " карт") @ sj-cards.cli-name
     2337     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.tot) @ TotalSum
     2338     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.disc) @ DiscSum
     2339     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.netto)  @ NettoSum
     2340     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2341     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2342     sj-cards.pay @ PaySumStr
     2343     sj-cards.Must-pay @ MustPayStr
     2344     sj-cards.saldo @ SaldoSumStr
     2345     ACCUM TOTAL bsj-cards.num-chk   @ ub.dis-obj.num-chk
     2346     with frame X123 .
     2347     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2348   end.
     2349       ENd.
     2350     end.
     2351   end.
     2352   else do:
     2353    FOR EACH obj-list no-lock ,
     2354       EACH ub.dis-obj no-lock WHERE
     2355            ub.dis-obj.dt-code = 0 AND
     2356            ub.dis-obj.obj-type = obj-list.obj-type AND
     2357            ub.dis-obj.obj-code = obj-list.obj-code,
     2358       FIRST bsj-cards No-LOCK WHERE
     2359             bsj-cards.d-card = ub.dis-obj.d-card
     2360       BREAK by ub.dis-obj.obj-type
     2361             by ub.dis-obj.obj-code
     2362             by ub.dis-obj.d-card:
     2363     if one-firm and v-curr-r-b = 'base':U then do:
     2364   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2365   if first-of(ub.dis-obj.obj-code) AND num-objs > 1 then do:
     2366     if not first(ub.dis-obj.obj-code) then do:
     2367       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2368       DOWN stream PrnLibStream   with frame X123.
     2369     end.
     2370     FIND FIRST ub.clients No-LOCK WHERE
     2371                 ub.clients.obj-type = 'маг':U AND
     2372                 ub.clients.obj-code = ub.dis-obj.obj-code NO-ERROR.
     2373     DISPLAY STREAM PrnLibStream
     2374     "Магазин" @ ub.dis-obj.d-card
     2375     clients.obj-name @ sj-cards.cli-name
     2376     WITH FRAME X123.
     2377     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2378     DOWN stream PrnLibStream   with frame X123.
     2379   end.
     2380   ACCUMULATE
     2381   bsj-cards.d-card (COUNT BY ub.dis-obj.obj-code)
     2382   bsj-cards.num-chk (TOTAL BY ub.dis-obj.obj-code)
     2383   bsj-cards.tot (TOTAL BY ub.dis-obj.obj-code)
     2384   bsj-cards.disc (TOTAL BY ub.dis-obj.obj-code)
     2385   bsj-cards.netto (TOTAL BY ub.dis-obj.obj-code)
     2386   bsj-cards.instant-pay (TOTAL BY ub.dis-obj.obj-code)
     2387   bsj-cards.credit-pay (TOTAL BY ub.dis-obj.obj-code)
     2388   bsj-cards.num-chk (TOTAL BY ub.dis-obj.obj-code)
     2389   .
     2390   IF NOT TOTALONLY then do:
     2391   assign
     2392   PaySUmStr = string(bsj-cards.pay, "->>>,>>>,>>9.99")
     2393   MustPayStr = STRING(bsj-cards.Must-Pay, "->>>,>>>,>>9.99")
     2394   SaldoSumStr = STRING(bsj-cards.saldo, "->>>,>>>,>>9.99")
     2395   .
     2396   DISPLAY STREAM PrnLibStream
     2397   dis-obj.d-card
     2398   dis-obj.obj-code
     2399   bsj-cards.cli-name @ sj-cards.cli-name
     2400   bsj-cards.d-pcntchr @ for-d-pcnt
     2401   (dis-obj.gds-tot-base + dis-obj.sum-tot-base) @ TotalSum
     2402   (dis-obj.gds-dis-base +  dis-obj.sum-dis-base) @ DiscSum
     2403   ((dis-obj.gds-tot-base + dis-obj.sum-tot-base) -
     2404    (dis-obj.gds-dis-base +  dis-obj.sum-dis-base)) @ NettoSum
     2405   dis-obj.pay-tot-base @ InstantPaySum
     2406   ((dis-obj.gds-tot-base + dis-obj.sum-tot-base) -
     2407    (dis-obj.gds-dis-base +  dis-obj.sum-dis-base) -
     2408     dis-obj.pay-tot-base
     2409   )  @ CreditSum
     2410   PaySUmStr
     2411   SaldoSUmstr
     2412   MustPayStr
     2413   ub.dis-obj.num-chk
     2414   with frame X123 .
     2415   DOWN stream PrnLibStream   with frame X123.
     2416   END.
     2417   if last-of(ub.dis-obj.obj-code) AND num-objs > 1 then do:
     2418     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2419     DOWN stream PrnLibStream   with frame X123.
     2420     DISPLAY STREAM PrnLibStream
     2421     "ИТОГО по маг-ну" @ dis-obj.d-card
     2422     (string(ACCUM COUNT by ub.dis-obj.obj-code (bsj-cards.d-card)) + " карт ") @ sj-cards.cli-name
     2423     "" @ for-d-pcnt
     2424     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.tot) @ TotalSum
     2425     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.disc) @ DiscSum
     2426     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.netto)  @ NettoSum
     2427     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2428     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2429     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.num-chk) @ ub.dis-obj.num-chk
     2430     with frame X123 .
     2431     if last( ub.dis-obj.obj-code ) then do:
     2432       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2433       DOWN stream PrnLibStream   with frame X123.
     2434     end.
     2435   end.
     2436   if last(ub.dis-obj.obj-code) then do:
     2437     FIND FIRST sj-cards where sj-cards.d-card = ? NO-ERROR.
     2438     DISPLAY STREAM PrnLibStream
     2439     "ИТОГО" @ dis-obj.d-card
     2440     (string(sj-cards.obj-qnty) + " карт") @ sj-cards.cli-name
     2441     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.tot) @ TotalSum
     2442     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.disc) @ DiscSum
     2443     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.netto)  @ NettoSum
     2444     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2445     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2446     sj-cards.pay @ PaySumStr
     2447     sj-cards.Must-pay @ MustPayStr
     2448     sj-cards.saldo @ SaldoSumStr
     2449     ACCUM TOTAL bsj-cards.num-chk   @ ub.dis-obj.num-chk
     2450     with frame X123 .
     2451     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2452   end.
     2453     end.
     2454     else do:
     2455   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2456   if first-of(ub.dis-obj.obj-code) AND num-objs > 1 then do:
     2457     if not first(ub.dis-obj.obj-code) then do:
     2458       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2459       DOWN stream PrnLibStream   with frame X123.
     2460     end.
     2461     FIND FIRST ub.clients No-LOCK WHERE
     2462                 ub.clients.obj-type = 'маг':U AND
     2463                 ub.clients.obj-code = ub.dis-obj.obj-code NO-ERROR.
     2464     DISPLAY STREAM PrnLibStream
     2465     "Магазин" @ ub.dis-obj.d-card
     2466     clients.obj-name @ sj-cards.cli-name
     2467     WITH FRAME X123.
     2468     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2469     DOWN stream PrnLibStream   with frame X123.
     2470   end.
     2471   ACCUMULATE
     2472   bsj-cards.d-card (COUNT BY ub.dis-obj.obj-code)
     2473   bsj-cards.num-chk (TOTAL BY ub.dis-obj.obj-code)
     2474   bsj-cards.tot (TOTAL BY ub.dis-obj.obj-code)
     2475   bsj-cards.disc (TOTAL BY ub.dis-obj.obj-code)
     2476   bsj-cards.netto (TOTAL BY ub.dis-obj.obj-code)
     2477   bsj-cards.instant-pay (TOTAL BY ub.dis-obj.obj-code)
     2478   bsj-cards.credit-pay (TOTAL BY ub.dis-obj.obj-code)
     2479   bsj-cards.num-chk (TOTAL BY ub.dis-obj.obj-code)
     2480   .
     2481   IF NOT TOTALONLY then do:
     2482   assign
     2483   PaySUmStr = string(bsj-cards.pay, "->>>,>>>,>>9.99")
     2484   MustPayStr = STRING(bsj-cards.Must-Pay, "->>>,>>>,>>9.99")
     2485   SaldoSumStr = STRING(bsj-cards.saldo, "->>>,>>>,>>9.99")
     2486   .
     2487   DISPLAY STREAM PrnLibStream
     2488   dis-obj.d-card
     2489   dis-obj.obj-code
     2490   bsj-cards.cli-name @ sj-cards.cli-name
     2491   bsj-cards.d-pcntchr @ for-d-pcnt
     2492   (dis-obj.gds-tot-rubl + dis-obj.sum-tot-rubl) @ TotalSum
     2493   (dis-obj.gds-dis-rubl +  dis-obj.sum-dis-rubl) @ DiscSum
     2494   ((dis-obj.gds-tot-rubl + dis-obj.sum-tot-rubl) -
     2495    (dis-obj.gds-dis-rubl +  dis-obj.sum-dis-rubl)) @ NettoSum
     2496   dis-obj.pay-tot-rubl @ InstantPaySum
     2497   ((dis-obj.gds-tot-rubl + dis-obj.sum-tot-rubl) -
     2498    (dis-obj.gds-dis-rubl +  dis-obj.sum-dis-rubl) -
     2499     dis-obj.pay-tot-rubl
     2500   )  @ CreditSum
     2501   PaySUmStr
     2502   SaldoSUmstr
     2503   MustPayStr
     2504   ub.dis-obj.num-chk
     2505   with frame X123 .
     2506   DOWN stream PrnLibStream   with frame X123.
     2507   END.
     2508   if last-of(ub.dis-obj.obj-code) AND num-objs > 1 then do:
     2509     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2510     DOWN stream PrnLibStream   with frame X123.
     2511     DISPLAY STREAM PrnLibStream
     2512     "ИТОГО по маг-ну" @ dis-obj.d-card
     2513     (string(ACCUM COUNT by ub.dis-obj.obj-code (bsj-cards.d-card)) + " карт ") @ sj-cards.cli-name
     2514     "" @ for-d-pcnt
     2515     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.tot) @ TotalSum
     2516     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.disc) @ DiscSum
     2517     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.netto)  @ NettoSum
     2518     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2519     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2520     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.num-chk) @ ub.dis-obj.num-chk
     2521     with frame X123 .
     2522     if last( ub.dis-obj.obj-code ) then do:
     2523       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2524       DOWN stream PrnLibStream   with frame X123.
     2525     end.
     2526   end.
     2527   if last(ub.dis-obj.obj-code) then do:
     2528     FIND FIRST sj-cards where sj-cards.d-card = ? NO-ERROR.
     2529     DISPLAY STREAM PrnLibStream
     2530     "ИТОГО" @ dis-obj.d-card
     2531     (string(sj-cards.obj-qnty) + " карт") @ sj-cards.cli-name
     2532     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.tot) @ TotalSum
     2533     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.disc) @ DiscSum
     2534     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.netto)  @ NettoSum
     2535     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2536     ACCUM TOTAL by ub.dis-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2537     sj-cards.pay @ PaySumStr
     2538     sj-cards.Must-pay @ MustPayStr
     2539     sj-cards.saldo @ SaldoSumStr
     2540     ACCUM TOTAL bsj-cards.num-chk   @ ub.dis-obj.num-chk
     2541     with frame X123 .
     2542     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2543   end.
     2544     ENd.
     2545   end.
     2546    END.
     2547    END PROCEDURE.
     2548   PROCEDURE disable_UI :
     2549     HIDE FRAME F-Main.
     2550     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2551   END PROCEDURE.
     2552   PROCEDURE enable_UI :
     2553     DISPLAY SelectClient RS-sort t-legacy TotalOnly t-subsid
     2554         WITH FRAME F-Main.
     2555     ENABLE RECT-3 RECT-4 RECT-5 SelectClient RS-sort t-legacy TotalOnly t-subsid
     2556         WITH FRAME F-Main.
     2557   END PROCEDURE.
     2558   PROCEDURE groupcycle :
     2559   def buffer bsj-cards for sj-cards.
     2560   define variable vnum-chk as integer no-undo.
     2561   define variable vPaySum as decimal no-undo.
     2562   define variable vMustPay as decimal no-undo.
     2563   define variable vSaldoSUm as decimal no-undo.
     2564   if t-legacy or t-subsid then do:
     2565     FOR EACH obj-list no-lock ,
     2566         EACH legacy-obj no-lock WHERE
     2567             legacy-obj.obj-type = obj-list.obj-type AND
     2568             legacy-obj.obj-code = obj-list.obj-code,
     2569         FIRST bsj-cards No-LOCK WHERE
     2570               bsj-cards.card-num-chr = legacy-obj.card-num-chr
     2571           ANd bsj-cards.is-sum = yes
     2572         BREAK by legacy-obj.obj-type
     2573               by legacy-obj.obj-code
     2574               by bsj-cards.g-code
     2575               by legacy-obj.d-card:
     2576       if one-firm and v-curr-r-b = 'base':U then do:
     2577   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2578   if first-of(legacy-obj.obj-code) AND num-objs > 1 then do:
     2579     FIND FIRST ub.clients No-LOCK WHERE
     2580                 ub.clients.obj-type = obj-list.obj-type AND
     2581                 ub.clients.obj-code = obj-list.obj-code NO-ERROR.
     2582     DISPLAY STREAM PrnLibStream
     2583     "Магазин" @ ub.dis-obj.d-card
     2584     legacy-obj.obj-code @ ub.dis-obj.obj-code
     2585     ub.clients.obj-name @ sj-cards.cli-name
     2586     WITH FRAME X123.
     2587     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2588     DOWN stream PrnLibStream   with frame X123.
     2589   end.
     2590   if first-of(bsj-cards.g-code) then do:
     2591     FIND FIRST sj-groups No-LOCK WHERE
     2592                sj-groups.g-code = bsj-cards.g-code AND
     2593                sj-groups.obj-code = legacy-obj.obj-code NO-ERROR.
     2594     DISPLAY STREAM PrnLibStream
     2595     "Группа" @ ub.dis-obj.d-card
     2596     sj-groups.g-name @ sj-cards.cli-name
     2597     WITH FRAME X123.
     2598     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2599     DOWN stream PrnLibStream   with frame X123.
     2600   end.
     2601   if t-legacy or t-subsid
     2602   then do:
     2603     ACCUMULATE
     2604     bsj-cards.d-card (COUNT BY legacy-obj.obj-code )
     2605     bsj-cards.num-chk (TOTAL BY legacy-obj.obj-code)
     2606     bsj-cards.tot (TOTAL BY legacy-obj.obj-code )
     2607     bsj-cards.disc (TOTAL BY legacy-obj.obj-code )
     2608     bsj-cards.netto (TOTAL BY legacy-obj.obj-code )
     2609     bsj-cards.instant-pay (TOTAL BY legacy-obj.obj-code )
     2610     bsj-cards.credit-pay (TOTAL BY legacy-obj.obj-code  )
     2611     .
     2612     ACCUMULATE
     2613     legacy-obj.d-card (COUNT BY bsj-cards.g-code )
     2614     legacy-obj.num-chk (TOTAL BY bsj-cards.g-code  )
     2615     legacy-obj.gds-tot-base (TOTAL BY bsj-cards.g-code )
     2616     legacy-obj.gds-dis-base (TOTAL BY bsj-cards.g-code  )
     2617     (legacy-obj.gds-tot-base - legacy-obj.gds-dis-base) (total BY  bsj-cards.g-code )
     2618     legacy-obj.pay-tot-base (TOTAL BY bsj-cards.g-code  )
     2619     ((legacy-obj.gds-tot-base - legacy-obj.gds-dis-base) - legacy-obj.pay-tot-base) (TOTAL BY bsj-cards.g-code  )
     2620     .
     2621   end.
     2622   else
     2623   ACCUMULATE
     2624   ub.dis-obj.d-card (COUNT BY legacy-obj.obj-code)
     2625   ub.dis-obj.num-chk (TOTAL BY legacy-obj.obj-code)
     2626   (ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) (TOTAL BY legacy-obj.obj-code)
     2627   (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base) (TOTAL BY legacy-obj.obj-code)
     2628   ((ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) -
     2629   (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base)
     2630   ) (TOTAL BY legacy-obj.obj-code)
     2631    ub.dis-obj.pay-tot-base (TOTAL BY legacy-obj.obj-code)
     2632   ((ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) -
     2633    (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base) -
     2634    ub.dis-obj.pay-tot-base) (TOTAL BY legacy-obj.obj-code)
     2635   .
     2636   IF NOT TOTALONLY then do:
     2637   if t-legacy or t-subsid   then do:
     2638     DISPLAY STREAM PrnLibStream
     2639     legacy-obj.d-card @ ub.dis-obj.d-card
     2640     legacy-obj.obj-code @ ub.dis-obj.obj-code
     2641     bsj-cards.cli-name @ sj-cards.cli-name
     2642     legacy-obj.d-pcntchr @ for-d-pcnt
     2643     legacy-obj.gds-tot-base @ TotalSum
     2644     legacy-obj.gds-dis-base @ DiscSum
     2645     (legacy-obj.gds-tot-base - legacy-obj.gds-dis-base) @ NettoSum
     2646     legacy-obj.pay-tot-base @ InstantPaySum
     2647     (legacy-obj.gds-tot-base - legacy-obj.gds-dis-base - legacy-obj.pay-tot-base)  @ CreditSum
     2648     PaySUmStr
     2649     SaldoSUmstr
     2650     MustPayStr
     2651     bsj-cards.num-chk @ ub.dis-obj.num-chk
     2652     with frame X123 .
     2653   end.
     2654   else
     2655   DISPLAY STREAM PrnLibStream
     2656   ub.dis-obj.d-card
     2657   ub.dis-obj.obj-code
     2658   bsj-cards.cli-name @ sj-cards.cli-name
     2659   bsj-cards.d-pcntchr @ for-d-pcnt
     2660   (if t-legacy or t-subsid
     2661   then bsj-cards.tot
     2662   else (ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base))  @ TotalSum
     2663   (ub.dis-obj.gds-dis-base +  ub.dis-obj.sum-dis-base) @ DiscSum
     2664   ((ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) -
     2665    (ub.dis-obj.gds-dis-base +  ub.dis-obj.sum-dis-base)) @ NettoSum
     2666    ub.dis-obj.pay-tot-base @ InstantPaySum
     2667   ((ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) -
     2668    (ub.dis-obj.gds-dis-base +  ub.dis-obj.sum-dis-base) -
     2669     ub.dis-obj.pay-tot-base
     2670   )  @ CreditSum
     2671   PaySUmStr
     2672   SaldoSUmstr
     2673   MustPayStr
     2674   ub.dis-obj.num-chk
     2675   with frame X123 .
     2676   DOWN stream PrnLibStream   with frame X123.
     2677   END.
     2678   if last-of(bsj-cards.g-code) then do:
     2679     FIND FIRST sj-groups No-LOCK WHERE
     2680                sj-groups.g-code = bsj-cards.g-code AND
     2681                sj-groups.obj-code = legacy-obj.obj-code NO-ERROR.
     2682     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2683     DOWN stream PrnLibStream   with frame X123.
     2684     if t-legacy or t-subsid then
     2685     DISPLAY STREAM PrnLibStream
     2686     "ИТОГО по группе" @ ub.dis-obj.d-card
     2687     sj-groups.g-name @ sj-cards.cli-name
     2688     ACCUM TOTAL by bsj-cards.g-code (legacy-obj.gds-tot-base) @ TotalSum
     2689     ACCUM TOTAL by bsj-cards.g-code (legacy-obj.gds-dis-base) @ DiscSum
     2690     ACCUM TOTAL by bsj-cards.g-code (legacy-obj.gds-tot-base - legacy-obj.gds-dis-base) @ NettoSum
     2691     ACCUM TOTAL by bsj-cards.g-code (legacy-obj.pay-tot-base) @ InstantPaySum
     2692     ACCUM TOTAL by bsj-cards.g-code ((legacy-obj.gds-tot-base - legacy-obj.gds-dis-base) - legacy-obj.pay-tot-base) @ CreditSum
     2693     ACCUM TOTAL by bsj-cards.g-code (legacy-obj.num-chk) @ ub.dis-obj.num-chk
     2694     with frame X123 .
     2695     else
     2696     DISPLAY STREAM PrnLibStream
     2697     "ИТОГО по группе" @ ub.dis-obj.d-card
     2698     sj-groups.g-name @ sj-cards.cli-name
     2699     sj-groups.tot @ TotalSum
     2700     sj-groups.disc @ DiscSum
     2701     sj-groups.netto @ NettoSum
     2702     sj-groups.instant-pay @ CreditSum
     2703     sj-groups.credit-pay @ CreditSum
     2704     sj-groups.num-chk @ ub.dis-obj.num-chk
     2705     with frame X123 .
     2706     if num-objs <= 1 then do:
     2707       UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2708       DOWN stream PrnLibStream   with frame X123.
     2709     end.
     2710   end.
     2711   if last-of(legacy-obj.obj-code) AND num-objs > 1 then do:
     2712     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2713     DOWN stream PrnLibStream   with frame X123.
     2714     if t-legacy or t-subsid
     2715     then
     2716     DISPLAY STREAM PrnLibStream
     2717     "ИТОГО по маг-ну" @ ub.dis-obj.d-card
     2718     (string(ACCUM COUNT by legacy-obj.obj-code bsj-cards.d-card) + " карт ") @ sj-cards.cli-name
     2719     "" @ for-d-pcnt
     2720     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.tot) @ TotalSum
     2721     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.disc) @ DiscSum
     2722     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.netto) @ NettoSum
     2723     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.instant-pay) @ InstantPaySum
     2724     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.credit-pay) @ CreditSum
     2725     ACCUM TOTAL by legacy-obj.obj-code (bsj-cards.num-chk) @ ub.dis-obj.num-chk
     2726     with frame X123 .
     2727     else
     2728     DISPLAY STREAM PrnLibStream
     2729     "ИТОГО по маг-ну" @ ub.dis-obj.d-card
     2730     (string(ACCUM COUNT by legacy-obj.obj-code ub.dis-obj.d-card) + " карт ") @ sj-cards.cli-name
     2731     "" @ for-d-pcnt
     2732     ACCUM TOTAL by legacy-obj.obj-code (ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) @ TotalSum
     2733     ACCUM TOTAL by legacy-obj.obj-code (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base) @ DiscSum
     2734     ACCUM TOTAL by legacy-obj.obj-code
     2735     ((ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) -
     2736      (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base))  @ NettoSum
     2737     ACCUM TOTAL by legacy-obj.obj-code ub.dis-obj.pay-tot-base @ InstantPaySum
     2738     ACCUM TOTAL by legacy-obj.obj-code
     2739     ((ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) -
     2740      (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base) -
     2741       ub.dis-obj.pay-tot-base) @ CreditSum
     2742     ACCUM TOTAL by legacy-obj.obj-code ub.dis-obj.num-chk @ ub.dis-obj.num-chk
     2743     with frame X123 .
     2744     UNDERLINE stream PrnLibStream   ub.dis-obj.d-card   ub.dis-obj.obj-code   sj-cards.cli-name   FOR-d-pcnt   TotalSum   DiscSum   NettoSum   InstantPaySUm   CreditSum   PaySUmStr   SaldoSumStr   MustPayStr   ub.dis-obj.num-chk   With frame X123.
     2745     DOWN stream PrnLibStream   with frame X123.
     2746   end.
     2747   If last(legacy-obj.obj-code)  then do:
     2748     assign
     2749       TotalSum = 0
     2750       DiscSum = 0
