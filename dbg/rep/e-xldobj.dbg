     6040   PROCEDURE totcyclesingle :
     6041   def buffer bsj-cards for sj-cards.
     6042   if t-legacy or t-subsid then do:
     6043     if v-curr-r-b = 'base':U then do:
     6044       FOR EACH obj-list no-lock ,
     6045           EACH legacy-obj no-lock WHERE
     6046               legacy-obj.obj-type = obj-list.obj-type AND
     6047               legacy-obj.obj-code = obj-list.obj-code,
     6048           FIRST bsj-cards No-LOCK WHERE
     6049                 bsj-cards.card-num-chr = legacy-obj.card-num-chr
     6050           AND bsj-cards.is-sum = yes
     6051           BREAK by legacy-obj.obj-type
     6052                 by legacy-obj.obj-code
     6053                 by legacy-obj.gds-tot-base
     6054                 by legacy-obj.d-card:
     6055         if one-firm then  do:
     6056   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6057   if t-legacy or t-subsid
     6058   then
     6059   ACCUMULATE
     6060   bsj-cards.d-card (COUNT BY Legacy-obj.obj-code)
     6061   bsj-cards.num-chk (TOTAL BY Legacy-obj.obj-code)
     6062   bsj-cards.tot (TOTAL BY Legacy-obj.obj-code)
     6063   bsj-cards.disc (TOTAL BY Legacy-obj.obj-code)
     6064   bsj-cards.netto (TOTAL BY Legacy-obj.obj-code)
     6065   bsj-cards.instant-pay (TOTAL BY Legacy-obj.obj-code)
     6066   bsj-cards.credit-pay (TOTAL BY Legacy-obj.obj-code)
     6067   bsj-cards.num-chk (TOTAL BY Legacy-obj.obj-code)
     6068   .
     6069   else
     6070   ACCUMULATE
     6071   ub.dis-obj.d-card (COUNT BY Legacy-obj.obj-code)
     6072   ub.dis-obj.num-chk (TOTAL BY Legacy-obj.obj-code)
     6073   (ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) (TOTAL BY Legacy-obj.obj-code)
     6074   (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base) (TOTAL BY Legacy-obj.obj-code)
     6075   ((ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) -
     6076   (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base)
     6077   ) (TOTAL BY Legacy-obj.obj-code)
     6078    ub.dis-obj.pay-tot-base (TOTAL BY Legacy-obj.obj-code)
     6079   ((ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base) -
     6080    (ub.dis-obj.gds-dis-base + ub.dis-obj.sum-dis-base) -
     6081    ub.dis-obj.pay-tot-base) (TOTAL BY Legacy-obj.obj-code)
     6082   ub.dis-obj.num-chk (TOTAL BY Legacy-obj.obj-code)
     6083   .
     6084   IF NOT TOTALONLY then do:
     6085   assign
     6086   PaySUmStr = string(bsj-cards.pay, "->>>,>>>,>>9.99")
     6087   MustPayStr = STRING(bsj-cards.Must-Pay, "->>>,>>>,>>9.99")
     6088   SaldoSumStr = STRING(bsj-cards.saldo, "->>>,>>>,>>9.99")
     6089   .
     6090   if t-legacy or t-subsid
     6091   then
     6092   DISPLAY STREAM PrnLibStream
     6093   bsj-cards.d-card @ dis-obj.d-card
     6094   legacy-obj.obj-code @ dis-obj.obj-code
     6095   bsj-cards.cli-name @ sj-cards.cli-name
     6096   bsj-cards.d-pcntchr @ for-d-pcnt
     6097   bsj-cards.tot @ TotalSum
     6098   bsj-cards.disc @ DiscSum
     6099   bsj-cards.netto @ NettoSum
     6100   bsj-cards.instant-pay @ InstantPaySum
     6101   bsj-cards.credit-pay  @ CreditSum
     6102   PaySUmStr
     6103   SaldoSUmstr
