     2026   procedure fbrlib_get-default-pay-code :
     2027   define input parameter p-obj-type   as character        no-undo.
     2028   define input parameter p-obj-code   as integer          no-undo.
     2029   define output parameter p-pay-code  as integer          no-undo.
     2030   define variable v-host-code as integer no-undo .
     2031   define buffer buf_shop          for ub.shop.
     2032   define buffer buf_store         for ub.store.
     2033   define buffer buf_sysconf       for ub.sysconf.
     2034   do
     2035   for buf_shop
     2036     , buf_store
     2037     , buf_sysconf
     2038   on error undo, return error
     2039   :
     2040     case p-obj-type  :
     2041       when 'маг':U then do:
     2042           find first buf_shop no-lock
     2043                 where buf_shop.obj-code = p-obj-code
     2044           no-error.
     2045           if available buf_shop
     2046           then do:
     2047               assign
     2048                   p-pay-code = buf_shop.fbr-pay
     2049               .
     2050           end.
     2051       end.
     2052       when 'скл':U then do:
     2053           find first buf_store no-lock
     2054                 where buf_store.obj-code = p-obj-code
     2055           no-error.
     2056           if available buf_store
     2057           then do:
     2058               assign
     2059                   p-pay-code = buf_store.fbr-pay
     2060               .
     2061           end.
     2062       end.
     2063     end case.
     2064     if p-pay-code = ?
     2065     or p-pay-code = 0
     2066     then do:
     2067   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2068   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2069     (input  p-obj-type
