      937       def var t-phone         like ub.firm.phone     no-undo.
      938       def var t-inn           like ub.firm.inn       no-undo.
      939       def var t-okpo          like ub.firm.okpo      no-undo.
      940       def var t-temp-address  like ub.firm.addres1   no-undo.
      941   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      943   procedure paramls-clear :
      944     define buffer buf_temp-param for temp-param .
      945     do
      946     on error undo, return error return-value
      947     :
      948       for each buf_temp-param
      949       on error undo, return error
      950       :
      951         delete buf_temp-param .
      952       end.
      953     end.
      954   end procedure.
      955   procedure paramls-write :
      956     define input  parameter p-code     as character no-undo .
      957     define input  parameter p-sub-code as character no-undo .
      958     define input  parameter p-value    as character no-undo .
      959     define buffer buf_temp-param for temp-param .
      960     do
      961     on error undo, return error return-value
      962     :
      963       find first buf_temp-param
      964         where buf_temp-param.param-code     = p-code
      965           and buf_temp-param.param-sub-code = p-sub-code
      966         no-error .
      967       if not available buf_temp-param then do:
      968         create buf_temp-param .
      969         assign
      970           buf_temp-param.param-code     = p-code
      971           buf_temp-param.param-sub-code = p-sub-code
      972         .
      973       end.
      974       assign
      975         buf_temp-param.param-value = p-value
      976       .
      977     end.
      978   end procedure.
      979   procedure paramls-read :
      980     define input  parameter p-code          as character no-undo .
      981     define input  parameter p-sub-code      as character no-undo .
      982     define input  parameter p-default-value as character no-undo .
      983     define output parameter p-value         as character no-undo .
      984     define buffer buf_temp-param for temp-param .
      985     do
      986     on error undo, return error return-value
      987     :
      988       find first buf_temp-param
      989         where buf_temp-param.param-code     = p-code
      990           and buf_temp-param.param-sub-code = p-sub-code
      991         no-error .
      992       if available buf_temp-param then do:
      993         assign
      994           p-value = buf_temp-param.param-value
      995         .
      996       end.
      997       else do:
      998         assign
      999           p-value = p-default-value
     1000         .
     1001       end.
     1002     end.
     1003   end procedure.
     1004   procedure paramls-append :
     1005     define input  parameter p-code     as character no-undo .
     1006     define input  parameter p-sub-code as character no-undo .
     1007     define input  parameter p-value    as character no-undo .
     1008     define buffer buf_temp-param for temp-param .
     1009     do
     1010     on error undo, return error return-value
     1011     :
     1012       find first buf_temp-param
     1013            where buf_temp-param.param-code     = p-code
     1014              and buf_temp-param.param-sub-code = p-sub-code
     1015         no-error .
     1016       if not available buf_temp-param then do:
     1017         create buf_temp-param .
     1018         assign
     1019           buf_temp-param.param-code     = p-code
     1020           buf_temp-param.param-sub-code = p-sub-code
     1021           buf_temp-param.param-value    = p-value
     1022         .
     1023       end.
     1024       else do:
     1025           assign
     1026               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1027           .
     1028       end.
     1029     end.
     1030   end procedure.
     1031   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1032     if num-entries(string(p-dec), '.') = 2
     1033       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1034       else return( string(p-dec)) .
     1035   end function.
     1036   function format-point-to-comma returns char (input orig as char ) .
     1037   define variable rtext as character no-undo .
     1038   define variable strt as integer no-undo .
     1039   define variable leng as integer no-undo .
     1040   assign rtext = orig .
     1041   repeat:
     1042     strt =  index(rtext,'.').
     1043     if strt = 0 then leave.
     1044     leng = 1.
     1045     substring(rtext,strt,leng,"character") = v-delim .
     1046   end.
     1047   return rtext.
     1048   end function.
     1049   function format-excel-text returns char ( input start-text as char ) :
     1050   def var  i    as int no-undo.
     1051   def var  ch   as char no-undo.
     1052   def var  n    as int no-undo.
     1053   def var  ipos as int no-undo.
     1054     n = num-entries(trim(start-text), chr(10)) - 1 .
     1055     do i = 1 to n :
     1056       ipos = index( start-text, chr(10)).
     1057       if ipos > 0 then
     1058         substr( start-text, ipos, 1 ) = ' '.
     1059     end.
     1060     n = num-entries(trim(start-text), chr(13)) - 1 .
     1061     do i = 1 to n :
     1062       ipos = index( start-text, chr(13)).
     1063       if ipos > 0 then
     1064         substr( start-text, ipos, 1 ) = ' '.
     1065     end.
     1066     if index( start-text, '"' ) = 0 then
     1067       start-text =  '="'   + trim( start-text) + '"'   .
     1068       else do:
     1069         n = num-entries(trim(start-text), '"') - 1.
     1070         do i = 1 to n :
     1071           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1072         end.
     1073         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1074         start-text = '="'  + ch  + '"' .
     1075       end.
     1076     return start-text.
     1077   end.
     1078   function excel-sum returns char (input p-dec as decimal ).
     1079     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1080   end function.
     1081   function excel-qnty returns char (input p-dec as decimal ).
     1082     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1083   end function.
     1084   function format-excel-text-macr returns char ( input start-text as char ) :
     1085   def var  i    as int no-undo.
     1086   def var  ch   as char no-undo.
     1087   def var  n    as int no-undo.
     1088   def var  ipos as int no-undo.
     1089     n = num-entries(trim(start-text), chr(10)) - 1 .
     1090     do i = 1 to n :
     1091       ipos = index( start-text, chr(10)).
     1092       if ipos > 0 then
     1093         substring( start-text, ipos , 1 ) = ' '.
     1094     end.
     1095     n = num-entries(trim(start-text), chr(13)) - 1 .
     1096     do i = 1 to n :
     1097       ipos = index( start-text, chr(13)).
     1098       if ipos > 0 then
     1099         substring( start-text, ipos, 1 ) = ' '.
     1100     end.
     1101     if index( start-text, '"' ) = 0 then
     1102       start-text =  '"'   + trim( start-text) + '"'   .
     1103       else do:
     1104         n = num-entries(trim(start-text), '"') - 1.
     1105         do i = 1 to n :
     1106           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1107         end.
     1108         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1109         start-text = '"'  + ch  + '"' .
     1110       end.
     1111     n = num-entries(trim(start-text), chr(10)) - 1 .
     1112     do i = 1 to n :
     1113       ipos = index( start-text, chr(10)).
     1114       if ipos > 0 then
     1115         substring( start-text, ipos , 1 ) = ' '.
     1116     end.
     1117       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1118     return start-text.
     1119   end.
     1120   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1121   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1122   procedure partslib-clear-temp-parts :
     1123     define buffer buf_temp-parts for temp-parts .
     1124     do
     1125     on error undo, return error
     1126     :
     1127       for each buf_temp-parts
     1128       on error undo, return error
     1129       :
     1130         delete buf_temp-parts .
     1131       end.
     1132     end.
     1133   end procedure.
     1134   procedure partslib-create-temp-parts :
     1135     define parameter buffer buf_parts       for ub.parts .
     1136     define parameter buffer buf_temp-parts  for temp-parts .
     1137     define input  parameter p-goods-twounit as logical   no-undo .
     1138     define variable v-base-part-code as character no-undo .
     1139     do
     1140     on error undo, return error
     1141     :
     1142       if p-goods-twounit = true
     1143       then do:
     1144         assign
     1145           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1146         .
     1147       end.
     1148       else do:
     1149         assign
     1150           v-base-part-code = buf_parts.part-code
     1151         .
     1152       end.
     1153       find first buf_temp-parts exclusive-lock
     1154         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1155           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1156           and buf_temp-parts.artic     = buf_parts.artic
     1157           and buf_temp-parts.prod-type = buf_parts.prod-type
     1158           and buf_temp-parts.prod-code = buf_parts.prod-code
     1159           and buf_temp-parts.in-code   = buf_parts.in-code
     1160           and buf_temp-parts.out-code  = 'free-zone':U
     1161           and buf_temp-parts.part-code = v-base-part-code
     1162         no-error.
     1163       if not available buf_temp-parts
     1164       then do:
     1165         create buf_temp-parts .
     1166         buffer-copy buf_parts to buf_temp-parts
     1167         assign
     1168           buf_temp-parts.out-code  = 'free-zone':U
     1169           buf_temp-parts.part-code = v-base-part-code
     1170           buf_temp-parts.rsrv-free = yes
     1171           buf_temp-parts.status_   = no
     1172           buf_temp-parts.qnty      = 0
     1173           buf_temp-parts.fact-qnty = 0
     1174           buf_temp-parts.real-qnty = 0
     1175           buf_temp-parts.cli-qnty  = 0
     1176         .
     1177       end.
     1178     end.
     1179   end procedure.
     1180   procedure partslib-init-temp-parts :
     1181     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1182     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1183     define input parameter p-artic           like ub.parts.artic     no-undo .
     1184     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1185     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1186     define buffer buf_parts      for ub.parts .
     1187     define buffer buf_temp-parts for temp-parts .
     1188     define variable v-goods-twounit    as logical   no-undo .
     1189     do
     1190     on error undo, return error
     1191     :
     1192   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1194     (input  p-artic
     1195     ,input  p-prod-type
     1196     ,input  p-prod-code
     1197     ,input  'twounit=request':u
     1198     ,output v-goods-twounit
     1199     ) no-error .
     1200       if error-status :error
     1201       then do:
     1202         message
     1203           vss-workfile vss-revision vss-description skip
     1204           vss-include-info17 skip
     1205           "Ошибка при определении атрибута товара" skip
     1206           "Артикул" p-artic p-prod-type p-prod-code skip
     1207           "twounit=request" skip
     1208           error-status :get-message(1) skip
     1209           return-value skip
     1210           view-as alert-box error .
     1211         undo, return error return-value .
     1212       end.
     1213       run partslib-clear-temp-parts in this-procedure .
     1214       for each buf_parts
     1215         where buf_parts.obj-type  = p-obj-type
     1216           and buf_parts.obj-code  = p-obj-code
     1217           and buf_parts.artic     = p-artic
     1218           and buf_parts.prod-type = p-prod-type
     1219           and buf_parts.prod-code = p-prod-code
     1220           and buf_parts.rsrv-free = yes
     1221           and buf_parts.status_   = no
     1222           and buf_parts.in-code   <> buf_parts.out-code
     1223       on error undo, return error
     1224       :
     1225         run partslib-create-temp-parts in this-procedure
     1226           (buffer buf_parts
     1227           ,buffer buf_temp-parts
     1228           ,input  v-goods-twounit
     1229           ) .
     1230         define variable v-parts-qnty          as decimal   no-undo .
     1231         define variable v-parts-cli-qnty      as decimal   no-undo .
     1232         define variable v-parts-free-qnty     as decimal   no-undo .
     1233         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1234         if buf_parts.out-code = 'free-zone':U
     1235         then do:
     1236           assign
     1237             v-parts-qnty          = buf_parts.qnty
     1238             v-parts-cli-qnty      = buf_parts.cli-qnty
     1239             v-parts-free-qnty     = buf_parts.qnty
     1240             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1241           .
     1242         end.
     1243         else do:
     1244           assign
     1245             v-parts-qnty          = abs(buf_parts.qnty)
     1246             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1247             v-parts-free-qnty     = 0
     1248             v-parts-free-cli-qnty = 0
     1249           .
     1250         end.
     1251         assign
     1252           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1253           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1254           buf_temp-parts.real-qnty     = 0
     1255           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1256           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1257           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1258         .
     1259       end.
     1260     end.
     1261   end procedure.
     1262   procedure partslib-init-temp-parts-by-factord :
