     2250                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2251                                                                       + buf_fbr-line.price-sum-vat-base
     2252                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2253                                                                       + buf_fbr-line.price-sum-vat-rubl
     2254                   .
     2255               end.
     2256           end.
     2257           if buf_fbr-doc.status_    = 'разрешен':U
     2258           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     2259           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     2260           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     2261           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     2262               )
     2263           then do:
     2264            undo, return error
     2265               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     2266                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     2267                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     2268                           "Сумма в &9.&4&7&4&4&8&2"
     2269                          , buf_fbr-doc.doc-code
     2270                          , chr(10)
     2271                          , buf_temp_fbrlib_recipe.recipe-code
     2272                          , CHR(9)
     2273                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2274                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     2275                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2276                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2277                          , "руб"
     2278                          )
     2279              +
     2280              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     2281                         "НДС в &7.&1&5&1&1&6&4"
     2282                        ,  CHR(9)
     2283                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2284                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2285                        ,chr(10)
     2286                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2287                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2288                        ,"руб"
     2289                        )       .
     2290           end.
     2291       end.
     2292   end.
     2293   end procedure.
     2294   procedure fbrlib-fill-sum-fbr-doc :
     2295   do
     2296   on error undo, return error
     2297   :
     2298   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2299   define input parameter p-mode           as character    no-undo.
     2300       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2301       define buffer buf_fbr-doc           for ub.fbr-doc.
     2302       define buffer buf_fbr-line          for ub.fbr-line.
     2303       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2304       define variable v-in-count          as integer       no-undo.
     2305       define variable v-out-count         as integer       no-undo.
     2306       find first buf_fbr-doc exclusive-lock
     2307            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2308       .
     2309       find first buf_temp_fbrlib_recipe no-error.
     2310       if not available buf_temp_fbrlib_recipe
     2311       then do:
     2312           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2313               input buf_fbr-doc.doc-code
     2314           ) no-error.
     2315           if error-status :error
     2316           then do:
     2317               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2318                                              , vss-description
     2319                                              , chr(10)
     2320                                              , error-status:get-message(1)
     2321                                              , return-value ).
     2322           end.
     2323       end.
     2324       assign
     2325           v-in-count                  = 0
     2326           buf_fbr-doc.in-qnty         = 0
     2327           buf_fbr-doc.in-sale         = 0
     2328           buf_fbr-doc.in-base         = 0
     2329           buf_fbr-doc.in-rubl         = 0
     2330           buf_fbr-doc.in-vat-base     = 0
     2331           buf_fbr-doc.in-vat-rubl     = 0
     2332           v-out-count                 = 0
     2333           buf_fbr-doc.out-qnty        = 0
     2334           buf_fbr-doc.out-sale        = 0
     2335           buf_fbr-doc.out-base        = 0
     2336           buf_fbr-doc.out-rubl        = 0
     2337           buf_fbr-doc.out-vat-base    = 0
     2338           buf_fbr-doc.out-vat-rubl    = 0
     2339       .
     2340       for each buf_temp_fbrlib_recipe
     2341       :
     2342           assign
     2343               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2344               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2345               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2346               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2347               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2348               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2349               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2350               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2351               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2352               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2353               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2354               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2355               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2356               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2357           .
     2358       end.
     2359       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2360       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2361       or p-mode <> 'факт':U
     2362       then do:
     2363           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2364           then do:
     2365               assign
     2366                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2367                                   + string( v-out-count, ">>>,>>9" )
     2368                                   + chr(10) + "Строк исходных товаров : "
     2369                                   + string( v-in-count, ">>>,>>9" )
     2370               .
     2371           end.
     2372       end.
     2373       else do:
     2374         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2375                                       "Сумма списанных товаров в &3 - &4&2" +
     2376                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2377                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2378                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2379                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2380                                       , buf_fbr-doc.doc-code
     2381                                       , chr(10)
     2382                                       , "рублях"
     2383                                       , round( buf_fbr-doc.out-rubl, 2 )
     2384                                       , round( buf_fbr-doc.in-rubl,  2 )
     2385                                       , round( buf_fbr-doc.in-rubl,  2 )
     2386                                       , round( buf_fbr-doc.out-base, 2 )
     2387                                       , round( buf_fbr-doc.in-base,  2 )).
     2388       end.
     2389   end.
     2390   end procedure.
     2391   procedure fbrlib-calc-prices :
     2392   do
     2393   on error undo, return error
     2394   :
     2395   define input parameter p-fbr-line-recid as recid        no-undo.
     2396   define input parameter p-price-obj-type as character    no-undo.
     2397   define input parameter p-price-obj-code as integer      no-undo.
     2398   define output parameter p-current-price as decimal      no-undo.
     2399       define variable v-void          as decimal       no-undo.
     2400       define variable v-void-char     as character     no-undo.
     2401       define variable v-gds-code      as integer       no-undo.
     2402       define variable v-b-code        as integer       no-undo.
     2403       define buffer buf_fbr-doc   for ub.fbr-doc.
     2404       define buffer buf_fbr-line  for ub.fbr-line.
     2405       define buffer buf_gds-prt   for ub.gds-prt.
     2406       define buffer buf_bar-code  for ub.bar-code.
     2407       find first buf_fbr-line no-lock
     2408           where recid( buf_fbr-line ) = p-fbr-line-recid
     2409       .
     2410   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2412     (input  buf_fbr-line.artic
     2413     ,input  buf_fbr-line.prod-type
     2414     ,input  buf_fbr-line.prod-code
     2415     ,output v-gds-code
     2416     ) no-error .
     2417       if error-status :error
     2418       then do:
     2419         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2420                                         ,vss-workfile
     2421                                         ,vss-revision
     2422                                         ,vss-description
     2423                                         ,chr(10)
     2424                                         , error-status:get-message(1)
     2425                                         , return-value
     2426                                         , buf_fbr-line.artic
     2427                                         ).
     2428       end.
     2429   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2430     (input  v-gds-code
     2431     ,input  ?
     2432     ,output v-b-code
     2433     ) no-error .
     2434       if error-status :error
     2435       then do:
     2436         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2437                                         ,vss-workfile
     2438                                         ,vss-revision
     2439                                         ,vss-description
     2440                                         ,chr(10)
     2441                                         , error-status:get-message(1)
     2442                                         , return-value
     2443                                         , v-gds-code
     2444                                         ).
     2445       end.
     2446       if buf_fbr-line.is-calc = no
     2447       then do:
     2448   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2450     (input  p-price-obj-type
     2451     ,input  p-price-obj-code
     2452     ,input  v-b-code
     2453     ,input  0
     2454     ,input  0
     2455     ,output v-void-char
     2456     ,output p-current-price
     2457     ,output v-void
     2458     ,output v-void
     2459     ) no-error .
     2460           if error-status :error
     2461           then do:
     2462             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2463                                             ,vss-workfile
     2464                                             ,vss-revision
     2465                                             ,vss-description
     2466                                             ,chr(10)
     2467                                             , error-status:get-message(1)
     2468                                             , return-value
     2469                                             , v-gds-code
     2470                                             ).
     2471           end.
     2472       end.
     2473       else do:
     2474           assign
     2475               p-current-price = buf_fbr-line.price-sale
     2476           .
     2477       end.
     2478   end.
     2479   end procedure.
     2480   procedure fbrlib-put-in-order-recipe :
     2481   do
     2482   on error undo, return error
     2483   :
     2484   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2485       define variable v-recipe-counter    as integer          no-undo.
     2486       define variable v-recipe-amount     as integer init 0   no-undo.
     2487       define variable v-child-counter     as integer          no-undo.
     2488       define variable v-is-call-cycle     as logical          no-undo.
     2489       define variable v-str as character     no-undo.
     2490       define buffer buf_in_fbr-line       for ub.fbr-line.
     2491       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2492       define buffer buf_fbr-line          for ub.fbr-line.
     2493       define buffer buf_recipe-gds        for ub.recipe-gds.
     2494       define buffer buf_recipe            for ub.recipe.
     2495       for each temp_recipe-childs-qnty
     2496       :
     2497           delete temp_recipe-childs-qnty.
     2498       end.
     2499       for each temp_recipe-childs
     2500       :
     2501           delete temp_recipe-childs.
     2502       end.
     2503       for each temp_recipe-order
     2504       :
     2505           delete temp_recipe-order.
     2506       end.
     2507       for each buf_fbr-line no-lock
     2508          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2509       on error undo, return error
     2510       :
     2511           find first temp_recipe-childs-qnty
     2512                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2513           no-error.
     2514           if not available temp_recipe-childs-qnty
     2515           then do:
     2516               create temp_recipe-childs-qnty.
     2517               assign
     2518                   v-recipe-amount                     = v-recipe-amount + 1
     2519                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2520                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2521                   temp_recipe-childs-qnty.childs-qnty = 0
     2522                   v-child-counter                     = 0
     2523               .
     2524           end.
     2525       end.
     2526       for each buf_in_fbr-line no-lock
     2527          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2528            and buf_in_fbr-line.trn-type = 'спи':U
     2529       on error undo, return error
     2530       :
     2531           for each buf_dress_fbr-line no-lock
     2532              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2533                and buf_dress_fbr-line.trn-type    = 'при':U
     2534                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2535                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2536                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2537           on error undo, return error
     2538           :
     2539               find first buf_recipe no-lock
     2540                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2541               .
     2542               if buf_in_fbr-line.is-comp = yes
     2543               then do:
     2544                   find last temp_recipe-childs-qnty
     2545                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2546                   .
     2547                   assign
     2548                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2549                   .
     2550                   create temp_recipe-childs.
     2551                   assign
     2552                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2553                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2554                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2555                   .
     2556               end.
     2557               else do:
     2558               end.
     2559           end.
     2560       end.
     2561       for each buf_in_fbr-line no-lock
     2562          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2563            and buf_in_fbr-line.trn-type = 'при':U
     2564       on error undo, return error
     2565       :
     2566           find first buf_recipe no-lock
     2567                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2568           no-error.
     2569           if buf_in_fbr-line.is-comp = no
     2570           then do:
     2571           end.
     2572           else do:
     2573               for each buf_recipe-gds no-lock
     2574               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2575               :
     2576                   for each buf_fbr-line no-lock
     2577                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2578                       and buf_fbr-line.trn-type    = 'при':U
     2579                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2580                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2581                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2582                   on error undo, return error
     2583                   :
     2584                       find first buf_recipe no-lock
     2585                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2586                       .
     2587                       if buf_recipe.recipe-type = 'разделка':U
     2588                       then do:
     2589                       end.
     2590                       else do:
     2591                           find last temp_recipe-childs-qnty
     2592                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2593                           .
     2594                           assign
     2595                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2596                           .
     2597                           create temp_recipe-childs.
     2598                           assign
     2599                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2600                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2601                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2602                           .
     2603                       end.
     2604                   end.
     2605               end.
     2606           end.
     2607       end.
     2608       for each temp_recipe-order
     2609       on error undo, return error
     2610       :
     2611           delete temp_recipe-order.
     2612       end.
     2613       assign
     2614           v-fbrlib-recipe-order = 0
     2615       .
     2616       do v-recipe-counter = 1 to v-recipe-amount
     2617       on error undo, return error
     2618       :
     2619           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2620                 input v-recipe-counter
     2621               , input 0
     2622               , output v-is-call-cycle
     2623           ).
     2624           if v-is-call-cycle = yes
     2625           then do:
     2626               message
     2627                       "Достигнут максимальный уровень вложенности рецептов."
     2628                   skip(1)
     2629                   skip "Невозможно упорядочить рецепты."
     2630                   skip(1)
     2631                   skip "Необходимо изменить структуру рецептов,"
     2632                   skip "используемых при формировании"
     2633                   skip "данного документа производства."
     2634               view-as alert-box error
     2635               title "Невозможно рассчитать документ производства".
     2636               for each temp_recipe-childs-qnty
     2637               :
     2638                   delete temp_recipe-childs-qnty.
     2639               end.
     2640               for each temp_recipe-childs
     2641               :
     2642                   delete temp_recipe-childs.
     2643               end.
     2644               for each temp_recipe-order
     2645               :
     2646                   delete temp_recipe-order.
     2647               end.
     2648               for each temp_recipe-order
     2649               on error undo, return error
     2650               :
     2651                   delete temp_recipe-order.
     2652               end.
     2653               for each temp_fbrlib_recipe
     2654               on error undo, return error
     2655               :
     2656                   delete temp_recipe-order.
     2657               end.
     2658               undo, return error.
     2659           end.
     2660       end.
     2661   end.
     2662   end procedure.
     2663   procedure fbrlib-add-recipe-in-tmp-order :
     2664   do
     2665   on error undo, return error
     2666   :
     2667   define input parameter p-order              as integer      no-undo.
     2668   define input parameter p-call-counter       as integer      no-undo.
     2669   define output parameter p-is-call-cycle     as logical      no-undo.
     2670       define variable v-nodes-counter     as integer       no-undo.
     2671       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2672       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2673       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2674       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2675       assign
     2676           p-call-counter = p-call-counter + 1
     2677       .
     2678       if p-call-counter > 50
     2679       then do:
     2680           assign
     2681               p-is-call-cycle = yes
     2682           .
     2683       end.
     2684       else do:
     2685           find first buf_temp_recipe-childs-qnty
     2686                where buf_temp_recipe-childs-qnty.order = p-order
     2687           .
     2688           find first buf_temp_recipe-order
     2689                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2690           no-error.
     2691           if not available buf_temp_recipe-order
     2692           then do:
     2693               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2694               :
     2695                   find first buf_temp_recipe-childs
     2696                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2697                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2698                   .
     2699                   find first buf_c_temp_recipe-childs-qnty
     2700                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2701                   .
     2702                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2703                         input buf_c_temp_recipe-childs-qnty.order
     2704                       , input p-call-counter
     2705                       , output p-is-call-cycle
     2706                   ).
     2707                   if p-is-call-cycle = yes
     2708                   then do:
     2709                       return.
     2710                   end.
     2711               end.
     2712               assign
     2713                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2714               .
     2715               create buf_temp_recipe-order.
     2716               assign
     2717                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2718                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2719               .
     2720           end.
     2721       end.
     2722   end.
     2723   end procedure.
     2724   procedure fbrlib-get-trn-type :
     2725   define input parameter p-recipe-code    as character    no-undo.
     2726   define input parameter p-goods-recid    as recid        no-undo.
     2727   define input parameter p-is-integration as logical      no-undo.
     2728   define output parameter p-is-comp       as logical      no-undo.
     2729   define output parameter p-trn-type      as character    no-undo.
     2730   define buffer buf_recipe    for ub.recipe.
     2731   define buffer buf_goods     for ub.goods.
     2732   do
     2733   for buf_recipe
     2734     , buf_goods
     2735   on error undo, return error
     2736   :
     2737       find first buf_goods no-lock
     2738            where recid( buf_goods ) = p-goods-recid
     2739       .
     2740       find first buf_recipe no-lock
     2741            where buf_recipe.recipe-code = p-recipe-code
     2742       no-error.
     2743       if not available buf_recipe
     2744       then do:
     2745           assign
     2746               p-is-comp = no
     2747               p-trn-type = "":U
     2748           .
     2749           undo, return.
     2750       end.
     2751       if  buf_recipe.artic        = buf_goods.artic
     2752       and buf_recipe.prod-type    = buf_goods.prod-type
     2753       and buf_recipe.prod-code    = buf_goods.prod-code
     2754       then do:
     2755           assign
     2756               p-is-comp = yes
     2757           .
     2758       end.
     2759       else do:
     2760           assign
     2761               p-is-comp = no
     2762           .
     2763       end.
     2764       case buf_recipe.recipe-type
     2765       :
     2766           when 'производство':U
     2767           then do:
     2768               if p-is-comp = yes
     2769               then do:
     2770                   assign
     2771                       p-trn-type = 'при':U
     2772                   .
     2773               end.
     2774               else do:
     2775                   assign
     2776                       p-trn-type = 'спи':U
     2777                   .
     2778               end.
     2779           end.
     2780           when 'альтернатива':U
     2781           then do:
     2782               if p-is-comp = yes
     2783               then do:
     2784                   assign
     2785                       p-trn-type = 'при':U
     2786                   .
     2787               end.
     2788               else do:
     2789                   assign
     2790                       p-trn-type = 'спи':U
     2791                   .
     2792               end.
     2793           end.
     2794           when 'разделка':U
     2795           then do:
     2796               if p-is-comp = no
     2797               then do:
     2798                   assign
     2799                       p-trn-type = 'при':U
     2800                   .
     2801               end.
     2802               else do:
     2803                   assign
     2804                       p-trn-type = 'спи':U
     2805                   .
     2806               end.
     2807           end.
     2808           when 'комплектация':U
     2809           then do:
     2810               if p-is-integration = ?
     2811               then do:
     2812                   message
     2813                       "Выберите тип операции по рецепту комплектации:"
     2814                       skip (2) "YES - комплектация"
     2815                       skip     "NO - разукомплектация"
     2816                   view-as alert-box question
     2817                   buttons YES-NO
     2818                   update p-is-integration.
     2819               end.
     2820               if p-is-integration = yes
     2821               then do:
     2822                   if p-is-comp = yes
     2823                   then do:
     2824                       assign
     2825                           p-trn-type = 'при':U
     2826                       .
     2827                   end.
     2828                   else do:
     2829                       assign
     2830                           p-trn-type = 'спи':U
     2831                       .
     2832                   end.
     2833               end.
     2834               else do:
     2835                   if p-is-comp = yes
     2836                   then do:
     2837                       assign
     2838                           p-trn-type = 'спи':U
     2839                       .
     2840                   end.
     2841                   else do:
     2842                       assign
     2843                           p-trn-type = 'при':U
     2844                       .
     2845                   end.
     2846               end.
     2847           end.
     2848       end case.
     2849   end.
     2850   end procedure.
     2851   procedure fbrlib-get-mark :
     2852   define input parameter p-recipe-code    as character    no-undo.
     2853   define output parameter p-mark          as logical    no-undo.
     2854   define buffer buf_goods-attr     for ub.goods-attr.
     2855   define buffer buf_recipe-gds for ub.recipe-gds .
     2856       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2857            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2858                                               buf_goods-attr.attr-code = 'mark-type':U:
     2859            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2860               p-mark = true .
     2861               return .
     2862            end.
     2863       end.
     2864   end procedure.
     2865   procedure fbrlib-check-temp-tables :
     2866   do
     2867   on error undo, return error
     2868   :
     2869   define input parameter p-title  as character    no-undo.
     2870       define variable v-str               as character        no-undo.
     2871       assign
     2872           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2873       .
     2874       for each temp_recipe-childs-qnty
     2875       on error undo, return error
     2876       :
     2877           assign
     2878               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2879                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2880                       + "   " + string( temp_recipe-childs-qnty.order )
     2881                       + chr(10)
     2882           .
     2883       end.
     2884       assign
     2885           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2886       .
     2887       for each temp_recipe-childs
     2888       on error undo, return error
     2889       :
     2890           assign
     2891               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2892                       + "   " + string( temp_recipe-childs.child-code )
     2893                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2894                       + chr(10)
     2895           .
     2896       end.
     2897       assign
     2898           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2899       .
     2900       for each temp_recipe-order
     2901       on error undo, return error
     2902       :
     2903           assign
     2904               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2905                       + "   " + string( temp_recipe-order.order )
     2906                       + chr(10)
     2907           .
     2908       end.
     2909       assign
     2910           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2911       .
     2912       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2913       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2914       for each temp_fbrlib_recipe
     2915       on error undo, return error
     2916       :
     2917           assign
     2918               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2919                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2920                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2921                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2922                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2923                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2924                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2925                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2926                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2927                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2928                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2929                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2930                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2931                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2932                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2933                       + chr(10)
     2934           .
     2935           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2936       end.
     2937   end.
     2938   end procedure.
     2939   procedure fbrlib-s-coeff-value :
     2940   define input  parameter p-gds-code    as integer        no-undo.
     2941   define input  parameter p-date        as date           no-undo.
     2942   define input  parameter p-obj-type    as character      no-undo.
     2943   define input  parameter p-obj-code    as integer        no-undo.
     2944   define output parameter p-coeff-value as decimal        no-undo.
     2945   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2946       define variable v-date          as date         no-undo.
     2947       define variable v-host-code     as integer      no-undo.
     2948       define buffer buf_goods       for ub.goods.
     2949       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2950       define buffer buf_clients     for ub.clients.
     2951       define buffer buf_s-coeff     for ub.s-coeff.
     2952   do
     2953   for buf_goods
     2954     , buf_fbr-gds-obj
     2955     , buf_clients
     2956     , buf_s-coeff
     2957   on error undo, return error return-value
     2958   :
     2959       find first buf_goods no-lock
     2960            where buf_goods.gds-code = p-gds-code
     2961       no-error .
     2962       if not available buf_goods
     2963       then do:
     2964          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2965       end.
     2966       find first buf_clients no-lock
     2967            where buf_clients.obj-type = p-obj-type
     2968              and buf_clients.obj-code = p-obj-code
     2969       no-error.
     2970       if not available buf_clients
     2971       then do:
     2972          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2973       end.
     2974       assign
     2975           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2976       .
     2977       find first buf_fbr-gds-obj no-lock
     2978            where buf_fbr-gds-obj.gds-code = p-gds-code
     2979              and buf_fbr-gds-obj.obj-type = p-obj-type
     2980              and buf_fbr-gds-obj.obj-code = p-obj-code
     2981       no-error.
     2982       if not available buf_fbr-gds-obj
     2983       or buf_fbr-gds-obj.is-season = no
     2984       then do:
     2985           assign
     2986               p-coeff-value = 0
     2987           .
     2988           return.
     2989       end.
     2990   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2991   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2992     (input  p-obj-type
     2993     ,input  p-obj-code
     2994     ,output v-host-code
     2995     )  .
     2996       find last buf_s-coeff no-lock
     2997           where buf_s-coeff.gds-code = p-gds-code
     2998             and buf_s-coeff.host-code = v-host-code
     2999             and buf_s-coeff.obj-type = p-obj-type
     3000             and buf_s-coeff.obj-code = p-obj-code
     3001             and buf_s-coeff.s-date <= v-date
     3002       no-error.
     3003       if available buf_s-coeff
     3004       then do:
     3005           assign
     3006               p-coeff-value = buf_s-coeff.coeff-value
     3007           .
     3008           return.
     3009       end.
     3010       find last buf_s-coeff no-lock
     3011           where buf_s-coeff.gds-code = p-gds-code
     3012             and buf_s-coeff.host-code = v-host-code
     3013             and buf_s-coeff.obj-type = "":U
     3014             and buf_s-coeff.obj-code = 0
     3015             and buf_s-coeff.s-date <= v-date
     3016       no-error.
     3017       if available buf_s-coeff
     3018       then do:
     3019           assign
     3020               p-coeff-value = buf_s-coeff.coeff-value
     3021           .
     3022           return.
     3023       end.
     3024       find last buf_s-coeff no-lock
     3025           where buf_s-coeff.gds-code = p-gds-code
     3026             and buf_s-coeff.host-code = 0
     3027             and buf_s-coeff.obj-type = "":U
     3028             and buf_s-coeff.obj-code = 0
     3029             and buf_s-coeff.s-date <= v-date
     3030       no-error.
     3031       if available buf_s-coeff
     3032       then do:
     3033           assign
     3034               p-coeff-value = buf_s-coeff.coeff-value
     3035           .
     3036       end.
     3037       else do:
     3038           assign
     3039               p-coeff-value = 0
     3040           .
     3041       end.
     3042   end.
     3043   end procedure.
     3044   procedure fbrlib_create-fbr-recipe-gds :
     3045   define input parameter p-doc-code         as character      no-undo.
     3046   define input parameter p-recipe-code      as character      no-undo.
     3047   define input parameter p-prod-type        as character      no-undo.
     3048   define input parameter p-prod-code        as integer        no-undo.
     3049   define input parameter p-artic            as character      no-undo.
     3050   define input parameter p-gds-code         as integer        no-undo.
     3051   define input parameter p-is-waste         as logical        no-undo.
     3052   define input parameter p-proc-number      as integer        no-undo.
     3053   define input parameter p-obj-date         as date           no-undo.
     3054   define input parameter p-obj-type         as character      no-undo.
     3055   define input parameter p-obj-code         as integer        no-undo.
     3056   define input parameter p-calc-method      as decimal        no-undo.
     3057   define input parameter p-coeff-waste      as decimal        no-undo.
     3058   define input parameter p-orig-qnty        as decimal        no-undo.
     3059   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     3060       define variable v-coeff-season  as decimal      no-undo.
     3061       define variable v-void-decimal  as decimal      no-undo.
     3062       define variable v-void-integer  as integer      no-undo.
     3063       define variable v-recipe-type   as character    no-undo.
     3064       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3065       define buffer buf_goods             for ub.goods.
     3066       define buffer buf_recipe            for ub.recipe.
     3067   do
     3068   for buf_fbr-recipe-gds
     3069     , buf_recipe
     3070     , buf_goods
     3071   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3072   :
     3073       find first buf_fbr-recipe-gds exclusive-lock
     3074            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3075              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3076              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     3077              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     3078              and buf_fbr-recipe-gds.artic       = p-artic
     3079       no-error.
     3080       if not available buf_fbr-recipe-gds
     3081       then do:
     3082           create buf_fbr-recipe-gds.
     3083           assign
     3084               buf_fbr-recipe-gds.doc-code           = p-doc-code
     3085               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     3086               buf_fbr-recipe-gds.prod-type          = p-prod-type
     3087               buf_fbr-recipe-gds.prod-code          = p-prod-code
     3088               buf_fbr-recipe-gds.artic              = p-artic
     3089               buf_fbr-recipe-gds.gds-code           = p-gds-code
     3090               buf_fbr-recipe-gds.is-waste           = p-is-waste
     3091               buf_fbr-recipe-gds.proc-number        = p-proc-number
     3092               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     3093               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     3094           .
     3095           find first buf_goods no-lock
     3096                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     3097                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     3098                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     3099           .
     3100           run fbrlib-s-coeff-value in this-procedure (
     3101                 input buf_goods.gds-code
     3102               , input p-obj-date
     3103               , input p-obj-type
     3104               , input p-obj-code
     3105               , output v-coeff-season
     3106           ) no-error.
     3107           if error-status:error
     3108           then do:
     3109               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     3110           end.
     3111           assign
     3112               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     3113               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     3114               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     3115           .
     3116           run fbrlib-get-recipe-type in this-procedure (
     3117                 input buf_fbr-recipe-gds.doc-code
     3118               , input buf_fbr-recipe-gds.recipe-code
     3119               , output v-recipe-type
     3120           ).
     3121           if v-recipe-type <> 'производство':U
     3122           then do:
     3123               assign
     3124                   buf_fbr-recipe-gds.coeff-value  = 0
     3125                   buf_fbr-recipe-gds.coeff-waste  = 0
     3126                   buf_fbr-recipe-gds.calc-method  = 1
     3127                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     3128               .
     3129           end.
     3130           else do:
     3131               run fbrlib-calc-brutto in this-procedure (
     3132                     input v-recipe-type
     3133                   , input buf_fbr-recipe-gds.qnty
     3134                   , input buf_fbr-recipe-gds.coeff-value
     3135                   , input buf_fbr-recipe-gds.coeff-waste
     3136                   , input 0
     3137                   , input 3
     3138                   , output v-void-decimal
     3139                   , output v-void-decimal
     3140                   , output buf_fbr-recipe-gds.brutto-qnty
     3141                   , output v-void-integer
     3142               ).
     3143               assign
     3144                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     3145               .
     3146               run fbrlib-calc-brutto in this-procedure (
     3147                     input v-recipe-type
     3148                   , input buf_fbr-recipe-gds.qnty
     3149                   , input buf_fbr-recipe-gds.coeff-value
     3150                   , input buf_fbr-recipe-gds.coeff-waste
     3151                   , input buf_fbr-recipe-gds.brutto-qnty
     3152                   , input buf_fbr-recipe-gds.calc-method
     3153                   , output buf_fbr-recipe-gds.qnty
     3154                   , output v-void-decimal
     3155                   , output v-void-decimal
     3156                   , output v-void-integer
     3157               ).
     3158           end.
     3159       end.
     3160   end.
     3161   end procedure.
     3162   procedure fbrlib-set-default-recipe :
     3163   define input parameter p-obj-type   as character    no-undo.
     3164   define input parameter p-obj-code   as integer      no-undo.
     3165   define input parameter p-gds-code   as integer      no-undo.
     3166       define variable v-artic             as character    no-undo.
     3167       define variable v-prod-type         as character    no-undo.
     3168       define variable v-prod-code         as character    no-undo.
     3169       define variable v-recipe-code       as character    no-undo.
     3170       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3171       define variable v-recipe-found      as logical      no-undo.
     3172       define buffer buf_recipe        for ub.recipe.
     3173       define buffer buf_other_recipe  for ub.recipe.
     3174       define buffer buf_goods         for ub.goods.
     3175       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3176   do
     3177   for buf_recipe
     3178     , buf_goods
     3179     , buf_fbr-gds-obj
     3180   on error undo, return error
     3181   :
     3182       find first buf_goods no-lock
     3183            where buf_goods.gds-code = p-gds-code
     3184       .
     3185       run fbrlib-get-obj-recipe in this-procedure (
     3186             input p-obj-type
     3187           , input p-obj-code
     3188           , input p-gds-code
     3189           , output v-recipe-code
     3190       ).
     3191       if v-recipe-code <> ""
     3192       then do:
     3193           find first buf_recipe no-lock
     3194               where buf_recipe.recipe-code = v-recipe-code
     3195           no-error.
     3196           if not available buf_recipe
     3197           then do:
     3198               assign
     3199                   v-recipe-code = ""
     3200               .
     3201           end.
     3202       end.
     3203       if v-recipe-code = ""
     3204       then do:
     3205           find first buf_fbr-gds-obj exclusive-lock
     3206                where buf_fbr-gds-obj.obj-type = p-obj-type
     3207                  and buf_fbr-gds-obj.obj-code = p-obj-code
     3208                  and buf_fbr-gds-obj.gds-code = p-gds-code
     3209           no-error.
     3210           if not available buf_fbr-gds-obj
     3211           then do:
     3212               run ref/fgdsobj1.p (
     3213                     input-output v-fbr-gds-obj-recid
     3214                   , input 'ДОБАВЛЕНИЕ':U
     3215                   , input no
     3216                   , input p-gds-code
     3217                   , input p-obj-type
     3218                   , input p-obj-code
     3219                   , input 0
     3220                   , input ""
     3221                   , input 0
     3222                   , input no
     3223                   , input no
     3224                   , input no
     3225                   , input no
     3226                   , input no
     3227                   , input no
     3228               ) no-error.
     3229               if error-status:error
     3230               then do:
     3231                   message
     3232                           vss-workfile vss-revision vss-description
     3233                       skip "Ошибка изменения атрибутов товара на объекте"
     3234                       skip return-value
     3235                       skip trim(error-status :get-message(1))
     3236                               trim(error-status :get-message(2))
     3237                               trim(error-status :get-message(3))
     3238                   view-as alert-box error.
     3239                   undo, return error .
     3240               end.
     3241               find first buf_fbr-gds-obj exclusive-lock
     3242                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     3243               .
     3244           end.
     3245           assign
     3246               v-recipe-found = no
     3247           .
     3248           for first buf_recipe no-lock
     3249               where buf_recipe.obj-type    = p-obj-type
     3250                 and buf_recipe.obj-code    = p-obj-code
     3251                 and buf_recipe.artic       = buf_goods.artic
     3252                 and buf_recipe.prod-type   = buf_goods.prod-type
     3253                 and buf_recipe.prod-code   = buf_goods.prod-code
     3254                 and buf_recipe.recipe-type = 'производство':U
     3255                 or (
     3256                     buf_recipe.obj-type    = ""
     3257                 and buf_recipe.obj-code    = 0
     3258                 and buf_recipe.artic       = buf_goods.artic
     3259                 and buf_recipe.prod-type   = buf_goods.prod-type
     3260                 and buf_recipe.prod-code   = buf_goods.prod-code
     3261                 and buf_recipe.recipe-type = 'производство':U
     3262                     )
     3263           :
     3264               assign
     3265                   v-recipe-found = yes
     3266                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3267               .
     3268           end.
     3269           if v-recipe-found = no
     3270           then do:
     3271               for first buf_recipe no-lock
     3272                   where buf_recipe.obj-type    = p-obj-type
     3273                     and buf_recipe.obj-code    = p-obj-code
     3274                     and buf_recipe.artic       = buf_goods.artic
     3275                     and buf_recipe.prod-type   = buf_goods.prod-type
     3276                     and buf_recipe.prod-code   = buf_goods.prod-code
     3277                     and buf_recipe.recipe-type <> 'альтернатива':U
     3278                     or (
     3279                         buf_recipe.obj-type    = ""
     3280                     and buf_recipe.obj-code    = 0
     3281                     and buf_recipe.artic       = buf_goods.artic
     3282                     and buf_recipe.prod-type   = buf_goods.prod-type
     3283                     and buf_recipe.prod-code   = buf_goods.prod-code
     3284                     and buf_recipe.recipe-type <> 'альтернатива':U
     3285                         )
     3286               :
     3287                   assign
     3288                       v-recipe-found = yes
     3289                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3290                   .
     3291               end.
     3292               if v-recipe-found = no
     3293               then do:
     3294                   for first buf_recipe no-lock
     3295                       where buf_recipe.obj-type    = p-obj-type
     3296                         and buf_recipe.obj-code    = p-obj-code
     3297                         and buf_recipe.artic       = buf_goods.artic
     3298                         and buf_recipe.prod-type   = buf_goods.prod-type
     3299                         and buf_recipe.prod-code   = buf_goods.prod-code
     3300                         or (
     3301                             buf_recipe.obj-type    = ""
     3302                         and buf_recipe.obj-code    = 0
     3303                         and buf_recipe.artic       = buf_goods.artic
     3304                         and buf_recipe.prod-type   = buf_goods.prod-type
     3305                         and buf_recipe.prod-code   = buf_goods.prod-code
     3306                             )
     3307                   :
     3308                       assign
     3309                           v-recipe-found = yes
     3310                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3311                       .
     3312                   end.
     3313                   if v-recipe-found = no
     3314                   then do:
     3315                       assign
     3316                           buf_fbr-gds-obj.default-recipe-code = ""
     3317                       .
     3318                   end.
     3319               end.
     3320           end.
     3321       end.
     3322   end.
     3323   end procedure.
     3324   procedure fbrlib-get-obj-recipe :
     3325   define input parameter p-obj-type       as character    no-undo.
     3326   define input parameter p-obj-code       as integer      no-undo.
     3327   define input parameter p-gds-code       as integer      no-undo.
     3328   define output parameter p-recipe-code   as character    no-undo.
     3329       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3330   do
     3331   for buf_fbr-gds-obj
     3332   on error undo, return error
     3333   :
     3334       find first buf_fbr-gds-obj no-lock
     3335            where buf_fbr-gds-obj.obj-type = p-obj-type
     3336              and buf_fbr-gds-obj.obj-code = p-obj-code
     3337              and buf_fbr-gds-obj.gds-code = p-gds-code
     3338       no-error.
     3339       if available buf_fbr-gds-obj
     3340       then do:
     3341           assign
     3342               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3343           .
     3344       end.
     3345       else do:
     3346           assign
     3347               p-recipe-code = ""
     3348           .
     3349       end.
     3350   end.
     3351   end procedure.
     3352   procedure fbrlib-create-or-update-recipe-gds :
     3353   define input parameter p-recipe-code    as character        no-undo.
     3354   define input parameter p-gds-code       as integer          no-undo.
     3355   define input parameter p-is-waste       as logical          no-undo.
     3356   define input parameter p-qnty           as decimal          no-undo.
     3357   define input parameter p-proc-number    as integer          no-undo.
     3358   define input parameter p-nws-self       as logical          no-undo.
     3359       define variable v-max-proc-num  as integer      no-undo.
     3360       define variable v-recipe-type   as character    no-undo.
     3361       define buffer buf_goods             for ub.goods.
     3362       define buffer buf_recipe-gds        for ub.recipe-gds.
     3363       define buffer buf_recipe            for ub.recipe.
     3364       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3365   do
     3366   for buf_goods
     3367     , buf_recipe-gds
     3368     , buf_recipe
     3369     , buf_proc_recipe-gds
     3370   on error undo, return error
     3371   :
     3372       find first buf_recipe no-lock
     3373            where buf_recipe.recipe-code = p-recipe-code
     3374       .
     3375       find first buf_goods no-lock
     3376            where buf_goods.gds-code = p-gds-code
     3377       .
     3378       find first buf_recipe-gds
     3379            where buf_recipe-gds.recipe-code = p-recipe-code
     3380              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3381              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3382              and buf_recipe-gds.artic       = buf_goods.artic
     3383       no-error.
     3384       if not available buf_recipe-gds
     3385       then do:
     3386           create buf_recipe-gds.
     3387           assign
     3388               buf_recipe-gds.recipe-code = p-recipe-code
     3389               buf_recipe-gds.gds-code    = p-gds-code
     3390               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3391               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3392               buf_recipe-gds.artic       = buf_goods.artic
     3393           .
     3394           assign
     3395               buf_recipe-gds.is-waste    = no
     3396               buf_recipe-gds.qnty        = 0
     3397               buf_recipe-gds.coeff-waste = 0
     3398               buf_recipe-gds.brutto-qnty = 0
     3399               buf_recipe-gds.proc-number = 0
     3400               buf_recipe-gds.nws-self    = no
     3401           .
     3402       end.
     3403       assign
     3404           buf_recipe-gds.is-waste    = p-is-waste
     3405       .
     3406       run fbrlib-get-recipe-type in this-procedure (
     3407             input "":U
     3408           , input buf_recipe-gds.recipe-code
     3409           , output v-recipe-type
     3410       ).
     3411       if v-recipe-type <> 'производство':U
     3412       then do:
     3413           assign
     3414               buf_recipe-gds.calc-method = 1
     3415               buf_recipe-gds.qnty        = p-qnty
     3416               buf_recipe-gds.brutto-qnty = p-qnty
     3417               buf_recipe-gds.coeff-waste = 0
     3418           .
     3419       end.
     3420       else do:
     3421           assign
     3422               buf_recipe-gds.calc-method = 1
     3423               buf_recipe-gds.brutto-qnty = p-qnty
     3424           .
     3425           run fbrlib-calc-brutto in this-procedure (
     3426                 input v-recipe-type
     3427               , input 0
     3428               , input 0
     3429               , input buf_recipe-gds.coeff-waste
     3430               , input buf_recipe-gds.brutto-qnty
     3431               , input 1
     3432               , output buf_recipe-gds.qnty
     3433               , output buf_recipe-gds.coeff-waste
     3434               , output buf_recipe-gds.brutto-qnty
     3435               , output buf_recipe-gds.calc-method
     3436           ).
     3437       end.
     3438       assign
     3439           buf_recipe-gds.nws-self    = p-nws-self
     3440       .
     3441       if buf_recipe.recipe-type = 'альтернатива':U
     3442       and buf_recipe-gds.proc-number <> 0
     3443       then do:
     3444       end.
     3445       else do:
     3446           if p-proc-number <> 0
     3447           then do:
     3448               assign
     3449                   buf_recipe-gds.proc-number = p-proc-number
     3450               .
     3451           end.
     3452           else do:
     3453               assign
     3454                   v-max-proc-num = 0
     3455               .
     3456               for each buf_proc_recipe-gds no-lock
     3457                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3458               :
     3459                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3460                   then do:
     3461                       assign
     3462                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3463                       .
     3464                   end.
     3465               end.
     3466               assign
     3467                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3468               .
     3469           end.
     3470       end.
     3471   end.
     3472   end procedure.
     3473   PROCEDURE fbrlib-create-or-update-recipe :
     3474   define input parameter p-mode               as character    no-undo.
     3475   define input parameter p-obj-type           as character    no-undo.
     3476   define input parameter p-obj-code           as integer      no-undo.
     3477   define input parameter p-recipe-code        as character    no-undo.
     3478   define input parameter p-recipe-type        as character    no-undo.
     3479   define input parameter p-gds-code           as integer      no-undo.
     3480   define input parameter p-name               as character    no-undo.
     3481   define input parameter p-design             as character    no-undo.
     3482   define input parameter p-order              as integer      no-undo.
     3483   define input parameter p-quality            as character    no-undo.
     3484   define input parameter p-ref-num            as character    no-undo.
     3485   define input parameter p-technique          as character    no-undo.
     3486   define input parameter p-template           as character    no-undo.
     3487   define input parameter p-qnty               as decimal      no-undo.
     3488   define input parameter p-portion-qnty       as integer      no-undo.
     3489   define input parameter p-portion-weight     as decimal      no-undo.
     3490   define output parameter p-new-recipe-code   as character    no-undo.
     3491       define variable v-host-code         as integer      no-undo.
     3492       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3493       define buffer buf_recipe    for ub.recipe.
     3494       define buffer buf_goods     for ub.goods.
     3495   do
     3496   for buf_recipe
     3497     , buf_goods
     3498   on error undo, return error
     3499   :
     3500       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3501       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3502       then do:
     3503           message
     3504               skip "Ошибка задания типа операции для создания или измения рецепта."
     3505               skip (1)
     3506               skip "Задан тип операции:" p-mode
     3507           view-as alert-box error.
     3508           undo, return error .
     3509       end.
     3510       if p-recipe-code = ""
     3511       then do:
     3512   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3513   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3514     (input  p-obj-type
     3515     ,input  p-obj-code
     3516     ,output v-host-code
     3517     )  .
     3518           find first buf_goods no-lock
     3519                where buf_goods.gds-code = p-gds-code
     3520           .
     3521           create buf_recipe .
     3522           run fbrcode-gen-recipe-code in this-procedure (
     3523                 input p-obj-type
     3524               , input p-obj-code
     3525               , output buf_recipe.recipe-code
     3526           ).
     3527           assign
     3528               buf_recipe.artic               = buf_goods.artic
     3529               buf_recipe.prod-type           = buf_goods.prod-type
     3530               buf_recipe.prod-code           = buf_goods.prod-code
     3531               buf_recipe.recipe-type         = p-recipe-type
     3532               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3533               buf_recipe.gds-code            = p-gds-code
     3534               buf_recipe.host-code           = v-host-code
     3535               buf_recipe.obj-type            = p-obj-type
     3536               buf_recipe.obj-code            = p-obj-code
     3537               buf_recipe.recipe-design       = ""
     3538               buf_recipe.recipe-order        = 0
     3539               buf_recipe.recipe-quality      = ""
     3540               buf_recipe.recipe-ref-num      = ""
     3541               buf_recipe.recipe-technique    = ""
     3542               buf_recipe.recipe-template     = ""
     3543               buf_recipe.qnty                = 1.0
     3544               buf_recipe.portion-qnty        = 1
     3545               buf_recipe.portion-weight      = 0
     3546           .
     3547       end.
     3548       if p-name <> ""
     3549       then do:
     3550           assign
     3551               buf_recipe.recipe-name = p-name
     3552           .
     3553       end.
     3554       assign
     3555           buf_recipe.recipe-design       = p-design
     3556           buf_recipe.recipe-order        = p-order
     3557           buf_recipe.recipe-quality      = p-quality
     3558           buf_recipe.recipe-ref-num      = p-ref-num
     3559           buf_recipe.recipe-technique    = p-technique
     3560           buf_recipe.recipe-template     = p-template
     3561           buf_recipe.qnty                = p-qnty
     3562           buf_recipe.portion-qnty        = p-portion-qnty
     3563           buf_recipe.portion-weight      = p-portion-weight
     3564       .
     3565       assign
     3566           p-new-recipe-code = buf_recipe.recipe-code
     3567       .
     3568       run fbrlib-set-default-recipe in this-procedure (
     3569             input p-obj-type
     3570           , input p-obj-code
     3571           , input buf_goods.gds-code
     3572       ).
     3573   end.
     3574   END PROCEDURE.
     3575   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3576   define input parameter parparentproc-handle as widget-handle no-undo .
     3577   define input parameter p-doc-code   as character no-undo.
     3578   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3579       define variable v-shift-on      as logical      no-undo.
     3580       define variable v-shift-date    as date         no-undo.
     3581       define variable v-shift-num     as integer      no-undo.
     3582       define variable v-shift-name    as character    no-undo.
     3583       define variable v-obj-date      as date         no-undo.
     3584       define variable v-chip-num      as integer      no-undo.
     3585       define buffer buf_fbr-doc       for ub.fbr-doc.
     3586       define buffer buf_fbr-line      for ub.fbr-line.
     3587       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3588       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3589       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3590       define buffer buf_marking-lines for ub.marking-lines .
     3591       define buffer buf_marking       for ub.marking .
     3592       define buffer buf_goods         for ub.goods .
     3593   do
     3594   for buf_fbr-doc
     3595     , buf_fbr-line
     3596     , buf_c-fbr-doc
     3597     , buf_fbr-recipe
     3598     , buf_fbr-recipe-gds
     3599     , buf_goods
     3600     , buf_marking
     3601     , buf_marking-lines
     3602   on error undo, return error
     3603   :
     3604   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3605     define variable v-cntxt-db-num        as integer   no-undo .
     3606     define variable v-cntxt-userid        as character no-undo .
     3607     define variable v-cntxt-level         as character no-undo .
     3608     define variable v-cntxt-host-code-obj as integer   no-undo .
     3609     define variable v-cntxt-obj-type      as character no-undo .
     3610     define variable v-cntxt-obj-code      as integer   no-undo .
     3611     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3612     define variable v-cntxt-is-admin      as logical   no-undo .
     3613   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3614     run mainmenu_getcntxt in parparentproc-handle
     3615       (output v-cntxt-db-num
     3616       ,output v-cntxt-userid
     3617       ,output v-cntxt-level
     3618       ,output v-cntxt-host-code-obj
     3619       ,output v-cntxt-obj-type
     3620       ,output v-cntxt-obj-code
     3621       ,output v-cntxt-db-num-obj
     3622       ,output v-cntxt-is-admin
     3623       ) .
     3624       if search ("delfbr.err") <> ?
     3625       then do:
     3626           os-delete "delfbr.err".
     3627       end.
     3628     _del-block:
     3629       do transaction
     3630     on error undo _del-block, return error return-value
     3631     on endkey undo _del-block , return error return-value
     3632     on stop undo _del-block , return error return-value
     3633       :
     3634           find first buf_fbr-doc exclusive-lock
     3635                where buf_fbr-doc.doc-code = p-doc-code
     3636           no-error.
     3637           if not available buf_fbr-doc
     3638           then do:
     3639         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3640                                           ,vss-workfile
     3641                                           ,vss-revision
     3642                                           ,vss-description
     3643                                           ,chr(10)
     3644                                           , p-doc-code).
     3645           end.
     3646           run fbrlib-delete-fact-trn-doc in this-procedure (
     3647               input parparentproc-handle
     3648              ,input p-doc-code
     3649              ,input 'при':U
     3650              ,input p-chip-num
     3651              ,output v-chip-num
     3652           ) no-error.
     3653           if error-status :error
     3654           then do:
     3655               run fbrlib-print-del-error-message in this-procedure .
     3656         undo _del-block, return error.
     3657           end.
     3658           assign
     3659           p-chip-num = (if p-chip-num = ?
     3660                         then v-chip-num
     3661                         else p-chip-num).
     3662           run fbrlib-delete-fact-trn-doc in this-procedure (
     3663               input parparentproc-handle
     3664              ,input p-doc-code
     3665              ,input 'рас':U
     3666              ,input p-chip-num
     3667              ,output v-chip-num
     3668           ) no-error.
     3669           if error-status :error
     3670           then do:
     3671               run fbrlib-print-del-error-message in this-procedure .
     3672         undo _del-block, return error.
     3673           end.
     3674           run fbrlib-delete-fact-trn-doc in this-procedure (
     3675               input parparentproc-handle
     3676              ,input p-doc-code
     3677              ,input 'спи':U
     3678              ,input p-chip-num
     3679              ,output v-chip-num
     3680           ) no-error.
     3681           if error-status :error
     3682           then do:
     3683               run fbrlib-print-del-error-message in this-procedure .
     3684         undo _del-block, return error.
     3685           end.
     3686           create buf_c-fbr-doc.
     3687           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3688   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3690     (input  buf_fbr-doc.obj-type
     3691     ,input  buf_fbr-doc.obj-code
     3692     ,output v-obj-date
     3693     ) no-error .
     3694           if error-status :error
     3695           or v-obj-date = ?
     3696           then do:
     3697         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3698           end.
     3699   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3701     (input  buf_fbr-doc.obj-type
     3702     ,input  buf_fbr-doc.obj-code
     3703     ,input  'shift-on=request'
     3704     ,output v-shift-on
     3705     )  .
     3706           if v-shift-on
     3707           then do:
     3708   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3709   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3710     (input  buf_fbr-doc.obj-type
     3711     ,input  buf_fbr-doc.obj-code
     3712     ,output v-shift-date
     3713     ,output v-shift-num
     3714     ,output v-shift-name
     3715     ) no-error .
     3716               if error-status :error
     3717               then do:
     3718           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3719               end.
     3720           end.
     3721           else do:
     3722               assign
     3723                   v-shift-date = ?
     3724                   v-shift-num  = ?
     3725                   v-shift-name = ?
     3726               .
     3727           end.
     3728           define variable v-today       as date         no-undo.
     3729           define variable v-time        as integer      no-undo.
     3730           run cur-time in this-procedure (
     3731                 output v-today
     3732               , output v-time
     3733           ).
     3734           assign
     3735               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3736               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3737               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3738               buf_c-fbr-doc.corr-date        = v-today
     3739               buf_c-fbr-doc.corr-time        = v-time
     3740               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3741               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3742               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3743               buf_c-fbr-doc.is-del           = yes
     3744           .
     3745           assign
     3746               buf_fbr-doc.is-del = yes
     3747           .
     3748           for each buf_fbr-line exclusive-lock
     3749              where buf_fbr-line.doc-code = p-doc-code
     3750       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3751       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3752       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3753           :
     3754               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3755                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3756                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3757               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3758                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3759                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3760                                                       and buf_marking-lines.in-code  = "manufacturing"
     3761                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3762                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3763                                                       and buf_marking-lines.prt-code = 0
     3764               :
     3765                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3766                   assign
     3767                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3768                   .
     3769                 end .
     3770                 delete buf_marking-lines.
     3771               end .
     3772               delete buf_fbr-line.
     3773           end.
     3774           for each buf_fbr-recipe exclusive-lock
     3775              where buf_fbr-recipe.doc-code = p-doc-code
     3776       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3777       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3778       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3779           :
     3780               delete buf_fbr-recipe.
     3781           end.
     3782           for each buf_fbr-recipe-gds exclusive-lock
     3783              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3784       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3785       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3786       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3787           :
     3788               delete buf_fbr-recipe-gds.
     3789           end.
     3790           delete buf_fbr-doc.
     3791       end.
     3792   end.
     3793   END PROCEDURE.
     3794   PROCEDURE fbrlib-del-trn-doc :
     3795   do
     3796   on error undo, return error
     3797   :
     3798   define input parameter parparentproc        as widget-handle no-undo .
     3799   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3800   define input parameter p-trn-doc-type       as character    no-undo.
     3801   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3802   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3803       define variable v-trn-doc-doc-code  as character     no-undo.
     3804       define buffer buf_trn-doc       for ub.trn-doc.
     3805   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3806     define variable v-cntxt-db-num        as integer   no-undo .
     3807     define variable v-cntxt-userid        as character no-undo .
     3808     define variable v-cntxt-level         as character no-undo .
     3809     define variable v-cntxt-host-code-obj as integer   no-undo .
     3810     define variable v-cntxt-obj-type      as character no-undo .
     3811     define variable v-cntxt-obj-code      as integer   no-undo .
     3812     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3813     define variable v-cntxt-is-admin      as logical   no-undo .
     3814   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3815     run mainmenu_getcntxt in parparentproc
     3816       (output v-cntxt-db-num
     3817       ,output v-cntxt-userid
     3818       ,output v-cntxt-level
     3819       ,output v-cntxt-host-code-obj
     3820       ,output v-cntxt-obj-type
     3821       ,output v-cntxt-obj-code
     3822       ,output v-cntxt-db-num-obj
     3823       ,output v-cntxt-is-admin
     3824       ) .
     3825       run fbrcode-trn-doc in this-procedure (
     3826             input 'производство':U
     3827           , input p-fbr-doc-doc-code
     3828           , input p-trn-doc-type
     3829           , output v-trn-doc-doc-code
     3830       ).
     3831       find first buf_trn-doc no-lock
     3832            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3833       no-error.
     3834       if available buf_trn-doc
     3835       then do:
     3836           run str/del-doc.p (
     3837                 input parparentproc
     3838               , input buf_trn-doc.doc-code
     3839               , input v-cntxt-db-num
     3840               , input "del-doc.err"
     3841               , input ?
     3842               , input p-fbr-doc-doc-code
     3843               , input v-cntxt-userid
     3844               , input 0
     3845               , input p-phchip-num
     3846               , output p-chip-num
     3847           ) no-error.
     3848           if error-status :error
     3849           then do:
     3850             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3851                                           ,v-trn-doc-doc-code
     3852                                           ,p-fbr-doc-doc-code
     3853                                           , chr(10)
     3854                                           , error-status:get-message(1)
     3855                                           , return-value ).
     3856           end.
     3857       end.
     3858   end.
     3859   END PROCEDURE.
     3860   PROCEDURE fbrlib-delete-fact-trn-doc :
     3861   define input parameter parparentproc    as widget-handle    no-undo.
     3862   define input parameter p-fbr-doc-code   as character        no-undo.
     3863   define input parameter p-doc-type       as character    no-undo.
     3864   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3865   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3866       define variable v-doc-code          as character        no-undo.
     3867       define variable v-ext-doc-type      as character        no-undo.
     3868       define variable v-trn-doc-recid     as recid            no-undo.
     3869       define variable varchip-code        as integer          no-undo.
     3870       define variable varchip-code2       as integer          no-undo.
     3871       define variable v-chip-counter      as integer          no-undo.
     3872       define buffer buf_trn-doc       for ub.trn-doc.
     3873       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3874       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3875   do
     3876   for buf_trn-doc
     3877     , buf_pri_trn-doc
     3878     , buf_cons_trn-doc
     3879   on error undo, return error
     3880   :
     3881   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3882     define variable v-cntxt-db-num        as integer   no-undo .
     3883     define variable v-cntxt-userid        as character no-undo .
     3884     define variable v-cntxt-level         as character no-undo .
     3885     define variable v-cntxt-host-code-obj as integer   no-undo .
     3886     define variable v-cntxt-obj-type      as character no-undo .
     3887     define variable v-cntxt-obj-code      as integer   no-undo .
     3888     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3889     define variable v-cntxt-is-admin      as logical   no-undo .
     3890   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3891     run mainmenu_getcntxt in parparentproc
     3892       (output v-cntxt-db-num
     3893       ,output v-cntxt-userid
     3894       ,output v-cntxt-level
     3895       ,output v-cntxt-host-code-obj
     3896       ,output v-cntxt-obj-type
     3897       ,output v-cntxt-obj-code
     3898       ,output v-cntxt-db-num-obj
     3899       ,output v-cntxt-is-admin
     3900       ) .
     3901       run fbrcode-trn-doc in this-procedure (
     3902             input 'производство':U
     3903           , input p-fbr-doc-code
     3904           , input p-doc-type
     3905           , output v-doc-code
     3906       ).
     3907       find first buf_trn-doc no-lock
     3908            where buf_trn-doc.doc-code = v-doc-code
     3909       no-error.
     3910       if not available buf_trn-doc
     3911       then do:
     3912           if p-doc-type <> 'спи':U
     3913           then do:
     3914               message
     3915                   "Не найден документ '" p-doc-type "'"
     3916                   "по документу производства " p-fbr-doc-code
     3917               view-as alert-box.
     3918               undo, return error.
     3919           end.
     3920           else do:
     3921           end.
     3922       end.
     3923       else do:
     3924           assign
     3925               v-trn-doc-recid = recid( buf_trn-doc )
     3926               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3927           .
     3928           if v-ext-doc-type = 'ev':U
     3929           then do:
     3930               find first buf_pri_trn-doc no-lock
     3931                    where buf_pri_trn-doc.out-code     = v-doc-code
     3932                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3933               no-error.
     3934               if available buf_pri_trn-doc
     3935               then do:
     3936                   run str/del-doc.p (
     3937                         input parparentproc
     3938                       , input buf_pri_trn-doc.doc-code
     3939                       , input v-cntxt-db-num
     3940                       , input "delfbr.err"
     3941                       , input ?
     3942                       , input p-fbr-doc-code
     3943                       , input v-cntxt-userid
     3944                       , input 0
     3945                       , input (if p-ph-chip-num <> ?
     3946                               then p-ph-chip-num
     3947                               else (if varchip-code <> 0
     3948                                   then varchip-code
     3949                                   else ?)
     3950                               )
     3951                       , output varchip-code2
     3952                   ) no-error.
     3953                   if error-status :error
     3954                   then do:
     3955                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3956                                                   ,buf_pri_trn-doc.doc-code
     3957                                                   ,p-fbr-doc-code
     3958                                                   , chr(10)
     3959                                                   , error-status:get-message(1)
     3960                                                   , return-value ).
     3961                   end.
     3962               end.
     3963           end.
     3964           define buffer buf_out_trn-doc       for ub.trn-doc.
     3965           if p-doc-type = 'при':U
     3966           then do:
     3967               assign
     3968                   v-chip-counter = 0
     3969               .
     3970               for each buf_out_trn-doc exclusive-lock
     3971                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3972               on error undo, return error
     3973               :
     3974                   assign
     3975                       v-chip-counter = v-chip-counter + 1
     3976                   .
     3977                   if v-chip-counter > 1
     3978                   then do:
     3979                       assign
     3980                           varchip-code = varchip-code2
     3981                       .
     3982                   end.
     3983                   run str/del-doc.p (
     3984                         input parparentproc
     3985                       , input buf_out_trn-doc.doc-code
     3986                       , input v-cntxt-db-num
     3987                       , input "delfbr.err"
     3988                       , input ?
     3989                       , input p-fbr-doc-code
     3990                       , input v-cntxt-userid
     3991                       , input 0
     3992                       , input (if p-ph-chip-num <> ?
     3993                               then p-ph-chip-num
     3994                               else (if varchip-code <> 0
     3995                                   then varchip-code
     3996                                   else ?)
     3997                               )
     3998                       , output varchip-code2
     3999                   ) no-error.
     4000                   if error-status :error
     4001                   then do:
     4002                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     4003                                                   ,buf_out_trn-doc.doc-code
     4004                                                   ,buf_trn-doc.doc-code
     4005                                                   ,p-fbr-doc-code
     4006                                                   , chr(10)
     4007                                                   , error-status:get-message(1)
     4008                                                   , return-value ).
     4009                   end.
     4010               end.
     4011           end.
     4012           run str/del-doc.p (
     4013                 input parparentproc
     4014               , input buf_trn-doc.doc-code
     4015               , input v-cntxt-db-num
     4016               , input "delfbr.err"
     4017               , input ?
     4018               , input p-fbr-doc-code
     4019               , input v-cntxt-userid
     4020               , input 0
     4021               , input (if p-ph-chip-num <> ?
     4022                        then p-ph-chip-num
     4023                        else (if varchip-code <> 0
     4024                              then varchip-code
     4025                              else ?)
     4026                        )
     4027               , output varchip-code2
     4028           ) no-error.
     4029           if error-status :error
     4030           then do:
     4031               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4032                                             ,buf_trn-doc.doc-code
     4033                                             ,p-fbr-doc-code
     4034                                             , chr(10)
     4035                                             , error-status:get-message(1)
     4036                                             , return-value ).
     4037           end.
     4038           if p-doc-type = 'рас':U
     4039           or p-doc-type = 'спи':U
     4040           then do:
     4041               assign
     4042                   v-chip-counter = 0
     4043               .
     4044               for each buf_cons_trn-doc no-lock
     4045                  where buf_cons_trn-doc.out-code      = v-doc-code
     4046                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     4047               :
     4048                   assign
     4049                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     4050                       v-chip-counter = v-chip-counter + 1
     4051                   .
     4052                   assign
     4053                   varchip-code = if v-chip-counter = 2
     4054                                  then varchip-code2
     4055                                  else varchip-code.
     4056                   run str/del-doc.p (
     4057                         input parparentproc
     4058                       , input buf_cons_trn-doc.doc-code
     4059                       , input v-cntxt-db-num
     4060                       , input "delfbr.err"
     4061                       , input ?
     4062                       , input ?
     4063                       , input v-cntxt-userid
     4064                       , input 0
     4065                       , input (if p-ph-chip-num <> ?
     4066                                then p-ph-chip-num
     4067                                else ( if v-chip-counter = 1
     4068                                       then ?
     4069                                       else varchip-code )
     4070                                )
     4071                       , output varchip-code2
     4072                   ) no-error.
     4073                   if error-status :error
     4074                   then do:
     4075                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     4076                                                     ,buf_cons_trn-doc.doc-code
     4077                                                     ,p-fbr-doc-code
     4078                                                     , chr(10)
     4079                                                     , error-status:get-message(1)
     4080                                                     , return-value ).
     4081                   end.
     4082                   assign
     4083                       p-chip-num = varchip-code2
     4084                   .
     4085               end.
     4086           end.
     4087           assign
     4088               p-chip-num = varchip-code2
     4089           .
     4090       end.
     4091   end.
     4092   END PROCEDURE.
     4093   PROCEDURE fbrlib-print-del-error-message :
     4094   do
     4095   on error undo, return error
     4096   :
     4097       define variable v-user-action   as character    no-undo.
     4098       define variable v-printed       as logical      no-undo.
     4099       message
     4100           vss-workfile vss-revision vss-description
     4101           skip "Ошибка при удалении документа."
     4102           skip return-value
     4103           skip trim(error-status :get-message(1))
     4104           skip trim(error-status :get-message(2))
     4105           skip trim(error-status :get-message(3))
     4106       view-as alert-box error.
     4107       if search ("delfbr.err") <> ?
     4108       then do:
     4109         run gbl/prnfilen.w
     4110           (input  "Ошибки при удалении документа производства"
     4111           ,input  0
     4112           ,input  "delfbr.err"
     4113           ,input  7
     4114           ,output v-user-action
     4115           ,output v-printed
     4116           ).
     4117       end.
     4118   end.
     4119   END PROCEDURE.
     4120   procedure fbrlib-calc-brutto :
     4121   define input parameter p-recipe-type        as character        no-undo.
     4122   define input parameter p-netto              as decimal          no-undo.
     4123   define input parameter p-coeff-value        as decimal          no-undo.
     4124   define input parameter p-coeff-waste        as decimal          no-undo.
     4125   define input parameter p-brutto             as decimal          no-undo.
     4126   define input parameter p-calc-method        as integer          no-undo.
     4127   define output parameter p-new-netto         as decimal          no-undo.
     4128   define output parameter p-new-coeff-waste   as decimal          no-undo.
     4129   define output parameter p-new-brutto        as decimal          no-undo.
     4130   define output parameter p-new-calc-method   as integer          no-undo.
     4131   do
     4132   on error undo, return error
     4133   :
     4134       if p-recipe-type <> 'производство':U
     4135       then do:
     4136           assign
     4137               p-new-coeff-waste = 0
     4138               p-new-calc-method = 1
     4139               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     4140               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     4141           .
     4142       end.
     4143       else do:
     4144           assign
     4145               p-new-calc-method = p-calc-method
     4146           .
     4147           if p-coeff-waste = 0
     4148           then do:
     4149               assign
     4150                   p-coeff-value = 0
     4151               .
     4152           end.
     4153           case p-calc-method
     4154           :
     4155               when 1
     4156               then do:
     4157                   assign
     4158                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4159                       p-new-coeff-waste   = p-coeff-waste
     4160                       p-new-brutto        = p-brutto
     4161                   .
     4162               end.
     4163               when 2
     4164               then do:
     4165                   assign
     4166                       p-new-netto         = p-netto
     4167                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     4168                       p-new-brutto        = p-brutto
     4169                   .
     4170               end.
     4171               when 3
     4172               then do:
     4173                   assign
     4174                       p-new-netto         = p-netto
     4175                       p-new-coeff-waste   = p-coeff-waste
     4176                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     4177                   .
     4178               end.
     4179               otherwise do:
     4180                   define variable v-yesno    as logical      no-undo.
     4181                   assign
     4182                       v-yesno = yes
     4183                   .
     4184                   message
     4185                       "Неверный метод для расчета брутто, нетто и процента потерь."
     4186                       skip "Значение метода должно быть 1, 2 или 3."
     4187                       skip(1)
     4188                       skip "Заданное значение:" p-calc-method
     4189                       skip(1)
     4190                       skip "Установить значение метода расчета 1"
     4191                       skip "(расчет нетто по брутто и проценту потерь)?"
     4192                   view-as alert-box warning
     4193                   buttons yes-no
     4194                   title "Неверное значение метода пересчета в строках документа-производства"
     4195                   update v-yesno
     4196                   .
     4197                   if v-yesno = yes
     4198                   then do:
     4199                       assign
     4200                           p-new-calc-method   = 1
     4201                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4202                           p-new-coeff-waste   = p-coeff-waste
     4203                           p-new-brutto        = p-brutto
     4204                       .
     4205                   end.
     4206                   else do:
     4207                       message
     4208                               vss-workfile vss-revision vss-description
     4209                           skip(1)
     4210                           skip "Ошибка расчета брутто, нетто и процента потерь."
     4211                           skip return-value
     4212                           skip trim(error-status :get-message(1))
     4213                               trim(error-status :get-message(2))
     4214                               trim(error-status :get-message(3))
     4215                       view-as alert-box error
     4216                       title "Неверное значение метода расчета"
     4217                       .
     4218                       undo, return error .
     4219                   end.
     4220               end.
     4221           end case.
     4222       end.
     4223   end.
     4224   end procedure.
     4225   procedure fbrlib-check-brutto :
     4226   define input parameter p-recipe-type        as character        no-undo.
     4227   define input parameter p-netto              as decimal          no-undo.
     4228   define input parameter p-coeff-value        as decimal          no-undo.
     4229   define input parameter p-coeff-waste        as decimal          no-undo.
     4230   define input parameter p-brutto             as decimal          no-undo.
     4231   define input parameter p-calc-method        as integer          no-undo.
     4232   define output parameter p-error-message     as character        no-undo.
     4233   define output parameter p-not-good          as logical          no-undo.
     4234   do
     4235   on error undo, return error
     4236   :
     4237       if p-recipe-type <> 'производство':U
     4238       then do:
     4239           if p-netto <> p-brutto
     4240           or p-coeff-waste <> 0
     4241           then do:
     4242               assign
     4243                   p-not-good      = yes
     4244                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     4245                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     4246               .
     4247           end.
     4248       end.
     4249       else do:
     4250           if p-coeff-waste = 0
     4251           then do:
     4252               assign
     4253                   p-coeff-value = 0
     4254               .
     4255           end.
     4256           case p-calc-method
     4257           :
     4258               when 1
     4259               then do:
     4260                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     4261                   then do:
     4262                       assign
     4263                           p-not-good      = yes
     4264                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     4265                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4266                       .
     4267                   end.
     4268               end.
     4269               when 2
     4270               then do:
     4271                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     4272                   then do:
     4273                       assign
     4274                           p-not-good      = yes
     4275                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     4276                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     4277                       .
     4278                   end.
     4279               end.
     4280               when 3
     4281               then do:
     4282                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     4283                   then do:
     4284                       assign
     4285                           p-not-good      = yes
     4286                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4287                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4288                       .
     4289                   end.
     4290               end.
     4291               otherwise do:
     4292                   assign
     4293                       p-not-good      = yes
     4294                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4295                   .
     4296               end.
     4297           end case.
     4298       end.
     4299   end.
     4300   end procedure.
     4301   procedure fbrlib-check-fbr-recipe :
     4302   define input parameter p-doc-code       as character        no-undo.
     4303   define input parameter p-recipe-code    as character        no-undo.
     4304   define output parameter p-is-correct    as logical          no-undo.
     4305       define variable v-comp-factor    as decimal      no-undo.
     4306       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4307       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4308       define buffer buf_fbr-line          for ub.fbr-line.
     4309   do
     4310   for buf_fbr-recipe
     4311     , buf_fbr-recipe-gds
     4312     , buf_fbr-line
     4313   on error undo, return error
     4314   :
     4315       assign
     4316           p-is-correct = yes
     4317       .
     4318       find first buf_fbr-recipe no-lock
     4319            where buf_fbr-recipe.doc-code    = p-doc-code
     4320              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4321       .
     4322       if not available buf_fbr-recipe then do:
     4323         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4324       end.
     4325       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4326       then do:
     4327       end.
     4328       else do:
     4329           find first buf_fbr-line no-lock
     4330                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4331                  and buf_fbr-line.is-comp     = yes
     4332                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4333                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4334                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4335                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4336           .
     4337           assign
     4338               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4339           .
     4340           recipe-line-cycle:
     4341           for each buf_fbr-recipe-gds no-lock
     4342              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4343                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4344           on error undo, return error
     4345           :
     4346               find first buf_fbr-line no-lock
     4347                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4348                      and buf_fbr-line.is-comp     = no
     4349                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4350                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4351                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4352                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4353               .
     4354               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4355               then do:
     4356                   assign
     4357                       p-is-correct = no
     4358                   .
     4359                   leave recipe-line-cycle.
     4360               end.
     4361           end.
     4362       end.
     4363   end.
     4364   end procedure.
     4365   procedure fbrlib-get-recipe-type :
     4366   define input parameter p-fbr-doc-code   as character        no-undo.
     4367   define input parameter p-recipe-code    as character        no-undo.
     4368   define output parameter p-recipe-type   as character        no-undo.
     4369       define buffer buf_recipe        for ub.recipe.
     4370       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4371   do
     4372   for buf_recipe
     4373     , buf_fbr-recipe
     4374   on error undo, return error
     4375   :
     4376       if p-fbr-doc-code = ""
     4377       then do:
     4378           find first buf_recipe no-lock
     4379                where buf_recipe.recipe-code = p-recipe-code
     4380           no-error.
     4381           if available buf_recipe
     4382           then do:
     4383               assign
     4384                   p-recipe-type = buf_recipe.recipe-type
     4385               .
     4386           end.
     4387           else do:
     4388               assign
     4389                   p-recipe-type = "":U
     4390               .
     4391           end.
     4392       end.
     4393       else do:
     4394           find first buf_fbr-recipe no-lock
     4395                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4396                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4397           no-error.
     4398           if available buf_fbr-recipe
     4399           then do:
     4400               assign
     4401                   p-recipe-type = buf_fbr-recipe.recipe-type
     4402               .
     4403           end.
     4404           else do:
     4405               assign
     4406                   p-recipe-type = "":U
     4407               .
     4408           end.
     4409       end.
     4410   end.
     4411   end procedure.
     4412   PROCEDURE calc-comp-from-ingr :
     4413   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4414   define input parameter p-fact-qnty                          as decimal      no-undo.
     4415   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4416   define output parameter p-comp-qnty                         as decimal      no-undo.
     4417       define variable v-ingr-qnty     as decimal       no-undo.
     4418       define buffer buf_i_fbr-line    for ub.fbr-line.
     4419       define buffer buf_fbr-line      for ub.fbr-line.
     4420       define buffer buf_recipe        for ub.fbr-recipe.
     4421       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4422   do
     4423   for buf_i_fbr-line
     4424     , buf_fbr-line
     4425     , buf_recipe
     4426     , buf_recipe-gds
     4427   on error undo, return error
     4428   :
     4429       find first buf_i_fbr-line no-lock
     4430            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4431       .
     4432       find first buf_recipe no-lock
     4433            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4434              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4435       no-error.
     4436       if not available buf_recipe
     4437       then do:
     4438           message
     4439                   vss-workfile vss-revision vss-description
     4440               skip "В строке производства не указан рецепт."
     4441               skip "Невозможно рассчитать количество составного товара."
     4442               skip return-value
     4443               skip trim(error-status :get-message(1))
     4444                   trim(error-status :get-message(2))
     4445                   trim(error-status :get-message(3))
     4446           view-as alert-box error.
     4447           undo, return error .
     4448       end.
     4449       if buf_recipe.recipe-type = 'альтернатива':U
     4450       then do:
     4451           for each buf_fbr-line no-lock
     4452              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4453                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4454                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4455           on error undo, return error
     4456           :
     4457               find first buf_recipe-gds no-lock
     4458                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4459                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4460                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4461                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4462                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4463               .
     4464               assign
     4465                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4466               .
     4467           end.
     4468           assign
     4469               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4470           .
     4471       end.
     4472       else do:
     4473           find first buf_recipe-gds no-lock
     4474                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4475                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4476                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4477                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4478                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4479           .
     4480           assign
     4481               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4482           .
     4483       end.
     4484       find first buf_fbr-line no-lock
     4485            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4486              and buf_fbr-line.is-comp     = yes
     4487              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4488       .
     4489       assign
     4490           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4491       .
     4492   end.
     4493   END PROCEDURE.
     4494   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4495   define input parameter p-recipe-code    as character    no-undo.
     4496   define input parameter p-gds-code       as integer      no-undo.
     4497   define output parameter p-line-qnty     as decimal      no-undo.
     4498   define output parameter p-used-qnty     as decimal      no-undo.
     4499   define output parameter p-recipe-qnty   as decimal      no-undo.
     4500       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4501   do
     4502   for buf_temp_dressing-ingr
     4503   on error undo, return error
     4504   :
     4505       find first buf_temp_dressing-ingr no-lock
     4506            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4507              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4508       no-error.
     4509       if available buf_temp_dressing-ingr
     4510       then do:
     4511           assign
     4512               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4513               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4514               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4515           .
     4516       end.
     4517       else do:
     4518           assign
     4519               p-line-qnty     = 0
     4520               p-used-qnty     = 0
     4521               p-recipe-qnty   = 0
     4522           .
     4523       end.
     4524   end.
     4525   END PROCEDURE.
     4526   PROCEDURE fbrlib_adjust-recipe :
     4527   do
     4528   on error undo, return error
     4529   :
     4530   define input parameter parparentproc as widget-handle no-undo .
     4531   define input parameter p-fbrhist-handle as handle no-undo .
     4532   define input parameter p-doc-code       as character    no-undo.
     4533   define input parameter p-recipe-code    as character    no-undo.
     4534   define input parameter p-price-sale-obj-type as character no-undo .
     4535   define input parameter p-price-sale-obj-code as integer no-undo .
     4536       define variable v-recipe-qnty       as decimal      no-undo.
     4537       define variable v-comp-qnty         as decimal      no-undo.
     4538       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4539       define variable v-ingr-qnty         as decimal      no-undo.
     4540       define variable v-qnty              as decimal      no-undo.
     4541       define variable v-coeff-waste       as decimal      no-undo.
     4542       define variable v-brutto-qnty       as decimal      no-undo.
     4543       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4544       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4545       define buffer buf_fbr-line          for ub.fbr-line.
     4546       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4547       find first buf_fbr-recipe no-lock
     4548            where buf_fbr-recipe.doc-code      = p-doc-code
     4549              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4550       .
     4551       assign
     4552           v-recipe-qnty = buf_fbr-recipe.qnty
     4553       .
     4554       find first buf_fbr-line no-lock
     4555            where buf_fbr-line.doc-code    = p-doc-code
     4556              and buf_fbr-line.is-comp     = yes
     4557              and buf_fbr-line.recipe-code = p-recipe-code
     4558       .
     4559       assign
     4560           v-comp-qnty = buf_fbr-line.fact-qnty
     4561       .
     4562       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4563       then do:
     4564       end.
     4565       else do:
     4566           for each buf_fbr-recipe-gds no-lock
     4567              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4568                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4569           on error undo, return error
     4570           :
     4571               find first buf_fbr-line no-lock
     4572                    where buf_fbr-line.doc-code    = p-doc-code
     4573                      and buf_fbr-line.is-comp     = no
     4574                      and buf_fbr-line.recipe-code = p-recipe-code
     4575                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4576                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4577                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4578               .
     4579               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4580               then do:
     4581                   do transaction
     4582                   on error undo, return error
     4583                   :
     4584                       find first buf_el_fbr-recipe-gds exclusive-lock
     4585                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4586                       .
     4587                       assign
     4588                           buf_el_fbr-recipe-gds.calc-method   = 1
     4589                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4590                       .
     4591                       run fbrlib-calc-brutto in this-procedure (
     4592                             input buf_fbr-recipe.recipe-type
     4593                           , input 0
     4594                           , input buf_el_fbr-recipe-gds.coeff-value
     4595                           , input buf_el_fbr-recipe-gds.coeff-waste
     4596                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4597                           , input 1
     4598                           , output buf_el_fbr-recipe-gds.qnty
     4599                           , output buf_el_fbr-recipe-gds.coeff-waste
     4600                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4601                           , output buf_el_fbr-recipe-gds.calc-method
     4602                       ).
     4603                   end.
     4604               end.
     4605           end.
     4606           run fbrlib_adjust-doc-lines in this-procedure (
     4607                 input parparentproc
     4608               , input p-fbrhist-handle
     4609               , input p-doc-code
     4610               , input p-recipe-code
     4611               , input p-price-sale-obj-type
     4612               , input p-price-sale-obj-code
     4613           ).
     4614       end.
     4615   end.
     4616   END PROCEDURE.
     4617   PROCEDURE fbrlib_adjust-doc-lines :
     4618   define input parameter parparentproc as widget-handle no-undo .
     4619   define input parameter p-fbrhist-handle as handle no-undo .
     4620   define input parameter p-doc-code       as character    no-undo.
     4621   define input parameter p-recipe-code    as character    no-undo.
     4622   define input parameter p-price-sale-obj-type as character no-undo .
     4623   define input parameter p-price-sale-obj-code as integer no-undo .
     4624   define variable v-comp-qnty         as decimal      no-undo.
     4625   define variable v-trn-type          as character    no-undo.
     4626   define variable v-ingr-qnty         as decimal      no-undo.
     4627   define variable v-recipe-qnty       as decimal      no-undo.
     4628   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4629   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4630   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4631   define buffer buf_fbr-line          for ub.fbr-line.
     4632   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4633   define buffer buf_goods             for ub.goods.
     4634   define buffer buf_fbr-doc           for ub.fbr-doc.
     4635   do
     4636   for buf_fbr-recipe
     4637     , buf_fbr-recipe-gds
     4638     , buf_fbr-line
     4639     , buf_coeff_fbr-line
     4640     , buf_goods
     4641     , buf_fbr-doc
     4642   on error undo, return error
     4643   :
     4644       find first buf_fbr-line no-lock
     4645            where buf_fbr-line.doc-code      = p-doc-code
     4646              and buf_fbr-line.is-comp       = yes
     4647              and buf_fbr-line.recipe-code   = p-recipe-code
     4648       .
     4649       find first buf_fbr-doc no-lock
     4650            where buf_fbr-doc.doc-code      = p-doc-code
     4651       .
     4652       assign
     4653           v-comp-qnty = buf_fbr-line.fact-qnty
     4654           v-trn-type  = buf_fbr-line.trn-type
     4655       .
     4656       find first buf_fbr-recipe no-lock
     4657            where buf_fbr-recipe.doc-code    = p-doc-code
     4658              and buf_fbr-recipe.recipe-code = p-recipe-code
     4659       .
     4660       assign
     4661       v-recipe-qnty = buf_fbr-recipe.qnty
     4662       .
     4663       do transaction
     4664       on error undo, return error
     4665       :
     4666           for each buf_fbr-recipe-gds no-lock
     4667              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4668                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4669           on error undo, return error
     4670           :
     4671               find first buf_fbr-line no-lock
     4672                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4673                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4674                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4675                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4676                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4677               no-error.
     4678               if not available buf_fbr-line
     4679               then do:
     4680                   find first buf_goods no-lock
     4681                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4682                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4683                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4684                   .
     4685                   run str/fbr-crln.p (
     4686                         input parparentproc
     4687                       , input recid( buf_fbr-doc )
     4688                       , input recid( buf_goods )
     4689                       , input buf_fbr-recipe-gds.recipe-code
     4690                       , input v-trn-type
     4691                       , input no
     4692                       , input no
     4693                       , input buf_fbr-doc.obj-type
     4694                       , input buf_fbr-doc.obj-code
     4695                       , output v-fbr-v-fbr-doc-line-recid
     4696                   ).
     4697                   find first buf_fbr-line no-lock
     4698                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4699                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4700                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4701                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4702                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4703                   no-error.
     4704                   if not available buf_fbr-line
     4705                   then do:
     4706                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4707                                                      , p-doc-code
     4708                                                      , buf_fbr-recipe-gds.artic
     4709                                                      , buf_fbr-recipe-gds.prod-type
     4710                                                      , buf_fbr-recipe-gds.prod-code).
     4711                   end.
     4712               end.
     4713               find first buf_coeff_fbr-line exclusive-lock
     4714                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4715               .
     4716               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4717               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4718               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4719               then do:
     4720                   assign
     4721                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4722                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4723                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4724                   .
     4725               end.
     4726           end.
     4727       end.
     4728       define variable v-need-goods    as logical       no-undo.
     4729       define variable v-need-goods-list       as character     no-undo.
     4730       define variable v-need-goods-qnty-list  as character     no-undo.
     4731       find first buf_fbr-line no-lock
     4732            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4733              and buf_fbr-line.is-comp     = yes
     4734              and buf_fbr-line.recipe-code = p-recipe-code
     4735       .
     4736       run str/fbr-qnty.p (
     4737             input parparentproc
     4738           , input p-fbrhist-handle
     4739           , input recid( buf_fbr-doc )
     4740           , input recid( buf_fbr-line )
     4741           , input no
     4742           , input "ingr"
     4743           , input no
     4744           , input p-price-sale-obj-type
     4745           , input p-price-sale-obj-code
     4746           , input no
     4747           , input no
     4748           , input no
     4749           , output v-need-goods
     4750           , output v-need-goods-list
     4751           , output v-need-goods-qnty-list
     4752       ).
     4753   end.
     4754   END PROCEDURE.
     4755   procedure fbrlib_check-before-close :
     4756   define input parameter p-doc-code as character no-undo .
     4757   define variable same-sale as decimal no-undo .
     4758   define variable is-waste as logical no-undo .
     4759   define variable fix-price as logical no-undo .
     4760   define buffer buf_fbr-doc for ub.fbr-doc.
     4761   define buffer buf_fbr-line for ub.fbr-line.
     4762   define buffer buf_goods for ub.goods.
     4763   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4764   do
     4765   on error undo, return error
     4766   :
     4767     for each buf_fbr-line no-lock
     4768         where buf_fbr-line.doc-code = p-doc-code
     4769       , each buf_goods no-lock
     4770         where buf_goods.artic     = buf_fbr-line.artic
     4771           and buf_goods.prod-type = buf_fbr-line.prod-type
     4772           and buf_goods.prod-code = buf_fbr-line.prod-code
     4773     break by buf_fbr-line.prod-type
     4774           by buf_fbr-line.prod-code
     4775           by buf_fbr-line.artic
     4776     :
     4777       if first-of (buf_fbr-line.artic)
     4778       then do:
     4779         assign
     4780         same-sale = buf_fbr-line.price-sale
     4781         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4782         fix-price = buf_fbr-line.is-calc
     4783         .
     4784       end.
     4785       if same-sale <> buf_fbr-line.price-sale
     4786       then do:
     4787           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4788                                         ,p-doc-code
     4789                                         ,buf_goods.artic
     4790                                         ,buf_goods.gds-name
     4791                                         ,chr(10)).
     4792       end.
     4793       if fix-price <> buf_fbr-line.is-calc then do:
     4794           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4795                                         ,p-doc-code
     4796                                         ,buf_goods.artic
     4797                                         ,buf_goods.gds-name
     4798                                         ,chr(10)).
     4799       end.
     4800       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4801       then do:
     4802         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4803                                         ,p-doc-code
     4804                                         ,buf_goods.artic
     4805                                         ,buf_goods.gds-name
     4806                                         ,chr(10)).
     4807       end.
     4808       if buf_fbr-line.rsrv-qnty <> ?
     4809       and buf_goods.gds-type <> 'у':U
     4810       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4811       and buf_fbr-line.fact-qnty <> 0
     4812       then do:
     4813         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4814           if  can-find(first buf_fbr-gds-obj no-lock where
     4815                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4816               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4817               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4818               and buf_fbr-gds-obj.is-null-price  )  then .
     4819                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4820                                         ,p-doc-code
     4821                                         ,buf_goods.artic
     4822                                         ,buf_goods.gds-name
     4823                                         ,chr(10)
     4824                                         ,buf_fbr-line.recipe-code
     4825                                         ).
     4826         end.
     4827         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4828                                         ,p-doc-code
     4829                                         ,buf_goods.artic
     4830                                         ,buf_goods.gds-name
     4831                                         ,chr(10)
     4832                                         ,buf_fbr-line.recipe-code
     4833                                         ).
     4834       end.
     4835     end.
     4836   end.
     4837   end procedure.
     4838   define temp-table temp-font no-undo
     4839     field fontnum  as integer
     4840     field fontname as character
     4841     field fontsize as character
     4842     field fonttype as character
     4843     field font-h   as integer
     4844     field font-w   as integer
     4845     field v-row    as integer
     4846     field v-col    as integer
     4847     field v-row-lans as integer
     4848     field v-col-lans as integer
     4849   index pi fontnum
     4850   .
     4851   procedure get-font-ini :
     4852     do
     4853     on error undo, return error return-value
     4854     :
     4855   define variable ii as integer   no-undo .
     4856   define variable v-font7 as character no-undo .
     4857   define variable v-font as character no-undo .
     4858   define variable loc-name as character no-undo .
     4859   define variable loc-size as character no-undo .
     4860   define variable loc-type as character no-undo .
     4861   define variable old_H as integer   no-undo .
     4862   define variable old_w as integer   no-undo .
     4863   define variable old-row  as integer   no-undo .
     4864   define variable old-col  as integer   no-undo .
     4865   define variable old-row-lans  as integer   no-undo .
     4866   define variable old-col-lans  as integer   no-undo .
     4867   define variable vv as integer   no-undo .
     4868   empty temp-table temp-font.
     4869     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     4870       case num-entries (v-font7) :
     4871         when 4 then do:
     4872             assign
     4873               loc-name = entry ( 1 , v-font7 )
     4874               loc-size = entry ( 2 , v-font7 )
     4875               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     4876             .
     4877         end.
     4878         when 3 then do:
     4879             assign
     4880               loc-name = entry ( 1 , v-font7 )
     4881               loc-size = entry ( 2 , v-font7 )
     4882               loc-type = entry ( 3 , v-font7 )
     4883             .
     4884         end.
     4885         when 2 then  do:
     4886             assign
     4887               loc-name = entry ( 1 , v-font7 )
     4888               loc-size = entry ( 2 , v-font7 )
     4889               loc-type = ""
     4890             .
     4891         end.
     4892         when 1 then do:
     4893             assign
     4894               loc-name = trim(entry ( 1 , v-font7 ))
     4895               loc-size = ""
     4896               loc-type = ""
     4897             .
     4898         end.
     4899       end case.
     4900     create temp-font.
     4901     assign
     4902       temp-font.fontnum  = 7
     4903       temp-font.fontname = trim(loc-name)
     4904       temp-font.fontsize = trim(loc-size)
     4905       temp-font.fonttype = trim(loc-type)
     4906       temp-font.v-row    = 62
     4907       temp-font.v-col    = 136
     4908       temp-font.v-row-lans = 43
     4909       temp-font.v-col-lans = 198
     4910     .
     4911     repeat ii = 16 to 100 :
     4912       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     4913       if v-font = "" or v-font = ? then leave.
     4914       case num-entries (v-font) :
     4915         when 4 then do:
     4916             assign
     4917               loc-name = entry ( 1 , v-font )
     4918               loc-size = entry ( 2 , v-font )
     4919               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     4920             .
     4921         end.
     4922         when 3 then do:
     4923             assign
     4924               loc-name = entry ( 1 , v-font )
     4925               loc-size = entry ( 2 , v-font )
     4926               loc-type = entry ( 3 , v-font )
     4927             .
     4928         end.
     4929         when 2 then do:
     4930             assign
     4931               loc-name = entry ( 1 , v-font )
     4932               loc-size = entry ( 2 , v-font )
     4933               loc-type = ""
     4934             .
     4935         end.
     4936         when 1 then do:
     4937             assign
     4938               loc-name = trim(entry ( 1 , v-font ))
     4939               loc-size = ""
     4940               loc-type = ""
     4941             .
     4942         end.
     4943       end case.
     4944     create temp-font.
     4945     assign
     4946       temp-font.fontnum  = ii
     4947       temp-font.fontname = trim(loc-name)
     4948       temp-font.fontsize = trim(loc-size)
     4949       temp-font.fonttype = trim(loc-type)
     4950     .
     4951     end.
     4952       for each temp-font :
     4953          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     4954          if  vv = ? then vv =  0 .
     4955           run rep/exfont.p (
     4956             input   temp-font.fontname ,
     4957             input   vv ,
     4958             input   temp-font.fonttype ,
     4959             output  temp-font.font-h   ,
     4960             output  temp-font.font-w   )
     4961           .
     4962       end.
     4963   find first temp-font where  temp-font.fontnum  = 7  .
     4964   old_H = temp-font.font-H .
     4965   old_w = temp-font.font-W .
     4966   old-row = temp-font.v-row .
     4967   old-col = temp-font.v-col .
     4968   old-row-lans = temp-font.v-row-lans .
     4969   old-col-lans = temp-font.v-col-lans .
     4970       for each temp-font where
     4971                temp-font.fontnum  <> 7 :
     4972           assign
     4973               temp-font.v-row    = old_H * old-row / temp-font.font-h
     4974               temp-font.v-col    = old_W * old-col / temp-font.font-W
     4975               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     4976               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     4977           .
     4978       end.
     4979     end.
     4980   end procedure.
     4981   PROCEDURE How-name :
     4982   define input  parameter h as integer no-undo .
     4983   define input  parameter w as integer no-undo .
     4984   define output parameter n as character  no-undo .
     4985   define variable A4port-H as integer   no-undo init 63.
     4986   define variable A4port-W as integer   no-undo init 136.
     4987   define variable A4lans-H as integer   no-undo init 43.
     4988   define variable A4lans-W as integer   no-undo init 198.
     4989   define variable Strim-W  as integer   no-undo init 278.
     4990   run define-a4-size (
     4991        input ReportFontNum
     4992       ,output A4port-H
     4993       ,output A4port-W
     4994       ,output A4lans-H
     4995       ,output A4lans-W ).
     4996   If w >= 1 and w <= A4port-W Then DO:
     4997     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     4998     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     4999     If h > A4port-H              Then n = "to-file":U.
     5000   End.
     5001   If w > A4port-W and w <= A4lans-W Then DO:
     5002     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     5003     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     5004     If h > A4port-H              Then n = "to-file":U.
     5005   End.
     5006   If w > A4lans-W and w <= Strim-W Then DO:
     5007     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     5008     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     5009     If h > A4port-H              Then n = "to-file":U.
     5010   End.
     5011   If w > Strim-W Then DO:
     5012      n = "to-file":U.
     5013   End.
     5014   END PROCEDURE.
     5015   PROCEDURE define-a4-size :
     5016   define input  parameter p-ReportFontNum as integer   no-undo .
     5017   define output parameter A4port-H as integer   no-undo .
     5018   define output parameter A4port-W as integer   no-undo .
     5019   define output parameter A4lans-H as integer   no-undo .
     5020   define output parameter A4lans-W as integer   no-undo .
     5021   if not can-find (first temp-font ) then do:
     5022      run get-font-ini .
     5023   end.
     5024   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     5025   if available temp-font then do:
     5026   assign
     5027     A4port-H = temp-font.v-row
     5028     A4port-W = temp-font.v-col
     5029     A4lans-H = temp-font.v-row-lans
     5030     A4lans-W = temp-font.v-col-lans
     5031   .
     5032   end.
     5033   else do:
     5034   assign
     5035     A4port-H = 63
     5036     A4port-W = 136
     5037     A4lans-H = 43
     5038     A4lans-W = 198
     5039   .
     5040   end.
     5041   END PROCEDURE.
     5042    do
     5043    on error undo, return error return-value
     5044    :
     5045   ReportPageHeight = 43   .
     5046   ReportPageWidth  = 198  .
     5047   ReportFontNum    = 7 .
