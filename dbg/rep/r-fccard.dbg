     5209   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     5210   DEFINE BUTTON StopBtn AUTO-END-KEY
     5211        LABEL "Стоп"
     5212        SIZE 10 BY 1.
     5213   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     5214        LABEL "Обработано записей"
     5215         VIEW-AS TEXT
     5216        SIZE 14 BY .67 NO-UNDO.
