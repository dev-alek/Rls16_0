     2095   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     2096   do
     2097   on error undo, return error
     2098   :
     2099   define input parameter p-fbr-doc-code as character    no-undo.
     2100       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
