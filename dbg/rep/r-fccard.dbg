     5221   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     5222         VIEW-AS TEXT
     5223        SIZE 53.25 BY .67
     5224        FGCOLOR 1  NO-UNDO.
     5225   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     5226         VIEW-AS TEXT
