     2202              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2203                and buf_fbr-line.trn-type     = 'спи':U
     2204                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
