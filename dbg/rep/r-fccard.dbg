     5183       with width 232 down stream-io use-text NO-UNDERLINE  NO-BOX no-labels.
     5184     if session:set-wait-state("compiler") then.
     5185   output STREAM OutStream to value( string( session:temp-directory +
     5186                                        "rpt" + string( g#report-num ) ) )
     5187                                        page-size  value(ReportPageHeight) .
     5188     define variable v-prn0 as character no-undo .
