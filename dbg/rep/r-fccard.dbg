     1472           and buf_doc-line.obj-code   = p-obj-code
     1473           and buf_doc-line.artic      = p-artic
     1474           and buf_doc-line.prod-type  = p-prod-type
     1475           and buf_doc-line.prod-code  = p-prod-code
     1476           and buf_doc-line.status_    = 'факт':U
     1477           and buf_doc-line.fact-order > p-start-fact-order
     1478           and buf_doc-line.fact-order <= p-end-fact-order
     1479       on error undo, return error
     1480       :
     1481         run partslib-process-document in this-procedure
     1482           (input  buf_doc-line.doc-code
     1483           ,input  p-obj-type
     1484           ,input  p-obj-code
     1485           ,input  p-artic
     1486           ,input  p-prod-type
     1487           ,input  p-prod-code
     1488           ,input  v-goods-gds-goods
     1489           ,input  v-goods-twounit
     1490           ,output v-total-parts-qnty
     1491           ) no-error .
     1492         if error-status :error
     1493         then do:
     1494           message
     1495             vss-workfile vss-revision vss-description skip
     1496             vss-include-info17 skip
     1497             "Ошибка при вызове процедуры partslib-process-document" skip
     1498             "Документ" buf_doc-line.doc-code skip
     1499             "Объект" p-obj-type p-obj-code skip
     1500             "Артикул" p-artic p-prod-type p-prod-code skip
     1501             "p-start-fact-order" p-start-fact-order skip
     1502             "p-end-fact-order" p-end-fact-order skip
     1503             error-status :get-message(1) skip
     1504             return-value skip
     1505             view-as alert-box error .
     1506           undo, return error return-value .
     1507         end.
     1508       end.
     1509     end.
     1510   end procedure.
     1511   procedure partslib-process-document :
     1512     define input  parameter p-doc-code         as character no-undo .
     1513     define input  parameter p-obj-type         as character no-undo .
     1514     define input  parameter p-obj-code         as integer   no-undo .
     1515     define input  parameter p-artic            as character no-undo .
     1516     define input  parameter p-prod-type        as character no-undo .
     1517     define input  parameter p-prod-code        as integer   no-undo .
     1518     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1519     define input  parameter p-goods-twounit    as logical   no-undo .
     1520     define output parameter p-total-parts-qnty as decimal   no-undo .
     1521     define variable v-parts-sign as integer   no-undo .
     1522     define buffer buf_trn-doc    for ub.trn-doc .
     1523     define buffer buf_doc-line   for ub.doc-line .
     1524     define buffer buf_parts      for ub.parts .
     1525     define buffer buf_temp-parts for temp-parts .
     1526     do
     1527     on error undo, return error return-value
     1528     :
     1529       find first buf_trn-doc no-lock
     1530         where buf_trn-doc.doc-code = p-doc-code
     1531         no-error .
     1532       if not available buf_trn-doc
     1533       then do:
     1534         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1535                                      ,p-doc-code
     1536                                      ) .
     1537       end.
     1538       case buf_trn-doc.doc-type
     1539       :
     1540         when 'при':U or
     1541         when 'возврат':U or
     1542         when 'инв':U
     1543         then do:
     1544           assign
     1545             v-parts-sign = -1
     1546           .
     1547         end.
     1548         when 'рас':U or
     1549         when 'спи':U
     1550         then do:
     1551           assign
     1552             v-parts-sign = 1
     1553           .
     1554         end.
     1555         otherwise do:
     1556           undo, return error substitute("Неизвестный тип документа &1"
     1557                                       ,buf_trn-doc.doc-type
     1558                                       ) .
     1559         end.
     1560       end.
     1561       find first buf_doc-line no-lock
     1562         where buf_doc-line.doc-code  = p-doc-code
     1563           and buf_doc-line.artic     = p-artic
     1564           and buf_doc-line.prod-type = p-prod-type
     1565           and buf_doc-line.prod-code = p-prod-code
     1566         no-error .
     1567       if not available buf_doc-line
     1568       then do:
     1569         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1570                                      ,p-doc-code
     1571                                      ,artic
     1572                                      ,prod-type
     1573                                      ,prod-code
     1574                                      ) .
     1575       end.
     1576       assign
     1577         p-total-parts-qnty = 0
     1578       .
     1579       if p-goods-gds-goods = true
     1580       then do:
     1581         for each buf_parts no-lock
     1582           where buf_parts.out-code  = p-doc-code
     1583             and buf_parts.obj-type  = p-obj-type
     1584             and buf_parts.obj-code  = p-obj-code
     1585             and buf_parts.artic     = p-artic
     1586             and buf_parts.prod-type = p-prod-type
     1587             and buf_parts.prod-code = p-prod-code
     1588         on error undo, return error
     1589         :
     1590           run partslib-create-temp-parts in this-procedure
     1591             (buffer buf_parts
     1592             ,buffer buf_temp-parts
     1593             ,input  p-goods-twounit
     1594             ) .
     1595           assign
     1596             p-total-parts-qnty        = p-total-parts-qnty
     1597                                       + v-parts-sign * buf_parts.fact-qnty
     1598             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1599                                       + v-parts-sign * buf_parts.fact-qnty
     1600             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1601                                       + v-parts-sign * buf_parts.fact-qnty
     1602             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1603                                       + v-parts-sign * buf_parts.cli-qnty
     1604           .
     1605           if buf_temp-parts.qnty = 0
     1606           then do:
     1607             delete buf_temp-parts .
     1608           end.
     1609         end.
     1610       end.
     1611       else do:
     1612         assign
     1613           p-total-parts-qnty = p-total-parts-qnty
     1614                              + v-parts-sign * buf_doc-line.fact-qnty
     1615         .
     1616       end.
     1617     end.
     1618   end procedure.
     1619   procedure partslib-init-temp-parts-by-date :
     1620     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1621     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1622     define input parameter p-artic           like ub.parts.artic     no-undo .
     1623     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1624     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1625     define input parameter p-fact-date       as date      no-undo .
     1626     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1627     do
     1628     on error undo, return error
     1629     :
     1630       define variable v-fact-order                as decimal   no-undo .
     1631       define variable v-shift-end-fact-order      as decimal   no-undo .
     1632       define variable v-day-end-fact-order        as decimal   no-undo .
     1633       run factord in this-procedure
     1634         (input  p-fact-date
     1635         ,input  1
     1636         ,input  1
     1637         ,input  ?
     1638         ,input  0
     1639         ,input  false
     1640         ,output v-fact-order
     1641         ,output v-shift-end-fact-order
     1642         ,output v-day-end-fact-order
     1643         ) no-error .
     1644       if error-status :error
     1645       then do:
     1646         message
     1647           vss-workfile vss-revision vss-description skip
     1648           vss-include-info17 skip
     1649           "Ошибка при определении момента времени, на который требуется остаток" skip
     1650           "Объект" p-obj-type p-obj-code skip
     1651           "Артикул" p-artic p-prod-type p-prod-code skip
     1652           "Дата" p-fact-date skip
     1653           view-as alert-box error .
     1654         undo, return error .
     1655       end.
     1656       run partslib-init-temp-parts-by-factord in this-procedure
     1657         (input p-obj-type
     1658         ,input p-obj-code
     1659         ,input p-artic
     1660         ,input p-prod-type
     1661         ,input p-prod-code
     1662         ,input v-day-end-fact-order
     1663         ,input false
     1664         ) no-error .
     1665       if error-status :error
     1666       then do:
     1667         message
     1668           vss-workfile vss-revision vss-description skip
     1669           vss-include-info17 skip
     1670           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1671           "Объект" p-obj-type p-obj-code skip
     1672           "Артикул" p-artic p-prod-type p-prod-code skip
     1673           "Дата" p-fact-date skip
     1674           view-as alert-box error .
     1675         undo, return error .
     1676       end.
     1677     end.
     1678   end procedure.
     1679   procedure partslib-calc-cost :
     1680     define output parameter p-fact-qnty      as decimal   no-undo .
     1681     define output parameter p-vat-pc         as decimal   no-undo .
     1682     define output parameter p-slt-pc         as decimal   no-undo .
     1683     define output parameter p-sum-base       as decimal   no-undo .
     1684     define output parameter p-sum-rubl       as decimal   no-undo .
     1685     define output parameter p-vat-base       as decimal   no-undo .
     1686     define output parameter p-vat-rubl       as decimal   no-undo .
     1687     define output parameter p-slt-base       as decimal   no-undo .
     1688     define output parameter p-slt-rubl       as decimal   no-undo .
     1689     define output parameter p-road-tax-base  as decimal   no-undo .
     1690     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1691     define output parameter p-transport-base as decimal   no-undo .
     1692     define output parameter p-transport-rubl as decimal   no-undo .
     1693     define output parameter p-other-base     as decimal   no-undo .
     1694     define output parameter p-other-rubl     as decimal   no-undo .
     1695     define output parameter p-excise-base    as decimal   no-undo .
     1696     define output parameter p-excise-rubl    as decimal   no-undo .
     1697     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1698     do
     1699     on error undo, return error return-value
     1700     :
     1701       define buffer buf_temp-parts for temp-parts .
     1702       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1703       define buffer   in-vatp-parts    for ub.parts   .
     1704       define buffer   in-vatp-doc      for ub.trn-doc .
     1705       define buffer   in-vatp-goods    for ub.goods   .
     1706       define buffer   in-vatp-sysconf  for ub.sysconf .
     1707       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1708       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1709       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1710       define variable varinvprb                  as   character              no-undo.
     1711       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1712       define variable cli-base-rate              as   decimal                no-undo.
     1713       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1714       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1715       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1716       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1717       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1718       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1719       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1720       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1721       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1722       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1723       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1724       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1725       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1726       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1727       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1728       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1729       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1730       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1731       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1732       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1733       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1734       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1735       define variable varinvatp-envd             as   character              no-undo.
     1736       define variable varinvatp-type             as   character              no-undo.
     1737       for each buf_temp-parts
     1738       on error undo, return error
     1739       :
     1740   assign
     1741     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1742     price-base-with-tax-loc = buf_temp-parts.price-base
     1743   .
     1744   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1745   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1746     (output varinvprb
     1747     )  .
     1748     if buf_temp-parts.out-code = 'free-zone':U     or
     1749        buf_temp-parts.out-code = 'out-zone':U   or
     1750        buf_temp-parts.doc-type = 'акт':U then do:
     1751       assign
     1752         in-vatp-have-vat-slt = yes.
     1753     end.
     1754     else do:
     1755       find first in-vatp_doc-attr no-lock
     1756         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1757           and in-vatp_doc-attr.attr-code = 'envd':U
     1758         no-error .
     1759       if not available in-vatp_doc-attr then do:
     1760         assign
     1761           in-vatp-have-vat-slt = yes.
     1762       end.
     1763       else do:
     1764            in-vatp-have-vat-slt = no.
     1765       end.
     1766     end.
     1767     assign
     1768      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1769      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1770     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1771              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1772     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1773             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1774             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1775             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1776             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1777             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1778             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1779       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1780     assign
     1781       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1782     assign
     1783       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1784       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1785       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1786       transport-cli-loc  = 0
     1787       other-cli-loc      = 0
     1788     .
     1789   ASSIGN
     1790             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1791       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1792   .
     1793         assign
     1794           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1795           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1796           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1797           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1798           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1799           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1800           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1801           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1802           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1803           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1804           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1805           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1806           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1807           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1808           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1809           p-excise-base    = p-excise-base    + 0
     1810           p-excise-rubl    = p-excise-rubl    + 0
     1811         .
     1812       end.
     1813       if p-fact-qnty      = ?
     1814       or p-sum-base       = ?
     1815       or p-sum-rubl       = ?
     1816       or p-vat-base       = ?
     1817       or p-vat-rubl       = ?
     1818       or p-slt-base       = ?
     1819       or p-slt-rubl       = ?
     1820       or p-road-tax-base  = ?
     1821       or p-road-tax-rubl  = ?
     1822       or p-transport-base = ?
     1823       or p-transport-rubl = ?
     1824       or p-other-base     = ?
     1825       or p-other-rubl     = ?
     1826       or p-excise-base    = ?
     1827       or p-excise-rubl    = ?
     1828       then do:
     1829         message
     1830           vss-workfile vss-revision vss-description skip
     1831           vss-include-info17 skip
     1832           "Программа in-vatp.i вернула неопределенные значения" skip
     1833           "p-fact-qnty"      p-fact-qnty      skip
     1834           "p-sum-base"       p-sum-base       skip
     1835           "p-sum-rubl"       p-sum-rubl       skip
     1836           "p-vat-base"       p-vat-base       skip
     1837           "p-vat-rubl"       p-vat-rubl       skip
     1838           "p-slt-base"       p-slt-base       skip
     1839           "p-slt-rubl"       p-slt-rubl       skip
     1840           "p-road-tax-base"  p-road-tax-base  skip
     1841           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1842           "p-transport-base" p-transport-base skip
     1843           "p-transport-rubl" p-transport-rubl skip
     1844           "p-other-base"     p-other-base     skip
     1845           "p-other-rubl"     p-other-rubl     skip
     1846           "p-excise-base"    p-excise-base    skip
     1847           "p-excise-rubl"    p-excise-rubl    skip
     1848           view-as alert-box error .
     1849         undo, return error .
     1850       end.
     1851     end.
     1852   end procedure.
