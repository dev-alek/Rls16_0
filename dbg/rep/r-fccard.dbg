     5230        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     5231        SIZE 55.13 BY 4.46.
     5232   DEFINE FRAME InfoFrame
     5233        StopBtn AT ROW 4.25 COL 21.75
     5234        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     5235        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     5236        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     5237        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     5238        RECT-1 AT ROW 1 COL 1
     5239       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     5240            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5241            TITLE "Процесс"
     5242            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     5243   define variable mFrameView      as logical   no-undo init yes.
     5244     define variable mFramHandle as handle no-undo.
     5245     mFramHandle = frame InfoFrame:handle.
     5246     if  log-manager:logfile-name ne ?
     5247     then DO:
     5248         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     5249         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     5250         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     5251     end.
     5252     mFrameView = not session:batch-mode and mFramHandle:visible.
     5253     if mFrameView
     5254     then do:
     5255       ASSIGN
     5256          FRAME InfoFrame:HIDDEN                           = TRUE
     5257          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     5258     end.
     5259   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     5260   DO:
     5261     IF not StopProcessing THEN
     5262       Message "Вы действительно хотите прервать" SKIP
     5263               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     5264                 UPDATE StopProcessing.
     5265     IF StopProcessing THEN do:
     5266        if mFrameView
     5267        then do:
     5268           HIDE FRAME InfoFrame.
     5269        end.
     5270     End.
     5271   END.
     5272   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     5273     if  log-manager:logfile-name ne ?
     5274     then DO:
     5275         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     5276     end.
     5277     if not session:batch-mode then
     5278     do:
     5279       VIEW FRAME InfoFrame.
     5280       mFrameView = true.
     5281     end.
     5282      v-button-stop = false .
     5283         if mFrameView
     5284         then do:
     5285         if v-button-stop then view STOPBTN in frame InfoFrame.
     5286                          else Hide STOPBTN in frame InfoFrame.
     5287         end.
     5288   v-ind = 0    .
     5289   FORM with frame plan-menu .
     5290   define variable v-type-goods as character no-undo .
     5291   define variable v-ves        as logical no-undo .
     5292   for each obj-list no-lock :
     5293   for each gds-list no-lock :
     5294   define buffer buf_units for ub.units .
     5295         find buf_units no-lock
     5296           where buf_units.unit-name = gds-list.unit-base
     5297           no-error .
     5298   if lookup('вес':U, buf_units.type) > 0  then
     5299       assign
     5300           v-ves = true
     5301           v-type-goods = " (весовой)"
     5302       .
     5303     else
     5304         assign
     5305             v-ves         = false
     5306             v-type-goods  = ""
     5307         .
     5308   if not can-find (first  fbr-recipe where
     5309                    fbr-recipe.recipe-type = 'производство':U
     5310               and  fbr-recipe.prod-type = gds-list.prod-type
     5311               and  fbr-recipe.prod-code = gds-list.prod-code
     5312               and  fbr-recipe.artic =     gds-list.artic no-lock ) then next .
     5313   if not can-find ( first fbr-gds-obj  where
     5314                    fbr-gds-obj.obj-type = obj-list.obj-type
     5315               and  fbr-gds-obj.obj-code = obj-list.obj-code
     5316               and  fbr-gds-obj.gds-code = gds-list.gds-code
     5317               and (fbr-gds-obj.is-menu = true
     5318               or   fbr-gds-obj.is-semi-finished = true )
     5319                   no-lock ) then next .
     5320   vv0 = "+--------------------------------------------------------+".
     5321   vv1 = ": n/n :         Наименование продукта          :   Код   :".
     5322   vv2 = ":     :                                        :         :".
     5323       Output stream Macr_Excel  close .
     5324       num#str# = 0 .
     5325       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5326       output stream macr_excel to value(v-file-name)   .
     5327       v-ind = v-ind + 1.
     5328    define variable col-doc as integer no-undo .
     5329    col-doc =  0.
     5330    for each temp-doc   : delete temp-doc .   end.
     5331    for each temp-str   : delete temp-str .   end.
     5332    for each temp-delta : delete temp-delta . end.
     5333    for each fbr-line no-lock  where fbr-line.artic     = gds-list.artic and
     5334                                     fbr-line.prod-code = gds-list.prod-code and
     5335                                     fbr-line.prod-type = gds-list.prod-type  and
     5336                                     fbr-line.is-comp = true   ,
     5337           first fbr-recipe no-lock where fbr-recipe.recipe-code =  fbr-line.recipe-code  and
     5338                                          fbr-recipe.doc-code    =  fbr-line.doc-code  and
     5339                                          fbr-recipe.recipe-type = 'производство':U ,
     5340            first fbr-doc no-lock   where
     5341                                   fbr-doc.doc-code   = fbr-line.doc-code and
     5342                                   fbr-doc.obj-type   = obj-list.obj-type and
     5343                                   fbr-doc.obj-code   = obj-list.obj-code and
     5344                                   fbr-doc.fact-date  >= x-date-start and
     5345                                   fbr-doc.fact-date  <= x-date-end  :
     5346   col-doc = col-doc + 1.
     5347   assign
     5348       n-recipe-code        = fbr-line.recipe-code
     5349       num-re = fbr-recipe.recipe-ref-num
     5350       n-porc = if fbr-recipe.portion-qnty <> 0 and fbr-recipe.portion-qnty <> ?  then fbr-recipe.portion-qnty else 1
     5351     .
     5352   create temp-doc.
     5353    if v-ves then
     5354             assign
     5355                 temp-doc.ves  =  fbr-recipe.qnty  / n-porc
     5356             .
     5357          else
     5358             assign
     5359                 temp-doc.ves  =  1
     5360               .
     5361    define buffer glob_recipe for recipe.
     5362    define variable var-vvv as decimal no-undo .
     5363    var-vvv = 0 .
     5364    find first glob_recipe no-lock where  glob_recipe.recipe-code = fbr-line.recipe-code no-error .
     5365    if available glob_recipe then var-vvv =  glob_recipe.portion-weight * 1000 .
     5366   assign
     5367     temp-doc.porcii      = n-porc
     5368     temp-doc.qnty-bl     = fbr-line.fact-qnty / fbr-recipe.qnty
     5369     temp-doc.doc-code    = fbr-doc.doc-code
     5370     temp-doc.fact-date   = fbr-doc.fact-date
     5371     temp-doc.recipe-code = fbr-line.recipe-code
     5372     temp-doc.netto       = if fbr-recipe.qnty <> 0 and fbr-recipe.qnty <> ?  then fbr-recipe.qnty else 1
     5373     temp-doc.qnty-line   = fbr-line.fact-qnty
     5374     temp-doc.all-stoim     = round( fbr-line.price-rubl  * 100 * temp-doc.ves  , 2 )
     5375     temp-doc.price-sale    = round( fbr-line.price-sale  * 100 * temp-doc.ves  , 2 )
     5376     temp-doc.price-sale-1  = round( fbr-line.price-sale  * temp-doc.ves  , 2 )
     5377     temp-doc.Vat         = round( fbr-line.price-sum-vat-rubl *  100  / ( temp-doc.porcii * temp-doc.qnty-bl ), 2 )
     5378     temp-doc.SLT         = 0
     5379     temp-doc.discn       = round( temp-doc.price-sale -  temp-doc.all-stoim - temp-doc.Vat  - temp-doc.SLT  , 2 )
     5380     temp-doc.qnty-inp    =  if v-ves then round ( 1000 * fbr-recipe.qnty  / n-porc , 3)
     5381                                      else var-vvv
     5382     temp-doc.fact-order  = fbr-line.price-doc-fact-order
     5383   .
     5384   end.
     5385     if col-doc = 0 then next.
     5386     run chg-record-temp-doc.
     5387     for each temp-doc :
     5388         vv1 = vv1 + string(temp-doc.doc-code + " от " + string(temp-doc.fact-date, "99/99/9999"),"x(32)") + ":"  .
     5389         vv2 = vv2 + " Норма,кг: Цена," + string(pp-r,"x(4)") + ": Сумма," + string(pp-r,"x(4)") +  ":" .
     5390         vv0 = vv0 + "--------------------------------+" .
     5391     end.
     5392     find this_object  where this_object.obj-type = obj-list.obj-type and this_object.obj-code = obj-list.obj-code  no-lock .
     5393     find clients      where clients.obj-type     = 'орг':U            and clients.obj-code      = v-cntxt-host-code-obj no-lock .
     5394     run PrintTitul in this-procedure .
     5395     run make-tt.
     5396     for each temp-str no-lock break by if sort-name then  temp-str.gds-name Else string(temp-str.np,"999999999") :
     5397         run print-line in this-procedure .
     5398     end.
     5399     run print-all-itog in this-procedure .
     5400     run on-same-page in this-procedure (input 11) .
     5401     run PrintPodval in this-procedure .
     5402     run paramls-write in this-procedure
     5403       (input "file"
     5404       ,input string(v-ind) + "_" + string(obj-list.obj-type) + string(obj-list.obj-code) + "_" + string(gds-list.gds-code)
     5405       ,input v-file-name
     5406       ) .
     5407        page stream OutStream .
     5408   end.
     5409   end.
     5410   HIDE STREAM OutStream FRAME plan-menu.
     5411   HIDE stream OutStream FRAME BottomFrame .
     5412   HIDE stream OutStream FRAME BottomFrame2 .
     5413   output stream OutStream CLOSE .
     5414   Output stream Macr_Excel  close .
     5415   if mFrameView
     5416   then do:
     5417      HIDE FRAME InfoFrame.
     5418   end.
     5419       run paramls-write in this-procedure
     5420           (input "charcol"
     5421           ,input ""
     5422           ,input "2"
     5423           ) .
     5424    run end-proc .
     5425   define variable v-user-action as character no-undo .
     5426   define variable v-printed as logical   no-undo .
     5427   define variable DisabledOptions as integer   no-undo .
     5428   define variable v-orient-page as character no-undo .
     5429   run How-name in this-procedure (
     5430       input ReportPageHeight,
     5431       input ReportPageWidth,
     5432       output v-orient-page )
     5433       .
     5434     if col-doc <= 4  then do:
     5435       if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     5436                                      else DisabledOptions = 0 .
     5437     end.
     5438     if col-doc > 4 and col-doc  <= 84 then do:
     5439      DisabledOptions = 9 .
     5440     end.
     5441     if col-doc > 84 then do:
     5442       DisabledOptions = 21 .
     5443     end.
     5444   run gbl/prnfilen.w
     5445     (input  ""
     5446     ,input  DisabledOptions
     5447     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     5448     ,input  ReportFontNum
     5449     ,output v-user-action
     5450     ,output v-printed
     5451     ) .
     5452   end.
     5453   procedure print-line :
     5454     do on error undo, return error return-value :
     5455     define buffer buf_fbr-line       for fbr-line .
     5456     define buffer buf_fbr-recipe-gds for fbr-recipe-gds .
     5457     define buffer buf_recipe-gds     for recipe-gds .
     5458     define buffer buf_fbr-recipe     for fbr-recipe .
     5459     define variable p-norma as decimal format "->>>>>>>>>9.999"  no-undo .
     5460     define variable p-price as decimal format ">>>>>>>>>>9.99" no-undo .
     5461     define variable p-sum   as decimal format "->>>>>>>>>9.99"  no-undo .
     5462     define variable s-plus  as logical init false  no-undo .
     5463     define variable s-minus as logical init false no-undo .
     5464     define variable var-season-qnty1 as decimal no-undo .
     5465     assign
     5466        Lines_Counter = Lines_Counter + 1
     5467        summ = summ  + temp-str.stoim
     5468       .
     5469     if line-counter( OutStream ) + 2 > page-size( OutStream ) then page stream OutStream.
     5470     if line-counter( OutStream ) < Tmp_Counter then
     5471       assign
     5472       .
     5473     assign
     5474       Tmp_Counter  = line-counter( OutStream )
     5475       num-ln = num-ln + 1
     5476     .
     5477     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     5478   num#str# = num#str# + 1.
     5479   num#col# = 1.
     5480   run macr_excel_char( temp-str.np         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5481   run macr_excel_char( temp-str.gds-name   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5482   run macr_excel_dec ( temp-str.b-code     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5483   PUT STREAM OutStream UNFORMATTED
     5484       sym1                format "X(1)" space(0)
     5485       temp-str.np         format ">>>>9" space(0)
     5486       sym2                format "X(1)" space(0)
     5487       temp-str.gds-name   format "X(40)" space(0)
     5488       sym3                format "X(1)" space(0)
     5489       temp-str.b-code     format "X(9)" space(0)
     5490       sym4                format "X(1)" space(0)
     5491   .
     5492   s-plus  = false .
     5493   s-minus = false .
     5494    for each temp-doc break by temp-doc.fact-date :
     5495        find first temp-delta where
     5496                   temp-delta.doc-code  = temp-doc.doc-code  and
     5497                   temp-delta.artic     = temp-str.artic     and
     5498                   temp-delta.prod-type = temp-str.prod-type and
     5499                   temp-delta.prod-code = temp-str.prod-code no-error .
     5500        if available temp-delta then do:
     5501           if temp-delta.qnty-delta > 0 then s-plus = true .
     5502           if temp-delta.qnty-delta < 0 then s-minus = true .
     5503        end.
     5504        p-norma = 0.
     5505        p-price = 0.
     5506       run get-brutto-seson (output var-season-qnty1 ,
     5507                             input temp-str.artic    ,
     5508                             input temp-str.prod-type,
     5509                             input temp-str.prod-code ,
     5510                             input temp-doc.recipe-code)
     5511                               .
     5512       assign
     5513         p-norma = 100 * var-season-qnty1 * temp-doc.ves / temp-doc.netto
     5514       .
     5515        find first buf_fbr-line       no-lock where
     5516                   buf_fbr-line.doc-code  = temp-doc.doc-code and
     5517                   buf_fbr-line.recipe-code  = temp-doc.recipe-code and
     5518                   buf_fbr-line.artic     = temp-str.artic     and
     5519                   buf_fbr-line.prod-type = temp-str.prod-type and
     5520                   buf_fbr-line.prod-code = temp-str.prod-code no-error .
     5521        if available buf_fbr-line then
     5522           assign
     5523             p-price  = buf_fbr-line.price-rubl
     5524            .
     5525        p-sum = p-price * p-norma .
     5526        run macr_excel_char( round(p-norma,3)    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5527        run macr_excel_char( round(p-price,2)    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5528        run macr_excel_char( round(p-sum,2)    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     5529         PUT STREAM OutStream UNFORMATTED string( p-norma ,"->>>>>>9.<<<" )
     5530                                          + ":"
     5531                                          string(round(p-price,2),">>>>>>9.99" )
     5532                                          + ":"
     5533                                          string(round(p-sum,2)  ,"->>>>>>9.99" )
     5534                                          + ":"
     5535                                         .
     5536    end.
     5537     PUT STREAM OutStream UNFORMATTED skip.
     5538     if s-plus then run print-dop-str("Накидка", true  ).
     5539     if s-minus then run print-dop-str("Скидка", false ).
     5540     if print-graft = false THEN do:
     5541     underline stream OutStream
     5542       sym1     temp-str.np
     5543       sym2     temp-str.gds-name
     5544       sym3     temp-str.b-code
     5545       sym4
     5546       with FRAME plan-menu.
     5547     DOWN stream OutStream 1 with FRAME plan-menu.
     5548      end.
     5549     end.
     5550   end procedure.
     5551   procedure print-all-itog :
     5552   end procedure.
     5553   procedure PrintTitul :
     5554     do  on error undo, return error return-value  :
     5555     define variable cc as integer no-undo .
     5556     define variable tt as integer no-undo .
     5557     define variable pp as integer no-undo .
     5558       case clients.obj-type:
     5559          when 'орг':U
     5560          then do:
     5561               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     5562               if available ub.firm
     5563               then do:
     5564                   assign
     5565                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     5566                       t-addres = t-addres
     5567                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     5568                               then ""
     5569                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     5570                             )
     5571                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     5572                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     5573                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     5574                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     5575                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     5576                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     5577                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     5578                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     5579                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     5580                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     5581                       t-phone = ub.firm.phone
     5582                       t-inn   = ub.firm.inn
     5583                       t-okpo  = ub.firm.okpo
     5584                   .
     5585               end.
     5586          end.
     5587          when 'маг':U
     5588          then do:
     5589               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     5590               if available ub.shop
     5591               then do:
     5592                   assign
     5593                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     5594                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     5595                       t-phone = shop.phone
     5596                       t-inn = ""
     5597                       t-okpo = ""
     5598                   .
     5599               end.
     5600          end.
     5601          when 'скл':U
     5602          then do:
     5603               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     5604               if available ub.store
     5605               then do:
     5606                   assign
     5607                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     5608                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     5609                       t-phone = ub.store.phone
     5610                       t-inn = ""
     5611                       t-okpo = ""
     5612                   .
     5613               end.
     5614          end.
     5615          when 'чел':U
     5616          then do:
     5617               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     5618               if available ub.person
     5619               then do:
     5620                   assign
     5621                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     5622                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     5623                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     5624                       t-phone = ub.person.phone1
     5625                       t-inn = ub.person.inn
     5626                       t-okpo = ub.person.okpo
     5627                   .
     5628               end.
     5629          end.
     5630       end case.
     5631   PUT STREAM OutStream UNFORMATTED
     5632   space(1) string( "Унифицированная форма № ОП-1" )                                             "+--------------------------+" at 165  skip
     5633                                                                                                 "|                  | Коды  |" at 165  skip
     5634   space(5) string( CAPS(     clients.obj-name ))                                                "|    Форма по ОКУД |0330501|" at 165  skip
     5635   space(5) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )   "|          по ОКПО |       |" at 165  skip
     5636                                                                                                 "| Вид деятельности |       |" at 165  skip
     5637   space(5) CAPS( gds-list.gds-name ) + " " + gds-list.artic + " " + v-type-goods                "|          по ОКДП |       |" at 165  skip
     5638                                                                                                 "| Номер блюда по   |" + string (num-re)   at 165   skip
     5639                                                                                                 "|сборнику рецептур,|       |" at 165  skip
     5640                                                                                                 "|         ТТК, СТП |       |" at 165  skip
     5641                                                                                                 "|     Вид операции |       |" at 165  skip
     5642                                                                                                 "+--------------------------+" at 165  skip.
     5643    PUT STREAM OutStream UNFORMATTED
     5644           space(5) string( "РЕЕСТР КАЛЬКУЛЯЦИОННЫХ КАРТОЧЕК" ) +
     5645                    string( " C " )  + string(x-date-start, "99/99/9999" )  +
     5646                    string( " ПО " ) + string(x-date-end, "99/99/9999" )
     5647                    format "X(160)"  skip
     5648                    "Дата составления " + cur-time-date() at 165 skip
     5649         .
     5650     PUT STREAM OutStream UNFORMATTED
     5651           vv0  skip
     5652           vv1  skip
     5653           vv2 skip
     5654           vv0  skip
     5655         .
     5656       run macr_cell_size ( 15 , ? , 1 , 11 , 6, 11 ) .
     5657       run macr_cell_format
     5658       ( 8       ,
     5659         false   ,
     5660         false   ,
     5661         ?       ,
     5662         1  ,
     5663         11 ,
     5664         6  ,
     5665         12 ) .
     5666       num#str# = 1.
     5667       num#col# = 1.
     5668       run macr_excel_char( "Унифицированная форма № ОП-1" , num#str# , num#col#   ) .
     5669       num#col# = 12.
     5670       run macr_excel_char( "Коды" , num#str# , num#col#   ) .
     5671       num#str# = 2.
     5672       num#col# = 11.
     5673       run macr_excel_char( "Форма по ОКУД" , num#str# , num#col#   ) .
     5674       num#col# = 12.
     5675       run macr_excel_char( "0330501" , num#str# , num#col#   ) .
     5676       num#str# = 3.
     5677       num#col# = 11.
     5678       run macr_excel_char( "по ОКПО" , num#str# , num#col#   ) .
     5679       num#str# = 4.
     5680       num#col# = 11.
     5681       run macr_excel_char( "Вид деятельности по ОКДП" , num#str# , num#col#   ) .
     5682       num#str# = 5.
     5683       num#col# = 11.
     5684       run macr_excel_char( "Номер блюда по сборнику рецептур, ТТК, СТП" , num#str# , num#col#   ) .
     5685       run macr_excel_char( num-re + " / " + n-recipe-code , num#str# , 12   ) .
     5686       num#str# = 6.
     5687       num#col# = 11.
     5688       run macr_excel_char( "Вид операции" , num#str# , num#col#   ) .
     5689       put  stream macr_excel unformatted
     5690       substitute('select("r&1c&2:r&3c&4 ")' , 1 , 11 , 6 ,  11 ) + chr(10)  +
     5691       'ALIGNMENT(4 , , 4 , 4 ,)'  + chr(10)
     5692       .
     5693       put  stream macr_excel unformatted
     5694       substitute('select("r&1c&2:r&3c&4 ")' , 1 , 12 , 6 ,  12 ) + chr(10)  +
     5695       'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10)
     5696       .
     5697       num#str# = 3.
     5698       num#col# = 1.
     5699       cc = num#str# .
     5700       run macr_excel_char( "РЕЕСТР КАЛЬКУЛЯЦИОННЫХ КАРТОЧЕК"  +
     5701                    string( " C " )  + string(x-date-start, "99/99/9999" )  +
     5702                    string( " ПО " ) + string(x-date-end, "99/99/9999" )
     5703             , num#str# , num#col#   ) .
     5704       num#str# = num#str# + 2.
     5705       num#col# = 2.
     5706       run macr_excel_char(  CAPS( clients.obj-name)   , num#str# , num#col#   ) .
     5707       num#str# = num#str# + 1.
     5708       num#col# = 2.
     5709       run macr_excel_char( string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )   , num#str# , num#col#   ) .
     5710       num#str# = num#str# + 1.
     5711       num#col# = 2.
     5712       run macr_excel_char( CAPS( gds-list.gds-name ) , num#str# , num#col#   ) .
     5713       run macr_cell_format
     5714       ( 20    ,
     5715         true  ,
     5716         false  ,
     5717         ?    ,
     5718         cc ,
     5719         1 ,
     5720         num#str# ,
     5721         2 ) .
     5722       num#str# = num#str# + 1.
     5723       num#col# = 11.
     5724       run macr_excel_char("Дата составления " + cur-time-date()   , num#str# , num#col#   ) .
     5725       num#str# = num#str# + 1.
     5726       num#col# = 1.
     5727       pp = num#str#  .
     5728       run macr_excel_char( "Порядковый номер калькуляции"   , pp , num#col#   ) .
     5729       num#str# = num#str# + 1.
     5730       num#col# = 1.
     5731       tt = num#str#  .
     5732       run macr_excel_char( "Номер по порядку"   , num#str# , num#col#   ) .
     5733       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     5734       num#col# = 2.
     5735       run macr_excel_char( "Наименование продукта"   , num#str# , num#col#   ) .
     5736       run macr_cell_size ( 40 , ? , num#str# , num#col# , ?, ? ) .
     5737       num#col# = 3.
     5738       run macr_excel_char( "Код"   , num#str# , num#col#   ) .
     5739       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     5740       run macr_cell_format
     5741       ( 12    ,
     5742         true  ,
     5743         false  ,
     5744         ?    ,
     5745         pp,
     5746         1 ,
     5747         num#str# ,
     5748         3 ) .
     5749        put  stream macr_excel unformatted
     5750          substitute('select("r&1c&2:r&3c&4 ")' , tt , 1 , num#str# ,  num#col# ) + chr(10)  +
     5751          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     5752          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     5753          .
     5754       put  stream macr_excel unformatted
     5755          substitute('select("r&1c&2:r&3c&4 ")' , pp , 1 , pp ,  3 ) + chr(10)  +
     5756          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     5757    for each temp-doc break by temp-doc.fact-date :
     5758       num#col# = num#col# + 1 .
     5759       run macr_excel_char( "№ " + string(temp-doc.doc-code) + " от " + string(temp-doc.fact-date, "99/99/9999") , pp , num#col#   ) .
     5760       run macr_excel_char( "Норма " , num#str# , num#col#   ) .
     5761       run macr_cell_size ( 10 , ? , pp , num#col# , num#str# , num#col# ) .
     5762       run macr_cell_format
     5763       ( 12    ,
     5764         true  ,
     5765         false  ,
     5766         ?    ,
     5767         pp   ,
     5768         num#col# ,
     5769         num#str# ,
     5770         num#col# ) .
     5771        put  stream macr_excel unformatted
     5772          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# , num#str# ,  num#col# ) + chr(10)  +
     5773          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     5774          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10).
     5775        put  stream macr_excel unformatted
     5776          substitute('select("r&1c&2:r&3c&4 ")' , pp , num#col# , pp ,  num#col# + 2 ) + chr(10)  +
     5777          'BORDER( 2 , , , , , , , , , , ) '  + chr(10) .
     5778       num#col# = num#col# + 1 .
     5779       run macr_excel_char( "Цена"   , num#str# , num#col#   ) .
     5780       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     5781       run macr_cell_format
     5782       ( 12    ,
     5783         true  ,
     5784         false  ,
     5785         ?    ,
     5786         num#str# ,
     5787         num#col# ,
     5788         num#str# ,
     5789         num#col# ) .
     5790        put  stream macr_excel unformatted
     5791          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# , num#str# ,  num#col# ) + chr(10)  +
     5792          'BORDER(2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     5793          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10).
     5794       num#col# = num#col# + 1 .
     5795       run macr_excel_char( "Сумма"   , num#str# , num#col#   ) .
     5796       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     5797       run macr_cell_format
     5798       ( 12    ,
     5799         true  ,
     5800         false  ,
     5801         ?    ,
     5802         num#str# ,
     5803         num#col# ,
     5804         num#str# ,
     5805         num#col# ) .
     5806        put  stream macr_excel unformatted
     5807          substitute('select("r&1c&2:r&3c&4")' , num#str# , num#col# , num#str# ,  num#col# ) + chr(10)  +
     5808          'BORDER(2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     5809          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10).
     5810    end.
     5811     end.
     5812   end procedure.
     5813   procedure PrintPodval :
     5814     do on error undo, return error return-value  :
     5815     define variable pp as integer no-undo .
     5816     define variable rr as integer no-undo .
     5817       num#str# = num#str# + 1.
     5818       num#col# = 1.
     5819       pp = num#str# .
     5820       run macr_excel_char( "Общая стоимость сырьевого набора на 100 блюд"   , num#str# , num#col#   ) .
     5821       num#str# = num#str# + 1.
     5822       num#col# = 1.
     5823       run macr_excel_char( "Наценка," + string(pp-r)   , num#str# , num#col#   ) .
     5824       num#str# = num#str# + 1.
     5825       num#col# = 1.
     5826       run macr_excel_char( "НДС,"  + string(pp-r)   , num#str# , num#col#   ) .
     5827       num#str# = num#str# + 1.
     5828       num#col# = 1.
     5829       run macr_excel_char( "Цена продажи 1 блюда,"  + string(pp-r)   , num#str# , num#col#   ) .
     5830       num#str# = num#str# + 1.
     5831       num#col# = 1.
     5832       run macr_excel_char( "Цена продажи ,"  + string(pp-r)   , num#str# , num#col#   ) .
     5833       num#str# = num#str# + 1.
     5834       num#col# = 1.
     5835       rr = num#str#.
     5836       run macr_excel_char( "Выход одного блюда в готовом виде,грамм"   , num#str# , num#col#   ) .
     5837       define variable n-pp as integer no-undo .
     5838       repeat n-pp = 0 to 5 :
     5839          put  stream macr_excel unformatted
     5840          substitute('select("r&1c&2:r&3c&4")' , pp + n-pp , num#col# , pp + n-pp ,  num#col# + 2 ) + chr(10)  +
     5841          'BORDER(2 , , , , , , , , , , ) '  + chr(10) .
     5842       end.
     5843      n-pp = 1 .
     5844      for each temp-doc :
     5845       n-pp = n-pp + 3.
     5846       run macr_excel_dec( temp-doc.all-stoim  , pp , n-pp ) .
     5847       run macr_excel_dec( temp-doc.discn      , pp + 1 , n-pp ) .
     5848       run macr_excel_dec( temp-doc.Vat        , pp + 2 , n-pp ) .
     5849       run macr_excel_dec( temp-doc.SLT        , pp + 3 , n-pp ) .
     5850       run macr_excel_dec( temp-doc.price-sale-1 , pp + 4 , n-pp ) .
     5851       run macr_excel_dec( temp-doc.price-sale , pp + 5 , n-pp ) .
     5852       run macr_excel_dec( temp-doc.qnty-inp   , pp + 6 , n-pp ) .
     5853      end.
     5854       num#str# = num#str# + 2.
     5855       num#col# = 1.
     5856       run macr_excel_char( "Заведующий производством"   , num#str# , num#col#   ) .
     5857       num#str# = num#str# + 1.
     5858       num#col# = 1.
     5859       run macr_excel_char( "Калькуляцию составил"       , num#str# , num#col#   ) .
     5860       num#str# = num#str# + 1.
     5861       num#col# = 1.
     5862       run macr_excel_char( "УТВЕРЖДАЮ"                  , num#str# , num#col#   ) .
     5863       num#str# = num#str# + 1.
     5864       num#col# = 1.
     5865       run macr_excel_char( "Руководитель организации"   , num#str# , num#col#   ) .
     5866   PUT STREAM OutStream UNFORMATTED  vv0 skip.
     5867   PUT STREAM OutStream UNFORMATTED string('Общая стоимость сырьевого набора на 100 блюд')  format "x(57)" .   for each temp-doc :        PUT STREAM OutStream UNFORMATTED ":" string(temp-doc.all-stoim) format "x(32)" .   end.    PUT STREAM OutStream skip.
     5868   PUT STREAM OutStream UNFORMATTED string('Наценка,' + string(pp-r))  format "x(57)" .   for each temp-doc :        PUT STREAM OutStream UNFORMATTED ":" string(temp-doc.discn) format "x(32)" .   end.    PUT STREAM OutStream skip.
     5869   PUT STREAM OutStream UNFORMATTED string('НДС,' + string(pp-r))  format "x(57)" .   for each temp-doc :        PUT STREAM OutStream UNFORMATTED ":" string(temp-doc.Vat) format "x(32)" .   end.    PUT STREAM OutStream skip.
     5870   PUT STREAM OutStream UNFORMATTED string('Цена продажи 1 блюда,' + string(pp-r))  format "x(57)" .   for each temp-doc :        PUT STREAM OutStream UNFORMATTED ":" string(temp-doc.price-sale-1) format "x(32)" .   end.    PUT STREAM OutStream skip.
     5871   PUT STREAM OutStream UNFORMATTED string('Цена продажи ,' + string(pp-r))  format "x(57)" .   for each temp-doc :        PUT STREAM OutStream UNFORMATTED ":" string(temp-doc.price-sale) format "x(32)" .   end.    PUT STREAM OutStream skip.
     5872   PUT STREAM OutStream UNFORMATTED string('Выход одного блюда в готовом виде,грамм')  format "x(57)" .   for each temp-doc :        PUT STREAM OutStream UNFORMATTED ":" string(temp-doc.qnty-inp) format "x(32)" .   end.    PUT STREAM OutStream skip.
     5873   PUT STREAM OutStream UNFORMATTED  vv0 skip.
     5874     PUT  STREAM OutStream " "
     5875           skip
     5876         " Заведующий производством _______________________ " skip
     5877         " Калькуляцию составил     _______________________ " skip
     5878         " УТВЕРЖДАЮ "                                        skip
     5879         " Руководитель организации _______________________ " skip
     5880         .
     5881     end.
     5882   end procedure.
     5883   PROCEDURE on-same-page :
     5884     define input parameter p-line-number as integer  no-undo .
     5885     if p-line-number > page-size( OutStream ) then return .
     5886     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     5887   end procedure.
     5888   procedure make-tt :
     5889     do
     5890     on error undo, return error return-value
     5891     :
     5892   define variable v-cur-dn as character no-undo .
     5893   define variable v-cur-pr as decimal no-undo .
     5894   define variable v-cur-rt as decimal no-undo .
     5895   define variable v-cur-ex as decimal no-undo .
     5896   define variable v-bar-code like bar-code.b-code no-undo .
     5897   define variable t-i as integer no-undo .
     5898   define variable var-norma as decimal no-undo .
     5899   define variable var-fact as decimal no-undo .
     5900   define variable var-delta as decimal no-undo .
     5901   define buffer buf_fbr-doc-line   for fbr-line .
     5902   define buffer bb_recipe          for recipe-gds.
     5903   define buffer buf_fbr-recipe-gds for fbr-recipe-gds.
     5904   define buffer buf_goods          for goods .
     5905   define variable var-season-qnty as decimal no-undo .
     5906   t-i = 0 .
     5907         for each temp-doc break by temp-doc.fact-order by temp-doc.fact-date :
     5908             for each bb_recipe no-lock where  bb_recipe.recipe-code = temp-doc.recipe-code :
     5909               for each  buf_fbr-doc-line no-lock where buf_fbr-doc-line.doc-code  = temp-doc.doc-code     and
     5910                                                        buf_fbr-doc-line.recipe-code =temp-doc.recipe-code and
     5911                                                        buf_fbr-doc-line.artic     = bb_recipe.artic       and
     5912                                                        buf_fbr-doc-line.prod-type = bb_recipe.prod-type   and
     5913                                                        buf_fbr-doc-line.prod-code = bb_recipe.prod-code
     5914                                                        :
     5915               for each  buf_fbr-recipe-gds no-lock where buf_fbr-recipe-gds.doc-code   = temp-doc.doc-code    and
     5916                                                         buf_fbr-recipe-gds.recipe-code = temp-doc.recipe-code and
     5917                                                         buf_fbr-recipe-gds.artic       = bb_recipe.artic      and
     5918                                                         buf_fbr-recipe-gds.prod-type   = bb_recipe.prod-type  and
     5919                                                         buf_fbr-recipe-gds.prod-code   = bb_recipe.prod-code
     5920                                                         :
     5921                         if not can-find ( first temp-str where
     5922                               temp-str.artic     = buf_fbr-doc-line.artic and
     5923                               temp-str.prod-type = buf_fbr-doc-line.prod-type and
     5924                               temp-str.prod-code = buf_fbr-doc-line.prod-code  )  then do
     5925                               :
     5926                           find first buf_goods where
     5927                                       buf_goods.artic     = buf_fbr-doc-line.artic      and
     5928                                       buf_goods.prod-code = buf_fbr-doc-line.prod-code  and
     5929                                       buf_goods.prod-type = buf_fbr-doc-line.prod-type  no-lock no-error .
     5930                           if not available buf_goods then next.
     5931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5932     (input  buf_goods.gds-code
     5933     ,input  ?
     5934     ,output v-bar-code
     5935     )  .
     5936                           t-i = t-i + 1 .
     5937                           create temp-str .
     5938                           assign
     5939                             temp-str.np         =  t-i
     5940                             temp-str.gds-name   =  buf_goods.gds-name
     5941                             temp-str.b-code     =  string(v-bar-code)
     5942                             temp-str.artic      =  buf_fbr-doc-line.artic
     5943                             temp-str.prod-type  =  buf_fbr-doc-line.prod-type
     5944                             temp-str.prod-code  =  buf_fbr-doc-line.prod-code
     5945                           .
     5946                         end.
     5947                         find first temp-delta where
     5948                               temp-delta.doc-code  = buf_fbr-doc-line.doc-code and
     5949                               temp-delta.artic     = buf_fbr-doc-line.artic    and
     5950                               temp-delta.prod-type = buf_fbr-doc-line.prod-type and
     5951                               temp-delta.prod-code = buf_fbr-doc-line.prod-code no-error .
     5952                               if not available temp-delta then create temp-delta.
     5953                               run get-brutto-seson (output var-season-qnty ,
     5954                                                     input buf_fbr-doc-line.artic     ,
     5955                                                     input buf_fbr-doc-line.prod-type ,
     5956                                                     input buf_fbr-doc-line.prod-code,
     5957                                                     input temp-doc.recipe-code
     5958                                                     ) .
     5959                               var-norma = var-season-qnty * temp-doc.ves * 100 / temp-doc.netto .
     5960                               var-fact  = buf_fbr-doc-line.fact-qnty * temp-doc.ves * 100 / temp-doc.qnty-line .
     5961                               var-delta = var-fact -  var-norma .
     5962                                   assign
     5963                                     temp-delta.qnty-delta = round( var-delta , 3 )
     5964                                     temp-delta.price-cost = buf_fbr-doc-line.price-rubl
     5965                                     temp-delta.sum-cost   = buf_fbr-doc-line.price-rubl * 100 * temp-delta.qnty-delta  / temp-doc.porcii
     5966                                     temp-delta.doc-code   = buf_fbr-doc-line.doc-code
     5967                                     temp-delta.artic      = buf_fbr-doc-line.artic
     5968                                     temp-delta.prod-type  = buf_fbr-doc-line.prod-type
     5969                                     temp-delta.prod-code  = buf_fbr-doc-line.prod-code
     5970                                   .
     5971                 end.
     5972               end.
     5973             end.
     5974         end.
     5975     end.
     5976    end procedure.
     5977   procedure print-dop-str :
     5978    do
     5979    on error undo, return error return-value
     5980    :
     5981   define input parameter p-name as character no-undo .
     5982   define input parameter p-p   as logical no-undo .
     5983   define variable p-norma as decimal  no-undo .
     5984   define variable p-price as decimal  format ">>>>>>>>>>9.99" no-undo .
     5985   define variable p-sum   as decimal format "->>>>>>>>>9.99"  no-undo .
     5986   define buffer buf_fbr-line       for fbr-line .
     5987   num#str# = num#str# + 1.
     5988   num#col# = 2.
     5989   run macr_excel_char( p-name              , num#str# , num#col#   ) .
     5990   assign    num#col# = num#col# + 2 .
     5991   PUT STREAM OutStream UNFORMATTED
     5992       sym1                format "X(1)" space(0)
     5993       0                   format ">>>>>" space(0)
     5994       sym2                format "X(1)" space(0)
     5995       p-name              format "X(40)" space(0)
     5996       sym3                format "X(1)" space(0)
     5997       ""                  format "X(9)" space(0)
     5998       sym4                format "X(1)" space(0)
     5999   .
     6000    for each temp-doc break by temp-doc.fact-date :
     6001        find first temp-delta where
     6002                   temp-delta.doc-code  = temp-doc.doc-code  and
     6003                   temp-delta.artic     = temp-str.artic     and
     6004                   temp-delta.prod-type = temp-str.prod-type and
     6005                   temp-delta.prod-code = temp-str.prod-code no-error .
     6006        if available temp-delta then do:
     6007           p-norma = temp-delta.qnty-delta .
     6008           find first buf_fbr-line       no-lock where
     6009                                                       buf_fbr-line.doc-code  = temp-doc.doc-code and
     6010                                                       buf_fbr-line.recipe-code  = temp-doc.recipe-code and
     6011                                                       buf_fbr-line.artic     = temp-str.artic and
     6012                                                       buf_fbr-line.prod-type = temp-str.prod-type and
     6013                                                       buf_fbr-line.prod-code = temp-str.prod-code no-error .
     6014           if available buf_fbr-line then
     6015           assign
     6016             p-price  = buf_fbr-line.price-rubl
     6017           .
     6018             if not(( p-p =  true  and temp-delta.qnty-delta > 0 ) OR
     6019                   ( p-p =  false and temp-delta.qnty-delta < 0 ) )
     6020                then  do:
     6021                       assign
     6022                         p-price = 0
     6023                         p-norma = 0
     6024                       .
     6025    .
     6026                end.
     6027         end.
     6028         p-sum = p-price * p-norma .
     6029         run macr_excel_char( round(p-norma ,3)   , num#str# , num#col#   ) .  assign    num#col# = num#col# + 1 .
     6030         run macr_excel_char( round(p-price ,2)    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     6031         run macr_excel_char( round(p-sum   ,2)    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     6032         if p-price = 0 and p-norma = 0 then
     6033            PUT STREAM OutStream UNFORMATTED "         :          :           :" .
     6034         else
     6035             PUT STREAM OutStream UNFORMATTED string( p-norma ,"->>>>>>9.<<<" )
     6036                                             + ":"
     6037                                             string(round(p-price,2),">>>>>>9.99" )
     6038                                             + ":"
     6039                                             string(round(p-sum,2)  ,"->>>>>>9.99" )
     6040                                             + ":"
     6041                                             .
     6042    end.
     6043     PUT STREAM OutStream UNFORMATTED skip.
     6044    end.
     6045   end procedure.
     6046   procedure chg-record-temp-doc :
     6047    do
     6048    on error undo, return error return-value
     6049    :
     6050    define variable p-res as logical no-undo .
     6051       for each old-t : delete old-t. end.
     6052       for each new-t : delete new-t. end.
     6053       for each temp-doc break by  temp-doc.fact-date by temp-doc.fact-order:
     6054          run make-t ("new":u ).
     6055          run compare-new-old ( output p-res ) .
     6056          if p-res = false  then do :
     6057             delete temp-doc.
     6058             col-doc = col-doc - 1 .
     6059             end.
     6060           else do:
     6061                for each old-t : delete old-t. end.
     6062                run make-t ("old":u ).
     6063           end.
     6064           for each new-t : delete new-t. end.
     6065       end.
     6066    end.
     6067   end procedure.
     6068   procedure make-t :
     6069    do
     6070    on error undo, return error return-value
     6071    :
     6072   define input parameter pp as character no-undo .
     6073   define buffer buf_recipe       for fbr-recipe .
     6074   define buffer bb_recipe-gds    for fbr-recipe-gds .
     6075   define buffer buf_fbr-doc-line for fbr-line .
     6076   define buffer buf_goods for goods.
     6077     for each bb_recipe-gds no-lock where  bb_recipe-gds.recipe-code = temp-doc.recipe-code and
     6078                                           bb_recipe-gds.doc-code    = temp-doc.doc-code
     6079                                           :
     6080         for each  buf_fbr-doc-line no-lock where buf_fbr-doc-line.doc-code = temp-doc.doc-code and
     6081                                                 buf_fbr-doc-line.recipe-code  = temp-doc.recipe-code and
     6082                                                 buf_fbr-doc-line.artic     = bb_recipe-gds.artic and
     6083                                                 buf_fbr-doc-line.prod-type = bb_recipe-gds.prod-type and
     6084                                                 buf_fbr-doc-line.prod-code = bb_recipe-gds.prod-code
     6085                                                 :
     6086             find first buf_goods no-lock where buf_fbr-doc-line.artic   = buf_goods.artic      and
     6087                         buf_fbr-doc-line.prod-code = buf_goods.prod-code  and
     6088                         buf_fbr-doc-line.prod-type = buf_goods.prod-type  no-error .
     6089                         if error-status :error then next.
     6090           if pp = "old":U then do:
     6091           create old-t.
     6092           assign
     6093             old-t.gds-code   = buf_goods.gds-code
     6094             old-t.crsa-price = temp-doc.price-sale
     6095             old-t.norma      = round( bb_recipe-gds.qnty / temp-doc.porcii , 3 )
     6096             old-t.cost-price = buf_fbr-doc-line.price-rubl
     6097           .
     6098           end.
     6099           else do:
     6100           create new-t.
     6101           assign
     6102             new-t.gds-code   = buf_goods.gds-code
     6103             new-t.crsa-price = temp-doc.price-sale
     6104             new-t.norma      = round( bb_recipe-gds.qnty / temp-doc.porcii , 3 )
     6105             new-t.cost-price = buf_fbr-doc-line.price-rubl
     6106           .
     6107           end.
     6108         end.
     6109     end.
     6110    end.
     6111   end procedure.
     6112   procedure compare-new-old :
     6113    do
     6114    on error undo, return error return-value
     6115    :
     6116   define output parameter v-res as logical no-undo .
     6117   v-res = false .
     6118   for each new-t :
     6119       find first old-t where  old-t.gds-code   = new-t.gds-code  and
     6120                         old-t.norma      = new-t.norma     and
     6121                         old-t.cost-price = new-t.cost-price and
     6122                         old-t.crsa-price = new-t.crsa-price  no-error .
     6123       if error-status :error then do:
     6124          v-res = true .
     6125          return .
     6126       end.
     6127   end.
     6128   for each old-t :
     6129       find first new-t where  new-t.gds-code   = old-t.gds-code  and
     6130                         new-t.norma      = old-t.norma     and
     6131                         new-t.cost-price = old-t.cost-price and
     6132                         new-t.crsa-price = old-t.crsa-price  no-error .
     6133       if error-status :error then do:
     6134          v-res = true .
     6135          return  .
     6136       end.
     6137   end.
     6138   end.
     6139   end procedure.
     6140   procedure get-brutto-seson :
     6141    do
     6142    on error undo, return error return-value
     6143    :
     6144   define output parameter p-se-qnty as decimal no-undo .
     6145   define input parameter p-artic     like  ub.goods.artic      no-undo.
     6146   define input parameter p-prod-type like  ub.goods.prod-type  no-undo.
     6147   define input parameter p-prod-code like  ub.goods.prod-code  no-undo.
     6148   define input parameter p-recipe-code like ub.recipe-gds.recipe-code no-undo.
     6149   define buffer local-recipe-gds for  ub.recipe-gds  .
     6150   define buffer bf_goods for ub.goods.
     6151   define variable varcoeff as decimal no-undo.
     6152   find first bf_goods no-lock where
     6153             bf_goods.artic     = p-artic and
     6154             bf_goods.prod-type = p-prod-type and
     6155             bf_goods.prod-code = p-prod-code no-error .
     6156   if error-status :error then return error .
     6157   find first local-recipe-gds no-lock where
     6158             local-recipe-gds.recipe-code = p-recipe-code and
     6159             local-recipe-gds.artic       = p-artic and
     6160             local-recipe-gds.prod-type   = p-prod-type and
     6161             local-recipe-gds.prod-code   = p-prod-code no-error .
     6162   if error-status :error then return error .
     6163    run fbrlib-s-coeff-value in this-procedure
     6164      (input bf_goods.gds-code,
     6165       input varobj-date,
     6166       input v-cntxt-obj-type,
     6167       input v-cntxt-obj-code,
     6168       output varcoeff
     6169       ).
     6170   define variable v-void-decimal as decimal no-undo .
     6171   define variable v-brutto  like recipe-gds.brutto-qnty  no-undo .
     6172   define variable v-void-integer as integer no-undo .
     6173       run fbrlib-calc-brutto in this-procedure (
     6174             input 'производство':U
     6175           , input local-recipe-gds.qnty
     6176           , input varcoeff
     6177           , input local-recipe-gds.coeff-waste
     6178           , input 0.0
     6179           , input 3
     6180           , output v-void-decimal
     6181           , output v-void-decimal
     6182           , output v-brutto
     6183           , output v-void-integer
     6184       ).
     6185    p-se-qnty = v-brutto .
     6186    end.
     6187   end procedure.
     6188   def var vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6189   procedure macr_excel_char :
     6190    do
     6191    on error undo, return error return-value
     6192    :
     6193    define input parameter  p-val as character no-undo .
     6194    define input parameter  p-row as integer no-undo .
     6195    define input parameter  p-col as integer no-undo .
     6196    if p-val = ? then p-val = "" .
     6197       put stream macr_excel unformatted
     6198             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     6199    end.
     6200   end procedure.
     6201   procedure macr_excel_char_with_format :
     6202    do
     6203    on error undo, return error return-value
     6204    :
     6205    define input parameter  p-val as character no-undo .
     6206    define input parameter  p-row as integer no-undo .
     6207    define input parameter  p-col as integer no-undo .
     6208    if p-val = ? then p-val = "" .
     6209       put stream macr_excel unformatted
     6210             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     6211       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     6212       put stream macr_excel unformatted
     6213             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     6214    end.
     6215   end procedure.
     6216   procedure macr_excel_cell_format :
     6217    do
     6218    on error undo, return error return-value
     6219    :
     6220    define input parameter  p-val    as character no-undo .
     6221    define input parameter  p-row    as integer   no-undo .
     6222    define input parameter  p-col    as integer   no-undo .
     6223    define input parameter  p-format as character no-undo .
     6224    if p-val = ? then p-val = "" .
     6225       put stream macr_excel unformatted
     6226             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     6227       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     6228       put stream macr_excel unformatted
     6229             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     6230    end.
     6231   end procedure.
     6232   procedure macr_excel_sum :
     6233    do
     6234    on error undo, return error return-value
     6235    :
     6236    define input parameter  p-row as integer no-undo .
     6237    define input parameter  p-col as integer no-undo .
     6238    define input parameter  p-row1 as integer no-undo .
     6239    define input parameter  p-col1 as integer no-undo .
     6240    define input parameter  p-row2 as integer no-undo .
     6241    define input parameter  p-col2 as integer no-undo .
     6242       put stream macr_excel unformatted
     6243             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     6244    end.
     6245   end procedure.
     6246   procedure macr_excel_dec :
     6247    do
     6248    on error undo, return error return-value
     6249    :
     6250    define input parameter  p-val as character no-undo .
     6251    define input parameter  p-row as integer   no-undo .
     6252    define input parameter  p-col as integer   no-undo .
     6253     if p-val = ? then p-val =  "" .
     6254      put  stream macr_excel unformatted
     6255           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     6256    end.
     6257   end procedure.
     6258   procedure macr_cell_format :
     6259    do
     6260    on error undo, return error return-value
     6261    :
     6262    define input parameter  p-size   as integer   no-undo .
     6263    define input parameter  p-bold   as logical   no-undo .
     6264    define input parameter  p-italic as logical   no-undo .
     6265    define input parameter  p-color  as integer   no-undo .
     6266    define input parameter  p-row    as integer   no-undo .
     6267    define input parameter  p-col    as integer   no-undo .
     6268    define input parameter  p-row-2  as integer   no-undo .
     6269    define input parameter  p-col-2  as integer   no-undo .
     6270     if p-size = ? then p-size = 10 .
     6271     if p-bold = ? then p-bold = false .
     6272     if p-italic = ? then p-italic = false .
     6273     if p-row-2 = ? then p-row-2 = p-row .
     6274     if p-col-2 = ? then p-col-2 = p-col .
     6275     put  stream macr_excel unformatted
     6276      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     6277     if p-color <> ? then do:
     6278        put  stream macr_excel unformatted
     6279          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     6280     end.
     6281     put  stream macr_excel unformatted
     6282          substitute('format.font(,&1,&2,&3)' , p-size,
     6283                                           string ( p-bold  , "true/false" ) ,
     6284                                           string ( p-italic , "true/false" )
     6285                                           ) + chr(10) .
     6286    end.
     6287   end procedure.
     6288   procedure macr_cell_size :
     6289    do
     6290    on error undo, return error return-value
     6291    :
     6292    define input parameter  p-w   as integer   no-undo .
     6293    define input parameter  p-l   as integer   no-undo .
     6294    define input parameter  p-row    as integer   no-undo .
     6295    define input parameter  p-col    as integer   no-undo .
     6296    define input parameter  p-row-2  as integer   no-undo .
     6297    define input parameter  p-col-2  as integer   no-undo .
     6298     if p-row-2 = ? then p-row-2 = p-row .
     6299     if p-col-2 = ? then p-col-2 = p-col .
     6300     if p-w = ? then    p-w = 0 .
     6301     if p-l = ? then    p-l = 0 .
     6302    define variable s-w as character no-undo .
     6303    define variable s-l as character no-undo .
     6304    if p-w = 0 then s-w = "" .
     6305               else s-w = string(p-w)  .
     6306    if p-l = 0 then s-l = "" .
     6307               else s-l = string(p-l)  .
     6308   put  stream macr_excel unformatted
     6309        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     6310   put  stream macr_excel unformatted
     6311        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     6312   put  stream macr_excel unformatted
     6313        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     6314    end.
     6315   end procedure.
     6316   procedure proc-print-header :
     6317    do
     6318    on error undo, return error return-value
     6319    :
     6320      find first sheetf .
     6321        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     6322        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     6323        var-1 =  num#str# .
     6324        repeat c-c = 1 to sheetf.excel-row-title :
     6325        num#str# = num#str# + 1 .
     6326        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     6327        do c-i = 1 to p-var :
     6328           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     6329           str--2 = integer(entry( c-i, sheetf.sizes )) .
     6330           num#col# = c-i .
     6331           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     6332           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     6333        end.
     6334       c-i = 0.
     6335       end.
     6336       run macr_cell_format (
     6337           10       ,
     6338           true     ,
     6339           false    ,
     6340           35       ,
     6341           var-1 + 1,
     6342           1        ,
     6343           num#str# ,
     6344           num#col# )
     6345           .
     6346     put  stream macr_excel unformatted
     6347          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     6348          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     6349          .
     6350    end.
     6351   end procedure.
     6352   procedure end-proc :
     6353    do
     6354    on error undo, return error return-value
     6355    :
     6356     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     6357     OUTPUT to VALUE (v-file-name) .
     6358     for each temp-param :
     6359       export  temp-param  .
     6360     end.
     6361    end.
     6362   end procedure.
