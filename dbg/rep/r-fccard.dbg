        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: r-fccard.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/r-fccard.p $":U .
        7   define variable vss-description as character no-undo init " Реестр калькуляционных карточек ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure cur-time :
       68      define output parameter p-today as date      no-undo .
       69      define output parameter p-time  as integer   no-undo .
       70     do
       71     on error undo, return error
       72     :
       73       define variable v-date1 as date      no-undo .
       74       define variable v-date2 as date      no-undo .
       75       define variable v-time  as integer   no-undo .
       76       assign
       77         v-date1 = today
       78         v-time  = time
       79         v-date2 = today
       80       .
       81       if v-date1 <> v-date2
       82       then do:
       83         assign
       84           v-date1 = today
       85           v-time  = v-time
       86         .
       87       end.
       88       assign
       89         p-today = v-date1
       90         p-time  = v-time
       91       .
       92     end.
       93   end.
       94   function cur-time-date returns character
       95   :
       96     return string(today, '99/99/9999':U) .
       97   end.
       98   function cur-time-mjd returns decimal
       99   :
      100     define variable v-date as date      no-undo .
      101     define variable v-time as integer   no-undo .
      102     run cur-time in this-procedure
      103       (output v-date
      104       ,output v-time
      105       ) .
      106     return integer(v-date) - 2400002 + (v-time / 86400) .
      107   end.
      108   function cur-time-get-ending-index returns integer
      109   (input p-number as integer
      110   )
      111   :
      112     if p-number < 0
      113     or p-number = ?
      114     then do:
      115       return 1 .
      116     end.
      117     define variable v-rest as integer   no-undo .
      118     assign
      119       p-number = p-number modulo 100
      120     .
      121     if p-number < 20
      122     then do:
      123       assign
      124         v-rest = p-number
      125       .
      126     end.
      127     else do:
      128       assign
      129         v-rest = p-number modulo 10
      130       .
      131     end.
      132     case v-rest :
      133       when 1
      134       then do:
      135         return 2 .
      136       end.
      137       when 2 or
      138       when 3 or
      139       when 4
      140       then do:
      141         return 3 .
      142       end.
      143       otherwise do:
      144         return 1 .
      145       end.
      146     end case .
      147   end.
      148   procedure cur-time-mjd-to-date :
      149      define input  parameter i-mjd-diff as decimal no-undo.
      150      define output parameter o-Date     as date    no-undo.
      151      define output parameter o-Time     as integer no-undo.
      152      define variable v-day-number as integer   no-undo .
      153      if    i-mjd-diff < 0
      154         or i-mjd-diff = ?
      155      then do:
      156         return "?" .
      157      end.
      158      assign
      159         v-day-number = truncate(i-mjd-diff,0).
      160         o-Date = date(v-day-number + 2400002).
      161         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      162     .
      163   end.
      164   function cur-time-mjd-to-string returns character
      165   (input p-mjd-diff as decimal
      166   )
      167   :
      168     define variable v-day-number as integer   no-undo .
      169     define variable v-seconds    as integer   no-undo .
      170     define variable v-hour       as integer   no-undo .
      171     define variable v-min        as integer   no-undo .
      172     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      173     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      174     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      175     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      176     if p-mjd-diff < 0
      177     or p-mjd-diff = ?
      178     then do:
      179       return "?" .
      180     end.
      181     assign
      182       v-day-number = integer(truncate(p-mjd-diff,0))
      183       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185     if v-seconds > 86400
      186     then do:
      187       assign
      188         v-seconds = 86400 - 1
      189       .
      190     end.
      191     if v-seconds < 0
      192     then do:
      193       assign
      194         v-seconds = 0
      195       .
      196     end.
      197     assign
      198       v-hour = truncate(v-seconds / 3600, 0)
      199     .
      200     assign
      201       v-seconds = v-seconds modulo 3600
      202     .
      203     assign
      204       v-min = truncate(v-seconds / 60, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 60
      208     .
      209     return
      210         (if v-day-number <> 0
      211           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      212           else ""
      213         )
      214       + (if v-day-number <> 0 or v-hour <> 0
      215           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      219           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      220           else ""
      221         )
      222       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      223       .
      224   end.
      225   function cur-time-string returns character
      226   :
      227     define variable v-date as date      no-undo .
      228     define variable v-time as integer   no-undo .
      229     run cur-time in this-procedure
      230       (output v-date
      231       ,output v-time
      232       ) .
      233     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      234   end.
      235   function cur-time-string-sec returns character
      236   :
      237     define variable v-date as date      no-undo .
      238     define variable v-time as integer   no-undo .
      239     run cur-time in this-procedure
      240       (output v-date
      241       ,output v-time
      242       ) .
      243     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      244   end.
      245   function cur-time-custom  returns character
      246   (input p-prefix as character
      247   ,input p-date-format as character
      248   ,input p-delimiter as character
      249   ,input p-time-format as character
      250   ,input p-suffix as character
      251   )
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return
      260       p-prefix
      261       + string(v-date, p-date-format)
      262       + p-delimiter
      263       + string(v-time, p-time-format)
      264       + p-suffix
      265       .
      266   end.
      267   function cur-time-print  returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      276   end.
      277   function cur-time-datetime returns datetime
      278   :
      279     define variable v-char as character no-undo .
      280     define variable v-datetime as datetime no-undo .
      281     v-char = cur-time-string().
      282     v-datetime = datetime(v-char).
      283     return  v-datetime.
      284   end.
      285   function cur-time-string-msec returns character
      286   :
      287     define variable v-date as datetime  no-undo .
      288     v-date = now.
      289     return string(v-date) .
      290   end.
