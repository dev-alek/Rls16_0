      563   define new global shared variable g#library  as handle no-undo .
      564   define new global shared variable g#library2 as handle no-undo .
      565   define variable var-report-r-b as character no-undo .
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   procedure proc-alt-shift-f2:
      572     if not ibs.th.gbl.gbl-var:rcode
      573   then
      574     run gbl\inidebug.p .
      575   end.
      576   procedure proc-alt-shift-f3:
      577     run gbl/prvssinf.p
      578       ( input this-procedure
      579       ) .
      580   end.
      581   define variable v-inform-launched as logical no-undo initial false .
      582   procedure proc-alt-shift-f4:
      583     define variable v-action as character no-undo .
      584     if v-inform-launched = false then do:
      585       assign
      586         v-inform-launched = true
      587       .
      588       run gbl/d-inform.w
      589         (  input self
      590         ,  input this-procedure
      591         , output v-action
      592         ) no-error .
      593       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      594       assign
      595         v-inform-launched = false
      596       .
      597     end.
      598   end.
      599   procedure proc-alt-f1:
      600     run gbl/corrhelp.p
      601       (input this-procedure
      602       ) .
      603   end .
      604   on alt-shift-f2 anywhere do:
      605     run proc-alt-shift-f2.
      606   end.
      607   on alt-shift-f3 anywhere do:
      608     run proc-alt-shift-f3 in this-procedure .
      609   end.
      610   on alt-shift-f4 anywhere do:
      611     run proc-alt-shift-f4 in this-procedure.
      612   end.
      613   on alt-f1 anywhere do:
      614     run proc-alt-f1 in this-procedure .
      615   end.
      616   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617     define variable v-cntxt-db-num        as integer   no-undo .
      618     define variable v-cntxt-userid        as character no-undo .
      619     define variable v-cntxt-level         as character no-undo .
      620     define variable v-cntxt-host-code-obj as integer   no-undo .
      621     define variable v-cntxt-obj-type      as character no-undo .
      622     define variable v-cntxt-obj-code      as integer   no-undo .
      623     define variable v-cntxt-db-num-obj    as integer   no-undo .
      624     define variable v-cntxt-is-admin      as logical   no-undo .
      625   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626     run mainmenu_getcntxt in my-handle
      627       (output v-cntxt-db-num
      628       ,output v-cntxt-userid
      629       ,output v-cntxt-level
      630       ,output v-cntxt-host-code-obj
      631       ,output v-cntxt-obj-type
      632       ,output v-cntxt-obj-code
      633       ,output v-cntxt-db-num-obj
      634       ,output v-cntxt-is-admin
      635       ) .
      636   define variable base-type as character no-undo .
      637   define variable base-code as integer   no-undo .
      638   define variable g#report-num as integer   no-undo .
      639   define variable g#gds-engl as logical   no-undo .
      640   define variable vv-exch-rate  as decimal   no-undo .
      641   define variable vv-exch-scale as decimal   no-undo .
      642   define variable v-cntxt-host-name-obj as character no-undo .
      643   if v-cntxt-level = 'object':U then do:
      644   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      646     (input  v-cntxt-obj-type
      647     ,input  v-cntxt-obj-code
      648     ,output v-cntxt-host-code-obj
      649     ,output v-cntxt-host-name-obj
      650     )  .
      651   end.
      652   if v-cntxt-level = 'firm':U then do:
      653     find first ub.clients no-lock where
      654                ub.clients.obj-type = 'орг':U and
      655                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      656   if error-status :error then v-cntxt-host-name-obj = ? .
      657      else v-cntxt-host-name-obj = ub.clients.obj-name.
      658   end.
      659   if v-cntxt-level = 'object':U
      660   or v-cntxt-level = 'firm':U
      661   then do:
      662   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      664     (input  v-cntxt-host-code-obj
      665     ,output base-code
      666     )  .
      667   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      669     (input  base-code
      670     ,input  today
      671     ,output vv-exch-rate
      672     ,output vv-exch-scale
      673     ,output base-type
      674     )  .
      675   end.
      676   run get-report-num in my-handle ( output g#report-num ).
      677   run get-gds-engl in my-handle ( output g#gds-engl ) .
      678   CREATE WIDGET-POOL.
      679   def var State-source as  WIDGET-HANDLE.
      680   define variable v-log as logical   no-undo .
      681   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      682        VIEW-AS FILL-IN NATIVE
      683        SIZE 5 BY 1 NO-UNDO.
      684   DEFINE VARIABLE Classify AS CHARACTER
      685        VIEW-AS RADIO-SET VERTICAL
      686        RADIO-BUTTONS
      687             "Без классификации", "no-classify":U,
      688   "Производители", "prod":U,
      689   "Группы товаров", "grp-goods":U,
      690   "Производители/Группы товаров", "prod/grp-goods":U,
      691   "Группы товаров/Производители", "grp-goods/prod":U,
      692   "Ставка НДС", "vat-ps":U
      693        SIZE 32 BY 6.29 NO-UNDO.
      694   DEFINE VARIABLE SortType AS CHARACTER
      695        VIEW-AS RADIO-SET VERTICAL
      696        RADIO-BUTTONS
      697             "по коду", "sort-code":U,
      698   "по артикулу", "sort-artic":U,
      699   "по наимен.", "sort-name":U
      700        SIZE 16.88 BY 1.96 NO-UNDO.
      701   DEFINE RECTANGLE RECT-5
      702        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      703        SIZE 47.63 BY 9.88.
      704   DEFINE RECTANGLE RECT-6
      705        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      706        SIZE 47.63 BY 3.13.
      707   DEFINE RECTANGLE RECT-8
      708        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      709        SIZE 47.63 BY 4.38.
      710   DEFINE RECTANGLE RECT-9
      711        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      712        SIZE 30.63 BY 17.08.
      713   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
      714        LABEL "Нулевые остатки":L
      715        VIEW-AS TOGGLE-BOX
      716        SIZE 19 BY .83 NO-UNDO.
      717   DEFINE VARIABLE ShowZero-2 AS LOGICAL INITIAL no
      718        LABEL "Нулевые обороты":L
      719        VIEW-AS TOGGLE-BOX
      720        SIZE 19 BY .83 NO-UNDO.
      721   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      722        LABEL "Только итоги":L
      723        VIEW-AS TOGGLE-BOX
      724        SIZE 19 BY .83 NO-UNDO.
      725   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      726        LABEL "с уровня":L
      727        VIEW-AS TOGGLE-BOX
      728        SIZE 12.63 BY 1 NO-UNDO.
      729   DEFINE VARIABLE Tog-obj AS LOGICAL INITIAL yes
      730        LABEL "Раздельно по объектам":L
      731        VIEW-AS TOGGLE-BOX
      732        SIZE 39.38 BY 1 NO-UNDO.
      733   DEFINE VARIABLE VAT-Cost AS LOGICAL INITIAL no
      734        LABEL "НДС в учетных ценах":L
      735        VIEW-AS TOGGLE-BOX
      736        SIZE 25.63 BY .83 NO-UNDO.
      737   DEFINE VARIABLE VAT-CRSA AS LOGICAL INITIAL no
      738        LABEL "НДС в продажных ценах":L
      739        VIEW-AS TOGGLE-BOX
      740        SIZE 25.63 BY .83 NO-UNDO.
      741   DEFINE VARIABLE VAT-sale AS LOGICAL INITIAL no
      742        LABEL "НДС в ценах документа":L
      743        VIEW-AS TOGGLE-BOX
      744        SIZE 25.63 BY .83 NO-UNDO.
      745   DEFINE FRAME F-Main
      746        Tog-obj AT ROW 2.54 COL 32.75
      747        Classify AT ROW 3.79 COL 32.75 NO-LABEL
      748        Tog-lavel AT ROW 5.96 COL 52
      749        var-lavel AT ROW 6 COL 63.25 COLON-ALIGNED NO-LABEL
      750        ShowZero-2 AT ROW 12.04 COL 33
      751        VAT-Cost AT ROW 12.04 COL 53.13
      752        ShowZero AT ROW 12.92 COL 33
      753        VAT-CRSA AT ROW 12.92 COL 53.13
      754        SumsOnly AT ROW 13.83 COL 33
      755        VAT-sale AT ROW 13.83 COL 53.13
      756        SortType AT ROW 16.04 COL 32.5 NO-LABEL
      757        "Тип приобретения:" VIEW-AS TEXT
      758             SIZE 28.88 BY .67 AT ROW 1.38 COL 1.88
      759             FGCOLOR 4
      760        "Показать :" VIEW-AS TEXT
      761             SIZE 46.13 BY .75 AT ROW 11 COL 33
      762             FGCOLOR 4
      763        "Сортировка :" VIEW-AS TEXT
      764             SIZE 46.5 BY .75 AT ROW 15.17 COL 32.63
      765             FGCOLOR 4
      766        "Классификация :" VIEW-AS TEXT
      767             SIZE 46 BY .75 AT ROW 1.29 COL 33
      768             FGCOLOR 4
      769        RECT-5 AT ROW 1 COL 31.38
      770        RECT-6 AT ROW 15.08 COL 31.38
      771        RECT-8 AT ROW 10.79 COL 31.38
      772        RECT-9 AT ROW 1.08 COL 1
      773       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      774            SIDE-LABELS NO-UNDERLINE THREE-D
      775            AT COL 1 ROW 1 SCROLLABLE .
      776   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      777   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      778   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      779   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      780   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      781   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      782   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      783   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      784         adm-object-hdl = FRAME F-Main:HANDLE.
      785   RUN ensure-broker.
      786   THIS-PROCEDURE:ADM-DATA =
      787        'ADM1.1~`':U +
      788        'SmartObject~`':U +
      789        '~`':U +
      790        'NO ~`':U +
      791        '~`':U +
      792        '~`':U +
      793        '~`':U +
      794        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      795           + "~`":U +
      796        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      797        'Record-Source,Record-Target,TableIO-Target~`':U +
      798        '~`':U +
      799        '~`~`~`~`~`~`~`~`~`~`~`':U +
      800        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      801            THEN "^^":U
      802        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      803             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      804   PROCEDURE adm-apply-entry :
      805     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      806   END PROCEDURE.
      807   PROCEDURE adm-destroy :
      808    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      809   END PROCEDURE.
      810   PROCEDURE adm-disable :
      811       DISABLE RECT-5 RECT-6 RECT-8 RECT-9 Tog-obj Classify ShowZero-2 VAT-Cost ShowZero VAT-CRSA VAT-sale SortType WITH FRAME F-Main.
      812       RUN dispatch ('disable-fields':U).
      813       RUN set-attribute-list ('ENABLED=no':U).
      814       RETURN.
      815   END PROCEDURE.
      816   PROCEDURE adm-edit-attribute-list :
      817         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      818         RETURN.
      819   END PROCEDURE.
      820   PROCEDURE adm-enable :
      821       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 RECT-8 RECT-9 Tog-obj Classify ShowZero-2 VAT-Cost ShowZero VAT-CRSA VAT-sale SortType WITH FRAME F-Main.
      822       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      823       RUN set-attribute-list ('ENABLED=yes':U).
      824       RETURN.
      825   END PROCEDURE.
      826   PROCEDURE adm-exit :
      827        RUN notify ('exit':U).
      828     RETURN.
      829   END PROCEDURE.
      830   PROCEDURE adm-hide :
      831     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      832   END PROCEDURE.
      833   PROCEDURE adm-initialize :
      834     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      835   END PROCEDURE.
      836   PROCEDURE adm-show-errors :
      837       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      838       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      839           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      840       END.
      841       RETURN.
      842   END PROCEDURE.
      843   PROCEDURE adm-UIB-mode :
      844     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      845   END PROCEDURE.
      846   PROCEDURE adm-view :
      847     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      848   END PROCEDURE.
      849   PROCEDURE dispatch :
      850       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      851       RUN broker-dispatch IN adm-broker-hdl
      852           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      853       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      854   END PROCEDURE.
      855   PROCEDURE ensure-broker :
      856   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      857   IF RETURN-VALUE NE "ADM-Broker":U THEN
      858   DO:
      859       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      860       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      861   END.
      862   END PROCEDURE.
      863   PROCEDURE get-attribute :
      864     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      865     RUN broker-get-attribute IN adm-broker-hdl
      866         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      867     RETURN RETURN-VALUE.
      868   END PROCEDURE.
      869   PROCEDURE get-attribute-list :
      870     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      871     RUN broker-get-attribute-list IN adm-broker-hdl
      872         (INPUT THIS-PROCEDURE,
      873          INPUT ?,
      874          OUTPUT p-attr-list) NO-ERROR.
      875     RETURN.
      876   END PROCEDURE.
      877   PROCEDURE new-state :
      878     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      879     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      880     RETURN.
      881   END PROCEDURE.
      882   PROCEDURE notify :
      883     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      884     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      885     IF RETURN-VALUE = "ADM-ERROR":U THEN
      886         RETURN "ADM-ERROR":U.
      887     RETURN.
      888   END PROCEDURE.
      889   PROCEDURE set-attribute-list :
      890     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      891     RUN ensure-broker.
      892     RUN broker-set-attribute-list IN adm-broker-hdl
      893         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      894     RETURN.
      895   END PROCEDURE.
      896   PROCEDURE set-position :
      897       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      898       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      899       IF VALID-HANDLE(adm-object-hdl) THEN
      900       DO:
      901         ASSIGN adm-object-hdl:ROW    =   p-row
      902                adm-object-hdl:COLUMN =   p-col.
      903       END.
      904       RETURN.
      905   END PROCEDURE.
      906   PROCEDURE adm-display-fields :
      907       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      908       RETURN.
      909   END PROCEDURE.
      910   PROCEDURE adm-open-query :
      911     RETURN.
      912   END PROCEDURE.
      913   PROCEDURE adm-row-changed :
      914         IF VALID-HANDLE(adm-object-hdl) THEN
      915           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      916         RUN notify ('row-available':U).
      917         RETURN.
      918   END PROCEDURE.
      919   PROCEDURE reposition-query :
      920       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      921       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      922       RETURN.
      923   END PROCEDURE.
      924     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      925     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      926     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      927     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      928     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      929     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      930     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      931     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      932     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      933     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      934     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      935     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      936     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      937     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      938     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      939     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      940     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      941     IF "":U = "":U THEN
      942       RUN modify-list-attribute IN adm-broker-hdl
      943         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      944     RUN use-create-on-add(?).
      945   PROCEDURE adm-add-record :
      946       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      947          "must have at least one Enabled Table to perform Add.":U
      948          VIEW-AS ALERT-BOX ERROR.
      949       RETURN.
      950   END PROCEDURE.
      951   PROCEDURE adm-assign-record :
