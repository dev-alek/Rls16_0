      963     END PROCEDURE.
      964   PROCEDURE adm-copy-record :
      965       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      966        "must have at least one Enabled Table to perform Copy.":U
      967          VIEW-AS ALERT-BOX ERROR.
      968       RETURN.
      969   END PROCEDURE.
      970   PROCEDURE adm-create-record :
      971      RETURN.
      972   END PROCEDURE.
      973   PROCEDURE adm-current-changed :
      974     RETURN.
      975   END PROCEDURE.
      976   PROCEDURE adm-delete-record :
      977    MESSAGE
      978          "Object ":U THIS-PROCEDURE:FILE-NAME
      979            "must have at least one Enabled Table to perform Delete.":U
      980              VIEW-AS ALERT-BOX ERROR.
      981       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      982       RETURN.
      983   END PROCEDURE.
      984   PROCEDURE adm-disable-fields :
      985         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      986       RETURN.
