      988   PROCEDURE adm-enable-fields :
      989       RETURN.
      990   END PROCEDURE.
      991   PROCEDURE adm-end-update :
      992     RETURN.
      993   END PROCEDURE.
      994   PROCEDURE adm-reset-record :
      995       RETURN.
