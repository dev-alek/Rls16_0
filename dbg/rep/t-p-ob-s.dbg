     1120   PROCEDURE use-initial-lock :
     1121     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1122     ASSIGN adm-initial-lock = p-attr-value.
     1123     RETURN.
     1124   END PROCEDURE.
     1125     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1126   ASSIGN
     1127          FRAME F-Main:SCROLLABLE       = FALSE
     1128          FRAME F-Main:HIDDEN           = TRUE.
     1129   ASSIGN
     1130          Tog-lavel:HIDDEN IN FRAME F-Main           = TRUE.
     1131   ASSIGN
     1132          var-lavel:HIDDEN IN FRAME F-Main           = TRUE.
     1133   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1134   DO:
     1135       Assign Classify.
     1136       if Classify  Begins "prod":U OR
     1137          Classify  Begins "grp-goods":U OR
     1138          Classify  Begins "vat-ps":U
     1139           then
     1140           enable SumsOnly with frame F-Main .
     1141      if Classify = "no-classify":U
     1142         Then do:
     1143               SumsOnly = FALSE .
     1144               display SumsOnly with frame F-Main .
     1145               disable SumsOnly with frame F-Main .
     1146           end.
     1147   END.
     1148   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1149   DO:
     1150      Assign tog-lavel.
     1151     if tog-lavel =TRUE
     1152           Then do:
     1153               display  var-Lavel  with frame F-Main .
     1154               enable   var-Lavel  with frame F-Main .
     1155           end.
     1156            Else do:
     1157               display    var-Lavel with frame F-Main .
     1158               disable    var-Lavel with frame F-Main .
     1159           end.
     1160   END.
     1161   if not this-procedure :persistent
     1162   then do:
     1163     message
     1164       vss-workfile vss-revision vss-description skip
     1165       "Ошибка при запуске процедуры" skip
     1166       "Данную процедуру следует запускать только с параметром persistent" skip
     1167       view-as alert-box error .
     1168     undo, return error .
     1169   end.
     1170   PROCEDURE disable_UI :
     1171     HIDE FRAME F-Main.
     1172     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1173   END PROCEDURE.
     1174   PROCEDURE local-initialize :
     1175     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1176      Tog-obj:screen-value in frame F-Main = 'yes':U.
     1177      var-lavel:screen-value in frame F-Main = '1'.
     1178   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1179   do:
     1180     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1181       (input  v-cntxt-db-num
     1182       ,input  v-cntxt-userid
     1183       ,input  0
     1184       ,input  'actn_reports_lookup-cost':U
     1185       ,input  'object':U
     1186       ,input  v-cntxt-host-code-obj
     1187       ,input  v-cntxt-obj-type
     1188       ,input  v-cntxt-obj-code
     1189       ,input  0
     1190       ,input  0
     1191       ,input  0
     1192       ,input  false
     1193       ,output v-log
     1194       )  .
     1195   end.
     1196    if not v-log then
     1197       disable vat-Cost with frame F-Main.
     1198   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1199   do:
     1200     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1201       (input  v-cntxt-db-num
     1202       ,input  v-cntxt-userid
     1203       ,input  0
     1204       ,input  'actn_reports_lookup-crsa':U
     1205       ,input  'object':U
