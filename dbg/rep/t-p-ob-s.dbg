     1243   PROCEDURE my-report :
     1244   if type-pr:screen-value = "all" then do:
     1245   case SortType :
     1246     when "sort-artic" then do:
     1247       run proc-a in this-procedure .
     1248     end.
     1249     when "sort-code" then do:
     1250       run proc-s in this-procedure .
     1251     end.
     1252     when "sort-name" then do:
     1253       run proc-t in this-procedure .
     1254     end.
     1255   end case.
     1256   end.
     1257   else do:
     1258   case SortType :
     1259     when "sort-artic" then do:
     1260       run proc-r in this-procedure .
     1261     end.
     1262     when "sort-code" then do:
     1263       run proc-c in this-procedure .
     1264     end.
     1265     when "sort-name" then do:
     1266       run proc-n in this-procedure .
     1267     end.
     1268   end case.
     1269   end.
     1270   END PROCEDURE.
     1271   PROCEDURE my-var :
     1272   if VALID-HANDLE(type-pr) = false  then do:
     1273       message "Нет архивов по типу приобретения !!!" skip
     1274       view-as alert-box information .
     1275       return 'First-page':U.
     1276    end.
     1277   assign frame F-Main SumsOnly ShowZero tog-obj ShowZero-2
     1278   tog-lavel var-lavel Classify SortType VAT-Cost VAT-CRSA VAT-sale  .
     1279   v-show-all-goods  = false  .
     1280   if x-SelectObject = "currency":U and tog-obj = false then tog-obj = true .
     1281   Assign
     1282    STR-obj-type = ''
     1283    STR-obj-code = ''
     1284    STR-obj-name = ''
     1285    STR-obj      = ''.
     1286   For each obj-list no-lock:
     1287    Assign
     1288    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1289    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1290    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1291    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1292   End.
     1293   ReportNAme = "О Т Ч Е Т   О   С О С Т О Я Н И И   З А П А С А   И   П Р О Д А Ж А Х   П О   Т И П У   П Р И О Б Р Е Т Е Н И Я - "
     1294                              + Caps ( entry( (lookup(type-pr:screen-value ,type-pr:RADIO-BUTTONS) - 1), type-pr:RADIO-BUTTONS )   )
     1295                              .
     1296   def var t-class as char no-undo.
     1297   def var t-sort as char no-undo.
     1298     case classify:
     1299       when "no-classify":u    then t-class =   "Без классификации" .
     1300       when "prod":u           then t-class =   "Производители"   .
     1301       when "post":u           then t-class =   "Поставщики"   .
     1302       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1303       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1304       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1305       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1306       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1307       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1308       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1309       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1310       when  "t-level":u       then t-class =   "Терминальные группы" .
     1311    end case.
     1312     case sorttype:
     1313       when "sort-pp":u               then t-sort =   "по порядку" .
     1314       when "sort-code":u             then t-sort =   "по коду" .
     1315       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1316       when "sort-qunty":u            then t-sort =   "по реализации".
     1317       when "sort-name":u             then t-sort =   "по наименованию".
     1318       when "sort-type":u             then t-sort =   "по типу ткани".
     1319       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1320       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1321    end case.
     1322   ReportHeader = "Классификация : " + t-Class.
     1323   ReportHeader = ReportHeader +
     1324                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     1325   ReportHeader = ReportHeader  + chr(10).
     1326   ReportHeader = ReportHeader +
     1327                  "Сортировка " + t-Sort + chr(10) +
     1328                  "Показать : " +
     1329                  (if SumsOnly     then "Только итоги, "  else " "            ) +
     1330                  (if Show-Cost    then "Суммы в учетных ценах, "  else " "   ) +
     1331                  (if Show-Crsa    then "Суммы в продажных ценах, "  else " " ) +
     1332                  (if Show-Sale    then "Суммы в продажных ценах документа , "  else " " ) +
     1333                  (if vat-Cost     then "НДС в учетных ценах, "  else " "   ) +
     1334                  (if vat-Crsa     then "НДС в продажных ценах, "  else " " ) +
     1335                  (if vat-Sale     then "НДС в продажных ценах документа , "  else " " ) +
     1336                  (if ShowZero     then " Показывать нулевые остатки "  else " Не показывать нулевые остатки" ) +
     1337                  (if ShowZero-2   then " Показывать нулевые обороты "  else " Не показывать нулевые обороты" ) .
     1338   if type-pr:screen-value = "all" then ReportHeader =  ReportHeader  +    chr(10) + "Итоги по типам приобретения показываются , если типов приобретения больше одного." .
     1339   Sheetf.Excel-Column-Lable = "Код,Артикул,Название товара ,Ед.изм,т/у,Скидка,Остаток на  начало,,,,,,,Приход,,,,,,,Расход,,,,,,,Касса,,,,,,,Инвентаризация|Смена типа приобретения,,,,,,,Переоценка,,,,,,,Остаток на конец,,,,,,,, "  + chr(10).
     1340   Sheetf.Excel-Column-Lable = Excel-Column-Lable + ",,,,,, " +
     1341         Fill ( "кол-во ,учет.сумма ,прод.сумма ,в ценах док-та ,учет.НДС,прод.НДС,НДС в ценах док-та ," , 7) .
     1342   Sheetf.Sizes = "10,16,60,7,3,13," + Fill("13,", 49) .
     1343   Sheetf.make-correct = fill("false,", 55) .
     1344   sheetf.ColFormat = "2=@;3=@;" .
     1345   END PROCEDURE.
     1346   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1347   procedure cr-ob :
     1348    do
     1349    on error undo, return error return-value
     1350    :
     1351   define input parameter p-x as integer no-undo .
     1352   define input parameter p-y as integer no-undo .
     1353   define input parameter type-pr-name as character no-undo .
     1354   define input parameter type-pr-val  as character no-undo .
     1355   define variable l-str as character no-undo .
     1356   define variable i as integer no-undo .
     1357   if type-pr-name = ? then type-pr-name = 'Все,Выкуп,Консигнаци,Консигнация закупка,Консигнация выгода,Ответственное хранение,Старая консигнация':L .
     1358   if type-pr-val  = ?then type-pr-val  = 'all,r,cb,c,b,s,1':U .
     1359   repeat i = 1 to num-entries(type-pr-name) :
     1360    l-str =  l-str  + entry(i ,type-pr-name) + ","  +
     1361                      entry(i ,type-pr-val)  + "," .
     1362   end.
     1363   l-str = substring(l-str,1 , LENGTH (l-str) - 1) .
     1364   if num-entries(l-str) < 2 then do:
     1365       message "Нет архивов по типу приобретения !!!" skip
     1366       vss-include-info16 skip
     1367       view-as alert-box information .
     1368       return 'First-page':U.
     1369      end.
     1370      create radio-set type-pr
     1371      assign
     1372       row    = p-y
