      997   PROCEDURE adm-update-record :
      998       MESSAGE
      999         "Object ":U THIS-PROCEDURE:FILE-NAME
     1000           "must have at least one Enabled Table to perform Update.":U
     1001             VIEW-AS ALERT-BOX ERROR.
     1002      RETURN.
     1003   END PROCEDURE.
     1004   PROCEDURE check-modified :
     1005   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1006   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1007   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1008   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1009     IF check-state = "check":U THEN
     1010     DO:
     1011       RUN get-link-handle IN adm-broker-hdl
     1012         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1013            OUTPUT group-target-list).
     1014       IF group-target-list NE "":U THEN
     1015       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1016         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1017         RUN check-modified IN curr-widget ('group-check':U).
     1018         IF RETURN-VALUE NE "":U THEN
     1019         DO:
     1020           RUN check-modified-message(RETURN-VALUE).
     1021           RETURN "":U.
     1022         END.
     1023       END.
     1024     END.
     1025     RETURN "":U.
     1026   END PROCEDURE.
     1027   PROCEDURE check-modified-message :
     1028     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1029        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1030           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1031        IF RETURN-VALUE = "YES":U THEN
     1032           RUN notify ('view,CONTAINER-SOURCE':U).
     1033        MESSAGE IF p-changed-table NE ? THEN
     1034           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1035           ELSE "Current values have been changed."
     1036           SKIP "  Do you wish to save those changes?"
     1037           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1038        IF ANS THEN
     1039        DO:
     1040           IF group-assign-target THEN
     1041             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1042           ELSE RUN dispatch('update-record':U).
     1043           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1044           DO:
     1045               MESSAGE "Changes to the previous record were not saved."
     1046                 VIEW-AS ALERT-BOX ERROR.
     1047               IF group-assign-target THEN
     1048                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1049               ELSE RUN dispatch ('cancel-record':U).
     1050           END.
     1051        END.
     1052        ELSE DO:
     1053          IF group-assign-target THEN
     1054             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1055          ELSE RUN dispatch('cancel-record':U).
     1056        END.
     1057        RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE get-rowid :
     1060       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1061       ASSIGN
     1062       p-table   =   adm-first-table.
     1063       RETURN.
     1064   END PROCEDURE.
     1065   PROCEDURE init-group-assign :
     1066       RUN request-attribute IN adm-broker-hdl
     1067         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1068       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1069         group-assign-target = yes.
     1070       ELSE group-assign-target = no.
     1071       RETURN.
     1072   END PROCEDURE.
     1073   PROCEDURE set-editors :
     1074       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1075       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1076       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1077       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1078       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1079       DO WHILE VALID-HANDLE (curr-widget):
     1080           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1081              curr-widget:HIDDEN = no THEN DO:
     1082             CASE p-field-setting:
     1083               WHEN "INITIALIZE":U THEN
     1084               DO:
     1085                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1086                     read-only-list +
     1087                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1088                        STRING(curr-widget).
     1089               END.
     1090               WHEN "DISABLE":U OR
     1091               WHEN "ENABLE":U THEN
     1092               DO:
     1093                   curr-widget:SENSITIVE = yes.
     1094                   RUN get-attribute ('Read-Only-Editors':U).
     1095                   IF RETURN-VALUE = ? OR
     1096                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1097                       curr-widget:READ-ONLY =
     1098                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1099               END.
     1100               WHEN "CLEAR":U THEN
     1101                   curr-widget:SCREEN-VALUE = "":U.
     1102             END CASE.
     1103           END.
     1104           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1105       END.
     1106       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1107         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1108           + '"':U).
     1109       RETURN.
     1110   END PROCEDURE.
     1111   PROCEDURE use-check-modified-all :
     1112    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1113     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1114     RETURN.
