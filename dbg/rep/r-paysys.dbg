     5176   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5177   define  stream PrnLibStream.
     5178   procedure prn-lib-prn-file :
     5179     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5180     define input parameter p-DIsabledoptions as integer no-undo .
     5181     define variable v-report-name as character no-undo .
     5182     define variable v-user-action as character no-undo .
     5183     define variable v-printed     as logical   no-undo .
     5184     define variable v-exist       as logical   no-undo .
     5185     do
     5186       on error undo, return error
     5187       :
     5188       run prn-lib-get-report-name  in this-procedure (
     5189         input parParentProc
     5190         ,output v-report-name
     5191         ).
     5192   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     5194     (input  v-report-name
     5195     ,input  2
     5196     ,output v-exist
     5197     )  .
     5198       if NOT v-exist then
     5199       DO:
     5200         Message
     5201           "Нет заданий на печать ! "
     5202           view-as alert-box .
     5203         Return  .
     5204       End.
     5205       run gbl/prnfilen.w
     5206         (input  ""
     5207         ,input  p-DisabledOptions
     5208         ,input  string(v-report-name )
     5209         ,input  7
     5210         ,output v-user-action
     5211         ,output v-printed
     5212         ) .
     5213       if v-printed then
     5214       do:
     5215         return "YES" .
     5216       end.
     5217       else
     5218       do:
     5219         return "NO" .
     5220       end.
     5221     end.
     5222   end procedure.
     5223   procedure prn-lib-open-stream :
     5224     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5225     define input parameter p-page-size    as integer no-undo .
     5226     define input parameter p-is-stream    as logical no-undo .
     5227     define input parameter p-append       as logical no-undo .
     5228     define variable v-report-name as character no-undo .
     5229     do
     5230       on error undo, return error
     5231       :
     5232       run prn-lib-get-report-name  in this-procedure (
     5233         input parParentProc
     5234         ,output v-report-name
     5235         ).
     5236       if p-is-stream then
     5237       do:
     5238         if p-append then
     5239         do:
     5240           output stream PrnLibStream to value( v-report-name )
     5241             page-size value(p-page-size) append .
     5242         end.
     5243         if not p-append then
     5244         do:
     5245           output stream PrnLibStream to value( v-report-name )
     5246             page-size value(p-page-size) .
     5247         end.
     5248       end.
     5249       if not p-is-stream then
     5250       do:
     5251         if p-append then
     5252         do:
     5253           output to value( v-report-name )
     5254             page-size value(p-page-size) append .
     5255         end.
     5256         if not p-append then
     5257         do:
     5258           output to value( v-report-name )
     5259             page-size value(p-page-size) .
     5260         end.
     5261       end.
     5262     end.
     5263   end procedure.
     5264   procedure prn-lib-open-exp :
     5265     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5266     define input parameter p-is-stream    as logical no-undo .
     5267     define input parameter p-is-append    as logical no-undo .
     5268     define output parameter p-ReportFileName as char init "report" no-undo.
     5269     define output parameter p-process as logical no-undo .
     5270     define variable glog as logical no-undo .
     5271     do
     5272       on error undo, return error
     5273       :
     5274       SYSTEM-DIALOG GET-FILE p-ReportFileName
     5275         TITLE      "Укажите путь"
     5276         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     5277         ASK-OVERWRITE
     5278         CREATE-TEST-FILE
     5279         SAVE-AS
     5280         USE-FILENAME
     5281         DEFAULT-EXTENSION "txt"
     5282         UPDATE glog
     5283         .
     5284       if not glog then  return.
     5285       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     5286       if p-is-stream then
     5287       do:
     5288         if p-is-append then
     5289         do:
     5290           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5291         end.
     5292         else
     5293         do:
     5294           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5295         end.
     5296       end.
     5297       else
     5298       do:
     5299         if p-is-append then
     5300         do:
     5301           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5302         end.
     5303         else
     5304         do:
     5305           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5306         end.
     5307       end.
     5308       p-process = yes.
     5309     end.
     5310   end procedure.
     5311   procedure prn-lib-get-report-name :
     5312     define input parameter parParentProc  as widget-handle no-undo.
     5313     define output parameter p-report-name as character no-undo .
     5314     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     5315   end procedure.
     5316   procedure prn-lib-reportviewer-report-name :
     5317     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5318     define input parameter p-report-name-html as character no-undo .
     5319     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     5320   end procedure.
     5321   procedure prn-lib-reportviewer :
     5322     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5323     define input parameter p-report-name-html as character no-undo .
     5324     define input parameter p-param        as character no-undo .
     5325     define variable v-excel           as character no-undo init 'TRUE' .
     5326     define variable v-value-character as character no-undo .
     5327     define variable v-value-integer   as character no-undo .
     5328     define variable v-value-date      as date      no-undo .
     5329     define variable v-value-decimal   as decimal   no-undo .
     5330     define variable rep-excel         as logical   no-undo .
     5331     define variable excel-string      as character no-undo .
     5332     define variable v-param-type      as character no-undo .
     5333     define variable v-tth             as handle    no-undo .
     5334     run adm/shattri.p (
     5335       input "get":U
     5336       ,input  ""
     5337       ,input  0
     5338       ,input  'report-glob':U
     5339       ,input  'rep-excel':U
     5340       ,output v-value-character
     5341       ,output v-value-date
     5342       ,output v-value-decimal
     5343       ,output v-value-integer
     5344       ,output rep-excel
     5345       ,output v-param-type
     5346       ,INPUT-OUTPUT table-handle v-tth
     5347       )  .
     5348     if rep-excel then v-excel = "TRUE" .
     5349     else v-excel = "FALSE" .
     5350     if p-param eq ""
     5351     then
     5352        p-param = "EXCEL:" + v-excel.
     5353     else
     5354        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     5355     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     5356   end procedure.
     5357   function fnc-convert-dot-to-colon returns character
     5358       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     5359   function fnc-convert-dot-to-colon returns character
     5360   (input p-data as decimal, input p-accur as character, input p-num as integer):
     5361       define variable result as character no-undo.
     5362       define variable v-str-result as character no-undo.
     5363       if p-data = ? then p-data = 0 .
     5364       p-data = round(p-data, p-num).
     5365       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     5366       return v-str-result.
     5367   END FUNCTION.
     5368   function MinInt returns integer
     5369     (input p-code as integer):
     5370     define variable result as integer no-undo.
     5371     define variable kk     as integer no-undo .
     5372     if length (string(p-code)) < 6 then
     5373     do:
     5374       do kk = length(string(p-code)) to 6:
     5375         result = integer (string (p-code) + "0") .
     5376       end .
     5377     end.
     5378     else
     5379       result = p-code .
     5380     return result.
     5381   end function.
     5382   function MaxInt returns integer
     5383     (input p-code as integer):
     5384     define variable result as integer no-undo.
     5385     define variable kk     as integer no-undo .
     5386     if length (string(p-code)) < 6 then
     5387     do:
     5388       do kk = length(string(p-code)) to 6:
     5389         result = integer (string (p-code) + "9") .
     5390       end .
     5391     end.
     5392     else
     5393       result = p-code .
     5394     return result.
     5395   end function.
     5396   DEFINE TEMP-TABLE tt-promo-bin NO-UNDO
     5397     field idAction as integer
     5398     field min_bin  as integer
     5399     field max_bin  as integer
     5400     field idName   as character
     5401     INDEX pi idAction .
     5402   DEFINE TEMP-TABLE tt-code NO-UNDO
     5403     field min_code as integer
     5404     field max_code as integer
     5405     field CodeName as character
     5406     INDEX pi CodeName .
     5407   DEFINE TEMP-TABLE tt-cash-pay like ub.cash-pay-attr
     5408     field obj-name as character .
     5409   DEFINE TEMP-TABLE tt-pay-sys NO-UNDO
     5410     field pay-name   as character
     5411     field pay-second as character
     5412     field pay-qnty   as decimal
     5413     field pay-sum    as decimal
     5414     INDEX pi pay-name.
     5415   define temp-table tt-doc-code no-undo
     5416     field doc-code as character
     5417     field log1     as logical
     5418     field log2     as logical
     5419     field log3     as logical
     5420     .
     5421   define stream Out-Stream.
     5422   define stream OutStr-html.
     5423   DEFINE STREAM instream.
     5424   define VARIABLE p-report-id         as character no-undo .
     5425   define variable v-file-name-rep-htm as character no-undo .
     5426   define VARIABLE v-attr-value        as character no-undo .
     5427   define variable v-obj-type          as character no-undo .
     5428   define variable v-obj-code          as integer   no-undo .
     5429   define variable v-obj-name          as character no-undo .
     5430   define variable v-period            as character no-undo .
     5431   define variable v-list-obj          as character no-undo .
     5432   define variable v-print-date        as character no-undo .
     5433   define variable v-itog-tran         as integer   no-undo .
     5434   define variable v-itog-sum          as decimal   no-undo .
     5435   define variable v-path              as character no-undo .
     5436   DEFINE VARIABLE v-full-path         as character no-undo .
     5437   DEFINE VARIABLE v-file-name         as character no-undo .
     5438   DEFINE VARIABLE v-file-name-no-ext  as character no-undo .
     5439   DEFINE VARIABLE v-file-name-ext     as character no-undo .
     5440   define variable ii                  as integer   no-undo .
     5441   define variable jj                  as integer   no-undo .
     5442   define variable kk                  as integer   no-undo .
     5443   define variable v-pay-sys           as character no-undo .
     5444   define variable v-pay-name          as character no-undo .
     5445   DEFINE variable text-string         as char      no-undo.
     5446   define variable v-payname           as character no-undo .
     5447   define variable v-nameAction        as character no-undo .
     5448   define buffer buf_chk-doc       for ub.chk-doc .
     5449   define buffer buf_chk-pay       for ub.chk-pay .
     5450   define buffer bf_chk-pay        for ub.chk-pay .
     5451   define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     5452   define buffer buf_tt-code       for tt-code .
     5453   define buffer buf_tt-promo-bin  for tt-promo-bin .
     5454   define buffer buf_pay-sys       for tt-pay-sys .
     5455   define buffer buf_chk-discnt    for ub.chk-discnt .
     5456   define buffer buf_tt-promo      for tt-promo .
     5457   define buffer buf_clients       for ub.clients .
     5458   define buffer buf_code          for ub.code.
     5459   define buffer buf_PromoGoods    for ub.PromoGoods .
     5460   do
     5461     on error undo, return error return-value
     5462     :
     5463     find first obj-list no-error .
     5464     if not available obj-list then
     5465     do:
     5466       message
     5467         "Не указан объект для формирования отчета!"
     5468         view-as alert-box error.
     5469       undo, return error.
     5470     end.
     5471   end.
     5472   empty temp-table tt-code .
     5473   empty temp-table tt-promo-bin .
     5474   empty temp-table tt-pay-sys .
     5475   empty temp-table tt-cash-pay .
     5476   v-itog-sum = 0 .
     5477   v-itog-tran = 0 .
     5478   for each buf_code no-lock where buf_code.status_ = 0:
     5479     if num-entries (buf_code.parent,chr(4)) > 1 and entry(1,buf_code.parent,chr(4)) = "platsys" then
     5480     do:
     5481       if num-entries (buf_code.code,",") > 1 then
     5482       do:
     5483         do jj = 1 to num-entries (buf_code.code,","):
     5484           v-pay-sys = entry(jj,buf_code.code) .
     5485           if num-entries (v-pay-sys,"-") > 1 then
     5486           do:
     5487             create tt-code .
     5488             assign
     5489               tt-code.min_code = MinInt(integer(entry(1,v-pay-sys,"-")))
     5490               tt-code.max_code = MaxInt(integer(entry(2,v-pay-sys,"-")))
     5491               tt-code.CodeName = buf_code.CodeName
     5492               .
     5493           end.
     5494           else
     5495           do:
     5496             create tt-code .
     5497             assign
     5498               tt-code.min_code = MinInt(integer(v-pay-sys))
     5499               tt-code.max_code = MaxInt(integer(v-pay-sys))
     5500               tt-code.CodeName = buf_code.CodeName
     5501               .
     5502           end.
     5503         end.
     5504       end.
     5505       else
     5506       do:
     5507         if num-entries (buf_code.code,"-") > 1 then
     5508         do:
     5509           create tt-code .
     5510           assign
     5511             tt-code.min_code = MinInt(integer(entry(1,buf_code.code,"-")))
     5512             tt-code.max_code = MaxInt(integer(entry(2,buf_code.code,"-")))
     5513             tt-code.CodeName = buf_code.CodeName
     5514             .
     5515         end.
     5516         else
     5517         do:
     5518           create tt-code .
     5519           assign
     5520             tt-code.min_code = MinInt(integer(buf_code.code))
     5521             tt-code.max_code = MaxInt(integer(buf_code.code))
     5522             tt-code.CodeName = buf_code.CodeName
     5523             .
     5524         end.
     5525       end.
     5526     end.
     5527   end.
     5528   for each buf_tt-promo no-lock where buf_tt-promo.end-date >= x-Date-Start and buf_tt-promo.beg-date <= x-Date-End:
     5529     v-nameAction = buf_tt-promo.nameAction .
     5530     for each buf_PromoGoods no-lock where buf_PromoGoods.type = 5 and buf_PromoGoods.idAction = buf_tt-promo.id and buf_PromoGoods.db-num = buf_tt-promo.db-num:
     5531       if num-entries (buf_PromoGoods.NameSet,"-") > 1 then
     5532       do:
     5533         create tt-promo-bin .
     5534         assign
     5535           tt-promo-bin.min_bin  = MinInt(integer(entry(1,buf_PromoGoods.NameSet,"-")))
     5536           tt-promo-bin.max_bin  = MaxInt(integer(entry(2,buf_PromoGoods.NameSet,"-")))
     5537           tt-promo-bin.idAction = buf_PromoGoods.idAction
     5538           tt-promo-bin.idName   = v-nameAction
     5539           .
     5540       end.
     5541       else
     5542       do:
     5543         create tt-promo-bin .
     5544         assign
     5545           tt-promo-bin.min_bin  = MinInt(integer(buf_PromoGoods.NameSet))
     5546           tt-promo-bin.max_bin  = MaxInt(integer(buf_PromoGoods.NameSet))
     5547           tt-promo-bin.idAction = buf_PromoGoods.idAction
     5548           tt-promo-bin.idName   = v-nameAction
     5549           .
     5550       end.
     5551     end.
     5552   end.
     5553   DEFINE VARIABLE v-dop   AS character NO-UNDO .
     5554   DEFINE VARIABLE v-value AS character NO-UNDO.
     5555   DEFINE VARIABLE v-type  AS character NO-UNDO.
     5556   for each buf_cash-pay-attr no-lock where buf_cash-pay-attr.attr-code = "cash-prop"
     5557     and buf_cash-pay-attr.attr-value = "2",
     5558     first ub.cash-pay no-lock where ub.cash-pay.cdpay-code = buf_cash-pay-attr.cdpay-code and ub.cash-pay.curr-code = buf_cash-pay-attr.curr-code:
     5559     create tt-cash-pay .
     5560     buffer-copy buf_cash-pay-attr to tt-cash-pay .
     5561     tt-cash-pay.obj-name = ub.cash-pay.obj-name .
     5562   end.
     5563   if x-TOG-Shift then
     5564   do:
     5565     v-period = "Смены с " + string (x-Shift-Start) + " по " + string (x-Shift-End) + " За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5566   end.
     5567   else
     5568   do:
     5569     v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5570   end.
     5571   run clients-write(INPUT v-cntxt-host-code-obj, INPUT 'орг':U, OUTPUT v-obj-name) no-error .
     5572   DEFINE VARIABLE v-today as date    no-undo .
     5573   DEFINE VARIABLE v-time  as integer no-undo .
     5574   run cur-time in this-procedure (
     5575     output v-today
     5576     , output v-time
     5577     ).
     5578   v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     5579   for each obj-list no-lock:
     5580     if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     5581     else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     5582     if x-TOG-Shift then
     5583     do:
     5584       for each buf_chk-doc no-lock
     5585         where buf_chk-doc.obj-code = obj-list.obj-code
     5586         and buf_chk-doc.obj-type = obj-list.obj-type
     5587         and buf_chk-doc.shift-date >= x-Date-Start
     5588         and buf_chk-doc.shift-date <= x-Date-End
     5589         and buf_chk-doc.chk-type = integer('1':U)
     5590         and buf_chk-doc.out-code <> ?:
     5591         if (buf_chk-doc.shift-date = X-date-Start)
     5592           and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     5593         if (buf_chk-doc.shift-date = X-date-End)
     5594           and (buf_chk-doc.shift-num > x-Shift-End) then next.
     5595         run report .
     5596       end.
     5597     end.
     5598     else
     5599     do:
     5600       for each buf_chk-doc no-lock
     5601         where buf_chk-doc.obj-code = obj-list.obj-code
     5602         and buf_chk-doc.obj-type = obj-list.obj-type
     5603         and buf_chk-doc.chk-date >= x-Date-Start
     5604         and buf_chk-doc.chk-date <= x-Date-End
     5605         and buf_chk-doc.chk-type = integer('1':U)
     5606         and buf_chk-doc.out-code <> ?:
     5607         run report .
     5608       end.
     5609     end.
     5610   end.
     5611   procedure report:
     5612     for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code,
     5613       first tt-cash-pay no-lock where tt-cash-pay.curr-code = buf_chk-pay.curr-code and tt-cash-pay.cdpay-code = buf_chk-pay.pay-code:
     5614       find first tt-doc-code no-lock where tt-doc-code.doc-code = buf_chk-pay.doc-code no-error .
     5615       if not available (tt-doc-code) then
     5616       do:
     5617         create tt-doc-code .
     5618         assign
     5619           tt-doc-code.doc-code = buf_chk-pay.doc-code
     5620           .
     5621       end.
     5622       find first buf_tt-code no-lock where substring (buf_chk-pay.pay-card,1,6) >= string (buf_tt-code.min_code) and substring (buf_chk-pay.pay-card,1,6) <= string (buf_tt-code.max_code) no-error .
     5623       if available (buf_tt-code) then
     5624       do:
     5625         v-pay-name = buf_tt-code.CodeName .
     5626       end.
     5627       else v-pay-name = "Прочие" .
     5628       find first buf_pay-sys exclusive-lock where buf_pay-sys.pay-name = v-pay-name no-error .
     5629       if not available (buf_pay-sys) then
     5630       do:
     5631         create buf_pay-sys .
     5632         assign
     5633           buf_pay-sys.pay-second = v-pay-name
     5634           buf_pay-sys.pay-name   = v-pay-name
     5635           buf_pay-sys.pay-qnty   = 1
     5636           buf_pay-sys.pay-sum    = buf_chk-pay.tot-sum
     5637           .
     5638         tt-doc-code.log1 = yes.
     5639       end.
     5640       else
     5641       do:
     5642         assign
     5643           buf_pay-sys.pay-sum = buf_pay-sys.pay-sum + buf_chk-pay.tot-sum
     5644           .
     5645         if tt-doc-code.log1 = no then buf_pay-sys.pay-qnty = buf_pay-sys.pay-qnty + 1 .
     5646         tt-doc-code.log1 = yes .
     5647       end.
     5648       for first buf_tt-promo-bin no-lock where substring (buf_chk-pay.pay-card,1,6) >= string (buf_tt-promo-bin.min_bin) and substring (buf_chk-pay.pay-card,1,6) >= string (buf_tt-promo-bin.max_bin):
     5649         find first buf_pay-sys exclusive-lock where buf_pay-sys.pay-name = "Премиальные карты " + v-pay-name no-error .
     5650         if available (buf_pay-sys) then
     5651         do:
     5652           assign
     5653             buf_pay-sys.pay-sum = buf_pay-sys.pay-sum + buf_chk-pay.tot-sum
     5654             .
     5655           if tt-doc-code.log2 = no then buf_pay-sys.pay-qnty = buf_pay-sys.pay-qnty + 1 .
     5656           tt-doc-code.log2 = yes .
     5657         end.
     5658         else
     5659         do:
     5660           create buf_pay-sys .
     5661           assign
     5662             buf_pay-sys.pay-second = v-pay-name
     5663             buf_pay-sys.pay-name   = "Премиальные карты " + v-pay-name
     5664             buf_pay-sys.pay-qnty   = 1
     5665             buf_pay-sys.pay-sum    = buf_chk-pay.tot-sum
     5666             .
     5667           tt-doc-code.log2 = yes .
     5668         end.
     5669         for each buf_chk-discnt no-lock where buf_chk-discnt.doc-code = buf_chk-doc.doc-code and buf_chk-discnt.promo-id = string(tt-promo-bin.idAction) and buf_chk-discnt.record-type = 0 :
     5670           find first buf_pay-sys exclusive-lock where buf_pay-sys.pay-name = tt-promo-bin.idName and buf_pay-sys.pay-second = v-pay-name no-error .
     5671           if available (buf_pay-sys) then
     5672           do:
     5673             assign
     5674               buf_pay-sys.pay-sum = buf_pay-sys.pay-sum + buf_chk-pay.tot-sum
     5675               .
     5676             if tt-doc-code.log3 = no then buf_pay-sys.pay-qnty = buf_pay-sys.pay-qnty + 1 .
     5677             tt-doc-code.log3 = yes .
     5678           end.
     5679           else
     5680           do:
     5681             create buf_pay-sys .
     5682             assign
     5683               buf_pay-sys.pay-second = v-pay-name
     5684               buf_pay-sys.pay-name   = tt-promo-bin.idName
     5685               buf_pay-sys.pay-qnty   = 1
     5686               buf_pay-sys.pay-sum    = buf_chk-pay.tot-sum
     5687               .
     5688           end.
     5689           for each bf_chk-pay no-lock where bf_chk-pay.doc-code = buf_chk-pay.doc-code and bf_chk-pay.tot-sum < 0 :
     5690             buf_pay-sys.pay-sum = buf_pay-sys.pay-sum + bf_chk-pay.tot-sum .
     5691           end.
     5692         end.
     5693       end.
     5694     end.
     5695   end procedure.
     5696   run get-report-num (output p-report-id).
     5697   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     5698   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     5699   put stream OutStr-html unformatted
     5700     "<!DOCTYPE HTML>" skip
     5701     ' <html>' skip
     5702     '  <head>' skip
     5703     '   <meta charset="utf-8">' skip
     5704     '    <style type="text/css">' skip
     5705     '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5706     '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5707     '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     5708     '   </style>' skip
     5709     '  </head>' skip
     5710     .
     5711   put stream OutStr-html unformatted
     5712     '<body>' skip
     5713     '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     5714     '<thead>' skip
     5715     .
     5716   put stream OutStr-html unformatted
     5717     '<tr>' skip
     5718     '<td style="width: 100px;"></td>' skip
     5719     '<td style="width: 260px;"></td>' skip
     5720     '<td style="width: 120px;"></td>' skip
     5721     '<td style="width: 160px;"></td>' skip
     5722     '</tr>' skip
     5723     .
     5724   put stream OutStr-html unformatted
     5725     '<TR><TD colspan="4"></TD></TR>' skip
     5726     '<TR>' skip
     5727     '<TD colspan="4" style="font-weight: bold;">Отчет по платежным системам</TD>' skip
     5728     '</TR>'skip
     5729     '<TR>' skip
     5730     '<TD colspan="4">' + v-period + '</TD>' skip
     5731     '</TR>'skip
     5732     '<TR>' skip
     5733     '<TD colspan="4">' + v-obj-name + '</TD>' skip
     5734     '</TR>'skip
     5735     '<TR>' skip
     5736     '<TD colspan="4">Выбор объекта:</TD>' skip
     5737     '</TR>'skip
     5738     '<TR>' skip
     5739     '<TD colspan="4">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     5740     '</TR>'skip
     5741     '<TR>' skip
     5742     '<TD colspan="4">' + v-print-date + '</TD>' skip
     5743     '</TR>'skip
     5744     '</thead>' skip
     5745     '<tbody>' skip
     5746     .
     5747   put stream OutStr-html unformatted
     5748     '<TR>' skip
     5749     '<TD text_wrap="true" style="text-align: center;">Внутренний код платежной системы</TD>' skip
     5750     '<TD text_wrap="true" style="text-align: center;">Название платежной системы</TD>' skip
     5751     '<TD text_wrap="true" style="text-align: center;">Количество транзакций</TD>' skip
     5752     '<TD text_wrap="true" style="text-align: center;">Сумма оплаты</TD>' skip
     5753     '</TR>'skip
     5754     .
     5755   ii = 0 .
     5756   for each buf_pay-sys where buf_pay-sys.pay-name = buf_pay-sys.pay-second:
     5757     ii = ii + 1 .
     5758     kk = 0 .
     5759     put stream OutStr-html unformatted
     5760       '<TR>' skip
     5761       '<TD text_wrap="true" style="text-align: center;">' + string(ii) + '</TD>' skip
     5762       '<TD text_wrap="true">' + string(buf_pay-sys.pay-name) + '</TD>' skip
     5763       '<TD text_wrap="true" style="text-align: right;">' + string(buf_pay-sys.pay-qnty) + '</TD>' skip
     5764       '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_pay-sys.pay-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_pay-sys.pay-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5765       '</TR>'skip
     5766       .
     5767     v-itog-sum = v-itog-sum + buf_pay-sys.pay-sum .
     5768     v-itog-tran = v-itog-tran + buf_pay-sys.pay-qnty .
     5769     v-pay-name = "" .
     5770     for first tt-pay-sys where tt-pay-sys.pay-second = buf_pay-sys.pay-name and tt-pay-sys.pay-second <> tt-pay-sys.pay-name and tt-pay-sys.pay-name begins "Премиальные":
     5771       v-payname = tt-pay-sys.pay-name .
     5772       put stream OutStr-html unformatted
     5773         '<TR>' skip
     5774         '<TD text_wrap="true" style="text-align: right;">в том числе</TD>' skip
     5775         '<TD text_wrap="true">' + "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;" + string(tt-pay-sys.pay-name) + '</TD>' skip
     5776         '<TD text_wrap="true" style="text-align: right;">' + string(tt-pay-sys.pay-qnty) + '</TD>' skip
     5777         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-pay-sys.pay-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt-pay-sys.pay-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5778         '</TR>'skip
     5779         .
     5780     end.
     5781     for each tt-pay-sys where tt-pay-sys.pay-second = buf_pay-sys.pay-name and tt-pay-sys.pay-second <> tt-pay-sys.pay-name and tt-pay-sys.pay-name <> v-payname:
     5782       put stream OutStr-html unformatted
     5783         '<TR>' skip
     5784         '<TD text_wrap="true" style="text-align: right;"></TD>' skip
     5785         '<TD text_wrap="true">' + "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;" + string(tt-pay-sys.pay-name) + '</TD>' skip
     5786         '<TD text_wrap="true" style="text-align: right;">' + string(tt-pay-sys.pay-qnty) + '</TD>' skip
     5787         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(tt-pay-sys.pay-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(tt-pay-sys.pay-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5788         '</TR>'skip
     5789         .
     5790     end.
     5791   end.
     5792   put stream OutStr-html unformatted
     5793     '<TR>' skip
     5794     '<TD colspan="2" text_wrap="true" style="text-align: center; font-weight: bold;">Итого по банковским картам:</TD>' skip
     5795     '<TD text_wrap="true" style="text-align: right;">' + string (v-itog-tran) + '</TD>' skip
     5796     '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-itog-sum,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon (v-itog-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5797     '</TR>'skip
     5798     .
     5799   put stream OutStr-html unformatted
     5800     '</table>' skip
     5801     '</body>' skip
     5802     '</html>' skip
     5803     .
     5804   output stream OutStr-html close.
     5805   run prn-lib-reportviewer-report-name in this-procedure (
     5806     input THIS-PROCEDURE
     5807     ,input v-file-name-rep-htm
     5808     ).
     5809   PROCEDURE get-report-num :
     5810     define output parameter p-report-num as integer no-undo .
     5811     do
     5812       on error undo, return error return-value
     5813       :
     5814       run gbl/getrpnum.p (output p-report-num).
     5815     end.
     5816   END PROCEDURE.
     5817   procedure clients-write:
     5818     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     5819     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     5820     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     5821     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     5822       and buf_clients.obj-type = p-obj-type no-error .
     5823     if AVAILABLE buf_clients then
     5824     do:
     5825       p-obj-name = buf_clients.obj-name .
     5826     end.
     5827   end.
