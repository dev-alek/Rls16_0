     2378   procedure torgconf-get-sup-param :
     2379   define input parameter p-obj-type           as character        no-undo.
     2380   define input parameter p-obj-code           as integer          no-undo.
     2381   define input parameter p-curr-code          as integer          no-undo.
     2382       define variable v-host-code    as integer      no-undo.
     2383       define variable v-par-type     as character    no-undo.
     2384   do
     2385   on error undo, return error
     2386   :
     2387       assign
     2388          v-torgconf-sup-host-code = v-host-code
     2389       .
     2390       if v-torgconf-sup-host-code = 0
     2391       then do:
     2392           assign
     2393               v-torgconf-sup-host-name           = "":U
     2394               v-torgconf-sup-host-addres         = "":U
     2395               v-torgconf-sup-host-post-addres    = "":U
     2396               v-torgconf-sup-host-phone          = "":U
     2397               v-torgconf-sup-host-inn            = "":U
     2398               v-torgconf-sup-host-kpp            = "":U
     2399               v-torgconf-sup-host-okpo           = "":U
     2400               v-torgconf-sup-host-egrip-date     = "":U
     2401               v-torgconf-sup-host-egrip-num      = "":U
     2402           .
     2403       end.
     2404       else do:
     2405           run fmtcli-get-client in this-procedure (
     2406                 input 'орг':U
     2407               , input v-torgconf-sup-host-code
     2408           ).
     2409           assign
     2410               v-torgconf-sup-host-name        = v-fmtcli-name
     2411               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2412               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2413               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2414               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2415               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2416               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2417               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2418           .
     2419           run gbl/clntat-v.p (
     2420                 input 'орг':U
     2421               , input v-torgconf-sup-host-code
     2422               , input 'egrip-date':U
     2423               , output v-torgconf-sup-host-egrip-date
     2424               , output v-par-type
     2425           ).
     2426           run gbl/clntat-v.p (
     2427                 input 'орг':U
     2428               , input v-torgconf-sup-host-code
     2429               , input 'egrip-num':U
     2430               , output v-torgconf-sup-host-egrip-num
     2431               , output v-par-type
     2432           ).
     2433           run fmtcli-get-bank in this-procedure (
     2434                 input v-host-code
     2435               , input 'орг':U
     2436               , input v-torgconf-sup-host-code
     2437               , input p-curr-code
     2438           ).
     2439       end.
     2440       assign
     2441           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2442           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2443           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2444           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2445           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2446           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2447           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2448           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2449       .
     2450       assign
     2451           v-torgconf-sup-obj-type = p-obj-type
     2452           v-torgconf-sup-obj-code = p-obj-code
     2453       .
     2454       if trim(p-obj-type) <> ""
     2455       and p-obj-code <> 0
     2456       then do:
     2457       run fmtcli-get-client in this-procedure (
     2458             input p-obj-type
     2459           , input p-obj-code
     2460       ).
     2461       assign
     2462           v-torgconf-sup-obj-name        = v-fmtcli-name
     2463           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2464           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2465           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2466           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2467           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2468           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2469       .
     2470      end.
     2471      end.
     2472   end procedure.
     2473   procedure torgconf-get-cli-param :
     2474   define input parameter p-host-obj-code      as integer          no-undo.
     2475   define input parameter p-obj-type           as character        no-undo.
     2476   define input parameter p-obj-code           as integer          no-undo.
     2477   define input parameter p-curr-code          as integer          no-undo.
     2478       define variable v-host-code    as integer      no-undo.
     2479   do
     2480   on error undo, return error
