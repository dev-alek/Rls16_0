     2056                 input p-obj-type
     2057               , input p-obj-code
     2058               , output v-torgconf-self-host-code
     2059           ).
     2060           if v-torgconf-self-host-code = 0
     2061           then do:
     2062               return error.
     2063           end.
     2064       end.
     2065       else do:
     2066           assign
