     2116               , input v-torgconf-self-host-code
     2117               , input p-curr-code
     2118           ).
     2119       end.
     2120       assign
     2121           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     2122           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     2123           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
