     2499       .
     2500      run fmtcli-get-bank in this-procedure (
     2501             input p-host-obj-code
     2502           , input p-obj-type
     2503           , input p-obj-code
     2504           , input p-curr-code
     2505       ).
     2506       assign
     2507           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2508           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2509           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2510           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2511           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2512           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2513           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2514           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2515       .
     2516   end.
     2517   end procedure.
     2518   procedure torgconf-get-ship-param :
     2519   define input parameter p-host-obj-code      as integer          no-undo.
     2520   define input parameter p-obj-type           as character        no-undo.
     2521   define input parameter p-obj-code           as integer          no-undo.
     2522   define input parameter p-curr-code          as integer          no-undo.
     2523       define variable v-host-code    as integer      no-undo.
     2524   do
     2525   on error undo, return error
     2526   :
     2527       assign
     2528           v-torgconf-ship-type = p-obj-type
     2529           v-torgconf-ship-code = p-obj-code
     2530       .
     2531       if trim(p-obj-type) = ""
     2532       and p-obj-code = 0
     2533       then do:
     2534       assign
     2535           v-torgconf-ship-name         = "":U
     2536           v-torgconf-ship-addres       = "":U
     2537           v-torgconf-ship-post-addres  = "":U
     2538           v-torgconf-ship-phone        = "":U
     2539           v-torgconf-ship-inn          = "":U
     2540           v-torgconf-ship-kpp          = "":U
     2541           v-torgconf-ship-okpo         = "":U
     2542       .
     2543       end.
     2544       else do:
     2545       run fmtcli-get-client in this-procedure (
     2546             input p-obj-type
     2547           , input p-obj-code
     2548       ).
     2549       assign
     2550           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2551           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2552           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2553           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2554           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2555           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2556           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2557           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2558       .
     2559       end.
     2560           run fmtcli-get-bank in this-procedure (
     2561             input p-host-obj-code
     2562           , input p-obj-type
     2563           , input p-obj-code
     2564           , input p-curr-code
     2565       ).
     2566       assign
     2567           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2568           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2569           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2570           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2571           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2572           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2573           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2574           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2575       .
     2576   end.
     2577   end procedure.
     2578   procedure torgconf-get-holdfirm-code :
     2579   define input parameter p-obj-type   as character        no-undo.
     2580   define input parameter p-obj-code   as integer          no-undo.
     2581   define output parameter p-firm-code as integer          no-undo.
     2582       define variable v-firm-code-str     as character    no-undo.
     2583       define variable v-par-type          as character    no-undo.
     2584       define buffer buf_clients       for ub.clients.
     2585   do
     2586   for buf_clients
     2587   on error undo, return error
     2588   :
     2589       run gbl/clntat-v.p (
     2590             input p-obj-type
     2591           , input p-obj-code
     2592           , input 'holdfirm-code':U
     2593           , output v-firm-code-str
     2594           , output v-par-type
     2595       ).
     2596       assign
     2597           p-firm-code = integer( v-firm-code-str )
     2598       no-error.
     2599       if error-status :error
     2600       then do:
     2601           message
     2602               "Неверно задан код фирмы для печати накладных."
     2603           view-as alert-box warning.
     2604           assign
     2605               p-firm-code = 0
     2606           .
     2607       end.
     2608       else do:
     2609           find first buf_clients no-lock
     2610                where buf_clients.obj-type = 'орг':U
     2611                  and buf_clients.obj-code = p-firm-code
     2612           no-error.
     2613           if not available buf_clients
     2614           then do:
     2615               message
     2616                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2617                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2618               view-as alert-box warning.
     2619               assign
     2620                   p-firm-code = 0
     2621               .
     2622           end.
     2623       end.
     2624   end.
     2625   end procedure.
     2626   procedure torgconf-get-post-head:
     2627   define input  parameter p-obj-type             as character        no-undo.
     2628   define input  parameter p-obj-code             as integer          no-undo.
     2629   define output parameter p-torgconf-post-head   as character        no-undo.
     2630      define variable v-host-code         as integer      no-undo.
     2631      define buffer buf_sysconf     for ub.sysconf.
     2632        assign
     2633         p-torgconf-post-head  = ""
     2634        .
     2635   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2636   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2637     (input  p-obj-type
     2638     ,input  p-obj-code
     2639     ,output v-host-code
     2640     )  .
     2641      find first buf_sysconf no-lock
     2642      where buf_sysconf.host-code = v-host-code
     2643      no-error.
     2644      if available buf_sysconf
     2645      then do:
     2646         assign
     2647            p-torgconf-post-head = buf_sysconf.head-position
     2648         .
     2649      end.
     2650   end procedure.
     2651   procedure torgconf-get-storekeeper:
     2652   define input  parameter p-wrkr                   as integer          no-undo.
     2653   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2654   define output parameter p-torgconf-post          as character        no-undo.
     2655      define buffer buf_sysconf     for ub.sysconf.
     2656      define buffer buf_person      for ub.person.
     2657      define buffer buf_shop        for ub.shop .
     2658      define buffer buf_store       for ub.store .
     2659      if v-torgconf-outC = "no_print"
     2660      then do:
     2661         assign p-torgconf-post = ""
     2662                p-torgconf-wrkr-name = ""
     2663                .
     2664      end.
     2665      if v-torgconf-outC = "clad_doc"
     2666      then do:
     2667         run rep/get-psn.p
     2668               (input  p-wrkr
     2669               ,output p-torgconf-wrkr-name
     2670               ) .
     2671         find first buf_person no-lock
     2672         where buf_person.psn-code = p-wrkr
     2673         no-error.
     2674         if available buf_person
     2675         then do:
     2676           p-torgconf-post = buf_person.position.
     2677         end.
     2678         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2679         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2680      end.
     2681      if v-torgconf-outC = "clad_obj"
     2682      then do:
     2683         CASE v-torgconf-self-obj-type:
     2684         WHEN 'маг':U
     2685         THEN DO:
     2686            find first buf_shop no-lock
     2687            where buf_shop.obj-code = v-torgconf-self-obj-code
     2688            .
     2689            assign
     2690               p-torgconf-wrkr-name = buf_shop.store-man
     2691               p-torgconf-post = ""
     2692            .
     2693            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2694         END.
     2695         WHEN 'скл':U
     2696         THEN DO:
     2697            find first buf_store no-lock
     2698            where buf_store.obj-code = v-torgconf-self-obj-code
     2699            .
     2700            assign
     2701               p-torgconf-wrkr-name = buf_store.store-man
     2702               p-torgconf-post = ""
     2703            .
     2704            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2705         END.
     2706         OTHERWISE DO:
     2707            assign
     2708               p-torgconf-post = "":U
     2709               p-torgconf-wrkr-name = "":U
     2710            .
     2711         END.
     2712         END CASE.
     2713      end.
     2714    end procedure.
     2715   procedure torgconf-get-form-header :
     2716   define input parameter p-for-inverse    as logical          no-undo.
     2717   define input parameter p-doc-code       as character        no-undo.
     2718   define input parameter p-print-doc      as logical          no-undo.
     2719   define input parameter p-doc-date       as date             no-undo.
     2720   define input parameter p-fact-date      as date             no-undo.
     2721   define input parameter p-doc-type       as character        no-undo.
     2722   define input parameter p-status_        as character        no-undo.
     2723   define input parameter p-reverse        as logical          no-undo.
     2724   define input parameter p-sf-par         as logical          no-undo.
     2725       define variable v-attr-type         as character    no-undo.
     2726       define variable v-doc-code-standard as logical      no-undo.
     2727       define variable v-doc-date-standard as logical      no-undo.
     2728       define variable v-par-consignee-addres  as character    no-undo.
     2729       define variable v-host-code         as integer      no-undo.
     2730       define variable v-dcode-attr        as character    no-undo.
     2731       define variable v-ddate-attr        as character    no-undo.
     2732       define variable v-doc-date          as character    no-undo.
     2733       define variable v-doc-code          as character    no-undo.
     2734       define variable v-par-type          as character    no-undo.
     2735       define variable v-attr              as character    no-undo.
     2736       define buffer buf_firm          for ub.firm .
     2737       define buffer buf_clients       for ub.clients .
     2738       define buffer buf_sysconf       for ub.sysconf .
     2739       define buffer buf_shop          for ub.shop .
     2740       define buffer buf_store         for ub.store .
     2741       define buffer buf_person        for ub.person .
     2742       define buffer buf_trn-doc       for ub.trn-doc .
     2743       define buffer buf_wth-doc       for ub.wth-doc .
     2744       do
     2745   for buf_firm
     2746     , buf_clients
     2747     , buf_sysconf
     2748     , buf_shop
     2749     , buf_trn-doc
     2750     , buf_person
     2751     , buf_wth-doc
     2752   on error undo, return error
     2753   :
     2754       if p-doc-type = 'при':U
     2755       or p-doc-type = 'возврат':U
     2756       then do:
     2757           assign
     2758               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2759                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2760               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2761                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2762               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2763                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2764               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2765                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2766               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2767               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2768               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2769               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2770               v-torgconf-supplier-type    = v-torgconf-cli-type
     2771               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2772               v-torgconf-saler-type       = v-torgconf-self-host-type
     2773               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2774               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2775               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2776               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2777               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2778               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2779               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2780               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2781               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2782               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2783               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2784               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2785               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2786               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2787               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2788           .
     2789           if v-torgconf-cli-schet-exists = yes
     2790           AND v-form-name                  = "torg12":U
     2791           then do:
     2792               assign
     2793                   v-torgconf-supplier = v-torgconf-supplier
     2794                       + substitute( ", р/с &1 к/с &2"
     2795                                   , v-torgconf-cli-bank-r-schet
     2796                                   , v-torgconf-cli-bank-c-schet
     2797                                   )
     2798                   v-torgconf-suppi = v-torgconf-supplier
     2799                       + substitute( ", р/с &1 к/с &2"
     2800                                   , v-torgconf-cli-bank-r-schet
     2801                                   , v-torgconf-cli-bank-c-schet
     2802                                   )
     2803               .
     2804               if v-torgconf-cli-bank-exists = yes
     2805               then do:
     2806                   assign
     2807                       v-torgconf-supplier = v-torgconf-supplier
     2808                           + substitute( " БИК &1 в &2 &3"
     2809                                       , v-torgconf-cli-bank-bik
     2810                                       , v-torgconf-cli-bank-name
     2811                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2812                                       )
     2813                      v-torgconf-suppi = v-torgconf-supplier
     2814                           + substitute( " БИК &1 в &2 &3"
     2815                                       , v-torgconf-cli-bank-bik
     2816                                       , v-torgconf-cli-bank-name
     2817                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2818                                       )
     2819                   .
     2820               end.
     2821           end.
     2822           if v-torgconf-self-schet-exists = yes
     2823           AND v-form-name                  = "torg12":U
     2824           then do:
     2825               assign
     2826                   v-torgconf-saler = v-torgconf-saler
     2827                       + substitute( ", р/с &1 к/с &2"
     2828                                   , v-torgconf-self-bank-r-schet
     2829                                   , v-torgconf-self-bank-c-schet
     2830                                   )
     2831               .
     2832               if v-torgconf-self-bank-exists = yes
     2833               then do:
     2834                   assign
     2835                       v-torgconf-saler = v-torgconf-saler
     2836                           + substitute( " БИК &1 в &2 &3"
     2837                                       , v-torgconf-self-bank-bik
     2838                                       , v-torgconf-self-bank-name
     2839                                       , v-torgconf-self-bank-addres
     2840                                       )
     2841                   .
     2842               end.
     2843           end.
     2844           if v-torgconf-sup-schet-exists = yes
     2845           AND v-form-name                  = "torg12":U
     2846           then do:
     2847               assign
     2848                   v-torgconf-consignee = v-torgconf-consignee
     2849                       + substitute( ", р/с &1 к/с &2"
     2850                                   , v-torgconf-sup-bank-r-schet
     2851                                   , v-torgconf-sup-bank-c-schet
     2852                                   )
     2853               .
     2854             if v-torgconf-sup-bank-exists = yes
     2855              then do:
     2856                assign
     2857                   v-torgconf-consignee = v-torgconf-consignee
     2858                           + substitute( " БИК &1 в &2 &3"
     2859                                       , v-torgconf-sup-bank-bik
     2860                                       , v-torgconf-sup-bank-name
     2861                                       , v-torgconf-sup-bank-addres
     2862                                       )
     2863                   .
     2864               end.
     2865           end.
     2866      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2867      then do:
     2868          assign
     2869            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2870                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2871                                                   , v-torgconf-cli-name
     2872                                                   , ( if v-torgconf-outprncd = yes
     2873                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2874                                                         else "":U )
     2875                                                   , v-torgconf-cli-post-addres
     2876                                                   , v-torgconf-cli-phone
     2877                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2878                                                       AND v-form-name                  = "torg12":U
     2879                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2880                                                               , v-torgconf-cli-bank-r-schet
     2881                                                               , v-torgconf-cli-bank-c-schet
     2882                                                               , v-torgconf-cli-bank-bik
     2883                                                               , v-torgconf-cli-bank-name
     2884                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2885                                                         else "":U )
     2886                                                )
     2887         .
     2888      end.
     2889       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2890                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2891                                        , v-torgconf-cli-name
     2892                                        , ( if v-torgconf-outprncd = yes
     2893                                            then substitute( " (&1)", v-torgconf-cli-code )
     2894                                            else "":U )
     2895                                        , v-torgconf-cli-addres
     2896                                        , v-torgconf-cli-phone
     2897                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2898                                            AND v-form-name                  = "torg12":U
     2899                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2900                                                           , v-torgconf-cli-bank-r-schet
     2901                                                           , v-torgconf-cli-bank-c-schet
     2902                                                           , v-torgconf-cli-bank-bik
     2903                                                           , v-torgconf-cli-bank-name
     2904                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2905                                                   else "":U )
     2906                                        ).
     2907       end.
     2908       else do:
     2909       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2910                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2911                                        , v-torgconf-self-host-name
     2912                                        , ( if v-torgconf-outprncd = yes
     2913                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2914                                            else "":U )
     2915                                        , v-torgconf-self-host-addres
     2916                                        , v-torgconf-self-host-phone
     2917                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2918                                            AND v-form-name                  = "torg12":U
     2919                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2920                                                           , v-torgconf-self-bank-r-schet
     2921                                                           , v-torgconf-self-bank-c-schet
     2922                                                           , v-torgconf-self-bank-bik
     2923                                                           , v-torgconf-self-bank-name
     2924                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2925                                                   else "":U )
     2926                                           ).
     2927         if v-torgconf-outares = yes
     2928         and p-reverse = no
     2929         then do:
     2930            assign
     2931               v-par-consignee-addres = v-torgconf-ship-post-addres
     2932            .
     2933         end.
     2934         if v-torgconf-outares = no
     2935         and p-reverse = no
     2936         then do:
     2937            assign
     2938               v-par-consignee-addres = v-torgconf-ship-addres
     2939            .
     2940         end.
     2941         if p-reverse = yes
     2942         then do:
     2943             assign
     2944               v-par-consignee-addres = v-torgconf-ship-addres
     2945             .
     2946         end.
     2947           assign
     2948               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2949                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2950               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2951                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2952               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2953                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2954               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2955               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2956               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2957               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2958               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2959               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2960               v-torgconf-saler-type       = v-torgconf-cli-type
     2961               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2962               v-torgconf-consignee-type   = v-torgconf-ship-type
     2963               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2964               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2965               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2966               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2967               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2968               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2969               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2970               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2971               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2972               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2973               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2974               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2975               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2976               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2977               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2978               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2979               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2980           .
     2981           if v-torgconf-self-schet-exists = yes
     2982           AND v-form-name                  = "torg12":U
     2983           then do:
     2984               assign
     2985                   v-torgconf-supplier = v-torgconf-supplier
     2986                       + substitute( ", р/с &1 к/с &2"
     2987                                   , v-torgconf-self-bank-r-schet
     2988                                   , v-torgconf-self-bank-c-schet
     2989                                   )
     2990               .
     2991               if v-torgconf-self-bank-exists = yes
     2992               then do:
     2993                   assign
     2994                       v-torgconf-supplier = v-torgconf-supplier
     2995                           + substitute( " БИК &1 в &2 &3"
     2996                                       , v-torgconf-self-bank-bik
     2997                                       , v-torgconf-self-bank-name
     2998                                       , v-torgconf-self-bank-addres
     2999                                       )
     3000                   .
     3001               end.
     3002           end.
     3003           if v-torgconf-cli-schet-exists = yes
     3004           AND v-form-name                  = "torg12":U
     3005           then do:
     3006               assign
     3007                   v-torgconf-saler = v-torgconf-saler
     3008                       + substitute( ", р/с &1 к/с &2"
     3009                                   , v-torgconf-cli-bank-r-schet
     3010                                   , v-torgconf-cli-bank-c-schet
