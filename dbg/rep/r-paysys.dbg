     1722   procedure wthcattr-sprcli :
     1723   define input parameter parparentproc  as widget-handle no-undo.
     1724   define input parameter p-mode  as character no-undo.
     1725   define input-output parameter p-value as character no-undo .
     1726   define output parameter p-setted as logical no-undo .
     1727     DEFINE VARIABLE v-value as character no-undo .
     1728     define variable v-cli-type as character no-undo .
     1729     define variable v-cli-code as integer no-undo .
     1730     define buffer buf_clients   for ub.clients.
     1731     define variable v_rid as character no-undo.
     1732     define variable ref-rec as recid no-undo .
     1733     do
     1734     on error undo, return error
     1735     :
     1736         v-value = p-value.
     1737      if p-value <> '':U then do:
     1738       assign
     1739       v-cli-type = substring(p-value, 1, 3)
     1740       v-cli-code = integer(substring(p-value, 4))
     1741       no-error.
     1742       if error-status:error then do:
     1743         assign
     1744         v-cli-type = '':U
     1745         v-cli-code = 0
     1746         .
     1747       end.
     1748      end.
     1749      FIND FIRST buf_clients NO-LOCK WHERE
     1750               buf_clients.obj-type = v-cli-type AND
     1751               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1752      IF available(buf_clients) then do:
     1753       run ref/cli-all.w (
     1754                   input parparentproc
     1755                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1756                  ,input v-cli-type
     1757                  ,input 'все':U
     1758                  ,input 'все':U
     1759                  ,input RECID( buf_clients )
     1760                  ,input ",,,,,,NO"
     1761                  ,input ?
     1762                  ,OUTPUT v_rid ).
     1763     END.
     1764     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1765       run ref/cli-all.w (
     1766                    input parparentproc
     1767                   ,INPUT "b-sel":U
     1768                  ,input  v-cli-type
     1769                  ,input 'все':U
     1770                  ,input 'текущие':U
     1771                  ,input ?
     1772                  ,input ",,,,,,NO"
     1773                  ,input ?
     1774                  ,OUTPUT v_rid ).
     1775     END.
     1776     else do:
     1777       message
     1778       if p-value = "":U then 'Атрибут не задан!'
     1779       else substitute('Не найден клиент &1',p-value)
     1780       view-as alert-box warning.
     1781     end.
     1782     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1783       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1784       IF ERROR-STATUS:ERROR THEN DO:
     1785           RETURN NO-APPLY.
     1786       END.
     1787       FIND FIRST buf_clients NO-LOCK WHERE
     1788                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1789       IF AVAIL buf_clients THEN DO:
     1790         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1791       end.
     1792     end.
     1793     if v-value <> p-value then do:
     1794       p-value = v-value.
     1795       p-setted = yes.
     1796     end.
     1797     end.
     1798   end procedure.
     1799     define new global shared variable g#wthcalib as handle no-undo.
     1800   procedure torgconf-read :
     1801   do
     1802   on error undo, return error
     1803   :
     1804       define input parameter p-form-name  as character    no-undo.
     1805       define input parameter p-host-code  as integer      no-undo.
     1806       define input parameter p-obj-type   as character    no-undo.
     1807       define input parameter p-obj-code   as integer      no-undo.
     1808       define variable v-outdate   as character     no-undo.
     1809       define variable v-outares   as character     no-undo.
     1810       define variable v-outsend   as character     no-undo.
     1811       define variable v-outasend  as character     no-undo.
     1812       define variable v-outprops  as character     no-undo.
     1813       define variable v-outnum    as character     no-undo.
     1814       define variable v-outprim   as character     no-undo.
     1815       define variable v-outdisc   as character     no-undo.
     1816       define variable v-outsubs   as character     no-undo.
     1817       define variable v-outrecv   as character     no-undo.
     1818       define variable v-outegrp   as character     no-undo.
     1819       define variable v-outt12    as character     no-undo.
     1820       define variable v-outappr   as character     no-undo.
