     4445                  run rep/get-psn.p
     4446                  (input buf_wth-doc.deliver
     4447                  ,output v-torgconf-ogr-name
     4448                  ) .
     4449               end.
     4450               find first buf_person no-lock
     4451               where buf_person.psn-code = buf_wth-doc.deliver
     4452               no-error.
     4453               if available buf_person
     4454               then do:
     4455                  v-torgconf-ogr-post = buf_person.position.
     4456               end.
     4457               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4458               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4459            end.
     4460      end.
     4461   end.
     4462   procedure torgconf-get-reason  :
     4463   define input parameter  p-doc-code       as character        no-undo.
     4464   define input parameter  p-reason-code    as integer          no-undo .
     4465   define input parameter  p-doc-type       as character        no-undo.
     4466       if p-reason-code > 0
     4467       then do:
     4468           define buffer buf_trn-reason for ub.trn-reason.
     4469           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4470           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4471       end.
     4472       else do:
     4473           if p-doc-type = 'при':U
     4474           then  do:
     4475               define variable v-attr-type     as character    no-undo.
     4476               define variable v-attr-value    as character    no-undo.
     4477               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4478               assign v-torgconf-reason = v-attr-value .
     4479               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4480               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4481           end.
     4482       end.
     4483   end procedure.
