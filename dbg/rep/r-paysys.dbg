     2149   procedure torgconf-get-recepient-param :
     2150   define input parameter torgconfdoc-code   as character                  no-undo.
     2151   define output parameter v-code-rec        as integer                    no-undo .
     2152   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     2153   define output parameter v-codefirm-rec    as integer                    no-undo .
     2154   define output parameter v-curcode-rec     as integer                    no-undo .
     2155        define variable  v-recipient-code  as character                  no-undo .
     2156        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     2157        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     2158   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     2159                           input 'Recipient':U ,
     2160                          output v-recipient-code ,
     2161                          output v-trdcattr-type ) no-error .
     2162       if error-status :error then do:
     2163        message
     2164         vss-workfile vss-revision vss-description skip
     2165         "Ошибка при вызове процедуры tdat-val":U skip
     2166         "Документ: " torgconfdoc-code skip
     2167         "Атрибут: " 'Recipient':U skip
     2168         "Значение: " v-recipient skip
     2169         trim( error-status :get-message (1) ) skip
     2170         return-value skip
     2171         view-as alert-box error.
     2172       undo, return error return-value.
     2173       end.
     2174     assign
     2175       v-recipient  = v-recipient-code
     2176       v-type-rec = substring(v-recipient-code,1,3)
     2177       v-code-rec  = int(substring(v-recipient-code,4,15))
     2178       no-error
     2179     .
     2180     if v-type-rec = ? then v-type-rec = "" .
     2181     if v-code-rec  = ? then v-code-rec  =  0 .
     2182     end procedure.
