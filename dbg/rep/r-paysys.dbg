     2492           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2493           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2494           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
