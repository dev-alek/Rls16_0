     4504   def var vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4505   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4506   procedure paramls-clear :
     4507     define buffer buf_temp-param for temp-param .
     4508     do
     4509     on error undo, return error return-value
     4510     :
     4511       for each buf_temp-param
     4512       on error undo, return error
     4513       :
     4514         delete buf_temp-param .
     4515       end.
     4516     end.
     4517   end procedure.
     4518   procedure paramls-write :
     4519     define input  parameter p-code     as character no-undo .
     4520     define input  parameter p-sub-code as character no-undo .
     4521     define input  parameter p-value    as character no-undo .
     4522     define buffer buf_temp-param for temp-param .
     4523     do
     4524     on error undo, return error return-value
     4525     :
     4526       find first buf_temp-param
     4527         where buf_temp-param.param-code     = p-code
     4528           and buf_temp-param.param-sub-code = p-sub-code
     4529         no-error .
     4530       if not available buf_temp-param then do:
     4531         create buf_temp-param .
     4532         assign
     4533           buf_temp-param.param-code     = p-code
     4534           buf_temp-param.param-sub-code = p-sub-code
     4535         .
     4536       end.
     4537       assign
     4538         buf_temp-param.param-value = p-value
     4539       .
     4540     end.
     4541   end procedure.
     4542   procedure paramls-read :
     4543     define input  parameter p-code          as character no-undo .
     4544     define input  parameter p-sub-code      as character no-undo .
     4545     define input  parameter p-default-value as character no-undo .
     4546     define output parameter p-value         as character no-undo .
     4547     define buffer buf_temp-param for temp-param .
     4548     do
     4549     on error undo, return error return-value
     4550     :
     4551       find first buf_temp-param
     4552         where buf_temp-param.param-code     = p-code
     4553           and buf_temp-param.param-sub-code = p-sub-code
     4554         no-error .
     4555       if available buf_temp-param then do:
     4556         assign
     4557           p-value = buf_temp-param.param-value
     4558         .
     4559       end.
     4560       else do:
     4561         assign
     4562           p-value = p-default-value
     4563         .
     4564       end.
     4565     end.
     4566   end procedure.
     4567   procedure paramls-append :
     4568     define input  parameter p-code     as character no-undo .
     4569     define input  parameter p-sub-code as character no-undo .
     4570     define input  parameter p-value    as character no-undo .
     4571     define buffer buf_temp-param for temp-param .
     4572     do
     4573     on error undo, return error return-value
     4574     :
     4575       find first buf_temp-param
     4576            where buf_temp-param.param-code     = p-code
     4577              and buf_temp-param.param-sub-code = p-sub-code
     4578         no-error .
     4579       if not available buf_temp-param then do:
     4580         create buf_temp-param .
     4581         assign
     4582           buf_temp-param.param-code     = p-code
     4583           buf_temp-param.param-sub-code = p-sub-code
     4584           buf_temp-param.param-value    = p-value
     4585         .
     4586       end.
     4587       else do:
     4588           assign
     4589               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4590           .
     4591       end.
     4592     end.
     4593   end procedure.
