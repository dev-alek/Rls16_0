     2092               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     2093               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     2094               v-torgconf-self-host-phone       = v-fmtcli-phone
     2095               v-torgconf-self-host-inn         = v-fmtcli-inn
     2096               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     2097               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     2098           .
     2099           run gbl/clntat-v.p (
     2100                 input 'орг':U
     2101               , input v-torgconf-self-host-code
     2102               , input 'egrip-date':U
     2103               , output v-torgconf-self-host-egrip-date
     2104               , output v-par-type
     2105           ).
     2106           run gbl/clntat-v.p (
