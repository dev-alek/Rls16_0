      569   define variable var-report-r-b as character no-undo .
      570   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      572     (output var-report-r-b
      573     )  .
      574   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      576   define  shared variable RepPathName        as character no-undo .
      577   define  shared variable PrintRubl          as logical   no-undo .
      578   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   procedure cur-time :
      581      define output parameter p-today as date      no-undo .
      582      define output parameter p-time  as integer   no-undo .
      583     do
      584     on error undo, return error
      585     :
      586       define variable v-date1 as date      no-undo .
      587       define variable v-date2 as date      no-undo .
      588       define variable v-time  as integer   no-undo .
      589       assign
      590         v-date1 = today
      591         v-time  = time
      592         v-date2 = today
      593       .
      594       if v-date1 <> v-date2
      595       then do:
      596         assign
      597           v-date1 = today
      598           v-time  = v-time
      599         .
      600       end.
      601       assign
      602         p-today = v-date1
      603         p-time  = v-time
      604       .
      605     end.
      606   end.
      607   function cur-time-date returns character
      608   :
      609     return string(today, '99/99/9999':U) .
      610   end.
      611   function cur-time-mjd returns decimal
      612   :
      613     define variable v-date as date      no-undo .
      614     define variable v-time as integer   no-undo .
      615     run cur-time in this-procedure
      616       (output v-date
      617       ,output v-time
      618       ) .
      619     return integer(v-date) - 2400002 + (v-time / 86400) .
      620   end.
      621   function cur-time-get-ending-index returns integer
      622   (input p-number as integer
      623   )
      624   :
      625     if p-number < 0
      626     or p-number = ?
      627     then do:
      628       return 1 .
      629     end.
      630     define variable v-rest as integer   no-undo .
      631     assign
      632       p-number = p-number modulo 100
      633     .
      634     if p-number < 20
      635     then do:
      636       assign
      637         v-rest = p-number
      638       .
      639     end.
      640     else do:
      641       assign
      642         v-rest = p-number modulo 10
      643       .
      644     end.
      645     case v-rest :
      646       when 1
      647       then do:
      648         return 2 .
      649       end.
      650       when 2 or
      651       when 3 or
      652       when 4
      653       then do:
      654         return 3 .
      655       end.
      656       otherwise do:
      657         return 1 .
      658       end.
      659     end case .
      660   end.
      661   procedure cur-time-mjd-to-date :
      662      define input  parameter i-mjd-diff as decimal no-undo.
      663      define output parameter o-Date     as date    no-undo.
      664      define output parameter o-Time     as integer no-undo.
      665      define variable v-day-number as integer   no-undo .
      666      if    i-mjd-diff < 0
      667         or i-mjd-diff = ?
      668      then do:
      669         return "?" .
      670      end.
      671      assign
      672         v-day-number = truncate(i-mjd-diff,0).
      673         o-Date = date(v-day-number + 2400002).
      674         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      675     .
      676   end.
      677   function cur-time-mjd-to-string returns character
      678   (input p-mjd-diff as decimal
      679   )
      680   :
      681     define variable v-day-number as integer   no-undo .
      682     define variable v-seconds    as integer   no-undo .
      683     define variable v-hour       as integer   no-undo .
      684     define variable v-min        as integer   no-undo .
      685     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      686     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      687     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      688     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      689     if p-mjd-diff < 0
      690     or p-mjd-diff = ?
      691     then do:
      692       return "?" .
      693     end.
      694     assign
      695       v-day-number = integer(truncate(p-mjd-diff,0))
      696       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      697     .
      698     if v-seconds > 86400
      699     then do:
      700       assign
      701         v-seconds = 86400 - 1
      702       .
      703     end.
      704     if v-seconds < 0
      705     then do:
      706       assign
      707         v-seconds = 0
      708       .
      709     end.
      710     assign
      711       v-hour = truncate(v-seconds / 3600, 0)
      712     .
      713     assign
      714       v-seconds = v-seconds modulo 3600
      715     .
      716     assign
      717       v-min = truncate(v-seconds / 60, 0)
      718     .
      719     assign
      720       v-seconds = v-seconds modulo 60
      721     .
      722     return
      723         (if v-day-number <> 0
      724           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      725           else ""
      726         )
      727       + (if v-day-number <> 0 or v-hour <> 0
      728           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      729           else ""
      730         )
      731       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      732           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      733           else ""
      734         )
      735       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      736       .
      737   end.
      738   function cur-time-string returns character
      739   :
      740     define variable v-date as date      no-undo .
      741     define variable v-time as integer   no-undo .
      742     run cur-time in this-procedure
      743       (output v-date
      744       ,output v-time
      745       ) .
      746     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      747   end.
      748   function cur-time-string-sec returns character
      749   :
      750     define variable v-date as date      no-undo .
      751     define variable v-time as integer   no-undo .
      752     run cur-time in this-procedure
      753       (output v-date
      754       ,output v-time
      755       ) .
      756     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      757   end.
      758   function cur-time-custom  returns character
      759   (input p-prefix as character
      760   ,input p-date-format as character
      761   ,input p-delimiter as character
      762   ,input p-time-format as character
      763   ,input p-suffix as character
      764   )
      765   :
      766     define variable v-date as date      no-undo .
      767     define variable v-time as integer   no-undo .
      768     run cur-time in this-procedure
      769       (output v-date
      770       ,output v-time
      771       ) .
      772     return
      773       p-prefix
      774       + string(v-date, p-date-format)
      775       + p-delimiter
      776       + string(v-time, p-time-format)
      777       + p-suffix
      778       .
      779   end.
      780   function cur-time-print  returns character
      781   :
      782     define variable v-date as date      no-undo .
      783     define variable v-time as integer   no-undo .
      784     run cur-time in this-procedure
      785       (output v-date
      786       ,output v-time
      787       ) .
      788     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      789   end.
      790   function cur-time-datetime returns datetime
      791   :
      792     define variable v-char as character no-undo .
      793     define variable v-datetime as datetime no-undo .
      794     v-char = cur-time-string().
      795     v-datetime = datetime(v-char).
      796     return  v-datetime.
      797   end.
      798   function cur-time-string-msec returns character
      799   :
      800     define variable v-date as datetime  no-undo .
      801     v-date = now.
      802     return string(v-date) .
      803   end.
      804   procedure cp-attr-code :
      805     do
      806     on error undo, return error
      807     :
      808       define input  parameter p-code           as character no-undo .
      809       define output parameter p-type           as character no-undo .
      810       define output parameter p-format         as character no-undo .
      811       define output parameter p-label          as character no-undo .
      812       define output parameter p-range          as integer   no-undo .
      813       define output parameter p-user-can-edit  as logical   no-undo .
      814       define output parameter p-output-display as logical   no-undo .
      815       define output parameter p-other          as character no-undo .
      816       case p-code :
      817               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      818               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      819               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      820               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      821               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      822               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      823               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      824               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      825               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      826               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      827         otherwise do:
      828           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      829         end.
      830       end.
      831     end.
      832   end procedure.
      833   procedure cp-attr-tooltip :
      834     do
      835     on error undo, return error
      836     :
      837       define input  parameter p-code    as character no-undo .
      838       define output parameter p-tooltip as character no-undo .
      839       define output parameter p-label   as character no-undo .
      840       case p-code :
      841               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      842               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      843               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      844               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      845               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      846               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      847               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      848               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      849               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      850               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      851         otherwise do:
      852           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      853         end.
      854       end.
      855     end.
      856   end procedure.
      857   procedure cp-attr-value :
      858     do
      859     on error undo, return error
      860     :
      861       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      862       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      863       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      864       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      865       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      866       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      867       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      868       define output parameter p-type        as character no-undo .
      869       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      870       define variable v-format         as character no-undo .
      871       define variable v-label          as character no-undo .
      872       define variable v-range          as integer   no-undo .
      873       define variable v-user-can-edit  as logical   no-undo .
      874       define variable v-output-display as logical   no-undo .
      875       define variable v-other          as character no-undo .
      876       run cp-attr-code in this-procedure
      877         (input  p-code
      878         ,output p-type
      879         ,output v-format
      880         ,output v-label
      881         ,output v-range
      882         ,output v-user-can-edit
      883         ,output v-output-display
      884         ,output v-other
      885         ) no-error .
      886       if error-status :error then do:
      887         undo, return error return-value .
      888       end.
      889       find first buf_cash-pay-attr no-lock
      890         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      891           and buf_cash-pay-attr.curr-code  = p-curr-code
      892           and buf_cash-pay-attr.host-code  = p-host-code
      893           and buf_cash-pay-attr.obj-type   = p-obj-type
      894           and buf_cash-pay-attr.obj-code   = p-obj-code
      895           and buf_cash-pay-attr.attr-code  = p-code
      896         no-error .
      897       if avail buf_cash-pay-attr then do:
      898         assign
      899           p-value =  buf_cash-pay-attr.attr-value
      900         .
      901       end.
      902       else do:
      903         assign
      904           p-value = if p-type = 'L':U then "no":U else ""
      905         .
      906       end.
      907     end.
      908   end procedure.
      909   procedure cp-attr-write :
      910     do
      911     on error undo, return error
      912     :
      913       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      914       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      915       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      916       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      917       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      918       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      919       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      920       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      921       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      922       define variable v-type           as character no-undo .
      923       define variable v-format         as character no-undo .
      924       define variable v-label          as character no-undo .
      925       define variable v-range          as integer   no-undo .
      926       define variable v-user-can-edit  as logical   no-undo .
      927       define variable v-output-display as logical   no-undo .
      928       define variable v-other          as character no-undo .
      929       run cp-attr-code in this-procedure
      930         (input  p-code
      931         ,output v-type
      932         ,output v-format
      933         ,output v-label
      934         ,output v-range
      935         ,output v-user-can-edit
      936         ,output v-output-display
      937         ,output v-other
      938         ) no-error .
      939       if error-status :error then do:
      940         undo, return error return-value .
      941       end.
      942       find first buf_cash-pay-attr exclusive-lock
      943         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      944           and buf_cash-pay-attr.curr-code  = p-curr-code
      945           and buf_cash-pay-attr.host-code  = p-host-code
      946           and buf_cash-pay-attr.obj-type   = p-obj-type
      947           and buf_cash-pay-attr.obj-code   = p-obj-code
      948           and buf_cash-pay-attr.attr-code = p-code
      949         no-error .
      950       if not available buf_cash-pay-attr then do:
      951         create buf_cash-pay-attr .
      952         assign
      953         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      954         buf_cash-pay-attr.curr-code  = p-curr-code
      955         buf_cash-pay-attr.host-code  = p-host-code
      956         buf_cash-pay-attr.obj-type   = p-obj-type
      957         buf_cash-pay-attr.obj-code   = p-obj-code
      958         buf_cash-pay-attr.attr-code = p-code
      959         .
      960       end.
      961       assign
      962         buf_cash-pay-attr.attr-value = p-value
      963       .
      964       release buf_cash-pay-attr no-error .
      965       if error-status:error then do:
      966         undo, return error return-value .
      967       end.
      968     end.
      969   end procedure.
      970   procedure cp-attr-exist :
      971     do
      972     on error undo, return error
      973     :
      974       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      975       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      976       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      977       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      978       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      979       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      980       define output parameter p-exist   as logical  no-undo .
      981       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      982       define variable v-type           as character no-undo .
      983       define variable v-format         as character no-undo .
      984       define variable v-label          as character no-undo .
      985       define variable v-range          as integer   no-undo .
      986       define variable v-user-can-edit  as logical   no-undo .
      987       define variable v-output-display as logical   no-undo .
      988       define variable v-other          as character no-undo .
      989       run cp-attr-code in this-procedure
      990         (input  p-code
      991         ,output v-type
      992         ,output v-format
      993         ,output v-label
      994         ,output v-range
      995         ,output v-user-can-edit
      996         ,output v-output-display
      997         ,output v-other
      998         ) no-error .
      999       if error-status :error then do:
     1000         undo, return error return-value .
     1001       end.
     1002       find first buf_cash-pay-attr exclusive-lock
     1003         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1004           and buf_cash-pay-attr.curr-code  = p-curr-code
     1005           and buf_cash-pay-attr.host-code  = p-host-code
     1006           and buf_cash-pay-attr.obj-type   = p-obj-type
     1007           and buf_cash-pay-attr.obj-code   = p-obj-code
     1008           and buf_cash-pay-attr.attr-code = p-code
     1009         no-error .
     1010       if  available buf_cash-pay-attr then do:
     1011         p-exist = yes.
     1012       end.
     1013     end.
     1014   end procedure.
     1015   procedure cp-attr-delete :
     1016     do
     1017     on error undo, return error
     1018     :
     1019       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1020       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1021       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1022       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1023       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1024       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1025       define output parameter p-deleted  as logical no-undo.
     1026       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1027       define variable v-type           as character no-undo .
     1028       define variable v-format         as character no-undo .
     1029       define variable v-label          as character no-undo .
     1030       define variable v-range          as integer   no-undo .
     1031       define variable v-user-can-edit  as logical   no-undo .
     1032       define variable v-output-display as logical   no-undo .
     1033       define variable v-other          as character no-undo .
     1034       run cp-attr-code in this-procedure
     1035         (input  p-code
     1036         ,output v-type
     1037         ,output v-format
     1038         ,output v-label
     1039         ,output v-range
     1040         ,output v-user-can-edit
     1041         ,output v-output-display
     1042         ,output v-other
     1043         ) no-error .
     1044       if error-status :error then do:
     1045         undo, return error return-value .
     1046       end.
     1047       find first buf_cash-pay-attr exclusive-lock
     1048         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1049           and buf_cash-pay-attr.curr-code  = p-curr-code
     1050           and buf_cash-pay-attr.host-code  = p-host-code
     1051           and buf_cash-pay-attr.obj-type   = p-obj-type
     1052           and buf_cash-pay-attr.obj-code   = p-obj-code
     1053           and buf_cash-pay-attr.attr-code = p-code
     1054         no-error NO-WAIT.
     1055       if not available buf_cash-pay-attr then do:
     1056         p-deleted = no.
     1057       end.
     1058       else do:
     1059         delete buf_cash-pay-attr no-error .
     1060         if error-status:error then do:
     1061           undo, return error return-value .
     1062         end.
     1063         p-deleted = yes.
     1064       end.
     1065     end.
     1066   end procedure.
     1067   procedure cp-attr-news :
     1068     do
     1069     on error undo, return error
     1070     :
     1071       define input  parameter p-code           as character no-undo .
     1072       define output parameter p-news           as logical   no-undo .
     1073       case p-code :
     1074               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1075               when 'grp-code':U then do:     assign     p-news = true.   end.
     1076               when 'is-use':U then do:     assign     p-news = true.   end.
     1077               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1078               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1079               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1080               when 'form_km3':U then do:     assign     p-news = false.   end.
     1081               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1082               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1083               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1084         otherwise do:
     1085           p-news = no.
     1086         end.
     1087       end.
     1088     end.
     1089   end procedure.
     1090   procedure cp-attr-hist :
     1091     do
     1092     on error undo, return error
     1093     :
     1094       define input  parameter p-code           as character no-undo .
     1095       define output parameter p-hist           as logical   no-undo .
     1096       case p-code :
     1097               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
     1098               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
     1099               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     1100               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1101               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1102               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1103               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1104         otherwise do:
     1105           p-hist = no.
     1106         end.
     1107       end.
     1108     end.
     1109   end procedure.
     1110   define new global shared variable g#lib-trn  as handle no-undo .
     1111   define new global shared variable g#lib-trn2 as handle no-undo .
     1112   define new global shared variable g#lib-trn3 as handle no-undo .
     1113   define new global shared variable g#lib-trn4 as handle no-undo .
     1114   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   define new global shared variable g#trdcalib as handle no-undo.
     1116   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1117                                     iInput AS INTEGER).
     1118     def var v-start-print as integer no-undo .
     1119     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1120     assign
     1121       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1122     .
     1123     RETURN v-start-print .
     1124   END FUNCTION.
     1125   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1126                                     iInput AS INTEGER).
     1127     def var v-start-print as integer no-undo .
     1128     assign
     1129       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1130     .
     1131     if v-start-print < 0 then return 0.
     1132     RETURN v-start-print .
     1133   END FUNCTION.
     1134   define variable vss-include-info11 as character format "X(65)" no-undo
     1135   initial "@(#)$Workfile$ $Revision$".
     1136   define variable v-fmtcli-name          as character    no-undo.
     1137   define variable v-fmtcli-engl-name     as character    no-undo.
     1138   define variable v-fmtcli-addres        as character    no-undo.
     1139   define variable v-fmtcli-post-addres   as character    no-undo.
     1140   define variable v-fmtcli-full-addres   as character    no-undo.
     1141   define variable v-fmtcli-phone         as character    no-undo.
     1142   define variable v-fmtcli-inn           as character    no-undo.
     1143   define variable v-fmtcli-kpp           as character    no-undo.
     1144   define variable v-fmtcli-okpo          as character    no-undo.
     1145   define variable v-fmtcli-country       as character    no-undo.
     1146   define variable v-fmtcli-city          as character    no-undo.
     1147   define variable v-fmtcli-index         as character    no-undo.
     1148   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1149   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1150   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1151   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1152   define variable v-fmtcli-bank-bik      as character    no-undo.
     1153   define variable v-fmtcli-bank-name     as character    no-undo.
     1154   define variable v-fmtcli-bank-addres   as character    no-undo.
     1155   define variable v-fmtcli-bank-city     as character    no-undo.
     1156   procedure fmtcli-get-bank :
     1157   define input parameter p-host-code      as integer          no-undo.
     1158   define input parameter p-obj-type       as character        no-undo.
     1159   define input parameter p-obj-code       as integer          no-undo.
     1160   define input parameter p-curr-code      as integer          no-undo.
     1161       define buffer buf_fin-schet     for ub.fin-schet.
     1162       define buffer buf_fin-bank      for ub.fin-bank.
     1163   do
     1164   for buf_fin-schet
     1165     , buf_fin-bank
     1166   on error undo, return error
     1167   :
     1168       assign
     1169           v-fmtcli-schet-exists       = no
     1170           v-fmtcli-bank-exists        = no
     1171           v-fmtcli-bank-r-schet       = "":U
     1172           v-fmtcli-bank-c-schet       = "":U
     1173           v-fmtcli-bank-bik           = "":U
     1174           v-fmtcli-bank-name          = "":U
     1175           v-fmtcli-bank-addres        = "":U
     1176           v-fmtcli-bank-city          = "":U
     1177       .
     1178       search-for-schet:
     1179       for each buf_fin-schet no-lock
     1180          where buf_fin-schet.host-code = p-host-code
     1181            and buf_fin-schet.cli-type  = p-obj-type
     1182            and buf_fin-schet.cli-code  = p-obj-code
     1183            and buf_fin-schet.curr-code = p-curr-code
     1184       on error undo, return error
     1185       :
     1186           if buf_fin-schet.status_   = 'удал':U
     1187           then do:
     1188           end.
     1189           else do:
     1190               assign
     1191                   v-fmtcli-schet-exists   = yes
     1192                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1193                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1194               .
     1195               find first buf_fin-bank no-lock
     1196                    where buf_fin-bank.host-code = p-host-code
     1197                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1198               no-error.
     1199               if available buf_fin-bank
     1200               then do:
     1201                   assign
     1202                       v-fmtcli-bank-exists      = yes
     1203                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1204                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1205                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1206                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1207                   .
     1208               end.
     1209               else do:
     1210                   assign
     1211                       v-fmtcli-bank-exists    = no
     1212                       v-fmtcli-bank-bik       = "":U
     1213                       v-fmtcli-bank-name      = "":U
     1214                       v-fmtcli-bank-addres    = "":U
     1215                       v-fmtcli-bank-city      = "":U
     1216                   .
     1217               end.
     1218               leave search-for-schet.
     1219           end.
     1220       end.
     1221   end.
     1222   end procedure.
     1223   procedure fmtcli-get-client :
     1224   define input parameter p-obj-type       as character    no-undo.
     1225   define input parameter p-obj-code       as integer      no-undo.
     1226       define variable v-temp-fmtcli-address      as character     no-undo.
     1227       define variable v-num-country-city    as integer      no-undo.
     1228       define buffer buf_clients   for ub.clients.
     1229       define buffer buf_firm      for ub.firm.
     1230       define buffer buf_store     for ub.store.
     1231       define buffer buf_shop      for ub.shop.
     1232       define buffer buf_person    for ub.person.
     1233   do
     1234   for buf_clients
     1235     , buf_firm
     1236     , buf_store
     1237     , buf_shop
     1238     , buf_person
     1239   on error undo, return error
     1240   :
     1241       assign
     1242           v-fmtcli-name           = "":U
     1243           v-fmtcli-addres         = "":U
     1244           v-fmtcli-post-addres    = "":U
     1245           v-fmtcli-full-addres    = "":U
     1246           v-fmtcli-phone          = "":U
     1247           v-fmtcli-inn            = "":U
     1248           v-fmtcli-kpp            = "":U
     1249           v-fmtcli-okpo           = "":U
     1250           v-fmtcli-city           = "":U
     1251           v-fmtcli-index          = "":U
     1252           v-fmtcli-country        = "":U
     1253       .
     1254       find first buf_clients no-lock
     1255            where buf_clients.obj-type = p-obj-type
     1256              and buf_clients.obj-code = p-obj-code
     1257       .
     1258       assign
     1259           v-fmtcli-name = buf_clients.obj-name
     1260       .
     1261       case buf_clients.obj-type:
     1262          when 'орг':U
     1263          then do:
     1264               find first buf_firm no-lock
     1265                    where buf_firm.firm-code = buf_clients.obj-code
     1266                    no-error
     1267               .
     1268               if available buf_firm
     1269               then do:
     1270                   assign
     1271                       v-num-country-city = num-entries( buf_firm.city )
     1272                       v-fmtcli-engl-name = buf_firm.engl-name
     1273                   .
     1274                   if v-num-country-city > 0
     1275                   then do:
     1276                       assign
     1277                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1278                       .
     1279                   end.
     1280                   if v-num-country-city > 1
     1281                   then do:
     1282                       assign
     1283                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1284                       .
     1285                   end.
     1286                   run fmtcli-concatenate-strings in this-procedure (
     1287                         input v-fmtcli-full-addres
     1288                       , input v-fmtcli-country
     1289                       , input ", ":U
     1290                       , input 50
     1291                       , output v-fmtcli-full-addres
     1292                   ).
     1293                   run fmtcli-concatenate-strings in this-procedure (
     1294                         input v-fmtcli-full-addres
     1295                       , input v-fmtcli-city
     1296                       , input ", ":U
     1297                       , input 50
     1298                       , output v-fmtcli-full-addres
     1299                   ).
     1300                   run fmtcli-concatenate-strings in this-procedure (
     1301                         input v-fmtcli-full-addres
     1302                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1303                       , input ", ":U
     1304                       , input 50
     1305                       , output v-fmtcli-full-addres
     1306                   ).
     1307                   run fmtcli-concatenate-strings in this-procedure (
     1308                         input v-fmtcli-post-addres
     1309                       , input v-fmtcli-country
     1310                       , input ", ":U
     1311                       , input 50
     1312                       , output v-fmtcli-post-addres
     1313                   ).
     1314                   run fmtcli-concatenate-strings in this-procedure (
     1315                         input v-fmtcli-post-addres
     1316                       , input v-fmtcli-city
     1317                       , input ", ":U
     1318                       , input 50
     1319                       , output v-fmtcli-post-addres
     1320                   ).
     1321                   run fmtcli-concatenate-strings in this-procedure (
     1322                         input v-fmtcli-post-addres
     1323                       , input string( buf_firm.ind )
     1324                       , input ", ":U
     1325                       , input 50
     1326                       , output v-fmtcli-post-addres
     1327                   ).
     1328                   run fmtcli-concatenate-strings in this-procedure (
     1329                         input substring( buf_firm.addres1, 1, 50 )
     1330                       , input buf_firm.addres2
     1331                       , input " ":U
     1332                       , input 50
     1333                       , output v-temp-fmtcli-address
     1334                   ).
     1335                   run fmtcli-concatenate-strings in this-procedure (
     1336                         input v-temp-fmtcli-address
     1337                       , input substring( buf_firm.addres1, 51, 50 )
     1338                       , input " ":U
     1339                       , input 50
     1340                       , output v-temp-fmtcli-address
     1341                   ).
     1342                   run fmtcli-concatenate-strings in this-procedure (
     1343                         input v-temp-fmtcli-address
     1344                       , input substring( buf_firm.addres1, 101, 50 )
     1345                       , input " ":U
     1346                       , input 50
     1347                       , output v-temp-fmtcli-address
     1348                   ).
     1349                   assign
     1350                       v-fmtcli-addres = v-temp-fmtcli-address
     1351                   .
     1352                   if buf_firm.addres1 <> ?
     1353                   then do:
     1354                       run fmtcli-concatenate-strings in this-procedure (
     1355                             input v-fmtcli-full-addres
     1356                           , input v-fmtcli-addres
     1357                           , input ", ":U
     1358                           , input 0
     1359                           , output v-fmtcli-full-addres
     1360                       ).
     1361                   end.
     1362                   run fmtcli-concatenate-strings in this-procedure (
     1363                         input substring( buf_firm.post-addr1, 1, 50 )
     1364                       , input buf_firm.post-addr2
     1365                       , input " ":U
     1366                       , input 50
     1367                       , output v-fmtcli-post-addres
     1368                   ).
     1369                   run fmtcli-concatenate-strings in this-procedure (
     1370                         input v-fmtcli-post-addres
     1371                       , input substring( buf_firm.post-addr1, 51, 50 )
     1372                       , input " ":U
     1373                       , input 50
     1374                       , output v-fmtcli-post-addres
     1375                   ).
     1376                   run fmtcli-concatenate-strings in this-procedure (
     1377                         input v-fmtcli-post-addres
     1378                       , input substring( buf_firm.post-addr1, 101, 50 )
     1379                       , input " ":U
     1380                       , input 50
     1381                       , output v-fmtcli-post-addres
     1382                   ).
     1383                   assign
     1384                       v-fmtcli-phone         = buf_firm.phone
     1385                       v-fmtcli-inn           = buf_firm.inn
     1386                       v-fmtcli-kpp           = buf_firm.kpp
     1387                       v-fmtcli-okpo          = buf_firm.okpo
     1388                       v-fmtcli-index         = string( buf_firm.ind )
     1389                   .
     1390               end.
     1391          end.
     1392          when 'маг':U
     1393          then do:
     1394               find first buf_shop no-lock
     1395                    where buf_shop.obj-code = buf_clients.obj-code
     1396               .
     1397               if available buf_shop
     1398               then do:
     1399                   run fmtcli-concatenate-strings in this-procedure (
     1400                         input buf_shop.addres1
     1401                       , input buf_shop.addres2
     1402                       , input " ":U
     1403                       , input 50
     1404                       , output v-fmtcli-addres
     1405                   ).
     1406                   assign
     1407                       v-fmtcli-full-addres = v-fmtcli-addres
     1408                       v-fmtcli-post-addres = v-fmtcli-addres
     1409                       v-fmtcli-phone       = buf_shop.phone
     1410                       v-fmtcli-inn         = "":U
     1411                       v-fmtcli-kpp         = "":U
     1412                       v-fmtcli-okpo        = "":U
     1413                       v-fmtcli-city        = "":U
     1414                       v-fmtcli-index       = "":U
     1415                   .
     1416               end.
     1417          end.
     1418          when 'скл':U
     1419          then do:
     1420               find first buf_store no-lock
     1421                    where buf_store.obj-code = buf_clients.obj-code
     1422               .
     1423               if available buf_store
     1424               then do:
     1425                   run fmtcli-concatenate-strings in this-procedure (
     1426                         input buf_store.addres1
     1427                       , input buf_store.addres2
     1428                       , input " ":U
     1429                       , input 50
     1430                       , output v-fmtcli-addres
     1431                   ).
     1432                   assign
     1433                       v-fmtcli-full-addres = v-fmtcli-addres
     1434                       v-fmtcli-phone       = buf_store.phone
     1435                       v-fmtcli-inn         = "":U
     1436                       v-fmtcli-kpp         = "":U
     1437                       v-fmtcli-okpo        = "":U
     1438                       v-fmtcli-city        = "":U
     1439                       v-fmtcli-index       = "":U
     1440                   .
     1441               end.
     1442          end.
     1443          when 'чел':U
     1444          then do:
     1445               find first buf_person no-lock
     1446                    where buf_person.psn-code = buf_clients.obj-code
     1447               .
     1448               if available buf_person
     1449               then do:
     1450                   run fmtcli-concatenate-strings in this-procedure (
     1451                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1452                                 then "":U
     1453                                 else string( buf_person.ind, "999999")
     1454                                 )
     1455                       , input buf_person.city
     1456                       , input ", ":U
     1457                       , input 0
     1458                       , output v-fmtcli-full-addres
     1459                   ).
     1460                   assign
     1461                       v-fmtcli-addres = buf_person.address
     1462                   .
     1463                   run fmtcli-concatenate-strings in this-procedure (
     1464                         input v-fmtcli-full-addres
     1465                       , input v-fmtcli-addres
     1466                       , input ", ":U
     1467                       , input 0
     1468                       , output v-fmtcli-full-addres
     1469                   ).
     1470                   assign
     1471                       v-fmtcli-phone     = buf_person.phone1
     1472                       v-fmtcli-inn       = buf_person.inn
     1473                       v-fmtcli-kpp       = buf_person.kpp
     1474                       v-fmtcli-okpo      = buf_person.okpo
     1475                       v-fmtcli-city      = buf_person.city
     1476                       v-fmtcli-index     = string( buf_person.ind )
     1477                   .
     1478               end.
     1479          end.
     1480       end case.
     1481   end.
     1482   end procedure.
     1483   procedure fmtcli-concatenate-strings :
     1484   define input parameter p-string-1       as character        no-undo.
     1485   define input parameter p-string-2       as character        no-undo.
     1486   define input parameter p-delimiter      as character        no-undo.
     1487   define input parameter p-length         as integer          no-undo.
     1488   define output parameter p-out-string    as character        no-undo.
     1489   do
     1490   on error undo, return error
     1491   :
     1492       assign
     1493           p-out-string = ( if p-string-1 = ?
     1494                            then "":U
     1495                            else trim( p-string-1 ) )
     1496       .
     1497       assign
     1498           p-out-string = p-out-string
     1499                        + ( if p-out-string = "":U
     1500                            or length( p-out-string ) = p-length
     1501                            or p-string-2 = ?
     1502                            or trim( p-string-2 ) = "":U
     1503                            then "":U
     1504                            else p-delimiter )
     1505                        + ( if p-string-2 = ?
     1506                            or trim( p-string-2 ) = "":U
     1507                            then "":U
     1508                            else trim( p-string-2 ) )
     1509       .
     1510   end.
     1511   end procedure.
