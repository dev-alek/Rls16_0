      963     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      964     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      965     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      966     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      967     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      968     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      969     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      970     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      971     IF "":U = "":U THEN
      972       RUN modify-list-attribute IN adm-broker-hdl
      973         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      974     RUN use-create-on-add(?).
      975   PROCEDURE adm-add-record :
