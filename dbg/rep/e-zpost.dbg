      760        SIZE 19 BY .83 NO-UNDO.
      761   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      762        LABEL "с уровня":L
      763        VIEW-AS TOGGLE-BOX
      764        SIZE 12.63 BY .79 NO-UNDO.
      765   DEFINE VARIABLE Tog-lavel-2 AS LOGICAL INITIAL no
      766        LABEL "с уровня":L
      767        VIEW-AS TOGGLE-BOX
      768        SIZE 12.63 BY .79 NO-UNDO.
