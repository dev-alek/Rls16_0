      686   CREATE WIDGET-POOL.
      687   define variable State-source as  WIDGET-HANDLE.
      688   def buffer cli-post for clients .
      689   def New SHARED temp-table g#post NO-UNDO
      690       field obj-type like ub.clients.obj-type
      691       field obj-code like ub.clients.obj-code
      692       field obj-name like ub.clients.obj-name
      693       INDEX pi IS UNIQUE PRIMARY obj-type obj-code.
      694   define variable  post-grp_recids as character no-undo .
      695   define variable ii as integer no-undo .
      696   DEFINE VARIABLE PostName AS CHARACTER
      697        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      698        SIZE 31 BY 2.46 TOOLTIP "Список выбранных Поставщиков"
      699        FONT 4 NO-UNDO.
      700   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      701        VIEW-AS FILL-IN NATIVE
      702        SIZE 5 BY .79 NO-UNDO.
      703   DEFINE VARIABLE var-lavel-2 AS INTEGER FORMAT ">>9":U INITIAL 1
      704        VIEW-AS FILL-IN NATIVE
      705        SIZE 5 BY .79 NO-UNDO.
      706   DEFINE VARIABLE Classify AS CHARACTER
      707        VIEW-AS RADIO-SET VERTICAL
      708        RADIO-BUTTONS
      709             "Без классификации", "no-classify":U,
      710   "Группы поставщиков", "post":U,
      711   "Группы товаров", "grp-goods":U,
      712   "Группы поставщиков/Группы товаров", "post/grp-goods":U,
      713   "Группы товаров/Группы поставщиков", "grp-goods/post":U,
      714   "Производители", "prod":U
      715        SIZE 38.5 BY 5.17 NO-UNDO.
      716   DEFINE VARIABLE RADPost AS INTEGER
      717        VIEW-AS RADIO-SET VERTICAL
      718        RADIO-BUTTONS
      719             "все", 1,
      720   "Выборочно", 2
      721        SIZE 12 BY 2.17 NO-UNDO.
      722   DEFINE VARIABLE SortType AS CHARACTER
      723        VIEW-AS RADIO-SET VERTICAL
      724        RADIO-BUTTONS
      725             "по коду", "sort-code":U,
      726   "по артикулу", "sort-article":U,
      727   "по наимен.", "sort-name":U
      728        SIZE 14 BY 2.17 NO-UNDO.
      729   DEFINE VARIABLE type-stor AS INTEGER
      730        VIEW-AS RADIO-SET VERTICAL
      731        RADIO-BUTTONS
      732             "все", 1,
      733   "выкуп", 2,
      734   "консигнация", 3,
      735   "мат.хранение", 4,
      736   "cтарая консигнация", 5
      737        SIZE 21.88 BY 4.17 NO-UNDO.
      738   DEFINE RECTANGLE RECT-5
