      753   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
      754        LABEL "Нулевые остатки":L
      755        VIEW-AS TOGGLE-BOX
      756        SIZE 23.25 BY .83 NO-UNDO.
      757   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      758        LABEL "Только итоги":L
