      770        LABEL "Раздельно по объектам":L
      771        VIEW-AS TOGGLE-BOX
      772        SIZE 38.25 BY 1 NO-UNDO.
      773   DEFINE FRAME F-Main
      774        PostName AT ROW 1.92 COL 15.38 NO-LABEL
      775        RADPost AT ROW 2 COL 2.75 NO-LABEL
      776        SortType AT ROW 2.5 COL 51.88 NO-LABEL
      777        Tog-obj AT ROW 5.54 COL 2.75
      778        type-stor AT ROW 5.92 COL 48.13 NO-LABEL
      779        Classify AT ROW 6.79 COL 2.75 NO-LABEL
      780        Tog-lavel-2 AT ROW 7.75 COL 28.25
      781        var-lavel-2 AT ROW 7.75 COL 39.13 COLON-ALIGNED NO-LABEL
      782        var-lavel AT ROW 8.58 COL 39.13 COLON-ALIGNED NO-LABEL
      783        Tog-lavel AT ROW 8.63 COL 28.25
      784        ShowZero AT ROW 16.58 COL 2.75
      785        SumsOnly AT ROW 16.58 COL 27
      786        "Классификация :" VIEW-AS TEXT
      787             SIZE 15 BY .75 AT ROW 4.83 COL 7.13
      788             FGCOLOR 4
      789        "Сортировка :" VIEW-AS TEXT
      790             SIZE 13.63 BY .75 AT ROW 1.42 COL 51.88
      791             FGCOLOR 4
      792        "Показать :" VIEW-AS TEXT
      793             SIZE 11.5 BY .75 AT ROW 12.33 COL 7
      794             FGCOLOR 4
      795        "Выбор поставщика:" VIEW-AS TEXT
      796             SIZE 19.38 BY .67 AT ROW 1.25 COL 7.13
      797             FGCOLOR 4
      798        RECT-8 AT ROW 12.13 COL 1.75
      799        RECT-9 AT ROW 5.5 COL 47.75
      800        RECT-5 AT ROW 4.5 COL 1.75
      801        RECT-7 AT ROW 1.04 COL 1.75
      802        RECT-6 AT ROW 1.04 COL 47.75
      803       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      804            SIDE-LABELS NO-UNDERLINE THREE-D
      805            AT COL 1 ROW 1 SCROLLABLE .
      806   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      807   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      808   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      809   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      810   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      811   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      812   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      813   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      814         adm-object-hdl = FRAME F-Main:HANDLE.
      815   RUN ensure-broker.
      816   THIS-PROCEDURE:ADM-DATA =
      817        'ADM1.1~`':U +
      818        'SmartObject~`':U +
      819        '~`':U +
      820        'NO ~`':U +
      821        '~`':U +
      822        '~`':U +
      823        '~`':U +
      824        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      825           + "~`":U +
      826        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      827        'Record-Source,Record-Target,TableIO-Target~`':U +
      828        '~`':U +
      829        '~`~`~`~`~`~`~`~`~`~`~`':U +
      830        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      831            THEN "^^":U
      832        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      833             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      834   PROCEDURE adm-apply-entry :
      835     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      836   END PROCEDURE.
      837   PROCEDURE adm-destroy :
      838    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      839   END PROCEDURE.
      840   PROCEDURE adm-disable :
      841       DISABLE RECT-8 RECT-9 RECT-5 RECT-7 RECT-6 PostName RADPost SortType Tog-obj type-stor Classify ShowZero SumsOnly WITH FRAME F-Main.
      842       RUN dispatch ('disable-fields':U).
      843       RUN set-attribute-list ('ENABLED=no':U).
      844       RETURN.
      845   END PROCEDURE.
      846   PROCEDURE adm-edit-attribute-list :
      847         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      848         RETURN.
      849   END PROCEDURE.
      850   PROCEDURE adm-enable :
      851       ENABLE UNLESS-HIDDEN RECT-8 RECT-9 RECT-5 RECT-7 RECT-6 PostName RADPost SortType Tog-obj type-stor Classify ShowZero SumsOnly WITH FRAME F-Main.
      852       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      853       RUN set-attribute-list ('ENABLED=yes':U).
      854       RETURN.
      855   END PROCEDURE.
      856   PROCEDURE adm-exit :
      857        RUN notify ('exit':U).
      858     RETURN.
      859   END PROCEDURE.
      860   PROCEDURE adm-hide :
      861     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      862   END PROCEDURE.
      863   PROCEDURE adm-initialize :
      864     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      865   END PROCEDURE.
      866   PROCEDURE adm-show-errors :
      867       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      868       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      869           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      870       END.
      871       RETURN.
      872   END PROCEDURE.
      873   PROCEDURE adm-UIB-mode :
      874     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      875   END PROCEDURE.
      876   PROCEDURE adm-view :
      877     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      878   END PROCEDURE.
      879   PROCEDURE dispatch :
      880       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      881       RUN broker-dispatch IN adm-broker-hdl
      882           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      883       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      884   END PROCEDURE.
      885   PROCEDURE ensure-broker :
      886   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      887   IF RETURN-VALUE NE "ADM-Broker":U THEN
      888   DO:
      889       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      890       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      891   END.
      892   END PROCEDURE.
      893   PROCEDURE get-attribute :
      894     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      895     RUN broker-get-attribute IN adm-broker-hdl
      896         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      897     RETURN RETURN-VALUE.
      898   END PROCEDURE.
      899   PROCEDURE get-attribute-list :
      900     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      901     RUN broker-get-attribute-list IN adm-broker-hdl
      902         (INPUT THIS-PROCEDURE,
      903          INPUT ?,
      904          OUTPUT p-attr-list) NO-ERROR.
      905     RETURN.
      906   END PROCEDURE.
      907   PROCEDURE new-state :
      908     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      909     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      910     RETURN.
      911   END PROCEDURE.
      912   PROCEDURE notify :
      913     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      914     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      915     IF RETURN-VALUE = "ADM-ERROR":U THEN
      916         RETURN "ADM-ERROR":U.
      917     RETURN.
      918   END PROCEDURE.
      919   PROCEDURE set-attribute-list :
      920     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      921     RUN ensure-broker.
      922     RUN broker-set-attribute-list IN adm-broker-hdl
      923         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      924     RETURN.
      925   END PROCEDURE.
      926   PROCEDURE set-position :
      927       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      928       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      929       IF VALID-HANDLE(adm-object-hdl) THEN
      930       DO:
      931         ASSIGN adm-object-hdl:ROW    =   p-row
      932                adm-object-hdl:COLUMN =   p-col.
      933       END.
      934       RETURN.
      935   END PROCEDURE.
      936   PROCEDURE adm-display-fields :
      937       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      938       RETURN.
      939   END PROCEDURE.
      940   PROCEDURE adm-open-query :
      941     RETURN.
      942   END PROCEDURE.
      943   PROCEDURE adm-row-changed :
