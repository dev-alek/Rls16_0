     1034   PROCEDURE check-modified :
     1035   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1036   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1037   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1038   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1039     IF check-state = "check":U THEN
     1040     DO:
     1041       RUN get-link-handle IN adm-broker-hdl
     1042         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1043            OUTPUT group-target-list).
     1044       IF group-target-list NE "":U THEN
     1045       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1046         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1047         RUN check-modified IN curr-widget ('group-check':U).
     1048         IF RETURN-VALUE NE "":U THEN
     1049         DO:
     1050           RUN check-modified-message(RETURN-VALUE).
     1051           RETURN "":U.
     1052         END.
     1053       END.
     1054     END.
     1055     RETURN "":U.
     1056   END PROCEDURE.
     1057   PROCEDURE check-modified-message :
     1058     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1059        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1060           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1061        IF RETURN-VALUE = "YES":U THEN
     1062           RUN notify ('view,CONTAINER-SOURCE':U).
     1063        MESSAGE IF p-changed-table NE ? THEN
     1064           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1065           ELSE "Current values have been changed."
     1066           SKIP "  Do you wish to save those changes?"
     1067           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1068        IF ANS THEN
     1069        DO:
     1070           IF group-assign-target THEN
     1071             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1072           ELSE RUN dispatch('update-record':U).
     1073           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1074           DO:
     1075               MESSAGE "Changes to the previous record were not saved."
     1076                 VIEW-AS ALERT-BOX ERROR.
     1077               IF group-assign-target THEN
     1078                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1079               ELSE RUN dispatch ('cancel-record':U).
     1080           END.
     1081        END.
     1082        ELSE DO:
     1083          IF group-assign-target THEN
     1084             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1085          ELSE RUN dispatch('cancel-record':U).
     1086        END.
     1087        RETURN.
     1088   END PROCEDURE.
     1089   PROCEDURE get-rowid :
     1090       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1091       ASSIGN
     1092       p-table   =   adm-first-table.
     1093       RETURN.
     1094   END PROCEDURE.
     1095   PROCEDURE init-group-assign :
     1096       RUN request-attribute IN adm-broker-hdl
     1097         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1098       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1099         group-assign-target = yes.
     1100       ELSE group-assign-target = no.
     1101       RETURN.
     1102   END PROCEDURE.
     1103   PROCEDURE set-editors :
     1104       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1105       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1106       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1107       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1108       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1109       DO WHILE VALID-HANDLE (curr-widget):
     1110           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1111              curr-widget:HIDDEN = no THEN DO:
     1112             CASE p-field-setting:
     1113               WHEN "INITIALIZE":U THEN
     1114               DO:
     1115                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1116                     read-only-list +
     1117                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1118                        STRING(curr-widget).
     1119               END.
     1120               WHEN "DISABLE":U OR
     1121               WHEN "ENABLE":U THEN
     1122               DO:
     1123                   curr-widget:SENSITIVE = yes.
     1124                   RUN get-attribute ('Read-Only-Editors':U).
     1125                   IF RETURN-VALUE = ? OR
     1126                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1127                       curr-widget:READ-ONLY =
     1128                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1129               END.
     1130               WHEN "CLEAR":U THEN
     1131                   curr-widget:SCREEN-VALUE = "":U.
     1132             END CASE.
     1133           END.
     1134           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1135       END.
     1136       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1137         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1138           + '"':U).
     1139       RETURN.
     1140   END PROCEDURE.
     1141   PROCEDURE use-check-modified-all :
     1142    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1143     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1144     RETURN.
     1145   END PROCEDURE.
     1146   PROCEDURE use-create-on-add :
     1147   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1148      RETURN.
     1149   END PROCEDURE.
     1150   PROCEDURE use-initial-lock :
     1151     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1152     ASSIGN adm-initial-lock = p-attr-value.
     1153     RETURN.
     1154   END PROCEDURE.
     1155     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1156   ASSIGN
     1157          FRAME F-Main:SCROLLABLE       = FALSE
     1158          FRAME F-Main:HIDDEN           = TRUE.
     1159   ASSIGN
     1160          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
     1161   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1162   DO:
     1163       Assign Classify.
     1164      if Classify = "grp-goods":U
     1165            Then do:
     1166               display TOG-lavel   with frame F-Main .
     1167               enable  TOG-lavel   with frame F-Main .
     1168           end.
     1169            Else do:
     1170               display  TOG-lavel  var-Lavel with frame F-Main .
     1171               disable  TOG-lavel  var-Lavel with frame F-Main .
     1172           end.
     1173    if Classify = "post":U
     1174            Then do:
     1175               display TOG-lavel-2   with frame F-Main .
     1176               enable  TOG-lavel-2   with frame F-Main .
     1177           end.
     1178            Else do:
     1179               display  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1180               disable  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1181           end.
     1182   END.
     1183   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1184   DO:
     1185     Assign RadPost.
     1186     for each g#post share-lock : delete g#post. end.
     1187     Case RAdPost :
     1188     when 1 then DO:
     1189             Assign  Postname = 'все':U.
     1190             Display PostName with frame F-Main .
     1191          END.
     1192     when 2 then
     1193           do:
     1194               run ref/cli-all.w
     1195               ( my-handle
     1196               , "b-sel,b-mark"
     1197               , 'все':U
     1198               , 'все':U
     1199               , 'текущие':U
     1200               , ?
     1201               , ",,,,,,NO,,"
     1202               , ?
     1203               , output post-grp_recids ) .
     1204               if post-grp_recids = "" then do:
     1205                    Assign  Postname = 'все':U radpost = 1.
     1206                    Display PostName radpost with frame F-Main .
     1207               end.
     1208               else do:
     1209                   Assign  Postname = ''.
     1210                   DO ii = 1 TO num-entries( post-grp_recids ) :
     1211                       FIND cli-post WHERE recid( cli-post ) = int(entry( ii, post-grp_recids )) NO-LOCK.
     1212                       create g#post.
     1213                       assign
     1214                       g#post.obj-type = cli-post.obj-type
     1215                       g#post.obj-code = cli-post.obj-code
     1216                       g#post.obj-name = cli-post.obj-name
     1217                       Postname = PostName + cli-post.obj-name + chr(10).
     1218                   END.
     1219                    Display PostName with frame F-Main .
     1220               end.
     1221           end.
     1222     End case.
     1223     END.
     1224   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1225   DO:
     1226      Assign tog-lavel.
     1227     if tog-lavel =TRUE
     1228           Then do:
     1229               display  var-Lavel  with frame F-Main .
     1230               enable   var-Lavel  with frame F-Main .
     1231           end.
     1232            Else do:
     1233               display    var-Lavel with frame F-Main .
     1234               disable    var-Lavel with frame F-Main .
     1235           end.
     1236   END.
     1237   ON VALUE-CHANGED OF Tog-lavel-2 IN FRAME F-Main
     1238   DO:
     1239      Assign tog-lavel-2.
     1240     if tog-lavel-2 = TRUE
     1241           Then do:
     1242               display  var-Lavel-2  with frame F-Main .
     1243               enable   var-Lavel-2  with frame F-Main .
     1244           end.
     1245            Else do:
     1246               display    var-Lavel-2 with frame F-Main .
     1247               disable    var-Lavel-2 with frame F-Main .
     1248           end.
     1249   END.
     1250   ON VALUE-CHANGED OF Tog-obj IN FRAME F-Main
     1251   DO:
     1252     assign Tog-obj.
     1253     if tog-obj = false then do:
     1254       assign
     1255         Classify    = "no-classify"
     1256         SumsOnly    = true
     1257         type-stor   = 1
     1258         ShowZero    = false
     1259         tog-Lavel-2 = false
     1260         tog-Lavel   = false
     1261         .
     1262         display Classify SumsOnly type-stor ShowZero  var-Lavel-2 var-Lavel tog-Lavel-2 tog-Lavel with frame F-Main.
     1263         disable Classify SumsOnly type-stor  ShowZero var-Lavel-2 var-Lavel tog-Lavel-2 tog-Lavel  with frame F-Main.
     1264     End.
     1265     Else do:
     1266       display Classify SumsOnly type-stor ShowZero  with frame F-Main.
     1267       enable Classify SumsOnly type-stor ShowZero  with frame F-Main.
     1268     End.
     1269   END.
     1270   if not this-procedure :persistent
     1271   then do:
     1272     message
     1273       vss-workfile vss-revision vss-description skip
     1274       "Ошибка при запуске процедуры" skip
     1275       "Данную процедуру следует запускать только с параметром persistent" skip
     1276       view-as alert-box error .
     1277     undo, return error .
     1278   end.
     1279   PROCEDURE disable_UI :
     1280     HIDE FRAME F-Main.
     1281     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1282   END PROCEDURE.
     1283   PROCEDURE local-initialize :
     1284     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1285      Tog-obj:screen-value in frame F-Main = 'yes':U.
     1286       var-lavel:screen-value in frame F-Main = '1'.
     1287       var-lavel-2:screen-value in frame F-Main = '1'.
     1288   END PROCEDURE.
     1289   PROCEDURE my-report :
     1290   define variable par-val as character no-undo .
     1291   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   empty temp-table thbjattr_thbj-attr.
     1293   run adm/shattri.p (
     1294      input "get":U
     1295     ,input v-cntxt-obj-type
     1296     ,input v-cntxt-obj-code
     1297     ,input 'rezerv-obj':U
     1298     ,input  ""
     1299     ,output v-value-character
     1300     ,output v-value-date
     1301     ,output v-value-decimal
     1302     ,output v-value-integer
     1303     ,output v-value-logical
     1304     ,output par-type
     1305     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1306     ) no-error .
     1307   for each thbjattr_thbj-attr :
     1308       if thbjattr_thbj-attr.prop-code = 'negparts'  then par-val  = thbjattr_thbj-attr.property-value-character.
     1309   end.
     1310   if CAPS(par-val) <> "DISABLE" Then do:
     1311    BELL.
     1312    Message
     1313       "В системе разрешена работа с отрицательными партиями, "
     1314       "поэтому отчет по товарам поставщика может выдать сумму "
     1315       "остатка большую, чем состояние запаса по этому товару. " skip
     1316       "Разница отнесена на текущую фирму, поскольку поставщиком "
     1317       "в партиях отрицательных остатков считается текущая фирма. " skip
     1318       "Отрицательные партии товара могут быть скомпенсированы "
     1319       "в документе инвентаризации операцией пересортицы по партиям. "
     1320       view-as alert-box information.
     1321   End.
     1322    run rep/r-zpost.p
     1323       (input v-cntxt-obj-code ,
     1324       input v-cntxt-obj-type ,
     1325       input base-type  ,
     1326       input base-code  ,
     1327       ?, ? , ? ,PostName, ? , RADPost, ?  ,? ,
     1328       input Classify   ,
     1329       input SortType   ,
     1330       input SumsOnly   ,
     1331       input ShowZero   ,
     1332       input tog-obj    ,
     1333       input ? ,
     1334       input type-stor ,
     1335       input tog-lavel  ,
     1336       input var-lavel  ,
     1337       input tog-lavel-2  ,
     1338       input var-lavel-2  ) .
     1339   END PROCEDURE.
     1340   PROCEDURE my-var :
     1341   assign frame F-Main
     1342   PostName  RADPost type-stor
     1343   ShowZero Classify  SortType
     1344   SumsOnly Tog-obj
     1345   Tog-lavel  var-lavel Tog-lavel-2  Var-lavel-2 .
     1346   def var t-class as char no-undo.
     1347   def var t-sort as char no-undo.
     1348     case classify:
     1349       when "no-classify":u    then t-class =   "Без классификации" .
     1350       when "prod":u           then t-class =   "Производители"   .
     1351       when "post":u           then t-class =   "Поставщики"   .
     1352       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1353       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1354       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1355       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1356       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1357       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1358       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1359       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1360       when  "t-level":u       then t-class =   "Терминальные группы" .
     1361    end case.
     1362     case sorttype:
     1363       when "sort-pp":u               then t-sort =   "по порядку" .
     1364       when "sort-code":u             then t-sort =   "по коду" .
     1365       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1366       when "sort-qunty":u            then t-sort =   "по реализации".
     1367       when "sort-name":u             then t-sort =   "по наименованию".
     1368       when "sort-type":u             then t-sort =   "по типу ткани".
     1369       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1370       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1371    end case.
     1372   ReportNAme = "Состояние запаса по поставщикам " + str1 .
     1373   ReportHeader = "Поставщики : " + PostName  + chr(10).
     1374   ReportHeader = ReportHeader + "Классификация : " + t-Class .
     1375   ReportHeader = ReportHeader +
     1376                  (if tog-lavel  then "    Итоги с уровня товаров "  + String(var-lavel)  else " "    ).
     1377   ReportHeader = ReportHeader +
     1378                  (if tog-lavel-2  then "    Итоги с уровня поставщиков "  + String(var-lavel-2)  else " "    ).
     1379   ReportHeader = ReportHeader  + chr(10) +
     1380                  "Сортировка " + t-Sort
     1381                  + chr(10) +
     1382                  "Показать : " +
     1383                  (if SumsOnly     then "Только итоги, "  else " "             ) +
     1384                  (if ShowZero     then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) .
     1385   ReportHeader =  ReportHeader  + chr(10) + Entry(((type-stor * 2) - 1), type-stor:RADIO-BUTTONS) .
     1386   ReportHeader = ReportHeader  + chr(10) .
     1387   if X-SET_PAY_TYPE <> 2 then str3 =  "в ценах РЕАЛИЗАЦИИ".
     1388    sheetf.Excel-Column-Lable =  "Код,Артикул,Артикул поставщика,Название товара,Ед.изм,Количество,Цена,Стоимость,НДС,НП,Стоимость без НДС,".
     1389    sheetf.Sizes = "10,16,16,60,7,13,13,13,13,13,13,".
     1390    Sheetf.ColFOrmat = "2=@;3=@;4=@"  .
     1391     str1 = ' '  .
     1392   END PROCEDURE.
