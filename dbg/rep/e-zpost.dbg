      958     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      959     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      960     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      961     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
