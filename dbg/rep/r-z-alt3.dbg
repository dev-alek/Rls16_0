     4505           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4506           display STREAM OutStream    with frame top-frame .
     4507       End.
     4508     End.
     4509     if c-f-cost-sum-alt <>  ?  then do :
     4510       c-f-cost-sum-alt:screen-value = string(accum TOTAL f-cost-sum-alt) .
     4511       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4512           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4513           display STREAM OutStream    with frame top-frame .
     4514       End.
     4515     End.
     4516     if c-f-sale-sum-alt <>  ?  then do :
     4517       c-f-sale-sum-alt:screen-value = string(accum TOTAL f-sale-sum-alt) .
     4518       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4519           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4520           display STREAM OutStream    with frame top-frame .
     4521       End.
     4522     End.
     4523     if c-f-sale-other-alt <>  ?  then do :
     4524       c-f-sale-other-alt:screen-value = string(accum TOTAL f-sale-other-alt) .
     4525       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4526           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4527           display STREAM OutStream    with frame top-frame .
     4528       End.
     4529     End.
     4530     Display stream OutStream with FRAME Zapas no-error.
     4531     DOWN stream OutStream with FRAME Zapas.
     4532     run u-line.
     4533     if Make-Excel then  put   stream ForExcel unformatted
     4534             "ИТОГО"                         CHR(9)
     4535             "по объектам"                    CHR(9)
     4536                                                CHR(9) CHR(9) CHR(9)
     4537             excel-qnty(accum TOTAL f-qnty           )  CHR(9)
     4538             excel-sum (accum TOTAL f-cost-sum       )  CHR(9)
     4539             excel-sum (accum TOTAL f-sale-sum       )  CHR(9)
     4540             excel-sum (accum TOTAL f-sale-other    )   CHR(9)
     4541             excel-qnty(accum TOTAL f-qnty-alt           )  CHR(9)
     4542             excel-sum (accum TOTAL f-cost-sum-alt       )  CHR(9)
     4543             excel-sum (accum TOTAL f-sale-sum-alt       )  CHR(9)
     4544             excel-sum (accum TOTAL f-sale-other-alt    )   CHR(9)
     4545             chr(10) .
     4546   END PROCEDURE.
     4547   PROCEDURE Display-prt :
     4548   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4549   IF gds-list.prt-root <> Prtroot Then DO:
     4550       for each ub.gds-prt no-lock where
     4551           ub.gds-prt.prt-root = gds-list.prt-root and
     4552           ub.gds-prt.IS-term   =  true
     4553           by ub.gds-prt.f-name with FRAME Zapas :
     4554               For each obj-list no-lock :
     4555                   for each ub.prt-obj no-lock where
     4556                       ub.prt-obj.artic     = gds-list.artic     and
     4557                       ub.prt-obj.prod-type = gds-list.prod-type and
     4558                       ub.prt-obj.prod-code = gds-list.prod-code and
     4559                       ub.prt-obj.obj-code  = obj-list.obj-code and
     4560                       ub.prt-obj.obj-type  = obj-list.obj-type and
     4561                       ub.prt-obj.IS-term   =  true and
     4562                       ub.prt-obj.prt-code  = ub.gds-prt.node-code :
     4563                       Assign
     4564                         p-qnty      = p-qnty       + ub.prt-obj.fact-qnty
     4565                         p-sale-sum  = p-sale-sum   + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     4566                   End.
     4567               End.
     4568               Assign
     4569                 p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     4570                 p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     4571                 .
     4572               For each alt-obj-list no-lock :
     4573                   for each ub.prt-obj no-lock where
     4574                       ub.prt-obj.artic     = gds-list.artic     and
     4575                       ub.prt-obj.prod-type = gds-list.prod-type and
     4576                       ub.prt-obj.prod-code = gds-list.prod-code and
     4577                       ub.prt-obj.obj-code  = alt-obj-list.obj-code and
     4578                       ub.prt-obj.obj-type  = alt-obj-list.obj-type and
     4579                       ub.prt-obj.IS-term   = true and
     4580                       ub.prt-obj.prt-code  = ub.gds-prt.node-code
     4581                       :
     4582                       assign
     4583                         p-qnty-alt      = p-qnty-alt       + ub.prt-obj.fact-qnty
     4584                         p-sale-sum-alt  = p-sale-sum-alt   + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale
     4585                      .
     4586                   end.
     4587               end.
     4588               assign
     4589                 p-cost-sum-alt     = determined( f-cost-sum-alt * p-qnty-alt  / f-qnty-alt)
     4590                 p-sale-other-alt   = 100 * determined ((p-sale-sum-alt - p-cost-sum-alt) / p-cost-sum-alt)
     4591                 .
     4592               if  NOT(
     4593                     p-qnty      =  0  and
     4594                     p-cost-sum    =  0  and
     4595                     p-sale-sum    =  0  and
     4596                     p-sale-other  =  0 and
     4597                     p-qnty-alt      =  0  and
     4598                     p-cost-sum-alt    =  0  and
     4599                     p-sale-sum-alt    =  0  and
     4600                     p-sale-other-alt  =  0
     4601                     ) then DO:
     4602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4603     (input  gds-list.gds-code
     4604     ,input  ub.gds-prt.node-code
     4605     ,output v-bar-code
     4606     )  .
     4607     if c-nn <>  ?  then do :
     4608       c-nn:screen-value = string('') .
     4609       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4610           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4611           display STREAM OutStream    with frame top-frame .
     4612       End.
     4613     End.
     4614     if c-f-artic <>  ?  then do :
     4615       c-f-artic:screen-value = string('') .
     4616       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4617           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4618           display STREAM OutStream    with frame top-frame .
     4619       End.
     4620     End.
     4621     if c-f-b-code <>  ?  then do :
     4622       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     4623       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4624           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4625           display STREAM OutStream    with frame top-frame .
     4626       End.
     4627     End.
     4628     if c-f-prt-name <>  ?  then do :
     4629       c-f-prt-name:screen-value = string(ub.gds-prt.f-name) .
     4630       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4631           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4632           display STREAM OutStream    with frame top-frame .
     4633       End.
     4634     End.
     4635     if c-f-qnty <>  ?  then do :
     4636       c-f-qnty:screen-value = string(p-qnty) .
     4637       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4638           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4639           display STREAM OutStream    with frame top-frame .
     4640       End.
     4641     End.
     4642     if c-f-cost-sum <>  ?  then do :
     4643       c-f-cost-sum:screen-value = string(p-cost-sum) .
     4644       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4645           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4646           display STREAM OutStream    with frame top-frame .
     4647       End.
     4648     End.
     4649     if c-f-sale-sum <>  ?  then do :
     4650       c-f-sale-sum:screen-value = string(p-sale-sum) .
     4651       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4652           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4653           display STREAM OutStream    with frame top-frame .
     4654       End.
     4655     End.
     4656     if c-f-sale-other <>  ?  then do :
     4657       c-f-sale-other:screen-value = string(p-sale-other) .
     4658       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4659           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4660           display STREAM OutStream    with frame top-frame .
     4661       End.
     4662     End.
     4663     if c-f-qnty-alt <>  ?  then do :
     4664       c-f-qnty-alt:screen-value = string(p-qnty-alt) .
     4665       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4666           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4667           display STREAM OutStream    with frame top-frame .
     4668       End.
     4669     End.
     4670     if c-f-cost-sum-alt <>  ?  then do :
     4671       c-f-cost-sum-alt:screen-value = string(p-cost-sum-alt) .
     4672       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4673           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4674           display STREAM OutStream    with frame top-frame .
     4675       End.
     4676     End.
     4677     if c-f-sale-sum-alt <>  ?  then do :
     4678       c-f-sale-sum-alt:screen-value = string(p-sale-sum-alt) .
     4679       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4680           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4681           display STREAM OutStream    with frame top-frame .
     4682       End.
     4683     End.
     4684     if c-f-sale-other-alt <>  ?  then do :
     4685       c-f-sale-other-alt:screen-value = string(p-sale-other-alt) .
     4686       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4687           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4688           display STREAM OutStream    with frame top-frame .
     4689       End.
     4690     End.
     4691                   Display stream OutStream no-error.
     4692                   DOWN stream OutStream .
     4693                       if Make-Excel then  put   stream ForExcel unformatted
     4694                        string(n-nn)                 CHR(9)
     4695                        v-bar-code                   CHR(9)
     4696                                                     CHR(9)
     4697                                                     CHR(9)
     4698                        ub.gds-prt.f-name               CHR(9)
     4699                        excel-qnty(p-qnty        )   CHR(9)
     4700                        excel-sum (p-cost-sum    )   CHR(9)
     4701                        excel-sum (p-sale-sum    )   CHR(9)
     4702                        excel-sum (p-sale-other  )   CHR(9)
     4703                        excel-qnty(p-qnty-alt      ) CHR(9)
     4704                        excel-sum (p-cost-sum-alt  ) CHR(9)
     4705                        excel-sum (p-sale-sum-alt  ) CHR(9)
     4706                        excel-sum (p-sale-other-alt) CHR(9)
     4707                        chr(10) .
     4708               End.
     4709               Assign
     4710                 p-qnty            =  0
     4711                 p-cost-sum        =  0
     4712                 p-sale-sum        =  0
     4713                 p-sale-other      =  0
     4714                 p-qnty-alt        =  0
     4715                 p-cost-sum-alt    =  0
     4716                 p-sale-sum-alt    =  0
     4717                 p-sale-other-alt  =  0
     4718                 .
     4719       End.
     4720   End.
     4721   END PROCEDURE.
     4722   PROCEDURE on-same-page :
     4723     define input parameter p-line-number as integer  no-undo .
     4724     if p-line-number > page-size( OutStream ) then do:
     4725       return .
     4726     end.
     4727     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     4728       page stream OutStream .
     4729     end.
     4730   end procedure.
     4731   PROCEDURE ostatok :
     4732   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4733   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4734   def input parameter x-tog-shift   as   logical             no-undo.
     4735   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4736   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4737   def input parameter x-shift-start as integer               no-undo.
     4738   def input parameter x-shift-end   as integer               no-undo.
     4739   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4740   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4741   def input parameter xTog-obj   as log no-undo.
     4742   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4743   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4744   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4745   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4746   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4747   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4748   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4749   def var              Fact-orderS   as char  no-undo.
     4750   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4751      Assign
     4752         Fact-order   = 0
     4753         Quantity     = 0
     4754         Coast_R      = 0
     4755         Coast_V      = 0
     4756         VAT_R        = 0
     4757         VAT_V        = 0 .
     4758    x-date-start-t  = x-date-start + 1 .
     4759   IF x-date-end = date('') then DO:
     4760      Fact-order = 0 .
     4761      for each obj-list
     4762          where  ( not xtog-obj or
     4763                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4764                 no-lock :
     4765         if  x-tog-shift = false then do:
     4766                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4767                               ub.stk-tot.Fact-date <=  x-date-start
     4768                               and ub.stk-tot.shift-num = 0
     4769                               USE-INDEX fact-date no-lock no-error .
     4770              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4771         End.
     4772         Else  DO :
     4773             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4774              (ub.stk-tot.shift-date  = x-date-start-t and
     4775               ub.stk-tot.shift-num  < x-shift-start or
     4776               ub.stk-tot.shift-date  < x-date-start-t  )
     4777               and ub.stk-tot.shift-num  > 0
     4778               USE-INDEX Shift-num no-lock no-error .
     4779            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4780           END.
     4781       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4782     End.
     4783   End.
     4784   Else DO:
     4785     For each obj-list  WHERE
     4786        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4787         no-lock :
     4788      IF  x-TOG-Shift = False Then DO:
     4789          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4790               ub.stk-tot.Fact-date <= x-date-end
     4791               and ub.stk-tot.shift-num = 0
     4792               USE-INDEX fact-date no-lock no-error.
     4793          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4794      END.
     4795      Else DO:
     4796           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4797               (ub.stk-tot.shift-date  = x-date-end and
     4798               ub.stk-tot.shift-num  <= x-shift-end or
     4799               ub.stk-tot.shift-date  < x-date-end       ) and
     4800               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4801               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4802       End.
     4803       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4804     End.
     4805   End.
     4806   END PROCEDURE.
     4807   procedure init-gds-list :
     4808     do
     4809     on error undo, return error return-value
     4810     :
     4811     run waitfram-show ( "Подготовка списка товара..." ).
     4812       if x-SelectGood <> 1 then do:
     4813           for each obj-list :
     4814              for each ub.gds-obj no-lock where ub.gds-obj.obj-type =  obj-list.obj-type and
     4815                                             ub.gds-obj.obj-code =  obj-list.obj-code   :
     4816                   find first gds-list      where gds-list.gds-code = ub.gds-obj.gds-code no-error .
     4817                   if available gds-list then do:
     4818                       if gds-list.gds-type   <> 'т':U or (p-show-qnty = true  and ub.gds-obj.fact-qnty <= 0 ) then do:
     4819                             delete gds-list .
     4820                       end.
     4821                       else do:
     4822                          if classify = 4 then
     4823                          gds-list.qnty = func-vat (gds-list.gds-code,ub.gds-obj.obj-type,ub.gds-obj.obj-code) .
     4824                       end.
     4825                   end.
     4826              end.
     4827           end.
     4828       end.
     4829       else do:
     4830           for each obj-list :
     4831              for each ub.gds-obj no-lock where ub.gds-obj.obj-type =  obj-list.obj-type and
     4832                                             ub.gds-obj.obj-code =  obj-list.obj-code   :
     4833                   find first gds-list      where gds-list.gds-code = ub.gds-obj.gds-code no-error .
     4834                   if not available gds-list then do:
     4835                       if (p-show-qnty = true  and ub.gds-obj.fact-qnty > 0) or p-show-qnty = false then do:
     4836                           find first ub.goods no-lock where ub.goods.gds-code = ub.gds-obj.gds-code no-error .
     4837                           create gds-list.
     4838                           BUFFER-COPY ub.goods TO gds-list.
     4839                            if classify = 4 then
     4840                            gds-list.qnty = func-vat (gds-list.gds-code,ub.gds-obj.obj-type,ub.gds-obj.obj-code) .
     4841                       end.
     4842                   end.
     4843              end.
     4844           end.
     4845       end.
     4846       if p-show-qnty = false  and x-SelectGood = 1  then do:
     4847           for each alt-obj-list :
     4848             for each ub.gds-obj no-lock where ub.gds-obj.obj-type =  alt-obj-list.obj-type and
     4849                                             ub.gds-obj.obj-code =  alt-obj-list.obj-code
     4850             :
     4851               find first gds-list      where gds-list.gds-code = ub.gds-obj.gds-code no-error .
     4852               if not available gds-list then do:
     4853                   find first ub.goods no-lock where ub.goods.gds-code = ub.gds-obj.gds-code no-error .
     4854                   create gds-list.
     4855                   BUFFER-COPY ub.goods TO gds-list.
     4856                     if classify = 4 then
     4857                     gds-list.qnty = func-vat (gds-list.gds-code,ub.gds-obj.obj-type,ub.gds-obj.obj-code) .
     4858               end.
     4859             end.
     4860           end.
     4861       end.
     4862   end.
     4863   end procedure.
