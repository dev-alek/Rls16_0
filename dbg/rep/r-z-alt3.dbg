      766   procedure cur-time :
      767      define output parameter p-today as date      no-undo .
      768      define output parameter p-time  as integer   no-undo .
      769     do
      770     on error undo, return error
      771     :
      772       define variable v-date1 as date      no-undo .
      773       define variable v-date2 as date      no-undo .
      774       define variable v-time  as integer   no-undo .
      775       assign
      776         v-date1 = today
      777         v-time  = time
      778         v-date2 = today
      779       .
      780       if v-date1 <> v-date2
      781       then do:
      782         assign
      783           v-date1 = today
      784           v-time  = v-time
      785         .
      786       end.
      787       assign
      788         p-today = v-date1
      789         p-time  = v-time
      790       .
      791     end.
      792   end.
      793   function cur-time-date returns character
      794   :
      795     return string(today, '99/99/9999':U) .
      796   end.
      797   function cur-time-mjd returns decimal
      798   :
      799     define variable v-date as date      no-undo .
      800     define variable v-time as integer   no-undo .
      801     run cur-time in this-procedure
      802       (output v-date
      803       ,output v-time
      804       ) .
      805     return integer(v-date) - 2400002 + (v-time / 86400) .
      806   end.
      807   function cur-time-get-ending-index returns integer
      808   (input p-number as integer
      809   )
      810   :
      811     if p-number < 0
      812     or p-number = ?
      813     then do:
      814       return 1 .
      815     end.
      816     define variable v-rest as integer   no-undo .
      817     assign
      818       p-number = p-number modulo 100
      819     .
      820     if p-number < 20
      821     then do:
      822       assign
      823         v-rest = p-number
      824       .
      825     end.
      826     else do:
      827       assign
      828         v-rest = p-number modulo 10
      829       .
      830     end.
      831     case v-rest :
      832       when 1
      833       then do:
      834         return 2 .
      835       end.
      836       when 2 or
      837       when 3 or
      838       when 4
      839       then do:
      840         return 3 .
      841       end.
      842       otherwise do:
      843         return 1 .
      844       end.
      845     end case .
      846   end.
      847   procedure cur-time-mjd-to-date :
      848      define input  parameter i-mjd-diff as decimal no-undo.
      849      define output parameter o-Date     as date    no-undo.
      850      define output parameter o-Time     as integer no-undo.
      851      define variable v-day-number as integer   no-undo .
      852      if    i-mjd-diff < 0
      853         or i-mjd-diff = ?
      854      then do:
      855         return "?" .
      856      end.
      857      assign
      858         v-day-number = truncate(i-mjd-diff,0).
      859         o-Date = date(v-day-number + 2400002).
      860         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      861     .
      862   end.
      863   function cur-time-mjd-to-string returns character
      864   (input p-mjd-diff as decimal
      865   )
      866   :
      867     define variable v-day-number as integer   no-undo .
      868     define variable v-seconds    as integer   no-undo .
      869     define variable v-hour       as integer   no-undo .
      870     define variable v-min        as integer   no-undo .
      871     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      872     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      873     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      874     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      875     if p-mjd-diff < 0
      876     or p-mjd-diff = ?
      877     then do:
      878       return "?" .
      879     end.
      880     assign
      881       v-day-number = integer(truncate(p-mjd-diff,0))
      882       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      883     .
      884     if v-seconds > 86400
      885     then do:
      886       assign
      887         v-seconds = 86400 - 1
      888       .
      889     end.
      890     if v-seconds < 0
      891     then do:
      892       assign
      893         v-seconds = 0
      894       .
      895     end.
      896     assign
      897       v-hour = truncate(v-seconds / 3600, 0)
      898     .
      899     assign
      900       v-seconds = v-seconds modulo 3600
      901     .
      902     assign
      903       v-min = truncate(v-seconds / 60, 0)
      904     .
      905     assign
      906       v-seconds = v-seconds modulo 60
      907     .
      908     return
      909         (if v-day-number <> 0
      910           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      911           else ""
      912         )
      913       + (if v-day-number <> 0 or v-hour <> 0
      914           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      915           else ""
      916         )
      917       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      918           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      919           else ""
      920         )
      921       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      922       .
      923   end.
      924   function cur-time-string returns character
      925   :
      926     define variable v-date as date      no-undo .
      927     define variable v-time as integer   no-undo .
      928     run cur-time in this-procedure
      929       (output v-date
      930       ,output v-time
      931       ) .
      932     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      933   end.
      934   function cur-time-string-sec returns character
      935   :
      936     define variable v-date as date      no-undo .
      937     define variable v-time as integer   no-undo .
      938     run cur-time in this-procedure
      939       (output v-date
      940       ,output v-time
      941       ) .
      942     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      943   end.
      944   function cur-time-custom  returns character
      945   (input p-prefix as character
      946   ,input p-date-format as character
      947   ,input p-delimiter as character
      948   ,input p-time-format as character
      949   ,input p-suffix as character
      950   )
      951   :
      952     define variable v-date as date      no-undo .
      953     define variable v-time as integer   no-undo .
      954     run cur-time in this-procedure
      955       (output v-date
      956       ,output v-time
      957       ) .
      958     return
      959       p-prefix
      960       + string(v-date, p-date-format)
      961       + p-delimiter
      962       + string(v-time, p-time-format)
      963       + p-suffix
      964       .
      965   end.
      966   function cur-time-print  returns character
      967   :
      968     define variable v-date as date      no-undo .
      969     define variable v-time as integer   no-undo .
      970     run cur-time in this-procedure
      971       (output v-date
      972       ,output v-time
      973       ) .
      974     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      975   end.
      976   function cur-time-datetime returns datetime
      977   :
      978     define variable v-char as character no-undo .
      979     define variable v-datetime as datetime no-undo .
      980     v-char = cur-time-string().
      981     v-datetime = datetime(v-char).
      982     return  v-datetime.
      983   end.
      984   function cur-time-string-msec returns character
      985   :
      986     define variable v-date as datetime  no-undo .
      987     v-date = now.
      988     return string(v-date) .
      989   end.
      990   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      991   define variable v-waitfram-action01         as character   no-undo .
      992   define variable v-waitfram-action02         as character   no-undo .
      993   define variable v-waitfram-action03         as character   no-undo .
      994   define variable mWaitFramTextBeg            as character   no-undo.
      995   define variable mWaitFramTextEnd            as character   no-undo.
      996   define variable mWaitFramView               as logical     no-undo.
      997   define variable mWaitProcEvent              as logical     no-undo init yes.
      998   define variable mWaitFramInterval           as integer     no-undo init 1 .
      999   define variable mWaitFramStop               as logical     no-undo.
     1000   define variable mWaitFramStopUser           as logical     no-undo.
     1001   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1002   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1003   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1004   define button B-WaitFramStop auto-end-key
     1005        label "Стоп"
     1006        size 10 by 1 tooltip "Остоновить процесс".
     1007   define button B-viewProcInfo
     1008        label "Информация"
     1009        size 15 by 1 tooltip "Информация о процесс".
     1010   define frame waitfram
     1011     v-waitfram-action01 format "x(72)" no-label skip
     1012     v-waitfram-action02 format "x(72)" no-label skip
     1013     v-waitfram-action03 format "x(72)" no-label skip
     1014     B-viewProcInfo
     1015     B-WaitFramStop at row 4 col 30
     1016     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1017     .
     1018   define new global shared variable mBatchMode as logical no-undo init ?.
     1019   define variable mFramBachModHandle as handle no-undo.
     1020   mFramBachModHandle = frame waitfram:handle.
     1021   define variable mFameOldVis as logical no-undo.
     1022   define variable mVisCUrentVin as logical no-undo.
     1023   if session:batch-mode
     1024   then
     1025      mBatchMode = yes.
     1026   if mBatchMode = ? then do:
     1027     mVisCUrentVin = current-window:visible.
     1028     mFameOldVis = mFramBachModHandle:visible.
     1029     mFramBachModHandle:visible  = yes.
     1030     mBatchMode = mFramBachModHandle:visible ne yes.
     1031     mFramBachModHandle:visible = mFameOldVis.
     1032     current-window:visible = mVisCUrentVin.
     1033   end.
     1034    if  log-manager:logfile-name ne ?
     1035     then DO:
     1036         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1037         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1038         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1039     end.
     1040   on choose of B-WaitFramStop in frame waitfram
     1041   do:
     1042     mWaitFramStop = yes.
     1043     mWaitFramStopUser = yes.
     1044   end.
     1045   function waitfram-check-timeout returns logical():
     1046      define variable vtime as int64 no-undo.
     1047      if mWaitFramStopTimeOut
     1048      then
     1049         return yes.
     1050      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1051      if     mWaitFramTimeOut ne ?
     1052         and mWaitFramTimeOut ne 0
     1053         and mWaitFramTimeOut lt vtime
     1054      then do:
     1055         mWaitFramStopTimeOut = yes.
     1056      end.
     1057      return mWaitFramStopTimeOut.
     1058   end.
     1059   procedure waitfram-hide :
     1060     if not session:batch-mode
     1061     then do
     1062     on error undo, return error return-value
     1063     :
     1064       pause 0 before-hide .
     1065       if not mBatchMode then
     1066         hide frame waitfram .
     1067     if     not mWaitFramView
     1068        and mWaitProcEvent
     1069     then
     1070       process events .
     1071     end.
     1072   end procedure.
     1073   procedure waitfram-show :
     1074     define input  parameter p-message as character no-undo .
     1075     define variable v-left-margin as integer   no-undo .
     1076     if not session:batch-mode
     1077     then do
     1078     on error undo, return error return-value
     1079     :
     1080       if length(p-message) <= 70 then do:
     1081         assign
     1082           v-left-margin = integer((70 - length(p-message)) / 2)
     1083         .
     1084         assign
     1085           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1086         .
     1087         assign
     1088           v-waitfram-action01 = " "
     1089           v-waitfram-action02 = " "
     1090                                    + fill(" ", v-left-margin)
     1091                                    + p-message
     1092           v-waitfram-action03 = " "
     1093         .
     1094       end.
     1095       else do:
     1096         define variable vRindex1 as integer no-undo.
     1097         define variable vRindex2 as integer no-undo.
     1098         vRindex1 = r-index(p-message," ",70).
     1099         if vRindex1 = 0
     1100         then
     1101            vRindex1 = 70.
     1102         if length(p-message)  <= vRindex1 + 70 then do:
     1103           assign
     1104             v-waitfram-action01 = " "
     1105             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1106             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1107           .
     1108         end.
     1109         else do:
     1110           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1111           if vRindex2 <= vRindex1
     1112           then
     1113              vRindex2 = vRindex1 + 70.
     1114           assign
     1115             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1116             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1117             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1118           .
     1119         end.
     1120       end.
     1121       B-viewProcInfo:visible   in frame waitfram = no.
     1122       B-viewProcInfo:sensitive in frame waitfram = no.
     1123       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1124       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1125       if  (   mWaitFramView
     1126          or  mWaitProcEvent)
     1127          and not mBatchMode
     1128       then
     1129          display
     1130             v-waitfram-action01 skip
     1131             v-waitfram-action02 skip
     1132             v-waitfram-action03 skip
     1133          with frame waitfram .
     1134       if     mWaitFramView
     1135          then do:
     1136             if     mWaitFramInterval ne ?
     1137                and not mBatchMode
     1138             then
     1139                wait-for go of frame waitfram pause mWaitFramInterval.
     1140          end.
     1141          else
     1142             if     mWaitProcEvent
     1143                and not mBatchMode
     1144             then
     1145                process events .
     1146     end.
     1147   end procedure.
     1148      procedure waitfram-show-this:
     1149         define input  parameter iInterval as int64 no-undo.
     1150         define variable vtime as int64 no-undo.
     1151         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1152         mWaitFramInterval = iInterval.
     1153         run waitfram-show (substitute("&1&2 &3&4" ,
     1154                                       mWaitFramTextBeg ,
     1155                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1156                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1157                                       mWaitFramTextEnd
     1158                                      )
     1159                           ).
     1160      end.
     1161      procedure WaitFramRunPause:
     1162         define input  parameter iInterval as dec no-undo.
     1163         define variable vStart  as datetime-tz no-undo.
     1164         define variable vend    as datetime-tz no-undo.
     1165         define variable vint as int64 no-undo.
     1166         define variable vOk as logical no-undo.
     1167         vStart = now.
     1168         vend   = vStart.
     1169         publish "WaitFramPause" (iInterval,output vOk).
     1170         vend   =  now.
     1171         vint = vend - vStart.
     1172         vint = iInterval - vint / 1000.
     1173         if     not mWaitFramStop
     1174            and (   vint > 0
     1175                 or (    not vOk
     1176                     and iInterval eq ?
     1177                     )
     1178                 )
     1179         then
     1180            run waitfram-show-this (iInterval).
     1181         vend   =  now.
     1182         vint = vend - vStart.
     1183         vint = iInterval - vint / 1000.
     1184         if     not mWaitFramStop
     1185            and vint > 0
     1186         then do:
     1187            run gbl/pause.p (vint * 1000).
     1188         end.
     1189         if iInterval ne ?
     1190         then
     1191            publish "WaitFramStop".
     1192         waitfram-check-timeout().
     1193      end.
     1194      procedure WaitFramWaitFor:
     1195         define input  parameter iInterval as dec no-undo.
     1196         assign
     1197            mWaitFramStartProc   = now
     1198            mWaitFramStopUser    = no
     1199            mWaitFramStopTimeOut = no
     1200         .
     1201         block-wait:
     1202         do while not mWaitFramStop:
     1203            run WaitFramRunPause (iInterval).
     1204            if  waitfram-check-timeout()
     1205            then do:
     1206               leave block-wait.
     1207            end.
     1208         end.
     1209         run waitfram-hide.
     1210      end.
     1211   procedure waitfram-join :
     1212     define input  parameter p-line-1  as character no-undo .
     1213     define input  parameter p-line-2  as character no-undo .
     1214     define input  parameter p-line-3  as character no-undo .
     1215     define output parameter p-message as character no-undo .
     1216     do
     1217     on error undo, return error return-value
     1218     :
     1219       assign
     1220         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1221                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1222                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1223       .
     1224     end.
     1225   end procedure.
     1226   function waitfram-join-function returns character
     1227     (input p-line-1 as character
     1228     ,input p-line-2 as character
     1229     ,input p-line-3 as character
     1230     ).
     1231     define variable v-message as character no-undo .
     1232     run waitfram-join in this-procedure
     1233       (input  p-line-1
     1234       ,input  p-line-2
     1235       ,input  p-line-3
     1236       ,output v-message
     1237       ) .
     1238     return v-message .
     1239   end function .
     1240   define temp-table temp-font no-undo
     1241     field fontnum  as integer
     1242     field fontname as character
     1243     field fontsize as character
     1244     field fonttype as character
     1245     field font-h   as integer
     1246     field font-w   as integer
     1247     field v-row    as integer
     1248     field v-col    as integer
     1249     field v-row-lans as integer
     1250     field v-col-lans as integer
     1251   index pi fontnum
     1252   .
     1253   procedure get-font-ini :
     1254     do
     1255     on error undo, return error return-value
     1256     :
     1257   define variable ii as integer   no-undo .
     1258   define variable v-font7 as character no-undo .
     1259   define variable v-font as character no-undo .
     1260   define variable loc-name as character no-undo .
     1261   define variable loc-size as character no-undo .
     1262   define variable loc-type as character no-undo .
     1263   define variable old_H as integer   no-undo .
     1264   define variable old_w as integer   no-undo .
     1265   define variable old-row  as integer   no-undo .
     1266   define variable old-col  as integer   no-undo .
     1267   define variable old-row-lans  as integer   no-undo .
     1268   define variable old-col-lans  as integer   no-undo .
     1269   define variable vv as integer   no-undo .
     1270   empty temp-table temp-font.
     1271     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1272       case num-entries (v-font7) :
     1273         when 4 then do:
     1274             assign
     1275               loc-name = entry ( 1 , v-font7 )
     1276               loc-size = entry ( 2 , v-font7 )
     1277               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1278             .
     1279         end.
     1280         when 3 then do:
     1281             assign
     1282               loc-name = entry ( 1 , v-font7 )
     1283               loc-size = entry ( 2 , v-font7 )
     1284               loc-type = entry ( 3 , v-font7 )
     1285             .
     1286         end.
     1287         when 2 then  do:
     1288             assign
     1289               loc-name = entry ( 1 , v-font7 )
     1290               loc-size = entry ( 2 , v-font7 )
     1291               loc-type = ""
     1292             .
     1293         end.
     1294         when 1 then do:
     1295             assign
     1296               loc-name = trim(entry ( 1 , v-font7 ))
     1297               loc-size = ""
     1298               loc-type = ""
     1299             .
     1300         end.
     1301       end case.
     1302     create temp-font.
     1303     assign
     1304       temp-font.fontnum  = 7
     1305       temp-font.fontname = trim(loc-name)
     1306       temp-font.fontsize = trim(loc-size)
     1307       temp-font.fonttype = trim(loc-type)
     1308       temp-font.v-row    = 62
     1309       temp-font.v-col    = 136
     1310       temp-font.v-row-lans = 43
     1311       temp-font.v-col-lans = 198
     1312     .
     1313     repeat ii = 16 to 100 :
     1314       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1315       if v-font = "" or v-font = ? then leave.
     1316       case num-entries (v-font) :
     1317         when 4 then do:
     1318             assign
     1319               loc-name = entry ( 1 , v-font )
     1320               loc-size = entry ( 2 , v-font )
     1321               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1322             .
     1323         end.
     1324         when 3 then do:
     1325             assign
     1326               loc-name = entry ( 1 , v-font )
     1327               loc-size = entry ( 2 , v-font )
     1328               loc-type = entry ( 3 , v-font )
     1329             .
     1330         end.
     1331         when 2 then do:
     1332             assign
     1333               loc-name = entry ( 1 , v-font )
     1334               loc-size = entry ( 2 , v-font )
     1335               loc-type = ""
     1336             .
     1337         end.
     1338         when 1 then do:
     1339             assign
     1340               loc-name = trim(entry ( 1 , v-font ))
     1341               loc-size = ""
     1342               loc-type = ""
     1343             .
     1344         end.
     1345       end case.
     1346     create temp-font.
     1347     assign
     1348       temp-font.fontnum  = ii
     1349       temp-font.fontname = trim(loc-name)
     1350       temp-font.fontsize = trim(loc-size)
     1351       temp-font.fonttype = trim(loc-type)
     1352     .
     1353     end.
     1354       for each temp-font :
     1355          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1356          if  vv = ? then vv =  0 .
     1357           run rep/exfont.p (
     1358             input   temp-font.fontname ,
     1359             input   vv ,
     1360             input   temp-font.fonttype ,
     1361             output  temp-font.font-h   ,
     1362             output  temp-font.font-w   )
     1363           .
     1364       end.
     1365   find first temp-font where  temp-font.fontnum  = 7  .
     1366   old_H = temp-font.font-H .
     1367   old_w = temp-font.font-W .
     1368   old-row = temp-font.v-row .
     1369   old-col = temp-font.v-col .
     1370   old-row-lans = temp-font.v-row-lans .
     1371   old-col-lans = temp-font.v-col-lans .
     1372       for each temp-font where
     1373                temp-font.fontnum  <> 7 :
     1374           assign
     1375               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1376               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1377               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1378               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1379           .
     1380       end.
     1381     end.
     1382   end procedure.
     1383   PROCEDURE How-name :
     1384   define input  parameter h as integer no-undo .
     1385   define input  parameter w as integer no-undo .
     1386   define output parameter n as character  no-undo .
     1387   define variable A4port-H as integer   no-undo init 63.
     1388   define variable A4port-W as integer   no-undo init 136.
     1389   define variable A4lans-H as integer   no-undo init 43.
     1390   define variable A4lans-W as integer   no-undo init 198.
     1391   define variable Strim-W  as integer   no-undo init 278.
     1392   run define-a4-size (
     1393        input ReportFontNum
     1394       ,output A4port-H
     1395       ,output A4port-W
     1396       ,output A4lans-H
     1397       ,output A4lans-W ).
     1398   If w >= 1 and w <= A4port-W Then DO:
     1399     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1400     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1401     If h > A4port-H              Then n = "to-file":U.
     1402   End.
     1403   If w > A4port-W and w <= A4lans-W Then DO:
     1404     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1405     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1406     If h > A4port-H              Then n = "to-file":U.
     1407   End.
     1408   If w > A4lans-W and w <= Strim-W Then DO:
     1409     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1410     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1411     If h > A4port-H              Then n = "to-file":U.
     1412   End.
     1413   If w > Strim-W Then DO:
     1414      n = "to-file":U.
     1415   End.
     1416   END PROCEDURE.
     1417   PROCEDURE define-a4-size :
     1418   define input  parameter p-ReportFontNum as integer   no-undo .
     1419   define output parameter A4port-H as integer   no-undo .
     1420   define output parameter A4port-W as integer   no-undo .
     1421   define output parameter A4lans-H as integer   no-undo .
     1422   define output parameter A4lans-W as integer   no-undo .
     1423   if not can-find (first temp-font ) then do:
     1424      run get-font-ini .
     1425   end.
     1426   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1427   if available temp-font then do:
     1428   assign
     1429     A4port-H = temp-font.v-row
     1430     A4port-W = temp-font.v-col
     1431     A4lans-H = temp-font.v-row-lans
     1432     A4lans-W = temp-font.v-col-lans
     1433   .
     1434   end.
     1435   else do:
     1436   assign
     1437     A4port-H = 63
     1438     A4port-W = 136
     1439     A4lans-H = 43
     1440     A4lans-W = 198
     1441   .
     1442   end.
     1443   END PROCEDURE.
     1444   function func-vat returns decimal (
     1445       input p-gds-code as integer  ,
     1446       input p-obj-type as character ,
     1447       input p-obj-code as integer  ).
     1448   define variable i-vat-pc as decimal no-undo .
     1449   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1451     (input  p-gds-code
     1452     ,input  '1':U
     1453     ,input  x-Date-End
     1454     ,input  v-cntxt-host-code-obj
     1455     ,input  p-obj-type
     1456     ,input  p-obj-code
     1457     ,output i-vat-pc
     1458     ) no-error .
     1459   if error-status :error then return 0 .
     1460   else return i-vat-pc.
     1461   end function .
     1462   define buffer clients-p for ub.clients .
     1463   define buffer alt-ot-line for ub.ot-line .
     1464   define buffer crsa-ot-line for ub.ot-line .
     1465   define  shared temp-table alt-obj-list  NO-UNDO
     1466       field obj-type like ub.clients.obj-type
     1467       field obj-code like ub.clients.obj-code
     1468       field obj-name like ub.clients.obj-name
     1469       .
     1470   define variable F-fact-date      as char no-undo.
     1471   define variable sss as integer no-undo .
     1472   define variable  Fact-order-1 like ub.stk-tot.Fact-order no-undo.
     1473   define variable  Quantity1    like ub.stk-tot.fact-qnty  no-undo.
     1474   define variable  Coast1       like ub.stk-tot.sum-rubl   no-undo.
     1475   define variable  Coast_R1       like ub.stk-tot.sum-rubl   no-undo.
     1476   define variable  Coast_V1       like ub.stk-tot.sum-rubl   no-undo.
     1477   define variable  VAT_R1         like ub.stk-tot.sum-rubl   no-undo.
     1478   define variable  VAT_V1         like ub.stk-tot.sum-rubl   no-undo.
     1479   define variable  Coast_R2       like ub.stk-tot.sum-rubl   no-undo.
     1480   define variable  Coast_V2       like ub.stk-tot.sum-rubl   no-undo.
