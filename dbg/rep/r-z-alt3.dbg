     2484          l-col-format= "X(" + string(l-col-len) + ")"  l-col-lable= "Товар"                .
     2485     def var ed14 as handle .
     2486     def var s14 as handle .
     2487     def var ll-14 as handle .
     2488     if l-col-len > 0 then DO:
     2489           CREATE EDITOR LL-14 IN WIDGET-POOL "My-pool"
     2490             ASSIGN
     2491               FRAME = FRAME top-frame:HANDLE
     2492               ROW = l-row-pos
     2493               COLUMN = l-col-pos
     2494               screen-value = Fill("-", l-col-len)
     2495               WIDTH-CHARS = l-col-len
     2496               HEIGHT-CHARS = 3
     2497           .
     2498           CREATE EDITOR ed14 IN WIDGET-POOL "My-pool"
     2499             ASSIGN
     2500               FRAME = FRAME top-frame:HANDLE
     2501               ROW = l-row-pos + 1
     2502               COLUMN = l-col-pos
     2503               screen-value = fill(" ",Integer((l-col-len - LENGTH(trim(l-col-lable))) / 2))  + l-col-lable
     2504               WIDTH-CHARS = l-col-len
     2505               HEIGHT-CHARS = 3
     2506           .
     2507            if  (l-col-pos + l-col-len) <= 320 THEN DO:
     2508           CREATE EDITOR s14 IN WIDGET-POOL "My-pool"
     2509             ASSIGN
     2510               FRAME = FRAME top-frame:HANDLE
     2511               ROW = l-row-pos
     2512               COLUMN = (l-col-pos + l-col-len)
     2513               screen-value = "::"
     2514               WIDTH-CHARS = 1
     2515               HEIGHT-CHARS = 3
     2516           .
     2517              End.
     2518           l-col-pos =  l-col-pos + l-col-len + 1.
     2519      End.
     2520   Assign l-col-type="CHARACTER"
     2521          l-col-len=  -1 +
     2522                     (if  c-f-qnty       <> ? then  c-f-qnty:WIDTH-CHARS  + 1       Else 0 ) +
     2523                     (if  c-f-cost-sum   <> ? then  c-f-cost-sum:WIDTH-CHARS + 1    Else 0 ) +
     2524                     (if  c-f-sale-sum   <> ? then  c-f-sale-sum:WIDTH-CHARS + 1    Else 0 ) +
     2525                     (if  c-f-sale-other <> ? then  c-f-sale-other:WIDTH-CHARS + 1  Else 0 )
     2526          l-col-format= "X(" + string(l-col-len) + ")"  l-col-lable= "Объект 1"   .
     2527     def var ed15 as handle .
     2528     def var s15 as handle .
     2529     def var ll-15 as handle .
     2530     if l-col-len > 0 then DO:
     2531           CREATE EDITOR LL-15 IN WIDGET-POOL "My-pool"
     2532             ASSIGN
     2533               FRAME = FRAME top-frame:HANDLE
     2534               ROW = l-row-pos
     2535               COLUMN = l-col-pos
     2536               screen-value = Fill("-", l-col-len)
     2537               WIDTH-CHARS = l-col-len
     2538               HEIGHT-CHARS = 3
     2539           .
     2540           CREATE EDITOR ed15 IN WIDGET-POOL "My-pool"
     2541             ASSIGN
     2542               FRAME = FRAME top-frame:HANDLE
     2543               ROW = l-row-pos + 1
     2544               COLUMN = l-col-pos
     2545               screen-value = fill(" ",Integer((l-col-len - LENGTH(trim(l-col-lable))) / 2))  + l-col-lable
     2546               WIDTH-CHARS = l-col-len
     2547               HEIGHT-CHARS = 3
     2548           .
     2549            if  (l-col-pos + l-col-len) <= 320 THEN DO:
     2550           CREATE EDITOR s15 IN WIDGET-POOL "My-pool"
     2551             ASSIGN
     2552               FRAME = FRAME top-frame:HANDLE
     2553               ROW = l-row-pos
     2554               COLUMN = (l-col-pos + l-col-len)
     2555               screen-value = "::"
     2556               WIDTH-CHARS = 1
     2557               HEIGHT-CHARS = 3
     2558           .
     2559              End.
     2560           l-col-pos =  l-col-pos + l-col-len + 1.
     2561      End.
     2562   Assign l-col-type="CHARACTER"
     2563          l-col-len=  -1 +
     2564                     (if  c-f-qnty-alt       <> ? then  c-f-qnty-alt:WIDTH-CHARS  + 1       Else 0 ) +
     2565                     (if  c-f-cost-sum-alt   <> ? then  c-f-cost-sum-alt:WIDTH-CHARS + 1    Else 0 ) +
     2566                     (if  c-f-sale-sum-alt   <> ? then  c-f-sale-sum-alt:WIDTH-CHARS + 1    Else 0 ) +
     2567                     (if  c-f-sale-other-alt <> ? then  c-f-sale-other-alt:WIDTH-CHARS + 1  Else 0 )
     2568          l-col-format= "X(" + string(l-col-len) + ")"  l-col-lable= "Объект 2"   .
     2569     def var ed16 as handle .
     2570     def var s16 as handle .
     2571     def var ll-16 as handle .
     2572     if l-col-len > 0 then DO:
     2573           CREATE EDITOR LL-16 IN WIDGET-POOL "My-pool"
     2574             ASSIGN
     2575               FRAME = FRAME top-frame:HANDLE
     2576               ROW = l-row-pos
     2577               COLUMN = l-col-pos
     2578               screen-value = Fill("-", l-col-len)
     2579               WIDTH-CHARS = l-col-len
     2580               HEIGHT-CHARS = 3
     2581           .
     2582           CREATE EDITOR ed16 IN WIDGET-POOL "My-pool"
     2583             ASSIGN
     2584               FRAME = FRAME top-frame:HANDLE
     2585               ROW = l-row-pos + 1
     2586               COLUMN = l-col-pos
     2587               screen-value = fill(" ",Integer((l-col-len - LENGTH(trim(l-col-lable))) / 2))  + l-col-lable
     2588               WIDTH-CHARS = l-col-len
     2589               HEIGHT-CHARS = 3
     2590           .
     2591            if  (l-col-pos + l-col-len) <= 320 THEN DO:
     2592           CREATE EDITOR s16 IN WIDGET-POOL "My-pool"
     2593             ASSIGN
     2594               FRAME = FRAME top-frame:HANDLE
     2595               ROW = l-row-pos
     2596               COLUMN = (l-col-pos + l-col-len)
     2597               screen-value = "::"
     2598               WIDTH-CHARS = 1
     2599               HEIGHT-CHARS = 3
     2600           .
     2601              End.
     2602           l-col-pos =  l-col-pos + l-col-len + 1.
     2603      End.
     2604      FIND first ub.clients where x-store-type = ub.clients.obj-type AND
     2605                               x-store-code = ub.clients.obj-code no-lock no-error.
     2606              If available ub.clients then  ObjName = ub.clients.obj-name.
     2607                                   else  ObjName="объект не определен".
     2608        assign
     2609           i             = 0
     2610           startdate     = x-date-start
     2611           enddate       = x-date-end
     2612           PayType       = x-SET_PAY_TYPE
     2613           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     2614           Find first ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     2615           If available  ub.gds-prt then   Prtroot = ub.gds-prt.prt-root.
     2616                                 Else   Prtroot = 0.
     2617           run init-gds-list.
     2618           Run report-execute.
     2619   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     2620     if num-entries(string(p-dec), '.') = 2
     2621       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     2622       else return( string(p-dec)) .
     2623   end function.
     2624   function format-point-to-comma returns char (input orig as char ) .
     2625   define variable rtext as character no-undo .
     2626   define variable strt as integer no-undo .
     2627   define variable leng as integer no-undo .
     2628   assign rtext = orig .
     2629   repeat:
     2630     strt =  index(rtext,'.').
     2631     if strt = 0 then leave.
     2632     leng = 1.
     2633     substring(rtext,strt,leng,"character") = v-delim .
     2634   end.
     2635   return rtext.
     2636   end function.
     2637   function format-excel-text returns char ( input start-text as char ) :
     2638   def var  i    as int no-undo.
     2639   def var  ch   as char no-undo.
     2640   def var  n    as int no-undo.
     2641   def var  ipos as int no-undo.
     2642     n = num-entries(trim(start-text), chr(10)) - 1 .
     2643     do i = 1 to n :
     2644       ipos = index( start-text, chr(10)).
     2645       if ipos > 0 then
     2646         substr( start-text, ipos, 1 ) = ' '.
     2647     end.
     2648     n = num-entries(trim(start-text), chr(13)) - 1 .
     2649     do i = 1 to n :
     2650       ipos = index( start-text, chr(13)).
     2651       if ipos > 0 then
     2652         substr( start-text, ipos, 1 ) = ' '.
     2653     end.
     2654     if index( start-text, '"' ) = 0 then
     2655       start-text =  '="'   + trim( start-text) + '"'   .
     2656       else do:
     2657         n = num-entries(trim(start-text), '"') - 1.
     2658         do i = 1 to n :
     2659           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2660         end.
     2661         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2662         start-text = '="'  + ch  + '"' .
     2663       end.
     2664     return start-text.
     2665   end.
     2666   function excel-sum returns char (input p-dec as decimal ).
     2667     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     2668   end function.
     2669   function excel-qnty returns char (input p-dec as decimal ).
     2670     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     2671   end function.
     2672   function format-excel-text-macr returns char ( input start-text as char ) :
     2673   def var  i    as int no-undo.
     2674   def var  ch   as char no-undo.
     2675   def var  n    as int no-undo.
     2676   def var  ipos as int no-undo.
     2677     n = num-entries(trim(start-text), chr(10)) - 1 .
     2678     do i = 1 to n :
     2679       ipos = index( start-text, chr(10)).
     2680       if ipos > 0 then
     2681         substring( start-text, ipos , 1 ) = ' '.
     2682     end.
     2683     n = num-entries(trim(start-text), chr(13)) - 1 .
     2684     do i = 1 to n :
     2685       ipos = index( start-text, chr(13)).
     2686       if ipos > 0 then
     2687         substring( start-text, ipos, 1 ) = ' '.
     2688     end.
     2689     if index( start-text, '"' ) = 0 then
     2690       start-text =  '"'   + trim( start-text) + '"'   .
     2691       else do:
     2692         n = num-entries(trim(start-text), '"') - 1.
     2693         do i = 1 to n :
     2694           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2695         end.
     2696         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2697         start-text = '"'  + ch  + '"' .
     2698       end.
     2699     n = num-entries(trim(start-text), chr(10)) - 1 .
     2700     do i = 1 to n :
     2701       ipos = index( start-text, chr(10)).
     2702       if ipos > 0 then
     2703         substring( start-text, ipos , 1 ) = ' '.
     2704     end.
     2705       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     2706     return start-text.
     2707   end.
     2708   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2709   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     2710      IF parundefine-var = ? THEN RETURN 0.00.
     2711                             ELSE RETURN parundefine-var.
     2712   END FUNCTION.
     2713   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     2714      IF p-undef-char = ? THEN do:
     2715        RETURN "?".
     2716      end.
     2717      ELSE do:
     2718        RETURN p-undef-char .
     2719      end.
     2720   END FUNCTION.
     2721   PROCEDURE report-execute :
     2722     If (ValType=0 and x-base-code=0)  Or ValType=1
     2723                                   then   assign tPrintRubl = yes .
     2724                                   else   assign tPrintRubl = no .
     2725      NO-PRISE = true .
     2726     if var-report-r-b = "rubl"  Then
     2727       if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     2728     else
     2729       if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     2730     RUN waitfram-show( 'Подождите ...' ) .
     2731     If ReportPageHeight = 0 then ReportPageHeight = 43 .
     2732   output stream OutStream to value( string( session:temp-directory +
     2733                                        "rpt" + string( g#report-num ) ) )
     2734                                        page-size  value(ReportPageHeight) .
     2735     FORM with FRAME Zapas .
     2736   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2737   form header
     2738     line format "x(198)" at 1 skip
     2739     "Продолжение - на следующей странице" at 30 skip
     2740     with frame bottomframe width 232 page-bottom no-labels no-box .
     2741   view stream outstream frame bottomframe .
     2742       if ReportPageHeight > 43  then Line = fill("-", 120).
     2743          else Line = fill("-", 198).
     2744     Run CalcItog in this-procedure.
     2745     Run Print-Header in this-procedure.
     2746       CAse classify :
     2747         when 1 then do:
     2748           Run Foreach1 in this-procedure.
     2749         end.
     2750         when 2 then do:
     2751           Run Foreach2 in this-procedure.
     2752         end.
     2753         when 3 then do:
     2754           Run Foreach3 in this-procedure.
     2755         end.
     2756         when 4 then do:
     2757           Run Foreach4 in this-procedure.
     2758         end.
     2759       End case.
     2760     HIDE stream OutStream FRAME BottomFrame .
     2761     Run  Print-footer in this-procedure.
     2762     HIDE STREAM OutStream FRAME Zapas .
     2763     HIDE   STREAM OutStream FRAME top-Frame .
     2764     DELETE WIDGET-POOL "My-pool".
     2765     Output stream OutStream close.
     2766     if Make-Excel then output stream ForExcel close.
     2767     RUN waitfram-hide .
     2768   define variable v-user-action as character no-undo .
     2769   define variable v-printed as logical   no-undo .
     2770   define variable DisabledOptions as integer   no-undo .
     2771   define variable v-orient-page as character no-undo .
     2772   run How-name in this-procedure (
     2773       input ReportPageHeight,
     2774       input ReportPageWidth,
     2775       output v-orient-page )
     2776       .
     2777   if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2778                                  else DisabledOptions = 0 .
     2779   run gbl/prnfilen.w
     2780     (input  ""
     2781     ,input  DisabledOptions
     2782     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2783     ,input  ReportFontNum
     2784     ,output v-user-action
     2785     ,output v-printed
     2786     ) .
     2787   END PROCEDURE.
     2788   PROCEDURE print-header :
     2789      PUT stream OutStream  string(v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName)
     2790            AT 50 format "X(85)" SKIP(2)
     2791            REPORTNAME
     2792            AT 35  format "X(100)" skip.
     2793        PUT stream OutStream   "на "  + string(x-date-start,"99/99/9999") +
     2794            " время " +  string(x-time,"HH:MM:SS")  AT 35 format "X(160)" SKIP.
     2795         Repeat i = 1 to NUM-ENTRIES(STR2,chr(10)) :
     2796           if LENGTH(trim(Entry(i,STR2,chr(10)))) > 1 then  PUT stream OutStream  Entry(i,STR2,chr(10))  AT 1 format "X(120)" SKIP.
     2797         End.
     2798        Repeat i = 1 to NUM-ENTRIES(STR3,chr(10)) :
     2799          if LENGTH(trim(Entry(i,STR3,chr(10)))) > 1 then PUT stream OutStream  Entry(i,STR3,chr(10))  AT 1 format "X(120)" SKIP.
     2800        End.
     2801        Repeat i = 1 to NUM-ENTRIES(STR4,chr(10)) :
     2802          if LENGTH(trim(Entry(i,STR4,chr(10)))) > 1 then PUT stream OutStream  Entry(i,STR4,chr(10))  AT 1 format "X(120)" SKIP.
     2803        End.
     2804        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2805          if LENGTH(trim(Entry(i,ReportHeader,chr(10)))) > 1 then PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(120)" SKIP.
     2806        End.
     2807       i=0.
     2808     run rep/extitle.p (1) .
     2809       display STREAM OutStream     with frame top-Frame .
     2810      END PROCEDURE.
     2811   PROCEDURE Print-Footer :
     2812     define variable v-today as date      no-undo.
     2813     define variable v-time  as integer   no-undo.
     2814     run cur-time in this-procedure ( output v-today
     2815                                    , output v-time
     2816                                    ).
     2817     PUT STREAM OutStream UNFORMATTED " Печать закончена : " + string(v-time,"HH:MM:SS") SKIP.
     2818     PUT STREAM OutStream UNFORMATTED " За время формирования отчета были закрыты документы : " SKIP.
     2819     for each obj-list :
     2820         for each ub.trn-doc no-lock where
     2821             ub.trn-doc.status_ = 'факт':U and
     2822             ub.trn-doc.flag_= true and
     2823             ub.trn-doc.obj-code = obj-list.obj-code and
     2824             ub.trn-doc.obj-type = obj-list.obj-type
     2825             by ub.trn-doc.fact-order DESCENDING :
     2826                If ub.trn-doc.fact-order <= fact-order-2 then leave.
     2827                PUT STREAM OutStream  UNFORMATTED ub.trn-doc.doc-code SKIP.
     2828         end.
     2829     end.
     2830     PUT STREAM OutStream UNFORMATTED " ______________________________________________________" SKIP.
     2831      run on-same-page in this-procedure (input 1) .
     2832      END PROCEDURE.
     2833   PROCEDURE U-LINE :
     2834   define variable ff as character no-undo .
     2835   if itog = false
     2836   Then do:
     2837   ff = fill("-",40).
     2838     if c-nn <>  ?  then do :
     2839       c-nn:screen-value = string(ff) .
     2840       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     2841           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     2842           display STREAM OutStream    with frame top-frame .
     2843       End.
     2844     End.
     2845     if c-f-b-code <>  ?  then do :
     2846       c-f-b-code:screen-value = string(ff) .
     2847       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     2848           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     2849           display STREAM OutStream    with frame top-frame .
     2850       End.
     2851     End.
     2852     if c-f-artic <>  ?  then do :
     2853       c-f-artic:screen-value = string(ff) .
     2854       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     2855           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     2856           display STREAM OutStream    with frame top-frame .
     2857       End.
     2858     End.
     2859     if c-f-gds-name <>  ?  then do :
     2860       c-f-gds-name:screen-value = string(ff) .
     2861       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     2862           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     2863           display STREAM OutStream    with frame top-frame .
     2864       End.
     2865     End.
     2866     if c-f-prt-name <>  ?  then do :
     2867       c-f-prt-name:screen-value = string(ff) .
     2868       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     2869           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     2870           display STREAM OutStream    with frame top-frame .
     2871       End.
     2872     End.
     2873   if c-f-qnty <>  ?  then do :
     2874   Assign
     2875       l1f-qnty  = c-f-qnty:DATA-TYPE
     2876       l2f-qnty  = c-f-qnty:FORMAT
     2877       c-f-qnty:DATA-TYPE = "CHARACTER"
     2878       c-f-qnty:FORMAT    = "x(" + string(C-f-qnty:WIDTH-CHARS) + ")"
     2879       c-f-qnty:screen-value = string(ff)  .
     2880   End.
     2881   if c-f-cost-sum <>  ?  then do :
     2882   Assign
     2883       l1f-cost-sum  = c-f-cost-sum:DATA-TYPE
     2884       l2f-cost-sum  = c-f-cost-sum:FORMAT
     2885       c-f-cost-sum:DATA-TYPE = "CHARACTER"
     2886       c-f-cost-sum:FORMAT    = "x(" + string(C-f-cost-sum:WIDTH-CHARS) + ")"
     2887       c-f-cost-sum:screen-value = string(ff)  .
     2888   End.
     2889   if c-f-sale-sum <>  ?  then do :
     2890   Assign
     2891       l1f-sale-sum  = c-f-sale-sum:DATA-TYPE
     2892       l2f-sale-sum  = c-f-sale-sum:FORMAT
     2893       c-f-sale-sum:DATA-TYPE = "CHARACTER"
     2894       c-f-sale-sum:FORMAT    = "x(" + string(C-f-sale-sum:WIDTH-CHARS) + ")"
     2895       c-f-sale-sum:screen-value = string(ff)  .
     2896   End.
     2897   if c-f-sale-other <>  ?  then do :
     2898   Assign
     2899       l1f-sale-other  = c-f-sale-other:DATA-TYPE
     2900       l2f-sale-other  = c-f-sale-other:FORMAT
     2901       c-f-sale-other:DATA-TYPE = "CHARACTER"
     2902       c-f-sale-other:FORMAT    = "x(" + string(C-f-sale-other:WIDTH-CHARS) + ")"
     2903       c-f-sale-other:screen-value = string(ff)  .
     2904   End.
     2905   if c-f-qnty-alt <>  ?  then do :
     2906   Assign
     2907       l1f-qnty-alt  = c-f-qnty-alt:DATA-TYPE
     2908       l2f-qnty-alt  = c-f-qnty-alt:FORMAT
     2909       c-f-qnty-alt:DATA-TYPE = "CHARACTER"
     2910       c-f-qnty-alt:FORMAT    = "x(" + string(C-f-qnty-alt:WIDTH-CHARS) + ")"
     2911       c-f-qnty-alt:screen-value = string(ff)  .
     2912   End.
     2913   if c-f-cost-sum-alt <>  ?  then do :
     2914   Assign
     2915       l1f-cost-sum-alt  = c-f-cost-sum-alt:DATA-TYPE
     2916       l2f-cost-sum-alt  = c-f-cost-sum-alt:FORMAT
     2917       c-f-cost-sum-alt:DATA-TYPE = "CHARACTER"
     2918       c-f-cost-sum-alt:FORMAT    = "x(" + string(C-f-cost-sum-alt:WIDTH-CHARS) + ")"
     2919       c-f-cost-sum-alt:screen-value = string(ff)  .
     2920   End.
     2921   if c-f-sale-sum-alt <>  ?  then do :
     2922   Assign
     2923       l1f-sale-sum-alt  = c-f-sale-sum-alt:DATA-TYPE
     2924       l2f-sale-sum-alt  = c-f-sale-sum-alt:FORMAT
     2925       c-f-sale-sum-alt:DATA-TYPE = "CHARACTER"
     2926       c-f-sale-sum-alt:FORMAT    = "x(" + string(C-f-sale-sum-alt:WIDTH-CHARS) + ")"
     2927       c-f-sale-sum-alt:screen-value = string(ff)  .
     2928   End.
     2929   if c-f-sale-other-alt <>  ?  then do :
     2930   Assign
     2931       l1f-sale-other-alt  = c-f-sale-other-alt:DATA-TYPE
     2932       l2f-sale-other-alt  = c-f-sale-other-alt:FORMAT
     2933       c-f-sale-other-alt:DATA-TYPE = "CHARACTER"
     2934       c-f-sale-other-alt:FORMAT    = "x(" + string(C-f-sale-other-alt:WIDTH-CHARS) + ")"
     2935       c-f-sale-other-alt:screen-value = string(ff)  .
     2936   End.
     2937     Display stream OutStream  with FRAME Zapas no-error .
     2938     DOWN stream OutStream  with FRAME Zapas .
     2939   if c-f-qnty <>  ?  then do :
     2940   Assign
     2941       c-f-qnty:DATA-TYPE = l1f-qnty
     2942       c-f-qnty:FORMAT    = l2f-qnty.
     2943   End.
     2944   if c-f-cost-sum <>  ?  then do :
     2945   Assign
     2946       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     2947       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     2948   End.
     2949   if c-f-sale-sum <>  ?  then do :
     2950   Assign
     2951       c-f-sale-sum:DATA-TYPE = l1f-sale-sum
     2952       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     2953   End.
     2954   if c-f-sale-other <>  ?  then do :
     2955   Assign
     2956       c-f-sale-other:DATA-TYPE = l1f-sale-other
     2957       c-f-sale-other:FORMAT    = l2f-sale-other.
     2958   End.
     2959   if c-f-qnty-alt <>  ?  then do :
     2960   Assign
     2961       c-f-qnty-alt:DATA-TYPE = l1f-qnty-alt
     2962       c-f-qnty-alt:FORMAT    = l2f-qnty-alt.
     2963   End.
     2964   if c-f-cost-sum-alt <>  ?  then do :
     2965   Assign
     2966       c-f-cost-sum-alt:DATA-TYPE = l1f-cost-sum-alt
     2967       c-f-cost-sum-alt:FORMAT    = l2f-cost-sum-alt.
     2968   End.
     2969   if c-f-sale-sum-alt <>  ?  then do :
     2970   Assign
     2971       c-f-sale-sum-alt:DATA-TYPE = l1f-sale-sum-alt
     2972       c-f-sale-sum-alt:FORMAT    = l2f-sale-sum-alt.
     2973   End.
     2974   if c-f-sale-other-alt <>  ?  then do :
     2975   Assign
     2976       c-f-sale-other-alt:DATA-TYPE = l1f-sale-other-alt
     2977       c-f-sale-other-alt:FORMAT    = l2f-sale-other-alt.
     2978   End.
     2979   End.
     2980   END PROCEDURE.
     2981   PROCEDURE CalcItog :
     2982       run ostatok (
     2983           input x-store-code  ,
     2984           input x-store-type  , x-TOG-Shift,
     2985           input x-date-start - 1 ,
     2986           input date('')      , x-Shift-Start,x-Shift-End,
     2987           input 'crsa':U   ,
     2988           input '##,##':U,
     2989           input xTog-obj ,
     2990           output  Quantity1  ,
     2991           output  Coast_R1   ,
     2992           output  Coast_V1   ,
     2993           output  VAT_R1     ,
     2994           output  VAT_V1     ,
     2995           output  Fact-order-1 ).
     2996     for each ub.trn-doc no-lock where
     2997         ub.trn-doc.status_   = 'факт':U  and
     2998         ub.trn-doc.flag_     = true     and
     2999         ub.trn-doc.host-code = v-cntxt-host-code-obj
     3000         by ub.trn-doc.fact-order DESCENDING :
     3001           fact-order-2 = ub.trn-doc.fact-order  .
     3002           leave.
     3003     end.
     3004             Quantity1  = 0.
     3005             Coast_R1   = 0.
     3006             Coast_V1   = 0.
     3007             VAT_R1     = 0.
     3008             VAT_V1     = 0.
     3009   END PROCEDURE.
     3010   PROCEDURE foreach1 :
     3011   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3012             n-nn = 0.
     3013             n-no = n-no + 1 .
     3014    For Each gds-list  break
     3015                   by
     3016                      (if sorttype = "sort-artic":U then
     3017                      ( gds-list.artic + gds-list.prod-type + string ( gds-list.prod-code ))
     3018                      else (if sorttype = "sort-name":U then gds-list.gds-name
     3019                                                        else string(gds-list.gds-code) ))
     3020                   by gds-list.artic
     3021                    with FRAME Zapas :
     3022                 IF first-of(gds-list.artic) then DO:
     3023                   assign
     3024                     f-qnty         = 0
     3025                     f-cost-sum     = 0
     3026                     f-sale-sum     = 0
     3027                     f-sale-other   = 0
     3028                     f-qnty-alt         = 0
     3029                     f-cost-sum-alt     = 0
     3030                     f-sale-sum-alt     = 0
     3031                     f-sale-other-alt   = 0
     3032                     .
     3033                 End.
     3034             if last-of(gds-list.artic) then DO:
     3035                n-nm = n-nm + 1.
     3036   If Integer(50) = 0 Then Temp1  = 100  .
     3037                         Else Temp1 = Integer(50) .
     3038        IF ( n-nm modulo Temp1 = 0 ) AND ( n-nm >= Temp1 ) then
     3039            RUN waitfram-show( "Обработано строк : " + string( n-nm )) .
     3040                For each obj-list no-lock :
     3041                   for each ub.gds-obj no-lock where
     3042                       ub.gds-obj.artic     = gds-list.artic     and
     3043                       ub.gds-obj.prod-type = gds-list.prod-type and
     3044                       ub.gds-obj.prod-code = gds-list.prod-code and
     3045                       ub.gds-obj.obj-code  = obj-list.obj-code and
     3046                       ub.gds-obj.obj-type  = obj-list.obj-type    :
     3047                       Assign
     3048                         f-qnty       = f-qnty     + ub.gds-obj.fact-qnty
     3049                         f-cost-sum   = f-cost-sum + determined(gds-obj.fact-rubl)
     3050                         f-sale-sum   = f-sale-sum + ub.gds-obj.fact-sale
     3051                       .
     3052                   End.
     3053                End.
     3054                f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     3055                For each alt-obj-list no-lock :
     3056                   for each ub.gds-obj no-lock where
     3057                       ub.gds-obj.artic     = gds-list.artic     and
     3058                       ub.gds-obj.prod-type = gds-list.prod-type and
     3059                       ub.gds-obj.prod-code = gds-list.prod-code and
     3060                       ub.gds-obj.obj-code  = alt-obj-list.obj-code and
     3061                       ub.gds-obj.obj-type  = alt-obj-list.obj-type    :
     3062                       Assign
     3063                       f-qnty-alt       = f-qnty-alt     + ub.gds-obj.fact-qnty
     3064                       f-cost-sum-alt   = f-cost-sum-alt + determined(gds-obj.fact-rubl)
     3065                       f-sale-sum-alt   = f-sale-sum-alt + ub.gds-obj.fact-sale
     3066                       .
     3067                   End.
     3068                End.
     3069                f-sale-other-alt = 100 * determined((f-sale-sum-alt - f-cost-sum-alt) / f-cost-sum-alt).
     3070                if itog = false and
     3071                   NOT(
     3072                      ( f-qnty          = 0 and
     3073                       f-cost-sum       = 0 and
     3074                       f-sale-sum       = 0 and
     3075                       f-sale-other     = 0 and
     3076                       f-qnty-alt       = 0 and
     3077                       f-cost-sum-alt   = 0 and
     3078                       f-sale-sum-alt   = 0 and
     3079                       f-sale-other-alt = 0  ))
     3080                Then DO:
     3081                       sss = 0 .
     3082                       if show-zero = false  then do:
     3083                          if c-f-qnty <>  ?  and  f-qnty <> 0 then sss = 1 .
     3084                          if c-f-cost-sum       <>  ?  and  round(f-cost-sum       ,2) <> 0 then sss = 1 .
     3085                          if c-f-sale-sum       <>  ?  and  round(f-sale-sum       ,2) <> 0 then sss = 1 .
     3086                          if c-f-sale-other     <>  ?  and  round(f-sale-other     ,2) <> 0 then sss = 1 .
     3087                          if c-f-qnty-alt       <>  ?  and  round(f-qnty-alt       ,2) <> 0 then sss = 1 .
     3088                          if c-f-cost-sum-alt   <>  ?  and  round(f-cost-sum-alt   ,2) <> 0 then sss = 1 .
     3089                          if c-f-sale-sum-alt   <>  ?  and  round(f-sale-sum-alt   ,2) <> 0 then sss = 1 .
     3090                          if c-f-sale-other-alt <>  ?  and  round(f-sale-other-alt,2)  <> 0 then sss = 1 .
     3091                       end.
     3092                       else  do: sss = 1 . end.
     3093                       if sss = 1 then do:
     3094                         n-nn = n-nn + 1 .
     3095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3096     (input  gds-list.gds-code
