     1605   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1606        VIEW-AS EDITOR
     1607        SIZE 1 BY 6 NO-UNDO.
     1608   DEFINE FRAME top-frame
     1609       t-1       AT ROW 1 COL 1 no-label
     1610       HEADER
     1611           cur-time-print() AT 5 format "X(35)"
     1612           "Цены указаны в" (if tPrintRubl then "РУБ" else x-base-type )
     1613           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>>9") ) AT 110 format "X(16)" SKIP
     1614        WITH 300 DOWN stream-io
     1615            NO-UNDERLINE use-text NO-BOX no-label
     1616            AT COL 1 ROW 1
     1617            SIZE 300 BY 35  .
     1618   DEFINE FRAME zapas
     1619      with width 300 down stream-io use-text NO-BOX no-label.
     1620   run cur-time in this-procedure ( output x-Date-End
     1621                                  , output x-time
     1622                                  ).
     1623   x-Date-Start   = x-date-alone.
     1624   find last ub.ot-tot  no-lock use-index pi .
     1625   if avail  ub.ot-tot then fix-doc-code = ub.ot-tot.doc-code .
     1626                    else fix-doc-code = "" .
     1627   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1628   l-row-pos = 3.
     1629   l-col-pos = 1.
     1630   Assign l-col-type="CHARACTER" l-col-len=9  l-col-format= "X(9)"         l-col-lable="N/N"                      .
     1631     def var ed1 as handle .
     1632     def var s1 as handle .
     1633     def var sf1 as handle .
     1634     def var l-1 as handle .
     1635     def var ll-1 as handle .
     1636     if l-row-pos = 0 then l-row-pos = 1.
     1637     if use-column[1] = true then DO:
     1638           CREATE EDITOR LL-1 IN WIDGET-POOL "My-pool"
     1639             ASSIGN
     1640               FRAME = FRAME top-Frame:HANDLE
     1641               ROW = l-row-pos
     1642               COLUMN = l-col-pos
     1643               screen-value = Fill("-", l-col-len)
     1644               WIDTH-CHARS = l-col-len
     1645               HEIGHT-CHARS = 3
     1646           .
     1647           CREATE EDITOR ed1 IN WIDGET-POOL "My-pool"
     1648             ASSIGN
     1649               FRAME = FRAME top-Frame:HANDLE
     1650               ROW =  l-row-pos + 1
     1651               COLUMN = l-col-pos
     1652               screen-value = l-col-lable
     1653               WIDTH-CHARS = l-col-len
     1654               HEIGHT-CHARS = 3
     1655           .
     1656           CREATE EDITOR L-1 IN WIDGET-POOL "My-pool"
     1657             ASSIGN
     1658               FRAME = FRAME top-Frame:HANDLE
     1659               ROW = l-row-pos + 3
     1660               COLUMN = l-col-pos
     1661               screen-value = Fill("-", l-col-len)
     1662               WIDTH-CHARS = l-col-len
     1663               HEIGHT-CHARS = 3
     1664           .
     1665           CREATE FILL-IN C-nn IN WIDGET-POOL "My-pool"
     1666             ASSIGN
     1667               FRAME = FRAME zapas:HANDLE
     1668               DATA-TYPE = l-col-type
     1669               FORMAT = l-col-format
     1670               ROW = 1
     1671               WIDTH-CHARS = l-col-len
     1672               COLUMN = l-col-pos
     1673           .
     1674            if  (l-col-pos + l-col-len) <= 320 THEN DO:
     1675           CREATE EDITOR s1 IN WIDGET-POOL "My-pool"
     1676             ASSIGN
     1677               FRAME = FRAME top-Frame:HANDLE
     1678               ROW = l-row-pos
     1679               COLUMN = (l-col-pos + l-col-len)
     1680               screen-value = "::::"
     1681               WIDTH-CHARS = 1
     1682               HEIGHT-CHARS = 5
     1683           .
     1684           CREATE EDITOR sf1 IN WIDGET-POOL "My-pool"
     1685             ASSIGN
     1686               FRAME = FRAME zapas:HANDLE
     1687               ROW = 1
     1688               Screen-value = ":"
     1689               WIDTH-CHARS = 1
     1690               COLUMN = l-col-pos + l-col-len
     1691            .
     1692              End.
     1693           l-col-pos =  l-col-pos + l-col-len + 1.
     1694      End .
