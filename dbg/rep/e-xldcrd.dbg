     1659   procedure grplib-get-full-name :
     1660      define input parameter p-node-code  as integer      no-undo.
     1661      define output parameter p-full-name as character    no-undo.
     1662      do
     1663   on error undo, return error
     1664   :
     1665       define variable v-upper-code    as integer           no-undo.
     1666       define buffer buf_gds-grp       for ub.gds-grp.
     1667       define buffer buf_upper_gds-grp for ub.gds-grp.
     1668       find first buf_gds-grp no-lock
     1669            where buf_gds-grp.node-code = p-node-code
     1670       no-error.
     1671       if not available buf_gds-grp
     1672       then do:
     1673           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1674       end.
     1675       assign
     1676           p-full-name  = ""
     1677           v-upper-code = 1
     1678       .
     1679       do while buf_gds-grp.upper-code <> 0
     1680       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1681       :
     1682           assign
     1683               p-full-name  = buf_gds-grp.node-name
     1684                            + (if p-full-name <> "" then chr(47) else "")
     1685                            + p-full-name
     1686               v-upper-code = buf_gds-grp.upper-code
     1687           .
     1688           find first buf_gds-grp no-lock
     1689                where buf_gds-grp.node-code = v-upper-code
     1690           no-error.
     1691           if not available buf_gds-grp
     1692           then do:
     1693               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1694                                   + string( v-upper-code )
     1695                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1696           end.
     1697       end.
     1698       assign
     1699       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1700       .
     1701   end.
     1702   end .
     1703   procedure grplib-get-node-from-full-name :
     1704   define input parameter p-full-name as character no-undo .
     1705   define output parameter p-node-code as integer no-undo .
     1706   define variable v-ii as integer no-undo .
     1707   define variable v-upper-code as integer no-undo .
     1708   define variable v-root-code as integer no-undo .
     1709   define variable v-entry as character no-undo .
     1710   define buffer buf_gds-grp       for ub.gds-grp.
     1711   do
     1712   on error undo, return error
     1713   :
     1714     find first buf_gds-grp no-lock
     1715         where buf_gds-grp.upper-code = 0
     1716     no-error .
     1717     if not available buf_gds-grp
     1718     then do:
     1719         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1720     end.
     1721     else do:
     1722       assign
     1723       v-root-code = buf_gds-grp.node-code
     1724       .
     1725     end.
     1726     v-upper-code = v-root-code.
     1727     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1728       assign
     1729       v-entry = entry(v-ii, p-full-name, chr(47)).
     1730       if v-entry = '' then leave.
     1731       find first buf_gds-grp no-lock where
     1732                 buf_gds-grp.node-name = v-entry
     1733             and buf_gds-grp.upper-code = v-upper-code
     1734             no-error.
     1735       if not available buf_gds-grp then do:
     1736         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1737       end.
     1738       else do:
     1739         p-node-code = buf_gds-grp.node-code.
     1740         v-upper-code = buf_gds-grp.node-code.
     1741       end.
     1742     end.
     1743   end.
     1744   end .
