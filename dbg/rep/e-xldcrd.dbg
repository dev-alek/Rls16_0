     2041        SIZE 32.4 BY 6.93.
     2042   DEFINE VARIABLE T-imp AS LOGICAL INITIAL no
     2043        LABEL "С учетом мпорта из ВС"
     2044        VIEW-AS TOGGLE-BOX
     2045        SIZE 29 BY .87 NO-UNDO.
     2046   DEFINE VARIABLE T-legacy AS LOGICAL INITIAL no
     2047        LABEL "С учетом перевыпуска карт"
     2048        VIEW-AS TOGGLE-BOX
     2049        SIZE 29 BY .87 NO-UNDO.
     2050   DEFINE VARIABLE T-subsid AS LOGICAL INITIAL no
     2051        LABEL "С учетом дополн.  карт"
     2052        VIEW-AS TOGGLE-BOX
     2053        SIZE 29 BY .87 NO-UNDO.
     2054   DEFINE VARIABLE T-time AS LOGICAL INITIAL no
     2055        LABEL ""
     2056        VIEW-AS TOGGLE-BOX
     2057        SIZE 2.6 BY .93 NO-UNDO.
     2058   DEFINE VARIABLE T-zeros AS LOGICAL INITIAL no
     2059        LABEL "Нулевые обороты"
     2060        VIEW-AS TOGGLE-BOX
     2061        SIZE 18.5 BY .87 NO-UNDO.
     2062   DEFINE VARIABLE TotalOnly AS LOGICAL INITIAL no
     2063        LABEL "Только итоги"
     2064        VIEW-AS TOGGLE-BOX
     2065        SIZE 16.8 BY .87 NO-UNDO.
     2066   DEFINE FRAME F-Main
     2067        selectcard AT ROW 2.3 COL 3 NO-LABEL
     2068        UpLevel AT ROW 6.7 COL 3 NO-LABEL
     2069        TotalOnly AT ROW 9.53 COL 2
     2070        T-zeros AT ROW 10.5 COL 2
     2071        T-legacy AT ROW 11.5 COL 2
     2072        T-subsid AT ROW 12.5 COL 2
     2073        T-imp AT ROW 13.5 COL 2
     2074        T-time AT ROW 16 COL 3.3
     2075        up-levelt AT ROW 5.33 COL 2.6 NO-LABEL
     2076        "Покупатели:" VIEW-AS TEXT
     2077             SIZE 28 BY .97 AT ROW 1.33 COL 3
     2078             FGCOLOR 4
     2079        "Представление:" VIEW-AS TEXT
     2080             SIZE 26.9 BY .83 AT ROW 8.5 COL 2.9
     2081             FGCOLOR 4
     2082        "Выборочно по времени" VIEW-AS TEXT
     2083             SIZE 22 BY .93 AT ROW 15 COL 2.9
     2084             FGCOLOR 4
     2085        RECT-2 AT ROW 8.15 COL 1.5
     2086        RECT-3 AT ROW 14.8 COL 1.5
     2087        RECT-client AT ROW 1.13 COL 1.5
     2088       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     2089            SIDE-LABELS NO-UNDERLINE THREE-D
     2090            AT COL 1 ROW 1
     2091            SIZE 58.13 BY 16.3.
     2092   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     2093   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     2094   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     2095   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     2096   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     2097   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     2098   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     2099   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     2100       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     2101   RUN ensure-broker.
     2102   THIS-PROCEDURE:ADM-DATA =
     2103        'ADM1.1~`':U +
     2104        'SmartObject~`':U +
     2105        'FRAME~`':U +
     2106        'NO ~`':U +
     2107        '~`':U +
     2108        '~`':U +
     2109        '~`':U +
     2110        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     2111           + "~`":U +
     2112        'Layout,Hide-on-Init~`':U +
     2113        '~`':U +
     2114        '~`':U +
     2115        '~`~`~`~`~`~`~`~`~`~`~`':U +
     2116        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     2117            THEN "^^":U
     2118        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     2119             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     2120   PROCEDURE adm-apply-entry :
     2121     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2122   END PROCEDURE.
     2123   PROCEDURE adm-destroy :
     2124    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2125   END PROCEDURE.
     2126   PROCEDURE adm-disable :
     2127       DISABLE RECT-2 RECT-3 RECT-client selectcard TotalOnly T-zeros T-legacy T-subsid T-imp T-time up-levelt WITH FRAME F-Main.
     2128       RUN dispatch ('disable-fields':U).
     2129       RUN set-attribute-list ('ENABLED=no':U).
     2130       RETURN.
     2131   END PROCEDURE.
     2132   PROCEDURE adm-edit-attribute-list :
     2133         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     2134         RETURN.
     2135   END PROCEDURE.
     2136   PROCEDURE adm-enable :
     2137       ENABLE UNLESS-HIDDEN RECT-2 RECT-3 RECT-client selectcard TotalOnly T-zeros T-legacy T-subsid T-imp T-time up-levelt WITH FRAME F-Main.
     2138       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     2139       RUN set-attribute-list ('ENABLED=yes':U).
     2140       RETURN.
     2141   END PROCEDURE.
     2142   PROCEDURE adm-exit :
     2143        RUN notify ('exit':U).
     2144     RETURN.
     2145   END PROCEDURE.
     2146   PROCEDURE adm-hide :
     2147     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2148   END PROCEDURE.
     2149   PROCEDURE adm-initialize :
     2150     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2151   END PROCEDURE.
     2152   PROCEDURE adm-show-errors :
     2153       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     2154       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2155           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     2156       END.
     2157       RETURN.
     2158   END PROCEDURE.
     2159   PROCEDURE adm-UIB-mode :
     2160     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2161   END PROCEDURE.
     2162   PROCEDURE adm-view :
     2163     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2164   END PROCEDURE.
     2165   PROCEDURE dispatch :
     2166       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     2167       RUN broker-dispatch IN adm-broker-hdl
     2168           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     2169       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     2170   END PROCEDURE.
     2171   PROCEDURE ensure-broker :
     2172   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     2173   IF RETURN-VALUE NE "ADM-Broker":U THEN
     2174   DO:
     2175       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     2176       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     2177   END.
     2178   END PROCEDURE.
     2179   PROCEDURE get-attribute :
     2180     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     2181     RUN broker-get-attribute IN adm-broker-hdl
     2182         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     2183     RETURN RETURN-VALUE.
     2184   END PROCEDURE.
     2185   PROCEDURE get-attribute-list :
     2186     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     2187     RUN broker-get-attribute-list IN adm-broker-hdl
     2188         (INPUT THIS-PROCEDURE,
     2189          INPUT ?,
     2190          OUTPUT p-attr-list) NO-ERROR.
     2191     RETURN.
     2192   END PROCEDURE.
     2193   PROCEDURE new-state :
     2194     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2195     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     2196     RETURN.
     2197   END PROCEDURE.
     2198   PROCEDURE notify :
     2199     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     2200     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     2201     IF RETURN-VALUE = "ADM-ERROR":U THEN
     2202         RETURN "ADM-ERROR":U.
     2203     RETURN.
     2204   END PROCEDURE.
     2205   PROCEDURE set-attribute-list :
     2206     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     2207     RUN ensure-broker.
     2208     RUN broker-set-attribute-list IN adm-broker-hdl
     2209         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     2210     RETURN.
     2211   END PROCEDURE.
     2212   PROCEDURE set-position :
     2213       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     2214       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     2215       IF VALID-HANDLE(adm-object-hdl) THEN
     2216       DO:
     2217           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     2218           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     2219           DO:
     2220             IF p-row = 0 THEN p-row =
     2221               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     2222             IF p-col = 0 THEN p-col =
     2223               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     2224           END.
     2225           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     2226           DO:
     2227             parent-hdl = adm-object-hdl:PARENT.
     2228             IF p-row = 0 THEN p-row =
     2229               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     2230                 parent-hdl:ROW.
     2231             IF p-col = 0 THEN p-col =
     2232               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     2233                 parent-hdl:COL.
     2234           END.
     2235           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     2236           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     2237         ASSIGN adm-object-hdl:ROW    =   p-row
     2238                adm-object-hdl:COLUMN =   p-col.
     2239       END.
     2240       RETURN.
     2241   END PROCEDURE.
     2242   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     2243       STRING(adm-object-hdl)).
     2244   PAUSE 0 BEFORE-HIDE.
     2245   PROCEDURE adm-change-page :
     2246     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     2247     END PROCEDURE.
     2248   PROCEDURE delete-page :
     2249     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     2250     RUN broker-delete-page IN adm-broker-hdl
     2251         (INPUT THIS-PROCEDURE, INPUT p-page#).
     2252     END PROCEDURE.
     2253   PROCEDURE init-object :
     2254     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     2255     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     2256     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     2257     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     2258     RUN broker-init-object IN adm-broker-hdl
     2259         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     2260          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     2261     RETURN.
     2262   END PROCEDURE.
     2263   PROCEDURE init-pages :
     2264     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     2265     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2266         INPUT p-page-list) NO-ERROR.
     2267     END PROCEDURE.
     2268   PROCEDURE select-page :
     2269     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     2270     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2271         INPUT p-page#) NO-ERROR.
     2272     END PROCEDURE.
     2273   PROCEDURE view-page :
     2274     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     2275     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2276         INPUT p-page#).
     2277     END PROCEDURE.
     2278   ON VALUE-CHANGED OF selectcard IN FRAME F-Main
     2279   DO:
     2280     assign selectcard.
     2281     CASE selectcard:
     2282       when "selective":U then do:
     2283         run str/dc-list.w (my-handle, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
     2284         assign
     2285         FixDCard = ""
     2286         DcardMode = "LIST":U
     2287         .
     2288         find first dc-list no-lock no-error .
     2289         if not available dc-list then do:
     2290           message
     2291           "В списке карт нет ни одной карты"
     2292           view-as alert-box WARNING.
     2293           assign
     2294           selectcard = "all":U
     2295           DcardMode  = "ALL":U
     2296           .
     2297       end.
     2298     end.
     2299     when "all":U then do:
     2300         assign
     2301         FixDCard = ""
     2302         DcardMode = "ALL":U
     2303         .
     2304     end.
     2305    END CASE.
     2306    display selectcard with frame F-Main.
     2307   END.
     2308   ON VALUE-CHANGED OF T-imp IN FRAME F-Main
     2309   DO:
     2310     assign T-imp.
     2311     display
     2312       T-imp
     2313       with frame F-Main .
     2314   END.
     2315   ON VALUE-CHANGED OF T-legacy IN FRAME F-Main
     2316   DO:
     2317     if v-dcoveris = "yes" then
     2318      assign T-legacy .
     2319      else do:
     2320       assign t-legacy = no.
     2321       display
     2322       t-legacy
     2323       with frame F-Main .
     2324      end.
     2325   END.
     2326   ON VALUE-CHANGED OF T-subsid IN FRAME F-Main
     2327   DO:
     2328     if v-dcoveris = "yes" then
     2329      assign T-subsid .
     2330      else do:
     2331       assign t-subsid = no.
     2332       display
     2333       t-subsid
     2334       with frame F-Main .
     2335      end.
     2336   END.
     2337   ON VALUE-CHANGED OF T-zeros IN FRAME F-Main
     2338   DO:
     2339       assign TotalOnly .
     2340   END.
     2341   ON VALUE-CHANGED OF TotalOnly IN FRAME F-Main
     2342   DO:
     2343       assign TotalOnly .
     2344       if TotalOnly then do:
     2345           ENABLE UpLevel with frame F-Main .
     2346           apply "entry" to UpLevel in frame F-Main .
     2347       end.
     2348       else do:
     2349           UpLevel = 0 .
     2350           DISPLAY UpLevel with frame F-Main .
     2351           DISABLE UpLevel with frame F-Main .
     2352       end.
     2353   END.
     2354   if not this-procedure :persistent
     2355   then do:
     2356     message
     2357       vss-workfile vss-revision vss-description skip
     2358       "Ошибка при запуске процедуры" skip
     2359       "Данную процедуру следует запускать только с параметром persistent" skip
     2360       view-as alert-box error .
     2361     undo, return error .
     2362   end.
     2363   PROCEDURE adm-create-objects :
     2364     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     2365     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     2366     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     2367     CASE adm-current-page:
     2368       WHEN 0 THEN DO:
     2369          RUN init-object IN THIS-PROCEDURE (
     2370                INPUT  'rep/s-time.w':U ,
     2371                INPUT  FRAME F-Main:HANDLE ,
     2372                INPUT  '':U ,
     2373                OUTPUT h_s-time ).
     2374       END.
     2375     END CASE.
     2376   END PROCEDURE.
     2377   PROCEDURE adm-row-available :
     2378     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2379     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2380     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2381     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2382     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2383     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2384     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2385     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2386     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2387     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2388     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2389     IF adm-updating-record THEN RETURN.
     2390     RUN get-attribute ('FIELDS-ENABLED':U).
     2391     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2392     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2393         OUTPUT link-handle) NO-ERROR.
     2394     IF link-handle = "":U THEN
     2395         RETURN.
     2396     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2397     IF NUM-ENTRIES(link-handle) > 1 THEN
     2398         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2399             "encountered more than one RECORD-SOURCE.":U SKIP
     2400             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2401                VIEW-AS ALERT-BOX ERROR.
     2402     RUN get-attribute ('Key-Name':U).
     2403     key-name = RETURN-VALUE.
     2404     IF key-name = "":U THEN key-name = ?.
     2405     IF key-name NE ? THEN DO:
     2406       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2407         NO-ERROR.
     2408       IF key-value NE ? THEN
     2409         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2410     END.
     2411   IF VALID-HANDLE (adm-object-hdl) THEN
     2412       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2413   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2414   END PROCEDURE.
     2415   PROCEDURE disable_UI :
     2416     HIDE FRAME F-Main.
     2417     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2418   END PROCEDURE.
     2419   PROCEDURE enable_UI :
     2420     DISPLAY selectcard UpLevel TotalOnly T-zeros T-legacy T-subsid T-imp T-time
     2421             up-levelt
     2422         WITH FRAME F-Main.
     2423     ENABLE RECT-2 RECT-3 RECT-client selectcard TotalOnly T-zeros T-legacy
     2424            T-subsid T-imp T-time up-levelt
     2425         WITH FRAME F-Main.
     2426   END PROCEDURE.
     2427   PROCEDURE local-initialize :
     2428     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2429     RUN set-position IN h_s-time ( 1.96 , 34.88 ) NO-ERROR.
     2430   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2432     (output v-curr-r-b
     2433     )  .
     2434     Up-Levelt  = Up-Levelt +
     2435     ( if v-curr-r-b = 'base':U then " (вал.)" else " (руб.)" ) .
     2436     DIsplay Up-levelt
     2437     WITH frame F-Main.
     2438     define variable v-conf-type as character no-undo .
     2439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2440     (input  'dcoveris'
     2441     ,input  0
     2442     ,input  '':U
     2443     ,input  0
     2444     ,input  '':U
     2445     ,input  '':U
     2446     ,input  '':U
     2447     ,input  NO
     2448     ,output v-dcoveris
     2449     ,output v-conf-type
     2450     ) NO-ERROR .
     2451     IF ERROR-STATUS:ERROR OR
     2452       v-conf-type <> 'L':U THEN
     2453       v-dcoveris = "no".
     2454      if v-dcoveris <> "yes" then disable
     2455      t-legacy
     2456      t-subsid
     2457      with
     2458      frame F-Main .
     2459     parparentproc = my-handle.
     2460   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2461     run mainmenu_getcntxt in parparentproc
     2462       (output v-cntxt-db-num
     2463       ,output v-cntxt-userid
     2464       ,output v-cntxt-level
     2465       ,output v-cntxt-host-code-obj
     2466       ,output v-cntxt-obj-type
     2467       ,output v-cntxt-obj-code
     2468       ,output v-cntxt-db-num-obj
     2469       ,output v-cntxt-is-admin
     2470       ) .
     2471   END PROCEDURE.
     2472   PROCEDURE My-report :
     2473   define variable num-g# as integer no-undo.
     2474   DEFINE VARIABLE for-d-pcnt as character no-undo .
     2475   DEFINE VARIABLE loc-d-pcnt like ub.dis-card.d-pcnt no-undo .
     2476   define variable v-header-base-curr as character no-undo .
     2477   define variable accum-counter as integer no-undo .
     2478   define variable accum-qnty     as decimal no-undo .
     2479   define variable accum-sum      as decimal no-undo .
     2480   define variable accum-discount as decimal no-undo .
     2481   define variable accum-netto    as decimal no-undo .
     2482   define variable accum-counter-cli  as integer no-undo .
     2483   define variable accum-qnty-cli     as decimal no-undo .
     2484   define variable accum-sum-cli      as decimal no-undo .
     2485   define variable accum-discount-cli as decimal no-undo .
     2486   define variable accum-netto-cli    as decimal no-undo .
     2487   define variable accum-counter-leg  as integer no-undo .
     2488   define variable accum-qnty-leg     as decimal no-undo .
     2489   define variable accum-sum-leg      as decimal no-undo .
     2490   define variable accum-discount-leg as decimal no-undo .
     2491   define variable accum-netto-leg    as decimal no-undo .
     2492   define variable accum-counter-crd  as integer no-undo .
     2493   define variable accum-qnty-crd     as decimal no-undo .
     2494   define variable accum-sum-crd      as decimal no-undo .
     2495   define variable accum-discount-crd as decimal no-undo .
     2496   define variable accum-netto-crd    as decimal no-undo .
     2497   define variable v-d-card           like ub.dis-card.d-card no-undo .
     2498   define variable v-ii as integer no-undo .
     2499   define variable stream-pos as integer no-undo .
     2500   define variable v-root-card like ub.dis-card.d-card no-undo .
     2501   define variable v-cli-code like ub.dis-card.cli-code no-undo .
     2502   define variable v-cli-type like ub.dis-card.cli-type no-undo .
     2503   define variable v-cli-type-code as character no-undo .
     2504   define variable v-cli-name  like ub.clients.obj-name no-undo .
     2505   define variable v-show-d-card like ub.dis-card.d-card no-undo .
     2506   define variable ii as integer no-undo .
     2507   define variable v-base-code like ub.sysconf.base-code no-undo .
     2508   define buffer buf_dis-card for ub.dis-card.
     2509   define buffer buf_currency for ub.currency.
     2510   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2512     (input  v-cntxt-host-code-obj
     2513     ,output v-base-code
     2514     )  .
     2515   find first buf_currency where
     2516         buf_currency.curr-code = v-base-code.
     2517   assign
     2518   v-header-base-curr = string( "( Все цены указаны в " +
     2519                               (if v-curr-r-b = 'base':U
     2520                               then caps( trim( buf_currency.curr-abbr ) )
     2521                               else  "РУБ") + " )" )
     2522   .
     2523   DEFINE FRAME X123
     2524   sym1 column-label ":!:" format "X(1)"
     2525   dcards.date_ column-label "Дата!покупки" format "99/99/9999"
     2526   dcards.artic column-label "Артикул! " format "X(16)"
     2527   dcards.b-code column-label "Баркод!" format ">>>>>>>>>>>>9"
     2528   goods.gds-name format "X(25)"
     2529   cli-prod.obj-name column-label "Производитель!(поставщик)" format "X(38)"
     2530   dcards.sale-price column-label "Цена!отпускная" format ">,>>>,>>9.99"
     2531   dcards.qnty column-label "Количество  ! " format "->>>>>>9.<<<"
     2532   dcards.sum column-label "Получено! " format "->>,>>>,>>>,>>9.99"
     2533   dcards.discount column-label "Скидка! " format "->>,>>>,>>9.99"
     2534   for-netto column-label "Сумма!нетто" format "->>>,>>>,>>9.99"
     2535   sym2 column-label ":!:" format "X(1)"
     2536   HEADER
     2537   cur-time-print() AT 5 format "x(35)"
     2538   v-header-base-curr  format "X(40)" AT 50
     2539   "Страница " AT 100 PAGE-NUMBER( PrnLibStream ) AT 110 FORMAT ">>>>9" SKIP
     2540   Line format "X(184)" AT 1
     2541   with width 232 down stream-io use-text .
     2542   assign
     2543   frame F-Main selectcard
     2544   frame F-Main TotalOnly
     2545   frame F-Main UpLevel
     2546   frame F-Main T-time
     2547   frame F-Main T-Zeros
     2548   .
     2549   CASE X-selectgood:
     2550     when 3 then do:
     2551       For each g#cli no-lock:
     2552           num-g# = num-g# + 1.
     2553           if num-g#= 1 then
     2554           FixProdAttr = g#cli.obj-type + string( g#cli.obj-code ) .
     2555           if num-g# > 1 then leave.
     2556       end.
     2557     end.
     2558     when 2 then do:
     2559       For each tmp#grp no-lock:
     2560           num-g# = num-g# + 1.
     2561           if num-g# = 1 then
     2562           FixProdAttr = string( tmp#grp.node-code ) .
     2563           if num-g# > 1 then leave.
     2564       end.
     2565     end.
     2566     when 4 or when 5 then do:
     2567       For each gds-list no-lock:
     2568           num-g# = num-g# + 1.
     2569           if num-g# = 1 then
     2570           FixProdAttr = string( gds-list.gds-code ) .
     2571           if num-g# > 1 then leave.
     2572       end.
     2573     end.
     2574   END CASE.
     2575   run My-var.
     2576   if num-g# = 1 then.
     2577   else
     2578   FIXprodAttr = "".
     2579   run waitfram-show in this-procedure ( "Подождите ..." ) .
     2580   CASE DcardMode:
     2581       when "ALL":U then do:
     2582           run rep/e-xldcd.p (
     2583                               input "ALL":U
     2584                              ,input ""
     2585                              ,input X-SelectGood
     2586                              ,input FixProdAttr
     2587                              ,input TotalOnly
     2588                              ,input X-date-Start
     2589                              ,input X-date-End
     2590                              ,input T-time
     2591                              ,input T-zeros
     2592                              ,input T-legacy
     2593                              ,input t-subsid
     2594                              ,input ( if X-SelectGood = 1 then "TRUE" else (IF num-g# > 1 then "LIST" else "ONE"))
     2595                              ,input T-imp
     2596                              )
     2597                   .
     2598       end.
     2599       when "ONE":U then do:
     2600           run rep/e-xldcd.p (
     2601                               input "ONE":U
     2602                              ,input Fixdcard
     2603                              ,input X-SelectGood
     2604                              ,input FixProdAttr
     2605                              ,input TotalOnly
     2606                              ,input X-date-Start
     2607                              ,input X-date-End
     2608                              ,input T-time
     2609                              ,input T-zeros
     2610                              ,input T-legacy
     2611                              ,input t-subsid
     2612                              ,input ( if X-SelectGood = 1 then "TRUE" else (IF num-g# > 1 then "LIST" else "ONE"))
     2613                              ,input T-imp
     2614                              )
     2615                   .
     2616       end.
     2617       when "LIST":U then do:
     2618           run rep/e-xldcd.p (
     2619                               input "LIST":U
     2620                              ,input ""
     2621                              ,input X-SelectGood
     2622                              ,input FixProdAttr
     2623                              ,input TotalOnly
     2624                              ,input X-date-Start
     2625                              ,input X-date-End
     2626                              ,input T-time
     2627                              ,input T-zeros
     2628                              ,input T-legacy
     2629                              ,input t-subsid
     2630                              ,input ( if X-SelectGood = 1 then "TRUE" else (IF num-g# > 1 then "LIST" else "ONE"))
     2631                              ,input T-imp
     2632                              )
     2633                   .
     2634       end.
     2635   end.
     2636   run waitfram-hide in this-procedure .
     2637   if can-find( first dcards ) then do:
     2638     run prn-lib-open-stream  in this-procedure (
     2639                                                 input my-handle
     2640                                                 ,input 43
     2641                                                 ,input yes
     2642                                                 ,input no
     2643                                                 ).
     2644     Line = fill( "-", 200 ) .
     2645     FORM HEADER
     2646     Line format "X(184)" AT 1 SKIP
     2647     "Продолжение - на следующей странице" AT 30 SKIP
     2648     with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2649     VIEW stream PrnLibStream FRAME BottomFrame .
     2650     PUT stream PrnLibStream
     2651     space(40)
     2652     "Отчет по продажам постоянным клиентам" skip
     2653     space(40) str1 format "X(60)" skip
     2654     space(20) ( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ) format "x(40)" skip
     2655     space(20) "По объектам :  " .
     2656     FOR EACH obj-list :
     2657         FIND FIRST cli-obj WHERE cli-obj.obj-type = obj-list.obj-type AND
     2658                                   cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     2659         FIND FIRST db WHERE db.db-num = cli-obj.db-num NO-LOCK .
     2660         PUT stream PrnLibStream
     2661         string( trim( string( db.db-name, "x(30)" ) ) + " / " + cli-obj.obj-name )
     2662         format "x(100)"     skip space(35) .
     2663     END.
     2664     PUT stream PrnLibStream "" skip .
     2665     CASE DcardMode:
     2666       when "ALL":U then do:
     2667         PUT stream PrnLibStream space(20) "По ВСЕМ картам." format "x(40)" skip.
     2668       end.
     2669       when "ONE":U then do:
     2670         FIND FIRST cli-dcard WHERE cli-dcard.obj-type = dis-card.cli-type AND
     2671                                   cli-dcard.obj-code = dis-card.cli-code NO-LOCK .
     2672         PUT stream PrnLibStream
     2673         space(20) substitute("По карте &1 держатель - &2", dis-card.d-card, cli-dcard.obj-name ) format "x(80)" skip.
     2674       end.
     2675       when "LIST":U then do:
     2676         PUT stream PrnLibStream space(10) string("По сформированному списку карт") format "x(50)" skip.
     2677         ii = 0.
     2678         for each dc-list no-lock:
     2679           ii = ii + 1.
     2680         end.
     2681         PUT stream PrnLibStream unformatted substitute("В списке &1 карт", ii) skip.
     2682       end.
     2683     END CASE.
     2684     if X-SelectGood = 1 then do:
     2685       PUT stream PrnLibStream
     2686       space(20) "По ВСЕМ производителям ( поставщикам )." format "x(40)" skip(1) .
     2687     end.
     2688     else do:
     2689       CASE X-selectgood:
     2690         when 3 then do:
     2691           PUT stream PrnLibStream
     2692           space(20)  "По производителям: " format "x(80)" skip(0) .
     2693           for each g#cli:
     2694               PUT stream PrnLibStream
     2695               space(20) g#cli.obj-name format "x(80)" skip(0) .
     2696           end.
     2697         end.
     2698         when 2 then do:
     2699           PUT stream PrnLibStream
     2700           space(20)  "По группам товаров: " format "x(80)" skip(0) .
     2701           for each tmp#grp:
     2702               PUT stream PrnLibStream
     2703               space(20) tmp#grp.grp-name format "x(80)" skip(0) .
     2704           end.
     2705         end.
     2706         when 4 then do:
     2707           PUT stream PrnLibStream space(10)  "По сформированному списку товаров " format "x(50)" .
     2708           ii = 0.
     2709           for each gds-list:
     2710             ii = ii + 1.
     2711           end.
     2712           PUT stream PrnLibStream unformatted substitute("В списке &1 товаров", ii) skip.
     2713         end.
     2714         when 5 then do:
     2715           find first gds-list.
     2716           PUT stream PrnLibStream
     2717           space(20)  "По товару: " format "x(10)"
     2718           gds-list.artic chr(32) gds-list.prod-type gds-list.prod-code chr(32) gds-list.gds-name
     2719           skip(0) .
     2720         end.
     2721       END CASE.
     2722       PUT stream PrnLibStream SKIP(0).
     2723     end.
     2724     IF T-time then do:
     2725       PUT stream PrnLibStream UNFORMATTED
     2726       "Выборочно по времени: ".
     2727       FOR EACH times No-LOCK :
     2728         PUT stream PrnLibStream UNFORMATTED
     2729         times
     2730         chr(32)
     2731         .
     2732       END.
     2733       PUT stream PrnLibStream UNFORMATTED
     2734       SKIP (1).
     2735     end.
     2736     if t-legacy
     2737     or t-subsid
     2738     then do:
     2739         PUT stream PrnLibStream UNFORMATTED
     2740       (if t-legacy
     2741         then "С учетом перевыпуска карт (приведены номера карт ПОСЛЕДНЕГО ВЫПУСКА)"
     2742         else '':U)
     2743       (if t-subsid
     2744         then "С учетом дополнительных карт (приведены номера ОСНОВНЫХ карт)"
     2745         else '':U)
     2746       SKIP (1).
     2747     end.
     2748     FOR EACH dcards where (UpLevel = 0 or dcards.sum >= UpLevel) ,
     2749         FIRST  dis-card NO-LOCK WHERE dis-card.d-card = dcards.d-card
     2750     BREAK
     2751     BY dcards.cli-type-code
     2752     BY dcards.card-num-chr
     2753     BY dcards.d-card
     2754     BY dcards.date_ :
     2755       if (not t-legacy and not t-subsid)
     2756       or first-of (dcards.cli-type-code) then do:
     2757         find first cli-dcard no-lock where
     2758                   cli-dcard.obj-type = dis-card.cli-type
     2759               and cli-dcard.obj-code = dis-card.cli-code no-error .
     2760         if available cli-dcard then do:
     2761           assign
     2762           v-cli-name = cli-dcard.obj-name
     2763           v-cli-type-code = dis-card.cli-type + string(dis-card.cli-code)
     2764           .
     2765         end.
     2766         else do:
     2767           assign
     2768           v-cli-name = dis-card.cli-type + string(dis-card.cli-code)
     2769           v-cli-type-code = dis-card.cli-type + string(dis-card.cli-code)
     2770           .
     2771         end.
     2772       end.
     2773       if first-of (dcards.cli-type-code) then do:
     2774         assign
     2775         accum-counter-cli  = 0
     2776         accum-qnty-cli     = 0
     2777         accum-sum-cli      = 0
     2778         accum-discount-cli = 0
     2779         accum-netto-cli    = 0
     2780         only-one-card-per-cli = 0
     2781         .
     2782       end.
     2783       if first-of( dcards.card-num-chr) then do:
     2784         assign
     2785         accum-counter-leg  = 0
     2786         accum-qnty-leg     = 0
     2787         accum-sum-leg      = 0
     2788         accum-discount-leg = 0
     2789         accum-netto-leg    = 0
     2790         only-one-card-per-leg = 0
     2791         .
     2792       end.
     2793       if first-of( dcards.d-card) then do:
     2794         assign
     2795         accum-counter-crd  = 0
     2796         accum-qnty-crd     = 0
     2797         accum-sum-crd      = 0
     2798         accum-discount-crd = 0
     2799         accum-netto-crd    = 0
     2800         .
     2801       end.
     2802       assign
     2803       accum-counter         = accum-counter      + dcards.counter
     2804       accum-qnty            = accum-qnty         + dcards.qnty
     2805       accum-sum             = accum-sum          + dcards.sum
     2806       accum-discount        = accum-discount     + dcards.discount
     2807       accum-netto           = accum-netto        + dcards.sum - dcards.discount
     2808       accum-counter-cli     = accum-counter-cli  + dcards.counter
     2809       accum-qnty-cli        = accum-qnty-cli     + dcards.qnty
     2810       accum-sum-cli         = accum-sum-cli      + dcards.sum
     2811       accum-discount-cli    = accum-discount-cli + dcards.discount
     2812       accum-netto-cli       = accum-netto-cli    + dcards.sum - dcards.discount
     2813       accum-counter-leg     = accum-counter-leg  + dcards.counter
     2814       accum-qnty-leg        = accum-qnty-leg     + dcards.qnty
     2815       accum-sum-leg         = accum-sum-leg      + dcards.sum
     2816       accum-discount-leg    = accum-discount-leg + dcards.discount
     2817       accum-netto-leg       = accum-netto-leg    + dcards.sum - dcards.discount
     2818       accum-counter-crd     = accum-counter-crd  + dcards.counter
     2819       accum-qnty-crd        = accum-qnty-crd     + dcards.qnty
     2820       accum-sum-crd         = accum-sum-crd      + dcards.sum
     2821       accum-discount-crd    = accum-discount-crd + dcards.discount
     2822       accum-netto-crd       = accum-netto-crd    + dcards.sum - dcards.discount
     2823       .
     2824       if t-legacy
     2825       or t-subsid
     2826       then do:
     2827         if only-one-card-per-leg = 0 then only-one-card-per-leg = 1.
     2828         else only-one-card-per-leg = 2.
     2829         if first-of( dcards.card-num-chr ) then do:
     2830           assign
     2831           v-show-d-card = dcards.card-num-chr.
     2832         end.
     2833       end.
     2834       if first-of( dcards.d-card ) then do:
     2835         if first( dcards.d-card ) then do:
     2836           DOWN
     2837           stream PrnLibStream 1
     2838           with frame X123 .
     2839         end.
     2840         only-one-card-per-cli = only-one-card-per-cli + 1.
     2841         FOR-D-PCNT = GET-D-PCNT(buffer dis-card
     2842                                 ,input v-cntxt-host-code-obj
     2843                                 ,input v-cntxt-obj-type
     2844                                 ,input v-cntxt-obj-code
     2845                                 ,input 'def-pcnt':U
     2846                                 ,output loc-d-pcnt).
     2847         PUT stream PrnLibStream space(10)
     2848         substitute ("№ карты : &1 &2 / &3 (&4) / Процент скидки : &5"
     2849                     , (if t-legacy or t-subsid then ("~{" + v-show-d-card + "~}") else "":U)
     2850                     ,  trim( dcards.d-card )
     2851                     ,  trim(v-cli-name)
     2852                     ,  (if t-legacy or t-subsid then dcards.cli-type-code else v-cli-type-code)
     2853                     ,  for-d-pcnt )
     2854         format "x(100)" SKIP.
     2855         UNDERLINE stream PrnLibStream
     2856         dcards.date_
     2857         dcards.artic
     2858         cli-prod.obj-name
     2859         goods.gds-name
     2860         dcards.b-code
     2861         dcards.sale-price
     2862         dcards.qnty
     2863         dcards.sum
     2864         dcards.discount
     2865         for-netto
     2866         with frame X123 .
     2867         if NOT TotalOnly then do:
     2868           if dcards.b-code <> 0 then do:
     2869             FIND FIRST cli-prod WHERE cli-prod.obj-type = dcards.prod-type AND
     2870                         cli-prod.obj-code = dcards.prod-code NO-LOCK .
     2871             FIND FIRST goods WHERE goods.artic = dcards.artic AND
     2872                         goods.prod-type = dcards.prod-type AND
     2873                         goods.prod-code = dcards.prod-code NO-LOCK.
     2874             FIND FIRST gds-prt WHERE gds-prt.node-code = dcards.node-code No-LOCK NO-ERROR.
     2875             IF AVAIL gds-prt AND NOT gds-prt.node-name = '_Пустая шкала':U
     2876             then
     2877             for-name = string(goods.gds-name, "X(25)") + "\" + gds-prt.node-name.
     2878             else for-name = goods.gds-name.
     2879             namebuf1 = breakstr(for-name, 25, input-output namebuf1, input-output namebuf2).
     2880             DISPLAY stream PrnLibStream
     2881             sym1
     2882             dcards.date_
     2883             dcards.artic
     2884             dcards.b-code
     2885             cli-prod.obj-name
     2886             namebuf1 @ goods.gds-name
     2887             dcards.sale-price
     2888             dcards.qnty
     2889             dcards.sum
     2890             dcards.discount
     2891             (dcards.sum - dcards.discount) @ for-netto
     2892             sym2
     2893             with frame X123 .
     2894             DOWN stream PrnLibStream 1 with frame X123 .
     2895             if namebuf2 <> "" then do:
     2896               DISPLAY stream PrnLibStream
     2897               sym1
     2898               namebuf2 @ goods.gds-name
     2899               sym2 with frame X123 .
     2900               DOWN stream PrnLibStream 1 with frame X123 .
     2901             end.
     2902           end.
     2903           else do:
     2904             if dcards.artic > "" then
     2905             DISPLAY stream PrnLibStream
     2906             sym1
     2907             dcards.date_
     2908             dcards.artic
     2909             dcards.sum
     2910             (dcards.sum - dcards.discount) @ for-netto
     2911             sym2
     2912             with frame X123 .
     2913             DOWN stream PrnLibStream 1 with frame X123 .
     2914           end.
     2915         end.
     2916       end.
     2917       else do:
     2918         if NOT TotalOnly then do:
     2919           if dcards.b-code <> 0 then do:
     2920             FIND FIRST cli-prod WHERE cli-prod.obj-type = dcards.prod-type AND
     2921                                     cli-prod.obj-code = dcards.prod-code NO-LOCK .
     2922             FIND FIRST goods WHERE goods.artic = dcards.artic AND
     2923                         goods.prod-type = dcards.prod-type AND
     2924                         goods.prod-code = dcards.prod-code NO-LOCK.
     2925             FIND FIRST gds-prt WHERE gds-prt.node-code = dcards.node-code No-LOCK NO-ERROR.
     2926             IF AVAIL gds-prt AND NOT gds-prt.node-name = '_Пустая шкала':U
     2927             then
     2928             for-name = string(goods.gds-name, "X(25)") + "\" + gds-prt.node-name.
     2929             else for-name = goods.gds-name.
     2930             namebuf1 = breakstr(for-name, 25, input-output namebuf1, input-output namebuf2).
     2931             DISPLAY stream PrnLibStream
     2932             sym1
     2933             dcards.date_
     2934             dcards.artic
     2935             dcards.b-code
     2936             cli-prod.obj-name
     2937             namebuf1 @ goods.gds-name
     2938             dcards.sale-price
     2939             dcards.qnty
     2940             dcards.sum
     2941             dcards.discount
     2942             (dcards.sum - dcards.discount) @ for-netto
     2943             sym2
     2944             with frame X123 .
     2945             DOWN stream PrnLibStream 1 with frame X123 .
     2946             if namebuf2 <> "" then do:
     2947               DISPLAY stream PrnLibStream
     2948               sym1
     2949               namebuf2 @ goods.gds-name
     2950               sym2
     2951               with frame X123 .
     2952               DOWN stream PrnLibStream 1 with frame X123 .
     2953           end.
     2954         end.
     2955         else do:
     2956           if dcards.artic > "" then
     2957           DISPLAY stream PrnLibStream
     2958           sym1
     2959           dcards.date_
     2960           dcards.artic
     2961           dcards.sum
     2962           (dcards.sum - dcards.discount) @ for-netto
     2963           sym2
     2964           with frame X123 .
     2965           DOWN stream PrnLibStream 1 with frame X123 .
     2966         end.
     2967       end.
     2968     end.
     2969     if last-of( dcards.d-card ) then do:
     2970       if NOT TotalOnly
     2971       then
     2972       UNDERLINE stream PrnLibStream
     2973       dcards.date_
     2974       dcards.artic
     2975       dcards.b-code
     2976       cli-prod.obj-name
     2977       goods.gds-name
     2978       dcards.sale-price
     2979       dcards.qnty
     2980       dcards.sum
     2981       dcards.discount
     2982       for-netto
     2983       with frame X123 .
     2984       DISPLAY stream PrnLibStream
     2985       sym1
     2986       "Итого" @ dcards.date_
     2987       "по карте" @ dcards.artic
     2988       ("чеков: " + string( accum-counter-crd ) )@ cli-prod.obj-name
     2989       dcards.d-card @ goods.gds-name
     2990       ACCUM-sum-crd @ dcards.sum
     2991       ACCUM-discount-crd  @ dcards.discount
     2992       ACCUM-netto-crd @ for-netto
     2993       sym2
     2994       with frame X123.
     2995       if not TotalOnly then
     2996       DISPLAY stream PrnLibStream
     2997       ( ACCUM-qnty-crd ) @ dcards.qnty
     2998       with frame X123.
     2999       UNDERLINE stream PrnLibStream
     3000       dcards.date_
     3001       dcards.artic
     3002       dcards.b-code
     3003       cli-prod.obj-name
     3004       goods.gds-name
     3005       dcards.sale-price
     3006       dcards.qnty
     3007       dcards.sum
     3008       dcards.discount
     3009       for-netto
     3010       with frame X123 .
     3011     end.
     3012     if t-legacy or t-subsid then do:
     3013       if last-of(dcards.card-num-chr) then do:
     3014       end.
     3015       if last-of(dcards.card-num-chr) and only-one-card-per-leg = 2 then do:
     3016         if NOT TotalOnly
     3017         then
     3018         UNDERLINE stream PrnLibStream
     3019         dcards.date_
     3020         dcards.artic
     3021         dcards.b-code
     3022         cli-prod.obj-name
     3023         goods.gds-name
     3024         dcards.sale-price
     3025         dcards.qnty
     3026         dcards.sum
     3027         dcards.discount
     3028         for-netto
     3029         with frame X123 .
     3030         DISPLAY stream PrnLibStream
     3031         sym1
     3032         "Итого" @ dcards.date_
     3033         substitute("~{&1~}", substring(v-show-d-card, 1, 14)) @  dcards.artic
     3034         ("чеков: " + string( ACCUM-counter-leg ))
     3035           @ cli-prod.obj-name
     3036         (trim( v-cli-name ) + " (" +
     3037         (if t-legacy or t-subsid then dcards.cli-type-code else v-cli-type-code) + " )" ) @ goods.gds-name
     3038         ACCUM-sum-leg  @ dcards.sum
     3039         ACCUM-discount-leg @ dcards.discount
     3040         ACCUM-netto-leg @ for-netto
     3041         sym2
     3042         with frame X123 .
     3043         if not TotalOnly then
     3044         DISPLAY stream PrnLibStream
     3045         ( ACCUM-qnty-leg) @ dcards.qnty
     3046         with frame X123.
     3047         UNDERLINE stream PrnLibStream
     3048         dcards.date_
     3049         dcards.artic
     3050         dcards.b-code
     3051         cli-prod.obj-name
     3052         goods.gds-name
     3053         dcards.sale-price
     3054         dcards.qnty
     3055         dcards.sum
     3056         dcards.discount
     3057         for-netto
     3058         with frame X123 .
     3059       end.
     3060     end.
     3061     if last-of(dcards.cli-type-code ) and only-one-card-per-cli > 1 then do:
     3062       if NOT TotalOnly
     3063       then
     3064       UNDERLINE stream PrnLibStream
     3065       dcards.date_
     3066       dcards.artic
     3067       dcards.b-code
     3068       cli-prod.obj-name
     3069       goods.gds-name
     3070       dcards.sale-price
     3071       dcards.qnty
     3072       dcards.sum
     3073       dcards.discount
     3074       for-netto
     3075       with frame X123 .
     3076       DISPLAY stream PrnLibStream
     3077       sym1
     3078       "Итого" @ dcards.date_
     3079       "по клиенту"  @  dcards.artic
     3080       ("чеков: " + string( ACCUM-counter-cli ))
     3081         @ cli-prod.obj-name
     3082       (trim( v-cli-name ) + " (" +
     3083       (if t-legacy or t-subsid then dcards.cli-type-code else v-cli-type-code) + " )" ) @ goods.gds-name
     3084       ACCUM-sum-cli  @ dcards.sum
     3085       ACCUM-discount-cli @ dcards.discount
     3086       ACCUM-netto-cli @ for-netto
     3087       sym2
     3088       with frame X123 .
     3089       if not TotalOnly then
     3090       DISPLAY stream PrnLibStream
     3091       ( ACCUM-qnty-cli) @ dcards.qnty
     3092       with frame X123.
     3093       UNDERLINE stream PrnLibStream
     3094       dcards.date_
     3095       dcards.artic
     3096       dcards.b-code
     3097       cli-prod.obj-name
     3098       goods.gds-name
     3099       dcards.sale-price
     3100       dcards.qnty
     3101       dcards.sum
     3102       dcards.discount
     3103       for-netto
     3104       with frame X123 .
     3105      end.
     3106      if last( dcards.d-card ) AND FixDCard = "" then do:
     3107         DISPLAY stream PrnLibStream
     3108         sym1
     3109         "Итого" @ dcards.date_
     3110         "по ВСЕМ" @ dcards.artic
     3111         ("чеков: " + string(ACCUM-counter)) @ cli-prod.obj-name
     3112         ACCUM-sum @ dcards.sum
     3113         ACCUM-discount @ dcards.discount
     3114         ACCUM-netto @ for-netto
     3115         sym2
     3116         with frame X123 .
     3117         if not TotalOnly then
     3118         Display stream PrnLibStream
     3119         ( ACCUM-qnty) @ dcards.qnty
     3120         with frame X123.
     3121         UNDERLINE stream PrnLibStream
     3122         dcards.date_
     3123         dcards.artic
     3124         dcards.b-code
     3125         cli-prod.obj-name
     3126         goods.gds-name
     3127         dcards.sale-price
     3128         dcards.qnty
     3129         dcards.sum
     3130         dcards.discount
     3131         for-netto
     3132         with frame X123 .
     3133       end.
     3134     END.
     3135     HIDE stream PrnLibStream FRAME BottomFrame .
     3136     if x-SelectGood = 4
     3137     and Print-List-hist
     3138     then do:
     3139       run lhistprex-print-gds-list-hist-excel  in this-procedure (input yes, input no, 2).
     3140     end.
     3141     if Print-List-hist
     3142     and selectcard = 'selective' then do:
     3143       run lhistprex-print-dc-list-hist-excel  in this-procedure (input yes, input no, 2).
     3144     end.
     3145     output stream PrnLibStream CLOSE .
     3146   run prn-lib-prn-file in this-procedure (
     3147                                             input my-handle
     3148                                             ,input 8
     3149                                             ).
     3150   end.
     3151   else
     3152   message
     3153   "На выбранных Вами объектах" skip
     3154   "не было продаж постоянным клиентам" skip
     3155   "в течение заданного Вами периода времени."
     3156   view-as alert-box INFORMATION .
     3157   FOR EACH dcards :
     3158       delete dcards .
     3159   END.
     3160   END PROCEDURE.
     3161   PROCEDURE My-Var :
     3162   assign
     3163   frame F-Main selectcard
     3164   frame F-Main TotalOnly
     3165   frame F-Main UpLevel
     3166   frame F-Main T-time
     3167   frame F-Main T-legacy
     3168   frame F-Main T-subsid
     3169   .
     3170   Assign
     3171    STR-obj-type = ''
     3172    STR-obj-code = ''
     3173    STR-obj-name = ''
     3174    STR-obj      = ''.
     3175   For each obj-list no-lock:
     3176    Assign
     3177    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     3178    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     3179    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     3180    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     3181   End.
     3182   Reportname = "ОТЧЕТ ПО ПОКУПКАМ ПОСТОЯННЫХ КЛИЕНТОВ".
     3183   ReportHeader = "Покупатели: " +
     3184                              radio-label(string(selectcard), selectcard:radio-buttons) + chr(10) +
     3185                  (if TotalOnly then totalOnly:label else "") + chr(10) +
     3186                  (If Uplevel > 0
     3187                   then string((UpLevel:label + " " + string(Uplevel)) )
     3188                   else "") +
     3189                   (IF T-time then string(chr(10) + "Выборочно по времени") else "") +
     3190                   (IF T-legacy then string(chr(10) + "С учетом перевыпуска карт") else "") +
     3191                   (IF T-subsid then string(chr(10) + "С учетом дополнительных карт") else "")
     3192                    .
     3193   END PROCEDURE.
     3194   PROCEDURE send-records :
     3195   END PROCEDURE.
     3196   PROCEDURE state-changed :
     3197     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     3198     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3199   END PROCEDURE.
