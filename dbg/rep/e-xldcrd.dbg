      835   define variable var-report-r-b as character no-undo .
      836   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      837   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      838     (output var-report-r-b
      839     )  .
      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      842   define new shared variable RepPathName        as character no-undo .
      843   define new shared variable PrintRubl          as logical   no-undo .
      844   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   define  stream PrnLibStream.
      846   procedure prn-lib-prn-file :
      847     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      848     define input parameter p-DIsabledoptions as integer no-undo .
      849     define variable v-report-name as character no-undo .
      850     define variable v-user-action as character no-undo .
      851     define variable v-printed     as logical   no-undo .
      852     define variable v-exist       as logical   no-undo .
      853     do
      854       on error undo, return error
      855       :
      856       run prn-lib-get-report-name  in this-procedure (
      857         input parParentProc
      858         ,output v-report-name
      859         ).
      860   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      862     (input  v-report-name
      863     ,input  2
      864     ,output v-exist
      865     )  .
      866       if NOT v-exist then
      867       DO:
      868         Message
      869           "Нет заданий на печать ! "
      870           view-as alert-box .
      871         Return  .
      872       End.
      873       run gbl/prnfilen.w
      874         (input  ""
      875         ,input  p-DisabledOptions
      876         ,input  string(v-report-name )
      877         ,input  7
      878         ,output v-user-action
      879         ,output v-printed
      880         ) .
      881       if v-printed then
      882       do:
      883         return "YES" .
      884       end.
      885       else
      886       do:
      887         return "NO" .
      888       end.
      889     end.
      890   end procedure.
      891   procedure prn-lib-open-stream :
      892     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      893     define input parameter p-page-size    as integer no-undo .
      894     define input parameter p-is-stream    as logical no-undo .
      895     define input parameter p-append       as logical no-undo .
      896     define variable v-report-name as character no-undo .
      897     do
      898       on error undo, return error
      899       :
      900       run prn-lib-get-report-name  in this-procedure (
      901         input parParentProc
      902         ,output v-report-name
      903         ).
      904       if p-is-stream then
      905       do:
      906         if p-append then
      907         do:
      908           output stream PrnLibStream to value( v-report-name )
      909             page-size value(p-page-size) append .
      910         end.
      911         if not p-append then
      912         do:
      913           output stream PrnLibStream to value( v-report-name )
      914             page-size value(p-page-size) .
      915         end.
      916       end.
      917       if not p-is-stream then
      918       do:
      919         if p-append then
      920         do:
      921           output to value( v-report-name )
      922             page-size value(p-page-size) append .
      923         end.
      924         if not p-append then
      925         do:
      926           output to value( v-report-name )
      927             page-size value(p-page-size) .
      928         end.
      929       end.
      930     end.
      931   end procedure.
      932   procedure prn-lib-open-exp :
      933     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      934     define input parameter p-is-stream    as logical no-undo .
      935     define input parameter p-is-append    as logical no-undo .
      936     define output parameter p-ReportFileName as char init "report" no-undo.
      937     define output parameter p-process as logical no-undo .
      938     define variable glog as logical no-undo .
      939     do
      940       on error undo, return error
      941       :
      942       SYSTEM-DIALOG GET-FILE p-ReportFileName
      943         TITLE      "Укажите путь"
      944         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      945         ASK-OVERWRITE
      946         CREATE-TEST-FILE
      947         SAVE-AS
      948         USE-FILENAME
      949         DEFAULT-EXTENSION "txt"
      950         UPDATE glog
      951         .
      952       if not glog then  return.
      953       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      954       if p-is-stream then
      955       do:
      956         if p-is-append then
      957         do:
      958           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      959         end.
      960         else
      961         do:
      962           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      963         end.
      964       end.
      965       else
      966       do:
      967         if p-is-append then
      968         do:
      969           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      970         end.
      971         else
      972         do:
      973           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      974         end.
      975       end.
      976       p-process = yes.
      977     end.
      978   end procedure.
      979   procedure prn-lib-get-report-name :
      980     define input parameter parParentProc  as widget-handle no-undo.
      981     define output parameter p-report-name as character no-undo .
      982     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      983   end procedure.
      984   procedure prn-lib-reportviewer-report-name :
      985     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      986     define input parameter p-report-name-html as character no-undo .
      987     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      988   end procedure.
      989   procedure prn-lib-reportviewer :
      990     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      991     define input parameter p-report-name-html as character no-undo .
      992     define input parameter p-param        as character no-undo .
      993     define variable v-excel           as character no-undo init 'TRUE' .
      994     define variable v-value-character as character no-undo .
      995     define variable v-value-integer   as character no-undo .
      996     define variable v-value-date      as date      no-undo .
      997     define variable v-value-decimal   as decimal   no-undo .
      998     define variable rep-excel         as logical   no-undo .
      999     define variable excel-string      as character no-undo .
     1000     define variable v-param-type      as character no-undo .
     1001     define variable v-tth             as handle    no-undo .
     1002     run adm/shattri.p (
     1003       input "get":U
     1004       ,input  ""
     1005       ,input  0
     1006       ,input  'report-glob':U
     1007       ,input  'rep-excel':U
     1008       ,output v-value-character
     1009       ,output v-value-date
     1010       ,output v-value-decimal
     1011       ,output v-value-integer
     1012       ,output rep-excel
     1013       ,output v-param-type
     1014       ,INPUT-OUTPUT table-handle v-tth
     1015       )  .
     1016     if rep-excel then v-excel = "TRUE" .
     1017     else v-excel = "FALSE" .
     1018     if p-param eq ""
     1019     then
     1020        p-param = "EXCEL:" + v-excel.
     1021     else
     1022        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1023     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1024   end procedure.
     1025   function diff-list returns character (
     1026     input parfirst-list  as character,
     1027     input parsecond-list as character,
     1028     input pardelim       as character).
     1029     if pardelim = ""
     1030     or pardelim = ?
     1031     then do:
     1032       assign
     1033         pardelim = ","
     1034       .
     1035     end.
     1036     def var ind as integer no-undo .
     1037     def var v-elem as character no-undo .
     1038     def var v-result-list as character no-undo init "".
     1039     def var v-num-parfirst-list as integer no-undo .
     1040     assign
     1041       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1042     .
     1043     do ind = 1 to v-num-parfirst-list
     1044     :
     1045       assign
     1046         v-elem = entry(ind, parfirst-list, pardelim)
     1047       .
     1048       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1049         assign
     1050           v-result-list = v-result-list
     1051                         + (if v-result-list > "" then pardelim else "")
     1052                         + v-elem
     1053         .
     1054       end.
     1055     end.
     1056     return v-result-list .
     1057   end function.
     1058   function add-list returns character (
     1059    input parfirst-list  as character,
     1060    input parsecond-list as character,
     1061    input pardelim       as character).
     1062     if pardelim = ""
     1063     or pardelim = ?
     1064     then do:
     1065       assign
     1066         pardelim = ","
     1067       .
     1068     end.
     1069     def var ind as integer no-undo .
     1070     def var v-elem as character no-undo .
     1071     def var v-result-list as character no-undo init "".
     1072     def var v-num-parfirst-list as integer no-undo .
     1073     assign
     1074       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1075     .
     1076     do ind = 1 to v-num-parfirst-list
     1077     :
     1078       assign
     1079         v-elem = entry(ind, parfirst-list, pardelim)
     1080       .
     1081       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1082         assign
     1083           v-result-list = v-result-list
     1084                         + (if v-result-list > "" then pardelim else "")
     1085                         + v-elem
     1086         .
     1087       end.
     1088     end.
     1089     def var v-num-parsecond-list as integer no-undo .
     1090     assign
     1091       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1092     .
     1093     do ind = 1 to v-num-parsecond-list
     1094     :
     1095       assign
     1096         v-elem = entry(ind, parsecond-list, pardelim)
     1097       .
     1098       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1099         assign
     1100           v-result-list = v-result-list
     1101                         + (if v-result-list > "" then pardelim else "")
     1102                         + v-elem
     1103         .
     1104       end.
     1105     end.
     1106     return v-result-list .
     1107   end function.
     1108   function cross-list returns character (
     1109    input parfirst-list  as character,
     1110    input parsecond-list as character,
     1111    input pardelim       as character).
     1112     if pardelim = ""
     1113     or pardelim = ?
     1114     then do:
     1115       assign
     1116         pardelim = ","
     1117       .
     1118     end.
     1119     def var ind as integer no-undo .
     1120     def var v-elem as character no-undo .
     1121     def var v-result-list as character no-undo init "".
     1122     def var v-num-parfirst-list as integer no-undo .
     1123     assign
     1124       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1125     .
     1126     do ind = 1 to v-num-parfirst-list
     1127     :
     1128       assign
     1129         v-elem = entry(ind, parfirst-list, pardelim)
     1130       .
     1131       if lookup(v-elem, v-result-list, pardelim) = 0
     1132       and lookup(v-elem, parsecond-list, pardelim) > 0
     1133       then do:
     1134         assign
     1135           v-result-list = v-result-list
     1136                         + (if v-result-list > "" then pardelim else "")
     1137                         + v-elem
     1138         .
     1139       end.
     1140     end.
     1141     return v-result-list .
     1142   end function.
     1143   function radio-label returns character (
     1144    input par-rs-value  as character,
     1145    input par-rs-radio-buttons as character)
     1146    .
     1147    DEFINE variable v-result-label as character no-undo.
     1148    assign
     1149    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1150                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1151                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1152                             ), par-rs-radio-buttons
     1153                           )
     1154    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1155    .
     1156   return v-result-label.
     1157   end function.
     1158   function m-radio-label returns character (
     1159    input par-rs-value  as character,
     1160    input par-rs-radio-buttons as character,
     1161    input par-delim as character
     1162    )
     1163    .
     1164    DEFINE variable v-result-label as character no-undo.
     1165    assign
     1166    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1167                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1168                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1169                             ), par-rs-radio-buttons, par-delim
     1170                           )
     1171    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1172    .
     1173   return v-result-label.
     1174   end function.
     1175   FUNCTION mixlist returns character
     1176   (
     1177    input parfirst-list  as character
     1178    ,input parsecond-list as character
     1179    ,input pardelim       as character
     1180    ,input pardelim-result as character ) :
     1181     if pardelim = ""
     1182     or pardelim = ?
     1183     then do:
     1184       assign
     1185         pardelim = ","
     1186       .
     1187     end.
     1188     def var ind as integer no-undo .
     1189     def var v-elem1 as character no-undo .
     1190     def var v-elem2 as character no-undo .
     1191     def var v-result-list as character no-undo init "".
     1192     do ind = 1 to num-entries(parfirst-list, pardelim)
     1193     :
     1194       assign
     1195         v-elem1 = entry(ind, parfirst-list, pardelim)
     1196         v-elem2 = entry(ind, parsecond-list, pardelim)
     1197       .
     1198         assign
     1199           v-result-list = v-result-list
     1200                         + (if v-result-list > "" then pardelim-result else "")
     1201                         + v-elem1 + pardelim-result + v-elem2
     1202         .
     1203     end.
     1204     return v-result-list .
     1205   END FUNCTION.
     1206   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   function breakstr returns character ( input        for-name    as character,
     1208                                         input        line-length as integer,
     1209                                         input-output line1       as character,
     1210                                         input-output line2       as character ) :
     1211     define variable ii as integer no-undo.
     1212     if length( for-name ) > line-length then do:
     1213       assign ii    = 1
     1214              line1 = "":u
     1215              line2 = "":u.
     1216       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
     1217         assign line1 =       substring( for-name, 1, line-length     )
     1218                line2 = trim( substring( for-name,    line-length + 1 ) ).
     1219       end.                                                     else do:
     1220         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
     1221           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
     1222                  ii    = ii    + 1.
     1223           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
     1224             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
     1225           end.
     1226         end.
     1227         assign line2 = trim( substring( for-name, length( line1 ) ) ).
     1228       end.
     1229     end.                                else do:
     1230       assign line1 = for-name
     1231              line2 = "":u.
     1232     end.
     1233     return ( line1 ).
     1234   end function.
     1235   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1236   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237   FUNCTION get-d-pcnt RETURNS CHARACTER
     1238     ( buffer loc-dis-card for ub.dis-card,
     1239       input parhost-code as integer,
     1240       input parobj-type as character,
     1241       input parobj-code as integer,
     1242       input p-discnt-role as character,
     1243       output loc-d-v as decimal) :
     1244   define variable v-node-code as integer no-undo .
     1245   define buffer buf_dis-card-type for ub.dis-card-type.
     1246   define buffer buf_dis-card-property for ub.dis-card-property.
     1247   find first buf_dis-card-type no-lock where
     1248             buf_dis-card-type.type = loc-dis-card.type
     1249         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
     1250         and buf_dis-card-type.host-code = 0
     1251         and buf_dis-card-type.obj-type = '':U
     1252         and buf_dis-card-type.obj-code = 0 no-error.
     1253   if available buf_dis-card-type then do:
     1254     case p-discnt-role:
     1255       when 'def-pcnt':U  then do:
     1256         assign
     1257         v-node-code = 1.
     1258       end.
     1259       when 'def-cash-pcnt':U then do:
     1260         assign
     1261         v-node-code = 2.
     1262       end.
     1263       when 'def-categ':U then do:
     1264         assign
     1265         v-node-code = 3.
     1266       end.
     1267     end.
     1268     if buf_dis-card-type.d-pcnt-byshop then do:
     1269      find first buf_dis-card-property no-lock where
     1270                buf_dis-card-property.d-card = loc-dis-card.d-card
     1271            and buf_dis-card-property.dtm-code = 26
     1272            and buf_dis-card-property.host-code = parhost-code
     1273            and buf_dis-card-property.obj-type = parobj-type
     1274            and buf_dis-card-property.obj-code = parobj-code
     1275            and buf_dis-card-property.node-code = v-node-code no-error.
     1276      if available buf_dis-card-property then do:
     1277        if p-discnt-role = 'def-categ':U then do:
     1278          assign
     1279          loc-d-v = buf_dis-card-property.property-value-integer.
     1280        end.
     1281        else do:
     1282          assign
     1283          loc-d-v = buf_dis-card-property.property-value-decimal.
     1284        end.
     1285      end.
     1286       if loc-d-v = ? then do:
     1287   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1288   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1289     (
     1290      input  loc-dis-card.type
     1291     ,input  loC-dis-card.emitent-host-code
     1292     ,input  parhost-code
     1293     ,input  parobj-type
     1294     ,input  parobj-code
     1295     ,input  p-discnt-role
     1296     ,output loc-d-v
     1297     ) no-error .
     1298       end.
     1299       if loc-d-v = ? then do:
     1300         find first buf_dis-card-property no-lock where
     1301                   buf_dis-card-property.d-card = loc-dis-card.d-card
     1302               and buf_dis-card-property.dtm-code = 26
     1303               and buf_dis-card-property.host-code = parhost-code
     1304               and buf_dis-card-property.obj-type = ''
     1305               and buf_dis-card-property.obj-code = 0
     1306               and buf_dis-card-property.node-code = v-node-code no-error.
     1307         if available buf_dis-card-property then do:
     1308           if p-discnt-role = 'def-categ':U then do:
     1309             assign
     1310             loc-d-v = buf_dis-card-property.property-value-integer.
     1311           end.
     1312           else do:
     1313             assign
     1314             loc-d-v = buf_dis-card-property.property-value-decimal.
     1315           end.
     1316         end.
     1317       end.
     1318       if loc-d-v = ? then do:
     1319   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1321     (
     1322      input  loc-dis-card.type
     1323     ,input  loC-dis-card.emitent-host-code
     1324     ,input  parhost-code
     1325     ,input  ''
     1326     ,input  0
     1327     ,input  p-discnt-role
     1328     ,output loc-d-v
     1329     ) no-error .
     1330       end.
     1331       if loc-d-v = ? then do:
     1332         case p-discnt-role:
     1333           when 'def-categ':U then do:
     1334             loc-d-v = loc-dis-card.category.
     1335           end.
     1336           when 'def-pcnt':U then do:
     1337             loc-d-v = loc-dis-card.d-pcnt.
     1338           end.
     1339           when 'def-cash-pcnt':U then do:
     1340             loc-d-v = loc-dis-card.cash-d-pcnt.
     1341           end.
     1342         end case.
     1343       end.
     1344       if p-discnt-role = 'def-categ':U then do:
     1345         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     1346       end.
     1347       else do:
     1348         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     1349       end.
     1350     end.
     1351   end.
     1352   else do:
     1353    return "ОШИБКА-НЕТ ТИПА".
     1354   end.
     1355   case p-discnt-role:
     1356     when 'def-categ':U then do:
     1357        loc-d-v = loc-dis-card.category.
     1358        return string(loc-d-v, ">>>9").
     1359     end.
     1360     when 'def-pcnt':U then do:
     1361       loc-d-v = loc-dis-card.d-pcnt.
     1362       return string(loc-d-v, "->9.99%").
     1363     end.
     1364     when 'def-cash-pcnt':U then do:
     1365       loc-d-v = loc-dis-card.cash-d-pcnt.
     1366       return string(loc-d-v, "->9.99%").
     1367     end.
     1368   end case.
     1369   END FUNCTION.
     1370   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371   define variable v-waitfram-action01         as character   no-undo .
     1372   define variable v-waitfram-action02         as character   no-undo .
     1373   define variable v-waitfram-action03         as character   no-undo .
     1374   define variable mWaitFramTextBeg            as character   no-undo.
     1375   define variable mWaitFramTextEnd            as character   no-undo.
     1376   define variable mWaitFramView               as logical     no-undo.
     1377   define variable mWaitProcEvent              as logical     no-undo init yes.
     1378   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1379   define variable mWaitFramStop               as logical     no-undo.
     1380   define variable mWaitFramStopUser           as logical     no-undo.
     1381   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1382   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1383   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1384   define button B-WaitFramStop auto-end-key
     1385        label "Стоп"
     1386        size 10 by 1 tooltip "Остоновить процесс".
     1387   define button B-viewProcInfo
     1388        label "Информация"
     1389        size 15 by 1 tooltip "Информация о процесс".
     1390   define frame waitfram
     1391     v-waitfram-action01 format "x(72)" no-label skip
     1392     v-waitfram-action02 format "x(72)" no-label skip
     1393     v-waitfram-action03 format "x(72)" no-label skip
     1394     B-viewProcInfo
     1395     B-WaitFramStop at row 4 col 30
     1396     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1397     .
     1398   define new global shared variable mBatchMode as logical no-undo init ?.
     1399   define variable mFramBachModHandle as handle no-undo.
     1400   mFramBachModHandle = frame waitfram:handle.
     1401   define variable mFameOldVis as logical no-undo.
     1402   define variable mVisCUrentVin as logical no-undo.
     1403   if session:batch-mode
     1404   then
     1405      mBatchMode = yes.
     1406   if mBatchMode = ? then do:
     1407     mVisCUrentVin = current-window:visible.
     1408     mFameOldVis = mFramBachModHandle:visible.
     1409     mFramBachModHandle:visible  = yes.
     1410     mBatchMode = mFramBachModHandle:visible ne yes.
     1411     mFramBachModHandle:visible = mFameOldVis.
     1412     current-window:visible = mVisCUrentVin.
     1413   end.
     1414    if  log-manager:logfile-name ne ?
     1415     then DO:
     1416         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1417         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1418         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1419     end.
     1420   on choose of B-WaitFramStop in frame waitfram
     1421   do:
     1422     mWaitFramStop = yes.
     1423     mWaitFramStopUser = yes.
     1424   end.
     1425   function waitfram-check-timeout returns logical():
     1426      define variable vtime as int64 no-undo.
     1427      if mWaitFramStopTimeOut
     1428      then
     1429         return yes.
     1430      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1431      if     mWaitFramTimeOut ne ?
     1432         and mWaitFramTimeOut ne 0
     1433         and mWaitFramTimeOut lt vtime
     1434      then do:
     1435         mWaitFramStopTimeOut = yes.
     1436      end.
     1437      return mWaitFramStopTimeOut.
     1438   end.
     1439   procedure waitfram-hide :
     1440     if not session:batch-mode
     1441     then do
     1442     on error undo, return error return-value
     1443     :
     1444       pause 0 before-hide .
     1445       if not mBatchMode then
     1446         hide frame waitfram .
     1447     if     not mWaitFramView
     1448        and mWaitProcEvent
     1449     then
     1450       process events .
     1451     end.
     1452   end procedure.
     1453   procedure waitfram-show :
     1454     define input  parameter p-message as character no-undo .
     1455     define variable v-left-margin as integer   no-undo .
     1456     if not session:batch-mode
     1457     then do
     1458     on error undo, return error return-value
     1459     :
     1460       if length(p-message) <= 70 then do:
     1461         assign
     1462           v-left-margin = integer((70 - length(p-message)) / 2)
     1463         .
     1464         assign
     1465           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1466         .
     1467         assign
     1468           v-waitfram-action01 = " "
     1469           v-waitfram-action02 = " "
     1470                                    + fill(" ", v-left-margin)
     1471                                    + p-message
     1472           v-waitfram-action03 = " "
     1473         .
     1474       end.
     1475       else do:
     1476         define variable vRindex1 as integer no-undo.
     1477         define variable vRindex2 as integer no-undo.
     1478         vRindex1 = r-index(p-message," ",70).
     1479         if vRindex1 = 0
     1480         then
     1481            vRindex1 = 70.
     1482         if length(p-message)  <= vRindex1 + 70 then do:
     1483           assign
     1484             v-waitfram-action01 = " "
     1485             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1486             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1487           .
     1488         end.
     1489         else do:
     1490           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1491           if vRindex2 <= vRindex1
     1492           then
     1493              vRindex2 = vRindex1 + 70.
     1494           assign
     1495             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1496             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1497             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1498           .
     1499         end.
     1500       end.
     1501       B-viewProcInfo:visible   in frame waitfram = no.
     1502       B-viewProcInfo:sensitive in frame waitfram = no.
     1503       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1504       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1505       if  (   mWaitFramView
     1506          or  mWaitProcEvent)
     1507          and not mBatchMode
     1508       then
     1509          display
     1510             v-waitfram-action01 skip
     1511             v-waitfram-action02 skip
     1512             v-waitfram-action03 skip
     1513          with frame waitfram .
     1514       if     mWaitFramView
     1515          then do:
     1516             if     mWaitFramInterval ne ?
     1517                and not mBatchMode
     1518             then
     1519                wait-for go of frame waitfram pause mWaitFramInterval.
     1520          end.
     1521          else
     1522             if     mWaitProcEvent
     1523                and not mBatchMode
     1524             then
     1525                process events .
     1526     end.
     1527   end procedure.
     1528      procedure waitfram-show-this:
     1529         define input  parameter iInterval as int64 no-undo.
     1530         define variable vtime as int64 no-undo.
     1531         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1532         mWaitFramInterval = iInterval.
     1533         run waitfram-show (substitute("&1&2 &3&4" ,
     1534                                       mWaitFramTextBeg ,
     1535                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1536                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1537                                       mWaitFramTextEnd
     1538                                      )
     1539                           ).
     1540      end.
     1541      procedure WaitFramRunPause:
     1542         define input  parameter iInterval as dec no-undo.
     1543         define variable vStart  as datetime-tz no-undo.
     1544         define variable vend    as datetime-tz no-undo.
     1545         define variable vint as int64 no-undo.
     1546         define variable vOk as logical no-undo.
     1547         vStart = now.
     1548         vend   = vStart.
     1549         publish "WaitFramPause" (iInterval,output vOk).
     1550         vend   =  now.
     1551         vint = vend - vStart.
     1552         vint = iInterval - vint / 1000.
     1553         if     not mWaitFramStop
     1554            and (   vint > 0
     1555                 or (    not vOk
     1556                     and iInterval eq ?
     1557                     )
     1558                 )
     1559         then
     1560            run waitfram-show-this (iInterval).
     1561         vend   =  now.
     1562         vint = vend - vStart.
     1563         vint = iInterval - vint / 1000.
     1564         if     not mWaitFramStop
     1565            and vint > 0
     1566         then do:
     1567            run gbl/pause.p (vint * 1000).
     1568         end.
     1569         if iInterval ne ?
     1570         then
     1571            publish "WaitFramStop".
     1572         waitfram-check-timeout().
     1573      end.
     1574      procedure WaitFramWaitFor:
     1575         define input  parameter iInterval as dec no-undo.
     1576         assign
     1577            mWaitFramStartProc   = now
     1578            mWaitFramStopUser    = no
     1579            mWaitFramStopTimeOut = no
     1580         .
     1581         block-wait:
     1582         do while not mWaitFramStop:
     1583            run WaitFramRunPause (iInterval).
     1584            if  waitfram-check-timeout()
     1585            then do:
     1586               leave block-wait.
     1587            end.
     1588         end.
     1589         run waitfram-hide.
     1590      end.
     1591   procedure waitfram-join :
     1592     define input  parameter p-line-1  as character no-undo .
     1593     define input  parameter p-line-2  as character no-undo .
     1594     define input  parameter p-line-3  as character no-undo .
     1595     define output parameter p-message as character no-undo .
     1596     do
     1597     on error undo, return error return-value
     1598     :
     1599       assign
     1600         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1601                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1602                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1603       .
     1604     end.
     1605   end procedure.
     1606   function waitfram-join-function returns character
     1607     (input p-line-1 as character
     1608     ,input p-line-2 as character
     1609     ,input p-line-3 as character
     1610     ).
     1611     define variable v-message as character no-undo .
     1612     run waitfram-join in this-procedure
     1613       (input  p-line-1
     1614       ,input  p-line-2
     1615       ,input  p-line-3
     1616       ,output v-message
     1617       ) .
     1618     return v-message .
     1619   end function .
