     1791   procedure lhistprex-print-dc-list-hist-excel :
     1792   define input parameter p-text  as logical no-undo .
     1793   define input parameter p-excel as logical no-undo .
     1794   define input parameter p-sheet-num as integer no-undo .
     1795   define buffer buf_lh-sheetf for sheetf.
     1796   define buffer buf_dc-list-hist for dc-list-hist.
     1797     do
     1798     on error undo, return error
     1799     :
     1800       find first buf_dc-list-hist no-lock where buf_dc-list-hist.id = 0 no-error .
     1801       if p-excel then do:
     1802         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1803         FInd first buf_lh-Sheetf where
     1804                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1805         if not avail buf_lh-sheetf then
     1806         create buf_lh-sheetf.
     1807         assign
     1808         buf_lh-Sheetf.Sheet-num = 2
     1809         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1810         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1811         .
     1812         run rep/extitlee.p (input p-sheet-num
     1813                       , input  substitute("История создания списка &1 &2"
     1814                                   ,
     1815   'дисконтных карт'
     1816                                   ,(if available buf_dc-list-hist
     1817                                   then buf_dc-list-hist.des
     1818                                   else "БЕЗЫМЯННЫЙ"))
     1819                       ) .
     1820       end.
     1821       if p-text then do:
     1822         Page stream PrnLibStream.
     1823         PUT  STREAM PrnLibStream unformatted
     1824         SPACE(25) substitute("История создания списка &1 &2"
     1825                             , 'дисконтных карт'
     1826                             ,(if available buf_dc-list-hist
     1827                             then buf_dc-list-hist.des
     1828                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1829         space(25) cur-time-print() skip(1)
     1830         .
     1831         put stream PrnLibStream unformatted
     1832         string("№", "X(9)") chr(32)
     1833         string("Действие", "X(9)") chr(32)
     1834         string("записей", "X(9)") chr(32)
     1835         string(" = итого", "X(12)") chr(32)
     1836         (if page-size(PrnLibStream) > 43
     1837         then string("Множество", "X(" + string(136 - 43) + ")")
     1838         else string("Множество", "X(" + string(198 - 43) + ")")
     1839         )
     1840         skip(0)
     1841         fill('-':U, 9) chr(32)
     1842         fill('-':U, 9) chr(32)
     1843         fill('-':U, 9) chr(32)
     1844         fill('-':U, 12) chr(32)
     1845         (if page-size(PrnLibStream) > 43
     1846         then fill('-':U, 136 - 43)
     1847         else fill('-':U, 198 - 43))
     1848         skip(0)
     1849         .
     1850       end.
     1851       for each buf_dc-list-hist where buf_dc-list-hist.id > 0
     1852       by buf_dc-list-hist.id
     1853       :
     1854         if p-text then do:
     1855           put stream PrnLibStream unformatted
     1856           (if buf_dc-list-hist.line = 0
     1857           then string(buf_dc-list-hist.id, ">>>>>>>>9")
     1858           else fill(chr(32) , 9)
     1859           )  chr(32)
     1860           (if buf_dc-list-hist.item_ <> '':U
     1861           then string(buf_dc-list-hist.hist-mode, "X(8)")
     1862           else fill( chr(32), 8)) chr(32)
     1863           string(buf_dc-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1864           string(buf_dc-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1865           (if page-size(PrnLibStream) > 43
     1866           then string(buf_dc-list-hist.des, "X(" + string(136 - 43) + ")")
     1867           else string(buf_dc-list-hist.des, "X(" + string(198 - 43) + ")"))
     1868           skip.
     1869         end.
     1870         if p-excel then do:
     1871           if Make-Excel then  put   stream ForExcel unformatted
     1872           (if buf_dc-list-hist.line = 0
     1873           then string(buf_dc-list-hist.id, ">>>>>>>>9")
     1874           else '':U)
     1875           CHR(9)
     1876           (if buf_dc-list-hist.item_ <> '':U
     1877           then buf_dc-list-hist.hist-mode
     1878           else '':U)  CHR(9)
     1879           (if buf_dc-list-hist.item_ <> '':U
     1880           then string(buf_dc-list-hist.num-add, "->>>>>>>>9")
     1881           else '':U)  CHR(9)
     1882           (if buf_dc-list-hist.item_ <> '':U
     1883           then string(buf_dc-list-hist.num-recs, ">>>>>>>>9")
     1884           else '':U)  CHR(9)
     1885           buf_dc-list-hist.des
     1886           skip.
     1887         end.
     1888       end.
     1889     end.
     1890   end procedure.
