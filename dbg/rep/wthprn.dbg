     1224           and can-query(v-object-handle, "height")
     1225           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1226           then do:
     1227             find first buf_temp-browse-handle
     1228               where buf_temp-browse-handle.browse-type   = 'height':u
     1229                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1230               no-error .
     1231             if available buf_temp-browse-handle
     1232             then do:
     1233             end.
     1234             else do:
     1235               create buf_temp-diasize-handle .
     1236               assign
     1237                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1238                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1239               .
     1240             end.
     1241           end.
