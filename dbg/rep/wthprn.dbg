     2442   PROCEDURE disable_UI :
     2443     HIDE FRAME Dialog-Frame.
     2444   END PROCEDURE.
     2445   PROCEDURE enable_UI :
     2446     DISPLAY fi-default-printer
     2447         WITH FRAME Dialog-Frame.
     2448     ENABLE b-exit b-chg b-print b-help br-table fi-default-printer
     2449         WITH FRAME Dialog-Frame.
     2450     VIEW FRAME Dialog-Frame.
     2451     run local-open-query in this-procedure .
     2452   END PROCEDURE.
     2453   PROCEDURE get-call-point :
     2454   define input parameter p-tmp#list-id as integer          no-undo.
     2455   define output parameter p-call-point as character        no-undo.
     2456       define variable v-doc-type        as character    no-undo.
     2457       define variable v-doc-status      as character    no-undo.
     2458       define variable v-doc-internal    as character    no-undo.
     2459       define variable v-doc-flag        as character    no-undo.
     2460       define buffer buf_temp_form-list        for temp_form-list.
     2461   do
     2462   for buf_temp_form-list
     2463   on error undo, return error
     2464   :
     2465       assign
     2466           v-doc-type     = "":U
     2467           v-doc-status   = "":U
     2468           v-doc-internal = "":U
     2469           v-doc-flag     = "":U
     2470       .
     2471       for each buf_temp_form-list
     2472          where buf_temp_form-list.id = Tmp#List.id
     2473       :
     2474           if lookup( buf_temp_form-list.doc-type, v-doc-type ) = 0
     2475           then do:
     2476               assign
     2477                   v-doc-type = ( if v-doc-type = "":U then "":U else "_":U ) + buf_temp_form-list.doc-type
     2478               .
     2479           end.
     2480           if lookup( buf_temp_form-list.status_, v-doc-status ) = 0
     2481           then do:
     2482               assign
     2483                   v-doc-status = ( if v-doc-status = "":U then "":U else "_":U ) + buf_temp_form-list.status_
     2484               .
     2485           end.
     2486           if lookup( buf_temp_form-list.internal, v-doc-internal ) = 0
     2487           then do:
     2488               assign
     2489                   v-doc-internal = ( if v-doc-internal = "":U then "":U else "_":U ) + buf_temp_form-list.internal
     2490               .
     2491           end.
     2492           if lookup( buf_temp_form-list.flag, v-doc-flag ) = 0
     2493           then do:
     2494               assign
     2495                   v-doc-flag = ( if v-doc-flag = "":U then "":U else "_":U ) + buf_temp_form-list.flag
     2496               .
     2497           end.
     2498       end.
     2499       assign
     2500           p-call-point = substitute( "&1,&2,&3,&4", v-doc-type, v-doc-status, v-doc-internal, v-doc-flag )
     2501       .
     2502   end.
     2503   END PROCEDURE.
     2504   PROCEDURE get-saved-character :
     2505   define input parameter p-list           as character        no-undo.
     2506   define input parameter p-name           as character        no-undo.
     2507   define output parameter p-character     as character        no-undo.
     2508       define variable v-position    as integer      no-undo.
     2509   do
     2510   on error undo, return error
     2511   :
     2512       assign
     2513           v-position = lookup( p-name, p-list )
     2514       .
     2515       if v-position = 0
     2516       then do:
     2517           assign
     2518               p-character = "":U
     2519           .
     2520       end.
     2521       else do:
     2522           if num-entries( p-list ) > v-position
     2523           then do:
     2524               assign
     2525                   p-character = entry( v-position + 1, p-list )
     2526               .
     2527           end.
     2528           else do:
     2529               assign
     2530                   p-character = "":U
     2531               .
     2532           end.
     2533       end.
     2534   end.
     2535   END PROCEDURE.
     2536   PROCEDURE get-saved-logical :
     2537   define input parameter p-list       as character        no-undo.
     2538   define input parameter p-name       as character        no-undo.
     2539   define output parameter p-logical   as character        no-undo.
     2540       define variable v-position    as integer      no-undo.
     2541   do
     2542   on error undo, return error
     2543   :
     2544       assign
     2545           v-position = lookup( p-name, p-list )
     2546       .
     2547       if v-position = 0
     2548       then do:
     2549           assign
     2550               p-logical = "  -":U
     2551           .
     2552       end.
     2553       else do:
     2554           if num-entries( p-list ) > v-position
     2555           then do:
     2556               assign
     2557                   p-logical = "  ":U + entry( v-position + 1, p-list )
     2558               .
     2559               if trim( p-logical ) = "":U
     2560               then do:
     2561                   assign
     2562                       p-logical = "  -":U
     2563                   .
     2564               end.
     2565           end.
     2566           else do:
     2567               assign
     2568                   p-logical = "  -":U
     2569               .
     2570           end.
     2571       end.
     2572   end.
     2573   END PROCEDURE.
     2574   PROCEDURE init-fields :
     2575   define variable xtype        as character    no-undo.
     2576   define variable xstatus      as character    no-undo.
     2577   define variable xInternal    as character    no-undo.
     2578   define variable xflag        as character    no-undo.
     2579       define variable v-temp-char     as character    no-undo.
     2580       define variable v-call-point    as character    no-undo.
     2581       define variable v-doc-counter   as integer      no-undo.
     2582       define variable v-form-title    as character    no-undo.
     2583       define buffer buf_wth-doc           for ub.wth-doc.
     2584       define buffer buf_usr-flt           for ubflt.usr-flt.
     2585   do
     2586   for buf_wth-doc
     2587     , buf_usr-flt
     2588   with frame Dialog-Frame
     2589   on error undo, return error
     2590   :
     2591       assign
     2592           fi-default-printer = session :printer-name
     2593       .
     2594   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2595   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2596     (output v-menu-doc-sys-key
     2597     ) no-error .
     2598       for each temp_wth-doc-code
     2599       on error undo, return error
     2600       :
     2601           assign
     2602               v-doc-counter = v-doc-counter + 1
     2603           .
     2604           find first buf_wth-doc no-lock
     2605                where buf_wth-doc.doc-code = temp_wth-doc-code.doc-code
     2606           .
     2607           run create-menu-items in this-procedure (
     2608                 input buf_wth-doc.doc-code
     2609               , input buf_wth-doc.doc-type
     2610               , input buf_wth-doc.ext-doc-type
     2611               , input buf_wth-doc.status_
     2612               , input substitute( "&1,&2", buf_wth-doc.exter_, buf_wth-doc.inter_ )
     2613               , input buf_wth-doc.ext-doc-type
     2614           ).
     2615       end.
     2616       if v-doc-counter = 1
     2617       then do:
     2618           assign
     2619               v-form-title = substitute( "Печать документа   Тип: &1 Статус: &2&3 &4   № &5"
     2620                   , v-menu-doc-doc-type
     2621                   , v-menu-doc-status_
     2622                   , string( v-menu-doc-flag, "+/-" )
     2623                   , string( v-menu-doc-internal,"внутренний/внешний")
     2624                   , v-menu-doc-doc-code )
     2625           .
     2626       end.
     2627       else do:
     2628           assign
     2629               v-form-title = substitute( "Печать выбранных документов по списку" )
     2630           .
     2631       end.
     2632       assign
     2633           frame Dialog-Frame :title = v-form-title
     2634       .
     2635       for each Tmp#List
     2636       :
     2637           run get-call-point in this-procedure (
     2638                 input Tmp#List.id
     2639               , output v-call-point
     2640           ).
     2641           find first buf_usr-flt no-lock
     2642                where buf_usr-flt.user-name  = v-cntxt-userid
     2643                  and buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     2644                                               , Tmp#List.blank-name
     2645                                               , Tmp#List.sys-key
     2646                                               , Tmp#List.sys-key-black
     2647                                               , v-call-point )
     2648           no-error.
     2649           if available buf_usr-flt
     2650           then do:
     2651               run get-saved-logical in this-procedure (
     2652                     input buf_usr-flt.list_
     2653                   , input "type-price":U
     2654                   , output Tmp#List.type-price
     2655               ).
     2656               run get-saved-logical in this-procedure (
     2657                     input buf_usr-flt.list_
     2658                   , input "type-val":U
     2659                   , output Tmp#List.type-val
     2660               ).
     2661               run get-saved-logical in this-procedure (
     2662                     input buf_usr-flt.list_
     2663                   , input "sort-gr":U
     2664                   , output Tmp#List.sort-gr
     2665               ).
     2666               run get-saved-logical in this-procedure (
     2667                     input buf_usr-flt.list_
     2668                   , input "print-graft":U
     2669                   , output Tmp#List.print-graft
     2670               ).
     2671               run get-saved-logical in this-procedure (
     2672                     input buf_usr-flt.list_
     2673                   , input "type-scale":U
     2674                   , output Tmp#List.type-scale
     2675               ).
     2676               run get-saved-logical in this-procedure (
     2677                     input buf_usr-flt.list_
     2678                   , input "sort-name":U
     2679                   , output Tmp#List.sort-name
     2680               ).
     2681               assign
     2682                   v-temp-char = "":U
     2683               .
     2684               run get-saved-logical in this-procedure (
     2685                     input buf_usr-flt.list_
     2686                   , input "selection":U
     2687                   , output v-temp-char
     2688               ).
     2689               if v-temp-char = "  +":U
     2690               then do:
     2691                   assign
     2692                       Tmp#List.last-use = yes
     2693                   .
     2694               end.
     2695           end.
     2696           else do:
     2697               assign
     2698                   Tmp#List.type-price   = "  -":U
     2699                   Tmp#List.type-val     = "  -":U
     2700                   Tmp#List.sort-gr      = "  -":U
     2701                   Tmp#List.sort-name    = "  -":U
     2702                   Tmp#List.print-graft  = "  -":U
     2703                   Tmp#List.type-scale   = "  -":U
     2704               .
     2705           end.
     2706           if Tmp#List.type-price-enabled = no
     2707           then do:
     2708               assign
     2709                   Tmp#List.type-price   = " ":U
     2710               .
     2711           end.
     2712           if Tmp#List.type-val-enabled = no
     2713           then do:
     2714               assign
     2715                   Tmp#List.type-val     = " ":U
     2716               .
     2717           end.
     2718           if Tmp#List.sort-gr-enabled = no
     2719           then do:
     2720               assign
     2721                   Tmp#List.sort-gr      = " ":U
     2722               .
     2723           end.
     2724           if Tmp#List.sort-name-enabled = no
     2725           then do:
     2726               assign
     2727                   Tmp#List.sort-name    = " ":U
     2728               .
     2729           end.
     2730           if Tmp#List.print-graft-enabled = no
     2731           then do:
     2732               assign
     2733                   Tmp#List.print-graft  = " ":U
     2734               .
     2735           end.
     2736           if Tmp#List.type-scale-enabled = no
     2737           then do:
     2738               assign
     2739                   Tmp#List.type-scale   = " ":U
     2740               .
     2741           end.
     2742       end.
     2743   end.
     2744   END PROCEDURE.
     2745   PROCEDURE local-open-query :
     2746           open query br-table
     2747           for each Tmp#List no-lock
     2748              where Tmp#List.view_ <> 0
     2749           by Tmp#List.id
     2750           .
     2751    END PROCEDURE.
     2752   PROCEDURE print-docs :
     2753       define variable v-doc-type          as character    no-undo.
     2754       define variable v-status            as character    no-undo.
     2755       define variable v-internal          as character    no-undo.
     2756       define variable v-flag              as character    no-undo.
     2757       define variable v-form-amount       as integer      no-undo.
     2758       define variable v-user-action       as character    no-undo.
     2759       define variable v-printed           as logical      no-undo.
     2760       define buffer buf_wth-doc       for ub.wth-doc.
     2761       define buffer buf_t_tmp#list    for tmp#list.
     2762       define buffer buf_tmp#list      for tmp#list.
     2763   do
     2764   for buf_wth-doc
     2765     , buf_t_tmp#list
     2766     , buf_tmp#list
     2767   with frame Dialog-Frame
     2768   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2769   :
     2770       if g#quest-print = yes
     2771       then do:
     2772           output  to value( string( session:temp-directory + "$" + string( g#report-num ) ) ) .
     2773           output close.
     2774       End.
     2775       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     2776       output close.
     2777       output to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".txl" ) .
     2778       output close.
     2779       for each temp_form-list
     2780       by temp_form-list.doc-code
     2781       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2782       :
     2783           for each buf_tmp#list
     2784              where buf_tmp#list.id = temp_form-list.id
     2785           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2786           :
     2787               if buf_tmp#list.last-use <> no
     2788               then do:
     2789                   find first buf_t_tmp#list no-lock
     2790                        where buf_t_tmp#list.id = temp_form-list.id
     2791                   .
     2792                   assign
     2793                       v-form-amount = v-form-amount + 1
     2794                   .
     2795                   find first buf_wth-doc
     2796                        where buf_wth-doc.doc-code = temp_form-list.doc-code
     2797                   no-lock.
     2798                   assign
     2799                       v-doc-type = buf_wth-doc.doc-type
     2800                       v-status   = string( buf_wth-doc.status_  )
     2801                       v-internal = substitute( "&1,&2", buf_wth-doc.exter_, buf_wth-doc.inter_ )
     2802                       v-flag     = string( buf_wth-doc.ext-doc-type    )
     2803                   .
     2804                   assign
     2805                       print-graft = ( trim( buf_tmp#list.print-graft ) = "+":U )
     2806                       sort-gr     = ( trim( buf_tmp#list.sort-gr     ) = "+":U )
     2807                       sort-name   = ( trim( buf_tmp#list.sort-name   ) = "+":U )
     2808                       CostPrice   = ( trim( buf_tmp#list.type-price  ) <> "+":U )
     2809                       PrintScale  = ( trim( buf_tmp#list.type-scale  ) = "+":U )
     2810                       PrintRubl   = ( trim( buf_tmp#list.type-val    ) = "+":U )
     2811                   .
     2812                   case num-entries( buf_tmp#list.proc-param )
     2813                   :
     2814                       when 0
     2815                       then do:
     2816                           run value ( buf_tmp#list.proc-name )  (
     2817                                 input p-mainmenu-handle
     2818                               , input buf_wth-doc.doc-code
     2819                           ).
     2820                       end.
     2821                       when 1
     2822                       then do:
     2823                           run value ( buf_tmp#list.proc-name ) (
     2824                                 input p-mainmenu-handle
     2825                               , input buf_wth-doc.doc-code
     2826                               , input buf_tmp#list.proc-param
     2827                           ).
     2828                       end.
     2829                       when 2
     2830                       then do:
     2831                           run value ( buf_tmp#list.proc-name )  (
     2832                                 input p-mainmenu-handle
     2833                               , input buf_wth-doc.doc-code
     2834                               , input entry( 1, buf_tmp#list.proc-param )
     2835                               , input entry( 2, buf_tmp#list.proc-param )
     2836                           ).
     2837                       end.
     2838                       when 3
     2839                       then do:
     2840                           run value ( buf_tmp#list.proc-name )  (
     2841                                 input p-mainmenu-handle
     2842                               , input buf_wth-doc.doc-code
     2843                               , input entry( 1, buf_tmp#list.proc-param )
     2844                               , input entry( 2, buf_tmp#list.proc-param )
     2845                               , input entry( 3, buf_tmp#list.proc-param )
     2846                           ).
     2847                       end.
     2848                       when 4
     2849                       then do:
     2850                           run value ( buf_tmp#list.proc-name )  (
     2851                                 input p-mainmenu-handle
     2852                               , input buf_wth-doc.doc-code
     2853                               , input entry( 1, buf_tmp#list.proc-param )
     2854                               , input entry( 2, buf_tmp#list.proc-param )
     2855                               , input entry( 3, buf_tmp#list.proc-param )
     2856                               , input entry( 4, buf_tmp#list.proc-param )
     2857                           ).
     2858                       end.
     2859                       when 5
     2860                       then do:
     2861                           run value ( buf_tmp#list.proc-name )  (
     2862                                 input p-mainmenu-handle
     2863                               , input buf_wth-doc.doc-code
     2864                               , input entry( 1, buf_tmp#list.proc-param )
     2865                               , input entry( 2, buf_tmp#list.proc-param )
     2866                               , input entry( 3, buf_tmp#list.proc-param )
     2867                               , input entry( 4, buf_tmp#list.proc-param )
     2868                               , input entry( 5, buf_tmp#list.proc-param )
     2869                           ).
     2870                       end.
     2871                       when 6
     2872                       then do:
     2873                           run value ( buf_tmp#list.proc-name )  (
     2874                                 input p-mainmenu-handle
     2875                               , input buf_wth-doc.doc-code
     2876                               , input entry( 1, buf_tmp#list.proc-param )
     2877                               , input entry( 2, buf_tmp#list.proc-param )
     2878                               , input entry( 3, buf_tmp#list.proc-param )
     2879                               , input entry( 4, buf_tmp#list.proc-param )
     2880                               , input entry( 5, buf_tmp#list.proc-param )
     2881                               , input entry( 6, buf_tmp#list.proc-param )
     2882                           ).
     2883                       end.
     2884                   end case.
     2885               end.
     2886           end.
     2887       end.
     2888       if g#quest-print = yes
     2889       Then do:
     2890           os-delete
     2891               value( string( session:temp-directory ) + "rpt" + string( g#report-num ) )
     2892           .
     2893           os-rename
     2894               value(  string( session:temp-directory ) + "$" + string( g#report-num ) )
     2895               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) )
     2896           .
     2897           os-delete
     2898               value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2899           .
     2900           os-rename
     2901               value(  string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     2902               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2903           .
     2904           if v-form-amount = 1
     2905           and ((can-find (first buf_tmp#list where CAPS(buf_tmp#list.proc-name) = "XL-PRTCL.P":U and buf_tmp#list.last-use = yes) = yes  )
     2906           or (can-find (first buf_tmp#list where CAPS(buf_tmp#list.proc-name) = "TICK-DOC.P":U and buf_tmp#list.last-use = yes) = yes  ))
     2907           then do:
     2908   if session :set-wait-state( "" ) then.
     2909           end.
     2910           else do
     2911           :
     2912               find first buf_tmp#list
     2913                    where buf_tmp#list.last-use = yes
     2914               no-error.
     2915               if available buf_tmp#list
     2916               then do:
     2917                   case buf_tmp#list.orient-orientation
     2918                   :
     2919                       when "A4port":U
     2920                       then do:
     2921                           run gbl/prnfilen.w (
     2922                                 input "":U
     2923                               , input 0
     2924                               , input string( session :temp-directory )
     2925                                           + "rpt"
     2926                                           + string( g#report-num )
     2927                               , input buf_tmp#list.orient-font-num
     2928                               , output v-user-action
     2929                               , output v-printed
     2930                           ) .
     2931                       end.
     2932                       when "A4lans":U
     2933                       or when ""
     2934                       then do:
     2935                           run gbl/prnfilen.w (
     2936                                 input "":U
     2937                               , input 8
     2938                               , input string( session :temp-directory )
     2939                                           + "rpt"
     2940                                           + string( g#report-num )
     2941                               , input buf_tmp#list.orient-font-num
     2942                               , output v-user-action
     2943                               , output v-printed
     2944                           ) .
     2945                       end.
     2946                   end case.
     2947               end.
     2948           end.
     2949       end.
     2950       else do:
     2951           Message 'Задание распечатано'.
     2952       end.
     2953   end.
     2954   END PROCEDURE.
     2955   PROCEDURE reposition-browse :
     2956   do
     2957   with frame Dialog-Frame
     2958   on error undo, return error
     2959   :
     2960       define variable v-focused-row    as integer      no-undo.
     2961       assign
     2962           v-focused-row     = br-table :focused-row in frame Dialog-Frame.
     2963       .
     2964       get next br-table.
     2965       if available tmp#list
     2966       then do:
     2967           if v-focused-row >= br-table :height-chars - 4
     2968           then do:
     2969               br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     2970           end.
     2971           else do:
     2972               br-table :set-repositioned-row( v-focused-row + 1, "ALWAYS" ) in frame Dialog-Frame.
     2973           end.
     2974           reposition br-table to rowid rowid( tmp#list ) no-error.
     2975       end.
     2976       else do:
     2977           get last br-table.
     2978       end.
     2979   end.
     2980   END PROCEDURE.
     2981   PROCEDURE reposition-to-recid :
     2982   define input parameter p-ext-system-recid  as recid        no-undo.
     2983   do
     2984   on error undo, return error
     2985   :
     2986       if p-ext-system-recid <> ?
     2987       then do:
     2988           reposition br-table to recid p-ext-system-recid no-error .
     2989       end.
     2990       do with frame Dialog-Frame
     2991       :
     2992           apply "entry":u to browse br-table .
     2993       end.
     2994   end.
     2995   END PROCEDURE.
     2996   PROCEDURE save-form-parameters :
     2997       define variable v-call-point    as character    no-undo.
     2998       define buffer buf_tmp#list          for tmp#list.
     2999       define buffer buf_usr-flt           for ubflt.usr-flt.
     3000       define buffer buf_temp_form-list    for temp_form-list.
     3001   do
     3002   for buf_tmp#list
     3003     , buf_usr-flt
     3004     , buf_temp_form-list
     3005   on error undo, return error
     3006   :
     3007       for each buf_tmp#list
     3008       :
     3009           run get-call-point in this-procedure (
     3010                 input buf_tmp#list.id
     3011               , output v-call-point
     3012           ).
     3013           find first buf_usr-flt exclusive-lock
     3014                where buf_usr-flt.user-name  = v-cntxt-userid
     3015                  and buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     3016                                               , buf_tmp#list.blank-name
     3017                                               , buf_tmp#list.sys-key
     3018                                               , buf_tmp#list.sys-key-black
     3019                                               , v-call-point )
     3020           no-error.
     3021           if not available buf_usr-flt
     3022           then do:
     3023               create buf_usr-flt.
     3024               assign
     3025                   buf_usr-flt.user-name  = v-cntxt-userid
     3026                   buf_usr-flt.call-point = substitute( "&1,&2,&3,&4"
     3027                                               , buf_tmp#list.blank-name
     3028                                               , buf_tmp#list.sys-key
     3029                                               , buf_tmp#list.sys-key-black
     3030                                               , v-call-point )
     3031               .
     3032           end.
     3033           assign
     3034               buf_usr-flt.list_ = substitute( "selection,&1,type-price,&2,type-scale,&3,type-val,&4,sort-name,&5,sort-gr,&6,print-graft,&7":U
     3035                                       , ( if buf_tmp#list.last-use = yes then "+":U else "-":U )
     3036                                       , ( if index( buf_tmp#list.type-price , "+":U ) <> 0 then "+":U else "-":U )
     3037                                       , ( if index( buf_tmp#list.type-scale , "+":U ) <> 0 then "+":U else "-":U )
     3038                                       , ( if index( buf_tmp#list.type-val   , "+":U ) <> 0 then "+":U else "-":U )
     3039                                       , ( if index( buf_tmp#list.sort-name  , "+":U ) <> 0 then "+":U else "-":U )
     3040                                       , ( if index( buf_tmp#list.sort-gr    , "+":U ) <> 0 then "+":U else "-":U )
     3041                                       , ( if index( buf_tmp#list.print-graft, "+":U ) <> 0 then "+":U else "-":U )
     3042                                       )
     3043           .
     3044       end.
     3045   end.
     3046   END PROCEDURE.
     3047   PROCEDURE select-or-deselect-item :
     3048   define input  parameter p-id as integer    no-undo.
     3049       define buffer buf_tmp#list for tmp#list.
     3050   do
     3051   for buf_tmp#list
     3052   on error undo, return error
     3053   :
     3054       find first buf_tmp#list
     3055            where buf_tmp#list.id = p-id
     3056       .
     3057       if buf_tmp#list.last-use = yes
     3058       then do:
     3059           assign
     3060               buf_tmp#list.last-use = no
     3061           .
     3062       end.
     3063       else do:
     3064           assign
     3065               buf_tmp#list.last-use = yes
     3066           .
     3067       end.
     3068   end.
     3069   END PROCEDURE.
     3070   PROCEDURE test-temp-tables :
     3071       define buffer buf_t_tmp#list      for tmp#list.
     3072   do
     3073   for buf_t_tmp#list
     3074   on error undo, return error
     3075   :
     3076       for each temp_form-list no-lock
     3077       on error undo, return error
     3078       :
     3079           find first buf_t_tmp#list no-lock
     3080                where buf_t_tmp#list.id = temp_form-list.id
     3081           .
     3082           put unformatted
     3083               skip substitute( "&1 &2 &3 &4 &5 &6 &7 &8", temp_form-list.doc-code, temp_form-list.doc-type, temp_form-list.status_, temp_form-list.internal, temp_form-list.flag, temp_form-list.id, buf_t_tmp#list.blank-name, buf_t_tmp#list.last-use )
     3084           .
     3085       end.
     3086       for each temp_menu-doc_disabled-doc-list no-lock
     3087       on error undo, return error
     3088       :
     3089           put unformatted
     3090               skip substitute( "&1 &2 &3", temp_menu-doc_disabled-doc-list.doc-code, temp_menu-doc_disabled-doc-list.blank-name, temp_menu-doc_disabled-doc-list.reason )
     3091           .
     3092       end.
     3093   end.
     3094   END PROCEDURE.
     3095   PROCEDURE ui-disable-all :
     3096   do
     3097   on error undo, return error
     3098   :
     3099   end.
     3100   END PROCEDURE.
     3101   PROCEDURE ui-enable :
     3102       define buffer buf_clients       for ub.clients.
     3103   do
     3104   for buf_clients
     3105   on error undo, return error
     3106   :
     3107       enable
     3108           b-sel
     3109           b-deselect
     3110       with frame Dialog-Frame .
     3111   end.
     3112   END PROCEDURE.
