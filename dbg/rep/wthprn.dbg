     1663         then do:
     1664           undo move_block, retry move_block.
     1665         end.
     1666         assign
     1667           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1668         no-error .
     1669         if error-status :error
     1670         or error-status :get-message(1) <> ""
     1671         then do:
     1672           undo move_block, retry move_block.
     1673         end.
     1674         for each buf_temp-browse-handle
     1675           where buf_temp-browse-handle.browse-type = 'width':u
     1676         on error undo move_block, retry move_block
     1677         :
     1678           assign
     1679             buf_temp-browse-handle.browse-handle :width
     1680               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1681             no-error .
     1682           if error-status :error
     1683           or error-status :get-message(1) <> ""
     1684           then do:
     1685             undo move_block, retry move_block .
     1686           end.
     1687         end.
     1688         for each buf_temp-diasize-handle
     1689         on error undo move_block, retry move_block
     1690         :
     1691           assign
     1692             v-object-handle = buf_temp-diasize-handle.handle-value
     1693           .
     1694           if v-object-handle <> v-diasize-resize-button
     1695           then do:
     1696             assign
     1697               v-object-handle :col = v-object-handle :col + p-change-value
     1698               no-error .
     1699             if error-status :error
     1700             or error-status :get-message(1) <> ""
     1701             then do:
     1702               undo move_block, retry move_block .
     1703             end.
     1704           end.
     1705         end.
     1706       end.
     1707       else do:
     1708         for each buf_temp-diasize-handle
     1709         on error undo move_block, retry move_block
     1710         :
     1711           assign
     1712             v-object-handle = buf_temp-diasize-handle.handle-value
     1713           .
     1714           if v-object-handle <> v-diasize-resize-button
     1715           then do:
     1716             assign
     1717               v-object-handle :col = v-object-handle :col + p-change-value
     1718               no-error .
     1719             if error-status :error
     1720             or error-status :get-message(1) <> ""
     1721             then do:
     1722               undo move_block, retry move_block .
     1723             end.
     1724           end.
     1725         end.
     1726         for each buf_temp-browse-handle
     1727           where buf_temp-browse-handle.browse-type = 'width':u
     1728         on error undo move_block, retry move_block
     1729         :
     1730           assign
     1731             buf_temp-browse-handle.browse-handle :width
     1732               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1733             no-error .
     1734           if error-status :error
     1735           or error-status :get-message(1) <> ""
     1736           then do:
     1737             undo move_block, retry move_block .
     1738           end.
     1739         end.
     1740         assign
     1741           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1742           no-error .
     1743         if error-status :error
     1744         or error-status :get-message(1) <> ""
     1745         then do:
     1746           undo move_block, retry move_block.
     1747         end.
     1748         assign
     1749           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1750         no-error .
     1751         if error-status :error
     1752         or error-status :get-message(1) <> ""
     1753         then do:
     1754           undo move_block, retry move_block.
     1755         end.
     1756         if frame Dialog-Frame :scrollable = true
     1757         then do:
     1758           assign
     1759             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1760           no-error .
     1761           if error-status :error
     1762           or error-status :get-message(1) <> ""
     1763           then do:
     1764             undo move_block, retry move_block.
     1765           end.
     1766         end.
     1767       end.
     1768       if p-move-resize
     1769       then do:
     1770         run diasize_position-resize-button in this-procedure .
     1771       end.
     1772       if v-diasize-wndstore = true
     1773       then do:
     1774         if connected("ub") = true
     1775         then do:
     1776           define variable v-cntxt-db-num        as integer   no-undo .
     1777           define variable v-cntxt-userid        as character no-undo .
     1778           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1779                                             , OUTPUT v-cntxt-userid
     1780                                             ) .
     1781           run gbl/wndsizew.p
     1782             (input  v-cntxt-db-num
     1783             ,input  v-cntxt-userid
     1784             ,input  v-diasize-proc-name
     1785             ,input  'width':u
     1786             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1787             ) .
     1788         end.
     1789       end.
     1790     end.
     1791     assign
     1792       v-diasize-change-size = false
     1793     .
     1794   end procedure.
     1795   procedure diasize_set-width :
     1796     define input  parameter p-new-width  as decimal   no-undo .
     1797     define input  parameter p-move-resize as logical   no-undo .
     1798     do
     1799     on error undo, return error return-value
     1800     :
     1801       run diasize_change-width in this-procedure
     1802         (input  (p-new-width - frame Dialog-Frame :width)
     1803         ,input  p-move-resize
     1804         ) .
     1805     end.
     1806   end procedure.
     1807   procedure diasize_position-resize-button :
     1808     do with frame Dialog-Frame
     1809     :
     1810       hide v-diasize-resize-button .
     1811       assign
     1812         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1813                     - 1
     1814                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1815         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1816                     - 1
     1817                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1818       .
     1819       view v-diasize-resize-button .
     1820     end.
     1821   end procedure.
     1822   on alt-right anywhere
     1823   do:
     1824     run diasize_change-width in this-procedure
     1825       (input 1
     1826       ,input true
     1827       ) .
     1828     return no-apply .
     1829   end.
     1830   on alt-left anywhere
     1831   do:
     1832     run diasize_change-width in this-procedure
     1833       (input -1
     1834       ,input true
     1835       ) .
     1836     return no-apply .
     1837   end.
     1838   on alt-down anywhere
     1839   do:
     1840     run diasize_change-height in this-procedure
     1841       (input 1
     1842       ,input true
     1843       ) .
     1844     return no-apply .
     1845   end.
     1846   on alt-up anywhere
     1847   do:
     1848     run diasize_change-height in this-procedure
     1849       (input -1
     1850       ,input true
     1851       ) .
     1852     return no-apply .
     1853   end.
     1854   on alt-enter of frame Dialog-Frame
     1855   do:
     1856     run diasize_maximize in this-procedure
     1857       (input  ?
     1858       ).
     1859     return no-apply .
     1860   end.
     1861   procedure diasize_end-move :
     1862     do
     1863     on error undo, return error return-value
     1864     :
     1865       define variable v-row-delta as decimal   no-undo .
     1866       define variable v-col-delta as decimal   no-undo .
     1867       define variable v-new-row as decimal   no-undo .
     1868       define variable v-new-col as decimal   no-undo .
     1869       assign
     1870         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1871         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1872       .
     1873       assign
     1874         v-row-delta = v-new-row - frame Dialog-Frame :height
     1875         v-col-delta = v-new-col - frame Dialog-Frame :width
     1876       .
     1877       run diasize_change-height in this-procedure
     1878         (input v-row-delta
     1879         ,input true
     1880         ) .
     1881       run diasize_change-width in this-procedure
     1882         (input v-col-delta
     1883         ,input true
     1884         ) .
     1885     end.
     1886   end procedure.
     1887   procedure diasize_maximize :
     1888     define input  parameter p-action as logical   no-undo .
     1889     do
     1890     on error undo, return error return-value
     1891     :
     1892       if p-action = ?
     1893       then do:
     1894         if v-diasize-need-maximize = true
     1895         then do:
     1896           assign
     1897             p-action = true
     1898           .
     1899         end.
     1900         else do:
     1901           assign
     1902             p-action = false
     1903           .
     1904         end.
     1905       end.
     1906       if p-action = true
     1907       then do:
     1908         run diasize_change-height in this-procedure
     1909           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1910               - frame Dialog-Frame :height-chars
     1911           ,input true
     1912           ) .
     1913         run diasize_change-width in this-procedure
     1914           (input session :width-chars
     1915               - frame Dialog-Frame :width-chars
     1916           ,input true
     1917           ) .
     1918         assign
     1919           v-diasize-need-maximize = false
     1920         .
     1921       end.
     1922       else do:
     1923         run diasize_change-width in this-procedure
     1924           (input v-diasize-orig-frame-width
     1925               - frame Dialog-Frame :width-chars
     1926           ,input true
     1927           ) .
     1928         run diasize_change-height in this-procedure
     1929           (input v-diasize-orig-frame-height
     1930               - frame Dialog-Frame :height-chars
     1931           ,input true
     1932           ) .
     1933         assign
     1934           v-diasize-need-maximize = true
     1935         .
     1936       end.
     1937     end.
     1938   end procedure.
     1939   procedure diasize_restore-orig-size :
     1940     do
     1941     on error undo, return error return-value
     1942     :
     1943       assign
     1944         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1945         v-diasize-current-frame-height = frame Dialog-Frame :height
     1946       .
     1947       run diasize_set-height in this-procedure
     1948         (input  v-diasize-orig-frame-height
     1949         ,input  true
     1950         ) .
     1951       run diasize_set-width in this-procedure
     1952         (input  v-diasize-orig-frame-width
     1953         ,input  true
     1954         ) .
     1955     end.
     1956   end procedure.
     1957   procedure diasize_restore-current-size :
     1958     do
     1959     on error undo, return error return-value
     1960     :
     1961       run diasize_set-height in this-procedure
     1962         (input  v-diasize-current-frame-height
     1963         ,input  true
     1964         ) .
     1965       run diasize_set-width in this-procedure
     1966         (input  v-diasize-current-frame-width
     1967         ,input  true
     1968         ) .
     1969     end.
     1970   end procedure.
     1971   procedure diasize_set-browse-handle :
     1972     define input  parameter p-browse-handle as handle   no-undo .
     1973     define buffer buf_temp-browse-handle for temp-browse-handle .
     1974     do
     1975     on error undo, return error return-value
     1976     :
     1977       assign
     1978         v-diasize-browse-handle = p-browse-handle
     1979       .
     1980       for each buf_temp-browse-handle
     1981       on error undo, return error return-value
     1982       :
     1983         delete buf_temp-browse-handle .
     1984       end.
     1985     end.
     1986   end procedure.
     1987   procedure diasize_add_browse :
     1988     define input  parameter p-browse-type   as character no-undo .
     1989     define input  parameter p-browse-handle as handle    no-undo .
     1990     define buffer buf_temp-browse-handle for temp-browse-handle .
     1991     do
     1992     on error undo, return error return-value
     1993     :
     1994       assign
     1995         v-diasize-browse-number = v-diasize-browse-number + 1
     1996       .
     1997       create buf_temp-browse-handle .
     1998       assign
     1999         buf_temp-browse-handle.browse-type   = p-browse-type
     2000         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2001         buf_temp-browse-handle.browse-handle = p-browse-handle
     2002       .
     2003     end.
     2004   end procedure.
     2005   procedure diasize_init :
     2006     define variable v-default-value    as logical   no-undo .
     2007     define variable v-restore-saved    as logical   no-undo .
     2008     define variable v-resize-value-str as character no-undo .
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       do with frame Dialog-Frame
     2013       :
     2014         assign
     2015           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2016           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2017           v-diasize-browse-handle     = browse br-table :handle
     2018         .
     2019         create button v-diasize-resize-button
     2020         assign
     2021           parent        = frame Dialog-Frame :first-child
     2022           label         = "s"
     2023           height-pixels = 16
     2024           width-pixels  = 16
     2025           visible       = true
     2026           sensitive     = true
     2027           movable       = true
     2028           triggers:
     2029             on end-move persistent run diasize_end-move in this-procedure .
     2030           end triggers.
     2031         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2032         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2033         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2034         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2035         assign
     2036           v-diasize-wndmax = false
     2037         .
     2038         if connected("ub") = true
     2039         then do:
     2040           define variable v-cntxt-db-num        as integer   no-undo .
     2041           define variable v-cntxt-userid        as character no-undo .
     2042           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2043                                             , OUTPUT v-cntxt-userid
     2044                                             ) .
     2045           run gbl/wndpar_r.p
     2046             (input  v-cntxt-db-num
     2047             ,input  v-cntxt-userid
     2048             ,input  'wndmax':U
     2049             ,output v-diasize-wndmax
     2050             ,output v-default-value
     2051             ) .
     2052         end.
     2053         assign
     2054           v-diasize-wndstore = false
     2055         .
     2056         if connected("ub") = true
     2057         then do:
     2058           run gbl/wndpar_r.p
     2059             (input  v-cntxt-db-num
     2060             ,input  v-cntxt-userid
     2061             ,input  'wndstore':U
     2062             ,output v-diasize-wndstore
     2063             ,output v-default-value
     2064             ) .
     2065         end.
     2066         assign
     2067           v-diasize-proc-name = entry(1, program-name(2), '.')
     2068         .
     2069         if v-diasize-wndstore = true
     2070         then do:
     2071           assign
     2072             v-restore-saved = false
     2073           .
     2074           if connected("ub") = true
     2075           then do:
     2076             run gbl/wndsizer.p
     2077               (input  v-cntxt-db-num
     2078               ,input  v-cntxt-userid
     2079               ,input  v-diasize-proc-name
     2080               ,input  'height':u
     2081               ,output v-resize-value-str
     2082               ) .
     2083             if v-resize-value-str <> '':U
     2084             then do:
     2085               run diasize_change-height in this-procedure
     2086                 (input  integer(v-resize-value-str)
     2087                 ,input  true
     2088                 ) .
     2089               assign
     2090                 v-restore-saved = true
     2091               .
     2092             end.
     2093           end.
     2094           if connected("ub") = true
     2095           then do:
     2096             run gbl/wndsizer.p
     2097               (input  v-cntxt-db-num
     2098               ,input  v-cntxt-userid
     2099               ,input  v-diasize-proc-name
     2100               ,input  'width':u
     2101               ,output v-resize-value-str
     2102               ) .
     2103             if v-resize-value-str <> '':U
     2104             then do:
     2105               run diasize_change-width in this-procedure
     2106                 (input  integer(v-resize-value-str)
     2107                 ,input  true
     2108                 ) .
     2109               assign
     2110                 v-restore-saved = true
     2111               .
     2112             end.
     2113           end.
     2114           if v-restore-saved <> true
     2115           then do:
     2116             if v-diasize-wndmax = true
     2117             then do:
     2118               run diasize_maximize in this-procedure
     2119                 (input  true
     2120                 ) .
     2121             end.
     2122           end.
     2123         end.
     2124         else do:
     2125           if v-diasize-wndmax = true
     2126           then do:
     2127             run diasize_maximize in this-procedure
     2128               (input  true
     2129               ) .
     2130           end.
     2131         end.
     2132       end.
     2133     end.
     2134   end procedure.
     2135   procedure diasize_need-full-display :
     2136     define output parameter p-need-full-display as logical   no-undo .
     2137     do
     2138     on error undo, return error return-value
     2139     :
     2140       assign
     2141         p-need-full-display = v-diasize-need-full-display
     2142       .
     2143       assign
     2144         v-diasize-need-full-display = false
     2145       .
     2146     end.
     2147   end procedure.
     2148   procedure get-context :
     2149      define output parameter p-db-num as integer          no-undo.
     2150      define output parameter p-user-id as character        no-undo.
     2151      define variable v-login               as character    no-undo.
     2152      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2153      define buffer buf_user-login  for ub.user-login .
     2154      do
     2155      on error undo, return error
     2156      :
     2157            FIND FIRST buf_sys-ctrl no-lock.
     2158            ASSIGN
     2159               v-login = USERID("ub")
     2160               p-db-num = buf_sys-ctrl.db-num
     2161            .
     2162            FIND FIRST buf_user-login
     2163                 WHERE buf_user-login.db-num = p-db-num
     2164                   AND buf_user-login.user-login = v-login
     2165                 no-lock
     2166                 no-error
     2167                 .
     2168            IF AVAILABLE buf_user-login
     2169            THEN DO:
     2170               assign
     2171                  p-user-id = buf_user-login.user-id
     2172               .
     2173            END.
     2174      end.
     2175   end procedure.
     2176       run diasize_init in this-procedure .
     2177   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2178   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2179   MAIN-BLOCK:
     2180   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2181      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2182   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2183     run mainmenu_getcntxt in p-mainmenu-handle
     2184       (output v-cntxt-db-num
     2185       ,output v-cntxt-userid
     2186       ,output v-cntxt-level
     2187       ,output v-cntxt-host-code-obj
     2188       ,output v-cntxt-obj-type
     2189       ,output v-cntxt-obj-code
     2190       ,output v-cntxt-db-num-obj
     2191       ,output v-cntxt-is-admin
     2192       ) .
     2193       run get-quest-print in p-mainmenu-handle (
     2194           output g#quest-print
     2195       ).
     2196       run get-report-num in p-mainmenu-handle (
     2197           output g#report-num
     2198       ).
     2199       run get-quest-print in p-mainmenu-handle (
     2200           output g#quest-print
     2201       ).
     2202       run init-fields in this-procedure.
     2203       RUN enable_UI.
     2204       run ui-disable-all in this-procedure.
     2205       run ui-enable in this-procedure.
     2206       apply "value-changed" to br-table.
     2207       apply "entry" to br-table.
     2208     WAIT-FOR GO OF FRAME Dialog-Frame.
     2209   END.
     2210   RUN disable_UI.
     2211   PROCEDURE create-menu-items :
     2212   define input parameter p-doc-code       as character        no-undo.
     2213   define input parameter p-doc-type       as character        no-undo.
     2214   define input parameter p-ext-doc-type   as character        no-undo.
     2215   define input parameter p-status_        as character        no-undo.
     2216   define input parameter p-Internal       as character        no-undo.
     2217   define input parameter p-flag_          as character        no-undo.
     2218       define variable xtype        as character    no-undo.
     2219       define variable xstatus      as character    no-undo.
     2220       define variable xInternal    as character    no-undo.
     2221       define variable xflag        as character    no-undo.
     2222   do
     2223   on error undo, return error
     2224   :
     2225       assign
     2226           xtype               = p-doc-type
     2227           xstatus             = string( p-status_  )
     2228           xInternal           = string( p-Internal )
     2229           xflag               = string( p-flag_    )
     2230       .
     2231       assign
     2232           v-menu-doc-doc-code = p-doc-code
     2233           v-menu-doc-doc-type = xtype
     2234           v-menu-doc-status_  = xstatus
     2235           v-menu-doc-internal = xInternal
     2236           v-menu-doc-flag     = xflag
     2237       .
     2238   define variable vss-include-info12 as character format "X(65)" no-undo
     2239   initial "@(#)$Workfile$ $Revision$".
     2240   define variable vss-include-info13 as character format "X(65)" no-undo
     2241   initial "@(#)$Workfile$ $Revision$".
     2242           run menu-doc-create-menu-item in this-procedure
     2243             ( input xtype
     2244              , input xstatus
     2245              , input xinternal
     2246              , input xflag
     2247              , input 'рас,при,возврат,спи':U
     2248              , input '*'
     2249              , input '*'
     2250              , input '*'
     2251              , input 'Движение материальных ценностей'
     2252              , input 'cost,sale,rubl,base'
     2253              , input 'rep/r-w-doc.p'
     2254              , input ''
     2255              , input '------'
     2256              , input ''
     2257              , input 'A4port'
     2258              , input ''
     2259           ).
     2260   define variable vss-include-info14 as character format "X(65)" no-undo
     2261   initial "@(#)$Workfile$ $Revision$".
     2262           run menu-doc-create-menu-item in this-procedure
     2263             ( input xtype
     2264              , input xstatus
     2265              , input xinternal
     2266              , input xflag
     2267              , input 'рас,при':U
     2268              , input 'факт,разрешен,накл,прво':U
     2269              , input '*'
     2270              , input 'ee,pz'
