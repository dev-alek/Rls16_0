     1408   procedure diasize_set-height :
     1409     define input  parameter p-new-height  as decimal   no-undo .
     1410     define input  parameter p-move-resize as logical   no-undo .
     1411     do
     1412     on error undo, return error return-value
     1413     :
     1414       run diasize_change-height in this-procedure
     1415         (input  (p-new-height - frame Dialog-Frame :height)
     1416         ,input  p-move-resize
     1417         ) .
     1418     end.
     1419   end procedure.
     1420   procedure diasize_change-width :
     1421     define input  parameter p-change-value as decimal   no-undo .
     1422     define input  parameter p-move-resize  as logical   no-undo .
     1423     define variable v-field-group-handle   as handle    no-undo .
     1424     define variable v-object-handle        as handle    no-undo .
