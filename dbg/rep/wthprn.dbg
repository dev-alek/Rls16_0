     1198         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1199         v-browse-height = v-diasize-browse-handle :height
     1200       .
     1201       for each buf_temp-browse-handle
     1202         where buf_temp-browse-handle.browse-type = 'height':u
     1203       :
     1204         assign
     1205           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1206         .
     1207       end.
     1208       for each buf_temp-diasize-handle
     1209       :
     1210         delete buf_temp-diasize-handle .
