        1   define temp-table temp_wth-doc-code no-undo
        2       field doc-code as character
        3       index pi is primary unique doc-code
        4   .
        5   define input parameter p-mainmenu-handle    as handle           no-undo.
        6   define input parameter table for temp_wth-doc-code .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Список печатных форм для печати документов материальных ценностей".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       75   define new shared variable RepPathName        as character no-undo .
       76   define new shared variable PrintRubl          as logical   no-undo .
       77   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       79   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       80   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       81   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       82   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       83   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       84   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       85   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       86   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       87   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       88   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       89   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       90   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       91   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       92   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       93   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       94   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       95   define variable vss-include-info2 as character format "X(65)" no-undo
       96   initial "@(#)$Workfile$ $Revision$".
       97       define temp-table Tmp#List no-undo like ub.ord-blank
       98           field id                        as integer
       99           field proc-name                 as character
      100           field proc-param                as character
      101           field print-options             as character
      102           field orient                    as character
      103           field orient-orientation        as character
      104           field orient-font-num           as integer
      105           field font-num                  as character
      106           field filtr                     as character
      107           field view_                     as integer  init 1
      108           field sys-key                   as character
      109           field sys-key-black             as character
      110           field type-parts                as character
      111           field type-parts-enabled        as logical
      112           field type-price                as character
      113           field type-price-enabled        as logical
      114           field type-scale                as character
      115           field type-scale-enabled        as logical
      116           field type-val                  as character
      117           field type-val-enabled          as logical
      118           field sort-name                 as character
      119           field sort-name-enabled         as logical
      120           field sort-gr                   as character
      121           field sort-gr-enabled           as logical
      122           field print-graft               as character
      123           field print-graft-enabled       as logical
      124           field no-vat                    as character
      125           field no-vat-enabled            as logical
      126           index pi is primary unique id
      127           index in-name
      128              blank-name
      129           index lu
      130               last-use
      131       .
      132       define temp-table temp_form-list no-undo
      133           field doc-code  as character
      134           field id        as integer
      135           field doc-type  as character
      136           field status_   as character
      137           field internal  as character
      138           field flag      as character
      139           index pi is primary unique
      140               doc-code
      141               id
      142           index idx
      143               id
      144       .
      145       define temp-table temp_menu-doc_disabled-doc-list no-undo
      146           field doc-code      as character
      147           field blank-name    as character
      148           field reason        as character
      149           index pi is primary unique
      150                   doc-code
      151                   blank-name
      152       .
      153       define variable v-menu-doc-sys-key              as character    no-undo.
      154       define variable v-menu-doc-doc-code             as character    no-undo.
      155       define variable v-menu-doc-doc-type             as character    no-undo.
      156       define variable v-menu-doc-ext-doc-type         as character    no-undo.
      157       define variable v-menu-doc-status_              as character    no-undo.
      158       define variable v-menu-doc-internal             as character    no-undo.
      159       define variable v-menu-doc-flag                 as character    no-undo.
      160       define variable v-menu-doc-item-counter         as integer      no-undo.
      161       define variable v-menu-doc-item-disabled        as logical      no-undo.
      162   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      163   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      164     define variable p-entry   as logical   no-undo .
      165     define variable v-ind as integer   no-undo .
      166     if p-delimiter = "*":U then do:
      167       message
      168         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      169         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      170         view-as alert-box error .
      171       return ? .
      172     end.
      173     assign
      174       p-entry = true
      175     .
      176     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      177       assign
      178         p-entry = false
      179       .
      180       if num-entries( p-list, "*":U ) > 1 then do:
      181         block_check-list:
      182         do v-ind = 1 to num-entries( p-list, p-delimiter )
      183         :
      184           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      185             assign
      186               p-entry = true
      187             .
      188             leave block_check-list .
      189           end.
      190         end.
      191       end.
      192     end.
      193     return p-entry .
      194   end function .
      195       procedure menu-doc-create-menu-item
      196       :
      197       define input parameter p-type   as   character no-undo.
      198       define input parameter p-stat   as   character no-undo.
      199       define input parameter p-intr   as   character no-undo.
      200       define input parameter p-flag   as   character no-undo.
      201       define input parameter param-1  as   character no-undo.
      202       define input parameter param-2  as   character no-undo.
      203       define input parameter param-3  as   character no-undo.
      204       define input parameter param-4  as   character no-undo.
      205       define input parameter param-5  as   character no-undo.
      206       define input parameter param-6  as   character no-undo.
      207       define input parameter param-7  as   character no-undo.
      208       define input parameter param-8  as   character no-undo.
      209       define input parameter param-9  as   character no-undo.
      210       define input parameter param-10 as   character no-undo.
      211       define input parameter param-11 as   character no-undo.
      212       define input parameter param-12 as   character no-undo.
      213       do
      214       on error undo, return error
      215       :
      216           assign
      217               v-menu-doc-item-disabled = yes
      218           .
      219           if v-menu-doc-sys-key <> 'ExpertekIBS':U
      220           and ( ( param-10 <> "":U
      221                   and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      222                 )
      223                 or ( param-12 <> "":U
      224                      and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      225                    )
      226           then do:
      227               undo, return .
      228           end.
      229           if param-7 = "":U
      230           then do:
      231               undo, return .
      232           end.
      233           if param-1 = '*':U
      234           or lookup( p-type, param-1 ) > 0
      235           then do:
      236               if param-2 = '*':U
      237               or lookup( p-stat, param-2 ) > 0
      238               then do:
      239                   if param-3 = '*':U
      240                   or lookup( p-intr, param-3 ) > 0
      241                   then do:
      242                       if param-4 = '*':U
      243                       or lookup( p-flag, param-4 ) > 0
      244                       then do:
      245                           assign
      246                               v-menu-doc-item-disabled = no
      247                           .
      248                           find first tmp#list
      249                                where tmp#list.blank-name     = param-5
      250                                  and tmp#list.filtr          = param-6
      251                                  and tmp#list.proc-name      = param-7
      252                                  and tmp#list.proc-param     = param-8
      253                                  and tmp#list.print-options  = param-9
      254                                  and tmp#list.sys-key        = param-10
      255                                  and tmp#list.orient         = param-11
      256                                  and tmp#list.sys-key-black  = param-12
      257                           no-error.
      258                           if not available tmp#list
      259                           then do:
      260                               assign
      261                                   v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      262                               .
      263                               create tmp#list.
      264                               assign
      265                                   tmp#list.id             = v-menu-doc-item-counter
      266                                   tmp#list.cli-code       = v-menu-doc-item-counter
      267                                   tmp#list.blank-name     = param-5
      268                                   tmp#list.filtr          = param-6
      269                                   tmp#list.proc-name      = param-7
      270                                   tmp#list.proc-param     = param-8
      271                                   tmp#list.print-options  = param-9
      272                                   tmp#list.sys-key        = param-10
      273                                   tmp#list.orient         = param-11
      274                                   tmp#list.sys-key-black  = param-12
      275                               .
      276                               assign
      277                                   tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      278                                   tmp#list.orient-font-num        = 7
      279                               .
      280                               assign
      281                                   tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      282                                                                     then integer( entry( 2, tmp#list.orient ) )
      283                                                                     else 7 )
      284                               no-error.
      285                               if error-status :error
      286                               then do:
      287                                   assign
      288                                       tmp#list.orient-font-num = 7
      289                                   .
      290                               end.
      291                               run menu-doc-set-visible-options in this-procedure (
      292                                     input tmp#list.print-options
      293                                   , output tmp#list.type-parts-enabled
      294                                   , output tmp#list.type-price-enabled
      295                                   , output tmp#list.type-scale-enabled
      296                                   , output tmp#list.type-val-enabled
      297                                   , output tmp#list.sort-name-enabled
      298                                   , output tmp#list.sort-gr-enabled
      299                                   , output tmp#list.print-graft-enabled
      300                                   , output tmp#list.no-vat-enabled
      301                               ).
      302                           end.
      303                       end.
      304                   end.
      305               end.
      306           end.
      307           if v-menu-doc-item-disabled = yes
      308           then do:
      309               find first tmp#list
      310                    where tmp#list.blank-name     = param-5
      311                      and tmp#list.filtr          = param-6
      312                      and tmp#list.proc-name      = param-7
      313                      and tmp#list.proc-param     = param-8
      314                      and tmp#list.print-options  = param-9
      315                      and tmp#list.sys-key        = param-10
      316                      and tmp#list.orient         = param-11
      317                      and tmp#list.sys-key-black  = param-12
      318               no-error.
      319               if available tmp#list
      320               then do:
      321                   find first temp_menu-doc_disabled-doc-list
      322                        where temp_menu-doc_disabled-doc-list.doc-code     = v-menu-doc-doc-code
      323                          and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      324                   no-error.
      325                   if not available temp_menu-doc_disabled-doc-list
      326                   then do:
      327                       create temp_menu-doc_disabled-doc-list.
      328                       assign
      329                           temp_menu-doc_disabled-doc-list.doc-code    = v-menu-doc-doc-code
      330                           temp_menu-doc_disabled-doc-list.blank-name  = param-5
      331                       .
      332                   end.
      333                   if param-1 <> '*':U
      334                   and lookup( p-type, param-1 ) > 0
      335                   then do:
      336                       assign
      337                           temp_menu-doc_disabled-doc-list.reason   = "type":U
      338                       .
      339                   end.
      340                   assign
      341                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      342                   .
      343                   if param-2 <> '*':U
      344                   and lookup( p-stat, param-2 ) > 0
      345                   then do:
      346                       assign
      347                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      348                       .
      349                   end.
      350                   assign
      351                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      352                   .
      353                   if param-3 <> '*':U
      354                   and lookup( p-intr, param-3 ) > 0
      355                   then do:
      356                       assign
      357                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "intr":U
      358                       .
      359                   end.
      360                   assign
      361                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      362                   .
      363                   if param-4 <> '*':U
      364                   and lookup( p-flag, param-4 ) > 0
      365                   then do:
      366                       assign
      367                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "flag":U
      368                       .
      369                   end.
      370                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      371                   then do:
      372                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      373                             input tmp#list.blank-name
      374                           , input tmp#list.sys-key
      375                           , input Tmp#List.sys-key-black
      376                           , output tmp#list.blank-name
      377                       ).
      378                   end.
      379               end.
      380               else do:
      381                   assign
      382                       v-menu-doc-item-disabled = no
      383                   .
      384               end.
      385           end.
      386           if v-menu-doc-item-disabled = no
      387           then do:
      388               find first tmp#list
      389                    where tmp#list.blank-name     = param-5
      390                      and tmp#list.filtr          = param-6
      391                      and tmp#list.proc-name      = param-7
      392                      and tmp#list.proc-param     = param-8
      393                      and tmp#list.print-options  = param-9
      394                      and tmp#list.sys-key        = param-10
      395                      and tmp#list.orient         = param-11
      396                      and tmp#list.sys-key-black  = param-12
      397               no-error.
      398               if available tmp#list
      399               then do:
      400                   find first temp_form-list
      401                        where temp_form-list.doc-code  = v-menu-doc-doc-code
      402                          and temp_form-list.id        = tmp#list.id
      403                   no-error.
      404                   if not available temp_form-list
      405                   then do:
      406                       create temp_form-list.
      407                       assign
      408                           temp_form-list.doc-code  = v-menu-doc-doc-code
      409                           temp_form-list.id        = tmp#list.id
      410                           temp_form-list.doc-type  = v-menu-doc-doc-type
      411                           temp_form-list.status_   = v-menu-doc-status_
      412                           temp_form-list.internal  = v-menu-doc-internal
      413                           temp_form-list.flag      = v-menu-doc-flag
      414                       .
      415                   end.
      416                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      417                   then do:
      418                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      419                             input tmp#list.blank-name
      420                           , input tmp#list.sys-key
      421                           , input Tmp#List.sys-key-black
      422                           , output tmp#list.blank-name
      423                       ).
      424                   end.
      425               end.
      426           end.
      427       end.
      428       end procedure.
      429       procedure menu-doc-set-visible-options :
      430       define input parameter p-print-options          as character        no-undo.
      431       define output parameter p-type-parts-enabled    as logical          no-undo.
      432       define output parameter p-type-price-enabled    as logical          no-undo.
      433       define output parameter p-type-scale-enabled    as logical          no-undo.
      434       define output parameter p-type-val-enabled      as logical          no-undo.
      435       define output parameter p-sort-name-enabled     as logical          no-undo.
      436       define output parameter p-sort-gr-enabled       as logical          no-undo.
      437       define output parameter p-print-graft-enabled   as logical          no-undo.
      438       define output parameter p-no-vat-enabled        as logical          no-undo.
      439       do
      440       on error undo, return error
      441       :
      442           assign
      443               p-type-parts-enabled    = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      444               p-type-price-enabled    = ( if substring( p-print-options, 2, 1 ) = "+" then yes else no )
      445               p-type-scale-enabled    = ( if substring( p-print-options, 3, 1 ) = "+" then yes else no )
      446               p-type-val-enabled      = ( if substring( p-print-options, 4, 1 ) = "+" then yes else no )
      447               p-sort-name-enabled     = ( if substring( p-print-options, 5, 1 ) = "+" then yes else no )
      448               p-sort-gr-enabled       = ( if substring( p-print-options, 6, 1 ) = "+" then yes else no )
      449               p-print-graft-enabled   = ( if substring( p-print-options, 7, 1 ) = "+" then yes else no )
      450               p-no-vat-enabled        = ( if substring( p-print-options, 8, 1 ) = "+" then yes else no )
      451           .
      452       end.
      453       end procedure.
      454       procedure menu-doc-create-options-string :
      455       define input parameter p-tmp-list-id        as integer          no-undo.
      456       define output parameter p-options-string    as character        no-undo.
      457           define buffer buf_tmp#list      for tmp#list.
      458       do
      459       for buf_tmp#list
      460       on error undo, return error
      461       :
      462           find first buf_tmp#list
      463                where buf_tmp#list.id = p-tmp-list-id
      464           .
      465           assign
      466               p-options-string =  ( if trim( buf_tmp#list.type-parts  ) = "+":U then "+":U else "-":U )
      467                                 + ( if trim( buf_tmp#list.type-price  ) = "+":U then "+":U else "-":U )
      468                                 + ( if trim( buf_tmp#list.type-scale  ) = "+":U then "+":U else "-":U )
      469                                 + ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      470                                 + ( if trim( buf_tmp#list.sort-name   ) = "+":U then "+":U else "-":U )
      471                                 + ( if trim( buf_tmp#list.sort-gr     ) = "+":U then "+":U else "-":U )
      472                                 + ( if trim( buf_tmp#list.print-graft ) = "+":U then "+":U else "-":U )
      473                                 + ( if trim( buf_tmp#list.no-vat      ) = "+":U then "+":U else "-":U )
      474           .
      475       end.
      476       end procedure.
      477       procedure menu-doc-set-options-string :
      478       define input parameter p-tmp-list-id            as integer          no-undo.
      479       define input parameter p-options-string         as character        no-undo.
      480           define buffer buf_tmp#list      for tmp#list.
      481       do
      482       for buf_tmp#list
      483       on error undo, return error
      484       :
      485           find first buf_tmp#list
      486                where buf_tmp#list.id = p-tmp-list-id
      487           .
      488           assign
      489               buf_tmp#list.type-parts  = ( if buf_tmp#list.type-parts-enabled     = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      490               buf_tmp#list.type-price  = ( if buf_tmp#list.type-price-enabled     = yes then substitute( "  &1", substring( p-options-string, 2, 1 ) ) else " ":U )
      491               buf_tmp#list.type-scale  = ( if buf_tmp#list.type-scale-enabled     = yes then substitute( "  &1", substring( p-options-string, 3, 1 ) ) else " ":U )
      492               buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 4, 1 ) ) else " ":U )
      493               buf_tmp#list.sort-name   = ( if buf_tmp#list.sort-name-enabled      = yes then substitute( "  &1", substring( p-options-string, 5, 1 ) ) else " ":U )
      494               buf_tmp#list.sort-gr     = ( if buf_tmp#list.sort-gr-enabled        = yes then substitute( "  &1", substring( p-options-string, 6, 1 ) ) else " ":U )
      495               buf_tmp#list.print-graft = ( if buf_tmp#list.print-graft-enabled    = yes then substitute( "  &1", substring( p-options-string, 7, 1 ) ) else " ":U )
      496               buf_tmp#list.no-vat      = ( if buf_tmp#list.no-vat-enabled         = yes then substitute( "  &1", substring( p-options-string, 8, 1 ) ) else " ":U )
      497           .
      498       end.
      499       end procedure.
      500       procedure menu-doc-create-options-enabled-string :
      501       define input parameter p-tmp-list-id                as integer          no-undo.
      502       define output parameter p-options-enabled-string    as character        no-undo.
      503           define buffer buf_tmp#list      for tmp#list.
      504       do
      505       for buf_tmp#list
      506       on error undo, return error
      507       :
      508           find first buf_tmp#list
      509                where buf_tmp#list.id = p-tmp-list-id
      510           .
      511           assign
      512               p-options-enabled-string =  ( if buf_tmp#list.type-parts-enabled  = yes then "+":U else "-":U )
      513                                         + ( if buf_tmp#list.type-price-enabled  = yes then "+":U else "-":U )
      514                                         + ( if buf_tmp#list.type-scale-enabled  = yes then "+":U else "-":U )
      515                                         + ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
      516                                         + ( if buf_tmp#list.sort-name-enabled   = yes then "+":U else "-":U )
      517                                         + ( if buf_tmp#list.sort-gr-enabled     = yes then "+":U else "-":U )
      518                                         + ( if buf_tmp#list.print-graft-enabled = yes then "+":U else "-":U )
      519                                         + ( if buf_tmp#list.no-vat-enabled      = yes then "+":U else "-":U )
      520           .
      521       end.
      522       end procedure.
      523       procedure menu-doc-extend-blank-name-for-IBS :
      524       define input parameter p-in-blank-name      as character        no-undo.
      525       define input parameter p-sys-key            as character        no-undo.
      526       define input parameter p-sys-key-black      as character        no-undo.
      527       define output parameter p-out-blank-name    as character        no-undo.
      528       do
      529       on error undo, return error
      530       :
      531           assign
      532               p-out-blank-name = p-in-blank-name
      533           .
      534           if p-sys-key <> "":U
      535           then do:
      536               assign
      537                   p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
      538               .
      539           end.
      540           if p-sys-key-black <> ""
      541           then do:
      542               assign
      543                   p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
      544               .
      545           end.
      546       end.
      547       end procedure.
      548   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      549     define variable v-cntxt-db-num        as integer   no-undo .
      550     define variable v-cntxt-userid        as character no-undo .
      551     define variable v-cntxt-level         as character no-undo .
      552     define variable v-cntxt-host-code-obj as integer   no-undo .
      553     define variable v-cntxt-obj-type      as character no-undo .
      554     define variable v-cntxt-obj-code      as integer   no-undo .
      555     define variable v-cntxt-db-num-obj    as integer   no-undo .
      556     define variable v-cntxt-is-admin      as logical   no-undo .
      557   define new shared variable print-graft as logical no-undo .
      558   define new shared variable sort-gr     as logical no-undo .
      559   define new shared variable sort-name   as logical no-undo .
      560   define new shared variable CostPrice   as logical no-undo .
      561   define new shared variable PrintScale  as logical no-undo .
      562   define variable in-docprvalue       as character    no-undo.
      563   define variable g#report-num    as integer      no-undo.
      564   define variable g#quest-print   as logical      no-undo.
      565   define variable g#log           as logical      no-undo.
      566   DEFINE BUTTON b-chg
      567        LABEL "&Изменить"
      568        SIZE 10 BY 1.
      569   DEFINE BUTTON b-deselect
      570        LABEL "&Снять *"
      571        SIZE 10 BY 1.
      572   DEFINE BUTTON b-exit AUTO-GO
      573        LABEL "&Выход"
      574        SIZE 10 BY 1
      575        BGCOLOR 8 .
      576   DEFINE BUTTON b-help
      577        LABEL "Помощ&ь"
      578        SIZE 10 BY 1
      579        BGCOLOR 8 .
      580   DEFINE BUTTON b-print
      581        LABEL "Пе&чать":L
      582        SIZE 10 BY 1
      583        BGCOLOR 8 .
      584   DEFINE BUTTON b-sel
      585        LABEL "*"
      586        SIZE 3 BY 1.
      587   DEFINE VARIABLE fi-default-printer AS CHARACTER FORMAT "X(256)":U
      588         VIEW-AS TEXT
      589        SIZE 97 BY .67
      590        FGCOLOR 4  NO-UNDO.
      591   DEFINE QUERY br-table FOR
      592         Tmp#List SCROLLING.
      593   DEFINE BROWSE br-table
      594     QUERY br-table NO-LOCK DISPLAY
      595         Tmp#List.last-use COLUMN-LABEL "*" FORMAT "*/"
      596       Tmp#List.blank-name COLUMN-LABEL "Название печатной формы":C57 FORMAT "X(57)"
      597       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.88 BY 20.25 FIT-LAST-COLUMN.
      598   DEFINE FRAME Dialog-Frame
      599        b-exit AT ROW 1 COL 1.63
      600        b-sel AT ROW 1 COL 11.63
      601        b-deselect AT ROW 1 COL 14.63
      602        b-chg AT ROW 1 COL 43
      603        b-print AT ROW 1 COL 79.5
      604        b-help AT ROW 1 COL 89.5
      605        br-table AT ROW 2.25 COL 1.63
      606        fi-default-printer AT ROW 22.75 COL 1.5 NO-LABEL
      607        SPACE(1.37) SKIP(0.20)
      608       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      609            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      610            TITLE "Список печатных форм".
      611   ASSIGN
      612          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      613          FRAME Dialog-Frame:HIDDEN           = TRUE.
      614   ASSIGN
      615          fi-default-printer:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      616   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      617   DO:
      618     APPLY "END-ERROR":U TO SELF.
      619   END.
      620   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      621   DO:
      622       if available tmp#list
      623       then do:
      624           define variable v-options-string            as character    no-undo.
      625           define variable v-options-string-new        as character    no-undo.
      626           define variable v-options-enabled-string    as character    no-undo.
      627           run menu-doc-create-options-string in this-procedure (
      628                 input tmp#list.id
      629               , output v-options-string
      630           ).
      631           run menu-doc-create-options-enabled-string in this-procedure (
      632                 input tmp#list.id
      633               , output v-options-enabled-string
      634           ).
      635           run rep/wthprnd.w (
      636                 input tmp#list.blank-name
      637               , input v-options-string
      638               , input v-options-enabled-string
      639               , output v-options-string-new
      640           ) no-error.
      641           if error-status :error
      642           then do:
      643               message
      644                        vss-workfile vss-revision vss-description
      645                   skip(1)
      646                   skip "Ошибка изменения параметров печати."
      647                   skip return-value
      648                   skip trim(error-status :get-message(1))
      649                        trim(error-status :get-message(2))
      650                        trim(error-status :get-message(3))
      651               view-as alert-box error.
      652               undo, return no-apply .
      653           end.
      654           if v-options-string-new <> v-options-string
      655           then do:
      656               run menu-doc-set-options-string in this-procedure (
      657                       input tmp#list.id
      658                     , input v-options-string-new
      659               ).
      660               browse br-table :refresh().
      661               apply "entry" to br-table in frame Dialog-Frame.
      662           end.
      663       end.
      664   END.
      665   ON CHOOSE OF b-deselect IN FRAME Dialog-Frame
      666   DO:
      667       for each tmp#list no-lock
      668       :
      669           assign
      670               tmp#list.last-use = no
      671           .
      672       end.
      673       browse br-table :refresh().
      674   END.
      675   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      676   DO:
      677       run save-form-parameters in this-procedure no-error.
      678       if error-status :error
      679       then do:
      680           message
      681                    vss-workfile vss-revision vss-description
      682               skip(1)
      683               skip "Ошибка при сохранении параметров"
      684               skip "списка печатных форм."
      685               skip return-value
      686               skip trim(error-status :get-message(1))
      687                    trim(error-status :get-message(2))
      688                    trim(error-status :get-message(3))
      689           view-as alert-box error.
      690       end.
      691   END.
      692   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      693   DO:
      694       define variable v-is-selected   as logical      no-undo.
      695       define buffer buf_temp_tmp#list      for tmp#list.
      696       assign
      697           v-is-selected = no
      698       .
      699       test-selecting:
      700       for each buf_temp_tmp#list
      701       :
      702           if buf_temp_tmp#list.last-use <> no
      703           then do:
      704               assign
      705                   v-is-selected = yes
      706               .
      707               leave test-selecting.
      708           end.
      709       end.
      710       if v-is-selected = no
      711       then do:
      712           message
      713               "Не выбрано ни одной формы"
      714               skip "для печати."
      715           view-as alert-box information
      716           title "Печать невозможна"
      717           .
      718           undo, return no-apply.
      719       end.
      720       else do:
      721           run print-docs in this-procedure no-error.
      722           if error-status :error
      723           then do:
      724               message
      725                        vss-workfile vss-revision vss-description
      726                   skip(1)
      727                   skip "Ошибка печати документов."
      728                   skip return-value
      729                   skip trim(error-status :get-message(1))
      730                        trim(error-status :get-message(2))
      731                        trim(error-status :get-message(3))
      732               view-as alert-box error.
      733               undo, return no-apply .
      734           end.
      735       end.
      736   END.
      737   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      738   DO:
      739       if available tmp#list
      740       then do:
      741           assign
      742               tmp#list.last-use = ( if tmp#list.last-use = yes then no else yes )
      743           .
      744           run reposition-browse in this-procedure .
      745           browse br-table :refresh().
      746       end.
      747   END.
      748   ON 1 OF br-table IN FRAME Dialog-Frame
      749   DO:
      750       if available tmp#list
      751       then do:
      752           if tmp#list.type-price = "  +":U
      753           or tmp#list.type-price = "  -":U
      754           then do:
      755               assign
      756                   tmp#list.type-price = ( if tmp#list.type-price = "  +":U then "  -":U else "  +":U )
      757               .
      758           end.
      759           br-table :refresh().
      760       end.
      761   END.
      762   ON 2 OF br-table IN FRAME Dialog-Frame
      763   DO:
      764       if available tmp#list
      765       then do:
      766           if tmp#list.type-scale = "  +":U
      767           or tmp#list.type-scale = "  -":U
      768           then do:
      769               assign
      770                   tmp#list.type-scale = ( if tmp#list.type-scale = "  +":U then "  -":U else "  +":U )
      771               .
      772           end.
      773           br-table :refresh().
      774       end.
      775   END.
      776   ON 3 OF br-table IN FRAME Dialog-Frame
      777   DO:
      778       if available tmp#list
      779       then do:
      780           if tmp#list.type-val = "  +":U
      781           or tmp#list.type-val = "  -":U
      782           then do:
      783               assign
      784                   tmp#list.type-val = ( if tmp#list.type-val = "  +":U then "  -":U else "  +":U )
      785               .
      786           end.
      787           br-table :refresh().
      788       end.
      789   END.
      790   ON 4 OF br-table IN FRAME Dialog-Frame
      791   DO:
      792       if available tmp#list
      793       then do:
      794           if tmp#list.sort-name = "  +":U
      795           or tmp#list.sort-name = "  -":U
      796           then do:
      797               assign
      798                   tmp#list.sort-name = ( if tmp#list.sort-name = "  +":U then "  -":U else "  +":U )
      799               .
      800           end.
      801           br-table :refresh().
      802       end.
      803   END.
      804   ON 5 OF br-table IN FRAME Dialog-Frame
      805   DO:
      806       if available tmp#list
      807       then do:
      808           if tmp#list.sort-gr = "  +":U
      809           or tmp#list.sort-gr = "  -":U
      810           then do:
      811               assign
      812                   tmp#list.sort-gr = ( if tmp#list.sort-gr = "  +":U then "  -":U else "  +":U )
      813               .
      814           end.
      815           br-table :refresh().
      816       end.
      817   END.
      818   ON 6 OF br-table IN FRAME Dialog-Frame
      819   DO:
      820       if available tmp#list
      821       then do:
      822           if tmp#list.print-graft = "  +":U
      823           or tmp#list.print-graft = "  -":U
      824           then do:
      825               assign
      826                   tmp#list.print-graft = ( if tmp#list.print-graft = "  +":U then "  -":U else "  +":U )
      827               .
      828           end.
      829           br-table :refresh().
      830       end.
      831   END.
      832   ON MOUSE-SELECT-DBLCLICK OF br-table IN FRAME Dialog-Frame
      833   DO:
      834       if available Tmp#List
      835       then do:
      836           run select-or-deselect-item in this-procedure (
      837               input Tmp#List.id
      838           ) no-error.
      839           if error-status :error
      840           then do:
      841               message
      842                   vss-workfile vss-revision vss-description
      843                   skip "Ошибка выбора или отмены выбора."
      844                   skip return-value
      845                   skip trim(error-status :get-message(1))
      846                   trim(error-status :get-message(2))
      847                   trim(error-status :get-message(3))
      848               view-as alert-box error.
      849               undo, return no-apply .
      850           end.
      851           br-table :refresh().
      852       end.
      853   END.
      854   ON ROW-DISPLAY OF br-table IN FRAME Dialog-Frame
      855   DO:
      856       if Tmp#List.orient-font-num <> 7
      857       then do:
      858           assign
      859               Tmp#List.last-use          :fgcolor in browse br-table = DARK_GREEN_COLOR
      860               Tmp#List.blank-name        :fgcolor in browse br-table = DARK_GREEN_COLOR
      861           .
      862       end.
      863       else do:
      864           if Tmp#List.orient-orientation = 'A4port':U
      865           or Tmp#List.orient-orientation = 'A3port':U
      866           then do:
      867               Tmp#List.last-use          :fgcolor in browse br-table = BLUE_COLOR.
      868               Tmp#List.blank-name        :fgcolor in browse br-table = BLUE_COLOR.
      869           end.
      870           else do:
      871               if Tmp#List.orient-orientation = 'EXCEL':U
      872               or Tmp#List.orient-orientation = 'self':U
      873               then do:
      874                   Tmp#List.last-use   :fgcolor in browse br-table = CYAN_COLOR.
      875                   Tmp#List.blank-name :fgcolor in browse br-table = CYAN_COLOR.
      876               end.
      877               else do:
      878                   Tmp#List.last-use   :fgcolor in browse br-table = BLACK_COLOR.
      879                   Tmp#List.blank-name :fgcolor in browse br-table = BLACK_COLOR.
      880               end.
      881           end.
      882       end.
      883   END.
      884   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      885   on F1 of frame Dialog-Frame anywhere do:
      886     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame Dialog-Frame. END.
      887     return no-apply.
      888   end.
      889   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   on F2 of frame Dialog-Frame anywhere do:
      891     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
      892     return no-apply.
      893   end.
      894   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
      896     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
      897     return no-apply.
      898   end.
      899   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   on help of frame Dialog-Frame
      901   do:
      902     run gbl/app_help.p
      903       (input this-procedure :file-name
      904       ,input ''
      905       ,input ?
      906       ) no-error.
      907     if error-status :error then do:
      908       message
      909         "Ошибка при вызове помощи"
      910         error-status :get-message(1)
      911         view-as alert-box .
      912     end.
      913   end.
      914   run minbtn-set in this-procedure .
      915   on choose of b-help in frame Dialog-Frame
      916   do:
      917     apply "help":u to frame Dialog-Frame .
      918   end.
      919   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   procedure minbtn-set :
      921       do
      922           on error undo, return error return-value
      923           :
      924           define variable ii              as integer       no-undo .
      925           define variable fh              as widget-handle no-undo .
      926           define variable hh              as widget-handle no-undo .
      927           define variable v-h             as handle        extent 4 no-undo .
      928           define variable v-name-button   as character     no-undo .
      929           define variable v-help-old-x    as decimal       no-undo .
      930           define variable v-help-old-y    as decimal       no-undo .
      931           define variable v-help-old-size as decimal       no-undo .
      932           define variable v-frame-width   as decimal       no-undo .
      933           define variable jj              as integer       no-undo .
      934           do
      935               on error undo, return error
      936               :
      937               assign
      938                   v-frame-width = frame Dialog-Frame:width - 0.3
      939                   fh            = frame Dialog-Frame:first-child
      940                   hh            = fh:first-child
      941                   ii            = 1
      942                   .
      943               do while valid-handle(hh):
      944                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      945                   do:
      946                       case lc(hh:name) :
      947                           when "b-help" then
      948                               do:
      949                                   hh:load-image-up("cmp/b-help.bmp":u) .
      950                                   hh:load-image-down("cmp/b-help.bmp":u) .
      951                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      952                                   hh:TOOLTIP = "Помощь" .
      953                                   v-help-old-x = hh:column .
      954                                   v-help-old-y = hh:row    .
      955                                   v-help-old-size = hh:width .
      956                                   hh:width-chars = 2.5 .
      957                               end.
      958                           when "b-print" then
      959                               do:
      960                                   hh:load-image("cmp/b-print.bmp":u) .
      961                                   hh:TOOLTIP = "Печать" .
      962                                   v-h[ii] = hh:handle .
      963                                   ii = ii + 1 .
      964                                   hh:width-chars = 3 .
      965                               end.
      966                           when "b-history" or
      967                           when "b-hist" then
      968                               do:
      969                                   hh:load-image("cmp/b-hist.bmp":u) .
      970                                   hh:TOOLTIP = "История" .
      971                                   v-h[ii] = hh:handle .
      972                                   ii = ii + 1 .
      973                                   hh:width-chars = 3 .
      974                               end.
      975                           when "b-sch" then
      976                               do:
      977                                   hh:load-image("cmp/b-sch.bmp":u) .
      978                                   hh:TOOLTIP = "Установка Фильтра" .
      979                                   v-h[ii] = hh:handle .
      980                                   ii = ii + 1 .
      981                                   hh:width-chars = 3 .
      982                               end.
      983                           when "b-hist-user" then
      984                               do:
      985                                   hh:load-image("cmp/b-hist.bmp":u) .
      986                                   hh:TOOLTIP = "История пользователя" .
      987                                   ii = ii + 1 .
      988                               end.
      989                       end case.
      990                   end.
      991                   hh = hh:next-sibling.
      992               end.
      993               b-help:column = v-frame-width - b-help:width-chars.
      994               jj = 0.
      995               repeat ii = 4 to 1 by -1 :
      996                   if valid-handle (v-h[ii] ) then
      997                   do:
      998                       jj  = jj + 1 .
      999                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1000                       v-h[ii]:row    = v-help-old-y .
     1001                   end.
     1002               end.
     1003           end.
     1004       end.
     1005   end procedure.
     1006   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1007   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1008   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1009   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1010   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1011   define variable v-diasize-current-frame-height as decimal   no-undo .
     1012   define variable v-diasize-change-size          as logical   no-undo .
     1013   define variable v-diasize-resize-button        as handle    no-undo .
     1014   define variable v-diasize-wndmax               as logical   no-undo .
     1015   define variable v-diasize-wndstore             as logical   no-undo .
     1016   define variable v-diasize-proc-name            as character no-undo .
     1017   define variable v-diasize-browse-handle        as handle    no-undo .
     1018   define variable v-diasize-browse-number        as integer   no-undo .
     1019   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1020   define temp-table temp-diasize-handle no-undo
     1021     field handle-value  as handle
     1022     field save-position as decimal
     1023     index xpk is primary unique handle-value
     1024     .
     1025   define temp-table temp-browse-handle no-undo
     1026     field browse-type   as character
     1027     field browse-number as integer
     1028     field browse-handle as handle
     1029     field original-size as decimal
     1030     index xpk is primary unique browse-type browse-number
     1031     index xie browse-type browse-handle
     1032   .
     1033   procedure diasize_change-height :
     1034     define input  parameter p-change-value  as decimal   no-undo .
     1035     define input  parameter p-move-resize   as logical   no-undo .
     1036     define variable v-field-group-handle    as handle    no-undo .
     1037     define variable v-object-handle         as handle    no-undo .
     1038     define variable v-frame-height          as decimal   no-undo .
     1039     define variable v-frame-virtual-height  as decimal   no-undo .
     1040     define variable v-browse-height         as decimal   no-undo .
     1041     define variable v-window-height         as decimal   no-undo .
     1042     define variable v-window-virtual-height as decimal   no-undo .
     1043     define variable v-change-sign           as integer   no-undo .
     1044     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1045     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1046     if p-change-value > 0
     1047     then do:
     1048       if frame Dialog-Frame :height + p-change-value
     1049           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1050       then do:
     1051         assign
     1052           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1053                           - (frame Dialog-Frame :height-chars)
     1054         .
     1055         if p-change-value <= 0
     1056         then do:
     1057           run diasize_position-resize-button in this-procedure .
     1058           return .
     1059         end.
     1060       end.
     1061     end.
     1062     if p-change-value < 0
     1063     then do:
     1064       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1065       then do:
     1066         assign
     1067           p-change-value = v-diasize-orig-frame-height
     1068                          - (frame Dialog-Frame :height-chars)
     1069         .
     1070         if p-change-value >= 0
     1071         then do:
     1072           run diasize_position-resize-button in this-procedure .
     1073           return .
     1074         end.
     1075       end.
     1076     end.
     1077     if p-change-value >= 0
     1078     then do:
     1079       assign
     1080         v-change-sign = 1
     1081       .
     1082     end.
     1083     else do:
     1084       assign
     1085         v-change-sign = -1
     1086       .
     1087     end.
     1088     assign
     1089       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1090     .
     1091     if p-change-value = 0
     1092     then do:
     1093       run diasize_position-resize-button in this-procedure .
     1094       return .
     1095     end.
     1096     move_block:
     1097     do
     1098     on error undo move_block, retry move_block
     1099     :
     1100       if retry
     1101       then do:
     1102         do
     1103         on error undo move_block, leave move_block
     1104         :
     1105           if p-change-value > 0
     1106           then do:
     1107             for each buf_temp-diasize-handle
     1108             on error undo, next
     1109             :
     1110               assign
     1111                 v-object-handle = buf_temp-diasize-handle.handle-value
     1112               .
     1113               if v-object-handle <> v-diasize-resize-button
     1114               then do:
     1115                 assign
     1116                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1117                 .
     1118               end.
     1119             end.
     1120             assign
     1121               v-diasize-browse-handle :height = v-browse-height
     1122             .
     1123             for each buf_temp-browse-handle
     1124               where buf_temp-browse-handle.browse-type = 'height':u
     1125             on error undo, next
     1126             :
     1127               assign
     1128                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1129               .
     1130             end.
     1131             assign
     1132               frame Dialog-Frame :height = v-frame-height
     1133             .
     1134             if frame Dialog-Frame :scrollable = true
     1135             then do:
     1136               assign
     1137                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1138               .
     1139             end.
     1140             run diasize_position-resize-button in this-procedure .
     1141           end.
     1142           else do:
     1143             if frame Dialog-Frame :scrollable = true
     1144             then do:
     1145               assign
     1146                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1147               .
     1148             end.
     1149             assign
     1150               frame Dialog-Frame :height = v-frame-height
     1151             .
     1152             assign
     1153               v-diasize-browse-handle :height = v-browse-height
     1154             .
     1155             for each buf_temp-browse-handle
     1156               where buf_temp-browse-handle.browse-type = 'height':u
     1157             on error undo, next
     1158             :
     1159               assign
     1160                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1161               .
     1162             end.
     1163             for each buf_temp-diasize-handle
     1164             on error undo, next
