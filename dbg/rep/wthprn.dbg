     1255           v-diasize-resize-button :column = 1
     1256         .
     1257       end.
     1258       if p-change-value > 0
     1259       then do:
     1260         if frame Dialog-Frame :scrollable = true
     1261         then do:
     1262           assign
     1263             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1264             no-error .
     1265           if error-status :error
     1266           or error-status :get-message(1) <> ""
     1267           then do:
     1268             undo move_block, retry move_block .
     1269           end.
     1270         end.
     1271         assign
     1272           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1273           no-error .
