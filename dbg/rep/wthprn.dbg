     1284         then do:
     1285           undo move_block, retry move_block .
     1286         end.
     1287         for each buf_temp-browse-handle
     1288           where buf_temp-browse-handle.browse-type = 'height':u
     1289         on error undo move_block, retry move_block
     1290         :
     1291           assign
     1292             buf_temp-browse-handle.browse-handle :height
     1293               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1294             no-error .
