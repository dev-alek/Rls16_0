     1301   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1302   define variable v-waitfram-action01         as character   no-undo .
     1303   define variable v-waitfram-action02         as character   no-undo .
     1304   define variable v-waitfram-action03         as character   no-undo .
     1305   define variable mWaitFramTextBeg            as character   no-undo.
     1306   define variable mWaitFramTextEnd            as character   no-undo.
     1307   define variable mWaitFramView               as logical     no-undo.
     1308   define variable mWaitProcEvent              as logical     no-undo init yes.
     1309   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1310   define variable mWaitFramStop               as logical     no-undo.
     1311   define variable mWaitFramStopUser           as logical     no-undo.
     1312   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1313   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1314   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1315   define button B-WaitFramStop auto-end-key
     1316        label "Стоп"
     1317        size 10 by 1 tooltip "Остоновить процесс".
     1318   define button B-viewProcInfo
     1319        label "Информация"
     1320        size 15 by 1 tooltip "Информация о процесс".
     1321   define frame waitfram
     1322     v-waitfram-action01 format "x(72)" no-label skip
     1323     v-waitfram-action02 format "x(72)" no-label skip
     1324     v-waitfram-action03 format "x(72)" no-label skip
     1325     B-viewProcInfo
     1326     B-WaitFramStop at row 4 col 30
     1327     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1328     .
     1329   define new global shared variable mBatchMode as logical no-undo init ?.
     1330   define variable mFramBachModHandle as handle no-undo.
     1331   mFramBachModHandle = frame waitfram:handle.
     1332   define variable mFameOldVis as logical no-undo.
     1333   define variable mVisCUrentVin as logical no-undo.
     1334   if session:batch-mode
     1335   then
     1336      mBatchMode = yes.
     1337   if mBatchMode = ? then do:
     1338     mVisCUrentVin = current-window:visible.
     1339     mFameOldVis = mFramBachModHandle:visible.
     1340     mFramBachModHandle:visible  = yes.
     1341     mBatchMode = mFramBachModHandle:visible ne yes.
     1342     mFramBachModHandle:visible = mFameOldVis.
     1343     current-window:visible = mVisCUrentVin.
     1344   end.
     1345    if  log-manager:logfile-name ne ?
     1346     then DO:
     1347         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1348         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1349         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1350     end.
     1351   on choose of B-WaitFramStop in frame waitfram
     1352   do:
     1353     mWaitFramStop = yes.
     1354     mWaitFramStopUser = yes.
     1355   end.
     1356   function waitfram-check-timeout returns logical():
     1357      define variable vtime as int64 no-undo.
     1358      if mWaitFramStopTimeOut
     1359      then
     1360         return yes.
     1361      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1362      if     mWaitFramTimeOut ne ?
     1363         and mWaitFramTimeOut ne 0
     1364         and mWaitFramTimeOut lt vtime
     1365      then do:
     1366         mWaitFramStopTimeOut = yes.
     1367      end.
     1368      return mWaitFramStopTimeOut.
     1369   end.
     1370   procedure waitfram-hide :
     1371     if not session:batch-mode
     1372     then do
     1373     on error undo, return error return-value
     1374     :
     1375       pause 0 before-hide .
     1376       if not mBatchMode then
     1377         hide frame waitfram .
     1378     if     not mWaitFramView
     1379        and mWaitProcEvent
     1380     then
     1381       process events .
     1382     end.
     1383   end procedure.
     1384   procedure waitfram-show :
     1385     define input  parameter p-message as character no-undo .
     1386     define variable v-left-margin as integer   no-undo .
     1387     if not session:batch-mode
     1388     then do
     1389     on error undo, return error return-value
     1390     :
     1391       if length(p-message) <= 70 then do:
     1392         assign
     1393           v-left-margin = integer((70 - length(p-message)) / 2)
     1394         .
     1395         assign
     1396           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1397         .
     1398         assign
     1399           v-waitfram-action01 = " "
     1400           v-waitfram-action02 = " "
     1401                                    + fill(" ", v-left-margin)
     1402                                    + p-message
     1403           v-waitfram-action03 = " "
     1404         .
     1405       end.
     1406       else do:
     1407         define variable vRindex1 as integer no-undo.
     1408         define variable vRindex2 as integer no-undo.
     1409         vRindex1 = r-index(p-message," ",70).
     1410         if vRindex1 = 0
     1411         then
     1412            vRindex1 = 70.
     1413         if length(p-message)  <= vRindex1 + 70 then do:
     1414           assign
     1415             v-waitfram-action01 = " "
     1416             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1417             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1418           .
     1419         end.
     1420         else do:
     1421           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1422           if vRindex2 <= vRindex1
     1423           then
     1424              vRindex2 = vRindex1 + 70.
     1425           assign
     1426             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1427             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1428             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1429           .
     1430         end.
     1431       end.
     1432       B-viewProcInfo:visible   in frame waitfram = no.
     1433       B-viewProcInfo:sensitive in frame waitfram = no.
     1434       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1435       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1436       if  (   mWaitFramView
     1437          or  mWaitProcEvent)
     1438          and not mBatchMode
     1439       then
     1440          display
     1441             v-waitfram-action01 skip
     1442             v-waitfram-action02 skip
     1443             v-waitfram-action03 skip
     1444          with frame waitfram .
     1445       if     mWaitFramView
     1446          then do:
     1447             if     mWaitFramInterval ne ?
     1448                and not mBatchMode
     1449             then
     1450                wait-for go of frame waitfram pause mWaitFramInterval.
     1451          end.
     1452          else
     1453             if     mWaitProcEvent
     1454                and not mBatchMode
     1455             then
     1456                process events .
     1457     end.
     1458   end procedure.
     1459      procedure waitfram-show-this:
     1460         define input  parameter iInterval as int64 no-undo.
     1461         define variable vtime as int64 no-undo.
     1462         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1463         mWaitFramInterval = iInterval.
     1464         run waitfram-show (substitute("&1&2 &3&4" ,
     1465                                       mWaitFramTextBeg ,
     1466                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1467                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1468                                       mWaitFramTextEnd
     1469                                      )
     1470                           ).
     1471      end.
     1472      procedure WaitFramRunPause:
     1473         define input  parameter iInterval as dec no-undo.
     1474         define variable vStart  as datetime-tz no-undo.
     1475         define variable vend    as datetime-tz no-undo.
     1476         define variable vint as int64 no-undo.
     1477         define variable vOk as logical no-undo.
     1478         vStart = now.
     1479         vend   = vStart.
     1480         publish "WaitFramPause" (iInterval,output vOk).
     1481         vend   =  now.
     1482         vint = vend - vStart.
     1483         vint = iInterval - vint / 1000.
     1484         if     not mWaitFramStop
     1485            and (   vint > 0
     1486                 or (    not vOk
     1487                     and iInterval eq ?
     1488                     )
     1489                 )
     1490         then
     1491            run waitfram-show-this (iInterval).
     1492         vend   =  now.
     1493         vint = vend - vStart.
     1494         vint = iInterval - vint / 1000.
     1495         if     not mWaitFramStop
     1496            and vint > 0
     1497         then do:
     1498            run gbl/pause.p (vint * 1000).
     1499         end.
     1500         if iInterval ne ?
     1501         then
     1502            publish "WaitFramStop".
     1503         waitfram-check-timeout().
     1504      end.
     1505      procedure WaitFramWaitFor:
     1506         define input  parameter iInterval as dec no-undo.
     1507         assign
     1508            mWaitFramStartProc   = now
     1509            mWaitFramStopUser    = no
     1510            mWaitFramStopTimeOut = no
     1511         .
     1512         block-wait:
     1513         do while not mWaitFramStop:
     1514            run WaitFramRunPause (iInterval).
     1515            if  waitfram-check-timeout()
     1516            then do:
     1517               leave block-wait.
     1518            end.
     1519         end.
     1520         run waitfram-hide.
     1521      end.
     1522   procedure waitfram-join :
     1523     define input  parameter p-line-1  as character no-undo .
     1524     define input  parameter p-line-2  as character no-undo .
     1525     define input  parameter p-line-3  as character no-undo .
     1526     define output parameter p-message as character no-undo .
     1527     do
     1528     on error undo, return error return-value
     1529     :
     1530       assign
     1531         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1532                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1533                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1534       .
     1535     end.
     1536   end procedure.
     1537   function waitfram-join-function returns character
     1538     (input p-line-1 as character
     1539     ,input p-line-2 as character
     1540     ,input p-line-3 as character
     1541     ).
     1542     define variable v-message as character no-undo .
     1543     run waitfram-join in this-procedure
     1544       (input  p-line-1
     1545       ,input  p-line-2
     1546       ,input  p-line-3
     1547       ,output v-message
     1548       ) .
     1549     return v-message .
     1550   end function .
