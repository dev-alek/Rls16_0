      213   procedure create_obj-list :
      214      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      215      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      216      do
      217      on error undo, return error return-value
      218      :
      219         define buffer cli-obj for ub.clients .
      220         define variable p-var as integer no-undo .
      221         define buffer buf_obj-list for obj-list .
      222         find last buf_obj-list  use-index pi no-error .
      223         if available buf_obj-list
      224         then
      225            p-var = buf_obj-list.obj-id + 1.
      226         else
      227            p-var = 1.
      228         find first cli-obj where
      229                   cli-obj.obj-type = p-obj-type
      230               and cli-obj.obj-code = p-obj-code
      231         no-lock no-error.
      232         if available cli-obj
      233         then do:
      234            create buf_obj-list.
      235            assign
      236               buf_obj-list.obj-id   = p-var
      237               buf_obj-list.obj-code = cli-obj.obj-code
      238               buf_obj-list.obj-type = cli-obj.obj-type
      239               buf_obj-list.obj-name = cli-obj.obj-name
      240               buf_obj-list.db-num   = cli-obj.db-num
      241            .
      242         end.
      243      end.
      244   end.
