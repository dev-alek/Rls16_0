     1757   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1758   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1759   def var vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   procedure gen-key-rec :
     1761     define input  parameter p-tbl-name    as character no-undo.
     1762     define input  parameter p-bh_tbl-name as handle    no-undo.
     1763     define output parameter p-key-rec     as character no-undo.
     1764     do
     1765     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1766     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1767     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1768     :
     1769       define variable fh               as handle    no-undo .
     1770       define variable v-ok             as logical   no-undo .
     1771       define variable v-inform         as character no-undo .
     1772       define variable v-ind            as integer   no-undo .
     1773       define variable v-idx-field-qnty as integer   no-undo .
     1774       if p-tbl-name = ?
     1775         or p-tbl-name = "":U
     1776       then do:
     1777         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info26 ).
     1778       end.
     1779       if not p-bh_tbl-name:available then do:
     1780         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info26, p-tbl-name ).
     1781       end.
     1782       assign
     1783         p-key-rec = p-tbl-name
     1784         v-inform  = p-bh_tbl-name:index-information(1)
     1785         v-ind     = 2
     1786       .
     1787       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1788       on error undo, return error
     1789       :
     1790         assign
     1791           v-inform = p-bh_tbl-name:index-information( v-ind )
     1792           v-ind    = v-ind + 1
     1793         .
     1794       end.
     1795       if v-inform = ?
     1796         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1797         or entry( 3, v-inform, ",":U ) <> "1":U
     1798       then do:
     1799         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, p-tbl-name ).
     1800       end.
     1801       else do:
     1802         assign
     1803           v-idx-field-qnty = num-entries( v-inform ) - 4
     1804         .
     1805         if v-idx-field-qnty < 2 then do:
     1806           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, p-tbl-name ).
     1807         end.
     1808         do v-ind = 1 to v-idx-field-qnty by 2
     1809         on error undo, return error
     1810         :
     1811           assign
     1812             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1813             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1814           .
     1815         end.
     1816       end.
     1817       if p-key-rec = ? then do:
     1818         assign
     1819           p-key-rec = "":U
     1820         .
     1821         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info26, p-tbl-name ).
     1822       end.
     1823     end.
     1824     return.
     1825   end procedure.
     1826   procedure gen-where-keyr-tab :
     1827     define input  parameter i-tableSerach as character no-undo.
     1828     define input  parameter i-tablekey   as character  no-undo.
     1829     define input  parameter p-key-rec    as character  no-undo.
     1830     define input  parameter p-key-handle as handle     no-undo .
     1831     define input  parameter p-db-name    as character  no-undo .
     1832     define input  parameter p-tt-handle  as handle     no-undo .
     1833     define output parameter o-Where      as character  no-undo.
     1834     do
     1835     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1836     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1837     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1838     :
     1839       define variable v-full-tbl-name  as character no-undo .
     1840       define variable bh_tbl-name      as handle    no-undo .
     1841       define variable fh_key           as handle    no-undo .
     1842       define variable fh_search        as handle    no-undo .
     1843       define variable v-field-num      as integer   no-undo .
     1844       define variable v-count-fld      as integer   no-undo .
     1845       define variable v-inform         as character no-undo .
     1846       define variable v-ind            as integer   no-undo .
     1847       define variable v-idx-field-qnty as integer   no-undo .
     1848       define variable v-field-name     as character no-undo .
     1849       define variable v-field-val      as character no-undo .
     1850       define variable v-word-link      as character no-undo .
     1851       define variable vTable           as character no-undo.
     1852       define variable bh_tbl-key       as handle    no-undo .
     1853       assign
     1854         p-key-rec = trim( p-key-rec )
     1855       .
     1856       if p-key-handle <> ? then do:
     1857         if not valid-handle(p-key-handle)
     1858            or p-key-handle:type <> "buffer"
     1859         then do:
     1860           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info26 ).
     1861         end.
     1862         if num-entries( p-key-rec, chr(3) ) > 1
     1863           or p-key-rec = ?
     1864           or p-key-rec = "":U
     1865         then do:
     1866           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info26, p-key-rec ).
     1867         end.
     1868       end.
     1869       else do:
     1870         if p-key-rec = ?
     1871           or p-key-rec = "":U
     1872         then do:
     1873           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info26 ).
     1874         end.
     1875       end.
     1876       assign
     1877         vTable = entry( 1 , p-key-rec, chr(3) )
     1878       .
     1879       if p-tt-handle <> ?
     1880         and ( not valid-handle(p-tt-handle)
     1881               or p-tt-handle:type <> "buffer"
     1882             )
     1883       then do:
     1884         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info26, vTable, chr(10) ).
     1885       end.
     1886       if p-tt-handle = ? then do:
     1887         assign
     1888           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1889         .
     1890         create buffer bh_tbl-name for table v-full-tbl-name .
     1891       end.
     1892       else do:
     1893         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1894       end.
     1895       assign
     1896         v-inform = bh_tbl-name:index-information(1)
     1897         v-ind    = 2
     1898       .
     1899       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1900       on error undo, return error
     1901       :
     1902         assign
     1903           v-inform = bh_tbl-name:index-information( v-ind )
     1904           v-ind    = v-ind + 1
     1905         .
     1906       end.
     1907       if v-inform = ?
     1908         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1909         or entry( 3, v-inform, ",":U ) <> "1":U
     1910       then do:
     1911         delete object bh_tbl-name no-error.
     1912         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info26, vTable ).
     1913       end.
     1914       assign
     1915         v-idx-field-qnty = num-entries( v-inform ) - 4
     1916       .
     1917       if v-idx-field-qnty < 2 then do:
     1918         delete object bh_tbl-name no-error.
     1919         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, vTable ).
     1920       end.
     1921       assign
     1922         o-where     = "where":U
     1923         v-word-link = "":U
     1924         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1925         v-count-fld = 0
     1926       .
     1927       if i-tablekey ne "" and i-tablekey ne ?
     1928       then do:
     1929         assign
     1930           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1931         .
     1932         create buffer bh_tbl-key for table v-full-tbl-name .
     1933       end.
     1934       if i-tableSerach ne "" and i-tableSerach ne ?
     1935       then do:
     1936         delete object bh_tbl-name no-error.
     1937         assign
     1938           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1939         .
     1940         create buffer bh_tbl-name for table v-full-tbl-name .
     1941       end.
     1942       block_where:
     1943       do v-ind = 1 to v-idx-field-qnty by 2
     1944       on error undo, return error
     1945       :
     1946         assign
     1947           v-count-fld = v-count-fld + 1
     1948         .
     1949         if p-key-handle = ?
     1950           and v-count-fld > v-field-num
     1951         then do:
     1952           leave block_where.
     1953         end.
     1954         define variable VfieldKeyTable as handle no-undo.
     1955         assign
     1956           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1957           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1958         .
     1959         if     bh_tbl-key ne ?
     1960         then do:
     1961            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1962            if VfieldKeyTable eq ?
     1963            then next block_where.
     1964         end.
     1965         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1966         then
     1967            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1968         else
     1969            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1970         if p-key-handle = ? then do:
     1971           assign
     1972             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1973           .
     1974         end.
     1975         else do:
     1976           assign
     1977             fh_key = p-key-handle:buffer-field( v-field-name )
     1978           .
     1979           if fh_key = ?
     1980             or not valid-handle( fh_key )
     1981           then do:
     1982             delete object bh_tbl-name.
     1983             if     bh_tbl-key ne ?
     1984             then
     1985                delete object bh_tbl-key.
     1986             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info26, p-key-handle:name, v-field-name ).
     1987           end.
     1988           assign
     1989             v-field-val = fh_key:buffer-value
     1990           .
     1991         end.
     1992         if fh_search:data-type ="character":U then do:
     1993           assign
     1994             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1995             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1996             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1997             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1998             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1999             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2000             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2001             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2002             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2003             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2004             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2005             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2006             v-field-val = substitute( '"&1"', v-field-val )
     2007           .
     2008         end.
     2009         assign
     2010           o-where = substitute( "&1 &2", o-where, v-field-val )
     2011         .
     2012         if v-word-link = "":U then do:
     2013           assign
     2014             v-word-link = "and":U
     2015           .
     2016         end.
     2017       end.
     2018       delete object bh_tbl-name.
     2019       if     bh_tbl-key ne ?
     2020       then
     2021          delete object bh_tbl-key.
     2022       if p-key-handle = ?
     2023         and v-count-fld <> v-field-num
     2024       then do:
     2025         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info26, vTable ).
     2026       end.
     2027     end.
     2028   end procedure.
     2029   procedure gen-hn-keyr-tab :
     2030     define input  parameter i-tableSerach as character no-undo.
     2031     define input  parameter i-tablekey   as character no-undo.
     2032     define input  parameter p-key-rec    as character no-undo.
     2033     define input  parameter p-key-handle as handle    no-undo .
     2034     define input  parameter p-db-name    as character no-undo .
     2035     define input  parameter p-tt-handle  as handle    no-undo .
     2036     define input  parameter p-stts-lock  as integer   no-undo .
     2037     define output parameter o-hn         as handle    no-undo.
     2038     define variable v-full-tbl-name as character no-undo.
     2039     define variable v-where         as character no-undo.
     2040     define variable bh_tbl-name     as handle    no-undo.
     2041     define variable vTable          as character no-undo.
     2042     do
     2043     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2044     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2045     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2046         run gen-where-keyr-tab(i-tableSerach,
     2047                                i-tablekey,
     2048                                p-key-rec,
     2049                                p-key-handle,
     2050                                p-db-name,
     2051                                p-tt-handle,
     2052                                output v-where).
     2053         if i-tableSerach ne "" and i-tableSerach ne ?
     2054         then do:
     2055            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2056            create buffer bh_tbl-name for table v-full-tbl-name .
     2057         end.
     2058         else do:
     2059            if p-tt-handle = ? then do:
     2060               assign
     2061                  vTable = entry( 1 , p-key-rec, chr(3) )
     2062               .
     2063               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2064               create buffer bh_tbl-name for table v-full-tbl-name .
     2065            end.
     2066            else do:
     2067               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2068            end.
     2069         end.
     2070         if p-tt-handle = ? then do:
     2071            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2072         end.
     2073         else do:
     2074            bh_tbl-name:find-first( v-where ) no-error .
     2075         end.
     2076         o-hn = bh_tbl-name.
     2077      end.
     2078   end procedure.
     2079   procedure gen-hn-keyr :
     2080     define input  parameter p-key-rec    as character no-undo.
     2081     define input  parameter p-key-handle as handle    no-undo .
     2082     define input  parameter p-db-name    as character no-undo .
     2083     define input  parameter p-tt-handle  as handle    no-undo .
     2084     define input  parameter p-stts-lock  as integer   no-undo .
     2085     define output parameter o-hn         as handle    no-undo.
     2086     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2087   end.
     2088   procedure gen-row-keyr :
     2089     define input  parameter p-key-rec    as character no-undo.
     2090     define input  parameter p-key-handle as handle    no-undo .
     2091     define input  parameter p-db-name    as character no-undo .
     2092     define input  parameter p-tt-handle  as handle    no-undo .
     2093     define input  parameter p-stts-lock  as integer   no-undo .
     2094     define output parameter p-tbl-row    as rowid     no-undo.
     2095     define output parameter p-tbl-name   as character no-undo.
     2096     define variable vHn as handle no-undo.
     2097       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2098       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2099       p-tbl-name =  vHn:table.
     2100       delete object vHn no-error.
     2101     if p-tbl-row = ? then do:
     2102       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info26, p-tbl-name, p-key-rec ).
     2103     end.
     2104     else do:
     2105       return.
     2106     end.
     2107   end procedure.
     2108   procedure gen-key-fv :
     2109     define input  parameter p-key-rec    as character no-undo .
     2110     define output parameter p-field-list as character no-undo .
     2111     define output parameter p-value-list as character no-undo.
     2112     do
     2113     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2114     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2115     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2116     :
     2117       define variable v-full-tbl-name  as character no-undo .
     2118       define variable bh_tbl-name      as handle    no-undo .
     2119       define variable v-tbl-name       as character no-undo .
     2120       define variable v-field-num      as integer   no-undo .
     2121       define variable v-count-fld      as integer   no-undo .
     2122       define variable v-inform         as character no-undo .
     2123       define variable v-ind            as integer   no-undo .
     2124       define variable v-idx-field-qnty as integer   no-undo .
     2125       define variable v-delim-key      as character no-undo .
     2126       if p-key-rec = ?
     2127         or p-key-rec = "":U
     2128       then do:
     2129         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info26 ).
     2130       end.
     2131       assign
     2132         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2133         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2134       .
     2135       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2136       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info26 ).
     2137       assign
     2138         v-inform = bh_tbl-name:index-information(1)
     2139         v-ind    = 2
     2140       .
     2141       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2142       on error undo, return error
     2143       :
     2144         assign
     2145           v-inform = bh_tbl-name:index-information( v-ind )
     2146           v-ind    = v-ind + 1
     2147         .
     2148       end.
     2149       if v-inform = ?
     2150         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2151         or entry( 3, v-inform, ",":U ) <> "1":U
     2152       then do:
     2153         delete object bh_tbl-name no-error.
     2154         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, v-tbl-name ).
     2155       end.
     2156       assign
     2157         v-idx-field-qnty = num-entries( v-inform ) - 4
     2158       .
     2159       if v-idx-field-qnty < 2 then do:
     2160         delete object bh_tbl-name no-error.
     2161         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, v-tbl-name ).
     2162       end.
     2163       assign
     2164         p-field-list = "":U
     2165         p-value-list = "":U
     2166         v-delim-key  = "":U
     2167         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2168         v-count-fld  = 0
     2169       .
     2170       block_where:
     2171       do v-ind = 1 to v-idx-field-qnty by 2
     2172       on error undo, return error
     2173       :
     2174         assign
     2175           v-count-fld = v-count-fld + 1
     2176         .
     2177         if v-count-fld > v-field-num then do:
     2178           leave block_where.
     2179         end.
     2180         assign
     2181           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2182           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2183         .
     2184         if v-ind = 1 then do:
     2185           assign
     2186             v-delim-key = chr(3)
     2187           .
     2188         end.
     2189       end.
     2190       delete object bh_tbl-name.
     2191       if v-count-fld <> v-field-num then do:
     2192         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info26, v-tbl-name ).
     2193       end.
     2194     end.
     2195   end procedure.
     2196   procedure gen-key-field :
     2197     define input  parameter p-table      as character no-undo .
     2198     define output parameter p-field-list as character no-undo .
     2199     do
     2200     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2201     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2202     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2203     :
     2204       define variable v-full-tbl-name  as character no-undo .
     2205       define variable bh_tbl-name      as handle    no-undo .
     2206       define variable v-tbl-name       as character no-undo .
     2207       define variable v-field-num      as integer   no-undo .
     2208       define variable v-count-fld      as integer   no-undo .
     2209       define variable v-inform         as character no-undo .
     2210       define variable v-ind            as integer   no-undo .
     2211       define variable v-idx-field-qnty as integer   no-undo .
     2212       define variable v-delim-key      as character no-undo .
     2213       if p-table = ?
     2214         or p-table = "":U
     2215       then do:
     2216         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info26 ).
     2217       end.
     2218       assign
     2219         v-tbl-name      = p-table
     2220         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2221       .
     2222       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2223       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info26 ).
     2224       assign
     2225         v-inform = bh_tbl-name:index-information(1)
     2226         v-ind    = 2
     2227       .
     2228       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2229       on error undo, return error
     2230       :
     2231         assign
     2232           v-inform = bh_tbl-name:index-information( v-ind )
     2233           v-ind    = v-ind + 1
     2234         .
     2235       end.
     2236       if v-inform = ?
     2237         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2238         or entry( 3, v-inform, ",":U ) <> "1":U
     2239       then do:
     2240         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, v-tbl-name ).
     2241       end.
     2242       assign
     2243         v-idx-field-qnty = num-entries( v-inform ) - 4
     2244       .
     2245       if v-idx-field-qnty < 2 then do:
     2246         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, v-tbl-name ).
     2247       end.
     2248       assign
     2249         p-field-list = "":U
     2250         v-delim-key  = "":U
     2251         v-count-fld  = 0
     2252       .
     2253       block_where:
     2254       do v-ind = 1 to v-idx-field-qnty by 2
     2255       on error undo, return error
     2256       :
     2257         assign
     2258           v-count-fld = v-count-fld + 1
     2259         .
     2260         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2261         if v-ind = 1 then do:
     2262           assign
     2263             v-delim-key = chr(3)
     2264           .
     2265         end.
     2266       end.
     2267       delete object bh_tbl-name.
     2268     end.
     2269   end procedure.
     2270   procedure get-gate-file-name :
     2271   define input parameter p-gate-rec as character no-undo .
     2272   define output  parameter p-gate-file-name as character no-undo .
     2273   define buffer buf_clob-data for ub.clob-data.
     2274   define variable v-tbl-row as rowid no-undo .
     2275   define variable v-tbl-name as character no-undo .
     2276   run gen-row-keyr in this-procedure ( input p-gate-rec
     2277                                       ,input ?
     2278                                       ,input "ub"
     2279                                       ,input ?
     2280                                       ,input no-lock
     2281                                       ,output v-tbl-row
     2282                                       ,output v-tbl-name) no-error.
     2283   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     2284                                                           ,vss-include-info24
     2285                                                           ,p-gate-rec).
     2286   find first buf_clob-data no-lock where
     2287             rowid(buf_clob-data) = v-tbl-row no-error.
     2288   if not available buf_clob-data then do:
     2289     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     2290                                                             ,vss-include-info24
     2291                                                             ,p-gate-rec).
     2292   end.
     2293   p-gate-file-name = buf_clob-data.file-name.
     2294   end procedure.
     2295   procedure get-gate-rec :
     2296   define input  parameter p-gate-name as character no-undo .
     2297   define output parameter p-gate-rec as character no-undo .
     2298   define buffer buf_clob-bind for ub.clob-bind.
     2299   define buffer buf_clob-data for ub.clob-data.
     2300   main-block:
     2301   do
     2302   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2303   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2304   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2305   :
     2306       find first buf_clob-bind no-lock where
     2307                 buf_clob-bind.uniq-key-rec = p-gate-name
     2308             and buf_clob-bind.field-name = '':U
     2309             and buf_clob-bind.part-num = 1
     2310             and buf_clob-bind.resource-type = 'gate':U
     2311             no-error.
     2312       if not available buf_clob-bind then do:
     2313         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2314                                         , p-gate-name
     2315                                         ).
     2316       end.
     2317       find first buf_clob-data no-lock where
     2318                 buf_clob-data.db-num = buf_clob-bind.db-num
     2319             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2320       if not available buf_clob-data then do:
     2321         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2322                                         , buf_clob-bind.db-num
     2323                                         , buf_clob-bind.int64-id
     2324                                         , p-gate-name
     2325                                         ).
     2326       end.
     2327       run gen-key-rec in this-procedure ( input 'clob-data':U
     2328                                 ,input buffer buf_clob-data:handle
     2329                                 ,output p-gate-rec).
     2330   end.
     2331   end procedure.
     2332   procedure get-gate-by-name :
     2333   define input  parameter p-gate-name as character no-undo .
     2334   define output parameter p-gate-rec as character no-undo .
     2335   define output parameter p-dsh as handle no-undo .
     2336   define input-output  parameter p-xmlh as handle no-undo .
     2337   define variable v-ii as integer   no-undo .
     2338   define variable glog as logical   no-undo .
     2339   define variable v-longchar as longchar no-undo .
     2340   define variable v-txmlh as handle no-undo .
     2341   define variable v-db-num as integer no-undo .
     2342   define variable v-int64-id as int64 no-undo .
     2343   define buffer buf_clob-bind for ub.clob-bind.
     2344   define buffer buf_clob-data for ub.clob-data.
     2345   main-block:
     2346   do
     2347   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2348   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2349   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2350   :
     2351       find first buf_clob-bind no-lock where
     2352                 buf_clob-bind.uniq-key-rec = p-gate-name
     2353             and buf_clob-bind.field-name = '':U
     2354             and buf_clob-bind.part-num = 1
     2355             and buf_clob-bind.resource-type = 'gate':U
     2356             no-error.
     2357       if not available buf_clob-bind then do:
     2358         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2359                                         , p-gate-name
     2360                                         ).
     2361       end.
     2362       find first buf_clob-data no-lock where
     2363                 buf_clob-data.db-num = buf_clob-bind.db-num
     2364             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2365       if not available buf_clob-data then do:
     2366         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2367                                         , buf_clob-bind.db-num
     2368                                         , buf_clob-bind.int64-id
     2369                                         , p-gate-name
     2370                                         ).
     2371       end.
     2372       assign
     2373       v-longchar = buf_clob-data.cdata
     2374       .
     2375       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2376       if error-status :error then do:
     2377         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2378       end.
     2379       create dataset p-dsh .
     2380       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2381                                     , v-longchar
     2382                                     , ?
     2383                                     , ?
     2384                                     , ?
     2385                                     ) no-error.
     2386       v-longchar = '':U.
     2387       if error-status :error
     2388       or not glog
     2389       then do:
     2390         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     2391       end.
     2392       if not valid-handle(p-xmlh)
     2393       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2394         create temp-table v-txmlh.
     2395         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2396         v-txmlh:temp-table-prepare("temp-xml-tables").
     2397         p-xmlh = v-txmlh:default-buffer-handle.
     2398       end.
     2399       run gen-key-rec in this-procedure ( input 'clob-data':U
     2400                                 ,input buffer buf_clob-data:handle
     2401                                 ,output p-gate-rec).
     2402       do v-ii = 1 to p-dsh:num-buffers:
     2403         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2404         if not p-xmlh:available then do:
     2405           p-xmlh:buffer-create().
     2406           assign
     2407           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2408           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2409           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2410           p-xmlh::gate-handle_ = p-dsh
     2411           p-xmlh::uniq-gate-rec = p-gate-rec
     2412           p-xmlh::gate-name = p-dsh:name
     2413           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2414           .
     2415           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2416             assign
     2417             p-xmlh::order = -3.
     2418           end.
     2419         end.
     2420       end.
     2421   end.
     2422   end procedure.
     2423   procedure get-gate-by-rec :
     2424   define input  parameter p-gate-rec as character no-undo .
     2425   define output parameter p-dsh as handle no-undo .
     2426   define input-output  parameter p-xmlh as handle no-undo .
     2427   define input-output parameter p-longchar  as longchar no-undo .
     2428   define variable v-ii as integer   no-undo .
     2429   define variable glog as logical   no-undo .
     2430   define variable v-rowid as rowid no-undo .
     2431   define variable v-tbl-name as character no-undo .
     2432   define variable v-longchar as longchar no-undo .
     2433   define variable v-txmlh as handle no-undo .
     2434   define buffer buf_clob-data for ub.clob-data.
     2435   main-block:
     2436   do
     2437   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2438   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2439   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2440   :
     2441     run gen-row-keyr in this-procedure (
     2442                                           input  p-gate-rec
     2443                                           ,input  ?
     2444                                           ,input  "ub"
     2445                                           ,input  ?
     2446                                           ,input  NO-LOCK
     2447                                           ,output v-rowid
     2448                                           ,output v-tbl-name   ) no-error.
     2449       find first buf_clob-data no-lock where
     2450                 rowid(buf_clob-data) = v-rowid  no-error.
     2451       if not available buf_clob-data then do:
     2452         undo, return error substitute("Не найден CLOB  &1"
     2453                                         , p-gate-rec
     2454                                         ).
     2455       end.
     2456       assign
     2457       v-longchar = buf_clob-data.cdata
     2458       .
     2459       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2460       if error-status :error then do:
     2461         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2462       end.
     2463       create dataset p-dsh .
     2464       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2465                                     , v-longchar
     2466                                     , ?
     2467                                     , ?
     2468                                     , ?
     2469                                     ) no-error.
     2470       define variable v-esm as character no-undo .
     2471       v-esm = error-status:get-message(1) .
     2472       if p-longchar <> ? then do:
     2473         p-longchar = v-longchar.
     2474       end.
     2475       v-longchar = '':U.
     2476       if error-status :error
     2477       or not glog
     2478       then do:
     2479         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2480                                      , p-gate-rec
     2481                                      , p-gate-rec
     2482                                      , v-esm
     2483                                      ).
     2484       end.
     2485       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2486       if not valid-handle(p-xmlh)
     2487       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2488         create temp-table v-txmlh.
     2489         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2490         v-txmlh:temp-table-prepare("temp-xml-tables").
     2491         p-xmlh = v-txmlh:default-buffer-handle.
     2492       end.
     2493       do v-ii = 1 to p-dsh:num-buffers:
     2494         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2495         if not p-xmlh:available then do:
     2496           p-xmlh:buffer-create().
     2497           assign
     2498           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2499           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2500           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2501           p-xmlh::gate-handle_ = p-dsh
     2502           p-xmlh::uniq-gate-rec = p-gate-rec
     2503           p-xmlh::gate-name = p-dsh:name
     2504           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2505           .
     2506           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2507             assign
     2508             p-xmlh::order = -3.
     2509           end.
     2510           p-xmlh:buffer-release().
     2511         end.
     2512       end.
     2513   end.
     2514   end procedure.
     2515   procedure get-gate-by-file :
     2516   define input  parameter p-schema-file-name as character no-undo .
     2517   define input  parameter p-gate-rec as character no-undo .
     2518   define output parameter p-dsh as handle no-undo .
     2519   define input-output  parameter p-xmlh as handle no-undo .
     2520   define variable v-ii as integer   no-undo .
     2521   define variable glog as logical   no-undo .
     2522   define variable v-rowid as rowid no-undo .
     2523   define variable v-tbl-name as character no-undo .
     2524   define variable v-longchar as longchar no-undo .
     2525   define variable v-txmlh as handle no-undo .
     2526   main-block:
     2527   do
     2528   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2529   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2530   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2531   :
     2532       COPY-LOB
     2533       FROM  FILE p-schema-file-name
     2534       TO  OBJECT v-longchar
     2535       no-convert
     2536       NO-ERROR .
     2537       if error-status :error then do:
     2538           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2539                                     , p-schema-file-name
     2540                                 , chr(10)
     2541                                 , error-status:get-message(1) ).
     2542       end.
     2543       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2544       if error-status :error then do:
     2545         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2546       end.
     2547       create dataset p-dsh .
     2548       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2549                                     , v-longchar
     2550                                     , ?
     2551                                     , ?
     2552                                     , ?
     2553                                     ) no-error.
     2554       v-longchar = ''.
     2555       if error-status :error
     2556       or not glog
     2557       then do:
     2558         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2559                                      , p-schema-file-name
     2560                                      ,chr(10)
     2561                                      , error-status:get-message(1)
     2562                                      ).
     2563       end.
     2564       if not valid-handle(p-xmlh)
     2565       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2566         create temp-table v-txmlh.
     2567         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2568         v-txmlh:temp-table-prepare("temp-xml-tables").
     2569         p-xmlh = v-txmlh:default-buffer-handle.
     2570       end.
     2571       do v-ii = 1 to p-dsh:num-buffers:
     2572         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2573                                      ,p-dsh:get-buffer-handle(v-ii):name
     2574                                      ,p-gate-rec
     2575                                      )) no-error.
     2576         if not p-xmlh:available then do:
     2577           p-xmlh:buffer-create().
     2578           assign
     2579           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2580           p-xmlh::uniq-gate-rec = p-gate-rec
     2581           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2582           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2583           p-xmlh::gate-handle_ = p-dsh
     2584           p-xmlh::gate-name = p-dsh:name
     2585           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2586           .
     2587           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2588             assign
     2589             p-xmlh::order = -3.
     2590           end.
     2591           p-xmlh:buffer-release().
     2592         end.
     2593       end.
     2594   end.
     2595   end procedure.
     2596   procedure gate-clear :
     2597   define input  parameter p-dsh as handle no-undo .
     2598   define input  parameter p-xmlh as handle no-undo .
     2599   define variable v-dsh as handle no-undo .
     2600   define variable v-th as handle no-undo .
     2601     do
     2602     on error undo, return error return-value
     2603     :
     2604       if valid-handle(p-dsh) then do:
     2605         delete object p-dsh.
     2606         v-dsh = p-dsh.
     2607         p-dsh = ?.
     2608       end.
     2609       repeat while true:
     2610         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2611                            , share-lock) no-error.
     2612         if p-xmlh:available then do:
     2613           assign
     2614           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2615           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2616           and valid-handle(v-th)
     2617           and v-th:dynamic = yes
     2618           then do:
     2619             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2620             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2621           end.
     2622           p-xmlh:buffer-delete().
     2623         end.
     2624         else do:
     2625           leave.
     2626         end.
     2627       end.
     2628       if p-xmlh:dynamic = yes
     2629       and valid-handle(p-xmlh)
     2630       then do:
     2631         delete object p-xmlh:table-handle.
     2632         p-xmlh = ?.
     2633       end.
     2634       v-dsh = ?.
     2635     end.
     2636   end procedure.
     2637   procedure all-gates-clear :
     2638   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     2639   do
     2640   on error undo, return error
     2641   :
     2642     for each buf_temp-xml-tables
     2643     break
     2644     by buf_temp-xml-tables.uniq-gate-rec
     2645     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2646     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2647     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2648     :
     2649         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     2650           delete object buf_temp-xml-tables.gate-handle_.
     2651           buf_temp-xml-tables.gate-handle_ = ?.
     2652         end.
     2653         if valid-handle(buf_temp-xml-tables.table-handle_)
     2654         and buf_temp-xml-tables.table-handle_:dynamic = no
     2655         then do:
     2656           delete object buf_temp-xml-tables.table-handle_.
     2657           buf_temp-xml-tables.table-handle_ = ?.
     2658         end.
     2659         delete buf_temp-xml-tables.
     2660     end.
     2661   end.
     2662   end procedure.
     2663   procedure fix-schemalocation :
     2664   define input-output  parameter p-longchar as longchar no-undo .
     2665   DEFINE VARIABLE hdoc AS HANDLE.
     2666   DEFINE VARIABLE hroot AS HANDLE.
     2667   DEFINE VARIABLE hnode-child AS HANDLE.
     2668   DEFINE VARIABLE hnode-attr AS HANDLE.
     2669   define variable v-jj as integer   no-undo .
     2670   define variable ok as logical   no-undo .
     2671   define variable v-path1                    as character                no-undo .
     2672   DEFINE VARIABLE v-full-path1               as character                no-undo .
     2673   DEFINE VARIABLE v-file-name1               as character                no-undo .
     2674   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     2675   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     2676   define variable v-schema-location          as character                no-undo .
     2677   do
     2678   on error undo, return error return-value
     2679   :
     2680     CREATE X-DOCUMENT hdoc.
     2681     CREATE X-noderef hroot.
     2682     CREATE X-noderef hnode-child.
     2683     CREATE X-noderef hnode-attr.
     2684     hdoc:load("longchar", p-longchar, no) no-error.
     2685     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     2686     hdoc:get-document-element(hroot).
     2687     _repeat:
     2688     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     2689       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     2690       if not ok then next.
     2691       if hNode-Child:local-name = "include"
     2692       then do:
     2693         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     2694           v-schema-location = hnode-attr:node-value.
     2695           run gbl/filename.p (
     2696                           input "exe/" + hnode-attr:node-value
     2697                         ,output v-full-path1
     2698                         ,output v-path1
     2699                         ,output v-file-name1
     2700                         ,output v-file-name-no-ext1
     2701                         ,output v-file-name-ext1
     2702                         ) no-error .
     2703           if error-status :error then do:
     2704             delete object hnode-attr.
     2705             delete object hnode-child.
     2706             delete object hroot.
     2707             delete object hdoc.
     2708             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     2709           end.
     2710         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     2711         leave  _repeat.
     2712       end.
     2713     END.
     2714     hdoc:save("longchar", p-longchar).
     2715     delete object hnode-attr.
     2716     delete object hnode-child.
     2717     delete object hroot.
     2718     delete object hdoc.
     2719   end.
     2720   end procedure.
     2721   procedure gate-clb_fill-xml-tables :
     2722   define input parameter p-dsh as handle no-undo .
     2723   define input-output parameter p-xmlh as handle no-undo .
     2724   define variable v-ii as integer no-undo .
     2725     do
     2726     on error undo, return error
     2727     :
     2728       do v-ii = 1 to p-dsh:num-buffers:
     2729         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2730         if not p-xmlh:available then do:
     2731           p-xmlh:buffer-create().
     2732           assign
     2733           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2734           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2735           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2736           p-xmlh::gate-handle_ = p-dsh
     2737           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     2738           p-xmlh::gate-name = p-dsh:name
     2739           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2740           .
     2741           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2742             assign
     2743             p-xmlh::order = -3.
     2744           end.
     2745           p-xmlh:buffer-release().
     2746         end.
     2747       end.
     2748     end.
     2749   end procedure.
     2750   procedure all-gates-empty :
     2751   define buffer buf_temp-xml-tables for temp-xml-tables.
     2752   do
     2753   on error undo, return error
     2754   :
     2755     for each buf_temp-xml-tables
     2756     break
     2757     by buf_temp-xml-tables.uniq-gate-rec
     2758     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2759     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2760     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2761     :
     2762       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     2763         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     2764       end.
     2765     end.
     2766   end.
     2767   end procedure.
     2768   define variable vss-include-info27 as character format "X(65)" no-undo
     2769   initial "@(#)$Workfile$ $Revision$".
     2770   define variable v-fmtcli-name          as character    no-undo.
     2771   define variable v-fmtcli-engl-name     as character    no-undo.
     2772   define variable v-fmtcli-addres        as character    no-undo.
     2773   define variable v-fmtcli-post-addres   as character    no-undo.
     2774   define variable v-fmtcli-full-addres   as character    no-undo.
     2775   define variable v-fmtcli-phone         as character    no-undo.
     2776   define variable v-fmtcli-inn           as character    no-undo.
     2777   define variable v-fmtcli-kpp           as character    no-undo.
     2778   define variable v-fmtcli-okpo          as character    no-undo.
     2779   define variable v-fmtcli-country       as character    no-undo.
     2780   define variable v-fmtcli-city          as character    no-undo.
     2781   define variable v-fmtcli-index         as character    no-undo.
     2782   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2783   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2784   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2785   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2786   define variable v-fmtcli-bank-bik      as character    no-undo.
     2787   define variable v-fmtcli-bank-name     as character    no-undo.
     2788   define variable v-fmtcli-bank-addres   as character    no-undo.
     2789   define variable v-fmtcli-bank-city     as character    no-undo.
     2790   procedure fmtcli-get-bank :
     2791   define input parameter p-host-code      as integer          no-undo.
     2792   define input parameter p-obj-type       as character        no-undo.
     2793   define input parameter p-obj-code       as integer          no-undo.
     2794   define input parameter p-curr-code      as integer          no-undo.
     2795       define buffer buf_fin-schet     for ub.fin-schet.
     2796       define buffer buf_fin-bank      for ub.fin-bank.
     2797   do
     2798   for buf_fin-schet
     2799     , buf_fin-bank
     2800   on error undo, return error
     2801   :
     2802       assign
     2803           v-fmtcli-schet-exists       = no
     2804           v-fmtcli-bank-exists        = no
     2805           v-fmtcli-bank-r-schet       = "":U
     2806           v-fmtcli-bank-c-schet       = "":U
     2807           v-fmtcli-bank-bik           = "":U
     2808           v-fmtcli-bank-name          = "":U
     2809           v-fmtcli-bank-addres        = "":U
     2810           v-fmtcli-bank-city          = "":U
     2811       .
     2812       search-for-schet:
     2813       for each buf_fin-schet no-lock
     2814          where buf_fin-schet.host-code = p-host-code
     2815            and buf_fin-schet.cli-type  = p-obj-type
     2816            and buf_fin-schet.cli-code  = p-obj-code
     2817            and buf_fin-schet.curr-code = p-curr-code
     2818       on error undo, return error
     2819       :
     2820           if buf_fin-schet.status_   = 'удал':U
     2821           then do:
     2822           end.
     2823           else do:
     2824               assign
     2825                   v-fmtcli-schet-exists   = yes
     2826                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2827                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2828               .
     2829               find first buf_fin-bank no-lock
     2830                    where buf_fin-bank.host-code = p-host-code
     2831                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2832               no-error.
     2833               if available buf_fin-bank
     2834               then do:
     2835                   assign
     2836                       v-fmtcli-bank-exists      = yes
     2837                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2838                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2839                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2840                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2841                   .
     2842               end.
     2843               else do:
     2844                   assign
     2845                       v-fmtcli-bank-exists    = no
     2846                       v-fmtcli-bank-bik       = "":U
     2847                       v-fmtcli-bank-name      = "":U
     2848                       v-fmtcli-bank-addres    = "":U
     2849                       v-fmtcli-bank-city      = "":U
     2850                   .
     2851               end.
     2852               leave search-for-schet.
     2853           end.
     2854       end.
     2855   end.
     2856   end procedure.
     2857   procedure fmtcli-get-client :
     2858   define input parameter p-obj-type       as character    no-undo.
     2859   define input parameter p-obj-code       as integer      no-undo.
     2860       define variable v-temp-fmtcli-address      as character     no-undo.
     2861       define variable v-num-country-city    as integer      no-undo.
     2862       define buffer buf_clients   for ub.clients.
     2863       define buffer buf_firm      for ub.firm.
     2864       define buffer buf_store     for ub.store.
     2865       define buffer buf_shop      for ub.shop.
     2866       define buffer buf_person    for ub.person.
     2867   do
     2868   for buf_clients
     2869     , buf_firm
     2870     , buf_store
     2871     , buf_shop
     2872     , buf_person
     2873   on error undo, return error
     2874   :
     2875       assign
     2876           v-fmtcli-name           = "":U
     2877           v-fmtcli-addres         = "":U
     2878           v-fmtcli-post-addres    = "":U
     2879           v-fmtcli-full-addres    = "":U
     2880           v-fmtcli-phone          = "":U
     2881           v-fmtcli-inn            = "":U
     2882           v-fmtcli-kpp            = "":U
     2883           v-fmtcli-okpo           = "":U
     2884           v-fmtcli-city           = "":U
     2885           v-fmtcli-index          = "":U
     2886           v-fmtcli-country        = "":U
     2887       .
     2888       find first buf_clients no-lock
     2889            where buf_clients.obj-type = p-obj-type
     2890              and buf_clients.obj-code = p-obj-code
     2891       .
     2892       assign
     2893           v-fmtcli-name = buf_clients.obj-name
     2894       .
     2895       case buf_clients.obj-type:
     2896          when 'орг':U
     2897          then do:
     2898               find first buf_firm no-lock
     2899                    where buf_firm.firm-code = buf_clients.obj-code
     2900                    no-error
     2901               .
     2902               if available buf_firm
     2903               then do:
     2904                   assign
     2905                       v-num-country-city = num-entries( buf_firm.city )
     2906                       v-fmtcli-engl-name = buf_firm.engl-name
     2907                   .
     2908                   if v-num-country-city > 0
     2909                   then do:
     2910                       assign
     2911                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2912                       .
     2913                   end.
     2914                   if v-num-country-city > 1
     2915                   then do:
     2916                       assign
     2917                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2918                       .
     2919                   end.
     2920                   run fmtcli-concatenate-strings in this-procedure (
     2921                         input v-fmtcli-full-addres
     2922                       , input v-fmtcli-country
     2923                       , input ", ":U
     2924                       , input 50
     2925                       , output v-fmtcli-full-addres
     2926                   ).
     2927                   run fmtcli-concatenate-strings in this-procedure (
     2928                         input v-fmtcli-full-addres
     2929                       , input v-fmtcli-city
     2930                       , input ", ":U
     2931                       , input 50
     2932                       , output v-fmtcli-full-addres
     2933                   ).
     2934                   run fmtcli-concatenate-strings in this-procedure (
     2935                         input v-fmtcli-full-addres
     2936                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2937                       , input ", ":U
     2938                       , input 50
     2939                       , output v-fmtcli-full-addres
     2940                   ).
     2941                   run fmtcli-concatenate-strings in this-procedure (
     2942                         input v-fmtcli-post-addres
     2943                       , input v-fmtcli-country
     2944                       , input ", ":U
     2945                       , input 50
     2946                       , output v-fmtcli-post-addres
     2947                   ).
     2948                   run fmtcli-concatenate-strings in this-procedure (
     2949                         input v-fmtcli-post-addres
     2950                       , input v-fmtcli-city
     2951                       , input ", ":U
     2952                       , input 50
     2953                       , output v-fmtcli-post-addres
     2954                   ).
     2955                   run fmtcli-concatenate-strings in this-procedure (
     2956                         input v-fmtcli-post-addres
     2957                       , input string( buf_firm.ind )
     2958                       , input ", ":U
     2959                       , input 50
     2960                       , output v-fmtcli-post-addres
     2961                   ).
     2962                   run fmtcli-concatenate-strings in this-procedure (
     2963                         input substring( buf_firm.addres1, 1, 50 )
     2964                       , input buf_firm.addres2
     2965                       , input " ":U
     2966                       , input 50
     2967                       , output v-temp-fmtcli-address
     2968                   ).
     2969                   run fmtcli-concatenate-strings in this-procedure (
     2970                         input v-temp-fmtcli-address
     2971                       , input substring( buf_firm.addres1, 51, 50 )
     2972                       , input " ":U
     2973                       , input 50
     2974                       , output v-temp-fmtcli-address
     2975                   ).
     2976                   run fmtcli-concatenate-strings in this-procedure (
     2977                         input v-temp-fmtcli-address
     2978                       , input substring( buf_firm.addres1, 101, 50 )
     2979                       , input " ":U
     2980                       , input 50
     2981                       , output v-temp-fmtcli-address
     2982                   ).
     2983                   assign
     2984                       v-fmtcli-addres = v-temp-fmtcli-address
     2985                   .
     2986                   if buf_firm.addres1 <> ?
     2987                   then do:
     2988                       run fmtcli-concatenate-strings in this-procedure (
     2989                             input v-fmtcli-full-addres
     2990                           , input v-fmtcli-addres
     2991                           , input ", ":U
     2992                           , input 0
     2993                           , output v-fmtcli-full-addres
     2994                       ).
     2995                   end.
     2996                   run fmtcli-concatenate-strings in this-procedure (
     2997                         input substring( buf_firm.post-addr1, 1, 50 )
     2998                       , input buf_firm.post-addr2
     2999                       , input " ":U
     3000                       , input 50
     3001                       , output v-fmtcli-post-addres
     3002                   ).
     3003                   run fmtcli-concatenate-strings in this-procedure (
     3004                         input v-fmtcli-post-addres
     3005                       , input substring( buf_firm.post-addr1, 51, 50 )
     3006                       , input " ":U
     3007                       , input 50
     3008                       , output v-fmtcli-post-addres
     3009                   ).
     3010                   run fmtcli-concatenate-strings in this-procedure (
     3011                         input v-fmtcli-post-addres
     3012                       , input substring( buf_firm.post-addr1, 101, 50 )
     3013                       , input " ":U
     3014                       , input 50
     3015                       , output v-fmtcli-post-addres
     3016                   ).
     3017                   assign
     3018                       v-fmtcli-phone         = buf_firm.phone
     3019                       v-fmtcli-inn           = buf_firm.inn
     3020                       v-fmtcli-kpp           = buf_firm.kpp
     3021                       v-fmtcli-okpo          = buf_firm.okpo
     3022                       v-fmtcli-index         = string( buf_firm.ind )
     3023                   .
     3024               end.
     3025          end.
     3026          when 'маг':U
     3027          then do:
     3028               find first buf_shop no-lock
     3029                    where buf_shop.obj-code = buf_clients.obj-code
     3030               .
     3031               if available buf_shop
     3032               then do:
     3033                   run fmtcli-concatenate-strings in this-procedure (
     3034                         input buf_shop.addres1
     3035                       , input buf_shop.addres2
     3036                       , input " ":U
     3037                       , input 50
     3038                       , output v-fmtcli-addres
     3039                   ).
     3040                   assign
     3041                       v-fmtcli-full-addres = v-fmtcli-addres
     3042                       v-fmtcli-post-addres = v-fmtcli-addres
     3043                       v-fmtcli-phone       = buf_shop.phone
     3044                       v-fmtcli-inn         = "":U
     3045                       v-fmtcli-kpp         = "":U
     3046                       v-fmtcli-okpo        = "":U
     3047                       v-fmtcli-city        = "":U
     3048                       v-fmtcli-index       = "":U
     3049                   .
     3050               end.
     3051          end.
     3052          when 'скл':U
     3053          then do:
     3054               find first buf_store no-lock
     3055                    where buf_store.obj-code = buf_clients.obj-code
     3056               .
     3057               if available buf_store
     3058               then do:
     3059                   run fmtcli-concatenate-strings in this-procedure (
     3060                         input buf_store.addres1
     3061                       , input buf_store.addres2
     3062                       , input " ":U
     3063                       , input 50
     3064                       , output v-fmtcli-addres
     3065                   ).
     3066                   assign
     3067                       v-fmtcli-full-addres = v-fmtcli-addres
     3068                       v-fmtcli-phone       = buf_store.phone
     3069                       v-fmtcli-inn         = "":U
     3070                       v-fmtcli-kpp         = "":U
     3071                       v-fmtcli-okpo        = "":U
     3072                       v-fmtcli-city        = "":U
     3073                       v-fmtcli-index       = "":U
     3074                   .
     3075               end.
     3076          end.
     3077          when 'чел':U
     3078          then do:
     3079               find first buf_person no-lock
     3080                    where buf_person.psn-code = buf_clients.obj-code
     3081               .
     3082               if available buf_person
     3083               then do:
     3084                   run fmtcli-concatenate-strings in this-procedure (
     3085                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     3086                                 then "":U
     3087                                 else string( buf_person.ind, "999999")
     3088                                 )
     3089                       , input buf_person.city
     3090                       , input ", ":U
     3091                       , input 0
     3092                       , output v-fmtcli-full-addres
     3093                   ).
     3094                   assign
     3095                       v-fmtcli-addres = buf_person.address
     3096                   .
     3097                   run fmtcli-concatenate-strings in this-procedure (
     3098                         input v-fmtcli-full-addres
     3099                       , input v-fmtcli-addres
     3100                       , input ", ":U
     3101                       , input 0
     3102                       , output v-fmtcli-full-addres
     3103                   ).
     3104                   assign
     3105                       v-fmtcli-phone     = buf_person.phone1
     3106                       v-fmtcli-inn       = buf_person.inn
     3107                       v-fmtcli-kpp       = buf_person.kpp
     3108                       v-fmtcli-okpo      = buf_person.okpo
     3109                       v-fmtcli-city      = buf_person.city
     3110                       v-fmtcli-index     = string( buf_person.ind )
     3111                   .
     3112               end.
     3113          end.
     3114       end case.
     3115   end.
     3116   end procedure.
     3117   procedure fmtcli-concatenate-strings :
     3118   define input parameter p-string-1       as character        no-undo.
     3119   define input parameter p-string-2       as character        no-undo.
     3120   define input parameter p-delimiter      as character        no-undo.
     3121   define input parameter p-length         as integer          no-undo.
     3122   define output parameter p-out-string    as character        no-undo.
     3123   do
     3124   on error undo, return error
     3125   :
     3126       assign
     3127           p-out-string = ( if p-string-1 = ?
     3128                            then "":U
     3129                            else trim( p-string-1 ) )
     3130       .
     3131       assign
     3132           p-out-string = p-out-string
     3133                        + ( if p-out-string = "":U
     3134                            or length( p-out-string ) = p-length
     3135                            or p-string-2 = ?
     3136                            or trim( p-string-2 ) = "":U
     3137                            then "":U
     3138                            else p-delimiter )
     3139                        + ( if p-string-2 = ?
     3140                            or trim( p-string-2 ) = "":U
     3141                            then "":U
     3142                            else trim( p-string-2 ) )
     3143       .
     3144   end.
     3145   end procedure.
