     4471                                                   ) no-error.
     4472       if error-status:error then do:
     4473               if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input return-value).    end.    else do:       run write-to-log in p-log-handle ( input return-value).    end.
     4474     end.
     4475   end.
     4476   end.
     4477   if p-report-id  = "53/2040" then do:
     4478     run print-to-dataset in this-procedure .
     4479   end .
     4480   procedure first-line :
     4481     define input parameter  vartog as integer no-undo .
     4482     PUT STREAM PrnLibstream UNFORMATTED
     4483       string(v-host-name,"x(60)")      at 1                                      "СТАРШИЙ СМЕНЫ: " at 134 for-mng    at 150
     4484       string(store-name,"x(60)") at 1  "С М Е Н Н Ы Й  О Т Ч Е Т"    at 87       "ОПЕРАТОРЫ: "     at 138 for-opers1 at 150
     4485                       "Ч А С Т Ь  № " + string( vartog )         at 94                                for-opers2 at 150
     4486     .
     4487     find first temp-shift-obj  where temp-shift-obj.num = 1 .
     4488     if v-count = 1 then do:
     4489       PUT STREAM PrnLibstream UNFORMATTED
     4490         "СМЕНА:" + string (temp-shift-obj.shift-name) + " ОТ " + String( v-open-date , "99/99/9999") + ' ' + String ( v-open-time,"hh:mm")  at 85
     4491         "СМЕНА ЗАКРЫТА: " + string( v-close-date,"99/99/9999") + " " +  string(v-close-time,"hh:mm")        at 84 skip
     4492       .
     4493     end.
     4494     else do:
     4495       PUT STREAM PrnLibstream UNFORMATTED
     4496         "СМЕНЫ С: " + string (temp-shift-obj.shift-name) + " ОТ " + String( temp-shift-obj.open-date , "99/99/9999") + ' ' + String ( temp-shift-obj.open-time,"hh:mm")  at 85  skip
     4497       .
     4498       find first temp-shift-obj where temp-shift-obj.num = v-count .
     4499       PUT STREAM PrnLibstream UNFORMATTED
     4500         "ПО: " + string (temp-shift-obj.shift-name) + " ОТ " + String( temp-shift-obj.open-date , "99/99/9999") + ' ' + String ( temp-shift-obj.open-time,"hh:mm") +
     4501         " ЗАКРЫТА " + string( temp-shift-obj.close-date,"99/99/9999") + " " +  string(temp-shift-obj.close-time,"hh:mm")     at 90      skip
     4502       .
     4503     end.
     4504   End procedure.
     4505   procedure last-line-XL :
     4506      if Make-Excel then  put   stream ForExcel unformatted
     4507         skip(2)
     4508         "Смену сдал" CHR(9)   fill("_":U, 21) CHR(9) CHR(9) "Смену принял"  CHR(9)  fill("_":U, 21)  skip
     4509         .
     4510   End procedure.
     4511   procedure xl-shift-str :
     4512   define output parameter p-str as character no-undo .
     4513   do
     4514   on error undo, return error return-value
     4515   :
     4516     find first temp-shift-obj
     4517       where temp-shift-obj.num = 1
     4518       .
     4519     if v-count = 1 then do:
     4520       assign
     4521         p-str = substitute( "Смена: &1 от &2 &3. Смена закрыта: &4 &5"
     4522                             ,string( temp-shift-obj.shift-name )
     4523                             ,string( temp-shift-obj.open-date , "99/99/9999" )
     4524                             ,string( temp-shift-obj.open-time , "HH:MM" )
     4525                             ,string( temp-shift-obj.close-date , "99/99/9999" )
     4526                             ,string( temp-shift-obj.close-time , "HH:MM" )
     4527                           )
     4528       .
     4529     end.
     4530     else do:
     4531       assign
     4532         p-str = substitute( "Смены с &1 от &2 &3 закрытой &4 &5"
     4533                             ,string( temp-shift-obj.shift-name )
     4534                             ,string( temp-shift-obj.open-date , "99/99/9999" )
     4535                             ,string( temp-shift-obj.open-time , "HH:MM" )
     4536                             ,string( temp-shift-obj.close-date , "99/99/9999" )
     4537                             ,string( temp-shift-obj.close-time , "HH:MM" )
     4538                           )
     4539       .
     4540       find first temp-shift-obj
     4541         where temp-shift-obj.num = v-count
     4542         .
     4543       assign
     4544         p-str = substitute( "&1 по &2 от &3 &4 закрытой &5 &6"
     4545                             ,p-str
     4546                             ,string( temp-shift-obj.shift-name )
     4547                             ,string( temp-shift-obj.open-date , "99/99/9999" )
     4548                             ,string( temp-shift-obj.open-time , "HH:MM" )
     4549                             ,string( temp-shift-obj.close-date , "99/99/9999" )
     4550                             ,string( temp-shift-obj.close-time , "HH:MM" )
     4551                           )
     4552       .
     4553     end.
     4554   end.
     4555   end procedure.
     4556   procedure print-to-dataset :
     4557   define variable glog as logical no-undo .
     4558   define buffer buf_temp-xml-tables for temp-xml-tables.
     4559   if p-report-id  = "53/2040" then do:
     4560   _xml-tables:
     4561   for each buf_temp-xml-tables:
     4562     case buf_temp-xml-tables.tbl-name:
     4563       when "shift" then do:
     4564         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     4565                                                         buffer shiftt:handle
     4566                                                       , yes
     4567                                                       , no
     4568                                                       , yes
     4569                                                       ) no-error.
     4570       end.
     4571       when "shift-pgds" then do:
     4572         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     4573                                                         buffer shift-pgdst:handle
     4574                                                       , yes
     4575                                                       , no
     4576                                                       , yes
     4577                                                       ) no-error.
     4578       end.
     4579       when "shift-pgds-in" then do:
     4580         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     4581                                                         buffer shift-pgds-int:handle
     4582                                                       , yes
     4583                                                       , no
     4584                                                       , yes
     4585                                                       ) no-error.
     4586       end.
     4587       when "shift-pgds-out" then do:
     4588         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     4589                                                         buffer shift-pgds-outt:handle
     4590                                                       , yes
     4591                                                       , no
     4592                                                       , yes
     4593                                                       ) no-error.
     4594       end.
     4595       when "shift-grp" then do:
     4596         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     4597                                                         buffer shift-grpt:handle
     4598                                                       , yes
     4599                                                       , no
     4600                                                       , yes
     4601                                                       ) no-error.
     4602       end.
     4603       when "shift-grp-in" then do:
     4604         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     4605                                                         buffer shift-grp-int:handle
     4606                                                       , yes
     4607                                                       , no
     4608                                                       , yes
     4609                                                       ) no-error.
     4610       end.
     4611       when "shift-grp-out" then do:
     4612         glog = buf_temp-xml-tables.tbl-handle:copy-temp-table(
     4613                                                         buffer shift-grp-outt:handle
     4614                                                       , yes
     4615                                                       , no
     4616                                                       , yes
     4617                                                       ) no-error.
     4618       end.
     4619       otherwise do:
     4620         next _xml-tables.
     4621       end.
     4622     end case.
     4623     if error-status:error
     4624     or not glog
     4625     then do:
     4626       if v-write-xml-error then do:
     4627         run cb_write-report-error in p-parent-handle ( input p-rebh
     4628                                                       ,input p-report-id
     4629                                                       ,input ?
     4630                                                       ,input '3':U
     4631                                                       ,input substitute("Ошибка при сохранении в отчет данных по &1&2 смена от &3 П.&4 - таблица &8&5&6&5&7&5"
     4632                                                                        , p-obj-type
     4633                                                                        , p-obj-code
     4634                                                                        , X-date-end
     4635                                                                        , X-shift-end
     4636                                                                        , chr(10)
     4637                                                                        , error-status:get-message(1)
     4638                                                                        , return-value
     4639                                                                        , buf_temp-xml-tables.tbl-name
     4640                                                                        )).
     4641       end.
     4642     end.
     4643   end.
     4644   end.
     4645   end procedure.
