      409   procedure grp-obj-notcorr-value :
      410   do
      411   on error undo, return error
      412   :
      413   define input parameter p-node-code             as integer      no-undo.
      414   define input parameter p-obj-type              as character    no-undo.
      415   define input parameter p-obj-code              as integer      no-undo.
      416   define output parameter p-notcorr              as character    no-undo init ?.
      417   define output parameter p-range-notcorr     as integer      no-undo.
      418   define output parameter p-exists-notcorr    as logical      no-undo.
      419   define variable v-host-code as integer      no-undo.
      420   DEFINE VARIABLE v-found as logical no-undo .
      421   DEFINE VARIABLE v-exists as logical no-undo .
      422   DEFINE VARIABLE v-range as integer no-undo .
      423   DEFINE VARIABLE jj as integer no-undo .
      424   DEFINE VARIABLE v-notcorr-found as logical no-undo .
      425   DEFINE VARIABLE v-notcorr-value as char      no-undo.
      426   define buffer buf_gds-grp for ub.gds-grp.
      427   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      428   find first buf_gds-grp no-lock where
      429              buf_gds-grp.node-code = p-node-code no-error .
      430   if not avail buf_gds-grp and p-node-code <> 0 then do:
      431     message
      432       vss-workfile vss-revision vss-description
      433       skip "Не удалось найти группу товаров с кодом" p-node-code
      434       view-as alert-box error .
      435     undo, return error .
      436   end.
      437   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      439     (input  p-obj-type
      440     ,input  p-obj-code
      441     ,output v-host-code
      442     ) no-error .
      443   if error-status :error
      444   then do:
      445       message
      446         vss-workfile vss-revision vss-description
      447         skip "Не удалось найти фирму объекта"
      448         skip p-obj-type p-obj-code
      449         skip return-value
      450         skip trim(error-status :get-message(1))
      451       view-as alert-box error.
      452       undo, return error .
      453   end.
      454   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      455   do while v-found = no and jj < 2:
      456     if v-range <> 3 then do:
      457       find first buf_gds-grp-obj no-lock
      458           where buf_gds-grp-obj.node-code = p-node-code
      459             and buf_gds-grp-obj.host-code = v-host-code
      460             and buf_gds-grp-obj.obj-type  = p-obj-type
      461             and buf_gds-grp-obj.obj-code  = p-obj-code
      462       no-error .
      463     end.
      464     if v-range = 3 or not available buf_gds-grp-obj
      465     then do:
      466        if v-range <> 2 then do:
      467           find first buf_gds-grp-obj no-lock
      468               where buf_gds-grp-obj.node-code = p-node-code
      469                 and buf_gds-grp-obj.host-code = v-host-code
      470                 and buf_gds-grp-obj.obj-type  = ""
      471                 and buf_gds-grp-obj.obj-code  = 0
      472           no-error .
      473         end.
      474         if v-range = 2 or not available buf_gds-grp-obj
      475         then do:
      476             if v-range <> 1 then do:
      477               find first buf_gds-grp-obj no-lock
      478                   where buf_gds-grp-obj.node-code = p-node-code
      479                   and buf_gds-grp-obj.host-code = 0
      480                   and buf_gds-grp-obj.obj-type  = ""
      481                   and buf_gds-grp-obj.obj-code  = 0
      482               no-error .
      483             end.
      484             if v-range = 1 or not available buf_gds-grp-obj
      485             then do:
      486                 assign
      487                     v-exists = no
      488                 .
      489             end.
      490             else do:
      491                 assign
      492                     v-exists = yes
      493                     v-range = 1
      494                 .
      495             end.
      496         end.
      497         else do:
      498             assign
      499                 v-exists = yes
      500                 v-range  = 2
      501             .
      502         end.
      503     end.
      504     else do:
      505         assign
      506             v-exists = yes
      507             v-range  = 3
      508         .
      509     end.
      510     if available buf_gds-grp-obj
      511     then do:
      512       find first buf_gds-grp-obj-attr no-lock
      513         where buf_gds-grp-obj-attr.node-code   = p-node-code
      514           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
      515           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
      516           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
      517           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
      518         no-error .
      519       if available buf_gds-grp-obj-attr then do:
      520         assign
      521           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
      522         .
      523       end.
      524       else do:
      525         assign
      526           v-notcorr-value = ?
      527         .
      528       end.
      529       assign
      530       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
      531                           then yes
      532                           else p-exists-notcorr)
      533       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
      534                         then v-range
      535                         else p-range-notcorr
      536       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
      537                         then v-notcorr-value
      538                         else p-notcorr
      539       v-found =  (p-exists-notcorr ) or (v-range <= 1)
      540       jj = jj + 1
      541       .
      542     end.
      543     else do:
      544       assign
      545       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
      546       jj = jj + 1
      547       .
      548     end.
      549   end.
      550   end.
      551   end procedure.
      552   define variable v-curr-r-b   as character no-undo .
      553   define variable v-cli-type   as character no-undo .
      554   define variable v-cli-code   as integer   no-undo .
