      581   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
      582   define buffer ras-doc         for ub.trn-doc.
      583   define buffer buf_chk-discnt  for ub.chk-discnt.
      584   define buffer buf_chk-discnt2 for ub.chk-discnt .
      585   define buffer buf_chk-gds     for ub.chk-gds.
      586   define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      587   define buffer buf_doc-line    for ub.doc-line .
      588   DEFINE BUFFER b-treal-2       for treal-2.
      589   DEFINE BUFFER bf-treal-2      for treal-2.
      590   DEFINE BUFFER b-treal-3       for treal-3.
      591   DEFINE BUFFER bf-treal-3      for treal-3.
      592   DEFINE BUFFER b-treal-4       for treal-4.
      593   DEFINE BUFFER bf-treal-4      for treal-4.
      594   define buffer buf_t-3         for t-3.
      595   define buffer cp-gds-treal-8  for treal-8.
      596   define buffer gds-treal-8     for treal-8.
      597   define buffer cp-treal-8      for treal-8.
      598   define buffer cli-treal-8     for treal-8.
      599   define TEMP-TABLE treal-2_1 LIKE treal-2 .
      600   define TEMP-TABLE treal-3_1 LIKE treal-3 .
      601   define TEMP-TABLE treal-4_1 LIKE treal-4 .
      602   define buffer ret-doc         for ub.trn-doc.
      603   function calcDensity returns decimal private
      604   (input p-str-chk-type as character // string(ub.chk-doc.chk-type)
      605   ,input p-doc-code     as character //        v-doc-code
      606   ,input p-out-code     as character //        ub.chk-doc.out-code
      607   ,input p-artic        as character //        buf_goods.artic
      608   ,input p-prod-type    as character //        buf_goods.prod-type
      609   ,input p-prod-code    as integer   //        buf_goods.prod-code
      610   ) :
      611   define variable v-density as decimal no-undo .
      612   define buffer buf_doc-line    for ub.doc-line.
      613     v-density = 0 .
      614         if lookup(p-str-chk-type, '6,96':U) > 0 then do:
      615           for each ret-doc fields( ret-doc.doc-code ret-doc.out-code ) no-lock
      616              where ret-doc.out-code = p-out-code,
      617              first buf_doc-line no-lock
      618              where buf_doc-line.doc-code  = ret-doc.doc-code
      619                AND buf_doc-line.artic     = p-artic
      620                AND buf_doc-line.prod-type = p-prod-type
      621                AND buf_doc-line.prod-code = p-prod-code :
      622             v-density = buf_doc-line.fact-density .
      623             leave.
      624           end.
      625         end .
      626         else do:
      627           find first buf_doc-line no-lock
      628                where buf_doc-line.doc-code  = p-doc-code
      629                  and buf_doc-line.artic     = p-artic
      630                  and buf_doc-line.prod-type = p-prod-type
      631                  and buf_doc-line.prod-code = p-prod-code  no-error.
      632           if available buf_doc-line then v-density = buf_doc-line.fact-density .
      633         end.
      634     return v-density .
      635   end function .
      636   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      637     (input  'accsup'
      638     ,input  ''
      639     ,input  ''
      640     ,input  0
      641     ,input  ''
      642     ,input  ''
      643     ,input  ''
      644     ,input  no
      645     ,output v-p-accsup
      646     ,output v-type
      647     ) no-error .
      648   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      649   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      650     (output v-curr-r-b
      651     )  .
