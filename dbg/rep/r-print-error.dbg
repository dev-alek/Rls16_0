      179     .
      180   define input parameter pdoc-id  as integer no-undo .
      181   define input parameter pdb-num  as integer no-undo .
      182   define input parameter table for tt-utd-err .
      183   define new global shared variable g#language as character no-undo .
      184   if g#language <> '' and g#language <> 'rus':U then do:
      185     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      186   end.
      187   define new global shared variable g#library  as handle no-undo .
      188   define new global shared variable g#library2 as handle no-undo .
      189   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      190   define  stream PrnLibStream.
      191   procedure prn-lib-prn-file :
      192     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      193     define input parameter p-DIsabledoptions as integer no-undo .
      194     define variable v-report-name as character no-undo .
      195     define variable v-user-action as character no-undo .
      196     define variable v-printed     as logical   no-undo .
      197     define variable v-exist       as logical   no-undo .
      198     do
      199       on error undo, return error
      200       :
      201       run prn-lib-get-report-name  in this-procedure (
      202         input parParentProc
      203         ,output v-report-name
      204         ).
      205   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      206   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      207     (input  v-report-name
      208     ,input  2
      209     ,output v-exist
      210     )  .
      211       if NOT v-exist then
      212       DO:
      213         Message
      214           "Нет заданий на печать ! "
      215           view-as alert-box .
      216         Return  .
      217       End.
      218       run gbl/prnfilen.w
      219         (input  ""
      220         ,input  p-DisabledOptions
      221         ,input  string(v-report-name )
      222         ,input  7
      223         ,output v-user-action
      224         ,output v-printed
      225         ) .
      226       if v-printed then
      227       do:
      228         return "YES" .
      229       end.
      230       else
      231       do:
      232         return "NO" .
      233       end.
      234     end.
      235   end procedure.
      236   procedure prn-lib-open-stream :
      237     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      238     define input parameter p-page-size    as integer no-undo .
      239     define input parameter p-is-stream    as logical no-undo .
      240     define input parameter p-append       as logical no-undo .
      241     define variable v-report-name as character no-undo .
      242     do
      243       on error undo, return error
      244       :
      245       run prn-lib-get-report-name  in this-procedure (
      246         input parParentProc
      247         ,output v-report-name
      248         ).
      249       if p-is-stream then
      250       do:
      251         if p-append then
      252         do:
      253           output stream PrnLibStream to value( v-report-name )
      254             page-size value(p-page-size) append .
      255         end.
      256         if not p-append then
      257         do:
      258           output stream PrnLibStream to value( v-report-name )
      259             page-size value(p-page-size) .
      260         end.
      261       end.
      262       if not p-is-stream then
      263       do:
      264         if p-append then
      265         do:
      266           output to value( v-report-name )
      267             page-size value(p-page-size) append .
      268         end.
      269         if not p-append then
      270         do:
      271           output to value( v-report-name )
      272             page-size value(p-page-size) .
      273         end.
      274       end.
      275     end.
      276   end procedure.
      277   procedure prn-lib-open-exp :
      278     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      279     define input parameter p-is-stream    as logical no-undo .
      280     define input parameter p-is-append    as logical no-undo .
      281     define output parameter p-ReportFileName as char init "report" no-undo.
      282     define output parameter p-process as logical no-undo .
      283     define variable glog as logical no-undo .
      284     do
      285       on error undo, return error
      286       :
      287       SYSTEM-DIALOG GET-FILE p-ReportFileName
      288         TITLE      "Укажите путь"
      289         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      290         ASK-OVERWRITE
      291         CREATE-TEST-FILE
      292         SAVE-AS
      293         USE-FILENAME
      294         DEFAULT-EXTENSION "txt"
      295         UPDATE glog
      296         .
      297       if not glog then  return.
      298       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      299       if p-is-stream then
      300       do:
      301         if p-is-append then
      302         do:
      303           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      304         end.
      305         else
      306         do:
      307           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      308         end.
      309       end.
      310       else
      311       do:
      312         if p-is-append then
      313         do:
      314           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      315         end.
      316         else
      317         do:
      318           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      319         end.
      320       end.
      321       p-process = yes.
      322     end.
      323   end procedure.
      324   procedure prn-lib-get-report-name :
      325     define input parameter parParentProc  as widget-handle no-undo.
      326     define output parameter p-report-name as character no-undo .
      327     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      328   end procedure.
      329   procedure prn-lib-reportviewer-report-name :
      330     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      331     define input parameter p-report-name-html as character no-undo .
      332     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      333   end procedure.
      334   procedure prn-lib-reportviewer :
      335     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      336     define input parameter p-report-name-html as character no-undo .
      337     define input parameter p-param        as character no-undo .
      338     define variable v-excel           as character no-undo init 'TRUE' .
      339     define variable v-value-character as character no-undo .
      340     define variable v-value-integer   as character no-undo .
      341     define variable v-value-date      as date      no-undo .
      342     define variable v-value-decimal   as decimal   no-undo .
      343     define variable rep-excel         as logical   no-undo .
      344     define variable excel-string      as character no-undo .
      345     define variable v-param-type      as character no-undo .
      346     define variable v-tth             as handle    no-undo .
      347     run adm/shattri.p (
      348       input "get":U
      349       ,input  ""
      350       ,input  0
      351       ,input  'report-glob':U
      352       ,input  'rep-excel':U
      353       ,output v-value-character
      354       ,output v-value-date
      355       ,output v-value-decimal
      356       ,output v-value-integer
      357       ,output rep-excel
      358       ,output v-param-type
      359       ,INPUT-OUTPUT table-handle v-tth
      360       )  .
      361     if rep-excel then v-excel = "TRUE" .
      362     else v-excel = "FALSE" .
      363     if p-param eq ""
      364     then
      365        p-param = "EXCEL:" + v-excel.
      366     else
      367        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      368     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      369   end procedure.
      370   FUNCTION GdsName RETURNS CHARACTER
      371     ( input p-gds-code as integer)  FORWARD.
      372   define VARIABLE p-report-id         as character no-undo .
      373   define variable v-file-name-rep-htm as character no-undo .
      374   define variable v-period            as character no-undo .
      375   define variable v-print-date        as character no-undo .
      376   define variable ii                  as integer   no-undo .
      377   define variable v-create-time     as character no-undo .
      378   define variable v-create-date     as character no-undo .
      379   define variable v-supp-name       as character no-undo .
      380   define stream Out-Stream.
      381   define stream OutStr-html.
      382   define buffer buf_utd for ub.utd .
      383   define buffer buf_clients for ub.clients .
      384   do
      385       on error undo, return error return-value
      386       :
      387       find first buf_utd no-lock where buf_utd.db-num = pdb-num and buf_utd.doc-id = pdoc-id no-error .
      388       find first buf_clients no-lock where buf_clients.obj-code = buf_utd.cli-code and
      389                                            buf_clients.obj-type = buf_utd.cli-type no-error .
      390       if available (buf_clients) then v-supp-name = buf_clients.obj-name .
      391       run get-report-num (output p-report-id).
      392       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
      393       ii = 0 .
      394       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      395       put stream OutStr-html unformatted
      396           "<!DOCTYPE HTML>" skip
      397           ' <html>' skip
      398           '  <head>' skip
      399           '   <meta charset="utf-8">' skip
      400           '    <style type="text/css">' skip
      401           '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      402           '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      403           '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      404           '   </style>' skip
      405           '  </head>' skip
      406           .
      407       put stream OutStr-html unformatted
      408           '<body>' skip
      409           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
      410           '<thead>' skip
      411           .
      412       put stream OutStr-html unformatted
      413           '<tr class="set_columns">' skip
      414           '<td style="width: 80px;"></td>' skip
      415           '<td style="width: 80px;"></td>' skip
      416           '<td style="width: 250px;"></td>' skip
      417           '<td style="width: 500px;"></td>' skip
      418           '</tr>' skip
      419           .
      420       put stream OutStr-html unformatted
      421           '<TR><TD colspan="4"></TD></TR>' skip
      422           '<TR>' skip
      423           '<TD colspan="4" style="font-weight: bold;">Ошибки по УПД № ' + string(buf_utd.DocumentNumber)+ " от " + string (buf_utd.DocumentDate) + '</TD>' skip
      424           '</TR>'skip
      425           '<TR>' skip
      426           '<TD colspan="4">Поставщик: ' + string(v-supp-name) + '</TD>' skip
      427           '</TR>'skip
      428           .
      429       put stream OutStr-html unformatted
      430           '</thead>' skip
      431           '<tbody>' skip
      432           .
      433       put stream OutStr-html unformatted
      434           '<TR>' skip
      435           '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">№ строки</TD>' skip
      436           '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Код товара</TD>' skip
      437           '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Название товара</TD>' skip
      438           '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Текст ошибки</TD>' skip
      439           '</TR>'skip
      440           .
      441       for each tt-utd-err:
      442           put stream OutStr-html unformatted
      443               '<TR>' skip
      444               '<TD text_wrap="true" style="text-align: center;">' + string(tt-utd-err.LineNum) + '</TD>' skip
      445               '<TD text_wrap="true" style="text-align: center;">' + if tt-utd-err.gds-code <> ? then string(tt-utd-err.gds-code) + '</TD>' else ""  + '</TD>' skip
      446               '<TD text_wrap="true" style="text-align: center;">' + GDSName(tt-utd-err.gds-code) + '</TD>' skip
      447               '<TD text_wrap="true" style="text-align: center;">' + string(tt-utd-err.descr) + '</TD>' skip
      448               '</TR>'skip
      449               .
      450       end.
      451           put stream OutStr-html unformatted
      452               '</table>' skip
      453               '</body>' skip
      454               '</html>' skip
      455               .
      456           output stream OutStr-html close.
      457           run prn-lib-reportviewer-report-name in this-procedure (
      458               input THIS-PROCEDURE
      459               ,input v-file-name-rep-htm
      460               ).
      461   end .
      462   function GDSName returns character
      463           (input p-gds-code as integer):
      464   define variable result as character no-undo.
      465   find first ub.goods no-lock where ub.goods.gds-code = p-gds-code no-error .
      466   if available (ub.goods) then result = ub.goods.gds-name .
      467   else result = "" .
      468   return result.
      469   end function.
      470   PROCEDURE get-report-num :
      471       define output parameter p-report-num as integer no-undo .
      472       do
      473           on error undo, return error return-value
      474           :
      475           run gbl/getrpnum.p (output p-report-num).
      476       end.
      477   END PROCEDURE.
