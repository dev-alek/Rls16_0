     3212                                                                        "Остаток на начало" + XL-delim ) format "X(72)"
     3213       .
     3214       for each temp-date :
     3215         put stream txt-file string(string(temp-date.dat1,"99/99/9999") + "-" + string(temp-date.dat2,"99/99/9999") +
     3216           " приход внеш.-возврат постав."   + XL-delim  +
     3217           string(temp-date.dat1,"99/99/9999") + "-" + string(temp-date.dat2,"99/99/9999") +
     3218           " Реализ. внеш.-возврат реализ."   + XL-delim  +
     3219           string(temp-date.dat1,"99/99/9999") + "-" + string(temp-date.dat2,"99/99/9999") +
     3220           " Остаток на конец интервала"   + XL-delim) format "X(152)"
     3221         .
     3222       end.
     3223       put stream txt-file
     3224         string("Всего приход внеш.-возврат постав."   + XL-delim  +
     3225                "Всего реализ. внеш.-возврат реализ."  + chr(10))  format "X(73)"
     3226       .
     3227     end.
     3228     PUT stream OutStream SPACE(30) "Отчет о динамике реализации с: " x-date-start format "99/99/9999" "г. по: " x-date-end format "99/99/9999" "г." SKIP .
     3229     PUT stream OutStream str1 format "X(100)" SKIP .
     3230     run macr_excel_char (str1, 2, 1) .
     3231     assign  v-NameString = "Выбор объекта: " .
     3232     PUT stream OutStream v-NameString format "X(100)" SKIP .
     3233     run macr_excel_char ("Выбор объекта: ", 3, 1) .
     3234     assign v-col = 2 .
     3235     for each obj-list no-lock:
     3236       Assign  v-NameString = obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), " .
     3237       PUT stream OutStream SPACE(5) v-NameString format "X(100)" SKIP .
     3238       run macr_excel_char (v-NameString, 3, v-col) .   assign v-col = v-col + 1 .
     3239     end.
     3240     assign  v-NameString = "Выбор товара: " .
     3241     case x-SelectGood :
     3242       when 1      then assign v-NameString = v-NameString + "по всем товарам"  .
     3243       when 2      then assign v-NameString = v-NameString + "по группам"  .
     3244       when 3     then assign v-NameString = v-NameString + "по производителям"  .
     3245       when 4   then assign v-NameString = v-NameString + "выборочно"  .
     3246       when 5      then assign v-NameString = v-NameString + "выборочно"  .
     3247       when 6     then assign v-NameString = v-NameString + "хранимый список"  .
     3248       when 7 then assign v-NameString = v-NameString + "по группам и по производителям"  .
     3249     end case .
     3250     PUT stream OutStream v-NameString format "X(100)" SKIP .
     3251     run macr_excel_char (v-NameString, 4, 1) .
     3252     assign v-row = 5 .
     3253     run PrintTitul in this-procedure .
     3254     run PutColumnTitulExcel in this-procedure .
     3255     case classify:
     3256       when 1 then run class1 in this-procedure .
     3257       when 2 then run class2 in this-procedure .
     3258       when 3 then run class3 in this-procedure .
     3259       when 4 then run class4 in this-procedure .
     3260       when 5 then run class5 in this-procedure .
     3261     end case.
     3262     assign v-NameString = "ВСЕГО: " .
     3263     run PrintItog in this-procedure (input -3) .
     3264     HIDE stream OutStream FRAME BottomFrame .
     3265     OUTPUT stream OutStream CLOSE.
     3266     if ExportZUM then do:
     3267       output stream txt-file close.
     3268     end.
     3269     output stream macr_excel close .
     3270     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     3271     run end-proc .
     3272   if mFrameView
     3273   then do:
     3274      HIDE FRAME InfoFrame.
     3275   end.
     3276   if session :set-wait-state( "" ) then.
     3277     define variable disop as integer   no-undo .
     3278     if num-col < 4 then assign disop = 0 .
     3279     else do:
     3280       if num-col < 7 then assign disop = 8 .
     3281       else do:
     3282         if num-col < 13 then assign disop = 1 .
     3283         else                 assign disop = 3 .
     3284       end.
     3285     end.
     3286     define variable v-user-action as character no-undo .
     3287     define variable v-printed as logical   no-undo .
     3288     run gbl/prnfilen.w
     3289       (input  ""
     3290       ,input  disop
     3291       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3292       ,input 7
     3293       ,output v-user-action
     3294       ,output v-printed
     3295       ) .
     3296   end.
     3297   procedure class1 :
     3298     do on error undo, return error return-value :
     3299       case SortType:
     3300         when 1 then do:
     3301           for each temp-tovar break by temp-tovar.b-code :    run PrintLine in this-procedure .  end.
     3302         end.
     3303         when 2 then do:
     3304           for each temp-tovar break by temp-tovar.artic :     run PrintLine in this-procedure .  end.
     3305         end.
     3306         when 3 then do:
     3307           for each temp-tovar break by temp-tovar.gds-name :  run PrintLine in this-procedure .  end.
     3308         end.
     3309         when 4 or when 5 or when 6 or when 7 then do:
     3310           for each temp-tovar break by temp-tovar.sort-val DESCENDING : run PrintLine in this-procedure .  end.
     3311         end.
     3312       end case.
     3313     end.
     3314   end procedure.
