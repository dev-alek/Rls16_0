     3623   procedure PrintTitul :
     3624     do on error undo, return error return-value :
     3625       put stream outstream  skip cur-time-print() format "x(35)" string( "Страница" ) AT 45 PAGE-NUMBER( outstream ) AT 55 FORMAT ">>9" SKIP .
     3626       put stream outstream
     3627         skip  Line format frmt  skip
     3628           "| "     "Код"   format "X(11)"   "Артикул" format "X(11)"
     3629           "|"      at 49        "Остаток на"       format "X(10)"
     3630       .
     3631       for each temp-date :
     3632         put stream outstream  "|   "   at (61 + 21 * (temp-date.num - 1))  temp-date.dat1   format "99/99/9999" .
     3633       end.
     3634       put stream outstream
     3635           "|"  at (61 + 21 * num-col)  "Всего"  format "X(10)"
     3636           "|"   at (61 + 21 * num-col + 11)      skip
     3637           "| "     "Наименование товара"              format "X(20)"
     3638           "|"      at 49        "начало"           format "X(10)"
     3639       .
     3640       for each temp-date :
     3641         put stream outstream  "|   "   at (61 + 21 * (temp-date.num - 1)) temp-date.dat2   format "99/99/9999" .
     3642       end.
     3643       put stream outstream  "|"   at (61 + 21 * num-col)  "|"  at (61 + 21 * num-col + 11)  skip    Line format frmt  skip  .
     3644     end.
     3645   end procedure.
     3646   procedure PutColumnTitulExcel :
     3647     do
     3648     on error undo, return error return-value
     3649     :
     3650     assign v-NameString = "Отчет о динамике реализации с: " + string(x-date-start,"99/99/9999") + "г. по: " + string(x-date-end,"99/99/9999") + "г." .
     3651     run macr_excel_char ( v-NameString, 1, 2) .
     3652     run macr_cell_format ( 11, yes, no, ?, 1, 2, 1, 2) .
     3653     define variable st as integer   no-undo .
     3654     assign
     3655       v-col = 1
     3656       st = v-row
     3657     .
     3658     run macr_excel_char("Группа", v-row, v-col) .               assign v-col = v-col + 1 .
     3659     run macr_cell_size (20,?, v-row, v-col,?,?).
     3660     run macr_excel_char("Производитель", v-row, v-col) .        assign v-col = v-col + 1 .
     3661     run macr_cell_size (20,?, v-row, v-col,?,?).
     3662     run macr_excel_char("Код", v-row, v-col) .                  assign v-col = v-col + 1 .
     3663     run macr_cell_size (13,?, v-row, v-col,?,?).
     3664     run macr_excel_char("Артикул", v-row, v-col) .              assign v-col = v-col + 1 .
     3665     run macr_cell_size (15,?, v-row, v-col,?,?).
     3666     run macr_excel_char("Наименование товара", v-row, v-col) .  assign v-col = v-col + 1 .
     3667     run macr_cell_size (40,?, v-row, v-col,?,?).
     3668     run macr_excel_char("Остаток на начало", v-row, v-col) .    assign v-col = v-col + 1 .
     3669     for each temp-date :
     3670       run macr_excel_char(string(temp-date.dat1,"99/99/9999") + "-" + string(temp-date.dat2,"99/99/9999"), v-row, v-col + 1 ) .
     3671       run macr_excel_char("Приход внеш.-возврат постав.", v-row + 1, v-col ) .  assign v-col = v-col + 1 .
     3672       run macr_excel_char("Реализ. внеш.-возврат реализ.", v-row + 1, v-col ) .  assign v-col = v-col + 1 .
     3673       run macr_excel_char("Остаток на конец интервала", v-row + 1, v-col ) .  assign v-col = v-col + 1 .
     3674     end.
     3675     run macr_excel_char("Всего приход внеш.-возврат постав.", v-row, v-col ) .  assign v-col = v-col + 1 .
     3676     run macr_excel_char("Всего реализ. внеш.-возврат реализ.", v-row, v-col ) .
     3677     assign v-row = v-row + 1 .
     3678     run macr_cell_bordur ( st, 1, v-row , v-col) .
     3679     run macr_cell_format ( 10, yes, no, 35, st, 1, v-row, v-col) .
     3680     run macr_cell_size (12,?, st, 6, v-row, v-col) .
     3681     assign v-row = v-row + 1 .
     3682     end.
     3683   end procedure.
     3684   procedure PrintGroup :
     3685     do on error undo, return error return-value :
     3686       define input  parameter p-lavel as integer   no-undo .
     3687       run is-page in this-procedure .
     3688       for each temp-sum where temp-sum.gds-code = p-lavel :
     3689         assign
     3690           temp-sum.ostat     = 0
     3691           temp-sum.prihod    = 0
     3692           temp-sum.rashod    = 0
     3693         .
     3694       end.
     3695       if sum-only = no then put stream outstream "| "  v-NameString format "X(100)" "|" at (61 + 21 * num-col + 11) skip Line format frmt skip.
     3696     end.
     3697   end procedure.
     3698   procedure AddSum :
     3699     do on error undo, return error return-value :
     3700       define input  parameter p-lavel as integer   no-undo .
     3701       find first temp-sum where temp-sum.gds-code = p-lavel and temp-sum.num = 0 .
     3702       assign
     3703         temp-sum.ostat     = temp-sum.ostat     + temp-tovar.ostat-beg
     3704         temp-sum.prihod    = temp-sum.prihod    + temp-tovar.prihod
     3705         temp-sum.rashod    = temp-sum.rashod    + temp-tovar.rashod
     3706       .
     3707       for each temp-sum where temp-sum.gds-code = p-lavel and temp-sum.num > 0 .
     3708         find first buf_temp-sum where buf_temp-sum.gds-code = temp-tovar.gds-code and buf_temp-sum.num = temp-sum.num .
     3709         assign
     3710           temp-sum.ostat     = temp-sum.ostat     + buf_temp-sum.ostat
     3711           temp-sum.prihod    = temp-sum.prihod    + buf_temp-sum.prihod
     3712           temp-sum.rashod    = temp-sum.rashod    + buf_temp-sum.rashod
     3713         .
     3714       end.
     3715     end.
     3716   end procedure.
     3717   procedure PrintLine :
     3718     do
     3719     on error undo, return error return-value
     3720     :
     3721       run is-page in this-procedure .
     3722       if sum-only = no then do:
     3723         assign v-col = 1 .
     3724         Put Stream Outstream "| " temp-tovar.b-code  Format ">>>>>>>>>>>>9"  space(10) temp-tovar.artic  Format "X(13)"
     3725                              "|"  At 49 temp-tovar.ostat-beg    Format "->>>>>>>>9" .
     3726         run macr_excel_char(temp-tovar.grp-name,  v-row, v-col) .     assign v-col = v-col + 1 .
     3727         find first buf_clients no-lock where buf_clients.obj-type = temp-tovar.prod-type and buf_clients.obj-code = temp-tovar.prod-code .
     3728         run macr_excel_char(buf_clients.obj-name, v-row, v-col) .     assign v-col = v-col + 1 .
     3729         run macr_excel_char(temp-tovar.b-code,    v-row, v-col) .     assign v-col = v-col + 1 .
     3730         run macr_excel_char(temp-tovar.artic,     v-row, v-col) .     assign v-col = v-col + 1 .
     3731         run macr_excel_char(temp-tovar.gds-name,  v-row, v-col) .     assign v-col = v-col + 1 .
     3732         run macr_excel_sum (temp-tovar.ostat-beg, v-row, v-col, 2) .  assign v-col = v-col + 1 .
     3733         if ExportZUM then do:
     3734           put stream txt-file  temp-tovar.grp-name  format "X(40)" XL-delim .
     3735           put stream txt-file  buf_clients.obj-name format "X(40)" XL-delim .
     3736           put stream txt-file  temp-tovar.b-code    Format ">>>>>>>>>>>>9"   XL-delim .
     3737           put stream txt-file  temp-tovar.artic     Format "X(13)"   XL-delim .
     3738           put stream txt-file  temp-tovar.gds-name  Format "X(46)"   XL-delim .
     3739           put stream txt-file  replace(string(temp-tovar.ostat-beg,"->>>>>>>>9.<<<"),".",",")   XL-delim .
     3740         end.
     3741         for each temp-sum where temp-sum.gds-code = temp-tovar.gds-code :
     3742           put stream outstream  "|"  At (61 + 21 * (temp-sum.num - 1))  temp-sum.prihod    Format "->>>>>>>>9" temp-sum.ostat Format "->>>>>>>>9"  .
     3743           run macr_excel_sum (temp-sum.prihod, v-row, v-col, 2) .  assign v-col = v-col + 1 .
     3744           run macr_excel_sum (temp-sum.rashod, v-row, v-col, 2) .  assign v-col = v-col + 1 .
     3745           run macr_excel_sum (temp-sum.ostat,  v-row, v-col, 2) .  assign v-col = v-col + 1 .
     3746           if ExportZUM then do:
     3747             put stream txt-file replace(string(temp-tovar.prihod,"->>>>>>>>9.<<<"),".",",")   XL-delim .
     3748             put stream txt-file replace(string(temp-tovar.rashod,"->>>>>>>>9.<<<"),".",",")   XL-delim .
     3749             put stream txt-file replace(string(temp-tovar.ostat ,"->>>>>>>>9.<<<"),".",",")   XL-delim .
     3750           end.
     3751         end.
     3752         if ExportZUM then do:
     3753           put stream txt-file replace(string(temp-tovar.prihod,"->>>>>>>>9.<<<"),".",",")   XL-delim .
     3754           put stream txt-file replace(string(temp-tovar.rashod,"->>>>>>>>9.<<<"),".",",")   chr(10) .
     3755         end.
     3756         put stream outstream "|"  At (61 + 21 * num-col) temp-tovar.prihod       Format "->>>>>>>>9"
     3757                              "|"  At (61 + 21 * num-col + 11) skip
     3758                              "| " temp-tovar.gds-name  Format "X(46)"
     3759                              "|"  At 49 .
     3760         run macr_excel_sum (temp-tovar.prihod, v-row, v-col, 2) .  assign v-col = v-col + 1 .
     3761         run macr_excel_sum (temp-tovar.rashod, v-row, v-col, 2) .  assign v-col = v-col + 1 .
     3762         for each temp-sum where temp-sum.gds-code = temp-tovar.gds-code :
     3763           put stream outstream  "|"  At (61 + 21 * (temp-sum.num - 1))  temp-sum.rashod    Format "->>>>>>>>9"  .
     3764         end.
     3765         put stream outstream "|"  At (61 + 21 * num-col)  temp-tovar.rashod       Format "->>>>>>>>9"
     3766                              "|"  At (61 + 21 * num-col + 11)  skip     Line format frmt   skip .
     3767         assign v-row = v-row + 1 .
     3768       end.
     3769       run AddSum in this-procedure (-3).
     3770       if classify > 1 then do:
     3771         run AddSum in this-procedure (-1).
     3772         if classify > 3 then do: run AddSum in this-procedure (-2).    end.
     3773       end.
     3774     end.
     3775   end procedure.
     3776   procedure PrintItog :
     3777     do on error undo, return error return-value :
     3778       define input  parameter p-lavel     as integer   no-undo .
     3779       run is-page in this-procedure .
     3780       find first buf_temp-sum where buf_temp-sum.gds-code = p-lavel and buf_temp-sum.num = 0 .
     3781       Put Stream Outstream "| " v-NameString  Format "X(46)"  "|"  At 49  buf_temp-sum.ostat Format "->>>>>>>>9" .
     3782       for each temp-sum where temp-sum.gds-code = p-lavel and temp-sum.num > 0  use-index pi:
     3783         put stream outstream  "|"  At (61 + 21 * (temp-sum.num - 1))  temp-sum.prihod    Format "->>>>>>>>9" temp-sum.ostat Format "->>>>>>>>9"  .
     3784       end.
     3785       put stream outstream "|"  At (61 + 21 * num-col) buf_temp-sum.prihod       Format "->>>>>>>>9"
     3786                            "|"  At (61 + 21 * num-col + 11) skip
     3787                            "| "   "|"  At 49 .
     3788       for each temp-sum where temp-sum.gds-code = p-lavel and temp-sum.num > 0  use-index pi :
     3789         put stream outstream  "|"  At (61 + 21 * (temp-sum.num - 1))  temp-sum.rashod    Format "->>>>>>>>9" .
     3790       end.
     3791       put stream outstream "|"  At (61 + 21 * num-col) buf_temp-sum.rashod       Format "->>>>>>>>9"
     3792                            "|"  At (61 + 21 * num-col + 11) skip   Line format frmt  skip
     3793       .
     3794     end.
     3795   end procedure.
     3796   procedure GetValTovar :
     3797     do on error undo, return error return-value :
     3798       define input  parameter sum-type   as character no-undo .
     3799       define input  parameter fact-order as decimal   no-undo .
     3800       define output parameter qnty       as decimal   no-undo .
     3801       find last buf_stk-line no-lock
     3802         where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     3803           and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     3804           and buf_stk-line.artic     = buf_gds-obj.artic
     3805           and buf_stk-line.prod-type = buf_gds-obj.prod-type
     3806           and buf_stk-line.prod-code = buf_gds-obj.prod-code
     3807           and buf_stk-line.sum-type  = sum-type
     3808           and buf_stk-line.cat-id    = '##,##'
     3809           and buf_stk-line.fact-order  < fact-order
     3810         use-index category no-error .
     3811       if available buf_stk-line then  assign qnty = buf_stk-line.fact-qnty .
     3812       else                            assign qnty = 0 .
     3813     end.
     3814   end procedure.
     3815   procedure is-page :
     3816     do
     3817     on error undo, return error return-value
     3818     :
     3819       if line-counter( Outstream ) + 4 > page-size( Outstream ) then do:
     3820         put stream outstream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     3821         page stream OutStream .
     3822         run PrintTitul .
     3823       end.
     3824       if  ( v-row ) >= 63000 then do:
     3825         Output stream Macr_Excel  close .
     3826         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     3827         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     3828         output stream  Macr_Excel to value(v-file-name) .
     3829         assign
     3830           v-ind = v-ind + 1
     3831           v-row = 2
     3832         .
     3833         run PutColumnTitulExcel in this-procedure .
     3834       end.
     3835     end.
     3836   end procedure.
