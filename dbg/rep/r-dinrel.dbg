     1670   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1671   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1672   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1673   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1674   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1675   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1676   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
