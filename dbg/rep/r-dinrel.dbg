     2451     run day-begin-fact-order in this-procedure ( input x-date-start,        output v-fact-order-start ).
     2452     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),  output v-fact-order-end ).
     2453     do ii = 1 to num-col :
     2454       create temp-date .
     2455       assign
     2456         temp-date.num = ii
     2457         temp-date.dat1 = (x-date-start + (x-date-end + 1 - x-date-start) * (ii - 1) / num-col)
     2458         temp-date.dat2 = (x-date-start + (x-date-end + 1 - x-date-start) * ii / num-col) - 1
     2459       .
     2460       run day-begin-fact-order in this-procedure ( input temp-date.dat1,  output temp-date.fo1 ).
     2461       run day-begin-fact-order in this-procedure ( input temp-date.dat2 + 1,  output temp-date.fo2 ).
     2462     end.
     2463     do ii = 0 to num-col : create temp-sum . assign temp-sum.num = ii temp-sum.gds-code = - 3 . end.
     2464     if classify > 1 then do:
     2465       do ii = 0 to num-col : create temp-sum . assign temp-sum.num = ii temp-sum.gds-code = - 1 . end.
     2466       if classify > 3 then do:
     2467         do ii = 0 to num-col : create temp-sum . assign temp-sum.num = ii temp-sum.gds-code = - 2 . end.
     2468       end.
     2469     end.
     2470     assign Counter1 = 0 .
