     2388     ) no-error .
     2389     for each thbjattr_thbj-attr :
     2390         if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     2391     end.
     2392     IF tmp-var1 = "" then XL-delim = ";".
     2393     else XL-delim = tmp-var1.
