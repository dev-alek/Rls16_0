      569   define new global shared variable g#library  as handle no-undo .
      570   define new global shared variable g#library2 as handle no-undo .
      571   define variable var-report-r-b as character no-undo .
      572   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      574     (output var-report-r-b
      575     )  .
      576   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   procedure factord :
      578     define input  parameter p-fact-date            as date    no-undo .
      579     define input  parameter p-fact-time            as integer no-undo .
      580     define input  parameter p-fact-num             as integer no-undo .
      581     define input  parameter p-shift-date           as date    no-undo .
      582     define input  parameter p-shift-num            as integer no-undo .
      583     define input  parameter p-shift-on             as logical no-undo .
      584     define output parameter p-fact-order           as decimal no-undo .
      585     define output parameter p-shift-end-fact-order as decimal no-undo .
      586     define output parameter p-day-end-fact-order   as decimal no-undo .
      587     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      588     if p-fact-date = ?
      589     then do:
      590       return error "Не указана фактическая дата" .
      591     end.
      592     define variable v-fact-date-num as integer no-undo .
      593     assign
      594       v-fact-date-num = integer(p-fact-date)
      595     .
      596     if p-fact-num = ?
      597     or p-fact-num = 0
      598     then do:
      599       return error "Не задан p-fact-num " + string(p-fact-num) .
      600     end.
      601     if p-fact-num < 0
      602     then do:
      603       return error "Отрицательный fact-num " + string(p-fact-num) .
      604     end.
      605     if p-fact-num >= 100000000
      606     then do:
      607       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      608     end.
      609     if p-shift-on = true
      610     then do:
      611       if p-shift-date = ?
      612       then do:
      613         return error "Не задана дата смены" .
      614       end.
      615       if p-shift-num = ?
      616       or p-shift-num = 0
      617       then do:
      618         return error "Не задан номер смены" .
      619       end.
      620     end.
      621     else do:
      622       assign
      623         p-shift-date = p-fact-date
      624         p-shift-num  = 24
      625       .
      626     end.
      627     define variable v-shift-offset as integer no-undo .
      628     if p-shift-date = p-fact-date
      629     then do:
      630       assign
      631         v-shift-offset = 1
      632       .
      633     end.
      634     if p-shift-date < p-fact-date
      635     then do:
      636       assign
      637         v-shift-offset = 0
      638       .
      639     end.
      640     if p-shift-date > p-fact-date
      641     then do:
      642       message
      643         vss-workfile vss-revision vss-description skip
      644         "Неправильная дата закрытия смены" skip
      645         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      646         view-as alert-box error .
      647       undo, return error
      648         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      649           ,string(p-fact-date, '99/99/9999':U)
      650           ,string(p-shift-date, '99/99/9999':U)
      651           )
      652       .
      653     end.
      654     if p-shift-num < 1
      655     or p-shift-num > 24
      656     then do:
      657       message
      658         vss-workfile vss-revision vss-description skip
      659         "Неправильный номер смены" skip
      660         "p-shift-num" p-shift-num skip
      661         view-as alert-box error .
      662       undo, return error return-value .
      663     end.
      664     assign
      665       p-fact-order           = v-fact-date-num
      666                              + v-shift-offset * 0.5
      667                              + p-shift-num    * 0.02 - 0.01
      668                              + p-fact-num     * 0.0000000001
      669       p-shift-end-fact-order = v-fact-date-num
      670                              + v-shift-offset * 0.5
      671                              + p-shift-num    * 0.02
      672       p-day-end-fact-order   = v-fact-date-num
      673                              + 0.99
      674     .
      675     if p-fact-order           <= v-fact-date-num
      676     or p-shift-end-fact-order <= v-fact-date-num
      677     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      678     or p-shift-end-fact-order >= p-day-end-fact-order
      679     then do:
      680       message
      681         vss-workfile vss-revision vss-description skip
      682         "Внутренняя ошибка при генерации фактического номера" skip
      683         "p-fact-date"            p-fact-date            skip
      684         "p-fact-time"            p-fact-time            skip
      685         "p-fact-num"             p-fact-num             skip
      686         "p-shift-date"           p-shift-date           skip
      687         "p-shift-num"            p-shift-num            skip
      688         "p-shift-on"             p-shift-on             skip
      689         "p-shift-end-fact-order" p-shift-end-fact-order skip
      690         "p-day-end-fact-order"   p-day-end-fact-order   skip
      691         "v-fact-date-num"        v-fact-date-num        skip
      692         view-as alert-box error .
      693       undo, return error return-value .
      694     end.
      695   end procedure.
      696   procedure day-begin-fact-order :
      697     define input  parameter p-fact-date            as date    no-undo .
      698     define output parameter p-day-begin-fact-order as decimal no-undo .
      699     do
      700     on error undo, return error return-value
      701     :
      702       if p-fact-date = ?
      703       then do:
      704         assign
      705           p-day-begin-fact-order = 0
      706         .
      707       end.
      708       else do:
      709         assign
      710           p-day-begin-fact-order = integer(p-fact-date)
      711         .
      712       end.
      713     end.
      714   end procedure.
      715   procedure factord-max-fact-order :
      716     define output parameter p-max-fact-order as decimal   no-undo .
      717     do
      718     on error undo, return error return-value
      719     :
      720       run day-begin-fact-order in this-procedure
      721         (input  date(1, 1, 5000)
      722         ,output p-max-fact-order
      723         ) .
      724     end.
      725   end procedure.
      726   procedure factord-cut-archive :
      727     define input  parameter p-obj-type             as character no-undo .
      728     define input  parameter p-obj-code             as integer   no-undo .
      729     define input  parameter p-fact-date            as date      no-undo .
      730     define output parameter p-shift-on             as logical   no-undo .
      731     define output parameter p-shift-date           as date      no-undo .
      732     define output parameter p-shift-num            as integer   no-undo .
      733     define output parameter p-day-end-fact-order   as decimal   no-undo .
      734     define output parameter p-shift-end-fact-order as decimal   no-undo .
      735     define variable v-fact-order as decimal   no-undo .
      736     define buffer buf_shift-obj for ub.shift-obj .
      737     do
      738     on error undo, return error return-value
      739     :
      740   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      742     (input  p-obj-type
      743     ,input  p-obj-code
      744     ,input  'shift-on=request'
      745     ,output p-shift-on
      746     ) no-error .
      747       if error-status :error
      748       then do:
      749         message
      750           vss-workfile vss-revision vss-description skip
      751           "Ошибка при определении атрибута объекта" skip
      752           "Объект" p-obj-type p-obj-code skip
      753           error-status :get-message(1) skip
      754           return-value skip
      755           view-as alert-box error .
      756         undo, return error return-value .
      757       end.
      758       if p-shift-on = false
      759       then do:
      760         assign
      761           p-shift-date               = ?
      762           p-shift-num                = 0
      763         .
      764       end.
      765       else do:
      766         find first buf_shift-obj share-lock
      767           where buf_shift-obj.obj-type   = p-obj-type
      768             and buf_shift-obj.obj-code   = p-obj-code
      769             and buf_shift-obj.shift-date > p-fact-date
      770           use-index pi
      771           no-error .
      772         if not available buf_shift-obj
      773         or buf_shift-obj.status_ <> 'зкр':U
      774         then do:
      775           message
      776             vss-workfile vss-revision vss-description skip
      777             "Невозможно вычислить последнюю смену" skip
      778             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      779             "Объект" p-obj-type p-obj-code skip
      780             "Дата" p-fact-date skip
      781             view-as alert-box error .
      782           undo, return error return-value .
      783         end.
      784         find last buf_shift-obj share-lock
      785           where buf_shift-obj.obj-type = p-obj-type
      786             and buf_shift-obj.obj-code = p-obj-code
      787             and buf_shift-obj.shift-date <= p-fact-date
      788           use-index pi
      789           no-error .
      790         if available buf_shift-obj
      791         then do:
      792           if  buf_shift-obj.status_ = 'зкр':U
      793           then do:
      794             assign
      795               p-shift-date = buf_shift-obj.shift-date
      796               p-shift-num  = buf_shift-obj.shift-num
      797             .
      798           end.
      799           else do:
      800             message
      801               vss-workfile vss-revision vss-description skip
      802               "Невозможно вычислить последнюю смену" skip
      803               "Статус смены отличен от статуса" 'зкр':U skip
      804               "Объект" p-obj-type p-obj-code skip
      805               "Дата" p-fact-date skip
      806               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      807               view-as alert-box error .
      808             undo, return error return-value .
      809           end.
      810         end.
      811         else do:
      812           assign
      813             p-shift-date = p-fact-date - 1
      814             p-shift-num  = 1
      815           .
      816         end.
      817       end.
      818       run factord in this-procedure
      819         (input  p-fact-date
      820         ,input  1
      821         ,input  1
      822         ,input  p-shift-date
      823         ,input  p-shift-num
      824         ,input  p-shift-on
      825         ,output v-fact-order
      826         ,output p-shift-end-fact-order
      827         ,output p-day-end-fact-order
      828         ) no-error .
      829       if error-status :error
      830       then do:
      831         message
      832           vss-workfile vss-revision vss-description skip
      833           "Ошибка при вызове процедуры factord"
      834           error-status :get-message(1) skip
      835           return-value skip
      836           view-as alert-box error .
      837         undo, return error return-value .
      838       end.
      839     end.
      840   end procedure.
      841   procedure factord-lock-shift :
      842     define input  parameter p-obj-type  as character no-undo .
      843     define input  parameter p-obj-code  as integer   no-undo .
      844     define input  parameter p-fact-date as date      no-undo .
      845     define parameter buffer buf_shift-obj for ub.shift-obj .
      846     define variable v-shift-on      as logical   no-undo .
      847     define variable v-extra-message as character no-undo .
      848     define variable v-error as character no-undo .
      849     do
      850     on error undo, return error return-value
      851     :
      852   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      854     (input  p-obj-type
      855     ,input  p-obj-code
      856     ,input  'shift-on=request'
      857     ,output v-shift-on
      858     ) no-error .
      859       if error-status :error
      860       then do:
      861         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      862         undo, return error v-error .
      863       end.
      864       if v-shift-on = true
      865       then do:
      866         find first buf_shift-obj share-lock
      867           where buf_shift-obj.obj-type   = p-obj-type
      868             and buf_shift-obj.obj-code   = p-obj-code
      869             and buf_shift-obj.shift-date > p-fact-date
      870           use-index pi
      871           no-error .
      872         if not available buf_shift-obj
      873         or buf_shift-obj.status_ <> 'зкр':U
      874         then do:
      875           find last buf_shift-obj
      876             where buf_shift-obj.obj-type = p-obj-type
      877               and buf_shift-obj.obj-code = p-obj-code
      878               and buf_shift-obj.status_  = 'зкр':U
      879             use-index stts
      880             no-error .
      881           if available buf_shift-obj
      882           then do:
      883             assign
      884               v-extra-message =
      885                     substitute("Дата начала последеней закрытой смены на объекте &1"
      886                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      887                               )
      888             .
      889           end.
      890           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      891           undo, return error v-error .
      892         end.
      893       end.
      894     end.
      895   end procedure.
      896   procedure factord-end-day :
      897     define input  parameter p-fact-date            as date    no-undo .
      898     define output parameter p-day-end-fact-order   as decimal no-undo .
      899     do
      900     on error undo, return error return-value
      901     :
      902       if p-fact-date = ?
      903       then do:
      904         return error "Не указана фактическая дата" .
      905       end.
      906       assign
      907         p-day-end-fact-order = integer(p-fact-date) + 0.99
      908       .
      909     end.
      910   end procedure.
      911   procedure factord-to-date :
      912     define input  parameter p-fact-order as decimal no-undo .
      913     define output parameter p-fact-date  as date    no-undo .
      914     define variable v-ref-date  as date      no-undo .
      915     define variable v-ref-delta as integer   no-undo .
      916     do
      917     on error undo, return error return-value
      918     :
      919       if p-fact-order = ?
      920       or p-fact-order = 0
      921       then do:
      922         return error "Не указан fact-order" .
      923       end.
      924       assign
      925         v-ref-date  = date(1, 1, 2000)
      926       .
      927       assign
      928         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      929       .
      930       assign
      931         p-fact-date = v-ref-date + v-ref-delta
      932       .
      933     end.
      934   end procedure.
      935   procedure factord-to-fact-num :
      936     define input  parameter p-fact-order as decimal no-undo .
      937     define output parameter p-fact-num   as integer no-undo .
      938     define variable v-fact-order-trunc as decimal no-undo .
      939     do
      940     on error undo, return error return-value
      941     :
      942       if p-fact-order = ?
      943       or p-fact-order = 0
      944       then do:
      945         return error "Не указан fact-order" .
      946       end.
      947       assign
      948        v-fact-order-trunc = truncate(p-fact-order, 2)
      949       .
      950       assign
      951         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      952       .
      953     end.
      954   end procedure.
      955   procedure factord-to-shift-num :
      956     define input  parameter p-fact-order as decimal no-undo .
      957     define output parameter p-shift-num   as integer no-undo .
      958     define variable  p-shift-numd  as decimal   no-undo .
      959     define variable v-fact-order-trunc as decimal no-undo .
      960     do
      961     on error undo, return error return-value
      962     :
      963       if p-fact-order = ?
      964       or p-fact-order = 0
      965       then do:
      966         return error "Не указан fact-order" .
      967       end.
      968       assign
      969        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      970       .
      971       if v-fact-order-trunc < 0.5 then do:
      972         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      973       end.
      974       assign
      975         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      976         .
      977        assign
      978         p-shift-num = truncate (p-shift-numd , 0)
      979       .
      980     end.
      981   end procedure.
      982   define variable vss-include-info10 as character format "X(65)" no-undo
      983   initial "@(#)$Workfile$ $Revision$".
      984   define temp-table temp_grplib_grp no-undo
      985       field sel           as character
      986       field nabor         as character
      987       field full-name     as character
      988       field print-code    as character
      989       field sort-name     as character
      990       field node-code     as integer
      991       field upper-code    as integer
      992       field calc-method   as character
      993       field round-method  as character
      994       field increase-pc   as decimal
      995       field min-marg      as character
      996       field max-marg      as character
      997       field cli-type      as character
      998       field cli-code      as integer
      999       field notcorr      as character
     1000       field name          as character
     1001       field level         as integer
     1002       field mark          as character
     1003       index pi is primary unique sort-name
     1004       index fn full-name
     1005       index nc is unique node-code
     1006       index sl sel
     1007       index uc upper-code
     1008   .
     1009   define temp-table temp_grplib_found-grp no-undo
     1010       field full-name   as character
     1011       field sort-name   as character
     1012       field node-code   as integer
     1013       field level       as integer
     1014       field is-terminal as logical
     1015       index pi is primary unique sort-name
     1016       index fn full-name
     1017       index lv level
     1018       index it is-terminal
     1019   .
     1020   define temp-table temp_found-result-nodelist no-undo
     1021       field node-code     as recid
     1022       field processed     as logical
     1023       field sort-name     as character
     1024       field full-name     as character
     1025       index pi is primary unique node-code
     1026       index ps processed
     1027   .
     1028   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1029   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1030   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1031   procedure grplib-get-parameters :
     1032   define input parameter p-store-type     as character        no-undo.
     1033   define input parameter p-store-code     as integer          no-undo.
     1034   do
     1035   on error undo, return error
     1036   :
     1037       assign
     1038           v-grplib-not-fill-extra-info = no
     1039       .
     1040   end.
     1041   end procedure.
     1042   procedure grplib-get-sort-name :
     1043   do
     1044   on error undo, return error
     1045   :
     1046   define input parameter p-node-code  as integer      no-undo.
     1047   define output parameter p-sort-name as character    no-undo.
     1048       define variable v-upper-code    as integer           no-undo.
     1049       define buffer buf_gds-grp       for ub.gds-grp.
     1050       define buffer buf_upper_gds-grp for ub.gds-grp.
     1051       find first buf_gds-grp no-lock
     1052            where buf_gds-grp.node-code = p-node-code
     1053       no-error.
     1054       if not available buf_gds-grp
     1055       then do:
     1056           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1057       end.
     1058       assign
     1059           p-sort-name  = ""
     1060           v-upper-code = 1
     1061       .
     1062       do while buf_gds-grp.upper-code <> 0
     1063       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1064       :
     1065           assign
     1066               p-sort-name  = buf_gds-grp.node-name
     1067                            + (if p-sort-name <> "" then chr(2) else "")
     1068                            + p-sort-name
     1069               v-upper-code = buf_gds-grp.upper-code
     1070           .
     1071           find first buf_gds-grp no-lock
     1072                where buf_gds-grp.node-code = v-upper-code
     1073           no-error.
     1074           if not available buf_gds-grp
     1075           then do:
     1076               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1077                                   + string( v-upper-code )
     1078                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1079           end.
     1080       end.
     1081   end.
     1082   end procedure.
     1083   define variable vss-include-info11 as character format "X(65)" no-undo
     1084   initial "@(#)$Workfile$ $Revision$".
     1085   procedure grplib-get-full-name :
     1086      define input parameter p-node-code  as integer      no-undo.
     1087      define output parameter p-full-name as character    no-undo.
     1088      do
     1089   on error undo, return error
     1090   :
     1091       define variable v-upper-code    as integer           no-undo.
     1092       define buffer buf_gds-grp       for ub.gds-grp.
     1093       define buffer buf_upper_gds-grp for ub.gds-grp.
     1094       find first buf_gds-grp no-lock
     1095            where buf_gds-grp.node-code = p-node-code
     1096       no-error.
     1097       if not available buf_gds-grp
     1098       then do:
     1099           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1100       end.
     1101       assign
     1102           p-full-name  = ""
     1103           v-upper-code = 1
     1104       .
     1105       do while buf_gds-grp.upper-code <> 0
     1106       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1107       :
     1108           assign
     1109               p-full-name  = buf_gds-grp.node-name
     1110                            + (if p-full-name <> "" then chr(47) else "")
     1111                            + p-full-name
     1112               v-upper-code = buf_gds-grp.upper-code
     1113           .
     1114           find first buf_gds-grp no-lock
     1115                where buf_gds-grp.node-code = v-upper-code
     1116           no-error.
     1117           if not available buf_gds-grp
     1118           then do:
     1119               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1120                                   + string( v-upper-code )
     1121                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1122           end.
     1123       end.
     1124       assign
     1125       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1126       .
     1127   end.
     1128   end .
     1129   procedure grplib-get-node-from-full-name :
     1130   define input parameter p-full-name as character no-undo .
     1131   define output parameter p-node-code as integer no-undo .
     1132   define variable v-ii as integer no-undo .
     1133   define variable v-upper-code as integer no-undo .
     1134   define variable v-root-code as integer no-undo .
     1135   define variable v-entry as character no-undo .
     1136   define buffer buf_gds-grp       for ub.gds-grp.
     1137   do
     1138   on error undo, return error
     1139   :
     1140     find first buf_gds-grp no-lock
     1141         where buf_gds-grp.upper-code = 0
     1142     no-error .
     1143     if not available buf_gds-grp
     1144     then do:
     1145         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1146     end.
     1147     else do:
     1148       assign
     1149       v-root-code = buf_gds-grp.node-code
     1150       .
     1151     end.
     1152     v-upper-code = v-root-code.
     1153     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1154       assign
     1155       v-entry = entry(v-ii, p-full-name, chr(47)).
     1156       if v-entry = '' then leave.
     1157       find first buf_gds-grp no-lock where
     1158                 buf_gds-grp.node-name = v-entry
     1159             and buf_gds-grp.upper-code = v-upper-code
     1160             no-error.
     1161       if not available buf_gds-grp then do:
     1162         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1163       end.
     1164       else do:
     1165         p-node-code = buf_gds-grp.node-code.
     1166         v-upper-code = buf_gds-grp.node-code.
     1167       end.
     1168     end.
     1169   end.
     1170   end .
     1171   procedure grplib-get-root-code :
     1172   do
     1173   on error undo, return error
     1174   :
     1175   define output parameter p-root-code as integer      no-undo.
     1176       define buffer buf_gds-grp       for ub.gds-grp.
     1177       find first buf_gds-grp no-lock
     1178           where buf_gds-grp.upper-code = 0
     1179       no-error .
     1180       if not available buf_gds-grp
     1181       then do:
     1182           undo, return error .
     1183       end.
     1184       else do:
     1185           assign
     1186               p-root-code = buf_gds-grp.node-code
     1187           .
     1188       end.
     1189   end.
     1190   end procedure.
     1191   procedure grplib-find-grp-by-full-name :
     1192   do
     1193   on error undo, return error
     1194   :
     1195   define input parameter p-search-name  as character    no-undo.
     1196   define input parameter p-fill-path    as logical      no-undo.
     1197   define output parameter p-found       as logical      no-undo.
     1198       define variable v-upper-code    as integer          no-undo.
     1199       define variable v-counter       as integer           no-undo.
     1200       define variable v-level         as integer           no-undo.
     1201       define variable v-full-name     as character         no-undo.
     1202       define variable v-sort-name     as character         no-undo.
     1203       define buffer buf_gds-grp       for ub.gds-grp.
     1204       assign
     1205           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1206       .
     1207       run grplib-get-root-code ( output v-upper-code ) no-error .
     1208       if error-status :error
     1209       then do:
     1210           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1211       end.
     1212       assign
     1213           v-full-name  = ""
     1214           v-level      = num-entries( p-search-name, chr(2) )
     1215       .
     1216       for each temp_grplib_found-grp
     1217       :
     1218           delete temp_grplib_found-grp.
     1219       end.
     1220       start-name-analyze:
     1221       do v-counter = 1 to v-level
     1222       :
     1223           if v-counter < v-level
     1224           then do:
     1225               find first buf_gds-grp no-lock
     1226                    where buf_gds-grp.upper-code = v-upper-code
     1227                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1228               no-error .
     1229               if not available buf_gds-grp
     1230               then do:
     1231                   assign
     1232                       v-full-name  = p-search-name
     1233                       v-sort-name  = p-search-name
     1234                   .
     1235                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1236               end.
     1237               else do:
     1238                   assign
     1239                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1240                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1241                       v-upper-code = buf_gds-grp.node-code
     1242                   .
     1243                   if p-fill-path = yes
     1244                   then do:
     1245                       create temp_grplib_found-grp.
     1246                       assign
     1247                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1248                           temp_grplib_found-grp.sort-name = v-sort-name
     1249                           temp_grplib_found-grp.node-code = v-upper-code
     1250                           temp_grplib_found-grp.level     = v-counter
     1251                       .
     1252                   end.
     1253               end.
     1254           end.
     1255           else do:
     1256               for each buf_gds-grp no-lock
     1257                  where buf_gds-grp.upper-code = v-upper-code
     1258                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1259               :
     1260                   assign
     1261                       p-found = yes
     1262                   .
     1263                   create temp_grplib_found-grp.
     1264                   assign
     1265                       temp_grplib_found-grp.full-name = v-full-name
     1266                                                           + (if v-full-name = "" then "" else chr(47) )
     1267                                                           + buf_gds-grp.node-name + chr(47)
     1268                       temp_grplib_found-grp.sort-name = v-sort-name
     1269                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1270                                                           + buf_gds-grp.node-name
     1271                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1272                       temp_grplib_found-grp.level     = v-level
     1273                   .
     1274               end.
     1275               if p-found = no
     1276               then do:
     1277                   assign
     1278                       v-full-name  = p-search-name
     1279                       v-sort-name  = p-search-name
     1280                   .
     1281                   for each temp_grplib_found-grp
     1282                   :
     1283                       delete temp_grplib_found-grp.
     1284                   end.
     1285                   assign
     1286                       p-found = no
     1287                   .
     1288               end.
     1289           end.
     1290       end.
     1291   end.
     1292   end procedure.
     1293   procedure grplib-find-all-subgroup :
     1294   do
     1295   on error undo, return error
     1296   :
     1297   define input parameter p-start-node-code    as integer      no-undo.
     1298   define input parameter p-terminal-only      as logical      no-undo.
     1299       define variable v-start-full-name   as character     no-undo.
     1300       define variable v-start-sort-name   as character     no-undo.
     1301       define variable v-not-found         as logical       no-undo.
     1302       define variable v-is-terminal       as logical       no-undo.
     1303       define buffer buf_gds-grp           for ub.gds-grp.
     1304       create temp_found-result-nodelist.
     1305       assign
     1306           temp_found-result-nodelist.node-code = p-start-node-code
     1307           temp_found-result-nodelist.processed = no
     1308       .
     1309       run grplib-get-full-name in this-procedure (
     1310             input p-start-node-code
     1311           , output v-start-full-name
     1312       ).
     1313       run grplib-get-full-name in this-procedure (
     1314             input p-start-node-code
     1315           , output v-start-sort-name
     1316       ).
     1317       process-nodes:
     1318       do while yes
     1319       :
     1320           find first temp_found-result-nodelist
     1321                where temp_found-result-nodelist.node-code = p-start-node-code
     1322           .
     1323           assign
     1324               temp_found-result-nodelist.processed = yes
     1325           .
     1326           for each buf_gds-grp no-lock
     1327              where buf_gds-grp.upper-code = p-start-node-code
     1328           on error undo, return error
     1329           :
     1330               run grplib-is-terminal in this-procedure (
     1331                     input buf_gds-grp.node-code
     1332                   , output v-is-terminal
     1333               ).
     1334               if v-is-terminal = yes
     1335               then do:
     1336                   create temp_grplib_found-grp.
     1337                   assign
     1338                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1339                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1340                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1341                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1342                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1343                       temp_grplib_found-grp.is-terminal = yes
     1344                   .
     1345               end.
     1346               else do:
     1347                   create temp_found-result-nodelist.
     1348                   assign
     1349                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1350                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1351                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1352                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1353                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1354                       temp_found-result-nodelist.processed = no
     1355                   .
     1356                   if p-terminal-only = no
     1357                   then do:
     1358                       create temp_grplib_found-grp.
     1359                       assign
     1360                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1361                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1362                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1363                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1364                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1365                           temp_grplib_found-grp.is-terminal = no
     1366                       .
     1367                   end.
     1368               end.
     1369           end.
     1370           find first temp_found-result-nodelist
     1371                where temp_found-result-nodelist.processed = no
     1372           no-error.
     1373           if not available temp_found-result-nodelist
     1374           then do:
     1375               leave process-nodes.
     1376           end.
     1377           else do:
     1378               assign
     1379                   p-start-node-code = temp_found-result-nodelist.node-code
     1380                   v-start-full-name = temp_found-result-nodelist.full-name
     1381                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1382               .
     1383           end.
     1384       end.
     1385   end.
     1386   end procedure.
     1387   procedure grplib-expand-name :
     1388   define input parameter p-start-name as character        no-undo.
     1389   define output parameter p-end-name  as character        no-undo.
     1390       define variable v-is-terminal   as logical      no-undo.
     1391       define variable v-found         as character    no-undo.
     1392       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1393   do
     1394   for buf_temp_grplib_found-grp
     1395   on error undo, return error
     1396   :
     1397       run grplib-find-grp-by-full-name in this-procedure (
     1398             input p-start-name
     1399           , input no
     1400           , output v-found
     1401       ) no-error.
     1402       run grplib-get-max-substring in this-procedure (
     1403                   input length( p-start-name )
     1404                 , output p-end-name
     1405       ) no-error .
     1406       if error-status :error
     1407       then do:
     1408           assign
     1409               p-end-name = ""
     1410           .
     1411       end.
     1412       else do:
     1413           find first temp_grplib_found-grp
     1414               where temp_grplib_found-grp.full-name = p-end-name
     1415           no-error.
     1416           if available temp_grplib_found-grp
     1417           then do:
     1418               find first buf_temp_grplib_found-grp
     1419                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1420                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1421               no-error.
     1422               if not available buf_temp_grplib_found-grp
     1423               then do:
     1424                   run grplib-is-terminal in this-procedure (
     1425                       input temp_grplib_found-grp.node-code
     1426                       , output v-is-terminal
     1427                   ).
     1428               end.
     1429           end.
     1430       end.
     1431   end.
     1432   end procedure.
     1433   procedure grplib-get-max-substring :
     1434   do
     1435   on error undo, return error
     1436   :
     1437   define input parameter p-min-substring-length   as integer      no-undo.
     1438   define output parameter p-substring             as character    no-undo.
     1439           define variable v-char-counter  as integer           no-undo.
     1440           define variable v-current-char  as character         no-undo.
     1441           define variable v-names-counter  as integer           no-undo.
     1442           define variable v-base-string   as character         no-undo.
     1443           assign
     1444               v-char-counter  = p-min-substring-length
     1445           .
     1446           find first temp_grplib_found-grp no-error.
     1447           if not available temp_grplib_found-grp
     1448           then do:
     1449               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1450           end.
     1451           else do:
     1452               assign
     1453                   v-base-string  = temp_grplib_found-grp.full-name
     1454                   v-char-counter = 0
     1455               .
     1456               counter-block:
     1457               do while yes
     1458               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1459               :
     1460                   assign
     1461                       v-char-counter  = v-char-counter + 1
     1462                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1463                       v-names-counter = 0
     1464                   .
     1465                   compare-block:
     1466                   for each temp_grplib_found-grp
     1467                   :
     1468                       assign
     1469                           v-names-counter = v-names-counter + 1
     1470                       .
     1471                       if v-names-counter = 1
     1472                       then do:
     1473                           next compare-block.
     1474                       end.
     1475                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1476                       then do:
     1477                           leave counter-block.
     1478                       end.
     1479                   end.
     1480                   if v-names-counter = 1
     1481                   then do:
     1482                       assign
     1483                           p-substring = v-base-string
     1484                       .
     1485                       return.
     1486                   end.
     1487               end.
     1488               assign
     1489                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1490               .
     1491           end.
     1492   end.
     1493   end procedure.
     1494   procedure grplib-is-terminal :
     1495   do
     1496   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1497   :
     1498   define input parameter p-node-code      as integer      no-undo.
     1499   define output parameter p-is-terminal   as logical      no-undo.
     1500       define buffer buf_gds-grp       for ub.gds-grp.
     1501       find first buf_gds-grp no-lock
     1502           where buf_gds-grp.upper-code = p-node-code
     1503       no-error .
     1504       if not available buf_gds-grp
     1505       then do:
     1506           assign
     1507               p-is-terminal = yes
     1508           .
     1509       end.
     1510       else do:
     1511           assign
     1512               p-is-terminal = no
     1513           .
     1514       end.
     1515   end.
     1516   end procedure.
     1517   procedure grplib-have-goods :
     1518   do
     1519   on error undo, return error
     1520   :
     1521   define input parameter p-node-code      as integer      no-undo.
     1522   define output parameter p-have-goods   as logical      no-undo.
     1523       define buffer buf_goods         for ub.goods.
     1524       find first buf_goods no-lock
     1525            where buf_goods.grp-code = p-node-code
     1526       no-error .
     1527       if available buf_goods
     1528       then do:
     1529           assign
     1530               p-have-goods = yes
     1531           .
     1532       end.
     1533       else do:
     1534           assign
     1535               p-have-goods = no
     1536           .
     1537       end.
     1538   end.
     1539   end procedure.
     1540   procedure grplib-find-by-substring :
     1541   do
     1542   on error undo, return error
     1543   :
     1544   define input parameter p-start-code         as integer      no-undo.
     1545   define input parameter p-full-search-string as character    no-undo.
     1546   define output parameter p-found-code        as integer      no-undo.
     1547   define output parameter p-full-name         as character    no-undo.
     1548       define variable v-start-code     as integer           no-undo.
     1549       define variable v-found          as logical  init no  no-undo.
     1550       define buffer buf_gds-grp       for ub.gds-grp.
     1551       search-grp:
     1552       for each buf_gds-grp no-lock
     1553           where buf_gds-grp.node-code > p-start-code
     1554       :
     1555           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1556           then do:
     1557               assign
     1558                   p-found-code = buf_gds-grp.node-code
     1559                   v-found      = yes
     1560               .
     1561               run grplib-get-full-name in this-procedure (
     1562                     input p-found-code
     1563                   , output p-full-name
     1564               ) no-error .
     1565               if error-status :error
     1566               then do:
     1567                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1568               end.
     1569               leave search-grp.
     1570           end.
     1571       end.
     1572       if v-found = yes
     1573       then do:
     1574       end.
     1575       else do:
     1576           assign
     1577               p-full-name  = ""
     1578               p-found-code = 0
     1579           .
     1580       end.
     1581   end.
     1582   end procedure.
     1583   procedure grplib-analyze-grp-name :
     1584   do
     1585   on error undo, return error
     1586   :
     1587   define input parameter p-grp-name       as character            no-undo.
     1588   define input parameter p-upper-code     as integer              no-undo.
     1589   define output parameter p-error-message as character init ""    no-undo.
     1590       define variable v-char-list     as character    no-undo.
     1591       define variable v-char-counter  as integer      no-undo.
     1592       define variable v-full-name     as character    no-undo.
     1593       if p-grp-name = "" then do:
     1594           assign
     1595               p-error-message = "Название группы не может быть пустым.".
     1596           .
     1597       end.
     1598       else do:
     1599           assign
     1600               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1601           .
     1602           do v-char-counter = 1 to num-entries( v-char-list )
     1603           :
     1604               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1605               then do:
     1606                   assign
     1607                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1608                   .
     1609                   return.
     1610               end.
     1611           end.
     1612           if p-upper-code > 0
     1613           then do:
     1614               run grplib-get-full-name in this-procedure (
     1615                     input p-upper-code
     1616                   , output v-full-name
     1617               ) no-error .
     1618               if error-status :error
     1619               then do:
     1620                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1621               end.
     1622               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1623               then do:
     1624                   assign
     1625                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1626                   .
     1627               end.
     1628           end.
     1629       end.
     1630   end.
     1631   end procedure.
     1632   procedure grplib-get-lvl-num :
     1633   define input parameter p-node-code  as integer      no-undo.
     1634   define output parameter p-lvl-num   as integer      no-undo.
     1635       define variable v-full-name    as character    no-undo.
     1636   do
     1637   on error undo, return error
     1638   :
     1639       run grplib-get-full-name in this-procedure (
     1640             input p-node-code
     1641           , output v-full-name
     1642       ).
     1643       assign
     1644           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1645       .
     1646       if p-lvl-num = -1
     1647       then do:
     1648           assign
     1649               p-lvl-num = 0
     1650           .
     1651       end.
     1652   end.
     1653   end procedure.
