     2437     define buffer buf_temp-sum for temp-sum.
     2438     define variable  v-fact-order-start     as decimal   no-undo .
     2439     define variable  v-fact-order-end       as decimal   no-undo .
     2440     define variable ii as integer initial 0  no-undo .
