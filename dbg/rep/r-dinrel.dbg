     1685   define variable temp1 as integer   no-undo.
     1686   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1687   procedure cur-time :
     1688      define output parameter p-today as date      no-undo .
     1689      define output parameter p-time  as integer   no-undo .
     1690     do
     1691     on error undo, return error
     1692     :
     1693       define variable v-date1 as date      no-undo .
     1694       define variable v-date2 as date      no-undo .
     1695       define variable v-time  as integer   no-undo .
     1696       assign
     1697         v-date1 = today
     1698         v-time  = time
     1699         v-date2 = today
     1700       .
     1701       if v-date1 <> v-date2
     1702       then do:
     1703         assign
     1704           v-date1 = today
     1705           v-time  = v-time
     1706         .
     1707       end.
     1708       assign
     1709         p-today = v-date1
     1710         p-time  = v-time
     1711       .
     1712     end.
     1713   end.
     1714   function cur-time-date returns character
     1715   :
     1716     return string(today, '99/99/9999':U) .
     1717   end.
     1718   function cur-time-mjd returns decimal
     1719   :
     1720     define variable v-date as date      no-undo .
     1721     define variable v-time as integer   no-undo .
     1722     run cur-time in this-procedure
     1723       (output v-date
     1724       ,output v-time
     1725       ) .
     1726     return integer(v-date) - 2400002 + (v-time / 86400) .
     1727   end.
     1728   function cur-time-get-ending-index returns integer
     1729   (input p-number as integer
     1730   )
     1731   :
     1732     if p-number < 0
     1733     or p-number = ?
     1734     then do:
     1735       return 1 .
     1736     end.
     1737     define variable v-rest as integer   no-undo .
     1738     assign
     1739       p-number = p-number modulo 100
     1740     .
     1741     if p-number < 20
     1742     then do:
     1743       assign
     1744         v-rest = p-number
     1745       .
     1746     end.
     1747     else do:
     1748       assign
     1749         v-rest = p-number modulo 10
     1750       .
     1751     end.
     1752     case v-rest :
     1753       when 1
     1754       then do:
     1755         return 2 .
     1756       end.
     1757       when 2 or
     1758       when 3 or
     1759       when 4
     1760       then do:
     1761         return 3 .
     1762       end.
     1763       otherwise do:
     1764         return 1 .
     1765       end.
     1766     end case .
     1767   end.
     1768   procedure cur-time-mjd-to-date :
     1769      define input  parameter i-mjd-diff as decimal no-undo.
     1770      define output parameter o-Date     as date    no-undo.
     1771      define output parameter o-Time     as integer no-undo.
     1772      define variable v-day-number as integer   no-undo .
     1773      if    i-mjd-diff < 0
     1774         or i-mjd-diff = ?
     1775      then do:
     1776         return "?" .
     1777      end.
     1778      assign
     1779         v-day-number = truncate(i-mjd-diff,0).
     1780         o-Date = date(v-day-number + 2400002).
     1781         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1782     .
     1783   end.
     1784   function cur-time-mjd-to-string returns character
     1785   (input p-mjd-diff as decimal
     1786   )
     1787   :
     1788     define variable v-day-number as integer   no-undo .
     1789     define variable v-seconds    as integer   no-undo .
     1790     define variable v-hour       as integer   no-undo .
     1791     define variable v-min        as integer   no-undo .
     1792     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1793     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1794     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1795     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1796     if p-mjd-diff < 0
     1797     or p-mjd-diff = ?
     1798     then do:
     1799       return "?" .
     1800     end.
     1801     assign
     1802       v-day-number = integer(truncate(p-mjd-diff,0))
     1803       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1804     .
     1805     if v-seconds > 86400
     1806     then do:
     1807       assign
     1808         v-seconds = 86400 - 1
     1809       .
     1810     end.
     1811     if v-seconds < 0
     1812     then do:
     1813       assign
     1814         v-seconds = 0
     1815       .
     1816     end.
     1817     assign
     1818       v-hour = truncate(v-seconds / 3600, 0)
     1819     .
     1820     assign
     1821       v-seconds = v-seconds modulo 3600
     1822     .
     1823     assign
     1824       v-min = truncate(v-seconds / 60, 0)
     1825     .
     1826     assign
     1827       v-seconds = v-seconds modulo 60
     1828     .
     1829     return
     1830         (if v-day-number <> 0
     1831           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1832           else ""
     1833         )
     1834       + (if v-day-number <> 0 or v-hour <> 0
     1835           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1836           else ""
     1837         )
     1838       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1839           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1840           else ""
     1841         )
     1842       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1843       .
     1844   end.
     1845   function cur-time-string returns character
     1846   :
     1847     define variable v-date as date      no-undo .
     1848     define variable v-time as integer   no-undo .
     1849     run cur-time in this-procedure
     1850       (output v-date
     1851       ,output v-time
     1852       ) .
     1853     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1854   end.
     1855   function cur-time-string-sec returns character
     1856   :
     1857     define variable v-date as date      no-undo .
     1858     define variable v-time as integer   no-undo .
     1859     run cur-time in this-procedure
     1860       (output v-date
     1861       ,output v-time
     1862       ) .
     1863     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1864   end.
     1865   function cur-time-custom  returns character
     1866   (input p-prefix as character
     1867   ,input p-date-format as character
     1868   ,input p-delimiter as character
     1869   ,input p-time-format as character
     1870   ,input p-suffix as character
     1871   )
     1872   :
     1873     define variable v-date as date      no-undo .
     1874     define variable v-time as integer   no-undo .
     1875     run cur-time in this-procedure
     1876       (output v-date
     1877       ,output v-time
     1878       ) .
     1879     return
     1880       p-prefix
     1881       + string(v-date, p-date-format)
     1882       + p-delimiter
     1883       + string(v-time, p-time-format)
     1884       + p-suffix
     1885       .
     1886   end.
     1887   function cur-time-print  returns character
     1888   :
     1889     define variable v-date as date      no-undo .
     1890     define variable v-time as integer   no-undo .
     1891     run cur-time in this-procedure
     1892       (output v-date
     1893       ,output v-time
     1894       ) .
     1895     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1896   end.
     1897   function cur-time-datetime returns datetime
     1898   :
     1899     define variable v-char as character no-undo .
     1900     define variable v-datetime as datetime no-undo .
     1901     v-char = cur-time-string().
     1902     v-datetime = datetime(v-char).
     1903     return  v-datetime.
     1904   end.
     1905   function cur-time-string-msec returns character
     1906   :
     1907     define variable v-date as datetime  no-undo .
     1908     v-date = now.
     1909     return string(v-date) .
     1910   end.
     1911   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1912     if num-entries(string(p-dec), '.') = 2
     1913       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1914       else return( string(p-dec)) .
     1915   end function.
     1916   function format-point-to-comma returns char (input orig as char ) .
     1917   define variable rtext as character no-undo .
     1918   define variable strt as integer no-undo .
     1919   define variable leng as integer no-undo .
     1920   assign rtext = orig .
     1921   repeat:
     1922     strt =  index(rtext,'.').
     1923     if strt = 0 then leave.
     1924     leng = 1.
     1925     substring(rtext,strt,leng,"character") = v-delim .
     1926   end.
     1927   return rtext.
     1928   end function.
     1929   function format-excel-text returns char ( input start-text as char ) :
     1930   def var  i    as int no-undo.
     1931   def var  ch   as char no-undo.
     1932   def var  n    as int no-undo.
     1933   def var  ipos as int no-undo.
     1934     n = num-entries(trim(start-text), chr(10)) - 1 .
     1935     do i = 1 to n :
     1936       ipos = index( start-text, chr(10)).
     1937       if ipos > 0 then
     1938         substr( start-text, ipos, 1 ) = ' '.
     1939     end.
     1940     n = num-entries(trim(start-text), chr(13)) - 1 .
     1941     do i = 1 to n :
     1942       ipos = index( start-text, chr(13)).
     1943       if ipos > 0 then
     1944         substr( start-text, ipos, 1 ) = ' '.
     1945     end.
     1946     if index( start-text, '"' ) = 0 then
     1947       start-text =  '="'   + trim( start-text) + '"'   .
     1948       else do:
     1949         n = num-entries(trim(start-text), '"') - 1.
     1950         do i = 1 to n :
     1951           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1952         end.
     1953         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1954         start-text = '="'  + ch  + '"' .
     1955       end.
     1956     return start-text.
     1957   end.
     1958   function excel-sum returns char (input p-dec as decimal ).
     1959     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1960   end function.
     1961   function excel-qnty returns char (input p-dec as decimal ).
     1962     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1963   end function.
     1964   function format-excel-text-macr returns char ( input start-text as char ) :
     1965   def var  i    as int no-undo.
     1966   def var  ch   as char no-undo.
     1967   def var  n    as int no-undo.
     1968   def var  ipos as int no-undo.
     1969     n = num-entries(trim(start-text), chr(10)) - 1 .
     1970     do i = 1 to n :
     1971       ipos = index( start-text, chr(10)).
     1972       if ipos > 0 then
     1973         substring( start-text, ipos , 1 ) = ' '.
     1974     end.
     1975     n = num-entries(trim(start-text), chr(13)) - 1 .
     1976     do i = 1 to n :
     1977       ipos = index( start-text, chr(13)).
     1978       if ipos > 0 then
     1979         substring( start-text, ipos, 1 ) = ' '.
     1980     end.
     1981     if index( start-text, '"' ) = 0 then
     1982       start-text =  '"'   + trim( start-text) + '"'   .
     1983       else do:
     1984         n = num-entries(trim(start-text), '"') - 1.
     1985         do i = 1 to n :
     1986           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1987         end.
     1988         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1989         start-text = '"'  + ch  + '"' .
     1990       end.
     1991     n = num-entries(trim(start-text), chr(10)) - 1 .
     1992     do i = 1 to n :
     1993       ipos = index( start-text, chr(10)).
     1994       if ipos > 0 then
     1995         substring( start-text, ipos , 1 ) = ' '.
     1996     end.
     1997       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1998     return start-text.
     1999   end.
     2000   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2001   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2002   procedure paramls-clear :
     2003     define buffer buf_temp-param for temp-param .
     2004     do
     2005     on error undo, return error return-value
     2006     :
     2007       for each buf_temp-param
     2008       on error undo, return error
     2009       :
     2010         delete buf_temp-param .
     2011       end.
     2012     end.
     2013   end procedure.
     2014   procedure paramls-write :
     2015     define input  parameter p-code     as character no-undo .
     2016     define input  parameter p-sub-code as character no-undo .
     2017     define input  parameter p-value    as character no-undo .
     2018     define buffer buf_temp-param for temp-param .
     2019     do
     2020     on error undo, return error return-value
     2021     :
     2022       find first buf_temp-param
     2023         where buf_temp-param.param-code     = p-code
     2024           and buf_temp-param.param-sub-code = p-sub-code
     2025         no-error .
     2026       if not available buf_temp-param then do:
     2027         create buf_temp-param .
     2028         assign
     2029           buf_temp-param.param-code     = p-code
     2030           buf_temp-param.param-sub-code = p-sub-code
     2031         .
     2032       end.
     2033       assign
     2034         buf_temp-param.param-value = p-value
     2035       .
     2036     end.
     2037   end procedure.
     2038   procedure paramls-read :
     2039     define input  parameter p-code          as character no-undo .
     2040     define input  parameter p-sub-code      as character no-undo .
     2041     define input  parameter p-default-value as character no-undo .
     2042     define output parameter p-value         as character no-undo .
     2043     define buffer buf_temp-param for temp-param .
     2044     do
     2045     on error undo, return error return-value
     2046     :
     2047       find first buf_temp-param
     2048         where buf_temp-param.param-code     = p-code
     2049           and buf_temp-param.param-sub-code = p-sub-code
     2050         no-error .
     2051       if available buf_temp-param then do:
     2052         assign
     2053           p-value = buf_temp-param.param-value
     2054         .
     2055       end.
     2056       else do:
     2057         assign
     2058           p-value = p-default-value
     2059         .
     2060       end.
     2061     end.
     2062   end procedure.
     2063   procedure paramls-append :
     2064     define input  parameter p-code     as character no-undo .
     2065     define input  parameter p-sub-code as character no-undo .
     2066     define input  parameter p-value    as character no-undo .
     2067     define buffer buf_temp-param for temp-param .
     2068     do
     2069     on error undo, return error return-value
     2070     :
     2071       find first buf_temp-param
     2072            where buf_temp-param.param-code     = p-code
     2073              and buf_temp-param.param-sub-code = p-sub-code
     2074         no-error .
     2075       if not available buf_temp-param then do:
     2076         create buf_temp-param .
     2077         assign
     2078           buf_temp-param.param-code     = p-code
     2079           buf_temp-param.param-sub-code = p-sub-code
     2080           buf_temp-param.param-value    = p-value
     2081         .
     2082       end.
     2083       else do:
     2084           assign
     2085               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     2086           .
     2087       end.
     2088     end.
     2089   end procedure.
