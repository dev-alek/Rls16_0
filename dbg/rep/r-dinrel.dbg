     1679   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1680   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1681   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1682   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1683   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
