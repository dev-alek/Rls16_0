      346   define  stream PrnLibStream.
      347   procedure prn-lib-prn-file :
      348     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      349     define input parameter p-DIsabledoptions as integer no-undo .
      350     define variable v-report-name as character no-undo .
      351     define variable v-user-action as character no-undo .
      352     define variable v-printed     as logical   no-undo .
      353     define variable v-exist       as logical   no-undo .
      354     do
      355       on error undo, return error
      356       :
      357       run prn-lib-get-report-name  in this-procedure (
      358         input parParentProc
      359         ,output v-report-name
      360         ).
      361   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      363     (input  v-report-name
      364     ,input  2
      365     ,output v-exist
      366     )  .
      367       if NOT v-exist then
      368       DO:
      369         Message
      370           "Нет заданий на печать ! "
      371           view-as alert-box .
      372         Return  .
      373       End.
      374       run gbl/prnfilen.w
      375         (input  ""
      376         ,input  p-DisabledOptions
      377         ,input  string(v-report-name )
      378         ,input  7
      379         ,output v-user-action
      380         ,output v-printed
      381         ) .
      382       if v-printed then
      383       do:
      384         return "YES" .
      385       end.
      386       else
      387       do:
      388         return "NO" .
      389       end.
      390     end.
      391   end procedure.
      392   procedure prn-lib-open-stream :
      393     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      394     define input parameter p-page-size    as integer no-undo .
      395     define input parameter p-is-stream    as logical no-undo .
      396     define input parameter p-append       as logical no-undo .
      397     define variable v-report-name as character no-undo .
      398     do
      399       on error undo, return error
      400       :
      401       run prn-lib-get-report-name  in this-procedure (
      402         input parParentProc
      403         ,output v-report-name
      404         ).
      405       if p-is-stream then
      406       do:
      407         if p-append then
      408         do:
      409           output stream PrnLibStream to value( v-report-name )
      410             page-size value(p-page-size) append .
      411         end.
      412         if not p-append then
      413         do:
      414           output stream PrnLibStream to value( v-report-name )
      415             page-size value(p-page-size) .
      416         end.
      417       end.
      418       if not p-is-stream then
      419       do:
      420         if p-append then
      421         do:
      422           output to value( v-report-name )
      423             page-size value(p-page-size) append .
      424         end.
      425         if not p-append then
      426         do:
      427           output to value( v-report-name )
      428             page-size value(p-page-size) .
      429         end.
      430       end.
      431     end.
      432   end procedure.
      433   procedure prn-lib-open-exp :
      434     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      435     define input parameter p-is-stream    as logical no-undo .
      436     define input parameter p-is-append    as logical no-undo .
      437     define output parameter p-ReportFileName as char init "report" no-undo.
      438     define output parameter p-process as logical no-undo .
      439     define variable glog as logical no-undo .
      440     do
      441       on error undo, return error
      442       :
      443       SYSTEM-DIALOG GET-FILE p-ReportFileName
      444         TITLE      "Укажите путь"
      445         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      446         ASK-OVERWRITE
      447         CREATE-TEST-FILE
      448         SAVE-AS
      449         USE-FILENAME
      450         DEFAULT-EXTENSION "txt"
      451         UPDATE glog
      452         .
      453       if not glog then  return.
      454       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      455       if p-is-stream then
      456       do:
      457         if p-is-append then
      458         do:
      459           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      460         end.
      461         else
      462         do:
      463           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      464         end.
      465       end.
      466       else
      467       do:
      468         if p-is-append then
      469         do:
      470           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      471         end.
      472         else
      473         do:
      474           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      475         end.
      476       end.
      477       p-process = yes.
      478     end.
      479   end procedure.
      480   procedure prn-lib-get-report-name :
      481     define input parameter parParentProc  as widget-handle no-undo.
      482     define output parameter p-report-name as character no-undo .
      483     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
