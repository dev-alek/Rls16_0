      490   procedure prn-lib-reportviewer :
      491     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      492     define input parameter p-report-name-html as character no-undo .
      493     define input parameter p-param        as character no-undo .
      494     define variable v-excel           as character no-undo init 'TRUE' .
      495     define variable v-value-character as character no-undo .
      496     define variable v-value-integer   as character no-undo .
      497     define variable v-value-date      as date      no-undo .
      498     define variable v-value-decimal   as decimal   no-undo .
      499     define variable rep-excel         as logical   no-undo .
      500     define variable excel-string      as character no-undo .
      501     define variable v-param-type      as character no-undo .
      502     define variable v-tth             as handle    no-undo .
      503     run adm/shattri.p (
      504       input "get":U
      505       ,input  ""
      506       ,input  0
      507       ,input  'report-glob':U
      508       ,input  'rep-excel':U
      509       ,output v-value-character
      510       ,output v-value-date
      511       ,output v-value-decimal
      512       ,output v-value-integer
      513       ,output rep-excel
      514       ,output v-param-type
      515       ,INPUT-OUTPUT table-handle v-tth
      516       )  .
      517     if rep-excel then v-excel = "TRUE" .
      518     else v-excel = "FALSE" .
      519     if p-param eq ""
      520     then
      521        p-param = "EXCEL:" + v-excel.
      522     else
      523        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      524     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      525   end procedure.
