      570   then
      571      mBatchMode = yes.
      572   if mBatchMode = ? then do:
      573     mVisCUrentVin = current-window:visible.
      574     mFameOldVis = mFramBachModHandle:visible.
      575     mFramBachModHandle:visible  = yes.
      576     mBatchMode = mFramBachModHandle:visible ne yes.
      577     mFramBachModHandle:visible = mFameOldVis.
      578     current-window:visible = mVisCUrentVin.
      579   end.
      580    if  log-manager:logfile-name ne ?
      581     then DO:
      582         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      583         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      584         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      585     end.
      586   on choose of B-WaitFramStop in frame waitfram
      587   do:
      588     mWaitFramStop = yes.
      589     mWaitFramStopUser = yes.
      590   end.
      591   function waitfram-check-timeout returns logical():
      592      define variable vtime as int64 no-undo.
      593      if mWaitFramStopTimeOut
      594      then
      595         return yes.
      596      vtime = ( now - mWaitFramStartProc ) / 1000 .
      597      if     mWaitFramTimeOut ne ?
      598         and mWaitFramTimeOut ne 0
      599         and mWaitFramTimeOut lt vtime
      600      then do:
      601         mWaitFramStopTimeOut = yes.
      602      end.
      603      return mWaitFramStopTimeOut.
      604   end.
      605   procedure waitfram-hide :
      606     if not session:batch-mode
      607     then do
      608     on error undo, return error return-value
      609     :
      610       pause 0 before-hide .
      611       if not mBatchMode then
      612         hide frame waitfram .
      613     if     not mWaitFramView
      614        and mWaitProcEvent
      615     then
      616       process events .
      617     end.
      618   end procedure.
      619   procedure waitfram-show :
      620     define input  parameter p-message as character no-undo .
      621     define variable v-left-margin as integer   no-undo .
      622     if not session:batch-mode
      623     then do
      624     on error undo, return error return-value
      625     :
      626       if length(p-message) <= 70 then do:
      627         assign
      628           v-left-margin = integer((70 - length(p-message)) / 2)
      629         .
      630         assign
      631           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      632         .
      633         assign
      634           v-waitfram-action01 = " "
      635           v-waitfram-action02 = " "
      636                                    + fill(" ", v-left-margin)
      637                                    + p-message
      638           v-waitfram-action03 = " "
      639         .
      640       end.
      641       else do:
      642         define variable vRindex1 as integer no-undo.
      643         define variable vRindex2 as integer no-undo.
      644         vRindex1 = r-index(p-message," ",70).
      645         if vRindex1 = 0
      646         then
      647            vRindex1 = 70.
      648         if length(p-message)  <= vRindex1 + 70 then do:
      649           assign
      650             v-waitfram-action01 = " "
      651             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      652             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      653           .
      654         end.
      655         else do:
      656           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      657           if vRindex2 <= vRindex1
      658           then
      659              vRindex2 = vRindex1 + 70.
      660           assign
      661             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      662             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      663             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      664           .
      665         end.
      666       end.
      667       B-viewProcInfo:visible   in frame waitfram = no.
      668       B-viewProcInfo:sensitive in frame waitfram = no.
      669       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      670       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       if  (   mWaitFramView
      672          or  mWaitProcEvent)
      673          and not mBatchMode
      674       then
      675          display
      676             v-waitfram-action01 skip
      677             v-waitfram-action02 skip
      678             v-waitfram-action03 skip
      679          with frame waitfram .
      680       if     mWaitFramView
      681          then do:
      682             if     mWaitFramInterval ne ?
      683                and not mBatchMode
      684             then
      685                wait-for go of frame waitfram pause mWaitFramInterval.
      686          end.
      687          else
      688             if     mWaitProcEvent
      689                and not mBatchMode
      690             then
      691                process events .
      692     end.
      693   end procedure.
      694      procedure waitfram-show-this:
      695         define input  parameter iInterval as int64 no-undo.
      696         define variable vtime as int64 no-undo.
      697         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      698         mWaitFramInterval = iInterval.
      699         run waitfram-show (substitute("&1&2 &3&4" ,
      700                                       mWaitFramTextBeg ,
      701                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      702                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      703                                       mWaitFramTextEnd
      704                                      )
      705                           ).
      706      end.
      707      procedure WaitFramRunPause:
      708         define input  parameter iInterval as dec no-undo.
      709         define variable vStart  as datetime-tz no-undo.
      710         define variable vend    as datetime-tz no-undo.
      711         define variable vint as int64 no-undo.
      712         define variable vOk as logical no-undo.
      713         vStart = now.
      714         vend   = vStart.
      715         publish "WaitFramPause" (iInterval,output vOk).
      716         vend   =  now.
      717         vint = vend - vStart.
      718         vint = iInterval - vint / 1000.
      719         if     not mWaitFramStop
      720            and (   vint > 0
      721                 or (    not vOk
      722                     and iInterval eq ?
      723                     )
      724                 )
      725         then
      726            run waitfram-show-this (iInterval).
      727         vend   =  now.
      728         vint = vend - vStart.
      729         vint = iInterval - vint / 1000.
      730         if     not mWaitFramStop
      731            and vint > 0
      732         then do:
      733            run gbl/pause.p (vint * 1000).
      734         end.
      735         if iInterval ne ?
      736         then
      737            publish "WaitFramStop".
      738         waitfram-check-timeout().
      739      end.
      740      procedure WaitFramWaitFor:
      741         define input  parameter iInterval as dec no-undo.
      742         assign
      743            mWaitFramStartProc   = now
      744            mWaitFramStopUser    = no
      745            mWaitFramStopTimeOut = no
      746         .
      747         block-wait:
      748         do while not mWaitFramStop:
      749            run WaitFramRunPause (iInterval).
      750            if  waitfram-check-timeout()
      751            then do:
      752               leave block-wait.
      753            end.
      754         end.
      755         run waitfram-hide.
      756      end.
      757   procedure waitfram-join :
      758     define input  parameter p-line-1  as character no-undo .
      759     define input  parameter p-line-2  as character no-undo .
      760     define input  parameter p-line-3  as character no-undo .
      761     define output parameter p-message as character no-undo .
      762     do
      763     on error undo, return error return-value
      764     :
      765       assign
      766         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      767                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      769       .
      770     end.
      771   end procedure.
      772   function waitfram-join-function returns character
      773     (input p-line-1 as character
      774     ,input p-line-2 as character
      775     ,input p-line-3 as character
      776     ).
      777     define variable v-message as character no-undo .
      778     run waitfram-join in this-procedure
      779       (input  p-line-1
      780       ,input  p-line-2
      781       ,input  p-line-3
      782       ,output v-message
      783       ) .
      784     return v-message .
      785   end function .
      786   DEFINE VARIABLE p-host-code AS INTEGER   NO-UNDO.
      787   DEFINE VARIABLE p-obj-type  AS CHARACTER NO-UNDO.
      788   DEFINE VARIABLE p-obj-code  AS INTEGER   NO-UNDO.
      789   DEFINE TEMP-TABLE gds-brutto NO-UNDO
      790       FIELD artic         LIKE ub.goods.artic
      791       FIELD prod-type     LIKE ub.parts.prod-type
      792       FIELD prod-code     LIKE ub.parts.prod-code
      793       FIELD gds-name      LIKE ub.goods.gds-name
      794       FIELD unit          LIKE ub.goods.unit-base
      795       FIELD tnved         LIKE ub.goods.tnved
      796       FIELD in-qnty       LIKE ub.parts.fact-qnty
      797       FIELD out-qnty      LIKE ub.parts.fact-qnty
      798       FIELD spi-qnty      LIKE ub.parts.fact-qnty
      799       INDEX art IS PRIMARY artic ASCENDING
      800       .
      801   DEFINE BUFFER l-gds-brutto FOR gds-brutto.
      802   DEFINE BUFFER in-doc FOR ub.trn-doc.
      803   define variable conf-par as char no-undo.
      804   define variable par-type as char no-undo.
      805   define variable in-out-spi-qnty like ub.parts.fact-qnty no-undo.
      806   define variable v-line-rec as recid no-undo .
      807   DEFINE BUFFER out-parts FOR ub.parts.
      808   DEFINE BUFFER spi-parts FOR ub.parts.
      809   DEFINE BUFFER out-doc FOR ub.trn-doc.
      810   DEFINE BUFFER spi-doc FOR ub.trn-doc.
      811   DEFINE BUTTON b-excel DEFAULT
      812        LABEL "Excel"
      813        size 9 by 1.
      814   DEFINE BUTTON b-help DEFAULT
      815        LABEL "Помо&щь"
      816        size 10 by 1.
      817   DEFINE BUTTON b-print DEFAULT
      818        LABEL "Пе&чать"
      819        size 10 by 1.
      820   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      821        LABEL "Вы&ход "
      822        size 10 by 1
      823        BGCOLOR 8 .
      824   DEFINE VARIABLE loc-art AS CHARACTER FORMAT "X(16)":U
      825        LABEL "Начало артикула"
      826        VIEW-AS FILL-IN
      827        size 17 by 1
      828        FGCOLOR 12  NO-UNDO.
      829   DEFINE VARIABLE loc-code AS CHARACTER FORMAT "X(13)":U
      830        LABEL "Бар-код (весь)"
      831        VIEW-AS FILL-IN
      832        size 14 by 1
      833        FGCOLOR 12  NO-UNDO.
      834   DEFINE VARIABLE loc-name AS CHARACTER FORMAT "X(50)":U
      835        LABEL "Начало названия"
      836        VIEW-AS FILL-IN
      837        size 20 by 1
      838        FGCOLOR 12  NO-UNDO.
      839   DEFINE VARIABLE a-n-c AS CHARACTER
      840        VIEW-AS RADIO-SET HORIZONTAL
      841        RADIO-BUTTONS
      842             "&А", "art",
      843   "&Н", "name",
      844   "&К", "code"
      845        size 15 by 1 NO-UNDO.
      846   DEFINE QUERY br-gds-brutto FOR
      847         gds-brutto SCROLLING.
      848   DEFINE BROWSE br-gds-brutto
      849     QUERY br-gds-brutto DISPLAY
      850         gds-brutto.artic         COLUMN-LABEL "Артикул! "
      851   gds-brutto.gds-name      COLUMN-LABEL "Название товара! " FORMAT "x(25)"
      852   gds-brutto.unit          COLUMN-LABEL "Ед.!Изм." FORMAT "X(5)"
      853   gds-brutto.in-qnty       COLUMN-LABEL "Приход!количество" FORMAT "->,>>>,>>9.<<<"
      854   gds-brutto.out-qnty      COLUMN-LABEL "Реализация!количество" FORMAT "->,>>>,>>9.<<<"
      855   gds-brutto.spi-qnty      COLUMN-LABEL "Списание!количество" FORMAT "->,>>>,>>9.<<<"
      856   gds-brutto.in-qnty - gds-brutto.out-qnty - gds-brutto.spi-qnty @
      857   in-out-spi-qnty          COLUMN-LABEL "Остаток!количествo" FORMAT "->,>>>,>>9.<<<"
      858       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 11.75.
      859   DEFINE FRAME v-suppl
      860        a-n-c at row 2.5 col 2 NO-LABEL
      861        loc-name at row 2.5 col 33.5 COLON-ALIGNED
      862        br-gds-brutto AT ROW 3.71 COL 1.38
      863        b-excel at row 1.17 col 33.25
      864        b-print at row 1.17 col 12
      865        b-help at row 1.17 col 22.5
      866        b-quit at row 1.17 col 2
      867        loc-code at row 2.5 col 33.5 COLON-ALIGNED
      868        loc-art at row 2.5 col 33.5 COLON-ALIGNED
      869       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      870            SIDE-LABELS NO-UNDERLINE THREE-D
      871            size 98.88 by 15.79
      872            TITLE "".
      873   ASSIGN
      874          FRAME v-suppl:SCROLLABLE       = FALSE
      875          FRAME v-suppl:HIDDEN           = TRUE.
      876   ASSIGN
      877          loc-art:HIDDEN IN FRAME v-suppl           = TRUE.
      878   ASSIGN
      879          loc-code:HIDDEN IN FRAME v-suppl           = TRUE.
      880   ASSIGN
      881          loc-name:HIDDEN IN FRAME v-suppl           = TRUE.
      882   ON WINDOW-CLOSE OF FRAME v-suppl
      883   DO:
      884     APPLY "END-ERROR":U TO SELF.
      885   END.
      886   ON CHOOSE OF b-excel IN FRAME v-suppl
      887   DO:
      888   DEFINE VARIABLE chExcelApplication      AS COM-HANDLE.
      889   DEFINE VARIABLE chWorkbook              AS COM-HANDLE.
      890   DEFINE VARIABLE chWorksheet             AS COM-HANDLE.
      891   DEFINE VARIABLE iColumn                 AS INTEGER INITIAL 1.
      892   DEFINE VARIABLE cColumn                 AS CHARACTER.
      893   DEFINE VARIABLE cRange                  AS CHARACTER.
      894   CREATE "Excel.Application" chExcelApplication no-error.
      895       if error-status :error then do:
      896           message
      897           "Ошибка при запуске Excel" skip
      898           error-status :get-message(1) skip
      899           view-as alert-box error .
      900           return no-apply .
      901       end.
      902   chExcelApplication:Visible = TRUE.
      903   chWorkbook = chExcelApplication:Workbooks:Add().
      904   chWorkSheet = chExcelApplication:Sheets:Item(1).
      905   chWorkSheet:Columns("A":U):ColumnWidth = 17.
      906   chWorkSheet:Columns("B":U):ColumnWidth = 10.
      907   chWorkSheet:Columns("C":U):ColumnWidth = 16.
      908   chWorkSheet:Columns("D":U):ColumnWidth = 40.
      909   chWorkSheet:Columns("E":U):ColumnWidth = 3.
      910   chWorkSheet:Columns("F":U):ColumnWidth = 16.
      911   chWorkSheet:Columns("G":U):ColumnWidth = 15.
      912   chWorkSheet:Columns("H":U):ColumnWidth = 15.
      913   chWorkSheet:Columns("I":U):ColumnWidth = 15.
      914   chWorkSheet:Range("A1:I1"):Font:Bold = TRUE.
      915   chWorkSheet:Range("A1":U):Value = "Номер по порядку".
      916   chWorkSheet:Range("B1":U):Value = "ТаможКод".
      917   chWorkSheet:Range("C1":U):Value = "Артикул".
      918   chWorkSheet:Range("D1":U):Value = "Торговое наименование".
      919   chWorkSheet:Range("E1":U):Value = "Ед".
      920   chWorkSheet:Range("F1":U):Value = "Общее количество".
      921   chWorkSheet:Range("G1":U):Value = "Реализовано".
      922   chWorkSheet:Range("H1":U):Value = "Списано".
      923   chWorkSheet:Range("I1":U):Value = "Остаток".
      924   FOR EACH gds-brutto:
      925       iColumn = iColumn + 1.
      926       cColumn = STRING(iColumn).
      927       cRange = "A":U + cColumn.
      928       chWorkSheet:Range(cRange):Value = iColumn - 1.
      929       cRange = "B":U + cColumn.
      930       chWorkSheet:Range(cRange):Value = gds-brutto.tnved.
      931       cRange = "C":U + cColumn.
      932       chWorkSheet:Range(cRange):Value = gds-brutto.artic.
      933       cRange = "D":U + cColumn.
      934       chWorkSheet:Range(cRange):Value = gds-brutto.gds-name.
      935       cRange = "E":U + cColumn.
      936       chWorkSheet:Range(cRange):Value = gds-brutto.unit.
      937       cRange = "F":U + cColumn.
      938       chWorkSheet:Range(cRange):Value = gds-brutto.in-qnty.
      939       cRange = "G":U + cColumn.
      940       chWorkSheet:Range(cRange):Value = gds-brutto.out-qnty.
      941       cRange = "H":U + cColumn.
      942       chWorkSheet:Range(cRange):Value = gds-brutto.spi-qnty.
      943       cRange = "I":U + cColumn.
      944       chWorkSheet:Range(cRange):Value = gds-brutto.in-qnty - gds-brutto.out-qnty - gds-brutto.spi-qnty.
      945   END.
      946   RELEASE OBJECT chWorksheet NO-ERROR.
      947   RELEASE OBJECT chWorkbook NO-ERROR.
      948   chExcelApplication :QUIT().
      949   RELEASE OBJECT  chExcelApplication  NO-ERROR.
      950   END.
      951   ON CHOOSE OF b-print IN FRAME v-suppl
      952   DO:
      953   define variable num-order as int no-undo.
      954   define variable sym1 as char init ":"   no-undo.
      955   define variable sym2 as char init ":"   no-undo.
      956   define variable sym3 as char init ":"   no-undo.
      957   define variable sym4 as char init ":"   no-undo.
      958   define variable sym5 as char init ":"   no-undo.
      959   define variable sym6 as char init ":"   no-undo.
      960   define variable sym7 as char init ":"   no-undo.
      961   define variable sym8 as char init ":"   no-undo.
      962   define variable sym9 as char init ":"   no-undo.
      963   define variable sym10 as char init ":"   no-undo.
      964   define variable Line as char no-undo.
      965   define variable varTemp as char no-undo.
      966   DEFINE FRAME gds-brutto
      967         sym1 column-label ":!:" format "X(1)"
      968         num-order COLUMN-LABEL "Номер по!порядку "
      969         sym2 column-label ":!:" format "X(1)"
      970         gds-brutto.tnved COLUMN-LABEL "Таможенный!код"
      971         sym3 column-label ":!:" format "X(1)"
      972         gds-brutto.artic COLUMN-LABEL "Артикул"
      973         sym4 column-label ":!:" format "X(1)"
      974         gds-brutto.gds-name COLUMN-LABEL "Торговое!наименование!"
      975         sym5 column-label ":!:" format "X(1)"
      976         gds-brutto.unit COLUMN-LABEL "ЕдИзм"
      977         sym6 column-label ":!:" format "X(1)"
      978         gds-brutto.in-qnty COLUMN-LABEL "Общее!кол-во"
      979         sym7 column-label ":!:" format "X(1)"
      980         gds-brutto.out-qnty COLUMN-LABEL "Реализовано"
      981         sym8 column-label ":!:" format "X(1)"
      982         gds-brutto.spi-qnty COLUMN-LABEL "Списано"
      983         sym9 column-label ":!:" format "X(1)"
      984         in-out-spi-qnty COLUMN-LABEL "Остаток"
      985         sym10 column-label ":!:" format "X(1)"
      986       HEADER
      987           cur-time-print() AT 5 format "X(35)"
      988           string( "Отчет по ГТД: " + parcst-code) AT 45 format "X(50)"
      989           string( "Количества указаны в " + (if parcst-units = "Базовая" then "базовых еденицах." else "таможенных еденицах.") ) AT 100 format "X(42)"
      990           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 150 format "X(13)" SKIP
      991           Line format "X(169)" AT 1
      992       with width 232 down stream-io.
      993   if session:set-wait-state("COMPILER") then.
      994   assign Line = fill("-", 232).
      995   run prn-lib-open-stream in this-procedure ( input ParParentProc, input 43, input yes, input no ).
      996   FORM with FRAME gds-brutto .
      997   FORM HEADER
      998       Line format "X(169)" AT 1 SKIP
      999       "Продолжение - на следующей странице" AT 60 SKIP
     1000       with FRAME BottomFrame width 232
     1001       PAGE-BOTTOM no-labels no-box.
     1002   VIEW STREAM PrnLibStream FRAME BottomFrame .
     1003   PUT STREAM PrnLibStream
     1004       string( "Отчет за дату: " + string(pardate,"99/99/9999"))
     1005       AT 37 format "X(169)" SKIP(1).
     1006       ASSIGN num-order = 0.
     1007   FOR EACH gds-brutto:
     1008         ASSIGN num-order = num-order + 1.
     1009         DISPLAY STREAM PrnLibStream
     1010         sym1
     1011         num-order
     1012         sym2
     1013         gds-brutto.tnved
     1014         sym3
     1015         gds-brutto.artic
     1016         sym4
     1017         gds-brutto.gds-name
     1018         sym5
     1019         gds-brutto.unit
     1020         sym6
     1021         gds-brutto.in-qnty
     1022         sym7
     1023         gds-brutto.out-qnty
     1024         sym8
     1025         gds-brutto.spi-qnty
     1026         sym9
     1027         gds-brutto.in-qnty - gds-brutto.out-qnty - gds-brutto.spi-qnty @ in-out-spi-qnty
     1028         sym10
     1029         with FRAME gds-brutto .
     1030         DOWN STREAM PrnLibStream 1 with FRAME gds-brutto  .
     1031   END.
     1032   PUT STREAM PrnLibStream Line format "X(169)" SKIP.
     1033   DOWN STREAM PrnLibStream 1 with FRAME gds-brutto  .
     1034   HIDE STREAM PrnLibStream FRAME BottomFrame .
     1035   OUTPUT STREAM PrnLibStream CLOSE.
     1036   if session:set-wait-state("") then.
     1037   run prn-lib-prn-file in this-procedure ( input ParParentProc, input 0 ).
     1038   APPLY "ENTRY" TO BROWSE br-gds-brutto.
     1039   END.
     1040   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   on help of frame v-suppl
     1042   do:
     1043     run gbl/app_help.p
     1044       (input this-procedure :file-name
     1045       ,input ''
     1046       ,input ?
     1047       ) no-error.
     1048     if error-status :error then do:
     1049       message
     1050         "Ошибка при вызове помощи"
     1051         error-status :get-message(1)
     1052         view-as alert-box .
     1053     end.
     1054   end.
     1055   run minbtn-set in this-procedure .
     1056   on choose of b-help in frame v-suppl
     1057   do:
     1058     apply "help":u to frame v-suppl .
     1059   end.
     1060   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1061   procedure minbtn-set :
     1062       do
     1063           on error undo, return error return-value
     1064           :
     1065           define variable ii              as integer       no-undo .
     1066           define variable fh              as widget-handle no-undo .
     1067           define variable hh              as widget-handle no-undo .
     1068           define variable v-h             as handle        extent 4 no-undo .
     1069           define variable v-name-button   as character     no-undo .
     1070           define variable v-help-old-x    as decimal       no-undo .
     1071           define variable v-help-old-y    as decimal       no-undo .
     1072           define variable v-help-old-size as decimal       no-undo .
     1073           define variable v-frame-width   as decimal       no-undo .
     1074           define variable jj              as integer       no-undo .
     1075           do
     1076               on error undo, return error
     1077               :
     1078               assign
     1079                   v-frame-width = frame v-suppl:width - 0.3
     1080                   fh            = frame v-suppl:first-child
     1081                   hh            = fh:first-child
     1082                   ii            = 1
     1083                   .
     1084               do while valid-handle(hh):
     1085                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1086                   do:
     1087                       case lc(hh:name) :
     1088                           when "b-help" then
     1089                               do:
     1090                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1091                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1092                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1093                                   hh:TOOLTIP = "Помощь" .
     1094                                   v-help-old-x = hh:column .
     1095                                   v-help-old-y = hh:row    .
     1096                                   v-help-old-size = hh:width .
     1097                                   hh:width-chars = 2.5 .
     1098                               end.
     1099                           when "b-print" then
     1100                               do:
     1101                                   hh:load-image("cmp/b-print.bmp":u) .
     1102                                   hh:TOOLTIP = "Печать" .
     1103                                   v-h[ii] = hh:handle .
     1104                                   ii = ii + 1 .
     1105                                   hh:width-chars = 3 .
     1106                               end.
     1107                           when "b-history" or
     1108                           when "b-hist" then
     1109                               do:
     1110                                   hh:load-image("cmp/b-hist.bmp":u) .
     1111                                   hh:TOOLTIP = "История" .
     1112                                   v-h[ii] = hh:handle .
     1113                                   ii = ii + 1 .
     1114                                   hh:width-chars = 3 .
     1115                               end.
     1116                           when "b-sch" then
     1117                               do:
     1118                                   hh:load-image("cmp/b-sch.bmp":u) .
     1119                                   hh:TOOLTIP = "Установка Фильтра" .
     1120                                   v-h[ii] = hh:handle .
     1121                                   ii = ii + 1 .
     1122                                   hh:width-chars = 3 .
     1123                               end.
     1124                           when "b-hist-user" then
     1125                               do:
     1126                                   hh:load-image("cmp/b-hist.bmp":u) .
     1127                                   hh:TOOLTIP = "История пользователя" .
     1128                                   ii = ii + 1 .
     1129                               end.
     1130                       end case.
     1131                   end.
     1132                   hh = hh:next-sibling.
     1133               end.
     1134               b-help:column = v-frame-width - b-help:width-chars.
     1135               jj = 0.
     1136               repeat ii = 4 to 1 by -1 :
     1137                   if valid-handle (v-h[ii] ) then
     1138                   do:
     1139                       jj  = jj + 1 .
     1140                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1141                       v-h[ii]:row    = v-help-old-y .
     1142                   end.
     1143               end.
     1144           end.
     1145       end.
     1146   end procedure.
     1147   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1148   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1149   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1150   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1151   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1152   define variable v-diasize-current-frame-height as decimal   no-undo .
     1153   define variable v-diasize-change-size          as logical   no-undo .
     1154   define variable v-diasize-resize-button        as handle    no-undo .
     1155   define variable v-diasize-wndmax               as logical   no-undo .
     1156   define variable v-diasize-wndstore             as logical   no-undo .
     1157   define variable v-diasize-proc-name            as character no-undo .
     1158   define variable v-diasize-browse-handle        as handle    no-undo .
     1159   define variable v-diasize-browse-number        as integer   no-undo .
     1160   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1161   define temp-table temp-diasize-handle no-undo
     1162     field handle-value  as handle
     1163     field save-position as decimal
     1164     index xpk is primary unique handle-value
     1165     .
     1166   define temp-table temp-browse-handle no-undo
     1167     field browse-type   as character
     1168     field browse-number as integer
     1169     field browse-handle as handle
     1170     field original-size as decimal
     1171     index xpk is primary unique browse-type browse-number
     1172     index xie browse-type browse-handle
     1173   .
     1174   procedure diasize_change-height :
     1175     define input  parameter p-change-value  as decimal   no-undo .
     1176     define input  parameter p-move-resize   as logical   no-undo .
     1177     define variable v-field-group-handle    as handle    no-undo .
     1178     define variable v-object-handle         as handle    no-undo .
     1179     define variable v-frame-height          as decimal   no-undo .
     1180     define variable v-frame-virtual-height  as decimal   no-undo .
     1181     define variable v-browse-height         as decimal   no-undo .
     1182     define variable v-window-height         as decimal   no-undo .
     1183     define variable v-window-virtual-height as decimal   no-undo .
     1184     define variable v-change-sign           as integer   no-undo .
     1185     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1186     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1187     if p-change-value > 0
     1188     then do:
     1189       if frame v-suppl :height + p-change-value
     1190           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1191       then do:
     1192         assign
     1193           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1194                           - (frame v-suppl :height-chars)
     1195         .
     1196         if p-change-value <= 0
     1197         then do:
     1198           run diasize_position-resize-button in this-procedure .
     1199           return .
     1200         end.
     1201       end.
     1202     end.
     1203     if p-change-value < 0
     1204     then do:
     1205       if frame v-suppl :height + p-change-value < v-diasize-orig-frame-height
     1206       then do:
     1207         assign
     1208           p-change-value = v-diasize-orig-frame-height
     1209                          - (frame v-suppl :height-chars)
     1210         .
     1211         if p-change-value >= 0
     1212         then do:
     1213           run diasize_position-resize-button in this-procedure .
     1214           return .
     1215         end.
     1216       end.
     1217     end.
     1218     if p-change-value >= 0
     1219     then do:
     1220       assign
     1221         v-change-sign = 1
     1222       .
     1223     end.
     1224     else do:
     1225       assign
     1226         v-change-sign = -1
     1227       .
     1228     end.
     1229     assign
     1230       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1231     .
     1232     if p-change-value = 0
     1233     then do:
     1234       run diasize_position-resize-button in this-procedure .
     1235       return .
     1236     end.
     1237     move_block:
     1238     do
     1239     on error undo move_block, retry move_block
     1240     :
     1241       if retry
     1242       then do:
     1243         do
     1244         on error undo move_block, leave move_block
     1245         :
     1246           if p-change-value > 0
     1247           then do:
     1248             for each buf_temp-diasize-handle
     1249             on error undo, next
     1250             :
     1251               assign
     1252                 v-object-handle = buf_temp-diasize-handle.handle-value
     1253               .
     1254               if v-object-handle <> v-diasize-resize-button
     1255               then do:
     1256                 assign
     1257                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1258                 .
     1259               end.
     1260             end.
     1261             assign
     1262               v-diasize-browse-handle :height = v-browse-height
     1263             .
     1264             for each buf_temp-browse-handle
     1265               where buf_temp-browse-handle.browse-type = 'height':u
     1266             on error undo, next
     1267             :
     1268               assign
     1269                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1270               .
     1271             end.
     1272             assign
     1273               frame v-suppl :height = v-frame-height
     1274             .
     1275             if frame v-suppl :scrollable = true
     1276             then do:
     1277               assign
     1278                 frame v-suppl :virtual-height = v-frame-virtual-height
     1279               .
     1280             end.
     1281             run diasize_position-resize-button in this-procedure .
     1282           end.
     1283           else do:
     1284             if frame v-suppl :scrollable = true
     1285             then do:
     1286               assign
     1287                 frame v-suppl :virtual-height = v-frame-virtual-height
     1288               .
     1289             end.
     1290             assign
     1291               frame v-suppl :height = v-frame-height
     1292             .
     1293             assign
     1294               v-diasize-browse-handle :height = v-browse-height
     1295             .
     1296             for each buf_temp-browse-handle
     1297               where buf_temp-browse-handle.browse-type = 'height':u
     1298             on error undo, next
     1299             :
     1300               assign
     1301                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1302               .
     1303             end.
     1304             for each buf_temp-diasize-handle
     1305             on error undo, next
     1306             :
     1307               assign
     1308                 v-object-handle = buf_temp-diasize-handle.handle-value
     1309               .
     1310               if v-object-handle <> v-diasize-resize-button
     1311               then do:
     1312                 assign
     1313                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1314                 .
     1315               end.
     1316             end.
     1317             run diasize_position-resize-button in this-procedure .
     1318           end.
     1319           assign
     1320             v-diasize-change-size = false
     1321           .
     1322           leave move_block .
     1323         end.
     1324       end.
     1325       assign
     1326         v-diasize-need-full-display = true
     1327       .
     1328       if v-diasize-change-size = false
     1329       then do:
     1330         assign
     1331           v-diasize-change-size = true
     1332         .
     1333       end.
     1334       else do:
     1335         return .
     1336       end.
     1337       assign
     1338         v-frame-height = frame v-suppl :height
     1339         v-frame-virtual-height = frame v-suppl :virtual-height
     1340         v-browse-height = v-diasize-browse-handle :height
     1341       .
     1342       for each buf_temp-browse-handle
     1343         where buf_temp-browse-handle.browse-type = 'height':u
     1344       :
     1345         assign
     1346           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1347         .
     1348       end.
     1349       for each buf_temp-diasize-handle
     1350       :
     1351         delete buf_temp-diasize-handle .
     1352       end.
     1353       assign
     1354         v-field-group-handle = frame v-suppl :first-child
     1355       .
     1356       do while valid-handle(v-field-group-handle)
     1357       :
     1358         assign
     1359           v-object-handle = v-field-group-handle :first-child
     1360         .
     1361         do while valid-handle(v-object-handle)
     1362         :
     1363           if  v-object-handle <> v-diasize-browse-handle :handle
     1364           and can-query(v-object-handle, "row")
     1365           and can-query(v-object-handle, "height")
     1366           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1367           then do:
     1368             find first buf_temp-browse-handle
     1369               where buf_temp-browse-handle.browse-type   = 'height':u
     1370                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1371               no-error .
     1372             if available buf_temp-browse-handle
     1373             then do:
     1374             end.
     1375             else do:
     1376               create buf_temp-diasize-handle .
     1377               assign
     1378                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1379                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1380               .
     1381             end.
     1382           end.
     1383           assign
     1384             v-object-handle = v-object-handle :next-sibling
     1385           .
     1386         end.
     1387         assign
     1388           v-field-group-handle = v-field-group-handle :next-sibling
     1389         .
     1390       end.
     1391       do with frame v-suppl
     1392       :
     1393         hide v-diasize-resize-button .
     1394         assign
     1395           v-diasize-resize-button :row    = 1
     1396           v-diasize-resize-button :column = 1
     1397         .
     1398       end.
     1399       if p-change-value > 0
     1400       then do:
     1401         if frame v-suppl :scrollable = true
     1402         then do:
     1403           assign
     1404             frame v-suppl :virtual-height = frame v-suppl :virtual-height + p-change-value
     1405             no-error .
     1406           if error-status :error
     1407           or error-status :get-message(1) <> ""
     1408           then do:
     1409             undo move_block, retry move_block .
     1410           end.
     1411         end.
     1412         assign
     1413           frame v-suppl :height = frame v-suppl :height + p-change-value
     1414           no-error .
     1415         if error-status :error
     1416         or error-status :get-message(1) <> ""
     1417         then do:
     1418           undo move_block, retry move_block .
     1419         end.
     1420         assign
     1421           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1422           no-error .
     1423         if error-status :error
     1424         or error-status :get-message(1) <> ""
     1425         then do:
     1426           undo move_block, retry move_block .
     1427         end.
     1428         for each buf_temp-browse-handle
     1429           where buf_temp-browse-handle.browse-type = 'height':u
     1430         on error undo move_block, retry move_block
     1431         :
     1432           assign
     1433             buf_temp-browse-handle.browse-handle :height
     1434               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1435             no-error .
     1436           if error-status :error
     1437           or error-status :get-message(1) <> ""
     1438           then do:
     1439             undo move_block, retry move_block .
     1440           end.
     1441         end.
     1442         for each buf_temp-diasize-handle
     1443         on error undo move_block, retry move_block
     1444         :
     1445           assign
     1446             v-object-handle = buf_temp-diasize-handle.handle-value
     1447           .
     1448           if v-object-handle <> v-diasize-resize-button
     1449           then do:
     1450             assign
     1451               v-object-handle :row = v-object-handle :row + p-change-value
     1452               no-error .
     1453             if error-status :error
     1454             or error-status :get-message(1) <> ""
     1455             then do:
     1456               undo move_block, retry move_block .
     1457             end.
     1458           end.
     1459         end.
     1460       end.
     1461       else do:
     1462         for each buf_temp-diasize-handle
     1463         on error undo move_block, retry move_block
     1464         :
     1465           assign
     1466             v-object-handle = buf_temp-diasize-handle.handle-value
     1467           .
     1468           if v-object-handle <> v-diasize-resize-button
     1469           then do:
     1470             assign
     1471               v-object-handle :row = v-object-handle :row + p-change-value
     1472               no-error .
     1473             if error-status :error
     1474             or error-status :get-message(1) <> ""
     1475             then do:
     1476               undo move_block, retry move_block .
     1477             end.
     1478           end.
     1479         end.
     1480         assign
     1481           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1482           no-error .
     1483         if error-status :error
     1484         or error-status :get-message(1) <> ""
     1485         then do:
     1486           undo move_block, retry move_block .
     1487         end.
     1488         for each buf_temp-browse-handle
     1489           where buf_temp-browse-handle.browse-type = 'height':u
     1490         on error undo move_block, retry move_block
     1491         :
     1492           assign
     1493             buf_temp-browse-handle.browse-handle :height
     1494               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1495             no-error .
     1496           if error-status :error
     1497           or error-status :get-message(1) <> ""
     1498           then do:
     1499             undo move_block, retry move_block .
     1500           end.
     1501         end.
     1502         assign
     1503           frame v-suppl :height = frame v-suppl :height + p-change-value
     1504           no-error .
     1505         if error-status :error
     1506         or error-status :get-message(1) <> ""
     1507         then do:
     1508           undo move_block, retry move_block .
     1509         end.
     1510         if frame v-suppl :scrollable = true
     1511         then do:
     1512           assign
     1513             frame v-suppl :virtual-height = frame v-suppl :virtual-height + p-change-value
     1514             no-error .
     1515           if error-status :error
     1516           or error-status :get-message(1) <> ""
     1517           then do:
     1518             undo move_block, retry move_block .
     1519           end.
     1520         end.
     1521       end.
     1522       if p-move-resize = true
     1523       then do:
     1524         run diasize_position-resize-button in this-procedure .
     1525       end.
     1526       if v-diasize-wndstore = true
     1527       then do:
     1528         if connected("ub") = true
     1529         then do:
     1530           define variable v-cntxt-db-num        as integer   no-undo .
     1531           define variable v-cntxt-userid        as character no-undo .
     1532           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1533                                             , OUTPUT v-cntxt-userid
     1534                                             ) .
     1535           run gbl/wndsizew.p
     1536             (input  v-cntxt-db-num
     1537             ,input  v-cntxt-userid
     1538             ,input  v-diasize-proc-name
     1539             ,input  'height':u
     1540             ,input  string(frame v-suppl :height - v-diasize-orig-frame-height)
     1541             ) .
     1542         end.
     1543       end.
     1544     end.
     1545     assign
     1546       v-diasize-change-size = false
     1547     .
     1548   end procedure.
     1549   procedure diasize_set-height :
     1550     define input  parameter p-new-height  as decimal   no-undo .
     1551     define input  parameter p-move-resize as logical   no-undo .
     1552     do
     1553     on error undo, return error return-value
     1554     :
     1555       run diasize_change-height in this-procedure
     1556         (input  (p-new-height - frame v-suppl :height)
     1557         ,input  p-move-resize
     1558         ) .
     1559     end.
     1560   end procedure.
     1561   procedure diasize_change-width :
     1562     define input  parameter p-change-value as decimal   no-undo .
     1563     define input  parameter p-move-resize  as logical   no-undo .
     1564     define variable v-field-group-handle   as handle    no-undo .
     1565     define variable v-object-handle        as handle    no-undo .
     1566     define variable v-frame-width          as decimal   no-undo .
     1567     define variable v-frame-virtual-width  as decimal   no-undo .
     1568     define variable v-browse-width         as decimal   no-undo .
     1569     define variable v-window-width         as decimal   no-undo .
     1570     define variable v-window-virtual-width as decimal   no-undo .
     1571     define variable v-change-sign          as integer   no-undo .
     1572     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1573     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1574     if p-change-value > 0
     1575     then do:
     1576       if frame v-suppl :width + p-change-value >
     1577           session :width-chars
     1578       then do:
     1579         assign
     1580           p-change-value = session :width-chars - frame v-suppl :width
     1581         .
     1582         if p-change-value <= 0
     1583         then do:
     1584           run diasize_position-resize-button in this-procedure .
     1585           return .
     1586         end.
     1587       end.
     1588     end.
     1589     if p-change-value < 0
     1590     then do:
     1591       if frame v-suppl :width + p-change-value < v-diasize-orig-frame-width
     1592       then do:
     1593         assign
     1594           p-change-value = v-diasize-orig-frame-width
     1595                          - frame v-suppl :width
     1596         .
     1597         if p-change-value >= 0
     1598         then do:
     1599           run diasize_position-resize-button in this-procedure .
     1600           return .
     1601         end.
     1602       end.
     1603     end.
     1604     if p-change-value >= 0
     1605     then do:
     1606       assign
     1607         v-change-sign = 1
     1608       .
     1609     end.
     1610     else do:
     1611       assign
     1612         v-change-sign = -1
     1613       .
     1614     end.
     1615     assign
     1616       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1617     .
     1618     if p-change-value = 0
     1619     then do:
     1620       run diasize_position-resize-button in this-procedure .
     1621       return .
     1622     end.
     1623     move_block:
     1624     do
     1625     on error undo move_block, leave move_block
     1626     :
     1627       if retry
     1628       then do:
     1629         do
     1630         on error undo move_block, leave move_block
     1631         :
     1632           if p-change-value > 0
     1633           then do:
     1634             for each buf_temp-diasize-handle
     1635             on error undo, next
     1636             :
     1637               assign
     1638                 v-object-handle = buf_temp-diasize-handle.handle-value
     1639               .
     1640               if v-object-handle <> v-diasize-resize-button
     1641               then do:
     1642                 assign
     1643                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1644                 .
     1645               end.
     1646             end.
     1647             assign
     1648               v-diasize-browse-handle :width = v-browse-width
     1649             .
     1650             for each buf_temp-browse-handle
     1651               where buf_temp-browse-handle.browse-type = 'width':u
     1652             on error undo, next
     1653             :
     1654               assign
     1655                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1656               .
     1657             end.
     1658             assign
     1659               frame v-suppl :width = v-frame-width
     1660             .
     1661             if frame v-suppl :scrollable = true
     1662             then do:
     1663               assign
     1664                 frame v-suppl :virtual-width = v-frame-virtual-width
     1665               .
     1666             end.
     1667             run diasize_position-resize-button in this-procedure .
     1668           end.
     1669           else do:
     1670             if frame v-suppl :scrollable = true
     1671             then do:
     1672               assign
     1673                 frame v-suppl :virtual-width = v-frame-virtual-width
     1674               .
     1675             end.
     1676             assign
     1677               frame v-suppl :width = v-frame-width
     1678             .
     1679             for each buf_temp-browse-handle
     1680               where buf_temp-browse-handle.browse-type = 'width':u
     1681             on error undo, next
     1682             :
     1683               assign
     1684                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1685               .
     1686             end.
     1687             assign
     1688               v-diasize-browse-handle :width = v-browse-width
     1689             .
     1690             for each buf_temp-diasize-handle
     1691             on error undo, next
     1692             :
     1693               assign
     1694                 v-object-handle = buf_temp-diasize-handle.handle-value
     1695               .
     1696               if v-object-handle <> v-diasize-resize-button
     1697               then do:
     1698                 assign
     1699                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1700                 .
     1701               end.
     1702             end.
     1703             run diasize_position-resize-button in this-procedure .
     1704           end.
     1705           assign
     1706             v-diasize-change-size = false
     1707           .
     1708           leave move_block .
     1709         end.
     1710       end.
     1711       assign
     1712         v-diasize-need-full-display = true
     1713       .
     1714       if v-diasize-change-size = false
     1715       then do:
     1716         assign
     1717           v-diasize-change-size = true
     1718         .
     1719       end.
     1720       else do:
     1721         return .
     1722       end.
     1723       assign
     1724         v-frame-width = frame v-suppl :width
     1725         v-frame-virtual-width = frame v-suppl :virtual-width
     1726         v-browse-width = v-diasize-browse-handle :width
     1727       .
     1728       for each buf_temp-browse-handle
     1729         where buf_temp-browse-handle.browse-type = 'width':u
     1730       :
     1731         assign
     1732           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1733         .
     1734       end.
     1735       for each buf_temp-diasize-handle
     1736       :
     1737         delete buf_temp-diasize-handle .
     1738       end.
     1739       assign
     1740         v-field-group-handle = frame v-suppl :first-child
     1741       .
     1742       do while valid-handle(v-field-group-handle)
     1743       :
     1744         assign
     1745           v-object-handle = v-field-group-handle :first-child
     1746         .
     1747         do while valid-handle(v-object-handle)
     1748         :
     1749           if  v-object-handle <> v-diasize-browse-handle :handle
     1750           and v-object-handle <> v-diasize-resize-button
     1751           and can-query(v-object-handle, "row")
     1752           and can-query(v-object-handle, "height")
     1753           and ( v-object-handle :col + v-object-handle :width
     1754                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1755               )
     1756           then do:
     1757             find first buf_temp-browse-handle
     1758               where buf_temp-browse-handle.browse-type   = 'width':u
     1759                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1760               no-error .
     1761             if available buf_temp-browse-handle
     1762             then do:
     1763             end.
     1764             else do:
     1765               create buf_temp-diasize-handle .
     1766               assign
     1767                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1768                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1769               .
     1770             end.
     1771           end.
     1772           assign
     1773             v-object-handle = v-object-handle :next-sibling
     1774           .
     1775         end.
     1776         assign
     1777           v-field-group-handle = v-field-group-handle :next-sibling
     1778         .
     1779       end.
     1780       do with frame v-suppl
     1781       :
     1782         hide v-diasize-resize-button .
     1783         v-diasize-resize-button :row = 1.
     1784         v-diasize-resize-button :column = 1.
     1785       end.
     1786       if p-change-value > 0
     1787       then do:
     1788         if frame v-suppl :scrollable = true
     1789         then do:
     1790           assign
     1791             frame v-suppl :virtual-width = frame v-suppl :virtual-width + p-change-value
     1792             no-error .
     1793           if error-status :error
     1794           or error-status :get-message(1) <> ""
     1795           then do:
     1796             undo move_block, retry move_block.
     1797           end.
     1798         end.
     1799         assign
     1800           frame v-suppl :width = v-frame-width + p-change-value
     1801           no-error .
     1802         if error-status :error
     1803         or error-status :get-message(1) <> ""
     1804         then do:
     1805           undo move_block, retry move_block.
     1806         end.
     1807         assign
     1808           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1809         no-error .
     1810         if error-status :error
     1811         or error-status :get-message(1) <> ""
     1812         then do:
     1813           undo move_block, retry move_block.
     1814         end.
     1815         for each buf_temp-browse-handle
     1816           where buf_temp-browse-handle.browse-type = 'width':u
     1817         on error undo move_block, retry move_block
     1818         :
     1819           assign
     1820             buf_temp-browse-handle.browse-handle :width
     1821               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1822             no-error .
     1823           if error-status :error
     1824           or error-status :get-message(1) <> ""
     1825           then do:
     1826             undo move_block, retry move_block .
     1827           end.
     1828         end.
     1829         for each buf_temp-diasize-handle
     1830         on error undo move_block, retry move_block
     1831         :
     1832           assign
     1833             v-object-handle = buf_temp-diasize-handle.handle-value
     1834           .
     1835           if v-object-handle <> v-diasize-resize-button
     1836           then do:
     1837             assign
     1838               v-object-handle :col = v-object-handle :col + p-change-value
     1839               no-error .
     1840             if error-status :error
     1841             or error-status :get-message(1) <> ""
     1842             then do:
     1843               undo move_block, retry move_block .
     1844             end.
     1845           end.
     1846         end.
     1847       end.
     1848       else do:
     1849         for each buf_temp-diasize-handle
     1850         on error undo move_block, retry move_block
     1851         :
     1852           assign
     1853             v-object-handle = buf_temp-diasize-handle.handle-value
     1854           .
     1855           if v-object-handle <> v-diasize-resize-button
     1856           then do:
     1857             assign
     1858               v-object-handle :col = v-object-handle :col + p-change-value
     1859               no-error .
     1860             if error-status :error
     1861             or error-status :get-message(1) <> ""
     1862             then do:
     1863               undo move_block, retry move_block .
     1864             end.
     1865           end.
     1866         end.
     1867         for each buf_temp-browse-handle
     1868           where buf_temp-browse-handle.browse-type = 'width':u
     1869         on error undo move_block, retry move_block
     1870         :
     1871           assign
     1872             buf_temp-browse-handle.browse-handle :width
     1873               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1874             no-error .
     1875           if error-status :error
     1876           or error-status :get-message(1) <> ""
     1877           then do:
     1878             undo move_block, retry move_block .
     1879           end.
     1880         end.
     1881         assign
     1882           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1883           no-error .
     1884         if error-status :error
     1885         or error-status :get-message(1) <> ""
     1886         then do:
     1887           undo move_block, retry move_block.
     1888         end.
     1889         assign
     1890           frame v-suppl :width = frame v-suppl :width + p-change-value
     1891         no-error .
     1892         if error-status :error
     1893         or error-status :get-message(1) <> ""
     1894         then do:
     1895           undo move_block, retry move_block.
     1896         end.
     1897         if frame v-suppl :scrollable = true
     1898         then do:
     1899           assign
     1900             frame v-suppl :virtual-width = frame v-suppl :virtual-width + p-change-value
     1901           no-error .
     1902           if error-status :error
     1903           or error-status :get-message(1) <> ""
     1904           then do:
     1905             undo move_block, retry move_block.
     1906           end.
     1907         end.
     1908       end.
     1909       if p-move-resize
     1910       then do:
     1911         run diasize_position-resize-button in this-procedure .
     1912       end.
     1913       if v-diasize-wndstore = true
     1914       then do:
     1915         if connected("ub") = true
     1916         then do:
     1917           define variable v-cntxt-db-num        as integer   no-undo .
     1918           define variable v-cntxt-userid        as character no-undo .
     1919           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1920                                             , OUTPUT v-cntxt-userid
     1921                                             ) .
     1922           run gbl/wndsizew.p
     1923             (input  v-cntxt-db-num
     1924             ,input  v-cntxt-userid
     1925             ,input  v-diasize-proc-name
     1926             ,input  'width':u
     1927             ,input  string(frame v-suppl :width - v-diasize-orig-frame-width)
     1928             ) .
     1929         end.
     1930       end.
     1931     end.
     1932     assign
     1933       v-diasize-change-size = false
     1934     .
     1935   end procedure.
     1936   procedure diasize_set-width :
     1937     define input  parameter p-new-width  as decimal   no-undo .
     1938     define input  parameter p-move-resize as logical   no-undo .
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       run diasize_change-width in this-procedure
     1943         (input  (p-new-width - frame v-suppl :width)
     1944         ,input  p-move-resize
     1945         ) .
     1946     end.
     1947   end procedure.
     1948   procedure diasize_position-resize-button :
     1949     do with frame v-suppl
     1950     :
     1951       hide v-diasize-resize-button .
     1952       assign
     1953         v-diasize-resize-button :row = frame v-suppl :height - v-diasize-resize-button :height
     1954                     - 1
     1955                     - (frame v-suppl :border-bottom-pixels / session :pixels-per-row)
     1956         v-diasize-resize-button :col = frame v-suppl :width - v-diasize-resize-button :width
     1957                     - 1
     1958                     - (frame v-suppl :border-right-pixels / session :pixels-per-column)
     1959       .
     1960       view v-diasize-resize-button .
     1961     end.
     1962   end procedure.
     1963   on alt-right anywhere
     1964   do:
     1965     run diasize_change-width in this-procedure
     1966       (input 1
     1967       ,input true
     1968       ) .
     1969     return no-apply .
     1970   end.
     1971   on alt-left anywhere
     1972   do:
     1973     run diasize_change-width in this-procedure
     1974       (input -1
     1975       ,input true
     1976       ) .
     1977     return no-apply .
     1978   end.
     1979   on alt-down anywhere
     1980   do:
     1981     run diasize_change-height in this-procedure
     1982       (input 1
     1983       ,input true
     1984       ) .
     1985     return no-apply .
     1986   end.
     1987   on alt-up anywhere
     1988   do:
     1989     run diasize_change-height in this-procedure
     1990       (input -1
     1991       ,input true
     1992       ) .
     1993     return no-apply .
     1994   end.
     1995   on alt-enter of frame v-suppl
     1996   do:
     1997     run diasize_maximize in this-procedure
     1998       (input  ?
     1999       ).
     2000     return no-apply .
     2001   end.
     2002   procedure diasize_end-move :
     2003     do
     2004     on error undo, return error return-value
     2005     :
     2006       define variable v-row-delta as decimal   no-undo .
     2007       define variable v-col-delta as decimal   no-undo .
     2008       define variable v-new-row as decimal   no-undo .
     2009       define variable v-new-col as decimal   no-undo .
     2010       assign
     2011         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2012         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2013       .
     2014       assign
     2015         v-row-delta = v-new-row - frame v-suppl :height
     2016         v-col-delta = v-new-col - frame v-suppl :width
     2017       .
     2018       run diasize_change-height in this-procedure
     2019         (input v-row-delta
     2020         ,input true
     2021         ) .
     2022       run diasize_change-width in this-procedure
     2023         (input v-col-delta
     2024         ,input true
     2025         ) .
     2026     end.
     2027   end procedure.
     2028   procedure diasize_maximize :
     2029     define input  parameter p-action as logical   no-undo .
     2030     do
     2031     on error undo, return error return-value
     2032     :
     2033       if p-action = ?
     2034       then do:
     2035         if v-diasize-need-maximize = true
     2036         then do:
     2037           assign
     2038             p-action = true
     2039           .
     2040         end.
     2041         else do:
     2042           assign
     2043             p-action = false
     2044           .
     2045         end.
     2046       end.
     2047       if p-action = true
     2048       then do:
     2049         run diasize_change-height in this-procedure
     2050           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2051               - frame v-suppl :height-chars
     2052           ,input true
     2053           ) .
     2054         run diasize_change-width in this-procedure
     2055           (input session :width-chars
     2056               - frame v-suppl :width-chars
     2057           ,input true
     2058           ) .
     2059         assign
     2060           v-diasize-need-maximize = false
     2061         .
     2062       end.
     2063       else do:
     2064         run diasize_change-width in this-procedure
     2065           (input v-diasize-orig-frame-width
     2066               - frame v-suppl :width-chars
     2067           ,input true
     2068           ) .
     2069         run diasize_change-height in this-procedure
     2070           (input v-diasize-orig-frame-height
     2071               - frame v-suppl :height-chars
     2072           ,input true
     2073           ) .
     2074         assign
     2075           v-diasize-need-maximize = true
     2076         .
     2077       end.
     2078     end.
     2079   end procedure.
     2080   procedure diasize_restore-orig-size :
     2081     do
     2082     on error undo, return error return-value
     2083     :
     2084       assign
     2085         v-diasize-current-frame-width  = frame v-suppl :width
     2086         v-diasize-current-frame-height = frame v-suppl :height
     2087       .
     2088       run diasize_set-height in this-procedure
     2089         (input  v-diasize-orig-frame-height
     2090         ,input  true
     2091         ) .
     2092       run diasize_set-width in this-procedure
     2093         (input  v-diasize-orig-frame-width
     2094         ,input  true
     2095         ) .
     2096     end.
     2097   end procedure.
     2098   procedure diasize_restore-current-size :
     2099     do
     2100     on error undo, return error return-value
     2101     :
     2102       run diasize_set-height in this-procedure
     2103         (input  v-diasize-current-frame-height
     2104         ,input  true
     2105         ) .
     2106       run diasize_set-width in this-procedure
     2107         (input  v-diasize-current-frame-width
     2108         ,input  true
     2109         ) .
     2110     end.
     2111   end procedure.
     2112   procedure diasize_set-browse-handle :
     2113     define input  parameter p-browse-handle as handle   no-undo .
     2114     define buffer buf_temp-browse-handle for temp-browse-handle .
     2115     do
     2116     on error undo, return error return-value
     2117     :
     2118       assign
     2119         v-diasize-browse-handle = p-browse-handle
     2120       .
     2121       for each buf_temp-browse-handle
     2122       on error undo, return error return-value
     2123       :
     2124         delete buf_temp-browse-handle .
     2125       end.
     2126     end.
     2127   end procedure.
     2128   procedure diasize_add_browse :
     2129     define input  parameter p-browse-type   as character no-undo .
     2130     define input  parameter p-browse-handle as handle    no-undo .
     2131     define buffer buf_temp-browse-handle for temp-browse-handle .
     2132     do
     2133     on error undo, return error return-value
     2134     :
     2135       assign
     2136         v-diasize-browse-number = v-diasize-browse-number + 1
     2137       .
     2138       create buf_temp-browse-handle .
     2139       assign
     2140         buf_temp-browse-handle.browse-type   = p-browse-type
     2141         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2142         buf_temp-browse-handle.browse-handle = p-browse-handle
     2143       .
     2144     end.
     2145   end procedure.
     2146   procedure diasize_init :
     2147     define variable v-default-value    as logical   no-undo .
     2148     define variable v-restore-saved    as logical   no-undo .
     2149     define variable v-resize-value-str as character no-undo .
     2150     do
     2151     on error undo, return error return-value
     2152     :
     2153       do with frame v-suppl
     2154       :
     2155         assign
     2156           v-diasize-orig-frame-height = frame v-suppl :height
     2157           v-diasize-orig-frame-width  = frame v-suppl :width
     2158           v-diasize-browse-handle     = browse br-gds-brutto :handle
     2159         .
     2160         create button v-diasize-resize-button
     2161         assign
     2162           parent        = frame v-suppl :first-child
     2163           label         = "s"
     2164           height-pixels = 16
     2165           width-pixels  = 16
     2166           visible       = true
     2167           sensitive     = true
     2168           movable       = true
     2169           triggers:
     2170             on end-move persistent run diasize_end-move in this-procedure .
     2171           end triggers.
     2172         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2173         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2174         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2175         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2176         assign
     2177           v-diasize-wndmax = false
     2178         .
     2179         if connected("ub") = true
     2180         then do:
     2181           define variable v-cntxt-db-num        as integer   no-undo .
     2182           define variable v-cntxt-userid        as character no-undo .
     2183           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2184                                             , OUTPUT v-cntxt-userid
     2185                                             ) .
     2186           run gbl/wndpar_r.p
     2187             (input  v-cntxt-db-num
     2188             ,input  v-cntxt-userid
     2189             ,input  'wndmax':U
     2190             ,output v-diasize-wndmax
     2191             ,output v-default-value
     2192             ) .
     2193         end.
     2194         assign
     2195           v-diasize-wndstore = false
     2196         .
     2197         if connected("ub") = true
     2198         then do:
     2199           run gbl/wndpar_r.p
     2200             (input  v-cntxt-db-num
     2201             ,input  v-cntxt-userid
     2202             ,input  'wndstore':U
     2203             ,output v-diasize-wndstore
     2204             ,output v-default-value
     2205             ) .
     2206         end.
     2207         assign
     2208           v-diasize-proc-name = entry(1, program-name(2), '.')
     2209         .
     2210         if v-diasize-wndstore = true
     2211         then do:
     2212           assign
     2213             v-restore-saved = false
     2214           .
     2215           if connected("ub") = true
     2216           then do:
     2217             run gbl/wndsizer.p
     2218               (input  v-cntxt-db-num
     2219               ,input  v-cntxt-userid
     2220               ,input  v-diasize-proc-name
     2221               ,input  'height':u
     2222               ,output v-resize-value-str
     2223               ) .
     2224             if v-resize-value-str <> '':U
     2225             then do:
     2226               run diasize_change-height in this-procedure
     2227                 (input  integer(v-resize-value-str)
     2228                 ,input  true
     2229                 ) .
     2230               assign
     2231                 v-restore-saved = true
     2232               .
     2233             end.
     2234           end.
     2235           if connected("ub") = true
     2236           then do:
     2237             run gbl/wndsizer.p
     2238               (input  v-cntxt-db-num
     2239               ,input  v-cntxt-userid
     2240               ,input  v-diasize-proc-name
     2241               ,input  'width':u
     2242               ,output v-resize-value-str
     2243               ) .
     2244             if v-resize-value-str <> '':U
     2245             then do:
     2246               run diasize_change-width in this-procedure
     2247                 (input  integer(v-resize-value-str)
     2248                 ,input  true
     2249                 ) .
     2250               assign
     2251                 v-restore-saved = true
     2252               .
     2253             end.
     2254           end.
     2255           if v-restore-saved <> true
     2256           then do:
     2257             if v-diasize-wndmax = true
     2258             then do:
     2259               run diasize_maximize in this-procedure
     2260                 (input  true
     2261                 ) .
     2262             end.
     2263           end.
     2264         end.
     2265         else do:
     2266           if v-diasize-wndmax = true
     2267           then do:
     2268             run diasize_maximize in this-procedure
     2269               (input  true
     2270               ) .
     2271           end.
     2272         end.
     2273       end.
     2274     end.
     2275   end procedure.
     2276   procedure diasize_need-full-display :
     2277     define output parameter p-need-full-display as logical   no-undo .
     2278     do
     2279     on error undo, return error return-value
     2280     :
     2281       assign
     2282         p-need-full-display = v-diasize-need-full-display
     2283       .
     2284       assign
     2285         v-diasize-need-full-display = false
     2286       .
     2287     end.
     2288   end procedure.
     2289   procedure get-context :
     2290      define output parameter p-db-num as integer          no-undo.
     2291      define output parameter p-user-id as character        no-undo.
     2292      define variable v-login               as character    no-undo.
     2293      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2294      define buffer buf_user-login  for ub.user-login .
     2295      do
     2296      on error undo, return error
     2297      :
     2298            FIND FIRST buf_sys-ctrl no-lock.
     2299            ASSIGN
     2300               v-login = USERID("ub")
     2301               p-db-num = buf_sys-ctrl.db-num
     2302            .
     2303            FIND FIRST buf_user-login
     2304                 WHERE buf_user-login.db-num = p-db-num
     2305                   AND buf_user-login.user-login = v-login
     2306                 no-lock
     2307                 no-error
     2308                 .
     2309            IF AVAILABLE buf_user-login
     2310            THEN DO:
     2311               assign
     2312                  p-user-id = buf_user-login.user-id
     2313               .
     2314            END.
     2315      end.
     2316   end procedure.
     2317       run diasize_init in this-procedure .
     2318   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-suppl:PARENT eq ?
     2319   THEN FRAME v-suppl:PARENT = ACTIVE-WINDOW.
     2320   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2321   define variable varscales-pref9 as character no-undo .
     2322   define variable varpgscales-pref9 as character no-undo.
     2323   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2324   define variable varscales-pref-type10 as character no-undo.
     2325   varscales-pref9  = ?.
     2326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2327     (input  'sclspref':u
     2328     ,input  '':u
     2329     ,input  '':u
     2330     ,input  0
     2331     ,input  '':u
     2332     ,input  '':u
     2333     ,input  '':u
     2334     ,input  no
     2335     ,output varscales-pref9
     2336     ,output varscales-pref-type10
     2337     ) no-error .
     2338   if varscales-pref9 = ? then do:
     2339     assign
     2340     varscales-pref9 = '21,23,25':U.
     2341   end.
     2342   define variable varpgscales-pref-type10 as character no-undo.
     2343   varpgscales-pref9  = ?.
     2344   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2345     (input  'scpgpref':u
     2346     ,input  '':u
     2347     ,input  '':u
     2348     ,input  0
     2349     ,input  '':u
     2350     ,input  '':u
     2351     ,input  '':u
     2352     ,input  no
     2353     ,output varpgscales-pref9
     2354     ,output varpgscales-pref-type10
     2355     ) no-error .
     2356   if varpgscales-pref9 = ? then do:
     2357     assign
     2358     varpgscales-pref9 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     2359   end.
     2360   on value-changed of a-n-c in frame v-suppl do:
     2361     run proc-valchg-a-n-c in this-procedure  no-error.
     2362     return no-apply.
     2363   end.
     2364   on any-printable of br-gds-brutto in frame v-suppl do:
     2365     run proc-any-printable-br-gds-brutto in this-procedure   no-error.
     2366     return no-apply.
     2367   end.
     2368   on backspace of br-gds-brutto in frame v-suppl do:
     2369     run proc-backspace-br-gds-brutto in this-procedure   no-error.
     2370     return no-apply.
     2371   end.
     2372   ON return OF loc-code IN FRAME v-suppl do:
     2373     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     2374     return no-apply.
     2375   end.
     2376   ON return, Ctrl-J OF loc-name IN FRAME v-suppl do:
     2377     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     2378     return no-apply.
     2379   end.
     2380   PROCEDURE proc-valchg-a-n-c:
     2381     case input frame v-suppl a-n-c :
     2382       when "art" then do:
     2383         apply "entry" to br-gds-brutto in frame v-suppl.
     2384         hide loc-name loc-code
     2385         in frame v-suppl.
     2386         loc-art = "".
     2387       end.
     2388       when "name" then do:
     2389         enable loc-name with frame v-suppl.
     2390         disp loc-name with frame v-suppl.
     2391         hide loc-art loc-code
     2392         in frame v-suppl.
     2393         apply "entry" to loc-name in frame v-suppl.
     2394       end.
     2395       when "code"
     2396    or when "DataMatrix" then
     2397       do:
     2398         enable loc-code with frame v-suppl.
     2399         disp loc-code with frame v-suppl.
     2400         hide loc-art loc-name
     2401         in frame v-suppl.
     2402         apply "entry" to loc-code in frame v-suppl.
     2403       end.
     2404     end CASE.
     2405   END PROCEDURE.
     2406   PROCEDURE proc-any-printable-br-gds-brutto :
     2407     if input frame v-suppl a-n-c = "art" then do:
     2408       if last-event:label = " " and
     2409          loc-art = "" then
     2410       return error.
     2411       find first l-gds-brutto where
     2412                   l-gds-brutto.artic begins (loc-art + last-event:label)
     2413                  no-lock no-error.
     2414       if available l-gds-brutto then do:
     2415         loc-art = loc-art + last-event:label.
     2416         disp loc-art with frame v-suppl.
     2417         v-line-rec = recid (l-gds-brutto).
     2418         reposition br-gds-brutto to recid v-line-rec no-error.
     2419       end.
     2420     end.
     2421   END PROCEDURE.
     2422   PROCEDURE proc-backspace-br-gds-brutto:
     2423     if input frame v-suppl a-n-c = "art" then do:
     2424       if loc-art = "" then
     2425         return error.
     2426       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     2427       find first l-gds-brutto where
     2428                   l-gds-brutto.artic begins loc-art
     2429                  no-lock.
     2430       disp loc-art with frame v-suppl.
     2431       v-line-rec = recid (l-gds-brutto).
     2432       reposition br-gds-brutto to recid v-line-rec no-error.
     2433     end.
     2434   END PROCEDURE.
     2435   PROCEDURE proc-mouse-dbl-click-loc-code:
     2436   def var str-code as integer no-undo.
     2437   define variable varresult   as character         no-undo.
     2438   define variable vartype-bc  as character         no-undo.
     2439   define variable varweight   as decimal           no-undo.
     2440   define buffer l-goods for ub.goods.
     2441   define buffer l-bar-code for ub.bar-code.
     2442   define buffer buf_bar-code for ub.bar-code .
     2443   define buffer buf_prod-bc for ub.prod-bc.
     2444   define buffer buf_place for ub.place.
     2445     assign
     2446     frame v-suppl
     2447     loc-code
     2448     a-n-c.
     2449     if a-n-c = "datamatrix"
     2450     then do:
     2451   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     2452   (
     2453    input  parparentproc
     2454   ,input  loc-code
     2455   ,input  ?
     2456   ,input  p-obj-type
     2457   ,input  p-obj-code
     2458   ,input  yes
     2459   ,input  no
     2460   ,input  varscales-pref9
     2461   ,input  varpgscales-pref9
     2462   ,output varresult
     2463   ,output vartype-bc
     2464   ,output varweight
     2465   ,buffer buf_bar-code
     2466   ,buffer buf_prod-bc
     2467   ,buffer buf_place
     2468   ) no-error.
     2469        if varresult eq "prod-bc"
     2470        then
     2471           loc-code:screen-value in frame v-suppl = buf_prod-bc.b-str.
     2472     end.
     2473     else do:
     2474   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     2475   (
     2476    input  parparentproc
     2477   ,input  loc-code
     2478   ,input  ?
     2479   ,input  p-obj-type
     2480   ,input  p-obj-code
     2481   ,input  yes
     2482   ,input  no
     2483   ,input  varscales-pref9
     2484   ,input  varpgscales-pref9
     2485   ,output varresult
     2486   ,output vartype-bc
     2487   ,output varweight
     2488   ,buffer buf_bar-code
     2489   ,buffer buf_prod-bc
     2490   ,buffer buf_place
     2491   ) no-error.
     2492   end.
     2493     if available buf_bar-code then do:
     2494           find first l-goods where
     2495                     l-goods.gds-code =
     2496     buf_bar-code.gds-code No-LOCK.
     2497           find first l-gds-brutto where
     2498                     l-gds-brutto.artic = l-goods.artic AND
     2499                     l-gds-brutto.prod-type = l-goods.prod-type AND
     2500                     l-gds-brutto.prod-code = l-goods.prod-code no-lock no-error.
     2501       if available l-gds-brutto then do:
     2502         v-line-rec = recid (l-gds-brutto).
     2503         reposition br-gds-brutto to recid v-line-rec no-error.
     2504       end.
     2505       else do:
     2506         message "Строка не найдена."
     2507                 view-as alert-box error.
     2508       end.
     2509     end.
     2510     else
     2511       message "Бар-код не найден."
     2512               view-as alert-box error.
     2513     apply "entry" to loc-code in frame v-suppl.
     2514   END PROCEDURE.
     2515   PROCEDURE  proc-mouse-dbl-click-loc-name:
     2516     assign
     2517     frame v-suppl
     2518     loc-name.
     2519       if last-event:label = "Ctrl-J" then
     2520         find next l-gds-brutto where
     2521                   can-find (ub.goods where ub.goods.artic = l-gds-brutto.artic and
     2522                   ub.goods.prod-type = l-gds-brutto.prod-type and
     2523                   ub.goods.prod-code = l-gds-brutto.prod-code and
     2524                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     2525       else
     2526         find first l-gds-brutto where
     2527                   can-find (ub.goods where ub.goods.artic = l-gds-brutto.artic and
     2528                   ub.goods.prod-type = l-gds-brutto.prod-type and
     2529                   ub.goods.prod-code = l-gds-brutto.prod-code and
     2530                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     2531       if available l-gds-brutto then do:
     2532         v-line-rec = recid (l-gds-brutto).
     2533         reposition br-gds-brutto to recid v-line-rec no-error.
     2534       end.
     2535       else do:
     2536         message "Строка не найдена."
     2537                 view-as alert-box error.
     2538       end.
     2539     apply "entry" to loc-name in frame v-suppl.
     2540   END PROCEDURE.
     2541   on value-changed of br-gds-brutto in frame v-suppl do:
     2542   if not available gds-brutto or recid (gds-brutto) <> v-line-rec then do:
     2543       hide loc-art in frame v-suppl.
     2544       loc-art = "".
     2545   end.
     2546   end.
     2547   MAIN-BLOCK:
     2548   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2549      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2550   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2551     run mainmenu_getcntxt in parparentproc
     2552       (output v-cntxt-db-num
     2553       ,output v-cntxt-userid
     2554       ,output v-cntxt-level
     2555       ,output v-cntxt-host-code-obj
     2556       ,output v-cntxt-obj-type
     2557       ,output v-cntxt-obj-code
     2558       ,output v-cntxt-db-num-obj
     2559       ,output v-cntxt-is-admin
     2560       ) .
     2561     assign
     2562       p-host-code = v-cntxt-host-code-obj
     2563       p-obj-type  = v-cntxt-obj-type
     2564       p-obj-code  = v-cntxt-obj-code
     2565     .
     2566     RUN calc        IN THIS-PROCEDURE.
     2567     RUN enable_UI   IN THIS-PROCEDURE.
     2568     FRAME v-suppl:TITLE = string( "Отчет о товарах по заданной ГТД №" + parcst-code + " за дату " + string(pardate,"99/99/9999")).
     2569     apply "entry" to br-gds-brutto in frame v-suppl.
     2570     WAIT-FOR GO OF FRAME v-suppl.
     2571   END.
     2572   RUN disable_UI.
     2573   PROCEDURE calc :
     2574   if session:set-wait-state("COMPILER") then.
     2575   run waitfram-show in this-procedure
     2576     (input "Подождите..."
     2577     ).
     2578   FOR EACH ub.trn-doc WHERE ub.trn-doc.host-code = p-host-code AND
     2579                          ub.trn-doc.doc-type  = 'при':U   AND
     2580                          NOT trn-doc.internal  NO-LOCK,
     2581          EACH ub.doc-line WHERE ub.doc-line.doc-code = ub.trn-doc.doc-code NO-LOCK,
     2582           FIRST ub.goods WHERE ub.goods.artic     = ub.doc-line.artic     AND
     2583                             ub.goods.prod-type = ub.doc-line.prod-type AND
     2584                             ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK,
     2585             EACH ub.parts WHERE ub.parts.host-code =  ub.trn-doc.host-code AND
     2586                              ub.parts.in-code   =  ub.trn-doc.doc-code  AND
     2587                              ub.parts.artic     =  ub.goods.artic       AND
     2588                              ub.parts.prod-code =  ub.goods.prod-code   AND
     2589                              ub.parts.prod-type =  ub.goods.prod-type   AND
     2590                              ub.parts.in-code   =  ub.parts.out-code    AND
     2591                              ub.parts.status_   =  yes               AND
     2592                              ub.parts.fact-date <= parDate           AND
     2593                              ub.parts.cst-code  =  parcst-code       NO-LOCK
     2594                              BREAK BY trn-doc.doc-code
     2595                                    BY doc-line.artic:
     2596                FIND FIRST gds-brutto WHERE gds-brutto.artic = ub.parts.artic NO-ERROR.
     2597                IF NOT AVAILABLE gds-brutto THEN DO:
     2598                   CREATE gds-brutto.
     2599                   ASSIGN
     2600                          gds-brutto.artic     = ub.goods.artic
     2601                          gds-brutto.prod-type = ub.parts.prod-type
     2602                          gds-brutto.prod-code = ub.parts.prod-code
     2603                          gds-brutto.gds-name    = ub.goods.gds-name
     2604                          gds-brutto.tnved     = ub.goods.tnved
     2605                          gds-brutto.unit      = ub.goods.unit-base
     2606                          gds-brutto.unit      = (IF parcst-units = "Базовая" THEN ub.goods.unit-base ELSE ub.goods.unit-cst)
     2607                          .
     2608                END.
     2609                ASSIGN gds-brutto.in-qnty = gds-brutto.in-qnty +
     2610                ABSOLUTE(IF parcst-units = "Базовая" THEN ub.parts.fact-qnty ELSE ub.parts.fact-qnty * ub.goods.cst-base-rate).
     2611                IF LAST-OF(doc-line.artic) THEN DO:
     2612                   FOR EACH out-parts WHERE out-parts.host-code = ub.parts.host-code AND
     2613                                            out-parts.artic     = ub.parts.artic     AND
     2614                                            out-parts.prod-type = ub.parts.prod-type AND
     2615                                            out-parts.prod-code = ub.parts.prod-code AND
     2616                                            out-parts.in-code   = ub.parts.in-code   AND
     2617                                            out-parts.status_   = yes             AND
     2618                                            out-parts.fact-date <= parDate NO-LOCK,
     2619                       FIRST out-doc where out-doc.doc-code = out-parts.out-code AND
     2620                                           NOT out-doc.internal  AND
     2621                                           (out-doc.doc-type = 'рас':U OR
     2622                                            out-parts.doc-type = 'возврат':U) NO-LOCK:
     2623                       ACCUMULATE ABSOLUTE(out-parts.fact-qnty) (TOTAL).
     2624                    END.
     2625                   FOR EACH spi-parts WHERE spi-parts.host-code = ub.parts.host-code AND
     2626                                            spi-parts.artic     = ub.parts.artic     AND
     2627                                            spi-parts.prod-type = ub.parts.prod-type AND
     2628                                            spi-parts.prod-code = ub.parts.prod-code AND
     2629                                            spi-parts.in-code   = ub.parts.in-code   AND
     2630                                            spi-parts.status_   = yes             AND
     2631                                            spi-parts.fact-date <= parDate NO-LOCK,
     2632                       FIRST spi-doc where spi-doc.doc-code = spi-parts.out-code AND
     2633                                           NOT spi-doc.internal  AND
     2634                                           spi-doc.doc-type = 'спи':U NO-LOCK:
     2635                       ACCUMULATE ABSOLUTE(spi-parts.fact-qnty) (TOTAL).
     2636                   END.
     2637                END.
     2638                ASSIGN gds-brutto.out-qnty = gds-brutto.out-qnty +
     2639                       ABSOLUTE(IF parcst-units = "Базовая" THEN (ACCUM TOTAL ABSOLUTE(out-parts.fact-qnty)) ELSE (ACCUM TOTAL ABSOLUTE(out-parts.fact-qnty)) * goods.cst-base-rate)
     2640                       gds-brutto.spi-qnty = gds-brutto.spi-qnty +
     2641                       ABSOLUTE(IF parcst-units = "Базовая" THEN (ACCUM TOTAL ABSOLUTE(spi-parts.fact-qnty)) ELSE (ACCUM TOTAL ABSOLUTE(spi-parts.fact-qnty)) * goods.cst-base-rate).
     2642   END.
     2643   run waitfram-hide in this-procedure .
     2644   END PROCEDURE.
     2645   PROCEDURE disable_UI :
     2646     HIDE FRAME v-suppl.
     2647   END PROCEDURE.
     2648   PROCEDURE enable_UI :
     2649     DISPLAY a-n-c
     2650         WITH FRAME v-suppl.
     2651     ENABLE a-n-c br-gds-brutto b-excel b-print b-help b-quit
     2652         WITH FRAME v-suppl.
     2653     VIEW FRAME v-suppl.
     2654     OPEN QUERY br-gds-brutto FOR EACH gds-brutto.
     2655   END PROCEDURE.
