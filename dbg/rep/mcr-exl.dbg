        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: e47eaee10c88, 211, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SShalanin $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Jun 30 11:11:56 2015 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: mcr-exl.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/mcr-exl.p $":U .
        7   define variable vss-description as character no-undo init "Запуск отчета с выводом в excel".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile: mcr-exl.p $ $Revision: e47eaee10c88, 211, rls $".
       63   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
       65   procedure paramls-clear :
       66     define buffer buf_temp-param for temp-param .
       67     do
       68     on error undo, return error return-value
       69     :
       70       for each buf_temp-param
       71       on error undo, return error
       72       :
       73         delete buf_temp-param .
       74       end.
       75     end.
       76   end procedure.
       77   procedure paramls-write :
       78     define input  parameter p-code     as character no-undo .
       79     define input  parameter p-sub-code as character no-undo .
       80     define input  parameter p-value    as character no-undo .
       81     define buffer buf_temp-param for temp-param .
       82     do
       83     on error undo, return error return-value
       84     :
       85       find first buf_temp-param
       86         where buf_temp-param.param-code     = p-code
       87           and buf_temp-param.param-sub-code = p-sub-code
       88         no-error .
       89       if not available buf_temp-param then do:
       90         create buf_temp-param .
       91         assign
       92           buf_temp-param.param-code     = p-code
       93           buf_temp-param.param-sub-code = p-sub-code
       94         .
       95       end.
       96       assign
       97         buf_temp-param.param-value = p-value
       98       .
       99     end.
      100   end procedure.
      101   procedure paramls-read :
      102     define input  parameter p-code          as character no-undo .
      103     define input  parameter p-sub-code      as character no-undo .
      104     define input  parameter p-default-value as character no-undo .
      105     define output parameter p-value         as character no-undo .
      106     define buffer buf_temp-param for temp-param .
      107     do
      108     on error undo, return error return-value
      109     :
      110       find first buf_temp-param
      111         where buf_temp-param.param-code     = p-code
      112           and buf_temp-param.param-sub-code = p-sub-code
      113         no-error .
      114       if available buf_temp-param then do:
      115         assign
      116           p-value = buf_temp-param.param-value
      117         .
      118       end.
      119       else do:
      120         assign
      121           p-value = p-default-value
      122         .
      123       end.
      124     end.
      125   end procedure.
      126   procedure paramls-append :
      127     define input  parameter p-code     as character no-undo .
      128     define input  parameter p-sub-code as character no-undo .
      129     define input  parameter p-value    as character no-undo .
      130     define buffer buf_temp-param for temp-param .
      131     do
      132     on error undo, return error return-value
      133     :
      134       find first buf_temp-param
      135            where buf_temp-param.param-code     = p-code
      136              and buf_temp-param.param-sub-code = p-sub-code
      137         no-error .
      138       if not available buf_temp-param then do:
      139         create buf_temp-param .
      140         assign
      141           buf_temp-param.param-code     = p-code
      142           buf_temp-param.param-sub-code = p-sub-code
      143           buf_temp-param.param-value    = p-value
      144         .
      145       end.
      146       else do:
      147           assign
      148               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      149           .
      150       end.
      151     end.
      152   end procedure.
      153   define input parameter  v-file-name as character no-undo .
      154   define output parameter v-excel-name as character no-undo.
      155   define stream  inStream  .
      156   define variable v-count  as integer no-undo .
      157   do
      158   on error undo, return error return-value
      159   :
      160     define variable v-param-code     as character no-undo .
      161     define variable v-param-sub-code as character no-undo .
      162     define variable v-param-value    as character no-undo .
      163     input stream instream from value (v-file-name) .
      164     repeat
      165     :
      166       assign
      167         v-count = v-count + 1
      168       .
      169       assign
      170         v-param-code     = ''
      171         v-param-sub-code = ''
      172         v-param-value    = ''
      173       .
      174       import stream instream
      175         v-param-code
      176         v-param-sub-code
      177         v-param-value
      178         .
      179       create temp-param .
      180       assign
      181         temp-param.param-code     = v-param-code
      182         temp-param.param-sub-code = v-param-sub-code
      183         temp-param.param-value    = v-param-value
      184       .
      185     end.
      186     input stream instream close .
      187     define variable v-ok as logical   no-undo .
      188       run rep/z-exl.p
      189         (input-output table temp-param,
      190         output v-excel-name
      191         ) .
      192     os-delete value (v-file-name) .
      193     define buffer buf_temp-param for temp-param .
      194     for each buf_temp-param
      195       where buf_temp-param.param-code = "file"
      196     on error undo, return error
      197     :
      198       os-delete value(buf_temp-param.param-value) .
      199     end.
      200   end.
