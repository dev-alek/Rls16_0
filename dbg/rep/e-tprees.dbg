     1201     ASSIGN adm-initial-lock = p-attr-value.
     1202     RETURN.
     1203   END PROCEDURE.
     1204     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1205   ASSIGN
     1206          FRAME F-Main:SCROLLABLE       = FALSE
     1207          FRAME F-Main:HIDDEN           = TRUE.
     1208   ON VALUE-CHANGED OF ap IN FRAME F-Main
     1209   DO:
     1210     run calc-rest.
     1211   END.
     1212   ON VALUE-CHANGED OF ee IN FRAME F-Main
     1213   DO:
     1214     run calc-rest.
     1215   END.
     1216   ON VALUE-CHANGED OF em IN FRAME F-Main
     1217   DO:
     1218     run calc-rest.
     1219   END.
     1220   ON VALUE-CHANGED OF ep IN FRAME F-Main
     1221   DO:
     1222     run calc-rest.
     1223   END.
     1224   ON VALUE-CHANGED OF es IN FRAME F-Main
     1225   DO:
     1226       run calc-rest.
     1227   END.
     1228   ON VALUE-CHANGED OF ev IN FRAME F-Main
     1229   DO:
     1230     run calc-rest.
     1231   END.
     1232   ON VALUE-CHANGED OF ie IN FRAME F-Main
     1233   DO:
     1234     run calc-rest.
     1235   END.
     1236   ON VALUE-CHANGED OF im IN FRAME F-Main
     1237   DO:
     1238     run calc-rest.
     1239   END.
     1240   ON VALUE-CHANGED OF iv IN FRAME F-Main
     1241   DO:
     1242     run calc-rest.
     1243   END.
     1244   ON VALUE-CHANGED OF ot IN FRAME F-Main
     1245   DO:
     1246     run calc-rest.
     1247   END.
     1248   ON VALUE-CHANGED OF pc IN FRAME F-Main
     1249   DO:
     1250     run calc-rest.
     1251   END.
     1252   ON VALUE-CHANGED OF re IN FRAME F-Main
     1253   DO:
     1254     run calc-rest.
     1255   END.
     1256   ON VALUE-CHANGED OF rs IN FRAME F-Main
     1257   DO:
     1258     run calc-rest.
     1259   END.
     1260   ON VALUE-CHANGED OF rv IN FRAME F-Main
     1261   DO:
     1262     run calc-rest.
     1263   END.
     1264   ON VALUE-CHANGED OF vt IN FRAME F-Main
     1265   DO:
     1266       run calc-rest.
     1267   END.
     1268   ON VALUE-CHANGED OF we IN FRAME F-Main
     1269   DO:
     1270     run calc-rest.
     1271   END.
     1272   ON VALUE-CHANGED OF wm IN FRAME F-Main
     1273   DO:
     1274     run calc-rest.
     1275   END.
     1276   if not this-procedure :persistent
     1277   then do:
     1278     message
     1279       vss-workfile vss-revision vss-description skip
     1280       "Ошибка при запуске процедуры" skip
     1281       "Данную процедуру следует запускать только с параметром persistent" skip
     1282       view-as alert-box error .
     1283     undo, return error .
     1284   end.
     1285   define variable  list-com-hand as character no-undo .
     1286   list-com-hand = "" .
     1287   list-com-hand = list-com-hand + string(ie:handle) + "," .
     1288   list-com-hand = list-com-hand + string(ee:handle) + "," .
     1289   list-com-hand = list-com-hand + string(ep:handle) + "," .
     1290   list-com-hand = list-com-hand + string(es:handle) + "," .
     1291   list-com-hand = list-com-hand + string(re:handle) + "," .
     1292   list-com-hand = list-com-hand + string(rs:handle) + "," .
     1293   list-com-hand = list-com-hand + string(we:handle) + "," .
     1294   list-com-hand = list-com-hand + string(vt:handle) + "," .
     1295   list-com-hand = list-com-hand + string(iv:handle) + "," .
     1296   list-com-hand = list-com-hand + string(ev:handle) + "," .
     1297   list-com-hand = list-com-hand + string(rv:handle) + "," .
     1298   list-com-hand = list-com-hand + string(em:handle) + "," .
     1299   list-com-hand = list-com-hand + string(wm:handle) + "," .
     1300   list-com-hand = list-com-hand + string(im:handle) + "," .
     1301   list-com-hand = list-com-hand + string(ot:handle) + "," .
     1302   list-com-hand = list-com-hand + string(ap:handle) + "," .
     1303   list-com-hand = list-com-hand + string(pc:handle) + "," .
     1304   PROCEDURE calc-rest :
     1305   assign FRAME F-Main ie ee ep es re rs we vt iv ev rv em wm im ot ap pc    .
     1306   if  ie
     1307   AND ee
     1308   AND  ep
     1309   AND  es
     1310   AND  re
     1311   AND  rs
     1312   AND  we
     1313   AND  vt
     1314   AND  iv
     1315   AND  ev
     1316   AND  rv
     1317   AND  em
     1318   AND  wm
     1319   AND  im
     1320   AND  ot
     1321   AND  ap
     1322   AND  pc
     1323      then
     1324       do:
     1325           assign CalcRest = yes.
     1326           DISPLAY CalcRest WITH FRAME F-Main.
     1327           ENABLE CalcRest WITH FRAME F-Main.
     1328       end.
     1329   else
     1330       do:
     1331           assign CalcRest = no.
     1332           DISPLAY CalcRest WITH FRAME F-Main.
     1333           DISABLE CalcRest WITH FRAME F-Main.
     1334       end.
     1335   END PROCEDURE.
     1336   PROCEDURE disable_UI :
     1337     HIDE FRAME F-Main.
     1338     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1339   END PROCEDURE.
     1340   PROCEDURE enable_UI :
     1341     DISPLAY ie CostSum ee DispUpFact ep es re rs NullPer we vt iv CalcRest ev rv
     1342             em wm im ot ap pc
     1343         WITH FRAME F-Main.
     1344     ENABLE RECT-10 RECT-12 RECT-16 RECT-15 ie CostSum ee DispUpFact ep es re rs
     1345            NullPer we vt iv CalcRest ev rv em wm im ot ap pc
     1346         WITH FRAME F-Main.
     1347   END PROCEDURE.
     1348   PROCEDURE local-initialize :
     1349     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1350   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   do:
     1352     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1353       (input  v-cntxt-db-num
     1354       ,input  v-cntxt-userid
     1355       ,input  0
     1356       ,input  'actn_reports_lookup-cost':U
     1357       ,input  'object':U
     1358       ,input  v-cntxt-host-code-obj
     1359       ,input  v-cntxt-obj-type
     1360       ,input  v-cntxt-obj-code
     1361       ,input  0
     1362       ,input  0
     1363       ,input  0
     1364       ,input  false
     1365       ,output g#log
     1366       )  .
     1367   end.
     1368      if not  g#log then do :
     1369      CostSum = false .
     1370      DispUpFact = false .
     1371      disable CostSum DispUpFact  with frame F-Main .
     1372      display CostSum  DispUpFact with frame F-Main .
     1373    end.
     1374   define variable lab-handle as handle no-undo .
     1375   define variable i as integer no-undo .
     1376   define variable v-code as character no-undo .
     1377   do i = 1 to num-entries (list-com-hand) :
     1378    lab-handle = widget-handle (entry( i , list-com-hand) ) no-error .
     1379    if valid-handle(lab-handle) = true and  error-status :error = false   then do:
     1380       v-code = lab-handle:name.
     1381       lab-handle:label = func-get-name-from-ext-type ( v-code, true  ) .
     1382       end.
     1383   end.
     1384   run cr-ob (2 , 12 ,
     1385     'Выкуп,Консигнация закупка,Консигнация выгода,Ответственное хранение,Старая консигнация ':L,
     1386      'r':U + "," + 'c':U + "," + 'b':U + "," + 's':U + "," + 'o':U ).
     1387   END PROCEDURE.
     1388   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1389   procedure cr-ob :
     1390    do
     1391    on error undo, return error return-value
     1392    :
     1393   define input parameter p-x as integer no-undo .
     1394   define input parameter p-y as integer no-undo .
     1395   define input parameter type-pr-name as character no-undo .
     1396   define input parameter type-pr-val  as character no-undo .
     1397   define variable l-str as character no-undo .
     1398   define variable i as integer no-undo .
     1399   if type-pr-name = ? then type-pr-name = 'Все,Выкуп,Консигнаци,Консигнация закупка,Консигнация выгода,Ответственное хранение,Старая консигнация':L .
     1400   if type-pr-val  = ?then type-pr-val  = 'all,r,cb,c,b,s,1':U .
     1401   repeat i = 1 to num-entries(type-pr-name) :
     1402    l-str =  l-str  + entry(i ,type-pr-name) + ","  +
     1403                      entry(i ,type-pr-val)  + "," .
     1404   end.
     1405   l-str = substring(l-str,1 , LENGTH (l-str) - 1) .
     1406   if num-entries(l-str) < 2 then do:
     1407       message "Нет архивов по типу приобретения !!!" skip
     1408       vss-include-info15 skip
     1409       view-as alert-box information .
     1410       return 'First-page':U.
     1411      end.
     1412      create radio-set type-pr
     1413      assign
     1414       row    = p-y
     1415       column = p-x
     1416       frame  = frame F-Main:handle
     1417       horizontal    = false
     1418       radio-buttons = l-str
     1419    .
     1420   if valid-handle(type-pr) = false then do:
     1421       message "Нет архивов по типу приобретения !!!" skip
     1422       vss-include-info15 skip
     1423       view-as alert-box information .
     1424       return 'First-page':U.
     1425    end.
     1426     type-pr:sensitive = yes  .
     1427     type-pr:visible   = yes  .
     1428    end.
     1429   end procedure.
     1430   PROCEDURE my-report :
     1431   fOR EACH tdedt: DELETE tdedt. eND.
     1432   IF ie then  do:
     1433   create tdedt.
     1434   assign tdedt.id =  'ie':U
     1435          tdedt.n  = "01"
     1436   .
