     1082   END PROCEDURE.
     1083   PROCEDURE check-modified :
     1084   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1085   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1086   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1087   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1088     IF check-state = "check":U THEN
     1089     DO:
     1090       RUN get-link-handle IN adm-broker-hdl
     1091         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1092            OUTPUT group-target-list).
     1093       IF group-target-list NE "":U THEN
     1094       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1095         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1096         RUN check-modified IN curr-widget ('group-check':U).
     1097         IF RETURN-VALUE NE "":U THEN
     1098         DO:
     1099           RUN check-modified-message(RETURN-VALUE).
     1100           RETURN "":U.
     1101         END.
     1102       END.
     1103     END.
     1104     RETURN "":U.
     1105   END PROCEDURE.
     1106   PROCEDURE check-modified-message :
     1107     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1108        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1109           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1110        IF RETURN-VALUE = "YES":U THEN
     1111           RUN notify ('view,CONTAINER-SOURCE':U).
     1112        MESSAGE IF p-changed-table NE ? THEN
     1113           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1114           ELSE "Current values have been changed."
     1115           SKIP "  Do you wish to save those changes?"
     1116           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1117        IF ANS THEN
     1118        DO:
     1119           IF group-assign-target THEN
     1120             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1121           ELSE RUN dispatch('update-record':U).
     1122           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1123           DO:
     1124               MESSAGE "Changes to the previous record were not saved."
     1125                 VIEW-AS ALERT-BOX ERROR.
     1126               IF group-assign-target THEN
     1127                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1128               ELSE RUN dispatch ('cancel-record':U).
     1129           END.
     1130        END.
     1131        ELSE DO:
     1132          IF group-assign-target THEN
     1133             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1134          ELSE RUN dispatch('cancel-record':U).
     1135        END.
     1136        RETURN.
     1137   END PROCEDURE.
     1138   PROCEDURE get-rowid :
     1139       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1140       ASSIGN
     1141       p-table   =   adm-first-table.
     1142       RETURN.
     1143   END PROCEDURE.
     1144   PROCEDURE init-group-assign :
     1145       RUN request-attribute IN adm-broker-hdl
     1146         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1147       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1148         group-assign-target = yes.
     1149       ELSE group-assign-target = no.
     1150       RETURN.
     1151   END PROCEDURE.
     1152   PROCEDURE set-editors :
     1153       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1154       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1155       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1156       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1157       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1158       DO WHILE VALID-HANDLE (curr-widget):
     1159           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1160              curr-widget:HIDDEN = no THEN DO:
     1161             CASE p-field-setting:
     1162               WHEN "INITIALIZE":U THEN
     1163               DO:
     1164                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1165                     read-only-list +
     1166                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1167                        STRING(curr-widget).
     1168               END.
     1169               WHEN "DISABLE":U OR
     1170               WHEN "ENABLE":U THEN
     1171               DO:
     1172                   curr-widget:SENSITIVE = yes.
     1173                   RUN get-attribute ('Read-Only-Editors':U).
     1174                   IF RETURN-VALUE = ? OR
     1175                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1176                       curr-widget:READ-ONLY =
     1177                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1178               END.
     1179               WHEN "CLEAR":U THEN
     1180                   curr-widget:SCREEN-VALUE = "":U.
     1181             END CASE.
     1182           END.
     1183           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1184       END.
     1185       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1186         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1187           + '"':U).
     1188       RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE use-check-modified-all :
     1191    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1192     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1193     RETURN.
     1194   END PROCEDURE.
     1195   PROCEDURE use-create-on-add :
