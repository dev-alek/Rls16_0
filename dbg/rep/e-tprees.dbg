      677   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   function func-get-name-from-ext-type   returns char
      679     ( p-ext-type as character   ,
      680       p-caps     as logical ).
      681   define variable v-ext-name as character no-undo .
      682   run get-name-from-ext-type in this-procedure (
      683       input p-ext-type  ,
      684       input p-caps  ,
      685       output v-ext-name )
      686       no-error .
      687       if error-status :error then do:
      688          assign
      689            v-ext-name = p-ext-type
      690          .
      691       end.
      692    return (v-ext-name) .
      693   end.
      694   procedure get-name-from-ext-type :
      695    do
      696    on error undo, return error return-value
      697    :
      698   define input  parameter p-ext-type as character no-undo .
      699   define input  parameter p-caps     as logical no-undo   .
      700   define output parameter p-ext-name as character no-undo .
      701   define variable v-num as integer no-undo .
      702     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      703       message
      704         vss-include-info13 skip
      705         "Неправильно задано значение входящего параметра! "
      706         "Нет такого типа документов " p-ext-type
      707         view-as alert-box error .
      708         undo, return error .
      709     end.
      710     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      711     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      712     if p-caps  = true then do :
      713        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      714     end .
      715     end.
      716   end procedure.
      717   DEFINE VARIABLE  type-pr  AS WIDGET-HANDLE.
      718   define variable g#log as logical   no-undo .
      719   CREATE WIDGET-POOL.
      720   def var State-source as  WIDGET-HANDLE.
      721   DEFINE RECTANGLE RECT-10
      722        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      723        SIZE 30.13 BY 4.83.
      724   DEFINE RECTANGLE RECT-12
      725        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      726        SIZE 35 BY 4.83.
      727   DEFINE RECTANGLE RECT-15
      728        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      729        SIZE 35 BY 1.42.
      730   DEFINE RECTANGLE RECT-16
      731        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      732        SIZE 35 BY 1.67.
      733   DEFINE VARIABLE ap AS LOGICAL INITIAL yes
      734        LABEL "переоценка":L
      735        VIEW-AS TOGGLE-BOX
      736        SIZE 26.38 BY .75 NO-UNDO.
      737   DEFINE VARIABLE CalcRest AS LOGICAL INITIAL yes
      738        LABEL "Расчет остатков"
      739        VIEW-AS TOGGLE-BOX
      740        SIZE 32 BY .75 NO-UNDO.
      741   DEFINE VARIABLE CostSum AS LOGICAL INITIAL no
      742        LABEL "Учетные цены"
      743        VIEW-AS TOGGLE-BOX
      744        SIZE 32 BY .75 NO-UNDO.
      745   DEFINE VARIABLE DispUpFact AS LOGICAL INITIAL no
      746        LABEL "Наценка"
      747        VIEW-AS TOGGLE-BOX
      748        SIZE 32 BY .75 NO-UNDO.
      749   DEFINE VARIABLE ee AS LOGICAL INITIAL yes
      750        LABEL "расход внешний":L
      751        VIEW-AS TOGGLE-BOX
      752        SIZE 26.38 BY .75 NO-UNDO.
      753   DEFINE VARIABLE em AS LOGICAL INITIAL yes
      754        LABEL "расход произв.":L
      755        VIEW-AS TOGGLE-BOX
      756        SIZE 26.38 BY .75 NO-UNDO.
      757   DEFINE VARIABLE ep AS LOGICAL INITIAL yes
      758        LABEL "возврат поставщику"
      759        VIEW-AS TOGGLE-BOX
      760        SIZE 26.38 BY .75 NO-UNDO.
      761   DEFINE VARIABLE es AS LOGICAL INITIAL yes
      762        LABEL "касса продажа":L
      763        VIEW-AS TOGGLE-BOX
      764        SIZE 26.38 BY .75 NO-UNDO.
      765   DEFINE VARIABLE ev AS LOGICAL INITIAL yes
      766        LABEL "расход перемещение":L
      767        VIEW-AS TOGGLE-BOX
      768        SIZE 26.38 BY .75 NO-UNDO.
      769   DEFINE VARIABLE ie AS LOGICAL INITIAL yes
      770        LABEL "приход внешний":L
      771        VIEW-AS TOGGLE-BOX
      772        SIZE 26.38 BY .75 NO-UNDO.
      773   DEFINE VARIABLE im AS LOGICAL INITIAL yes
      774        LABEL "приход произв.":L
      775        VIEW-AS TOGGLE-BOX
      776        SIZE 26.38 BY .75 NO-UNDO.
      777   DEFINE VARIABLE iv AS LOGICAL INITIAL yes
      778        LABEL "приход перемещение":L
      779        VIEW-AS TOGGLE-BOX
      780        SIZE 26.38 BY .75 NO-UNDO.
      781   DEFINE VARIABLE NullPer AS LOGICAL INITIAL no
      782        LABEL "не удалять нулевые переоценки"
      783        VIEW-AS TOGGLE-BOX
      784        SIZE 32 BY .75 NO-UNDO.
      785   DEFINE VARIABLE ot AS LOGICAL INITIAL yes
      786        LABEL "переоценка":L
      787        VIEW-AS TOGGLE-BOX
      788        SIZE 26.38 BY .75 NO-UNDO.
      789   DEFINE VARIABLE pc AS LOGICAL INITIAL yes
      790        LABEL "переоценка":L
      791        VIEW-AS TOGGLE-BOX
      792        SIZE 26.38 BY .75 NO-UNDO.
      793   DEFINE VARIABLE re AS LOGICAL INITIAL yes
      794        LABEL "возврат внешний":L
      795        VIEW-AS TOGGLE-BOX
      796        SIZE 26.38 BY .75 NO-UNDO.
      797   DEFINE VARIABLE rs AS LOGICAL INITIAL yes
      798        LABEL "касса возврат":L
      799        VIEW-AS TOGGLE-BOX
      800        SIZE 26.38 BY .75 NO-UNDO.
      801   DEFINE VARIABLE rv AS LOGICAL INITIAL yes
      802        LABEL "возврат перемещение":L
      803        VIEW-AS TOGGLE-BOX
      804        SIZE 26.38 BY .75 NO-UNDO.
      805   DEFINE VARIABLE vt AS LOGICAL INITIAL yes
      806        LABEL "инвентаризация":L
      807        VIEW-AS TOGGLE-BOX
      808        SIZE 26.38 BY .75 NO-UNDO.
      809   DEFINE VARIABLE we AS LOGICAL INITIAL yes
      810        LABEL "списание":L
      811        VIEW-AS TOGGLE-BOX
      812        SIZE 26.38 BY .75 NO-UNDO.
      813   DEFINE VARIABLE wm AS LOGICAL INITIAL yes
      814        LABEL "списан. произв.":L
      815        VIEW-AS TOGGLE-BOX
      816        SIZE 26.38 BY .75 NO-UNDO.
      817   DEFINE FRAME F-Main
      818        ie AT ROW 2.29 COL 38.38
      819        CostSum AT ROW 2.75 COL 2
      820        ee AT ROW 3.33 COL 38.38
      821        DispUpFact AT ROW 3.67 COL 2
      822        ep AT ROW 4.25 COL 38.38
      823        es AT ROW 5.17 COL 38.38
      824        re AT ROW 6.13 COL 38.38
      825        rs AT ROW 7 COL 38.38
      826        NullPer AT ROW 7.88 COL 2.38
      827        we AT ROW 7.92 COL 38.38
      828        vt AT ROW 8.71 COL 38.38
      829        iv AT ROW 9.71 COL 38.38
      830        CalcRest AT ROW 9.75 COL 2.38
      831        ev AT ROW 10.5 COL 38.38
      832        rv AT ROW 11.46 COL 38.38
      833        em AT ROW 12.29 COL 38.38
      834        wm AT ROW 13.13 COL 38.38
      835        im AT ROW 13.92 COL 38.38
      836        ot AT ROW 14.83 COL 38.38
      837        ap AT ROW 15.75 COL 38.38
      838        pc AT ROW 16.71 COL 38.38
      839        "Документы:" VIEW-AS TEXT
      840             SIZE 11 BY .75 AT ROW 1.42 COL 45.38
      841             FGCOLOR 4
      842        "Показать:" VIEW-AS TEXT
      843             SIZE 11 BY .75 AT ROW 1.42 COL 12
      844             FGCOLOR 4
      845        "Тип приобретения:" VIEW-AS TEXT
      846             SIZE 28.88 BY .67 AT ROW 11 COL 2
      847             FGCOLOR 4
      848        RECT-10 AT ROW 11.75 COL 1
      849        RECT-12 AT ROW 1.17 COL 1
      850        RECT-16 AT ROW 7.5 COL 1
      851        RECT-15 AT ROW 9.33 COL 1
      852       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      853            SIDE-LABELS NO-UNDERLINE THREE-D
      854            AT COL 1 ROW 1 SCROLLABLE .
      855   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      856   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      857   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      858   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      859   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      860   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      861   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      862   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      863         adm-object-hdl = FRAME F-Main:HANDLE.
      864   RUN ensure-broker.
      865   THIS-PROCEDURE:ADM-DATA =
      866        'ADM1.1~`':U +
      867        'SmartObject~`':U +
      868        '~`':U +
      869        'NO ~`':U +
      870        '~`':U +
      871        '~`':U +
      872        '~`':U +
      873        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      874           + "~`":U +
      875        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      876        'Record-Source,Record-Target,TableIO-Target~`':U +
      877        '~`':U +
      878        '~`~`~`~`~`~`~`~`~`~`~`':U +
      879        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      880            THEN "^^":U
      881        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      882             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      883   PROCEDURE adm-apply-entry :
      884     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      885   END PROCEDURE.
      886   PROCEDURE adm-destroy :
      887    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      888   END PROCEDURE.
      889   PROCEDURE adm-disable :
      890       DISABLE RECT-10 RECT-12 RECT-16 RECT-15 ie CostSum ee DispUpFact ep es re rs NullPer we vt iv CalcRest ev rv em wm im ot ap pc WITH FRAME F-Main.
      891       RUN dispatch ('disable-fields':U).
      892       RUN set-attribute-list ('ENABLED=no':U).
      893       RETURN.
      894   END PROCEDURE.
      895   PROCEDURE adm-edit-attribute-list :
      896         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      897         RETURN.
      898   END PROCEDURE.
      899   PROCEDURE adm-enable :
      900       ENABLE UNLESS-HIDDEN RECT-10 RECT-12 RECT-16 RECT-15 ie CostSum ee DispUpFact ep es re rs NullPer we vt iv CalcRest ev rv em wm im ot ap pc WITH FRAME F-Main.
      901       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      902       RUN set-attribute-list ('ENABLED=yes':U).
      903       RETURN.
      904   END PROCEDURE.
      905   PROCEDURE adm-exit :
      906        RUN notify ('exit':U).
      907     RETURN.
      908   END PROCEDURE.
      909   PROCEDURE adm-hide :
      910     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      911   END PROCEDURE.
      912   PROCEDURE adm-initialize :
      913     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      914   END PROCEDURE.
      915   PROCEDURE adm-show-errors :
      916       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      917       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      918           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      919       END.
      920       RETURN.
      921   END PROCEDURE.
      922   PROCEDURE adm-UIB-mode :
      923     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      924   END PROCEDURE.
      925   PROCEDURE adm-view :
      926     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      927   END PROCEDURE.
      928   PROCEDURE dispatch :
      929       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      930       RUN broker-dispatch IN adm-broker-hdl
      931           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      932       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      933   END PROCEDURE.
      934   PROCEDURE ensure-broker :
      935   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      936   IF RETURN-VALUE NE "ADM-Broker":U THEN
      937   DO:
      938       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      939       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      940   END.
      941   END PROCEDURE.
      942   PROCEDURE get-attribute :
      943     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      944     RUN broker-get-attribute IN adm-broker-hdl
      945         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      946     RETURN RETURN-VALUE.
      947   END PROCEDURE.
      948   PROCEDURE get-attribute-list :
      949     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      950     RUN broker-get-attribute-list IN adm-broker-hdl
      951         (INPUT THIS-PROCEDURE,
      952          INPUT ?,
      953          OUTPUT p-attr-list) NO-ERROR.
      954     RETURN.
      955   END PROCEDURE.
      956   PROCEDURE new-state :
      957     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      958     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      959     RETURN.
      960   END PROCEDURE.
      961   PROCEDURE notify :
      962     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      963     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      964     IF RETURN-VALUE = "ADM-ERROR":U THEN
      965         RETURN "ADM-ERROR":U.
      966     RETURN.
      967   END PROCEDURE.
      968   PROCEDURE set-attribute-list :
      969     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      970     RUN ensure-broker.
      971     RUN broker-set-attribute-list IN adm-broker-hdl
      972         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      973     RETURN.
      974   END PROCEDURE.
      975   PROCEDURE set-position :
      976       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      977       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      978       IF VALID-HANDLE(adm-object-hdl) THEN
      979       DO:
      980         ASSIGN adm-object-hdl:ROW    =   p-row
      981                adm-object-hdl:COLUMN =   p-col.
      982       END.
      983       RETURN.
      984   END PROCEDURE.
      985   PROCEDURE adm-display-fields :
      986       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      987       RETURN.
      988   END PROCEDURE.
      989   PROCEDURE adm-open-query :
      990     RETURN.
      991   END PROCEDURE.
      992   PROCEDURE adm-row-changed :
      993         IF VALID-HANDLE(adm-object-hdl) THEN
      994           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      995         RUN notify ('row-available':U).
      996         RETURN.
      997   END PROCEDURE.
      998   PROCEDURE reposition-query :
      999       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1000       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1001       RETURN.
     1002   END PROCEDURE.
     1003     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1004     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1005     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1006     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1007     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1008     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1009     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1010     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1011     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1012     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1013     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1014     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1015     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1016     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1017     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1018     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1019     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1020     IF "":U = "":U THEN
     1021       RUN modify-list-attribute IN adm-broker-hdl
     1022         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1023     RUN use-create-on-add(?).
     1024   PROCEDURE adm-add-record :
     1025       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1026          "must have at least one Enabled Table to perform Add.":U
