     1619    run rep/r-tprees.p
     1620                    ( input type-pr:screen-value ,
     1621                      input v-cntxt-obj-code ,
     1622                      input v-cntxt-obj-type ,
     1623                      input base-type ,
     1624                      input base-code ,
     1625                      input ?,
     1626                      input ?,
     1627                      input CostSum,
     1628                      input DispUpFact  ,
     1629                      input ?,
     1630                      input ?,
     1631                      input NullPer,
     1632                      input CalcRest) .
     1633   END PROCEDURE.
     1634   PROCEDURE my-var :
     1635   assign frame F-Main ie ee ep es re rs we vt iv ev rv em wm im ot ap pc
     1636    CostSum DispUpFact
     1637    NullPer CalcRest.
     1638    ReportNAme = "Р Е Е С Т Р   Д О К У М Е Н Т О В   П О   Т И П У   П Р И О Б Р Е Т Е Н И Я - "
     1639    + Caps ( entry( (lookup(type-pr:screen-value ,type-pr:RADIO-BUTTONS) - 1), type-pr:RADIO-BUTTONS )   )
     1640   .
     1641   ReportHeader = IF CostSum     THEN CostSum:label + chr(10) Else "".
     1642   ReportHeader = (ReportHeader) + IF DispUpFact  THEN DispUpFact:label + chr(10) Else "" .
     1643   ReportHeader = (ReportHeader) + IF  NullPer    THEN NullPer:label + chr(10) Else "без нулевых остатков по переоценке" + chr(10) .
     1644   ReportHeader = (ReportHeader) + IF  CalcRest   THEN CalcRest:label + chr(10) Else ""  .
     1645   ReportHeader = (ReportHeader) + "документы : "  + chr(10).
     1646   ReportHeader = (ReportHeader)               + IF  ie THen      (ie:label) + ","  else " " .
     1647   ReportHeader = (ReportHeader)               + IF  ee then      (ee:label) + ","  else " ".
     1648   ReportHeader = (ReportHeader)               + IF  ep then      (ep:label) + ","  else " ".
     1649   ReportHeader = (ReportHeader)               + IF  es THen      (es:label) + ","  else " ".
     1650   ReportHeader = (ReportHeader)               + IF  re then      (re:label) + ","  else " ".
     1651   ReportHeader = (ReportHeader) +  chr(10).
     1652   ReportHeader = (ReportHeader)               + IF  rs then      (rs:label) + ","  else " ".
     1653   ReportHeader = (ReportHeader)               + IF  we THen      (we:label) + ","  else " ".
     1654   ReportHeader = (ReportHeader)               + IF  vt then      (vt:label) + ","  else " ".
     1655   ReportHeader = (ReportHeader)               + IF  iv then      (iv:label) + ","  else " ".
     1656   ReportHeader = (ReportHeader)               + IF  ev THen      (ev:label) + ","  else " ".
     1657   ReportHeader = (ReportHeader) +  chr(10).
     1658   ReportHeader = (ReportHeader)               + IF  rv then      (rv:label) + ","  else " ".
     1659   ReportHeader = (ReportHeader)               + IF  em then      (em:label) + ","  else " " .
     1660   ReportHeader = (ReportHeader)               + IF  wm THen      wm:label + ","  else " " .
     1661   ReportHeader = (ReportHeader)               + IF  im then      im:label + ","  else " ".
     1662   ReportHeader = (ReportHeader)               + IF  ap then      ap:label + ","  else " ".
     1663   ReportHeader = (ReportHeader)               + IF  pc then      pc:label + ","  else " ".
     1664   ReportHeader = (ReportHeader)               + IF  ot then      ot:label        else " " .
     1665   END PROCEDURE.
     1666   PROCEDURE state-changed :
     1667     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1668     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1669     CASE p-state:
     1670     END CASE.
     1671   END PROCEDURE.
