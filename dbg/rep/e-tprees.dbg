     1048   END PROCEDURE.
     1049   PROCEDURE adm-create-record :
     1050      RETURN.
     1051   END PROCEDURE.
     1052   PROCEDURE adm-current-changed :
     1053     RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE adm-delete-record :
