      886   PROCEDURE adm-enable-fields :
      887       RETURN.
      888   END PROCEDURE.
      889   PROCEDURE adm-end-update :
      890     RETURN.
      891   END PROCEDURE.
      892   PROCEDURE adm-reset-record :
      893       RETURN.
