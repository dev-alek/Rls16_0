      868   PROCEDURE adm-create-record :
      869      RETURN.
      870   END PROCEDURE.
      871   PROCEDURE adm-current-changed :
      872     RETURN.
      873   END PROCEDURE.
      874   PROCEDURE adm-delete-record :
      875    MESSAGE
      876          "Object ":U THIS-PROCEDURE:FILE-NAME
      877            "must have at least one Enabled Table to perform Delete.":U
      878              VIEW-AS ALERT-BOX ERROR.
