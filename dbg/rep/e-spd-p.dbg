      673            AT COL 1 ROW 1 SCROLLABLE .
      674   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      675   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      676   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      677   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      678   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      679   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      680   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      681   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      682         adm-object-hdl = FRAME F-Main:HANDLE.
      683   RUN ensure-broker.
      684   THIS-PROCEDURE:ADM-DATA =
      685        'ADM1.1~`':U +
      686        'SmartObject~`':U +
      687        '~`':U +
      688        'NO ~`':U +
      689        '~`':U +
      690        '~`':U +
      691        '~`':U +
      692        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      693           + "~`":U +
      694        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      695        'Record-Source,Record-Target,TableIO-Target~`':U +
      696        '~`':U +
      697        '~`~`~`~`~`~`~`~`~`~`~`':U +
      698        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      699            THEN "^^":U
      700        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      701             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      702   PROCEDURE adm-apply-entry :
      703     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      704   END PROCEDURE.
      705   PROCEDURE adm-destroy :
      706    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      707   END PROCEDURE.
      708   PROCEDURE adm-disable :
      709       DISABLE RECT-8 RECT-7 RECT-6 RECT-5 RADIO-SET-1 FILL-IN-1 NoNull TOGGLE-1 TOGGLE-2 WITH FRAME F-Main.
      710       RUN dispatch ('disable-fields':U).
      711       RUN set-attribute-list ('ENABLED=no':U).
      712       RETURN.
      713   END PROCEDURE.
      714   PROCEDURE adm-edit-attribute-list :
      715         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      716         RETURN.
      717   END PROCEDURE.
      718   PROCEDURE adm-enable :
      719       ENABLE UNLESS-HIDDEN RECT-8 RECT-7 RECT-6 RECT-5 RADIO-SET-1 FILL-IN-1 NoNull TOGGLE-1 TOGGLE-2 WITH FRAME F-Main.
      720       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      721       RUN set-attribute-list ('ENABLED=yes':U).
      722       RETURN.
      723   END PROCEDURE.
      724   PROCEDURE adm-exit :
      725        RUN notify ('exit':U).
      726     RETURN.
      727   END PROCEDURE.
      728   PROCEDURE adm-hide :
      729     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      730   END PROCEDURE.
      731   PROCEDURE adm-initialize :
      732     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      733   END PROCEDURE.
      734   PROCEDURE adm-show-errors :
      735       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      736       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      737           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      738       END.
      739       RETURN.
      740   END PROCEDURE.
      741   PROCEDURE adm-UIB-mode :
      742     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      743   END PROCEDURE.
      744   PROCEDURE adm-view :
      745     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      746   END PROCEDURE.
      747   PROCEDURE dispatch :
      748       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      749       RUN broker-dispatch IN adm-broker-hdl
      750           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      751       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      752   END PROCEDURE.
      753   PROCEDURE ensure-broker :
      754   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      755   IF RETURN-VALUE NE "ADM-Broker":U THEN
      756   DO:
      757       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      758       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      759   END.
      760   END PROCEDURE.
      761   PROCEDURE get-attribute :
      762     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      763     RUN broker-get-attribute IN adm-broker-hdl
      764         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      765     RETURN RETURN-VALUE.
      766   END PROCEDURE.
      767   PROCEDURE get-attribute-list :
      768     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      769     RUN broker-get-attribute-list IN adm-broker-hdl
      770         (INPUT THIS-PROCEDURE,
      771          INPUT ?,
      772          OUTPUT p-attr-list) NO-ERROR.
      773     RETURN.
      774   END PROCEDURE.
      775   PROCEDURE new-state :
      776     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      777     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      778     RETURN.
      779   END PROCEDURE.
      780   PROCEDURE notify :
      781     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      782     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      783     IF RETURN-VALUE = "ADM-ERROR":U THEN
      784         RETURN "ADM-ERROR":U.
      785     RETURN.
      786   END PROCEDURE.
      787   PROCEDURE set-attribute-list :
      788     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      789     RUN ensure-broker.
      790     RUN broker-set-attribute-list IN adm-broker-hdl
      791         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      792     RETURN.
      793   END PROCEDURE.
      794   PROCEDURE set-position :
      795       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      796       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      797       IF VALID-HANDLE(adm-object-hdl) THEN
      798       DO:
      799         ASSIGN adm-object-hdl:ROW    =   p-row
      800                adm-object-hdl:COLUMN =   p-col.
      801       END.
      802       RETURN.
      803   END PROCEDURE.
      804   PROCEDURE adm-display-fields :
      805       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      806       RETURN.
      807   END PROCEDURE.
      808   PROCEDURE adm-open-query :
      809     RETURN.
      810   END PROCEDURE.
      811   PROCEDURE adm-row-changed :
      812         IF VALID-HANDLE(adm-object-hdl) THEN
      813           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      814         RUN notify ('row-available':U).
      815         RETURN.
      816   END PROCEDURE.
      817   PROCEDURE reposition-query :
      818       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      819       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      820       RETURN.
      821   END PROCEDURE.
      822     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      823     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      824     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      825     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      826     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      827     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      828     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      829     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      830     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      831     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      832     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      833     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      834     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      835     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      836     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      837     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      838     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      839     IF "":U = "":U THEN
      840       RUN modify-list-attribute IN adm-broker-hdl
      841         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      842     RUN use-create-on-add(?).
      843   PROCEDURE adm-add-record :
      844       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      845          "must have at least one Enabled Table to perform Add.":U
      846          VIEW-AS ALERT-BOX ERROR.
