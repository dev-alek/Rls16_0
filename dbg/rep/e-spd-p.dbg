      895   PROCEDURE adm-update-record :
      896       MESSAGE
      897         "Object ":U THIS-PROCEDURE:FILE-NAME
      898           "must have at least one Enabled Table to perform Update.":U
      899             VIEW-AS ALERT-BOX ERROR.
      900      RETURN.
      901   END PROCEDURE.
      902   PROCEDURE check-modified :
      903   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      904   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      905   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      906   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      907     IF check-state = "check":U THEN
      908     DO:
      909       RUN get-link-handle IN adm-broker-hdl
      910         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      911            OUTPUT group-target-list).
      912       IF group-target-list NE "":U THEN
      913       DO i = 1 TO NUM-ENTRIES(group-target-list):
      914         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      915         RUN check-modified IN curr-widget ('group-check':U).
      916         IF RETURN-VALUE NE "":U THEN
      917         DO:
      918           RUN check-modified-message(RETURN-VALUE).
      919           RETURN "":U.
      920         END.
      921       END.
      922     END.
      923     RETURN "":U.
      924   END PROCEDURE.
      925   PROCEDURE check-modified-message :
      926     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      927        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      928           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      929        IF RETURN-VALUE = "YES":U THEN
      930           RUN notify ('view,CONTAINER-SOURCE':U).
      931        MESSAGE IF p-changed-table NE ? THEN
      932           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      933           ELSE "Current values have been changed."
      934           SKIP "  Do you wish to save those changes?"
      935           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      936        IF ANS THEN
      937        DO:
      938           IF group-assign-target THEN
      939             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      940           ELSE RUN dispatch('update-record':U).
      941           IF RETURN-VALUE = "ADM-ERROR":U THEN
      942           DO:
      943               MESSAGE "Changes to the previous record were not saved."
      944                 VIEW-AS ALERT-BOX ERROR.
      945               IF group-assign-target THEN
      946                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      947               ELSE RUN dispatch ('cancel-record':U).
      948           END.
      949        END.
      950        ELSE DO:
      951          IF group-assign-target THEN
      952             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      953          ELSE RUN dispatch('cancel-record':U).
      954        END.
      955        RETURN.
      956   END PROCEDURE.
      957   PROCEDURE get-rowid :
      958       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      959       ASSIGN
      960       p-table   =   adm-first-table.
      961       RETURN.
      962   END PROCEDURE.
      963   PROCEDURE init-group-assign :
      964       RUN request-attribute IN adm-broker-hdl
      965         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      966       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      967         group-assign-target = yes.
      968       ELSE group-assign-target = no.
      969       RETURN.
      970   END PROCEDURE.
      971   PROCEDURE set-editors :
      972       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      973       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      974       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      975       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      976       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      977       DO WHILE VALID-HANDLE (curr-widget):
      978           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      979              curr-widget:HIDDEN = no THEN DO:
      980             CASE p-field-setting:
      981               WHEN "INITIALIZE":U THEN
      982               DO:
      983                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      984                     read-only-list +
      985                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      986                        STRING(curr-widget).
      987               END.
      988               WHEN "DISABLE":U OR
      989               WHEN "ENABLE":U THEN
      990               DO:
      991                   curr-widget:SENSITIVE = yes.
      992                   RUN get-attribute ('Read-Only-Editors':U).
      993                   IF RETURN-VALUE = ? OR
      994                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      995                       curr-widget:READ-ONLY =
      996                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      997               END.
      998               WHEN "CLEAR":U THEN
      999                   curr-widget:SCREEN-VALUE = "":U.
     1000             END CASE.
     1001           END.
     1002           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1003       END.
     1004       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1005         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1006           + '"':U).
     1007       RETURN.
     1008   END PROCEDURE.
     1009   PROCEDURE use-check-modified-all :
     1010    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1011     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1012     RETURN.
     1013   END PROCEDURE.
     1014   PROCEDURE use-create-on-add :
     1015   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1016      RETURN.
     1017   END PROCEDURE.
     1018   PROCEDURE use-initial-lock :
     1019     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1020     ASSIGN adm-initial-lock = p-attr-value.
     1021     RETURN.
     1022   END PROCEDURE.
     1023     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1024   ASSIGN
     1025          FRAME F-Main:SCROLLABLE       = FALSE
     1026          FRAME F-Main:HIDDEN           = TRUE.
     1027   if not this-procedure :persistent
     1028   then do:
     1029     message
     1030       vss-workfile vss-revision vss-description skip
     1031       "Ошибка при запуске процедуры" skip
     1032       "Данную процедуру следует запускать только с параметром persistent" skip
     1033       view-as alert-box error .
     1034     undo, return error .
     1035   end.
     1036     display TOGGLE-1 TOGGLE-2  with frame F-Main .
     1037   PROCEDURE disable_UI :
     1038     HIDE FRAME F-Main.
     1039     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1040   END PROCEDURE.
     1041   PROCEDURE my-report :
     1042   if FILL-IN-1 < 1 then message "Не задан срок товарного запаса!" view-as alert-box.
     1043   else run rep/r-spd-p.p (input RADIO-SET-1, input NoNull, input TOGGLE-1, input TOGGLE-2, input FILL-IN-1).
     1044   END PROCEDURE.
     1045   PROCEDURE my-var :
     1046   assign frame F-Main NoNull TOGGLE-1 TOGGLE-2 FILL-IN-1 RADIO-SET-1 .
     1047   ReportNAme = "Расчет необходимого товарного запаса ".
     1048   ReportHeader = (if NoNull then "Показ с нулевыми позициями"  else " " )  .
     1049   str1 = "Интервал поиска данных с " + String(x-Date-Start,"99.99.9999")  + " по " + String(x-Date-End,"99.99.9999") .
     1050   str2 = "Срок товарного запаса: " + String(FILL-IN-1) + " дн." .
     1051   END PROCEDURE.
     1052   PROCEDURE state-changed :
     1053     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1054     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1055     CASE p-state:
     1056     END CASE.
     1057   END PROCEDURE.
