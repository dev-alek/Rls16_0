      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   def var State-source as  WIDGET-HANDLE.
      679   define variable lns-cnt as integer   no-undo .
      680   DEFINE VARIABLE COMBO-node AS CHARACTER FORMAT "X(40)":U INITIAL "касса"
      681        LABEL "Типы документов"
      682        VIEW-AS COMBO-BOX INNER-LINES 6
      683        LIST-ITEMS "касса"
      684        SIZE 40.75 BY 1
      685        BGCOLOR 15  NO-UNDO.
      686   DEFINE RECTANGLE RECT-9
      687        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      688        SIZE 67.75 BY 16.08.
      689   DEFINE VARIABLE TOG-inv AS LOGICAL INITIAL no
      690        LABEL "С момента последней инвентаризации"
      691        VIEW-AS TOGGLE-BOX
      692        SIZE 57.13 BY .83 NO-UNDO.
      693   DEFINE FRAME F-Main
      694        COMBO-node AT ROW 1.71 COL 6
      695        TOG-inv AT ROW 3.38 COL 6.38
      696        RECT-9 AT ROW 1.38 COL 1.75
      697       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      698            SIDE-LABELS NO-UNDERLINE THREE-D
      699            AT COL 1 ROW 1 SCROLLABLE .
      700   ASSIGN
      701          FRAME F-Main:SCROLLABLE       = FALSE
      702          FRAME F-Main:HIDDEN           = TRUE
      703          FRAME F-Main:PRIVATE-DATA     =
      704                   "DLGCLOSE".
      705   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      706   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      707   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      708   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      709   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      710   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      711   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      712   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      713         adm-object-hdl = FRAME F-Main:HANDLE.
      714   RUN ensure-broker.
      715   THIS-PROCEDURE:ADM-DATA =
      716        'ADM1.1~`':U +
      717        'SmartObject~`':U +
      718        '~`':U +
      719        'NO ~`':U +
      720        '~`':U +
      721        '~`':U +
      722        '~`':U +
      723        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      724           + "~`":U +
      725        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      726        'Record-Source,Record-Target,TableIO-Target~`':U +
      727        '~`':U +
      728        '~`~`~`~`~`~`~`~`~`~`~`':U +
      729        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      730            THEN "^^":U
      731        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      732             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      733   PROCEDURE adm-apply-entry :
      734     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      735   END PROCEDURE.
      736   PROCEDURE adm-destroy :
      737    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      738   END PROCEDURE.
      739   PROCEDURE adm-disable :
      740       DISABLE RECT-9 COMBO-node TOG-inv WITH FRAME F-Main.
      741       RUN dispatch ('disable-fields':U).
      742       RUN set-attribute-list ('ENABLED=no':U).
      743       RETURN.
      744   END PROCEDURE.
      745   PROCEDURE adm-edit-attribute-list :
      746         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      747         RETURN.
      748   END PROCEDURE.
      749   PROCEDURE adm-enable :
      750       ENABLE UNLESS-HIDDEN RECT-9 COMBO-node TOG-inv WITH FRAME F-Main.
      751       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      752       RUN set-attribute-list ('ENABLED=yes':U).
      753       RETURN.
      754   END PROCEDURE.
      755   PROCEDURE adm-exit :
      756        RUN notify ('exit':U).
      757     RETURN.
      758   END PROCEDURE.
      759   PROCEDURE adm-hide :
      760     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      761   END PROCEDURE.
      762   PROCEDURE adm-initialize :
      763     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      764   END PROCEDURE.
      765   PROCEDURE adm-show-errors :
      766       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      767       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      768           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      769       END.
      770       RETURN.
      771   END PROCEDURE.
      772   PROCEDURE adm-UIB-mode :
      773     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      774   END PROCEDURE.
      775   PROCEDURE adm-view :
      776     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      777   END PROCEDURE.
      778   PROCEDURE dispatch :
      779       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      780       RUN broker-dispatch IN adm-broker-hdl
      781           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      782       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      783   END PROCEDURE.
      784   PROCEDURE ensure-broker :
      785   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      786   IF RETURN-VALUE NE "ADM-Broker":U THEN
      787   DO:
      788       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      789       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      790   END.
      791   END PROCEDURE.
      792   PROCEDURE get-attribute :
      793     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      794     RUN broker-get-attribute IN adm-broker-hdl
      795         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      796     RETURN RETURN-VALUE.
      797   END PROCEDURE.
      798   PROCEDURE get-attribute-list :
      799     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      800     RUN broker-get-attribute-list IN adm-broker-hdl
      801         (INPUT THIS-PROCEDURE,
      802          INPUT ?,
      803          OUTPUT p-attr-list) NO-ERROR.
      804     RETURN.
      805   END PROCEDURE.
      806   PROCEDURE new-state :
      807     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      808     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      809     RETURN.
      810   END PROCEDURE.
      811   PROCEDURE notify :
      812     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      813     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      814     IF RETURN-VALUE = "ADM-ERROR":U THEN
      815         RETURN "ADM-ERROR":U.
      816     RETURN.
      817   END PROCEDURE.
      818   PROCEDURE set-attribute-list :
      819     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      820     RUN ensure-broker.
      821     RUN broker-set-attribute-list IN adm-broker-hdl
      822         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      823     RETURN.
      824   END PROCEDURE.
      825   PROCEDURE set-position :
      826       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      827       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      828       IF VALID-HANDLE(adm-object-hdl) THEN
      829       DO:
      830         ASSIGN adm-object-hdl:ROW    =   p-row
      831                adm-object-hdl:COLUMN =   p-col.
      832       END.
      833       RETURN.
      834   END PROCEDURE.
      835   PROCEDURE adm-display-fields :
      836       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      837       RETURN.
      838   END PROCEDURE.
      839   PROCEDURE adm-open-query :
      840     RETURN.
      841   END PROCEDURE.
      842   PROCEDURE adm-row-changed :
      843         IF VALID-HANDLE(adm-object-hdl) THEN
      844           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      845         RUN notify ('row-available':U).
      846         RETURN.
      847   END PROCEDURE.
      848   PROCEDURE reposition-query :
      849       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      850       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      851       RETURN.
      852   END PROCEDURE.
      853     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      854     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      855     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      856     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      857     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      858     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      859     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      860     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      861     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      862     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      863     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      864     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      865     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      866     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      867     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      868     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      869     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      870     IF "":U = "":U THEN
      871       RUN modify-list-attribute IN adm-broker-hdl
      872         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      873     RUN use-create-on-add(?).
      874   PROCEDURE adm-add-record :
      875       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      876          "must have at least one Enabled Table to perform Add.":U
      877          VIEW-AS ALERT-BOX ERROR.
      878       RETURN.
      879   END PROCEDURE.
      880   PROCEDURE adm-assign-record :
      881    MESSAGE
      882          "Object ":U THIS-PROCEDURE:FILE-NAME
      883            "must have at least one Enabled Table to perform Assign.":U
      884              VIEW-AS ALERT-BOX ERROR.
      885      RETURN.
      886     END PROCEDURE.
      887   PROCEDURE adm-assign-statement :
      888     RETURN.
      889   END PROCEDURE.
      890   PROCEDURE adm-cancel-record :
      891      RETURN.
      892     END PROCEDURE.
      893   PROCEDURE adm-copy-record :
      894       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      895        "must have at least one Enabled Table to perform Copy.":U
      896          VIEW-AS ALERT-BOX ERROR.
      897       RETURN.
      898   END PROCEDURE.
      899   PROCEDURE adm-create-record :
      900      RETURN.
      901   END PROCEDURE.
      902   PROCEDURE adm-current-changed :
      903     RETURN.
      904   END PROCEDURE.
      905   PROCEDURE adm-delete-record :
      906    MESSAGE
      907          "Object ":U THIS-PROCEDURE:FILE-NAME
      908            "must have at least one Enabled Table to perform Delete.":U
      909              VIEW-AS ALERT-BOX ERROR.
      910       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      911       RETURN.
      912   END PROCEDURE.
      913   PROCEDURE adm-disable-fields :
      914         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      915       RETURN.
      916   END PROCEDURE.
      917   PROCEDURE adm-enable-fields :
      918       RETURN.
      919   END PROCEDURE.
      920   PROCEDURE adm-end-update :
      921     RETURN.
      922   END PROCEDURE.
      923   PROCEDURE adm-reset-record :
      924       RETURN.
      925   END PROCEDURE.
      926   PROCEDURE adm-update-record :
      927       MESSAGE
      928         "Object ":U THIS-PROCEDURE:FILE-NAME
      929           "must have at least one Enabled Table to perform Update.":U
      930             VIEW-AS ALERT-BOX ERROR.
      931      RETURN.
      932   END PROCEDURE.
      933   PROCEDURE check-modified :
      934   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      935   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      936   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      937   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      938     IF check-state = "check":U THEN
      939     DO:
      940       RUN get-link-handle IN adm-broker-hdl
      941         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      942            OUTPUT group-target-list).
      943       IF group-target-list NE "":U THEN
      944       DO i = 1 TO NUM-ENTRIES(group-target-list):
      945         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      946         RUN check-modified IN curr-widget ('group-check':U).
      947         IF RETURN-VALUE NE "":U THEN
      948         DO:
      949           RUN check-modified-message(RETURN-VALUE).
      950           RETURN "":U.
      951         END.
      952       END.
      953     END.
      954     RETURN "":U.
      955   END PROCEDURE.
      956   PROCEDURE check-modified-message :
      957     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      958        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      959           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      960        IF RETURN-VALUE = "YES":U THEN
      961           RUN notify ('view,CONTAINER-SOURCE':U).
      962        MESSAGE IF p-changed-table NE ? THEN
      963           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      964           ELSE "Current values have been changed."
      965           SKIP "  Do you wish to save those changes?"
      966           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      967        IF ANS THEN
      968        DO:
      969           IF group-assign-target THEN
      970             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      971           ELSE RUN dispatch('update-record':U).
      972           IF RETURN-VALUE = "ADM-ERROR":U THEN
      973           DO:
      974               MESSAGE "Changes to the previous record were not saved."
      975                 VIEW-AS ALERT-BOX ERROR.
      976               IF group-assign-target THEN
      977                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      978               ELSE RUN dispatch ('cancel-record':U).
      979           END.
      980        END.
      981        ELSE DO:
      982          IF group-assign-target THEN
      983             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      984          ELSE RUN dispatch('cancel-record':U).
      985        END.
      986        RETURN.
      987   END PROCEDURE.
      988   PROCEDURE get-rowid :
      989       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      990       ASSIGN
      991       p-table   =   adm-first-table.
      992       RETURN.
      993   END PROCEDURE.
      994   PROCEDURE init-group-assign :
      995       RUN request-attribute IN adm-broker-hdl
      996         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      997       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      998         group-assign-target = yes.
      999       ELSE group-assign-target = no.
     1000       RETURN.
     1001   END PROCEDURE.
     1002   PROCEDURE set-editors :
     1003       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1004       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1005       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1006       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1007       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1008       DO WHILE VALID-HANDLE (curr-widget):
     1009           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1010              curr-widget:HIDDEN = no THEN DO:
     1011             CASE p-field-setting:
     1012               WHEN "INITIALIZE":U THEN
     1013               DO:
     1014                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1015                     read-only-list +
     1016                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1017                        STRING(curr-widget).
     1018               END.
     1019               WHEN "DISABLE":U OR
     1020               WHEN "ENABLE":U THEN
     1021               DO:
     1022                   curr-widget:SENSITIVE = yes.
     1023                   RUN get-attribute ('Read-Only-Editors':U).
     1024                   IF RETURN-VALUE = ? OR
     1025                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1026                       curr-widget:READ-ONLY =
     1027                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1028               END.
     1029               WHEN "CLEAR":U THEN
     1030                   curr-widget:SCREEN-VALUE = "":U.
     1031             END CASE.
     1032           END.
     1033           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1034       END.
     1035       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1036         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1037           + '"':U).
     1038       RETURN.
     1039   END PROCEDURE.
     1040   PROCEDURE use-check-modified-all :
     1041    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1042     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1043     RETURN.
     1044   END PROCEDURE.
     1045   PROCEDURE use-create-on-add :
     1046   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1047      RETURN.
     1048   END PROCEDURE.
     1049   PROCEDURE use-initial-lock :
     1050     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1051     ASSIGN adm-initial-lock = p-attr-value.
     1052     RETURN.
     1053   END PROCEDURE.
     1054     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1055   if not this-procedure :persistent
     1056   then do:
     1057     message
     1058       vss-workfile vss-revision vss-description skip
     1059       "Ошибка при запуске процедуры" skip
     1060       "Данную процедуру следует запускать только с параметром persistent" skip
     1061       view-as alert-box error .
     1062     undo, return error .
     1063   end.
     1064   PROCEDURE disable_UI :
     1065     HIDE FRAME F-Main.
     1066     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1067   END PROCEDURE.
     1068   PROCEDURE GOTO-first-page :
     1069     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1070     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1071       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1072       State-source = WIDGET-HANDLE ( source-str ).
     1073       IF not VALID-HANDLE ( State-source ) THEN
     1074         Message "Не определен линк " 'State':U view-as alert-box error.
     1075     END.
     1076      run Select1 IN State-source.
     1077   END PROCEDURE.
     1078   PROCEDURE local-initialize :
     1079     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1080       Combo-node:list-items In frame F-Main = Combo-node:list-items + ',' + 'все':U      .
     1081       Combo-node:list-items In frame F-Main = Combo-node:list-items + ',' + 'касса продажа':U      .
     1082       Combo-node:list-items = Combo-node:list-items + ',' + 'касса возврат':U  .
     1083       Combo-node:list-items = Combo-node:list-items + ',' + 'приход внешний':U           .
     1084       Combo-node:list-items = Combo-node:list-items + ',' + 'приход внутренний':U           .
     1085       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат внешний':U       .
     1086       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат внутренний':U       .
     1087       Combo-node:list-items = Combo-node:list-items + ',' + 'приход  произв.':U            .
     1088       Combo-node:list-items = Combo-node:list-items + ',' + 'расход внешний':U           .
     1089       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат пост.':U        .
     1090       Combo-node:list-items = Combo-node:list-items + ',' + 'списание':U           .
     1091       Combo-node:list-items = Combo-node:list-items + ',' + 'расход внутренний':U           .
     1092       Combo-node:list-items = Combo-node:list-items + ',' + 'расход  произв.':U            .
     1093       Combo-node:list-items = Combo-node:list-items + ',' + 'списан. произв.':U            .
     1094       Combo-node:list-items = Combo-node:list-items + ',' + 'инвентаризация':U                 .
     1095       Combo-node:list-items = Combo-node:list-items + ',' + 'переоценка':U            .
     1096       Combo-node:list-items = Combo-node:list-items + ',' +  'коррекция учетных цен':U         .
     1097       Combo-node:list-items = Combo-node:list-items + ',' +  'смена типа приобретения':U         .
     1098       Combo-node:list-items = Combo-node:list-items + ',' +  'пересортица':U         .
     1099       Combo-node:screen-value in frame F-Main = 'все':U.
     1100       display Combo-node  with frame F-Main .
     1101   END PROCEDURE.
     1102   PROCEDURE my-report :
     1103    run rep/r-o-good.p
     1104     ( input v-cntxt-obj-code ,
     1105       input v-cntxt-obj-type ,
     1106       input base-type  ,
     1107       input base-code  ,
     1108       input COMBO-node ,
     1109       input tog-inv,
     1110       input "no-classify":U,
     1111       input "sort-article":U ,
     1112       input "" ).
     1113   END PROCEDURE.
     1114   PROCEDURE my-var :
     1115   assign frame F-Main COMBO-node tog-inv .
     1116   Assign
     1117    STR-obj-type = ''
     1118    STR-obj-code = ''
     1119    STR-obj-name = ''
     1120    STR-obj      = ''.
     1121   For each obj-list no-lock:
     1122    Assign
     1123    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1124    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1125    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1126    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1127   End.
     1128   ReportNAme = "О Т Ч Е Т   О   С О С Т О Я Н И И   З А П А С А   И   П Р О Д А Ж А Х   ( по одному товару)".
     1129   ReportHeader = " Тип документов : " + COMBO-node + chr(10) + " Остатки на начало, конец периода и оборот указаны по всем типам документов".
     1130   if tog-inv then
     1131   ReportHeader = ReportHeader  + chr(10) + " с момента последней инвентаризации ".
     1132               Case COMBO-node:
     1133                   when  'приход внешний':U             then   COMBO-node = 'ie':U          .
     1134                   when  'расход внешний':U             then   COMBO-node = 'ee':U          .
     1135                   when  'возврат пост.':U          then   COMBO-node = 'ep':U       .
     1136                   when  'касса продажа':U        then   COMBO-node = 'es':U     .
     1137                   when  'возврат внешний':U         then   COMBO-node = 're':U      .
     1138                   when  'касса возврат':U    then   COMBO-node = 'rs':U .
     1139                   when  'списание':U             then   COMBO-node = 'we':U          .
     1140                   when  'инвентаризация':U                   then   COMBO-node = 'vt':U                .
     1141                   when  'приход внутренний':U             then   COMBO-node = 'iv':U          .
     1142                   when  'расход внутренний':U             then   COMBO-node = 'ev':U          .
     1143                   when  'возврат внутренний':U         then   COMBO-node = 'rv':U       .
     1144                   when  'расход  произв.':U              then   COMBO-node = 'em':U            .
     1145                   when  'списан. произв.':U              then   COMBO-node = 'wm':U            .
     1146                   when  'приход  произв.':U              then   COMBO-node = 'im':U            .
     1147                   when  'пересортица':U              then   COMBO-node = 'vp':U            .
     1148                   when  'переоценка':U              then   COMBO-node = 'ot':U            .
     1149                   when  'касса'                             then   COMBO-node = 'rs':U + ',' + 'es':U.
     1150                    when  'все':U                             then   COMBO-node = 'все':U.
     1151               End case.
     1152   if lns-cnt > 1  then DO:
     1153   lns-cnt= 0.
     1154   For each gds-list no-lock:
     1155      lns-cnt = lns-cnt + 1.
     1156   End.
     1157   End.
     1158   If NOT can-find (first gds-list) OR
     1159     lns-cnt > 1  then DO:
     1160       run goto-first-page in this-procedure.
     1161       Return error 'First-page':U.
     1162   End.
     1163   END PROCEDURE.
     1164   PROCEDURE state-changed :
     1165     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1166     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1167     CASE p-state:
     1168       When 'link-changed':U then do:
     1169            if lns-cnt > 1 and NOT Link# Then do:
     1170               message " Для этого отчета надо выбрать только один товар ! вернитесь на закладку <Параметры> и выберите 1 товар ".
     1171               run goto-first-page in this-procedure.
     1172            end.
     1173       End.
     1174     END CASE.
     1175   END PROCEDURE.
