      482   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
      483                           input 'nsf':U ,
      484                          output v-attr-value ,
      485                          output v-attr-type )  .
      486       if v-attr-value = ""
      487       then do:
      488           assign
      489               v-factur-string = buf_trn-doc.ord-num
      490           .
      491       end.
      492       else do:
      493           assign
      494               v-factur-string = v-attr-value
      495           .
      496   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
      497                           input 'dsf':U ,
      498                          output v-attr-value ,
      499                          output v-attr-type )  .
      500           assign
      501               v-factur-string = v-factur-string + " от " + v-attr-value
      502           .
      503       end.
      504       run fill-temp-VAT in this-procedure (
      505           input buf_trn-doc.doc-code
      506       ).
      507   output stream out-stream to value( string( session:temp-directory +
      508                                        "rpt" + string( g#report-num ) ) )
      509                                        page-size  value(62) .
      510   if session :set-wait-state( "compiler" ) then.
      511       put stream out-stream
      512           space( 5 )
      513           p-fmt-align-string( v-host-name, 124, 'right':U )
      514                                                       format "X(124)"
      515           skip(2) space( 5 )
      516               "Дата оплаты: "
      517               buf_trn-doc.doc-date                    format "99.99.9999"
      518           skip space( 5 )
      519               "Менеджер:    "
      520               v-manager-name                          format "X(124)"
      521           skip(2)
      522               "С П Р А В К А"                                         at center-field( 1, 130, 13 )
      523           skip(1) space( 5 )
      524               p-fmt-align-string( v-supp-name, 124, 'center':U )
      525                                                       format "X(124)"
      526           skip(1) space( 5 )
      527               "Товар на сумму: "
      528               string( v-fact-sum, ">>>>>>>>>9.99" )   format "X(13)"
      529               space( 1 )
      530               ( if PrintRubl then "РУБ" else "баз.вал" )
      531       .
      532       if PrintRubl
      533       then do:
      534           run rep/wp-rub.p (
      535                 input v-fact-sum
      536               , output v-propis
      537               , output v-propis-cop
      538           ).
      539           put stream out-stream
      540               space(2)
      541               "( " + v-propis + " )"  format "X(100)"
      542           .
      543       end.
      544       put stream out-stream
      545           skip space( 5 )
      546               space( 4 ) "по фактуре: "
      547               v-factur-string         format "X(100)"
      548       .
      549       find first buf_temp_vat no-error.
      550       if not available buf_temp_vat
      551       then do:
      552           put stream out-stream
      553               skip space( 5 )
      554                   space( 8 ) "без НДС"
      555           .
      556       end.
      557       else do:
      558           put stream out-stream
      559               skip space( 5 )
      560                   space( 8 ) "в том числе:"
      561           .
      562           for each buf_temp_vat
      563           on error undo, return error
      564           :
      565               put stream out-stream
      566                   skip space( 5 )
      567                       space( 20 ) "НДС "
      568                       buf_temp_vat.vat-pc     format ">>9.99%"
      569                       ":"
      570                       space(4)
      571                       ( if PrintRubl then buf_temp_vat.sum-vat-rubl else buf_temp_vat.sum-vat-base )
      572                                               format ">>>,>>>,>>9.99"
      573                       space( 1 )
      574                       ( if PrintRubl then "РУБ" else "баз.вал" )
      575               .
      576           end.
      577       end.
      578       put stream out-stream
      579           skip( 2 ) space( 5 )
      580               "Выписал:  "
      581               v-operator-name format "X(25)"
      582               "Зав. маг.: "                    at 80
      583               v-store-boss    format "X(40)"
      584       .
      585       output stream out-stream close.
      586   if g#quest-print = false
      587   then do:
      588     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      589                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      590                                         OUTPUT g#log ).
      591   end.
      592   else do:
      593     os-command silent
      594       value( "COPY /b " +
      595         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      596         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      597         string( session:temp-directory) +  "$" + string( g#report-num )
      598                 ) .
      599     os-command silent
      600       value( "COPY /b " +
      601         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      602         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      603         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      604                 ) .
      605   end.
      606   if session :set-wait-state( "" ) then.
      607   end.
      608   procedure fill-temp-VAT :
      609   define input parameter p-doc-code   as character        no-undo.
      610       define buffer buf_parts     for parts.
      611       define buffer buf_doc-line  for doc-line.
      612       define buffer buf_temp_vat  for temp_vat.
      613   do
      614   for buf_parts
      615     , buf_doc-line
      616     , buf_temp_vat
      617   on error undo, return error
      618   :
      619       for each buf_doc-line no-lock
      620          where buf_doc-line.doc-code = p-doc-code
      621       on error undo, return error
      622       :
      623           for each buf_parts no-lock
      624              where buf_parts.out-code   = p-doc-code
      625                and buf_parts.obj-type   = buf_doc-line.obj-type
      626                and buf_parts.obj-code   = buf_doc-line.obj-code
      627                and buf_parts.prod-type  = buf_doc-line.prod-type
      628                and buf_parts.prod-code  = buf_doc-line.prod-code
      629                and buf_parts.artic      = buf_doc-line.artic
      630                and buf_parts.status_    = true
      631           on error undo, return error return-value
      632           :
      633               find first buf_temp_vat
      634                    where buf_temp_vat.vat-pc = buf_parts.VAT-pc
      635               no-error.
      636               if not available buf_temp_vat
      637               then do:
      638                   create buf_temp_vat.
      639                   assign
      640                       buf_temp_vat.vat-pc         = buf_parts.VAT-pc
      641                       buf_temp_vat.sum-vat-base   = 0
      642                       buf_temp_vat.sum-vat-rubl   = 0
      643                   .
      644               end.
      645   assign
      646     price-rubl-with-tax-loc = buf_parts.price-rubl
      647     price-base-with-tax-loc = buf_parts.price-base
      648   .
      649   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      651     (output varinvprb
      652     )  .
      653     if buf_parts.out-code = 'free-zone':U     or
      654        buf_parts.out-code = 'out-zone':U   or
      655        buf_parts.doc-type = 'акт':U then do:
      656       assign
      657         in-vatp-have-vat-slt = yes.
      658     end.
      659     else do:
      660       find first in-vatp_doc-attr no-lock
      661         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      662           and in-vatp_doc-attr.attr-code = 'envd':U
      663         no-error .
      664       if not available in-vatp_doc-attr then do:
      665         assign
      666           in-vatp-have-vat-slt = yes.
      667       end.
      668       else do:
      669            in-vatp-have-vat-slt = no.
      670       end.
      671     end.
      672     assign
      673      price-cli-with-tax-loc = buf_parts.price-cli
      674      cli-base-rate          = buf_parts.cli-base-rate.
      675     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      676              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      677     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      678             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      679             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      680             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      681             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      682             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      683             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      684       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      685     assign
      686       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      687     assign
      688       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      689       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      690       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      691       transport-cli-loc  = 0
      692       other-cli-loc      = 0
      693     .
      694   ASSIGN
      695             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      696       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      697   .
      698               assign
      699                   buf_temp_vat.sum-vat-base = buf_temp_vat.sum-vat-base + ( vat-base-loc * buf_parts.fact-qnty )
      700                   buf_temp_vat.sum-vat-rubl = buf_temp_vat.sum-vat-rubl + ( vat-rubl-loc * buf_parts.fact-qnty )
      701               .
      702           end.
      703       end.
      704       for each buf_temp_vat
      705       on error undo, return error
      706       :
      707           if buf_temp_vat.sum-vat-base = 0
      708           and buf_temp_vat.sum-vat-rubl = 0
      709           then do:
      710               delete buf_temp_vat.
      711           end.
      712       end.
      713   end.
      714   end procedure.
