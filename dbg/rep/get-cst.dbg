        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input-output parameter from-date    as date no-undo .
        3   define input-output parameter to-date    as date no-undo .
        4   define input parameter p-curr-host-code-obj like ub.sysconf.host-code no-undo .
        5   DEFINE INPUT  PARAMETER parobj-type  LIKE clients.obj-type NO-UNDO.
        6   DEFINE OUTPUT PARAMETER parcli-type  LIKE clients.obj-type NO-UNDO.
        7   DEFINE OUTPUT PARAMETER parcli-code  LIKE clients.obj-code NO-UNDO.
        8   DEFINE OUTPUT PARAMETER partnved     AS CHARACTER     format "x(10)"     NO-UNDO.
        9   DEFINE OUTPUT PARAMETER parcst-units AS CHARACTER          NO-UNDO.
       10   DEFINE OUTPUT PARAMETER is-ok        AS LOGICAL INITIAL FALSE NO-UNDO.
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Окно ввода параметров для таможенных отчетов".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   DEFINE  SHARED TEMP-TABLE TT-tnved NO-UNDO
       79   FIELD tnved  AS CHAR FORMAT "X(10)"  LABEL 'Код ТНВЭД':U
       80   FIELD f-name AS CHAR FORMAT "X(255)" LABEL 'Полное наименование':U
       81   INDEX tnved IS UNIQUE PRIMARY  tnved.
       82   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   procedure proc-alt-shift-f2:
      308     if not ibs.th.gbl.gbl-var:rcode
      309   then
      310     run gbl\inidebug.p .
      311   end.
      312   procedure proc-alt-shift-f3:
      313     run gbl/prvssinf.p
      314       ( input this-procedure
      315       ) .
      316   end.
      317   define variable v-inform-launched as logical no-undo initial false .
      318   procedure proc-alt-shift-f4:
      319     define variable v-action as character no-undo .
      320     if v-inform-launched = false then do:
      321       assign
      322         v-inform-launched = true
      323       .
      324       run gbl/d-inform.w
      325         (  input self
      326         ,  input this-procedure
      327         , output v-action
      328         ) no-error .
      329       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      330       assign
      331         v-inform-launched = false
      332       .
      333     end.
      334   end.
      335   procedure proc-alt-f1:
      336     run gbl/corrhelp.p
      337       (input this-procedure
      338       ) .
      339   end .
      340   on alt-shift-f2 anywhere do:
      341     run proc-alt-shift-f2.
      342   end.
      343   on alt-shift-f3 anywhere do:
      344     run proc-alt-shift-f3 in this-procedure .
      345   end.
      346   on alt-shift-f4 anywhere do:
      347     run proc-alt-shift-f4 in this-procedure.
      348   end.
      349   on alt-f1 anywhere do:
      350     run proc-alt-f1 in this-procedure .
      351   end.
      352   def var ref-list as char no-undo.
      353   def var f-name   as char no-undo.
      354   DEFINE BUTTON b-help DEFAULT
      355        LABEL "Помо&щь"
      356        SIZE 10 BY 1
      357        BGCOLOR 8 .
      358   DEFINE BUTTON b-ok AUTO-GO DEFAULT
      359        LABEL "&Ввод"
      360        SIZE 10 BY 1
      361        BGCOLOR 8 .
      362   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      363        LABEL "&Отмена"
      364        SIZE 10 BY 1
      365        BGCOLOR 8 .
      366   DEFINE BUTTON r-clients
      367        IMAGE-UP FILE "btn-down-arrow":U
      368        IMAGE-DOWN FILE "btn-down-arrow":U
      369        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      370        LABEL ""
      371        SIZE 3 BY .88.
      372   DEFINE BUTTON r-tnved
      373        IMAGE-UP FILE "btn-down-arrow":U
      374        IMAGE-DOWN FILE "btn-down-arrow":U
      375        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      376        LABEL "r-tnved"
      377        SIZE 3 BY .88.
      378   DEFINE VARIABLE date-b AS DATE FORMAT "99/99/9999":U
      379        LABEL "&С"
      380        VIEW-AS FILL-IN
      381        SIZE 11 BY 1 NO-UNDO.
      382   DEFINE VARIABLE date-e AS DATE FORMAT "99/99/9999":U
      383        LABEL "&По"
      384        VIEW-AS FILL-IN
      385        SIZE 11 BY 1 NO-UNDO.
      386   DEFINE VARIABLE varcli-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      387        VIEW-AS FILL-IN
      388        SIZE 6.75 BY 1 NO-UNDO.
      389   DEFINE VARIABLE varcli-name AS CHARACTER FORMAT "X(256)":U
      390         VIEW-AS TEXT
      391        SIZE 59.5 BY 1 NO-UNDO.
      392   DEFINE VARIABLE varcli-type AS CHARACTER FORMAT "X(3)":U
      393        LABEL "Об&ъект"
      394        VIEW-AS FILL-IN
      395        SIZE 4.88 BY 1 NO-UNDO.
      396   DEFINE VARIABLE varTnved AS CHARACTER FORMAT "X(256)":U
      397        LABEL "&Уровень ТНВЕД"
      398        VIEW-AS FILL-IN
      399        SIZE 11.25 BY 1 NO-UNDO.
      400   DEFINE VARIABLE vartnved-name AS CHARACTER FORMAT "X(256)":U
      401         VIEW-AS TEXT
      402        SIZE 59.13 BY 1 NO-UNDO.
      403   DEFINE VARIABLE varcst-units AS CHARACTER INITIAL "Таможенная"
      404        VIEW-AS RADIO-SET HORIZONTAL
      405        RADIO-BUTTONS
      406             "&Таможенная", "Таможенная",
      407   "Ба&зовая", "Базовая"
      408        SIZE 39.88 BY 1 NO-UNDO.
      409   DEFINE VARIABLE varrstnved AS CHARACTER INITIAL "Корень"
      410        VIEW-AS RADIO-SET HORIZONTAL
      411        RADIO-BUTTONS
      412             "&Корень", "Корень",
      413   "&Выборочно", "Выборочно"
      414        SIZE 28.5 BY 1.04 NO-UNDO.
      415   DEFINE RECTANGLE RECT-22
      416        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      417        SIZE 60.88 BY 3.29.
      418   DEFINE RECTANGLE RECT-3
      419        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      420        SIZE 62.75 BY 9.96.
      421   DEFINE FRAME get-rep
      422        b-ok AT ROW 1 COL 1
      423        b-quit AT ROW 1 COL 11
      424        b-help AT ROW 1 COL 41
      425        date-b AT ROW 3.17 COL 4 COLON-ALIGNED
      426        date-e AT ROW 3.17 COL 23.38 COLON-ALIGNED
      427        varcli-type AT ROW 3.17 COL 44 COLON-ALIGNED
      428        varcli-code AT ROW 3.17 COL 50.13 COLON-ALIGNED NO-LABEL
      429        r-clients AT ROW 3.17 COL 59.5
      430        varcst-units AT ROW 7.04 COL 22 NO-LABEL
      431        varTnved AT ROW 9.5 COL 3.38
      432        r-tnved AT ROW 9.5 COL 30.5
      433        varrstnved AT ROW 9.5 COL 33.75 NO-LABEL
      434        varcli-name AT ROW 4.79 COL 2.88 NO-LABEL
      435        vartnved-name AT ROW 11.04 COL 3 NO-LABEL
      436        "Единица измерения:" VIEW-AS TEXT
      437             SIZE 18.13 BY 1 AT ROW 7.04 COL 3.38
      438             BGCOLOR 7
      439        RECT-3 AT ROW 2.67 COL 1
      440        RECT-22 AT ROW 9.13 COL 1.88
      441        SPACE(1.47) SKIP(0.28)
      442       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      443            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      444            TITLE "Задайте параметры отчета"
      445            CANCEL-BUTTON b-quit.
      446   ASSIGN
      447          FRAME get-rep:SCROLLABLE       = FALSE.
      448   ON CHOOSE OF b-ok IN FRAME get-rep
      449   DO:
      450       assign frame get-rep
      451           date-b
      452           date-e
      453           vartnved
      454           varcli-type
      455           varcli-code
      456           varcst-units
      457           .
      458       if date-e < date-b then
      459           do:
      460               message "Дата начала периода не может быть больше даты окончания!" view-as alert-box ERROR.
      461               APPLY "ENTRY" TO date-b IN FRAME get-rep.
      462               return no-apply.
      463           end.
      464       IF varTnved <> "Всё" THEN DO:
      465         find first tt-tnved where tt-tnved.tnved = vartnved no-error.
      466         if not available tt-tnved then do:
      467               message "Неверный код ТНВЭД" view-as alert-box ERROR.
      468               APPLY "ENTRY" TO vartnved IN FRAME get-rep.
      469               return no-apply.
      470         end.
      471       END.
      472       IF parobj-type <> "all" then do:
      473          RUN check-cli no-error.
      474          IF error-status:error then return no-apply.
      475       end.
      476      assign
      477      from-date    = date-b
      478      to-date      = date-e
      479      parcli-type  = varcli-type
      480      parcli-code  = varcli-code
      481      partnved     = vartnved
      482      parcst-units = varcst-units
      483      is-ok        = yes no-error.
      484   END.
      485   ON return OF date-b IN FRAME get-rep
      486   DO:
      487     apply "entry" to date-e in frame get-rep.
      488     return no-apply.
      489   END.
      490   ON RETURN OF date-e IN FRAME get-rep
      491   DO:
      492       APPLY "ENTRY" TO varcli-type IN FRAME get-rep.
      493       RETURN NO-APPLY.
      494   END.
      495   ON CHOOSE OF r-clients IN FRAME get-rep
      496   DO:
      497     RUN chs-cli no-error.
      498     if error-status:error then return no-apply.
      499     run check-cli no-error.
      500     if error-status:error then return no-apply.
      501   END.
      502   ON CHOOSE OF r-tnved IN FRAME get-rep
      503   DO:
      504     RUN ch-tnved.
      505   END.
      506   ON MOUSE-SELECT-DBLCLICK OF varcli-code IN FRAME get-rep
      507   DO:
      508     RUN check-cli no-error.
      509     IF error-status:error then do:
      510        RUN chs-cli no-error.
      511        IF error-status:error then return no-apply.
      512        RUN check-cli no-error.
      513     END.
      514     if not error-status:error then
      515        apply "entry" to varcst-units in frame get-rep.
      516     return no-apply.
      517   END.
      518   ON RETURN OF varcli-code IN FRAME get-rep
      519   DO:
      520     RUN check-cli no-error.
      521     IF error-status:error then do:
      522        RUN chs-cli no-error.
      523        IF error-status:error then return no-apply.
      524        RUN check-cli no-error.
      525     END.
      526     if not error-status:error then
      527        apply "entry" to varcst-units in frame get-rep.
      528     return no-apply.
      529   END.
      530   ON MOUSE-SELECT-DBLCLICK OF varcli-type IN FRAME get-rep
      531   DO:
      532     RUN check-cli no-error.
      533     IF error-status:error then do:
      534        RUN chs-cli no-error.
      535        IF error-status:error then return no-apply.
      536        RUN check-cli no-error.
      537     END.
      538     apply "entry" to varcst-units in frame get-rep.
      539     return no-apply.
      540   END.
      541   ON RETURN OF varcli-type IN FRAME get-rep
      542   DO:
      543     RUN check-cli no-error.
      544     IF error-status:error then do:
      545        RUN chs-cli no-error.
      546        IF error-status:error then return no-apply.
      547        RUN check-cli no-error.
      548     END.
      549     apply "entry" to varcst-units in frame get-rep.
      550     return no-apply.
      551   END.
      552   ON return OF varcst-units IN FRAME get-rep
      553   DO:
      554     apply "entry" to varrstnved in frame get-rep.
      555     return no-apply.
      556   END.
      557   ON return OF varrstnved IN FRAME get-rep
      558   DO:
      559     if input frame get-rep varrstnved = "корень" then
      560         apply "entry" to b-ok in frame get-rep.
      561     else
      562         apply "entry" to vartnved in frame get-rep.
      563     return no-apply.
      564   END.
      565   ON VALUE-CHANGED OF varrstnved IN FRAME get-rep
      566   DO:
      567     RUN st-tnved.
      568   END.
      569   ON RETURN OF varTnved IN FRAME get-rep
      570   DO:
      571       find first tt-tnved where tt-tnved.tnved = input frame get-rep vartnved no-error.
      572       if not available tt-tnved then do:
      573          message "Неверный код ТНВЭД." view-as alert-box error.
      574          RUN ch-tnved no-error.
      575       end.
      576       display tt-tnved.f-name @ vartnved-name with frame get-rep.
      577       apply "entry" to b-ok in frame get-rep.
      578       return no-apply.
      579   END.
      580   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME get-rep:PARENT eq ?
      581   THEN FRAME get-rep:PARENT = ACTIVE-WINDOW.
      582   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   on help of frame get-rep
      584   do:
      585     run gbl/app_help.p
      586       (input this-procedure :file-name
      587       ,input ''
      588       ,input ?
      589       ) no-error.
      590     if error-status :error then do:
      591       message
      592         "Ошибка при вызове помощи"
      593         error-status :get-message(1)
      594         view-as alert-box .
      595     end.
      596   end.
      597   run minbtn-set in this-procedure .
      598   on choose of b-help in frame get-rep
      599   do:
      600     apply "help":u to frame get-rep .
      601   end.
      602   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   procedure minbtn-set :
      604       do
      605           on error undo, return error return-value
      606           :
      607           define variable ii              as integer       no-undo .
      608           define variable fh              as widget-handle no-undo .
      609           define variable hh              as widget-handle no-undo .
      610           define variable v-h             as handle        extent 4 no-undo .
      611           define variable v-name-button   as character     no-undo .
      612           define variable v-help-old-x    as decimal       no-undo .
      613           define variable v-help-old-y    as decimal       no-undo .
      614           define variable v-help-old-size as decimal       no-undo .
      615           define variable v-frame-width   as decimal       no-undo .
      616           define variable jj              as integer       no-undo .
      617           do
      618               on error undo, return error
      619               :
      620               assign
      621                   v-frame-width = frame get-rep:width - 0.3
      622                   fh            = frame get-rep:first-child
      623                   hh            = fh:first-child
      624                   ii            = 1
      625                   .
      626               do while valid-handle(hh):
      627                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      628                   do:
      629                       case lc(hh:name) :
      630                           when "b-help" then
      631                               do:
      632                                   hh:load-image-up("cmp/b-help.bmp":u) .
      633                                   hh:load-image-down("cmp/b-help.bmp":u) .
      634                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      635                                   hh:TOOLTIP = "Помощь" .
      636                                   v-help-old-x = hh:column .
      637                                   v-help-old-y = hh:row    .
      638                                   v-help-old-size = hh:width .
      639                                   hh:width-chars = 2.5 .
      640                               end.
      641                           when "b-print" then
      642                               do:
      643                                   hh:load-image("cmp/b-print.bmp":u) .
      644                                   hh:TOOLTIP = "Печать" .
      645                                   v-h[ii] = hh:handle .
      646                                   ii = ii + 1 .
      647                                   hh:width-chars = 3 .
      648                               end.
      649                           when "b-history" or
      650                           when "b-hist" then
      651                               do:
      652                                   hh:load-image("cmp/b-hist.bmp":u) .
      653                                   hh:TOOLTIP = "История" .
      654                                   v-h[ii] = hh:handle .
      655                                   ii = ii + 1 .
      656                                   hh:width-chars = 3 .
      657                               end.
      658                           when "b-sch" then
      659                               do:
      660                                   hh:load-image("cmp/b-sch.bmp":u) .
      661                                   hh:TOOLTIP = "Установка Фильтра" .
      662                                   v-h[ii] = hh:handle .
      663                                   ii = ii + 1 .
      664                                   hh:width-chars = 3 .
      665                               end.
      666                           when "b-hist-user" then
      667                               do:
      668                                   hh:load-image("cmp/b-hist.bmp":u) .
      669                                   hh:TOOLTIP = "История пользователя" .
      670                                   ii = ii + 1 .
      671                               end.
      672                       end case.
      673                   end.
      674                   hh = hh:next-sibling.
      675               end.
      676               b-help:column = v-frame-width - b-help:width-chars.
      677               jj = 0.
      678               repeat ii = 4 to 1 by -1 :
      679                   if valid-handle (v-h[ii] ) then
      680                   do:
      681                       jj  = jj + 1 .
      682                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      683                       v-h[ii]:row    = v-help-old-y .
      684                   end.
      685               end.
      686           end.
      687       end.
      688   end procedure.
      689   ON WINDOW-CLOSE OF FRAME get-rep APPLY "END-ERROR":U TO SELF.
      690   MAIN-BLOCK:
      691   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      692      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      693     if from-date = ? OR to-date = ?
      694     then do:
      695           define variable v-today as date      no-undo.
      696           define variable v-time  as integer   no-undo.
      697           run cur-time in this-procedure ( output v-today
      698                                          , output v-time
      699                                          ).
      700           assign
      701               from-date = date( month( v-today ), 01, year( v-today ) )
      702               to-date   = v-today
      703           .
      704     end.
      705     assign
      706         date-b = from-date
      707         date-e = to-date
      708         .
      709     RUN enable_UI.
      710     if parobj-type = "all" then do:
      711        disable varcli-type varcli-code r-clients with frame get-rep.
      712        hide varcli-type varcli-code r-clients in frame get-rep.
      713     end.
      714     RUN st-tnved.
      715     WAIT-FOR GO OF FRAME get-rep FOCUS date-b.
      716   END.
      717   RUN disable_UI.
      718   PROCEDURE ch-tnved :
      719     DEFINE VARIABLE rid-tnved AS RECID NO-UNDO.
      720     run ref/t-tnved.w (no, output rid-tnved).
      721     find first tt-tnved where RECID(tt-tnved) = rid-tnved no-lock no-error.
      722     if available tt-tnved then disp tt-tnved.tnved  @ vartnved
      723                                     tt-tnved.f-name @ vartnved-name with frame get-rep.
      724   END PROCEDURE.
      725   PROCEDURE check-cli :
      726   find clients where clients.obj-code = input frame get-rep varcli-code
      727                  and clients.obj-type = input frame get-rep varcli-type no-error.
      728   if not available clients then do:
      729     if input frame get-rep varcli-code <> ? and
      730        input frame get-rep varcli-type <> ? then
      731       message "Неправильный код или тип контрагента." view-as alert-box error.
      732     apply "entry" to varcli-code in frame get-rep.
      733     return error.
      734   end.
      735   disp clients.obj-type @ varcli-type with frame get-rep.
      736   if parobj-type = "" or
      737     clients.obj-type = parobj-type then do:
      738     if clients.obj-type = 'скл':U then do:
      739         find store where store.obj-code = clients.obj-code no-lock.
      740         if store.host-code <> p-curr-host-code-obj then do:
      741           release clients no-error.
      742           message "Выбран склад другой фирмы."  view-as alert-box error.
      743           apply "entry" to varcli-code in frame get-rep.
      744           return error.
      745         end.
      746     end.
      747     else if clients.obj-type = 'маг':U then do:
      748         find shop where shop.obj-code = clients.obj-code no-lock.
      749         if shop.host-code <> p-curr-host-code-obj then do:
      750           release clients no-error.
      751           message "Выбран магазин другой фирмы." view-as alert-box error.
      752           apply "entry" to varcli-code in frame get-rep.
      753           return error.
      754         end.
      755     end.
      756     else do:
      757           message "Выберите внутренний склад или магазин." view-as alert-box error.
      758           apply "entry" to varcli-code in frame get-rep.
      759           return error.
      760     end.
      761   end.
      762   else do:
      763     release clients no-error.
      764     message "Отчет по внутренним " (if parobj-type = 'маг':U then "магазинам." else "складам.")
      765             "Выберите внутренний " (if parobj-type = 'маг':U then "магазин." else "склад.") view-as alert-box error.
      766     apply "entry" to varcli-code in frame get-rep.
      767     return error.
      768   end.
      769   varcli-code = input frame get-rep varcli-code.
      770   varcli-type = input frame get-rep varcli-type.
      771   disp clients.obj-name @ varcli-name with frame get-rep.
      772   release clients.
      773   END PROCEDURE.
      774   PROCEDURE chs-cli :
      775   define variable v-ref-rec as recid no-undo .
      776     run ref/cli-all.w ( parparentproc
      777                    , "b-sel"
      778                    , parobj-type
      779                    , ?
      780                    , ?
      781                    , ?
      782                    , ?
      783                    , ?
      784                    , output ref-list) .
      785     if ref-list <> "" then do:
      786       v-ref-rec = integer (ref-list).
      787       find clients where recid ( clients ) = v-ref-rec no-lock.
      788       disp clients.obj-code @ varcli-code
      789            clients.obj-name @ varcli-name
      790            clients.obj-type @ varcli-type with frame get-rep.
      791     end.
      792   END PROCEDURE.
      793   PROCEDURE disable_UI :
      794     HIDE FRAME get-rep.
      795   END PROCEDURE.
      796   PROCEDURE enable_UI :
      797     DISPLAY date-b date-e varcli-type varcli-code varcst-units varTnved varrstnved
      798             varcli-name vartnved-name
      799         WITH FRAME get-rep.
      800     ENABLE b-ok RECT-3 RECT-22 b-quit b-help date-b date-e varcli-type
      801            varcli-code r-clients varcst-units varrstnved
      802         WITH FRAME get-rep.
      803   END PROCEDURE.
      804   PROCEDURE st-tnved :
      805     case input frame get-rep varrstnved:
      806       when "Корень" then do:
      807         DISPLAY "Всё" @ vartnved
      808                 ""    @ vartnved-name WITH FRAME get-rep.
      809         DISABLE vartnved r-tnved WITH FRAME get-rep.
      810       end.
      811       otherwise do:
      812         DISPLAY "?" @ vartnved WITH FRAME get-rep.
      813         ENABLE vartnved r-tnved WITH FRAME get-rep.
      814         APPLY "ENTRY" TO r-tnved.
      815         RETURN NO-APPLY.
      816       end.
      817     end case.
      818   END PROCEDURE.
