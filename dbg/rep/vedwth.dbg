      193     index ie2 obj-name
      194   .
      195   procedure create_obj-list :
      196      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      197      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      198      do
      199      on error undo, return error return-value
      200      :
      201         define buffer cli-obj for ub.clients .
      202         define variable p-var as integer no-undo .
      203         define buffer buf_obj-list for obj-list .
      204         find last buf_obj-list  use-index pi no-error .
      205         if available buf_obj-list
      206         then
      207            p-var = buf_obj-list.obj-id + 1.
      208         else
      209            p-var = 1.
      210         find first cli-obj where
      211                   cli-obj.obj-type = p-obj-type
      212               and cli-obj.obj-code = p-obj-code
      213         no-lock no-error.
      214         if available cli-obj
      215         then do:
      216            create buf_obj-list.
      217            assign
      218               buf_obj-list.obj-id   = p-var
      219               buf_obj-list.obj-code = cli-obj.obj-code
      220               buf_obj-list.obj-type = cli-obj.obj-type
      221               buf_obj-list.obj-name = cli-obj.obj-name
      222               buf_obj-list.db-num   = cli-obj.db-num
      223            .
      224         end.
      225      end.
      226   end.
