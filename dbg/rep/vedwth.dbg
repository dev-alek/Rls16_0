     1911   end procedure.
     1912   procedure print-body :
     1913   do
     1914   on error undo, return error
     1915   :
     1916      run vedwthxl-sheet1-write-line-data in this-procedure.
     1917      run vedwthxl-sheet2-write-line-data in this-procedure.
     1918   end.
     1919   end procedure.
     1920   procedure print-footer :
     1921   do
     1922   on error undo, return error
     1923   :
     1924   end.
     1925   end procedure.
     1926   procedure close-stream :
     1927   do
     1928   on error undo, return error
     1929   :
     1930   if session :set-wait-state( "" ) then.
     1931       run vedwthxl-close in this-procedure .
     1932   if g#quest-print = false
     1933   then do:
     1934     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1935                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     1936                                         OUTPUT g#log ).
     1937   end.
     1938   else do:
     1939     os-command silent
     1940       value( "COPY /b " +
     1941         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1942         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1943         string( session:temp-directory) +  "$" + string( g#report-num )
     1944                 ) .
     1945     os-command silent
     1946       value( "COPY /b " +
     1947         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1948         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1949         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1950                 ) .
     1951   end.
     1952   end.
     1953   end procedure.
