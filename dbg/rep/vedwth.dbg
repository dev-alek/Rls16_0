      636   procedure cur-time :
      637      define output parameter p-today as date      no-undo .
      638      define output parameter p-time  as integer   no-undo .
      639     do
      640     on error undo, return error
      641     :
      642       define variable v-date1 as date      no-undo .
      643       define variable v-date2 as date      no-undo .
      644       define variable v-time  as integer   no-undo .
      645       assign
      646         v-date1 = today
      647         v-time  = time
      648         v-date2 = today
      649       .
      650       if v-date1 <> v-date2
      651       then do:
      652         assign
      653           v-date1 = today
      654           v-time  = v-time
      655         .
      656       end.
      657       assign
      658         p-today = v-date1
      659         p-time  = v-time
      660       .
      661     end.
      662   end.
      663   function cur-time-date returns character
      664   :
      665     return string(today, '99/99/9999':U) .
      666   end.
      667   function cur-time-mjd returns decimal
      668   :
      669     define variable v-date as date      no-undo .
      670     define variable v-time as integer   no-undo .
      671     run cur-time in this-procedure
      672       (output v-date
      673       ,output v-time
      674       ) .
      675     return integer(v-date) - 2400002 + (v-time / 86400) .
      676   end.
      677   function cur-time-get-ending-index returns integer
      678   (input p-number as integer
      679   )
      680   :
      681     if p-number < 0
      682     or p-number = ?
      683     then do:
      684       return 1 .
      685     end.
      686     define variable v-rest as integer   no-undo .
      687     assign
      688       p-number = p-number modulo 100
      689     .
      690     if p-number < 20
      691     then do:
      692       assign
      693         v-rest = p-number
      694       .
      695     end.
      696     else do:
      697       assign
      698         v-rest = p-number modulo 10
      699       .
      700     end.
      701     case v-rest :
      702       when 1
      703       then do:
      704         return 2 .
      705       end.
      706       when 2 or
      707       when 3 or
      708       when 4
      709       then do:
      710         return 3 .
      711       end.
      712       otherwise do:
      713         return 1 .
      714       end.
      715     end case .
      716   end.
      717   procedure cur-time-mjd-to-date :
      718      define input  parameter i-mjd-diff as decimal no-undo.
      719      define output parameter o-Date     as date    no-undo.
      720      define output parameter o-Time     as integer no-undo.
      721      define variable v-day-number as integer   no-undo .
      722      if    i-mjd-diff < 0
      723         or i-mjd-diff = ?
      724      then do:
      725         return "?" .
      726      end.
      727      assign
      728         v-day-number = truncate(i-mjd-diff,0).
      729         o-Date = date(v-day-number + 2400002).
      730         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      731     .
      732   end.
      733   function cur-time-mjd-to-string returns character
      734   (input p-mjd-diff as decimal
      735   )
      736   :
      737     define variable v-day-number as integer   no-undo .
      738     define variable v-seconds    as integer   no-undo .
      739     define variable v-hour       as integer   no-undo .
      740     define variable v-min        as integer   no-undo .
      741     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      742     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      743     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      744     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      745     if p-mjd-diff < 0
      746     or p-mjd-diff = ?
      747     then do:
      748       return "?" .
      749     end.
      750     assign
      751       v-day-number = integer(truncate(p-mjd-diff,0))
      752       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      753     .
      754     if v-seconds > 86400
      755     then do:
      756       assign
      757         v-seconds = 86400 - 1
      758       .
      759     end.
      760     if v-seconds < 0
      761     then do:
      762       assign
      763         v-seconds = 0
      764       .
      765     end.
      766     assign
      767       v-hour = truncate(v-seconds / 3600, 0)
      768     .
      769     assign
      770       v-seconds = v-seconds modulo 3600
      771     .
      772     assign
      773       v-min = truncate(v-seconds / 60, 0)
      774     .
      775     assign
      776       v-seconds = v-seconds modulo 60
      777     .
      778     return
      779         (if v-day-number <> 0
      780           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      781           else ""
      782         )
      783       + (if v-day-number <> 0 or v-hour <> 0
      784           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      785           else ""
      786         )
      787       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      788           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      789           else ""
      790         )
      791       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      792       .
      793   end.
      794   function cur-time-string returns character
      795   :
      796     define variable v-date as date      no-undo .
      797     define variable v-time as integer   no-undo .
      798     run cur-time in this-procedure
      799       (output v-date
      800       ,output v-time
      801       ) .
      802     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      803   end.
      804   function cur-time-string-sec returns character
      805   :
      806     define variable v-date as date      no-undo .
      807     define variable v-time as integer   no-undo .
      808     run cur-time in this-procedure
      809       (output v-date
      810       ,output v-time
      811       ) .
      812     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      813   end.
      814   function cur-time-custom  returns character
      815   (input p-prefix as character
      816   ,input p-date-format as character
      817   ,input p-delimiter as character
      818   ,input p-time-format as character
      819   ,input p-suffix as character
      820   )
      821   :
      822     define variable v-date as date      no-undo .
      823     define variable v-time as integer   no-undo .
      824     run cur-time in this-procedure
      825       (output v-date
      826       ,output v-time
      827       ) .
      828     return
      829       p-prefix
      830       + string(v-date, p-date-format)
      831       + p-delimiter
      832       + string(v-time, p-time-format)
      833       + p-suffix
      834       .
      835   end.
      836   function cur-time-print  returns character
      837   :
      838     define variable v-date as date      no-undo .
      839     define variable v-time as integer   no-undo .
      840     run cur-time in this-procedure
      841       (output v-date
      842       ,output v-time
      843       ) .
      844     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      845   end.
      846   function cur-time-datetime returns datetime
      847   :
      848     define variable v-char as character no-undo .
      849     define variable v-datetime as datetime no-undo .
      850     v-char = cur-time-string().
      851     v-datetime = datetime(v-char).
      852     return  v-datetime.
      853   end.
      854   function cur-time-string-msec returns character
      855   :
      856     define variable v-date as datetime  no-undo .
      857     v-date = now.
      858     return string(v-date) .
      859   end.
      860   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   define  stream PrnLibStream.
      862   procedure prn-lib-prn-file :
      863     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      864     define input parameter p-DIsabledoptions as integer no-undo .
      865     define variable v-report-name as character no-undo .
      866     define variable v-user-action as character no-undo .
      867     define variable v-printed     as logical   no-undo .
      868     define variable v-exist       as logical   no-undo .
      869     do
      870       on error undo, return error
      871       :
      872       run prn-lib-get-report-name  in this-procedure (
      873         input parParentProc
      874         ,output v-report-name
      875         ).
      876   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      877   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      878     (input  v-report-name
      879     ,input  2
      880     ,output v-exist
      881     )  .
      882       if NOT v-exist then
      883       DO:
      884         Message
      885           "Нет заданий на печать ! "
      886           view-as alert-box .
      887         Return  .
      888       End.
      889       run gbl/prnfilen.w
      890         (input  ""
      891         ,input  p-DisabledOptions
      892         ,input  string(v-report-name )
      893         ,input  7
      894         ,output v-user-action
      895         ,output v-printed
      896         ) .
      897       if v-printed then
      898       do:
      899         return "YES" .
      900       end.
      901       else
      902       do:
      903         return "NO" .
      904       end.
      905     end.
      906   end procedure.
      907   procedure prn-lib-open-stream :
      908     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      909     define input parameter p-page-size    as integer no-undo .
      910     define input parameter p-is-stream    as logical no-undo .
      911     define input parameter p-append       as logical no-undo .
      912     define variable v-report-name as character no-undo .
      913     do
      914       on error undo, return error
      915       :
      916       run prn-lib-get-report-name  in this-procedure (
      917         input parParentProc
      918         ,output v-report-name
      919         ).
      920       if p-is-stream then
      921       do:
      922         if p-append then
      923         do:
      924           output stream PrnLibStream to value( v-report-name )
      925             page-size value(p-page-size) append .
      926         end.
      927         if not p-append then
      928         do:
      929           output stream PrnLibStream to value( v-report-name )
      930             page-size value(p-page-size) .
      931         end.
      932       end.
      933       if not p-is-stream then
      934       do:
      935         if p-append then
      936         do:
      937           output to value( v-report-name )
      938             page-size value(p-page-size) append .
      939         end.
      940         if not p-append then
      941         do:
      942           output to value( v-report-name )
      943             page-size value(p-page-size) .
      944         end.
      945       end.
      946     end.
      947   end procedure.
      948   procedure prn-lib-open-exp :
      949     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      950     define input parameter p-is-stream    as logical no-undo .
      951     define input parameter p-is-append    as logical no-undo .
      952     define output parameter p-ReportFileName as char init "report" no-undo.
      953     define output parameter p-process as logical no-undo .
      954     define variable glog as logical no-undo .
      955     do
      956       on error undo, return error
      957       :
      958       SYSTEM-DIALOG GET-FILE p-ReportFileName
      959         TITLE      "Укажите путь"
      960         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      961         ASK-OVERWRITE
      962         CREATE-TEST-FILE
      963         SAVE-AS
      964         USE-FILENAME
      965         DEFAULT-EXTENSION "txt"
      966         UPDATE glog
      967         .
      968       if not glog then  return.
      969       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      970       if p-is-stream then
      971       do:
      972         if p-is-append then
      973         do:
      974           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      975         end.
      976         else
      977         do:
      978           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      979         end.
      980       end.
      981       else
      982       do:
      983         if p-is-append then
      984         do:
      985           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      986         end.
      987         else
      988         do:
      989           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      990         end.
      991       end.
      992       p-process = yes.
      993     end.
      994   end procedure.
      995   procedure prn-lib-get-report-name :
      996     define input parameter parParentProc  as widget-handle no-undo.
      997     define output parameter p-report-name as character no-undo .
      998     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      999   end procedure.
     1000   procedure prn-lib-reportviewer-report-name :
     1001     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1002     define input parameter p-report-name-html as character no-undo .
     1003     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1004   end procedure.
     1005   procedure prn-lib-reportviewer :
     1006     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1007     define input parameter p-report-name-html as character no-undo .
     1008     define input parameter p-param        as character no-undo .
     1009     define variable v-excel           as character no-undo init 'TRUE' .
     1010     define variable v-value-character as character no-undo .
     1011     define variable v-value-integer   as character no-undo .
     1012     define variable v-value-date      as date      no-undo .
     1013     define variable v-value-decimal   as decimal   no-undo .
     1014     define variable rep-excel         as logical   no-undo .
     1015     define variable excel-string      as character no-undo .
     1016     define variable v-param-type      as character no-undo .
     1017     define variable v-tth             as handle    no-undo .
     1018     run adm/shattri.p (
     1019       input "get":U
     1020       ,input  ""
     1021       ,input  0
     1022       ,input  'report-glob':U
     1023       ,input  'rep-excel':U
     1024       ,output v-value-character
     1025       ,output v-value-date
     1026       ,output v-value-decimal
     1027       ,output v-value-integer
     1028       ,output rep-excel
     1029       ,output v-param-type
     1030       ,INPUT-OUTPUT table-handle v-tth
     1031       )  .
     1032     if rep-excel then v-excel = "TRUE" .
     1033     else v-excel = "FALSE" .
     1034     if p-param eq ""
     1035     then
     1036        p-param = "EXCEL:" + v-excel.
     1037     else
     1038        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1039     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1040   end procedure.
     1041   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1042   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1043   procedure paramls-clear :
     1044     define buffer buf_temp-param for temp-param .
     1045     do
     1046     on error undo, return error return-value
     1047     :
     1048       for each buf_temp-param
     1049       on error undo, return error
     1050       :
     1051         delete buf_temp-param .
     1052       end.
     1053     end.
     1054   end procedure.
     1055   procedure paramls-write :
     1056     define input  parameter p-code     as character no-undo .
     1057     define input  parameter p-sub-code as character no-undo .
     1058     define input  parameter p-value    as character no-undo .
     1059     define buffer buf_temp-param for temp-param .
     1060     do
     1061     on error undo, return error return-value
     1062     :
     1063       find first buf_temp-param
     1064         where buf_temp-param.param-code     = p-code
     1065           and buf_temp-param.param-sub-code = p-sub-code
     1066         no-error .
     1067       if not available buf_temp-param then do:
     1068         create buf_temp-param .
     1069         assign
     1070           buf_temp-param.param-code     = p-code
     1071           buf_temp-param.param-sub-code = p-sub-code
     1072         .
     1073       end.
     1074       assign
     1075         buf_temp-param.param-value = p-value
     1076       .
     1077     end.
     1078   end procedure.
     1079   procedure paramls-read :
     1080     define input  parameter p-code          as character no-undo .
     1081     define input  parameter p-sub-code      as character no-undo .
     1082     define input  parameter p-default-value as character no-undo .
     1083     define output parameter p-value         as character no-undo .
     1084     define buffer buf_temp-param for temp-param .
     1085     do
     1086     on error undo, return error return-value
     1087     :
     1088       find first buf_temp-param
     1089         where buf_temp-param.param-code     = p-code
     1090           and buf_temp-param.param-sub-code = p-sub-code
     1091         no-error .
     1092       if available buf_temp-param then do:
     1093         assign
     1094           p-value = buf_temp-param.param-value
     1095         .
     1096       end.
     1097       else do:
     1098         assign
     1099           p-value = p-default-value
     1100         .
     1101       end.
     1102     end.
     1103   end procedure.
     1104   procedure paramls-append :
     1105     define input  parameter p-code     as character no-undo .
     1106     define input  parameter p-sub-code as character no-undo .
     1107     define input  parameter p-value    as character no-undo .
     1108     define buffer buf_temp-param for temp-param .
     1109     do
     1110     on error undo, return error return-value
     1111     :
     1112       find first buf_temp-param
     1113            where buf_temp-param.param-code     = p-code
     1114              and buf_temp-param.param-sub-code = p-sub-code
     1115         no-error .
     1116       if not available buf_temp-param then do:
     1117         create buf_temp-param .
     1118         assign
     1119           buf_temp-param.param-code     = p-code
     1120           buf_temp-param.param-sub-code = p-sub-code
     1121           buf_temp-param.param-value    = p-value
     1122         .
     1123       end.
     1124       else do:
     1125           assign
     1126               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1127           .
     1128       end.
     1129     end.
     1130   end procedure.
     1131   define buffer buf_wth-doc     for ub.wth-doc .
     1132   define stream out-stream.
     1133   FUNCTION f-wp-qnty returns character ( INPUT p-dec as decimal ) :
     1134     define variable pr as character no-undo .
     1135     run rep/wp-qnty.p ( input p-dec, output Pr ).
     1136     if Pr = '' then do:
     1137        Pr = 'Ноль'.
     1138     end.
     1139     RETURN ( Pr ) .
     1140   END FUNCTION.
     1141   DO
     1142   ON ERROR UNDO, RETURN ERROR substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1143   :
     1144      run get-report-num in parparentproc (output g#report-num).
     1145      run get-quest-print in parparentproc ( output g#quest-print ).
     1146   DEFINE TEMP-TABLE tt-line NO-UNDO
     1147         FIELD curr-name   as character
     1148         FIELD curr-code   as integer
     1149         FIELD okv-code    as integer
     1150         field par-val     as integer
     1151         field par-rate    as decimal
     1152         field par-unit    as character
     1153         FIELD par-code    as integer
     1154         field summ        as integer
     1155         FIELD wth-code    as integer
     1156         INDEX pi IS PRIMARY UNIQUE
     1157               curr-code
     1158               wth-code
     1159               par-code
     1160   .
     1161   DEFINE TEMP-TABLE tt-summ NO-UNDO
     1162         FIELD curr-code   as integer
     1163         FIELD okv-code   as integer
     1164         field curr-summ   as decimal
     1165         field curr-abbr   as character
     1166         field part-abbr   as character
     1167         INDEX pi IS PRIMARY UNIQUE
     1168               curr-code
     1169   .
     1170   define variable vss-include-info12 as character format "X(65)" no-undo
     1171   initial "@(#)$Workfile$ $Revision$".
     1172   define stream excel-line.
     1173   define stream excel-cell.
     1174   define temp-table temp_cell-data no-undo
     1175       field data-key as character
     1176       field data-value as character
     1177       index pi is primary unique data-key
     1178   .
     1179   define variable v-vedwthxl-sheet1-cur-data-row     as integer      no-undo.
     1180   define variable v-vedwthxl-sheet2-cur-data-row     as integer      no-undo.
     1181   define variable v-vedwthxl-sheet3-cur-data-row     as integer      no-undo.
     1182   define variable v-vedwthxl-cell-file-name       as character    no-undo.
     1183   define variable v-vedwthxl-data-file-name       as character    no-undo.
     1184   procedure vedwthxl-init :
     1185   do
     1186   on error undo, return error
     1187   :
     1188       assign
     1189           v-vedwthxl-sheet1-cur-data-row = 0
     1190           v-vedwthxl-sheet2-cur-data-row = 0
     1191       .
     1192       run gbl/_tmpfile.p (
     1193             input "xd"
     1194           , input ".txt"
     1195           , output v-vedwthxl-data-file-name
     1196       ).
     1197       output stream excel-line to value( v-vedwthxl-data-file-name ).
     1198       run gbl/_tmpfile.p (
     1199             input "xc"
     1200           , input ".txt"
     1201           , output v-vedwthxl-cell-file-name
     1202       ).
     1203       output stream excel-cell to value( v-vedwthxl-cell-file-name ).
     1204       run vedwthxl-write-cell-data in this-procedure (
     1205             input "sheetList":U
     1206           , input "экз1,экз2,экз3":U
     1207       ).
     1208       if printrubl
     1209       then do:
     1210           run vedwthxl-write-cell-data in this-procedure (
     1211                 input "экз1_valutCode":U
     1212               , input "0":U
     1213           ).
     1214           run vedwthxl-write-cell-data in this-procedure (
     1215                 input "экз2_valutCode":U
     1216               , input "0":U
     1217           ).
     1218           run vedwthxl-write-cell-data in this-procedure (
     1219                 input "экз3_valutCode":U
     1220               , input "0":U
     1221           ).
     1222       end.
     1223       else do:
     1224           run vedwthxl-write-cell-data in this-procedure (
     1225                 input "экз1_valutCode":U
     1226               , input "1":U
     1227           ).
     1228           run vedwthxl-write-cell-data in this-procedure (
     1229                 input "экз2_valutCode":U
     1230               , input "1":U
     1231           ).
     1232           run vedwthxl-write-cell-data in this-procedure (
     1233                 input "экз3_valutCode":U
     1234               , input "1":U
     1235           ).
     1236       end.
     1237       run vedwthxl-write-cell-data in this-procedure (
     1238             input "экз1_columnList":U
     1239           , input "curr_name,curr_code,fact_qnty,par_val,fact_sum":U
     1240       ).
     1241       run vedwthxl-write-cell-data in this-procedure (
     1242             input "экз1_columnType":U
     1243           , input "S,S,S,S,S":U
     1244       ).
     1245       run vedwthxl-write-cell-data in this-procedure (
     1246             input "экз1_subtotalList":U
     1247           , input "":U
     1248       ).
     1249       run vedwthxl-write-cell-data in this-procedure (
     1250             input "экз1_subtotalType":U
     1251           , input "":U
     1252       ).
     1253       run vedwthxl-write-cell-data in this-procedure (
     1254             input "экз2_columnList":U
     1255           , input "curr_name,curr_code,fact_qnty,par_val,fact_sum":U
     1256       ).
     1257       run vedwthxl-write-cell-data in this-procedure (
     1258             input "экз2_columnType":U
     1259           , input "S,S,S,S,S":U
     1260       ).
     1261       run vedwthxl-write-cell-data in this-procedure (
     1262             input "экз2_subtotalList":U
     1263           , input "":U
     1264       ).
     1265       run vedwthxl-write-cell-data in this-procedure (
     1266             input "экз2_subtotalType":U
     1267           , input "":U
     1268       ).
     1269   end.
     1270   end procedure.
     1271   procedure vedwthxl-sheet1-write-line-data :
     1272   define buffer buf_tt-line     for tt-line .
     1273   do
     1274   on error undo, return error
     1275   :
     1276       for each buf_tt-line
     1277       :
     1278           put stream excel-line unformatted
     1279                               "экз1":U
     1280               CHR(9)   "DTA":U
     1281               CHR(9)   buf_tt-line.curr-name
     1282               CHR(9)   buf_tt-line.okv-code
     1283               CHR(9)   (buf_tt-line.summ / buf_tt-line.par-rate)
     1284               CHR(9)   SUBSTITUTE ("&1 &2", buf_tt-line.par-val, buf_tt-line.par-unit)
     1285               CHR(9)   buf_tt-line.summ
     1286               chr(10)
     1287           .
     1288       end.
     1289   end.
     1290   end procedure.
     1291   procedure vedwthxl-sheet3-write-line-data :
     1292   do
     1293   on error undo, return error
     1294   :
     1295   end.
     1296   end procedure.
     1297   procedure vedwthxl-sheet2-write-line-data :
     1298   define buffer buf_tt-line     for tt-line .
     1299   do
     1300   on error undo, return error
     1301   :
     1302       for each buf_tt-line
     1303       :
     1304           put stream excel-line unformatted
     1305                               "экз2":U
     1306               CHR(9)   "DTA":U
     1307               CHR(9)   buf_tt-line.curr-name
     1308               CHR(9)   buf_tt-line.okv-code
     1309               CHR(9)   (buf_tt-line.summ / buf_tt-line.par-rate)
     1310               CHR(9)   SUBSTITUTE ("&1 &2", buf_tt-line.par-val, buf_tt-line.par-unit)
     1311               CHR(9)   buf_tt-line.summ
     1312               chr(10)
     1313           .
     1314       end.
     1315   end.
     1316   end procedure.
     1317   procedure vedwthxl-write-cell-data :
     1318   define input parameter p-data-key   as character        no-undo.
     1319   define input parameter p-data-value as character        no-undo.
     1320       define buffer buf_temp_cell-data     for temp_cell-data.
     1321   do
     1322   for buf_temp_cell-data
     1323   on error undo, return error
     1324   :
     1325       find first buf_temp_cell-data
     1326            where buf_temp_cell-data.data-key = p-data-key
     1327       no-error.
     1328       if not available buf_temp_cell-data
     1329       then do:
     1330           create buf_temp_cell-data.
     1331           assign
     1332               buf_temp_cell-data.data-key = p-data-key
     1333           .
     1334       end.
     1335       assign
     1336           buf_temp_cell-data.data-value = p-data-value
     1337       .
     1338       put stream excel-cell unformatted
     1339                           buf_temp_cell-data.data-key
     1340           CHR(9)   buf_temp_cell-data.data-value
     1341           chr(10)
     1342       .
     1343   end.
     1344   end procedure.
     1345   procedure vedwthxl-run-excel :
     1346   define input parameter p-header-filename    as character        no-undo.
     1347   define input parameter p-data-filename      as character        no-undo.
     1348   define variable v-template-file-name    as character    no-undo.
     1349   define variable v-vb-file-name          as character    no-undo.
     1350   define buffer buf_temp-param for temp-param .
     1351   do
     1352   for buf_temp-param
     1353   on error undo, return error
     1354   :
     1355       create buf_temp-param.
     1356       assign
     1357           v-template-file-name    = search( "exe/vedprepr.xlt" )
     1358           v-vb-file-name          = search( "exe/t_form.bas")
     1359       .
     1360       if v-template-file-name = ?
     1361       or v-template-file-name = "":U
     1362       then do:
     1363           message
     1364               "Ошибка имени файла шаблона."
     1365           view-as alert-box error.
     1366       end.
     1367       if v-vb-file-name = ?
     1368       or v-vb-file-name = "":U
     1369       then do:
     1370           message
     1371               "Ошибка имени файла кода обработки."
     1372           view-as alert-box error.
     1373       end.
     1374       run paramls-write in this-procedure (
     1375             input "template":U
     1376           , input "template-file-name":U
     1377           , input v-template-file-name
     1378       ).
     1379       run paramls-write in this-procedure (
     1380             input "template":U
     1381           , input "vb-file-name":U
     1382           , input v-vb-file-name
     1383       ).
     1384       run paramls-write in this-procedure (
     1385             input "data":U
     1386           , input "data-header-filename":U
     1387           , input p-header-filename
     1388       ).
     1389       run paramls-write in this-procedure (
     1390             input "data":U
     1391           , input "data-filename":U
     1392           , input p-data-filename
     1393       ).
     1394       run gbl/macroxlt.p (
     1395           input-output table buf_temp-param
     1396       ) no-error.
     1397       if error-status :error
     1398       then do:
     1399           message
     1400                    vss-workfile vss-revision vss-description
     1401               skip(1)
     1402               skip "Ошибка создания файла Excel."
     1403               skip return-value
     1404               skip trim(error-status :get-message(1))
     1405                    trim(error-status :get-message(2))
     1406                    trim(error-status :get-message(3))
     1407           view-as alert-box error.
     1408           undo, return error .
     1409       end.
     1410   end.
     1411   end procedure.
     1412   procedure vedwthxl-close :
     1413   do
     1414   on error undo, return error
     1415   :
     1416       output stream excel-line close.
     1417       output stream excel-cell close.
     1418       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1419           export "exe/vedprepr.xlt":U.
     1420           export "exe/t_form.bas":U.
     1421           export v-vedwthxl-cell-file-name.
     1422           export v-vedwthxl-data-file-name.
     1423       output close.
     1424   end.
     1425   end procedure.
     1426      FIND FIRST buf_wth-doc
     1427         WHERE buf_wth-doc.doc-code = p-doc-code
     1428         NO-LOCK
     1429         NO-ERROR
     1430         .
     1431      IF NOT AVAILABLE buf_wth-doc
     1432      THEN DO:
     1433         MESSAGE
     1434            "Не найден документ" p-doc-code
     1435            SKIP
     1436         VIEW-AS ALERT-BOX ERROR.
     1437         RETURN ERROR SUBSTITUTE("Не найден документ &1", p-doc-code).
     1438      END.
     1439      run calc-summ     IN THIS-PROCEDURE ( INPUT p-doc-code ) .
     1440      run open-stream   IN THIS-PROCEDURE .
     1441      run print-header  IN THIS-PROCEDURE .
     1442      run print-body    IN THIS-PROCEDURE .
     1443      run print-footer  IN THIS-PROCEDURE .
     1444      run close-stream  IN THIS-PROCEDURE .
     1445   end.
     1446   procedure calc-summ :
     1447   define input parameter p-doc-code       as character        no-undo.
     1448   define variable v-curr-name    as character    no-undo.
     1449   define variable v-okv-code    as integer      no-undo.
     1450   define variable v-curr-num    as integer      no-undo.
     1451   define variable v-ok    as logical      no-undo.
     1452   define buffer buf_wth-line    for ub.wth-line .
     1453   define buffer buf_wth-dtl     for ub.wth-dtl .
     1454   define buffer buf_wth-par     for ub.wth-par .
     1455   define buffer buf_wealth      for ub.wealth .
     1456   define buffer buf_currency    for ub.currency .
     1457   define buffer buf_tt-summ     for tt-summ .
     1458   define buffer buf_tt-line     for tt-line .
     1459   do
     1460   on error undo, return error
     1461   :
     1462      FOR EACH buf_wth-line
     1463         WHERE buf_wth-line.doc-code   = p-doc-code
     1464         NO-LOCK
     1465         ,
     1466         FIRST buf_wealth
     1467         WHERE buf_wealth.wth-code     = buf_wth-line.wth-code
     1468           AND buf_wealth.is-money     = YES
     1469         NO-LOCK
     1470         BREAK BY buf_wealth.curr-code
     1471         :
     1472         IF FIRST-OF (buf_wealth.curr-code)
     1473         THEN DO:
     1474            FIND FIRST buf_currency
     1475                 WHERE buf_currency.curr-code = buf_wealth.curr-code
     1476                 NO-LOCK
     1477                 NO-ERROR
     1478                 .
     1479            CREATE buf_tt-summ.
     1480            ASSIGN
     1481               buf_tt-summ.curr-code = buf_wealth.curr-code
     1482               v-curr-num = v-curr-num + 1
     1483            .
     1484            IF NOT AVAILABLE buf_currency
     1485            THEN DO:
     1486               ASSIGN
     1487                  buf_tt-summ.curr-abbr = "???":U
     1488                  buf_tt-summ.part-abbr = "???":U
     1489                  buf_tt-summ.okv-code  = 0
     1490               .
     1491            END.
     1492            ELSE DO:
     1493               ASSIGN
     1494                  buf_tt-summ.curr-abbr = buf_currency.curr-abbr
     1495                  buf_tt-summ.part-abbr = buf_currency.part-abbr
     1496                  buf_tt-summ.okv-code  = buf_currency.okv-code
     1497               .
     1498            END.
     1499         END.
     1500         ASSIGN
     1501            buf_tt-summ.curr-summ = buf_tt-summ.curr-summ + buf_wth-line.fact-sum
     1502         .
     1503      End.
     1504      IF v-curr-num > 2
     1505      THEN DO:
     1506         message
     1507            "В документе присутствует более двух валют."
     1508            skip "В шапке документа не поместятся все суммы прописью."
     1509            SKIP "Продолжить?"
     1510         view-as alert-box question buttons YES-NO update v-ok.
     1511         IF NOT v-ok
     1512         THEN DO:
     1513            RETURN ERROR "В документе присутствует более двух валют." .
     1514         END.
     1515      END.
     1516      FOR EACH buf_wth-dtl
     1517         WHERE buf_wth-dtl.doc-code = p-doc-code
     1518         NO-LOCK
     1519         ,
     1520         FIRST buf_wth-par
     1521         WHERE buf_wth-par.wth-code = buf_wth-dtl.wth-code
     1522           AND buf_wth-par.par-code = buf_wth-dtl.par-code
     1523         NO-LOCK
     1524         ,
     1525         FIRST buf_wealth
     1526         WHERE buf_wealth.wth-code  = buf_wth-dtl.wth-code
     1527           AND buf_wealth.is-money  = YES
     1528         NO-LOCK
     1529         :
     1530         FIND FIRST buf_tt-line
     1531              WHERE buf_tt-line.curr-code = buf_wealth.curr-code
     1532                AND buf_tt-line.wth-code  = buf_wth-dtl.wth-code
     1533                AND buf_tt-line.par-code  = buf_wth-dtl.par-code
     1534              EXCLUSIVE-LOCK
     1535              NO-ERROR
     1536              .
     1537         IF NOT AVAILABLE buf_tt-line
     1538         THEN DO:
     1539            FIND FIRST buf_currency
     1540                 WHERE buf_currency.curr-code = buf_wealth.curr-code
     1541                 NO-LOCK
     1542                 NO-ERROR
     1543                 .
     1544            IF NOT AVAILABLE buf_currency
     1545            THEN DO:
     1546               ASSIGN
     1547                  v-curr-name = "Не найдена"
     1548                  v-okv-code = 000
     1549               .
     1550            END.
     1551            ELSE DO:
     1552               ASSIGN
     1553                  v-curr-name = buf_currency.curr-name
     1554                  v-okv-code = buf_currency.okv-code
     1555               .
     1556            END.
     1557            CREATE buf_tt-line.
     1558            ASSIGN
     1559               buf_tt-line.curr-code = buf_wealth.curr-code
     1560               buf_tt-line.okv-code  = v-okv-code
     1561               buf_tt-line.wth-code  = buf_wth-dtl.wth-code
     1562               buf_tt-line.par-code  = buf_wth-dtl.par-code
     1563               buf_tt-line.par-rate  = buf_wth-par.par-rate
     1564               buf_tt-line.par-unit  = buf_wth-par.par-unit
     1565               buf_tt-line.par-val   = buf_wth-par.par-val
     1566               buf_tt-line.curr-name = v-curr-name
     1567            .
     1568         END.
     1569         ASSIGN
     1570            buf_tt-line.summ = buf_tt-line.summ + buf_wth-dtl.fact-sum
     1571         .
     1572      End.
     1573   end.
     1574   end procedure.
     1575   procedure open-stream :
     1576   do
     1577   on error undo, return error
     1578   :
     1579   if session :set-wait-state( "compiler" ) then.
     1580   output stream out-stream to value( string( session:temp-directory +
     1581                                        "rpt" + string( g#report-num ) ) )
     1582                                        page-size  value(43) .
     1583       put stream out-stream unformatted
     1584             chr(10)
     1585           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     1586           + chr(10)
     1587       .
     1588       output stream out-stream close.
     1589       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     1590       output close.
     1591       run vedwthxl-init in this-procedure.
     1592   end.
     1593   end procedure.
     1594   procedure print-header :
     1595   do
     1596   on error undo, return error
     1597   :
     1598       define variable v-object    as character    no-undo.
     1599       define variable v-firm      as character    no-undo.
     1600       define variable v-host-code as integer    no-undo.
     1601       define variable v-client    as character    no-undo.
     1602       define variable v-bank      as character    no-undo.
     1603       define variable v-schet     as character    no-undo.
     1604       define variable v-collect   as character    no-undo.
     1605       define buffer buf_fin-bank      for ub.fin-bank .
     1606       define buffer buf_fin-schet     for ub.fin-schet .
     1607       define buffer buf_fin-bank-attr for ub.fin-bank-attr .
     1608       define buffer buf_clients       for ub.clients .
     1609       define buffer buf_tt-summ       for tt-summ .
     1610       find first buf_clients
     1611            where buf_clients.obj-type = buf_wth-doc.obj-type
     1612              and buf_clients.obj-code = buf_wth-doc.obj-code
     1613            no-lock
     1614            no-error
     1615            .
     1616       IF AVAILABLE buf_clients
     1617       THEN DO:
     1618         assign
     1619            v-host-code = buf_clients.host-code
     1620            v-object = buf_clients.obj-name
     1621         .
     1622         find first buf_clients
     1623               where buf_clients.obj-type = 'орг':U
     1624               and buf_clients.obj-code   = v-host-code
     1625               no-lock
     1626               no-error
     1627               .
     1628         IF AVAILABLE buf_clients
     1629         THEN DO:
     1630            assign
     1631               v-firm = buf_clients.obj-name
     1632            .
     1633         END.
     1634         FIND FIRST buf_fin-schet
     1635               WHERE buf_fin-schet.host-code = v-host-code
     1636              no-lock
     1637              no-error
     1638              .
     1639         IF NOT AVAILABLE buf_fin-schet
     1640         THEN DO:
     1641            MESSAGE
     1642               "У организации" v-host-code "не найдено ни одного счета"
     1643               SKIP
     1644            VIEW-AS ALERT-BOX ERROR.
     1645            RETURN ERROR SUBSTITUTE("У организации &1 не найдено ни одного счета", v-host-code).
     1646         END.
     1647         FIND FIRST buf_fin-bank
     1648              WHERE buf_fin-bank.host-code = v-host-code
     1649                and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1650              no-lock
     1651              no-error
     1652              .
     1653         IF AVAILABLE buf_fin-bank
     1654         THEN DO:
     1655               assign
     1656                  v-bank  =  buf_fin-bank.bank-name
     1657                  v-schet =  buf_fin-schet.r-schet
     1658               .
     1659         END.
     1660         FIND FIRST buf_fin-bank-attr
     1661              where buf_fin-bank-attr.host-code  = v-host-code
     1662                and buf_fin-bank-attr.code-bank  = buf_fin-schet.code-bank
     1663                and buf_fin-bank-attr.attr-code  = "collect-debt":U
     1664              no-lock
     1665             no-error
     1666             .
     1667         IF AVAILABLE buf_fin-bank-attr
     1668         THEN DO:
     1669            assign
     1670               v-collect = buf_fin-bank-attr.attr-value
     1671            .
     1672         end.
     1673       END.
     1674       run vedwthxl-write-cell-data in this-procedure (
     1675             input "экз1_date1":U
     1676           , input buf_wth-doc.doc-date
     1677       ).
     1678       run vedwthxl-write-cell-data in this-procedure (
     1679             input "экз1_date2":U
