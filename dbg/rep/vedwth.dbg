     1700                              , f-wp-qnty(TRUNCATE(buf_tt-summ.curr-summ, 0))
     1701                              , buf_tt-summ.curr-abbr
     1702                              , STRING(TRUNCATE((buf_tt-summ.curr-summ - TRUNCATE(buf_tt-summ.curr-summ, 0)) * 100, 0), "99")
     1703                              , buf_tt-summ.part-abbr
     1704                              , buf_tt-summ.okv-code
     1705                              )
     1706         ).
     1707         run vedwthxl-write-cell-data in this-procedure (
     1708               input "экз1_summ_3":U
     1709            , input STRING(buf_tt-summ.curr-summ, ">>>,>>9.99")
     1710         ).
     1711         run vedwthxl-write-cell-data in this-procedure (
     1712               input "экз1_summ_5":U
     1713            , input STRING(buf_tt-summ.curr-summ, ">>>,>>9.99")
     1714         ).
