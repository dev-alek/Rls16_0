     1228   procedure create-temp-t-post-stk-line :
     1229       define variable str  as char      format "X(60)" no-undo.
     1230       define variable str2 as char      no-undo.
     1231       define variable v-r  as character no-undo init "" .
     1232       define variable i#i  as int       no-undo.
     1233    do
     1234    on error undo, return error return-value
     1235    :
     1236    if available ub.goods and
     1237       available ub.clients and
     1238       available prod-cli then do:
     1239     create temp-t-post-stk-line .
     1240     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1241     assign
     1242       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1243       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1244       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1245       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1246       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1247       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1248       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1249       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1250       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1251       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1252       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1253     .
     1254               if xlavel > 0 then
     1255               do:
     1256                   repeat i#i =1 to xlavel:
     1257                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1258                       else
     1259                       do:
     1260                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1261                           if not error-status:error  and str2 <> "":u then
     1262                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1263                       end.
     1264                   end.
     1265                   if str <> ? then
     1266                   do:
     1267                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1268                   end.
     1269               end.
     1270               else
     1271               do :
     1272                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1273               end.
     1274           end.
     1275    end.
     1276   end procedure.
     1277   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1278     if num-entries(string(p-dec), '.') = 2
     1279       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1280       else return( string(p-dec)) .
     1281   end function.
     1282   function format-point-to-comma returns char (input orig as char ) .
     1283   define variable rtext as character no-undo .
     1284   define variable strt as integer no-undo .
     1285   define variable leng as integer no-undo .
     1286   assign rtext = orig .
     1287   repeat:
     1288     strt =  index(rtext,'.').
     1289     if strt = 0 then leave.
     1290     leng = 1.
     1291     substring(rtext,strt,leng,"character") = v-delim .
     1292   end.
     1293   return rtext.
     1294   end function.
     1295   function format-excel-text returns char ( input start-text as char ) :
     1296   def var  i    as int no-undo.
     1297   def var  ch   as char no-undo.
     1298   def var  n    as int no-undo.
     1299   def var  ipos as int no-undo.
     1300     n = num-entries(trim(start-text), chr(10)) - 1 .
     1301     do i = 1 to n :
     1302       ipos = index( start-text, chr(10)).
     1303       if ipos > 0 then
     1304         substr( start-text, ipos, 1 ) = ' '.
     1305     end.
     1306     n = num-entries(trim(start-text), chr(13)) - 1 .
     1307     do i = 1 to n :
     1308       ipos = index( start-text, chr(13)).
     1309       if ipos > 0 then
     1310         substr( start-text, ipos, 1 ) = ' '.
     1311     end.
     1312     if index( start-text, '"' ) = 0 then
     1313       start-text =  '="'   + trim( start-text) + '"'   .
     1314       else do:
     1315         n = num-entries(trim(start-text), '"') - 1.
     1316         do i = 1 to n :
     1317           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1318         end.
     1319         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1320         start-text = '="'  + ch  + '"' .
     1321       end.
     1322     return start-text.
     1323   end.
     1324   function excel-sum returns char (input p-dec as decimal ).
     1325     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1326   end function.
     1327   function excel-qnty returns char (input p-dec as decimal ).
     1328     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1329   end function.
     1330   function format-excel-text-macr returns char ( input start-text as char ) :
     1331   def var  i    as int no-undo.
     1332   def var  ch   as char no-undo.
     1333   def var  n    as int no-undo.
     1334   def var  ipos as int no-undo.
     1335     n = num-entries(trim(start-text), chr(10)) - 1 .
     1336     do i = 1 to n :
     1337       ipos = index( start-text, chr(10)).
     1338       if ipos > 0 then
     1339         substring( start-text, ipos , 1 ) = ' '.
     1340     end.
     1341     n = num-entries(trim(start-text), chr(13)) - 1 .
     1342     do i = 1 to n :
     1343       ipos = index( start-text, chr(13)).
     1344       if ipos > 0 then
     1345         substring( start-text, ipos, 1 ) = ' '.
     1346     end.
     1347     if index( start-text, '"' ) = 0 then
     1348       start-text =  '"'   + trim( start-text) + '"'   .
     1349       else do:
     1350         n = num-entries(trim(start-text), '"') - 1.
     1351         do i = 1 to n :
     1352           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1353         end.
     1354         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1355         start-text = '"'  + ch  + '"' .
     1356       end.
     1357     n = num-entries(trim(start-text), chr(10)) - 1 .
     1358     do i = 1 to n :
     1359       ipos = index( start-text, chr(10)).
     1360       if ipos > 0 then
     1361         substring( start-text, ipos , 1 ) = ' '.
     1362     end.
     1363       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1364     return start-text.
     1365   end.
     1366   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1367   define variable  str  as char format "X(60)"  no-undo.
     1368   define variable  str2 as char no-undo.
     1369   define variable v-r as character no-undo init "" .
     1370   define variable  i#i as int no-undo.
     1371   STR = "".
     1372   repeat i#i =1 to lavel#:
     1373       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1374       else do:
     1375           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1376           if not error-status:error  and str2 <> "":u then
     1377                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1378           end.
     1379   end.
     1380   if str <> ? then do:
     1381   v-r = str + chr(47) .
     1382   end.
     1383   RETURN v-r .
     1384   END FUNCTION.
     1385   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   function func-get-name-from-ext-type   returns char
     1387     ( p-ext-type as character   ,
     1388       p-caps     as logical ).
     1389   define variable v-ext-name as character no-undo .
     1390   run get-name-from-ext-type in this-procedure (
     1391       input p-ext-type  ,
     1392       input p-caps  ,
     1393       output v-ext-name )
     1394       no-error .
     1395       if error-status :error then do:
     1396          assign
     1397            v-ext-name = p-ext-type
     1398          .
     1399       end.
     1400    return (v-ext-name) .
     1401   end.
     1402   procedure get-name-from-ext-type :
     1403    do
     1404    on error undo, return error return-value
     1405    :
     1406   define input  parameter p-ext-type as character no-undo .
     1407   define input  parameter p-caps     as logical no-undo   .
     1408   define output parameter p-ext-name as character no-undo .
     1409   define variable v-num as integer no-undo .
     1410     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1411       message
     1412         vss-include-info15 skip
     1413         "Неправильно задано значение входящего параметра! "
     1414         "Нет такого типа документов " p-ext-type
     1415         view-as alert-box error .
     1416         undo, return error .
     1417     end.
     1418     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1419     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1420     if p-caps  = true then do :
     1421        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1422     end .
     1423     end.
     1424   end procedure.
     1425   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1426   define variable v-waitfram-action01         as character   no-undo .
     1427   define variable v-waitfram-action02         as character   no-undo .
     1428   define variable v-waitfram-action03         as character   no-undo .
     1429   define variable mWaitFramTextBeg            as character   no-undo.
     1430   define variable mWaitFramTextEnd            as character   no-undo.
     1431   define variable mWaitFramView               as logical     no-undo.
     1432   define variable mWaitProcEvent              as logical     no-undo init yes.
     1433   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1434   define variable mWaitFramStop               as logical     no-undo.
     1435   define variable mWaitFramStopUser           as logical     no-undo.
     1436   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1437   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1438   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1439   define button B-WaitFramStop auto-end-key
     1440        label "Стоп"
     1441        size 10 by 1 tooltip "Остоновить процесс".
     1442   define button B-viewProcInfo
     1443        label "Информация"
     1444        size 15 by 1 tooltip "Информация о процесс".
     1445   define frame waitfram
     1446     v-waitfram-action01 format "x(72)" no-label skip
     1447     v-waitfram-action02 format "x(72)" no-label skip
     1448     v-waitfram-action03 format "x(72)" no-label skip
     1449     B-viewProcInfo
     1450     B-WaitFramStop at row 4 col 30
     1451     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1452     .
     1453   define new global shared variable mBatchMode as logical no-undo init ?.
     1454   define variable mFramBachModHandle as handle no-undo.
     1455   mFramBachModHandle = frame waitfram:handle.
     1456   define variable mFameOldVis as logical no-undo.
     1457   define variable mVisCUrentVin as logical no-undo.
     1458   if session:batch-mode
     1459   then
     1460      mBatchMode = yes.
     1461   if mBatchMode = ? then do:
     1462     mVisCUrentVin = current-window:visible.
     1463     mFameOldVis = mFramBachModHandle:visible.
     1464     mFramBachModHandle:visible  = yes.
     1465     mBatchMode = mFramBachModHandle:visible ne yes.
     1466     mFramBachModHandle:visible = mFameOldVis.
     1467     current-window:visible = mVisCUrentVin.
     1468   end.
     1469    if  log-manager:logfile-name ne ?
     1470     then DO:
     1471         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1472         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1473         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1474     end.
     1475   on choose of B-WaitFramStop in frame waitfram
     1476   do:
     1477     mWaitFramStop = yes.
     1478     mWaitFramStopUser = yes.
     1479   end.
     1480   function waitfram-check-timeout returns logical():
     1481      define variable vtime as int64 no-undo.
     1482      if mWaitFramStopTimeOut
     1483      then
     1484         return yes.
     1485      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1486      if     mWaitFramTimeOut ne ?
     1487         and mWaitFramTimeOut ne 0
     1488         and mWaitFramTimeOut lt vtime
     1489      then do:
     1490         mWaitFramStopTimeOut = yes.
     1491      end.
     1492      return mWaitFramStopTimeOut.
     1493   end.
     1494   procedure waitfram-hide :
     1495     if not session:batch-mode
     1496     then do
     1497     on error undo, return error return-value
     1498     :
     1499       pause 0 before-hide .
     1500       if not mBatchMode then
     1501         hide frame waitfram .
     1502     if     not mWaitFramView
     1503        and mWaitProcEvent
     1504     then
     1505       process events .
     1506     end.
     1507   end procedure.
     1508   procedure waitfram-show :
     1509     define input  parameter p-message as character no-undo .
     1510     define variable v-left-margin as integer   no-undo .
     1511     if not session:batch-mode
     1512     then do
     1513     on error undo, return error return-value
     1514     :
     1515       if length(p-message) <= 70 then do:
     1516         assign
     1517           v-left-margin = integer((70 - length(p-message)) / 2)
     1518         .
     1519         assign
     1520           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1521         .
     1522         assign
     1523           v-waitfram-action01 = " "
     1524           v-waitfram-action02 = " "
     1525                                    + fill(" ", v-left-margin)
     1526                                    + p-message
     1527           v-waitfram-action03 = " "
     1528         .
     1529       end.
     1530       else do:
     1531         define variable vRindex1 as integer no-undo.
     1532         define variable vRindex2 as integer no-undo.
     1533         vRindex1 = r-index(p-message," ",70).
     1534         if vRindex1 = 0
     1535         then
     1536            vRindex1 = 70.
     1537         if length(p-message)  <= vRindex1 + 70 then do:
     1538           assign
     1539             v-waitfram-action01 = " "
     1540             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1541             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1542           .
     1543         end.
     1544         else do:
     1545           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1546           if vRindex2 <= vRindex1
     1547           then
     1548              vRindex2 = vRindex1 + 70.
     1549           assign
     1550             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1551             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1552             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1553           .
     1554         end.
     1555       end.
     1556       B-viewProcInfo:visible   in frame waitfram = no.
     1557       B-viewProcInfo:sensitive in frame waitfram = no.
     1558       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1559       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1560       if  (   mWaitFramView
     1561          or  mWaitProcEvent)
     1562          and not mBatchMode
     1563       then
     1564          display
     1565             v-waitfram-action01 skip
     1566             v-waitfram-action02 skip
     1567             v-waitfram-action03 skip
     1568          with frame waitfram .
     1569       if     mWaitFramView
     1570          then do:
     1571             if     mWaitFramInterval ne ?
     1572                and not mBatchMode
     1573             then
     1574                wait-for go of frame waitfram pause mWaitFramInterval.
     1575          end.
     1576          else
     1577             if     mWaitProcEvent
     1578                and not mBatchMode
     1579             then
     1580                process events .
     1581     end.
     1582   end procedure.
     1583      procedure waitfram-show-this:
     1584         define input  parameter iInterval as int64 no-undo.
     1585         define variable vtime as int64 no-undo.
     1586         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1587         mWaitFramInterval = iInterval.
     1588         run waitfram-show (substitute("&1&2 &3&4" ,
     1589                                       mWaitFramTextBeg ,
     1590                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1591                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1592                                       mWaitFramTextEnd
     1593                                      )
     1594                           ).
     1595      end.
     1596      procedure WaitFramRunPause:
     1597         define input  parameter iInterval as dec no-undo.
     1598         define variable vStart  as datetime-tz no-undo.
     1599         define variable vend    as datetime-tz no-undo.
     1600         define variable vint as int64 no-undo.
     1601         define variable vOk as logical no-undo.
     1602         vStart = now.
     1603         vend   = vStart.
     1604         publish "WaitFramPause" (iInterval,output vOk).
     1605         vend   =  now.
     1606         vint = vend - vStart.
     1607         vint = iInterval - vint / 1000.
     1608         if     not mWaitFramStop
     1609            and (   vint > 0
     1610                 or (    not vOk
     1611                     and iInterval eq ?
     1612                     )
     1613                 )
     1614         then
     1615            run waitfram-show-this (iInterval).
     1616         vend   =  now.
     1617         vint = vend - vStart.
     1618         vint = iInterval - vint / 1000.
     1619         if     not mWaitFramStop
     1620            and vint > 0
     1621         then do:
     1622            run gbl/pause.p (vint * 1000).
     1623         end.
     1624         if iInterval ne ?
     1625         then
     1626            publish "WaitFramStop".
     1627         waitfram-check-timeout().
     1628      end.
     1629      procedure WaitFramWaitFor:
     1630         define input  parameter iInterval as dec no-undo.
     1631         assign
     1632            mWaitFramStartProc   = now
     1633            mWaitFramStopUser    = no
     1634            mWaitFramStopTimeOut = no
     1635         .
     1636         block-wait:
     1637         do while not mWaitFramStop:
     1638            run WaitFramRunPause (iInterval).
     1639            if  waitfram-check-timeout()
     1640            then do:
     1641               leave block-wait.
     1642            end.
     1643         end.
     1644         run waitfram-hide.
     1645      end.
     1646   procedure waitfram-join :
     1647     define input  parameter p-line-1  as character no-undo .
     1648     define input  parameter p-line-2  as character no-undo .
     1649     define input  parameter p-line-3  as character no-undo .
     1650     define output parameter p-message as character no-undo .
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654       assign
     1655         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1656                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1657                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1658       .
     1659     end.
     1660   end procedure.
     1661   function waitfram-join-function returns character
     1662     (input p-line-1 as character
     1663     ,input p-line-2 as character
     1664     ,input p-line-3 as character
     1665     ).
     1666     define variable v-message as character no-undo .
     1667     run waitfram-join in this-procedure
     1668       (input  p-line-1
     1669       ,input  p-line-2
     1670       ,input  p-line-3
     1671       ,output v-message
     1672       ) .
     1673     return v-message .
     1674   end function .
     1675   define variable full-prih       as   decimal EXTENT 10 Format "->>>>>>>>>9.<<<" no-undo.
     1676   define variable full-rash       as   decimal EXTENT 10 Format "->>>>>>>>>9.<<<" no-undo.
     1677   define variable full-kassa      as   decimal EXTENT 10 Format "->>>>>>>>>9.<<<" no-undo.
     1678   define variable full-Inv2       as   decimal EXTENT 10 Format "->>>>>>>>>9.<<<" no-undo.
     1679   define variable full-Inv        as   decimal EXTENT 10 Format "->>>>>>>>>9.<<<" no-undo.
     1680   define variable full-spis       as   decimal EXTENT 10 Format "->>>>>>>>>9.<<<" no-undo.
     1681   define variable full-vzvr       as   decimal EXTENT 10 Format "->>>>>>>>>9.<<<" no-undo.
     1682   define variable full-vzvr-post  as   decimal EXTENT 10 Format "->>>>>>>>>9.<<<" no-undo.
     1683   define variable ii like i init 0 no-undo .
     1684   define buffer buf_parts for parts.
     1685   define temp-table temp_oborot_parts no-undo like parts
     1686   field ext-doc-type as character
     1687   field sum-rubl as decimal
     1688   field vat-rubl as decimal
     1689   field sum-base as decimal
     1690   field vat-base as decimal
     1691   .
     1692   define temp-table temp_oborot_parts-2 no-undo like parts
     1693   field ext-doc-type as character
     1694   field sum-rubl as decimal
     1695   field vat-rubl as decimal
     1696   field sum-base as decimal
     1697   field vat-base as decimal
     1698   .
     1699   define temp-table temp-null no-undo like temp-t-post-stk-line.
     1700   define variable p-first as logical no-undo .
     1701   p-first = true .
     1702   if cli-art = "yes" then do:
     1703    gds-zap-artic:label in frame zapas = "Арт.Постав."  .
     1704   end.
     1705   case RetClassify :
     1706         when "no-classify":U then do:
     1707           for each g#post-f :
     1708               run one-post in this-procedure .
     1709               run run1 in this-procedure .
     1710           end.
     1711         end.
     1712       when "post":U then do:
     1713         run run2 in this-procedure .
     1714       end.
     1715       when "post/grp-goods":U then do:
     1716         run run2 in this-procedure .
     1717       end.
     1718   end case.
     1719   if xtogobj =  true then do:
     1720      find first obj-list.
     1721       if available obj-list then do:
     1722         run print-footer in this-procedure  ( 0 , obj-list.obj-name ).
     1723         run clear-itemo- in this-procedure .
     1724       end.
     1725   end.
     1726   procedure one-post :
     1727    do
     1728    on error undo, return error return-value
     1729    :
     1730     run waitfram-show in this-procedure  (g#post-f.obj-name) .
     1731     for each obj-list :
     1732       for each buf_parts no-lock where
     1733           buf_parts.host-code = v-cntxt-host-code-obj      and
     1734           buf_parts.obj-code = obj-list.obj-code and
     1735           buf_parts.obj-type = obj-list.obj-type and
     1736           buf_parts.supp-type = g#post-f.obj-type  and
     1737           buf_parts.supp-code = g#post-f.obj-code  and
     1738           buf_parts.status_   = true             and
     1739           buf_parts.fact-date >= x-date-start    and
     1740           buf_parts.fact-date <= x-date-end
     1741       :
     1742           if type-stor <> 1 then do:
     1743              if buf_parts.purch-code <>  type-stor - 1 then next.
     1744           end.
     1745         find first goods no-lock where goods.artic      = buf_parts.artic     and
     1746                                        goods.prod-type = buf_parts.prod-type and
     1747                                        goods.prod-code = buf_parts.prod-code no-error .
     1748           if not available goods then next.
     1749           find first trn-doc no-lock where
     1750                 trn-doc.doc-code     = buf_parts.out-code
     1751                  no-error .
     1752           if not available trn-doc then next.
     1753           create temp_oborot_parts.
     1754           BUFFER-COPY buf_parts  to temp_oborot_parts
     1755               assign
     1756                 temp_oborot_parts.ext-doc-type = trn-doc.ext-doc-type
     1757                 temp_oborot_parts.sum-rubl = buf_parts.fact-qnty * buf_parts.price-rubl
     1758                 temp_oborot_parts.sum-base = buf_parts.fact-qnty * buf_parts.price-base
     1759               .
     1760           find first temp-t-post-stk-line where
     1761                      temp-t-post-stk-line.artic     = temp_oborot_parts.artic     and
     1762                      temp-t-post-stk-line.prod-type = temp_oborot_parts.prod-type and
     1763                      temp-t-post-stk-line.prod-code = temp_oborot_parts.prod-code  no-error .
     1764                      if not available temp-t-post-stk-line then do:
     1765                         create temp-t-post-stk-line.
     1766                         assign
     1767                           temp-t-post-stk-line.artic     = temp_oborot_parts.artic
     1768                           temp-t-post-stk-line.prod-type = temp_oborot_parts.prod-type
     1769                           temp-t-post-stk-line.prod-code = temp_oborot_parts.prod-code
     1770                           temp-t-post-stk-line.gds-name  = goods.gds-name
     1771                           temp-t-post-stk-line.unit-base = goods.unit-base
     1772                           temp-t-post-stk-line.prt-root  = 0
     1773                           temp-t-post-stk-line.Goods-grp-name   = goods.grp-name
     1774                           temp-t-post-stk-line.gds-code         = goods.gds-code
     1775                           temp-t-post-stk-line.gds-type         = goods.gds-type
     1776                           temp-t-post-stk-line.Cli-type         = g#post-f.obj-type
     1777                           temp-t-post-stk-line.Cli-code         = g#post-f.obj-code
     1778                           temp-t-post-stk-line.Clients-grp-name = g#post-f.obj-name
     1779                         .
     1780                      end.
     1781       end.
     1782     end.
     1783    end.
     1784   end procedure.
     1785   procedure Print-Header :
     1786   define input parameter N as integer no-undo .
     1787   define input parameter Name as char no-undo .
     1788       PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     1789       if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     1790   END PROCEDURE.
     1791   PROCEDURE display-line :
     1792     i = i + 1.
     1793   If Integer(10) = 0 Then Temp1  = 100  .
     1794                         Else Temp1 = Integer(10) .
     1795        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     1796            RUN waitfram-show( "Обработано строк : " + string( i )) .
     1797     run clear-item  in this-procedure .
     1798       assign
     1799             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     1800             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     1801             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     1802             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     1803             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     1804             gds-zap-artic      = temp-t-post-stk-line.artic
     1805             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     1806             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     1807             gds-zap-type       = temp-t-post-stk-line.gds-type
     1808             pos-cli-type       = temp-t-post-stk-line.Cli-type
     1809             pos-cli-code       = temp-t-post-stk-line.Cli-code
     1810             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     1811             if cli-art = "yes" then do:
     1812                 gds-post-artic     = "" .
     1813                 find first ub.ext-artic no-lock where
     1814                         ub.ext-artic.gds-code = temp-t-post-stk-line.gds-code and
     1815                         ub.ext-artic.cli-type = temp-t-post-stk-line.Cli-type and
     1816                         ub.ext-artic.cli-code = temp-t-post-stk-line.Cli-code and
     1817                         ub.ext-artic.status_   =  'тек':U no-error .
     1818                 if available ub.ext-artic then do:
     1819                       assign
     1820                         gds-post-artic     = ub.ext-artic.ext-artic
     1821                       .
     1822                 end.
     1823                gds-zap-artic = gds-post-artic .
     1824             end.
     1825   run ob-line in this-procedure
     1826         ( INPUT temp-t-post-stk-line.artic     ,
     1827           INPUT temp-t-post-stk-line.prod-code ,
     1828           INPUT temp-t-post-stk-line.prod-type  ).
     1829   run ost-line in this-procedure
     1830         ( INPUT temp-t-post-stk-line.artic     ,
     1831           INPUT temp-t-post-stk-line.prod-code ,
     1832           INPUT temp-t-post-stk-line.prod-type  ) .
     1833            run calc-sub-itog in this-procedure (0).
     1834            run calc-sub-itog in this-procedure (6).
     1835          if  not ( (ostatok-start[1] = 0  and
     1836                    prih         [1] = 0  and
     1837                    rash         [1] = 0  and
     1838                    kassa        [1] = 0  and
     1839                    inv          [1] = 0  and
     1840                    vzvr         [1] = 0  and
     1841                    spis         [1] = 0  and
     1842                    vzvr-post    [1] = 0  and
     1843                    ostatok-end  [1] = 0)) then do:
     1844            IF NOT Sums-Only then DO:
     1845               run display-str1 in this-procedure .
     1846               run clear-item in this-procedure .
     1847            End.
     1848          End.
     1849     END PROCEDURE.
     1850   PROCEDURE display-str1  :
     1851         run di-qnty ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     1852            if show-cost then do : run di ( "учет." , 2, "","","","","" ).  end.
     1853            if xshowgoods then do : run di ( "в пути", 7, "","","","","" ).  end.
     1854         run clear-item.
     1855    END PROCEDURE.
     1856   PROCEDURE Di :
     1857   define input parameter p1 as char no-undo.
     1858   define input parameter p2 as int no-undo.
     1859   define input parameter p3 as char no-undo.
     1860   define input parameter p4 as char no-undo.
     1861   define input parameter p5 as char no-undo.
     1862   define input parameter p6 as char no-undo.
     1863   define input parameter p7 as char no-undo.
     1864    CASE CAPS(p7) :
     1865      WHEN "B1":U  Then do:
     1866   if  not (
     1867      (b1-ostatok-start[1] = 0  and
     1868       b1-Prih         [1] = 0  AND
     1869       b1-RAsh         [1] = 0  AND
     1870       b1-KAssa        [1] = 0  AND
     1871       b1-Inv          [1] = 0  AND
     1872       b1-vzvr         [1] = 0  AND
     1873       b1-spis         [1] = 0  AND
     1874       b1-vzvr-post    [1] = 0  AND
     1875       b1-Ostatok-end  [1] = 0)) then DO:
     1876                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     1877                   p3 @ gds-zap-b-code
     1878                   p4 @ gds-zap-artic
     1879                   p5 @ gds-zap-gds-name
     1880                   p6 @ gds-zap-unit-base
     1881                   p1 @ gds-type
     1882                   b1-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     1883                   b1-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     1884                   b1-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     1885                   b1-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     1886                   b1-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     1887                   b1-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     1888                   b1-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     1889                   b1-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     1890                   b1-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     1891                  with FRAME ZAPAS .
     1892                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     1893   end.
     1894     end.
     1895      WHEN "B2":U  Then do:
     1896   if  not (
     1897      (b2-ostatok-start[1] = 0  and
     1898       b2-Prih         [1] = 0  AND
     1899       b2-RAsh         [1] = 0  AND
     1900       b2-KAssa        [1] = 0  AND
     1901       b2-Inv          [1] = 0  AND
     1902       b2-vzvr         [1] = 0  AND
     1903       b2-spis         [1] = 0  AND
     1904       b2-vzvr-post    [1] = 0  AND
     1905       b2-Ostatok-end  [1] = 0)) then DO:
     1906                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     1907                   p3 @ gds-zap-b-code
     1908                   p4 @ gds-zap-artic
     1909                   p5 @ gds-zap-gds-name
     1910                   p6 @ gds-zap-unit-base
     1911                   p1 @ gds-type
     1912                   b2-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     1913                   b2-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     1914                   b2-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     1915                   b2-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     1916                   b2-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     1917                   b2-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     1918                   b2-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     1919                   b2-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     1920                   b2-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     1921                  with FRAME ZAPAS .
     1922                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     1923   end.
     1924     end.
     1925      WHEN "BI":U Then do:
     1926   if  not (
     1927      (bi-ostatok-start[1] = 0  and
     1928       bi-Prih         [1] = 0  AND
     1929       bi-RAsh         [1] = 0  AND
     1930       bi-KAssa        [1] = 0  AND
     1931       bi-Inv          [1] = 0  AND
     1932       bi-vzvr         [1] = 0  AND
     1933       bi-spis         [1] = 0  AND
     1934       bi-vzvr-post    [1] = 0  AND
     1935       bi-Ostatok-end  [1] = 0)) then DO:
     1936                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     1937                   p3 @ gds-zap-b-code
     1938                   p4 @ gds-zap-artic
     1939                   p5 @ gds-zap-gds-name
     1940                   p6 @ gds-zap-unit-base
     1941                   p1 @ gds-type
     1942                   bi-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     1943                   bi-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     1944                   bi-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     1945                   bi-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     1946                   bi-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     1947                   bi-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     1948                   bi-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     1949                   bi-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     1950                   bi-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     1951                  with FRAME ZAPAS .
     1952                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     1953   end.
     1954     end.
     1955      WHEN "P":U Then do:
     1956   if  not (
     1957      (p-ostatok-start[1] = 0  and
     1958       p-Prih         [1] = 0  AND
     1959       p-RAsh         [1] = 0  AND
     1960       p-KAssa        [1] = 0  AND
     1961       p-Inv          [1] = 0  AND
     1962       p-vzvr         [1] = 0  AND
     1963       p-spis         [1] = 0  AND
     1964       p-vzvr-post    [1] = 0  AND
     1965       p-Ostatok-end  [1] = 0)) then DO:
     1966                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     1967                   p3 @ gds-zap-b-code
     1968                   p4 @ gds-zap-artic
     1969                   p5 @ gds-zap-gds-name
     1970                   p6 @ gds-zap-unit-base
     1971                   p1 @ gds-type
     1972                   p-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     1973                   p-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     1974                   p-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     1975                   p-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     1976                   p-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     1977                   p-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     1978                   p-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     1979                   p-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     1980                   p-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     1981                  with FRAME ZAPAS .
     1982                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     1983   end.
     1984     end.
     1985      WHEN "O"  Then     DO :
     1986   if  not (
     1987      (o-ostatok-start[1] = 0  and
     1988       o-Prih         [1] = 0  AND
     1989       o-RAsh         [1] = 0  AND
     1990       o-KAssa        [1] = 0  AND
     1991       o-Inv          [1] = 0  AND
     1992       o-vzvr         [1] = 0  AND
     1993       o-spis         [1] = 0  AND
     1994       o-vzvr-post    [1] = 0  AND
     1995       o-Ostatok-end  [1] = 0)) then DO:
     1996                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     1997                   p3 @ gds-zap-b-code
     1998                   p4 @ gds-zap-artic
     1999                   p5 @ gds-zap-gds-name
     2000                   p6 @ gds-zap-unit-base
     2001                   p1 @ gds-type
     2002                   o-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     2003                   o-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     2004                   o-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     2005                   o-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     2006                   o-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     2007                   o-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     2008                   o-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     2009                   o-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     2010                   o-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     2011                  with FRAME ZAPAS .
     2012                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2013   end.
     2014        End.
     2015      WHEN ""  Then DO:
     2016   if  not (
     2017      (ostatok-start[1] = 0  and
     2018       Prih         [1] = 0  AND
     2019       RAsh         [1] = 0  AND
     2020       KAssa        [1] = 0  AND
     2021       Inv          [1] = 0  AND
     2022       vzvr         [1] = 0  AND
     2023       spis         [1] = 0  AND
     2024       vzvr-post    [1] = 0  AND
     2025       Ostatok-end  [1] = 0)) then DO:
     2026                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     2027                   p3 @ gds-zap-b-code
     2028                   p4 @ gds-zap-artic
     2029                   p5 @ gds-zap-gds-name
     2030                   p6 @ gds-zap-unit-base
     2031                   p1 @ gds-type
     2032                   ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     2033                   Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     2034                   RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     2035                   KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     2036                   Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     2037                   spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
