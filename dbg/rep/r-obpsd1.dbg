     2448                   o-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     2449                   o-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     2450                   o-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     2451                   o-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     2452                   o-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     2453                   o-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     2454                   o-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     2455                   o-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     2456                   o-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     2457                  with FRAME ZAPAS .
     2458                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2459   end.
     2460   if  not (
     2461      (o-ostatok-start[1] = 0  and
     2462       o-Prih         [1] = 0  AND
     2463       o-RAsh         [1] = 0  AND
     2464       o-KAssa        [1] = 0  AND
     2465       o-Inv          [1] = 0  AND
     2466       o-vzvr         [1] = 0  AND
     2467       o-spis         [1] = 0  AND
     2468       o-vzvr-post    [1] = 0  AND
     2469       o-Ostatok-end  [1] = 0)) then DO:
     2470       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     2471                   p4 CHR(9)
     2472                   p5 CHR(9)
     2473                   p6 CHR(9)
     2474                      ( excel-qnty(o-ostatok-start[1]) +  CHR(9))
     2475   if Show-cost  then  ( excel-sum(o-ostatok-start[2]) +  CHR(9))   else ("")
     2476   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     2477   if xShowgoods then  ( excel-qnty(o-ostatok-start[7]) +  CHR(9))   else ("")
     2478                      ( excel-qnty(o-Prih         [1]) +  CHR(9))
     2479   if Show-cost  then  ( excel-sum(o-Prih         [2]) +  CHR(9))   else ("")
     2480   if Show-sale  then  ( excel-sum(o-Prih         [8]) +  CHR(9))   else ("")
     2481                      ( excel-qnty(o-RAsh         [1]) +  CHR(9))
     2482   if Show-cost  then  ( excel-sum(o-RAsh         [2]) +  CHR(9))   else ("")
     2483   if Show-sale  then  ( excel-sum(o-RAsh         [8]) +  CHR(9))   else ("")
     2484                      ( excel-qnty(o-KAssa        [1]) +  CHR(9))
     2485   if Show-cost  then  ( excel-sum(o-KAssa        [2]) +  CHR(9))   else ("")
     2486   if Show-sale  then  ( excel-sum(o-KAssa        [8]) +  CHR(9))   else ("")
     2487                      ( excel-qnty(o-Inv          [1]) +  CHR(9))
     2488   if Show-cost  then  ( excel-sum(o-Inv          [2]) +  CHR(9))   else ("")
     2489   if Show-sale  then  ( excel-sum(o-Inv          [8]) +  CHR(9))   else ("")
     2490                      ( excel-qnty(o-spis         [1]) +  CHR(9))
     2491   if Show-cost  then  ( excel-sum(o-spis         [2]) +  CHR(9))   else ("")
     2492   if Show-sale  then  ( excel-sum(o-spis         [8]) +  CHR(9))   else ("")
     2493                      ( excel-qnty(o-vzvr         [1]) +  CHR(9))
     2494   if Show-cost  then  ( excel-sum(o-vzvr         [2]) +  CHR(9))   else ("")
     2495   if Show-sale  then  ( excel-sum(o-vzvr         [8]) +  CHR(9))   else ("")
     2496                      ( excel-qnty(o-vzvr-post    [1]) +  CHR(9))
     2497   if Show-cost  then  ( excel-sum(o-vzvr-post    [2]) +  CHR(9))   else ("")
     2498   if Show-sale  then  ( excel-sum(o-vzvr-post    [8]) +  CHR(9))   else ("")
     2499                      ( excel-qnty(o-Ostatok-end  [1]) +  CHR(9))
     2500   if Show-cost  then  ( excel-sum(o-Ostatok-end  [2]) +  CHR(9))   else ("")
     2501   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     2502   if xShowgoods then  ( excel-qnty(o-ostatok-end[7]) +  CHR(9))   else ("")
     2503      chr(10).
     2504   end.
     2505                 End.
     2506       End case.
     2507    END PROCEDURE.
     2508   procedure Print-Footer :
     2509   define input parameter Nx as integer no-undo .
     2510   define input parameter Name as char no-undo .
     2511       if Nx = 1 Then DO:
     2512            run di-qnty  in this-procedure ("кол-во", 1,"","Итого по : ",trim(name),"","b1").
     2513            if show-cost then do : run di  in this-procedure ( "учет." , 2, "","","","","b1" ).  end.
     2514            if xshowgoods then do : run di in this-procedure  ( "в пути", 7, "","","","","b1" ).  end.
     2515            if not sums-only then run u-line in this-procedure .
     2516            run clear-itemb1- in this-procedure .
     2517            End.
     2518    if Nx = 2 Then DO:
     2519            run di-qnty ("кол-во", 1,"","","Итого по : " + trim(name),"","b2").
     2520            if show-cost then do : run di ( "учет." , 2, "","","","","b2" ).  end.
     2521            if xshowgoods then do : run di ( "в пути", 8, "","","","","b2" ).  end.
     2522            if not sums-only then run u-line.
     2523            run clear-itemb2-.
     2524           End.
     2525    if nx = 3 then do:
     2526       if  not ((p-ostatok-start[1] = 0  and
     2527                 p-prih         [1] = 0  and
     2528                 p-rash         [1] = 0  and
     2529                 p-kassa        [1] = 0  and
     2530                 p-inv          [1] = 0  and
     2531                 p-vzvr         [1] = 0  and
     2532                 p-vzvr-post    [1] = 0  and
     2533                 p-ostatok-end  [1] = 0)) then do:
     2534           if not sums-only then run u-line.
     2535           run di-qnty ("кол-во", 1,"","Итого по пост-ку" , trim(name),"","p").
     2536           if show-cost then do : run di ( "учет." , 2, "","","","","p" ).  end.
     2537           if xShowGoods then do : run di ( "в пути", 7, "","","","","p" ).  end.
     2538           if not sums-only then run u-line.
     2539         end.
     2540         run clear-itemp- in this-procedure .
     2541    End.
     2542    if Nx = 0 Then DO:
     2543            run di-qnty ("кол-во", 1,"","Итого  объект: " , trim(name),"","o").
     2544            if show-cost then do : run di ( "учет." , 2, "","","","","o" ).  end.
     2545            if xshowgoods then do : run di ( "в пути", 8, "","","","","o" ).  end.
     2546            if not sums-only then run u-line.
     2547            run clear-itemo-.
     2548             End.
     2549    END PROCEDURE.
     2550   PROCEDURE Clear-item :
     2551   define variable kk as int no-undo.
     2552    REPEAT kk = 1 to 9:
     2553    Assign
     2554       prih             [kk]  = 0
     2555       rash             [kk]  = 0
     2556       kassa            [kk]  = 0
     2557       spis             [kk]  = 0
     2558       Inv              [kk]  = 0
     2559       Inv2             [kk]  = 0
     2560       vzvr             [kk]  = 0
     2561       vzvr-post        [kk]  = 0
     2562       full-prih             [kk]  = 0
     2563       full-rash             [kk]  = 0
     2564       full-kassa            [kk]  = 0
     2565       full-spis             [kk]  = 0
     2566       full-Inv              [kk]  = 0
     2567       full-Inv2             [kk]  = 0
     2568       full-vzvr             [kk]  = 0
     2569       full-vzvr-post        [kk]  = 0
     2570       ostatok-start         [kk]  = 0
     2571       ostatok-end           [kk]  = 0
     2572        .
     2573          End.
     2574    END PROCEDURE.
     2575   PROCEDURE Clear-itemb1- :
     2576   define variable kk as int no-undo.
     2577    REPEAT kk = 1 to 9:
     2578    Assign
     2579      b1-prih             [kk]  = 0
     2580      b1-rash             [kk]  = 0
     2581      b1-kassa            [kk]  = 0
     2582      b1-spis             [kk]  = 0
     2583      b1-Inv              [kk]  = 0
     2584      b1-vzvr             [kk]  = 0
     2585      b1-vzvr-post        [kk]  = 0
     2586      b1-ostatok-end      [kk]  = 0
     2587      b1-ostatok-start    [kk]  = 0
     2588      .
     2589          End.
     2590    END PROCEDURE.
     2591   PROCEDURE Clear-itemb2- :
     2592   define variable kk as int no-undo.
     2593    REPEAT kk = 1 to 9:
     2594    Assign
     2595      b2-prih             [kk]  = 0
     2596      b2-rash             [kk]  = 0
     2597      b2-kassa            [kk]  = 0
     2598      b2-spis             [kk]  = 0
     2599      b2-Inv              [kk]  = 0
     2600      b2-vzvr             [kk]  = 0
     2601      b2-vzvr-post        [kk]  = 0
     2602      b2-ostatok-end      [kk]  = 0
     2603      b2-ostatok-start    [kk]  = 0
     2604      .
     2605      End.
     2606    END PROCEDURE.
     2607   PROCEDURE Clear-itemp- :
     2608   define variable kk as int no-undo.
     2609    REPEAT kk = 1 to 9:
     2610    Assign
     2611      p-prih             [kk]  = 0
     2612      p-rash             [kk]  = 0
     2613      p-kassa            [kk]  = 0
     2614      p-spis             [kk]  = 0
     2615      p-Inv              [kk]  = 0
     2616      p-vzvr             [kk]  = 0
     2617      p-vzvr-post        [kk]  = 0
     2618      p-ostatok-end      [kk]  = 0
     2619      p-ostatok-start    [kk]  = 0
     2620      .
     2621      End.
     2622    END PROCEDURE.
     2623   PROCEDURE Clear-itemo- :
     2624   define variable kk as int no-undo.
     2625    REPEAT kk = 1 to 9:
     2626    Assign
     2627      o-prih             [kk]  = 0
     2628      o-rash             [kk]  = 0
     2629      o-kassa            [kk]  = 0
     2630      o-Spis             [kk]  = 0
     2631      o-Inv              [kk]  = 0
     2632      o-vzvr             [kk]  = 0
     2633      o-vzvr-post        [kk]  = 0
     2634      o-ostatok-end      [kk]  = 0
     2635      o-ostatok-start    [kk]  = 0
     2636      .
     2637      End.
     2638    END PROCEDURE.
     2639   PROCEDURE ob-line :
     2640   define INPUT  parameter x-artic          like goods.artic        no-undo.
     2641   define INPUT  parameter x-prod-code      like goods.prod-code    no-undo.
     2642   define INPUT  parameter x-prod-type      like goods.prod-type    no-undo.
     2643        FOR each temp_oborot_parts where
     2644                 temp_oborot_parts.artic        = x-artic
     2645           AND   temp_oborot_parts.prod-code    = x-prod-code
     2646           AND   temp_oborot_parts.prod-type    = x-prod-type
     2647                  no-lock :
     2648           CASE temp_oborot_parts.ext-doc-type:
     2649                WHEN        'iv':U      OR
     2650                WHEN        'rv':U  OR
     2651                WHEN        'im':U     THEN     DO:
     2652              if t-in then
     2653              ASSIGN prih[1 ]   = prih[1 ]   +  temp_oborot_parts.fact-qnty
     2654                     prih[2 ]   = prih[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2655                     prih[3 ]   = prih[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2656                     .
     2657              ASSIGN full-prih[1 ]   = full-prih[1 ]   +  temp_oborot_parts.fact-qnty
     2658                     full-prih[2 ]   = full-prih[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2659                     full-prih[3 ]   = full-prih[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2660                     .
     2661                 end.
     2662                WHEN        'ie':U   THEN     DO:
     2663              ASSIGN prih[1 ]   = prih[1 ]   +  temp_oborot_parts.fact-qnty
     2664                     prih[2 ]   = prih[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2665                     prih[3 ]   = prih[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2666                     .
     2667              ASSIGN full-prih[1 ]   = full-prih[1 ]   +  temp_oborot_parts.fact-qnty
     2668                     full-prih[2 ]   = full-prih[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2669                     full-prih[3 ]   = full-prih[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2670                     .
     2671                    End.
     2672                WHEN        're':U  THEN DO:
     2673              ASSIGN vzvr[1 ]   = vzvr[1 ]   +  temp_oborot_parts.fact-qnty
     2674                     vzvr[2 ]   = vzvr[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2675                     vzvr[3 ]   = vzvr[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2676                     .
     2677              ASSIGN full-vzvr[1 ]   = full-vzvr[1 ]   +  temp_oborot_parts.fact-qnty
     2678                     full-vzvr[2 ]   = full-vzvr[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2679                     full-vzvr[3 ]   = full-vzvr[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2680                     .
     2681                    End.
     2682                WHEN       'ep':U  THEN DO:
     2683              ASSIGN vzvr-post[1 ]   = vzvr-post[1 ]   +  temp_oborot_parts.fact-qnty
     2684                     vzvr-post[2 ]   = vzvr-post[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2685                     vzvr-post[3 ]   = vzvr-post[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2686                     .
     2687              ASSIGN full-vzvr-post[1 ]   = full-vzvr-post[1 ]   +  temp_oborot_parts.fact-qnty
     2688                     full-vzvr-post[2 ]   = full-vzvr-post[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2689                     full-vzvr-post[3 ]   = full-vzvr-post[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2690                     .
     2691                    End.
     2692                WHEN       'ee':U          THEN  DO:
     2693                ASSIGN rash[1 ]   = rash[1 ]   +  temp_oborot_parts.fact-qnty
     2694                       rash[2 ]   = rash[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2695                       rash[3 ]   = rash[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2696                       .
     2697                ASSIGN full-rash[1 ]   = full-rash[1 ]   +  temp_oborot_parts.fact-qnty
     2698                       full-rash[2 ]   = full-rash[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2699                       full-rash[3 ]   = full-rash[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2700                       .
     2701                    End.
     2702                WHEN       'ev':U       OR
     2703                WHEN       'em':U        THEN  DO:
     2704              if t-in then
     2705              ASSIGN rash[1 ]   = rash[1 ]   +  temp_oborot_parts.fact-qnty
     2706                     rash[2 ]   = rash[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2707                     rash[3 ]   = rash[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2708                     .
     2709              ASSIGN full-rash[1 ]   = full-rash[1 ]   +  temp_oborot_parts.fact-qnty
     2710                     full-rash[2 ]   = full-rash[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2711                     full-rash[3 ]   = full-rash[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2712                     .
     2713                    End.
     2714                WHEN       'es':U  then
     2715              ASSIGN kassa[1 ]   = kassa[1 ]   +  temp_oborot_parts.fact-qnty
     2716                     kassa[2 ]   = kassa[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2717                     kassa[3 ]   = kassa[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2718                     full-kassa[1 ]   = full-kassa[1 ]   +  temp_oborot_parts.fact-qnty
     2719                     full-kassa[2 ]   = full-kassa[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2720                     full-kassa[3 ]   = full-kassa[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2721                     .
     2722                WHEN       'rs':U THEN  DO:
     2723              ASSIGN kassa[1 ]   = kassa[1 ]   -  temp_oborot_parts.fact-qnty
     2724                     kassa[2 ]   = kassa[2 ]   -  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2725                     kassa[3 ]   = kassa[3 ]   -  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2726                     .
     2727              ASSIGN full-kassa[1 ]   = full-kassa[1 ]   -  temp_oborot_parts.fact-qnty
     2728                     full-kassa[2 ]   = full-kassa[2 ]   -  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2729                     full-kassa[3 ]   = full-kassa[3 ]   -  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2730                     .
     2731                    End.
     2732                WHEN       'vt':U               or
     2733                WHEN       'mp':U  or
     2734                WHEN       'vp':U          then do:
     2735                   ASSIGN  INV[1 ]   = INV[1 ]   +  temp_oborot_parts.fact-qnty
     2736                           Inv[2 ]   = Inv[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2737                           Inv[3 ]   = Inv[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2738                           INV2[1 ]   = INV2[1 ]   +  temp_oborot_parts.fact-qnty
     2739                           INV2[2 ]   = INV2[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2740                           full-INV2[1 ]   = full-INV2[1 ]   +  temp_oborot_parts.fact-qnty
     2741                           full-INV2[2 ]   = full-INV2[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2742                           .
     2743                end.
     2744                WHEN       'pc':U      THEN  DO:
     2745              ASSIGN INV[1 ]   = INV[1 ]   +  temp_oborot_parts.fact-qnty
     2746                     Inv[2 ]   = Inv[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2747                     Inv[3 ]   = Inv[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2748                     .
     2749                    End.
     2750              when 'ap':U  then do:
     2751                 ASSIGN
     2752                     Inv[2 ]   = Inv[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2753                     Inv2[2 ]   = Inv2[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2754                     full-INV2[2 ]   = full-INV2[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2755                     .
     2756              end.
     2757                WHEN       'we':U       THEN  DO:
     2758              ASSIGN spis[1 ]   = spis[1 ]   +  temp_oborot_parts.fact-qnty
     2759                     spis[2 ]   = spis[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2760                     spis[3 ]   = spis[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2761                     .
     2762              ASSIGN full-spis[1 ]   = full-spis[1 ]   +  temp_oborot_parts.fact-qnty
     2763                     full-spis[2 ]   = full-spis[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2764                     full-spis[3 ]   = full-spis[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2765                     .
     2766                    End.
     2767                WHEN       'wm':U       THEN  DO:
     2768              if t-in then
     2769              ASSIGN spis[1 ]   = spis[1 ]   +  temp_oborot_parts.fact-qnty
     2770                     spis[2 ]   = spis[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2771                     spis[3 ]   = spis[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2772                     .
     2773              ASSIGN full-spis[1 ]   = full-spis[1 ]   +  temp_oborot_parts.fact-qnty
     2774                     full-spis[2 ]   = full-spis[2 ]   +  if tprintrubl then temp_oborot_parts.sum-rubl else temp_oborot_parts.sum-base
     2775                     full-spis[3 ]   = full-spis[3 ]   +  if tprintrubl then temp_oborot_parts.vat-rubl else temp_oborot_parts.vat-base
     2776                     .
     2777                    End.
     2778             End CASE.
     2779      End.
     2780   END PROCEDURE.
     2781   procedure ost-line :
     2782    do
     2783    on error undo, return error return-value
     2784    :
     2785   define INPUT  parameter x-artic          like goods.artic        no-undo.
     2786   define INPUT  parameter x-prod-code      like goods.prod-code    no-undo.
     2787   define INPUT  parameter x-prod-type      like goods.prod-type    no-undo.
     2788    define variable ostatok-today as decimal EXTENT 10  no-undo .
     2789    ostatok-today[1] = 0 .
     2790    ostatok-today[2] = 0 .
     2791    define buffer ost_parts for parts .
     2792    for each obj-list :
     2793       for each ost_parts no-lock where
     2794           ost_parts.artic     = x-artic             and
     2795           ost_parts.prod-type = x-prod-type         and
     2796           ost_parts.prod-code = x-prod-code         and
     2797           ost_parts.host-code = v-cntxt-host-code-obj         and
     2798           ost_parts.supp-type = g#post-f.obj-type     and
     2799           ost_parts.supp-code = g#post-f.obj-code     and
     2800           ost_parts.status_   =  false              and
     2801           ost_parts.obj-type  =  obj-list.obj-type  and
     2802           ost_parts.obj-code  =  obj-list.obj-code  and
     2803           ost_parts.in-code   <> ost_parts.out-code and
     2804           ost_parts.rsrv-free = true    :
     2805           if type-stor <> 1 then do:
     2806              if ost_parts.purch-code <>  type-stor - 1 then next.
     2807           end.
     2808           if ost_parts.out-code = 'free-zone':U then do:
     2809              ostatok-today[1] = ostatok-today[1] + ost_parts.fact-qnty .
     2810              ostatok-today[2] = ostatok-today[2] + ost_parts.fact-qnty  * (if tprintrubl  = true then ost_parts.price-rubl else ost_parts.price-base).
     2811           end.
     2812           else do:
     2813               ostatok-today[1] = ostatok-today[1] + abs(ost_parts.fact-qnty) .
     2814               ostatok-today[2] = ostatok-today[2] + abs(ost_parts.fact-qnty) * (if tprintrubl  = true then ost_parts.price-rubl else ost_parts.price-base) .
     2815           end.
     2816       end.
     2817     end.
     2818    define variable oborot1  as decimal no-undo .
     2819    define variable oborot12 as decimal no-undo .
     2820    define variable oborot2  as decimal no-undo .
     2821    define variable oborot22 as decimal no-undo .
     2822    assign
     2823     oborot1  = 0
     2824     oborot12 = 0
     2825     oborot2  = 0
     2826     oborot22 = 0
     2827     .
     2828     if type-stor <> 1 then do:
     2829         assign
     2830           oborot1  = full-prih[1] - full-rash[1] - full-kassa[1] - full-vzvr-post[1] + full-vzvr[1] - full-spis[1] + inv[1]
     2831           oborot12 = full-prih[2] - full-rash[2] - full-kassa[2] - full-vzvr-post[2] + full-vzvr[2] - full-spis[2] + inv[2]
     2832         .
     2833     end.
     2834     else
     2835       assign
     2836           oborot1  = full-prih[1] - full-rash[1] - full-kassa[1] - full-vzvr-post[1] + full-vzvr[1] - full-spis[1] + full-inv2[1]
     2837           oborot12 = full-prih[2] - full-rash[2] - full-kassa[2] - full-vzvr-post[2] + full-vzvr[2] - full-spis[2] + full-inv2[2]
     2838       .
     2839    if x-date-start = today then  do:
     2840       ostatok-end  [1]  = ostatok-today [1].
     2841       ostatok-end  [2]  = ostatok-today [2].
     2842       ostatok-start[1]  = ostatok-today [1] .
     2843       ostatok-start[2]  = ostatok-today [2] .
     2844       end.
     2845    if x-date-end   = today then do:
     2846       ostatok-end  [1]    = ostatok-today [1] .
     2847       ostatok-end  [2]    = ostatok-today [2] .
     2848       ostatok-start[1]    = ostatok-today [1]  - oborot1 .
     2849       ostatok-start[2]    = ostatok-today [2]  - oborot12 .
     2850       end.
     2851    if x-date-end   < today then do:
     2852      oborot2  = 0 .
     2853      oborot22 = 0 .
     2854       run ob-line2 in this-procedure ( input x-artic     ,
     2855                     input x-prod-code ,
     2856                     input x-prod-type ,
     2857                     input x-date-end + 1 ,
     2858                     input today   ,
     2859                     output oborot2 ,
     2860                     output oborot22
     2861                       ) .
     2862       ostatok-end  [1]    = ostatok-today [1] - oborot2 .
     2863       ostatok-end  [2]    = ostatok-today [2] - oborot22 .
     2864       ostatok-start[1]    = ostatok-today [1] - (oborot1 + oborot2)  .
     2865       ostatok-start[2]    = ostatok-today [2] - (oborot12 + oborot22)  .
     2866    end.
     2867     if xShowGoods Then DO :
     2868         run goods-way in this-procedure (
     2869           input x-artic     ,
     2870           input x-prod-code ,
     2871           input x-prod-type ,
     2872           input 1 ,
     2873           output ostatok-start  [7] ) .
     2874         run goods-way in this-procedure (
     2875           input x-artic     ,
     2876           input x-prod-code ,
     2877           input x-prod-type ,
     2878           input 2 ,
     2879           output ostatok-end  [7] ) .
     2880     end.
     2881    end.
     2882   end procedure.
     2883   PROCEDURE Calc-Sub-itog :
     2884   define input parameter tt as int no-undo.
     2885   define variable b as int no-undo.
     2886   repeat b = 1 to 3 :
     2887     Assign
     2888     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     2889     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     2890     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     2891     p-Prih[b + TT]     = p-Prih[b + TT]    +  Prih[b + TT]
     2892     o-Prih[b + TT]     = o-Prih[b + TT]    +  Prih[b + TT]
     2893     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     2894     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     2895     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     2896     p-RAsh[b + TT]    = p-RAsh[b + TT]    +  RAsh[b + TT]
     2897     o-RAsh[b + TT]    = o-RAsh[b + TT]    +  RAsh[b + TT]
     2898     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     2899     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     2900     Bi-kassa[b + TT]     = Bi-kassa[b + TT]     +  kassa[b + TT]
     2901     p-kassa[b + TT]      = p-kassa[b + TT]      +  kassa[b + TT]
     2902     o-kassa[b + TT]      = o-kassa[b + TT]      +  kassa[b + TT]
     2903     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     2904     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     2905     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     2906     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     2907     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     2908     B1-spis[b + TT]    = B1-spis[b + TT]    +  spis[b + TT]
     2909     B2-spis[b + TT]    = B2-spis[b + TT]    +  spis[b + TT]
     2910     Bi-spis[b + TT]    = Bi-spis[b + TT]    +  spis[b + TT]
     2911      p-spis[b + TT]    =  p-spis[b + TT]    +  spis[b + TT]
     2912      o-spis[b + TT]    =  o-spis[b + TT]    +  spis[b + TT]
     2913     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     2914     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     2915     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     2916     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     2917     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     2918     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     2919     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     2920     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     2921     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     2922     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     2923     B1-ostatok-start[b + TT]    = B1-ostatok-start[b + TT]    + ostatok-start[b + TT]
     2924     B2-ostatok-start[b + TT]    = B2-ostatok-start[b + TT]    + ostatok-start[b + TT]
     2925     Bi-ostatok-start[b + TT]    = Bi-ostatok-start[b + TT]    + ostatok-start[b + TT]
     2926     p-ostatok-start[b + TT]    = p-ostatok-start[b + TT]    + ostatok-start[b + TT]
     2927     o-ostatok-start[b + TT]    = o-ostatok-start[b + TT]    + ostatok-start[b + TT]
     2928     B1-ostatok-end[b + TT]    = B1-ostatok-end[b + TT]    + ostatok-end[b + TT]
     2929     B2-ostatok-end[b + TT]    = B2-ostatok-end[b + TT]    + ostatok-end[b + TT]
     2930     Bi-ostatok-end[b + TT]    = Bi-ostatok-end[b + TT]    + ostatok-end[b + TT]
     2931     p-ostatok-end[b + TT]    = p-ostatok-end[b + TT]    + ostatok-end[b + TT]
     2932     o-ostatok-end[b + TT]    = o-ostatok-end[b + TT]    + ostatok-end[b + TT]
     2933   .
     2934   End.
     2935   END PROCEDURE.
     2936   PROCEDURE U-LINE :
     2937   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     2938           gds-zap-b-code
     2939           gds-zap-artic
     2940           gds-zap-gds-name
     2941           gds-zap-unit-base
     2942           gds-type
     2943           F-ostatok-start
     2944           F-Prih
     2945           F-Rash
     2946           F-KAssa
     2947           F-Inv
     2948           F-spis
     2949           F-vzvr
     2950           F-vzvr-post
     2951           F-ostatok-end
     2952           with FRAME ZAPAS .
     2953           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2954           END PROCEDURE.
     2955   procedure display-part :
     2956    do
     2957    on error undo, return error return-value
     2958    :
     2959    define variable t-str as character no-undo .
     2960    define variable t-str-tp as character no-undo .
     2961    run get-name-from-ext-type in this-procedure  (
     2962         input  temp_oborot_parts.ext-doc-type ,
     2963         input  false                          ,
     2964         output t-str                          )
     2965         .
     2966    t-str-tp  = entry (lookup (string(temp_oborot_parts.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U) .
     2967      DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     2968       string(temp_oborot_parts.fact-date,"99/99/99")  @ gds-zap-b-code
     2969       string(temp_oborot_parts.in-code  + if temp_oborot_parts.part-code <> ""  then ( "/" + temp_oborot_parts.part-code) else " ")  @ gds-zap-artic
     2970       temp_oborot_parts.out-code + " " + t-str  @ gds-zap-gds-name
     2971       "---"      @ gds-zap-unit-base
     2972       t-str-tp   @ gds-type
     2973       string(temp_oborot_parts.fact-qnty,"->>>>>>>>9.99") @ F-ostatok-start
     2974       string(temp_oborot_parts.obj-code) +  " " + temp_oborot_parts.obj-type @ F-prih
     2975       with FRAME ZAPAS .
     2976       DOWN stream OutStream 1 with FRAME ZAPAS.
     2977     if Make-Excel then  put   stream ForExcel unformatted
     2978       "от " + string(temp_oborot_parts.fact-date,"99.99.99")  CHR(9)
     2979       string(temp_oborot_parts.in-code  + if temp_oborot_parts.part-code <> ""  then ( "/" + temp_oborot_parts.part-code) else " ")  CHR(9)
     2980       temp_oborot_parts.out-code + " " + t-str                                                                                       CHR(9)
     2981       t-str-tp   CHR(9)
     2982       string(temp_oborot_parts.fact-qnty,"->>>>>>>>9.99") CHR(9)
     2983       string(temp_oborot_parts.obj-code) +  " " + temp_oborot_parts.obj-type  CHR(9)
     2984      chr(10).
     2985    end.
     2986   end procedure.
     2987   procedure ob-line2 :
     2988    do
     2989    on error undo, return error return-value
     2990    :
     2991   define input parameter  x-artic     as character no-undo .
     2992   define input parameter  x-prod-code as integer no-undo .
     2993   define input parameter  x-prod-type as character no-undo .
     2994   define input parameter  p-date-1 as date no-undo .
     2995   define input parameter  p-date-2  as date no-undo .
     2996   define output parameter proc-oborot  as decimal no-undo .
     2997   define output parameter proc-oborot-2 as decimal no-undo .
     2998   proc-oborot   = 0 .
     2999   proc-oborot-2 = 0 .
     3000   define buffer buf-2_temp_oborot_parts for temp_oborot_parts-2.
     3001   define buffer buf_parts2 for parts.
     3002   for each buf-2_temp_oborot_parts : delete buf-2_temp_oborot_parts. end.
     3003     for each obj-list :
     3004       for each buf_parts2 no-lock where
     3005           buf_parts2.host-code = v-cntxt-host-code-obj        and
     3006           buf_parts2.obj-code  = obj-list.obj-code  and
     3007           buf_parts2.obj-type  = obj-list.obj-type  and
     3008           buf_parts2.supp-type = g#post-f.obj-type  and
     3009           buf_parts2.supp-code = g#post-f.obj-code  and
     3010           buf_parts2.status_   = true               and
     3011           buf_parts2.artic        = x-artic         and
     3012           buf_parts2.prod-code    = x-prod-code     and
     3013           buf_parts2.prod-type    = x-prod-type     and
     3014           buf_parts2.fact-date >= p-date-1          and
     3015           buf_parts2.fact-date <= p-date-2
     3016       :
     3017           find first trn-doc no-lock where trn-doc.doc-code     = buf_parts2.out-code   no-error .
     3018               if not available trn-doc then next.
     3019           create buf-2_temp_oborot_parts.
     3020           BUFFER-COPY buf_parts2  to buf-2_temp_oborot_parts
     3021               assign
     3022                 buf-2_temp_oborot_parts.ext-doc-type = trn-doc.ext-doc-type.
     3023        end.
     3024        end.
     3025        FOR each buf-2_temp_oborot_parts no-lock :
     3026           if type-stor <> 1 then do:
     3027              if buf-2_temp_oborot_parts.purch-code <>  type-stor - 1 then next.
     3028           end.
     3029           CASE buf-2_temp_oborot_parts.ext-doc-type:
     3030                WHEN        'iv':U      OR
     3031                WHEN        'rv':U  OR
     3032                WHEN        'im':U     THEN     DO:
     3033              ASSIGN proc-oborot   = proc-oborot  +  buf-2_temp_oborot_parts.fact-qnty
     3034                     proc-oborot-2   = proc-oborot-2  +  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base) .
     3035                    End.
     3036                WHEN        'vt':U       or
     3037                WHEN        'ie':U or
     3038                WHEN        'vp':U  THEN     DO:
     3039              ASSIGN proc-oborot   = proc-oborot   +  buf-2_temp_oborot_parts.fact-qnty
     3040                     proc-oborot-2   = proc-oborot-2  +  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base) .
     3041                    End.
     3042                WHEN        're':U  THEN DO:
     3043              ASSIGN proc-oborot   = proc-oborot  +  buf-2_temp_oborot_parts.fact-qnty
     3044                     proc-oborot-2   = proc-oborot-2  +  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base) .
     3045                    End.
     3046                WHEN       'ep':U  THEN DO:
     3047              ASSIGN proc-oborot   = proc-oborot  -  buf-2_temp_oborot_parts.fact-qnty
     3048                     proc-oborot-2   = proc-oborot-2  -  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base) .
     3049                    End.
     3050                WHEN       'ee':U          THEN  DO:
     3051                ASSIGN proc-oborot   = proc-oborot   -  buf-2_temp_oborot_parts.fact-qnty
     3052                     proc-oborot-2   = proc-oborot-2  -  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base)
     3053                       .
     3054                    End.
     3055                WHEN       'ev':U       OR
     3056                WHEN       'em':U        THEN  DO:
     3057              ASSIGN proc-oborot   = proc-oborot   -  buf-2_temp_oborot_parts.fact-qnty
     3058                     proc-oborot-2   = proc-oborot-2  -  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base)
     3059                     .
     3060                    End.
     3061                WHEN       'es':U  then
     3062                        ASSIGN proc-oborot   = proc-oborot   -  buf-2_temp_oborot_parts.fact-qnty
     3063                               proc-oborot-2   = proc-oborot-2  -  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base)
     3064                               .
     3065                WHEN       'rs':U THEN
     3066                         ASSIGN proc-oborot   = proc-oborot   +  buf-2_temp_oborot_parts.fact-qnty
     3067                                proc-oborot-2   = proc-oborot-2  +  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base)
     3068                                .
     3069                WHEN       'we':U       THEN  DO:
     3070              ASSIGN proc-oborot  = proc-oborot  -  buf-2_temp_oborot_parts.fact-qnty
     3071                     proc-oborot-2   = proc-oborot-2  -  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base)
     3072                     .
     3073                    End.
     3074                WHEN       'wm':U       THEN  DO:
     3075              ASSIGN proc-oborot   = proc-oborot   -  buf-2_temp_oborot_parts.fact-qnty
     3076                     proc-oborot-2   = proc-oborot-2  - buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base)
     3077                     .
     3078                    End.
     3079                WHEN       'pc':U       THEN  DO:
     3080                if type-stor <> 1 then do:
     3081                    ASSIGN proc-oborot  = proc-oborot  +  buf-2_temp_oborot_parts.fact-qnty
     3082                           proc-oborot-2   = proc-oborot-2  +  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base)
     3083                     .
     3084                    End.
     3085                 end.
     3086                WHEN       'ap':U       THEN  DO:
     3087                    ASSIGN
     3088                      proc-oborot-2   = proc-oborot-2  +  buf-2_temp_oborot_parts.fact-qnty  * (if tprintrubl  = true then buf-2_temp_oborot_parts.price-rubl else buf-2_temp_oborot_parts.price-base)
     3089                     .
     3090                 end.
     3091             End CASE.
     3092      End.
     3093    end.
     3094   end procedure.
     3095   procedure dobor :
     3096    do
     3097    on error undo, return error return-value
     3098    :
     3099    define buffer buf1_parts for parts.
     3100    for each obj-list :
     3101       for each buf1_parts no-lock where
     3102           buf1_parts.host-code = v-cntxt-host-code-obj         and
     3103           buf1_parts.supp-type = g#post-f.obj-type     and
     3104           buf1_parts.supp-code = g#post-f.obj-code     and
     3105           buf1_parts.status_   =  false              and
     3106           buf1_parts.obj-type  =  obj-list.obj-type  and
     3107           buf1_parts.obj-code  =  obj-list.obj-code  and
     3108           buf1_parts.in-code   <> buf1_parts.out-code and
     3109           buf1_parts.rsrv-free = true    :
     3110           if type-stor <> 1 then do:
     3111              if buf1_parts.purch-code <>  type-stor - 1 then next.
     3112           end.
     3113           if not can-find ( first temp-t-post-stk-line where
     3114                                     temp-t-post-stk-line.artic     = buf1_parts.artic     and
     3115                                     temp-t-post-stk-line.prod-type = buf1_parts.prod-type and
     3116                                     temp-t-post-stk-line.prod-code = buf1_parts.prod-code
     3117                                     ) and
     3118                not can-find ( first temp-null where
     3119                                     temp-null.artic     = buf1_parts.artic     and
     3120                                     temp-null.prod-type = buf1_parts.prod-type and
     3121                                     temp-null.prod-code = buf1_parts.prod-code
     3122                                     )
     3123                      then do:
     3124                         find first goods no-lock where goods.artic    = buf1_parts.artic     and
     3125                                                       goods.prod-type = buf1_parts.prod-type and
     3126                                                       goods.prod-code = buf1_parts.prod-code no-error .
     3127                         if not available goods then next.
     3128                         create temp-null.
     3129                         assign
     3130                           temp-null.artic     = buf1_parts.artic
     3131                           temp-null.prod-type = buf1_parts.prod-type
     3132                           temp-null.prod-code = buf1_parts.prod-code
     3133                           temp-null.gds-name  = goods.gds-name
     3134                           temp-null.unit-base = goods.unit-base
     3135                           temp-null.prt-root  = 0
     3136                           temp-null.Goods-grp-name   = goods.grp-name
     3137                           temp-null.gds-code         = goods.gds-code
     3138                           temp-null.gds-type         = goods.gds-type
     3139                           temp-null.Cli-type         = g#post-f.obj-type
     3140                           temp-null.Cli-code         = g#post-f.obj-code
     3141                           temp-null.Clients-grp-name = g#post-f.obj-name
     3142                         .
     3143                        end.
     3144       end.
     3145   end.
     3146   run super-dobor in this-procedure .
     3147   for each temp-null :
     3148      run clear-item in this-procedure .
     3149      run ost-line in this-procedure  (
     3150      temp-null.artic    ,
     3151      temp-null.prod-code,
     3152      temp-null.prod-type  )  .
     3153      run calc-sub-itog (0).
     3154      run calc-sub-itog (6).
     3155         if x-type-itog <> 1 then do:
     3156           gds-post-artic =  temp-null.artic .
     3157           if Show-Negativ = true then do:
     3158                 gds-post-artic = "".
     3159                 find first ub.ext-artic no-lock where
     3160                         ub.ext-artic.gds-code = temp-null.gds-code and
     3161                         ub.ext-artic.cli-type = temp-null.Cli-type and
     3162                         ub.ext-artic.cli-code = temp-null.Cli-code and
     3163                         ub.ext-artic.status_   =  'тек':U no-error .
     3164                 if available ub.ext-artic then do:
     3165                       assign
     3166                         gds-post-artic     = ub.ext-artic.ext-artic
     3167                       .
     3168           end.
     3169            run di-qnty ("кол-во", 1, temp-null.gds-code,gds-post-artic,temp-null.gds-name,temp-null.unit-base,"").
     3170            if show-cost then do : run di ( "учет." , 2, "","","","","" ).  end.
     3171            if xshowgoods then do : run di ( "в пути" , 7, "","","","","" ).  end.
     3172           end.
     3173         end.
     3174     run clear-item in this-procedure .
     3175   end.
     3176    end.
     3177   end procedure.
     3178   procedure goods-way :
     3179    do
     3180    on error undo, return error return-value
     3181    :
     3182   define input  parameter x-artic          like goods.artic        no-undo.
     3183   define input  parameter x-prod-code      like goods.prod-code    no-undo.
     3184   define input  parameter x-prod-type      like goods.prod-type    no-undo.
     3185   define input parameter x-date as integer no-undo .
     3186   define output parameter x-qnty as decimal no-undo .
     3187   define buffer way_parts for parts.
     3188   define buffer way_trn-doc for trn-doc.
     3189   define buffer way_doc-line for doc-line.
     3190   x-qnty = 0 .
     3191   if x-date = 1 then do:
     3192         for each obj-list :
     3193               for each way_doc-line no-lock where
     3194                         way_doc-line.obj-type   = obj-list.obj-type       and
     3195                         way_doc-line.obj-code   = obj-list.obj-code       and
     3196                         way_doc-line.prod-type  = x-prod-type             and
     3197                         way_doc-line.prod-code  = x-prod-code             and
     3198                         way_doc-line.artic       = x-artic                and
     3199                         way_doc-line.ext-doc-type  = 'iv':U   and
     3200                         way_doc-line.status_     = 'факт':U                and
     3201                         way_doc-line.fact-order  > fact-order-1
     3202                         :
     3203                         if can-find (first way_trn-doc no-lock  where
     3204                                 way_trn-doc.doc-code  = way_doc-line.doc-code and
     3205                                 way_trn-doc.fact-date > way_trn-doc.doc-date  and
     3206                                 way_trn-doc.doc-date  < x-date-start )
     3207                                 then do:
     3208                                   for each way_parts no-lock where
     3209                                         way_parts.out-code = way_doc-line.doc-code   and
     3210                                         way_parts.supp-type = g#post-f.obj-type   and
     3211                                         way_parts.supp-code = g#post-f.obj-code   and
     3212                                         way_parts.obj-type = way_doc-line.obj-type   and
     3213                                         way_parts.obj-code = way_doc-line.obj-code   and
     3214                                         way_parts.prod-type  = way_doc-line.prod-type   and
     3215                                         way_parts.prod-code  = way_doc-line.prod-code   and
     3216                                         way_parts.artic      = way_doc-line.artic     and
     3217                                         way_parts.status_    = true
     3218                                         :
     3219                                         x-qnty = x-qnty + way_parts.fact-qnty.
     3220                                   end.
     3221                         end.
     3222               end.
     3223               for each way_doc-line no-lock where
     3224                   way_doc-line.obj-type   = obj-list.obj-type                and
     3225                   way_doc-line.obj-code   = obj-list.obj-code                and
     3226                   way_doc-line.prod-type  = x-prod-type                      and
     3227                   way_doc-line.prod-code  = x-prod-code                      and
     3228                   way_doc-line.artic       = x-artic                         and
     3229                   way_doc-line.ext-doc-type  = 'rv':U        and
     3230                   way_doc-line.status_     = 'факт':U                         and
     3231                   way_doc-line.fact-order  > fact-order-1
     3232                   :
     3233                   if can-find (first way_trn-doc no-lock  where
     3234                         way_trn-doc.doc-code  = way_doc-line.doc-code and
     3235                         way_trn-doc.fact-date >= way_trn-doc.doc-date  and
     3236                         way_trn-doc.doc-date  < x-date-start
     3237                         ) then do:
     3238                             for each way_parts no-lock where
     3239                                 way_parts.out-code = way_doc-line.doc-code   and
     3240                                 way_parts.supp-type = g#post-f.obj-type   and
     3241                                 way_parts.supp-code = g#post-f.obj-code   and
     3242                                 way_parts.obj-type = way_doc-line.obj-type   and
     3243                                 way_parts.obj-code = way_doc-line.obj-code   and
     3244                                 way_parts.prod-type  = way_doc-line.prod-type   and
     3245                                 way_parts.prod-code  = way_doc-line.prod-code   and
     3246                                 way_parts.artic      = way_doc-line.artic     and
     3247                                 way_parts.status_    = true
     3248                                 :
     3249                                 x-qnty = x-qnty - way_parts.fact-qnty.
     3250                             end.
     3251                         end.
     3252               end.
     3253               for each way_trn-doc no-lock  where
     3254                       (way_trn-doc.host-code = v-cntxt-host-code-obj     and
     3255                       way_trn-doc.status_ = 'накл':U            and
     3256                       way_trn-doc.fact-order = 0               and
     3257                       way_trn-doc.internal = true              and
     3258                       way_trn-doc.doc-type = 'при':U         and
     3259                       way_trn-doc.doc-date  < x-date-start     and
     3260                       way_trn-doc.obj-type = obj-list.obj-type and
     3261                       way_trn-doc.obj-code = obj-list.obj-code and
     3262                       way_trn-doc.ext-doc-type  = 'iv':U)
     3263                         or
     3264                       (way_trn-doc.host-code = v-cntxt-host-code-obj      and
     3265                       way_trn-doc.status_ = 'накл':U            and
     3266                       way_trn-doc.fact-order = 0               and
     3267                       way_trn-doc.internal = true              and
     3268                       way_trn-doc.doc-type = 'возврат':U         and
     3269                       way_trn-doc.doc-date  < x-date-start     and
     3270                       way_trn-doc.obj-type = obj-list.obj-type and
     3271                       way_trn-doc.obj-code = obj-list.obj-code and
     3272                       way_trn-doc.ext-doc-type  = 'rv':U )
     3273                       :
     3274                         if can-find ( first  way_doc-line no-lock where
     3275                             way_doc-line.doc-code   = way_trn-doc.doc-code   and
     3276                             way_doc-line.prod-type  = x-prod-type            and
     3277                             way_doc-line.prod-code  = x-prod-code            and
     3278                             way_doc-line.artic       = x-artic ) then do:
     3279                               for each way_parts no-lock where
     3280                                         way_parts.out-code   = way_trn-doc.doc-code   and
     3281                                         way_parts.supp-type  = g#post-f.obj-type   and
     3282                                         way_parts.supp-code  = g#post-f.obj-code   and
     3283                                         way_parts.obj-type   = way_trn-doc.obj-type   and
     3284                                         way_parts.obj-code   = way_trn-doc.obj-code   and
     3285                                         way_parts.prod-type  = x-prod-type   and
     3286                                         way_parts.prod-code  = x-prod-code   and
     3287                                         way_parts.artic      = x-artic     and
     3288                                         way_parts.status_    = false
     3289                                         :
     3290                                         if way_trn-doc.ext-doc-type  = 'iv':U then
     3291                                             x-qnty = x-qnty + way_parts.fact-qnty.
     3292                                         else
     3293                                             x-qnty = x-qnty - way_parts.fact-qnty.
     3294                                         end.
     3295                               end.
     3296                         end.
     3297         end.
     3298   end.
     3299   else do:
     3300      if x-date-end < today then do:
     3301         for each obj-list :
     3302               for each way_trn-doc no-lock  where
     3303                       (way_trn-doc.host-code = v-cntxt-host-code-obj     and
     3304                       way_trn-doc.status_ = 'факт':U            and
     3305                       way_trn-doc.fact-order > fact-order-2    and
     3306                       way_trn-doc.internal = true              and
     3307                       way_trn-doc.doc-type = 'при':U         and
     3308                       way_trn-doc.doc-date  <= x-date-end      and
     3309                       way_trn-doc.fact-date  > x-date-end      and
     3310                       way_trn-doc.obj-type = obj-list.obj-type and
     3311                       way_trn-doc.obj-code = obj-list.obj-code and
     3312                       way_trn-doc.ext-doc-type  = 'iv':U)
     3313                         or
     3314                       (way_trn-doc.host-code = v-cntxt-host-code-obj      and
     3315                       way_trn-doc.status_ = 'факт':U            and
     3316                       way_trn-doc.fact-order > fact-order-2    and
     3317                       way_trn-doc.internal = true              and
     3318                       way_trn-doc.doc-type = 'возврат':U         and
     3319                       way_trn-doc.doc-date  <= x-date-end      and
     3320                       way_trn-doc.fact-date  > x-date-end      and
     3321                       way_trn-doc.obj-type = obj-list.obj-type and
     3322                       way_trn-doc.obj-code = obj-list.obj-code and
     3323                       way_trn-doc.ext-doc-type  = 'rv':U )
     3324                       :
     3325                       if can-find( first  way_doc-line no-lock where
     3326                           way_doc-line.doc-code   = way_trn-doc.doc-code   and
     3327                           way_doc-line.prod-type  = x-prod-type            and
     3328                           way_doc-line.prod-code  = x-prod-code            and
     3329                           way_doc-line.artic       = x-artic  )
     3330                           then do:
     3331                             for each way_parts no-lock where
     3332                                       way_parts.out-code   = way_trn-doc.doc-code   and
     3333                                       way_parts.supp-type  = g#post-f.obj-type   and
     3334                                       way_parts.supp-code  = g#post-f.obj-code   and
     3335                                       way_parts.obj-type   = obj-list.obj-type   and
     3336                                       way_parts.obj-code   = obj-list.obj-code   and
     3337                                       way_parts.prod-type  = x-prod-type   and
     3338                                       way_parts.prod-code  = x-prod-code   and
     3339                                       way_parts.artic      = x-artic     and
     3340                                       way_parts.status_    = true
     3341                                       :
     3342                                       if way_trn-doc.ext-doc-type  = 'iv':U then
     3343                                           x-qnty = x-qnty + way_parts.fact-qnty.
     3344                                       else
     3345                                           x-qnty = x-qnty - way_parts.fact-qnty.
     3346                                       end.
     3347                             end.
     3348                       end.
     3349         end.
     3350      end.
     3351      if x-date-end <= today then do:
     3352         for each obj-list :
     3353               for each way_trn-doc no-lock  where
     3354                         (way_trn-doc.host-code = v-cntxt-host-code-obj     and
     3355                         way_trn-doc.status_ = 'накл':U            and
     3356                         way_trn-doc.fact-order = 0               and
     3357                         way_trn-doc.internal = true              and
     3358                         way_trn-doc.doc-type = 'при':U         and
     3359                         way_trn-doc.doc-date  <= x-date-end       and
     3360                         way_trn-doc.obj-type = obj-list.obj-type and
     3361                         way_trn-doc.obj-code = obj-list.obj-code and
     3362                         way_trn-doc.ext-doc-type  = 'iv':U)
     3363                           or
     3364                         (way_trn-doc.host-code = v-cntxt-host-code-obj      and
     3365                         way_trn-doc.status_ = 'накл':U            and
     3366                         way_trn-doc.fact-order = 0               and
     3367                         way_trn-doc.internal = true              and
     3368                         way_trn-doc.doc-type = 'возврат':U         and
     3369                         way_trn-doc.doc-date  <= x-date-end       and
     3370                         way_trn-doc.obj-type = obj-list.obj-type and
     3371                         way_trn-doc.obj-code = obj-list.obj-code and
     3372                         way_trn-doc.ext-doc-type  = 'rv':U )
     3373                         :
     3374                           if can-find (first  way_doc-line no-lock where
     3375                               way_doc-line.doc-code   = way_trn-doc.doc-code   and
     3376                               way_doc-line.prod-type  = x-prod-type            and
     3377                               way_doc-line.prod-code  = x-prod-code            and
     3378                               way_doc-line.artic       = x-artic ) then do:
     3379                                 for each way_parts no-lock where
     3380                                           way_parts.out-code   = way_trn-doc.doc-code   and
     3381                                           way_parts.supp-type  = g#post-f.obj-type   and
     3382                                           way_parts.supp-code  = g#post-f.obj-code   and
     3383                                           way_parts.obj-type   = obj-list.obj-type   and
     3384                                           way_parts.obj-code   = obj-list.obj-code   and
     3385                                           way_parts.prod-type  = x-prod-type   and
     3386                                           way_parts.prod-code  = x-prod-code   and
     3387                                           way_parts.artic      = x-artic     and
     3388                                           way_parts.status_    = false
     3389                                           :
     3390                                           if way_trn-doc.ext-doc-type  = 'iv':U then
     3391                                               x-qnty = x-qnty + way_parts.fact-qnty.
     3392                                           else
     3393                                               x-qnty = x-qnty - way_parts.fact-qnty.
     3394                                           end.
     3395                                 end.
     3396                           end.
     3397         end.
     3398       end.
     3399   end.
     3400    end.
     3401   end procedure.
     3402   procedure clear-tt :
     3403    do
     3404    on error undo, return error return-value
     3405    :
     3406     for each temp-t-post-stk-line :
     3407         delete  temp-t-post-stk-line.
     3408     end.
     3409     for each temp_oborot_parts :
     3410         delete temp_oborot_parts.
     3411     end.
     3412     for each temp_oborot_parts-2 :
     3413         delete temp_oborot_parts-2.
     3414     end.
     3415     for each temp-null :
     3416         delete temp-null.
     3417     end.
     3418    end.
     3419   end procedure.
     3420   procedure first-line-p :
     3421    do
     3422    on error undo, return error return-value
     3423    :
     3424       if x-type-itog = 3  and p-first = true  then DO:
     3425         DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     3426           "Дата"          @ gds-zap-b-code
     3427           "Номер партии"  @ gds-zap-artic
     3428             "Документ"     @ gds-zap-gds-name
     3429             " "            @ gds-zap-unit-base
     3430           "Тип пр"        @ gds-type
     3431           "Кол-во партии" @ F-ostatok-start
     3432           "Объект"        @ F-prih
     3433           with FRAME ZAPAS .
     3434           DOWN stream OutStream 1 with FRAME ZAPAS.
     3435           run u-line in this-procedure .
     3436           p-first = false  .
     3437       end.
     3438    end.
     3439   end procedure.
     3440   procedure run1 :
     3441    do
     3442    on error undo, return error return-value
     3443    :
     3444     run clear-itemp-  in this-procedure .
     3445       if x-type-itog = 1 then do:
     3446         for each temp-t-post-stk-line :
     3447               run ob-line in this-procedure
     3448                     ( INPUT temp-t-post-stk-line.artic     ,
     3449                       INPUT temp-t-post-stk-line.prod-code ,
     3450                       INPUT temp-t-post-stk-line.prod-type  ) .
     3451               run ost-line in this-procedure
     3452                     ( INPUT temp-t-post-stk-line.artic     ,
     3453                       INPUT temp-t-post-stk-line.prod-code ,
     3454                       INPUT temp-t-post-stk-line.prod-type  ) .
     3455               run calc-sub-itog in this-procedure  (0).
     3456               run calc-sub-itog in this-procedure  (6).
     3457               run clear-item in this-procedure .
     3458         end.
     3459         run dobor in this-procedure .
     3460       end.
     3461     if x-type-itog <> 1 then DO:
     3462       if can-find ( first temp-t-post-stk-line ) then do:
     3463              run first-line-p in this-procedure .
     3464              run print-header in this-procedure ( 3 , g#post-f.obj-name) .
     3465        end.
     3466         for each temp-t-post-stk-line :
     3467             run display-line in this-procedure .
     3468                 if x-type-itog = 3 then do :
     3469                     for each temp_oborot_parts where
     3470                         temp_oborot_parts.artic     = temp-t-post-stk-line.artic      and
     3471                         temp_oborot_parts.prod-type = temp-t-post-stk-line.prod-type  and
     3472                         temp_oborot_parts.prod-code = temp-t-post-stk-line.prod-code
     3473                     :
     3474                         run display-part in this-procedure .
     3475                     end.
     3476                 end.
     3477         end.
     3478         run dobor in this-procedure .
     3479     end.
     3480     run print-footer in this-procedure ( 3 , g#post-f.obj-name ).
     3481     run clear-tt in this-procedure .
     3482    end.
     3483   end procedure.
     3484   procedure run2 :
     3485    do
     3486    on error undo, return error return-value
     3487    :
     3488   define variable ng as character no-undo .
     3489   define variable v-new as character no-undo .
     3490   define variable v-old as character no-undo .
     3491   define variable ff as logical   no-undo .
     3492   v-old = "" .
     3493   ff = true .
     3494     if  xLavel > 0 then  do:
     3495         for each g#post-f
     3496                  break by g#post-f.grp-name
     3497                  :
     3498           ng = n-lavel (g#post-f.grp-name ,  xLavel )  .
     3499           v-new = n-lavel (g#post-f.grp-name ,  xLavel )  .
     3500           if v-new <> v-old and ff = true   then do:
     3501             run print-header ( 1 , ng ).
     3502             ff = false .
     3503           end.
     3504           run one-post in this-procedure .
     3505           run run1 in this-procedure .
     3506           if v-new <> v-old and ff = false then do:
     3507               run print-footer in this-procedure ( 1 , ng ).
     3508               run clear-itemb1-  in this-procedure .
     3509               ff = true .
     3510           end.
     3511           v-old = n-lavel (g#post-f.grp-name,xLavel ).
     3512         end.
     3513     end.
     3514     else do:
     3515         for each g#post-f break by g#post-f.grp-name :
     3516           if first-of(g#post-f.grp-name) then do:
     3517              run print-header in this-procedure ( 1 , g#post-f.grp-name ).
     3518           end.
     3519           run one-post in this-procedure .
     3520           run run1 in this-procedure .
     3521           if last-of(g#post-f.grp-name) then do:
     3522              run print-footer in this-procedure ( 1 , g#post-f.grp-name ).
     3523              run clear-itemb1-  in this-procedure .
     3524           end.
     3525         end.
     3526     end.
     3527    end.
     3528   end procedure.
     3529   procedure run3 :
     3530   do
     3531   on error undo, return error return-value
     3532   :
     3533   define variable ng as character no-undo .
     3534   define variable v-new as character no-undo .
     3535   define variable v-old as character no-undo .
     3536   define variable ff as logical   no-undo .
     3537   v-old = "" .
     3538   ff = true .
     3539     if  xLavel > 0 then  do:
     3540         for each g#post-f break by g#post-f.grp-name  :
     3541           v-new = n-lavel (g#post-f.grp-name ,  xLavel )  .
     3542           ng = n-lavel (g#post-f.grp-name ,  xLavel )  .
     3543           if v-new <> v-old and ff = true then do:
     3544              run Print-Header  in this-procedure ( 1 , ng ).
     3545              ff = false .
     3546           end.
     3547           run one-post in this-procedure .
     3548           run run1 in this-procedure .
     3549           if v-new <> v-old and ff = false  then do:
     3550               run print-footer in this-procedure ( 1 , ng ).
     3551               run clear-itemb1- in this-procedure .
     3552               ff = true .
     3553           end.
     3554           v-old = n-lavel (g#post-f.grp-name ,  xLavel )  .
     3555         end.
     3556     end.
     3557     else do:
     3558         for each g#post-f break by g#post-f.grp-name :
     3559           if first-of(g#post-f.grp-name) then do:
     3560              run print-header in this-procedure  ( 1 , g#post-f.grp-name ).
     3561           end.
     3562           run one-post in this-procedure .
     3563           run run1 in this-procedure .
     3564           if last-of(g#post-f.grp-name) then do:
     3565              run print-footer in this-procedure ( 1 , g#post-f.grp-name ).
     3566              run clear-itemb1-  in this-procedure .
     3567           end.
     3568         end.
     3569     end.
     3570    end.
     3571   end procedure.
     3572   procedure run1-grp :
     3573    do
     3574    on error undo, return error return-value
     3575    :
     3576     run Clear-itemp-  in this-procedure .
     3577       if x-type-itog = 1 then do:
     3578         for each temp-t-post-stk-line :
     3579               run ob-line in this-procedure
     3580                     ( INPUT temp-t-post-stk-line.artic     ,
     3581                       INPUT temp-t-post-stk-line.prod-code ,
     3582                       INPUT temp-t-post-stk-line.prod-type  ) .
     3583               run ost-line in this-procedure
     3584                     ( INPUT temp-t-post-stk-line.artic     ,
     3585                       INPUT temp-t-post-stk-line.prod-code ,
     3586                       INPUT temp-t-post-stk-line.prod-type  ) .
     3587               run Calc-Sub-itog  in this-procedure (0).
     3588               run Calc-Sub-itog  in this-procedure (6).
     3589               run Clear-item in this-procedure .
     3590         end.
     3591         run dobor in this-procedure .
     3592       end.
     3593     if x-type-itog <> 1 then DO:
     3594       if can-find ( first temp-t-post-stk-line ) then do:
     3595              run first-line-p in this-procedure .
     3596              Run Print-Header in this-procedure ( 3 , g#post-f.obj-name) .
     3597        end.
     3598         for each temp-t-post-stk-line :
     3599             run display-line in this-procedure .
     3600                 if x-type-itog = 3 then do :
     3601                     for each temp_oborot_parts where
     3602                         temp_oborot_parts.artic     = temp-t-post-stk-line.artic      and
     3603                         temp_oborot_parts.prod-type = temp-t-post-stk-line.prod-type  and
     3604                         temp_oborot_parts.prod-code = temp-t-post-stk-line.prod-code
     3605                     :
     3606                         run display-part in this-procedure .
     3607                     end.
     3608                 end.
     3609         end.
     3610         run dobor in this-procedure .
     3611     end.
     3612     run print-footer in this-procedure ( 3 , g#post-f.obj-name ).
     3613     run clear-tt in this-procedure .
     3614    end.
     3615   end procedure.
     3616   procedure super-dobor :
     3617    do
     3618    on error undo, return error return-value
     3619    :
     3620    define buffer buf1_parts for parts.
     3621    if x-date-end >= today then return.
     3622     for each obj-list :
     3623       for each buf1_parts no-lock where
     3624           buf1_parts.host-code = v-cntxt-host-code-obj         and
     3625           buf1_parts.supp-type = g#post-f.obj-type   and
     3626           buf1_parts.supp-code = g#post-f.obj-code   and
     3627           buf1_parts.status_   =  true               and
     3628           buf1_parts.obj-type  =  obj-list.obj-type  and
     3629           buf1_parts.obj-code  =  obj-list.obj-code  and
     3630           buf1_parts.fact-date >= x-date-start      :
     3631           if type-stor <> 1 then do:
     3632              if buf1_parts.purch-code <>  type-stor - 1 then next.
     3633           end.
     3634           if not can-find ( first temp-t-post-stk-line where
     3635                                     temp-t-post-stk-line.artic     = buf1_parts.artic     and
     3636                                     temp-t-post-stk-line.prod-type = buf1_parts.prod-type and
     3637                                     temp-t-post-stk-line.prod-code = buf1_parts.prod-code
     3638                                     ) and
     3639                not can-find ( first temp-null where
     3640                                     temp-null.artic     = buf1_parts.artic     and
     3641                                     temp-null.prod-type = buf1_parts.prod-type and
     3642                                     temp-null.prod-code = buf1_parts.prod-code
     3643                                     )
     3644                      then do:
     3645                         find first goods no-lock where goods.artic    = buf1_parts.artic     and
     3646                                                       goods.prod-type = buf1_parts.prod-type and
     3647                                                       goods.prod-code = buf1_parts.prod-code no-error .
     3648                         if not available goods then next.
     3649                         create temp-null.
     3650                         assign
     3651                           temp-null.artic     = buf1_parts.artic
     3652                           temp-null.prod-type = buf1_parts.prod-type
     3653                           temp-null.prod-code = buf1_parts.prod-code
     3654                           temp-null.gds-name  = goods.gds-name
     3655                           temp-null.unit-base = goods.unit-base
     3656                           temp-null.prt-root  = 0
     3657                           temp-null.Goods-grp-name   = goods.grp-name
     3658                           temp-null.gds-code         = goods.gds-code
     3659                           temp-null.gds-type         = goods.gds-type
     3660                           temp-null.Cli-type         = g#post-f.obj-type
     3661                           temp-null.Cli-code         = g#post-f.obj-code
     3662                           temp-null.Clients-grp-name = g#post-f.obj-name
     3663                         .
     3664                        end.
     3665       end.
     3666     end.
     3667    end.
     3668   end procedure.
