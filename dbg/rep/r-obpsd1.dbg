     2039                   vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     2040                   Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     2041                  with FRAME ZAPAS .
     2042                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2043   end.
     2044        End.
     2045      End case.
     2046    END PROCEDURE.
     2047   PROCEDURE Di-qnty :
     2048   define input parameter p1 as char no-undo.
     2049   define input parameter p2 as int no-undo.
     2050   define input parameter p3 as char no-undo.
     2051   define input parameter p4 as char no-undo.
     2052   define input parameter p5 as char no-undo.
     2053   define input parameter p6 as char no-undo.
     2054   define input parameter p7 as char no-undo.
     2055    CASE CAPS(p7) :
     2056      WHEN "B1":U  Then DO :
     2057   if  not (
     2058      (b1-ostatok-start[1] = 0  and
     2059       b1-Prih         [1] = 0  AND
     2060       b1-RAsh         [1] = 0  AND
     2061       b1-KAssa        [1] = 0  AND
     2062       b1-Inv          [1] = 0  AND
     2063       b1-vzvr         [1] = 0  AND
     2064       b1-spis         [1] = 0  AND
     2065       b1-vzvr-post    [1] = 0  AND
     2066       b1-Ostatok-end  [1] = 0)) then DO:
     2067                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     2068                   p3 @ gds-zap-b-code
     2069                   p4 @ gds-zap-artic
     2070                   p5 @ gds-zap-gds-name
     2071                   p6 @ gds-zap-unit-base
     2072                   p1 @ gds-type
     2073                   b1-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     2074                   b1-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     2075                   b1-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     2076                   b1-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     2077                   b1-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     2078                   b1-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     2079                   b1-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     2080                   b1-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     2081                   b1-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     2082                  with FRAME ZAPAS .
     2083                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2084   end.
     2085   if  not (
     2086      (b1-ostatok-start[1] = 0  and
     2087       b1-Prih         [1] = 0  AND
     2088       b1-RAsh         [1] = 0  AND
     2089       b1-KAssa        [1] = 0  AND
     2090       b1-Inv          [1] = 0  AND
     2091       b1-vzvr         [1] = 0  AND
     2092       b1-spis         [1] = 0  AND
     2093       b1-vzvr-post    [1] = 0  AND
     2094       b1-Ostatok-end  [1] = 0)) then DO:
     2095       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     2096                   p4 CHR(9)
     2097                   p5 CHR(9)
     2098                   p6 CHR(9)
     2099                      ( excel-qnty(b1-ostatok-start[1]) +  CHR(9))
     2100   if Show-cost  then  ( excel-sum(b1-ostatok-start[2]) +  CHR(9))   else ("")
     2101   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     2102   if xShowgoods then  ( excel-qnty(b1-ostatok-start[7]) +  CHR(9))   else ("")
     2103                      ( excel-qnty(b1-Prih         [1]) +  CHR(9))
     2104   if Show-cost  then  ( excel-sum(b1-Prih         [2]) +  CHR(9))   else ("")
     2105   if Show-sale  then  ( excel-sum(b1-Prih         [8]) +  CHR(9))   else ("")
     2106                      ( excel-qnty(b1-RAsh         [1]) +  CHR(9))
     2107   if Show-cost  then  ( excel-sum(b1-RAsh         [2]) +  CHR(9))   else ("")
     2108   if Show-sale  then  ( excel-sum(b1-RAsh         [8]) +  CHR(9))   else ("")
     2109                      ( excel-qnty(b1-KAssa        [1]) +  CHR(9))
     2110   if Show-cost  then  ( excel-sum(b1-KAssa        [2]) +  CHR(9))   else ("")
     2111   if Show-sale  then  ( excel-sum(b1-KAssa        [8]) +  CHR(9))   else ("")
     2112                      ( excel-qnty(b1-Inv          [1]) +  CHR(9))
     2113   if Show-cost  then  ( excel-sum(b1-Inv          [2]) +  CHR(9))   else ("")
     2114   if Show-sale  then  ( excel-sum(b1-Inv          [8]) +  CHR(9))   else ("")
     2115                      ( excel-qnty(b1-spis         [1]) +  CHR(9))
     2116   if Show-cost  then  ( excel-sum(b1-spis         [2]) +  CHR(9))   else ("")
     2117   if Show-sale  then  ( excel-sum(b1-spis         [8]) +  CHR(9))   else ("")
     2118                      ( excel-qnty(b1-vzvr         [1]) +  CHR(9))
     2119   if Show-cost  then  ( excel-sum(b1-vzvr         [2]) +  CHR(9))   else ("")
     2120   if Show-sale  then  ( excel-sum(b1-vzvr         [8]) +  CHR(9))   else ("")
     2121                      ( excel-qnty(b1-vzvr-post    [1]) +  CHR(9))
     2122   if Show-cost  then  ( excel-sum(b1-vzvr-post    [2]) +  CHR(9))   else ("")
     2123   if Show-sale  then  ( excel-sum(b1-vzvr-post    [8]) +  CHR(9))   else ("")
     2124                      ( excel-qnty(b1-Ostatok-end  [1]) +  CHR(9))
     2125   if Show-cost  then  ( excel-sum(b1-Ostatok-end  [2]) +  CHR(9))   else ("")
     2126   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     2127   if xShowgoods then  ( excel-qnty(b1-ostatok-end[7]) +  CHR(9))   else ("")
     2128      chr(10).
     2129   end.
     2130                   End.
     2131      WHEN "B2":U  Then DO :
     2132   if  not (
