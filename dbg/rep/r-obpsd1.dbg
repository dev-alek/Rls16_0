      887       ( input this-procedure
      888       ) .
      889   end.
      890   define variable v-inform-launched as logical no-undo initial false .
      891   procedure proc-alt-shift-f4:
      892     define variable v-action as character no-undo .
      893     if v-inform-launched = false then do:
      894       assign
      895         v-inform-launched = true
      896       .
      897       run gbl/d-inform.w
      898         (  input self
      899         ,  input this-procedure
      900         , output v-action
      901         ) no-error .
      902       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      903       assign
      904         v-inform-launched = false
      905       .
      906     end.
      907   end.
      908   procedure proc-alt-f1:
      909     run gbl/corrhelp.p
      910       (input this-procedure
      911       ) .
      912   end .
