     1473   assign
     1474   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1475   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1476               ASSIGN
     1477                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1478                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1479                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1480                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1481                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1482                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1483                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1484                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1485                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1486                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1487                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1488                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1489                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1490               .
     1491           end.
     1492       end.
     1493       assign
     1494           p-transport-base      = 0
     1495           p-transport-rubl      = 0
     1496           p-vat-pc              = buf_doc-line.vat-pc
     1497           p-slt-pc              = buf_doc-line.slt-pc
     1498       .
     1499     end.
     1500     if p-fact-qnty      = ?
     1501     or p-vat-pc         = ?
     1502     or p-slt-pc         = ?
     1503     or p-sum-base       = ?
     1504     or p-sum-rubl       = ?
     1505     or p-vat-base       = ?
     1506     or p-vat-rubl       = ?
     1507     or p-slt-base       = ?
     1508     or p-slt-rubl       = ?
     1509     or p-road-tax-base  = ?
     1510     or p-road-tax-rubl  = ?
     1511     or p-transport-base = ?
     1512     or p-transport-rubl = ?
     1513     or p-other-base     = ?
     1514     or p-other-rubl     = ?
     1515     or p-excise-base    = ?
     1516     or p-excise-rubl    = ?
     1517     then do:
     1518       message
     1519         vss-workfile vss-revision vss-description skip
     1520         vss-include-info14 skip
     1521         "Получены неопределенные значения" skip
