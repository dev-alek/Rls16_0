     3894               temp-goods.p-prod-sum = temp-goods.p-prod-sum + (if var-report-r-b = "rubl" then buf_parts.price-rubl else buf_parts.price-base) * buf_parts.fact-qnty
     3895             .
     3896           when 'rs':U or
