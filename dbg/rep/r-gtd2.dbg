     3924     assign
     3925       new-grp = no
     3926       make-excel = yes
     3927     .
     3928     run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     3929     output stream macr_excel to value(v-file-name) .
     3930     assign v-ind = v-ind + 1 .
     3931   if session :set-wait-state( "compiler" ) then.
     3932     run PutColumnTitulExcel in this-procedure .
     3933     assign ii = 1 .
     3934     for each temp-goods break by temp-goods.grp-name by temp-goods.artic  by temp-goods.gtd-code by temp-goods.prod-type by temp-goods.prod-code :
     3935       run end-page in this-procedure .
     3936       if first-of(temp-goods.grp-name ) then  assign new-grp = yes .
     3937       run  PrintString in this-procedure .
     3938     end.
     3939     output stream macr_excel close .
     3940     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     3941     run end-proc .
     3942   if mFrameView
     3943   then do:
     3944      HIDE FRAME InfoFrame.
     3945   end.
     3946   if session :set-wait-state( "" ) then.
     3947     run rep/runexcel.p (v-file-name ).
     3948   end.
     3949   procedure PrintString :
     3950     do
     3951     on error undo, return error return-value
     3952     :
     3953       define variable ost-end     as decimal initial 0  no-undo .
     3954       define variable ost-end-sum as decimal initial 0  no-undo .
     3955       define variable zena        as decimal initial 0  no-undo .
     3956       if    temp-goods.p-prih = 0 and temp-goods.p-sum1 = 0 and temp-goods.p-sum2 = 0
     3957         and temp-goods.p-vozv = 0 and temp-goods.p-prod = 0 then do:
     3958          if null-oborot = no then next .
     3959          else if temp-goods.p-ost = 0 then next .
     3960       end.
     3961       if new-grp = yes then do:
     3962         run macr_excel_char( temp-goods.grp-name,  v-row, 6) .
     3963         run macr_cell_format ( 10, yes, no, ?, v-row , 6, v-row, 6) .
     3964         assign
     3965           v-row = v-row + 1
     3966           new-grp = no
     3967         .
     3968       end.
     3969       assign
     3970         temp-goods.p-sum2 = temp-goods.p-sum2     + temp-goods.p-ost      + temp-goods.p-prih - temp-goods.p-sum1
     3971         temp-goods.p-sum2-sum = temp-goods.p-sum2-sum + temp-goods.p-ost-sum + temp-goods.p-prih-sum - temp-goods.p-sum1-sum
     3972         ost-end           = temp-goods.p-sum2     + temp-goods.p-vozv     - temp-goods.p-prod
     3973         ost-end-sum       = temp-goods.p-sum2-sum + temp-goods.p-vozv-sum - temp-goods.p-prod-sum
     3974       .
     3975       run macr_excel_char(String(ii), v-row, 1) .
     3976       run macr_excel_char(temp-goods.gtd-code, v-row, 2) .
     3977       find first buf_trn-doc where buf_trn-doc.doc-code = temp-goods.in-code no-error .
     3978       if available buf_trn-doc then do:
     3979         run macr_excel_char(buf_trn-doc.cli-type,    v-row, 3) .
     3980         run macr_excel_char(buf_trn-doc.cli-code,    v-row, 4) .
     3981         run macr_excel_char(buf_trn-doc.cli-name,    v-row, 5) .
     3982       end.
     3983       run macr_excel_char(temp-goods.artic,      v-row, 6) .
     3984       run macr_excel_char(temp-goods.prod-type,  v-row, 7) .
     3985       run macr_excel_char(temp-goods.prod-code,  v-row, 8) .
     3986       run macr_excel_char(temp-goods.gds-name,   v-row, 9) .
     3987       run macr_excel_sum (temp-goods.p-ost,      v-row, 10, 3) .
     3988       if temp-goods.p-ost = 0 then assign zena =  0 .
     3989       else                         assign zena =  temp-goods.p-ost-sum / temp-goods.p-ost .
     3990       run macr_excel_sum (zena,   v-row, 11, 2) .
     3991       run macr_excel_sum (temp-goods.p-ost-sum,  v-row, 12, 2) .
     3992       run macr_excel_sum (temp-goods.p-prih,      v-row, 13, 3) .
     3993       if temp-goods.p-prih = 0 then assign zena =  0 .
     3994       else                          assign zena =  temp-goods.p-prih-sum / temp-goods.p-prih .
     3995       run macr_excel_sum (zena,   v-row, 14, 2) .
     3996       run macr_excel_sum (temp-goods.p-prih-sum,  v-row, 15, 2) .
     3997       run macr_excel_sum (temp-goods.p-sum1,      v-row, 16, 3) .
     3998       if temp-goods.p-sum1 = 0 then assign zena =  0 .
     3999       else                          assign zena =  temp-goods.p-sum1-sum / temp-goods.p-sum1 .
     4000       run macr_excel_sum (zena,   v-row, 17, 2) .
     4001       run macr_excel_sum (temp-goods.p-sum1-sum,  v-row, 18, 2) .
     4002       run macr_excel_sum (temp-goods.p-sum2,      v-row, 19, 3) .
     4003       if temp-goods.p-sum2 = 0 then assign zena =  0 .
     4004       else                          assign zena =  temp-goods.p-sum2-sum / temp-goods.p-sum2 .
     4005       run macr_excel_sum (zena,   v-row, 20, 2) .
     4006       run macr_excel_sum (temp-goods.p-sum2-sum,  v-row, 21, 2) .
     4007       run macr_excel_sum (temp-goods.p-vozv,      v-row, 22, 3) .
     4008       if temp-goods.p-vozv = 0 then assign zena =  0 .
     4009       else                         assign zena =  temp-goods.p-vozv-sum / temp-goods.p-vozv .
     4010       run macr_excel_sum (zena,   v-row, 23, 2) .
     4011       run macr_excel_sum (temp-goods.p-vozv-sum,  v-row, 24, 2) .
     4012       run macr_excel_sum (temp-goods.p-prod,      v-row, 25, 3) .
     4013       if temp-goods.p-prod = 0 then assign zena =  0 .
     4014       else                         assign zena =  temp-goods.p-prod-sum / temp-goods.p-prod .
     4015       run macr_excel_sum (zena,   v-row, 26, 2) .
     4016       run macr_excel_sum (temp-goods.p-prod-sum,  v-row, 27, 2) .
     4017       run macr_excel_sum (ost-end,      v-row, 28, 3) .
     4018       if ost-end = 0 then assign zena =  0 .
     4019       else                assign zena =  ost-end-sum / ost-end .
     4020       run macr_excel_sum (zena,   v-row, 29, 2) .
     4021       run macr_excel_sum (ost-end-sum,  v-row, 30, 2) .
     4022       assign
     4023         v-row = v-row + 1
     4024         ii = ii + 1
     4025       .
     4026     end.
     4027   end procedure.
     4028   procedure PutColumnTitulExcel :
     4029     do
     4030     on error undo, return error return-value
     4031     :
     4032     assign
     4033       v-row = 2
     4034       v-col = 1
     4035     .
     4036     run macr_excel_char ("Отчет по товарам, принятым на реализацию и реализованных за период с " + String(x-Date-Start,"99.99.9999") + " по " + String(x-Date-End,"99.99.9999") , 1, 3) .
     4037     run macr_cell_format( 11, yes, no, ?, 1, 3, 1, 3) .
     4038     run macr_excel_char("№ п/п", v-row, v-col) .         assign v-col = v-col + 1 .
     4039     run macr_excel_char("№ ГТД", v-row, v-col) .         run macr_cell_size (20,?, v-row, v-col,?,?).   assign v-col = v-col + 1 .
     4040     run macr_excel_char("тип", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4041     run macr_excel_char("Поставщик", v-row, v-col) .
     4042     run macr_excel_char("код", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4043     run macr_excel_char("наименование", v-row + 1, v-col) .    assign v-col = v-col + 1 .
     4044     run macr_excel_char("Артикул", v-row, v-col) .       run macr_cell_size (20,?, v-row, v-col,?,?).   assign v-col = v-col + 1 .
     4045     run macr_excel_char("Производитель", v-row, v-col) .
     4046     run macr_excel_char("тип", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4047     run macr_excel_char("код", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4048     run macr_excel_char("Наименование товара", v-row, v-col) .
     4049     run macr_cell_size (40,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     4050     run macr_excel_char("кол-во", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4051     run macr_excel_char("Начальный остаток", v-row, v-col) .
     4052     run macr_excel_char("цена",   v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4053     run macr_excel_char("сумма",  v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4054     run macr_excel_char("кол-во", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4055     run macr_excel_char("Приход", v-row, v-col) .
     4056     run macr_excel_char("цена",   v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4057     run macr_excel_char("сумма",  v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4058     run macr_excel_char("кол-во", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4059     run macr_excel_char("Снято с учета", v-row, v-col) .
     4060     run macr_excel_char("цена",   v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4061     run macr_excel_char("сумма",  v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4062     run macr_excel_char("кол-во", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4063     run macr_excel_char("Принято на учет", v-row, v-col) .
     4064     run macr_excel_char("цена",   v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4065     run macr_excel_char("сумма",  v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4066     run macr_excel_char("кол-во", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4067     run macr_excel_char("Возврат", v-row, v-col) .
     4068     run macr_excel_char("цена",   v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4069     run macr_excel_char("сумма",  v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4070     run macr_excel_char("кол-во", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4071     run macr_excel_char("Реализовано", v-row, v-col) .
     4072     run macr_excel_char("цена",   v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4073     run macr_excel_char("сумма",  v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4074     run macr_excel_char("кол-во", v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4075     run macr_excel_char("Остаток на конец периода", v-row, v-col) .
     4076     run macr_excel_char("цена",   v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4077     run macr_excel_char("сумма",  v-row + 1, v-col) .       assign v-col = v-col + 1 .
     4078     run macr_cell_bordur ( v-row , 1, v-row + 1, 30) .
     4079     run macr_cell_format ( 10, yes, no, 35, v-row , 1, v-row + 1, 30) .
     4080     assign
     4081       v-row = v-row + 2
     4082       v-col = 1
     4083     .
     4084     end.
     4085   end procedure.
     4086   procedure end-page :
     4087     do
     4088     on error undo, return error return-value
     4089     :
     4090       if  ( v-row ) >= 63000 then do:
     4091         Output stream Macr_Excel  close .
     4092         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     4093         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     4094         output stream  Macr_Excel to value(v-file-name) .
     4095         assign  v-ind = v-ind + 1   .
     4096         run PutColumnTitulExcel in this-procedure .
     4097       end.
     4098     end.
     4099   end procedure.
     4100   procedure macr_excel_char :
     4101    do
     4102    on error undo, return error return-value
     4103    :
     4104    define input parameter  p-val as character no-undo .
     4105    define input parameter  p-row as integer no-undo .
     4106    define input parameter  p-col as integer no-undo .
     4107         put  stream macr_excel unformatted
     4108           substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) skip  .
     4109    end.
     4110   end procedure.
     4111   procedure macr_excel_sum :
     4112    do
     4113    on error undo, return error return-value
     4114    :
     4115    define input parameter  p-val as decimal   no-undo .
     4116    define input parameter  p-row as integer   no-undo .
     4117    define input parameter  p-col as integer   no-undo .
     4118    define input parameter  p-typ as integer   no-undo .
     4119    if p-val = ? then assign p-val = 0 .
     4120    define variable ss as character no-undo .
     4121    assign ss = string( Round( p-val, p-typ) ) .
     4122    put  stream macr_excel unformatted   substitute('formula(&3,"r&1c&2")', p-row , p-col , ss ) skip  .
     4123    end.
     4124   END procedure.
     4125   procedure macr_cell_format :
     4126    do
     4127    on error undo, return error return-value
     4128    :
     4129    define input parameter  p-size   as integer   no-undo .
     4130    define input parameter  p-bold   as logical   no-undo .
     4131    define input parameter  p-italic as logical   no-undo .
     4132    define input parameter  p-color  as integer   no-undo .
     4133    define input parameter  p-row    as integer   no-undo .
     4134    define input parameter  p-col    as integer   no-undo .
     4135    define input parameter  p-row-2  as integer   no-undo .
     4136    define input parameter  p-col-2  as integer   no-undo .
     4137     if p-size = ? then p-size = 10 .
     4138     if p-bold = ? then p-bold = false .
     4139     if p-italic = ? then p-italic = false .
     4140     if p-row-2 = ? then p-row-2 = p-row .
     4141     if p-col-2 = ? then p-col-2 = p-col .
     4142     put  stream macr_excel unformatted
     4143      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     4144     if p-color <> ? then do:
     4145       put  stream macr_excel unformatted  substitute('patterns(1,,&1,true)', p-color )  skip  .
     4146     end.
     4147     put  stream macr_excel unformatted
     4148          substitute('format.font(,&1,&2,&3)' , p-size, string ( p-bold  , "true/false" ) ,  string ( p-italic , "true/false" ) ) skip .
     4149    end.
     4150   end procedure.
     4151   procedure macr_cell_bordur :
     4152    do
     4153    on error undo, return error return-value
     4154    :
     4155    define input parameter  p-row    as integer   no-undo .
     4156    define input parameter  p-col    as integer   no-undo .
     4157    define input parameter  p-row-2  as integer   no-undo .
     4158    define input parameter  p-col-2  as integer   no-undo .
     4159     if p-row-2 = ? then p-row-2 = p-row .
     4160     if p-col-2 = ? then p-col-2 = p-col .
     4161     put  stream macr_excel unformatted substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     4162     put  stream macr_excel unformatted 'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  skip 'ALIGNMENT(3 , , 4 , 4 ,)'   skip
     4163          .
     4164    end.
     4165   end procedure.
     4166   procedure macr_cell_size :
     4167    do
     4168    on error undo, return error return-value
     4169    :
     4170    define input parameter  p-w   as integer   no-undo .
     4171    define input parameter  p-l   as integer   no-undo .
     4172    define input parameter  p-row    as integer   no-undo .
     4173    define input parameter  p-col    as integer   no-undo .
     4174    define input parameter  p-row-2  as integer   no-undo .
     4175    define input parameter  p-col-2  as integer   no-undo .
     4176     if p-row-2 = ? then p-row-2 = p-row .
     4177     if p-col-2 = ? then p-col-2 = p-col .
     4178     if p-w = ? then    p-w = 0 .
     4179     if p-l = ? then    p-l = 0 .
     4180    define variable s-w as character no-undo .
     4181    define variable s-l as character no-undo .
     4182    if p-w = 0 then s-w = "" .
     4183               else s-w = string(p-w)  .
     4184    if p-l = 0 then s-l = "" .
     4185               else s-l = string(p-l)  .
     4186   put  stream macr_excel unformatted  substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     4187   put  stream macr_excel unformatted  substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     4188   put  stream macr_excel unformatted  'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     4189    end.
     4190   end procedure.
     4191   procedure end-proc :
     4192    do
     4193    on error undo, return error return-value
     4194    :
     4195     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     4196     OUTPUT to VALUE (v-file-name) .
     4197     for each temp-param :  export  temp-param  .  end.
     4198    end.
     4199   end procedure.
