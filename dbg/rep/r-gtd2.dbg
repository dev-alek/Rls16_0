     3616         and buf_doc-line.obj-code  = buf_gds-obj.obj-code
     3617         and buf_doc-line.artic     = buf_gds-obj.artic
     3618         and buf_doc-line.prod-type = buf_gds-obj.prod-type
     3619         and buf_doc-line.prod-code = buf_gds-obj.prod-code
     3620         and buf_doc-line.status_   = 'факт':U
     3621         and buf_doc-line.fact-order >= v-fact-order-start
     3622         and buf_doc-line.fact-order < v-fact-order-end
     3623       :
     3624       if ( buf_doc-line.ext-doc-type <> 'ep':U       and
     3625            buf_doc-line.ext-doc-type  = 'ie':U          and
     3626            buf_doc-line.ext-doc-type  = 'vt':U                and
     3627            buf_doc-line.ext-doc-type  = 'vp':U           and
     3628            buf_doc-line.ext-doc-type  = 'we':U          and
     3629            buf_doc-line.ext-doc-type  = 'es':U     and
