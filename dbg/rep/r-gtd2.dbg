     1053               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1054               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1055               v-road-tax-base       =  0
     1056               v-road-tax-rubl       =  0
     1057               v-excise-base         =  0
     1058               v-excise-rubl         =  0
     1059               v-transport-base      =  0
     1060               v-transport-rubl      =  0
     1061               v-other-base          =  0
     1062               v-other-rubl          =  0
     1063             .
