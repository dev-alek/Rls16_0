     3773           temp-goods.grp-name  = buf_goods.grp-name
     3774           temp-goods.part-code = temp-parts.part-code
     3775           temp-goods.in-code   = temp-parts.in-code
     3776           temp-goods.gtd-code  = temp-parts.cst-code
     3777         .
