     1251               .
     1252           end.
     1253           if v-gds-dtl-fact-qnty <> 0
     1254           then do:
     1255   if buf_trn-doc.ext-doc-type = 'ot':U or
     1256      buf_trn-doc.ext-doc-type = ?                 then do:
     1257     assign
