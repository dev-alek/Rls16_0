      606   procedure r-cost :
      607     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      608     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      609     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      610     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      611     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      612     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      613     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      614     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      615     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      616     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      617     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      618     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      619     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      620     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      621     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      622     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      623     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      624     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      625     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      626     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      627     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      628     do
      629     on error undo, return error
      630     :
      631       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      632       define buffer   in-vatp-parts    for ub.parts   .
      633       define buffer   in-vatp-doc      for ub.trn-doc .
      634       define buffer   in-vatp-goods    for ub.goods   .
      635       define buffer   in-vatp-sysconf  for ub.sysconf .
      636       define buffer   in-vatp_doc-attr for ub.doc-attr.
      637       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      638       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      639       define variable varinvprb                  as   character              no-undo.
      640       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      641       define variable cli-base-rate              as   decimal                no-undo.
      642       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      643       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      644       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      645       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      646       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      647       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      648       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      649       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      650       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      651       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      652       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      653       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      654       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      655       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      656       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      657       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      658       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      659       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      660       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      661       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      662       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      663       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      664       define variable varinvatp-envd             as   character              no-undo.
      665       define variable varinvatp-type             as   character              no-undo.
      666       def var v-parts-fact-qnty as decimal   no-undo .
      667       define buffer buf_parts    for ub.parts    .
      668       define buffer buf_goods    for ub.goods    .
      669       define buffer buf_trn-doc  for ub.trn-doc  .
      670       define buffer buf_doc-line for ub.doc-line .
      671       find first buf_doc-line no-lock
      672         where buf_doc-line.doc-code  = v-doc-code
      673           and buf_doc-line.artic     = v-artic
      674           and buf_doc-line.prod-type = v-prod-type
      675           and buf_doc-line.prod-code = v-prod-code
      676         no-error .
      677       if not available buf_doc-line then do:
      678         message
      679           vss-workfile vss-revision vss-description skip
      680           vss-include-info9 skip
      681           "Ошибка задания входных параметров" skip
      682           "Не найдена строка документа"  skip
      683           "Документ" v-doc-code skip
      684           "Артикул" v-artic v-prod-type v-prod-code skip
      685           view-as alert-box error .
      686         return error .
      687       end.
      688       find first buf_trn-doc no-lock
      689         where buf_trn-doc.doc-code = v-doc-code
      690         no-error .
      691       if not available buf_trn-doc then do:
      692         message
      693           vss-workfile vss-revision vss-description skip
      694           vss-include-info9 skip
      695           "Ошибка задания входных параметров" skip
      696           "Не найден документ" skip
      697           "Документ" v-doc-code skip
      698           "Артикул" v-artic v-prod-type v-prod-code skip
      699           view-as alert-box error .
      700         undo, return error .
      701       end.
      702       find first buf_goods no-lock
      703         where buf_goods.artic     = buf_doc-line.artic
      704           and buf_goods.prod-type = buf_doc-line.prod-type
      705           and buf_goods.prod-code = buf_doc-line.prod-code
      706         no-error .
      707       if not available buf_goods then do:
      708         message
      709           vss-workfile vss-revision vss-description skip
      710           vss-include-info9 skip
      711           "Ошибка задания входных параметров" skip
      712           "Не найден товар" skip
      713           "Документ" v-doc-code skip
      714           "Артикул" v-artic v-prod-type v-prod-code skip
      715           view-as alert-box error .
      716         undo, return error .
      717       end.
      718       if buf_goods.gds-type = 'т':U then do:
      719             for each buf_parts no-lock
      720               where buf_parts.out-code  = buf_trn-doc.doc-code
      721                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      722                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      723                 and buf_parts.artic     = buf_doc-line.artic
      724                 and buf_parts.prod-type = buf_doc-line.prod-type
      725                 and buf_parts.prod-code = buf_doc-line.prod-code
      726             on error undo, return error
      727             :
      728   assign
      729     price-rubl-with-tax-loc = buf_parts.price-rubl
      730     price-base-with-tax-loc = buf_parts.price-base
      731   .
      732   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      733   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      734     (output varinvprb
      735     )  .
      736     if buf_parts.out-code = 'free-zone':U     or
      737        buf_parts.out-code = 'out-zone':U   or
      738        buf_parts.doc-type = 'акт':U then do:
      739       assign
      740         in-vatp-have-vat-slt = yes.
      741     end.
      742     else do:
      743       find first in-vatp_doc-attr no-lock
      744         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      745           and in-vatp_doc-attr.attr-code = 'envd':U
      746         no-error .
      747       if not available in-vatp_doc-attr then do:
      748         assign
      749           in-vatp-have-vat-slt = yes.
      750       end.
      751       else do:
      752            in-vatp-have-vat-slt = no.
      753       end.
      754     end.
      755     assign
      756      price-cli-with-tax-loc = buf_parts.price-cli
      757      cli-base-rate          = buf_parts.cli-base-rate.
      758     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      759              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      760     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      761             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      762             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      763             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      764             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      765             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      766             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      767       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      768     assign
      769       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      770     assign
      771       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      772       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      773       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      774       transport-cli-loc  = 0
      775       other-cli-loc      = 0
      776     .
      777   ASSIGN
      778             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      779       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      780   .
      781               assign
      782                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
      783                                       or buf_trn-doc.doc-type = 'возврат':U
      784                                       or buf_trn-doc.doc-type = 'инв':U
      785                                       then buf_parts.fact-qnty
      786                                       else - buf_parts.fact-qnty
      787                                      )
      788               .
      789               assign
      790                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
      791                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
      792                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
      793                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
      794                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
      795                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
      796                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
      797                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
      798                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
      799                 v-excise-base         =   0
      800                 v-excise-rubl         =   0
      801                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
      802                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
      803                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
      804                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
      805               .
      806           end.
      807   assign
      808     price-rubl-with-tax-loc = buf_doc-line.price-rubl
      809     price-base-with-tax-loc = buf_doc-line.price-base
      810   .
      811   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      813     (output varinvprb
      814     )  .
      815      find first in-vatp_doc-attr no-lock
      816       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      817         and in-vatp_doc-attr.attr-code = 'envd':U
      818       no-error .
      819       if available in-vatp_doc-attr
      820          then do:
      821          assign
