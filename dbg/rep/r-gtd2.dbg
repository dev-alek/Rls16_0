     1534         "road-tax-rubl " p-road-tax-rubl  skip
     1535         "transport-base" p-transport-base skip
     1536         "transport-rubl" p-transport-rubl skip
     1537         "other-base    " p-other-base     skip
     1538         "other-rubl    " p-other-rubl     skip
     1539         "excise-base   " p-excise-base    skip
     1540         "excise-rubl   " p-excise-rubl    skip
