     3800           temp-goods.p-ost-sum = (if var-report-r-b = "rubl" then temp-parts.price-rubl else temp-parts.price-base) * temp-parts.fact-qnty
     3801         .
     3802       end.
     3803       else do:
     3804         find first buf_goods no-lock where buf_goods.gds-code = buf_gds-obj.gds-code .
     3805         create temp-goods .
     3806         assign
     3807           temp-goods.artic     = buf_gds-obj.artic
     3808           temp-goods.prod-code = buf_gds-obj.prod-code
     3809           temp-goods.prod-type = buf_gds-obj.prod-type
     3810           temp-goods.grp-name  = buf_goods.grp-name
     3811           temp-goods.part-code = temp-parts.part-code
     3812           temp-goods.in-code   = temp-parts.in-code
     3813           temp-goods.gtd-code  = temp-parts.cst-code
     3814           temp-goods.p-ost     = temp-parts.fact-qnty
     3815           temp-goods.p-ost-sum = (if var-report-r-b = "rubl" then temp-parts.price-rubl else temp-parts.price-base) * temp-parts.fact-qnty
     3816         .
