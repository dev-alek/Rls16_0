     3898             assign
     3899               temp-goods.p-vozv     = temp-goods.p-vozv     + buf_parts.fact-qnty
     3900               temp-goods.p-vozv-sum = temp-goods.p-vozv-sum + (if var-report-r-b = "rubl" then buf_parts.price-rubl else buf_parts.price-base) * buf_parts.fact-qnty
     3901             .
