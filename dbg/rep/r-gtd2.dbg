     3637           and buf_parts.obj-type  = buf_doc-line.obj-type
     3638           and buf_parts.obj-code  = buf_doc-line.obj-code
     3639           and buf_parts.artic     = buf_doc-line.artic
     3640           and buf_parts.prod-type = buf_doc-line.prod-type
     3641           and buf_parts.prod-code = buf_doc-line.prod-code
     3642         :
     3643         find first temp-goods
