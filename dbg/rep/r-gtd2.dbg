     3645             and temp-goods.prod-code = buf_parts.prod-code
     3646             and temp-goods.prod-type = buf_parts.prod-type
     3647             and temp-goods.part-code = buf_parts.part-code
     3648             and temp-goods.in-code   = buf_parts.in-code
     3649           no-error .
     3650         if not available temp-goods then do:
     3651           find first buf_goods no-lock
     3652             where buf_goods.artic     = buf_parts.artic
     3653               and buf_goods.prod-code = buf_parts.prod-code
     3654               and buf_goods.prod-type = buf_parts.prod-type
     3655             .
