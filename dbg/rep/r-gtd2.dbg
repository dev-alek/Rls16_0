     3821     for each buf_doc-line no-lock
     3822       where buf_doc-line.obj-type  = buf_gds-obj.obj-type
     3823         and buf_doc-line.obj-code  = buf_gds-obj.obj-code
     3824         and buf_doc-line.artic     = buf_gds-obj.artic
     3825         and buf_doc-line.prod-type = buf_gds-obj.prod-type
     3826         and buf_doc-line.prod-code = buf_gds-obj.prod-code
     3827         and buf_doc-line.status_   = 'факт':U
     3828         and buf_doc-line.fact-order >= v-fact-order-start
     3829         and buf_doc-line.fact-order < v-fact-order-end
     3830       :
     3831       if ( buf_doc-line.ext-doc-type <> 'ep':U       and
     3832            buf_doc-line.ext-doc-type  = 'ie':U          and
     3833            buf_doc-line.ext-doc-type  = 'vt':U                and
     3834            buf_doc-line.ext-doc-type  = 'vp':U           and
     3835            buf_doc-line.ext-doc-type  = 'we':U          and
     3836            buf_doc-line.ext-doc-type  = 'es':U     and
     3837            buf_doc-line.ext-doc-type  = 'ee':U          and
     3838            buf_doc-line.ext-doc-type  = 'wm':U           and
     3839            buf_doc-line.ext-doc-type  = 'im':U           and
     3840            buf_doc-line.ext-doc-type  = 'rs':U and
     3841            buf_doc-line.ext-doc-type  = 're':U ) then next.
     3842       for each buf_parts no-lock
     3843         where buf_parts.out-code  = buf_doc-line.doc-code
     3844           and buf_parts.obj-type  = buf_doc-line.obj-type
     3845           and buf_parts.obj-code  = buf_doc-line.obj-code
     3846           and buf_parts.artic     = buf_doc-line.artic
     3847           and buf_parts.prod-type = buf_doc-line.prod-type
     3848           and buf_parts.prod-code = buf_doc-line.prod-code
     3849         :
     3850         find first temp-goods
     3851           where temp-goods.artic     = buf_parts.artic
     3852             and temp-goods.prod-code = buf_parts.prod-code
     3853             and temp-goods.prod-type = buf_parts.prod-type
     3854             and temp-goods.part-code = buf_parts.part-code
     3855             and temp-goods.in-code   = buf_parts.in-code
     3856           no-error .
     3857         if not available temp-goods then do:
     3858           find first buf_goods no-lock
     3859             where buf_goods.artic     = buf_parts.artic
     3860               and buf_goods.prod-code = buf_parts.prod-code
     3861               and buf_goods.prod-type = buf_parts.prod-type
     3862             .
     3863           create temp-goods .
     3864           assign
     3865             temp-goods.artic     = buf_parts.artic
     3866             temp-goods.prod-code = buf_parts.prod-code
     3867             temp-goods.prod-type = buf_parts.prod-type
     3868             temp-goods.grp-name  = buf_goods.grp-name
     3869             temp-goods.part-code = buf_parts.part-code
     3870             temp-goods.in-code   = buf_parts.in-code
     3871             temp-goods.gtd-code  = buf_parts.cst-code
     3872           .
     3873           if g#gds-engl then assign temp-goods.gds-name = buf_goods.engl-name.
     3874           else               assign temp-goods.gds-name = buf_goods.gds-name.
     3875         end.
