     3721                   and buf_gds-obj.obj-code = obj-list.obj-code
     3722                   and buf_gds-obj.grp-name begins CurrGrpName
     3723                 use-index obj-grp :
     3724   define variable vss-include-info33 as character format "X(65)" no-undo
     3725   initial "@(#)$Workfile$ $Revision$".
     3726     assign Counter1 = Counter1 + 1.
     3727   IF ( Counter1 modulo v-account = 0 )  then DO:
     3728             if  log-manager:logfile-name ne ?
     3729             then DO:
     3730                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3731             end.
     3732              if mFrameView
     3733              then do:
     3734               DISPLAY
     3735                 Counter1 @ RecordsDone
     3736                 WITH FRAME InfoFrame.
     3737              end.
     3738   End.
     3739      if v-button-stop then  DO:
     3740            if mFrameView
     3741            then
     3742               PROCESS EVENTS.
     3743            IF StopProcessing THEN DO:
     3744            RETURN error.
     3745            End.
     3746      end.
     3747     run partslib-init-temp-parts-by-factord (input buf_gds-obj.obj-type,
     3748                                              input buf_gds-obj.obj-code,
     3749                                              input buf_gds-obj.artic,
     3750                                              input buf_gds-obj.prod-type,
     3751                                              input buf_gds-obj.prod-code,
     3752                                              input v-fact-order-end,
     3753                                              false) .
     3754     assign is-new = no .
     3755     for each temp-parts :
     3756       find first temp-goods
     3757         where temp-goods.artic     = temp-parts.artic
     3758           and temp-goods.prod-code = temp-parts.prod-code
     3759           and temp-goods.prod-type = temp-parts.prod-type
     3760           and temp-goods.part-code = temp-parts.part-code
     3761           and temp-goods.in-code   = temp-parts.in-code
     3762         no-error .
     3763       if not available temp-goods then do:
     3764         if is-new = no then do:
     3765           assign is-new = yes .
     3766           find first buf_goods no-lock where buf_goods.gds-code = buf_gds-obj.gds-code .
     3767         end.
