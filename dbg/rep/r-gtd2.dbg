     3608           temp-goods.p-ost-sum = (if var-report-r-b = "rubl" then temp-parts.price-rubl else temp-parts.price-base) * temp-parts.fact-qnty
     3609         .
     3610         if g#gds-engl then assign temp-goods.gds-name = buf_goods.engl-name.
     3611         else               assign temp-goods.gds-name = buf_goods.gds-name.
     3612       end.
     3613     end.
     3614     for each buf_doc-line no-lock
