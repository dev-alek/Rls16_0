     1544   end procedure.
     1545   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1546     if num-entries(string(p-dec), '.') = 2
     1547       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1548       else return( string(p-dec)) .
     1549   end function.
     1550   function format-point-to-comma returns char (input orig as char ) .
     1551   define variable rtext as character no-undo .
     1552   define variable strt as integer no-undo .
     1553   define variable leng as integer no-undo .
     1554   assign rtext = orig .
     1555   repeat:
     1556     strt =  index(rtext,'.').
     1557     if strt = 0 then leave.
     1558     leng = 1.
     1559     substring(rtext,strt,leng,"character") = v-delim .
     1560   end.
     1561   return rtext.
     1562   end function.
     1563   function format-excel-text returns char ( input start-text as char ) :
     1564   def var  i    as int no-undo.
     1565   def var  ch   as char no-undo.
     1566   def var  n    as int no-undo.
     1567   def var  ipos as int no-undo.
     1568     n = num-entries(trim(start-text), chr(10)) - 1 .
     1569     do i = 1 to n :
     1570       ipos = index( start-text, chr(10)).
     1571       if ipos > 0 then
     1572         substr( start-text, ipos, 1 ) = ' '.
     1573     end.
     1574     n = num-entries(trim(start-text), chr(13)) - 1 .
     1575     do i = 1 to n :
     1576       ipos = index( start-text, chr(13)).
     1577       if ipos > 0 then
     1578         substr( start-text, ipos, 1 ) = ' '.
     1579     end.
     1580     if index( start-text, '"' ) = 0 then
     1581       start-text =  '="'   + trim( start-text) + '"'   .
     1582       else do:
     1583         n = num-entries(trim(start-text), '"') - 1.
     1584         do i = 1 to n :
     1585           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1586         end.
     1587         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1588         start-text = '="'  + ch  + '"' .
     1589       end.
     1590     return start-text.
     1591   end.
     1592   function excel-sum returns char (input p-dec as decimal ).
     1593     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1594   end function.
     1595   function excel-qnty returns char (input p-dec as decimal ).
     1596     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1597   end function.
     1598   function format-excel-text-macr returns char ( input start-text as char ) :
     1599   def var  i    as int no-undo.
     1600   def var  ch   as char no-undo.
     1601   def var  n    as int no-undo.
     1602   def var  ipos as int no-undo.
     1603     n = num-entries(trim(start-text), chr(10)) - 1 .
     1604     do i = 1 to n :
     1605       ipos = index( start-text, chr(10)).
     1606       if ipos > 0 then
     1607         substring( start-text, ipos , 1 ) = ' '.
     1608     end.
     1609     n = num-entries(trim(start-text), chr(13)) - 1 .
     1610     do i = 1 to n :
     1611       ipos = index( start-text, chr(13)).
     1612       if ipos > 0 then
     1613         substring( start-text, ipos, 1 ) = ' '.
     1614     end.
     1615     if index( start-text, '"' ) = 0 then
     1616       start-text =  '"'   + trim( start-text) + '"'   .
     1617       else do:
     1618         n = num-entries(trim(start-text), '"') - 1.
     1619         do i = 1 to n :
     1620           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1621         end.
     1622         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1623         start-text = '"'  + ch  + '"' .
     1624       end.
     1625     n = num-entries(trim(start-text), chr(10)) - 1 .
     1626     do i = 1 to n :
     1627       ipos = index( start-text, chr(10)).
     1628       if ipos > 0 then
     1629         substring( start-text, ipos , 1 ) = ' '.
     1630     end.
     1631       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1632     return start-text.
     1633   end.
     1634   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1635   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1636   procedure paramls-clear :
     1637     define buffer buf_temp-param for temp-param .
     1638     do
     1639     on error undo, return error return-value
     1640     :
     1641       for each buf_temp-param
     1642       on error undo, return error
     1643       :
     1644         delete buf_temp-param .
     1645       end.
     1646     end.
     1647   end procedure.
     1648   procedure paramls-write :
     1649     define input  parameter p-code     as character no-undo .
     1650     define input  parameter p-sub-code as character no-undo .
     1651     define input  parameter p-value    as character no-undo .
     1652     define buffer buf_temp-param for temp-param .
     1653     do
     1654     on error undo, return error return-value
     1655     :
     1656       find first buf_temp-param
     1657         where buf_temp-param.param-code     = p-code
     1658           and buf_temp-param.param-sub-code = p-sub-code
     1659         no-error .
     1660       if not available buf_temp-param then do:
     1661         create buf_temp-param .
     1662         assign
     1663           buf_temp-param.param-code     = p-code
     1664           buf_temp-param.param-sub-code = p-sub-code
     1665         .
     1666       end.
     1667       assign
     1668         buf_temp-param.param-value = p-value
     1669       .
     1670     end.
     1671   end procedure.
     1672   procedure paramls-read :
     1673     define input  parameter p-code          as character no-undo .
     1674     define input  parameter p-sub-code      as character no-undo .
     1675     define input  parameter p-default-value as character no-undo .
     1676     define output parameter p-value         as character no-undo .
     1677     define buffer buf_temp-param for temp-param .
     1678     do
     1679     on error undo, return error return-value
     1680     :
     1681       find first buf_temp-param
     1682         where buf_temp-param.param-code     = p-code
     1683           and buf_temp-param.param-sub-code = p-sub-code
     1684         no-error .
     1685       if available buf_temp-param then do:
     1686         assign
     1687           p-value = buf_temp-param.param-value
     1688         .
     1689       end.
     1690       else do:
     1691         assign
     1692           p-value = p-default-value
     1693         .
     1694       end.
     1695     end.
     1696   end procedure.
     1697   procedure paramls-append :
     1698     define input  parameter p-code     as character no-undo .
     1699     define input  parameter p-sub-code as character no-undo .
     1700     define input  parameter p-value    as character no-undo .
     1701     define buffer buf_temp-param for temp-param .
     1702     do
     1703     on error undo, return error return-value
     1704     :
     1705       find first buf_temp-param
     1706            where buf_temp-param.param-code     = p-code
     1707              and buf_temp-param.param-sub-code = p-sub-code
     1708         no-error .
     1709       if not available buf_temp-param then do:
     1710         create buf_temp-param .
     1711         assign
     1712           buf_temp-param.param-code     = p-code
     1713           buf_temp-param.param-sub-code = p-sub-code
     1714           buf_temp-param.param-value    = p-value
     1715         .
     1716       end.
     1717       else do:
     1718           assign
     1719               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1720           .
     1721       end.
     1722     end.
     1723   end procedure.
     1724   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1725   procedure factord :
     1726     define input  parameter p-fact-date            as date    no-undo .
     1727     define input  parameter p-fact-time            as integer no-undo .
     1728     define input  parameter p-fact-num             as integer no-undo .
     1729     define input  parameter p-shift-date           as date    no-undo .
     1730     define input  parameter p-shift-num            as integer no-undo .
     1731     define input  parameter p-shift-on             as logical no-undo .
     1732     define output parameter p-fact-order           as decimal no-undo .
     1733     define output parameter p-shift-end-fact-order as decimal no-undo .
     1734     define output parameter p-day-end-fact-order   as decimal no-undo .
     1735     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1736     if p-fact-date = ?
     1737     then do:
     1738       return error "Не указана фактическая дата" .
     1739     end.
     1740     define variable v-fact-date-num as integer no-undo .
     1741     assign
     1742       v-fact-date-num = integer(p-fact-date)
     1743     .
     1744     if p-fact-num = ?
     1745     or p-fact-num = 0
     1746     then do:
     1747       return error "Не задан p-fact-num " + string(p-fact-num) .
     1748     end.
     1749     if p-fact-num < 0
     1750     then do:
     1751       return error "Отрицательный fact-num " + string(p-fact-num) .
     1752     end.
     1753     if p-fact-num >= 100000000
     1754     then do:
     1755       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1756     end.
     1757     if p-shift-on = true
     1758     then do:
     1759       if p-shift-date = ?
     1760       then do:
     1761         return error "Не задана дата смены" .
     1762       end.
     1763       if p-shift-num = ?
     1764       or p-shift-num = 0
     1765       then do:
     1766         return error "Не задан номер смены" .
     1767       end.
     1768     end.
     1769     else do:
     1770       assign
     1771         p-shift-date = p-fact-date
     1772         p-shift-num  = 24
     1773       .
     1774     end.
     1775     define variable v-shift-offset as integer no-undo .
     1776     if p-shift-date = p-fact-date
     1777     then do:
     1778       assign
     1779         v-shift-offset = 1
     1780       .
     1781     end.
     1782     if p-shift-date < p-fact-date
     1783     then do:
     1784       assign
     1785         v-shift-offset = 0
     1786       .
     1787     end.
     1788     if p-shift-date > p-fact-date
     1789     then do:
     1790       message
     1791         vss-workfile vss-revision vss-description skip
     1792         "Неправильная дата закрытия смены" skip
     1793         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1794         view-as alert-box error .
     1795       undo, return error
     1796         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1797           ,string(p-fact-date, '99/99/9999':U)
     1798           ,string(p-shift-date, '99/99/9999':U)
     1799           )
     1800       .
     1801     end.
     1802     if p-shift-num < 1
     1803     or p-shift-num > 24
     1804     then do:
     1805       message
     1806         vss-workfile vss-revision vss-description skip
     1807         "Неправильный номер смены" skip
     1808         "p-shift-num" p-shift-num skip
     1809         view-as alert-box error .
     1810       undo, return error return-value .
     1811     end.
     1812     assign
     1813       p-fact-order           = v-fact-date-num
     1814                              + v-shift-offset * 0.5
     1815                              + p-shift-num    * 0.02 - 0.01
     1816                              + p-fact-num     * 0.0000000001
     1817       p-shift-end-fact-order = v-fact-date-num
     1818                              + v-shift-offset * 0.5
     1819                              + p-shift-num    * 0.02
     1820       p-day-end-fact-order   = v-fact-date-num
     1821                              + 0.99
     1822     .
     1823     if p-fact-order           <= v-fact-date-num
     1824     or p-shift-end-fact-order <= v-fact-date-num
     1825     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1826     or p-shift-end-fact-order >= p-day-end-fact-order
     1827     then do:
     1828       message
     1829         vss-workfile vss-revision vss-description skip
     1830         "Внутренняя ошибка при генерации фактического номера" skip
     1831         "p-fact-date"            p-fact-date            skip
     1832         "p-fact-time"            p-fact-time            skip
     1833         "p-fact-num"             p-fact-num             skip
     1834         "p-shift-date"           p-shift-date           skip
     1835         "p-shift-num"            p-shift-num            skip
     1836         "p-shift-on"             p-shift-on             skip
     1837         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1838         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1839         "v-fact-date-num"        v-fact-date-num        skip
     1840         view-as alert-box error .
     1841       undo, return error return-value .
     1842     end.
     1843   end procedure.
     1844   procedure day-begin-fact-order :
     1845     define input  parameter p-fact-date            as date    no-undo .
     1846     define output parameter p-day-begin-fact-order as decimal no-undo .
     1847     do
     1848     on error undo, return error return-value
     1849     :
     1850       if p-fact-date = ?
     1851       then do:
     1852         assign
     1853           p-day-begin-fact-order = 0
     1854         .
     1855       end.
     1856       else do:
     1857         assign
     1858           p-day-begin-fact-order = integer(p-fact-date)
     1859         .
     1860       end.
     1861     end.
     1862   end procedure.
     1863   procedure factord-max-fact-order :
     1864     define output parameter p-max-fact-order as decimal   no-undo .
     1865     do
     1866     on error undo, return error return-value
     1867     :
     1868       run day-begin-fact-order in this-procedure
     1869         (input  date(1, 1, 5000)
     1870         ,output p-max-fact-order
     1871         ) .
     1872     end.
     1873   end procedure.
     1874   procedure factord-cut-archive :
     1875     define input  parameter p-obj-type             as character no-undo .
     1876     define input  parameter p-obj-code             as integer   no-undo .
     1877     define input  parameter p-fact-date            as date      no-undo .
     1878     define output parameter p-shift-on             as logical   no-undo .
     1879     define output parameter p-shift-date           as date      no-undo .
     1880     define output parameter p-shift-num            as integer   no-undo .
     1881     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1882     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1883     define variable v-fact-order as decimal   no-undo .
     1884     define buffer buf_shift-obj for ub.shift-obj .
     1885     do
     1886     on error undo, return error return-value
     1887     :
     1888   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1889   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1890     (input  p-obj-type
     1891     ,input  p-obj-code
     1892     ,input  'shift-on=request'
     1893     ,output p-shift-on
     1894     ) no-error .
     1895       if error-status :error
     1896       then do:
     1897         message
     1898           vss-workfile vss-revision vss-description skip
     1899           "Ошибка при определении атрибута объекта" skip
     1900           "Объект" p-obj-type p-obj-code skip
     1901           error-status :get-message(1) skip
     1902           return-value skip
     1903           view-as alert-box error .
     1904         undo, return error return-value .
     1905       end.
     1906       if p-shift-on = false
     1907       then do:
     1908         assign
     1909           p-shift-date               = ?
     1910           p-shift-num                = 0
     1911         .
     1912       end.
     1913       else do:
     1914         find first buf_shift-obj share-lock
     1915           where buf_shift-obj.obj-type   = p-obj-type
     1916             and buf_shift-obj.obj-code   = p-obj-code
     1917             and buf_shift-obj.shift-date > p-fact-date
     1918           use-index pi
     1919           no-error .
     1920         if not available buf_shift-obj
     1921         or buf_shift-obj.status_ <> 'зкр':U
     1922         then do:
     1923           message
     1924             vss-workfile vss-revision vss-description skip
     1925             "Невозможно вычислить последнюю смену" skip
     1926             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1927             "Объект" p-obj-type p-obj-code skip
     1928             "Дата" p-fact-date skip
     1929             view-as alert-box error .
     1930           undo, return error return-value .
     1931         end.
     1932         find last buf_shift-obj share-lock
     1933           where buf_shift-obj.obj-type = p-obj-type
     1934             and buf_shift-obj.obj-code = p-obj-code
     1935             and buf_shift-obj.shift-date <= p-fact-date
     1936           use-index pi
     1937           no-error .
     1938         if available buf_shift-obj
     1939         then do:
     1940           if  buf_shift-obj.status_ = 'зкр':U
     1941           then do:
     1942             assign
     1943               p-shift-date = buf_shift-obj.shift-date
     1944               p-shift-num  = buf_shift-obj.shift-num
     1945             .
     1946           end.
     1947           else do:
     1948             message
     1949               vss-workfile vss-revision vss-description skip
     1950               "Невозможно вычислить последнюю смену" skip
     1951               "Статус смены отличен от статуса" 'зкр':U skip
     1952               "Объект" p-obj-type p-obj-code skip
     1953               "Дата" p-fact-date skip
     1954               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1955               view-as alert-box error .
     1956             undo, return error return-value .
     1957           end.
     1958         end.
     1959         else do:
     1960           assign
     1961             p-shift-date = p-fact-date - 1
     1962             p-shift-num  = 1
     1963           .
     1964         end.
     1965       end.
     1966       run factord in this-procedure
     1967         (input  p-fact-date
     1968         ,input  1
     1969         ,input  1
     1970         ,input  p-shift-date
     1971         ,input  p-shift-num
     1972         ,input  p-shift-on
     1973         ,output v-fact-order
     1974         ,output p-shift-end-fact-order
     1975         ,output p-day-end-fact-order
     1976         ) no-error .
     1977       if error-status :error
     1978       then do:
     1979         message
     1980           vss-workfile vss-revision vss-description skip
     1981           "Ошибка при вызове процедуры factord"
     1982           error-status :get-message(1) skip
     1983           return-value skip
     1984           view-as alert-box error .
     1985         undo, return error return-value .
     1986       end.
     1987     end.
     1988   end procedure.
     1989   procedure factord-lock-shift :
     1990     define input  parameter p-obj-type  as character no-undo .
     1991     define input  parameter p-obj-code  as integer   no-undo .
     1992     define input  parameter p-fact-date as date      no-undo .
     1993     define parameter buffer buf_shift-obj for ub.shift-obj .
     1994     define variable v-shift-on      as logical   no-undo .
     1995     define variable v-extra-message as character no-undo .
     1996     define variable v-error as character no-undo .
     1997     do
     1998     on error undo, return error return-value
     1999     :
     2000   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2001   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2002     (input  p-obj-type
     2003     ,input  p-obj-code
     2004     ,input  'shift-on=request'
     2005     ,output v-shift-on
     2006     ) no-error .
     2007       if error-status :error
     2008       then do:
     2009         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2010         undo, return error v-error .
     2011       end.
     2012       if v-shift-on = true
     2013       then do:
     2014         find first buf_shift-obj share-lock
     2015           where buf_shift-obj.obj-type   = p-obj-type
     2016             and buf_shift-obj.obj-code   = p-obj-code
     2017             and buf_shift-obj.shift-date > p-fact-date
     2018           use-index pi
     2019           no-error .
     2020         if not available buf_shift-obj
     2021         or buf_shift-obj.status_ <> 'зкр':U
     2022         then do:
     2023           find last buf_shift-obj
     2024             where buf_shift-obj.obj-type = p-obj-type
     2025               and buf_shift-obj.obj-code = p-obj-code
     2026               and buf_shift-obj.status_  = 'зкр':U
     2027             use-index stts
     2028             no-error .
     2029           if available buf_shift-obj
     2030           then do:
     2031             assign
     2032               v-extra-message =
     2033                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2034                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2035                               )
     2036             .
     2037           end.
     2038           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2039           undo, return error v-error .
     2040         end.
     2041       end.
     2042     end.
     2043   end procedure.
     2044   procedure factord-end-day :
     2045     define input  parameter p-fact-date            as date    no-undo .
     2046     define output parameter p-day-end-fact-order   as decimal no-undo .
     2047     do
     2048     on error undo, return error return-value
     2049     :
     2050       if p-fact-date = ?
     2051       then do:
     2052         return error "Не указана фактическая дата" .
     2053       end.
     2054       assign
     2055         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2056       .
     2057     end.
     2058   end procedure.
     2059   procedure factord-to-date :
     2060     define input  parameter p-fact-order as decimal no-undo .
     2061     define output parameter p-fact-date  as date    no-undo .
     2062     define variable v-ref-date  as date      no-undo .
     2063     define variable v-ref-delta as integer   no-undo .
     2064     do
     2065     on error undo, return error return-value
     2066     :
     2067       if p-fact-order = ?
     2068       or p-fact-order = 0
     2069       then do:
     2070         return error "Не указан fact-order" .
     2071       end.
     2072       assign
     2073         v-ref-date  = date(1, 1, 2000)
     2074       .
     2075       assign
     2076         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2077       .
     2078       assign
     2079         p-fact-date = v-ref-date + v-ref-delta
     2080       .
     2081     end.
     2082   end procedure.
     2083   procedure factord-to-fact-num :
     2084     define input  parameter p-fact-order as decimal no-undo .
     2085     define output parameter p-fact-num   as integer no-undo .
     2086     define variable v-fact-order-trunc as decimal no-undo .
     2087     do
     2088     on error undo, return error return-value
     2089     :
     2090       if p-fact-order = ?
     2091       or p-fact-order = 0
     2092       then do:
     2093         return error "Не указан fact-order" .
     2094       end.
     2095       assign
     2096        v-fact-order-trunc = truncate(p-fact-order, 2)
     2097       .
     2098       assign
     2099         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2100       .
     2101     end.
     2102   end procedure.
     2103   procedure factord-to-shift-num :
     2104     define input  parameter p-fact-order as decimal no-undo .
     2105     define output parameter p-shift-num   as integer no-undo .
     2106     define variable  p-shift-numd  as decimal   no-undo .
     2107     define variable v-fact-order-trunc as decimal no-undo .
     2108     do
     2109     on error undo, return error return-value
     2110     :
     2111       if p-fact-order = ?
     2112       or p-fact-order = 0
     2113       then do:
     2114         return error "Не указан fact-order" .
     2115       end.
     2116       assign
     2117        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2118       .
     2119       if v-fact-order-trunc < 0.5 then do:
     2120         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2121       end.
     2122       assign
     2123         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2124         .
     2125        assign
     2126         p-shift-num = truncate (p-shift-numd , 0)
     2127       .
     2128     end.
     2129   end procedure.
     2130   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2131   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     2132   procedure partslib-clear-temp-parts :
     2133     define buffer buf_temp-parts for temp-parts .
     2134     do
     2135     on error undo, return error
     2136     :
     2137       for each buf_temp-parts
     2138       on error undo, return error
     2139       :
     2140         delete buf_temp-parts .
     2141       end.
     2142     end.
     2143   end procedure.
     2144   procedure partslib-create-temp-parts :
     2145     define parameter buffer buf_parts       for ub.parts .
     2146     define parameter buffer buf_temp-parts  for temp-parts .
     2147     define input  parameter p-goods-twounit as logical   no-undo .
     2148     define variable v-base-part-code as character no-undo .
     2149     do
     2150     on error undo, return error
     2151     :
     2152       if p-goods-twounit = true
     2153       then do:
     2154         assign
     2155           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     2156         .
     2157       end.
     2158       else do:
     2159         assign
     2160           v-base-part-code = buf_parts.part-code
     2161         .
     2162       end.
     2163       find first buf_temp-parts exclusive-lock
     2164         where buf_temp-parts.obj-type  = buf_parts.obj-type
     2165           and buf_temp-parts.obj-code  = buf_parts.obj-code
     2166           and buf_temp-parts.artic     = buf_parts.artic
     2167           and buf_temp-parts.prod-type = buf_parts.prod-type
     2168           and buf_temp-parts.prod-code = buf_parts.prod-code
     2169           and buf_temp-parts.in-code   = buf_parts.in-code
     2170           and buf_temp-parts.out-code  = 'free-zone':U
     2171           and buf_temp-parts.part-code = v-base-part-code
     2172         no-error.
     2173       if not available buf_temp-parts
     2174       then do:
     2175         create buf_temp-parts .
     2176         buffer-copy buf_parts to buf_temp-parts
     2177         assign
     2178           buf_temp-parts.out-code  = 'free-zone':U
     2179           buf_temp-parts.part-code = v-base-part-code
     2180           buf_temp-parts.rsrv-free = yes
     2181           buf_temp-parts.status_   = no
     2182           buf_temp-parts.qnty      = 0
     2183           buf_temp-parts.fact-qnty = 0
     2184           buf_temp-parts.real-qnty = 0
     2185           buf_temp-parts.cli-qnty  = 0
     2186         .
     2187       end.
     2188     end.
     2189   end procedure.
     2190   procedure partslib-init-temp-parts :
     2191     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2192     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2193     define input parameter p-artic           like ub.parts.artic     no-undo .
     2194     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2195     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2196     define buffer buf_parts      for ub.parts .
     2197     define buffer buf_temp-parts for temp-parts .
     2198     define variable v-goods-twounit    as logical   no-undo .
     2199     do
     2200     on error undo, return error
     2201     :
     2202   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2203   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2204     (input  p-artic
     2205     ,input  p-prod-type
     2206     ,input  p-prod-code
     2207     ,input  'twounit=request':u
     2208     ,output v-goods-twounit
     2209     ) no-error .
     2210       if error-status :error
     2211       then do:
     2212         message
     2213           vss-workfile vss-revision vss-description skip
     2214           vss-include-info22 skip
     2215           "Ошибка при определении атрибута товара" skip
     2216           "Артикул" p-artic p-prod-type p-prod-code skip
     2217           "twounit=request" skip
     2218           error-status :get-message(1) skip
     2219           return-value skip
     2220           view-as alert-box error .
     2221         undo, return error return-value .
     2222       end.
     2223       run partslib-clear-temp-parts in this-procedure .
     2224       for each buf_parts
     2225         where buf_parts.obj-type  = p-obj-type
     2226           and buf_parts.obj-code  = p-obj-code
     2227           and buf_parts.artic     = p-artic
     2228           and buf_parts.prod-type = p-prod-type
     2229           and buf_parts.prod-code = p-prod-code
     2230           and buf_parts.rsrv-free = yes
     2231           and buf_parts.status_   = no
     2232           and buf_parts.in-code   <> buf_parts.out-code
     2233       on error undo, return error
     2234       :
     2235         run partslib-create-temp-parts in this-procedure
     2236           (buffer buf_parts
     2237           ,buffer buf_temp-parts
     2238           ,input  v-goods-twounit
     2239           ) .
     2240         define variable v-parts-qnty          as decimal   no-undo .
     2241         define variable v-parts-cli-qnty      as decimal   no-undo .
     2242         define variable v-parts-free-qnty     as decimal   no-undo .
     2243         define variable v-parts-free-cli-qnty as decimal   no-undo .
     2244         if buf_parts.out-code = 'free-zone':U
     2245         then do:
     2246           assign
     2247             v-parts-qnty          = buf_parts.qnty
     2248             v-parts-cli-qnty      = buf_parts.cli-qnty
     2249             v-parts-free-qnty     = buf_parts.qnty
     2250             v-parts-free-cli-qnty = buf_parts.cli-qnty
     2251           .
     2252         end.
     2253         else do:
     2254           assign
     2255             v-parts-qnty          = abs(buf_parts.qnty)
     2256             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     2257             v-parts-free-qnty     = 0
     2258             v-parts-free-cli-qnty = 0
     2259           .
     2260         end.
     2261         assign
     2262           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     2263           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     2264           buf_temp-parts.real-qnty     = 0
     2265           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     2266           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     2267           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     2268         .
     2269       end.
     2270     end.
     2271   end procedure.
     2272   procedure partslib-init-temp-parts-by-factord :
     2273     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2274     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2275     define input parameter p-artic              like ub.parts.artic     no-undo .
     2276     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2277     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2278     define input parameter p-fact-order         as decimal   no-undo .
     2279     define input parameter p-include-fact-order as logical   no-undo .
     2280     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2281     define buffer buf_gds-obj  for ub.gds-obj .
     2282     do
     2283     on error undo, return error
     2284     :
     2285       do transaction
     2286       on error undo, return error
     2287       :
     2288   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2289   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2290     (input  p-obj-type
     2291     ,input  p-obj-code
     2292     ,input  p-artic
     2293     ,input  p-prod-type
     2294     ,input  p-prod-code
     2295     ,buffer buf_gds-obj
     2296     ) no-error .
     2297         if error-status :error
     2298         then do:
     2299           message
     2300             vss-workfile vss-revision vss-description skip
     2301             vss-include-info22 skip
     2302             "Невозможно найти товар на объекте" skip
     2303             "Объект" p-obj-type p-obj-code skip
     2304             "Артикул" p-artic p-prod-type p-prod-code skip
     2305             error-status :get-message(1) skip
     2306             return-value skip
     2307             view-as alert-box error .
     2308           undo, return error .
     2309         end.
     2310         find current buf_gds-obj exclusive-lock .
     2311       end.
     2312       run partslib-init-temp-parts in this-procedure
     2313         (input p-obj-type
     2314         ,input p-obj-code
     2315         ,input p-artic
     2316         ,input p-prod-type
     2317         ,input p-prod-code
     2318         ) no-error .
     2319       if error-status :error
     2320       then do:
     2321         message
     2322           vss-workfile vss-revision vss-description skip
     2323           vss-include-info22 skip
     2324           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     2325           "Объект" p-obj-type p-obj-code skip
     2326           "Артикул" p-artic p-prod-type p-prod-code skip
     2327           "p-fact-order" p-fact-order skip
     2328           view-as alert-box error .
     2329         undo, return error .
     2330       end.
     2331       if p-include-fact-order = true
     2332       then do:
     2333         assign
     2334           p-fact-order = p-fact-order - 0.0000000001
     2335         .
     2336       end.
     2337       define variable v-max-fact-order as character no-undo .
     2338       run factord-max-fact-order in this-procedure
     2339         (output v-max-fact-order
     2340         ) no-error .
     2341       if error-status :error
     2342       then do:
     2343         message
     2344           vss-workfile vss-revision vss-description skip
     2345           vss-include-info22 skip
     2346           "Ошибка при вызове процедуры factord-max-fact-order" skip
     2347           "Объект" p-obj-type p-obj-code skip
     2348           "Артикул" p-artic p-prod-type p-prod-code skip
     2349           "p-fact-order" p-fact-order skip
     2350           view-as alert-box error .
     2351         undo, return error .
     2352       end.
     2353       run partslib-update-by-factord in this-procedure
     2354         (input p-obj-type
     2355         ,input p-obj-code
     2356         ,input p-artic
     2357         ,input p-prod-type
     2358         ,input p-prod-code
     2359         ,input p-fact-order
     2360         ,input v-max-fact-order
     2361         ,input false
     2362         ) no-error .
     2363       if error-status :error
     2364       then do:
     2365         message
     2366           vss-workfile vss-revision vss-description skip
     2367           vss-include-info22 skip
     2368           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     2369           "Объект" p-obj-type p-obj-code skip
     2370           "Артикул" p-artic p-prod-type p-prod-code skip
     2371           "p-fact-order" p-fact-order skip
     2372           "v-max-fact-order" v-max-fact-order skip
     2373           view-as alert-box error .
     2374         undo, return error .
     2375       end.
     2376     end.
     2377   end procedure.
     2378   procedure partslib-update-by-factord :
     2379     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2380     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2381     define input parameter p-artic              like ub.parts.artic     no-undo .
     2382     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2383     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2384     define input parameter p-start-fact-order   as decimal   no-undo .
     2385     define input parameter p-end-fact-order     as decimal   no-undo .
     2386     define input parameter p-lock-gds-obj       as logical   no-undo .
     2387     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2388     define buffer buf_gds-obj  for ub.gds-obj .
     2389     define buffer buf_doc-line for ub.doc-line .
     2390     define variable v-total-parts-qnty as decimal   no-undo .
     2391     define variable v-goods-gds-goods  as logical   no-undo .
     2392     define variable v-goods-twounit    as logical   no-undo .
     2393     do
     2394     on error undo, return error
     2395     :
     2396       if p-start-fact-order > p-end-fact-order
     2397       then do:
     2398         message
     2399           vss-workfile vss-revision vss-description skip
     2400           vss-include-info22 skip
     2401           "Ошибка задания входных параметров" skip
     2402           "Начало интервала превышает конец интервала" skip
     2403           "Объект" p-obj-type p-obj-code skip
     2404           "Артикул" p-artic p-prod-type p-prod-code skip
     2405           "p-start-fact-order" p-start-fact-order skip
     2406           "p-end-fact-order"   p-end-fact-order skip
     2407           view-as alert-box error .
     2408         undo, return error .
     2409       end.
     2410       if p-lock-gds-obj = true
     2411       then do:
     2412         do transaction
     2413         on error undo, return error
     2414         :
     2415   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2417     (input  p-obj-type
     2418     ,input  p-obj-code
     2419     ,input  p-artic
     2420     ,input  p-prod-type
     2421     ,input  p-prod-code
     2422     ,buffer buf_gds-obj
     2423     ) no-error .
     2424           if error-status :error
     2425           then do:
     2426             message
     2427               vss-workfile vss-revision vss-description skip
     2428               vss-include-info22 skip
     2429               "Невозможно найти gds-obj" skip
     2430               error-status :get-message(1) skip
     2431               return-value skip
     2432               view-as alert-box error .
     2433             undo, return error .
     2434           end.
     2435           find current buf_gds-obj exclusive-lock .
     2436         end.
     2437       end.
     2438   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2440     (input  p-artic
     2441     ,input  p-prod-type
     2442     ,input  p-prod-code
     2443     ,input  'gds-goods=request':u
     2444     ,output v-goods-gds-goods
     2445     ) no-error .
     2446       if error-status :error
     2447       then do:
     2448         message
     2449           vss-workfile vss-revision vss-description skip
     2450           vss-include-info22 skip
     2451           "Ошибка при определении атрибута товара" skip
     2452           "Артикул" p-artic p-prod-type p-prod-code skip
     2453           "gds-goods=request" skip
     2454           error-status :get-message(1) skip
     2455           return-value skip
     2456           view-as alert-box error .
     2457         undo, return error return-value .
     2458       end.
     2459   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2460   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2461     (input  p-artic
     2462     ,input  p-prod-type
     2463     ,input  p-prod-code
     2464     ,input  'twounit=request':u
     2465     ,output v-goods-twounit
     2466     ) no-error .
     2467       if error-status :error
     2468       then do:
     2469         message
     2470           vss-workfile vss-revision vss-description skip
     2471           vss-include-info22 skip
     2472           "Ошибка при определении атрибута товара" skip
     2473           "Артикул" p-artic p-prod-type p-prod-code skip
     2474           "twounit=request" skip
     2475           error-status :get-message(1) skip
     2476           return-value skip
     2477           view-as alert-box error .
     2478         undo, return error return-value .
     2479       end.
     2480       for each buf_doc-line no-lock
     2481         where buf_doc-line.obj-type   = p-obj-type
     2482           and buf_doc-line.obj-code   = p-obj-code
     2483           and buf_doc-line.artic      = p-artic
     2484           and buf_doc-line.prod-type  = p-prod-type
     2485           and buf_doc-line.prod-code  = p-prod-code
     2486           and buf_doc-line.status_    = 'факт':U
     2487           and buf_doc-line.fact-order > p-start-fact-order
     2488           and buf_doc-line.fact-order <= p-end-fact-order
     2489       on error undo, return error
     2490       :
     2491         run partslib-process-document in this-procedure
     2492           (input  buf_doc-line.doc-code
     2493           ,input  p-obj-type
     2494           ,input  p-obj-code
     2495           ,input  p-artic
     2496           ,input  p-prod-type
     2497           ,input  p-prod-code
     2498           ,input  v-goods-gds-goods
     2499           ,input  v-goods-twounit
     2500           ,output v-total-parts-qnty
     2501           ) no-error .
     2502         if error-status :error
     2503         then do:
     2504           message
     2505             vss-workfile vss-revision vss-description skip
     2506             vss-include-info22 skip
     2507             "Ошибка при вызове процедуры partslib-process-document" skip
     2508             "Документ" buf_doc-line.doc-code skip
     2509             "Объект" p-obj-type p-obj-code skip
     2510             "Артикул" p-artic p-prod-type p-prod-code skip
     2511             "p-start-fact-order" p-start-fact-order skip
     2512             "p-end-fact-order" p-end-fact-order skip
     2513             error-status :get-message(1) skip
     2514             return-value skip
     2515             view-as alert-box error .
     2516           undo, return error return-value .
     2517         end.
     2518       end.
     2519     end.
     2520   end procedure.
     2521   procedure partslib-process-document :
     2522     define input  parameter p-doc-code         as character no-undo .
     2523     define input  parameter p-obj-type         as character no-undo .
     2524     define input  parameter p-obj-code         as integer   no-undo .
     2525     define input  parameter p-artic            as character no-undo .
     2526     define input  parameter p-prod-type        as character no-undo .
     2527     define input  parameter p-prod-code        as integer   no-undo .
     2528     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2529     define input  parameter p-goods-twounit    as logical   no-undo .
     2530     define output parameter p-total-parts-qnty as decimal   no-undo .
     2531     define variable v-parts-sign as integer   no-undo .
     2532     define buffer buf_trn-doc    for ub.trn-doc .
     2533     define buffer buf_doc-line   for ub.doc-line .
     2534     define buffer buf_parts      for ub.parts .
     2535     define buffer buf_temp-parts for temp-parts .
     2536     do
     2537     on error undo, return error return-value
     2538     :
     2539       find first buf_trn-doc no-lock
     2540         where buf_trn-doc.doc-code = p-doc-code
     2541         no-error .
     2542       if not available buf_trn-doc
     2543       then do:
     2544         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2545                                      ,p-doc-code
     2546                                      ) .
     2547       end.
     2548       case buf_trn-doc.doc-type
     2549       :
     2550         when 'при':U or
     2551         when 'возврат':U or
     2552         when 'инв':U
     2553         then do:
     2554           assign
     2555             v-parts-sign = -1
     2556           .
     2557         end.
     2558         when 'рас':U or
     2559         when 'спи':U
     2560         then do:
     2561           assign
     2562             v-parts-sign = 1
     2563           .
     2564         end.
     2565         otherwise do:
     2566           undo, return error substitute("Неизвестный тип документа &1"
     2567                                       ,buf_trn-doc.doc-type
     2568                                       ) .
     2569         end.
     2570       end.
     2571       find first buf_doc-line no-lock
     2572         where buf_doc-line.doc-code  = p-doc-code
     2573           and buf_doc-line.artic     = p-artic
     2574           and buf_doc-line.prod-type = p-prod-type
     2575           and buf_doc-line.prod-code = p-prod-code
     2576         no-error .
     2577       if not available buf_doc-line
     2578       then do:
     2579         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2580                                      ,p-doc-code
     2581                                      ,artic
     2582                                      ,prod-type
     2583                                      ,prod-code
     2584                                      ) .
     2585       end.
     2586       assign
     2587         p-total-parts-qnty = 0
     2588       .
     2589       if p-goods-gds-goods = true
     2590       then do:
     2591         for each buf_parts no-lock
     2592           where buf_parts.out-code  = p-doc-code
     2593             and buf_parts.obj-type  = p-obj-type
     2594             and buf_parts.obj-code  = p-obj-code
     2595             and buf_parts.artic     = p-artic
     2596             and buf_parts.prod-type = p-prod-type
     2597             and buf_parts.prod-code = p-prod-code
     2598         on error undo, return error
     2599         :
     2600           run partslib-create-temp-parts in this-procedure
     2601             (buffer buf_parts
     2602             ,buffer buf_temp-parts
     2603             ,input  p-goods-twounit
     2604             ) .
     2605           assign
     2606             p-total-parts-qnty        = p-total-parts-qnty
     2607                                       + v-parts-sign * buf_parts.fact-qnty
     2608             buf_temp-parts.qnty       = buf_temp-parts.qnty
     2609                                       + v-parts-sign * buf_parts.fact-qnty
     2610             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     2611                                       + v-parts-sign * buf_parts.fact-qnty
     2612             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     2613                                       + v-parts-sign * buf_parts.cli-qnty
     2614           .
     2615           if buf_temp-parts.qnty = 0
     2616           then do:
     2617             delete buf_temp-parts .
     2618           end.
     2619         end.
     2620       end.
     2621       else do:
     2622         assign
     2623           p-total-parts-qnty = p-total-parts-qnty
     2624                              + v-parts-sign * buf_doc-line.fact-qnty
     2625         .
     2626       end.
     2627     end.
     2628   end procedure.
     2629   procedure partslib-init-temp-parts-by-date :
     2630     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2631     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2632     define input parameter p-artic           like ub.parts.artic     no-undo .
     2633     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2634     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2635     define input parameter p-fact-date       as date      no-undo .
     2636     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2637     do
     2638     on error undo, return error
     2639     :
     2640       define variable v-fact-order                as decimal   no-undo .
     2641       define variable v-shift-end-fact-order      as decimal   no-undo .
     2642       define variable v-day-end-fact-order        as decimal   no-undo .
     2643       run factord in this-procedure
     2644         (input  p-fact-date
     2645         ,input  1
     2646         ,input  1
     2647         ,input  ?
     2648         ,input  0
     2649         ,input  false
     2650         ,output v-fact-order
     2651         ,output v-shift-end-fact-order
     2652         ,output v-day-end-fact-order
     2653         ) no-error .
     2654       if error-status :error
     2655       then do:
     2656         message
     2657           vss-workfile vss-revision vss-description skip
     2658           vss-include-info22 skip
     2659           "Ошибка при определении момента времени, на который требуется остаток" skip
     2660           "Объект" p-obj-type p-obj-code skip
     2661           "Артикул" p-artic p-prod-type p-prod-code skip
     2662           "Дата" p-fact-date skip
     2663           view-as alert-box error .
     2664         undo, return error .
     2665       end.
     2666       run partslib-init-temp-parts-by-factord in this-procedure
     2667         (input p-obj-type
     2668         ,input p-obj-code
     2669         ,input p-artic
     2670         ,input p-prod-type
     2671         ,input p-prod-code
     2672         ,input v-day-end-fact-order
     2673         ,input false
     2674         ) no-error .
     2675       if error-status :error
     2676       then do:
     2677         message
     2678           vss-workfile vss-revision vss-description skip
     2679           vss-include-info22 skip
     2680           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2681           "Объект" p-obj-type p-obj-code skip
     2682           "Артикул" p-artic p-prod-type p-prod-code skip
     2683           "Дата" p-fact-date skip
     2684           view-as alert-box error .
     2685         undo, return error .
     2686       end.
     2687     end.
     2688   end procedure.
     2689   procedure partslib-calc-cost :
     2690     define output parameter p-fact-qnty      as decimal   no-undo .
     2691     define output parameter p-vat-pc         as decimal   no-undo .
     2692     define output parameter p-slt-pc         as decimal   no-undo .
     2693     define output parameter p-sum-base       as decimal   no-undo .
     2694     define output parameter p-sum-rubl       as decimal   no-undo .
     2695     define output parameter p-vat-base       as decimal   no-undo .
     2696     define output parameter p-vat-rubl       as decimal   no-undo .
     2697     define output parameter p-slt-base       as decimal   no-undo .
     2698     define output parameter p-slt-rubl       as decimal   no-undo .
     2699     define output parameter p-road-tax-base  as decimal   no-undo .
     2700     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2701     define output parameter p-transport-base as decimal   no-undo .
     2702     define output parameter p-transport-rubl as decimal   no-undo .
     2703     define output parameter p-other-base     as decimal   no-undo .
     2704     define output parameter p-other-rubl     as decimal   no-undo .
     2705     define output parameter p-excise-base    as decimal   no-undo .
     2706     define output parameter p-excise-rubl    as decimal   no-undo .
     2707     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2708     do
     2709     on error undo, return error return-value
     2710     :
     2711       define buffer buf_temp-parts for temp-parts .
     2712       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2713       define buffer   in-vatp-parts    for ub.parts   .
     2714       define buffer   in-vatp-doc      for ub.trn-doc .
     2715       define buffer   in-vatp-goods    for ub.goods   .
     2716       define buffer   in-vatp-sysconf  for ub.sysconf .
     2717       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2718       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2719       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2720       define variable varinvprb                  as   character              no-undo.
     2721       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2722       define variable cli-base-rate              as   decimal                no-undo.
     2723       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2724       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2725       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2726       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2727       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2728       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2729       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2730       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2731       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2732       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2733       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2734       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2735       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2736       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2737       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2738       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2739       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2740       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2741       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2742       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2743       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2744       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2745       define variable varinvatp-envd             as   character              no-undo.
     2746       define variable varinvatp-type             as   character              no-undo.
     2747       for each buf_temp-parts
     2748       on error undo, return error
     2749       :
     2750   assign
     2751     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     2752     price-base-with-tax-loc = buf_temp-parts.price-base
     2753   .
     2754   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2756     (output varinvprb
     2757     )  .
     2758     if buf_temp-parts.out-code = 'free-zone':U     or
     2759        buf_temp-parts.out-code = 'out-zone':U   or
     2760        buf_temp-parts.doc-type = 'акт':U then do:
     2761       assign
     2762         in-vatp-have-vat-slt = yes.
     2763     end.
     2764     else do:
     2765       find first in-vatp_doc-attr no-lock
     2766         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     2767           and in-vatp_doc-attr.attr-code = 'envd':U
     2768         no-error .
     2769       if not available in-vatp_doc-attr then do:
     2770         assign
     2771           in-vatp-have-vat-slt = yes.
     2772       end.
     2773       else do:
     2774            in-vatp-have-vat-slt = no.
     2775       end.
     2776     end.
     2777     assign
     2778      price-cli-with-tax-loc = buf_temp-parts.price-cli
     2779      cli-base-rate          = buf_temp-parts.cli-base-rate.
     2780     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     2781              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     2782     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     2783             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     2784             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     2785             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     2786             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     2787             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     2788             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2789       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2790     assign
     2791       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2792     assign
     2793       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2794       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2795       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2796       transport-cli-loc  = 0
     2797       other-cli-loc      = 0
     2798     .
     2799   ASSIGN
     2800             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2801       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2802   .
     2803         assign
     2804           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2805           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2806           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2807           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2808           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2809           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2810           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2811           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2812           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2813           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2814           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2815           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2816           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2817           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2818           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2819           p-excise-base    = p-excise-base    + 0
     2820           p-excise-rubl    = p-excise-rubl    + 0
     2821         .
     2822       end.
     2823       if p-fact-qnty      = ?
     2824       or p-sum-base       = ?
     2825       or p-sum-rubl       = ?
     2826       or p-vat-base       = ?
     2827       or p-vat-rubl       = ?
     2828       or p-slt-base       = ?
     2829       or p-slt-rubl       = ?
     2830       or p-road-tax-base  = ?
     2831       or p-road-tax-rubl  = ?
     2832       or p-transport-base = ?
     2833       or p-transport-rubl = ?
     2834       or p-other-base     = ?
     2835       or p-other-rubl     = ?
     2836       or p-excise-base    = ?
     2837       or p-excise-rubl    = ?
     2838       then do:
     2839         message
     2840           vss-workfile vss-revision vss-description skip
     2841           vss-include-info22 skip
     2842           "Программа in-vatp.i вернула неопределенные значения" skip
     2843           "p-fact-qnty"      p-fact-qnty      skip
     2844           "p-sum-base"       p-sum-base       skip
     2845           "p-sum-rubl"       p-sum-rubl       skip
     2846           "p-vat-base"       p-vat-base       skip
     2847           "p-vat-rubl"       p-vat-rubl       skip
     2848           "p-slt-base"       p-slt-base       skip
     2849           "p-slt-rubl"       p-slt-rubl       skip
     2850           "p-road-tax-base"  p-road-tax-base  skip
     2851           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2852           "p-transport-base" p-transport-base skip
     2853           "p-transport-rubl" p-transport-rubl skip
     2854           "p-other-base"     p-other-base     skip
     2855           "p-other-rubl"     p-other-rubl     skip
     2856           "p-excise-base"    p-excise-base    skip
     2857           "p-excise-rubl"    p-excise-rubl    skip
     2858           view-as alert-box error .
     2859         undo, return error .
     2860       end.
     2861     end.
     2862   end procedure.
     2863   define variable vss-include-info29 as character format "X(65)" no-undo
     2864   initial "@(#)$Workfile$ $Revision$".
     2865   procedure grplib-get-full-name :
     2866      define input parameter p-node-code  as integer      no-undo.
     2867      define output parameter p-full-name as character    no-undo.
     2868      do
     2869   on error undo, return error
     2870   :
     2871       define variable v-upper-code    as integer           no-undo.
     2872       define buffer buf_gds-grp       for ub.gds-grp.
     2873       define buffer buf_upper_gds-grp for ub.gds-grp.
     2874       find first buf_gds-grp no-lock
     2875            where buf_gds-grp.node-code = p-node-code
     2876       no-error.
     2877       if not available buf_gds-grp
     2878       then do:
     2879           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2880       end.
     2881       assign
     2882           p-full-name  = ""
     2883           v-upper-code = 1
     2884       .
     2885       do while buf_gds-grp.upper-code <> 0
     2886       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2887       :
     2888           assign
     2889               p-full-name  = buf_gds-grp.node-name
     2890                            + (if p-full-name <> "" then chr(47) else "")
     2891                            + p-full-name
     2892               v-upper-code = buf_gds-grp.upper-code
     2893           .
     2894           find first buf_gds-grp no-lock
     2895                where buf_gds-grp.node-code = v-upper-code
     2896           no-error.
     2897           if not available buf_gds-grp
     2898           then do:
     2899               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2900                                   + string( v-upper-code )
     2901                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2902           end.
     2903       end.
     2904       assign
     2905       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2906       .
     2907   end.
     2908   end .
     2909   procedure grplib-get-node-from-full-name :
     2910   define input parameter p-full-name as character no-undo .
     2911   define output parameter p-node-code as integer no-undo .
     2912   define variable v-ii as integer no-undo .
     2913   define variable v-upper-code as integer no-undo .
     2914   define variable v-root-code as integer no-undo .
     2915   define variable v-entry as character no-undo .
     2916   define buffer buf_gds-grp       for ub.gds-grp.
     2917   do
     2918   on error undo, return error
     2919   :
     2920     find first buf_gds-grp no-lock
     2921         where buf_gds-grp.upper-code = 0
     2922     no-error .
     2923     if not available buf_gds-grp
     2924     then do:
     2925         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2926     end.
     2927     else do:
     2928       assign
     2929       v-root-code = buf_gds-grp.node-code
     2930       .
     2931     end.
     2932     v-upper-code = v-root-code.
     2933     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2934       assign
     2935       v-entry = entry(v-ii, p-full-name, chr(47)).
     2936       if v-entry = '' then leave.
     2937       find first buf_gds-grp no-lock where
     2938                 buf_gds-grp.node-name = v-entry
     2939             and buf_gds-grp.upper-code = v-upper-code
     2940             no-error.
     2941       if not available buf_gds-grp then do:
     2942         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2943       end.
     2944       else do:
     2945         p-node-code = buf_gds-grp.node-code.
     2946         v-upper-code = buf_gds-grp.node-code.
     2947       end.
     2948     end.
     2949   end.
     2950   end .
     2951   do
     2952   on error undo, return error
     2953   :
     2954     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
     2955     ASSIGN parParentProc =  my-handle .
     2956     define variable g#report-num as integer   no-undo .
     2957     run get-report-num  in parParentProc ( output g#report-num ).
     2958     define variable g#gds-engl as logical   no-undo .
     2959     run get-gds-engl  in parParentProc ( output g#gds-engl ).
     2960     define variable  v-file-name as character no-undo .
     2961     define Stream macr_excel.
     2962     define var    v-fact-order-start     as decimal   no-undo .
     2963     define var    v-fact-order-end       as decimal   no-undo .
     2964     run day-begin-fact-order in this-procedure ( input x-date-start, output v-fact-order-start ).
     2965     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),   output v-fact-order-end ).
     2966     define temp-table temp-goods no-undo
     2967       field artic     like goods.artic
     2968       field prod-code like goods.prod-code
     2969       field prod-type like goods.prod-type
     2970       field gds-name  like goods.gds-name
     2971       field grp-name  like goods.grp-name
     2972       field cli-code  like trn-doc.cli-code
     2973       field cli-type  like trn-doc.cli-type
     2974       field nat       like goods.nationality
     2975       field part-code like parts.part-code
     2976       field in-code   like parts.in-code
     2977       field gtd-code  like parts.cst-code
     2978       field p-ost         as decimal
     2979       field p-prih        as decimal
     2980       field p-sum1        as decimal
     2981       field p-sum2        as decimal
     2982       field p-prod        as decimal
     2983       field p-vozv        as decimal
     2984       field p-ost-sum     as decimal
     2985       field p-prih-sum    as decimal
     2986       field p-sum1-sum    as decimal
     2987       field p-sum2-sum    as decimal
     2988       field p-prod-sum    as decimal
     2989       field p-vozv-sum    as decimal
     2990       INDEX pi  IS PRIMARY artic  prod-type  prod-code  in-code part-code
     2991       INDEX pi1   grp-name
     2992       INDEX pi2   gtd-code
     2993     .
     2994     define buffer buf_goods      for goods.
     2995     define buffer buf_clients    for clients.
     2996     define buffer buf_trn-doc    for  trn-doc .
     2997     define buffer buf_doc-line   for doc-line.
     2998     define buffer buf_parts      for parts.
     2999     define buffer buf_gds-obj    for gds-obj .
     3000     define variable  Counter1    as integer initial 0  no-undo .
     3001     define variable  ii          as integer   no-undo .
     3002     define variable  CurrGrpName as character no-undo .
     3003     define variable  Line        as character no-undo .
     3004     define variable  v-row       as integer   no-undo .
     3005     define variable  v-col       as integer   no-undo .
     3006     define variable  v-ind       as integer   no-undo initial 1 .
     3007     define variable  str         as character no-undo .
     3008     define variable  is-new      as logical   no-undo .
     3009     define variable  new-grp     as logical   no-undo .
     3010   define variable v-account as integer init 0 no-undo .
     3011   define variable v-account-lavel as character no-undo .
     3012   define variable v-button-stop as logical no-undo .
     3013   define variable v-kol-spice as integer no-undo .
     3014   define variable v-kol-spice2 as integer no-undo .
     3015   define variable v-kol-spice3 as integer no-undo .
     3016   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3017   DEFINE BUTTON StopBtn AUTO-END-KEY
     3018        LABEL "Стоп"
     3019        SIZE 10 BY 1.
     3020   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3021        LABEL "Обработано записей"
     3022         VIEW-AS TEXT
     3023        SIZE 14 BY .67 NO-UNDO.
     3024   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3025         VIEW-AS TEXT
     3026        SIZE 53.25 BY .67
     3027        FGCOLOR 1  NO-UNDO.
     3028   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3029         VIEW-AS TEXT
     3030        SIZE 53.25 BY .67
     3031        FGCOLOR 1  NO-UNDO.
     3032   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3033         VIEW-AS TEXT
     3034        SIZE 53.25 BY .67
     3035        FGCOLOR 1  NO-UNDO.
     3036   DEFINE RECTANGLE RECT-1
     3037        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3038        SIZE 55.13 BY 4.46.
     3039   DEFINE FRAME InfoFrame
     3040        StopBtn AT ROW 4.25 COL 21.75
     3041        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3042        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3043        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3044        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3045        RECT-1 AT ROW 1 COL 1
     3046       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3047            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3048            TITLE "Процесс"
     3049            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3050   define variable mFrameView      as logical   no-undo init yes.
     3051     define variable mFramHandle as handle no-undo.
     3052     mFramHandle = frame InfoFrame:handle.
     3053     if  log-manager:logfile-name ne ?
     3054     then DO:
     3055         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3056         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3057         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3058     end.
     3059     mFrameView = not session:batch-mode and mFramHandle:visible.
     3060     if mFrameView
     3061     then do:
     3062       ASSIGN
     3063          FRAME InfoFrame:HIDDEN                           = TRUE
     3064          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3065     end.
     3066   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3067   DO:
     3068     IF not StopProcessing THEN
     3069       Message "Вы действительно хотите прервать" SKIP
     3070               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3071                 UPDATE StopProcessing.
     3072     IF StopProcessing THEN do:
     3073        if mFrameView
     3074        then do:
     3075           HIDE FRAME InfoFrame.
     3076        end.
     3077     End.
     3078   END.
     3079   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     3080     if  log-manager:logfile-name ne ?
     3081     then DO:
     3082         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3083     end.
     3084     if not session:batch-mode then
     3085     do:
     3086       VIEW FRAME InfoFrame.
     3087       mFrameView = true.
     3088     end.
     3089      v-button-stop = false .
     3090         if mFrameView
     3091         then do:
     3092         if v-button-stop then view STOPBTN in frame InfoFrame.
     3093                          else Hide STOPBTN in frame InfoFrame.
     3094         end.
     3095     if x-SelectGood = 1 then do:
     3096       for each obj-list ,
     3097         each  buf_gds-obj no-lock
     3098         where buf_gds-obj.obj-type  = obj-list.obj-type
     3099           and buf_gds-obj.obj-code  = obj-list.obj-code
     3100         :
     3101   define variable vss-include-info30 as character format "X(65)" no-undo
     3102   initial "@(#)$Workfile$ $Revision$".
     3103     assign Counter1 = Counter1 + 1.
     3104   IF ( Counter1 modulo v-account = 0 )  then DO:
     3105             if  log-manager:logfile-name ne ?
     3106             then DO:
     3107                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3108             end.
     3109              if mFrameView
     3110              then do:
     3111               DISPLAY
     3112                 Counter1 @ RecordsDone
     3113                 WITH FRAME InfoFrame.
     3114              end.
     3115   End.
     3116      if v-button-stop then  DO:
     3117            if mFrameView
     3118            then
     3119               PROCESS EVENTS.
     3120            IF StopProcessing THEN DO:
     3121            RETURN error.
     3122            End.
     3123      end.
     3124     run partslib-init-temp-parts-by-factord (input buf_gds-obj.obj-type,
     3125                                              input buf_gds-obj.obj-code,
     3126                                              input buf_gds-obj.artic,
     3127                                              input buf_gds-obj.prod-type,
     3128                                              input buf_gds-obj.prod-code,
     3129                                              input v-fact-order-end,
     3130                                              false) .
     3131     assign is-new = no .
     3132     for each temp-parts :
     3133       find first temp-goods
     3134         where temp-goods.artic     = temp-parts.artic
     3135           and temp-goods.prod-code = temp-parts.prod-code
     3136           and temp-goods.prod-type = temp-parts.prod-type
     3137           and temp-goods.part-code = temp-parts.part-code
     3138           and temp-goods.in-code   = temp-parts.in-code
     3139         no-error .
     3140       if not available temp-goods then do:
     3141         if is-new = no then do:
     3142           assign is-new = yes .
     3143           find first buf_goods no-lock where buf_goods.gds-code = buf_gds-obj.gds-code .
     3144         end.
     3145         create temp-goods .
     3146         assign
     3147           temp-goods.artic     = buf_gds-obj.artic
     3148           temp-goods.prod-code = buf_gds-obj.prod-code
     3149           temp-goods.prod-type = buf_gds-obj.prod-type
     3150           temp-goods.grp-name  = buf_goods.grp-name
     3151           temp-goods.part-code = temp-parts.part-code
     3152           temp-goods.in-code   = temp-parts.in-code
     3153           temp-goods.gtd-code  = temp-parts.cst-code
     3154         .
     3155         if g#gds-engl then assign temp-goods.gds-name = buf_goods.engl-name.
     3156         else               assign temp-goods.gds-name = buf_goods.gds-name.
     3157       end.
     3158     end.
     3159     run partslib-init-temp-parts-by-factord (input buf_gds-obj.obj-type,
     3160                                              input buf_gds-obj.obj-code,
     3161                                              input buf_gds-obj.artic,
     3162                                              input buf_gds-obj.prod-type,
     3163                                              input buf_gds-obj.prod-code,
     3164                                              input v-fact-order-start,
     3165                                              false) .
     3166     for each temp-parts :
     3167       find first temp-goods
     3168         where temp-goods.artic     = temp-parts.artic
     3169           and temp-goods.prod-code = temp-parts.prod-code
     3170           and temp-goods.prod-type = temp-parts.prod-type
     3171           and temp-goods.part-code = temp-parts.part-code
     3172           and temp-goods.in-code   = temp-parts.in-code
     3173         no-error .
     3174       if available temp-goods then do:
     3175         assign
     3176           temp-goods.p-ost     = temp-parts.fact-qnty
     3177           temp-goods.p-ost-sum = (if var-report-r-b = "rubl" then temp-parts.price-rubl else temp-parts.price-base) * temp-parts.fact-qnty
     3178         .
     3179       end.
     3180       else do:
