      227   procedure prn-lib-reportviewer :
      228     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      229     define input parameter p-report-name-html as character no-undo .
      230     define input parameter p-param        as character no-undo .
      231     define variable v-excel           as character no-undo init 'TRUE' .
      232     define variable v-value-character as character no-undo .
      233     define variable v-value-integer   as character no-undo .
      234     define variable v-value-date      as date      no-undo .
      235     define variable v-value-decimal   as decimal   no-undo .
      236     define variable rep-excel         as logical   no-undo .
      237     define variable excel-string      as character no-undo .
      238     define variable v-param-type      as character no-undo .
      239     define variable v-tth             as handle    no-undo .
      240     run adm/shattri.p (
      241       input "get":U
      242       ,input  ""
      243       ,input  0
      244       ,input  'report-glob':U
      245       ,input  'rep-excel':U
      246       ,output v-value-character
      247       ,output v-value-date
      248       ,output v-value-decimal
      249       ,output v-value-integer
      250       ,output rep-excel
      251       ,output v-param-type
      252       ,INPUT-OUTPUT table-handle v-tth
      253       )  .
      254     if rep-excel then v-excel = "TRUE" .
      255     else v-excel = "FALSE" .
