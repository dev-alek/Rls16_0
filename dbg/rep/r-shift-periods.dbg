       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define  stream PrnLibStream.
       84   procedure prn-lib-prn-file :
       85     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       86     define input parameter p-DIsabledoptions as integer no-undo .
       87     define variable v-report-name as character no-undo .
       88     define variable v-user-action as character no-undo .
       89     define variable v-printed     as logical   no-undo .
       90     define variable v-exist       as logical   no-undo .
       91     do
       92       on error undo, return error
       93       :
