      261     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      262   end procedure.
      263   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      264   procedure cur-time :
      265      define output parameter p-today as date      no-undo .
      266      define output parameter p-time  as integer   no-undo .
      267     do
      268     on error undo, return error
      269     :
      270       define variable v-date1 as date      no-undo .
      271       define variable v-date2 as date      no-undo .
      272       define variable v-time  as integer   no-undo .
      273       assign
      274         v-date1 = today
      275         v-time  = time
      276         v-date2 = today
      277       .
      278       if v-date1 <> v-date2
      279       then do:
      280         assign
      281           v-date1 = today
      282           v-time  = v-time
      283         .
      284       end.
      285       assign
      286         p-today = v-date1
      287         p-time  = v-time
      288       .
      289     end.
      290   end.
      291   function cur-time-date returns character
      292   :
      293     return string(today, '99/99/9999':U) .
      294   end.
      295   function cur-time-mjd returns decimal
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return integer(v-date) - 2400002 + (v-time / 86400) .
      304   end.
      305   function cur-time-get-ending-index returns integer
      306   (input p-number as integer
      307   )
      308   :
      309     if p-number < 0
      310     or p-number = ?
      311     then do:
      312       return 1 .
      313     end.
      314     define variable v-rest as integer   no-undo .
      315     assign
      316       p-number = p-number modulo 100
      317     .
      318     if p-number < 20
      319     then do:
      320       assign
      321         v-rest = p-number
      322       .
      323     end.
      324     else do:
      325       assign
      326         v-rest = p-number modulo 10
      327       .
      328     end.
      329     case v-rest :
      330       when 1
      331       then do:
      332         return 2 .
      333       end.
      334       when 2 or
      335       when 3 or
      336       when 4
      337       then do:
      338         return 3 .
      339       end.
      340       otherwise do:
      341         return 1 .
      342       end.
      343     end case .
      344   end.
      345   procedure cur-time-mjd-to-date :
      346      define input  parameter i-mjd-diff as decimal no-undo.
      347      define output parameter o-Date     as date    no-undo.
      348      define output parameter o-Time     as integer no-undo.
      349      define variable v-day-number as integer   no-undo .
      350      if    i-mjd-diff < 0
      351         or i-mjd-diff = ?
      352      then do:
      353         return "?" .
      354      end.
      355      assign
      356         v-day-number = truncate(i-mjd-diff,0).
      357         o-Date = date(v-day-number + 2400002).
      358         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      359     .
      360   end.
      361   function cur-time-mjd-to-string returns character
      362   (input p-mjd-diff as decimal
      363   )
      364   :
      365     define variable v-day-number as integer   no-undo .
      366     define variable v-seconds    as integer   no-undo .
      367     define variable v-hour       as integer   no-undo .
      368     define variable v-min        as integer   no-undo .
      369     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      370     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      371     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      372     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      373     if p-mjd-diff < 0
      374     or p-mjd-diff = ?
      375     then do:
      376       return "?" .
      377     end.
      378     assign
      379       v-day-number = integer(truncate(p-mjd-diff,0))
      380       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      381     .
      382     if v-seconds > 86400
      383     then do:
      384       assign
      385         v-seconds = 86400 - 1
      386       .
      387     end.
      388     if v-seconds < 0
      389     then do:
      390       assign
      391         v-seconds = 0
      392       .
      393     end.
      394     assign
      395       v-hour = truncate(v-seconds / 3600, 0)
      396     .
      397     assign
      398       v-seconds = v-seconds modulo 3600
      399     .
      400     assign
      401       v-min = truncate(v-seconds / 60, 0)
      402     .
      403     assign
      404       v-seconds = v-seconds modulo 60
      405     .
      406     return
      407         (if v-day-number <> 0
      408           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      409           else ""
      410         )
      411       + (if v-day-number <> 0 or v-hour <> 0
      412           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      413           else ""
      414         )
      415       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      416           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      417           else ""
      418         )
      419       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      420       .
      421   end.
      422   function cur-time-string returns character
      423   :
      424     define variable v-date as date      no-undo .
      425     define variable v-time as integer   no-undo .
      426     run cur-time in this-procedure
      427       (output v-date
      428       ,output v-time
      429       ) .
      430     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      431   end.
      432   function cur-time-string-sec returns character
      433   :
      434     define variable v-date as date      no-undo .
      435     define variable v-time as integer   no-undo .
      436     run cur-time in this-procedure
      437       (output v-date
      438       ,output v-time
      439       ) .
      440     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      441   end.
      442   function cur-time-custom  returns character
      443   (input p-prefix as character
      444   ,input p-date-format as character
      445   ,input p-delimiter as character
      446   ,input p-time-format as character
      447   ,input p-suffix as character
      448   )
      449   :
      450     define variable v-date as date      no-undo .
      451     define variable v-time as integer   no-undo .
      452     run cur-time in this-procedure
      453       (output v-date
      454       ,output v-time
      455       ) .
      456     return
      457       p-prefix
      458       + string(v-date, p-date-format)
      459       + p-delimiter
      460       + string(v-time, p-time-format)
      461       + p-suffix
      462       .
      463   end.
      464   function cur-time-print  returns character
      465   :
      466     define variable v-date as date      no-undo .
      467     define variable v-time as integer   no-undo .
      468     run cur-time in this-procedure
      469       (output v-date
      470       ,output v-time
      471       ) .
      472     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      473   end.
      474   function cur-time-datetime returns datetime
      475   :
      476     define variable v-char as character no-undo .
      477     define variable v-datetime as datetime no-undo .
      478     v-char = cur-time-string().
      479     v-datetime = datetime(v-char).
      480     return  v-datetime.
      481   end.
      482   function cur-time-string-msec returns character
      483   :
      484     define variable v-date as datetime  no-undo .
      485     v-date = now.
      486     return string(v-date) .
      487   end.
      488   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      489     define variable v-cntxt-db-num        as integer   no-undo .
      490     define variable v-cntxt-userid        as character no-undo .
      491     define variable v-cntxt-level         as character no-undo .
      492     define variable v-cntxt-host-code-obj as integer   no-undo .
      493     define variable v-cntxt-obj-type      as character no-undo .
      494     define variable v-cntxt-obj-code      as integer   no-undo .
      495     define variable v-cntxt-db-num-obj    as integer   no-undo .
      496     define variable v-cntxt-is-admin      as logical   no-undo .
      497   define temp-table tt-shift-pl-gds no-undo
      498     field num as integer
      499     field shift-date like ub.shift-period.shift-date
      500     field shift-num like ub.shift-period.shift-num
      501     field shift-name like ub.shift-obj.shift-name
