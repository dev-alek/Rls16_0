      507   .
      508   define temp-table tt-result no-undo
      509     field shift-date like ub.shift-period.shift-date
      510     field shift-num like ub.shift-period.shift-num
      511     field pl-code like ub.shift-period.pl-code
      512     field gds-code like ub.shift-period.gds-code
