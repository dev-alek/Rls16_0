      519   function fDec2Str returns character
      520     (input idec as decimal,
      521      input iformat as char)
      522   :
      523     define variable vdecstr as character no-undo.
      524     if idec = ? then
      525        vdecstr = "".
      526     else
      527        vdecstr = trim(string(idec, iformat)).
      528     return vdecstr.
      529   end function .
      530   define stream sOutStr-html.
      531   define buffer buf_shift-period for ub.shift-period .
      532   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533     run mainmenu_getcntxt in parparentproc
      534       (output v-cntxt-db-num
      535       ,output v-cntxt-userid
      536       ,output v-cntxt-level
      537       ,output v-cntxt-host-code-obj
      538       ,output v-cntxt-obj-type
      539       ,output v-cntxt-obj-code
      540       ,output v-cntxt-db-num-obj
      541       ,output v-cntxt-is-admin
      542       ) .
      543   run fillTT .
      544   run PrintRep .
      545   procedure fillTT :
      546     define variable v-num as integer no-undo init 0 .
      547     for each tt-shift no-lock by tt-shift.shift-date by tt-shift.shift-num :
      548       for each buf_shift-period no-lock where buf_shift-period.shift-date = tt-shift.shift-date
      549                                           and buf_shift-period.shift-num = tt-shift.shift-num
      550       :
      551         find first tt-pl-gds no-lock where tt-pl-gds.pl-code = buf_shift-period.pl-code
      552                                        and tt-pl-gds.gds-code = buf_shift-period.gds-code
      553                                        no-error .
      554         if not available tt-pl-gds
      555         then next .
      556         find first tt-shift-pl-gds where tt-shift-pl-gds.shift-date = buf_shift-period.shift-date
      557                                      and tt-shift-pl-gds.shift-num  = buf_shift-period.shift-num
      558                                      and tt-shift-pl-gds.pl-code    = buf_shift-period.pl-code
      559                                      and tt-shift-pl-gds.gds-code   = buf_shift-period.gds-code
      560                                      no-error .
      561         if not available tt-shift-pl-gds
      562         then do :
      563           create tt-shift-pl-gds .
      564           assign
      565             v-num = v-num + 1
      566             tt-shift-pl-gds.num        = v-num
      567             tt-shift-pl-gds.shift-date = buf_shift-period.shift-date
      568             tt-shift-pl-gds.shift-num  = buf_shift-period.shift-num
      569             tt-shift-pl-gds.shift-name = tt-shift.shift-name
      570             tt-shift-pl-gds.pl-code    = buf_shift-period.pl-code
      571             tt-shift-pl-gds.loc1       = tt-pl-gds.loc1
      572             tt-shift-pl-gds.gds-code   = buf_shift-period.gds-code
      573             tt-shift-pl-gds.gds-name   = tt-pl-gds.gds-name
      574             tt-shift-pl-gds.num-periods = 0
      575           .
      576         end .
      577         assign tt-shift-pl-gds.num-periods = tt-shift-pl-gds.num-periods + 1 .
      578         create tt-result .
      579         assign
      580           tt-result.shift-date      = tt-shift-pl-gds.shift-date
      581           tt-result.shift-num       = tt-shift-pl-gds.shift-num
      582           tt-result.pl-code         = tt-shift-pl-gds.pl-code
      583           tt-result.gds-code        = tt-shift-pl-gds.gds-code
      584           tt-result.period-num      = buf_shift-period.period-num
      585           tt-result.period-name     = buf_shift-period.period-name
      586           tt-result.sales-density15 = buf_shift-period.sales-density15
      587           tt-result.control-density = buf_shift-period.control-density
      588           tt-result.delta-density   = buf_shift-period.delta-density
      589         .
      590       end .
      591     end .
      592   end procedure .
      593   procedure PrintRep :
      594     define variable vReportId     as character no-undo.
      595     define variable vFileNameRep  as character no-undo.
      596     define variable vStr          as character no-undo.
      597     define variable vI            as integer   no-undo.
      598     define variable v-period      as character no-undo .
      599     define variable v-firm-name   as character no-undo .
      600     define variable v-obj-name    as character no-undo .
      601     define variable v-print-date  as character no-undo .
      602     define variable v-today as date    no-undo .
      603     define variable v-time  as integer no-undo .
      604     define buffer buf_clients for ub.clients .
      605     do on error undo, return error return-value:
      606       run get-report-num(output vReportId).
      607       vFileNameRep = session:temp-directory + string(vReportId) + ".html".
      608       v-period = "Смены: " .
      609       for each tt-shift by tt-shift.shift-date by tt-shift.shift-num :
      610         v-period = v-period + string(tt-shift.shift-num) + " (" + tt-shift.shift-name + ") от " + string(tt-shift.shift-date, "99.99.9999") + ", " .
      611       end .
      612       v-period = trim(v-period, ", ") .
      613       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U
      614                                        and buf_clients.obj-code = v-cntxt-host-code-obj
      615                                        no-error .
      616       if available buf_clients
      617       then do :
      618         v-firm-name = buf_clients.obj-name .
      619       end .
      620       find first buf_clients no-lock where buf_clients.obj-type = v-cntxt-obj-type
      621                                        and buf_clients.obj-code = v-cntxt-obj-code
      622                                        no-error .
      623       if available buf_clients
      624       then do :
      625         v-obj-name = "Выбор объекта: " + buf_clients.obj-name .
      626       end .
      627       run cur-time in this-procedure (
      628         output v-today
      629         , output v-time
      630         ).
      631       v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
      632       output stream sOutStr-html to value(vFileNameRep) convert target 'UTF-8'.
      633       put stream sOutStr-html unformatted
      634   "<!DOCTYPE HTML>" skip
      635   ' <html>' skip
      636   '  <head>' skip
      637   '   <meta charset="utf-8">' skip
      638   '    <style type="text/css">' skip
      639   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      640   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      641   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
      642   '   </style>' skip
      643   '  </head>' skip
      644       .
      645       put stream sOutStr-html unformatted
      646         '<body>' skip
      647         '<TABLE name="1" outline_below="true" fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">' skip
      648         '<thead>' skip
      649         '<TR class="set_columns">' skip
      650           '<TD style="width:  70px;"></TD>' skip
      651           '<TD style="width:  70px;"></TD>' skip
      652           '<TD style="width:  70px;"></TD>' skip
      653           '<TD style="width:  90px;"></TD>' skip
      654           '<TD style="width:  80px;"></TD>' skip
      655           '<TD style="width: 180px;"></TD>' skip
      656           '<TD style="width: 140px;"></TD>' skip
      657           '<TD style="width: 140px;"></TD>' skip
      658           '<TD style="width: 140px;"></TD>' skip
      659         '</TR>' skip
      660       .
      661       put stream sOutStr-html unformatted
      662         '<TR>' skip
      663           '<TD colspan="9" style="font-weight: bold;">' + 'Отчёт Контроль плотности НП' + '</TD>'skip
      664         '</TR>' skip
      665         '<TR>' skip
      666           '<TD colspan="9" style="font-weight: bold;">' + v-period + '</TD>'skip
      667         '</TR>' skip
      668         '<TR>' skip
      669           '<TD colspan="9" style="font-weight: bold;">' + v-firm-name + '</TD>'skip
      670         '</TR>' skip
      671         '<TR>' skip
      672           '<TD colspan="9" style="font-weight: bold;">' + v-obj-name + '</TD>'skip
      673         '</TR>' skip
      674         '<TR>' skip
      675           '<TD colspan="9" style="font-weight: bold;">' + v-print-date + '</TD>'skip
      676         '</TR>' skip
      677         '<TR>' skip
      678           '<TD colspan="9">&nbsp;</TD>' skip
      679         '</TR>' skip
      680       .
      681       put stream sOutStr-html unformatted
      682         '<TR>' skip
      683           '<TD colspan="9" style="font-weight: bold;">' + 'Примечания к отчёту:' + '</TD>'skip
      684         '</TR>' skip
      685         '<TR>' skip
      686           '<TD colspan="9">' + 'В отчет выводятся отклонения плотности НП за период по каждому резервуару НП.' + '</TD>' skip
      687         '</TR>'skip
      688         '<TR>' skip
      689           '<TD colspan="9">' + 'Отклонение рассчитывается при сравнении значения P_реализ15 с P_контр.' + '</TD>' skip
      690         '</TR>'skip
      691         '<TR>' skip
      692           '<TD colspan="9">' + 'Расхождение значения по плотности НП не должно превышать 1,7 кг/м3 между значением P_реализ15 по сравнению с P_контр.' + '</TD>' skip
      693         '</TR>'skip
      694         '<TR>' skip
      695           '<TD colspan="9">' + 'Расхождение значения по плотности НП 1,7 кг/м3 для отчета конвертировано в 0,0017 г/см3.' + '</TD>' skip
      696         '</TR>'skip
      697         '<TR>' skip
      698           '<TD colspan="9">' + 'Чеки, сформированные во время прихода НП, не учитываются ни в одном из периодов.' + '</TD>' skip
      699         '</TR>'skip
      700         '<TR>' skip
      701           '<TD colspan="9">' + 'Для сообщающихся резервуаров НП в отчет выводится только «Главный» резервуар.' + '</TD>' skip
      702         '</TR>'skip
      703         '<TR>' skip
      704           '<TD colspan="9">' + 'При учете чеков реализации НП задним числом (включение в закрытую смену), данные этих чеков не оказывают влияние на расчет значений НП по периодам и формирование отчета.' + '</TD>' skip
      705         '</TR>'skip
      706         '<TR>' skip
      707           '<TD colspan="9">&nbsp;</TD>' skip
      708         '</TR>'skip
      709         '<TR>' skip
      710           '<TD colspan="9">' + 'P_реализ15 - плотность реализации НП, приведенная к 15 С, за период в представленной смене.' + '</TD>' skip
      711         '</TR>'skip
      712         '<TR>' skip
      713           '<TD colspan="9">' + 'P_контр - контрольная плотность НП в резервуаре за период в представленной смене.' + '</TD>' skip
      714         '</TR>'skip
      715         '<TR>' skip
      716           '<TD colspan="9">&nbsp;</TD>' skip
      717         '</TR>'skip
      718         '</thead>' skip
      719       .
      720       put stream sOutStr-html unformatted
      721         '<tbody>' skip
      722         '<TR>' skip
      723         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">№ п/п</TH>' skip
      724         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Дата смены</TH>' skip
      725         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Порядок и номер смены</TH>' skip
      726         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">№ Резервуара</TH>' skip
      727         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Наименование топлива</TH>' skip
      728         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Период в смене</TH>' skip
      729         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Плотность реализации НП за период, г/см3 (приведенная к 15 С)</TH>' skip
      730         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Контрольная плотность НП за период, г/см3 (приведенная к 15 С)</TH>' skip
      731         '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Отклонение по плотности НП за период, г/см3 (1.9 = 1.7 – 1.8)</TH>' skip
      732         '</TR>' skip
      733         '<TR >'skip
      734         '</TR>'skip
      735         '<TR >'skip
      736         '</TR>'skip
      737         '<TR >'skip
      738         '</TR>'skip
      739         '<TR >'skip
      740         '</TR>'skip
      741         '<TR >'skip
      742         '<TH style="text-align: center; font-weight:bold; ">1.1</TH>'   skip
      743         '<TH style="text-align: center; font-weight:bold; ">1.2</TH>'   skip
      744         '<TH style="text-align: center; font-weight:bold; ">1.3</TH>'   skip
      745         '<TH style="text-align: center; font-weight:bold; ">1.4</TH>'   skip
      746         '<TH style="text-align: center; font-weight:bold; ">1.5</TH>'   skip
      747         '<TH style="text-align: center; font-weight:bold; ">1.6</TH>'   skip
      748         '<TH style="text-align: center; font-weight:bold; ">1.7</TH>'   skip
      749         '<TH style="text-align: center; font-weight:bold; ">1.8</TH>'   skip
      750         '<TH style="text-align: center; font-weight:bold; ">1.9</TH>'   skip
      751         '</TR>'skip
      752       .
      753       for each tt-shift-pl-gds by tt-shift-pl-gds.num :
      754         put stream sOutStr-html unformatted
      755           '<TR>' skip
      756           '<TD text_wrap="true" rowspan="' + string(tt-shift-pl-gds.num-periods) + '" style="text-align: center;">' + string(tt-shift-pl-gds.num) + '</TD>' skip
      757           '<TD text_wrap="true" rowspan="' + string(tt-shift-pl-gds.num-periods) + '" style="text-align: center;">' + string(tt-shift-pl-gds.shift-date, "99.99.9999") + '</TD>' skip
      758           '<TD text_wrap="true" rowspan="' + string(tt-shift-pl-gds.num-periods) + '" style="text-align: center;">' + string(tt-shift-pl-gds.shift-num) + " (" + tt-shift-pl-gds.shift-name + ")" + '</TD>' skip
      759           '<TD text_wrap="true" rowspan="' + string(tt-shift-pl-gds.num-periods) + '" style="text-align: center;">' + string(tt-shift-pl-gds.loc1) + '</TD>' skip
      760           '<TD text_wrap="true" rowspan="' + string(tt-shift-pl-gds.num-periods) + '" style="text-align: center;">' + string(tt-shift-pl-gds.gds-name) + '</TD>' skip
      761         .
      762         for each tt-result where tt-result.shift-date = tt-shift-pl-gds.shift-date
      763                              and tt-result.shift-num  = tt-shift-pl-gds.shift-num
      764                              and tt-result.pl-code    = tt-shift-pl-gds.pl-code
      765                              and tt-result.gds-code   = tt-shift-pl-gds.gds-code
      766                              break by tt-result.pl-code by tt-result.gds-code
      767                              by tt-result.period-num
      768         :
      769           if not (first-of(tt-result.pl-code) and first-of(tt-result.gds-code))
      770           then do :
      771             put stream sOutStr-html unformatted
      772               '<TR>' skip
      773             .
      774           end .
      775           put stream sOutStr-html unformatted
      776             '<TD text_wrap="true" style="text-align: center;">' + string(tt-result.period-name) + '</TD>' skip
      777             '<TD num="#,####0.0000" val="' + fDec2Str(tt-result.sales-density15, "-9.9999") + '" text_wrap="true" style="text-align: center;">' + fDec2Str(tt-result.sales-density15, "-9.9999") + '</TD>' skip
      778             '<TD num="#,####0.0000" val="' + fDec2Str(tt-result.control-density, "-9.9999") + '" text_wrap="true" style="text-align: center;">' + fDec2Str(tt-result.control-density, "-9.9999") + '</TD>' skip
      779             '<TD num="#,####0.0000" val="' + fDec2Str(tt-result.delta-density, "-9.9999") + '" text_wrap="true" style="text-align: center; color: ' + (if abs(tt-result.delta-density) > 0.0017 then "red" else "black") + ';">' + fDec2Str(tt-result.delta-density, "-9.9999") + '</TD>' skip
      780             '</TR>' skip.
      781           .
      782         end .
      783       end .
      784       put stream sOutStr-html unformatted
      785         '</tbody>' skip
      786         '</table>' skip
      787         '</body>' skip
      788         '</html>' skip
      789       .
      790       output stream sOutStr-html close.
      791       run prn-lib-reportviewer-report-name in this-procedure (
      792       input THIS-PROCEDURE
      793       ,input vFileNameRep
      794       ).
      795     end .
      796   end procedure .
      797   procedure get-report-num :
      798     define output parameter p-report-num as integer no-undo .
      799     do
      800       on error undo, return error return-value
      801       :
      802       run gbl/getrpnum.p (output p-report-num).
      803     end.
      804   end procedure .
