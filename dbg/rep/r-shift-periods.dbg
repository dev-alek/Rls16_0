      129   procedure prn-lib-open-stream :
      130     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      131     define input parameter p-page-size    as integer no-undo .
      132     define input parameter p-is-stream    as logical no-undo .
      133     define input parameter p-append       as logical no-undo .
      134     define variable v-report-name as character no-undo .
      135     do
      136       on error undo, return error
      137       :
      138       run prn-lib-get-report-name  in this-procedure (
      139         input parParentProc
      140         ,output v-report-name
      141         ).
      142       if p-is-stream then
      143       do:
      144         if p-append then
      145         do:
      146           output stream PrnLibStream to value( v-report-name )
      147             page-size value(p-page-size) append .
      148         end.
      149         if not p-append then
      150         do:
      151           output stream PrnLibStream to value( v-report-name )
      152             page-size value(p-page-size) .
      153         end.
      154       end.
      155       if not p-is-stream then
      156       do:
      157         if p-append then
      158         do:
      159           output to value( v-report-name )
      160             page-size value(p-page-size) append .
      161         end.
      162         if not p-append then
      163         do:
      164           output to value( v-report-name )
      165             page-size value(p-page-size) .
      166         end.
      167       end.
      168     end.
      169   end procedure.
      170   procedure prn-lib-open-exp :
      171     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      172     define input parameter p-is-stream    as logical no-undo .
      173     define input parameter p-is-append    as logical no-undo .
      174     define output parameter p-ReportFileName as char init "report" no-undo.
      175     define output parameter p-process as logical no-undo .
      176     define variable glog as logical no-undo .
      177     do
      178       on error undo, return error
      179       :
      180       SYSTEM-DIALOG GET-FILE p-ReportFileName
      181         TITLE      "Укажите путь"
      182         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      183         ASK-OVERWRITE
      184         CREATE-TEST-FILE
      185         SAVE-AS
      186         USE-FILENAME
      187         DEFAULT-EXTENSION "txt"
      188         UPDATE glog
      189         .
      190       if not glog then  return.
      191       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      192       if p-is-stream then
      193       do:
      194         if p-is-append then
      195         do:
      196           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      197         end.
      198         else
      199         do:
      200           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      201         end.
      202       end.
      203       else
      204       do:
      205         if p-is-append then
      206         do:
      207           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      208         end.
      209         else
      210         do:
      211           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      212         end.
      213       end.
      214       p-process = yes.
      215     end.
      216   end procedure.
