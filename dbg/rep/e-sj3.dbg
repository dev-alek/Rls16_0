      775   procedure prn-lib-prn-file :
      776     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      777     define input parameter p-DIsabledoptions as integer no-undo .
      778     define variable v-report-name as character no-undo .
      779     define variable v-user-action as character no-undo .
      780     define variable v-printed     as logical   no-undo .
      781     define variable v-exist       as logical   no-undo .
      782     do
      783       on error undo, return error
      784       :
      785       run prn-lib-get-report-name  in this-procedure (
      786         input parParentProc
      787         ,output v-report-name
      788         ).
      789   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      791     (input  v-report-name
      792     ,input  2
      793     ,output v-exist
      794     )  .
      795       if NOT v-exist then
      796       DO:
      797         Message
      798           "Нет заданий на печать ! "
      799           view-as alert-box .
      800         Return  .
      801       End.
      802       run gbl/prnfilen.w
      803         (input  ""
      804         ,input  p-DisabledOptions
      805         ,input  string(v-report-name )
      806         ,input  7
      807         ,output v-user-action
      808         ,output v-printed
      809         ) .
      810       if v-printed then
      811       do:
      812         return "YES" .
      813       end.
      814       else
      815       do:
      816         return "NO" .
      817       end.
      818     end.
      819   end procedure.
      820   procedure prn-lib-open-stream :
      821     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      822     define input parameter p-page-size    as integer no-undo .
      823     define input parameter p-is-stream    as logical no-undo .
      824     define input parameter p-append       as logical no-undo .
      825     define variable v-report-name as character no-undo .
      826     do
      827       on error undo, return error
      828       :
      829       run prn-lib-get-report-name  in this-procedure (
      830         input parParentProc
      831         ,output v-report-name
      832         ).
      833       if p-is-stream then
      834       do:
      835         if p-append then
      836         do:
      837           output stream PrnLibStream to value( v-report-name )
      838             page-size value(p-page-size) append .
      839         end.
      840         if not p-append then
      841         do:
      842           output stream PrnLibStream to value( v-report-name )
      843             page-size value(p-page-size) .
      844         end.
      845       end.
      846       if not p-is-stream then
      847       do:
      848         if p-append then
      849         do:
      850           output to value( v-report-name )
      851             page-size value(p-page-size) append .
      852         end.
      853         if not p-append then
      854         do:
      855           output to value( v-report-name )
      856             page-size value(p-page-size) .
      857         end.
      858       end.
      859     end.
      860   end procedure.
      861   procedure prn-lib-open-exp :
      862     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      863     define input parameter p-is-stream    as logical no-undo .
      864     define input parameter p-is-append    as logical no-undo .
      865     define output parameter p-ReportFileName as char init "report" no-undo.
      866     define output parameter p-process as logical no-undo .
      867     define variable glog as logical no-undo .
      868     do
      869       on error undo, return error
      870       :
      871       SYSTEM-DIALOG GET-FILE p-ReportFileName
      872         TITLE      "Укажите путь"
      873         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      874         ASK-OVERWRITE
      875         CREATE-TEST-FILE
      876         SAVE-AS
      877         USE-FILENAME
      878         DEFAULT-EXTENSION "txt"
      879         UPDATE glog
      880         .
      881       if not glog then  return.
      882       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      883       if p-is-stream then
      884       do:
      885         if p-is-append then
      886         do:
      887           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      888         end.
      889         else
      890         do:
      891           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      892         end.
      893       end.
      894       else
      895       do:
      896         if p-is-append then
      897         do:
      898           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      899         end.
      900         else
      901         do:
      902           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      903         end.
      904       end.
      905       p-process = yes.
      906     end.
      907   end procedure.
      908   procedure prn-lib-get-report-name :
      909     define input parameter parParentProc  as widget-handle no-undo.
      910     define output parameter p-report-name as character no-undo .
      911     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      912   end procedure.
      913   procedure prn-lib-reportviewer-report-name :
      914     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      915     define input parameter p-report-name-html as character no-undo .
      916     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      917   end procedure.
      918   procedure prn-lib-reportviewer :
      919     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      920     define input parameter p-report-name-html as character no-undo .
      921     define input parameter p-param        as character no-undo .
      922     define variable v-excel           as character no-undo init 'TRUE' .
      923     define variable v-value-character as character no-undo .
      924     define variable v-value-integer   as character no-undo .
      925     define variable v-value-date      as date      no-undo .
      926     define variable v-value-decimal   as decimal   no-undo .
      927     define variable rep-excel         as logical   no-undo .
      928     define variable excel-string      as character no-undo .
      929     define variable v-param-type      as character no-undo .
      930     define variable v-tth             as handle    no-undo .
      931     run adm/shattri.p (
      932       input "get":U
      933       ,input  ""
      934       ,input  0
      935       ,input  'report-glob':U
      936       ,input  'rep-excel':U
      937       ,output v-value-character
      938       ,output v-value-date
      939       ,output v-value-decimal
      940       ,output v-value-integer
      941       ,output rep-excel
      942       ,output v-param-type
      943       ,INPUT-OUTPUT table-handle v-tth
      944       )  .
      945     if rep-excel then v-excel = "TRUE" .
      946     else v-excel = "FALSE" .
      947     if p-param eq ""
      948     then
      949        p-param = "EXCEL:" + v-excel.
      950     else
      951        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      952     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      953   end procedure.
