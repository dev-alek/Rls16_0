     1577   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   function breakstr returns character ( input        for-name    as character,
     1579                                         input        line-length as integer,
     1580                                         input-output line1       as character,
     1581                                         input-output line2       as character ) :
     1582     define variable ii as integer no-undo.
     1583     if length( for-name ) > line-length then do:
     1584       assign ii    = 1
     1585              line1 = "":u
     1586              line2 = "":u.
     1587       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
     1588         assign line1 =       substring( for-name, 1, line-length     )
     1589                line2 = trim( substring( for-name,    line-length + 1 ) ).
     1590       end.                                                     else do:
     1591         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
     1592           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
     1593                  ii    = ii    + 1.
     1594           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
     1595             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
     1596           end.
     1597         end.
     1598         assign line2 = trim( substring( for-name, length( line1 ) ) ).
     1599       end.
     1600     end.                                else do:
     1601       assign line1 = for-name
     1602              line2 = "":u.
     1603     end.
     1604     return ( line1 ).
     1605   end function.
     1606   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1607   FUNCTION get-strokes
     1608   RETURNS CHARACTER
     1609     ( buffer loc-sj-goods for sj-goods,
     1610       input name-len as integer,
     1611       input prod-len as integer,
     1612       input-output loc-namebuf1 as char,
     1613       input-output loc-namebuf2 as char,
     1614       input-output loc-prodbuf1 as char,
     1615       input-output loc-prodbuf2 as char) :
     1616       def var for-name as char no-undo.
     1617       if loc-sj-goods.node-name <> ""
     1618       then for-name = loc-sj-goods.name + "\" + loc-sj-goods.node-name.
     1619       else for-name = loc-sj-goods.name.
     1620       loc-namebuf1 = breakstr(for-name,
     1621                                name-len,
     1622                                input-output loc-namebuf1,
     1623                                input-output loc-namebuf2).
     1624       if v-curr-r-b = 'base':U and my-Set_Val_Type = 3 then  do:
     1625         loc-prodbuf1 = breakstr(loc-sj-goods.prod-name,
     1626                                  prod-len,
     1627                                  input-output loc-prodbuf1,
     1628                                  input-output loc-prodbuf2).
     1629       end.
     1630       else do:
     1631         loc-prodbuf1 = breakstr(loc-sj-goods.prod-name,
     1632                                  prod-len,
     1633                                  input-output loc-prodbuf1,
     1634                                  input-output loc-prodbuf2).
     1635       end.
     1636     RETURN loc-namebuf1.
     1637   END FUNCTION.
     1638   run main no-error.
     1639   if error-status:error then return error.
     1640   return.
     1641   Procedure main.
     1642   define variable v-salesman-name as character no-undo .
     1643   define buffer buf_saleman for ub.clients.
     1644   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1645   define variable ii-name as integer no-undo .
     1646   for each sj-grp
     1647   by sj-grp.grp-name:
     1648     ii-name = ii-name + 1.
     1649     assign
     1650     sj-grp.grp-code-alpha  = ii-name
     1651     .
     1652   end.
     1653   for each sj-goods
     1654   break
     1655   by sj-goods.grp-code:
     1656     if first-of(sj-goods.grp-code) then do:
     1657       find first sj-grp no-lock where
     1658                 sj-grp.grp-code = sj-goods.grp-code.
     1659       assign
     1660       ii-name = sj-grp.grp-code-alpha.
     1661     end.
     1662     assign
     1663     sj-goods.grp-name = ii-name
     1664     .
     1665   end.
     1666   for each sj-tots
     1667   break
     1668   by sj-tots.grp-code:
     1669     if first-of(sj-tots.grp-code) then do:
     1670       find first sj-grp no-lock where
     1671                 sj-grp.grp-code = sj-tots.grp-code.
     1672       assign
     1673       ii-name = sj-grp.grp-code-alpha.
     1674     end.
     1675     assign
     1676     sj-tots.grp-name = ii-name
     1677     .
     1678   end.
     1679   PUT STREAM PrnLibStream
     1680   SPACE(25) ( caps( ReportNAme ) + "  " + str1) format "x(110)" SKIP(1)
     1681   space(50) "(Без детализации по скидке)" format "x(30)" skip(0)
     1682   space(35) ( if NotInc
     1683               then "( по ВСЕМ ЧЕКАМ, в т.ч. невошедшим в отчеты о продажах )"
     1684               else " " ) format "x(80)" skip
     1685   SPACE(35) "По объектам : " format "x(15)" .
     1686   FOR EACH obj-list :
     1687       FIND FIRST cli-obj WHERE
     1688                  cli-obj.obj-type = obj-list.obj-type AND
     1689                  cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     1690       PUT STREAM PrnLibStream cli-obj.obj-name format "x(80)" skip space(50) .
     1691       ACCUMULATE ( obj-list.obj-type + string( obj-list.obj-code ) ) ( COUNT ) .
     1692   END.
     1693   ObjsQnty = ACCUM COUNT ( obj-list.obj-type + string( obj-list.obj-code ) ) .
     1694   if ObjsQnty > 1 AND (grouptot_flag OR prodtot_flag)
     1695   then AllObjsTotalsBy = yes.
     1696   if X-SelectGood = 3 then do:
     1697       PUT STREAM PrnLibStream  "По производителям: " skip space(50) .
     1698       FOR EACH g#cli :
     1699           FIND FIRST cli-obj WHERE
     1700                       cli-obj.obj-type = g#cli.obj-type AND
     1701                       cli-obj.obj-code = g#cli.obj-code NO-LOCK .
     1702           PUT STREAM PrnLibStream  cli-obj.obj-name format "x(80)" skip space(50) .
     1703       END.
     1704   end.
     1705   PUT STREAM PrnLibStream
     1706    " " skip
     1707   SPACE(5) cash_string format "x(115)" SKIP
     1708   SPACE(5) sale_string format "x(115)" SKIP
     1709   space(62) string( (if shrs-seller-cashier = "seller"
     1710                      then "Итоги по продавцам      :  "
     1711                      else "Итоги по кассирам       :  " )
     1712                      +
     1713                    ( if SHBySalers then "ДА." else "НЕТ." ) ) format "x(65)" skip
     1714   SPACE(5) string( string("Классификация: " + Rs-by-str , "x(57)" ) +
     1715                               "Сортировка              :  " +   ( if SHRs-by = 2 OR SHRS-by = 0
     1716                                                                               then "НЕТ."
     1717                                                                               else rs-sort-str)
     1718                               ) format "x(125)" skip(1) .
     1719   if v-curr-r-b = 'base':U then do:
     1720     if my-Set_Val_Type = 3 then
     1721     FORM HEADER
     1722     line format "X(196)"
     1723     AT 1 SKIP
     1724     string( "Продолжение - на следующей странице" ) FORMAT "X(35)" AT 30 SKIP
     1725     with FRAME BottomFramebasesj-base-d width  232 PAGE-BOTTOM NO-LABELS NO-BOX .
     1726     VIEW STREAM PrnLibStream FRAME BottomFramebasesj-base-d .
     1727   end.
     1728   else do:
     1729     FORM HEADER
     1730     line format "X(196)"
     1731     AT 1 SKIP
     1732     string( "Продолжение - на следующей странице" ) FORMAT "X(35)" AT 30 SKIP
     1733     with FRAME BottomFramerublsj-base-d width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     1734       VIEW STREAM PrnLibStream FRAME BottomFramerublsj-base-d .
     1735   end.
     1736   CASE my-Set_Val_Type :
     1737     when 2 then
     1738         FORM with FRAME sj-base-d .
     1739     when 3 then
     1740         FORM with FRAME sj-full-d .
     1741   END CASE .
     1742   assign
     1743   p-frame-width = frame sj-base-d:width.
     1744   CASE SHRS-by :
     1745       when 1 OR when 0 then do:
     1746         RUN SimpleProc_d in this-procedure .
     1747       end.
     1748       when 3 then do:
     1749         RUN ProdGrpProc_d in this-procedure .
     1750       end.
     1751       when 2 then do:
     1752         if SHRs-Sort = "Article":U then do:
     1753           FOR EACH sj-goods NO-LOCK ,
     1754               EACH sj-adv No-LOCK WHERE
     1755                     sj-adv.obj-attr = sj-goods.obj-attr AND
     1756                     sj-adv.b-code = sj-goods.b-code AND
     1757                     sj-adv.saleman-chr = sj-goods.saleman-chr
     1758               BREAK
     1759               BY sj-goods.obj-attr
     1760               BY sj-goods.grp-name
     1761               BY sj-goods.prod-name
     1762               BY sj-goods.saleman-chr
     1763               BY sj-goods.artic
     1764               BY sj-goods.b-code
     1765               BY sj-adv.price
     1766               BY sj-adv.discnt
     1767       :
     1768   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1769   if first( sj-goods.obj-attr ) then do:
     1770     if v-curr-r-b = 'base':U then do:
     1771                           if my-set_val_type = 2  then
     1772                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-d .
     1773                           else
     1774                               DOWN STREAM PrnLibStream 1 with FRAME sj-full-d .
     1775     end.
     1776     else do:
     1777                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-d .
     1778     end.
     1779   end.
     1780                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     1781                           assign
     1782                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     1783                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     1784                           FIND FIRST cli-obj WHERE
     1785                                      cli-obj.obj-type = strbuf1 AND
     1786                                      cli-obj.obj-code = intbuf1 NO-LOCK .
     1787                           PUT STREAM PrnLibStream
     1788                           cli-obj.obj-name format "x(120)" SKIP.
     1789   if v-curr-r-b = 'base':U then do:
     1790                           if my-set_val_type = 2  then
     1791                           UNDERLINE STREAM PrnLibStream
     1792                           sj-goods.artic
     1793                           sj-goods.name
     1794                           with FRAME sj-base-d .
     1795                           else
     1796                           UNDERLINE STREAM PrnLibStream
     1797                           sj-goods.artic
     1798                           sj-goods.name
     1799                           with FRAME sj-full-d .
     1800   end.
     1801   else do:
     1802                           UNDERLINE STREAM PrnLibStream
     1803                           sj-goods.artic
     1804                           sj-goods.name
     1805                           with FRAME sj-base-d .
     1806   end.
     1807                       end.
     1808         if first-of( sj-goods.grp-name  ) then do:
     1809           if v-curr-r-b = 'base':U then do:
     1810             if my-Set_Val_Type = 2 then do:
     1811               if frame sj-base-d:line = 0 then do:
     1812                 down 1 stream PrnLibStream
     1813                 with frame sj-base-d.
     1814               end.
     1815             end.
     1816             else do:
     1817               if frame sj-full-d:line = 0 then do:
     1818                 down 1 stream PrnLibStream
     1819                 with frame sj-full-d.
     1820               end.
     1821             end.
     1822             PUT STREAM PrnLibStream string( "   ГРУППА : " +  get-grp-name(sj-goods.grp-name) ) format "x(120)" SKIP.
     1823             if my-Set_Val_Type = 2 then do:
     1824               UNDERLINE STREAM PrnLibStream
     1825               sj-goods.artic
     1826               sj-goods.name
     1827               with FRAME sj-base-d .
     1828             end.
     1829             else do:
     1830               UNDERLINE STREAM PrnLibStream
     1831               sj-goods.artic
     1832               sj-goods.name
     1833               with FRAME sj-full-d .
     1834             end.
     1835           end.
     1836           else do:
     1837             if frame sj-base-d:line = 0 then do:
     1838               down 1 stream PrnLibStream
     1839               with frame sj-base-d.
     1840             end.
     1841             PUT STREAM PrnLibStream string( "   ГРУППА : " +  get-grp-name(sj-goods.grp-name) ) format "x(120)" SKIP.
     1842             UNDERLINE STREAM PrnLibStream
     1843             sj-goods.artic
     1844             sj-goods.name
     1845             with FRAME sj-base-d .
     1846           end.
     1847         end.
     1848         if first-of( sj-goods.prod-name ) then do:
     1849           if prodtot_flag or NOT SHOnly_tot then do:
     1850               if v-curr-r-b = 'base':U then do:
     1851                 if my-Set_Val_Type = 2 then do:
     1852                   if frame sj-base-d:line = 0 then do:
     1853                     down 1 stream PrnLibStream
     1854                     with frame sj-base-d.
     1855                   end.
     1856                 end.
     1857                 else do:
     1858                   if frame sj-full-d:line = 0 then do:
     1859                     down 1 stream PrnLibStream
     1860                     with frame sj-full-d.
     1861                   end.
     1862                 end.
