     3405             :
     3406   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3407   if first( sj-goods.obj-attr ) then do:
     3408     if v-curr-r-b = 'base':U then do:
     3409                           if my-set_val_type = 2  then
