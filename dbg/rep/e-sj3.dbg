     3392     FOR EACH sj-goods NO-LOCK,
     3393       EACH sj-adv NO-LOCK WHERE
     3394            sj-adv.obj-attr = sj-goods.obj-attr AND
     3395            sj-adv.b-code = sj-goods.b-code AND
