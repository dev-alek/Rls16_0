     3037     if last-of( sj-goods.grp-name ) AND grouptot_flag then do:
     3038       IF AllObjsTotalsBy  then do:
     3039         FIND FIRST sj-tots WHERE
     3040                    sj-tots.obj-attr = sj-goods.obj-attr AND
     3041                   sj-tots.grp-name = sj-goods.grp-name AND
     3042                   sj-tots.prod-name = sj-goods.prod-name No-ERROR.
     3043           IF NOT avail sj-tots then do:
     3044             create sj-tots.
     3045             assign
     3046             sj-tots.obj-attr = sj-goods.obj-attr
     3047             sj-tots.grp-name = sj-goods.grp-name
     3048             sj-tots.qnty = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty
     3049             sj-tots.qnty-2 = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty-2
     3050             sj-tots.qnty-3 = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty-3
     3051             sj-tots.discnt-sum  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.discnt-sum
     3052             sj-tots.brutto-sum  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.brutto-sum
     3053             sj-tots.netto-sum  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.netto-sum.
