     2565       end.
     2566       else do:
     2567         FOR EACH sj-goods NO-LOCK,
     2568             EACH sj-adv NO-LOCK WHERE
     2569                   sj-adv.obj-attr = sj-goods.obj-attr AND
     2570                   sj-adv.b-code = sj-goods.b-code AND
     2571                   sj-adv.saleman-chr = sj-goods.saleman-chr
     2572             BREAK
     2573             BY sj-goods.obj-attr
     2574             BY sj-goods.grp-name
     2575             BY sj-goods.prod-name
     2576             BY sj-goods.saleman-chr
     2577             BY sj-goods.b-code
     2578             BY sj-adv.price
     2579             BY sj-adv.discnt
     2580         :
     2581   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2582   if first( sj-goods.obj-attr ) then do:
     2583     if v-curr-r-b = 'base':U then do:
     2584                           if my-set_val_type = 2  then
     2585                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-d .
     2586                           else
     2587                               DOWN STREAM PrnLibStream 1 with FRAME sj-full-d .
     2588     end.
     2589     else do:
     2590                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-d .
     2591     end.
     2592   end.
     2593                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     2594                           assign
     2595                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     2596                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     2597                           FIND FIRST cli-obj WHERE
     2598                                      cli-obj.obj-type = strbuf1 AND
     2599                                      cli-obj.obj-code = intbuf1 NO-LOCK .
     2600                           PUT STREAM PrnLibStream
     2601                           cli-obj.obj-name format "x(120)" SKIP.
     2602   if v-curr-r-b = 'base':U then do:
     2603                           if my-set_val_type = 2  then
     2604                           UNDERLINE STREAM PrnLibStream
     2605                           sj-goods.artic
     2606                           sj-goods.name
     2607                           with FRAME sj-base-d .
     2608                           else
     2609                           UNDERLINE STREAM PrnLibStream
     2610                           sj-goods.artic
     2611                           sj-goods.name
     2612                           with FRAME sj-full-d .
     2613   end.
     2614   else do:
     2615                           UNDERLINE STREAM PrnLibStream
     2616                           sj-goods.artic
     2617                           sj-goods.name
     2618                           with FRAME sj-base-d .
     2619   end.
     2620                       end.
     2621           if first-of( sj-goods.grp-name  ) then do:
     2622             if v-curr-r-b = 'base':U then do:
     2623               if my-Set_Val_Type = 2 then do:
     2624                 if frame sj-base-d:line = 0 then do:
     2625                   down 1 stream PrnLibStream
     2626                   with frame sj-base-d.
     2627                 end.
     2628               end.
     2629               else do:
     2630                 if frame sj-full-d:line = 0 then do:
     2631                   down 1 stream PrnLibStream
     2632                   with frame sj-full-d.
     2633                 end.
     2634               end.
     2635               PUT STREAM PrnLibStream string( "   ГРУППА : " +  get-grp-name(sj-goods.grp-name) ) format "x(120)" SKIP.
     2636               if my-Set_Val_Type = 2 then do:
     2637                 UNDERLINE STREAM PrnLibStream
     2638                 sj-goods.artic
     2639                 sj-goods.name
     2640                 with FRAME sj-base-d .
     2641               end.
     2642               else do:
     2643                 UNDERLINE STREAM PrnLibStream
     2644                 sj-goods.artic
     2645                 sj-goods.name
     2646                 with FRAME sj-full-d .
     2647               end.
     2648             end.
     2649             else do:
     2650               if frame sj-base-d:line = 0 then do:
     2651                 down 1 stream PrnLibStream
     2652                 with frame sj-base-d.
     2653               end.
     2654               PUT STREAM PrnLibStream string( "   ГРУППА : " +  get-grp-name(sj-goods.grp-name) ) format "x(120)" SKIP.
     2655               UNDERLINE STREAM PrnLibStream
     2656               sj-goods.artic
     2657               sj-goods.name
     2658               with FRAME sj-base-d .
     2659             end.
     2660           end.
     2661           if first-of( sj-goods.prod-name ) then do:
     2662             if prodtot_flag OR NOT SHOnly_tot then do:
     2663               if v-curr-r-b = 'base':U then do:
     2664                 if my-Set_Val_Type = 2 then do:
     2665                   if frame sj-base-d:line = 0 then do:
     2666                     down 1 stream PrnLibStream
     2667                     with frame sj-base-d.
     2668                   end.
     2669                 end.
     2670                 else do:
     2671                   if frame sj-full-d:line = 0 then do:
     2672                     down 1 stream PrnLibStream
     2673                     with frame sj-full-d.
     2674                   end.
     2675                 end.
     2676                 PUT STREAM PrnLibStream string( "   ПРОИЗВОДИТЕЛЬ : " + sj-goods.prod-name )
     2677                 format "x(120)" SKIP .
     2678                 if my-Set_Val_Type = 2 then do:
     2679                   UNDERLINE STREAM PrnLibStream
     2680                   sj-goods.artic
     2681                   sj-goods.name
     2682                   with FRAME sj-base-d .
     2683                 end.
     2684                 else do:
     2685                   UNDERLINE STREAM PrnLibStream
     2686                   sj-goods.artic
     2687                   sj-goods.name
     2688                   with FRAME sj-full-d .
     2689                 end.
     2690               end.
     2691               else do:
     2692                 if frame sj-base-d:line = 0 then do:
     2693                   down 1 stream PrnLibStream
     2694                   with frame sj-base-d.
     2695                 end.
     2696                 PUT STREAM PrnLibStream string( "   ПРОИЗВОДИТЕЛЬ : " + sj-goods.prod-name )
     2697                 format "x(120)" SKIP .
     2698                 UNDERLINE STREAM PrnLibStream
     2699                 sj-goods.artic
     2700                 sj-goods.name
     2701                 with FRAME sj-base-d .
