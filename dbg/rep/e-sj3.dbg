     3413     end.
     3414     else do:
     3415                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-d .
     3416     end.
     3417   end.
     3418                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     3419                           assign
     3420                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     3421                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     3422                           FIND FIRST cli-obj WHERE
     3423                                      cli-obj.obj-type = strbuf1 AND
     3424                                      cli-obj.obj-code = intbuf1 NO-LOCK .
     3425                           PUT STREAM PrnLibStream
     3426                           cli-obj.obj-name format "x(120)" SKIP.
     3427   if v-curr-r-b = 'base':U then do:
     3428                           if my-set_val_type = 2  then
     3429                           UNDERLINE STREAM PrnLibStream
     3430                           sj-goods.artic
     3431                           sj-goods.name
     3432                           with FRAME sj-base-d .
