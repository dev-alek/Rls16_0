     4982           ACCUM TOTAL sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     4983           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     4984           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     4985           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
