     6443         THEN
     6444         round( ( ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.discnt-sum ) /
     6445         ( ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.brutto-sum ) * 100 , 1 )
     6446         else 0)  @ pcnt
