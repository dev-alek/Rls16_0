     5016   END PROCEDURE.
     5017   PROCEDURE SimpleProc_d.
     5018   define variable v-salesman-name as character no-undo .
     5019   define buffer buf_saleman for ub.clients.
     5020   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5021   if SHRs-sort = "Article":U then do:
     5022     if SHBySalers then do:
     5023         FOR EACH sj-goods NO-LOCK,
     5024             EACH sj-adv NO-LOCK WHERE
     5025                   sj-adv.obj-attr = sj-goods.obj-attr AND
     5026                   sj-adv.b-code = sj-goods.b-code AND
     5027                   sj-adv.saleman = sj-goods.saleman
     5028             BREAK BY sj-goods.obj-attr
     5029                   BY sj-goods.saleman
     5030                   BY sj-goods.artic
     5031                   BY sj-goods.b-code
     5032                   BY sj-adv.price
     5033                   BY sj-adv.discnt
     5034                   :
     5035   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5036   if first( sj-goods.obj-attr ) then do:
     5037     if v-curr-r-b = 'base':U then do:
     5038                           if my-set_val_type = 2  then
     5039                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-d .
     5040                           else
     5041                               DOWN STREAM PrnLibStream 1 with FRAME sj-full-d .
     5042     end.
     5043     else do:
     5044                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-d .
     5045     end.
     5046   end.
     5047                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     5048                           assign
     5049                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     5050                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     5051                           FIND FIRST cli-obj WHERE
     5052                                      cli-obj.obj-type = strbuf1 AND
     5053                                      cli-obj.obj-code = intbuf1 NO-LOCK .
     5054                           PUT STREAM PrnLibStream
     5055                           cli-obj.obj-name format "x(120)" SKIP.
     5056   if v-curr-r-b = 'base':U then do:
     5057                           if my-set_val_type = 2  then
     5058                           UNDERLINE STREAM PrnLibStream
     5059                           sj-goods.artic
     5060                           sj-goods.name
     5061                           with FRAME sj-base-d .
     5062                           else
     5063                           UNDERLINE STREAM PrnLibStream
     5064                           sj-goods.artic
     5065                           sj-goods.name
     5066                           with FRAME sj-full-d .
     5067   end.
     5068   else do:
     5069                           UNDERLINE STREAM PrnLibStream
     5070                           sj-goods.artic
     5071                           sj-goods.name
     5072                           with FRAME sj-base-d .
     5073   end.
     5074                       end.
     5075   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5076       ACCUMULATE
     5077       sj-adv.qnty (TOTAL)
     5078       sj-adv.qnty-2 (TOTAL)
     5079       sj-adv.qnty-3 (TOTAL)
     5080       sj-adv.brutto-sum (TOTAL)
     5081       sj-adv.discnt-sum (TOTAL)
     5082       sj-adv.netto-sum (TOTAL)
     5083       sj-adv.brutto-sum-r (TOTAL)
     5084       sj-adv.netto-sum-r (TOTAL)
     5085       sj-adv.num-docs (TOTAL)
     5086       sj-adv.num-lines (TOTAL)
     5087       sj-adv.qnty ( SUB-TOTAL BY sj-goods.obj-attr )
     5088       sj-adv.qnty-2 ( SUB-TOTAL BY sj-goods.obj-attr )
     5089       sj-adv.qnty-3 ( SUB-TOTAL BY sj-goods.obj-attr )
     5090       sj-adv.brutto-sum ( SUB-TOTAL BY sj-goods.obj-attr )
     5091       sj-adv.discnt-sum ( SUB-TOTAL BY sj-goods.obj-attr )
     5092       sj-adv.netto-sum ( SUB-TOTAL BY sj-goods.obj-attr )
     5093       sj-adv.brutto-sum-r ( SUB-TOTAL BY sj-goods.obj-attr )
     5094       sj-adv.netto-sum-r ( SUB-TOTAL BY sj-goods.obj-attr )
     5095       sj-adv.qnty ( SUB-TOTAL BY sj-adv.discnt )
     5096       sj-adv.qnty-2 ( SUB-TOTAL BY sj-adv.discnt )
     5097       sj-adv.qnty-3 ( SUB-TOTAL BY sj-adv.discnt )
     5098       sj-adv.brutto-sum ( SUB-TOTAL BY sj-adv.discnt )
     5099       sj-adv.discnt-sum ( SUB-TOTAL BY sj-adv.discnt )
     5100       sj-adv.netto-sum ( SUB-TOTAL BY sj-adv.discnt )
     5101       sj-adv.brutto-sum-r ( SUB-TOTAL BY sj-adv.discnt )
     5102       sj-adv.netto-sum-r ( SUB-TOTAL BY sj-adv.discnt )
     5103       sj-adv.qnty ( SUB-TOTAL BY sj-goods.saleman )
     5104       sj-adv.qnty-2 ( SUB-TOTAL BY sj-goods.saleman )
     5105       sj-adv.qnty-3 ( SUB-TOTAL BY sj-goods.saleman )
     5106       sj-adv.brutto-sum ( SUB-TOTAL BY sj-goods.saleman )
     5107       sj-adv.discnt-sum ( SUB-TOTAL BY sj-goods.saleman )
     5108       sj-adv.netto-sum ( SUB-TOTAL BY sj-goods.saleman )
     5109       sj-adv.brutto-sum-r ( SUB-TOTAL BY sj-goods.saleman )
     5110       sj-adv.netto-sum-r ( SUB-TOTAL BY sj-goods.saleman )
     5111       sj-adv.num-docs (SUB-TOTAL BY sj-goods.saleman )
     5112       sj-adv.num-lines (SUB-TOTAL BY sj-goods.saleman )
     5113       .
     5114   if sj-goods.twounit = 0 then do:
     5115     if last-of ( sj-adv.discnt ) AND SHRs-by <> 0 then do:
     5116       namebuf1 = get-strokes(buffer sj-goods, 18, 21,
     5117                              input-output namebuf1,
     5118                              input-output namebuf2,
     5119                              input-output prodbuf1,
     5120                              input-output prodbuf2).
     5121       CASE my-Set_val_type :
     5122       when 2 then  do:
     5123         DISPLAY STREAM PrnLibStream
     5124         sj-goods.b-code
     5125         sj-goods.artic
     5126         namebuf1 @ sj-goods.name
     5127         prodbuf1 @ sj-goods.prod-name
     5128         ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.qnty @ sj-adv.qnty
     5129         sj-adv.price
     5130         ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.brutto-sum @ sj-adv.brutto-sum
     5131         sj-adv.discnt
     5132         ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.discnt-sum @ sj-adv.discnt-sum
     5133         (IF (ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.qnty) <> 0
     5134         THEN
     5135         round( ( ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.discnt-sum ) /
     5136         ( ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.brutto-sum ) * 100 , 1 )
     5137         else 0)  @ pcnt
     5138         ACCUM SUB-TOTAL BY sj-adv.discnt sj-adv.netto-sum @ sj-adv.netto-sum
     5139         with FRAME sj-base-d .
     5140         DOWN STREAM PrnLibStream 1 with FRAME sj-base-d .
     5141        end.
     5142        when 3 then do:
     5143         DISPLAY STREAM PrnLibStream
     5144         sj-goods.b-code
     5145         sj-goods.artic
     5146         namebuf1 @ sj-goods.name
     5147         prodbuf1 @ sj-goods.prod-name
     5148         ACCUM SUB-TOTAL BY  sj-adv.discnt  sj-adv.qnty @ sj-adv.qnty
     5149         sj-adv.price
     5150         ACCUM SUB-TOTAL BY  sj-adv.discnt  sj-adv.brutto-sum @ sj-adv.brutto-sum
     5151         ACCUM SUB-TOTAL BY  sj-adv.discnt  sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     5152         sj-adv.discnt
