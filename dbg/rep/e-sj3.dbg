     3055             assign
     3056             sj-tots.brutto-sum-r  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.brutto-sum-r
     3057             sj-tots.netto-sum-r  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.netto-sum-r.
