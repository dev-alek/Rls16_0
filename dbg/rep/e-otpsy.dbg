     1505   PROCEDURE my-report :
     1506   for each obj-list :
     1507      find first clients no-lock where
     1508                 clients.obj-code  = obj-list.obj-code  and
     1509                 clients.obj-type  = obj-list.obj-type  and
     1510                 clients.host-code = v-cntxt-host-code-obj no-error .
     1511     if not available clients then do:
     1512        message "Объект "
     1513        obj-list.obj-code
     1514        obj-list.obj-type
     1515        obj-list.obj-name
     1516        " не принадлежит фирме " v-cntxt-host-code-obj v-cntxt-host-name-obj
     1517                 "Определите список объектов , принадлежащих одной фирмы"
     1518                 view-as alert-box information .
     1519        return error .
     1520     end.
     1521   end.
     1522   run run-p in this-procedure  .
     1523   END PROCEDURE.
     1524   PROCEDURE my-var :
     1525   if VALID-HANDLE(type-pr) = false  then do:
     1526       message "Нет архивов по типу приобретения !!!" skip
     1527       view-as alert-box information .
     1528       return 'First-page':U.
     1529    end.
     1530   assign frame F-Main SumsOnly ShowZero tog-obj ShowZero-2
     1531   tog-lavel var-lavel Classify SortType r-gds VAT-Cost VAT-CRSA VAT-sale  .
     1532   if x-SelectObject = "currency":U and tog-obj = false then tog-obj = true .
     1533   Assign
     1534    STR-obj-type = ''
     1535    STR-obj-code = ''
     1536    STR-obj-name = ''
     1537    STR-obj      = ''.
     1538   For each obj-list no-lock:
     1539    Assign
     1540    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1541    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1542    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1543    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1544   End.
     1545   ReportNAme = "О Т Ч Е Т  ТПСИ   по типу приобретения - "
     1546                              + Caps ( entry( (lookup(type-pr:screen-value ,type-pr:RADIO-BUTTONS) - 1), type-pr:RADIO-BUTTONS )   )
     1547                              .
     1548   def var t-class as char no-undo.
     1549   def var t-sort as char no-undo.
     1550     case classify:
     1551       when "no-classify":u    then t-class =   "Без классификации" .
     1552       when "prod":u           then t-class =   "Производители"   .
     1553       when "post":u           then t-class =   "Поставщики"   .
     1554       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1555       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1556       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1557       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1558       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1559       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1560       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1561       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1562       when  "t-level":u       then t-class =   "Терминальные группы" .
     1563    end case.
     1564     case sorttype:
     1565       when "sort-pp":u               then t-sort =   "по порядку" .
     1566       when "sort-code":u             then t-sort =   "по коду" .
     1567       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1568       when "sort-qunty":u            then t-sort =   "по реализации".
     1569       when "sort-name":u             then t-sort =   "по наименованию".
     1570       when "sort-type":u             then t-sort =   "по типу ткани".
     1571       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1572       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1573    end case.
     1574   ReportHeader = "Классификация : " + t-Class.
     1575   ReportHeader = ReportHeader +
     1576                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     1577   ReportHeader = ReportHeader  + chr(10).
     1578   ReportHeader = ReportHeader +
     1579                  "Сортировка " + t-Sort + chr(10) +
     1580                  "Показать : " +
     1581                  (if SumsOnly     then "Только итоги, "  else " "            ) +
     1582                  (if Show-Cost    then "Суммы в учетных ценах, "  else " "   ) +
     1583                  (if Show-Crsa    then "Суммы в продажных ценах, "  else " " ) +
     1584                  (if Show-Sale    then "Суммы в продажных ценах документа , "  else " " ) +
     1585                  (if vat-Cost     then "НДС в учетных ценах, "  else " "   ) +
     1586                  (if vat-Crsa     then "НДС в продажных ценах, "  else " " ) +
     1587                  (if vat-Sale     then "НДС в продажных ценах документа , "  else " " ) +
     1588                  (if ShowZero     then " Показывать нулевые остатки "  else " Не показывать нулевые остатки" ) +
     1589                  (if ShowZero-2   then " Показывать нулевые обороты "  else " Не показывать нулевые обороты" ) .
     1590   if type-pr:screen-value = "all" then ReportHeader =  ReportHeader  +    chr(10) + "Итоги по типам приобретения показываются , если типов приобретения больше одного." .
     1591   Sheetf.Excel-Column-Lable = "Код,Артикул,Название товара ,Ед.изм,т/у,Скидка,Остаток на  начало,,,,,,,Приход,,,,,,,Расход,,,,,,,Касса,,,,,,,Инвентаризация|Смена типа приобретения,,,,,,,Переоценка,,,,,,,Остаток на конец,,,,,,,, "  + chr(10).
     1592   Sheetf.Excel-Column-Lable = Excel-Column-Lable + ",,,,,, " +
     1593         Fill ( "кол-во ,учет.сумма ,прод.сумма ,в ценах док-та ,учет.НДС,прод.НДС,НДС в ценах док-та ," , 7) .
     1594   Sheetf.Sizes = "10,16,60,7,3,13," + Fill("13,", 49) .
     1595   Sheetf.make-correct = fill("false,", 55) .
     1596   Sheetf.ColFOrmat = "2=@;3=@"  .
     1597   END PROCEDURE.
     1598   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1599   procedure cr-ob :
     1600    do
     1601    on error undo, return error return-value
     1602    :
     1603   define input parameter p-x as integer no-undo .
     1604   define input parameter p-y as integer no-undo .
     1605   define input parameter type-pr-name as character no-undo .
     1606   define input parameter type-pr-val  as character no-undo .
     1607   define variable l-str as character no-undo .
     1608   define variable i as integer no-undo .
     1609   if type-pr-name = ? then type-pr-name = 'Все,Выкуп,Консигнаци,Консигнация закупка,Консигнация выгода,Ответственное хранение,Старая консигнация':L .
     1610   if type-pr-val  = ?then type-pr-val  = 'all,r,cb,c,b,s,1':U .
     1611   repeat i = 1 to num-entries(type-pr-name) :
     1612    l-str =  l-str  + entry(i ,type-pr-name) + ","  +
     1613                      entry(i ,type-pr-val)  + "," .
     1614   end.
     1615   l-str = substring(l-str,1 , LENGTH (l-str) - 1) .
     1616   if num-entries(l-str) < 2 then do:
     1617       message "Нет архивов по типу приобретения !!!" skip
     1618       vss-include-info19 skip
     1619       view-as alert-box information .
     1620       return 'First-page':U.
     1621      end.
     1622      create radio-set type-pr
     1623      assign
     1624       row    = p-y
     1625       column = p-x
     1626       frame  = frame F-Main:handle
     1627       horizontal    = false
     1628       radio-buttons = l-str
     1629    .
     1630   if valid-handle(type-pr) = false then do:
     1631       message "Нет архивов по типу приобретения !!!" skip
     1632       vss-include-info19 skip
     1633       view-as alert-box information .
     1634       return 'First-page':U.
     1635    end.
     1636     type-pr:sensitive = yes  .
     1637     type-pr:visible   = yes  .
     1638    end.
     1639   end procedure.
     1640   PROCEDURE run-p :
     1641       if type-pr:screen-value = "all" then do:
     1642       case SortType :
     1643         when "sort-artic" then do:
     1644           run proc-a in this-procedure .
     1645         end.
     1646         when "sort-code" then do:
     1647           run proc-s in this-procedure .
     1648         end.
     1649         when "sort-name" then do:
     1650           run proc-t in this-procedure .
     1651         end.
     1652       end case.
     1653       end.
     1654       else do:
     1655         case SortType :
     1656           when "sort-artic" then do:
     1657             run proc-r in this-procedure .
     1658           end.
     1659           when "sort-code" then do:
     1660             run proc-c in this-procedure .
     1661           end.
     1662           when "sort-name" then do:
     1663             run proc-n in this-procedure .
     1664           end.
     1665         end case.
     1666       end.
     1667   END PROCEDURE.
