      563   define new global shared variable g#library  as handle no-undo .
      564   define new global shared variable g#library2 as handle no-undo .
      565   define variable var-report-r-b as character no-undo .
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   define variable v-waitfram-action01         as character   no-undo .
      572   define variable v-waitfram-action02         as character   no-undo .
      573   define variable v-waitfram-action03         as character   no-undo .
      574   define variable mWaitFramTextBeg            as character   no-undo.
      575   define variable mWaitFramTextEnd            as character   no-undo.
      576   define variable mWaitFramView               as logical     no-undo.
      577   define variable mWaitProcEvent              as logical     no-undo init yes.
      578   define variable mWaitFramInterval           as integer     no-undo init 1 .
      579   define variable mWaitFramStop               as logical     no-undo.
      580   define variable mWaitFramStopUser           as logical     no-undo.
      581   define variable mWaitFramStopTimeOut        as logical     no-undo.
      582   define variable mWaitFramStartProc          as datetime-tz no-undo.
      583   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      584   define button B-WaitFramStop auto-end-key
      585        label "Стоп"
      586        size 10 by 1 tooltip "Остоновить процесс".
      587   define button B-viewProcInfo
      588        label "Информация"
      589        size 15 by 1 tooltip "Информация о процесс".
      590   define frame waitfram
      591     v-waitfram-action01 format "x(72)" no-label skip
      592     v-waitfram-action02 format "x(72)" no-label skip
      593     v-waitfram-action03 format "x(72)" no-label skip
      594     B-viewProcInfo
      595     B-WaitFramStop at row 4 col 30
      596     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      597     .
      598   define new global shared variable mBatchMode as logical no-undo init ?.
      599   define variable mFramBachModHandle as handle no-undo.
      600   mFramBachModHandle = frame waitfram:handle.
      601   define variable mFameOldVis as logical no-undo.
      602   define variable mVisCUrentVin as logical no-undo.
      603   if session:batch-mode
      604   then
      605      mBatchMode = yes.
      606   if mBatchMode = ? then do:
      607     mVisCUrentVin = current-window:visible.
      608     mFameOldVis = mFramBachModHandle:visible.
      609     mFramBachModHandle:visible  = yes.
      610     mBatchMode = mFramBachModHandle:visible ne yes.
      611     mFramBachModHandle:visible = mFameOldVis.
      612     current-window:visible = mVisCUrentVin.
      613   end.
      614    if  log-manager:logfile-name ne ?
      615     then DO:
      616         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      617         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      618         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      619     end.
      620   on choose of B-WaitFramStop in frame waitfram
      621   do:
      622     mWaitFramStop = yes.
      623     mWaitFramStopUser = yes.
      624   end.
      625   function waitfram-check-timeout returns logical():
      626      define variable vtime as int64 no-undo.
      627      if mWaitFramStopTimeOut
      628      then
      629         return yes.
      630      vtime = ( now - mWaitFramStartProc ) / 1000 .
      631      if     mWaitFramTimeOut ne ?
      632         and mWaitFramTimeOut ne 0
      633         and mWaitFramTimeOut lt vtime
      634      then do:
      635         mWaitFramStopTimeOut = yes.
      636      end.
      637      return mWaitFramStopTimeOut.
      638   end.
      639   procedure waitfram-hide :
      640     if not session:batch-mode
      641     then do
      642     on error undo, return error return-value
      643     :
      644       pause 0 before-hide .
      645       if not mBatchMode then
      646         hide frame waitfram .
      647     if     not mWaitFramView
      648        and mWaitProcEvent
      649     then
      650       process events .
      651     end.
      652   end procedure.
      653   procedure waitfram-show :
      654     define input  parameter p-message as character no-undo .
      655     define variable v-left-margin as integer   no-undo .
      656     if not session:batch-mode
      657     then do
      658     on error undo, return error return-value
      659     :
      660       if length(p-message) <= 70 then do:
      661         assign
      662           v-left-margin = integer((70 - length(p-message)) / 2)
      663         .
      664         assign
      665           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      666         .
      667         assign
      668           v-waitfram-action01 = " "
      669           v-waitfram-action02 = " "
      670                                    + fill(" ", v-left-margin)
      671                                    + p-message
      672           v-waitfram-action03 = " "
      673         .
      674       end.
      675       else do:
      676         define variable vRindex1 as integer no-undo.
      677         define variable vRindex2 as integer no-undo.
      678         vRindex1 = r-index(p-message," ",70).
      679         if vRindex1 = 0
      680         then
      681            vRindex1 = 70.
      682         if length(p-message)  <= vRindex1 + 70 then do:
      683           assign
      684             v-waitfram-action01 = " "
      685             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      686             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      687           .
      688         end.
      689         else do:
      690           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      691           if vRindex2 <= vRindex1
      692           then
      693              vRindex2 = vRindex1 + 70.
      694           assign
      695             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      696             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      697             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      698           .
      699         end.
      700       end.
      701       B-viewProcInfo:visible   in frame waitfram = no.
      702       B-viewProcInfo:sensitive in frame waitfram = no.
      703       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      704       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      705       if  (   mWaitFramView
      706          or  mWaitProcEvent)
      707          and not mBatchMode
      708       then
      709          display
      710             v-waitfram-action01 skip
      711             v-waitfram-action02 skip
      712             v-waitfram-action03 skip
      713          with frame waitfram .
      714       if     mWaitFramView
      715          then do:
      716             if     mWaitFramInterval ne ?
      717                and not mBatchMode
      718             then
      719                wait-for go of frame waitfram pause mWaitFramInterval.
      720          end.
      721          else
      722             if     mWaitProcEvent
      723                and not mBatchMode
      724             then
      725                process events .
      726     end.
      727   end procedure.
      728      procedure waitfram-show-this:
      729         define input  parameter iInterval as int64 no-undo.
      730         define variable vtime as int64 no-undo.
      731         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      732         mWaitFramInterval = iInterval.
      733         run waitfram-show (substitute("&1&2 &3&4" ,
      734                                       mWaitFramTextBeg ,
      735                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      736                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      737                                       mWaitFramTextEnd
      738                                      )
      739                           ).
      740      end.
      741      procedure WaitFramRunPause:
      742         define input  parameter iInterval as dec no-undo.
      743         define variable vStart  as datetime-tz no-undo.
      744         define variable vend    as datetime-tz no-undo.
      745         define variable vint as int64 no-undo.
      746         define variable vOk as logical no-undo.
      747         vStart = now.
      748         vend   = vStart.
      749         publish "WaitFramPause" (iInterval,output vOk).
      750         vend   =  now.
      751         vint = vend - vStart.
      752         vint = iInterval - vint / 1000.
      753         if     not mWaitFramStop
      754            and (   vint > 0
      755                 or (    not vOk
      756                     and iInterval eq ?
      757                     )
      758                 )
      759         then
      760            run waitfram-show-this (iInterval).
      761         vend   =  now.
      762         vint = vend - vStart.
      763         vint = iInterval - vint / 1000.
      764         if     not mWaitFramStop
      765            and vint > 0
      766         then do:
      767            run gbl/pause.p (vint * 1000).
      768         end.
      769         if iInterval ne ?
      770         then
      771            publish "WaitFramStop".
      772         waitfram-check-timeout().
      773      end.
      774      procedure WaitFramWaitFor:
      775         define input  parameter iInterval as dec no-undo.
      776         assign
      777            mWaitFramStartProc   = now
      778            mWaitFramStopUser    = no
      779            mWaitFramStopTimeOut = no
      780         .
      781         block-wait:
      782         do while not mWaitFramStop:
      783            run WaitFramRunPause (iInterval).
      784            if  waitfram-check-timeout()
      785            then do:
      786               leave block-wait.
      787            end.
      788         end.
      789         run waitfram-hide.
      790      end.
      791   procedure waitfram-join :
      792     define input  parameter p-line-1  as character no-undo .
      793     define input  parameter p-line-2  as character no-undo .
      794     define input  parameter p-line-3  as character no-undo .
      795     define output parameter p-message as character no-undo .
      796     do
      797     on error undo, return error return-value
      798     :
      799       assign
      800         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      801                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      802                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      803       .
      804     end.
      805   end procedure.
      806   function waitfram-join-function returns character
      807     (input p-line-1 as character
      808     ,input p-line-2 as character
      809     ,input p-line-3 as character
      810     ).
      811     define variable v-message as character no-undo .
      812     run waitfram-join in this-procedure
      813       (input  p-line-1
      814       ,input  p-line-2
      815       ,input  p-line-3
      816       ,output v-message
      817       ) .
      818     return v-message .
      819   end function .
