     1002        size 25.63 by 0.83 NO-UNDO.
     1003   DEFINE FRAME F-Main
     1004        Tog-obj at row 2.54 col 32.75
     1005        Classify at row 3.79 col 32.75 NO-LABEL
     1006        Tog-lavel at row 5.63 col 52
     1007        var-lavel AT ROW 5.63 COL 63.38 COLON-ALIGNED NO-LABEL
     1008        r-gds AT ROW 9.75 COL 43.25 NO-LABEL
     1009        ShowZero-2 at row 12.04 col 33
     1010        VAT-Cost at row 12.04 col 53.13
     1011        ShowZero at row 12.92 col 33
     1012        VAT-CRSA at row 12.92 col 53.13
     1013        SumsOnly AT ROW 13.83 COL 33
     1014        VAT-sale at row 13.83 col 53.13
     1015        SortType at row 16.04 col 32.5 NO-LABEL
     1016        "Товары :" VIEW-AS TEXT
     1017             size 9 by 0.75 at row 9.75 col 32.75
     1018             FGCOLOR 4
     1019        "Сортировка :" VIEW-AS TEXT
     1020             size 46.5 by 0.75 at row 15.17 col 32.63
     1021             FGCOLOR 4
     1022        RECT-6 AT ROW 15.08 COL 31.38
     1023        "Классификация :" VIEW-AS TEXT
     1024             size 46 by 0.75 at row 1.28 col 33
     1025             FGCOLOR 4
     1026        RECT-8 AT ROW 10.79 COL 31.38
     1027        "Показать :" VIEW-AS TEXT
     1028             size 46.13 by 0.75 at row 11 col 33
     1029             FGCOLOR 4
     1030        "Тип приобретения:" VIEW-AS TEXT
     1031             SIZE 28.88 BY .67 AT ROW 1.38 COL 1.88
     1032             FGCOLOR 4
     1033        RECT-9 AT ROW 1.08 COL 1
     1034        RECT-5 AT ROW 1 COL 31.38
     1035       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1036            SIDE-LABELS NO-UNDERLINE THREE-D
     1037            AT COL 1 ROW 1 SCROLLABLE .
     1038   ASSIGN
     1039          FRAME F-Main:SCROLLABLE       = FALSE
     1040          FRAME F-Main:HIDDEN           = TRUE.
     1041   ASSIGN
     1042          Tog-lavel:HIDDEN IN FRAME F-Main           = TRUE.
     1043   ASSIGN
     1044          var-lavel:HIDDEN IN FRAME F-Main           = TRUE.
     1045   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1046   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1047   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1048   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1049   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1050   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1051   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1052   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1053         adm-object-hdl = FRAME F-Main:HANDLE.
     1054   RUN ensure-broker.
     1055   THIS-PROCEDURE:ADM-DATA =
     1056        'ADM1.1~`':U +
     1057        'SmartObject~`':U +
     1058        '~`':U +
     1059        'NO ~`':U +
     1060        '~`':U +
     1061        '~`':U +
     1062        '~`':U +
     1063        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1064           + "~`":U +
     1065        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1066        'Record-Source,Record-Target,TableIO-Target~`':U +
     1067        '~`':U +
     1068        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1069        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1070            THEN "^^":U
     1071        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1072             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1073   PROCEDURE adm-apply-entry :
     1074     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1075   END PROCEDURE.
     1076   PROCEDURE adm-destroy :
     1077    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1078   END PROCEDURE.
     1079   PROCEDURE adm-disable :
     1080       DISABLE RECT-6 RECT-8 RECT-9 RECT-5 Tog-obj Classify r-gds ShowZero-2 VAT-Cost ShowZero VAT-CRSA VAT-sale SortType WITH FRAME F-Main.
     1081       RUN dispatch ('disable-fields':U).
     1082       RUN set-attribute-list ('ENABLED=no':U).
     1083       RETURN.
     1084   END PROCEDURE.
     1085   PROCEDURE adm-edit-attribute-list :
     1086         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1087         RETURN.
     1088   END PROCEDURE.
     1089   PROCEDURE adm-enable :
     1090       ENABLE UNLESS-HIDDEN RECT-6 RECT-8 RECT-9 RECT-5 Tog-obj Classify r-gds ShowZero-2 VAT-Cost ShowZero VAT-CRSA VAT-sale SortType WITH FRAME F-Main.
     1091       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1092       RUN set-attribute-list ('ENABLED=yes':U).
     1093       RETURN.
     1094   END PROCEDURE.
     1095   PROCEDURE adm-exit :
     1096        RUN notify ('exit':U).
     1097     RETURN.
     1098   END PROCEDURE.
     1099   PROCEDURE adm-hide :
     1100     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1101   END PROCEDURE.
     1102   PROCEDURE adm-initialize :
     1103     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1104   END PROCEDURE.
     1105   PROCEDURE adm-show-errors :
     1106       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1107       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1108           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1109       END.
     1110       RETURN.
     1111   END PROCEDURE.
     1112   PROCEDURE adm-UIB-mode :
     1113     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1114   END PROCEDURE.
     1115   PROCEDURE adm-view :
     1116     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1117   END PROCEDURE.
     1118   PROCEDURE dispatch :
     1119       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1120       RUN broker-dispatch IN adm-broker-hdl
     1121           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1122       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1123   END PROCEDURE.
     1124   PROCEDURE ensure-broker :
     1125   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1126   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1127   DO:
     1128       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1129       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1130   END.
     1131   END PROCEDURE.
     1132   PROCEDURE get-attribute :
     1133     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1134     RUN broker-get-attribute IN adm-broker-hdl
     1135         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1136     RETURN RETURN-VALUE.
     1137   END PROCEDURE.
     1138   PROCEDURE get-attribute-list :
     1139     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1140     RUN broker-get-attribute-list IN adm-broker-hdl
     1141         (INPUT THIS-PROCEDURE,
     1142          INPUT ?,
     1143          OUTPUT p-attr-list) NO-ERROR.
     1144     RETURN.
     1145   END PROCEDURE.
     1146   PROCEDURE new-state :
     1147     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1148     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1149     RETURN.
     1150   END PROCEDURE.
     1151   PROCEDURE notify :
     1152     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1153     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1154     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1155         RETURN "ADM-ERROR":U.
     1156     RETURN.
     1157   END PROCEDURE.
     1158   PROCEDURE set-attribute-list :
     1159     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1160     RUN ensure-broker.
     1161     RUN broker-set-attribute-list IN adm-broker-hdl
     1162         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1163     RETURN.
     1164   END PROCEDURE.
     1165   PROCEDURE set-position :
     1166       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1167       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1168       IF VALID-HANDLE(adm-object-hdl) THEN
     1169       DO:
     1170         ASSIGN adm-object-hdl:ROW    =   p-row
     1171                adm-object-hdl:COLUMN =   p-col.
     1172       END.
     1173       RETURN.
     1174   END PROCEDURE.
     1175   PROCEDURE adm-display-fields :
     1176       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1177       RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE adm-open-query :
     1180     RETURN.
     1181   END PROCEDURE.
     1182   PROCEDURE adm-row-changed :
     1183         IF VALID-HANDLE(adm-object-hdl) THEN
     1184           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1185         RUN notify ('row-available':U).
     1186         RETURN.
     1187   END PROCEDURE.
     1188   PROCEDURE reposition-query :
     1189       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1190       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1191       RETURN.
     1192   END PROCEDURE.
     1193     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1194     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1195     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1196     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1197     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1198     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1199     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1200     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1201     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1202     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1203     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1204     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1205     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1206     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1207     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1208     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1209     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1210     IF "":U = "":U THEN
     1211       RUN modify-list-attribute IN adm-broker-hdl
     1212         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1213     RUN use-create-on-add(?).
     1214   PROCEDURE adm-add-record :
     1215       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1216          "must have at least one Enabled Table to perform Add.":U
     1217          VIEW-AS ALERT-BOX ERROR.
     1218       RETURN.
     1219   END PROCEDURE.
     1220   PROCEDURE adm-assign-record :
     1221    MESSAGE
     1222          "Object ":U THIS-PROCEDURE:FILE-NAME
     1223            "must have at least one Enabled Table to perform Assign.":U
     1224              VIEW-AS ALERT-BOX ERROR.
     1225      RETURN.
     1226     END PROCEDURE.
     1227   PROCEDURE adm-assign-statement :
     1228     RETURN.
     1229   END PROCEDURE.
     1230   PROCEDURE adm-cancel-record :
     1231      RETURN.
     1232     END PROCEDURE.
     1233   PROCEDURE adm-copy-record :
     1234       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1235        "must have at least one Enabled Table to perform Copy.":U
