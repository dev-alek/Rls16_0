     1239   PROCEDURE adm-create-record :
     1240      RETURN.
     1241   END PROCEDURE.
     1242   PROCEDURE adm-current-changed :
     1243     RETURN.
     1244   END PROCEDURE.
     1245   PROCEDURE adm-delete-record :
     1246    MESSAGE
     1247          "Object ":U THIS-PROCEDURE:FILE-NAME
     1248            "must have at least one Enabled Table to perform Delete.":U
     1249              VIEW-AS ALERT-BOX ERROR.
     1250       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1251       RETURN.
     1252   END PROCEDURE.
     1253   PROCEDURE adm-disable-fields :
     1254         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1255       RETURN.
