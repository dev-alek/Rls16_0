     1257   PROCEDURE adm-enable-fields :
     1258       RETURN.
     1259   END PROCEDURE.
     1260   PROCEDURE adm-end-update :
     1261     RETURN.
     1262   END PROCEDURE.
     1263   PROCEDURE adm-reset-record :
     1264       RETURN.
     1265   END PROCEDURE.
     1266   PROCEDURE adm-update-record :
     1267       MESSAGE
     1268         "Object ":U THIS-PROCEDURE:FILE-NAME
     1269           "must have at least one Enabled Table to perform Update.":U
     1270             VIEW-AS ALERT-BOX ERROR.
     1271      RETURN.
     1272   END PROCEDURE.
     1273   PROCEDURE check-modified :
     1274   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1275   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1276   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1277   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1278     IF check-state = "check":U THEN
     1279     DO:
     1280       RUN get-link-handle IN adm-broker-hdl
     1281         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1282            OUTPUT group-target-list).
     1283       IF group-target-list NE "":U THEN
     1284       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1285         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1286         RUN check-modified IN curr-widget ('group-check':U).
     1287         IF RETURN-VALUE NE "":U THEN
     1288         DO:
     1289           RUN check-modified-message(RETURN-VALUE).
     1290           RETURN "":U.
     1291         END.
     1292       END.
     1293     END.
     1294     RETURN "":U.
     1295   END PROCEDURE.
     1296   PROCEDURE check-modified-message :
     1297     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1298        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1299           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1300        IF RETURN-VALUE = "YES":U THEN
     1301           RUN notify ('view,CONTAINER-SOURCE':U).
     1302        MESSAGE IF p-changed-table NE ? THEN
     1303           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1304           ELSE "Current values have been changed."
     1305           SKIP "  Do you wish to save those changes?"
     1306           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1307        IF ANS THEN
     1308        DO:
     1309           IF group-assign-target THEN
     1310             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1311           ELSE RUN dispatch('update-record':U).
     1312           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1313           DO:
     1314               MESSAGE "Changes to the previous record were not saved."
     1315                 VIEW-AS ALERT-BOX ERROR.
     1316               IF group-assign-target THEN
     1317                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1318               ELSE RUN dispatch ('cancel-record':U).
     1319           END.
     1320        END.
     1321        ELSE DO:
     1322          IF group-assign-target THEN
     1323             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1324          ELSE RUN dispatch('cancel-record':U).
     1325        END.
     1326        RETURN.
     1327   END PROCEDURE.
     1328   PROCEDURE get-rowid :
     1329       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1330       ASSIGN
     1331       p-table   =   adm-first-table.
     1332       RETURN.
     1333   END PROCEDURE.
     1334   PROCEDURE init-group-assign :
     1335       RUN request-attribute IN adm-broker-hdl
     1336         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1337       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1338         group-assign-target = yes.
     1339       ELSE group-assign-target = no.
     1340       RETURN.
     1341   END PROCEDURE.
     1342   PROCEDURE set-editors :
     1343       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1344       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1345       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1346       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1347       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1348       DO WHILE VALID-HANDLE (curr-widget):
     1349           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1350              curr-widget:HIDDEN = no THEN DO:
     1351             CASE p-field-setting:
     1352               WHEN "INITIALIZE":U THEN
     1353               DO:
     1354                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1355                     read-only-list +
     1356                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1357                        STRING(curr-widget).
     1358               END.
     1359               WHEN "DISABLE":U OR
     1360               WHEN "ENABLE":U THEN
     1361               DO:
     1362                   curr-widget:SENSITIVE = yes.
     1363                   RUN get-attribute ('Read-Only-Editors':U).
     1364                   IF RETURN-VALUE = ? OR
     1365                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1366                       curr-widget:READ-ONLY =
     1367                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1368               END.
     1369               WHEN "CLEAR":U THEN
     1370                   curr-widget:SCREEN-VALUE = "":U.
     1371             END CASE.
     1372           END.
     1373           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1374       END.
     1375       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1376         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1377           + '"':U).
     1378       RETURN.
     1379   END PROCEDURE.
     1380   PROCEDURE use-check-modified-all :
     1381    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1382     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1383     RETURN.
     1384   END PROCEDURE.
     1385   PROCEDURE use-create-on-add :
     1386   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1387      RETURN.
     1388   END PROCEDURE.
     1389   PROCEDURE use-initial-lock :
     1390     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1391     ASSIGN adm-initial-lock = p-attr-value.
     1392     RETURN.
     1393   END PROCEDURE.
     1394     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1395   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1396   DO:
     1397       Assign Classify.
     1398       if Classify  Begins "prod":U OR
     1399          Classify  Begins "grp-goods":U OR
     1400          Classify  Begins "vat-ps":U
     1401           then
     1402           enable SumsOnly with frame F-Main .
     1403      if Classify = "no-classify":U
     1404         Then do:
     1405               SumsOnly = FALSE .
     1406               display SumsOnly with frame F-Main .
     1407               disable SumsOnly with frame F-Main .
     1408           end.
     1409   END.
     1410   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1411   DO:
     1412      Assign tog-lavel.
     1413     if tog-lavel =TRUE
     1414           Then do:
     1415               display  var-Lavel  with frame F-Main .
     1416               enable   var-Lavel  with frame F-Main .
     1417           end.
     1418            Else do:
     1419               display    var-Lavel with frame F-Main .
     1420               disable    var-Lavel with frame F-Main .
     1421           end.
     1422   END.
     1423   if not this-procedure :persistent
     1424   then do:
     1425     message
     1426       vss-workfile vss-revision vss-description skip
     1427       "Ошибка при запуске процедуры" skip
     1428       "Данную процедуру следует запускать только с параметром persistent" skip
     1429       view-as alert-box error .
     1430     undo, return error .
     1431   end.
     1432   PROCEDURE disable_UI :
     1433     HIDE FRAME F-Main.
     1434     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1435   END PROCEDURE.
     1436   PROCEDURE local-initialize :
     1437     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1438      Tog-obj:screen-value in frame F-Main = 'yes':U.
     1439      var-lavel:screen-value in frame F-Main = '1'.
     1440   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1441   do:
     1442     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1443       (input  v-cntxt-db-num
     1444       ,input  v-cntxt-userid
     1445       ,input  0
     1446       ,input  'actn_reports_lookup-cost':U
     1447       ,input  'object':U
     1448       ,input  v-cntxt-host-code-obj
     1449       ,input  v-cntxt-obj-type
     1450       ,input  v-cntxt-obj-code
     1451       ,input  0
     1452       ,input  0
     1453       ,input  0
     1454       ,input  false
     1455       ,output v-log
     1456       )  .
     1457   end.
