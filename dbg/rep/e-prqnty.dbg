      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   define variable  p-curr-code   as integer   no-undo .
      678   define variable  p-ch-val as logical   no-undo .
      679   CREATE WIDGET-POOL.
      680   def var State-source as  WIDGET-HANDLE.
      681   define variable g#log as logical   no-undo .
      682   DEFINE VARIABLE Classify AS CHARACTER
      683        VIEW-AS RADIO-SET VERTICAL
      684        RADIO-BUTTONS
      685             "Без классификации", "no-classify":U,
      686   "Производители", "prod":U,
      687   "Группы товаров", "grp-goods":U,
      688   "Производители/Группы товаров", "prod/grp-goods":U,
      689   "Группы товаров/Производители", "grp-goods/prod":U
      690        SIZE 30.5 BY 4.75 NO-UNDO.
      691   DEFINE VARIABLE SortType AS CHARACTER
      692        VIEW-AS RADIO-SET VERTICAL
      693        RADIO-BUTTONS
      694             "по коду", "sort-code":U,
      695   "по артикулу", "sort-artic":U,
      696   "по наименов.", "sort-name":U
      697        SIZE 14 BY 2.75 NO-UNDO.
      698   DEFINE RECTANGLE RECT-5
      699        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      700        SIZE 32.25 BY 7.75.
      701   DEFINE RECTANGLE RECT-6
      702        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      703        SIZE 16.13 BY 7.79.
      704   DEFINE VARIABLE TOG-prt AS LOGICAL INITIAL no
      705        LABEL "без детализации по признакам"
      706        VIEW-AS TOGGLE-BOX
      707        SIZE 31.13 BY .83 NO-UNDO.
      708   DEFINE FRAME F-Main
      709        Classify AT ROW 2.21 COL 2.25 NO-LABEL
      710        SortType AT ROW 2.71 COL 35.38 NO-LABEL
      711        TOG-prt AT ROW 7.88 COL 2.38
      712        "Сортировка :" VIEW-AS TEXT
      713             SIZE 11.5 BY .75 AT ROW 1.46 COL 36.88
      714             FGCOLOR 4
      715        "Классификация :" VIEW-AS TEXT
      716             SIZE 15 BY .75 AT ROW 1.33 COL 9.5
      717             FGCOLOR 4
      718        RECT-5 AT ROW 1.13 COL 1.63
      719        RECT-6 AT ROW 1.13 COL 34.25
      720       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      721            SIDE-LABELS NO-UNDERLINE THREE-D
      722            AT COL 1 ROW 1 SCROLLABLE
      723            BGCOLOR 8 FGCOLOR 0 .
      724   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      725   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      726   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      727   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      728   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      729   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      730   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      731   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      732         adm-object-hdl = FRAME F-Main:HANDLE.
      733   RUN ensure-broker.
      734   THIS-PROCEDURE:ADM-DATA =
      735        'ADM1.1~`':U +
      736        'SmartObject~`':U +
      737        '~`':U +
      738        'NO ~`':U +
      739        '~`':U +
      740        '~`':U +
      741        '~`':U +
      742        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      743           + "~`":U +
      744        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      745        'Record-Source,Record-Target,TableIO-Target~`':U +
      746        '~`':U +
      747        '~`~`~`~`~`~`~`~`~`~`~`':U +
      748        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      749            THEN "^^":U
      750        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      751             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      752   PROCEDURE adm-apply-entry :
      753     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      754   END PROCEDURE.
      755   PROCEDURE adm-destroy :
      756    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      757   END PROCEDURE.
      758   PROCEDURE adm-disable :
      759       DISABLE RECT-5 RECT-6 Classify SortType WITH FRAME F-Main.
      760       RUN dispatch ('disable-fields':U).
      761       RUN set-attribute-list ('ENABLED=no':U).
      762       RETURN.
      763   END PROCEDURE.
      764   PROCEDURE adm-edit-attribute-list :
      765         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      766         RETURN.
      767   END PROCEDURE.
      768   PROCEDURE adm-enable :
      769       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 Classify SortType WITH FRAME F-Main.
      770       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      771       RUN set-attribute-list ('ENABLED=yes':U).
      772       RETURN.
      773   END PROCEDURE.
      774   PROCEDURE adm-exit :
      775        RUN notify ('exit':U).
      776     RETURN.
      777   END PROCEDURE.
      778   PROCEDURE adm-hide :
      779     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      780   END PROCEDURE.
      781   PROCEDURE adm-initialize :
      782     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      783   END PROCEDURE.
      784   PROCEDURE adm-show-errors :
      785       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      786       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      787           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      788       END.
      789       RETURN.
      790   END PROCEDURE.
      791   PROCEDURE adm-UIB-mode :
      792     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      793   END PROCEDURE.
      794   PROCEDURE adm-view :
      795     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      796   END PROCEDURE.
      797   PROCEDURE dispatch :
      798       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      799       RUN broker-dispatch IN adm-broker-hdl
      800           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      801       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      802   END PROCEDURE.
      803   PROCEDURE ensure-broker :
      804   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      805   IF RETURN-VALUE NE "ADM-Broker":U THEN
      806   DO:
      807       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      808       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      809   END.
      810   END PROCEDURE.
      811   PROCEDURE get-attribute :
      812     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      813     RUN broker-get-attribute IN adm-broker-hdl
      814         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      815     RETURN RETURN-VALUE.
      816   END PROCEDURE.
      817   PROCEDURE get-attribute-list :
      818     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      819     RUN broker-get-attribute-list IN adm-broker-hdl
      820         (INPUT THIS-PROCEDURE,
      821          INPUT ?,
      822          OUTPUT p-attr-list) NO-ERROR.
      823     RETURN.
      824   END PROCEDURE.
      825   PROCEDURE new-state :
      826     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      827     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      828     RETURN.
      829   END PROCEDURE.
      830   PROCEDURE notify :
      831     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      832     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      833     IF RETURN-VALUE = "ADM-ERROR":U THEN
      834         RETURN "ADM-ERROR":U.
      835     RETURN.
      836   END PROCEDURE.
      837   PROCEDURE set-attribute-list :
      838     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      839     RUN ensure-broker.
      840     RUN broker-set-attribute-list IN adm-broker-hdl
      841         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      842     RETURN.
      843   END PROCEDURE.
      844   PROCEDURE set-position :
      845       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      846       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      847       IF VALID-HANDLE(adm-object-hdl) THEN
      848       DO:
      849         ASSIGN adm-object-hdl:ROW    =   p-row
      850                adm-object-hdl:COLUMN =   p-col.
      851       END.
      852       RETURN.
      853   END PROCEDURE.
      854   PROCEDURE adm-display-fields :
      855       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      856       RETURN.
      857   END PROCEDURE.
      858   PROCEDURE adm-open-query :
      859     RETURN.
      860   END PROCEDURE.
      861   PROCEDURE adm-row-changed :
      862         IF VALID-HANDLE(adm-object-hdl) THEN
      863           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      864         RUN notify ('row-available':U).
      865         RETURN.
      866   END PROCEDURE.
      867   PROCEDURE reposition-query :
      868       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      869       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      870       RETURN.
      871   END PROCEDURE.
      872     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      873     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      874     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      875     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      876     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      877     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      878     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      879     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      880     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      881     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      882     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      883     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      884     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      885     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      886     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      887     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      888     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      889     IF "":U = "":U THEN
      890       RUN modify-list-attribute IN adm-broker-hdl
      891         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      892     RUN use-create-on-add(?).
      893   PROCEDURE adm-add-record :
      894       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      895          "must have at least one Enabled Table to perform Add.":U
      896          VIEW-AS ALERT-BOX ERROR.
      897       RETURN.
      898   END PROCEDURE.
      899   PROCEDURE adm-assign-record :
      900    MESSAGE
      901          "Object ":U THIS-PROCEDURE:FILE-NAME
      902            "must have at least one Enabled Table to perform Assign.":U
      903              VIEW-AS ALERT-BOX ERROR.
      904      RETURN.
      905     END PROCEDURE.
      906   PROCEDURE adm-assign-statement :
      907     RETURN.
      908   END PROCEDURE.
      909   PROCEDURE adm-cancel-record :
      910      RETURN.
      911     END PROCEDURE.
      912   PROCEDURE adm-copy-record :
      913       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      914        "must have at least one Enabled Table to perform Copy.":U
      915          VIEW-AS ALERT-BOX ERROR.
      916       RETURN.
      917   END PROCEDURE.
      918   PROCEDURE adm-create-record :
      919      RETURN.
      920   END PROCEDURE.
      921   PROCEDURE adm-current-changed :
      922     RETURN.
      923   END PROCEDURE.
      924   PROCEDURE adm-delete-record :
      925    MESSAGE
      926          "Object ":U THIS-PROCEDURE:FILE-NAME
      927            "must have at least one Enabled Table to perform Delete.":U
      928              VIEW-AS ALERT-BOX ERROR.
      929       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      930       RETURN.
      931   END PROCEDURE.
      932   PROCEDURE adm-disable-fields :
      933         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      934       RETURN.
      935   END PROCEDURE.
      936   PROCEDURE adm-enable-fields :
      937       RETURN.
      938   END PROCEDURE.
      939   PROCEDURE adm-end-update :
      940     RETURN.
      941   END PROCEDURE.
      942   PROCEDURE adm-reset-record :
      943       RETURN.
      944   END PROCEDURE.
      945   PROCEDURE adm-update-record :
      946       MESSAGE
      947         "Object ":U THIS-PROCEDURE:FILE-NAME
      948           "must have at least one Enabled Table to perform Update.":U
      949             VIEW-AS ALERT-BOX ERROR.
      950      RETURN.
      951   END PROCEDURE.
      952   PROCEDURE check-modified :
      953   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      954   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      955   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      956   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      957     IF check-state = "check":U THEN
      958     DO:
      959       RUN get-link-handle IN adm-broker-hdl
      960         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      961            OUTPUT group-target-list).
      962       IF group-target-list NE "":U THEN
      963       DO i = 1 TO NUM-ENTRIES(group-target-list):
      964         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      965         RUN check-modified IN curr-widget ('group-check':U).
      966         IF RETURN-VALUE NE "":U THEN
      967         DO:
      968           RUN check-modified-message(RETURN-VALUE).
      969           RETURN "":U.
      970         END.
      971       END.
      972     END.
      973     RETURN "":U.
      974   END PROCEDURE.
      975   PROCEDURE check-modified-message :
      976     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      977        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      978           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      979        IF RETURN-VALUE = "YES":U THEN
      980           RUN notify ('view,CONTAINER-SOURCE':U).
      981        MESSAGE IF p-changed-table NE ? THEN
      982           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      983           ELSE "Current values have been changed."
      984           SKIP "  Do you wish to save those changes?"
      985           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      986        IF ANS THEN
      987        DO:
      988           IF group-assign-target THEN
      989             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      990           ELSE RUN dispatch('update-record':U).
      991           IF RETURN-VALUE = "ADM-ERROR":U THEN
      992           DO:
      993               MESSAGE "Changes to the previous record were not saved."
      994                 VIEW-AS ALERT-BOX ERROR.
      995               IF group-assign-target THEN
      996                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      997               ELSE RUN dispatch ('cancel-record':U).
      998           END.
      999        END.
     1000        ELSE DO:
     1001          IF group-assign-target THEN
     1002             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1003          ELSE RUN dispatch('cancel-record':U).
     1004        END.
     1005        RETURN.
     1006   END PROCEDURE.
     1007   PROCEDURE get-rowid :
     1008       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1009       ASSIGN
     1010       p-table   =   adm-first-table.
     1011       RETURN.
     1012   END PROCEDURE.
     1013   PROCEDURE init-group-assign :
     1014       RUN request-attribute IN adm-broker-hdl
     1015         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1016       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1017         group-assign-target = yes.
     1018       ELSE group-assign-target = no.
     1019       RETURN.
     1020   END PROCEDURE.
     1021   PROCEDURE set-editors :
     1022       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1023       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1024       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1025       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1026       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1027       DO WHILE VALID-HANDLE (curr-widget):
     1028           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1029              curr-widget:HIDDEN = no THEN DO:
     1030             CASE p-field-setting:
     1031               WHEN "INITIALIZE":U THEN
     1032               DO:
     1033                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1034                     read-only-list +
     1035                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1036                        STRING(curr-widget).
     1037               END.
     1038               WHEN "DISABLE":U OR
     1039               WHEN "ENABLE":U THEN
     1040               DO:
     1041                   curr-widget:SENSITIVE = yes.
     1042                   RUN get-attribute ('Read-Only-Editors':U).
     1043                   IF RETURN-VALUE = ? OR
     1044                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1045                       curr-widget:READ-ONLY =
     1046                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1047               END.
     1048               WHEN "CLEAR":U THEN
     1049                   curr-widget:SCREEN-VALUE = "":U.
     1050             END CASE.
     1051           END.
     1052           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1053       END.
     1054       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1055         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1056           + '"':U).
     1057       RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE use-check-modified-all :
     1060    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1061     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1062     RETURN.
     1063   END PROCEDURE.
     1064   PROCEDURE use-create-on-add :
     1065   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1066      RETURN.
     1067   END PROCEDURE.
     1068   PROCEDURE use-initial-lock :
     1069     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1070     ASSIGN adm-initial-lock = p-attr-value.
     1071     RETURN.
     1072   END PROCEDURE.
     1073     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1074   ASSIGN
     1075          FRAME F-Main:SCROLLABLE       = FALSE
     1076          FRAME F-Main:HIDDEN           = TRUE.
     1077   ASSIGN
     1078          TOG-prt:HIDDEN IN FRAME F-Main           = TRUE.
     1079   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1080   DO:
     1081       Assign Classify.
     1082   END.
     1083   ON VALUE-CHANGED OF SortType IN FRAME F-Main
     1084   DO:
     1085     ASSIGN SortType.
     1086   END.
     1087   if not this-procedure :persistent
     1088   then do:
     1089     message
     1090       vss-workfile vss-revision vss-description skip
     1091       "Ошибка при запуске процедуры" skip
     1092       "Данную процедуру следует запускать только с параметром persistent" skip
     1093       view-as alert-box error .
     1094     undo, return error .
     1095   end.
     1096   PROCEDURE disable_UI :
     1097     HIDE FRAME F-Main.
     1098     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1099   END PROCEDURE.
     1100   PROCEDURE my-report :
     1101     define variable v-type as character no-undo .
     1102     define variable v-tmp as character no-undo .
     1103     if num-entries (reportname , "|" ) < 3 then message "Ошибка программирования".
     1104     v-tmp  = entry ( 2 , reportname , "|" ) .
     1105     v-type = entry ( 3 , reportname , "|" ) .
     1106     case v-type :
     1107       when "2" then do:
     1108           run rep/r-prqnty.p
     1109               ( v-tmp,
     1110                 p-curr-code,
     1111                 classify,
     1112                 sorttype
     1113                 ) .
     1114       end.
     1115       when "3" then do:
     1116           run rep/r-prsum.p
     1117               ( v-tmp,
     1118                 p-curr-code,
     1119                 classify,
     1120                 sorttype
     1121                 ) .
     1122       end.
     1123       when "4" then do:
     1124           run rep/r-prtnv.p
     1125               ( v-tmp,
     1126                 p-curr-code,
     1127                 classify,
     1128                 sorttype
     1129                 ) .
     1130       end.
     1131       when "5" then do:
     1132           run rep/r-prcus.p
     1133               ( v-tmp,
     1134                 p-curr-code,
     1135                 classify,
     1136                 sorttype
     1137                 ) .
     1138       end.
     1139     end case.
     1140   END PROCEDURE.
     1141   PROCEDURE my-var :
     1142   assign frame F-Main Classify SortType.
     1143   def var t-class as char no-undo.
     1144   def var t-sort as char no-undo.
     1145     case classify:
     1146       when "no-classify":u    then t-class =   "Без классификации" .
     1147       when "prod":u           then t-class =   "Производители"   .
     1148       when "post":u           then t-class =   "Поставщики"   .
     1149       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1150       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1151       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1152       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1153       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1154       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1155       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1156       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1157       when  "t-level":u       then t-class =   "Терминальные группы" .
     1158    end case.
     1159     case sorttype:
     1160       when "sort-pp":u               then t-sort =   "по порядку" .
     1161       when "sort-code":u             then t-sort =   "по коду" .
     1162       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1163       when "sort-qunty":u            then t-sort =   "по реализации".
     1164       when "sort-name":u             then t-sort =   "по наименованию".
     1165       when "sort-type":u             then t-sort =   "по типу ткани".
     1166       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1167       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1168    end case.
     1169   define variable v-radio-customer as integer no-undo .
     1170   define variable v-radio-schet    as integer no-undo .
     1171   define variable v-curr-code      as integer no-undo .
     1172   define variable v-radio-period   as character no-undo .
     1173   define variable v-keep-spis      as character no-undo .
     1174   run get-var-from-1-report-page (
     1175       output v-radio-customer ,
     1176       output v-radio-schet,
     1177       output v-curr-code,
     1178       output v-radio-period ,
     1179       output v-keep-spis ) .
     1180   x-date-end = x-date-alone.
     1181   if v-radio-schet =      7
     1182       then
     1183       assign
     1184         p-ch-val = true
     1185         p-curr-code   = v-curr-code
     1186         .
     1187       else assign
     1188         p-ch-val = false
     1189         p-curr-code   = ?
     1190       .
     1191   END PROCEDURE.
     1192   procedure get-var-from-1-report-page :
     1193    do
     1194    on error undo, return error return-value
     1195    :
     1196   define output parameter p-customer as integer no-undo .
     1197   define output parameter p-schet    as integer no-undo .
     1198   define output parameter p-curr-code as integer no-undo .
     1199   define output parameter p-period    as character no-undo .
     1200   define output parameter p-keep-spis  as character no-undo .
     1201   define variable v-res as character no-undo .
     1202     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1203     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1204       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1205       State-source = WIDGET-HANDLE ( source-str ).
     1206       IF not VALID-HANDLE ( State-source ) THEN
     1207         Message "Не определен линк " 'State':U view-as alert-box error.
     1208     END.
     1209    run get-attribute in state-source  ( 'KEEP-SPIS':U ).
     1210     v-res = return-value .
     1211     if v-res = ? or v-res = "" then p-keep-spis = ? .
     1212                                else p-keep-spis = return-value .
     1213    run get-attribute in state-source  ( 'RADIO-PERIOD':U ).
     1214     v-res = return-value .
     1215     if v-res = ? or v-res = "" then p-period = ? .
     1216                                else p-period = return-value .
     1217    run get-attribute in state-source  ( 'RADIO-CUSTOMER':U ).
     1218     v-res = return-value .
     1219     if v-res = ? or v-res = "" then p-customer = ? .
     1220                                else p-customer = integer (return-value) .
     1221    run get-attribute in state-source  ( 'RADIO-SCHET':U ).
     1222     v-res = return-value .
     1223     if v-res = ? or v-res = "" then p-schet = ? .
     1224                                else p-schet = integer (return-value) .
     1225    run get-attribute in state-source  ( 'EX-CURR-CODE':U ).
     1226     v-res = return-value .
     1227     if v-res = ? or v-res = "" then p-curr-code = ? .
     1228                                else p-curr-code = integer (return-value) .
     1229    end.
     1230   end procedure.
     1231   PROCEDURE state-changed :
     1232     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1233     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1234     CASE p-state:
     1235     END CASE.
     1236   END PROCEDURE.
