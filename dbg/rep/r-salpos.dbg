     1263     PUT stream PrnLibStream string("Фирма: " + clients.obj-name + " (" + string(v-cntxt-host-code-obj) + ") ,валюта: " + buf_currency.curr-abbr) format "X(100)"   skip .
     1264     for each temp-doc no-lock :
     1265       run prn-line in this-procedure .
     1266     end.
