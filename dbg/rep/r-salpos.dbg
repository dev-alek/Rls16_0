      629   define  stream PrnLibStream.
      630   procedure prn-lib-prn-file :
      631     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      632     define input parameter p-DIsabledoptions as integer no-undo .
      633     define variable v-report-name as character no-undo .
      634     define variable v-user-action as character no-undo .
      635     define variable v-printed     as logical   no-undo .
      636     define variable v-exist       as logical   no-undo .
      637     do
      638       on error undo, return error
      639       :
      640       run prn-lib-get-report-name  in this-procedure (
      641         input parParentProc
      642         ,output v-report-name
      643         ).
      644   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      646     (input  v-report-name
      647     ,input  2
      648     ,output v-exist
      649     )  .
      650       if NOT v-exist then
      651       DO:
      652         Message
      653           "Нет заданий на печать ! "
      654           view-as alert-box .
      655         Return  .
      656       End.
      657       run gbl/prnfilen.w
      658         (input  ""
      659         ,input  p-DisabledOptions
      660         ,input  string(v-report-name )
      661         ,input  7
      662         ,output v-user-action
      663         ,output v-printed
      664         ) .
      665       if v-printed then
      666       do:
      667         return "YES" .
      668       end.
      669       else
      670       do:
      671         return "NO" .
      672       end.
      673     end.
      674   end procedure.
      675   procedure prn-lib-open-stream :
      676     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      677     define input parameter p-page-size    as integer no-undo .
      678     define input parameter p-is-stream    as logical no-undo .
      679     define input parameter p-append       as logical no-undo .
      680     define variable v-report-name as character no-undo .
      681     do
      682       on error undo, return error
      683       :
      684       run prn-lib-get-report-name  in this-procedure (
      685         input parParentProc
      686         ,output v-report-name
      687         ).
      688       if p-is-stream then
      689       do:
      690         if p-append then
      691         do:
      692           output stream PrnLibStream to value( v-report-name )
      693             page-size value(p-page-size) append .
      694         end.
      695         if not p-append then
      696         do:
      697           output stream PrnLibStream to value( v-report-name )
      698             page-size value(p-page-size) .
      699         end.
      700       end.
      701       if not p-is-stream then
      702       do:
      703         if p-append then
      704         do:
      705           output to value( v-report-name )
      706             page-size value(p-page-size) append .
      707         end.
      708         if not p-append then
      709         do:
      710           output to value( v-report-name )
      711             page-size value(p-page-size) .
      712         end.
      713       end.
      714     end.
      715   end procedure.
      716   procedure prn-lib-open-exp :
      717     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      718     define input parameter p-is-stream    as logical no-undo .
      719     define input parameter p-is-append    as logical no-undo .
      720     define output parameter p-ReportFileName as char init "report" no-undo.
      721     define output parameter p-process as logical no-undo .
      722     define variable glog as logical no-undo .
      723     do
      724       on error undo, return error
      725       :
      726       SYSTEM-DIALOG GET-FILE p-ReportFileName
      727         TITLE      "Укажите путь"
      728         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      729         ASK-OVERWRITE
      730         CREATE-TEST-FILE
      731         SAVE-AS
      732         USE-FILENAME
      733         DEFAULT-EXTENSION "txt"
      734         UPDATE glog
      735         .
      736       if not glog then  return.
      737       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      738       if p-is-stream then
      739       do:
      740         if p-is-append then
      741         do:
      742           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      743         end.
      744         else
      745         do:
      746           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      747         end.
      748       end.
      749       else
      750       do:
      751         if p-is-append then
      752         do:
      753           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      754         end.
      755         else
      756         do:
      757           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      758         end.
      759       end.
      760       p-process = yes.
      761     end.
      762   end procedure.
      763   procedure prn-lib-get-report-name :
      764     define input parameter parParentProc  as widget-handle no-undo.
      765     define output parameter p-report-name as character no-undo .
      766     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      767   end procedure.
      768   procedure prn-lib-reportviewer-report-name :
      769     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      770     define input parameter p-report-name-html as character no-undo .
      771     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      772   end procedure.
      773   procedure prn-lib-reportviewer :
      774     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      775     define input parameter p-report-name-html as character no-undo .
      776     define input parameter p-param        as character no-undo .
      777     define variable v-excel           as character no-undo init 'TRUE' .
      778     define variable v-value-character as character no-undo .
      779     define variable v-value-integer   as character no-undo .
      780     define variable v-value-date      as date      no-undo .
      781     define variable v-value-decimal   as decimal   no-undo .
      782     define variable rep-excel         as logical   no-undo .
      783     define variable excel-string      as character no-undo .
      784     define variable v-param-type      as character no-undo .
      785     define variable v-tth             as handle    no-undo .
      786     run adm/shattri.p (
      787       input "get":U
      788       ,input  ""
      789       ,input  0
      790       ,input  'report-glob':U
      791       ,input  'rep-excel':U
      792       ,output v-value-character
      793       ,output v-value-date
      794       ,output v-value-decimal
      795       ,output v-value-integer
      796       ,output rep-excel
      797       ,output v-param-type
      798       ,INPUT-OUTPUT table-handle v-tth
      799       )  .
      800     if rep-excel then v-excel = "TRUE" .
      801     else v-excel = "FALSE" .
      802     if p-param eq ""
      803     then
      804        p-param = "EXCEL:" + v-excel.
      805     else
      806        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      807     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      808   end procedure.
      809     define variable v-ind             as integer   no-undo .
      810     define variable ii as integer initial 0  no-undo .
      811     define variable Counter1               as integer   no-undo .
      812     define variable Line                   as character no-undo .
      813     define variable v-all-sum1        as decimal   no-undo .
      814     define variable v-all-sum2        as decimal   no-undo .
      815     define variable v-all-sum3        as decimal   no-undo .
      816     define variable v-all-sum4        as decimal   no-undo .
      817     define variable v-NameString  as character no-undo .
      818     assign  Counter1 = 0 .
      819   define variable v-account as integer init 0 no-undo .
      820   define variable v-account-lavel as character no-undo .
      821   define variable v-button-stop as logical no-undo .
      822   define variable v-kol-spice as integer no-undo .
      823   define variable v-kol-spice2 as integer no-undo .
      824   define variable v-kol-spice3 as integer no-undo .
      825   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      826   DEFINE BUTTON StopBtn AUTO-END-KEY
      827        LABEL "Стоп"
      828        SIZE 10 BY 1.
      829   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      830        LABEL "Обработано записей"
      831         VIEW-AS TEXT
      832        SIZE 14 BY .67 NO-UNDO.
      833   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      834         VIEW-AS TEXT
      835        SIZE 53.25 BY .67
      836        FGCOLOR 1  NO-UNDO.
      837   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      838         VIEW-AS TEXT
      839        SIZE 53.25 BY .67
      840        FGCOLOR 1  NO-UNDO.
      841   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      842         VIEW-AS TEXT
      843        SIZE 53.25 BY .67
      844        FGCOLOR 1  NO-UNDO.
      845   DEFINE RECTANGLE RECT-1
      846        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      847        SIZE 55.13 BY 4.46.
      848   DEFINE FRAME InfoFrame
      849        StopBtn AT ROW 4.25 COL 21.75
      850        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      851        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      852        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      853        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      854        RECT-1 AT ROW 1 COL 1
      855       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      856            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      857            TITLE "Процесс"
      858            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      859   define variable mFrameView      as logical   no-undo init yes.
      860     define variable mFramHandle as handle no-undo.
      861     mFramHandle = frame InfoFrame:handle.
      862     if  log-manager:logfile-name ne ?
      863     then DO:
      864         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      865         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      866         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      867     end.
      868     mFrameView = not session:batch-mode and mFramHandle:visible.
      869     if mFrameView
      870     then do:
      871       ASSIGN
      872          FRAME InfoFrame:HIDDEN                           = TRUE
      873          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      874     end.
      875   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      876   DO:
      877     IF not StopProcessing THEN
      878       Message "Вы действительно хотите прервать" SKIP
      879               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      880                 UPDATE StopProcessing.
      881     IF StopProcessing THEN do:
      882        if mFrameView
      883        then do:
      884           HIDE FRAME InfoFrame.
      885        end.
      886     End.
      887   END.
      888   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
      889     if  log-manager:logfile-name ne ?
      890     then DO:
      891         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      892     end.
      893     if not session:batch-mode then
      894     do:
      895       VIEW FRAME InfoFrame.
      896       mFrameView = true.
      897     end.
      898      v-button-stop = false .
      899         if mFrameView
      900         then do:
      901         if v-button-stop then view STOPBTN in frame InfoFrame.
      902                          else Hide STOPBTN in frame InfoFrame.
      903         end.
      904     define buffer buf_currency  for currency .
      905     define buffer buf_parts     for parts .
      906     define buffer buf_contract  for contract .
      907     define buffer buf_clients   for clients .
      908     define buffer buf_fin-ob    for fin-ob .
      909     define buffer buf_fin-doc   for fin-doc .
      910   if session :set-wait-state( "compiler" ) then.
      911     DEFINE temp-table temp-obj no-undo
      912       field   obj-name     as character
      913       field   obj-type     as character
      914       field   obj-code     as integer
      915       INDEX pi  IS PRIMARY   obj-type obj-code
      916     .
      917     for each store no-lock where store.host-code = v-cntxt-host-code-obj :
      918       find first clients no-lock where clients.obj-type = 'скл':U and clients.obj-code = store.obj-code no-error .
      919       if available clients then do:
      920         create temp-obj .
      921         assign  temp-obj.obj-name = clients.obj-name    temp-obj.obj-type = clients.obj-type    temp-obj.obj-code = clients.obj-code   .
      922       end.
      923     end.
      924     for each shop no-lock where shop.host-code = v-cntxt-host-code-obj :
      925       find first clients no-lock where clients.obj-type = 'маг':U and clients.obj-code = shop.obj-code no-error .
      926       if available clients then do:
      927         create temp-obj .
      928         assign  temp-obj.obj-name = clients.obj-name    temp-obj.obj-type = clients.obj-type    temp-obj.obj-code = clients.obj-code   .
      929       end.
      930     end.
      931     DEFINE temp-table temp-doc no-undo
      932       field   sum1          as decimal
      933       field   sum2          as decimal
      934       field   sum3          as decimal
      935       field   sum4          as decimal
      936       field   cli-name     as character
      937       field   cli-type     as character
      938       field   cli-code     as integer
      939       INDEX pi  IS PRIMARY   cli-type cli-code
      940     .
      941     find first G#CUSTOMER no-error .
      942     if not available G#CUSTOMER then do:
      943       for each buf_contract no-lock
      944         where buf_contract.host-code = v-cntxt-host-code-obj
      945           break by buf_contract.cli-type by buf_contract.cli-code
      946         :
      947         if first-of(buf_contract.cli-code) then do:
      948           find first buf_clients no-lock where buf_clients.obj-type = buf_contract.cli-type and buf_clients.obj-code = buf_contract.cli-code no-error .
      949           if not available buf_clients then next .
      950   define variable vss-include-info12 as character format "X(65)" no-undo
      951   initial "@(#)$Workfile$ $Revision$".
      952     create temp-doc .
      953     assign
      954       temp-doc.cli-type = buf_clients.obj-type
      955       temp-doc.cli-code = buf_clients.obj-code
      956       temp-doc.cli-name = buf_clients.obj-name
      957       temp-doc.sum1     = 0
      958       temp-doc.sum2     = 0
      959       temp-doc.sum3     = 0
      960       temp-doc.sum4     = 0
      961     .
      962     for each temp-obj :
      963       for each buf_parts no-lock
      964         where buf_parts.host-code = v-cntxt-host-code-obj
      965           and buf_parts.supp-type = buf_clients.obj-type
      966           and buf_parts.supp-code = buf_clients.obj-code
      967           and buf_parts.status_   = no
      968           and buf_parts.obj-type  = temp-obj.obj-type
      969           and buf_parts.obj-code  = temp-obj.obj-code
      970           and buf_parts.rsrv-free = yes
      971           and buf_parts.out-code  = 'free-zone':U
