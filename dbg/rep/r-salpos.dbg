     1287   procedure prn-line :
     1288     do on error undo, return error return-value :
     1289       assign
     1290         v-NameString = temp-doc.cli-type + " " + string(temp-doc.cli-code) + " " + temp-doc.cli-name
     1291         v-all-sum1 = v-all-sum1 + temp-doc.sum1
     1292         v-all-sum2 = v-all-sum2 + temp-doc.sum2
     1293         v-all-sum3 = v-all-sum3 + temp-doc.sum3
     1294         v-all-sum4 = v-all-sum4 + temp-doc.sum4
     1295       .
     1296       display stream PrnLibStream
     1297         sym1  v-NameString
     1298         sym2  temp-doc.sum1
     1299         sym3  temp-doc.sum2
     1300         sym4  temp-doc.sum3
     1301         sym5  temp-doc.sum4
     1302         sym6
     1303       with frame f-doc.
     1304       down stream PrnLibStream with frame f-doc .
     1305     end.
