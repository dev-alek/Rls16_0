     3703     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ap [i] -  b1-oborot-ap[3] ),  i). end.
