     3552   end procedure.
     3553   procedure display-b1  :
     3554   define variable ll as int no-undo.
     3555   define variable kk as int no-undo.
     3556     b1-null-str# = 1.
     3557     b1-null-str2# = 1.
     3558     if not show-negativ   then  run b1-null-str-pr   in this-procedure .
     3559     if not show-negativ-2 then  run b1-null-str-pr2  in this-procedure .
     3560      if not     ( not show-negativ   and b1-null-str#  = 0  ) then do :
     3561         if not  ( not show-negativ-2 and b1-null-str2# = 0  ) then do :
     3562                 if sums-only then do:
     3563                     if fr0 = true then do:
     3564                           num#str# = num#str# + 1     .
     3565                           num#col# = 1.
     3566                           run macr_excel_char_with_format(  caps(tmp#stroka0)  , num#str# , num#col#  ) .
     3567                           run macr_cell_format
     3568                           ( 10    ,
     3569                             true  ,
     3570                             true  ,
     3571                             36    ,
     3572                             num#str# ,
     3573                             num#col# ,
     3574                             num#str# ,
     3575                             5 ) .
     3576                         fr0 = false .
     3577                       end.
     3578                  end.
     3579     num#str# = num#str# + 1     .
     3580     num#col# = 2 .
     3581     if substitute( "&1", sf1:screen-value )  <> "?" then
     3582       run macr_excel_char_with_format(  string(s-bar-code +
     3583                                    sf1:screen-value +
     3584                                    gds-zap-artic +
     3585                                    sf2:screen-value +
     3586                                    gds-zap-gds-name +
     3587                                    temp-str-2    )  , num#str# , num#col#  ) .
     3588      else
     3589       run macr_excel_char_with_format(  string(s-bar-code +
     3590                                    gds-zap-artic +
     3591                                    gds-zap-gds-name +
     3592                                    temp-str-2    )  , num#str# , num#col#  ) .
     3593     num#col#  = 0 .
     3594     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3595     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3596     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3597     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3598     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3599     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3600   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3601   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3602   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3603   def var l-nk as integer no-undo .
     3604     Assign
     3605       LL = 0
     3606       KK = 1
     3607     .
     3608     if xShowCost      Then DO: KK = KK + 1. End.
     3609     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3610     if xShowCrsa      Then DO: KK = KK + 1. End.
     3611     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3612     if xShowSale      Then DO: KK = KK + 1. End.
     3613     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3614     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3615     if xShowmediator  Then DO: KK = KK + 1. End.
     3616     if x-tog-wt       then do: KK = KK + 1. End.
     3617     if x-tog-ms       then do: KK = KK + 1. End.
     3618     if xDens          then do: KK = KK + 1. End.
     3619     repeat i = 1 to 13 :
     3620       if i = 7 then next.
     3621       if NOT xShowCost      and i = 2   Then  next.
     3622       if NOT xShowCostNDS   and i = 3   Then  next.
     3623       if NOT xShowCrsa      and i = 5   Then  next.
     3624       if NOT xShowCrsaNds   and i = 6   Then  next.
     3625       if NOT xShowSale      and i = 8   Then  next.
     3626       if NOT xShowSaleNds   and i = 9   Then  next.
     3627       if NOT xShowSaleSlt   and i = 10  Then  next.
     3628       if NOT xShowmediator  and i = 4   Then  next.
     3629       if not x-tog-wt       and i = 11  then  next.
     3630       if not x-tog-ms       and i = 12  then  next.
     3631       if not xDens          and i = 13  then  next.
     3632       assign
     3633         LL = LL + 1
     3634         l-nk = mp-1
     3635       .
     3636     if x-vat or i <> 2  then do:
     3637     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-ostatok-start                          [i] ,  i). end.
     3638     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ie          [i] ,  i). end.
     3639     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-iv          [i] ,  i). end.
     3640     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-im           [i] ,  i). end.
     3641     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ee          [i] ,  i). end.
     3642     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ev          [i] ,  i). end.
     3643     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-em           [i] ,  i). end.
     3644     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-we          [i] ,  i). end.
     3645     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-es     [i] ,  i). end.
     3646     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-rs [i] ,  i). end.
     3647     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-re      [i] ,  i). end.
     3648     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ep       [i] ,  i). end.
