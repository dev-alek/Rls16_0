     5118   procedure ex-display :
     5119   define input parameter par-1 as int no-undo.
     5120   define input parameter par-2 like  ostatok-start[1] no-undo.
     5121   define input parameter par-i as int no-undo.
     5122     assign num#col#  = par-1.
     5123     if par-i = 13 then do:
     5124       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     5125     end.
     5126     else do:
     5127       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     5128         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     5129       end.
     5130       else do :
     5131         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     5132       end.
     5133     end.
     5134   end procedure.
     5135   procedure u-line:
     5136   end procedure.
     5137   procedure p-line:
     5138   end procedure.
     5139   procedure make-col :
     5140    define variable l#1 as int  no-undo.
     5141    define variable l#2 as int  no-undo.
     5142    define variable l as int  no-undo.
     5143     assign
     5144       nk = 0
     5145       kk = 0
     5146     .
     5147     if xshowcost     then do: kk = kk + 1. end.
     5148     if xshowcostnds  then do: kk = kk + 1. end.
     5149     if xshowcrsa     then do: kk = kk + 1. end.
     5150     if xshowcrsands  then do: kk = kk + 1. end.
     5151     if xshowsale     then do: kk = kk + 1. end.
     5152     if xshowsalends  then do: kk = kk + 1. end.
     5153     if xshowsaleslt  then do: kk = kk + 1. end.
     5154     if xshowmediator then do: kk = kk + 1. end.
     5155     if x-tog-wt      then do: kk = kk + 1. end.
     5156     if x-tog-ms      then do: kk = kk + 1. end.
     5157     if xDens         then do: kk = kk + 1. end.
     5158    assign
     5159     num#str# = num#str# + 1
     5160     num#col#  = 0
     5161    .
     5162    if use-column[28] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "№ "              , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5163    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5164    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5165    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5166    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     5167    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     5168    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5169    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5170    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5171       mp = num#col#  + 1.
     5172       mp-1 = num#col#  .
     5173    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5174    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5175    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5176    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5177    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5178    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5179    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5180    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5181    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5182    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5183    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5184    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5185    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5186    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5187    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5188    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5189    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5190    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5191    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5192       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     5193      num#str# = num#str# + 1.
     5194      repeat l#1 = mp to nk :
     5195            l#2 = 0.
     5196                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "количество"  , num#str# , num#col#  ) .
     5197            if xshowcost    then do:
     5198                l#2 = l#2 + 1.
     5199                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн. сумма"  , num#str# , num#col#  ) .
     5200                end.
     5201            if xshowcostnds then do:
     5202                l#2 = l#2 + 1.
     5203                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн.НДС"  , num#str# , num#col#  ) .
     5204               end.
     5205            if xshowmediator then do:
     5206               l#2 = l#2 + 1.
     5207               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "цены поср."  , num#str# , num#col#  ) .
     5208               end.
     5209            if xshowcrsa    then do:
     5210               l#2 = l#2 + 1.
     5211               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж. сумма"  , num#str# , num#col#  ) .
     5212               end.
     5213            if xshowcrsands then do:
     5214               l#2 = l#2 + 1.
     5215               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж.НДС"  , num#str# , num#col#  ) .
     5216               end.
     5217             if xshowsale    then do:
     5218               l#2 = l#2 + 1.
     5219               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док. сумма"  , num#str# , num#col#  ) .
     5220               end.
     5221            if xshowsalends then do:
     5222               l#2 = l#2 + 1.
     5223               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НДС"  , num#str# , num#col#  ) .
     5224               end.
     5225            if xshowsaleslt then do:
     5226               l#2 = l#2 + 1.
     5227               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НсП"  , num#str# , num#col#  ) .
     5228            end.
     5229            if x-tog-wt then do:
     5230             assign
     5231               l#2 = l#2 + 1
     5232               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5233             .
     5234             run macr_excel_char_with_format( "вес"  , num#str# , num#col#  ) .
     5235            end.
     5236            if x-tog-ms then do:
     5237             assign
     5238               l#2 = l#2 + 1
     5239               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5240             .
     5241             run macr_excel_char_with_format( "объем"  , num#str# , num#col#  ) .
     5242            end.
     5243            if xDens then do:
     5244             assign
     5245               l#2 = l#2 + 1
     5246               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5247             .
     5248             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     5249            end.
     5250        end.
     5251   end procedure .
     5252   procedure make-tt-ed :
     5253   create temp#sum-type.
     5254   assign temp#sum-type.sum-type = 'csdt':U + 'ie':U temp#sum-type.xi = 1 . create temp#sum-type.
     5255   assign temp#sum-type.sum-type = 'csdt':U + 'ee':U temp#sum-type.xi = 2 . create temp#sum-type.
     5256   assign temp#sum-type.sum-type = 'csdt':U + 'ep':U temp#sum-type.xi = 3 . create temp#sum-type.
     5257   assign temp#sum-type.sum-type = 'csdt':U + 'es':U temp#sum-type.xi = 4 . create temp#sum-type.
     5258   assign temp#sum-type.sum-type = 'csdt':U + 're':U temp#sum-type.xi = 5 . create temp#sum-type.
     5259   assign temp#sum-type.sum-type = 'csdt':U + 'rs':U temp#sum-type.xi = 6 . create temp#sum-type.
     5260   assign temp#sum-type.sum-type = 'csdt':U + 'we':U temp#sum-type.xi = 7 . create temp#sum-type.
     5261   assign temp#sum-type.sum-type = 'csdt':U + 'vt':U temp#sum-type.xi = 8 . create temp#sum-type.
     5262   assign temp#sum-type.sum-type = 'csdt':U + 'iv':U temp#sum-type.xi = 9 . create temp#sum-type.
     5263   assign temp#sum-type.sum-type = 'csdt':U + 'ev':U temp#sum-type.xi = 10. create temp#sum-type.
     5264   assign temp#sum-type.sum-type = 'csdt':U + 'rv':U temp#sum-type.xi = 11. create temp#sum-type.
     5265   assign temp#sum-type.sum-type = 'csdt':U + 'em':U temp#sum-type.xi = 12 . create temp#sum-type.
     5266   assign temp#sum-type.sum-type = 'csdt':U + 'wm':U temp#sum-type.xi = 12 . create temp#sum-type.
     5267   assign temp#sum-type.sum-type = 'csdt':U + 'im':U temp#sum-type.xi = 13 . create temp#sum-type.
     5268   assign temp#sum-type.sum-type = 'csdt':U + 'ot':U temp#sum-type.xi = 14 .
     5269   create temp#sum-type.
     5270   assign temp#sum-type.sum-type = 'csdt':U + 'ap':U temp#sum-type.xi = 15 . create temp#sum-type.
     5271   assign temp#sum-type.sum-type = 'csdt':U + 'pc':U temp#sum-type.xi = 16 .
     5272   create temp#sum-type.
     5273   assign temp#sum-type.sum-type = 'cgdt':U + 'ie':U temp#sum-type.xi = 101 . create temp#sum-type.
     5274   assign temp#sum-type.sum-type = 'cgdt':U + 'ee':U temp#sum-type.xi = 102 . create temp#sum-type.
     5275   assign temp#sum-type.sum-type = 'cgdt':U + 'ep':U temp#sum-type.xi = 103 . create temp#sum-type.
     5276   assign temp#sum-type.sum-type = 'cgdt':U + 'es':U temp#sum-type.xi = 104 . create temp#sum-type.
     5277   assign temp#sum-type.sum-type = 'cgdt':U + 're':U temp#sum-type.xi = 105 . create temp#sum-type.
     5278   assign temp#sum-type.sum-type = 'cgdt':U + 'rs':U temp#sum-type.xi = 106 . create temp#sum-type.
     5279   assign temp#sum-type.sum-type = 'cgdt':U + 'we':U temp#sum-type.xi = 107 . create temp#sum-type.
     5280   assign temp#sum-type.sum-type = 'cgdt':U + 'vt':U temp#sum-type.xi = 108 . create temp#sum-type.
     5281   assign temp#sum-type.sum-type = 'cgdt':U + 'iv':U temp#sum-type.xi = 109 . create temp#sum-type.
     5282   assign temp#sum-type.sum-type = 'cgdt':U + 'ev':U temp#sum-type.xi = 110 . create temp#sum-type.
     5283   assign temp#sum-type.sum-type = 'cgdt':U + 'rv':U temp#sum-type.xi = 111 . create temp#sum-type.
     5284   assign temp#sum-type.sum-type = 'cgdt':U + 'em':U temp#sum-type.xi = 112 . create temp#sum-type.
     5285   assign temp#sum-type.sum-type = 'cgdt':U + 'wm':U temp#sum-type.xi = 112 . create temp#sum-type.
     5286   assign temp#sum-type.sum-type = 'cgdt':U + 'im':U temp#sum-type.xi = 113 . create temp#sum-type.
     5287   assign temp#sum-type.sum-type = 'cgdt':U + 'ot':U temp#sum-type.xi = 114 .
     5288   create temp#sum-type.
     5289   assign temp#sum-type.sum-type = 'cgdt':U + 'ap':U temp#sum-type.xi = 115 . create temp#sum-type.
     5290   assign temp#sum-type.sum-type = 'cgdt':U + 'pc':U temp#sum-type.xi = 116 .
     5291   create temp#sum-type.
     5292   assign temp#sum-type.sum-type = 'sadt':U + 'ie':U temp#sum-type.xi = 201 . create temp#sum-type.
     5293   assign temp#sum-type.sum-type = 'sadt':U + 'ee':U temp#sum-type.xi = 202 . create temp#sum-type.
     5294   assign temp#sum-type.sum-type = 'sadt':U + 'ep':U temp#sum-type.xi = 203 . create temp#sum-type.
     5295   assign temp#sum-type.sum-type = 'sadt':U + 'es':U temp#sum-type.xi = 204 . create temp#sum-type.
     5296   assign temp#sum-type.sum-type = 'sadt':U + 're':U temp#sum-type.xi = 205 . create temp#sum-type.
     5297   assign temp#sum-type.sum-type = 'sadt':U + 'rs':U temp#sum-type.xi = 206 . create temp#sum-type.
     5298   assign temp#sum-type.sum-type = 'sadt':U + 'we':U temp#sum-type.xi = 207 . create temp#sum-type.
     5299   assign temp#sum-type.sum-type = 'sadt':U + 'vt':U temp#sum-type.xi = 208 . create temp#sum-type.
     5300   assign temp#sum-type.sum-type = 'sadt':U + 'iv':U temp#sum-type.xi = 209 . create temp#sum-type.
     5301   assign temp#sum-type.sum-type = 'sadt':U + 'ev':U temp#sum-type.xi = 210 . create temp#sum-type.
     5302   assign temp#sum-type.sum-type = 'sadt':U + 'rv':U temp#sum-type.xi = 211 . create temp#sum-type.
     5303   assign temp#sum-type.sum-type = 'sadt':U + 'em':U temp#sum-type.xi = 212 . create temp#sum-type.
     5304   assign temp#sum-type.sum-type = 'sadt':U + 'wm':U temp#sum-type.xi = 212 . create temp#sum-type.
     5305   assign temp#sum-type.sum-type = 'sadt':U + 'im':U temp#sum-type.xi = 213 . create temp#sum-type.
     5306   assign temp#sum-type.sum-type = 'sadt':U + 'ot':U temp#sum-type.xi = 214 .
     5307   create temp#sum-type.
     5308   assign temp#sum-type.sum-type = 'sadt':U + 'ap':U temp#sum-type.xi = 215 . create temp#sum-type.
     5309   assign temp#sum-type.sum-type = 'sadt':U + 'pc':U temp#sum-type.xi = 216 .
     5310   end procedure.
     5311   procedure new-tmp-page :
     5312    do
     5313    on error undo, return error return-value
     5314    :
     5315       if   num#str#  >=  63000  then do:
     5316           output stream macr_excel  close .
     5317           run paramls-write in this-procedure
     5318             (input "file"
     5319             ,input string(v-ind)
     5320             ,input v-file-name
     5321             ) .
     5322           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5323           output stream  macr_excel to value(v-file-name) .
     5324           v-ind = v-ind + 1 .
     5325           num#str# = 0 .
     5326   define variable old-s as integer no-undo .
     5327   define variable old-s2 as integer no-undo .
     5328       assign
     5329       old-s =   num#str#
     5330       .
     5331       run make-col .
     5332       assign
     5333         old-s2 =   num#str#
     5334       .
     5335      num#str# = old-s + 1  .
     5336      run proc-print-header .
     5337      num#str# = old-s2     .
     5338       end.
     5339    end.
     5340   end procedure.
     5341   procedure pp :
     5342   define input parameter ll as integer no-undo .
     5343   define input parameter uu as integer no-undo .
     5344   define input parameter ff as character no-undo .
     5345   End procedure.
     5346   procedure find-last-prise-med :
     5347   define input parameter p-artic     like ub.goods.artic no-undo .
     5348   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5349   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5350   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5351   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5352   define buffer p-gds-obj   for  ub.gds-obj .
     5353   define buffer buf_trn-doc for  ub.trn-doc .
     5354   define variable v-fact-order as decimal no-undo .
     5355   p-price = 0 .
     5356     define variable v-in-date as date      no-undo .
     5357     define variable fl as logical no-undo .
     5358     fl = yes.
     5359     v-fact-order = 0 .
     5360     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5361     :
     5362       find first p-gds-obj no-lock
     5363         where p-gds-obj.artic     = p-artic         and
     5364                 p-gds-obj.prod-type = p-prod-type     and
     5365                 p-gds-obj.prod-code = p-prod-code     and
     5366                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5367                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5368         no-error .
     5369       if available p-gds-obj then do:
     5370       if p-gds-obj.in-date = ?  then next .
     5371       if fl = yes then do:
     5372         assign
     5373           v-in-date = p-gds-obj.in-date
     5374           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5375           fl = no
     5376       .
     5377        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5378        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5379       end.
     5380         if p-gds-obj.in-date >= v-in-date   then do:
     5381            if p-gds-obj.in-date = v-in-date then do:
     5382               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5383               if available buf_trn-doc  then
     5384                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5385                     assign
     5386                       v-fact-order = buf_trn-doc.fact-order
     5387                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5388                       v-in-date =   p-gds-obj.in-date
     5389                     .
     5390                   end.
     5391            end.
     5392            else do:
     5393             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5394             if available buf_trn-doc  then
     5395                 assign
     5396                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5397                   v-in-date =    p-gds-obj.in-date
     5398                   v-fact-order = buf_trn-doc.fact-order .
     5399                 .
     5400             end.
     5401           if p-price = ? then   p-price  = 0 .
     5402         end.
     5403       end.
     5404     End .
     5405     if p-price = ? then   p-price  = 0 .
     5406   end procedure.
     5407   procedure find-mediator :
     5408   define input  parameter c-host-code as integer no-undo .
     5409   define input  parameter p-Showmediatr as logical no-undo .
     5410   define output parameter p-host-code as integer no-undo .
     5411   define output parameter p-flag as logical no-undo .
     5412   define buffer b-sysconf  for ub.sysconf.
     5413    p-host-code = 0 .
     5414    p-flag  = true .
     5415       if p-Showmediatr = true then do:
     5416       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5417             if avail ub.sysconf then DO :
     5418               p-host-code = ub.sysconf.host-code.
     5419               if tPrintRubl = false then do:
     5420                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5421                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5422                                 p-flag  = false  .
     5423                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5424                                 view-as alert-box error.
     5425                           end.
     5426               end.
     5427             end.
     5428             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5429                 create tt-obj-list no-error .
     5430                 assign tt-obj-list.obj-type = 'маг':U
     5431                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5432             end.
     5433             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5434                 create tt-obj-list no-error .
     5435                 assign tt-obj-list.obj-type = 'скл':U
     5436                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5437             end.
     5438       End.
     5439    End procedure .
     5440   PROCEDURE ob-line-stk  :
     5441   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5442   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5443   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5444   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5445   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5446   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5447   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5448   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5449   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5450   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5451   define input  parameter xTog-obj         as log                     no-undo.
     5452   define input  parameter xi               as int                     no-undo.
     5453   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5454   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5455   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5456   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5457   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5458   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5459   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5460   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5461   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5462   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5463   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5464   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5465   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5466   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5467   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5468   define buffer stk-line2 for ub.stk-line .
     5469   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5470    Assign
     5471      First-qnty  = 0
     5472      Second-qnty = 0
     5473      Quntity     = 0
     5474      First-sum  = 0
     5475      Second-sum = 0
     5476      sum        = 0
     5477      First-vat  = 0
     5478      Second-vat = 0
     5479      vat        = 0
     5480      First-slt   = 0
     5481      Second-slt  = 0
     5482      slt         = 0
     5483      First-disc  = 0
     5484      Second-disc = 0
     5485      disc        = 0
     5486     .
     5487     For each obj-list  no-lock :
     5488      if  xTog-obj THEN
     5489          if   NOT(    x-store-type     = obj-list.obj-type
     5490               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5491      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5492         find last ub.stk-line no-lock
     5493           where ub.stk-line.obj-type   = obj-list.obj-type
     5494             and ub.stk-line.obj-code   = obj-list.obj-code
     5495             and ub.stk-line.artic      = x-artic
     5496             and ub.stk-line.prod-type  = x-prod-type
     5497             and ub.stk-line.prod-code  = x-prod-code
     5498             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5499             and ub.stk-line.cat-id     = '##,##':U
     5500             and ub.stk-line.fact-order <= x-fact-order-1
     5501           use-index category
     5502           no-error .
     5503         if available ub.stk-line then do:
     5504           assign
     5505             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5506             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5507             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5508             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5509             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5510           .
     5511         end.
     5512         find last stk-line2 no-lock
     5513           where stk-line2.obj-code   = obj-list.obj-code
     5514             and stk-line2.obj-type   = obj-list.obj-type
     5515             and stk-line2.artic      = x-artic
     5516             and stk-line2.prod-type  = x-prod-type
     5517             and stk-line2.prod-code  = x-prod-code
     5518             and stk-line2.sum-type   = temp#sum-type.sum-type
     5519             and stk-line2.cat-id     = '##,##':U
     5520             and stk-line2.fact-order <= x-fact-order-2
     5521           use-index category
     5522           no-error .
     5523         if available stk-line2 then do:
     5524           assign
     5525             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5526             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5527             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5528             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5529             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5530           .
     5531         end.
     5532      end.
     5533    end.
     5534    Assign
     5535      Quntity = Second-qnty - first-qnty
     5536      sum     = Second-sum  - first-sum
     5537      vat     = Second-vat  - first-vat
     5538      slt     = Second-slt  - first-slt
     5539      disc    = Second-disc  - first-disc
     5540      .
     5541   END PROCEDURE.
     5542   procedure calc-ms-wt :
     5543   define input        parameter p-oborot-num      as decimal   no-undo .
     5544   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5545   define input-output parameter p-oborot          as decimal   no-undo .
     5546   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5547   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5548   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5549   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5550   do
     5551   on error undo, return error return-value
     5552   :
     5553   if p-is-petrol = true then return .
     5554     assign
     5555       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5556       p-bi-oborot = p-bi-oborot + p-oborot
     5557       p-bo-oborot = p-bo-oborot + p-oborot
     5558       p-b1-oborot = p-b1-oborot + p-oborot
     5559       p-b2-oborot = p-b2-oborot + p-oborot
     5560     .
     5561   end.
     5562   end procedure.
     5563   procedure calc-dens :
     5564   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5565   define input        parameter p-ostatok          as decimal   no-undo .
     5566   define input-output parameter p-density          as decimal   no-undo .
     5567   define input-output parameter p-bi-density       as decimal   no-undo .
     5568   define input-output parameter p-bo-density       as decimal   no-undo .
     5569   define input-output parameter p-b1-density       as decimal   no-undo .
     5570   define input-output parameter p-b2-density       as decimal   no-undo .
     5571   do
     5572   on error undo, return error return-value
     5573   :
     5574   if p-is-petrol = false then return .
     5575     assign
     5576       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5577       p-bi-density = 0
     5578       p-bo-density = 0
     5579       p-b1-density = 0
     5580       p-b2-density = 0
     5581     .
     5582   end.
     5583   end procedure.
     5584   procedure calc-pt-ob :
     5585   define input  parameter p-ext-doc-type    as character no-undo .
     5586   define input  parameter x-store-type      as character no-undo .
     5587   define input  parameter x-store-code      as integer   no-undo .
     5588   define input  parameter p-artic           as character no-undo .
     5589   define input  parameter p-prod-type       as character no-undo .
     5590   define input  parameter p-prod-code       as integer   no-undo .
     5591   define input-output parameter p-oborot    as decimal   no-undo .
     5592   define input-output parameter p-bi-oborot as decimal   no-undo .
     5593   define input-output parameter p-bo-oborot as decimal   no-undo .
     5594   define input-output parameter p-b1-oborot as decimal   no-undo .
     5595   define input-output parameter p-b2-oborot as decimal   no-undo .
     5596     do
     5597     on error undo, return error return-value
     5598     :
     5599   define variable v-oborot as decimal   no-undo .
     5600   define buffer buf_doc-line  for ub.doc-line  .
     5601   define buffer buf_inv-line  for ub.inv-line  .
     5602   define buffer buf1_obj-list for obj-list .
     5603   assign
     5604     v-oborot = 0
     5605   .
     5606   if p-is-petrol = false   then return .
     5607     for each buf1_obj-list no-lock :
     5608      if  xtog-obj then
     5609          if   not(x-store-type     = buf1_obj-list.obj-type
     5610               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5611       for each buf_doc-line  no-lock where
     5612             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5613             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5614             buf_doc-line.artic        = p-artic and
     5615             buf_doc-line.prod-type    = p-prod-type and
     5616             buf_doc-line.prod-code    = p-prod-code and
     5617             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5618             buf_doc-line.status_      = 'факт':U        and
     5619             buf_doc-line.fact-order   <= fact-order-2  and
     5620             buf_doc-line.fact-order   >= fact-order-1
     5621             :
     5622             for each buf_inv-line  no-lock where
     5623                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5624                 buf_inv-line.artic        = buf_doc-line.artic and
     5625                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5626                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5627                 :
     5628                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5629                     else do:
     5630                     if p-ext-doc-type = 'we':U    or
     5631                        p-ext-doc-type = 'ee':U    or
     5632                        p-ext-doc-type = 'ev':U    or
     5633                        p-ext-doc-type = 'ep':U or
     5634                        p-ext-doc-type = 'em':U     or
     5635                        p-ext-doc-type = 'wm':U     or
     5636                        p-ext-doc-type = 'es':U   then
     5637                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5638                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5639                     end.
     5640             end.
     5641       end.
     5642   end.
     5643   assign
     5644     p-oborot    = v-oborot
     5645     p-bi-oborot = p-bi-oborot + v-oborot
     5646     p-bo-oborot = p-bo-oborot + v-oborot
     5647     p-b1-oborot = p-b1-oborot + v-oborot
     5648     p-b2-oborot = p-b2-oborot + v-oborot
     5649   .
     5650   end.
     5651   end procedure.
     5652   procedure calc-density :
     5653   define input        parameter p-ext-doc-type  as character no-undo .
     5654   define input        parameter x-store-type    as character no-undo .
     5655   define input        parameter x-store-code    as integer   no-undo .
     5656   define input        parameter p-artic         as character no-undo .
     5657   define input        parameter p-prod-type     as character no-undo .
     5658   define input        parameter p-prod-code     as integer   no-undo .
     5659   define input-output parameter p-density       as decimal   no-undo .
     5660   define input-output parameter p-bi-density    as decimal   no-undo .
     5661   define input-output parameter p-bo-density    as decimal   no-undo .
     5662   define input-output parameter p-b1-density    as decimal   no-undo .
     5663   define input-output parameter p-b2-density    as decimal   no-undo .
     5664     do
     5665     on error undo, return error return-value
     5666     :
     5667   define variable v-oborot    as decimal   no-undo .
     5668   define variable v-fact-qnty as decimal   no-undo .
     5669   define buffer buf_doc-line  for ub.doc-line  .
     5670   define buffer buf_inv-line  for ub.inv-line  .
     5671   define buffer buf1_obj-list for obj-list .
     5672   assign
     5673     v-oborot     = 0
     5674     v-fact-qnty  = 0
     5675   .
     5676   if p-is-petrol = false   then return .
     5677     for each buf1_obj-list no-lock :
     5678      if  xtog-obj then
     5679          if   not(x-store-type     = buf1_obj-list.obj-type
     5680               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5681       for each buf_doc-line  no-lock where
     5682             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5683             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5684             buf_doc-line.artic        = p-artic and
     5685             buf_doc-line.prod-type    = p-prod-type and
     5686             buf_doc-line.prod-code    = p-prod-code and
     5687             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5688             buf_doc-line.status_      = 'факт':U        and
     5689             buf_doc-line.fact-order   <= fact-order-2  and
     5690             buf_doc-line.fact-order   >= fact-order-1
     5691             :
     5692             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5693             for each buf_inv-line  no-lock where
     5694                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5695                 buf_inv-line.artic        = buf_doc-line.artic and
     5696                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5697                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5698                 :
     5699                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5700                     else do:
     5701                     if p-ext-doc-type = 'we':U    or
     5702                        p-ext-doc-type = 'ee':U    or
     5703                        p-ext-doc-type = 'ev':U    or
     5704                        p-ext-doc-type = 'ep':U or
     5705                        p-ext-doc-type = 'em':U     or
     5706                        p-ext-doc-type = 'wm':U     or
     5707                        p-ext-doc-type = 'es':U   then
     5708                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5709                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5710                     end.
     5711             end.
     5712       end.
     5713       assign
     5714         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5715       .
     5716       assign
     5717         p-bi-density = p-density
     5718         p-bo-density = 0
     5719         p-b1-density = 0
     5720         p-b2-density = 0
     5721       .
     5722   end.
     5723   end.
     5724   end procedure.
