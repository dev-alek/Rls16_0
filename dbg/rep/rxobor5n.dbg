     3699     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-rv      [i] -  b1-oborot-rv      [3] ),  i). end.
