      169   procedure create_obj-list :
      170      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      171      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      172      do
      173      on error undo, return error return-value
      174      :
      175         define buffer cli-obj for ub.clients .
      176         define variable p-var as integer no-undo .
      177         define buffer buf_obj-list for obj-list .
      178         find last buf_obj-list  use-index pi no-error .
      179         if available buf_obj-list
      180         then
      181            p-var = buf_obj-list.obj-id + 1.
      182         else
      183            p-var = 1.
      184         find first cli-obj where
      185                   cli-obj.obj-type = p-obj-type
      186               and cli-obj.obj-code = p-obj-code
      187         no-lock no-error.
      188         if available cli-obj
      189         then do:
      190            create buf_obj-list.
      191            assign
      192               buf_obj-list.obj-id   = p-var
      193               buf_obj-list.obj-code = cli-obj.obj-code
      194               buf_obj-list.obj-type = cli-obj.obj-type
      195               buf_obj-list.obj-name = cli-obj.obj-name
      196               buf_obj-list.db-num   = cli-obj.db-num
      197            .
      198         end.
      199      end.
      200   end.
