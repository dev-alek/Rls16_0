     3978   procedure ob-line  :
     3979   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3980   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3981   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3982   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3983   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3984   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3985   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3986   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3987   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3988   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3989   define input  parameter xtog-obj           as log no-undo.
     3990   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3991   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3992   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3993   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3994   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3995   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3996   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3997   define variable  v-summa  as decimal extent 4 no-undo .
     3998   define variable  tt#          as int no-undo.
     3999   define variable v-ii as integer no-undo .
     4000   define variable slt  as decimal no-undo .
     4001   define variable disc  as decimal no-undo .
     4002   define variable xi as integer no-undo .
     4003   define variable v-tt as integer no-undo .
     4004    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     4005       else
     4006       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     4007       else
     4008       assign tt# = 6  v-tt = 200.
     4009     if long-p = false then do :
     4010     for each obj-list no-lock:
     4011      if  xtog-obj then
     4012          if   not(x-store-type     = obj-list.obj-type
     4013               and x-store-code    = obj-list.obj-code ) then next.
     4014           for each ub.ot-line where
     4015                     ub.ot-line.artic         = x-artic
     4016               and   ub.ot-line.prod-code    = x-prod-code
     4017               and   ub.ot-line.prod-type    = x-prod-type
     4018               and   ub.ot-line.fact-order   <= x-fact-order-2
     4019               and   ub.ot-line.fact-order   >= x-fact-order-1
     4020               and   ub.ot-line.obj-code     = obj-list.obj-code
     4021               and   ub.ot-line.obj-type     = obj-list.obj-type
     4022               and   ub.ot-line.sum-type     = x-sum-type
     4023               no-lock :
     4024               case ub.ot-line.ext-doc-type:
     4025     WHEN 'ie':U THEN DO:
     4026       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     4027             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4028             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4029         if tt# = 6 Then   assign
     4030             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4031             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4032             End.
     4033     WHEN 'ee':U THEN DO:
     4034       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     4035             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4036             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4037         if tt# = 6 Then   assign
     4038             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4039             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4040             End.
     4041     WHEN 'ep':U THEN DO:
     4042       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     4043             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4044             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4045         if tt# = 6 Then   assign
     4046             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4047             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4048             End.
     4049     WHEN 'es':U THEN DO:
     4050       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     4051             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4052             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4053         if tt# = 6 Then   assign
     4054             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
