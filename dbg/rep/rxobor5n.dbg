     3650     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-vt                [i] ,  i). end.
     3651     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ot           [i] ,  i). end.
     3652     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-ostatok-end                            [i] ,  i). end.
     3653     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ap [i] ,  i). end.
     3654     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-pc [i] ,  i). end.
     3655     if i = 13 then do:
     3656       if "b1-" = "b1-" or "b1-" = "b2-" or "b1-" = "bi-" or "b1-" = "bo-" then do:
     3657          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3658       end.
     3659       else do:
     3660         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(b1-oborot-ee         [1] +
     3661                                                                                                                                       b1-oborot-re     [1] +
     3662                                                                                                                                       b1-oborot-es    [1] +
     3663                                                                                                                                       b1-oborot-rs[1] ) <> 0
     3664                                                                                                                               then
     3665                                                                                                                                   ABS(b1-oborot-ee         [11] +
     3666                                                                                                                                       b1-oborot-re     [11] +
     3667                                                                                                                                       b1-oborot-es    [11] +
     3668                                                                                                                                       b1-oborot-rs[11] )
     3669                                                                                                                                   /
     3670                                                                                                                                   ABS(b1-oborot-ee         [1] +
     3671                                                                                                                                       b1-oborot-re     [1] +
     3672                                                                                                                                       b1-oborot-es    [1] +
     3673                                                                                                                                       b1-oborot-rs[1] )
     3674                                                                                                                               else 0 )
     3675         ,  i). end.
     3676       end.
     3677     end.
     3678     else do:
     3679     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (b1-oborot-ee         [i] +
     3680                                                                                                                           b1-oborot-re     [i] +
     3681                                                                                                                           b1-oborot-es    [i] +
     3682                                                                                                                           b1-oborot-rs[i] )
     3683     ,  i). end.
     3684     end.
     3685     end.
     3686     if x-vat = false  and i = 2 then do:
     3687     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-ostatok-start                          [i] -  b1-ostatok-start                          [3] ),  i). end.
     3688     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ie          [i] -  b1-oborot-ie          [3] ),  i). end.
     3689     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-iv          [i] -  b1-oborot-iv          [3] ),  i). end.
     3690     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-im           [i] -  b1-oborot-im           [3] ),  i). end.
     3691     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ee          [i] -  b1-oborot-ee          [3] ),  i). end.
     3692     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ev          [i] -  b1-oborot-ev          [3] ),  i). end.
     3693     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-em           [i] -  b1-oborot-em           [3] ),  i). end.
     3694     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-we          [i] -  b1-oborot-we          [3] ),  i). end.
     3695     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-es     [i] -  b1-oborot-es     [3] ),  i). end.
     3696     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-rs [i] -  b1-oborot-rs [3] ),  i). end.
     3697     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-re      [i] -  b1-oborot-re      [3] ),  i). end.
