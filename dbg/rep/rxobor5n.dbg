     3814         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(b2-oborot-ee         [1] +
     3815                                                                                                                                       b2-oborot-re     [1] +
     3816                                                                                                                                       b2-oborot-es    [1] +
     3817                                                                                                                                       b2-oborot-rs[1] ) <> 0
     3818                                                                                                                               then
     3819                                                                                                                                   ABS(b2-oborot-ee         [11] +
     3820                                                                                                                                       b2-oborot-re     [11] +
     3821                                                                                                                                       b2-oborot-es    [11] +
     3822                                                                                                                                       b2-oborot-rs[11] )
     3823                                                                                                                                   /
     3824                                                                                                                                   ABS(b2-oborot-ee         [1] +
     3825                                                                                                                                       b2-oborot-re     [1] +
     3826                                                                                                                                       b2-oborot-es    [1] +
     3827                                                                                                                                       b2-oborot-rs[1] )
     3828                                                                                                                               else 0 )
     3829         ,  i). end.
     3830       end.
