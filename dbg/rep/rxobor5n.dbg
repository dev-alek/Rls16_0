     3024                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     3025                       Create temp-gds-list.
     3026                       Assign
     3027                         temp-gds-list.prod-code = gds-obj.prod-code
     3028                         temp-gds-list.grp-name  = gds-obj.grp-name
     3029                         temp-gds-list.gds-name  = goods.gds-name
     3030                         temp-gds-list.gds-code  = gds-obj.gds-code
     3031                         temp-gds-list.artic     = gds-obj.artic
     3032                       .
     3033                   End.
     3034               End.
     3035     End.
     3036     for each temp-gds-list no-lock
     3037       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     3038                                        , First clients   where  clients.obj-code = gds-list.prod-code and
     3039                                                                 clients.obj-type = gds-list.prod-type
     3040         BREAK
     3041   BY temp-gds-list.grp-name
     3042   BY ((substring(clients.obj-name,1,10) + string(gds-list.prod-code)))
     3043       BY gds-list.artic :
     3044       run item-goods ( "5" , "gds-list" ) .
     3045         if return-value <> "" then NEXT.
     3046           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     3047           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     3048             Then  Assign
     3049                     S-bar-code   = " Итого по "
     3050                     Gds-zap-artic = Substring(
     3051                                          B2-name
     3052                                         ,1,16)
     3053                     Gds-zap-gds-name = Substring(
     3054                                          B2-name
     3055                                         ,17,40)
     3056                                   .
     3057             Else  Assign
     3058                     S-bar-code   = ""
     3059                     Gds-zap-artic = "        Итого по "
     3060                     Gds-zap-gds-name =   B2-name
     3061                                   .
     3062               Run Display-b1 In This-procedure .
     3063               Run Clear-b1 In This-procedure .
     3064               Assign Break_Group = True.
     3065           End.
     3066           If Last-of(temp-gds-list.grp-name) Then Do:
     3067           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     3068             Then  Assign
     3069                 S-bar-code   = "Итого по "
     3070                 Gds-zap-artic = Substring(
     3071                                      B1-name
     3072                                     ,1,16)
     3073                 Gds-zap-gds-name = Substring(
     3074                                      B1-name
     3075                                     ,17,40)
     3076                               .
     3077             Else Assign
     3078                 S-bar-code = ""
     3079                 Gds-zap-artic = If  ("5" = "4"  Or  "5" = "5") Then "Итого по "
     3080                                                                    Else "  Итого по "
     3081                 Gds-zap-gds-name =   B1-name
     3082                 .
     3083             Run Display-b2 In This-procedure .
     3084             Run Clear-b2 In This-procedure .
     3085             Run Clear-b1 In This-procedure .
     3086             Assign  Break_Group1 = True.
     3087           End.
     3088     End.
     3089   End.
     3090     end.
     3091   end case.
     3092   end procedure.
     3093   procedure calcitog :
     3094       run ostatok  in this-procedure (
     3095           input x-store-code  ,
     3096           input x-store-type  , x-tog-shift ,
     3097           input x-date-start - 1 ,
     3098           input date('')      , x-Shift-Start,x-Shift-End,
     3099           input 'crsa':U   ,
     3100           input '##,##':U,
     3101           input xtog-obj ,
     3102           output  quantity1  ,
     3103           output  coast_r1   ,
     3104           output  coast_v1   ,
     3105           output  vat_r1     ,
     3106           output  vat_v1     ,
     3107           output  fact-order-1 ).
     3108       run ostatok  in this-procedure (
     3109           input x-store-code  ,
     3110           input x-store-type  , x-tog-shift ,
     3111           input x-date-start  ,
     3112           input x-date-end    , x-Shift-Start,x-Shift-End,
     3113           input 'crsa':U   ,
     3114           input '##,##':U,
     3115           input xtog-obj ,
     3116           output  quantity1  ,
     3117           output  coast_r1   ,
     3118           output  coast_v1   ,
     3119           output  vat_r1     ,
     3120           output  vat_v1     ,
     3121           output  fact-order-2 ).
     3122             quantity1  = 0.
     3123             coast_r1   = 0.
     3124             coast_v1   = 0.
     3125             vat_r1     = 0.
     3126             vat_v1     = 0.
     3127   end procedure.
     3128   procedure display-str1  :
     3129   define variable ll as int no-undo.
     3130     assign
     3131       num#str# = num#str# + 1
     3132       num#col# = 0
     3133       v-gds-num = v-gds-num + 1
     3134     .
     3135     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     3136     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     3137     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     3138     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     3139     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     3140     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     3141   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3142   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3143   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3144   def var l-nk as integer no-undo .
     3145     Assign
     3146       LL = 0
     3147       KK = 1
     3148     .
     3149     if xShowCost      Then DO: KK = KK + 1. End.
     3150     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3151     if xShowCrsa      Then DO: KK = KK + 1. End.
     3152     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3153     if xShowSale      Then DO: KK = KK + 1. End.
     3154     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3155     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3156     if xShowmediator  Then DO: KK = KK + 1. End.
     3157     if x-tog-wt       then do: KK = KK + 1. End.
     3158     if x-tog-ms       then do: KK = KK + 1. End.
     3159     if xDens          then do: KK = KK + 1. End.
     3160     repeat i = 1 to 13 :
     3161       if i = 7 then next.
     3162       if NOT xShowCost      and i = 2   Then  next.
     3163       if NOT xShowCostNDS   and i = 3   Then  next.
     3164       if NOT xShowCrsa      and i = 5   Then  next.
     3165       if NOT xShowCrsaNds   and i = 6   Then  next.
     3166       if NOT xShowSale      and i = 8   Then  next.
     3167       if NOT xShowSaleNds   and i = 9   Then  next.
     3168       if NOT xShowSaleSlt   and i = 10  Then  next.
     3169       if NOT xShowmediator  and i = 4   Then  next.
     3170       if not x-tog-wt       and i = 11  then  next.
     3171       if not x-tog-ms       and i = 12  then  next.
     3172       if not xDens          and i = 13  then  next.
     3173       assign
     3174         LL = LL + 1
     3175         l-nk = mp-1
     3176       .
     3177     if x-vat or i <> 2  then do:
     3178     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-start                          [i] ,  i). end.
     3179     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ie          [i] ,  i). end.
     3180     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-iv          [i] ,  i). end.
     3181     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-im           [i] ,  i). end.
     3182     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ee          [i] ,  i). end.
     3183     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ev          [i] ,  i). end.
     3184     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-em           [i] ,  i). end.
     3185     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-we          [i] ,  i). end.
     3186     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-es     [i] ,  i). end.
     3187     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rs [i] ,  i). end.
     3188     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-re      [i] ,  i). end.
     3189     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ep       [i] ,  i). end.
     3190     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rv      [i] ,  i). end.
     3191     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-vt                [i] ,  i). end.
     3192     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ot           [i] ,  i). end.
     3193     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-end                            [i] ,  i). end.
     3194     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ap [i] ,  i). end.
     3195     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-pc [i] ,  i). end.
     3196     if i = 13 then do:
     3197       if "" = "b1-" or "" = "b2-" or "" = "bi-" or "" = "bo-" then do:
     3198          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3199       end.
     3200       else do:
     3201         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(oborot-ee         [1] +
     3202                                                                                                                                       oborot-re     [1] +
     3203                                                                                                                                       oborot-es    [1] +
     3204                                                                                                                                       oborot-rs[1] ) <> 0
     3205                                                                                                                               then
     3206                                                                                                                                   ABS(oborot-ee         [11] +
     3207                                                                                                                                       oborot-re     [11] +
     3208                                                                                                                                       oborot-es    [11] +
     3209                                                                                                                                       oborot-rs[11] )
     3210                                                                                                                                   /
     3211                                                                                                                                   ABS(oborot-ee         [1] +
     3212                                                                                                                                       oborot-re     [1] +
     3213                                                                                                                                       oborot-es    [1] +
     3214                                                                                                                                       oborot-rs[1] )
     3215                                                                                                                               else 0 )
     3216         ,  i). end.
     3217       end.
     3218     end.
     3219     else do:
     3220     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (oborot-ee         [i] +
     3221                                                                                                                           oborot-re     [i] +
     3222                                                                                                                           oborot-es    [i] +
     3223                                                                                                                           oborot-rs[i] )
     3224     ,  i). end.
     3225     end.
     3226     end.
     3227     if x-vat = false  and i = 2 then do:
     3228     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( ostatok-start                          [i] -  ostatok-start                          [3] ),  i). end.
     3229     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ie          [i] -  oborot-ie          [3] ),  i). end.
     3230     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-iv          [i] -  oborot-iv          [3] ),  i). end.
     3231     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-im           [i] -  oborot-im           [3] ),  i). end.
     3232     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ee          [i] -  oborot-ee          [3] ),  i). end.
     3233     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ev          [i] -  oborot-ev          [3] ),  i). end.
     3234     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-em           [i] -  oborot-em           [3] ),  i). end.
     3235     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-we          [i] -  oborot-we          [3] ),  i). end.
     3236     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-es     [i] -  oborot-es     [3] ),  i). end.
     3237     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-rs [i] -  oborot-rs [3] ),  i). end.
     3238     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-re      [i] -  oborot-re      [3] ),  i). end.
     3239     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ep       [i] -  oborot-ep       [3] ),  i). end.
     3240     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-rv      [i] -  oborot-rv      [3] ),  i). end.
     3241     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-vt                [i] -  oborot-vt                [3] ),  i). end.
     3242     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ot           [i] -  oborot-ot           [3] ),  i). end.
     3243     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( ostatok-end                            [i] -  ostatok-end                            [3] ),  i). end.
     3244     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ap [i] -  oborot-ap[3] ),  i). end.
     3245     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-pc [i] -  oborot-pc[3] ),  i). end.
     3246     if i = 13 then do :
     3247       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3248     end.
     3249     else do:
     3250       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3251       (                                                                                      (oborot-ee         [i] +
     3252                                                                                               oborot-re     [i] +
     3253                                                                                               oborot-es    [i] +
     3254                                                                                               oborot-rs[i]) -
     3255                                                                                             (oborot-ee         [3] +
     3256                                                                                               oborot-re     [3] +
     3257                                                                                               oborot-es    [3] +
     3258                                                                                               oborot-rs[3] ) ) , i ). end.
     3259     end.
     3260     end.
     3261     end.
     3262    run new-tmp-page .
     3263   end procedure.
     3264   procedure display-bi  :
     3265   define variable ll as int no-undo.
     3266   define variable kk as int no-undo.
     3267     num#col#  = 0 .
     3268     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3269     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3270     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3271     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3272     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3273     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3274     run macr_cell_format
     3275                                 ( 10    ,
     3276                                   true  ,
     3277                                   false ,
     3278                                   ?    ,
     3279                                   num#str# ,
     3280                                   1 ,
     3281                                   num#str# ,
     3282                                   (mp + ll + (kk * (27 - 8)))
     3283                                   ) .
     3284   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3285   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3286   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3287   def var l-nk as integer no-undo .
     3288     Assign
     3289       LL = 0
     3290       KK = 1
     3291     .
     3292     if xShowCost      Then DO: KK = KK + 1. End.
     3293     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3294     if xShowCrsa      Then DO: KK = KK + 1. End.
     3295     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3296     if xShowSale      Then DO: KK = KK + 1. End.
     3297     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3298     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3299     if xShowmediator  Then DO: KK = KK + 1. End.
     3300     if x-tog-wt       then do: KK = KK + 1. End.
     3301     if x-tog-ms       then do: KK = KK + 1. End.
     3302     if xDens          then do: KK = KK + 1. End.
     3303     repeat i = 1 to 13 :
     3304       if i = 7 then next.
     3305       if NOT xShowCost      and i = 2   Then  next.
     3306       if NOT xShowCostNDS   and i = 3   Then  next.
     3307       if NOT xShowCrsa      and i = 5   Then  next.
     3308       if NOT xShowCrsaNds   and i = 6   Then  next.
     3309       if NOT xShowSale      and i = 8   Then  next.
     3310       if NOT xShowSaleNds   and i = 9   Then  next.
     3311       if NOT xShowSaleSlt   and i = 10  Then  next.
     3312       if NOT xShowmediator  and i = 4   Then  next.
     3313       if not x-tog-wt       and i = 11  then  next.
     3314       if not x-tog-ms       and i = 12  then  next.
     3315       if not xDens          and i = 13  then  next.
     3316       assign
     3317         LL = LL + 1
     3318         l-nk = mp-1
     3319       .
     3320     if x-vat or i <> 2  then do:
