     4198        repeat v-ii = 2 to 4 :
     4199        v-summa[v-ii ]  =
     4200           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4201           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4202           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4203           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4204           oborot-im[v-ii + tt#] .
     4205        end.
     4206         oborot-sum-sale[1] =
     4207         oborot-ee[2 + tt#] +
     4208         oborot-es[2 + tt#] +
     4209         oborot-re[2 + tt#] +
     4210         oborot-rs[2 + tt#]
     4211         .
     4212          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4213           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4214                                                                                                     -  oborot-disc[1]
     4215           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4216           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4217           .
     4218           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4219           if oborot-sum-cost[1] <>  0 then
     4220             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4221             else oborot-prc[1] = 0.
     4222     end.
     4223   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4224   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4225   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4226   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4227   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4228   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4229   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4230   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4231   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4232   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4233   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4234   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4235   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4236   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4237   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4238   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4239   end procedure.
     4240   procedure ost-line :
     4241     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     4242     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     4243     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     4244     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     4245     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     4246     define input  parameter x-tog-shift  as logical no-undo .
     4247     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     4248     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     4249     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     4250     define input  parameter xtog-obj     as logical no-undo .
     4251     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     4252     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     4253     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     4254     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     4255     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     4256     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     4257     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     4258     define buffer buff-obj-list  for obj-list .
     4259     define buffer buff-stk-line  for ub.stk-line .
     4260     assign
     4261       Quantity = 0
     4262       Coast_R  = 0
     4263       Coast_V  = 0
     4264       VAT_R    = 0
     4265       VAT_V    = 0
     4266       SLT_R    = 0
     4267       SLT_V    = 0
     4268     .
     4269     if  x-tog-shift = false then do:
     4270       for each buff-obj-list no-lock
     4271       on error undo, return error
     4272       :
     4273         find last buff-stk-line no-lock
     4274           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4275             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4276             and buff-stk-line.artic      = x-artic
     4277             and buff-stk-line.prod-type  = x-prod-type
     4278             and buff-stk-line.prod-code  = x-prod-code
     4279             and buff-stk-line.sum-type   = x-sum-type
     4280             and buff-stk-line.cat-id     = '##,##':U
     4281             and buff-stk-line.fact-order <= x-fact-order
     4282             and buff-stk-line.shift-num  = 0
     4283           use-index category
     4284           no-error .
     4285         if available buff-stk-line then do:
     4286           assign
     4287             Quantity = Quantity +  buff-stk-line.fact-qnty
     4288             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4289             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4290             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4291             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4292             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4293             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4294           .
     4295         end.
     4296       end.
     4297     end.
     4298     else do:
     4299       for each buff-obj-list no-lock
     4300         where xtog-obj = false
     4301            or (buff-obj-list.obj-type = x-store-type
     4302               and buff-obj-list.obj-code = x-store-code
     4303               )
     4304       on error undo, return error
     4305       :
     4306         find last buff-stk-line no-lock
     4307           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4308             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4309             and buff-stk-line.artic      = x-artic
     4310             and buff-stk-line.prod-type  = x-prod-type
     4311             and buff-stk-line.prod-code  = x-prod-code
     4312             and buff-stk-line.sum-type   = x-sum-type
     4313             and buff-stk-line.cat-id     = '##,##':U
     4314             and buff-stk-line.fact-order <= x-fact-order
     4315             and buff-stk-line.shift-num  > 0
     4316           use-index category
     4317           no-error .
     4318         if available buff-stk-line then do:
     4319           assign
     4320             Quantity = Quantity +  buff-stk-line.fact-qnty
     4321             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4322             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4323             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4324             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4325             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4326             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4327           .
     4328         end.
     4329       end.
     4330     end.
     4331   end procedure.
     4332   procedure ost-lineother-tax :
     4333     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4334     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4335     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4336     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4337     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4338     define input  parameter x-tog-shift  as logical no-undo .
     4339     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4340     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4341     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4342     define input  parameter xTog-obj     as logical no-undo .
     4343     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4344     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4345     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4346     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4347     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4348     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     4349     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     4350     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     4351     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     4352     define buffer buff-obj-list  for obj-list .
     4353     define buffer buff-stk-line  for ub.stk-line .
     4354     assign
     4355       Quantity = 0
     4356       Coast_R  = 0
     4357       Coast_V  = 0
     4358       VAT_R    = 0
     4359       VAT_V    = 0
     4360       SLT_R    = 0
     4361       SLT_V    = 0
     4362       other_R  = 0
     4363       other_V  = 0
     4364     .
     4365     if  x-tog-shift = false then do:
     4366       for each buff-obj-list no-lock
     4367       on error undo, return error
     4368       :
     4369         find last buff-stk-line no-lock
     4370           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4371             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4372             and buff-stk-line.artic      = x-artic
     4373             and buff-stk-line.prod-type  = x-prod-type
     4374             and buff-stk-line.prod-code  = x-prod-code
     4375             and buff-stk-line.sum-type   = x-sum-type
     4376             and buff-stk-line.cat-id     = '##,##':U
     4377             and buff-stk-line.fact-order <= x-fact-order
     4378             and buff-stk-line.shift-num  = 0
     4379           use-index category
     4380           no-error .
     4381         if available buff-stk-line then do:
     4382           assign
     4383             Quantity = Quantity +  buff-stk-line.fact-qnty
     4384             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4385             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4386             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4387             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4388             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4389             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4390             other_R  = other_R  +  buff-stk-line.other-rubl
     4391             other_V  = other_V  +  buff-stk-line.other-base
     4392           .
     4393         end.
     4394       end.
     4395     end.
     4396     else do:
     4397       for each buff-obj-list no-lock
     4398         where xtog-obj = false
     4399            or (buff-obj-list.obj-type = x-store-type
     4400               and buff-obj-list.obj-code = x-store-code
     4401               )
     4402       on error undo, return error
     4403       :
     4404         find last buff-stk-line no-lock
     4405           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4406             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4407             and buff-stk-line.artic      = x-artic
     4408             and buff-stk-line.prod-type  = x-prod-type
     4409             and buff-stk-line.prod-code  = x-prod-code
     4410             and buff-stk-line.sum-type   = x-sum-type
     4411             and buff-stk-line.cat-id     = '##,##':U
     4412             and buff-stk-line.fact-order <= x-fact-order
     4413             and buff-stk-line.shift-num  > 0
     4414           use-index category
     4415           no-error .
     4416         if available buff-stk-line then do:
     4417           assign
     4418             Quantity = Quantity +  buff-stk-line.fact-qnty
     4419             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4420             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4421             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4422             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4423             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4424             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4425             other_R = other_R   +  buff-stk-line.other-rubl
     4426             other_V = other_V   +  buff-stk-line.other-base
     4427           .
     4428         end.
     4429       end.
     4430     end.
     4431   end procedure.
     4432   procedure ost-line-kg :
     4433     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4434     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4435     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4436     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4437     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4438     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4439     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4440     define buffer buff-obj-list  for obj-list .
     4441     define buffer buf_doc-line for ub.doc-line .
     4442     define buffer buf_inv-line for ub.inv-line .
     4443     do
     4444     on error undo, return error
     4445     :
     4446       for each buf_doc-line no-lock where
     4447                buf_doc-line.obj-type    = p-obj-type   and
     4448                buf_doc-line.obj-code    = p-obj-code   and
     4449                buf_doc-line.prod-type   = p-prod-type  and
     4450                buf_doc-line.prod-code   = p-prod-code  and
     4451                buf_doc-line.artic       = p-artic      and
     4452                buf_doc-line.status_     = 'факт':U      and
     4453                buf_doc-line.fact-order <= p-fact-order
     4454             by buf_doc-line.fact-order    descending
     4455       :
     4456         find first buf_inv-line no-lock where
     4457                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4458                    buf_inv-line.artic     = buf_doc-line.artic     and
     4459                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4460                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4461         if available buf_inv-line
     4462         then do:
     4463           if buf_inv-line.after-cli-qnty <> ?
     4464           then do:
     4465             assign
     4466               p-quantity-kg = buf_inv-line.after-cli-qnty
     4467             .
     4468             leave .
     4469           end.
     4470         end.
     4471       end.
     4472       if p-quantity-kg = ?
     4473       then do:
     4474         assign
     4475           p-quantity-kg = 0
     4476         .
     4477       end.
     4478     end.
     4479   end procedure.
     4480   PROCEDURE ostatok :
     4481   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4482   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4483   def input parameter x-tog-shift   as   logical             no-undo.
     4484   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4485   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4486   def input parameter x-shift-start as integer               no-undo.
     4487   def input parameter x-shift-end   as integer               no-undo.
     4488   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4489   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4490   def input parameter xTog-obj   as log no-undo.
     4491   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4492   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4493   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4494   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4495   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4496   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4497   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4498   def var              Fact-orderS   as char  no-undo.
     4499   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4500      Assign
     4501         Fact-order   = 0
     4502         Quantity     = 0
     4503         Coast_R      = 0
     4504         Coast_V      = 0
     4505         VAT_R        = 0
     4506         VAT_V        = 0 .
     4507    x-date-start-t  = x-date-start + 1 .
     4508   IF x-date-end = date('') then DO:
     4509      Fact-order = 0 .
     4510      for each obj-list
     4511          where  ( not xtog-obj or
     4512                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4513                 no-lock :
     4514         if  x-tog-shift = false then do:
     4515                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4516                               ub.stk-tot.Fact-date <=  x-date-start
     4517                               and ub.stk-tot.shift-num = 0
     4518                               USE-INDEX fact-date no-lock no-error .
     4519              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4520         End.
     4521         Else  DO :
     4522             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4523              (ub.stk-tot.shift-date  = x-date-start-t and
     4524               ub.stk-tot.shift-num  < x-shift-start or
     4525               ub.stk-tot.shift-date  < x-date-start-t  )
     4526               and ub.stk-tot.shift-num  > 0
     4527               USE-INDEX Shift-num no-lock no-error .
     4528            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4529           END.
     4530       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4531     End.
     4532   End.
     4533   Else DO:
     4534     For each obj-list  WHERE
     4535        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4536         no-lock :
     4537      IF  x-TOG-Shift = False Then DO:
     4538          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4539               ub.stk-tot.Fact-date <= x-date-end
     4540               and ub.stk-tot.shift-num = 0
     4541               USE-INDEX fact-date no-lock no-error.
     4542          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4543      END.
     4544      Else DO:
     4545           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4546               (ub.stk-tot.shift-date  = x-date-end and
     4547               ub.stk-tot.shift-num  <= x-shift-end or
     4548               ub.stk-tot.shift-date  < x-date-end       ) and
     4549               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4550               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4551       End.
     4552       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4553     End.
     4554   End.
     4555   END PROCEDURE.
     4556   procedure report-exec1  :
     4557      find first clients where x-store-type = clients.obj-type and
     4558                               x-store-code = clients.obj-code
     4559                               no-lock no-error.
     4560              if available clients then assign  objname = clients.obj-name
     4561                                                x-db-num     = clients.db-num.
     4562                                            else  objname="объект не определен".
     4563     run calcitog in this-procedure .
     4564     run print-header in this-procedure .      case retclassify :
     4565      when "grp-goods/prod":u then  run run5 in this-procedure .
     4566      otherwise do:
     4567        message "Ошибка вызова" view-as alert-box error .
     4568      end.
     4569      end case.
     4570     run print-footer in this-procedure .
     4571     end procedure.
     4572   procedure calc-sub-itog :
     4573   define input parameter tt as int no-undo.
     4574   define variable tt2 as integer no-undo .
     4575     if tt = 6 then tt2 = 7 .
     4576               else tt2 = tt.
     4577   repeat i# = 1 + tt to 3 + tt2 :
     4578   run sum-i (
     4579    input oborot-vt[i#]
     4580   ,input tt
     4581   ,input-output b1-oborot-vt[i#]
     4582   ,input-output b2-oborot-vt[i#]
     4583   ,input-output bi-oborot-vt[i#]
     4584   ,input-output bo-oborot-vt[i#]
     4585   ,input oborot-ie[i#]
     4586   ,input-output b1-oborot-ie[i#]
     4587   ,input-output b2-oborot-ie[i#]
     4588   ,input-output bi-oborot-ie[i#]
     4589   ,input-output bo-oborot-ie[i#]
     4590   ) .
     4591   run sum-i (
     4592    input oborot-iv[i#]
     4593   ,input tt
     4594   ,input-output b1-oborot-iv[i#]
     4595   ,input-output b2-oborot-iv[i#]
     4596   ,input-output bi-oborot-iv[i#]
     4597   ,input-output bo-oborot-iv[i#]
     4598   ,input oborot-ee[i#]
     4599   ,input-output b1-oborot-ee[i#]
     4600   ,input-output b2-oborot-ee[i#]
     4601   ,input-output bi-oborot-ee[i#]
     4602   ,input-output bo-oborot-ee[i#]
     4603   ) .
     4604   run sum-i (
     4605    input oborot-ev[i#]
     4606   ,input tt
     4607   ,input-output b1-oborot-ev[i#]
     4608   ,input-output b2-oborot-ev[i#]
     4609   ,input-output bi-oborot-ev[i#]
     4610   ,input-output bo-oborot-ev[i#]
     4611   ,input oborot-ep[i#]
     4612   ,input-output b1-oborot-ep[i#]
     4613   ,input-output b2-oborot-ep[i#]
     4614   ,input-output bi-oborot-ep[i#]
     4615   ,input-output bo-oborot-ep[i#]
     4616   ) .
     4617   run sum-i (
     4618    input oborot-rv[i#]
     4619   ,input tt
     4620   ,input-output b1-oborot-rv[i#]
     4621   ,input-output b2-oborot-rv[i#]
     4622   ,input-output bi-oborot-rv[i#]
     4623   ,input-output bo-oborot-rv[i#]
     4624   ,input oborot-es[i#]
     4625   ,input-output b1-oborot-es[i#]
     4626   ,input-output b2-oborot-es[i#]
     4627   ,input-output bi-oborot-es[i#]
     4628   ,input-output bo-oborot-es[i#]
     4629   ) .
     4630   run sum-i (
     4631    input oborot-em[i#]
     4632   ,input tt
     4633   ,input-output b1-oborot-em[i#]
     4634   ,input-output b2-oborot-em[i#]
     4635   ,input-output bi-oborot-em[i#]
     4636   ,input-output bo-oborot-em[i#]
     4637   ,input oborot-re[i#]
     4638   ,input-output b1-oborot-re[i#]
     4639   ,input-output b2-oborot-re[i#]
     4640   ,input-output bi-oborot-re[i#]
     4641   ,input-output bo-oborot-re[i#]
     4642   ) .
     4643   run sum-i (
     4644    input oborot-im[i#]
     4645   ,input tt
     4646   ,input-output b1-oborot-im[i#]
     4647   ,input-output b2-oborot-im[i#]
     4648   ,input-output bi-oborot-im[i#]
     4649   ,input-output bo-oborot-im[i#]
     4650   ,input oborot-rs[i#]
     4651   ,input-output b1-oborot-rs[i#]
     4652   ,input-output b2-oborot-rs[i#]
     4653   ,input-output bi-oborot-rs[i#]
     4654   ,input-output bo-oborot-rs[i#]
     4655   ) .
     4656   run sum-i (
     4657    input oborot-ot[i#]
     4658   ,input tt
     4659   ,input-output b1-oborot-ot[i#]
     4660   ,input-output b2-oborot-ot[i#]
     4661   ,input-output bi-oborot-ot[i#]
     4662   ,input-output bo-oborot-ot[i#]
     4663   ,input oborot-we[i#]
     4664   ,input-output b1-oborot-we[i#]
     4665   ,input-output b2-oborot-we[i#]
     4666   ,input-output bi-oborot-we[i#]
     4667   ,input-output bo-oborot-we[i#]
     4668   ) .
     4669   run sum-i (
     4670    input oborot-ap[i#]
     4671   ,input tt
     4672   ,input-output b1-oborot-ap[i#]
     4673   ,input-output b2-oborot-ap[i#]
     4674   ,input-output bi-oborot-ap[i#]
     4675   ,input-output bo-oborot-ap[i#]
     4676   ,input oborot-pc[i#]
     4677   ,input-output b1-oborot-pc[i#]
     4678   ,input-output b2-oborot-pc[i#]
     4679   ,input-output bi-oborot-pc[i#]
     4680   ,input-output bo-oborot-pc[i#]
     4681   ) .
     4682     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4683     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4684     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4685     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4686     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4687     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4688     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4689     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4690     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4691     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4692     if i# = 8 then
     4693       assign
     4694         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4695                                 bi-oborot-re[ i#]         +
     4696                                 bi-oborot-rs[ i#]    +
     4697                                 bi-oborot-es[ i#]
     4698         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4699                                 b1-oborot-re[ i#]         +
     4700                                 b1-oborot-rs[ i#]    +
     4701                                 b1-oborot-es[ i#]
     4702         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4703                                 b2-oborot-re[ i#]         +
     4704                                 b2-oborot-rs[ i#]    +
     4705                                 b2-oborot-es[ i#]
     4706         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4707                                 bo-oborot-re[ i#]         +
     4708                                 bo-oborot-rs[ i#]    +
     4709                                 bo-oborot-es[ i#]
     4710         .
     4711     if  xshowmediator = true  then do:
     4712         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4713         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4714         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4715         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4716     end.
     4717     if i# = 2 and xshowmediator = false  then
     4718         assign
     4719           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4720                                   bi-oborot-re[ i#]         +
     4721                                   bi-oborot-rs[ i#]    +
     4722                                   bi-oborot-es[ i#]
     4723           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4724                                   b1-oborot-re[ i#]         +
     4725                                   b1-oborot-rs[ i#]    +
     4726                                   b1-oborot-es[ i#]
     4727           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4728                                   b2-oborot-re[ i#]         +
     4729                                   b2-oborot-rs[ i#]    +
     4730                                   b2-oborot-es[ i#]
     4731           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4732                                   bo-oborot-re[ i#]         +
     4733                                   bo-oborot-rs[ i#]    +
     4734                                   bo-oborot-es[ i#]
     4735           .
     4736     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4737     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4738     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4739     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4740     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4741                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4742                      else bi-oborot-prc[1] = 0.
     4743     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4744                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4745                      else bo-oborot-prc[1] = 0.
     4746     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4747                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4748                      else b1-oborot-prc[1] = 0.
     4749     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4750                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4751                      else b2-oborot-prc[1] = 0.
     4752    end.
     4753   end procedure.
     4754   procedure sum-i :
     4755   define input parameter ob like oborot-ot[1] no-undo.
     4756   define input parameter tt as int  no-undo.
     4757   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4758   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4759   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4760   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4761   define input parameter ob2 like oborot-ot[1] no-undo.
     4762   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4763   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4764   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4765   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4766   assign
     4767    b1  = b1 + ob
     4768    b2  = b2 + ob
     4769    b1- = b1- + ob2
     4770    b2- = b2- + ob2
     4771    .
     4772       assign
     4773       bi = bi + ob
     4774       bo = bo + ob
     4775       bi- = bi- + ob2
     4776       bo- = bo- + ob2
     4777       .
     4778   end procedure.
     4779   procedure clear-item :
     4780   define variable kk as int no-undo.
     4781    repeat kk = 1 to 13 :
     4782    assign
     4783       oborot-ie                 [kk]    = 0
     4784       oborot-ee                 [kk]    = 0
     4785       oborot-ep              [kk]    = 0
     4786       oborot-es            [kk]    = 0
     4787       oborot-re             [kk]    = 0
     4788       oborot-rs        [kk]    = 0
     4789       oborot-we                 [kk]    = 0
     4790       oborot-vt                       [kk]    = 0
     4791       oborot-iv                 [kk]    = 0
     4792       oborot-ev                 [kk]    = 0
     4793       oborot-rv             [kk]    = 0
     4794       oborot-em                  [kk]    = 0
     4795       oborot-wm                  [kk]    = 0
     4796       oborot-im                  [kk]    = 0
     4797       oborot-ot                  [kk]    = 0
     4798       oborot-disc                             [kk]    = 0
     4799       oborot-eff                              [kk]    = 0
     4800       oborot-prc                              [kk]    = 0
     4801       oborot-ap            [kk]    = 0
     4802       oborot-pc            [kk]    = 0
     4803       ostatok-end                                    [kk]    = 0
     4804       ostatok-start                                  [kk]    = 0
     4805     .
     4806    end.
     4807   end procedure.
     4808   procedure item-goods :
     4809    define input parameter  par-3 as char no-undo.
     4810    define input parameter  par-4 as char no-undo.
     4811        if par-4 = "goods":u  then  assign
     4812                                       gds-zap-unit-base  = goods.unit-base
     4813                                       gds-zap-prt-root   = goods.prt-root
     4814                                       gds-zap-prod-type  = goods.prod-type
     4815                                       gds-zap-prod-code  = goods.prod-code
     4816                                       gds-zap-artic      = goods.artic
     4817                                       gds-zap-type       = goods.gds-type
     4818                                       gds-zap-grp-name   = goods.grp-name
     4819                                       gds-zap-b-code     = goods.gds-code
     4820                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4821                                                                          else goods.gds-name
     4822                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4823                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4824        if par-4 = "gds-list":u  then  assign
     4825                                       gds-zap-unit-base  = gds-list.unit-base
     4826                                       gds-zap-prt-root   = gds-list.prt-root
     4827                                       gds-zap-prod-type  = gds-list.prod-type
     4828                                       gds-zap-prod-code  = gds-list.prod-code
     4829                                       gds-zap-artic      = gds-list.artic
     4830                                       gds-zap-type       = gds-list.gds-type
     4831                                       gds-zap-grp-name   = gds-list.grp-name
     4832                                       gds-zap-b-code     = gds-list.gds-code
     4833                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4834                                                                          else gds-list.gds-name
     4835                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4836                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4837       run foreach in this-procedure .
     4838   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4839     (input  gds-zap-b-code
     4840     ,input  ?
     4841     ,output v-bar-code
     4842     )  .
     4843   s-bar-code = string (v-bar-code,"999999999").
     4844       If  break_group = true  and par-3 <> "1"  then DO :
     4845            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4846            gds-zap-prod-name  = clients.obj-name.
     4847             If break_group1 = true  THEN  DO :
     4848               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4849                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4850                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4851               if par-3 = "6"  then  dO:
     4852                  if xTog-obj = true then do:
     4853                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4854                   end.
     4855                  else do:
     4856                   var-vat-pc = temp-gds-list.vat-pc  .
     4857                   end.
     4858                   assign
     4859                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4860                       b1-name = temp-str .
     4861                   end.
     4862               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4863                   fr0 = true .
     4864                   tmp#stroka0 = temp-str.
     4865               End .
     4866             End .
     4867             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4868               if par-3 = "4"
     4869                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4870                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4871               if NOT xSumsOnly THEN DO :
     4872               fr = true .
     4873               End.
     4874               break_group1 = false.
     4875             END.
     4876          break_group = false.
     4877       End.
     4878       run display-line in this-procedure .
     4879    end procedure.
     4880   procedure b1-null-str-pr :
     4881    if (
     4882        b1-oborot-im                 [1] = 0 and
     4883        b1-oborot-wm                 [1] = 0 and
     4884        b1-oborot-em                 [1] = 0 and
     4885        b1-oborot-ie                 [1] = 0 and
     4886        b1-oborot-ee                 [1] = 0 and
     4887        b1-oborot-ep              [1] = 0 and
     4888        b1-oborot-es            [1] = 0 and
     4889        b1-oborot-re             [1] = 0 and
     4890        b1-oborot-rs        [1] = 0 and
     4891        b1-oborot-we                 [1] = 0 and
     4892        b1-oborot-vt                       [1] = 0 and
     4893        b1-oborot-iv                [1] = 0 and
     4894        b1-oborot-ev                [1] = 0 and
     4895        b1-oborot-rv            [1] = 0 and
     4896        b1-oborot-ot                 [2] = 0 and
     4897        b1-oborot-ap           [1] = 0 and
     4898        b1-oborot-pc           [1] = 0 and
     4899        b1-ostatok-end[1]                                    = 0 and
     4900        b1-ostatok-start[1]                                  = 0 and
     4901        b1-oborot-im                 [2] = 0 and
     4902        b1-oborot-wm                 [2] = 0 and
     4903        b1-oborot-em                 [2] = 0 and
     4904        b1-oborot-ie                 [2] = 0 and
     4905        b1-oborot-ee                 [2] = 0 and
     4906        b1-oborot-ep              [2] = 0 and
     4907        b1-oborot-es            [2] = 0 and
     4908        b1-oborot-re             [2] = 0 and
     4909        b1-oborot-rs        [2] = 0 and
     4910        b1-oborot-we                 [2] = 0 and
     4911        b1-oborot-vt                       [2] = 0 and
     4912        b1-oborot-iv                [2] = 0 and
     4913        b1-oborot-ev                [2] = 0 and
     4914        b1-oborot-rv            [2] = 0 and
     4915        b1-oborot-ap           [2] = 0 and
     4916        b1-oborot-pc           [2] = 0 and
     4917        b1-ostatok-end[2]                                    = 0 and
     4918        b1-ostatok-start[2]                                  = 0
