     3849     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-es     [i] -  b2-oborot-es     [3] ),  i). end.
