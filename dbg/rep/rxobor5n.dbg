     1298   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1299   DEFINE BUTTON StopBtn AUTO-END-KEY
     1300        LABEL "Стоп"
     1301        SIZE 10 BY 1.
     1302   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1303        LABEL "Обработано записей"
     1304         VIEW-AS TEXT
     1305        SIZE 14 BY .67 NO-UNDO.
     1306   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1307         VIEW-AS TEXT
     1308        SIZE 53.25 BY .67
     1309        FGCOLOR 1  NO-UNDO.
     1310   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1311         VIEW-AS TEXT
     1312        SIZE 53.25 BY .67
     1313        FGCOLOR 1  NO-UNDO.
     1314   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1315         VIEW-AS TEXT
     1316        SIZE 53.25 BY .67
     1317        FGCOLOR 1  NO-UNDO.
     1318   DEFINE RECTANGLE RECT-1
     1319        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1320        SIZE 55.13 BY 4.46.
     1321   DEFINE FRAME InfoFrame
     1322        StopBtn AT ROW 4.25 COL 21.75
     1323        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1324        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1325        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1326        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1327        RECT-1 AT ROW 1 COL 1
     1328       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1329            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1330            TITLE "Процесс"
     1331            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1332   define variable mFrameView      as logical   no-undo init yes.
     1333     define variable mFramHandle as handle no-undo.
     1334     mFramHandle = frame InfoFrame:handle.
     1335     if  log-manager:logfile-name ne ?
     1336     then DO:
     1337         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1338         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1339         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1340     end.
     1341     mFrameView = not session:batch-mode and mFramHandle:visible.
     1342     if mFrameView
     1343     then do:
     1344       ASSIGN
     1345          FRAME InfoFrame:HIDDEN                           = TRUE
     1346          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1347     end.
     1348   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1349   DO:
     1350     IF not StopProcessing THEN
     1351       Message "Вы действительно хотите прервать" SKIP
     1352               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1353                 UPDATE StopProcessing.
     1354     IF StopProcessing THEN do:
     1355        if mFrameView
     1356        then do:
     1357           HIDE FRAME InfoFrame.
     1358        end.
     1359     End.
     1360   END.
