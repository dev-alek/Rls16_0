     3855     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ot           [i] -  b2-oborot-ot           [3] ),  i). end.
     3856     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-ostatok-end                            [i] -  b2-ostatok-end                            [3] ),  i). end.
     3857     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ap [i] -  b2-oborot-ap[3] ),  i). end.
     3858     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-pc [i] -  b2-oborot-pc[3] ),  i). end.
     3859     if i = 13 then do :
     3860       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3861     end.
     3862     else do:
     3863       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3864       (                                                                                      (b2-oborot-ee         [i] +
     3865                                                                                               b2-oborot-re     [i] +
     3866                                                                                               b2-oborot-es    [i] +
     3867                                                                                               b2-oborot-rs[i]) -
     3868                                                                                             (b2-oborot-ee         [3] +
     3869                                                                                               b2-oborot-re     [3] +
     3870                                                                                               b2-oborot-es    [3] +
     3871                                                                                               b2-oborot-rs[3] ) ) , i ). end.
     3872     end.
     3873     end.
     3874     end.
     3875    run new-tmp-page .
