     3407   procedure display-bo  :
     3408   define variable ll as int no-undo.
     3409   define variable kk as int no-undo.
     3410     num#str# = num#str# + 1.
     3411     num#col# = 1.
     3412     run macr_excel_char_with_format( string("ИТОГО ПО ОБЪЕКТАМ")  , num#str# , num#col#  ) .
     3413     num#col#  = 0 .
     3414     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3415     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3416     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3417     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3418     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3419     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3420     run macr_cell_format
     3421         ( 10    ,
     3422           true  ,
     3423           false ,
     3424           ?    ,
     3425           num#str# ,
     3426           1 ,
     3427           num#str# ,
     3428           (mp + ll + (kk * (27 - 8)))
     3429           ) .
     3430   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3431   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3432   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3433   def var l-nk as integer no-undo .
     3434     Assign
     3435       LL = 0
     3436       KK = 1
     3437     .
     3438     if xShowCost      Then DO: KK = KK + 1. End.
     3439     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3440     if xShowCrsa      Then DO: KK = KK + 1. End.
     3441     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3442     if xShowSale      Then DO: KK = KK + 1. End.
     3443     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3444     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3445     if xShowmediator  Then DO: KK = KK + 1. End.
     3446     if x-tog-wt       then do: KK = KK + 1. End.
     3447     if x-tog-ms       then do: KK = KK + 1. End.
     3448     if xDens          then do: KK = KK + 1. End.
     3449     repeat i = 1 to 13 :
     3450       if i = 7 then next.
     3451       if NOT xShowCost      and i = 2   Then  next.
     3452       if NOT xShowCostNDS   and i = 3   Then  next.
     3453       if NOT xShowCrsa      and i = 5   Then  next.
     3454       if NOT xShowCrsaNds   and i = 6   Then  next.
     3455       if NOT xShowSale      and i = 8   Then  next.
     3456       if NOT xShowSaleNds   and i = 9   Then  next.
     3457       if NOT xShowSaleSlt   and i = 10  Then  next.
     3458       if NOT xShowmediator  and i = 4   Then  next.
     3459       if not x-tog-wt       and i = 11  then  next.
     3460       if not x-tog-ms       and i = 12  then  next.
     3461       if not xDens          and i = 13  then  next.
     3462       assign
     3463         LL = LL + 1
     3464         l-nk = mp-1
     3465       .
     3466     if x-vat or i <> 2  then do:
     3467     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-start                          [i] ,  i). end.
     3468     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ie          [i] ,  i). end.
