      566   define new global shared variable g#library  as handle no-undo .
      567   define new global shared variable g#library2 as handle no-undo .
      568   define variable var-report-r-b as character no-undo .
      569   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      571     (output var-report-r-b
      572     )  .
      573   procedure proc-alt-shift-f2:
      574     if not ibs.th.gbl.gbl-var:rcode
      575   then
      576     run gbl\inidebug.p .
      577   end.
      578   procedure proc-alt-shift-f3:
      579     run gbl/prvssinf.p
      580       ( input this-procedure
      581       ) .
      582   end.
      583   define variable v-inform-launched as logical no-undo initial false .
      584   procedure proc-alt-shift-f4:
      585     define variable v-action as character no-undo .
      586     if v-inform-launched = false then do:
      587       assign
      588         v-inform-launched = true
      589       .
      590       run gbl/d-inform.w
      591         (  input self
      592         ,  input this-procedure
      593         , output v-action
      594         ) no-error .
      595       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      596       assign
      597         v-inform-launched = false
      598       .
      599     end.
      600   end.
      601   procedure proc-alt-f1:
      602     run gbl/corrhelp.p
      603       (input this-procedure
      604       ) .
      605   end .
      606   on alt-shift-f2 anywhere do:
      607     run proc-alt-shift-f2.
      608   end.
      609   on alt-shift-f3 anywhere do:
      610     run proc-alt-shift-f3 in this-procedure .
      611   end.
      612   on alt-shift-f4 anywhere do:
      613     run proc-alt-shift-f4 in this-procedure.
      614   end.
      615   on alt-f1 anywhere do:
      616     run proc-alt-f1 in this-procedure .
      617   end.
      618   DEFINE VARIABLE FILL-IN-1 AS DATE FORMAT "99/99/9999":U
      619        LABEL "на"
      620        VIEW-AS FILL-IN
      621        SIZE 11.38 BY 1 NO-UNDO.
      622   DEFINE RECTANGLE RECT-5
      623        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      624        SIZE 36.38 BY 3.54.
      625   DEFINE RECTANGLE RECT-6
      626        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      627        SIZE 36.38 BY 1.88.
      628   DEFINE VARIABLE NullStr AS LOGICAL INITIAL no
      629        LABEL "Показать нулевые обороты"
      630        VIEW-AS TOGGLE-BOX
      631        SIZE 33 BY .83 NO-UNDO.
      632   DEFINE FRAME F-Main
      633        FILL-IN-1 AT ROW 2.71 COL 5.38 COLON-ALIGNED
      634        NullStr AT ROW 5.58 COL 3.88
      635        "Отсутствующий ассортимент :" VIEW-AS TEXT
      636             SIZE 26.88 BY 1 AT ROW 1.33 COL 2.5
      637             FGCOLOR 4
      638        RECT-5 AT ROW 1.21 COL 1.75
      639        RECT-6 AT ROW 5.13 COL 1.75
      640       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      641            SIDE-LABELS NO-UNDERLINE THREE-D
      642            AT COL 1 ROW 1 SCROLLABLE .
      643   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      644   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      645   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      646   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      647   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      648   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      649   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      650   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      651         adm-object-hdl = FRAME F-Main:HANDLE.
      652   RUN ensure-broker.
      653   THIS-PROCEDURE:ADM-DATA =
      654        'ADM1.1~`':U +
      655        'SmartObject~`':U +
      656        '~`':U +
      657        'NO ~`':U +
      658        '~`':U +
      659        '~`':U +
      660        '~`':U +
      661        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      662           + "~`":U +
      663        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      664        'Record-Source,Record-Target,TableIO-Target~`':U +
      665        '~`':U +
      666        '~`~`~`~`~`~`~`~`~`~`~`':U +
      667        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      668            THEN "^^":U
      669        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      670             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      671   PROCEDURE adm-apply-entry :
      672     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      673   END PROCEDURE.
      674   PROCEDURE adm-destroy :
      675    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      676   END PROCEDURE.
      677   PROCEDURE adm-disable :
      678       DISABLE RECT-5 RECT-6 FILL-IN-1 NullStr WITH FRAME F-Main.
      679       RUN dispatch ('disable-fields':U).
      680       RUN set-attribute-list ('ENABLED=no':U).
      681       RETURN.
      682   END PROCEDURE.
      683   PROCEDURE adm-edit-attribute-list :
      684         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      685         RETURN.
      686   END PROCEDURE.
      687   PROCEDURE adm-enable :
      688       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 FILL-IN-1 NullStr WITH FRAME F-Main.
      689       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      690       RUN set-attribute-list ('ENABLED=yes':U).
      691       RETURN.
      692   END PROCEDURE.
      693   PROCEDURE adm-exit :
      694        RUN notify ('exit':U).
      695     RETURN.
      696   END PROCEDURE.
      697   PROCEDURE adm-hide :
      698     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      699   END PROCEDURE.
      700   PROCEDURE adm-initialize :
      701     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      702   END PROCEDURE.
      703   PROCEDURE adm-show-errors :
      704       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      705       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      706           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      707       END.
      708       RETURN.
      709   END PROCEDURE.
      710   PROCEDURE adm-UIB-mode :
      711     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      712   END PROCEDURE.
      713   PROCEDURE adm-view :
      714     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      715   END PROCEDURE.
      716   PROCEDURE dispatch :
      717       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      718       RUN broker-dispatch IN adm-broker-hdl
      719           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      720       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      721   END PROCEDURE.
      722   PROCEDURE ensure-broker :
      723   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      724   IF RETURN-VALUE NE "ADM-Broker":U THEN
      725   DO:
      726       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      727       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      728   END.
      729   END PROCEDURE.
      730   PROCEDURE get-attribute :
      731     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      732     RUN broker-get-attribute IN adm-broker-hdl
      733         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      734     RETURN RETURN-VALUE.
      735   END PROCEDURE.
      736   PROCEDURE get-attribute-list :
      737     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      738     RUN broker-get-attribute-list IN adm-broker-hdl
      739         (INPUT THIS-PROCEDURE,
      740          INPUT ?,
      741          OUTPUT p-attr-list) NO-ERROR.
      742     RETURN.
      743   END PROCEDURE.
      744   PROCEDURE new-state :
      745     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      746     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      747     RETURN.
      748   END PROCEDURE.
      749   PROCEDURE notify :
      750     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      751     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      752     IF RETURN-VALUE = "ADM-ERROR":U THEN
      753         RETURN "ADM-ERROR":U.
      754     RETURN.
      755   END PROCEDURE.
      756   PROCEDURE set-attribute-list :
      757     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      758     RUN ensure-broker.
      759     RUN broker-set-attribute-list IN adm-broker-hdl
      760         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      761     RETURN.
      762   END PROCEDURE.
      763   PROCEDURE set-position :
      764       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      765       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      766       IF VALID-HANDLE(adm-object-hdl) THEN
      767       DO:
      768         ASSIGN adm-object-hdl:ROW    =   p-row
      769                adm-object-hdl:COLUMN =   p-col.
      770       END.
      771       RETURN.
      772   END PROCEDURE.
      773   PROCEDURE adm-display-fields :
      774       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      775       RETURN.
      776   END PROCEDURE.
      777   PROCEDURE adm-open-query :
      778     RETURN.
      779   END PROCEDURE.
      780   PROCEDURE adm-row-changed :
      781         IF VALID-HANDLE(adm-object-hdl) THEN
      782           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      783         RUN notify ('row-available':U).
      784         RETURN.
      785   END PROCEDURE.
      786   PROCEDURE reposition-query :
      787       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      788       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      789       RETURN.
      790   END PROCEDURE.
      791     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      792     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      793     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      794     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      795     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      796     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      797     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      798     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      799     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      800     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      801     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      802     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      803     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      804     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      805     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      806     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      807     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      808     IF "":U = "":U THEN
      809       RUN modify-list-attribute IN adm-broker-hdl
      810         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      811     RUN use-create-on-add(?).
      812   PROCEDURE adm-add-record :
      813       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      814          "must have at least one Enabled Table to perform Add.":U
      815          VIEW-AS ALERT-BOX ERROR.
