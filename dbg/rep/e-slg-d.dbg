      823      RETURN.
      824     END PROCEDURE.
      825   PROCEDURE adm-assign-statement :
      826     RETURN.
      827   END PROCEDURE.
      828   PROCEDURE adm-cancel-record :
      829      RETURN.
      830     END PROCEDURE.
      831   PROCEDURE adm-copy-record :
      832       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      833        "must have at least one Enabled Table to perform Copy.":U
      834          VIEW-AS ALERT-BOX ERROR.
      835       RETURN.
      836   END PROCEDURE.
      837   PROCEDURE adm-create-record :
      838      RETURN.
      839   END PROCEDURE.
      840   PROCEDURE adm-current-changed :
      841     RETURN.
      842   END PROCEDURE.
      843   PROCEDURE adm-delete-record :
      844    MESSAGE
      845          "Object ":U THIS-PROCEDURE:FILE-NAME
      846            "must have at least one Enabled Table to perform Delete.":U
      847              VIEW-AS ALERT-BOX ERROR.
      848       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      849       RETURN.
      850   END PROCEDURE.
      851   PROCEDURE adm-disable-fields :
      852         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      853       RETURN.
      854   END PROCEDURE.
      855   PROCEDURE adm-enable-fields :
      856       RETURN.
      857   END PROCEDURE.
      858   PROCEDURE adm-end-update :
      859     RETURN.
      860   END PROCEDURE.
      861   PROCEDURE adm-reset-record :
      862       RETURN.
      863   END PROCEDURE.
      864   PROCEDURE adm-update-record :
      865       MESSAGE
      866         "Object ":U THIS-PROCEDURE:FILE-NAME
      867           "must have at least one Enabled Table to perform Update.":U
      868             VIEW-AS ALERT-BOX ERROR.
      869      RETURN.
      870   END PROCEDURE.
      871   PROCEDURE check-modified :
      872   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      873   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      874   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      875   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      876     IF check-state = "check":U THEN
      877     DO:
      878       RUN get-link-handle IN adm-broker-hdl
      879         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      880            OUTPUT group-target-list).
      881       IF group-target-list NE "":U THEN
      882       DO i = 1 TO NUM-ENTRIES(group-target-list):
      883         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      884         RUN check-modified IN curr-widget ('group-check':U).
      885         IF RETURN-VALUE NE "":U THEN
      886         DO:
      887           RUN check-modified-message(RETURN-VALUE).
      888           RETURN "":U.
      889         END.
      890       END.
      891     END.
      892     RETURN "":U.
      893   END PROCEDURE.
      894   PROCEDURE check-modified-message :
      895     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      896        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      897           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      898        IF RETURN-VALUE = "YES":U THEN
      899           RUN notify ('view,CONTAINER-SOURCE':U).
      900        MESSAGE IF p-changed-table NE ? THEN
      901           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      902           ELSE "Current values have been changed."
      903           SKIP "  Do you wish to save those changes?"
      904           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      905        IF ANS THEN
      906        DO:
      907           IF group-assign-target THEN
      908             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      909           ELSE RUN dispatch('update-record':U).
      910           IF RETURN-VALUE = "ADM-ERROR":U THEN
      911           DO:
      912               MESSAGE "Changes to the previous record were not saved."
      913                 VIEW-AS ALERT-BOX ERROR.
      914               IF group-assign-target THEN
      915                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      916               ELSE RUN dispatch ('cancel-record':U).
      917           END.
      918        END.
      919        ELSE DO:
      920          IF group-assign-target THEN
      921             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      922          ELSE RUN dispatch('cancel-record':U).
      923        END.
      924        RETURN.
      925   END PROCEDURE.
      926   PROCEDURE get-rowid :
      927       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      928       ASSIGN
      929       p-table   =   adm-first-table.
      930       RETURN.
      931   END PROCEDURE.
      932   PROCEDURE init-group-assign :
      933       RUN request-attribute IN adm-broker-hdl
      934         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      935       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      936         group-assign-target = yes.
      937       ELSE group-assign-target = no.
      938       RETURN.
      939   END PROCEDURE.
      940   PROCEDURE set-editors :
      941       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      942       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      943       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      944       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      945       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      946       DO WHILE VALID-HANDLE (curr-widget):
      947           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      948              curr-widget:HIDDEN = no THEN DO:
      949             CASE p-field-setting:
      950               WHEN "INITIALIZE":U THEN
      951               DO:
      952                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      953                     read-only-list +
      954                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      955                        STRING(curr-widget).
      956               END.
      957               WHEN "DISABLE":U OR
      958               WHEN "ENABLE":U THEN
      959               DO:
      960                   curr-widget:SENSITIVE = yes.
      961                   RUN get-attribute ('Read-Only-Editors':U).
      962                   IF RETURN-VALUE = ? OR
      963                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      964                       curr-widget:READ-ONLY =
      965                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      966               END.
      967               WHEN "CLEAR":U THEN
      968                   curr-widget:SCREEN-VALUE = "":U.
      969             END CASE.
      970           END.
      971           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      972       END.
      973       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      974         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      975           + '"':U).
      976       RETURN.
      977   END PROCEDURE.
      978   PROCEDURE use-check-modified-all :
      979    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      980     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      981     RETURN.
      982   END PROCEDURE.
      983   PROCEDURE use-create-on-add :
      984   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      985      RETURN.
      986   END PROCEDURE.
      987   PROCEDURE use-initial-lock :
      988     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      989     ASSIGN adm-initial-lock = p-attr-value.
      990     RETURN.
      991   END PROCEDURE.
      992     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      993   ASSIGN
      994          FRAME F-Main:SCROLLABLE       = FALSE
      995          FRAME F-Main:HIDDEN           = TRUE.
      996   if not this-procedure :persistent
      997   then do:
      998     message
      999       vss-workfile vss-revision vss-description skip
     1000       "Ошибка при запуске процедуры" skip
     1001       "Данную процедуру следует запускать только с параметром persistent" skip
     1002       view-as alert-box error .
     1003     undo, return error .
     1004   end.
     1005     assign FILL-IN-1 :screen-value in frame F-Main = string(TODAY,"99/99/9999") .
     1006   PROCEDURE disable_UI :
     1007     HIDE FRAME F-Main.
     1008     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1009   END PROCEDURE.
     1010   PROCEDURE local-apply-layout :
     1011     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1012   END PROCEDURE.
     1013   PROCEDURE my-report :
     1014   Assign frame F-Main FILL-IN-1 .
     1015     define variable date1 as date    no-undo .
     1016     assign date1 = DATE( FILL-IN-1 :screen-value ) .
     1017     run rep/r-slg-d.p ( date1, NullStr ) .
     1018   END PROCEDURE.
     1019   PROCEDURE my-var :
     1020     Assign frame F-Main FILL-IN-1 NullStr .
     1021     Assign
     1022       STR-obj-type = ''
     1023       STR-obj-code = ''
     1024       STR-obj-name = ''
     1025       STR-obj      = ''
     1026     .
     1027     For each obj-list no-lock:
     1028       Assign
     1029         STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1030         STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1031         STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1032         STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1033       .
     1034     End.
     1035     assign
     1036       str1 = "Отсутствующий ассортимент на " + String(FILL-IN-1,"99/99/9999")
     1037     .
     1038   END PROCEDURE.
     1039   PROCEDURE state-changed :
     1040     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1041     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1042     CASE p-state:
     1043       when "link-changed":U then  DO:
     1044            Run my-var.
     1045            End.
     1046     END CASE.
     1047   END PROCEDURE.
