     3159            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3160   define variable mFrameView      as logical   no-undo init yes.
     3161     define variable mFramHandle as handle no-undo.
     3162     mFramHandle = frame InfoFrame:handle.
     3163     if  log-manager:logfile-name ne ?
     3164     then DO:
     3165         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3166         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3167         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3168     end.
     3169     mFrameView = not session:batch-mode and mFramHandle:visible.
     3170     if mFrameView
     3171     then do:
     3172       ASSIGN
     3173          FRAME InfoFrame:HIDDEN                           = TRUE
     3174          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3175     end.
     3176   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3177   DO:
     3178     IF not StopProcessing THEN
     3179       Message "Вы действительно хотите прервать" SKIP
     3180               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3181                 UPDATE StopProcessing.
     3182     IF StopProcessing THEN do:
     3183        if mFrameView
     3184        then do:
     3185           HIDE FRAME InfoFrame.
     3186        end.
     3187     End.
     3188   END.
     3189   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     3190     if  log-manager:logfile-name ne ?
     3191     then DO:
     3192         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3193     end.
     3194     if not session:batch-mode then
     3195     do:
     3196       VIEW FRAME InfoFrame.
     3197       mFrameView = true.
     3198     end.
     3199      v-button-stop = false .
     3200         if mFrameView
     3201         then do:
     3202         if v-button-stop then view STOPBTN in frame InfoFrame.
     3203                          else Hide STOPBTN in frame InfoFrame.
     3204         end.
     3205     assign
     3206       make-excel = yes
     3207       v-file-name = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     3208     .
