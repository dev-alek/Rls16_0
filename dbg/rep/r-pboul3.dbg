     3021    :
     3022     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     3023     OUTPUT to VALUE (v-file-name) .
     3024     for each temp-param :
     3025       export  temp-param  .
     3026     end.
     3027    end.
     3028   end procedure.
