     1343     varprice-base-cons = 0
     1344     varprice-rubl-cons = 0.
     1345   find first out-vatp_doc-line where
     1346              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     1347          and out-vatp_doc-line.artic      = buf_doc-line.artic
     1348          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     1349          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     1350   if available out-vatp_doc-line           and
