     3484       end.
     3485     end.
     3486     assign ii = 1  .
     3487     for each temp-goods-cli
     3488       break by temp-goods-cli.grp-name
     3489             by temp-goods-cli.f-o
     3490             by temp-goods-cli.artic
     3491       :
     3492       if  ( v-row ) >= 63000 then do:
     3493         Output stream Macr_Excel  close .
     3494         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     3495         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     3496         output stream  Macr_Excel to value(v-file-name) .
     3497         v-ind = v-ind + 1 .
     3498         run PutColumnTitulExcel in this-procedure .
     3499       end.
     3500       if first-of(temp-goods-cli.grp-name ) then do:
     3501         run macr_excel_char( temp-goods-cli.grp-name,  v-row, 5) .
     3502         run macr_cell_format ( 10, yes, no, ?, v-row , 5, v-row, 5) .
     3503         assign v-row = v-row + 1 .
     3504       end.
     3505       assign
     3506         temp-goods-cli.ost-qnty = temp-goods-cli.in-qnty - temp-goods-cli.out-qnty
     3507         sum-in-qnty        = sum-in-qnty        + temp-goods-cli.in-qnty
     3508         sum-in-with-np     = sum-in-with-np     + temp-goods-cli.sum-with-np
     3509         sum-in-nds         = sum-in-nds         + temp-goods-cli.sum-nds
     3510         sum-in-with-np-nds = sum-in-with-np-nds + temp-goods-cli.sum-with-np-nds
     3511         sum-out-qnty       = sum-out-qnty       + temp-goods-cli.out-qnty
     3512         sum-out-with-np    = sum-out-with-np    + temp-goods-cli.out-qnty * temp-goods-cli.price-np
     3513         sum-out-nds        = sum-out-nds        + temp-goods-cli.out-qnty * temp-goods-cli.nds
     3514         sum-ost-qnty       = sum-ost-qnty       + temp-goods-cli.ost-qnty
     3515         sum-ost-with-np    = sum-ost-with-np    + temp-goods-cli.ost-qnty * temp-goods-cli.price-np
     3516         Counter1 = Counter1 + 1
     3517       .
     3518   IF ( Counter1 modulo v-account = 0 )  then DO:
     3519             if  log-manager:logfile-name ne ?
     3520             then DO:
     3521                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3522             end.
     3523              if mFrameView
     3524              then do:
     3525               DISPLAY
     3526                 Counter1 @ RecordsDone
     3527                 WITH FRAME InfoFrame.
     3528              end.
     3529   End.
     3530      if v-button-stop then  DO:
     3531            if mFrameView
     3532            then
     3533               PROCESS EVENTS.
     3534            IF StopProcessing THEN DO:
     3535            RETURN error.
     3536            End.
     3537      end.
     3538       run macr_excel_char(String(ii)                                        , v-row, 1) .
     3539       assign ii = ii + 1  .
     3540       run macr_excel_char(String(temp-goods-cli.dte,"99.99.9999")           , v-row, 2) .
     3541       run macr_excel_char( temp-goods-cli.num                               , v-row, 3) .
     3542       run macr_excel_char( temp-goods-cli.artic                             , v-row, 4) .
     3543       run macr_excel_char( temp-goods-cli.gds-name                          , v-row, 5) .
     3544       run macr_excel_char( temp-goods-cli.unit-base                         , v-row, 6) .
     3545       run macr_excel_sum ( temp-goods-cli.price                             , v-row, 7,  2) .
     3546       run macr_excel_sum ( temp-goods-cli.np                                , v-row, 8,  2) .
     3547       run macr_excel_sum ( temp-goods-cli.price-np                          , v-row, 9,  2) .
     3548       run macr_excel_sum ( temp-goods-cli.nds                               , v-row, 10, 2) .
     3549       run macr_excel_sum ( temp-goods-cli.price-np-nds                      , v-row, 11, 2) .
     3550       run macr_excel_sum ( temp-goods-cli.in-qnty                           , v-row, 12, 3) .
     3551       run macr_excel_sum ( temp-goods-cli.sum-with-np                       , v-row, 13, 2) .
     3552       run macr_excel_sum ( temp-goods-cli.sum-nds                           , v-row, 14, 2) .
     3553       run macr_excel_sum ( temp-goods-cli.sum-with-np-nds                   , v-row, 15, 2) .
     3554       run macr_excel_sum ( temp-goods-cli.out-qnty                          , v-row, 16, 3) .
     3555       run macr_excel_sum ( temp-goods-cli.out-qnty * temp-goods-cli.price-np, v-row, 17, 2) .
     3556       run macr_excel_sum ( temp-goods-cli.out-qnty * temp-goods-cli.nds     , v-row, 18, 2) .
     3557       run macr_excel_sum ( temp-goods-cli.ost-qnty                          , v-row, 19, 3) .
     3558       run macr_excel_sum ( temp-goods-cli.ost-qnty * temp-goods-cli.price-np, v-row, 20, 2) .
     3559       assign v-row = v-row + 1 .
     3560     end.
     3561     run macr_excel_char( "Итого за интервал:",  v-row, 5) .
     3562     run macr_excel_sum ( sum-in-qnty         ,  v-row, 12,  3) .
     3563     run macr_excel_sum ( sum-in-with-np      ,  v-row, 13,  2) .
     3564     run macr_excel_sum ( sum-in-nds          ,  v-row, 14,  2) .
     3565     run macr_excel_sum ( sum-in-with-np-nds  ,  v-row, 15,  2) .
     3566     run macr_excel_sum ( sum-out-qnty        ,  v-row, 16,  3) .
     3567     run macr_excel_sum ( sum-out-with-np     ,  v-row, 17,  2) .
     3568     run macr_excel_sum ( sum-out-nds         ,  v-row, 18,  2) .
     3569     run macr_excel_sum ( sum-ost-qnty        ,  v-row, 19,  3) .
     3570     run macr_excel_sum ( sum-ost-with-np     ,  v-row, 20,  2) .
     3571     assign v-row = v-row + 1 .
     3572     output stream macr_excel close .
     3573     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     3574     run end-proc .
     3575   if mFrameView
     3576   then do:
     3577      HIDE FRAME InfoFrame.
     3578   end.
     3579   if session :set-wait-state( "" ) then.
     3580     run rep/runexcel.p (v-file-name ).
     3581   end.
     3582   procedure PutColumnTitulExcel :
     3583     do
     3584     on error undo, return error return-value
     3585     :
     3586     assign
     3587       v-row = 4
     3588       v-col = 1
     3589     .
     3590     run macr_excel_char ("Учет приобретенного и израсходованного сырья по видам товаров (работ, услуг)", 1, 4) .
     3591     run macr_cell_format( 11, yes, no, ?, 1, 4, 1, 4) .
     3592     run macr_excel_char (String( "Период с " + String(x-Date-Start,"99.99.9999") + " по " + String(x-Date-End,"99.99.9999") ) , 2, 1) .
     3593     run macr_excel_char("Стоимостные показатели приобретенного сырья (работ, услуг) в пользу индивидуального предпринимателя", 3, 7) .
     3594     run macr_excel_char("Стоимостные показатели израсходованного сырья (работ, услуг)", 3, 16) .
     3595     run macr_excel_char("Стоимостные показатели остатков сырья (работ, услуг)", 3, 19) .
     3596     run macr_excel_char("№ п/п", v-row, v-col) .
     3597     run macr_cell_size (4,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     3598     run macr_excel_char("Дата операции", v-row, v-col) .
     3599     run macr_cell_size (10,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3600     run macr_excel_char("Номер документа", v-row, v-col) .
     3601     run macr_cell_size (10,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3602     run macr_excel_char("Артикул", v-row, v-col) .
     3603     run macr_cell_size (10,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3604     run macr_excel_char("Наименование изготовленных товаров, выполненных работ, оказанных услуг", v-row, v-col) .
     3605     run macr_cell_size (40,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3606     run macr_excel_char("Един. изм.", v-row, v-col) .
     3607     run macr_cell_size (4,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     3608     run macr_excel_char("Цена без налогов", v-row, v-col) .
     3609     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3610     run macr_excel_char("Налог с продаж", v-row, v-col) .
     3611     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3612     run macr_excel_char("Цена с НП без НДС", v-row, v-col) .
     3613     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3614     run macr_excel_char("НДС (руб.)", v-row, v-col) .
     3615     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3616     run macr_excel_char("Цена с НП и НДС", v-row, v-col) .
     3617     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3618     run macr_excel_char("Количество", v-row, v-col) .
     3619     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3620     run macr_excel_char("Сумма с НП", v-row, v-col) .
     3621     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3622     run macr_excel_char("Сумма НДС", v-row, v-col) .
     3623     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3624     run macr_excel_char("Общая стоимость с НП и НДС", v-row, v-col) .
     3625     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3626     run macr_excel_char("Количество", v-row, v-col) .
     3627     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3628     run macr_excel_char("Общая стоимость", v-row, v-col) .
     3629     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3630     run macr_excel_char("Сумма НДС", v-row, v-col) .
     3631     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3632     run macr_excel_char("Количество", v-row, v-col) .
     3633     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3634     run macr_excel_char("Сумма с НП", v-row, v-col) .
     3635     run macr_cell_size (12,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     3636     run macr_cell_bordur ( v-row - 1, 1, v-row, 20) .
     3637     run macr_cell_format ( 10, yes, no, 35, v-row - 1, 1, v-row, 20) .
     3638     assign
     3639       v-row = v-row + 1
     3640       v-col = 1
     3641     .
     3642     end.
     3643   end procedure.
