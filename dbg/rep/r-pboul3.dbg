      608   procedure r-cost :
      609     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      610     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      611     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      612     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      613     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      614     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      615     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      616     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      617     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      618     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      619     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      620     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      621     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      622     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      623     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      624     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      625     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      626     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      627     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      628     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      629     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      630     do
      631     on error undo, return error
      632     :
      633       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      634       define buffer   in-vatp-parts    for ub.parts   .
      635       define buffer   in-vatp-doc      for ub.trn-doc .
      636       define buffer   in-vatp-goods    for ub.goods   .
      637       define buffer   in-vatp-sysconf  for ub.sysconf .
      638       define buffer   in-vatp_doc-attr for ub.doc-attr.
      639       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      640       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      641       define variable varinvprb                  as   character              no-undo.
      642       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      643       define variable cli-base-rate              as   decimal                no-undo.
      644       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      645       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      646       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      647       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      648       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      649       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      650       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      651       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      652       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      653       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      654       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      655       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      656       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      657       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      658       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      659       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      660       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      661       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      662       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      663       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      664       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      665       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      666       define variable varinvatp-envd             as   character              no-undo.
      667       define variable varinvatp-type             as   character              no-undo.
      668       def var v-parts-fact-qnty as decimal   no-undo .
      669       define buffer buf_parts    for ub.parts    .
      670       define buffer buf_goods    for ub.goods    .
      671       define buffer buf_trn-doc  for ub.trn-doc  .
      672       define buffer buf_doc-line for ub.doc-line .
      673       find first buf_doc-line no-lock
      674         where buf_doc-line.doc-code  = v-doc-code
      675           and buf_doc-line.artic     = v-artic
      676           and buf_doc-line.prod-type = v-prod-type
      677           and buf_doc-line.prod-code = v-prod-code
      678         no-error .
      679       if not available buf_doc-line then do:
      680         message
      681           vss-workfile vss-revision vss-description skip
      682           vss-include-info9 skip
      683           "Ошибка задания входных параметров" skip
      684           "Не найдена строка документа"  skip
      685           "Документ" v-doc-code skip
      686           "Артикул" v-artic v-prod-type v-prod-code skip
      687           view-as alert-box error .
      688         return error .
      689       end.
      690       find first buf_trn-doc no-lock
      691         where buf_trn-doc.doc-code = v-doc-code
      692         no-error .
      693       if not available buf_trn-doc then do:
      694         message
      695           vss-workfile vss-revision vss-description skip
      696           vss-include-info9 skip
      697           "Ошибка задания входных параметров" skip
      698           "Не найден документ" skip
      699           "Документ" v-doc-code skip
      700           "Артикул" v-artic v-prod-type v-prod-code skip
      701           view-as alert-box error .
      702         undo, return error .
      703       end.
      704       find first buf_goods no-lock
      705         where buf_goods.artic     = buf_doc-line.artic
      706           and buf_goods.prod-type = buf_doc-line.prod-type
      707           and buf_goods.prod-code = buf_doc-line.prod-code
      708         no-error .
      709       if not available buf_goods then do:
      710         message
      711           vss-workfile vss-revision vss-description skip
      712           vss-include-info9 skip
      713           "Ошибка задания входных параметров" skip
      714           "Не найден товар" skip
      715           "Документ" v-doc-code skip
      716           "Артикул" v-artic v-prod-type v-prod-code skip
      717           view-as alert-box error .
      718         undo, return error .
      719       end.
      720       if buf_goods.gds-type = 'т':U then do:
      721             for each buf_parts no-lock
      722               where buf_parts.out-code  = buf_trn-doc.doc-code
      723                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      724                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      725                 and buf_parts.artic     = buf_doc-line.artic
      726                 and buf_parts.prod-type = buf_doc-line.prod-type
      727                 and buf_parts.prod-code = buf_doc-line.prod-code
      728             on error undo, return error
      729             :
      730   assign
      731     price-rubl-with-tax-loc = buf_parts.price-rubl
      732     price-base-with-tax-loc = buf_parts.price-base
      733   .
      734   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      735   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      736     (output varinvprb
      737     )  .
      738     if buf_parts.out-code = 'free-zone':U     or
      739        buf_parts.out-code = 'out-zone':U   or
      740        buf_parts.doc-type = 'акт':U then do:
      741       assign
      742         in-vatp-have-vat-slt = yes.
      743     end.
      744     else do:
      745       find first in-vatp_doc-attr no-lock
      746         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      747           and in-vatp_doc-attr.attr-code = 'envd':U
      748         no-error .
      749       if not available in-vatp_doc-attr then do:
      750         assign
      751           in-vatp-have-vat-slt = yes.
      752       end.
      753       else do:
      754            in-vatp-have-vat-slt = no.
      755       end.
      756     end.
      757     assign
      758      price-cli-with-tax-loc = buf_parts.price-cli
      759      cli-base-rate          = buf_parts.cli-base-rate.
      760     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      761              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      762     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      763             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      764             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      765             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      766             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      767             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      768             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      769       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      770     assign
      771       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      772     assign
      773       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      774       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      775       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      776       transport-cli-loc  = 0
      777       other-cli-loc      = 0
      778     .
      779   ASSIGN
      780             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      781       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      782   .
      783               assign
      784                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
      785                                       or buf_trn-doc.doc-type = 'возврат':U
      786                                       or buf_trn-doc.doc-type = 'инв':U
      787                                       then buf_parts.fact-qnty
      788                                       else - buf_parts.fact-qnty
      789                                      )
      790               .
      791               assign
      792                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
      793                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
      794                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
      795                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
      796                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
      797                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
      798                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
      799                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
      800                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
      801                 v-excise-base         =   0
      802                 v-excise-rubl         =   0
      803                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
      804                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
      805                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
      806                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
      807               .
      808           end.
      809   assign
      810     price-rubl-with-tax-loc = buf_doc-line.price-rubl
      811     price-base-with-tax-loc = buf_doc-line.price-base
      812   .
      813   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      814   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      815     (output varinvprb
      816     )  .
      817      find first in-vatp_doc-attr no-lock
      818       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      819         and in-vatp_doc-attr.attr-code = 'envd':U
      820       no-error .
      821       if available in-vatp_doc-attr
      822          then do:
