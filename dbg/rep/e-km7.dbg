     1767     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1768     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1769     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
