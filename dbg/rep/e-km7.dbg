      679   define temp-table temp_onewin_items no-undo
      680       field itm-key       as integer
      681       field itmExtKey     as character
      682       field itmName       as character
      683       field itmDesc       as character
      684       field itmSelected   as logical
      685       index pi is primary unique
      686           itm-key
      687       index ie
      688           itmExtKey
      689   .
      690   define temp-table temp_onewin_itemsSelected no-undo
      691       field its-key   as integer
      692       field itm-key   as integer
      693       field itmExtKey as character
      694       index pi is primary unique
      695           its-key
      696       index im
      697           itm-key
      698   .
      699   define variable v-onewin13-itm-key    as integer      no-undo.
      700   procedure onewin_clear :
      701       define buffer buf_temp_onewin_items        for temp_onewin_items.
      702   do
      703   for buf_temp_onewin_items
      704   on error undo, return error
      705   :
      706       empty temp-table buf_temp_onewin_items.
      707   end.
      708   end procedure.
      709   procedure onewin_add-item :
      710   define input parameter p-ext-key   as character        no-undo.
      711   define input parameter p-item-name as character        no-undo.
      712   define input parameter p-item-desc as character        no-undo.
      713   define input parameter p-selected  as logical          no-undo.
      714       define buffer buf_temp_onewin_items        for temp_onewin_items.
      715   do
      716   for buf_temp_onewin_items
      717   on error undo, return error
      718   :
      719       find last buf_temp_onewin_items no-error.
      720       if available buf_temp_onewin_items then do:
      721         v-onewin13-itm-key = buf_temp_onewin_items.itm-key.
      722       end.
      723       else do:
      724         v-onewin13-itm-key = 0.
      725       end.
      726       assign
      727           v-onewin13-itm-key = v-onewin13-itm-key + 1
      728       .
      729       create buf_temp_onewin_items.
      730       assign
      731       buf_temp_onewin_items.itm-key      = v-onewin13-itm-key
      732       buf_temp_onewin_items.itmExtKey    = p-ext-key
      733       buf_temp_onewin_items.itmName      = p-item-name
      734       buf_temp_onewin_items.itmDesc      = p-item-desc
      735       buf_temp_onewin_items.itmSelected  = p-selected
      736       .
      737   end.
      738   end procedure.
      739   procedure onewin_create-selection :
      740   define input parameter p-itm-key as integer no-undo .
      741   define input parameter p-itmextkey as character no-undo .
      742   define variable v-counter as integer no-undo .
      743   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      744   do
      745   on error undo, return error
      746   :
      747     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      748     if available buf_temp_onewin_itemsSelected then do:
      749       v-counter = buf_temp_onewin_itemsSelected.its-key.
      750     end.
      751     find first buf_temp_onewin_itemsSelected where
      752          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      753     if not available buf_temp_onewin_itemsSelected then do:
      754       create buf_temp_onewin_itemsSelected.
      755       assign
      756       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      757       v-counter = v-counter + 1
      758       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      759       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      760       .
      761     end.
      762   end.
      763   end procedure.
      764   procedure onewin_check-item :
      765   define input parameter p-ext-key   as character        no-undo.
      766   define output parameter p-exists as logical no-undo .
      767   define buffer buf_temp_onewin_items for temp_onewin_items.
      768   find first buf_temp_onewin_items where
      769   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      770   if available buf_temp_onewin_items then do:
      771     p-exists = yes.
      772   end.
      773   end procedure.
