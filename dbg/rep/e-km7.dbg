      957   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      958   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      959   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
      960   define input  parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
      961   define input  parameter p-value-date like ub.thbj-attr.property-value-date no-undo .
      962   define input  parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
      963   define input  parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
      964   define input  parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
