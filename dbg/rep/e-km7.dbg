      969       (input  p-obj-type
      970       ,input  p-obj-code
      971       ,input  p-upper-code
      972       ,input  p-code
      973       ,input  p-value-character
      974       ,input  p-value-date
      975       ,input  p-value-decimal
      976       ,input  p-value-integer
      977       ,input  p-value-logical
      978       ) no-error .
