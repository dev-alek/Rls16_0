     1809   END PROCEDURE.
     1810   PROCEDURE adm-delete-record :
     1811    MESSAGE
     1812          "Object ":U THIS-PROCEDURE:FILE-NAME
     1813            "must have at least one Enabled Table to perform Delete.":U
     1814              VIEW-AS ALERT-BOX ERROR.
     1815       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1816       RETURN.
     1817   END PROCEDURE.
     1818   PROCEDURE adm-disable-fields :
     1819         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1820       RETURN.
     1821   END PROCEDURE.
     1822   PROCEDURE adm-enable-fields :
     1823       RETURN.
     1824   END PROCEDURE.
     1825   PROCEDURE adm-end-update :
     1826     RETURN.
     1827   END PROCEDURE.
     1828   PROCEDURE adm-reset-record :
     1829       RETURN.
     1830   END PROCEDURE.
     1831   PROCEDURE adm-update-record :
     1832       MESSAGE
     1833         "Object ":U THIS-PROCEDURE:FILE-NAME
     1834           "must have at least one Enabled Table to perform Update.":U
     1835             VIEW-AS ALERT-BOX ERROR.
     1836      RETURN.
     1837   END PROCEDURE.
     1838   PROCEDURE check-modified :
     1839   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1840   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1841   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1842   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1843     IF check-state = "check":U THEN
     1844     DO:
     1845       RUN get-link-handle IN adm-broker-hdl
     1846         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1847            OUTPUT group-target-list).
     1848       IF group-target-list NE "":U THEN
     1849       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1850         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1851         RUN check-modified IN curr-widget ('group-check':U).
     1852         IF RETURN-VALUE NE "":U THEN
     1853         DO:
     1854           RUN check-modified-message(RETURN-VALUE).
     1855           RETURN "":U.
     1856         END.
     1857       END.
     1858     END.
     1859     RETURN "":U.
     1860   END PROCEDURE.
     1861   PROCEDURE check-modified-message :
     1862     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1863        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1864           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1865        IF RETURN-VALUE = "YES":U THEN
     1866           RUN notify ('view,CONTAINER-SOURCE':U).
     1867        MESSAGE IF p-changed-table NE ? THEN
     1868           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1869           ELSE "Current values have been changed."
     1870           SKIP "  Do you wish to save those changes?"
     1871           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1872        IF ANS THEN
     1873        DO:
     1874           IF group-assign-target THEN
     1875             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1876           ELSE RUN dispatch('update-record':U).
     1877           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1878           DO:
     1879               MESSAGE "Changes to the previous record were not saved."
     1880                 VIEW-AS ALERT-BOX ERROR.
     1881               IF group-assign-target THEN
     1882                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1883               ELSE RUN dispatch ('cancel-record':U).
     1884           END.
     1885        END.
     1886        ELSE DO:
     1887          IF group-assign-target THEN
     1888             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1889          ELSE RUN dispatch('cancel-record':U).
     1890        END.
     1891        RETURN.
     1892   END PROCEDURE.
     1893   PROCEDURE get-rowid :
     1894       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1895       ASSIGN
     1896       p-table   =   adm-first-table.
     1897       RETURN.
     1898   END PROCEDURE.
     1899   PROCEDURE init-group-assign :
     1900       RUN request-attribute IN adm-broker-hdl
     1901         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1902       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1903         group-assign-target = yes.
     1904       ELSE group-assign-target = no.
     1905       RETURN.
     1906   END PROCEDURE.
     1907   PROCEDURE set-editors :
     1908       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1909       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1910       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1911       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1912       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1913       DO WHILE VALID-HANDLE (curr-widget):
     1914           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1915              curr-widget:HIDDEN = no THEN DO:
     1916             CASE p-field-setting:
     1917               WHEN "INITIALIZE":U THEN
     1918               DO:
     1919                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1920                     read-only-list +
     1921                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1922                        STRING(curr-widget).
     1923               END.
     1924               WHEN "DISABLE":U OR
     1925               WHEN "ENABLE":U THEN
     1926               DO:
     1927                   curr-widget:SENSITIVE = yes.
     1928                   RUN get-attribute ('Read-Only-Editors':U).
     1929                   IF RETURN-VALUE = ? OR
     1930                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1931                       curr-widget:READ-ONLY =
     1932                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1933               END.
     1934               WHEN "CLEAR":U THEN
     1935                   curr-widget:SCREEN-VALUE = "":U.
     1936             END CASE.
     1937           END.
     1938           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1939       END.
     1940       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1941         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1942           + '"':U).
     1943       RETURN.
     1944   END PROCEDURE.
     1945   PROCEDURE use-check-modified-all :
     1946    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1947     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1948     RETURN.
     1949   END PROCEDURE.
     1950   PROCEDURE use-create-on-add :
     1951   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1952      RETURN.
     1953   END PROCEDURE.
     1954   PROCEDURE use-initial-lock :
     1955     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1956     ASSIGN adm-initial-lock = p-attr-value.
     1957     RETURN.
     1958   END PROCEDURE.
     1959     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1960   ASSIGN
     1961          FRAME F-Main:SCROLLABLE       = FALSE
     1962          FRAME F-Main:HIDDEN           = TRUE
     1963          FRAME F-Main:PRIVATE-DATA     =
     1964                   "DLGCLOSE".
     1965   PROCEDURE disable_UI :
     1966     HIDE FRAME F-Main.
     1967     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1968   END PROCEDURE.
     1969   PROCEDURE local-apply-layout :
     1970     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1971   END PROCEDURE.
     1972   PROCEDURE local-initialize :
     1973   RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1974   CASE place-call:
     1975     WHEN 'schedule':U
     1976     or when 'rp-by-call':U
     1977     THEN DO:
     1978       RUN rcps_get-profile-id IN parent-handle ( OUTPUT v-profile-id).
     1979       CASE v-profile-id:
     1980         WHEN 74 THEN DO:
     1981           enable
     1982           t-excel
     1983           t-text
     1984           with frame F-Main .
     1985         end.
     1986       end case.
     1987     end.
     1988     otherwise do:
     1989       hide
     1990       t-excel
     1991       t-text
     1992       in frame F-Main .
     1993     end.
     1994   end case.
     1995   END PROCEDURE.
     1996   PROCEDURE my-params :
     1997   define input parameter p-action as character no-undo .
     1998   define variable v-index-id as integer no-undo .
     1999   define variable v-value-character as character no-undo .
     2000   define variable v-value-date as date no-undo .
     2001   define variable v-value-decimal as decimal no-undo .
     2002   define variable v-value-integer as integer no-undo .
     2003   define variable v-value-logical as logical no-undo .
     2004   CASE p-action :
     2005     WHEN 'get' THEN DO:
     2006       IF v-profile-id = 74  THEN DO:
     2007          v-index-id = 0.
     2008          RUN rcps_get-value IN parent-handle (
     2009                                             input "p-output-type"
     2010                                            ,INPUT-output v-index-id
     2011                                            ,output v-output-type
     2012                                            ,output v-value-date
     2013                                            ,output v-value-decimal
     2014                                            ,output v-value-integer
     2015                                            ,output v-value-logical
     2016                                            ) no-error .
     2017          assign
     2018          t-excel:screen-value in frame F-Main =  string(lookup('excel':U, v-output-type) > 0)
     2019          t-text:screen-value in frame F-Main = string(lookup('text':U, v-output-type) > 0)
     2020          .
     2021       END.
     2022       RUN local-initialize IN THIS-PROCEDURE.
     2023     END.
     2024     WHEN 'set' THEN DO:
     2025       IF v-profile-id = 74 THEN DO:
     2026         ASSIGN
     2027         FRAME F-Main
     2028         t-text
     2029         t-excel
     2030         v-output-type = ","
     2031         ENTRY(1, v-output-type) = (IF t-excel THEN 'excel':U ELSE '')
     2032         ENTRY(2, v-output-type) = (IF t-text THEN 'text':U ELSE '')
     2033         v-output-type = TRIM(v-output-type, chr(44))
     2034         .
     2035         if not t-excel
     2036         and not t-text then do:
     2037           define variable glog as logical no-undo .
     2038           message
     2039           "Внимание!! Вы не выбрали ни вывод в текстовый файл, ни вывод в Excel!" skip
     2040           "Продолжить?"
     2041           view-as alert-box question buttons yes-no update glog.
     2042           if not glog then return error.
     2043         end.
     2044         RUN rcps_set-value IN parent-handle (
     2045                                           input "p-output-type"
     2046                                         ,INPUT 0
     2047                                         ,input v-output-type
     2048                                         ,input ?
     2049                                         ,input 0.0
     2050                                         ,input 0
     2051                                         ,input no
     2052                                         ) no-error .
     2053       END.
     2054     END.
     2055   END CASE.
     2056   END PROCEDURE.
     2057   PROCEDURE my-report :
     2058     run rep/r-km7.p (
     2059                        input my-handle
     2060                       ,input this-procedure:handle
     2061                       ,input this-procedure:handle
     2062                       ,input this-procedure:handle
     2063                       ,input this-procedure:handle
     2064                       ,input ?
     2065                       ,input ?
     2066                       ,input ''
     2067                       ,input integer('0':U)
     2068                       ,input 0
     2069                       ,input 0
     2070                       ,input ""
     2071                       ,input yes
     2072                       ,input yes
     2073                       ,input ''
     2074                     ) .
     2075   END PROCEDURE.
     2076   PROCEDURE my-var :
     2077   END PROCEDURE.
