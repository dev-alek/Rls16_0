     1065   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1066   procedure gen-key-rec :
     1067     define input  parameter p-tbl-name    as character no-undo.
     1068     define input  parameter p-bh_tbl-name as handle    no-undo.
     1069     define output parameter p-key-rec     as character no-undo.
     1070     do
     1071     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1072     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1073     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1074     :
     1075       define variable fh               as handle    no-undo .
     1076       define variable v-ok             as logical   no-undo .
     1077       define variable v-inform         as character no-undo .
     1078       define variable v-ind            as integer   no-undo .
     1079       define variable v-idx-field-qnty as integer   no-undo .
     1080       if p-tbl-name = ?
     1081         or p-tbl-name = "":U
     1082       then do:
     1083         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info16 ).
     1084       end.
     1085       if not p-bh_tbl-name:available then do:
     1086         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info16, p-tbl-name ).
     1087       end.
     1088       assign
     1089         p-key-rec = p-tbl-name
     1090         v-inform  = p-bh_tbl-name:index-information(1)
     1091         v-ind     = 2
     1092       .
     1093       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1094       on error undo, return error
     1095       :
     1096         assign
     1097           v-inform = p-bh_tbl-name:index-information( v-ind )
     1098           v-ind    = v-ind + 1
     1099         .
     1100       end.
     1101       if v-inform = ?
     1102         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1103         or entry( 3, v-inform, ",":U ) <> "1":U
     1104       then do:
     1105         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, p-tbl-name ).
     1106       end.
     1107       else do:
     1108         assign
     1109           v-idx-field-qnty = num-entries( v-inform ) - 4
     1110         .
     1111         if v-idx-field-qnty < 2 then do:
     1112           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, p-tbl-name ).
     1113         end.
     1114         do v-ind = 1 to v-idx-field-qnty by 2
     1115         on error undo, return error
     1116         :
     1117           assign
     1118             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1119             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1120           .
     1121         end.
     1122       end.
     1123       if p-key-rec = ? then do:
     1124         assign
     1125           p-key-rec = "":U
     1126         .
     1127         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info16, p-tbl-name ).
     1128       end.
     1129     end.
     1130     return.
     1131   end procedure.
     1132   procedure gen-where-keyr-tab :
     1133     define input  parameter i-tableSerach as character no-undo.
     1134     define input  parameter i-tablekey   as character  no-undo.
     1135     define input  parameter p-key-rec    as character  no-undo.
     1136     define input  parameter p-key-handle as handle     no-undo .
     1137     define input  parameter p-db-name    as character  no-undo .
     1138     define input  parameter p-tt-handle  as handle     no-undo .
     1139     define output parameter o-Where      as character  no-undo.
     1140     do
     1141     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1142     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1143     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1144     :
     1145       define variable v-full-tbl-name  as character no-undo .
     1146       define variable bh_tbl-name      as handle    no-undo .
     1147       define variable fh_key           as handle    no-undo .
     1148       define variable fh_search        as handle    no-undo .
     1149       define variable v-field-num      as integer   no-undo .
     1150       define variable v-count-fld      as integer   no-undo .
     1151       define variable v-inform         as character no-undo .
     1152       define variable v-ind            as integer   no-undo .
     1153       define variable v-idx-field-qnty as integer   no-undo .
     1154       define variable v-field-name     as character no-undo .
     1155       define variable v-field-val      as character no-undo .
     1156       define variable v-word-link      as character no-undo .
     1157       define variable vTable           as character no-undo.
     1158       define variable bh_tbl-key       as handle    no-undo .
     1159       assign
     1160         p-key-rec = trim( p-key-rec )
     1161       .
     1162       if p-key-handle <> ? then do:
     1163         if not valid-handle(p-key-handle)
     1164            or p-key-handle:type <> "buffer"
     1165         then do:
     1166           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info16 ).
     1167         end.
     1168         if num-entries( p-key-rec, chr(3) ) > 1
     1169           or p-key-rec = ?
     1170           or p-key-rec = "":U
     1171         then do:
     1172           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info16, p-key-rec ).
     1173         end.
     1174       end.
     1175       else do:
     1176         if p-key-rec = ?
     1177           or p-key-rec = "":U
     1178         then do:
     1179           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info16 ).
     1180         end.
     1181       end.
     1182       assign
     1183         vTable = entry( 1 , p-key-rec, chr(3) )
     1184       .
     1185       if p-tt-handle <> ?
     1186         and ( not valid-handle(p-tt-handle)
     1187               or p-tt-handle:type <> "buffer"
     1188             )
     1189       then do:
     1190         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info16, vTable, chr(10) ).
     1191       end.
     1192       if p-tt-handle = ? then do:
     1193         assign
     1194           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1195         .
     1196         create buffer bh_tbl-name for table v-full-tbl-name .
     1197       end.
     1198       else do:
     1199         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1200       end.
     1201       assign
     1202         v-inform = bh_tbl-name:index-information(1)
     1203         v-ind    = 2
     1204       .
     1205       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1206       on error undo, return error
     1207       :
     1208         assign
     1209           v-inform = bh_tbl-name:index-information( v-ind )
     1210           v-ind    = v-ind + 1
     1211         .
     1212       end.
     1213       if v-inform = ?
     1214         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1215         or entry( 3, v-inform, ",":U ) <> "1":U
     1216       then do:
     1217         delete object bh_tbl-name no-error.
     1218         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info16, vTable ).
     1219       end.
     1220       assign
     1221         v-idx-field-qnty = num-entries( v-inform ) - 4
     1222       .
     1223       if v-idx-field-qnty < 2 then do:
     1224         delete object bh_tbl-name no-error.
     1225         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, vTable ).
     1226       end.
     1227       assign
     1228         o-where     = "where":U
     1229         v-word-link = "":U
     1230         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1231         v-count-fld = 0
     1232       .
     1233       if i-tablekey ne "" and i-tablekey ne ?
     1234       then do:
     1235         assign
     1236           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1237         .
     1238         create buffer bh_tbl-key for table v-full-tbl-name .
     1239       end.
     1240       if i-tableSerach ne "" and i-tableSerach ne ?
     1241       then do:
     1242         delete object bh_tbl-name no-error.
     1243         assign
     1244           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1245         .
     1246         create buffer bh_tbl-name for table v-full-tbl-name .
     1247       end.
     1248       block_where:
     1249       do v-ind = 1 to v-idx-field-qnty by 2
     1250       on error undo, return error
     1251       :
     1252         assign
     1253           v-count-fld = v-count-fld + 1
     1254         .
     1255         if p-key-handle = ?
     1256           and v-count-fld > v-field-num
     1257         then do:
     1258           leave block_where.
     1259         end.
     1260         define variable VfieldKeyTable as handle no-undo.
     1261         assign
     1262           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1263           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1264         .
     1265         if     bh_tbl-key ne ?
     1266         then do:
     1267            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1268            if VfieldKeyTable eq ?
     1269            then next block_where.
     1270         end.
     1271         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1272         then
     1273            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1274         else
     1275            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1276         if p-key-handle = ? then do:
     1277           assign
     1278             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1279           .
     1280         end.
     1281         else do:
     1282           assign
     1283             fh_key = p-key-handle:buffer-field( v-field-name )
     1284           .
     1285           if fh_key = ?
     1286             or not valid-handle( fh_key )
     1287           then do:
     1288             delete object bh_tbl-name.
     1289             if     bh_tbl-key ne ?
     1290             then
     1291                delete object bh_tbl-key.
     1292             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info16, p-key-handle:name, v-field-name ).
     1293           end.
     1294           assign
     1295             v-field-val = fh_key:buffer-value
     1296           .
     1297         end.
     1298         if fh_search:data-type ="character":U then do:
     1299           assign
     1300             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1301             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1302             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1303             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1304             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1305             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1306             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1307             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1308             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1309             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1310             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1311             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1312             v-field-val = substitute( '"&1"', v-field-val )
     1313           .
     1314         end.
     1315         assign
     1316           o-where = substitute( "&1 &2", o-where, v-field-val )
     1317         .
     1318         if v-word-link = "":U then do:
     1319           assign
     1320             v-word-link = "and":U
     1321           .
     1322         end.
     1323       end.
     1324       delete object bh_tbl-name.
     1325       if     bh_tbl-key ne ?
     1326       then
     1327          delete object bh_tbl-key.
     1328       if p-key-handle = ?
     1329         and v-count-fld <> v-field-num
     1330       then do:
     1331         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info16, vTable ).
     1332       end.
     1333     end.
     1334   end procedure.
     1335   procedure gen-hn-keyr-tab :
     1336     define input  parameter i-tableSerach as character no-undo.
     1337     define input  parameter i-tablekey   as character no-undo.
     1338     define input  parameter p-key-rec    as character no-undo.
     1339     define input  parameter p-key-handle as handle    no-undo .
     1340     define input  parameter p-db-name    as character no-undo .
     1341     define input  parameter p-tt-handle  as handle    no-undo .
     1342     define input  parameter p-stts-lock  as integer   no-undo .
     1343     define output parameter o-hn         as handle    no-undo.
     1344     define variable v-full-tbl-name as character no-undo.
     1345     define variable v-where         as character no-undo.
     1346     define variable bh_tbl-name     as handle    no-undo.
     1347     define variable vTable          as character no-undo.
     1348     do
     1349     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1350     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1351     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1352         run gen-where-keyr-tab(i-tableSerach,
     1353                                i-tablekey,
     1354                                p-key-rec,
     1355                                p-key-handle,
     1356                                p-db-name,
     1357                                p-tt-handle,
     1358                                output v-where).
     1359         if i-tableSerach ne "" and i-tableSerach ne ?
     1360         then do:
     1361            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1362            create buffer bh_tbl-name for table v-full-tbl-name .
     1363         end.
     1364         else do:
     1365            if p-tt-handle = ? then do:
     1366               assign
     1367                  vTable = entry( 1 , p-key-rec, chr(3) )
     1368               .
     1369               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1370               create buffer bh_tbl-name for table v-full-tbl-name .
     1371            end.
     1372            else do:
     1373               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1374            end.
     1375         end.
     1376         if p-tt-handle = ? then do:
     1377            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1378         end.
     1379         else do:
     1380            bh_tbl-name:find-first( v-where ) no-error .
     1381         end.
     1382         o-hn = bh_tbl-name.
     1383      end.
     1384   end procedure.
     1385   procedure gen-hn-keyr :
     1386     define input  parameter p-key-rec    as character no-undo.
     1387     define input  parameter p-key-handle as handle    no-undo .
     1388     define input  parameter p-db-name    as character no-undo .
     1389     define input  parameter p-tt-handle  as handle    no-undo .
     1390     define input  parameter p-stts-lock  as integer   no-undo .
     1391     define output parameter o-hn         as handle    no-undo.
     1392     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1393   end.
     1394   procedure gen-row-keyr :
     1395     define input  parameter p-key-rec    as character no-undo.
     1396     define input  parameter p-key-handle as handle    no-undo .
     1397     define input  parameter p-db-name    as character no-undo .
     1398     define input  parameter p-tt-handle  as handle    no-undo .
     1399     define input  parameter p-stts-lock  as integer   no-undo .
     1400     define output parameter p-tbl-row    as rowid     no-undo.
     1401     define output parameter p-tbl-name   as character no-undo.
     1402     define variable vHn as handle no-undo.
     1403       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1404       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1405       p-tbl-name =  vHn:table.
     1406       delete object vHn no-error.
     1407     if p-tbl-row = ? then do:
     1408       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info16, p-tbl-name, p-key-rec ).
     1409     end.
     1410     else do:
     1411       return.
     1412     end.
     1413   end procedure.
     1414   procedure gen-key-fv :
     1415     define input  parameter p-key-rec    as character no-undo .
     1416     define output parameter p-field-list as character no-undo .
     1417     define output parameter p-value-list as character no-undo.
     1418     do
     1419     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1420     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1421     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1422     :
     1423       define variable v-full-tbl-name  as character no-undo .
     1424       define variable bh_tbl-name      as handle    no-undo .
     1425       define variable v-tbl-name       as character no-undo .
     1426       define variable v-field-num      as integer   no-undo .
     1427       define variable v-count-fld      as integer   no-undo .
     1428       define variable v-inform         as character no-undo .
     1429       define variable v-ind            as integer   no-undo .
     1430       define variable v-idx-field-qnty as integer   no-undo .
     1431       define variable v-delim-key      as character no-undo .
     1432       if p-key-rec = ?
     1433         or p-key-rec = "":U
     1434       then do:
     1435         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info16 ).
     1436       end.
     1437       assign
     1438         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1439         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1440       .
     1441       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1442       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info16 ).
     1443       assign
     1444         v-inform = bh_tbl-name:index-information(1)
     1445         v-ind    = 2
     1446       .
     1447       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1448       on error undo, return error
     1449       :
     1450         assign
     1451           v-inform = bh_tbl-name:index-information( v-ind )
     1452           v-ind    = v-ind + 1
     1453         .
     1454       end.
     1455       if v-inform = ?
     1456         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1457         or entry( 3, v-inform, ",":U ) <> "1":U
     1458       then do:
     1459         delete object bh_tbl-name no-error.
     1460         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, v-tbl-name ).
     1461       end.
     1462       assign
     1463         v-idx-field-qnty = num-entries( v-inform ) - 4
     1464       .
     1465       if v-idx-field-qnty < 2 then do:
     1466         delete object bh_tbl-name no-error.
     1467         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, v-tbl-name ).
     1468       end.
     1469       assign
     1470         p-field-list = "":U
     1471         p-value-list = "":U
     1472         v-delim-key  = "":U
     1473         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1474         v-count-fld  = 0
     1475       .
     1476       block_where:
     1477       do v-ind = 1 to v-idx-field-qnty by 2
     1478       on error undo, return error
     1479       :
     1480         assign
     1481           v-count-fld = v-count-fld + 1
     1482         .
     1483         if v-count-fld > v-field-num then do:
     1484           leave block_where.
     1485         end.
     1486         assign
     1487           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1488           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1489         .
     1490         if v-ind = 1 then do:
     1491           assign
     1492             v-delim-key = chr(3)
     1493           .
     1494         end.
     1495       end.
     1496       delete object bh_tbl-name.
     1497       if v-count-fld <> v-field-num then do:
     1498         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info16, v-tbl-name ).
     1499       end.
     1500     end.
     1501   end procedure.
     1502   procedure gen-key-field :
     1503     define input  parameter p-table      as character no-undo .
     1504     define output parameter p-field-list as character no-undo .
     1505     do
     1506     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1507     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1508     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1509     :
     1510       define variable v-full-tbl-name  as character no-undo .
     1511       define variable bh_tbl-name      as handle    no-undo .
     1512       define variable v-tbl-name       as character no-undo .
     1513       define variable v-field-num      as integer   no-undo .
     1514       define variable v-count-fld      as integer   no-undo .
     1515       define variable v-inform         as character no-undo .
     1516       define variable v-ind            as integer   no-undo .
     1517       define variable v-idx-field-qnty as integer   no-undo .
     1518       define variable v-delim-key      as character no-undo .
     1519       if p-table = ?
     1520         or p-table = "":U
     1521       then do:
     1522         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info16 ).
     1523       end.
     1524       assign
     1525         v-tbl-name      = p-table
     1526         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1527       .
     1528       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1529       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info16 ).
     1530       assign
     1531         v-inform = bh_tbl-name:index-information(1)
     1532         v-ind    = 2
     1533       .
     1534       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1535       on error undo, return error
     1536       :
     1537         assign
     1538           v-inform = bh_tbl-name:index-information( v-ind )
     1539           v-ind    = v-ind + 1
     1540         .
     1541       end.
     1542       if v-inform = ?
     1543         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1544         or entry( 3, v-inform, ",":U ) <> "1":U
     1545       then do:
     1546         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info16, v-tbl-name ).
     1547       end.
     1548       assign
     1549         v-idx-field-qnty = num-entries( v-inform ) - 4
     1550       .
     1551       if v-idx-field-qnty < 2 then do:
     1552         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info16, v-inform, v-tbl-name ).
     1553       end.
     1554       assign
     1555         p-field-list = "":U
     1556         v-delim-key  = "":U
     1557         v-count-fld  = 0
     1558       .
     1559       block_where:
     1560       do v-ind = 1 to v-idx-field-qnty by 2
     1561       on error undo, return error
     1562       :
     1563         assign
     1564           v-count-fld = v-count-fld + 1
     1565         .
     1566         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1567         if v-ind = 1 then do:
     1568           assign
     1569             v-delim-key = chr(3)
     1570           .
     1571         end.
     1572       end.
     1573       delete object bh_tbl-name.
     1574     end.
     1575   end procedure.
     1576   CREATE WIDGET-POOL.
     1577   DEFINE VARIABLE rid-list   AS CHARACTER NO-UNDO.
     1578   DEFINE VARIABLE v-db-num   AS INTEGER   NO-UNDO.
     1579   DEFINE VARIABLE v-obj-code AS INTEGER   NO-UNDO.
     1580   DEFINE VARIABLE v-pos-type AS CHARACTER NO-UNDO.
     1581   define variable v-profile-id as integer no-undo .
     1582   define variable v-output-type as character no-undo .
     1583   DEFINE BUFFER buf_cash-desk FOR cash-desk.
     1584   def var State-source as  WIDGET-HANDLE.
     1585   define variable loc-ref-list as character no-undo .
     1586   DEFINE RECTANGLE RECT-7
     1587        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1588        SIZE 71.4 BY 16.27.
     1589   DEFINE VARIABLE t-excel AS LOGICAL INITIAL no
     1590        LABEL "Excel"
     1591        VIEW-AS TOGGLE-BOX
     1592        SIZE 13 BY 1 NO-UNDO.
     1593   DEFINE VARIABLE t-TEXT AS LOGICAL INITIAL no
     1594        LABEL "TEXT"
     1595        VIEW-AS TOGGLE-BOX
     1596        SIZE 13 BY 1 NO-UNDO.
     1597   DEFINE FRAME F-Main
     1598        t-excel AT ROW 5.13 COL 31 WIDGET-ID 24
     1599        t-TEXT AT ROW 5.13 COL 51.5 WIDGET-ID 22
     1600        RECT-7 AT ROW 1.27 COL 2
     1601       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1602            SIDE-LABELS NO-UNDERLINE THREE-D
     1603            AT COL 1 ROW 1 SCROLLABLE
     1604            BGCOLOR 8 .
     1605   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1606     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-km7.w should only be RUN PERSISTENT.":U
     1607             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1608     RETURN.
     1609   END.
     1610   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1611   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1612   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1613   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1614   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1615   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1616   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1617   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1618         adm-object-hdl = FRAME F-Main:HANDLE.
     1619   RUN ensure-broker.
     1620   THIS-PROCEDURE:ADM-DATA =
     1621        'ADM1.1~`':U +
     1622        'SmartViewer~`':U +
     1623        '~`':U +
     1624        'NO ~`':U +
     1625        '~`':U +
     1626        '~`':U +
     1627        '~`':U +
     1628        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1629           + "~`":U +
     1630        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1631        'Record-Source,Record-Target,TableIO-Target~`':U +
     1632        '~`':U +
     1633        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1634        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1635            THEN "^^":U
     1636        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1637             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1638   PROCEDURE adm-apply-entry :
     1639     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1640   END PROCEDURE.
     1641   PROCEDURE adm-destroy :
     1642    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1643   END PROCEDURE.
     1644   PROCEDURE adm-disable :
     1645       DISABLE RECT-7 t-excel t-TEXT WITH FRAME F-Main.
     1646       RUN dispatch ('disable-fields':U).
     1647       RUN set-attribute-list ('ENABLED=no':U).
     1648       RETURN.
     1649   END PROCEDURE.
     1650   PROCEDURE adm-edit-attribute-list :
     1651         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1652         RETURN.
     1653   END PROCEDURE.
     1654   PROCEDURE adm-enable :
     1655       ENABLE UNLESS-HIDDEN RECT-7 t-excel t-TEXT WITH FRAME F-Main.
     1656       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1657       RUN set-attribute-list ('ENABLED=yes':U).
     1658       RETURN.
     1659   END PROCEDURE.
     1660   PROCEDURE adm-exit :
     1661        RUN notify ('exit':U).
     1662     RETURN.
     1663   END PROCEDURE.
     1664   PROCEDURE adm-hide :
     1665     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1666   END PROCEDURE.
     1667   PROCEDURE adm-initialize :
     1668     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1669   END PROCEDURE.
     1670   PROCEDURE adm-show-errors :
     1671       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1672       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1673           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1674       END.
     1675       RETURN.
     1676   END PROCEDURE.
     1677   PROCEDURE adm-UIB-mode :
     1678     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1679   END PROCEDURE.
     1680   PROCEDURE adm-view :
     1681     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1682   END PROCEDURE.
     1683   PROCEDURE dispatch :
     1684       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1685       RUN broker-dispatch IN adm-broker-hdl
     1686           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1687       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1688   END PROCEDURE.
     1689   PROCEDURE ensure-broker :
     1690   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1691   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1692   DO:
     1693       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1694       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1695   END.
     1696   END PROCEDURE.
     1697   PROCEDURE get-attribute :
     1698     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1699     RUN broker-get-attribute IN adm-broker-hdl
     1700         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1701     RETURN RETURN-VALUE.
     1702   END PROCEDURE.
     1703   PROCEDURE get-attribute-list :
     1704     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1705     RUN broker-get-attribute-list IN adm-broker-hdl
     1706         (INPUT THIS-PROCEDURE,
     1707          INPUT ?,
     1708          OUTPUT p-attr-list) NO-ERROR.
     1709     RETURN.
     1710   END PROCEDURE.
     1711   PROCEDURE new-state :
     1712     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1713     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1714     RETURN.
     1715   END PROCEDURE.
     1716   PROCEDURE notify :
     1717     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1718     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1719     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1720         RETURN "ADM-ERROR":U.
     1721     RETURN.
     1722   END PROCEDURE.
     1723   PROCEDURE set-attribute-list :
     1724     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1725     RUN ensure-broker.
     1726     RUN broker-set-attribute-list IN adm-broker-hdl
     1727         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1728     RETURN.
     1729   END PROCEDURE.
     1730   PROCEDURE set-position :
     1731       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1732       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1733       IF VALID-HANDLE(adm-object-hdl) THEN
     1734       DO:
     1735         ASSIGN adm-object-hdl:ROW    =   p-row
     1736                adm-object-hdl:COLUMN =   p-col.
     1737       END.
     1738       RETURN.
     1739   END PROCEDURE.
     1740   PROCEDURE adm-display-fields :
     1741       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1742       RETURN.
     1743   END PROCEDURE.
     1744   PROCEDURE adm-open-query :
     1745     RETURN.
     1746   END PROCEDURE.
     1747   PROCEDURE adm-row-changed :
     1748         IF VALID-HANDLE(adm-object-hdl) THEN
     1749           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1750         RUN notify ('row-available':U).
     1751         RETURN.
     1752   END PROCEDURE.
     1753   PROCEDURE reposition-query :
     1754       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1755       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1756       RETURN.
     1757   END PROCEDURE.
     1758     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1759     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1760     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1761     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1762     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1763     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1764     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1765     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
