      944       ,input-output table-handle p-tth
      945       ,output p-all-found
      946       ) no-error .
      947     if error-status :error
      948     then do:
      949       delete object p-tth.
      950       undo, return error return-value .
      951     end.
      952     delete object p-tth.
      953   end.
      954   end procedure.
