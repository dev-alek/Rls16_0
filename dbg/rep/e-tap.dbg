      787   define new global shared variable g#library  as handle no-undo .
      788   define new global shared variable g#library2 as handle no-undo .
      789   define variable var-report-r-b as character no-undo .
      790   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      792     (output var-report-r-b
      793     )  .
      794   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   procedure proc-alt-shift-f2:
      796     if not ibs.th.gbl.gbl-var:rcode
      797   then
      798     run gbl\inidebug.p .
      799   end.
      800   procedure proc-alt-shift-f3:
      801     run gbl/prvssinf.p
      802       ( input this-procedure
      803       ) .
      804   end.
      805   define variable v-inform-launched as logical no-undo initial false .
      806   procedure proc-alt-shift-f4:
      807     define variable v-action as character no-undo .
      808     if v-inform-launched = false then do:
      809       assign
      810         v-inform-launched = true
      811       .
      812       run gbl/d-inform.w
      813         (  input self
      814         ,  input this-procedure
      815         , output v-action
      816         ) no-error .
      817       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      818       assign
      819         v-inform-launched = false
      820       .
      821     end.
      822   end.
      823   procedure proc-alt-f1:
      824     run gbl/corrhelp.p
      825       (input this-procedure
      826       ) .
      827   end .
      828   on alt-shift-f2 anywhere do:
      829     run proc-alt-shift-f2.
      830   end.
      831   on alt-shift-f3 anywhere do:
      832     run proc-alt-shift-f3 in this-procedure .
      833   end.
      834   on alt-shift-f4 anywhere do:
      835     run proc-alt-shift-f4 in this-procedure.
      836   end.
      837   on alt-f1 anywhere do:
      838     run proc-alt-f1 in this-procedure .
      839   end.
      840   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841     define variable v-cntxt-db-num        as integer   no-undo .
      842     define variable v-cntxt-userid        as character no-undo .
      843     define variable v-cntxt-level         as character no-undo .
      844     define variable v-cntxt-host-code-obj as integer   no-undo .
      845     define variable v-cntxt-obj-type      as character no-undo .
      846     define variable v-cntxt-obj-code      as integer   no-undo .
      847     define variable v-cntxt-db-num-obj    as integer   no-undo .
      848     define variable v-cntxt-is-admin      as logical   no-undo .
      849   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850     run mainmenu_getcntxt in my-handle
      851       (output v-cntxt-db-num
      852       ,output v-cntxt-userid
      853       ,output v-cntxt-level
      854       ,output v-cntxt-host-code-obj
      855       ,output v-cntxt-obj-type
      856       ,output v-cntxt-obj-code
      857       ,output v-cntxt-db-num-obj
      858       ,output v-cntxt-is-admin
      859       ) .
      860   define variable base-type as character no-undo .
      861   define variable base-code as integer   no-undo .
      862   define variable g#report-num as integer   no-undo .
      863   define variable g#gds-engl as logical   no-undo .
      864   define variable vv-exch-rate  as decimal   no-undo .
      865   define variable vv-exch-scale as decimal   no-undo .
      866   define variable v-cntxt-host-name-obj as character no-undo .
      867   if v-cntxt-level = 'object':U then do:
      868   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      869   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      870     (input  v-cntxt-obj-type
      871     ,input  v-cntxt-obj-code
      872     ,output v-cntxt-host-code-obj
      873     ,output v-cntxt-host-name-obj
      874     )  .
      875   end.
      876   if v-cntxt-level = 'firm':U then do:
      877     find first ub.clients no-lock where
      878                ub.clients.obj-type = 'орг':U and
      879                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      880   if error-status :error then v-cntxt-host-name-obj = ? .
      881      else v-cntxt-host-name-obj = ub.clients.obj-name.
      882   end.
      883   if v-cntxt-level = 'object':U
      884   or v-cntxt-level = 'firm':U
      885   then do:
      886   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      888     (input  v-cntxt-host-code-obj
      889     ,output base-code
      890     )  .
      891   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      892   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      893     (input  base-code
      894     ,input  today
      895     ,output vv-exch-rate
      896     ,output vv-exch-scale
      897     ,output base-type
      898     )  .
      899   end.
      900   run get-report-num in my-handle ( output g#report-num ).
      901   run get-gds-engl in my-handle ( output g#gds-engl ) .
      902   define variable classify as character no-undo .
      903   CREATE WIDGET-POOL.
      904   DEFINE VARIABLE SortType AS CHARACTER
      905        VIEW-AS RADIO-SET VERTICAL
      906        RADIO-BUTTONS
      907             "по коду", "sort-code":U,
      908   "по артикулу", "sort-artic":U,
      909   "по наименов.", "sort-name":U
      910        SIZE 14 BY 2.75 NO-UNDO.
      911   DEFINE RECTANGLE RECT-7
      912        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      913        SIZE 71.38 BY 16.25.
      914   DEFINE VARIABLE v-print-null-qnty AS LOGICAL INITIAL no
      915        LABEL "Выводить нулевые строки"
      916        VIEW-AS TOGGLE-BOX
      917        SIZE 32 BY .83 NO-UNDO.
      918   DEFINE FRAME F-Main
      919        SortType AT ROW 3.25 COL 5.5 NO-LABEL WIDGET-ID 4
      920        v-print-null-qnty AT ROW 6.75 COL 6 WIDGET-ID 2
      921        "Сортировка :" VIEW-AS TEXT
      922             SIZE 11.5 BY .75 AT ROW 2 COL 6 WIDGET-ID 8
      923             FGCOLOR 4
      924        RECT-7 AT ROW 1.5 COL 1.5
      925       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      926            SIDE-LABELS NO-UNDERLINE THREE-D
      927            AT COL 1 ROW 1 SCROLLABLE
      928            BGCOLOR 8 .
      929   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
      930     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-tap.w should only be RUN PERSISTENT.":U
      931             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      932     RETURN.
      933   END.
      934   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      935   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      936   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      937   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      938   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      939   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      940   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      941   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      942         adm-object-hdl = FRAME F-Main:HANDLE.
      943   RUN ensure-broker.
      944   THIS-PROCEDURE:ADM-DATA =
      945        'ADM1.1~`':U +
      946        'SmartViewer~`':U +
      947        '~`':U +
      948        'NO ~`':U +
      949        '~`':U +
      950        '~`':U +
      951        '~`':U +
      952        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      953           + "~`":U +
      954        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      955        'Record-Source,Record-Target,TableIO-Target~`':U +
      956        '~`':U +
      957        '~`~`~`~`~`~`~`~`~`~`~`':U +
      958        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      959            THEN "^^":U
      960        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      961             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      962   PROCEDURE adm-apply-entry :
      963     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      964   END PROCEDURE.
      965   PROCEDURE adm-destroy :
      966    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      967   END PROCEDURE.
      968   PROCEDURE adm-disable :
      969       DISABLE RECT-7 SortType v-print-null-qnty WITH FRAME F-Main.
      970       RUN dispatch ('disable-fields':U).
      971       RUN set-attribute-list ('ENABLED=no':U).
      972       RETURN.
      973   END PROCEDURE.
      974   PROCEDURE adm-edit-attribute-list :
      975         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      976         RETURN.
      977   END PROCEDURE.
      978   PROCEDURE adm-enable :
      979       ENABLE UNLESS-HIDDEN RECT-7 SortType v-print-null-qnty WITH FRAME F-Main.
      980       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      981       RUN set-attribute-list ('ENABLED=yes':U).
      982       RETURN.
      983   END PROCEDURE.
      984   PROCEDURE adm-exit :
      985        RUN notify ('exit':U).
      986     RETURN.
      987   END PROCEDURE.
      988   PROCEDURE adm-hide :
      989     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      990   END PROCEDURE.
      991   PROCEDURE adm-initialize :
      992     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      993   END PROCEDURE.
      994   PROCEDURE adm-show-errors :
      995       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      996       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      997           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      998       END.
      999       RETURN.
     1000   END PROCEDURE.
     1001   PROCEDURE adm-UIB-mode :
     1002     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1003   END PROCEDURE.
     1004   PROCEDURE adm-view :
     1005     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1006   END PROCEDURE.
     1007   PROCEDURE dispatch :
     1008       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1009       RUN broker-dispatch IN adm-broker-hdl
     1010           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1011       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1012   END PROCEDURE.
     1013   PROCEDURE ensure-broker :
     1014   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1015   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1016   DO:
     1017       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1018       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1019   END.
     1020   END PROCEDURE.
     1021   PROCEDURE get-attribute :
     1022     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1023     RUN broker-get-attribute IN adm-broker-hdl
     1024         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1025     RETURN RETURN-VALUE.
     1026   END PROCEDURE.
     1027   PROCEDURE get-attribute-list :
     1028     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1029     RUN broker-get-attribute-list IN adm-broker-hdl
     1030         (INPUT THIS-PROCEDURE,
     1031          INPUT ?,
     1032          OUTPUT p-attr-list) NO-ERROR.
     1033     RETURN.
     1034   END PROCEDURE.
     1035   PROCEDURE new-state :
     1036     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1037     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1038     RETURN.
     1039   END PROCEDURE.
     1040   PROCEDURE notify :
     1041     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1042     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1043     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1044         RETURN "ADM-ERROR":U.
     1045     RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE set-attribute-list :
     1048     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1049     RUN ensure-broker.
     1050     RUN broker-set-attribute-list IN adm-broker-hdl
     1051         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1052     RETURN.
     1053   END PROCEDURE.
     1054   PROCEDURE set-position :
     1055       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1056       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1057       IF VALID-HANDLE(adm-object-hdl) THEN
     1058       DO:
     1059         ASSIGN adm-object-hdl:ROW    =   p-row
     1060                adm-object-hdl:COLUMN =   p-col.
     1061       END.
     1062       RETURN.
     1063   END PROCEDURE.
     1064   PROCEDURE adm-display-fields :
     1065       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1066       RETURN.
     1067   END PROCEDURE.
     1068   PROCEDURE adm-open-query :
     1069     RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE adm-row-changed :
     1072         IF VALID-HANDLE(adm-object-hdl) THEN
     1073           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1074         RUN notify ('row-available':U).
     1075         RETURN.
     1076   END PROCEDURE.
     1077   PROCEDURE reposition-query :
     1078       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1079       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1080       RETURN.
     1081   END PROCEDURE.
     1082     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1083     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1084     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1085     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1086     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1087     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1088     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1089     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1090     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1091     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1092     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1093     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1094     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1095     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1096     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1097     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1098     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1099     IF "":U = "":U THEN
     1100       RUN modify-list-attribute IN adm-broker-hdl
     1101         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1102     RUN use-create-on-add(?).
     1103   PROCEDURE adm-add-record :
     1104       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1105          "must have at least one Enabled Table to perform Add.":U
     1106          VIEW-AS ALERT-BOX ERROR.
     1107       RETURN.
     1108   END PROCEDURE.
     1109   PROCEDURE adm-assign-record :
     1110    MESSAGE
     1111          "Object ":U THIS-PROCEDURE:FILE-NAME
     1112            "must have at least one Enabled Table to perform Assign.":U
     1113              VIEW-AS ALERT-BOX ERROR.
     1114      RETURN.
     1115     END PROCEDURE.
     1116   PROCEDURE adm-assign-statement :
     1117     RETURN.
     1118   END PROCEDURE.
     1119   PROCEDURE adm-cancel-record :
     1120      RETURN.
     1121     END PROCEDURE.
     1122   PROCEDURE adm-copy-record :
     1123       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1124        "must have at least one Enabled Table to perform Copy.":U
     1125          VIEW-AS ALERT-BOX ERROR.
     1126       RETURN.
     1127   END PROCEDURE.
     1128   PROCEDURE adm-create-record :
     1129      RETURN.
     1130   END PROCEDURE.
     1131   PROCEDURE adm-current-changed :
     1132     RETURN.
     1133   END PROCEDURE.
     1134   PROCEDURE adm-delete-record :
     1135    MESSAGE
     1136          "Object ":U THIS-PROCEDURE:FILE-NAME
     1137            "must have at least one Enabled Table to perform Delete.":U
     1138              VIEW-AS ALERT-BOX ERROR.
     1139       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1140       RETURN.
     1141   END PROCEDURE.
     1142   PROCEDURE adm-disable-fields :
     1143         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1144       RETURN.
     1145   END PROCEDURE.
     1146   PROCEDURE adm-enable-fields :
     1147       RETURN.
     1148   END PROCEDURE.
     1149   PROCEDURE adm-end-update :
     1150     RETURN.
     1151   END PROCEDURE.
     1152   PROCEDURE adm-reset-record :
     1153       RETURN.
     1154   END PROCEDURE.
     1155   PROCEDURE adm-update-record :
     1156       MESSAGE
     1157         "Object ":U THIS-PROCEDURE:FILE-NAME
     1158           "must have at least one Enabled Table to perform Update.":U
     1159             VIEW-AS ALERT-BOX ERROR.
     1160      RETURN.
     1161   END PROCEDURE.
     1162   PROCEDURE check-modified :
     1163   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1164   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1165   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1166   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1167     IF check-state = "check":U THEN
     1168     DO:
     1169       RUN get-link-handle IN adm-broker-hdl
     1170         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1171            OUTPUT group-target-list).
     1172       IF group-target-list NE "":U THEN
     1173       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1174         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1175         RUN check-modified IN curr-widget ('group-check':U).
     1176         IF RETURN-VALUE NE "":U THEN
     1177         DO:
     1178           RUN check-modified-message(RETURN-VALUE).
     1179           RETURN "":U.
     1180         END.
     1181       END.
     1182     END.
     1183     RETURN "":U.
     1184   END PROCEDURE.
     1185   PROCEDURE check-modified-message :
     1186     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1187        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1188           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1189        IF RETURN-VALUE = "YES":U THEN
     1190           RUN notify ('view,CONTAINER-SOURCE':U).
     1191        MESSAGE IF p-changed-table NE ? THEN
     1192           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1193           ELSE "Current values have been changed."
     1194           SKIP "  Do you wish to save those changes?"
     1195           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1196        IF ANS THEN
     1197        DO:
     1198           IF group-assign-target THEN
     1199             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1200           ELSE RUN dispatch('update-record':U).
     1201           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1202           DO:
     1203               MESSAGE "Changes to the previous record were not saved."
     1204                 VIEW-AS ALERT-BOX ERROR.
     1205               IF group-assign-target THEN
     1206                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1207               ELSE RUN dispatch ('cancel-record':U).
     1208           END.
     1209        END.
     1210        ELSE DO:
     1211          IF group-assign-target THEN
     1212             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1213          ELSE RUN dispatch('cancel-record':U).
     1214        END.
     1215        RETURN.
     1216   END PROCEDURE.
     1217   PROCEDURE get-rowid :
     1218       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1219       ASSIGN
     1220       p-table   =   adm-first-table.
     1221       RETURN.
     1222   END PROCEDURE.
     1223   PROCEDURE init-group-assign :
     1224       RUN request-attribute IN adm-broker-hdl
     1225         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1226       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1227         group-assign-target = yes.
     1228       ELSE group-assign-target = no.
     1229       RETURN.
     1230   END PROCEDURE.
     1231   PROCEDURE set-editors :
     1232       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1233       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1234       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1235       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1236       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1237       DO WHILE VALID-HANDLE (curr-widget):
     1238           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1239              curr-widget:HIDDEN = no THEN DO:
     1240             CASE p-field-setting:
     1241               WHEN "INITIALIZE":U THEN
     1242               DO:
     1243                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1244                     read-only-list +
     1245                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1246                        STRING(curr-widget).
     1247               END.
     1248               WHEN "DISABLE":U OR
     1249               WHEN "ENABLE":U THEN
     1250               DO:
     1251                   curr-widget:SENSITIVE = yes.
     1252                   RUN get-attribute ('Read-Only-Editors':U).
     1253                   IF RETURN-VALUE = ? OR
     1254                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1255                       curr-widget:READ-ONLY =
     1256                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1257               END.
     1258               WHEN "CLEAR":U THEN
     1259                   curr-widget:SCREEN-VALUE = "":U.
     1260             END CASE.
     1261           END.
     1262           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1263       END.
     1264       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1265         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1266           + '"':U).
     1267       RETURN.
     1268   END PROCEDURE.
     1269   PROCEDURE use-check-modified-all :
     1270    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1271     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1272     RETURN.
     1273   END PROCEDURE.
     1274   PROCEDURE use-create-on-add :
     1275   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1276      RETURN.
     1277   END PROCEDURE.
     1278   PROCEDURE use-initial-lock :
     1279     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1280     ASSIGN adm-initial-lock = p-attr-value.
     1281     RETURN.
     1282   END PROCEDURE.
     1283     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1284   ASSIGN
     1285          FRAME F-Main:SCROLLABLE       = FALSE
     1286          FRAME F-Main:HIDDEN           = TRUE.
     1287   ON VALUE-CHANGED OF v-print-null-qnty IN FRAME F-Main
     1288   DO:
     1289        ASSIGN
     1290         v-print-null-qnty
     1291   .
     1292   END.
     1293   PROCEDURE disable_UI :
     1294     HIDE FRAME F-Main.
     1295     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1296   END PROCEDURE.
     1297   PROCEDURE local-apply-layout :
     1298     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1299   END PROCEDURE.
     1300   PROCEDURE local-initialize :
     1301   RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1302   END PROCEDURE.
     1303   PROCEDURE my-report :
     1304       run rep/r-tap.p ( INPUT my-handle
     1305                       , INPUT v-print-null-qnty
     1306                       , input SortType
     1307                       , input x-SelectGood
     1308                       ) .
     1309   END PROCEDURE.
     1310   PROCEDURE my-var :
     1311   assign frame F-Main SortType  v-print-null-qnty .
     1312   def var t-class as char no-undo.
     1313   def var t-sort as char no-undo.
     1314     case classify:
     1315       when "no-classify":u    then t-class =   "Без классификации" .
     1316       when "prod":u           then t-class =   "Производители"   .
     1317       when "post":u           then t-class =   "Поставщики"   .
     1318       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1319       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1320       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1321       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1322       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1323       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1324       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1325       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1326       when  "t-level":u       then t-class =   "Терминальные группы" .
     1327    end case.
     1328     case sorttype:
     1329       when "sort-pp":u               then t-sort =   "по порядку" .
     1330       when "sort-code":u             then t-sort =   "по коду" .
     1331       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1332       when "sort-qunty":u            then t-sort =   "по реализации".
     1333       when "sort-name":u             then t-sort =   "по наименованию".
     1334       when "sort-type":u             then t-sort =   "по типу ткани".
     1335       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1336       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1337    end case.
     1338   ReportNAme = "Акт переоценки за период ТАП1-ДО".
     1339   ReportHeader =
     1340                 "Сортировка " + t-sort  + chr(10) +
     1341                  (if v-print-null-qnty then "Показывать нулевые строки "  else "Не показывать нулевые  строки " ) .
     1342   END PROCEDURE.
