      169             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      170             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      171             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      172             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      173             .
