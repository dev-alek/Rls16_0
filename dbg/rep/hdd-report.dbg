      455   define variable v-obj-name          as character no-undo .
      456   do
      457     on error undo, return error return-value
      458     :
      459     for first ub.clients no-lock where ub.clients.obj-code = v-cntxp-curr-host-code and ub.clients.obj-type = 'орг':U:
      460       v-host-name = ub.clients.obj-name .
      461     end.
      462     p-obj-list = trim(p-obj-list,",") .
      463     v-time-start = mtime (p-Time-start) / 1000 .
      464     v-time-end  = mtime (p-Time-end) / 1000 .
      465     if p-Date-start = ? then p-Date-start = today .
      466     if p-Date-end = ? then p-Date-end = today .
      467     v-period = "c: " + string (p-date-start,"99.99.9999") + " " + string (v-time-start,"HH:MM:SS") + " по " + string (p-date-end,"99.99.9999") + " " + string (v-time-end,"HH:MM:SS") .
      468     if p-obj-list = "" then p-obj-list = string(v-cntxp-db-num) .
      469     do ii = 1 to num-entries (p-obj-list, chr(44)):
      470       for first ub.clients no-lock where ub.clients.obj-code = integer(entry(ii, p-obj-list, chr(44))) and ub.clients.obj-type = 'маг':U:
      471         v-obj-name = v-obj-name + "," + ub.clients.obj-name .
      472       end.
      473       for each buf_devisPC no-lock where buf_devisPC.DB-num = integer(entry(ii, p-obj-list, chr(44))):
      474         if buf_devisPC.namepc begins p-namePk and buf_devisPC.modeldevice begins p-ModelDisk then
      475         do:
      476           create tt-devicePC .
      477           assign
      478             tt-devicePC.id          = buf_devisPC.id
      479             tt-devicePC.db-num      = buf_devisPC.DB-num
      480             tt-devicePC.modeldevice = buf_devisPC.modeldevice
      481             tt-devicePC.ModelPC     = buf_devisPC.ModelPC
      482             tt-devicePC.namepc      = buf_devisPC.namepc
      483             .
      484         end.
      485         else next.
      486         empty temp-table tt-attrDevis .
      487         RAW_:
      488         for each buf_devisPCAttr no-lock where buf_devisPCAttr.id = tt-devicePC.id and buf_devisPCAttr.db-num = tt-devicePC.DB-num and buf_devisPCAttr.attr-code begins p-AttrName and buf_devisPCAttr.type begins p-AttrType
      489           and buf_devisPCAttr.attr-code <> "ProcDisk" and buf_devisPCAttr.attr-code <> "UserProc" and buf_devisPCAttr.attr-code <> "testStatus" and buf_devisPCAttr.date >= p-Date-start
      490           and buf_devisPCAttr.date <= p-Date-end break by buf_devisPCAttr.attr-code by buf_devisPCAttr.date by buf_devisPCAttr.time_:
      491           if buf_devisPCAttr.date = p-Date-start and buf_devisPCAttr.time_ < v-time-start then next RAW_.
      492           if buf_devisPCAttr.date = p-Date-end and buf_devisPCAttr.time_ > v-time-end then next RAW_.
      493           find first tt-attrDevis where tt-attrDevis.id = buf_devisPCAttr.id and tt-attrDevis.db-num = buf_devisPCAttr.db-num and tt-attrDevis.attr-code = buf_devisPCAttr.attr-code and tt-attrDevis.date = buf_devisPCAttr.date
      494             and tt-attrDevis.time_ = buf_devisPCAttr.time_ no-error .
      495           if not available (tt-attrDevis) then
      496           do:
      497             create tt-attrDevis .
      498             buffer-copy buf_devisPCAttr to tt-attrDevis .
      499           end.
      500         end.
      501         for each tt-attrDevis where tt-attrDevis.id = tt-devicePC.id and tt-attrDevis.db-num = tt-devicePC.db-num break by tt-attrDevis.attr-code by tt-attrDevis.date by tt-attrDevis.time_:
      502           if first-of (tt-attrDevis.attr-code) then
      503           do:
      504             create tt-devicePCAttr .
      505             assign
      506               tt-devicePCAttr.id        = tt-attrDevis.id
      507               tt-devicePCAttr.name_     = tt-attrDevis.attr-code
      508               tt-devicePCAttr.type_     = tt-attrDevis.type
      509               tt-devicePCAttr.value_    = decimal(tt-attrDevis.attr-value)
      510               tt-devicePCAttr.raw_value = tt-attrDevis.attr-Raw-value
      511               .
      512           end.
      513           if last-of (tt-attrDevis.attr-code) and last-of (tt-attrDevis.date) then
      514           do:
      515             find first tt-devicePCAttr where tt-devicePCAttr.id = tt-attrDevis.id
      516               and tt-devicePCAttr.name_ = tt-attrDevis.attr-code no-error .
      517             if available (tt-devicePCAttr) then
      518             do:
      519               assign
      520                 tt-devicePCAttr.tresh  = decimal(tt-attrDevis.tresh)
      521               .
      522               decimal (tt-attrDevis.attr-Raw-value) no-error .
      523               if not error-status:error then do:
      524                tt-devicePCAttr.ch_raw = decimal(tt-attrDevis.attr-Raw-value) - decimal(tt-devicePCAttr.raw_value) .
      525               end.
      526               tt-devicePCAttr.ch_val = decimal(tt-attrDevis.attr-value) - tt-devicePCAttr.value_ .
      527               tt-devicePCAttr.raw_value = tt-attrDevis.attr-Raw-value.
      528               tt-devicePCAttr.value_    = decimal(tt-attrDevis.attr-value).
      529             end.
      530           end.
      531         end.
      532         assign
      533         v-time-start1 = ""
      534         v-date-end = ?
      535         v-date-start = ?
      536         .
      537         for each tt-attrDevis no-lock where tt-attrDevis.id = tt-devicePC.id and tt-attrDevis.db-num = tt-devicePC.db-num break by tt-attrDevis.date by tt-attrDevis.time_:
      538           if first-of (tt-attrDevis.date) then
      539           do:
      540             if v-time-start1 = "" then v-time-start1  = string(truncate (tt-attrDevis.time_ / 3600, 0)) + ":" + string((tt-attrDevis.time_ modulo 3600) / 60,"99") .
      541             if v-date-start = ? then v-date-start = tt-attrDevis.date .
      542           end.
      543           if last-of (tt-attrDevis.date) and last-of (tt-attrDevis.time_) then
      544           do:
      545             find first buf_tt-devicePC where buf_tt-devicePC.id = tt-attrDevis.id and buf_tt-devicePC.db-num = tt-attrDevis.db-num no-error .
      546             assign
      547               buf_tt-devicePC.time_end   = string(truncate (tt-attrDevis.time_ / 3600, 0)) + ":" + string((tt-attrDevis.time_ modulo 3600) / 60,"99")
      548               buf_tt-devicePC.date_end   = string(tt-attrDevis.date)
      549               buf_tt-devicePC.time_start = v-time-start1
      550               buf_tt-devicePC.date_start = string(v-date-start)
      551               .
      552           end.
      553         end.
      554       end.
      555     find first tt-devicePCAttr no-error .
      556     if not available (tt-devicePCAttr) then
      557     do:
      558       message "По АЗК №" + entry(ii, p-obj-list, chr(44)) + " отсутствуют данные за выбранный период"
      559         view-as alert-box.
      560     end.
      561     end.
      562     find first tt-devicePCAttr no-error .
      563     if not available (tt-devicePCAttr) then return .
      564     find first tt-devicePC no-error .
      565     if not available (tt-devicePC) then
      566     do:
      567       message "По АЗК №" + p-obj-list + " отсутствуют данные за выбранный период"
      568         view-as alert-box.
      569       return .
      570     end.
      571     find first tt-devicePC no-error .
      572     run get-report-num (output p-report-id).
      573     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
      574     v-obj-name = trim(v-obj-name,",").
      575     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      576     put stream OutStr-html unformatted
      577       "<!DOCTYPE HTML>" skip
      578       ' <html>' skip
      579       '  <head>' skip
      580       '   <meta charset="utf-8">' skip
      581       '    <style type="text/css">' skip
      582       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      583       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      584       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      585       '   </style>' skip
      586       '  </head>' skip
      587       .
      588     put stream OutStr-html unformatted
      589       '<body>' skip
      590       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
      591       '<thead>' skip
      592       .
      593     put stream OutStr-html unformatted
      594       '<tr>' skip
      595       '<td style="width: 50px;"></td>' skip
      596       '<td style="width: 70px;"></td>' skip
      597       '<td style="width: 70px;"></td>' skip
      598       '<td style="width: 100px;"></td>' skip
      599       '<td style="width: 100px;"></td>' skip
      600       '<td style="width: 170px;"></td>' skip
      601       '<td style="width: 50px;"></td>' skip
      602       '<td style="width: 50px;"></td>' skip
      603       '<td style="width: 70px;"></td>' skip
      604       '<td style="width: 50px;"></td>' skip
      605       '<td style="width: 80px;"></td>' skip
      606       '<td style="width: 80px;"></td>' skip
      607       '</tr>' skip
      608       '<tr><td colspan="12" style="text-align: center;">Результаты проверки HDD</td></tr>'
      609       '<tr><td colspan="12" style="text-align: left;">По фирме: ' + v-host-name + '</td></tr>'
      610       '<tr><td colspan="12" style="text-align: left;">По объектам: ' + v-obj-name + '</td></tr>'
      611       '<tr><td colspan="12" style="text-align: left;">За период ' + v-period + '</td></tr>'
      612       .
      613     put stream OutStr-html unformatted
      614       '<TR><TD colspan="12"></TD></TR>' skip
      615       '</thead>' skip
      616       '<tbody>' skip
      617       .
      618     put stream OutStr-html unformatted
      619       '<TR>' skip
      620       '<TD text_wrap="true" rowspan="2" style="text-align: center;">АЗК</TD>' skip
      621       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Дата и время первого теста за период</TD>' skip
      622       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Дата и время последнего теста за период</TD>' skip
      623       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Имя ПК</TD>' skip
      624       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Модель диска</TD>' skip
      625       '<TD text_wrap="true" colspan="7" style="text-align: center;">Атрибуты диска</TD>' skip
      626       '</TR>' skip .
      627     put stream OutStr-html unformatted
      628       '<TR>' skip
      629       '<TD text_wrap="true" style="text-align: center;">Название</TD>' skip
      630       '<TD text_wrap="true" style="text-align: center;">Value</TD>' skip
      631       '<TD text_wrap="true" style="text-align: center;">Thresh</TD>' skip
      632       '<TD text_wrap="true" style="text-align: center;">Тип</TD>' skip
      633       '<TD text_wrap="true" style="text-align: center;">Raw_value</TD>' skip
      634       '<TD text_wrap="true" style="text-align: center;">Изменение Raw_value</TD>' skip
      635       '<TD text_wrap="true" style="text-align: center;">Изменение Value</TD>' skip
      636       '</TR>'skip
      637       .
      638     for each tt-devicePC no-lock:
      639       find first tt-devicePCAttr no-lock where tt-devicePCAttr.id = tt-devicePC.id no-error .
      640       if not available (tt-devicePCAttr) then next .
      641       put stream OutStr-html unformatted
      642         '<TR>' skip
      643         '<TD text_wrap="true" style="text-align: center;">' + string(tt-devicePC.db-num) + '</TD>' skip
      644         '<TD text_wrap="true" style="text-align: center;">' + string(tt-devicePC.date_start + " " + tt-devicePC.time_start) + '</TD>' skip
      645         '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePC.date_end + " " + tt-devicePC.time_end) + '</TD>' skip
      646         '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePC.namepc) + '</TD>' skip
      647         '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePC.modeldevice) + '</TD>' skip
      648         .
      649       for each tt-devicePCAttr no-lock where tt-devicePCAttr.id = tt-devicePC.id break by tt-devicePCAttr.id by tt-devicePCAttr.name_ by tt-devicePCAttr.date_ by tt-devicePCAttr.time_
      650         :
      651         if tt-devicePCAttr.value_ <= tt-devicePCAttr.tresh then v-color = "red" .
      652         else v-color = "white" .
      653         if first-of (tt-devicePCAttr.id ) then
      654         do:
      655           put stream OutStr-html unformatted
      656             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.name_) + '</TD>' skip
      657             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.value_) + '</TD>' skip
      658             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.tresh) + '</TD>' skip
      659             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.type_) + '</TD>' skip
      660             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.raw_value) + '</TD>' skip
      661             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.ch_raw) + '</TD>' skip
      662             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.ch_val) + '</TD>' skip
      663             '</tr>'
      664             .
      665         end.
      666         else
      667         do:
      668           put stream OutStr-html unformatted
      669             '<TR>' skip
      670             '<TD text_wrap="true" colspan="5" style="text-align: center;"></TD>' skip
      671             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.name_) + '</TD>' skip
      672             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.value_) + '</TD>' skip
      673             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.tresh) + '</TD>' skip
      674             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.type_) + '</TD>' skip
      675             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.raw_value) + '</TD>' skip
      676             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.ch_raw) + '</TD>' skip
      677             '<TD text_wrap="true" style="text-align: center;">' + string (tt-devicePCAttr.ch_val) + '</TD>' skip
      678             '</tr>'
      679             .
      680         end.
      681       end.
      682     end.
      683     put stream OutStr-html unformatted
      684       '</tbody>' skip
      685       '<tfoot>' skip.
      686     put stream OutStr-html unformatted
      687       '</tfoot>' skip
      688       '</table>' skip
      689       '</body>' skip
      690       '</html>' skip
      691       .
      692     output stream OutStr-html close.
      693     run prn-lib-reportviewer-report-name in this-procedure (
      694       input THIS-PROCEDURE
      695       ,input v-file-name-rep-htm
      696       ).
      697   end.
      698   PROCEDURE get-report-num :
      699     define output parameter p-report-num as integer no-undo .
      700     do
      701       on error undo, return error return-value
      702       :
      703       run gbl/getrpnum.p (output p-report-num).
      704     end.
      705   END PROCEDURE.
