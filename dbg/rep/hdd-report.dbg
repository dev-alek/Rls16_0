      204   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   define  stream PrnLibStream.
      206   procedure prn-lib-prn-file :
      207     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      208     define input parameter p-DIsabledoptions as integer no-undo .
      209     define variable v-report-name as character no-undo .
      210     define variable v-user-action as character no-undo .
      211     define variable v-printed     as logical   no-undo .
      212     define variable v-exist       as logical   no-undo .
      213     do
      214       on error undo, return error
      215       :
      216       run prn-lib-get-report-name  in this-procedure (
      217         input parParentProc
      218         ,output v-report-name
      219         ).
      220   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      222     (input  v-report-name
      223     ,input  2
      224     ,output v-exist
      225     )  .
      226       if NOT v-exist then
      227       DO:
      228         Message
      229           "Нет заданий на печать ! "
      230           view-as alert-box .
      231         Return  .
      232       End.
      233       run gbl/prnfilen.w
      234         (input  ""
      235         ,input  p-DisabledOptions
      236         ,input  string(v-report-name )
      237         ,input  7
      238         ,output v-user-action
      239         ,output v-printed
      240         ) .
      241       if v-printed then
      242       do:
      243         return "YES" .
      244       end.
      245       else
      246       do:
      247         return "NO" .
      248       end.
      249     end.
      250   end procedure.
      251   procedure prn-lib-open-stream :
      252     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      253     define input parameter p-page-size    as integer no-undo .
      254     define input parameter p-is-stream    as logical no-undo .
      255     define input parameter p-append       as logical no-undo .
      256     define variable v-report-name as character no-undo .
      257     do
      258       on error undo, return error
      259       :
      260       run prn-lib-get-report-name  in this-procedure (
      261         input parParentProc
      262         ,output v-report-name
      263         ).
      264       if p-is-stream then
      265       do:
      266         if p-append then
      267         do:
      268           output stream PrnLibStream to value( v-report-name )
      269             page-size value(p-page-size) append .
      270         end.
      271         if not p-append then
      272         do:
      273           output stream PrnLibStream to value( v-report-name )
      274             page-size value(p-page-size) .
      275         end.
      276       end.
      277       if not p-is-stream then
      278       do:
      279         if p-append then
      280         do:
      281           output to value( v-report-name )
      282             page-size value(p-page-size) append .
      283         end.
      284         if not p-append then
      285         do:
      286           output to value( v-report-name )
      287             page-size value(p-page-size) .
      288         end.
      289       end.
      290     end.
      291   end procedure.
      292   procedure prn-lib-open-exp :
      293     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      294     define input parameter p-is-stream    as logical no-undo .
      295     define input parameter p-is-append    as logical no-undo .
      296     define output parameter p-ReportFileName as char init "report" no-undo.
      297     define output parameter p-process as logical no-undo .
      298     define variable glog as logical no-undo .
      299     do
      300       on error undo, return error
      301       :
      302       SYSTEM-DIALOG GET-FILE p-ReportFileName
      303         TITLE      "Укажите путь"
      304         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      305         ASK-OVERWRITE
      306         CREATE-TEST-FILE
      307         SAVE-AS
      308         USE-FILENAME
      309         DEFAULT-EXTENSION "txt"
      310         UPDATE glog
      311         .
      312       if not glog then  return.
      313       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      314       if p-is-stream then
      315       do:
      316         if p-is-append then
      317         do:
      318           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      319         end.
      320         else
      321         do:
      322           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      323         end.
      324       end.
      325       else
      326       do:
      327         if p-is-append then
      328         do:
      329           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      330         end.
      331         else
      332         do:
      333           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      334         end.
      335       end.
      336       p-process = yes.
      337     end.
      338   end procedure.
      339   procedure prn-lib-get-report-name :
      340     define input parameter parParentProc  as widget-handle no-undo.
      341     define output parameter p-report-name as character no-undo .
      342     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      343   end procedure.
      344   procedure prn-lib-reportviewer-report-name :
      345     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      346     define input parameter p-report-name-html as character no-undo .
      347     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      348   end procedure.
      349   procedure prn-lib-reportviewer :
      350     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      351     define input parameter p-report-name-html as character no-undo .
      352     define input parameter p-param        as character no-undo .
      353     define variable v-excel           as character no-undo init 'TRUE' .
      354     define variable v-value-character as character no-undo .
      355     define variable v-value-integer   as character no-undo .
      356     define variable v-value-date      as date      no-undo .
      357     define variable v-value-decimal   as decimal   no-undo .
      358     define variable rep-excel         as logical   no-undo .
      359     define variable excel-string      as character no-undo .
      360     define variable v-param-type      as character no-undo .
      361     define variable v-tth             as handle    no-undo .
      362     run adm/shattri.p (
      363       input "get":U
      364       ,input  ""
      365       ,input  0
      366       ,input  'report-glob':U
      367       ,input  'rep-excel':U
      368       ,output v-value-character
      369       ,output v-value-date
      370       ,output v-value-decimal
      371       ,output v-value-integer
      372       ,output rep-excel
      373       ,output v-param-type
      374       ,INPUT-OUTPUT table-handle v-tth
      375       )  .
      376     if rep-excel then v-excel = "TRUE" .
      377     else v-excel = "FALSE" .
      378     if p-param eq ""
      379     then
      380        p-param = "EXCEL:" + v-excel.
      381     else
      382        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      383     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      384   end procedure.
      385   function fnc-convert-dot-to-colon returns character
      386       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      387   function fnc-convert-dot-to-colon returns character
      388   (input p-data as decimal, input p-accur as character, input p-num as integer):
      389       define variable result as character no-undo.
      390       define variable v-str-result as character no-undo.
      391       if p-data = ? then p-data = 0 .
      392       p-data = round(p-data, p-num).
      393       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      394       return v-str-result.
      395   END FUNCTION.
