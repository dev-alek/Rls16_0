      184             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      185             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      186             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      187             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      188             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      189             v-cntxp-load-time       = bf-cntxp_shop.load-time
