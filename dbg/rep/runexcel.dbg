      563   end procedure.
      564   define new global shared variable g#library  as handle no-undo .
      565   define new global shared variable g#library2 as handle no-undo .
      566   define variable var-report-r-b as character no-undo .
      567   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      572   define variable v-waitfram-action01         as character   no-undo .
      573   define variable v-waitfram-action02         as character   no-undo .
      574   define variable v-waitfram-action03         as character   no-undo .
      575   define variable mWaitFramTextBeg            as character   no-undo.
      576   define variable mWaitFramTextEnd            as character   no-undo.
      577   define variable mWaitFramView               as logical     no-undo.
      578   define variable mWaitProcEvent              as logical     no-undo init yes.
      579   define variable mWaitFramInterval           as integer     no-undo init 1 .
      580   define variable mWaitFramStop               as logical     no-undo.
      581   define variable mWaitFramStopUser           as logical     no-undo.
      582   define variable mWaitFramStopTimeOut        as logical     no-undo.
      583   define variable mWaitFramStartProc          as datetime-tz no-undo.
      584   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      585   define button B-WaitFramStop auto-end-key
      586        label "Стоп"
      587        size 10 by 1 tooltip "Остоновить процесс".
      588   define button B-viewProcInfo
      589        label "Информация"
      590        size 15 by 1 tooltip "Информация о процесс".
      591   define frame waitfram
      592     v-waitfram-action01 format "x(72)" no-label skip
      593     v-waitfram-action02 format "x(72)" no-label skip
      594     v-waitfram-action03 format "x(72)" no-label skip
      595     B-viewProcInfo
      596     B-WaitFramStop at row 4 col 30
      597     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      598     .
      599   define new global shared variable mBatchMode as logical no-undo init ?.
      600   define variable mFramBachModHandle as handle no-undo.
      601   mFramBachModHandle = frame waitfram:handle.
      602   define variable mFameOldVis as logical no-undo.
      603   define variable mVisCUrentVin as logical no-undo.
      604   if session:batch-mode
      605   then
      606      mBatchMode = yes.
      607   if mBatchMode = ? then do:
      608     mVisCUrentVin = current-window:visible.
      609     mFameOldVis = mFramBachModHandle:visible.
      610     mFramBachModHandle:visible  = yes.
      611     mBatchMode = mFramBachModHandle:visible ne yes.
      612     mFramBachModHandle:visible = mFameOldVis.
      613     current-window:visible = mVisCUrentVin.
      614   end.
      615    if  log-manager:logfile-name ne ?
      616     then DO:
      617         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      618         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      619         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      620     end.
      621   on choose of B-WaitFramStop in frame waitfram
      622   do:
      623     mWaitFramStop = yes.
      624     mWaitFramStopUser = yes.
      625   end.
      626   function waitfram-check-timeout returns logical():
      627      define variable vtime as int64 no-undo.
      628      if mWaitFramStopTimeOut
      629      then
      630         return yes.
      631      vtime = ( now - mWaitFramStartProc ) / 1000 .
      632      if     mWaitFramTimeOut ne ?
      633         and mWaitFramTimeOut ne 0
      634         and mWaitFramTimeOut lt vtime
      635      then do:
      636         mWaitFramStopTimeOut = yes.
      637      end.
      638      return mWaitFramStopTimeOut.
      639   end.
      640   procedure waitfram-hide :
      641     if not session:batch-mode
      642     then do
      643     on error undo, return error return-value
      644     :
      645       pause 0 before-hide .
      646       if not mBatchMode then
      647         hide frame waitfram .
      648     if     not mWaitFramView
      649        and mWaitProcEvent
      650     then
      651       process events .
      652     end.
      653   end procedure.
      654   procedure waitfram-show :
      655     define input  parameter p-message as character no-undo .
      656     define variable v-left-margin as integer   no-undo .
      657     if not session:batch-mode
      658     then do
      659     on error undo, return error return-value
      660     :
      661       if length(p-message) <= 70 then do:
      662         assign
      663           v-left-margin = integer((70 - length(p-message)) / 2)
      664         .
      665         assign
      666           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      667         .
      668         assign
      669           v-waitfram-action01 = " "
      670           v-waitfram-action02 = " "
      671                                    + fill(" ", v-left-margin)
      672                                    + p-message
      673           v-waitfram-action03 = " "
      674         .
      675       end.
      676       else do:
      677         define variable vRindex1 as integer no-undo.
      678         define variable vRindex2 as integer no-undo.
      679         vRindex1 = r-index(p-message," ",70).
      680         if vRindex1 = 0
      681         then
      682            vRindex1 = 70.
      683         if length(p-message)  <= vRindex1 + 70 then do:
      684           assign
      685             v-waitfram-action01 = " "
      686             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      687             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      688           .
      689         end.
      690         else do:
      691           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      692           if vRindex2 <= vRindex1
      693           then
      694              vRindex2 = vRindex1 + 70.
      695           assign
      696             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      697             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      698             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      699           .
      700         end.
      701       end.
      702       B-viewProcInfo:visible   in frame waitfram = no.
      703       B-viewProcInfo:sensitive in frame waitfram = no.
      704       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      705       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      706       if  (   mWaitFramView
      707          or  mWaitProcEvent)
      708          and not mBatchMode
      709       then
      710          display
      711             v-waitfram-action01 skip
      712             v-waitfram-action02 skip
      713             v-waitfram-action03 skip
      714          with frame waitfram .
      715       if     mWaitFramView
      716          then do:
      717             if     mWaitFramInterval ne ?
      718                and not mBatchMode
      719             then
      720                wait-for go of frame waitfram pause mWaitFramInterval.
      721          end.
      722          else
      723             if     mWaitProcEvent
      724                and not mBatchMode
      725             then
      726                process events .
      727     end.
      728   end procedure.
      729      procedure waitfram-show-this:
      730         define input  parameter iInterval as int64 no-undo.
      731         define variable vtime as int64 no-undo.
      732         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      733         mWaitFramInterval = iInterval.
      734         run waitfram-show (substitute("&1&2 &3&4" ,
      735                                       mWaitFramTextBeg ,
      736                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      737                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      738                                       mWaitFramTextEnd
      739                                      )
      740                           ).
      741      end.
      742      procedure WaitFramRunPause:
      743         define input  parameter iInterval as dec no-undo.
      744         define variable vStart  as datetime-tz no-undo.
      745         define variable vend    as datetime-tz no-undo.
      746         define variable vint as int64 no-undo.
      747         define variable vOk as logical no-undo.
      748         vStart = now.
      749         vend   = vStart.
      750         publish "WaitFramPause" (iInterval,output vOk).
      751         vend   =  now.
      752         vint = vend - vStart.
      753         vint = iInterval - vint / 1000.
      754         if     not mWaitFramStop
      755            and (   vint > 0
      756                 or (    not vOk
      757                     and iInterval eq ?
      758                     )
      759                 )
      760         then
      761            run waitfram-show-this (iInterval).
      762         vend   =  now.
      763         vint = vend - vStart.
      764         vint = iInterval - vint / 1000.
      765         if     not mWaitFramStop
      766            and vint > 0
      767         then do:
      768            run gbl/pause.p (vint * 1000).
      769         end.
      770         if iInterval ne ?
      771         then
      772            publish "WaitFramStop".
      773         waitfram-check-timeout().
      774      end.
      775      procedure WaitFramWaitFor:
      776         define input  parameter iInterval as dec no-undo.
      777         assign
      778            mWaitFramStartProc   = now
      779            mWaitFramStopUser    = no
      780            mWaitFramStopTimeOut = no
      781         .
      782         block-wait:
      783         do while not mWaitFramStop:
      784            run WaitFramRunPause (iInterval).
      785            if  waitfram-check-timeout()
      786            then do:
      787               leave block-wait.
      788            end.
      789         end.
      790         run waitfram-hide.
      791      end.
      792   procedure waitfram-join :
      793     define input  parameter p-line-1  as character no-undo .
      794     define input  parameter p-line-2  as character no-undo .
      795     define input  parameter p-line-3  as character no-undo .
      796     define output parameter p-message as character no-undo .
      797     do
      798     on error undo, return error return-value
      799     :
      800       assign
      801         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      802                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      803                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      804       .
      805     end.
      806   end procedure.
      807   function waitfram-join-function returns character
      808     (input p-line-1 as character
      809     ,input p-line-2 as character
      810     ,input p-line-3 as character
      811     ).
      812     define variable v-message as character no-undo .
      813     run waitfram-join in this-procedure
      814       (input  p-line-1
      815       ,input  p-line-2
      816       ,input  p-line-3
      817       ,output v-message
      818       ) .
      819     return v-message .
      820   end function .
      821   define variable tempfile-frm as character no-undo .
      822   define variable tempfile-t-t as character no-undo .
      823   define variable res          as character no-undo .
      824   define variable v-cmdln      as character no-undo .
      825   define variable v-exefile    as character no-undo .
      826   define variable v-inifile    as character no-undo .
      827   define variable err-file     as character no-undo .
      828   define variable v-silent     as logical no-undo .
      829   define variable v-mess       as character no-undo .
      830   define buffer buf_sheetf for sheetf.
      831   define stream forformat .
      832   do
      833   on error undo, return error return-value
      834   :
      835     if make-excel
      836     then do:
      837       find first buf_sheetf where
      838                buf_sheetf.sheet-num = 1.
      839       if buf_sheetf.silent-save then do:
      840         v-silent = yes.
      841       end.
      842       if not make-excel-com
      843       then do:
      844         define variable v-full-path        as character no-undo .
      845         define variable v-path             as character no-undo .
      846         define variable v-file-name        as character no-undo .
      847         define variable v-file-name-no-ext as character no-undo .
      848         define variable v-file-name-ext    as character no-undo .
      849         run gbl/filename.p
      850           (input  tempfile
      851           ,output v-full-path
      852           ,output v-path
      853           ,output v-file-name
      854           ,output v-file-name-no-ext
      855           ,output v-file-name-ext
      856           ) .
      857         assign
      858           tempfile-frm = v-path + '/':u + v-file-name-no-ext + '.':U + 'frm':U
      859           tempfile-t-t = v-path + '\':u + v-file-name-no-ext + '.':U + 't-t':U
      860         .
      861         IF SEARCH(tempfile-t-t) <> ?
      862         then do:
      863            run rep/mcr-rep.p
      864              (input tempfile-t-t
      865              ) .
      866            os-delete  value( tempfile-t-t ) .
      867            os-delete  value( tempfile  ) .
      868            define variable err-status as integer   no-undo .
      869            err-status = OS-ERROR.
      870            IF err-status <> 0 THEN  return "disable-button":U.
      871                               else  return.
      872         end.
      873         output stream forformat to value(tempfile-frm) .
      874         for each sheetf no-lock
      875         on error undo, return error
      876         :
      877           export stream forformat sheetf .
      878         end.
      879         output stream forformat close.
      880         run gbl/getexini.p
      881           (output v-exefile
      882           ,output v-inifile
      883           ) no-error .
      884         if error-status :error
      885         then do:
      886           v-mess = substitute("&1 &2 &3&4" +
      887                               "Ошибка при определении имени выполняемого файла и *.ini файла&4" +
      888                               "&5&4&6&4"
      889                                 ,vss-workfile
      890                                 ,vss-revision
      891                                 ,vss-description
      892                                 ,chr(10)
      893                                 ,error-status :get-message(1)
      894                                 ,return-value
      895                                 ).
      896           if not v-silent then do:
      897           message
      898             v-mess
      899             view-as alert-box error .
      900           undo, return error .
      901         end.
      902           else do:
      903             undo, return error v-mess.
      904           end.
      905         end.
      906         run gbl/_tmpfile.p ("", "", output err-file) .
      907         assign
      908           err-file = err-file + ".err":u
      909           v-cmdln  = v-exefile
      910                    + chr(32) + "-ininame":u + chr(32) + v-inifile
      911                    + chr(32) + "-p":U + chr(32) + "rep/extexcel.p":u
      912                    + chr(32) + "-param":U + chr(32) + chr(34)
      913                    + tempfile + chr(44)
      914                    + err-file + chr(44)
      915                    + string(make-excel) + chr(44)
      916                    + string(make-excel-com) + chr(44)
      917                    + tempfile-frm + chr(34)
      918         .
      919         run waitfram-show in this-procedure
      920           (input "Выполнение команды" + chr(32) + v-cmdln
      921           ).
      922         run gbl/syn3.p
      923           (input v-cmdln
      924           ,input err-file
      925           ,input "Ждите! Идет форматирование файла..."
      926           ,output res
      927           ) no-error .
      928         run waitfram-hide in this-procedure .
      929         if res <> '0'
      930         then do:
      931           v-mess = substitute("Не  удалось  вывести  файл  в   EXCEL").
      932           if not v-silent then do:
      933             message
      934             v-mess
      935           view-as alert-box error.
      936           undo, return error .
      937         end.
      938           else do:
      939             undo, return error v-mess.
      940           end.
      941         end.
      942       end.
      943       else do:
      944         assign
      945           ch#ExcelApplication:Interactive    = true
      946           ch#ExcelApplication:ScreenUpdating = true
      947           ch#ExcelApplication:Visible        = true
      948         .
      949         run ClearExcel.
      950         output Stream  ForExcel close.
      951         os-delete  value( string( tempfile ) ) .
      952       end.
      953     end.
      954     return .
      955   end.
      956   procedure ClearExcel :
      957     do
      958     on error undo, return error
      959     :
      960       run waitfram-hide in this-procedure .
      961       output Stream  ForExcel close.
      962   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      963   if valid-handle(ch#WorkSheet) then
      964   RELEASE OBJECT ch#WorkSheet no-error.
      965   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      966   if valid-handle(ch#Workbook) then
      967   RELEASE OBJECT ch#Workbook no-error.
      968       assign
      969         ch#ExcelApplication:Interactive    = true
      970         ch#ExcelApplication:ScreenUpdating = true
      971         ch#ExcelApplication:Visible        = true
      972       .
      973   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      974   if valid-handle(ch#ExcelApplication) then
      975   RELEASE OBJECT ch#ExcelApplication no-error.
      976       process events .
      977     end.
      978   end procedure.
