      206   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      207   procedure cur-time :
      208      define output parameter p-today as date      no-undo .
      209      define output parameter p-time  as integer   no-undo .
      210     do
      211     on error undo, return error
      212     :
      213       define variable v-date1 as date      no-undo .
      214       define variable v-date2 as date      no-undo .
      215       define variable v-time  as integer   no-undo .
      216       assign
      217         v-date1 = today
      218         v-time  = time
      219         v-date2 = today
      220       .
      221       if v-date1 <> v-date2
      222       then do:
      223         assign
      224           v-date1 = today
      225           v-time  = v-time
      226         .
      227       end.
      228       assign
      229         p-today = v-date1
      230         p-time  = v-time
      231       .
      232     end.
      233   end.
      234   function cur-time-date returns character
      235   :
      236     return string(today, '99/99/9999':U) .
      237   end.
      238   function cur-time-mjd returns decimal
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return integer(v-date) - 2400002 + (v-time / 86400) .
      247   end.
      248   function cur-time-get-ending-index returns integer
      249   (input p-number as integer
      250   )
      251   :
      252     if p-number < 0
      253     or p-number = ?
      254     then do:
      255       return 1 .
      256     end.
      257     define variable v-rest as integer   no-undo .
      258     assign
      259       p-number = p-number modulo 100
      260     .
      261     if p-number < 20
      262     then do:
      263       assign
      264         v-rest = p-number
      265       .
      266     end.
      267     else do:
      268       assign
      269         v-rest = p-number modulo 10
      270       .
      271     end.
      272     case v-rest :
      273       when 1
      274       then do:
      275         return 2 .
      276       end.
      277       when 2 or
      278       when 3 or
      279       when 4
      280       then do:
      281         return 3 .
      282       end.
      283       otherwise do:
      284         return 1 .
      285       end.
      286     end case .
      287   end.
      288   procedure cur-time-mjd-to-date :
      289      define input  parameter i-mjd-diff as decimal no-undo.
      290      define output parameter o-Date     as date    no-undo.
      291      define output parameter o-Time     as integer no-undo.
      292      define variable v-day-number as integer   no-undo .
      293      if    i-mjd-diff < 0
      294         or i-mjd-diff = ?
      295      then do:
      296         return "?" .
      297      end.
      298      assign
      299         v-day-number = truncate(i-mjd-diff,0).
      300         o-Date = date(v-day-number + 2400002).
      301         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      302     .
      303   end.
      304   function cur-time-mjd-to-string returns character
      305   (input p-mjd-diff as decimal
      306   )
      307   :
      308     define variable v-day-number as integer   no-undo .
      309     define variable v-seconds    as integer   no-undo .
      310     define variable v-hour       as integer   no-undo .
      311     define variable v-min        as integer   no-undo .
      312     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      313     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      314     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      315     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      316     if p-mjd-diff < 0
      317     or p-mjd-diff = ?
      318     then do:
      319       return "?" .
      320     end.
      321     assign
      322       v-day-number = integer(truncate(p-mjd-diff,0))
      323       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      324     .
      325     if v-seconds > 86400
      326     then do:
      327       assign
      328         v-seconds = 86400 - 1
      329       .
      330     end.
      331     if v-seconds < 0
      332     then do:
      333       assign
      334         v-seconds = 0
      335       .
      336     end.
      337     assign
      338       v-hour = truncate(v-seconds / 3600, 0)
      339     .
      340     assign
      341       v-seconds = v-seconds modulo 3600
      342     .
      343     assign
      344       v-min = truncate(v-seconds / 60, 0)
      345     .
      346     assign
      347       v-seconds = v-seconds modulo 60
      348     .
      349     return
      350         (if v-day-number <> 0
      351           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      352           else ""
      353         )
      354       + (if v-day-number <> 0 or v-hour <> 0
      355           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      356           else ""
      357         )
      358       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      359           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      360           else ""
      361         )
      362       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      363       .
      364   end.
      365   function cur-time-string returns character
      366   :
      367     define variable v-date as date      no-undo .
      368     define variable v-time as integer   no-undo .
      369     run cur-time in this-procedure
      370       (output v-date
      371       ,output v-time
      372       ) .
      373     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      374   end.
      375   function cur-time-string-sec returns character
      376   :
      377     define variable v-date as date      no-undo .
      378     define variable v-time as integer   no-undo .
      379     run cur-time in this-procedure
      380       (output v-date
      381       ,output v-time
      382       ) .
      383     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      384   end.
      385   function cur-time-custom  returns character
      386   (input p-prefix as character
      387   ,input p-date-format as character
      388   ,input p-delimiter as character
      389   ,input p-time-format as character
      390   ,input p-suffix as character
      391   )
      392   :
      393     define variable v-date as date      no-undo .
      394     define variable v-time as integer   no-undo .
      395     run cur-time in this-procedure
      396       (output v-date
      397       ,output v-time
      398       ) .
      399     return
      400       p-prefix
      401       + string(v-date, p-date-format)
      402       + p-delimiter
      403       + string(v-time, p-time-format)
      404       + p-suffix
      405       .
      406   end.
      407   function cur-time-print  returns character
      408   :
      409     define variable v-date as date      no-undo .
      410     define variable v-time as integer   no-undo .
      411     run cur-time in this-procedure
      412       (output v-date
      413       ,output v-time
      414       ) .
      415     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      416   end.
      417   function cur-time-datetime returns datetime
      418   :
      419     define variable v-char as character no-undo .
      420     define variable v-datetime as datetime no-undo .
      421     v-char = cur-time-string().
      422     v-datetime = datetime(v-char).
      423     return  v-datetime.
      424   end.
      425   function cur-time-string-msec returns character
      426   :
      427     define variable v-date as datetime  no-undo .
      428     v-date = now.
      429     return string(v-date) .
      430   end.
