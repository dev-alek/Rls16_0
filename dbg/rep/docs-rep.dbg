     3316   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3317   define variable v-waitfram-action01         as character   no-undo .
     3318   define variable v-waitfram-action02         as character   no-undo .
     3319   define variable v-waitfram-action03         as character   no-undo .
     3320   define variable mWaitFramTextBeg            as character   no-undo.
     3321   define variable mWaitFramTextEnd            as character   no-undo.
     3322   define variable mWaitFramView               as logical     no-undo.
     3323   define variable mWaitProcEvent              as logical     no-undo init yes.
     3324   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3325   define variable mWaitFramStop               as logical     no-undo.
     3326   define variable mWaitFramStopUser           as logical     no-undo.
     3327   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3328   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3329   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3330   define button B-WaitFramStop auto-end-key
     3331        label "Стоп"
     3332        size 10 by 1 tooltip "Остоновить процесс".
     3333   define button B-viewProcInfo
     3334        label "Информация"
     3335        size 15 by 1 tooltip "Информация о процесс".
     3336   define frame waitfram
     3337     v-waitfram-action01 format "x(72)" no-label skip
     3338     v-waitfram-action02 format "x(72)" no-label skip
     3339     v-waitfram-action03 format "x(72)" no-label skip
     3340     B-viewProcInfo
     3341     B-WaitFramStop at row 4 col 30
     3342     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3343     .
     3344   define new global shared variable mBatchMode as logical no-undo init ?.
     3345   define variable mFramBachModHandle as handle no-undo.
     3346   mFramBachModHandle = frame waitfram:handle.
     3347   define variable mFameOldVis as logical no-undo.
     3348   define variable mVisCUrentVin as logical no-undo.
     3349   if session:batch-mode
     3350   then
     3351      mBatchMode = yes.
     3352   if mBatchMode = ? then do:
     3353     mVisCUrentVin = current-window:visible.
     3354     mFameOldVis = mFramBachModHandle:visible.
     3355     mFramBachModHandle:visible  = yes.
     3356     mBatchMode = mFramBachModHandle:visible ne yes.
     3357     mFramBachModHandle:visible = mFameOldVis.
     3358     current-window:visible = mVisCUrentVin.
     3359   end.
     3360    if  log-manager:logfile-name ne ?
     3361     then DO:
     3362         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3363         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3364         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3365     end.
     3366   on choose of B-WaitFramStop in frame waitfram
     3367   do:
     3368     mWaitFramStop = yes.
     3369     mWaitFramStopUser = yes.
     3370   end.
     3371   function waitfram-check-timeout returns logical():
     3372      define variable vtime as int64 no-undo.
     3373      if mWaitFramStopTimeOut
     3374      then
     3375         return yes.
     3376      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3377      if     mWaitFramTimeOut ne ?
     3378         and mWaitFramTimeOut ne 0
     3379         and mWaitFramTimeOut lt vtime
     3380      then do:
     3381         mWaitFramStopTimeOut = yes.
     3382      end.
     3383      return mWaitFramStopTimeOut.
     3384   end.
     3385   procedure waitfram-hide :
     3386     if not session:batch-mode
     3387     then do
     3388     on error undo, return error return-value
     3389     :
     3390       pause 0 before-hide .
     3391       if not mBatchMode then
     3392         hide frame waitfram .
     3393     if     not mWaitFramView
     3394        and mWaitProcEvent
     3395     then
     3396       process events .
     3397     end.
     3398   end procedure.
     3399   procedure waitfram-show :
     3400     define input  parameter p-message as character no-undo .
     3401     define variable v-left-margin as integer   no-undo .
     3402     if not session:batch-mode
     3403     then do
     3404     on error undo, return error return-value
     3405     :
     3406       if length(p-message) <= 70 then do:
     3407         assign
     3408           v-left-margin = integer((70 - length(p-message)) / 2)
     3409         .
     3410         assign
     3411           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3412         .
     3413         assign
     3414           v-waitfram-action01 = " "
     3415           v-waitfram-action02 = " "
     3416                                    + fill(" ", v-left-margin)
     3417                                    + p-message
     3418           v-waitfram-action03 = " "
     3419         .
     3420       end.
     3421       else do:
     3422         define variable vRindex1 as integer no-undo.
     3423         define variable vRindex2 as integer no-undo.
     3424         vRindex1 = r-index(p-message," ",70).
     3425         if vRindex1 = 0
     3426         then
     3427            vRindex1 = 70.
     3428         if length(p-message)  <= vRindex1 + 70 then do:
     3429           assign
     3430             v-waitfram-action01 = " "
     3431             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3432             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3433           .
     3434         end.
     3435         else do:
     3436           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3437           if vRindex2 <= vRindex1
     3438           then
     3439              vRindex2 = vRindex1 + 70.
     3440           assign
     3441             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3442             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3443             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3444           .
     3445         end.
     3446       end.
     3447       B-viewProcInfo:visible   in frame waitfram = no.
     3448       B-viewProcInfo:sensitive in frame waitfram = no.
     3449       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3450       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3451       if  (   mWaitFramView
     3452          or  mWaitProcEvent)
     3453          and not mBatchMode
     3454       then
     3455          display
     3456             v-waitfram-action01 skip
     3457             v-waitfram-action02 skip
     3458             v-waitfram-action03 skip
     3459          with frame waitfram .
     3460       if     mWaitFramView
     3461          then do:
     3462             if     mWaitFramInterval ne ?
     3463                and not mBatchMode
     3464             then
     3465                wait-for go of frame waitfram pause mWaitFramInterval.
     3466          end.
     3467          else
     3468             if     mWaitProcEvent
     3469                and not mBatchMode
     3470             then
     3471                process events .
     3472     end.
     3473   end procedure.
     3474      procedure waitfram-show-this:
     3475         define input  parameter iInterval as int64 no-undo.
     3476         define variable vtime as int64 no-undo.
     3477         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3478         mWaitFramInterval = iInterval.
     3479         run waitfram-show (substitute("&1&2 &3&4" ,
     3480                                       mWaitFramTextBeg ,
     3481                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3482                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3483                                       mWaitFramTextEnd
     3484                                      )
     3485                           ).
     3486      end.
     3487      procedure WaitFramRunPause:
     3488         define input  parameter iInterval as dec no-undo.
     3489         define variable vStart  as datetime-tz no-undo.
     3490         define variable vend    as datetime-tz no-undo.
     3491         define variable vint as int64 no-undo.
     3492         define variable vOk as logical no-undo.
     3493         vStart = now.
     3494         vend   = vStart.
     3495         publish "WaitFramPause" (iInterval,output vOk).
     3496         vend   =  now.
     3497         vint = vend - vStart.
     3498         vint = iInterval - vint / 1000.
     3499         if     not mWaitFramStop
     3500            and (   vint > 0
     3501                 or (    not vOk
     3502                     and iInterval eq ?
     3503                     )
     3504                 )
     3505         then
     3506            run waitfram-show-this (iInterval).
     3507         vend   =  now.
     3508         vint = vend - vStart.
     3509         vint = iInterval - vint / 1000.
     3510         if     not mWaitFramStop
     3511            and vint > 0
     3512         then do:
     3513            run gbl/pause.p (vint * 1000).
     3514         end.
     3515         if iInterval ne ?
     3516         then
     3517            publish "WaitFramStop".
     3518         waitfram-check-timeout().
     3519      end.
     3520      procedure WaitFramWaitFor:
     3521         define input  parameter iInterval as dec no-undo.
     3522         assign
     3523            mWaitFramStartProc   = now
     3524            mWaitFramStopUser    = no
     3525            mWaitFramStopTimeOut = no
     3526         .
     3527         block-wait:
     3528         do while not mWaitFramStop:
     3529            run WaitFramRunPause (iInterval).
     3530            if  waitfram-check-timeout()
     3531            then do:
     3532               leave block-wait.
     3533            end.
     3534         end.
     3535         run waitfram-hide.
     3536      end.
     3537   procedure waitfram-join :
     3538     define input  parameter p-line-1  as character no-undo .
     3539     define input  parameter p-line-2  as character no-undo .
     3540     define input  parameter p-line-3  as character no-undo .
     3541     define output parameter p-message as character no-undo .
     3542     do
     3543     on error undo, return error return-value
     3544     :
     3545       assign
     3546         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3547                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3548                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3549       .
     3550     end.
     3551   end procedure.
     3552   function waitfram-join-function returns character
     3553     (input p-line-1 as character
     3554     ,input p-line-2 as character
     3555     ,input p-line-3 as character
     3556     ).
     3557     define variable v-message as character no-undo .
     3558     run waitfram-join in this-procedure
     3559       (input  p-line-1
     3560       ,input  p-line-2
     3561       ,input  p-line-3
     3562       ,output v-message
     3563       ) .
     3564     return v-message .
     3565   end function .
