     3895                                                     else "":U)
     3896                                               )
     3897   .
     3898   Assign l-col-type="DATE" l-col-len=10 l-col-format= "99/99/99"            l-col-lable="Дата закрытия".
     3899     define variable ed3 as handle no-undo.
