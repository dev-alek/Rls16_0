      963                   AND (v-dec-sep <> ? and v-th-sep <> ?)
      964   .
      965     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
      966                                               INPUT p-dec-sep AS CHARACTER  ) :
      967       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
      968       IF TRIM( p-string ) = "0"                    OR
      969          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
      970          TRIM( p-string ) =       p-dec-sep + "00" OR
      971          TRIM( p-string ) =       p-dec-sep + "0"  OR
      972          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
      973                                                    ELSE DO: ASSIGN v-string = p-string. END.
      974       RETURN ( TRIM( v-string ) ).
      975     END FUNCTION.
      976   FUNCTION reg-output returns character( input p-string as character
      977                                         ,input p-private-data as character
      978                                         ,input p-replace as logical
      979                                         ,input p-supress as logical
      980                                         ,input p-dec-sep as character
      981                                         ,input p-th-sep as character
      982                                         ):
      983   DEFINE VARIABLE v-reg-output as character no-undo .
      984   DEFINE VARIABLE v-data-type as character no-undo .
      985   DEFINE VARIABLE v-progress-format as character no-undo .
      986   assign
      987   v-progress-format = entry(1, p-private-data, chr(4))
      988   v-data-type = entry(2, p-private-data, chr(4))
      989   .
      990   if p-string = ? then return chr(63).
      991   if (v-data-type = "INTEGER"
      992       OR v-data-type = "DECIMAL" ) THEN DO:
      993     IF p-replace THEN DO:
      994       assign
      995         v-reg-output = replace( p-string
      996                                         ,chr(44)
      997                                         ,"":U
      998                                       )
      999         v-reg-output = trim(v-reg-output)
     1000       .
     1001     END.
     1002     else do:
     1003       v-reg-output = p-string.
     1004     end.
     1005     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1006     return v-reg-output.
     1007   end.
     1008     return p-string.
     1009   END FUNCTION.
     1010   procedure OpenForExcel :
     1011      define variable v-ch#ExcelApplication as com-handle no-undo .
     1012      define variable v-ch#Workbook         as com-handle no-undo .
     1013      define variable v-ch#Worksheet        as com-handle no-undo .
     1014      os-delete value( string( session:temp-directory ) +
     1015                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1016      os-delete value( string( session:temp-directory ) +
     1017                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1018      os-delete value( string( session:temp-directory ) +
     1019                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1020      if Make-Excel
     1021      then do:
     1022         output stream ForExcel to value( string( session:temp-directory +
     1023                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1024         assign
     1025            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1026            number-list = 1
     1027         .
     1028         if make-excel-com
     1029         then do:
     1030   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   if valid-handle(ch#WorkSheet) then
     1032   RELEASE OBJECT ch#WorkSheet no-error.
     1033   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1034   if valid-handle(ch#Workbook) then
     1035   RELEASE OBJECT ch#Workbook no-error.
     1036   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1037   if valid-handle(ch#ExcelApplication) then
     1038   RELEASE OBJECT ch#ExcelApplication no-error.
     1039            create "Excel.Application" ch#excelApplication connect no-error.
     1040            if error-status:error
     1041            then do :
     1042           create "Excel.Application" ch#excelApplication no-error.
     1043       if error-status :error then do:
     1044           message
     1045           "Ошибка при запуске Excel" skip
     1046           error-status :get-message(1) skip
     1047           view-as alert-box error .
     1048           undo, return error .
     1049       end.
     1050            end.
     1051            assign
     1052               num#str#  = 0.
     1053               v-ch#excelApplication  = ch#excelApplication.
     1054               v-ch#excelApplication:Interactive = false.
     1055               v-ch#excelApplication:ScreenUpdating = false.
     1056               v-ch#excelApplication:Visible = false.
     1057               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1058               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1059               v-ch#Worksheet = ch#WorkSheet.
     1060               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1061               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1062               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1063               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1064            no-error .
     1065            if error-status:error
     1066            then do:
     1067               Make-Excel-com = false .
     1068               Make-Excel = false .
     1069               output Stream  ForExcel close.
     1070               os-delete value( string( session:temp-directory ) +
     1071                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1072               os-delete value( string( session:temp-directory ) +
     1073                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1074               return.
     1075            end.
     1076         end.
     1077      end.
     1078   end.
     1079   procedure CloseForExcel :
     1080      define variable ii as integer no-undo .
     1081      define variable vsheet-num as integer no-undo.
     1082      if Make-Excel
     1083      then  do:
     1084         output Stream  ForExcel close.
     1085         os-delete value( string( session:temp-directory ) +
     1086                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1087         os-delete value( string( session:temp-directory ) +
     1088                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1089         define buffer buf_sheetf for sheetf.
     1090         find last buf_sheetf no-error .
     1091         if available buf_sheetf
     1092         then
     1093            vsheet-num = buf_sheetf.sheet-num.
     1094         if vsheet-num > 1
     1095         then do:
     1096            do ii = 2 to vsheet-num:
     1097               os-delete value( string( session:temp-directory ) +
     1098                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1099            end.
     1100         end.
     1101   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1102   if valid-handle(ch#WorkSheet) then
     1103   RELEASE OBJECT ch#WorkSheet no-error.
     1104   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   if valid-handle(ch#Workbook) then
     1106   RELEASE OBJECT ch#Workbook no-error.
     1107   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1108   if valid-handle(ch#ExcelApplication) then
     1109   RELEASE OBJECT ch#ExcelApplication no-error.
     1110      end.
     1111   end.
