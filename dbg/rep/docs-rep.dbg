     2347       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     2348       assign
     2349       bfs_tt-allsum.sum-dsc-base-doc-acc    =  - bf_tt-allsum.sum-dsc-base-doc-acc
     2350       bfs_tt-allsum.sum-dsc-rubl-doc-acc    =  - bf_tt-allsum.sum-dsc-rubl-doc-acc
     2351       bfs_tt-allsum.sum-dsc-cli-doc-acc     =  - bf_tt-allsum.sum-dsc-cli-doc-acc
