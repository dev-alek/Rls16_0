       64   define new global shared variable g#vssrevis-logger as handle    no-undo .
       65   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       66   define variable v-vssrevis-logger                   as handle    no-undo .
       67   procedure vss-logevent :
       68     define input  parameter p-extra-paramters as character no-undo .
       69     define variable v-vssrevis-parameters as character no-undo .
       70     do
       71     on error undo, return error return-value
       72     :
       73       if  valid-handle(v-vssrevis-logger)
       74       and v-vssrevis-logger :get-signature("logevent") <> ""
       75       then do:
       76         run vss-get-parameters in this-procedure
       77           (output v-vssrevis-parameters
       78           ).
       79         run logevent in v-vssrevis-logger
       80           (input vss-workfile
       81           ,input vss-revision
       82           ,input v-vssrevis-parameters
       83           ,input p-extra-paramters
       84           ).
       85       end.
       86     end.
       87   end procedure.
       88   assign
       89     v-vssrevis-logger = g#vssrevis-logger
       90   .
       91   if  valid-handle(v-vssrevis-logger)
       92   and v-vssrevis-logger :get-signature("logevent") <> ""
       93   then do:
       94     assign
       95       v-vssrevis-logevent = true
       96     .
       97     run vss-logevent in this-procedure (input vss-description) .
       98   end.
