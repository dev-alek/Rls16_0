     3621   define variable TorgPred            as character no-undo .
     3622   define variable Up-PC               as character no-undo .
     3623   define variable Operator            as character no-undo .
     3624   define variable PayType             as character no-undo .
     3625   define variable Kurs                as decimal   no-undo .
     3626   define variable Our-Obj             as character no-undo .
     3627   define variable KladovName          as character no-undo .
     3628   define variable IspName             as character no-undo .
     3629   define variable PayWaitDate         as date      no-undo .
     3630   define variable NDS-Val             as decimal   no-undo .
     3631   define variable NDS18-Val           as decimal   no-undo .
     3632   define variable NDS10-Val           as decimal   no-undo .
     3633   define variable NDS-Rubl            as decimal   no-undo .
     3634   define variable NDS18-Rubl          as decimal   no-undo .
     3635   define variable NDS10-Rubl          as decimal   no-undo .
     3636   define variable v-ind               as integer   no-undo .
     3637   DEFINE VARIABLE for-doc-attr like   wt-docs.doc-attr no-undo .
     3638   DEFINE VARIABLE for-doc-date like   wt-docs.doc-date no-undo .
     3639   DEFINE VARIABLE for-fact-date like  wt-docs.fact-date no-undo .
     3640   DEFINE VARIABLE for-doc-code like   wt-docs.doc-code no-undo .
     3641   DEFINE VARIABLE for-cli-name like   wt-docs.cli-name no-undo .
     3642   define variable v-vat18-base    as logical      no-undo.
     3643   define variable v-vat10-base    as logical      no-undo.
     3644   define variable v-vat18-rubl    as logical      no-undo.
     3645   define variable v-vat10-rubl    as logical      no-undo.
     3646   define variable sale-base       as decimal   no-undo .
     3647   define variable sale-rubl       as decimal   no-undo .
     3648   define variable sale-base-doc as decimal   no-undo .
     3649   define variable sale-rubl-doc as decimal   no-undo .
     3650   define variable crsa-base-doc as decimal   no-undo .
     3651   define variable crsa-rubl-doc as decimal   no-undo .
     3652   define variable Qnty-doc      as decimal   no-undo .
     3653   define variable comm as character no-undo .
     3654   DEFINE VARIABLE fill8               as character no-undo .
     3655   DEFINE VARIABLE fill11              as character no-undo .
     3656   DEFINE VARIABLE fill12              as character no-undo .
     3657   DEFINE VARIABLE fill15              as character no-undo .
     3658   DEFINE VARIABLE fill18              as character no-undo .
     3659   DEFINE VARIABLE fill19              as character no-undo .
     3660   DEFINE VARIABLE fill21              as character no-undo .
     3661   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     3662        VIEW-AS EDITOR
     3663        SIZE 1 BY 5 NO-UNDO.
     3664   DEFINE FRAME top-frame
     3665   t-1       AT ROW 1 COL 1 no-label
     3666   HEADER
     3667   cur-time-print() AT 5 format "x(35)"
     3668   string( "Страница" ) AT 45 PAGE-NUMBER( DOcsStream ) AT 55 FORMAT ">>>,>>9" SKIP
     3669       with width 232 down stream-io use-text NO-BOX.
     3670   DEFINE FRAME x1
     3671   with width 232 down stream-io use-text NO-BOX.
     3672   if p-detal-NDS-Val = yes
     3673   then do:
     3674       assign
     3675           v-vat18-base = yes
     3676           v-vat10-base = yes
     3677       .
     3678   end.
     3679   if p-detal-NDS-Rubl = yes
     3680   then do:
     3681       assign
     3682           v-vat18-rubl = yes
     3683           v-vat10-rubl = yes
     3684       .
     3685   end.
     3686   assign
     3687     use-column[1] =  yes
     3688     use-column[2] =  yes
     3689     use-column[3] =  yes
     3690     use-column[4] =  yes
     3691     use-column[5] =  yes
     3692     use-column[6] =  pNums
     3693     use-column[7] =  pVal-BruttoSaleSum
     3694     use-column[8] =  pRubl-BruttoSaleSum
     3695     use-column[9] =  pVal-NettoSaleSum
     3696     use-column[10] = pRubl-NettoSaleSum
     3697     use-column[11] = pVal-DiscntSum
     3698     use-column[12] = pRubl-DiscntSum
     3699     use-column[13] = pVal-CostSum
     3700     use-column[14] = pRubl-CostSum
     3701     use-column[15] = pVal-Effect
     3702     use-column[16] = pRubl-Effect
     3703     use-column[17] = pNDS-VAL
     3704     use-column[18] = v-vat18-base
     3705     use-column[19] = v-vat10-base
     3706     use-column[20] = pNDs-RUbl
     3707     use-column[21] = v-vat18-rubl
     3708     use-column[22] = v-vat10-rubl
     3709     use-column[23] = PDiscnt-PC
     3710     use-column[24] = pUP-pc
     3711     use-column[25] = pTOrgPred
     3712     use-column[26] = pOperator
     3713     use-column[27] = PKladov
     3714     use-column[28] = pIspName
     3715     use-column[29] = pPayType
     3716     use-column[30] = pKurs
     3717     use-column[31] = pOur-Obj
     3718     use-column[32] = pPayWaitDate
     3719     use-column[33] = p-sale-base
     3720     use-column[34] = p-sale-rubl
     3721     use-column[35] = pNums-doc
     3722     use-column[36] = p-sale-base-doc
     3723     use-column[37] = p-sale-rubl-doc
     3724     use-column[38] = p-crsa-base-doc
     3725     use-column[39] = p-crsa-rubl-doc
     3726     use-column[40] = p-ps
     3727   .
     3728   assign
     3729     fill8  = fill("-", 8)
     3730     fill11 = fill("-", 11)
     3731     fill12 = fill("-", 12)
     3732     fill15 = fill("-", 15)
     3733     fill18 = fill("-", 18)
     3734     fill19 = fill("-", 19)
     3735     fill21 = fill("-", 21)
     3736   .
     3737   FOR EACH sheetf where sheetf.sheet-num > 1:
     3738     delete sheetf.
     3739   end.
     3740   FIND FIRST sheetf where
     3741              sheetf.sheet-num = 1 No-ERROR.
     3742   assign
     3743   ReportName = p-title
     3744   sheetf.Excel-Column-Lable =  ""
     3745   sheetf.sizes = ""
     3746   Make-Excel = yes.
     3747   .
     3748   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     3749   l-col-pos = 1.
     3750   Assign l-col-type="CHARACTER" l-col-len=4 l-col-format= "x(4)"            l-col-lable="Док. атр.".
     3751     define variable ed1 as handle no-undo.
     3752     define variable l-1 as handle no-undo.
     3753     define variable ll-1 as handle no-undo.
     3754     define variable c-for-doc-attr as widget-handle no-undo.
     3755      if l-col-pos > 320 then l-col-pos = 320 .
     3756     if use-column[1] = true then DO:
     3757           CREATE EDITOR LL-1 IN WIDGET-POOL "My-pool"
     3758             ASSIGN
     3759               FRAME = FRAME top-Frame:HANDLE
     3760               ROW = 1
     3761               COLUMN = l-col-pos
     3762               screen-value = Fill("-", l-col-len)
     3763               WIDTH-CHARS = l-col-len
     3764               HEIGHT-CHARS = 4
     3765           .
     3766           CREATE EDITOR ed1 IN WIDGET-POOL "My-pool"
     3767             ASSIGN
     3768               FRAME = FRAME top-Frame:HANDLE
     3769               ROW = 2
     3770               COLUMN = l-col-pos
     3771               screen-value = l-col-lable
     3772               WIDTH-CHARS = l-col-len
     3773               HEIGHT-CHARS = 4
     3774           .
     3775           CREATE EDITOR L-1 IN WIDGET-POOL "My-pool"
     3776             ASSIGN
     3777               FRAME = FRAME top-Frame:HANDLE
     3778               ROW = 4 + 1
     3779               COLUMN = l-col-pos
     3780               screen-value = Fill("-", l-col-len)
     3781               WIDTH-CHARS = l-col-len
     3782               HEIGHT-CHARS = 4
     3783           .
     3784           CREATE FILL-IN C-for-doc-attr IN WIDGET-POOL "My-pool"
     3785             ASSIGN
     3786               FRAME = FRAME x1:HANDLE
     3787               DATA-TYPE = "CHARACTER"
     3788               FORMAT = "X(":U + string(l-col-len) + ")":U
     3789               PRIVATE-DATA =  l-col-format + chr(4) + l-col-type
     3790               ROW = 1
     3791               COLUMN = l-col-pos
     3792           .
     3793        assign
     3794        l-col-pos =  l-col-pos + l-col-len + 1
     3795        v-r-col-num = v-r-col-num + 1
     3796        .
     3797     end.
     3798   if use-column[1] then
     3799   assign
     3800   sheetf.Excel-Column-Lable =  (if sheetf.Excel-Column-Lable = ""
     3801                                 then (sheetf.Excel-Column-Lable + l-col-lable )
     3802                                 else (sheetf.Excel-Column-Lable + chr(44) + l-col-lable )
     3803                                )
     3804   sheetf.sizes =  (if sheetf.sizes = ""
     3805                    then (sheetf.sizes + string(l-col-len))
     3806                    else (sheetf.sizes + chr(44) + string(l-col-len))
     3807                   )
     3808   last-col-num = 1
     3809   entry(1, sheetf.colformat, chr(4)) = entry(1, sheetf.colformat, chr(4)) +
     3810                                              (if l-col-type = "DATE"
     3811                                               then (
     3812                                                     (if entry(1, sheetf.colformat, chr(4)) <> "":U
     3813                                                      then ";":U
     3814                                                      else "":U) +
     3815                                                      string(v-r-col-num) + "=":U + "dd/mm/yyyy":U
     3816                                                     )
     3817                                               else (if l-col-type = "CHARACTER"
     3818                                                     then ((if entry(1, sheetf.colformat, chr(4)) <> "":U
     3819                                                           then ";":U
     3820                                                           else "":U) + (string(v-r-col-num) + "=":U + "@":U))
     3821                                                     else "":U)
     3822                                               )
     3823   .
     3824   Assign l-col-type="DATE" l-col-len=10 l-col-format= "99/99/99"            l-col-lable="Дата создания".
     3825     define variable ed2 as handle no-undo.
