     6722                                        "rpt" + string( g#report-num ) ) )
     6723                                        page-size 62 .
     6724   end.
     6725   if Make-Excel then
     6726   run openforexcel in this-procedure .
     6727   FORM with FRAME x1 .
     6728   FORM HEADER
     6729   Line format "X(76)" AT 1 SKIP
     6730   "Продолжение на следующей странице" AT 30 SKIP
     6731   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     6732   VIEW stream DocsStream FRAME BottomFrame .
     6733   PUT stream DocsStream SPACE(10) p-title format "X(125)" SKIP(2).
     6734   display STREAM DOcsStream
     6735   with frame top-Frame .
     6736   run rep/extitle.p (1).
     6737   FIND FIRST wt-docs NO-LOCK .
     6738   if can-find( first b-wt-docs where b-wt-docs.doc-type <> wt-docs.doc-type ) then do:
     6739     assign
     6740       DifferentTypes = TRUE
     6741     .
     6742   end.
     6743   run waitfram-show in this-procedure  ( "Печать списка документов " ) .
     6744   assign
     6745     v-ind = 0
     6746   .
     6747   FOR EACH wt-docs with frame x1
     6748   :
     6749     assign
     6750       v-ind = v-ind + 1
     6751     .
     6752     if v-ind modulo 10 = 0
     6753     then do:
     6754       run waitfram-show in this-procedure  ( "Печать списка документов " + string( v-ind ) ) .
     6755     end.
     6756     if wt-docs.status_ <> 'факт':U then do:
     6757       for each doc-line no-lock
     6758         where doc-line.doc-code = wt-docs.doc-code
     6759       :
     6760           accumulate
     6761             doc-line.doc-qnty * doc-line.price-base ( total )
     6762             doc-line.doc-qnty * doc-line.price-rubl ( total )
     6763           .
     6764       end.
     6765     end.
     6766     run calc-line-doc in this-procedure .
     6767     assign
     6768       wt-docs.VAT18-base = NDS18-Val
     6769       wt-docs.VAT10-base = NDS10-Val
     6770       wt-docs.VAT18-rubl = NDS18-Rubl
     6771       wt-docs.VAT10-rubl = NDS10-Rubl
     6772     .
     6773     assign
     6774           Qnty        = ( if can-do( 'факт':U, wt-docs.status_ )
     6775                           then wt-docs.fact-qnty
     6776                           else wt-docs.doc-qnty )
     6777           Qnty-doc    = wt-docs.doc-qnty
     6778           NDS-Val     = wt-docs.VAT-base
     6779           NDS-Rubl    = wt-docs.VAT-rubl
     6780           TorgPred    = wt-docs.Mngr_Name
     6781           Operator    = wt-docs.Oper_Name
     6782           PayType     = wt-docs.pay-name
     6783           Kurs        = wt-docs.Course
     6784           Our-Obj     = wt-docs.OurObjectName
     6785           KladovName  = wt-docs.Wrkr_name
     6786           IspName     = wt-docs.Isp-Name
     6787           PayWaitDate = wt-docs.pay-waitdate
     6788           comm        = wt-docs.ps
     6789           Val-BruttoSaleSum  =  Val-NettoSaleSum  +  Val-DiscntSum
     6790           Rubl-BruttoSaleSum =  Rubl-NettoSaleSum +  Rubl-DiscntSum
     6791   .
     6792           if Qnty = ? then Qnty = 0 .
     6793           if Qnty-doc = ? then Qnty-doc = 0 .
     6794           if Val-BruttoSaleSum = ? then Val-BruttoSaleSum = 0 .
     6795           if Rubl-BruttoSaleSum = ? then Rubl-BruttoSaleSum = 0 .
     6796           if Val-NettoSaleSum = ? then Val-NettoSaleSum = 0 .
     6797           if Rubl-NettoSaleSum = ? then Rubl-NettoSaleSum = 0 .
     6798           if Val-DiscntSum = ? then Val-DiscntSum = 0 .
     6799           if Rubl-DiscntSum = ? then Rubl-DiscntSum = 0 .
     6800           if Val-CostSum = ? then Val-CostSum = 0 .
     6801           if Rubl-CostSum = ? then Rubl-CostSum = 0 .
     6802           if NDS-Val    = ? then NDS-Val    = 0 .
     6803           if NDS18-Val  = ? then NDS18-Val  = 0 .
     6804           if NDS10-Val  = ? then NDS10-Val  = 0 .
     6805           if NDS-Rubl   = ? then NDS-Rubl   = 0 .
     6806           if NDS18-Rubl = ? then NDS18-Rubl = 0 .
     6807           if NDS10-Rubl = ? then NDS10-Rubl = 0 .
     6808           if sale-rubl  = ? then sale-Rubl  = 0 .
     6809           if sale-base  = ? then sale-base  = 0 .
     6810           if sale-rubl-doc  = ? then sale-Rubl-doc  = 0 .
     6811           if sale-base-doc  = ? then sale-base-doc  = 0 .
     6812           if crsa-rubl-doc  = ? then crsa-Rubl-doc  = 0 .
     6813           if crsa-base-doc  = ? then crsa-base-doc  = 0 .
     6814           if DifferentTypes AND can-do( 'рас,спи':U, wt-docs.doc-type ) then do:
     6815               assign
     6816                   Qnty = - Qnty
     6817                   Qnty-doc = - Qnty-doc
     6818                   Val-BruttoSaleSum = - Val-BruttoSaleSum
     6819                   Rubl-BruttoSaleSum = - Rubl-BruttoSaleSum
     6820                   Val-NettoSaleSum = - Val-NettoSaleSum
     6821                   Rubl-NettoSaleSum = - Rubl-NettoSaleSum
     6822                   Val-DiscntSum = - Val-DiscntSum
     6823                   Rubl-DiscntSum = - Rubl-DiscntSum
     6824                   Val-CostSum = - Val-CostSum
     6825                   Rubl-CostSum = - Rubl-CostSum
     6826                   NDS-Val = - NDS-Val
     6827                   NDS18-Val = - NDS18-Val
     6828                   NDS10-Val = - NDS10-Val
     6829                   NDS-Rubl = - NDS-Rubl
     6830                   NDS18-Rubl = - NDS18-Rubl
     6831                   NDS10-Rubl = - NDS10-Rubl
     6832                   sale-rubl  = - sale-rubl
     6833                   sale-base  = - sale-base
     6834                   sale-rubl-doc  = - sale-rubl-doc
     6835                   sale-base-doc  = - sale-base-doc
     6836                   crsa-rubl-doc  = - crsa-rubl-doc
     6837                   crsa-base-doc  = - crsa-base-doc
     6838               .
     6839           end.
     6840           if DifferentTypes then do:
     6841               if NOT wt-docs.internal then
     6842                   CASE wt-docs.doc-type :
     6843                       when 'рас':U OR when 'возврат':U then
     6844                           assign
     6845                               Val-Effect = - ( Val-NettoSaleSum - Val-CostSum )
     6846                               Rubl-Effect = - ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     6847                       when 'спи':U then
     6848                           assign
     6849                               Val-Effect = Val-CostSum
     6850                               Rubl-Effect = Rubl-CostSum .
     6851                       when 'инв':U then
     6852                           if can-do( 'факт':U, wt-docs.status_ ) AND ( wt-docs.tot-doc <> 0 ) then
     6853                               assign
     6854                                   Val-Effect = ( Val-NettoSaleSum - Val-CostSum )
     6855                                   Rubl-Effect = ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     6856                           else
     6857                               assign     Val-Effect = 0    Rubl-Effect = 0 .
     6858                       otherwise
     6859                           assign     Val-Effect = 0    Rubl-Effect = 0 .
     6860                   END CASE .
     6861               else
     6862                   assign      Val-Effect = 0    Rubl-Effect = 0 .
     6863           end.
     6864           else do:
     6865               if NOT wt-docs.internal then
     6866                   CASE wt-docs.doc-type :
     6867                       when 'рас':U then
     6868                           assign
     6869                               Val-Effect = ( Val-NettoSaleSum - Val-CostSum )
     6870                               Rubl-Effect = ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     6871                           when 'спи':U then
     6872                               assign
     6873                                   Val-Effect = - Val-CostSum
     6874                                   Rubl-Effect = - Rubl-CostSum .
     6875                           when 'возврат':U then
     6876                               assign
     6877                                   Val-Effect = - ( Val-NettoSaleSum - Val-CostSum )
     6878                                   Rubl-Effect = - ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     6879                           when 'инв':U then
     6880                               if can-do( 'факт':U, wt-docs.status_ ) AND ( wt-docs.tot-doc <> 0 ) then
     6881                                   assign
     6882                                       Val-Effect = ( Val-NettoSaleSum - Val-CostSum )
     6883                                       Rubl-Effect = ( Rubl-NettoSaleSum - Rubl-CostSum ) .
     6884                               else
     6885                                   assign     Val-Effect = 0    Rubl-Effect = 0 .
     6886                           otherwise
     6887                               assign     Val-Effect = 0    Rubl-Effect = 0 .
     6888                       END CASE .
     6889               else
     6890                   assign      Val-Effect = 0    Rubl-Effect = 0 .
     6891           end.
     6892           if Val-BruttoSaleSum <> 0 then do:
     6893               if ( ( Val-DiscntSum / Val-BruttoSaleSum ) < 100 ) AND
     6894                  ( ( Val-DiscntSum / Val-BruttoSaleSum ) > -100 ) then
     6895                   Discnt-PC =
     6896                       string( Val-DiscntSum / Val-BruttoSaleSum * 100 , "->>>9.9" ) + "%" .
     6897               else
     6898                   if ( Val-DiscntSum / Val-BruttoSaleSum < -99.99 ) then
     6899                       Discnt-PC = string( -9999.9 , "->>>9.9" ) + "%" .
     6900                   else
     6901                       Discnt-PC = string( 9999.9 , "->>>9.9" ) + "%" .
     6902           end.
     6903           else do:
     6904               Discnt-PC = string( 0, "->>>9.9" ) + "%" .
     6905           end.
     6906           if Val-CostSum <> 0 then do:
     6907             if  ( Val-Effect / abs( Val-CostSum ) ) < 100
     6908             AND ( Val-Effect / abs( Val-CostSum ) ) > -100 then do:
     6909               assign
     6910                 Up-PC = string( Val-Effect / abs( Val-CostSum ) * 100 , "->>>9.9" ) + "%"
     6911               .
     6912             end.
     6913             else do:
     6914               if ( Val-Effect / abs( Val-CostSum ) ) < -99.99 then do:
     6915                 assign
     6916                   Up-PC = string( -9999.9 , "->>>9.9" ) + "%"
     6917                 .
     6918               end.
     6919               else do:
     6920                 assign
     6921                   Up-PC = string( 9999.9 , "->>>9.9" ) + "%"
     6922                 .
     6923               end.
     6924             end.
     6925           end.
     6926           else do:
     6927             assign
     6928               Up-PC = string( 0 , "->>>9.9" ) + "%"
     6929             .
     6930           end.
     6931           ACCUMULATE
