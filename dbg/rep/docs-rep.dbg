     2122   assign
     2123     varprice-base-conscur = varprice-base-conscur / varcons-qntycur
     2124     varprice-rubl-conscur = varprice-rubl-conscur / varcons-qntycur.
     2125   if varprice-base-conscur = ? then do:
     2126     assign
