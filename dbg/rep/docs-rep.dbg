     2227   assign
     2228     bf_tt-allsum.sum-dsc-base-acc     = (if price-base-with-tax-loccl    = ? then 0 else price-base-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     2229     bf_tt-allsum.sum-dsc-rubl-acc     = (if price-rubl-with-tax-loccl    = ? then 0 else price-rubl-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     2230     bf_tt-allsum.sum-dsc-cli-acc      = (if (price-cli-with-tax-loccl +
     2231                                              road-tax-cli-loccl       +
     2232                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     2233                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     2234                                              ) / cli-base-ratecl = ? then 0
     2235                                           else
     2236                                             (price-cli-with-tax-loccl +
     2237                                              road-tax-cli-loccl       +
     2238                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     2239                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     2240                                              ) / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     2241     bf_tt-allsum.dsc-base-acc         = 0
     2242     bf_tt-allsum.dsc-rubl-acc         = 0
     2243     bf_tt-allsum.dsc-cli-acc          = 0
     2244     bf_tt-allsum.vat-base-acc         = (if vat-base-loccl      = ? then 0 else vat-base-loccl      * cl_tt-clcparts.fact-qnty)
     2245     bf_tt-allsum.vat-rubl-acc         = (if vat-rubl-loccl      = ? then 0 else vat-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     2246     bf_tt-allsum.vat-cli-acc          = (if vat-cli-loccl / cli-base-ratecl      = ? then 0 else vat-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.fact-qnty)
     2247     bf_tt-allsum.slt-base-acc         = (if slt-base-loccl      = ? then 0 else slt-base-loccl      * cl_tt-clcparts.fact-qnty)
     2248     bf_tt-allsum.slt-rubl-acc         = (if slt-rubl-loccl      = ? then 0 else slt-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     2249     bf_tt-allsum.slt-cli-acc          = (if slt-cli-loccl / cli-base-ratecl      = ? then 0 else slt-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.fact-qnty)
     2250     bf_tt-allsum.road-tax-base-acc    = (if road-tax-base-loccl = ? then 0 else road-tax-base-loccl * cl_tt-clcparts.fact-qnty)
     2251     bf_tt-allsum.road-tax-rubl-acc    = (if road-tax-rubl-loccl = ? then 0 else road-tax-rubl-loccl * cl_tt-clcparts.fact-qnty)
     2252     bf_tt-allsum.road-tax-cli-acc     = (if road-tax-cli-loccl / cli-base-ratecl = ? then 0 else road-tax-cli-loccl / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     2253     bf_tt-allsum.excise-base-acc      = 0
     2254     bf_tt-allsum.excise-rubl-acc      = 0
     2255     bf_tt-allsum.excise-cli-acc       = 0
     2256     bf_tt-allsum.transport-base-acc   = (if transport-base-loccl   = ? then 0 else transport-base-loccl  * cl_tt-clcparts.fact-qnty)
     2257     bf_tt-allsum.transport-rubl-acc   = (if transport-rubl-loccl   = ? then 0 else transport-rubl-loccl  * cl_tt-clcparts.fact-qnty)
     2258     bf_tt-allsum.transport-cli-acc    = (if transport-cli-loccl / cli-base-ratecl   = ? then 0 else transport-cli-loccl / cli-base-ratecl  * cl_tt-clcparts.fact-qnty)
     2259     bf_tt-allsum.other-base-acc       = (if other-base-loccl       = ? then 0 else other-base-loccl      * cl_tt-clcparts.fact-qnty)
     2260     bf_tt-allsum.other-rubl-acc       = (if other-rubl-loccl       = ? then 0 else other-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     2261     bf_tt-allsum.other-cli-acc        = (if other-cli-loccl / cli-base-ratecl       = ? then 0 else other-cli-loccl     / cli-base-ratecl  * cl_tt-clcparts.fact-qnty).
     2262   assign
     2263     bf_tt-allsum.doc-qnty                 =  cl_tt-clcparts.qnty
     2264     bf_tt-allsum.sum-dsc-base-doc-acc     = (if price-base-with-tax-loccl    = ? then 0 else price-base-with-tax-loccl    * cl_tt-clcparts.qnty)
     2265     bf_tt-allsum.sum-dsc-rubl-doc-acc     = (if price-rubl-with-tax-loccl    = ? then 0 else price-rubl-with-tax-loccl    * cl_tt-clcparts.qnty)
     2266     bf_tt-allsum.sum-dsc-cli-doc-acc      = (if (price-cli-with-tax-loccl +
     2267                                              road-tax-cli-loccl       +
     2268                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     2269                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     2270                                              ) / cli-base-ratecl = ? then 0
     2271                                           else
     2272                                             (price-cli-with-tax-loccl +
     2273                                              road-tax-cli-loccl       +
     2274                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     2275                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     2276                                              ) / cli-base-ratecl * cl_tt-clcparts.qnty)
     2277     bf_tt-allsum.dsc-base-doc-acc         = 0
     2278     bf_tt-allsum.dsc-rubl-doc-acc         = 0
     2279     bf_tt-allsum.dsc-cli-doc-acc          = 0
     2280     bf_tt-allsum.vat-base-doc-acc         = (if vat-base-loccl      = ? then 0 else vat-base-loccl      * cl_tt-clcparts.qnty)
     2281     bf_tt-allsum.vat-rubl-doc-acc         = (if vat-rubl-loccl      = ? then 0 else vat-rubl-loccl      * cl_tt-clcparts.qnty)
     2282     bf_tt-allsum.vat-cli-doc-acc          = (if vat-cli-loccl / cli-base-ratecl      = ? then 0 else vat-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.qnty)
     2283     .
     2284   create bfs_tt-allsum.
     2285   assign
     2286     bfs_tt-allsum.sum-type = 'основная_сумма_со_знаком':U.
     2287   if pardoc-type = 'инв':U or
     2288      pardoc-type = 'при':U    or
     2289      pardoc-type = 'возврат':U    then do:
     2290      buffer-copy bf_tt-allsum except bf_tt-allsum.sum-type to bfs_tt-allsum.
     2291   end.
     2292   else do:
     2293     assign
     2294       bfs_tt-allsum.fact-qnty           =  - bf_tt-allsum.fact-qnty
     2295       bfs_tt-allsum.cli-qnty            =  - bf_tt-allsum.cli-qnty
     2296       bfs_tt-allsum.sum-dsc-base-doc    =  - bf_tt-allsum.sum-dsc-base-doc
