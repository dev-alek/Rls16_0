     3155   procedure clcprtsl_calc-ttable :
     3156   define input parameter paris-doc           as   logical                 no-undo.
     3157   define input parameter paris-cur           as   logical                 no-undo.
     3158   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3159   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3160   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3161   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3162   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3163   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3164   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3165   define input parameter parr-b              as   character               no-undo.
     3166   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3167   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3168   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3169   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3170   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3171   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3172   define buffer bf_tt-allsum      for tt-allsum.
     3173   define buffer bf_tt-clcparts    for tt-clcparts.
     3174   define buffer bf_tt-allsum-line for tt-allsum-line.
     3175   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3176   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3177   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3178   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3179   define variable varexcise          like ub.price-list.excise     no-undo.
     3180   do on error undo, return error return-value :
     3181   for each bf_tt-allsum-line
     3182   on error undo, return error return-value
     3183    :
     3184     delete bf_tt-allsum-line.
     3185   end.
     3186   for each bf_tt-allsum
     3187   on error undo, return error return-value
     3188   :
     3189     delete bf_tt-allsum.
     3190   end.
     3191   for each bf_tt-clcparts
     3192   on error undo, return error return-value
     3193   :
     3194   if v-calcbypart then do:
     3195             assign
     3196             parcur-base =   bf_tt-clcparts.part-cur-base
     3197             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3198             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3199             .
     3200   end.
     3201      run clcprtsl_calc-parts in this-procedure (
     3202        input recid(bf_tt-clcparts),
     3203        input paris-doc,
     3204        input paris-cur,
     3205        input parroad-tax,
     3206        input parexcise,
     3207        input parvat-pc,
     3208        input parcons-vat-pc,
     3209        input parslt-pc,
     3210        input parbase-rate,
     3211        input parbase-scale,
     3212        input parr-b,
     3213        input parcur-base,
     3214        input parcur-road-tax,
     3215        input parcur-excise,
     3216        input parcur-vat-pc,
     3217        input parcurcons-vat-pc,
     3218        input parcurslt-pc
     3219        ) no-error.
     3220     if error-status:error then do:
     3221       message
     3222         vss-workfile vss-revision vss-description skip
     3223         vss-include-info15 skip
     3224         "Ошибка при обсчете партии" skip
     3225         "Документ партии " bf_tt-clcparts.out-code skip
     3226         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3227         return-value skip
     3228         error-status:get-message(1) skip
     3229         error-status:get-message(2) skip
     3230         error-status:get-message(3) skip
     3231         view-as alert-box error .
     3232       undo, return error .
     3233     end.
     3234     for each bf_tt-allsum on error undo, return error return-value :
     3235       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3236       if not available bf_tt-allsum-line then do:
     3237         create bf_tt-allsum-line.
