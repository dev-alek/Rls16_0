     2333       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     2334       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     2335       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     2336       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     2337       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     2338       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     2339       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     2340       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     2341       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
