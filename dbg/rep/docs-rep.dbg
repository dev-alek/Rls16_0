     3604   define variable Line                as character no-undo .
     3605   define variable By-Opt              as character no-undo .
     3606   define variable sym1                as character no-undo init ":" .
     3607   define variable sym10               as character no-undo init ":" .
     3608   define variable i                   as integer   no-undo .
     3609   define variable Qnty                as decimal   no-undo .
     3610   define variable Val-BruttoSaleSum   as decimal   no-undo .
     3611   define variable Rubl-BruttoSaleSum  as decimal   no-undo .
     3612   define variable Val-NettoSaleSum    as decimal   no-undo .
     3613   define variable Rubl-NettoSaleSum   as decimal   no-undo .
