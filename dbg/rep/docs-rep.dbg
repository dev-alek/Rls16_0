      504   procedure create_obj-list :
      505      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      506      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      507      do
      508      on error undo, return error return-value
      509      :
      510         define buffer cli-obj for ub.clients .
      511         define variable p-var as integer no-undo .
      512         define buffer buf_obj-list for obj-list .
      513         find last buf_obj-list  use-index pi no-error .
      514         if available buf_obj-list
      515         then
      516            p-var = buf_obj-list.obj-id + 1.
      517         else
      518            p-var = 1.
      519         find first cli-obj where
      520                   cli-obj.obj-type = p-obj-type
      521               and cli-obj.obj-code = p-obj-code
      522         no-lock no-error.
      523         if available cli-obj
      524         then do:
      525            create buf_obj-list.
      526            assign
      527               buf_obj-list.obj-id   = p-var
      528               buf_obj-list.obj-code = cli-obj.obj-code
      529               buf_obj-list.obj-type = cli-obj.obj-type
      530               buf_obj-list.obj-name = cli-obj.obj-name
      531               buf_obj-list.db-num   = cli-obj.db-num
      532            .
      533         end.
      534      end.
      535   end.
