     2353       bfs_tt-allsum.dsc-rubl-doc-acc        =  - bf_tt-allsum.dsc-rubl-doc-acc
     2354       bfs_tt-allsum.dsc-cli-doc-acc         =  - bf_tt-allsum.dsc-cli-doc-acc
     2355       bfs_tt-allsum.vat-base-doc-acc        =  - bf_tt-allsum.vat-base-doc-acc
     2356       bfs_tt-allsum.vat-rubl-doc-acc        =  - bf_tt-allsum.vat-rubl-doc-acc
     2357       bfs_tt-allsum.vat-cli-doc-acc         =  - bf_tt-allsum.vat-cli-doc-acc
     2358       bfs_tt-allsum.sum-dsc-base-doc-cur    =  - bf_tt-allsum.sum-dsc-base-doc-cur
     2359       bfs_tt-allsum.sum-dsc-rubl-doc-cur    =  - bf_tt-allsum.sum-dsc-rubl-doc-cur
     2360       bfs_tt-allsum.sum-dsc-base-doc-doc    =  - bf_tt-allsum.sum-dsc-base-doc-doc
     2361       bfs_tt-allsum.sum-dsc-rubl-doc-doc    =  - bf_tt-allsum.sum-dsc-rubl-doc-doc
     2362       .
     2363   end.
     2364   create bfpc_tt-allsum.
     2365   create bfspc_tt-allsum.
     2366   case cl_tt-clcparts.purch-code :
     2367   when 1           then do:
     2368     assign
     2369       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     2370       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     2371     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2372     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2373   end.
     2374   when 4    then do:
     2375     assign
     2376       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     2377       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     2378     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2379     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2380   end.
     2381   when 3 then do:
     2382     assign
     2383       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     2384       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     2385     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2386     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2387   end.
     2388   when 2 then do:
     2389     assign
     2390       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     2391       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     2392     assign
     2393       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     2394       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     2395       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     2396       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
     2397       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     2398       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
