     2678       bfsacc_tt-allsum.vat-base-doc-acc        = bfs_tt-allsum.vat-base-doc-acc
     2679       bfsacc_tt-allsum.vat-rubl-doc-acc        = bfs_tt-allsum.vat-rubl-doc-acc
     2680       bfsacc_tt-allsum.vat-cli-doc-acc         = bfs_tt-allsum.vat-cli-doc-acc
     2681     .
     2682   end.
     2683   otherwise do:
     2684     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2685                              cl_tt-clcparts.purch-code,
     2686                              cl_tt-clcparts.part-code,
     2687                              cl_tt-clcparts.out-code,
     2688                              cl_tt-clcparts.in-code,
     2689                              cl_tt-clcparts.artic,
     2690                              cl_tt-clcparts.prod-type,
     2691                              cl_tt-clcparts.prod-code).
     2692   end.
     2693   end case.
     2694   end.
     2695   end procedure.
     2696   procedure clcprtsl_calc-line :
     2697   define input  parameter parrec-line as recid no-undo.
     2698   define variable v-tax-date         as   date                     no-undo.
     2699   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2700   define variable varr-b             as   character                no-undo.
     2701   define variable varr-btype         as   character                no-undo.
     2702   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2703   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2704   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2705   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2706   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2707   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2708   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2709   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2710   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2711   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2712   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2713   define variable varexcise          like ub.price-list.excise     no-undo.
     2714   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2715   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2716   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2717   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2718   define variable v-varsum           as decimal                  no-undo.
     2719   define variable varprice-salef as decimal   no-undo .
     2720   define buffer bf_trn-doc             for ub.trn-doc.
     2721   define buffer bf_doc-line            for ub.doc-line.
     2722   define buffer bf_gds-dtl             for ub.gds-dtl.
     2723   define buffer bf_goods               for ub.goods.
     2724   define buffer bf_parts               for ub.parts.
     2725   define buffer bf_sysconf             for ub.sysconf.
     2726   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2727   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2728   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2729   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2730   define buffer buf_parts        for ub.parts.
     2731   v-calcbypart = no.
     2732   do on error undo, return error return-value :
     2733   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2734   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2735     (output varr-b
     2736     )  .
     2737     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2738     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2739     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2740                               bf_goods.prod-type = bf_doc-line.prod-type and
     2741                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2742     if bf_trn-doc.fact-date <> ?        then do:
     2743       assign v-tax-date = bf_trn-doc.fact-date.
     2744     end.
     2745     else do:
     2746       assign v-tax-date = ?.
     2747     end.
     2748   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2749   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2750     (input  bf_goods.gds-code
     2751     ,input  '1':U
     2752     ,input  v-tax-date
     2753     ,input  bf_trn-doc.host-code
     2754     ,input  bf_trn-doc.obj-type
     2755     ,input  bf_trn-doc.obj-code
     2756     ,output v-vat-pc
     2757     ) no-error .
     2758     if error-status :error
     2759     or v-vat-pc = ? then do:
     2760        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2761     end.
     2762     if bf_goods.gds-type = 'у':U or
     2763        bf_trn-doc.status_ = 'запрос':U then do:
     2764       for each bf_tt-allsum-line
     2765       on error undo, return error return-value
     2766        :
     2767         delete bf_tt-allsum-line.
     2768       end.
     2769       create bf_tt-allsum-line.
     2770       assign
     2771        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2772       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2773                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2774                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2775                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2776         assign
     2777           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2778           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2779           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2780           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2781           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2782           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2783           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2784           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2785           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2786           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2787           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2788           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2789           bf_tt-allsum-line.vat-cli-acc          =  ?
     2790           .
     2791           assign
     2792             bf_tt-allsum-line.sum-dsc-base-doc-doc     =  bf_tt-allsum-line.sum-dsc-base-doc-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.doc-qnty
     2793             bf_tt-allsum-line.sum-dsc-rubl-doc-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.doc-qnty
     2794             bf_tt-allsum-line.sum-dsc-base-doc-cur     =  bf_tt-allsum-line.sum-dsc-base-doc-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.doc-qnty
     2795             bf_tt-allsum-line.sum-dsc-rubl-doc-cur     =  bf_tt-allsum-line.sum-dsc-rubl-doc-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.doc-qnty
     2796             bf_tt-allsum-line.sum-dsc-base-doc-acc     =  bf_tt-allsum-line.sum-dsc-base-doc-acc + bf_doc-line.price-base * bf_gds-dtl.doc-qnty
     2797             bf_tt-allsum-line.sum-dsc-rubl-doc-acc     =  bf_tt-allsum-line.sum-dsc-rubl-doc-acc + bf_doc-line.price-rubl * bf_gds-dtl.doc-qnty
     2798             bf_tt-allsum-line.sum-dsc-cli-doc-acc      =  ?
     2799             bf_tt-allsum-line.vat-base-doc-acc         =  bf_tt-allsum-line.vat-base-doc-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.doc-qnty
     2800             bf_tt-allsum-line.vat-rubl-doc-acc         =  bf_tt-allsum-line.vat-rubl-doc-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.doc-qnty
     2801             bf_tt-allsum-line.vat-cli-doc-acc          =  ?
     2802          .
     2803       end.
     2804       assign
     2805         bf_tt-allsum-line.cli-qnty             =  ?
     2806         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2807         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2808         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2809         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2810         bf_tt-allsum-line.road-tax-base-doc    =  0
     2811         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2812         bf_tt-allsum-line.excise-base-doc      =  0
     2813         bf_tt-allsum-line.excise-rubl-doc      =  0
     2814         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2815         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2816         bf_tt-allsum-line.dsc-base-cur         =  0
     2817         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2818         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2819         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2820         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2821         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2822         bf_tt-allsum-line.road-tax-base-cur    =  0
     2823         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2824         bf_tt-allsum-line.excise-base-cur      =  0
     2825         bf_tt-allsum-line.excise-rubl-cur      =  0
     2826         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2827         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2828         bf_tt-allsum-line.dsc-base-acc         =  0
     2829         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2830         bf_tt-allsum-line.dsc-cli-acc          =  0
     2831         bf_tt-allsum-line.slt-base-acc         =  0
     2832         bf_tt-allsum-line.slt-rubl-acc         =  0
     2833         bf_tt-allsum-line.slt-cli-acc          =  0
     2834         bf_tt-allsum-line.road-tax-base-acc    =  0
     2835         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2836         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2837         bf_tt-allsum-line.excise-base-acc      =  0
     2838         bf_tt-allsum-line.excise-rubl-acc      =  0
     2839         bf_tt-allsum-line.excise-cli-acc       =  0
     2840         bf_tt-allsum-line.transport-base-acc   =  0
     2841         bf_tt-allsum-line.transport-rubl-acc   =  0
     2842         bf_tt-allsum-line.transport-cli-acc    =  0
     2843         bf_tt-allsum-line.other-base-acc       =  0
     2844         bf_tt-allsum-line.other-rubl-acc       =  0
     2845         bf_tt-allsum-line.other-cli-acc        =  0
     2846         .
     2847         assign
     2848         bf_tt-allsum-line.dsc-base-doc-acc         =  0
     2849         bf_tt-allsum-line.dsc-rubl-doc-acc         =  0
     2850         bf_tt-allsum-line.dsc-cli-doc-acc          =  0
     2851       .
     2852       create bfs_tt-allsum-line.
     2853       assign
     2854       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2855       if bf_trn-doc.doc-type = 'инв':U or
     2856          bf_trn-doc.doc-type = 'при':U    or
     2857          bf_trn-doc.doc-type = 'возврат':U    then do:
     2858          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2859       end.
     2860       else do:
     2861         assign
     2862           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2863           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2864           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2865           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2866           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2867           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2868           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2869           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2870           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2871           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2872           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2873           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2874           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2875           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2876           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2877           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2878           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2879           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2880           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2881           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2882           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2883           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2884           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2885           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2886           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2887           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2888           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2889           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2890           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2891           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2892           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2893           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2894           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2895           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2896           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2897           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2898           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2899           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2900           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2901           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2902           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2903           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2904           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
