     7878           (if 35 < last-col-num
     7879            then CHR(9)
     7880            else ""))
     7881     else "":U
     7882     if use-column[36]
     7883     then (reg-output(
     7884                       string(ACCUM TOTAL sale-base-doc   , entry(1, c-sale-base-doc:private-data, chr(4)))
     7885                      ,c-sale-base-doc:private-data
     7886                      ,v-reg-replace
     7887                      ,no
     7888                      ,v-dec-sep
     7889                      ,v-th-sep)  +
     7890           (if 36 < last-col-num
     7891            then CHR(9)
     7892            else ""))
     7893     else "":U
     7894     if use-column[37]
     7895     then (reg-output(
     7896                       string(ACCUM TOTAL sale-rubl-doc   , entry(1, c-sale-rubl-doc:private-data, chr(4)))
     7897                      ,c-sale-rubl-doc:private-data
     7898                      ,v-reg-replace
     7899                      ,no
     7900                      ,v-dec-sep
     7901                      ,v-th-sep)  +
     7902           (if 37 < last-col-num
     7903            then CHR(9)
     7904            else ""))
     7905     else "":U
     7906     if use-column[38]
     7907     then (reg-output(
     7908                       string(ACCUM TOTAL crsa-base-doc   , entry(1, c-crsa-base-doc:private-data, chr(4)))
     7909                      ,c-crsa-base-doc:private-data
     7910                      ,v-reg-replace
     7911                      ,no
     7912                      ,v-dec-sep
     7913                      ,v-th-sep)  +
     7914           (if 38 < last-col-num
     7915            then CHR(9)
     7916            else ""))
     7917     else "":U
     7918     if use-column[39]
     7919     then (reg-output(
     7920                       string(ACCUM TOTAL crsa-rubl-doc   , entry(1, c-crsa-rubl-doc:private-data, chr(4)))
     7921                      ,c-crsa-rubl-doc:private-data
     7922                      ,v-reg-replace
     7923                      ,no
     7924                      ,v-dec-sep
     7925                      ,v-th-sep)  +
     7926           (if 39 < last-col-num
     7927            then CHR(9)
     7928            else ""))
     7929     else "":U
     7930     .
     7931   HIDE stream DocsStream FRAME BottomFrame .
     7932   HIDE stream DocsStream FRAME x1 .
     7933   HIDE stream DocsStream FRAME top-frame .
     7934   delete widget-pool "My-pool".
     7935   output stream DocsStream CLOSE.
     7936   if Make-Excel then output stream ForExcel close.
     7937   run waitfram-hide in this-procedure .
     7938   define variable v-user-action as character no-undo .
     7939   define variable v-printed as logical   no-undo .
     7940   define variable DisabledOptions as integer   no-undo .
     7941   DisabledOptions = 8 .
     7942   if l-col-pos >= 195 then DisabledOptions = 20.
     7943   run gbl/prnfilen.w
     7944     (input  ""
     7945     ,input  DisabledOptions
     7946     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     7947     ,input  7
     7948     ,output v-user-action
     7949     ,output v-printed
     7950     ) .
     7951   procedure calc-line-doc :
     7952    define buffer buf_parts     for parts.
     7953    do
     7954    for buf_parts
     7955    on error undo, return error return-value
     7956    :
     7957    assign
     7958       Val-BruttoSaleSum  = 0
     7959       Rubl-BruttoSaleSum = 0
     7960       Val-NettoSaleSum   = 0
     7961       Rubl-NettoSaleSum  = 0
     7962       Val-DiscntSum      = 0
     7963       Rubl-DiscntSum     = 0
     7964       Val-CostSum        = 0
     7965       Rubl-CostSum       = 0
     7966       NDS18-Val          = 0
     7967       NDS10-Val          = 0
     7968       NDS18-Rubl         = 0
     7969       NDS10-Rubl         = 0
     7970       sale-rubl          = 0
     7971       sale-base          = 0
     7972       sale-rubl-doc      = 0
     7973       sale-base-doc      = 0
     7974       crsa-rubl-doc      = 0
     7975       crsa-base-doc      = 0
     7976    .
     7977    for each doc-line no-lock
     7978       where doc-line.doc-code = wt-docs.doc-code
     7979    :
     7980       run clcprtsl_calc-line in this-procedure (
     7981           input recid( doc-line )
     7982       ).
     7983       find first tt-allsum-line
     7984            where tt-allsum-line.sum-type = 'основная_сумма':U
     7985       no-error.
     7986       if not available tt-allsum-line
     7987       then do:
     7988       end.
     7989       else do:
     7990           if ( wt-docs.doc-type = 'при':U  and wt-docs.internal = false ) or
     7991              ( wt-docs.ext-doc-type = 'ep':U  )
     7992               then do:
     7993                   assign
     7994                       Val-NettoSaleSum   = Val-NettoSaleSum   +  tt-allsum-line.sum-dsc-base-cur
     7995                       Rubl-NettoSaleSum  = Rubl-NettoSaleSum  +  tt-allsum-line.sum-dsc-rubl-cur
     7996                       Val-DiscntSum      = Val-DiscntSum      +  tt-allsum-line.dsc-base-cur
     7997                       Rubl-DiscntSum     = Rubl-DiscntSum     +  tt-allsum-line.dsc-rubl-cur
     7998                       crsa-base-doc      = crsa-base-doc      +  tt-allsum-line.sum-dsc-base-doc-cur
     7999                       crsa-rubl-doc      = crsa-rubl-doc      +  tt-allsum-line.sum-dsc-rubl-doc-cur
     8000                   .
     8001               end.
     8002               else do:
     8003                   assign
     8004                       Val-NettoSaleSum   = Val-NettoSaleSum   +  tt-allsum-line.sum-dsc-base-doc
     8005                       Rubl-NettoSaleSum  = Rubl-NettoSaleSum  +  tt-allsum-line.sum-dsc-rubl-doc
     8006                       Val-DiscntSum      = Val-DiscntSum      +  tt-allsum-line.dsc-base-doc
     8007                       Rubl-DiscntSum     = Rubl-DiscntSum     +  tt-allsum-line.dsc-rubl-doc
     8008                       crsa-base-doc      = crsa-base-doc      +  tt-allsum-line.sum-dsc-base-doc-doc
     8009                       crsa-rubl-doc      = crsa-rubl-doc      +  tt-allsum-line.sum-dsc-rubl-doc-doc
     8010                   .
     8011               end.
     8012           assign
     8013               Val-CostSum   = Val-CostSum        +  tt-allsum-line.sum-dsc-base-acc
     8014               Rubl-CostSum  = Rubl-CostSum       +  tt-allsum-line.sum-dsc-rubl-acc
     8015               sale-base     = sale-base          +  tt-allsum-line.sum-dsc-base-doc
     8016               sale-rubl     = sale-rubl          +  tt-allsum-line.sum-dsc-rubl-doc
     8017               sale-base-doc = sale-base-doc      +  tt-allsum-line.sum-dsc-base-doc-acc
     8018               sale-rubl-doc = sale-rubl-doc      +  tt-allsum-line.sum-dsc-rubl-doc-acc
     8019           .
     8020       end.
     8021       if p-detal-NDS-Val  = yes
     8022       or p-detal-NDS-Rubl = yes
     8023       then do:
     8024           for each buf_parts no-lock
     8025              where buf_parts.out-code   = wt-docs.doc-code
     8026                and buf_parts.obj-type   = doc-line.obj-type
     8027                and buf_parts.obj-code   = doc-line.obj-code
     8028                and buf_parts.prod-type  = doc-line.prod-type
     8029                and buf_parts.prod-code  = doc-line.prod-code
     8030                and buf_parts.artic      = doc-line.artic
     8031           on error undo, return error return-value
     8032           :
     8033               if round( buf_parts.VAT-pc, 0 ) = 18
     8034               then do:
     8035   assign
     8036     price-rubl-with-tax-loc = buf_parts.price-rubl
     8037     price-base-with-tax-loc = buf_parts.price-base
     8038   .
     8039   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8041     (output varinvprb
     8042     )  .
     8043     if buf_parts.out-code = 'free-zone':U     or
     8044        buf_parts.out-code = 'out-zone':U   or
     8045        buf_parts.doc-type = 'акт':U then do:
     8046       assign
     8047         in-vatp-have-vat-slt = yes.
     8048     end.
     8049     else do:
     8050       find first in-vatp_doc-attr no-lock
     8051         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     8052           and in-vatp_doc-attr.attr-code = 'envd':U
     8053         no-error .
     8054       if not available in-vatp_doc-attr then do:
     8055         assign
     8056           in-vatp-have-vat-slt = yes.
     8057       end.
     8058       else do:
     8059            in-vatp-have-vat-slt = no.
     8060       end.
     8061     end.
     8062     assign
     8063      price-cli-with-tax-loc = buf_parts.price-cli
     8064      cli-base-rate          = buf_parts.cli-base-rate.
     8065     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     8066              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     8067     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     8068             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     8069             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     8070             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     8071             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     8072             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     8073             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8074       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8075     assign
     8076       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     8077     assign
     8078       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     8079       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     8080       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     8081       transport-cli-loc  = 0
     8082       other-cli-loc      = 0
     8083     .
     8084   ASSIGN
     8085             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     8086       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     8087   .
     8088                   assign
     8089                       NDS18-Val          = NDS18-Val          + ( vat-base-loc * buf_parts.fact-qnty )
     8090                       NDS18-Rubl         = NDS18-Rubl         + ( vat-rubl-loc * buf_parts.fact-qnty )
     8091                   .
     8092               end.
     8093               if round( buf_parts.VAT-pc, 0 ) = 10
     8094               then do:
     8095   assign
     8096     price-rubl-with-tax-loc = buf_parts.price-rubl
     8097     price-base-with-tax-loc = buf_parts.price-base
     8098   .
     8099   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8101     (output varinvprb
     8102     )  .
     8103     if buf_parts.out-code = 'free-zone':U     or
     8104        buf_parts.out-code = 'out-zone':U   or
     8105        buf_parts.doc-type = 'акт':U then do:
     8106       assign
     8107         in-vatp-have-vat-slt = yes.
     8108     end.
     8109     else do:
     8110       find first in-vatp_doc-attr no-lock
     8111         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     8112           and in-vatp_doc-attr.attr-code = 'envd':U
     8113         no-error .
     8114       if not available in-vatp_doc-attr then do:
     8115         assign
     8116           in-vatp-have-vat-slt = yes.
     8117       end.
     8118       else do:
     8119            in-vatp-have-vat-slt = no.
     8120       end.
     8121     end.
     8122     assign
     8123      price-cli-with-tax-loc = buf_parts.price-cli
     8124      cli-base-rate          = buf_parts.cli-base-rate.
     8125     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     8126              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     8127     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     8128             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     8129             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     8130             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     8131             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     8132             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     8133             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8134       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8135     assign
     8136       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     8137     assign
     8138       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     8139       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     8140       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     8141       transport-cli-loc  = 0
     8142       other-cli-loc      = 0
     8143     .
     8144   ASSIGN
     8145             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     8146       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     8147   .
     8148                   assign
     8149                       NDS10-Val          = NDS10-Val          + ( vat-base-loc * buf_parts.fact-qnty )
     8150                       NDS10-Rubl         = NDS10-Rubl         + ( vat-rubl-loc * buf_parts.fact-qnty )
     8151                   .
     8152               end.
     8153           end.
     8154       end.
     8155   end.
     8156    end.
     8157   end procedure.
