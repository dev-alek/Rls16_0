      647   function diff-list returns character (
      648     input parfirst-list  as character,
      649     input parsecond-list as character,
      650     input pardelim       as character).
      651     if pardelim = ""
      652     or pardelim = ?
      653     then do:
      654       assign
      655         pardelim = ","
      656       .
      657     end.
      658     def var ind as integer no-undo .
      659     def var v-elem as character no-undo .
      660     def var v-result-list as character no-undo init "".
      661     def var v-num-parfirst-list as integer no-undo .
      662     assign
      663       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      664     .
      665     do ind = 1 to v-num-parfirst-list
      666     :
      667       assign
      668         v-elem = entry(ind, parfirst-list, pardelim)
      669       .
      670       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      671         assign
      672           v-result-list = v-result-list
      673                         + (if v-result-list > "" then pardelim else "")
      674                         + v-elem
      675         .
      676       end.
      677     end.
      678     return v-result-list .
      679   end function.
      680   function add-list returns character (
      681    input parfirst-list  as character,
      682    input parsecond-list as character,
      683    input pardelim       as character).
      684     if pardelim = ""
      685     or pardelim = ?
      686     then do:
      687       assign
      688         pardelim = ","
      689       .
      690     end.
      691     def var ind as integer no-undo .
      692     def var v-elem as character no-undo .
      693     def var v-result-list as character no-undo init "".
      694     def var v-num-parfirst-list as integer no-undo .
      695     assign
      696       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      697     .
      698     do ind = 1 to v-num-parfirst-list
      699     :
      700       assign
      701         v-elem = entry(ind, parfirst-list, pardelim)
      702       .
      703       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      704         assign
      705           v-result-list = v-result-list
      706                         + (if v-result-list > "" then pardelim else "")
      707                         + v-elem
      708         .
      709       end.
      710     end.
      711     def var v-num-parsecond-list as integer no-undo .
      712     assign
      713       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      714     .
      715     do ind = 1 to v-num-parsecond-list
      716     :
      717       assign
      718         v-elem = entry(ind, parsecond-list, pardelim)
      719       .
      720       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      721         assign
      722           v-result-list = v-result-list
      723                         + (if v-result-list > "" then pardelim else "")
      724                         + v-elem
      725         .
      726       end.
      727     end.
      728     return v-result-list .
      729   end function.
      730   function cross-list returns character (
      731    input parfirst-list  as character,
      732    input parsecond-list as character,
      733    input pardelim       as character).
      734     if pardelim = ""
      735     or pardelim = ?
      736     then do:
      737       assign
      738         pardelim = ","
      739       .
      740     end.
      741     def var ind as integer no-undo .
      742     def var v-elem as character no-undo .
      743     def var v-result-list as character no-undo init "".
      744     def var v-num-parfirst-list as integer no-undo .
      745     assign
      746       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      747     .
      748     do ind = 1 to v-num-parfirst-list
      749     :
      750       assign
      751         v-elem = entry(ind, parfirst-list, pardelim)
      752       .
      753       if lookup(v-elem, v-result-list, pardelim) = 0
      754       and lookup(v-elem, parsecond-list, pardelim) > 0
      755       then do:
      756         assign
      757           v-result-list = v-result-list
      758                         + (if v-result-list > "" then pardelim else "")
      759                         + v-elem
      760         .
      761       end.
      762     end.
      763     return v-result-list .
      764   end function.
      765   function radio-label returns character (
      766    input par-rs-value  as character,
      767    input par-rs-radio-buttons as character)
      768    .
      769    DEFINE variable v-result-label as character no-undo.
      770    assign
      771    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      772                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      773                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      774                             ), par-rs-radio-buttons
      775                           )
      776    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      777    .
      778   return v-result-label.
      779   end function.
      780   function m-radio-label returns character (
      781    input par-rs-value  as character,
      782    input par-rs-radio-buttons as character,
      783    input par-delim as character
      784    )
      785    .
      786    DEFINE variable v-result-label as character no-undo.
      787    assign
      788    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      789                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      790                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      791                             ), par-rs-radio-buttons, par-delim
      792                           )
      793    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      794    .
      795   return v-result-label.
      796   end function.
      797   FUNCTION mixlist returns character
      798   (
      799    input parfirst-list  as character
      800    ,input parsecond-list as character
      801    ,input pardelim       as character
      802    ,input pardelim-result as character ) :
      803     if pardelim = ""
      804     or pardelim = ?
      805     then do:
      806       assign
      807         pardelim = ","
      808       .
      809     end.
      810     def var ind as integer no-undo .
      811     def var v-elem1 as character no-undo .
      812     def var v-elem2 as character no-undo .
      813     def var v-result-list as character no-undo init "".
      814     do ind = 1 to num-entries(parfirst-list, pardelim)
      815     :
      816       assign
      817         v-elem1 = entry(ind, parfirst-list, pardelim)
      818         v-elem2 = entry(ind, parsecond-list, pardelim)
      819       .
      820         assign
      821           v-result-list = v-result-list
      822                         + (if v-result-list > "" then pardelim-result else "")
      823                         + v-elem1 + pardelim-result + v-elem2
      824         .
      825     end.
      826     return v-result-list .
      827   END FUNCTION.
