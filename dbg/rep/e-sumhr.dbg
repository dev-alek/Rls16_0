      848   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      849   define variable v-waitfram-action01         as character   no-undo .
      850   define variable v-waitfram-action02         as character   no-undo .
      851   define variable v-waitfram-action03         as character   no-undo .
      852   define variable mWaitFramTextBeg            as character   no-undo.
      853   define variable mWaitFramTextEnd            as character   no-undo.
      854   define variable mWaitFramView               as logical     no-undo.
      855   define variable mWaitProcEvent              as logical     no-undo init yes.
      856   define variable mWaitFramInterval           as integer     no-undo init 1 .
      857   define variable mWaitFramStop               as logical     no-undo.
      858   define variable mWaitFramStopUser           as logical     no-undo.
      859   define variable mWaitFramStopTimeOut        as logical     no-undo.
      860   define variable mWaitFramStartProc          as datetime-tz no-undo.
      861   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      862   define button B-WaitFramStop auto-end-key
      863        label "Стоп"
      864        size 10 by 1 tooltip "Остоновить процесс".
      865   define button B-viewProcInfo
      866        label "Информация"
      867        size 15 by 1 tooltip "Информация о процесс".
      868   define frame waitfram
      869     v-waitfram-action01 format "x(72)" no-label skip
      870     v-waitfram-action02 format "x(72)" no-label skip
      871     v-waitfram-action03 format "x(72)" no-label skip
      872     B-viewProcInfo
      873     B-WaitFramStop at row 4 col 30
      874     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      875     .
      876   define new global shared variable mBatchMode as logical no-undo init ?.
      877   define variable mFramBachModHandle as handle no-undo.
      878   mFramBachModHandle = frame waitfram:handle.
      879   define variable mFameOldVis as logical no-undo.
      880   define variable mVisCUrentVin as logical no-undo.
      881   if session:batch-mode
      882   then
      883      mBatchMode = yes.
      884   if mBatchMode = ? then do:
      885     mVisCUrentVin = current-window:visible.
      886     mFameOldVis = mFramBachModHandle:visible.
      887     mFramBachModHandle:visible  = yes.
      888     mBatchMode = mFramBachModHandle:visible ne yes.
      889     mFramBachModHandle:visible = mFameOldVis.
      890     current-window:visible = mVisCUrentVin.
      891   end.
      892    if  log-manager:logfile-name ne ?
      893     then DO:
      894         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      895         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      896         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      897     end.
      898   on choose of B-WaitFramStop in frame waitfram
      899   do:
      900     mWaitFramStop = yes.
      901     mWaitFramStopUser = yes.
      902   end.
      903   function waitfram-check-timeout returns logical():
      904      define variable vtime as int64 no-undo.
      905      if mWaitFramStopTimeOut
      906      then
      907         return yes.
      908      vtime = ( now - mWaitFramStartProc ) / 1000 .
      909      if     mWaitFramTimeOut ne ?
      910         and mWaitFramTimeOut ne 0
      911         and mWaitFramTimeOut lt vtime
      912      then do:
      913         mWaitFramStopTimeOut = yes.
      914      end.
      915      return mWaitFramStopTimeOut.
      916   end.
      917   procedure waitfram-hide :
      918     if not session:batch-mode
      919     then do
      920     on error undo, return error return-value
      921     :
      922       pause 0 before-hide .
      923       if not mBatchMode then
      924         hide frame waitfram .
      925     if     not mWaitFramView
      926        and mWaitProcEvent
      927     then
      928       process events .
      929     end.
      930   end procedure.
      931   procedure waitfram-show :
      932     define input  parameter p-message as character no-undo .
      933     define variable v-left-margin as integer   no-undo .
      934     if not session:batch-mode
      935     then do
      936     on error undo, return error return-value
      937     :
      938       if length(p-message) <= 70 then do:
      939         assign
      940           v-left-margin = integer((70 - length(p-message)) / 2)
      941         .
      942         assign
      943           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      944         .
      945         assign
      946           v-waitfram-action01 = " "
      947           v-waitfram-action02 = " "
      948                                    + fill(" ", v-left-margin)
      949                                    + p-message
      950           v-waitfram-action03 = " "
      951         .
      952       end.
      953       else do:
      954         define variable vRindex1 as integer no-undo.
      955         define variable vRindex2 as integer no-undo.
      956         vRindex1 = r-index(p-message," ",70).
      957         if vRindex1 = 0
      958         then
      959            vRindex1 = 70.
      960         if length(p-message)  <= vRindex1 + 70 then do:
      961           assign
      962             v-waitfram-action01 = " "
      963             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      964             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      965           .
      966         end.
      967         else do:
      968           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      969           if vRindex2 <= vRindex1
      970           then
      971              vRindex2 = vRindex1 + 70.
      972           assign
      973             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      974             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      975             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      976           .
      977         end.
      978       end.
      979       B-viewProcInfo:visible   in frame waitfram = no.
      980       B-viewProcInfo:sensitive in frame waitfram = no.
      981       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      982       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      983       if  (   mWaitFramView
      984          or  mWaitProcEvent)
      985          and not mBatchMode
      986       then
      987          display
      988             v-waitfram-action01 skip
      989             v-waitfram-action02 skip
      990             v-waitfram-action03 skip
      991          with frame waitfram .
      992       if     mWaitFramView
      993          then do:
      994             if     mWaitFramInterval ne ?
      995                and not mBatchMode
      996             then
      997                wait-for go of frame waitfram pause mWaitFramInterval.
      998          end.
      999          else
     1000             if     mWaitProcEvent
     1001                and not mBatchMode
     1002             then
     1003                process events .
     1004     end.
     1005   end procedure.
     1006      procedure waitfram-show-this:
     1007         define input  parameter iInterval as int64 no-undo.
     1008         define variable vtime as int64 no-undo.
     1009         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1010         mWaitFramInterval = iInterval.
     1011         run waitfram-show (substitute("&1&2 &3&4" ,
     1012                                       mWaitFramTextBeg ,
     1013                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1014                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1015                                       mWaitFramTextEnd
     1016                                      )
     1017                           ).
     1018      end.
     1019      procedure WaitFramRunPause:
     1020         define input  parameter iInterval as dec no-undo.
     1021         define variable vStart  as datetime-tz no-undo.
     1022         define variable vend    as datetime-tz no-undo.
     1023         define variable vint as int64 no-undo.
     1024         define variable vOk as logical no-undo.
     1025         vStart = now.
     1026         vend   = vStart.
     1027         publish "WaitFramPause" (iInterval,output vOk).
     1028         vend   =  now.
     1029         vint = vend - vStart.
     1030         vint = iInterval - vint / 1000.
     1031         if     not mWaitFramStop
     1032            and (   vint > 0
     1033                 or (    not vOk
     1034                     and iInterval eq ?
     1035                     )
     1036                 )
     1037         then
     1038            run waitfram-show-this (iInterval).
     1039         vend   =  now.
     1040         vint = vend - vStart.
     1041         vint = iInterval - vint / 1000.
     1042         if     not mWaitFramStop
     1043            and vint > 0
     1044         then do:
     1045            run gbl/pause.p (vint * 1000).
     1046         end.
     1047         if iInterval ne ?
     1048         then
     1049            publish "WaitFramStop".
     1050         waitfram-check-timeout().
     1051      end.
     1052      procedure WaitFramWaitFor:
     1053         define input  parameter iInterval as dec no-undo.
     1054         assign
     1055            mWaitFramStartProc   = now
     1056            mWaitFramStopUser    = no
     1057            mWaitFramStopTimeOut = no
     1058         .
     1059         block-wait:
     1060         do while not mWaitFramStop:
     1061            run WaitFramRunPause (iInterval).
     1062            if  waitfram-check-timeout()
     1063            then do:
     1064               leave block-wait.
     1065            end.
     1066         end.
     1067         run waitfram-hide.
     1068      end.
     1069   procedure waitfram-join :
     1070     define input  parameter p-line-1  as character no-undo .
     1071     define input  parameter p-line-2  as character no-undo .
     1072     define input  parameter p-line-3  as character no-undo .
     1073     define output parameter p-message as character no-undo .
     1074     do
     1075     on error undo, return error return-value
     1076     :
     1077       assign
     1078         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1079                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1080                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1081       .
     1082     end.
     1083   end procedure.
     1084   function waitfram-join-function returns character
     1085     (input p-line-1 as character
     1086     ,input p-line-2 as character
     1087     ,input p-line-3 as character
     1088     ).
     1089     define variable v-message as character no-undo .
     1090     run waitfram-join in this-procedure
     1091       (input  p-line-1
     1092       ,input  p-line-2
     1093       ,input  p-line-3
     1094       ,output v-message
     1095       ) .
     1096     return v-message .
     1097   end function .
     1098   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1099   define  stream PrnLibStream.
     1100   procedure prn-lib-prn-file :
     1101     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1102     define input parameter p-DIsabledoptions as integer no-undo .
     1103     define variable v-report-name as character no-undo .
     1104     define variable v-user-action as character no-undo .
     1105     define variable v-printed     as logical   no-undo .
     1106     define variable v-exist       as logical   no-undo .
     1107     do
     1108       on error undo, return error
     1109       :
     1110       run prn-lib-get-report-name  in this-procedure (
     1111         input parParentProc
     1112         ,output v-report-name
     1113         ).
     1114   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1116     (input  v-report-name
     1117     ,input  2
     1118     ,output v-exist
     1119     )  .
     1120       if NOT v-exist then
     1121       DO:
     1122         Message
     1123           "Нет заданий на печать ! "
     1124           view-as alert-box .
     1125         Return  .
     1126       End.
     1127       run gbl/prnfilen.w
     1128         (input  ""
     1129         ,input  p-DisabledOptions
     1130         ,input  string(v-report-name )
     1131         ,input  7
     1132         ,output v-user-action
     1133         ,output v-printed
     1134         ) .
     1135       if v-printed then
     1136       do:
     1137         return "YES" .
     1138       end.
     1139       else
     1140       do:
     1141         return "NO" .
     1142       end.
     1143     end.
     1144   end procedure.
     1145   procedure prn-lib-open-stream :
     1146     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1147     define input parameter p-page-size    as integer no-undo .
     1148     define input parameter p-is-stream    as logical no-undo .
     1149     define input parameter p-append       as logical no-undo .
     1150     define variable v-report-name as character no-undo .
     1151     do
     1152       on error undo, return error
     1153       :
     1154       run prn-lib-get-report-name  in this-procedure (
     1155         input parParentProc
     1156         ,output v-report-name
     1157         ).
     1158       if p-is-stream then
     1159       do:
     1160         if p-append then
     1161         do:
     1162           output stream PrnLibStream to value( v-report-name )
     1163             page-size value(p-page-size) append .
     1164         end.
     1165         if not p-append then
     1166         do:
     1167           output stream PrnLibStream to value( v-report-name )
     1168             page-size value(p-page-size) .
     1169         end.
     1170       end.
     1171       if not p-is-stream then
     1172       do:
     1173         if p-append then
     1174         do:
     1175           output to value( v-report-name )
     1176             page-size value(p-page-size) append .
     1177         end.
     1178         if not p-append then
     1179         do:
     1180           output to value( v-report-name )
     1181             page-size value(p-page-size) .
     1182         end.
     1183       end.
     1184     end.
     1185   end procedure.
     1186   procedure prn-lib-open-exp :
     1187     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1188     define input parameter p-is-stream    as logical no-undo .
     1189     define input parameter p-is-append    as logical no-undo .
     1190     define output parameter p-ReportFileName as char init "report" no-undo.
     1191     define output parameter p-process as logical no-undo .
     1192     define variable glog as logical no-undo .
     1193     do
     1194       on error undo, return error
     1195       :
     1196       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1197         TITLE      "Укажите путь"
     1198         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1199         ASK-OVERWRITE
     1200         CREATE-TEST-FILE
     1201         SAVE-AS
     1202         USE-FILENAME
     1203         DEFAULT-EXTENSION "txt"
     1204         UPDATE glog
     1205         .
     1206       if not glog then  return.
     1207       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1208       if p-is-stream then
     1209       do:
     1210         if p-is-append then
     1211         do:
     1212           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1213         end.
     1214         else
     1215         do:
     1216           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1217         end.
     1218       end.
     1219       else
     1220       do:
     1221         if p-is-append then
     1222         do:
     1223           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1224         end.
     1225         else
     1226         do:
     1227           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1228         end.
     1229       end.
     1230       p-process = yes.
     1231     end.
     1232   end procedure.
     1233   procedure prn-lib-get-report-name :
     1234     define input parameter parParentProc  as widget-handle no-undo.
     1235     define output parameter p-report-name as character no-undo .
     1236     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1237   end procedure.
     1238   procedure prn-lib-reportviewer-report-name :
     1239     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1240     define input parameter p-report-name-html as character no-undo .
     1241     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1242   end procedure.
     1243   procedure prn-lib-reportviewer :
     1244     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1245     define input parameter p-report-name-html as character no-undo .
     1246     define input parameter p-param        as character no-undo .
     1247     define variable v-excel           as character no-undo init 'TRUE' .
     1248     define variable v-value-character as character no-undo .
     1249     define variable v-value-integer   as character no-undo .
     1250     define variable v-value-date      as date      no-undo .
     1251     define variable v-value-decimal   as decimal   no-undo .
     1252     define variable rep-excel         as logical   no-undo .
     1253     define variable excel-string      as character no-undo .
     1254     define variable v-param-type      as character no-undo .
     1255     define variable v-tth             as handle    no-undo .
     1256     run adm/shattri.p (
     1257       input "get":U
     1258       ,input  ""
     1259       ,input  0
     1260       ,input  'report-glob':U
     1261       ,input  'rep-excel':U
     1262       ,output v-value-character
     1263       ,output v-value-date
     1264       ,output v-value-decimal
     1265       ,output v-value-integer
     1266       ,output rep-excel
     1267       ,output v-param-type
     1268       ,INPUT-OUTPUT table-handle v-tth
     1269       )  .
     1270     if rep-excel then v-excel = "TRUE" .
     1271     else v-excel = "FALSE" .
     1272     if p-param eq ""
     1273     then
     1274        p-param = "EXCEL:" + v-excel.
     1275     else
     1276        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1277     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1278   end procedure.
     1279   define variable parparentproc as widget-handle no-undo .
     1280   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1281     define variable v-cntxt-db-num        as integer   no-undo .
     1282     define variable v-cntxt-userid        as character no-undo .
     1283     define variable v-cntxt-level         as character no-undo .
     1284     define variable v-cntxt-host-code-obj as integer   no-undo .
     1285     define variable v-cntxt-obj-type      as character no-undo .
     1286     define variable v-cntxt-obj-code      as integer   no-undo .
     1287     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1288     define variable v-cntxt-is-admin      as logical   no-undo .
     1289   def buffer cli-obj for ub.clients .
     1290   def variable ii as integer.
     1291   DEFINE VARIABLE h_s-hour AS HANDLE NO-UNDO.
     1292   DEFINE VARIABLE RS-dis-card AS INTEGER
     1293        VIEW-AS RADIO-SET VERTICAL
     1294        RADIO-BUTTONS
     1295             "Все типы карт", 0,
     1296   "Выборочно", 1
     1297        SIZE 19 BY 2.13 NO-UNDO.
     1298   DEFINE VARIABLE RS-OPTION AS CHARACTER
     1299        VIEW-AS RADIO-SET VERTICAL
     1300        RADIO-BUTTONS
     1301             "Только итоги", "TOTALS":U,
     1302   "По группам", "GROUPS":U,
     1303   "Потоварно", "GOODS":U,
     1304   "По оплатам", "PAYS":U,
     1305   "По кассам", "pay-desk":U
     1306        SIZE 25.63 BY 3.63 NO-UNDO.
     1307   DEFINE VARIABLE t-byobject AS LOGICAL INITIAL no
     1308        LABEL "С разбивкой по объектам"
     1309        VIEW-AS TOGGLE-BOX
     1310        SIZE 25.5 BY 1 NO-UNDO.
     1311   DEFINE VARIABLE T-dis-card AS LOGICAL INITIAL no
     1312        LABEL "Только покупки по картам"
     1313        VIEW-AS TOGGLE-BOX
     1314        SIZE 26.63 BY 1 NO-UNDO.
     1315   DEFINE VARIABLE Tree AS LOGICAL INITIAL no
     1316        LABEL "Названия групп полностью"
     1317        VIEW-AS TOGGLE-BOX
     1318        SIZE 42.5 BY 1 NO-UNDO.
     1319   DEFINE QUERY BR-dis-card-type FOR
     1320         temp-dis-card-type SCROLLING.
     1321   DEFINE BROWSE BR-dis-card-type
     1322     QUERY BR-dis-card-type DISPLAY
     1323         temp-dis-card-type.type COLUMN-LABEL "Тип" FORMAT "X(8)":U
     1324         temp-dis-card-type.emitent-host-code COLUMN-LABEL "Код эмитента" FORMAT "99999":U
     1325       WITH NO-ROW-MARKERS SEPARATORS SIZE 23.63 BY 8.04
     1326            TITLE "Выбранные типы карт".
     1327   DEFINE FRAME F-Main
     1328        T-dis-card AT ROW 1.25 COL 49
     1329        RS-dis-card AT ROW 2.92 COL 49.13 NO-LABEL
     1330        BR-dis-card-type AT ROW 5.67 COL 48.38
     1331        Tree AT ROW 12.46 COL 1.88
     1332        RS-OPTION AT ROW 13.54 COL 2 NO-LABEL
     1333        t-byobject AT ROW 16 COL 31
     1334       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1335            SIDE-LABELS NO-UNDERLINE THREE-D
     1336            AT COL 1 ROW 1
     1337            SIZE 77.38 BY 16.21.
     1338   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1339   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1340   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1341   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1342   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1343   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1344   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1345   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1346       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1347   RUN ensure-broker.
     1348   THIS-PROCEDURE:ADM-DATA =
     1349        'ADM1.1~`':U +
     1350        'SmartObject~`':U +
     1351        'FRAME~`':U +
     1352        'NO ~`':U +
     1353        '~`':U +
     1354        'temp-dis-card-type~`':U +
     1355        '~`':U +
     1356        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1357           + "~`":U +
     1358        'Layout,Hide-on-Init~`':U +
     1359        '~`':U +
     1360        '~`':U +
     1361        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1362        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1363            THEN "^^":U
     1364        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1365             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1366   PROCEDURE adm-apply-entry :
     1367     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1368   END PROCEDURE.
     1369   PROCEDURE adm-destroy :
     1370    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1371   END PROCEDURE.
     1372   PROCEDURE adm-disable :
     1373       DISABLE T-dis-card BR-dis-card-type Tree RS-OPTION t-byobject WITH FRAME F-Main.
     1374       RUN dispatch ('disable-fields':U).
     1375       RUN set-attribute-list ('ENABLED=no':U).
     1376       RETURN.
     1377   END PROCEDURE.
     1378   PROCEDURE adm-edit-attribute-list :
     1379         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1380         RETURN.
     1381   END PROCEDURE.
     1382   PROCEDURE adm-enable :
     1383       ENABLE UNLESS-HIDDEN T-dis-card BR-dis-card-type Tree RS-OPTION t-byobject WITH FRAME F-Main.
     1384       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1385       RUN set-attribute-list ('ENABLED=yes':U).
     1386       RETURN.
     1387   END PROCEDURE.
     1388   PROCEDURE adm-exit :
     1389        RUN notify ('exit':U).
     1390     RETURN.
     1391   END PROCEDURE.
     1392   PROCEDURE adm-hide :
     1393     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1394   END PROCEDURE.
     1395   PROCEDURE adm-initialize :
     1396     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1397   END PROCEDURE.
     1398   PROCEDURE adm-show-errors :
     1399       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1400       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1401           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1402       END.
     1403       RETURN.
     1404   END PROCEDURE.
     1405   PROCEDURE adm-UIB-mode :
     1406     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1407   END PROCEDURE.
     1408   PROCEDURE adm-view :
     1409     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1410   END PROCEDURE.
     1411   PROCEDURE dispatch :
     1412       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1413       RUN broker-dispatch IN adm-broker-hdl
     1414           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1415       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1416   END PROCEDURE.
     1417   PROCEDURE ensure-broker :
     1418   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1419   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1420   DO:
     1421       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1422       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1423   END.
     1424   END PROCEDURE.
     1425   PROCEDURE get-attribute :
     1426     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1427     RUN broker-get-attribute IN adm-broker-hdl
     1428         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1429     RETURN RETURN-VALUE.
     1430   END PROCEDURE.
     1431   PROCEDURE get-attribute-list :
     1432     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1433     RUN broker-get-attribute-list IN adm-broker-hdl
     1434         (INPUT THIS-PROCEDURE,
     1435          INPUT ?,
     1436          OUTPUT p-attr-list) NO-ERROR.
     1437     RETURN.
     1438   END PROCEDURE.
     1439   PROCEDURE new-state :
     1440     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1441     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1442     RETURN.
     1443   END PROCEDURE.
     1444   PROCEDURE notify :
     1445     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1446     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1447     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1448         RETURN "ADM-ERROR":U.
     1449     RETURN.
     1450   END PROCEDURE.
     1451   PROCEDURE set-attribute-list :
     1452     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1453     RUN ensure-broker.
     1454     RUN broker-set-attribute-list IN adm-broker-hdl
     1455         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1456     RETURN.
     1457   END PROCEDURE.
     1458   PROCEDURE set-position :
     1459       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1460       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1461       IF VALID-HANDLE(adm-object-hdl) THEN
     1462       DO:
     1463           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1464           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1465           DO:
     1466             IF p-row = 0 THEN p-row =
     1467               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1468             IF p-col = 0 THEN p-col =
     1469               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1470           END.
     1471           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1472           DO:
     1473             parent-hdl = adm-object-hdl:PARENT.
     1474             IF p-row = 0 THEN p-row =
     1475               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1476                 parent-hdl:ROW.
     1477             IF p-col = 0 THEN p-col =
     1478               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1479                 parent-hdl:COL.
     1480           END.
     1481           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1482           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1483         ASSIGN adm-object-hdl:ROW    =   p-row
     1484                adm-object-hdl:COLUMN =   p-col.
     1485       END.
     1486       RETURN.
     1487   END PROCEDURE.
     1488   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1489       STRING(adm-object-hdl)).
     1490   PAUSE 0 BEFORE-HIDE.
     1491   PROCEDURE adm-change-page :
     1492     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1493     END PROCEDURE.
     1494   PROCEDURE delete-page :
     1495     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1496     RUN broker-delete-page IN adm-broker-hdl
     1497         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1498     END PROCEDURE.
     1499   PROCEDURE init-object :
     1500     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1501     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1502     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1503     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1504     RUN broker-init-object IN adm-broker-hdl
     1505         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1506          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1507     RETURN.
     1508   END PROCEDURE.
     1509   PROCEDURE init-pages :
     1510     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1511     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1512         INPUT p-page-list) NO-ERROR.
     1513     END PROCEDURE.
     1514   PROCEDURE select-page :
     1515     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1516     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1517         INPUT p-page#) NO-ERROR.
     1518     END PROCEDURE.
     1519   PROCEDURE view-page :
     1520     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1521     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1522         INPUT p-page#).
     1523     END PROCEDURE.
     1524   ASSIGN
     1525          BR-dis-card-type:HIDDEN  IN FRAME F-Main                = TRUE.
     1526   ON VALUE-CHANGED OF RS-dis-card IN FRAME F-Main
     1527   DO:
     1528   DEFINE VARIABLE varrid-list as character no-undo.
     1529     ASSIGN
     1530     RS-dis-card.
     1531     CASE RS-dis-card:
     1532       when 1 then do:
     1533           run ref/dc-types.w (
     1534                          input parparentproc
     1535                         ,INPUT "":U
     1536                         ,INPUT "b-sel,b-mark":U
     1537                         ,INPUT 0
     1538                         ,INPUT v-cntxt-host-code-obj
     1539                         ,INPUT v-cntxt-obj-type
     1540                         ,INPUT v-cntxt-obj-code
     1541                         ,input-OUTPUT varrid-list).
     1542                   if varrid-list = "" then do:
     1543               for each temp-dis-card-type:
     1544                   delete temp-dis-card-type.
     1545               end.
     1546               rs-dis-card = 0.
     1547               OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1548               DISPLAY
     1549               rs-dis-card
     1550               with frame F-Main.
     1551               HIDE
     1552               br-dis-card-type
     1553               in frame F-Main.
     1554           end.
     1555           else dO:
     1556             DO ii = 1 to num-entries(varrid-list):
     1557               FIND FIRST ub.dis-card-type No-LOCK WHERE
     1558                                 recid(ub.dis-card-type) = integer(entry(ii, varrid-list)) No-ERROR.
     1559             if avail ub.dis-card-type then dO:
     1560               create temp-dis-card-type.
     1561               buffer-copy ub.dis-card-type to temp-dis-card-type.
     1562             END.
     1563           END.
     1564           OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1565           DISPLAY
     1566           br-dis-card-type
     1567           with frame F-Main .
     1568         end.
     1569       end.
     1570       when 0 then do:
     1571         for each temp-dis-card-type:
     1572           delete temp-dis-card-type.
     1573         end.
     1574        OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1575         HIDE
     1576         br-dis-card-type
     1577         in frame F-Main.
     1578       end.
     1579     END CASE.
     1580   END.
     1581   ON VALUE-CHANGED OF RS-OPTION IN FRAME F-Main
     1582   DO:
     1583     ASSIGN
     1584     rs-option.
     1585     IF rs-option = "pay-desk" THEN DO:
     1586         ASSIGN
     1587         t-byobject = YES.
     1588         DISPLAY
     1589         t-byobject
     1590         WITH FRAME F-Main.
     1591         DISABLE t-byobject
     1592         WITH FRAME F-Main.
     1593     END.
     1594     ELSE DO:
     1595         ENABLE t-byobject
     1596         WITH FRAME F-Main.
     1597     END.
     1598   END.
     1599   ON VALUE-CHANGED OF t-byobject IN FRAME F-Main
     1600   DO:
     1601     ASSIGN
     1602     t-byobject.
     1603   END.
     1604   ON VALUE-CHANGED OF T-dis-card IN FRAME F-Main
     1605   DO:
     1606     assign
     1607     t-dis-card.
     1608     CASE t-dis-card:
     1609       when yes then do:
     1610           assign
     1611           Rs-dis-card = 0.
     1612           DISPLAY
     1613           RS-dis-card
     1614           with frame F-Main.
     1615           ENABLE
     1616           RS-dis-card
     1617           with frame F-Main.
     1618       end.
     1619       when no then do:
     1620           assign
     1621           Rs-dis-card = 0.
     1622           DISABLE
     1623           RS-dis-card
     1624           with frame F-Main.
     1625       end.
     1626     END CASE.
     1627   END.
     1628   if not this-procedure :persistent
     1629   then do:
     1630     message
     1631       vss-workfile vss-revision vss-description skip
     1632       "Ошибка при запуске процедуры" skip
     1633       "Данную процедуру следует запускать только с параметром persistent" skip
     1634       view-as alert-box error .
     1635     undo, return error .
     1636   end.
     1637   assign
     1638   loc#db-num = v-cntxt-db-num
     1639   loc#host-code = v-cntxt-host-code-obj
     1640   loc#store-code = v-cntxt-obj-code
     1641   .
     1642   PROCEDURE adm-create-objects :
     1643     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1644     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1645     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1646     CASE adm-current-page:
     1647       WHEN 0 THEN DO:
     1648          RUN init-object IN THIS-PROCEDURE (
     1649                INPUT  'rep/s-hour.w':U ,
     1650                INPUT  FRAME F-Main:HANDLE ,
     1651                INPUT  '':U ,
     1652                OUTPUT h_s-hour ).
     1653          RUN adjust-tab-order IN adm-broker-hdl ( h_s-hour ,
     1654                T-dis-card:HANDLE IN FRAME F-Main , 'BEFORE':U ).
     1655       END.
     1656     END CASE.
     1657   END PROCEDURE.
     1658   PROCEDURE adm-row-available :
     1659     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1660     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1661     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1662     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1663     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1664     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1665     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1666     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1667     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1668     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1669     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1670     IF adm-updating-record THEN RETURN.
     1671     RUN get-attribute ('FIELDS-ENABLED':U).
     1672     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1673     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1674         OUTPUT link-handle) NO-ERROR.
     1675     IF link-handle = "":U THEN
     1676         RETURN.
     1677     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1678     IF NUM-ENTRIES(link-handle) > 1 THEN
     1679         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1680             "encountered more than one RECORD-SOURCE.":U SKIP
     1681             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1682                VIEW-AS ALERT-BOX ERROR.
     1683     RUN get-attribute ('Key-Name':U).
     1684     key-name = RETURN-VALUE.
     1685     IF key-name = "":U THEN key-name = ?.
     1686     IF key-name NE ? THEN DO:
     1687       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1688         NO-ERROR.
     1689       IF key-value NE ? THEN
     1690         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1691     END.
     1692   IF VALID-HANDLE (adm-object-hdl) THEN
     1693       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1694   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1695   END PROCEDURE.
     1696   PROCEDURE disable_UI :
     1697     HIDE FRAME F-Main.
     1698     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1699   END PROCEDURE.
     1700   PROCEDURE enable_UI :
     1701     DISPLAY T-dis-card RS-dis-card Tree RS-OPTION t-byobject
     1702         WITH FRAME F-Main.
     1703     ENABLE T-dis-card BR-dis-card-type Tree RS-OPTION t-byobject
     1704         WITH FRAME F-Main.
     1705     OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1706   END PROCEDURE.
     1707   PROCEDURE local-initialize :
     1708     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1709     run ini-from-selobj in h_s-hour.
     1710     APPLY "VALUE-CHANGED" to T-dis-card in frame F-Main.
     1711     APPLY "VALUE-CHANGED" to RS-dis-card in frame F-Main.
     1712     parparentproc = my-handle.
     1713   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1714     run mainmenu_getcntxt in parparentproc
     1715       (output v-cntxt-db-num
     1716       ,output v-cntxt-userid
     1717       ,output v-cntxt-level
     1718       ,output v-cntxt-host-code-obj
     1719       ,output v-cntxt-obj-type
     1720       ,output v-cntxt-obj-code
     1721       ,output v-cntxt-db-num-obj
     1722       ,output v-cntxt-is-admin
     1723       ) .
     1724   END PROCEDURE.
     1725   PROCEDURE My-report :
     1726   define variable num-cols as integer.
     1727   define variable choice as integer.
     1728   define variable With-goods as integer no-undo.
     1729   DEFINE VARIABLE for-h-str as character no-undo .
     1730   define variable glog as logical no-undo .
     1731   run Assign-Frame in h_s-hour.
     1732   assign
     1733   FRAME F-Main RS-OPTION
     1734   FRAME F-Main Tree
     1735   FRAME F-Main t-byobject
     1736   .
     1737   run My-var.
     1738   case rs-option:
     1739     when "TOTALS":U then with-goods = 0.
     1740     when "GOODS":U then with-goods = 3.
     1741     when "GROUPS":U then with-goods = 2.
     1742     when "PAY-DESK":U then with-goods = 1.
     1743     when "PAYS":U then with-goods = 4
     1744     .
     1745   END CASE.
     1746   assign
     1747   num-cols = ( integer( vH-0 ) + integer( vH-1 ) + integer( vH-2 ) + integer( vH-3 ) + integer( vH-4 ) +
     1748                integer( vH-5 ) + integer( vH-6 ) + integer( vH-7 ) + integer( vH-8 ) + integer( vH-9 ) +
     1749                integer( vH-10 ) + integer( vH-11 ) + integer( vH-12 ) + integer( vH-13 ) + integer( vH-14 ) +
     1750                integer( vH-15 ) + integer( vH-16 ) + integer( vH-17 ) + integer( vH-18 ) + integer( vH-19 ) +
     1751                integer( vH-20 ) + integer( vH-21 ) + integer( vH-22 ) + integer( vH-23 ) ).
     1752   glog = ?.
     1753   if num-cols > 10 AND num-cols < 14  and NOT vXl AND NOT RS-option = "TOTALS":U
     1754   then do:
     1755       run gbl/d-askw.w (input "Формат вывода",
     1756                   input ("Количество интересующих Вас интервалов времени больше 10 :" + chr(10) +
     1757                          "отчет не уместится на бумаге формата А4 (ориентация альбомная)"
     1758                         ),
     1759                   input "|",
     1760                   input ("Выводить в Excel|" +
     1761                          "Формат А3 (ориентация альбомная)|" +
     1762                          "Уменьшить количество интервалов"),
     1763                   input "||",
     1764                   input 1,
     1765                   input 3,
     1766                   output choice).
     1767      if choice = 3 then return no-apply.
     1768      if choice = 1 then vXl = yes.
     1769      run display_ in h_s-hour.
     1770   end.
     1771   else if num-cols >=14 AND NOT vXl  AND NOT RS-option = "TOTALS":U then do:
     1772       run gbl/d-askw.w (input "Формат вывода",
     1773                    input ("Количество интересующих Вас интервалов времени больше 13 :" + chr(10) +
     1774                           "отчет не уместится на бумаге формата А3 (ориентация альбомная)"
     1775                          ),
     1776                    input "|",
     1777                    input ("Выводить в Excel|" +
     1778                           "Уменьшить количество интервалов"),
     1779                    input "|",
     1780                    input 1,
     1781                    input 2,
     1782                    output choice).
     1783       if choice = 2 then return no-apply.
     1784       vXl = yes.
     1785       run display_ in h_s-hour.
     1786   end.
     1787   if ( integer( vH-0 ) + integer( vH-1 ) + integer( vH-2 ) + integer( vH-3 ) + integer( vH-4 ) +
     1788        integer( vH-5 ) + integer( vH-6 ) + integer( vH-7 ) + integer( vH-8 ) + integer( vH-9 ) +
     1789        integer( vH-10 ) + integer( vH-11 ) + integer( vH-12 ) + integer( vH-13 ) + integer( vH-14 ) +
     1790        integer( vH-15 ) + integer( vH-16 ) + integer( vH-17 ) + integer( vH-18 ) + integer( vH-19 ) +
     1791        integer( vH-20 ) + integer( vH-21 ) + integer( vH-22 ) + integer( vH-23 ) ) = 0
     1792   then do:
     1793       message "Вы не определили," skip
     1794               "какие интервалы времени" skip
     1795               "Вас интересуют."     view-as alert-box ERROR .
     1796       return no-apply.
     1797   end.
     1798   else do:
     1799     run waitfram-show in this-procedure ( "Подождите ..." ).
     1800     do ii = 1 to 24:
     1801       for-h-str =
     1802        string( vH-0 ) + chr(44) + string( vH-1 ) + chr(44) +
     1803        string( vH-2 ) + chr(44) + string( vH-3 ) +  chr(44) +
     1804        string( vH-4 ) + chr(44) + string( vH-5 ) + chr(44) +
     1805        string( vH-6 ) + chr(44) + string( vH-7 ) + chr(44) +
     1806        string( vH-8 ) + chr(44) + string( vH-9 ) +  chr(44) +
     1807        string( vH-10 ) + chr(44) + string( vH-11 ) + chr(44) +
     1808        string( vH-12 ) + chr(44) + string( vH-13 ) + chr(44) +
     1809        string( vH-14 ) + chr(44) + string( vH-15 ) + chr(44) +
     1810        string( vH-16 ) + chr(44) + string( vH-17 ) + chr(44) +
     1811        string( vH-18 ) + chr(44) + string( vH-19 ) + chr(44) +
     1812        string( vH-20 ) + chr(44) + string( vH-21 ) + chr(44) +
     1813        string( vH-22 ) + chr(44) + string( vH-23 ).
     1814     end.
     1815     run rep/r-sumhr.p (
     1816                    input for-h-str
     1817                   ,input yes
     1818                   ,input with-goods
     1819                   ,input t-dis-card
     1820                   ,input rs-dis-card
     1821                   ) no-error .
     1822     if error-status:error then do:
     1823       message
     1824       vss-workfile vss-revision vss-description skip
     1825       error-status:get-message(1) skip
     1826       return-value
     1827       view-as alert-box error .
     1828       run waitfram-hide in this-procedure .
     1829       return.
     1830     end.
     1831     run waitfram-show in this-procedure ("Ждите... ").
     1832     if can-find( first grp-h ) then do:
     1833       if vXl THEN DO:
     1834         run rep/sxgrp-h.p (
     1835                         input my-handle
     1836                        ,input v-cntxt-host-code-obj
     1837                        ,input X-date-start
     1838                        ,input X-date-end
     1839                        ,input X-SelectObject
     1840                        ,input str4
     1841                        ,input RS-option
     1842                        ,input (if X-selectobject <> "currency":U and t-byobject then yes else no)
     1843                        ,input integer( WH-Start )
     1844                        ,input integer( WH-End )
     1845                        ,input TREE
     1846                        ,input t-dis-card
     1847                        ,input rs-dis-card
     1848                        ,input for-h-str ) no-error .
     1849         if error-status:error then do:
     1850           message
     1851           vss-workfile vss-revision vss-description skip
     1852           error-status:get-message(1) skip
     1853           return-value
     1854           view-as alert-box error .
     1855           run waitfram-hide in this-procedure .
     1856           return.
     1857         end.
     1858       END.
     1859       ELSE DO:
     1860         run rep/s-grp-h.p (
     1861                         input my-handle
     1862                       , input X-date-start
     1863                       , input X-date-end
     1864                       , input str4
     1865                       , input RS-option
     1866                       , input (if X-selectobject <> "currency":U and t-byobject then yes else no)
     1867                       , input integer( WH-Start )
     1868                       , input integer( WH-End )
     1869                       , input TREE
     1870                       , input t-dis-card
     1871                       , input rs-dis-card
     1872                       , input for-h-str ) no-error.
     1873         if error-status:error then do:
     1874           message
     1875           vss-workfile vss-revision vss-description skip
     1876           error-status:get-message(1) skip
     1877           return-value
     1878           view-as alert-box error .
     1879           run waitfram-hide in this-procedure .
     1880           return.
     1881         end.
     1882       END.
     1883       run waitfram-hide in this-procedure .
     1884       if vXl and RS-option <> "TOTALS":U then
     1885       run prn-lib-prn-file in this-procedure (
     1886                                                 input parParentProc
     1887                                                 ,input 3
     1888                                                 ).
     1889       else
     1890       run prn-lib-prn-file in this-procedure (
     1891                                                 input parParentProc
     1892                                                 ,input 8
     1893                                                 ).
     1894       FOR EACH grp-h :
     1895       delete grp-h .
     1896       END .
     1897       FOR EACH gds-h :
     1898       delete gds-h .
     1899       END .
     1900     end.
     1901     else do:
     1902       run waitfram-hide in this-procedure .
     1903       message "В указанный Вами период времени" skip
     1904               "на интересующих Вас объектах" skip
     1905               "не было НИКАКИХ продаж."
     1906       view-as alert-box INFORMATION .
     1907     end.
     1908    end.
     1909   END PROCEDURE.
     1910   PROCEDURE My-var :
     1911   assign frame F-Main
     1912   Tree Rs-Option
     1913   t-dis-card rs-dis-card t-byobject
     1914   .
     1915   Assign
     1916    STR-obj-type = ''
     1917    STR-obj-code = ''
     1918    STR-obj-name = ''
     1919    STR-obj      = ''.
     1920   For each obj-list no-lock:
     1921    Assign
     1922    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1923    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1924    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1925    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1926   End.
     1927   ReportNAme = "Почасовая статистика розничных продаж по СУММЕ ПРОДАЖ".
     1928   ReportHeader =  radio-label(string(Rs-Option), RS-Option:radio-buttons) +
     1929                   (if t-byobject then "Раздельно по объектам" else '':U) +
     1930                               if Tree then (", " + Tree:label ) else "" +
     1931                               string(if vXl then ", Вывод в Excel" else "").
     1932   if RS-option = "TOTALS":U then do:
     1933     do ii = 1 to 6:
     1934       use-column[ii] = yes.
     1935     end.
     1936     do ii = 7 to 24:
     1937       use-column[ii] = no.
     1938     end.
     1939   end.
     1940   else do:
     1941     assign
     1942     use-column[1] = yes
     1943     use-column[2] = yes
     1944     use-column[3] = yes
     1945     use-column[28] = yes
     1946     use-column[29] = yes
     1947     .
     1948     assign
     1949     use-column[4] = vH-0
     1950     use-column[5] = vH-1
     1951     use-column[6] = vh-2
     1952     use-column[7] = vh-3
     1953     use-column[8] = vh-4
     1954     use-column[9] = vH-5
     1955     use-column[10] = vH-6
     1956     use-column[11] = vh-7
     1957     use-column[12] = vh-8
     1958     use-column[13] = vh-9
     1959     use-column[14] = vH-10
     1960     use-column[15] = vH-11
     1961     use-column[16] = vh-12
     1962     use-column[17] = vh-13
     1963     use-column[18] = vh-14
     1964     use-column[19] = vH-15
     1965     use-column[20] = vH-16
     1966     use-column[21] = vh-17
     1967     use-column[22] = vh-18
     1968     use-column[23] = vh-19
     1969     use-column[24] = vH-20
     1970     use-column[25] = vH-21
     1971     use-column[26] = vh-22
     1972     use-column[27] = vh-23
     1973     .
     1974   end.
     1975   END PROCEDURE.
     1976   PROCEDURE send-records :
     1977     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1978     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1979     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1980     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1981     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1982     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1983         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1984         CASE ENTRY(i, p-tbl-list):
     1985       WHEN "temp-dis-card-type":U THEN p-rowid-list = p-rowid-list +
     1986           IF AVAILABLE temp-dis-card-type THEN STRING(ROWID(temp-dis-card-type))
     1987           ELSE "?":U.
     1988           OTHERWISE
     1989           DO:
     1990               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1991                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1992               IF link-handle NE "":U THEN
     1993               DO:
     1994                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1995                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1996                               "encountered more than one RECORD-SOURCE.":U SKIP
     1997                               "The first will be used.":U
     1998                               VIEW-AS ALERT-BOX ERROR.
     1999                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     2000                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     2001                   p-rowid-list = p-rowid-list + rowid-string.
     2002               END.
     2003               ELSE
     2004               DO:
     2005                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     2006                           "does not match tables in send-records":U
     2007                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     2008                           "Check that objects are linked properly and that":U
     2009                           "database qualification is consistent.":U
     2010                       VIEW-AS ALERT-BOX ERROR.
     2011                   RETURN ERROR.
     2012               END.
     2013           END.
     2014           END CASE.
     2015       END.
     2016   END PROCEDURE.
     2017   PROCEDURE state-changed :
     2018     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2019     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2020     CASE p-state:
     2021     END CASE.
     2022     IF INDEX(p-state, "SELECTOBJECT=") > 0 then do:
     2023           RUn ini-from-selobj in h_s-hour.
     2024     end.
     2025   END PROCEDURE.
