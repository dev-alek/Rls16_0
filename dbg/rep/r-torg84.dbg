      966                   v-torgconf-outhold   = yes
      967               .
      968           end.
      969           if lookup( p-form-name, v-outobj   ) <> 0
      970           then do:
      971               assign
      972                   v-torgconf-outobj    = yes
      973               .
      974           end.
      975           if lookup( p-form-name, v-outsend   ) <> 0
