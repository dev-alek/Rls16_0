     4755           and in-vatp_doc-attrocur.attr-code = 'envd':U
     4756         no-error .
     4757       if not available in-vatp_doc-attrocur then do:
     4758         assign
     4759           in-vatp-have-vat-sltocur = yes.
     4760       end.
     4761       else do:
     4762            in-vatp-have-vat-sltocur = no.
