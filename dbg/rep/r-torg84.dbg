     5057       bfpc_tt-allsum.excise-base-cur     = bf_tt-allsum.excise-base-cur
     5058       bfpc_tt-allsum.excise-rubl-cur     = bf_tt-allsum.excise-rubl-cur
     5059       bfpc_tt-allsum.sum-dsc-base-acc    = 0
