     4957       bfs_tt-allsum.road-tax-base-doc   =  - bf_tt-allsum.road-tax-base-doc
     4958       bfs_tt-allsum.road-tax-rubl-doc   =  - bf_tt-allsum.road-tax-rubl-doc
     4959       bfs_tt-allsum.excise-base-doc     =  - bf_tt-allsum.excise-base-doc
