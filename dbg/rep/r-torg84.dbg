        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define input parameter Invers               as logical          no-undo.
        5       define stream out-stream.
        6       define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        7       define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        8       define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9       define variable vss-workfile    as character no-undo initial "$Workfile: r-torg84.p $":U .
       10       define variable vss-archive     as character no-undo initial "$Archive: rep/r-torg84.p $":U .
       11       define variable vss-description as character no-undo initial "Акт о приемке товаров":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       74   define  shared variable RepPathName        as character no-undo .
       75   define  shared variable PrintRubl          as logical   no-undo .
       76   define new global shared variable g#lib-trn  as handle no-undo .
       77   define new global shared variable g#lib-trn2 as handle no-undo .
       78   define new global shared variable g#lib-trn3 as handle no-undo .
       79   define new global shared variable g#lib-trn4 as handle no-undo .
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define new global shared variable g#trdcalib as handle no-undo.
       82   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       83                                     iInput AS INTEGER).
       84     def var v-start-print as integer no-undo .
       85     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       86     assign
       87       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       88     .
       89     RETURN v-start-print .
       90   END FUNCTION.
       91   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       92                                     iInput AS INTEGER).
       93     def var v-start-print as integer no-undo .
       94     assign
       95       v-start-print = INTEGER(iEndPix - 1 - iInput)
       96     .
       97     if v-start-print < 0 then return 0.
       98     RETURN v-start-print .
       99   END FUNCTION.
      100   define variable vss-include-info2 as character format "X(65)" no-undo
      101   initial "@(#)$Workfile$ $Revision$".
      102   define variable v-fmtcli-name          as character    no-undo.
      103   define variable v-fmtcli-engl-name     as character    no-undo.
      104   define variable v-fmtcli-addres        as character    no-undo.
      105   define variable v-fmtcli-post-addres   as character    no-undo.
      106   define variable v-fmtcli-full-addres   as character    no-undo.
      107   define variable v-fmtcli-phone         as character    no-undo.
      108   define variable v-fmtcli-inn           as character    no-undo.
      109   define variable v-fmtcli-kpp           as character    no-undo.
      110   define variable v-fmtcli-okpo          as character    no-undo.
      111   define variable v-fmtcli-country       as character    no-undo.
      112   define variable v-fmtcli-city          as character    no-undo.
      113   define variable v-fmtcli-index         as character    no-undo.
      114   define variable v-fmtcli-schet-exists  as logical      no-undo.
      115   define variable v-fmtcli-bank-exists   as logical      no-undo.
      116   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      117   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      118   define variable v-fmtcli-bank-bik      as character    no-undo.
      119   define variable v-fmtcli-bank-name     as character    no-undo.
      120   define variable v-fmtcli-bank-addres   as character    no-undo.
      121   define variable v-fmtcli-bank-city     as character    no-undo.
      122   procedure fmtcli-get-bank :
      123   define input parameter p-host-code      as integer          no-undo.
      124   define input parameter p-obj-type       as character        no-undo.
      125   define input parameter p-obj-code       as integer          no-undo.
      126   define input parameter p-curr-code      as integer          no-undo.
      127       define buffer buf_fin-schet     for ub.fin-schet.
      128       define buffer buf_fin-bank      for ub.fin-bank.
      129   do
      130   for buf_fin-schet
      131     , buf_fin-bank
      132   on error undo, return error
      133   :
      134       assign
      135           v-fmtcli-schet-exists       = no
      136           v-fmtcli-bank-exists        = no
      137           v-fmtcli-bank-r-schet       = "":U
      138           v-fmtcli-bank-c-schet       = "":U
      139           v-fmtcli-bank-bik           = "":U
      140           v-fmtcli-bank-name          = "":U
      141           v-fmtcli-bank-addres        = "":U
      142           v-fmtcli-bank-city          = "":U
      143       .
      144       search-for-schet:
      145       for each buf_fin-schet no-lock
      146          where buf_fin-schet.host-code = p-host-code
      147            and buf_fin-schet.cli-type  = p-obj-type
      148            and buf_fin-schet.cli-code  = p-obj-code
      149            and buf_fin-schet.curr-code = p-curr-code
      150       on error undo, return error
      151       :
      152           if buf_fin-schet.status_   = 'удал':U
      153           then do:
      154           end.
      155           else do:
      156               assign
      157                   v-fmtcli-schet-exists   = yes
      158                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      159                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      160               .
      161               find first buf_fin-bank no-lock
      162                    where buf_fin-bank.host-code = p-host-code
      163                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      164               no-error.
      165               if available buf_fin-bank
      166               then do:
      167                   assign
      168                       v-fmtcli-bank-exists      = yes
      169                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      170                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      171                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      172                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      173                   .
      174               end.
      175               else do:
      176                   assign
      177                       v-fmtcli-bank-exists    = no
      178                       v-fmtcli-bank-bik       = "":U
      179                       v-fmtcli-bank-name      = "":U
      180                       v-fmtcli-bank-addres    = "":U
      181                       v-fmtcli-bank-city      = "":U
      182                   .
      183               end.
      184               leave search-for-schet.
      185           end.
      186       end.
      187   end.
      188   end procedure.
      189   procedure fmtcli-get-client :
      190   define input parameter p-obj-type       as character    no-undo.
      191   define input parameter p-obj-code       as integer      no-undo.
      192       define variable v-temp-fmtcli-address      as character     no-undo.
      193       define variable v-num-country-city    as integer      no-undo.
      194       define buffer buf_clients   for ub.clients.
      195       define buffer buf_firm      for ub.firm.
      196       define buffer buf_store     for ub.store.
      197       define buffer buf_shop      for ub.shop.
      198       define buffer buf_person    for ub.person.
      199   do
      200   for buf_clients
      201     , buf_firm
      202     , buf_store
      203     , buf_shop
      204     , buf_person
      205   on error undo, return error
      206   :
      207       assign
      208           v-fmtcli-name           = "":U
      209           v-fmtcli-addres         = "":U
      210           v-fmtcli-post-addres    = "":U
      211           v-fmtcli-full-addres    = "":U
      212           v-fmtcli-phone          = "":U
      213           v-fmtcli-inn            = "":U
      214           v-fmtcli-kpp            = "":U
      215           v-fmtcli-okpo           = "":U
      216           v-fmtcli-city           = "":U
      217           v-fmtcli-index          = "":U
      218           v-fmtcli-country        = "":U
      219       .
      220       find first buf_clients no-lock
      221            where buf_clients.obj-type = p-obj-type
      222              and buf_clients.obj-code = p-obj-code
      223       .
      224       assign
      225           v-fmtcli-name = buf_clients.obj-name
      226       .
      227       case buf_clients.obj-type:
      228          when 'орг':U
      229          then do:
      230               find first buf_firm no-lock
      231                    where buf_firm.firm-code = buf_clients.obj-code
      232                    no-error
      233               .
      234               if available buf_firm
      235               then do:
      236                   assign
      237                       v-num-country-city = num-entries( buf_firm.city )
      238                       v-fmtcli-engl-name = buf_firm.engl-name
      239                   .
      240                   if v-num-country-city > 0
      241                   then do:
      242                       assign
      243                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      244                       .
      245                   end.
      246                   if v-num-country-city > 1
      247                   then do:
      248                       assign
      249                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      250                       .
      251                   end.
      252                   run fmtcli-concatenate-strings in this-procedure (
      253                         input v-fmtcli-full-addres
      254                       , input v-fmtcli-country
      255                       , input ", ":U
      256                       , input 50
      257                       , output v-fmtcli-full-addres
      258                   ).
      259                   run fmtcli-concatenate-strings in this-procedure (
      260                         input v-fmtcli-full-addres
      261                       , input v-fmtcli-city
      262                       , input ", ":U
      263                       , input 50
      264                       , output v-fmtcli-full-addres
      265                   ).
      266                   run fmtcli-concatenate-strings in this-procedure (
      267                         input v-fmtcli-full-addres
      268                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      269                       , input ", ":U
      270                       , input 50
      271                       , output v-fmtcli-full-addres
      272                   ).
      273                   run fmtcli-concatenate-strings in this-procedure (
      274                         input v-fmtcli-post-addres
      275                       , input v-fmtcli-country
      276                       , input ", ":U
      277                       , input 50
      278                       , output v-fmtcli-post-addres
      279                   ).
      280                   run fmtcli-concatenate-strings in this-procedure (
      281                         input v-fmtcli-post-addres
      282                       , input v-fmtcli-city
      283                       , input ", ":U
      284                       , input 50
      285                       , output v-fmtcli-post-addres
      286                   ).
      287                   run fmtcli-concatenate-strings in this-procedure (
      288                         input v-fmtcli-post-addres
      289                       , input string( buf_firm.ind )
      290                       , input ", ":U
      291                       , input 50
      292                       , output v-fmtcli-post-addres
      293                   ).
      294                   run fmtcli-concatenate-strings in this-procedure (
      295                         input substring( buf_firm.addres1, 1, 50 )
      296                       , input buf_firm.addres2
      297                       , input " ":U
      298                       , input 50
      299                       , output v-temp-fmtcli-address
      300                   ).
      301                   run fmtcli-concatenate-strings in this-procedure (
      302                         input v-temp-fmtcli-address
      303                       , input substring( buf_firm.addres1, 51, 50 )
      304                       , input " ":U
      305                       , input 50
      306                       , output v-temp-fmtcli-address
      307                   ).
      308                   run fmtcli-concatenate-strings in this-procedure (
      309                         input v-temp-fmtcli-address
      310                       , input substring( buf_firm.addres1, 101, 50 )
      311                       , input " ":U
      312                       , input 50
      313                       , output v-temp-fmtcli-address
      314                   ).
      315                   assign
      316                       v-fmtcli-addres = v-temp-fmtcli-address
      317                   .
      318                   if buf_firm.addres1 <> ?
      319                   then do:
      320                       run fmtcli-concatenate-strings in this-procedure (
      321                             input v-fmtcli-full-addres
      322                           , input v-fmtcli-addres
      323                           , input ", ":U
      324                           , input 0
      325                           , output v-fmtcli-full-addres
      326                       ).
      327                   end.
      328                   run fmtcli-concatenate-strings in this-procedure (
      329                         input substring( buf_firm.post-addr1, 1, 50 )
      330                       , input buf_firm.post-addr2
      331                       , input " ":U
      332                       , input 50
      333                       , output v-fmtcli-post-addres
      334                   ).
      335                   run fmtcli-concatenate-strings in this-procedure (
      336                         input v-fmtcli-post-addres
      337                       , input substring( buf_firm.post-addr1, 51, 50 )
      338                       , input " ":U
      339                       , input 50
      340                       , output v-fmtcli-post-addres
      341                   ).
      342                   run fmtcli-concatenate-strings in this-procedure (
      343                         input v-fmtcli-post-addres
      344                       , input substring( buf_firm.post-addr1, 101, 50 )
      345                       , input " ":U
      346                       , input 50
      347                       , output v-fmtcli-post-addres
      348                   ).
      349                   assign
      350                       v-fmtcli-phone         = buf_firm.phone
      351                       v-fmtcli-inn           = buf_firm.inn
      352                       v-fmtcli-kpp           = buf_firm.kpp
      353                       v-fmtcli-okpo          = buf_firm.okpo
      354                       v-fmtcli-index         = string( buf_firm.ind )
      355                   .
      356               end.
      357          end.
      358          when 'маг':U
      359          then do:
      360               find first buf_shop no-lock
      361                    where buf_shop.obj-code = buf_clients.obj-code
      362               .
      363               if available buf_shop
      364               then do:
      365                   run fmtcli-concatenate-strings in this-procedure (
      366                         input buf_shop.addres1
      367                       , input buf_shop.addres2
      368                       , input " ":U
      369                       , input 50
      370                       , output v-fmtcli-addres
      371                   ).
      372                   assign
      373                       v-fmtcli-full-addres = v-fmtcli-addres
      374                       v-fmtcli-post-addres = v-fmtcli-addres
      375                       v-fmtcli-phone       = buf_shop.phone
      376                       v-fmtcli-inn         = "":U
      377                       v-fmtcli-kpp         = "":U
      378                       v-fmtcli-okpo        = "":U
      379                       v-fmtcli-city        = "":U
      380                       v-fmtcli-index       = "":U
      381                   .
      382               end.
      383          end.
      384          when 'скл':U
      385          then do:
      386               find first buf_store no-lock
      387                    where buf_store.obj-code = buf_clients.obj-code
      388               .
      389               if available buf_store
      390               then do:
      391                   run fmtcli-concatenate-strings in this-procedure (
      392                         input buf_store.addres1
      393                       , input buf_store.addres2
      394                       , input " ":U
      395                       , input 50
      396                       , output v-fmtcli-addres
      397                   ).
      398                   assign
      399                       v-fmtcli-full-addres = v-fmtcli-addres
      400                       v-fmtcli-phone       = buf_store.phone
      401                       v-fmtcli-inn         = "":U
      402                       v-fmtcli-kpp         = "":U
      403                       v-fmtcli-okpo        = "":U
      404                       v-fmtcli-city        = "":U
      405                       v-fmtcli-index       = "":U
      406                   .
      407               end.
      408          end.
      409          when 'чел':U
      410          then do:
      411               find first buf_person no-lock
      412                    where buf_person.psn-code = buf_clients.obj-code
      413               .
      414               if available buf_person
      415               then do:
      416                   run fmtcli-concatenate-strings in this-procedure (
      417                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      418                                 then "":U
      419                                 else string( buf_person.ind, "999999")
      420                                 )
      421                       , input buf_person.city
      422                       , input ", ":U
      423                       , input 0
      424                       , output v-fmtcli-full-addres
      425                   ).
      426                   assign
      427                       v-fmtcli-addres = buf_person.address
      428                   .
      429                   run fmtcli-concatenate-strings in this-procedure (
      430                         input v-fmtcli-full-addres
      431                       , input v-fmtcli-addres
      432                       , input ", ":U
      433                       , input 0
      434                       , output v-fmtcli-full-addres
      435                   ).
      436                   assign
      437                       v-fmtcli-phone     = buf_person.phone1
      438                       v-fmtcli-inn       = buf_person.inn
      439                       v-fmtcli-kpp       = buf_person.kpp
      440                       v-fmtcli-okpo      = buf_person.okpo
      441                       v-fmtcli-city      = buf_person.city
      442                       v-fmtcli-index     = string( buf_person.ind )
      443                   .
      444               end.
      445          end.
      446       end case.
      447   end.
      448   end procedure.
      449   procedure fmtcli-concatenate-strings :
      450   define input parameter p-string-1       as character        no-undo.
      451   define input parameter p-string-2       as character        no-undo.
      452   define input parameter p-delimiter      as character        no-undo.
      453   define input parameter p-length         as integer          no-undo.
      454   define output parameter p-out-string    as character        no-undo.
      455   do
      456   on error undo, return error
      457   :
      458       assign
      459           p-out-string = ( if p-string-1 = ?
      460                            then "":U
      461                            else trim( p-string-1 ) )
      462       .
      463       assign
      464           p-out-string = p-out-string
      465                        + ( if p-out-string = "":U
      466                            or length( p-out-string ) = p-length
      467                            or p-string-2 = ?
      468                            or trim( p-string-2 ) = "":U
      469                            then "":U
      470                            else p-delimiter )
      471                        + ( if p-string-2 = ?
      472                            or trim( p-string-2 ) = "":U
      473                            then "":U
      474                            else trim( p-string-2 ) )
      475       .
      476   end.
      477   end procedure.
