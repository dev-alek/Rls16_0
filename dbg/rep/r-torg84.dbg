     3486   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3487   procedure paramls-clear :
     3488     define buffer buf_temp-param for temp-param .
     3489     do
     3490     on error undo, return error return-value
     3491     :
     3492       for each buf_temp-param
     3493       on error undo, return error
     3494       :
     3495         delete buf_temp-param .
     3496       end.
     3497     end.
     3498   end procedure.
     3499   procedure paramls-write :
     3500     define input  parameter p-code     as character no-undo .
     3501     define input  parameter p-sub-code as character no-undo .
     3502     define input  parameter p-value    as character no-undo .
     3503     define buffer buf_temp-param for temp-param .
     3504     do
     3505     on error undo, return error return-value
     3506     :
     3507       find first buf_temp-param
     3508         where buf_temp-param.param-code     = p-code
     3509           and buf_temp-param.param-sub-code = p-sub-code
     3510         no-error .
     3511       if not available buf_temp-param then do:
     3512         create buf_temp-param .
     3513         assign
     3514           buf_temp-param.param-code     = p-code
     3515           buf_temp-param.param-sub-code = p-sub-code
     3516         .
     3517       end.
     3518       assign
     3519         buf_temp-param.param-value = p-value
     3520       .
     3521     end.
     3522   end procedure.
     3523   procedure paramls-read :
     3524     define input  parameter p-code          as character no-undo .
     3525     define input  parameter p-sub-code      as character no-undo .
     3526     define input  parameter p-default-value as character no-undo .
     3527     define output parameter p-value         as character no-undo .
     3528     define buffer buf_temp-param for temp-param .
     3529     do
     3530     on error undo, return error return-value
     3531     :
     3532       find first buf_temp-param
     3533         where buf_temp-param.param-code     = p-code
     3534           and buf_temp-param.param-sub-code = p-sub-code
     3535         no-error .
     3536       if available buf_temp-param then do:
     3537         assign
     3538           p-value = buf_temp-param.param-value
     3539         .
     3540       end.
     3541       else do:
     3542         assign
     3543           p-value = p-default-value
     3544         .
     3545       end.
     3546     end.
     3547   end procedure.
     3548   procedure paramls-append :
     3549     define input  parameter p-code     as character no-undo .
     3550     define input  parameter p-sub-code as character no-undo .
     3551     define input  parameter p-value    as character no-undo .
     3552     define buffer buf_temp-param for temp-param .
     3553     do
     3554     on error undo, return error return-value
     3555     :
     3556       find first buf_temp-param
     3557            where buf_temp-param.param-code     = p-code
     3558              and buf_temp-param.param-sub-code = p-sub-code
     3559         no-error .
     3560       if not available buf_temp-param then do:
     3561         create buf_temp-param .
     3562         assign
     3563           buf_temp-param.param-code     = p-code
     3564           buf_temp-param.param-sub-code = p-sub-code
     3565           buf_temp-param.param-value    = p-value
     3566         .
     3567       end.
     3568       else do:
     3569           assign
     3570               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     3571           .
     3572       end.
     3573     end.
     3574   end procedure.
     3575       define variable g#report-num    as integer      no-undo .
     3576       define variable g#quest-print   as logical      no-undo .
     3577       define variable g#log           as logical      no-undo .
     3578   define variable vss-include-info15 as character format "X(65)" no-undo
     3579   initial "@(#)$Workfile$ $Revision$".
     3580   define stream excel-line .
     3581   define stream excel-cell .
     3582   define temp-table temp_cell-data no-undo
     3583       field data-key   as character
     3584       field data-value as character
     3585       index pi is primary unique data-key
     3586   .
     3587   define temp-table temp_line-data no-undo
     3588       field data-key          as character
     3589       field xl-line-id        as integer
     3590       field Name              as character
     3591       field EI                as character
     3592       field price             as character
     3593       field PlaceAmountSupp   as character
     3594       field SumSupp           as character
     3595       field PlaceAmountFact   as character
     3596       field SumFact           as character
     3597       field sum               as character
     3598       field VATpc             as character
     3599       field VATsum            as character
     3600       field PlaceAmountDelt   as character
     3601       field SumDelt           as character
     3602       index pi is primary unique
     3603           xl-line-id
     3604   .
     3605   define variable v-tg84xl-cur-data-row    as integer      no-undo .
     3606   define variable v-tg84xl-cell-file-name  as character    no-undo .
     3607   define variable v-tg84xl-data-file-name  as character    no-undo .
     3608   procedure tg84xl-init :
     3609   do
     3610   on error undo, return error
     3611   :
     3612       assign
     3613           v-tg84xl-cur-data-row = 0
     3614       .
     3615       run gbl/_tmpfile.p (
     3616             input "xd"
     3617           , input ".txt"
     3618           , output v-tg84xl-data-file-name
     3619       ).
     3620       output stream excel-line to value( v-tg84xl-data-file-name ).
     3621       run gbl/_tmpfile.p (
     3622             input "xc"
     3623           , input ".txt"
     3624           , output v-tg84xl-cell-file-name
     3625       ).
     3626       output stream excel-cell to value( v-tg84xl-cell-file-name ).
     3627       run tg84xl-write-cell-data in this-procedure (
     3628             input "valutCode":U
     3629           , input "0":U
     3630       ).
     3631       run tg84xl-write-cell-data in this-procedure (
     3632             input "columnList":U
     3633           , input "Name,EI,price,PlaceAmountSupp,SumSupp,PlaceAmountFact,SumFact,sum,VATpc,VATsum,PlaceAmountDelt,SumDelt":U
     3634       ).
     3635       run tg84xl-write-cell-data in this-procedure (
     3636             input "columnType":U
     3637           , input "S,S,D,D,D,D,D,D,D,D,D,D":U
     3638       ).
     3639       run tg84xl-write-cell-data in this-procedure (
     3640             input "columnAmount":U
     3641           , input "12":U
     3642       ).
     3643   end.
     3644   end procedure.
     3645   procedure tg84xl-write-line-data :
     3646   define input parameter p-Name              as character        no-undo.
     3647   define input parameter p-EI                as character        no-undo.
     3648   define input parameter p-price             as character        no-undo.
     3649   define input parameter p-PlaceAmountSupp   as character        no-undo.
     3650   define input parameter p-SumSupp           as character        no-undo.
     3651   define input parameter p-PlaceAmountFact   as character        no-undo.
     3652   define input parameter p-SumFact           as character        no-undo.
     3653   define input parameter p-sum               as character        no-undo.
     3654   define input parameter p-VATpc             as character        no-undo.
     3655   define input parameter p-VATsum            as character        no-undo.
     3656   define input parameter p-PlaceAmountDelt   as character        no-undo.
     3657   define input parameter p-SumDelt           as character        no-undo.
     3658       define buffer buf_temp_line-data        for temp_line-data.
     3659   do
     3660   for buf_temp_line-data
     3661   on error undo, return error
     3662   :
     3663       for each buf_temp_line-data
     3664       :
     3665           delete buf_temp_line-data.
     3666       end.
     3667       create buf_temp_line-data.
     3668       assign
     3669           v-tg84xl-cur-data-row                = v-tg84xl-cur-data-row + 1
     3670           buf_temp_line-data.data-key          = "LD":U
     3671           buf_temp_line-data.Name              = p-Name
     3672           buf_temp_line-data.EI                = p-EI
     3673           buf_temp_line-data.price             = p-price
     3674           buf_temp_line-data.PlaceAmountSupp   = p-PlaceAmountSupp
     3675           buf_temp_line-data.SumSupp           = p-SumSupp
     3676           buf_temp_line-data.PlaceAmountFact   = p-PlaceAmountFact
     3677           buf_temp_line-data.SumFact           = p-SumFact
     3678           buf_temp_line-data.sum               = p-sum
     3679           buf_temp_line-data.VATpc             = p-VATpc
     3680           buf_temp_line-data.VATsum            = p-VATsum
     3681           buf_temp_line-data.PlaceAmountDelt   = p-PlaceAmountDelt
     3682           buf_temp_line-data.SumDelt           = p-SumDelt
     3683       .
     3684       put stream excel-line unformatted
     3685                           buf_temp_line-data.data-key
     3686           chr(9)   buf_temp_line-data.Name
     3687           chr(9)   buf_temp_line-data.EI
     3688           chr(9)   buf_temp_line-data.price
     3689           chr(9)   buf_temp_line-data.PlaceAmountSupp
     3690           chr(9)   buf_temp_line-data.SumSupp
     3691           chr(9)   buf_temp_line-data.PlaceAmountFact
     3692           chr(9)   buf_temp_line-data.SumFact
     3693           chr(9)   buf_temp_line-data.sum
     3694           chr(9)   buf_temp_line-data.VATpc
     3695           chr(9)   buf_temp_line-data.VATsum
     3696           chr(9)   buf_temp_line-data.PlaceAmountDelt
     3697           chr(9)   buf_temp_line-data.SumDelt
     3698           chr(10)
     3699       .
     3700   end.
     3701   end procedure.
     3702   procedure tg84xl-write-cell-data :
     3703   define input parameter p-data-key   as character        no-undo.
     3704   define input parameter p-data-value as character        no-undo.
     3705       define buffer buf_temp_cell-data     for temp_cell-data.
     3706   do
     3707   for buf_temp_cell-data
     3708   on error undo, return error
     3709   :
     3710       find first buf_temp_cell-data
     3711            where buf_temp_cell-data.data-key = p-data-key
     3712       no-error.
     3713       if not available buf_temp_cell-data
     3714       then do:
     3715           create buf_temp_cell-data.
     3716           assign
     3717               buf_temp_cell-data.data-key = p-data-key
     3718           .
     3719       end.
     3720       assign
     3721           buf_temp_cell-data.data-value = p-data-value
     3722       .
     3723       put stream excel-cell unformatted
     3724                           buf_temp_cell-data.data-key
     3725           chr(9)   buf_temp_cell-data.data-value
     3726           chr(10)
     3727       .
     3728   end.
     3729   end procedure.
     3730   procedure tg84xl-run-excel :
     3731   define input parameter p-header-filename    as character    no-undo .
     3732   define input parameter p-data-filename      as character    no-undo .
     3733   define variable v-template-file-name        as character    no-undo .
     3734   define variable v-vb-file-name              as character    no-undo .
     3735       define buffer buf_temp-param for temp-param .
     3736   do
     3737   for buf_temp-param
     3738   on error undo, return error
     3739   :
     3740       create buf_temp-param.
     3741       assign
     3742           v-template-file-name    = search( "exe/tg84.xlt" )
     3743           v-vb-file-name          = search( "exe/t_97.bas")
     3744       .
     3745       if v-template-file-name = ?
     3746       or v-template-file-name = "":U
     3747       then do:
     3748           message
     3749               "Ошибка имени файла шаблона."
     3750           view-as alert-box error.
     3751       end.
     3752       if v-vb-file-name = ?
     3753       or v-vb-file-name = "":U
     3754       then do:
     3755           message
     3756               "Ошибка имени файла кода обработки."
     3757           view-as alert-box error.
     3758       end.
     3759       run paramls-write in this-procedure (
     3760             input "template":U
     3761           , input "template-file-name":U
     3762           , input v-template-file-name
     3763       ).
     3764       run paramls-write in this-procedure (
     3765             input "template":U
     3766           , input "vb-file-name":U
     3767           , input v-vb-file-name
     3768       ).
     3769       run paramls-write in this-procedure (
     3770             input "data":U
     3771           , input "data-header-filename":U
     3772           , input p-header-filename
     3773       ).
     3774       run paramls-write in this-procedure (
     3775             input "data":U
     3776           , input "data-filename":U
     3777           , input p-data-filename
     3778       ).
     3779       run gbl/macroxlt.p (
     3780           input-output table buf_temp-param
     3781       ) no-error.
     3782       if error-status :error
     3783       then do:
     3784           message
     3785                    vss-workfile vss-revision vss-description
     3786               skip(1)
     3787               skip "Ошибка создания файла Excel."
     3788               skip return-value
     3789               skip trim(error-status :get-message(1))
     3790                    trim(error-status :get-message(2))
     3791                    trim(error-status :get-message(3))
     3792           view-as alert-box error.
     3793           undo, return error .
     3794       end.
     3795   end.
     3796   end procedure.
     3797   procedure tg84xl-close :
     3798   do
     3799   on error undo, return error
     3800   :
     3801       output stream excel-line close.
     3802       output stream excel-cell close.
     3803       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     3804           export "exe/tg84.xlt":U.
     3805           export "exe/t_97.bas":U.
     3806           export v-tg84xl-cell-file-name.
     3807           export v-tg84xl-data-file-name.
     3808       output close.
     3809   end.
     3810   end procedure.
     3811   procedure tg84xl-write-line-format :
     3812   define input parameter p-fmt-label  as character  no-undo.
     3813   define buffer buf_temp_line-data    for temp_line-data.
     3814   do
     3815   for buf_temp_line-data
     3816   on error undo, return error
     3817   :
     3818       put stream excel-line unformatted
     3819           chr(9)
     3820           chr(9)   p-fmt-label
     3821           chr(10)
     3822       .
     3823   end.
     3824   end procedure.
