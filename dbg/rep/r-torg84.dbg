     5504   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     5505     (input  bf_trn-doc.obj-type
     5506     ,input  bf_trn-doc.obj-code
     5507     ,input  varb-code
     5508     ,input  0
     5509     ,input  bf_trn-doc.fact-order
     5510     ,output vardoc-num
     5511     ,output varprice-sale
     5512     ,output varroad-tax
     5513     ,output varexcise
     5514     ,output varcur-vat-pc
     5515     ,output varcur-slt-pc
     5516     )  .
     5517       if varprice-sale = ?
     5518       then do:
     5519         assign
     5520           varcur-vat-pc = 0
     5521           varcur-slt-pc = 0
     5522         .
     5523       end.
     5524   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5525   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5526     (input  bf_goods.gds-code
     5527     ,input  '1':U
     5528     ,input  bf_trn-doc.fact-date
     5529     ,input  bf_trn-doc.host-code
     5530     ,input  bf_trn-doc.obj-type
     5531     ,input  bf_trn-doc.obj-code
     5532     ,output varcur-vat-pc
     5533     ) no-error .
     5534       if varcur-vat-pc = ?
     5535       then do:
     5536         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5537       end.
     5538       if varcur-slt-pc = ?
     5539       then do:
     5540         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5541       end.
     5542       v-calcbypart = no.
     5543       if bf_doc-line.whole-send-news = integer('1':U)   then
     5544       v-calcbypart = yes.
     5545       else do:
     5546       for each bf_gds-dtl no-lock
     5547         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     5548           and bf_gds-dtl.artic     = bf_doc-line.artic
     5549           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
