     6279       for each buf_doc-line no-lock
     6280          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     6281       on error undo, return error
     6282       :
     6283           find first buf_goods no-lock
     6284                where buf_goods.artic      = buf_doc-line.artic
     6285                  and buf_goods.prod-type  = buf_doc-line.prod-type
     6286                  and buf_goods.prod-code  = buf_doc-line.prod-code
     6287           .
     6288           find first buf_units no-lock
     6289                where buf_units.unit-name = buf_goods.unit-base
     6290           .
     6291           assign
     6292               v-gds-name  = buf_goods.gds-name
     6293               v-unit-name = buf_units.unit-name
     6294           .
     6295           for each tt-clcparts
     6296           on error undo, return error
     6297           :
     6298               delete tt-clcparts.
     6299           end.
     6300           for each buf_parts no-lock
     6301              where buf_parts.out-code   = buf_trn-doc.doc-code
     6302                and buf_parts.obj-type   = buf_trn-doc.obj-type
     6303                and buf_parts.obj-code   = buf_trn-doc.obj-code
     6304                and buf_parts.prod-type  = buf_doc-line.prod-type
     6305                and buf_parts.prod-code  = buf_doc-line.prod-code
     6306                and buf_parts.artic      = buf_doc-line.artic
     6307           on error undo, return error return-value
     6308           :
     6309               create tt-clcparts.
     6310               buffer-copy buf_parts to tt-clcparts.
     6311               run clcprtsl_calc-parts in this-procedure (
     6312                     input recid( tt-clcparts )
     6313                   , input no
     6314                   , input no
     6315                   , input 0
     6316                   , input 0
     6317                   , input 0
     6318                   , input 0
     6319                   , input 0
     6320                   , input 0
     6321                   , input 0
     6322                   , input "":U
     6323                   , input 0
     6324                   , input 0
     6325                   , input 0
     6326                   , input 0
     6327                   , input 0
     6328                   , input 0
     6329               ).
     6330               find first tt-allsum
     6331                    where tt-allsum.sum-type = 'основная_сумма':U
     6332               .
     6333               assign
     6334                   v-price     = ( if printrubl = yes then buf_parts.price-rubl else buf_parts.price-base )
     6335                   v-qnty-supp = buf_parts.qnty
     6336                   v-qnty-fact = buf_parts.fact-qnty
     6337               .
     6338               assign
     6339                   v-price-NoVAT         = v-price               - v-price * buf_parts.VAT-pc / ( 100 + buf_parts.VAT-pc )
     6340                   v-sum-PlaceAmountSupp = v-sum-PlaceAmountSupp + v-qnty-supp
     6341                   v-sum-SumSupp         = v-sum-SumSupp         + ( v-qnty-supp * v-price-NoVAT )
     6342                   v-sum-PlaceAmountFact = v-sum-PlaceAmountFact + v-qnty-fact
     6343                   v-sum-SumFact         = v-sum-SumFact         + ( v-qnty-fact * v-price-NoVAT )
     6344                   v-sum-sum             = v-sum-sum             + ( v-qnty-fact * v-price )
     6345                   v-sum-VATsum          = v-sum-VATsum          + ( buf_parts.VAT-pc / 100 * v-qnty-fact * v-price-NoVAT )
     6346                   v-sum-PlaceAmountDelt = v-sum-PlaceAmountDelt + ( v-qnty-fact - v-qnty-supp )
     6347                   v-sum-SumDelt         = v-sum-SumDelt         + ( ( v-qnty-fact - v-qnty-supp ) * v-price-NoVAT )
     6348               .
     6349               find first itog-vat
     6350               where itog-vat.vat-pc = integer(buf_parts.VAT-pc)
     6351               no-error.
     6352               if not available itog-vat then do :
     6353                   create itog-vat.
     6354                   assign
     6355                   itog-vat.VAT-pc = integer(buf_parts.VAT-pc)
     6356                   .
     6357               end.
     6358               assign
     6359                   itog-vat.name            = "Итого по ставке " + string( itog-vat.VAT-pc ) + "%"
     6360                   itog-vat.PlaceAmountSupp = itog-vat.PlaceAmountSupp   + v-qnty-supp
     6361                   itog-vat.SumSupp         = itog-vat.SumSupp           + v-qnty-supp * v-price-NoVAT
     6362                   itog-vat.PlaceAmountFact = itog-vat.PlaceAmountFact   + v-qnty-fact
     6363                   itog-vat.SumFact         = itog-vat.SumFact           + v-qnty-fact * v-price-NoVAT
     6364                   itog-vat.sum             = itog-vat.sum               + v-qnty-fact * v-price
     6365                   itog-vat.VATsum          = itog-vat.VATsum            + buf_parts.VAT-pc / 100 * v-qnty-fact * v-price-NoVAT
     6366                   itog-vat.PlaceAmountDelt = itog-vat.PlaceAmountDelt   + v-qnty-fact - v-qnty-supp
     6367                   itog-vat.SumDelt         = itog-vat.SumDelt           + ( v-qnty-fact - v-qnty-supp ) * v-price-NoVAT
     6368               .
     6369               run tg84xl-write-line-data in this-procedure (
     6370                     input v-gds-name
     6371                   , input v-unit-name
     6372                   , input v-price-NoVAT
     6373                   , input v-qnty-supp
     6374                   , input v-qnty-supp * v-price-NoVAT
     6375                   , input v-qnty-fact
     6376                   , input v-qnty-fact * v-price-NoVAT
     6377                   , input v-qnty-fact * v-price
     6378                   , input itog-vat.VAT-pc
     6379                   , input itog-vat.VAT-pc / 100 * v-qnty-fact * v-price-NoVAT
     6380                   , input v-qnty-fact - v-qnty-supp
     6381                   , input ( v-qnty-fact - v-qnty-supp ) * v-price-NoVAT
     6382               ).
     6383           end.
     6384       end.
     6385       run tg84xl-write-cell-data in this-procedure (
     6386             input "it_PlaceAmountSupp":U
     6387           , input v-sum-PlaceAmountSupp
     6388       ).
     6389       run tg84xl-write-cell-data in this-procedure (
     6390             input "it_SumSupp":U
     6391           , input v-sum-SumSupp
     6392       ).
     6393       run tg84xl-write-cell-data in this-procedure (
     6394             input "it_PlaceAmountFact":U
     6395           , input v-sum-PlaceAmountFact
     6396       ).
     6397       run tg84xl-write-cell-data in this-procedure (
     6398             input "it_SumFact":U
     6399           , input v-sum-SumFact
     6400       ).
     6401       run tg84xl-write-cell-data in this-procedure (
     6402             input "it_sum":U
     6403           , input v-sum-sum
     6404       ).
     6405       run tg84xl-write-cell-data in this-procedure (
     6406             input "it_VATsum":U
     6407           , input v-sum-VATsum
     6408       ).
     6409       run tg84xl-write-cell-data in this-procedure (
     6410             input "it_PlaceAmountDelt":U
     6411           , input v-sum-PlaceAmountDelt
     6412       ).
     6413       run tg84xl-write-cell-data in this-procedure (
     6414             input "it_SumDelt":U
     6415           , input v-sum-SumDelt
     6416       ).
     6417       for each itog-vat no-lock by itog-vat.vat-pc :
     6418           run tg84xl-write-line-data in this-procedure (
     6419                 input itog-vat.name
     6420               , input ""
     6421               , input ""
     6422               , input itog-vat.PlaceAmountSupp
     6423               , input itog-vat.SumSupp
     6424               , input itog-vat.PlaceAmountFact
     6425               , input itog-vat.SumFact
     6426               , input itog-vat.sum
     6427               , input itog-vat.VAT-pc
     6428               , input itog-vat.VATsum
     6429               , input itog-vat.PlaceAmountDelt
     6430               , input itog-vat.SumDelt
     6431           ).
     6432       end.
     6433       run tg84xl-close in this-procedure .
     6434   if g#quest-print = false
     6435   then do:
     6436     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     6437                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     6438                                         OUTPUT g#log ).
     6439   end.
     6440   else do:
     6441     os-command silent
     6442       value( "COPY /b " +
     6443         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6444         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6445         string( session:temp-directory) +  "$" + string( g#report-num )
     6446                 ) .
     6447     os-command silent
     6448       value( "COPY /b " +
     6449         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     6450         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6451         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6452                 ) .
     6453   end.
     6454   if session :set-wait-state( "" ) then.
     6455   end.
