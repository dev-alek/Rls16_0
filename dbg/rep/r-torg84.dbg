     5272   procedure clcprtsl_calc-line :
     5273   define input  parameter parrec-line as recid no-undo.
     5274   define variable v-tax-date         as   date                     no-undo.
     5275   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     5276   define variable varr-b             as   character                no-undo.
     5277   define variable varr-btype         as   character                no-undo.
     5278   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     5279   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     5280   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     5281   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     5282   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     5283   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     5284   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     5285   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5286   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5287   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5288   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5289   define variable varexcise          like ub.price-list.excise     no-undo.
     5290   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5291   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5292   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5293   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5294   define variable v-varsum           as decimal                  no-undo.
     5295   define variable varprice-salef as decimal   no-undo .
     5296   define buffer bf_trn-doc             for ub.trn-doc.
     5297   define buffer bf_doc-line            for ub.doc-line.
     5298   define buffer bf_gds-dtl             for ub.gds-dtl.
     5299   define buffer bf_goods               for ub.goods.
     5300   define buffer bf_parts               for ub.parts.
     5301   define buffer bf_sysconf             for ub.sysconf.
     5302   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5303   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5304   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5305   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5306   define buffer buf_parts        for ub.parts.
     5307   v-calcbypart = no.
     5308   do on error undo, return error return-value :
     5309   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5311     (output varr-b
     5312     )  .
     5313     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5314     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5315     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5316                               bf_goods.prod-type = bf_doc-line.prod-type and
     5317                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5318     if bf_trn-doc.fact-date <> ?        then do:
     5319       assign v-tax-date = bf_trn-doc.fact-date.
     5320     end.
     5321     else do:
     5322       assign v-tax-date = ?.
     5323     end.
     5324   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5325   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5326     (input  bf_goods.gds-code
     5327     ,input  '1':U
     5328     ,input  v-tax-date
     5329     ,input  bf_trn-doc.host-code
     5330     ,input  bf_trn-doc.obj-type
     5331     ,input  bf_trn-doc.obj-code
     5332     ,output v-vat-pc
     5333     ) no-error .
     5334     if error-status :error
     5335     or v-vat-pc = ? then do:
     5336        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5337     end.
     5338     if bf_goods.gds-type = 'у':U or
     5339        bf_trn-doc.status_ = 'запрос':U then do:
     5340       for each bf_tt-allsum-line
     5341       on error undo, return error return-value
     5342        :
     5343         delete bf_tt-allsum-line.
     5344       end.
     5345       create bf_tt-allsum-line.
     5346       assign
     5347        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5348       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5349                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5350                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5351                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5352         assign
     5353           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5354           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5355           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5356           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5357           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5358           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5359           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5360           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5361           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5362           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5363           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5364           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5365           bf_tt-allsum-line.vat-cli-acc          =  ?
     5366           .
     5367       end.
     5368       assign
     5369         bf_tt-allsum-line.cli-qnty             =  ?
     5370         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5371         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5372         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5373         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5374         bf_tt-allsum-line.road-tax-base-doc    =  0
