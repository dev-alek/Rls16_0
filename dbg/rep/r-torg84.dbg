     5081       bfpc_tt-allsum.other-rubl-acc      = 0
     5082       bfpc_tt-allsum.other-cli-acc       = 0
     5083       .
     5084     assign
     5085       bfspc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
