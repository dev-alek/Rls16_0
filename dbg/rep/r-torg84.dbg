     4970       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     4971       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     4972       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     4973       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     4974       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     4975       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     4976       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     4977       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     4978       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     4979       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     4980       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     4981       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     4982       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     4983       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     4984       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     4985       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     4986       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     4987       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     4988       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     4989       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     4990       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     4991       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     4992       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     4993       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     4994       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     4995       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     4996       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     4997       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     4998       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     4999   end.
     5000   create bfpc_tt-allsum.
     5001   create bfspc_tt-allsum.
     5002   case cl_tt-clcparts.purch-code :
     5003   when 1           then do:
     5004     assign
     5005       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     5006       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     5007     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     5008     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     5009   end.
     5010   when 4    then do:
     5011     assign
     5012       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     5013       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     5014     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     5015     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     5016   end.
     5017   when 3 then do:
     5018     assign
     5019       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     5020       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     5021     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     5022     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     5023   end.
     5024   when 2 then do:
     5025     assign
     5026       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     5027       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     5028     assign
     5029       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     5030       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     5031       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     5032       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
     5033       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     5034       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     5035       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     5036       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
     5037       bfpc_tt-allsum.vat-base-buyer-doc  = bf_tt-allsum.vat-base-buyer-doc  - bf_tt-allsum.vat-base-acc
     5038       bfpc_tt-allsum.vat-rubl-buyer-doc  = bf_tt-allsum.vat-rubl-buyer-doc  - bf_tt-allsum.vat-rubl-acc
     5039       bfpc_tt-allsum.slt-base-doc        = bf_tt-allsum.slt-base-doc        - bf_tt-allsum.slt-base-acc
     5040       bfpc_tt-allsum.slt-rubl-doc        = bf_tt-allsum.slt-rubl-doc        - bf_tt-allsum.slt-rubl-acc
     5041       bfpc_tt-allsum.road-tax-base-doc   = bf_tt-allsum.road-tax-base-doc   - bf_tt-allsum.road-tax-base-acc
     5042       bfpc_tt-allsum.road-tax-rubl-doc   = bf_tt-allsum.road-tax-rubl-doc   - bf_tt-allsum.road-tax-rubl-acc
     5043       bfpc_tt-allsum.excise-base-doc     = bf_tt-allsum.excise-base-doc
     5044       bfpc_tt-allsum.excise-rubl-doc     = bf_tt-allsum.excise-rubl-doc
     5045       bfpc_tt-allsum.sum-dsc-base-cur    = bf_tt-allsum.sum-dsc-base-cur    - bf_tt-allsum.sum-dsc-base-acc
     5046       bfpc_tt-allsum.sum-dsc-rubl-cur    = bf_tt-allsum.sum-dsc-rubl-cur    - bf_tt-allsum.sum-dsc-rubl-acc
     5047       bfpc_tt-allsum.dsc-base-cur        = bf_tt-allsum.dsc-base-cur        - bf_tt-allsum.dsc-base-acc
