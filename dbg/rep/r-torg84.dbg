      687   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      688   procedure wthcattr-sprcli :
      689   define input parameter parparentproc  as widget-handle no-undo.
      690   define input parameter p-mode  as character no-undo.
      691   define input-output parameter p-value as character no-undo .
      692   define output parameter p-setted as logical no-undo .
      693     DEFINE VARIABLE v-value as character no-undo .
      694     define variable v-cli-type as character no-undo .
      695     define variable v-cli-code as integer no-undo .
      696     define buffer buf_clients   for ub.clients.
      697     define variable v_rid as character no-undo.
      698     define variable ref-rec as recid no-undo .
      699     do
      700     on error undo, return error
      701     :
      702         v-value = p-value.
      703      if p-value <> '':U then do:
      704       assign
      705       v-cli-type = substring(p-value, 1, 3)
      706       v-cli-code = integer(substring(p-value, 4))
      707       no-error.
      708       if error-status:error then do:
      709         assign
      710         v-cli-type = '':U
      711         v-cli-code = 0
      712         .
      713       end.
      714      end.
      715      FIND FIRST buf_clients NO-LOCK WHERE
      716               buf_clients.obj-type = v-cli-type AND
      717               buf_clients.obj-code = v-cli-code  NO-ERROR.
      718      IF available(buf_clients) then do:
      719       run ref/cli-all.w (
      720                   input parparentproc
      721                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      722                  ,input v-cli-type
      723                  ,input 'все':U
      724                  ,input 'все':U
      725                  ,input RECID( buf_clients )
      726                  ,input ",,,,,,NO"
      727                  ,input ?
      728                  ,OUTPUT v_rid ).
      729     END.
      730     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      731       run ref/cli-all.w (
      732                    input parparentproc
      733                   ,INPUT "b-sel":U
      734                  ,input  v-cli-type
      735                  ,input 'все':U
      736                  ,input 'текущие':U
      737                  ,input ?
      738                  ,input ",,,,,,NO"
      739                  ,input ?
      740                  ,OUTPUT v_rid ).
      741     END.
      742     else do:
      743       message
      744       if p-value = "":U then 'Атрибут не задан!'
      745       else substitute('Не найден клиент &1',p-value)
      746       view-as alert-box warning.
      747     end.
      748     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      749       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      750       IF ERROR-STATUS:ERROR THEN DO:
      751           RETURN NO-APPLY.
      752       END.
      753       FIND FIRST buf_clients NO-LOCK WHERE
      754                  RECID( buf_clients ) = ref-rec NO-ERROR.
      755       IF AVAIL buf_clients THEN DO:
      756         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      757       end.
      758     end.
      759     if v-value <> p-value then do:
      760       p-value = v-value.
      761       p-setted = yes.
      762     end.
      763     end.
      764   end procedure.
      765     define new global shared variable g#wthcalib as handle no-undo.
      766   procedure torgconf-read :
      767   do
      768   on error undo, return error
      769   :
      770       define input parameter p-form-name  as character    no-undo.
      771       define input parameter p-host-code  as integer      no-undo.
      772       define input parameter p-obj-type   as character    no-undo.
      773       define input parameter p-obj-code   as integer      no-undo.
      774       define variable v-outdate   as character     no-undo.
      775       define variable v-outares   as character     no-undo.
      776       define variable v-outsend   as character     no-undo.
      777       define variable v-outasend  as character     no-undo.
      778       define variable v-outprops  as character     no-undo.
      779       define variable v-outnum    as character     no-undo.
      780       define variable v-outprim   as character     no-undo.
      781       define variable v-outdisc   as character     no-undo.
      782       define variable v-outsubs   as character     no-undo.
      783       define variable v-outrecv   as character     no-undo.
      784       define variable v-outegrp   as character     no-undo.
      785       define variable v-outt12    as character     no-undo.
      786       define variable v-outappr   as character     no-undo.
      787       define variable v-outrubl   as character     no-undo.
      788       define variable v-outhold   as character     no-undo.
      789       define variable v-outobj    as character     no-undo.
      790       define variable v-outexlst  as character     no-undo.
      791       define variable v-outprncd  as character     no-undo.
      792       define variable v-par-type  as character     no-undo.
      793       define variable v-outogr    as character     no-undo.
      794       define variable v-outR      as character     no-undo.
      795       define variable v-outB      as character     no-undo.
      796       define variable v-outC      as character     no-undo.
      797       assign
      798           v-torgconf-outdate  = no
      799           v-torgconf-outnum   = no
      800           v-torgconf-outprim  = no
      801           v-torgconf-outdisc  = no
      802           v-torgconf-outsubs  = no
      803           v-torgconf-outrecv  = no
      804           v-torgconf-outegrp  = no
      805           v-torgconf-outt12   = no
      806           v-torgconf-outappr  = no
      807           v-torgconf-outrubl  = no
      808           v-torgconf-outhold  = no
      809           v-torgconf-outobj   = no
      810           v-torgconf-outexlst = no
      811           v-torgconf-outexpas = "":U
      812           v-torgconf-outprncd = yes
      813           v-torgconf-outares  = no
      814           v-torgconf-outsend  = no
      815           v-torgconf-outasend  = no
      816           v-torgconf-outprops  = no
      817           v-form-name          = p-form-name
      818       .
      819   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   empty temp-table thbjattr_thbj-attr.
      821   run adm/shattri.p (
      822      input "get":U
      823     ,input ''
      824     ,input 0
      825     ,input 'prt-glob':U
      826     ,input  ""
      827     ,output v-value-character
      828     ,output v-value-date
      829     ,output v-value-decimal
      830     ,output v-value-integer
      831     ,output v-value-logical
      832     ,output par-type
      833     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      834     ) no-error .
      835   for each thbjattr_thbj-attr :
      836       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
      837       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
      838       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
      839   end.
      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   empty temp-table thbjattr_thbj-attr.
      842   run adm/shattri.p (
      843      input "get":U
      844     ,input p-obj-type
      845     ,input p-obj-code
      846     ,input 'prt-obj':U
      847     ,input  ""
      848     ,output v-value-character
      849     ,output v-value-date
      850     ,output v-value-decimal
      851     ,output v-value-integer
      852     ,output v-value-logical
      853     ,output par-type
      854     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      855     ) no-error .
      856   for each thbjattr_thbj-attr :
      857       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
      858       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
      859       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
      860       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
      861       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
      862       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
      863       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
      864       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
      865       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
      866       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
      867       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
      868       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
      869       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
      870       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
      871       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
      872       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
      873       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
      874       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
      875       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
      876   end.
      877       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
      878       if error-status :error
      879       then do:
      880           assign
      881               v-torgconf-outexpas = "":U
      882           .
      883       end.
      884       assign
      885           v-torgconf-outprncd = ( v-outprncd = "yes":U )
      886       .
      887       if p-form-name <> ""
      888       and p-form-name <> ?
      889       then do:
      890           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
