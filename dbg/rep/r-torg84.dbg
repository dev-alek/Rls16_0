      954                   v-torgconf-outappr   = yes
      955               .
      956           end.
      957           if lookup( p-form-name, v-outrubl  ) <> 0
      958           then do:
      959               assign
      960                   v-torgconf-outrubl   = yes
      961               .
      962           end.
      963           if lookup( p-form-name, v-outhold  ) <> 0
      964           then do:
