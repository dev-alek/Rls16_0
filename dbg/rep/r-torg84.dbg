     3428   procedure torgconf-get-reason  :
     3429   define input parameter  p-doc-code       as character        no-undo.
     3430   define input parameter  p-reason-code    as integer          no-undo .
     3431   define input parameter  p-doc-type       as character        no-undo.
     3432       if p-reason-code > 0
     3433       then do:
     3434           define buffer buf_trn-reason for ub.trn-reason.
     3435           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3436           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3437       end.
     3438       else do:
     3439           if p-doc-type = 'при':U
     3440           then  do:
     3441               define variable v-attr-type     as character    no-undo.
     3442               define variable v-attr-value    as character    no-undo.
     3443               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3444               assign v-torgconf-reason = v-attr-value .
     3445               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3446               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3447           end.
     3448       end.
     3449   end procedure.
