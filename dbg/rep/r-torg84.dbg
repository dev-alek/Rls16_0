     4963       bfs_tt-allsum.dsc-base-cur        =  - bf_tt-allsum.dsc-base-cur
     4964       bfs_tt-allsum.dsc-rubl-cur        =  - bf_tt-allsum.dsc-rubl-cur
     4965       bfs_tt-allsum.vat-base-cur        =  - bf_tt-allsum.vat-base-cur
     4966       bfs_tt-allsum.vat-rubl-cur        =  - bf_tt-allsum.vat-rubl-cur
     4967       bfs_tt-allsum.vat-base-buyer-cur  =  - bf_tt-allsum.vat-base-buyer-cur
     4968       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
