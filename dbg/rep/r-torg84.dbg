     5554     (input  bf_goods.gds-code
     5555     ,input  bf_gds-dtl.prt-code
     5556     ,output varb-code
     5557     ) no-error .
     5558   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5560     (input  bf_trn-doc.obj-type
     5561     ,input  bf_trn-doc.obj-code
     5562     ,input  varb-code
     5563     ,input  0
     5564     ,input  bf_trn-doc.fact-order
     5565     ,output vardoc-num
     5566     ,output varprice-sale
     5567     ,output varroad-tax
     5568     ,output varexcise
     5569     )  .
     5570             if varprice-sale = ?
     5571             then do:
     5572               assign
     5573                 varprice-sale = 0
     5574                 varroad-tax   = 0
     5575                 varexcise     = 0
     5576               .
     5577             end.
     5578             assign
     5579               varlastcur-base     = varprice-sale
     5580               varlastcur-road-tax = varroad-tax
     5581               varlastcur-excise   = varexcise
     5582               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5583               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5584               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5585               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5586             .
     5587         end.
     5588       end.
     5589       if varcur-fact-qnty = 0 then do:
     5590         assign
     5591           varcur-base      = varlastcur-base
     5592           varcur-road-tax  = varlastcur-road-tax
     5593           varcur-excise    = varlastcur-excise
     5594         .
     5595       end.
     5596       else do:
     5597         assign
     5598           varcur-base      = varcur-base      / varcur-fact-qnty
     5599           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5600           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5601         .
     5602       end.
     5603       if varcur-vat-pc = ?
     5604       then do:
     5605         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5606       end.
     5607       if varcur-slt-pc = ?
     5608       then do:
     5609         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5610       end.
     5611       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5612       assign
     5613         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5614       if varcur-cons-vat-pc = ? then do:
     5615         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     5616       end.
     5617       define buffer buf_tt-clcparts for tt-clcparts .
     5618       for each buf_tt-clcparts
     5619       on error undo, return error return-value
     5620       :
     5621         delete buf_tt-clcparts.
     5622       end.
     5623       for each bf_parts no-lock
     5624         where bf_parts.out-code  = bf_doc-line.doc-code
     5625           and bf_parts.obj-type  = bf_doc-line.obj-type
     5626           and bf_parts.obj-code  = bf_doc-line.obj-code
     5627           and bf_parts.artic     = bf_doc-line.artic
     5628           and bf_parts.prod-type = bf_doc-line.prod-type
     5629           and bf_parts.prod-code = bf_doc-line.prod-code
     5630       on error undo, return error return-value
     5631       :
     5632         create buf_tt-clcparts .
     5633         buffer-copy bf_parts to buf_tt-clcparts .
     5634         if v-calcbypart = yes   then do:
     5635   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     5636     (buffer bf_parts
     5637     ,output v-b-pcode
     5638     ) no-error .
     5639   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5641     (input  bf_parts.obj-type
     5642     ,input  bf_parts.obj-code
     5643     ,input  v-b-pcode
     5644     ,input  0
     5645     ,input  bf_trn-doc.fact-order
     5646     ,output vardoc-num
     5647     ,output varprice-salef
     5648     ,output varroad-tax
     5649     ,output varexcise
     5650     ) no-error .
     5651             if varprice-sale = ?
     5652             then do:
     5653               assign
     5654                 varprice-salef = 0
     5655                 varroad-tax   = 0
     5656                 varexcise     = 0
     5657               .
     5658             end.
     5659             assign
     5660             part-cur-base  = varprice-salef
     5661             part-cur-road-tax  = varroad-tax
     5662             part-cur-excise = varexcise.
     5663         end.
     5664       end.
     5665       run clcprtsl_calc-ttable in this-procedure
     5666         (input yes,
     5667          input yes,
     5668          input bf_doc-line.road-tax,
     5669          input bf_doc-line.excise,
     5670          input bf_doc-line.vat-pc,
     5671          input bf_doc-line.cons-vat-pc,
     5672          input bf_doc-line.slt-pc,
     5673          input bf_trn-doc.base-rate,
     5674          input bf_trn-doc.base-scale,
     5675          input varr-b,
     5676          input varcur-base,
     5677          input varcur-road-tax,
     5678          input varcur-excise,
     5679          input varcur-vat-pc,
     5680          input varcur-cons-vat-pc,
     5681          input varcur-slt-pc
     5682          ) no-error.
     5683       if error-status:error then do:
     5684         message
     5685           vss-workfile vss-revision vss-description skip
     5686           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5687           return-value skip
     5688           trim(error-status :get-message(1))
     5689           trim(error-status :get-message(2))
     5690           trim(error-status :get-message(3))
     5691           trim(error-status :get-message(4))
     5692           trim(error-status :get-message(5)) skip
     5693           view-as alert-box error.
     5694         undo, return error .
     5695       end.
     5696     end.
     5697   end.
     5698   end.
     5699   procedure clcprtsl_calc-ttable :
     5700   define input parameter paris-doc           as   logical                 no-undo.
     5701   define input parameter paris-cur           as   logical                 no-undo.
     5702   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5703   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5704   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5705   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5706   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5707   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5708   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5709   define input parameter parr-b              as   character               no-undo.
     5710   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5711   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5712   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5713   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5714   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5715   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5716   define buffer bf_tt-allsum      for tt-allsum.
     5717   define buffer bf_tt-clcparts    for tt-clcparts.
     5718   define buffer bf_tt-allsum-line for tt-allsum-line.
     5719   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5720   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5721   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5722   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5723   define variable varexcise          like ub.price-list.excise     no-undo.
     5724   do on error undo, return error return-value :
     5725   for each bf_tt-allsum-line
     5726   on error undo, return error return-value
     5727    :
     5728     delete bf_tt-allsum-line.
     5729   end.
     5730   for each bf_tt-allsum
     5731   on error undo, return error return-value
     5732   :
     5733     delete bf_tt-allsum.
     5734   end.
     5735   for each bf_tt-clcparts
     5736   on error undo, return error return-value
     5737   :
     5738   if v-calcbypart then do:
     5739             assign
     5740             parcur-base =   bf_tt-clcparts.part-cur-base
     5741             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5742             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5743             .
     5744   end.
     5745      run clcprtsl_calc-parts in this-procedure (
     5746        input recid(bf_tt-clcparts),
     5747        input paris-doc,
     5748        input paris-cur,
     5749        input parroad-tax,
     5750        input parexcise,
     5751        input parvat-pc,
     5752        input parcons-vat-pc,
     5753        input parslt-pc,
     5754        input parbase-rate,
     5755        input parbase-scale,
     5756        input parr-b,
     5757        input parcur-base,
     5758        input parcur-road-tax,
     5759        input parcur-excise,
     5760        input parcur-vat-pc,
     5761        input parcurcons-vat-pc,
     5762        input parcurslt-pc
     5763        ) no-error.
     5764     if error-status:error then do:
     5765       message
     5766         vss-workfile vss-revision vss-description skip
     5767         vss-include-info16 skip
     5768         "Ошибка при обсчете партии" skip
     5769         "Документ партии " bf_tt-clcparts.out-code skip
     5770         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5771         return-value skip
     5772         error-status:get-message(1) skip
     5773         error-status:get-message(2) skip
     5774         error-status:get-message(3) skip
     5775         view-as alert-box error .
     5776       undo, return error .
     5777     end.
     5778     for each bf_tt-allsum on error undo, return error return-value :
     5779       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5780       if not available bf_tt-allsum-line then do:
     5781         create bf_tt-allsum-line.
     5782         assign
     5783           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     5784       end.
