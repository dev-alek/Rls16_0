      772   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      773     if num-entries(string(p-dec), '.') = 2
      774       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      775       else return( string(p-dec)) .
      776   end function.
      777   function format-point-to-comma returns char (input orig as char ) .
      778   define variable rtext as character no-undo .
      779   define variable strt as integer no-undo .
      780   define variable leng as integer no-undo .
      781   assign rtext = orig .
      782   repeat:
      783     strt =  index(rtext,'.').
      784     if strt = 0 then leave.
      785     leng = 1.
      786     substring(rtext,strt,leng,"character") = v-delim .
      787   end.
      788   return rtext.
      789   end function.
      790   function format-excel-text returns char ( input start-text as char ) :
      791   def var  i    as int no-undo.
      792   def var  ch   as char no-undo.
      793   def var  n    as int no-undo.
      794   def var  ipos as int no-undo.
      795     n = num-entries(trim(start-text), chr(10)) - 1 .
      796     do i = 1 to n :
      797       ipos = index( start-text, chr(10)).
      798       if ipos > 0 then
      799         substr( start-text, ipos, 1 ) = ' '.
      800     end.
      801     n = num-entries(trim(start-text), chr(13)) - 1 .
      802     do i = 1 to n :
      803       ipos = index( start-text, chr(13)).
      804       if ipos > 0 then
      805         substr( start-text, ipos, 1 ) = ' '.
      806     end.
      807     if index( start-text, '"' ) = 0 then
      808       start-text =  '="'   + trim( start-text) + '"'   .
      809       else do:
      810         n = num-entries(trim(start-text), '"') - 1.
      811         do i = 1 to n :
      812           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      813         end.
      814         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      815         start-text = '="'  + ch  + '"' .
      816       end.
      817     return start-text.
      818   end.
      819   function excel-sum returns char (input p-dec as decimal ).
      820     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      821   end function.
      822   function excel-qnty returns char (input p-dec as decimal ).
      823     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      824   end function.
      825   function format-excel-text-macr returns char ( input start-text as char ) :
      826   def var  i    as int no-undo.
      827   def var  ch   as char no-undo.
      828   def var  n    as int no-undo.
      829   def var  ipos as int no-undo.
      830     n = num-entries(trim(start-text), chr(10)) - 1 .
      831     do i = 1 to n :
      832       ipos = index( start-text, chr(10)).
      833       if ipos > 0 then
      834         substring( start-text, ipos , 1 ) = ' '.
      835     end.
      836     n = num-entries(trim(start-text), chr(13)) - 1 .
      837     do i = 1 to n :
      838       ipos = index( start-text, chr(13)).
      839       if ipos > 0 then
      840         substring( start-text, ipos, 1 ) = ' '.
      841     end.
      842     if index( start-text, '"' ) = 0 then
      843       start-text =  '"'   + trim( start-text) + '"'   .
      844       else do:
      845         n = num-entries(trim(start-text), '"') - 1.
      846         do i = 1 to n :
      847           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      848         end.
      849         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      850         start-text = '"'  + ch  + '"' .
      851       end.
      852     n = num-entries(trim(start-text), chr(10)) - 1 .
      853     do i = 1 to n :
      854       ipos = index( start-text, chr(10)).
      855       if ipos > 0 then
      856         substring( start-text, ipos , 1 ) = ' '.
      857     end.
      858       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      859     return start-text.
      860   end.
      861   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      862   procedure cur-time :
      863      define output parameter p-today as date      no-undo .
      864      define output parameter p-time  as integer   no-undo .
      865     do
      866     on error undo, return error
      867     :
      868       define variable v-date1 as date      no-undo .
      869       define variable v-date2 as date      no-undo .
      870       define variable v-time  as integer   no-undo .
      871       assign
      872         v-date1 = today
      873         v-time  = time
      874         v-date2 = today
      875       .
      876       if v-date1 <> v-date2
      877       then do:
      878         assign
      879           v-date1 = today
      880           v-time  = v-time
      881         .
      882       end.
      883       assign
      884         p-today = v-date1
      885         p-time  = v-time
      886       .
      887     end.
      888   end.
      889   function cur-time-date returns character
      890   :
      891     return string(today, '99/99/9999':U) .
      892   end.
      893   function cur-time-mjd returns decimal
      894   :
      895     define variable v-date as date      no-undo .
      896     define variable v-time as integer   no-undo .
      897     run cur-time in this-procedure
      898       (output v-date
      899       ,output v-time
      900       ) .
      901     return integer(v-date) - 2400002 + (v-time / 86400) .
      902   end.
      903   function cur-time-get-ending-index returns integer
      904   (input p-number as integer
      905   )
      906   :
      907     if p-number < 0
      908     or p-number = ?
      909     then do:
      910       return 1 .
      911     end.
      912     define variable v-rest as integer   no-undo .
      913     assign
      914       p-number = p-number modulo 100
      915     .
      916     if p-number < 20
      917     then do:
      918       assign
      919         v-rest = p-number
      920       .
      921     end.
      922     else do:
      923       assign
      924         v-rest = p-number modulo 10
      925       .
      926     end.
      927     case v-rest :
      928       when 1
      929       then do:
      930         return 2 .
      931       end.
      932       when 2 or
      933       when 3 or
      934       when 4
      935       then do:
      936         return 3 .
      937       end.
      938       otherwise do:
      939         return 1 .
      940       end.
      941     end case .
      942   end.
      943   procedure cur-time-mjd-to-date :
      944      define input  parameter i-mjd-diff as decimal no-undo.
      945      define output parameter o-Date     as date    no-undo.
      946      define output parameter o-Time     as integer no-undo.
      947      define variable v-day-number as integer   no-undo .
      948      if    i-mjd-diff < 0
      949         or i-mjd-diff = ?
      950      then do:
      951         return "?" .
      952      end.
      953      assign
      954         v-day-number = truncate(i-mjd-diff,0).
      955         o-Date = date(v-day-number + 2400002).
      956         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      957     .
      958   end.
      959   function cur-time-mjd-to-string returns character
      960   (input p-mjd-diff as decimal
      961   )
      962   :
      963     define variable v-day-number as integer   no-undo .
      964     define variable v-seconds    as integer   no-undo .
      965     define variable v-hour       as integer   no-undo .
      966     define variable v-min        as integer   no-undo .
      967     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      968     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      969     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      970     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      971     if p-mjd-diff < 0
      972     or p-mjd-diff = ?
      973     then do:
      974       return "?" .
      975     end.
      976     assign
      977       v-day-number = integer(truncate(p-mjd-diff,0))
      978       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      979     .
      980     if v-seconds > 86400
      981     then do:
      982       assign
      983         v-seconds = 86400 - 1
      984       .
      985     end.
      986     if v-seconds < 0
      987     then do:
      988       assign
      989         v-seconds = 0
      990       .
      991     end.
      992     assign
      993       v-hour = truncate(v-seconds / 3600, 0)
      994     .
      995     assign
      996       v-seconds = v-seconds modulo 3600
      997     .
      998     assign
      999       v-min = truncate(v-seconds / 60, 0)
     1000     .
     1001     assign
     1002       v-seconds = v-seconds modulo 60
     1003     .
     1004     return
     1005         (if v-day-number <> 0
     1006           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1007           else ""
     1008         )
     1009       + (if v-day-number <> 0 or v-hour <> 0
     1010           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1011           else ""
     1012         )
     1013       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1014           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1015           else ""
     1016         )
     1017       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1018       .
     1019   end.
     1020   function cur-time-string returns character
     1021   :
     1022     define variable v-date as date      no-undo .
     1023     define variable v-time as integer   no-undo .
     1024     run cur-time in this-procedure
     1025       (output v-date
     1026       ,output v-time
     1027       ) .
     1028     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1029   end.
     1030   function cur-time-string-sec returns character
     1031   :
     1032     define variable v-date as date      no-undo .
     1033     define variable v-time as integer   no-undo .
     1034     run cur-time in this-procedure
     1035       (output v-date
     1036       ,output v-time
     1037       ) .
     1038     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1039   end.
     1040   function cur-time-custom  returns character
     1041   (input p-prefix as character
     1042   ,input p-date-format as character
     1043   ,input p-delimiter as character
     1044   ,input p-time-format as character
     1045   ,input p-suffix as character
     1046   )
     1047   :
     1048     define variable v-date as date      no-undo .
     1049     define variable v-time as integer   no-undo .
     1050     run cur-time in this-procedure
     1051       (output v-date
     1052       ,output v-time
     1053       ) .
     1054     return
     1055       p-prefix
     1056       + string(v-date, p-date-format)
     1057       + p-delimiter
     1058       + string(v-time, p-time-format)
     1059       + p-suffix
     1060       .
     1061   end.
     1062   function cur-time-print  returns character
     1063   :
     1064     define variable v-date as date      no-undo .
     1065     define variable v-time as integer   no-undo .
     1066     run cur-time in this-procedure
     1067       (output v-date
     1068       ,output v-time
     1069       ) .
     1070     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1071   end.
     1072   function cur-time-datetime returns datetime
     1073   :
     1074     define variable v-char as character no-undo .
     1075     define variable v-datetime as datetime no-undo .
     1076     v-char = cur-time-string().
     1077     v-datetime = datetime(v-char).
     1078     return  v-datetime.
     1079   end.
     1080   function cur-time-string-msec returns character
     1081   :
     1082     define variable v-date as datetime  no-undo .
     1083     v-date = now.
     1084     return string(v-date) .
     1085   end.
     1086   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1087   define variable v-waitfram-action01         as character   no-undo .
     1088   define variable v-waitfram-action02         as character   no-undo .
     1089   define variable v-waitfram-action03         as character   no-undo .
     1090   define variable mWaitFramTextBeg            as character   no-undo.
     1091   define variable mWaitFramTextEnd            as character   no-undo.
     1092   define variable mWaitFramView               as logical     no-undo.
     1093   define variable mWaitProcEvent              as logical     no-undo init yes.
     1094   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1095   define variable mWaitFramStop               as logical     no-undo.
     1096   define variable mWaitFramStopUser           as logical     no-undo.
     1097   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1098   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1099   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1100   define button B-WaitFramStop auto-end-key
     1101        label "Стоп"
     1102        size 10 by 1 tooltip "Остоновить процесс".
     1103   define button B-viewProcInfo
     1104        label "Информация"
     1105        size 15 by 1 tooltip "Информация о процесс".
     1106   define frame waitfram
     1107     v-waitfram-action01 format "x(72)" no-label skip
     1108     v-waitfram-action02 format "x(72)" no-label skip
     1109     v-waitfram-action03 format "x(72)" no-label skip
     1110     B-viewProcInfo
     1111     B-WaitFramStop at row 4 col 30
     1112     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1113     .
     1114   define new global shared variable mBatchMode as logical no-undo init ?.
     1115   define variable mFramBachModHandle as handle no-undo.
     1116   mFramBachModHandle = frame waitfram:handle.
     1117   define variable mFameOldVis as logical no-undo.
     1118   define variable mVisCUrentVin as logical no-undo.
     1119   if session:batch-mode
     1120   then
     1121      mBatchMode = yes.
     1122   if mBatchMode = ? then do:
     1123     mVisCUrentVin = current-window:visible.
     1124     mFameOldVis = mFramBachModHandle:visible.
     1125     mFramBachModHandle:visible  = yes.
     1126     mBatchMode = mFramBachModHandle:visible ne yes.
     1127     mFramBachModHandle:visible = mFameOldVis.
     1128     current-window:visible = mVisCUrentVin.
     1129   end.
     1130    if  log-manager:logfile-name ne ?
     1131     then DO:
     1132         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1133         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1134         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1135     end.
     1136   on choose of B-WaitFramStop in frame waitfram
     1137   do:
     1138     mWaitFramStop = yes.
     1139     mWaitFramStopUser = yes.
     1140   end.
     1141   function waitfram-check-timeout returns logical():
     1142      define variable vtime as int64 no-undo.
     1143      if mWaitFramStopTimeOut
     1144      then
     1145         return yes.
     1146      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1147      if     mWaitFramTimeOut ne ?
     1148         and mWaitFramTimeOut ne 0
     1149         and mWaitFramTimeOut lt vtime
     1150      then do:
     1151         mWaitFramStopTimeOut = yes.
     1152      end.
     1153      return mWaitFramStopTimeOut.
     1154   end.
     1155   procedure waitfram-hide :
     1156     if not session:batch-mode
     1157     then do
     1158     on error undo, return error return-value
     1159     :
     1160       pause 0 before-hide .
     1161       if not mBatchMode then
     1162         hide frame waitfram .
     1163     if     not mWaitFramView
     1164        and mWaitProcEvent
     1165     then
     1166       process events .
     1167     end.
     1168   end procedure.
     1169   procedure waitfram-show :
     1170     define input  parameter p-message as character no-undo .
     1171     define variable v-left-margin as integer   no-undo .
     1172     if not session:batch-mode
     1173     then do
     1174     on error undo, return error return-value
     1175     :
     1176       if length(p-message) <= 70 then do:
     1177         assign
     1178           v-left-margin = integer((70 - length(p-message)) / 2)
     1179         .
     1180         assign
     1181           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1182         .
     1183         assign
     1184           v-waitfram-action01 = " "
     1185           v-waitfram-action02 = " "
     1186                                    + fill(" ", v-left-margin)
     1187                                    + p-message
     1188           v-waitfram-action03 = " "
     1189         .
     1190       end.
     1191       else do:
     1192         define variable vRindex1 as integer no-undo.
     1193         define variable vRindex2 as integer no-undo.
     1194         vRindex1 = r-index(p-message," ",70).
     1195         if vRindex1 = 0
     1196         then
     1197            vRindex1 = 70.
     1198         if length(p-message)  <= vRindex1 + 70 then do:
     1199           assign
     1200             v-waitfram-action01 = " "
     1201             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1202             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1203           .
     1204         end.
     1205         else do:
     1206           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1207           if vRindex2 <= vRindex1
     1208           then
     1209              vRindex2 = vRindex1 + 70.
     1210           assign
     1211             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1212             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1213             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1214           .
     1215         end.
     1216       end.
     1217       B-viewProcInfo:visible   in frame waitfram = no.
     1218       B-viewProcInfo:sensitive in frame waitfram = no.
     1219       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1220       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1221       if  (   mWaitFramView
     1222          or  mWaitProcEvent)
     1223          and not mBatchMode
     1224       then
     1225          display
     1226             v-waitfram-action01 skip
     1227             v-waitfram-action02 skip
     1228             v-waitfram-action03 skip
     1229          with frame waitfram .
     1230       if     mWaitFramView
     1231          then do:
     1232             if     mWaitFramInterval ne ?
     1233                and not mBatchMode
     1234             then
     1235                wait-for go of frame waitfram pause mWaitFramInterval.
     1236          end.
     1237          else
     1238             if     mWaitProcEvent
     1239                and not mBatchMode
     1240             then
     1241                process events .
     1242     end.
     1243   end procedure.
     1244      procedure waitfram-show-this:
     1245         define input  parameter iInterval as int64 no-undo.
     1246         define variable vtime as int64 no-undo.
     1247         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1248         mWaitFramInterval = iInterval.
     1249         run waitfram-show (substitute("&1&2 &3&4" ,
     1250                                       mWaitFramTextBeg ,
     1251                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1252                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1253                                       mWaitFramTextEnd
     1254                                      )
     1255                           ).
     1256      end.
     1257      procedure WaitFramRunPause:
     1258         define input  parameter iInterval as dec no-undo.
     1259         define variable vStart  as datetime-tz no-undo.
     1260         define variable vend    as datetime-tz no-undo.
     1261         define variable vint as int64 no-undo.
     1262         define variable vOk as logical no-undo.
     1263         vStart = now.
     1264         vend   = vStart.
     1265         publish "WaitFramPause" (iInterval,output vOk).
     1266         vend   =  now.
     1267         vint = vend - vStart.
     1268         vint = iInterval - vint / 1000.
     1269         if     not mWaitFramStop
     1270            and (   vint > 0
     1271                 or (    not vOk
     1272                     and iInterval eq ?
     1273                     )
     1274                 )
     1275         then
     1276            run waitfram-show-this (iInterval).
     1277         vend   =  now.
     1278         vint = vend - vStart.
     1279         vint = iInterval - vint / 1000.
     1280         if     not mWaitFramStop
     1281            and vint > 0
     1282         then do:
     1283            run gbl/pause.p (vint * 1000).
     1284         end.
     1285         if iInterval ne ?
     1286         then
     1287            publish "WaitFramStop".
     1288         waitfram-check-timeout().
     1289      end.
     1290      procedure WaitFramWaitFor:
     1291         define input  parameter iInterval as dec no-undo.
     1292         assign
     1293            mWaitFramStartProc   = now
     1294            mWaitFramStopUser    = no
     1295            mWaitFramStopTimeOut = no
     1296         .
     1297         block-wait:
     1298         do while not mWaitFramStop:
     1299            run WaitFramRunPause (iInterval).
     1300            if  waitfram-check-timeout()
     1301            then do:
     1302               leave block-wait.
     1303            end.
     1304         end.
     1305         run waitfram-hide.
     1306      end.
     1307   procedure waitfram-join :
     1308     define input  parameter p-line-1  as character no-undo .
     1309     define input  parameter p-line-2  as character no-undo .
     1310     define input  parameter p-line-3  as character no-undo .
     1311     define output parameter p-message as character no-undo .
     1312     do
     1313     on error undo, return error return-value
     1314     :
     1315       assign
     1316         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1317                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1318                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1319       .
     1320     end.
     1321   end procedure.
     1322   function waitfram-join-function returns character
     1323     (input p-line-1 as character
     1324     ,input p-line-2 as character
     1325     ,input p-line-3 as character
     1326     ).
     1327     define variable v-message as character no-undo .
     1328     run waitfram-join in this-procedure
     1329       (input  p-line-1
     1330       ,input  p-line-2
     1331       ,input  p-line-3
     1332       ,output v-message
     1333       ) .
     1334     return v-message .
     1335   end function .
     1336   define temp-table temp-font no-undo
     1337     field fontnum  as integer
     1338     field fontname as character
     1339     field fontsize as character
     1340     field fonttype as character
     1341     field font-h   as integer
     1342     field font-w   as integer
     1343     field v-row    as integer
     1344     field v-col    as integer
     1345     field v-row-lans as integer
     1346     field v-col-lans as integer
     1347   index pi fontnum
     1348   .
     1349   procedure get-font-ini :
     1350     do
     1351     on error undo, return error return-value
     1352     :
     1353   define variable ii as integer   no-undo .
     1354   define variable v-font7 as character no-undo .
     1355   define variable v-font as character no-undo .
     1356   define variable loc-name as character no-undo .
     1357   define variable loc-size as character no-undo .
     1358   define variable loc-type as character no-undo .
     1359   define variable old_H as integer   no-undo .
     1360   define variable old_w as integer   no-undo .
     1361   define variable old-row  as integer   no-undo .
     1362   define variable old-col  as integer   no-undo .
     1363   define variable old-row-lans  as integer   no-undo .
     1364   define variable old-col-lans  as integer   no-undo .
     1365   define variable vv as integer   no-undo .
     1366   empty temp-table temp-font.
     1367     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1368       case num-entries (v-font7) :
     1369         when 4 then do:
     1370             assign
     1371               loc-name = entry ( 1 , v-font7 )
     1372               loc-size = entry ( 2 , v-font7 )
     1373               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1374             .
     1375         end.
     1376         when 3 then do:
     1377             assign
     1378               loc-name = entry ( 1 , v-font7 )
     1379               loc-size = entry ( 2 , v-font7 )
     1380               loc-type = entry ( 3 , v-font7 )
     1381             .
     1382         end.
     1383         when 2 then  do:
     1384             assign
     1385               loc-name = entry ( 1 , v-font7 )
     1386               loc-size = entry ( 2 , v-font7 )
     1387               loc-type = ""
     1388             .
     1389         end.
     1390         when 1 then do:
     1391             assign
     1392               loc-name = trim(entry ( 1 , v-font7 ))
     1393               loc-size = ""
     1394               loc-type = ""
     1395             .
     1396         end.
     1397       end case.
     1398     create temp-font.
     1399     assign
     1400       temp-font.fontnum  = 7
     1401       temp-font.fontname = trim(loc-name)
     1402       temp-font.fontsize = trim(loc-size)
     1403       temp-font.fonttype = trim(loc-type)
     1404       temp-font.v-row    = 62
     1405       temp-font.v-col    = 136
     1406       temp-font.v-row-lans = 43
     1407       temp-font.v-col-lans = 198
     1408     .
     1409     repeat ii = 16 to 100 :
     1410       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1411       if v-font = "" or v-font = ? then leave.
     1412       case num-entries (v-font) :
     1413         when 4 then do:
     1414             assign
     1415               loc-name = entry ( 1 , v-font )
     1416               loc-size = entry ( 2 , v-font )
     1417               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1418             .
     1419         end.
     1420         when 3 then do:
     1421             assign
     1422               loc-name = entry ( 1 , v-font )
     1423               loc-size = entry ( 2 , v-font )
     1424               loc-type = entry ( 3 , v-font )
     1425             .
     1426         end.
     1427         when 2 then do:
     1428             assign
     1429               loc-name = entry ( 1 , v-font )
     1430               loc-size = entry ( 2 , v-font )
     1431               loc-type = ""
     1432             .
     1433         end.
     1434         when 1 then do:
     1435             assign
     1436               loc-name = trim(entry ( 1 , v-font ))
     1437               loc-size = ""
     1438               loc-type = ""
     1439             .
     1440         end.
     1441       end case.
     1442     create temp-font.
     1443     assign
     1444       temp-font.fontnum  = ii
     1445       temp-font.fontname = trim(loc-name)
     1446       temp-font.fontsize = trim(loc-size)
     1447       temp-font.fonttype = trim(loc-type)
     1448     .
     1449     end.
     1450       for each temp-font :
     1451          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1452          if  vv = ? then vv =  0 .
     1453           run rep/exfont.p (
     1454             input   temp-font.fontname ,
     1455             input   vv ,
     1456             input   temp-font.fonttype ,
     1457             output  temp-font.font-h   ,
     1458             output  temp-font.font-w   )
     1459           .
     1460       end.
     1461   find first temp-font where  temp-font.fontnum  = 7  .
     1462   old_H = temp-font.font-H .
     1463   old_w = temp-font.font-W .
     1464   old-row = temp-font.v-row .
     1465   old-col = temp-font.v-col .
     1466   old-row-lans = temp-font.v-row-lans .
     1467   old-col-lans = temp-font.v-col-lans .
     1468       for each temp-font where
     1469                temp-font.fontnum  <> 7 :
     1470           assign
     1471               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1472               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1473               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1474               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1475           .
     1476       end.
     1477     end.
     1478   end procedure.
     1479   PROCEDURE How-name :
     1480   define input  parameter h as integer no-undo .
     1481   define input  parameter w as integer no-undo .
     1482   define output parameter n as character  no-undo .
     1483   define variable A4port-H as integer   no-undo init 63.
     1484   define variable A4port-W as integer   no-undo init 136.
     1485   define variable A4lans-H as integer   no-undo init 43.
     1486   define variable A4lans-W as integer   no-undo init 198.
     1487   define variable Strim-W  as integer   no-undo init 278.
     1488   run define-a4-size (
     1489        input ReportFontNum
     1490       ,output A4port-H
     1491       ,output A4port-W
     1492       ,output A4lans-H
     1493       ,output A4lans-W ).
     1494   If w >= 1 and w <= A4port-W Then DO:
     1495     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1496     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1497     If h > A4port-H              Then n = "to-file":U.
     1498   End.
     1499   If w > A4port-W and w <= A4lans-W Then DO:
     1500     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1501     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1502     If h > A4port-H              Then n = "to-file":U.
     1503   End.
     1504   If w > A4lans-W and w <= Strim-W Then DO:
     1505     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1506     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1507     If h > A4port-H              Then n = "to-file":U.
     1508   End.
     1509   If w > Strim-W Then DO:
     1510      n = "to-file":U.
     1511   End.
     1512   END PROCEDURE.
     1513   PROCEDURE define-a4-size :
     1514   define input  parameter p-ReportFontNum as integer   no-undo .
     1515   define output parameter A4port-H as integer   no-undo .
     1516   define output parameter A4port-W as integer   no-undo .
     1517   define output parameter A4lans-H as integer   no-undo .
     1518   define output parameter A4lans-W as integer   no-undo .
     1519   if not can-find (first temp-font ) then do:
     1520      run get-font-ini .
     1521   end.
     1522   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1523   if available temp-font then do:
     1524   assign
     1525     A4port-H = temp-font.v-row
     1526     A4port-W = temp-font.v-col
     1527     A4lans-H = temp-font.v-row-lans
     1528     A4lans-W = temp-font.v-col-lans
     1529   .
     1530   end.
     1531   else do:
     1532   assign
     1533     A4port-H = 63
     1534     A4port-W = 136
     1535     A4lans-H = 43
     1536     A4lans-W = 198
     1537   .
     1538   end.
     1539   END PROCEDURE.
