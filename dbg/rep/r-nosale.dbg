     1750           run report-execute in this-procedure .
     1751   function n-lavel returns character (input grp-name as char, input lavel# as integer ).
     1752   define variable str  as character format "x(60)"  no-undo.
     1753   define variable str2 as character  no-undo.
     1754   define variable i#i as integer no-undo.
     1755   str = "".
     1756     repeat i#i = 1 to lavel#:
     1757         if i#i = 1 then str = entry ( 1,grp-name, chr(47)) .
     1758         else do:
     1759             str2 = entry(i#i,grp-name, chr(47)) no-error.
     1760             if not error-status:error  and str2 <> "":u then  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) .
     1761             end.
     1762     end.
     1763       return (str + chr(47)).
     1764   end function.
     1765   procedure report-execute :
     1766     if (valtype = 0 and x-base-code = 0)  or valtype = 1
     1767                                   then   assign tprintrubl = yes .
     1768                                   else   assign tprintrubl = no .
     1769     run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1770   output stream outstream to value( string( session:temp-directory +
     1771                                        "rpt" + string( g#report-num ) ) )
     1772                                        page-size  value(ReportPageHeight) .
     1773      if xtog-obj  then do:
     1774               for each obj-list no-lock:
     1775                   x-store-type = obj-list.obj-type.
     1776                   x-store-code = obj-list.obj-code.
     1777                   run report-exec1 in this-procedure .
     1778               end.
     1779                                                  end.
     1780     else run report-exec1 in this-procedure .
     1781     run printtemptable in this-procedure .
     1782     hide stream outstream frame bottomframe .
     1783     run print-footer in this-procedure .
     1784     hide   stream outstream frame zapas .
     1785     output stream outstream close.
     1786     if Make-Excel then output stream ForExcel close.
     1787     run waitfram-hide in this-procedure .
     1788     define variable v-user-action as character no-undo .
     1789     define variable v-printed as logical   no-undo .
     1790     define variable disabledoptions as integer   no-undo .
     1791   define variable v-orient-page as character no-undo .
     1792   run How-name in this-procedure (
     1793       input ReportPageHeight,
     1794       input ReportPageWidth,
     1795       output v-orient-page )
     1796       .
     1797   if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1798                                  else DisabledOptions = 0 .
     1799     run gbl/prnfilen.w
     1800       (input  ""
     1801       ,input  disabledoptions
     1802       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1803       ,input  ReportFontNum
     1804       ,output v-user-action
     1805       ,output v-printed
     1806       ) .
     1807   end procedure.
     1808   procedure foreach :
     1809   If Integer(25) = 0 Then Temp1  = 100  .
     1810                         Else Temp1 = Integer(25) .
     1811        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     1812            RUN waitfram-show( "Обработано строк : " + string( i )) .
     1813     run clear-item in this-procedure .
     1814   run ost-line in this-procedure
     1815                  (input   x-store-code  ,
     1816                   input   x-store-type  ,
     1817                   input   gds-zap-artic     ,
     1818                   input   gds-zap-prod-code ,
     1819                   input   gds-zap-prod-type ,
     1820                   input   x-tog-shift       ,
     1821                   input   fact-order-2               ,
     1822                   input   'cost':U            ,
     1823                   input   '##,##':U    ,
     1824                   input   xtog-obj    ,
     1825                   output  quantity    ,
     1826                   output  coast_r     ,
     1827                   output  coast_v     ,
     1828                   output  vat_r       ,
     1829                   output  vat_v       ,
     1830                   output  slt_r       ,
     1831                   output  slt_v       ).
     1832   assign
     1833     ostatok-end [1 + 0]   = quantity
     1834    ostatok-end [2 + 0]   = if tprintrubl then coast_r else coast_v
     1835    ostatok-end [3 + 0]   = if tprintrubl then vat_r   else vat_v
     1836    b1-ostatok-end [1 + 0] =  b1-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1837    b1-ostatok-end [2 + 0] =  b1-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1838    b1-ostatok-end [3 + 0] =  b1-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1839    b2-ostatok-end [1 + 0] =  b2-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1840    b2-ostatok-end [2 + 0] =  b2-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1841    b2-ostatok-end [3 + 0] =  b2-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1842    .
     1843    assign
     1844     bi-ostatok-end [1 + 0] =  bi-ostatok-end [1 + 0] + ostatok-end [1 + 0]
     1845     bi-ostatok-end [2 + 0] =  bi-ostatok-end [2 + 0] + ostatok-end [2 + 0]
     1846     bi-ostatok-end [3 + 0] =  bi-ostatok-end [3 + 0] + ostatok-end [3 + 0]
     1847    .
     1848      if ostatok-end [1]   > 0 then do :
     1849      run ob-line in this-procedure (
     1850         input   x-store-code   ,
     1851         input   x-store-type   ,
     1852         input   gds-zap-artic       ,
     1853         input   gds-zap-prod-code   ,
     1854         input   gds-zap-prod-type   ,
     1855         input   fact-order-1,
     1856         input   fact-order-2,
     1857         input   'cost':U    ,
     1858         input   '##,##':U,
     1859         input   ""      ,
     1860         input   xtog-obj ).
     1861         if control-sum = 0 then do:
     1862   run ost-line in this-procedure
     1863                  (input   x-store-code  ,
     1864                   input   x-store-type  ,
     1865                   input   gds-zap-artic     ,
     1866                   input   gds-zap-prod-code ,
     1867                   input   gds-zap-prod-type ,
     1868                   input   x-tog-shift       ,
     1869                   input   fact-order-2               ,
     1870                   input   'crsa':U            ,
     1871                   input   '##,##':U    ,
     1872                   input   xtog-obj    ,
     1873                   output  quantity    ,
     1874                   output  coast_r     ,
     1875                   output  coast_v     ,
     1876                   output  vat_r       ,
     1877                   output  vat_v       ,
     1878                   output  slt_r       ,
     1879                   output  slt_v       ).
     1880   assign
     1881     ostatok-end [4]        = round(ostatok-end [1] *  p-price-med , 2)
     1882    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
     1883    ostatok-end [3 + 3]   = if tprintrubl then vat_r   else vat_v
     1884    b1-ostatok-end [1 + 3] =  b1-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1885    b1-ostatok-end [2 + 3] =  b1-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1886    b1-ostatok-end [3 + 3] =  b1-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1887    b2-ostatok-end [1 + 3] =  b2-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1888    b2-ostatok-end [2 + 3] =  b2-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1889    b2-ostatok-end [3 + 3] =  b2-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1890    .
     1891    assign
     1892     bi-ostatok-end [1 + 3] =  bi-ostatok-end [1 + 3] + ostatok-end [1 + 3]
     1893     bi-ostatok-end [2 + 3] =  bi-ostatok-end [2 + 3] + ostatok-end [2 + 3]
     1894     bi-ostatok-end [3 + 3] =  bi-ostatok-end [3 + 3] + ostatok-end [3 + 3]
     1895    .
     1896          i = i + 1.
     1897           run maketemptable in this-procedure
     1898               (ostatok-end [1] ,
     1899               ostatok-end [2] ,
     1900               ostatok-end [5] ,
     1901               gds-zap-artic   ,
     1902               gds-zap-prod-code    ,
     1903               gds-zap-prod-type   ) .
     1904         run clear-item in this-procedure .
     1905     end.
     1906    end.
     1907   end procedure.
     1908   procedure print-header :
     1909   if not firstline then  run display-title in this-procedure .
     1910       firstline = true .
     1911       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     1912             PUT stream  OutStream  UNFORMATTED  "ПО ОБЪЕКТУ : " + caps(objname)  at 30 format "x(170)" skip.
     1913       end.
     1914       form with FRAME ZAPAS .
     1915       DOWN stream   OutStream 1 with FRAME ZAPAS .
     1916        run rep/extitle.p (1) .
     1917         break_group = true.
     1918         break_group1 = true.
     1919      end procedure.
     1920   procedure print-footer :
     1921   end procedure.
     1922   procedure u-line :
     1923   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     1924           gds-zap-b-code
     1925           gds-zap-artic
     1926           gds-zap-gds-name
     1927           gds-zap-unit-base
     1928           f-ostatok-end
     1929           f-sumcost
     1930           f-sumcrsa
     1931           f-percent with FRAME ZAPAS .
     1932           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1933           end procedure.
     1934   procedure run1 :
     1935          case select-good :
     1936           when 1  then do:
     1937   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1938   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1939       for each gds-obj  where
     1940             gds-obj.obj-type = x-store-type  and
     1941             gds-obj.obj-code = x-store-code
     1942             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1943                   no-lock,
     1944             First goods  where  gds-obj.gds-code   = goods.gds-code
     1945   no-lock
     1946   BREAK
     1947       BY (temp-gds-list.artic) :
     1948         run item-goods ( "1" , "goods" ) .
     1949         if return-value <> "" then NEXT.
     1950       End.
     1951     END.
     1952     Else DO:
     1953      For each obj-list no-lock :
     1954                     FOR EACH gds-obj where
     1955                   gds-obj.obj-type = obj-list.obj-type    and
     1956                   gds-obj.obj-code = obj-list.obj-code
     1957                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1958                   no-lock :
     1959                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1960                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1961                       Create temp-gds-list.
     1962                       Assign
     1963                         temp-gds-list.prod-code = gds-obj.prod-code
     1964                         temp-gds-list.grp-name  = gds-obj.grp-name
     1965                         temp-gds-list.gds-name  = goods.gds-name
     1966                         temp-gds-list.gds-code  = gds-obj.gds-code
     1967                         temp-gds-list.artic     = gds-obj.artic
     1968                       .
     1969                   End.
     1970               End.
     1971     End.
     1972     for each temp-gds-list no-lock
     1973       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     1974         BREAK
     1975       BY temp-gds-list.artic :
     1976       run item-goods ( "1" , "goods" ) .
     1977         if return-value <> "" then NEXT.
     1978     End.
     1979   End.
     1980     end.
     1981           when 2  then do:
     1982   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1983     if x-selectobject = "currency":u  or  xtog-obj then do:
     1984         for  each gds-obj
     1985                     where gds-obj.obj-code   = x-store-code
     1986                      and  gds-obj.obj-type   = x-store-type
     1987                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1988                           no-lock ,
     1989                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1990                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     1991                     break
     1992                     by temp-gds-list.artic :
     1993                     run item-goods ( input "1" , input "goods" ) .
     1994                     if return-value <> "" then next.
     1995         end.
     1996     end.
     1997     else do:
     1998         for each obj-list no-lock :
     1999               for  each gds-obj
     2000                 where  gds-obj.obj-code   = obj-list.obj-code
     2001                   and  gds-obj.obj-type   = obj-list.obj-type
     2002                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2003                 no-lock ,
     2004                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     2005                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     2006                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2007                           create temp-gds-list.
     2008                           assign
     2009                             temp-gds-list.prod-code = gds-obj.prod-code
     2010                             temp-gds-list.grp-name  = gds-obj.grp-name
     2011                             temp-gds-list.gds-name  = goods.grp-name
     2012                             temp-gds-list.gds-code  = gds-obj.gds-code
     2013                             temp-gds-list.artic     = gds-obj.artic
     2014                           .
     2015                       end.
     2016               end.
     2017       end.
     2018     for each temp-gds-list no-lock
     2019       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2020         break
     2021       by temp-gds-list.artic :
     2022       run item-goods ( "1" , "goods" ) .
     2023         if return-value <> "" then next.
     2024     end.
     2025   end.
     2026     end.
     2027           when 3 then do:
     2028   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2029   if x-selectobject = "currency":u  or  xtog-obj then do:
     2030     for  each gds-obj
     2031         where  gds-obj.obj-code   = x-store-code
     2032           and  gds-obj.obj-type   = x-store-type
     2033                 and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2034                 no-lock ,
     2035     first g#cli
     2036           where gds-obj.prod-code  = g#cli.obj-code
     2037           and  gds-obj.prod-type   = g#cli.obj-type
     2038           no-lock,
     2039     first goods
     2040           where gds-obj.gds-code = goods.gds-code no-lock
     2041           break
     2042           by temp-gds-list.artic :
     2043           run item-goods ( "1" , "goods" ) .
     2044           if return-value <> "" then next.
     2045         end.
     2046     end.
     2047     else do:
     2048       for each obj-list no-lock :
     2049             for  each gds-obj
     2050               where  gds-obj.obj-code   = obj-list.obj-code
     2051                 and  gds-obj.obj-type   = obj-list.obj-type
     2052                       and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2053                       no-lock ,
     2054             first g#cli
     2055                 where gds-obj.prod-code  = g#cli.obj-code
     2056                 and  gds-obj.prod-type   = g#cli.obj-type
     2057                 no-lock,
     2058             first goods
     2059                 where gds-obj.gds-code = goods.gds-code no-lock :
     2060                   if not can-find (first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2061                       create temp-gds-list.
     2062                       assign
     2063                         temp-gds-list.prod-code = gds-obj.prod-code
     2064                         temp-gds-list.grp-name  = gds-obj.grp-name
     2065                         temp-gds-list.gds-name  = goods.gds-name
     2066                         temp-gds-list.gds-code  = gds-obj.gds-code
     2067                         temp-gds-list.artic     = gds-obj.artic
     2068                       .
     2069                   end.
     2070             end.
     2071       end.
     2072         for each temp-gds-list no-lock
     2073           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2074             break
     2075               by temp-gds-list.artic :
     2076           run item-goods ( "1" , "goods" ) .
     2077             if return-value <> "" then next.
     2078         end.
     2079   end.
     2080     end.
     2081           otherwise do:
     2082   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2083   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2084       for each gds-obj  where
     2085             gds-obj.obj-type = x-store-type  and
     2086             gds-obj.obj-code = x-store-code
     2087             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2088                   no-lock,
     2089             First goods  where  gds-obj.gds-code   = goods.gds-code
     2090         no-lock,
     2091   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2092   no-lock
     2093   BREAK
     2094       BY (gds-list.artic) :
     2095         run item-goods ( "1" , "gds-list" ) .
     2096         if return-value <> "" then NEXT.
     2097       End.
     2098     END.
     2099     Else DO:
     2100      For each obj-list no-lock :
     2101                     FOR EACH gds-obj where
     2102                   gds-obj.obj-type = obj-list.obj-type    and
     2103                   gds-obj.obj-code = obj-list.obj-code
     2104                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2105                   no-lock,
     2106             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2107                   no-lock :
     2108                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2109                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2110                       Create temp-gds-list.
     2111                       Assign
     2112                         temp-gds-list.prod-code = gds-obj.prod-code
     2113                         temp-gds-list.grp-name  = gds-obj.grp-name
     2114                         temp-gds-list.gds-name  = goods.gds-name
     2115                         temp-gds-list.gds-code  = gds-obj.gds-code
     2116                         temp-gds-list.artic     = gds-obj.artic
     2117                       .
     2118                   End.
     2119               End.
     2120     End.
     2121     for each temp-gds-list no-lock
     2122       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2123         BREAK
     2124       BY gds-list.artic :
     2125       run item-goods ( "1" , "gds-list" ) .
     2126         if return-value <> "" then NEXT.
     2127     End.
     2128   End.
     2129           end.
     2130          end case.
     2131   end procedure.
     2132   procedure calcitog :
     2133       run ostatok in this-procedure (
     2134           input x-store-code  ,
     2135           input x-store-type  ,
     2136           input x-tog-shift,
     2137           input x-date-start - 1 ,
     2138           input date('')      ,
     2139           input x-shift-start,
     2140           input x-shift-end,
     2141           input 'cost':U   ,
     2142           input '##,##':U,
     2143           input xtog-obj ,
     2144           output  quantity1  ,
     2145           output  coast_r1   ,
     2146           output  coast_v1   ,
     2147           output  vat_r1     ,
     2148           output  vat_v1     ,
     2149           output  fact-order-1 ).
     2150       run ostatok in this-procedure (
     2151           input x-store-code  ,
     2152           input x-store-type  ,
     2153           input x-tog-shift,
     2154           input x-date-start  ,
     2155           input x-date-end    ,
     2156           input x-shift-start,
     2157           input x-shift-end,
     2158           input 'cost':U   ,
     2159           input '##,##':U,
     2160           input xtog-obj ,
     2161           output  quantity1  ,
     2162           output  coast_r1   ,
     2163           output  coast_v1   ,
     2164           output  vat_r1     ,
     2165           output  vat_v1     ,
     2166           output  fact-order-2 ).
     2167             quantity1  = 0.
     2168             coast_r1   = 0.
     2169             coast_v1   = 0.
     2170             vat_r1     = 0.
     2171             vat_v1     = 0.
     2172   end procedure.
     2173   procedure display-title :
     2174      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2175             reportname  at 20 format "x(170)" skip
     2176             trim(str1)  at 35 format "x(75)" skip.
     2177        repeat i = 1 to num-entries(str2,chr(10)) :
     2178         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2179        end.
     2180       i=0.
     2181          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2182        repeat i = 1 to num-entries(str4,chr(10)) :
     2183         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2184        end.
     2185       i=0.
     2186        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2187         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2188        end.
     2189       i=0.
     2190   end procedure.
     2191   procedure ob-line  :
     2192   define input  parameter x-store-code    like ub.clients.obj-code     no-undo.
     2193   define input  parameter x-store-type    like ub.clients.obj-type     no-undo.
     2194   define input  parameter x-artic         like ub.ot-line.artic        no-undo.
     2195   define input  parameter x-prod-code     like ub.ot-line.prod-code    no-undo.
     2196   define input  parameter x-prod-type     like ub.ot-line.prod-type    no-undo.
     2197   define input  parameter x-fact-order-1  like ub.ot-line.fact-order   no-undo.
     2198   define input  parameter x-fact-order-2  like ub.ot-line.fact-order   no-undo.
     2199   define input  parameter x-sum-type      like ub.ot-line.sum-type     no-undo.
     2200   define input  parameter x-cat-id        like ub.ot-line.cat-id       no-undo.
     2201   define input  parameter x-ext-doc-type  like ub.ot-line.ext-doc-type no-undo.
     2202   define input  parameter xtog-obj        as logical no-undo.
     2203   define variable  tt# as integer  no-undo.
     2204    if x-sum-type = 'cost':U then tt# = 0.
     2205                                      else tt# = 3 .
     2206     for each obj-list no-lock:
     2207      if  xtog-obj then
     2208          if   not(    x-store-type     = obj-list.obj-type
     2209               and    x-store-code      = obj-list.obj-code ) then next.
     2210        for each ub.ot-line where
     2211                           ub.ot-line.artic         = x-artic
     2212                     and   ub.ot-line.fact-order   <= x-fact-order-2
     2213                     and   ub.ot-line.fact-order   >= x-fact-order-1
     2214                     and   ub.ot-line.obj-code     = obj-list.obj-code
     2215                     and   ub.ot-line.obj-type     = obj-list.obj-type
     2216                     and   ub.ot-line.prod-code    = x-prod-code
     2217                     and   ub.ot-line.prod-type    = x-prod-type
     2218                     and   ub.ot-line.sum-type     = x-sum-type
     2219                       no-lock :
     2220                     if tog-sale then do:
     2221                         run sale-all in this-procedure .
     2222                       end.
     2223                       else do:
     2224                             if x-selectobject = 'все':U then run move-all in this-procedure .
     2225                                                        else run move-current in this-procedure .
     2226                       end.
     2227                           end.
     2228     end.
     2229     if tog-sale then control-sum = absolute(rash[1]).
     2230                 else control-sum = absolute(prih[1]) + absolute(rash[1]).
     2231   end procedure.
     2232   procedure ost-line :
     2233     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2234     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2235     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2236     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2237     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2238     define input  parameter x-tog-shift  as logical no-undo .
     2239     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2240     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2241     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2242     define input  parameter xtog-obj     as logical no-undo .
     2243     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2244     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2245     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2246     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2247     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2248     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2249     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2250     define buffer buff-obj-list  for obj-list .
     2251     define buffer buff-stk-line  for ub.stk-line .
     2252     assign
     2253       Quantity = 0
     2254       Coast_R  = 0
     2255       Coast_V  = 0
     2256       VAT_R    = 0
     2257       VAT_V    = 0
     2258       SLT_R    = 0
     2259       SLT_V    = 0
     2260     .
     2261     if  x-tog-shift = false then do:
     2262       for each buff-obj-list no-lock
     2263       on error undo, return error
     2264       :
     2265         find last buff-stk-line no-lock
     2266           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2267             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2268             and buff-stk-line.artic      = x-artic
     2269             and buff-stk-line.prod-type  = x-prod-type
     2270             and buff-stk-line.prod-code  = x-prod-code
     2271             and buff-stk-line.sum-type   = x-sum-type
     2272             and buff-stk-line.cat-id     = '##,##':U
     2273             and buff-stk-line.fact-order <= x-fact-order
     2274             and buff-stk-line.shift-num  = 0
     2275           use-index category
     2276           no-error .
     2277         if available buff-stk-line then do:
     2278           assign
     2279             Quantity = Quantity +  buff-stk-line.fact-qnty
     2280             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2281             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2282             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2283             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2284             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2285             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2286           .
     2287         end.
     2288       end.
     2289     end.
     2290     else do:
     2291       for each buff-obj-list no-lock
     2292         where xtog-obj = false
     2293            or (buff-obj-list.obj-type = x-store-type
     2294               and buff-obj-list.obj-code = x-store-code
     2295               )
     2296       on error undo, return error
     2297       :
     2298         find last buff-stk-line no-lock
     2299           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2300             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2301             and buff-stk-line.artic      = x-artic
     2302             and buff-stk-line.prod-type  = x-prod-type
     2303             and buff-stk-line.prod-code  = x-prod-code
     2304             and buff-stk-line.sum-type   = x-sum-type
     2305             and buff-stk-line.cat-id     = '##,##':U
     2306             and buff-stk-line.fact-order <= x-fact-order
     2307             and buff-stk-line.shift-num  > 0
     2308           use-index category
     2309           no-error .
     2310         if available buff-stk-line then do:
     2311           assign
     2312             Quantity = Quantity +  buff-stk-line.fact-qnty
     2313             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2314             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2315             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2316             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2317             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2318             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2319           .
     2320         end.
     2321       end.
     2322     end.
     2323   end procedure.
     2324   procedure ost-lineother-tax :
     2325     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2326     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2327     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2328     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2329     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2330     define input  parameter x-tog-shift  as logical no-undo .
     2331     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2332     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2333     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2334     define input  parameter xTog-obj     as logical no-undo .
     2335     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2336     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2337     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2338     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2339     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2340     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2341     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2342     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2343     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2344     define buffer buff-obj-list  for obj-list .
     2345     define buffer buff-stk-line  for ub.stk-line .
     2346     assign
     2347       Quantity = 0
     2348       Coast_R  = 0
     2349       Coast_V  = 0
     2350       VAT_R    = 0
     2351       VAT_V    = 0
     2352       SLT_R    = 0
     2353       SLT_V    = 0
     2354       other_R  = 0
     2355       other_V  = 0
     2356     .
     2357     if  x-tog-shift = false then do:
     2358       for each buff-obj-list no-lock
     2359       on error undo, return error
     2360       :
     2361         find last buff-stk-line no-lock
     2362           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2363             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2364             and buff-stk-line.artic      = x-artic
     2365             and buff-stk-line.prod-type  = x-prod-type
     2366             and buff-stk-line.prod-code  = x-prod-code
     2367             and buff-stk-line.sum-type   = x-sum-type
     2368             and buff-stk-line.cat-id     = '##,##':U
     2369             and buff-stk-line.fact-order <= x-fact-order
     2370             and buff-stk-line.shift-num  = 0
     2371           use-index category
     2372           no-error .
     2373         if available buff-stk-line then do:
     2374           assign
     2375             Quantity = Quantity +  buff-stk-line.fact-qnty
     2376             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2377             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2378             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2379             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2380             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2381             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2382             other_R  = other_R  +  buff-stk-line.other-rubl
     2383             other_V  = other_V  +  buff-stk-line.other-base
     2384           .
     2385         end.
     2386       end.
     2387     end.
     2388     else do:
     2389       for each buff-obj-list no-lock
     2390         where xtog-obj = false
     2391            or (buff-obj-list.obj-type = x-store-type
     2392               and buff-obj-list.obj-code = x-store-code
     2393               )
     2394       on error undo, return error
     2395       :
     2396         find last buff-stk-line no-lock
     2397           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2398             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2399             and buff-stk-line.artic      = x-artic
     2400             and buff-stk-line.prod-type  = x-prod-type
     2401             and buff-stk-line.prod-code  = x-prod-code
     2402             and buff-stk-line.sum-type   = x-sum-type
     2403             and buff-stk-line.cat-id     = '##,##':U
     2404             and buff-stk-line.fact-order <= x-fact-order
     2405             and buff-stk-line.shift-num  > 0
     2406           use-index category
     2407           no-error .
     2408         if available buff-stk-line then do:
     2409           assign
     2410             Quantity = Quantity +  buff-stk-line.fact-qnty
     2411             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2412             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2413             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2414             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2415             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2416             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2417             other_R = other_R   +  buff-stk-line.other-rubl
     2418             other_V = other_V   +  buff-stk-line.other-base
     2419           .
     2420         end.
     2421       end.
     2422     end.
     2423   end procedure.
     2424   procedure ost-line-kg :
     2425     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2426     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2427     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2428     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2429     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2430     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2431     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2432     define buffer buff-obj-list  for obj-list .
     2433     define buffer buf_doc-line for ub.doc-line .
     2434     define buffer buf_inv-line for ub.inv-line .
     2435     do
     2436     on error undo, return error
     2437     :
     2438       for each buf_doc-line no-lock where
     2439                buf_doc-line.obj-type    = p-obj-type   and
     2440                buf_doc-line.obj-code    = p-obj-code   and
     2441                buf_doc-line.prod-type   = p-prod-type  and
     2442                buf_doc-line.prod-code   = p-prod-code  and
     2443                buf_doc-line.artic       = p-artic      and
     2444                buf_doc-line.status_     = 'факт':U      and
     2445                buf_doc-line.fact-order <= p-fact-order
     2446             by buf_doc-line.fact-order    descending
     2447       :
     2448         find first buf_inv-line no-lock where
     2449                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2450                    buf_inv-line.artic     = buf_doc-line.artic     and
     2451                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2452                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2453         if available buf_inv-line
     2454         then do:
     2455           if buf_inv-line.after-cli-qnty <> ?
     2456           then do:
     2457             assign
     2458               p-quantity-kg = buf_inv-line.after-cli-qnty
     2459             .
     2460             leave .
     2461           end.
     2462         end.
     2463       end.
     2464       if p-quantity-kg = ?
     2465       then do:
     2466         assign
     2467           p-quantity-kg = 0
     2468         .
     2469       end.
     2470     end.
     2471   end procedure.
     2472   PROCEDURE ostatok :
     2473   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2474   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2475   def input parameter x-tog-shift   as   logical             no-undo.
     2476   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2477   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2478   def input parameter x-shift-start as integer               no-undo.
     2479   def input parameter x-shift-end   as integer               no-undo.
     2480   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2481   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2482   def input parameter xTog-obj   as log no-undo.
     2483   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2484   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2485   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2486   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2487   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2488   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2489   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2490   def var              Fact-orderS   as char  no-undo.
     2491   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2492      Assign
     2493         Fact-order   = 0
     2494         Quantity     = 0
     2495         Coast_R      = 0
     2496         Coast_V      = 0
     2497         VAT_R        = 0
     2498         VAT_V        = 0 .
     2499    x-date-start-t  = x-date-start + 1 .
     2500   IF x-date-end = date('') then DO:
     2501      Fact-order = 0 .
     2502      for each obj-list
     2503          where  ( not xtog-obj or
     2504                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2505                 no-lock :
     2506         if  x-tog-shift = false then do:
     2507                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2508                               ub.stk-tot.Fact-date <=  x-date-start
     2509                               and ub.stk-tot.shift-num = 0
     2510                               USE-INDEX fact-date no-lock no-error .
     2511              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2512         End.
     2513         Else  DO :
     2514             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2515              (ub.stk-tot.shift-date  = x-date-start-t and
     2516               ub.stk-tot.shift-num  < x-shift-start or
     2517               ub.stk-tot.shift-date  < x-date-start-t  )
     2518               and ub.stk-tot.shift-num  > 0
     2519               USE-INDEX Shift-num no-lock no-error .
     2520            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2521           END.
     2522       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2523     End.
     2524   End.
     2525   Else DO:
     2526     For each obj-list  WHERE
     2527        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2528         no-lock :
     2529      IF  x-TOG-Shift = False Then DO:
     2530          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2531               ub.stk-tot.Fact-date <= x-date-end
     2532               and ub.stk-tot.shift-num = 0
     2533               USE-INDEX fact-date no-lock no-error.
     2534          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2535      END.
     2536      Else DO:
     2537           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2538               (ub.stk-tot.shift-date  = x-date-end and
     2539               ub.stk-tot.shift-num  <= x-shift-end or
     2540               ub.stk-tot.shift-date  < x-date-end       ) and
     2541               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2542               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2543       End.
     2544       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2545     End.
     2546   End.
     2547   END PROCEDURE.
     2548   procedure report-exec1  :
     2549      find first clients where x-store-type = clients.obj-type and
     2550                               x-store-code = clients.obj-code no-lock no-error.
     2551              if available clients then  objname = clients.obj-name.
     2552                                            else  objname="объект не определен".
     2553     form with frame zapas .
     2554   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2555   form header
     2556     line format "x(194)" at 1 skip
     2557     "Продолжение - на следующей странице" at 30 skip
     2558     with frame bottomframe width 232 page-bottom no-labels no-box .
     2559   view stream outstream frame bottomframe .
     2560     run calcitog in this-procedure .
     2561     run print-header in this-procedure .
     2562      case retclassify :
     2563        when "no-classify":u  then            run run1 in this-procedure .
     2564        otherwise do:
     2565          message "Ошибка вызова!" view-as alert-box error .
     2566        end.
     2567      end case.
     2568     end procedure.
     2569   procedure clear-item :
     2570   define variable kk as integer no-undo.
     2571    repeat kk = 1 to 6:
     2572    assign
     2573       prih             [kk] = 0
     2574       rash             [kk] = 0
     2575       kassa            [kk] = 0
     2576       inv              [kk] = 0
     2577       overturn         [kk] = 0
     2578       ostatok-end      [kk] = 0
     2579       ostatok-start    [kk] = 0   .
     2580          end.
     2581    end procedure.
     2582   procedure item-goods :
     2583    define input parameter  par-3 as character no-undo.
     2584    define input parameter  par-4 as character no-undo.
     2585        if par-4 = "goods":u  then do:
     2586             find first clients where clients.obj-type = goods.prod-type and
     2587                                 clients.obj-code = goods.prod-code use-index pi no-lock .
     2588                                   assign
     2589                                       gds-zap-unit-base  = goods.unit-base
     2590                                       gds-zap-prt-root   = goods.prt-root
     2591                                       gds-zap-prod-type  = goods.prod-type
     2592                                       gds-zap-prod-code  = goods.prod-code
     2593                                       gds-zap-artic      = goods.artic
     2594                                       gds-zap-grp-name   = goods.grp-name
     2595                                       gds-zap-b-code     = goods.gds-code
     2596                                       gds-zap-prod-name  = clients.obj-name .
     2597                                   if g#gds-engl then
     2598                                       assign gds-zap-gds-name = goods.engl-name.
     2599                                   else
     2600                                       assign gds-zap-gds-name = goods.gds-name.
     2601                               end.
     2602        if par-4 = "gds-list":u  then do:
     2603             find first clients where clients.obj-type = gds-list.prod-type and
     2604                                 clients.obj-code = gds-list.prod-code use-index pi no-lock .
     2605                                   assign
     2606                                       gds-zap-unit-base  = gds-list.unit-base
     2607                                       gds-zap-prt-root   = gds-list.prt-root
     2608                                       gds-zap-prod-type  = gds-list.prod-type
     2609                                       gds-zap-prod-code  = gds-list.prod-code
     2610                                       gds-zap-artic      = gds-list.artic
     2611                                       gds-zap-grp-name   = gds-list.grp-name
     2612                                       gds-zap-b-code     = gds-list.gds-code
     2613                                       gds-zap-prod-name  = clients.obj-name .
     2614                                   if g#gds-engl then
     2615                                       assign gds-zap-gds-name = gds-list.engl-name.
     2616                                   else
     2617                                       assign gds-zap-gds-name = gds-list.gds-name.
     2618                               end.
     2619       run foreach in this-procedure .
     2620    return "not-u-line":u.
     2621    end procedure.
     2622   procedure move-current :
     2623   define variable  tt#          as   integer                 no-undo.
     2624   i = 0.
     2625            case ub.ot-line.ext-doc-type:
     2626               when 'ie':U              or
     2627               when 're':U          or
     2628               when 'rs':U     or
     2629               when 'iv':U              or
     2630               when 'rv':U          or
     2631               when 'im':U              then do:
     2632                                                           prih[1 + tt#] = prih[1 + tt#] + ub.ot-line.fact-qnty.
     2633                                                           prih[2 + tt#] = prih[2 + tt#] + ub.ot-line.sum-rubl.
     2634                                                          end.
     2635               when 'ee':U             or
     2636               when 'ep':U          or
     2637               when 'es':U        or
     2638               when 'we':U             or
     2639               when 'vt':U                   or
     2640               when 'vp':U              or
     2641               when 'ev':U             or
     2642               when 'em':U              or
     2643               when 'wm':U                then do:
     2644                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     2645                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     2646                                                          end.
     2647             end case.
     2648    end procedure.
     2649   procedure maketemptable :
     2650   define input parameter dec1 like ub.stk-line.fact-qnty no-undo.
     2651   define input parameter dec2 like ub.stk-line.sum-rubl no-undo.
     2652   define input parameter dec3 like ub.stk-line.sum-rubl no-undo.
     2653   define input parameter a1 like ub.stk-line.artic     no-undo.
     2654   define input parameter a2 like ub.stk-line.prod-code no-undo.
     2655   define input parameter a3 like ub.stk-line.prod-type no-undo.
     2656      assign
     2657       v#qnty      = dec1
     2658       v#sumcost   = dec2
     2659       v#sumcrsa   = dec3
     2660       v#artic     = a1
     2661       v#prod-type = a3
     2662       v#prod-code = a2
     2663       v#effect    = v#sumcrsa - v#sumcost
     2664       v#b-code    = 0
     2665       v#prt-root  = 0
     2666       v#gds-name  = ""
     2667       v#unit-base = ""  no-error.
     2668    if i <= xbsamount or true then do:
     2669      create tmp#bs.
     2670      run eqq in this-procedure .
     2671    end.
     2672    else do:
     2673        case xcrit:
     2674           when 1 then do:
     2675              find first tmp#bs  use-index byqnty.
     2676              if available tmp#bs and v#qnty > tmp#bs.qnty then run eqq in this-procedure .
     2677              end.
     2678           when 2 then do:
     2679              find first tmp#bs  use-index bysumcost.
     2680              if available tmp#bs and v#sumcost > tmp#bs.sumcost then run eqq in this-procedure .
     2681              end.
     2682           when 3 then do:
     2683              find first tmp#bs  use-index bysumcrsa.
     2684              if available tmp#bs and v#sumcrsa > tmp#bs.sumcrsa then run eqq in this-procedure .
     2685              end.
     2686       end case.
     2687    end.
     2688   end procedure.
     2689   procedure eqq :
     2690      assign
     2691       tmp#bs.qnty      = v#qnty
     2692       tmp#bs.sumcost   = v#sumcost
     2693       tmp#bs.sumcrsa   = v#sumcrsa
     2694       tmp#bs.effect    = v#effect
     2695       tmp#bs.b-code    = v#b-code
     2696       tmp#bs.artic     = v#artic
     2697       tmp#bs.prod-code = v#prod-code
     2698       tmp#bs.prod-type = v#prod-type
     2699       tmp#bs.prt-root  = v#prt-root
     2700       tmp#bs.gds-name  = v#gds-name
     2701       tmp#bs.unit-base = v#unit-base.
     2702   end procedure.
     2703   procedure printtemptable :
     2704         percent#all = 0.
     2705         for each tmp#bs no-lock:
     2706           find first goods where
     2707                         goods.artic     = tmp#bs.artic
     2708                     and goods.prod-type = tmp#bs.prod-type
     2709                     and goods.prod-code = tmp#bs.prod-code use-index pi no-lock.
     2710                 case xcrit:
     2711                  when 1 then  percent#all = percent#all + tmp#bs.qnty .
     2712                  when 2 then  percent#all = percent#all + tmp#bs.sumcost .
     2713                  when 3 then  percent#all = percent#all + tmp#bs.sumcrsa .
     2714                 end.
     2715             assign
     2716             tmp#bs.b-code    = goods.gds-code
     2717             tmp#bs.prt-root  = goods.prt-root
     2718             tmp#bs.gds-name  = goods.gds-name
     2719             tmp#bs.grp-name  = goods.grp-name
     2720             tmp#bs.unit-base = goods.unit-base.
     2721         end.
     2722         for each tmp#bs no-lock by tmp#bs.artic  descending  :
     2723                     if percent#all <> 0 then
     2724                     case  xcrit:
     2725                       when 1 then  tmp#bs.percent#1 = tmp#bs.qnty * 100 / percent#all .
     2726                       when 2 then  tmp#bs.percent#1 = tmp#bs.sumcost * 100 / percent#all .
     2727                       when 3 then  tmp#bs.percent#1 = tmp#bs.sumcrsa  * 100 / percent#all .
     2728                     end case.
     2729         end.
     2730        case xsort:
     2731           when 1 then do:
     2732   case xClassify :
     2733       when "no-classify":U  then  DO:
     2734           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.b-code  :
     2735               run display-str.
     2736               accumulate tmp#bs.qnty    (total ).
     2737               accumulate tmp#bs.sumcost (total ).
     2738               accumulate tmp#bs.sumcrsa (total ).
     2739           end.
     2740           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     2741           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     2742           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     2743           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     2744       end.
     2745       when "prod":U then DO:
     2746             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     2747                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.b-code
     2748                 :
     2749                 if first-of(Tmp#bs.prod-code) Then DO:
     2750                     Find first clients where
     2751                               clients.obj-code = Tmp#bs.prod-code and
     2752                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     2753                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     2754                 end.
     2755                 run display-str in this-procedure .
     2756                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     2757                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     2758                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     2759                 if last-of(tmp#bs.prod-code) then do:
     2760                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     2761                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     2762                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     2763                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     2764                 end.
     2765             end.
     2766       end.
     2767       when "grp-goods":U then DO:
     2768           For each TMP#bs no-lock Break
     2769               by tmp#bs.percent#1 descending
     2770               by Tmp#bs.grp-name
     2771               By tmp#bs.b-code  :
     2772               if first-of(Tmp#bs.grp-name) Then do:
     2773                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     2774               end.
     2775               run display-str in this-procedure .
     2776               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     2777               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     2778               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     2779               if last-of(tmp#bs.grp-name) then do:
     2780                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     2781                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     2782                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     2783                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     2784               End.
     2785           End.
     2786    End.
     2787   end case.
     2788              end.
     2789           when 2 then do:
     2790   case xClassify :
     2791       when "no-classify":U  then  DO:
     2792           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.artic  :
     2793               run display-str.
     2794               accumulate tmp#bs.qnty    (total ).
     2795               accumulate tmp#bs.sumcost (total ).
     2796               accumulate tmp#bs.sumcrsa (total ).
     2797           end.
     2798           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     2799           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     2800           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     2801           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     2802       end.
     2803       when "prod":U then DO:
     2804             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     2805                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.artic
     2806                 :
     2807                 if first-of(Tmp#bs.prod-code) Then DO:
     2808                     Find first clients where
     2809                               clients.obj-code = Tmp#bs.prod-code and
     2810                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     2811                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     2812                 end.
     2813                 run display-str in this-procedure .
     2814                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     2815                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     2816                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     2817                 if last-of(tmp#bs.prod-code) then do:
     2818                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     2819                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     2820                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     2821                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     2822                 end.
     2823             end.
     2824       end.
     2825       when "grp-goods":U then DO:
     2826           For each TMP#bs no-lock Break
     2827               by tmp#bs.percent#1 descending
     2828               by Tmp#bs.grp-name
     2829               By tmp#bs.artic  :
     2830               if first-of(Tmp#bs.grp-name) Then do:
     2831                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     2832               end.
     2833               run display-str in this-procedure .
     2834               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     2835               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     2836               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     2837               if last-of(tmp#bs.grp-name) then do:
     2838                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     2839                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     2840                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     2841                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     2842               End.
     2843           End.
     2844    End.
     2845   end case.
     2846               end.
     2847           when 3 then do:
     2848   case xClassify :
     2849       when "no-classify":U  then  DO:
     2850           for each tmp#bs no-lock by tmp#bs.percent#1 descending by tmp#bs.gds-name  :
     2851               run display-str.
     2852               accumulate tmp#bs.qnty    (total ).
     2853               accumulate tmp#bs.sumcost (total ).
     2854               accumulate tmp#bs.sumcrsa (total ).
     2855           end.
     2856           q1 = ACCUM TOTAL  Tmp#bs.Qnty    .
     2857           q2 = ACCUM TOTAL  Tmp#bs.SumCost .
     2858           q3 = ACCUM TOTAL  Tmp#bs.SumCrsa .
     2859           run print-sub-itog in this-procedure ( "" , "" , q1 , q2, q3 ).
     2860       end.
     2861       when "prod":U then DO:
     2862             for each TMP#bs no-lock Break by tmp#bs.percent#1 descending
     2863                 by Tmp#bs.prod-type by Tmp#bs.prod-code By tmp#bs.gds-name
     2864                 :
     2865                 if first-of(Tmp#bs.prod-code) Then DO:
     2866                     Find first clients where
     2867                               clients.obj-code = Tmp#bs.prod-code and
     2868                               clients.obj-type  = Tmp#bs.prod-type no-lock no-error.
     2869                     run print-sub-head in this-procedure ('Производитель':U,clients.obj-name).
     2870                 end.
     2871                 run display-str in this-procedure .
     2872                 accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.prod-code).
     2873                 accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.prod-code).
     2874                 accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.prod-code).
     2875                 if last-of(tmp#bs.prod-code) then do:
     2876                     q1 = accum total by tmp#bs.prod-code tmp#bs.qnty   .
     2877                     q2 = accum total by tmp#bs.prod-code tmp#bs.sumcost .
     2878                     q3 = accum total by tmp#bs.prod-code tmp#bs.sumcrsa .
     2879                     run print-sub-itog in this-procedure ('Производитель':U,clients.obj-name,q1,q2,q3).
     2880                 end.
     2881             end.
     2882       end.
     2883       when "grp-goods":U then DO:
     2884           For each TMP#bs no-lock Break
     2885               by tmp#bs.percent#1 descending
     2886               by Tmp#bs.grp-name
     2887               By tmp#bs.gds-name  :
     2888               if first-of(Tmp#bs.grp-name) Then do:
     2889                 run print-sub-head in this-procedure ("Группа",tmp#bs.grp-name).
     2890               end.
     2891               run display-str in this-procedure .
     2892               accumulate Tmp#bs.Qnty        (TOTAL BY Tmp#bs.grp-name).
     2893               accumulate Tmp#bs.SumCost     (TOTAL BY Tmp#bs.grp-name).
     2894               accumulate Tmp#bs.SumCrsa     (TOTAL BY Tmp#bs.grp-name).
     2895               if last-of(tmp#bs.grp-name) then do:
     2896                   q1 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.Qnty   .
     2897                   q2 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCost .
     2898                   q3 = ACCUM TOTAL BY Tmp#bs.grp-name Tmp#bs.SumCrsa .
     2899                   run print-sub-itog in this-procedure ("Группа",tmp#bs.grp-name,q1,q2,q3).
     2900               End.
     2901           End.
     2902    End.
     2903   end case.
     2904              end.
     2905       end case.
     2906   end procedure.
     2907   procedure display-str  :
     2908     display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     2909       tmp#bs.b-code    @ gds-zap-b-code
     2910       tmp#bs.artic     @ gds-zap-artic
     2911       tmp#bs.gds-name  @ gds-zap-gds-name
     2912       tmp#bs.unit-base @ gds-zap-unit-base
     2913       tmp#bs.qnty      @ f-ostatok-end
     2914       tmp#bs.sumcost   @ f-sumcost
     2915       tmp#bs.sumcrsa   @ f-sumcrsa
     2916       tmp#bs.percent#1 @  f-percent   with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     2917       if Make-Excel then  put   stream ForExcel unformatted
     2918           tmp#bs.b-code     CHR(9)
     2919           tmp#bs.artic      CHR(9)
     2920           tmp#bs.gds-name   CHR(9)
     2921           tmp#bs.unit-base  CHR(9)
     2922           excel-qnty (tmp#bs.qnty)     CHR(9)
     2923           excel-sum(tmp#bs.sumcost)    CHR(9)
     2924           excel-sum(tmp#bs.sumcrsa )   CHR(9)
     2925           excel-sum(tmp#bs.percent#1)  skip.
     2926       if  tog-scale and tmp#bs.prt-root <> prtroot and tmp#bs.prt-root <> 0 then
     2927            if xsc_name = 0 then run print_scala in this-procedure .
     2928                             else  if tmp#bs.prt-root = x-upper-code then run print_scala in this-procedure .
     2929   end procedure.
     2930   procedure print_scala  :
     2931   define variable  tt#          as   integer                 no-undo.
     2932   run clear-item in this-procedure .
     2933     for each ub.prt-obj where
     2934                           ub.prt-obj.obj-code     = x-store-code
     2935                     and   ub.prt-obj.obj-type     = x-store-type
     2936                     and   ub.prt-obj.artic        = tmp#bs.artic
     2937                     and   ub.prt-obj.prod-code    = tmp#bs.prod-code
     2938                     and   ub.prt-obj.prod-type    = tmp#bs.prod-type
     2939                    no-lock
     2940                    break by ub.prt-obj.prt-code :
     2941                    assign kassa[1] = ub.prt-obj.fact-qnty
     2942                           kassa[2] = 0
     2943                           kassa[3] = ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     2944     if last-of(prt-obj.prt-code) then do:
     2945         find first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code no-lock no-error .
     2946   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2947     (input  tmp#bs.b-code
     2948     ,input  ub.gds-prt.node-code
     2949     ,output v-bar-code
     2950     )  .
     2951         if tmp#bs.b-code <> v-bar-code then do:
     2952         display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     2953           v-bar-code                              @ gds-zap-b-code
     2954           ""                                           @ gds-zap-artic
     2955           ub.gds-prt.f-name                               @ gds-zap-gds-name
     2956           tmp#bs.unit-base                             @ gds-zap-unit-base
     2957            kassa[1] format "->>>>>>>>>9.999"           @ f-ostatok-end
     2958            kassa[2]                                    @ f-sumcost
     2959            kassa[3]                                    @ f-sumcrsa
     2960           ""                                           @ f-percent
     2961          with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     2962       if Make-Excel then  put   stream ForExcel unformatted
     2963           v-bar-code                                                   CHR(9)
     2964           ""                                                           CHR(9)
     2965           ub.gds-prt.f-name                                               CHR(9)
     2966           tmp#bs.unit-base                                             CHR(9)
     2967          excel-qnty( kassa[1])         CHR(9)
     2968          excel-sum( kassa[2] )         CHR(9)
     2969          excel-sum (kassa[3] )         CHR(9)
     2970           " "     skip.
     2971           end.
     2972         end.
     2973      end.
     2974   end procedure.
     2975   procedure print-sub-head :
     2976   define input parameter str1 as character no-undo.
     2977   define input parameter str2 as character no-undo.
     2978      display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     2979       ''          @ gds-zap-b-code
     2980       str1             @ gds-zap-artic
     2981       str2             @ gds-zap-gds-name
     2982        with FRAME ZAPAS .
     2983        DOWN stream   OutStream 1 with FRAME ZAPAS.
     2984       if Make-Excel then  put   stream ForExcel unformatted
     2985                 CHR(9)
     2986       str1      CHR(9)
     2987       str2      CHR(9)
     2988                 CHR(9)
     2989                 CHR(9)
     2990                 CHR(9)
     2991                 CHR(9)
     2992       skip.
     2993     run u-line in this-procedure .
     2994   end procedure.
     2995   procedure print-sub-itog :
     2996   define input parameter str1 as character no-undo.
     2997   define input parameter str2 as character no-undo.
     2998   define input parameter q1 like ub.stk-tot.fact-qnty  no-undo.
     2999   define input parameter q2 like ub.stk-tot.sum-rubl   no-undo.
     3000   define input parameter q3 like ub.stk-tot.sum-rubl   no-undo.
     3001     run u-line in this-procedure .
     3002     display stream  outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     3003       'ИТОГО' @ gds-zap-b-code
     3004       str1    @ gds-zap-artic
     3005       str2    @ gds-zap-gds-name
     3006       q1      @ f-ostatok-end
     3007       q2      @ f-sumcost
     3008       q3      @ f-sumcrsa
     3009       with FRAME ZAPAS .
     3010       DOWN stream   OutStream 1 with FRAME ZAPAS.
     3011       if Make-Excel then  put   stream ForExcel unformatted
     3012           'ИТОГО'     CHR(9)
     3013           str1        CHR(9)
     3014           str2        CHR(9)
     3015                       CHR(9)
     3016        excel-qnty(q1) CHR(9)
     3017        excel-sum(q2)  CHR(9)
     3018        excel-sum(q3)  CHR(9)
     3019                     skip.
     3020    run u-line in this-procedure .
     3021   end procedure.
     3022   procedure move-all :
     3023   define variable  tt#          as   integer                 no-undo.
     3024           case ub.ot-line.ext-doc-type:
     3025               when 'ie':U              or
     3026               when 'im':U              then do:
     3027                                                           prih[1 + tt#] = prih[1 + tt#] + ub.ot-line.fact-qnty.
     3028                                                           prih[2 + tt#] = prih[2 + tt#] + ub.ot-line.sum-rubl.
     3029                                                          end.
     3030               when 'rs':U
     3031                                                          then do:
     3032                                                          rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3033                                                          rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3034                                                          end.
     3035               when 're':U
     3036                                                          then do:
     3037                                                          if can-find (first ub.trn-doc where ub.trn-doc.doc-code = ub.ot-line.doc-code
     3038                                                             and ub.trn-doc.cli-code =  x-sale-code
     3039                                                             and ub.trn-doc.cli-type =  x-sale-type
     3040                                                             and ub.trn-doc.discnt-type <> 'касс':U
     3041                                                             and ub.trn-doc.doc-type = 'возврат':U no-lock) then do:
     3042                                                                 rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3043                                                                 rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3044                                                                 end.
     3045                                                            else
     3046                                                            assign
     3047                                                                 rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty
     3048                                                                 rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3049                                                            end.
     3050               when 'es':U         or
     3051               when 'ee':U             or
     3052               when 'ep':U           or
     3053               when 'we':U             or
     3054               when 'vt':U                   or
     3055               when 'vp':U              or
     3056               when 'em':U              or
     3057               when 'wm':U                then do:
     3058                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     3059                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3060                                                          end.
     3061             end case.
     3062   end procedure.
     3063   procedure sale-all :
     3064   define variable  tt#          as   integer                 no-undo.
     3065           case ub.ot-line.ext-doc-type:
     3066               when 'rs':U
     3067                                                          then do:
     3068                                                          rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3069                                                          rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3070                                                          end.
     3071               when 're':U
     3072                                                          then do:
     3073                                                          if can-find (first ub.trn-doc where ub.trn-doc.doc-code = ub.ot-line.doc-code
     3074                                                             and ub.trn-doc.cli-code =  x-sale-code
     3075                                                             and ub.trn-doc.cli-type =  x-sale-type
     3076                                                             and ub.trn-doc.discnt-type <> 'касс':U
     3077                                                             and ub.trn-doc.doc-type = 'возврат':U no-lock) then do:
     3078                                                                 rash[1 + tt#] = rash[1 + tt#] - ub.ot-line.fact-qnty.
     3079                                                                 rash[2 + tt#] = rash[2 + tt#] - ub.ot-line.sum-rubl.
     3080                                                                 end.
     3081                                                            end.
     3082               when 'es':U
     3083                                                             then do:
     3084                                                          rash[1 + tt#] = rash[1 + tt#] + ub.ot-line.fact-qnty.
     3085                                                          rash[2 + tt#] = rash[2 + tt#] + ub.ot-line.sum-rubl.
     3086                                                          end.
     3087             end case.
     3088   end procedure.
     3089   procedure Display-b1 :
     3090   end procedure.
     3091   procedure Display-line :
     3092   end procedure.
     3093   procedure Clear-b1  :
     3094   end procedure.
     3095   procedure Clear-b2  :
     3096   end procedure.
