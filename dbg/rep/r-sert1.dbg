        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-recid              as recid            no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: 51db29575c5c, 1011, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        6   define variable vss-date        as character no-undo init "$Date: Fri Jul 21 16:12:20 2017 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: r-sert1.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/r-sert1.p $":U .
        9   define variable vss-description as character no-undo init "Печатная форма Список сертификатов для накладной расширенна".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define  shared variable RepPathName        as character no-undo .
       73   define  shared variable PrintRubl          as logical   no-undo .
       74   define variable vss-include-info1 as character format "X(65)" no-undo
       75   initial "@(#)$Workfile$ $Revision$".
       76   define temp-table temp_p-fmt_string-part no-undo
       77       field str-key       as integer
       78       field string-part   as character
       79       index pi is primary unique
       80           str-key
       81   .
       82   define variable v-p-fmt-1-str-key    as integer      no-undo.
       83   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       84                                     iInput AS INTEGER).
       85     def var v-start-print as integer no-undo .
       86     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       87     assign
       88       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       89     .
       90     RETURN v-start-print .
       91   END FUNCTION.
       92   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       93                                     iInput AS INTEGER).
       94     def var v-start-print as integer no-undo .
       95     assign
       96       v-start-print = INTEGER(iEndPix - 1 - iInput)
       97     .
       98     if v-start-print < 0 then return 0.
       99     RETURN v-start-print .
      100   END FUNCTION.
      101   function p-fmt-align-string returns character (
      102         p-in-string      as character
      103       , p-page-width     as integer
      104       , p-align-type     as character
      105   ).
      106       define variable v-string-length     as integer      no-undo.
      107       define variable v-out-string        as character    no-undo.
      108       assign
      109           v-string-length = length( trim( p-in-string ) )
      110       .
      111       if v-string-length >= p-page-width
      112       then do:
      113           assign
      114               v-out-string = trim( p-in-string )
      115           .
      116       end.
      117       else do:
      118           case p-align-type
      119           :
      120               when 'left':U
      121               then do:
      122                   assign
      123                       v-out-string = trim( p-in-string )
      124                   .
      125               end.
      126               when 'right':U
      127               then do:
      128                   assign
      129                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      130                   .
      131               end.
      132               when 'center':U
      133               then do:
      134                   assign
      135                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      136                   .
      137               end.
      138           end case.
      139       end.
      140       return v-out-string .
      141   end function.
      142   procedure p-fmt-split-string :
      143   define input parameter p-source-string  as character        no-undo.
      144   define input parameter p-split-length   as integer          no-undo.
      145   define output parameter p-string-1      as character        no-undo.
      146   define output parameter p-string-2      as character        no-undo.
      147   do
      148   on error undo, return error
      149   :
      150       define variable v-space-pos    as integer      no-undo.
      151       if length( p-source-string ) <= p-split-length
      152       then do:
      153           assign
      154               p-string-1 = p-source-string
      155           .
      156       end.
      157       else do:
      158           assign
      159               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      160           .
      161           if v-space-pos = 0
      162           then do:
      163               assign
      164                   v-space-pos = index( p-source-string, " ":U )
      165               .
      166           end.
      167           if v-space-pos = 0
      168           then do:
      169               assign
      170                   p-string-1 = substring( p-source-string, 1, p-split-length )
      171                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      172               .
      173           end.
      174           else do:
      175               assign
      176                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      177                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      178               .
      179           end.
      180       end.
      181   end.
      182   end procedure.
      183   procedure p-fmt-round :
      184   define input parameter p-qnty               as decimal          no-undo.
      185   define input parameter p-price-no-VAT       as decimal          no-undo.
      186   define input parameter p-VAT                as decimal          no-undo.
      187   define input parameter p-SLT                as decimal          no-undo.
      188   define input parameter p-road-tax           as decimal          no-undo.
      189   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      190   define output parameter p-new-VAT           as decimal          no-undo.
      191   define output parameter p-new-SLT           as decimal          no-undo.
      192   define output parameter p-new-sum-VAT       as decimal          no-undo.
      193   define output parameter p-new-sum-SLT       as decimal          no-undo.
      194   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      195   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      196   define output parameter p-new-sum-full      as decimal          no-undo.
      197       define variable v-vat-pc    as decimal      no-undo.
      198       define variable v-slt-pc    as decimal      no-undo.
      199   do
      200   on error undo, return error
      201   :
      202       if p-price-no-VAT = 0
      203       then do:
      204           assign
      205               p-new-price-no-VAT = 0.0
      206               p-new-VAT          = ?
      207               p-new-SLT          = ?
      208               p-new-sum-VAT      = 0.0
      209               p-new-sum-SLT      = 0.0
      210               p-new-sum-no-VAT   = 0.0
      211               p-new-sum-road-tax = 0.0
      212               p-new-sum-full     = 0.0
      213           .
      214       end.
      215       else do:
      216           assign
      217               v-vat-pc            = p-VAT / p-price-no-VAT
      218               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      219               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      220               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      221               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      222               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      223               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      224               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      225               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      226               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      227           .
      228       end.
      229   end.
      230   end procedure.
      231   procedure p-fmt-split :
      232   define input parameter p-in-string      as character        no-undo.
      233   define input parameter p-split-length   as integer          no-undo.
      234       define variable v-start-pos     as integer      no-undo.
      235       define variable v-end-pos       as integer      no-undo.
      236       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      237   do
      238   for buf_temp_p-fmt_string-part
      239   on error undo, return error
      240   :
      241       empty temp-table buf_temp_p-fmt_string-part.
      242       if p-split-length < 1
      243       then do:
      244           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      245       end.
      246       assign
      247           p-in-string                 = trim( p-in-string )
      248           v-p-fmt-1-str-key   = 0
      249           v-start-pos                 = 1
      250           v-end-pos                   = length( p-in-string )
      251       .
      252       run p-fmt-get-string-range in this-procedure (
      253             input p-in-string
      254           , input p-split-length
      255           , input v-start-pos
      256           , output v-start-pos
      257           , output v-end-pos
      258       ).
      259       do while v-end-pos <> 0
      260       :
      261           create buf_temp_p-fmt_string-part.
      262           assign
      263               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      264           .
      265           assign
      266               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      267               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      268           .
      269           assign
      270               v-start-pos = v-end-pos + 1
      271           .
      272           run p-fmt-get-string-range in this-procedure (
      273                 input p-in-string
      274               , input p-split-length
      275               , input v-start-pos
      276               , output v-start-pos
      277               , output v-end-pos
      278           ).
      279       end.
      280   end.
      281   end procedure.
      282   procedure p-fmt-get-string-range :
      283   define input parameter p-in-string      as character        no-undo.
      284   define input parameter p-split-length   as integer          no-undo.
      285   define input parameter p-old-start-pos  as integer          no-undo.
      286   define output parameter p-start-pos     as integer          no-undo.
      287   define output parameter p-end-pos       as integer          no-undo.
      288       define variable v-init-string    as character    no-undo.
      289       define variable v-temp-char      as character    no-undo.
      290       define variable v-temp-pos       as integer      no-undo.
      291       define variable v-counter        as integer      no-undo.
      292   do
      293   on error undo, return error
      294   :
      295       assign
      296           p-start-pos   = p-old-start-pos
      297           v-init-string = substring( p-in-string, p-start-pos )
      298       no-error.
      299       if error-status :error
      300       or trim( v-init-string ) = "":U
      301       then do:
      302           assign
      303               p-end-pos = 0
      304           .
      305           undo, return .
      306       end.
      307       assign
      308           v-temp-char   = substring( v-init-string, 1, 1 )
      309       .
      310       do
      311       while trim( v-temp-char ) = "":U
      312       :
      313           assign
      314               p-start-pos     = p-start-pos + 1
      315               v-init-string   = substring( p-in-string, p-start-pos )
      316               v-temp-char     = substring( v-init-string, 1, 1 )
      317           .
      318       end.
      319       assign
      320           v-temp-pos  = p-split-length
      321           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      322           v-counter   = 0
      323       .
      324       search-word-end:
      325       do
      326       while trim( v-temp-char ) <> "":U
      327       :
      328           assign
      329               v-counter   = v-counter + 1
      330           .
      331           if v-counter > 20
      332           then do:
      333               assign
      334                   v-temp-pos  = p-split-length
      335               .
      336               leave search-word-end.
      337           end.
      338           assign
      339               v-temp-pos  = v-temp-pos - 1
      340               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      341           .
      342       end.
      343       assign
      344           p-end-pos = p-start-pos + v-temp-pos - 1
      345       .
      346   end.
      347   end procedure.
      348   define variable vss-include-info2 as character format "X(65)" no-undo
      349   initial "@(#)$Workfile$ $Revision$".
      350   define variable v-fmtcli-name          as character    no-undo.
      351   define variable v-fmtcli-engl-name     as character    no-undo.
      352   define variable v-fmtcli-addres        as character    no-undo.
      353   define variable v-fmtcli-post-addres   as character    no-undo.
      354   define variable v-fmtcli-full-addres   as character    no-undo.
      355   define variable v-fmtcli-phone         as character    no-undo.
      356   define variable v-fmtcli-inn           as character    no-undo.
      357   define variable v-fmtcli-kpp           as character    no-undo.
      358   define variable v-fmtcli-okpo          as character    no-undo.
      359   define variable v-fmtcli-country       as character    no-undo.
      360   define variable v-fmtcli-city          as character    no-undo.
      361   define variable v-fmtcli-index         as character    no-undo.
      362   define variable v-fmtcli-schet-exists  as logical      no-undo.
      363   define variable v-fmtcli-bank-exists   as logical      no-undo.
      364   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      365   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      366   define variable v-fmtcli-bank-bik      as character    no-undo.
      367   define variable v-fmtcli-bank-name     as character    no-undo.
      368   define variable v-fmtcli-bank-addres   as character    no-undo.
      369   define variable v-fmtcli-bank-city     as character    no-undo.
      370   procedure fmtcli-get-bank :
      371   define input parameter p-host-code      as integer          no-undo.
      372   define input parameter p-obj-type       as character        no-undo.
      373   define input parameter p-obj-code       as integer          no-undo.
      374   define input parameter p-curr-code      as integer          no-undo.
      375       define buffer buf_fin-schet     for ub.fin-schet.
      376       define buffer buf_fin-bank      for ub.fin-bank.
      377   do
      378   for buf_fin-schet
      379     , buf_fin-bank
      380   on error undo, return error
      381   :
      382       assign
      383           v-fmtcli-schet-exists       = no
      384           v-fmtcli-bank-exists        = no
      385           v-fmtcli-bank-r-schet       = "":U
      386           v-fmtcli-bank-c-schet       = "":U
      387           v-fmtcli-bank-bik           = "":U
      388           v-fmtcli-bank-name          = "":U
      389           v-fmtcli-bank-addres        = "":U
      390           v-fmtcli-bank-city          = "":U
      391       .
      392       search-for-schet:
      393       for each buf_fin-schet no-lock
      394          where buf_fin-schet.host-code = p-host-code
      395            and buf_fin-schet.cli-type  = p-obj-type
      396            and buf_fin-schet.cli-code  = p-obj-code
      397            and buf_fin-schet.curr-code = p-curr-code
      398       on error undo, return error
      399       :
      400           if buf_fin-schet.status_   = 'удал':U
      401           then do:
      402           end.
      403           else do:
      404               assign
      405                   v-fmtcli-schet-exists   = yes
      406                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      407                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      408               .
      409               find first buf_fin-bank no-lock
      410                    where buf_fin-bank.host-code = p-host-code
      411                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      412               no-error.
      413               if available buf_fin-bank
      414               then do:
      415                   assign
      416                       v-fmtcli-bank-exists      = yes
      417                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      418                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      419                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      420                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      421                   .
      422               end.
      423               else do:
      424                   assign
      425                       v-fmtcli-bank-exists    = no
      426                       v-fmtcli-bank-bik       = "":U
      427                       v-fmtcli-bank-name      = "":U
      428                       v-fmtcli-bank-addres    = "":U
      429                       v-fmtcli-bank-city      = "":U
      430                   .
      431               end.
      432               leave search-for-schet.
      433           end.
      434       end.
      435   end.
      436   end procedure.
      437   procedure fmtcli-get-client :
      438   define input parameter p-obj-type       as character    no-undo.
      439   define input parameter p-obj-code       as integer      no-undo.
      440       define variable v-temp-fmtcli-address      as character     no-undo.
      441       define variable v-num-country-city    as integer      no-undo.
      442       define buffer buf_clients   for ub.clients.
      443       define buffer buf_firm      for ub.firm.
      444       define buffer buf_store     for ub.store.
      445       define buffer buf_shop      for ub.shop.
      446       define buffer buf_person    for ub.person.
      447   do
      448   for buf_clients
      449     , buf_firm
      450     , buf_store
      451     , buf_shop
      452     , buf_person
      453   on error undo, return error
      454   :
      455       assign
      456           v-fmtcli-name           = "":U
      457           v-fmtcli-addres         = "":U
      458           v-fmtcli-post-addres    = "":U
      459           v-fmtcli-full-addres    = "":U
      460           v-fmtcli-phone          = "":U
      461           v-fmtcli-inn            = "":U
      462           v-fmtcli-kpp            = "":U
      463           v-fmtcli-okpo           = "":U
      464           v-fmtcli-city           = "":U
      465           v-fmtcli-index          = "":U
      466           v-fmtcli-country        = "":U
      467       .
      468       find first buf_clients no-lock
      469            where buf_clients.obj-type = p-obj-type
      470              and buf_clients.obj-code = p-obj-code
      471       .
      472       assign
      473           v-fmtcli-name = buf_clients.obj-name
      474       .
      475       case buf_clients.obj-type:
      476          when 'орг':U
      477          then do:
      478               find first buf_firm no-lock
      479                    where buf_firm.firm-code = buf_clients.obj-code
      480                    no-error
      481               .
      482               if available buf_firm
      483               then do:
      484                   assign
      485                       v-num-country-city = num-entries( buf_firm.city )
      486                       v-fmtcli-engl-name = buf_firm.engl-name
      487                   .
      488                   if v-num-country-city > 0
      489                   then do:
      490                       assign
      491                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      492                       .
      493                   end.
      494                   if v-num-country-city > 1
      495                   then do:
      496                       assign
      497                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      498                       .
      499                   end.
      500                   run fmtcli-concatenate-strings in this-procedure (
      501                         input v-fmtcli-full-addres
      502                       , input v-fmtcli-country
      503                       , input ", ":U
      504                       , input 50
      505                       , output v-fmtcli-full-addres
      506                   ).
      507                   run fmtcli-concatenate-strings in this-procedure (
      508                         input v-fmtcli-full-addres
      509                       , input v-fmtcli-city
      510                       , input ", ":U
      511                       , input 50
      512                       , output v-fmtcli-full-addres
      513                   ).
      514                   run fmtcli-concatenate-strings in this-procedure (
      515                         input v-fmtcli-full-addres
      516                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      517                       , input ", ":U
      518                       , input 50
      519                       , output v-fmtcli-full-addres
      520                   ).
      521                   run fmtcli-concatenate-strings in this-procedure (
      522                         input v-fmtcli-post-addres
      523                       , input v-fmtcli-country
      524                       , input ", ":U
      525                       , input 50
      526                       , output v-fmtcli-post-addres
      527                   ).
      528                   run fmtcli-concatenate-strings in this-procedure (
      529                         input v-fmtcli-post-addres
      530                       , input v-fmtcli-city
      531                       , input ", ":U
      532                       , input 50
      533                       , output v-fmtcli-post-addres
      534                   ).
      535                   run fmtcli-concatenate-strings in this-procedure (
      536                         input v-fmtcli-post-addres
      537                       , input string( buf_firm.ind )
      538                       , input ", ":U
      539                       , input 50
      540                       , output v-fmtcli-post-addres
      541                   ).
      542                   run fmtcli-concatenate-strings in this-procedure (
      543                         input substring( buf_firm.addres1, 1, 50 )
      544                       , input buf_firm.addres2
      545                       , input " ":U
      546                       , input 50
      547                       , output v-temp-fmtcli-address
      548                   ).
      549                   run fmtcli-concatenate-strings in this-procedure (
      550                         input v-temp-fmtcli-address
      551                       , input substring( buf_firm.addres1, 51, 50 )
      552                       , input " ":U
      553                       , input 50
      554                       , output v-temp-fmtcli-address
      555                   ).
      556                   run fmtcli-concatenate-strings in this-procedure (
      557                         input v-temp-fmtcli-address
      558                       , input substring( buf_firm.addres1, 101, 50 )
      559                       , input " ":U
      560                       , input 50
      561                       , output v-temp-fmtcli-address
      562                   ).
      563                   assign
      564                       v-fmtcli-addres = v-temp-fmtcli-address
      565                   .
      566                   if buf_firm.addres1 <> ?
      567                   then do:
      568                       run fmtcli-concatenate-strings in this-procedure (
      569                             input v-fmtcli-full-addres
      570                           , input v-fmtcli-addres
      571                           , input ", ":U
      572                           , input 0
      573                           , output v-fmtcli-full-addres
      574                       ).
      575                   end.
      576                   run fmtcli-concatenate-strings in this-procedure (
      577                         input substring( buf_firm.post-addr1, 1, 50 )
      578                       , input buf_firm.post-addr2
      579                       , input " ":U
      580                       , input 50
      581                       , output v-fmtcli-post-addres
      582                   ).
      583                   run fmtcli-concatenate-strings in this-procedure (
      584                         input v-fmtcli-post-addres
      585                       , input substring( buf_firm.post-addr1, 51, 50 )
      586                       , input " ":U
      587                       , input 50
      588                       , output v-fmtcli-post-addres
      589                   ).
      590                   run fmtcli-concatenate-strings in this-procedure (
      591                         input v-fmtcli-post-addres
      592                       , input substring( buf_firm.post-addr1, 101, 50 )
      593                       , input " ":U
      594                       , input 50
      595                       , output v-fmtcli-post-addres
      596                   ).
      597                   assign
      598                       v-fmtcli-phone         = buf_firm.phone
      599                       v-fmtcli-inn           = buf_firm.inn
      600                       v-fmtcli-kpp           = buf_firm.kpp
      601                       v-fmtcli-okpo          = buf_firm.okpo
      602                       v-fmtcli-index         = string( buf_firm.ind )
      603                   .
      604               end.
      605          end.
      606          when 'маг':U
      607          then do:
      608               find first buf_shop no-lock
      609                    where buf_shop.obj-code = buf_clients.obj-code
      610               .
      611               if available buf_shop
      612               then do:
      613                   run fmtcli-concatenate-strings in this-procedure (
      614                         input buf_shop.addres1
      615                       , input buf_shop.addres2
      616                       , input " ":U
      617                       , input 50
      618                       , output v-fmtcli-addres
      619                   ).
      620                   assign
      621                       v-fmtcli-full-addres = v-fmtcli-addres
      622                       v-fmtcli-post-addres = v-fmtcli-addres
      623                       v-fmtcli-phone       = buf_shop.phone
      624                       v-fmtcli-inn         = "":U
      625                       v-fmtcli-kpp         = "":U
      626                       v-fmtcli-okpo        = "":U
      627                       v-fmtcli-city        = "":U
      628                       v-fmtcli-index       = "":U
      629                   .
      630               end.
      631          end.
      632          when 'скл':U
      633          then do:
      634               find first buf_store no-lock
      635                    where buf_store.obj-code = buf_clients.obj-code
      636               .
      637               if available buf_store
      638               then do:
      639                   run fmtcli-concatenate-strings in this-procedure (
      640                         input buf_store.addres1
      641                       , input buf_store.addres2
      642                       , input " ":U
      643                       , input 50
      644                       , output v-fmtcli-addres
      645                   ).
      646                   assign
      647                       v-fmtcli-full-addres = v-fmtcli-addres
      648                       v-fmtcli-phone       = buf_store.phone
      649                       v-fmtcli-inn         = "":U
      650                       v-fmtcli-kpp         = "":U
      651                       v-fmtcli-okpo        = "":U
      652                       v-fmtcli-city        = "":U
      653                       v-fmtcli-index       = "":U
      654                   .
      655               end.
      656          end.
      657          when 'чел':U
      658          then do:
      659               find first buf_person no-lock
      660                    where buf_person.psn-code = buf_clients.obj-code
      661               .
      662               if available buf_person
      663               then do:
      664                   run fmtcli-concatenate-strings in this-procedure (
      665                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      666                                 then "":U
      667                                 else string( buf_person.ind, "999999")
      668                                 )
      669                       , input buf_person.city
      670                       , input ", ":U
      671                       , input 0
      672                       , output v-fmtcli-full-addres
      673                   ).
      674                   assign
      675                       v-fmtcli-addres = buf_person.address
      676                   .
      677                   run fmtcli-concatenate-strings in this-procedure (
      678                         input v-fmtcli-full-addres
      679                       , input v-fmtcli-addres
      680                       , input ", ":U
      681                       , input 0
      682                       , output v-fmtcli-full-addres
      683                   ).
      684                   assign
      685                       v-fmtcli-phone     = buf_person.phone1
      686                       v-fmtcli-inn       = buf_person.inn
      687                       v-fmtcli-kpp       = buf_person.kpp
      688                       v-fmtcli-okpo      = buf_person.okpo
      689                       v-fmtcli-city      = buf_person.city
      690                       v-fmtcli-index     = string( buf_person.ind )
      691                   .
      692               end.
      693          end.
      694       end case.
      695   end.
      696   end procedure.
      697   procedure fmtcli-concatenate-strings :
      698   define input parameter p-string-1       as character        no-undo.
      699   define input parameter p-string-2       as character        no-undo.
      700   define input parameter p-delimiter      as character        no-undo.
      701   define input parameter p-length         as integer          no-undo.
      702   define output parameter p-out-string    as character        no-undo.
      703   do
      704   on error undo, return error
      705   :
      706       assign
      707           p-out-string = ( if p-string-1 = ?
      708                            then "":U
      709                            else trim( p-string-1 ) )
      710       .
      711       assign
      712           p-out-string = p-out-string
      713                        + ( if p-out-string = "":U
      714                            or length( p-out-string ) = p-length
      715                            or p-string-2 = ?
      716                            or trim( p-string-2 ) = "":U
      717                            then "":U
      718                            else p-delimiter )
      719                        + ( if p-string-2 = ?
      720                            or trim( p-string-2 ) = "":U
      721                            then "":U
      722                            else trim( p-string-2 ) )
      723       .
      724   end.
      725   end procedure.
