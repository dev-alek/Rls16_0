     3845                     v-torgconf-ogr-name = buf_shop.director
     3846                     v-torgconf-ogr-post = "Директор"
     3847                  .
     3848               END.
     3849               WHEN 'скл':U
     3850               THEN DO:
     3851                  find first buf_store no-lock
     3852                  where buf_store.obj-code = buf_trn-doc.obj-code
     3853                  .
     3854                  assign
     3855                     v-torgconf-ogr-name = buf_store.store-boss
     3856                     v-torgconf-ogr-post = "Директор"
     3857                  .
     3858               END.
     3859               OTHERWISE DO:
