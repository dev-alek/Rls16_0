     1876   procedure torgconf-get-sup-param :
     1877   define input parameter p-obj-type           as character        no-undo.
     1878   define input parameter p-obj-code           as integer          no-undo.
     1879   define input parameter p-curr-code          as integer          no-undo.
     1880       define variable v-host-code    as integer      no-undo.
     1881       define variable v-par-type     as character    no-undo.
     1882   do
     1883   on error undo, return error
     1884   :
     1885       assign
     1886          v-torgconf-sup-host-code = v-host-code
     1887       .
     1888       if v-torgconf-sup-host-code = 0
     1889       then do:
     1890           assign
     1891               v-torgconf-sup-host-name           = "":U
     1892               v-torgconf-sup-host-addres         = "":U
     1893               v-torgconf-sup-host-post-addres    = "":U
     1894               v-torgconf-sup-host-phone          = "":U
     1895               v-torgconf-sup-host-inn            = "":U
     1896               v-torgconf-sup-host-kpp            = "":U
     1897               v-torgconf-sup-host-okpo           = "":U
     1898               v-torgconf-sup-host-egrip-date     = "":U
     1899               v-torgconf-sup-host-egrip-num      = "":U
     1900           .
     1901       end.
     1902       else do:
     1903           run fmtcli-get-client in this-procedure (
     1904                 input 'орг':U
     1905               , input v-torgconf-sup-host-code
     1906           ).
     1907           assign
     1908               v-torgconf-sup-host-name        = v-fmtcli-name
     1909               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1910               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1911               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1912               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1913               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1914               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1915               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1916           .
     1917           run gbl/clntat-v.p (
     1918                 input 'орг':U
     1919               , input v-torgconf-sup-host-code
     1920               , input 'egrip-date':U
     1921               , output v-torgconf-sup-host-egrip-date
     1922               , output v-par-type
     1923           ).
     1924           run gbl/clntat-v.p (
     1925                 input 'орг':U
     1926               , input v-torgconf-sup-host-code
     1927               , input 'egrip-num':U
     1928               , output v-torgconf-sup-host-egrip-num
     1929               , output v-par-type
     1930           ).
     1931           run fmtcli-get-bank in this-procedure (
     1932                 input v-host-code
     1933               , input 'орг':U
     1934               , input v-torgconf-sup-host-code
     1935               , input p-curr-code
     1936           ).
     1937       end.
     1938       assign
     1939           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1940           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1941           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1942           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1943           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1944           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1945           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1946           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1947       .
     1948       assign
     1949           v-torgconf-sup-obj-type = p-obj-type
     1950           v-torgconf-sup-obj-code = p-obj-code
     1951       .
     1952       if trim(p-obj-type) <> ""
     1953       and p-obj-code <> 0
     1954       then do:
     1955       run fmtcli-get-client in this-procedure (
     1956             input p-obj-type
     1957           , input p-obj-code
     1958       ).
     1959       assign
     1960           v-torgconf-sup-obj-name        = v-fmtcli-name
     1961           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1962           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1963           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1964           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1965           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1966           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1967       .
     1968      end.
     1969      end.
     1970   end procedure.
     1971   procedure torgconf-get-cli-param :
     1972   define input parameter p-host-obj-code      as integer          no-undo.
     1973   define input parameter p-obj-type           as character        no-undo.
     1974   define input parameter p-obj-code           as integer          no-undo.
     1975   define input parameter p-curr-code          as integer          no-undo.
     1976       define variable v-host-code    as integer      no-undo.
     1977   do
     1978   on error undo, return error
     1979   :
     1980       assign
     1981           v-torgconf-cli-type = p-obj-type
     1982           v-torgconf-cli-code = p-obj-code
     1983       .
     1984       run fmtcli-get-client in this-procedure (
     1985             input p-obj-type
     1986           , input p-obj-code
     1987       ).
     1988       assign
     1989           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1990           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1991           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1992           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1993           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1994           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1995           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1996           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1997       .
     1998      run fmtcli-get-bank in this-procedure (
     1999             input p-host-obj-code
     2000           , input p-obj-type
     2001           , input p-obj-code
     2002           , input p-curr-code
     2003       ).
     2004       assign
     2005           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2006           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2007           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2008           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2009           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2010           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2011           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2012           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2013       .
     2014   end.
     2015   end procedure.
     2016   procedure torgconf-get-ship-param :
     2017   define input parameter p-host-obj-code      as integer          no-undo.
     2018   define input parameter p-obj-type           as character        no-undo.
     2019   define input parameter p-obj-code           as integer          no-undo.
     2020   define input parameter p-curr-code          as integer          no-undo.
     2021       define variable v-host-code    as integer      no-undo.
     2022   do
     2023   on error undo, return error
     2024   :
     2025       assign
     2026           v-torgconf-ship-type = p-obj-type
     2027           v-torgconf-ship-code = p-obj-code
     2028       .
     2029       if trim(p-obj-type) = ""
     2030       and p-obj-code = 0
     2031       then do:
     2032       assign
     2033           v-torgconf-ship-name         = "":U
     2034           v-torgconf-ship-addres       = "":U
     2035           v-torgconf-ship-post-addres  = "":U
     2036           v-torgconf-ship-phone        = "":U
     2037           v-torgconf-ship-inn          = "":U
     2038           v-torgconf-ship-kpp          = "":U
     2039           v-torgconf-ship-okpo         = "":U
     2040       .
     2041       end.
     2042       else do:
     2043       run fmtcli-get-client in this-procedure (
     2044             input p-obj-type
     2045           , input p-obj-code
     2046       ).
     2047       assign
     2048           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2049           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2050           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2051           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2052           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2053           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2054           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2055           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2056       .
     2057       end.
     2058           run fmtcli-get-bank in this-procedure (
     2059             input p-host-obj-code
     2060           , input p-obj-type
     2061           , input p-obj-code
     2062           , input p-curr-code
     2063       ).
     2064       assign
     2065           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2066           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2067           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2068           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2069           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2070           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2071           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2072           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2073       .
     2074   end.
     2075   end procedure.
     2076   procedure torgconf-get-holdfirm-code :
     2077   define input parameter p-obj-type   as character        no-undo.
     2078   define input parameter p-obj-code   as integer          no-undo.
     2079   define output parameter p-firm-code as integer          no-undo.
     2080       define variable v-firm-code-str     as character    no-undo.
     2081       define variable v-par-type          as character    no-undo.
     2082       define buffer buf_clients       for ub.clients.
     2083   do
     2084   for buf_clients
     2085   on error undo, return error
     2086   :
     2087       run gbl/clntat-v.p (
     2088             input p-obj-type
     2089           , input p-obj-code
     2090           , input 'holdfirm-code':U
     2091           , output v-firm-code-str
     2092           , output v-par-type
     2093       ).
     2094       assign
     2095           p-firm-code = integer( v-firm-code-str )
     2096       no-error.
     2097       if error-status :error
     2098       then do:
     2099           message
     2100               "Неверно задан код фирмы для печати накладных."
     2101           view-as alert-box warning.
     2102           assign
     2103               p-firm-code = 0
     2104           .
     2105       end.
     2106       else do:
     2107           find first buf_clients no-lock
     2108                where buf_clients.obj-type = 'орг':U
     2109                  and buf_clients.obj-code = p-firm-code
     2110           no-error.
     2111           if not available buf_clients
     2112           then do:
     2113               message
     2114                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2115                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2116               view-as alert-box warning.
     2117               assign
     2118                   p-firm-code = 0
     2119               .
     2120           end.
     2121       end.
     2122   end.
     2123   end procedure.
     2124   procedure torgconf-get-post-head:
     2125   define input  parameter p-obj-type             as character        no-undo.
     2126   define input  parameter p-obj-code             as integer          no-undo.
     2127   define output parameter p-torgconf-post-head   as character        no-undo.
     2128      define variable v-host-code         as integer      no-undo.
     2129      define buffer buf_sysconf     for ub.sysconf.
     2130        assign
     2131         p-torgconf-post-head  = ""
     2132        .
     2133   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2135     (input  p-obj-type
     2136     ,input  p-obj-code
     2137     ,output v-host-code
     2138     )  .
     2139      find first buf_sysconf no-lock
     2140      where buf_sysconf.host-code = v-host-code
     2141      no-error.
     2142      if available buf_sysconf
     2143      then do:
     2144         assign
     2145            p-torgconf-post-head = buf_sysconf.head-position
     2146         .
     2147      end.
     2148   end procedure.
     2149   procedure torgconf-get-storekeeper:
     2150   define input  parameter p-wrkr                   as integer          no-undo.
     2151   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2152   define output parameter p-torgconf-post          as character        no-undo.
     2153      define buffer buf_sysconf     for ub.sysconf.
     2154      define buffer buf_person      for ub.person.
     2155      define buffer buf_shop        for ub.shop .
     2156      define buffer buf_store       for ub.store .
     2157      if v-torgconf-outC = "no_print"
     2158      then do:
     2159         assign p-torgconf-post = ""
     2160                p-torgconf-wrkr-name = ""
     2161                .
     2162      end.
     2163      if v-torgconf-outC = "clad_doc"
     2164      then do:
     2165         run rep/get-psn.p
     2166               (input  p-wrkr
     2167               ,output p-torgconf-wrkr-name
     2168               ) .
     2169         find first buf_person no-lock
     2170         where buf_person.psn-code = p-wrkr
     2171         no-error.
     2172         if available buf_person
     2173         then do:
     2174           p-torgconf-post = buf_person.position.
     2175         end.
     2176         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2177         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2178      end.
     2179      if v-torgconf-outC = "clad_obj"
     2180      then do:
     2181         CASE v-torgconf-self-obj-type:
     2182         WHEN 'маг':U
     2183         THEN DO:
     2184            find first buf_shop no-lock
     2185            where buf_shop.obj-code = v-torgconf-self-obj-code
     2186            .
     2187            assign
     2188               p-torgconf-wrkr-name = buf_shop.store-man
     2189               p-torgconf-post = ""
     2190            .
     2191            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2192         END.
     2193         WHEN 'скл':U
     2194         THEN DO:
     2195            find first buf_store no-lock
     2196            where buf_store.obj-code = v-torgconf-self-obj-code
     2197            .
     2198            assign
     2199               p-torgconf-wrkr-name = buf_store.store-man
     2200               p-torgconf-post = ""
     2201            .
     2202            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2203         END.
     2204         OTHERWISE DO:
     2205            assign
     2206               p-torgconf-post = "":U
     2207               p-torgconf-wrkr-name = "":U
     2208            .
     2209         END.
     2210         END CASE.
     2211      end.
     2212    end procedure.
     2213   procedure torgconf-get-form-header :
     2214   define input parameter p-for-inverse    as logical          no-undo.
     2215   define input parameter p-doc-code       as character        no-undo.
     2216   define input parameter p-print-doc      as logical          no-undo.
     2217   define input parameter p-doc-date       as date             no-undo.
     2218   define input parameter p-fact-date      as date             no-undo.
     2219   define input parameter p-doc-type       as character        no-undo.
     2220   define input parameter p-status_        as character        no-undo.
     2221   define input parameter p-reverse        as logical          no-undo.
     2222   define input parameter p-sf-par         as logical          no-undo.
     2223       define variable v-attr-type         as character    no-undo.
     2224       define variable v-doc-code-standard as logical      no-undo.
     2225       define variable v-doc-date-standard as logical      no-undo.
     2226       define variable v-par-consignee-addres  as character    no-undo.
     2227       define variable v-host-code         as integer      no-undo.
     2228       define variable v-dcode-attr        as character    no-undo.
     2229       define variable v-ddate-attr        as character    no-undo.
     2230       define variable v-doc-date          as character    no-undo.
     2231       define variable v-doc-code          as character    no-undo.
     2232       define variable v-par-type          as character    no-undo.
     2233       define variable v-attr              as character    no-undo.
     2234       define buffer buf_firm          for ub.firm .
     2235       define buffer buf_clients       for ub.clients .
     2236       define buffer buf_sysconf       for ub.sysconf .
     2237       define buffer buf_shop          for ub.shop .
     2238       define buffer buf_store         for ub.store .
     2239       define buffer buf_person        for ub.person .
     2240       define buffer buf_trn-doc       for ub.trn-doc .
     2241       define buffer buf_wth-doc       for ub.wth-doc .
     2242       do
     2243   for buf_firm
     2244     , buf_clients
     2245     , buf_sysconf
     2246     , buf_shop
     2247     , buf_trn-doc
     2248     , buf_person
     2249     , buf_wth-doc
     2250   on error undo, return error
     2251   :
     2252       if p-doc-type = 'при':U
     2253       or p-doc-type = 'возврат':U
     2254       then do:
     2255           assign
     2256               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2257                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2258               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2259                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2260               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2261                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2262               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2263                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2264               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2265               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2266               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2267               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2268               v-torgconf-supplier-type    = v-torgconf-cli-type
     2269               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2270               v-torgconf-saler-type       = v-torgconf-self-host-type
     2271               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2272               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2273               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2274               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2275               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2276               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2277               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2278               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2279               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2280               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2281               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2282               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2283               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2284               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2285               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2286           .
     2287           if v-torgconf-cli-schet-exists = yes
     2288           AND v-form-name                  = "torg12":U
     2289           then do:
     2290               assign
     2291                   v-torgconf-supplier = v-torgconf-supplier
     2292                       + substitute( ", р/с &1 к/с &2"
     2293                                   , v-torgconf-cli-bank-r-schet
     2294                                   , v-torgconf-cli-bank-c-schet
     2295                                   )
     2296                   v-torgconf-suppi = v-torgconf-supplier
     2297                       + substitute( ", р/с &1 к/с &2"
     2298                                   , v-torgconf-cli-bank-r-schet
     2299                                   , v-torgconf-cli-bank-c-schet
     2300                                   )
     2301               .
     2302               if v-torgconf-cli-bank-exists = yes
     2303               then do:
     2304                   assign
     2305                       v-torgconf-supplier = v-torgconf-supplier
     2306                           + substitute( " БИК &1 в &2 &3"
     2307                                       , v-torgconf-cli-bank-bik
     2308                                       , v-torgconf-cli-bank-name
     2309                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2310                                       )
     2311                      v-torgconf-suppi = v-torgconf-supplier
     2312                           + substitute( " БИК &1 в &2 &3"
     2313                                       , v-torgconf-cli-bank-bik
     2314                                       , v-torgconf-cli-bank-name
     2315                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2316                                       )
     2317                   .
     2318               end.
     2319           end.
     2320           if v-torgconf-self-schet-exists = yes
     2321           AND v-form-name                  = "torg12":U
     2322           then do:
     2323               assign
     2324                   v-torgconf-saler = v-torgconf-saler
     2325                       + substitute( ", р/с &1 к/с &2"
     2326                                   , v-torgconf-self-bank-r-schet
     2327                                   , v-torgconf-self-bank-c-schet
     2328                                   )
     2329               .
     2330               if v-torgconf-self-bank-exists = yes
     2331               then do:
     2332                   assign
     2333                       v-torgconf-saler = v-torgconf-saler
     2334                           + substitute( " БИК &1 в &2 &3"
     2335                                       , v-torgconf-self-bank-bik
     2336                                       , v-torgconf-self-bank-name
     2337                                       , v-torgconf-self-bank-addres
     2338                                       )
     2339                   .
     2340               end.
     2341           end.
     2342           if v-torgconf-sup-schet-exists = yes
     2343           AND v-form-name                  = "torg12":U
     2344           then do:
     2345               assign
     2346                   v-torgconf-consignee = v-torgconf-consignee
     2347                       + substitute( ", р/с &1 к/с &2"
     2348                                   , v-torgconf-sup-bank-r-schet
     2349                                   , v-torgconf-sup-bank-c-schet
     2350                                   )
     2351               .
     2352             if v-torgconf-sup-bank-exists = yes
     2353              then do:
     2354                assign
     2355                   v-torgconf-consignee = v-torgconf-consignee
     2356                           + substitute( " БИК &1 в &2 &3"
     2357                                       , v-torgconf-sup-bank-bik
     2358                                       , v-torgconf-sup-bank-name
     2359                                       , v-torgconf-sup-bank-addres
     2360                                       )
     2361                   .
     2362               end.
     2363           end.
     2364      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2365      then do:
     2366          assign
     2367            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2368                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2369                                                   , v-torgconf-cli-name
     2370                                                   , ( if v-torgconf-outprncd = yes
     2371                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2372                                                         else "":U )
     2373                                                   , v-torgconf-cli-post-addres
     2374                                                   , v-torgconf-cli-phone
     2375                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2376                                                       AND v-form-name                  = "torg12":U
     2377                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2378                                                               , v-torgconf-cli-bank-r-schet
     2379                                                               , v-torgconf-cli-bank-c-schet
     2380                                                               , v-torgconf-cli-bank-bik
     2381                                                               , v-torgconf-cli-bank-name
     2382                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2383                                                         else "":U )
     2384                                                )
     2385         .
     2386      end.
     2387       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2388                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2389                                        , v-torgconf-cli-name
     2390                                        , ( if v-torgconf-outprncd = yes
     2391                                            then substitute( " (&1)", v-torgconf-cli-code )
     2392                                            else "":U )
     2393                                        , v-torgconf-cli-addres
     2394                                        , v-torgconf-cli-phone
     2395                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2396                                            AND v-form-name                  = "torg12":U
     2397                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2398                                                           , v-torgconf-cli-bank-r-schet
     2399                                                           , v-torgconf-cli-bank-c-schet
     2400                                                           , v-torgconf-cli-bank-bik
     2401                                                           , v-torgconf-cli-bank-name
     2402                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2403                                                   else "":U )
     2404                                        ).
     2405       end.
     2406       else do:
     2407       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2408                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2409                                        , v-torgconf-self-host-name
     2410                                        , ( if v-torgconf-outprncd = yes
     2411                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2412                                            else "":U )
     2413                                        , v-torgconf-self-host-addres
     2414                                        , v-torgconf-self-host-phone
     2415                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2416                                            AND v-form-name                  = "torg12":U
     2417                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2418                                                           , v-torgconf-self-bank-r-schet
     2419                                                           , v-torgconf-self-bank-c-schet
     2420                                                           , v-torgconf-self-bank-bik
     2421                                                           , v-torgconf-self-bank-name
     2422                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2423                                                   else "":U )
     2424                                           ).
     2425         if v-torgconf-outares = yes
     2426         and p-reverse = no
     2427         then do:
     2428            assign
     2429               v-par-consignee-addres = v-torgconf-ship-post-addres
     2430            .
     2431         end.
     2432         if v-torgconf-outares = no
     2433         and p-reverse = no
     2434         then do:
     2435            assign
     2436               v-par-consignee-addres = v-torgconf-ship-addres
     2437            .
     2438         end.
     2439         if p-reverse = yes
     2440         then do:
     2441             assign
     2442               v-par-consignee-addres = v-torgconf-ship-addres
     2443             .
     2444         end.
     2445           assign
     2446               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2447                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2448               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2449                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2450               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2451                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2452               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2453               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2454               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2455               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2456               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2457               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2458               v-torgconf-saler-type       = v-torgconf-cli-type
     2459               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2460               v-torgconf-consignee-type   = v-torgconf-ship-type
     2461               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2462               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2463               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2464               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2465               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2466               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2467               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2468               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2469               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2470               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2471               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2472               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2473               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2474               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2475               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2476               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2477               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2478           .
     2479           if v-torgconf-self-schet-exists = yes
     2480           AND v-form-name                  = "torg12":U
     2481           then do:
     2482               assign
     2483                   v-torgconf-supplier = v-torgconf-supplier
     2484                       + substitute( ", р/с &1 к/с &2"
     2485                                   , v-torgconf-self-bank-r-schet
     2486                                   , v-torgconf-self-bank-c-schet
     2487                                   )
     2488               .
     2489               if v-torgconf-self-bank-exists = yes
     2490               then do:
     2491                   assign
     2492                       v-torgconf-supplier = v-torgconf-supplier
     2493                           + substitute( " БИК &1 в &2 &3"
     2494                                       , v-torgconf-self-bank-bik
     2495                                       , v-torgconf-self-bank-name
     2496                                       , v-torgconf-self-bank-addres
     2497                                       )
     2498                   .
     2499               end.
     2500           end.
     2501           if v-torgconf-cli-schet-exists = yes
     2502           AND v-form-name                  = "torg12":U
     2503           then do:
     2504               assign
     2505                   v-torgconf-saler = v-torgconf-saler
     2506                       + substitute( ", р/с &1 к/с &2"
     2507                                   , v-torgconf-cli-bank-r-schet
     2508                                   , v-torgconf-cli-bank-c-schet
     2509                                   )
     2510               .
     2511               if v-torgconf-cli-bank-exists = yes
     2512               then do:
     2513                   assign
     2514                       v-torgconf-saler = v-torgconf-saler
     2515                           + substitute( " БИК &1 в &2 &3"
     2516                                       , v-torgconf-cli-bank-bik
     2517                                       , v-torgconf-cli-bank-name
     2518                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2519                                       )
     2520                   .
     2521               end.
     2522           end.
     2523           if v-torgconf-ship-schet-exists = yes
     2524           AND v-form-name                  = "torg12":U
     2525           then do:
     2526               assign
     2527                   v-torgconf-consignee = v-torgconf-consignee
     2528                       + substitute( ", р/с &1 к/с &2"
     2529                                   , v-torgconf-ship-bank-r-schet
     2530                                   , v-torgconf-ship-bank-c-schet
     2531                                   )
     2532               .
     2533               if v-torgconf-ship-bank-exists = yes
     2534               then do:
     2535                   assign
     2536                       v-torgconf-consignee = v-torgconf-consignee
     2537                           + substitute( " БИК &1 в &2  &3"
     2538                                       , v-torgconf-ship-bank-bik
     2539                                       , v-torgconf-ship-bank-name
     2540                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     2541                                       )
     2542                   .
     2543               end.
     2544           end.
     2545      if p-reverse = yes
     2546         then do:
     2547          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     2548            .
     2549          else v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres       ) .
     2550                 if v-torgconf-cli-schet-exists = yes
     2551                 AND v-form-name                  = "torg12":U
     2552                     then do:
     2553                           assign
