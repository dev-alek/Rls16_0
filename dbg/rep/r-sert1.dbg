     3883            then do:
     3884               v-torgconf-ogr-post = buf_person.position.
     3885            end.
     3886            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3887            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3888         end.
     3889      end.
     3890      else do:
     3891      find first buf_wth-doc no-lock
     3892         where buf_wth-doc.doc-code = p-doc-code
     3893         no-error.
     3894         if v-torgconf-outogr = "no_print"
     3895            then do:
