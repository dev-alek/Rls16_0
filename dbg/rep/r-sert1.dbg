     1590               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1591               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1592               v-torgconf-self-host-phone       = v-fmtcli-phone
     1593               v-torgconf-self-host-inn         = v-fmtcli-inn
     1594               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1595               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1596           .
     1597           run gbl/clntat-v.p (
