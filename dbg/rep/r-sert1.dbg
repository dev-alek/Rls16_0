     1647   procedure torgconf-get-recepient-param :
     1648   define input parameter torgconfdoc-code   as character                  no-undo.
     1649   define output parameter v-code-rec        as integer                    no-undo .
     1650   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1651   define output parameter v-codefirm-rec    as integer                    no-undo .
     1652   define output parameter v-curcode-rec     as integer                    no-undo .
     1653        define variable  v-recipient-code  as character                  no-undo .
     1654        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1655        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1656   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1657                           input 'Recipient':U ,
     1658                          output v-recipient-code ,
     1659                          output v-trdcattr-type ) no-error .
     1660       if error-status :error then do:
     1661        message
     1662         vss-workfile vss-revision vss-description skip
     1663         "Ошибка при вызове процедуры tdat-val":U skip
     1664         "Документ: " torgconfdoc-code skip
     1665         "Атрибут: " 'Recipient':U skip
     1666         "Значение: " v-recipient skip
     1667         trim( error-status :get-message (1) ) skip
     1668         return-value skip
     1669         view-as alert-box error.
     1670       undo, return error return-value.
     1671       end.
     1672     assign
     1673       v-recipient  = v-recipient-code
     1674       v-type-rec = substring(v-recipient-code,1,3)
     1675       v-code-rec  = int(substring(v-recipient-code,4,15))
     1676       no-error
     1677     .
     1678     if v-type-rec = ? then v-type-rec = "" .
     1679     if v-code-rec  = ? then v-code-rec  =  0 .
     1680     end procedure.
