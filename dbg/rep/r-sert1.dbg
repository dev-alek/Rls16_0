     3797      if  p-form-name <> 'wthtrg12':U
     3798      and p-form-name <> 'wthfct':U
     3799      and p-form-name <> 'wthm11':U
     3800      then do:
     3801       find first buf_trn-doc no-lock
     3802       where buf_trn-doc.doc-code = p-doc-code
     3803       no-error.
