     1219   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1220   procedure wthcattr-sprcli :
     1221   define input parameter parparentproc  as widget-handle no-undo.
     1222   define input parameter p-mode  as character no-undo.
     1223   define input-output parameter p-value as character no-undo .
     1224   define output parameter p-setted as logical no-undo .
     1225     DEFINE VARIABLE v-value as character no-undo .
     1226     define variable v-cli-type as character no-undo .
     1227     define variable v-cli-code as integer no-undo .
     1228     define buffer buf_clients   for ub.clients.
     1229     define variable v_rid as character no-undo.
     1230     define variable ref-rec as recid no-undo .
     1231     do
     1232     on error undo, return error
     1233     :
     1234         v-value = p-value.
     1235      if p-value <> '':U then do:
     1236       assign
     1237       v-cli-type = substring(p-value, 1, 3)
     1238       v-cli-code = integer(substring(p-value, 4))
     1239       no-error.
     1240       if error-status:error then do:
     1241         assign
     1242         v-cli-type = '':U
     1243         v-cli-code = 0
     1244         .
     1245       end.
     1246      end.
     1247      FIND FIRST buf_clients NO-LOCK WHERE
     1248               buf_clients.obj-type = v-cli-type AND
     1249               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1250      IF available(buf_clients) then do:
     1251       run ref/cli-all.w (
     1252                   input parparentproc
     1253                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1254                  ,input v-cli-type
     1255                  ,input 'все':U
     1256                  ,input 'все':U
     1257                  ,input RECID( buf_clients )
     1258                  ,input ",,,,,,NO"
     1259                  ,input ?
     1260                  ,OUTPUT v_rid ).
     1261     END.
     1262     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1263       run ref/cli-all.w (
     1264                    input parparentproc
     1265                   ,INPUT "b-sel":U
     1266                  ,input  v-cli-type
     1267                  ,input 'все':U
     1268                  ,input 'текущие':U
     1269                  ,input ?
     1270                  ,input ",,,,,,NO"
     1271                  ,input ?
     1272                  ,OUTPUT v_rid ).
     1273     END.
     1274     else do:
     1275       message
     1276       if p-value = "":U then 'Атрибут не задан!'
     1277       else substitute('Не найден клиент &1',p-value)
     1278       view-as alert-box warning.
     1279     end.
     1280     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1281       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1282       IF ERROR-STATUS:ERROR THEN DO:
     1283           RETURN NO-APPLY.
     1284       END.
     1285       FIND FIRST buf_clients NO-LOCK WHERE
     1286                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1287       IF AVAIL buf_clients THEN DO:
     1288         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1289       end.
     1290     end.
     1291     if v-value <> p-value then do:
     1292       p-value = v-value.
     1293       p-setted = yes.
     1294     end.
     1295     end.
     1296   end procedure.
     1297     define new global shared variable g#wthcalib as handle no-undo.
     1298   procedure torgconf-read :
     1299   do
     1300   on error undo, return error
     1301   :
     1302       define input parameter p-form-name  as character    no-undo.
     1303       define input parameter p-host-code  as integer      no-undo.
     1304       define input parameter p-obj-type   as character    no-undo.
     1305       define input parameter p-obj-code   as integer      no-undo.
     1306       define variable v-outdate   as character     no-undo.
     1307       define variable v-outares   as character     no-undo.
     1308       define variable v-outsend   as character     no-undo.
     1309       define variable v-outasend  as character     no-undo.
     1310       define variable v-outprops  as character     no-undo.
     1311       define variable v-outnum    as character     no-undo.
     1312       define variable v-outprim   as character     no-undo.
     1313       define variable v-outdisc   as character     no-undo.
     1314       define variable v-outsubs   as character     no-undo.
     1315       define variable v-outrecv   as character     no-undo.
     1316       define variable v-outegrp   as character     no-undo.
     1317       define variable v-outt12    as character     no-undo.
     1318       define variable v-outappr   as character     no-undo.
     1319       define variable v-outrubl   as character     no-undo.
     1320       define variable v-outhold   as character     no-undo.
     1321       define variable v-outobj    as character     no-undo.
     1322       define variable v-outexlst  as character     no-undo.
     1323       define variable v-outprncd  as character     no-undo.
     1324       define variable v-par-type  as character     no-undo.
     1325       define variable v-outogr    as character     no-undo.
     1326       define variable v-outR      as character     no-undo.
     1327       define variable v-outB      as character     no-undo.
     1328       define variable v-outC      as character     no-undo.
     1329       assign
     1330           v-torgconf-outdate  = no
     1331           v-torgconf-outnum   = no
     1332           v-torgconf-outprim  = no
     1333           v-torgconf-outdisc  = no
     1334           v-torgconf-outsubs  = no
     1335           v-torgconf-outrecv  = no
     1336           v-torgconf-outegrp  = no
     1337           v-torgconf-outt12   = no
     1338           v-torgconf-outappr  = no
     1339           v-torgconf-outrubl  = no
     1340           v-torgconf-outhold  = no
     1341           v-torgconf-outobj   = no
     1342           v-torgconf-outexlst = no
     1343           v-torgconf-outexpas = "":U
     1344           v-torgconf-outprncd = yes
     1345           v-torgconf-outares  = no
     1346           v-torgconf-outsend  = no
     1347           v-torgconf-outasend  = no
     1348           v-torgconf-outprops  = no
     1349           v-form-name          = p-form-name
     1350       .
     1351   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1352   empty temp-table thbjattr_thbj-attr.
     1353   run adm/shattri.p (
     1354      input "get":U
     1355     ,input ''
     1356     ,input 0
     1357     ,input 'prt-glob':U
     1358     ,input  ""
     1359     ,output v-value-character
     1360     ,output v-value-date
     1361     ,output v-value-decimal
     1362     ,output v-value-integer
     1363     ,output v-value-logical
     1364     ,output par-type
     1365     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1366     ) no-error .
     1367   for each thbjattr_thbj-attr :
     1368       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
