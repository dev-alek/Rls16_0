     3730                  assign
     3731                     v-torgconf-ogr-post = buf_sysconf.head-position
     3732                  .
     3733               end.
     3734               find first buf_clients no-lock
     3735                  where buf_clients.obj-type = 'орг':U
     3736                  and buf_clients.obj-code = v-host-code
     3737               .
     3738               find first buf_firm no-lock
