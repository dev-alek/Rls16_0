     3446                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     3447                                                   , ( if p-status_ <> 'факт':U
     3448                                                      then string( "(" + caps( p-status_ ) + ")" )
     3449                                                      else "":U )
     3450                                                )
     3451               .
     3452            end.
     3453            else do:
     3454            if trim(v-attr) = ""
     3455            then do:
     3456               assign
     3457                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     3458                                                           v-torgconf-doc-code,
     3459                                                           v-torgconf-doc-date,
     3460                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     3461                                                           )
     3462               .
     3463            end.
     3464            else do:
     3465               assign
     3466                  v-torgconf-plat-rasch-doc = v-attr.
     3467            end.
     3468            end.
     3469        end.
     3470        otherwise do:
     3471            if  v-name <> 'wthtrg12'
     3472            and v-name <> 'wthfct'
     3473            and v-name <> 'wthm11'
     3474            then do:
     3475               IF v-dcode-attr <> "":U
     3476               OR v-ddate-attr <> "":U
     3477               THEN
     3478               assign
     3479                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     3480                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3481                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3482                                                   )
     3483               .
     3484            end.
     3485            else do:
     3486               assign
     3487                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3488               .
     3489            end.
     3490        end.
     3491       end case.
     3492      if v-torgconf-outB = "no_print"
     3493      then do:
     3494         assign v-torgconf-main-buh = "".
     3495      end.
     3496      if v-torgconf-outB = "glbuh_firm"
     3497      then do:
     3498            if v-torgconf-self-host-code = 0
     3499            then do:
     3500            end.
     3501            else do:
     3502               find first buf_sysconf no-lock
     3503                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3504               .
     3505               assign
     3506                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3507               .
     3508            end.
     3509      end.
     3510      if v-torgconf-outB = "buh_obj"
     3511      then do:
     3512         CASE v-torgconf-self-obj-type:
     3513         WHEN 'маг':U
     3514         THEN DO:
     3515            find first buf_shop no-lock
     3516            where buf_shop.obj-code = v-torgconf-self-obj-code
     3517            .
     3518            assign
     3519               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     3520            .
     3521         END.
     3522         WHEN 'скл':U
     3523         THEN DO:
     3524            find first buf_store no-lock
     3525            where buf_store.obj-code = v-torgconf-self-obj-code
     3526            .
     3527            assign
     3528               v-torgconf-main-buh  = buf_store.store-man
     3529            .
     3530         END.
     3531         OTHERWISE DO:
     3532            assign
     3533               v-torgconf-main-buh  = "":U
     3534            .
     3535         END.
     3536         END CASE.
     3537      end.
     3538      if v-torgconf-outR = "no_print"
     3539         then do:
     3540            assign
     3541               v-torgconf-main-boss = ""
     3542               v-torgconf-main-boss-post = ""
     3543            .
     3544         end.
     3545      if v-torgconf-outR = "ruk_firm"
     3546         then do:
     3547            find first buf_sysconf no-lock
     3548            where buf_sysconf.host-code = v-torgconf-self-host-code
     3549            no-error.
     3550            if available buf_sysconf
     3551            then do:
     3552               assign
     3553                  v-torgconf-main-boss-post = buf_sysconf.head-position
     3554               .
     3555            end.
     3556            find first buf_clients no-lock
     3557            where buf_clients.obj-type = 'орг':U
     3558            and buf_clients.obj-code = v-torgconf-self-host-code
     3559            .
     3560            find first buf_firm no-lock
     3561            where buf_firm.firm-code = buf_clients.obj-code
     3562            no-error.
     3563            if available buf_firm
     3564            then do:
     3565               assign
     3566                  v-torgconf-main-boss = buf_firm.director
     3567               .
     3568            end.
     3569         end.
     3570      if v-torgconf-outR = "dir_obj"
     3571         then do:
     3572            CASE v-torgconf-self-obj-type:
     3573            WHEN 'маг':U
     3574            THEN DO:
     3575               find first buf_shop no-lock
     3576               where buf_shop.obj-code = v-torgconf-self-obj-code
     3577               .
     3578               assign
     3579                  v-torgconf-main-boss = buf_shop.director
     3580                  v-torgconf-main-boss-post = "Директор"
     3581               .
     3582            END.
     3583            WHEN 'скл':U
     3584            THEN DO:
     3585               find first buf_store no-lock
     3586               where buf_store.obj-code = v-torgconf-self-obj-code
     3587               .
     3588               assign
     3589                  v-torgconf-main-boss = buf_store.store-boss
     3590                  v-torgconf-main-boss-post = "Директор"
     3591               .
     3592            END.
     3593            OTHERWISE DO:
     3594               assign
     3595                  v-torgconf-main-boss       = "":U
     3596                  v-torgconf-main-boss-post  = "":U
     3597               .
     3598            END.
     3599            END CASE.
     3600         end.
     3601      if  v-name <> 'wthtrg12':U
     3602      and v-name <> 'wthfct':U
     3603      and v-name <> 'wthm11':U
     3604      then do:
     3605       find first buf_trn-doc no-lock
     3606       where buf_trn-doc.doc-code = p-doc-code
     3607       no-error.
     3608       if available buf_trn-doc
     3609         then do:
     3610   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3612     (input  buf_trn-doc.obj-type
     3613     ,input  buf_trn-doc.obj-code
     3614     ,output v-host-code
     3615     )  .
     3616         end.
     3617       if v-torgconf-outogr = "no_print"
     3618         then do:
     3619            assign
     3620               v-torgconf-ogr-name = ""
     3621               v-torgconf-ogr-post = ""
     3622            .
     3623         end.
     3624      if v-torgconf-outogr  = "ruk_firm"
     3625            then do:
     3626            find first buf_sysconf no-lock
     3627            where buf_sysconf.host-code = v-host-code
     3628            no-error.
