     3813            find first buf_sysconf no-lock
     3814            where buf_sysconf.host-code = p-host-code
     3815            no-error.
     3816            if available buf_sysconf
     3817            then do:
     3818               assign
     3819                  v-torgconf-ogr-post = buf_sysconf.head-position
     3820               .
     3821            end.
     3822            find first buf_clients no-lock
     3823                where buf_clients.obj-type = 'орг':U
