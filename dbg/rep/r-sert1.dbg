     3861                     v-torgconf-ogr-name = "":U
     3862                     v-torgconf-ogr-post = "":U
     3863                  .
     3864               END.
     3865               END CASE.
     3866            end.
     3867      if v-torgconf-outogr = "manag_doc"
     3868         then do:
