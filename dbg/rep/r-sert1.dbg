     3950               no-error.
     3951               if available buf_person
     3952               then do:
     3953                  v-torgconf-ogr-post = buf_person.position.
     3954               end.
     3955               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3956               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3957            end.
     3958      end.
     3959   end.
     3960   procedure torgconf-get-reason  :
     3961   define input parameter  p-doc-code       as character        no-undo.
     3962   define input parameter  p-reason-code    as integer          no-undo .
     3963   define input parameter  p-doc-type       as character        no-undo.
     3964       if p-reason-code > 0
     3965       then do:
     3966           define buffer buf_trn-reason for ub.trn-reason.
     3967           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3968           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3969       end.
     3970       else do:
     3971           if p-doc-type = 'при':U
     3972           then  do:
     3973               define variable v-attr-type     as character    no-undo.
     3974               define variable v-attr-value    as character    no-undo.
     3975               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3976               assign v-torgconf-reason = v-attr-value .
     3977               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3978               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3979           end.
     3980       end.
     3981   end procedure.
     3982   define variable g#report-num    as integer      no-undo.
     3983   define variable g#quest-print   as logical      no-undo.
     3984   define variable g#log           as logical      no-undo.
     3985   run get-report-num in p-mainmenu-handle ( output g#report-num ).
     3986   run get-quest-print in p-mainmenu-handle ( output g#quest-print ).
     3987   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3988   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3989   procedure paramls-clear :
     3990     define buffer buf_temp-param for temp-param .
     3991     do
     3992     on error undo, return error return-value
     3993     :
     3994       for each buf_temp-param
     3995       on error undo, return error
     3996       :
     3997         delete buf_temp-param .
     3998       end.
     3999     end.
     4000   end procedure.
     4001   procedure paramls-write :
     4002     define input  parameter p-code     as character no-undo .
     4003     define input  parameter p-sub-code as character no-undo .
     4004     define input  parameter p-value    as character no-undo .
     4005     define buffer buf_temp-param for temp-param .
     4006     do
     4007     on error undo, return error return-value
     4008     :
     4009       find first buf_temp-param
     4010         where buf_temp-param.param-code     = p-code
     4011           and buf_temp-param.param-sub-code = p-sub-code
     4012         no-error .
     4013       if not available buf_temp-param then do:
     4014         create buf_temp-param .
     4015         assign
     4016           buf_temp-param.param-code     = p-code
     4017           buf_temp-param.param-sub-code = p-sub-code
     4018         .
     4019       end.
     4020       assign
     4021         buf_temp-param.param-value = p-value
     4022       .
     4023     end.
     4024   end procedure.
     4025   procedure paramls-read :
     4026     define input  parameter p-code          as character no-undo .
     4027     define input  parameter p-sub-code      as character no-undo .
     4028     define input  parameter p-default-value as character no-undo .
     4029     define output parameter p-value         as character no-undo .
     4030     define buffer buf_temp-param for temp-param .
     4031     do
     4032     on error undo, return error return-value
     4033     :
     4034       find first buf_temp-param
     4035         where buf_temp-param.param-code     = p-code
     4036           and buf_temp-param.param-sub-code = p-sub-code
     4037         no-error .
     4038       if available buf_temp-param then do:
     4039         assign
     4040           p-value = buf_temp-param.param-value
     4041         .
     4042       end.
     4043       else do:
     4044         assign
     4045           p-value = p-default-value
     4046         .
     4047       end.
     4048     end.
     4049   end procedure.
     4050   procedure paramls-append :
     4051     define input  parameter p-code     as character no-undo .
     4052     define input  parameter p-sub-code as character no-undo .
     4053     define input  parameter p-value    as character no-undo .
     4054     define buffer buf_temp-param for temp-param .
     4055     do
     4056     on error undo, return error return-value
     4057     :
     4058       find first buf_temp-param
     4059            where buf_temp-param.param-code     = p-code
     4060              and buf_temp-param.param-sub-code = p-sub-code
     4061         no-error .
     4062       if not available buf_temp-param then do:
     4063         create buf_temp-param .
     4064         assign
     4065           buf_temp-param.param-code     = p-code
     4066           buf_temp-param.param-sub-code = p-sub-code
     4067           buf_temp-param.param-value    = p-value
     4068         .
     4069       end.
     4070       else do:
     4071           assign
     4072               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4073           .
     4074       end.
     4075     end.
     4076   end procedure.
     4077   define variable vss-include-info16 as character format "X(65)" no-undo
     4078   initial "@(#)$Workfile$ $Revision$".
     4079   define stream excel-line.
     4080   define stream excel-cell.
     4081   define temp-table temp_cell-data no-undo
     4082       field data-key as character
     4083       field data-value as character
     4084       index pi is primary unique data-key
     4085   .
     4086   define temp-table temp_line-data no-undo
     4087       field data-key   as character
     4088       field xl-line-id as integer
     4089       field num        as integer
     4090       field artic      as character
     4091       field name       as character
     4092       field numblank   as character
     4093       field numsertif  as character
     4094       field date1      as character
     4095       field date2      as character
     4096       field orgsertif  as character
     4097       field srok       as character
     4098       field datestart  as character
     4099       field techusl    as character
     4100       index pi is primary unique xl-line-id
     4101       .
     4102   define variable v-r-sertxl-current-data-row     as integer      no-undo.
     4103   define variable v-r-sertxl-cell-file-name       as character    no-undo.
     4104   define variable v-r-sertxl-data-file-name       as character    no-undo.
     4105   procedure r-sertxl-init :
     4106       define buffer buf_temp_cell-data        for temp_cell-data.
     4107   do
     4108   for buf_temp_cell-data on error undo, return error :
     4109       assign
     4110           v-r-sertxl-current-data-row = 0
     4111       .
     4112       run gbl/_tmpfile.p
     4113         (input "xd"
     4114         ,input ".txt"
     4115         ,output v-r-sertxl-data-file-name
     4116         ).
     4117       output stream excel-line to value( v-r-sertxl-data-file-name ).
     4118       run gbl/_tmpfile.p
     4119         (input "xc"
     4120         ,input ".txt"
     4121         ,output v-r-sertxl-cell-file-name
     4122         ).
     4123       output stream excel-cell to value( v-r-sertxl-cell-file-name ).
     4124       run r-sertxl-write-cell-data in this-procedure (
     4125                 input "valutCode":U
     4126               , input "0":U
     4127       ).
     4128       run r-sertxl-write-cell-data in this-procedure (
     4129             input "regularExpressions":U
     4130           , input "1":U
     4131       ).
     4132       run r-sertxl-write-cell-data in this-procedure (
     4133             input "columnList":U
     4134           , input "num,artic,name,numblank,numsertif,date1,date2,orgsertif,srok,datestart,techusl":U
     4135       ).
     4136       run r-sertxl-write-cell-data in this-procedure (
     4137             input "columnType":U
     4138           , input "I,S,S,S,S,S,S,S,S,S,S":U
     4139       ).
     4140       run r-sertxl-write-cell-data in this-procedure (
     4141             input "columnAmount":U
     4142           , input "11":U
     4143       ).
     4144   end.
     4145   end procedure.
     4146   procedure r-sertxl-close :
     4147   do
     4148   on error undo, return error
     4149   :
     4150       output stream excel-line close.
     4151       output stream excel-cell close.
     4152       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4153           export "exe/sertif.xlt":U.
     4154           export "exe/t_97.bas":U.
     4155           export v-r-sertxl-cell-file-name.
     4156           export v-r-sertxl-data-file-name.
     4157       output close.
     4158   end.
     4159   end procedure.
     4160   procedure r-sertxl-write-cell-data :
     4161   define input parameter p-data-key   as character        no-undo.
     4162   define input parameter p-data-value as character        no-undo.
     4163       define buffer buf_temp_cell-data     for temp_cell-data.
     4164   do
     4165   for buf_temp_cell-data
     4166   on error undo, return error
     4167   :
     4168       find first buf_temp_cell-data
     4169            where buf_temp_cell-data.data-key = p-data-key
     4170       no-error.
     4171       if not available buf_temp_cell-data
     4172       then do:
     4173           create buf_temp_cell-data.
     4174           assign
     4175               buf_temp_cell-data.data-key = p-data-key
     4176           .
     4177       end.
     4178       assign
     4179           buf_temp_cell-data.data-value = p-data-value
     4180       .
     4181       put stream excel-cell unformatted
     4182                           buf_temp_cell-data.data-key
     4183           chr(9)   buf_temp_cell-data.data-value
     4184           chr(10)
     4185       .
     4186   end.
     4187   end procedure.
     4188   procedure r-sertxl-write-line-data :
     4189   define input parameter p-num              as integer          no-undo.
     4190   define input parameter p-artic            as character        no-undo.
     4191   define input parameter p-name             as character        no-undo.
     4192   define input parameter p-numblank         as character        no-undo.
     4193   define input parameter p-numsertif        as character        no-undo.
     4194   define input parameter p-date1            as character        no-undo.
     4195   define input parameter p-date2            as character        no-undo.
     4196   define input parameter p-orgsertif        as character        no-undo.
     4197   define input parameter p-srok             as character        no-undo.
     4198   define input parameter p-date-start       as character        no-undo.
     4199   define input parameter p-tech-usl         as character        no-undo.
     4200       define buffer buf_temp_line-data        for temp_line-data.
     4201   do
     4202   for buf_temp_line-data
     4203   on error undo, return error
     4204   :
     4205       for each buf_temp_line-data
     4206       :
     4207           delete buf_temp_line-data.
     4208       end.
     4209       create buf_temp_line-data.
     4210       assign
     4211           v-r-sertxl-current-data-row = v-r-sertxl-current-data-row + 1
     4212       .
     4213       assign
     4214           buf_temp_line-data.data-key   = "LD":U
     4215           buf_temp_line-data.xl-line-id = v-r-sertxl-current-data-row
     4216           buf_temp_line-data.num        = p-num
     4217           buf_temp_line-data.artic      = p-artic
     4218           buf_temp_line-data.name       = p-name
     4219           buf_temp_line-data.numblank   = p-numblank
     4220           buf_temp_line-data.numsertif  = p-numsertif
     4221           buf_temp_line-data.date1      = p-date1
     4222           buf_temp_line-data.date2      = p-date2
     4223           buf_temp_line-data.orgsertif  = p-orgsertif
     4224           buf_temp_line-data.srok       = p-srok
     4225           buf_temp_line-data.datestart  = p-date-start
     4226           buf_temp_line-data.techusl    = p-tech-usl
     4227           .
     4228       put stream excel-line unformatted
     4229                           buf_temp_line-data.data-key
     4230           chr(9)   buf_temp_line-data.num
     4231           chr(9)   buf_temp_line-data.artic
     4232           chr(9)   buf_temp_line-data.name
     4233           chr(9)   buf_temp_line-data.numblank
     4234           chr(9)   buf_temp_line-data.numsertif
     4235           chr(9)   buf_temp_line-data.date1
     4236           chr(9)   buf_temp_line-data.date2
     4237           chr(9)   buf_temp_line-data.orgsertif
     4238           chr(9)   buf_temp_line-data.srok
     4239           chr(9)   buf_temp_line-data.datestart
     4240           chr(9)   buf_temp_line-data.techusl
     4241           chr(10)
     4242       .
     4243   end.
     4244   end procedure.
     4245   procedure r-sertxl-run-excel :
     4246   define input parameter p-header-filename    as character        no-undo.
     4247   define input parameter p-data-filename      as character        no-undo.
     4248       define variable v-template-file-name    as character    no-undo.
     4249       define variable v-vb-file-name          as character    no-undo.
     4250       define buffer buf_temp-param for temp-param .
     4251   do
     4252   for buf_temp-param
     4253   on error undo, return error
     4254   :
     4255       create buf_temp-param.
     4256       assign
     4257           v-template-file-name    = search( "exe/sertif.xlt" )
     4258           v-vb-file-name          = search( "exe/t_97.bas")
     4259       .
     4260       if v-template-file-name = ?  or v-template-file-name = "":U  then do:
     4261           message  "Ошибка имени файла шаблона." view-as alert-box error.
     4262       end.
     4263       if v-vb-file-name = ?  or v-vb-file-name = "":U then do:
     4264           message  "Ошибка имени файла кода обработки."   view-as alert-box error.
     4265       end.
     4266       run paramls-write in this-procedure (
     4267             input "template":U
     4268           , input "template-file-name":U
     4269           , input v-template-file-name
     4270       ).
     4271       run paramls-write in this-procedure (
     4272             input "template":U
     4273           , input "vb-file-name":U
     4274           , input v-vb-file-name
     4275       ).
     4276       run paramls-write in this-procedure (
     4277             input "data":U
     4278           , input "data-header-filename":U
     4279           , input p-header-filename
     4280       ).
     4281       run paramls-write in this-procedure (
     4282             input "data":U
     4283           , input "data-filename":U
     4284           , input p-data-filename
     4285       ).
     4286       run gbl/macroxlt.p (
     4287           input-output table buf_temp-param
     4288       ) no-error.
     4289       if error-status :error
     4290       then do:
     4291           message
     4292                    vss-workfile vss-revision vss-description
     4293               skip(1)
     4294               skip "Ошибка создания файла Excel."
     4295               skip return-value
     4296               skip trim(error-status :get-message(1))
     4297                    trim(error-status :get-message(2))
     4298                    trim(error-status :get-message(3))
     4299           view-as alert-box error.
     4300           undo, return error .
     4301       end.
     4302   end.
     4303   end procedure.
     4304   do
     4305   on error undo, return error
     4306   :
     4307   def stream out-stream .
     4308   def buffer  buf_trn-doc       for trn-doc.
     4309   def buffer  buf_doc-line      for doc-line.
     4310   def buffer  buf_clients       for clients.
     4311   def buffer  buf_firm          for firm.
     4312   def buffer  buf_clients_sert  for clients.
     4313   def buffer  buf_sert          for sert.
     4314   def buffer  buf_sert-join     for sert-join.
     4315   def buffer  buf_goods         for goods.
     4316   def buffer  buf_condition-keeping   for ub.condition-keeping .
     4317   def var v-line-counter    as integer    init 0        no-undo.
     4318   def var v-org-name            as char                     no-undo.
     4319   def var v-contact-name        as char                     no-undo.
     4320   def var v-doc-code            as char                     no-undo.
     4321   def var v-doc-date            as date                     no-undo.
     4322   def var v-artic               as char                     no-undo.
     4323   def var v-goods-name          as char                     no-undo.
     4324   def var v-prod-name           as char                     no-undo.
     4325   def var v-sert-num            as char                     no-undo.
     4326   def var v-sert-org            as char                     no-undo.
     4327   def var v-sert-date1          as char                     no-undo.
     4328   def var v-sert-date2          as char                     no-undo.
     4329   def var v-srok                as char                     no-undo.
     4330   def var v-date-start          as char                     no-undo.
     4331   def var v-tech-usl            as char                     no-undo.
     4332   define variable v-blank-num as character no-undo .
     4333   def var v-bar-code            like bar-code.b-code        no-undo.
     4334   def var sym1  as char init "|" no-undo.
     4335   def var sym2  as char init ":" no-undo.
     4336   def var sym3  as char init ":" no-undo.
     4337   def var sym4  as char init ":" no-undo.
     4338   def var sym5  as char init ":" no-undo.
     4339   def var sym6  as char init ":" no-undo.
     4340   def var sym7  as char init ":" no-undo.
     4341   def var sym8  as char init ":" no-undo.
     4342   def var sym9  as char init ":" no-undo.
     4343   def var sym10  as char init ":" no-undo.
     4344   def var sym11  as char init ":" no-undo.
     4345   def var sym12  as char init "|" no-undo.
     4346   def var v-single-line       as char               no-undo.
     4347   def var v-underline         as char               no-undo.
     4348   def var t-addres            as char               no-undo.
     4349   def var t-phone             as char               no-undo.
     4350   def var t-inn               as char               no-undo.
     4351   def var t-okpo              as char               no-undo.
     4352   def var v-need-page-break   as logical init no    no-undo.
     4353   def var v-host-code         as integer            no-undo.
     4354   define variable v-file-name as character no-undo .
     4355   find first buf_trn-doc no-lock  where recid(buf_trn-doc) = p-recid .
     4356   if not available buf_trn-doc then return.
     4357       define frame f-doc
     4358           sym1 column-label    ":"  format "X(1)" space(0)   v-line-counter   COLUMN-LABEL "N"                              format ">>>>9" space(0)
     4359           sym2 column-label    ":"  format "X(1)" space(0)   v-artic          COLUMN-LABEL "Артикул"                        format "X(16)" space(0)
     4360           sym3 column-label    ":"  format "X(1)" space(0)   v-goods-name     COLUMN-LABEL "Наименование продуции"          format "X(25)" space(0)
     4361           sym4 column-label    ":"  format "X(1)" space(0)   v-blank-num      COLUMN-LABEL "№ Бланка"                       format "X(14)" space(0)
     4362           sym5 column-label    ":"  format "X(1)" space(0)   v-sert-num       COLUMN-LABEL "Регистрационный номер"          format "X(30)" space(0)
     4363           sym6 column-label    ":"  format "X(1)" space(1)   v-sert-date1     COLUMN-LABEL "Дата выдачи"                    format "X(12)" space(0)
     4364           sym7 column-label    ":"  format "X(1)" space(1)   v-sert-date2     COLUMN-LABEL "Срок действия"                  format "X(12)" space(0)
     4365           sym8 column-label    ":"  format "X(1)" space(0)   v-sert-org       COLUMN-LABEL "Орган выдавший сертификат"      format "X(30)" space(0)
     4366           sym9 column-label    ":"  format "X(1)" space(0)   v-srok           COLUMN-LABEL "Срок годности"                  format "X(14)" space(0)
     4367           sym10 column-label   ":"  format "X(1)" space(0)   v-date-start     COLUMN-LABEL "Дата выработки"                 format "X(12)" space(0)
     4368           sym11 column-label   ":"  format "X(1)" space(0)   v-tech-usl       COLUMN-LABEL "Технические условия"            format "X(25)" space(0)
     4369           sym12 column-label   ":"  format "X(1)" space(0)
     4370       HEADER
     4371           string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") ) at 5 format "X(35)"
     4372           v-doc-code AT 70 format "X(10)" " от " v-doc-date format "99/99/99"
     4373           "Страница " AT 120 PAGE-NUMBER( Out-Stream ) AT 130 FORMAT ">>9" SKIP
     4374           v-single-line format "X(212)" AT 1
     4375   with width 235 down stream-io .
     4376   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4378     (input  buf_trn-doc.obj-type
     4379     ,input  buf_trn-doc.obj-code
     4380     ,output v-host-code
     4381     )  .
     4382   run torgconf-read in this-procedure ( input "r-sert", input v-host-code, input buf_trn-doc.obj-type, input buf_trn-doc.obj-code) no-error.
     4383   if error-status :error then do:
     4384     message
     4385       vss-workfile vss-revision vss-description
     4386       skip "Ошибка чтения параметров печати формы."   skip "Форма будет напечатана с параметрами по умолчанию."   skip return-value
     4387       skip trim(error-status :get-message(1))   trim(error-status :get-message(2))   trim(error-status :get-message(3))
     4388     view-as alert-box error.
     4389   end.
     4390   find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-host-code no-error.
     4391   find first buf_firm no-lock  where buf_firm.firm-code = buf_clients.obj-code no-error.
     4392   assign
     4393       v-line-counter  = 0
     4394       v-single-line       = fill("-", 230)
     4395       v-underline         = fill("_", 230)
     4396       v-doc-code          = buf_trn-doc.doc-code
     4397       v-doc-date          = (if buf_trn-doc.status_ = 'факт':U then buf_trn-doc.fact-date else buf_trn-doc.doc-date)
     4398       v-org-name          = buf_clients.obj-name + buf_firm.post-addr2
     4399       .
     4400   find first ub.clients no-lock where ub.clients.obj-code = buf_firm.tobj-code and ub.clients.obj-type = 'чел':U no-error .
     4401   if AVAILABLE ub.clients then do:
     4402       v-contact-name      = ub.clients.obj-name .
     4403   end.
     4404   if session :set-wait-state( "compiler" ) then.
     4405   output stream Out-Stream to value( string( session:temp-directory +
     4406                                        "rpt" + string( g#report-num ) ) )
     4407                                        page-size  value(43) .
     4408    run r-sertxl-init in this-procedure .
     4409     assign
     4410       v-file-name = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     4411     .
     4412   put stream Out-Stream skip space(10)
     4413     "ТОВАРНО-СОПРОВОДИТЕЛЬНЫЙ ДОКУМЕНТ К НАКЛАДНОЙ N " + string(v-doc-code) + " ОТ " + string(v-doc-date) + " ("   + string(buf_trn-doc.status_) + ")"
     4414     format "X(150)"
     4415   .
     4416   form with frame f-doc.
     4417   run r-sertxl-write-cell-data in this-procedure (
     4418       input "h_DocNum":U
     4419     , input substitute( "к накладной N &1 от &2 (&3)", v-doc-code, v-doc-date, buf_trn-doc.status_)
     4420   ).
     4421       form header
     4422           v-single-line format "X(212)" skip
     4423           "Продолжение - на следующей странице" at 30 skip
     4424           with frame BottomFrame width 235 page-bottom no-box .
     4425       view stream Out-Stream frame BottomFrame .
     4426       for each buf_doc-line no-lock
     4427           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     4428           ,each buf_goods no-lock
     4429           where buf_goods.artic     = buf_doc-line.artic
     4430           and buf_goods.prod-type = buf_doc-line.prod-type
     4431           and buf_goods.prod-code = buf_doc-line.prod-code
     4432           :
     4433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4434     (input  buf_goods.gds-code
     4435     ,input  ?
     4436     ,output v-bar-code
     4437     ) no-error .
     4438    .
     4439           if error-status:error then
     4440           do:
     4441               message  vss-workfile + ". Не найден бар-код товара " + buf_goods.artic  view-as alert-box error.
     4442               undo, leave .
     4443           end.
     4444           assign
     4445               v-artic      = buf_goods.artic
     4446               v-goods-name = buf_goods.gds-name
     4447               v-tech-usl   = buf_goods.sert
     4448               v-date-start = string(buf_trn-doc.fact-date,"99.99.9999")
     4449               .
     4450           for each buf_sert-join no-lock  where buf_sert-join.b-code = v-bar-code
     4451               ,each buf_sert no-lock
     4452               where buf_sert.cli-type  = buf_sert-join.cli-type
     4453               and buf_sert.cli-code  = buf_sert-join.cli-code
     4454               and buf_sert.sert-code = buf_sert-join.sert-code
     4455               and buf_sert.last-date > today
     4456               :
     4457               assign
     4458                   v-line-counter = v-line-counter + 1
     4459                   v-sert-num     = buf_sert.sert-code
     4460                   v-sert-org     = buf_sert.sert-org
     4461                   v-blank-num    = buf_sert.blank-num
     4462                   v-sert-date1   = string(buf_sert.first-date)
     4463                   v-sert-date2   = string(buf_sert.last-date)
     4464                   .
     4465               find first buf_condition-keeping no-lock where buf_condition-keeping.cond-keep-code = buf_goods.cond-keep-code no-error .
     4466               if AVAILABLE buf_condition-keeping then v-srok = buf_condition-keeping.cond-keep-name .
     4467               if line-counter( Out-Stream ) > page-size( Out-Stream ) then  page stream out-stream.
     4468               display stream out-stream
     4469                   sym1 v-line-counter
     4470                   sym2 v-artic
     4471                   sym3 v-goods-name
     4472                   sym4 v-blank-num
     4473                   sym5 v-sert-num
     4474                   sym6 v-sert-date1
     4475                   sym7 v-sert-date2
     4476                   sym8 v-sert-org
     4477                   sym9 v-srok
     4478                   sym10 v-date-start
     4479                   sym11 v-tech-usl
     4480                   sym12
     4481                   with frame f-doc.
     4482               down stream out-stream 1 with frame f-doc .
     4483               run r-sertxl-write-line-data in this-procedure (
     4484                   input v-line-counter
     4485                   , input v-artic
     4486                   , input v-goods-name
     4487                   , input v-blank-num
     4488                   , input v-sert-num
     4489                   , input v-sert-date1
     4490                   , input v-sert-date2
     4491                   , input v-sert-org
     4492                   , input v-srok
     4493                   , input v-date-start
     4494                   , input v-tech-usl
     4495                   ).
     4496           end.
     4497       end.
     4498   if line-counter( Out-Stream ) + 6 > page-size( Out-Stream ) then do:
     4499     page stream out-stream.
     4500   end.
     4501   hide stream out-stream frame BottomFrame .
     4502   put stream Out-Stream
     4503       skip    v-single-line                   format "X(212)"
     4504       skip(2) space(5)  "Оригиналы сертификатов или их заверенная копия находятся у: " + v-org-name  format "X(150)"
     4505       skip(2) space(5)  "Уполномоченный представитель " + v-contact-name + " " + string(v-underline, "X(20)") + " М.П."  format "X(150)"
     4506   .
     4507   run r-sertxl-write-cell-data in this-procedure ( input "f_OrgName":U, input string("Оригиналы сертификатов или их заверенная копия находятся у: " + v-org-name)).
     4508   run r-sertxl-write-cell-data in this-procedure ( input "f_contact":U, input string("Уполномоченный представитель " + v-contact-name + "                                           М.П.")).
     4509   output stream Out-Stream close.
     4510   run r-sertxl-close in this-procedure .
     4511   if session :set-wait-state( "" ) then.
     4512   if g#quest-print = false
     4513   then do:
     4514     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     4515                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     4516                                         OUTPUT g#log ).
     4517   end.
     4518   else do:
     4519     os-command silent
     4520       value( "COPY /b " +
     4521         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     4522         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     4523         string( session:temp-directory) +  "$" + string( g#report-num )
     4524                 ) .
     4525     os-command silent
     4526       value( "COPY /b " +
     4527         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4528         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4529         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4530                 ) .
     4531   end.
     4532   end.
