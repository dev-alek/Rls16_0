     3630            then do:
     3631               assign
     3632                  v-torgconf-ogr-post = buf_sysconf.head-position
     3633               .
     3634            end.
     3635            find first buf_clients no-lock
     3636                where buf_clients.obj-type = 'орг':U
     3637                and buf_clients.obj-code = v-host-code
     3638            .
     3639            find first buf_firm no-lock
     3640                where buf_firm.firm-code = buf_clients.obj-code
     3641            .
     3642            assign
     3643                v-torgconf-ogr-name = buf_firm.director
     3644            .
     3645         end.
     3646         if v-torgconf-outogr = "dir_obj"
     3647            then do:
     3648            find first buf_trn-doc no-lock
     3649            where buf_trn-doc.doc-code = p-doc-code
     3650            no-error.
     3651               CASE buf_trn-doc.obj-type:
     3652               WHEN 'маг':U
     3653               THEN DO:
     3654                  find first buf_shop no-lock
     3655                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3656                  .
     3657                  assign
     3658                     v-torgconf-ogr-name = buf_shop.director
     3659                     v-torgconf-ogr-post = "Директор"
     3660                  .
     3661               END.
     3662               WHEN 'скл':U
     3663               THEN DO:
     3664                  find first buf_store no-lock
     3665                  where buf_store.obj-code = buf_trn-doc.obj-code
     3666                  .
     3667                  assign
     3668                     v-torgconf-ogr-name = buf_store.store-boss
     3669                     v-torgconf-ogr-post = "Директор"
     3670                  .
     3671               END.
     3672               OTHERWISE DO:
     3673                  assign
     3674                     v-torgconf-ogr-name = "":U
     3675                     v-torgconf-ogr-post = "":U
     3676                  .
     3677               END.
     3678               END CASE.
     3679            end.
     3680      if v-torgconf-outogr = "manag_doc"
     3681         then do:
     3682            find first buf_trn-doc no-lock
     3683            where buf_trn-doc.doc-code = p-doc-code
     3684            no-error.
     3685            if available buf_trn-doc
     3686            then do:
     3687               run rep/get-psn.p
     3688               (input buf_trn-doc.boss
     3689               ,output v-torgconf-ogr-name
     3690               ) .
     3691            end.
     3692            find first buf_person no-lock
     3693            where buf_person.psn-code = buf_trn-doc.boss
     3694            no-error.
     3695            if available buf_person
     3696            then do:
     3697               v-torgconf-ogr-post = buf_person.position.
     3698            end.
     3699            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3700            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3701         end.
     3702      end.
     3703      else do:
     3704      find first buf_wth-doc no-lock
     3705         where buf_wth-doc.doc-code = p-doc-code
     3706         no-error.
     3707         if available buf_wth-doc
     3708            then do:
     3709   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3710   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3711     (input  buf_wth-doc.obj-type
     3712     ,input  buf_wth-doc.obj-code
     3713     ,output v-host-code
     3714     )  .
     3715            end.
     3716         if v-torgconf-outogr = "no_print"
     3717            then do:
     3718               assign
     3719                  v-torgconf-ogr-name = ""
     3720                  v-torgconf-ogr-post = ""
     3721               .
     3722            end.
     3723         if v-torgconf-outogr  = "ruk_firm"
     3724               then do:
     3725               find first buf_sysconf no-lock
     3726               where buf_sysconf.host-code = v-host-code
     3727               no-error.
     3728               if available buf_sysconf
