      613   DEFINE VARIABLE RubText AS CHARACTER FORMAT "X(256)":U INITIAL "abbr_rublevye_allshift :"
      614         VIEW-AS TEXT
      615        SIZE 12.88 BY .83
      616        FGCOLOR 4  NO-UNDO.
