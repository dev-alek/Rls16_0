      518   define buffer buf_rep_currency for ub.currency.
      519   define variable v-cntxt-host-name-obj as character no-undo .
      520   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      521   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      522     (input  v-cntxt-obj-type
      523     ,input  v-cntxt-obj-code
      524     ,output v-cntxt-host-code-obj
      525     ,output v-cntxt-host-name-obj
      526     )  .
      527   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      529     (input  v-cntxt-host-code-obj
      530     ,output base-code
      531     )  .
      532   find first buf_rep_currency no-lock
      533     where buf_rep_currency.curr-code = base-code
      534     no-error .
      535     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
      536                  else base-type = "б.в." .
      537   run get-report-num  in parParentProc ( output g#report-num ).
      538   run get-gds-engl   in parParentProc ( output g#gds-engl ) .
      539   DEFINE SHARED BUFFER t-doc FOR trn-doc.
      540   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      541   define shared temp-table doc-list no-undo
