      702        VIEW-AS TOGGLE-BOX
      703        SIZE 33.63 BY .75 NO-UNDO.
      704   DEFINE VARIABLE Val-BruttoSaleSum AS LOGICAL INITIAL no
      705        LABEL "Цен документа ( без скидки )"
      706        VIEW-AS TOGGLE-BOX
      707        SIZE 32.13 BY .83 NO-UNDO.
      708   DEFINE VARIABLE Val-CostSum AS LOGICAL INITIAL no
      709        LABEL "Учетных цен"
      710        VIEW-AS TOGGLE-BOX
      711        SIZE 18.63 BY .75 NO-UNDO.
      712   DEFINE VARIABLE Val-DiscntSum AS LOGICAL INITIAL no
      713        LABEL "Скидок"
      714        VIEW-AS TOGGLE-BOX
      715        SIZE 10.63 BY .75 NO-UNDO.
      716   DEFINE VARIABLE Val-Effect AS LOGICAL INITIAL no
      717        LABEL "Эффективности"
      718        VIEW-AS TOGGLE-BOX
      719        SIZE 20.75 BY .75 NO-UNDO.
      720   DEFINE VARIABLE Val-NettoSaleSum AS LOGICAL INITIAL yes
      721        LABEL "Цен документа ( со скидкой )"
      722        VIEW-AS TOGGLE-BOX
      723        SIZE 31.38 BY .75 NO-UNDO.
      724   DEFINE FRAME DLGOKCAN
      725        Rubl-BruttoSaleSum AT ROW 2.71 COL 40.88
      726        Val-BruttoSaleSum AT ROW 2.75 COL 4.63
      727        Rubl-NettoSaleSum AT ROW 3.71 COL 40.88
      728        Val-NettoSaleSum AT ROW 3.75 COL 4.63
      729        Rubl-DiscntSum AT ROW 4.71 COL 40.88
      730        Val-DiscntSum AT ROW 4.75 COL 4.63
      731        Rubl-CostSum AT ROW 5.71 COL 40.88
      732        Val-CostSum AT ROW 5.75 COL 4.63
      733        Rubl-Effect AT ROW 6.71 COL 40.88
      734        Val-Effect AT ROW 6.75 COL 4.63
      735        NDS-Rubl AT ROW 7.71 COL 40.88
      736        NDS-Val AT ROW 7.75 COL 4.63
      737        Discnt-PC AT ROW 10 COL 4.75
      738        TorgPred AT ROW 10.04 COL 41.13
      739        Up-PC AT ROW 11 COL 4.75
      740        Operator AT ROW 11.04 COL 41.13
      741        PayType AT ROW 12 COL 4.75
      742        Kladov AT ROW 12.04 COL 41.13
      743        Kurs AT ROW 13 COL 4.75
      744        IspName AT ROW 13.04 COL 41.13
      745        Nums AT ROW 13.96 COL 4.63
      746        Our-Obj AT ROW 14.04 COL 41.13
      747        Btn_OK AT ROW 15.71 COL 25.88
      748        b-help AT ROW 15.71 COL 36.25
      749        Btn_Cancel AT ROW 15.75 COL 15.38
      750        ValText AT ROW 1.63 COL 14.75 COLON-ALIGNED NO-LABEL
      751        SumText AT ROW 1.63 COL 41.88 COLON-ALIGNED NO-LABEL
      752        RubText AT ROW 1.63 COL 51.13 COLON-ALIGNED NO-LABEL
      753        RECT-1 AT ROW 1.21 COL 2.38
      754        RECT-2 AT ROW 1.21 COL 38.88
      755        IMAGE-1 AT ROW 1.42 COL 39.63
      756        "Суммы" VIEW-AS TEXT
      757             SIZE 7 BY .83 AT ROW 1.63 COL 8.88
      758             FGCOLOR 0
      759        RECT-4 AT ROW 9.42 COL 2.5
      760        SPACE(1.62) SKIP(3.11)
      761       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      762            SIDE-LABELS THREE-D  SCROLLABLE
      763            BGCOLOR 8 FGCOLOR 0
      764            TITLE BGCOLOR 8 FGCOLOR 0 "Параметры отчета по документам":L
      765            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      766   ASSIGN
      767          FRAME DLGOKCAN:SCROLLABLE       = FALSE.
      768   ON CHOOSE OF Btn_Cancel IN FRAME DLGOKCAN
      769   DO:
      770       return "NO" .
      771   END.
      772   ON CHOOSE OF Btn_OK IN FRAME DLGOKCAN
      773   DO:
      774     define variable CurrWidth as integer no-undo .
      775     define variable var-frame-width as integer no-undo .
      776     assign
      777       Nums
      778       Val-BruttoSaleSum
      779       Rubl-BruttoSaleSum
      780       Val-NettoSaleSum
      781       Rubl-NettoSaleSum
      782       Val-DiscntSum
      783       Rubl-DiscntSum
      784       Val-CostSum
      785       Rubl-CostSum
      786       Val-Effect
      787       Rubl-Effect
      788       Discnt-PC
      789       TorgPred
      790       Up-PC
      791       Operator
      792       PayType
      793       Kladov
      794       Kurs
      795       Our-Obj
      796       IspName
      797       NDS-Val
      798       NDS-Rubl
      799     .
      800       run waitfram-show in this-procedure  ( "Обработка документов" ) .
      801       if not can-find( first wt-docs ) then do:
      802           DO WHILE available t-doc :
      803               GET prev br-docs.
      804           END.
      805           assign
      806             v-ind = 0
      807           .
      808           GET next br-docs.
      809           DO WHILE available t-doc :
      810               FIND pay-type NO-LOCK
      811                 WHERE pay-type.obj-code = t-doc.pay-code no-error
      812                 .
      813               FIND Object NO-LOCK
      814                 WHERE Object.obj-type = t-doc.obj-type
      815                   AND Object.obj-code = t-doc.obj-code
      816                 .
      817               CREATE wt-docs .
      818               BUFFER-COPY t-doc TO wt-docs.
      819               assign
      820                 wt-docs.doc-attr = ( substr( t-doc.doc-type, 1, 1 ) +
      821                                 substr( t-doc.status_ , 1, 1 ) +
      822                                 ( if t-doc.flag_    then "+" else "-" ) +
      823                                 ( if t-doc.internal     then "в" else " " ) )
      824                 wt-docs.pay-name = if not available pay-type then string(t-doc.pay-code) else pay-type.obj-name
      825                 wt-docs.pay-waitdate = wt-docs.fact-date
      826                 wt-docs.Oper_Name = t-doc.creid
      827                 wt-docs.OurObjectName = Object.obj-name
      828               .
      829               if base-code <> 0 then
      830                   wt-docs.Course = t-doc.base-rate / t-doc.base-scale .
      831               run rep/get-psn.p ( input t-doc.boss, output wt-docs.Mngr_Name) .
      832               run rep/get-psn.p ( input t-doc.wrkr, output wt-docs.Wrkr_name) .
      833               run rep/get-psn.p ( input t-doc.agnt, output wt-docs.Isp-Name ) .
      834               assign
      835                 v-ind = v-ind + 1
      836               .
      837               if ( v-ind modulo 10 ) = 0
      838               then do:
      839                 run waitfram-show in this-procedure  ( "Обработка документов : " + string( v-ind ) ) .
      840               end.
      841               if v-ind modulo 1000 = 0
      842               and v-continue <> ?
      843               then do:
      844                 message
      845                   "Уже распечатано строк" v-ind skip
      846                   "Вы желаете продолжить формирование отчета?" skip
      847                   "Yes"    chr(9) "Продолжить формирование отчета" skip
      848                   "No"     chr(9) "Прервать отчет" skip
      849                   "Cancel" chr(9) "Продолжить формирование отчета" skip
      850                   ""       chr(9) "и больше не показывать это сообщение" skip
      851                   view-as alert-box question buttons yes-no-cancel update v-continue .
      852                 if v-continue = false then do:
      853                   leave .
      854                 end.
      855               end.
      856               get next br-docs.
      857           end.
      858       end.
      859       run waitfram-hide in this-procedure  .
      860       run rep/docsrepo.p
      861         (input  "Отчет по документам. " + p-title
      862         ,input  Val-BruttoSaleSum
      863         ,input  Rubl-BruttoSaleSum
      864         ,input  Val-NettoSaleSum
      865         ,input  Rubl-NettoSaleSum
      866         ,input  Val-DiscntSum
      867         ,input  Rubl-DiscntSum
      868         ,input  Val-CostSum
      869         ,input  Rubl-CostSum
      870         ,input  Val-Effect
      871         ,input  Rubl-Effect
      872         ,input  Discnt-PC
      873         ,input  TorgPred
      874         ,input  Up-PC
      875         ,input  Operator
      876         ,input  PayType
      877         ,input  Kurs
      878         ,input  Our-Obj
      879         ,input  Kladov
      880         ,input  IspName
      881         ,input  no
      882         ,input  NDS-Val
      883         ,input  NDS-Rubl
      884         ,input  Nums
      885         ,input  v-continue
      886         ,input  g#report-num
      887         ,output var-frame-width
      888         ).
      889   END.
      890   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      891   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      892   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   on help of frame DLGOKCAN
      894   do:
      895     run gbl/app_help.p
      896       (input this-procedure :file-name
      897       ,input ''
      898       ,input ?
      899       ) no-error.
      900     if error-status :error then do:
      901       message
      902         "Ошибка при вызове помощи"
      903         error-status :get-message(1)
      904         view-as alert-box .
      905     end.
      906   end.
      907   run minbtn-set in this-procedure .
      908   on choose of b-help in frame DLGOKCAN
      909   do:
      910     apply "help":u to frame DLGOKCAN .
      911   end.
      912   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      913   procedure minbtn-set :
      914       do
      915           on error undo, return error return-value
      916           :
      917           define variable ii              as integer       no-undo .
      918           define variable fh              as widget-handle no-undo .
      919           define variable hh              as widget-handle no-undo .
      920           define variable v-h             as handle        extent 4 no-undo .
      921           define variable v-name-button   as character     no-undo .
      922           define variable v-help-old-x    as decimal       no-undo .
      923           define variable v-help-old-y    as decimal       no-undo .
      924           define variable v-help-old-size as decimal       no-undo .
      925           define variable v-frame-width   as decimal       no-undo .
      926           define variable jj              as integer       no-undo .
      927           do
      928               on error undo, return error
      929               :
      930               assign
      931                   v-frame-width = frame DLGOKCAN:width - 0.3
      932                   fh            = frame DLGOKCAN:first-child
      933                   hh            = fh:first-child
      934                   ii            = 1
      935                   .
      936               do while valid-handle(hh):
      937                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      938                   do:
      939                       case lc(hh:name) :
      940                           when "b-help" then
      941                               do:
      942                                   hh:load-image-up("cmp/b-help.bmp":u) .
      943                                   hh:load-image-down("cmp/b-help.bmp":u) .
      944                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      945                                   hh:TOOLTIP = "Помощь" .
      946                                   v-help-old-x = hh:column .
      947                                   v-help-old-y = hh:row    .
      948                                   v-help-old-size = hh:width .
      949                                   hh:width-chars = 2.5 .
      950                               end.
      951                           when "b-print" then
      952                               do:
      953                                   hh:load-image("cmp/b-print.bmp":u) .
      954                                   hh:TOOLTIP = "Печать" .
      955                                   v-h[ii] = hh:handle .
      956                                   ii = ii + 1 .
      957                                   hh:width-chars = 3 .
      958                               end.
      959                           when "b-history" or
      960                           when "b-hist" then
      961                               do:
      962                                   hh:load-image("cmp/b-hist.bmp":u) .
      963                                   hh:TOOLTIP = "История" .
      964                                   v-h[ii] = hh:handle .
      965                                   ii = ii + 1 .
      966                                   hh:width-chars = 3 .
      967                               end.
      968                           when "b-sch" then
      969                               do:
      970                                   hh:load-image("cmp/b-sch.bmp":u) .
      971                                   hh:TOOLTIP = "Установка Фильтра" .
      972                                   v-h[ii] = hh:handle .
      973                                   ii = ii + 1 .
      974                                   hh:width-chars = 3 .
      975                               end.
      976                           when "b-hist-user" then
      977                               do:
      978                                   hh:load-image("cmp/b-hist.bmp":u) .
      979                                   hh:TOOLTIP = "История пользователя" .
      980                                   ii = ii + 1 .
      981                               end.
      982                       end case.
      983                   end.
      984                   hh = hh:next-sibling.
      985               end.
      986               b-help:column = v-frame-width - b-help:width-chars.
      987               jj = 0.
      988               repeat ii = 4 to 1 by -1 :
      989                   if valid-handle (v-h[ii] ) then
      990                   do:
      991                       jj  = jj + 1 .
      992                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      993                       v-h[ii]:row    = v-help-old-y .
      994                   end.
      995               end.
      996           end.
      997       end.
      998   end procedure.
      999   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
     1000   MAIN-BLOCK:
     1001   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1002      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1003       RUN enable_UI.
     1004       if base-code = 0 then do:
     1005         HIDE
     1006           SumText RubText ValText Rubl-BruttoSaleSum
     1007           Rubl-NettoSaleSum Rubl-DiscntSum
     1008           Rubl-CostSum Rubl-Effect NDS-Rubl
     1009           in frame DLGOKCAN .
     1010       end.
     1011       else do:
     1012         HIDE IMAGE-1    in frame DLGOKCAN .
     1013       end.
     1014   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1015   do:
     1016     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1017       (input  v-cntxt-db-num
     1018       ,input  v-cntxt-userid
     1019       ,input  0
     1020       ,input  'actn_document-reports-sale_print':U
     1021       ,input  'firm':U
     1022       ,input  v-cntxt-host-code-obj
     1023       ,input  '':U
     1024       ,input  0
     1025       ,input  0
     1026       ,input  0
     1027       ,input  0
     1028       ,input  false
     1029       ,output Log-Res1
     1030       )  .
     1031   end.
     1032       if not Log-Res1 then do:
     1033         DISABLE
     1034           Nums Val-BruttoSaleSum Rubl-BruttoSaleSum Val-NettoSaleSum
     1035           Rubl-NettoSaleSum Val-DiscntSum Rubl-DiscntSum
     1036           Discnt-PC TorgPred Up-PC Operator
     1037           PayType Kladov Kurs Our-Obj IspName
     1038           WITH FRAME DLGOKCAN.
     1039       end.
     1040   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1041   do:
     1042     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1043       (input  v-cntxt-db-num
     1044       ,input  v-cntxt-userid
     1045       ,input  0
     1046       ,input  'actn_document-reports-cost_print':U
     1047       ,input  'firm':U
     1048       ,input  v-cntxt-host-code-obj
     1049       ,input  '':U
     1050       ,input  0
     1051       ,input  0
     1052       ,input  0
     1053       ,input  0
     1054       ,input  false
     1055       ,output Log-Res2
     1056       )  .
     1057   end.
     1058       if not Log-Res2 then do:
     1059         DISABLE
     1060           Rubl-CostSum Val-CostSum Val-Effect Rubl-Effect
     1061           WITH FRAME DLGOKCAN.
     1062       end.
     1063       if not ( Log-Res1 OR Log-Res2 ) then do:
     1064         message
     1065           "У Вас недостаточно ПРАВ" skip
     1066           "для выполнения данного действия." skip
     1067           "Обратитесь к администратору системы."
     1068           view-as alert-box error.
     1069         LEAVE MAIN-BLOCK .
     1070       end.
     1071       if num-results( "br-docs" ) = 0 then do:
     1072         message "Список П У С Т !" view-as alert-box information .
     1073         LEAVE MAIN-BLOCK .
     1074       end.
     1075       WAIT-FOR GO OF FRAME DLGOKCAN.
     1076   END.
     1077   RUN disable_UI.
     1078   PROCEDURE disable_UI :
     1079     HIDE FRAME DLGOKCAN.
     1080   END PROCEDURE.
     1081   PROCEDURE enable_UI :
     1082     ASSIGN
     1083       RubText = "РУБЛЕВЫЕ :"
     1084     .
     1085     DISPLAY Rubl-BruttoSaleSum Val-BruttoSaleSum Rubl-NettoSaleSum
     1086             Val-NettoSaleSum Rubl-DiscntSum Val-DiscntSum Rubl-CostSum Val-CostSum
     1087             Rubl-Effect Val-Effect NDS-Rubl NDS-Val Discnt-PC TorgPred Up-PC
     1088             Operator PayType Kladov Kurs IspName Nums Our-Obj ValText SumText
     1089             RubText
     1090         WITH FRAME DLGOKCAN.
     1091     ENABLE RECT-1 RECT-2 IMAGE-1 Rubl-BruttoSaleSum Val-BruttoSaleSum
     1092            Rubl-NettoSaleSum Val-NettoSaleSum Rubl-DiscntSum Val-DiscntSum
     1093            Rubl-CostSum Val-CostSum Rubl-Effect Val-Effect NDS-Rubl NDS-Val
     1094            RECT-4 Discnt-PC TorgPred Up-PC Operator PayType Kladov Kurs IspName
     1095            Nums Our-Obj Btn_OK b-help Btn_Cancel ValText SumText RubText
     1096         WITH FRAME DLGOKCAN.
     1097   END PROCEDURE.
