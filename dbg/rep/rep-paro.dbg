      115   function breakstr returns character ( input        for-name    as character,
      116                                         input        line-length as integer,
      117                                         input-output line1       as character,
      118                                         input-output line2       as character ) :
      119     define variable ii as integer no-undo.
      120     if length( for-name ) > line-length then do:
      121       assign ii    = 1
      122              line1 = "":u
      123              line2 = "":u.
      124       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      125         assign line1 =       substring( for-name, 1, line-length     )
      126                line2 = trim( substring( for-name,    line-length + 1 ) ).
      127       end.                                                     else do:
      128         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      129           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      130                  ii    = ii    + 1.
      131           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      132             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      133           end.
      134         end.
      135         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      136       end.
      137     end.                                else do:
      138       assign line1 = for-name
      139              line2 = "":u.
      140     end.
      141     return ( line1 ).
      142   end function.
