      619        SIZE 7.88 BY .83 NO-UNDO.
      620   DEFINE VARIABLE ValText AS CHARACTER FORMAT "X(256)":U INITIAL "ВАЛЮТНЫЕ :"
      621         VIEW-AS TEXT
      622        SIZE 12.88 BY .83
      623        FGCOLOR 4  NO-UNDO.
      624   DEFINE IMAGE IMAGE-1
      625        FILENAME "cmp/blank":U
