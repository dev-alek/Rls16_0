      669        LABEL "Название своего объекта"
      670        VIEW-AS TOGGLE-BOX
      671        SIZE 29.25 BY .75 NO-UNDO.
      672   DEFINE VARIABLE PayType AS LOGICAL INITIAL no
      673        LABEL "Вид оплаты"
