      646        VIEW-AS TOGGLE-BOX
      647        SIZE 14.63 BY .75 NO-UNDO.
      648   DEFINE VARIABLE Kurs AS LOGICAL INITIAL no
      649        LABEL "Курс"
      650        VIEW-AS TOGGLE-BOX
      651        SIZE 8.63 BY .75 NO-UNDO.
      652   DEFINE VARIABLE NDS-Rubl AS LOGICAL INITIAL no
      653        LABEL "НДС"
      654        VIEW-AS TOGGLE-BOX
      655        SIZE 8.63 BY .75 NO-UNDO.
