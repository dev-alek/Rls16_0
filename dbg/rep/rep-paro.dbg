      244   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      245   define variable v-waitfram-action01         as character   no-undo .
      246   define variable v-waitfram-action02         as character   no-undo .
      247   define variable v-waitfram-action03         as character   no-undo .
      248   define variable mWaitFramTextBeg            as character   no-undo.
      249   define variable mWaitFramTextEnd            as character   no-undo.
      250   define variable mWaitFramView               as logical     no-undo.
      251   define variable mWaitProcEvent              as logical     no-undo init yes.
      252   define variable mWaitFramInterval           as integer     no-undo init 1 .
      253   define variable mWaitFramStop               as logical     no-undo.
      254   define variable mWaitFramStopUser           as logical     no-undo.
      255   define variable mWaitFramStopTimeOut        as logical     no-undo.
      256   define variable mWaitFramStartProc          as datetime-tz no-undo.
      257   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      258   define button B-WaitFramStop auto-end-key
      259        label "Стоп"
      260        size 10 by 1 tooltip "Остоновить процесс".
      261   define button B-viewProcInfo
      262        label "Информация"
      263        size 15 by 1 tooltip "Информация о процесс".
      264   define frame waitfram
      265     v-waitfram-action01 format "x(72)" no-label skip
      266     v-waitfram-action02 format "x(72)" no-label skip
      267     v-waitfram-action03 format "x(72)" no-label skip
      268     B-viewProcInfo
      269     B-WaitFramStop at row 4 col 30
      270     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      271     .
      272   define new global shared variable mBatchMode as logical no-undo init ?.
      273   define variable mFramBachModHandle as handle no-undo.
      274   mFramBachModHandle = frame waitfram:handle.
      275   define variable mFameOldVis as logical no-undo.
      276   define variable mVisCUrentVin as logical no-undo.
      277   if session:batch-mode
      278   then
      279      mBatchMode = yes.
      280   if mBatchMode = ? then do:
      281     mVisCUrentVin = current-window:visible.
      282     mFameOldVis = mFramBachModHandle:visible.
      283     mFramBachModHandle:visible  = yes.
      284     mBatchMode = mFramBachModHandle:visible ne yes.
      285     mFramBachModHandle:visible = mFameOldVis.
      286     current-window:visible = mVisCUrentVin.
      287   end.
      288    if  log-manager:logfile-name ne ?
      289     then DO:
      290         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      291         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      292         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      293     end.
      294   on choose of B-WaitFramStop in frame waitfram
      295   do:
      296     mWaitFramStop = yes.
      297     mWaitFramStopUser = yes.
      298   end.
      299   function waitfram-check-timeout returns logical():
      300      define variable vtime as int64 no-undo.
      301      if mWaitFramStopTimeOut
      302      then
      303         return yes.
      304      vtime = ( now - mWaitFramStartProc ) / 1000 .
      305      if     mWaitFramTimeOut ne ?
      306         and mWaitFramTimeOut ne 0
      307         and mWaitFramTimeOut lt vtime
      308      then do:
      309         mWaitFramStopTimeOut = yes.
      310      end.
      311      return mWaitFramStopTimeOut.
      312   end.
      313   procedure waitfram-hide :
      314     if not session:batch-mode
      315     then do
      316     on error undo, return error return-value
      317     :
      318       pause 0 before-hide .
      319       if not mBatchMode then
      320         hide frame waitfram .
      321     if     not mWaitFramView
      322        and mWaitProcEvent
      323     then
      324       process events .
      325     end.
      326   end procedure.
      327   procedure waitfram-show :
      328     define input  parameter p-message as character no-undo .
      329     define variable v-left-margin as integer   no-undo .
      330     if not session:batch-mode
      331     then do
      332     on error undo, return error return-value
      333     :
      334       if length(p-message) <= 70 then do:
      335         assign
      336           v-left-margin = integer((70 - length(p-message)) / 2)
      337         .
      338         assign
      339           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      340         .
      341         assign
      342           v-waitfram-action01 = " "
      343           v-waitfram-action02 = " "
      344                                    + fill(" ", v-left-margin)
      345                                    + p-message
      346           v-waitfram-action03 = " "
      347         .
      348       end.
      349       else do:
      350         define variable vRindex1 as integer no-undo.
      351         define variable vRindex2 as integer no-undo.
      352         vRindex1 = r-index(p-message," ",70).
      353         if vRindex1 = 0
      354         then
      355            vRindex1 = 70.
      356         if length(p-message)  <= vRindex1 + 70 then do:
      357           assign
      358             v-waitfram-action01 = " "
      359             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      360             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      361           .
      362         end.
      363         else do:
      364           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      365           if vRindex2 <= vRindex1
      366           then
      367              vRindex2 = vRindex1 + 70.
      368           assign
      369             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      370             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      371             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      372           .
      373         end.
      374       end.
      375       B-viewProcInfo:visible   in frame waitfram = no.
      376       B-viewProcInfo:sensitive in frame waitfram = no.
      377       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      378       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      379       if  (   mWaitFramView
      380          or  mWaitProcEvent)
      381          and not mBatchMode
      382       then
      383          display
      384             v-waitfram-action01 skip
      385             v-waitfram-action02 skip
      386             v-waitfram-action03 skip
      387          with frame waitfram .
      388       if     mWaitFramView
      389          then do:
      390             if     mWaitFramInterval ne ?
      391                and not mBatchMode
      392             then
      393                wait-for go of frame waitfram pause mWaitFramInterval.
      394          end.
      395          else
      396             if     mWaitProcEvent
      397                and not mBatchMode
      398             then
      399                process events .
      400     end.
      401   end procedure.
      402      procedure waitfram-show-this:
      403         define input  parameter iInterval as int64 no-undo.
      404         define variable vtime as int64 no-undo.
      405         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      406         mWaitFramInterval = iInterval.
      407         run waitfram-show (substitute("&1&2 &3&4" ,
      408                                       mWaitFramTextBeg ,
      409                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      410                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      411                                       mWaitFramTextEnd
      412                                      )
      413                           ).
      414      end.
      415      procedure WaitFramRunPause:
      416         define input  parameter iInterval as dec no-undo.
      417         define variable vStart  as datetime-tz no-undo.
      418         define variable vend    as datetime-tz no-undo.
      419         define variable vint as int64 no-undo.
      420         define variable vOk as logical no-undo.
      421         vStart = now.
      422         vend   = vStart.
      423         publish "WaitFramPause" (iInterval,output vOk).
      424         vend   =  now.
      425         vint = vend - vStart.
      426         vint = iInterval - vint / 1000.
      427         if     not mWaitFramStop
      428            and (   vint > 0
      429                 or (    not vOk
      430                     and iInterval eq ?
      431                     )
      432                 )
      433         then
      434            run waitfram-show-this (iInterval).
      435         vend   =  now.
      436         vint = vend - vStart.
      437         vint = iInterval - vint / 1000.
      438         if     not mWaitFramStop
      439            and vint > 0
      440         then do:
      441            run gbl/pause.p (vint * 1000).
      442         end.
      443         if iInterval ne ?
      444         then
      445            publish "WaitFramStop".
      446         waitfram-check-timeout().
      447      end.
      448      procedure WaitFramWaitFor:
      449         define input  parameter iInterval as dec no-undo.
      450         assign
      451            mWaitFramStartProc   = now
      452            mWaitFramStopUser    = no
      453            mWaitFramStopTimeOut = no
      454         .
      455         block-wait:
      456         do while not mWaitFramStop:
      457            run WaitFramRunPause (iInterval).
      458            if  waitfram-check-timeout()
      459            then do:
      460               leave block-wait.
      461            end.
      462         end.
      463         run waitfram-hide.
      464      end.
      465   procedure waitfram-join :
      466     define input  parameter p-line-1  as character no-undo .
      467     define input  parameter p-line-2  as character no-undo .
      468     define input  parameter p-line-3  as character no-undo .
      469     define output parameter p-message as character no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473       assign
      474         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      475                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      476                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      477       .
      478     end.
      479   end procedure.
      480   function waitfram-join-function returns character
      481     (input p-line-1 as character
      482     ,input p-line-2 as character
      483     ,input p-line-3 as character
      484     ).
      485     define variable v-message as character no-undo .
      486     run waitfram-join in this-procedure
      487       (input  p-line-1
      488       ,input  p-line-2
      489       ,input  p-line-3
      490       ,output v-message
      491       ) .
      492     return v-message .
      493   end function .
      494   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495     define variable v-cntxt-db-num        as integer   no-undo .
      496     define variable v-cntxt-userid        as character no-undo .
      497     define variable v-cntxt-level         as character no-undo .
      498     define variable v-cntxt-host-code-obj as integer   no-undo .
      499     define variable v-cntxt-obj-type      as character no-undo .
      500     define variable v-cntxt-obj-code      as integer   no-undo .
      501     define variable v-cntxt-db-num-obj    as integer   no-undo .
      502     define variable v-cntxt-is-admin      as logical   no-undo .
      503   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
