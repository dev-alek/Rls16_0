      586   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587     define temp-table tt-stk-line no-undo like ub.stk-line.
      588   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   PROCEDURE create-treal-3.
      590   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
      591   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      592   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      593   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      594   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      595   DEFINE INPUT PARAMETER pout-name as character no-undo.
      596   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      597   DEFINE INPUT PARAMETER pii as integer no-undo.
      598   _main:
      599   DO ON ERROR UNDO _main, return error:
      600       create treal-3.
      601       assign
      602       treal-3.grp-code-sheet = pgrp-code-sheet
      603       treal-3.cpay-code = pcpay-code
      604       treal-3.curr-code = pcurr-code
      605       treal-3.qnty1  =  pqnty1
      606       treal-3.netto = pnetto
      607       treal-3.out-name = pout-name
      608       treal-3.is-pay = pis-pay
      609       treal-3.ii = pii
      610       treal-3.discnt-type = -99
      611       no-error
      612       .
      613       if error-status:error then undo _main, return error.
      614   END.
      615   END PROCEDURE.
      616   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617   procedure factord :
      618     define input  parameter p-fact-date            as date    no-undo .
      619     define input  parameter p-fact-time            as integer no-undo .
      620     define input  parameter p-fact-num             as integer no-undo .
      621     define input  parameter p-shift-date           as date    no-undo .
      622     define input  parameter p-shift-num            as integer no-undo .
      623     define input  parameter p-shift-on             as logical no-undo .
      624     define output parameter p-fact-order           as decimal no-undo .
      625     define output parameter p-shift-end-fact-order as decimal no-undo .
      626     define output parameter p-day-end-fact-order   as decimal no-undo .
      627     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      628     if p-fact-date = ?
      629     then do:
      630       return error "Не указана фактическая дата" .
      631     end.
      632     define variable v-fact-date-num as integer no-undo .
      633     assign
      634       v-fact-date-num = integer(p-fact-date)
      635     .
      636     if p-fact-num = ?
      637     or p-fact-num = 0
      638     then do:
      639       return error "Не задан p-fact-num " + string(p-fact-num) .
      640     end.
      641     if p-fact-num < 0
      642     then do:
      643       return error "Отрицательный fact-num " + string(p-fact-num) .
      644     end.
      645     if p-fact-num >= 100000000
      646     then do:
      647       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      648     end.
      649     if p-shift-on = true
      650     then do:
      651       if p-shift-date = ?
      652       then do:
      653         return error "Не задана дата смены" .
      654       end.
      655       if p-shift-num = ?
      656       or p-shift-num = 0
      657       then do:
      658         return error "Не задан номер смены" .
      659       end.
      660     end.
      661     else do:
      662       assign
      663         p-shift-date = p-fact-date
      664         p-shift-num  = 24
      665       .
      666     end.
      667     define variable v-shift-offset as integer no-undo .
      668     if p-shift-date = p-fact-date
      669     then do:
      670       assign
      671         v-shift-offset = 1
      672       .
      673     end.
      674     if p-shift-date < p-fact-date
      675     then do:
      676       assign
      677         v-shift-offset = 0
      678       .
      679     end.
      680     if p-shift-date > p-fact-date
      681     then do:
      682       message
      683         vss-workfile vss-revision vss-description skip
      684         "Неправильная дата закрытия смены" skip
      685         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      686         view-as alert-box error .
      687       undo, return error
      688         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      689           ,string(p-fact-date, '99/99/9999':U)
      690           ,string(p-shift-date, '99/99/9999':U)
      691           )
      692       .
      693     end.
      694     if p-shift-num < 1
      695     or p-shift-num > 24
      696     then do:
      697       message
      698         vss-workfile vss-revision vss-description skip
      699         "Неправильный номер смены" skip
      700         "p-shift-num" p-shift-num skip
      701         view-as alert-box error .
      702       undo, return error return-value .
      703     end.
      704     assign
      705       p-fact-order           = v-fact-date-num
      706                              + v-shift-offset * 0.5
      707                              + p-shift-num    * 0.02 - 0.01
      708                              + p-fact-num     * 0.0000000001
      709       p-shift-end-fact-order = v-fact-date-num
      710                              + v-shift-offset * 0.5
      711                              + p-shift-num    * 0.02
      712       p-day-end-fact-order   = v-fact-date-num
      713                              + 0.99
      714     .
      715     if p-fact-order           <= v-fact-date-num
      716     or p-shift-end-fact-order <= v-fact-date-num
      717     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      718     or p-shift-end-fact-order >= p-day-end-fact-order
      719     then do:
      720       message
      721         vss-workfile vss-revision vss-description skip
      722         "Внутренняя ошибка при генерации фактического номера" skip
      723         "p-fact-date"            p-fact-date            skip
      724         "p-fact-time"            p-fact-time            skip
      725         "p-fact-num"             p-fact-num             skip
      726         "p-shift-date"           p-shift-date           skip
      727         "p-shift-num"            p-shift-num            skip
      728         "p-shift-on"             p-shift-on             skip
      729         "p-shift-end-fact-order" p-shift-end-fact-order skip
      730         "p-day-end-fact-order"   p-day-end-fact-order   skip
      731         "v-fact-date-num"        v-fact-date-num        skip
      732         view-as alert-box error .
      733       undo, return error return-value .
      734     end.
      735   end procedure.
      736   procedure day-begin-fact-order :
      737     define input  parameter p-fact-date            as date    no-undo .
      738     define output parameter p-day-begin-fact-order as decimal no-undo .
      739     do
      740     on error undo, return error return-value
      741     :
      742       if p-fact-date = ?
      743       then do:
      744         assign
      745           p-day-begin-fact-order = 0
      746         .
      747       end.
      748       else do:
      749         assign
      750           p-day-begin-fact-order = integer(p-fact-date)
      751         .
      752       end.
      753     end.
      754   end procedure.
      755   procedure factord-max-fact-order :
      756     define output parameter p-max-fact-order as decimal   no-undo .
      757     do
      758     on error undo, return error return-value
      759     :
      760       run day-begin-fact-order in this-procedure
      761         (input  date(1, 1, 5000)
      762         ,output p-max-fact-order
      763         ) .
      764     end.
      765   end procedure.
      766   procedure factord-cut-archive :
      767     define input  parameter p-obj-type             as character no-undo .
      768     define input  parameter p-obj-code             as integer   no-undo .
      769     define input  parameter p-fact-date            as date      no-undo .
      770     define output parameter p-shift-on             as logical   no-undo .
      771     define output parameter p-shift-date           as date      no-undo .
      772     define output parameter p-shift-num            as integer   no-undo .
      773     define output parameter p-day-end-fact-order   as decimal   no-undo .
      774     define output parameter p-shift-end-fact-order as decimal   no-undo .
      775     define variable v-fact-order as decimal   no-undo .
      776     define buffer buf_shift-obj for ub.shift-obj .
      777     do
      778     on error undo, return error return-value
      779     :
      780   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      782     (input  p-obj-type
      783     ,input  p-obj-code
      784     ,input  'shift-on=request'
      785     ,output p-shift-on
      786     ) no-error .
      787       if error-status :error
      788       then do:
      789         message
      790           vss-workfile vss-revision vss-description skip
      791           "Ошибка при определении атрибута объекта" skip
      792           "Объект" p-obj-type p-obj-code skip
      793           error-status :get-message(1) skip
      794           return-value skip
      795           view-as alert-box error .
      796         undo, return error return-value .
      797       end.
      798       if p-shift-on = false
      799       then do:
      800         assign
      801           p-shift-date               = ?
      802           p-shift-num                = 0
      803         .
      804       end.
      805       else do:
      806         find first buf_shift-obj share-lock
      807           where buf_shift-obj.obj-type   = p-obj-type
      808             and buf_shift-obj.obj-code   = p-obj-code
      809             and buf_shift-obj.shift-date > p-fact-date
      810           use-index pi
      811           no-error .
      812         if not available buf_shift-obj
      813         or buf_shift-obj.status_ <> 'зкр':U
      814         then do:
      815           message
      816             vss-workfile vss-revision vss-description skip
      817             "Невозможно вычислить последнюю смену" skip
      818             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      819             "Объект" p-obj-type p-obj-code skip
      820             "Дата" p-fact-date skip
      821             view-as alert-box error .
      822           undo, return error return-value .
      823         end.
      824         find last buf_shift-obj share-lock
      825           where buf_shift-obj.obj-type = p-obj-type
      826             and buf_shift-obj.obj-code = p-obj-code
      827             and buf_shift-obj.shift-date <= p-fact-date
      828           use-index pi
      829           no-error .
      830         if available buf_shift-obj
      831         then do:
      832           if  buf_shift-obj.status_ = 'зкр':U
      833           then do:
      834             assign
      835               p-shift-date = buf_shift-obj.shift-date
      836               p-shift-num  = buf_shift-obj.shift-num
      837             .
      838           end.
      839           else do:
      840             message
      841               vss-workfile vss-revision vss-description skip
      842               "Невозможно вычислить последнюю смену" skip
      843               "Статус смены отличен от статуса" 'зкр':U skip
      844               "Объект" p-obj-type p-obj-code skip
      845               "Дата" p-fact-date skip
      846               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      847               view-as alert-box error .
      848             undo, return error return-value .
      849           end.
      850         end.
      851         else do:
      852           assign
      853             p-shift-date = p-fact-date - 1
      854             p-shift-num  = 1
      855           .
      856         end.
      857       end.
      858       run factord in this-procedure
      859         (input  p-fact-date
      860         ,input  1
      861         ,input  1
      862         ,input  p-shift-date
      863         ,input  p-shift-num
      864         ,input  p-shift-on
      865         ,output v-fact-order
      866         ,output p-shift-end-fact-order
      867         ,output p-day-end-fact-order
      868         ) no-error .
      869       if error-status :error
      870       then do:
      871         message
      872           vss-workfile vss-revision vss-description skip
      873           "Ошибка при вызове процедуры factord"
      874           error-status :get-message(1) skip
      875           return-value skip
      876           view-as alert-box error .
      877         undo, return error return-value .
      878       end.
      879     end.
      880   end procedure.
      881   procedure factord-lock-shift :
      882     define input  parameter p-obj-type  as character no-undo .
      883     define input  parameter p-obj-code  as integer   no-undo .
      884     define input  parameter p-fact-date as date      no-undo .
      885     define parameter buffer buf_shift-obj for ub.shift-obj .
      886     define variable v-shift-on      as logical   no-undo .
      887     define variable v-extra-message as character no-undo .
      888     define variable v-error as character no-undo .
      889     do
      890     on error undo, return error return-value
      891     :
      892   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      894     (input  p-obj-type
      895     ,input  p-obj-code
      896     ,input  'shift-on=request'
      897     ,output v-shift-on
      898     ) no-error .
      899       if error-status :error
      900       then do:
      901         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      902         undo, return error v-error .
      903       end.
      904       if v-shift-on = true
      905       then do:
      906         find first buf_shift-obj share-lock
      907           where buf_shift-obj.obj-type   = p-obj-type
      908             and buf_shift-obj.obj-code   = p-obj-code
      909             and buf_shift-obj.shift-date > p-fact-date
      910           use-index pi
      911           no-error .
      912         if not available buf_shift-obj
      913         or buf_shift-obj.status_ <> 'зкр':U
      914         then do:
      915           find last buf_shift-obj
      916             where buf_shift-obj.obj-type = p-obj-type
      917               and buf_shift-obj.obj-code = p-obj-code
      918               and buf_shift-obj.status_  = 'зкр':U
      919             use-index stts
      920             no-error .
      921           if available buf_shift-obj
      922           then do:
      923             assign
      924               v-extra-message =
      925                     substitute("Дата начала последеней закрытой смены на объекте &1"
      926                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      927                               )
      928             .
      929           end.
      930           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      931           undo, return error v-error .
      932         end.
      933       end.
      934     end.
      935   end procedure.
      936   procedure factord-end-day :
      937     define input  parameter p-fact-date            as date    no-undo .
      938     define output parameter p-day-end-fact-order   as decimal no-undo .
      939     do
      940     on error undo, return error return-value
      941     :
      942       if p-fact-date = ?
      943       then do:
      944         return error "Не указана фактическая дата" .
      945       end.
      946       assign
      947         p-day-end-fact-order = integer(p-fact-date) + 0.99
      948       .
      949     end.
      950   end procedure.
      951   procedure factord-to-date :
      952     define input  parameter p-fact-order as decimal no-undo .
      953     define output parameter p-fact-date  as date    no-undo .
      954     define variable v-ref-date  as date      no-undo .
      955     define variable v-ref-delta as integer   no-undo .
      956     do
      957     on error undo, return error return-value
      958     :
      959       if p-fact-order = ?
      960       or p-fact-order = 0
      961       then do:
      962         return error "Не указан fact-order" .
      963       end.
      964       assign
      965         v-ref-date  = date(1, 1, 2000)
      966       .
      967       assign
      968         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      969       .
      970       assign
      971         p-fact-date = v-ref-date + v-ref-delta
      972       .
      973     end.
      974   end procedure.
      975   procedure factord-to-fact-num :
      976     define input  parameter p-fact-order as decimal no-undo .
      977     define output parameter p-fact-num   as integer no-undo .
      978     define variable v-fact-order-trunc as decimal no-undo .
      979     do
      980     on error undo, return error return-value
      981     :
      982       if p-fact-order = ?
      983       or p-fact-order = 0
      984       then do:
      985         return error "Не указан fact-order" .
      986       end.
      987       assign
      988        v-fact-order-trunc = truncate(p-fact-order, 2)
      989       .
      990       assign
      991         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      992       .
      993     end.
      994   end procedure.
      995   procedure factord-to-shift-num :
      996     define input  parameter p-fact-order as decimal no-undo .
      997     define output parameter p-shift-num   as integer no-undo .
      998     define variable  p-shift-numd  as decimal   no-undo .
      999     define variable v-fact-order-trunc as decimal no-undo .
     1000     do
     1001     on error undo, return error return-value
     1002     :
     1003       if p-fact-order = ?
     1004       or p-fact-order = 0
     1005       then do:
     1006         return error "Не указан fact-order" .
     1007       end.
     1008       assign
     1009        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1010       .
     1011       if v-fact-order-trunc < 0.5 then do:
     1012         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1013       end.
     1014       assign
     1015         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1016         .
     1017        assign
     1018         p-shift-num = truncate (p-shift-numd , 0)
     1019       .
     1020     end.
     1021   end procedure.
