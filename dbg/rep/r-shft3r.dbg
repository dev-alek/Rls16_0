       99   procedure create_obj-list :
      100      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      101      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      102      do
      103      on error undo, return error return-value
      104      :
      105         define buffer cli-obj for ub.clients .
      106         define variable p-var as integer no-undo .
      107         define buffer buf_obj-list for obj-list .
      108         find last buf_obj-list  use-index pi no-error .
      109         if available buf_obj-list
      110         then
      111            p-var = buf_obj-list.obj-id + 1.
      112         else
      113            p-var = 1.
      114         find first cli-obj where
      115                   cli-obj.obj-type = p-obj-type
      116               and cli-obj.obj-code = p-obj-code
      117         no-lock no-error.
      118         if available cli-obj
      119         then do:
      120            create buf_obj-list.
      121            assign
      122               buf_obj-list.obj-id   = p-var
      123               buf_obj-list.obj-code = cli-obj.obj-code
      124               buf_obj-list.obj-type = cli-obj.obj-type
      125               buf_obj-list.obj-name = cli-obj.obj-name
      126               buf_obj-list.db-num   = cli-obj.db-num
      127            .
      128         end.
      129      end.
      130   end.
