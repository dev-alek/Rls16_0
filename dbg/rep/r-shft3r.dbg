     1783     on error undo, return error
     1784     :
     1785           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-batch-edit in g#attr-lib
     1786         (input  p-code
     1787         ,output p-section-num
     1788         ) no-error .
     1789       if error-status :error
     1790       then do:
     1791         undo, return error return-value .
     1792       end.
     1793     end.
     1794   end procedure.
     1795   procedure grp-obj-notcorr-value :
     1796   do
     1797   on error undo, return error
     1798   :
     1799   define input parameter p-node-code             as integer      no-undo.
     1800   define input parameter p-obj-type              as character    no-undo.
     1801   define input parameter p-obj-code              as integer      no-undo.
     1802   define output parameter p-notcorr              as character    no-undo init ?.
     1803   define output parameter p-range-notcorr     as integer      no-undo.
     1804   define output parameter p-exists-notcorr    as logical      no-undo.
     1805   define variable v-host-code as integer      no-undo.
     1806   DEFINE VARIABLE v-found as logical no-undo .
     1807   DEFINE VARIABLE v-exists as logical no-undo .
     1808   DEFINE VARIABLE v-range as integer no-undo .
     1809   DEFINE VARIABLE jj as integer no-undo .
     1810   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1811   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1812   define buffer buf_gds-grp for ub.gds-grp.
     1813   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1814   find first buf_gds-grp no-lock where
     1815              buf_gds-grp.node-code = p-node-code no-error .
     1816   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1817     message
     1818       vss-workfile vss-revision vss-description
     1819       skip "Не удалось найти группу товаров с кодом" p-node-code
     1820       view-as alert-box error .
     1821     undo, return error .
     1822   end.
     1823   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1824   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1825     (input  p-obj-type
     1826     ,input  p-obj-code
     1827     ,output v-host-code
     1828     ) no-error .
     1829   if error-status :error
     1830   then do:
     1831       message
     1832         vss-workfile vss-revision vss-description
     1833         skip "Не удалось найти фирму объекта"
     1834         skip p-obj-type p-obj-code
     1835         skip return-value
     1836         skip trim(error-status :get-message(1))
     1837       view-as alert-box error.
     1838       undo, return error .
     1839   end.
     1840   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1841   do while v-found = no and jj < 2:
     1842     if v-range <> 3 then do:
     1843       find first buf_gds-grp-obj no-lock
     1844           where buf_gds-grp-obj.node-code = p-node-code
     1845             and buf_gds-grp-obj.host-code = v-host-code
     1846             and buf_gds-grp-obj.obj-type  = p-obj-type
     1847             and buf_gds-grp-obj.obj-code  = p-obj-code
     1848       no-error .
     1849     end.
     1850     if v-range = 3 or not available buf_gds-grp-obj
     1851     then do:
     1852        if v-range <> 2 then do:
     1853           find first buf_gds-grp-obj no-lock
     1854               where buf_gds-grp-obj.node-code = p-node-code
     1855                 and buf_gds-grp-obj.host-code = v-host-code
     1856                 and buf_gds-grp-obj.obj-type  = ""
     1857                 and buf_gds-grp-obj.obj-code  = 0
     1858           no-error .
     1859         end.
     1860         if v-range = 2 or not available buf_gds-grp-obj
     1861         then do:
     1862             if v-range <> 1 then do:
     1863               find first buf_gds-grp-obj no-lock
     1864                   where buf_gds-grp-obj.node-code = p-node-code
     1865                   and buf_gds-grp-obj.host-code = 0
     1866                   and buf_gds-grp-obj.obj-type  = ""
     1867                   and buf_gds-grp-obj.obj-code  = 0
     1868               no-error .
     1869             end.
     1870             if v-range = 1 or not available buf_gds-grp-obj
     1871             then do:
     1872                 assign
     1873                     v-exists = no
     1874                 .
     1875             end.
     1876             else do:
     1877                 assign
     1878                     v-exists = yes
     1879                     v-range = 1
     1880                 .
     1881             end.
     1882         end.
     1883         else do:
     1884             assign
     1885                 v-exists = yes
     1886                 v-range  = 2
     1887             .
     1888         end.
     1889     end.
     1890     else do:
     1891         assign
     1892             v-exists = yes
     1893             v-range  = 3
     1894         .
     1895     end.
     1896     if available buf_gds-grp-obj
     1897     then do:
     1898       find first buf_gds-grp-obj-attr no-lock
     1899         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1900           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1901           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1902           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1903           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1904         no-error .
     1905       if available buf_gds-grp-obj-attr then do:
     1906         assign
     1907           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1908         .
     1909       end.
     1910       else do:
     1911         assign
     1912           v-notcorr-value = ?
     1913         .
     1914       end.
     1915       assign
     1916       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1917                           then yes
     1918                           else p-exists-notcorr)
     1919       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1920                         then v-range
     1921                         else p-range-notcorr
     1922       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1923                         then v-notcorr-value
     1924                         else p-notcorr
     1925       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1926       jj = jj + 1
     1927       .
     1928     end.
     1929     else do:
     1930       assign
     1931       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1932       jj = jj + 1
     1933       .
     1934     end.
     1935   end.
     1936   end.
     1937   end procedure.
     1938   define variable curr-grp-code like ub.gds-grp.node-code no-undo .
     1939   define variable loc-ii        as   integer              no-undo initial 1 .
     1940   define variable for-supp-name as   character            no-undo .
     1941   define variable cnum-entries  as   integer              no-undo .
     1942   define variable v-curr-r-b    as   character            no-undo .
     1943   define variable v-value as character no-undo .
     1944   define variable v-type as character no-undo .
     1945   define variable v-upper-code  like ub.gds-grp.node-code no-undo .
     1946   define variable v-p-accsup    as   character            no-undo .
     1947   define variable v-grp-name    as    character           no-undo .
     1948   define buffer buf_gds-grp   for ub.gds-grp  .
     1949   define buffer from-stk-line for ub.stk-line .
     1950   define buffer to-stk-line   for ub.stk-line .
     1951   define buffer buf_t-3       for t-3 .
     1952   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1953     (input  'accsup'
     1954     ,input  ''
     1955     ,input  ''
     1956     ,input  0
     1957     ,input  ''
     1958     ,input  ''
     1959     ,input  ''
     1960     ,input  no
     1961     ,output v-p-accsup
     1962     ,output v-type
     1963     ) no-error .
     1964   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1965   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1966     (output v-curr-r-b
     1967     )  .
     1968   define buffer end_shift-obj      for ub.shift-obj .
     1969   define buffer previous-shift-obj for ub.shift-obj.
     1970   define variable fo      as decimal no-undo init 0.
     1971   define variable prev-fo as decimal no-undo init 0.
     1972   define variable moving  as logical no-undo init yes.
     1973   find first end_shift-obj share-lock
     1974     where end_shift-obj.obj-type   = pobj-type
     1975       and end_shift-obj.obj-code   = pobj-code
     1976       and end_shift-obj.shift-date = pshift-date1
     1977       and end_shift-obj.shift-num  = pshift-num1
     1978       no-error.
     1979   if not available end_shift-obj then do:
     1980     message
     1981       vss-workfile vss-revision vss-description skip
     1982       substitute("Не найдена смена с порядковым номером &1 от &2 для объекта &3 &4", pshift-num1, pshift-date1, pobj-type, pobj-code ) skip
     1983       view-as alert-box error .
     1984     return error.
     1985   end.
     1986   else do:
     1987     assign
     1988       fo = end_shift-obj.fact-order
     1989     .
     1990   end.
     1991   find last previous-shift-obj share-lock
     1992     where previous-shift-obj.obj-type = pobj-type
     1993       and previous-shift-obj.obj-code = pobj-code
     1994       and (( previous-shift-obj.shift-date = pshift-date
     1995              and previous-shift-obj.shift-num < pshift-num
     1996            )
     1997            or previous-shift-obj.shift-date < pshift-date
     1998           )
     1999       use-index pi no-error.
     2000   if available previous-shift-obj then do:
     2001       if  previous-shift-obj.shift-date < p-previous-shift-date then do:
     2002         run day-begin-fact-order in this-procedure (
     2003                                                 input  p-previous-shift-date
     2004                                                ,output prev-fo).
     2005       end.
     2006       else do:
     2007       assign
     2008         prev-fo = previous-shift-obj.fact-order
     2009       .
     2010       end.
     2011   end.
     2012   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2013   define temp-table start-stk-line no-undo like ub.stk-line.
     2014   define temp-table end-stk-line   no-undo like ub.stk-line.
     2015   procedure stk-lnrv:
     2016   define input  parameter parobj-type         like ub.clients.obj-type       no-undo.
     2017   define input  parameter parobj-code         like ub.clients.obj-code       no-undo.
     2018   define input  parameter parartic            like ub.goods.artic            no-undo.
     2019   define input  parameter parprod-type        like ub.goods.prod-type        no-undo.
     2020   define input  parameter parprod-code        like ub.goods.prod-code        no-undo.
     2021   define input  parameter parfact-order-start like ub.stk-line.fact-order no-undo.
     2022   define input  parameter parfact-order-end   like ub.stk-line.fact-order no-undo.
     2023   define input  parameter parsum-type         like ub.stk-line.sum-type   no-undo.
     2024   define input  parameter parcat-id           like ub.stk-line.cat-id     no-undo.
     2025   define input  parameter paris-shift         as   logical                no-undo.
     2026   define output parameter table for tt-stk-line.
     2027   define variable i                as integer no-undo.
     2028   define variable varqnty-doc-type as integer no-undo.
     2029   define variable varsum-type like ub.stk-line.sum-type no-undo.
     2030   do on error undo, return error return-value :
     2031   assign varqnty-doc-type = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     2032   do i = 1 to varqnty-doc-type:
     2033      assign varsum-type = parsum-type + ENTRY(i, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     2034   if paris-shift then do:
     2035     for each start-stk-line:                                                                                        delete start-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-start  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date <> ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create start-stk-line.                                                                                      buffer-copy ub.stk-line to start-stk-line.                                                                  end.
     2036   end.
     2037   else do:
     2038     for each start-stk-line:                                                                                        delete start-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-start  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date = ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create start-stk-line.                                                                                      buffer-copy ub.stk-line to start-stk-line.                                                                  end.
     2039   end.
     2040   if paris-shift then do:
     2041     for each end-stk-line:                                                                                        delete end-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-end  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date <> ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create end-stk-line.                                                                                      buffer-copy ub.stk-line to end-stk-line.                                                                  end.
     2042   end.
     2043   else do:
     2044     for each end-stk-line:                                                                                        delete end-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-end  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date = ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create end-stk-line.                                                                                      buffer-copy ub.stk-line to end-stk-line.                                                                  end.
     2045   end.
     2046   if
     2047      available end-stk-line   and
     2048      (not available start-stk-line or
     2049      start-stk-line.fact-order <> end-stk-line.fact-order) then do:
     2050         create tt-stk-line.
     2051         assign
     2052         tt-stk-line.obj-type       = parobj-type
     2053         tt-stk-line.obj-code       = parobj-code
     2054         tt-stk-line.artic          = parartic
     2055         tt-stk-line.prod-type      = parprod-type
     2056         tt-stk-line.prod-code      = parprod-code
     2057         tt-stk-line.sum-type       = varsum-type
     2058         tt-stk-line.cat-id         = parcat-id
     2059         tt-stk-line.fact-qnty      = (if available end-stk-line then (end-stk-line.fact-qnty      - (if available start-stk-line then start-stk-line.fact-qnty      else 0)) else 0)
     2060         tt-stk-line.sum-base       = (if available end-stk-line then (end-stk-line.sum-base       - (if available start-stk-line then start-stk-line.sum-base       else 0)) else 0)
     2061         tt-stk-line.sum-rubl       = (if available end-stk-line then (end-stk-line.sum-rubl       - (if available start-stk-line then start-stk-line.sum-rubl       else 0)) else 0)
     2062         tt-stk-line.SLT-base       = (if available end-stk-line then (end-stk-line.SLT-base       - (if available start-stk-line then start-stk-line.SLT-base       else 0)) else 0)
     2063         tt-stk-line.SLT-rubl       = (if available end-stk-line then (end-stk-line.SLT-rubl       - (if available start-stk-line then start-stk-line.SLT-rubl       else 0)) else 0)
     2064         tt-stk-line.VAT-base       = (if available end-stk-line then (end-stk-line.VAT-base       - (if available start-stk-line then start-stk-line.VAT-base       else 0)) else 0)
     2065         tt-stk-line.VAT-rubl       = (if available end-stk-line then (end-stk-line.VAT-rubl       - (if available start-stk-line then start-stk-line.VAT-rubl       else 0)) else 0)
     2066         tt-stk-line.excise-base    = (if available end-stk-line then (end-stk-line.excise-base    - (if available start-stk-line then start-stk-line.excise-base    else 0)) else 0)
     2067         tt-stk-line.excise-rubl    = (if available end-stk-line then (end-stk-line.excise-rubl    - (if available start-stk-line then start-stk-line.excise-rubl    else 0)) else 0)
     2068         tt-stk-line.other-base     = (if available end-stk-line then (end-stk-line.other-base     - (if available start-stk-line then start-stk-line.other-base     else 0)) else 0)
     2069         tt-stk-line.other-rubl     = (if available end-stk-line then (end-stk-line.other-rubl     - (if available start-stk-line then start-stk-line.other-rubl     else 0)) else 0)
     2070         tt-stk-line.road-tax-base  = (if available end-stk-line then (end-stk-line.road-tax-base  - (if available start-stk-line then start-stk-line.road-tax-base  else 0)) else 0)
     2071         tt-stk-line.road-tax-rubl  = (if available end-stk-line then (end-stk-line.road-tax-rubl  - (if available start-stk-line then start-stk-line.road-tax-rubl  else 0)) else 0)
     2072         tt-stk-line.transport-base = (if available end-stk-line then (end-stk-line.transport-base - (if available start-stk-line then start-stk-line.transport-base else 0)) else 0)
     2073         tt-stk-line.transport-rubl = (if available end-stk-line then (end-stk-line.transport-rubl - (if available start-stk-line then start-stk-line.transport-rubl else 0)) else 0).
     2074      end.
     2075   end.
     2076   end.
     2077   end procedure.
     2078   for each tincome-3
     2079   :
     2080     delete tincome-3 .
     2081   end.
     2082   if pclassify = "totals":U
     2083   then do:
     2084     find first t-3 where
     2085                t-3.grp-code = 0 no-error .
     2086   end.
     2087   _gds-obj:
     2088   for each  ub.gds-obj no-lock where
     2089             ub.gds-obj.obj-type = pobj-type and
     2090             ub.gds-obj.obj-code = pobj-code
     2091     , first ub.goods   no-lock where
     2092             ub.goods.artic     = ub.gds-obj.artic     and
     2093             ub.goods.prod-type = ub.gds-obj.prod-type and
     2094             ub.goods.prod-code = ub.gds-obj.prod-code and
     2095             ub.goods.gds-type  = 'т':U
     2096     , first ub.units   no-lock where
     2097             ub.units.unit-name = ub.goods.unit-base
     2098   :
     2099     if lookup( 'топ':U,  ub.units.type ) > 0 and
     2100        lookup( 'дро':U, ub.units.type ) > 0
     2101     then do:
     2102       v-value = ''.
     2103       run gds-attr-value in this-procedure (
     2104                                               input ub.gds-obj.gds-code
     2105                                             ,input 'ptrl-as-good':U
     2106                                             ,output v-value
     2107                                             ,output v-type) no-error.
     2108       if not Logical(v-value) then do:
     2109       next .
     2110     end.
     2111     end.
     2112     v-upper-code = ub.goods.grp-code.
     2113     v-value = "".
     2114     do while v-upper-code > 0 and v-p-accsup = "yes" and p-batch > 0:
     2115         find first ub.gds-grp where ub.gds-grp.node-code = v-upper-code.
     2116         run ggoattr-value(
     2117           input ub.gds-grp.node-code,
     2118           input 0,
     2119           input "",
     2120           input 0,
     2121           input 'no-inc-auto-rep':U,
     2122           output v-value,
     2123           output v-type
     2124         ).
     2125         if v-value = "yes" then
     2126           leave.
     2127         else
     2128           v-upper-code = ub.gds-grp.upper-code.
     2129     end.
     2130     if v-value = "yes" then next.
     2131     Find Last from-stk-line no-lock where
     2132               from-stk-line.obj-type    = pobj-type            and
     2133               from-stk-line.obj-code    = pobj-code            and
     2134               from-stk-line.artic       = ub.gds-obj.artic     and
     2135               from-stk-line.prod-type   = ub.gds-obj.prod-type and
     2136               from-stk-line.prod-code   = ub.gds-obj.prod-code and
     2137               from-stk-line.cat-id      = '##,##':U       and
     2138               from-stk-line.sum-type    = 'crsa':U          and
     2139               from-stk-line.fact-order <= prev-fo              use-index category no-error .
     2140     find last to-stk-line no-lock where
     2141               to-stk-line.obj-type    = pobj-type            and
     2142               to-stk-line.obj-code    = pobj-code            and
     2143               to-stk-line.artic       = ub.gds-obj.artic     and
     2144               to-stk-line.prod-type   = ub.gds-obj.prod-type and
     2145               to-stk-line.prod-code   = ub.gds-obj.prod-code and
     2146               to-stk-line.cat-id      = '##,##':U       and
     2147               to-stk-line.sum-type    = 'crsa':U          and
     2148               to-stk-line.fact-order <= fo                   use-index category no-error .
     2149   v-grp-name = replace (ub.goods.grp-name," /","/") .
     2150     if pclassify    = "totals":U and
     2151        X-selectgood = 2
     2152     then do:
     2153       find first buf_t-3 where
     2154                  v-grp-name begins buf_t-3.serv-name no-error .
     2155       if not available buf_t-3
     2156       then do:
     2157         next .
     2158       end.
     2159     end.
     2160     else do:
     2161       find first t-3 where
     2162                  v-grp-name begins     t-3.serv-name no-error .
     2163       if not available t-3
     2164       then do:
     2165         next .
     2166       end.
     2167     end.
     2168     assign
     2169       curr-grp-code    = t-3.grp-code-sheet
     2170       t-3.qnty1-before = t-3.qnty1-before + ( if available from-stk-line then from-stk-line.fact-qnty else 0 )
     2171       t-3.netto-before = t-3.netto-before + ( if available from-stk-line
     2172                                               then ( if v-curr-r-b = 'rubl':U
     2173                                                      then from-stk-line.sum-rubl
     2174                                                      else from-stk-line.sum-base )
     2175                                               else 0 )
     2176       t-3.qnty1-after  = t-3.qnty1-after  + ( if available to-stk-line
     2177                                               then to-stk-line.fact-qnty
     2178                                               else ( if available from-stk-line then from-stk-line.fact-qnty else 0 ) )
     2179       t-3.netto-after  = t-3.netto-after  + ( if available to-stk-line
     2180                                               then ( if v-curr-r-b = 'rubl':U
     2181                                                      then to-stk-line.sum-rubl
     2182                                                      else to-stk-line.sum-base )
     2183                                               else ( if available from-stk-line
     2184                                                      then ( if v-curr-r-b = 'rubl':U
     2185                                                             then from-stk-line.sum-rubl
     2186                                                             else from-stk-line.sum-base )
     2187                                                      else 0 ) )
     2188     .
     2189     if moving <> yes
     2190     then do:
     2191       next _gds-obj .
     2192     end.
     2193     if (not available from-stk-line
     2194         and
     2195         not available to-stk-line)
     2196     or (available from-stk-line
     2197         and
     2198         available to-stk-line
     2199         and from-stk-line.fact-order = to-stk-line.fact-order) then do:
     2200       next _gds-obj .
     2201     end.
     2202     for each ub.ot-line no-lock where
     2203              ub.ot-line.obj-type    = pobj-type            and
     2204              ub.ot-line.obj-code    = pobj-code            and
     2205              ub.ot-line.artic       = ub.gds-obj.artic     and
     2206              ub.ot-line.prod-type   = ub.gds-obj.prod-type and
     2207              ub.ot-line.prod-code   = ub.gds-obj.prod-code and
     2208              ub.ot-line.fact-order >= prev-fo              and
     2209              ub.ot-line.fact-order <= fo                   and
     2210              ub.ot-line.cat-id      = '##,##':U       and
     2211              ub.ot-line.sum-type    = 'cost':U
     2212     :
     2213       if not ( ub.ot-line.ext-doc-type = 'ie':U     or
     2214                ub.ot-line.ext-doc-type = 're':U or
     2215                ub.ot-line.ext-doc-type = 'iv':U     or
     2216                ub.ot-line.ext-doc-type = 'rv':U or
     2217                ub.ot-line.ext-doc-type = 'im':U    )
     2218       then do:
     2219         next .
     2220       end.
     2221       find first tincome-3 where
     2222                  tincome-3.grp-code-sheet = curr-grp-code       and
     2223                  tincome-3.doc-code       = ub.ot-line.doc-code no-error .
     2224       if not available tincome-3
     2225       then do:
     2226         find first ub.trn-doc no-lock where
     2227                    ub.trn-doc.doc-code = ub.ot-line.doc-code no-error .
     2228         if available ub.trn-doc then do:
     2229           find first ub.clients no-lock where
     2230                      ub.clients.obj-type = ub.trn-doc.cli-type and
     2231                      ub.clients.obj-code = ub.trn-doc.cli-code no-error .
     2232         end.
     2233         create tincome-3 .
     2234         assign
     2235           tincome-3.grp-code-sheet = curr-grp-code
     2236           tincome-3.supp-name      = ( if available ub.clients then ub.clients.obj-name else "":U )
     2237           tincome-3.supp-type      = ub.trn-doc.cli-type
     2238           tincome-3.supp-code      = ub.trn-doc.cli-code
     2239           tincome-3.doc-code       = ub.ot-line.doc-code
     2240           tincome-3.ii             = t-3.lines + 1
     2241           t-3.lines                = t-3.lines + 1
     2242         .
     2243       end.
     2244       assign
     2245         tincome-3.qnty1-in  = tincome-3.qnty1-in + ub.ot-line.fact-qnty
     2246         tincome-3.netto-in  = tincome-3.netto-in + ub.ot-line.sum-base
     2247         tincome-3.is-fact  = yes
     2248       .
     2249     end.
     2250     for each tt-stk-line
     2251     :
     2252       delete tt-stk-line .
     2253     end.
     2254     run stk-lnrv in this-procedure
     2255       (  input       pobj-type
     2256       ,  input       pobj-code
     2257       ,  input       ub.gds-obj.artic
     2258       ,  input       ub.gds-obj.prod-type
     2259       ,  input       ub.gds-obj.prod-code
     2260       ,  input       prev-fo
     2261       ,  input       fo
     2262       ,  input       'sadt':U
     2263       ,  input       '##,##':U
     2264       ,  input       yes
     2265       , output table tt-stk-line
     2266       ) no-error .
     2267     for each tt-stk-line
     2268     :
     2269       case substring( tt-stk-line.sum-type, length( 'sadt':U ) + 1 ) :
     2270         when 'vt':U      or
     2271         when 'vp':U
     2272         then do:
     2273           find first treal-3 where
     2274                      treal-3.grp-code-sheet = curr-grp-code and
     2275                      treal-3.cpay-code      = -4            and
     2276                      treal-3.curr-code      = 0             no-error .
     2277           if not available treal-3
     2278           then do:
     2279             run create-treal-3 in this-procedure
     2280               ( input t-3.grp-code-sheet
     2281               , input -4
     2282               , input 0
     2283               , input - tt-stk-line.fact-qnty
     2284               , input - tt-stk-line.sum-base
     2285               , input "Инвентаризации"
     2286               , input no
     2287               , input ?
     2288               ) no-error .
     2289           end.
     2290           else do:
     2291             assign
     2292               treal-3.qnty1 = treal-3.qnty1 - tt-stk-line.fact-qnty
     2293               treal-3.netto = treal-3.netto - tt-stk-line.sum-base
     2294             .
     2295           end.
     2296         end.
     2297         when 'ee':U
     2298         then do:
     2299           find first treal-3 where
     2300                      treal-3.grp-code-sheet = curr-grp-code and
     2301                      treal-3.cpay-code      = -3            and
     2302                      treal-3.curr-code      = 0             no-error .
     2303           if not available treal-3
     2304           then do:
     2305             run create-treal-3 in this-procedure
     2306               ( input t-3.grp-code-sheet
     2307               , input -3
     2308               , input 0
     2309               , input - tt-stk-line.fact-qnty
     2310               , input - tt-stk-line.sum-base
     2311               , input "Отпуск без ККМ"
     2312               , input no
     2313               , input ?
     2314               ) no-error .
     2315           end.
     2316           else do:
     2317             assign
     2318               treal-3.qnty1 = treal-3.qnty1 - tt-stk-line.fact-qnty
     2319               treal-3.netto = treal-3.netto - tt-stk-line.sum-base
     2320             .
     2321           end.
     2322         end.
     2323         when 'ie':U          or
     2324         when 'es':U     or
     2325         when 'rs':U or
     2326         when 're':U      or
     2327         when 'iv':U          or
     2328         when 'rv':U      or
     2329         when 'im':U
     2330         then do:
     2331         end.
     2332         otherwise do:
     2333           find first treal-3 where
     2334                      treal-3.grp-code-sheet = curr-grp-code and
     2335                      treal-3.cpay-code      = -1            and
     2336                      treal-3.curr-code      = 0             no-error .
     2337           if not available treal-3
     2338           then do:
     2339             run create-treal-3 in this-procedure
     2340               ( input t-3.grp-code-sheet
     2341               , input -1
     2342               , input 0
     2343               , input - tt-stk-line.fact-qnty
     2344               , input - tt-stk-line.sum-base
     2345               , input "Прочий докум.расход"
     2346               , input no
     2347               , input ?
     2348               ) no-error .
     2349           end.
     2350           else do:
     2351             assign
     2352               treal-3.qnty1 = treal-3.qnty1 - tt-stk-line.fact-qnty
     2353               treal-3.netto = treal-3.netto - tt-stk-line.sum-base
     2354             .
     2355           end.
     2356         end.
     2357       end.
     2358       delete tt-stk-line .
     2359     end.
     2360   end.
