     1244   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1246   procedure paramls-clear :
     1247     define buffer buf_temp-param for temp-param .
     1248     do
     1249     on error undo, return error return-value
     1250     :
     1251       for each buf_temp-param
     1252       on error undo, return error
     1253       :
     1254         delete buf_temp-param .
     1255       end.
     1256     end.
     1257   end procedure.
     1258   procedure paramls-write :
     1259     define input  parameter p-code     as character no-undo .
     1260     define input  parameter p-sub-code as character no-undo .
     1261     define input  parameter p-value    as character no-undo .
     1262     define buffer buf_temp-param for temp-param .
     1263     do
     1264     on error undo, return error return-value
     1265     :
     1266       find first buf_temp-param
     1267         where buf_temp-param.param-code     = p-code
     1268           and buf_temp-param.param-sub-code = p-sub-code
     1269         no-error .
     1270       if not available buf_temp-param then do:
     1271         create buf_temp-param .
     1272         assign
     1273           buf_temp-param.param-code     = p-code
     1274           buf_temp-param.param-sub-code = p-sub-code
     1275         .
     1276       end.
     1277       assign
     1278         buf_temp-param.param-value = p-value
     1279       .
     1280     end.
     1281   end procedure.
     1282   procedure paramls-read :
     1283     define input  parameter p-code          as character no-undo .
     1284     define input  parameter p-sub-code      as character no-undo .
     1285     define input  parameter p-default-value as character no-undo .
     1286     define output parameter p-value         as character no-undo .
     1287     define buffer buf_temp-param for temp-param .
     1288     do
     1289     on error undo, return error return-value
     1290     :
     1291       find first buf_temp-param
     1292         where buf_temp-param.param-code     = p-code
     1293           and buf_temp-param.param-sub-code = p-sub-code
     1294         no-error .
     1295       if available buf_temp-param then do:
     1296         assign
     1297           p-value = buf_temp-param.param-value
     1298         .
     1299       end.
     1300       else do:
     1301         assign
     1302           p-value = p-default-value
     1303         .
     1304       end.
     1305     end.
     1306   end procedure.
     1307   procedure paramls-append :
     1308     define input  parameter p-code     as character no-undo .
     1309     define input  parameter p-sub-code as character no-undo .
     1310     define input  parameter p-value    as character no-undo .
     1311     define buffer buf_temp-param for temp-param .
     1312     do
     1313     on error undo, return error return-value
     1314     :
     1315       find first buf_temp-param
     1316            where buf_temp-param.param-code     = p-code
     1317              and buf_temp-param.param-sub-code = p-sub-code
     1318         no-error .
     1319       if not available buf_temp-param then do:
     1320         create buf_temp-param .
     1321         assign
     1322           buf_temp-param.param-code     = p-code
     1323           buf_temp-param.param-sub-code = p-sub-code
     1324           buf_temp-param.param-value    = p-value
     1325         .
     1326       end.
     1327       else do:
     1328           assign
     1329               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1330           .
     1331       end.
     1332     end.
     1333   end procedure.
     1334     define temp-table tt-rec no-undo
     1335       field id as int
     1336       field code as int
     1337       field artic as char
     1338       field prod-name as char
     1339       field prod-grp as char
     1340       field unit as char
     1341       field price as dec
     1342       field count as dec
     1343       field cost as dec
     1344       field bcodes-by-prod as char
     1345     .
     1346     define temp-table tt-rec-scale no-undo like tt-rec
     1347       field rec-id as int
     1348     .
     1349     define variable g#report-num as integer   no-undo .
     1350     run get-report-num  in parParentProc ( output g#report-num ).
     1351     define variable g#quest-print as logical   no-undo .
     1352     run get-quest-print in parParentProc ( output g#quest-print ).
     1353     define variable g#log as logical   no-undo .
     1354   define variable vss-include-info13 as character format "X(65)" no-undo
     1355   initial "@(#)$Workfile$ $Revision$".
     1356   define stream excel-line.
     1357   define stream excel-cell.
     1358   define temp-table temp_cell-data no-undo
     1359       field data-key as character
     1360       field data-value as character
     1361       index pi is primary unique data-key
     1362   .
     1363   define variable v-r-bcod-pxl-current-data-row     as integer      no-undo.
     1364   define variable v-r-bcod-pxl-sheet1-cur-data-row  as integer      no-undo.
     1365   define variable v-r-bcod-pxl-cell-file-name       as character    no-undo.
     1366   define variable v-r-bcod-pxl-data-file-name       as character    no-undo.
     1367   procedure r-bcod-pxl-init :
     1368   do
     1369   on error undo, return error
     1370   :
     1371       assign
     1372           v-r-bcod-pxl-sheet1-cur-data-row = 0
     1373       .
     1374       run gbl/_tmpfile.p (
     1375             input "xd"
     1376           , input ".txt"
     1377           , output v-r-bcod-pxl-data-file-name
     1378       ).
     1379       output stream excel-line to value( v-r-bcod-pxl-data-file-name ).
     1380       run gbl/_tmpfile.p (
     1381             input "xc"
     1382           , input ".txt"
     1383           , output v-r-bcod-pxl-cell-file-name
     1384       ).
     1385       output stream excel-cell to value( v-r-bcod-pxl-cell-file-name ).
     1386       run r-bcod-pxl-write-cell-data in this-procedure (
     1387             input "sheetList":U
     1388           , input "бар_коды":U
     1389       ).
     1390       if printrubl
     1391       then do:
     1392           run r-bcod-pxl-write-cell-data in this-procedure (
     1393                 input "бар_коды_valutCode":U
     1394               , input "0":U
     1395           ).
     1396       end.
     1397       else do:
     1398           run r-bcod-pxl-write-cell-data in this-procedure (
     1399                 input "бар_коды_valutCode":U
     1400               , input "1":U
     1401           ).
     1402       end.
     1403       run r-bcod-pxl-write-cell-data in this-procedure (
     1404             input "бар_коды_columnList":U
     1405           , input "num,code,artic,prod_name,unit,price,count,cost,bcodes":U
     1406       ).
     1407       run r-bcod-pxl-write-cell-data in this-procedure (
     1408             input "бар_коды_columnType":U
     1409           , input "I,I,S,S,S,S,S,D,S":U
     1410       ).
     1411       run r-bcod-pxl-write-cell-data in this-procedure (
     1412             input "бар_коды_subtotalList":U
     1413           , input "":U
     1414       ).
     1415       run r-bcod-pxl-write-cell-data in this-procedure (
     1416             input "бар_коды_subtotalType":U
     1417           , input "":U
     1418       ).
     1419   end.
     1420   end procedure.
     1421   procedure r-bcod-pxl-write-cell-data :
     1422   define input parameter p-data-key   as character        no-undo.
     1423   define input parameter p-data-value as character        no-undo.
     1424       define buffer buf_temp_cell-data     for temp_cell-data.
     1425   do
     1426   for buf_temp_cell-data
     1427   on error undo, return error
     1428   :
     1429       find first buf_temp_cell-data
     1430            where buf_temp_cell-data.data-key = p-data-key
     1431       no-error.
     1432       if not available buf_temp_cell-data
     1433       then do:
     1434           create buf_temp_cell-data.
     1435           assign
     1436               buf_temp_cell-data.data-key = p-data-key
     1437           .
     1438       end.
     1439       assign
     1440           buf_temp_cell-data.data-value = p-data-value
     1441       .
     1442       put stream excel-cell unformatted
     1443                           buf_temp_cell-data.data-key
     1444           chr(9)   buf_temp_cell-data.data-value
     1445           chr(10)
     1446       .
     1447   end.
     1448   end procedure.
     1449   procedure r-bcod-pxl-write-line-data:
     1450       def input param p-type as int no-undo.
     1451       def input param p-num as int no-undo.
     1452       def input param p-code as int no-undo.
     1453       def input param p-artic as char no-undo.
     1454       def input param p-prod-name as char no-undo.
     1455       def input param p-unit as char no-undo.
     1456       def input param p-price as dec no-undo.
     1457       def input param p-count as char no-undo.
     1458       def input param p-cost as dec no-undo.
     1459       def input param p-bcode as char no-undo.
     1460       def var i as int no-undo.
     1461       def var num as int no-undo.
     1462       v-r-bcod-pxl-current-data-row = v-r-bcod-pxl-current-data-row + 1.
     1463       if p-type = 1 then do:
     1464           put stream excel-line unformatted
     1465                             "бар_коды":U
     1466               chr(9) "DTA":U
     1467               chr(9) p-num
     1468               chr(9) p-code
     1469               chr(9) p-artic
     1470               chr(9) p-prod-name
     1471               chr(9) p-unit
     1472               chr(9) p-price
     1473               chr(9) p-count
     1474               chr(9) p-cost
     1475               chr(9) p-bcode
     1476               chr(10)
     1477           .
     1478       end.
     1479       else if p-type = 2 then do:
     1480           put stream excel-line unformatted
     1481                             "бар_коды":U
     1482               chr(9) "DTA":U
     1483               chr(9) ""
     1484               chr(9) p-code
     1485               chr(9) p-artic
     1486               chr(9) p-prod-name
     1487               chr(9) p-unit
     1488               chr(9) ""
     1489               chr(9) ""
     1490               chr(9) ""
     1491               chr(9) ""
     1492               chr(10)
     1493           .
     1494       end.
     1495       else if p-type = 3 then do:
     1496           put stream excel-line unformatted
     1497                             "бар_коды":U
     1498               chr(9) "DTA":U
     1499               chr(9) p-num
     1500               chr(9) p-code
     1501               chr(9) ""
     1502               chr(9) p-prod-name
     1503               chr(9) ""
     1504               chr(9) p-price
     1505               chr(9) p-count
     1506               chr(9) p-cost
     1507               chr(9) p-bcode
     1508               chr(10)
     1509           .
     1510       end.
     1511       else if p-type = 4 then do:
     1512           put stream excel-line unformatted
     1513                             "бар_коды":U
     1514               chr(9) "DTA":U
     1515               chr(9) "-1"
     1516               chr(9) ""
     1517               chr(9) ""
     1518               chr(9) p-prod-name
     1519               chr(9) ""
     1520               chr(9) ""
     1521               chr(9) ""
     1522               chr(9) ""
     1523               chr(9) ""
     1524               chr(10)
     1525           .
     1526       end.
     1527       else if p-type = 5 then do:
     1528           put stream excel-line unformatted
     1529                             "бар_коды":U
     1530               chr(9) "DTA":U
     1531               chr(9) ""
     1532               chr(9) ""
     1533               chr(9) ""
     1534               chr(9) ""
     1535               chr(9) ""
     1536               chr(9) ""
     1537               chr(9) ""
     1538               chr(9) ""
     1539               chr(9) p-bcode
     1540               chr(10)
     1541           .
     1542       end.
     1543   end.
     1544   procedure r-bcod-pxl-run-excel :
     1545   define input parameter p-header-filename    as character        no-undo.
     1546   define input parameter p-data-filename      as character        no-undo.
     1547       define variable v-template-file-name    as character    no-undo.
     1548       define variable v-vb-file-name          as character    no-undo.
     1549       define buffer buf_temp-param for temp-param .
     1550   do
     1551   for buf_temp-param
     1552   on error undo, return error
     1553   :
     1554       create buf_temp-param.
     1555       assign
     1556           v-template-file-name    = search( "exe/r-bcod-p.xlt" )
     1557           v-vb-file-name          = search( "exe/r-bcod-p.bas")
     1558       .
     1559       if v-template-file-name = ?
     1560       or v-template-file-name = "":U
     1561       then do:
     1562           message
     1563               "Ошибка имени файла шаблона."
     1564           view-as alert-box error.
     1565       end.
     1566       if v-vb-file-name = ?
     1567       or v-vb-file-name = "":U
     1568       then do:
     1569           message
     1570               "Ошибка имени файла кода обработки."
     1571           view-as alert-box error.
     1572       end.
     1573       run paramls-write in this-procedure (
     1574             input "template":U
     1575           , input "template-file-name":U
     1576           , input v-template-file-name
     1577       ).
     1578       run paramls-write in this-procedure (
     1579             input "template":U
     1580           , input "vb-file-name":U
     1581           , input v-vb-file-name
     1582       ).
     1583       run paramls-write in this-procedure (
     1584             input "data":U
     1585           , input "data-header-filename":U
     1586           , input p-header-filename
     1587       ).
     1588       run paramls-write in this-procedure (
     1589             input "data":U
     1590           , input "data-filename":U
     1591           , input p-data-filename
     1592       ).
     1593       run gbl/macroxlt.p (
     1594           input-output table buf_temp-param
     1595       ) no-error.
     1596       if error-status :error
     1597       then do:
     1598           message
     1599                    vss-workfile vss-revision vss-description
     1600               skip(1)
     1601               skip "Ошибка создания файла Excel."
     1602               skip return-value
     1603               skip trim(error-status :get-message(1))
     1604                    trim(error-status :get-message(2))
     1605                    trim(error-status :get-message(3))
     1606           view-as alert-box error.
     1607           undo, return error .
     1608       end.
     1609   end.
     1610   end procedure.
     1611   procedure r-bcod-pxl-close :
     1612   do
     1613   on error undo, return error
     1614   :
     1615       output stream excel-line close.
     1616       output stream excel-cell close.
     1617       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1618           export "exe/r-bcod-p.xlt":U.
     1619           export "exe/r-bcod-p.bas":U.
     1620           export v-r-bcod-pxl-cell-file-name.
     1621           export v-r-bcod-pxl-data-file-name.
     1622       output close.
     1623   end.
     1624   end procedure.
     1625     define buffer buf_clients  for clients.
     1626     define buffer buf_trn-doc  for trn-doc .
     1627     define buffer buf_doc-line for doc-line .
     1628     define buffer buf_gds-dtl  for gds-dtl .
     1629     define buffer buf_goods    for goods .
     1630     def shared var sort-gr      as logical no-undo.
     1631     def shared var sort-name    as logical no-undo.
     1632     def shared var CostPrice    as logical no-undo.
     1633     def shared var print-graft  as logical no-undo.
     1634     def var sym1  as char init ":"   no-undo.
     1635     def var sym2  as char init ":"   no-undo.
     1636     def var sym3  as char init ":"   no-undo.
     1637     def var sym4  as char init ":"   no-undo.
     1638     def var sym5  as char init ":"   no-undo.
     1639     def var sym6  as char init ":"   no-undo.
     1640     def var sym7  as char init ":"   no-undo.
     1641     def var sym8  as char init ":"   no-undo.
     1642     def var sym9  as char init ":"   no-undo.
     1643     def var sym10 as char init ":"   no-undo.
     1644     def var v-doc-num          like trn-doc.doc-code     no-undo.
     1645     def var v-doc-date         like trn-doc.doc-date    no-undo.
     1646     def var v-single-line      as char      no-undo.
     1647     def var v-obj-name         as char      no-undo.
     1648     def var v-cli-name         as char      no-undo.
     1649     def var v-income           as logical   no-undo.
     1650     def var num                as integer   no-undo .
     1651     def var id                 as integer   no-undo .
     1652     def var b-code             as integer   no-undo .
     1653     def var artic              as character no-undo .
     1654     def var gds-name           as character no-undo .
     1655     def var unit-base          as character no-undo .
     1656     def var zen1               as decimal   no-undo .
     1657     def var qnty               as decimal   no-undo .
     1658     def var sqnty              as character no-undo .
     1659     def var sum1               as decimal   no-undo .
     1660     def var list-b-code        as character no-undo .
     1661     define variable v-root-node as integer   no-undo .
     1662     define variable empty-scale as logical   no-undo .
     1663     define variable all-qnty    as decimal   no-undo format "->>>>>9.<<<".
     1664     define variable all-sum     as decimal   no-undo .
     1665     define variable is-new      as logical   no-undo .
     1666     define variable kg-flag     as logical   no-undo .
     1667     def var qh as handle no-undo.
     1668     def var qstr as char no-undo init "FOR EACH tt-rec ".
     1669     def var prev-grp as char no-undo.
     1670     function get-formated-count returns char (p-unit as char, p-count as dec) forward.
     1671     run r-bcod-pxl-init.
     1672     find first buf_trn-doc no-lock  where recid(buf_trn-doc) = rec_id .
     1673     find first buf_clients no-lock
     1674       where buf_clients.obj-type = buf_trn-doc.obj-type
     1675         and buf_clients.obj-code = buf_trn-doc.obj-code
     1676       .
     1677     assign  v-obj-name = string(buf_clients.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ") ") .
     1678     find first buf_clients no-lock
     1679       where buf_clients.obj-type = buf_trn-doc.cli-type
     1680         and buf_clients.obj-code = buf_trn-doc.cli-code
     1681       no-error .
     1682     if available buf_clients then assign v-cli-name = string(buf_clients.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ") ") .
     1683     else assign v-cli-name = "" .
     1684     def stream AktStr .
     1685     define frame Akt
     1686           sym1              column-label ":!:"                               format "X(1)"
     1687           num               column-label "N !п/п"                            format ">>>9"
     1688           sym2              column-label ":!:"                               format "X(1)"
     1689           b-code            column-label "Код ! "                            format ">>>>>>>>9"
     1690           sym3              column-label ":!:"                               format "X(1)"
     1691           artic             column-label " Артикул! "                        format "X(16)"
     1692           sym4              column-label ":!:"                               format "X(1)"
     1693           gds-name          column-label "Название товара! "                 format "X(56)"
     1694           sym5              column-label ":!:"                               format "X(1)"
     1695           unit-base         column-label "Ед.!изм"                           format "X(4)"
     1696           sym6              column-label ":!:"                               format "X(1)"
     1697           zen1              column-label "Цена за ед.!"                      format "->>>>>>>9.99"
     1698           sym7              column-label ":!:"                               format "X(1)"
     1699           sqnty             column-label "Количество!"                       format "X(11)"
     1700           sym8              column-label ":!:"                               format "X(1)"
     1701           sum1              column-label "Стоимость!()!"                     format "->>>>>9.99"
     1702           sym9              column-label ":!:"                               format "X(1)"
     1703           list-b-code       column-label "        БАР-КОДЫ по товару!"       format "X(40)"
     1704           sym10             column-label ":!:"                               format "X(1)"
     1705       header
     1706           cur-time-print() at 5 format "X(35)"
     1707           string( "Накладная с баркодами производителя " ) at 50 format "X(40)" v-doc-num format "X(10)" " от " v-doc-date format "99/99/9999"
     1708           string( "Страница " + string( PAGE-NUMBER( AktStr ), ">>9" ) ) at 160 format "X(13)" skip
     1709           v-single-line format "X(190)" at 1
     1710       with width 235 down stream-io use-text .
     1711     if PrintRubl then do:
     1712       assign
     1713         zen1:label  = "Цена (РУБ)"
     1714       .
     1715       define frame Akt
     1716       sum1              column-label "Стоимость!(РУБ)" format "->>>>>9.99".
     1717     end.
     1718     else do:
     1719       assign
     1720         zen1:label  = "Цена (Б.Вал)"
     1721       .
     1722       define frame Akt
     1723       sum1              column-label "Стоимость!(Б.Вал)" format "->>>>>9.99".
     1724     end.
     1725   if session :set-wait-state( "compiler" ) then.
     1726     assign
     1727       v-doc-num  = buf_trn-doc.doc-code
     1728       v-doc-date = buf_trn-doc.doc-date
     1729       v-single-line = fill("-", 234)
     1730       v-income = ( if buf_trn-doc.doc-type = 'при':U or buf_trn-doc.doc-type = 'возврат':U then yes else no )
     1731       num = 0
     1732     .
     1733   output stream AktStr to value( string( session:temp-directory +
     1734                                        "rpt" + string( g#report-num ) ) )
     1735                                        page-size  value(43) .
     1736     put stream AktStr space(25) string( "Накладная с баркодами производителя N " + v-doc-num + " от " + string(v-doc-date,"99/99/9999") ) format "x(190)"    skip(1) .
     1737     put stream AktStr space(5) "Отправитель : " (if v-income = yes then v-cli-name else v-obj-name )    format "X(60)"  skip
     1738                       space(5) "Покупатель  : " (if v-income = yes then v-obj-name else v-cli-name )    format "X(60)"  skip(2)
     1739                       space(5) "Примечание  : " (if not( buf_trn-doc.PS BEGinS "@" ) then buf_trn-doc.PS else "")     format "X(160)"  skip
     1740                       .
     1741     form header
     1742               v-single-line format "X(190)" at 1 skip
     1743               "Продолжение - на следующей странице" at 30 skip
     1744               with frame Bottomframe width 232 page-bottom no-labels no-box .
     1745     view stream aktstr frame bottomframe .
     1746     for each buf_doc-line no-lock
     1747       where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1748       , first buf_goods no-lock
     1749         where buf_goods.artic      = buf_doc-line.artic
     1750           and buf_goods.prod-type  = buf_doc-line.prod-type
     1751           and buf_goods.prod-code  = buf_doc-line.prod-code
     1752           :
     1753       run create-line.
     1754     end.
     1755     if not sort-gr and not sort-name and not print-graft then
     1756       qstr = qstr + "by code".
     1757     if sort-name then
     1758       qstr = qstr + "by prod-name ".
     1759     if sort-gr then
     1760       qstr = qstr + "by prod-grp ".
     1761     if print-graft then
     1762       qstr = qstr + "by artic ".
     1763     create query qh.
     1764     qh:SET-BUFFERS(buffer tt-rec:handle).
     1765     qh:QUERY-PREPARE(qstr).
     1766     qh:QUERY-OPEN ().
     1767     repeat:
     1768         qh:GET-NEXT ().
     1769         if qh:QUERY-OFF-END then leave.
     1770         if sort-gr and prev-grp <> tt-rec.prod-grp then do:
     1771           run print-grp.
     1772           prev-grp = tt-rec.prod-grp.
     1773         end.
     1774         run write-line.
     1775     end.
     1776     delete object qh.
     1777     put stream aktstr v-single-line format "X(190)" skip.
     1778     display stream aktstr
     1779       sym1   "ИТОГО"  @ gds-name
     1780       sym7   get-formated-count((if kg-flag then "кг" else ""), all-qnty) @ sqnty
     1781       sym8   all-sum  @ sum1
     1782       sym9
     1783       sym10
     1784     with frame Akt .
     1785     down stream aktstr with frame akt .
     1786     put stream aktstr v-single-line format "X(190)" skip.
     1787     hide stream AktStr frame Bottomframe .
     1788     output stream AktStr close.
     1789     run write-excel-vars.
     1790     run r-bcod-pxl-close.
     1791   if session :set-wait-state( "" ) then.
     1792   if g#quest-print = false
     1793   then do:
     1794     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1795                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1796                                         OUTPUT g#log ).
     1797   end.
     1798   else do:
     1799     os-command silent
     1800       value( "COPY /b " +
     1801         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1802         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1803         string( session:temp-directory) +  "$" + string( g#report-num )
     1804                 ) .
     1805     os-command silent
     1806       value( "COPY /b " +
     1807         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1808         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1809         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1810                 ) .
     1811   end.
     1812   end.
     1813   function get-formated-count returns char (p-unit as char, p-count as dec):
     1814       def var retval as char no-undo.
     1815       if p-unit = "кг" then
     1816           retval = string(p-count, "->>>>>9.999").
     1817       else
     1818           retval = string(p-count, "->>>>>>>>>9").
     1819       return retval.
     1820   end.
     1821   function get-bcode returns char(input-output num as int, len as int, bcodes as char):
     1822       def var nums as int no-undo.
     1823       def var i as int no-undo.
     1824       def var str as char no-undo.
     1825       def var tempstr as char no-undo.
     1826       def var fflag as logical no-undo init true.
     1827       nums = num-entries(bcodes).
     1828       if num = -1 then return "".
     1829       do i = num to nums:
     1830           tempstr = str + (if not fflag then ", " else "") + entry(i, bcodes).
     1831           fflag = false.
     1832           if length(tempstr) <= len then do:
     1833               str = tempstr.
     1834           end.
     1835           else do:
     1836               if i = nums then
     1837                   num = -1.
     1838               else
     1839                   num = i.
     1840               return str.
     1841           end.
     1842       end.
     1843       num = -1.
     1844       return str.
     1845   end.
     1846   procedure write-line :
     1847     def var bcode-ind as int no-undo init 1.
     1848     def var bcodes as char no-undo.
     1849     def var bcode as char no-undo.
     1850     find first tt-rec-scale where tt-rec-scale.rec-id = tt-rec.id no-error.
     1851     if not avail tt-rec-scale then do:
     1852         num = num + 1.
     1853         bcodes = tt-rec.bcodes-by-prod.
     1854         tt-rec.bcodes-by-prod = get-bcode(input-output bcode-ind, 40, bcodes).
     1855         disp stream aktstr
     1856           sym1
     1857           num @ num
     1858           sym2
     1859           tt-rec.code @ b-code
     1860           sym3
     1861           tt-rec.artic @ artic
     1862           sym4
     1863           tt-rec.prod-name @ gds-name
     1864           sym5
     1865           tt-rec.unit @ unit-base
     1866           sym6
     1867           tt-rec.price @ zen1
     1868           sym7
     1869           get-formated-count(tt-rec.unit, tt-rec.count) @ sqnty
     1870           sym8
     1871           tt-rec.cost @ sum1
     1872           sym9
     1873           tt-rec.bcodes-by-prod @ list-b-code
     1874           sym10
     1875         with frame akt.
     1876         down stream aktstr with frame akt .
     1877         run r-bcod-pxl-write-line-data(
     1878           1,
     1879           num,
     1880           tt-rec.code,
     1881           tt-rec.artic,
     1882           tt-rec.prod-name,
     1883           tt-rec.unit,
     1884           tt-rec.price,
     1885           get-formated-count(tt-rec.unit, tt-rec.count),
     1886           tt-rec.cost,
     1887           tt-rec.bcodes-by-prod
     1888         ).
     1889         do while true:
     1890             bcode = get-bcode(input-output bcode-ind, 40, bcodes).
     1891             if bcode = "" then leave.
     1892             disp stream aktstr
     1893             sym9
     1894             bcode @ list-b-code
     1895             sym10
     1896             with frame akt.
     1897             down stream aktstr with frame akt .
     1898             run r-bcod-pxl-write-line-data(
     1899               5,
     1900               0,
     1901               0,
     1902               "",
     1903               "",
     1904               "",
     1905               0,
     1906               0,
     1907               0,
     1908               bcode
     1909             ).
     1910         end.
     1911     end.
     1912     else do:
     1913       disp stream aktstr
     1914           sym1
     1915           sym2  tt-rec.code @ b-code
     1916           sym3  tt-rec.artic @ artic
     1917           sym4  tt-rec.prod-name @ gds-name
     1918           sym5  tt-rec.unit @ unit-base
     1919           sym6
     1920           sym7
     1921           sym8
     1922           sym9
     1923           sym10
     1924       with frame akt.
     1925       down stream aktstr with frame akt .
     1926       run r-bcod-pxl-write-line-data(
     1927         2,
     1928         -1,
     1929         tt-rec.code,
     1930         tt-rec.artic,
     1931         tt-rec.prod-name,
     1932         tt-rec.unit,
     1933         -1,
     1934         -1,
     1935         -1,
     1936         ""
     1937       ).
     1938     end.
     1939     if avail tt-rec-scale then do:
     1940         for each tt-rec-scale
     1941           where tt-rec-scale.rec-id = tt-rec.id
     1942             by tt-rec-scale.bcode:
     1943           num = num + 1.
     1944           bcode-ind = 1.
     1945           bcodes = tt-rec-scale.bcodes-by-prod.
     1946           tt-rec-scale.bcodes-by-prod = get-bcode(input-output bcode-ind, 40, bcodes).
     1947           display stream aktstr
     1948               sym1  num @ num
     1949               sym2  tt-rec-scale.code @ b-code
     1950               sym3
     1951               sym4  tt-rec-scale.prod-name  @ gds-name
     1952               sym5
     1953               sym6  tt-rec-scale.price @ zen1
     1954               sym7  get-formated-count(tt-rec.unit, tt-rec-scale.count) @ sqnty
     1955               sym8  tt-rec-scale.cost @ sum1
     1956               sym9  tt-rec-scale.bcodes-by-prod  @ list-b-code
     1957               sym10
     1958           with frame akt.
     1959           down stream aktstr with frame akt .
     1960           run r-bcod-pxl-write-line-data(
     1961             3,
     1962             num,
     1963             tt-rec-scale.code,
     1964             "",
     1965             tt-rec-scale.prod-name,
     1966             "",
     1967             tt-rec-scale.price,
     1968             get-formated-count(tt-rec.unit, tt-rec-scale.count),
     1969             tt-rec-scale.cost,
     1970             tt-rec-scale.bcodes-by-prod
     1971           ).
     1972         do while true:
     1973             bcode = get-bcode(input-output bcode-ind, 40, bcodes).
     1974             if bcode = "" then leave.
     1975             disp stream aktstr
     1976             sym9
     1977             bcode @ list-b-code
     1978             sym10
     1979             with frame akt.
     1980             down stream aktstr with frame akt .
     1981             run r-bcod-pxl-write-line-data(
     1982               5,
     1983               0,
     1984               0,
     1985               "",
     1986               "",
     1987               "",
     1988               0,
     1989               0,
     1990               0,
     1991               bcode
     1992             ).
     1993         end.
     1994       end.
     1995     end.
     1996   end.
     1997   procedure create-line :
     1998     do
     1999     on error undo, return error return-value
     2000     :
     2001       define variable new-list as character no-undo .
     2002   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2003     (input  buf_goods.gds-code
     2004     ,input  ?
     2005     ,output b-code
     2006     ) no-error .
     2007       if error-status :error then do:
     2008         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" buf_goods.gds-code skip
     2009         view-as alert-box error .
     2010         undo, return error .
     2011       end.
     2012   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2013   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2014     (input  buf_goods.artic
     2015     ,input  buf_goods.prod-type
     2016     ,input  buf_goods.prod-code
     2017     ,output v-root-node
     2018     )  .
     2019   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2020     (input  v-root-node
     2021     ,input  'empty-scale=request'
     2022     ,output empty-scale
     2023     )  .
     2024       define variable v1-sum-rubl as decimal   no-undo .
     2025       define variable v1-sum-base as decimal   no-undo .
     2026       define variable v2-sum-rubl as decimal   no-undo .
     2027       define variable v2-sum-base as decimal   no-undo .
     2028       define variable tmp         as decimal   no-undo .
     2029       run r-cost in this-procedure ( input buf_doc-line.doc-code   , input buf_doc-line.artic , input buf_doc-line.prod-type
     2030                                      , input buf_doc-line.prod-code  , output tmp     , output tmp    , output tmp
     2031                                      , output v1-sum-base      , output v1-sum-rubl   , output tmp    , output tmp
     2032                                      , output tmp   , output tmp   , output tmp       , output tmp    , output tmp
     2033                                      , output tmp   , output tmp   , output tmp       , output tmp    , output tmp ).
     2034       run r-sale in this-procedure ( input buf_doc-line.doc-code   , input buf_doc-line.artic   , input buf_doc-line.prod-type
     2035                                      , input buf_doc-line.prod-code  , output tmp     , output tmp    , output tmp
     2036                                      , output v2-sum-base      , output v2-sum-rubl   , output tmp    , output tmp
     2037                                      , output tmp      , output tmp   , output tmp    , output tmp    , output tmp
     2038                                      , output tmp      , output tmp   , output tmp    , output tmp    , output tmp ).
     2039       if CostPrice then do:
     2040         if buf_doc-line.ext-doc-type = 'ie':U or buf_doc-line.ext-doc-type = 'ep':U or
     2041            buf_doc-line.ext-doc-type = 'im':U  or buf_doc-line.ext-doc-type = 'wm':U then do:
     2042           if PrintRubl then assign zen1 = v2-sum-rubl / buf_doc-line.fact-qnty .
     2043           else                     zen1 = v2-sum-base / buf_doc-line.fact-qnty .
     2044         end.
     2045         else do:
     2046           if PrintRubl then assign zen1 = v1-sum-rubl / buf_doc-line.fact-qnty .
     2047           else                     zen1 = v1-sum-base / buf_doc-line.fact-qnty .
     2048         end.
     2049       end.
     2050       else do:
     2051         if buf_doc-line.ext-doc-type = 'ie':U or buf_doc-line.ext-doc-type = 'ep':U or
     2052            buf_doc-line.ext-doc-type = 'im':U  or buf_doc-line.ext-doc-type = 'wm':U then do:
     2053           if PrintRubl then assign zen1 = v1-sum-rubl / buf_doc-line.fact-qnty .
     2054           else                     zen1 = v1-sum-base / buf_doc-line.fact-qnty .
     2055         end.
     2056         else do:
     2057           if PrintRubl then assign zen1 = v2-sum-rubl / buf_doc-line.fact-qnty .
     2058           else                     zen1 = v2-sum-base / buf_doc-line.fact-qnty .
     2059         end.
     2060       end.
     2061       if zen1 < 0 then assign zen1 = - zen1 .
     2062       id = id + 1.
     2063       create tt-rec.
     2064       tt-rec.id = id.
     2065       if buf_goods.unit-base = "кг" then
     2066         kg-flag = true.
     2067       if empty-scale then do:
     2068         assign
     2069           all-qnty = all-qnty + buf_doc-line.fact-qnty
     2070           all-sum  = all-sum  + buf_doc-line.fact-qnty * zen1
     2071         .
     2072         run b-code-lst in this-procedure .
     2073         id = id + 1.
     2074         assign
     2075           tt-rec.id = id
     2076           tt-rec.code = b-code
     2077           tt-rec.artic = buf_goods.artic
     2078           tt-rec.prod-name = buf_goods.gds-name
     2079           tt-rec.prod-grp = buf_goods.grp-name
     2080           tt-rec.unit = buf_goods.unit-base
     2081           tt-rec.price = zen1
     2082           tt-rec.count = buf_doc-line.fact-qnty
     2083           tt-rec.cost = (buf_doc-line.fact-qnty * zen1)
     2084           tt-rec.bcodes-by-prod = list-b-code
     2085         .
     2086       end.
     2087       else do:
     2088         assign
     2089           tt-rec.code = b-code
     2090           tt-rec.artic = buf_goods.artic
     2091           tt-rec.prod-name = buf_goods.gds-name
     2092           tt-rec.prod-grp = buf_goods.grp-name
     2093           tt-rec.unit = buf_goods.unit-base
     2094         .
     2095       end.
     2096       if empty-scale = no then do:
     2097         for each buf_gds-dtl no-lock
     2098           where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     2099             and buf_gds-dtl.artic     = buf_doc-line.artic
     2100             and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     2101             and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     2102           :
     2103   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2104     (input  buf_goods.gds-code
     2105     ,input  buf_gds-dtl.prt-code
     2106     ,output b-code
     2107     ) no-error .
     2108           if error-status :error then do:
     2109             message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip  "Код товара" buf_goods.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip
     2110             view-as alert-box error .
     2111             undo, return error .
     2112           end.
     2113           if CostPrice then do:
     2114             if buf_doc-line.ext-doc-type = 'ie':U or buf_doc-line.ext-doc-type = 'ep':U or
     2115               buf_doc-line.ext-doc-type = 'im':U  or buf_doc-line.ext-doc-type = 'wm':U then do:
     2116               if PrintRubl then assign zen1 = buf_gds-dtl.price-rubl .
     2117               else                     zen1 = buf_gds-dtl.price-base .
     2118             end.
     2119           end.
     2120           else do:
     2121             if buf_doc-line.ext-doc-type = 'ie':U or buf_doc-line.ext-doc-type = 'ep':U or
     2122                buf_doc-line.ext-doc-type = 'im':U  or buf_doc-line.ext-doc-type = 'wm':U then do:
     2123             end.
     2124             else do:
     2125               if PrintRubl then assign zen1 = buf_gds-dtl.price-rubl .
     2126               else                     zen1 = buf_gds-dtl.price-base .
     2127             end.
     2128           end.
     2129           run b-code-lst in this-procedure .
     2130           find first gds-prt where gds-prt.node-code  = buf_gds-dtl.prt-code no-lock no-error .
     2131           assign
     2132             all-qnty = all-qnty + buf_gds-dtl.fact-qnty
     2133             all-sum  = all-sum  + buf_gds-dtl.fact-qnty * zen1
     2134           .
     2135           create tt-rec-scale.
     2136           assign
     2137               tt-rec-scale.rec-id = tt-rec.id
     2138               tt-rec-scale.code = b-code
     2139               tt-rec-scale.prod-name = ('  '+ gds-prt.f-name)
     2140               tt-rec-scale.prod-grp = buf_goods.grp-name
     2141               tt-rec-scale.price = zen1
     2142               tt-rec-scale.count = buf_gds-dtl.fact-qnty
     2143               tt-rec-scale.cost = (buf_gds-dtl.fact-qnty * zen1)
     2144               tt-rec-scale.bcodes-by-prod = list-b-code
     2145           .
     2146         end.
     2147       end.
     2148     end.
     2149   end procedure.
     2150   procedure print-grp :
     2151     do
     2152     on error undo, return error return-value
     2153     :
     2154       def var grp-name as char no-undo.
     2155       grp-name = "    " + tt-rec.prod-grp.
     2156       display stream aktstr
     2157         sym1
     2158         grp-name @ gds-name
     2159         sym10
     2160       with frame Akt .
     2161       down stream aktstr with frame akt .
     2162       run r-bcod-pxl-write-line-data(
     2163         4,
     2164         -1,
     2165         -1,
     2166         "",
     2167         grp-name,
     2168         "",
     2169         -1,
     2170         -1,
     2171         -1,
     2172         ""
     2173       ).
     2174     end.
     2175   end procedure.
     2176   procedure write-excel-vars:
     2177       define variable v-date as date      no-undo .
     2178       define variable v-time as integer   no-undo .
     2179       run cur-time in this-procedure
     2180         (output v-date
     2181         ,output v-time
     2182       ).
     2183       run r-bcod-pxl-write-cell-data(
     2184           "h_sender":U,
     2185           (if v-income = yes then v-cli-name else v-obj-name )
     2186       ).
     2187       run r-bcod-pxl-write-cell-data(
     2188           "h_buyer":U,
     2189           (if v-income = yes then v-obj-name else v-cli-name )
     2190       ).
     2191       run r-bcod-pxl-write-cell-data(
     2192           "h_note":U,
     2193           (if not( buf_trn-doc.PS BEGinS "@" ) then buf_trn-doc.PS else "")
     2194       ).
     2195       run r-bcod-pxl-write-cell-data(
     2196           "h_count":U,
     2197           get-formated-count((if kg-flag then "кг" else ""), all-qnty)
     2198       ).
     2199       run r-bcod-pxl-write-cell-data(
     2200           "h_cost":U,
     2201           string(all-sum)
     2202       ).
     2203       run r-bcod-pxl-write-cell-data(
     2204           "h_head_info":U,
     2205           string(v-doc-num, "X(10)") + " от " + string(v-doc-date, "99/99/9999")
     2206       ).
     2207       run r-bcod-pxl-write-cell-data(
     2208           "h_date_print":U,
     2209           (string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U))
     2210       ).
     2211   end.
     2212   procedure b-code-lst :
     2213     do
     2214     on error undo, return error return-value
     2215     :
     2216         assign
     2217           is-new = yes
     2218           list-b-code = ""
     2219         .
     2220         for each prod-bc no-lock where prod-bc.b-code = b-code :
     2221           if is-new then do:
     2222             assign is-new = no .
     2223             if prod-bc.bc-on then assign list-b-code = "* " + prod-bc.b-str .
     2224             else assign list-b-code = prod-bc.b-str .
     2225           end.
     2226           else do:
     2227             if prod-bc.bc-on then assign list-b-code = list-b-code + "," +  "* " + prod-bc.b-str .
     2228             else assign list-b-code = list-b-code + "," + prod-bc.b-str .
     2229           end.
     2230           if length(list-b-code) > 30000 then do:
     2231             message vss-workfile vss-revision vss-description skip "Слишком много баркодов производителя! Список будет выводиться неполностью." skip  "Код товара " buf_goods.gds-code " Артикул товара " buf_goods.artic skip
     2232             view-as alert-box error .
     2233             leave.
     2234           end.
     2235         end.
     2236     end.
     2237   end procedure.
