      929           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
      930       on error undo, return error
      931       :
      932           if buf_trn-doc.doc-type <> 'инв':U
      933           then do:
      934               if buf_trn-doc.doc-type = 'при':U
      935               or buf_trn-doc.doc-type = 'возврат':U
      936               then do:
      937                   assign
      938                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
      939                   .
      940               end.
      941               else do:
