      884   procedure twowin_clear :
      885       define buffer buf_temp_twowin_items        for temp_twowin_items.
      886   do
      887   for buf_temp_twowin_items
      888   on error undo, return error
      889   :
      890       empty temp-table buf_temp_twowin_items.
      891   end.
