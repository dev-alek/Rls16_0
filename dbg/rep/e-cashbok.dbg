      893   procedure twowin_add-item :
      894   define input parameter p-ext-key   as character        no-undo.
      895   define input parameter p-item-name as character        no-undo.
      896   define input parameter p-item-desc as character        no-undo.
      897   define input parameter p-selected  as logical          no-undo.
      898       define buffer buf_temp_twowin_items        for temp_twowin_items.
      899   do
      900   for buf_temp_twowin_items
      901   on error undo, return error
      902   :
      903       assign
      904           v-twowin13-itm-key = v-twowin13-itm-key + 1
      905       .
      906       create temp_twowin_items.
      907       assign
      908           temp_twowin_items.itm-key      = v-twowin13-itm-key
      909           temp_twowin_items.itmExtKey    = p-ext-key
      910           temp_twowin_items.itmName      = p-item-name
      911           temp_twowin_items.itmDesc      = p-item-desc
      912           temp_twowin_items.itmSelected  = p-selected
      913           temp_twowin_items.selLeft      = no
      914           temp_twowin_items.selRight     = no
      915       .
      916   end.
      917   end procedure.
      918   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   procedure gen-key-rec :
      920     define input  parameter p-tbl-name    as character no-undo.
      921     define input  parameter p-bh_tbl-name as handle    no-undo.
      922     define output parameter p-key-rec     as character no-undo.
      923     do
      924     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      925     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      926     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      927     :
      928       define variable fh               as handle    no-undo .
      929       define variable v-ok             as logical   no-undo .
      930       define variable v-inform         as character no-undo .
      931       define variable v-ind            as integer   no-undo .
      932       define variable v-idx-field-qnty as integer   no-undo .
      933       if p-tbl-name = ?
      934         or p-tbl-name = "":U
      935       then do:
      936         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info14 ).
      937       end.
      938       if not p-bh_tbl-name:available then do:
      939         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info14, p-tbl-name ).
      940       end.
      941       assign
      942         p-key-rec = p-tbl-name
      943         v-inform  = p-bh_tbl-name:index-information(1)
      944         v-ind     = 2
      945       .
      946       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      947       on error undo, return error
      948       :
      949         assign
      950           v-inform = p-bh_tbl-name:index-information( v-ind )
      951           v-ind    = v-ind + 1
      952         .
      953       end.
      954       if v-inform = ?
      955         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      956         or entry( 3, v-inform, ",":U ) <> "1":U
      957       then do:
      958         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, p-tbl-name ).
      959       end.
      960       else do:
      961         assign
      962           v-idx-field-qnty = num-entries( v-inform ) - 4
      963         .
      964         if v-idx-field-qnty < 2 then do:
      965           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, p-tbl-name ).
      966         end.
      967         do v-ind = 1 to v-idx-field-qnty by 2
      968         on error undo, return error
      969         :
      970           assign
      971             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      972             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      973           .
      974         end.
      975       end.
      976       if p-key-rec = ? then do:
      977         assign
      978           p-key-rec = "":U
      979         .
      980         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info14, p-tbl-name ).
      981       end.
      982     end.
      983     return.
      984   end procedure.
      985   procedure gen-where-keyr-tab :
      986     define input  parameter i-tableSerach as character no-undo.
      987     define input  parameter i-tablekey   as character  no-undo.
      988     define input  parameter p-key-rec    as character  no-undo.
      989     define input  parameter p-key-handle as handle     no-undo .
      990     define input  parameter p-db-name    as character  no-undo .
      991     define input  parameter p-tt-handle  as handle     no-undo .
      992     define output parameter o-Where      as character  no-undo.
      993     do
      994     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      995     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      996     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      997     :
      998       define variable v-full-tbl-name  as character no-undo .
      999       define variable bh_tbl-name      as handle    no-undo .
     1000       define variable fh_key           as handle    no-undo .
     1001       define variable fh_search        as handle    no-undo .
     1002       define variable v-field-num      as integer   no-undo .
     1003       define variable v-count-fld      as integer   no-undo .
     1004       define variable v-inform         as character no-undo .
     1005       define variable v-ind            as integer   no-undo .
     1006       define variable v-idx-field-qnty as integer   no-undo .
     1007       define variable v-field-name     as character no-undo .
     1008       define variable v-field-val      as character no-undo .
     1009       define variable v-word-link      as character no-undo .
     1010       define variable vTable           as character no-undo.
     1011       define variable bh_tbl-key       as handle    no-undo .
     1012       assign
     1013         p-key-rec = trim( p-key-rec )
     1014       .
     1015       if p-key-handle <> ? then do:
     1016         if not valid-handle(p-key-handle)
     1017            or p-key-handle:type <> "buffer"
     1018         then do:
     1019           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info14 ).
     1020         end.
     1021         if num-entries( p-key-rec, chr(3) ) > 1
     1022           or p-key-rec = ?
     1023           or p-key-rec = "":U
     1024         then do:
     1025           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info14, p-key-rec ).
     1026         end.
     1027       end.
     1028       else do:
     1029         if p-key-rec = ?
     1030           or p-key-rec = "":U
     1031         then do:
     1032           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1033         end.
     1034       end.
     1035       assign
     1036         vTable = entry( 1 , p-key-rec, chr(3) )
     1037       .
     1038       if p-tt-handle <> ?
     1039         and ( not valid-handle(p-tt-handle)
     1040               or p-tt-handle:type <> "buffer"
     1041             )
     1042       then do:
     1043         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info14, vTable, chr(10) ).
     1044       end.
     1045       if p-tt-handle = ? then do:
     1046         assign
     1047           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1048         .
     1049         create buffer bh_tbl-name for table v-full-tbl-name .
     1050       end.
     1051       else do:
     1052         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1053       end.
     1054       assign
     1055         v-inform = bh_tbl-name:index-information(1)
     1056         v-ind    = 2
     1057       .
     1058       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1059       on error undo, return error
     1060       :
     1061         assign
     1062           v-inform = bh_tbl-name:index-information( v-ind )
     1063           v-ind    = v-ind + 1
     1064         .
     1065       end.
     1066       if v-inform = ?
     1067         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1068         or entry( 3, v-inform, ",":U ) <> "1":U
     1069       then do:
     1070         delete object bh_tbl-name no-error.
     1071         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info14, vTable ).
     1072       end.
     1073       assign
     1074         v-idx-field-qnty = num-entries( v-inform ) - 4
     1075       .
     1076       if v-idx-field-qnty < 2 then do:
     1077         delete object bh_tbl-name no-error.
     1078         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, vTable ).
     1079       end.
     1080       assign
     1081         o-where     = "where":U
     1082         v-word-link = "":U
     1083         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1084         v-count-fld = 0
     1085       .
     1086       if i-tablekey ne "" and i-tablekey ne ?
     1087       then do:
     1088         assign
     1089           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1090         .
     1091         create buffer bh_tbl-key for table v-full-tbl-name .
     1092       end.
     1093       if i-tableSerach ne "" and i-tableSerach ne ?
     1094       then do:
     1095         delete object bh_tbl-name no-error.
     1096         assign
     1097           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1098         .
     1099         create buffer bh_tbl-name for table v-full-tbl-name .
     1100       end.
     1101       block_where:
     1102       do v-ind = 1 to v-idx-field-qnty by 2
     1103       on error undo, return error
     1104       :
     1105         assign
     1106           v-count-fld = v-count-fld + 1
     1107         .
     1108         if p-key-handle = ?
     1109           and v-count-fld > v-field-num
     1110         then do:
     1111           leave block_where.
     1112         end.
     1113         define variable VfieldKeyTable as handle no-undo.
     1114         assign
     1115           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1116           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1117         .
     1118         if     bh_tbl-key ne ?
     1119         then do:
     1120            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1121            if VfieldKeyTable eq ?
     1122            then next block_where.
     1123         end.
     1124         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1125         then
     1126            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1127         else
     1128            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1129         if p-key-handle = ? then do:
     1130           assign
     1131             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1132           .
     1133         end.
     1134         else do:
     1135           assign
     1136             fh_key = p-key-handle:buffer-field( v-field-name )
     1137           .
     1138           if fh_key = ?
     1139             or not valid-handle( fh_key )
     1140           then do:
     1141             delete object bh_tbl-name.
     1142             if     bh_tbl-key ne ?
     1143             then
     1144                delete object bh_tbl-key.
     1145             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info14, p-key-handle:name, v-field-name ).
     1146           end.
     1147           assign
     1148             v-field-val = fh_key:buffer-value
     1149           .
     1150         end.
     1151         if fh_search:data-type ="character":U then do:
     1152           assign
     1153             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1154             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1155             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1156             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1157             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1158             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1159             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1160             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1161             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1162             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1163             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1164             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1165             v-field-val = substitute( '"&1"', v-field-val )
     1166           .
     1167         end.
     1168         assign
     1169           o-where = substitute( "&1 &2", o-where, v-field-val )
     1170         .
     1171         if v-word-link = "":U then do:
     1172           assign
     1173             v-word-link = "and":U
     1174           .
     1175         end.
     1176       end.
     1177       delete object bh_tbl-name.
     1178       if     bh_tbl-key ne ?
     1179       then
     1180          delete object bh_tbl-key.
     1181       if p-key-handle = ?
     1182         and v-count-fld <> v-field-num
     1183       then do:
     1184         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info14, vTable ).
     1185       end.
     1186     end.
     1187   end procedure.
     1188   procedure gen-hn-keyr-tab :
     1189     define input  parameter i-tableSerach as character no-undo.
     1190     define input  parameter i-tablekey   as character no-undo.
     1191     define input  parameter p-key-rec    as character no-undo.
     1192     define input  parameter p-key-handle as handle    no-undo .
     1193     define input  parameter p-db-name    as character no-undo .
     1194     define input  parameter p-tt-handle  as handle    no-undo .
     1195     define input  parameter p-stts-lock  as integer   no-undo .
     1196     define output parameter o-hn         as handle    no-undo.
     1197     define variable v-full-tbl-name as character no-undo.
     1198     define variable v-where         as character no-undo.
     1199     define variable bh_tbl-name     as handle    no-undo.
     1200     define variable vTable          as character no-undo.
     1201     do
     1202     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1203     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1204     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1205         run gen-where-keyr-tab(i-tableSerach,
     1206                                i-tablekey,
     1207                                p-key-rec,
     1208                                p-key-handle,
     1209                                p-db-name,
     1210                                p-tt-handle,
     1211                                output v-where).
     1212         if i-tableSerach ne "" and i-tableSerach ne ?
     1213         then do:
     1214            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1215            create buffer bh_tbl-name for table v-full-tbl-name .
     1216         end.
     1217         else do:
     1218            if p-tt-handle = ? then do:
     1219               assign
     1220                  vTable = entry( 1 , p-key-rec, chr(3) )
     1221               .
     1222               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1223               create buffer bh_tbl-name for table v-full-tbl-name .
     1224            end.
     1225            else do:
     1226               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1227            end.
     1228         end.
     1229         if p-tt-handle = ? then do:
     1230            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1231         end.
     1232         else do:
     1233            bh_tbl-name:find-first( v-where ) no-error .
     1234         end.
     1235         o-hn = bh_tbl-name.
     1236      end.
     1237   end procedure.
     1238   procedure gen-hn-keyr :
     1239     define input  parameter p-key-rec    as character no-undo.
     1240     define input  parameter p-key-handle as handle    no-undo .
     1241     define input  parameter p-db-name    as character no-undo .
     1242     define input  parameter p-tt-handle  as handle    no-undo .
     1243     define input  parameter p-stts-lock  as integer   no-undo .
     1244     define output parameter o-hn         as handle    no-undo.
     1245     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1246   end.
     1247   procedure gen-row-keyr :
     1248     define input  parameter p-key-rec    as character no-undo.
     1249     define input  parameter p-key-handle as handle    no-undo .
     1250     define input  parameter p-db-name    as character no-undo .
     1251     define input  parameter p-tt-handle  as handle    no-undo .
     1252     define input  parameter p-stts-lock  as integer   no-undo .
     1253     define output parameter p-tbl-row    as rowid     no-undo.
     1254     define output parameter p-tbl-name   as character no-undo.
     1255     define variable vHn as handle no-undo.
     1256       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1257       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1258       p-tbl-name =  vHn:table.
     1259       delete object vHn no-error.
     1260     if p-tbl-row = ? then do:
     1261       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info14, p-tbl-name, p-key-rec ).
     1262     end.
     1263     else do:
     1264       return.
     1265     end.
     1266   end procedure.
     1267   procedure gen-key-fv :
     1268     define input  parameter p-key-rec    as character no-undo .
     1269     define output parameter p-field-list as character no-undo .
     1270     define output parameter p-value-list as character no-undo.
     1271     do
     1272     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1273     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1274     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1275     :
     1276       define variable v-full-tbl-name  as character no-undo .
     1277       define variable bh_tbl-name      as handle    no-undo .
     1278       define variable v-tbl-name       as character no-undo .
     1279       define variable v-field-num      as integer   no-undo .
     1280       define variable v-count-fld      as integer   no-undo .
     1281       define variable v-inform         as character no-undo .
     1282       define variable v-ind            as integer   no-undo .
     1283       define variable v-idx-field-qnty as integer   no-undo .
     1284       define variable v-delim-key      as character no-undo .
     1285       if p-key-rec = ?
     1286         or p-key-rec = "":U
     1287       then do:
     1288         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info14 ).
     1289       end.
     1290       assign
     1291         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1292         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1293       .
     1294       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1295       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info14 ).
     1296       assign
     1297         v-inform = bh_tbl-name:index-information(1)
     1298         v-ind    = 2
     1299       .
     1300       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1301       on error undo, return error
     1302       :
     1303         assign
     1304           v-inform = bh_tbl-name:index-information( v-ind )
     1305           v-ind    = v-ind + 1
     1306         .
     1307       end.
     1308       if v-inform = ?
     1309         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1310         or entry( 3, v-inform, ",":U ) <> "1":U
     1311       then do:
     1312         delete object bh_tbl-name no-error.
     1313         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1314       end.
     1315       assign
     1316         v-idx-field-qnty = num-entries( v-inform ) - 4
     1317       .
     1318       if v-idx-field-qnty < 2 then do:
     1319         delete object bh_tbl-name no-error.
     1320         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1321       end.
     1322       assign
     1323         p-field-list = "":U
     1324         p-value-list = "":U
     1325         v-delim-key  = "":U
     1326         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1327         v-count-fld  = 0
     1328       .
     1329       block_where:
     1330       do v-ind = 1 to v-idx-field-qnty by 2
     1331       on error undo, return error
     1332       :
     1333         assign
     1334           v-count-fld = v-count-fld + 1
     1335         .
     1336         if v-count-fld > v-field-num then do:
     1337           leave block_where.
     1338         end.
     1339         assign
     1340           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1341           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1342         .
     1343         if v-ind = 1 then do:
     1344           assign
     1345             v-delim-key = chr(3)
     1346           .
     1347         end.
     1348       end.
     1349       delete object bh_tbl-name.
     1350       if v-count-fld <> v-field-num then do:
     1351         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info14, v-tbl-name ).
     1352       end.
     1353     end.
     1354   end procedure.
     1355   procedure gen-key-field :
     1356     define input  parameter p-table      as character no-undo .
     1357     define output parameter p-field-list as character no-undo .
     1358     do
     1359     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1360     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1361     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1362     :
     1363       define variable v-full-tbl-name  as character no-undo .
     1364       define variable bh_tbl-name      as handle    no-undo .
     1365       define variable v-tbl-name       as character no-undo .
     1366       define variable v-field-num      as integer   no-undo .
     1367       define variable v-count-fld      as integer   no-undo .
     1368       define variable v-inform         as character no-undo .
     1369       define variable v-ind            as integer   no-undo .
     1370       define variable v-idx-field-qnty as integer   no-undo .
     1371       define variable v-delim-key      as character no-undo .
     1372       if p-table = ?
     1373         or p-table = "":U
     1374       then do:
     1375         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info14 ).
     1376       end.
     1377       assign
     1378         v-tbl-name      = p-table
     1379         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1380       .
     1381       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1382       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info14 ).
     1383       assign
     1384         v-inform = bh_tbl-name:index-information(1)
     1385         v-ind    = 2
     1386       .
     1387       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1388       on error undo, return error
     1389       :
     1390         assign
     1391           v-inform = bh_tbl-name:index-information( v-ind )
     1392           v-ind    = v-ind + 1
     1393         .
     1394       end.
     1395       if v-inform = ?
     1396         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1397         or entry( 3, v-inform, ",":U ) <> "1":U
     1398       then do:
     1399         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info14, v-tbl-name ).
     1400       end.
     1401       assign
     1402         v-idx-field-qnty = num-entries( v-inform ) - 4
     1403       .
     1404       if v-idx-field-qnty < 2 then do:
     1405         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info14, v-inform, v-tbl-name ).
     1406       end.
     1407       assign
     1408         p-field-list = "":U
     1409         v-delim-key  = "":U
     1410         v-count-fld  = 0
     1411       .
     1412       block_where:
     1413       do v-ind = 1 to v-idx-field-qnty by 2
     1414       on error undo, return error
     1415       :
     1416         assign
     1417           v-count-fld = v-count-fld + 1
     1418         .
     1419         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1420         if v-ind = 1 then do:
     1421           assign
     1422             v-delim-key = chr(3)
     1423           .
     1424         end.
     1425       end.
     1426       delete object bh_tbl-name.
     1427     end.
     1428   end procedure.
     1429   define variable v-profile-id as integer no-undo .
     1430   define variable v-output-type as character no-undo .
     1431   CREATE WIDGET-POOL.
     1432   define variable v-nn as integer   no-undo .
     1433   define variable State-source as  WIDGET-HANDLE.
     1434   define variable g#log as logical   no-undo .
     1435   define variable v-curr-r-b               as character no-undo .
     1436   define variable v-print-rubl             as logical   no-undo .
     1437   define variable p-customer as integer .
     1438   define variable v-res as character .
     1439   define variable ii as integer no-undo .
     1440   DEFINE VARIABLE v-detobj AS logical NO-UNDO.
     1441   define variable f-cashbook_id as character no-undo .
     1442   DEFINE VARIABLE v-printform AS integer NO-UNDO.
     1443   define temp-table tt-cashbook
     1444   field id as integer
     1445   field name as character
     1446   .
     1447   DEFINE BUTTON B-cashbook
     1448        IMAGE-UP FILE "btn-down-arrow":U
     1449        IMAGE-DOWN FILE "btn-down-arrow":U
     1450        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1451        LABEL ""
     1452        SIZE 3 BY 1
     1453        FGCOLOR 4 .
     1454   DEFINE VARIABLE f-cashbook AS CHARACTER FORMAT "X(256)":U
     1455        VIEW-AS FILL-IN
     1456        SIZE 40 BY 1 NO-UNDO.
     1457   DEFINE VARIABLE l-cashbook AS CHARACTER FORMAT "X(256)":U INITIAL "Кассовая книга:"
     1458         VIEW-AS TEXT
     1459        SIZE 15 BY .67 NO-UNDO.
     1460   DEFINE RECTANGLE RECT-13
     1461        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1462        SIZE 69 BY 3.71.
     1463   DEFINE VARIABLE p-titul AS LOGICAL INITIAL no
     1464        LABEL "Печать титульного листа"
     1465        VIEW-AS TOGGLE-BOX
     1466        SIZE 40 BY .83 NO-UNDO.
     1467   DEFINE FRAME F-Main
     1468        f-cashbook AT ROW 2 COL 21.5 COLON-ALIGNED NO-LABEL WIDGET-ID 34
     1469        B-cashbook AT ROW 2 COL 65.5 WIDGET-ID 32
     1470        p-titul AT ROW 3.42 COL 23.5 WIDGET-ID 38
     1471        l-cashbook AT ROW 2.33 COL 5.5 NO-LABEL WIDGET-ID 36
     1472        RECT-13 AT ROW 1.29 COL 2 WIDGET-ID 18
     1473       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1474            SIDE-LABELS NO-UNDERLINE THREE-D
     1475            AT COL 1 ROW 1 SCROLLABLE .
     1476   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1477   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1478   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1479   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1480   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1481   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1482   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1483   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1484         adm-object-hdl = FRAME F-Main:HANDLE.
     1485   RUN ensure-broker.
     1486   THIS-PROCEDURE:ADM-DATA =
     1487        'ADM1.1~`':U +
     1488        'SmartObject~`':U +
     1489        '~`':U +
     1490        'NO ~`':U +
     1491        '~`':U +
     1492        '~`':U +
     1493        '~`':U +
     1494        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1495           + "~`":U +
     1496        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1497        'Record-Source,Record-Target,TableIO-Target~`':U +
     1498        '~`':U +
     1499        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1500        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1501            THEN "^^":U
     1502        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1503             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1504   PROCEDURE adm-apply-entry :
     1505     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1506   END PROCEDURE.
     1507   PROCEDURE adm-destroy :
     1508    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1509   END PROCEDURE.
     1510   PROCEDURE adm-disable :
     1511       DISABLE RECT-13 f-cashbook B-cashbook p-titul l-cashbook WITH FRAME F-Main.
     1512       RUN dispatch ('disable-fields':U).
     1513       RUN set-attribute-list ('ENABLED=no':U).
     1514       RETURN.
     1515   END PROCEDURE.
     1516   PROCEDURE adm-edit-attribute-list :
     1517         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1518         RETURN.
     1519   END PROCEDURE.
     1520   PROCEDURE adm-enable :
     1521       ENABLE UNLESS-HIDDEN RECT-13 f-cashbook B-cashbook p-titul l-cashbook WITH FRAME F-Main.
     1522       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1523       RUN set-attribute-list ('ENABLED=yes':U).
     1524       RETURN.
     1525   END PROCEDURE.
     1526   PROCEDURE adm-exit :
     1527        RUN notify ('exit':U).
     1528     RETURN.
     1529   END PROCEDURE.
     1530   PROCEDURE adm-hide :
     1531     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1532   END PROCEDURE.
     1533   PROCEDURE adm-initialize :
     1534     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1535   END PROCEDURE.
     1536   PROCEDURE adm-show-errors :
     1537       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1538       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1539           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1540       END.
     1541       RETURN.
     1542   END PROCEDURE.
     1543   PROCEDURE adm-UIB-mode :
     1544     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1545   END PROCEDURE.
     1546   PROCEDURE adm-view :
     1547     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1548   END PROCEDURE.
     1549   PROCEDURE dispatch :
     1550       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1551       RUN broker-dispatch IN adm-broker-hdl
     1552           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1553       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1554   END PROCEDURE.
     1555   PROCEDURE ensure-broker :
     1556   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1557   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1558   DO:
     1559       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1560       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1561   END.
     1562   END PROCEDURE.
     1563   PROCEDURE get-attribute :
     1564     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1565     RUN broker-get-attribute IN adm-broker-hdl
     1566         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1567     RETURN RETURN-VALUE.
     1568   END PROCEDURE.
     1569   PROCEDURE get-attribute-list :
     1570     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1571     RUN broker-get-attribute-list IN adm-broker-hdl
     1572         (INPUT THIS-PROCEDURE,
     1573          INPUT ?,
     1574          OUTPUT p-attr-list) NO-ERROR.
     1575     RETURN.
     1576   END PROCEDURE.
     1577   PROCEDURE new-state :
     1578     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1579     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1580     RETURN.
     1581   END PROCEDURE.
     1582   PROCEDURE notify :
     1583     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1584     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1585     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1586         RETURN "ADM-ERROR":U.
     1587     RETURN.
     1588   END PROCEDURE.
     1589   PROCEDURE set-attribute-list :
     1590     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1591     RUN ensure-broker.
     1592     RUN broker-set-attribute-list IN adm-broker-hdl
     1593         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1594     RETURN.
     1595   END PROCEDURE.
     1596   PROCEDURE set-position :
     1597       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1598       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1599       IF VALID-HANDLE(adm-object-hdl) THEN
     1600       DO:
     1601         ASSIGN adm-object-hdl:ROW    =   p-row
     1602                adm-object-hdl:COLUMN =   p-col.
     1603       END.
     1604       RETURN.
     1605   END PROCEDURE.
     1606   PROCEDURE adm-display-fields :
     1607       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1608       RETURN.
     1609   END PROCEDURE.
     1610   PROCEDURE adm-open-query :
     1611     RETURN.
     1612   END PROCEDURE.
     1613   PROCEDURE adm-row-changed :
     1614         IF VALID-HANDLE(adm-object-hdl) THEN
     1615           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1616         RUN notify ('row-available':U).
     1617         RETURN.
     1618   END PROCEDURE.
     1619   PROCEDURE reposition-query :
     1620       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1621       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1622       RETURN.
     1623   END PROCEDURE.
     1624     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1625     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1626     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1627     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1628     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1629     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1630     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1631     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1632     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1633     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1634     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1635     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1636     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1637     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1638     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1639     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1640     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1641     IF "":U = "":U THEN
     1642       RUN modify-list-attribute IN adm-broker-hdl
     1643         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1644     RUN use-create-on-add(?).
     1645   PROCEDURE adm-add-record :
     1646       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1647          "must have at least one Enabled Table to perform Add.":U
     1648          VIEW-AS ALERT-BOX ERROR.
     1649       RETURN.
     1650   END PROCEDURE.
     1651   PROCEDURE adm-assign-record :
     1652    MESSAGE
     1653          "Object ":U THIS-PROCEDURE:FILE-NAME
     1654            "must have at least one Enabled Table to perform Assign.":U
     1655              VIEW-AS ALERT-BOX ERROR.
     1656      RETURN.
     1657     END PROCEDURE.
     1658   PROCEDURE adm-assign-statement :
     1659     RETURN.
     1660   END PROCEDURE.
     1661   PROCEDURE adm-cancel-record :
     1662      RETURN.
     1663     END PROCEDURE.
     1664   PROCEDURE adm-copy-record :
     1665       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1666        "must have at least one Enabled Table to perform Copy.":U
     1667          VIEW-AS ALERT-BOX ERROR.
     1668       RETURN.
     1669   END PROCEDURE.
     1670   PROCEDURE adm-create-record :
     1671      RETURN.
     1672   END PROCEDURE.
     1673   PROCEDURE adm-current-changed :
     1674     RETURN.
     1675   END PROCEDURE.
     1676   PROCEDURE adm-delete-record :
     1677    MESSAGE
     1678          "Object ":U THIS-PROCEDURE:FILE-NAME
     1679            "must have at least one Enabled Table to perform Delete.":U
     1680              VIEW-AS ALERT-BOX ERROR.
     1681       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1682       RETURN.
     1683   END PROCEDURE.
     1684   PROCEDURE adm-disable-fields :
     1685         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1686       RETURN.
     1687   END PROCEDURE.
     1688   PROCEDURE adm-enable-fields :
     1689       RETURN.
     1690   END PROCEDURE.
     1691   PROCEDURE adm-end-update :
     1692     RETURN.
     1693   END PROCEDURE.
     1694   PROCEDURE adm-reset-record :
     1695       RETURN.
     1696   END PROCEDURE.
     1697   PROCEDURE adm-update-record :
     1698       MESSAGE
     1699         "Object ":U THIS-PROCEDURE:FILE-NAME
     1700           "must have at least one Enabled Table to perform Update.":U
     1701             VIEW-AS ALERT-BOX ERROR.
     1702      RETURN.
     1703   END PROCEDURE.
     1704   PROCEDURE check-modified :
     1705   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1706   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1707   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1708   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1709     IF check-state = "check":U THEN
     1710     DO:
     1711       RUN get-link-handle IN adm-broker-hdl
     1712         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1713            OUTPUT group-target-list).
     1714       IF group-target-list NE "":U THEN
     1715       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1716         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1717         RUN check-modified IN curr-widget ('group-check':U).
     1718         IF RETURN-VALUE NE "":U THEN
     1719         DO:
     1720           RUN check-modified-message(RETURN-VALUE).
     1721           RETURN "":U.
     1722         END.
     1723       END.
     1724     END.
     1725     RETURN "":U.
     1726   END PROCEDURE.
     1727   PROCEDURE check-modified-message :
     1728     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1729        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1730           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1731        IF RETURN-VALUE = "YES":U THEN
     1732           RUN notify ('view,CONTAINER-SOURCE':U).
     1733        MESSAGE IF p-changed-table NE ? THEN
     1734           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1735           ELSE "Current values have been changed."
     1736           SKIP "  Do you wish to save those changes?"
     1737           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1738        IF ANS THEN
     1739        DO:
     1740           IF group-assign-target THEN
     1741             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1742           ELSE RUN dispatch('update-record':U).
     1743           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1744           DO:
     1745               MESSAGE "Changes to the previous record were not saved."
     1746                 VIEW-AS ALERT-BOX ERROR.
     1747               IF group-assign-target THEN
     1748                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1749               ELSE RUN dispatch ('cancel-record':U).
     1750           END.
     1751        END.
     1752        ELSE DO:
     1753          IF group-assign-target THEN
     1754             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1755          ELSE RUN dispatch('cancel-record':U).
     1756        END.
     1757        RETURN.
     1758   END PROCEDURE.
     1759   PROCEDURE get-rowid :
     1760       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1761       ASSIGN
     1762       p-table   =   adm-first-table.
     1763       RETURN.
     1764   END PROCEDURE.
     1765   PROCEDURE init-group-assign :
     1766       RUN request-attribute IN adm-broker-hdl
     1767         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1768       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1769         group-assign-target = yes.
     1770       ELSE group-assign-target = no.
     1771       RETURN.
     1772   END PROCEDURE.
     1773   PROCEDURE set-editors :
     1774       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1775       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1776       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1777       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1778       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1779       DO WHILE VALID-HANDLE (curr-widget):
     1780           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1781              curr-widget:HIDDEN = no THEN DO:
     1782             CASE p-field-setting:
     1783               WHEN "INITIALIZE":U THEN
     1784               DO:
     1785                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1786                     read-only-list +
     1787                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1788                        STRING(curr-widget).
     1789               END.
     1790               WHEN "DISABLE":U OR
     1791               WHEN "ENABLE":U THEN
     1792               DO:
     1793                   curr-widget:SENSITIVE = yes.
     1794                   RUN get-attribute ('Read-Only-Editors':U).
     1795                   IF RETURN-VALUE = ? OR
     1796                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1797                       curr-widget:READ-ONLY =
     1798                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1799               END.
     1800               WHEN "CLEAR":U THEN
     1801                   curr-widget:SCREEN-VALUE = "":U.
     1802             END CASE.
     1803           END.
     1804           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1805       END.
     1806       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1807         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1808           + '"':U).
     1809       RETURN.
     1810   END PROCEDURE.
     1811   PROCEDURE use-check-modified-all :
     1812    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1813     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1814     RETURN.
     1815   END PROCEDURE.
     1816   PROCEDURE use-create-on-add :
     1817   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1818      RETURN.
     1819   END PROCEDURE.
     1820   PROCEDURE use-initial-lock :
     1821     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1822     ASSIGN adm-initial-lock = p-attr-value.
     1823     RETURN.
     1824   END PROCEDURE.
     1825     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1826   ASSIGN
     1827          FRAME F-Main:SCROLLABLE       = FALSE
     1828          FRAME F-Main:HIDDEN           = TRUE
     1829          FRAME F-Main:PRIVATE-DATA     =
     1830                   "DLGCLOSE".
     1831   ON CHOOSE OF B-cashbook IN FRAME F-Main
     1832   DO:
     1833     define variable v-cb-brw as class ibs.th.ref.cashbookbrw no-undo .
     1834     define variable ii  as integer no-undo .
     1835     parParentProc = my-handle .
     1836     v-cb-brw = new ibs.th.ref.cashbookbrw ( "multiselect", parParentProc ).
     1837     wait-for  v-cb-brw:ShowDialog() .
     1838     if v-cb-brw:out-list-id > ""
     1839     then do :
     1840       do ii = 1 to num-entries (v-cb-brw:out-list-id, chr(6)):
     1841       find first ub.cashbook no-lock where ub.cashbook.id = int64(entry(ii,v-cb-brw:out-list-id,chr(6))) no-error.
     1842       if ii = 1 then
     1843       assign
     1844       f-cashbook = ub.CashBook.CashBookName
     1845       f-cashbook_id = string(ub.CashBook.id)
     1846       .
     1847       else
     1848       assign
     1849       f-cashbook = f-cashbook + chr(6) + ub.CashBook.CashBookName
     1850       f-cashbook_id = f-cashbook_id + chr(6) + string(ub.CashBook.id)
     1851       .
     1852     end.
     1853       display
     1854       f-cashbook
     1855       with frame F-Main .
     1856     end.
     1857   END.
     1858   ON VALUE-CHANGED OF p-titul IN FRAME F-Main
     1859   DO:
     1860     assign p-titul .
     1861   END.
     1862   if not this-procedure :persistent
     1863   then do:
     1864     message
     1865       vss-workfile vss-revision vss-description skip
     1866       "Ошибка при запуске процедуры" skip
     1867       "Данную процедуру следует запускать только с параметром persistent" skip
     1868       view-as alert-box error .
     1869     undo, return error .
     1870   end.
     1871    run Enable_UI .
     1872   PROCEDURE disable_UI :
     1873     HIDE FRAME F-Main.
     1874     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1875   END PROCEDURE.
     1876   PROCEDURE Enable_UI :
     1877       display
     1878       l-cashbook
     1879       with frame F-Main .
     1880   END PROCEDURE.
     1881   PROCEDURE my-report :
     1882   run rep/r-cashbk.p
     1883       (
     1884        input my-handle
     1885       ,input this-procedure:handle
     1886       ,input this-procedure:handle
     1887       ,input this-procedure:handle
     1888       ,input this-procedure:handle
     1889       ,input ?
     1890       ,input ?
     1891       ,input ''
     1892       ,input ''
     1893       ,input integer('0':U)
     1894       ,input 0
     1895       ,input 0
     1896       ,input f-cashbook_id
     1897       ,input yes
     1898       ,input yes
     1899       ,input ''
     1900       ,input p-titul
     1901        ) .
     1902   END PROCEDURE.
     1903   PROCEDURE my-var :
     1904   assign frame F-Main f-cashbook
     1905   .
     1906     assign
     1907       ReportHeader = "Кассовые книги"
     1908     .
     1909   END PROCEDURE.
     1910   PROCEDURE write-to-log :
     1911   define input param p-str as char no-undo.
     1912   do
     1913   on error undo, return error
     1914   :
     1915      message
     1916         p-str
     1917         skip
     1918      view-as alert-box error.
     1919   end.
     1920   END PROCEDURE.
