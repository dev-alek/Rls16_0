        1   block-level on error undo, throw.
        2   define input  parameter iKey     as integer no-undo.
        3   define output parameter oChekSum as character no-undo.
        4   if userid("ub") eq ""
        5   then do:
        6      oChekSum = encode(string(iKey * 13)) + string(index(encode(string(iKey)), "k"))
        7    .
        8      return.
        9   end.
       10   define variable vss-revision    as character no-undo init "$Revision:$":U .
       11   define variable vss-author      as character no-undo init "$Author:$":U .
       12   define variable vss-date        as character no-undo init "$Date:$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       14   define variable vss-archive     as character no-undo init "$Archive:$":U .
       15   define variable vss-description as character no-undo init "".
       16   define variable v-curr-r-b as character no-undo .
       17   define variable v-base-code like ub.sysconf.base-code no-undo .
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define variable logFile  as character no-undo.
       77   define buffer buf_clob-bind for ub.clob-bind.
       78   define stream logOutput.
       79   logFile = "si_pokmi.log".
       80   define variable v-param     as decimal no-undo.
       81   define variable v-delta-min as decimal   no-undo.
       82   define variable v-delta     as decimal   no-undo.
       83   define buffer sr-izmerenia for ub.sr-izmerenia.
       84   for each sr-izmerenia no-lock break by sr-izmerenia.node-code:
       85     if first(sr-izmerenia.node-code) then
       86       output stream logOutput to value(logFile).
       87     put stream logOutput unformatted
       88       substitute("Код СИ: &1; Модель: &2",
       89                sr-izmerenia.node-code,
       90                sr-izmerenia.sr-model)
       91       skip
       92     .
       93     v-delta-min = 0.
       94     if sr-izmerenia.sr-level then
       95     do:
       96       case sr-izmerenia.sr-type-izm:
       97         when 1 then assign v-delta-min = 0.01 v-delta = 3.
       98         when 2 then assign v-delta-min = 0.01 v-delta = 3.
       99         when 3 then assign v-delta-min = 0.01 v-delta = ?.
      100       end case.
      101       v-param = sr-izmerenia.sr-abs-err-neft-water.
      102       if abs(v-param) < v-delta-min or v-param > v-delta or v-param < (-1) * v-delta then
      103         put stream logOutput unformatted
      104           substitute("  Значение ~"Абс. погрешность измерений ур. нефтепродукта и подтоварной воды~" &1 выходит за границы допустимого диапазона  &2...&3",
      105                      right-trim(right-trim(string(v-param,"9.999"),"0"),"."),
      106                      right-trim(right-trim(string(v-delta-min,"9.99"),"0"),"."),
      107                      if v-delta = ? then "-" else right-trim(right-trim(string(v-delta,"9.999"),"0"),"."))
      108           skip
      109         .
      110       v-delta-min = 0.
      111       v-param = sr-izmerenia.sr-abs-err-water.
      112       if v-param > v-delta or v-param < (-1) * v-delta then
      113         put stream logOutput unformatted
      114           substitute("  Значение ~"Абс. погрешность измерений ур. подтоварной воды~" &1 выходит за границы допустимого диапазона  &2...&3",
      115                      right-trim(right-trim(string(v-param,"9.999"),"0"),"."),
      116                      right-trim(right-trim(string(v-delta-min,"9.99"),"0"),"."),
      117                      if v-delta = ? then "-" else right-trim(right-trim(string(v-delta,"9.999"),"0"),"."))
      118           skip
      119         .
      120     end.
      121     if sr-izmerenia.sr-temperature then
      122     do:
      123       case sr-izmerenia.sr-type-izm:
      124         when 1 then v-delta = 0.5.
      125         when 2 then v-delta = 0.5.
      126         when 3 then v-delta = 0.2.
      127       end case.
      128       v-param = sr-izmerenia.sr-abs-err-temp-vol.
      129       if v-param > v-delta or v-param < (-1) * v-delta then
      130         put stream logOutput unformatted
      131           substitute("  Значение ~"Абс. погрешность из. температуры (объем)~" &1 выходит за границы допустимого диапазона  &2...&3",
      132                      right-trim(right-trim(string(v-param,"9.999"),"0"),"."),
      133                      right-trim(right-trim(string(v-delta-min,"9.99"),"0"),"."),
      134                      if v-delta = ? then "-" else right-trim(right-trim(string(v-delta,"9.999"),"0"),"."))
      135           skip
      136         .
      137       v-param = sr-izmerenia.sr-abs-err-temp-dens.
      138       if v-param > v-delta or v-param < (-1) * v-delta then
      139         put stream logOutput unformatted
      140           substitute("  Значение ~"Абс. погрешность из. температуры (плотность)~" &1 выходит за границы допустимого диапазона  &2...&3",
      141                      right-trim(right-trim(string(v-param,"9.999"),"0"),"."),
      142                      right-trim(right-trim(string(v-delta-min,"9.99"),"0"),"."),
      143                      if v-delta = ? then "-" else right-trim(right-trim(string(v-delta,"9.999"),"0"),"."))
      144           skip
      145         .
      146     end.
      147     if sr-izmerenia.sr-density then
      148     do:
      149       case sr-izmerenia.sr-type-izm:
      150         when 1 then v-delta = 1.
      151         when 2 then v-delta = 0.5.
      152         when 3 then v-delta = 0.5.
      153       end case.
      154       v-param = sr-izmerenia.sr-abs-err-dens.
      155       if v-param > v-delta or v-param < (-1) * v-delta then
      156         put stream logOutput unformatted
      157           substitute("  Значение ~"Абсолютная погрешность измерений плотности~" &1 выходит за границы допустимого диапазона  &2...&3",
      158                      right-trim(right-trim(string(v-param,"9.999"),"0"),"."),
      159                      right-trim(right-trim(string(v-delta-min,"9.99"),"0"),"."),
      160                      if v-delta = ? then "-" else right-trim(right-trim(string(v-delta,"9.999"),"0"),"."))
      161           skip
      162         .
      163       v-delta = 1.5.
      164       v-param = sr-izmerenia.sr-abs-err-dens-lgas-liquid.
      165       if v-param > v-delta or v-param < (-1) * v-delta then
      166         put stream logOutput unformatted
      167           substitute("  Значение ~"Абсолютная погрешность измерений плотности ЖФ~" &1 выходит за границы допустимого диапазона  &2...&3",
      168                      right-trim(right-trim(string(v-param,"9.999"),"0"),"."),
      169                      right-trim(right-trim(string(v-delta-min,"9.99"),"0"),"."),
      170                      if v-delta = ? then "-" else right-trim(right-trim(string(v-delta,"9.999"),"0"),"."))
      171           skip
      172         .
      173       v-param = sr-izmerenia.sr-abs-err-dens-lgas-vapor.
      174       if v-param > v-delta or v-param < (-1) * v-delta then
      175         put stream logOutput unformatted
      176           substitute("  Значение ~"Абсолютная погрешность измерений плотности ПГФ~" &1 выходит за границы допустимого диапазона  &2...&3",
      177                      right-trim(right-trim(string(v-param,"9.999"),"0"),"."),
      178                      right-trim(right-trim(string(v-delta-min,"9.99"),"0"),"."),
      179                      if v-delta = ? then "-" else right-trim(right-trim(string(v-delta,"9.999"),"0"),"."))
      180           skip
      181         .
      182     end.
      183     if last(sr-izmerenia.node-code) then
      184       output stream logOutput close.
      185   end.
      186   message "Отчет сформирован в" search(logFile) "."
      187      view-as alert-box.
