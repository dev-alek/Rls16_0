     1505           '</TR>' skip
     1506           '<TR>' skip
     1507           '<TD colspan="6" style="font-weight: bold;">Дата: ' + string (v-today,"99.99.9999") + '</TD>' skip
     1508           '</TR>'skip
     1509           '<TR>' skip
     1510           '<TD colspan="6" style="font-weight: bold;">Время: ' + get-time(v-time) + '</TD>' skip
     1511           '</TR>'skip
     1512           '<TR>' skip
     1513           '<TD colspan="6" style="font-weight: bold;">Фильтры: с ' + string (date_from,"99.99.9999") + " по " + string(date_to,"99.99.9999") + '</TD>' skip
     1514           '</TR>'skip
     1515           '<TR>' skip
     1516           '<TD colspan="6" style="font-weight: bold;">Дата актуальности информации о БД и RC: ' + get-time(v-time) + '</TD>' skip
     1517           '</TR>'skip
     1518           .
     1519         put stream OutStr-html unformatted
     1520           '</thead>' skip
     1521           '<tbody>' skip
     1522           .
