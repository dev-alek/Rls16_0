     1487           '</tr>' skip
     1488           .
     1489       end.
     1490       else
     1491       do:
     1492         put stream OutStr-html unformatted
     1493           '<tr>' skip
     1494           '<td style="width: 40px;"></td>' skip
     1495           '<td style="width: 100px;"></td>' skip
     1496           '<td style="width: 60px;"></td>' skip
     1497           '<td style="width: 80px;"></td>' skip
     1498           '<td style="width: 120px;"></td>' skip
     1499           '<td style="width: 80px;"></td>' skip
