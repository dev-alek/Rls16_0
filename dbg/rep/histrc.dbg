     1390   RUN disable_UI.
     1391   PROCEDURE disable_UI :
     1392     HIDE FRAME Dialog-Frame.
     1393   END PROCEDURE.
     1394   PROCEDURE enable_UI :
     1395     DISPLAY date_from date_to
     1396       WITH FRAME Dialog-Frame.
     1397     ENABLE Btn_OK date_from date_to bt-set
     1398       WITH FRAME Dialog-Frame.
     1399     VIEW FRAME Dialog-Frame.
     1400   END PROCEDURE.
     1401   PROCEDURE get-report-num :
     1402     define output parameter p-report-num as integer no-undo .
     1403     do
     1404       on error undo, return error return-value
     1405       :
     1406       run gbl/getrpnum.p (output p-report-num).
     1407     end.
     1408   END PROCEDURE.
     1409   PROCEDURE print_RC :
     1410     do
     1411       on error undo, return error
     1412       :
     1413       run get-report-num in parParentProc (
     1414         output p-report-id
     1415         ).
     1416       v-report-name-html = session:temp-directory + string(p-report-id) + ".html".
     1417       run PROC-print-RC in this-procedure.
     1418     end.
     1419   END PROCEDURE.
     1420   PROCEDURE proc-print-RC :
     1421     do
     1422       on error undo, return error
     1423       :
     1424       ii = 0 .
     1425       output stream OutStr-html to value(v-report-name-html) convert target 'UTF-8' .
     1426       put stream OutStr-html unformatted
     1427         "<!DOCTYPE HTML>" skip
     1428         ' <html>' skip
     1429         '  <head>' skip
     1430         '   <meta charset="utf-8">' skip
     1431         '    <style type="text/css">' skip
     1432         '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1433         '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1434         '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1435         '   </style>' skip
     1436         '  </head>' skip
     1437         .
     1438       put stream OutStr-html unformatted
     1439         '<body>' skip
     1440         '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1441         '<thead>' skip
     1442         .
     1443       if v-cntxt-db-num = 0 then
     1444       do:
     1445         put stream OutStr-html unformatted
     1446           '<tr>' skip
     1447           '<td style="width: 40px;"></td>' skip
     1448           '<td style="width: 60px;"></td>' skip
     1449           '<td style="width: 60px;"></td>' skip
     1450           '<td style="width: 80px;"></td>' skip
     1451           '<td style="width: 120px;"></td>' skip
     1452           '<td style="width: 80px;"></td>' skip
     1453           '<td style="width: 120px;"></td>' skip
     1454           '</tr>' skip
     1455           .
     1456         put stream OutStr-html unformatted
     1457           '<TR>' skip
     1458           '<TD colspan="7" style="font-weight: bold;">Историческая справка по версиям RC на ГБД</TD>' skip
     1459           '</TR>' skip
     1460           '<TR>' skip
     1461           '<TD colspan="7" style="font-weight: bold;">Дата: ' + string (v-today,"99.99.9999") + '</TD>' skip
     1462           '</TR>'skip
     1463           '<TR>' skip
     1464           '<TD colspan="7" style="font-weight: bold;">Время: ' + get-time(v-time) + '</TD>' skip
     1465           '</TR>'skip
     1466           '<TR>' skip
     1467           '<TD colspan="7" style="font-weight: bold;">Фильтры: с ' + string (date_from,"99.99.9999") + " по " + string(date_to,"99.99.9999") + '</TD>' skip
     1468           '</TR>'skip
     1469           '<TR>' skip
     1470           '<TD colspan="7" style="font-weight: bold;">Дата актуальности информации о БД и RC: ' + get-time(v-time) + '</TD>' skip
     1471           '</TR>'skip
     1472           .
     1473         put stream OutStr-html unformatted
     1474           '</thead>' skip
     1475           '<tbody>' skip
     1476           .
     1477         put stream OutStr-html unformatted
     1478           '<tr>' skip
     1479           '<th text_wrap="true" style="align: center;">№</th>' skip
     1480           '<th text_wrap="true" style="align: center;">Номер БД</th>' skip
     1481           '<th text_wrap="true" style="align: center;">Название БД</th>' skip
     1482           '<th text_wrap="true" style="align: center;">Индентификатор версии RC</th>' skip
     1483           '<th text_wrap="true" style="align: center;">Дата и время компиляции RC</th>' skip
     1484           '<th text_wrap="true" style="align: center;">Дата и время копирования индентификатора версии RC на ПК</th>' skip
     1485           '<th text_wrap="true" style="align: center;">Дата и время записи данных о версии в БД</th>' skip
