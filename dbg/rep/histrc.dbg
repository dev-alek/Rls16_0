      639   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640   define  stream PrnLibStream.
      641   procedure prn-lib-prn-file :
      642     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      643     define input parameter p-DIsabledoptions as integer no-undo .
      644     define variable v-report-name as character no-undo .
      645     define variable v-user-action as character no-undo .
      646     define variable v-printed     as logical   no-undo .
      647     define variable v-exist       as logical   no-undo .
      648     do
      649       on error undo, return error
      650       :
      651       run prn-lib-get-report-name  in this-procedure (
      652         input parParentProc
      653         ,output v-report-name
      654         ).
      655   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      657     (input  v-report-name
      658     ,input  2
      659     ,output v-exist
      660     )  .
      661       if NOT v-exist then
      662       DO:
      663         Message
      664           "Нет заданий на печать ! "
      665           view-as alert-box .
      666         Return  .
      667       End.
      668       run gbl/prnfilen.w
      669         (input  ""
      670         ,input  p-DisabledOptions
      671         ,input  string(v-report-name )
      672         ,input  7
      673         ,output v-user-action
      674         ,output v-printed
      675         ) .
      676       if v-printed then
      677       do:
      678         return "YES" .
      679       end.
      680       else
      681       do:
      682         return "NO" .
      683       end.
      684     end.
      685   end procedure.
      686   procedure prn-lib-open-stream :
      687     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      688     define input parameter p-page-size    as integer no-undo .
      689     define input parameter p-is-stream    as logical no-undo .
      690     define input parameter p-append       as logical no-undo .
      691     define variable v-report-name as character no-undo .
      692     do
      693       on error undo, return error
      694       :
      695       run prn-lib-get-report-name  in this-procedure (
      696         input parParentProc
      697         ,output v-report-name
      698         ).
      699       if p-is-stream then
      700       do:
      701         if p-append then
      702         do:
      703           output stream PrnLibStream to value( v-report-name )
      704             page-size value(p-page-size) append .
      705         end.
      706         if not p-append then
      707         do:
      708           output stream PrnLibStream to value( v-report-name )
      709             page-size value(p-page-size) .
      710         end.
      711       end.
      712       if not p-is-stream then
      713       do:
      714         if p-append then
      715         do:
      716           output to value( v-report-name )
      717             page-size value(p-page-size) append .
      718         end.
      719         if not p-append then
      720         do:
      721           output to value( v-report-name )
      722             page-size value(p-page-size) .
      723         end.
      724       end.
      725     end.
      726   end procedure.
      727   procedure prn-lib-open-exp :
      728     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      729     define input parameter p-is-stream    as logical no-undo .
      730     define input parameter p-is-append    as logical no-undo .
      731     define output parameter p-ReportFileName as char init "report" no-undo.
      732     define output parameter p-process as logical no-undo .
      733     define variable glog as logical no-undo .
      734     do
      735       on error undo, return error
      736       :
      737       SYSTEM-DIALOG GET-FILE p-ReportFileName
      738         TITLE      "Укажите путь"
      739         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      740         ASK-OVERWRITE
      741         CREATE-TEST-FILE
      742         SAVE-AS
      743         USE-FILENAME
      744         DEFAULT-EXTENSION "txt"
      745         UPDATE glog
      746         .
      747       if not glog then  return.
      748       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      749       if p-is-stream then
      750       do:
      751         if p-is-append then
      752         do:
      753           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      754         end.
      755         else
      756         do:
      757           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      758         end.
      759       end.
      760       else
      761       do:
      762         if p-is-append then
      763         do:
      764           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      765         end.
      766         else
      767         do:
      768           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      769         end.
      770       end.
      771       p-process = yes.
      772     end.
      773   end procedure.
      774   procedure prn-lib-get-report-name :
      775     define input parameter parParentProc  as widget-handle no-undo.
      776     define output parameter p-report-name as character no-undo .
      777     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      778   end procedure.
      779   procedure prn-lib-reportviewer-report-name :
      780     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      781     define input parameter p-report-name-html as character no-undo .
      782     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      783   end procedure.
      784   procedure prn-lib-reportviewer :
      785     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      786     define input parameter p-report-name-html as character no-undo .
      787     define input parameter p-param        as character no-undo .
      788     define variable v-excel           as character no-undo init 'TRUE' .
      789     define variable v-value-character as character no-undo .
      790     define variable v-value-integer   as character no-undo .
      791     define variable v-value-date      as date      no-undo .
      792     define variable v-value-decimal   as decimal   no-undo .
      793     define variable rep-excel         as logical   no-undo .
      794     define variable excel-string      as character no-undo .
      795     define variable v-param-type      as character no-undo .
      796     define variable v-tth             as handle    no-undo .
      797     run adm/shattri.p (
      798       input "get":U
      799       ,input  ""
      800       ,input  0
      801       ,input  'report-glob':U
      802       ,input  'rep-excel':U
      803       ,output v-value-character
      804       ,output v-value-date
      805       ,output v-value-decimal
      806       ,output v-value-integer
      807       ,output rep-excel
      808       ,output v-param-type
      809       ,INPUT-OUTPUT table-handle v-tth
      810       )  .
      811     if rep-excel then v-excel = "TRUE" .
      812     else v-excel = "FALSE" .
      813     if p-param eq ""
      814     then
      815        p-param = "EXCEL:" + v-excel.
      816     else
      817        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      818     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      819   end procedure.
      820   define variable v-obj-list  as character no-undo.
