     1531           '</tr>' skip
     1532           .
     1533       end.
     1534       define variable v-date_from as character no-undo .
     1535       define variable v-date_to   as character no-undo .
     1536       if string(entry(3,string(date_from),"/")) >= "90" then v-date_from = "19" + string(entry(3,string(date_from),"/")) + "_" + string(entry(2,string(date_from),"/")) + "_" + string(entry(1,string(date_from),"/")) .
     1537       else v-date_from = "20" + string(entry(3,string(date_from),"/")) + "_" + string(entry(2,string(date_from),"/")) + "_" + string(entry(1,string(date_from),"/")) .
     1538       if string(entry(3,string(date_to),"/")) >= "90" then v-date_to = "19" + string(entry(3,string(date_to),"/")) + "_" + string(entry(2,string(date_to),"/")) + "_" + string(entry(1,string(date_to),"/")) .
     1539       else v-date_to = "20" + string(entry(3,string(date_to),"/")) + "_" + string(entry(2,string(date_to),"/")) + "_" + string(entry(1,string(date_to),"/")) .
     1540       if v-cntxt-db-num = 0 then
     1541       do:
     1542         if p-select-list = "" then
     1543         do:
     1544           for each ub.db no-lock:
     1545             if select-list = "" then select-list = string(ub.db.db-num) .
     1546             else select-list = select-list + chr(44) + string(ub.db.db-num) .
     1547           end.
     1548         end.
     1549         else
     1550         do:
     1551           do jj = 1 to num-entries (p-select-list,chr(44)):
     1552             for each ub.db no-lock where recid (ub.db) = integer(entry(jj,p-select-list)):
     1553               if select-list = "" then select-list = string(ub.db.db-num) .
     1554               else select-list = select-list + chr(44) + string(ub.db.db-num) .
     1555             end.
     1556           end.
     1557         end.
     1558       end.
     1559       else select-list = string(v-cntxt-db-num) .
     1560       empty temp-table tt-upgrade .
     1561       do jj = 1 to num-entries (select-list,chr(44)):
     1562         for last buf_db no-lock where buf_db.db-num = integer (entry(jj,select-list)):
     1563           next_:
     1564           for each buf_upgrade where buf_upgrade.db-num = buf_db.db-num and buf_upgrade.UpgDate >= date_from and buf_upgrade.UpgDate <= date_to:
     1565             find first tt-upgrade where tt-upgrade.db-num = buf_upgrade.db-num and tt-upgrade.version-num = buf_upgrade.version-num no-error .
     1566             if available (tt-upgrade) then leave Next_ .
     1567             create tt-upgrade .
     1568             buffer-copy buf_upgrade to tt-upgrade .
     1569             assign
     1570               tt-upgrade.db-name = buf_db.db-name
     1571               .
     1572               v-file-date = "" .
     1573               v-file-time = "" .
     1574             if buf_upgrade.version-num begins "?" or buf_upgrade.version-num = "'?'" then tt-upgrade.version-num = "Ошибка обновления" .
     1575             find first buf_upgrade-attr no-lock where
     1576               buf_upgrade-attr.db-num = buf_upgrade.db-num and
     1577               buf_upgrade-attr.version-num = buf_upgrade.version-num and
     1578               buf_upgrade-attr.attr-code = "compile-date" no-error .
     1579             if available (buf_upgrade-attr) then
     1580               tt-upgrade.compile-date = buf_upgrade-attr.attr-value
     1581                 .
     1582             for first buf_upgrade-attr no-lock where
     1583               buf_upgrade-attr.db-num = buf_upgrade.db-num and
     1584               buf_upgrade-attr.version-num = buf_upgrade.version-num and
     1585               buf_upgrade-attr.attr-code = "file-date" :
     1586               v-file-date = buf_upgrade-attr.attr-value .
     1587             end.
     1588             for first buf_upgrade-attr no-lock where
     1589               buf_upgrade-attr.db-num = buf_upgrade.db-num and
     1590               buf_upgrade-attr.version-num = buf_upgrade.version-num and
     1591               buf_upgrade-attr.attr-code = "file-time" :
     1592               v-file-time = get-time(integer(buf_upgrade-attr.attr-value)) .
     1593             end.
     1594             if v-file-date = ? or v-file-time = ? then tt-upgrade.date-time = "" .
     1595             else tt-upgrade.date-time = string(v-file-date) + "_" + string (v-file-time) .
     1596             for first buf_upgrade-attr no-lock where
     1597               buf_upgrade-attr.db-num = buf_upgrade.db-num and
     1598               buf_upgrade-attr.version-num = buf_upgrade.version-num and
     1599               buf_upgrade-attr.attr-code = "user",
     1600               first ub.user-login no-lock where ub.user-login.db-num = buf_upgrade.db-num
     1601               and ub.user-login.user-login = buf_upgrade-attr.attr-value,
     1602               first buf_user-account no-lock where buf_user-account.user-id = ub.user-login.user-id:
     1603               tt-upgrade.user_ = buf_user-account.last-name + '  ' + buf_user-account.first-name + ' ':U + buf_user-account.second-name.
     1604             end.
     1605           end.
     1606         end.
     1607       end.
     1608       for each tt-upgrade by tt-upgrade.db-num by tt-upgrade.UpgDate desc by tt-upgrade.UpgTime desc:
     1609         ii = ii + 1 .
     1610         if v-cntxt-db-num = 0 then
     1611         do:
     1612           put stream OutStr-html unformatted
     1613             '<tr>' skip
     1614             '<td style="align:center;">' + string(ii) + '</td>' skip
     1615             '<td text_wrap="true" style="align:center;">' + string(tt-upgrade.db-num) + '</td>' skip
     1616             '<td text_wrap="true" style="align:center;">' + string(tt-upgrade.db-name) + '</td>' skip
     1617             '<td text_wrap="true" style="align:center;">' + string(entry(1,tt-upgrade.version-num,chr(4))) + '</td>' skip
     1618             '<td text_wrap="true" style="align:center;">' + if string(tt-upgrade.compile-date) <> ? then string(tt-upgrade.compile-date) + '</td>' else " " + '</td>' skip
     1619             '<td text_wrap="true" style="align:center;">' + string(tt-upgrade.date-time) + '</td>' skip
     1620             '<td text_wrap="true" style="align:center;">' + string(tt-upgrade.UpgDate) + "_" + string(tt-upgrade.UpgTime) + '</td>' skip
     1621             '<td text_wrap="true" style="align:center;">' + string(tt-upgrade.user_) + '</td>' skip
     1622             '</tr>' skip
     1623             .
     1624         end.
     1625         else
     1626         do:
     1627           put stream OutStr-html unformatted
     1628             '<tr>' skip
     1629             '<td style="align:center;">' + string(ii) + '</td>' skip
     1630             '<td text_wrap="true" style="align:center;">' + string(entry(1,tt-upgrade.version-num,chr(4))) + '</td>' skip
     1631             '<td text_wrap="true" style="align:center;">' + if string(tt-upgrade.compile-date) <> ? then string(tt-upgrade.compile-date) + '</td>' else " " + '</td>' skip
     1632             '<td text_wrap="true" style="align:center;">' + string(tt-upgrade.date-time) + '</td>' skip
     1633             '<td text_wrap="true" style="align:center;">' + string(tt-upgrade.UpgDate) + "_" + string(tt-upgrade.UpgTime) + '</td>' skip
     1634             '<td text_wrap="true" style="align:center;">' + string(tt-upgrade.user_) + '</td>' skip
     1635             '</tr>' skip
     1636             .
     1637         end.
     1638       end.
     1639       put stream OutStr-html unformatted
     1640         '</tbody>' skip
     1641         '</table>' skip
     1642         .
     1643       put stream OutStr-html unformatted
     1644         '</body>' skip
     1645         '</html>' skip
     1646         .
     1647       put stream OutStr-html unformatted
     1648         '</tbody>' skip
     1649         '</table>' skip
     1650         .
     1651       output stream OutStr-html close.
     1652       run prn-lib-reportviewer-report-name in this-procedure (
     1653         input parParentProc
     1654         ,input v-report-name-html
     1655         ).
     1656     end.
     1657   END PROCEDURE.
     1658   PROCEDURE test-input :
     1659     do
     1660       on error undo, return error
     1661       :
     1662       if date_from > date_to
     1663         then
     1664       do:
     1665         message
     1666           "Даты интервала заданы неверно. "
     1667           skip
     1668           " Нижняя дата интервала должна быть меньше верхней."
     1669           skip(1) "Задайте интервал дат правильно или отмените экспорт."
     1670           view-as alert-box information.
     1671         apply "entry" to date_from in frame Dialog-Frame .
     1672         undo, return error.
     1673       end.
     1674     end.
     1675   END PROCEDURE.
     1676   FUNCTION get-infodb-date RETURNS character
     1677     ( INPUT p-db-num as integer) :
     1678     DEFINE BUFFER buf_db-info FOR ub.db-info.
     1679     find last buf_db-info no-lock where
     1680       buf_db-info.db-num = p-db-num use-index  pi no-error.
     1681     IF AVAILABLE buf_db-info  THEN RETURN string(buf_db-info.date-info).
     1682     RETURN "".
     1683   END FUNCTION.
     1684   FUNCTION get-time RETURNS character
     1685     ( INPUT p-time as integer) :
     1686     define variable v-time_ as character no-undo .
     1687     v-time_ = string(truncate (p-time / 3600, 0)) + ":" + string((p-time modulo 3600) / 60,"99") .
     1688     RETURN v-time_.
     1689   END FUNCTION.
