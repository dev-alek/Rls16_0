      313   define variable v-inform-launched as logical no-undo initial false .
      314   procedure proc-alt-shift-f4:
      315     define variable v-action as character no-undo .
      316     if v-inform-launched = false then do:
      317       assign
      318         v-inform-launched = true
      319       .
      320       run gbl/d-inform.w
      321         (  input self
      322         ,  input this-procedure
      323         , output v-action
      324         ) no-error .
      325       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      326       assign
      327         v-inform-launched = false
      328       .
      329     end.
      330   end.
