      864   DEFINE BUTTON bt-set
      865     LABEL "Выполнить"
      866     SIZE 12 BY 1.
      867   DEFINE BUTTON Btn_OK DEFAULT
      868     LABEL "&Выход"
      869     SIZE 10 BY 1
      870     BGCOLOR 8 .
      871   DEFINE VARIABLE date_from AS DATE FORMAT "99/99/9999":U
      872     LABEL "Дата с"
      873     VIEW-AS FILL-IN
      874     SIZE 12 BY 1 NO-UNDO.
      875   DEFINE VARIABLE date_to   AS DATE FORMAT "99/99/9999":U
      876     LABEL "по"
      877     VIEW-AS FILL-IN
      878     SIZE 12 BY 1 NO-UNDO.
      879   DEFINE FRAME Dialog-Frame
      880     Btn_OK AT ROW 1.25 COL 1.5
      881     date_from AT ROW 2.75 COL 11.5 COLON-ALIGNED
      882     date_to AT ROW 2.75 COL 29 COLON-ALIGNED
      883     bt-set AT ROW 2.75 COL 45.5
      884     SPACE(0.74) SKIP(1.03)
      885     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      886     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      887     TITLE "Историческая справка по версиям".
      888   ASSIGN
      889     FRAME Dialog-Frame:SCROLLABLE = FALSE
      890     FRAME Dialog-Frame:HIDDEN     = TRUE.
      891   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      892     DO:
      893       APPLY "END-ERROR":U TO SELF.
      894     END.
      895   ON CHOOSE OF bt-set IN FRAME Dialog-Frame
      896     DO:
      897       ASSIGN
      898         date_from
      899         date_to
      900         .
      901       run test-input .
      902       run print_RC .
      903     END.
      904   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      905     DO:
      906       APPLY "GO" TO FRAME Dialog-Frame.
      907     END.
      908   ON RETURN OF date_from IN FRAME Dialog-Frame
      909     DO:
      910       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
      911       RETURN NO-APPLY.
      912     END.
      913   ON RETURN OF date_to IN FRAME Dialog-Frame
      914     DO:
      915       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
      916       RETURN NO-APPLY.
      917     END.
      918   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      919     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      920   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921   on ' ' of date_from in frame Dialog-Frame
      922   do:
      923     if (can-query (self, "sensitive")
      924        and
      925        self :sensitive = true
      926        )
      927     or (can-query (self, "read-only")
      928        and
      929        self :read-only = false
      930        )
      931     then do:
      932       assign
      933         self :screen-value = ?
      934       .
      935     end.
      936     return no-apply.
      937   end.
      938   on delete-character of date_from in frame Dialog-Frame
      939   do:
      940     if (can-query (self, "sensitive")
      941        and
      942        self :sensitive = true
      943        )
      944     or (can-query (self, "read-only")
      945        and
      946        self :read-only = false
      947        )
      948     then do:
      949       assign
      950         self :screen-value = ?
      951       .
      952     end.
      953     return no-apply.
      954   end.
      955   on ctrl-d of date_from in frame Dialog-Frame
      956   do:
      957     define variable v-curr-sv-date as date no-undo .
      958     if (can-query (self, "sensitive")
      959        and
      960        self :sensitive = true
      961        )
      962     or (can-query (self, "read-only")
      963        and
      964        self :read-only = false
      965        )
      966     then do:
      967       if self :handle <> focus :handle
      968       then do:
      969         apply "entry":u to self .
      970       end.
      971       run gbl/getcurdt.p
      972         (output v-curr-sv-date
      973         ) .
      974       assign
      975         self :screen-value = string(v-curr-sv-date) .
      976       .
      977     end.
      978     return no-apply.
      979   end.
      980   on ctrl-b of date_from in frame Dialog-Frame
      981   do:
      982     if (can-query (self, "sensitive")
      983        and
      984        self :sensitive = true
      985        )
      986     or (can-query (self, "read-only")
      987        and
      988        self :read-only = false
      989        )
      990     then do:
      991       if self :handle <> focus :handle
      992       then do:
      993         apply "entry":u to self .
      994       end.
      995       define variable v-curr-sv-date as date no-undo .
      996       define variable v-new-sv-date  as date no-undo .
      997       assign
      998         v-curr-sv-date = date(self :screen-value) no-error
      999       .
     1000       if v-curr-sv-date = ?
     1001       then do:
     1002         run gbl/getcurdt.p
     1003           (output v-curr-sv-date
     1004           ) .
     1005       end.
     1006       if v-curr-sv-date <> ?
     1007       then do:
     1008         assign
     1009           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1010         .
     1011         assign
     1012           self :screen-value = string(v-new-sv-date) .
     1013         .
     1014       end.
     1015     end.
     1016     return no-apply .
     1017   end.
     1018   on ctrl-e of date_from in frame Dialog-Frame
     1019   do:
     1020     if (can-query (self, "sensitive")
     1021        and
     1022        self :sensitive = true
     1023        )
     1024     or (can-query (self, "read-only")
     1025        and
     1026        self :read-only = false
     1027        )
     1028     then do:
     1029       if self :handle <> focus :handle
     1030       then do:
     1031         apply "entry":u to self .
     1032       end.
     1033       define variable v-curr-sv-date as date no-undo .
     1034       define variable v-new-sv-date  as date no-undo .
     1035       assign
     1036         v-curr-sv-date = date(self :screen-value) no-error
     1037       .
     1038       if v-curr-sv-date = ?
     1039       then do:
     1040         run gbl/getcurdt.p
     1041           (output v-curr-sv-date
     1042           ) .
     1043       end.
     1044       if v-curr-sv-date <> ?
     1045       then do:
     1046         run gbl/lastdate.p
     1047           (input  v-curr-sv-date
     1048           ,output v-new-sv-date
     1049           ).
     1050         assign
     1051           self :screen-value = string(v-new-sv-date) .
     1052         .
     1053       end.
     1054     end.
     1055     return no-apply .
     1056   end.
     1057   on ctrl-f of date_from in frame Dialog-Frame
     1058   do:
     1059     if (can-query (self, "sensitive")
     1060        and
