      354   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      356     (input  v-report-name
      357     ,input  2
      358     ,output v-exist
      359     )  .
      360       if NOT v-exist then
      361       DO:
      362         Message
      363           "Нет заданий на печать ! "
      364           view-as alert-box .
      365         Return  .
      366       End.
      367       run gbl/prnfilen.w
      368         (input  ""
      369         ,input  p-DisabledOptions
      370         ,input  string(v-report-name )
      371         ,input  7
      372         ,output v-user-action
      373         ,output v-printed
      374         ) .
      375       if v-printed then
      376       do:
      377         return "YES" .
      378       end.
      379       else
      380       do:
      381         return "NO" .
      382       end.
      383     end.
      384   end procedure.
      385   procedure prn-lib-open-stream :
      386     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      387     define input parameter p-page-size    as integer no-undo .
      388     define input parameter p-is-stream    as logical no-undo .
      389     define input parameter p-append       as logical no-undo .
      390     define variable v-report-name as character no-undo .
      391     do
      392       on error undo, return error
      393       :
      394       run prn-lib-get-report-name  in this-procedure (
      395         input parParentProc
      396         ,output v-report-name
      397         ).
      398       if p-is-stream then
      399       do:
      400         if p-append then
      401         do:
      402           output stream PrnLibStream to value( v-report-name )
      403             page-size value(p-page-size) append .
      404         end.
      405         if not p-append then
      406         do:
      407           output stream PrnLibStream to value( v-report-name )
      408             page-size value(p-page-size) .
      409         end.
      410       end.
      411       if not p-is-stream then
      412       do:
      413         if p-append then
      414         do:
      415           output to value( v-report-name )
      416             page-size value(p-page-size) append .
      417         end.
      418         if not p-append then
      419         do:
      420           output to value( v-report-name )
      421             page-size value(p-page-size) .
      422         end.
      423       end.
      424     end.
      425   end procedure.
      426   procedure prn-lib-open-exp :
      427     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      428     define input parameter p-is-stream    as logical no-undo .
      429     define input parameter p-is-append    as logical no-undo .
      430     define output parameter p-ReportFileName as char init "report" no-undo.
      431     define output parameter p-process as logical no-undo .
      432     define variable glog as logical no-undo .
      433     do
      434       on error undo, return error
      435       :
      436       SYSTEM-DIALOG GET-FILE p-ReportFileName
      437         TITLE      "Укажите путь"
      438         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      439         ASK-OVERWRITE
      440         CREATE-TEST-FILE
      441         SAVE-AS
      442         USE-FILENAME
      443         DEFAULT-EXTENSION "txt"
      444         UPDATE glog
      445         .
      446       if not glog then  return.
      447       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      448       if p-is-stream then
      449       do:
      450         if p-is-append then
      451         do:
      452           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      453         end.
      454         else
      455         do:
      456           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      457         end.
      458       end.
      459       else
      460       do:
      461         if p-is-append then
      462         do:
      463           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      464         end.
      465         else
      466         do:
      467           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      468         end.
      469       end.
      470       p-process = yes.
      471     end.
      472   end procedure.
      473   procedure prn-lib-get-report-name :
      474     define input parameter parParentProc  as widget-handle no-undo.
      475     define output parameter p-report-name as character no-undo .
      476     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      477   end procedure.
      478   procedure prn-lib-reportviewer-report-name :
      479     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      480     define input parameter p-report-name-html as character no-undo .
      481     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      482   end procedure.
      483   procedure prn-lib-reportviewer :
      484     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      485     define input parameter p-report-name-html as character no-undo .
      486     define input parameter p-param        as character no-undo .
      487     define variable v-excel           as character no-undo init 'TRUE' .
      488     define variable v-value-character as character no-undo .
      489     define variable v-value-integer   as character no-undo .
      490     define variable v-value-date      as date      no-undo .
      491     define variable v-value-decimal   as decimal   no-undo .
      492     define variable rep-excel         as logical   no-undo .
      493     define variable excel-string      as character no-undo .
      494     define variable v-param-type      as character no-undo .
      495     define variable v-tth             as handle    no-undo .
      496     run adm/shattri.p (
      497       input "get":U
      498       ,input  ""
      499       ,input  0
      500       ,input  'report-glob':U
      501       ,input  'rep-excel':U
      502       ,output v-value-character
      503       ,output v-value-date
      504       ,output v-value-decimal
      505       ,output v-value-integer
      506       ,output rep-excel
      507       ,output v-param-type
      508       ,INPUT-OUTPUT table-handle v-tth
      509       )  .
      510     if rep-excel then v-excel = "TRUE" .
      511     else v-excel = "FALSE" .
      512     if p-param eq ""
      513     then
      514        p-param = "EXCEL:" + v-excel.
      515     else
      516        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      517     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      518   end procedure.
