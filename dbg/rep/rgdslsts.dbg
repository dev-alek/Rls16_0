      339   define  stream PrnLibStream.
      340   procedure prn-lib-prn-file :
      341     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      342     define input parameter p-DIsabledoptions as integer no-undo .
      343     define variable v-report-name as character no-undo .
      344     define variable v-user-action as character no-undo .
      345     define variable v-printed     as logical   no-undo .
      346     define variable v-exist       as logical   no-undo .
      347     do
      348       on error undo, return error
      349       :
      350       run prn-lib-get-report-name  in this-procedure (
      351         input parParentProc
      352         ,output v-report-name
