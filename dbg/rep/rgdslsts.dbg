      878   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      879   define variable v-waitfram-action01         as character   no-undo .
      880   define variable v-waitfram-action02         as character   no-undo .
      881   define variable v-waitfram-action03         as character   no-undo .
      882   define variable mWaitFramTextBeg            as character   no-undo.
      883   define variable mWaitFramTextEnd            as character   no-undo.
      884   define variable mWaitFramView               as logical     no-undo.
      885   define variable mWaitProcEvent              as logical     no-undo init yes.
      886   define variable mWaitFramInterval           as integer     no-undo init 1 .
      887   define variable mWaitFramStop               as logical     no-undo.
      888   define variable mWaitFramStopUser           as logical     no-undo.
      889   define variable mWaitFramStopTimeOut        as logical     no-undo.
      890   define variable mWaitFramStartProc          as datetime-tz no-undo.
      891   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      892   define button B-WaitFramStop auto-end-key
      893        label "Стоп"
      894        size 10 by 1 tooltip "Остоновить процесс".
      895   define button B-viewProcInfo
      896        label "Информация"
      897        size 15 by 1 tooltip "Информация о процесс".
      898   define frame waitfram
      899     v-waitfram-action01 format "x(72)" no-label skip
      900     v-waitfram-action02 format "x(72)" no-label skip
      901     v-waitfram-action03 format "x(72)" no-label skip
      902     B-viewProcInfo
      903     B-WaitFramStop at row 4 col 30
      904     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      905     .
      906   define new global shared variable mBatchMode as logical no-undo init ?.
      907   define variable mFramBachModHandle as handle no-undo.
      908   mFramBachModHandle = frame waitfram:handle.
      909   define variable mFameOldVis as logical no-undo.
      910   define variable mVisCUrentVin as logical no-undo.
      911   if session:batch-mode
      912   then
      913      mBatchMode = yes.
      914   if mBatchMode = ? then do:
      915     mVisCUrentVin = current-window:visible.
      916     mFameOldVis = mFramBachModHandle:visible.
      917     mFramBachModHandle:visible  = yes.
      918     mBatchMode = mFramBachModHandle:visible ne yes.
      919     mFramBachModHandle:visible = mFameOldVis.
      920     current-window:visible = mVisCUrentVin.
      921   end.
      922    if  log-manager:logfile-name ne ?
      923     then DO:
      924         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      925         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      926         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      927     end.
      928   on choose of B-WaitFramStop in frame waitfram
      929   do:
      930     mWaitFramStop = yes.
      931     mWaitFramStopUser = yes.
      932   end.
      933   function waitfram-check-timeout returns logical():
      934      define variable vtime as int64 no-undo.
      935      if mWaitFramStopTimeOut
      936      then
      937         return yes.
      938      vtime = ( now - mWaitFramStartProc ) / 1000 .
      939      if     mWaitFramTimeOut ne ?
      940         and mWaitFramTimeOut ne 0
      941         and mWaitFramTimeOut lt vtime
      942      then do:
      943         mWaitFramStopTimeOut = yes.
      944      end.
      945      return mWaitFramStopTimeOut.
      946   end.
      947   procedure waitfram-hide :
      948     if not session:batch-mode
      949     then do
      950     on error undo, return error return-value
      951     :
      952       pause 0 before-hide .
      953       if not mBatchMode then
      954         hide frame waitfram .
      955     if     not mWaitFramView
      956        and mWaitProcEvent
      957     then
      958       process events .
      959     end.
      960   end procedure.
      961   procedure waitfram-show :
      962     define input  parameter p-message as character no-undo .
      963     define variable v-left-margin as integer   no-undo .
      964     if not session:batch-mode
      965     then do
      966     on error undo, return error return-value
      967     :
      968       if length(p-message) <= 70 then do:
      969         assign
      970           v-left-margin = integer((70 - length(p-message)) / 2)
      971         .
      972         assign
      973           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      974         .
      975         assign
      976           v-waitfram-action01 = " "
      977           v-waitfram-action02 = " "
      978                                    + fill(" ", v-left-margin)
      979                                    + p-message
      980           v-waitfram-action03 = " "
      981         .
      982       end.
      983       else do:
      984         define variable vRindex1 as integer no-undo.
      985         define variable vRindex2 as integer no-undo.
      986         vRindex1 = r-index(p-message," ",70).
      987         if vRindex1 = 0
      988         then
      989            vRindex1 = 70.
      990         if length(p-message)  <= vRindex1 + 70 then do:
      991           assign
      992             v-waitfram-action01 = " "
      993             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      994             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      995           .
      996         end.
      997         else do:
      998           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      999           if vRindex2 <= vRindex1
     1000           then
     1001              vRindex2 = vRindex1 + 70.
     1002           assign
     1003             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1004             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1005             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1006           .
     1007         end.
     1008       end.
     1009       B-viewProcInfo:visible   in frame waitfram = no.
     1010       B-viewProcInfo:sensitive in frame waitfram = no.
     1011       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1012       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1013       if  (   mWaitFramView
     1014          or  mWaitProcEvent)
     1015          and not mBatchMode
     1016       then
     1017          display
     1018             v-waitfram-action01 skip
     1019             v-waitfram-action02 skip
     1020             v-waitfram-action03 skip
     1021          with frame waitfram .
     1022       if     mWaitFramView
     1023          then do:
     1024             if     mWaitFramInterval ne ?
     1025                and not mBatchMode
     1026             then
     1027                wait-for go of frame waitfram pause mWaitFramInterval.
     1028          end.
     1029          else
     1030             if     mWaitProcEvent
     1031                and not mBatchMode
     1032             then
     1033                process events .
     1034     end.
     1035   end procedure.
     1036      procedure waitfram-show-this:
     1037         define input  parameter iInterval as int64 no-undo.
     1038         define variable vtime as int64 no-undo.
     1039         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1040         mWaitFramInterval = iInterval.
     1041         run waitfram-show (substitute("&1&2 &3&4" ,
     1042                                       mWaitFramTextBeg ,
     1043                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1044                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1045                                       mWaitFramTextEnd
     1046                                      )
     1047                           ).
     1048      end.
     1049      procedure WaitFramRunPause:
     1050         define input  parameter iInterval as dec no-undo.
     1051         define variable vStart  as datetime-tz no-undo.
     1052         define variable vend    as datetime-tz no-undo.
     1053         define variable vint as int64 no-undo.
     1054         define variable vOk as logical no-undo.
     1055         vStart = now.
     1056         vend   = vStart.
     1057         publish "WaitFramPause" (iInterval,output vOk).
     1058         vend   =  now.
     1059         vint = vend - vStart.
     1060         vint = iInterval - vint / 1000.
     1061         if     not mWaitFramStop
     1062            and (   vint > 0
     1063                 or (    not vOk
     1064                     and iInterval eq ?
     1065                     )
     1066                 )
     1067         then
     1068            run waitfram-show-this (iInterval).
     1069         vend   =  now.
     1070         vint = vend - vStart.
     1071         vint = iInterval - vint / 1000.
     1072         if     not mWaitFramStop
     1073            and vint > 0
     1074         then do:
     1075            run gbl/pause.p (vint * 1000).
     1076         end.
     1077         if iInterval ne ?
     1078         then
     1079            publish "WaitFramStop".
     1080         waitfram-check-timeout().
     1081      end.
     1082      procedure WaitFramWaitFor:
     1083         define input  parameter iInterval as dec no-undo.
     1084         assign
     1085            mWaitFramStartProc   = now
     1086            mWaitFramStopUser    = no
     1087            mWaitFramStopTimeOut = no
     1088         .
     1089         block-wait:
     1090         do while not mWaitFramStop:
     1091            run WaitFramRunPause (iInterval).
     1092            if  waitfram-check-timeout()
     1093            then do:
     1094               leave block-wait.
     1095            end.
     1096         end.
     1097         run waitfram-hide.
     1098      end.
     1099   procedure waitfram-join :
     1100     define input  parameter p-line-1  as character no-undo .
     1101     define input  parameter p-line-2  as character no-undo .
     1102     define input  parameter p-line-3  as character no-undo .
     1103     define output parameter p-message as character no-undo .
     1104     do
     1105     on error undo, return error return-value
     1106     :
     1107       assign
     1108         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1109                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1110                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1111       .
     1112     end.
     1113   end procedure.
     1114   function waitfram-join-function returns character
     1115     (input p-line-1 as character
     1116     ,input p-line-2 as character
     1117     ,input p-line-3 as character
     1118     ).
     1119     define variable v-message as character no-undo .
     1120     run waitfram-join in this-procedure
     1121       (input  p-line-1
     1122       ,input  p-line-2
     1123       ,input  p-line-3
     1124       ,output v-message
     1125       ) .
     1126     return v-message .
     1127   end function .
     1128   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129   define variable  sym1 as char init ":"   no-undo.
     1130   define variable  sym2 as char init ":"   no-undo.
     1131   define variable  sym3 as char init ":"   no-undo.
     1132   define variable  sym4 as char init ":"   no-undo.
     1133   define variable  sym5 as char init ":"   no-undo.
     1134   define variable  sym6 as char init ":"   no-undo.
     1135   define variable  sym7 as char init ":"   no-undo.
     1136   define variable  sym8 as char init ":"   no-undo.
     1137   define variable  tb-code as char no-undo.
     1138   define variable  pbtb-code as character no-undo .
     1139   define variable  free-clmn as char no-undo.
     1140   define variable  Line         as  char    no-undo.
     1141   define variable  v-ind as integer no-undo .
     1142   DEFINE VARIABLE varattr-value as character no-undo .
     1143   DEFINE VARIABLE varattr-type as character no-undo .
     1144   define buffer buf_clients for ub.clients.
     1145   define buffer buf_units for ub.units.
     1146   define stream PrnLibStream.
     1147   DEFINE FRAME zapas
     1148   sym1 column-label ":!:" format "X(1)"
     1149   gds-zap.weight-bc column-label "Вес.!код" format "X(5)"
     1150   sym2 column-label ":!:" format "X(1)"
     1151   tb-code column-label "Код! " format "x(10)"
     1152   sym3 column-label ":!:" format "X(1)"
     1153   gds-zap.artic column-label "Артикул! " format "X(16)"
     1154   sym4 column-label ":!:" format "X(1)"
     1155   gds-zap.gds-name column-label "Название товара! " format "X(50)"
     1156   sym5 column-label ":!:" format "X(1)"
     1157   gds-zap.qnty     column-label "Количество! " format "->>>,>>9.999"
     1158   sym7 column-label ":!:" format "X(1)"
     1159   free-clmn column-label "Для заметок! " format "X(38)"
     1160   sym6 column-label ":!:" format "X(1)"
     1161   HEADER
     1162   cur-time-print() AT 5 format "X(35)"
     1163   string( "Страница" ) AT 110 PAGE-NUMBER(Prnlibstream) AT 120 FORMAT ">>>9" SKIP
     1164   Line format "X(135)" AT 1
     1165   with width 160 down stream-io.
     1166   if not can-find(first scn-list) then do:
     1167     message
     1168       "Список пустой"
     1169       view-as alert-box information .
     1170     return .
     1171   end.
     1172   run waitfram-show in this-procedure ( "Обработано записей " ) .
     1173   FOR EACH scn-list USE-INDEX art NO-LOCK:
     1174     assign
     1175     v-ind = v-ind + 1
     1176     .
     1177     if ( v-ind modulo 25 ) = 0 then do:
     1178       run waitfram-show in this-procedure ( "Обработано записей " + string(v-ind) ) .
     1179     end.
     1180     FIND buf_clients WHERE
     1181        buf_clients.obj-type = scn-list.prod-type
     1182    AND buf_clients.obj-code = scn-list.prod-code NO-LOCK .
     1183     CREATE gds-zap .
     1184     assign
     1185     gds-zap.unit-base  = scn-list.unit-base
     1186     gds-zap.prt-root     = scn-list.prt-root
     1187     gds-zap.gds-name = scn-list.gds-name
     1188     gds-zap.prod-type  = scn-list.prod-type
     1189     gds-zap.prod-code = scn-list.prod-code
     1190     gds-zap.artic          = scn-list.artic
     1191     gds-zap.prod-name = buf_clients.obj-name
     1192     gds-zap.grp-name = scn-list.grp-name
     1193     gds-zap.order-num  = scn-list.order-num
     1194     gds-zap.qnty     = scn-list.qnty
     1195     .
     1196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1197     (input  scn-list.gds-code
     1198     ,input  ?
     1199     ,output gds-zap.b-code
     1200     )  .
     1201     assign
     1202       gds-zap.weight-bc = ""
     1203     .
     1204     FIND buf_units WHERE
     1205         buf_units.unit-name = scn-list.unit-base NO-LOCK.
     1206     if lookup('вес':U, buf_units.type) > 0 then do:
     1207       varattr-value = "":U.
     1208       run gdsoattr-value in this-procedure(
     1209                                             input 'scales-code':U
     1210                                             ,input scn-list.gds-code
     1211                                             ,input p-obj-type
     1212                                             ,input p-obj-code
     1213                                             ,output varattr-value
     1214                                             ,output varattr-type
     1215                                             ) no-error.
     1216       assign gds-zap.weight-bc = varattr-value.
     1217     end.
     1218   END.
     1219   run waitfram-hide in this-procedure .
     1220     run prn-lib-open-stream  in this-procedure (
     1221                                               input parparentproc
     1222                                               ,input 43
     1223                                               ,input yes
     1224                                               ,input no
     1225                                               ).
     1226   PUT  stream PrnlibStream
     1227   space(30)
     1228   "СПИСОК  ТОВАРОВ" format "X(50)" SKIP(1)
     1229            .
     1230   FORM HEADER
     1231   Line format "X(135)" AT 1 SKIP
     1232   "Продолжение - на следующей странице" AT 30 SKIP
     1233   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX.
     1234   VIEW stream Prnlibstream FRAME BottomFrame .
     1235   Line = fill("-", 140) .
     1236   FORM with frame zapas .
     1237   CASE p-Classify :
     1238     when "Classify_1" then do:
     1239       FOR EACH gds-zap BREAK BY  (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1240         DISPLAY stream PrnLibStream
     1241         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1242         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1243         sym4 gds-zap.weight-bc
     1244         sym5 free-clmn sym6
     1245           sym7
     1246           gds-zap.qnty
     1247         with frame zapas .
     1248         DOWN stream PrnLibStream
     1249         1 with frame zapas .
     1250       END.
     1251     end.
     1252     when "Classify_2" then do:
     1253       FOR EACH gds-zap
     1254       BREAK
     1255       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1256       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1257         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then  do:
     1258           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1259               UNDERLINE stream PrnLibStream
     1260               tb-code
     1261               gds-zap.artic
     1262               gds-zap.gds-name
     1263               with frame zapas .
     1264           end.
     1265           DISPLAY stream PrnLibStream
     1266           sym1
     1267           "Производитель :" @ gds-zap.artic
     1268           gds-zap.prod-name @ gds-zap.gds-name
     1269           sym5 with frame zapas .
     1270           DOWN stream PrnLibStream
     1271           1 with frame zapas .
     1272           UNDERLINE stream PrnLibStream
     1273           tb-code
     1274           gds-zap.artic
     1275           gds-zap.gds-name
     1276           with frame zapas .
     1277         end.
     1278         DISPLAY stream PrnLibStream
     1279         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1280         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1281         sym4 gds-zap.weight-bc
     1282         sym5 free-clmn sym6
     1283           sym7
     1284           gds-zap.qnty
     1285         with frame zapas .
     1286         DOWN stream PrnLibStream
     1287         1 with frame zapas .
     1288       END.
     1289     END.
     1290     when "Classify_3" then do:
     1291       FOR EACH gds-zap
     1292       BREAK
     1293       BY gds-zap.grp-name
     1294       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           )  :
     1295         if first-of ( gds-zap.grp-name ) then do:
     1296           if NOT first ( gds-zap.grp-name ) then do:
     1297             UNDERLINE stream PrnLibStream
     1298             tb-code
     1299             gds-zap.artic
     1300             gds-zap.gds-name
     1301             with frame zapas .
     1302           end.
     1303           DISPLAY stream PrnLibStream
     1304           sym1 "Группа товаров :" @ gds-zap.artic
     1305           gds-zap.grp-name @ gds-zap.gds-name
     1306           sym5
     1307           with frame zapas .
     1308           DOWN stream PrnLibStream
     1309           1 with frame zapas .
     1310           UNDERLINE stream PrnLibStream
     1311           tb-code
     1312           gds-zap.artic
     1313           gds-zap.gds-name
     1314           with frame zapas .
     1315         end.
     1316         DISPLAY stream PrnLibStream
     1317         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1318         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1319         sym4 gds-zap.weight-bc
     1320         sym5 free-clmn
     1321         sym6
     1322           sym7
     1323           gds-zap.qnty
     1324         with frame zapas .
     1325         DOWN stream PrnLibStream
     1326         1 with frame zapas .
     1327       END.
     1328     end.
     1329     when "Classify_4" then do:
     1330       FOR EACH gds-zap
     1331       BREAK
     1332       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1333       BY gds-zap.grp-name
     1334       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1335         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1336           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1337             UNDERLINE stream PrnLibStream
     1338             tb-code
     1339             gds-zap.artic
     1340             gds-zap.gds-name
     1341             with frame zapas .
     1342           end.
     1343           DISPLAY stream PrnLibStream
     1344           sym1  "Производитель :" @ gds-zap.artic
     1345           gds-zap.prod-name @ gds-zap.gds-name
     1346           sym5 with frame zapas .
     1347           DOWN stream PrnLibStream
     1348           1 with frame zapas .
     1349           UNDERLINE stream PrnLibStream
     1350           tb-code
     1351           gds-zap.artic
     1352           gds-zap.gds-name
     1353           with frame zapas .
     1354         end.
     1355         if first-of ( gds-zap.grp-name ) then do:
     1356           if NOT first ( gds-zap.grp-name ) then do:
     1357             UNDERLINE stream PrnLibStream
     1358             tb-code
     1359             gds-zap.artic
     1360             gds-zap.gds-name
     1361             with frame zapas .
     1362           end.
     1363           DISPLAY stream PrnLibStream
     1364           sym1 "Группа товаров :" @ gds-zap.artic
     1365           gds-zap.grp-name @ gds-zap.gds-name
     1366           sym5 with frame zapas .
     1367           DOWN stream PrnLibStream
     1368           1 with frame zapas .
     1369           UNDERLINE stream PrnLibStream
     1370           tb-code
     1371           gds-zap.artic
     1372           gds-zap.gds-name
     1373           with frame zapas .
     1374         end.
     1375         DISPLAY stream PrnLibStream
     1376         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1377         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1378         sym4 gds-zap.weight-bc
     1379         sym5 free-clmn sym6
     1380           sym7
     1381           gds-zap.qnty
     1382         with frame zapas .
     1383         DOWN stream PrnLibStream
     1384         1 with frame zapas .
     1385       END.
     1386     end.
     1387     when "Classify_5" then do:
     1388       FOR EACH gds-zap
     1389       BREAK
     1390       BY gds-zap.grp-name
     1391       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1392       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1393         if first-of ( gds-zap.grp-name ) then  do:
     1394           if NOT first ( gds-zap.grp-name ) then do:
     1395             UNDERLINE stream PrnLibStream
     1396             tb-code
     1397             gds-zap.artic
     1398             gds-zap.gds-name
     1399             with frame zapas .
     1400           end.
     1401           DISPLAY stream PrnLibStream
     1402           sym1 "Группа товаров :" @ gds-zap.artic
     1403           gds-zap.grp-name @ gds-zap.gds-name
     1404           sym5 with frame zapas .
     1405           DOWN stream PrnLibStream
     1406           1 with frame zapas .
     1407           UNDERLINE stream PrnLibStream
     1408           tb-code gds-zap.artic gds-zap.gds-name with frame zapas .
     1409         end.
     1410         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1411           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1412             UNDERLINE stream PrnLibStream
     1413             tb-code
     1414             gds-zap.artic
     1415             gds-zap.gds-name
     1416             with frame zapas .
     1417           end.
     1418           DISPLAY stream PrnLibStream
     1419           sym1 "Производитель :" @ gds-zap.artic
     1420           gds-zap.prod-name @ gds-zap.gds-name
     1421           sym5
     1422           with frame zapas .
     1423           DOWN stream PrnLibStream
     1424           1 with frame zapas .
     1425           UNDERLINE stream PrnLibStream
     1426           tb-code gds-zap.artic gds-zap.gds-name with frame zapas .
     1427         end.
     1428         DISPLAY stream PrnLibStream
     1429         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1430         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1431         sym4 gds-zap.weight-bc
     1432         sym5 free-clmn sym6
     1433           sym7
     1434           gds-zap.qnty
     1435         with frame zapas .
     1436         DOWN stream PrnLibStream
     1437         1 with frame zapas .
     1438       END.
     1439     END.
     1440   END CASE .
     1441   HIDE stream PrnlibStream FRAME BottomFrame .
     1442   PUT  stream PrnlibStream
     1443   Line format "X(135)" SKIP .
     1444   output stream PrnlibStream CLOSE .
     1445   run prn-lib-prn-file in this-procedure (
     1446                                             input parparentproc
     1447                                             ,input 0
     1448                                             ).
     1449   return "OK" .
