     2486       bfacc_tt-allsum.slt-rubl-acc        = bf_tt-allsum.slt-rubl-acc
     2487       bfacc_tt-allsum.slt-cli-acc         = bf_tt-allsum.slt-cli-acc
     2488       bfacc_tt-allsum.excise-base-acc     = bf_tt-allsum.excise-base-acc
     2489       bfacc_tt-allsum.excise-rubl-acc     = bf_tt-allsum.excise-rubl-acc
     2490       bfacc_tt-allsum.excise-cli-acc      = bf_tt-allsum.excise-cli-acc
     2491       bfacc_tt-allsum.road-tax-base-acc   = bf_tt-allsum.road-tax-base-acc
     2492       bfacc_tt-allsum.road-tax-rubl-acc   = bf_tt-allsum.road-tax-rubl-acc
     2493       bfacc_tt-allsum.road-tax-cli-acc    = bf_tt-allsum.road-tax-cli-acc
     2494       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     2495       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     2496       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     2497       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     2498       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     2499       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     2500       .
     2501     assign
     2502       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     2503       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     2504       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     2505       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2506       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     2507       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     2508       bfsacc_tt-allsum.vat-base-doc        = 0
     2509       bfsacc_tt-allsum.vat-rubl-doc        = 0
     2510       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     2511       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     2512       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     2513       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     2514       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     2515       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     2516       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     2517       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     2518       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     2519       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     2520       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     2521       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     2522       bfsacc_tt-allsum.vat-base-cur        = 0
     2523       bfsacc_tt-allsum.vat-rubl-cur        = 0
     2524       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     2525       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     2526       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     2527       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     2528       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     2529       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     2530       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     2531       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     2532       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     2533       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2534       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     2535       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     2536       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     2537       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     2538       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     2539       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     2540       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     2541       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     2542       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     2543       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     2544       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     2545       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     2546       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     2547       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     2548       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     2549       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     2550       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     2551       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     2552       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     2553       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     2554       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2555       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2556       .
     2557   end.
     2558   otherwise do:
     2559     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2560                              cl_tt-clcparts.purch-code,
     2561                              cl_tt-clcparts.part-code,
     2562                              cl_tt-clcparts.out-code,
     2563                              cl_tt-clcparts.in-code,
     2564                              cl_tt-clcparts.artic,
     2565                              cl_tt-clcparts.prod-type,
     2566                              cl_tt-clcparts.prod-code).
     2567   end.
     2568   end case.
     2569   end.
     2570   end procedure.
     2571   procedure clcprtsl_calc-line :
     2572   define input  parameter parrec-line as recid no-undo.
     2573   define variable v-tax-date         as   date                     no-undo.
     2574   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2575   define variable varr-b             as   character                no-undo.
     2576   define variable varr-btype         as   character                no-undo.
     2577   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2578   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2579   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2580   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2581   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2582   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2583   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2584   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2585   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2586   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2587   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2588   define variable varexcise          like ub.price-list.excise     no-undo.
     2589   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2590   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2591   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2592   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2593   define variable v-varsum           as decimal                  no-undo.
     2594   define variable varprice-salef as decimal   no-undo .
     2595   define buffer bf_trn-doc             for ub.trn-doc.
     2596   define buffer bf_doc-line            for ub.doc-line.
     2597   define buffer bf_gds-dtl             for ub.gds-dtl.
     2598   define buffer bf_goods               for ub.goods.
     2599   define buffer bf_parts               for ub.parts.
     2600   define buffer bf_sysconf             for ub.sysconf.
     2601   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2602   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2603   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2604   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2605   define buffer buf_parts        for ub.parts.
     2606   v-calcbypart = no.
     2607   do on error undo, return error return-value :
     2608   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2609   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2610     (output varr-b
     2611     )  .
     2612     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2613     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2614     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2615                               bf_goods.prod-type = bf_doc-line.prod-type and
     2616                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2617     if bf_trn-doc.fact-date <> ?        then do:
     2618       assign v-tax-date = bf_trn-doc.fact-date.
     2619     end.
     2620     else do:
     2621       assign v-tax-date = ?.
     2622     end.
     2623   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2624   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2625     (input  bf_goods.gds-code
     2626     ,input  '1':U
     2627     ,input  v-tax-date
     2628     ,input  bf_trn-doc.host-code
     2629     ,input  bf_trn-doc.obj-type
     2630     ,input  bf_trn-doc.obj-code
     2631     ,output v-vat-pc
     2632     ) no-error .
     2633     if error-status :error
     2634     or v-vat-pc = ? then do:
     2635        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2636     end.
     2637     if bf_goods.gds-type = 'у':U or
     2638        bf_trn-doc.status_ = 'запрос':U then do:
     2639       for each bf_tt-allsum-line
     2640       on error undo, return error return-value
     2641        :
     2642         delete bf_tt-allsum-line.
     2643       end.
     2644       create bf_tt-allsum-line.
     2645       assign
     2646        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2647       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2648                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2649                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2650                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2651         assign
     2652           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2653           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2654           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2655           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2656           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2657           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2658           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2659           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2660           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2661           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2662           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2663           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2664           bf_tt-allsum-line.vat-cli-acc          =  ?
     2665           .
     2666       end.
     2667       assign
     2668         bf_tt-allsum-line.cli-qnty             =  ?
     2669         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2670         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2671         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2672         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2673         bf_tt-allsum-line.road-tax-base-doc    =  0
     2674         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2675         bf_tt-allsum-line.excise-base-doc      =  0
     2676         bf_tt-allsum-line.excise-rubl-doc      =  0
     2677         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2678         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2679         bf_tt-allsum-line.dsc-base-cur         =  0
     2680         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2681         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2682         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2683         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2684         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2685         bf_tt-allsum-line.road-tax-base-cur    =  0
     2686         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2687         bf_tt-allsum-line.excise-base-cur      =  0
     2688         bf_tt-allsum-line.excise-rubl-cur      =  0
     2689         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2690         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2691         bf_tt-allsum-line.dsc-base-acc         =  0
     2692         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2693         bf_tt-allsum-line.dsc-cli-acc          =  0
     2694         bf_tt-allsum-line.slt-base-acc         =  0
     2695         bf_tt-allsum-line.slt-rubl-acc         =  0
     2696         bf_tt-allsum-line.slt-cli-acc          =  0
     2697         bf_tt-allsum-line.road-tax-base-acc    =  0
     2698         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2699         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2700         bf_tt-allsum-line.excise-base-acc      =  0
