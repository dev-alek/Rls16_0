     1694   end.
     1695   else do:
     1696     for each out-vatp_partscl where out-vatp_partscl.out-code   = pardoc-code
     1697                                  and out-vatp_partscl.obj-type   = parobj-type
     1698                                  and out-vatp_partscl.obj-code   = parobj-code
     1699                                  and out-vatp_partscl.artic      = parartic
     1700                                  and out-vatp_partscl.prod-type  = parprod-type
     1701                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
     1702       if out-vatp_partscl.purch-code = 2 then do:
     1703   assign
     1704     price-rubl-with-tax-lococl = out-vatp_partscl.price-rubl
     1705     price-base-with-tax-lococl = out-vatp_partscl.price-base
     1706   .
     1707   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
