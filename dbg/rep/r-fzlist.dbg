     3387   define variable gds-str2 as character no-undo.
     3388   define variable i as int no-undo.
     3389   define variable j as int no-undo.
     3390   define variable Counter1 as integer init 0  no-undo .
     3391   define variable LineBuf       as character    no-undo.
     3392   define variable Line       as character    no-undo.
     3393   define variable UndLine    as character    no-undo.
