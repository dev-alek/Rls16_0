     3403   define variable vv3 as character no-undo .
     3404   define variable vv4 as character no-undo .
     3405   define variable vv5 as character no-undo .
     3406   define variable vv6 as character no-undo .
     3407   define variable sym1 as character  init ":"   no-undo.
     3408   define variable sym2 as character  init ":"   no-undo.
     3409   define variable sym3 as character  init ":"   no-undo.
     3410   define variable sym4 as character  init ":"   no-undo.
     3411   define variable sym5 as character  init ":"   no-undo.
     3412   define variable sym6 as character  init ":"   no-undo.
     3413   define variable np as integer no-undo .
     3414   define variable p-cost as decimal no-undo .
     3415   define variable p-crsa as decimal no-undo .
     3416   define variable p-fact-date as character no-undo .
     3417   DEFINE FRAME plan-menu
     3418       sym1                format "X ( 1)" space ( 0)
     3419       np                  format ">>>>9" space ( 0)
     3420       sym2                format "X ( 1)" space ( 0)
     3421       trn-doc.doc-code    format "X ( 18)" space ( 0)
     3422       Sym3                format "X ( 1)" space ( 0)
     3423       p-fact-date         format "x ( 13)" space ( 0)
     3424       Sym4                format "X ( 1)" space ( 0)
     3425       p-cost              format "    >>>>>>>>>>>>>>9.99" space ( 0)
     3426       Sym5                format "X ( 1)" space ( 0)
     3427       p-crsa              format ">>>>>>>>>>>>>9.99" space ( 0)
     3428       Sym6                format "X ( 1)" space ( 0)
     3429       trn-doc.ps          format "X ( 37)" space ( 0)
     3430       HEADER
     3431       string (  "Лист " + string (  PAGE-NUMBER ( OutStream) , ">>>>9") ) AT 100 format "X ( 13)"
     3432       with width  235 down stream-io use-text NO-UNDERLINE  NO-BOX no-labels.
     3433     if session:set-wait-state ( "compiler") then.
     3434   output STREAM OutStream to value( string( session:temp-directory +
     3435                                        "rpt" + string( g#report-num ) ) )
     3436                                        page-size  value(ReportPageHeight) .
     3437     define variable v-prn0 as character no-undo .
     3438     assign
     3439       Line    = fill ( "-", 230)
     3440       UndLine = fill ( "_", 230)
     3441       LineBuf = fill ( "_", 240)
     3442     .
     3443     IF var-report-r-b = "rubl" THEN Assign PP = "Цены руб.".
     3444                          Else Assign PP = "Цены  баз.вал." .
     3445   define variable v-account as integer init 0 no-undo .
     3446   define variable v-account-lavel as character no-undo .
     3447   define variable v-button-stop as logical no-undo .
     3448   define variable v-kol-spice as integer no-undo .
     3449   define variable v-kol-spice2 as integer no-undo .
     3450   define variable v-kol-spice3 as integer no-undo .
     3451   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3452   DEFINE BUTTON StopBtn AUTO-END-KEY
     3453        LABEL "Стоп"
     3454        SIZE 10 BY 1.
     3455   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3456        LABEL "Обработано записей"
     3457         VIEW-AS TEXT
     3458        SIZE 14 BY .67 NO-UNDO.
     3459   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3460         VIEW-AS TEXT
     3461        SIZE 53.25 BY .67
     3462        FGCOLOR 1  NO-UNDO.
     3463   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3464         VIEW-AS TEXT
     3465        SIZE 53.25 BY .67
     3466        FGCOLOR 1  NO-UNDO.
     3467   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3468         VIEW-AS TEXT
     3469        SIZE 53.25 BY .67
     3470        FGCOLOR 1  NO-UNDO.
     3471   DEFINE RECTANGLE RECT-1
     3472        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3473        SIZE 55.13 BY 4.46.
     3474   DEFINE FRAME InfoFrame
     3475        StopBtn AT ROW 4.25 COL 21.75
     3476        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3477        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3478        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3479        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3480        RECT-1 AT ROW 1 COL 1
     3481       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3482            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3483            TITLE "Процесс"
     3484            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3485   define variable mFrameView      as logical   no-undo init yes.
     3486     define variable mFramHandle as handle no-undo.
     3487     mFramHandle = frame InfoFrame:handle.
     3488     if  log-manager:logfile-name ne ?
     3489     then DO:
     3490         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3491         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3492         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3493     end.
     3494     mFrameView = not session:batch-mode and mFramHandle:visible.
     3495     if mFrameView
     3496     then do:
     3497       ASSIGN
     3498          FRAME InfoFrame:HIDDEN                           = TRUE
     3499          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3500     end.
     3501   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3502   DO:
     3503     IF not StopProcessing THEN
     3504       Message "Вы действительно хотите прервать" SKIP
     3505               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3506                 UPDATE StopProcessing.
     3507     IF StopProcessing THEN do:
     3508        if mFrameView
     3509        then do:
     3510           HIDE FRAME InfoFrame.
     3511        end.
     3512     End.
     3513   END.
     3514   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     3515     if  log-manager:logfile-name ne ?
     3516     then DO:
     3517         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3518     end.
     3519     if not session:batch-mode then
     3520     do:
     3521       VIEW FRAME InfoFrame.
     3522       mFrameView = true.
     3523     end.
     3524      v-button-stop = false .
     3525         if mFrameView
     3526         then do:
     3527         if v-button-stop then view STOPBTN in frame InfoFrame.
     3528                          else Hide STOPBTN in frame InfoFrame.
     3529         end.
     3530   v-ind = 0    .
     3531   FORM with frame plan-menu .
     3532   for each obj-list no-lock :
     3533   s-cost = 0 .
     3534   s-crsa = 0 .
     3535   np = 0 .
     3536    if not can-find
     3537      (  first trn-doc  no-lock  where
     3538         trn-doc.status_   = 'факт':U           and
     3539         trn-doc.obj-type  = obj-list.obj-type and
     3540         trn-doc.obj-code  = obj-list.obj-code and
     3541         trn-doc.fact-date = x-date-alone      and
     3542         trn-doc.doc-type  = 'рас':U        and
     3543         trn-doc.internal  = true  )
     3544         then next.
     3545   vv0 = "+-----+--------------------------------+----------------------------------------+-------------------------------------+".
     3546   vv1 = ":     :    Заборный лист  ( накладная)   :            Сумма, руб.коп              :                                     :".
     3547   vv2 = ": n/n :------------------+-------------:----------------------+-----------------:            Примечание               :".
     3548   vv3 = ":     :      Номер       :    Дата     :По учетным ценам кухни:По ценам продажи :                                     :".
     3549   vv4 = "+-----+------------------+-------------+----------------------+-----------------+-------------------------------------+".
     3550   vv5 = ":  1  :        2         :      3      :           4          :        5        :                    6                :".
     3551   vv6 = "+-----+------------------+-------------+----------------------+-----------------+-------------------------------------+" .
     3552       Output stream Macr_Excel  close .
     3553       num#str# = 0 .
     3554       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     3555       output stream macr_excel to value ( v-file-name)   .
     3556       v-ind = v-ind + 1.
     3557    define variable col-doc as integer no-undo .
     3558     find this_object  where this_object.obj-type = obj-list.obj-type and this_object.obj-code = obj-list.obj-code  no-lock .
     3559     find clients      where clients.obj-type     = 'орг':U            and clients.obj-code      = v-cntxt-host-code-obj no-lock .
     3560     run PrintTitul in this-procedure .
     3561     for each trn-doc  no-lock  where
     3562         trn-doc.status_   = 'факт':U           and
     3563         trn-doc.obj-type  = obj-list.obj-type and
     3564         trn-doc.obj-code  = obj-list.obj-code and
     3565         trn-doc.fact-date = x-date-alone      and
     3566         trn-doc.doc-type  = 'рас':U        and
     3567         trn-doc.internal  = true             break by trn-doc.fact-order  :
     3568         run print-line in this-procedure .
     3569     end.
     3570     run print-all-itog in this-procedure .
     3571     run on-same-page in this-procedure  ( input 2) .
     3572     run PrintPodval in this-procedure .
     3573     run paramls-write in this-procedure
     3574        ( input "file"
     3575       ,input string ( v-ind) + obj-list.obj-name
     3576       ,input v-file-name
     3577       ) .
     3578        page stream OutStream .
     3579   end.
     3580   HIDE STREAM OutStream FRAME plan-menu.
     3581   HIDE stream OutStream FRAME BottomFrame .
     3582   HIDE stream OutStream FRAME BottomFrame2 .
     3583   output stream OutStream CLOSE .
     3584   Output stream Macr_Excel  close .
     3585   if mFrameView
     3586   then do:
     3587      HIDE FRAME InfoFrame.
     3588   end.
     3589       run paramls-write in this-procedure
     3590            ( input "charcol"
     3591           ,input ""
     3592           ,input "2"
     3593           ) .
     3594     run end-proc in this-procedure .
     3595     define variable v-user-action as character no-undo .
     3596     define variable v-printed as logical   no-undo .
     3597     define variable DisabledOptions as integer   no-undo .
     3598     DisabledOptions = 4 .
     3599     define variable v-orient-page as character no-undo .
     3600     run How-name in this-procedure (
     3601         input ReportPageHeight,
     3602         input ReportPageWidth,
     3603         output v-orient-page )
     3604         .
     3605     if v-orient-page = "A4-lans":U then DisabledOptions = 12 .
     3606                                    else DisabledOptions = 4 .
     3607     run gbl/prnfilen.w
     3608      ( input  ""
     3609       ,input  DisabledOptions
     3610       ,input  string ( session :temp-directory) + "rpt" + string (  g#report-num )
     3611       ,input ReportFontNum
     3612       ,output v-user-action
     3613       ,output v-printed
     3614       ) .
     3615   end.
     3616   procedure print-line :
     3617     do on error undo, return error return-value :
     3618   define variable r-exist as logical   no-undo .
     3619   p-crsa = 0 .
     3620   p-cost = 0 .
     3621    run calc-line-doc in this-procedure
     3622       (  input-output p-crsa ,
     3623        input-output p-cost ,
     3624        output r-exist
     3625        ).
     3626   if r-exist = false then return.
     3627   s-crsa = s-crsa + p-crsa .
     3628   s-cost = s-cost + p-cost .
     3629   Lines_Counter = Lines_Counter + 1 .
     3630     if line-counter (  OutStream ) + 2 > page-size (  OutStream ) then page stream OutStream.
     3631     if line-counter (  OutStream ) < Tmp_Counter then
     3632       assign
     3633       .
     3634     assign
     3635       Tmp_Counter  = line-counter (  OutStream )
     3636       num-ln = num-ln + 1
     3637       np = np + 1
     3638     .
     3639     if line-counter (  OutStream ) + j > page-size (  OutStream ) then  PAGE STREAM OutStream.
     3640   num#str# = num#str# + 1.
     3641   num#col# = 1.
     3642   run macr_excel_dec  in this-procedure  ( np                   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3643   run macr_excel_char in this-procedure  ( trn-doc.doc-code     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3644   run macr_excel_char in this-procedure  ( string ( trn-doc.fact-date, "99/99/9999" )    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3645   run macr_excel_dec  in this-procedure  ( p-cost                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3646   run macr_excel_dec  in this-procedure  ( p-crsa                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3647   run macr_excel_char in this-procedure  ( format-excel-text  (  trn-doc.ps )   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3648   display STREAM OutStream
     3649    sym1
     3650    np
     3651    sym2
     3652    trn-doc.doc-code
     3653    Sym3
     3654    string ( trn-doc.fact-date , "99/99/9999") @ p-fact-date
     3655    Sym4
     3656    p-cost
     3657    Sym5
     3658    p-crsa
     3659    Sym6
     3660    trn-doc.ps @ trn-doc.ps
     3661      with FRAME plan-menu.
     3662     DOWN stream OutStream 1 with FRAME plan-menu.
     3663     if print-graft = false THEN do:
     3664     underline stream OutStream
     3665         sym1
     3666         np
     3667         sym2
     3668         trn-doc.doc-code
     3669         Sym3
     3670         p-fact-date
     3671         Sym4
     3672         p-cost
     3673         Sym5
     3674         p-crsa
     3675         Sym6
     3676         trn-doc.ps
     3677       with FRAME plan-menu.
     3678     DOWN stream OutStream 1 with FRAME plan-menu.
     3679      end.
     3680     end.
     3681   end procedure.
     3682   procedure print-all-itog :
     3683     underline stream OutStream
     3684         sym1
     3685         np
     3686         sym2
     3687         trn-doc.doc-code
     3688         Sym3
     3689         p-fact-date
     3690         Sym4
     3691         p-cost
     3692         Sym5
     3693         p-crsa
     3694         Sym6
     3695         trn-doc.ps
     3696       with FRAME plan-menu.
     3697     DOWN stream OutStream 1 with FRAME plan-menu.
     3698   num#str# = num#str# + 1.
     3699   num#col# = 3.
     3700   run macr_excel_char in this-procedure  ( "ИТОГО"               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3701   run macr_excel_dec  in this-procedure  ( s-cost                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3702   run macr_excel_dec  in this-procedure  ( s-crsa                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3703   display STREAM OutStream
     3704    sym1
     3705    "ИТОГО"  @ trn-doc.doc-code
     3706    Sym4
     3707    s-cost @  p-cost
     3708    Sym5
     3709    s-crsa  @  p-crsa
     3710    Sym6
     3711      with FRAME plan-menu.
     3712     DOWN stream OutStream 1 with FRAME plan-menu.
     3713     underline stream OutStream
     3714         sym1
     3715         np
     3716         sym2
     3717         trn-doc.doc-code
     3718         Sym3
     3719         p-fact-date
     3720         Sym4
     3721         p-cost
     3722         Sym5
     3723         p-crsa
     3724         Sym6
     3725         trn-doc.ps
     3726       with FRAME plan-menu.
     3727     DOWN stream OutStream 1 with FRAME plan-menu.
     3728   end procedure.
     3729   procedure PrintTitul :
     3730     do  on error undo, return error return-value  :
     3731     define variable cc as integer no-undo .
     3732     define variable tt as integer no-undo .
     3733     define variable pp as integer no-undo .
     3734       case clients.obj-type:
     3735          when 'орг':U
     3736          then do:
     3737               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     3738               if available ub.firm
     3739               then do:
     3740                   assign
     3741                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     3742                       t-addres = t-addres
     3743                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     3744                               then ""
     3745                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     3746                             )
     3747                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     3748                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     3749                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     3750                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     3751                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     3752                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     3753                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     3754                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     3755                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     3756                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     3757                       t-phone = ub.firm.phone
     3758                       t-inn   = ub.firm.inn
     3759                       t-okpo  = ub.firm.okpo
     3760                   .
     3761               end.
     3762          end.
     3763          when 'маг':U
     3764          then do:
     3765               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     3766               if available ub.shop
     3767               then do:
     3768                   assign
     3769                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     3770                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     3771                       t-phone = shop.phone
     3772                       t-inn = ""
     3773                       t-okpo = ""
     3774                   .
     3775               end.
     3776          end.
     3777          when 'скл':U
     3778          then do:
     3779               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     3780               if available ub.store
     3781               then do:
     3782                   assign
     3783                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     3784                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     3785                       t-phone = ub.store.phone
     3786                       t-inn = ""
     3787                       t-okpo = ""
     3788                   .
     3789               end.
     3790          end.
     3791          when 'чел':U
     3792          then do:
     3793               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     3794               if available ub.person
     3795               then do:
     3796                   assign
     3797                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     3798                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     3799                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     3800                       t-phone = ub.person.phone1
     3801                       t-inn = ub.person.inn
     3802                       t-okpo = ub.person.okpo
     3803                   .
     3804               end.
     3805          end.
     3806       end case.
     3807   PUT STREAM OutStream UNFORMATTED
     3808   space ( 1) string (  "Унифицированная форма № ОП-7" )                                             "+--------------------------+" at 89  skip
     3809                                                                                                 "|                  | Коды  |" at 89  skip
     3810   space ( 5) string (  CAPS (      clients.obj-name ))                                                "|    Форма по ОКУД |0330507|" at 89  skip
     3811   space ( 5) string (  CAPS (  This_Object.obj-name ) + "  ( " + string ( This_Object.obj-code) + ")" )   "|          по ОКПО |       |" at 89  skip
     3812                                                                                                 "| Вид деятельности |       |" at 89  skip
     3813                                                                                                 "|          по ОКДП |       |" at 89  skip
     3814                                                                                                 "|     Вид операции |       |" at 89  skip
     3815                                                                                                 "+--------------------------+" at 89  skip.
     3816    PUT STREAM OutStream UNFORMATTED
     3817           space ( 5) caps  (  "Опись дневных заборных листов" ) +
     3818                    string (  " ЗА " )  + string ( x-date-alone, "99/99/9999" )
     3819                    format "X ( 100)"  skip
     3820                    "Дата составления " + cur-time-date ( ) at 89 skip
     3821         .
     3822     PUT STREAM OutStream UNFORMATTED
     3823           vv0  skip
     3824           vv1  skip
     3825           vv2 skip
     3826           vv3  skip
     3827           vv4  skip
     3828           vv5  skip
     3829           vv6 skip
     3830       .
     3831       run macr_cell_size  in this-procedure  (  15 , ? , 1 , 11 , 6, 11 ) .
     3832       run macr_cell_format  in this-procedure
     3833        (  8       ,
     3834         false   ,
     3835         false   ,
     3836         ?       ,
     3837         1  ,
     3838         11 ,
     3839         6  ,
     3840         12 ) .
     3841       num#str# = 1.
     3842       num#col# = 1.
     3843       run macr_excel_char in this-procedure  (  "Унифицированная форма № ОП-7" , num#str# , num#col#   ) .
     3844       num#col# = 12.
     3845       run macr_excel_char in this-procedure  (  "Коды" , num#str# , num#col#   ) .
     3846       num#str# = 2.
     3847       num#col# = 11.
     3848       run macr_excel_char in this-procedure  (  "Форма по ОКУД" , num#str# , num#col#   ) .
     3849       num#col# = 12.
     3850       run macr_excel_char in this-procedure  (  "0330507" , num#str# , num#col#   ) .
     3851       num#str# = 3.
     3852       num#col# = 11.
     3853       run macr_excel_char in this-procedure  (  "по ОКПО" , num#str# , num#col#   ) .
     3854       num#str# = 4.
     3855       num#col# = 11.
     3856       run macr_excel_char in this-procedure  (  "Вид деятельности по ОКДП" , num#str# , num#col#   ) .
     3857       num#str# = 5.
     3858       num#col# = 11.
     3859       run macr_excel_char in this-procedure  (  "Вид операции" , num#str# , num#col#   ) .
     3860       put  stream macr_excel unformatted
     3861       substitute ( 'select ( "r&1c&2:r&3c&4 ")' , 1 , 11 , 6 ,  11 ) + chr(10)  +
     3862       'ALIGNMENT ( 4 , , 4 , 4 ,)'  + chr(10)
     3863       .
     3864       put  stream macr_excel unformatted
     3865       substitute ( 'select ( "r&1c&2:r&3c&4 ")' , 1 , 12 , 6 ,  12 ) + chr(10)  +
     3866       'BORDER (  2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10)
     3867       .
     3868       num#str# = 3.
     3869       num#col# = 1.
     3870       cc = num#str# .
     3871       run macr_excel_char in this-procedure  (  caps (  "Опись дневных заборных листов" )  +
     3872                    string (  " ЗА " )  + string ( x-date-alone, "99/99/9999" )
     3873             , num#str# , num#col#   ) .
     3874       num#str# = num#str# + 2.
     3875       num#col# = 2.
     3876       run macr_excel_char in this-procedure  (   CAPS (  clients.obj-name)   , num#str# , num#col#   ) .
     3877       num#str# = num#str# + 1.
     3878       num#col# = 2.
     3879       run macr_excel_char in this-procedure  (  string (  CAPS (  This_Object.obj-name ) + "  ( " + string ( This_Object.obj-code) + ")" )   , num#str# , num#col#   ) .
     3880       run macr_cell_format in this-procedure
     3881        (  20    ,
     3882         true  ,
     3883         false  ,
     3884         ?    ,
     3885         cc ,
     3886         1 ,
     3887         num#str# ,
     3888         2 ) .
     3889       num#str# = num#str# + 1.
     3890       num#col# = 11.
     3891       run macr_excel_char in this-procedure  ( "Дата составления " + cur-time-date ( )   , num#str# , num#col#   ) .
     3892       num#str# = num#str# + 1.
     3893       num#col# = 1.
     3894       tt = num#str#  .
     3895       run macr_excel_char in this-procedure  (  "Номер по порядку"   , num#str# , num#col#   ) .
     3896       run macr_cell_size  in this-procedure  (  11 , ? , num#str# , num#col# , ?, ? ) .
     3897       num#col# = 2.
     3898       run macr_excel_char in this-procedure  (  "Номер заборного листа  ( накладной)"   , num#str# , num#col#   ) .
     3899       run macr_cell_size  in this-procedure  (  15 , ? , num#str# , num#col# , ?, ? ) .
     3900       num#col# = 3.
     3901       run macr_excel_char in this-procedure  (  "Дата заборного листа  ( накладной)"   , num#str# , num#col#   ) .
     3902       run macr_cell_size  in this-procedure  (  15 , ? , num#str# , num#col# , ?, ? ) .
     3903       num#col# = 4.
     3904       run macr_excel_char in this-procedure  (  "Сумма по учетным ценам кухни, руб"   , num#str# , num#col#   ) .
     3905       run macr_cell_size  in this-procedure  (  15 , ? , num#str# , num#col# , ?, ? ) .
     3906       num#col# = 5.
     3907       run macr_excel_char in this-procedure  (  "Сумма по ценам продажи, руб"   , num#str# , num#col#   ) .
     3908       run macr_cell_size  in this-procedure  (  15 , ? , num#str# , num#col# , ?, ? ) .
     3909       num#col# = 6.
     3910       run macr_excel_char in this-procedure  (  "Примечание"   , num#str# , num#col#   ) .
     3911       run macr_cell_size  in this-procedure  (  40 , ? , num#str# , num#col# , ?, ? ) .
     3912       run macr_cell_format in this-procedure
     3913        (  12    ,
     3914         true  ,
     3915         false  ,
     3916         ?    ,
     3917         Tt,
     3918         1 ,
     3919         num#str# ,
     3920         num#col# ) .
     3921        put  stream macr_excel unformatted
     3922          substitute ( 'select ( "r&1c&2:r&3c&4 ")' , tt , 1 , num#str# ,  num#col# ) + chr(10)  +
     3923          'BORDER (  2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     3924          'ALIGNMENT ( 3 , , 4 , 4 ,)'  + chr(10)
     3925          .
     3926     end.
     3927   end procedure.
     3928   procedure PrintPodval :
     3929     do on error undo, return error return-value  :
     3930     define variable pp as integer no-undo .
     3931     define variable rr as integer no-undo .
     3932       num#str# = num#str# + 2.
     3933       num#col# = 1.
     3934       run macr_excel_char in this-procedure  (  "Заведующий производством"   , num#str# , num#col#   ) .
     3935     PUT  STREAM OutStream " "
     3936           skip
     3937         " Заведующий производством _______________________ " skip
     3938         .
     3939     end.
     3940   end procedure.
     3941   PROCEDURE on-same-page :
     3942     define input parameter p-line-number as integer  no-undo .
     3943     if p-line-number > page-size (  OutStream ) then return .
     3944     if line-counter (  OutStream ) + p-line-number > page-size (  OutStream ) then  page stream OutStream .
     3945   end procedure.
     3946   procedure calc-line-doc :
     3947    do
     3948    on error undo, return error return-value
     3949    :
     3950   define input-output parameter    Rubl-NettoSaleSum  as decimal no-undo .
     3951   define input-output parameter    Rubl-CostSum       as decimal no-undo .
     3952   define output parameter r-exist as logical   no-undo .
     3953    r-exist = false .
     3954   define buffer buf_goods for goods.
     3955   define buffer buf_fbr-gds-obj for fbr-gds-obj.
     3956    assign
     3957       Rubl-NettoSaleSum  = 0
     3958       Rubl-CostSum       = 0
     3959    .
     3960    for each doc-line no-lock
     3961        where doc-line.doc-code = trn-doc.doc-code
     3962        :
     3963   find first buf_goods where
     3964               doc-line.artic     = buf_goods.artic      and
     3965               doc-line.prod-code = buf_goods.prod-code  and
     3966               doc-line.prod-type = buf_goods.prod-type  no-lock no-error .
     3967   if not available buf_goods then next.
     3968   find first buf_fbr-gds-obj  where
     3969                    buf_fbr-gds-obj.obj-type = trn-doc.obj-type
     3970               and  buf_fbr-gds-obj.obj-code = trn-doc.obj-code
     3971               and  buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     3972               and  ( buf_fbr-gds-obj.is-menu = true
     3973               or   buf_fbr-gds-obj.is-semi-finished = true )
     3974                   no-lock no-error .
     3975             if not available buf_fbr-gds-obj then next.
     3976                else r-exist = true .
     3977        run clcprtsl_calc-line in this-procedure  ( input recid  ( doc-line)).
     3978     find first tt-allsum-line where
     3979                tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     3980     if not available tt-allsum-line then do:
     3981     end.
     3982     else do:
     3983        if trn-doc.doc-type = 'при':U and trn-doc.internal = false  then
     3984         assign
     3985             Rubl-NettoSaleSum  = Rubl-NettoSaleSum  +  tt-allsum-line.sum-dsc-rubl-doc
     3986           .
     3987        else
     3988         assign
     3989             Rubl-NettoSaleSum  = Rubl-NettoSaleSum  +  tt-allsum-line.sum-dsc-rubl-cur
     3990             .
     3991        assign
     3992             Rubl-CostSum       = Rubl-CostSum       +  tt-allsum-line.sum-dsc-rubl-acc
     3993         .
     3994     end.
     3995   end.
     3996   assign
     3997     Rubl-NettoSaleSum  = round ( Rubl-NettoSaleSum  ,2)
     3998     Rubl-CostSum       = round ( Rubl-CostSum       ,2)
     3999   .
     4000    end.
     4001   end procedure.
     4002   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4003   procedure macr_excel_char :
     4004    do
     4005    on error undo, return error return-value
     4006    :
     4007    define input parameter  p-val as character no-undo .
     4008    define input parameter  p-row as integer no-undo .
     4009    define input parameter  p-col as integer no-undo .
     4010    if p-val = ? then p-val = "" .
     4011       put stream macr_excel unformatted
     4012             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4013    end.
     4014   end procedure.
     4015   procedure macr_excel_char_with_format :
     4016    do
     4017    on error undo, return error return-value
     4018    :
     4019    define input parameter  p-val as character no-undo .
     4020    define input parameter  p-row as integer no-undo .
     4021    define input parameter  p-col as integer no-undo .
     4022    if p-val = ? then p-val = "" .
     4023       put stream macr_excel unformatted
     4024             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4025       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     4026       put stream macr_excel unformatted
     4027             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4028    end.
     4029   end procedure.
     4030   procedure macr_excel_cell_format :
     4031    do
     4032    on error undo, return error return-value
     4033    :
     4034    define input parameter  p-val    as character no-undo .
     4035    define input parameter  p-row    as integer   no-undo .
     4036    define input parameter  p-col    as integer   no-undo .
     4037    define input parameter  p-format as character no-undo .
     4038    if p-val = ? then p-val = "" .
     4039       put stream macr_excel unformatted
     4040             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4041       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     4042       put stream macr_excel unformatted
     4043             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4044    end.
     4045   end procedure.
     4046   procedure macr_excel_sum :
     4047    do
     4048    on error undo, return error return-value
     4049    :
     4050    define input parameter  p-row as integer no-undo .
     4051    define input parameter  p-col as integer no-undo .
     4052    define input parameter  p-row1 as integer no-undo .
     4053    define input parameter  p-col1 as integer no-undo .
     4054    define input parameter  p-row2 as integer no-undo .
     4055    define input parameter  p-col2 as integer no-undo .
     4056       put stream macr_excel unformatted
     4057             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     4058    end.
     4059   end procedure.
     4060   procedure macr_excel_dec :
     4061    do
     4062    on error undo, return error return-value
     4063    :
     4064    define input parameter  p-val as character no-undo .
     4065    define input parameter  p-row as integer   no-undo .
     4066    define input parameter  p-col as integer   no-undo .
     4067     if p-val = ? then p-val =  "" .
     4068      put  stream macr_excel unformatted
     4069           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     4070    end.
     4071   end procedure.
     4072   procedure macr_cell_format :
     4073    do
     4074    on error undo, return error return-value
     4075    :
     4076    define input parameter  p-size   as integer   no-undo .
     4077    define input parameter  p-bold   as logical   no-undo .
     4078    define input parameter  p-italic as logical   no-undo .
     4079    define input parameter  p-color  as integer   no-undo .
     4080    define input parameter  p-row    as integer   no-undo .
     4081    define input parameter  p-col    as integer   no-undo .
     4082    define input parameter  p-row-2  as integer   no-undo .
     4083    define input parameter  p-col-2  as integer   no-undo .
     4084     if p-size = ? then p-size = 10 .
     4085     if p-bold = ? then p-bold = false .
     4086     if p-italic = ? then p-italic = false .
     4087     if p-row-2 = ? then p-row-2 = p-row .
     4088     if p-col-2 = ? then p-col-2 = p-col .
     4089     put  stream macr_excel unformatted
     4090      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     4091     if p-color <> ? then do:
     4092        put  stream macr_excel unformatted
     4093          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     4094     end.
     4095     put  stream macr_excel unformatted
     4096          substitute('format.font(,&1,&2,&3)' , p-size,
     4097                                           string ( p-bold  , "true/false" ) ,
     4098                                           string ( p-italic , "true/false" )
     4099                                           ) + chr(10) .
     4100    end.
     4101   end procedure.
     4102   procedure macr_cell_size :
     4103    do
     4104    on error undo, return error return-value
     4105    :
     4106    define input parameter  p-w   as integer   no-undo .
     4107    define input parameter  p-l   as integer   no-undo .
     4108    define input parameter  p-row    as integer   no-undo .
     4109    define input parameter  p-col    as integer   no-undo .
     4110    define input parameter  p-row-2  as integer   no-undo .
     4111    define input parameter  p-col-2  as integer   no-undo .
     4112     if p-row-2 = ? then p-row-2 = p-row .
     4113     if p-col-2 = ? then p-col-2 = p-col .
     4114     if p-w = ? then    p-w = 0 .
     4115     if p-l = ? then    p-l = 0 .
     4116    define variable s-w as character no-undo .
     4117    define variable s-l as character no-undo .
     4118    if p-w = 0 then s-w = "" .
     4119               else s-w = string(p-w)  .
     4120    if p-l = 0 then s-l = "" .
     4121               else s-l = string(p-l)  .
     4122   put  stream macr_excel unformatted
     4123        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     4124   put  stream macr_excel unformatted
     4125        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     4126   put  stream macr_excel unformatted
     4127        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     4128    end.
     4129   end procedure.
     4130   procedure proc-print-header :
     4131    do
     4132    on error undo, return error return-value
     4133    :
     4134      find first sheetf .
     4135        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     4136        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     4137        var-1 =  num#str# .
     4138        repeat c-c = 1 to sheetf.excel-row-title :
     4139        num#str# = num#str# + 1 .
     4140        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     4141        do c-i = 1 to p-var :
     4142           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     4143           str--2 = integer(entry( c-i, sheetf.sizes )) .
     4144           num#col# = c-i .
     4145           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     4146           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     4147        end.
     4148       c-i = 0.
     4149       end.
     4150       run macr_cell_format (
     4151           10       ,
     4152           true     ,
     4153           false    ,
     4154           35       ,
     4155           var-1 + 1,
     4156           1        ,
     4157           num#str# ,
     4158           num#col# )
     4159           .
     4160     put  stream macr_excel unformatted
     4161          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     4162          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4163          .
     4164    end.
     4165   end procedure.
     4166   procedure end-proc :
     4167    do
     4168    on error undo, return error return-value
     4169    :
     4170     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     4171     OUTPUT to VALUE (v-file-name) .
     4172     for each temp-param :
     4173       export  temp-param  .
     4174     end.
     4175    end.
     4176   end procedure.
