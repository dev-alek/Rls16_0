     3143   end procedure.
     3144   define temp-table temp-font no-undo
     3145     field fontnum  as integer
     3146     field fontname as character
     3147     field fontsize as character
     3148     field fonttype as character
     3149     field font-h   as integer
     3150     field font-w   as integer
     3151     field v-row    as integer
     3152     field v-col    as integer
     3153     field v-row-lans as integer
     3154     field v-col-lans as integer
     3155   index pi fontnum
     3156   .
     3157   procedure get-font-ini :
     3158     do
     3159     on error undo, return error return-value
     3160     :
     3161   define variable ii as integer   no-undo .
     3162   define variable v-font7 as character no-undo .
     3163   define variable v-font as character no-undo .
     3164   define variable loc-name as character no-undo .
     3165   define variable loc-size as character no-undo .
     3166   define variable loc-type as character no-undo .
     3167   define variable old_H as integer   no-undo .
     3168   define variable old_w as integer   no-undo .
     3169   define variable old-row  as integer   no-undo .
     3170   define variable old-col  as integer   no-undo .
     3171   define variable old-row-lans  as integer   no-undo .
     3172   define variable old-col-lans  as integer   no-undo .
     3173   define variable vv as integer   no-undo .
     3174   empty temp-table temp-font.
     3175     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     3176       case num-entries (v-font7) :
     3177         when 4 then do:
     3178             assign
     3179               loc-name = entry ( 1 , v-font7 )
     3180               loc-size = entry ( 2 , v-font7 )
     3181               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     3182             .
     3183         end.
     3184         when 3 then do:
     3185             assign
     3186               loc-name = entry ( 1 , v-font7 )
     3187               loc-size = entry ( 2 , v-font7 )
     3188               loc-type = entry ( 3 , v-font7 )
     3189             .
     3190         end.
     3191         when 2 then  do:
     3192             assign
     3193               loc-name = entry ( 1 , v-font7 )
     3194               loc-size = entry ( 2 , v-font7 )
     3195               loc-type = ""
     3196             .
     3197         end.
     3198         when 1 then do:
     3199             assign
     3200               loc-name = trim(entry ( 1 , v-font7 ))
     3201               loc-size = ""
     3202               loc-type = ""
     3203             .
     3204         end.
     3205       end case.
     3206     create temp-font.
     3207     assign
     3208       temp-font.fontnum  = 7
     3209       temp-font.fontname = trim(loc-name)
     3210       temp-font.fontsize = trim(loc-size)
     3211       temp-font.fonttype = trim(loc-type)
     3212       temp-font.v-row    = 62
     3213       temp-font.v-col    = 136
     3214       temp-font.v-row-lans = 43
     3215       temp-font.v-col-lans = 198
     3216     .
     3217     repeat ii = 16 to 100 :
     3218       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     3219       if v-font = "" or v-font = ? then leave.
     3220       case num-entries (v-font) :
     3221         when 4 then do:
     3222             assign
     3223               loc-name = entry ( 1 , v-font )
     3224               loc-size = entry ( 2 , v-font )
     3225               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     3226             .
     3227         end.
     3228         when 3 then do:
     3229             assign
     3230               loc-name = entry ( 1 , v-font )
     3231               loc-size = entry ( 2 , v-font )
     3232               loc-type = entry ( 3 , v-font )
     3233             .
     3234         end.
     3235         when 2 then do:
     3236             assign
     3237               loc-name = entry ( 1 , v-font )
     3238               loc-size = entry ( 2 , v-font )
     3239               loc-type = ""
     3240             .
     3241         end.
     3242         when 1 then do:
     3243             assign
     3244               loc-name = trim(entry ( 1 , v-font ))
     3245               loc-size = ""
     3246               loc-type = ""
     3247             .
     3248         end.
     3249       end case.
     3250     create temp-font.
     3251     assign
     3252       temp-font.fontnum  = ii
     3253       temp-font.fontname = trim(loc-name)
     3254       temp-font.fontsize = trim(loc-size)
     3255       temp-font.fonttype = trim(loc-type)
     3256     .
     3257     end.
     3258       for each temp-font :
     3259          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     3260          if  vv = ? then vv =  0 .
     3261           run rep/exfont.p (
     3262             input   temp-font.fontname ,
     3263             input   vv ,
     3264             input   temp-font.fonttype ,
     3265             output  temp-font.font-h   ,
     3266             output  temp-font.font-w   )
     3267           .
     3268       end.
     3269   find first temp-font where  temp-font.fontnum  = 7  .
     3270   old_H = temp-font.font-H .
     3271   old_w = temp-font.font-W .
     3272   old-row = temp-font.v-row .
     3273   old-col = temp-font.v-col .
     3274   old-row-lans = temp-font.v-row-lans .
     3275   old-col-lans = temp-font.v-col-lans .
     3276       for each temp-font where
     3277                temp-font.fontnum  <> 7 :
     3278           assign
     3279               temp-font.v-row    = old_H * old-row / temp-font.font-h
     3280               temp-font.v-col    = old_W * old-col / temp-font.font-W
     3281               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     3282               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     3283           .
     3284       end.
     3285     end.
     3286   end procedure.
     3287   PROCEDURE How-name :
     3288   define input  parameter h as integer no-undo .
     3289   define input  parameter w as integer no-undo .
     3290   define output parameter n as character  no-undo .
     3291   define variable A4port-H as integer   no-undo init 63.
     3292   define variable A4port-W as integer   no-undo init 136.
     3293   define variable A4lans-H as integer   no-undo init 43.
     3294   define variable A4lans-W as integer   no-undo init 198.
     3295   define variable Strim-W  as integer   no-undo init 278.
     3296   run define-a4-size (
     3297        input ReportFontNum
     3298       ,output A4port-H
     3299       ,output A4port-W
     3300       ,output A4lans-H
     3301       ,output A4lans-W ).
     3302   If w >= 1 and w <= A4port-W Then DO:
     3303     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3304     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     3305     If h > A4port-H              Then n = "to-file":U.
     3306   End.
     3307   If w > A4port-W and w <= A4lans-W Then DO:
     3308     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3309     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3310     If h > A4port-H              Then n = "to-file":U.
     3311   End.
     3312   If w > A4lans-W and w <= Strim-W Then DO:
     3313     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     3314     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3315     If h > A4port-H              Then n = "to-file":U.
     3316   End.
     3317   If w > Strim-W Then DO:
     3318      n = "to-file":U.
     3319   End.
     3320   END PROCEDURE.
     3321   PROCEDURE define-a4-size :
     3322   define input  parameter p-ReportFontNum as integer   no-undo .
     3323   define output parameter A4port-H as integer   no-undo .
     3324   define output parameter A4port-W as integer   no-undo .
     3325   define output parameter A4lans-H as integer   no-undo .
     3326   define output parameter A4lans-W as integer   no-undo .
     3327   if not can-find (first temp-font ) then do:
     3328      run get-font-ini .
     3329   end.
     3330   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     3331   if available temp-font then do:
     3332   assign
     3333     A4port-H = temp-font.v-row
     3334     A4port-W = temp-font.v-col
     3335     A4lans-H = temp-font.v-row-lans
     3336     A4lans-W = temp-font.v-col-lans
     3337   .
     3338   end.
     3339   else do:
     3340   assign
     3341     A4port-H = 63
     3342     A4port-W = 136
     3343     A4lans-H = 43
     3344     A4lans-W = 198
     3345   .
     3346   end.
     3347   END PROCEDURE.
