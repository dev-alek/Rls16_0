     1850     else do:
     1851       for each out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
     1852                                          out-vatp_gds-dtlcl.artic     = parartic     and
     1853                                          out-vatp_gds-dtlcl.prod-type = parprod-type and
     1854                                          out-vatp_gds-dtlcl.prod-code = parprod-code no-lock :
     1855         if varoutvprbcl = "base":u then do:
     1856           assign
     1857             varcurclprice-base = out-vatp_gds-dtlcl.cur-base
     1858             varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base * ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)).
     1859         end.
