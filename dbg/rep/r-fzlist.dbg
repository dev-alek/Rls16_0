      356   def
      357    shared
      358   temp-table  obj-list no-undo
      359     field obj-type like ub.clients.obj-type
      360     field obj-code like ub.clients.obj-code
      361     field obj-name like ub.clients.obj-name
      362     field obj-id   as integer
