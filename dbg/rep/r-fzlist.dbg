     1717     else do:
     1718       find first in-vatp_doc-attrocl no-lock
     1719         where in-vatp_doc-attrocl.doc-code  = out-vatp_partscl.out-code
     1720           and in-vatp_doc-attrocl.attr-code = 'envd':U
     1721         no-error .
