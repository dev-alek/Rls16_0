     3016   define buffer bf_tt-clcparts    for tt-clcparts.
     3017   define buffer bf_tt-allsum-line for tt-allsum-line.
     3018   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3019   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3020   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3021   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3022   define variable varexcise          like ub.price-list.excise     no-undo.
     3023   do on error undo, return error return-value :
     3024   for each bf_tt-allsum-line
     3025   on error undo, return error return-value
     3026    :
     3027     delete bf_tt-allsum-line.
