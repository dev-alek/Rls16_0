     2877             assign
     2878               varlastcur-base     = varprice-sale
     2879               varlastcur-road-tax = varroad-tax
     2880               varlastcur-excise   = varexcise
     2881               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2882               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2883               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2884               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2885             .
     2886         end.
     2887       end.
     2888       if varcur-fact-qnty = 0 then do:
     2889         assign
     2890           varcur-base      = varlastcur-base
     2891           varcur-road-tax  = varlastcur-road-tax
     2892           varcur-excise    = varlastcur-excise
     2893         .
     2894       end.
     2895       else do:
     2896         assign
     2897           varcur-base      = varcur-base      / varcur-fact-qnty
     2898           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2899           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2900         .
     2901       end.
