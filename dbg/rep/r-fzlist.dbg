     1687          and out-vatp_doc-linecl.artic      = parartic
     1688          and out-vatp_doc-linecl.prod-type  = parprod-type
     1689          and out-vatp_doc-linecl.prod-code  = parprod-code no-lock no-error.
     1690   if available out-vatp_doc-linecl           and
