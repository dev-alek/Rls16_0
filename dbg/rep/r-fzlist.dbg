     1511       define variable price-cli-without-tax-lococur  like ub.doc-line.price-base no-undo.
     1512       define variable vat-base-lococur               like ub.doc-line.price-base no-undo.
     1513       define variable vat-rubl-lococur               like ub.doc-line.price-rubl no-undo.
