      937       def var t-phone         like ub.firm.phone     no-undo.
      938       def var t-inn           like ub.firm.inn       no-undo.
      939       def var t-okpo          like ub.firm.okpo      no-undo.
      940       def var t-temp-address  like ub.firm.addres1   no-undo.
      941   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      942   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      943   procedure paramls-clear :
      944     define buffer buf_temp-param for temp-param .
      945     do
      946     on error undo, return error return-value
      947     :
      948       for each buf_temp-param
      949       on error undo, return error
      950       :
      951         delete buf_temp-param .
      952       end.
      953     end.
      954   end procedure.
      955   procedure paramls-write :
      956     define input  parameter p-code     as character no-undo .
      957     define input  parameter p-sub-code as character no-undo .
      958     define input  parameter p-value    as character no-undo .
      959     define buffer buf_temp-param for temp-param .
      960     do
      961     on error undo, return error return-value
      962     :
      963       find first buf_temp-param
      964         where buf_temp-param.param-code     = p-code
      965           and buf_temp-param.param-sub-code = p-sub-code
      966         no-error .
      967       if not available buf_temp-param then do:
      968         create buf_temp-param .
      969         assign
      970           buf_temp-param.param-code     = p-code
      971           buf_temp-param.param-sub-code = p-sub-code
      972         .
      973       end.
      974       assign
      975         buf_temp-param.param-value = p-value
      976       .
      977     end.
      978   end procedure.
      979   procedure paramls-read :
      980     define input  parameter p-code          as character no-undo .
      981     define input  parameter p-sub-code      as character no-undo .
      982     define input  parameter p-default-value as character no-undo .
      983     define output parameter p-value         as character no-undo .
      984     define buffer buf_temp-param for temp-param .
      985     do
      986     on error undo, return error return-value
      987     :
      988       find first buf_temp-param
      989         where buf_temp-param.param-code     = p-code
      990           and buf_temp-param.param-sub-code = p-sub-code
      991         no-error .
      992       if available buf_temp-param then do:
      993         assign
      994           p-value = buf_temp-param.param-value
      995         .
      996       end.
      997       else do:
      998         assign
      999           p-value = p-default-value
     1000         .
     1001       end.
     1002     end.
     1003   end procedure.
     1004   procedure paramls-append :
     1005     define input  parameter p-code     as character no-undo .
     1006     define input  parameter p-sub-code as character no-undo .
     1007     define input  parameter p-value    as character no-undo .
     1008     define buffer buf_temp-param for temp-param .
     1009     do
     1010     on error undo, return error return-value
     1011     :
     1012       find first buf_temp-param
     1013            where buf_temp-param.param-code     = p-code
     1014              and buf_temp-param.param-sub-code = p-sub-code
     1015         no-error .
     1016       if not available buf_temp-param then do:
     1017         create buf_temp-param .
     1018         assign
     1019           buf_temp-param.param-code     = p-code
     1020           buf_temp-param.param-sub-code = p-sub-code
     1021           buf_temp-param.param-value    = p-value
     1022         .
     1023       end.
     1024       else do:
     1025           assign
     1026               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1027           .
     1028       end.
     1029     end.
     1030   end procedure.
     1031   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1032     if num-entries(string(p-dec), '.') = 2
     1033       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1034       else return( string(p-dec)) .
     1035   end function.
     1036   function format-point-to-comma returns char (input orig as char ) .
     1037   define variable rtext as character no-undo .
     1038   define variable strt as integer no-undo .
     1039   define variable leng as integer no-undo .
     1040   assign rtext = orig .
     1041   repeat:
     1042     strt =  index(rtext,'.').
     1043     if strt = 0 then leave.
     1044     leng = 1.
     1045     substring(rtext,strt,leng,"character") = v-delim .
     1046   end.
     1047   return rtext.
     1048   end function.
     1049   function format-excel-text returns char ( input start-text as char ) :
     1050   def var  i    as int no-undo.
     1051   def var  ch   as char no-undo.
     1052   def var  n    as int no-undo.
     1053   def var  ipos as int no-undo.
     1054     n = num-entries(trim(start-text), chr(10)) - 1 .
     1055     do i = 1 to n :
     1056       ipos = index( start-text, chr(10)).
     1057       if ipos > 0 then
     1058         substr( start-text, ipos, 1 ) = ' '.
     1059     end.
     1060     n = num-entries(trim(start-text), chr(13)) - 1 .
     1061     do i = 1 to n :
     1062       ipos = index( start-text, chr(13)).
     1063       if ipos > 0 then
     1064         substr( start-text, ipos, 1 ) = ' '.
     1065     end.
     1066     if index( start-text, '"' ) = 0 then
     1067       start-text =  '="'   + trim( start-text) + '"'   .
     1068       else do:
     1069         n = num-entries(trim(start-text), '"') - 1.
     1070         do i = 1 to n :
     1071           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1072         end.
     1073         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1074         start-text = '="'  + ch  + '"' .
     1075       end.
     1076     return start-text.
     1077   end.
     1078   function excel-sum returns char (input p-dec as decimal ).
     1079     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1080   end function.
     1081   function excel-qnty returns char (input p-dec as decimal ).
     1082     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1083   end function.
     1084   function format-excel-text-macr returns char ( input start-text as char ) :
     1085   def var  i    as int no-undo.
     1086   def var  ch   as char no-undo.
     1087   def var  n    as int no-undo.
     1088   def var  ipos as int no-undo.
     1089     n = num-entries(trim(start-text), chr(10)) - 1 .
     1090     do i = 1 to n :
     1091       ipos = index( start-text, chr(10)).
     1092       if ipos > 0 then
     1093         substring( start-text, ipos , 1 ) = ' '.
     1094     end.
     1095     n = num-entries(trim(start-text), chr(13)) - 1 .
     1096     do i = 1 to n :
     1097       ipos = index( start-text, chr(13)).
     1098       if ipos > 0 then
     1099         substring( start-text, ipos, 1 ) = ' '.
     1100     end.
     1101     if index( start-text, '"' ) = 0 then
     1102       start-text =  '"'   + trim( start-text) + '"'   .
     1103       else do:
     1104         n = num-entries(trim(start-text), '"') - 1.
     1105         do i = 1 to n :
     1106           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1107         end.
     1108         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1109         start-text = '"'  + ch  + '"' .
     1110       end.
     1111     n = num-entries(trim(start-text), chr(10)) - 1 .
     1112     do i = 1 to n :
     1113       ipos = index( start-text, chr(10)).
     1114       if ipos > 0 then
     1115         substring( start-text, ipos , 1 ) = ' '.
     1116     end.
     1117       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1118     return start-text.
     1119   end.
