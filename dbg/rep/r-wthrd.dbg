      582   procedure wthcattr-sprcli :
      583   define input parameter parparentproc  as widget-handle no-undo.
      584   define input parameter p-mode  as character no-undo.
      585   define input-output parameter p-value as character no-undo .
      586   define output parameter p-setted as logical no-undo .
      587     DEFINE VARIABLE v-value as character no-undo .
      588     define variable v-cli-type as character no-undo .
      589     define variable v-cli-code as integer no-undo .
      590     define buffer buf_clients   for ub.clients.
      591     define variable v_rid as character no-undo.
      592     define variable ref-rec as recid no-undo .
      593     do
      594     on error undo, return error
      595     :
      596         v-value = p-value.
      597      if p-value <> '':U then do:
      598       assign
      599       v-cli-type = substring(p-value, 1, 3)
      600       v-cli-code = integer(substring(p-value, 4))
      601       no-error.
      602       if error-status:error then do:
      603         assign
      604         v-cli-type = '':U
      605         v-cli-code = 0
      606         .
      607       end.
      608      end.
      609      FIND FIRST buf_clients NO-LOCK WHERE
      610               buf_clients.obj-type = v-cli-type AND
      611               buf_clients.obj-code = v-cli-code  NO-ERROR.
      612      IF available(buf_clients) then do:
      613       run ref/cli-all.w (
      614                   input parparentproc
      615                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      616                  ,input v-cli-type
      617                  ,input 'все':U
      618                  ,input 'все':U
      619                  ,input RECID( buf_clients )
      620                  ,input ",,,,,,NO"
      621                  ,input ?
      622                  ,OUTPUT v_rid ).
      623     END.
      624     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      625       run ref/cli-all.w (
      626                    input parparentproc
      627                   ,INPUT "b-sel":U
      628                  ,input  v-cli-type
      629                  ,input 'все':U
      630                  ,input 'текущие':U
      631                  ,input ?
      632                  ,input ",,,,,,NO"
      633                  ,input ?
      634                  ,OUTPUT v_rid ).
      635     END.
      636     else do:
      637       message
      638       if p-value = "":U then 'Атрибут не задан!'
      639       else substitute('Не найден клиент &1',p-value)
      640       view-as alert-box warning.
      641     end.
      642     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      643       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      644       IF ERROR-STATUS:ERROR THEN DO:
      645           RETURN NO-APPLY.
      646       END.
      647       FIND FIRST buf_clients NO-LOCK WHERE
      648                  RECID( buf_clients ) = ref-rec NO-ERROR.
      649       IF AVAIL buf_clients THEN DO:
      650         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      651       end.
      652     end.
      653     if v-value <> p-value then do:
      654       p-value = v-value.
      655       p-setted = yes.
      656     end.
      657     end.
      658   end procedure.
      659     define new global shared variable g#wthcalib as handle no-undo.
      660   do on error undo, return error :
      661     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      662     ASSIGN parParentProc =  my-handle .
      663     define variable g#report-num as integer   no-undo .
      664     run get-report-num  in parParentProc ( output g#report-num ).
      665   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666     define variable v-cntxt-db-num        as integer   no-undo .
      667     define variable v-cntxt-userid        as character no-undo .
      668     define variable v-cntxt-level         as character no-undo .
      669     define variable v-cntxt-host-code-obj as integer   no-undo .
      670     define variable v-cntxt-obj-type      as character no-undo .
      671     define variable v-cntxt-obj-code      as integer   no-undo .
      672     define variable v-cntxt-db-num-obj    as integer   no-undo .
      673     define variable v-cntxt-is-admin      as logical   no-undo .
      674   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      675     run mainmenu_getcntxt in parparentproc
      676       (output v-cntxt-db-num
      677       ,output v-cntxt-userid
      678       ,output v-cntxt-level
      679       ,output v-cntxt-host-code-obj
      680       ,output v-cntxt-obj-type
      681       ,output v-cntxt-obj-code
