      937   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      938     (output var-report-r-b
      939     )  .
      940   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   define  stream PrnLibStream.
      942   procedure prn-lib-prn-file :
      943     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      944     define input parameter p-DIsabledoptions as integer no-undo .
      945     define variable v-report-name as character no-undo .
      946     define variable v-user-action as character no-undo .
      947     define variable v-printed     as logical   no-undo .
      948     define variable v-exist       as logical   no-undo .
      949     do
      950       on error undo, return error
      951       :
      952       run prn-lib-get-report-name  in this-procedure (
      953         input parParentProc
      954         ,output v-report-name
      955         ).
      956   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      958     (input  v-report-name
      959     ,input  2
      960     ,output v-exist
      961     )  .
      962       if NOT v-exist then
      963       DO:
      964         Message
      965           "Нет заданий на печать ! "
      966           view-as alert-box .
      967         Return  .
      968       End.
      969       run gbl/prnfilen.w
      970         (input  ""
      971         ,input  p-DisabledOptions
      972         ,input  string(v-report-name )
      973         ,input  7
      974         ,output v-user-action
      975         ,output v-printed
      976         ) .
      977       if v-printed then
      978       do:
      979         return "YES" .
      980       end.
      981       else
      982       do:
      983         return "NO" .
      984       end.
      985     end.
      986   end procedure.
      987   procedure prn-lib-open-stream :
      988     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      989     define input parameter p-page-size    as integer no-undo .
      990     define input parameter p-is-stream    as logical no-undo .
      991     define input parameter p-append       as logical no-undo .
      992     define variable v-report-name as character no-undo .
      993     do
      994       on error undo, return error
      995       :
      996       run prn-lib-get-report-name  in this-procedure (
      997         input parParentProc
      998         ,output v-report-name
      999         ).
     1000       if p-is-stream then
     1001       do:
     1002         if p-append then
     1003         do:
     1004           output stream PrnLibStream to value( v-report-name )
     1005             page-size value(p-page-size) append .
     1006         end.
     1007         if not p-append then
     1008         do:
     1009           output stream PrnLibStream to value( v-report-name )
     1010             page-size value(p-page-size) .
     1011         end.
     1012       end.
     1013       if not p-is-stream then
     1014       do:
     1015         if p-append then
     1016         do:
     1017           output to value( v-report-name )
     1018             page-size value(p-page-size) append .
     1019         end.
     1020         if not p-append then
     1021         do:
     1022           output to value( v-report-name )
     1023             page-size value(p-page-size) .
     1024         end.
     1025       end.
     1026     end.
     1027   end procedure.
     1028   procedure prn-lib-open-exp :
     1029     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1030     define input parameter p-is-stream    as logical no-undo .
     1031     define input parameter p-is-append    as logical no-undo .
     1032     define output parameter p-ReportFileName as char init "report" no-undo.
     1033     define output parameter p-process as logical no-undo .
     1034     define variable glog as logical no-undo .
     1035     do
     1036       on error undo, return error
     1037       :
     1038       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1039         TITLE      "Укажите путь"
     1040         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1041         ASK-OVERWRITE
     1042         CREATE-TEST-FILE
     1043         SAVE-AS
     1044         USE-FILENAME
     1045         DEFAULT-EXTENSION "txt"
     1046         UPDATE glog
     1047         .
     1048       if not glog then  return.
     1049       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1050       if p-is-stream then
     1051       do:
     1052         if p-is-append then
     1053         do:
     1054           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1055         end.
     1056         else
     1057         do:
     1058           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1059         end.
     1060       end.
     1061       else
     1062       do:
     1063         if p-is-append then
     1064         do:
     1065           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1066         end.
     1067         else
     1068         do:
     1069           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1070         end.
     1071       end.
     1072       p-process = yes.
     1073     end.
     1074   end procedure.
     1075   procedure prn-lib-get-report-name :
     1076     define input parameter parParentProc  as widget-handle no-undo.
     1077     define output parameter p-report-name as character no-undo .
     1078     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1079   end procedure.
     1080   procedure prn-lib-reportviewer-report-name :
     1081     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1082     define input parameter p-report-name-html as character no-undo .
     1083     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1084   end procedure.
     1085   procedure prn-lib-reportviewer :
     1086     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1087     define input parameter p-report-name-html as character no-undo .
     1088     define input parameter p-param        as character no-undo .
     1089     define variable v-excel           as character no-undo init 'TRUE' .
     1090     define variable v-value-character as character no-undo .
     1091     define variable v-value-integer   as character no-undo .
     1092     define variable v-value-date      as date      no-undo .
     1093     define variable v-value-decimal   as decimal   no-undo .
     1094     define variable rep-excel         as logical   no-undo .
     1095     define variable excel-string      as character no-undo .
     1096     define variable v-param-type      as character no-undo .
     1097     define variable v-tth             as handle    no-undo .
     1098     run adm/shattri.p (
     1099       input "get":U
     1100       ,input  ""
     1101       ,input  0
     1102       ,input  'report-glob':U
     1103       ,input  'rep-excel':U
     1104       ,output v-value-character
     1105       ,output v-value-date
     1106       ,output v-value-decimal
     1107       ,output v-value-integer
     1108       ,output rep-excel
     1109       ,output v-param-type
     1110       ,INPUT-OUTPUT table-handle v-tth
     1111       )  .
     1112     if rep-excel then v-excel = "TRUE" .
     1113     else v-excel = "FALSE" .
     1114     if p-param eq ""
     1115     then
     1116        p-param = "EXCEL:" + v-excel.
     1117     else
     1118        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1119     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1120   end procedure.
     1121   my-handle = parparentproc.
     1122   define variable g#report-num as integer no-undo .
     1123   procedure OpenForExcel :
     1124      define variable v-ch#ExcelApplication as com-handle no-undo .
     1125      define variable v-ch#Workbook         as com-handle no-undo .
     1126      define variable v-ch#Worksheet        as com-handle no-undo .
     1127      os-delete value( string( session:temp-directory ) +
     1128                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1129      os-delete value( string( session:temp-directory ) +
     1130                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1131      os-delete value( string( session:temp-directory ) +
     1132                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1133      if Make-Excel
     1134      then do:
     1135         output stream ForExcel to value( string( session:temp-directory +
     1136                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1137         assign
     1138            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1139            number-list = 1
     1140         .
     1141         if make-excel-com
     1142         then do:
     1143   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1144   if valid-handle(ch#WorkSheet) then
     1145   RELEASE OBJECT ch#WorkSheet no-error.
     1146   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1147   if valid-handle(ch#Workbook) then
     1148   RELEASE OBJECT ch#Workbook no-error.
     1149   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1150   if valid-handle(ch#ExcelApplication) then
     1151   RELEASE OBJECT ch#ExcelApplication no-error.
     1152            create "Excel.Application" ch#excelApplication connect no-error.
     1153            if error-status:error
     1154            then do :
     1155           create "Excel.Application" ch#excelApplication no-error.
     1156       if error-status :error then do:
     1157           message
     1158           "Ошибка при запуске Excel" skip
     1159           error-status :get-message(1) skip
     1160           view-as alert-box error .
     1161           undo, return error .
     1162       end.
     1163            end.
     1164            assign
     1165               num#str#  = 0.
     1166               v-ch#excelApplication  = ch#excelApplication.
     1167               v-ch#excelApplication:Interactive = false.
     1168               v-ch#excelApplication:ScreenUpdating = false.
     1169               v-ch#excelApplication:Visible = false.
     1170               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1171               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1172               v-ch#Worksheet = ch#WorkSheet.
     1173               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1174               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1175               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1176               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1177            no-error .
     1178            if error-status:error
     1179            then do:
     1180               Make-Excel-com = false .
     1181               Make-Excel = false .
     1182               output Stream  ForExcel close.
     1183               os-delete value( string( session:temp-directory ) +
     1184                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1185               os-delete value( string( session:temp-directory ) +
     1186                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1187               return.
     1188            end.
     1189         end.
     1190      end.
     1191   end.
     1192   procedure CloseForExcel :
     1193      define variable ii as integer no-undo .
     1194      define variable vsheet-num as integer no-undo.
     1195      if Make-Excel
     1196      then  do:
     1197         output Stream  ForExcel close.
     1198         os-delete value( string( session:temp-directory ) +
     1199                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1200         os-delete value( string( session:temp-directory ) +
     1201                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1202         define buffer buf_sheetf for sheetf.
     1203         find last buf_sheetf no-error .
     1204         if available buf_sheetf
     1205         then
     1206            vsheet-num = buf_sheetf.sheet-num.
     1207         if vsheet-num > 1
     1208         then do:
     1209            do ii = 2 to vsheet-num:
     1210               os-delete value( string( session:temp-directory ) +
     1211                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1212            end.
     1213         end.
     1214   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   if valid-handle(ch#WorkSheet) then
     1216   RELEASE OBJECT ch#WorkSheet no-error.
     1217   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1218   if valid-handle(ch#Workbook) then
     1219   RELEASE OBJECT ch#Workbook no-error.
     1220   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1221   if valid-handle(ch#ExcelApplication) then
     1222   RELEASE OBJECT ch#ExcelApplication no-error.
     1223      end.
     1224   end.
     1225   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   define variable v-waitfram-action01         as character   no-undo .
     1227   define variable v-waitfram-action02         as character   no-undo .
     1228   define variable v-waitfram-action03         as character   no-undo .
     1229   define variable mWaitFramTextBeg            as character   no-undo.
     1230   define variable mWaitFramTextEnd            as character   no-undo.
     1231   define variable mWaitFramView               as logical     no-undo.
     1232   define variable mWaitProcEvent              as logical     no-undo init yes.
     1233   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1234   define variable mWaitFramStop               as logical     no-undo.
     1235   define variable mWaitFramStopUser           as logical     no-undo.
     1236   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1237   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1238   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1239   define button B-WaitFramStop auto-end-key
     1240        label "Стоп"
     1241        size 10 by 1 tooltip "Остоновить процесс".
     1242   define button B-viewProcInfo
     1243        label "Информация"
     1244        size 15 by 1 tooltip "Информация о процесс".
     1245   define frame waitfram
     1246     v-waitfram-action01 format "x(72)" no-label skip
     1247     v-waitfram-action02 format "x(72)" no-label skip
     1248     v-waitfram-action03 format "x(72)" no-label skip
     1249     B-viewProcInfo
     1250     B-WaitFramStop at row 4 col 30
     1251     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1252     .
     1253   define new global shared variable mBatchMode as logical no-undo init ?.
     1254   define variable mFramBachModHandle as handle no-undo.
     1255   mFramBachModHandle = frame waitfram:handle.
     1256   define variable mFameOldVis as logical no-undo.
     1257   define variable mVisCUrentVin as logical no-undo.
     1258   if session:batch-mode
     1259   then
     1260      mBatchMode = yes.
     1261   if mBatchMode = ? then do:
     1262     mVisCUrentVin = current-window:visible.
     1263     mFameOldVis = mFramBachModHandle:visible.
     1264     mFramBachModHandle:visible  = yes.
     1265     mBatchMode = mFramBachModHandle:visible ne yes.
     1266     mFramBachModHandle:visible = mFameOldVis.
     1267     current-window:visible = mVisCUrentVin.
     1268   end.
     1269    if  log-manager:logfile-name ne ?
     1270     then DO:
     1271         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1272         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1273         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1274     end.
     1275   on choose of B-WaitFramStop in frame waitfram
     1276   do:
     1277     mWaitFramStop = yes.
     1278     mWaitFramStopUser = yes.
     1279   end.
     1280   function waitfram-check-timeout returns logical():
     1281      define variable vtime as int64 no-undo.
     1282      if mWaitFramStopTimeOut
     1283      then
     1284         return yes.
     1285      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1286      if     mWaitFramTimeOut ne ?
     1287         and mWaitFramTimeOut ne 0
     1288         and mWaitFramTimeOut lt vtime
     1289      then do:
     1290         mWaitFramStopTimeOut = yes.
     1291      end.
     1292      return mWaitFramStopTimeOut.
     1293   end.
     1294   procedure waitfram-hide :
     1295     if not session:batch-mode
     1296     then do
     1297     on error undo, return error return-value
     1298     :
     1299       pause 0 before-hide .
     1300       if not mBatchMode then
     1301         hide frame waitfram .
     1302     if     not mWaitFramView
     1303        and mWaitProcEvent
     1304     then
     1305       process events .
     1306     end.
     1307   end procedure.
     1308   procedure waitfram-show :
     1309     define input  parameter p-message as character no-undo .
     1310     define variable v-left-margin as integer   no-undo .
     1311     if not session:batch-mode
     1312     then do
     1313     on error undo, return error return-value
     1314     :
     1315       if length(p-message) <= 70 then do:
     1316         assign
     1317           v-left-margin = integer((70 - length(p-message)) / 2)
     1318         .
     1319         assign
     1320           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1321         .
     1322         assign
     1323           v-waitfram-action01 = " "
     1324           v-waitfram-action02 = " "
     1325                                    + fill(" ", v-left-margin)
     1326                                    + p-message
     1327           v-waitfram-action03 = " "
     1328         .
     1329       end.
     1330       else do:
     1331         define variable vRindex1 as integer no-undo.
     1332         define variable vRindex2 as integer no-undo.
     1333         vRindex1 = r-index(p-message," ",70).
     1334         if vRindex1 = 0
     1335         then
     1336            vRindex1 = 70.
     1337         if length(p-message)  <= vRindex1 + 70 then do:
     1338           assign
     1339             v-waitfram-action01 = " "
     1340             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1341             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1342           .
     1343         end.
     1344         else do:
     1345           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1346           if vRindex2 <= vRindex1
     1347           then
     1348              vRindex2 = vRindex1 + 70.
     1349           assign
     1350             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1351             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1352             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1353           .
     1354         end.
     1355       end.
     1356       B-viewProcInfo:visible   in frame waitfram = no.
     1357       B-viewProcInfo:sensitive in frame waitfram = no.
     1358       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1359       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1360       if  (   mWaitFramView
     1361          or  mWaitProcEvent)
     1362          and not mBatchMode
     1363       then
     1364          display
     1365             v-waitfram-action01 skip
     1366             v-waitfram-action02 skip
     1367             v-waitfram-action03 skip
     1368          with frame waitfram .
     1369       if     mWaitFramView
     1370          then do:
     1371             if     mWaitFramInterval ne ?
     1372                and not mBatchMode
     1373             then
     1374                wait-for go of frame waitfram pause mWaitFramInterval.
     1375          end.
     1376          else
     1377             if     mWaitProcEvent
     1378                and not mBatchMode
     1379             then
     1380                process events .
     1381     end.
     1382   end procedure.
     1383      procedure waitfram-show-this:
     1384         define input  parameter iInterval as int64 no-undo.
     1385         define variable vtime as int64 no-undo.
     1386         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1387         mWaitFramInterval = iInterval.
     1388         run waitfram-show (substitute("&1&2 &3&4" ,
     1389                                       mWaitFramTextBeg ,
     1390                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1391                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1392                                       mWaitFramTextEnd
     1393                                      )
     1394                           ).
     1395      end.
     1396      procedure WaitFramRunPause:
     1397         define input  parameter iInterval as dec no-undo.
     1398         define variable vStart  as datetime-tz no-undo.
     1399         define variable vend    as datetime-tz no-undo.
     1400         define variable vint as int64 no-undo.
     1401         define variable vOk as logical no-undo.
     1402         vStart = now.
     1403         vend   = vStart.
     1404         publish "WaitFramPause" (iInterval,output vOk).
     1405         vend   =  now.
     1406         vint = vend - vStart.
     1407         vint = iInterval - vint / 1000.
     1408         if     not mWaitFramStop
     1409            and (   vint > 0
     1410                 or (    not vOk
     1411                     and iInterval eq ?
     1412                     )
     1413                 )
     1414         then
     1415            run waitfram-show-this (iInterval).
     1416         vend   =  now.
     1417         vint = vend - vStart.
     1418         vint = iInterval - vint / 1000.
     1419         if     not mWaitFramStop
     1420            and vint > 0
     1421         then do:
     1422            run gbl/pause.p (vint * 1000).
     1423         end.
     1424         if iInterval ne ?
     1425         then
     1426            publish "WaitFramStop".
     1427         waitfram-check-timeout().
     1428      end.
     1429      procedure WaitFramWaitFor:
     1430         define input  parameter iInterval as dec no-undo.
     1431         assign
     1432            mWaitFramStartProc   = now
     1433            mWaitFramStopUser    = no
     1434            mWaitFramStopTimeOut = no
     1435         .
     1436         block-wait:
     1437         do while not mWaitFramStop:
     1438            run WaitFramRunPause (iInterval).
     1439            if  waitfram-check-timeout()
     1440            then do:
     1441               leave block-wait.
     1442            end.
     1443         end.
     1444         run waitfram-hide.
     1445      end.
     1446   procedure waitfram-join :
     1447     define input  parameter p-line-1  as character no-undo .
     1448     define input  parameter p-line-2  as character no-undo .
     1449     define input  parameter p-line-3  as character no-undo .
     1450     define output parameter p-message as character no-undo .
     1451     do
     1452     on error undo, return error return-value
     1453     :
     1454       assign
     1455         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1456                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1457                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1458       .
     1459     end.
     1460   end procedure.
     1461   function waitfram-join-function returns character
     1462     (input p-line-1 as character
     1463     ,input p-line-2 as character
     1464     ,input p-line-3 as character
     1465     ).
     1466     define variable v-message as character no-undo .
     1467     run waitfram-join in this-procedure
     1468       (input  p-line-1
     1469       ,input  p-line-2
     1470       ,input  p-line-3
     1471       ,output v-message
     1472       ) .
     1473     return v-message .
     1474   end function .
     1475   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1476   procedure alc-lib_mark-name :
     1477     define input  parameter p-mark-db-num   as integer   no-undo .
     1478     define input  parameter p-mark-code     as integer   no-undo .
     1479     define output parameter p-mark-name     as character no-undo .
     1480     define buffer buf_ex-mark for ub.ex-mark .
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484       if p-mark-db-num = ?
     1485       or p-mark-code   = ?
     1486       then do:
     1487         assign
     1488           p-mark-name = '?':u
     1489         .
     1490         return .
     1491       end.
     1492       if  p-mark-db-num = 0
     1493       and p-mark-code   = 0
     1494       then do:
     1495         assign
     1496           p-mark-name = ""
     1497         .
     1498         return .
     1499       end.
     1500       find first buf_ex-mark no-lock
     1501         where buf_ex-mark.db-num    = p-mark-db-num
     1502           and buf_ex-mark.mark-code = p-mark-code
     1503         no-error .
     1504       if available buf_ex-mark
     1505       then do:
     1506         assign
     1507           p-mark-name = substitute('&1':u
     1508                                   ,buf_ex-mark.mark-name
     1509                                   )
     1510         .
     1511       end.
     1512     end.
     1513   end procedure.
     1514   procedure alc-lib_get-new-part-code :
     1515     define input  parameter p-obj-type       as character no-undo .
     1516     define input  parameter p-obj-code       as integer   no-undo .
     1517     define input  parameter p-prod-type      as character no-undo .
     1518     define input  parameter p-prod-code      as integer   no-undo .
     1519     define input  parameter p-artic          as character no-undo .
     1520     define input  parameter p-doc-code       as character no-undo .
     1521     define output parameter p-new-part-code  as character no-undo .
     1522     define variable v-cur-part-code as integer no-undo.
     1523     define variable v-max-part-code as integer no-undo.
     1524     define variable i               as integer no-undo.
     1525     define buffer bf_parts for ub.parts .
     1526     do
     1527     on error undo, return error return-value
     1528     :
     1529       assign
     1530         v-max-part-code = 0
     1531       .
     1532       for each bf_parts no-lock
     1533             where bf_parts.obj-type  = p-obj-type  and
     1534                   bf_parts.obj-code  = p-obj-code  and
     1535                   bf_parts.prod-type = p-prod-type and
     1536                   bf_parts.prod-code = p-prod-code and
     1537                   bf_parts.artic     = p-artic     and
     1538                   bf_parts.out-code  = p-doc-code
     1539         :
     1540         assign
     1541           v-cur-part-code = integer(bf_parts.part-code)
     1542           no-error.
     1543         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     1544           assign
     1545             v-max-part-code = v-cur-part-code
     1546           .
     1547         end.
     1548       end.
     1549       assign
     1550         p-new-part-code = string (v-max-part-code + 1)
     1551       .
     1552     end.
     1553   end procedure.
     1554   DEFINE SHARED BUFFER s-parts FOR ub.parts.
     1555   DEFINE SHARED BUFFER s-goods FOR ub.goods.
     1556   DEFINE SHARED QUERY br-parts FOR s-parts, s-goods  SCROLLING.
     1557   define variable object as char no-undo.
     1558   define variable stat as char no-undo.
     1559   define variable p-code as char no-undo.
     1560   define variable price like ub.parts.price-rubl no-undo.
     1561   define variable stoim like ub.parts.price-rubl no-undo.
     1562   define variable tot-qnty like ub.parts.fact-qnty no-undo.
     1563   define variable tot-stoim like ub.parts.price-rubl no-undo.
     1564   define variable sym1 as char init ":"   no-undo.
     1565   define variable sym2 as char init ":"   no-undo.
     1566   define variable sym3 as char init ":"   no-undo.
     1567   define variable sym4 as char init ":"   no-undo.
     1568   define variable sym5 as char init ":"   no-undo.
     1569   define variable sym6 as char init ":"   no-undo.
     1570   define variable sym7 as char init ":"   no-undo.
     1571   define variable sym8 as char init ":"   no-undo.
     1572   define variable sym9 as char init ":"   no-undo.
     1573   define variable Line as char no-undo.
     1574   define variable v-base-code  like ub.sysconf.base-code no-undo .
     1575   define variable v-host-code like ub.sysconf.host-code no-undo .
     1576   define buffer buf_currency for ub.currency.
     1577   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1579     (input  p-curr-obj-type
     1580     ,input  p-curr-obj-code
     1581     ,output v-host-code
     1582     )  .
     1583   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1585     (input  v-host-code
     1586     ,output v-base-code
     1587     )  .
     1588   find first buf_currency no-lock where
     1589            buf_currency.curr-code = v-base-code .
     1590   if v-base-code <> 0 then
     1591       message "Печатать в РУБЛЯХ ?" VIEW-AS ALERT-BOX QUESTION BUTTONS yes-no TITLE "" UPDATE PrintRubl.
     1592   else
     1593       assign PrintRubl = yes .
     1594   assign
     1595   sheetf.Excel-Column-Lable =  "Артикул,Название,Объект,Факт кол-во,Статус,Партия,Цена,Стоимость"
     1596   sheetf.sizes = "16,30,10,13,16,14,14,14"
     1597   sheetf.colformat = chr(4) + "1=@"
     1598   Make-Excel = yes
     1599   reportname = titl
     1600   str3 = "Цены и суммы указаны в " + (if PrintRubl then "руб" else buf_currency.curr-abbr)
     1601   .
     1602   run get-report-num in parparentproc(output g#report-num).
     1603   DEFINE FRAME supp-gds
     1604         sym1 column-label ":" format "X(1)" space(0)
     1605         s-parts.artic COLUMN-LABEL "Артикул" FORMAT "x(16)"  space(0)
     1606         sym2 column-label ":" format "X(1)" space(0)
     1607         s-goods.gds-name COLUMN-LABEL "Название" FORMAT "x(30)"  space(0)
     1608         sym3 column-label ":" format "X(1)" space(0)
     1609         object COLUMN-LABEL "Объект" FORMAT "x(10)"  space(0)
     1610         sym4 column-label ":" format "X(1)" space(0)
     1611         s-parts.fact-qnty COLUMN-LABEL "Факт кол-во " FORMAT "->>>,>>9.<<<" space(0)
     1612         sym5 column-label ":" format "X(1)" space(0)
     1613         stat COLUMN-LABEL "Статус" FORMAT "x(16)" space(0)
     1614         sym6 column-label ":" format "X(1)" space(0)
     1615         p-code COLUMN-LABEL "Партия" FORMAT "x(14)" space(0)
     1616         sym7 column-label ":" format "X(1)" space(0)
     1617         price COLUMN-LABEL "Цена" FORMAT "->>,>>>,>>9.99" space(0)
     1618         sym8 column-label ":" format "X(1)" space(0)
     1619         stoim COLUMN-LABEL "Стоимость" FORMAT "->>,>>>,>>9.999" space(0)
     1620         sym9 column-label ":" format "X(1)" space(0)
     1621       HEADER
     1622           cur-time-print() AT 5 format "X(35)"
     1623           string( str3  ) AT 45 format "X(35)"
     1624           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 120 format "X(13)" SKIP
     1625           Line format "X(136)" AT 1
     1626       with width 232 down stream-io.
     1627   run waitfram-show in this-procedure ('Подождите ...' ) .
     1628   if session:set-wait-state("COMPILER") then.
     1629   assign Line = fill("-", 232).
     1630   run prn-lib-open-stream  in this-procedure (
     1631                                                input parParentProc
     1632                                               ,input 62
     1633                                               ,input yes
     1634                                               ,input no
     1635                                               ).
     1636   RUN OpenForExcel in this-procedure .
     1637   DO WHILE available s-parts :
     1638       GET prev br-parts.
     1639   END.
     1640   PUT STREAM PrnLibStream titl AT 10 format "X(136)" SKIP.
     1641   run rep/extitle.p (1).
     1642   GET next br-parts.
     1643   DO WHILE available s-parts :
     1644       if PrintRubl then
     1645           assign price = s-parts.price-rubl.
     1646       else
     1647           assign price = s-parts.price-base.
     1648       assign stoim = price * s-parts.fact-qnty.
     1649       DISPLAY STREAM PrnLibStream
     1650           sym1 s-parts.artic
     1651           sym2 s-goods.gds-name
     1652           sym3 (s-parts.obj-type + " " + STRING (s-parts.obj-code)) @ object
     1653           sym4 s-parts.fact-qnty
     1654           sym5 get-parts-out-code (buffer s-parts) @ stat
     1655           sym6 (if s-parts.part-code = "" then "------" else s-parts.part-code) @ p-code
     1656           sym7 price
     1657           sym8 stoim
     1658           sym9
     1659           with FRAME supp-gds .
     1660       DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     1661       if Make-Excel then  put   stream ForExcel unformatted
     1662       s-parts.artic                                                               CHR(9)
     1663       s-goods.gds-name                                                            CHR(9)
     1664       (s-parts.obj-type + " " + STRING (s-parts.obj-code))                        CHR(9)
     1665       s-parts.fact-qnty                                                           CHR(9)
     1666       get-parts-out-code (buffer s-parts)                                         CHR(9)
     1667       (if s-parts.part-code = "" then "------" else s-parts.part-code)            CHR(9)
     1668       price                                                                       CHR(9)
     1669       stoim
     1670       skip.
     1671       assign
     1672           tot-qnty = tot-qnty + s-parts.fact-qnty
     1673           tot-stoim = tot-stoim + stoim
     1674           .
     1675       GET next br-parts.
     1676   END.
     1677   PUT STREAM PrnLibStream Line format "X(136)" SKIP.
     1678   DISPLAY STREAM PrnLibStream
     1679       "Итого :" @ object
     1680       tot-qnty @ s-parts.fact-qnty
     1681       tot-stoim @ stoim
     1682       with FRAME supp-gds .
     1683   DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     1684   if Make-Excel then  put   stream ForExcel unformatted
     1685                    CHR(9)
     1686                    CHR(9)
     1687   "Итого :"        CHR(9)
     1688   tot-qnty         CHR(9)
     1689                    CHR(9)
     1690                    CHR(9)
     1691                    CHR(9)
     1692   tot-stoim
     1693   skip.
     1694   output STREAM PrnLibStream CLOSE.
     1695   if Make-Excel then output stream ForExcel close.
     1696   run waitfram-hide in this-procedure .
     1697   if session:set-wait-state("") then.
     1698   run prn-lib-prn-file in this-procedure (
     1699                                             input parParentProc
     1700                                             ,input 0
     1701                                             ).
