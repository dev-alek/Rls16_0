      302   FUNCTION get-parts-part-code RETURNS CHARACTER
      303     ( BUFFER buf_parts FOR ub.parts
      304     , INPUT p-goods-alcohol-prod AS LOGICAL
      305     ) :
      306     define variable v-show-part-code as character no-undo .
      307     if (p-goods-alcohol-prod = false) and (buf_parts.part-code = '':u)
      308     then do:
      309       return '------':u .
      310     end.
      311     run partsfnc_get-parts-show-code in this-procedure
      312       (input  buf_parts.part-code
      313       ,input  buf_parts.mark-db-num
      314       ,input  buf_parts.mark-code
      315       ,input  buf_parts.alc-bottling-date
      316       ,input  p-goods-alcohol-prod
      317       ,output v-show-part-code
      318       ) .
      319     return v-show-part-code .
      320   END FUNCTION.
      321   procedure partsfnc_get-parts-show-code :
      322     define input  parameter p-part-code          as character no-undo .
      323     define input  parameter p-mark-db-num        as integer   no-undo .
      324     define input  parameter p-mark-code          as integer   no-undo .
      325     define input  parameter p-alc-bottling-date  as date      no-undo .
      326     define input  parameter p-goods-alcohol-prod as logical   no-undo .
      327     define output parameter p-show-code          as character no-undo .
      328     define variable v-alc-mark-name as character no-undo .
      329     do
      330     on error undo, return error return-value
      331     :
      332       assign
      333         p-show-code = '':u
      334       .
      335       if p-goods-alcohol-prod = true
      336       then do:
      337         run alc-lib_mark-name in this-procedure
      338           (input  p-mark-db-num
      339           ,input  p-mark-code
      340           ,output v-alc-mark-name
      341           ) .
      342         assign
      343           p-show-code = substitute('&1,&2':u
      344                                   ,v-alc-mark-name
      345                                   ,string(p-alc-bottling-date,'99/99/9999':u)
      346                                   )
      347         .
      348       end.
      349       else do:
      350         assign
      351           p-show-code = p-part-code
      352         .
      353       end.
      354       return '':u .
      355     end.
      356   end procedure.
      357   FUNCTION get-parts-out-code RETURNS CHARACTER
      358     ( BUFFER buf_parts FOR ub.parts ) :
      359     case buf_parts.out-code :
      360       when 'free-zone':U then do:
      361         return "свободно" .
      362       end.
      363       when 'out-zone':U then do:
      364         return "расход" .
      365       end.
      366       otherwise do:
      367         if buf_parts.doc-type = 'акт':U then do:
      368           return caps("ЦН") + " № " + buf_parts.out-code .
      369         end.
      370         else do:
      371           define variable v-ext-name       as character no-undo .
      372           define variable v-trn-doc-status as character no-undo .
      373           define buffer buf_trn-doc for ub.trn-doc .
      374           find first buf_trn-doc no-lock
      375             where buf_trn-doc.doc-code = buf_parts.out-code
      376             no-error .
      377           if available buf_trn-doc then do:
      378   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run docextnm in g#library
      380     (input  buf_parts.out-code
      381     ,output v-ext-name
      382     )  .
      383             assign
      384               v-trn-doc-status = (if buf_trn-doc.status_ = 'факт':U then 'факт':U else "")
      385             .
      386           end.
      387           else do:
      388             assign
      389               v-ext-name       = caps(substring(buf_parts.doc-type, 1, 1))
      390               v-trn-doc-status = (if buf_parts.status_ = ? then 'факт':U else "")
      391             .
      392           end.
      393           return substitute("&1 № &2 &3"
      394              ,v-ext-name
      395              ,buf_parts.out-code
      396              ,v-trn-doc-status
      397              ) .
      398         end.
      399       end.
      400     end case .
      401     return "".
      402   END FUNCTION.
      403   FUNCTION get-parts-cli-qnty RETURNS DECIMAL
      404     ( BUFFER buf_parts FOR ub.parts
      405     , INPUT p-goods-twounit AS LOGICAL
      406     ) :
      407     if p-goods-twounit then do:
      408       RETURN buf_parts.cli-qnty .
      409     end.
      410     else do:
      411       RETURN buf_parts.fact-qnty / buf_parts.cli-base-rate .
      412     end.
      413     RETURN ? .
      414   END FUNCTION.
      415   FUNCTION get-parts-cli-base-rate RETURNS DECIMAL
      416     ( BUFFER buf_parts FOR ub.parts
      417     , INPUT p-goods-twounit AS LOGICAL
      418     ) :
      419     if p-goods-twounit then do:
      420       RETURN buf_parts.fact-qnty / buf_parts.cli-qnty .
      421     end.
      422     else do:
      423       RETURN buf_parts.cli-base-rate .
      424     end.
      425     RETURN ? .
      426   END FUNCTION.
