      500   procedure create_obj-list :
      501      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      502      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      503      do
      504      on error undo, return error return-value
      505      :
      506         define buffer cli-obj for ub.clients .
      507         define variable p-var as integer no-undo .
      508         define buffer buf_obj-list for obj-list .
      509         find last buf_obj-list  use-index pi no-error .
      510         if available buf_obj-list
      511         then
      512            p-var = buf_obj-list.obj-id + 1.
      513         else
      514            p-var = 1.
      515         find first cli-obj where
      516                   cli-obj.obj-type = p-obj-type
      517               and cli-obj.obj-code = p-obj-code
      518         no-lock no-error.
      519         if available cli-obj
      520         then do:
      521            create buf_obj-list.
      522            assign
      523               buf_obj-list.obj-id   = p-var
      524               buf_obj-list.obj-code = cli-obj.obj-code
      525               buf_obj-list.obj-type = cli-obj.obj-type
      526               buf_obj-list.obj-name = cli-obj.obj-name
      527               buf_obj-list.db-num   = cli-obj.db-num
      528            .
      529         end.
      530      end.
      531   end.
