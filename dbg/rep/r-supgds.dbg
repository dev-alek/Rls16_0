      488   def
      489   new shared
      490   temp-table  obj-list no-undo
      491     field obj-type like ub.clients.obj-type
      492     field obj-code like ub.clients.obj-code
      493     field obj-name like ub.clients.obj-name
      494     field obj-id   as integer
