     1013   procedure cp-attr-delete :
     1014     do
     1015     on error undo, return error
     1016     :
     1017       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1018       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1019       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1020       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1021       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1022       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1023       define output parameter p-deleted  as logical no-undo.
     1024       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1025       define variable v-type           as character no-undo .
     1026       define variable v-format         as character no-undo .
     1027       define variable v-label          as character no-undo .
     1028       define variable v-range          as integer   no-undo .
     1029       define variable v-user-can-edit  as logical   no-undo .
     1030       define variable v-output-display as logical   no-undo .
     1031       define variable v-other          as character no-undo .
     1032       run cp-attr-code in this-procedure
     1033         (input  p-code
     1034         ,output v-type
     1035         ,output v-format
     1036         ,output v-label
     1037         ,output v-range
     1038         ,output v-user-can-edit
     1039         ,output v-output-display
     1040         ,output v-other
     1041         ) no-error .
     1042       if error-status :error then do:
     1043         undo, return error return-value .
     1044       end.
     1045       find first buf_cash-pay-attr exclusive-lock
     1046         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1047           and buf_cash-pay-attr.curr-code  = p-curr-code
     1048           and buf_cash-pay-attr.host-code  = p-host-code
     1049           and buf_cash-pay-attr.obj-type   = p-obj-type
     1050           and buf_cash-pay-attr.obj-code   = p-obj-code
     1051           and buf_cash-pay-attr.attr-code = p-code
     1052         no-error NO-WAIT.
     1053       if not available buf_cash-pay-attr then do:
     1054         p-deleted = no.
     1055       end.
     1056       else do:
     1057         delete buf_cash-pay-attr no-error .
     1058         if error-status:error then do:
     1059           undo, return error return-value .
     1060         end.
     1061         p-deleted = yes.
     1062       end.
     1063     end.
     1064   end procedure.
     1065   procedure cp-attr-news :
     1066     do
     1067     on error undo, return error
     1068     :
     1069       define input  parameter p-code           as character no-undo .
     1070       define output parameter p-news           as logical   no-undo .
     1071       case p-code :
     1072               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1073               when 'grp-code':U then do:     assign     p-news = true.   end.
     1074               when 'is-use':U then do:     assign     p-news = true.   end.
     1075               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1076               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1077               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1078               when 'form_km3':U then do:     assign     p-news = false.   end.
     1079               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1080               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1081               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1082         otherwise do:
     1083           p-news = no.
     1084         end.
     1085       end.
     1086     end.
     1087   end procedure.
