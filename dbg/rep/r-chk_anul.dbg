     1161   procedure prn-lib-open-stream :
     1162     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1163     define input parameter p-page-size    as integer no-undo .
     1164     define input parameter p-is-stream    as logical no-undo .
     1165     define input parameter p-append       as logical no-undo .
     1166     define variable v-report-name as character no-undo .
     1167     do
     1168       on error undo, return error
     1169       :
     1170       run prn-lib-get-report-name  in this-procedure (
     1171         input parParentProc
     1172         ,output v-report-name
     1173         ).
     1174       if p-is-stream then
     1175       do:
     1176         if p-append then
     1177         do:
     1178           output stream PrnLibStream to value( v-report-name )
     1179             page-size value(p-page-size) append .
     1180         end.
     1181         if not p-append then
     1182         do:
     1183           output stream PrnLibStream to value( v-report-name )
     1184             page-size value(p-page-size) .
     1185         end.
     1186       end.
     1187       if not p-is-stream then
     1188       do:
     1189         if p-append then
     1190         do:
     1191           output to value( v-report-name )
     1192             page-size value(p-page-size) append .
     1193         end.
     1194         if not p-append then
     1195         do:
     1196           output to value( v-report-name )
     1197             page-size value(p-page-size) .
     1198         end.
     1199       end.
     1200     end.
     1201   end procedure.
     1202   procedure prn-lib-open-exp :
     1203     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1204     define input parameter p-is-stream    as logical no-undo .
     1205     define input parameter p-is-append    as logical no-undo .
     1206     define output parameter p-ReportFileName as char init "report" no-undo.
     1207     define output parameter p-process as logical no-undo .
     1208     define variable glog as logical no-undo .
     1209     do
     1210       on error undo, return error
     1211       :
     1212       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1213         TITLE      "Укажите путь"
     1214         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1215         ASK-OVERWRITE
     1216         CREATE-TEST-FILE
     1217         SAVE-AS
     1218         USE-FILENAME
     1219         DEFAULT-EXTENSION "txt"
     1220         UPDATE glog
     1221         .
     1222       if not glog then  return.
     1223       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1224       if p-is-stream then
     1225       do:
     1226         if p-is-append then
     1227         do:
     1228           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1229         end.
     1230         else
     1231         do:
     1232           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1233         end.
     1234       end.
     1235       else
     1236       do:
     1237         if p-is-append then
     1238         do:
     1239           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1240         end.
     1241         else
     1242         do:
     1243           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1244         end.
     1245       end.
     1246       p-process = yes.
     1247     end.
     1248   end procedure.
     1249   procedure prn-lib-get-report-name :
     1250     define input parameter parParentProc  as widget-handle no-undo.
     1251     define output parameter p-report-name as character no-undo .
     1252     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1253   end procedure.
     1254   procedure prn-lib-reportviewer-report-name :
     1255     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1256     define input parameter p-report-name-html as character no-undo .
