     1000       find first buf_cash-pay-attr exclusive-lock
     1001         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1002           and buf_cash-pay-attr.curr-code  = p-curr-code
     1003           and buf_cash-pay-attr.host-code  = p-host-code
     1004           and buf_cash-pay-attr.obj-type   = p-obj-type
     1005           and buf_cash-pay-attr.obj-code   = p-obj-code
     1006           and buf_cash-pay-attr.attr-code = p-code
