      567   define variable var-report-r-b as character no-undo .
      568   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      570     (output var-report-r-b
      571     )  .
      572   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      574   define  shared variable RepPathName        as character no-undo .
      575   define  shared variable PrintRubl          as logical   no-undo .
      576   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   procedure cur-time :
      579      define output parameter p-today as date      no-undo .
      580      define output parameter p-time  as integer   no-undo .
      581     do
      582     on error undo, return error
      583     :
      584       define variable v-date1 as date      no-undo .
      585       define variable v-date2 as date      no-undo .
      586       define variable v-time  as integer   no-undo .
      587       assign
      588         v-date1 = today
      589         v-time  = time
      590         v-date2 = today
      591       .
      592       if v-date1 <> v-date2
      593       then do:
      594         assign
      595           v-date1 = today
      596           v-time  = v-time
      597         .
      598       end.
      599       assign
      600         p-today = v-date1
      601         p-time  = v-time
      602       .
      603     end.
      604   end.
      605   function cur-time-date returns character
      606   :
      607     return string(today, '99/99/9999':U) .
      608   end.
      609   function cur-time-mjd returns decimal
      610   :
      611     define variable v-date as date      no-undo .
      612     define variable v-time as integer   no-undo .
      613     run cur-time in this-procedure
      614       (output v-date
      615       ,output v-time
      616       ) .
      617     return integer(v-date) - 2400002 + (v-time / 86400) .
      618   end.
      619   function cur-time-get-ending-index returns integer
      620   (input p-number as integer
      621   )
      622   :
      623     if p-number < 0
      624     or p-number = ?
      625     then do:
      626       return 1 .
      627     end.
      628     define variable v-rest as integer   no-undo .
      629     assign
      630       p-number = p-number modulo 100
      631     .
      632     if p-number < 20
      633     then do:
      634       assign
      635         v-rest = p-number
      636       .
      637     end.
      638     else do:
      639       assign
      640         v-rest = p-number modulo 10
      641       .
      642     end.
      643     case v-rest :
      644       when 1
      645       then do:
      646         return 2 .
      647       end.
      648       when 2 or
      649       when 3 or
      650       when 4
      651       then do:
      652         return 3 .
      653       end.
      654       otherwise do:
      655         return 1 .
      656       end.
      657     end case .
      658   end.
      659   procedure cur-time-mjd-to-date :
      660      define input  parameter i-mjd-diff as decimal no-undo.
      661      define output parameter o-Date     as date    no-undo.
      662      define output parameter o-Time     as integer no-undo.
      663      define variable v-day-number as integer   no-undo .
      664      if    i-mjd-diff < 0
      665         or i-mjd-diff = ?
      666      then do:
      667         return "?" .
      668      end.
      669      assign
      670         v-day-number = truncate(i-mjd-diff,0).
      671         o-Date = date(v-day-number + 2400002).
      672         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      673     .
      674   end.
      675   function cur-time-mjd-to-string returns character
      676   (input p-mjd-diff as decimal
      677   )
      678   :
      679     define variable v-day-number as integer   no-undo .
      680     define variable v-seconds    as integer   no-undo .
      681     define variable v-hour       as integer   no-undo .
      682     define variable v-min        as integer   no-undo .
      683     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      684     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      685     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      686     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      687     if p-mjd-diff < 0
      688     or p-mjd-diff = ?
      689     then do:
      690       return "?" .
      691     end.
      692     assign
      693       v-day-number = integer(truncate(p-mjd-diff,0))
      694       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      695     .
      696     if v-seconds > 86400
      697     then do:
      698       assign
      699         v-seconds = 86400 - 1
      700       .
      701     end.
      702     if v-seconds < 0
      703     then do:
      704       assign
      705         v-seconds = 0
      706       .
      707     end.
      708     assign
      709       v-hour = truncate(v-seconds / 3600, 0)
      710     .
      711     assign
      712       v-seconds = v-seconds modulo 3600
      713     .
      714     assign
      715       v-min = truncate(v-seconds / 60, 0)
      716     .
      717     assign
      718       v-seconds = v-seconds modulo 60
      719     .
      720     return
      721         (if v-day-number <> 0
      722           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      723           else ""
      724         )
      725       + (if v-day-number <> 0 or v-hour <> 0
      726           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      727           else ""
      728         )
      729       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      730           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      731           else ""
      732         )
      733       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      734       .
      735   end.
      736   function cur-time-string returns character
      737   :
      738     define variable v-date as date      no-undo .
      739     define variable v-time as integer   no-undo .
      740     run cur-time in this-procedure
      741       (output v-date
      742       ,output v-time
      743       ) .
      744     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      745   end.
      746   function cur-time-string-sec returns character
      747   :
      748     define variable v-date as date      no-undo .
      749     define variable v-time as integer   no-undo .
      750     run cur-time in this-procedure
      751       (output v-date
      752       ,output v-time
      753       ) .
      754     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      755   end.
      756   function cur-time-custom  returns character
      757   (input p-prefix as character
      758   ,input p-date-format as character
      759   ,input p-delimiter as character
      760   ,input p-time-format as character
      761   ,input p-suffix as character
      762   )
      763   :
      764     define variable v-date as date      no-undo .
      765     define variable v-time as integer   no-undo .
      766     run cur-time in this-procedure
      767       (output v-date
      768       ,output v-time
      769       ) .
      770     return
      771       p-prefix
      772       + string(v-date, p-date-format)
      773       + p-delimiter
      774       + string(v-time, p-time-format)
      775       + p-suffix
      776       .
      777   end.
      778   function cur-time-print  returns character
      779   :
      780     define variable v-date as date      no-undo .
      781     define variable v-time as integer   no-undo .
      782     run cur-time in this-procedure
      783       (output v-date
      784       ,output v-time
      785       ) .
      786     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      787   end.
      788   function cur-time-datetime returns datetime
      789   :
      790     define variable v-char as character no-undo .
      791     define variable v-datetime as datetime no-undo .
      792     v-char = cur-time-string().
      793     v-datetime = datetime(v-char).
      794     return  v-datetime.
      795   end.
      796   function cur-time-string-msec returns character
      797   :
      798     define variable v-date as datetime  no-undo .
      799     v-date = now.
      800     return string(v-date) .
      801   end.
      802   procedure cp-attr-code :
      803     do
      804     on error undo, return error
      805     :
      806       define input  parameter p-code           as character no-undo .
      807       define output parameter p-type           as character no-undo .
      808       define output parameter p-format         as character no-undo .
      809       define output parameter p-label          as character no-undo .
      810       define output parameter p-range          as integer   no-undo .
      811       define output parameter p-user-can-edit  as logical   no-undo .
      812       define output parameter p-output-display as logical   no-undo .
      813       define output parameter p-other          as character no-undo .
      814       case p-code :
      815               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      816               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      817               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      818               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      819               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      820               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      821               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      822               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      823               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      824               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      825         otherwise do:
      826           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      827         end.
      828       end.
      829     end.
      830   end procedure.
      831   procedure cp-attr-tooltip :
      832     do
      833     on error undo, return error
      834     :
      835       define input  parameter p-code    as character no-undo .
      836       define output parameter p-tooltip as character no-undo .
      837       define output parameter p-label   as character no-undo .
      838       case p-code :
      839               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      840               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      841               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      842               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      843               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      844               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      845               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      846               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      847               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      848               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      849         otherwise do:
      850           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      851         end.
      852       end.
      853     end.
      854   end procedure.
      855   procedure cp-attr-value :
      856     do
      857     on error undo, return error
      858     :
      859       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      860       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      861       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      862       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      863       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      864       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      865       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      866       define output parameter p-type        as character no-undo .
      867       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      868       define variable v-format         as character no-undo .
      869       define variable v-label          as character no-undo .
      870       define variable v-range          as integer   no-undo .
      871       define variable v-user-can-edit  as logical   no-undo .
      872       define variable v-output-display as logical   no-undo .
      873       define variable v-other          as character no-undo .
      874       run cp-attr-code in this-procedure
      875         (input  p-code
      876         ,output p-type
      877         ,output v-format
      878         ,output v-label
      879         ,output v-range
      880         ,output v-user-can-edit
      881         ,output v-output-display
      882         ,output v-other
      883         ) no-error .
      884       if error-status :error then do:
      885         undo, return error return-value .
      886       end.
      887       find first buf_cash-pay-attr no-lock
      888         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      889           and buf_cash-pay-attr.curr-code  = p-curr-code
      890           and buf_cash-pay-attr.host-code  = p-host-code
      891           and buf_cash-pay-attr.obj-type   = p-obj-type
      892           and buf_cash-pay-attr.obj-code   = p-obj-code
      893           and buf_cash-pay-attr.attr-code  = p-code
      894         no-error .
      895       if avail buf_cash-pay-attr then do:
      896         assign
      897           p-value =  buf_cash-pay-attr.attr-value
      898         .
      899       end.
      900       else do:
      901         assign
      902           p-value = if p-type = 'L':U then "no":U else ""
      903         .
      904       end.
      905     end.
      906   end procedure.
      907   procedure cp-attr-write :
      908     do
      909     on error undo, return error
      910     :
      911       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      912       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      913       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      914       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      915       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      916       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      917       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      918       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      919       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      920       define variable v-type           as character no-undo .
      921       define variable v-format         as character no-undo .
      922       define variable v-label          as character no-undo .
      923       define variable v-range          as integer   no-undo .
      924       define variable v-user-can-edit  as logical   no-undo .
      925       define variable v-output-display as logical   no-undo .
      926       define variable v-other          as character no-undo .
      927       run cp-attr-code in this-procedure
      928         (input  p-code
      929         ,output v-type
      930         ,output v-format
      931         ,output v-label
      932         ,output v-range
      933         ,output v-user-can-edit
      934         ,output v-output-display
      935         ,output v-other
      936         ) no-error .
      937       if error-status :error then do:
      938         undo, return error return-value .
      939       end.
      940       find first buf_cash-pay-attr exclusive-lock
      941         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      942           and buf_cash-pay-attr.curr-code  = p-curr-code
      943           and buf_cash-pay-attr.host-code  = p-host-code
      944           and buf_cash-pay-attr.obj-type   = p-obj-type
      945           and buf_cash-pay-attr.obj-code   = p-obj-code
      946           and buf_cash-pay-attr.attr-code = p-code
      947         no-error .
      948       if not available buf_cash-pay-attr then do:
      949         create buf_cash-pay-attr .
      950         assign
      951         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      952         buf_cash-pay-attr.curr-code  = p-curr-code
      953         buf_cash-pay-attr.host-code  = p-host-code
      954         buf_cash-pay-attr.obj-type   = p-obj-type
      955         buf_cash-pay-attr.obj-code   = p-obj-code
      956         buf_cash-pay-attr.attr-code = p-code
      957         .
      958       end.
      959       assign
      960         buf_cash-pay-attr.attr-value = p-value
      961       .
      962       release buf_cash-pay-attr no-error .
      963       if error-status:error then do:
      964         undo, return error return-value .
      965       end.
      966     end.
      967   end procedure.
      968   procedure cp-attr-exist :
