     1259   procedure prn-lib-reportviewer :
     1260     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1261     define input parameter p-report-name-html as character no-undo .
     1262     define input parameter p-param        as character no-undo .
     1263     define variable v-excel           as character no-undo init 'TRUE' .
     1264     define variable v-value-character as character no-undo .
     1265     define variable v-value-integer   as character no-undo .
     1266     define variable v-value-date      as date      no-undo .
     1267     define variable v-value-decimal   as decimal   no-undo .
     1268     define variable rep-excel         as logical   no-undo .
     1269     define variable excel-string      as character no-undo .
     1270     define variable v-param-type      as character no-undo .
     1271     define variable v-tth             as handle    no-undo .
     1272     run adm/shattri.p (
     1273       input "get":U
     1274       ,input  ""
     1275       ,input  0
     1276       ,input  'report-glob':U
     1277       ,input  'rep-excel':U
     1278       ,output v-value-character
     1279       ,output v-value-date
     1280       ,output v-value-decimal
     1281       ,output v-value-integer
     1282       ,output rep-excel
     1283       ,output v-param-type
     1284       ,INPUT-OUTPUT table-handle v-tth
     1285       )  .
     1286     if rep-excel then v-excel = "TRUE" .
     1287     else v-excel = "FALSE" .
     1288     if p-param eq ""
     1289     then
     1290        p-param = "EXCEL:" + v-excel.
     1291     else
     1292        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1293     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1294   end procedure.
     1295   function fnc-convert-dot-to-colon returns character
     1296       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1297   function fnc-convert-dot-to-colon returns character
     1298   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1299       define variable result as character no-undo.
     1300       define variable v-str-result as character no-undo.
     1301       if p-data = ? then p-data = 0 .
     1302       p-data = round(p-data, p-num).
     1303       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1304       return v-str-result.
     1305   END FUNCTION.
