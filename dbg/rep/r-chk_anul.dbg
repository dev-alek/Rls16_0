     1415           , output v-time
     1416           ).
     1417       v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     1418       for each obj-list no-lock:
     1419           if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     1420           else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     1421           if x-TOG-Shift then
     1422           do:
     1423               for each buf_chk-doc no-lock
     1424                   where buf_chk-doc.obj-code = obj-list.obj-code
     1425                   and buf_chk-doc.obj-type = obj-list.obj-type
     1426                   and buf_chk-doc.shift-date >= x-Date-Start
     1427                   and buf_chk-doc.shift-date <= x-Date-End
     1428                   and (buf_chk-doc.chk-type = integer('1':U)
     1429                   or buf_chk-doc.chk-type = integer('6':U)
     1430                   or buf_chk-doc.chk-type = integer('96':U))
     1431                       :
     1432                   if (buf_chk-doc.shift-date = X-date-Start)
     1433                       and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     1434                   if (buf_chk-doc.shift-date = X-date-End)
     1435                       and (buf_chk-doc.shift-num > x-Shift-End) then next.
     1436                   run report .
     1437               end.
     1438           end.
     1439           else
     1440           do:
     1441               for each buf_chk-doc no-lock
     1442                   where buf_chk-doc.obj-code = obj-list.obj-code
     1443                   and buf_chk-doc.obj-type = obj-list.obj-type
     1444                   and buf_chk-doc.chk-date >= x-Date-Start
     1445                   and buf_chk-doc.chk-date <= x-Date-End
     1446                   and (buf_chk-doc.chk-type = integer('1':U)
     1447                   or buf_chk-doc.chk-type = integer('6':U)
     1448                   or buf_chk-doc.chk-type = integer('96':U))
     1449                   :
     1450                   run report .
     1451               end.
     1452           end.
     1453     end.
     1454       run get-report-num (output p-report-id).
     1455       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1456       ii = 0 .
     1457       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1458       put stream OutStr-html unformatted
     1459           "<!DOCTYPE HTML>" skip
     1460           ' <html>' skip
     1461           '  <head>' skip
     1462           '   <meta charset="utf-8">' skip
     1463           '    <style type="text/css">' skip
     1464           '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1465           '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1466           '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1467           '   </style>' skip
     1468           '  </head>' skip
     1469           .
     1470       put stream OutStr-html unformatted
     1471           '<body>' skip
     1472           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1473           '<thead>' skip
     1474           .
     1475       put stream OutStr-html unformatted
     1476           '<tr class="set_columns">' skip
     1477           '<td style="width: 100px;"></td>' skip
     1478           '<td style="width: 100px;"></td>' skip
     1479           '<td style="width: 100px;"></td>' skip
     1480           '<td style="width: 100px;"></td>' skip
     1481           '<td style="width: 100px;"></td>' skip
     1482           '<td style="width: 150px;"></td>' skip
     1483           '<td style="width: 200px;"></td>' skip
     1484           '<td style="width: 200px;"></td>' skip
     1485           '<td style="width: 100px;"></td>' skip
     1486           '</tr>' skip
     1487           .
     1488       put stream OutStr-html unformatted
     1489           '<TR><TD colspan="9"></TD></TR>' skip
     1490           '<TR>' skip
     1491           '<TD colspan="9" style="font-weight: bold;">Отчет по аннуляции строки/отмене товара</TD>' skip
     1492           '</TR>'skip
     1493           '<TR>' skip
     1494           '<TD colspan="9">' + v-period + '</TD>' skip
     1495           '</TR>'skip
     1496           '<TR>' skip
     1497           '<TD colspan="9">' + v-obj-name + '</TD>' skip
     1498           '</TR>'skip
     1499           '<TR>' skip
     1500           '<TD colspan="9">Выбор объекта:</TD>' skip
     1501           '</TR>'skip
     1502           '<TR>' skip
     1503           '<TD colspan="9">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     1504           '</TR>'skip
     1505           '<TR>' skip
     1506           '<TD colspan="9">' + v-print-date + '</TD>' skip
     1507           '</TR>'skip
     1508           .
     1509       put stream OutStr-html unformatted
     1510           '</thead>' skip
     1511           '<tbody>' skip
     1512           .
     1513       put stream OutStr-html unformatted
     1514           '<TR>' skip
     1515           '<TD text_wrap="true" style="text-align: center;">№ смены</TD>' skip
     1516           '<TD text_wrap="true" style="text-align: center;">Дата смены</TD>' skip
     1517           '<TD text_wrap="true" style="text-align: center;">№ кассы</TD>' skip
     1518           '<TD text_wrap="true" style="text-align: center;">№ чека</TD>' skip
     1519           '<TD text_wrap="true" style="text-align: center;">Код товара</TD>' skip
     1520           '<TD text_wrap="true" style="text-align: center;">Наименование товара</TD>' skip
     1521           '<TD text_wrap="true" style="text-align: center;">Кол-во отмененных/аннулированных позиций в чеке</TD>' skip
     1522           '<TD text_wrap="true" style="text-align: center;">Сумма отмененных/аннулированных позиций в чеке</TD>' skip
     1523           '<TD text_wrap="true" style="text-align: center;">Кассир</TD>' skip
     1524           '</TR>'skip
     1525           .
     1526       if p-casier then do:
     1527       for each buf_tt-check by buf_tt-check.cashier by buf_tt-check.shift-date :
     1528           if v-cashier <> buf_tt-check.cashier then do:
     1529           put stream OutStr-html unformatted
     1530               '<TR>' skip
     1531               '<TD text_wrap="true" colspan = "9" style="text-align: left;">' + string(buf_tt-check.cashier) + '</TD>' skip
     1532               '</TR>'skip
     1533               .
     1534           end.
     1535           v-cashier = buf_tt-check.cashier .
     1536           put stream OutStr-html unformatted
     1537               '<TR>' skip
     1538               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.shift-num) + '</TD>' skip
     1539               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.shift-date) + '</TD>' skip
     1540               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.cash-num) + '</TD>' skip
     1541               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.chk-num) + '</TD>' skip
     1542               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.gds-code) + '</TD>' skip
     1543               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.gds-name) + '</TD>' skip
     1544               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.chk-qnty) + '</TD>' skip
     1545               '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(decimal(buf_tt-check.chk-sum),"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(decimal(buf_tt-check.chk-sum),"->>>>>>>>>>>9.99",2) + '</TD>' skip
     1546               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.cashier) + '</TD>' skip
     1547               '</TR>'skip
     1548               .
     1549       end.
     1550       end.
     1551       else do:
     1552       for each buf_tt-check by buf_tt-check.shift-date:
     1553           put stream OutStr-html unformatted
     1554               '<TR>' skip
     1555               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.shift-num) + '</TD>' skip
     1556               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.shift-date) + '</TD>' skip
     1557               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.cash-num) + '</TD>' skip
     1558               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.chk-num) + '</TD>' skip
     1559               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.gds-code) + '</TD>' skip
     1560               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.gds-name) + '</TD>' skip
     1561               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.chk-qnty) + '</TD>' skip
     1562               '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(decimal(buf_tt-check.chk-sum),"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(decimal(buf_tt-check.chk-sum),"->>>>>>>>>>>9.99",2) + '</TD>' skip
     1563               '<TD text_wrap="true" style="text-align: center;">' + string(buf_tt-check.cashier) + '</TD>' skip
     1564               '</TR>'skip
     1565               .
     1566       end.
     1567       end.
     1568           put stream OutStr-html unformatted
     1569               '</table>' skip
     1570               '</body>' skip
     1571               '</html>' skip
     1572               .
     1573           output stream OutStr-html close.
     1574           run prn-lib-reportviewer-report-name in this-procedure (
     1575               input THIS-PROCEDURE
     1576               ,input v-file-name-rep-htm
     1577               ).
     1578   end .
     1579   function GDSName returns character
     1580           (input p-gds-code as integer):
     1581   define variable result as character no-undo.
     1582   find first ub.goods no-lock where ub.goods.gds-code = p-gds-code no-error .
     1583   if available (ub.goods) then result = ub.goods.gds-name .
     1584   else result = "" .
     1585   return result.
     1586   end function.
     1587   function CashName returns character
     1588           (input p-cash-code as integer):
     1589   define variable result as character no-undo.
     1590   define buffer buf_clients for ub.clients .
     1591   define buffer buf_staff for ub.staff .
     1592   find first buf_staff no-lock where buf_staff.staff-code = p-cash-code
     1593                                  and buf_staff.role = 'C':U no-error .
     1594   if AVAILABLE (buf_staff) then do:
     1595       find first buf_clients no-lock where buf_clients.obj-code = buf_staff.psn-code
     1596                                        and buf_clients.obj-type = 'чел':U no-error .
     1597       result = buf_clients.obj-name .
     1598   end.
     1599   return result.
     1600   end function.
     1601   PROCEDURE get-report-num :
     1602       define output parameter p-report-num as integer no-undo .
     1603       do
     1604           on error undo, return error return-value
     1605           :
     1606           run gbl/getrpnum.p (output p-report-num).
     1607       end.
     1608   END PROCEDURE.
     1609   procedure report:
     1610       for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code:
     1611           if buf_chk-doc.chk-type <> integer('1':U) and buf_chk-gds.doc-qnty > 0 then do:
     1612               create tt-check .
     1613           assign
     1614               tt-check.obj-code    = buf_chk-doc.obj-code
     1615               tt-check.chk-date    = buf_chk-doc.chk-date
     1616               tt-check.chk-type    = buf_chk-doc.chk-type
     1617               tt-check.shift-num   = string(buf_chk-doc.shift-num)
     1618               tt-check.shift-date  = string(buf_chk-doc.shift-date)
     1619               tt-check.cash-num    = buf_chk-doc.pay-desk
     1620               tt-check.chk-num     = string(buf_chk-doc.doc-code)
     1621               tt-check.num-z       = buf_chk-doc.z-number
     1622               tt-check.time-chk    = string(buf_chk-doc.chk-date,"99.99.9999") + " " + string(buf_chk-doc.chk-time,"HH:MM:SS")
     1623               tt-check.gds-code    = buf_chk-gds.b-code
     1624               .
     1625               tt-check.gds-name    = GDSName(tt-check.gds-code) .
     1626               .
     1627               tt-check.cashier    = CashName(buf_chk-doc.cashier) .
     1628               tt-check.chk-sum     = "-" + string(buf_chk-gds.sum-base) .
     1629               tt-check.chk-qnty    = "-" + string(buf_chk-gds.doc-qnty) .
     1630           end.
     1631           if buf_chk-doc.chk-type = integer('1':U) and buf_chk-gds.doc-qnty < 0 then do:
     1632           create tt-check .
     1633           assign
     1634               tt-check.obj-code    = buf_chk-doc.obj-code
     1635               tt-check.chk-date    = buf_chk-doc.chk-date
     1636               tt-check.chk-type    = buf_chk-doc.chk-type
     1637               tt-check.shift-num   = string(buf_chk-doc.shift-num)
     1638               tt-check.shift-date  = string(buf_chk-doc.shift-date)
     1639               tt-check.cash-num    = buf_chk-doc.pay-desk
     1640               tt-check.chk-num     = string(buf_chk-doc.doc-code)
     1641               tt-check.num-z       = buf_chk-doc.z-number
     1642               tt-check.time-chk    = string(buf_chk-doc.chk-date,"99.99.9999") + " " + string(buf_chk-doc.chk-time,"HH:MM:SS")
     1643               tt-check.gds-code    = buf_chk-gds.b-code
     1644               .
     1645               tt-check.gds-name    = GDSName(tt-check.gds-code) .
     1646               .
     1647               tt-check.cashier    = CashName(buf_chk-doc.cashier) .
     1648               tt-check.chk-sum     = string(abs(buf_chk-gds.sum-base)) .
     1649               tt-check.chk-qnty    = string(abs(buf_chk-gds.doc-qnty)) .
     1650           end.
     1651       end.
     1652   end procedure .
     1653   procedure clients-write:
     1654     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     1655     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     1656     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     1657     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     1658       and buf_clients.obj-type = p-obj-type no-error .
     1659     if AVAILABLE buf_clients then
     1660     do:
     1661       p-obj-name = buf_clients.obj-name .
     1662     end.
     1663   end.
