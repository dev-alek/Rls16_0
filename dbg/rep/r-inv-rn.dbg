     3569                                           buf_stk-line.obj-type     =  obj-list.obj-type      and
     3570                                           buf_stk-line.sum-type     = 'sadt':U + 'es':U use-index pi no-lock :
     3571                          tt-gds-inv.real-rc = abs(buf_stk-line.sum-rubl - buf_stk-line.vat-rubl).
     3572             end.
     3573             for  last buf_stk-line where  buf_stk-line.fact-order  <=  v-shift-start-fact-order     and
     3574                                           buf_stk-line.artic        =  p-artic                and
     3575                                           buf_stk-line.prod-code    =  p-prod-code            and
     3576                                           buf_stk-line.prod-type    =  p-prod-type            and
     3577                                           buf_stk-line.obj-code     =  obj-list.obj-code      and
     3578                                           buf_stk-line.obj-type     =  obj-list.obj-type      and
     3579                                           buf_stk-line.sum-type     = 'sadt':U + 'es':U use-index pi no-lock :
     3580                          tt-gds-inv.real-rc = tt-gds-inv.real-rc - abs(buf_stk-line.sum-rubl - buf_stk-line.vat-rubl).
     3581             end.
     3582             for  last buf_stk-line where  buf_stk-line.fact-order  <=  v-shift-end-fact-order       and
     3583                                           buf_stk-line.artic        =  p-artic                and
     3584                                           buf_stk-line.prod-code    =  p-prod-code            and
     3585                                           buf_stk-line.prod-type    =  p-prod-type            and
     3586                                           buf_stk-line.obj-code     =  obj-list.obj-code      and
     3587                                           buf_stk-line.obj-type     =  obj-list.obj-type      and
     3588                                           buf_stk-line.sum-type     = 'sadt':U + 'ee':U use-index pi no-lock :
     3589                          tt-gds-inv.real-rc = tt-gds-inv.real-rc + abs(buf_stk-line.sum-rubl - buf_stk-line.vat-rubl).
     3590             end.
     3591             for  last buf_stk-line where  buf_stk-line.fact-order  <=  v-shift-start-fact-order     and
     3592                                           buf_stk-line.artic        =  p-artic                and
     3593                                           buf_stk-line.prod-code    =  p-prod-code            and
     3594                                           buf_stk-line.prod-type    =  p-prod-type            and
     3595                                           buf_stk-line.obj-code     =  obj-list.obj-code      and
     3596                                           buf_stk-line.obj-type     =  obj-list.obj-type      and
     3597                                           buf_stk-line.sum-type     = 'sadt':U + 'ee':U use-index pi no-lock :
     3598                          tt-gds-inv.real-rc = tt-gds-inv.real-rc - abs(buf_stk-line.sum-rubl - buf_stk-line.vat-rubl).
     3599             end.
     3600             for  last buf_stk-line where  buf_stk-line.fact-order  <=  v-shift-end-fact-order       and
     3601                                           buf_stk-line.artic        =  p-artic                and
     3602                                           buf_stk-line.prod-code    =  p-prod-code            and
     3603                                           buf_stk-line.prod-type    =  p-prod-type            and
     3604                                           buf_stk-line.obj-code     =  obj-list.obj-code      and
     3605                                           buf_stk-line.obj-type     =  obj-list.obj-type      and
     3606                                           buf_stk-line.sum-type     = 'sadt':U + 'rs':U use-index pi no-lock :
     3607                          tt-gds-inv.real-rc = tt-gds-inv.real-rc - (buf_stk-line.sum-rubl - buf_stk-line.vat-rubl).
     3608             end.
     3609             for  last buf_stk-line where  buf_stk-line.fact-order  <=  v-shift-start-fact-order     and
     3610                                           buf_stk-line.artic        =  p-artic                and
     3611                                           buf_stk-line.prod-code    =  p-prod-code            and
     3612                                           buf_stk-line.prod-type    =  p-prod-type            and
     3613                                           buf_stk-line.obj-code     =  obj-list.obj-code      and
     3614                                           buf_stk-line.obj-type     =  obj-list.obj-type      and
     3615                                           buf_stk-line.sum-type     = 'sadt':U + 'rs':U use-index pi no-lock :
     3616                          tt-gds-inv.real-rc = tt-gds-inv.real-rc + (buf_stk-line.sum-rubl - buf_stk-line.vat-rubl).
     3617             end.
     3618             for  last buf_stk-line where  buf_stk-line.fact-order  <=  v-shift-end-fact-order       and
     3619                                           buf_stk-line.artic        =  p-artic                and
     3620                                           buf_stk-line.prod-code    =  p-prod-code            and
     3621                                           buf_stk-line.prod-type    =  p-prod-type            and
     3622                                           buf_stk-line.obj-code     =  obj-list.obj-code      and
     3623                                           buf_stk-line.obj-type     =  obj-list.obj-type      and
     3624                                           buf_stk-line.sum-type     = 'sadt':U + 're':U use-index pi no-lock :
     3625                          tt-gds-inv.real-rc = tt-gds-inv.real-rc - (buf_stk-line.sum-rubl - buf_stk-line.vat-rubl).
     3626             end.
     3627             for  last buf_stk-line where  buf_stk-line.fact-order  <=  v-shift-start-fact-order     and
     3628                                           buf_stk-line.artic        =  p-artic                and
     3629                                           buf_stk-line.prod-code    =  p-prod-code            and
     3630                                           buf_stk-line.prod-type    =  p-prod-type            and
     3631                                           buf_stk-line.obj-code     =  obj-list.obj-code      and
     3632                                           buf_stk-line.obj-type     =  obj-list.obj-type      and
     3633                                           buf_stk-line.sum-type     = 'sadt':U + 're':U use-index pi no-lock :
     3634                          tt-gds-inv.real-rc = tt-gds-inv.real-rc + (buf_stk-line.sum-rubl - buf_stk-line.vat-rubl).
     3635             end.
     3636             if available tt-grp-inv then
     3637             assign
     3638                       tt-grp-inv.real-uc = tt-grp-inv.real-uc + tt-gds-inv.real-uc
     3639                       tt-grp-inv.real-rc = tt-grp-inv.real-rc + tt-gds-inv.real-rc
     3640                       tt-obj-inv.real-uc = tt-obj-inv.real-uc + tt-gds-inv.real-uc
     3641                       tt-obj-inv.real-rc = tt-obj-inv.real-rc + tt-gds-inv.real-rc
     3642                       tt-grp-inv.real-uc10 = tt-grp-inv.real-uc10 + tt-gds-inv.real-uc10
     3643                       tt-grp-inv.real-uc18 = tt-grp-inv.real-uc18 + tt-gds-inv.real-uc18
     3644                       tt-obj-inv.real-uc10 = tt-obj-inv.real-uc10 + tt-gds-inv.real-uc10
     3645                       tt-obj-inv.real-uc18 = tt-obj-inv.real-uc18 + tt-gds-inv.real-uc18
     3646             .
     3647             run ost-line (
     3648                 input obj-list.obj-code  ,
     3649                 input obj-list.obj-type  ,
     3650                 input p-artic       ,
     3651                 input p-prod-code   ,
     3652                 input p-prod-type    ,
     3653                 input x-TOG-Shift ,
     3654                 input v-shift-end-fact-order ,
     3655                 input 'cost':U   ,
     3656                 input '##,##':U,
     3657                 input YES ,
     3658                 output  Quantity2  ,
     3659                 output  Coast_R2   ,
     3660                 output  Coast_V2   ,
     3661                 output  VAT_R2     ,
     3662                 output  VAT_V2     ,
     3663                 output  slt_R2     ,
     3664                 output  slt_V2     ).
     3665             assign tt-gds-inv.ost = (Coast_R2 - VAT_R2)
     3666                    tt-grp-inv.ost = tt-grp-inv.ost + tt-gds-inv.ost
     3667                    tt-obj-inv.ost = tt-obj-inv.ost + tt-gds-inv.ost
     3668             .
     3669       end.
     3670       end.
     3671     end.
     3672   end procedure.
