     3169   run empty-tt in this-procedure.
     3170   case x-SelectGood:
     3171        when 1 then
     3172             for each goods no-lock  :
     3173                 run fill-tt in this-procedure
     3174                             (input artic,
     3175                              input prod-type,
     3176                              input prod-code,
     3177                              input gds-code,
     3178                              input gds-name,
     3179                              input grp-code,
     3180                              input grp-name
     3181                              ).
     3182             end.
     3183        when 2 then
     3184          for each tmp#grp no-lock :
     3185             for each goods where trim(goods.grp-name) begins trim(tmp#grp.grp-name) no-lock :
     3186                 run fill-tt in this-procedure
     3187                             (input artic,
     3188                              input prod-type,
     3189                              input prod-code,
     3190                              input gds-code,
     3191                              input gds-name,
     3192                              input grp-code,
     3193                              input grp-name
     3194                              ).
     3195             end.
     3196          end.
     3197        when 3 then
     3198          for each g#cli no-lock :
     3199             for each goods where goods.prod-code = g#cli.obj-code and goods.prod-type = g#cli.obj-type no-lock :
     3200                 run fill-tt in this-procedure
     3201                             (input artic,
     3202                              input prod-type,
     3203                              input prod-code,
     3204                              input gds-code,
     3205                              input gds-name,
     3206                              input grp-code,
     3207                              input grp-name
     3208                              ).
     3209             end.
     3210          end.
     3211        otherwise
     3212             for each gds-list no-lock :
     3213                 run fill-tt in this-procedure
     3214                             (input artic,
     3215                              input prod-type,
     3216                              input prod-code,
     3217                              input gds-code,
     3218                              input gds-name,
     3219                              input grp-code,
     3220                              input grp-name
     3221                              ).
     3222             end.
     3223   end case.
     3224   procedure empty-tt :
     3225   do
     3226   on error undo, return error return-value
     3227   :
     3228     empty temp-table tt-obj-inv    .
     3229     empty temp-table tt-grp-inv    .
     3230     empty temp-table tt-gds-inv    .
     3231   end.
     3232   end procedure.
     3233   procedure fill-tt:
     3234     define input parameter p-artic     like goods.artic     no-undo.
     3235     define input parameter p-prod-type like goods.prod-type no-undo.
     3236     define input parameter p-prod-code like goods.prod-code no-undo.
     3237     define input parameter p-gds-code  like goods.gds-code  no-undo.
     3238     define input parameter p-gds-name  like goods.gds-name  no-undo.
     3239     define input parameter p-grp-code  like goods.grp-code  no-undo.
     3240     define input parameter p-grp-name  like goods.grp-name  no-undo.
     3241     define variable v-cur-inv          like ub.doc-line.doc-code no-undo.
     3242     define variable attr-value   as character no-undo.
     3243     define variable attr-type    as character no-undo.
     3244   DO
     3245       :
     3246   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     3247     (
     3248        input p-artic
     3249     ,  input p-prod-type
     3250     ,  input p-prod-code
     3251     , output is-petrolium
     3252     , output is-pieces
     3253     ) no-error.
     3254         if error-status :error
     3255         then do:
     3256           return error return-value .
     3257         end.
     3258       if is-petrolium then do :
     3259         run gds-attr-value in this-procedure (
     3260                                      input p-gds-code
     3261                                     ,input 'ptrl-as-good':U
     3262                                     ,output attr-value
     3263                                     ,output attr-type) no-error.
     3264         is-petrolium = (not logical(attr-value)).
     3265       end.
     3266       if not is-petrolium then do
     3267       :
     3268       for each obj-list no-lock
     3269           :
     3270           assign
     3271             v-cur-inv = ?
     3272           .
     3273           find first tt-obj-inv where
     3274                                       tt-obj-inv.obj-type = obj-list.obj-type and
     3275                                       tt-obj-inv.obj-code = obj-list.obj-code no-lock no-error.
     3276           if not available tt-obj-inv then do:
     3277               create tt-obj-inv.
     3278               assign tt-obj-inv.name     = obj-list.obj-name
     3279                      tt-obj-inv.obj-type = obj-list.obj-type
     3280                      tt-obj-inv.obj-code = obj-list.obj-code.
     3281           end.
     3282           find last buf_doc-line where
     3283                                       buf_doc-line.ext-doc-type = 'vt':U      and
     3284                                       buf_doc-line.obj-type     = obj-list.obj-type and
     3285                                       buf_doc-line.obj-code     = obj-list.obj-code and
     3286                                       buf_doc-line.artic        = p-artic           and
     3287                                       buf_doc-line.prod-code    = p-prod-code       and
     3288                                       buf_doc-line.prod-type    = p-prod-type       and
     3289                                       buf_doc-line.status_      = 'факт':U           and
