     3112   run waitfram-show in this-procedure ("Ждите...").
     3113       run ostatok (
     3114           input 0  ,
     3115           input ""  ,yes,
     3116           input x-date-start - 1 ,
     3117           input date('')      ,  x-Shift-Start,x-Shift-End,
     3118           input 'crsa':U   ,
     3119           input '##,##':U,
     3120           input false ,
     3121           output  v-temp-f-o  ,
     3122           output  v-temp-f-o   ,
     3123           output  v-temp-f-o   ,
     3124           output  v-temp-f-o     ,
