      575   define variable var-report-r-b as character no-undo .
      576   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      577   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      578     (output var-report-r-b
      579     )  .
      580   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define variable v-waitfram-action01         as character   no-undo .
      582   define variable v-waitfram-action02         as character   no-undo .
      583   define variable v-waitfram-action03         as character   no-undo .
      584   define variable mWaitFramTextBeg            as character   no-undo.
      585   define variable mWaitFramTextEnd            as character   no-undo.
      586   define variable mWaitFramView               as logical     no-undo.
      587   define variable mWaitProcEvent              as logical     no-undo init yes.
      588   define variable mWaitFramInterval           as integer     no-undo init 1 .
      589   define variable mWaitFramStop               as logical     no-undo.
      590   define variable mWaitFramStopUser           as logical     no-undo.
      591   define variable mWaitFramStopTimeOut        as logical     no-undo.
      592   define variable mWaitFramStartProc          as datetime-tz no-undo.
      593   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      594   define button B-WaitFramStop auto-end-key
      595        label "Стоп"
      596        size 10 by 1 tooltip "Остоновить процесс".
      597   define button B-viewProcInfo
      598        label "Информация"
      599        size 15 by 1 tooltip "Информация о процесс".
      600   define frame waitfram
      601     v-waitfram-action01 format "x(72)" no-label skip
      602     v-waitfram-action02 format "x(72)" no-label skip
      603     v-waitfram-action03 format "x(72)" no-label skip
      604     B-viewProcInfo
      605     B-WaitFramStop at row 4 col 30
      606     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      607     .
      608   define new global shared variable mBatchMode as logical no-undo init ?.
      609   define variable mFramBachModHandle as handle no-undo.
      610   mFramBachModHandle = frame waitfram:handle.
      611   define variable mFameOldVis as logical no-undo.
      612   define variable mVisCUrentVin as logical no-undo.
      613   if session:batch-mode
      614   then
      615      mBatchMode = yes.
      616   if mBatchMode = ? then do:
      617     mVisCUrentVin = current-window:visible.
      618     mFameOldVis = mFramBachModHandle:visible.
      619     mFramBachModHandle:visible  = yes.
      620     mBatchMode = mFramBachModHandle:visible ne yes.
      621     mFramBachModHandle:visible = mFameOldVis.
      622     current-window:visible = mVisCUrentVin.
      623   end.
      624    if  log-manager:logfile-name ne ?
      625     then DO:
      626         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      627         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      628         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      629     end.
      630   on choose of B-WaitFramStop in frame waitfram
      631   do:
      632     mWaitFramStop = yes.
      633     mWaitFramStopUser = yes.
      634   end.
      635   function waitfram-check-timeout returns logical():
      636      define variable vtime as int64 no-undo.
      637      if mWaitFramStopTimeOut
      638      then
      639         return yes.
      640      vtime = ( now - mWaitFramStartProc ) / 1000 .
      641      if     mWaitFramTimeOut ne ?
      642         and mWaitFramTimeOut ne 0
      643         and mWaitFramTimeOut lt vtime
      644      then do:
      645         mWaitFramStopTimeOut = yes.
      646      end.
      647      return mWaitFramStopTimeOut.
      648   end.
      649   procedure waitfram-hide :
      650     if not session:batch-mode
      651     then do
      652     on error undo, return error return-value
      653     :
      654       pause 0 before-hide .
      655       if not mBatchMode then
      656         hide frame waitfram .
      657     if     not mWaitFramView
      658        and mWaitProcEvent
      659     then
      660       process events .
      661     end.
      662   end procedure.
      663   procedure waitfram-show :
      664     define input  parameter p-message as character no-undo .
      665     define variable v-left-margin as integer   no-undo .
      666     if not session:batch-mode
      667     then do
      668     on error undo, return error return-value
      669     :
      670       if length(p-message) <= 70 then do:
      671         assign
      672           v-left-margin = integer((70 - length(p-message)) / 2)
      673         .
      674         assign
      675           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      676         .
      677         assign
      678           v-waitfram-action01 = " "
      679           v-waitfram-action02 = " "
      680                                    + fill(" ", v-left-margin)
      681                                    + p-message
      682           v-waitfram-action03 = " "
      683         .
      684       end.
      685       else do:
      686         define variable vRindex1 as integer no-undo.
      687         define variable vRindex2 as integer no-undo.
      688         vRindex1 = r-index(p-message," ",70).
      689         if vRindex1 = 0
      690         then
      691            vRindex1 = 70.
      692         if length(p-message)  <= vRindex1 + 70 then do:
      693           assign
      694             v-waitfram-action01 = " "
      695             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      696             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      697           .
      698         end.
      699         else do:
      700           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      701           if vRindex2 <= vRindex1
      702           then
      703              vRindex2 = vRindex1 + 70.
      704           assign
      705             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      706             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      707             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      708           .
      709         end.
      710       end.
      711       B-viewProcInfo:visible   in frame waitfram = no.
      712       B-viewProcInfo:sensitive in frame waitfram = no.
      713       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      714       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      715       if  (   mWaitFramView
      716          or  mWaitProcEvent)
      717          and not mBatchMode
      718       then
      719          display
      720             v-waitfram-action01 skip
      721             v-waitfram-action02 skip
      722             v-waitfram-action03 skip
      723          with frame waitfram .
      724       if     mWaitFramView
      725          then do:
      726             if     mWaitFramInterval ne ?
      727                and not mBatchMode
      728             then
      729                wait-for go of frame waitfram pause mWaitFramInterval.
      730          end.
      731          else
      732             if     mWaitProcEvent
      733                and not mBatchMode
      734             then
      735                process events .
      736     end.
      737   end procedure.
      738      procedure waitfram-show-this:
      739         define input  parameter iInterval as int64 no-undo.
      740         define variable vtime as int64 no-undo.
      741         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      742         mWaitFramInterval = iInterval.
      743         run waitfram-show (substitute("&1&2 &3&4" ,
      744                                       mWaitFramTextBeg ,
      745                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      746                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      747                                       mWaitFramTextEnd
      748                                      )
      749                           ).
      750      end.
      751      procedure WaitFramRunPause:
      752         define input  parameter iInterval as dec no-undo.
      753         define variable vStart  as datetime-tz no-undo.
      754         define variable vend    as datetime-tz no-undo.
      755         define variable vint as int64 no-undo.
      756         define variable vOk as logical no-undo.
      757         vStart = now.
      758         vend   = vStart.
      759         publish "WaitFramPause" (iInterval,output vOk).
      760         vend   =  now.
      761         vint = vend - vStart.
      762         vint = iInterval - vint / 1000.
      763         if     not mWaitFramStop
      764            and (   vint > 0
      765                 or (    not vOk
      766                     and iInterval eq ?
      767                     )
      768                 )
      769         then
      770            run waitfram-show-this (iInterval).
      771         vend   =  now.
      772         vint = vend - vStart.
      773         vint = iInterval - vint / 1000.
      774         if     not mWaitFramStop
      775            and vint > 0
      776         then do:
      777            run gbl/pause.p (vint * 1000).
      778         end.
      779         if iInterval ne ?
      780         then
      781            publish "WaitFramStop".
      782         waitfram-check-timeout().
      783      end.
      784      procedure WaitFramWaitFor:
      785         define input  parameter iInterval as dec no-undo.
      786         assign
      787            mWaitFramStartProc   = now
      788            mWaitFramStopUser    = no
      789            mWaitFramStopTimeOut = no
      790         .
      791         block-wait:
      792         do while not mWaitFramStop:
      793            run WaitFramRunPause (iInterval).
      794            if  waitfram-check-timeout()
      795            then do:
      796               leave block-wait.
      797            end.
      798         end.
      799         run waitfram-hide.
      800      end.
      801   procedure waitfram-join :
      802     define input  parameter p-line-1  as character no-undo .
      803     define input  parameter p-line-2  as character no-undo .
      804     define input  parameter p-line-3  as character no-undo .
      805     define output parameter p-message as character no-undo .
      806     do
      807     on error undo, return error return-value
      808     :
      809       assign
      810         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      811                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      812                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      813       .
      814     end.
      815   end procedure.
      816   function waitfram-join-function returns character
      817     (input p-line-1 as character
      818     ,input p-line-2 as character
      819     ,input p-line-3 as character
      820     ).
      821     define variable v-message as character no-undo .
      822     run waitfram-join in this-procedure
      823       (input  p-line-1
      824       ,input  p-line-2
      825       ,input  p-line-3
      826       ,output v-message
      827       ) .
      828     return v-message .
      829   end function .
      830   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   define  stream PrnLibStream.
      832   procedure prn-lib-prn-file :
      833     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      834     define input parameter p-DIsabledoptions as integer no-undo .
      835     define variable v-report-name as character no-undo .
      836     define variable v-user-action as character no-undo .
      837     define variable v-printed     as logical   no-undo .
      838     define variable v-exist       as logical   no-undo .
      839     do
      840       on error undo, return error
      841       :
      842       run prn-lib-get-report-name  in this-procedure (
      843         input parParentProc
      844         ,output v-report-name
      845         ).
      846   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      848     (input  v-report-name
      849     ,input  2
      850     ,output v-exist
      851     )  .
      852       if NOT v-exist then
      853       DO:
      854         Message
      855           "Нет заданий на печать ! "
      856           view-as alert-box .
      857         Return  .
      858       End.
      859       run gbl/prnfilen.w
      860         (input  ""
      861         ,input  p-DisabledOptions
      862         ,input  string(v-report-name )
      863         ,input  7
      864         ,output v-user-action
      865         ,output v-printed
      866         ) .
      867       if v-printed then
      868       do:
      869         return "YES" .
      870       end.
      871       else
      872       do:
      873         return "NO" .
      874       end.
      875     end.
      876   end procedure.
      877   procedure prn-lib-open-stream :
      878     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      879     define input parameter p-page-size    as integer no-undo .
      880     define input parameter p-is-stream    as logical no-undo .
      881     define input parameter p-append       as logical no-undo .
      882     define variable v-report-name as character no-undo .
      883     do
      884       on error undo, return error
      885       :
      886       run prn-lib-get-report-name  in this-procedure (
      887         input parParentProc
      888         ,output v-report-name
      889         ).
      890       if p-is-stream then
      891       do:
      892         if p-append then
      893         do:
      894           output stream PrnLibStream to value( v-report-name )
      895             page-size value(p-page-size) append .
      896         end.
      897         if not p-append then
      898         do:
      899           output stream PrnLibStream to value( v-report-name )
      900             page-size value(p-page-size) .
      901         end.
      902       end.
      903       if not p-is-stream then
      904       do:
      905         if p-append then
      906         do:
      907           output to value( v-report-name )
      908             page-size value(p-page-size) append .
      909         end.
      910         if not p-append then
      911         do:
      912           output to value( v-report-name )
      913             page-size value(p-page-size) .
      914         end.
      915       end.
      916     end.
      917   end procedure.
      918   procedure prn-lib-open-exp :
      919     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      920     define input parameter p-is-stream    as logical no-undo .
      921     define input parameter p-is-append    as logical no-undo .
      922     define output parameter p-ReportFileName as char init "report" no-undo.
      923     define output parameter p-process as logical no-undo .
      924     define variable glog as logical no-undo .
      925     do
      926       on error undo, return error
      927       :
      928       SYSTEM-DIALOG GET-FILE p-ReportFileName
      929         TITLE      "Укажите путь"
      930         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      931         ASK-OVERWRITE
      932         CREATE-TEST-FILE
      933         SAVE-AS
      934         USE-FILENAME
      935         DEFAULT-EXTENSION "txt"
      936         UPDATE glog
      937         .
      938       if not glog then  return.
      939       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      940       if p-is-stream then
      941       do:
      942         if p-is-append then
      943         do:
      944           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      945         end.
      946         else
      947         do:
      948           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      949         end.
      950       end.
      951       else
      952       do:
      953         if p-is-append then
      954         do:
      955           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      956         end.
      957         else
      958         do:
      959           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      960         end.
      961       end.
      962       p-process = yes.
      963     end.
      964   end procedure.
      965   procedure prn-lib-get-report-name :
      966     define input parameter parParentProc  as widget-handle no-undo.
      967     define output parameter p-report-name as character no-undo .
      968     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      969   end procedure.
      970   procedure prn-lib-reportviewer-report-name :
      971     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      972     define input parameter p-report-name-html as character no-undo .
      973     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      974   end procedure.
      975   procedure prn-lib-reportviewer :
      976     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      977     define input parameter p-report-name-html as character no-undo .
      978     define input parameter p-param        as character no-undo .
      979     define variable v-excel           as character no-undo init 'TRUE' .
      980     define variable v-value-character as character no-undo .
      981     define variable v-value-integer   as character no-undo .
      982     define variable v-value-date      as date      no-undo .
      983     define variable v-value-decimal   as decimal   no-undo .
      984     define variable rep-excel         as logical   no-undo .
      985     define variable excel-string      as character no-undo .
      986     define variable v-param-type      as character no-undo .
      987     define variable v-tth             as handle    no-undo .
      988     run adm/shattri.p (
      989       input "get":U
      990       ,input  ""
      991       ,input  0
      992       ,input  'report-glob':U
      993       ,input  'rep-excel':U
      994       ,output v-value-character
      995       ,output v-value-date
      996       ,output v-value-decimal
      997       ,output v-value-integer
      998       ,output rep-excel
      999       ,output v-param-type
     1000       ,INPUT-OUTPUT table-handle v-tth
     1001       )  .
     1002     if rep-excel then v-excel = "TRUE" .
     1003     else v-excel = "FALSE" .
     1004     if p-param eq ""
     1005     then
     1006        p-param = "EXCEL:" + v-excel.
     1007     else
     1008        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1009     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1010   end procedure.
     1011   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   procedure factord :
     1013     define input  parameter p-fact-date            as date    no-undo .
     1014     define input  parameter p-fact-time            as integer no-undo .
     1015     define input  parameter p-fact-num             as integer no-undo .
     1016     define input  parameter p-shift-date           as date    no-undo .
     1017     define input  parameter p-shift-num            as integer no-undo .
     1018     define input  parameter p-shift-on             as logical no-undo .
     1019     define output parameter p-fact-order           as decimal no-undo .
     1020     define output parameter p-shift-end-fact-order as decimal no-undo .
     1021     define output parameter p-day-end-fact-order   as decimal no-undo .
     1022     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1023     if p-fact-date = ?
     1024     then do:
     1025       return error "Не указана фактическая дата" .
     1026     end.
     1027     define variable v-fact-date-num as integer no-undo .
     1028     assign
     1029       v-fact-date-num = integer(p-fact-date)
     1030     .
     1031     if p-fact-num = ?
     1032     or p-fact-num = 0
     1033     then do:
     1034       return error "Не задан p-fact-num " + string(p-fact-num) .
     1035     end.
     1036     if p-fact-num < 0
     1037     then do:
     1038       return error "Отрицательный fact-num " + string(p-fact-num) .
     1039     end.
     1040     if p-fact-num >= 100000000
     1041     then do:
     1042       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1043     end.
     1044     if p-shift-on = true
     1045     then do:
     1046       if p-shift-date = ?
     1047       then do:
     1048         return error "Не задана дата смены" .
     1049       end.
     1050       if p-shift-num = ?
     1051       or p-shift-num = 0
     1052       then do:
     1053         return error "Не задан номер смены" .
     1054       end.
     1055     end.
     1056     else do:
     1057       assign
     1058         p-shift-date = p-fact-date
     1059         p-shift-num  = 24
     1060       .
     1061     end.
     1062     define variable v-shift-offset as integer no-undo .
     1063     if p-shift-date = p-fact-date
     1064     then do:
     1065       assign
     1066         v-shift-offset = 1
     1067       .
     1068     end.
     1069     if p-shift-date < p-fact-date
     1070     then do:
     1071       assign
     1072         v-shift-offset = 0
     1073       .
     1074     end.
     1075     if p-shift-date > p-fact-date
     1076     then do:
     1077       message
     1078         vss-workfile vss-revision vss-description skip
     1079         "Неправильная дата закрытия смены" skip
     1080         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1081         view-as alert-box error .
     1082       undo, return error
     1083         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1084           ,string(p-fact-date, '99/99/9999':U)
     1085           ,string(p-shift-date, '99/99/9999':U)
     1086           )
     1087       .
     1088     end.
     1089     if p-shift-num < 1
     1090     or p-shift-num > 24
     1091     then do:
     1092       message
     1093         vss-workfile vss-revision vss-description skip
     1094         "Неправильный номер смены" skip
     1095         "p-shift-num" p-shift-num skip
     1096         view-as alert-box error .
     1097       undo, return error return-value .
     1098     end.
     1099     assign
     1100       p-fact-order           = v-fact-date-num
     1101                              + v-shift-offset * 0.5
     1102                              + p-shift-num    * 0.02 - 0.01
     1103                              + p-fact-num     * 0.0000000001
     1104       p-shift-end-fact-order = v-fact-date-num
     1105                              + v-shift-offset * 0.5
     1106                              + p-shift-num    * 0.02
     1107       p-day-end-fact-order   = v-fact-date-num
     1108                              + 0.99
     1109     .
     1110     if p-fact-order           <= v-fact-date-num
     1111     or p-shift-end-fact-order <= v-fact-date-num
     1112     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1113     or p-shift-end-fact-order >= p-day-end-fact-order
     1114     then do:
     1115       message
     1116         vss-workfile vss-revision vss-description skip
     1117         "Внутренняя ошибка при генерации фактического номера" skip
     1118         "p-fact-date"            p-fact-date            skip
     1119         "p-fact-time"            p-fact-time            skip
     1120         "p-fact-num"             p-fact-num             skip
     1121         "p-shift-date"           p-shift-date           skip
     1122         "p-shift-num"            p-shift-num            skip
     1123         "p-shift-on"             p-shift-on             skip
     1124         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1125         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1126         "v-fact-date-num"        v-fact-date-num        skip
     1127         view-as alert-box error .
     1128       undo, return error return-value .
     1129     end.
     1130   end procedure.
     1131   procedure day-begin-fact-order :
     1132     define input  parameter p-fact-date            as date    no-undo .
     1133     define output parameter p-day-begin-fact-order as decimal no-undo .
     1134     do
     1135     on error undo, return error return-value
     1136     :
     1137       if p-fact-date = ?
     1138       then do:
     1139         assign
     1140           p-day-begin-fact-order = 0
     1141         .
     1142       end.
     1143       else do:
     1144         assign
     1145           p-day-begin-fact-order = integer(p-fact-date)
     1146         .
     1147       end.
     1148     end.
     1149   end procedure.
     1150   procedure factord-max-fact-order :
     1151     define output parameter p-max-fact-order as decimal   no-undo .
     1152     do
     1153     on error undo, return error return-value
     1154     :
     1155       run day-begin-fact-order in this-procedure
     1156         (input  date(1, 1, 5000)
     1157         ,output p-max-fact-order
     1158         ) .
     1159     end.
     1160   end procedure.
     1161   procedure factord-cut-archive :
     1162     define input  parameter p-obj-type             as character no-undo .
     1163     define input  parameter p-obj-code             as integer   no-undo .
     1164     define input  parameter p-fact-date            as date      no-undo .
     1165     define output parameter p-shift-on             as logical   no-undo .
     1166     define output parameter p-shift-date           as date      no-undo .
     1167     define output parameter p-shift-num            as integer   no-undo .
     1168     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1169     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1170     define variable v-fact-order as decimal   no-undo .
     1171     define buffer buf_shift-obj for ub.shift-obj .
     1172     do
     1173     on error undo, return error return-value
     1174     :
     1175   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1177     (input  p-obj-type
     1178     ,input  p-obj-code
     1179     ,input  'shift-on=request'
     1180     ,output p-shift-on
     1181     ) no-error .
     1182       if error-status :error
     1183       then do:
     1184         message
     1185           vss-workfile vss-revision vss-description skip
     1186           "Ошибка при определении атрибута объекта" skip
     1187           "Объект" p-obj-type p-obj-code skip
     1188           error-status :get-message(1) skip
     1189           return-value skip
     1190           view-as alert-box error .
     1191         undo, return error return-value .
     1192       end.
     1193       if p-shift-on = false
     1194       then do:
     1195         assign
     1196           p-shift-date               = ?
     1197           p-shift-num                = 0
     1198         .
     1199       end.
     1200       else do:
     1201         find first buf_shift-obj share-lock
     1202           where buf_shift-obj.obj-type   = p-obj-type
     1203             and buf_shift-obj.obj-code   = p-obj-code
     1204             and buf_shift-obj.shift-date > p-fact-date
     1205           use-index pi
     1206           no-error .
     1207         if not available buf_shift-obj
     1208         or buf_shift-obj.status_ <> 'зкр':U
     1209         then do:
     1210           message
     1211             vss-workfile vss-revision vss-description skip
     1212             "Невозможно вычислить последнюю смену" skip
     1213             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1214             "Объект" p-obj-type p-obj-code skip
     1215             "Дата" p-fact-date skip
     1216             view-as alert-box error .
     1217           undo, return error return-value .
     1218         end.
     1219         find last buf_shift-obj share-lock
     1220           where buf_shift-obj.obj-type = p-obj-type
     1221             and buf_shift-obj.obj-code = p-obj-code
     1222             and buf_shift-obj.shift-date <= p-fact-date
     1223           use-index pi
     1224           no-error .
     1225         if available buf_shift-obj
     1226         then do:
     1227           if  buf_shift-obj.status_ = 'зкр':U
     1228           then do:
     1229             assign
     1230               p-shift-date = buf_shift-obj.shift-date
     1231               p-shift-num  = buf_shift-obj.shift-num
     1232             .
     1233           end.
     1234           else do:
     1235             message
     1236               vss-workfile vss-revision vss-description skip
     1237               "Невозможно вычислить последнюю смену" skip
     1238               "Статус смены отличен от статуса" 'зкр':U skip
     1239               "Объект" p-obj-type p-obj-code skip
     1240               "Дата" p-fact-date skip
     1241               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1242               view-as alert-box error .
     1243             undo, return error return-value .
     1244           end.
     1245         end.
     1246         else do:
     1247           assign
     1248             p-shift-date = p-fact-date - 1
     1249             p-shift-num  = 1
     1250           .
     1251         end.
     1252       end.
     1253       run factord in this-procedure
     1254         (input  p-fact-date
     1255         ,input  1
     1256         ,input  1
     1257         ,input  p-shift-date
     1258         ,input  p-shift-num
     1259         ,input  p-shift-on
     1260         ,output v-fact-order
     1261         ,output p-shift-end-fact-order
     1262         ,output p-day-end-fact-order
     1263         ) no-error .
     1264       if error-status :error
     1265       then do:
     1266         message
     1267           vss-workfile vss-revision vss-description skip
     1268           "Ошибка при вызове процедуры factord"
     1269           error-status :get-message(1) skip
     1270           return-value skip
     1271           view-as alert-box error .
     1272         undo, return error return-value .
     1273       end.
     1274     end.
     1275   end procedure.
     1276   procedure factord-lock-shift :
     1277     define input  parameter p-obj-type  as character no-undo .
     1278     define input  parameter p-obj-code  as integer   no-undo .
     1279     define input  parameter p-fact-date as date      no-undo .
     1280     define parameter buffer buf_shift-obj for ub.shift-obj .
     1281     define variable v-shift-on      as logical   no-undo .
     1282     define variable v-extra-message as character no-undo .
     1283     define variable v-error as character no-undo .
     1284     do
     1285     on error undo, return error return-value
     1286     :
     1287   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1288   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1289     (input  p-obj-type
     1290     ,input  p-obj-code
     1291     ,input  'shift-on=request'
     1292     ,output v-shift-on
     1293     ) no-error .
     1294       if error-status :error
     1295       then do:
     1296         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1297         undo, return error v-error .
     1298       end.
     1299       if v-shift-on = true
     1300       then do:
     1301         find first buf_shift-obj share-lock
     1302           where buf_shift-obj.obj-type   = p-obj-type
     1303             and buf_shift-obj.obj-code   = p-obj-code
     1304             and buf_shift-obj.shift-date > p-fact-date
     1305           use-index pi
     1306           no-error .
     1307         if not available buf_shift-obj
     1308         or buf_shift-obj.status_ <> 'зкр':U
     1309         then do:
     1310           find last buf_shift-obj
     1311             where buf_shift-obj.obj-type = p-obj-type
     1312               and buf_shift-obj.obj-code = p-obj-code
     1313               and buf_shift-obj.status_  = 'зкр':U
     1314             use-index stts
     1315             no-error .
     1316           if available buf_shift-obj
     1317           then do:
     1318             assign
     1319               v-extra-message =
     1320                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1321                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1322                               )
     1323             .
     1324           end.
     1325           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1326           undo, return error v-error .
     1327         end.
     1328       end.
     1329     end.
     1330   end procedure.
     1331   procedure factord-end-day :
     1332     define input  parameter p-fact-date            as date    no-undo .
     1333     define output parameter p-day-end-fact-order   as decimal no-undo .
     1334     do
     1335     on error undo, return error return-value
     1336     :
     1337       if p-fact-date = ?
     1338       then do:
     1339         return error "Не указана фактическая дата" .
     1340       end.
     1341       assign
     1342         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1343       .
     1344     end.
     1345   end procedure.
     1346   procedure factord-to-date :
     1347     define input  parameter p-fact-order as decimal no-undo .
     1348     define output parameter p-fact-date  as date    no-undo .
     1349     define variable v-ref-date  as date      no-undo .
     1350     define variable v-ref-delta as integer   no-undo .
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354       if p-fact-order = ?
     1355       or p-fact-order = 0
     1356       then do:
     1357         return error "Не указан fact-order" .
     1358       end.
     1359       assign
     1360         v-ref-date  = date(1, 1, 2000)
     1361       .
     1362       assign
     1363         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1364       .
     1365       assign
     1366         p-fact-date = v-ref-date + v-ref-delta
     1367       .
     1368     end.
     1369   end procedure.
     1370   procedure factord-to-fact-num :
     1371     define input  parameter p-fact-order as decimal no-undo .
     1372     define output parameter p-fact-num   as integer no-undo .
     1373     define variable v-fact-order-trunc as decimal no-undo .
     1374     do
     1375     on error undo, return error return-value
     1376     :
     1377       if p-fact-order = ?
     1378       or p-fact-order = 0
     1379       then do:
     1380         return error "Не указан fact-order" .
     1381       end.
     1382       assign
     1383        v-fact-order-trunc = truncate(p-fact-order, 2)
     1384       .
     1385       assign
     1386         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1387       .
     1388     end.
     1389   end procedure.
     1390   procedure factord-to-shift-num :
     1391     define input  parameter p-fact-order as decimal no-undo .
     1392     define output parameter p-shift-num   as integer no-undo .
     1393     define variable  p-shift-numd  as decimal   no-undo .
     1394     define variable v-fact-order-trunc as decimal no-undo .
     1395     do
     1396     on error undo, return error return-value
     1397     :
     1398       if p-fact-order = ?
     1399       or p-fact-order = 0
     1400       then do:
     1401         return error "Не указан fact-order" .
     1402       end.
     1403       assign
     1404        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1405       .
     1406       if v-fact-order-trunc < 0.5 then do:
     1407         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1408       end.
     1409       assign
     1410         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1411         .
     1412        assign
     1413         p-shift-num = truncate (p-shift-numd , 0)
     1414       .
     1415     end.
     1416   end procedure.
     1417   PROCEDURE ostatok :
     1418   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1419   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1420   def input parameter x-tog-shift   as   logical             no-undo.
     1421   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1422   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1423   def input parameter x-shift-start as integer               no-undo.
     1424   def input parameter x-shift-end   as integer               no-undo.
     1425   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1426   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1427   def input parameter xTog-obj   as log no-undo.
     1428   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1429   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1430   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1431   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1432   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1433   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1434   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1435   def var              Fact-orderS   as char  no-undo.
     1436   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1437      Assign
     1438         Fact-order   = 0
     1439         Quantity     = 0
     1440         Coast_R      = 0
     1441         Coast_V      = 0
     1442         VAT_R        = 0
     1443         VAT_V        = 0 .
     1444    x-date-start-t  = x-date-start + 1 .
     1445   IF x-date-end = date('') then DO:
     1446      Fact-order = 0 .
     1447      for each obj-list
     1448          where  ( not xtog-obj or
     1449                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1450                 no-lock :
     1451         if  x-tog-shift = false then do:
     1452                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1453                               ub.stk-tot.Fact-date <=  x-date-start
     1454                               and ub.stk-tot.shift-num = 0
     1455                               USE-INDEX fact-date no-lock no-error .
     1456              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1457         End.
     1458         Else  DO :
     1459             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1460              (ub.stk-tot.shift-date  = x-date-start-t and
     1461               ub.stk-tot.shift-num  < x-shift-start or
     1462               ub.stk-tot.shift-date  < x-date-start-t  )
     1463               and ub.stk-tot.shift-num  > 0
     1464               USE-INDEX Shift-num no-lock no-error .
     1465            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1466           END.
     1467       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1468     End.
     1469   End.
     1470   Else DO:
     1471     For each obj-list  WHERE
     1472        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1473         no-lock :
     1474      IF  x-TOG-Shift = False Then DO:
     1475          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1476               ub.stk-tot.Fact-date <= x-date-end
     1477               and ub.stk-tot.shift-num = 0
     1478               USE-INDEX fact-date no-lock no-error.
     1479          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1480      END.
     1481      Else DO:
     1482           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1483               (ub.stk-tot.shift-date  = x-date-end and
     1484               ub.stk-tot.shift-num  <= x-shift-end or
     1485               ub.stk-tot.shift-date  < x-date-end       ) and
     1486               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1487               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1488       End.
     1489       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1490     End.
     1491   End.
     1492   END PROCEDURE.
     1493   procedure ost-line :
     1494     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1495     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1496     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1497     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1498     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1499     define input  parameter x-tog-shift  as logical no-undo .
     1500     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1501     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1502     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1503     define input  parameter xtog-obj     as logical no-undo .
     1504     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1505     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1506     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1507     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1508     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1509     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1510     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1511     define buffer buff-obj-list  for obj-list .
     1512     define buffer buff-stk-line  for ub.stk-line .
     1513     assign
     1514       Quantity = 0
     1515       Coast_R  = 0
     1516       Coast_V  = 0
     1517       VAT_R    = 0
     1518       VAT_V    = 0
     1519       SLT_R    = 0
     1520       SLT_V    = 0
     1521     .
     1522     if  x-tog-shift = false then do:
     1523       for each buff-obj-list no-lock
     1524         where xtog-obj = false
     1525            or (buff-obj-list.obj-type = x-store-type
     1526               and buff-obj-list.obj-code = x-store-code
     1527               )
     1528       on error undo, return error
     1529       :
     1530         find last buff-stk-line no-lock
     1531           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1532             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1533             and buff-stk-line.artic      = x-artic
     1534             and buff-stk-line.prod-type  = x-prod-type
     1535             and buff-stk-line.prod-code  = x-prod-code
     1536             and buff-stk-line.sum-type   = x-sum-type
     1537             and buff-stk-line.cat-id     = '##,##':U
     1538             and buff-stk-line.fact-order <= x-fact-order
     1539             and buff-stk-line.shift-num  = 0
     1540           use-index category
     1541           no-error .
     1542         if available buff-stk-line then do:
     1543           assign
     1544             Quantity = Quantity +  buff-stk-line.fact-qnty
     1545             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1546             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1547             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1548             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1549             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1550             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1551           .
     1552         end.
     1553       end.
     1554     end.
     1555     else do:
     1556       for each buff-obj-list no-lock
     1557         where xtog-obj = false
     1558            or (buff-obj-list.obj-type = x-store-type
     1559               and buff-obj-list.obj-code = x-store-code
     1560               )
     1561       on error undo, return error
     1562       :
     1563         find last buff-stk-line no-lock
     1564           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1565             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1566             and buff-stk-line.artic      = x-artic
     1567             and buff-stk-line.prod-type  = x-prod-type
     1568             and buff-stk-line.prod-code  = x-prod-code
     1569             and buff-stk-line.sum-type   = x-sum-type
     1570             and buff-stk-line.cat-id     = '##,##':U
     1571             and buff-stk-line.fact-order <= x-fact-order
     1572             and buff-stk-line.shift-num  > 0
     1573           use-index category
     1574           no-error .
     1575         if available buff-stk-line then do:
     1576           assign
     1577             Quantity = Quantity +  buff-stk-line.fact-qnty
     1578             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1579             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1580             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1581             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1582             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1583             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1584           .
     1585         end.
     1586       end.
     1587     end.
     1588   end procedure.
     1589   procedure ost-lineother-tax :
     1590     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1591     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1592     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1593     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1594     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1595     define input  parameter x-tog-shift  as logical no-undo .
     1596     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1597     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1598     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1599     define input  parameter xTog-obj     as logical no-undo .
     1600     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1601     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1602     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1603     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1604     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1605     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1606     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1607     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1608     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1609     define buffer buff-obj-list  for obj-list .
     1610     define buffer buff-stk-line  for ub.stk-line .
     1611     assign
     1612       Quantity = 0
     1613       Coast_R  = 0
     1614       Coast_V  = 0
     1615       VAT_R    = 0
     1616       VAT_V    = 0
     1617       SLT_R    = 0
     1618       SLT_V    = 0
     1619       other_R  = 0
     1620       other_V  = 0
     1621     .
     1622     if  x-tog-shift = false then do:
     1623       for each buff-obj-list no-lock
     1624         where xtog-obj = false
     1625            or (buff-obj-list.obj-type = x-store-type
     1626               and buff-obj-list.obj-code = x-store-code
     1627               )
     1628       on error undo, return error
     1629       :
     1630         find last buff-stk-line no-lock
     1631           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1632             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1633             and buff-stk-line.artic      = x-artic
     1634             and buff-stk-line.prod-type  = x-prod-type
     1635             and buff-stk-line.prod-code  = x-prod-code
     1636             and buff-stk-line.sum-type   = x-sum-type
     1637             and buff-stk-line.cat-id     = '##,##':U
     1638             and buff-stk-line.fact-order <= x-fact-order
     1639             and buff-stk-line.shift-num  = 0
     1640           use-index category
     1641           no-error .
     1642         if available buff-stk-line then do:
     1643           assign
     1644             Quantity = Quantity +  buff-stk-line.fact-qnty
     1645             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1646             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1647             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1648             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1649             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1650             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1651             other_R  = other_R  +  buff-stk-line.other-rubl
     1652             other_V  = other_V  +  buff-stk-line.other-base
     1653           .
     1654         end.
     1655       end.
     1656     end.
     1657     else do:
     1658       for each buff-obj-list no-lock
     1659         where xtog-obj = false
     1660            or (buff-obj-list.obj-type = x-store-type
     1661               and buff-obj-list.obj-code = x-store-code
     1662               )
     1663       on error undo, return error
     1664       :
     1665         find last buff-stk-line no-lock
     1666           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1667             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1668             and buff-stk-line.artic      = x-artic
     1669             and buff-stk-line.prod-type  = x-prod-type
     1670             and buff-stk-line.prod-code  = x-prod-code
     1671             and buff-stk-line.sum-type   = x-sum-type
     1672             and buff-stk-line.cat-id     = '##,##':U
     1673             and buff-stk-line.fact-order <= x-fact-order
     1674             and buff-stk-line.shift-num  > 0
     1675           use-index category
     1676           no-error .
     1677         if available buff-stk-line then do:
     1678           assign
     1679             Quantity = Quantity +  buff-stk-line.fact-qnty
     1680             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1681             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1682             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1683             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1684             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1685             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1686             other_R = other_R   +  buff-stk-line.other-rubl
     1687             other_V = other_V   +  buff-stk-line.other-base
     1688           .
     1689         end.
     1690       end.
     1691     end.
     1692   end procedure.
     1693   procedure ost-line-kg :
     1694     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1695     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1696     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1697     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1698     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1699     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1700     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1701     define buffer buff-obj-list  for obj-list .
     1702     define buffer buf_doc-line for ub.doc-line .
     1703     define buffer buf_inv-line for ub.inv-line .
     1704     do
     1705     on error undo, return error
     1706     :
     1707       for each buf_doc-line no-lock where
     1708                buf_doc-line.obj-type    = p-obj-type   and
     1709                buf_doc-line.obj-code    = p-obj-code   and
     1710                buf_doc-line.prod-type   = p-prod-type  and
     1711                buf_doc-line.prod-code   = p-prod-code  and
     1712                buf_doc-line.artic       = p-artic      and
     1713                buf_doc-line.status_     = 'факт':U      and
     1714                buf_doc-line.fact-order <= p-fact-order
     1715             by buf_doc-line.fact-order    descending
     1716       :
     1717         find first buf_inv-line no-lock where
     1718                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1719                    buf_inv-line.artic     = buf_doc-line.artic     and
     1720                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1721                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1722         if available buf_inv-line
     1723         then do:
     1724           if buf_inv-line.after-cli-qnty <> ?
     1725           then do:
     1726             assign
     1727               p-quantity-kg = buf_inv-line.after-cli-qnty
     1728             .
     1729             leave .
     1730           end.
     1731         end.
     1732       end.
     1733       if p-quantity-kg = ?
     1734       then do:
     1735         assign
     1736           p-quantity-kg = 0
     1737         .
     1738       end.
     1739     end.
     1740   end procedure.
     1741   define new global shared variable g#lib-trn  as handle no-undo .
     1742   define new global shared variable g#lib-trn2 as handle no-undo .
     1743   define new global shared variable g#lib-trn3 as handle no-undo .
     1744   define new global shared variable g#lib-trn4 as handle no-undo .
     1745   define variable vss-include-info14 as character format "X(65)" no-undo
     1746   initial "@(#)$Workfile$ $Revision$".
     1747   define temp-table temp_grplib_grp no-undo
     1748       field sel           as character
     1749       field nabor         as character
     1750       field full-name     as character
     1751       field print-code    as character
     1752       field sort-name     as character
     1753       field node-code     as integer
     1754       field upper-code    as integer
     1755       field calc-method   as character
     1756       field round-method  as character
     1757       field increase-pc   as decimal
     1758       field min-marg      as character
     1759       field max-marg      as character
     1760       field cli-type      as character
     1761       field cli-code      as integer
     1762       field notcorr      as character
     1763       field name          as character
     1764       field level         as integer
     1765       field mark          as character
     1766       index pi is primary unique sort-name
     1767       index fn full-name
     1768       index nc is unique node-code
     1769       index sl sel
     1770       index uc upper-code
     1771   .
     1772   define temp-table temp_grplib_found-grp no-undo
     1773       field full-name   as character
     1774       field sort-name   as character
     1775       field node-code   as integer
     1776       field level       as integer
     1777       field is-terminal as logical
     1778       index pi is primary unique sort-name
     1779       index fn full-name
     1780       index lv level
     1781       index it is-terminal
     1782   .
     1783   define temp-table temp_found-result-nodelist no-undo
     1784       field node-code     as recid
     1785       field processed     as logical
     1786       field sort-name     as character
     1787       field full-name     as character
     1788       index pi is primary unique node-code
     1789       index ps processed
     1790   .
     1791   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1792   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1793   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1794   procedure grplib-get-parameters :
     1795   define input parameter p-store-type     as character        no-undo.
     1796   define input parameter p-store-code     as integer          no-undo.
     1797   do
     1798   on error undo, return error
     1799   :
     1800       assign
     1801           v-grplib-not-fill-extra-info = no
     1802       .
     1803   end.
     1804   end procedure.
     1805   procedure grplib-get-sort-name :
     1806   do
     1807   on error undo, return error
     1808   :
     1809   define input parameter p-node-code  as integer      no-undo.
     1810   define output parameter p-sort-name as character    no-undo.
     1811       define variable v-upper-code    as integer           no-undo.
     1812       define buffer buf_gds-grp       for ub.gds-grp.
     1813       define buffer buf_upper_gds-grp for ub.gds-grp.
     1814       find first buf_gds-grp no-lock
     1815            where buf_gds-grp.node-code = p-node-code
     1816       no-error.
     1817       if not available buf_gds-grp
     1818       then do:
     1819           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1820       end.
     1821       assign
     1822           p-sort-name  = ""
     1823           v-upper-code = 1
     1824       .
     1825       do while buf_gds-grp.upper-code <> 0
     1826       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1827       :
     1828           assign
     1829               p-sort-name  = buf_gds-grp.node-name
     1830                            + (if p-sort-name <> "" then chr(2) else "")
     1831                            + p-sort-name
     1832               v-upper-code = buf_gds-grp.upper-code
     1833           .
     1834           find first buf_gds-grp no-lock
     1835                where buf_gds-grp.node-code = v-upper-code
     1836           no-error.
     1837           if not available buf_gds-grp
     1838           then do:
     1839               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1840                                   + string( v-upper-code )
     1841                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1842           end.
     1843       end.
     1844   end.
     1845   end procedure.
     1846   define variable vss-include-info15 as character format "X(65)" no-undo
     1847   initial "@(#)$Workfile$ $Revision$".
     1848   procedure grplib-get-full-name :
     1849      define input parameter p-node-code  as integer      no-undo.
     1850      define output parameter p-full-name as character    no-undo.
     1851      do
     1852   on error undo, return error
     1853   :
     1854       define variable v-upper-code    as integer           no-undo.
     1855       define buffer buf_gds-grp       for ub.gds-grp.
     1856       define buffer buf_upper_gds-grp for ub.gds-grp.
     1857       find first buf_gds-grp no-lock
     1858            where buf_gds-grp.node-code = p-node-code
     1859       no-error.
     1860       if not available buf_gds-grp
     1861       then do:
     1862           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1863       end.
     1864       assign
     1865           p-full-name  = ""
     1866           v-upper-code = 1
     1867       .
     1868       do while buf_gds-grp.upper-code <> 0
     1869       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1870       :
     1871           assign
     1872               p-full-name  = buf_gds-grp.node-name
     1873                            + (if p-full-name <> "" then chr(47) else "")
     1874                            + p-full-name
     1875               v-upper-code = buf_gds-grp.upper-code
     1876           .
     1877           find first buf_gds-grp no-lock
     1878                where buf_gds-grp.node-code = v-upper-code
     1879           no-error.
     1880           if not available buf_gds-grp
     1881           then do:
     1882               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1883                                   + string( v-upper-code )
     1884                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1885           end.
     1886       end.
     1887       assign
     1888       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1889       .
     1890   end.
     1891   end .
     1892   procedure grplib-get-node-from-full-name :
     1893   define input parameter p-full-name as character no-undo .
     1894   define output parameter p-node-code as integer no-undo .
     1895   define variable v-ii as integer no-undo .
     1896   define variable v-upper-code as integer no-undo .
     1897   define variable v-root-code as integer no-undo .
     1898   define variable v-entry as character no-undo .
     1899   define buffer buf_gds-grp       for ub.gds-grp.
     1900   do
     1901   on error undo, return error
     1902   :
     1903     find first buf_gds-grp no-lock
     1904         where buf_gds-grp.upper-code = 0
     1905     no-error .
     1906     if not available buf_gds-grp
     1907     then do:
     1908         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1909     end.
     1910     else do:
     1911       assign
     1912       v-root-code = buf_gds-grp.node-code
     1913       .
     1914     end.
     1915     v-upper-code = v-root-code.
     1916     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1917       assign
     1918       v-entry = entry(v-ii, p-full-name, chr(47)).
     1919       if v-entry = '' then leave.
     1920       find first buf_gds-grp no-lock where
     1921                 buf_gds-grp.node-name = v-entry
     1922             and buf_gds-grp.upper-code = v-upper-code
     1923             no-error.
     1924       if not available buf_gds-grp then do:
     1925         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1926       end.
     1927       else do:
     1928         p-node-code = buf_gds-grp.node-code.
     1929         v-upper-code = buf_gds-grp.node-code.
     1930       end.
     1931     end.
     1932   end.
     1933   end .
     1934   procedure grplib-get-root-code :
     1935   do
     1936   on error undo, return error
     1937   :
     1938   define output parameter p-root-code as integer      no-undo.
     1939       define buffer buf_gds-grp       for ub.gds-grp.
     1940       find first buf_gds-grp no-lock
     1941           where buf_gds-grp.upper-code = 0
     1942       no-error .
     1943       if not available buf_gds-grp
     1944       then do:
     1945           undo, return error .
     1946       end.
     1947       else do:
     1948           assign
     1949               p-root-code = buf_gds-grp.node-code
     1950           .
     1951       end.
     1952   end.
     1953   end procedure.
     1954   procedure grplib-find-grp-by-full-name :
     1955   do
     1956   on error undo, return error
     1957   :
     1958   define input parameter p-search-name  as character    no-undo.
     1959   define input parameter p-fill-path    as logical      no-undo.
     1960   define output parameter p-found       as logical      no-undo.
     1961       define variable v-upper-code    as integer          no-undo.
     1962       define variable v-counter       as integer           no-undo.
     1963       define variable v-level         as integer           no-undo.
     1964       define variable v-full-name     as character         no-undo.
     1965       define variable v-sort-name     as character         no-undo.
     1966       define buffer buf_gds-grp       for ub.gds-grp.
     1967       assign
     1968           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1969       .
     1970       run grplib-get-root-code ( output v-upper-code ) no-error .
     1971       if error-status :error
     1972       then do:
     1973           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1974       end.
     1975       assign
     1976           v-full-name  = ""
     1977           v-level      = num-entries( p-search-name, chr(2) )
     1978       .
     1979       for each temp_grplib_found-grp
     1980       :
     1981           delete temp_grplib_found-grp.
     1982       end.
     1983       start-name-analyze:
     1984       do v-counter = 1 to v-level
     1985       :
     1986           if v-counter < v-level
     1987           then do:
     1988               find first buf_gds-grp no-lock
     1989                    where buf_gds-grp.upper-code = v-upper-code
     1990                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1991               no-error .
     1992               if not available buf_gds-grp
     1993               then do:
     1994                   assign
     1995                       v-full-name  = p-search-name
     1996                       v-sort-name  = p-search-name
     1997                   .
     1998                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1999               end.
     2000               else do:
     2001                   assign
     2002                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     2003                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     2004                       v-upper-code = buf_gds-grp.node-code
     2005                   .
     2006                   if p-fill-path = yes
     2007                   then do:
     2008                       create temp_grplib_found-grp.
     2009                       assign
     2010                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     2011                           temp_grplib_found-grp.sort-name = v-sort-name
     2012                           temp_grplib_found-grp.node-code = v-upper-code
     2013                           temp_grplib_found-grp.level     = v-counter
     2014                       .
     2015                   end.
     2016               end.
     2017           end.
     2018           else do:
     2019               for each buf_gds-grp no-lock
     2020                  where buf_gds-grp.upper-code = v-upper-code
     2021                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     2022               :
     2023                   assign
     2024                       p-found = yes
     2025                   .
     2026                   create temp_grplib_found-grp.
     2027                   assign
     2028                       temp_grplib_found-grp.full-name = v-full-name
     2029                                                           + (if v-full-name = "" then "" else chr(47) )
     2030                                                           + buf_gds-grp.node-name + chr(47)
     2031                       temp_grplib_found-grp.sort-name = v-sort-name
     2032                                                           + ( if v-sort-name = "" then "" else chr(2) )
     2033                                                           + buf_gds-grp.node-name
     2034                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     2035                       temp_grplib_found-grp.level     = v-level
     2036                   .
     2037               end.
     2038               if p-found = no
     2039               then do:
     2040                   assign
     2041                       v-full-name  = p-search-name
     2042                       v-sort-name  = p-search-name
     2043                   .
     2044                   for each temp_grplib_found-grp
     2045                   :
     2046                       delete temp_grplib_found-grp.
     2047                   end.
     2048                   assign
     2049                       p-found = no
     2050                   .
     2051               end.
     2052           end.
     2053       end.
     2054   end.
     2055   end procedure.
     2056   procedure grplib-find-all-subgroup :
     2057   do
     2058   on error undo, return error
     2059   :
     2060   define input parameter p-start-node-code    as integer      no-undo.
     2061   define input parameter p-terminal-only      as logical      no-undo.
     2062       define variable v-start-full-name   as character     no-undo.
     2063       define variable v-start-sort-name   as character     no-undo.
     2064       define variable v-not-found         as logical       no-undo.
     2065       define variable v-is-terminal       as logical       no-undo.
     2066       define buffer buf_gds-grp           for ub.gds-grp.
     2067       create temp_found-result-nodelist.
     2068       assign
     2069           temp_found-result-nodelist.node-code = p-start-node-code
     2070           temp_found-result-nodelist.processed = no
     2071       .
     2072       run grplib-get-full-name in this-procedure (
     2073             input p-start-node-code
     2074           , output v-start-full-name
     2075       ).
     2076       run grplib-get-full-name in this-procedure (
     2077             input p-start-node-code
     2078           , output v-start-sort-name
     2079       ).
     2080       process-nodes:
     2081       do while yes
     2082       :
     2083           find first temp_found-result-nodelist
     2084                where temp_found-result-nodelist.node-code = p-start-node-code
     2085           .
     2086           assign
     2087               temp_found-result-nodelist.processed = yes
     2088           .
     2089           for each buf_gds-grp no-lock
     2090              where buf_gds-grp.upper-code = p-start-node-code
     2091           on error undo, return error
     2092           :
     2093               run grplib-is-terminal in this-procedure (
     2094                     input buf_gds-grp.node-code
     2095                   , output v-is-terminal
     2096               ).
     2097               if v-is-terminal = yes
     2098               then do:
     2099                   create temp_grplib_found-grp.
     2100                   assign
     2101                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2102                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     2103                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2104                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     2105                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     2106                       temp_grplib_found-grp.is-terminal = yes
     2107                   .
     2108               end.
     2109               else do:
     2110                   create temp_found-result-nodelist.
     2111                   assign
     2112                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     2113                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2114                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     2115                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2116                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     2117                       temp_found-result-nodelist.processed = no
     2118                   .
     2119                   if p-terminal-only = no
     2120                   then do:
     2121                       create temp_grplib_found-grp.
     2122                       assign
     2123                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2124                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     2125                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2126                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     2127                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     2128                           temp_grplib_found-grp.is-terminal = no
     2129                       .
     2130                   end.
     2131               end.
     2132           end.
     2133           find first temp_found-result-nodelist
     2134                where temp_found-result-nodelist.processed = no
     2135           no-error.
     2136           if not available temp_found-result-nodelist
     2137           then do:
     2138               leave process-nodes.
     2139           end.
     2140           else do:
     2141               assign
     2142                   p-start-node-code = temp_found-result-nodelist.node-code
     2143                   v-start-full-name = temp_found-result-nodelist.full-name
     2144                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2145               .
     2146           end.
     2147       end.
     2148   end.
     2149   end procedure.
     2150   procedure grplib-expand-name :
     2151   define input parameter p-start-name as character        no-undo.
     2152   define output parameter p-end-name  as character        no-undo.
     2153       define variable v-is-terminal   as logical      no-undo.
     2154       define variable v-found         as character    no-undo.
     2155       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     2156   do
     2157   for buf_temp_grplib_found-grp
     2158   on error undo, return error
     2159   :
     2160       run grplib-find-grp-by-full-name in this-procedure (
     2161             input p-start-name
     2162           , input no
     2163           , output v-found
     2164       ) no-error.
     2165       run grplib-get-max-substring in this-procedure (
     2166                   input length( p-start-name )
     2167                 , output p-end-name
     2168       ) no-error .
     2169       if error-status :error
     2170       then do:
     2171           assign
     2172               p-end-name = ""
     2173           .
     2174       end.
     2175       else do:
     2176           find first temp_grplib_found-grp
     2177               where temp_grplib_found-grp.full-name = p-end-name
     2178           no-error.
     2179           if available temp_grplib_found-grp
     2180           then do:
     2181               find first buf_temp_grplib_found-grp
     2182                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     2183                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     2184               no-error.
     2185               if not available buf_temp_grplib_found-grp
     2186               then do:
     2187                   run grplib-is-terminal in this-procedure (
     2188                       input temp_grplib_found-grp.node-code
     2189                       , output v-is-terminal
     2190                   ).
     2191               end.
     2192           end.
     2193       end.
     2194   end.
     2195   end procedure.
     2196   procedure grplib-get-max-substring :
     2197   do
     2198   on error undo, return error
     2199   :
     2200   define input parameter p-min-substring-length   as integer      no-undo.
     2201   define output parameter p-substring             as character    no-undo.
     2202           define variable v-char-counter  as integer           no-undo.
     2203           define variable v-current-char  as character         no-undo.
     2204           define variable v-names-counter  as integer           no-undo.
     2205           define variable v-base-string   as character         no-undo.
     2206           assign
     2207               v-char-counter  = p-min-substring-length
     2208           .
     2209           find first temp_grplib_found-grp no-error.
     2210           if not available temp_grplib_found-grp
     2211           then do:
     2212               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     2213           end.
     2214           else do:
     2215               assign
     2216                   v-base-string  = temp_grplib_found-grp.full-name
     2217                   v-char-counter = 0
     2218               .
     2219               counter-block:
     2220               do while yes
     2221               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2222               :
     2223                   assign
     2224                       v-char-counter  = v-char-counter + 1
     2225                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2226                       v-names-counter = 0
     2227                   .
     2228                   compare-block:
     2229                   for each temp_grplib_found-grp
     2230                   :
     2231                       assign
     2232                           v-names-counter = v-names-counter + 1
     2233                       .
     2234                       if v-names-counter = 1
     2235                       then do:
     2236                           next compare-block.
     2237                       end.
     2238                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2239                       then do:
     2240                           leave counter-block.
     2241                       end.
     2242                   end.
     2243                   if v-names-counter = 1
     2244                   then do:
     2245                       assign
     2246                           p-substring = v-base-string
     2247                       .
     2248                       return.
     2249                   end.
     2250               end.
     2251               assign
     2252                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2253               .
     2254           end.
     2255   end.
     2256   end procedure.
     2257   procedure grplib-is-terminal :
     2258   do
     2259   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     2260   :
     2261   define input parameter p-node-code      as integer      no-undo.
     2262   define output parameter p-is-terminal   as logical      no-undo.
     2263       define buffer buf_gds-grp       for ub.gds-grp.
     2264       find first buf_gds-grp no-lock
     2265           where buf_gds-grp.upper-code = p-node-code
     2266       no-error .
     2267       if not available buf_gds-grp
     2268       then do:
     2269           assign
     2270               p-is-terminal = yes
     2271           .
     2272       end.
     2273       else do:
     2274           assign
     2275               p-is-terminal = no
     2276           .
     2277       end.
     2278   end.
     2279   end procedure.
     2280   procedure grplib-have-goods :
     2281   do
     2282   on error undo, return error
     2283   :
     2284   define input parameter p-node-code      as integer      no-undo.
     2285   define output parameter p-have-goods   as logical      no-undo.
     2286       define buffer buf_goods         for ub.goods.
     2287       find first buf_goods no-lock
     2288            where buf_goods.grp-code = p-node-code
     2289       no-error .
     2290       if available buf_goods
     2291       then do:
     2292           assign
     2293               p-have-goods = yes
     2294           .
     2295       end.
     2296       else do:
     2297           assign
     2298               p-have-goods = no
     2299           .
     2300       end.
     2301   end.
     2302   end procedure.
     2303   procedure grplib-find-by-substring :
     2304   do
     2305   on error undo, return error
     2306   :
     2307   define input parameter p-start-code         as integer      no-undo.
     2308   define input parameter p-full-search-string as character    no-undo.
     2309   define output parameter p-found-code        as integer      no-undo.
     2310   define output parameter p-full-name         as character    no-undo.
     2311       define variable v-start-code     as integer           no-undo.
     2312       define variable v-found          as logical  init no  no-undo.
     2313       define buffer buf_gds-grp       for ub.gds-grp.
     2314       search-grp:
     2315       for each buf_gds-grp no-lock
     2316           where buf_gds-grp.node-code > p-start-code
     2317       :
     2318           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     2319           then do:
     2320               assign
     2321                   p-found-code = buf_gds-grp.node-code
     2322                   v-found      = yes
     2323               .
     2324               run grplib-get-full-name in this-procedure (
     2325                     input p-found-code
     2326                   , output p-full-name
     2327               ) no-error .
     2328               if error-status :error
     2329               then do:
     2330                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2331               end.
     2332               leave search-grp.
     2333           end.
     2334       end.
     2335       if v-found = yes
     2336       then do:
     2337       end.
     2338       else do:
     2339           assign
     2340               p-full-name  = ""
     2341               p-found-code = 0
     2342           .
     2343       end.
     2344   end.
     2345   end procedure.
     2346   procedure grplib-analyze-grp-name :
     2347   do
     2348   on error undo, return error
     2349   :
     2350   define input parameter p-grp-name       as character            no-undo.
     2351   define input parameter p-upper-code     as integer              no-undo.
     2352   define output parameter p-error-message as character init ""    no-undo.
     2353       define variable v-char-list     as character    no-undo.
     2354       define variable v-char-counter  as integer      no-undo.
     2355       define variable v-full-name     as character    no-undo.
     2356       if p-grp-name = "" then do:
     2357           assign
     2358               p-error-message = "Название группы не может быть пустым.".
     2359           .
     2360       end.
     2361       else do:
     2362           assign
     2363               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2364           .
     2365           do v-char-counter = 1 to num-entries( v-char-list )
     2366           :
     2367               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2368               then do:
     2369                   assign
     2370                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2371                   .
     2372                   return.
     2373               end.
     2374           end.
     2375           if p-upper-code > 0
     2376           then do:
     2377               run grplib-get-full-name in this-procedure (
     2378                     input p-upper-code
     2379                   , output v-full-name
     2380               ) no-error .
     2381               if error-status :error
     2382               then do:
     2383                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2384               end.
     2385               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     2386               then do:
     2387                   assign
     2388                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     2389                   .
     2390               end.
     2391           end.
     2392       end.
     2393   end.
     2394   end procedure.
     2395   procedure grplib-get-lvl-num :
     2396   define input parameter p-node-code  as integer      no-undo.
     2397   define output parameter p-lvl-num   as integer      no-undo.
     2398       define variable v-full-name    as character    no-undo.
     2399   do
     2400   on error undo, return error
     2401   :
     2402       run grplib-get-full-name in this-procedure (
     2403             input p-node-code
     2404           , output v-full-name
     2405       ).
     2406       assign
     2407           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     2408       .
     2409       if p-lvl-num = -1
     2410       then do:
     2411           assign
     2412               p-lvl-num = 0
     2413           .
     2414       end.
     2415   end.
     2416   end procedure.
     2417   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2418   define new global shared variable g#attr-lib  as handle no-undo .
     2419   define variable v-attr-lib-variable as handle no-undo .
     2420   procedure gds-attr-name :
     2421     define input  parameter p-code           as character no-undo .
     2422     define output parameter p-type           as character no-undo .
     2423     define output parameter p-format         as character no-undo .
     2424     define output parameter p-label          as character no-undo .
     2425     define output parameter p-user-can-edit  as logical   no-undo .
     2426     define output parameter p-output-display as logical   no-undo .
     2427     define output parameter p-other          as character no-undo .
     2428     do
     2429     on error undo, return error
     2430     :
     2431           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     2432         (input  p-code
     2433         ,output p-type
     2434         ,output p-format
     2435         ,output p-label
     2436         ,output p-user-can-edit
     2437         ,output p-output-display
     2438         ,output p-other
     2439         ) no-error .
     2440       if error-status :error
     2441       then do:
     2442         undo, return error return-value .
     2443       end.
     2444     end.
     2445   end procedure.
     2446   procedure gds-attr-tooltip :
     2447     define input  parameter p-code    as character no-undo .
     2448     define output parameter p-tooltip as character no-undo .
     2449     define output parameter p-label   as character no-undo .
     2450     do
