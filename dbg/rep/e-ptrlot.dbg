      858   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      859   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      860   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      861   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      862   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      863   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      864   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      865   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      866         adm-object-hdl = FRAME F-Main:HANDLE.
      867   RUN ensure-broker.
      868   THIS-PROCEDURE:ADM-DATA =
      869        'ADM1.1~`':U +
      870        'SmartObject~`':U +
      871        '~`':U +
      872        'NO ~`':U +
      873        '~`':U +
      874        '~`':U +
      875        '~`':U +
      876        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      877           + "~`":U +
      878        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      879        'Record-Source,Record-Target,TableIO-Target~`':U +
      880        '~`':U +
      881        '~`~`~`~`~`~`~`~`~`~`~`':U +
      882        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      883            THEN "^^":U
      884        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      885             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      886   PROCEDURE adm-apply-entry :
      887     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      888   END PROCEDURE.
      889   PROCEDURE adm-destroy :
      890    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      891   END PROCEDURE.
      892   PROCEDURE adm-disable :
      893       DISABLE RECT-8 RECT-9 RECT-5 RECT-6 RECT-10 Tog-obj SortType Classify tog-wt tog-dens ShowZero-2 ShowCost ShowCostNDS ShowCost-2 EDITOR-1 ShowSale ShowSaleNDS ShowSale-2 ShowSaleNDS-2 ShowSaleSLT ShowMediator Tog-Excel B-columns WITH FRAME F-Main.
      894       RUN dispatch ('disable-fields':U).
      895       RUN set-attribute-list ('ENABLED=no':U).
      896       RETURN.
      897   END PROCEDURE.
      898   PROCEDURE adm-edit-attribute-list :
      899         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      900         RETURN.
      901   END PROCEDURE.
      902   PROCEDURE adm-enable :
      903       ENABLE UNLESS-HIDDEN RECT-8 RECT-9 RECT-5 RECT-6 RECT-10 Tog-obj SortType Classify tog-wt tog-dens ShowZero-2 ShowCost ShowCostNDS ShowCost-2 EDITOR-1 ShowSale ShowSaleNDS ShowSale-2 ShowSaleNDS-2 ShowSaleSLT ShowMediator Tog-Excel B-columns WITH FRAME F-Main.
      904       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      905       RUN set-attribute-list ('ENABLED=yes':U).
      906       RETURN.
      907   END PROCEDURE.
      908   PROCEDURE adm-exit :
      909        RUN notify ('exit':U).
      910     RETURN.
      911   END PROCEDURE.
      912   PROCEDURE adm-hide :
      913     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      914   END PROCEDURE.
      915   PROCEDURE adm-initialize :
      916     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      917   END PROCEDURE.
      918   PROCEDURE adm-show-errors :
      919       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      920       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      921           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      922       END.
      923       RETURN.
      924   END PROCEDURE.
      925   PROCEDURE adm-UIB-mode :
      926     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      927   END PROCEDURE.
      928   PROCEDURE adm-view :
      929     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      930   END PROCEDURE.
      931   PROCEDURE dispatch :
      932       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      933       RUN broker-dispatch IN adm-broker-hdl
      934           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      935       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      936   END PROCEDURE.
      937   PROCEDURE ensure-broker :
      938   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      939   IF RETURN-VALUE NE "ADM-Broker":U THEN
      940   DO:
      941       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      942       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      943   END.
      944   END PROCEDURE.
      945   PROCEDURE get-attribute :
      946     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      947     RUN broker-get-attribute IN adm-broker-hdl
      948         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      949     RETURN RETURN-VALUE.
      950   END PROCEDURE.
      951   PROCEDURE get-attribute-list :
      952     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      953     RUN broker-get-attribute-list IN adm-broker-hdl
      954         (INPUT THIS-PROCEDURE,
      955          INPUT ?,
      956          OUTPUT p-attr-list) NO-ERROR.
      957     RETURN.
      958   END PROCEDURE.
      959   PROCEDURE new-state :
      960     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      961     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      962     RETURN.
      963   END PROCEDURE.
      964   PROCEDURE notify :
      965     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      966     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      967     IF RETURN-VALUE = "ADM-ERROR":U THEN
      968         RETURN "ADM-ERROR":U.
      969     RETURN.
      970   END PROCEDURE.
      971   PROCEDURE set-attribute-list :
      972     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      973     RUN ensure-broker.
      974     RUN broker-set-attribute-list IN adm-broker-hdl
      975         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      976     RETURN.
      977   END PROCEDURE.
      978   PROCEDURE set-position :
      979       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      980       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      981       IF VALID-HANDLE(adm-object-hdl) THEN
      982       DO:
      983         ASSIGN adm-object-hdl:ROW    =   p-row
      984                adm-object-hdl:COLUMN =   p-col.
      985       END.
      986       RETURN.
      987   END PROCEDURE.
      988   PROCEDURE adm-display-fields :
      989       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      990       RETURN.
      991   END PROCEDURE.
      992   PROCEDURE adm-open-query :
      993     RETURN.
      994   END PROCEDURE.
      995   PROCEDURE adm-row-changed :
      996         IF VALID-HANDLE(adm-object-hdl) THEN
      997           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      998         RUN notify ('row-available':U).
      999         RETURN.
     1000   END PROCEDURE.
     1001   PROCEDURE reposition-query :
     1002       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1003       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1004       RETURN.
     1005   END PROCEDURE.
     1006     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1007     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1008     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1009     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1010     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1011     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1012     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1013     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1014     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1015     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1016     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1017     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1018     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1019     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1020     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1021     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1022     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1023     IF "":U = "":U THEN
     1024       RUN modify-list-attribute IN adm-broker-hdl
     1025         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1026     RUN use-create-on-add(?).
     1027   PROCEDURE adm-add-record :
     1028       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1029          "must have at least one Enabled Table to perform Add.":U
     1030          VIEW-AS ALERT-BOX ERROR.
     1031       RETURN.
     1032   END PROCEDURE.
     1033   PROCEDURE adm-assign-record :
     1034    MESSAGE
     1035          "Object ":U THIS-PROCEDURE:FILE-NAME
     1036            "must have at least one Enabled Table to perform Assign.":U
     1037              VIEW-AS ALERT-BOX ERROR.
     1038      RETURN.
     1039     END PROCEDURE.
     1040   PROCEDURE adm-assign-statement :
     1041     RETURN.
     1042   END PROCEDURE.
     1043   PROCEDURE adm-cancel-record :
     1044      RETURN.
     1045     END PROCEDURE.
     1046   PROCEDURE adm-copy-record :
     1047       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1048        "must have at least one Enabled Table to perform Copy.":U
     1049          VIEW-AS ALERT-BOX ERROR.
     1050       RETURN.
     1051   END PROCEDURE.
     1052   PROCEDURE adm-create-record :
     1053      RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE adm-current-changed :
     1056     RETURN.
     1057   END PROCEDURE.
     1058   PROCEDURE adm-delete-record :
     1059    MESSAGE
     1060          "Object ":U THIS-PROCEDURE:FILE-NAME
     1061            "must have at least one Enabled Table to perform Delete.":U
     1062              VIEW-AS ALERT-BOX ERROR.
     1063       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1064       RETURN.
     1065   END PROCEDURE.
     1066   PROCEDURE adm-disable-fields :
     1067         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1068       RETURN.
     1069   END PROCEDURE.
     1070   PROCEDURE adm-enable-fields :
     1071       RETURN.
     1072   END PROCEDURE.
     1073   PROCEDURE adm-end-update :
     1074     RETURN.
     1075   END PROCEDURE.
     1076   PROCEDURE adm-reset-record :
     1077       RETURN.
     1078   END PROCEDURE.
     1079   PROCEDURE adm-update-record :
     1080       MESSAGE
     1081         "Object ":U THIS-PROCEDURE:FILE-NAME
     1082           "must have at least one Enabled Table to perform Update.":U
     1083             VIEW-AS ALERT-BOX ERROR.
     1084      RETURN.
     1085   END PROCEDURE.
     1086   PROCEDURE check-modified :
     1087   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1088   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1089   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1090   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1091     IF check-state = "check":U THEN
     1092     DO:
     1093       RUN get-link-handle IN adm-broker-hdl
     1094         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1095            OUTPUT group-target-list).
     1096       IF group-target-list NE "":U THEN
     1097       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1098         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1099         RUN check-modified IN curr-widget ('group-check':U).
     1100         IF RETURN-VALUE NE "":U THEN
     1101         DO:
     1102           RUN check-modified-message(RETURN-VALUE).
     1103           RETURN "":U.
     1104         END.
     1105       END.
     1106     END.
     1107     RETURN "":U.
     1108   END PROCEDURE.
     1109   PROCEDURE check-modified-message :
     1110     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1111        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1112           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1113        IF RETURN-VALUE = "YES":U THEN
     1114           RUN notify ('view,CONTAINER-SOURCE':U).
     1115        MESSAGE IF p-changed-table NE ? THEN
     1116           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1117           ELSE "Current values have been changed."
     1118           SKIP "  Do you wish to save those changes?"
     1119           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1120        IF ANS THEN
     1121        DO:
     1122           IF group-assign-target THEN
     1123             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1124           ELSE RUN dispatch('update-record':U).
     1125           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1126           DO:
     1127               MESSAGE "Changes to the previous record were not saved."
     1128                 VIEW-AS ALERT-BOX ERROR.
     1129               IF group-assign-target THEN
     1130                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1131               ELSE RUN dispatch ('cancel-record':U).
     1132           END.
     1133        END.
     1134        ELSE DO:
     1135          IF group-assign-target THEN
     1136             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1137          ELSE RUN dispatch('cancel-record':U).
     1138        END.
     1139        RETURN.
     1140   END PROCEDURE.
     1141   PROCEDURE get-rowid :
     1142       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1143       ASSIGN
     1144       p-table   =   adm-first-table.
     1145       RETURN.
     1146   END PROCEDURE.
     1147   PROCEDURE init-group-assign :
     1148       RUN request-attribute IN adm-broker-hdl
     1149         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1150       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1151         group-assign-target = yes.
     1152       ELSE group-assign-target = no.
     1153       RETURN.
     1154   END PROCEDURE.
     1155   PROCEDURE set-editors :
     1156       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1157       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1158       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1159       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1160       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1161       DO WHILE VALID-HANDLE (curr-widget):
     1162           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1163              curr-widget:HIDDEN = no THEN DO:
     1164             CASE p-field-setting:
     1165               WHEN "INITIALIZE":U THEN
     1166               DO:
     1167                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1168                     read-only-list +
     1169                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1170                        STRING(curr-widget).
     1171               END.
     1172               WHEN "DISABLE":U OR
     1173               WHEN "ENABLE":U THEN
     1174               DO:
     1175                   curr-widget:SENSITIVE = yes.
     1176                   RUN get-attribute ('Read-Only-Editors':U).
     1177                   IF RETURN-VALUE = ? OR
     1178                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1179                       curr-widget:READ-ONLY =
     1180                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1181               END.
     1182               WHEN "CLEAR":U THEN
     1183                   curr-widget:SCREEN-VALUE = "":U.
     1184             END CASE.
     1185           END.
     1186           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1187       END.
     1188       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1189         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1190           + '"':U).
     1191       RETURN.
     1192   END PROCEDURE.
     1193   PROCEDURE use-check-modified-all :
     1194    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1195     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1196     RETURN.
     1197   END PROCEDURE.
     1198   PROCEDURE use-create-on-add :
     1199   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1200      RETURN.
     1201   END PROCEDURE.
     1202   PROCEDURE use-initial-lock :
     1203     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1204     ASSIGN adm-initial-lock = p-attr-value.
     1205     RETURN.
     1206   END PROCEDURE.
     1207     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1208   ASSIGN
     1209          FRAME F-Main:SCROLLABLE       = FALSE
     1210          FRAME F-Main:HIDDEN           = TRUE.
     1211   ASSIGN
     1212          EDITOR-1:READ-ONLY IN FRAME F-Main        = TRUE.
     1213   ASSIGN
     1214          tog-ms:HIDDEN IN FRAME F-Main           = TRUE.
     1215   ASSIGN
     1216          Tog-tree:HIDDEN IN FRAME F-Main           = TRUE.
     1217   ON CHOOSE OF B-columns IN FRAME F-Main
     1218   DO:
     1219     run rep/askfield.w ( input "r-oborot":U, output print-o ) .
     1220   END.
     1221   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1222   DO:
     1223     Assign Classify.
     1224       if Classify  Begins "prod":U OR
     1225          Classify  Begins "grp-goods":U OR
     1226          Classify  Begins "vat-ps":U
     1227           then
     1228           enable SumsOnly with frame F-Main .
     1229      if Classify = "no-classify":U
     1230         Then do:
     1231               SumsOnly = FALSE .
     1232               display SumsOnly with frame F-Main .
     1233               disable SumsOnly with frame F-Main .
     1234           end.
     1235      if Classify = "grp-goods":U
     1236            Then do:
     1237               display TOG-lavel   with frame F-Main .
     1238               enable  TOG-lavel   with frame F-Main .
     1239           end.
     1240            Else do:
     1241               display  TOG-lavel  var-Lavel  with frame F-Main .
     1242               disable  TOG-lavel  var-Lavel with frame F-Main .
     1243           end.
     1244   END.
     1245   ON VALUE-CHANGED OF Long-name IN FRAME F-Main
     1246   DO:
     1247     ASSIGN long-name .
     1248   END.
     1249   ON VALUE-CHANGED OF ShowCost IN FRAME F-Main
     1250   DO:
     1251     assign ShowCost.
     1252     if ShowCost then
     1253      enable   ShowCost-2 with frame F-Main .
     1254     else  do:
     1255     ShowCost-2 = false .
     1256     disable ShowCost-2  with frame F-Main .
     1257     end.
     1258   display  ShowCost-2 with frame F-Main.
     1259   END.
     1260   ON VALUE-CHANGED OF ShowZero IN FRAME F-Main
     1261   DO:
     1262      assign ShowZero.
     1263     if ShowZero = no then do:
     1264        ShowZero-3 = no .
     1265        display ShowZero-3 with frame F-Main .
     1266        disable ShowZero-3 with frame F-Main .
     1267     end.
     1268     else enable ShowZero-3 with frame F-Main .
     1269   END.
     1270   ON VALUE-CHANGED OF ShowZero-2 IN FRAME F-Main
     1271   DO:
     1272     assign ShowZero-2.
     1273     if ShowZero-2 = no then do:
     1274        ShowZero = no .
     1275        ShowZero-3 = no .
     1276        display ShowZero ShowZero-3 with frame F-Main .
     1277        disable ShowZero ShowZero-3 with frame F-Main .
     1278     end.
     1279     else enable ShowZero with frame F-Main .
     1280   END.
     1281   ON VALUE-CHANGED OF ShowZero-3 IN FRAME F-Main
     1282   DO:
     1283     assign showzero-3.
     1284         if showzero-3 = no then do:
     1285            display EDITOR-1 with frame F-Main .
     1286         end.
     1287         else hide EDITOR-1 in frame F-Main .
     1288   END.
     1289   ON VALUE-CHANGED OF tog-dens IN FRAME F-Main
     1290   DO:
     1291     assign tog-dens.
     1292     display  tog-dens with frame F-Main.
     1293     run excel-yes in this-procedure.
     1294   END.
     1295   ON VALUE-CHANGED OF Tog-Excel IN FRAME F-Main
     1296   DO:
     1297       ASSIGN Tog-Excel .
     1298     IF Tog-Excel THEN ENABLE Long-name WITH FRAME F-Main.
     1299         ELSE
     1300       DISABLE Long-name WITH FRAME F-Main.
     1301   END.
     1302   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1303   DO:
     1304     if tog-lavel:screen-value = string(TRUE)
     1305           Then do:
     1306               display  var-Lavel with frame F-Main .
     1307               enable   var-Lavel  with frame F-Main .
     1308           end.
     1309            Else do:
     1310               display    var-Lavel  with frame F-Main .
     1311               disable    var-Lavel  with frame F-Main .
     1312           end.
     1313   END.
     1314   ON VALUE-CHANGED OF Tog-tree IN FRAME F-Main
     1315   DO:
     1316     if tog-tree:screen-value=string(TRUE)
     1317           Then do:
     1318               assign
     1319                   SumsOnly = true
     1320                   tog-wt   = false
     1321                   tog-ms   = false
     1322               .
     1323               display
     1324                   SumsOnly
     1325                   tog-wt
     1326                   tog-ms
     1327               with frame F-Main .
     1328               disable
     1329                   SumsOnly
     1330                   tog-wt
     1331                   tog-ms
     1332               with frame F-Main .
     1333           end.
     1334            Else do:
     1335               display
     1336                   SumsOnly
     1337                   tog-wt
     1338                   tog-ms
     1339               with frame F-Main .
     1340               enable
     1341                   SumsOnly
     1342                   tog-wt
     1343                   tog-ms
     1344               with frame F-Main .
     1345           end.
     1346   END.
     1347   if not this-procedure :persistent
     1348   then do:
     1349     message
     1350       vss-workfile vss-revision vss-description skip
     1351       "Ошибка при запуске процедуры" skip
     1352       "Данную процедуру следует запускать только с параметром persistent" skip
     1353       view-as alert-box error .
     1354     undo, return error .
     1355   end.
     1356   PROCEDURE disable_UI :
     1357     HIDE FRAME F-Main.
     1358     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1359   END PROCEDURE.
     1360   PROCEDURE excel-yes :
     1361   do
     1362   on error undo, return error
     1363   :
     1364      IF ShowCost
     1365      OR ShowCost-2
     1366      OR ShowCostNDS
     1367      OR ShowMediator
     1368      OR ShowSale
     1369      OR ShowSale-2
     1370      OR ShowSaleNDS
     1371      OR ShowSaleNDS-2
     1372      OR ShowSaleSLT
     1373      OR Tog-Dens
     1374      THEN DO:
     1375         ASSIGN
     1376            Tog-Excel = YES
     1377         .
     1378         DISPLAY  Tog-Excel WITH FRAME F-Main.
     1379      END.
     1380   end.
     1381   end procedure.
     1382   PROCEDURE local-apply-layout :
     1383   disable ShowCost-2 with frame F-Main.
     1384   display  ShowCost-2 with frame F-Main.
     1385   run excel-yes in this-procedure.
     1386   IF tog-excel = NO THEN
     1387      DISABLE long-name with frame F-Main.
     1388   ELSE enable long-name with frame F-Main.
     1389     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1390   END PROCEDURE.
     1391   PROCEDURE local-initialize :
     1392   define variable l-ind as integer no-undo .
     1393   define buffer   buf_usr-flt for ubflt.usr-flt  .
     1394     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1395      Tog-obj:screen-value in frame F-Main = string(True).
     1396      var-lavel:screen-value in frame F-Main = '1'.
     1397       repeat l-ind = 1 to 28 :
     1398             use-column[ l-ind ] =  false  .
     1399       End.
     1400    find first buf_usr-flt no-lock  where
     1401               buf_usr-flt.user-name  = v-cntxt-userid and
     1402               buf_usr-flt.call-point = "r-oborot":U
     1403               no-error .
     1404        if not available buf_usr-flt then do:
     1405           run rep/askfield.w ( input "r-oborot":U, output print-o ).
     1406        end.
     1407        if available  buf_usr-flt then  DO:
     1408             v-nn = num-entries(buf_usr-flt.list_) .
     1409             repeat l-ind = 1 to v-nn :
     1410               if index ( entry(l-ind,buf_usr-flt.list_),"=") = 0 THEN DO :
     1411                   if int(entry(l-ind,buf_usr-flt.list_)) > 0 and
     1412                      int(entry(l-ind,buf_usr-flt.list_)) <= 28
     1413                      then
     1414                      use-column[int(entry(l-ind,buf_usr-flt.list_)) ] =  true  .
     1415               end.
     1416               else do :
     1417                   if entry(1,entry(l-ind,buf_usr-flt.list_),"=")  = "print-o":U then
     1418                       print-o = entry(2,entry(l-ind,buf_usr-flt.list_),"=") no-error .
     1419                   if error-status :error Or print-o = "" then DO:
     1420                     run rep/askfield.w ( input "r-oborot":U, output print-o ).
     1421                     return no-apply.
     1422                   end.
     1423               end.
     1424             end.
     1425         end.
     1426   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1427   do:
     1428     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
