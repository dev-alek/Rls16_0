     1488   PROCEDURE my-report :
     1489   define buffer buf_goods for ub.goods  .
     1490   define buffer buf_units for ub.units  .
     1491   for each gds-list :
     1492     delete gds-list.
     1493   end.
     1494   for each buf_units no-lock where
     1495         lookup( 'топ':U, buf_units.type) > 0,
     1496     each buf_goods no-lock where
     1497           buf_goods.unit-base = buf_units.unit-name
     1498           :
     1499     create gds-list.
     1500     buffer-copy buf_goods to  gds-list .
     1501   end.
     1502   case sorttype :
     1503     when "sort-artic" then do:
     1504        run proc-e-obor3-r in this-procedure .
     1505     end.
     1506     when "sort-code" then do:
     1507        run proc-e-obor3-c in this-procedure .
     1508     end.
     1509     when "sort-name" then do:
     1510        run proc-e-obor3-n in this-procedure .
     1511     end.
     1512   end case.
     1513   END PROCEDURE.
     1514   PROCEDURE my-var :
     1515   Assign frame F-Main SumsOnly ShowZero tog-obj Classify SortType
     1516          ShowCost ShowCostNDS ShowSale ShowSaleNDS  ShowSale-2 ShowSaleNDS-2
     1517          TOG-excel ShowZero-2 tog-lavel var-lavel tog-tree ShowMediator
     1518          ShowSaleSLT ShowCost-2 ShowZero-3 long-name tog-wt tog-ms tog-dens .
     1519   v-show-all-goods  = ShowZero-3 .
     1520   Assign
     1521    STR-obj-type = ''
     1522    STR-obj-code = ''
     1523    STR-obj-name = ''
     1524    STR-obj      = '' .
     1525   For each obj-list no-lock:
     1526    Assign
     1527    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1528    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1529    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1530    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1531   End.
     1532   ReportNAme = "О Т Ч Е Т   О   С О С Т О Я Н И И   З А П А С А   И   П Р О Д А Ж А Х   ( О Б О Р О Т Н А Я   В Е Д О М О С Т Ь ) по типам документов".
     1533   def var t-class as char no-undo.
     1534   def var t-sort as char no-undo.
     1535     case classify:
     1536       when "no-classify":u    then t-class =   "Без классификации" .
     1537       when "prod":u           then t-class =   "Производители"   .
     1538       when "post":u           then t-class =   "Поставщики"   .
     1539       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1540       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1541       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1542       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1543       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1544       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1545       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1546       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1547       when  "t-level":u       then t-class =   "Терминальные группы" .
     1548    end case.
     1549     case sorttype:
     1550       when "sort-pp":u               then t-sort =   "по порядку" .
     1551       when "sort-code":u             then t-sort =   "по коду" .
     1552       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1553       when "sort-qunty":u            then t-sort =   "по реализации".
     1554       when "sort-name":u             then t-sort =   "по наименованию".
     1555       when "sort-type":u             then t-sort =   "по типу ткани".
     1556       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1557       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1558    end case.
     1559   ReportHeader = "Классификация : " + t-Class.
     1560   ReportHeader = ReportHeader +
     1561                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     1562   ReportHeader = ReportHeader  + chr(10).
     1563   ASSIGN ReportHeader = "Классификация : " + t-Class +
     1564                           ( IF Tog-Lavel = YES THEN "    Итоги с уровня  " + STRING( Var-Lavel ) ELSE " ":U ) + chr(10) +
     1565                           "Сортировка " + t-Sort + chr(10) + "Показать : " +
     1566                           ( IF SumsOnly      = YES THEN " Только итоги, "                  ELSE " ":U ) +
     1567                           ( IF ShowCost      = YES THEN " Суммы в учетных ценах, "         ELSE " ":U ) +
     1568                           ( IF ShowCost-2    = YES THEN " Суммы в учетных ценах без НДС, " ELSE " ":U ) +
     1569                           ( IF ShowCostNDS   = YES THEN " НДС в учетных ценах, "           ELSE " ":U ) +
     1570                           ( IF ShowSale      = YES THEN " Суммы в продажных ценах, "       ELSE " ":U ) +
     1571                           ( IF ShowSaleNDS   = YES THEN " НДС в продажных ценах "          ELSE " ":U ) +
     1572                           ( IF ShowSale-2    = YES THEN " Суммы в ценах документа, "       ELSE " ":U ) +
     1573                           ( IF ShowSaleNDS-2 = YES THEN " НДС в ценах документа"           ELSE " ":U ) +
     1574                           ( IF ShowSaleSLT   = YES THEN " НсП в ценах документа"           ELSE " ":U ) +
     1575                           ( IF ShowMediator  = YES THEN " Суммы в ценах посредника"        ELSE " ":U ) + chr(10) +
     1576                           ( IF Tog-Tree      = YES THEN " группировка ввиде дерева"        ELSE " ":U ) + chr(10) +
     1577                           ( IF Tog-Dens      = YES THEN " Плотность"                       ELSE " ":U ) +
     1578                           ( IF ShowZero      = YES THEN " Показывать нулевые остатки "     ELSE " Не показывать нулевые остатки" ) +
     1579                           ( IF ShowZero-2    = YES THEN " Показывать нулевые обороты "     ELSE " Не показывать нулевые обороты" ) +
     1580                           ( IF RServ <> 'все':U THEN chr(10) + "Только " + RServ ELSE " ":U ).
     1581   ReportHeader = ReportHeader + (if Rserv <> 'все':U     then  chr(10) + "Только " + Rserv  else " "  ) .
     1582   if tog-tree and (use-column [1] = false OR use-column [2] = false  ) then  do:
     1583      message "Для получения отчета с группировкой по дереву должны быть выбраны колонки  Код и Артикул !" view-as alert-box .
     1584   return error.
     1585   end.
     1586   END PROCEDURE.
