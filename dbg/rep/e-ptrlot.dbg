     4569       input ShowSale-2       ,
     4570       input ShowSaleNDS-2    ,
     4571       input tog-lavel        ,
     4572       input var-lavel        ,
     4573       input rserv            ,
     4574       input ShowMediator     ,
     4575       input ShowSaleSLT      ,
     4576       input ShowCost-2       ,
     4577       input long-name        ,
     4578       input tog-wt           ,
     4579       input tog-ms           ,
     4580       input is-petrl         ,
     4581       input tog-dens
     4582       ) .
     4583           else
     4584           run rep/xlobor6n.p
     4585      (input v-cntxt-obj-code ,
