     5076               where bf_gds-cell.obj-type  = gds-cell.obj-type
     5077                 and bf_gds-cell.obj-code  = gds-cell.obj-code
     5078                 and bf_gds-cell.doc-code  = gds-cell.doc-code
     5079                 and bf_gds-cell.gds-order = jj
     5080               no-error .
     5081             if available bf_gds-cell then do:
     5082               put stream text_out unformatted
     5083                 ":" + string( OutQty( bf_gds-cell.qnty  ), "x(12)":U ) +
     5084                 ":" + string( OutSum( bf_gds-cell.price ), "x(12)":U )
     5085               .
