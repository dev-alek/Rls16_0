     5198                 string( "":U,                           "x(12)":U ) CHR(9)
     5199               .
     5200             end.
     5201           end.
     5202         end.
     5203         for each gds-total where
     5204                  gds-total.obj-type = tt_object.obj-type and
     5205                  gds-total.obj-code = tt_object.obj-code
     5206         break by gds-total.obj-type
     5207               by gds-total.obj-code
     5208               by gds-total.gds-order
     5209               by gds-total.gds-code
     5210         :
     5211           do jj = 1 to j_columns-total :
     5212             if gds-total.gds-order = jj
     5213             then do:
     5214               put stream text_out unformatted
     5215                 ":" + string( OutSum( gds-total.total-sum  ), "x(12)":U )
     5216               .
     5217               if Make-Excel then  put   stream ForExcel unformatted
     5218                 string( OutSum( gds-total.total-sum  ), "x(12)":U ) CHR(9)
     5219               .
     5220             end.
     5221           end.
     5222         end.
     5223         put stream text_out unformatted
     5224           ":" skip
     5225               Under-Line
     5226               skip
     5227         .
     5228         page stream text_out .
     5229         if Make-Excel then  put   stream ForExcel unformatted
     5230           skip
     5231         .
     5232         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     5233       end.
     5234       else do:
     5235         if XLS-page-num > 0
     5236         then do:
     5237           if not available SheetF
     5238           then do:
     5239             find first SheetF where
     5240                        SheetF.Sheet-Num = XLS-page-num no-error .
     5241           end.
     5242           if available SheetF
     5243           then do:
     5244             delete SheetF .
     5245           end.
     5246           assign
     5247             XLS-page-num = XLS-page-num - 1
     5248           .
     5249         end.
     5250       end.
     5251     end.
     5252     if gds-gas-found = yes
     5253     then do:
     5254       for each tt_object no-lock
     5255       :
     5256         if tt_object.gas-found <> yes
     5257         then do:
     5258           next .
     5259         end.
     5260         if tt_object.gas-found = yes
     5261         then do:
     5262           assign
     5263             ReportName       = "":U
     5264             ReportHeader     = "":U
     5265             str1             = "":U
     5266             str2             = "":U
     5267             str3             = "":U
     5268             str4             = "":U
     5269             Header-Line0     = "-------------------------------------------------------------------------------------------------"
     5270             Header-Line1     = ":          :              :                              :" + Centering( tt_object.obj-name, 38 ) + ":"
     5271             Header-Line2     = ":   Дата   :   № док-та   :         Постачальник         :------------:------------:------------:"
     5272             Header-Line3     = ":          :              :                              : Кол-во, л. : Цена прих. : Сумма,грн. :"
     5273             Header-Line4     = ":----------:--------------:------------------------------:------------:------------:------------:"
     5274             Header-add-Line0 = "":U
     5275             Header-add-Line1 = "":U
     5276             Header-add-Line2 = "":U
     5277             Header-add-Line3 = "":U
     5278             Header-add-Line4 = "":U
     5279           .
     5280           assign
     5281             j_excel-row = 0
     5282             j_excel-col = 0
     5283           .
     5284           assign
     5285             ReportName  = substitute( 'Отчет по приходу нефтепродуктов на &1. Газ'
     5286                                     , tt_object.obj-name
     5287                                     )
     5288             j_length    = 97
     5289             Under-Line  = fill( "-", j_length )
     5290             Header-Name = Centering(  caps( ReportName ), j_length ) +
     5291                           chr(10) +
     5292                           chr(10) +
     5293                           substitute( "за период с &1 по &2"
     5294                                     , string( x-Date-Start, "99/99/9999":U )
     5295                                     , string( x-Date-End,   "99/99/9999":U )
     5296                                     ) +
     5297                           ShiftRight( substitute( "Дата печати: &1, время: &2"
     5298                                                 , string( t_today, "99.99.9999":U )
     5299                                                 , string( j_time,  "HH:MM:SS":U   )
     5300                                                 )
     5301                                     , j_length - 36 )
     5302             ReportHeader = substitute( "за период с &1 по &2"
     5303                                      , string( x-Date-Start, "99/99/9999":U )
     5304                                      , string( x-Date-End,   "99/99/9999":U )
     5305                                      ) +
     5306                            ShiftRight( substitute( "Дата печати: &1, время: &2"
     5307                                                  , string( t_today, "99.99.9999":U )
     5308                                                  , string( j_time,  "HH:MM:SS":U   )
     5309                                                  )
     5310                                      , j_length - 44 )
     5311           .
     5312           put stream text_out unformatted
     5313             Header-Name  skip
     5314             Header-Line0 skip
     5315             Header-Line1 skip
     5316             Header-Line2 skip
     5317             Header-Line3 skip
     5318             Header-Line4 skip
     5319           .
     5320           assign
     5321             XLS-page-num = XLS-page-num + 1
     5322           .
     5323           find first SheetF where
     5324                      SheetF.Sheet-Num = XLS-page-num no-error .
     5325           if not available SheetF
     5326           then do:
     5327             create SheetF .
     5328             assign
     5329               SheetF.Sheet-Num = XLS-page-num
     5330             .
     5331           end.
     5332           assign
     5333             SheetF.MergeCellsH        = "4:6"
     5334             SheetF.MergeCellsV        = "1=1:2/2=1:2/3=1:2"
     5335             SheetF.Excel-Column-Lable = "Дата"              + chr(44) +
     5336                                         "№ док-та"          + chr(44) +
     5337                                         "Постачальник"      + chr(44) +
     5338                                replace( tt_object.obj-name,   chr(44) , chr(32) )
     5339                                                             + chr(44)
     5340                                                             + chr(44) + chr(10)
     5341                                                             + chr(44)
     5342                                                             + chr(44)
     5343                                                             + chr(44) +
     5344                                         "Кол-во (л)"        + chr(44) +
     5345                                         "Цена прих."        + chr(44) +
     5346                                         "Сумма грн."
     5347             SheetF.ColFormat          = "4=" + "0" + v-delim + "000" + ";" +
     5348                                         "5=" + "0" + v-delim + "00"  + ";" +
     5349                                         "6=" + "0" + v-delim + "00"
     5350             SheetF.Sizes              = "10,14,30,12,12,12"
     5351           .
     5352           for each gds-ptrl no-lock where
     5353                    gds-ptrl.obj-type = tt_object.obj-type and
     5354                    gds-ptrl.obj-code = tt_object.obj-code and
     5355                    gds-ptrl.is-gas   = yes
     5356             , each gds-cell no-lock where
     5357                    gds-cell.obj-type = gds-ptrl.obj-type and
     5358                    gds-cell.obj-code = gds-ptrl.obj-code and
     5359                    gds-cell.gds-code = gds-ptrl.gds-code
     5360           :
     5361             assign
     5362               j_excel-row = j_excel-row + 1
     5363             .
     5364           end.
     5365           assign
     5366             vcurr-sheet-name = tt_object.obj-name + ". ГАЗ"
     5367           .
     5368           assign
     5369             Sheetf.Bas-File      = "inptlug1.bas"
     5370             Sheetf.Bas-Param-Add = yes
     5371             Sheetf.Bas-Params    = "Gas"                  + chr(4) +
     5372                                    string( j_excel-row  ) + chr(4) +
     5373                                    "1"
     5374             SheetF.ColFormat     = SheetF.ColFormat       + chr(4) +
     5375                                                             chr(4) +
     5376                                    vcurr-sheet-name
     5377           .
     5378           run rep/extitle.p
     5379             ( input XLS-page-num
     5380             ) no-error .
     5381           assign
     5382             d_total-qnty = 0.00
     5383             d_total-sum  = 0.00
     5384           .
     5385           for each gds-ptrl no-lock where
     5386                    gds-ptrl.obj-type = tt_object.obj-type and
     5387                    gds-ptrl.obj-code = tt_object.obj-code and
     5388                    gds-ptrl.is-gas   = yes
     5389             , each gds-cell no-lock where
     5390                    gds-cell.obj-type = gds-ptrl.obj-type and
     5391                    gds-cell.obj-code = gds-ptrl.obj-code and
     5392                    gds-cell.gds-code = gds-ptrl.gds-code
     5393           break by gds-cell.doc-code
     5394                 by gds-ptrl.artic
     5395                 by gds-ptrl.prod-type
     5396                 by gds-ptrl.prod-code
     5397           :
     5398             assign
     5399               d_summa = gds-cell.price * gds-cell.qnty
     5400             .
     5401             put stream text_out unformatted
     5402               ":" + string(         gds-cell.doc-date,  "99.99.9999":U ) +
     5403               ":" + string(         gds-cell.doc-code,  "x(14)":U      ) +
     5404               ":" + string(         gds-cell.supp-name, "x(30)":U      ) +
     5405               ":" + string( OutQty( gds-cell.qnty  ),   "x(12)":U      ) +
     5406               ":" + string( OutSum( gds-cell.price ),   "x(12)":U      ) +
     5407               ":" + string( OutSum( d_summa ),          "x(12)":U      ) +
     5408               ":"   skip
     5409             .
     5410             if Make-Excel then  put   stream ForExcel unformatted
     5411               string(         gds-cell.doc-date,  "99.99.9999":U ) CHR(9)
     5412               string(         gds-cell.doc-code,  "x(14)":U      ) CHR(9)
     5413               string(         gds-cell.supp-name, "x(30)":U      ) CHR(9)
     5414               string( OutQty( gds-cell.qnty  ),   "x(12)":U      ) CHR(9)
     5415               string( OutSum( gds-cell.price ),   "x(12)":U      ) CHR(9)
     5416               string( OutSum( d_summa ),          "x(12)":U      )
     5417               skip
     5418             .
     5419             assign
     5420               d_total-qnty = d_total-qnty + gds-cell.qnty
     5421               d_total-sum  = d_total-sum  + d_summa
     5422             .
     5423           end.
     5424           put stream text_out unformatted
     5425             Under-Line skip
     5426           .
     5427           put stream text_out unformatted
     5428             ":" + string( "Итого:    ":U,         "x(10)":U ) +
     5429             ":" + string( "":U,                   "x(14)":U ) +
     5430             ":" + string( "":U,                   "x(30)":U ) +
     5431             ":" + string( OutQty( d_total-qnty ), "x(12)":U ) +
     5432             ":" + string( "":U,                   "x(12)":U ) +
     5433             ":" + string( OutSum( d_total-sum  ), "x(12)":U ) +
     5434             ":"   skip
     5435                   Under-Line
     5436                   skip
     5437           .
     5438           page stream text_out .
     5439           if Make-Excel then  put   stream ForExcel unformatted
     5440             string( "Итого:    ":U,         "x(10)":U ) CHR(9)
     5441             string( "":U,                   "x(14)":U ) CHR(9)
     5442             string( "":U,                   "x(30)":U ) CHR(9)
     5443             string( OutQty( d_total-qnty ), "x(12)":U ) CHR(9)
     5444             string( "":U,                   "x(12)":U ) CHR(9)
     5445             string( OutSum( d_total-sum  ), "x(12)":U )
     5446             skip
     5447           .
     5448           if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     5449         end.
     5450       end.
     5451     end.
     5452     output stream text_out close .
     5453     if Make-Excel then output stream ForExcel close.
     5454     run waitfram-hide in this-procedure .
     5455     run prn-lib-prn-file in this-procedure
     5456       ( input my-handle
     5457       , input 8
     5458       ) .
     5459   end.
     5460   procedure get-fo-range :
     5461     define  input parameter p-obj-type   as character no-undo .
     5462     define  input parameter p-obj-code   as integer   no-undo .
     5463     define  input parameter p-date-from  as date      no-undo .
     5464     define  input parameter p-date-till  as date      no-undo .
     5465     define  input parameter p-shift-from as integer   no-undo .
     5466     define  input parameter p-shift-till as integer   no-undo .
     5467     define  input parameter p-is-shift   as logical   no-undo .
     5468     define output parameter p-fo-from    as decimal   no-undo initial 0.00 .
     5469     define output parameter p-fo-till    as decimal   no-undo initial 0.00 .
     5470     define variable v-shift-end-fact-order as decimal no-undo .
     5471     define variable v-day-end-fact-order   as decimal no-undo .
     5472     define variable v-fact-order           as decimal no-undo .
     5473     do
     5474     on error undo, return error return-value
     5475     :
     5476       if p-is-shift = yes
     5477       then do:
     5478         run factord in this-procedure
     5479           (  input p-date-from
     5480           ,  input 1
     5481           ,  input 1
     5482           ,  input p-date-from
     5483           ,  input p-shift-from
     5484           ,  input p-is-shift
     5485           , output p-fo-from
     5486           , output v-shift-end-fact-order
     5487           , output v-day-end-fact-order
     5488           ) no-error .
     5489         if error-status :error
     5490         then do:
     5491           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     5492                   "Ошибка при вызове процедуры factord" skip( 0 )
     5493                   error-status :get-message( 1 ) skip( 0 )
     5494                   return-value skip( 1 )
     5495           view-as alert-box error .
     5496           undo, return error return-value .
     5497         end.
     5498         run factord in this-procedure
     5499           (  input p-date-till
     5500           ,  input 1
     5501           ,  input 1
     5502           ,  input p-date-till
     5503           ,  input p-shift-till
     5504           ,  input p-is-shift
     5505           , output v-fact-order
     5506           , output p-fo-till
     5507           , output v-day-end-fact-order
     5508           ) no-error .
     5509         if error-status :error
     5510         then do:
     5511           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     5512                   "Ошибка при вызове процедуры factord" skip( 0 )
     5513                   error-status :get-message( 1 ) skip( 0 )
     5514                   return-value skip( 1 )
     5515           view-as alert-box error .
     5516           undo, return error return-value .
     5517         end.
     5518       end.
     5519       else do:
     5520         run day-begin-fact-order in this-procedure
     5521           (  input p-date-from
     5522           , output p-fo-from
     5523           ) no-error .
     5524         if error-status :error or
     5525            p-fo-from = ?
     5526         then do:
     5527           assign
     5528             p-fo-from = 0.00
     5529           .
     5530         end.
     5531         run factord-end-day in this-procedure
     5532           (  input p-date-till
     5533           , output p-fo-till
     5534           ) no-error .
     5535         if error-status :error or
     5536            p-fo-till = ?
     5537         then do:
     5538           assign
     5539             p-fo-till = truncate( p-fo-from, 0 ) + 0.99
     5540           .
     5541         end.
     5542       end.
     5543       if p-fo-till < p-fo-from
     5544       then do:
     5545         assign
     5546           p-fo-till = p-fo-from
     5547         .
     5548       end.
     5549     end.
     5550   end procedure.
     5551   procedure cr-gds-list :
     5552     define variable is-petrol as logical no-undo .
     5553     define variable is-pieces as logical no-undo .
     5554     define variable v_gds-attr-value as character no-undo .
     5555     define variable v_gds-attr-type  as character no-undo .
     5556     define variable j_gds-order      as integer   no-undo .
     5557     define variable j_gas-order      as integer   no-undo .
     5558     define variable l_is-gds-gas     as logical   no-undo .
     5559     define buffer bf_gds-obj for ub.gds-obj .
     5560     define buffer bf_goods   for ub.goods   .
     5561     do
     5562     on error undo, return error return-value
     5563     :
     5564       for each obj-list no-lock
     5565       :
     5566         create tt_object .
     5567         assign
     5568           tt_object.obj-type  = obj-list.obj-type
     5569           tt_object.obj-code  = obj-list.obj-code
     5570           tt_object.obj-name  = obj-list.obj-name
     5571           tt_object.obj-id    = obj-list.obj-id
     5572           tt_object.db-num    = obj-list.db-num
     5573           tt_object.was-found = no
     5574           tt_object.gds-found = no
     5575           tt_object.gas-found = no
     5576         .
     5577       end.
     5578       for each tt_object no-lock
     5579       break by tt_object.obj-type
     5580             by tt_object.obj-code
     5581       :
     5582         if first-of( tt_object.obj-code )
     5583         then do:
     5584           assign
     5585             j_gds-order = 0
     5586             j_gas-order = 0
     5587           .
     5588         end.
     5589         for each  bf_gds-obj no-lock where
     5590                   bf_gds-obj.obj-type = tt_object.obj-type and
     5591                   bf_gds-obj.obj-code = tt_object.obj-code
     5592           , first bf_goods   no-lock where
     5593                   bf_goods.gds-code   = bf_gds-obj.gds-code
     5594         :
     5595           find first gds-ptrl no-lock where
     5596                      gds-ptrl.obj-type  = bf_gds-obj.obj-type  and
     5597                      gds-ptrl.obj-code  = bf_gds-obj.obj-code  and
     5598                      gds-ptrl.artic     = bf_gds-obj.artic     and
     5599                      gds-ptrl.prod-type = bf_gds-obj.prod-type and
     5600                      gds-ptrl.prod-code = bf_gds-obj.prod-code no-error .
     5601           if available gds-ptrl
     5602           then do:
     5603             next .
     5604           end.
     5605   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5606     (
     5607        input bf_gds-obj.artic
     5608     ,  input bf_gds-obj.prod-type
     5609     ,  input bf_gds-obj.prod-code
     5610     , output is-petrol
     5611     , output is-pieces
     5612     ) no-error.
     5613           if error-status :error or
     5614              is-petrol <> yes    or
     5615              is-pieces <> no
     5616           then do:
     5617             next .
     5618           end.
     5619           run gds-attr-value in this-procedure
     5620             (  input bf_goods.gds-code
     5621             ,  input 'fuel-type':U
     5622             , output v_gds-attr-value
     5623             , output v_gds-attr-type
     5624             ) no-error .
     5625           if not error-status :error and
     5626              v_gds-attr-value = 'metan':U
     5627           then do:
     5628             assign
     5629               l_is-gds-gas = yes
     5630             .
     5631           end.
     5632           else do:
     5633             assign
     5634               l_is-gds-gas = no
     5635             .
     5636           end.
     5637           if l_is-gds-gas = yes
     5638           then do:
     5639             assign
     5640               j_gas-order = j_gas-order + 1
     5641             .
     5642           end.
     5643           else do:
     5644             assign
     5645               j_gds-order = j_gds-order + 1
     5646             .
     5647           end.
     5648           create gds-ptrl .
     5649           assign
     5650             gds-ptrl.obj-type  = bf_gds-obj.obj-type
     5651             gds-ptrl.obj-code  = bf_gds-obj.obj-code
     5652             gds-ptrl.artic     = bf_gds-obj.artic
     5653             gds-ptrl.prod-type = bf_gds-obj.prod-type
     5654             gds-ptrl.prod-code = bf_gds-obj.prod-code
     5655             gds-ptrl.gds-code  = bf_gds-obj.gds-code
     5656             gds-ptrl.gds-name  = bf_goods.gds-name
     5657             gds-ptrl.is-gas    = l_is-gds-gas
     5658             gds-ptrl.gds-order = ( if l_is-gds-gas = yes then j_gas-order else j_gds-order )
     5659           .
     5660         end.
     5661       end.
     5662     end.
     5663   end procedure.
     5664   procedure get-dec-string :
     5665     define  input parameter p-dec  as decimal   no-undo .
     5666     define  input parameter p-len  as integer   no-undo .
     5667     define output parameter p-char as character no-undo .
     5668     define variable j-len as integer no-undo initial 12 .
     5669     do
     5670     on error undo, return error return-value
     5671     :
     5672       if p-dec = ? or
     5673          p-dec = 0.00
     5674       then do:
     5675         assign
     5676           p-char = fill( " ":U, j-len )
     5677         .
     5678       end.
     5679       else
     5680       if p-len = 3
     5681       then do:
     5682         assign
     5683           p-char = trim( string( p-dec, "->>>>>>9.999":U ) )
     5684         .
     5685       end.
     5686       else
     5687       if p-len = 2
     5688       then do:
     5689         assign
     5690           p-char = trim( string( p-dec, "->>>>>>>9.99":U ) )
     5691         .
     5692       end.
     5693       assign
     5694         p-char = fill( " ":U, j-len - length( trim( p-char ) ) ) + trim( p-char )
     5695       .
     5696     end.
     5697   end procedure.
