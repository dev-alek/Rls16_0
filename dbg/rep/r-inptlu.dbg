     4301   procedure prn-lib-prn-file :
     4302     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4303     define input parameter p-DIsabledoptions as integer no-undo .
     4304     define variable v-report-name as character no-undo .
     4305     define variable v-user-action as character no-undo .
     4306     define variable v-printed     as logical   no-undo .
     4307     define variable v-exist       as logical   no-undo .
     4308     do
     4309       on error undo, return error
     4310       :
     4311       run prn-lib-get-report-name  in this-procedure (
     4312         input parParentProc
     4313         ,output v-report-name
     4314         ).
     4315   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4316   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     4317     (input  v-report-name
     4318     ,input  2
     4319     ,output v-exist
     4320     )  .
     4321       if NOT v-exist then
     4322       DO:
     4323         Message
     4324           "Нет заданий на печать ! "
     4325           view-as alert-box .
     4326         Return  .
     4327       End.
     4328       run gbl/prnfilen.w
     4329         (input  ""
     4330         ,input  p-DisabledOptions
     4331         ,input  string(v-report-name )
     4332         ,input  7
     4333         ,output v-user-action
     4334         ,output v-printed
     4335         ) .
     4336       if v-printed then
     4337       do:
     4338         return "YES" .
     4339       end.
     4340       else
     4341       do:
     4342         return "NO" .
     4343       end.
     4344     end.
     4345   end procedure.
     4346   procedure prn-lib-open-stream :
     4347     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4348     define input parameter p-page-size    as integer no-undo .
     4349     define input parameter p-is-stream    as logical no-undo .
     4350     define input parameter p-append       as logical no-undo .
     4351     define variable v-report-name as character no-undo .
     4352     do
     4353       on error undo, return error
     4354       :
     4355       run prn-lib-get-report-name  in this-procedure (
     4356         input parParentProc
     4357         ,output v-report-name
     4358         ).
     4359       if p-is-stream then
     4360       do:
     4361         if p-append then
     4362         do:
     4363           output stream text_out to value( v-report-name )
     4364             page-size value(p-page-size) append .
     4365         end.
     4366         if not p-append then
     4367         do:
     4368           output stream text_out to value( v-report-name )
     4369             page-size value(p-page-size) .
     4370         end.
     4371       end.
     4372       if not p-is-stream then
     4373       do:
     4374         if p-append then
     4375         do:
     4376           output to value( v-report-name )
     4377             page-size value(p-page-size) append .
     4378         end.
     4379         if not p-append then
     4380         do:
     4381           output to value( v-report-name )
     4382             page-size value(p-page-size) .
     4383         end.
     4384       end.
     4385     end.
     4386   end procedure.
     4387   procedure prn-lib-open-exp :
     4388     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4389     define input parameter p-is-stream    as logical no-undo .
     4390     define input parameter p-is-append    as logical no-undo .
     4391     define output parameter p-ReportFileName as char init "report" no-undo.
     4392     define output parameter p-process as logical no-undo .
     4393     define variable glog as logical no-undo .
     4394     do
     4395       on error undo, return error
     4396       :
     4397       SYSTEM-DIALOG GET-FILE p-ReportFileName
     4398         TITLE      "Укажите путь"
     4399         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     4400         ASK-OVERWRITE
     4401         CREATE-TEST-FILE
     4402         SAVE-AS
     4403         USE-FILENAME
     4404         DEFAULT-EXTENSION "txt"
     4405         UPDATE glog
     4406         .
     4407       if not glog then  return.
     4408       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     4409       if p-is-stream then
     4410       do:
     4411         if p-is-append then
     4412         do:
     4413           OUTPUT stream text_out TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4414         end.
     4415         else
     4416         do:
     4417           OUTPUT stream text_out TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4418         end.
     4419       end.
     4420       else
     4421       do:
     4422         if p-is-append then
     4423         do:
     4424           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4425         end.
     4426         else
     4427         do:
     4428           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4429         end.
     4430       end.
     4431       p-process = yes.
     4432     end.
     4433   end procedure.
     4434   procedure prn-lib-get-report-name :
     4435     define input parameter parParentProc  as widget-handle no-undo.
     4436     define output parameter p-report-name as character no-undo .
     4437     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     4438   end procedure.
     4439   procedure prn-lib-reportviewer-report-name :
     4440     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
