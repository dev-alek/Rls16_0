     4512   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4513   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4514   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     4515   define variable par-type          as character no-undo.
     4516   define variable v-value-character as character no-undo .
     4517   define variable v-value-date      as date      no-undo .
     4518   define variable v-value-decimal   as decimal   no-undo .
     4519   define variable v-value-integer   as integer   no-undo .
     4520   define variable v-value-logical   as logical   no-undo .
     4521   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4522   empty temp-table thbjattr_thbj-attr.
     4523   run adm/shattri.p (
     4524      input "get":U
     4525     ,input v-cntxt-obj-type
     4526     ,input v-cntxt-obj-code
     4527     ,input 'report-firm':U
     4528     ,input  ""
     4529     ,output v-value-character
     4530     ,output v-value-date
     4531     ,output v-value-decimal
     4532     ,output v-value-integer
     4533     ,output v-value-logical
     4534     ,output par-type
     4535     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4536     ) no-error .
     4537     for each thbjattr_thbj-attr :
     4538         if thbjattr_thbj-attr.prop-code = 'XL-delim'  then v_temp-param   = thbjattr_thbj-attr.property-value-character.
     4539     end.
     4540     IF v_temp-param = "" then XL-delim = ";".
     4541     else XL-delim = v_temp-param.
     4542     for each SheetF where
     4543              SheetF.Sheet-Num > 1
     4544     :
     4545       delete SheetF .
     4546     end.
     4547     run cr-gds-list in this-procedure no-error .
     4548     run prn-lib-open-stream in this-procedure
     4549       ( input my-handle
     4550       , input 43
     4551       , input yes
     4552       , input no
     4553       ) .
     4554     for each tt_object no-lock
     4555     :
     4556       assign
     4557         ReportName       = "":U
     4558         ReportHeader     = "":U
     4559         str1             = "":U
     4560         str2             = "":U
     4561         str3             = "":U
     4562         str4             = "":U
     4563         Header-Line0     = "-------------------------------------------------------------------------------------------------------------------"
     4564         Header-Line1     = ":          :              :                              :                       Перевозчик                       :"
     4565         Header-Line2     = ":   Дата   :   № док-та   :           Источник           :------------------------------:------------:------------:"
     4566         Header-Line3     = ":          :              :                              :              ООО             : Сумма, грн : Кол-во (л) :"
     4567         Header-Line4     = ":----------:--------------:------------------------------:------------------------------:-------------------------:"
     4568         Header-add-Line0 = "":U
     4569         Header-add-Line1 = "":U
     4570         Header-add-Line2 = "":U
     4571         Header-add-Line3 = "":U
     4572         Header-add-Line4 = "":U
     4573       .
     4574       assign
     4575         j_excel-row = 0
     4576         j_excel-col = 0
     4577       .
     4578       run get-fo-range in this-procedure
     4579         (  input tt_object.obj-type
     4580         ,  input tt_object.obj-code
     4581         ,  input x-Date-Start
     4582         ,  input x-Date-End
     4583         ,  input x-Shift-Start
     4584         ,  input x-Shift-End
     4585         ,  input x-TOG-Shift
     4586         , output fact-order_from
     4587         , output fact-order_till
     4588         ) no-error .
     4589       if error-status :error
     4590       then do:
     4591         message return-value view-as alert-box .
     4592         return error .
     4593       end.
     4594       assign
     4595         j_columns-total = 0
     4596         j_gds-order     = 0
     4597       .
     4598       assign
     4599         XLS-page-num = XLS-page-num + 1
     4600       .
     4601       find first SheetF where
     4602                  SheetF.Sheet-Num = XLS-page-num no-error .
     4603       if not available SheetF
     4604       then do:
     4605         create SheetF .
     4606         assign
     4607           SheetF.Sheet-Num = XLS-page-num
     4608         .
     4609       end.
     4610       assign
     4611         SheetF.MergeCellsH        = "4:6"
     4612         SheetF.MergeCellsV        = "1=1:2/2=1:2/3=1:2"
     4613         SheetF.Excel-Column-Lable = "Дата"              + chr(44) +
     4614                                     "№ док-та"          + chr(44) +
     4615                                     "Источник"          + chr(44) +
     4616                                     "Перевозчик"        + chr(44) +
     4617                                     "":U                + chr(44) +
     4618                                     "":U
     4619         SheetF.ColFormat          = "5=" + "0" + v-delim + "00"  + ";" +
     4620                                     "6=" + "0" + v-delim + "000"
     4621         SheetF.Sizes              = "10,14,30,30,12,12"
     4622         ext-column-label          = "":U                + chr(44) +
     4623                                     "":U                + chr(44) +
     4624                                     "":U                + chr(44) +
     4625                                     "ООО"               + chr(44) +
     4626                                     "Сумма грн."        + chr(44) +
     4627                                     "Кол-во (л)"
     4628       .
     4629       if gds-ptr-found <> yes
     4630       then do:
     4631         assign
     4632           gds-ptr-found = no
     4633         .
     4634       end.
     4635       if gds-gas-found <> yes
     4636       then do:
     4637         assign
     4638           gds-gas-found = no
     4639         .
     4640       end.
     4641       assign
     4642         goods-found = no
     4643       .
     4644       for each gds-ptrl no-lock where
     4645                gds-ptrl.obj-type = tt_object.obj-type and
     4646                gds-ptrl.obj-code = tt_object.obj-code
     4647             by gds-ptrl.is-gas
     4648             by gds-ptrl.gds-order
     4649             by gds-ptrl.artic
     4650             by gds-ptrl.prod-type
     4651             by gds-ptrl.prod-code
     4652       :
     4653         assign
     4654           goods-found = no
     4655         .
     4656         for each bf_doc-line no-lock where
     4657                  bf_doc-line.obj-type      = gds-ptrl.obj-type  and
     4658                  bf_doc-line.obj-code      = gds-ptrl.obj-code  and
     4659                  bf_doc-line.prod-type     = gds-ptrl.prod-type and
     4660                  bf_doc-line.prod-code     = gds-ptrl.prod-code and
     4661                  bf_doc-line.artic         = gds-ptrl.artic     and
     4662                  bf_doc-line.ext-doc-type  = 'ie':U and
     4663                  bf_doc-line.status_       = 'факт':U            and
     4664                  bf_doc-line.fact-order   >= fact-order_from    and
     4665                  bf_doc-line.fact-order   <= fact-order_till    use-index dt-fo
     4666               by bf_doc-line.fact-order
     4667         :
     4668           assign
     4669             goods-found = yes
     4670           .
     4671           find first bf_trn-doc no-lock where
     4672                      bf_trn-doc.doc-code = bf_doc-line.doc-code .
     4673           find first gds-cell no-lock where
     4674                      gds-cell.obj-type = bf_doc-line.obj-type and
     4675                      gds-cell.obj-code = bf_doc-line.obj-code and
     4676                      gds-cell.gds-code = gds-ptrl.gds-code    and
     4677                      gds-cell.doc-code = bf_doc-line.doc-code no-error .
     4678           if available gds-cell
     4679           then do:
     4680             next .
     4681           end.
     4682           create gds-cell .
     4683           assign
     4684             gds-cell.obj-type  = bf_doc-line.obj-type
     4685             gds-cell.obj-code  = bf_doc-line.obj-code
     4686             gds-cell.gds-code  = gds-ptrl.gds-code
     4687             gds-cell.gds-order = gds-ptrl.gds-order
     4688             gds-cell.doc-code  = bf_doc-line.doc-code
     4689             gds-cell.doc-date  = ( if bf_trn-doc.status_ = 'факт':U then bf_trn-doc.fact-date else bf_trn-doc.doc-date )
     4690             gds-cell.supp-type = bf_trn-doc.cli-type
     4691             gds-cell.supp-code = bf_trn-doc.cli-code
     4692             gds-cell.supp-name = bf_trn-doc.cli-name
     4693             gds-cell.qnty      = bf_doc-line.fact-qnty
     4694           .
     4695           find first bf_object exclusive-lock where
     4696               recid( bf_object ) = recid( tt_object ) .
     4697           if gds-ptrl.is-gas = no
     4698           then do:
     4699             assign
     4700               bf_object.gds-found = yes
     4701             .
     4702             assign
     4703               gds-ptr-found = yes
     4704             .
     4705           end.
     4706           if gds-ptrl.is-gas = yes
     4707           then do:
     4708             assign
     4709               bf_object.gas-found = yes
     4710             .
     4711             assign
     4712               gds-gas-found = yes
     4713             .
     4714           end.
     4715           if bf_object.gas-found = yes or
     4716              bf_object.gds-found = yes
     4717           then do:
     4718             assign
     4719               bf_object.was-found = yes
     4720             .
     4721           end.
     4722           for each tt-allsum-line
     4723           :
     4724             delete tt-allsum-line .
     4725           end.
     4726           run clcprtsl_calc-line in this-procedure
     4727             ( input recid( bf_doc-line )
     4728             ) no-error .
     4729           if error-status :error
     4730           then do:
     4731             message
     4732               substitute( 'Ошибка &1 &2 при вызове процедуры clcprtsl_calc-line для строки документа "&3" по товару &4 &5 &6.'
     4733                         , return-value
     4734                         , error-status :get-message( 1 )
     4735                         , bf_doc-line.doc-code
     4736                         , bf_doc-line.artic
     4737                         , bf_doc-line.prod-type
     4738                         , bf_doc-line.prod-code
     4739                         )
     4740             view-as alert-box error .
     4741             return error return-value .
     4742           end.
     4743           find first tt-allsum-line where
     4744                      tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     4745           if not available tt-allsum-line
     4746           then do:
     4747             message
     4748               substitute( 'Не найдена запись с типом суммы &1 после запуска clcprtsl_calc-line.'
     4749                         , 'основная_сумма':U
     4750                         )
     4751             view-as alert-box error .
     4752             return error return-value .
     4753           end.
     4754           assign
     4755             gds-cell.price = ( tt-allsum-line.sum-dsc-rubl-acc - tt-allsum-line.transport-rubl-acc ) / bf_doc-line.fact-qnty
     4756           .
     4757           for each buf_doc-attr no-lock where
     4758                    buf_doc-attr.doc-code = bf_doc-line.doc-code:
     4759             case buf_doc-attr.attr-code :
     4760               when 'autoent':U then do:
     4761                 assign
     4762                   v-autoent-obj-type = entry (1, buf_doc-attr.attr-value, ";")
     4763                   v-autoent-obj-code = entry (2, buf_doc-attr.attr-value, ";")
     4764                 no-error.
     4765               end.
     4766             end case.
     4767           end.
     4768     assign v-autoent-obj-code-dec = decimal( v-autoent-obj-code ) no-error.
     4769     if error-status :error then do:
     4770       message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     4771               'Ошибка преобразования параметра "autoent-obj-code" в число.'
     4772       view-as alert-box error.
     4773     end.
     4774           assign
     4775               gds-cell.auto-type = v-autoent-obj-type
     4776             .
     4777           assign
     4778             gds-cell.auto-code = v-autoent-obj-code-dec
     4779           .
     4780           find first bf_clients no-lock where
     4781                      bf_clients.obj-type = gds-cell.auto-type and
     4782                      bf_clients.obj-code = gds-cell.auto-code no-error .
     4783           if available bf_clients
     4784           then do:
     4785             assign
     4786               gds-cell.auto-name = bf_clients.obj-name
     4787             .
     4788           end.
     4789         end.
     4790         if goods-found = yes
     4791         then do:
     4792           if gds-ptrl.is-gas = no
     4793           then do:
     4794             assign
     4795               j_columns-total  = j_columns-total  + 1
     4796               j_gds-order      = j_gds-order      + 1
     4797               Header-add-Line0 = Header-add-Line0 + "--------------------------"
     4798               Header-add-Line1 = Header-add-Line1 + Centre( gds-ptrl.gds-name, 25 ) + ":"
     4799               Header-add-Line2 = Header-add-Line2 + "------------:------------:"
     4800               Header-add-Line3 = Header-add-Line3 + "  Кол-во,л  : Цена прих. :"
     4801               Header-add-Line4 = Header-add-Line4 + "------------:------------:"
     4802             .
     4803             assign
     4804               SheetF.Excel-Column-Lable = SheetF.Excel-Column-Lable + chr(44) +
     4805                                           replace( gds-ptrl.gds-name, chr(44), chr(32) )
     4806                                                                     + chr(44)
     4807               ext-column-label          = ext-column-label          + chr(44) +
     4808                                           "Кол-во (л)"              + chr(44) +
     4809                                           "Цена прих."
     4810               SheetF.ColFormat          = SheetF.ColFormat                                                + ";" +
     4811                                           string( j_columns-total * 2 + 5 ) + "=" + "0" + v-delim + "000" + ";" +
     4812                                           string( j_columns-total * 2 + 6 ) + "=" + "0" + v-delim + "00"
     4813               SheetF.Sizes              = SheetF.Sizes                      + chr(44) + "12" +
     4814                                                                               chr(44) + "12"
     4815               SheetF.MergeCellsH        = SheetF.MergeCellsH                + chr(44) +
     4816                                           string( j_columns-total * 2 + 5 ) + ":" +
     4817                                           string( j_columns-total * 2 + 6 )
     4818             .
     4819             if gds-ptrl.gds-order <> j_gds-order
     4820             then do:
