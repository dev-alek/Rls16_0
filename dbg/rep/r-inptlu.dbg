     5109               where bf_gds-cell.obj-type  = gds-cell.obj-type
     5110                 and bf_gds-cell.obj-code  = gds-cell.obj-code
     5111                 and bf_gds-cell.doc-code  = gds-cell.doc-code
     5112                 and bf_gds-cell.gds-order = jj
     5113               no-error .
     5114             if available bf_gds-cell then do:
     5115               assign
