     4149   FUNCTION Centering RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     4150     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     4151     RUN get-centre-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     4152     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     4153   END FUNCTION.
     4154   PROCEDURE get-centre-string :
     4155     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     4156     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     4157     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     4158     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     4159     DEFINE VARIABLE j-left   AS INTEGER NO-UNDO.
     4160     DO ON ERROR UNDO, RETURN ERROR :
     4161       ASSIGN p-instring = TRIM(   p-instring )
     4162              j-format   = LENGTH( p-instring ).
     4163       IF           j-format > p-length THEN DO:
     4164         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     4165       END. ELSE IF j-format < p-length THEN DO:
     4166         ASSIGN j-left      = INTEGER( ( p-length - ( j-format + 1 ) ) * 0.5 )
     4167                p-outstring = FILL( " ":U, j-left ) + p-instring + FILL( " ":U, p-length - ( j-left + j-format ) ).
     4168       END.                             ELSE DO:
     4169         ASSIGN p-outstring = p-instring.
     4170       END.
     4171     END.
     4172   END PROCEDURE.
     4173   FUNCTION ShiftRight RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     4174     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     4175     RUN get-right-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     4176     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     4177   END FUNCTION.
     4178   PROCEDURE get-right-string :
     4179     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     4180     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     4181     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     4182     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     4183     DO ON ERROR UNDO, RETURN ERROR :
     4184       ASSIGN p-instring = TRIM(   p-instring )
     4185              j-format   = LENGTH( p-instring ).
     4186       IF           j-format > p-length THEN DO:
     4187         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     4188       END. ELSE IF j-format < p-length THEN DO:
     4189         ASSIGN p-outstring = FILL( " ":U, p-length - j-format ) + p-instring.
     4190       END.                             ELSE DO:
     4191         ASSIGN p-outstring = p-instring.
     4192       END.
     4193     END.
     4194   END PROCEDURE.
     4195   function Centre returns character ( input i-string as character
     4196                                     , input i-length as integer
     4197                                     ) :
     4198     define variable v-str as character no-undo .
     4199     assign
     4200       v-str = Centering( trim( i-string ), i-length )
     4201     .
     4202     if length( v-str ) < i-length
     4203     then do:
     4204       assign
     4205         v-str = v-str + fill( " ":U, i-length - length( v-str ) )
     4206       .
     4207     end.
     4208     else
     4209     if length( v-str ) > i-length
     4210     then do:
     4211       assign
     4212         v-str = substring( v-str, 1, i-length )
     4213       .
     4214     end.
     4215     return ( v-str  ) .
     4216   end function.
     4217   function OutQty returns character ( input p-qty as decimal ) :
     4218     define variable v-qty as character no-undo .
     4219     run get-dec-string in this-procedure
     4220       (  input p-qty
     4221       ,  input 3
     4222       , output v-qty
     4223       ) no-error .
     4224     return ( if error-status :error then fill( " ":U, 12 ) else v-qty ) .
     4225   end function.
     4226   function OutSum returns character ( input p-sum as decimal ) :
