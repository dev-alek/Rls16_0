     4960                                    , tt_object.obj-name
     4961                                    )
     4962           j_length     = 115 + 39 * j_columns-total
     4963           Under-Line   = fill( "-", j_length )
     4964           Header-Name  = Centering(  caps( ReportName ), j_length ) +
     4965                          chr(10) +
     4966                          chr(10) +
     4967                          ShiftRight( "Примечание: Цена прих. - цена прихода без доставки"
     4968                                    , 165
     4969                                    ) +
     4970                          chr(10) +
     4971                          substitute( "за период с &1 по &2"
     4972                                    , string( x-Date-Start, "99/99/9999":U )
     4973                                    , string( x-Date-End,   "99/99/9999":U )
     4974                                    ) +
     4975                          ShiftRight( substitute( "Дата печати: &1, время: &2"
     4976                                                , string( t_today, "99.99.9999":U )
     4977                                                , string( j_time,  "HH:MM:SS":U   )
     4978                                                )
     4979                                    , j_length - 36 )
     4980         .
     4981         assign
     4982           ReportHeader = substitute( "за период с &1 по &2"
     4983                                    , string( x-Date-Start, "99/99/9999":U )
     4984                                    , string( x-Date-End,   "99/99/9999":U )
     4985                                    ) +
     4986                          ShiftRight( substitute( "Дата печати: &1, время: &2"
     4987                                                , string( t_today, "99.99.9999":U )
     4988                                                , string( j_time,  "HH:MM:SS":U   )
     4989                                                )
     4990                                    , j_length - 36 )
     4991           str3         = "Примечание: Цена прих. - цена прихода без доставки"
     4992         .
     4993         for each gds-ptrl no-lock where
     4994                  gds-ptrl.obj-type = tt_object.obj-type and
     4995                  gds-ptrl.obj-code = tt_object.obj-code and
     4996                  gds-ptrl.is-gas   = no
     4997           , each gds-cell no-lock where
     4998                  gds-cell.obj-type = gds-ptrl.obj-type and
     4999                  gds-cell.obj-code = gds-ptrl.obj-code and
     5000                  gds-cell.gds-code = gds-ptrl.gds-code
     5001         break by gds-cell.doc-code
     5002               by gds-ptrl.artic
