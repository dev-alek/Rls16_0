     4444   procedure prn-lib-reportviewer :
     4445     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4446     define input parameter p-report-name-html as character no-undo .
     4447     define input parameter p-param        as character no-undo .
     4448     define variable v-excel           as character no-undo init 'TRUE' .
     4449     define variable v-value-character as character no-undo .
     4450     define variable v-value-integer   as character no-undo .
     4451     define variable v-value-date      as date      no-undo .
     4452     define variable v-value-decimal   as decimal   no-undo .
     4453     define variable rep-excel         as logical   no-undo .
     4454     define variable excel-string      as character no-undo .
     4455     define variable v-param-type      as character no-undo .
     4456     define variable v-tth             as handle    no-undo .
     4457     run adm/shattri.p (
     4458       input "get":U
     4459       ,input  ""
     4460       ,input  0
     4461       ,input  'report-glob':U
     4462       ,input  'rep-excel':U
     4463       ,output v-value-character
     4464       ,output v-value-date
     4465       ,output v-value-decimal
     4466       ,output v-value-integer
     4467       ,output rep-excel
     4468       ,output v-param-type
     4469       ,INPUT-OUTPUT table-handle v-tth
     4470       )  .
     4471     if rep-excel then v-excel = "TRUE" .
     4472     else v-excel = "FALSE" .
     4473     if p-param eq ""
     4474     then
     4475        p-param = "EXCEL:" + v-excel.
     4476     else
     4477        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     4478     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     4479   end procedure.
