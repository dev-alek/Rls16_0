     4883           SheetF.Sizes     = SheetF.Sizes     + chr(44) + "12"
     4884         .
     4885       end.
     4886       assign
     4887         SheetF.Excel-Column-Lable = SheetF.Excel-Column-Lable         + chr(44) +
     4888                                     "Cумма грн."                      + chr(10)   +
     4889                                     ext-column-label
     4890         SheetF.MergeCellsH        = SheetF.MergeCellsH                + chr(44) +
     4891                                     string( j_columns-total * 2 + 7 ) + ":" +
     4892                                     string( j_columns-total * 3 + 6 )
     4893       .
     4894       assign
     4895         d_total-doc-qnty = 0.00
     4896       .
     4897       for each gds-ptrl no-lock where
     4898                gds-ptrl.obj-type = tt_object.obj-type and
     4899                gds-ptrl.obj-code = tt_object.obj-code and
     4900                gds-ptrl.is-gas   = no
     4901         , each gds-cell no-lock where
     4902                gds-cell.obj-type = gds-ptrl.obj-type and
     4903                gds-cell.obj-code = gds-ptrl.obj-code and
     4904                gds-cell.gds-code = gds-ptrl.gds-code
     4905       break by gds-cell.doc-code
     4906             by gds-cell.gds-code
     4907       :
     4908         assign
     4909           d_total-doc-qnty = d_total-doc-qnty + gds-cell.qnty
     4910         .
     4911         find first gds-total where
     4912                    gds-total.obj-type = gds-cell.obj-type and
     4913                    gds-total.obj-code = gds-cell.obj-code and
     4914                    gds-total.gds-code = gds-cell.gds-code no-error .
     4915         if not available gds-total
     4916         then do:
     4917           create gds-total .
     4918           assign
     4919             gds-total.obj-type      = gds-cell.obj-type
     4920             gds-total.obj-code      = gds-cell.obj-code
     4921             gds-total.gds-code      = gds-cell.gds-code
     4922             gds-total.gds-order     = gds-cell.gds-order
     4923             gds-total.total-qnty    = 0.000
     4924             gds-total.total-sum     = 0.00
     4925             gds-total.total-overall = 0.000
     4926           .
     4927         end.
     4928         assign
     4929           gds-total.total-qnty = gds-total.total-qnty + gds-cell.qnty
     4930           gds-total.total-sum  = gds-total.total-sum  + gds-cell.qnty * gds-cell.price
     4931         .
     4932         if last-of( gds-cell.doc-code )
     4933         then do:
     4934           for each bf_gds-cell exclusive-lock where
