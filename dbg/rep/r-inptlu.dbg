     5172           string( "":U,                       "x(14)":U ) CHR(9)
     5173           string( "":U,                       "x(30)":U ) CHR(9)
     5174           string( "":U,                       "x(30)":U ) CHR(9)
     5175           string( "":U,                       "x(12)":U ) CHR(9)
     5176           string( OutQty( d_total-doc-qnty ), "x(12)":U ) CHR(9)
