     5035           ( input XLS-page-num
     5036           ) no-error .
     5037       end.
     5038       for each gds-cell no-lock
     5039          where gds-cell.obj-type = gds-ptrl.obj-type
     5040            and gds-cell.obj-code = gds-ptrl.obj-code
     5041         , each gds-ptrl no-lock
     5042          where gds-ptrl.obj-type = tt_object.obj-type
     5043            and gds-ptrl.obj-code = tt_object.obj-code
     5044            and gds-ptrl.gds-code = gds-cell.gds-code
     5045            and gds-ptrl.is-gas   = no
     5046       break by gds-cell.doc-code
     5047             by gds-cell.gds-order
     5048             by gds-cell.gds-code
     5049             by gds-ptrl.artic
     5050             by gds-ptrl.prod-type
     5051             by gds-ptrl.prod-code
     5052       :
     5053         if first-of( gds-cell.doc-code )
     5054         then do:
     5055           put stream text_out unformatted
     5056             ":" + string(         gds-cell.doc-date,     "99.99.9999":U ) +
     5057             ":" + string(         gds-cell.doc-code,     "x(14)":U      ) +
     5058             ":" + string(         gds-cell.supp-name,    "x(30)":U      ) +
     5059             ":" + string(         gds-cell.auto-name,    "x(30)":U      ) +
     5060             ":" + fill(           " ":U,                    12          ) +
     5061             ":" + string( OutQty( gds-cell.total-qnty ), "x(12)":U      )
     5062           .
     5063           if Make-Excel then  put   stream ForExcel unformatted
     5064             string(         gds-cell.doc-date,     "99.99.9999":U ) CHR(9)
     5065             string(         gds-cell.doc-code,     "x(14)":U      ) CHR(9)
     5066             string(         gds-cell.supp-name,    "x(30)":U      ) CHR(9)
     5067             string(         gds-cell.auto-name,    "x(30)":U      ) CHR(9)
     5068             fill(           " ":U,                    12          ) CHR(9)
     5069             string( OutQty( gds-cell.total-qnty ), "x(12)":U      ) CHR(9)
     5070           .
     5071           do jj = 1 to j_columns-total :
     5072             assign
