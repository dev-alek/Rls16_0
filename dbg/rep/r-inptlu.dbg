     4822                          bf_gds-ptrl.obj-type  = gds-ptrl.obj-type  and
     4823                          bf_gds-ptrl.obj-code  = gds-ptrl.obj-code  and
     4824                          bf_gds-ptrl.is-gas    = gds-ptrl.is-gas    and
     4825                          bf_gds-ptrl.artic     = gds-ptrl.artic     and
     4826                          bf_gds-ptrl.prod-type = gds-ptrl.prod-type and
     4827                          bf_gds-ptrl.prod-code = gds-ptrl.prod-code .
     4828               for each gds-cell no-lock where
     4829                        gds-cell.obj-type = gds-ptrl.obj-type and
     4830                        gds-cell.obj-code = gds-ptrl.obj-code and
     4831                        gds-cell.gds-code = gds-ptrl.gds-code
     4832               :
     4833                 if gds-cell.gds-order <> j_gds-order
     4834                 then do:
     4835                   find first bf_gds-cell exclusive-lock where
     4836                       recid( bf_gds-cell ) = recid( gds-cell ) .
     4837                   assign
     4838                     bf_gds-cell.gds-order = j_gds-order
     4839                   .
     4840                 end.
     4841               end.
     4842               assign
     4843                 bf_gds-ptrl.gds-order = j_gds-order
     4844               .
     4845             end.
     4846           end.
     4847         end.
     4848         else do:
     4849           find first bf_gds-ptrl exclusive-lock where
     4850                      bf_gds-ptrl.obj-type  = gds-ptrl.obj-type  and
     4851                      bf_gds-ptrl.obj-code  = gds-ptrl.obj-code  and
     4852                      bf_gds-ptrl.is-gas    = gds-ptrl.is-gas    and
     4853                      bf_gds-ptrl.artic     = gds-ptrl.artic     and
     4854                      bf_gds-ptrl.prod-type = gds-ptrl.prod-type and
     4855                      bf_gds-ptrl.prod-code = gds-ptrl.prod-code .
     4856           delete bf_gds-ptrl .
     4857           next .
     4858         end.
     4859       end.
     4860       assign
     4861         jj = j_columns-total * 2 + 6
     4862       .
