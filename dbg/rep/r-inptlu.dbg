     3034           and bf_parts.obj-type  = bf_doc-line.obj-type
     3035           and bf_parts.obj-code  = bf_doc-line.obj-code
     3036           and bf_parts.artic     = bf_doc-line.artic
     3037           and bf_parts.prod-type = bf_doc-line.prod-type
     3038           and bf_parts.prod-code = bf_doc-line.prod-code
     3039       on error undo, return error return-value
     3040       :
     3041         create buf_tt-clcparts .
     3042         buffer-copy bf_parts to buf_tt-clcparts .
     3043         if v-calcbypart = yes   then do:
     3044   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3045     (buffer bf_parts
     3046     ,output v-b-pcode
     3047     ) no-error .
     3048   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3049   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3050     (input  bf_parts.obj-type
     3051     ,input  bf_parts.obj-code
     3052     ,input  v-b-pcode
     3053     ,input  0
     3054     ,input  bf_trn-doc.fact-order
     3055     ,output vardoc-num
     3056     ,output varprice-salef
     3057     ,output varroad-tax
     3058     ,output varexcise
     3059     ) no-error .
     3060             if varprice-sale = ?
     3061             then do:
     3062               assign
     3063                 varprice-salef = 0
     3064                 varroad-tax   = 0
     3065                 varexcise     = 0
     3066               .
     3067             end.
     3068             assign
     3069             part-cur-base  = varprice-salef
     3070             part-cur-road-tax  = varroad-tax
     3071             part-cur-excise = varexcise.
     3072         end.
     3073       end.
     3074       run clcprtsl_calc-ttable in this-procedure
     3075         (input yes,
     3076          input yes,
     3077          input bf_doc-line.road-tax,
     3078          input bf_doc-line.excise,
     3079          input bf_doc-line.vat-pc,
     3080          input bf_doc-line.cons-vat-pc,
     3081          input bf_doc-line.slt-pc,
     3082          input bf_trn-doc.base-rate,
     3083          input bf_trn-doc.base-scale,
     3084          input varr-b,
     3085          input varcur-base,
     3086          input varcur-road-tax,
     3087          input varcur-excise,
     3088          input varcur-vat-pc,
     3089          input varcur-cons-vat-pc,
     3090          input varcur-slt-pc
     3091          ) no-error.
     3092       if error-status:error then do:
     3093         message
     3094           vss-workfile vss-revision vss-description skip
     3095           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3096           return-value skip
     3097           trim(error-status :get-message(1))
     3098           trim(error-status :get-message(2))
     3099           trim(error-status :get-message(3))
     3100           trim(error-status :get-message(4))
     3101           trim(error-status :get-message(5)) skip
     3102           view-as alert-box error.
     3103         undo, return error .
     3104       end.
     3105     end.
     3106   end.
     3107   end.
     3108   procedure clcprtsl_calc-ttable :
     3109   define input parameter paris-doc           as   logical                 no-undo.
     3110   define input parameter paris-cur           as   logical                 no-undo.
     3111   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3112   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3113   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3114   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3115   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3116   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3117   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3118   define input parameter parr-b              as   character               no-undo.
     3119   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3120   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3121   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3122   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3123   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3124   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3125   define buffer bf_tt-allsum      for tt-allsum.
     3126   define buffer bf_tt-clcparts    for tt-clcparts.
     3127   define buffer bf_tt-allsum-line for tt-allsum-line.
     3128   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3129   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3130   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3131   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3132   define variable varexcise          like ub.price-list.excise     no-undo.
     3133   do on error undo, return error return-value :
     3134   for each bf_tt-allsum-line
     3135   on error undo, return error return-value
     3136    :
     3137     delete bf_tt-allsum-line.
     3138   end.
     3139   for each bf_tt-allsum
     3140   on error undo, return error return-value
     3141   :
     3142     delete bf_tt-allsum.
     3143   end.
     3144   for each bf_tt-clcparts
     3145   on error undo, return error return-value
     3146   :
     3147   if v-calcbypart then do:
     3148             assign
     3149             parcur-base =   bf_tt-clcparts.part-cur-base
     3150             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3151             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3152             .
     3153   end.
     3154      run clcprtsl_calc-parts in this-procedure (
     3155        input recid(bf_tt-clcparts),
     3156        input paris-doc,
     3157        input paris-cur,
     3158        input parroad-tax,
     3159        input parexcise,
     3160        input parvat-pc,
     3161        input parcons-vat-pc,
     3162        input parslt-pc,
     3163        input parbase-rate,
     3164        input parbase-scale,
     3165        input parr-b,
     3166        input parcur-base,
     3167        input parcur-road-tax,
     3168        input parcur-excise,
     3169        input parcur-vat-pc,
     3170        input parcurcons-vat-pc,
     3171        input parcurslt-pc
     3172        ) no-error.
     3173     if error-status:error then do:
     3174       message
     3175         vss-workfile vss-revision vss-description skip
     3176         vss-include-info12 skip
     3177         "Ошибка при обсчете партии" skip
     3178         "Документ партии " bf_tt-clcparts.out-code skip
     3179         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3180         return-value skip
     3181         error-status:get-message(1) skip
     3182         error-status:get-message(2) skip
     3183         error-status:get-message(3) skip
     3184         view-as alert-box error .
     3185       undo, return error .
     3186     end.
     3187     for each bf_tt-allsum on error undo, return error return-value :
     3188       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3189       if not available bf_tt-allsum-line then do:
     3190         create bf_tt-allsum-line.
     3191         assign
     3192           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3193       end.
