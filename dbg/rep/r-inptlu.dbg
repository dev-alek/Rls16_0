     5087                 string( OutQty( bf_gds-cell.qnty  ), "x(12)":U ) CHR(9)
     5088                 string( OutSum( bf_gds-cell.price ), "x(12)":U ) CHR(9)
     5089               .
     5090             end.
     5091             else do:
     5092               put stream text_out unformatted
     5093                 ":" + fill( " ":U, 12 ) +
     5094                 ":" + fill( " ":U, 12 )
     5095               .
