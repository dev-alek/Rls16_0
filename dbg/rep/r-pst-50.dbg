     4672   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4673   procedure Goods-start :
     4674    def buffer  b-post-stk-line for ub.stk-supp-line .
     4675    define variable p-fact-order as decimal no-undo .
     4676     p-fact-order = fact-order-1 .
     4677     Find last temp2-post-stk-line  no-lock where
     4678                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4679                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4680                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4681                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4682                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4683                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4684                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4685                                       temp2-post-stk-line.fact-order <=  fact-order-1               and
     4686                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4687                                       temp2-post-stk-line.cat-id      =  '##':U
     4688                                       no-error .
     4689     Find Last a-post-stk-line  where
     4690         a-post-stk-line.fact-order =   ( if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4691         a-post-stk-line.cat-id     =  t#cat-id      and
     4692         a-post-stk-line.Sum-type   =  t#sum-type    and
     4693         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4694         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4695         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4696         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     4697         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     4698         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type  and
     4699         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4700         no-lock no-error .
     4701         if avail  a-post-stk-line Then
     4702         Assign
     4703           p-fact-order     = a-post-stk-line.fact-order
     4704           Ostatok-start[1] = a-post-stk-line.fact-qnty
     4705           Ostatok-start[2] = IF tPrintRubl THEN  a-post-stk-line.sum-rubl
     4706                                            else a-post-stk-line.sum-base.
     4707           Else
     4708         Assign
     4709           Ostatok-start[1] = 0
     4710           Ostatok-start[2] = 0
     4711         Ostatok-start[8] = 0.
     4712        IF Show-Sale  then do:
     4713                For each b-post-stk-line where
     4714                                            b-post-stk-line.fact-order = p-fact-order and
     4715                                            b-post-stk-line.cat-id     = t#cat-id   and
     4716                                            b-post-stk-line.Sum-type   begins 'sadt':U         and
     4717                                            b-post-stk-line.artic      = temp-t-post-stk-line.artic      and
     4718                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     4719                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     4720                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     4721                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     4722                                            b-post-stk-line.obj-type   = temp-t-post-stk-line.obj-type   and
     4723                                            b-post-stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4724                                            no-lock :
     4725                         IF  tPrintRubl  THEN
     4726                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  + b-post-stk-line.sum-rubl .
     4727                           ELSE
     4728                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  +  b-post-stk-line.sum-base.
     4729                 End.
     4730         End.
     4731    END PROCEDURE.
     4732   procedure Goods-end :
     4733    def buffer  b-post-stk-line for ub.stk-supp-line .
     4734    define variable p-fact-order as decimal no-undo .
     4735     p-fact-order = fact-order-2 .
     4736     Find last temp2-post-stk-line  no-lock where
     4737                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4738                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4739                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4740                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4741                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4742                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4743                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4744                                       temp2-post-stk-line.fact-order <=  fact-order-2               and
     4745                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4746                                       temp2-post-stk-line.cat-id      =  '##':U
     4747                                       no-error .
     4748     Find Last a-post-stk-line  where
     4749         a-post-stk-line.fact-order =   ( if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4750         a-post-stk-line.cat-id     =  t#cat-id       and
     4751         a-post-stk-line.Sum-type   =  t#sum-type     and
     4752         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4753         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4754         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4755         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     4756         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code    and
     4757         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     4758         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4759         no-lock no-error .
     4760     if avail  a-post-stk-line Then do :
     4761         Assign
     4762           p-fact-order     = a-post-stk-line.fact-order
     4763           ostatok-end[1] = a-post-stk-line.fact-qnty
     4764           ostatok-end[2] = if tprintrubl then  a-post-stk-line.sum-rubl
     4765                                          else  a-post-stk-line.sum-base.
     4766           end.
     4767           Else
     4768         Assign
     4769           Ostatok-end[1] = 0
     4770           Ostatok-end[2] = 0.
     4771           Ostatok-end[8] = 0.
     4772        IF Show-Sale  then do:
     4773                For each b-post-stk-line where
     4774                                            b-post-stk-line.fact-order = p-fact-order and
     4775                                            b-post-stk-line.cat-id     = t#cat-id   and
     4776                                            b-post-stk-line.Sum-type    begins 'sadt':U         and                                         b-post-stk-line.artic      = post-stk-line.artic      and
     4777                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     4778                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     4779                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     4780                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     4781                                            b-post-stk-line.obj-type   = temp-t-post-stk-line.obj-type   and
     4782                                            b-post-stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4783                                            no-lock :
     4784                         IF  tPrintRubl  THEN
     4785                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  + b-post-stk-line.sum-rubl .
     4786                           ELSE
     4787                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  +  b-post-stk-line.sum-base.
     4788                 End.
     4789         End.
     4790   END PROCEDURE.
     4791   PROCEDURE display-line :
     4792     i = i + 1.
     4793   If Integer(10) = 0 Then Temp1  = 100  .
     4794                         Else Temp1 = Integer(10) .
     4795        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4796            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4797     run clear-item.
     4798       assign
     4799             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4800             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4801             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4802             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4803             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4804             gds-zap-artic      = temp-t-post-stk-line.artic
     4805             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4806             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4807             gds-zap-type       = temp-t-post-stk-line.gds-type
     4808             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4809             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4810             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4811       run ob-line  (
     4812                temp-t-post-stk-line.obj-code    ,
     4813                temp-t-post-stk-line.obj-type    ,
     4814                temp-t-post-stk-line.cli-code    ,
     4815                temp-t-post-stk-line.cli-type    ,
     4816                temp-t-post-stk-line.artic       ,
     4817                temp-t-post-stk-line.prod-code   ,
     4818                temp-t-post-stk-line.prod-type   ,
     4819                Fact-order-1     ,
     4820                Fact-order-2     ,
     4821                t#sum-type       ,
     4822                t#cat-id         ,
     4823                ""               ,
     4824                yes) .
     4825      if Show-Sale Then  run ob-line  (
     4826                temp-t-post-stk-line.obj-code    ,
     4827                temp-t-post-stk-line.obj-type    ,
     4828                temp-t-post-stk-line.cli-code    ,
     4829                temp-t-post-stk-line.cli-type    ,
     4830                temp-t-post-stk-line.artic       ,
     4831                temp-t-post-stk-line.prod-code   ,
     4832                temp-t-post-stk-line.prod-type   ,
     4833                Fact-order-1   ,
     4834                Fact-order-2   ,
     4835                'sale':U    ,
     4836                '##':U ,
     4837                ""             ,
     4838                yes) .
     4839            run calc-sub-itog ( 0).
     4840                if Show-Sale Then
     4841                   run calc-sub-itog ( 6).
     4842          IF  NOT  ( ( ostatok-start[1] = 0  AND
     4843                                          Prih         [1] = 0  AND
     4844                                          RAsh         [1] = 0  AND
     4845                                          KAssa        [1] = 0  AND
     4846                                          Inv          [1] = 0  AND
     4847                                          vzvr         [1] = 0  AND
     4848                                          vzvr-post    [1] = 0  AND
     4849                                          Ostatok-end  [1] = 0)) then DO:
     4850            IF NOT Sums-Only then DO:
     4851               run display-str1 in this-procedure .
     4852               run clear-item in this-procedure .
     4853            End.
     4854          End.
     4855     END PROCEDURE.
     4856   PROCEDURE display-str1  :
     4857   if   Show-Negativ = true or not  (
     4858       Prih         [1] = 0  AND
     4859       RAsh         [1] = 0  AND
     4860       KAssa        [1] = 0  AND
     4861       Inv          [1] = 0  AND
     4862       vzvr         [1] = 0  AND
     4863       spis         [1] = 0  AND
     4864       vzvr-post    [1] = 0
     4865       ) then DO:
     4866       if not  (  not Show-zero-ost   and
     4867               (  ostatok-end[1] = 0  and
     4868                ostatok-end[2] = 0  and
     4869                ostatok-end[8] = 0 ))  then DO:
     4870            run di-qnty  ( "кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4871            if show-cost then do : run di  (  "учет." , 2, "","","","","" ).  end.
     4872            if show-sale then do : run di  (  "док-т.", 8, "","","","","" ).  end.
     4873          end.
     4874   end.
     4875   run clear-item in this-procedure .
     4876   END PROCEDURE.
     4877   PROCEDURE Di :
     4878   def input parameter p1 as char no-undo.
     4879   def input parameter p2 as int no-undo.
     4880   def input parameter p3 as char no-undo.
     4881   def input parameter p4 as char no-undo.
     4882   def input parameter p5 as char no-undo.
     4883   def input parameter p6 as char no-undo.
     4884   def input parameter p7 as char no-undo.
     4885    CASE CAPS ( p7) :
     4886      WHEN "B1":U  Then do:
     4887                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4888                   p3 @ gds-zap-b-code
     4889                   p4 @ gds-zap-artic
     4890                   p5 @ gds-zap-gds-name
     4891                   p6 @ gds-zap-unit-base
     4892                   p1 @ gds-type
     4893                   b1-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4894                   b1-Prih         [p2]  @  F-Prih
     4895                   b1-RAsh         [p2]  @  F-RAsh
     4896                   b1-KAssa        [p2]  @  F-KAssa
     4897                   b1-Inv          [p2]  @  F-Inv
     4898                   b1-spis         [p2]  @  F-spis
     4899                   b1-vzvr         [p2]  @  F-vzvr
     4900                   b1-vzvr-post    [p2]  @  F-vzvr-post
     4901                   b1-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4902                  with FRAME ZAPAS .
     4903     end.
     4904      WHEN "B2":U  Then do:
     4905                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4906                   p3 @ gds-zap-b-code
     4907                   p4 @ gds-zap-artic
     4908                   p5 @ gds-zap-gds-name
     4909                   p6 @ gds-zap-unit-base
     4910                   p1 @ gds-type
     4911                   b2-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4912                   b2-Prih         [p2]  @  F-Prih
     4913                   b2-RAsh         [p2]  @  F-RAsh
     4914                   b2-KAssa        [p2]  @  F-KAssa
     4915                   b2-Inv          [p2]  @  F-Inv
     4916                   b2-spis         [p2]  @  F-spis
     4917                   b2-vzvr         [p2]  @  F-vzvr
     4918                   b2-vzvr-post    [p2]  @  F-vzvr-post
     4919                   b2-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4920                  with FRAME ZAPAS .
     4921     end.
     4922      WHEN "BI":U Then do:
     4923                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4924                   p3 @ gds-zap-b-code
     4925                   p4 @ gds-zap-artic
     4926                   p5 @ gds-zap-gds-name
     4927                   p6 @ gds-zap-unit-base
     4928                   p1 @ gds-type
     4929                   bi-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4930                   bi-Prih         [p2]  @  F-Prih
     4931                   bi-RAsh         [p2]  @  F-RAsh
     4932                   bi-KAssa        [p2]  @  F-KAssa
     4933                   bi-Inv          [p2]  @  F-Inv
     4934                   bi-spis         [p2]  @  F-spis
     4935                   bi-vzvr         [p2]  @  F-vzvr
     4936                   bi-vzvr-post    [p2]  @  F-vzvr-post
     4937                   bi-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4938                  with FRAME ZAPAS .
     4939     end.
     4940      WHEN "P":U Then do:
     4941                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4942                   p3 @ gds-zap-b-code
     4943                   p4 @ gds-zap-artic
     4944                   p5 @ gds-zap-gds-name
     4945                   p6 @ gds-zap-unit-base
     4946                   p1 @ gds-type
     4947                   p-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4948                   p-Prih         [p2]  @  F-Prih
     4949                   p-RAsh         [p2]  @  F-RAsh
     4950                   p-KAssa        [p2]  @  F-KAssa
     4951                   p-Inv          [p2]  @  F-Inv
     4952                   p-spis         [p2]  @  F-spis
     4953                   p-vzvr         [p2]  @  F-vzvr
     4954                   p-vzvr-post    [p2]  @  F-vzvr-post
     4955                   p-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4956                  with FRAME ZAPAS .
     4957     end.
     4958      WHEN "O"  Then     DO :
     4959                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4960                   p3 @ gds-zap-b-code
     4961                   p4 @ gds-zap-artic
     4962                   p5 @ gds-zap-gds-name
     4963                   p6 @ gds-zap-unit-base
     4964                   p1 @ gds-type
     4965                   o-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4966                   o-Prih         [p2]  @  F-Prih
     4967                   o-RAsh         [p2]  @  F-RAsh
     4968                   o-KAssa        [p2]  @  F-KAssa
     4969                   o-Inv          [p2]  @  F-Inv
     4970                   o-spis         [p2]  @  F-spis
     4971                   o-vzvr         [p2]  @  F-vzvr
     4972                   o-vzvr-post    [p2]  @  F-vzvr-post
     4973                   o-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4974                  with FRAME ZAPAS .
     4975        End.
     4976      WHEN ""  Then DO:
     4977                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4978                   p3 @ gds-zap-b-code
     4979                   p4 @ gds-zap-artic
     4980                   p5 @ gds-zap-gds-name
     4981                   p6 @ gds-zap-unit-base
     4982                   p1 @ gds-type
     4983                   ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4984                   Prih         [p2]  @  F-Prih
     4985                   RAsh         [p2]  @  F-RAsh
     4986                   KAssa        [p2]  @  F-KAssa
     4987                   Inv          [p2]  @  F-Inv
     4988                   spis         [p2]  @  F-spis
     4989                   vzvr         [p2]  @  F-vzvr
     4990                   vzvr-post    [p2]  @  F-vzvr-post
     4991                   Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4992                  with FRAME ZAPAS .
     4993        End.
     4994      End case.
     4995        DOWN stream   OutStream 1 with FRAME ZAPAS.
     4996    END PROCEDURE.
     4997   PROCEDURE Di-qnty :
     4998   def input parameter p1 as char no-undo.
     4999   def input parameter p2 as int no-undo.
     5000   def input parameter p3 as char no-undo.
     5001   def input parameter p4 as char no-undo.
     5002   def input parameter p5 as char no-undo.
     5003   def input parameter p6 as char no-undo.
     5004   def input parameter p7 as char no-undo.
     5005    CASE CAPS ( p7) :
     5006      WHEN "B1":U  Then DO :
     5007                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     5008                   p3 @ gds-zap-b-code
     5009                   p4 @ gds-zap-artic
     5010                   p5 @ gds-zap-gds-name
     5011                   p6 @ gds-zap-unit-base
     5012                   p1 @ gds-type
     5013                   b1-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     5014                   b1-Prih         [p2]  @  F-Prih
     5015                   b1-RAsh         [p2]  @  F-RAsh
     5016                   b1-KAssa        [p2]  @  F-KAssa
     5017                   b1-Inv          [p2]  @  F-Inv
     5018                   b1-spis         [p2]  @  F-spis
     5019                   b1-vzvr         [p2]  @  F-vzvr
     5020                   b1-vzvr-post    [p2]  @  F-vzvr-post
     5021                   b1-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     5022                  with FRAME ZAPAS .
     5023       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     5024                   p4 CHR(9)
     5025                   p5 CHR(9)
     5026                   p6 CHR(9)
     5027                      ( excel-qnty(b1-ostatok-start[1]) +  CHR(9))
     5028   if Show-cost  then  ( excel-sum(b1-ostatok-start[2]) +  CHR(9))   else ("")
     5029   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     5030                      ( excel-qnty(b1-Prih         [1]) +  CHR(9))
     5031   if Show-cost  then  ( excel-sum(b1-Prih         [2]) +  CHR(9))   else ("")
     5032   if Show-sale  then  ( excel-sum(b1-Prih         [8]) +  CHR(9))   else ("")
     5033                      ( excel-qnty(b1-RAsh         [1]) +  CHR(9))
     5034   if Show-cost  then  ( excel-sum(b1-RAsh         [2]) +  CHR(9))   else ("")
     5035   if Show-sale  then  ( excel-sum(b1-RAsh         [8]) +  CHR(9))   else ("")
     5036                      ( excel-qnty(b1-KAssa        [1]) +  CHR(9))
     5037   if Show-cost  then  ( excel-sum(b1-KAssa        [2]) +  CHR(9))   else ("")
     5038   if Show-sale  then  ( excel-sum(b1-KAssa        [8]) +  CHR(9))   else ("")
     5039                      ( excel-qnty(b1-Inv          [1]) +  CHR(9))
     5040   if Show-cost  then  ( excel-sum(b1-Inv          [2]) +  CHR(9))   else ("")
     5041   if Show-sale  then  ( excel-sum(b1-Inv          [8]) +  CHR(9))   else ("")
     5042                      ( excel-qnty(b1-spis         [1]) +  CHR(9))
     5043   if Show-cost  then  ( excel-sum(b1-spis         [2]) +  CHR(9))   else ("")
     5044   if Show-sale  then  ( excel-sum(b1-spis         [8]) +  CHR(9))   else ("")
     5045                      ( excel-qnty(b1-vzvr         [1]) +  CHR(9))
     5046   if Show-cost  then  ( excel-sum(b1-vzvr         [2]) +  CHR(9))   else ("")
     5047   if Show-sale  then  ( excel-sum(b1-vzvr         [8]) +  CHR(9))   else ("")
     5048                      ( excel-qnty(b1-vzvr-post    [1]) +  CHR(9))
     5049   if Show-cost  then  ( excel-sum(b1-vzvr-post    [2]) +  CHR(9))   else ("")
     5050   if Show-sale  then  ( excel-sum(b1-vzvr-post    [8]) +  CHR(9))   else ("")
     5051                      ( excel-qnty(b1-Ostatok-end  [1]) +  CHR(9))
     5052   if Show-cost  then  ( excel-sum(b1-Ostatok-end  [2]) +  CHR(9))   else ("")
     5053   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     5054      chr(10).
     5055                   End.
     5056      WHEN "B2":U  Then DO :
     5057                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     5058                   p3 @ gds-zap-b-code
     5059                   p4 @ gds-zap-artic
     5060                   p5 @ gds-zap-gds-name
     5061                   p6 @ gds-zap-unit-base
     5062                   p1 @ gds-type
     5063                   b2-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     5064                   b2-Prih         [p2]  @  F-Prih
     5065                   b2-RAsh         [p2]  @  F-RAsh
     5066                   b2-KAssa        [p2]  @  F-KAssa
     5067                   b2-Inv          [p2]  @  F-Inv
     5068                   b2-spis         [p2]  @  F-spis
     5069                   b2-vzvr         [p2]  @  F-vzvr
     5070                   b2-vzvr-post    [p2]  @  F-vzvr-post
     5071                   b2-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     5072                  with FRAME ZAPAS .
     5073       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     5074                   p4 CHR(9)
     5075                   p5 CHR(9)
     5076                   p6 CHR(9)
     5077                      ( excel-qnty(b2-ostatok-start[1]) +  CHR(9))
     5078   if Show-cost  then  ( excel-sum(b2-ostatok-start[2]) +  CHR(9))   else ("")
     5079   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     5080                      ( excel-qnty(b2-Prih         [1]) +  CHR(9))
     5081   if Show-cost  then  ( excel-sum(b2-Prih         [2]) +  CHR(9))   else ("")
     5082   if Show-sale  then  ( excel-sum(b2-Prih         [8]) +  CHR(9))   else ("")
     5083                      ( excel-qnty(b2-RAsh         [1]) +  CHR(9))
     5084   if Show-cost  then  ( excel-sum(b2-RAsh         [2]) +  CHR(9))   else ("")
