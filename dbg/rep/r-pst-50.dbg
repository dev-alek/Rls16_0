     1651               t#sum-type = 'cost':U + 'p':U .
     1652           when 5 then
     1653             Assign
     1654               t#cat-id   = 'cons':U
     1655               t#sum-type = 'cost':U + 'p':U .
     1656     End case.
     1657   Case Select-Good :
     1658     when 1  then run run1-0.
     1659     when 2  then run run2-0.
     1660     when 3 then run run3-0.
     1661     otherwise do:
     1662       run run45-0.
