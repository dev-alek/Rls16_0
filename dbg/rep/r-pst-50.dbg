     1664   End case.
     1665   procedure run1-0 :
     1666   CASE RetClassify :
     1667     when "no-classify":u then  do:
     1668   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1670   For each obj-list no-lock
     1671     , each post-stk-line  no-lock where
     1672                                     post-stk-line.obj-type = obj-list.obj-type and
     1673                                     post-stk-line.obj-code = obj-list.obj-code and
     1674                                     post-stk-line.fact-order >= null-fact-order   and
     1675                                     post-stk-line.fact-order <= fact-order-2   and
     1676                                     post-stk-line.sum-type    = 'cost':U    and
     1677                                     post-stk-line.cat-id      = '##':U
     1678                                     :
     1679           find first  temp-t-post-stk-line where
     1680             temp-t-post-stk-line.obj-type  = obj-list.obj-type       and
     1681             temp-t-post-stk-line.obj-code  = obj-list.obj-code       and
     1682             temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1683             temp-t-post-stk-line.cli-code  = post-stk-line.cli-code  and
     1684             temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1685             temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1686             temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1687             if not available temp-t-post-stk-line then do:
     1688               find first  ub.goods no-lock where
     1689                                     ub.goods.artic     = post-stk-line.artic     and
     1690                                     ub.goods.prod-type = post-stk-line.prod-type and
     1691                                     ub.goods.prod-code = post-stk-line.prod-code no-error .
     1692               find first  prod-cli no-lock  where
     1693                                         prod-cli.obj-type = post-stk-line.prod-type and
     1694                                         prod-cli.obj-code = post-stk-line.prod-code
     1695                                         no-error .
     1696               find first  ub.clients  no-lock  where
     1697                                         ub.clients.obj-type = post-stk-line.cli-type and
     1698                                         ub.clients.obj-code = post-stk-line.cli-code no-error .
     1699                 Run create-temp-t-post-stk-line .
     1700                 if xLavel <> 0 THEN  DO:
     1701                    temp-t-post-stk-line.goods-grp-name = n-lavel (temp-t-post-stk-line.goods-grp-name , xLavel ) .
     1702                 end.
     1703           end.
     1704           else do:
     1705                   assign
     1706                     temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1707                   .
     1708           end.
     1709   end.
     1710   CASE RetClassify :
     1711   when "grp-goods":U  then   DO:
     1712   for each temp-t-post-stk-line break
     1713            by temp-t-post-stk-line.goods-grp-name
     1714            by ( temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code) )
     1715            BY temp-t-post-stk-line.gds-name
     1716            by  temp-t-post-stk-line.gds-code
     1717            :
     1718       if first-of( temp-t-post-stk-line.goods-grp-name) then do:
     1719         Run Print-Header(1 , temp-t-post-stk-line.goods-grp-name ).
     1720       end.
     1721       if first-of(temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) then do:
     1722         Run Print-Header(3 , temp-t-post-stk-line.clients-obj-name).
     1723       end.
     1724       IF last-of(temp-t-post-stk-line.GDS-CODE) THEN DO:
     1725       Assign
     1726         Ostatok-end[1] = 0
     1727         Ostatok-end[2] = 0
     1728         Ostatok-end[8] = 0
     1729         Ostatok-start[1] = 0
     1730         Ostatok-start[2] = 0
     1731         Ostatok-start[8] = 0
     1732         .
     1733       assign
     1734         gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     1735         gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     1736         gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     1737         gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     1738         gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     1739         gds-zap-artic      = temp-t-post-stk-line.artic
     1740         gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     1741         gds-zap-b-code     = temp-t-post-stk-line.gds-code
     1742         gds-zap-type       = temp-t-post-stk-line.gds-type
     1743         pos-cli-type       = temp-t-post-stk-line.Cli-type
     1744         pos-cli-code       = temp-t-post-stk-line.Cli-code
     1745         pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name
     1746         .
     1747           for each OBJ-LIST :
     1748           RUN Goods-start-O .
     1749           RUN Goods-end-O .
     1750           RUN ob-line (
     1751                   OBJ-LIST.obj-code    ,
     1752                   OBJ-LIST.obj-type    ,
     1753                   temp-t-post-stk-line.cli-code    ,
     1754                   temp-t-post-stk-line.cli-type    ,
     1755                   temp-t-post-stk-line.artic       ,
     1756                   temp-t-post-stk-line.prod-code   ,
     1757                   temp-t-post-stk-line.prod-type   ,
     1758                   Fact-order-1     ,
     1759                   Fact-order-2     ,
     1760                   t#sum-type       ,
     1761                   t#cat-id         ,
     1762                   ""               ,
     1763                   yes) .
     1764         if Show-Sale Then  RUN ob-line (
     1765                   OBJ-LIST.obj-code    ,
     1766                   OBJ-LIST.obj-type    ,
     1767               temp-t-post-stk-line.cli-code    ,
     1768               temp-t-post-stk-line.cli-type    ,
     1769               temp-t-post-stk-line.artic       ,
     1770               temp-t-post-stk-line.prod-code   ,
     1771               temp-t-post-stk-line.prod-type   ,
     1772               Fact-order-1   ,
     1773               Fact-order-2   ,
     1774               'sale':U    ,
     1775               '##':U ,
     1776               ""             ,
     1777               yes) .
     1778           end.
     1779           RUN Calc-Sub-itog(0).
     1780           if Show-Sale Then RUN Calc-Sub-itog(6).
     1781           IF  NOT ( (ostatok-start[1] = 0  AND
     1782                     Prih         [1] = 0  AND
     1783                     RAsh         [1] = 0  AND
     1784                     KAssa        [1] = 0  AND
     1785                     Inv          [1] = 0  AND
     1786                     vzvr         [1] = 0  AND
     1787                     vzvr-post    [1] = 0  AND
     1788                     ostatok-end  [1] = 0 )) then do:
     1789               if not sums-only then do:
     1790                 run display-str1.
     1791                 run clear-item.
     1792               end.
     1793           End.
     1794       run clear-item.
