     5309   procedure Print-Footer :
     5310   define input parameter Nx as integer no-undo .
     5311   define input parameter Name as char no-undo .
     5312       if Nx = 1 Then DO:
     5313            run di-qnty  ( "кол-во", 1,"","Итого по : ",trim ( name),"","b1").
     5314            if show-cost then do : run di  (  "учет." , 2, "","","","","b1" ).  end.
     5315            if show-sale then do : run di  (  "док-т.", 8, "","","","","b1" ).  end.
     5316            if not sums-only then
     5317               run u-line.
     5318            run clear-itemb1- in this-procedure .
     5319            End.
     5320    if Nx = 2 Then DO:
     5321            run di-qnty  ( "кол-во", 1,"","","Итого по : " + trim ( name),"","b2").
     5322            if show-cost then do : run di  (  "учет." , 2, "","","","","b2" ).  end.
     5323            if show-sale then do : run di  (  "док-т.", 8, "","","","","b2" ).  end.
     5324            if not sums-only then run u-line.
     5325            run clear-itemb2-.
     5326           end.
     5327    if nx = 3 then do:
     5328            if not sums-only then run u-line.
     5329            run di-qnty  ( "кол-во", 1,"","Итого по пост-ку" , trim ( name),"","p").
     5330            if show-cost then do : run di  (  "учет." , 2, "","","","","p" ).  end.
     5331            if show-sale then do : run di  (  "док-т.", 8, "","","","","p" ).  end.
     5332            if not sums-only then run u-line.
     5333            run clear-itemp-.
     5334             end.
     5335    if nx = 0 then do:
     5336            run di-qnty  ( "кол-во", 1,"","Итого  объект: " , trim ( name),"","o").
     5337            if show-cost then do : run di  (  "учет." , 2, "","","","","o" ).  end.
     5338            if show-sale then do : run di  (  "док-т.", 8, "","","","","o" ).  end.
     5339            if not sums-only then run u-line.
     5340            run clear-itemo-.
     5341             end.
     5342    END PROCEDURE.
     5343   PROCEDURE Clear-item :
     5344   def var kk as int no-undo.
     5345    REPEAT kk = 1 to 9:
     5346    Assign
     5347       prih             [kk]  = 0
     5348       rash             [kk]  = 0
     5349       kassa            [kk]  = 0
     5350       spis             [kk]  = 0
     5351       Inv              [kk]  = 0
     5352       vzvr             [kk]  = 0
     5353       vzvr-post        [kk]  = 0
     5354        .
     5355          End.
     5356    END PROCEDURE.
     5357   PROCEDURE Clear-itemb1- :
