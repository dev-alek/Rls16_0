     5420    END PROCEDURE.
     5421   PROCEDURE ob-line :
     5422   def input  parameter x-store-code     like ub.clients.obj-code          no-undo.
     5423   def input  parameter x-store-type     like ub.clients.obj-type          no-undo.
     5424   def input  parameter x-cli-code       like ub.clients.obj-code          no-undo.
     5425   def input  parameter x-cli-type       like ub.clients.obj-type          no-undo.
     5426   def INPUT  parameter x-artic          like post-ot-line.artic        no-undo.
     5427   def INPUT  parameter x-prod-code      like post-ot-line.prod-code    no-undo.
     5428   def INPUT  parameter x-prod-type      like post-ot-line.prod-type    no-undo.
     5429   def INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     5430   def INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     5431   def input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     5432   def input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     5433   def input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     5434   def input  parameter xTog-obj           as log no-undo .
     5435   def var  tt#          as   int                 no-undo .
     5436    if  ( x-sum-type = 'cost':U ) then tt# = 0.
     5437    if  ( x-sum-type = 'sale':U ) then tt# = 6.
     5438        FOR each post-ot-line where
     5439                 post-ot-line.artic        = x-artic
     5440           AND   post-ot-line.fact-order  <= x-fact-order-2
     5441           AND   post-ot-line.fact-order  >= x-fact-order-1
     5442           AND   post-ot-line.obj-code     = x-store-code
     5443           AND   post-ot-line.obj-type     = x-store-type
     5444           AND   post-ot-line.prod-code    = x-prod-code
     5445           AND   post-ot-line.prod-type    = x-prod-type
     5446           AND   post-ot-line.cli-code     = x-cli-code
     5447           AND   post-ot-line.cli-type     = x-cli-type
     5448           AND   post-ot-line.sum-type     = x-sum-type
     5449           AND   post-ot-line.cat-id       = x-cat-id
     5450                  no-lock :
     5451           CASE post-ot-line.ext-doc-type:
     5452                WHEN        'iv':U      OR
     5453                WHEN        'rv':U  OR
     5454                WHEN        'im':U     THEN     DO:
     5455              if t-in then
     5456              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5457                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5458                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5459                    End.
     5460                WHEN        'ie':U   THEN     DO:
     5461              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5462                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5463                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5464                    End.
     5465                WHEN        're':U  THEN DO:
     5466              ASSIGN vzvr[1 + tt#]   = vzvr[1 + tt#]   +  post-ot-line.fact-qnty
     5467                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5468                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5469                    End.
     5470                WHEN       'ep':U  THEN DO:
     5471              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  post-ot-line.fact-qnty
     5472                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5473                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5474                    End.
     5475                WHEN       'ee':U          THEN  DO:
     5476                ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     5477                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5478                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5479                    End.
     5480                WHEN       'ev':U       OR
     5481                WHEN       'em':U        THEN  DO:
     5482              if t-in then
     5483              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     5484                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5485                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5486                    End.
     5487                WHEN       'es':U  OR
     5488                WHEN       'rs':U THEN  DO:
     5489              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  post-ot-line.fact-qnty
     5490                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5491                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base .
     5492                    End.
     5493                WHEN       'vt':U      or
     5494                when       'vp':U   or
     5495                when       'ap':U   or
     5496                when       'mp':U or
     5497                when       'pc':U
     5498        THEN  DO:
     5499              ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  post-ot-line.fact-qnty
     5500                     Inv[2 + tt#]   = Inv[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5501                     Inv[3 + tt#]   = Inv[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5502                    End.
     5503                WHEN       'we':U       THEN  DO:
     5504              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  post-ot-line.fact-qnty
     5505                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5506                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5507                    End.
     5508                WHEN       'wm':U       THEN  DO:
     5509              if t-in then
     5510              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  post-ot-line.fact-qnty
     5511                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5512                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5513                    End.
     5514             End CASE.
     5515      End.
     5516   END PROCEDURE.
     5517   PROCEDURE Calc-Sub-itog :
     5518   def input parameter tt as int no-undo.
     5519   def var b as int no-undo.
     5520   repeat b = 1 to 3 :
     5521     Assign
     5522     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     5523     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     5524     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     5525     p-Prih[b + TT]     = p-Prih[b + TT]    +  Prih[b + TT]
     5526     o-Prih[b + TT]     = o-Prih[b + TT]    +  Prih[b + TT]
     5527     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     5528     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     5529     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     5530     p-RAsh[b + TT]    = p-RAsh[b + TT]    +  RAsh[b + TT]
     5531     o-RAsh[b + TT]    = o-RAsh[b + TT]    +  RAsh[b + TT]
     5532     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     5533     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     5534     Bi-kassa[b + TT]     = Bi-kassa[b + TT]     +  kassa[b + TT]
     5535     p-kassa[b + TT]      = p-kassa[b + TT]      +  kassa[b + TT]
     5536     o-kassa[b + TT]      = o-kassa[b + TT]      +  kassa[b + TT]
     5537     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     5538     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     5539     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     5540     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     5541     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     5542     B1-spis[b + TT]    = B1-spis[b + TT]    +  spis[b + TT]
     5543     B2-spis[b + TT]    = B2-spis[b + TT]    +  spis[b + TT]
     5544     Bi-spis[b + TT]    = Bi-spis[b + TT]    +  spis[b + TT]
     5545      p-spis[b + TT]    =  p-spis[b + TT]    +  spis[b + TT]
     5546      o-spis[b + TT]    =  o-spis[b + TT]    +  spis[b + TT]
     5547     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     5548     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     5549     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     5550     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     5551     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     5552     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5553     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5554     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5555     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5556     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5557     B1-ostatok-start[b + TT]    = B1-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5558     B2-ostatok-start[b + TT]    = B2-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5559     Bi-ostatok-start[b + TT]    = Bi-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5560     p-ostatok-start[b + TT]    = p-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5561     o-ostatok-start[b + TT]    = o-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5562     B1-ostatok-end[b + TT]    = B1-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5563     B2-ostatok-end[b + TT]    = B2-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5564     Bi-ostatok-end[b + TT]    = Bi-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5565     p-ostatok-end[b + TT]    = p-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5566     o-ostatok-end[b + TT]    = o-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5567   .
     5568   End.
     5569   END PROCEDURE.
     5570   PROCEDURE U-LINE :
     5571   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     5572           gds-zap-b-code
     5573           gds-zap-artic
     5574           gds-zap-gds-name
     5575           gds-zap-unit-base
     5576           gds-type
     5577           F-ostatok-start
     5578           F-Prih
     5579           F-Rash
     5580           F-KAssa
     5581           F-Inv
     5582           F-spis
     5583           F-vzvr
     5584           F-vzvr-post
     5585           F-ostatok-end
     5586           with FRAME ZAPAS .
     5587           DOWN stream   OutStream 1 with FRAME ZAPAS.
     5588           END PROCEDURE.
     5589   Procedure Tmp-create :
     5590   define input parameter p1   like ub.clients.obj-code  no-undo .
     5591   define input parameter p2   like ub.clients.obj-type  no-undo .
     5592   define input parameter Name like ub.clients.obj-name  no-undo .
     5593   define input parameter p3   like obj-list.obj-code no-undo .
     5594   define input parameter p4   like obj-list.obj-type no-undo .
     5595     Create tmp-cli-gds.
     5596    def var kk as int no-undo.
     5597    REPEAT kk = 1 to 9 :
     5598      Assign
     5599         tmp-cli-gds.p-ostatok-start[kk]  = p-ostatok-start[kk]
     5600         tmp-cli-gds.p-ostatok-End[kk]    = p-ostatok-End[kk]
     5601         tmp-cli-gds.p-prih[kk]           = p-prih[kk]
     5602         tmp-cli-gds.p-rash[kk]           = p-rash[kk]
     5603         tmp-cli-gds.p-kassa[kk]          = p-kassa[kk]
     5604         tmp-cli-gds.p-Inv[kk]            = p-Inv[kk]
     5605         tmp-cli-gds.p-spis[kk]           = p-spis[kk]
     5606         tmp-cli-gds.p-vzvr[kk]           = p-vzvr[kk]
     5607         tmp-cli-gds.p-vzvr-post[kk]      = p-vzvr-post[kk]
     5608         .
     5609    end.
     5610         assign
     5611         tmp-cli-gds.cli-code         = p1
     5612         tmp-cli-gds.cli-type         = p2
     5613         tmp-cli-gds.Name             = Name
     5614         tmp-cli-gds.obj-code         = p3
     5615         tmp-cli-gds.obj-type         = p4
     5616         .
     5617    END PROCEDURE.
     5618   Procedure Tmp-clear :
     5619    def var kk as int no-undo.
     5620    REPEAT kk = 1 to 9 :
     5621    Assign
     5622        p-ostatok-start[kk] = 0
     5623        p-ostatok-End[kk]   = 0
     5624        p-prih[kk]          = 0
     5625        p-rash[kk]          = 0
     5626        p-kassa[kk]         = 0
     5627        p-Inv[kk]           = 0
     5628        p-spis[kk]          = 0
     5629        p-vzvr[kk]          = 0
     5630        p-vzvr-post[kk]     = 0
     5631       .
     5632       end.
     5633   END PROCEDURE.
     5634   Procedure Tmp-assign :
     5635    def var kk as int no-undo.
     5636    REPEAT kk = 1 to 9 :
     5637       Assign
     5638       p-ostatok-start[kk]  = p-ostatok-start[kk]   + tmp-cli-gds.p-ostatok-start[kk]
     5639       p-ostatok-End[kk]    = p-ostatok-End[kk]     + tmp-cli-gds.p-ostatok-End[kk]
     5640       p-prih[kk]           = p-prih[kk]            + tmp-cli-gds.p-prih[kk]
     5641       p-rash[kk]           = p-rash[kk]            + tmp-cli-gds.p-rash[kk]
     5642       p-kassa[kk]          = p-kassa[kk]           + tmp-cli-gds.p-kassa[kk]
     5643       p-Inv[kk]            = p-Inv[kk]             + tmp-cli-gds.p-Inv[kk]
     5644       p-spis[kk]           = p-spis[kk]            + tmp-cli-gds.p-spis[kk]
     5645       p-vzvr[kk]           = p-vzvr[kk]            + tmp-cli-gds.p-vzvr[kk]
     5646       p-vzvr-post[kk]      = p-vzvr-post[kk]       + tmp-cli-gds.p-vzvr-post[kk]
     5647       .
     5648    end.
     5649   END PROCEDURE.
     5650   procedure Goods-start-O :
     5651    def buffer  b-post-stk-line for ub.stk-supp-line .
     5652    define variable p-fact-order as decimal no-undo .
     5653     p-fact-order = fact-order-1 .
     5654     Find last temp2-post-stk-line  no-lock where
     5655       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     5656       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     5657       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     5658       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     5659       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     5660       temp2-post-stk-line.obj-type    =  OBJ-LIST.obj-type     and
     5661       temp2-post-stk-line.obj-code    =  obj-list.obj-code     and
     5662       temp2-post-stk-line.fact-order <=  fact-order-1               and
     5663       temp2-post-stk-line.sum-type    =  'cost':U                and
     5664       temp2-post-stk-line.cat-id      =  '##':U
     5665       no-error .
     5666     Find Last a-post-stk-line  where
     5667         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     5668         a-post-stk-line.cat-id     =  t#cat-id      and
     5669         a-post-stk-line.Sum-type   =  t#sum-type    and
     5670         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     5671         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     5672         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     5673         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     5674         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     5675         a-post-stk-line.obj-type   =  obj-list.obj-type  and
     5676         a-post-stk-line.obj-code   =  obj-list.obj-code
     5677         no-lock no-error .
     5678         if avail  a-post-stk-line Then do:
     5679           p-fact-order     = a-post-stk-line.fact-order .
     5680           Ostatok-start[1] = Ostatok-start[1] +  a-post-stk-line.fact-qnty   .
     5681           ostatok-start[2] = ostatok-start[2] +  if tprintrubl then  a-post-stk-line.sum-rubl
     5682                                                     else a-post-stk-line.sum-base .
     5683           end.
     5684        IF Show-Sale  then do:
     5685                For each b-post-stk-line where
     5686                                            b-post-stk-line.fact-order = p-fact-order and
     5687                                            b-post-stk-line.cat-id     = t#cat-id   and
     5688                                            b-post-stk-line.Sum-type   begins 'sadt':U         and
     5689                                            b-post-stk-line.artic      = temp-t-post-stk-line.artic      and
     5690                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     5691                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     5692                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     5693                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     5694                                            b-post-stk-line.obj-type   = obj-list.obj-type   and
     5695                                            b-post-stk-line.obj-code   = obj-list.obj-code
     5696                                            no-lock :
     5697                         IF  tPrintRubl  THEN
     5698                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  + b-post-stk-line.sum-rubl .
     5699                           ELSE
     5700                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  +  b-post-stk-line.sum-base.
     5701                 End.
     5702         End.
     5703   END PROCEDURE.
     5704   procedure Goods-end-O :
     5705    def buffer  b-post-stk-line for ub.stk-supp-line .
     5706    define variable p-fact-order as decimal no-undo .
     5707     p-fact-order = fact-order-2 .
     5708     Find last temp2-post-stk-line  no-lock where
     5709       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     5710       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     5711       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     5712       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     5713       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     5714       temp2-post-stk-line.obj-type    =  obj-list.obj-type     and
     5715       temp2-post-stk-line.obj-code    =  obj-list.obj-code     and
     5716       temp2-post-stk-line.fact-order <=  fact-order-2               and
     5717       temp2-post-stk-line.sum-type    =  'cost':U                and
     5718       temp2-post-stk-line.cat-id      =  '##':U
     5719       no-error .
     5720     Find Last a-post-stk-line  where
     5721         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     5722         a-post-stk-line.cat-id     =  t#cat-id       and
     5723         a-post-stk-line.Sum-type   =  t#sum-type     and
     5724         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     5725         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     5726         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     5727         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     5728         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code    and
     5729         a-post-stk-line.obj-type   =  obj-list.obj-type    and
     5730         a-post-stk-line.obj-code   =  obj-list.obj-code
     5731         no-lock no-error .
     5732     if avail  a-post-stk-line Then do :
     5733         Assign
     5734           p-fact-order     = a-post-stk-line.fact-order
     5735           ostatok-end[1] = ostatok-end[1] + a-post-stk-line.fact-qnty
     5736           ostatok-end[2] = ostatok-end[2] + if tprintrubl then  a-post-stk-line.sum-rubl
     5737                                             else  a-post-stk-line.sum-base.
     5738     end.
     5739        IF Show-Sale  then do:
     5740                For each b-post-stk-line where
     5741                     b-post-stk-line.fact-order = p-fact-order and
     5742                     b-post-stk-line.cat-id     = t#cat-id   and
     5743                     b-post-stk-line.Sum-type    begins 'sadt':U         and
     5744                     b-post-stk-line.artic      = post-stk-line.artic      and
     5745                     b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     5746                     b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     5747                     b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     5748                     b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     5749                     b-post-stk-line.obj-type   = obj-list.obj-type   and
     5750                     b-post-stk-line.obj-code   = obj-list.obj-code
     5751                     no-lock :
     5752                         IF  tPrintRubl  THEN
     5753                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  + b-post-stk-line.sum-rubl .
     5754                           ELSE
     5755                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  +  b-post-stk-line.sum-base.
     5756                 End.
     5757         End.
     5758   END PROCEDURE.
