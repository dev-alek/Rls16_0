     1218   procedure create-temp-t-post-stk-line :
     1219       define variable str  as char      format "X(60)" no-undo.
     1220       define variable str2 as char      no-undo.
     1221       define variable v-r  as character no-undo init "" .
     1222       define variable i#i  as int       no-undo.
     1223    do
     1224    on error undo, return error return-value
     1225    :
     1226    if available ub.goods and
     1227       available ub.clients and
     1228       available prod-cli then do:
     1229     create temp-t-post-stk-line .
     1230     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1231     assign
     1232       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1233       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1234       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1235       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1236       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1237       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1238       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1239       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1240       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1241       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1242       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1243     .
     1244               if xlavel > 0 then
     1245               do:
     1246                   repeat i#i =1 to xlavel:
     1247                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1248                       else
     1249                       do:
     1250                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1251                           if not error-status:error  and str2 <> "":u then
     1252                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1253                       end.
     1254                   end.
     1255                   if str <> ? then
     1256                   do:
     1257                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1258                   end.
     1259               end.
     1260               else
     1261               do :
     1262                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1263               end.
     1264           end.
     1265    end.
     1266   end procedure.
     1267   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1268     if num-entries(string(p-dec), '.') = 2
     1269       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1270       else return( string(p-dec)) .
     1271   end function.
     1272   function format-point-to-comma returns char (input orig as char ) .
     1273   define variable rtext as character no-undo .
     1274   define variable strt as integer no-undo .
     1275   define variable leng as integer no-undo .
     1276   assign rtext = orig .
     1277   repeat:
     1278     strt =  index(rtext,'.').
     1279     if strt = 0 then leave.
     1280     leng = 1.
     1281     substring(rtext,strt,leng,"character") = v-delim .
     1282   end.
     1283   return rtext.
     1284   end function.
     1285   function format-excel-text returns char ( input start-text as char ) :
     1286   def var  i    as int no-undo.
     1287   def var  ch   as char no-undo.
     1288   def var  n    as int no-undo.
     1289   def var  ipos as int no-undo.
     1290     n = num-entries(trim(start-text), chr(10)) - 1 .
     1291     do i = 1 to n :
     1292       ipos = index( start-text, chr(10)).
     1293       if ipos > 0 then
     1294         substr( start-text, ipos, 1 ) = ' '.
     1295     end.
     1296     n = num-entries(trim(start-text), chr(13)) - 1 .
     1297     do i = 1 to n :
     1298       ipos = index( start-text, chr(13)).
     1299       if ipos > 0 then
     1300         substr( start-text, ipos, 1 ) = ' '.
     1301     end.
     1302     if index( start-text, '"' ) = 0 then
     1303       start-text =  '="'   + trim( start-text) + '"'   .
     1304       else do:
     1305         n = num-entries(trim(start-text), '"') - 1.
     1306         do i = 1 to n :
     1307           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1308         end.
     1309         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1310         start-text = '="'  + ch  + '"' .
     1311       end.
     1312     return start-text.
     1313   end.
     1314   function excel-sum returns char (input p-dec as decimal ).
     1315     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1316   end function.
     1317   function excel-qnty returns char (input p-dec as decimal ).
     1318     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1319   end function.
     1320   function format-excel-text-macr returns char ( input start-text as char ) :
     1321   def var  i    as int no-undo.
     1322   def var  ch   as char no-undo.
     1323   def var  n    as int no-undo.
     1324   def var  ipos as int no-undo.
     1325     n = num-entries(trim(start-text), chr(10)) - 1 .
     1326     do i = 1 to n :
     1327       ipos = index( start-text, chr(10)).
     1328       if ipos > 0 then
     1329         substring( start-text, ipos , 1 ) = ' '.
     1330     end.
     1331     n = num-entries(trim(start-text), chr(13)) - 1 .
     1332     do i = 1 to n :
     1333       ipos = index( start-text, chr(13)).
     1334       if ipos > 0 then
     1335         substring( start-text, ipos, 1 ) = ' '.
     1336     end.
     1337     if index( start-text, '"' ) = 0 then
     1338       start-text =  '"'   + trim( start-text) + '"'   .
     1339       else do:
     1340         n = num-entries(trim(start-text), '"') - 1.
     1341         do i = 1 to n :
     1342           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1343         end.
     1344         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1345         start-text = '"'  + ch  + '"' .
     1346       end.
     1347     n = num-entries(trim(start-text), chr(10)) - 1 .
     1348     do i = 1 to n :
     1349       ipos = index( start-text, chr(10)).
     1350       if ipos > 0 then
     1351         substring( start-text, ipos , 1 ) = ' '.
     1352     end.
     1353       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1354     return start-text.
     1355   end.
     1356   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1357   define variable  str  as char format "X(60)"  no-undo.
     1358   define variable  str2 as char no-undo.
     1359   define variable v-r as character no-undo init "" .
     1360   define variable  i#i as int no-undo.
     1361   STR = "".
     1362   repeat i#i =1 to lavel#:
     1363       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1364       else do:
     1365           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1366           if not error-status:error  and str2 <> "":u then
     1367                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1368           end.
     1369   end.
     1370   if str <> ? then do:
     1371   v-r = str + chr(47) .
     1372   end.
     1373   RETURN v-r .
     1374   END FUNCTION.
     1375   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1376   define variable v-waitfram-action01         as character   no-undo .
     1377   define variable v-waitfram-action02         as character   no-undo .
     1378   define variable v-waitfram-action03         as character   no-undo .
     1379   define variable mWaitFramTextBeg            as character   no-undo.
     1380   define variable mWaitFramTextEnd            as character   no-undo.
     1381   define variable mWaitFramView               as logical     no-undo.
     1382   define variable mWaitProcEvent              as logical     no-undo init yes.
     1383   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1384   define variable mWaitFramStop               as logical     no-undo.
     1385   define variable mWaitFramStopUser           as logical     no-undo.
     1386   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1387   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1388   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1389   define button B-WaitFramStop auto-end-key
