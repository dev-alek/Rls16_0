     1328                   '</tr>' skip .
     1329               end.
     1330               if parSource <> "param" then
     1331               do:
     1332                 put stream OutStr-html unformatted
     1333                   '<tr>' skip
     1334                   '<td colspan="11" style="text-align: left;">     с замечаниями по клавиатуре: ' + string(diffCashKeyBoard) + '</td>'
     1335                   '</tr>' skip
     1336                   .
     1337               end.
     1338               if parSource <> "keyboard" then
     1339               do:
     1340                 put stream OutStr-html unformatted
     1341                   '<tr>' skip
     1342                   '<td colspan="11" style="text-align: left;">     без замечаний по параметрам: ' + string(withoutCashParam) + '</td>'
     1343                   '</tr>' skip
     1344                   .
     1345               end.
     1346               if parSource <> "param" then
     1347               do:
     1348                 put stream OutStr-html unformatted
     1349                   '<tr>' skip
     1350                   '<td colspan="11" style="text-align: left;">     без замечаний по клавиатуре: ' + string(withoutCashKeyBoard) + '</td>'
     1351                   '</tr>' skip
     1352                   .
     1353               end.
     1354               put stream OutStr-html unformatted
     1355                 '</thead>' skip
     1356                 '<tr>' skip
     1357                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Название АЗК/АЗС</td>' skip
     1358                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Признак исполнения кассы</td>' skip
     1359                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Номер кассы</td>' skip
     1360                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Дата и время актуальной сверки</td>' skip
     1361                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Наименование источника</td>' skip
     1362                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Раздел/Наименование функции клавиши</td>' skip
     1363                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Наименование параметра/Дополнительное значение</td>' skip
     1364                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Тип клавиатуры</td>' skip
     1365                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Значение параметра/Степень защиты эталон</td>' skip
     1366                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Значение параметра/Степень защиты текущее</td>' skip
     1367                 '<td text_wrap="true" style="text-align: center; border: 1px solid black;">Результат сравнения</td>' skip
     1368                 '</tr>' skip
     1369                 '<tbody>'
     1370                 .
     1371               define variable v-first as logical   no-undo .
     1372               define variable v-color as character no-undo .
     1373               if parSource <> "keyboard" then
     1374               do:
     1375                 for each tt-param no-lock where tt-param.SectionName = "Параметры" by tt-param.obj-code by tt-param.obj-type by tt-param.CashNum by tt-param.ParamGroup by tt-param.KeyBoardName:
     1376                   if not v-first then
     1377                   do:
     1378                     put stream OutStr-html unformatted
     1379                       '<tr>' skip
     1380                       '<td colspan="11" text_wrap="true" style="">' tt-param.SectionName '</td>' skip
     1381                       '</tr>' skip
     1382                       .
     1383                   end.
     1384                   v-first = true .
     1385                   v-color = getColor(tt-param.flag, tt-param.status_, tt-param.diff) .
     1386                   put stream OutStr-html unformatted
     1387                     '<tr>' skip
     1388                     '<td text_wrap="true">' tt-param.obj-name  '</td>' skip
     1389                     '<td text_wrap="true">' tt-param.DeviceName '</td>' skip
     1390                     '<td text_wrap="true">' tt-param.CashNum '</td>' skip
     1391                     '<td text_wrap="true">' if tt-param.DateTime = 0 then "" else fConvetDateTime(tt-param.DateTime) '</td>' skip
     1392                     '<td text_wrap="true">' tt-param.SectionName '</td>' skip
     1393                     '<td text_wrap="true">' tt-param.ParamGroup '</td>' skip
     1394                     '<td text_wrap="true">' tt-param.ParamName '</td>' skip
     1395                     '<td text_wrap="true">' tt-param.KeyBoardName '</td>' skip
     1396                     '<td text_wrap="true">' tt-param.EtalonValue '</td>' skip
     1397                     '<td text_wrap="true">' tt-param.CurrentValue '</td>' skip
     1398                     '<td text_wrap="true" style="background-color: ' + v-color + ';">' getColorText(v-color) '</td>' skip
     1399                     '</tr>' skip
     1400                     .
     1401                 end.
     1402               end.
     1403               v-first = false .
     1404               if parSource <> "param" then
     1405               do:
     1406                 for each tt-param no-lock where tt-param.SectionName <> "Параметры" by tt-param.obj-code by tt-param.obj-type by tt-param.CashNum by tt-param.ParamGroup by tt-param.KeyBoardName by tt-param.KeyBoardNameDop:
     1407                   for first buf_code exclusive-lock where buf_code.code = tt-param.ParamGroup and buf_code.parent = "cashFunKey":
     1408                     tt-param.ParamGroup = buf_code.code + " " + buf_code.misc1 + " " + buf_code.CodeName .
     1409                   end.
     1410                   if not v-first then
     1411                   do:
     1412                     put stream OutStr-html unformatted
     1413                       '<tr>' skip
     1414                       '<td colspan="11" text_wrap="true" style="">' tt-param.SectionName '</td>' skip
     1415                       '</tr>' skip
     1416                       .
     1417                   end.
     1418                   v-first = true .
     1419                   v-color = getColorKey(tt-param.flag, tt-param.status_, tt-param.diff) .
     1420                   put stream OutStr-html unformatted
     1421                     '<tr>' skip
     1422                     '<td text_wrap="true">' tt-param.obj-name  '</td>' skip
     1423                     '<td text_wrap="true">' tt-param.DeviceName '</td>' skip
     1424                     '<td text_wrap="true">' tt-param.CashNum '</td>' skip
     1425                     '<td text_wrap="true">' if tt-param.DateTime = 0 then "" else fConvetDateTime(tt-param.DateTime) '</td>' skip
     1426                     '<td text_wrap="true">' tt-param.SectionName '</td>' skip
     1427                     '<td text_wrap="true">' tt-param.ParamGroup '</td>' skip
     1428                     '<td text_wrap="true">' tt-param.KeyBoardNameDop '</td>' skip
     1429                     '<td text_wrap="true">' tt-param.KeyBoardName '</td>' skip
     1430                     '<td text_wrap="true">' tt-param.EtalonValue '</td>' skip
     1431                     '<td text_wrap="true">' tt-param.CurrentValue '</td>' skip
     1432                     '<td text_wrap="true" style="background-color: ' + v-color + ';">' getColorText(v-color) '</td>' skip
     1433                     '</tr>' skip
     1434                     .
     1435                 end.
     1436               end.
     1437               if g#db-num = 0 then
     1438               do:
     1439                 put stream OutStr-html unformatted
     1440                   '<tr>' skip
     1441                   '<td text_wrap="true" colspan = "11" style="background-color:#D8EEC0; text-align: center;">Контрольные суммы справочника ЭЗ</td>' skip
     1442                   '</tr>' skip
     1443                   '<tr>' skip
     1444                   '<td colspan = "3" text_wrap="true" style="background-color:#D8EEC0; text-align: center;">Название АЗК/АЗС</td>' skip
     1445                   '<td colspan = "4" text_wrap="true" style="background-color:#D8EEC0; text-align: center;">Контрольная сумма совпадает</td>' skip
     1446                   '<td colspan = "4" text_wrap="true" style="background-color:#D8EEC0; text-align: center;">Контрольная сумма не совпадает</td>' skip
     1447                   '</tr>' skip
     1448                   .
     1449                 define variable trueControlSum  as character no-undo .
     1450                 define variable falseControlSum as character no-undo .
     1451                 define variable vhashcode       as character no-undo.
     1452                 vhashcode = getCashparamHash().
     1453                 for each obj-list where obj-list.obj-type = 'маг':U:
     1454                   trueControlSum = "" .
     1455                   falseControlSum = "" .
     1456                   if vhashcode <> getCashParamHashDb(obj-list.db) then
     1457                   do:
     1458                     falseControlSum = "Да" .
     1459                     v-color = "#FFB3B3" .
     1460                   end.
     1461                   else
     1462                   do:
     1463                     trueControlSum = "Да" .
     1464                     v-color = "white" .
     1465                   end.
     1466                   put stream OutStr-html unformatted
     1467                     '<tr>' skip
     1468                     '<td colspan = "3" text_wrap="true" style="background-color:' + v-color + '; text-align: left;">' + obj-list.obj-name + '</td>' skip
     1469                     '<td colspan = "4" text_wrap="true" style="background-color:' + v-color + '; text-align: right;">' + trueControlSum + '</td>' skip
     1470                     '<td colspan = "4" text_wrap="true" style="background-color:' + v-color + '; text-align: right;">' + falseControlSum + '</td>' skip
     1471                     '</tr>' skip
     1472                     .
     1473                 end.
     1474               end.
     1475               put stream OutStr-html unformatted
     1476                 '<tbody>' skip
     1477                 '</table>'
     1478                 .
     1479               output stream OutStr-html close.
     1480               run prn-lib-reportviewer in this-procedure (
     1481                 input parparentproc
     1482                 ,input v-report-name-html-list
     1483                 ,input ""
     1484                 ) no-error.
     1485               if error-status:error then
     1486               do:
     1487                 message return-value view-as alert-box.
     1488                 return .
     1489               end.
     1490   FUNCTION getColor RETURNS CHARACTER
     1491     ( isflag as char, istatus as int, isdiff as logical ):
     1492     case istatus:
     1493       when 0 or
     1494       when 2 then
     1495         do:
     1496           if isflag = "etalon" then return "#FFDD71" .
     1497           else if isflag = "current" then return "#ffffe0"  .
     1498             else if isdiff then return "#FFB3B3"  .
     1499               else return "#D8EEC0"  .
     1500         end.
     1501       when 1 or
     1502       when 1 then
     1503         do:
     1504           return "#D5EAFF" .
     1505         end.
     1506       otherwise
     1507       do:
     1508         if isflag = "current" then return "#ffffe0"  .
     1509       end.
     1510     end case.
     1511   end.
     1512   FUNCTION getColorKey RETURNS CHARACTER
     1513     ( isflag as char, istatus as int, isdiff as logical ):
     1514     case istatus:
     1515       when 0 or
     1516       when 2 then
     1517         do:
     1518           if isflag = "etalon" then return "#FFDD71" .
     1519           else if isflag = "current" then return "#ffffe0"  .
     1520             else if isdiff then return "#FFB3B3"  .
     1521               else return "#D8EEC0"  .
     1522         end.
     1523       when 1 or
     1524       when 1 then
     1525         do:
     1526           if isflag = "current" then return "#ffffe0"  .
     1527           else return "#D5EAFF" .
     1528         end.
     1529       otherwise
     1530       do:
     1531         if isflag = "current" then return "#ffffe0"  .
     1532       end.
     1533     end case.
     1534   end.
     1535   FUNCTION getColorText RETURNS CHARACTER
     1536     ( iscolor as char ):
     1537     case iscolor:
     1538       when "#FFDD71" then
     1539         do:
     1540           return "Не настроен на кассе" .
     1541         end.
     1542       when "#FFB3B3" then
     1543         do:
     1544           return "Не соответствует эталону (РПД/ИА)" .
     1545         end.
     1546       when "#D8EEC0" then
     1547         do:
     1548           return "Соответствует эталону (РПД/ИА)" .
     1549         end.
     1550       when "#D5EAFF" then
     1551         do:
     1552           return "Необязательный параметр (SiteSpecific)" .
     1553         end.
     1554       when "#ffffe0" then
     1555         do:
     1556           return "Отсутствует в эталоне, но есть на кассе" .
     1557         end.
     1558       otherwise
     1559       do:
     1560         return "" .
     1561       end.
     1562     end case.
     1563   end.
