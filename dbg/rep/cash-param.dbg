      915   FUNCTION CRC32 RETURNS INT64
      916   (INPUT mpData AS MEMPTR):
      917       DEFINE VARIABLE IN_BYtes_Size   AS INTEGER   NO-UNDO.
      918       DEFINE VARIABLE in_byte         AS INTEGER   NO-UNDO.
      919       DEFINE VARIABLE crc_value       AS INT64     NO-UNDO.
      920       DEFINE VARIABLE tmp             AS INT64     NO-UNDO.
      921       DEFINE VARIABLE crc32_tab       AS INT64     NO-UNDO EXTENT 256.
      922       DEFINE VARIABLE in_loop         AS INTEGER     NO-UNDO.
      923       crc32_tab = crc32Table().
      924       crc_value = 0xffffffff.
      925       In_Bytes_Size = GET-SIZE(mpData).
      926       DO in_loop = 1 TO In_Bytes_Size:
      927           tmp = BinaryXOR(crc_value, GET-BYTE(mpData,in_loop )).
      928           crc_value = BinaryXOR( ShiftRight(crc_value, 8), crc32_tab[BinaryAND(tmp,0x00ff) + 1 ] ).
      929       END.
      930       crc_value = BinaryXOR(crc_value, 0xffffffff).
      931       RETURN crc_value.
      932   END .
      933   define temp-table tt-code like code.
      934   function getCashparamHash returns character ():
      935       define variable exp as ibs.th.bge.xmlimpexp no-undo.
      936       define variable hQuery   as handle  no-undo .
      937       define buffer Buf_code for tt-code.
      938       define buffer     code for    code.
      939       FOR EACH code where code.parent begins 'cash-param'
      940                       and num-entries(code.parent,chr(4)) eq 4
      941       no-lock:
      942          create Buf_code.
      943          buffer-copy code except export_ nwsgbd procview procedit to Buf_code.
      944       end.
      945       create query hQuery.
      946       hQuery:set-buffers(buffer Buf_code :HANDLE).
      947       hQuery:query-prepare("FOR EACH Buf_code").
      948       hQuery:query-open ().
      949       exp = new ibs.th.bge.xmlimpexp ().
      950       exp:updatetableforxml(hQuery).
      951       delete object hQuery.
      952       FOR EACH buf_code:
      953          delete buf_code.
      954       end.
      955       define variable vxmlCode as character  no-undo.
      956       define variable v-md5-signature as character no-undo.
      957       exp:xmldom-save  ( "cashparammd5.xml" ).
      958       vxmlCode = search("cashparammd5.xml").
      959       run gbl/md5.p (
      960             input  vxmlCode
      961            ,output v-md5-signature
      962            ) .
      963       os-delete value (vxmlCode).
      964       delete object exp.
      965       return encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      966     .
      967   end.
      968   function getCashParamHashDb returns character (idb as int):
      969      define buffer code for ub.code.
      970      find first code where code.parent eq "CashParamHash"
      971                        and code.code   eq  string(idb)
      972      no-lock no-error.
      973      return if available code then Code.CodeValue else ?.
      974   end.
      975   procedure saveCashParHash:
      976      define input  parameter iDb as integer no-undo.
      977      define buffer code for ub.code.
      978      find first code where code.parent eq ""
      979                        and code.code   eq "CashParamHash"
      980      no-lock no-error.
      981      if not available code
      982      then do:
      983         create code.
      984         assign
      985            Code.parent   = ""
      986            Code.code     = "CashParamHash"
      987            Code.CodeName = "Конрольная сумма Эталонных параметров для кассы"
      988         .
      989      end.
      990      find first code where code.parent eq "CashParamHash"
      991                        and code.code   eq  string(idb)
      992      exclusive-lock no-error.
      993      if not available code
      994      then do:
      995         create Code.
      996         assign
      997            code.parent = "CashParamHash"
      998            code.code   =  string(idb)
      999            Code.nwsubd = yes
     1000         .
     1001      end.
     1002      Code.CodeName  = string(now).
     1003      Code.CodeValue = getCashparamHash().
     1004   end.
