     1009   FUNCTION getColorText RETURNS CHARACTER
     1010     ( iscolor as char  )  FORWARD.
     1011               define temp-table tt-param
     1012                 field CashNum         as integer
     1013                 field ParamGroup      as character case-sensitive
     1014                 field ParamName       as character case-sensitive
     1015                 field KeyboardNameDop as character
     1016                 field Device          as character
     1017                 field DeviceName      as character
     1018                 field DateTime        as decimal
     1019                 field ParamSection    as character
     1020                 field SectionName     as character
     1021                 field EtalonValue     as character
     1022                 field CurrentValue    as character
     1023                 field KeyboardName    as character
     1024                 field obj-code        as integer
     1025                 field obj-type        as character
     1026                 field obj-name        as character
     1027                 field flag            as character
     1028                 field diff            as logical
     1029                 field status_         as integer
     1030                 index pi is primary unique obj-code obj-type ParamGroup Device ParamSection CashNum ParamName KeyboardNameDop
     1031                 .
     1032               define temp-table tt-choose-code
     1033                 field ParamName as character
     1034                 field section   as character
     1035                 field device    as character
     1036                 field group_    as character
     1037                 .
     1038               define stream OutStr-html.
     1039               define input  parameter parparentproc as handle no-undo.
     1040               define input parameter parDesk as character no-undo .
     1041               define input parameter parParam as character no-undo .
     1042               define input parameter parSource as character no-undo .
     1043               define input parameter table for tmprecid .
     1044               define input parameter table for cash-list .
     1045               define buffer buf_param for tt-param .
     1046               define buffer buf_code  for ub.Code .
     1047               define variable v-report-name-html-list as character no-undo .
     1048               define variable v-sort                  as character no-undo .
     1049               v-report-name-html-list = "CashPar_" + string(today,"99999999") + "_" + replace (string(time,"HH:MM"),":","") + ".html".
     1050   function fConvetDateTime returns character
     1051     (input iTStamp as dec):
     1052     define variable vDateTime as datetime no-undo.
     1053     define variable vDate     as date     no-undo.
     1054     define variable vDays     as int64    no-undo.
     1055     define variable vSec      as integer  no-undo.
     1056     vDays = truncate(int64(iTStamp) / 3600 / 24, 0).
     1057     vDate = date("01/01/1970") + vDays.
     1058     vSec = (int64(iTStamp) - vDays * 3600 * 24).
     1059     return string(vDate,"99/99/9999") + " " + string(vSec, "HH:MM:SS").
     1060   end function.
     1061               output stream OutStr-html to value(v-report-name-html-list) convert target 'UTF-8' .
     1062               put stream OutStr-html unformatted
     1063   "<!DOCTYPE HTML>" skip
     1064   ' <html>' skip
     1065   '  <head>' skip
     1066   '   <meta charset="utf-8">' skip
     1067   '    <style type="text/css">' skip
     1068   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1069   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1070   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     1071   '   </style>' skip
     1072   '  </head>' skip
     1073                 '<body>' skip
     1074                 '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1075                 '<thead>' skip
     1076                 ' <tr class="set_columns">' skip
     1077                 ' <td style="width:80px"></td>' skip
     1078                 ' <td style="width:100px"></td>' skip
     1079                 ' <td style="width:80px"></td>' skip
     1080                 ' <td style="width:80px"></td>' skip
     1081                 ' <td style="width:80px"></td>' skip
     1082                 ' <td style="width:150px"></td>' skip
     1083                 ' <td style="width:100px"></td>' skip
     1084                 ' <td style="width:100px"></td>' skip
     1085                 ' <td style="width:100px"></td>' skip
     1086                 ' <td style="width:100px"></td>' skip
     1087                 ' <td style="width:150px"></td>' skip
     1088                 '</tr>' skip .
     1089               define buffer code-section        for ub.code.
     1090               define buffer code-group          for ub.code.
     1091               define buffer code-device         for ub.code.
     1092               define buffer code-param          for ub.code.
     1093               define buffer buf_cash-param-hist for ub.cash-param-hist.
     1094               define buffer clients             for ub.clients.
     1095               define buffer buf_choose-code     for tt-choose-code .
     1096               define variable v-attr-value   as character no-undo.
     1097               define variable v-attr-type    as character no-undo.
     1098               define variable vDeviceKind    as character no-undo.
     1099               define variable cb-device-kind as integer   no-undo.
     1100               define variable mdevice        as class     ibs.th.str.cash.CashDevice
     1101                 no-undo.
     1102               define variable msection       as class     ibs.th.str.cash.CashSection
     1103                 no-undo.
     1104               mdevice = new ibs.th.str.cash.CashDevice().
     1105               msection = new ibs.th.str.cash.CashSection().
     1106               if parParam = "choose" then
     1107               do:
     1108                 for each tmprecid no-lock where tmprecid.fTable = "code":
     1109                   for first ub.Code no-lock where recid(ub.Code) = tmprecid.Frecid:
     1110                     create tt-choose-code.
     1111                     tt-choose-code.device = entry(2,ub.Code.parent,chr(4)) .
     1112                     tt-choose-code.section = entry(3,ub.Code.parent,chr(4)) .
     1113                     tt-choose-code.group_ = entry(4,ub.Code.parent,chr(4)) no-error.
     1114                     if tt-choose-code.group_ = "" then tt-choose-code.group_ = ub.Code.code .
     1115                     else tt-choose-code.ParamName = ub.Code.code .
     1116                   end.
     1117                 end.
     1118               end.
     1119               for each obj-list:
     1120                 for each cash-list no-lock where cash-list.obj-code = obj-list.obj-code:
     1121                   for each buf_cash-param-hist where buf_cash-param-hist.obj-code = obj-list.obj-code and
     1122                     buf_cash-param-hist.obj-type = obj-list.obj-type and
     1123                     buf_cash-param-hist.cash-num = cash-list.cash-num and
     1124                     buf_cash-param-hist.device = integer(cash-list.deviceCode):
     1125                     if parDesk <> "-1" then
     1126                       if lookup(string(buf_cash-param-hist.device), parDesk, ",") = 0 then next .
     1127                     if parParam = "choose" then
     1128                     do:
     1129                       find first tt-choose-code where tt-choose-code.section = buf_cash-param-hist.param_section and
     1130                         tt-choose-code.device = string(buf_cash-param-hist.device) and
     1131                         tt-choose-code.group_ = string(buf_cash-param-hist.param_group) no-error .
     1132                       if available tt-choose-code then
     1133                       do:
     1134                         if tt-choose-code.ParamName <> "" then
     1135                         do:
     1136                           find first buf_choose-code where buf_choose-code.section = buf_cash-param-hist.param_section and
     1137                             buf_choose-code.device = string(buf_cash-param-hist.device) and
     1138                             buf_choose-code.group_ = string(buf_cash-param-hist.param_group) and
     1139                             buf_choose-code.ParamName = string(buf_cash-param-hist.param_name) no-error .
     1140                           if not available (buf_choose-code) then next .
     1141                         end.
     1142                       end.
     1143                       else next .
     1144                     end.
     1145                     create tt-param .
     1146                     assign
     1147                       tt-param.obj-code        = buf_cash-param-hist.obj-code
     1148                       tt-param.obj-type        = buf_cash-param-hist.obj-type
     1149                       tt-param.CashNum         = buf_cash-param-hist.cash-num
     1150                       tt-param.ParamGroup      = buf_cash-param-hist.param_group
     1151                       tt-param.ParamName       = buf_cash-param-hist.param_name
     1152                       tt-param.CurrentValue    = buf_cash-param-hist.param_value
     1153                       tt-param.Device          = string(buf_cash-param-hist.device)
     1154                       tt-param.ParamSection    = buf_cash-param-hist.param_section
     1155                       tt-param.KeyboardName    = buf_cash-param-hist.param_value_dop
     1156                       tt-param.flag            = "current"
     1157                       tt-param.DateTime        = buf_cash-param-hist.tstamp
     1158                       tt-param.KeyBoardNameDop = buf_cash-param-hist.param_name
     1159                       .
     1160                     tt-param.DeviceName   = mdevice:GetLabel(buf_cash-param-hist.device).
     1161                     tt-param.SectionName   = msection:GetLabel(int(buf_cash-param-hist.param_section)).
     1162                     find first clients no-lock where clients.obj-code = tt-param.obj-code and
     1163                       clients.obj-type = tt-param.obj-type no-error .
     1164                     if available (clients) then tt-param.obj-name = clients.obj-name .
     1165                   end.
     1166                 end.
     1167               end.
     1168               for each code-device where code-device.parent = "cash-param" no-lock:
     1169                 if parDesk <> "-1" then
     1170                   if lookup(string(code-device.code), parDesk, ",") = 0 then next .
     1171                 for each code-section where code-section.parent = code-device.parent + chr(4) + code-device.code no-lock:
     1172                   for each code-group where code-group.parent = code-section.parent + chr(4) + code-section.code no-lock:
     1173                     for each code-param where code-param.parent = code-group.parent + chr(4) + code-group.code no-lock:
     1174                       if parParam = "choose" then
     1175                       do:
     1176                         find first tt-choose-code where tt-choose-code.section = code-section.code and
     1177                           tt-choose-code.device = code-device.code and
     1178                           tt-choose-code.group_ = code-group.code no-error .
     1179                         if available tt-choose-code then
     1180                         do:
     1181                           if tt-choose-code.ParamName <> "" then
     1182                           do:
     1183                             find first buf_choose-code where buf_choose-code.section = code-section.code and
     1184                               buf_choose-code.device = code-device.code and
     1185                               buf_choose-code.group_ = code-group.code and
     1186                               buf_choose-code.ParamName = code-param.code no-error .
     1187                             if not available (buf_choose-code) then next .
     1188                           end.
     1189                         end.
     1190                         else next .
     1191                       end.
     1192                       for each obj-list:
     1193                         for each cash-list where cash-list.obj-code = obj-list.obj-code and cash-list.deviceCode = code-device.code:
     1194                           if code-section.code = "1" then
     1195                           do:
     1196                             find first tt-param exclusive-lock where tt-param.ParamGroup = code-group.code and
     1197                               tt-param.obj-code = obj-list.obj-code and
     1198                               tt-param.obj-type = obj-list.obj-type and
     1199                               tt-param.ParamName = code-param.code and
     1200                               tt-param.ParamSection = code-section.code and
     1201                               tt-param.CashNum = cash-list.cash-num and
     1202                               tt-param.Device = cash-list.deviceCode no-error .
     1203                             if not available (tt-param) then
     1204                             do:
     1205                               create tt-param .
     1206                               assign
     1207                                 tt-param.obj-code     = obj-list.obj-code
     1208                                 tt-param.obj-type     = obj-list.obj-type
     1209                                 tt-param.ParamGroup   = code-group.code
     1210                                 tt-param.Device       = code-device.code
     1211                                 tt-param.ParamSection = code-section.code
     1212                                 tt-param.ParamName    = code-param.code
     1213                                 tt-param.flag         = "etalon"
     1214                                 tt-param.diff         = true
     1215                                 tt-param.CashNum      = cash-list.cash-num
     1216                                 .
     1217                               tt-param.DeviceName   = mdevice:GetLabel(int(code-device.code)) .
     1218                               tt-param.SectionName  =  msection:GetLabel(int(code-section.code)).
     1219                             end.
     1220                             else tt-param.flag = "" .
     1221                             assign
     1222                               tt-param.EtalonValue = code-param.CodeValue
     1223                               tt-param.status_     = code-param.status_
     1224                               .
     1225                           end.
     1226                           else
     1227                           do:
     1228                             find first tt-param exclusive-lock where tt-param.ParamGroup = code-group.code and
     1229                               tt-param.obj-code = obj-list.obj-code and
     1230                               tt-param.obj-type = obj-list.obj-type and
     1231                               tt-param.ParamSection = code-section.code and
     1232                               tt-param.KeyBoardNameDop = code-param.code and
     1233                               tt-param.CashNum = cash-list.cash-num and
     1234                               tt-param.Device = cash-list.deviceCode no-error .
     1235                             if not available (tt-param) then
     1236                             do:
     1237                               create tt-param .
     1238                               assign
     1239                                 tt-param.obj-code        = obj-list.obj-code
     1240                                 tt-param.obj-type        = obj-list.obj-type
     1241                                 tt-param.ParamGroup      = code-group.code
     1242                                 tt-param.Device          = code-device.code
     1243                                 tt-param.ParamSection    = code-section.code
     1244                                 tt-param.KeyBoardNameDop = code-param.code
     1245                                 tt-param.flag            = "etalon"
     1246                                 tt-param.diff            = true
     1247                                 tt-param.CashNum         = cash-list.cash-num
     1248                                 .
     1249                               tt-param.DeviceName   = mdevice:GetLabel(int(code-device.code)) .
     1250                               tt-param.SectionName  =  msection:GetLabel(int(code-section.code)).
     1251                             end.
     1252                             else tt-param.flag = "" .
     1253                             assign
     1254                               tt-param.EtalonValue = code-param.CodeValue
     1255                               tt-param.status_     = code-param.status_
     1256                               .
     1257                           end.
     1258                           if tt-param.CurrentValue <> tt-param.EtalonValue and tt-param.flag = "" then tt-param.diff = true .
     1259                           find first clients no-lock where clients.obj-code = tt-param.obj-code and
     1260                             clients.obj-type = tt-param.obj-type no-error .
     1261                           if available (clients) then tt-param.obj-name = clients.obj-name .
     1262                         end.
     1263                       end.
     1264                     end.
     1265                   end.
     1266                 end.
     1267               end.
     1268               case parParam:
     1269                 when "mandatory" then
     1270                   do:
     1271                     for each tt-param exclusive-lock where tt-param.flag = "current" or (tt-param.status_ = 1 and tt-param.flag <> "current"):
     1272                       delete tt-param .
     1273                     end.
     1274                   end.
     1275                 when "optional" then
     1276                   do:
     1277                     for each tt-param exclusive-lock where tt-param.flag = "current" or (tt-param.status_ = 0 and tt-param.flag <> "current"):
     1278                       delete tt-param .
     1279                     end.
     1280                   end.
     1281                 when "diff" then
     1282                   do:
     1283                     for each tt-param exclusive-lock where not tt-param.diff and tt-param.flag = "":
     1284                       delete tt-param .
     1285                     end.
     1286                   end.
     1287               end.
     1288               define variable cashQntyCheck       as integer no-undo .
     1289               define variable diffCashParam       as integer no-undo .
     1290               define variable diffCashKeyBoard    as integer no-undo .
     1291               define variable withoutCashParam    as integer no-undo .
     1292               define variable withoutCashKeyBoard as integer no-undo .
     1293               for each obj-list no-lock where obj-list.obj-type = 'маг':U:
     1294                 for each cash-list no-lock where cash-list.obj-code = obj-list.obj-code:
     1295                   cashQntyCheck = cashQntyCheck + 1 .
     1296                   if can-find (first buf_param no-lock where buf_param.CashNum = cash-list.cash-num and
     1297                     buf_param.obj-code = cash-list.obj-code and
     1298                     buf_param.SectionName = "Параметры" and
     1299                     (buf_param.diff or buf_param.flag <> "")) then diffCashParam = diffCashParam + 1 .
     1300                   else withoutCashParam = withoutCashParam + 1 .
     1301                   if can-find (first buf_param no-lock where buf_param.CashNum = cash-list.cash-num and
     1302                     buf_param.obj-code = cash-list.obj-code and
     1303                     buf_param.SectionName <> "Параметры" and
     1304                     (buf_param.diff or buf_param.flag <> "")) then
     1305                     diffCashKeyBoard = diffCashKeyBoard + 1 .
     1306                   else withoutCashKeyBoard = withoutCashKeyBoard + 1 .
     1307                 end.
     1308               end.
     1309               put stream OutStr-html unformatted
     1310                 '<tr><!-- шапка таблицы -->' skip
     1311                 '<td colspan="11" style="text-align: right;"></td>' skip
     1312                 '</tr>' skip
     1313                 '<tr>' skip
     1314                 '<td colspan="11" style="text-align: right;">Дата формирования ' + string(today,"99.99.9999") + " " + string(time,"HH:MM:SS") + '</td>'
     1315                 '</tr>' skip
     1316                 '<tr>' skip
