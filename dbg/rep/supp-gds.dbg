     4071                             ,output v-fltopend-rowid
     4072                             ) no-error.
     4073         .
     4074         v-doc-rec = ?.
     4075       end.
     4076       assign
     4077         l-query-was-opened = true
     4078       .
     4079     end.
     4080   end.
     4081     run waitfram-hide in this-procedure .
     4082         end.
     4083       END CASE.
     4084     end.
     4085   END CASE.
     4086   if v-doc-rec <> ? then
     4087   REPOSITION br-parts to recid v-doc-rec No-ERROR.
     4088   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4089   query br-parts:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4090   if error-status:error
     4091   or (v-doc-rec = ? and v-fltopend-rowid[1] = ?)
     4092   then do:
     4093     reposition br-parts to row 1 no-error.
     4094   end.
     4095   run waitfram-hide in this-procedure .
     4096   APPLY "ENTRY" TO br-parts.
     4097   APPLY "VALUE-CHANGED" TO br-parts in frame dialog-frame.
     4098   END PROCEDURE.
     4099   procedure proc-find-sh-code :
     4100   define input parameter p-next as logical no-undo.
     4101   define input parameter p-sh-code as character no-undo .
     4102   define variable v-search-code as char no-undo.
     4103   define variable varresult   as character                no-undo.
     4104   define variable vartype-bc  as character                no-undo.
     4105   define variable varweight   as decimal                  no-undo.
     4106   define buffer search-goods for ub.goods.
     4107   do
     4108   on error undo, return error
     4109   :
     4110   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4111   define variable varscales-pref as character no-undo .
     4112   define variable varpgscales-pref as character no-undo .
     4113   define variable varscales-pref-type30 as character no-undo.
     4114   varscales-pref  = ?.
     4115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4116     (input  'sclspref':u
     4117     ,input  '':u
     4118     ,input  '':u
     4119     ,input  0
     4120     ,input  '':u
     4121     ,input  '':u
     4122     ,input  '':u
     4123     ,input  no
     4124     ,output varscales-pref
     4125     ,output varscales-pref-type30
     4126     ) no-error .
     4127   if varscales-pref = ? then do:
     4128     assign
     4129     varscales-pref = '21,23,25':U.
     4130   end.
     4131   define variable varpgscales-pref-type30 as character no-undo.
     4132   varpgscales-pref  = ?.
     4133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4134     (input  'scpgpref':u
     4135     ,input  '':u
     4136     ,input  '':u
     4137     ,input  0
     4138     ,input  '':u
     4139     ,input  '':u
     4140     ,input  '':u
     4141     ,input  no
     4142     ,output varpgscales-pref
     4143     ,output varpgscales-pref-type30
     4144     ) no-error .
     4145   if varpgscales-pref = ? then do:
     4146     assign
     4147     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     4148   end.
     4149     assign
     4150     v-search-code = string(p-sh-code).
     4151   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     4152   (
     4153    input  parparentproc
     4154   ,input  v-search-code
     4155   ,input  ?
     4156   ,input  p-curr-obj-type
     4157   ,input  p-curr-obj-code
     4158   ,input  yes
     4159   ,input  no
     4160   ,input  varscales-pref
     4161   ,input  varpgscales-pref
     4162   ,output varresult
     4163   ,output vartype-bc
     4164   ,output varweight
     4165   ,buffer ub.bar-code
     4166   ,buffer ub.prod-bc
     4167   ,buffer ub.place
     4168   ) no-error.
     4169     if available bar-code then do:
     4170       find search-goods no-lock where
     4171           search-goods.gds-code = bar-code.gds-code no-error.
     4172     end.
     4173     else do:
     4174       message
     4175       "Бар-код не найден!"
     4176       view-as alert-box.
     4177       apply "entry" to sh-code in frame dialog-frame .
     4178       undo, return error .
     4179     end.
     4180     run OpenBr in this-procedure
     4181         (input false
     4182         ,input p-next
     4183         ,input substitute("and s-parts.artic = &1 and s-parts.prod-type = &2 and s-parts.prod-code = &3 " +
     4184                           "and s-parts.in-code = &4 and s-parts.part-code = &5 "
     4185           , search-goods.artic
     4186           , search-goods.prod-type
     4187           , search-goods.prod-code
     4188           , bar-code.in-code
     4189           , bar-code.part-code
     4190           )
     4191         ).
     4192     apply "entry":u to sh-code in frame dialog-frame .
     4193   end.
     4194   end procedure.
     4195   procedure proc-b-sch :
