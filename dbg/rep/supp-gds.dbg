     2365   procedure get-context :
     2366      define output parameter p-db-num as integer          no-undo.
     2367      define output parameter p-user-id as character        no-undo.
     2368      define variable v-login               as character    no-undo.
     2369      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2370      define buffer buf_user-login  for ub.user-login .
     2371      do
     2372      on error undo, return error
     2373      :
     2374            FIND FIRST buf_sys-ctrl no-lock.
     2375            ASSIGN
     2376               v-login = USERID("ub")
     2377               p-db-num = buf_sys-ctrl.db-num
     2378            .
     2379            FIND FIRST buf_user-login
     2380                 WHERE buf_user-login.db-num = p-db-num
     2381                   AND buf_user-login.user-login = v-login
     2382                 no-lock
     2383                 no-error
     2384                 .
     2385            IF AVAILABLE buf_user-login
     2386            THEN DO:
     2387               assign
     2388                  p-user-id = buf_user-login.user-id
     2389               .
     2390            END.
     2391      end.
     2392   end procedure.
     2393       run diasize_init in this-procedure .
     2394   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2395   procedure set-filter-name :
     2396   define input parameter p-filter-name as character no-undo .
     2397     do with frame dialog-frame:
     2398       if p-filter-name > "" then do:
     2399         assign
     2400           frame dialog-frame:title
     2401             = frame dialog-frame:title + "   ФИЛЬТР: " + p-filter-name.
     2402         .
     2403         assign
     2404           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2405         .
     2406       end.
     2407       else do:
     2408         assign
     2409           b-sch :tooltip = ""
     2410         .
     2411       end.
     2412     end.
     2413   end procedure.
     2414   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2415   do:
     2416     br-parts :SET-REPOSITIONED-ROW(3, "CONDITIONAL") .
     2417   end.
     2418   MAIN-BLOCK:
     2419   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2420      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2421   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2423     (input  p-curr-obj-type
     2424     ,input  p-curr-obj-code
     2425     ,output p-curr-host-code
     2426     )  .
     2427     assign
     2428     rs-parts = p-r-parts
     2429     rs-one-all = p-one-all
     2430     .
     2431     find first supp_clients where
     2432                supp_clients.obj-type = p-supp-type
     2433            and supp_clients.obj-code = p-supp-code no-lock.
     2434     dispLAY
     2435     rs-parts
     2436     rs-one-all
     2437     with frame dialog-frame.
     2438     ENABLE
     2439     b-exit
     2440     b-gds
     2441     b-alt
     2442     b-pl
     2443     b-help
     2444     b-print
     2445     sh-code
     2446     br-parts
     2447     b-in
     2448     b-doc
     2449     b-sch
     2450     rs-parts
     2451     ed-notes
     2452     rs-one-all
     2453     WITH FRAME dialog-frame.
     2454     v-doc-rec = ?.
     2455     run OpenBr in this-procedure ( input yes, input no, input no).
     2456     WAIT-FOR GO OF FRAME dialog-frame focus br-parts.
     2457   END.
     2458   RUN disable_UI.
     2459   PROCEDURE disable_UI :
     2460     HIDE FRAME dialog-frame.
     2461   END PROCEDURE.
     2462   PROCEDURE OpenBr :
     2463   define input  parameter p-open-query     as logical   no-undo .
     2464   define input  parameter p-find-next      as logical   no-undo .
     2465   define input  parameter p-find-condition as character no-undo .
     2466   define variable l-query-was-opened as logical no-undo .
     2467   define variable title0 as character no-undo.
     2468   title0 = "Поставщик-партии-остатки" + chr(32).
     2469   run waitfram-show in this-procedure ("Ждите...").
     2470   define variable sort-column-phrase as character no-undo .
     2471   case sort-column-name :
     2472     when "" then do:
     2473       assign
     2474         sort-column-phrase = ""
     2475       .
     2476     end.
     2477     otherwise do:
     2478       assign
     2479         sort-column-phrase = "by " + sort-column-name
     2480       .
     2481     end.
     2482   end case.
     2483   define variable l-open-query as logical   no-undo .
     2484   CASE rs-one-all :
     2485     WHEN "all"        THEN DO:
     2486       disable sh-code with frame dialog-frame.
     2487       case rs-parts :
     2488         when "input" then do:
     2489           ASSIGN
     2490           filter-point = filter-point0 + rs-one-all + rs-parts
     2491           filter-label = substitute("&1 Приходы по фирме", filter-label0)
     2492           .
     2493           if p-open-query then do:
     2494           frame dialog-frame:title = substitute("Поставщик: &1&2 &3 ПРИХОДЫ по фирме &4"
     2495                                                 , supp_clients.obj-type
     2496                                                 , supp_clients.obj-code
     2497                                                 , string(supp_clients.obj-name, "X(45)")
     2498                                                 , p-curr-host-code).
     2499           end.
     2500   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2501   define variable  l-disable-where-15  as logical   no-undo .
     2502   define variable  l-filter-open-15    as logical   .
     2503   define variable  flt-rec-15       as recid     no-undo .
     2504   define variable  filter-name-15      as character no-undo .
     2505   define variable  where-phrase-15     as character no-undo .
     2506   define variable  sort-phrase-15      as character no-undo .
     2507   define variable  where-phrase-rus-15 as character no-undo .
     2508   define variable  sort-phrase-rus-15  as character no-undo .
     2509     run waitfram-show in this-procedure
     2510       (input "ЖДИТЕ ..."
     2511       ).
     2512   run gbl/flt-get.p
     2513     (input filter-point
     2514     ,output flt-rec-15
     2515     ,output filter-name-15
     2516     ,output where-phrase-15
     2517     ,output sort-phrase-15
     2518     ,output where-phrase-rus-15
     2519     ,output sort-phrase-rus-15
     2520     ).
     2521   if p-open-query then do:
     2522       run set-filter-name in this-procedure
     2523         (INPUT filter-name-15
     2524         ) no-error .
     2525     assign
     2526       l-filter-open-15 = false
     2527     .
     2528     if flt-rec-15 <> ?
     2529       or sort-column-phrase > ""
     2530     then do:
     2531       define variable  parameter-2-15 as character no-undo .
     2532       define variable  parameter-3-15 as character no-undo .
     2533       define variable  parameter-4-15 as character no-undo .
     2534       define variable  parameter-5-15 as character no-undo .
     2535       define variable  parameter-6-15 as character no-undo .
     2536       define variable  parameter-7-15 as character no-undo .
     2537         assign
     2538         parameter-3-15 =
     2539                                 "FOR EACH s-parts"
     2540         parameter-4-15 =
     2541           (
     2542             if (" s-parts.supp-type = p-supp-type                       and s-parts.supp-code = p-supp-code                       and s-parts.host-code = p-curr-host-code                       and s-parts.status_ = yes                       and s-parts.in-code = s-parts.out-code " + " " + where-phrase-15) <> ""
     2543             then  substitute('s-parts.supp-type = &1&2&1                       and s-parts.supp-code = &3                       and s-parts.host-code = &4                       and s-parts.status_ = yes                       and s-parts.in-code = &1&5&1 ', chr(34), p-supp-type, p-supp-code, p-curr-host-code, s-parts.out-code) + " " + where-phrase-15
     2544             else "true"
     2545           )
     2546         parameter-5-15 = (" " + "" + " " + ", first s-goods no-lock where s-goods.artic = s-parts.artic                                  and s-goods.prod-type = s-parts.prod-type                                  and s-goods.prod-code = s-parts.prod-code")
     2547         parameter-6-15 = if sort-phrase-15 = ''
     2548                              then
     2549           (
     2550           " " + "  " +
     2551             " " + sort-column-phrase +
     2552           " " + "  "
     2553           )
     2554                              else
     2555           (
     2556           " " + "  " +
     2557             " " + sort-column-phrase +
     2558           " " + sort-phrase-15
     2559           )
     2560         parameter-7-15 =
     2561           " indexed-reposition  "
     2562       .
     2563       do
     2564       on stop undo, leave
     2565       on error undo, leave
     2566       :
     2567         assign
     2568           l-disable-where-15 =
     2569             (" s-parts.supp-type = p-supp-type                       and s-parts.supp-code = p-supp-code                       and s-parts.host-code = p-curr-host-code                       and s-parts.status_ = yes                       and s-parts.in-code = s-parts.out-code " + " " + where-phrase-15 = "")
     2570         .
     2571         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2572                             ,input QUERY br-parts:handle
     2573                             ,input parameter-3-15
     2574                             ,input parameter-4-15
     2575                             ,input parameter-5-15
     2576                             ,input parameter-6-15
     2577                             ,input parameter-7-15
     2578                             )
     2579         .
     2580         assign
     2581           l-filter-open-15 = true
     2582         .
     2583       end.
     2584       if l-filter-open-15 = false then do:
     2585         message
     2586           "Ошибка при фильтрации / сортировке" skip
     2587           "Будут показаны записи без учета фильтра" skip
     2588           view-as alert-box .
     2589       end.
     2590       else do:
     2591           assign
     2592             l-query-was-opened = true
     2593           .
     2594       end.
     2595     end.
     2596     if l-filter-open-15 = false then do:
     2597       OPEN QUERY br-parts FOR EACH s-parts
     2598         where  s-parts.supp-type = p-supp-type                       and s-parts.supp-code = p-supp-code                       and s-parts.host-code = p-curr-host-code                       and s-parts.status_ = yes                       and s-parts.in-code = s-parts.out-code
     2599       , first s-goods no-lock where s-goods.artic = s-parts.artic                                  and s-goods.prod-type = s-parts.prod-type                                  and s-goods.prod-code = s-parts.prod-code
     2600         indexed-reposition
     2601     .
     2602         assign
     2603           l-query-was-opened = true
     2604         .
     2605     end.
     2606   end.
     2607   else do:
     2608     assign
     2609       v-doc-rec = recid( s-parts )
     2610     .
     2611     do
     2612     on stop undo, leave
     2613     on error undo, leave
     2614     :
     2615       if QUERY br-parts:handle:get-buffer-handle(1) = (buffer s-parts:handle) then do:
     2616         assign
     2617         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2618         parameter-4-15 =
     2619           "where ":u +  substitute('s-parts.supp-type = &1&2&1                       and s-parts.supp-code = &3                       and s-parts.host-code = &4                       and s-parts.status_ = yes                       and s-parts.in-code = &1&5&1 ', chr(34), p-supp-type, p-supp-code, p-curr-host-code, s-parts.out-code) + " ":u + where-phrase-15 + " ":u + p-find-condition + " " + ""
     2620         parameter-5-15 = "  "
     2621       .
     2622         run fltopend_fltfindd in this-procedure  (
     2623                             input this-procedure:handle
     2624                             ,input QUERY br-parts:handle
     2625                             ,input rowid(s-parts)
     2626                             ,input logical(parameter-2-15)
     2627                             ,input no-lock
     2628                             ,input (buffer s-parts:handle)
     2629                             ,input parameter-4-15
     2630                             ,input parameter-5-15
     2631                             ) no-error.
     2632         .
     2633         assign
     2634           v-doc-rec = integer(return-value)
     2635           v-fltopend-rowid[1] = ?
     2636         .
     2637       end.
     2638       else do:
     2639         assign
     2640         parameter-2-15 = (if p-find-next then "true":u else "false":u )
     2641         parameter-3-15 =  "FOR EACH s-parts"
     2642         parameter-4-15 =
     2643           (
     2644             if (" s-parts.supp-type = p-supp-type                       and s-parts.supp-code = p-supp-code                       and s-parts.host-code = p-curr-host-code                       and s-parts.status_ = yes                       and s-parts.in-code = s-parts.out-code " + " " + where-phrase-15) <> ""
     2645             then  substitute('s-parts.supp-type = &1&2&1                       and s-parts.supp-code = &3                       and s-parts.host-code = &4                       and s-parts.status_ = yes                       and s-parts.in-code = &1&5&1 ', chr(34), p-supp-type, p-supp-code, p-curr-host-code, s-parts.out-code) + " " + where-phrase-15
     2646             else "true"
     2647           )
     2648         parameter-5-15 = (" " + "" + " " + ", first s-goods no-lock where s-goods.artic = s-parts.artic                                  and s-goods.prod-type = s-parts.prod-type                                  and s-goods.prod-code = s-parts.prod-code" + " " + p-find-condition)
     2649         parameter-6-15 = if sort-phrase-15 = ''
     2650                              then
     2651           (
     2652           " " + "  " +
     2653             " " + sort-column-phrase +
     2654           " " + "  "
     2655           )
     2656                              else
     2657           (
     2658           " " + "  " +
     2659             " " + sort-column-phrase +
     2660           " " + sort-phrase-15
     2661           )
     2662         parameter-7-15 =
     2663           " indexed-reposition  "
     2664       .
     2665         run fltopend_fltfindq in this-procedure  (
     2666                             input this-procedure:handle
     2667                             ,input QUERY br-parts:handle
     2668                             ,input logical(parameter-2-15)
     2669                             ,input no-lock
     2670                             ,input parameter-3-15
     2671                             ,input parameter-4-15
     2672                             ,input parameter-5-15
     2673                             ,input parameter-6-15
     2674                             ,input parameter-7-15
     2675                             ,output v-fltopend-rowid
     2676                             ) no-error.
     2677         .
     2678         v-doc-rec = ?.
     2679       end.
     2680       assign
     2681         l-query-was-opened = true
     2682       .
     2683     end.
     2684   end.
     2685     run waitfram-hide in this-procedure .
     2686         end.
     2687         when "all":U then do:
     2688           if p-open-query then do:
     2689           frame dialog-frame:title = substitute("Поставщик: &1&2 &3 ВСЕ ПАРТИИ по фирме &4"
     2690                                                   , supp_clients.obj-type
     2691                                                   , supp_clients.obj-code
     2692                                                   , string(supp_clients.obj-name, "X(45)")
     2693                                                   , p-curr-host-code).
     2694           end.
     2695           assign
     2696           filter-point = filter-point0 + rs-one-all + rs-parts
     2697           filter-label = substitute("&1 Партии по фирме", filter-label0).
     2698   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2699   define variable  l-disable-where-17  as logical   no-undo .
