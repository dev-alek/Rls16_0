     2222   procedure diasize_init :
     2223     define variable v-default-value    as logical   no-undo .
     2224     define variable v-restore-saved    as logical   no-undo .
     2225     define variable v-resize-value-str as character no-undo .
     2226     do
     2227     on error undo, return error return-value
     2228     :
     2229       do with frame dialog-frame
     2230       :
     2231         assign
     2232           v-diasize-orig-frame-height = frame dialog-frame :height
     2233           v-diasize-orig-frame-width  = frame dialog-frame :width
     2234           v-diasize-browse-handle     = browse br-parts :handle
     2235         .
     2236         create button v-diasize-resize-button
     2237         assign
     2238           parent        = frame dialog-frame :first-child
     2239           label         = "s"
     2240           height-pixels = 16
     2241           width-pixels  = 16
     2242           visible       = true
     2243           sensitive     = true
     2244           movable       = true
     2245           triggers:
     2246             on end-move persistent run diasize_end-move in this-procedure .
     2247           end triggers.
     2248         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2249         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2250         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2251         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2252         assign
     2253           v-diasize-wndmax = false
     2254         .
     2255         if connected("ub") = true
     2256         then do:
     2257           define variable v-cntxt-db-num        as integer   no-undo .
     2258           define variable v-cntxt-userid        as character no-undo .
     2259           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2260                                             , OUTPUT v-cntxt-userid
     2261                                             ) .
     2262           run gbl/wndpar_r.p
     2263             (input  v-cntxt-db-num
     2264             ,input  v-cntxt-userid
     2265             ,input  'wndmax':U
     2266             ,output v-diasize-wndmax
     2267             ,output v-default-value
     2268             ) .
     2269         end.
     2270         assign
     2271           v-diasize-wndstore = false
     2272         .
     2273         if connected("ub") = true
     2274         then do:
     2275           run gbl/wndpar_r.p
     2276             (input  v-cntxt-db-num
     2277             ,input  v-cntxt-userid
     2278             ,input  'wndstore':U
     2279             ,output v-diasize-wndstore
     2280             ,output v-default-value
     2281             ) .
     2282         end.
     2283         assign
     2284           v-diasize-proc-name = entry(1, program-name(2), '.')
     2285         .
     2286         if v-diasize-wndstore = true
     2287         then do:
     2288           assign
     2289             v-restore-saved = false
     2290           .
     2291           if connected("ub") = true
     2292           then do:
     2293             run gbl/wndsizer.p
     2294               (input  v-cntxt-db-num
     2295               ,input  v-cntxt-userid
     2296               ,input  v-diasize-proc-name
     2297               ,input  'height':u
     2298               ,output v-resize-value-str
     2299               ) .
     2300             if v-resize-value-str <> '':U
     2301             then do:
     2302               run diasize_change-height in this-procedure
     2303                 (input  integer(v-resize-value-str)
     2304                 ,input  true
     2305                 ) .
     2306               assign
     2307                 v-restore-saved = true
     2308               .
     2309             end.
     2310           end.
     2311           if connected("ub") = true
     2312           then do:
     2313             run gbl/wndsizer.p
     2314               (input  v-cntxt-db-num
     2315               ,input  v-cntxt-userid
     2316               ,input  v-diasize-proc-name
     2317               ,input  'width':u
     2318               ,output v-resize-value-str
     2319               ) .
     2320             if v-resize-value-str <> '':U
     2321             then do:
     2322               run diasize_change-width in this-procedure
     2323                 (input  integer(v-resize-value-str)
     2324                 ,input  true
     2325                 ) .
     2326               assign
     2327                 v-restore-saved = true
     2328               .
     2329             end.
     2330           end.
     2331           if v-restore-saved <> true
     2332           then do:
     2333             if v-diasize-wndmax = true
     2334             then do:
     2335               run diasize_maximize in this-procedure
     2336                 (input  true
     2337                 ) .
     2338             end.
     2339           end.
     2340         end.
     2341         else do:
     2342           if v-diasize-wndmax = true
     2343           then do:
     2344             run diasize_maximize in this-procedure
     2345               (input  true
     2346               ) .
     2347           end.
     2348         end.
     2349       end.
     2350     end.
     2351   end procedure.
     2352   procedure diasize_need-full-display :
     2353     define output parameter p-need-full-display as logical   no-undo .
     2354     do
     2355     on error undo, return error return-value
     2356     :
