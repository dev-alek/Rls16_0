      117   define new global shared variable g#library  as handle no-undo .
      118   define new global shared variable g#library2 as handle no-undo .
      119   define new global shared variable g#libbcrcn as handle no-undo .
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define variable c-point  as character no-undo .
      122   define variable tbl      as character no-undo .
      123   define variable join-tbl as character no-undo .
      124   define variable fld      as character no-undo .
      125   define variable lab      as character no-undo .
      126   define variable spr      as character no-undo .
      127   define variable dim      as character no-undo .
      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   procedure fltfield-clear :
      130     define output parameter loc-fld as character no-undo.
      131     define output parameter loc-lab as character no-undo .
      132     define output parameter loc-spr as character no-undo .
      133     define output parameter loc-dim as character no-undo .
      134     assign
      135       loc-fld = ""
      136       loc-lab = ""
      137       loc-spr = ""
      138       loc-dim = "0"
      139     .
      140   end procedure .
      141   procedure fltfield-add :
      142     define input        parameter par-fld as character no-undo.
      143     define input        parameter par-lab as character no-undo .
      144     define input        parameter par-spr as character no-undo .
      145     define input-output parameter loc-fld as character no-undo.
      146     define input-output parameter loc-lab as character no-undo .
      147     define input-output parameter loc-spr as character no-undo .
      148     define input-output parameter loc-dim as character no-undo .
      149     do
      150     on error undo, return error
      151     :
      152       assign
      153       loc-fld = if loc-dim = '0'
      154                 then par-fld
      155                 else (loc-fld + chr(44) + par-fld)
      156       loc-lab = if loc-dim = '0'
      157                 then par-lab
      158                 else (loc-lab + chr(44) + par-lab)
      159       loc-spr = if loc-dim = '0'
      160                 then par-spr
      161                 else (loc-spr + chr(44) + par-spr)
      162       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      163                 string(integer(if num-entries(loc-dim) > 1
      164                               then entry(2, loc-dim)
      165                               else entry(1, loc-dim)
      166                               ) + 1)
      167       no-error
      168       .
      169     end.
      170   end procedure.
      171   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   procedure alc-lib_mark-name :
      173     define input  parameter p-mark-db-num   as integer   no-undo .
      174     define input  parameter p-mark-code     as integer   no-undo .
      175     define output parameter p-mark-name     as character no-undo .
      176     define buffer buf_ex-mark for ub.ex-mark .
      177     do
      178     on error undo, return error return-value
      179     :
      180       if p-mark-db-num = ?
      181       or p-mark-code   = ?
      182       then do:
      183         assign
      184           p-mark-name = '?':u
      185         .
      186         return .
      187       end.
      188       if  p-mark-db-num = 0
      189       and p-mark-code   = 0
      190       then do:
      191         assign
      192           p-mark-name = ""
      193         .
      194         return .
      195       end.
      196       find first buf_ex-mark no-lock
      197         where buf_ex-mark.db-num    = p-mark-db-num
      198           and buf_ex-mark.mark-code = p-mark-code
      199         no-error .
      200       if available buf_ex-mark
      201       then do:
      202         assign
      203           p-mark-name = substitute('&1':u
      204                                   ,buf_ex-mark.mark-name
      205                                   )
      206         .
      207       end.
      208     end.
      209   end procedure.
      210   procedure alc-lib_get-new-part-code :
      211     define input  parameter p-obj-type       as character no-undo .
      212     define input  parameter p-obj-code       as integer   no-undo .
      213     define input  parameter p-prod-type      as character no-undo .
      214     define input  parameter p-prod-code      as integer   no-undo .
      215     define input  parameter p-artic          as character no-undo .
      216     define input  parameter p-doc-code       as character no-undo .
      217     define output parameter p-new-part-code  as character no-undo .
      218     define variable v-cur-part-code as integer no-undo.
      219     define variable v-max-part-code as integer no-undo.
      220     define variable i               as integer no-undo.
      221     define buffer bf_parts for ub.parts .
      222     do
      223     on error undo, return error return-value
      224     :
      225       assign
      226         v-max-part-code = 0
      227       .
      228       for each bf_parts no-lock
      229             where bf_parts.obj-type  = p-obj-type  and
      230                   bf_parts.obj-code  = p-obj-code  and
      231                   bf_parts.prod-type = p-prod-type and
      232                   bf_parts.prod-code = p-prod-code and
      233                   bf_parts.artic     = p-artic     and
      234                   bf_parts.out-code  = p-doc-code
      235         :
      236         assign
      237           v-cur-part-code = integer(bf_parts.part-code)
      238           no-error.
      239         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
      240           assign
      241             v-max-part-code = v-cur-part-code
      242           .
      243         end.
      244       end.
      245       assign
      246         p-new-part-code = string (v-max-part-code + 1)
      247       .
      248     end.
      249   end procedure.
      250   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      251   FUNCTION get-parts-part-code RETURNS CHARACTER
      252     ( BUFFER buf_parts FOR ub.parts
      253     , INPUT p-goods-alcohol-prod AS LOGICAL
      254     ) :
      255     define variable v-show-part-code as character no-undo .
      256     if (p-goods-alcohol-prod = false) and (buf_parts.part-code = '':u)
      257     then do:
      258       return '------':u .
      259     end.
      260     run partsfnc_get-parts-show-code in this-procedure
      261       (input  buf_parts.part-code
      262       ,input  buf_parts.mark-db-num
      263       ,input  buf_parts.mark-code
      264       ,input  buf_parts.alc-bottling-date
      265       ,input  p-goods-alcohol-prod
      266       ,output v-show-part-code
      267       ) .
      268     return v-show-part-code .
      269   END FUNCTION.
      270   procedure partsfnc_get-parts-show-code :
      271     define input  parameter p-part-code          as character no-undo .
      272     define input  parameter p-mark-db-num        as integer   no-undo .
      273     define input  parameter p-mark-code          as integer   no-undo .
      274     define input  parameter p-alc-bottling-date  as date      no-undo .
      275     define input  parameter p-goods-alcohol-prod as logical   no-undo .
      276     define output parameter p-show-code          as character no-undo .
      277     define variable v-alc-mark-name as character no-undo .
      278     do
      279     on error undo, return error return-value
      280     :
      281       assign
      282         p-show-code = '':u
      283       .
      284       if p-goods-alcohol-prod = true
      285       then do:
      286         run alc-lib_mark-name in this-procedure
      287           (input  p-mark-db-num
      288           ,input  p-mark-code
      289           ,output v-alc-mark-name
      290           ) .
      291         assign
      292           p-show-code = substitute('&1,&2':u
      293                                   ,v-alc-mark-name
      294                                   ,string(p-alc-bottling-date,'99/99/9999':u)
      295                                   )
      296         .
      297       end.
      298       else do:
      299         assign
      300           p-show-code = p-part-code
      301         .
      302       end.
      303       return '':u .
      304     end.
      305   end procedure.
      306   FUNCTION get-parts-out-code RETURNS CHARACTER
      307     ( BUFFER buf_parts FOR ub.parts ) :
      308     case buf_parts.out-code :
      309       when 'free-zone':U then do:
      310         return "свободно" .
      311       end.
      312       when 'out-zone':U then do:
      313         return "расход" .
      314       end.
      315       otherwise do:
      316         if buf_parts.doc-type = 'акт':U then do:
      317           return caps("ЦН") + " № " + buf_parts.out-code .
      318         end.
      319         else do:
      320           define variable v-ext-name       as character no-undo .
      321           define variable v-trn-doc-status as character no-undo .
      322           define buffer buf_trn-doc for ub.trn-doc .
      323           find first buf_trn-doc no-lock
      324             where buf_trn-doc.doc-code = buf_parts.out-code
      325             no-error .
      326           if available buf_trn-doc then do:
      327   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      328   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run docextnm in g#library
      329     (input  buf_parts.out-code
      330     ,output v-ext-name
      331     )  .
      332             assign
      333               v-trn-doc-status = (if buf_trn-doc.status_ = 'факт':U then 'факт':U else "")
      334             .
      335           end.
      336           else do:
      337             assign
      338               v-ext-name       = caps(substring(buf_parts.doc-type, 1, 1))
      339               v-trn-doc-status = (if buf_parts.status_ = ? then 'факт':U else "")
      340             .
      341           end.
      342           return substitute("&1 № &2 &3"
      343              ,v-ext-name
      344              ,buf_parts.out-code
      345              ,v-trn-doc-status
      346              ) .
      347         end.
      348       end.
      349     end case .
      350     return "".
      351   END FUNCTION.
      352   FUNCTION get-parts-cli-qnty RETURNS DECIMAL
      353     ( BUFFER buf_parts FOR ub.parts
      354     , INPUT p-goods-twounit AS LOGICAL
      355     ) :
      356     if p-goods-twounit then do:
      357       RETURN buf_parts.cli-qnty .
      358     end.
      359     else do:
      360       RETURN buf_parts.fact-qnty / buf_parts.cli-base-rate .
      361     end.
      362     RETURN ? .
      363   END FUNCTION.
      364   FUNCTION get-parts-cli-base-rate RETURNS DECIMAL
      365     ( BUFFER buf_parts FOR ub.parts
      366     , INPUT p-goods-twounit AS LOGICAL
      367     ) :
      368     if p-goods-twounit then do:
      369       RETURN buf_parts.fact-qnty / buf_parts.cli-qnty .
      370     end.
      371     else do:
      372       RETURN buf_parts.cli-base-rate .
      373     end.
      374     RETURN ? .
      375   END FUNCTION.
      376   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define variable v-waitfram-action01         as character   no-undo .
      378   define variable v-waitfram-action02         as character   no-undo .
      379   define variable v-waitfram-action03         as character   no-undo .
      380   define variable mWaitFramTextBeg            as character   no-undo.
      381   define variable mWaitFramTextEnd            as character   no-undo.
      382   define variable mWaitFramView               as logical     no-undo.
      383   define variable mWaitProcEvent              as logical     no-undo init yes.
      384   define variable mWaitFramInterval           as integer     no-undo init 1 .
      385   define variable mWaitFramStop               as logical     no-undo.
      386   define variable mWaitFramStopUser           as logical     no-undo.
      387   define variable mWaitFramStopTimeOut        as logical     no-undo.
      388   define variable mWaitFramStartProc          as datetime-tz no-undo.
      389   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      390   define button B-WaitFramStop auto-end-key
      391        label "Стоп"
      392        size 10 by 1 tooltip "Остоновить процесс".
      393   define button B-viewProcInfo
      394        label "Информация"
      395        size 15 by 1 tooltip "Информация о процесс".
      396   define frame waitfram
      397     v-waitfram-action01 format "x(72)" no-label skip
      398     v-waitfram-action02 format "x(72)" no-label skip
      399     v-waitfram-action03 format "x(72)" no-label skip
      400     B-viewProcInfo
      401     B-WaitFramStop at row 4 col 30
      402     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      403     .
      404   define new global shared variable mBatchMode as logical no-undo init ?.
      405   define variable mFramBachModHandle as handle no-undo.
      406   mFramBachModHandle = frame waitfram:handle.
      407   define variable mFameOldVis as logical no-undo.
      408   define variable mVisCUrentVin as logical no-undo.
      409   if session:batch-mode
      410   then
      411      mBatchMode = yes.
      412   if mBatchMode = ? then do:
      413     mVisCUrentVin = current-window:visible.
      414     mFameOldVis = mFramBachModHandle:visible.
      415     mFramBachModHandle:visible  = yes.
      416     mBatchMode = mFramBachModHandle:visible ne yes.
      417     mFramBachModHandle:visible = mFameOldVis.
      418     current-window:visible = mVisCUrentVin.
      419   end.
      420    if  log-manager:logfile-name ne ?
      421     then DO:
      422         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      423         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      424         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      425     end.
      426   on choose of B-WaitFramStop in frame waitfram
      427   do:
      428     mWaitFramStop = yes.
      429     mWaitFramStopUser = yes.
      430   end.
      431   function waitfram-check-timeout returns logical():
      432      define variable vtime as int64 no-undo.
      433      if mWaitFramStopTimeOut
      434      then
      435         return yes.
      436      vtime = ( now - mWaitFramStartProc ) / 1000 .
      437      if     mWaitFramTimeOut ne ?
      438         and mWaitFramTimeOut ne 0
      439         and mWaitFramTimeOut lt vtime
      440      then do:
      441         mWaitFramStopTimeOut = yes.
      442      end.
      443      return mWaitFramStopTimeOut.
      444   end.
      445   procedure waitfram-hide :
      446     if not session:batch-mode
      447     then do
      448     on error undo, return error return-value
      449     :
      450       pause 0 before-hide .
      451       if not mBatchMode then
      452         hide frame waitfram .
      453     if     not mWaitFramView
      454        and mWaitProcEvent
      455     then
      456       process events .
      457     end.
      458   end procedure.
      459   procedure waitfram-show :
      460     define input  parameter p-message as character no-undo .
      461     define variable v-left-margin as integer   no-undo .
      462     if not session:batch-mode
      463     then do
      464     on error undo, return error return-value
      465     :
      466       if length(p-message) <= 70 then do:
      467         assign
      468           v-left-margin = integer((70 - length(p-message)) / 2)
      469         .
      470         assign
      471           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      472         .
      473         assign
      474           v-waitfram-action01 = " "
      475           v-waitfram-action02 = " "
      476                                    + fill(" ", v-left-margin)
      477                                    + p-message
      478           v-waitfram-action03 = " "
      479         .
      480       end.
      481       else do:
      482         define variable vRindex1 as integer no-undo.
      483         define variable vRindex2 as integer no-undo.
      484         vRindex1 = r-index(p-message," ",70).
      485         if vRindex1 = 0
      486         then
      487            vRindex1 = 70.
      488         if length(p-message)  <= vRindex1 + 70 then do:
      489           assign
      490             v-waitfram-action01 = " "
      491             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      492             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      493           .
      494         end.
      495         else do:
      496           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      497           if vRindex2 <= vRindex1
      498           then
      499              vRindex2 = vRindex1 + 70.
      500           assign
      501             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      502             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      503             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      504           .
      505         end.
      506       end.
      507       B-viewProcInfo:visible   in frame waitfram = no.
      508       B-viewProcInfo:sensitive in frame waitfram = no.
      509       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      510       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      511       if  (   mWaitFramView
      512          or  mWaitProcEvent)
      513          and not mBatchMode
      514       then
      515          display
      516             v-waitfram-action01 skip
      517             v-waitfram-action02 skip
      518             v-waitfram-action03 skip
      519          with frame waitfram .
      520       if     mWaitFramView
      521          then do:
      522             if     mWaitFramInterval ne ?
      523                and not mBatchMode
      524             then
      525                wait-for go of frame waitfram pause mWaitFramInterval.
      526          end.
      527          else
      528             if     mWaitProcEvent
      529                and not mBatchMode
      530             then
      531                process events .
      532     end.
      533   end procedure.
      534      procedure waitfram-show-this:
      535         define input  parameter iInterval as int64 no-undo.
      536         define variable vtime as int64 no-undo.
      537         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      538         mWaitFramInterval = iInterval.
      539         run waitfram-show (substitute("&1&2 &3&4" ,
      540                                       mWaitFramTextBeg ,
      541                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      542                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      543                                       mWaitFramTextEnd
      544                                      )
      545                           ).
      546      end.
      547      procedure WaitFramRunPause:
      548         define input  parameter iInterval as dec no-undo.
      549         define variable vStart  as datetime-tz no-undo.
      550         define variable vend    as datetime-tz no-undo.
      551         define variable vint as int64 no-undo.
      552         define variable vOk as logical no-undo.
      553         vStart = now.
      554         vend   = vStart.
      555         publish "WaitFramPause" (iInterval,output vOk).
      556         vend   =  now.
      557         vint = vend - vStart.
      558         vint = iInterval - vint / 1000.
      559         if     not mWaitFramStop
      560            and (   vint > 0
      561                 or (    not vOk
      562                     and iInterval eq ?
      563                     )
      564                 )
      565         then
      566            run waitfram-show-this (iInterval).
      567         vend   =  now.
      568         vint = vend - vStart.
      569         vint = iInterval - vint / 1000.
      570         if     not mWaitFramStop
      571            and vint > 0
      572         then do:
      573            run gbl/pause.p (vint * 1000).
      574         end.
      575         if iInterval ne ?
      576         then
      577            publish "WaitFramStop".
      578         waitfram-check-timeout().
      579      end.
      580      procedure WaitFramWaitFor:
      581         define input  parameter iInterval as dec no-undo.
      582         assign
      583            mWaitFramStartProc   = now
      584            mWaitFramStopUser    = no
      585            mWaitFramStopTimeOut = no
      586         .
      587         block-wait:
      588         do while not mWaitFramStop:
      589            run WaitFramRunPause (iInterval).
      590            if  waitfram-check-timeout()
      591            then do:
      592               leave block-wait.
      593            end.
      594         end.
      595         run waitfram-hide.
      596      end.
      597   procedure waitfram-join :
      598     define input  parameter p-line-1  as character no-undo .
      599     define input  parameter p-line-2  as character no-undo .
      600     define input  parameter p-line-3  as character no-undo .
      601     define output parameter p-message as character no-undo .
      602     do
      603     on error undo, return error return-value
      604     :
      605       assign
      606         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      607                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      608                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      609       .
      610     end.
      611   end procedure.
      612   function waitfram-join-function returns character
      613     (input p-line-1 as character
      614     ,input p-line-2 as character
      615     ,input p-line-3 as character
      616     ).
      617     define variable v-message as character no-undo .
      618     run waitfram-join in this-procedure
      619       (input  p-line-1
      620       ,input  p-line-2
      621       ,input  p-line-3
      622       ,output v-message
      623       ) .
      624     return v-message .
      625   end function .
      626   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      627   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      628   procedure fltopend_fltopend :
      629   define input parameter p-parent-handle as handle no-undo .
      630   define input parameter p-qh as handle no-undo .
      631   define input parameter p-flt-open-open-query  as character no-undo .
      632   define input parameter p-where-cond as character no-undo .
      633   define input parameter p-use-indFIRST-query-tail as character no-undo .
      634   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      635   define input parameter p-indexed-reposition as character no-undo .
      636     do
      637     on error undo, return error
      638     :
      639   define variable v-prepare-string as character no-undo .
      640   define variable glog as logical no-undo .
      641   assign
      642   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      643                      p-where-cond + chr(32)  +
      644                      p-use-indFIRST-query-tail + chr(32) +
      645                      p-use-ind-sort-clmn-by + chr(32) +
      646                      p-indexed-reposition
      647   .
      648   assign
      649   glog = p-qh:query-prepare(v-prepare-string) no-error .
      650   if not glog
      651   or error-status:error then do:
      652     message error-status:get-message(1) view-as alert-box .
      653     undo, return error .
      654   end.
      655   assign
      656   glog = p-qh:query-open no-error .
      657   if not glog
      658   or error-status:error then do:
      659     message error-status:get-message(1) view-as alert-box .
      660     undo, return error .
      661   end.
      662     end.
      663   end procedure.
      664   procedure fltopend_fltfindd :
      665   define input parameter p-parent-handle as handle no-undo .
      666   define input parameter p-qh as handle no-undo .
      667   define input parameter p-rowid as rowid no-undo .
      668   define input parameter p-next as logical no-undo .
      669   define input parameter p-lock as integer no-undo .
      670   define input parameter p-bh as handle no-undo .
      671   define input parameter p-where-cond as character no-undo .
      672   define input parameter p-use-index-phrase as character no-undo .
      673   define variable glog as logical no-undo .
      674   define variable v-qh as handle no-undo .
      675   define variable v-bh as handle no-undo .
      676   define variable v-recid as recid no-undo .
      677   define variable v-prepare-string as character no-undo .
      678   do
      679   on error undo, return error
      680   on stop undo, return error
      681   :
      682     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      683     create buffer v-bh for table p-bh buffer-name p-bh:name.
      684     create query v-qh.
      685     v-qh:set-buffers(v-bh).
      686     v-prepare-string = substitute("for each &1 &2 &3"
      687                                     ,v-bh:name
      688                                     ,p-where-cond
      689                                     ,p-use-index-phrase).
      690     glog = v-qh:query-prepare(v-prepare-string) no-error.
      691     if not glog then do:
      692       delete object v-qh.
      693       delete object v-bh.
      694       undo, return error .
      695     end.
      696     glog = v-qh:query-open no-error .
      697     if not glog then do:
      698       delete object v-qh.
      699       delete object v-bh.
      700       undo, return error .
      701     end.
      702     if p-next then do:
      703       v-qh:reposition-to-rowid(p-rowid) no-error .
      704       glog = v-qh:get-next( p-lock) no-error .
      705       glog = v-qh:get-next( p-lock) no-error .
      706       if not glog or v-qh:query-off-end = yes then do:
      707         glog = v-qh:get-first( p-lock) no-error .
      708       end.
      709     end.
      710     else do:
      711       glog = v-qh:get-first( p-lock) no-error .
      712     end.
      713     v-recid = v-bh:recid no-error .
      714     delete object v-qh.
      715     delete object v-bh.
      716     return string(v-recid) .
      717   end.
      718   end procedure.
      719   procedure fltopend_fltfindq :
      720   define input parameter p-parent-handle as handle no-undo .
      721   define input parameter p-qh as handle no-undo .
      722   define input parameter p-next as logical no-undo .
      723   define input parameter p-lock as integer no-undo .
      724   define input parameter p-flt-open-open-query  as character no-undo .
      725   define input parameter p-where-cond as character no-undo .
      726   define input parameter p-use-indFIRST-query-tail as character no-undo .
      727   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      728   define input parameter p-indexed-reposition as character no-undo .
      729   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      730   define variable glog as logical no-undo .
      731   define variable v-qh as handle no-undo .
      732   define variable v-bh as handle no-undo extent 18.
      733   define variable v-rowid as rowid no-undo extent 18.
      734   define variable v-ii as integer no-undo .
      735   define variable v-prepare-string as character no-undo .
      736   do
      737   on error undo, return error
      738   on stop undo, return error
      739   :
      740     create query v-qh.
      741     do v-ii = 1 to p-qh:num-buffers:
      742       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      743       assign
      744       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      745       no-error.
      746       v-qh:add-buffer(v-bh[v-ii]).
      747     end.
      748     assign
      749     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      750                       p-where-cond + chr(32)  +
      751                       p-use-indFIRST-query-tail + chr(32) +
      752                       p-use-ind-sort-clmn-by + chr(32) +
      753                       p-indexed-reposition
      754     .
      755     glog = v-qh:query-prepare( v-prepare-string) no-error .
      756     if not glog then do:
      757       delete object v-qh.
      758       do v-ii = 1 to p-qh:num-buffers:
      759         delete object v-bh[v-ii].
      760       end.
      761       undo, return error .
      762     end.
      763     glog = v-qh:query-open no-error .
      764     if not glog then do:
      765       delete object v-qh.
      766       do v-ii = 1 to p-qh:num-buffers:
      767         delete object v-bh[v-ii].
      768       end.
      769       undo, return error .
      770     end.
      771     if p-next then do:
      772       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      773       glog = v-qh:get-next( p-lock) no-error .
      774       glog = v-qh:get-next( p-lock) no-error .
      775       if not glog or v-qh:query-off-end = yes then do:
      776         glog = v-qh:get-first( p-lock) no-error .
      777       end.
      778     end.
      779     else do:
      780       glog = v-qh:get-first( p-lock) no-error .
      781     end.
      782     do v-ii = 1 to p-qh:num-buffers:
      783       assign
      784       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      785       no-error.
      786     end.
      787     delete object v-qh.
      788     do v-ii = 1 to p-qh:num-buffers:
      789       delete object v-bh[v-ii].
      790     end.
      791   end.
      792   end procedure.
      793   define variable filter-point as character no-undo init "supp-gds" .
      794   define variable filter-point0 as character no-undo init "supp-gds" .
      795   define variable filter-label0 as character no-undo init "Поставщик-партии-остатки" .
      796   define variable filter-label as character no-undo init "Поставщик-партии-остатки" .
      797   define variable sort-column-name as character no-undo .
      798   define new shared buffer s-parts for ub.parts.
      799   define new shared buffer s-goods for ub.goods.
      800   define variable conf-par as char             no-undo.
      801   define variable par-type as char             no-undo.
      802   define variable v-doc-rec as recid no-undo .
      803   define variable v-prt-rec as recid no-undo .
      804   define variable p-curr-host-code like ub.sysconf.host-code no-undo .
      805   define buffer supp_clients for ub.clients.
      806   define buffer supp_currency for ub.currency.
      807   define buffer buf_bar-code for ub.bar-code .
      808   define buffer supp_pay-type for ub.pay-type.
      809   def BUTTON b-doc
      810        LABEL "Д&окум"
      811        size 10 BY 1.
      812   def BUTTON b-exit AUTO-GO
      813        LABEL "&Выход "
      814        size 10 BY 1.
      815   def BUTTON b-sch
      816        LABEL "&Фильтр"
      817        size 10 BY 1.
      818   def BUTTON b-gds
      819        LABEL "&Товар"
      820        size 10 BY 1.
      821   def BUTTON b-print
      822        LABEL "Пе&чать"
      823        size 10 BY 1.
      824   def BUTTON b-help
      825        LABEL "Помо&щь"
      826        size 10 BY 1.
      827   def BUTTON b-in
      828        LABEL "П&Н"
      829        size 10 BY 1.
      830   def BUTTON b-alt
      831        LABEL "Доп.&БК"
      832        size 10 BY 1.
      833   def BUTTON b-pl
      834        LABEL "&Место"
      835        size 10 BY 1.
      836   DEFINE VARIABLE rs-one-all AS CHARACTER
      837        VIEW-AS RADIO-SET HORIZONTAL
      838        RADIO-BUTTONS
      839             "Текущий объект", "current",
      840             "Все объекты фирмы",    "all"
      841        SIZE 40 BY .83
      842        FGCOLOR 4  NO-UNDO.
      843   DEFINE VARIABLE rs-parts AS CHARACTER
      844        VIEW-AS RADIO-SET HORIZONTAL
      845        RADIO-BUTTONS
      846            "Приходы",      "input",
      847            "Все партии",   "all",
      848            "Факт остатки", "stock",
      849            "Свободно",     "free"
      850        SIZE 55.5 BY .67
      851        FGCOLOR 4  NO-UNDO.
      852   DEFINE VARIABLE sh-code AS INTEGER FORMAT "999999999":U INITIAL 0
      853        LABEL "Поиск"
      854        VIEW-AS FILL-IN
      855        SIZE 10 BY .79 NO-UNDO.
      856   DEFINE VARIABLE fi-b-code AS INTEGER FORMAT "999999999":U INITIAL 0
      857        LABEL "Бар-код"
      858        VIEW-AS FILL-IN
      859        SIZE 10 BY .79
      860        FGCOLOR 4  NO-UNDO.
      861   def buffer p-b for ub.parts.
      862   define variable ed-notes AS CHARACTER
      863        VIEW-AS EDITOR
      864        SIZE 49.5 BY 2.5 NO-UNDO.
      865   DEF RECTANGLE rect-in EDGE-PIXELS 1 GRAPHIC-EDGE SIZE 77.5 BY 3.5  BGCOLOR 8.
      866   def new shared QUERY br-parts FOR s-parts, s-goods SCROLLING.
      867   define BROWSE br-parts QUERY br-parts NO-LOCK DISPLAY
      868         s-parts.artic     COLUMN-LABEL "Артикул"
      869         s-goods.gds-name  COLUMN-LABEL "Название"    FORMAT "x(30)"
      870         s-parts.fact-qnty COLUMN-LABEL "Факт"        FORMAT "->>>,>>9.<<<"
      871         s-parts.price-base
      872         (s-parts.price-base * s-parts.fact-qnty)
      873                           column-label "Сумма (вал)" format "->,>>>,>>>,>>9.99"
      874         s-parts.price-rubl
      875         (s-parts.price-rubl * s-parts.fact-qnty)
      876                           column-label "Сумма (руб)" format "->,>>>,>>>,>>9.99"
      877         get-parts-out-code (buffer s-parts)  COLUMN-LABEL 'статус':U     FORMAT "x(16)"
      878         (if s-parts.part-code = "" then
      879            "------"
      880          else
      881            s-parts.part-code)
      882                           COLUMN-LABEL "Партия"      FORMAT "x(14)"
      883         (s-parts.obj-type + " " + STRING (s-parts.obj-code))
      884                           COLUMN-LABEL "Объект"      FORMAT "x(13)"
      885       WITH SIZE 98 BY 9.5 SEPARATORS.
      886   def FRAME dialog-frame
      887        b-exit             AT ROW 1  COL 1
      888        b-gds              AT ROW 1  COL 19
      889        b-in               AT ROW 1  COL 29
      890        b-doc              AT ROW 1  COL 39
      891        b-sch              AT ROW 1  COL 49
      892        b-alt              AT ROW 1  COL 59
      893        b-pl               AT ROW 1  COL 69
      894        b-print            AT ROW 1  COL 79
      895        b-help             AT ROW 1  COL 89
      896        rs-parts           AT ROW 2  COL 1                  NO-LABEL
      897        rs-one-all         AT ROW 3 COL 11.5 NO-LABEL
      898        sh-code            AT ROW 4 COL 10 COLON-ALIGNED HELP   "Поиск по бар-коду"
      899        fi-b-code          AT ROW 4 COL 31 COLON-ALIGNED
      900        br-parts           AT ROW 5   COL 1.5
      901        rect-in            at row 15.2  col 1.5
      902        "  Информация из ПН" VIEW-AS TEXT SIZE 18 BY 0.7
      903                           AT ROW 14.5  COL 30
      904        s-parts.in-code    AT ROW 15.5  COL 8    COLON-ALIGNED LABEL "Номер"        VIEW-AS FILL-IN SIZE 15    BY 1 FGCOLOR 4
      905        s-parts.fact-date  AT ROW 15.5  COL 28   COLON-ALIGNED LABEL "Дата"         VIEW-AS FILL-IN SIZE 10    BY 1 FGCOLOR 4
      906        supp_clients.obj-name   AT ROW 15.5  COL 48   COLON-ALIGNED LABEL "Пост-к"       VIEW-AS FILL-IN SIZE 25    BY 1 FGCOLOR 4
      907        supp_pay-type.obj-name  AT ROW 16.5  COL 9   COLON-ALIGNED LABEL "Оплата"       VIEW-AS FILL-IN SIZE 29.25 BY 1 FGCOLOR 4
      908        s-parts.vat-type   AT ROW 16.5  COL 48   COLON-ALIGNED LABEL "НДС"          VIEW-AS FILL-IN SIZE 10    BY 1 FGCOLOR 4
      909        s-parts.vat-pc     AT ROW 16.5  COL 68   COLON-ALIGNED LABEL "% НДС"        VIEW-AS FILL-IN SIZE 8     BY 1 FGCOLOR 4
      910        s-parts.price-cli  AT ROW 17.5  COL 28   COLON-ALIGNED LABEL "Цена пост-ка" VIEW-AS FILL-IN SIZE 29.25 BY 1 FGCOLOR 4
      911        supp_currency.curr-abbr AT ROW 17.5  COL 48   COLON-ALIGNED no-LABEL             VIEW-AS FILL-IN SIZE 10    BY 1 FGCOLOR 4
      912        ed-notes           AT ROW 19    COL 29.5               no-label                                             bgcolor 8 fgcolor 4
      913        SPACE(0.49) SKIP(0.28)
      914       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      915            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      916            TITLE "Партии".
      917   ASSIGN
      918          FRAME dialog-frame:SCROLLABLE       = FALSE.
      919   on choose of b-print in frame dialog-frame do:
      920   apply "entry" to br-parts in frame dialog-frame.
      921   run rep/r-supgds.p (input parparentproc, input p-curr-obj-type, input p-curr-obj-code,  frame dialog-frame:title).
      922   end.
      923   ON entry OF ed-notes IN FRAME dialog-frame DO:
      924   if not available s-parts then do:
      925     message
      926       "Неправильный выбор партии."
      927       view-as alert-box.
      928     return no-apply.
      929   end.
      930   v-prt-rec = recid (s-parts).
      931   END.
      932   ON leave OF ed-notes IN FRAME dialog-frame DO:
      933   do on stop undo, return no-apply:
      934     find p-b where recid (p-b) = v-prt-rec exclusive.
      935     p-b.PS = input frame dialog-frame ed-notes.
      936   end.
      937   END.
      938   ON RETURN, MOUSE-SELECT-DBLCLICK OF ed-notes IN FRAME dialog-frame DO:
      939   apply "entry" to br-parts in frame dialog-frame.
      940   return no-apply.
      941   END.
      942   ON RETURN, MOUSE-SELECT-DBLCLICK OF br-parts IN FRAME dialog-frame DO:
      943   END.
      944   on value-changed of br-parts do:
      945   define buffer s-prt for ub.gds-prt.
      946     if available s-parts then do:
      947       v-doc-rec = recid(s-parts).
      948       find first s-prt no-lock where
      949                  s-prt.upper-code = s-goods.prt-root.
      950       find  first buf_bar-code no-lock where
      951             buf_bar-code.gds-code  = s-goods.gds-code
      952         and buf_bar-code.node-code = s-prt.node-code
      953        and buf_bar-code.in-code   = s-parts.in-code
      954        and buf_bar-code.part-code = s-parts.part-code
      955        and buf_bar-code.unit-cli  = s-goods.unit-base no-error.
      956       if available buf_bar-code then do:
      957         fi-b-code = buf_bar-code.b-code.
      958         display
      959         fi-b-code with frame dialog-frame.
      960       end.
      961       else
      962         display
      963         ? @ fi-b-code with frame dialog-frame.
      964       find first supp_pay-type no-lock where
      965            supp_pay-type.obj-code = s-parts.pay-code no-error.
      966       if available supp_pay-type then
      967         display
      968         supp_pay-type.obj-name
      969         with frame dialog-frame.
      970       else
      971         display
      972         ? @ supp_pay-type.obj-name with frame dialog-frame.
      973       find first supp_currency no-lock where
      974            supp_currency.curr-code = s-parts.exch-code no-error.
      975       if available supp_currency then do:
      976         display
      977         supp_currency.curr-abbr with frame dialog-frame.
      978       end.
      979       else do:
      980         display
      981         ? @ supp_currency.curr-abbr
      982         with frame dialog-frame.
      983       end.
      984       ed-notes = s-parts.PS.
      985       display
      986       s-parts.vat-pc
      987       s-parts.vat-type
      988       s-parts.price-cli
      989       s-parts.in-code
      990       s-parts.fact-date
      991       supp_clients.obj-name
      992       ed-notes with frame dialog-frame.
      993     end.
      994     else do:
      995       V-DOC-REC = ?.
      996     END.
      997   end.
      998   ON CTRL-J OF sh-code IN FRAME Dialog-Frame
      999   DO:
     1000     run proc-find-sh-code in this-procedure(yes, input frame dialog-frame sh-code) no-error.
     1001     if error-status:error then return no-apply.
     1002   END.
     1003   ON RETURN OF sh-code IN FRAME Dialog-Frame
     1004   DO:
     1005     run proc-find-sh-code in this-procedure(no, input frame dialog-frame sh-code) no-error.
     1006     if error-status:error then return no-apply.
     1007   END.
     1008   ON VALUE-CHANGED OF rs-parts IN FRAME dialog-frame
     1009   DO:
     1010   define variable v-prt-rec as recid no-undo .
     1011   if available s-parts then v-prt-rec = recid (s-parts).
     1012   assign rs-parts.
     1013   run OpenBr in this-procedure ( input yes, input no, input '':U).
     1014   apply "entry" to br-parts.
     1015   reposition br-parts to recid v-prt-rec no-error.
     1016   return no-apply.
     1017   END.
     1018   ON VALUE-CHANGED OF rs-one-all IN FRAME dialog-frame
     1019   DO:
     1020   define variable v-prt-rec as recid no-undo .
     1021   if available s-parts then v-prt-rec = recid (s-parts).
     1022   assign rs-one-all.
     1023   run OpenBr in this-procedure ( input yes, input no, input '':U).
     1024   apply "entry" to br-parts.
     1025   reposition br-parts to recid v-prt-rec no-error.
     1026   return no-apply.
     1027   END.
     1028   on choose of b-sch in frame dialog-frame do:
     1029     run proc-b-sch in this-procedure no-error.
     1030     if error-status:error then return no-apply.
     1031   end.
     1032   on choose of b-gds in frame dialog-frame do:
     1033   if not available s-parts then do:
     1034     message "Неправильный выбор партии.".
     1035     return no-apply.
     1036   end.
     1037   find s-goods where s-goods.artic = s-parts.artic
     1038                         and s-goods.prod-type = s-parts.prod-type
     1039                         and s-goods.prod-code = s-parts.prod-code no-lock.
     1040   run str/showgds.p ( input parparentproc
     1041                      ,input ?
     1042                      ,input s-goods.gds-code
     1043                      ,input 'ПРОСМОТР':U).
     1044   apply "entry" to br-parts in frame dialog-frame.
     1045   end.
     1046   on choose of b-doc in frame dialog-frame do:
     1047   if not available s-parts then do:
     1048     message "Неправильный выбор партии.".
     1049     return no-apply.
     1050   end.
     1051   find ub.trn-doc where ub.trn-doc.doc-code = s-parts.out-code no-lock no-error.
     1052   if not available trn-doc then do:
     1053     message "Документ не найден.".
     1054     return no-apply.
     1055   end.
     1056   find ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code
     1057                           and ub.doc-line.artic = s-parts.artic
     1058                           and ub.doc-line.prod-type = s-parts.prod-type
     1059                           and ub.doc-line.prod-code = s-parts.prod-code no-lock.
     1060   run str/trn-lkp.p (parparentproc, recid (ub.trn-doc), recid(ub.doc-line)).
     1061   apply "entry" to br-parts in frame dialog-frame.
     1062   end.
     1063   on choose of b-in in frame dialog-frame do:
     1064   if not available s-parts then do:
     1065     message "Неправильный выбор партии.".
     1066     return no-apply.
     1067   end.
     1068   find ub.trn-doc where ub.trn-doc.doc-code = s-parts.in-code no-lock no-error.
     1069   if not available ub.trn-doc then do:
     1070     message "Документ не найден.".
     1071     return no-apply.
     1072   end.
     1073   find ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code
     1074                           and ub.doc-line.artic = s-parts.artic
     1075                           and ub.doc-line.prod-type = s-parts.prod-type
     1076                           and ub.doc-line.prod-code = s-parts.prod-code no-lock.
     1077   run str/trn-lkp.p (parparentproc, recid (ub.trn-doc), recid(ub.doc-line)).
     1078   apply "entry" to br-parts in frame dialog-frame.
     1079   end.
     1080   ON CHOOSE OF b-alt IN FRAME dialog-frame  DO:
     1081   def buffer s-code for ub.bar-code.
     1082   def buffer s-prt  for ub.gds-prt.
     1083   if not available s-parts then do:
     1084     message "Неправильный выбор партии.".
     1085     return no-apply.
     1086   end.
     1087   find s-goods no-lock where
     1088        s-goods.artic = s-parts.artic and
     1089        s-goods.prod-type = s-parts.prod-type and
     1090        s-goods.prod-code = s-parts.prod-code.
     1091   find first s-prt no-lock where
     1092              s-prt.upper-code = s-goods.prt-root.
     1093   find s-code no-lock where
     1094        s-code.gds-code  = s-goods.gds-code and
     1095        s-code.node-code = s-prt.node-code and
     1096        s-code.in-code   = s-parts.in-code and
     1097        s-code.part-code = s-parts.part-code and
     1098        s-code.unit-cli  = s-goods.unit-base no-error.
     1099   if available s-code then
     1100     run ref/alt-bc.w (parparentproc, p-curr-obj-type, p-curr-obj-code, s-code.b-code).
     1101   END.
     1102   ON CHOOSE OF b-pl IN FRAME dialog-frame  DO:
     1103   if not available s-parts then do:
     1104     message "Неправильный выбор партии.".
     1105     return no-apply.
     1106   end.
     1107   run str/pl-lkp.w
     1108     (
     1109       input parparentproc
     1110      ,input recid(s-parts)
     1111     ).
     1112   END.
     1113   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME dialog-frame:PARENT eq ?
     1114   THEN FRAME dialog-frame:PARENT = ACTIVE-WINDOW.
     1115   ON WINDOW-CLOSE OF FRAME dialog-frame APPLY "END-ERROR":U TO SELF.
     1116   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   on help of frame dialog-frame
     1118   do:
     1119     run gbl/app_help.p
     1120       (input this-procedure :file-name
     1121       ,input ''
     1122       ,input ?
     1123       ) no-error.
     1124     if error-status :error then do:
     1125       message
     1126         "Ошибка при вызове помощи"
     1127         error-status :get-message(1)
     1128         view-as alert-box .
     1129     end.
     1130   end.
     1131   run minbtn-set in this-procedure .
     1132   on choose of b-help in frame dialog-frame
     1133   do:
     1134     apply "help":u to frame dialog-frame .
     1135   end.
     1136   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1137   procedure minbtn-set :
     1138       do
     1139           on error undo, return error return-value
     1140           :
     1141           define variable ii              as integer       no-undo .
     1142           define variable fh              as widget-handle no-undo .
     1143           define variable hh              as widget-handle no-undo .
     1144           define variable v-h             as handle        extent 4 no-undo .
     1145           define variable v-name-button   as character     no-undo .
     1146           define variable v-help-old-x    as decimal       no-undo .
     1147           define variable v-help-old-y    as decimal       no-undo .
     1148           define variable v-help-old-size as decimal       no-undo .
     1149           define variable v-frame-width   as decimal       no-undo .
     1150           define variable jj              as integer       no-undo .
     1151           do
     1152               on error undo, return error
     1153               :
     1154               assign
     1155                   v-frame-width = frame dialog-frame:width - 0.3
     1156                   fh            = frame dialog-frame:first-child
     1157                   hh            = fh:first-child
     1158                   ii            = 1
     1159                   .
     1160               do while valid-handle(hh):
     1161                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1162                   do:
     1163                       case lc(hh:name) :
     1164                           when "b-help" then
     1165                               do:
     1166                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1167                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1168                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1169                                   hh:TOOLTIP = "Помощь" .
     1170                                   v-help-old-x = hh:column .
     1171                                   v-help-old-y = hh:row    .
     1172                                   v-help-old-size = hh:width .
     1173                                   hh:width-chars = 2.5 .
     1174                               end.
     1175                           when "b-print" then
     1176                               do:
     1177                                   hh:load-image("cmp/b-print.bmp":u) .
     1178                                   hh:TOOLTIP = "Печать" .
     1179                                   v-h[ii] = hh:handle .
     1180                                   ii = ii + 1 .
     1181                                   hh:width-chars = 3 .
     1182                               end.
     1183                           when "b-history" or
     1184                           when "b-hist" then
     1185                               do:
     1186                                   hh:load-image("cmp/b-hist.bmp":u) .
     1187                                   hh:TOOLTIP = "История" .
     1188                                   v-h[ii] = hh:handle .
     1189                                   ii = ii + 1 .
     1190                                   hh:width-chars = 3 .
     1191                               end.
     1192                           when "b-sch" then
     1193                               do:
     1194                                   hh:load-image("cmp/b-sch.bmp":u) .
     1195                                   hh:TOOLTIP = "Установка Фильтра" .
     1196                                   v-h[ii] = hh:handle .
     1197                                   ii = ii + 1 .
     1198                                   hh:width-chars = 3 .
     1199                               end.
     1200                           when "b-hist-user" then
     1201                               do:
     1202                                   hh:load-image("cmp/b-hist.bmp":u) .
     1203                                   hh:TOOLTIP = "История пользователя" .
     1204                                   ii = ii + 1 .
     1205                               end.
     1206                       end case.
     1207                   end.
     1208                   hh = hh:next-sibling.
     1209               end.
     1210               b-help:column = v-frame-width - b-help:width-chars.
     1211               jj = 0.
     1212               repeat ii = 4 to 1 by -1 :
     1213                   if valid-handle (v-h[ii] ) then
     1214                   do:
     1215                       jj  = jj + 1 .
     1216                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1217                       v-h[ii]:row    = v-help-old-y .
     1218                   end.
     1219               end.
     1220           end.
     1221       end.
     1222   end procedure.
     1223   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1224   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1225   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1226   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1227   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1228   define variable v-diasize-current-frame-height as decimal   no-undo .
     1229   define variable v-diasize-change-size          as logical   no-undo .
     1230   define variable v-diasize-resize-button        as handle    no-undo .
     1231   define variable v-diasize-wndmax               as logical   no-undo .
     1232   define variable v-diasize-wndstore             as logical   no-undo .
     1233   define variable v-diasize-proc-name            as character no-undo .
     1234   define variable v-diasize-browse-handle        as handle    no-undo .
     1235   define variable v-diasize-browse-number        as integer   no-undo .
     1236   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1237   define temp-table temp-diasize-handle no-undo
     1238     field handle-value  as handle
     1239     field save-position as decimal
     1240     index xpk is primary unique handle-value
     1241     .
     1242   define temp-table temp-browse-handle no-undo
     1243     field browse-type   as character
     1244     field browse-number as integer
     1245     field browse-handle as handle
     1246     field original-size as decimal
     1247     index xpk is primary unique browse-type browse-number
     1248     index xie browse-type browse-handle
     1249   .
     1250   procedure diasize_change-height :
     1251     define input  parameter p-change-value  as decimal   no-undo .
     1252     define input  parameter p-move-resize   as logical   no-undo .
     1253     define variable v-field-group-handle    as handle    no-undo .
     1254     define variable v-object-handle         as handle    no-undo .
     1255     define variable v-frame-height          as decimal   no-undo .
     1256     define variable v-frame-virtual-height  as decimal   no-undo .
     1257     define variable v-browse-height         as decimal   no-undo .
     1258     define variable v-window-height         as decimal   no-undo .
     1259     define variable v-window-virtual-height as decimal   no-undo .
     1260     define variable v-change-sign           as integer   no-undo .
     1261     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1262     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1263     if p-change-value > 0
     1264     then do:
     1265       if frame dialog-frame :height + p-change-value
     1266           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1267       then do:
     1268         assign
     1269           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1270                           - (frame dialog-frame :height-chars)
     1271         .
     1272         if p-change-value <= 0
     1273         then do:
     1274           run diasize_position-resize-button in this-procedure .
     1275           return .
     1276         end.
     1277       end.
     1278     end.
     1279     if p-change-value < 0
     1280     then do:
     1281       if frame dialog-frame :height + p-change-value < v-diasize-orig-frame-height
     1282       then do:
     1283         assign
     1284           p-change-value = v-diasize-orig-frame-height
     1285                          - (frame dialog-frame :height-chars)
     1286         .
     1287         if p-change-value >= 0
     1288         then do:
     1289           run diasize_position-resize-button in this-procedure .
     1290           return .
     1291         end.
     1292       end.
     1293     end.
     1294     if p-change-value >= 0
     1295     then do:
     1296       assign
     1297         v-change-sign = 1
     1298       .
     1299     end.
     1300     else do:
     1301       assign
     1302         v-change-sign = -1
     1303       .
     1304     end.
     1305     assign
     1306       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1307     .
     1308     if p-change-value = 0
     1309     then do:
     1310       run diasize_position-resize-button in this-procedure .
     1311       return .
     1312     end.
     1313     move_block:
     1314     do
     1315     on error undo move_block, retry move_block
     1316     :
     1317       if retry
     1318       then do:
     1319         do
     1320         on error undo move_block, leave move_block
     1321         :
     1322           if p-change-value > 0
     1323           then do:
     1324             for each buf_temp-diasize-handle
     1325             on error undo, next
     1326             :
     1327               assign
     1328                 v-object-handle = buf_temp-diasize-handle.handle-value
     1329               .
     1330               if v-object-handle <> v-diasize-resize-button
     1331               then do:
     1332                 assign
     1333                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1334                 .
     1335               end.
     1336             end.
     1337             assign
     1338               v-diasize-browse-handle :height = v-browse-height
     1339             .
     1340             for each buf_temp-browse-handle
     1341               where buf_temp-browse-handle.browse-type = 'height':u
     1342             on error undo, next
     1343             :
     1344               assign
     1345                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1346               .
     1347             end.
     1348             assign
     1349               frame dialog-frame :height = v-frame-height
     1350             .
     1351             if frame dialog-frame :scrollable = true
     1352             then do:
     1353               assign
     1354                 frame dialog-frame :virtual-height = v-frame-virtual-height
     1355               .
     1356             end.
     1357             run diasize_position-resize-button in this-procedure .
     1358           end.
     1359           else do:
     1360             if frame dialog-frame :scrollable = true
     1361             then do:
     1362               assign
     1363                 frame dialog-frame :virtual-height = v-frame-virtual-height
     1364               .
     1365             end.
     1366             assign
     1367               frame dialog-frame :height = v-frame-height
     1368             .
     1369             assign
     1370               v-diasize-browse-handle :height = v-browse-height
     1371             .
     1372             for each buf_temp-browse-handle
     1373               where buf_temp-browse-handle.browse-type = 'height':u
     1374             on error undo, next
     1375             :
     1376               assign
     1377                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1378               .
     1379             end.
     1380             for each buf_temp-diasize-handle
     1381             on error undo, next
     1382             :
     1383               assign
     1384                 v-object-handle = buf_temp-diasize-handle.handle-value
     1385               .
     1386               if v-object-handle <> v-diasize-resize-button
     1387               then do:
     1388                 assign
     1389                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1390                 .
     1391               end.
     1392             end.
     1393             run diasize_position-resize-button in this-procedure .
     1394           end.
     1395           assign
     1396             v-diasize-change-size = false
     1397           .
     1398           leave move_block .
     1399         end.
     1400       end.
     1401       assign
     1402         v-diasize-need-full-display = true
     1403       .
     1404       if v-diasize-change-size = false
     1405       then do:
     1406         assign
     1407           v-diasize-change-size = true
     1408         .
     1409       end.
     1410       else do:
     1411         return .
     1412       end.
     1413       assign
     1414         v-frame-height = frame dialog-frame :height
     1415         v-frame-virtual-height = frame dialog-frame :virtual-height
     1416         v-browse-height = v-diasize-browse-handle :height
     1417       .
     1418       for each buf_temp-browse-handle
     1419         where buf_temp-browse-handle.browse-type = 'height':u
     1420       :
     1421         assign
     1422           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1423         .
     1424       end.
     1425       for each buf_temp-diasize-handle
     1426       :
     1427         delete buf_temp-diasize-handle .
     1428       end.
     1429       assign
     1430         v-field-group-handle = frame dialog-frame :first-child
     1431       .
     1432       do while valid-handle(v-field-group-handle)
     1433       :
     1434         assign
     1435           v-object-handle = v-field-group-handle :first-child
     1436         .
     1437         do while valid-handle(v-object-handle)
     1438         :
     1439           if  v-object-handle <> v-diasize-browse-handle :handle
     1440           and can-query(v-object-handle, "row")
     1441           and can-query(v-object-handle, "height")
     1442           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1443           then do:
     1444             find first buf_temp-browse-handle
     1445               where buf_temp-browse-handle.browse-type   = 'height':u
     1446                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1447               no-error .
     1448             if available buf_temp-browse-handle
     1449             then do:
     1450             end.
     1451             else do:
     1452               create buf_temp-diasize-handle .
     1453               assign
     1454                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1455                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1456               .
     1457             end.
     1458           end.
     1459           assign
     1460             v-object-handle = v-object-handle :next-sibling
     1461           .
     1462         end.
     1463         assign
     1464           v-field-group-handle = v-field-group-handle :next-sibling
     1465         .
     1466       end.
     1467       do with frame dialog-frame
     1468       :
     1469         hide v-diasize-resize-button .
     1470         assign
     1471           v-diasize-resize-button :row    = 1
     1472           v-diasize-resize-button :column = 1
     1473         .
     1474       end.
     1475       if p-change-value > 0
     1476       then do:
     1477         if frame dialog-frame :scrollable = true
     1478         then do:
     1479           assign
     1480             frame dialog-frame :virtual-height = frame dialog-frame :virtual-height + p-change-value
     1481             no-error .
     1482           if error-status :error
     1483           or error-status :get-message(1) <> ""
     1484           then do:
     1485             undo move_block, retry move_block .
     1486           end.
     1487         end.
     1488         assign
     1489           frame dialog-frame :height = frame dialog-frame :height + p-change-value
     1490           no-error .
     1491         if error-status :error
     1492         or error-status :get-message(1) <> ""
     1493         then do:
     1494           undo move_block, retry move_block .
     1495         end.
     1496         assign
     1497           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1498           no-error .
     1499         if error-status :error
     1500         or error-status :get-message(1) <> ""
     1501         then do:
     1502           undo move_block, retry move_block .
     1503         end.
     1504         for each buf_temp-browse-handle
     1505           where buf_temp-browse-handle.browse-type = 'height':u
     1506         on error undo move_block, retry move_block
     1507         :
     1508           assign
     1509             buf_temp-browse-handle.browse-handle :height
     1510               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1511             no-error .
     1512           if error-status :error
     1513           or error-status :get-message(1) <> ""
     1514           then do:
     1515             undo move_block, retry move_block .
     1516           end.
     1517         end.
     1518         for each buf_temp-diasize-handle
     1519         on error undo move_block, retry move_block
     1520         :
     1521           assign
     1522             v-object-handle = buf_temp-diasize-handle.handle-value
     1523           .
     1524           if v-object-handle <> v-diasize-resize-button
     1525           then do:
     1526             assign
     1527               v-object-handle :row = v-object-handle :row + p-change-value
     1528               no-error .
     1529             if error-status :error
     1530             or error-status :get-message(1) <> ""
     1531             then do:
     1532               undo move_block, retry move_block .
     1533             end.
     1534           end.
     1535         end.
     1536       end.
     1537       else do:
     1538         for each buf_temp-diasize-handle
     1539         on error undo move_block, retry move_block
     1540         :
     1541           assign
     1542             v-object-handle = buf_temp-diasize-handle.handle-value
     1543           .
     1544           if v-object-handle <> v-diasize-resize-button
     1545           then do:
     1546             assign
     1547               v-object-handle :row = v-object-handle :row + p-change-value
     1548               no-error .
     1549             if error-status :error
     1550             or error-status :get-message(1) <> ""
     1551             then do:
     1552               undo move_block, retry move_block .
     1553             end.
     1554           end.
     1555         end.
     1556         assign
     1557           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1558           no-error .
     1559         if error-status :error
     1560         or error-status :get-message(1) <> ""
     1561         then do:
     1562           undo move_block, retry move_block .
     1563         end.
     1564         for each buf_temp-browse-handle
     1565           where buf_temp-browse-handle.browse-type = 'height':u
     1566         on error undo move_block, retry move_block
     1567         :
     1568           assign
     1569             buf_temp-browse-handle.browse-handle :height
     1570               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1571             no-error .
     1572           if error-status :error
     1573           or error-status :get-message(1) <> ""
     1574           then do:
     1575             undo move_block, retry move_block .
     1576           end.
     1577         end.
     1578         assign
     1579           frame dialog-frame :height = frame dialog-frame :height + p-change-value
     1580           no-error .
     1581         if error-status :error
     1582         or error-status :get-message(1) <> ""
     1583         then do:
     1584           undo move_block, retry move_block .
     1585         end.
     1586         if frame dialog-frame :scrollable = true
     1587         then do:
     1588           assign
     1589             frame dialog-frame :virtual-height = frame dialog-frame :virtual-height + p-change-value
     1590             no-error .
     1591           if error-status :error
     1592           or error-status :get-message(1) <> ""
     1593           then do:
     1594             undo move_block, retry move_block .
     1595           end.
     1596         end.
     1597       end.
     1598       if p-move-resize = true
     1599       then do:
     1600         run diasize_position-resize-button in this-procedure .
     1601       end.
     1602       if v-diasize-wndstore = true
     1603       then do:
     1604         if connected("ub") = true
     1605         then do:
     1606           define variable v-cntxt-db-num        as integer   no-undo .
     1607           define variable v-cntxt-userid        as character no-undo .
     1608           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1609                                             , OUTPUT v-cntxt-userid
     1610                                             ) .
     1611           run gbl/wndsizew.p
     1612             (input  v-cntxt-db-num
     1613             ,input  v-cntxt-userid
     1614             ,input  v-diasize-proc-name
     1615             ,input  'height':u
     1616             ,input  string(frame dialog-frame :height - v-diasize-orig-frame-height)
     1617             ) .
     1618         end.
     1619       end.
     1620     end.
     1621     assign
     1622       v-diasize-change-size = false
     1623     .
     1624   end procedure.
     1625   procedure diasize_set-height :
     1626     define input  parameter p-new-height  as decimal   no-undo .
     1627     define input  parameter p-move-resize as logical   no-undo .
     1628     do
     1629     on error undo, return error return-value
     1630     :
     1631       run diasize_change-height in this-procedure
     1632         (input  (p-new-height - frame dialog-frame :height)
     1633         ,input  p-move-resize
     1634         ) .
     1635     end.
     1636   end procedure.
     1637   procedure diasize_change-width :
     1638     define input  parameter p-change-value as decimal   no-undo .
     1639     define input  parameter p-move-resize  as logical   no-undo .
     1640     define variable v-field-group-handle   as handle    no-undo .
     1641     define variable v-object-handle        as handle    no-undo .
     1642     define variable v-frame-width          as decimal   no-undo .
     1643     define variable v-frame-virtual-width  as decimal   no-undo .
     1644     define variable v-browse-width         as decimal   no-undo .
     1645     define variable v-window-width         as decimal   no-undo .
     1646     define variable v-window-virtual-width as decimal   no-undo .
     1647     define variable v-change-sign          as integer   no-undo .
     1648     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1649     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1650     if p-change-value > 0
     1651     then do:
     1652       if frame dialog-frame :width + p-change-value >
     1653           session :width-chars
     1654       then do:
     1655         assign
     1656           p-change-value = session :width-chars - frame dialog-frame :width
     1657         .
     1658         if p-change-value <= 0
     1659         then do:
     1660           run diasize_position-resize-button in this-procedure .
     1661           return .
     1662         end.
     1663       end.
     1664     end.
     1665     if p-change-value < 0
     1666     then do:
     1667       if frame dialog-frame :width + p-change-value < v-diasize-orig-frame-width
     1668       then do:
     1669         assign
     1670           p-change-value = v-diasize-orig-frame-width
     1671                          - frame dialog-frame :width
     1672         .
     1673         if p-change-value >= 0
     1674         then do:
     1675           run diasize_position-resize-button in this-procedure .
     1676           return .
     1677         end.
     1678       end.
     1679     end.
     1680     if p-change-value >= 0
     1681     then do:
     1682       assign
     1683         v-change-sign = 1
     1684       .
     1685     end.
     1686     else do:
     1687       assign
     1688         v-change-sign = -1
     1689       .
     1690     end.
     1691     assign
     1692       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1693     .
     1694     if p-change-value = 0
     1695     then do:
     1696       run diasize_position-resize-button in this-procedure .
     1697       return .
     1698     end.
     1699     move_block:
     1700     do
     1701     on error undo move_block, leave move_block
     1702     :
     1703       if retry
     1704       then do:
     1705         do
     1706         on error undo move_block, leave move_block
     1707         :
     1708           if p-change-value > 0
     1709           then do:
     1710             for each buf_temp-diasize-handle
     1711             on error undo, next
     1712             :
     1713               assign
     1714                 v-object-handle = buf_temp-diasize-handle.handle-value
     1715               .
     1716               if v-object-handle <> v-diasize-resize-button
     1717               then do:
     1718                 assign
     1719                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1720                 .
     1721               end.
     1722             end.
     1723             assign
     1724               v-diasize-browse-handle :width = v-browse-width
     1725             .
     1726             for each buf_temp-browse-handle
     1727               where buf_temp-browse-handle.browse-type = 'width':u
     1728             on error undo, next
     1729             :
     1730               assign
     1731                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1732               .
     1733             end.
     1734             assign
     1735               frame dialog-frame :width = v-frame-width
     1736             .
     1737             if frame dialog-frame :scrollable = true
     1738             then do:
     1739               assign
     1740                 frame dialog-frame :virtual-width = v-frame-virtual-width
     1741               .
     1742             end.
     1743             run diasize_position-resize-button in this-procedure .
     1744           end.
     1745           else do:
     1746             if frame dialog-frame :scrollable = true
     1747             then do:
     1748               assign
     1749                 frame dialog-frame :virtual-width = v-frame-virtual-width
     1750               .
     1751             end.
     1752             assign
     1753               frame dialog-frame :width = v-frame-width
     1754             .
     1755             for each buf_temp-browse-handle
     1756               where buf_temp-browse-handle.browse-type = 'width':u
     1757             on error undo, next
     1758             :
     1759               assign
     1760                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1761               .
     1762             end.
     1763             assign
     1764               v-diasize-browse-handle :width = v-browse-width
     1765             .
     1766             for each buf_temp-diasize-handle
     1767             on error undo, next
     1768             :
     1769               assign
     1770                 v-object-handle = buf_temp-diasize-handle.handle-value
     1771               .
     1772               if v-object-handle <> v-diasize-resize-button
     1773               then do:
     1774                 assign
     1775                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1776                 .
     1777               end.
     1778             end.
     1779             run diasize_position-resize-button in this-procedure .
     1780           end.
     1781           assign
     1782             v-diasize-change-size = false
     1783           .
     1784           leave move_block .
     1785         end.
     1786       end.
     1787       assign
     1788         v-diasize-need-full-display = true
     1789       .
     1790       if v-diasize-change-size = false
     1791       then do:
     1792         assign
     1793           v-diasize-change-size = true
     1794         .
     1795       end.
     1796       else do:
     1797         return .
     1798       end.
     1799       assign
     1800         v-frame-width = frame dialog-frame :width
     1801         v-frame-virtual-width = frame dialog-frame :virtual-width
     1802         v-browse-width = v-diasize-browse-handle :width
     1803       .
     1804       for each buf_temp-browse-handle
     1805         where buf_temp-browse-handle.browse-type = 'width':u
     1806       :
     1807         assign
     1808           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1809         .
     1810       end.
     1811       for each buf_temp-diasize-handle
     1812       :
     1813         delete buf_temp-diasize-handle .
     1814       end.
     1815       assign
     1816         v-field-group-handle = frame dialog-frame :first-child
     1817       .
     1818       do while valid-handle(v-field-group-handle)
     1819       :
     1820         assign
     1821           v-object-handle = v-field-group-handle :first-child
     1822         .
     1823         do while valid-handle(v-object-handle)
     1824         :
     1825           if  v-object-handle <> v-diasize-browse-handle :handle
     1826           and v-object-handle <> v-diasize-resize-button
     1827           and can-query(v-object-handle, "row")
     1828           and can-query(v-object-handle, "height")
     1829           and ( v-object-handle :col + v-object-handle :width
     1830                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1831               )
     1832           then do:
     1833             find first buf_temp-browse-handle
     1834               where buf_temp-browse-handle.browse-type   = 'width':u
     1835                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1836               no-error .
     1837             if available buf_temp-browse-handle
     1838             then do:
     1839             end.
     1840             else do:
     1841               create buf_temp-diasize-handle .
     1842               assign
     1843                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1844                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1845               .
     1846             end.
     1847           end.
     1848           assign
     1849             v-object-handle = v-object-handle :next-sibling
     1850           .
     1851         end.
     1852         assign
     1853           v-field-group-handle = v-field-group-handle :next-sibling
     1854         .
     1855       end.
     1856       do with frame dialog-frame
     1857       :
     1858         hide v-diasize-resize-button .
     1859         v-diasize-resize-button :row = 1.
     1860         v-diasize-resize-button :column = 1.
     1861       end.
     1862       if p-change-value > 0
     1863       then do:
     1864         if frame dialog-frame :scrollable = true
     1865         then do:
     1866           assign
     1867             frame dialog-frame :virtual-width = frame dialog-frame :virtual-width + p-change-value
     1868             no-error .
     1869           if error-status :error
     1870           or error-status :get-message(1) <> ""
     1871           then do:
     1872             undo move_block, retry move_block.
     1873           end.
     1874         end.
     1875         assign
     1876           frame dialog-frame :width = v-frame-width + p-change-value
     1877           no-error .
     1878         if error-status :error
     1879         or error-status :get-message(1) <> ""
     1880         then do:
     1881           undo move_block, retry move_block.
     1882         end.
     1883         assign
     1884           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1885         no-error .
     1886         if error-status :error
     1887         or error-status :get-message(1) <> ""
     1888         then do:
     1889           undo move_block, retry move_block.
     1890         end.
     1891         for each buf_temp-browse-handle
     1892           where buf_temp-browse-handle.browse-type = 'width':u
     1893         on error undo move_block, retry move_block
     1894         :
     1895           assign
     1896             buf_temp-browse-handle.browse-handle :width
     1897               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1898             no-error .
     1899           if error-status :error
     1900           or error-status :get-message(1) <> ""
     1901           then do:
     1902             undo move_block, retry move_block .
     1903           end.
     1904         end.
     1905         for each buf_temp-diasize-handle
     1906         on error undo move_block, retry move_block
     1907         :
     1908           assign
     1909             v-object-handle = buf_temp-diasize-handle.handle-value
     1910           .
     1911           if v-object-handle <> v-diasize-resize-button
     1912           then do:
     1913             assign
     1914               v-object-handle :col = v-object-handle :col + p-change-value
     1915               no-error .
     1916             if error-status :error
     1917             or error-status :get-message(1) <> ""
     1918             then do:
     1919               undo move_block, retry move_block .
     1920             end.
     1921           end.
     1922         end.
     1923       end.
     1924       else do:
     1925         for each buf_temp-diasize-handle
     1926         on error undo move_block, retry move_block
     1927         :
     1928           assign
     1929             v-object-handle = buf_temp-diasize-handle.handle-value
     1930           .
     1931           if v-object-handle <> v-diasize-resize-button
     1932           then do:
     1933             assign
     1934               v-object-handle :col = v-object-handle :col + p-change-value
     1935               no-error .
     1936             if error-status :error
     1937             or error-status :get-message(1) <> ""
     1938             then do:
     1939               undo move_block, retry move_block .
     1940             end.
     1941           end.
     1942         end.
     1943         for each buf_temp-browse-handle
     1944           where buf_temp-browse-handle.browse-type = 'width':u
     1945         on error undo move_block, retry move_block
     1946         :
     1947           assign
     1948             buf_temp-browse-handle.browse-handle :width
     1949               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1950             no-error .
     1951           if error-status :error
     1952           or error-status :get-message(1) <> ""
     1953           then do:
     1954             undo move_block, retry move_block .
     1955           end.
     1956         end.
     1957         assign
     1958           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1959           no-error .
     1960         if error-status :error
     1961         or error-status :get-message(1) <> ""
     1962         then do:
     1963           undo move_block, retry move_block.
     1964         end.
     1965         assign
     1966           frame dialog-frame :width = frame dialog-frame :width + p-change-value
     1967         no-error .
     1968         if error-status :error
     1969         or error-status :get-message(1) <> ""
     1970         then do:
     1971           undo move_block, retry move_block.
     1972         end.
     1973         if frame dialog-frame :scrollable = true
     1974         then do:
     1975           assign
     1976             frame dialog-frame :virtual-width = frame dialog-frame :virtual-width + p-change-value
     1977           no-error .
     1978           if error-status :error
     1979           or error-status :get-message(1) <> ""
     1980           then do:
     1981             undo move_block, retry move_block.
     1982           end.
     1983         end.
     1984       end.
     1985       if p-move-resize
     1986       then do:
     1987         run diasize_position-resize-button in this-procedure .
     1988       end.
     1989       if v-diasize-wndstore = true
     1990       then do:
     1991         if connected("ub") = true
     1992         then do:
     1993           define variable v-cntxt-db-num        as integer   no-undo .
     1994           define variable v-cntxt-userid        as character no-undo .
     1995           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1996                                             , OUTPUT v-cntxt-userid
     1997                                             ) .
     1998           run gbl/wndsizew.p
     1999             (input  v-cntxt-db-num
     2000             ,input  v-cntxt-userid
     2001             ,input  v-diasize-proc-name
     2002             ,input  'width':u
     2003             ,input  string(frame dialog-frame :width - v-diasize-orig-frame-width)
     2004             ) .
     2005         end.
     2006       end.
     2007     end.
     2008     assign
     2009       v-diasize-change-size = false
     2010     .
     2011   end procedure.
     2012   procedure diasize_set-width :
     2013     define input  parameter p-new-width  as decimal   no-undo .
     2014     define input  parameter p-move-resize as logical   no-undo .
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       run diasize_change-width in this-procedure
     2019         (input  (p-new-width - frame dialog-frame :width)
     2020         ,input  p-move-resize
     2021         ) .
     2022     end.
     2023   end procedure.
     2024   procedure diasize_position-resize-button :
     2025     do with frame dialog-frame
     2026     :
     2027       hide v-diasize-resize-button .
     2028       assign
     2029         v-diasize-resize-button :row = frame dialog-frame :height - v-diasize-resize-button :height
     2030                     - 1
     2031                     - (frame dialog-frame :border-bottom-pixels / session :pixels-per-row)
     2032         v-diasize-resize-button :col = frame dialog-frame :width - v-diasize-resize-button :width
     2033                     - 1
     2034                     - (frame dialog-frame :border-right-pixels / session :pixels-per-column)
     2035       .
     2036       view v-diasize-resize-button .
     2037     end.
     2038   end procedure.
     2039   on alt-right anywhere
     2040   do:
     2041     run diasize_change-width in this-procedure
     2042       (input 1
     2043       ,input true
     2044       ) .
     2045     return no-apply .
     2046   end.
     2047   on alt-left anywhere
     2048   do:
     2049     run diasize_change-width in this-procedure
     2050       (input -1
     2051       ,input true
     2052       ) .
     2053     return no-apply .
     2054   end.
     2055   on alt-down anywhere
     2056   do:
     2057     run diasize_change-height in this-procedure
     2058       (input 1
     2059       ,input true
     2060       ) .
     2061     return no-apply .
     2062   end.
     2063   on alt-up anywhere
     2064   do:
     2065     run diasize_change-height in this-procedure
     2066       (input -1
     2067       ,input true
     2068       ) .
     2069     return no-apply .
     2070   end.
     2071   on alt-enter of frame dialog-frame
     2072   do:
     2073     run diasize_maximize in this-procedure
     2074       (input  ?
     2075       ).
     2076     return no-apply .
     2077   end.
     2078   procedure diasize_end-move :
     2079     do
     2080     on error undo, return error return-value
     2081     :
     2082       define variable v-row-delta as decimal   no-undo .
     2083       define variable v-col-delta as decimal   no-undo .
     2084       define variable v-new-row as decimal   no-undo .
     2085       define variable v-new-col as decimal   no-undo .
     2086       assign
     2087         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2088         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2089       .
     2090       assign
     2091         v-row-delta = v-new-row - frame dialog-frame :height
     2092         v-col-delta = v-new-col - frame dialog-frame :width
     2093       .
     2094       run diasize_change-height in this-procedure
     2095         (input v-row-delta
     2096         ,input true
     2097         ) .
     2098       run diasize_change-width in this-procedure
     2099         (input v-col-delta
     2100         ,input true
     2101         ) .
     2102     end.
     2103   end procedure.
     2104   procedure diasize_maximize :
     2105     define input  parameter p-action as logical   no-undo .
     2106     do
     2107     on error undo, return error return-value
     2108     :
     2109       if p-action = ?
     2110       then do:
     2111         if v-diasize-need-maximize = true
     2112         then do:
     2113           assign
     2114             p-action = true
     2115           .
     2116         end.
     2117         else do:
     2118           assign
     2119             p-action = false
     2120           .
     2121         end.
     2122       end.
     2123       if p-action = true
     2124       then do:
     2125         run diasize_change-height in this-procedure
     2126           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2127               - frame dialog-frame :height-chars
     2128           ,input true
     2129           ) .
     2130         run diasize_change-width in this-procedure
     2131           (input session :width-chars
     2132               - frame dialog-frame :width-chars
     2133           ,input true
     2134           ) .
     2135         assign
     2136           v-diasize-need-maximize = false
     2137         .
     2138       end.
     2139       else do:
     2140         run diasize_change-width in this-procedure
     2141           (input v-diasize-orig-frame-width
     2142               - frame dialog-frame :width-chars
     2143           ,input true
     2144           ) .
     2145         run diasize_change-height in this-procedure
     2146           (input v-diasize-orig-frame-height
     2147               - frame dialog-frame :height-chars
     2148           ,input true
     2149           ) .
     2150         assign
     2151           v-diasize-need-maximize = true
     2152         .
     2153       end.
     2154     end.
     2155   end procedure.
     2156   procedure diasize_restore-orig-size :
     2157     do
     2158     on error undo, return error return-value
     2159     :
     2160       assign
     2161         v-diasize-current-frame-width  = frame dialog-frame :width
     2162         v-diasize-current-frame-height = frame dialog-frame :height
     2163       .
     2164       run diasize_set-height in this-procedure
     2165         (input  v-diasize-orig-frame-height
     2166         ,input  true
     2167         ) .
     2168       run diasize_set-width in this-procedure
     2169         (input  v-diasize-orig-frame-width
     2170         ,input  true
     2171         ) .
     2172     end.
     2173   end procedure.
     2174   procedure diasize_restore-current-size :
     2175     do
     2176     on error undo, return error return-value
     2177     :
     2178       run diasize_set-height in this-procedure
     2179         (input  v-diasize-current-frame-height
     2180         ,input  true
     2181         ) .
     2182       run diasize_set-width in this-procedure
     2183         (input  v-diasize-current-frame-width
     2184         ,input  true
     2185         ) .
     2186     end.
     2187   end procedure.
     2188   procedure diasize_set-browse-handle :
     2189     define input  parameter p-browse-handle as handle   no-undo .
     2190     define buffer buf_temp-browse-handle for temp-browse-handle .
     2191     do
     2192     on error undo, return error return-value
     2193     :
     2194       assign
     2195         v-diasize-browse-handle = p-browse-handle
     2196       .
     2197       for each buf_temp-browse-handle
     2198       on error undo, return error return-value
     2199       :
     2200         delete buf_temp-browse-handle .
     2201       end.
     2202     end.
     2203   end procedure.
     2204   procedure diasize_add_browse :
     2205     define input  parameter p-browse-type   as character no-undo .
     2206     define input  parameter p-browse-handle as handle    no-undo .
     2207     define buffer buf_temp-browse-handle for temp-browse-handle .
     2208     do
     2209     on error undo, return error return-value
     2210     :
     2211       assign
     2212         v-diasize-browse-number = v-diasize-browse-number + 1
     2213       .
     2214       create buf_temp-browse-handle .
