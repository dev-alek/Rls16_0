      605   initial "@(#)$Workfile$ $Revision$".
      606       define temp-table Tmp#List no-undo like ub.ord-blank
      607           field id                        as integer
      608           field proc-name                 as character
      609           field proc-param                as character
      610           field print-options             as character
      611           field orient                    as character
      612           field orient-orientation        as character
      613           field orient-font-num           as integer
      614           field font-num                  as character
      615           field filtr                     as character
      616           field view_                     as integer  init 1
      617           field sys-key                   as character
      618           field sys-key-black             as character
      619           field type-parts                as character
      620           field type-parts-enabled        as logical
      621           field type-price                as character
      622           field type-price-enabled        as logical
      623           field type-scale                as character
      624           field type-scale-enabled        as logical
      625           field type-val                  as character
      626           field type-val-enabled          as logical
      627           field sort-name                 as character
      628           field sort-name-enabled         as logical
      629           field sort-gr                   as character
      630           field sort-gr-enabled           as logical
      631           field print-graft               as character
      632           field print-graft-enabled       as logical
      633           field no-vat                    as character
      634           field no-vat-enabled            as logical
      635           index pi is primary unique id
      636           index in-name
      637              blank-name
      638           index lu
      639               last-use
      640       .
      641       define temp-table temp_form-list no-undo
      642           field doc-code  as character
      643           field id        as integer
      644           field doc-type  as character
      645           field status_   as character
      646           field internal  as character
      647           field flag      as character
      648           index pi is primary unique
      649               doc-code
      650               id
      651           index idx
      652               id
      653       .
      654       define temp-table temp_menu-doc_disabled-doc-list no-undo
      655           field doc-code      as character
      656           field blank-name    as character
      657           field reason        as character
      658           index pi is primary unique
      659                   doc-code
      660                   blank-name
      661       .
      662       define variable v-menu-doc-sys-key              as character    no-undo.
      663       define variable v-menu-doc-doc-code             as character    no-undo.
      664       define variable v-menu-doc-doc-type             as character    no-undo.
      665       define variable v-menu-doc-ext-doc-type         as character    no-undo.
      666       define variable v-menu-doc-status_              as character    no-undo.
      667       define variable v-menu-doc-internal             as character    no-undo.
      668       define variable v-menu-doc-flag                 as character    no-undo.
      669       define variable v-menu-doc-item-counter         as integer      no-undo.
      670       define variable v-menu-doc-item-disabled        as logical      no-undo.
      671   define variable vss-include-info10 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      672   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      673     define variable p-entry   as logical   no-undo .
      674     define variable v-ind as integer   no-undo .
      675     if p-delimiter = "*":U then do:
      676       message
      677         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      678         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      679         view-as alert-box error .
      680       return ? .
      681     end.
      682     assign
      683       p-entry = true
      684     .
      685     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      686       assign
      687         p-entry = false
      688       .
      689       if num-entries( p-list, "*":U ) > 1 then do:
      690         block_check-list:
      691         do v-ind = 1 to num-entries( p-list, p-delimiter )
      692         :
      693           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      694             assign
      695               p-entry = true
      696             .
      697             leave block_check-list .
      698           end.
      699         end.
      700       end.
      701     end.
      702     return p-entry .
      703   end function .
      704       procedure menu-doc-create-menu-item
      705       :
      706       define input parameter p-type   as   character no-undo.
      707       define input parameter p-stat   as   character no-undo.
      708       define input parameter p-intr   as   character no-undo.
      709       define input parameter p-flag   as   character no-undo.
      710       define input parameter param-1  as   character no-undo.
      711       define input parameter param-2  as   character no-undo.
      712       define input parameter param-3  as   character no-undo.
      713       define input parameter param-4  as   character no-undo.
      714       define input parameter param-5  as   character no-undo.
      715       define input parameter param-6  as   character no-undo.
      716       define input parameter param-7  as   character no-undo.
      717       define input parameter param-8  as   character no-undo.
      718       define input parameter param-9  as   character no-undo.
      719       define input parameter param-10 as   character no-undo.
      720       define input parameter param-11 as   character no-undo.
      721       define input parameter param-12 as   character no-undo.
      722       do
      723       on error undo, return error
      724       :
      725           assign
      726               v-menu-doc-item-disabled = yes
      727           .
      728           if v-menu-doc-sys-key <> 'ExpertekIBS':U
      729           and ( ( param-10 <> "":U
      730                   and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      731                 )
      732                 or ( param-12 <> "":U
      733                      and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      734                    )
      735           then do:
      736               undo, return .
      737           end.
      738           if param-7 = "":U
      739           then do:
      740               undo, return .
      741           end.
      742           if param-1 = '*':U
      743           or lookup( p-type, param-1 ) > 0
      744           then do:
      745               if param-2 = '*':U
      746               or lookup( p-stat, param-2 ) > 0
      747               then do:
      748                   if param-3 = '*':U
      749                   or lookup( p-intr, param-3 ) > 0
      750                   then do:
      751                       if param-4 = '*':U
      752                       or lookup( p-flag, param-4 ) > 0
      753                       then do:
      754                           assign
      755                               v-menu-doc-item-disabled = no
      756                           .
      757                           find first tmp#list
      758                                where tmp#list.blank-name     = param-5
      759                                  and tmp#list.filtr          = param-6
      760                                  and tmp#list.proc-name      = param-7
      761                                  and tmp#list.proc-param     = param-8
      762                                  and tmp#list.print-options  = param-9
      763                                  and tmp#list.sys-key        = param-10
      764                                  and tmp#list.orient         = param-11
      765                                  and tmp#list.sys-key-black  = param-12
      766                           no-error.
      767                           if not available tmp#list
      768                           then do:
      769                               assign
      770                                   v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      771                               .
      772                               create tmp#list.
      773                               assign
      774                                   tmp#list.id             = v-menu-doc-item-counter
      775                                   tmp#list.cli-code       = v-menu-doc-item-counter
      776                                   tmp#list.blank-name     = param-5
      777                                   tmp#list.filtr          = param-6
      778                                   tmp#list.proc-name      = param-7
      779                                   tmp#list.proc-param     = param-8
      780                                   tmp#list.print-options  = param-9
      781                                   tmp#list.sys-key        = param-10
      782                                   tmp#list.orient         = param-11
      783                                   tmp#list.sys-key-black  = param-12
      784                               .
      785                               assign
      786                                   tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      787                                   tmp#list.orient-font-num        = 7
      788                               .
      789                               assign
      790                                   tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      791                                                                     then integer( entry( 2, tmp#list.orient ) )
      792                                                                     else 7 )
      793                               no-error.
      794                               if error-status :error
      795                               then do:
      796                                   assign
      797                                       tmp#list.orient-font-num = 7
      798                                   .
      799                               end.
      800                               run menu-doc-set-visible-options in this-procedure (
      801                                     input tmp#list.print-options
      802                                   , output tmp#list.type-parts-enabled
      803                                   , output tmp#list.type-price-enabled
      804                                   , output tmp#list.type-scale-enabled
      805                                   , output tmp#list.type-val-enabled
      806                                   , output tmp#list.sort-name-enabled
      807                                   , output tmp#list.sort-gr-enabled
      808                                   , output tmp#list.print-graft-enabled
      809                                   , output tmp#list.no-vat-enabled
      810                               ).
      811                           end.
      812                       end.
      813                   end.
      814               end.
      815           end.
      816           if v-menu-doc-item-disabled = yes
      817           then do:
      818               find first tmp#list
      819                    where tmp#list.blank-name     = param-5
      820                      and tmp#list.filtr          = param-6
      821                      and tmp#list.proc-name      = param-7
      822                      and tmp#list.proc-param     = param-8
      823                      and tmp#list.print-options  = param-9
      824                      and tmp#list.sys-key        = param-10
      825                      and tmp#list.orient         = param-11
      826                      and tmp#list.sys-key-black  = param-12
      827               no-error.
      828               if available tmp#list
      829               then do:
      830                   find first temp_menu-doc_disabled-doc-list
      831                        where temp_menu-doc_disabled-doc-list.doc-code     = v-menu-doc-doc-code
      832                          and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      833                   no-error.
      834                   if not available temp_menu-doc_disabled-doc-list
      835                   then do:
      836                       create temp_menu-doc_disabled-doc-list.
      837                       assign
      838                           temp_menu-doc_disabled-doc-list.doc-code    = v-menu-doc-doc-code
      839                           temp_menu-doc_disabled-doc-list.blank-name  = param-5
      840                       .
      841                   end.
      842                   if param-1 <> '*':U
      843                   and lookup( p-type, param-1 ) > 0
      844                   then do:
      845                       assign
      846                           temp_menu-doc_disabled-doc-list.reason   = "type":U
      847                       .
      848                   end.
      849                   assign
      850                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      851                   .
      852                   if param-2 <> '*':U
      853                   and lookup( p-stat, param-2 ) > 0
      854                   then do:
      855                       assign
      856                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      857                       .
      858                   end.
      859                   assign
      860                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      861                   .
      862                   if param-3 <> '*':U
      863                   and lookup( p-intr, param-3 ) > 0
      864                   then do:
      865                       assign
      866                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "intr":U
      867                       .
      868                   end.
      869                   assign
      870                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      871                   .
      872                   if param-4 <> '*':U
      873                   and lookup( p-flag, param-4 ) > 0
      874                   then do:
      875                       assign
      876                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "flag":U
      877                       .
      878                   end.
      879                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      880                   then do:
      881                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      882                             input tmp#list.blank-name
      883                           , input tmp#list.sys-key
      884                           , input Tmp#List.sys-key-black
      885                           , output tmp#list.blank-name
      886                       ).
      887                   end.
      888               end.
      889               else do:
      890                   assign
      891                       v-menu-doc-item-disabled = no
      892                   .
      893               end.
      894           end.
      895           if v-menu-doc-item-disabled = no
      896           then do:
      897               find first tmp#list
      898                    where tmp#list.blank-name     = param-5
      899                      and tmp#list.filtr          = param-6
      900                      and tmp#list.proc-name      = param-7
      901                      and tmp#list.proc-param     = param-8
      902                      and tmp#list.print-options  = param-9
      903                      and tmp#list.sys-key        = param-10
      904                      and tmp#list.orient         = param-11
      905                      and tmp#list.sys-key-black  = param-12
      906               no-error.
      907               if available tmp#list
      908               then do:
      909                   find first temp_form-list
      910                        where temp_form-list.doc-code  = v-menu-doc-doc-code
      911                          and temp_form-list.id        = tmp#list.id
      912                   no-error.
      913                   if not available temp_form-list
      914                   then do:
      915                       create temp_form-list.
      916                       assign
      917                           temp_form-list.doc-code  = v-menu-doc-doc-code
      918                           temp_form-list.id        = tmp#list.id
      919                           temp_form-list.doc-type  = v-menu-doc-doc-type
      920                           temp_form-list.status_   = v-menu-doc-status_
      921                           temp_form-list.internal  = v-menu-doc-internal
      922                           temp_form-list.flag      = v-menu-doc-flag
      923                       .
      924                   end.
      925                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      926                   then do:
      927                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      928                             input tmp#list.blank-name
      929                           , input tmp#list.sys-key
      930                           , input Tmp#List.sys-key-black
      931                           , output tmp#list.blank-name
      932                       ).
      933                   end.
      934               end.
      935           end.
      936       end.
      937       end procedure.
      938       procedure menu-doc-set-visible-options :
      939       define input parameter p-print-options          as character        no-undo.
      940       define output parameter p-type-parts-enabled    as logical          no-undo.
      941       define output parameter p-type-price-enabled    as logical          no-undo.
      942       define output parameter p-type-scale-enabled    as logical          no-undo.
      943       define output parameter p-type-val-enabled      as logical          no-undo.
      944       define output parameter p-sort-name-enabled     as logical          no-undo.
      945       define output parameter p-sort-gr-enabled       as logical          no-undo.
      946       define output parameter p-print-graft-enabled   as logical          no-undo.
      947       define output parameter p-no-vat-enabled        as logical          no-undo.
      948       do
      949       on error undo, return error
      950       :
      951           assign
      952               p-type-parts-enabled    = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      953               p-type-price-enabled    = ( if substring( p-print-options, 2, 1 ) = "+" then yes else no )
      954               p-type-scale-enabled    = ( if substring( p-print-options, 3, 1 ) = "+" then yes else no )
      955               p-type-val-enabled      = ( if substring( p-print-options, 4, 1 ) = "+" then yes else no )
      956               p-sort-name-enabled     = ( if substring( p-print-options, 5, 1 ) = "+" then yes else no )
      957               p-sort-gr-enabled       = ( if substring( p-print-options, 6, 1 ) = "+" then yes else no )
      958               p-print-graft-enabled   = ( if substring( p-print-options, 7, 1 ) = "+" then yes else no )
      959               p-no-vat-enabled        = ( if substring( p-print-options, 8, 1 ) = "+" then yes else no )
      960           .
      961       end.
      962       end procedure.
      963       procedure menu-doc-create-options-string :
      964       define input parameter p-tmp-list-id        as integer          no-undo.
      965       define output parameter p-options-string    as character        no-undo.
      966           define buffer buf_tmp#list      for tmp#list.
      967       do
      968       for buf_tmp#list
      969       on error undo, return error
      970       :
      971           find first buf_tmp#list
      972                where buf_tmp#list.id = p-tmp-list-id
      973           .
      974           assign
      975               p-options-string =  ( if trim( buf_tmp#list.type-parts  ) = "+":U then "+":U else "-":U )
      976                                 + ( if trim( buf_tmp#list.type-price  ) = "+":U then "+":U else "-":U )
      977                                 + ( if trim( buf_tmp#list.type-scale  ) = "+":U then "+":U else "-":U )
      978                                 + ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      979                                 + ( if trim( buf_tmp#list.sort-name   ) = "+":U then "+":U else "-":U )
      980                                 + ( if trim( buf_tmp#list.sort-gr     ) = "+":U then "+":U else "-":U )
      981                                 + ( if trim( buf_tmp#list.print-graft ) = "+":U then "+":U else "-":U )
      982                                 + ( if trim( buf_tmp#list.no-vat      ) = "+":U then "+":U else "-":U )
      983           .
      984       end.
      985       end procedure.
      986       procedure menu-doc-set-options-string :
      987       define input parameter p-tmp-list-id            as integer          no-undo.
      988       define input parameter p-options-string         as character        no-undo.
      989           define buffer buf_tmp#list      for tmp#list.
      990       do
      991       for buf_tmp#list
      992       on error undo, return error
      993       :
      994           find first buf_tmp#list
      995                where buf_tmp#list.id = p-tmp-list-id
      996           .
      997           assign
      998               buf_tmp#list.type-parts  = ( if buf_tmp#list.type-parts-enabled     = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      999               buf_tmp#list.type-price  = ( if buf_tmp#list.type-price-enabled     = yes then substitute( "  &1", substring( p-options-string, 2, 1 ) ) else " ":U )
     1000               buf_tmp#list.type-scale  = ( if buf_tmp#list.type-scale-enabled     = yes then substitute( "  &1", substring( p-options-string, 3, 1 ) ) else " ":U )
     1001               buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 4, 1 ) ) else " ":U )
     1002               buf_tmp#list.sort-name   = ( if buf_tmp#list.sort-name-enabled      = yes then substitute( "  &1", substring( p-options-string, 5, 1 ) ) else " ":U )
     1003               buf_tmp#list.sort-gr     = ( if buf_tmp#list.sort-gr-enabled        = yes then substitute( "  &1", substring( p-options-string, 6, 1 ) ) else " ":U )
     1004               buf_tmp#list.print-graft = ( if buf_tmp#list.print-graft-enabled    = yes then substitute( "  &1", substring( p-options-string, 7, 1 ) ) else " ":U )
     1005               buf_tmp#list.no-vat      = ( if buf_tmp#list.no-vat-enabled         = yes then substitute( "  &1", substring( p-options-string, 8, 1 ) ) else " ":U )
     1006           .
     1007       end.
     1008       end procedure.
     1009       procedure menu-doc-create-options-enabled-string :
     1010       define input parameter p-tmp-list-id                as integer          no-undo.
     1011       define output parameter p-options-enabled-string    as character        no-undo.
     1012           define buffer buf_tmp#list      for tmp#list.
     1013       do
     1014       for buf_tmp#list
     1015       on error undo, return error
     1016       :
     1017           find first buf_tmp#list
     1018                where buf_tmp#list.id = p-tmp-list-id
     1019           .
     1020           assign
     1021               p-options-enabled-string =  ( if buf_tmp#list.type-parts-enabled  = yes then "+":U else "-":U )
     1022                                         + ( if buf_tmp#list.type-price-enabled  = yes then "+":U else "-":U )
     1023                                         + ( if buf_tmp#list.type-scale-enabled  = yes then "+":U else "-":U )
     1024                                         + ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
     1025                                         + ( if buf_tmp#list.sort-name-enabled   = yes then "+":U else "-":U )
     1026                                         + ( if buf_tmp#list.sort-gr-enabled     = yes then "+":U else "-":U )
     1027                                         + ( if buf_tmp#list.print-graft-enabled = yes then "+":U else "-":U )
     1028                                         + ( if buf_tmp#list.no-vat-enabled      = yes then "+":U else "-":U )
     1029           .
     1030       end.
     1031       end procedure.
     1032       procedure menu-doc-extend-blank-name-for-IBS :
     1033       define input parameter p-in-blank-name      as character        no-undo.
     1034       define input parameter p-sys-key            as character        no-undo.
     1035       define input parameter p-sys-key-black      as character        no-undo.
     1036       define output parameter p-out-blank-name    as character        no-undo.
     1037       do
     1038       on error undo, return error
     1039       :
     1040           assign
     1041               p-out-blank-name = p-in-blank-name
     1042           .
     1043           if p-sys-key <> "":U
     1044           then do:
     1045               assign
     1046                   p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
     1047               .
     1048           end.
     1049           if p-sys-key-black <> ""
     1050           then do:
     1051               assign
     1052                   p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
     1053               .
     1054           end.
     1055       end.
     1056       end procedure.
     1057   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058     define variable v-cntxt-db-num        as integer   no-undo .
     1059     define variable v-cntxt-userid        as character no-undo .
     1060     define variable v-cntxt-level         as character no-undo .
     1061     define variable v-cntxt-host-code-obj as integer   no-undo .
     1062     define variable v-cntxt-obj-type      as character no-undo .
     1063     define variable v-cntxt-obj-code      as integer   no-undo .
     1064     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1065     define variable v-cntxt-is-admin      as logical   no-undo .
     1066   procedure proc-alt-shift-f2:
     1067     if not ibs.th.gbl.gbl-var:rcode
     1068   then
     1069     run gbl\inidebug.p .
     1070   end.
     1071   procedure proc-alt-shift-f3:
     1072     run gbl/prvssinf.p
     1073       ( input this-procedure
     1074       ) .
     1075   end.
     1076   define variable v-inform-launched as logical no-undo initial false .
     1077   procedure proc-alt-shift-f4:
     1078     define variable v-action as character no-undo .
     1079     if v-inform-launched = false then do:
     1080       assign
     1081         v-inform-launched = true
     1082       .
     1083       run gbl/d-inform.w
     1084         (  input self
     1085         ,  input this-procedure
     1086         , output v-action
     1087         ) no-error .
     1088       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1089       assign
     1090         v-inform-launched = false
     1091       .
     1092     end.
     1093   end.
     1094   procedure proc-alt-f1:
     1095     run gbl/corrhelp.p
     1096       (input this-procedure
     1097       ) .
     1098   end .
     1099   on alt-shift-f2 anywhere do:
     1100     run proc-alt-shift-f2.
     1101   end.
     1102   on alt-shift-f3 anywhere do:
     1103     run proc-alt-shift-f3 in this-procedure .
     1104   end.
     1105   on alt-shift-f4 anywhere do:
     1106     run proc-alt-shift-f4 in this-procedure.
     1107   end.
     1108   on alt-f1 anywhere do:
     1109     run proc-alt-f1 in this-procedure .
     1110   end.
     1111   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1112   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1113   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1114   define variable par-type          as character no-undo.
     1115   define variable v-value-character as character no-undo .
     1116   define variable v-value-date      as date      no-undo .
     1117   define variable v-value-decimal   as decimal   no-undo .
     1118   define variable v-value-integer   as integer   no-undo .
     1119   define variable v-value-logical   as logical   no-undo .
     1120   define variable ii as int no-undo .
     1121   define variable Nesoot_Flag  as logical  no-undo .
     1122   define variable stat                 as logical  no-undo .
     1123   define variable in-docprvalue as character no-undo.
     1124   define variable in-docprtype  as character no-undo.
     1125   define variable List_  as character no-undo.
     1126   define variable sys-key as char no-undo.
     1127   define variable g#report-num    as integer      no-undo.
     1128   define variable g#quest-print   as logical      no-undo.
     1129   define variable g#log           as logical      no-undo.
     1130   define buffer buf_init_fbr-pln       for ub.fbr-pln.
     1131   DEFINE BUTTON b-erase
     1132        LABEL "&Снять все *":L
     1133        size 13.13 by 1 TOOLTIP "Снять все отметки"
     1134        BGCOLOR 8 .
     1135   DEFINE BUTTON b-exit AUTO-END-KEY
     1136        LABEL "&Выход ":L
     1137        size 10 by 1
     1138        BGCOLOR 8 .
     1139   DEFINE BUTTON b-help
     1140        LABEL "&Помощь":L
     1141        size 10 by 1
     1142        BGCOLOR 8 .
     1143   DEFINE BUTTON b-mark
     1144        LABEL "&*":L
     1145        size 3.63 by 1
     1146        BGCOLOR 8 .
     1147   DEFINE BUTTON b-print
     1148        LABEL "Пе&чать":L
     1149        size 10 by 1
     1150        BGCOLOR 8 .
     1151   DEFINE VARIABLE v-printer-name AS CHARACTER FORMAT "X(256)":U
     1152        LABEL "Текущий принтер"
     1153         VIEW-AS TEXT
     1154        SIZE 46.13 BY .67
     1155        FGCOLOR 4  NO-UNDO.
     1156   DEFINE QUERY BROWSE-2 FOR
     1157         Tmp#List SCROLLING.
     1158   DEFINE BROWSE BROWSE-2
     1159     QUERY BROWSE-2 DISPLAY
     1160         Tmp#List.last-use COLUMN-LABEL "*" FORMAT "*/"
     1161         Tmp#List.blank-name COLUMN-LABEL "Название документа":C59 FORMAT "X(59)"
     1162     ENABLE
     1163         Tmp#List.last-use
     1164       WITH NO-BOX NO-ROW-MARKERS SEPARATORS SIZE 63.88 BY 19.21.
     1165   DEFINE FRAME Dialog-Frame
     1166        b-exit at row 1.04 col 2.13
     1167        b-mark at row 1.04 col 12.13
     1168        b-erase at row 1.04 col 15.88
     1169        b-print at row 1.04 col 44.88
     1170        b-help at row 1.04 col 55
     1171        BROWSE-2 AT ROW 2.25 COL 1.38
     1172        v-printer-name AT ROW 22 COL 17 COLON-ALIGNED
     1173        SPACE(1.11) SKIP(0.32)
     1174       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1175            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1176            TITLE "".
     1177   ASSIGN
     1178          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1179          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1180   ASSIGN
     1181          BROWSE-2:MAX-DATA-GUESS IN FRAME Dialog-Frame     = 200.
     1182   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1183   DO:
     1184     APPLY "END-ERROR":U TO SELF.
     1185   END.
     1186   ON ROW-DISPLAY OF BROWSE-2 IN FRAME Dialog-Frame
     1187   DO:
     1188   if Tmp#List.orient = 'A4port' OR
     1189      Tmp#List.orient = 'A3port'
     1190        then DO:
     1191         Tmp#List.last-use          :fgcolor in browse BROWSE-2 = blue_color.
     1192         Tmp#List.blank-name        :fgcolor in browse BROWSE-2 = blue_color.
     1193     End.
     1194     Else DO:
     1195         if Tmp#List.orient = 'EXCEL' OR
     1196           Tmp#List.orient = 'self'
     1197             then DO:
     1198                 Tmp#List.last-use   :fgcolor in browse BROWSE-2 = CYAN_COLOR.
     1199                 Tmp#List.blank-name :fgcolor in browse BROWSE-2 = CYAN_COLOR.
     1200             end.
     1201             Else DO:
     1202                 Tmp#List.last-use   :fgcolor in browse BROWSE-2 = black_color.
     1203                 Tmp#List.blank-name :fgcolor in browse BROWSE-2 = black_color.
     1204             End.
     1205     End.
     1206   END.
     1207   ON CHOOSE OF b-erase IN FRAME Dialog-Frame
     1208   DO:
     1209     For each Tmp#List share-lock :
     1210         Tmp#List.last-use=false.
     1211     End.
     1212       OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.cli-code.
     1213   END.
     1214   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1215   OR MOUSE-SELECT-DBLCLICK OF BROWSE-2 IN FRAME Dialog-Frame
     1216   DO:
     1217       if not available tmp#list
     1218       then do:
     1219           message "Неправильный выбор строки.".
     1220           return no-apply.
     1221       end.
     1222       BROWSE-2 :refresh ().
     1223       if Tmp#List.last-use = true
     1224       then do:
     1225           assign
     1226               Tmp#List.last-use = false
     1227           .
     1228           display
     1229               "" @ Tmp#List.last-use
     1230           with browse BROWSE-2.
     1231       end.
     1232       else do:
     1233           assign
     1234               Tmp#List.last-use = true
     1235           .
     1236           display
     1237               "*" @ Tmp#List.last-use
     1238           with browse BROWSE-2.
     1239       end.
     1240       apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     1241       assign
     1242           g#log = BROWSE-2:select-next-row ()
     1243       .
     1244   END.
     1245   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1246   DO:
     1247       define variable lok as logical no-undo .
     1248       define variable         PrintDoc              as      logical no-undo .
     1249       define variable         PrintSet              as      logical no-undo .
     1250       define variable         Print-Round           AS      LOGICAL INITIAL yes no-undo .
     1251       define variable l-recid as recid no-undo .
     1252       Assign
     1253           List_ = ''
     1254           ii = 0
     1255           l-recid = recid(Tmp#List)
     1256       .
     1257       For each Tmp#List
     1258       :
     1259           if Tmp#List.last-use <> false
     1260           then Assign
     1261               ii = ii + 1
     1262               List_ = List_ + ',' + string(tmp#list.id)
     1263           .
     1264       End.
     1265       if ii = 0
     1266       then do:
     1267           Message
     1268               "Отметьте формы документа для печати!"
     1269           view-as alert-box information
     1270           title "Внимание !".
     1271           find first Tmp#List no-lock
     1272                where l-recid = recid(Tmp#List)
     1273           .
     1274           return no-apply.
     1275       end.
     1276   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1277   empty temp-table thbjattr_thbj-attr.
     1278   run adm/shattri.p (
     1279      input "get":U
     1280     ,input v-cntxt-obj-type
     1281     ,input v-cntxt-obj-code
     1282     ,input 'prt-obj':U
     1283     ,input  ""
     1284     ,output v-value-character
     1285     ,output v-value-date
     1286     ,output v-value-decimal
     1287     ,output v-value-integer
     1288     ,output v-value-logical
     1289     ,output par-type
     1290     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1291     ) no-error .
     1292   for each thbjattr_thbj-attr :
     1293       if thbjattr_thbj-attr.prop-code = 'in-docpr' then in-docprvalue =  thbjattr_thbj-attr.property-value-character .
     1294   end.
     1295    find first ubflt.usr-flt exclusive-lock
     1296         where ubflt.usr-flt.user-name = v-cntxt-userid
     1297           and ubflt.usr-flt.call-point  = String( buf_init_fbr-pln.doc-type)
     1298                                     + ",no,"
     1299                                     + String(  buf_init_fbr-pln.status_ ) + ",no"
     1300    no-error .
     1301   if g#quest-print = true  THEN DO:
     1302      output  to value( string( session:temp-directory + "$" + string( g#report-num ) ) ) .
     1303      OUTPUT CLOSE.
     1304   End.
     1305       for each Tmp#List no-lock
     1306           where Tmp#List.last-use = true
     1307       :
     1308           case num-entries(tmp#list.proc-param)
     1309           :
     1310               when 0
     1311               then do:
     1312                   run value (tmp#list.proc-name)  (
     1313                         input p-mainmenu-handle
     1314                       , input rec_id
     1315                   ).
     1316               end.
     1317               when 1
     1318               then do:
     1319                   run value (tmp#list.proc-name)  (
     1320                         input p-mainmenu-handle
     1321                       , input rec_id
     1322                       , input tmp#list.proc-param
     1323                   ).
     1324               end.
     1325               when 2
     1326               then do:
     1327                   run value (tmp#list.proc-name)  (
     1328                         input p-mainmenu-handle
     1329                       , input rec_id
     1330                       , input entry(1,tmp#list.proc-param)
     1331                       , input entry(2,tmp#list.proc-param)
     1332                   ).
     1333               end.
     1334               when 3
     1335               then do:
     1336                   run value (tmp#list.proc-name)  (
     1337                         input p-mainmenu-handle
     1338                       , input rec_id
     1339                       , input entry(1,tmp#list.proc-param)
     1340                       , input entry(2,tmp#list.proc-param)
     1341                       , input entry(3,tmp#list.proc-param)
     1342                   ).
     1343               end.
     1344               when 4
     1345               then do:
     1346                   message
     1347                       "Для документа производства число параметров не может быть больше 3"
     1348                   view-as alert-box.
     1349                   undo, return no-apply .
     1350               end.
     1351           end case.
     1352       end.
     1353   if session :set-wait-state( "" ) then.
     1354       if g#quest-print = true
     1355       then do:
     1356           OS-DELETE
     1357              value( string( session:temp-directory) + "rpt" + string( g#report-num )  )    .
     1358           OS-RENAME
     1359              value(  string( session:temp-directory) + "$" + string( g#report-num )     )
     1360              value(  string( session:temp-directory) + "rpt" + string( g#report-num )) .
     1361           IF ii = 1 and
     1362               ((can-find (first tmp#list where CAPS(Tmp#list.proc-name) = "rep/xl-prtcl.p":U and Tmp#List.last-use = true) = true  ) OR
     1363                (can-find (first tmp#list where CAPS(Tmp#list.proc-name) = "rep/tick-doc.p":U and Tmp#List.last-use = true) = true  ))
     1364                THEN do:
     1365   if session :set-wait-state( "" ) then.
     1366                end.
     1367                ELSE DO :
     1368                 find first tmp#list where  Tmp#List.last-use = true no-lock no-error .
     1369                   define variable v-user-action           as character            no-undo.
     1370                   define variable v-printed               as logical              no-undo.
     1371                 case Tmp#list.orient :
     1372                     when 'A4port' then do:
     1373                           run gbl/prnfilen.w (
     1374                                 input "":U
     1375                               , input 4
     1376                               , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     1377                               , 7
     1378                               , output v-user-action
     1379                               , output v-printed
     1380                           ) .
     1381                     end.
     1382                     when 'A4lans' or when "" then do:
     1383                           run gbl/prnfilen.w (
     1384                                 input "":U
     1385                               , input 8
     1386                               , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     1387                               , 7
     1388                               , output v-user-action
     1389                               , output v-printed
     1390                           ) .
     1391                     end.
     1392                 End case.
     1393                End.
     1394       end.
     1395       Else do:
     1396           message
     1397               "Задание распечатано"
     1398           view-as alert-box information.
     1399       end.
     1400   END.
     1401   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   on help of frame Dialog-Frame
     1403   do:
     1404     run gbl/app_help.p
     1405       (input this-procedure :file-name
     1406       ,input ''
     1407       ,input ?
     1408       ) no-error.
     1409     if error-status :error then do:
     1410       message
     1411         "Ошибка при вызове помощи"
     1412         error-status :get-message(1)
     1413         view-as alert-box .
     1414     end.
     1415   end.
     1416   run minbtn-set in this-procedure .
     1417   on choose of b-help in frame Dialog-Frame
     1418   do:
     1419     apply "help":u to frame Dialog-Frame .
     1420   end.
     1421   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1422   procedure minbtn-set :
     1423       do
     1424           on error undo, return error return-value
     1425           :
     1426           define variable ii              as integer       no-undo .
     1427           define variable fh              as widget-handle no-undo .
     1428           define variable hh              as widget-handle no-undo .
     1429           define variable v-h             as handle        extent 4 no-undo .
     1430           define variable v-name-button   as character     no-undo .
     1431           define variable v-help-old-x    as decimal       no-undo .
     1432           define variable v-help-old-y    as decimal       no-undo .
     1433           define variable v-help-old-size as decimal       no-undo .
     1434           define variable v-frame-width   as decimal       no-undo .
     1435           define variable jj              as integer       no-undo .
     1436           do
     1437               on error undo, return error
     1438               :
     1439               assign
     1440                   v-frame-width = frame Dialog-Frame:width - 0.3
     1441                   fh            = frame Dialog-Frame:first-child
     1442                   hh            = fh:first-child
     1443                   ii            = 1
     1444                   .
     1445               do while valid-handle(hh):
     1446                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1447                   do:
     1448                       case lc(hh:name) :
     1449                           when "b-help" then
     1450                               do:
     1451                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1452                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1453                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1454                                   hh:TOOLTIP = "Помощь" .
     1455                                   v-help-old-x = hh:column .
     1456                                   v-help-old-y = hh:row    .
     1457                                   v-help-old-size = hh:width .
     1458                                   hh:width-chars = 2.5 .
     1459                               end.
     1460                           when "b-print" then
     1461                               do:
     1462                                   hh:load-image("cmp/b-print.bmp":u) .
     1463                                   hh:TOOLTIP = "Печать" .
     1464                                   v-h[ii] = hh:handle .
     1465                                   ii = ii + 1 .
     1466                                   hh:width-chars = 3 .
     1467                               end.
     1468                           when "b-history" or
     1469                           when "b-hist" then
     1470                               do:
     1471                                   hh:load-image("cmp/b-hist.bmp":u) .
     1472                                   hh:TOOLTIP = "История" .
     1473                                   v-h[ii] = hh:handle .
     1474                                   ii = ii + 1 .
     1475                                   hh:width-chars = 3 .
     1476                               end.
     1477                           when "b-sch" then
     1478                               do:
     1479                                   hh:load-image("cmp/b-sch.bmp":u) .
     1480                                   hh:TOOLTIP = "Установка Фильтра" .
     1481                                   v-h[ii] = hh:handle .
     1482                                   ii = ii + 1 .
     1483                                   hh:width-chars = 3 .
     1484                               end.
     1485                           when "b-hist-user" then
     1486                               do:
     1487                                   hh:load-image("cmp/b-hist.bmp":u) .
     1488                                   hh:TOOLTIP = "История пользователя" .
     1489                                   ii = ii + 1 .
     1490                               end.
     1491                       end case.
     1492                   end.
     1493                   hh = hh:next-sibling.
     1494               end.
     1495               b-help:column = v-frame-width - b-help:width-chars.
     1496               jj = 0.
     1497               repeat ii = 4 to 1 by -1 :
     1498                   if valid-handle (v-h[ii] ) then
     1499                   do:
     1500                       jj  = jj + 1 .
     1501                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1502                       v-h[ii]:row    = v-help-old-y .
     1503                   end.
     1504               end.
     1505           end.
     1506       end.
     1507   end procedure.
     1508   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1509   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1510   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1511   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1512   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1513   define variable v-diasize-current-frame-height as decimal   no-undo .
     1514   define variable v-diasize-change-size          as logical   no-undo .
     1515   define variable v-diasize-resize-button        as handle    no-undo .
     1516   define variable v-diasize-wndmax               as logical   no-undo .
     1517   define variable v-diasize-wndstore             as logical   no-undo .
     1518   define variable v-diasize-proc-name            as character no-undo .
     1519   define variable v-diasize-browse-handle        as handle    no-undo .
     1520   define variable v-diasize-browse-number        as integer   no-undo .
     1521   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1522   define temp-table temp-diasize-handle no-undo
     1523     field handle-value  as handle
     1524     field save-position as decimal
     1525     index xpk is primary unique handle-value
     1526     .
     1527   define temp-table temp-browse-handle no-undo
     1528     field browse-type   as character
     1529     field browse-number as integer
     1530     field browse-handle as handle
     1531     field original-size as decimal
     1532     index xpk is primary unique browse-type browse-number
     1533     index xie browse-type browse-handle
     1534   .
     1535   procedure diasize_change-height :
     1536     define input  parameter p-change-value  as decimal   no-undo .
     1537     define input  parameter p-move-resize   as logical   no-undo .
     1538     define variable v-field-group-handle    as handle    no-undo .
     1539     define variable v-object-handle         as handle    no-undo .
     1540     define variable v-frame-height          as decimal   no-undo .
     1541     define variable v-frame-virtual-height  as decimal   no-undo .
     1542     define variable v-browse-height         as decimal   no-undo .
     1543     define variable v-window-height         as decimal   no-undo .
     1544     define variable v-window-virtual-height as decimal   no-undo .
     1545     define variable v-change-sign           as integer   no-undo .
     1546     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1547     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1548     if p-change-value > 0
     1549     then do:
     1550       if frame Dialog-Frame :height + p-change-value
     1551           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1552       then do:
     1553         assign
     1554           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1555                           - (frame Dialog-Frame :height-chars)
     1556         .
     1557         if p-change-value <= 0
     1558         then do:
     1559           run diasize_position-resize-button in this-procedure .
     1560           return .
     1561         end.
     1562       end.
     1563     end.
     1564     if p-change-value < 0
     1565     then do:
     1566       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1567       then do:
     1568         assign
     1569           p-change-value = v-diasize-orig-frame-height
     1570                          - (frame Dialog-Frame :height-chars)
     1571         .
     1572         if p-change-value >= 0
     1573         then do:
     1574           run diasize_position-resize-button in this-procedure .
     1575           return .
     1576         end.
     1577       end.
     1578     end.
     1579     if p-change-value >= 0
     1580     then do:
     1581       assign
     1582         v-change-sign = 1
     1583       .
     1584     end.
     1585     else do:
     1586       assign
     1587         v-change-sign = -1
     1588       .
     1589     end.
     1590     assign
     1591       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1592     .
     1593     if p-change-value = 0
     1594     then do:
     1595       run diasize_position-resize-button in this-procedure .
     1596       return .
     1597     end.
     1598     move_block:
     1599     do
     1600     on error undo move_block, retry move_block
     1601     :
     1602       if retry
     1603       then do:
     1604         do
     1605         on error undo move_block, leave move_block
     1606         :
     1607           if p-change-value > 0
     1608           then do:
     1609             for each buf_temp-diasize-handle
     1610             on error undo, next
     1611             :
     1612               assign
     1613                 v-object-handle = buf_temp-diasize-handle.handle-value
     1614               .
     1615               if v-object-handle <> v-diasize-resize-button
     1616               then do:
     1617                 assign
     1618                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1619                 .
     1620               end.
     1621             end.
     1622             assign
     1623               v-diasize-browse-handle :height = v-browse-height
     1624             .
     1625             for each buf_temp-browse-handle
     1626               where buf_temp-browse-handle.browse-type = 'height':u
     1627             on error undo, next
     1628             :
     1629               assign
     1630                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1631               .
     1632             end.
     1633             assign
     1634               frame Dialog-Frame :height = v-frame-height
     1635             .
     1636             if frame Dialog-Frame :scrollable = true
     1637             then do:
     1638               assign
     1639                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1640               .
     1641             end.
     1642             run diasize_position-resize-button in this-procedure .
     1643           end.
     1644           else do:
     1645             if frame Dialog-Frame :scrollable = true
     1646             then do:
     1647               assign
     1648                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1649               .
     1650             end.
     1651             assign
     1652               frame Dialog-Frame :height = v-frame-height
     1653             .
     1654             assign
     1655               v-diasize-browse-handle :height = v-browse-height
     1656             .
     1657             for each buf_temp-browse-handle
     1658               where buf_temp-browse-handle.browse-type = 'height':u
     1659             on error undo, next
     1660             :
     1661               assign
     1662                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1663               .
     1664             end.
     1665             for each buf_temp-diasize-handle
     1666             on error undo, next
     1667             :
     1668               assign
     1669                 v-object-handle = buf_temp-diasize-handle.handle-value
     1670               .
     1671               if v-object-handle <> v-diasize-resize-button
     1672               then do:
     1673                 assign
     1674                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1675                 .
     1676               end.
     1677             end.
     1678             run diasize_position-resize-button in this-procedure .
     1679           end.
     1680           assign
     1681             v-diasize-change-size = false
     1682           .
     1683           leave move_block .
     1684         end.
     1685       end.
     1686       assign
     1687         v-diasize-need-full-display = true
     1688       .
     1689       if v-diasize-change-size = false
     1690       then do:
     1691         assign
     1692           v-diasize-change-size = true
     1693         .
     1694       end.
     1695       else do:
     1696         return .
     1697       end.
     1698       assign
     1699         v-frame-height = frame Dialog-Frame :height
     1700         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1701         v-browse-height = v-diasize-browse-handle :height
     1702       .
     1703       for each buf_temp-browse-handle
     1704         where buf_temp-browse-handle.browse-type = 'height':u
     1705       :
     1706         assign
     1707           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1708         .
     1709       end.
     1710       for each buf_temp-diasize-handle
     1711       :
     1712         delete buf_temp-diasize-handle .
     1713       end.
     1714       assign
     1715         v-field-group-handle = frame Dialog-Frame :first-child
     1716       .
     1717       do while valid-handle(v-field-group-handle)
     1718       :
     1719         assign
     1720           v-object-handle = v-field-group-handle :first-child
     1721         .
     1722         do while valid-handle(v-object-handle)
     1723         :
     1724           if  v-object-handle <> v-diasize-browse-handle :handle
     1725           and can-query(v-object-handle, "row")
     1726           and can-query(v-object-handle, "height")
     1727           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1728           then do:
     1729             find first buf_temp-browse-handle
     1730               where buf_temp-browse-handle.browse-type   = 'height':u
     1731                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1732               no-error .
     1733             if available buf_temp-browse-handle
     1734             then do:
     1735             end.
     1736             else do:
     1737               create buf_temp-diasize-handle .
     1738               assign
     1739                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1740                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1741               .
     1742             end.
     1743           end.
     1744           assign
     1745             v-object-handle = v-object-handle :next-sibling
     1746           .
     1747         end.
     1748         assign
     1749           v-field-group-handle = v-field-group-handle :next-sibling
     1750         .
     1751       end.
     1752       do with frame Dialog-Frame
     1753       :
     1754         hide v-diasize-resize-button .
     1755         assign
     1756           v-diasize-resize-button :row    = 1
     1757           v-diasize-resize-button :column = 1
     1758         .
     1759       end.
     1760       if p-change-value > 0
     1761       then do:
     1762         if frame Dialog-Frame :scrollable = true
     1763         then do:
     1764           assign
     1765             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1766             no-error .
     1767           if error-status :error
     1768           or error-status :get-message(1) <> ""
     1769           then do:
     1770             undo move_block, retry move_block .
     1771           end.
     1772         end.
     1773         assign
     1774           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1775           no-error .
     1776         if error-status :error
     1777         or error-status :get-message(1) <> ""
     1778         then do:
     1779           undo move_block, retry move_block .
     1780         end.
     1781         assign
     1782           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1783           no-error .
     1784         if error-status :error
     1785         or error-status :get-message(1) <> ""
     1786         then do:
     1787           undo move_block, retry move_block .
     1788         end.
     1789         for each buf_temp-browse-handle
     1790           where buf_temp-browse-handle.browse-type = 'height':u
     1791         on error undo move_block, retry move_block
     1792         :
     1793           assign
     1794             buf_temp-browse-handle.browse-handle :height
     1795               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1796             no-error .
     1797           if error-status :error
     1798           or error-status :get-message(1) <> ""
     1799           then do:
     1800             undo move_block, retry move_block .
     1801           end.
     1802         end.
     1803         for each buf_temp-diasize-handle
     1804         on error undo move_block, retry move_block
     1805         :
     1806           assign
     1807             v-object-handle = buf_temp-diasize-handle.handle-value
     1808           .
     1809           if v-object-handle <> v-diasize-resize-button
     1810           then do:
     1811             assign
     1812               v-object-handle :row = v-object-handle :row + p-change-value
     1813               no-error .
     1814             if error-status :error
     1815             or error-status :get-message(1) <> ""
     1816             then do:
     1817               undo move_block, retry move_block .
     1818             end.
     1819           end.
     1820         end.
     1821       end.
     1822       else do:
     1823         for each buf_temp-diasize-handle
     1824         on error undo move_block, retry move_block
     1825         :
     1826           assign
     1827             v-object-handle = buf_temp-diasize-handle.handle-value
     1828           .
     1829           if v-object-handle <> v-diasize-resize-button
     1830           then do:
     1831             assign
     1832               v-object-handle :row = v-object-handle :row + p-change-value
     1833               no-error .
     1834             if error-status :error
     1835             or error-status :get-message(1) <> ""
     1836             then do:
     1837               undo move_block, retry move_block .
     1838             end.
     1839           end.
     1840         end.
     1841         assign
     1842           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1843           no-error .
     1844         if error-status :error
     1845         or error-status :get-message(1) <> ""
     1846         then do:
     1847           undo move_block, retry move_block .
     1848         end.
     1849         for each buf_temp-browse-handle
     1850           where buf_temp-browse-handle.browse-type = 'height':u
     1851         on error undo move_block, retry move_block
     1852         :
     1853           assign
     1854             buf_temp-browse-handle.browse-handle :height
     1855               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1856             no-error .
     1857           if error-status :error
     1858           or error-status :get-message(1) <> ""
     1859           then do:
     1860             undo move_block, retry move_block .
     1861           end.
     1862         end.
     1863         assign
     1864           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1865           no-error .
     1866         if error-status :error
     1867         or error-status :get-message(1) <> ""
     1868         then do:
     1869           undo move_block, retry move_block .
     1870         end.
     1871         if frame Dialog-Frame :scrollable = true
     1872         then do:
     1873           assign
     1874             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1875             no-error .
     1876           if error-status :error
     1877           or error-status :get-message(1) <> ""
     1878           then do:
     1879             undo move_block, retry move_block .
     1880           end.
     1881         end.
     1882       end.
     1883       if p-move-resize = true
     1884       then do:
     1885         run diasize_position-resize-button in this-procedure .
     1886       end.
     1887       if v-diasize-wndstore = true
     1888       then do:
     1889         if connected("ub") = true
     1890         then do:
     1891           define variable v-cntxt-db-num        as integer   no-undo .
     1892           define variable v-cntxt-userid        as character no-undo .
     1893           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1894                                             , OUTPUT v-cntxt-userid
     1895                                             ) .
     1896           run gbl/wndsizew.p
     1897             (input  v-cntxt-db-num
     1898             ,input  v-cntxt-userid
     1899             ,input  v-diasize-proc-name
     1900             ,input  'height':u
     1901             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1902             ) .
     1903         end.
     1904       end.
     1905     end.
     1906     assign
     1907       v-diasize-change-size = false
     1908     .
     1909   end procedure.
     1910   procedure diasize_set-height :
     1911     define input  parameter p-new-height  as decimal   no-undo .
     1912     define input  parameter p-move-resize as logical   no-undo .
     1913     do
     1914     on error undo, return error return-value
     1915     :
     1916       run diasize_change-height in this-procedure
     1917         (input  (p-new-height - frame Dialog-Frame :height)
     1918         ,input  p-move-resize
     1919         ) .
     1920     end.
     1921   end procedure.
     1922   procedure diasize_change-width :
     1923     define input  parameter p-change-value as decimal   no-undo .
     1924     define input  parameter p-move-resize  as logical   no-undo .
     1925     define variable v-field-group-handle   as handle    no-undo .
     1926     define variable v-object-handle        as handle    no-undo .
     1927     define variable v-frame-width          as decimal   no-undo .
     1928     define variable v-frame-virtual-width  as decimal   no-undo .
     1929     define variable v-browse-width         as decimal   no-undo .
     1930     define variable v-window-width         as decimal   no-undo .
     1931     define variable v-window-virtual-width as decimal   no-undo .
     1932     define variable v-change-sign          as integer   no-undo .
     1933     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1934     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1935     if p-change-value > 0
     1936     then do:
     1937       if frame Dialog-Frame :width + p-change-value >
     1938           session :width-chars
     1939       then do:
     1940         assign
     1941           p-change-value = session :width-chars - frame Dialog-Frame :width
     1942         .
     1943         if p-change-value <= 0
     1944         then do:
     1945           run diasize_position-resize-button in this-procedure .
     1946           return .
     1947         end.
     1948       end.
     1949     end.
     1950     if p-change-value < 0
     1951     then do:
     1952       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1953       then do:
     1954         assign
     1955           p-change-value = v-diasize-orig-frame-width
     1956                          - frame Dialog-Frame :width
     1957         .
     1958         if p-change-value >= 0
     1959         then do:
     1960           run diasize_position-resize-button in this-procedure .
     1961           return .
     1962         end.
     1963       end.
     1964     end.
     1965     if p-change-value >= 0
     1966     then do:
     1967       assign
     1968         v-change-sign = 1
     1969       .
     1970     end.
     1971     else do:
     1972       assign
     1973         v-change-sign = -1
     1974       .
     1975     end.
     1976     assign
     1977       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1978     .
     1979     if p-change-value = 0
     1980     then do:
     1981       run diasize_position-resize-button in this-procedure .
     1982       return .
     1983     end.
     1984     move_block:
     1985     do
     1986     on error undo move_block, leave move_block
     1987     :
     1988       if retry
     1989       then do:
     1990         do
     1991         on error undo move_block, leave move_block
     1992         :
     1993           if p-change-value > 0
     1994           then do:
     1995             for each buf_temp-diasize-handle
     1996             on error undo, next
     1997             :
     1998               assign
     1999                 v-object-handle = buf_temp-diasize-handle.handle-value
     2000               .
     2001               if v-object-handle <> v-diasize-resize-button
     2002               then do:
     2003                 assign
     2004                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2005                 .
     2006               end.
     2007             end.
     2008             assign
     2009               v-diasize-browse-handle :width = v-browse-width
     2010             .
     2011             for each buf_temp-browse-handle
     2012               where buf_temp-browse-handle.browse-type = 'width':u
     2013             on error undo, next
     2014             :
     2015               assign
     2016                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2017               .
     2018             end.
     2019             assign
     2020               frame Dialog-Frame :width = v-frame-width
     2021             .
     2022             if frame Dialog-Frame :scrollable = true
     2023             then do:
     2024               assign
     2025                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2026               .
     2027             end.
     2028             run diasize_position-resize-button in this-procedure .
     2029           end.
     2030           else do:
     2031             if frame Dialog-Frame :scrollable = true
     2032             then do:
     2033               assign
     2034                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2035               .
     2036             end.
     2037             assign
     2038               frame Dialog-Frame :width = v-frame-width
     2039             .
     2040             for each buf_temp-browse-handle
     2041               where buf_temp-browse-handle.browse-type = 'width':u
     2042             on error undo, next
     2043             :
     2044               assign
     2045                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2046               .
     2047             end.
     2048             assign
     2049               v-diasize-browse-handle :width = v-browse-width
     2050             .
     2051             for each buf_temp-diasize-handle
     2052             on error undo, next
     2053             :
     2054               assign
     2055                 v-object-handle = buf_temp-diasize-handle.handle-value
     2056               .
     2057               if v-object-handle <> v-diasize-resize-button
     2058               then do:
     2059                 assign
     2060                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2061                 .
     2062               end.
     2063             end.
     2064             run diasize_position-resize-button in this-procedure .
     2065           end.
     2066           assign
     2067             v-diasize-change-size = false
     2068           .
     2069           leave move_block .
     2070         end.
     2071       end.
     2072       assign
     2073         v-diasize-need-full-display = true
     2074       .
     2075       if v-diasize-change-size = false
     2076       then do:
     2077         assign
     2078           v-diasize-change-size = true
     2079         .
     2080       end.
     2081       else do:
     2082         return .
     2083       end.
     2084       assign
     2085         v-frame-width = frame Dialog-Frame :width
     2086         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2087         v-browse-width = v-diasize-browse-handle :width
     2088       .
     2089       for each buf_temp-browse-handle
     2090         where buf_temp-browse-handle.browse-type = 'width':u
     2091       :
     2092         assign
     2093           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2094         .
     2095       end.
     2096       for each buf_temp-diasize-handle
     2097       :
     2098         delete buf_temp-diasize-handle .
     2099       end.
     2100       assign
     2101         v-field-group-handle = frame Dialog-Frame :first-child
     2102       .
     2103       do while valid-handle(v-field-group-handle)
     2104       :
     2105         assign
     2106           v-object-handle = v-field-group-handle :first-child
     2107         .
     2108         do while valid-handle(v-object-handle)
     2109         :
     2110           if  v-object-handle <> v-diasize-browse-handle :handle
     2111           and v-object-handle <> v-diasize-resize-button
     2112           and can-query(v-object-handle, "row")
     2113           and can-query(v-object-handle, "height")
     2114           and ( v-object-handle :col + v-object-handle :width
     2115                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2116               )
     2117           then do:
     2118             find first buf_temp-browse-handle
     2119               where buf_temp-browse-handle.browse-type   = 'width':u
     2120                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2121               no-error .
     2122             if available buf_temp-browse-handle
     2123             then do:
     2124             end.
     2125             else do:
     2126               create buf_temp-diasize-handle .
     2127               assign
     2128                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2129                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2130               .
     2131             end.
     2132           end.
     2133           assign
     2134             v-object-handle = v-object-handle :next-sibling
     2135           .
     2136         end.
     2137         assign
     2138           v-field-group-handle = v-field-group-handle :next-sibling
     2139         .
     2140       end.
     2141       do with frame Dialog-Frame
     2142       :
     2143         hide v-diasize-resize-button .
     2144         v-diasize-resize-button :row = 1.
     2145         v-diasize-resize-button :column = 1.
     2146       end.
     2147       if p-change-value > 0
     2148       then do:
     2149         if frame Dialog-Frame :scrollable = true
     2150         then do:
     2151           assign
     2152             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2153             no-error .
     2154           if error-status :error
     2155           or error-status :get-message(1) <> ""
     2156           then do:
     2157             undo move_block, retry move_block.
     2158           end.
     2159         end.
     2160         assign
     2161           frame Dialog-Frame :width = v-frame-width + p-change-value
     2162           no-error .
     2163         if error-status :error
     2164         or error-status :get-message(1) <> ""
     2165         then do:
     2166           undo move_block, retry move_block.
     2167         end.
     2168         assign
     2169           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2170         no-error .
     2171         if error-status :error
     2172         or error-status :get-message(1) <> ""
     2173         then do:
     2174           undo move_block, retry move_block.
     2175         end.
     2176         for each buf_temp-browse-handle
     2177           where buf_temp-browse-handle.browse-type = 'width':u
     2178         on error undo move_block, retry move_block
     2179         :
     2180           assign
     2181             buf_temp-browse-handle.browse-handle :width
     2182               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2183             no-error .
     2184           if error-status :error
     2185           or error-status :get-message(1) <> ""
     2186           then do:
     2187             undo move_block, retry move_block .
     2188           end.
     2189         end.
     2190         for each buf_temp-diasize-handle
     2191         on error undo move_block, retry move_block
     2192         :
     2193           assign
     2194             v-object-handle = buf_temp-diasize-handle.handle-value
     2195           .
     2196           if v-object-handle <> v-diasize-resize-button
     2197           then do:
     2198             assign
     2199               v-object-handle :col = v-object-handle :col + p-change-value
     2200               no-error .
     2201             if error-status :error
     2202             or error-status :get-message(1) <> ""
     2203             then do:
     2204               undo move_block, retry move_block .
     2205             end.
     2206           end.
     2207         end.
     2208       end.
     2209       else do:
     2210         for each buf_temp-diasize-handle
     2211         on error undo move_block, retry move_block
     2212         :
     2213           assign
     2214             v-object-handle = buf_temp-diasize-handle.handle-value
     2215           .
     2216           if v-object-handle <> v-diasize-resize-button
     2217           then do:
     2218             assign
     2219               v-object-handle :col = v-object-handle :col + p-change-value
     2220               no-error .
     2221             if error-status :error
     2222             or error-status :get-message(1) <> ""
     2223             then do:
     2224               undo move_block, retry move_block .
     2225             end.
     2226           end.
     2227         end.
     2228         for each buf_temp-browse-handle
     2229           where buf_temp-browse-handle.browse-type = 'width':u
     2230         on error undo move_block, retry move_block
     2231         :
     2232           assign
     2233             buf_temp-browse-handle.browse-handle :width
     2234               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2235             no-error .
     2236           if error-status :error
     2237           or error-status :get-message(1) <> ""
     2238           then do:
     2239             undo move_block, retry move_block .
     2240           end.
     2241         end.
     2242         assign
     2243           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2244           no-error .
     2245         if error-status :error
     2246         or error-status :get-message(1) <> ""
     2247         then do:
     2248           undo move_block, retry move_block.
     2249         end.
     2250         assign
     2251           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2252         no-error .
     2253         if error-status :error
     2254         or error-status :get-message(1) <> ""
     2255         then do:
     2256           undo move_block, retry move_block.
     2257         end.
     2258         if frame Dialog-Frame :scrollable = true
     2259         then do:
     2260           assign
     2261             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2262           no-error .
     2263           if error-status :error
     2264           or error-status :get-message(1) <> ""
     2265           then do:
     2266             undo move_block, retry move_block.
     2267           end.
     2268         end.
     2269       end.
     2270       if p-move-resize
     2271       then do:
     2272         run diasize_position-resize-button in this-procedure .
     2273       end.
     2274       if v-diasize-wndstore = true
     2275       then do:
     2276         if connected("ub") = true
     2277         then do:
     2278           define variable v-cntxt-db-num        as integer   no-undo .
     2279           define variable v-cntxt-userid        as character no-undo .
     2280           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2281                                             , OUTPUT v-cntxt-userid
     2282                                             ) .
     2283           run gbl/wndsizew.p
     2284             (input  v-cntxt-db-num
     2285             ,input  v-cntxt-userid
     2286             ,input  v-diasize-proc-name
     2287             ,input  'width':u
     2288             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2289             ) .
     2290         end.
     2291       end.
     2292     end.
     2293     assign
     2294       v-diasize-change-size = false
     2295     .
     2296   end procedure.
     2297   procedure diasize_set-width :
     2298     define input  parameter p-new-width  as decimal   no-undo .
     2299     define input  parameter p-move-resize as logical   no-undo .
     2300     do
     2301     on error undo, return error return-value
     2302     :
     2303       run diasize_change-width in this-procedure
     2304         (input  (p-new-width - frame Dialog-Frame :width)
     2305         ,input  p-move-resize
     2306         ) .
     2307     end.
     2308   end procedure.
     2309   procedure diasize_position-resize-button :
     2310     do with frame Dialog-Frame
     2311     :
     2312       hide v-diasize-resize-button .
     2313       assign
     2314         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2315                     - 1
     2316                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2317         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2318                     - 1
     2319                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2320       .
     2321       view v-diasize-resize-button .
     2322     end.
     2323   end procedure.
     2324   on alt-right anywhere
     2325   do:
     2326     run diasize_change-width in this-procedure
     2327       (input 1
     2328       ,input true
     2329       ) .
     2330     return no-apply .
     2331   end.
     2332   on alt-left anywhere
     2333   do:
     2334     run diasize_change-width in this-procedure
     2335       (input -1
     2336       ,input true
     2337       ) .
     2338     return no-apply .
     2339   end.
     2340   on alt-down anywhere
     2341   do:
     2342     run diasize_change-height in this-procedure
     2343       (input 1
     2344       ,input true
     2345       ) .
     2346     return no-apply .
     2347   end.
     2348   on alt-up anywhere
     2349   do:
     2350     run diasize_change-height in this-procedure
     2351       (input -1
     2352       ,input true
     2353       ) .
     2354     return no-apply .
     2355   end.
     2356   on alt-enter of frame Dialog-Frame
     2357   do:
     2358     run diasize_maximize in this-procedure
     2359       (input  ?
     2360       ).
     2361     return no-apply .
     2362   end.
     2363   procedure diasize_end-move :
     2364     do
     2365     on error undo, return error return-value
     2366     :
     2367       define variable v-row-delta as decimal   no-undo .
     2368       define variable v-col-delta as decimal   no-undo .
     2369       define variable v-new-row as decimal   no-undo .
     2370       define variable v-new-col as decimal   no-undo .
     2371       assign
     2372         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2373         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2374       .
     2375       assign
     2376         v-row-delta = v-new-row - frame Dialog-Frame :height
     2377         v-col-delta = v-new-col - frame Dialog-Frame :width
     2378       .
     2379       run diasize_change-height in this-procedure
     2380         (input v-row-delta
     2381         ,input true
     2382         ) .
     2383       run diasize_change-width in this-procedure
     2384         (input v-col-delta
     2385         ,input true
     2386         ) .
     2387     end.
     2388   end procedure.
     2389   procedure diasize_maximize :
     2390     define input  parameter p-action as logical   no-undo .
     2391     do
     2392     on error undo, return error return-value
     2393     :
     2394       if p-action = ?
     2395       then do:
     2396         if v-diasize-need-maximize = true
     2397         then do:
     2398           assign
     2399             p-action = true
     2400           .
     2401         end.
     2402         else do:
     2403           assign
     2404             p-action = false
     2405           .
     2406         end.
     2407       end.
     2408       if p-action = true
     2409       then do:
     2410         run diasize_change-height in this-procedure
     2411           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2412               - frame Dialog-Frame :height-chars
     2413           ,input true
     2414           ) .
     2415         run diasize_change-width in this-procedure
     2416           (input session :width-chars
     2417               - frame Dialog-Frame :width-chars
     2418           ,input true
     2419           ) .
     2420         assign
     2421           v-diasize-need-maximize = false
     2422         .
     2423       end.
     2424       else do:
     2425         run diasize_change-width in this-procedure
     2426           (input v-diasize-orig-frame-width
     2427               - frame Dialog-Frame :width-chars
     2428           ,input true
     2429           ) .
     2430         run diasize_change-height in this-procedure
     2431           (input v-diasize-orig-frame-height
     2432               - frame Dialog-Frame :height-chars
     2433           ,input true
     2434           ) .
     2435         assign
     2436           v-diasize-need-maximize = true
     2437         .
     2438       end.
     2439     end.
     2440   end procedure.
     2441   procedure diasize_restore-orig-size :
     2442     do
     2443     on error undo, return error return-value
     2444     :
     2445       assign
     2446         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2447         v-diasize-current-frame-height = frame Dialog-Frame :height
     2448       .
     2449       run diasize_set-height in this-procedure
     2450         (input  v-diasize-orig-frame-height
     2451         ,input  true
     2452         ) .
     2453       run diasize_set-width in this-procedure
     2454         (input  v-diasize-orig-frame-width
     2455         ,input  true
     2456         ) .
     2457     end.
     2458   end procedure.
     2459   procedure diasize_restore-current-size :
     2460     do
     2461     on error undo, return error return-value
     2462     :
     2463       run diasize_set-height in this-procedure
     2464         (input  v-diasize-current-frame-height
     2465         ,input  true
     2466         ) .
     2467       run diasize_set-width in this-procedure
     2468         (input  v-diasize-current-frame-width
     2469         ,input  true
     2470         ) .
     2471     end.
     2472   end procedure.
     2473   procedure diasize_set-browse-handle :
     2474     define input  parameter p-browse-handle as handle   no-undo .
     2475     define buffer buf_temp-browse-handle for temp-browse-handle .
     2476     do
     2477     on error undo, return error return-value
     2478     :
     2479       assign
     2480         v-diasize-browse-handle = p-browse-handle
     2481       .
     2482       for each buf_temp-browse-handle
     2483       on error undo, return error return-value
     2484       :
     2485         delete buf_temp-browse-handle .
     2486       end.
     2487     end.
     2488   end procedure.
     2489   procedure diasize_add_browse :
     2490     define input  parameter p-browse-type   as character no-undo .
     2491     define input  parameter p-browse-handle as handle    no-undo .
     2492     define buffer buf_temp-browse-handle for temp-browse-handle .
     2493     do
     2494     on error undo, return error return-value
     2495     :
     2496       assign
     2497         v-diasize-browse-number = v-diasize-browse-number + 1
     2498       .
     2499       create buf_temp-browse-handle .
     2500       assign
     2501         buf_temp-browse-handle.browse-type   = p-browse-type
     2502         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2503         buf_temp-browse-handle.browse-handle = p-browse-handle
     2504       .
     2505     end.
     2506   end procedure.
     2507   procedure diasize_init :
     2508     define variable v-default-value    as logical   no-undo .
     2509     define variable v-restore-saved    as logical   no-undo .
     2510     define variable v-resize-value-str as character no-undo .
     2511     do
     2512     on error undo, return error return-value
     2513     :
     2514       do with frame Dialog-Frame
     2515       :
     2516         assign
     2517           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2518           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2519           v-diasize-browse-handle     = browse BROWSE-2 :handle
     2520         .
     2521         create button v-diasize-resize-button
     2522         assign
     2523           parent        = frame Dialog-Frame :first-child
     2524           label         = "s"
     2525           height-pixels = 16
     2526           width-pixels  = 16
     2527           visible       = true
     2528           sensitive     = true
     2529           movable       = true
     2530           triggers:
     2531             on end-move persistent run diasize_end-move in this-procedure .
     2532           end triggers.
     2533         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2534         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2535         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2536         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2537         assign
     2538           v-diasize-wndmax = false
     2539         .
     2540         if connected("ub") = true
     2541         then do:
     2542           define variable v-cntxt-db-num        as integer   no-undo .
     2543           define variable v-cntxt-userid        as character no-undo .
     2544           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2545                                             , OUTPUT v-cntxt-userid
     2546                                             ) .
     2547           run gbl/wndpar_r.p
     2548             (input  v-cntxt-db-num
     2549             ,input  v-cntxt-userid
     2550             ,input  'wndmax':U
     2551             ,output v-diasize-wndmax
     2552             ,output v-default-value
     2553             ) .
     2554         end.
     2555         assign
     2556           v-diasize-wndstore = false
     2557         .
     2558         if connected("ub") = true
     2559         then do:
     2560           run gbl/wndpar_r.p
     2561             (input  v-cntxt-db-num
     2562             ,input  v-cntxt-userid
     2563             ,input  'wndstore':U
     2564             ,output v-diasize-wndstore
     2565             ,output v-default-value
     2566             ) .
     2567         end.
     2568         assign
     2569           v-diasize-proc-name = entry(1, program-name(2), '.')
     2570         .
     2571         if v-diasize-wndstore = true
     2572         then do:
     2573           assign
     2574             v-restore-saved = false
     2575           .
     2576           if connected("ub") = true
     2577           then do:
     2578             run gbl/wndsizer.p
     2579               (input  v-cntxt-db-num
     2580               ,input  v-cntxt-userid
     2581               ,input  v-diasize-proc-name
     2582               ,input  'height':u
     2583               ,output v-resize-value-str
     2584               ) .
     2585             if v-resize-value-str <> '':U
     2586             then do:
     2587               run diasize_change-height in this-procedure
     2588                 (input  integer(v-resize-value-str)
     2589                 ,input  true
     2590                 ) .
     2591               assign
     2592                 v-restore-saved = true
     2593               .
     2594             end.
     2595           end.
     2596           if connected("ub") = true
     2597           then do:
     2598             run gbl/wndsizer.p
     2599               (input  v-cntxt-db-num
     2600               ,input  v-cntxt-userid
     2601               ,input  v-diasize-proc-name
     2602               ,input  'width':u
     2603               ,output v-resize-value-str
     2604               ) .
     2605             if v-resize-value-str <> '':U
     2606             then do:
     2607               run diasize_change-width in this-procedure
     2608                 (input  integer(v-resize-value-str)
     2609                 ,input  true
     2610                 ) .
     2611               assign
     2612                 v-restore-saved = true
     2613               .
     2614             end.
     2615           end.
     2616           if v-restore-saved <> true
     2617           then do:
     2618             if v-diasize-wndmax = true
     2619             then do:
     2620               run diasize_maximize in this-procedure
     2621                 (input  true
     2622                 ) .
     2623             end.
     2624           end.
     2625         end.
     2626         else do:
     2627           if v-diasize-wndmax = true
     2628           then do:
     2629             run diasize_maximize in this-procedure
     2630               (input  true
     2631               ) .
     2632           end.
     2633         end.
     2634       end.
     2635     end.
     2636   end procedure.
     2637   procedure diasize_need-full-display :
     2638     define output parameter p-need-full-display as logical   no-undo .
     2639     do
     2640     on error undo, return error return-value
     2641     :
     2642       assign
     2643         p-need-full-display = v-diasize-need-full-display
     2644       .
     2645       assign
     2646         v-diasize-need-full-display = false
     2647       .
     2648     end.
     2649   end procedure.
     2650   procedure get-context :
     2651      define output parameter p-db-num as integer          no-undo.
     2652      define output parameter p-user-id as character        no-undo.
     2653      define variable v-login               as character    no-undo.
     2654      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2655      define buffer buf_user-login  for ub.user-login .
     2656      do
     2657      on error undo, return error
     2658      :
     2659            FIND FIRST buf_sys-ctrl no-lock.
     2660            ASSIGN
     2661               v-login = USERID("ub")
     2662               p-db-num = buf_sys-ctrl.db-num
     2663            .
     2664            FIND FIRST buf_user-login
     2665                 WHERE buf_user-login.db-num = p-db-num
     2666                   AND buf_user-login.user-login = v-login
     2667                 no-lock
     2668                 no-error
     2669                 .
     2670            IF AVAILABLE buf_user-login
     2671            THEN DO:
     2672               assign
     2673                  p-user-id = buf_user-login.user-id
     2674               .
     2675            END.
     2676      end.
     2677   end procedure.
     2678       run diasize_init in this-procedure .
     2679   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2680     run mainmenu_getcntxt in p-mainmenu-handle
     2681       (output v-cntxt-db-num
     2682       ,output v-cntxt-userid
     2683       ,output v-cntxt-level
     2684       ,output v-cntxt-host-code-obj
     2685       ,output v-cntxt-obj-type
     2686       ,output v-cntxt-obj-code
     2687       ,output v-cntxt-db-num-obj
     2688       ,output v-cntxt-is-admin
     2689       ) .
     2690       run get-report-num in p-mainmenu-handle (
     2691           output g#report-num
     2692       ).
     2693       run get-quest-print in p-mainmenu-handle (
     2694           output g#quest-print
     2695       ).
     2696       find first buf_init_fbr-pln no-lock
     2697           where recid(buf_init_fbr-pln) = rec_id
     2698       .
     2699       if valid-handle(active-window)
     2700       and frame Dialog-Frame:parent eq ?
     2701       then do:
     2702           assign
     2703               FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW
     2704           .
     2705       end.
     2706       assign
     2707           v-printer-name = session:printer-name
     2708       .
     2709       run load-menu in this-procedure (
     2710             input buf_init_fbr-pln.doc-code
     2711           , input buf_init_fbr-pln.doc-type
     2712           , input buf_init_fbr-pln.status_
     2713           , input "'*'"
     2714           , input "'*'"
     2715       ).
     2716   MAIN-BLOCK:
     2717   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2718      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2719       RUN enable_UI.
     2720       Tmp#List.last-use      :read-only in browse BROWSE-2 =  true .
     2721           ASSIGN frame Dialog-Frame:TITLE =  "Печать документа  "
     2722       + " Тип: " + buf_init_fbr-pln.doc-type
     2723       + " Статус: " + buf_init_fbr-pln.status_
     2724       + "  № "  + buf_init_fbr-pln.doc-code.
     2725       WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-2.
     2726   END.
     2727   RUN disable_UI.
     2728   PROCEDURE disable_UI :
     2729     HIDE FRAME Dialog-Frame.
     2730   END PROCEDURE.
     2731   PROCEDURE enable_UI :
     2732     DISPLAY v-printer-name
     2733         WITH FRAME Dialog-Frame.
     2734     ENABLE b-exit b-mark b-erase b-print b-help BROWSE-2 v-printer-name
     2735         WITH FRAME Dialog-Frame.
     2736     VIEW FRAME Dialog-Frame.
     2737     OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.cli-code.
     2738   END PROCEDURE.
     2739   PROCEDURE Load-menu :
     2740   define input parameter p-doc-code   as character        no-undo.
     2741   define input parameter xtype        as character        no-undo.
     2742   define input parameter xstatus      as character        no-undo.
     2743   define input parameter xInternal    as character        no-undo.
     2744   define input parameter xflag        as character        no-undo.
     2745       define buffer buf_usr-flt for ubflt.usr-flt .
     2746   do
     2747   for buf_usr-flt
     2748   on error undo, return error
     2749   :
     2750   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2751   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2752     (output v-menu-doc-sys-key
     2753     ) no-error .
     2754       assign
     2755           v-menu-doc-doc-code = p-doc-code
     2756           v-menu-doc-doc-type = xtype
     2757           v-menu-doc-status_  = xstatus
     2758           v-menu-doc-internal = xInternal
     2759           v-menu-doc-flag     = xflag
     2760           sys-key             = v-menu-doc-sys-key
     2761       .
     2762   define variable vss-include-info20 as character format "X(65)" no-undo
     2763   initial "@(#)$Workfile$ $Revision$".
     2764   define variable vss-include-info21 as character format "X(65)" no-undo
