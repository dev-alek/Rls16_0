      146   procedure create_obj-list :
      147      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      148      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      149      do
      150      on error undo, return error return-value
      151      :
      152         define buffer cli-obj for ub.clients .
      153         define variable p-var as integer no-undo .
      154         define buffer buf_obj-list for obj-list .
      155         find last buf_obj-list  use-index pi no-error .
      156         if available buf_obj-list
      157         then
      158            p-var = buf_obj-list.obj-id + 1.
      159         else
      160            p-var = 1.
      161         find first cli-obj where
      162                   cli-obj.obj-type = p-obj-type
      163               and cli-obj.obj-code = p-obj-code
      164         no-lock no-error.
      165         if available cli-obj
      166         then do:
      167            create buf_obj-list.
      168            assign
      169               buf_obj-list.obj-id   = p-var
      170               buf_obj-list.obj-code = cli-obj.obj-code
      171               buf_obj-list.obj-type = cli-obj.obj-type
      172               buf_obj-list.obj-name = cli-obj.obj-name
      173               buf_obj-list.db-num   = cli-obj.db-num
      174            .
      175         end.
      176      end.
      177   end.
