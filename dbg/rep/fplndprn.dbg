     2915              , input 'Нехватка продуктов'
     2916              , input 'cost,sale,rubl,base'
     2917              , input 'rep/r-res3.p'
     2918              , input ''
     2919              , input '------'
     2920              , input ''
     2921              , input 'A4port'
     2922              , input ''
     2923           ).
     2924       find first buf_usr-flt no-lock
     2925            where buf_usr-flt.user-name  = v-cntxt-userid
     2926              and buf_usr-flt.call-point = string(buf_init_fbr-pln.doc-type) + ",no,"
     2927                                       + string(buf_init_fbr-pln.status_ ) + ",no"
     2928       no-error.
     2929       if available buf_usr-flt
     2930       then do:
     2931           assign
     2932               list_        = buf_usr-flt.list_
     2933           .
     2934       end.
     2935       else do:
     2936           create buf_usr-flt.
     2937           assign
     2938               buf_usr-flt.user-name    = v-cntxt-userid
     2939               buf_usr-flt.call-point   = string( buf_init_fbr-pln.doc-type) + ",no," +
     2940                                   string(  buf_init_fbr-pln.status_ ) + ",no"
     2941           .
     2942       end.
     2943   end.
     2944   END PROCEDURE.
