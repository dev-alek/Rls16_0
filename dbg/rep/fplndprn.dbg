     2904   define variable vss-include-info28 as character format "X(65)" no-undo
     2905   initial "@(#)$Workfile$ $Revision$".
     2906           run menu-doc-create-menu-item in this-procedure
     2907             ( input xtype
     2908              , input xstatus
