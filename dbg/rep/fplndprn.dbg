      586   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      588   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
