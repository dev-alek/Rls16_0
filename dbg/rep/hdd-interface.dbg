      188             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      189             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      190             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      191             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
