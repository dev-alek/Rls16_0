      207   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      208   define  stream PrnLibStream.
      209   procedure prn-lib-prn-file :
      210     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      211     define input parameter p-DIsabledoptions as integer no-undo .
      212     define variable v-report-name as character no-undo .
      213     define variable v-user-action as character no-undo .
      214     define variable v-printed     as logical   no-undo .
      215     define variable v-exist       as logical   no-undo .
      216     do
      217       on error undo, return error
      218       :
      219       run prn-lib-get-report-name  in this-procedure (
      220         input parParentProc
      221         ,output v-report-name
      222         ).
      223   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      225     (input  v-report-name
      226     ,input  2
      227     ,output v-exist
      228     )  .
      229       if NOT v-exist then
      230       DO:
      231         Message
      232           "Нет заданий на печать ! "
      233           view-as alert-box .
      234         Return  .
      235       End.
      236       run gbl/prnfilen.w
      237         (input  ""
      238         ,input  p-DisabledOptions
      239         ,input  string(v-report-name )
      240         ,input  7
      241         ,output v-user-action
      242         ,output v-printed
      243         ) .
      244       if v-printed then
      245       do:
      246         return "YES" .
      247       end.
      248       else
      249       do:
      250         return "NO" .
      251       end.
      252     end.
      253   end procedure.
      254   procedure prn-lib-open-stream :
      255     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      256     define input parameter p-page-size    as integer no-undo .
      257     define input parameter p-is-stream    as logical no-undo .
      258     define input parameter p-append       as logical no-undo .
      259     define variable v-report-name as character no-undo .
      260     do
      261       on error undo, return error
      262       :
      263       run prn-lib-get-report-name  in this-procedure (
      264         input parParentProc
      265         ,output v-report-name
      266         ).
      267       if p-is-stream then
      268       do:
      269         if p-append then
      270         do:
      271           output stream PrnLibStream to value( v-report-name )
      272             page-size value(p-page-size) append .
      273         end.
      274         if not p-append then
      275         do:
      276           output stream PrnLibStream to value( v-report-name )
      277             page-size value(p-page-size) .
      278         end.
      279       end.
      280       if not p-is-stream then
      281       do:
      282         if p-append then
      283         do:
      284           output to value( v-report-name )
      285             page-size value(p-page-size) append .
      286         end.
      287         if not p-append then
      288         do:
      289           output to value( v-report-name )
      290             page-size value(p-page-size) .
      291         end.
      292       end.
      293     end.
      294   end procedure.
      295   procedure prn-lib-open-exp :
      296     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      297     define input parameter p-is-stream    as logical no-undo .
      298     define input parameter p-is-append    as logical no-undo .
      299     define output parameter p-ReportFileName as char init "report" no-undo.
      300     define output parameter p-process as logical no-undo .
      301     define variable glog as logical no-undo .
      302     do
      303       on error undo, return error
      304       :
      305       SYSTEM-DIALOG GET-FILE p-ReportFileName
      306         TITLE      "Укажите путь"
      307         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      308         ASK-OVERWRITE
      309         CREATE-TEST-FILE
      310         SAVE-AS
      311         USE-FILENAME
      312         DEFAULT-EXTENSION "txt"
      313         UPDATE glog
      314         .
      315       if not glog then  return.
      316       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      317       if p-is-stream then
      318       do:
      319         if p-is-append then
      320         do:
      321           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      322         end.
      323         else
      324         do:
      325           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      326         end.
      327       end.
      328       else
      329       do:
      330         if p-is-append then
      331         do:
      332           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      333         end.
      334         else
      335         do:
      336           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      337         end.
      338       end.
      339       p-process = yes.
      340     end.
      341   end procedure.
      342   procedure prn-lib-get-report-name :
      343     define input parameter parParentProc  as widget-handle no-undo.
      344     define output parameter p-report-name as character no-undo .
      345     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      346   end procedure.
      347   procedure prn-lib-reportviewer-report-name :
      348     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      349     define input parameter p-report-name-html as character no-undo .
      350     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      351   end procedure.
      352   procedure prn-lib-reportviewer :
      353     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      354     define input parameter p-report-name-html as character no-undo .
      355     define input parameter p-param        as character no-undo .
      356     define variable v-excel           as character no-undo init 'TRUE' .
      357     define variable v-value-character as character no-undo .
      358     define variable v-value-integer   as character no-undo .
      359     define variable v-value-date      as date      no-undo .
      360     define variable v-value-decimal   as decimal   no-undo .
      361     define variable rep-excel         as logical   no-undo .
      362     define variable excel-string      as character no-undo .
      363     define variable v-param-type      as character no-undo .
      364     define variable v-tth             as handle    no-undo .
      365     run adm/shattri.p (
      366       input "get":U
      367       ,input  ""
      368       ,input  0
      369       ,input  'report-glob':U
      370       ,input  'rep-excel':U
      371       ,output v-value-character
      372       ,output v-value-date
      373       ,output v-value-decimal
      374       ,output v-value-integer
      375       ,output rep-excel
      376       ,output v-param-type
      377       ,INPUT-OUTPUT table-handle v-tth
      378       )  .
      379     if rep-excel then v-excel = "TRUE" .
      380     else v-excel = "FALSE" .
      381     if p-param eq ""
      382     then
      383        p-param = "EXCEL:" + v-excel.
      384     else
      385        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      386     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      387   end procedure.
      388   function fnc-convert-dot-to-colon returns character
      389       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      390   function fnc-convert-dot-to-colon returns character
      391   (input p-data as decimal, input p-accur as character, input p-num as integer):
      392       define variable result as character no-undo.
      393       define variable v-str-result as character no-undo.
      394       if p-data = ? then p-data = 0 .
      395       p-data = round(p-data, p-num).
      396       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      397       return v-str-result.
      398   END FUNCTION.
      399   define temp-table tt-devicePC no-undo
      400     field id          as integer
      401     field modeldevice like ub.devisPC.modeldevice
      402     field ModelPC     like ub.devisPC.ModelPC
      403     field namepc      like ub.devisPC.namepc
      404     field date_       as date
      405     field time_       as character
      406     field time_int    as integer
      407     field ProcDisk    as decimal
      408     field UserProc    as decimal
      409     field status_     as character
      410     field db-num      as integer
      411     index pi id date_ time_int db-num.
      412   define temp-table tt-devicePCAttr no-undo
      413     field id        as integer
      414     field name_     as character
      415     field value_    as decimal
      416     field tresh     as decimal
      417     field type_     as character
      418     field raw_value as character
      419     field date_     as date
      420     field time_     as integer
      421     field db-num    as integer
      422     index pi id db-num date_ time_
      423     .
      424   define buffer buf_devisPC      for ub.devisPC .
      425   define buffer buf_devisPCAttr  for ub.devisPC-attr .
      426   define buffer bf_devisPCAttr   for ub.devisPC-attr .
      427   define buffer bt_devisPCAttr   for ub.devisPC-attr .
      428   define buffer buf_devisPC-attr for ub.devisPC-attr .
      429   define variable v-ProcDisk   as decimal   no-undo .
      430   define variable v-UserDisk   as decimal   no-undo .
      431   define variable v-TestStatus as character no-undo .
      432   define variable v-Date       as decimal   no-undo .
      433   define stream Out-Stream.
      434   define stream OutStr-html.
      435   define VARIABLE p-report-id         as character no-undo .
      436   define variable v-file-name-rep-htm as character no-undo .
      437   define variable ii                  as integer   no-undo .
      438   define variable v-TimeST            as character no-undo .
      439   define variable v-TimeST1           as character no-undo .
      440   define variable v-TimeST-attr       as character no-undo .
      441   define variable v-TimeST1-attr      as character no-undo .
      442   define variable v-titul             as character no-undo .
      443   define variable v-color             as character no-undo .
      444   do
      445     on error undo, return error return-value
      446     :
      447     if p-db-list = "" then p-db-list = string(v-cntxp-db-num) .
      448     do ii = 1 to num-entries (p-db-list, chr(44)):
      449       for each buf_devisPC no-lock where buf_devisPC.DB-num = integer(entry(ii, p-db-list, chr(44))):
      450         if buf_devisPC.namepc begins p-namePk and buf_devisPC.modeldevice begins p-ModelDisk then
      451         do:
      452           next_:
      453           for each buf_devisPCAttr no-lock where buf_devisPCAttr.id = buf_devisPC.id and buf_devisPCAttr.db-num = buf_devisPC.db-num and buf_devisPCAttr.date >= p-Date:
      454             if buf_devisPCAttr.time_ < p-Time then next next_.
      455             if buf_devisPCAttr.time_ > p-Time-end then next next_.
      456             if buf_devisPCattr.attr-code ="ProcDisk" or buf_devisPCattr.attr-code = "UserProc" or buf_devisPCattr.attr-code = "testStatus" then
      457             do:
      458               v-ProcDisk = 0 .
      459               v-UserDisk = 0 .
      460               v-TestStatus = "" .
      461               if buf_devisPCAttr.attr-code = "ProcDisk" then
      462               do:
      463                 v-ProcDisk = decimal(entry(1,buf_devisPCAttr.attr-value,"%")) .
      464               end.
      465               if buf_devisPCAttr.attr-code = "UserProc" then
      466               do:
      467                 v-UserDisk = decimal(entry(1,buf_devisPCAttr.attr-value,"%")) .
      468               end.
      469               if buf_devisPCAttr.attr-code = "TestStatus" then
      470               do:
      471                 v-TestStatus = buf_devisPCAttr.attr-value .
      472               end.
      473               find first tt-devicePC exclusive-lock where tt-devicePC.id = buf_devisPC.id and tt-devicePC.modeldevice = buf_devisPC.modeldevice
      474                 and tt-devicePC.ModelPC     = buf_devisPC.ModelPC and
      475                 tt-devicePC.namepc      = buf_devisPC.namepc and
      476                 tt-devicePC.date_       = buf_devisPCAttr.date and
      477                 tt-devicePC.db-num      = buf_devisPC.DB-num and
      478                 tt-devicePC.time_int  = buf_devisPCAttr.time_
      479                 no-error .
      480               if not available (tt-devicePC) then
      481               do:
      482                 create tt-devicePC .
      483                 assign
      484                   tt-devicePC.id          = buf_devisPC.id
      485                   tt-devicePC.modeldevice = buf_devisPC.modeldevice
      486                   tt-devicePC.ModelPC     = buf_devisPC.ModelPC
      487                   tt-devicePC.namepc      = buf_devisPC.namepc
      488                   tt-devicePC.date_       = buf_devisPCAttr.date
      489                   tt-devicePC.time_int    = buf_devisPCAttr.time_
      490                   tt-devicePC.db-num      = buf_devisPC.DB-num
      491                   tt-devicePC.time_       = string(truncate (buf_devisPCattr.time_ / 3600, 0)) + ":" + string((buf_devisPCattr.time_ modulo 3600) / 60,"99") + ":" + string((buf_devisPCattr.time_ modulo 3600) / 360,"99")
      492                   .
      493               end.
      494               if v-ProcDisk <> 0 then tt-devicePC.ProcDisk    = v-ProcDisk .
      495               if v-UserDisk <> 0 then tt-devicePC.UserProc    = v-UserDisk .
      496               if v-TestStatus <> "" then tt-devicePC.status_  = v-TestStatus .
      497             end.
      498             else
      499             do:
      500               find first tt-devicePCAttr where           tt-devicePCAttr.id        = buf_devisPCattr.id and
      501                 tt-devicePCAttr.name_     = buf_devisPCattr.attr-code and
      502                 tt-devicePCAttr.raw_value = buf_devisPCattr.attr-Raw-value and
      503                 tt-devicePCAttr.tresh     = decimal(buf_devisPCattr.tresh) and
      504                 tt-devicePCAttr.value_    = decimal(buf_devisPCattr.attr-value) and
      505                 tt-devicePCAttr.type_     = buf_devisPCattr.type and
      506                 tt-devicePCAttr.date_     = buf_devisPCattr.date and
      507                 tt-devicePCAttr.db-num    = buf_devisPC.DB-num and
      508                 tt-devicePCAttr.time_     = buf_devisPCattr.time_ no-error .
      509               if not available (tt-devicePCAttr) then
      510               do:
      511                 create tt-devicePCAttr .
      512                 assign
      513                   tt-devicePCAttr.id        = buf_devisPCattr.id
      514                   tt-devicePCAttr.name_     = buf_devisPCattr.attr-code
      515                   tt-devicePCAttr.raw_value = buf_devisPCattr.attr-Raw-value
      516                   tt-devicePCAttr.tresh     = decimal(buf_devisPCattr.tresh)
      517                   tt-devicePCAttr.value_    = decimal(buf_devisPCattr.attr-value)
      518                   tt-devicePCAttr.type_     = buf_devisPCattr.type
      519                   tt-devicePCAttr.db-num    = buf_devisPC.DB-num
      520                   tt-devicePCAttr.date_     = buf_devisPCattr.date
      521                   tt-devicePCAttr.time_     = buf_devisPCattr.time_
      522                   .
      523               end.
      524             end.
      525           end.
      526         end.
      527       end.
      528     end.
      529     if p-ProcDisk > 0 then
      530     do:
      531       for each tt-devicePC exclusive-lock where tt-devicePC.ProcDisk < p-ProcDisk:
      532         delete tt-devicePC .
      533       end.
      534     end.
      535     if p-UserDisk > 0 then
      536     do:
      537       for each tt-devicePC exclusive-lock where tt-devicePC.UserProc < p-UserDisk:
      538         delete tt-devicePC .
      539       end.
      540     end.
      541       case p-status:
      542       when 0 then
      543       do:
      544           for each tt-devicePC exclusive-lock where tt-devicePC.status_ <> "Пройдена":
      545             delete tt-devicePC .
      546           end.
      547       end.
      548       when 1 then
      549         do:
      550           for each tt-devicePC exclusive-lock where tt-devicePC.status_ <> "Не пройдена":
      551             delete tt-devicePC .
      552           end.
      553       end.
      554       when 2 then do:
      555           for each tt-devicePC exclusive-lock where tt-devicePC.status_ = "Пройдена" or tt-devicePC.status_ = "Не пройдена":
      556             delete tt-devicePC .
      557           end.
      558         end.
      559       end case .
      560     if p-ValueDisk > 0 then
      561     do:
      562       for each tt-devicePCAttr where tt-devicePCAttr.value_ < p-ValueDisk:
      563         delete tt-devicePCAttr .
      564       end.
      565     end.
      566     if p-TreshDisk > 0 then
      567     do:
      568       for each tt-devicePCAttr where tt-devicePCAttr.tresh < p-TreshDisk:
      569         delete tt-devicePCAttr .
      570       end.
      571     end.
      572     if p-Delta > 0 then
      573     do:
      574       for each tt-devicePCAttr where abs(tt-devicePCAttr.value_ - tt-devicePCAttr.tresh) > p-Delta:
      575         delete tt-devicePCAttr .
      576       end.
      577     end.
      578     for each tt-devicePC:
      579       find first tt-devicePCAttr where tt-devicePCAttr.id = tt-devicePC.id and tt-devicePCAttr.db-num = tt-devicePC.db-num and tt-devicePCAttr.date_ = tt-devicePC.date_ and tt-devicePCAttr.time_ = tt-devicePC.time_int no-error .
      580       if not available (tt-devicePCAttr) then
      581       do:
      582         if tt-devicePC.status_ = "не закончена" then do:
      583           create tt-devicePCAttr.
      584           assign
      585           tt-devicePCAttr.date_ = tt-devicePC.date_
      586           tt-devicePCAttr.time_ = tt-devicePC.time_int
      587           tt-devicePCAttr.db-num  = tt-devicePC.db-num
      588           tt-devicePCAttr.id = tt-devicePC.id
      589           .
      590         end.
      591         else do:
      592         delete tt-devicePC .
      593         end.
      594       end.
      595     end.
      596     run get-report-num (output p-report-id).
      597     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
      598     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      599     put stream OutStr-html unformatted
      600       "<!DOCTYPE HTML>" skip
      601       ' <html>' skip
      602       '  <head>' skip
      603       '   <meta charset="utf-8">' skip
      604       '    <style type="text/css">' skip
      605       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      606       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      607       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      608       '   </style>' skip
      609       '  </head>' skip
      610       .
      611     put stream OutStr-html unformatted
      612       '<body>' skip
      613       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
      614       '<thead>' skip
      615       .
      616     put stream OutStr-html unformatted
      617       '<tr>' skip
      618       '<td style="width: 50px;"></td>' skip
      619       '<td style="width: 70px;"></td>' skip
      620       '<td style="width: 70px;"></td>' skip
      621       '<td style="width: 70px;"></td>' skip
      622       '<td style="width: 70px;"></td>' skip
      623       '<td style="width: 70px;"></td>' skip
      624       '<td style="width: 60px;"></td>' skip
      625       '<td style="width: 60px;"></td>' skip
      626       '<td style="width: 80px;"></td>' skip
      627       '<td style="width: 170px;"></td>' skip
      628       '<td style="width: 50px;"></td>' skip
      629       '<td style="width: 50px;"></td>' skip
      630       '<td style="width: 70px;"></td>' skip
      631       '<td style="width: 70px;"></td>' skip
      632       '</tr>' skip
      633       '<tr><td colspan="14" style="text-align: center;">Результаты проверки HDD</td></tr>'
      634       .
      635     put stream OutStr-html unformatted
      636       '<TR><TD colspan="14"></TD></TR>' skip
      637       '</thead>' skip
      638       '<tbody>' skip
      639       .
      640     put stream OutStr-html unformatted
      641       '<TR>' skip
      642       '<TD text_wrap="true" rowspan="2" style="text-align: center;">АЗК</TD>' skip
      643       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Дата теста</TD>' skip
      644       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Время теста</TD>' skip
      645       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Имя ПК</TD>' skip
      646       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Модель ПК</TD>' skip
      647       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Модель диска</TD>' skip
      648       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Процент заполнения</TD>' skip
      649       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Использование системного раздела</TD>' skip
      650       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Статус проверки</TD>' skip
      651       '<TD text_wrap="true" colspan="5" style="text-align: center;">Атрибуты диска</TD>' skip
      652       '</TR>' skip .
      653     put stream OutStr-html unformatted
      654       '<TR>' skip
      655       '<TD text_wrap="true" style="text-align: center;">Название</TD>' skip
      656       '<TD text_wrap="true" style="text-align: center;">Value</TD>' skip
      657       '<TD text_wrap="true" style="text-align: center;">Thresh</TD>' skip
      658       '<TD text_wrap="true" style="text-align: center;">Тип</TD>' skip
      659       '<TD text_wrap="true" style="text-align: center;">Raw_value</TD>' skip
      660       '</TR>'skip
      661       .
      662     for each tt-devicePC:
      663       if tt-devicePC.ProcDisk = 100 or tt-devicePC.UserProc = 100 or tt-devicePC.status_ <> "Пройдена" then v-color = "red" .
      664       else v-color = "white" .
      665       put stream OutStr-html unformatted
      666         '<TR>' skip
      667         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string(tt-devicePC.db-num) + '</TD>' skip
      668         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string(tt-devicePC.date_) + '</TD>' skip
      669         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string(tt-devicePC.time_) + '</TD>' skip
      670         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePC.namepc) + '</TD>' skip
      671         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePC.ModelPC) + '</TD>' skip
      672         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePC.modeldevice) + '</TD>' skip
      673         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePC.ProcDisk) + '</TD>' skip
      674         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePC.UserProc) + '</TD>' skip
      675         '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePC.status_) + '</TD>' skip
      676         .
      677       for each tt-devicePCAttr no-lock where tt-devicePCAttr.id = tt-devicePC.id and tt-devicePCAttr.db-num = tt-devicePC.db-num and tt-devicePCAttr.date_ = tt-devicePC.date_
      678       and tt-devicePCAttr.time_ = tt-devicePC.time_int break by tt-devicePCAttr.id :
      679         if tt-devicePCAttr.value_ <= tt-devicePCAttr.tresh then v-color = "red" .
      680         else v-color = "white" .
      681         if first-of (tt-devicePCAttr.id ) then
      682         do:
      683           put stream OutStr-html unformatted
      684             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.name_) + '</TD>' skip
      685             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.value_) + '</TD>' skip
      686             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.tresh) + '</TD>' skip
      687             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.type_) + '</TD>' skip
      688             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.raw_value) + '</TD>' skip
      689             '</tr>'
      690             .
      691         end.
      692         else
      693         do:
      694           put stream OutStr-html unformatted
      695             '<TR>' skip
      696             '<TD text_wrap="true" colspan="9" style="text-align: center;"></TD>' skip
      697             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.name_) + '</TD>' skip
      698             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.value_) + '</TD>' skip
      699             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.tresh) + '</TD>' skip
      700             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.type_) + '</TD>' skip
      701             '<TD text_wrap="true" style="text-align: center; background-color:' + v-color + ';">' + string (tt-devicePCAttr.raw_value) + '</TD>' skip
      702             '</tr>'
      703             .
      704         end.
      705       end.
      706     end.
      707     put stream OutStr-html unformatted
      708       '</tbody>' skip
      709       '<tfoot>' skip.
      710     put stream OutStr-html unformatted
      711       '</tfoot>' skip
      712       '</table>' skip
      713       '</body>' skip
      714       '</html>' skip
      715       .
      716     output stream OutStr-html close.
      717     run prn-lib-reportviewer-report-name in this-procedure (
      718       input THIS-PROCEDURE
      719       ,input v-file-name-rep-htm
      720       ).
      721   end.
      722   PROCEDURE get-report-num :
      723     define output parameter p-report-num as integer no-undo .
      724     do
      725       on error undo, return error return-value
      726       :
      727       run gbl/getrpnum.p (output p-report-num).
      728     end.
      729   END PROCEDURE.
