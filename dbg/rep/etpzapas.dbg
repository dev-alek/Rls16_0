     1145       ,output g#log
     1146       )  .
     1147   end.
     1148    if not g#log then v-kol = v-kol + 1.
     1149   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1150   do:
     1151     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1152       (input  v-cntxt-db-num
     1153       ,input  v-cntxt-userid
     1154       ,input  0
     1155       ,input  'actn_reports_lookup-crsa':U
     1156       ,input  'object':U
     1157       ,input  v-cntxt-host-code-obj
     1158       ,input  v-cntxt-obj-type
     1159       ,input  v-cntxt-obj-code
     1160       ,input  0
     1161       ,input  0
     1162       ,input  0
     1163       ,input  false
     1164       ,output g#log
     1165       )  .
     1166   end.
     1167    if not g#log then v-kol = v-kol + 1.
     1168   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1169   do:
     1170     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1171       (input  v-cntxt-db-num
     1172       ,input  v-cntxt-userid
     1173       ,input  0
     1174       ,input  'actn_reports_lookup-sale':U
     1175       ,input  'object':U
