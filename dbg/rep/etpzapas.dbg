     1198       WHEN "prod/grp-goods":U THEN
     1199            run rep/tpzapas4.p ( input type-pr:screen-value , input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type,input base-code,input Classify,input SortType,input SumsOnly,input ShowZero).
     1200       WHEN "grp-goods/prod":U THEN
     1201            run rep/tpzapas5.p ( input type-pr:screen-value , input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type,input base-code,input Classify,input SortType,input SumsOnly,input ShowZero).
     1202    End case.
     1203   END PROCEDURE.
     1204   PROCEDURE my-var :
     1205   assign frame F-Main SumsOnly ShowZero  Classify SortType.
     1206   def var t-class as char no-undo.
     1207   def var t-sort as char no-undo.
     1208     case classify:
     1209       when "no-classify":u    then t-class =   "Без классификации" .
     1210       when "prod":u           then t-class =   "Производители"   .
     1211       when "post":u           then t-class =   "Поставщики"   .
     1212       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1213       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1214       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1215       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1216       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1217       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1218       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1219       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1220       when  "t-level":u       then t-class =   "Терминальные группы" .
     1221    end case.
     1222     case sorttype:
     1223       when "sort-pp":u               then t-sort =   "по порядку" .
     1224       when "sort-code":u             then t-sort =   "по коду" .
     1225       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1226       when "sort-qunty":u            then t-sort =   "по реализации".
     1227       when "sort-name":u             then t-sort =   "по наименованию".
     1228       when "sort-type":u             then t-sort =   "по типу ткани".
     1229       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1230       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1231    end case.
     1232   x-date-end = x-date-alone.
     1233   ReportNAme = "С О С Т О Я Н И Е   З А П А С А   П О Т И П У   П Р И О Б Р Е Т Е Н И Я  -   "
     1234   + Caps ( entry( (lookup(type-pr:screen-value ,type-pr:RADIO-BUTTONS) - 1), type-pr:RADIO-BUTTONS )   )
     1235   .
     1236   ReportHeader = "Классификация : " + t-class + chr(10) +
     1237                  (if SumsOnly then "Только итоги "  else " " )  +  chr(10) +
     1238                 "Сортировка " + t-sort  + chr(10) +
     1239                  (if ShowZero then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) .
     1240   if type-pr:screen-value = "all" then ReportHeader =  ReportHeader
     1241   .
     1242     if X-SET_PAY_TYPE <> 2 then str3 =  "в ценах РЕАЛИЗАЦИИ".
     1243    sheetf.Excel-Column-Lable =
     1244             "Код"
     1245     + ","  + "Артикул"
     1246     + ","  + "Название товара"
     1247     + ","  + "Тип"
     1248     + ","  + "Ед. изм"
     1249     + ","  + "Количество"
     1250     + ","  + "Цена"
     1251     + ","  + "Стоимость"
     1252     + ","  + "НДС"
     1253     + ","  + "НП"
     1254     + ","  + "Цена без НДС"
     1255     + ","  + "Сумма без НДС".
     1256    sheetf.Sizes        =  "10,16,40,6,5,15,15,15,15,15,15,15"                      .
     1257    sheetf.make-correct = ""
     1258    .
     1259    sheetf.ColFormat = "2=@;3=@;" .
     1260   END PROCEDURE.
     1261   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1262   procedure cr-ob :
     1263    do
     1264    on error undo, return error return-value
     1265    :
     1266   define input parameter p-x as integer no-undo .
     1267   define input parameter p-y as integer no-undo .
     1268   define input parameter type-pr-name as character no-undo .
     1269   define input parameter type-pr-val  as character no-undo .
     1270   define variable l-str as character no-undo .
     1271   define variable i as integer no-undo .
     1272   if type-pr-name = ? then type-pr-name = 'Все,Выкуп,Консигнаци,Консигнация закупка,Консигнация выгода,Ответственное хранение,Старая консигнация':L .
     1273   if type-pr-val  = ?then type-pr-val  = 'all,r,cb,c,b,s,1':U .
     1274   repeat i = 1 to num-entries(type-pr-name) :
     1275    l-str =  l-str  + entry(i ,type-pr-name) + ","  +
     1276                      entry(i ,type-pr-val)  + "," .
     1277   end.
     1278   l-str = substring(l-str,1 , LENGTH (l-str) - 1) .
     1279   if num-entries(l-str) < 2 then do:
     1280       message "Нет архивов по типу приобретения !!!" skip
     1281       vss-include-info16 skip
     1282       view-as alert-box information .
     1283       return 'First-page':U.
     1284      end.
     1285      create radio-set type-pr
     1286      assign
     1287       row    = p-y
     1288       column = p-x
     1289       frame  = frame F-Main:handle
     1290       horizontal    = false
     1291       radio-buttons = l-str
     1292    .
     1293   if valid-handle(type-pr) = false then do:
     1294       message "Нет архивов по типу приобретения !!!" skip
     1295       vss-include-info16 skip
     1296       view-as alert-box information .
     1297       return 'First-page':U.
     1298    end.
     1299     type-pr:sensitive = yes  .
     1300     type-pr:visible   = yes  .
     1301    end.
     1302   end procedure.
