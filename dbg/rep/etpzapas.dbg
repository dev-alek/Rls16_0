      133   .
      134   procedure create_obj-list :
      135      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      136      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      137      do
      138      on error undo, return error return-value
      139      :
      140         define buffer cli-obj for ub.clients .
      141         define variable p-var as integer no-undo .
      142         define buffer buf_obj-list for obj-list .
      143         find last buf_obj-list  use-index pi no-error .
      144         if available buf_obj-list
      145         then
      146            p-var = buf_obj-list.obj-id + 1.
      147         else
      148            p-var = 1.
      149         find first cli-obj where
      150                   cli-obj.obj-type = p-obj-type
      151               and cli-obj.obj-code = p-obj-code
      152         no-lock no-error.
      153         if available cli-obj
      154         then do:
      155            create buf_obj-list.
      156            assign
      157               buf_obj-list.obj-id   = p-var
      158               buf_obj-list.obj-code = cli-obj.obj-code
      159               buf_obj-list.obj-type = cli-obj.obj-type
      160               buf_obj-list.obj-name = cli-obj.obj-name
      161               buf_obj-list.db-num   = cli-obj.db-num
      162            .
      163         end.
      164      end.
      165   end.
