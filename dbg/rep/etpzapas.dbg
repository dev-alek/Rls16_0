      558   define new global shared variable g#library  as handle no-undo .
      559   define new global shared variable g#library2 as handle no-undo .
      560   define variable var-report-r-b as character no-undo .
      561   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      562   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      563     (output var-report-r-b
      564     )  .
      565   define new global shared variable g#language as character no-undo .
      566   if g#language <> '' and g#language <> 'rus':U then do:
      567     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      568   end.
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   DEFINE VARIABLE  type-pr  AS WIDGET-HANDLE.
      679   def var State-source as  WIDGET-HANDLE.
      680   define variable g#log as logical   no-undo .
      681   DEFINE BUTTON BUTTON-1
      682        LABEL "Button 1"
      683        SIZE 15 BY 1.13.
      684   DEFINE VARIABLE Classify AS CHARACTER
      685        VIEW-AS RADIO-SET VERTICAL
      686        RADIO-BUTTONS
      687             "Без классификации", "no-classify":U,
      688   "Производители", "prod":U,
      689   "Группы товаров", "grp-goods":U,
      690   "Производители/Группы товаров", "prod/grp-goods":U,
      691   "Группы товаров/Производители", "grp-goods/prod":U
      692        size 30.5 by 4.75 NO-UNDO.
      693   DEFINE VARIABLE SortType AS CHARACTER
      694        VIEW-AS RADIO-SET VERTICAL
      695        RADIO-BUTTONS
      696             "по коду", "sort-code":U,
      697   "по артикулу", "sort-artic":U,
      698   "по наименов.", "sort-name":U
      699        size 14 by 2.75 NO-UNDO.
      700   DEFINE RECTANGLE RECT-10
      701        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      702        SIZE 31.75 BY 6.63.
      703   DEFINE RECTANGLE RECT-5
      704        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      705        SIZE 32.25 BY 7.75.
      706   DEFINE RECTANGLE RECT-6
      707        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      708        SIZE 16.13 BY 7.79.
      709   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
      710        LABEL "Показывать нулевые остатки":L
      711        VIEW-AS TOGGLE-BOX
      712        size 31.13 by 1.13 NO-UNDO.
      713   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      714        LABEL "Только итоги":L
      715        VIEW-AS TOGGLE-BOX
      716        size 16 by 1 NO-UNDO.
      717   DEFINE FRAME F-Main
      718        Classify at row 2.21 col 2.25 NO-LABEL
      719        SortType at row 2.71 col 35.38 NO-LABEL
      720        SumsOnly at row 7.28 col 2.25
      721        BUTTON-1 AT ROW 7.71 COL 35.13
      722        ShowZero at row 9.17 col 2.25
      723        RECT-5 AT ROW 1.13 COL 1.63
      724        RECT-10 AT ROW 11.42 COL 1.13
      725        "Классификация :" VIEW-AS TEXT
      726             size 15 by 0.75 at row 1.33 col 9.5
      727             FGCOLOR 4
      728        RECT-6 AT ROW 1.13 COL 34.25
      729        "Сортировка :" VIEW-AS TEXT
      730             size 11.5 by 0.75 at row 1.46 col 36.88
      731             FGCOLOR 4
      732        "Тип приобретения:" VIEW-AS TEXT
      733             SIZE 28.88 BY .67 AT ROW 10.67 COL 1.38
      734             FGCOLOR 4
      735       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      736            SIDE-LABELS NO-UNDERLINE THREE-D
      737            AT COL 1 ROW 1 SCROLLABLE .
      738   ASSIGN
      739          FRAME F-Main:SCROLLABLE       = FALSE
      740          FRAME F-Main:HIDDEN           = TRUE.
      741   ASSIGN
      742          BUTTON-1:HIDDEN IN FRAME F-Main           = TRUE.
      743   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      744   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      745   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      746   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      747   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      748   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      749   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      750   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      751         adm-object-hdl = FRAME F-Main:HANDLE.
      752   RUN ensure-broker.
      753   THIS-PROCEDURE:ADM-DATA =
      754        'ADM1.1~`':U +
      755        'SmartObject~`':U +
      756        '~`':U +
      757        'NO ~`':U +
      758        '~`':U +
      759        '~`':U +
      760        '~`':U +
      761        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      762           + "~`":U +
      763        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      764        'Record-Source,Record-Target,TableIO-Target~`':U +
      765        '~`':U +
      766        '~`~`~`~`~`~`~`~`~`~`~`':U +
      767        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      768            THEN "^^":U
      769        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      770             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      771   PROCEDURE adm-apply-entry :
      772     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      773   END PROCEDURE.
      774   PROCEDURE adm-destroy :
      775    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      776   END PROCEDURE.
      777   PROCEDURE adm-disable :
      778       DISABLE RECT-5 RECT-10 RECT-6 Classify SortType ShowZero WITH FRAME F-Main.
      779       RUN dispatch ('disable-fields':U).
      780       RUN set-attribute-list ('ENABLED=no':U).
      781       RETURN.
      782   END PROCEDURE.
      783   PROCEDURE adm-edit-attribute-list :
      784         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      785         RETURN.
      786   END PROCEDURE.
      787   PROCEDURE adm-enable :
      788       ENABLE UNLESS-HIDDEN RECT-5 RECT-10 RECT-6 Classify SortType ShowZero WITH FRAME F-Main.
      789       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      790       RUN set-attribute-list ('ENABLED=yes':U).
      791       RETURN.
      792   END PROCEDURE.
      793   PROCEDURE adm-exit :
      794        RUN notify ('exit':U).
      795     RETURN.
      796   END PROCEDURE.
      797   PROCEDURE adm-hide :
      798     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      799   END PROCEDURE.
      800   PROCEDURE adm-initialize :
      801     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      802   END PROCEDURE.
      803   PROCEDURE adm-show-errors :
      804       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      805       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      806           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      807       END.
      808       RETURN.
      809   END PROCEDURE.
      810   PROCEDURE adm-UIB-mode :
      811     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      812   END PROCEDURE.
      813   PROCEDURE adm-view :
      814     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      815   END PROCEDURE.
      816   PROCEDURE dispatch :
      817       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      818       RUN broker-dispatch IN adm-broker-hdl
      819           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      820       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      821   END PROCEDURE.
      822   PROCEDURE ensure-broker :
      823   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      824   IF RETURN-VALUE NE "ADM-Broker":U THEN
      825   DO:
      826       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      827       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      828   END.
      829   END PROCEDURE.
      830   PROCEDURE get-attribute :
      831     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      832     RUN broker-get-attribute IN adm-broker-hdl
      833         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      834     RETURN RETURN-VALUE.
      835   END PROCEDURE.
      836   PROCEDURE get-attribute-list :
      837     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      838     RUN broker-get-attribute-list IN adm-broker-hdl
      839         (INPUT THIS-PROCEDURE,
      840          INPUT ?,
      841          OUTPUT p-attr-list) NO-ERROR.
      842     RETURN.
      843   END PROCEDURE.
      844   PROCEDURE new-state :
      845     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      846     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      847     RETURN.
      848   END PROCEDURE.
      849   PROCEDURE notify :
      850     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      851     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      852     IF RETURN-VALUE = "ADM-ERROR":U THEN
      853         RETURN "ADM-ERROR":U.
      854     RETURN.
      855   END PROCEDURE.
      856   PROCEDURE set-attribute-list :
      857     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      858     RUN ensure-broker.
      859     RUN broker-set-attribute-list IN adm-broker-hdl
      860         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      861     RETURN.
      862   END PROCEDURE.
      863   PROCEDURE set-position :
      864       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      865       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      866       IF VALID-HANDLE(adm-object-hdl) THEN
      867       DO:
      868         ASSIGN adm-object-hdl:ROW    =   p-row
      869                adm-object-hdl:COLUMN =   p-col.
      870       END.
      871       RETURN.
      872   END PROCEDURE.
      873   PROCEDURE adm-display-fields :
      874       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      875       RETURN.
      876   END PROCEDURE.
      877   PROCEDURE adm-open-query :
      878     RETURN.
      879   END PROCEDURE.
      880   PROCEDURE adm-row-changed :
      881         IF VALID-HANDLE(adm-object-hdl) THEN
      882           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      883         RUN notify ('row-available':U).
      884         RETURN.
      885   END PROCEDURE.
      886   PROCEDURE reposition-query :
      887       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      888       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      889       RETURN.
      890   END PROCEDURE.
      891     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      892     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      893     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      894     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      895     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      896     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      897     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      898     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      899     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      900     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      901     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      902     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      903     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      904     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      905     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      906     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      907     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      908     IF "":U = "":U THEN
      909       RUN modify-list-attribute IN adm-broker-hdl
      910         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      911     RUN use-create-on-add(?).
      912   PROCEDURE adm-add-record :
      913       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      914          "must have at least one Enabled Table to perform Add.":U
      915          VIEW-AS ALERT-BOX ERROR.
      916       RETURN.
      917   END PROCEDURE.
      918   PROCEDURE adm-assign-record :
      919    MESSAGE
      920          "Object ":U THIS-PROCEDURE:FILE-NAME
      921            "must have at least one Enabled Table to perform Assign.":U
      922              VIEW-AS ALERT-BOX ERROR.
      923      RETURN.
      924     END PROCEDURE.
      925   PROCEDURE adm-assign-statement :
      926     RETURN.
      927   END PROCEDURE.
      928   PROCEDURE adm-cancel-record :
      929      RETURN.
      930     END PROCEDURE.
      931   PROCEDURE adm-copy-record :
      932       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      933        "must have at least one Enabled Table to perform Copy.":U
      934          VIEW-AS ALERT-BOX ERROR.
      935       RETURN.
      936   END PROCEDURE.
      937   PROCEDURE adm-create-record :
      938      RETURN.
      939   END PROCEDURE.
      940   PROCEDURE adm-current-changed :
      941     RETURN.
      942   END PROCEDURE.
      943   PROCEDURE adm-delete-record :
      944    MESSAGE
      945          "Object ":U THIS-PROCEDURE:FILE-NAME
      946            "must have at least one Enabled Table to perform Delete.":U
      947              VIEW-AS ALERT-BOX ERROR.
      948       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      949       RETURN.
      950   END PROCEDURE.
      951   PROCEDURE adm-disable-fields :
      952         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      953       RETURN.
      954   END PROCEDURE.
      955   PROCEDURE adm-enable-fields :
      956       RETURN.
      957   END PROCEDURE.
      958   PROCEDURE adm-end-update :
      959     RETURN.
      960   END PROCEDURE.
      961   PROCEDURE adm-reset-record :
      962       RETURN.
      963   END PROCEDURE.
      964   PROCEDURE adm-update-record :
      965       MESSAGE
      966         "Object ":U THIS-PROCEDURE:FILE-NAME
      967           "must have at least one Enabled Table to perform Update.":U
      968             VIEW-AS ALERT-BOX ERROR.
      969      RETURN.
      970   END PROCEDURE.
      971   PROCEDURE check-modified :
      972   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      973   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      974   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      975   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      976     IF check-state = "check":U THEN
      977     DO:
      978       RUN get-link-handle IN adm-broker-hdl
      979         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      980            OUTPUT group-target-list).
      981       IF group-target-list NE "":U THEN
      982       DO i = 1 TO NUM-ENTRIES(group-target-list):
      983         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      984         RUN check-modified IN curr-widget ('group-check':U).
      985         IF RETURN-VALUE NE "":U THEN
      986         DO:
      987           RUN check-modified-message(RETURN-VALUE).
      988           RETURN "":U.
      989         END.
      990       END.
      991     END.
      992     RETURN "":U.
      993   END PROCEDURE.
      994   PROCEDURE check-modified-message :
      995     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      996        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      997           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      998        IF RETURN-VALUE = "YES":U THEN
      999           RUN notify ('view,CONTAINER-SOURCE':U).
     1000        MESSAGE IF p-changed-table NE ? THEN
     1001           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1002           ELSE "Current values have been changed."
     1003           SKIP "  Do you wish to save those changes?"
     1004           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1005        IF ANS THEN
     1006        DO:
     1007           IF group-assign-target THEN
     1008             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1009           ELSE RUN dispatch('update-record':U).
     1010           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1011           DO:
     1012               MESSAGE "Changes to the previous record were not saved."
     1013                 VIEW-AS ALERT-BOX ERROR.
     1014               IF group-assign-target THEN
     1015                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1016               ELSE RUN dispatch ('cancel-record':U).
     1017           END.
     1018        END.
     1019        ELSE DO:
     1020          IF group-assign-target THEN
     1021             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1022          ELSE RUN dispatch('cancel-record':U).
     1023        END.
     1024        RETURN.
     1025   END PROCEDURE.
     1026   PROCEDURE get-rowid :
     1027       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1028       ASSIGN
     1029       p-table   =   adm-first-table.
     1030       RETURN.
     1031   END PROCEDURE.
     1032   PROCEDURE init-group-assign :
     1033       RUN request-attribute IN adm-broker-hdl
     1034         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1035       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1036         group-assign-target = yes.
     1037       ELSE group-assign-target = no.
     1038       RETURN.
     1039   END PROCEDURE.
     1040   PROCEDURE set-editors :
     1041       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1042       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1043       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1044       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1045       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1046       DO WHILE VALID-HANDLE (curr-widget):
     1047           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1048              curr-widget:HIDDEN = no THEN DO:
     1049             CASE p-field-setting:
     1050               WHEN "INITIALIZE":U THEN
     1051               DO:
     1052                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1053                     read-only-list +
     1054                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1055                        STRING(curr-widget).
     1056               END.
     1057               WHEN "DISABLE":U OR
     1058               WHEN "ENABLE":U THEN
     1059               DO:
     1060                   curr-widget:SENSITIVE = yes.
     1061                   RUN get-attribute ('Read-Only-Editors':U).
     1062                   IF RETURN-VALUE = ? OR
     1063                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1064                       curr-widget:READ-ONLY =
     1065                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1066               END.
     1067               WHEN "CLEAR":U THEN
     1068                   curr-widget:SCREEN-VALUE = "":U.
     1069             END CASE.
     1070           END.
     1071           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1072       END.
     1073       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1074         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1075           + '"':U).
     1076       RETURN.
     1077   END PROCEDURE.
     1078   PROCEDURE use-check-modified-all :
     1079    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1080     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1081     RETURN.
     1082   END PROCEDURE.
     1083   PROCEDURE use-create-on-add :
     1084   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1085      RETURN.
     1086   END PROCEDURE.
     1087   PROCEDURE use-initial-lock :
     1088     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1089     ASSIGN adm-initial-lock = p-attr-value.
     1090     RETURN.
     1091   END PROCEDURE.
     1092     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1093   ON CHOOSE OF BUTTON-1 IN FRAME F-Main
     1094   DO:
     1095   END.
     1096   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1097   DO:
     1098       Assign Classify.
     1099       if Classify  Begins "prod":U OR
     1100          Classify  Begins "grp-goods":U then
     1101           enable SumsOnly with frame F-Main .
     1102       else
     1103           do:
     1104               SumsOnly = FALSE .
     1105               display SumsOnly with frame F-Main .
     1106               disable SumsOnly with frame F-Main .
     1107           end.
     1108   END.
     1109   if not this-procedure :persistent
     1110   then do:
     1111     message
     1112       vss-workfile vss-revision vss-description skip
     1113       "Ошибка при запуске процедуры" skip
     1114       "Данную процедуру следует запускать только с параметром persistent" skip
     1115       view-as alert-box error .
     1116     undo, return error .
     1117   end.
     1118   PROCEDURE disable_UI :
     1119     HIDE FRAME F-Main.
     1120     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1121   END PROCEDURE.
     1122   PROCEDURE local-initialize :
     1123     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1124     run cr-ob in this-procedure (2,12,'Все,Выкуп,Консигнация,Ответственное хранение,Старая консигнация ':L
     1125                    ,'all,r,cb,s' + "," + 'o':U ).
     1126   END PROCEDURE.
     1127   PROCEDURE my-report :
     1128   def var v-kol as integer no-undo .
     1129   v-kol = 0.
     1130   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   do:
     1132     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1133       (input  v-cntxt-db-num
     1134       ,input  v-cntxt-userid
     1135       ,input  0
