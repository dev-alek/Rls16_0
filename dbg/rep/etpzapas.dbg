      122   def
      123    shared
      124   temp-table  obj-list no-undo
      125     field obj-type like ub.clients.obj-type
      126     field obj-code like ub.clients.obj-code
      127     field obj-name like ub.clients.obj-name
      128     field obj-id   as integer
