      917   on error undo, return error return-value
      918   :
      919       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete in g#attr-lib
      920       (input  p-obj-type
      921       ,input  p-obj-code
      922       ,input  p-upper-code
      923       ,input  p-code
      924       ,output p-deleted
      925       ) no-error .
      926     if error-status :error
      927     then do:
      928       undo, return error return-value .
      929     end.
      930   end.
      931   end procedure.
      932   procedure thbjattr_delete-section :
      933   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      934   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      935   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      936   do
      937   on error undo, return error return-value
      938   :
      939       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
      940       (input  p-obj-type
      941       ,input  p-obj-code
      942       ,input  p-upper-code
      943       ) no-error .
      944     if error-status :error
      945     then do:
      946       undo, return error return-value .
      947     end.
      948   end.
      949   end procedure.
      950   procedure thbjattr_manual-edit :
      951   define input  parameter p-ucode          as character no-undo .
      952   define input  parameter p-code           as character no-undo .
      953   define output parameter p-section-num    as integer no-undo .
      954   do
      955   on error undo, return error return-value
      956   :
      957       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      958       (input  p-ucode
      959       ,input  p-code
      960       ,output  p-section-num
      961       ) no-error .
      962     if error-status :error
      963     then do:
      964       undo, return error return-value .
      965     end.
      966   end.
      967   end procedure.
      968   CREATE WIDGET-POOL.
      969   define variable State-source as  WIDGET-HANDLE.
      970   define variable g#log as logical   no-undo .
      971   DEFINE BUTTON BUTTON-1
      972        LABEL "Button 1"
      973        SIZE 15 BY 1.13.
      974   DEFINE VARIABLE Classify AS CHARACTER
      975        VIEW-AS RADIO-SET VERTICAL
      976        RADIO-BUTTONS
      977             "Без классификации", "no-classify":U,
      978   "Производители", "prod":U,
      979   "Группы товаров", "grp-goods":U,
      980   "Производители/Группы товаров", "prod/grp-goods":U,
      981   "Группы товаров/Производители", "grp-goods/prod":U
      982        SIZE 30.5 BY 4.75 NO-UNDO.
      983   DEFINE VARIABLE SortType AS CHARACTER
      984        VIEW-AS RADIO-SET VERTICAL
      985        RADIO-BUTTONS
      986             "по коду", "sort-code":U,
      987   "по артикулу", "sort-artic":U,
      988   "по наименов.", "sort-name":U
      989        SIZE 14 BY 2.75 NO-UNDO.
      990   DEFINE RECTANGLE RECT-5
      991        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      992        SIZE 32.25 BY 7.75.
      993   DEFINE RECTANGLE RECT-6
      994        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      995        SIZE 16.13 BY 7.79.
      996   DEFINE VARIABLE PartsDet AS LOGICAL INITIAL no
      997        LABEL "Детализировать по партиям":L
      998        VIEW-AS TOGGLE-BOX
      999        SIZE 31.15 BY 1.08 NO-UNDO.
     1000   DEFINE VARIABLE Long-name AS LOGICAL INITIAL no
     1001        LABEL "В Excel-> ( Английское назв. + Назв. на этикетке)":L
     1002        VIEW-AS TOGGLE-BOX
     1003        SIZE 51.75 BY 1 TOOLTIP "В Excel вместо колонки название выводить длинное название товара" NO-UNDO.
     1004   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
     1005        LABEL "Показывать нулевые остатки":L
     1006        VIEW-AS TOGGLE-BOX
     1007        SIZE 31.13 BY 1.08 NO-UNDO.
     1008   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
     1009        LABEL "Только итоги":L
     1010        VIEW-AS TOGGLE-BOX
     1011        SIZE 16 BY 1 NO-UNDO.
     1012   DEFINE VARIABLE v-alc-marks AS LOGICAL INITIAL no
     1013        LABEL "Печать акцизных марок":L
     1014        VIEW-AS TOGGLE-BOX
     1015        SIZE 23.63 BY 1.08 NO-UNDO.
     1016   DEFINE VARIABLE v-photo AS LOGICAL INITIAL no
     1017        LABEL "Фото":L
     1018        VIEW-AS TOGGLE-BOX
     1019        SIZE 21.13 BY 1.08 NO-UNDO.
     1020   DEFINE FRAME F-Main
     1021        Classify AT ROW 2.21 COL 2.25 NO-LABEL
     1022        SortType AT ROW 2.71 COL 35.38 NO-LABEL
     1023        SumsOnly AT ROW 7.29 COL 2.25
     1024        BUTTON-1 AT ROW 7.5 COL 35
     1025        ShowZero AT ROW 9.17 COL 2.25
     1026        Long-name AT ROW 10.13 COL 2.25
     1027        PartsDet AT ROW 11.08 COL 2.25
     1028        v-photo AT ROW 12.21 COL 2.38 WIDGET-ID 2
     1029        v-alc-marks AT ROW 13.25 COL 2.38 WIDGET-ID 4
     1030        "Классификация :" VIEW-AS TEXT
     1031             SIZE 15 BY .75 AT ROW 1.33 COL 9.5
     1032             FGCOLOR 4
     1033        "Сортировка :" VIEW-AS TEXT
     1034             SIZE 11.5 BY .75 AT ROW 1.46 COL 36.88
     1035             FGCOLOR 4
     1036        RECT-5 AT ROW 1.13 COL 1.63
     1037        RECT-6 AT ROW 1.13 COL 34.25
     1038       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1039            SIDE-LABELS NO-UNDERLINE THREE-D
     1040            AT COL 1 ROW 1 SCROLLABLE
     1041            BGCOLOR 8 FGCOLOR 0 .
     1042   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1043   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1044   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1045   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1046   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1047   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1048   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1049   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1050         adm-object-hdl = FRAME F-Main:HANDLE.
     1051   RUN ensure-broker.
     1052   THIS-PROCEDURE:ADM-DATA =
     1053        'ADM1.1~`':U +
     1054        'SmartObject~`':U +
     1055        '~`':U +
     1056        'NO ~`':U +
     1057        '~`':U +
     1058        '~`':U +
     1059        '~`':U +
     1060        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1061           + "~`":U +
     1062        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1063        'Record-Source,Record-Target,TableIO-Target~`':U +
     1064        '~`':U +
     1065        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1066        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1067            THEN "^^":U
     1068        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1069             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1070   PROCEDURE adm-apply-entry :
     1071     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1072   END PROCEDURE.
     1073   PROCEDURE adm-destroy :
     1074    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1075   END PROCEDURE.
     1076   PROCEDURE adm-disable :
     1077       DISABLE RECT-5 RECT-6 Classify SortType ShowZero Long-name PartsDet v-photo WITH FRAME F-Main.
     1078       RUN dispatch ('disable-fields':U).
     1079       RUN set-attribute-list ('ENABLED=no':U).
     1080       RETURN.
     1081   END PROCEDURE.
     1082   PROCEDURE adm-edit-attribute-list :
     1083         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1084         RETURN.
     1085   END PROCEDURE.
     1086   PROCEDURE adm-enable :
     1087       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 Classify SortType ShowZero Long-name PartsDet v-photo WITH FRAME F-Main.
     1088       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1089       RUN set-attribute-list ('ENABLED=yes':U).
     1090       RETURN.
     1091   END PROCEDURE.
     1092   PROCEDURE adm-exit :
     1093        RUN notify ('exit':U).
     1094     RETURN.
     1095   END PROCEDURE.
     1096   PROCEDURE adm-hide :
     1097     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1098   END PROCEDURE.
     1099   PROCEDURE adm-initialize :
     1100     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1101   END PROCEDURE.
     1102   PROCEDURE adm-show-errors :
     1103       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1104       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1105           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1106       END.
     1107       RETURN.
     1108   END PROCEDURE.
     1109   PROCEDURE adm-UIB-mode :
     1110     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1111   END PROCEDURE.
     1112   PROCEDURE adm-view :
     1113     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1114   END PROCEDURE.
     1115   PROCEDURE dispatch :
     1116       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1117       RUN broker-dispatch IN adm-broker-hdl
     1118           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1119       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1120   END PROCEDURE.
     1121   PROCEDURE ensure-broker :
     1122   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1123   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1124   DO:
     1125       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1126       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1127   END.
     1128   END PROCEDURE.
     1129   PROCEDURE get-attribute :
     1130     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1131     RUN broker-get-attribute IN adm-broker-hdl
     1132         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1133     RETURN RETURN-VALUE.
     1134   END PROCEDURE.
     1135   PROCEDURE get-attribute-list :
     1136     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1137     RUN broker-get-attribute-list IN adm-broker-hdl
     1138         (INPUT THIS-PROCEDURE,
     1139          INPUT ?,
     1140          OUTPUT p-attr-list) NO-ERROR.
     1141     RETURN.
     1142   END PROCEDURE.
     1143   PROCEDURE new-state :
     1144     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1145     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1146     RETURN.
     1147   END PROCEDURE.
     1148   PROCEDURE notify :
     1149     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1150     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1151     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1152         RETURN "ADM-ERROR":U.
     1153     RETURN.
     1154   END PROCEDURE.
     1155   PROCEDURE set-attribute-list :
     1156     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1157     RUN ensure-broker.
     1158     RUN broker-set-attribute-list IN adm-broker-hdl
     1159         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1160     RETURN.
     1161   END PROCEDURE.
     1162   PROCEDURE set-position :
     1163       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1164       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1165       IF VALID-HANDLE(adm-object-hdl) THEN
     1166       DO:
     1167         ASSIGN adm-object-hdl:ROW    =   p-row
     1168                adm-object-hdl:COLUMN =   p-col.
     1169       END.
     1170       RETURN.
     1171   END PROCEDURE.
     1172   PROCEDURE adm-display-fields :
     1173       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1174       RETURN.
     1175   END PROCEDURE.
     1176   PROCEDURE adm-open-query :
     1177     RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE adm-row-changed :
     1180         IF VALID-HANDLE(adm-object-hdl) THEN
     1181           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1182         RUN notify ('row-available':U).
     1183         RETURN.
     1184   END PROCEDURE.
     1185   PROCEDURE reposition-query :
     1186       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1187       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1188       RETURN.
     1189   END PROCEDURE.
     1190     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1191     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1192     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1193     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1194     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1195     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1196     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1197     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1198     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1199     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1200     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1201     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1202     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1203     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1204     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1205     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1206     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1207     IF "":U = "":U THEN
     1208       RUN modify-list-attribute IN adm-broker-hdl
     1209         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1210     RUN use-create-on-add(?).
     1211   PROCEDURE adm-add-record :
     1212       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1213          "must have at least one Enabled Table to perform Add.":U
     1214          VIEW-AS ALERT-BOX ERROR.
     1215       RETURN.
     1216   END PROCEDURE.
     1217   PROCEDURE adm-assign-record :
     1218    MESSAGE
     1219          "Object ":U THIS-PROCEDURE:FILE-NAME
     1220            "must have at least one Enabled Table to perform Assign.":U
     1221              VIEW-AS ALERT-BOX ERROR.
     1222      RETURN.
     1223     END PROCEDURE.
     1224   PROCEDURE adm-assign-statement :
     1225     RETURN.
     1226   END PROCEDURE.
     1227   PROCEDURE adm-cancel-record :
     1228      RETURN.
     1229     END PROCEDURE.
     1230   PROCEDURE adm-copy-record :
     1231       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1232        "must have at least one Enabled Table to perform Copy.":U
     1233          VIEW-AS ALERT-BOX ERROR.
     1234       RETURN.
     1235   END PROCEDURE.
     1236   PROCEDURE adm-create-record :
     1237      RETURN.
     1238   END PROCEDURE.
     1239   PROCEDURE adm-current-changed :
     1240     RETURN.
     1241   END PROCEDURE.
     1242   PROCEDURE adm-delete-record :
     1243    MESSAGE
     1244          "Object ":U THIS-PROCEDURE:FILE-NAME
     1245            "must have at least one Enabled Table to perform Delete.":U
     1246              VIEW-AS ALERT-BOX ERROR.
     1247       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1248       RETURN.
     1249   END PROCEDURE.
     1250   PROCEDURE adm-disable-fields :
     1251         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1252       RETURN.
     1253   END PROCEDURE.
     1254   PROCEDURE adm-enable-fields :
     1255       RETURN.
     1256   END PROCEDURE.
     1257   PROCEDURE adm-end-update :
     1258     RETURN.
     1259   END PROCEDURE.
     1260   PROCEDURE adm-reset-record :
     1261       RETURN.
     1262   END PROCEDURE.
     1263   PROCEDURE adm-update-record :
     1264       MESSAGE
     1265         "Object ":U THIS-PROCEDURE:FILE-NAME
     1266           "must have at least one Enabled Table to perform Update.":U
     1267             VIEW-AS ALERT-BOX ERROR.
     1268      RETURN.
     1269   END PROCEDURE.
     1270   PROCEDURE check-modified :
     1271   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1272   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1273   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1274   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1275     IF check-state = "check":U THEN
     1276     DO:
     1277       RUN get-link-handle IN adm-broker-hdl
     1278         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1279            OUTPUT group-target-list).
     1280       IF group-target-list NE "":U THEN
     1281       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1282         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1283         RUN check-modified IN curr-widget ('group-check':U).
     1284         IF RETURN-VALUE NE "":U THEN
     1285         DO:
     1286           RUN check-modified-message(RETURN-VALUE).
     1287           RETURN "":U.
     1288         END.
     1289       END.
     1290     END.
     1291     RETURN "":U.
     1292   END PROCEDURE.
     1293   PROCEDURE check-modified-message :
     1294     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1295        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1296           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1297        IF RETURN-VALUE = "YES":U THEN
     1298           RUN notify ('view,CONTAINER-SOURCE':U).
     1299        MESSAGE IF p-changed-table NE ? THEN
     1300           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1301           ELSE "Current values have been changed."
     1302           SKIP "  Do you wish to save those changes?"
     1303           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1304        IF ANS THEN
     1305        DO:
     1306           IF group-assign-target THEN
     1307             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1308           ELSE RUN dispatch('update-record':U).
     1309           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1310           DO:
     1311               MESSAGE "Changes to the previous record were not saved."
     1312                 VIEW-AS ALERT-BOX ERROR.
     1313               IF group-assign-target THEN
     1314                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1315               ELSE RUN dispatch ('cancel-record':U).
     1316           END.
     1317        END.
     1318        ELSE DO:
     1319          IF group-assign-target THEN
     1320             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1321          ELSE RUN dispatch('cancel-record':U).
     1322        END.
     1323        RETURN.
     1324   END PROCEDURE.
     1325   PROCEDURE get-rowid :
     1326       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1327       ASSIGN
     1328       p-table   =   adm-first-table.
     1329       RETURN.
     1330   END PROCEDURE.
     1331   PROCEDURE init-group-assign :
     1332       RUN request-attribute IN adm-broker-hdl
     1333         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1334       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1335         group-assign-target = yes.
     1336       ELSE group-assign-target = no.
     1337       RETURN.
     1338   END PROCEDURE.
     1339   PROCEDURE set-editors :
     1340       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1341       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1342       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1343       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1344       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1345       DO WHILE VALID-HANDLE (curr-widget):
     1346           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1347              curr-widget:HIDDEN = no THEN DO:
     1348             CASE p-field-setting:
     1349               WHEN "INITIALIZE":U THEN
     1350               DO:
     1351                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1352                     read-only-list +
     1353                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1354                        STRING(curr-widget).
     1355               END.
     1356               WHEN "DISABLE":U OR
     1357               WHEN "ENABLE":U THEN
     1358               DO:
     1359                   curr-widget:SENSITIVE = yes.
     1360                   RUN get-attribute ('Read-Only-Editors':U).
     1361                   IF RETURN-VALUE = ? OR
     1362                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1363                       curr-widget:READ-ONLY =
     1364                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1365               END.
     1366               WHEN "CLEAR":U THEN
     1367                   curr-widget:SCREEN-VALUE = "":U.
     1368             END CASE.
     1369           END.
     1370           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1371       END.
     1372       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1373         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1374           + '"':U).
     1375       RETURN.
     1376   END PROCEDURE.
     1377   PROCEDURE use-check-modified-all :
     1378    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1379     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1380     RETURN.
     1381   END PROCEDURE.
     1382   PROCEDURE use-create-on-add :
     1383   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1384      RETURN.
     1385   END PROCEDURE.
     1386   PROCEDURE use-initial-lock :
     1387     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1388     ASSIGN adm-initial-lock = p-attr-value.
     1389     RETURN.
     1390   END PROCEDURE.
     1391     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1392   ASSIGN
     1393          FRAME F-Main:SCROLLABLE       = FALSE
     1394          FRAME F-Main:HIDDEN           = TRUE.
     1395   ASSIGN
     1396          BUTTON-1:HIDDEN IN FRAME F-Main           = TRUE.
     1397   ON CHOOSE OF BUTTON-1 IN FRAME F-Main
     1398   DO:
     1399   END.
     1400   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1401   DO:
     1402       Assign Classify.
     1403       if Classify  Begins "prod":U OR
     1404          Classify  Begins "grp-goods":U then
     1405           enable SumsOnly with frame F-Main .
     1406       else
     1407           do:
     1408               SumsOnly = FALSE .
     1409               display SumsOnly with frame F-Main .
     1410               disable SumsOnly with frame F-Main .
     1411               enable PartsDet with frame F-Main .
     1412           end.
     1413   END.
     1414   ON VALUE-CHANGED OF Long-name IN FRAME F-Main
     1415   DO:
     1416     ASSIGN long-name .
     1417   END.
     1418   ON VALUE-CHANGED OF PartsDet IN FRAME F-Main
     1419   DO:
     1420   define variable v-value-character            as   character                   no-undo.
     1421   define variable v-value-date                 as   date                        no-undo.
     1422   define variable v-value-decimal              as   decimal                     no-undo.
     1423   define variable v-value-integer              as   integer                     no-undo.
     1424   define variable v-value-mark                 as   logical                     no-undo.
     1425   define variable par-type                     as   character                   no-undo.
     1426     ASSIGN PartsDet .
     1427         run adm/shattri.p (
     1428           input "get":U
     1429           ,input v-cntxt-obj-type
     1430           ,input v-cntxt-obj-code
     1431           ,input 'nakl_par':U
     1432           ,input  "mark-alchol"
     1433           ,output v-value-character
     1434           ,output v-value-date
     1435           ,output v-value-decimal
     1436           ,output v-value-integer
     1437           ,output v-value-mark
     1438           ,output par-type
     1439           ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1440           ) no-error .
     1441   if v-value-mark and PartsDet then do:
     1442       enable v-alc-marks with frame F-Main .
     1443   end.
     1444   else do:
     1445       DISABLE v-alc-marks with frame F-Main .
     1446   end.
     1447   END.
     1448   ON VALUE-CHANGED OF SumsOnly IN FRAME F-Main
     1449   DO:
     1450     ASSIGN SumsOnly .
     1451     if not SumsOnly then do:
     1452         enable PartsDet with frame F-Main .
     1453         enable v-photo  with frame F-Main .
     1454     end.
     1455     else do :
     1456         PartsDet = FALSE .
     1457         display PartsDet with frame F-Main .
     1458         disable PartsDet with frame F-Main .
     1459         v-photo = FALSE .
     1460         display v-photo with frame F-Main .
     1461         disable v-photo with frame F-Main .
     1462     end.
     1463   END.
     1464   ON VALUE-CHANGED OF v-alc-marks IN FRAME F-Main
     1465   DO:
     1466     ASSIGN v-alc-marks .
     1467   END.
     1468   ON VALUE-CHANGED OF v-photo IN FRAME F-Main
     1469   DO:
     1470     ASSIGN v-photo .
     1471   END.
     1472   if not this-procedure :persistent
     1473   then do:
     1474     message
     1475       vss-workfile vss-revision vss-description skip
     1476       "Ошибка при запуске процедуры" skip
     1477       "Данную процедуру следует запускать только с параметром persistent" skip
     1478       view-as alert-box error .
     1479     undo, return error .
     1480   end.
     1481   PROCEDURE disable_UI :
     1482     HIDE FRAME F-Main.
     1483     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1484   END PROCEDURE.
     1485   PROCEDURE my-report :
     1486   define variable v-kol as integer no-undo .
     1487   v-kol = 0.
     1488   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1489   do:
     1490     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1491       (input  v-cntxt-db-num
     1492       ,input  v-cntxt-userid
     1493       ,input  0
     1494       ,input  'actn_reports_lookup-cost':U
     1495       ,input  'object':U
     1496       ,input  v-cntxt-host-code-obj
     1497       ,input  v-cntxt-obj-type
     1498       ,input  v-cntxt-obj-code
     1499       ,input  0
     1500       ,input  0
     1501       ,input  0
     1502       ,input  false
     1503       ,output g#log
     1504       )  .
     1505   end.
     1506    if not g#log then v-kol = v-kol + 1.
     1507   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1508   do:
     1509     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1510       (input  v-cntxt-db-num
     1511       ,input  v-cntxt-userid
     1512       ,input  0
     1513       ,input  'actn_reports_lookup-crsa':U
     1514       ,input  'object':U
     1515       ,input  v-cntxt-host-code-obj
     1516       ,input  v-cntxt-obj-type
     1517       ,input  v-cntxt-obj-code
     1518       ,input  0
     1519       ,input  0
     1520       ,input  0
     1521       ,input  false
     1522       ,output g#log
     1523       )  .
     1524   end.
     1525    if not g#log then v-kol = v-kol + 1.
     1526   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   do:
     1528     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1529       (input  v-cntxt-db-num
     1530       ,input  v-cntxt-userid
     1531       ,input  0
     1532       ,input  'actn_reports_lookup-sale':U
     1533       ,input  'object':U
     1534       ,input  v-cntxt-host-code-obj
     1535       ,input  v-cntxt-obj-type
     1536       ,input  v-cntxt-obj-code
     1537       ,input  0
     1538       ,input  0
     1539       ,input  0
     1540       ,input  false
     1541       ,output g#log
     1542       )  .
     1543   end.
     1544    if not g#log then v-kol = v-kol + 1.
     1545    IF  v-kol >= 3  then DO:
     1546      Message "Отчет не может быть сформирован без указания цен. Но на просмотр цен у вас нет прав!             "  view-as alert-box .
     1547      return .
     1548    End.
     1549     CASE Classify:
     1550       WHEN "no-classify":U    THEN
     1551           run rep/r-zapas1.p (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type,input base-code,input Classify,input SortType,input SumsOnly,input ShowZero, INPUT long-name, INPUT PartsDet, INPUT v-photo, INPUT v-alc-marks).
     1552       WHEN "grp-goods":U      THEN
     1553            run rep/r-zapas2.p (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type,input base-code,input Classify,input SortType,input SumsOnly,input ShowZero, INPUT long-name, INPUT PartsDet, INPUT v-photo, INPUT v-alc-marks).
     1554       WHEN "prod":U           THEN
     1555           run rep/r-zapas3.p (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type,input base-code,input Classify,input SortType,input SumsOnly,input ShowZero, INPUT long-name, INPUT PartsDet, INPUT v-photo, INPUT v-alc-marks).
     1556       WHEN "prod/grp-goods":U THEN
     1557            run rep/r-zapas4.p (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type,input base-code,input Classify,input SortType,input SumsOnly,input ShowZero, INPUT long-name, INPUT PartsDet, INPUT v-photo, INPUT v-alc-marks).
     1558       WHEN "grp-goods/prod":U THEN
     1559            run rep/r-zapas5.p (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type,input base-code,input Classify,input SortType,input SumsOnly,input ShowZero, INPUT long-name, INPUT PartsDet, INPUT v-photo, INPUT v-alc-marks).
     1560    End case.
     1561   END PROCEDURE.
     1562   PROCEDURE my-var :
     1563   assign frame F-Main SumsOnly ShowZero  Classify SortType long-name PartsDet v-alc-marks.
     1564   def var t-class as char no-undo.
     1565   def var t-sort as char no-undo.
     1566     case classify:
     1567       when "no-classify":u    then t-class =   "Без классификации" .
     1568       when "prod":u           then t-class =   "Производители"   .
     1569       when "post":u           then t-class =   "Поставщики"   .
     1570       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1571       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1572       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1573       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1574       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1575       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1576       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1577       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1578       when  "t-level":u       then t-class =   "Терминальные группы" .
     1579    end case.
     1580     case sorttype:
     1581       when "sort-pp":u               then t-sort =   "по порядку" .
     1582       when "sort-code":u             then t-sort =   "по коду" .
     1583       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1584       when "sort-qunty":u            then t-sort =   "по реализации".
     1585       when "sort-name":u             then t-sort =   "по наименованию".
     1586       when "sort-type":u             then t-sort =   "по типу ткани".
     1587       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1588       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1589    end case.
     1590   x-date-end = x-date-alone.
     1591   ReportNAme = "С О С Т О Я Н И Е    З А П А С А ".
     1592   ReportHeader = "Классификация : " + t-class + chr(10) +
     1593                  (if SumsOnly then "Только итоги "  else " " )  +  chr(10) +
     1594                 "Сортировка " + t-sort  + chr(10) +
     1595                  (if ShowZero then "Показывать нулевые остатки "  else "Не показывать нулевые остатки " ) + chr(10) +
     1596                  (if PartsDet then "Детализировать по партиям"  else "" ).
     1597     if X-SET_PAY_TYPE <> 2 then str3 =  "в ценах РЕАЛИЗАЦИИ".
     1598    sheetf.make-correct = ""
     1599    .
     1600   END PROCEDURE.
