      682   procedure thbjattr_code :
      683      define input  parameter p-upper-code     as character no-undo .
      684      define input  parameter p-code           as character no-undo .
      685      define output parameter p-label          as character no-undo .
      686      define output parameter p-user-can-edit  as logical   no-undo .
      687      define output parameter p-output-display as logical   no-undo .
      688      define output parameter p-other          as character no-undo .
      689      define output parameter p-prop-list      as character no-undo .
      690      define output parameter p-prop-type-list as character no-undo .
      691      define output parameter p-prop-label-list as character no-undo .
      692      define output parameter p-global          as logical no-undo .
      693      define output parameter p-host           as logical no-undo .
      694      define output parameter p-shop           as logical no-undo .
      695      define output parameter p-store          as logical no-undo .
      696      define output parameter p-db             as logical no-undo .
      697      define variable p-region as logical no-undo.
      698      run thbjattr_code_reg in this-procedure (
      699                                               p-upper-code,
      700                                               p-code,
      701                                               output p-label,
      702                                               output p-user-can-edit,
      703                                               output p-output-display,
      704                                               output p-other,
      705                                               output p-prop-list,
      706                                               output p-prop-type-list,
      707                                               output p-prop-label-list,
      708                                               output p-global,
      709                                               output p-host,
      710                                               output p-shop,
      711                                               output p-store,
      712                                               output p-db,
      713                                               output p-region
      714                                               ).
      715   end procedure.
      716   procedure thbjattr_code_reg :
      717   define input  parameter p-upper-code     as character no-undo .
      718   define input  parameter p-code           as character no-undo .
      719   define output parameter p-label          as character no-undo .
      720   define output parameter p-user-can-edit  as logical   no-undo .
      721   define output parameter p-output-display as logical   no-undo .
      722   define output parameter p-other          as character no-undo .
      723   define output parameter p-prop-list      as character no-undo .
      724   define output parameter p-prop-type-list as character no-undo .
      725   define output parameter p-prop-label-list as character no-undo .
      726   define output parameter p-global          as logical no-undo .
      727   define output parameter p-host           as logical no-undo .
      728   define output parameter p-shop           as logical no-undo .
      729   define output parameter p-store          as logical no-undo .
      730   define output parameter p-db             as logical no-undo .
      731   define output parameter p-region         as logical no-undo .
      732   do
      733   on error undo, return error return-value
      734   :
      735       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      736       (input  p-upper-code
      737       ,input  p-code
      738       ,output p-label
      739       ,output p-user-can-edit
      740       ,output p-output-display
      741       ,output p-other
      742       ,output p-prop-list
      743       ,output p-prop-type-list
      744       ,output p-prop-label-list
      745       ,output p-global
      746       ,output p-host
      747       ,output p-shop
      748       ,output p-store
      749       ,output p-db
      750       ,output p-region
      751       ) no-error .
      752     if error-status :error
      753     then do:
      754       undo, return error substitute( "&1. &2&3&4", vss-include-info13, return-value, chr(10), error-status :get-message (1)).
      755     end.
      756   end.
      757   end procedure.
