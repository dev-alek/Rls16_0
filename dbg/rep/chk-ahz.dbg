      376   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   procedure factord :
      378     define input  parameter p-fact-date            as date    no-undo .
      379     define input  parameter p-fact-time            as integer no-undo .
      380     define input  parameter p-fact-num             as integer no-undo .
      381     define input  parameter p-shift-date           as date    no-undo .
      382     define input  parameter p-shift-num            as integer no-undo .
      383     define input  parameter p-shift-on             as logical no-undo .
      384     define output parameter p-fact-order           as decimal no-undo .
      385     define output parameter p-shift-end-fact-order as decimal no-undo .
      386     define output parameter p-day-end-fact-order   as decimal no-undo .
      387     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      388     if p-fact-date = ?
      389     then do:
      390       return error "Не указана фактическая дата" .
      391     end.
      392     define variable v-fact-date-num as integer no-undo .
      393     assign
      394       v-fact-date-num = integer(p-fact-date)
      395     .
      396     if p-fact-num = ?
      397     or p-fact-num = 0
      398     then do:
      399       return error "Не задан p-fact-num " + string(p-fact-num) .
      400     end.
      401     if p-fact-num < 0
      402     then do:
      403       return error "Отрицательный fact-num " + string(p-fact-num) .
      404     end.
      405     if p-fact-num >= 100000000
      406     then do:
      407       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      408     end.
      409     if p-shift-on = true
      410     then do:
      411       if p-shift-date = ?
      412       then do:
      413         return error "Не задана дата смены" .
      414       end.
      415       if p-shift-num = ?
      416       or p-shift-num = 0
      417       then do:
      418         return error "Не задан номер смены" .
      419       end.
      420     end.
      421     else do:
      422       assign
      423         p-shift-date = p-fact-date
      424         p-shift-num  = 24
      425       .
      426     end.
      427     define variable v-shift-offset as integer no-undo .
      428     if p-shift-date = p-fact-date
      429     then do:
      430       assign
      431         v-shift-offset = 1
      432       .
      433     end.
      434     if p-shift-date < p-fact-date
      435     then do:
      436       assign
      437         v-shift-offset = 0
      438       .
      439     end.
      440     if p-shift-date > p-fact-date
      441     then do:
      442       message
      443         vss-workfile vss-revision vss-description skip
      444         "Неправильная дата закрытия смены" skip
      445         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      446         view-as alert-box error .
      447       undo, return error
      448         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      449           ,string(p-fact-date, '99/99/9999':U)
      450           ,string(p-shift-date, '99/99/9999':U)
      451           )
      452       .
      453     end.
      454     if p-shift-num < 1
      455     or p-shift-num > 24
      456     then do:
      457       message
      458         vss-workfile vss-revision vss-description skip
      459         "Неправильный номер смены" skip
      460         "p-shift-num" p-shift-num skip
      461         view-as alert-box error .
      462       undo, return error return-value .
      463     end.
      464     assign
      465       p-fact-order           = v-fact-date-num
      466                              + v-shift-offset * 0.5
      467                              + p-shift-num    * 0.02 - 0.01
      468                              + p-fact-num     * 0.0000000001
      469       p-shift-end-fact-order = v-fact-date-num
      470                              + v-shift-offset * 0.5
      471                              + p-shift-num    * 0.02
      472       p-day-end-fact-order   = v-fact-date-num
      473                              + 0.99
      474     .
      475     if p-fact-order           <= v-fact-date-num
      476     or p-shift-end-fact-order <= v-fact-date-num
      477     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      478     or p-shift-end-fact-order >= p-day-end-fact-order
      479     then do:
      480       message
      481         vss-workfile vss-revision vss-description skip
      482         "Внутренняя ошибка при генерации фактического номера" skip
      483         "p-fact-date"            p-fact-date            skip
      484         "p-fact-time"            p-fact-time            skip
      485         "p-fact-num"             p-fact-num             skip
      486         "p-shift-date"           p-shift-date           skip
      487         "p-shift-num"            p-shift-num            skip
      488         "p-shift-on"             p-shift-on             skip
      489         "p-shift-end-fact-order" p-shift-end-fact-order skip
      490         "p-day-end-fact-order"   p-day-end-fact-order   skip
      491         "v-fact-date-num"        v-fact-date-num        skip
      492         view-as alert-box error .
      493       undo, return error return-value .
      494     end.
      495   end procedure.
      496   procedure day-begin-fact-order :
      497     define input  parameter p-fact-date            as date    no-undo .
      498     define output parameter p-day-begin-fact-order as decimal no-undo .
      499     do
      500     on error undo, return error return-value
      501     :
      502       if p-fact-date = ?
      503       then do:
      504         assign
      505           p-day-begin-fact-order = 0
      506         .
      507       end.
      508       else do:
      509         assign
      510           p-day-begin-fact-order = integer(p-fact-date)
      511         .
      512       end.
      513     end.
      514   end procedure.
      515   procedure factord-max-fact-order :
      516     define output parameter p-max-fact-order as decimal   no-undo .
      517     do
      518     on error undo, return error return-value
      519     :
      520       run day-begin-fact-order in this-procedure
      521         (input  date(1, 1, 5000)
      522         ,output p-max-fact-order
      523         ) .
      524     end.
      525   end procedure.
      526   procedure factord-cut-archive :
      527     define input  parameter p-obj-type             as character no-undo .
      528     define input  parameter p-obj-code             as integer   no-undo .
      529     define input  parameter p-fact-date            as date      no-undo .
      530     define output parameter p-shift-on             as logical   no-undo .
      531     define output parameter p-shift-date           as date      no-undo .
      532     define output parameter p-shift-num            as integer   no-undo .
      533     define output parameter p-day-end-fact-order   as decimal   no-undo .
      534     define output parameter p-shift-end-fact-order as decimal   no-undo .
      535     define variable v-fact-order as decimal   no-undo .
      536     define buffer buf_shift-obj for ub.shift-obj .
      537     do
      538     on error undo, return error return-value
      539     :
      540   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      542     (input  p-obj-type
      543     ,input  p-obj-code
      544     ,input  'shift-on=request'
      545     ,output p-shift-on
      546     ) no-error .
      547       if error-status :error
      548       then do:
      549         message
      550           vss-workfile vss-revision vss-description skip
      551           "Ошибка при определении атрибута объекта" skip
      552           "Объект" p-obj-type p-obj-code skip
      553           error-status :get-message(1) skip
      554           return-value skip
      555           view-as alert-box error .
      556         undo, return error return-value .
      557       end.
      558       if p-shift-on = false
      559       then do:
      560         assign
      561           p-shift-date               = ?
      562           p-shift-num                = 0
      563         .
      564       end.
      565       else do:
      566         find first buf_shift-obj share-lock
      567           where buf_shift-obj.obj-type   = p-obj-type
      568             and buf_shift-obj.obj-code   = p-obj-code
      569             and buf_shift-obj.shift-date > p-fact-date
      570           use-index pi
      571           no-error .
      572         if not available buf_shift-obj
      573         or buf_shift-obj.status_ <> 'зкр':U
      574         then do:
      575           message
      576             vss-workfile vss-revision vss-description skip
      577             "Невозможно вычислить последнюю смену" skip
      578             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      579             "Объект" p-obj-type p-obj-code skip
      580             "Дата" p-fact-date skip
      581             view-as alert-box error .
      582           undo, return error return-value .
      583         end.
      584         find last buf_shift-obj share-lock
      585           where buf_shift-obj.obj-type = p-obj-type
      586             and buf_shift-obj.obj-code = p-obj-code
      587             and buf_shift-obj.shift-date <= p-fact-date
      588           use-index pi
      589           no-error .
      590         if available buf_shift-obj
      591         then do:
      592           if  buf_shift-obj.status_ = 'зкр':U
      593           then do:
      594             assign
      595               p-shift-date = buf_shift-obj.shift-date
      596               p-shift-num  = buf_shift-obj.shift-num
      597             .
      598           end.
      599           else do:
      600             message
      601               vss-workfile vss-revision vss-description skip
      602               "Невозможно вычислить последнюю смену" skip
      603               "Статус смены отличен от статуса" 'зкр':U skip
      604               "Объект" p-obj-type p-obj-code skip
      605               "Дата" p-fact-date skip
      606               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      607               view-as alert-box error .
      608             undo, return error return-value .
      609           end.
      610         end.
      611         else do:
      612           assign
      613             p-shift-date = p-fact-date - 1
      614             p-shift-num  = 1
      615           .
      616         end.
      617       end.
      618       run factord in this-procedure
      619         (input  p-fact-date
      620         ,input  1
      621         ,input  1
      622         ,input  p-shift-date
      623         ,input  p-shift-num
      624         ,input  p-shift-on
      625         ,output v-fact-order
      626         ,output p-shift-end-fact-order
      627         ,output p-day-end-fact-order
      628         ) no-error .
      629       if error-status :error
      630       then do:
      631         message
      632           vss-workfile vss-revision vss-description skip
      633           "Ошибка при вызове процедуры factord"
      634           error-status :get-message(1) skip
      635           return-value skip
      636           view-as alert-box error .
      637         undo, return error return-value .
      638       end.
      639     end.
      640   end procedure.
      641   procedure factord-lock-shift :
      642     define input  parameter p-obj-type  as character no-undo .
      643     define input  parameter p-obj-code  as integer   no-undo .
      644     define input  parameter p-fact-date as date      no-undo .
      645     define parameter buffer buf_shift-obj for ub.shift-obj .
      646     define variable v-shift-on      as logical   no-undo .
      647     define variable v-extra-message as character no-undo .
      648     define variable v-error as character no-undo .
      649     do
      650     on error undo, return error return-value
      651     :
      652   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      654     (input  p-obj-type
      655     ,input  p-obj-code
      656     ,input  'shift-on=request'
      657     ,output v-shift-on
      658     ) no-error .
      659       if error-status :error
      660       then do:
      661         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      662         undo, return error v-error .
      663       end.
      664       if v-shift-on = true
      665       then do:
      666         find first buf_shift-obj share-lock
      667           where buf_shift-obj.obj-type   = p-obj-type
      668             and buf_shift-obj.obj-code   = p-obj-code
      669             and buf_shift-obj.shift-date > p-fact-date
      670           use-index pi
      671           no-error .
      672         if not available buf_shift-obj
      673         or buf_shift-obj.status_ <> 'зкр':U
      674         then do:
      675           find last buf_shift-obj
      676             where buf_shift-obj.obj-type = p-obj-type
      677               and buf_shift-obj.obj-code = p-obj-code
      678               and buf_shift-obj.status_  = 'зкр':U
      679             use-index stts
      680             no-error .
      681           if available buf_shift-obj
      682           then do:
      683             assign
      684               v-extra-message =
      685                     substitute("Дата начала последеней закрытой смены на объекте &1"
      686                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      687                               )
      688             .
      689           end.
      690           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      691           undo, return error v-error .
      692         end.
      693       end.
      694     end.
      695   end procedure.
      696   procedure factord-end-day :
      697     define input  parameter p-fact-date            as date    no-undo .
      698     define output parameter p-day-end-fact-order   as decimal no-undo .
      699     do
      700     on error undo, return error return-value
      701     :
      702       if p-fact-date = ?
      703       then do:
      704         return error "Не указана фактическая дата" .
      705       end.
      706       assign
      707         p-day-end-fact-order = integer(p-fact-date) + 0.99
      708       .
      709     end.
      710   end procedure.
      711   procedure factord-to-date :
      712     define input  parameter p-fact-order as decimal no-undo .
      713     define output parameter p-fact-date  as date    no-undo .
      714     define variable v-ref-date  as date      no-undo .
      715     define variable v-ref-delta as integer   no-undo .
      716     do
      717     on error undo, return error return-value
      718     :
      719       if p-fact-order = ?
      720       or p-fact-order = 0
      721       then do:
      722         return error "Не указан fact-order" .
      723       end.
      724       assign
      725         v-ref-date  = date(1, 1, 2000)
      726       .
      727       assign
      728         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      729       .
      730       assign
      731         p-fact-date = v-ref-date + v-ref-delta
      732       .
      733     end.
      734   end procedure.
      735   procedure factord-to-fact-num :
      736     define input  parameter p-fact-order as decimal no-undo .
      737     define output parameter p-fact-num   as integer no-undo .
      738     define variable v-fact-order-trunc as decimal no-undo .
      739     do
      740     on error undo, return error return-value
      741     :
      742       if p-fact-order = ?
      743       or p-fact-order = 0
      744       then do:
      745         return error "Не указан fact-order" .
      746       end.
      747       assign
      748        v-fact-order-trunc = truncate(p-fact-order, 2)
      749       .
      750       assign
      751         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      752       .
      753     end.
      754   end procedure.
      755   procedure factord-to-shift-num :
      756     define input  parameter p-fact-order as decimal no-undo .
      757     define output parameter p-shift-num   as integer no-undo .
      758     define variable  p-shift-numd  as decimal   no-undo .
      759     define variable v-fact-order-trunc as decimal no-undo .
      760     do
      761     on error undo, return error return-value
      762     :
      763       if p-fact-order = ?
      764       or p-fact-order = 0
      765       then do:
      766         return error "Не указан fact-order" .
      767       end.
      768       assign
      769        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      770       .
      771       if v-fact-order-trunc < 0.5 then do:
      772         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      773       end.
      774       assign
      775         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      776         .
      777        assign
      778         p-shift-num = truncate (p-shift-numd , 0)
      779       .
      780     end.
      781   end procedure.
      782   define buffer buf_ot-tot      for ub.ot-tot .
      783   define buffer buf_ot-supp-tot for ub.ot-supp-tot .
      784   define buffer buf_aht-ot-tot  for ub.aht-ot-tot .
      785   define buffer buf_trn-doc     for ub.trn-doc .
      786   do
      787   on error undo, return error return-value
      788   :
      789     if  p-verify-arh    = false
      790     and p-verify-ahsp   = false
      791     and p-verify-aht    = false
      792     then do:
      793       message
      794         vss-workfile vss-revision vss-description skip
      795         "Ошибка задания входных параметров" skip
      796         "Не указан складской архив, который необходимо проверить" skip
      797         "Объект" p-obj-type p-obj-code skip
      798         "Дата начала периода" string(p-date-start, '99/99/9999':u) skip
      799         "Дата завершения периода" string(p-date-end, '99/99/9999':u) skip
      800         view-as alert-box error .
      801       undo, return error return-value .
      802     end.
      803     if p-date-start = ?
      804     then do:
      805       message
      806         vss-workfile vss-revision vss-description skip
      807         "Ошибка задания входных параметров" skip
      808         "Не указана дата начала периода" skip
      809         "Объект" p-obj-type p-obj-code skip
      810         "Дата начала периода" string(p-date-start, '99/99/9999':u) skip
      811         "Дата завершения периода" string(p-date-end, '99/99/9999':u) skip
      812         view-as alert-box error .
      813       undo, return error return-value .
      814     end.
      815     if p-date-end = ?
      816     then do:
      817       message
      818         vss-workfile vss-revision vss-description skip
      819         "Ошибка задания входных параметров" skip
      820         "Не указана дата завершения периода" skip
      821         "Объект" p-obj-type p-obj-code skip
      822         "Дата начала периода" string(p-date-start, '99/99/9999':u) skip
      823         "Дата завершения периода" string(p-date-end, '99/99/9999':u) skip
      824         view-as alert-box error .
      825       return .
      826     end.
      827     if p-date-start > p-date-end
      828     then do:
      829       message
      830         vss-workfile vss-revision vss-description skip
      831         "Ошибка задания входных параметров" skip
      832         "Дата начала периода не может быть больше даты завершения периода" skip
      833         "Объект" p-obj-type p-obj-code skip
      834         "Дата начала периода" string(p-date-start, '99/99/9999':u) skip
      835         "Дата завершения периода" string(p-date-end, '99/99/9999':u) skip
      836         view-as alert-box error .
      837       return .
      838     end.
      839     define variable v-obj-exist as logical   no-undo .
      840   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      842     (input  p-obj-type
      843     ,input  p-obj-code
      844     ,input  'check-exist':u
      845     ,output v-obj-exist
      846     ) no-error .
      847     if error-status :error
      848     then do:
      849       message
      850         vss-workfile vss-revision vss-description skip
      851         "Ошибка задания параметров" skip
      852         "Не найден объект" skip
      853         "Объект" p-obj-type p-obj-code skip
      854         "Дата начала периода" string(p-date-start, '99/99/9999':u) skip
      855         "Дата завершения периода" string(p-date-end, '99/99/9999':u) skip
      856         view-as alert-box error .
      857       undo, return error return-value .
      858     end.
      859     define variable v-attr-value as character no-undo .
      860     define variable v-attr-type  as character no-undo .
      861     define variable v-shift-new as logical    no-undo .
      862     if p-verify-arh = true
      863     then do:
      864       define variable v-arh-calc          as logical   no-undo .
      865       define variable v-arh-del           as logical   no-undo .
      866       define variable v-arh-disable       as logical   no-undo .
      867       define variable v-arh-start-date    as date      no-undo .
      868       define variable v-arh-detail-date   as date      no-undo .
      869       define variable v-arh-recalc-date   as date      no-undo .
      870       define variable v-arh-last-stk-date as date      no-undo .
      871       define variable v-arh-last-stk-time as integer   no-undo .
      872       run clntattr-value in this-procedure
      873         (input  p-obj-type
      874         ,input  p-obj-code
      875         ,input  'arh-calc':U
      876         ,output v-attr-value
      877         ,output v-attr-type
      878         ) .
      879       assign
      880         v-arh-calc = (lookup(v-attr-value, 'yes,true') > 0)
      881       .
      882       run clntattr-value in this-procedure
      883         (input  p-obj-type
      884         ,input  p-obj-code
      885         ,input  'arh-del':U
      886         ,output v-attr-value
      887         ,output v-attr-type
      888         ) .
      889       assign
      890         v-arh-del = (lookup(v-attr-value, 'yes,true') > 0)
      891       .
      892       run clntattr-value in this-procedure
      893         (input  p-obj-type
      894         ,input  p-obj-code
      895         ,input  'arh-disable':U
      896         ,output v-attr-value
      897         ,output v-attr-type
      898         ) .
      899       assign
      900         v-arh-disable = (lookup(v-attr-value, 'yes,true') > 0)
      901       .
      902       run clntattr-value in this-procedure
      903         (input  p-obj-type
      904         ,input  p-obj-code
      905         ,input  'arh-start':U
      906         ,output v-attr-value
      907         ,output v-attr-type
      908         ) .
      909       assign
      910         v-arh-start-date = date(v-attr-value)
      911       .
      912       run clntattr-value in this-procedure
      913         (input  p-obj-type
      914         ,input  p-obj-code
      915         ,input  'arh-detail':U
      916         ,output v-attr-value
      917         ,output v-attr-type
      918         ) .
      919       assign
      920         v-arh-detail-date = date(v-attr-value)
      921       .
      922       run clntattr-value in this-procedure
      923         (input  p-obj-type
      924         ,input  p-obj-code
      925         ,input  'arh-recalc':U
      926         ,output v-attr-value
      927         ,output v-attr-type
      928         ) .
      929       assign
      930         v-arh-recalc-date = date(v-attr-value)
      931       .
      932       assign
      933         v-arh-last-stk-date = ?
      934         v-arh-last-stk-time = 0
      935       .
      936       find last buf_ot-tot no-lock
      937         where buf_ot-tot.obj-code = p-obj-code
      938           and buf_ot-tot.obj-type = p-obj-type
      939         use-index obj-ot
      940         no-error .
      941       if available buf_ot-tot
      942       then do:
      943         find first buf_trn-doc no-lock
      944           where buf_trn-doc.doc-code = buf_ot-tot.doc-code
      945           no-error .
      946         if available buf_trn-doc
      947         then do:
      948           assign
      949             v-arh-last-stk-date = buf_trn-doc.fact-date
      950             v-arh-last-stk-time = buf_trn-doc.fact-time
      951           .
      952         end.
      953       end.
      954       run check-date in this-procedure
      955         (input        v-arh-calc
      956         ,input        v-arh-del
      957         ,input        v-arh-disable
      958         ,input        v-arh-start-date
      959         ,input        v-arh-detail-date
      960         ,input        v-arh-recalc-date
      961         ,input        v-arh-last-stk-date
      962         ,input        v-arh-last-stk-time
      963         ,input        "Складской архив по товарам"
      964         ,input        'arh':u
      965         ,input        p-verify-detail
      966         ,input-output p-date-start
      967         ,input-output p-date-end
      968         ,output       p-archive-ok
      969         ,output       p-comment
      970         ,output       p-can-print
      971         ) .
      972       if p-archive-ok = false
      973       then do:
      974         return .
      975       end.
      976     end.
      977     if p-verify-ahsp = true
      978     then do:
      979       define variable v-ahsp-calc          as logical   no-undo .
      980       define variable v-ahsp-del           as logical   no-undo .
      981       define variable v-ahsp-disable       as logical   no-undo .
      982       define variable v-ahsp-start-date    as date      no-undo .
      983       define variable v-ahsp-detail-date   as date      no-undo .
      984       define variable v-ahsp-recalc-date   as date      no-undo .
      985       define variable v-ahsp-last-stk-date as date      no-undo .
      986       define variable v-ahsp-last-stk-time as integer   no-undo .
      987       run clntattr-value in this-procedure
      988         (input  p-obj-type
      989         ,input  p-obj-code
      990         ,input  'ahsp-calc':U
      991         ,output v-attr-value
      992         ,output v-attr-type
      993         ) .
      994       assign
      995         v-ahsp-calc = (lookup(v-attr-value, 'yes,true') > 0)
      996       .
      997       run clntattr-value in this-procedure
      998         (input  p-obj-type
      999         ,input  p-obj-code
     1000         ,input  'ahsp-del':U
     1001         ,output v-attr-value
     1002         ,output v-attr-type
     1003         ) .
     1004       assign
     1005         v-ahsp-del = (lookup(v-attr-value, 'yes,true') > 0)
     1006       .
     1007       run clntattr-value in this-procedure
     1008         (input  p-obj-type
     1009         ,input  p-obj-code
     1010         ,input  'ahsp-disable':U
     1011         ,output v-attr-value
     1012         ,output v-attr-type
     1013         ) .
     1014       assign
     1015         v-ahsp-disable = (lookup(v-attr-value, 'yes,true') > 0)
     1016       .
     1017       run clntattr-value in this-procedure
     1018         (input  p-obj-type
     1019         ,input  p-obj-code
     1020         ,input  'ahsp-start':U
     1021         ,output v-attr-value
     1022         ,output v-attr-type
     1023         ) .
     1024       assign
     1025         v-ahsp-start-date = date(v-attr-value)
     1026       .
     1027       run clntattr-value in this-procedure
     1028         (input  p-obj-type
     1029         ,input  p-obj-code
     1030         ,input  'ahsp-detail':U
     1031         ,output v-attr-value
     1032         ,output v-attr-type
     1033         ) .
     1034       assign
     1035         v-ahsp-detail-date = date(v-attr-value)
     1036       .
     1037       run clntattr-value in this-procedure
     1038         (input  p-obj-type
     1039         ,input  p-obj-code
     1040         ,input  'ahsp-recalc':U
     1041         ,output v-attr-value
     1042         ,output v-attr-type
     1043         ) .
     1044       assign
     1045         v-ahsp-recalc-date = date(v-attr-value)
     1046       .
     1047       assign
     1048         v-ahsp-last-stk-date = ?
     1049         v-ahsp-last-stk-time = 0
     1050       .
     1051       find last buf_ot-supp-tot no-lock
     1052         where buf_ot-supp-tot.obj-code = p-obj-code
     1053           and buf_ot-supp-tot.obj-type = p-obj-type
     1054         use-index fact-order
     1055         no-error .
     1056       if available buf_ot-supp-tot
     1057       then do:
     1058         find first buf_trn-doc no-lock
     1059           where buf_trn-doc.doc-code = buf_ot-supp-tot.doc-code
     1060           no-error .
     1061         if available buf_trn-doc
     1062         then do:
     1063           assign
     1064             v-ahsp-last-stk-date = buf_trn-doc.fact-date
     1065             v-ahsp-last-stk-time = buf_trn-doc.fact-time
     1066           .
     1067         end.
     1068       end.
     1069       run check-date in this-procedure
     1070         (input        v-ahsp-calc
     1071         ,input        v-ahsp-del
     1072         ,input        v-ahsp-disable
     1073         ,input        v-ahsp-start-date
     1074         ,input        v-ahsp-detail-date
     1075         ,input        v-ahsp-recalc-date
     1076         ,input        v-ahsp-last-stk-date
     1077         ,input        v-ahsp-last-stk-time
     1078         ,input        "Складской архив по поставщикам"
     1079         ,input        'ahsp':u
     1080         ,input        p-verify-detail
     1081         ,input-output p-date-start
     1082         ,input-output p-date-end
     1083         ,output       p-archive-ok
     1084         ,output       p-comment
     1085         ,output       p-can-print
     1086         ) .
     1087       if p-archive-ok = false
     1088       then do:
     1089         return .
     1090       end.
     1091     end.
     1092     if p-verify-aht = true
     1093     then do:
     1094       define variable v-aht-calc          as logical   no-undo .
     1095       define variable v-aht-del           as logical   no-undo .
     1096       define variable v-aht-disable       as logical   no-undo .
     1097       define variable v-aht-start-date    as date      no-undo .
     1098       define variable v-aht-detail-date   as date      no-undo .
     1099       define variable v-aht-recalc-date   as date      no-undo .
     1100       define variable v-aht-last-stk-date as date      no-undo .
     1101       define variable v-aht-last-stk-time as integer   no-undo .
     1102       run clntattr-value in this-procedure
     1103         (input  p-obj-type
     1104         ,input  p-obj-code
     1105         ,input  'aht-calc':U
     1106         ,output v-attr-value
     1107         ,output v-attr-type
     1108         ) .
     1109       assign
     1110         v-aht-calc = (lookup(v-attr-value, 'yes,true') > 0)
     1111       .
     1112       run clntattr-value in this-procedure
     1113         (input  p-obj-type
     1114         ,input  p-obj-code
     1115         ,input  'aht-del':U
     1116         ,output v-attr-value
     1117         ,output v-attr-type
     1118         ) .
     1119       assign
     1120         v-aht-del = (lookup(v-attr-value, 'yes,true') > 0)
     1121       .
     1122       run clntattr-value in this-procedure
     1123         (input  p-obj-type
     1124         ,input  p-obj-code
     1125         ,input  'aht-disable':U
     1126         ,output v-attr-value
     1127         ,output v-attr-type
     1128         ) .
     1129       assign
     1130         v-aht-disable = (lookup(v-attr-value, 'yes,true') > 0)
     1131       .
     1132       run clntattr-value in this-procedure
     1133         (input  p-obj-type
     1134         ,input  p-obj-code
     1135         ,input  'aht-start':U
     1136         ,output v-attr-value
     1137         ,output v-attr-type
     1138         ) .
     1139       assign
     1140         v-aht-start-date = date(v-attr-value)
     1141       .
     1142       run clntattr-value in this-procedure
     1143         (input  p-obj-type
     1144         ,input  p-obj-code
     1145         ,input  'aht-detail':U
     1146         ,output v-attr-value
     1147         ,output v-attr-type
     1148         ) .
     1149       assign
     1150         v-aht-detail-date = date(v-attr-value)
     1151       .
     1152       run clntattr-value in this-procedure
     1153         (input  p-obj-type
     1154         ,input  p-obj-code
     1155         ,input  'aht-recalc':U
     1156         ,output v-attr-value
     1157         ,output v-attr-type
     1158         ) .
     1159       assign
     1160         v-aht-recalc-date = date(v-attr-value)
     1161       .
     1162       assign
     1163         v-aht-last-stk-date = ?
     1164         v-aht-last-stk-time = 0
     1165       .
     1166       find last buf_aht-ot-tot no-lock
     1167         where buf_aht-ot-tot.obj-code = p-obj-code
     1168           and buf_aht-ot-tot.obj-type = p-obj-type
     1169         use-index fact-order
     1170         no-error .
     1171       if available buf_aht-ot-tot
     1172       then do:
     1173         find first buf_trn-doc no-lock
     1174           where buf_trn-doc.doc-code = buf_aht-ot-tot.doc-code
     1175           no-error .
     1176         if available buf_trn-doc
     1177         then do:
     1178           assign
     1179             v-aht-last-stk-date = buf_trn-doc.fact-date
     1180             v-aht-last-stk-time = buf_trn-doc.fact-time
     1181           .
     1182         end.
     1183       end.
     1184       run check-date in this-procedure
     1185         (input        v-aht-calc
     1186         ,input        v-aht-del
     1187         ,input        v-aht-disable
     1188         ,input        v-aht-start-date
     1189         ,input        v-aht-detail-date
     1190         ,input        v-aht-recalc-date
     1191         ,input        v-aht-last-stk-date
     1192         ,input        v-aht-last-stk-time
     1193         ,input        "Складской архив по типам приобретения"
     1194         ,input        'aht':u
     1195         ,input        p-verify-detail
     1196         ,input-output p-date-start
     1197         ,input-output p-date-end
     1198         ,output       p-archive-ok
     1199         ,output       p-comment
     1200         ,output       p-can-print
     1201         ) .
     1202       if p-archive-ok = false
     1203       then do:
     1204         return .
     1205       end.
     1206     end.
     1207     assign
     1208       p-archive-ok = true
     1209       p-comment    = ""
     1210       p-can-print  = true
     1211     .
     1212     return .
     1213   end.
     1214   procedure check-date :
     1215     define input        parameter p-calc          as logical   no-undo .
     1216     define input        parameter p-del           as logical   no-undo .
     1217     define input        parameter p-disable       as logical   no-undo .
     1218     define input        parameter p-start-date    as date      no-undo .
     1219     define input        parameter p-detail-date   as date      no-undo .
     1220     define input        parameter p-recalc-date   as date      no-undo .
     1221     define input        parameter p-last-stk-date as date      no-undo .
     1222     define input        parameter p-last-stk-time as integer   no-undo .
     1223     define input        parameter p-name          as character no-undo .
     1224     define input        parameter p-ahz-type      as character no-undo .
     1225     define input        parameter p-verify-detail as logical   no-undo .
     1226     define input-output parameter p-date-start    as date      no-undo .
     1227     define input-output parameter p-date-end      as date      no-undo .
     1228     define output       parameter p-archive-ok    as logical   no-undo .
     1229     define output       parameter p-comment       as character no-undo .
     1230     define output       parameter p-can-print     as logical   no-undo .
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       if  (p-calc = true
     1235            or p-del  = true
     1236           )
     1237       and p-disable = true
     1238       then do:
     1239         assign
     1240           p-archive-ok = false
     1241           p-comment    = p-name + chr(10)
     1242                        + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1243                        + "Расчет складского архива запрещен" + chr(10)
     1244           p-can-print  = false
     1245         .
     1246         run ver-del-obj (
     1247             input p-obj-type ,
     1248             input p-obj-code ,
     1249             input-output p-can-print
     1250             ) no-error .
     1251         return .
     1252       end.
     1253       if p-calc = true
     1254       then do:
     1255         assign
     1256           p-archive-ok = false
     1257           p-comment    = p-name + chr(10)
     1258                        + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1259                        + p-name + " не рассчитан" + chr(10)
     1260           p-can-print  = false
     1261         .
     1262         run ver-del-obj (
     1263             input p-obj-type ,
     1264             input p-obj-code ,
     1265             input-output p-can-print )
     1266             no-error .
     1267         return .
     1268       end.
     1269       if p-del = true
     1270       then do:
     1271         assign
     1272           p-archive-ok = false
     1273           p-comment    = p-name + chr(10)
     1274                        + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1275                        + "Начальные остатки по складскому архиву не рассчитаны" + chr(10)
     1276           p-can-print  = false
     1277         .
     1278         run ver-del-obj (
     1279             input p-obj-type ,
     1280             input p-obj-code ,
     1281             input-output p-can-print )
     1282             no-error .
     1283         return .
     1284       end.
     1285       if (p-start-date  = ?
     1286          and p-detail-date <> ?
     1287          )
     1288       or
     1289          (p-start-date  <> ?
     1290          and p-detail-date = ?
     1291          )
     1292       then do:
     1293         message
     1294           vss-workfile vss-revision vss-description skip
     1295           "Ошибка при анализе дат складского архива" skip
     1296           "Задана только одна дата" skip
     1297           "" p-start-date skip
     1298           "" p-start-date skip
     1299           view-as alert-box error .
     1300         undo, return error return-value .
     1301       end.
     1302       if p-date-start < p-start-date
     1303       then do:
     1304         assign
     1305           p-date-start = p-start-date
     1306         .
     1307         if p-date-end < p-start-date
     1308         then do:
     1309           assign
     1310             p-date-end = p-start-date
     1311           .
     1312         end.
     1313         assign
     1314           p-archive-ok = false
     1315           p-comment    = p-name + chr(10)
     1316                        + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1317                        + "Дата начала периода не может быть раньше начала рассчитанного складского архива"
     1318           p-can-print  = false
     1319         .
     1320         return .
     1321       end.
     1322       if  p-verify-detail = true
     1323       and p-date-start < p-detail-date
     1324       then do:
     1325         assign
     1326           p-date-start = p-detail-date
     1327         .
     1328         if p-date-end < p-date-start
     1329         then do:
     1330           assign
     1331             p-date-end = p-date-start
     1332           .
     1333         end.
     1334         assign
     1335           p-archive-ok = false
     1336           p-comment    = p-name + chr(10)
     1337                        + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1338                        + "Для подробного архива дата начала периода должна быть больше или равна началу подробного архива"
     1339           p-can-print  = false
     1340         .
     1341         return .
     1342       end.
     1343       define variable v-new-date-start as date      no-undo .
     1344       if  p-date-start > p-start-date
     1345       and p-date-start < p-detail-date
     1346       and day(p-date-start) <> 1
     1347       and p-date-end <> p-date-start
     1348       then do:
     1349         assign
     1350           v-new-date-start = date(month(p-date-start),1,year(p-date-start))
     1351         .
     1352         if v-new-date-start < p-start-date
     1353         then do:
     1354           run gbl/lastdate.p
     1355             (input  p-date-start
     1356             ,output v-new-date-start
     1357             ) .
     1358           assign
     1359             v-new-date-start = v-new-date-start + 1
     1360           .
     1361         end.
     1362         assign
     1363           p-date-start = v-new-date-start
     1364         .
     1365         if p-date-end < p-date-start
     1366         then do:
     1367           run gbl/lastdate.p
     1368             (input  p-date-start
     1369             ,output p-date-end
     1370             ) .
     1371         end.
     1372         assign
     1373           p-archive-ok = false
     1374           p-comment    = p-name + chr(10)
     1375                        + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1376                        + "Для сжатого складского архива дата начала периода должна быть началом месяца"
     1377           p-can-print  = false
     1378         .
     1379         return .
     1380       end.
     1381       define variable v-new-date-end as date      no-undo .
     1382       if  p-date-end > p-start-date
     1383       and p-date-end < p-detail-date
     1384       then do:
     1385         run gbl/lastdate.p
     1386           (input  p-date-end
     1387           ,output v-new-date-end
     1388           ) .
     1389         if p-date-end <> v-new-date-end
     1390         then do:
     1391           assign
     1392             p-date-end = v-new-date-end
     1393           .
     1394           assign
     1395             p-archive-ok = false
     1396             p-comment    = p-name + chr(10)
     1397                          + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1398                          + "Для сжатого складского архива дата завершения периода должна быть последним днем месяца " + string(v-new-date-end,"99/99/9999")
     1399             p-can-print  = false
     1400           .
     1401           return .
     1402         end.
     1403       end.
     1404       define variable v-date-shift as date      no-undo .
     1405       run ver-shift in this-procedure (
     1406           input   p-date-end ,
     1407           input   p-obj-type ,
     1408           input   p-obj-code ,
     1409           output  v-date-shift ) no-error .
     1410       if p-last-stk-date = ?
     1411       or (p-last-stk-date <> ?
     1412           and p-date-end >= p-last-stk-date) or v-date-shift <= p-last-stk-date
     1413       or (p-recalc-date <> ?
     1414           and p-date-end >= p-recalc-date
     1415          )
     1416       then do:
     1417         case p-ahz-type
     1418         :
     1419           when 'arh':u
     1420           then do:
     1421             run trg/bt_arh.p
     1422               (input p-obj-type
     1423               ,input p-obj-code
     1424               ,input v-date-shift
     1425               ,input p-check-act
     1426               ,input p-check-act-db-num
     1427               ,input p-check-act-user-id
     1428               ) no-error .
     1429             if error-status :error
     1430             then do:
     1431               if error-status :get-message(1) <> ""
     1432               then do:
     1433                 message
     1434                   vss-workfile vss-revision vss-description skip
     1435                   "Ошибка при вызове процедуры bt_arh.p" skip
     1436                   error-status :get-message(1) skip
     1437                   return-value skip
     1438                   view-as alert-box error .
     1439               end.
     1440               assign
     1441                 p-archive-ok = false
     1442                 p-comment    = p-name + chr(10)
     1443                              + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1444                              + substitute("&1", return-value) + chr(10)
     1445                              + (if p-last-stk-date = ?
     1446                                 then p-name + " не рассчитан"
     1447                                 else substitute("&1 рассчитан до &2   &3"
     1448                                                 ,p-name
     1449                                                 ,string(p-last-stk-date, '99/99/9999':u)
     1450                                                 ,string(p-last-stk-time, 'HH:MM':u)
     1451                                       )
     1452                                 ) + chr(10)
     1453                 p-can-print  = true
     1454               .
     1455               run ver-del-obj (
     1456                   input p-obj-type ,
     1457                   input p-obj-code ,
     1458                   input-output p-can-print )
     1459                   no-error .
     1460               return .
     1461             end.
     1462           end.
     1463           when 'ahsp':u
     1464           then do:
     1465             run trg/bt_ahsp.p
     1466               (input p-obj-type
     1467               ,input p-obj-code
     1468               ,input v-date-shift
     1469               ,input p-check-act
     1470               ,input p-check-act-db-num
     1471               ,input p-check-act-user-id
     1472               ) no-error .
     1473             if error-status :error
     1474             then do:
     1475               if error-status :get-message(1) <> ""
     1476               then do:
     1477                 message
     1478                   vss-workfile vss-revision vss-description skip
     1479                   "Ошибка при вызове процедуры bt_ahsp.p" skip
     1480                   error-status :get-message(1) skip
     1481                   return-value skip
     1482                   view-as alert-box error .
     1483               end.
     1484               assign
     1485                 p-archive-ok = false
     1486                 p-comment    = p-name + chr(10)
     1487                              + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1488                              + substitute("&1", return-value) + chr(10)
     1489                              + (if p-last-stk-date = ?
     1490                                 then p-name + " не рассчитан"
     1491                                 else substitute("&1 рассчитан до &2   &3"
     1492                                                 ,p-name
     1493                                                 ,string(p-last-stk-date, '99/99/9999':u)
     1494                                                 ,string(p-last-stk-time, 'HH:MM':u)
     1495                                       )
     1496                                 ) + chr(10)
     1497                 p-can-print  = true
     1498               .
     1499               run ver-del-obj (
     1500                   input p-obj-type ,
     1501                   input p-obj-code ,
     1502                   input-output p-can-print )
     1503                   no-error .
     1504               return .
     1505             end.
     1506           end.
     1507           when 'aht':u
     1508           then do:
     1509             run trg/bt_aht.p
     1510               (input p-obj-type
     1511               ,input p-obj-code
     1512               ,input v-date-shift
     1513               ,input p-check-act
     1514               ,input p-check-act-db-num
     1515               ,input p-check-act-user-id
     1516               ) no-error .
     1517             if error-status :error
     1518             then do:
     1519               if error-status :get-message(1) <> ""
     1520               then do:
     1521                 message
     1522                   vss-workfile vss-revision vss-description skip
     1523                   "Ошибка при вызове процедуры bt_aht.p" skip
     1524                   error-status :get-message(1) skip
     1525                   return-value skip
     1526                   view-as alert-box error .
     1527               end.
     1528               assign
     1529                 p-archive-ok = false
     1530                 p-comment    = p-name + chr(10)
     1531                              + substitute("Объект &1 &2", p-obj-type, p-obj-code) + chr(10)
     1532                              + substitute("&1", return-value) + chr(10)
     1533                              + (if p-last-stk-date = ?
     1534                                 then p-name + " не рассчитан"
     1535                                 else substitute("&1 рассчитан до &2   &3"
     1536                                                 ,p-name
     1537                                                 ,string(p-last-stk-date, '99/99/9999':u)
     1538                                                 ,string(p-last-stk-time, 'HH:MM':u)
     1539                                       )
     1540                                 ) + chr(10)
     1541                 p-can-print  = true
     1542               .
     1543                 run ver-del-obj (
     1544                     input p-obj-type ,
     1545                     input p-obj-code ,
     1546                     input-output p-can-print )
     1547                     no-error .
     1548               return .
     1549             end.
     1550           end.
     1551           otherwise do:
     1552             message
     1553               vss-workfile vss-revision vss-description skip
     1554               "Внутренняя ошибка" skip
     1555               "Неизвестное значение параметра p-ahz-type" skip
     1556               "Значение параметра" p-ahz-type skip
     1557               view-as alert-box error .
     1558             assign
     1559               p-archive-ok = false
     1560               p-comment    = ""
     1561               p-can-print  = false
     1562             .
     1563             return .
     1564           end.
     1565         end.
     1566       end.
     1567       assign
     1568         p-archive-ok = true
     1569         p-comment    = ""
     1570         p-can-print  = true
     1571       .
     1572       return .
     1573     end.
     1574   end procedure.
     1575   procedure ver-shift :
     1576   define input  parameter p-date     as date      no-undo .
     1577   define input  parameter p-obj-type as character no-undo .
     1578   define input  parameter p-obj-code  as integer   no-undo .
     1579   define output parameter p-date-shift   as date      no-undo .
     1580   define variable  l-shift-on as logical no-undo .
     1581   define buffer buf_shift-obj for ub.shift-obj  .
     1582     do
     1583     on error undo, return error return-value
     1584     :
     1585   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1587     (input  p-obj-type
     1588     ,input  p-obj-code
     1589     ,input  'shift-on=request'
     1590     ,output l-shift-on
     1591     ) no-error .
     1592     if l-shift-on = false then do:
     1593        p-date-shift = p-date.
     1594        return .
     1595     end.
     1596     for each  buf_shift-obj no-lock where
     1597               buf_shift-obj.obj-type = p-obj-type and
     1598               buf_shift-obj.obj-code = p-obj-code and
     1599               buf_shift-obj.shift-date = p-date   by
     1600               buf_shift-obj.close-date
     1601               :
     1602          p-date-shift = buf_shift-obj.close-date .
     1603      end.
     1604     if p-date-shift = ? or p-date-shift < p-date then p-date-shift = p-date .
     1605   end.
     1606   end procedure.
     1607   procedure ver-del-obj :
     1608   define input  parameter p-obj-type as character no-undo .
     1609   define input  parameter p-obj-code as integer   no-undo .
     1610   define input-output parameter p-is-del as logical   no-undo .
     1611   define buffer buf_clients for ub.clients  .
     1612     do
     1613     on error undo, return error return-value
     1614     :
     1615       find first buf_clients no-lock where
     1616                  buf_clients.obj-type = p-obj-type and
     1617                  buf_clients.obj-code = p-obj-code no-error .
     1618        if buf_clients.stts <> 0 then do:
     1619           p-is-del = true .
     1620        end.
     1621     end.
     1622   end procedure.
     1623   procedure ver-new-shiftobj :
     1624   define input  parameter p-obj-type as character no-undo .
     1625   define input  parameter p-obj-code as integer   no-undo .
     1626   define output parameter p-is-new   as logical   no-undo .
     1627   define buffer buf_shift-obj for ub.shift-obj  .
     1628     do
     1629     on error undo, return error return-value
     1630     :
     1631         p-is-new = false .
     1632         run factord-lock-shift (
     1633             input p-obj-type ,
     1634             input p-obj-code ,
     1635             input date('01/01/1900')  ,
     1636             buffer buf_shift-obj
     1637         ) no-error .
     1638         if error-status :error then do:
     1639           p-is-new = true  .
     1640         end.
     1641     end.
     1642   end procedure.
