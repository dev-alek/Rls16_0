        1   block-level on error undo, throw.
        2   define input        parameter p-obj-type          as character no-undo .
        3   define input        parameter p-obj-code          as integer   no-undo .
        4   define input        parameter p-verify-detail     as logical   no-undo .
        5   define input        parameter p-verify-arh        as logical   no-undo .
        6   define input        parameter p-verify-ahsp       as logical   no-undo .
        7   define input        parameter p-verify-aht        as logical   no-undo .
