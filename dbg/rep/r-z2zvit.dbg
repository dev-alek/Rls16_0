     1026   with frame TopFrame width 232 page-top no-labels no-box.
     1027     procedure on-same-page :
     1028       define input parameter p-line-number as integer no-undo .
     1029       if p-line-number > page-size( PrnLibstream )
     1030       then do:
     1031         return .
     1032       end.
     1033       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     1034       then do:
     1035         page stream PrnLibstream .
     1036       end.
     1037     end procedure.
     1038   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1039     if num-entries(string(p-dec), '.') = 2
     1040       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1041       else return( string(p-dec)) .
     1042   end function.
     1043   function format-point-to-comma returns char (input orig as char ) .
     1044   define variable rtext as character no-undo .
     1045   define variable strt as integer no-undo .
     1046   define variable leng as integer no-undo .
     1047   assign rtext = orig .
     1048   repeat:
     1049     strt =  index(rtext,'.').
     1050     if strt = 0 then leave.
     1051     leng = 1.
     1052     substring(rtext,strt,leng,"character") = v-delim .
     1053   end.
     1054   return rtext.
     1055   end function.
     1056   function format-excel-text returns char ( input start-text as char ) :
     1057   def var  i    as int no-undo.
     1058   def var  ch   as char no-undo.
     1059   def var  n    as int no-undo.
     1060   def var  ipos as int no-undo.
     1061     n = num-entries(trim(start-text), chr(10)) - 1 .
     1062     do i = 1 to n :
     1063       ipos = index( start-text, chr(10)).
     1064       if ipos > 0 then
     1065         substr( start-text, ipos, 1 ) = ' '.
     1066     end.
     1067     n = num-entries(trim(start-text), chr(13)) - 1 .
     1068     do i = 1 to n :
     1069       ipos = index( start-text, chr(13)).
     1070       if ipos > 0 then
     1071         substr( start-text, ipos, 1 ) = ' '.
     1072     end.
     1073     if index( start-text, '"' ) = 0 then
     1074       start-text =  '="'   + trim( start-text) + '"'   .
     1075       else do:
     1076         n = num-entries(trim(start-text), '"') - 1.
     1077         do i = 1 to n :
     1078           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1079         end.
     1080         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1081         start-text = '="'  + ch  + '"' .
     1082       end.
     1083     return start-text.
     1084   end.
     1085   function excel-sum returns char (input p-dec as decimal ).
     1086     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1087   end function.
     1088   function excel-qnty returns char (input p-dec as decimal ).
     1089     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1090   end function.
     1091   function format-excel-text-macr returns char ( input start-text as char ) :
     1092   def var  i    as int no-undo.
     1093   def var  ch   as char no-undo.
     1094   def var  n    as int no-undo.
     1095   def var  ipos as int no-undo.
     1096     n = num-entries(trim(start-text), chr(10)) - 1 .
     1097     do i = 1 to n :
     1098       ipos = index( start-text, chr(10)).
     1099       if ipos > 0 then
     1100         substring( start-text, ipos , 1 ) = ' '.
     1101     end.
     1102     n = num-entries(trim(start-text), chr(13)) - 1 .
     1103     do i = 1 to n :
     1104       ipos = index( start-text, chr(13)).
     1105       if ipos > 0 then
     1106         substring( start-text, ipos, 1 ) = ' '.
     1107     end.
     1108     if index( start-text, '"' ) = 0 then
     1109       start-text =  '"'   + trim( start-text) + '"'   .
     1110       else do:
     1111         n = num-entries(trim(start-text), '"') - 1.
     1112         do i = 1 to n :
     1113           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1114         end.
     1115         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1116         start-text = '"'  + ch  + '"' .
     1117       end.
     1118     n = num-entries(trim(start-text), chr(10)) - 1 .
     1119     do i = 1 to n :
     1120       ipos = index( start-text, chr(10)).
     1121       if ipos > 0 then
     1122         substring( start-text, ipos , 1 ) = ' '.
     1123     end.
     1124       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1125     return start-text.
     1126   end.
     1127   define buffer end_shift-obj      for ub.shift-obj .
     1128   define buffer previous-shift-obj for ub.shift-obj.
     1129   define variable fo      as decimal no-undo init 0.
     1130   define variable prev-fo as decimal no-undo init 0.
     1131   define variable moving  as logical no-undo init yes.
     1132   find first end_shift-obj share-lock
     1133     where end_shift-obj.obj-type   = pobj-type
     1134       and end_shift-obj.obj-code   = pobj-code
     1135       and end_shift-obj.shift-date = pshift-date1
     1136       and end_shift-obj.shift-num  = pshift-num1
     1137       no-error.
     1138   if not available end_shift-obj then do:
     1139     message
