      769   define shared stream PrnLibStream.
      770   procedure prn-lib-prn-file :
      771     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      772     define input parameter p-DIsabledoptions as integer no-undo .
      773     define variable v-report-name as character no-undo .
      774     define variable v-user-action as character no-undo .
      775     define variable v-printed     as logical   no-undo .
      776     define variable v-exist       as logical   no-undo .
      777     do
      778       on error undo, return error
      779       :
      780       run prn-lib-get-report-name  in this-procedure (
      781         input parParentProc
      782         ,output v-report-name
      783         ).
      784   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      785   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      786     (input  v-report-name
      787     ,input  2
      788     ,output v-exist
      789     )  .
      790       if NOT v-exist then
      791       DO:
      792         Message
      793           "Нет заданий на печать ! "
      794           view-as alert-box .
      795         Return  .
      796       End.
      797       run gbl/prnfilen.w
      798         (input  ""
      799         ,input  p-DisabledOptions
      800         ,input  string(v-report-name )
      801         ,input  7
      802         ,output v-user-action
      803         ,output v-printed
      804         ) .
      805       if v-printed then
      806       do:
      807         return "YES" .
      808       end.
      809       else
      810       do:
      811         return "NO" .
      812       end.
      813     end.
      814   end procedure.
      815   procedure prn-lib-open-stream :
      816     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      817     define input parameter p-page-size    as integer no-undo .
      818     define input parameter p-is-stream    as logical no-undo .
      819     define input parameter p-append       as logical no-undo .
      820     define variable v-report-name as character no-undo .
      821     do
      822       on error undo, return error
      823       :
      824       run prn-lib-get-report-name  in this-procedure (
      825         input parParentProc
      826         ,output v-report-name
      827         ).
      828       if p-is-stream then
      829       do:
      830         if p-append then
      831         do:
      832           output stream PrnLibStream to value( v-report-name )
      833             page-size value(p-page-size) append .
      834         end.
      835         if not p-append then
      836         do:
      837           output stream PrnLibStream to value( v-report-name )
      838             page-size value(p-page-size) .
      839         end.
      840       end.
      841       if not p-is-stream then
      842       do:
      843         if p-append then
      844         do:
      845           output to value( v-report-name )
      846             page-size value(p-page-size) append .
      847         end.
      848         if not p-append then
      849         do:
      850           output to value( v-report-name )
      851             page-size value(p-page-size) .
      852         end.
      853       end.
      854     end.
      855   end procedure.
      856   procedure prn-lib-open-exp :
      857     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      858     define input parameter p-is-stream    as logical no-undo .
      859     define input parameter p-is-append    as logical no-undo .
      860     define output parameter p-ReportFileName as char init "report" no-undo.
      861     define output parameter p-process as logical no-undo .
      862     define variable glog as logical no-undo .
      863     do
      864       on error undo, return error
      865       :
      866       SYSTEM-DIALOG GET-FILE p-ReportFileName
      867         TITLE      "Укажите путь"
      868         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      869         ASK-OVERWRITE
      870         CREATE-TEST-FILE
      871         SAVE-AS
      872         USE-FILENAME
      873         DEFAULT-EXTENSION "txt"
      874         UPDATE glog
      875         .
      876       if not glog then  return.
      877       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      878       if p-is-stream then
      879       do:
      880         if p-is-append then
      881         do:
      882           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      883         end.
      884         else
      885         do:
      886           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      887         end.
      888       end.
      889       else
      890       do:
      891         if p-is-append then
      892         do:
      893           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      894         end.
      895         else
      896         do:
      897           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      898         end.
      899       end.
      900       p-process = yes.
      901     end.
      902   end procedure.
      903   procedure prn-lib-get-report-name :
      904     define input parameter parParentProc  as widget-handle no-undo.
      905     define output parameter p-report-name as character no-undo .
      906     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      907   end procedure.
      908   procedure prn-lib-reportviewer-report-name :
      909     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      910     define input parameter p-report-name-html as character no-undo .
      911     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      912   end procedure.
      913   procedure prn-lib-reportviewer :
      914     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      915     define input parameter p-report-name-html as character no-undo .
      916     define input parameter p-param        as character no-undo .
      917     define variable v-excel           as character no-undo init 'TRUE' .
      918     define variable v-value-character as character no-undo .
      919     define variable v-value-integer   as character no-undo .
      920     define variable v-value-date      as date      no-undo .
      921     define variable v-value-decimal   as decimal   no-undo .
      922     define variable rep-excel         as logical   no-undo .
      923     define variable excel-string      as character no-undo .
      924     define variable v-param-type      as character no-undo .
      925     define variable v-tth             as handle    no-undo .
      926     run adm/shattri.p (
      927       input "get":U
      928       ,input  ""
      929       ,input  0
      930       ,input  'report-glob':U
      931       ,input  'rep-excel':U
      932       ,output v-value-character
      933       ,output v-value-date
      934       ,output v-value-decimal
      935       ,output v-value-integer
      936       ,output rep-excel
      937       ,output v-param-type
      938       ,INPUT-OUTPUT table-handle v-tth
      939       )  .
      940     if rep-excel then v-excel = "TRUE" .
      941     else v-excel = "FALSE" .
      942     if p-param eq ""
      943     then
      944        p-param = "EXCEL:" + v-excel.
      945     else
      946        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      947     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      948   end procedure.
