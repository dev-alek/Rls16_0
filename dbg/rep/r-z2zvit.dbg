     1248                previous_rvs-doc.shift-num  = previous-shift-obj.shift-num  and
     1249                previous_rvs-doc.status_    = 'факт':U                       and
     1250                previous_rvs-doc.rvs-type   = 'смена':U                  no-error.
     1251   end.
