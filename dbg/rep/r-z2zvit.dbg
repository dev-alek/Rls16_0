     1297                    previous_rvs-line-pump.rvs-code    = previous_rvs-doc.rvs-code         and
     1298                    previous_rvs-line-pump.obj-code    = current_rvs-line.obj-code         and
     1299                    previous_rvs-line-pump.obj-type    = current_rvs-line.obj-type         and
     1300                    previous_rvs-line-pump.pl-code     = current_rvs-line.pl-code          and
     1301                    previous_rvs-line-pump.gds-code    = current_rvs-line.gds-code         and
