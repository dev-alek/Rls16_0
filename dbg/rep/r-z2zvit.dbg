      739   PROCEDURE create-treal-2.
      740   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      741   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      742   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      743   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      744   DEFINE INPUT PARAMETER pqnty2 as decimal no-undo.
      745   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      746   DEFINE INPUT PARAMETER pout-name as character no-undo.
      747   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      748   DEFINE INPUT PARAMETER pii as integer no-undo.
      749   _main:
      750   DO ON ERROR UNDO _main, return error:
      751       create treal-2.
      752       assign
      753       treal-2.gds-code = pgds-code
      754       treal-2.cpay-code = pcpay-code
      755       treal-2.curr-code = pcurr-code
      756       treal-2.qnty1  =  pqnty1
      757       treal-2.qnty2  = pqnty2
      758       treal-2.netto = pnetto
      759       treal-2.out-name = pout-name
      760       treal-2.is-pay = pis-pay
      761       treal-2.ii = pii
      762       treal-2.discnt-type = -99
      763       no-error
      764       .
      765       if error-status:error then undo _main, return error.
      766   END.
      767   END PROCEDURE.
