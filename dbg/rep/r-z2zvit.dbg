     1307       end.
     1308       if not available previous_rvs-doc       or
     1309          not available previous_rvs-line-pump then do:
     1310         for each  control_rvs-doc no-lock where
     1311                   control_rvs-doc.obj-type          = current_rvs-doc.obj-type          and
     1312                   control_rvs-doc.obj-code          = current_rvs-doc.obj-code          and
     1313                   control_rvs-doc.shift-date        = current_rvs-doc.shift-date        and
     1314                   control_rvs-doc.shift-num         = current_rvs-doc.shift-num         and
     1315                   control_rvs-doc.status_           = 'факт':U                           and
     1316                   control_rvs-doc.rvs-type          = 'контроль':U
     1317           , first control_rvs-line-pump no-lock where
     1318                   control_rvs-line-pump.rvs-code    = control_rvs-doc.rvs-code          and
     1319                   control_rvs-line-pump.gds-code    = current_rvs-line.gds-code         and
     1320                   control_rvs-line-pump.obj-code    = current_rvs-line.obj-code         and
     1321                   control_rvs-line-pump.obj-type    = current_rvs-line.obj-type         and
     1322                   control_rvs-line-pump.pl-code     = current_rvs-line.pl-code          and
     1323                   control_rvs-line-pump.pump-code   = current_rvs-line-pump.pump-code   and
     1324                   control_rvs-line-pump.nozzle-code = current_rvs-line-pump.nozzle-code
     1325                by control_rvs-doc.fact-order        :
     1326           assign pol11 = pol11 + control_rvs-line-pump.state-mh-cnt.
     1327           leave.
     1328         end.
     1329       end.
     1330       if last-of( current_rvs-line-pump.pump-code ) then do:
     1331         assign pol12 = pol10 - pol11
     1332                pol14 = 0
     1333                pol15 = 0.
     1334         find first tt-zz2 where
     1335                    tt-zz2.gds-code  = current_rvs-line-pump.gds-code  and
     1336                    tt-zz2.pl-code   = current_rvs-line-pump.pl-code   and
     1337                    tt-zz2.pump-code = current_rvs-line-pump.pump-code no-error.
     1338         if not available tt-zz2 then do:
     1339           assign jndex = jndex + 1.
     1340           create tt-zz2.
     1341           assign tt-zz2.gds-code  = bf_goods.gds-code
     1342                  tt-zz2.artic     = bf_goods.artic
     1343                  tt-zz2.prod-type = bf_goods.prod-type
     1344                  tt-zz2.prod-code = bf_goods.prod-code
     1345                  tt-zz2.gds-name  = bf_goods.gds-name
     1346                  tt-zz2.b-code    = v-bar-code
     1347                  tt-zz2.reservoir = ( if available bf_place then trim( bf_place.loc1 ) else "??" )
     1348                  tt-zz2.pl-code   = current_rvs-line-pump.pl-code
     1349                  tt-zz2.pump-code = current_rvs-line-pump.pump-code
     1350                  tt-zz2.order     = jndex.
     1351         end.
     1352         assign tt-zz2.shift-stop  = pol10
     1353                tt-zz2.shift-start = pol11
     1354                tt-zz2.mh-real     = pol12.
     1355       end.
     1356     end.
     1357   end.
     1358   for each tt-zz2 no-lock
     1359   break by tt-zz2.gds-code
     1360         by tt-zz2.pl-code
     1361         by tt-zz2.pump-code
     1362   :
     1363     if first-of( tt-zz2.pl-code ) then do:
     1364       assign pol13 = 0.
     1365     end.
     1366     assign pol13 = pol13 + tt-zz2.mh-real.
     1367     if last-of( tt-zz2.pl-code ) then do:
     1368       find first current_rvs-line no-lock where
     1369                  current_rvs-line.rvs-code = current_rvs-doc.rvs-code and
     1370                  current_rvs-line.obj-type = current_rvs-doc.obj-type and
     1371                  current_rvs-line.obj-code = current_rvs-doc.obj-code and
     1372                  current_rvs-line.pl-code  = tt-zz2.pl-code           and
     1373                  current_rvs-line.gds-code = tt-zz2.gds-code          no-error.
     1374       find first bf_zz2 where
     1375                  bf_zz2.gds-code = tt-zz2.gds-code and
     1376                  bf_zz2.pl-code  = tt-zz2.pl-code  use-index pl-order no-error.
     1377       assign bf_zz2.mh-total    = pol13
     1378              bf_zz2.level-total = current_rvs-line.state-level-total * 10
     1379              bf_zz2.level-water = current_rvs-line.state-level-water * 10
     1380              bf_zz2.pipe-line   = current_rvs-line.state-add-qnty
     1381              bf_zz2.shift-qnty  = ( if v-param-shft-qty = "state":U then current_rvs-line.state-measure-qnty
     1382                                                                     else current_rvs-line.system-qnty        )
     1383              pol13              = 0.
     1384     end.
     1385     if last-of( tt-zz2.gds-code ) then do:
     1386       find first current_rvs-line no-lock where
     1387                  current_rvs-line.rvs-code = current_rvs-doc.rvs-code and
     1388                  current_rvs-line.obj-type = current_rvs-doc.obj-type and
     1389                  current_rvs-line.obj-code = current_rvs-doc.obj-code and
     1390                  current_rvs-line.pl-code  = tt-zz2.pl-code           and
     1391                  current_rvs-line.gds-code = tt-zz2.gds-code          no-error.
     1392       find first bf_zz2 where
     1393                  bf_zz2.gds-code = tt-zz2.gds-code use-index gds-order no-error.
     1394       assign bf_zz2.differ-qnty = ( if v-param-shft-qty = "state":U then current_rvs-line.state-measure-qnty
     1395                                                                     else current_rvs-line.system-qnty        )
     1396                                 - current_rvs-line.system-qnty.
     1397     end.
     1398   end.
     1399   assign pol1  = "":U
     1400          pol2  = "":U
     1401          pol3  = 0
     1402          pol4  = 0
     1403          pol5  = 0
     1404          pol6  = 0
     1405          pol7  = 0
     1406          pol8  = 0
     1407          pol9  = 0
     1408          pol10 = 0
     1409          pol11 = 0
     1410          pol12 = 0
     1411          pol13 = 0
     1412          pol14 = 0
     1413          pol15 = 0.
     1414   if p-can-print = yes then do:
     1415     view stream PrnLibStream frame TopFrame.
     1416     for each tt-zz2 no-lock
     1417     break by tt-zz2.gds-code
     1418           by tt-zz2.pl-code
     1419           by tt-zz2.pump-code
     1420     :
     1421       assign pol1  = tt-zz2.gds-name
     1422              pol2  = tt-zz2.reservoir
     1423              pol3  = tt-zz2.level-total
     1424              pol4  = tt-zz2.level-water
     1425              pol5  = tt-zz2.pipe-line
     1426              pol6  = tt-zz2.shift-qnty
     1427              pol7  = ( if tt-zz2.differ-qnty > 0 then tt-zz2.differ-qnty else 0 )
     1428              pol8  = ( if tt-zz2.differ-qnty < 0 then tt-zz2.differ-qnty else 0 )
     1429              pol9  = tt-zz2.pump-code
     1430              pol10 = tt-zz2.shift-stop
     1431              pol11 = tt-zz2.shift-start
     1432              pol12 = tt-zz2.mh-real
     1433              pol13 = tt-zz2.mh-total
     1434              pol14 = tt-zz2.delta-prc
     1435              pol15 = tt-zz2.delta-qnty.
     1436       display stream PrnLibStream sym1
     1437                                   sym9
     1438                                   sym10
     1439                                   sym11
     1440                                   sym12
     1441                                   sym13
     1442                                   sym14
     1443                                   sym15
     1444                                   sym16
     1445       with frame FRAME-2.
     1446       if first-of( tt-zz2.gds-code ) then do:
     1447         assign o-pol2 = pol2.
     1448         display stream PrnLibStream pol1                sym2
     1449                                     pol2                sym3
     1450                                     pol3 when pol3 <> ? sym4
     1451                                     pol4 when pol4 <> ? sym5
     1452                                     pol5 when pol5 <> ? sym6
     1453                                     pol6                sym7
     1454                                     pol7 when pol7 >  0 sym8
     1455                                     pol8 when pol8 <  0 sym9
     1456         with frame FRAME-2.
     1457           if Make-Excel then  put   stream ForExcel unformatted pol1  CHR(9)
     1458                       pol2  CHR(9).
     1459             if pol3 <> ? then do:
     1460           if Make-Excel then  put   stream ForExcel unformatted pol3  CHR(9).
     1461             end.
     1462             else do:
     1463           if Make-Excel then  put   stream ForExcel unformatted       CHR(9).
     1464             end.
     1465             if pol4 <> ? then do:
     1466           if Make-Excel then  put   stream ForExcel unformatted pol4  CHR(9).
     1467             end.
     1468             else do:
     1469           if Make-Excel then  put   stream ForExcel unformatted       CHR(9).
     1470             end.
     1471             if pol5 <> ? then do:
     1472           if Make-Excel then  put   stream ForExcel unformatted pol5  CHR(9).
     1473             end.
     1474             else do:
     1475           if Make-Excel then  put   stream ForExcel unformatted       CHR(9).
     1476             end.
     1477           if Make-Excel then  put   stream ForExcel unformatted pol6  CHR(9).
     1478             if pol7  > 0 then do:
     1479           if Make-Excel then  put   stream ForExcel unformatted pol7  CHR(9).
     1480             end.
     1481             else do:
     1482           if Make-Excel then  put   stream ForExcel unformatted       CHR(9).
     1483             end.
     1484             if pol8 <  0 then do:
     1485           if Make-Excel then  put   stream ForExcel unformatted pol8  CHR(9).
     1486             end.
     1487             else do:
     1488           if Make-Excel then  put   stream ForExcel unformatted       CHR(9).
     1489             end.
     1490       end.
     1491       else do:
     1492         if Make-Excel then  put   stream ForExcel unformatted       CHR(9).
     1493           if pol12 <> 0 then do:
     1494         if Make-Excel then  put   stream ForExcel unformatted pol2  CHR(9).
     1495           end.
     1496           else do:
     1497         if Make-Excel then  put   stream ForExcel unformatted       CHR(9).
     1498           end.
     1499         if Make-Excel then  put   stream ForExcel unformatted       CHR(9)
     1500                           CHR(9)
     1501                           CHR(9)
     1502                           CHR(9)
     1503                           CHR(9)
     1504                           CHR(9).
     1505       end.
     1506       display stream PrnLibStream pol2  when pol2  <> o-pol2
     1507                                   sym2  when pol2  <> o-pol2
     1508                                   sym3  when pol2  <> o-pol2
     1509                                   pol9
     1510                                   pol10
     1511                                   pol11
     1512                                   pol12 when pol12 <> 0
     1513                                   pol13
     1514                                   pol14
     1515                                   pol15
     1516       with frame FRAME-2.
     1517       down stream PrnLibStream with frame FRAME-2.
     1518       if Make-Excel then  put   stream ForExcel unformatted pol9  CHR(9)
     1519                   pol10 CHR(9)
     1520                   pol11 CHR(9).
     1521         if pol12 <> 0 then do:
     1522       if Make-Excel then  put   stream ForExcel unformatted pol12 CHR(9).
     1523         end.
     1524         else do:
     1525       if Make-Excel then  put   stream ForExcel unformatted       CHR(9).
     1526         end.
     1527       if Make-Excel then  put   stream ForExcel unformatted pol13 CHR(9)
     1528                   pol14 CHR(9)
     1529                   pol15 chr(10).
     1530       if last( tt-zz2.gds-code ) then do:
     1531         put stream PrnLibStream unformatted
     1532           "----------------------------------------------------------------------------------------------------------------------------------------" skip.
     1533       end.
     1534     end.
     1535   end.
