      217   def
      218    shared
      219   temp-table  obj-list no-undo
      220     field obj-type like ub.clients.obj-type
      221     field obj-code like ub.clients.obj-code
      222     field obj-name like ub.clients.obj-name
      223     field obj-id   as integer
