      229   procedure create_obj-list :
      230      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      231      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      232      do
      233      on error undo, return error return-value
      234      :
      235         define buffer cli-obj for ub.clients .
      236         define variable p-var as integer no-undo .
      237         define buffer buf_obj-list for obj-list .
      238         find last buf_obj-list  use-index pi no-error .
      239         if available buf_obj-list
      240         then
      241            p-var = buf_obj-list.obj-id + 1.
      242         else
      243            p-var = 1.
      244         find first cli-obj where
      245                   cli-obj.obj-type = p-obj-type
      246               and cli-obj.obj-code = p-obj-code
      247         no-lock no-error.
      248         if available cli-obj
      249         then do:
      250            create buf_obj-list.
      251            assign
      252               buf_obj-list.obj-id   = p-var
      253               buf_obj-list.obj-code = cli-obj.obj-code
      254               buf_obj-list.obj-type = cli-obj.obj-type
      255               buf_obj-list.obj-name = cli-obj.obj-name
      256               buf_obj-list.db-num   = cli-obj.db-num
      257            .
      258         end.
      259      end.
      260   end.
