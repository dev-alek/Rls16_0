     1141       substitute("Не найдена смена с порядковым номером &1 от &2 для объекта &3 &4", pshift-num1, pshift-date1, pobj-type, pobj-code ) skip
     1142       view-as alert-box error .
     1143     return error.
     1144   end.
     1145   else do:
     1146     assign
     1147       fo = end_shift-obj.fact-order
     1148     .
     1149   end.
     1150   find last previous-shift-obj share-lock
     1151     where previous-shift-obj.obj-type = pobj-type
     1152       and previous-shift-obj.obj-code = pobj-code
     1153       and (( previous-shift-obj.shift-date = pshift-date
     1154              and previous-shift-obj.shift-num < pshift-num
     1155            )
     1156            or previous-shift-obj.shift-date < pshift-date
     1157           )
     1158       use-index pi no-error.
     1159   if available previous-shift-obj then do:
     1160       assign
     1161         prev-fo = previous-shift-obj.fact-order
     1162       .
     1163   end.
