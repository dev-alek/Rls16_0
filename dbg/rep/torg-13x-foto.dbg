     3860            where buf_person.psn-code = buf_trn-doc.boss
     3861            no-error.
     3862            if available buf_person
     3863            then do:
     3864               v-torgconf-ogr-post = buf_person.position.
     3865            end.
     3866            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3867            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3868         end.
     3869      end.
     3870      else do:
     3871      find first buf_wth-doc no-lock
     3872         where buf_wth-doc.doc-code = p-doc-code
     3873         no-error.
     3874         if available buf_wth-doc
     3875            then do:
     3876   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3877   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3878     (input  buf_wth-doc.obj-type
     3879     ,input  buf_wth-doc.obj-code
     3880     ,output v-host-code
     3881     )  .
     3882            end.
     3883         if v-torgconf-outogr = "no_print"
     3884            then do:
     3885               assign
     3886                  v-torgconf-ogr-name = ""
     3887                  v-torgconf-ogr-post = ""
     3888               .
     3889            end.
     3890         if v-torgconf-outogr  = "ruk_firm"
     3891               then do:
     3892               find first buf_sysconf no-lock
     3893               where buf_sysconf.host-code = v-host-code
     3894               no-error.
     3895               if available buf_sysconf
     3896               then do:
     3897                  assign
     3898                     v-torgconf-ogr-post = buf_sysconf.head-position
     3899                  .
     3900               end.
     3901               find first buf_clients no-lock
     3902                  where buf_clients.obj-type = 'орг':U
     3903                  and buf_clients.obj-code = v-host-code
     3904               .
     3905               find first buf_firm no-lock
     3906                  where buf_firm.firm-code = buf_clients.obj-code
     3907               .
     3908               assign
     3909                  v-torgconf-ogr-name = buf_firm.director
     3910               .
     3911            end.
     3912            if v-torgconf-outogr = "dir_obj"
     3913               then do:
     3914               find first buf_wth-doc no-lock
     3915               where buf_wth-doc.doc-code = p-doc-code
     3916               no-error.
     3917                  find first buf_shop no-lock
     3918                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3919                  .
     3920                  assign
     3921                     v-torgconf-ogr-name = buf_shop.director
     3922                     v-torgconf-ogr-post = "Директор"
     3923                  .
     3924               end.
     3925         if v-torgconf-outogr = "manag_doc"
     3926            then do:
     3927               find first buf_wth-doc no-lock
     3928               where buf_wth-doc.doc-code = p-doc-code
     3929               no-error.
     3930               if available buf_wth-doc
     3931               then do:
     3932                  run rep/get-psn.p
     3933                  (input buf_wth-doc.deliver
     3934                  ,output v-torgconf-ogr-name
     3935                  ) .
     3936               end.
     3937               find first buf_person no-lock
     3938               where buf_person.psn-code = buf_wth-doc.deliver
     3939               no-error.
     3940               if available buf_person
     3941               then do:
     3942                  v-torgconf-ogr-post = buf_person.position.
     3943               end.
     3944               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3945               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3946            end.
     3947      end.
     3948   end.
     3949   end procedure.
     3950   procedure torgconf-get-outogr-param:
     3951       define input parameter p-form-name  as character    no-undo.
     3952       define input parameter p-host-code  as integer      no-undo.
     3953       define input parameter p-obj-type   as character    no-undo.
     3954       define input parameter p-obj-code   as integer      no-undo.
     3955       define input parameter p-doc-code   as character      no-undo.
     3956       define buffer buf_firm          for ub.firm .
     3957       define buffer buf_clients       for ub.clients .
     3958       define buffer buf_sysconf       for ub.sysconf .
     3959       define buffer buf_shop          for ub.shop .
     3960       define buffer buf_store         for ub.store .
     3961       define buffer buf_person        for ub.person .
     3962       define buffer buf_trn-doc       for ub.trn-doc .
     3963       define buffer buf_wth-doc       for ub.wth-doc .
     3964      if  p-form-name <> 'wthtrg12':U
     3965      and p-form-name <> 'wthfct':U
     3966      and p-form-name <> 'wthm11':U
     3967      then do:
     3968       find first buf_trn-doc no-lock
     3969       where buf_trn-doc.doc-code = p-doc-code
     3970       no-error.
     3971       if v-torgconf-outogr = "no_print"
     3972         then do:
     3973            assign
     3974               v-torgconf-ogr-name = ""
     3975               v-torgconf-ogr-post = ""
     3976            .
     3977         end.
     3978      if v-torgconf-outogr  = "ruk_firm"
     3979            then do:
     3980            find first buf_sysconf no-lock
     3981            where buf_sysconf.host-code = p-host-code
     3982            no-error.
     3983            if available buf_sysconf
     3984            then do:
     3985               assign
     3986                  v-torgconf-ogr-post = buf_sysconf.head-position
     3987               .
     3988            end.
     3989            find first buf_clients no-lock
     3990                where buf_clients.obj-type = 'орг':U
     3991                and buf_clients.obj-code = p-host-code
     3992            .
     3993            find first buf_firm no-lock
     3994                where buf_firm.firm-code = buf_clients.obj-code
     3995            .
     3996            assign
     3997                v-torgconf-ogr-name = buf_firm.director
     3998            .
     3999         end.
     4000         if v-torgconf-outogr = "dir_obj"
     4001            then do:
     4002            find first buf_trn-doc no-lock
     4003            where buf_trn-doc.doc-code = p-doc-code
     4004            no-error.
     4005               CASE buf_trn-doc.obj-type:
     4006               WHEN 'маг':U
     4007               THEN DO:
     4008                  find first buf_shop no-lock
     4009                  where buf_shop.obj-code = buf_trn-doc.obj-code
     4010                  .
     4011                  assign
     4012                     v-torgconf-ogr-name = buf_shop.director
     4013                     v-torgconf-ogr-post = "Директор"
     4014                  .
     4015               END.
     4016               WHEN 'скл':U
     4017               THEN DO:
     4018                  find first buf_store no-lock
     4019                  where buf_store.obj-code = buf_trn-doc.obj-code
     4020                  .
     4021                  assign
     4022                     v-torgconf-ogr-name = buf_store.store-boss
     4023                     v-torgconf-ogr-post = "Директор"
     4024                  .
     4025               END.
     4026               OTHERWISE DO:
     4027                  assign
     4028                     v-torgconf-ogr-name = "":U
     4029                     v-torgconf-ogr-post = "":U
     4030                  .
     4031               END.
     4032               END CASE.
     4033            end.
     4034      if v-torgconf-outogr = "manag_doc"
     4035         then do:
     4036            find first buf_trn-doc no-lock
     4037            where buf_trn-doc.doc-code = p-doc-code
     4038            no-error.
     4039            if available buf_trn-doc
     4040            then do:
     4041               run rep/get-psn.p
     4042               (input buf_trn-doc.boss
     4043               ,output v-torgconf-ogr-name
     4044               ) .
     4045            end.
     4046            find first buf_person no-lock
     4047            where buf_person.psn-code = buf_trn-doc.boss
     4048            no-error.
     4049            if available buf_person
     4050            then do:
     4051               v-torgconf-ogr-post = buf_person.position.
     4052            end.
     4053            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4054            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4055         end.
     4056      end.
     4057      else do:
     4058      find first buf_wth-doc no-lock
     4059         where buf_wth-doc.doc-code = p-doc-code
     4060         no-error.
     4061         if v-torgconf-outogr = "no_print"
     4062            then do:
     4063               assign
     4064                  v-torgconf-ogr-name = ""
     4065                  v-torgconf-ogr-post = ""
     4066               .
     4067            end.
     4068         if v-torgconf-outogr  = "ruk_firm"
     4069               then do:
     4070               find first buf_sysconf no-lock
     4071               where buf_sysconf.host-code = p-host-code
     4072               no-error.
     4073               if available buf_sysconf
     4074               then do:
     4075                  assign
     4076                     v-torgconf-ogr-post = buf_sysconf.head-position
     4077                  .
     4078               end.
     4079               find first buf_clients no-lock
     4080                  where buf_clients.obj-type = 'орг':U
     4081                  and buf_clients.obj-code = p-host-code
     4082               .
     4083               find first buf_firm no-lock
     4084                  where buf_firm.firm-code = buf_clients.obj-code
     4085               .
     4086               assign
     4087                  v-torgconf-ogr-name = buf_firm.director
     4088               .
     4089            end.
     4090            if v-torgconf-outogr = "dir_obj"
     4091               then do:
     4092               find first buf_wth-doc no-lock
     4093               where buf_wth-doc.doc-code = p-doc-code
     4094               no-error.
     4095                  find first buf_shop no-lock
     4096                  where buf_shop.obj-code = buf_wth-doc.obj-code
     4097                  .
     4098                  assign
     4099                     v-torgconf-ogr-name = buf_shop.director
     4100                     v-torgconf-ogr-post = "Директор"
     4101                  .
     4102               end.
     4103         if v-torgconf-outogr = "manag_doc"
     4104            then do:
     4105               find first buf_wth-doc no-lock
     4106               where buf_wth-doc.doc-code = p-doc-code
     4107               no-error.
     4108               if available buf_wth-doc
     4109               then do:
     4110                  run rep/get-psn.p
     4111                  (input buf_wth-doc.deliver
     4112                  ,output v-torgconf-ogr-name
     4113                  ) .
     4114               end.
     4115               find first buf_person no-lock
     4116               where buf_person.psn-code = buf_wth-doc.deliver
     4117               no-error.
     4118               if available buf_person
     4119               then do:
     4120                  v-torgconf-ogr-post = buf_person.position.
     4121               end.
     4122               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4123               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4124            end.
     4125      end.
     4126   end.
     4127   procedure torgconf-get-reason  :
     4128   define input parameter  p-doc-code       as character        no-undo.
     4129   define input parameter  p-reason-code    as integer          no-undo .
     4130   define input parameter  p-doc-type       as character        no-undo.
     4131       if p-reason-code > 0
     4132       then do:
     4133           define buffer buf_trn-reason for ub.trn-reason.
     4134           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4135           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4136       end.
     4137       else do:
     4138           if p-doc-type = 'при':U
     4139           then  do:
     4140               define variable v-attr-type     as character    no-undo.
     4141               define variable v-attr-value    as character    no-undo.
     4142               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4143               assign v-torgconf-reason = v-attr-value .
     4144               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4145               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4146           end.
     4147       end.
     4148   end procedure.
