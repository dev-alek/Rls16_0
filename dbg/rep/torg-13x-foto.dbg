     6079                   ' </td>' skip
     6080                   '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     6081                   '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     6082                   '         <td style="display: yes; text-align:  right ">'    +  if  tqnty  <> ?  then fnc-convert-dot-to-colon( tqnty , "->>>>>>>9" ) + '</td>' else "?" + '</td>' skip
     6083                   '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon( PricewithNDS , "->>>>>>>9.99" ) + '</td>' else "?" + '</td>' skip
     6084                   '         <td  style="display: yes; text-align:  right "> '  +  if SumNoNDS <> ?  then fnc-convert-dot-to-colon( SumNoNDS , "->>>>>>>9.99" ) + '</td>' else "?" + '</td>' skip
     6085                   '         <td style="display: yes; text-align:  right ">' +  if  SumwithNDS <> ?  then fnc-convert-dot-to-colon( SumwithNDS , "->>>>>>>9.99" )  + '</td>' else "?" + '</td>' skip
     6086                   '       </tr>' skip
     6087                   .
     6088           end.
     6089       end.
     6090       assign
     6091           sum-tqnty      = sum-tqnty       + tqnty
     6092           sum-SumNoNDS   = sum-SumNoNDS    + SumNoNDS
     6093           sum-SumNDS     = sum-SumNDS      + SumNDS
     6094           sum-SumwithNDS = sum-SumwithNDS  + SumwithNDS
     6095           .
     6096   end procedure.
     6097   if PrintRubl then
     6098       run rep/wp-rub.p ( sum-SumwithNDS, output s1, output s2 ) .
     6099   else
     6100       run rep/wp.p ( input  parparentproc  , sum-SumwithNDS, output s1, output s2 ) .
     6101   do:
     6102       put stream OutStr-html unformatted
     6103           '       <tr >' skip
