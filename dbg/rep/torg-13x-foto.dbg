     6106           '         <td style="display: yes; font-weight: bold; text-align:  right ">'    +  if  Pg-tqnty  <> ?  then fnc-convert-dot-to-colon( Pg-tqnty , "->>>>>>>9" ) + '</td>' else "?" + '</td>' skip
