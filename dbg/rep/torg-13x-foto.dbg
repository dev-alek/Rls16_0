     5864           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     5865       end.
     5866     end.
     5867   end.
     5868   assign
     5869     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     5870     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     5871           assign
     5872               PricendS = ( if PrintRubl then vat-rubl-sale else vat-base-sale ).
     5873           if PricendS = ? then assign PricendS = 0.
     5874           assign
     5875               PricewithNDS = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale )
     5876               PriceNoNDS   = PricewithNDS - PricendS
     5877               .
     5878       end.
     5879       if not can-do( '_Пустая шкала':U, gds-prt.node-name )
     5880           then
     5881       do:
     5882           if PrintScale = yes
     5883               then
     5884           do:
     5885               for each gds-dtl no-lock
     5886                   where gds-dtl.prod-type = doc-line.prod-type
     5887                   and gds-dtl.prod-code = doc-line.prod-code
     5888                   and gds-dtl.artic = doc-line.artic
     5889                   and gds-dtl.doc-code = doc-line.doc-code
     5890                   :
     5891                   find first gds-prt no-lock
     5892                       where gds-prt.node-code = gds-dtl.prt-code
     5893                       .
     5894                   assign
     5895                       prt-tqnty      = gds-dtl.fact-qnty
     5896                       prt-SumNoNDS   = PriceNoNDS * prt-tqnty
     5897                       prt-SumNDS     = PricendS * prt-tqnty
     5898                       prt-SumwithNDS = PricewithNDS * prt-tqnty
     5899                       .
     5900                   assign
     5901                       sum-prt-tqnty      = sum-prt-tqnty      +  prt-tqnty
     5902                       sum-prt-SumNoNDS   = sum-prt-SumNoNDS   +  prt-SumNoNDS
     5903                       sum-prt-SumNDS     = sum-prt-SumNDS     +  prt-SumNDS
     5904                       sum-prt-SumwithNDS = sum-prt-SumwithNDS +  prt-SumwithNDS
     5905                       .
     5906                   if PrintScale = yes
     5907                       then
     5908                   do:
     5909                       find first bar-code no-lock
     5910                           where bar-code.gds-code  = goods.gds-code
     5911                           and bar-code.unit-cli  = goods.unit-base
     5912                           and bar-code.node-code = gds-dtl.prt-code
     5913                           and bar-code.part-code = ""
     5914                           and bar-code.in-code   = ""
     5915                           .
     5916                       assign
     5917                           PrtName = goods.gds-name + "//" + gds-prt.f-name
     5918                           .
     5919                       assign
     5920                           Pg-tqnty      = Pg-tqnty +  prt-tqnty
     5921                           Pg-SumNoNDS   = Pg-SumNoNDS +  prt-SumNoNDS
     5922                           Pg-SumWithNDS = Pg-SumWithNDS +   prt-SumwithNDS
     5923                           .
     5924                       if costprice = yes
     5925                           then
     5926                       do:
     5927                           put stream OutStr-html unformatted
     5928                               '       <tr level="' + string( g-level) + '" >' skip
     5929                               '         <td  style="display: yes; text-align:  right "> ' +  goods.artic  + '</td>'  skip
     5930                               '         <td style="display: yes; text-align:  right ">'  +   temp_gds-name.gds-name  +  '  </td>' skip
     5931                               '<td>' skip
     5932                               '<img src="' + v-picture + '"; alt="HTML5 Icon"  align="right" style="height:128px;  "/>'
     5933                               ' </td>' skip
     5934                               '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5935                               '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5936                               '         <td style="display: yes; text-align:  right ">'    +  if  prt-tqnty  <> ?  then fnc-convert-dot-to-colon(prt-tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5937                               '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5938                               '         <td  style="display: yes; text-align:  right "> '  +  if  prt-SumNoNDS <> ?  then fnc-convert-dot-to-colon(prt-SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5939                               '         <td style="display: yes; text-align:  right ">' +  if  prt-SumwithNDS <> ?  then fnc-convert-dot-to-colon( prt-SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5940                               '       </tr>' skip
     5941                               .
     5942                       end.
     5943                       else
     5944                       do:
     5945                           put stream OutStr-html unformatted
     5946                               '       <tr level="' + string( g-level) + '" >' skip
     5947                               '         <td  style="display: yes; text-align:  right "> ' +  goods.artic  + '</td>'  skip
     5948                               '         <td style="display: yes; text-align:  right ">'  +  temp_gds-name.gds-name +  '  </td>' skip
     5949                               '<td>' skip
     5950                               '<img src="' + v-picture + '"; alt="HTML5 Icon"  align="right" style="height:128px;  "/>'
     5951                               ' </td>' skip
     5952                               '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5953                               '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5954                               '         <td style="display: yes; text-align:  right ">'    +  if  prt-tqnty  <> ?  then fnc-convert-dot-to-colon(prt-tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5955                               '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5956                               '         <td  style="display: yes; text-align:  right "> '  +  if  prt-SumNoNDS <> ?  then fnc-convert-dot-to-colon(prt-SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5957                               '         <td style="display: yes; text-align:  right ">' +  if  prt-SumwithNDS <> ?  then fnc-convert-dot-to-colon( prt-SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5958                               '       </tr>' skip
     5959                               .
     5960                       end.
     5961                   end.
     5962               end.
     5963               assign
     5964                   tqnty      = sum-prt-tqnty
     5965                   SumNoNDS   = sum-prt-SumNoNDS
     5966                   SumNDS     = sum-prt-SumNDS
     5967                   SumwithNDS = sum-prt-SumwithNDS
     5968                   .
     5969           end.
     5970           if  PrintScale = no
     5971               then
     5972           do:
     5973               find bar-code where bar-code.gds-code  = goods.gds-code
     5974                   and bar-code.unit-cli  = goods.unit-base
     5975                   and bar-code.node-code = rootnode_code
     5976                   and bar-code.part-code = ""
     5977                   and bar-code.in-code   = ""
     5978                   no-lock .
     5979               assign
     5980                   Pg-tqnty      = Pg-tqnty +  tqnty
     5981                   Pg-SumNoNDS   = Pg-SumNoNDS +  SumNoNDS
     5982                   Pg-SumWithNDS = Pg-SumWithNDS +   SumwithNDS
     5983                   .
     5984               if costprice = yes
     5985                   then
     5986               do:
     5987                   put stream OutStr-html unformatted
     5988                       '       <tr level="' + string( g-level) + '" >' skip
     5989                       '         <td  style="display: yes; text-align:  right "> ' +   goods.artic + '</td>'  skip
     5990                       '         <td style="display: yes; text-align:  right ">'  +  temp_gds-name.gds-name  +  '  </td>' skip
     5991                       '<td>' skip
     5992                       '<img src="' + v-picture + '"; alt="HTML5 Icon"  align="right" style="height:128px;  "/>'
     5993                       ' </td>' skip
     5994                       '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     5995                       '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     5996                       '         <td style="display: yes; text-align:  right ">'    +  if tqnty  <> ?  then fnc-convert-dot-to-colon(tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5997                       '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5998                       '         <td  style="display: yes; text-align:  right "> '  +  if  SumNoNDS <> ?  then fnc-convert-dot-to-colon(SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     5999                       '         <td style="display: yes; text-align:  right ">' +  if  SumwithNDS <> ?  then fnc-convert-dot-to-colon( SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6000                       '       </tr>' skip
     6001                       .
     6002               end.
     6003               else
     6004               do:
     6005                   put stream OutStr-html unformatted
     6006                       '       <tr level="' + string( g-level) + '" >' skip
     6007                       '         <td  style="display: yes; text-align:  right "> ' +  goods.artic  + '</td>'  skip
     6008                       '         <td style="display: yes; text-align:  right ">'  +   temp_gds-name.gds-name  +  '  </td>' skip
     6009                       '<td>' skip
     6010                       '<img src="' + v-picture + '"; alt="HTML5 Icon"  align="right" style="height:128px;  "/>'
     6011                       ' </td>' skip
     6012                       '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     6013                       '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     6014                       '         <td style="display: yes; text-align:  right ">'    +  if  tqnty  <> ?  then fnc-convert-dot-to-colon(tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6015                       '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6016                       '         <td  style="display: yes; text-align:  right "> '  +  if SumNoNDS <> ?  then fnc-convert-dot-to-colon(SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6017                       '         <td style="display: yes; text-align:  right ">' +  if  SumwithNDS <> ?  then fnc-convert-dot-to-colon( SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6018                       '       </tr>' skip
     6019                       .
     6020               end.
     6021           end.
     6022       end.
     6023       else
     6024       do:
     6025           find first bar-code no-lock
     6026               where bar-code.gds-code = goods.gds-code
     6027               and bar-code.unit-cli = goods.unit-base
     6028               and bar-code.node-code = rootnode_code
     6029               and bar-code.part-code = ""
     6030               and bar-code.in-code = ""
     6031               .
     6032           find first gds-dtl no-lock
     6033               where gds-dtl.doc-code = doc-line.doc-code
     6034               and gds-dtl.prod-type = doc-line.prod-type
     6035               and gds-dtl.prod-code = doc-line.prod-code
     6036               and gds-dtl.artic = doc-line.artic
     6037               and gds-dtl.prt-code = rootnode_code
     6038               .
     6039           assign
     6040               tqnty      = gds-dtl.fact-qnty
     6041               unit-str   = goods.unit-base
     6042               SumNoNDS   = PriceNoNDS * tqnty
     6043               SumNDS     = PricendS * tqnty
     6044               SumwithNDS = PricewithNDS * tqnty
     6045               .
     6046           assign
     6047               Pg-tqnty      = Pg-tqnty +  tqnty
     6048               Pg-SumNoNDS   = Pg-SumNoNDS +  SumNoNDS
     6049               Pg-SumWithNDS = Pg-SumWithNDS +   SumwithNDS
     6050               Pg-SumNDS     = Pg-SumNDS +  SumNDS
     6051               .
     6052           if costprice = yes
     6053               then
     6054           do:
     6055               put stream OutStr-html unformatted
     6056                   '       <tr level="' + string( g-level) + '" >' skip
     6057                   '         <td  style="display: yes; text-align:  right "> ' +   goods.artic  + '</td>'  skip
     6058                   '         <td style="display: yes; text-align:  right ">'  + temp_gds-name.gds-name  +  '  </td>' skip
     6059                   '<td>' skip
     6060                   '<img src="' + v-picture + '"; alt="HTML5 Icon"  align="right" style="height:128px;  "/>'
     6061                   ' </td>' skip
     6062                   '         <td style="display: yes; text-align:  right ">'  + string( bar-code.b-code ) + ' </td>' skip
     6063                   '         <td  style="display: yes; text-align:  right ">' + goods.unit-base + '</td>'  skip
     6064                   '         <td style="display: yes; text-align:  right ">'    +  if  tqnty  <> ?  then fnc-convert-dot-to-colon(tqnty, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6065                   '         <td style="display: yes; text-align:  right "> '   +  if  PricewithNDS <> ?  then fnc-convert-dot-to-colon(PricewithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6066                   '         <td  style="display: yes; text-align:  right "> '  +  if SumNoNDS <> ?  then fnc-convert-dot-to-colon(SumNoNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6067                   '         <td style="display: yes; text-align:  right ">' +  if  SumwithNDS <> ?  then fnc-convert-dot-to-colon( SumwithNDS , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     6068                   '       </tr>' skip
     6069                   .
     6070           end.
     6071           else
     6072           do:
     6073               put stream OutStr-html unformatted
     6074                   '       <tr level="' + string( g-level) + '" >' skip
     6075                   '         <td  style="display: yes; text-align:  right "> ' +  goods.artic  + '</td>'  skip
     6076                   '         <td style="display: yes; text-align:  right ">'  +   temp_gds-name.gds-name +  '  </td>' skip
