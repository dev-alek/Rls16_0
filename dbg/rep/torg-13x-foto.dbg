     1387   procedure wthcattr-sprcli :
     1388   define input parameter parparentproc  as widget-handle no-undo.
     1389   define input parameter p-mode  as character no-undo.
     1390   define input-output parameter p-value as character no-undo .
     1391   define output parameter p-setted as logical no-undo .
     1392     DEFINE VARIABLE v-value as character no-undo .
     1393     define variable v-cli-type as character no-undo .
     1394     define variable v-cli-code as integer no-undo .
     1395     define buffer buf_clients   for ub.clients.
     1396     define variable v_rid as character no-undo.
     1397     define variable ref-rec as recid no-undo .
     1398     do
     1399     on error undo, return error
     1400     :
     1401         v-value = p-value.
     1402      if p-value <> '':U then do:
     1403       assign
     1404       v-cli-type = substring(p-value, 1, 3)
     1405       v-cli-code = integer(substring(p-value, 4))
     1406       no-error.
     1407       if error-status:error then do:
     1408         assign
     1409         v-cli-type = '':U
     1410         v-cli-code = 0
     1411         .
     1412       end.
     1413      end.
     1414      FIND FIRST buf_clients NO-LOCK WHERE
     1415               buf_clients.obj-type = v-cli-type AND
     1416               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1417      IF available(buf_clients) then do:
     1418       run ref/cli-all.w (
     1419                   input parparentproc
     1420                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1421                  ,input v-cli-type
     1422                  ,input 'все':U
     1423                  ,input 'все':U
     1424                  ,input RECID( buf_clients )
     1425                  ,input ",,,,,,NO"
     1426                  ,input ?
     1427                  ,OUTPUT v_rid ).
     1428     END.
     1429     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1430       run ref/cli-all.w (
     1431                    input parparentproc
     1432                   ,INPUT "b-sel":U
     1433                  ,input  v-cli-type
     1434                  ,input 'все':U
     1435                  ,input 'текущие':U
     1436                  ,input ?
     1437                  ,input ",,,,,,NO"
     1438                  ,input ?
     1439                  ,OUTPUT v_rid ).
     1440     END.
     1441     else do:
     1442       message
     1443       if p-value = "":U then 'Атрибут не задан!'
     1444       else substitute('Не найден клиент &1',p-value)
     1445       view-as alert-box warning.
     1446     end.
     1447     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1448       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1449       IF ERROR-STATUS:ERROR THEN DO:
     1450           RETURN NO-APPLY.
     1451       END.
     1452       FIND FIRST buf_clients NO-LOCK WHERE
     1453                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1454       IF AVAIL buf_clients THEN DO:
     1455         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1456       end.
     1457     end.
     1458     if v-value <> p-value then do:
     1459       p-value = v-value.
     1460       p-setted = yes.
     1461     end.
     1462     end.
     1463   end procedure.
     1464     define new global shared variable g#wthcalib as handle no-undo.
     1465   procedure torgconf-read :
     1466   do
     1467   on error undo, return error
     1468   :
     1469       define input parameter p-form-name  as character    no-undo.
     1470       define input parameter p-host-code  as integer      no-undo.
     1471       define input parameter p-obj-type   as character    no-undo.
     1472       define input parameter p-obj-code   as integer      no-undo.
     1473       define variable v-outdate   as character     no-undo.
     1474       define variable v-outares   as character     no-undo.
     1475       define variable v-outsend   as character     no-undo.
     1476       define variable v-outasend  as character     no-undo.
     1477       define variable v-outprops  as character     no-undo.
     1478       define variable v-outnum    as character     no-undo.
     1479       define variable v-outprim   as character     no-undo.
     1480       define variable v-outdisc   as character     no-undo.
     1481       define variable v-outsubs   as character     no-undo.
     1482       define variable v-outrecv   as character     no-undo.
     1483       define variable v-outegrp   as character     no-undo.
     1484       define variable v-outt12    as character     no-undo.
     1485       define variable v-outappr   as character     no-undo.
     1486       define variable v-outrubl   as character     no-undo.
     1487       define variable v-outhold   as character     no-undo.
     1488       define variable v-outobj    as character     no-undo.
     1489       define variable v-outexlst  as character     no-undo.
     1490       define variable v-outprncd  as character     no-undo.
     1491       define variable v-par-type  as character     no-undo.
     1492       define variable v-outogr    as character     no-undo.
     1493       define variable v-outR      as character     no-undo.
     1494       define variable v-outB      as character     no-undo.
     1495       define variable v-outC      as character     no-undo.
     1496       assign
     1497           v-torgconf-outdate  = no
     1498           v-torgconf-outnum   = no
     1499           v-torgconf-outprim  = no
     1500           v-torgconf-outdisc  = no
     1501           v-torgconf-outsubs  = no
     1502           v-torgconf-outrecv  = no
     1503           v-torgconf-outegrp  = no
     1504           v-torgconf-outt12   = no
     1505           v-torgconf-outappr  = no
     1506           v-torgconf-outrubl  = no
     1507           v-torgconf-outhold  = no
     1508           v-torgconf-outobj   = no
     1509           v-torgconf-outexlst = no
     1510           v-torgconf-outexpas = "":U
     1511           v-torgconf-outprncd = yes
     1512           v-torgconf-outares  = no
     1513           v-torgconf-outsend  = no
     1514           v-torgconf-outasend  = no
     1515           v-torgconf-outprops  = no
     1516           v-form-name          = p-form-name
     1517       .
     1518   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1519   empty temp-table thbjattr_thbj-attr.
     1520   run adm/shattri.p (
     1521      input "get":U
     1522     ,input ''
     1523     ,input 0
     1524     ,input 'prt-glob':U
     1525     ,input  ""
     1526     ,output v-value-character
     1527     ,output v-value-date
     1528     ,output v-value-decimal
     1529     ,output v-value-integer
     1530     ,output v-value-logical
     1531     ,output par-type
     1532     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1533     ) no-error .
     1534   for each thbjattr_thbj-attr :
     1535       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1536       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1537       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1538   end.
     1539   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1540   empty temp-table thbjattr_thbj-attr.
     1541   run adm/shattri.p (
     1542      input "get":U
     1543     ,input p-obj-type
     1544     ,input p-obj-code
     1545     ,input 'prt-obj':U
     1546     ,input  ""
     1547     ,output v-value-character
     1548     ,output v-value-date
     1549     ,output v-value-decimal
     1550     ,output v-value-integer
     1551     ,output v-value-logical
     1552     ,output par-type
     1553     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1554     ) no-error .
     1555   for each thbjattr_thbj-attr :
     1556       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1557       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1558       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1559       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1560       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1561       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1562       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1563       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1564       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1565       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1566       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1567       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1568       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1569       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1570       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1571       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1572       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1573       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1574       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1575   end.
     1576       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1577       if error-status :error
     1578       then do:
     1579           assign
     1580               v-torgconf-outexpas = "":U
     1581           .
     1582       end.
     1583       assign
     1584           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1585       .
     1586       if p-form-name <> ""
     1587       and p-form-name <> ?
     1588       then do:
     1589           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1590           if error-status :error
     1591           then do:
     1592               assign
     1593                   v-outexlst           = ""
     1594               .
     1595           end.
     1596           if lookup( p-form-name, v-outdate ) <> 0
     1597           then do:
     1598               assign
     1599                   v-torgconf-outdate  = yes
     1600               .
     1601           end.
     1602           if lookup( p-form-name, v-outares ) <> 0
     1603           then do:
     1604               assign
     1605                   v-torgconf-outares  = yes
     1606               .
     1607           end.
     1608           if lookup( p-form-name, v-outnum  ) <> 0
     1609           then do:
     1610               assign
     1611                   v-torgconf-outnum   = yes
     1612               .
     1613           end.
     1614           if lookup( p-form-name, v-outprim ) <> 0
     1615           then do:
     1616               assign
     1617                   v-torgconf-outprim  = yes
     1618               .
     1619           end.
     1620           if lookup( p-form-name, v-outdisc ) <> 0
     1621           then do:
     1622               assign
     1623                   v-torgconf-outdisc  = yes
     1624               .
     1625           end.
     1626           if lookup( p-form-name, v-outsubs ) <> 0
     1627           then do:
     1628               assign
     1629                   v-torgconf-outsubs  = yes
     1630               .
     1631           end.
     1632           if lookup( p-form-name, v-outrecv ) <> 0
     1633           then do:
     1634               assign
     1635                   v-torgconf-outrecv  = yes
     1636               .
     1637           end.
     1638           if lookup( p-form-name, v-outegrp ) <> 0
     1639           then do:
     1640               assign
     1641                   v-torgconf-outegrp  = yes
     1642               .
     1643           end.
     1644           if lookup( p-form-name, v-outt12  ) <> 0
     1645           then do:
     1646               assign
     1647                   v-torgconf-outt12   = yes
     1648               .
     1649           end.
     1650           if lookup( p-form-name, v-outappr  ) <> 0
     1651           then do:
     1652               assign
     1653                   v-torgconf-outappr   = yes
     1654               .
     1655           end.
     1656           if lookup( p-form-name, v-outrubl  ) <> 0
     1657           then do:
     1658               assign
     1659                   v-torgconf-outrubl   = yes
     1660               .
     1661           end.
     1662           if lookup( p-form-name, v-outhold  ) <> 0
     1663           then do:
     1664               assign
     1665                   v-torgconf-outhold   = yes
     1666               .
     1667           end.
     1668           if lookup( p-form-name, v-outobj   ) <> 0
     1669           then do:
     1670               assign
     1671                   v-torgconf-outobj    = yes
     1672               .
     1673           end.
     1674           if lookup( p-form-name, v-outsend   ) <> 0
     1675           then do:
     1676               assign
     1677                   v-torgconf-outsend    = yes
     1678               .
     1679           end.
     1680           if lookup( p-form-name, v-outasend   ) <> 0
     1681           then do:
     1682               assign
     1683                   v-torgconf-outasend    = yes
     1684               .
     1685           end.
     1686           if lookup( p-form-name, v-outprops   ) <> 0
     1687           then do:
     1688               assign
     1689                   v-torgconf-outprops    = yes
     1690               .
     1691           end.
     1692           if lookup( p-form-name, v-outexlst ) <> 0
     1693           then do:
     1694               assign
     1695                   v-torgconf-outexlst  = yes
     1696               .
     1697           end.
     1698        assign
     1699         v-name = p-form-name.
     1700   end.
     1701   end.
     1702   end procedure.
     1703   procedure torgconf-get-self-param :
     1704   define input parameter p-obj-type           as character        no-undo.
     1705   define input parameter p-obj-code           as integer          no-undo.
     1706   define input parameter p-curr-code          as integer          no-undo.
     1707       define variable v-host-code    as integer      no-undo.
     1708       define variable v-par-type     as character    no-undo.
     1709   do
     1710   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1711   :
     1712   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1714     (input  p-obj-type
     1715     ,input  p-obj-code
     1716     ,output v-host-code
     1717     )  .
     1718       if v-torgconf-outhold = yes
     1719       then do:
     1720           run torgconf-get-holdfirm-code in this-procedure (
     1721                 input p-obj-type
     1722               , input p-obj-code
     1723               , output v-torgconf-self-host-code
