     6200   procedure print-group-line :
     6201       do
     6202           on error undo, return error
     6203           :
     6204           put stream OutStr-html unformatted
     6205               '       <tr level="' + string( p-level) + '" >' skip
     6206               '         <td colspan = "8"  style="display: yes; text-align: left; font-weight: bold;"> ' +     goods.grp-name  + '</td>'  skip
     6207               '</tr>' skip
     6208               .
     6209       end.
     6210   end procedure.
     6211   procedure print-prod-line :
     6212       do
     6213           on error undo, return error
     6214           :
     6215           put stream OutStr-html unformatted
     6216               '       <tr level="1" >' skip
     6217               '         <td  colspan = "8" style="display: yes; text-align: left; font-weight: bold; "> ' +    string(clients.obj-code) + "  " + clients.obj-name + '</td>'  skip
     6218               '</tr>' skip
     6219               .
     6220       end.
     6221   end procedure.
     6222   run search-full-path-Report(input v-report-name-html).
     6223   run Report-Viewer(input v-full-path-RepView, input v-report-name-html).
     6224   function fnc-DD-MM-YYYY returns character
     6225       (input p-dat-date as date):
     6226       define variable result     as character no-undo.
     6227       define variable p-str-date as character no-undo.
     6228       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     6229       return p-str-date.
     6230   end function.
     6231   function fnc-convert-dot-to-colon returns character
     6232       (input p-data as decimal, input p-accur as character):
     6233       define variable result       as character no-undo.
     6234       define variable v-str-result as character no-undo.
     6235       p-data = round(p-data, 2).
     6236       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     6237       return v-str-result.
     6238   end function.
     6239   procedure create-file:
     6240       define input parameter p-file-name as character no-undo.
     6241       output to value(string(p-file-name)).
     6242       output close.
     6243   end procedure.
     6244   procedure search-full-path-Report:
     6245       define input parameter p-file-name as character no-undo.
     6246       if search(p-file-name) = ? then
     6247       do:
     6248           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     6249       end.
     6250       else
     6251       do:
     6252           p-file-name = search(p-file-name).
     6253       end.
     6254   end procedure.
     6255   procedure define-full-path-Report:
     6256       define input parameter p-rep-num as integer no-undo.
     6257       define output parameter p-file-name-rep-htm as character no-undo.
     6258       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     6259   end procedure.
     6260   procedure Report-Viewer:
     6261       define input parameter p-full-path-RepView as character no-undo.
     6262       define input parameter p-file-name-rep-htm as character no-undo.
     6263       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     6264   end procedure.
     6265   procedure get-full-path-RepViewer:
     6266       define output parameter p-fill-path-RepView as character no-undo.
     6267       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     6268       do:
     6269           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     6270       end.
     6271       else
     6272       do:
     6273           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     6274       end.
     6275   end procedure.
