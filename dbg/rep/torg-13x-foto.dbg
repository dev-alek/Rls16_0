      211   define temp-table temp_p-fmt_string-part no-undo
      212       field str-key       as integer
      213       field string-part   as character
      214       index pi is primary unique
      215           str-key
      216   .
      217   define variable v-p-fmt-2-str-key    as integer      no-undo.
      218   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      219                                     iInput AS INTEGER).
      220     def var v-start-print as integer no-undo .
      221     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      222     assign
      223       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      224     .
      225     RETURN v-start-print .
      226   END FUNCTION.
      227   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      228                                     iInput AS INTEGER).
      229     def var v-start-print as integer no-undo .
      230     assign
      231       v-start-print = INTEGER(iEndPix - 1 - iInput)
      232     .
      233     if v-start-print < 0 then return 0.
      234     RETURN v-start-print .
      235   END FUNCTION.
      236   function p-fmt-align-string returns character (
      237         p-in-string      as character
      238       , p-page-width     as integer
      239       , p-align-type     as character
      240   ).
      241       define variable v-string-length     as integer      no-undo.
      242       define variable v-out-string        as character    no-undo.
      243       assign
      244           v-string-length = length( trim( p-in-string ) )
      245       .
      246       if v-string-length >= p-page-width
      247       then do:
      248           assign
      249               v-out-string = trim( p-in-string )
      250           .
      251       end.
      252       else do:
      253           case p-align-type
      254           :
      255               when 'left':U
      256               then do:
      257                   assign
      258                       v-out-string = trim( p-in-string )
      259                   .
      260               end.
      261               when 'right':U
      262               then do:
      263                   assign
      264                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      265                   .
      266               end.
      267               when 'center':U
      268               then do:
      269                   assign
      270                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      271                   .
      272               end.
      273           end case.
      274       end.
      275       return v-out-string .
      276   end function.
      277   procedure p-fmt-split-string :
      278   define input parameter p-source-string  as character        no-undo.
      279   define input parameter p-split-length   as integer          no-undo.
      280   define output parameter p-string-1      as character        no-undo.
      281   define output parameter p-string-2      as character        no-undo.
      282   do
      283   on error undo, return error
      284   :
      285       define variable v-space-pos    as integer      no-undo.
      286       if length( p-source-string ) <= p-split-length
      287       then do:
      288           assign
      289               p-string-1 = p-source-string
      290           .
      291       end.
      292       else do:
      293           assign
      294               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      295           .
      296           if v-space-pos = 0
      297           then do:
      298               assign
      299                   v-space-pos = index( p-source-string, " ":U )
      300               .
      301           end.
      302           if v-space-pos = 0
      303           then do:
      304               assign
      305                   p-string-1 = substring( p-source-string, 1, p-split-length )
      306                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      307               .
      308           end.
      309           else do:
      310               assign
      311                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      312                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      313               .
      314           end.
      315       end.
      316   end.
      317   end procedure.
      318   procedure p-fmt-round :
      319   define input parameter p-qnty               as decimal          no-undo.
      320   define input parameter p-price-no-VAT       as decimal          no-undo.
      321   define input parameter p-VAT                as decimal          no-undo.
      322   define input parameter p-SLT                as decimal          no-undo.
      323   define input parameter p-road-tax           as decimal          no-undo.
      324   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      325   define output parameter p-new-VAT           as decimal          no-undo.
      326   define output parameter p-new-SLT           as decimal          no-undo.
      327   define output parameter p-new-sum-VAT       as decimal          no-undo.
      328   define output parameter p-new-sum-SLT       as decimal          no-undo.
      329   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      330   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      331   define output parameter p-new-sum-full      as decimal          no-undo.
      332       define variable v-vat-pc    as decimal      no-undo.
      333       define variable v-slt-pc    as decimal      no-undo.
      334   do
      335   on error undo, return error
      336   :
      337       if p-price-no-VAT = 0
      338       then do:
      339           assign
      340               p-new-price-no-VAT = 0.0
      341               p-new-VAT          = ?
      342               p-new-SLT          = ?
      343               p-new-sum-VAT      = 0.0
      344               p-new-sum-SLT      = 0.0
      345               p-new-sum-no-VAT   = 0.0
      346               p-new-sum-road-tax = 0.0
      347               p-new-sum-full     = 0.0
      348           .
      349       end.
      350       else do:
      351           assign
      352               v-vat-pc            = p-VAT / p-price-no-VAT
      353               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      354               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      355               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      356               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      357               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      358               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      359               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      360               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      361               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      362           .
      363       end.
      364   end.
      365   end procedure.
      366   procedure p-fmt-split :
      367   define input parameter p-in-string      as character        no-undo.
      368   define input parameter p-split-length   as integer          no-undo.
      369       define variable v-start-pos     as integer      no-undo.
      370       define variable v-end-pos       as integer      no-undo.
      371       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      372   do
      373   for buf_temp_p-fmt_string-part
      374   on error undo, return error
      375   :
      376       empty temp-table buf_temp_p-fmt_string-part.
      377       if p-split-length < 1
      378       then do:
      379           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      380       end.
      381       assign
      382           p-in-string                 = trim( p-in-string )
      383           v-p-fmt-2-str-key   = 0
      384           v-start-pos                 = 1
      385           v-end-pos                   = length( p-in-string )
      386       .
      387       run p-fmt-get-string-range in this-procedure (
      388             input p-in-string
      389           , input p-split-length
      390           , input v-start-pos
      391           , output v-start-pos
      392           , output v-end-pos
      393       ).
      394       do while v-end-pos <> 0
      395       :
      396           create buf_temp_p-fmt_string-part.
      397           assign
      398               v-p-fmt-2-str-key = v-p-fmt-2-str-key + 1
      399           .
      400           assign
      401               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-2-str-key
      402               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      403           .
      404           assign
      405               v-start-pos = v-end-pos + 1
      406           .
      407           run p-fmt-get-string-range in this-procedure (
      408                 input p-in-string
      409               , input p-split-length
      410               , input v-start-pos
      411               , output v-start-pos
      412               , output v-end-pos
      413           ).
      414       end.
      415   end.
      416   end procedure.
      417   procedure p-fmt-get-string-range :
      418   define input parameter p-in-string      as character        no-undo.
      419   define input parameter p-split-length   as integer          no-undo.
      420   define input parameter p-old-start-pos  as integer          no-undo.
      421   define output parameter p-start-pos     as integer          no-undo.
      422   define output parameter p-end-pos       as integer          no-undo.
      423       define variable v-init-string    as character    no-undo.
      424       define variable v-temp-char      as character    no-undo.
      425       define variable v-temp-pos       as integer      no-undo.
      426       define variable v-counter        as integer      no-undo.
      427   do
      428   on error undo, return error
      429   :
      430       assign
      431           p-start-pos   = p-old-start-pos
      432           v-init-string = substring( p-in-string, p-start-pos )
      433       no-error.
      434       if error-status :error
      435       or trim( v-init-string ) = "":U
      436       then do:
      437           assign
      438               p-end-pos = 0
      439           .
      440           undo, return .
      441       end.
      442       assign
      443           v-temp-char   = substring( v-init-string, 1, 1 )
      444       .
      445       do
      446       while trim( v-temp-char ) = "":U
      447       :
      448           assign
      449               p-start-pos     = p-start-pos + 1
      450               v-init-string   = substring( p-in-string, p-start-pos )
      451               v-temp-char     = substring( v-init-string, 1, 1 )
      452           .
      453       end.
      454       assign
      455           v-temp-pos  = p-split-length
      456           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      457           v-counter   = 0
      458       .
      459       search-word-end:
      460       do
      461       while trim( v-temp-char ) <> "":U
      462       :
      463           assign
      464               v-counter   = v-counter + 1
      465           .
      466           if v-counter > 20
      467           then do:
      468               assign
      469                   v-temp-pos  = p-split-length
      470               .
      471               leave search-word-end.
      472           end.
      473           assign
      474               v-temp-pos  = v-temp-pos - 1
      475               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      476           .
      477       end.
      478       assign
      479           p-end-pos = p-start-pos + v-temp-pos - 1
      480       .
      481   end.
      482   end procedure.
      483       def var t-addres        like ub.firm.addres1   no-undo.
      484       def var t-phone         like ub.firm.phone     no-undo.
      485       def var t-inn           like ub.firm.inn       no-undo.
      486       def var t-okpo          like ub.firm.okpo      no-undo.
      487       def var t-temp-address  like ub.firm.addres1   no-undo.
      488   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      489   function breakstr returns character ( input        for-name    as character,
      490                                         input        line-length as integer,
      491                                         input-output line1       as character,
      492                                         input-output line2       as character ) :
      493     define variable ii as integer no-undo.
      494     if length( for-name ) > line-length then do:
      495       assign ii    = 1
      496              line1 = "":u
      497              line2 = "":u.
      498       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      499         assign line1 =       substring( for-name, 1, line-length     )
      500                line2 = trim( substring( for-name,    line-length + 1 ) ).
      501       end.                                                     else do:
      502         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      503           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      504                  ii    = ii    + 1.
      505           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      506             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      507           end.
      508         end.
      509         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      510       end.
      511     end.                                else do:
      512       assign line1 = for-name
      513              line2 = "":u.
      514     end.
      515     return ( line1 ).
      516   end function.
      517   define variable vss-include-info4 as character format "X(65)" no-undo
      518   initial "@(#)$Workfile$ $Revision$".
      519   define variable v-fmtcli-name          as character    no-undo.
      520   define variable v-fmtcli-engl-name     as character    no-undo.
      521   define variable v-fmtcli-addres        as character    no-undo.
      522   define variable v-fmtcli-post-addres   as character    no-undo.
      523   define variable v-fmtcli-full-addres   as character    no-undo.
      524   define variable v-fmtcli-phone         as character    no-undo.
      525   define variable v-fmtcli-inn           as character    no-undo.
      526   define variable v-fmtcli-kpp           as character    no-undo.
      527   define variable v-fmtcli-okpo          as character    no-undo.
      528   define variable v-fmtcli-country       as character    no-undo.
      529   define variable v-fmtcli-city          as character    no-undo.
      530   define variable v-fmtcli-index         as character    no-undo.
      531   define variable v-fmtcli-schet-exists  as logical      no-undo.
      532   define variable v-fmtcli-bank-exists   as logical      no-undo.
      533   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      534   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      535   define variable v-fmtcli-bank-bik      as character    no-undo.
      536   define variable v-fmtcli-bank-name     as character    no-undo.
      537   define variable v-fmtcli-bank-addres   as character    no-undo.
      538   define variable v-fmtcli-bank-city     as character    no-undo.
      539   procedure fmtcli-get-bank :
      540   define input parameter p-host-code      as integer          no-undo.
      541   define input parameter p-obj-type       as character        no-undo.
      542   define input parameter p-obj-code       as integer          no-undo.
      543   define input parameter p-curr-code      as integer          no-undo.
      544       define buffer buf_fin-schet     for ub.fin-schet.
      545       define buffer buf_fin-bank      for ub.fin-bank.
      546   do
      547   for buf_fin-schet
      548     , buf_fin-bank
      549   on error undo, return error
      550   :
      551       assign
      552           v-fmtcli-schet-exists       = no
      553           v-fmtcli-bank-exists        = no
      554           v-fmtcli-bank-r-schet       = "":U
      555           v-fmtcli-bank-c-schet       = "":U
      556           v-fmtcli-bank-bik           = "":U
      557           v-fmtcli-bank-name          = "":U
      558           v-fmtcli-bank-addres        = "":U
      559           v-fmtcli-bank-city          = "":U
      560       .
      561       search-for-schet:
      562       for each buf_fin-schet no-lock
      563          where buf_fin-schet.host-code = p-host-code
      564            and buf_fin-schet.cli-type  = p-obj-type
      565            and buf_fin-schet.cli-code  = p-obj-code
      566            and buf_fin-schet.curr-code = p-curr-code
      567       on error undo, return error
      568       :
      569           if buf_fin-schet.status_   = 'удал':U
      570           then do:
      571           end.
      572           else do:
      573               assign
      574                   v-fmtcli-schet-exists   = yes
      575                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      576                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      577               .
      578               find first buf_fin-bank no-lock
      579                    where buf_fin-bank.host-code = p-host-code
      580                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      581               no-error.
      582               if available buf_fin-bank
      583               then do:
      584                   assign
      585                       v-fmtcli-bank-exists      = yes
      586                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      587                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      588                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      589                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      590                   .
      591               end.
      592               else do:
      593                   assign
      594                       v-fmtcli-bank-exists    = no
      595                       v-fmtcli-bank-bik       = "":U
      596                       v-fmtcli-bank-name      = "":U
      597                       v-fmtcli-bank-addres    = "":U
      598                       v-fmtcli-bank-city      = "":U
      599                   .
      600               end.
      601               leave search-for-schet.
      602           end.
      603       end.
      604   end.
      605   end procedure.
      606   procedure fmtcli-get-client :
      607   define input parameter p-obj-type       as character    no-undo.
      608   define input parameter p-obj-code       as integer      no-undo.
      609       define variable v-temp-fmtcli-address      as character     no-undo.
      610       define variable v-num-country-city    as integer      no-undo.
      611       define buffer buf_clients   for ub.clients.
      612       define buffer buf_firm      for ub.firm.
      613       define buffer buf_store     for ub.store.
      614       define buffer buf_shop      for ub.shop.
      615       define buffer buf_person    for ub.person.
      616   do
      617   for buf_clients
      618     , buf_firm
      619     , buf_store
      620     , buf_shop
      621     , buf_person
      622   on error undo, return error
      623   :
      624       assign
      625           v-fmtcli-name           = "":U
      626           v-fmtcli-addres         = "":U
      627           v-fmtcli-post-addres    = "":U
      628           v-fmtcli-full-addres    = "":U
      629           v-fmtcli-phone          = "":U
      630           v-fmtcli-inn            = "":U
      631           v-fmtcli-kpp            = "":U
      632           v-fmtcli-okpo           = "":U
      633           v-fmtcli-city           = "":U
      634           v-fmtcli-index          = "":U
      635           v-fmtcli-country        = "":U
      636       .
      637       find first buf_clients no-lock
      638            where buf_clients.obj-type = p-obj-type
      639              and buf_clients.obj-code = p-obj-code
      640       .
      641       assign
      642           v-fmtcli-name = buf_clients.obj-name
      643       .
      644       case buf_clients.obj-type:
      645          when 'орг':U
      646          then do:
      647               find first buf_firm no-lock
      648                    where buf_firm.firm-code = buf_clients.obj-code
      649                    no-error
      650               .
      651               if available buf_firm
      652               then do:
      653                   assign
      654                       v-num-country-city = num-entries( buf_firm.city )
      655                       v-fmtcli-engl-name = buf_firm.engl-name
      656                   .
      657                   if v-num-country-city > 0
      658                   then do:
      659                       assign
      660                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      661                       .
      662                   end.
      663                   if v-num-country-city > 1
      664                   then do:
      665                       assign
      666                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      667                       .
      668                   end.
      669                   run fmtcli-concatenate-strings in this-procedure (
      670                         input v-fmtcli-full-addres
      671                       , input v-fmtcli-country
      672                       , input ", ":U
      673                       , input 50
      674                       , output v-fmtcli-full-addres
      675                   ).
      676                   run fmtcli-concatenate-strings in this-procedure (
      677                         input v-fmtcli-full-addres
      678                       , input v-fmtcli-city
      679                       , input ", ":U
      680                       , input 50
      681                       , output v-fmtcli-full-addres
      682                   ).
      683                   run fmtcli-concatenate-strings in this-procedure (
      684                         input v-fmtcli-full-addres
      685                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      686                       , input ", ":U
      687                       , input 50
      688                       , output v-fmtcli-full-addres
      689                   ).
      690                   run fmtcli-concatenate-strings in this-procedure (
      691                         input v-fmtcli-post-addres
      692                       , input v-fmtcli-country
      693                       , input ", ":U
      694                       , input 50
      695                       , output v-fmtcli-post-addres
      696                   ).
      697                   run fmtcli-concatenate-strings in this-procedure (
      698                         input v-fmtcli-post-addres
      699                       , input v-fmtcli-city
      700                       , input ", ":U
      701                       , input 50
      702                       , output v-fmtcli-post-addres
      703                   ).
      704                   run fmtcli-concatenate-strings in this-procedure (
      705                         input v-fmtcli-post-addres
      706                       , input string( buf_firm.ind )
      707                       , input ", ":U
      708                       , input 50
      709                       , output v-fmtcli-post-addres
      710                   ).
      711                   run fmtcli-concatenate-strings in this-procedure (
      712                         input substring( buf_firm.addres1, 1, 50 )
      713                       , input buf_firm.addres2
      714                       , input " ":U
      715                       , input 50
      716                       , output v-temp-fmtcli-address
      717                   ).
      718                   run fmtcli-concatenate-strings in this-procedure (
      719                         input v-temp-fmtcli-address
      720                       , input substring( buf_firm.addres1, 51, 50 )
      721                       , input " ":U
      722                       , input 50
      723                       , output v-temp-fmtcli-address
      724                   ).
      725                   run fmtcli-concatenate-strings in this-procedure (
      726                         input v-temp-fmtcli-address
      727                       , input substring( buf_firm.addres1, 101, 50 )
      728                       , input " ":U
      729                       , input 50
      730                       , output v-temp-fmtcli-address
      731                   ).
      732                   assign
      733                       v-fmtcli-addres = v-temp-fmtcli-address
      734                   .
      735                   if buf_firm.addres1 <> ?
      736                   then do:
      737                       run fmtcli-concatenate-strings in this-procedure (
      738                             input v-fmtcli-full-addres
      739                           , input v-fmtcli-addres
      740                           , input ", ":U
      741                           , input 0
      742                           , output v-fmtcli-full-addres
      743                       ).
      744                   end.
      745                   run fmtcli-concatenate-strings in this-procedure (
      746                         input substring( buf_firm.post-addr1, 1, 50 )
      747                       , input buf_firm.post-addr2
      748                       , input " ":U
      749                       , input 50
      750                       , output v-fmtcli-post-addres
      751                   ).
      752                   run fmtcli-concatenate-strings in this-procedure (
      753                         input v-fmtcli-post-addres
      754                       , input substring( buf_firm.post-addr1, 51, 50 )
      755                       , input " ":U
      756                       , input 50
      757                       , output v-fmtcli-post-addres
      758                   ).
      759                   run fmtcli-concatenate-strings in this-procedure (
      760                         input v-fmtcli-post-addres
      761                       , input substring( buf_firm.post-addr1, 101, 50 )
      762                       , input " ":U
      763                       , input 50
      764                       , output v-fmtcli-post-addres
      765                   ).
      766                   assign
      767                       v-fmtcli-phone         = buf_firm.phone
      768                       v-fmtcli-inn           = buf_firm.inn
      769                       v-fmtcli-kpp           = buf_firm.kpp
      770                       v-fmtcli-okpo          = buf_firm.okpo
      771                       v-fmtcli-index         = string( buf_firm.ind )
      772                   .
      773               end.
      774          end.
      775          when 'маг':U
      776          then do:
      777               find first buf_shop no-lock
      778                    where buf_shop.obj-code = buf_clients.obj-code
      779               .
      780               if available buf_shop
      781               then do:
      782                   run fmtcli-concatenate-strings in this-procedure (
      783                         input buf_shop.addres1
      784                       , input buf_shop.addres2
      785                       , input " ":U
      786                       , input 50
      787                       , output v-fmtcli-addres
      788                   ).
      789                   assign
      790                       v-fmtcli-full-addres = v-fmtcli-addres
      791                       v-fmtcli-post-addres = v-fmtcli-addres
      792                       v-fmtcli-phone       = buf_shop.phone
      793                       v-fmtcli-inn         = "":U
      794                       v-fmtcli-kpp         = "":U
      795                       v-fmtcli-okpo        = "":U
      796                       v-fmtcli-city        = "":U
      797                       v-fmtcli-index       = "":U
      798                   .
      799               end.
      800          end.
      801          when 'скл':U
      802          then do:
      803               find first buf_store no-lock
      804                    where buf_store.obj-code = buf_clients.obj-code
      805               .
      806               if available buf_store
      807               then do:
      808                   run fmtcli-concatenate-strings in this-procedure (
      809                         input buf_store.addres1
      810                       , input buf_store.addres2
      811                       , input " ":U
      812                       , input 50
      813                       , output v-fmtcli-addres
      814                   ).
      815                   assign
      816                       v-fmtcli-full-addres = v-fmtcli-addres
      817                       v-fmtcli-phone       = buf_store.phone
      818                       v-fmtcli-inn         = "":U
      819                       v-fmtcli-kpp         = "":U
      820                       v-fmtcli-okpo        = "":U
      821                       v-fmtcli-city        = "":U
      822                       v-fmtcli-index       = "":U
      823                   .
      824               end.
      825          end.
      826          when 'чел':U
      827          then do:
      828               find first buf_person no-lock
      829                    where buf_person.psn-code = buf_clients.obj-code
      830               .
      831               if available buf_person
      832               then do:
      833                   run fmtcli-concatenate-strings in this-procedure (
      834                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      835                                 then "":U
      836                                 else string( buf_person.ind, "999999")
      837                                 )
      838                       , input buf_person.city
      839                       , input ", ":U
      840                       , input 0
      841                       , output v-fmtcli-full-addres
      842                   ).
      843                   assign
      844                       v-fmtcli-addres = buf_person.address
      845                   .
      846                   run fmtcli-concatenate-strings in this-procedure (
      847                         input v-fmtcli-full-addres
      848                       , input v-fmtcli-addres
      849                       , input ", ":U
      850                       , input 0
      851                       , output v-fmtcli-full-addres
      852                   ).
      853                   assign
      854                       v-fmtcli-phone     = buf_person.phone1
      855                       v-fmtcli-inn       = buf_person.inn
      856                       v-fmtcli-kpp       = buf_person.kpp
      857                       v-fmtcli-okpo      = buf_person.okpo
      858                       v-fmtcli-city      = buf_person.city
      859                       v-fmtcli-index     = string( buf_person.ind )
      860                   .
      861               end.
      862          end.
      863       end case.
      864   end.
      865   end procedure.
      866   procedure fmtcli-concatenate-strings :
      867   define input parameter p-string-1       as character        no-undo.
      868   define input parameter p-string-2       as character        no-undo.
      869   define input parameter p-delimiter      as character        no-undo.
      870   define input parameter p-length         as integer          no-undo.
      871   define output parameter p-out-string    as character        no-undo.
      872   do
      873   on error undo, return error
      874   :
      875       assign
      876           p-out-string = ( if p-string-1 = ?
      877                            then "":U
      878                            else trim( p-string-1 ) )
      879       .
      880       assign
      881           p-out-string = p-out-string
      882                        + ( if p-out-string = "":U
      883                            or length( p-out-string ) = p-length
      884                            or p-string-2 = ?
      885                            or trim( p-string-2 ) = "":U
      886                            then "":U
      887                            else p-delimiter )
      888                        + ( if p-string-2 = ?
      889                            or trim( p-string-2 ) = "":U
      890                            then "":U
      891                            else trim( p-string-2 ) )
      892       .
      893   end.
      894   end procedure.
      895   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   define new global shared variable g#attr-lib  as handle no-undo .
      897   define variable v-attr-lib-variable as handle no-undo .
      898   procedure clntattr-code :
      899     define input  parameter p-code           as character no-undo .
      900     define output parameter p-type           as character no-undo .
      901     define output parameter p-format         as character no-undo .
      902     define output parameter p-label          as character no-undo .
      903     define output parameter p-user-can-edit  as logical   no-undo .
      904     define output parameter p-output-display as logical   no-undo .
      905     define output parameter p-other          as character no-undo .
      906     do
      907     on error undo, return error return-value
      908     :
      909           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      910         (input  p-code
      911         ,output p-type
      912         ,output p-format
      913         ,output p-label
      914         ,output p-user-can-edit
      915         ,output p-output-display
      916         ,output p-other
      917         ) no-error .
      918       if error-status :error
      919       then do:
      920         undo, return error return-value .
      921       end.
      922     end.
      923   end procedure.
      924   procedure clntattr-tooltip :
      925     define input  parameter p-code    as character no-undo .
      926     define output parameter p-tooltip as character no-undo .
      927     define output parameter p-label   as character no-undo .
      928     do
      929     on error undo, return error return-value
      930     :
      931           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      932         (input  p-code
      933         ,output p-tooltip
      934         ,output p-label
      935         ) no-error .
      936       if error-status :error
      937       then do:
      938         undo, return error return-value .
      939       end.
      940     end.
      941   end procedure.
      942   procedure clntattr-value :
      943     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      944     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      945     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      946     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      947     define output parameter p-type     as character no-undo .
      948     do
