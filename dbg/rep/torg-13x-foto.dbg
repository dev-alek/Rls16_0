     2048       define variable v-par-type     as character    no-undo.
     2049   do
     2050   on error undo, return error
     2051   :
     2052       assign
     2053          v-torgconf-sup-host-code = v-host-code
     2054       .
     2055       if v-torgconf-sup-host-code = 0
     2056       then do:
     2057           assign
     2058               v-torgconf-sup-host-name           = "":U
     2059               v-torgconf-sup-host-addres         = "":U
