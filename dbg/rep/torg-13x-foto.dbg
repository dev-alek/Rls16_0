     6119           '         <td style="display: yes; font-weight: bold; text-align:  right ">' +  if    sum-SumwithNDS <> ?  then fnc-convert-dot-to-colon(   sum-SumwithNDS  , "->>>>>>>9.99" )  + '</td>' else "?" + '</td>' skip
     6120           '</tr>' skip
     6121           .
