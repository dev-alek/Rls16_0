     1125     index ie1 obj-type obj-code
     1126     index ie2 obj-name
     1127   .
     1128   procedure create_obj-list :
     1129      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1130      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1131      do
     1132      on error undo, return error return-value
     1133      :
     1134         define buffer cli-obj for ub.clients .
     1135         define variable p-var as integer no-undo .
     1136         define buffer buf_obj-list for obj-list .
     1137         find last buf_obj-list  use-index pi no-error .
     1138         if available buf_obj-list
     1139         then
     1140            p-var = buf_obj-list.obj-id + 1.
     1141         else
     1142            p-var = 1.
     1143         find first cli-obj where
     1144                   cli-obj.obj-type = p-obj-type
     1145               and cli-obj.obj-code = p-obj-code
     1146         no-lock no-error.
     1147         if available cli-obj
     1148         then do:
     1149            create buf_obj-list.
     1150            assign
     1151               buf_obj-list.obj-id   = p-var
     1152               buf_obj-list.obj-code = cli-obj.obj-code
     1153               buf_obj-list.obj-type = cli-obj.obj-type
     1154               buf_obj-list.obj-name = cli-obj.obj-name
     1155               buf_obj-list.db-num   = cli-obj.db-num
     1156            .
     1157         end.
     1158      end.
     1159   end.
