     1712             input x-Date-End,
     1713             output v-fact-order-end
     1714             ).
     1715         for each gds-list no-lock :
     1716           find last  buf_doc-line no-lock
     1717                where buf_doc-line.obj-type = x-store-type
     1718                  and buf_doc-line.obj-code = x-store-code
     1719                  and buf_doc-line.artic      = gds-list.artic
     1720                  and buf_doc-line.prod-code  = gds-list.prod-code
     1721                  and buf_doc-line.prod-type  = gds-list.prod-type
     1722                  and buf_doc-line.ext-doc-type = 'vt':U
     1723                  and buf_doc-line.status_ = 'факт':U no-error.
     1724           if available buf_doc-line then do :
     1725             assign
     1726               v-fact-order-start = buf_doc-line.fact-order
     1727             .
     1728             for each buf_ot-line
     1729                 where buf_ot-line.obj-type   = x-store-type
     1730                   and buf_ot-line.obj-code   = x-store-code
     1731                   and buf_ot-line.fact-order > v-fact-order-start
     1732                   and buf_ot-line.fact-order <= v-fact-order-end
     1733                   and buf_ot-line.artic      = gds-list.artic
     1734                   and buf_ot-line.prod-code  = gds-list.prod-code
     1735                   and buf_ot-line.prod-type  = gds-list.prod-type
     1736                   and buf_ot-line.sum-type   = "cost"
     1737                   and (buf_ot-line.ext-doc-type = 'vt':U
     1738                     or buf_ot-line.ext-doc-type = 'ev':U
     1739                     or buf_ot-line.ext-doc-type = 'ee':U
     1740                     or buf_ot-line.ext-doc-type = 'es':U) no-lock :
     1741               if buf_ot-line.ext-doc-type = 'vt':U then do :
     1742                   assign
     1743                     v-sum-deficit = v-sum-deficit - buf_ot-line.fact-qnty
     1744                   .
     1745               end.
     1746               else do :
     1747                 assign
     1748                   v-sum-price = v-sum-price - buf_ot-line.sum-rubl
     1749                   v-sum-qnty  = v-sum-qnty  - buf_ot-line.fact-qnty
     1750                 .
     1751               end.
     1752             end.
     1753           end.
     1754           create tt-calcwast.
     1755           assign
     1756             tt-calcwast.artic    = gds-list.artic
     1757             tt-calcwast.gds-name = gds-list.gds-name
     1758             tt-calcwast.deficit  = if v-sum-deficit <> ? then v-sum-deficit else 0
     1759             tt-calcwast.price    = if v-sum-price / v-sum-qnty <> ? then v-sum-price / v-sum-qnty else 0
     1760             tt-calcwast.oborot   = if v-sum-qnty <> ? then v-sum-qnty else 0
     1761           .
     1762           find first buf_goods no-lock
     1763                 where buf_goods.gds-code = gds-list.gds-code no-error.
     1764           if available buf_goods then do :
     1765             assign
     1766               tt-calcwast.wastage       = buf_goods.normal-wastage
     1767               tt-calcwast.allowed-wast  = tt-calcwast.oborot * tt-calcwast.wastage / 100
     1768               tt-calcwast.over-wast     = if tt-calcwast.deficit < 0 then 0 else ( tt-calcwast.deficit - tt-calcwast.allowed-wast )
     1769               tt-calcwast.all-wast-rubl = if tt-calcwast.deficit <= 0 then 0 else tt-calcwast.allowed-wast * tt-calcwast.price
     1770               tt-calcwast.deficit-rubl  = tt-calcwast.deficit * tt-calcwast.price
     1771               tt-calcwast.grp-code      = buf_goods.grp-code
     1772               tt-calcwast.grp-name      = buf_goods.grp-name
     1773               tt-calcwast.prod-code     = buf_goods.prod-code
     1774               tt-calcwast.prod-type     = buf_goods.prod-type
     1775             .
     1776           end.
     1777           find first buf_clients no-lock
     1778               where buf_clients.obj-code = buf_goods.prod-code
     1779                 and buf_clients.obj-code = buf_goods.prod-code no-error.
     1780           if available buf_clients then do :
     1781             tt-calcwast.prod-name = buf_clients.obj-name.
     1782           end.
     1783           assign
     1784             Counter1 = Counter1 + 1
     1785             v-sum-price  = 0
     1786             v-sum-qnty   = 0
     1787             v-sum-deficit = 0
     1788             .
     1789   IF ( Counter1 modulo v-account = 0 )  then DO:
     1790             if  log-manager:logfile-name ne ?
     1791             then DO:
     1792                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1793             end.
     1794              if mFrameView
     1795              then do:
     1796               DISPLAY
     1797                 Counter1 @ RecordsDone
     1798                 WITH FRAME InfoFrame.
     1799              end.
     1800   End.
     1801      if v-button-stop then  DO:
     1802            if mFrameView
     1803            then
     1804               PROCESS EVENTS.
     1805            IF StopProcessing THEN DO:
     1806            RETURN error.
     1807            End.
     1808      end.
     1809         end.
     1810       end.
     1811     end case.
     1812   if mFrameView
     1813   then do:
     1814      HIDE FRAME InfoFrame.
     1815   end.
     1816     case xclassify :
     1817       when "prod" then do :
     1818         if xsorttype = "sort-article" then do :
     1819           for each tt-calcwast break by tt-calcwast.prod-code by tt-calcwast.artic :
     1820             accumulate tt-calcwast.deficit       (sub-total by tt-calcwast.prod-code).
     1821             accumulate tt-calcwast.oborot        (sub-total by tt-calcwast.prod-code).
     1822             accumulate tt-calcwast.allowed-wast  (sub-total by tt-calcwast.prod-code).
     1823             accumulate tt-calcwast.over-wast     (sub-total by tt-calcwast.prod-code).
     1824             accumulate tt-calcwast.all-wast-rubl (sub-total by tt-calcwast.prod-code).
     1825             accumulate tt-calcwast.deficit-rubl  (sub-total by tt-calcwast.prod-code).
     1826             accumulate tt-calcwast.deficit       (total).
     1827             accumulate tt-calcwast.oborot        (total).
     1828             accumulate tt-calcwast.allowed-wast  (total).
     1829             accumulate tt-calcwast.over-wast     (total).
     1830             accumulate tt-calcwast.all-wast-rubl (total).
     1831             accumulate tt-calcwast.deficit-rubl  (total).
     1832             if first-of (tt-calcwast.prod-code) then do :
     1833               if Make-Excel then  put   stream ForExcel unformatted
     1834                   CHR(9) "Производитель - " + tt-calcwast.prod-type + string(tt-calcwast.prod-code) + " " + tt-calcwast.prod-name
     1835               skip.
     1836               run print-prod (tt-calcwast.prod-type
     1837                               ,tt-calcwast.prod-code
     1838                               ,tt-calcwast.prod-name).
     1839             end.
     1840             run  print-line (input recid(tt-calcwast)).
     1841             if last-of (tt-calcwast.prod-code) then do :
     1842               if Make-Excel then  put   stream ForExcel unformatted
     1843                   CHR(9) "Итоги по производителю" CHR(9) (accum sub-total by tt-calcwast.prod-code tt-calcwast.deficit)
     1844                                                          CHR(9)
     1845                                                          CHR(9)
     1846                                                          CHR(9) (accum sub-total by tt-calcwast.prod-code tt-calcwast.oborot )
     1847                                                          CHR(9) (accum sub-total by tt-calcwast.prod-code tt-calcwast.allowed-wast)
     1848                                                          CHR(9) (accum sub-total by tt-calcwast.prod-code tt-calcwast.over-wast)
     1849                                                          CHR(9) (accum sub-total by tt-calcwast.prod-code tt-calcwast.all-wast-rubl)
     1850                                                          CHR(9) (accum sub-total by tt-calcwast.prod-code tt-calcwast.deficit-rubl)
     1851               skip.
     1852               run print-sub-total("Итоги по производителю",
     1853                                   accum sub-total by tt-calcwast.prod-code tt-calcwast.deficit,
     1854                                   accum sub-total by tt-calcwast.prod-code tt-calcwast.oborot,
     1855                                   accum sub-total by tt-calcwast.prod-code tt-calcwast.allowed-wast,
     1856                                   accum sub-total by tt-calcwast.prod-code tt-calcwast.over-wast,
     1857                                   accum sub-total by tt-calcwast.prod-code tt-calcwast.all-wast-rubl,
     1858                                   accum sub-total by tt-calcwast.prod-code tt-calcwast.deficit-rubl
     1859                                   ).
     1860             end.
     1861           end.
     1862         end.
     1863         else do :
     1864           for each tt-calcwast break by tt-calcwast.prod-code by tt-calcwast.gds-name :
     1865             accumulate tt-calcwast.deficit       (sub-total by tt-calcwast.prod-code).
     1866             accumulate tt-calcwast.oborot        (sub-total by tt-calcwast.prod-code).
     1867             accumulate tt-calcwast.allowed-wast  (sub-total by tt-calcwast.prod-code).
     1868             accumulate tt-calcwast.over-wast     (sub-total by tt-calcwast.prod-code).
     1869             accumulate tt-calcwast.all-wast-rubl (sub-total by tt-calcwast.prod-code).
     1870             accumulate tt-calcwast.deficit-rubl  (sub-total by tt-calcwast.prod-code).
