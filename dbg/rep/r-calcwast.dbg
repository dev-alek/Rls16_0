     1561           tt-calcwast.gds-name       column-label "Название товара":C66                  format "x(66)"        space(0)
     1562           sym3                       column-label ":!:!:"                                  format "X(1)"         space(0)
     1563           tt-calcwast.deficit        column-label "Недостача,кг":C14                     format "->>>>>>>>9.999"    space(0)
     1564           sym4                       column-label ":!:!:"                                  format "X(1)"         space(0)
     1565           tt-calcwast.wastage        column-label "% ест.убыли":C12                       format "99.99"        space(0)
     1566           sym5                       column-label ":!:!:"                                  format "X(1)"         space(0)
     1567           tt-calcwast.price          column-label "Учетная цена":C14                     format "->>>>>>>>9.99"      space(0)
     1568           sym6                       column-label ":!:!:"                                  format "X(1)"         space(0)
     1569           tt-calcwast.oborot         column-label "Оборот,кг":C14                        format "->>>>>>>>9.999"    space(0)
     1570           sym7                       column-label ":!:!:"                                  format "X(1)"         space(0)
     1571           tt-calcwast.allowed-wast   column-label "Допустимая!ест.убыль,кг":C14            format "->>>>>>>>9.999"     space(0)
     1572           sym8                       column-label ":!:!:"                                  format "X(1)"         space(0)
     1573           tt-calcwast.over-wast      column-label "Превышение!допустимой!ест.убыли,кг":C14  format "->>>>>>>>9.999"     space(0)
     1574           sym9                       column-label ":!:!:"                                  format "X(1)"         space(0)
     1575           tt-calcwast.all-wast-rubl  column-label "Допустимая!ест.убыль,руб":C14           format "->>>>>>>>9.99"      space(0)
     1576           sym10                      column-label ":!:!:"                                  format "X(1)"         space(0)
