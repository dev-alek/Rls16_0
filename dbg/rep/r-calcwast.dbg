      109   define new shared stream PrnLibStream.
      110   procedure prn-lib-prn-file :
      111     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      112     define input parameter p-DIsabledoptions as integer no-undo .
      113     define variable v-report-name as character no-undo .
      114     define variable v-user-action as character no-undo .
      115     define variable v-printed     as logical   no-undo .
      116     define variable v-exist       as logical   no-undo .
      117     do
      118       on error undo, return error
      119       :
      120       run prn-lib-get-report-name  in this-procedure (
      121         input parParentProc
      122         ,output v-report-name
      123         ).
      124   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      126     (input  v-report-name
      127     ,input  2
      128     ,output v-exist
      129     )  .
      130       if NOT v-exist then
      131       DO:
      132         Message
      133           "Нет заданий на печать ! "
      134           view-as alert-box .
      135         Return  .
      136       End.
      137       run gbl/prnfilen.w
      138         (input  ""
      139         ,input  p-DisabledOptions
      140         ,input  string(v-report-name )
      141         ,input  7
      142         ,output v-user-action
      143         ,output v-printed
      144         ) .
      145       if v-printed then
      146       do:
      147         return "YES" .
      148       end.
      149       else
      150       do:
      151         return "NO" .
      152       end.
      153     end.
      154   end procedure.
      155   procedure prn-lib-open-stream :
      156     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      157     define input parameter p-page-size    as integer no-undo .
      158     define input parameter p-is-stream    as logical no-undo .
      159     define input parameter p-append       as logical no-undo .
      160     define variable v-report-name as character no-undo .
      161     do
      162       on error undo, return error
      163       :
      164       run prn-lib-get-report-name  in this-procedure (
      165         input parParentProc
      166         ,output v-report-name
      167         ).
      168       if p-is-stream then
      169       do:
      170         if p-append then
      171         do:
      172           output stream PrnLibStream to value( v-report-name )
      173             page-size value(p-page-size) append .
      174         end.
      175         if not p-append then
      176         do:
      177           output stream PrnLibStream to value( v-report-name )
      178             page-size value(p-page-size) .
      179         end.
      180       end.
      181       if not p-is-stream then
      182       do:
      183         if p-append then
      184         do:
      185           output to value( v-report-name )
      186             page-size value(p-page-size) append .
      187         end.
      188         if not p-append then
      189         do:
      190           output to value( v-report-name )
      191             page-size value(p-page-size) .
      192         end.
      193       end.
      194     end.
      195   end procedure.
      196   procedure prn-lib-open-exp :
      197     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      198     define input parameter p-is-stream    as logical no-undo .
      199     define input parameter p-is-append    as logical no-undo .
      200     define output parameter p-ReportFileName as char init "report" no-undo.
      201     define output parameter p-process as logical no-undo .
      202     define variable glog as logical no-undo .
      203     do
      204       on error undo, return error
      205       :
      206       SYSTEM-DIALOG GET-FILE p-ReportFileName
      207         TITLE      "Укажите путь"
      208         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      209         ASK-OVERWRITE
      210         CREATE-TEST-FILE
      211         SAVE-AS
      212         USE-FILENAME
      213         DEFAULT-EXTENSION "txt"
      214         UPDATE glog
      215         .
      216       if not glog then  return.
      217       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      218       if p-is-stream then
      219       do:
      220         if p-is-append then
      221         do:
      222           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      223         end.
      224         else
      225         do:
      226           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      227         end.
      228       end.
      229       else
      230       do:
      231         if p-is-append then
      232         do:
      233           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      234         end.
      235         else
      236         do:
      237           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      238         end.
      239       end.
      240       p-process = yes.
      241     end.
      242   end procedure.
      243   procedure prn-lib-get-report-name :
      244     define input parameter parParentProc  as widget-handle no-undo.
      245     define output parameter p-report-name as character no-undo .
      246     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      247   end procedure.
      248   procedure prn-lib-reportviewer-report-name :
      249     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      250     define input parameter p-report-name-html as character no-undo .
      251     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      252   end procedure.
      253   procedure prn-lib-reportviewer :
      254     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      255     define input parameter p-report-name-html as character no-undo .
      256     define input parameter p-param        as character no-undo .
      257     define variable v-excel           as character no-undo init 'TRUE' .
      258     define variable v-value-character as character no-undo .
      259     define variable v-value-integer   as character no-undo .
      260     define variable v-value-date      as date      no-undo .
      261     define variable v-value-decimal   as decimal   no-undo .
      262     define variable rep-excel         as logical   no-undo .
      263     define variable excel-string      as character no-undo .
      264     define variable v-param-type      as character no-undo .
      265     define variable v-tth             as handle    no-undo .
      266     run adm/shattri.p (
      267       input "get":U
      268       ,input  ""
      269       ,input  0
      270       ,input  'report-glob':U
      271       ,input  'rep-excel':U
      272       ,output v-value-character
      273       ,output v-value-date
      274       ,output v-value-decimal
      275       ,output v-value-integer
      276       ,output rep-excel
      277       ,output v-param-type
      278       ,INPUT-OUTPUT table-handle v-tth
      279       )  .
      280     if rep-excel then v-excel = "TRUE" .
      281     else v-excel = "FALSE" .
      282     if p-param eq ""
      283     then
      284        p-param = "EXCEL:" + v-excel.
      285     else
      286        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      287     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      288   end procedure.
      289   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      290   procedure factord :
      291     define input  parameter p-fact-date            as date    no-undo .
      292     define input  parameter p-fact-time            as integer no-undo .
      293     define input  parameter p-fact-num             as integer no-undo .
      294     define input  parameter p-shift-date           as date    no-undo .
      295     define input  parameter p-shift-num            as integer no-undo .
      296     define input  parameter p-shift-on             as logical no-undo .
      297     define output parameter p-fact-order           as decimal no-undo .
      298     define output parameter p-shift-end-fact-order as decimal no-undo .
      299     define output parameter p-day-end-fact-order   as decimal no-undo .
      300     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      301     if p-fact-date = ?
      302     then do:
      303       return error "Не указана фактическая дата" .
      304     end.
      305     define variable v-fact-date-num as integer no-undo .
      306     assign
      307       v-fact-date-num = integer(p-fact-date)
      308     .
      309     if p-fact-num = ?
      310     or p-fact-num = 0
      311     then do:
      312       return error "Не задан p-fact-num " + string(p-fact-num) .
      313     end.
      314     if p-fact-num < 0
      315     then do:
      316       return error "Отрицательный fact-num " + string(p-fact-num) .
      317     end.
      318     if p-fact-num >= 100000000
      319     then do:
      320       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      321     end.
      322     if p-shift-on = true
      323     then do:
      324       if p-shift-date = ?
      325       then do:
      326         return error "Не задана дата смены" .
      327       end.
      328       if p-shift-num = ?
      329       or p-shift-num = 0
      330       then do:
      331         return error "Не задан номер смены" .
      332       end.
      333     end.
      334     else do:
      335       assign
      336         p-shift-date = p-fact-date
      337         p-shift-num  = 24
      338       .
      339     end.
      340     define variable v-shift-offset as integer no-undo .
      341     if p-shift-date = p-fact-date
      342     then do:
      343       assign
      344         v-shift-offset = 1
      345       .
      346     end.
      347     if p-shift-date < p-fact-date
      348     then do:
      349       assign
      350         v-shift-offset = 0
      351       .
      352     end.
      353     if p-shift-date > p-fact-date
      354     then do:
      355       message
      356         vss-workfile vss-revision vss-description skip
      357         "Неправильная дата закрытия смены" skip
      358         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      359         view-as alert-box error .
      360       undo, return error
      361         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      362           ,string(p-fact-date, '99/99/9999':U)
      363           ,string(p-shift-date, '99/99/9999':U)
      364           )
      365       .
      366     end.
      367     if p-shift-num < 1
      368     or p-shift-num > 24
      369     then do:
      370       message
      371         vss-workfile vss-revision vss-description skip
      372         "Неправильный номер смены" skip
      373         "p-shift-num" p-shift-num skip
      374         view-as alert-box error .
      375       undo, return error return-value .
      376     end.
      377     assign
      378       p-fact-order           = v-fact-date-num
      379                              + v-shift-offset * 0.5
      380                              + p-shift-num    * 0.02 - 0.01
      381                              + p-fact-num     * 0.0000000001
      382       p-shift-end-fact-order = v-fact-date-num
      383                              + v-shift-offset * 0.5
      384                              + p-shift-num    * 0.02
      385       p-day-end-fact-order   = v-fact-date-num
      386                              + 0.99
      387     .
      388     if p-fact-order           <= v-fact-date-num
      389     or p-shift-end-fact-order <= v-fact-date-num
      390     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      391     or p-shift-end-fact-order >= p-day-end-fact-order
      392     then do:
      393       message
      394         vss-workfile vss-revision vss-description skip
      395         "Внутренняя ошибка при генерации фактического номера" skip
      396         "p-fact-date"            p-fact-date            skip
      397         "p-fact-time"            p-fact-time            skip
      398         "p-fact-num"             p-fact-num             skip
      399         "p-shift-date"           p-shift-date           skip
      400         "p-shift-num"            p-shift-num            skip
      401         "p-shift-on"             p-shift-on             skip
      402         "p-shift-end-fact-order" p-shift-end-fact-order skip
      403         "p-day-end-fact-order"   p-day-end-fact-order   skip
      404         "v-fact-date-num"        v-fact-date-num        skip
      405         view-as alert-box error .
      406       undo, return error return-value .
      407     end.
      408   end procedure.
      409   procedure day-begin-fact-order :
      410     define input  parameter p-fact-date            as date    no-undo .
      411     define output parameter p-day-begin-fact-order as decimal no-undo .
      412     do
      413     on error undo, return error return-value
      414     :
      415       if p-fact-date = ?
      416       then do:
      417         assign
      418           p-day-begin-fact-order = 0
      419         .
      420       end.
      421       else do:
      422         assign
      423           p-day-begin-fact-order = integer(p-fact-date)
      424         .
      425       end.
      426     end.
      427   end procedure.
      428   procedure factord-max-fact-order :
      429     define output parameter p-max-fact-order as decimal   no-undo .
      430     do
      431     on error undo, return error return-value
      432     :
      433       run day-begin-fact-order in this-procedure
      434         (input  date(1, 1, 5000)
      435         ,output p-max-fact-order
      436         ) .
      437     end.
      438   end procedure.
      439   procedure factord-cut-archive :
      440     define input  parameter p-obj-type             as character no-undo .
      441     define input  parameter p-obj-code             as integer   no-undo .
      442     define input  parameter p-fact-date            as date      no-undo .
      443     define output parameter p-shift-on             as logical   no-undo .
      444     define output parameter p-shift-date           as date      no-undo .
      445     define output parameter p-shift-num            as integer   no-undo .
      446     define output parameter p-day-end-fact-order   as decimal   no-undo .
      447     define output parameter p-shift-end-fact-order as decimal   no-undo .
      448     define variable v-fact-order as decimal   no-undo .
      449     define buffer buf_shift-obj for ub.shift-obj .
      450     do
      451     on error undo, return error return-value
      452     :
      453   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      455     (input  p-obj-type
      456     ,input  p-obj-code
      457     ,input  'shift-on=request'
      458     ,output p-shift-on
      459     ) no-error .
      460       if error-status :error
      461       then do:
      462         message
      463           vss-workfile vss-revision vss-description skip
      464           "Ошибка при определении атрибута объекта" skip
      465           "Объект" p-obj-type p-obj-code skip
      466           error-status :get-message(1) skip
      467           return-value skip
      468           view-as alert-box error .
      469         undo, return error return-value .
      470       end.
      471       if p-shift-on = false
      472       then do:
      473         assign
      474           p-shift-date               = ?
      475           p-shift-num                = 0
      476         .
      477       end.
      478       else do:
      479         find first buf_shift-obj share-lock
      480           where buf_shift-obj.obj-type   = p-obj-type
      481             and buf_shift-obj.obj-code   = p-obj-code
      482             and buf_shift-obj.shift-date > p-fact-date
      483           use-index pi
      484           no-error .
      485         if not available buf_shift-obj
      486         or buf_shift-obj.status_ <> 'зкр':U
      487         then do:
      488           message
      489             vss-workfile vss-revision vss-description skip
      490             "Невозможно вычислить последнюю смену" skip
      491             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      492             "Объект" p-obj-type p-obj-code skip
      493             "Дата" p-fact-date skip
      494             view-as alert-box error .
      495           undo, return error return-value .
      496         end.
      497         find last buf_shift-obj share-lock
      498           where buf_shift-obj.obj-type = p-obj-type
      499             and buf_shift-obj.obj-code = p-obj-code
      500             and buf_shift-obj.shift-date <= p-fact-date
      501           use-index pi
      502           no-error .
      503         if available buf_shift-obj
      504         then do:
      505           if  buf_shift-obj.status_ = 'зкр':U
      506           then do:
      507             assign
      508               p-shift-date = buf_shift-obj.shift-date
      509               p-shift-num  = buf_shift-obj.shift-num
      510             .
      511           end.
      512           else do:
      513             message
      514               vss-workfile vss-revision vss-description skip
      515               "Невозможно вычислить последнюю смену" skip
      516               "Статус смены отличен от статуса" 'зкр':U skip
      517               "Объект" p-obj-type p-obj-code skip
      518               "Дата" p-fact-date skip
      519               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      520               view-as alert-box error .
      521             undo, return error return-value .
      522           end.
      523         end.
      524         else do:
      525           assign
      526             p-shift-date = p-fact-date - 1
      527             p-shift-num  = 1
      528           .
      529         end.
      530       end.
      531       run factord in this-procedure
      532         (input  p-fact-date
      533         ,input  1
      534         ,input  1
      535         ,input  p-shift-date
      536         ,input  p-shift-num
      537         ,input  p-shift-on
      538         ,output v-fact-order
      539         ,output p-shift-end-fact-order
      540         ,output p-day-end-fact-order
      541         ) no-error .
      542       if error-status :error
      543       then do:
      544         message
      545           vss-workfile vss-revision vss-description skip
      546           "Ошибка при вызове процедуры factord"
      547           error-status :get-message(1) skip
      548           return-value skip
      549           view-as alert-box error .
      550         undo, return error return-value .
      551       end.
      552     end.
      553   end procedure.
      554   procedure factord-lock-shift :
      555     define input  parameter p-obj-type  as character no-undo .
      556     define input  parameter p-obj-code  as integer   no-undo .
      557     define input  parameter p-fact-date as date      no-undo .
      558     define parameter buffer buf_shift-obj for ub.shift-obj .
      559     define variable v-shift-on      as logical   no-undo .
      560     define variable v-extra-message as character no-undo .
      561     define variable v-error as character no-undo .
      562     do
      563     on error undo, return error return-value
      564     :
      565   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      567     (input  p-obj-type
      568     ,input  p-obj-code
      569     ,input  'shift-on=request'
      570     ,output v-shift-on
      571     ) no-error .
      572       if error-status :error
      573       then do:
      574         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      575         undo, return error v-error .
      576       end.
      577       if v-shift-on = true
      578       then do:
      579         find first buf_shift-obj share-lock
      580           where buf_shift-obj.obj-type   = p-obj-type
      581             and buf_shift-obj.obj-code   = p-obj-code
      582             and buf_shift-obj.shift-date > p-fact-date
      583           use-index pi
      584           no-error .
      585         if not available buf_shift-obj
      586         or buf_shift-obj.status_ <> 'зкр':U
      587         then do:
      588           find last buf_shift-obj
      589             where buf_shift-obj.obj-type = p-obj-type
      590               and buf_shift-obj.obj-code = p-obj-code
      591               and buf_shift-obj.status_  = 'зкр':U
      592             use-index stts
      593             no-error .
      594           if available buf_shift-obj
      595           then do:
      596             assign
      597               v-extra-message =
      598                     substitute("Дата начала последеней закрытой смены на объекте &1"
      599                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      600                               )
      601             .
      602           end.
      603           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      604           undo, return error v-error .
      605         end.
      606       end.
      607     end.
      608   end procedure.
      609   procedure factord-end-day :
      610     define input  parameter p-fact-date            as date    no-undo .
      611     define output parameter p-day-end-fact-order   as decimal no-undo .
      612     do
      613     on error undo, return error return-value
      614     :
      615       if p-fact-date = ?
      616       then do:
      617         return error "Не указана фактическая дата" .
      618       end.
      619       assign
      620         p-day-end-fact-order = integer(p-fact-date) + 0.99
      621       .
      622     end.
      623   end procedure.
      624   procedure factord-to-date :
      625     define input  parameter p-fact-order as decimal no-undo .
      626     define output parameter p-fact-date  as date    no-undo .
      627     define variable v-ref-date  as date      no-undo .
      628     define variable v-ref-delta as integer   no-undo .
      629     do
      630     on error undo, return error return-value
      631     :
      632       if p-fact-order = ?
      633       or p-fact-order = 0
      634       then do:
      635         return error "Не указан fact-order" .
      636       end.
      637       assign
      638         v-ref-date  = date(1, 1, 2000)
      639       .
      640       assign
      641         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      642       .
      643       assign
      644         p-fact-date = v-ref-date + v-ref-delta
      645       .
      646     end.
      647   end procedure.
      648   procedure factord-to-fact-num :
      649     define input  parameter p-fact-order as decimal no-undo .
      650     define output parameter p-fact-num   as integer no-undo .
      651     define variable v-fact-order-trunc as decimal no-undo .
      652     do
      653     on error undo, return error return-value
      654     :
      655       if p-fact-order = ?
      656       or p-fact-order = 0
      657       then do:
      658         return error "Не указан fact-order" .
      659       end.
      660       assign
      661        v-fact-order-trunc = truncate(p-fact-order, 2)
      662       .
      663       assign
      664         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      665       .
      666     end.
      667   end procedure.
      668   procedure factord-to-shift-num :
      669     define input  parameter p-fact-order as decimal no-undo .
      670     define output parameter p-shift-num   as integer no-undo .
      671     define variable  p-shift-numd  as decimal   no-undo .
      672     define variable v-fact-order-trunc as decimal no-undo .
      673     do
      674     on error undo, return error return-value
      675     :
      676       if p-fact-order = ?
      677       or p-fact-order = 0
      678       then do:
      679         return error "Не указан fact-order" .
      680       end.
      681       assign
      682        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      683       .
      684       if v-fact-order-trunc < 0.5 then do:
      685         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      686       end.
      687       assign
      688         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      689         .
      690        assign
      691         p-shift-num = truncate (p-shift-numd , 0)
      692       .
      693     end.
      694   end procedure.
      695   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      696   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      697   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      698   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      699   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      700   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      701   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      702   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      703   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      704   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      705   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      706   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      707   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      708   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      709   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      710   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      711   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      712   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      713   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      714   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      715   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      716   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      717   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      718   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      719   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      720   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      721   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      722   define variable temp1 as integer   no-undo.
      723   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      724   function breakstr returns character ( input        for-name    as character,
      725                                         input        line-length as integer,
      726                                         input-output line1       as character,
      727                                         input-output line2       as character ) :
      728     define variable ii as integer no-undo.
      729     if length( for-name ) > line-length then do:
      730       assign ii    = 1
      731              line1 = "":u
      732              line2 = "":u.
      733       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      734         assign line1 =       substring( for-name, 1, line-length     )
      735                line2 = trim( substring( for-name,    line-length + 1 ) ).
      736       end.                                                     else do:
      737         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      738           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      739                  ii    = ii    + 1.
      740           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      741             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      742           end.
      743         end.
      744         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      745       end.
      746     end.                                else do:
      747       assign line1 = for-name
      748              line2 = "":u.
      749     end.
      750     return ( line1 ).
      751   end function.
      752   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      753   procedure cur-time :
      754      define output parameter p-today as date      no-undo .
      755      define output parameter p-time  as integer   no-undo .
      756     do
      757     on error undo, return error
      758     :
      759       define variable v-date1 as date      no-undo .
      760       define variable v-date2 as date      no-undo .
      761       define variable v-time  as integer   no-undo .
      762       assign
      763         v-date1 = today
      764         v-time  = time
      765         v-date2 = today
      766       .
      767       if v-date1 <> v-date2
      768       then do:
      769         assign
      770           v-date1 = today
      771           v-time  = v-time
      772         .
      773       end.
      774       assign
      775         p-today = v-date1
      776         p-time  = v-time
      777       .
      778     end.
      779   end.
      780   function cur-time-date returns character
      781   :
      782     return string(today, '99/99/9999':U) .
      783   end.
      784   function cur-time-mjd returns decimal
      785   :
      786     define variable v-date as date      no-undo .
      787     define variable v-time as integer   no-undo .
      788     run cur-time in this-procedure
      789       (output v-date
      790       ,output v-time
      791       ) .
      792     return integer(v-date) - 2400002 + (v-time / 86400) .
      793   end.
      794   function cur-time-get-ending-index returns integer
      795   (input p-number as integer
      796   )
      797   :
      798     if p-number < 0
      799     or p-number = ?
      800     then do:
      801       return 1 .
      802     end.
      803     define variable v-rest as integer   no-undo .
      804     assign
      805       p-number = p-number modulo 100
      806     .
      807     if p-number < 20
      808     then do:
      809       assign
      810         v-rest = p-number
      811       .
      812     end.
      813     else do:
      814       assign
      815         v-rest = p-number modulo 10
      816       .
      817     end.
      818     case v-rest :
      819       when 1
      820       then do:
      821         return 2 .
      822       end.
      823       when 2 or
      824       when 3 or
      825       when 4
      826       then do:
      827         return 3 .
      828       end.
      829       otherwise do:
      830         return 1 .
      831       end.
      832     end case .
      833   end.
      834   procedure cur-time-mjd-to-date :
      835      define input  parameter i-mjd-diff as decimal no-undo.
      836      define output parameter o-Date     as date    no-undo.
      837      define output parameter o-Time     as integer no-undo.
      838      define variable v-day-number as integer   no-undo .
      839      if    i-mjd-diff < 0
      840         or i-mjd-diff = ?
      841      then do:
      842         return "?" .
      843      end.
      844      assign
      845         v-day-number = truncate(i-mjd-diff,0).
      846         o-Date = date(v-day-number + 2400002).
      847         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      848     .
      849   end.
      850   function cur-time-mjd-to-string returns character
      851   (input p-mjd-diff as decimal
      852   )
      853   :
      854     define variable v-day-number as integer   no-undo .
      855     define variable v-seconds    as integer   no-undo .
      856     define variable v-hour       as integer   no-undo .
      857     define variable v-min        as integer   no-undo .
      858     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      859     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      860     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      861     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      862     if p-mjd-diff < 0
      863     or p-mjd-diff = ?
      864     then do:
      865       return "?" .
      866     end.
      867     assign
      868       v-day-number = integer(truncate(p-mjd-diff,0))
      869       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      870     .
      871     if v-seconds > 86400
      872     then do:
      873       assign
      874         v-seconds = 86400 - 1
      875       .
      876     end.
      877     if v-seconds < 0
      878     then do:
      879       assign
      880         v-seconds = 0
      881       .
      882     end.
      883     assign
      884       v-hour = truncate(v-seconds / 3600, 0)
      885     .
      886     assign
      887       v-seconds = v-seconds modulo 3600
      888     .
      889     assign
      890       v-min = truncate(v-seconds / 60, 0)
      891     .
      892     assign
      893       v-seconds = v-seconds modulo 60
      894     .
      895     return
      896         (if v-day-number <> 0
      897           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      898           else ""
      899         )
      900       + (if v-day-number <> 0 or v-hour <> 0
      901           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      902           else ""
      903         )
      904       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      905           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      906           else ""
      907         )
      908       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      909       .
      910   end.
      911   function cur-time-string returns character
      912   :
      913     define variable v-date as date      no-undo .
      914     define variable v-time as integer   no-undo .
      915     run cur-time in this-procedure
      916       (output v-date
      917       ,output v-time
      918       ) .
      919     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      920   end.
      921   function cur-time-string-sec returns character
      922   :
      923     define variable v-date as date      no-undo .
      924     define variable v-time as integer   no-undo .
      925     run cur-time in this-procedure
      926       (output v-date
      927       ,output v-time
      928       ) .
      929     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      930   end.
      931   function cur-time-custom  returns character
      932   (input p-prefix as character
      933   ,input p-date-format as character
      934   ,input p-delimiter as character
      935   ,input p-time-format as character
      936   ,input p-suffix as character
      937   )
      938   :
      939     define variable v-date as date      no-undo .
      940     define variable v-time as integer   no-undo .
      941     run cur-time in this-procedure
      942       (output v-date
      943       ,output v-time
      944       ) .
      945     return
      946       p-prefix
      947       + string(v-date, p-date-format)
      948       + p-delimiter
      949       + string(v-time, p-time-format)
      950       + p-suffix
      951       .
      952   end.
      953   function cur-time-print  returns character
      954   :
      955     define variable v-date as date      no-undo .
      956     define variable v-time as integer   no-undo .
      957     run cur-time in this-procedure
      958       (output v-date
      959       ,output v-time
      960       ) .
      961     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      962   end.
      963   function cur-time-datetime returns datetime
      964   :
      965     define variable v-char as character no-undo .
      966     define variable v-datetime as datetime no-undo .
      967     v-char = cur-time-string().
      968     v-datetime = datetime(v-char).
      969     return  v-datetime.
      970   end.
      971   function cur-time-string-msec returns character
      972   :
      973     define variable v-date as datetime  no-undo .
      974     v-date = now.
      975     return string(v-date) .
      976   end.
      977   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      978     define variable v-cntxt-db-num        as integer   no-undo .
      979     define variable v-cntxt-userid        as character no-undo .
      980     define variable v-cntxt-level         as character no-undo .
      981     define variable v-cntxt-host-code-obj as integer   no-undo .
      982     define variable v-cntxt-obj-type      as character no-undo .
      983     define variable v-cntxt-obj-code      as integer   no-undo .
      984     define variable v-cntxt-db-num-obj    as integer   no-undo .
      985     define variable v-cntxt-is-admin      as logical   no-undo .
      986   define variable v-account as integer init 0 no-undo .
      987   define variable v-account-lavel as character no-undo .
      988   define variable v-button-stop as logical no-undo .
      989   define variable v-kol-spice as integer no-undo .
      990   define variable v-kol-spice2 as integer no-undo .
      991   define variable v-kol-spice3 as integer no-undo .
      992   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      993   DEFINE BUTTON StopBtn AUTO-END-KEY
      994        LABEL "Стоп"
      995        SIZE 10 BY 1.
      996   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      997        LABEL "Обработано записей"
      998         VIEW-AS TEXT
      999        SIZE 14 BY .67 NO-UNDO.
     1000   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1001         VIEW-AS TEXT
     1002        SIZE 53.25 BY .67
     1003        FGCOLOR 1  NO-UNDO.
     1004   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1005         VIEW-AS TEXT
     1006        SIZE 53.25 BY .67
     1007        FGCOLOR 1  NO-UNDO.
     1008   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1009         VIEW-AS TEXT
     1010        SIZE 53.25 BY .67
     1011        FGCOLOR 1  NO-UNDO.
     1012   DEFINE RECTANGLE RECT-1
     1013        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1014        SIZE 55.13 BY 4.46.
     1015   DEFINE FRAME InfoFrame
     1016        StopBtn AT ROW 4.25 COL 21.75
     1017        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1018        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1019        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1020        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1021        RECT-1 AT ROW 1 COL 1
     1022       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1023            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1024            TITLE "Процесс"
     1025            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1026   define variable mFrameView      as logical   no-undo init yes.
     1027     define variable mFramHandle as handle no-undo.
     1028     mFramHandle = frame InfoFrame:handle.
     1029     if  log-manager:logfile-name ne ?
     1030     then DO:
     1031         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1032         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1033         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1034     end.
     1035     mFrameView = not session:batch-mode and mFramHandle:visible.
     1036     if mFrameView
     1037     then do:
     1038       ASSIGN
     1039          FRAME InfoFrame:HIDDEN                           = TRUE
     1040          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1041     end.
     1042   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1043   DO:
     1044     IF not StopProcessing THEN
     1045       Message "Вы действительно хотите прервать" SKIP
     1046               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1047                 UPDATE StopProcessing.
     1048     IF StopProcessing THEN do:
     1049        if mFrameView
     1050        then do:
     1051           HIDE FRAME InfoFrame.
     1052        end.
