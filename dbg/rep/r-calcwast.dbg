     1579   HEADER
     1580   "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" SKIP
     1581   with width 232 down stream-io .
     1582   define frame itog
     1583   space(134) sym1 column-label ":" format "X(1)"
     1584   zagolovok format "X(44)" space(0)
     1585   sym2 column-label ":" format "X(1)" space(0)
     1586   znachenie format "->>>>>>>>9.99"      space(0)
     1587   with width 232 down stream-io no-label.
     1588   do:
     1589     run prn-lib-open-stream  in this-procedure
     1590       ( input parParentProc
     1591       , input 43
     1592       , input yes
     1593       , input no
     1594       ).
     1595     run print-header.
     1596     assign  Counter1 = 0 .
     1597   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1598     if  log-manager:logfile-name ne ?
     1599     then DO:
     1600         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1601     end.
     1602     if not session:batch-mode then
     1603     do:
     1604       VIEW FRAME InfoFrame.
     1605       mFrameView = true.
     1606     end.
     1607      v-button-stop = false .
     1608         if mFrameView
     1609         then do:
     1610         if v-button-stop then view STOPBTN in frame InfoFrame.
     1611                          else Hide STOPBTN in frame InfoFrame.
     1612         end.
     1613     assign
     1614       v-sum-price  = 0
     1615       v-sum-qnty   = 0
     1616     .
     1617     case x-date-out-type :
     1618       when "calend-date" then do :
     1619         run day-begin-fact-order(
     1620             input x-Date-Start,
     1621             output v-fact-order-start
     1622             ).
     1623         run factord-end-day(
     1624             input x-Date-End,
     1625             output v-fact-order-end
     1626             ).
     1627         for each gds-list no-lock :
     1628             for each buf_ot-line
     1629                 where buf_ot-line.obj-type   = x-store-type
     1630                   and buf_ot-line.obj-code   = x-store-code
     1631                   and buf_ot-line.fact-order >= v-fact-order-start
     1632                   and buf_ot-line.fact-order <= v-fact-order-end
     1633                   and buf_ot-line.artic      = gds-list.artic
     1634                   and buf_ot-line.prod-code  = gds-list.prod-code
     1635                   and buf_ot-line.prod-type  = gds-list.prod-type
     1636                   and buf_ot-line.sum-type   = "cost"
     1637                   and (buf_ot-line.ext-doc-type = 'vt':U
     1638                    or buf_ot-line.ext-doc-type = 'ev':U
     1639                    or buf_ot-line.ext-doc-type = 'ee':U
     1640                    or buf_ot-line.ext-doc-type = 'es':U) no-lock :
     1641               if buf_ot-line.ext-doc-type = 'vt':U then do :
     1642                   assign
     1643                     v-sum-deficit = v-sum-deficit - buf_ot-line.fact-qnty
     1644                   .
     1645               end.
     1646               else do :
     1647                 assign
     1648                   v-sum-price = v-sum-price - buf_ot-line.sum-rubl
     1649                   v-sum-qnty  = v-sum-qnty  - buf_ot-line.fact-qnty
     1650                 .
     1651               end.
     1652             end.
     1653             create tt-calcwast.
     1654             assign
     1655               tt-calcwast.artic    = gds-list.artic
     1656               tt-calcwast.gds-name = gds-list.gds-name
     1657               tt-calcwast.deficit  = if v-sum-deficit <> ? then v-sum-deficit else 0
     1658               tt-calcwast.price    = if v-sum-price / v-sum-qnty <> ? then v-sum-price / v-sum-qnty else 0
     1659               tt-calcwast.oborot   = if v-sum-qnty <> ? then v-sum-qnty else 0
     1660             .
     1661             find first buf_goods no-lock
     1662                  where buf_goods.gds-code = gds-list.gds-code no-error.
     1663             if available buf_goods then do :
     1664               assign
     1665                 tt-calcwast.wastage       = buf_goods.normal-wastage
     1666                 tt-calcwast.allowed-wast  = tt-calcwast.oborot * tt-calcwast.wastage / 100
     1667                 tt-calcwast.over-wast     = if tt-calcwast.deficit <= 0 then 0 else ( tt-calcwast.deficit - tt-calcwast.allowed-wast )
     1668                 tt-calcwast.all-wast-rubl = if tt-calcwast.deficit <= 0 then 0 else tt-calcwast.allowed-wast * tt-calcwast.price
     1669                 tt-calcwast.deficit-rubl  = tt-calcwast.deficit * tt-calcwast.price
     1670                 tt-calcwast.grp-code      = buf_goods.grp-code
     1671                 tt-calcwast.grp-name      = buf_goods.grp-name
     1672                 tt-calcwast.prod-code     = buf_goods.prod-code
     1673                 tt-calcwast.prod-type     = buf_goods.prod-type
     1674               .
     1675             end.
     1676             find first buf_clients no-lock
     1677                 where buf_clients.obj-code = buf_goods.prod-code
     1678                   and buf_clients.obj-code = buf_goods.prod-code no-error.
     1679             if available buf_clients then do :
     1680               tt-calcwast.prod-name = buf_clients.obj-name.
     1681             end.
     1682             assign
     1683               Counter1 = Counter1 + 1
     1684               v-sum-price  = 0
     1685               v-sum-qnty   = 0
     1686               v-sum-deficit = 0
     1687               .
     1688   IF ( Counter1 modulo v-account = 0 )  then DO:
     1689             if  log-manager:logfile-name ne ?
     1690             then DO:
     1691                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1692             end.
     1693              if mFrameView
     1694              then do:
     1695               DISPLAY
     1696                 Counter1 @ RecordsDone
     1697                 WITH FRAME InfoFrame.
     1698              end.
     1699   End.
     1700      if v-button-stop then  DO:
     1701            if mFrameView
     1702            then
     1703               PROCESS EVENTS.
     1704            IF StopProcessing THEN DO:
     1705            RETURN error.
     1706            End.
     1707      end.
     1708         end.
     1709       end.
     1710       when "inv-to-date" then do :
