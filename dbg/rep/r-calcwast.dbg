     1917             accumulate tt-calcwast.deficit-rubl  (sub-total by tt-calcwast.grp-code).
     1918             accumulate tt-calcwast.deficit       (total).
     1919             accumulate tt-calcwast.oborot        (total).
     1920             accumulate tt-calcwast.allowed-wast  (total).
     1921             accumulate tt-calcwast.over-wast     (total).
     1922             accumulate tt-calcwast.all-wast-rubl (total).
     1923             accumulate tt-calcwast.deficit-rubl  (total).
     1924             if first-of (tt-calcwast.grp-code) then do :
     1925               if Make-Excel then  put   stream ForExcel unformatted
     1926                   CHR(9) "Группа товаров - " + tt-calcwast.grp-name
     1927               skip.
     1928               run print-grp (tt-calcwast.grp-name).
     1929             end.
     1930             run  print-line (input recid(tt-calcwast)).
     1931             if last-of (tt-calcwast.grp-code) then do :
     1932               if Make-Excel then  put   stream ForExcel unformatted
     1933                   CHR(9) "Итоги по группе "       CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.deficit)
     1934                                                          CHR(9)
     1935                                                          CHR(9)
     1936                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.oborot )
     1937                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.allowed-wast)
     1938                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.over-wast)
     1939                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.all-wast-rubl)
     1940                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.deficit-rubl)
     1941               skip.
     1942               run print-sub-total("Итоги по группе ",
     1943                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.deficit,
     1944                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.oborot,
     1945                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.allowed-wast,
     1946                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.over-wast,
     1947                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.all-wast-rubl,
     1948                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.deficit-rubl
     1949                                 ).
     1950             end.
     1951           end.
     1952         end.
     1953         else do :
     1954           for each tt-calcwast break by tt-calcwast.grp-code by tt-calcwast.gds-name :
     1955             accumulate tt-calcwast.deficit       (sub-total by tt-calcwast.grp-code).
     1956             accumulate tt-calcwast.oborot        (sub-total by tt-calcwast.grp-code).
     1957             accumulate tt-calcwast.allowed-wast  (sub-total by tt-calcwast.grp-code).
     1958             accumulate tt-calcwast.over-wast     (sub-total by tt-calcwast.grp-code).
     1959             accumulate tt-calcwast.all-wast-rubl (sub-total by tt-calcwast.grp-code).
     1960             accumulate tt-calcwast.deficit-rubl  (sub-total by tt-calcwast.grp-code).
     1961             accumulate tt-calcwast.deficit       (total).
     1962             accumulate tt-calcwast.oborot        (total).
     1963             accumulate tt-calcwast.allowed-wast  (total).
     1964             accumulate tt-calcwast.over-wast     (total).
     1965             accumulate tt-calcwast.all-wast-rubl (total).
     1966             accumulate tt-calcwast.deficit-rubl  (total).
     1967             if first-of (tt-calcwast.grp-code) then do :
     1968               if Make-Excel then  put   stream ForExcel unformatted
     1969                   CHR(9) "Группа товаров - " + tt-calcwast.grp-name
     1970               skip.
     1971               run print-grp (tt-calcwast.grp-name).
     1972             end.
     1973             run  print-line (input recid(tt-calcwast)).
     1974             if last-of (tt-calcwast.grp-code) then do :
     1975               if Make-Excel then  put   stream ForExcel unformatted
     1976                   CHR(9) "Итоги по группе "       CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.deficit)
     1977                                                          CHR(9)
     1978                                                          CHR(9)
     1979                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.oborot )
     1980                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.allowed-wast)
     1981                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.over-wast)
     1982                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.all-wast-rubl)
     1983                                                          CHR(9) (accum sub-total by tt-calcwast.grp-code tt-calcwast.deficit-rubl)
     1984               skip.
     1985               run print-sub-total( "Итоги по группе " ,
     1986                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.deficit,
     1987                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.oborot,
     1988                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.allowed-wast,
     1989                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.over-wast,
     1990                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.all-wast-rubl,
     1991                                   accum sub-total by tt-calcwast.grp-code tt-calcwast.deficit-rubl
     1992                                   ).
     1993             end.
     1994           end.
     1995         end.
     1996       end.
     1997     end case.
     1998     if Make-Excel then  put   stream ForExcel unformatted
     1999         CHR(9) "ИТОГО "       CHR(9) (accum total tt-calcwast.deficit)
     2000                                      CHR(9)
     2001                                      CHR(9)
     2002                                      CHR(9) (accum total tt-calcwast.oborot )
     2003                                      CHR(9) (accum total tt-calcwast.allowed-wast)
     2004                                      CHR(9) (accum total tt-calcwast.over-wast)
     2005                                      CHR(9) (accum total tt-calcwast.all-wast-rubl)
     2006                                      CHR(9) (accum total tt-calcwast.deficit-rubl)
     2007     skip.
     2008     run print-sub-total( "ИТОГО",
     2009                          accum total tt-calcwast.deficit,
     2010                          accum total tt-calcwast.oborot ,
     2011                          accum total tt-calcwast.allowed-wast ,
     2012                          accum total tt-calcwast.over-wast ,
     2013                          accum total tt-calcwast.all-wast-rubl,
     2014                          accum total tt-calcwast.deficit-rubl
     2015                        ).
     2016     run print-podval(accum total tt-calcwast.deficit-rubl,
     2017                      accum total tt-calcwast.all-wast-rubl
     2018                     ).
     2019     if Make-Excel then  put   stream ForExcel unformatted
     2020        CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) "Недостача,руб"
     2021        CHR(9) CHR(9) (accum total tt-calcwast.deficit-rubl) skip.
     2022      if Make-Excel then  put   stream ForExcel unformatted
     2023        CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) "Допустимая ест.убыль"
     2024        CHR(9) CHR(9) (accum total tt-calcwast.all-wast-rubl) skip.
     2025      if Make-Excel then  put   stream ForExcel unformatted
     2026        CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) CHR(9) "Недостача с кор.учетом ест.убыли"
     2027        CHR(9) CHR(9) ((accum total tt-calcwast.deficit-rubl) - (accum total tt-calcwast.all-wast-rubl)) skip.
     2028     if Make-Excel then output stream ForExcel close.
     2029     output stream PrnLibStream close.
     2030   if session :set-wait-state( "" ) then.
     2031     run prn-lib-prn-file in this-procedure (
     2032                                             input parParentProc
     2033                                             ,input 8
     2034                                             ).
     2035   end.
     2036   procedure print-line :
     2037     DEFINE  INPUT PARAMETER p-line-rec_id   AS RECID     NO-UNDO.
     2038   for tt-calcwast field ( artic
     2039                           gds-name
     2040                           deficit
     2041                           wastage
     2042                           price
     2043                           oborot
     2044                           allowed-wast
     2045                           over-wast
     2046                           all-wast-rubl
     2047                           deficit-rubl ) where recid (tt-calcwast) = p-line-rec_id no-lock :
     2048       if Make-Excel then  put   stream ForExcel unformatted
     2049                 tt-calcwast.artic              CHR(9)
     2050                 tt-calcwast.gds-name           CHR(9)
     2051                 tt-calcwast.deficit            CHR(9)
     2052                 tt-calcwast.wastage            CHR(9)
     2053                 tt-calcwast.price              CHR(9)
     2054                 tt-calcwast.oborot             CHR(9)
     2055                 tt-calcwast.allowed-wast       CHR(9)
     2056                 tt-calcwast.over-wast          CHR(9)
     2057                 tt-calcwast.all-wast-rubl      CHR(9)
     2058                 tt-calcwast.deficit-rubl  CHR(9)
     2059       skip.
     2060       display stream PrnLibStream sym1  tt-calcwast.artic
     2061                                   sym2  tt-calcwast.gds-name
     2062                                   sym3  tt-calcwast.deficit
     2063                                   sym4  tt-calcwast.wastage
     2064                                   sym5  tt-calcwast.price
     2065                                   sym6  tt-calcwast.oborot
     2066                                   sym7  tt-calcwast.allowed-wast
     2067                                   sym8  tt-calcwast.over-wast
     2068                                   sym9  tt-calcwast.all-wast-rubl
     2069                                   sym10 tt-calcwast.deficit-rubl
     2070                                   sym11 skip
     2071       with frame calcwastage .
     2072       down stream PrnLibStream with frame calcwastage .
     2073   end.
     2074   end.
     2075   procedure print-grp.
     2076     define input parameter p-grp as character.
     2077     form with frame calcwastage.
     2078     display stream PrnLibStream sym1 "Группа товаров - " + p-grp @ tt-calcwast.gds-name sym11 with frame calcwastage.
     2079     down stream PrnLibStream with frame calcwastage .
     2080     put stream PrnLibStream unformatted "          ------------------------------------------------------------------- " .
     2081   end.
     2082   procedure print-prod.
     2083     define input parameter p-prod-type as character.
     2084     define input parameter p-prod-code as integer.
     2085     define input parameter p-prod-name as character.
     2086     form with frame calcwastage.
     2087     display stream PrnLibStream sym1 "Производитель - " + p-prod-type + string(p-prod-code) + "" + p-prod-name @ tt-calcwast.gds-name sym11 with frame calcwastage.
     2088     down stream PrnLibStream with frame calcwastage .
     2089     put stream PrnLibStream unformatted "          ------------------------------------------------------------------- " .
     2090   end.
     2091   procedure print-sub-total.
     2092     define input parameter p-str        as character.
     2093     define input parameter p-st-deficit as decimal.
     2094     define input parameter p-st-oborot  as decimal.
     2095     define input parameter p-st-allowed-wast as decimal.
     2096     define input parameter p-st-over-wast as decimal.
     2097     define input parameter p-st-all-wast-rubl as decimal.
     2098     define input parameter p-st-deficit-rubl as decimal.
     2099     form with frame calcwastage.
     2100     if p-str <> "ИТОГО" then put stream PrnLibStream unformatted "          ------------------------------------------------------------------- " .
     2101     display stream PrnLibStream sym1 p-str @ tt-calcwast.gds-name
     2102                                 sym3 p-st-deficit @ tt-calcwast.deficit format "->>>>>>>>9.999"
     2103                                 sym6 p-st-oborot @ tt-calcwast.oborot format "->>>>>>>>9.999"
     2104                                 sym7 p-st-allowed-wast @ tt-calcwast.allowed-wast format "->>>>>>>9.999"
     2105                                 sym8 p-st-over-wast @ tt-calcwast.over-wast format "->>>>>>>9.999"
     2106                                 sym9 p-st-all-wast-rubl @ tt-calcwast.all-wast-rubl format "->>>>>>>9.99"
     2107                                 sym10 p-st-deficit-rubl @ tt-calcwast.deficit-rubl format "->>>>>>>9.99"
     2108                                 sym11  skip with frame calcwastage.
     2109     down stream PrnLibStream with frame calcwastage .
     2110     put stream PrnLibStream unformatted "---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" .
     2111   end.
     2112   procedure print-header :
     2113   find first sheetf where sheet-num = 1 .
     2114       assign
     2115       Sheetf.MergeCellsH = ""
     2116       Sheetf.MergeCellsV = ""
     2117       Sheetf.Excel-Column-Lable = "Артикул" + chr(44) +
     2118                            "Название товара" + chr(44) +
     2119                            "Недостача кг" + chr(44) +
     2120                            "% ест.убыли" + chr(44) +
     2121                            "Учетная цена" + chr(44) +
     2122                            "Оборот кг" + chr(44) +
     2123                            "Допустимая ест.убыль кг" + chr(44) +
     2124                            "Превышение допустимой ест.убыль кг" + chr(44) +
     2125                            "Допустимая ест.убыль руб" + chr(44) +
     2126                            "Недостача руб"
     2127       Sheetf.Sizes = "8,66,15,6,15,15,15,15,15,15"
     2128       Sheetf.colformat = "1=@;2=@;3=0,000;4=0,00;5=0,00;6=0,000;7=0,000;8=0,000;9=0,00;10=0,00"
     2129       .
     2130     str2 = "" .
     2131     RUN rep/extitle.p (1).
     2132     put stream PrnLibStream unformatted
     2133     reportNAme  + chr(10)
     2134                 + str1 + str3 + str4 + chr(10)
     2135                 + ReportHeader.
     2136   end.
     2137   procedure print-podval.
     2138     define input parameter p-st-deficit-rubl as decimal.
     2139     define input parameter p-st-all-wast-rubl as decimal.
     2140     define variable v-line as character no-undo.
     2141     assign
     2142       v-line = "                                                                                                                                       ------------------------------------------------------------"
     2143     .
     2144     form with frame itog.
     2145     display stream PrnLibStream sym1 "Недостача,руб" @ zagolovok
     2146                                 sym2 p-st-deficit-rubl @ znachenie
     2147                                 sym3 skip with frame itog.
     2148     put stream PrnLibStream unformatted v-line.
     2149     down stream PrnLibStream with frame itog.
     2150     display stream PrnLibStream sym1 "Допустимая ест.убыль" @ zagolovok
     2151                                 sym2 p-st-all-wast-rubl @ znachenie
     2152                                 sym3 skip with frame itog.
     2153     put stream PrnLibStream unformatted v-line.
     2154     down stream PrnLibStream with frame itog.
     2155     display stream PrnLibStream sym1 "Недостача с кор.учетом ест.убыли" @ zagolovok
     2156                                 sym2 (p-st-deficit-rubl - p-st-all-wast-rubl) @ znachenie
     2157                                 sym3 skip with frame itog.
     2158     put stream PrnLibStream unformatted v-line.
     2159     down stream PrnLibStream with frame itog.
     2160   end.
