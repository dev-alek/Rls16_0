     1116   def
     1117    shared
     1118   temp-table  obj-list no-undo
     1119     field obj-type like ub.clients.obj-type
     1120     field obj-code like ub.clients.obj-code
     1121     field obj-name like ub.clients.obj-name
     1122     field obj-id   as integer
     1123     field db-num   as integer
