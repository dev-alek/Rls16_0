      643     run mainmenu_getcntxt in parparentproc
      644       (output v-cntxt-db-num
      645       ,output v-cntxt-userid
      646       ,output v-cntxt-level
      647       ,output v-cntxt-host-code-obj
      648       ,output v-cntxt-obj-type
      649       ,output v-cntxt-obj-code
      650       ,output v-cntxt-db-num-obj
      651       ,output v-cntxt-is-admin
