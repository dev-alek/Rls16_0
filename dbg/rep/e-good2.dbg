      191   procedure create_obj-list :
      192      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      193      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      194      do
      195      on error undo, return error return-value
      196      :
      197         define buffer cli-obj for ub.clients .
      198         define variable p-var as integer no-undo .
      199         define buffer buf_obj-list for obj-list .
      200         find last buf_obj-list  use-index pi no-error .
      201         if available buf_obj-list
      202         then
      203            p-var = buf_obj-list.obj-id + 1.
      204         else
      205            p-var = 1.
      206         find first cli-obj where
      207                   cli-obj.obj-type = p-obj-type
      208               and cli-obj.obj-code = p-obj-code
      209         no-lock no-error.
      210         if available cli-obj
      211         then do:
      212            create buf_obj-list.
      213            assign
      214               buf_obj-list.obj-id   = p-var
      215               buf_obj-list.obj-code = cli-obj.obj-code
      216               buf_obj-list.obj-type = cli-obj.obj-type
      217               buf_obj-list.obj-name = cli-obj.obj-name
      218               buf_obj-list.db-num   = cli-obj.db-num
      219            .
      220         end.
      221      end.
      222   end.
