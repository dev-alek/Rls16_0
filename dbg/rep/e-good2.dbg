      655   define variable v-can-print  as logical   no-undo .
      656   define variable v-today      as date      no-undo .
      657   my-handle =  parParentProc .
      658   DEFINE BUTTON B-Help
      659        LABEL "&Помощь"
      660        SIZE 10 BY 1
      661        BGCOLOR 8 .
      662   DEFINE BUTTON Btn-Cancel AUTO-END-KEY
      663        LABEL "Отмена"
      664        SIZE 10 BY 1
      665        BGCOLOR 8 .
      666   DEFINE BUTTON Btn_OK AUTO-GO
      667        LABEL "Печать"
      668        SIZE 10 BY 1
      669        BGCOLOR 8 .
      670   DEFINE VARIABLE date-1 AS DATE FORMAT "99/99/9999":U
      671        LABEL "   с"
      672        VIEW-AS FILL-IN
      673        SIZE 13.75 BY 1 NO-UNDO.
      674   DEFINE VARIABLE date-2 AS DATE FORMAT "99/99/9999":U
      675        LABEL "по"
      676        VIEW-AS FILL-IN
      677        SIZE 13.75 BY 1 NO-UNDO.
      678   DEFINE RECTANGLE RECT-1
      679        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      680        SIZE 48.38 BY 4.5.
      681   DEFINE VARIABLE TOG-inv AS LOGICAL INITIAL no
      682        LABEL "с последней инвентаризации"
      683        VIEW-AS TOGGLE-BOX
      684        SIZE 28.88 BY .83 NO-UNDO.
      685   DEFINE FRAME Dialog-Frame
      686        Btn-Cancel AT ROW 1.25 COL 1.63
      687        Btn_OK AT ROW 1.25 COL 11.63
      688        B-Help AT ROW 1.25 COL 40.38
      689        date-1 AT ROW 2.79 COL 10 COLON-ALIGNED
      690        date-2 AT ROW 4 COL 9.88 COLON-ALIGNED
      691        TOG-inv AT ROW 5.38 COL 8
      692        RECT-1 AT ROW 2.46 COL 1.63
      693        SPACE(0.73) SKIP(0.36)
      694       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      695            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      696            TITLE "Печать списка документов"
      697            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn-Cancel.
      698   ASSIGN
      699          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      700          FRAME Dialog-Frame:HIDDEN           = TRUE.
      701   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      702   DO:
      703     APPLY "END-ERROR":U TO SELF.
      704   END.
      705   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      706   DO:
      707   DEFINE VARIABLE v-host-code like ub.sysconf.host-code no-undo .
      708   def buffer goods1 for goods .
      709   define buffer buf_shop for ub.shop.
      710   define buffer buf_store for ub.store.
      711   define buffer buf_sysconf for ub.sysconf.
      712   define buffer buf_currency for ub.currency.
      713   assign frame Dialog-Frame  date-1 date-2 tog-inv .
      714     for each gds-list share-lock:
      715        delete gds-list.
      716     End.
      717      find goods1 where
      718      goods1.artic     = xartic And
      719      goods1.prod-type = xprod-type And
      720      goods1.prod-code = xprod-code
      721        no-lock no-error.
      722       if available goods1 then DO:
      723           create gds-list.
      724           BUFFER-copy goods1 TO gds-list no-error.
      725       End.
      726     for each obj-list share-lock:
      727        delete obj-list.
      728     End.
      729   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      730   run create_obj-list in this-procedure
      731    ( input xobj-type ,
      732      input xobj-code )
      733      .
      734   ReportNAme = "О Т Ч Е Т   О   С О С Т О Я Н И И   З А П А С А   И   П Р О Д А Ж А Х   ( по одному товару)".
      735    ReportHeader = ReportHeader  + chr(10) + goods1.gds-name .
      736    Assign
      737     x-SET_val_TYPE = 1
      738     x-Date-Start = date-1
      739     x-Date-end   = date-2   .
      740   if tog-inv then do:
      741     assign
      742       ReportHeader = ReportHeader + chr(10) + " с момента последней инвентаризации "
      743     .
      744   end.
      745   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      747     (input  xobj-type
      748     ,input  xobj-code
      749     ,output v-today
      750     )  .
      751         run rep/chk-ahz.p
      752           (input        xobj-type
      753           ,input        xobj-code
      754           ,input        yes
      755           ,input        yes
      756           ,input        no
      757           ,input        no
      758           ,input        yes
      759           ,input        v-cntxt-db-num
      760           ,input        v-cntxt-userid
      761           ,input-output v-today
      762           ,input-output v-today
      763           ,output       v-archive-ok
      764           ,output       v-comment
      765           ,output       v-can-print
      766           ) .
      767         if v-archive-ok = false
      768         then do:
      769           if v-can-print = true
      770           then do:
      771             define variable v-choice as logical   no-undo .
      772             message
      773               "ВНИМАНИЕ!" skip
      774               v-comment skip
      775               "" skip
      776               "Продолжить формирование отчета ?" skip
      777               view-as alert-box question buttons yes-no update v-choice .
      778             if v-choice = false
      779             then do:
      780               return .
      781             end.
      782           end.
      783           else do:
      784             message
      785               "ВНИМАНИЕ !!!" skip
      786               "Отчет не может быть сформирован!" skip
      787               "На запрошенную дату нет архивов или они сжаты" skip
      788               v-comment skip
      789               view-as alert-box information .
      790             return .
      791           end.
      792         End.
      793         CASE xobj-type:
      794           when 'маг':U then do:
      795             find first buf_shop no-lock where
      796                       buf_shop.obj-code = xobj-code.
      797             assign
      798             v-host-code = buf_shop.host-code
      799             .
      800           end.
      801           when 'скл':U then do:
      802             find first buf_store no-lock where
      803                       buf_store.obj-code = xobj-code.
      804             assign
      805             v-host-code = buf_store.host-code
      806             .
      807           end.
      808         END CASE.
      809         find first buf_sysconf no-lock where
      810                buf_sysconf.host-code = v-host-code.
      811         find first buf_currency no-lock where
      812                    buf_currency.curr-code = buf_sysconf.base-code .
      813         run rep/r-o-good.p   (input xobj-code ,
      814                           input xobj-type ,
      815                           input buf_currency.curr-abbr,
      816                           input buf_sysconf.base-code  ,
      817                           input 'все':U ,
      818                           input tog-inv,
      819                           input "no-classify":U,
      820                           input "sort-article":U ,
      821                           input  "" ).
      822   END.
      823   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   on help of frame Dialog-Frame
      825   do:
      826     run gbl/app_help.p
      827       (input this-procedure :file-name
      828       ,input ''
      829       ,input ?
      830       ) no-error.
      831     if error-status :error then do:
      832       message
      833         "Ошибка при вызове помощи"
      834         error-status :get-message(1)
      835         view-as alert-box .
      836     end.
      837   end.
      838   run minbtn-set in this-procedure .
      839   on choose of b-help in frame Dialog-Frame
      840   do:
      841     apply "help":u to frame Dialog-Frame .
      842   end.
      843   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   procedure minbtn-set :
      845       do
      846           on error undo, return error return-value
      847           :
      848           define variable ii              as integer       no-undo .
      849           define variable fh              as widget-handle no-undo .
      850           define variable hh              as widget-handle no-undo .
      851           define variable v-h             as handle        extent 4 no-undo .
      852           define variable v-name-button   as character     no-undo .
      853           define variable v-help-old-x    as decimal       no-undo .
      854           define variable v-help-old-y    as decimal       no-undo .
      855           define variable v-help-old-size as decimal       no-undo .
      856           define variable v-frame-width   as decimal       no-undo .
      857           define variable jj              as integer       no-undo .
      858           do
      859               on error undo, return error
      860               :
      861               assign
      862                   v-frame-width = frame Dialog-Frame:width - 0.3
      863                   fh            = frame Dialog-Frame:first-child
      864                   hh            = fh:first-child
      865                   ii            = 1
      866                   .
      867               do while valid-handle(hh):
      868                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      869                   do:
      870                       case lc(hh:name) :
      871                           when "b-help" then
      872                               do:
      873                                   hh:load-image-up("cmp/b-help.bmp":u) .
      874                                   hh:load-image-down("cmp/b-help.bmp":u) .
      875                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      876                                   hh:TOOLTIP = "Помощь" .
      877                                   v-help-old-x = hh:column .
      878                                   v-help-old-y = hh:row    .
      879                                   v-help-old-size = hh:width .
      880                                   hh:width-chars = 2.5 .
      881                               end.
      882                           when "b-print" then
      883                               do:
      884                                   hh:load-image("cmp/b-print.bmp":u) .
      885                                   hh:TOOLTIP = "Печать" .
      886                                   v-h[ii] = hh:handle .
      887                                   ii = ii + 1 .
      888                                   hh:width-chars = 3 .
      889                               end.
      890                           when "b-history" or
      891                           when "b-hist" then
      892                               do:
      893                                   hh:load-image("cmp/b-hist.bmp":u) .
      894                                   hh:TOOLTIP = "История" .
      895                                   v-h[ii] = hh:handle .
      896                                   ii = ii + 1 .
      897                                   hh:width-chars = 3 .
      898                               end.
      899                           when "b-sch" then
      900                               do:
      901                                   hh:load-image("cmp/b-sch.bmp":u) .
      902                                   hh:TOOLTIP = "Установка Фильтра" .
      903                                   v-h[ii] = hh:handle .
      904                                   ii = ii + 1 .
      905                                   hh:width-chars = 3 .
      906                               end.
      907                           when "b-hist-user" then
      908                               do:
      909                                   hh:load-image("cmp/b-hist.bmp":u) .
      910                                   hh:TOOLTIP = "История пользователя" .
      911                                   ii = ii + 1 .
      912                               end.
      913                       end case.
      914                   end.
      915                   hh = hh:next-sibling.
      916               end.
      917               b-help:column = v-frame-width - b-help:width-chars.
      918               jj = 0.
      919               repeat ii = 4 to 1 by -1 :
      920                   if valid-handle (v-h[ii] ) then
      921                   do:
      922                       jj  = jj + 1 .
      923                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      924                       v-h[ii]:row    = v-help-old-y .
      925                   end.
      926               end.
      927           end.
      928       end.
      929   end procedure.
      930   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      932     (input  v-cntxt-obj-type
      933     ,input  v-cntxt-obj-code
      934     ,output v-today
      935     )  .
      936   if xstart-date = ? or xend-date = ? then do:
      937     assign
      938         date-1 = v-today - 7
      939         date-2 = v-today
      940     .
      941   end.
      942   else do:
      943     assign
      944       date-1 = xstart-date
      945       date-2 = xend-date
      946       .
      947   end.
      948   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   on ' ' of date-1 in frame Dialog-Frame
      950   do:
      951     if (can-query (self, "sensitive")
      952        and
      953        self :sensitive = true
      954        )
      955     or (can-query (self, "read-only")
      956        and
      957        self :read-only = false
      958        )
      959     then do:
      960       assign
      961         self :screen-value = ?
      962       .
      963     end.
      964     return no-apply.
      965   end.
      966   on delete-character of date-1 in frame Dialog-Frame
      967   do:
      968     if (can-query (self, "sensitive")
      969        and
      970        self :sensitive = true
      971        )
      972     or (can-query (self, "read-only")
      973        and
      974        self :read-only = false
      975        )
      976     then do:
      977       assign
      978         self :screen-value = ?
      979       .
      980     end.
      981     return no-apply.
      982   end.
      983   on ctrl-d of date-1 in frame Dialog-Frame
      984   do:
      985     define variable v-curr-sv-date as date no-undo .
      986     if (can-query (self, "sensitive")
      987        and
      988        self :sensitive = true
      989        )
      990     or (can-query (self, "read-only")
      991        and
      992        self :read-only = false
      993        )
      994     then do:
      995       if self :handle <> focus :handle
      996       then do:
      997         apply "entry":u to self .
      998       end.
      999       run gbl/getcurdt.p
     1000         (output v-curr-sv-date
     1001         ) .
     1002       assign
     1003         self :screen-value = string(v-curr-sv-date) .
     1004       .
     1005     end.
     1006     return no-apply.
     1007   end.
     1008   on ctrl-b of date-1 in frame Dialog-Frame
     1009   do:
     1010     if (can-query (self, "sensitive")
     1011        and
     1012        self :sensitive = true
     1013        )
     1014     or (can-query (self, "read-only")
     1015        and
     1016        self :read-only = false
     1017        )
     1018     then do:
     1019       if self :handle <> focus :handle
     1020       then do:
     1021         apply "entry":u to self .
     1022       end.
     1023       define variable v-curr-sv-date as date no-undo .
     1024       define variable v-new-sv-date  as date no-undo .
     1025       assign
     1026         v-curr-sv-date = date(self :screen-value) no-error
     1027       .
     1028       if v-curr-sv-date = ?
     1029       then do:
     1030         run gbl/getcurdt.p
     1031           (output v-curr-sv-date
     1032           ) .
     1033       end.
     1034       if v-curr-sv-date <> ?
