      886   PROCEDURE adm-disable-fields :
      887         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      888       RETURN.
      889   END PROCEDURE.
      890   PROCEDURE adm-enable-fields :
      891       RETURN.
      892   END PROCEDURE.
      893   PROCEDURE adm-end-update :
      894     RETURN.
