      859     END PROCEDURE.
      860   PROCEDURE adm-assign-statement :
      861     RETURN.
      862   END PROCEDURE.
      863   PROCEDURE adm-cancel-record :
      864      RETURN.
      865     END PROCEDURE.
      866   PROCEDURE adm-copy-record :
      867       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      868        "must have at least one Enabled Table to perform Copy.":U
      869          VIEW-AS ALERT-BOX ERROR.
      870       RETURN.
      871   END PROCEDURE.
      872   PROCEDURE adm-create-record :
      873      RETURN.
      874   END PROCEDURE.
      875   PROCEDURE adm-current-changed :
      876     RETURN.
      877   END PROCEDURE.
      878   PROCEDURE adm-delete-record :
      879    MESSAGE
      880          "Object ":U THIS-PROCEDURE:FILE-NAME
      881            "must have at least one Enabled Table to perform Delete.":U
      882              VIEW-AS ALERT-BOX ERROR.
      883       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      884       RETURN.
