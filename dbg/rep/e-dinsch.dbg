      899   PROCEDURE adm-update-record :
      900       MESSAGE
      901         "Object ":U THIS-PROCEDURE:FILE-NAME
      902           "must have at least one Enabled Table to perform Update.":U
      903             VIEW-AS ALERT-BOX ERROR.
      904      RETURN.
      905   END PROCEDURE.
      906   PROCEDURE check-modified :
      907   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      908   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      909   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      910   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      911     IF check-state = "check":U THEN
      912     DO:
      913       RUN get-link-handle IN adm-broker-hdl
      914         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      915            OUTPUT group-target-list).
      916       IF group-target-list NE "":U THEN
      917       DO i = 1 TO NUM-ENTRIES(group-target-list):
      918         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      919         RUN check-modified IN curr-widget ('group-check':U).
      920         IF RETURN-VALUE NE "":U THEN
      921         DO:
      922           RUN check-modified-message(RETURN-VALUE).
      923           RETURN "":U.
      924         END.
      925       END.
      926     END.
      927     RETURN "":U.
      928   END PROCEDURE.
      929   PROCEDURE check-modified-message :
      930     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      931        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      932           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      933        IF RETURN-VALUE = "YES":U THEN
      934           RUN notify ('view,CONTAINER-SOURCE':U).
      935        MESSAGE IF p-changed-table NE ? THEN
      936           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      937           ELSE "Current values have been changed."
      938           SKIP "  Do you wish to save those changes?"
      939           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      940        IF ANS THEN
      941        DO:
      942           IF group-assign-target THEN
      943             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      944           ELSE RUN dispatch('update-record':U).
      945           IF RETURN-VALUE = "ADM-ERROR":U THEN
      946           DO:
      947               MESSAGE "Changes to the previous record were not saved."
      948                 VIEW-AS ALERT-BOX ERROR.
      949               IF group-assign-target THEN
      950                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      951               ELSE RUN dispatch ('cancel-record':U).
      952           END.
      953        END.
      954        ELSE DO:
      955          IF group-assign-target THEN
      956             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      957          ELSE RUN dispatch('cancel-record':U).
      958        END.
      959        RETURN.
      960   END PROCEDURE.
      961   PROCEDURE get-rowid :
      962       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      963       ASSIGN
      964       p-table   =   adm-first-table.
      965       RETURN.
      966   END PROCEDURE.
      967   PROCEDURE init-group-assign :
      968       RUN request-attribute IN adm-broker-hdl
      969         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      970       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      971         group-assign-target = yes.
      972       ELSE group-assign-target = no.
      973       RETURN.
      974   END PROCEDURE.
      975   PROCEDURE set-editors :
      976       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      977       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      978       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      979       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      980       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      981       DO WHILE VALID-HANDLE (curr-widget):
      982           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      983              curr-widget:HIDDEN = no THEN DO:
      984             CASE p-field-setting:
      985               WHEN "INITIALIZE":U THEN
      986               DO:
      987                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      988                     read-only-list +
      989                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      990                        STRING(curr-widget).
      991               END.
      992               WHEN "DISABLE":U OR
      993               WHEN "ENABLE":U THEN
      994               DO:
      995                   curr-widget:SENSITIVE = yes.
      996                   RUN get-attribute ('Read-Only-Editors':U).
      997                   IF RETURN-VALUE = ? OR
      998                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      999                       curr-widget:READ-ONLY =
     1000                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1001               END.
     1002               WHEN "CLEAR":U THEN
     1003                   curr-widget:SCREEN-VALUE = "":U.
     1004             END CASE.
     1005           END.
     1006           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1007       END.
     1008       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1009         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1010           + '"':U).
     1011       RETURN.
     1012   END PROCEDURE.
     1013   PROCEDURE use-check-modified-all :
     1014    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1015     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1016     RETURN.
     1017   END PROCEDURE.
     1018   PROCEDURE use-create-on-add :
     1019   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1020      RETURN.
     1021   END PROCEDURE.
     1022   PROCEDURE use-initial-lock :
     1023     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1024     ASSIGN adm-initial-lock = p-attr-value.
     1025     RETURN.
     1026   END PROCEDURE.
     1027     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1028   ASSIGN
     1029          FRAME F-Main:SCROLLABLE       = FALSE
     1030          FRAME F-Main:HIDDEN           = TRUE.
     1031   if not this-procedure :persistent
     1032   then do:
     1033     message
     1034       vss-workfile vss-revision vss-description skip
     1035       "Ошибка при запуске процедуры" skip
     1036       "Данную процедуру следует запускать только с параметром persistent" skip
     1037       view-as alert-box error .
     1038     undo, return error .
     1039   end.
     1040     assign sort-1:screen-value = "Дата документа" .
     1041     display sort-1  with frame F-Main .
     1042   PROCEDURE disable_UI :
     1043     HIDE FRAME F-Main.
     1044     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1045   END PROCEDURE.
     1046   PROCEDURE local-apply-layout :
     1047     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1048   END PROCEDURE.
     1049   PROCEDURE my-report :
     1050     define variable code-schet as integer   no-undo .
     1051     assign  code-schet = int(fin-schet-recid) .
     1052     if code-schet = 0 then do:
     1053       message "Не выбран счет!" view-as alert-box error .
     1054       return no-apply .
     1055     end.
     1056     define variable num-key as integer initial 1  no-undo .
     1057     define variable str as character no-undo .
     1058     case sort-1 :
     1059       when "Дата документа"            then assign str = "buf_fin-doc.doc-date"      .
     1060       when "Корреспондирующий счет"    then assign str = "buf_fin-doc.cor-acc"  .
     1061       when "Шифр аналитического учета" then assign str = "buf_fin-doc.an-uchet-code" .
     1062       when "Шифр целевого назначения"  then assign str = "buf_fin-doc.cel-nazn-code" .
     1063     end.
     1064     if sort-2 = sort-1 then assign sort-2 = "" .
     1065     case sort-2 :
     1066       when "Дата документа"            then assign str = str + ",buf_fin-doc.doc-date"      num-key = num-key + 1 .
     1067       when "Корреспондирующий счет"    then assign str = str + ",buf_fin-doc.cor-acc"       num-key = num-key + 1 .
     1068       when "Шифр аналитического учета" then assign str = str + ",buf_fin-doc.an-uchet-code" num-key = num-key + 1 .
     1069       when "Шифр целевого назначения"  then assign str = str + ",buf_fin-doc.cel-nazn-code" num-key = num-key + 1 .
     1070     end.
     1071     if sort-3 = sort-2 then assign sort-3 = "" .
     1072     else  if sort-3 = sort-1 then assign sort-3 = "" .
     1073     case sort-3 :
     1074       when "Дата документа"            then assign str = str + ",buf_fin-doc.doc-date"      num-key = num-key + 1 .
     1075       when "Корреспондирующий счет"    then assign str = str + ",buf_fin-doc.cor-acc"       num-key = num-key + 1 .
     1076       when "Шифр аналитического учета" then assign str = str + ",buf_fin-doc.an-uchet-code" num-key = num-key + 1 .
     1077       when "Шифр целевого назначения"  then assign str = str + ",buf_fin-doc.cel-nazn-code" num-key = num-key + 1 .
     1078     end.
     1079     if sort-4 = sort-1 then assign sort-4 = "" .
     1080     else do:
     1081       if sort-4 = sort-2 then assign sort-4 = "" .
     1082       else  if sort-4 = sort-3 then assign sort-4 = "" .
     1083     end.
     1084     case sort-4 :
     1085       when "Дата документа"            then assign str = str + ",buf_fin-doc.doc-date"      num-key = num-key + 1 .
     1086       when "Корреспондирующий счет"    then assign str = str + ",buf_fin-doc.cor-acc"       num-key = num-key + 1 .
     1087       when "Шифр аналитического учета" then assign str = str + ",buf_fin-doc.an-uchet-code" num-key = num-key + 1 .
     1088       when "Шифр целевого назначения"  then assign str = str + ",buf_fin-doc.cel-nazn-code" num-key = num-key + 1 .
     1089     end.
     1090     run rep/r-dinsch.p ( input parParentProc, input v-cntxt-host-code-obj, input code-schet, input num-key, input str, input x-Date-Start, input x-Date-End) .
     1091   END PROCEDURE.
     1092   PROCEDURE my-var :
     1093    assign frame F-Main sort-1 sort-2 sort-3 sort-4 .
     1094   END PROCEDURE.
     1095   procedure get-var-from-1-report-page :
     1096    do
     1097    on error undo, return error return-value
     1098    :
     1099   define output parameter p-customer as integer no-undo .
     1100   define output parameter p-schet    as integer no-undo .
     1101   define output parameter p-curr-code as integer no-undo .
     1102   define output parameter p-period    as character no-undo .
     1103   define output parameter p-keep-spis  as character no-undo .
     1104   define variable v-res as character no-undo .
     1105     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1106     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1107       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1108       State-source = WIDGET-HANDLE ( source-str ).
     1109       IF not VALID-HANDLE ( State-source ) THEN
     1110         Message "Не определен линк " 'State':U view-as alert-box error.
     1111     END.
     1112    run get-attribute in state-source  ( 'KEEP-SPIS':U ).
     1113     v-res = return-value .
     1114     if v-res = ? or v-res = "" then p-keep-spis = ? .
     1115                                else p-keep-spis = return-value .
     1116    run get-attribute in state-source  ( 'RADIO-PERIOD':U ).
     1117     v-res = return-value .
     1118     if v-res = ? or v-res = "" then p-period = ? .
     1119                                else p-period = return-value .
     1120    run get-attribute in state-source  ( 'RADIO-CUSTOMER':U ).
     1121     v-res = return-value .
     1122     if v-res = ? or v-res = "" then p-customer = ? .
     1123                                else p-customer = integer (return-value) .
     1124    run get-attribute in state-source  ( 'RADIO-SCHET':U ).
     1125     v-res = return-value .
     1126     if v-res = ? or v-res = "" then p-schet = ? .
     1127                                else p-schet = integer (return-value) .
     1128    run get-attribute in state-source  ( 'EX-CURR-CODE':U ).
     1129     v-res = return-value .
     1130     if v-res = ? or v-res = "" then p-curr-code = ? .
     1131                                else p-curr-code = integer (return-value) .
     1132    end.
     1133   end procedure.
     1134   PROCEDURE state-changed :
     1135     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1136     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1137     CASE p-state:
     1138       when "link-changed":U then  DO:
     1139            Run my-var.
     1140            End.
     1141     END CASE.
     1142   END PROCEDURE.
