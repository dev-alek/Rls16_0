      644        SIZE 27.63 BY 1 NO-UNDO.
      645   DEFINE VARIABLE sort-2 AS CHARACTER FORMAT "X(256)":U
      646        LABEL "Уровень 2"
      647        VIEW-AS COMBO-BOX INNER-LINES 5
      648        LIST-ITEMS "","Дата документа","Корреспондирующий счет","Шифр аналитического учета","Шифр целевого назначения"
      649        DROP-DOWN-LIST
      650        SIZE 27.63 BY 1 NO-UNDO.
      651   DEFINE VARIABLE sort-3 AS CHARACTER FORMAT "X(256)":U
      652        LABEL "Уровень 3"
      653        VIEW-AS COMBO-BOX INNER-LINES 5
      654        LIST-ITEMS "","Дата документа","Корреспондирующий счет","Шифр аналитического учета","Шифр целевого назначения"
      655        DROP-DOWN-LIST
