      663   DEFINE RECTANGLE RECT-6
      664        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      665        SIZE 41.5 BY 8.
      666   DEFINE FRAME F-Main
      667        sort-1 AT ROW 3 COL 12.5 COLON-ALIGNED
      668        sort-2 AT ROW 4.5 COL 12.5 COLON-ALIGNED
      669        sort-3 AT ROW 6 COL 12.5 COLON-ALIGNED
      670        sort-4 AT ROW 7.5 COL 12.5 COLON-ALIGNED
      671        "Сортировка:" VIEW-AS TEXT
      672             SIZE 13.25 BY 1 AT ROW 1.63 COL 4.13
      673             FGCOLOR 4
      674        RECT-6 AT ROW 1.25 COL 2.25
      675       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      676            SIDE-LABELS NO-UNDERLINE THREE-D
      677            AT COL 1 ROW 1 SCROLLABLE .
      678   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      679   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      680   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      681   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      682   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      683   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      684   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      685   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      686         adm-object-hdl = FRAME F-Main:HANDLE.
      687   RUN ensure-broker.
      688   THIS-PROCEDURE:ADM-DATA =
      689        'ADM1.1~`':U +
      690        'SmartObject~`':U +
      691        '~`':U +
      692        'NO ~`':U +
      693        '~`':U +
      694        '~`':U +
      695        '~`':U +
      696        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      697           + "~`":U +
      698        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      699        'Record-Source,Record-Target,TableIO-Target~`':U +
      700        '~`':U +
      701        '~`~`~`~`~`~`~`~`~`~`~`':U +
      702        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      703            THEN "^^":U
      704        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      705             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      706   PROCEDURE adm-apply-entry :
      707     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      708   END PROCEDURE.
      709   PROCEDURE adm-destroy :
      710    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      711   END PROCEDURE.
      712   PROCEDURE adm-disable :
      713       DISABLE RECT-6 sort-1 sort-2 sort-3 sort-4 WITH FRAME F-Main.
      714       RUN dispatch ('disable-fields':U).
      715       RUN set-attribute-list ('ENABLED=no':U).
      716       RETURN.
      717   END PROCEDURE.
      718   PROCEDURE adm-edit-attribute-list :
      719         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      720         RETURN.
      721   END PROCEDURE.
      722   PROCEDURE adm-enable :
      723       ENABLE UNLESS-HIDDEN RECT-6 sort-1 sort-2 sort-3 sort-4 WITH FRAME F-Main.
      724       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      725       RUN set-attribute-list ('ENABLED=yes':U).
      726       RETURN.
      727   END PROCEDURE.
      728   PROCEDURE adm-exit :
      729        RUN notify ('exit':U).
      730     RETURN.
      731   END PROCEDURE.
      732   PROCEDURE adm-hide :
      733     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      734   END PROCEDURE.
      735   PROCEDURE adm-initialize :
      736     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      737   END PROCEDURE.
      738   PROCEDURE adm-show-errors :
      739       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      740       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      741           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      742       END.
      743       RETURN.
      744   END PROCEDURE.
      745   PROCEDURE adm-UIB-mode :
      746     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      747   END PROCEDURE.
      748   PROCEDURE adm-view :
      749     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      750   END PROCEDURE.
      751   PROCEDURE dispatch :
      752       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      753       RUN broker-dispatch IN adm-broker-hdl
      754           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      755       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      756   END PROCEDURE.
      757   PROCEDURE ensure-broker :
      758   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      759   IF RETURN-VALUE NE "ADM-Broker":U THEN
      760   DO:
      761       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      762       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      763   END.
      764   END PROCEDURE.
      765   PROCEDURE get-attribute :
      766     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      767     RUN broker-get-attribute IN adm-broker-hdl
      768         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      769     RETURN RETURN-VALUE.
      770   END PROCEDURE.
      771   PROCEDURE get-attribute-list :
      772     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      773     RUN broker-get-attribute-list IN adm-broker-hdl
      774         (INPUT THIS-PROCEDURE,
      775          INPUT ?,
      776          OUTPUT p-attr-list) NO-ERROR.
      777     RETURN.
      778   END PROCEDURE.
      779   PROCEDURE new-state :
      780     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      781     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      782     RETURN.
      783   END PROCEDURE.
      784   PROCEDURE notify :
      785     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      786     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      787     IF RETURN-VALUE = "ADM-ERROR":U THEN
      788         RETURN "ADM-ERROR":U.
      789     RETURN.
      790   END PROCEDURE.
      791   PROCEDURE set-attribute-list :
      792     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      793     RUN ensure-broker.
      794     RUN broker-set-attribute-list IN adm-broker-hdl
      795         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      796     RETURN.
      797   END PROCEDURE.
      798   PROCEDURE set-position :
      799       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      800       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      801       IF VALID-HANDLE(adm-object-hdl) THEN
      802       DO:
      803         ASSIGN adm-object-hdl:ROW    =   p-row
      804                adm-object-hdl:COLUMN =   p-col.
      805       END.
      806       RETURN.
      807   END PROCEDURE.
      808   PROCEDURE adm-display-fields :
      809       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      810       RETURN.
      811   END PROCEDURE.
      812   PROCEDURE adm-open-query :
      813     RETURN.
      814   END PROCEDURE.
      815   PROCEDURE adm-row-changed :
      816         IF VALID-HANDLE(adm-object-hdl) THEN
      817           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      818         RUN notify ('row-available':U).
      819         RETURN.
      820   END PROCEDURE.
      821   PROCEDURE reposition-query :
      822       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      823       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      824       RETURN.
      825   END PROCEDURE.
      826     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      827     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      828     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      829     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      830     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      831     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      832     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      833     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      834     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      835     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      836     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      837     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      838     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      839     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      840     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      841     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      842     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      843     IF "":U = "":U THEN
      844       RUN modify-list-attribute IN adm-broker-hdl
      845         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      846     RUN use-create-on-add(?).
      847   PROCEDURE adm-add-record :
      848       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      849          "must have at least one Enabled Table to perform Add.":U
