      599   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600     define variable v-cntxt-db-num        as integer   no-undo .
      601     define variable v-cntxt-userid        as character no-undo .
      602     define variable v-cntxt-level         as character no-undo .
      603     define variable v-cntxt-host-code-obj as integer   no-undo .
      604     define variable v-cntxt-obj-type      as character no-undo .
      605     define variable v-cntxt-obj-code      as integer   no-undo .
      606     define variable v-cntxt-db-num-obj    as integer   no-undo .
      607     define variable v-cntxt-is-admin      as logical   no-undo .
      608   procedure create-param-to-export :
      609    do
      610    on error undo, return error return-value
      611    :
      612    define input parameter p1 as character no-undo .
      613    define input parameter p2 as character no-undo .
      614    define input parameter p3 as character no-undo .
      615    define input parameter p4 as character no-undo .
      616    define input parameter p5 as character no-undo .
      617     create  param-to-export.
      618     assign
      619        param-to-export.param-code     =  p1
      620        param-to-export.param-sub-code =  p2
      621        param-to-export.param-type     =  p3
      622        param-to-export.param-value    =  p4
      623        param-to-export.param-comment  =  p5
      624     .
      625    end.
      626   end procedure.
      627   define variable exp-name as character no-undo .
      628   define  stream str-export.
      629     run gbl/_tmpfile.p ( "t", ".par", output exp-name) .
      630   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631     run mainmenu_getcntxt in parparentproc
      632       (output v-cntxt-db-num
      633       ,output v-cntxt-userid
      634       ,output v-cntxt-level
      635       ,output v-cntxt-host-code-obj
      636       ,output v-cntxt-obj-type
      637       ,output v-cntxt-obj-code
      638       ,output v-cntxt-db-num-obj
      639       ,output v-cntxt-is-admin
      640       ) .
      641    for each  param-to-export : delete  param-to-export. end.
      642   define variable cconnect as character no-undo .
      643   define variable user-name as character no-undo .
      644   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      646     (input  v-cntxt-userid
      647     ,output user-name
      648     )  .
      649    get-key-value section "rep-sets" key "conpar" value cconnect .
      650   define variable v-base-key as character no-undo .
      651   run gbl/base-key.p
      652      (output v-base-key
      653     ) .
      654     run create-param-to-export  in this-procedure
      655     ( input 'base-key'  ,
      656      input ''  ,
      657      input 'character'  ,
      658      input v-base-key  ,
      659      input 'ключ' )
      660    .
