      739    .
      740   define variable v-base-code like ub.sysconf.base-code no-undo .
      741   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      742   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      743     (input  v-cntxt-host-code-obj
      744     ,output v-base-code
      745     )  .
      746   define buffer buf_currency for ub.currency.
      747   find first buf_currency no-lock where
      748             buf_currency.curr-code = v-base-code.
      749     run create-param-to-export  in this-procedure
      750     ( input 'base-type'  ,
      751      input ''  ,
      752      input 'character'  ,
      753      input string(buf_currency.curr-abbr)  ,
      754      input 'тип базовой валюты' )
      755    .
      756     run create-param-to-export  in this-procedure
      757     ( input 'base-code'  ,
      758      input ''  ,
      759      input 'integer'  ,
      760      input string(v-base-code)  ,
      761      input 'код базовой валюты' )
      762    .
      763   if Show-Crsa or Show-Cost or Show-Sale then do:
      764     run create-param-to-export  in this-procedure
      765     ( input 'crsa'  ,
      766      input ''  ,
      767      input 'logical'  ,
      768      input string(show-Crsa,'yes/no')  ,
      769      input '  продажные цены' )
      770    .
      771     run create-param-to-export  in this-procedure
      772     ( input 'cost'  ,
      773      input ''  ,
      774      input 'logical'  ,
      775      input string(show-cost,'yes/no')  ,
      776      input '  учетные цены' )
      777    .
      778     run create-param-to-export  in this-procedure
      779     ( input 'sale'  ,
      780      input ''  ,
      781      input 'logical'  ,
      782      input string(show-sale,'yes/no')  ,
      783      input '  цены документа' )
      784    .
      785   end.
      786   else do:
      787     run create-param-to-export  in this-procedure
      788     ( input 'set-pay-type'  ,
      789      input ''  ,
      790      input 'integer'  ,
      791      input string(x-set_pay_type)  ,
      792      input 'тип цены Продажные цены=1 Учетные цены=2 Цены документа=3 ' )
      793    .
      794   end.
      795     run create-param-to-export  in this-procedure
      796     ( input 'rubl-val'  ,
      797      input ''  ,
      798      input 'integer'  ,
      799      input string(x-SET_val_TYPE)  ,
      800      input 'печатать в рублях или валюте руб=1  вал=2  обе=3 ' )
      801    .
      802     run create-param-to-export  in this-procedure
      803     ( input 'reportname'  ,
      804      input ''  ,
      805      input 'character'  ,
      806      input reportname  ,
      807      input 'название отчета' )
      808    .
      809     run create-param-to-export  in this-procedure
      810     ( input 'select-good'  ,
      811      input ''  ,
      812      input 'integer'  ,
      813      input string(x-selectgood)  ,
      814      input 'тип выбора товара all=1 grp=2 prod=3 choice=4 one=5 grp-prod=6' )
      815    .
      816    define variable ii as integer no-undo .
      817    define variable ii-name as character no-undo .
      818    define variable ii-1 as integer no-undo .
      819    define variable ii-name-1 as character no-undo .
      820     define variable ii-2 as integer no-undo .
      821    define variable ii-name-2 as character no-undo .
      822    define variable ii-3 as integer no-undo .
      823    define variable ii-name-3 as character no-undo .
      824    if x-selectgood = 1     Or
      825       x-selectgood = 2     Or
      826       x-selectgood = 3    Or
      827       x-selectgood = 4  then do:
      828    ii = 0.
      829         for each gds-list :
      830           ii = ii + 1 .
      831           if ii = 1 then ii-name = "список товаров - содержит gds-code  (уникальный ключ товара)" .
      832                     else ii-name = "" .
      833     run create-param-to-export  in this-procedure
      834     ( input 'gds-list'  ,
      835      input string(ii)  ,
      836      input 'integer'  ,
      837      input string(gds-list.gds-code)  ,
      838      input ii-name )
      839    .
      840         end.
      841    end.
      842    if x-selectgood = 2 then do:
      843    ii-2 = 0.
      844         for each tmp#grp :
      845           ii-2 = ii-2 + 1 .
      846           if ii-2 = 1 then ii-name-2 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка групп)" .
      847                     else ii-name-2 = "" .
      848     run create-param-to-export  in this-procedure
      849     ( input 'tmp#grp'  ,
      850      input string(ii-2)  ,
      851      input 'integer character '  ,
      852      input string(tmp#grp.node-code) + '#' +  (tmp#grp.grp-name)  ,
      853      input ii-name-2 )
      854    .
      855         end.
      856    end.
      857    if x-selectgood = 3 then do:
      858    ii-3 = 0.
      859         for each g#cli :
      860           ii-3 = ii-3 + 1 .
      861           if ii-3 = 1 then ii-name-3 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка производителе)" .
      862                       else ii-name-3 = "" .
      863     run create-param-to-export  in this-procedure
      864     ( input 'g#cli'  ,
      865      input string(ii-3)  ,
      866      input 'character integer'  ,
      867      input g#cli.obj-type + '#' + string(g#cli.obj-code)  ,
      868      input ii-name-3 )
      869    .
      870         end.
      871    end.
      872     run create-param-to-export  in this-procedure
      873     ( input 'select-object'  ,
      874      input ''  ,
      875      input 'character'  ,
      876      input x-selectobject  ,
      877      input 'тип выбора объекта   -currency -choice -firm -все' )
      878    .
      879    ii-1 = 0.
      880     for each obj-list :
      881       ii-1 = ii-1 + 1 .
      882       if ii-1 = 1 then ii-name-1 = "список объектов - содержит <obj-type#obj-code>  (уникальный ключ clients)" .
      883                 else ii-name-1 = "" .
      884     run create-param-to-export  in this-procedure
      885     ( input 'obj-list'  ,
      886      input string(ii-1)  ,
      887      input 'character integer'  ,
      888      input obj-list.obj-type + '#' + string (obj-list.obj-code)  ,
      889      input ii-name-1 )
      890    .
      891     end.
      892     run create-param-to-export  in this-procedure
      893     ( input 'report-type'  ,
      894      input ''  ,
      895      input 'character'  ,
      896      input 'a'  ,
      897      input 'тип отчета a= вызов из режима заказные программы' )
      898    .
      899   for each  param-to-export :
      900       if  lookup( param-to-export.param-code , "base-key,firm-name,report-type,v-cntxt-obj-code,v-cntxt-obj-type,db-connect" ) = 0 then   delete  param-to-export.
      901    end.
      902     OUTPUT STREAM str-export TO  VALUE(exp-name).
      903         for each param-to-export :
      904           EXPORT STREAM str-export param-to-export .
      905         end.
      906     OUTPUT STREAM str-export CLOSE.
      907   define variable res as integer no-undo .
      908   define variable name-exe as character no-undo .
      909     assign
      910       file-info:file-name = "exe/run-act.bat".
      911       name-exe = file-info:full-pathname
      912     no-error .
      913     if error-status :error then return error .
      914   run gbl/syn.p ( input name-exe , input  exp-name , input  "Запуск " + name-exe , output res ).
      915   if  res > 0 then do:
      916     message  "Ошибка  при выполнении команды в ОС "  res .
      917   end.
