     1380   procedure prn-lib-prn-file :
     1381     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1382     define input parameter p-DIsabledoptions as integer no-undo .
     1383     define variable v-report-name as character no-undo .
     1384     define variable v-user-action as character no-undo .
     1385     define variable v-printed     as logical   no-undo .
     1386     define variable v-exist       as logical   no-undo .
     1387     do
     1388       on error undo, return error
     1389       :
     1390       run prn-lib-get-report-name  in this-procedure (
     1391         input parParentProc
     1392         ,output v-report-name
     1393         ).
     1394   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1395   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1396     (input  v-report-name
     1397     ,input  2
     1398     ,output v-exist
     1399     )  .
     1400       if NOT v-exist then
     1401       DO:
     1402         Message
     1403           "Нет заданий на печать ! "
     1404           view-as alert-box .
     1405         Return  .
     1406       End.
     1407       run gbl/prnfilen.w
     1408         (input  ""
     1409         ,input  p-DisabledOptions
     1410         ,input  string(v-report-name )
     1411         ,input  7
     1412         ,output v-user-action
     1413         ,output v-printed
     1414         ) .
     1415       if v-printed then
     1416       do:
     1417         return "YES" .
     1418       end.
     1419       else
     1420       do:
     1421         return "NO" .
     1422       end.
     1423     end.
     1424   end procedure.
     1425   procedure prn-lib-open-stream :
     1426     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1427     define input parameter p-page-size    as integer no-undo .
     1428     define input parameter p-is-stream    as logical no-undo .
     1429     define input parameter p-append       as logical no-undo .
     1430     define variable v-report-name as character no-undo .
     1431     do
     1432       on error undo, return error
     1433       :
     1434       run prn-lib-get-report-name  in this-procedure (
     1435         input parParentProc
     1436         ,output v-report-name
     1437         ).
     1438       if p-is-stream then
     1439       do:
     1440         if p-append then
     1441         do:
     1442           output stream PrnLibStream to value( v-report-name )
     1443             page-size value(p-page-size) append .
     1444         end.
     1445         if not p-append then
     1446         do:
     1447           output stream PrnLibStream to value( v-report-name )
     1448             page-size value(p-page-size) .
     1449         end.
     1450       end.
     1451       if not p-is-stream then
     1452       do:
     1453         if p-append then
     1454         do:
     1455           output to value( v-report-name )
     1456             page-size value(p-page-size) append .
     1457         end.
     1458         if not p-append then
     1459         do:
     1460           output to value( v-report-name )
     1461             page-size value(p-page-size) .
     1462         end.
     1463       end.
     1464     end.
     1465   end procedure.
     1466   procedure prn-lib-open-exp :
     1467     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1468     define input parameter p-is-stream    as logical no-undo .
     1469     define input parameter p-is-append    as logical no-undo .
     1470     define output parameter p-ReportFileName as char init "report" no-undo.
     1471     define output parameter p-process as logical no-undo .
     1472     define variable glog as logical no-undo .
     1473     do
     1474       on error undo, return error
     1475       :
     1476       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1477         TITLE      "Укажите путь"
     1478         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1479         ASK-OVERWRITE
     1480         CREATE-TEST-FILE
     1481         SAVE-AS
     1482         USE-FILENAME
     1483         DEFAULT-EXTENSION "txt"
     1484         UPDATE glog
     1485         .
     1486       if not glog then  return.
     1487       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1488       if p-is-stream then
     1489       do:
     1490         if p-is-append then
     1491         do:
     1492           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1493         end.
     1494         else
     1495         do:
     1496           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1497         end.
     1498       end.
     1499       else
     1500       do:
     1501         if p-is-append then
     1502         do:
     1503           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1504         end.
     1505         else
     1506         do:
     1507           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1508         end.
     1509       end.
     1510       p-process = yes.
     1511     end.
     1512   end procedure.
     1513   procedure prn-lib-get-report-name :
     1514     define input parameter parParentProc  as widget-handle no-undo.
     1515     define output parameter p-report-name as character no-undo .
     1516     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1517   end procedure.
     1518   procedure prn-lib-reportviewer-report-name :
     1519     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1520     define input parameter p-report-name-html as character no-undo .
     1521     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
