     1577   define variable v-seller-cashier-1 as character no-undo .
     1578   assign
     1579   v-seller-cashier-1 = (if shrs-seller-cashier = "seller"
     1580                         then "Итого прод-ц "
     1581                         else "Итого кассир ").
     1582   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1583   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1584   procedure lhistprex-print-gds-list-hist-excel :
     1585   define input parameter p-text  as logical no-undo .
     1586   define input parameter p-excel as logical no-undo .
     1587   define input parameter p-sheet-num as integer no-undo .
     1588   define buffer buf_lh-sheetf for sheetf.
     1589   define buffer buf_gds-list-hist for gds-list-hist.
     1590     do
     1591     on error undo, return error
     1592     :
     1593       find first buf_gds-list-hist no-lock where buf_gds-list-hist.id = 0 no-error .
     1594       if p-excel then do:
     1595         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1596         FInd first buf_lh-Sheetf where
     1597                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1598         if not avail buf_lh-sheetf then
     1599         create buf_lh-sheetf.
     1600         assign
     1601         buf_lh-Sheetf.Sheet-num = 2
     1602         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1603         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1604         .
     1605         run rep/extitlee.p (input p-sheet-num
     1606                       , input  substitute("История создания списка &1 &2"
     1607                                   ,
     1608   ''
     1609                                   ,(if available buf_gds-list-hist
     1610                                   then buf_gds-list-hist.des
     1611                                   else "БЕЗЫМЯННЫЙ"))
     1612                       ) .
     1613       end.
     1614       if p-text then do:
     1615         Page stream PrnLibStream.
     1616         PUT  STREAM PrnLibStream unformatted
     1617         SPACE(25) substitute("История создания списка &1 &2"
     1618                             , ''
     1619                             ,(if available buf_gds-list-hist
     1620                             then buf_gds-list-hist.des
     1621                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1622         space(25) cur-time-print() skip(1)
     1623         .
     1624         put stream PrnLibStream unformatted
     1625         string("№", "X(9)") chr(32)
     1626         string("Действие", "X(9)") chr(32)
     1627         string("записей", "X(9)") chr(32)
     1628         string(" = итого", "X(12)") chr(32)
     1629         (if page-size(PrnLibStream) > 43
     1630         then string("Множество", "X(" + string(136 - 43) + ")")
     1631         else string("Множество", "X(" + string(198 - 43) + ")")
     1632         )
     1633         skip(0)
     1634         fill('-':U, 9) chr(32)
     1635         fill('-':U, 9) chr(32)
     1636         fill('-':U, 9) chr(32)
     1637         fill('-':U, 12) chr(32)
     1638         (if page-size(PrnLibStream) > 43
     1639         then fill('-':U, 136 - 43)
     1640         else fill('-':U, 198 - 43))
     1641         skip(0)
     1642         .
     1643       end.
     1644       for each buf_gds-list-hist where buf_gds-list-hist.id > 0
     1645       by buf_gds-list-hist.id
     1646       :
     1647         if p-text then do:
     1648           put stream PrnLibStream unformatted
     1649           (if buf_gds-list-hist.line = 0
     1650           then string(buf_gds-list-hist.id, ">>>>>>>>9")
     1651           else fill(chr(32) , 9)
     1652           )  chr(32)
     1653           (if buf_gds-list-hist.item_ <> '':U
     1654           then string(buf_gds-list-hist.hist-mode, "X(8)")
     1655           else fill( chr(32), 8)) chr(32)
     1656           string(buf_gds-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1657           string(buf_gds-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1658           (if page-size(PrnLibStream) > 43
     1659           then string(buf_gds-list-hist.des, "X(" + string(136 - 43) + ")")
     1660           else string(buf_gds-list-hist.des, "X(" + string(198 - 43) + ")"))
     1661           skip.
     1662         end.
     1663         if p-excel then do:
     1664           if Make-Excel then  put   stream ForExcel unformatted
     1665           (if buf_gds-list-hist.line = 0
     1666           then string(buf_gds-list-hist.id, ">>>>>>>>9")
     1667           else '':U)
     1668           CHR(9)
     1669           (if buf_gds-list-hist.item_ <> '':U
     1670           then buf_gds-list-hist.hist-mode
     1671           else '':U)  CHR(9)
     1672           (if buf_gds-list-hist.item_ <> '':U
     1673           then string(buf_gds-list-hist.num-add, "->>>>>>>>9")
     1674           else '':U)  CHR(9)
     1675           (if buf_gds-list-hist.item_ <> '':U
     1676           then string(buf_gds-list-hist.num-recs, ">>>>>>>>9")
     1677           else '':U)  CHR(9)
     1678           buf_gds-list-hist.des
     1679           skip.
     1680         end.
     1681       end.
     1682     end.
     1683   end procedure.
     1684   define temp-table param-to-export no-undo
     1685   field param-code     as character
     1686   field param-sub-code as character
     1687   field param-type     as character
     1688   field param-value    as character
     1689   field param-comment  as character
     1690   index pi is unique primary  param-code     param-sub-code
     1691   .
     1692   procedure create-param-to-export :
     1693    do
     1694    on error undo, return error return-value
     1695    :
     1696    define input parameter p1 as character no-undo .
     1697    define input parameter p2 as character no-undo .
     1698    define input parameter p3 as character no-undo .
     1699    define input parameter p4 as character no-undo .
     1700    define input parameter p5 as character no-undo .
     1701     create  param-to-export.
     1702     assign
     1703        param-to-export.param-code     =  p1
     1704        param-to-export.param-sub-code =  p2
     1705        param-to-export.param-type     =  p3
     1706        param-to-export.param-value    =  p4
     1707        param-to-export.param-comment  =  p5
     1708     .
     1709    end.
     1710   end procedure.
