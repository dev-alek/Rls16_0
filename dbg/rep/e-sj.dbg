     1523   procedure prn-lib-reportviewer :
     1524     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1525     define input parameter p-report-name-html as character no-undo .
     1526     define input parameter p-param        as character no-undo .
     1527     define variable v-excel           as character no-undo init 'TRUE' .
     1528     define variable v-value-character as character no-undo .
     1529     define variable v-value-integer   as character no-undo .
     1530     define variable v-value-date      as date      no-undo .
     1531     define variable v-value-decimal   as decimal   no-undo .
     1532     define variable rep-excel         as logical   no-undo .
     1533     define variable excel-string      as character no-undo .
     1534     define variable v-param-type      as character no-undo .
     1535     define variable v-tth             as handle    no-undo .
     1536     run adm/shattri.p (
     1537       input "get":U
     1538       ,input  ""
     1539       ,input  0
     1540       ,input  'report-glob':U
     1541       ,input  'rep-excel':U
     1542       ,output v-value-character
     1543       ,output v-value-date
     1544       ,output v-value-decimal
     1545       ,output v-value-integer
     1546       ,output rep-excel
     1547       ,output v-param-type
     1548       ,INPUT-OUTPUT table-handle v-tth
     1549       )  .
     1550     if rep-excel then v-excel = "TRUE" .
     1551     else v-excel = "FALSE" .
     1552     if p-param eq ""
     1553     then
     1554        p-param = "EXCEL:" + v-excel.
     1555     else
     1556        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1557     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1558   end procedure.
