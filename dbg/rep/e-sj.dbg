     1851   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1852   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1853   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1854   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1855   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1856   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1857   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1858   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1859       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1860   RUN ensure-broker.
     1861   THIS-PROCEDURE:ADM-DATA =
     1862        'ADM1.1~`':U +
     1863        'SmartObject~`':U +
     1864        'FRAME~`':U +
     1865        'NO ~`':U +
     1866        '~`':U +
     1867        '~`':U +
     1868        '~`':U +
     1869        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1870           + "~`":U +
     1871        'Layout,Hide-on-Init~`':U +
     1872        '~`':U +
     1873        '~`':U +
     1874        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1875        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1876            THEN "^^":U
     1877        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1878             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1879   PROCEDURE adm-apply-entry :
     1880     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1881   END PROCEDURE.
     1882   PROCEDURE adm-destroy :
     1883    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1884   END PROCEDURE.
     1885   PROCEDURE adm-disable :
     1886       DISABLE RECT-5 RECT-7 RECT-6 RECT-4 RECT-3 RECT-detail RS-by BySalers RS-seller-cashier RS-saleman ByPrice RS-cass WITH FRAME F-Main.
     1887       RUN dispatch ('disable-fields':U).
     1888       RUN set-attribute-list ('ENABLED=no':U).
     1889       RETURN.
     1890   END PROCEDURE.
     1891   PROCEDURE adm-edit-attribute-list :
     1892         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1893         RETURN.
     1894   END PROCEDURE.
     1895   PROCEDURE adm-enable :
     1896       ENABLE UNLESS-HIDDEN RECT-5 RECT-7 RECT-6 RECT-4 RECT-3 RECT-detail RS-by BySalers RS-seller-cashier RS-saleman ByPrice RS-cass WITH FRAME F-Main.
     1897       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1898       RUN set-attribute-list ('ENABLED=yes':U).
     1899       RETURN.
     1900   END PROCEDURE.
     1901   PROCEDURE adm-exit :
     1902        RUN notify ('exit':U).
     1903     RETURN.
     1904   END PROCEDURE.
     1905   PROCEDURE adm-hide :
     1906     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1907   END PROCEDURE.
     1908   PROCEDURE adm-initialize :
     1909     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1910   END PROCEDURE.
     1911   PROCEDURE adm-show-errors :
     1912       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1913       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1914           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1915       END.
     1916       RETURN.
     1917   END PROCEDURE.
     1918   PROCEDURE adm-UIB-mode :
     1919     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1920   END PROCEDURE.
     1921   PROCEDURE adm-view :
     1922     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1923   END PROCEDURE.
     1924   PROCEDURE dispatch :
     1925       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1926       RUN broker-dispatch IN adm-broker-hdl
     1927           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1928       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1929   END PROCEDURE.
     1930   PROCEDURE ensure-broker :
     1931   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1932   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1933   DO:
     1934       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1935       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1936   END.
     1937   END PROCEDURE.
     1938   PROCEDURE get-attribute :
     1939     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1940     RUN broker-get-attribute IN adm-broker-hdl
     1941         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1942     RETURN RETURN-VALUE.
     1943   END PROCEDURE.
     1944   PROCEDURE get-attribute-list :
     1945     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1946     RUN broker-get-attribute-list IN adm-broker-hdl
     1947         (INPUT THIS-PROCEDURE,
     1948          INPUT ?,
     1949          OUTPUT p-attr-list) NO-ERROR.
     1950     RETURN.
     1951   END PROCEDURE.
     1952   PROCEDURE new-state :
     1953     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1954     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1955     RETURN.
     1956   END PROCEDURE.
     1957   PROCEDURE notify :
     1958     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1959     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1960     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1961         RETURN "ADM-ERROR":U.
     1962     RETURN.
     1963   END PROCEDURE.
     1964   PROCEDURE set-attribute-list :
     1965     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1966     RUN ensure-broker.
     1967     RUN broker-set-attribute-list IN adm-broker-hdl
     1968         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1969     RETURN.
     1970   END PROCEDURE.
     1971   PROCEDURE set-position :
     1972       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1973       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1974       IF VALID-HANDLE(adm-object-hdl) THEN
     1975       DO:
     1976           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1977           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1978           DO:
     1979             IF p-row = 0 THEN p-row =
     1980               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1981             IF p-col = 0 THEN p-col =
     1982               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1983           END.
     1984           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1985           DO:
     1986             parent-hdl = adm-object-hdl:PARENT.
     1987             IF p-row = 0 THEN p-row =
     1988               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1989                 parent-hdl:ROW.
     1990             IF p-col = 0 THEN p-col =
     1991               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1992                 parent-hdl:COL.
     1993           END.
     1994           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1995           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1996         ASSIGN adm-object-hdl:ROW    =   p-row
     1997                adm-object-hdl:COLUMN =   p-col.
     1998       END.
     1999       RETURN.
     2000   END PROCEDURE.
     2001   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     2002       STRING(adm-object-hdl)).
     2003   PAUSE 0 BEFORE-HIDE.
     2004   PROCEDURE adm-change-page :
     2005     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     2006     END PROCEDURE.
     2007   PROCEDURE delete-page :
     2008     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     2009     RUN broker-delete-page IN adm-broker-hdl
     2010         (INPUT THIS-PROCEDURE, INPUT p-page#).
     2011     END PROCEDURE.
     2012   PROCEDURE init-object :
     2013     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     2014     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     2015     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     2016     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     2017     RUN broker-init-object IN adm-broker-hdl
     2018         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     2019          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     2020     RETURN.
     2021   END PROCEDURE.
     2022   PROCEDURE init-pages :
     2023     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     2024     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2025         INPUT p-page-list) NO-ERROR.
