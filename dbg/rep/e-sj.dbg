     1353   FUNCTION get-grp-name returns character( input p-grp-code-alpha as integer):
     1354   define buffer buf_sj-grp for sj-grp.
     1355     find first buf_sj-grp no-lock where
     1356               buf_sj-grp.grp-code-alpha = p-grp-code-alpha no-error.
     1357     if available buf_sj-grp then do:
     1358       return buf_sj-grp.grp-name .
     1359     end.
     1360     return "!!!Неизвестное имя группы!!!".
     1361   END FUNCTION.
