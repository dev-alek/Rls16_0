     3058   PROCEDURE state-changed :
     3059     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     3060     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3061     CASE p-state:
     3062       WHEN "link-changed" then do:
     3063           run ini-from-selobj in this-procedure .
     3064       end.
     3065     END CASE.
     3066   END PROCEDURE.
