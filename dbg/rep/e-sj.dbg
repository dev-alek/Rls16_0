     1030   define variable mWaitFramTextEnd            as character   no-undo.
     1031   define variable mWaitFramView               as logical     no-undo.
     1032   define variable mWaitProcEvent              as logical     no-undo init yes.
     1033   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1034   define variable mWaitFramStop               as logical     no-undo.
     1035   define variable mWaitFramStopUser           as logical     no-undo.
     1036   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1037   define variable mWaitFramStartProc          as datetime-tz no-undo.
