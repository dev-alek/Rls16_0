     2037   ASSIGN
     2038          Cas-Num:HIDDEN IN FRAME F-Main           = TRUE.
     2039   ASSIGN
     2040          T-twounit:HIDDEN IN FRAME F-Main           = TRUE.
     2041   ON VALUE-CHANGED OF RS-by IN FRAME F-Main
     2042   DO:
     2043       if lookup( Rs-by:screen-value,
     2044                       "3,1" ) > 0 then
     2045       enable RS-sort with frame F-Main.
     2046       else disable RS-Sort with frame F-Main.
     2047       if lookup( Rs-By:screen-value, "1,0" ) > 0 then do:
     2048           assign
     2049           Tot_Groups = FALSE
     2050           Tot_Producers = FALSE
     2051           ONly_tot = FALSE .
     2052           display Tot_Groups Tot_Producers ONly_tot WITH frame F-Main.
     2053           disable Tot_Groups Tot_Producers ONly_tot WITH frame F-Main.
     2054      end.
     2055      else
     2056      enable Tot_Groups Tot_Producers ONly_tot WITH frame F-Main.
     2057   END.
     2058   ON VALUE-CHANGED OF RS-cass IN FRAME F-Main
     2059   DO:
     2060   assign RS-Cass.
     2061   if RS-cass = "all":U then do:
     2062       assign cas-num = 0.
     2063       display cas-num with frame F-Main.
     2064       disable cas-num with frame F-Main.
     2065       HIDE cas-num in frame F-Main.
     2066   end.
     2067   else do:
     2068      enable cas-num with frame F-Main.
     2069      display cas-num with frame F-Main.
     2070      apply "entry" to Cas-Num in frame F-Main.
     2071   end.
     2072   END.
     2073   ON VALUE-CHANGED OF RS-saleman IN FRAME F-Main
     2074   DO:
     2075   define variable v-seller-code as integer no-undo .
     2076   define buffer buf_staff for ub.staff.
     2077   assign RS-Saleman .
     2078   if RS-Saleman = "selective":U then do:
     2079     sale-list = "" .
     2080     if rs-seller-cashier = "seller" then do:
     2081       run ref/staffs.w (
     2082                      input my-handle
     2083                     ,input "b-sel,b-mark"
     2084                     ,input 'S':U
     2085                     ,input (if v-cntxt-db-num = 0 then ? else v-cntxt-db-num)
     2086                     ,input 0
     2087                     ,output sale-list ) .
     2088     end.
     2089     else do:
     2090       run ref/staffs.w (
     2091                       input my-handle
     2092                      ,input "b-sel,b-mark"
     2093                      ,input 'C':U
     2094                      ,input (if v-cntxt-db-num = 0 then ? else v-cntxt-db-num)
     2095                      ,input 0
     2096                      ,output sale-list ) .
     2097     end.
     2098     if sale-list = "" then do:
     2099       assign
     2100       BySalers = FALSE
     2101       sale-list = ""
     2102       Rs-Saleman = "all":U .
     2103       DISPLAY BySalers RS-Saleman with frame F-Main .
     2104     end.
     2105     else do:
     2106       for each sj-salesman:
     2107         delete sj-salesman.
     2108       end.
     2109       assign
     2110       BySalers = TRUE
     2111       .
     2112       DISPLAY BySalers with frame F-Main .
     2113       DO ii = 1 to num-entries( sale-list ) :
     2114         FIND FIRST buf_staff WHERE
     2115               recid( buf_staff ) = integer( entry( ii, sale-list ) ) NO-LOCK .
     2116         create sj-salesman.
     2117         assign
     2118         sj-salesman.seller =   buf_staff.staff-code
     2119         sj-salesman.psn-code = buf_staff.psn-code
     2120         sj-salesman.sal-chr = string(buf_staff.staff-code) + chr(4) + string(buf_staff.psn-code)
     2121         .
     2122         release sj-salesman.
     2123       END .
     2124     end.
     2125   end.
     2126   else do:
     2127     assign
     2128     sale-list = ""
     2129     saleman-num = 0.
     2130     for each sj-salesman:
     2131       delete sj-salesman.
     2132     end.
     2133     DISPLAY BySalers with frame F-Main .
     2134   end.
     2135   END.
     2136   ON VALUE-CHANGED OF RS-seller-cashier IN FRAME F-Main
     2137   DO:
     2138     ASSIGN
     2139     RS-seller-cashier.
     2140     CASE RS-saleman:
     2141       when "selective" then do:
     2142         assign
     2143         Rs-Saleman = "all":U
     2144         .
     2145         DISPLAY
     2146         RS-Saleman
     2147         with frame F-Main .
     2148       end.
     2149       when "all" then do:
     2150       end.
     2151     END CASE.
     2152   END.
     2153   if not this-procedure :persistent
     2154   then do:
     2155     message
     2156       vss-workfile vss-revision vss-description skip
     2157       "Ошибка при запуске процедуры" skip
     2158       "Данную процедуру следует запускать только с параметром persistent" skip
     2159       view-as alert-box error .
     2160     undo, return error .
     2161   end.
     2162   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2163   PROCEDURE no-benq.
     2164   DEFINE OUTPUT PARAMETER found as logical init no.
     2165   define buffer buf_chk-doc for ub.chk-doc.
     2166   FOR EACH obj-list WHERE
     2167           obj-list.obj-type = 'маг':U NO-LOCK :
     2168     CASE X-Radio-Task > 1 :
     2169       WHEN YES THEN DO:
     2170         FOR EACH buf_chk-doc NO-LOCK WHERE
     2171                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2172                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2173                 (
     2174                   buf_chk-doc.shift-date >= X-date-start AND
     2175                   buf_chk-doc.shift-date <= X-date-end)
     2176                   AND
     2177                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2178           IF X-Radio-Task = 3 AND
     2179           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     2180             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     2181           IF X-Radio-Task = 4 AND
     2182           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2183           found = yes.
     2184           return.
     2185         END.
     2186       END.
     2187       WHEN NO THEN DO:
     2188         FOR EACH buf_chk-doc NO-LOCK WHERE
     2189               buf_chk-doc.obj-type = obj-list.obj-type AND
     2190               buf_chk-doc.obj-code = obj-list.obj-code AND
     2191               buf_chk-doc.chk-date >= X-date-start AND
     2192               buf_chk-doc.chk-date <= X-date-end   AND
     2193               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2194           found = yes.
     2195           return.
     2196         END.
     2197        END.
     2198      END CASE.
     2199    END.
     2200   END PROCEDURE.
     2201   PROCEDURE no-benqi.
     2202   DEFINE OUTPUT PARAMETER found as logical init no.
     2203   define buffer buf_chk-doc for ub.chk-doc.
     2204   define buffer buf_inkas for ub.inkas.
     2205   FOR EACH obj-list WHERE
     2206         obj-list.obj-type = 'маг':U NO-LOCK :
     2207     CASE X-Radio-Task > 1 :
     2208       WHEN YES THEN DO:
     2209         FOR EACH buf_chk-doc No-LOCK WHERE
     2210                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2211                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2212                 (
     2213                   buf_chk-doc.shift-date >= X-date-start AND
     2214                   buf_chk-doc.shift-date <= X-date-end)
     2215                   AND
     2216                   buf_Chk-doc.out-code = ? AND
     2217                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2218           IF X-Radio-Task = 3 AND
     2219           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     2220             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     2221           IF X-Radio-Task = 4 AND
     2222           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2223           found = yes.
     2224           return.
     2225         END.
     2226         FOR EACH buf_inkas No-LOCK WHERE
     2227                   buf_inkas.obj-type = obj-list.obj-type AND
     2228                   buf_inkas.obj-code = obj-list.obj-code AND
     2229                   (
     2230                   buf_inkas.shift-date >= X-date-start AND
     2231                   buf_inkas.shift-date <= X-date-end):
     2232           if buf_inkas.status_ = 'факт':U
     2233           or buf_inkas.status_ = 'запрос':U then next.
     2234           IF X-Radio-Task = 3 AND
     2235           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     2236             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     2237           IF X-Radio-Task = 4 AND
     2238           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     2239           found = yes.
     2240           return.
     2241         END.
     2242       END.
     2243       WHEN NO THEN DO:
     2244         FOR EACH buf_chk-doc NO-LOCK WHERE
     2245                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2246                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2247                 buf_chk-doc.chk-date >= X-date-start AND
     2248                 buf_chk-doc.chk-date <= X-date-end   AND
     2249                 buf_Chk-doc.out-code = ? AND
     2250                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2251           found = yes.
     2252           return.
     2253         END.
     2254         FOR EACH buf_inkas NO-LOCK WHERE
     2255                 buf_inkas.obj-type = obj-list.obj-type AND
     2256                 buf_inkas.obj-code = obj-list.obj-code AND
     2257                 buf_inkas.doc-date >= X-date-start AND
     2258                 buf_inkas.doc-date <= X-date-end :
     2259           if buf_inkas.status_ = 'факт':U
     2260           or buf_inkas.status_ = 'запрос':U then next.
     2261           found = yes.
     2262           return.
     2263         END.
     2264       END.
     2265     END CASE.
     2266   END.
     2267   END PROCEDURE.
     2268   PROCEDURE no-benq-i.
     2269   DEFINE OUTPUT PARAMETER found as logical init no.
     2270   define buffer buf_inkas for ub.inkas.
     2271   CASE X-Radio-Task > 1:
     2272     WHEN YES then do:
     2273       FOR EACH obj-list WHERE
     2274               obj-list.obj-type = 'маг':U NO-LOCK :
     2275         FOR EACH buf_inkas NO-LOCK WHERE
     2276                 buf_inkas.obj-type = obj-list.obj-type AND
     2277                 buf_inkas.obj-code = obj-list.obj-code AND
     2278                 buf_inkas.status_ = 'факт':U AND
     2279                 (
     2280                 buf_inkas.shift-date >= X-date-start AND
     2281                 buf_inkas.shift-date <= X-date-end):
     2282           IF X-Radio-Task = 3 AND
     2283           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     2284             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     2285           IF X-Radio-Task = 4 AND
     2286           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     2287           found = yes.
     2288           return.
     2289         END.
     2290     END.
     2291     END.
     2292     WHEN NO THEN DO:
     2293       FOR EACH obj-list WHERE
     2294               obj-list.obj-type = 'маг':U NO-LOCK :
     2295         FOR EACH buf_inkas NO-LOCK WHERE
     2296                 buf_inkas.obj-type = obj-list.obj-type AND
     2297                 buf_inkas.obj-code = obj-list.obj-code AND
     2298                 buf_inkas.status_ = 'факт':U AND
     2299                 buf_inkas.doc-date >= X-date-start AND
     2300                 buf_inkas.doc-date <= X-date-end :
     2301            found = yes.
     2302            return.
     2303         END.
     2304       END.
     2305     END.
     2306   END CASE.
     2307   END PROCEDURE.
     2308   PROCEDURE no-benq-i-office.
     2309   DEFINE OUTPUT PARAMETER found as logical init no.
     2310   define buffer buf_sale-doc for ub.sale-doc.
     2311   CASE X-Radio-Task > 1:
     2312     WHEN YES then do:
     2313       FOR EACH obj-list WHERE
     2314               obj-list.obj-type = 'маг':U NO-LOCK :
     2315         FOR EACH buf_sale-doc NO-LOCK WHERE
     2316                  buf_Sale-doc.obj-type = obj-list.obj-type
     2317              AND buf_sale-doc.obj-code = obj-list.obj-code
     2318              AND buf_sale-doc.status_ = 'факт':U
     2319              AND buf_sale-doc.chr-office = 'у':U
     2320              AND (
     2321                 buf_sale-doc.shift-date >= X-date-start
     2322                 AND
     2323                 buf_sale-doc.shift-date <= X-date-end):
     2324           IF X-Radio-Task = 3 AND
     2325           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     2326             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     2327           IF X-Radio-Task = 4 AND
     2328           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2329           found = yes.
     2330           return.
     2331         END.
     2332       END.
     2333     END.
     2334     WHEN NO THEN DO:
     2335       FOR EACH obj-list WHERE
     2336               obj-list.obj-type = 'маг':U NO-LOCK :
     2337         FOR EACH buf_sale-doc NO-LOCK WHERE
     2338                 buf_sale-doc.obj-type = obj-list.obj-type
     2339            AND  buf_sale-doc.obj-code = obj-list.obj-code
     2340            AND  buf_sale-doc.status_ = 'факт':U
     2341            AND  buf_sale-doc.chr-office = 'у':U
     2342            AND  buf_sale-doc.doc-date >= X-date-start
     2343            AND  buf_sale-doc.doc-date <= X-date-end :
     2344           found = yes.
