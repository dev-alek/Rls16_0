     2349   END CASE.
     2350   END PROCEDURE.
     2351   PROCEDURE adm-create-objects :
     2352   END PROCEDURE.
     2353   PROCEDURE adm-row-available :
     2354     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2355     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2356     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2357     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2358     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2359     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2360     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2361     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2362     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2363     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2364     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2365     IF adm-updating-record THEN RETURN.
     2366     RUN get-attribute ('FIELDS-ENABLED':U).
     2367     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2368     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2369         OUTPUT link-handle) NO-ERROR.
     2370     IF link-handle = "":U THEN
     2371         RETURN.
     2372     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2373     IF NUM-ENTRIES(link-handle) > 1 THEN
     2374         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2375             "encountered more than one RECORD-SOURCE.":U SKIP
     2376             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2377                VIEW-AS ALERT-BOX ERROR.
     2378     RUN get-attribute ('Key-Name':U).
     2379     key-name = RETURN-VALUE.
     2380     IF key-name = "":U THEN key-name = ?.
     2381     IF key-name NE ? THEN DO:
     2382       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2383         NO-ERROR.
     2384       IF key-value NE ? THEN
     2385         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2386     END.
     2387   IF VALID-HANDLE (adm-object-hdl) THEN
     2388       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2389   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2390   END PROCEDURE.
     2391   PROCEDURE disable_UI :
     2392     HIDE FRAME F-Main.
     2393     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2394   END PROCEDURE.
     2395   PROCEDURE enable_UI :
     2396     DISPLAY RS-by Tot_Groups Tot_Producers RS-sort BySalers RS-seller-cashier
     2397             Only_Tot RS-saleman ByPrice RS-cass
     2398         WITH FRAME F-Main.
     2399     ENABLE RECT-5 RECT-7 RECT-6 RECT-4 RECT-3 RECT-detail RS-by BySalers
     2400            RS-seller-cashier RS-saleman ByPrice RS-cass
     2401         WITH FRAME F-Main.
     2402   END PROCEDURE.
     2403   PROCEDURE ini-from-selobj :
     2404   define variable num-obj-list as integer no-undo.
     2405   CASE X-SelectObject :
     2406       when "текущий" then do:
     2407           enable rs-cass with frame F-Main.
     2408       end.
     2409       when "все" then do:
     2410           assign cas-num  = 0
     2411           rs-cass = "all":U.
     2412           display rs-cass with frame F-Main.
     2413           disable rs-cass with frame F-Main.
     2414           Hide cas-num in frame F-Main.
     2415       end.
     2416       when "выборочно" then do:
     2417           for each obj-list no-lock:
     2418               num-obj-list = num-obj-list + 1.
     2419               if num-obj-list > 1 then leave.
     2420           end.
     2421           if num-obj-list > 1 then do:
     2422           assign cas-num  = 0
     2423           rs-cass = "all":U.
     2424           display rs-cass cas-num with frame F-Main.
     2425           disable rs-cass with frame F-Main.
     2426           Hide cas-num in frame F-Main.
     2427       end.
     2428   end.
     2429   END CASE.
     2430   END PROCEDURE.
     2431   PROCEDURE local-initialize :
     2432    parparentproc = my-handle.
     2433   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2434     run mainmenu_getcntxt in parparentproc
     2435       (output v-cntxt-db-num
     2436       ,output v-cntxt-userid
     2437       ,output v-cntxt-level
     2438       ,output v-cntxt-host-code-obj
     2439       ,output v-cntxt-obj-type
     2440       ,output v-cntxt-obj-code
     2441       ,output v-cntxt-db-num-obj
     2442       ,output v-cntxt-is-admin
     2443       ) .
     2444     run dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2445       run ini-from-selobj in this-procedure .
     2446       run next_enable in this-procedure .
     2447   END PROCEDURE.
     2448   PROCEDURE MainProc :
     2449   run rep/e-sj1.p ( input my-handle, output v-frame-width) no-error.
     2450   if error-status:error then return error.
     2451   END PROCEDURE.
     2452   PROCEDURE MainProc-t :
     2453   run rep/e-sj2.p ( input my-handle, output v-frame-width) no-error.
     2454   if error-status:error then return error.
     2455   END PROCEDURE.
     2456   PROCEDURE MainProc_d :
     2457    run rep/e-sj3.p ( input my-handle, output v-frame-width) no-error.
     2458    if error-status:error then return error.
     2459   END PROCEDURE.
     2460   PROCEDURE MainProc_D-t :
     2461   run rep/e-sj4.p ( input my-handle, output v-frame-width) no-error.
     2462   if error-status:error then return error.
     2463   END PROCEDURE.
     2464   PROCEDURE Main_Circle :
     2465   date_string = cur-time-print() .
     2466   if cashdesc-num = 10000 then
     2467   cash_string = "КАССЫ            :  В С Е.".
     2468   else
     2469   cash_string = "КАССА            :  " + string(cashdesc-num, ">>>>>9") + ".".
     2470   assign
     2471   cash_string = cash_string + fill(" ", 31) + "Итоги по группам        :  " +
     2472                          (if grouptot_flag then "ДА." else "НЕТ.")
     2473   sale_string = string("Продавцы: " + rs-saleman-str + " "  + saleman-str , "x(57)" )  +
     2474   "Итоги по производителям :  " + ( if prodtot_flag then "ДА." else "НЕТ." ).
     2475   run waitfram-show in this-procedure ( input "Подождите ..." ).
     2476   run rep/e-sj-cr.p (
     2477                   input this-procedure
     2478                   ,input v-curr-r-b
     2479                   ,input X-date-start
     2480                   ,input X-date-end
     2481                   ,input X-shift-start
     2482                   ,input X-shift-end
     2483                   ,input X-shift-Alone
     2484                   ,input X-selectGood
     2485                   ,input X-Radio-Task
     2486                   ,input rs-seller-cashier
     2487                   ,input BySalers
     2488                   ,input t-twounit
     2489                   ,input ", обработано чеков :"
     2490                   ,input (X-Radio-Task > 1)
     2491                   ,input (if cashdesc-num = 10000
     2492                          then -1
     2493                          else cashdesc-num)
     2494                   )
     2495               .
     2496   run waitfram-hide in this-procedure .
     2497   Line = fill("-", 250).
     2498   if v-curr-r-b = 'base':U then do:
     2499     if my-Set_Val_Type = 3 or t-twounit then do:
     2500       run prn-lib-open-stream  in this-procedure (
     2501                                                   input my-handle
     2502                                                   ,input 43
     2503                                                   ,input yes
     2504                                                   ,input no
     2505                                                   ).
     2506     end.
     2507     else do:
     2508       run prn-lib-open-stream  in this-procedure (
     2509                                                   input my-handle
     2510                                                   ,input 62
     2511                                                   ,input yes
     2512                                                   ,input no
     2513                                                   ).
     2514     end.
     2515   end.
     2516   else do:
     2517     if  t-twounit then do:
     2518         run prn-lib-open-stream  in this-procedure (
     2519                                                     input my-handle
     2520                                                     ,input 43
     2521                                                     ,input yes
     2522                                                     ,input no
     2523                                                     ).
     2524     end.
     2525     else do:
     2526       run prn-lib-open-stream  in this-procedure (
     2527                                                   input my-handle
     2528                                                   ,input 62
     2529                                                   ,input yes
     2530                                                   ,input no
     2531                                                   ).
     2532     end.
     2533   end.
     2534   run value(if t-twounit then "MainProc-t" else "MainProc").
     2535   output STREAM PrnLibStream CLOSE.
     2536   OneLinePrinted = False .
     2537   END PROCEDURE.
     2538   PROCEDURE Main_Circle_d :
     2539   date_string = cur-time-print() .
     2540   if cashdesc-num = 10000 then
     2541   cash_string = "КАССЫ            :  В С Е.".
     2542   else
     2543   cash_string = "КАССА            :  " + string(cashdesc-num, ">>>>>9") + ".".
     2544   assign
     2545   cash_string = cash_string + fill(" ", 31) + "Итоги по группам        :  " +
     2546                 (if grouptot_flag then "ДА." else "НЕТ.")
     2547   sale_string = string("Продавцы: " + rs-saleman-str + " "  + saleman-str , "x(57)" ) +
     2548   "Итоги по производителям :  " + ( if prodtot_flag then "ДА." else "НЕТ." ).
     2549   run waitfram-show in this-procedure (  input "Подождите ..." ).
     2550   run rep/e-sj-crd.p (
     2551                   input this-procedure
     2552                   ,input v-curr-r-b
     2553                   ,input X-date-start
     2554                   ,input X-date-end
     2555                   ,input X-shift-start
     2556                   ,input X-shift-end
     2557                   ,input X-shift-Alone
     2558                   ,input X-selectGood
     2559                   ,input X-Radio-Task
     2560                   ,input rs-seller-cashier
     2561                   ,input BySalers
     2562                   ,input t-twounit
     2563                   ,input ", обработано чеков :"
     2564                   ,input (X-Radio-Task > 1)
     2565                   ,input (if cashdesc-num = 10000
     2566                          then -1
     2567                          else cashdesc-num)
     2568                   )
     2569       .
     2570   run waitfram-hide in this-procedure .
     2571   Line = fill("-", 250).
     2572   run prn-lib-open-stream  in this-procedure (
     2573                                                input my-handle
     2574                                               ,input 43
     2575                                               ,input yes
     2576                                               ,input no
     2577                                               ).
     2578   run value(if t-twounit then "MainProc_D-t" else "MainProc_D").
     2579   output STREAM PrnLibStream CLOSE.
     2580   OneLinePrinted = False .
     2581   END PROCEDURE.
     2582   PROCEDURE My-report :
     2583   Run My-var in this-procedure .
     2584   FOR EACH sj-goods :
     2585       delete sj-goods .
     2586   END .
     2587   FOR EACH sj-adv :
     2588       delete sj-adv .
     2589   END .
     2590   FOR EACH sj-tots :
     2591       delete sj-tots .
     2592   END .
     2593   FOR EACH sj-grp :
     2594       delete sj-grp .
     2595   END .
     2596   if ByPrice then run Main_Circle_d in this-procedure .
     2597   else
     2598   run Main_Circle in this-procedure .
     2599   if v-frame-width <= 198 then do:
     2600     run prn-lib-prn-file in this-procedure ( input my-handle, input (if v-frame-width <= 136 then 0 else 8)) .
     2601   end.
     2602   else do:
     2603     run prn-lib-prn-file in this-procedure ( input my-handle, input (if v-frame-width <= 232 then 9 else 20)) .
     2604   end.
     2605   END PROCEDURE.
     2606   PROCEDURE My-var :
     2607   assign
     2608   frame F-Main Rs-Sort
     2609   frame F-Main Rs-By
     2610   frame F-Main Rs-Cass
     2611   frame F-Main Cas-num
     2612   frame F-Main Rs-Saleman
     2613   frame F-Main ByPrice
     2614   frame F-Main BySalers
     2615   frame F-Main Only_Tot
     2616   frame F-Main Tot_Groups
     2617   frame F-Main Tot_Producers
     2618   frame F-Main T-twounit
     2619   frame F-Main RS-seller-cashier
     2620   .
     2621   assign
     2622   cashdesc-num = if RS-Cass:screen-value = "all":U
     2623                  then 10000 else integer(Cas-Num:screen-value)
     2624   prodtot_flag = ( if ( Tot_Producers:screen-value = "yes" AND
     2625                         Tot_Producers:sensitive = yes ) then TRUE else FALSE )
     2626   grouptot_flag = ( if ( Tot_Groups:screen-value = "yes" AND
     2627                          Tot_Groups:sensitive = yes ) then TRUE else FALSE )
     2628   .
     2629   assign
     2630   ShBySAlers = BySAlers
     2631   Shrs-seller-cashier = rs-seller-cashier
     2632   SHRs-BY = RS-BY
     2633   SHt-twounit = t-twounit
     2634   SHRS-SOrt = RS-SOrt
     2635   SHOnly_tot = Only_Tot
     2636   .
     2637   if RS-Saleman = "all":U then
     2638   saleman-num = 10000 .
     2639   else do:
     2640     assign
     2641     saleman-num = - 1.
     2642     saleman-str
     2643     .
     2644     for each sj-salesman:
     2645       if saleman-num >= 0 then do:
     2646         saleman-num = -1 .
     2647         leave.
     2648       end.
     2649       assign
     2650       saleman-num = sj-salesman.seller
     2651       saleman-str = saleman-str + (if saleman-str = '':u then '':U else chr(44)) + string(sj-salesman.seller)
     2652       .
     2653     end.
     2654   end.
     2655   assign
     2656   my-Set_val_TYPE = if x-SET_val_TYPE = 0 then 2 else x-SET_val_TYPE.
     2657   Assign
     2658    STR-obj-type = ''
     2659    STR-obj-code = ''
     2660    STR-obj-name = ''
     2661    STR-obj      = ''.
     2662   For each obj-list no-lock:
     2663    Assign
     2664    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2665    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2666    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2667    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2668   End.
     2669   assign
     2670   Rs-sort-str =  radio-label(string(rs-sort), rs-sort:radio-buttons)
     2671   Rs-by-str =   radio-label(string(rs-by), rs-by:radio-buttons)
     2672   Rs-cass-str = radio-label(string(rs-cass), rs-cass:radio-buttons)
     2673   cas-num-str =   (IF cas-num > 0 then ("Касса N: " + String(cas-num)) else "")
     2674   rs-saleman-str = radio-label(string(rs-saleman), rs-saleman:radio-buttons)
     2675   saleman-str =   (IF saleman-num > 0 and saleman-num < 10000
     2676                    then ((if rs-seller-cashier = "seller"
     2677                           then "Продавец N: "
     2678                           else "Кассир   N: ") + String(saleman-num))
     2679                    else "")
     2680   ReportHeader =  "Классификация: " + rs-by-str + chr(10) +
     2681                   (if Rs-sort:sensitive in frame F-Main
     2682                    then
     2683                    ("Сортировка: " + Rs-sort-str)
     2684                    else ""
     2685                    ) + chr(10) +
     2686                     "Кассы: " + rs-cass-str  + chr(10) +
     2687                   cas-num-str + chr(10) +
     2688                   (if rs-seller-cashier = "seller"
     2689                    then "Продавцы: "
     2690                    else "Кассиры") +
     2691                    rs-saleman-str + chr(10) +
     2692                   saleman-str + chr(10) +
     2693                   (if Only_tot
     2694                    then ("Только итоги"  + chr(10))
     2695                    else "") +
     2696                    (if ByPrice OR BySalers OR Tot_Groups OR Tot_Producers
     2697                    then ("Итоги: " +
     2698                          (if ByPrice then (Byprice:label + " ") else "") +
     2699                          (if BySalers
     2700                           then ((IF rs-seller-cashier = "seller"
     2701                                 THEN ENTRY(1, BySalers:label, chr(47))
     2702                                 ELSE ENTRY(2, BySalers:label, chr(47)))
     2703                                            + " ")
     2704                           else "") +
     2705                          (if Tot_groups then (Tot_Groups:label + " ") else "") +
     2706                          (if Tot_Producers then (Tot_Producers:label + " ") else "")
     2707                         )
     2708                    else ""
     2709                   ).
     2710   END PROCEDURE.
     2711   PROCEDURE NExt_enable :
     2712   if LOOKUP('2ед':U, call-point) > 0 then do:
     2713       assign
     2714       t-twounit = yes.
     2715       DISPLAY
     2716       t-twounit with frame F-Main.
     2717       ENABLE
     2718       t-twounit with frame F-Main.
     2719   end.
     2720   END PROCEDURE.
     2721   PROCEDURE report-to-ach :
     2722    do
     2723    on error undo, return error return-value
     2724    :
     2725    DEFINE INPUT-OUTPUT  PARAMETER TABLE FOR param-to-export .
     2726     for each  param-to-export : delete  param-to-export. end.
     2727   define variable cconnect as character no-undo .
     2728   define variable user-name as character no-undo .
     2729   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     2731     (input  v-cntxt-userid
     2732     ,output user-name
     2733     )  .
     2734    get-key-value section "rep-sets" key "conpar" value cconnect .
     2735   define variable v-base-key as character no-undo .
     2736   run gbl/base-key.p
     2737      (output v-base-key
     2738     ) .
     2739     run create-param-to-export  in this-procedure
     2740     ( input 'base-key'  ,
     2741      input ''  ,
     2742      input 'character'  ,
     2743      input v-base-key  ,
     2744      input 'ключ' )
     2745    .
     2746     run create-param-to-export  in this-procedure
     2747     ( input 'db-connect'  ,
     2748      input ''  ,
     2749      input 'character'  ,
     2750      input cconnect  ,
     2751      input 'строка коннекта к БД' )
     2752    .
     2753     run create-param-to-export  in this-procedure
     2754     ( input 'report-code'  ,
     2755      input ''  ,
     2756      input 'character'  ,
     2757      input ReportProc  ,
     2758      input 'уникальный код отчета' )
     2759    .
     2760   define variable v-host-code like ub.sysconf.host-code no-undo .
     2761   define variable v-host-name like ub.clients.obj-name no-undo .
     2762   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     2764     (input  v-cntxt-obj-type
     2765     ,input  v-cntxt-obj-code
     2766     ,output v-host-code
     2767     ,output v-host-name
     2768     )  .
     2769     run create-param-to-export  in this-procedure
     2770     ( input 'firm-name'  ,
     2771      input ''  ,
     2772      input 'character'  ,
     2773      input v-host-name  ,
     2774      input 'имя фирмы' )
     2775    .
     2776     run create-param-to-export  in this-procedure
     2777     ( input 'firm-code'  ,
     2778      input ''  ,
     2779      input 'integer'  ,
     2780      input string(v-cntxt-host-code-obj)  ,
     2781      input 'код фирмы' )
     2782    .
     2783     run create-param-to-export  in this-procedure
     2784     ( input 'user-name'  ,
     2785      input ''  ,
     2786      input 'character'  ,
     2787      input user-name  ,
     2788      input 'имя пользователя' )
     2789    .
     2790     run create-param-to-export  in this-procedure
     2791     ( input 'store-type'  ,
     2792      input ''  ,
     2793      input 'character'  ,
     2794      input v-cntxt-obj-type  ,
     2795      input 'текущий объект - тип'  )
     2796    .
     2797     run create-param-to-export  in this-procedure
     2798     ( input 'store-code'  ,
     2799      input ''  ,
     2800      input 'integer'  ,
     2801      input string(v-cntxt-obj-code)  ,
     2802      input 'текущий объект - код' )
     2803    .
     2804     run create-param-to-export  in this-procedure
     2805     ( input 'date-start'  ,
     2806      input ''  ,
     2807      input 'data'  ,
     2808      input string(x-date-start,'99/99/9999')  ,
     2809      input 'дата начала интервала'  )
     2810    .
     2811     run create-param-to-export  in this-procedure
     2812     ( input 'date-end'  ,
     2813      input ''  ,
     2814      input 'data'  ,
     2815      input string(x-date-end,'99/99/9999')  ,
     2816      input 'дата конца интервала' )
     2817    .
     2818     run create-param-to-export  in this-procedure
     2819     ( input 'user-id'  ,
     2820      input ''  ,
     2821      input 'character'  ,
     2822      input v-cntxt-userid  ,
     2823      input 'код пользователя' )
     2824    .
     2825   define variable v-base-code like ub.sysconf.base-code no-undo .
     2826   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2827   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2828     (input  v-cntxt-host-code-obj
     2829     ,output v-base-code
     2830     )  .
     2831   define buffer buf_currency for ub.currency.
     2832   find first buf_currency no-lock where
     2833             buf_currency.curr-code = v-base-code.
     2834     run create-param-to-export  in this-procedure
     2835     ( input 'base-type'  ,
     2836      input ''  ,
     2837      input 'character'  ,
     2838      input string(buf_currency.curr-abbr)  ,
     2839      input 'тип базовой валюты' )
     2840    .
     2841     run create-param-to-export  in this-procedure
     2842     ( input 'base-code'  ,
     2843      input ''  ,
     2844      input 'integer'  ,
     2845      input string(v-base-code)  ,
     2846      input 'код базовой валюты' )
     2847    .
     2848   if Show-Crsa or Show-Cost or Show-Sale then do:
     2849     run create-param-to-export  in this-procedure
     2850     ( input 'crsa'  ,
     2851      input ''  ,
     2852      input 'logical'  ,
     2853      input string(show-Crsa,'yes/no')  ,
     2854      input '  продажные цены' )
     2855    .
     2856     run create-param-to-export  in this-procedure
     2857     ( input 'cost'  ,
     2858      input ''  ,
     2859      input 'logical'  ,
     2860      input string(show-cost,'yes/no')  ,
     2861      input '  учетные цены' )
     2862    .
     2863     run create-param-to-export  in this-procedure
     2864     ( input 'sale'  ,
     2865      input ''  ,
     2866      input 'logical'  ,
     2867      input string(show-sale,'yes/no')  ,
     2868      input '  цены документа' )
     2869    .
     2870   end.
     2871   else do:
     2872     run create-param-to-export  in this-procedure
     2873     ( input 'set-pay-type'  ,
     2874      input ''  ,
     2875      input 'integer'  ,
     2876      input string(x-set_pay_type)  ,
     2877      input 'тип цены Продажные цены=1 Учетные цены=2 Цены документа=3 ' )
     2878    .
     2879   end.
     2880     run create-param-to-export  in this-procedure
     2881     ( input 'rubl-val'  ,
     2882      input ''  ,
     2883      input 'integer'  ,
     2884      input string(x-SET_val_TYPE)  ,
     2885      input 'печатать в рублях или валюте руб=1  вал=2  обе=3 ' )
     2886    .
     2887     run create-param-to-export  in this-procedure
     2888     ( input 'reportname'  ,
     2889      input ''  ,
     2890      input 'character'  ,
     2891      input reportname  ,
     2892      input 'название отчета' )
     2893    .
     2894     run create-param-to-export  in this-procedure
     2895     ( input 'select-good'  ,
     2896      input ''  ,
     2897      input 'integer'  ,
     2898      input string(x-selectgood)  ,
     2899      input 'тип выбора товара all=1 grp=2 prod=3 choice=4 one=5 grp-prod=6' )
     2900    .
     2901    define variable ii as integer no-undo .
     2902    define variable ii-name as character no-undo .
     2903    define variable ii-1 as integer no-undo .
     2904    define variable ii-name-1 as character no-undo .
     2905     define variable ii-2 as integer no-undo .
     2906    define variable ii-name-2 as character no-undo .
     2907    define variable ii-3 as integer no-undo .
     2908    define variable ii-name-3 as character no-undo .
     2909    if x-selectgood = 1     Or
     2910       x-selectgood = 2     Or
     2911       x-selectgood = 3    Or
     2912       x-selectgood = 4  then do:
     2913    ii = 0.
     2914         for each gds-list :
     2915           ii = ii + 1 .
     2916           if ii = 1 then ii-name = "список товаров - содержит gds-code  (уникальный ключ товара)" .
     2917                     else ii-name = "" .
     2918     run create-param-to-export  in this-procedure
     2919     ( input 'gds-list'  ,
     2920      input string(ii)  ,
     2921      input 'integer'  ,
     2922      input string(gds-list.gds-code)  ,
     2923      input ii-name )
     2924    .
     2925         end.
     2926    end.
     2927    if x-selectgood = 2 then do:
     2928    ii-2 = 0.
     2929         for each tmp#grp :
     2930           ii-2 = ii-2 + 1 .
     2931           if ii-2 = 1 then ii-name-2 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка групп)" .
     2932                     else ii-name-2 = "" .
     2933     run create-param-to-export  in this-procedure
     2934     ( input 'tmp#grp'  ,
     2935      input string(ii-2)  ,
     2936      input 'integer character '  ,
     2937      input string(tmp#grp.node-code) + '#' +  (tmp#grp.grp-name)  ,
     2938      input ii-name-2 )
     2939    .
     2940         end.
     2941    end.
     2942    if x-selectgood = 3 then do:
     2943    ii-3 = 0.
     2944         for each g#cli :
     2945           ii-3 = ii-3 + 1 .
     2946           if ii-3 = 1 then ii-name-3 = "список товаров - содержит  <node-code#grp-name>  (уникальный ключ списка производителе)" .
     2947                       else ii-name-3 = "" .
     2948     run create-param-to-export  in this-procedure
     2949     ( input 'g#cli'  ,
     2950      input string(ii-3)  ,
     2951      input 'character integer'  ,
     2952      input g#cli.obj-type + '#' + string(g#cli.obj-code)  ,
     2953      input ii-name-3 )
     2954    .
     2955         end.
     2956    end.
     2957     run create-param-to-export  in this-procedure
     2958     ( input 'select-object'  ,
     2959      input ''  ,
     2960      input 'character'  ,
     2961      input x-selectobject  ,
     2962      input 'тип выбора объекта   -currency -choice -firm -все' )
     2963    .
     2964    ii-1 = 0.
     2965     for each obj-list :
     2966       ii-1 = ii-1 + 1 .
     2967       if ii-1 = 1 then ii-name-1 = "список объектов - содержит <obj-type#obj-code>  (уникальный ключ clients)" .
     2968                 else ii-name-1 = "" .
     2969     run create-param-to-export  in this-procedure
     2970     ( input 'obj-list'  ,
     2971      input string(ii-1)  ,
     2972      input 'character integer'  ,
     2973      input obj-list.obj-type + '#' + string (obj-list.obj-code)  ,
     2974      input ii-name-1 )
     2975    .
     2976     end.
     2977     run create-param-to-export  in this-procedure
     2978     ( input 'rs-sort'                             ,
     2979      input ''                                    ,
     2980      input 'character'                           ,
     2981      input Rs-Sort:screen-value in frame F-Main   ,
     2982      input 'сортировка' )
     2983    .
     2984     run create-param-to-export  in this-procedure
     2985     ( input 'rs-by'                             ,
     2986      input ''                                    ,
     2987      input 'character'                           ,
     2988      input lc( radio-label(string(rs-by), rs-by:radio-buttons in frame F-Main))  ,
     2989      input 'классификация' )
     2990    .
     2991     run create-param-to-export  in this-procedure
     2992     ( input 'rs-saleman'                             ,
     2993      input ''                                    ,
     2994      input 'character'                           ,
     2995      input Rs-Saleman:screen-value in frame F-Main   ,
     2996      input 'выбор прадовцов' )
     2997    .
     2998     run create-param-to-export  in this-procedure
     2999     ( input 'rs-cass'                             ,
     3000      input ''                                    ,
     3001      input 'character'                           ,
     3002      input Rs-cass:screen-value in frame F-Main   ,
     3003      input 'выбор касс' )
     3004    .
