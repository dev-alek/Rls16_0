     2606         (
     2607            input recid( tt_line )
     2608         , output v_print-line
     2609         , output v_excel-line
     2610         ) no-error .
     2611       if error-status :error or
     2612          v_print-line = ?    or
     2613          v_print-line = "":U
     2614       then do:
     2615         return error substitute( 'Ошибка печати строки отчета.&1 ТРК &2, Пистолет &3, &4.&1'
     2616                                + 'Чек &5, Оплата &6, Код валюты &7.'
     2617                                , chr(10)
     2618                                , tt_line.pump-code
     2619                                , tt_line.nozzle-code
     2620                                , substitute( 'Топливо &1 &2&3 "&4"'
     2621                                            , tt_line.artic
     2622                                            , tt_line.prod-type
     2623                                            , tt_line.prod-code
     2624                                            , tt_line.gds-code
     2625                                            )
     2626                                , tt_line.chk-code
     2627                                , tt_line.pay-code
     2628                                , tt_line.curr-code
     2629                                ) .
     2630       end.
     2631       put stream text_out unformatted
     2632         v_print-line skip
     2633       .
     2634       if Make-Excel then  put   stream ForExcel unformatted
     2635         v_excel-line skip
     2636       .
     2637       if last-of( tt_line.chk-date )
     2638       then do:
     2639         if use-column[  9 ] = yes or
     2640            use-column[ 10 ] = yes
     2641         then do:
     2642           if use-column[  9 ] = yes
     2643           then do:
     2644             run get-indent in this-procedure
     2645               (
     2646                  input 9
     2647               , output j_indent
     2648               , output v_text-indent
     2649               , output v_excel-indent
     2650               ) .
     2651             put stream text_out unformatted
     2652               v_text-indent
     2653               fill( "-", 13 )
     2654             .
     2655           end.
     2656           if use-column[ 10 ] = yes
     2657           then do:
     2658             if use-column[  9 ] <> yes
     2659             then do:
     2660               run get-indent in this-procedure
     2661                 (
     2662                    input 10
     2663                 , output j_indent
     2664                 , output v_text-indent
     2665                 , output v_excel-indent
     2666                 ) .
     2667               put stream text_out unformatted
     2668                 v_text-indent
     2669               .
     2670             end.
     2671             else do:
     2672               put stream text_out unformatted
     2673                 " ":U
     2674               .
     2675             end.
     2676             put stream text_out unformatted
     2677               fill( "-", 21 )
     2678             .
     2679           end.
     2680           put stream text_out unformatted
     2681             skip
     2682           .
     2683         end.
     2684         if use-column[  9 ] = yes or
     2685            use-column[ 10 ] = yes
     2686         then do:
     2687           if use-column[  9 ] = yes
     2688           then do:
     2689             run get-indent in this-procedure
     2690               (
     2691                  input 9
     2692               , output j_indent
     2693               , output v_text-indent
     2694               , output v_excel-indent
     2695               ) .
     2696             put stream text_out unformatted
     2697               v_text-indent
     2698               string( d_base-qnty, "->>>>,>>9.999":U )
     2699             .
     2700             if Make-Excel then  put   stream ForExcel unformatted
     2701               v_excel-indent
     2702               string( d_base-qnty, "->>>>>>>9.999":U )
     2703             .
     2704           end.
     2705           if use-column[ 10 ] = yes
