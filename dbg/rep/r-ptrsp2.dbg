     2771         (
     2772             input  ""
     2773            ,input  0
     2774            ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2775            ,input  7
     2776            ,output v-user-action
     2777            ,output v-printed
     2778         ) .
     2779     end.
     2780   end.
     2781   procedure get-fo-range :
     2782     define  input parameter p-obj-type   as character no-undo .
     2783     define  input parameter p-obj-code   as integer   no-undo .
     2784     define  input parameter p-date-from  as date      no-undo .
     2785     define  input parameter p-date-till  as date      no-undo .
     2786     define  input parameter p-shift-from as integer   no-undo .
     2787     define  input parameter p-shift-till as integer   no-undo .
     2788     define  input parameter p-is-shift   as logical   no-undo .
     2789     define output parameter p-fo-from    as decimal   no-undo initial 0.00 .
     2790     define output parameter p-fo-till    as decimal   no-undo initial 0.00 .
     2791     define variable v-shift-end-fact-order as decimal no-undo .
     2792     define variable v-day-end-fact-order   as decimal no-undo .
     2793     define variable v-fact-order           as decimal no-undo .
     2794     do
     2795     on error undo, return error return-value
     2796     :
     2797       if p-is-shift = yes
     2798       then do:
     2799         run factord in this-procedure
     2800           (
     2801              input p-date-from
     2802           ,  input 1
     2803           ,  input 1
     2804           ,  input p-date-from
     2805           ,  input p-shift-from
     2806           ,  input p-is-shift
     2807           , output p-fo-from
     2808           , output v-shift-end-fact-order
     2809           , output v-day-end-fact-order
     2810           ) no-error .
     2811         if error-status :error
     2812         then do:
     2813           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     2814                   "Ошибка при вызове процедуры factord" skip( 0 )
     2815                   error-status :get-message( 1 ) skip( 0 )
     2816                   return-value skip( 1 )
     2817           view-as alert-box error .
     2818           undo, return error return-value .
     2819         end.
     2820         run factord in this-procedure
     2821           (
     2822              input p-date-till
     2823           ,  input 1
     2824           ,  input 1
     2825           ,  input p-date-till
     2826           ,  input p-shift-till
     2827           ,  input p-is-shift
     2828           , output v-fact-order
     2829           , output p-fo-till
     2830           , output v-day-end-fact-order
     2831           ) no-error .
     2832         if error-status :error
     2833         then do:
     2834           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     2835                   "Ошибка при вызове процедуры factord" skip( 0 )
     2836                   error-status :get-message( 1 ) skip( 0 )
     2837                   return-value skip( 1 )
     2838           view-as alert-box error .
     2839           undo, return error return-value .
     2840         end.
     2841       end.
     2842       else do:
     2843         run day-begin-fact-order in this-procedure
     2844           (
     2845              input p-date-from
     2846           , output p-fo-from
     2847           ) no-error .
     2848         if error-status :error or
     2849            p-fo-from = ?
     2850         then do:
     2851           assign
     2852             p-fo-from = 0.00
     2853           .
     2854         end.
     2855         run factord-end-day in this-procedure
     2856           (
     2857              input p-date-till
     2858           , output p-fo-till
     2859           ) no-error .
     2860         if error-status :error or
     2861            p-fo-till = ?
     2862         then do:
     2863           assign
     2864             p-fo-till = truncate( p-fo-from, 0 ) + 0.99
     2865           .
     2866         end.
     2867       end.
     2868       if p-fo-till < p-fo-from
     2869       then do:
     2870         assign
     2871           p-fo-till = p-fo-from
     2872         .
     2873       end.
     2874     end.
     2875   end procedure.
     2876   procedure get-hour-range :
     2877     define  input parameter p-time as integer no-undo .
     2878     define output parameter p-from as integer no-undo .
     2879     define output parameter p-till as integer no-undo .
     2880     define variable j-hour as integer no-undo .
     2881     do
     2882     on error undo, return error return-value
     2883     :
     2884       assign
     2885         j-hour = integer( substring( string( p-time, "hh:mm:ss":U ), 1, 2 ) )
     2886         p-from = j-hour * 3600
     2887         p-till = p-from + 3599
     2888       .
     2889     end.
     2890   end procedure.
     2891   procedure get-label-lines :
     2892     define output parameter p-label-line-1 as character no-undo initial "":U .
     2893     define output parameter p-label-line-2 as character no-undo initial "":U .
     2894     define output parameter p-label-line-3 as character no-undo initial "":U .
     2895     define output parameter p-label-line-4 as character no-undo initial "":U .
     2896     define output parameter p-label-line-5 as character no-undo initial "":U .
     2897     define output parameter p-text-length  as integer   no-undo initial 0    .
     2898     define output parameter p-columns-no   as integer   no-undo initial 0    .
     2899     define output parameter p-total-length as integer   no-undo initial 0    .
     2900     define variable v_list-length as character no-undo initial "":U .
     2901     define variable v_list-label  as character no-undo initial "":U .
     2902     define variable v_list-types  as character no-undo initial "":U .
     2903     define variable jj            as integer   no-undo initial 0    .
     2904     define variable j_length      as integer   no-undo initial 0    .
     2905     define variable v_length      as character no-undo initial "":U .
     2906     define variable v_label       as character no-undo initial "":U .
     2907     define variable v_data-type   as character no-undo initial "":U .
     2908     do
     2909     on error undo, return error return-value
     2910     :
     2911       assign
     2912         p-label-line-1 = "-":U
     2913         p-label-line-2 = ":":U
     2914         p-label-line-3 = ":":U
     2915         p-label-line-4 = ":":U
     2916         p-label-line-5 = ":":U
     2917         p-text-length  = 0
     2918         p-columns-no   = 0
     2919       .
     2920       run get-lbl-data in this-procedure
     2921         (
     2922           output v_list-label
     2923         , output v_list-length
     2924         , output v_list-types
     2925         ) .
     2926       find first SheetF where
     2927                  SheetF.Sheet-Num = XLS-page-num .
     2928       do jj = 1 to num-entries( v_list-label )
     2929       :
     2930         if use-column[ jj ] <> yes
     2931         then do:
     2932           next .
     2933         end.
     2934         assign
     2935           v_label     = trim( entry( jj, v_list-label  ) )
     2936           v_length    = trim( entry( jj, v_list-length ) )
     2937           v_data-type = trim( entry( jj, v_list-types  ) )
     2938         .
     2939         assign
     2940           j_length = integer( v_length )
     2941         no-error .
     2942         assign
     2943           p-text-length  = p-text-length  + j_length
     2944           p-columns-no   = p-columns-no   + 1
     2945           p-label-line-1 = p-label-line-1 + fill( "-", j_length ) + "-"
     2946           p-label-line-2 = p-label-line-2 + substring( Centering( v_label, j_length ) + fill( " ":U, j_length )
     2947                                                      , 1
     2948                                                      , j_length
     2949                                                      ) + ":"
     2950           p-label-line-3 = p-label-line-3 + fill( "-", j_length ) + ":"
     2951           p-label-line-4 = p-label-line-4 + substring( Centering( string( p-columns-no ), j_length ) +
     2952                                                        fill( " ":U, j_length )
     2953                                                      , 1
     2954                                                      , j_length
     2955                                                      ) + ":"
     2956           p-label-line-5 = p-label-line-5 + fill( "-", j_length ) + ":"
     2957         .
     2958         assign
     2959           SheetF.Excel-Column-Lable = SheetF.Excel-Column-Lable
     2960                                     + ( if SheetF.Excel-Column-Lable = "":U then "":U else chr(44) )
     2961                                     + v_label
     2962           SheetF.Sizes              = SheetF.Sizes
     2963                                     + ( if SheetF.Sizes = "":U then "":U else chr(44) )
     2964                                     + v_length
     2965         .
     2966         case v_data-type :
     2967           when "D":U
     2968           then do:
     2969             assign
     2970               SheetF.ColFormat = SheetF.ColFormat
     2971                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     2972                                + string( p-columns-no ) + "=":U + "@":U
     2973             .
     2974             assign
     2975               v-column-list = v-column-list
     2976                             + ( if v-column-list = "":U then "":U else ";" )
     2977                             + "@":U
     2978             .
     2979           end.
     2980           when "T":U
     2981           then do:
     2982             assign
     2983               SheetF.ColFormat = SheetF.ColFormat
     2984                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     2985                                + string( p-columns-no ) + "=":U + "@":U
     2986             .
     2987             assign
     2988               v-column-list = v-column-list
     2989                             + ( if v-column-list = "":U then "":U else ";" )
     2990                             + "@":U
     2991             .
     2992           end.
     2993           when "Z":U
     2994           then do:
     2995             assign
     2996               SheetF.ColFormat = SheetF.ColFormat
     2997                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     2998                                + string( p-columns-no ) + "=":U + "#":U + v-del-1 + "##":U + "0":U
     2999             .
     3000             assign
     3001               v-column-list = v-column-list
     3002                             + ( if v-column-list = "":U then "":U else ";" )
     3003                             + "#":U + v-del-1 + "##":U + "0":U
     3004             .
     3005           end.
     3006           when "C":U
     3007           then do:
     3008             assign
     3009               SheetF.ColFormat = SheetF.ColFormat
     3010                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3011                                + string( p-columns-no ) + "=":U + "@":U
     3012             .
     3013             assign
     3014               v-column-list = v-column-list
     3015                             + ( if v-column-list = "":U then "":U else ";" )
     3016                             + "@":U
     3017             .
     3018           end.
     3019           when "I":U
     3020           then do:
     3021             assign
     3022               SheetF.ColFormat = SheetF.ColFormat
     3023                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3024                                + string( p-columns-no ) + "=":U + "0":U
     3025             .
     3026             assign
     3027               v-column-list = v-column-list
     3028                             + ( if v-column-list = "":U then "":U else ";" )
     3029                             + "0":U
     3030             .
     3031           end.
     3032           when "Q":U
     3033           then do:
     3034             assign
     3035               SheetF.ColFormat = SheetF.ColFormat
     3036                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3037                                + string( p-columns-no ) + "=":U + "#":U + v-del-1 + "##":U + "0":U + v-delim + "000":U
     3038             .
     3039             assign
     3040               v-column-list = v-column-list
     3041                             + ( if v-column-list = "":U then "":U else ";" )
     3042                             + "#":U + v-del-1 + "##":U + "0":U + v-delim + "000":U
     3043             .
     3044           end.
     3045           when "S":U
     3046           then do:
     3047             assign
     3048               SheetF.ColFormat = SheetF.ColFormat
     3049                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3050                                + string( p-columns-no ) + "=":U + "#":U + v-del-1 + "##":U + "0":U + v-delim + "00":U
     3051             .
     3052             assign
     3053               v-column-list = v-column-list
     3054                             + ( if v-column-list = "":U then "":U else ";" )
     3055                             + "#":U + v-del-1 + "##":U + "0":U + v-delim + "00":U
     3056             .
     3057           end.
     3058         end case.
     3059       end.
     3060       assign
     3061         SheetF.ColFormat = SheetF.ColFormat
     3062                          + chr(4)
     3063                          + chr(4)
     3064                          + trim( string( XLS-page-num, ">>>>>>>>>9":U ) ) + "-й Лист"
     3065       .
     3066       assign
     3067         p-total-length = p-text-length + p-columns-no + 1
     3068       .
     3069     end.
     3070   end procedure.
     3071   procedure get-print-line :
     3072     define  input parameter p-temp-rec-id as recid     no-undo .
     3073     define output parameter p-print-line  as character no-undo initial "":U .
     3074     define output parameter p-excel-line  as character no-undo initial "":U .
     3075     define variable v_list-label  as character no-undo initial "":U .
     3076     define variable v_list-types  as character no-undo initial "":U .
     3077     define variable v_list-length as character no-undo initial "":U .
     3078     define variable v_data-type   as character no-undo initial "":U .
     3079     define variable v_length      as character no-undo initial "":U .
     3080     define variable j_length      as integer   no-undo initial 0    .
     3081     define variable jj            as integer   no-undo initial 0    .
     3082     define variable j_time-top    as integer   no-undo .
     3083     define variable j_time-bottom as integer   no-undo .
     3084     define buffer bf_print-line for tt_line .
     3085     do
     3086     on error undo, return error return-value
     3087     :
     3088       find first bf_print-line no-lock where
     3089           recid( bf_print-line ) = p-temp-rec-id .
     3090       run get-lbl-data in this-procedure
     3091         (
     3092           output v_list-label
     3093         , output v_list-length
     3094         , output v_list-types
     3095         ) .
     3096       assign
     3097         p-print-line = ":":U
     3098         p-excel-line = "":U
     3099       .
     3100       do jj = 1 to num-entries( v_list-length )
     3101       :
     3102         if use-column[ jj ] <> yes
     3103         then do:
     3104           next .
     3105         end.
     3106         assign
     3107           v_length    = trim( entry( jj, v_list-length ) )
     3108           v_data-type = trim( entry( jj, v_list-types  ) )
     3109         .
     3110         assign
     3111           j_length = integer( v_length )
     3112         no-error .
     3113         case v_data-type :
     3114           when "D":U
     3115           then do:
     3116             assign
     3117               p-print-line = p-print-line + string( bf_print-line.chk-date, "99/99/9999":U ) + ":":U
     3118               p-excel-line = p-excel-line + string( bf_print-line.chk-date, "99/99/9999":U ) + CHR(9)
     3119             .
     3120           end.
     3121           when "T":U
     3122           then do:
     3123             assign
     3124               p-print-line = p-print-line + string( bf_print-line.chk-time, "hh:mm:ss":U ) + ":":U
     3125               p-excel-line = p-excel-line + string( bf_print-line.chk-time, "hh:mm:ss":U ) + CHR(9)
     3126             .
     3127           end.
     3128           when "Z":U
     3129           then do:
     3130             case j_length :
     3131               when 12
     3132               then do:
     3133                 assign
     3134                   p-print-line = p-print-line + " ":U + string( bf_print-line.gds-code, "99999999999":U ) + ":":U
     3135                   p-excel-line = p-excel-line         + string( bf_print-line.gds-code, "99999999999":U ) + CHR(9)
     3136                 .
     3137               end.
     3138             end case.
     3139           end.
     3140           when "C":U
     3141           then do:
     3142             case j_length :
     3143               when 10
     3144               then do:
     3145                 assign
     3146                   p-print-line = p-print-line + string( bf_print-line.artic, "x(10)":U ) + ":":U
     3147                   p-excel-line = p-excel-line + string( bf_print-line.artic, "x(10)":U ) + CHR(9)
     3148                 .
     3149               end.
     3150               when 15
     3151               then
     3152                 do:
     3153                   case jj :
     3154                     when 12
     3155                     then
     3156                       do:
     3157                         assign
     3158                           p-print-line = p-print-line + string( bf_print-line.chk-num, "x(15)":U ) + ":":U
     3159                           p-excel-line = p-excel-line + string( bf_print-line.chk-num, "x(15)":U ) + CHR(9)
     3160                           .
     3161                       end.
     3162                     when 13
     3163                     then
     3164                       do:
     3165                         assign
     3166                           p-print-line = p-print-line + string( bf_print-line.pass-gds, "x(15)":U ) + ":":U
     3167                           p-excel-line = p-excel-line + string( bf_print-line.pass-gds, "x(15)":U ) + CHR(9)
     3168                           .
     3169                       end.
     3170                   end case.
     3171                 end.
     3172               when 17
     3173               then do:
     3174                 case jj :
     3175                   when 2
     3176                   then do:
     3177                     run get-hour-range in this-procedure
     3178                       (
     3179                          input bf_print-line.chk-time
     3180                       , output j_time-top
     3181                       , output j_time-bottom
     3182                       ) .
     3183                     assign
     3184                       p-print-line = p-print-line + string( j_time-top,    "hh:mm:ss":U ) + "-":U
     3185                                                   + string( j_time-bottom, "hh:mm:ss":U ) + ":":U
     3186                       p-excel-line = p-excel-line + string( j_time-top,    "hh:mm:ss":U ) + "-":U
     3187                                                   + string( j_time-bottom, "hh:mm:ss":U ) + CHR(9)
     3188                     .
     3189                   end.
     3190                 end case.
     3191               end.
     3192               when 24
     3193               then do:
     3194                 case jj :
     3195                   when 5
     3196                   then do:
     3197                     assign
     3198                       p-print-line = p-print-line + string( bf_print-line.gds-name, "x(24)":U ) + ":":U
     3199                       p-excel-line = p-excel-line + string( bf_print-line.gds-name, "x(24)":U ) + CHR(9)
     3200                     .
     3201                   end.
     3202                 end case.
     3203               end.
     3204               when 16
     3205               then do:
     3206                 case jj :
     3207                   when 11
     3208                   then do:
     3209                     assign
     3210                       p-print-line = p-print-line + string( bf_print-line.pay-name, "x(16)":U ) + ":":U
     3211                       p-excel-line = p-excel-line + string( bf_print-line.pay-name, "x(16)":U ) + CHR(9)
     3212                     .
     3213                   end.
     3214                 end case.
     3215               end.
     3216               when 12
     3217               then do:
     3218                 case jj :
     3219                     when 14
     3220                     then
     3221                       do:
     3222                         assign
     3223                           p-print-line = p-print-line + "  ":U + string( bf_print-line.doc-num2, "x(9)":U ) + " ":U + ":":U
     3224                           p-excel-line = p-excel-line          + string( bf_print-line.doc-num2, "x(9)":U ) + CHR(9)
     3225                           .
     3226                       end.
     3227                 end case.
     3228               end.
     3229             end case.
     3230           end.
     3231           when "I":U
     3232           then do:
     3233             case jj :
     3234               when 6
     3235               then do:
     3236                 assign
     3237                   p-print-line = p-print-line + "  ":U + string( bf_print-line.pump-code, ">9":U ) + " ":U + ":":U
     3238                   p-excel-line = p-excel-line          + string( bf_print-line.pump-code, ">9":U ) + CHR(9)
     3239                 .
     3240               end.
     3241               when 7
     3242               then do:
     3243                 assign
     3244                   p-print-line = p-print-line + "   ":U + string( bf_print-line.nozzle-code, ">9":U ) + "   ":U + ":":U
     3245                   p-excel-line = p-excel-line           + string( bf_print-line.nozzle-code, ">9":U ) + CHR(9)
     3246                 .
     3247               end.
     3248               when 8
     3249               then do:
     3250                 assign
     3251                   p-print-line = p-print-line + string( bf_print-line.chk-count, ">>>>9":U ) + ":":U
     3252                   p-excel-line = p-excel-line + string( bf_print-line.chk-count, ">>>>9":U ) + CHR(9)
     3253                 .
     3254               end.
     3255                when 15
     3256                then
     3257                   do:
     3258                      assign
     3259                         p-print-line = p-print-line + "  ":U + string( bf_print-line.desk-num, ">>>9":U ) + " ":U + ":":U
     3260                         p-excel-line = p-excel-line          + string( bf_print-line.desk-num, ">>>9":U ) + CHR(9)
     3261                         .
     3262                   end.
     3263             end case.
     3264           end.
     3265           when "Q":U
     3266           then do:
     3267             assign
     3268               p-print-line = p-print-line + string( bf_print-line.base-qnty, "->>>>,>>9.999":U ) + ":":U
     3269               p-excel-line = p-excel-line + string( bf_print-line.base-qnty, "->>>>>>>9.999":U ) + CHR(9)
     3270             .
     3271           end.
     3272           when "S":U
     3273           then do:
     3274             assign
     3275               p-print-line = p-print-line + string( bf_print-line.sum-sale, "->,>>>,>>>,>>>,>>9.99":U ) + ":":U
     3276               p-excel-line = p-excel-line + string( bf_print-line.sum-sale, "->>>>>>>>>>>>>>>>9.99":U ) + CHR(9)
     3277             .
     3278           end.
     3279         end case.
     3280       end.
     3281     end.
     3282   end procedure.
     3283   procedure get-lbl-data :
     3284     define output parameter p-list-label  as character no-undo .
     3285     define output parameter p-list-length as character no-undo .
     3286     define output parameter p-list-types  as character no-undo .
     3287     do
     3288     on error undo, return error return-value
     3289     :
     3290       assign
     3291         p-list-length = "10,8,12,10,24,5,8,5,13,21,16,15,15,12,7":U
     3292         p-list-label  = "Дата,Время,Код товара,Артикул,Наименование товара,№ ТРК,Пистолет,Чеков,Количество,":U +
     3293                         "Сумма продаж,Вид оплаты,Номер чека,Сухой чек,№ заказа,№ кассы":U
     3294         p-list-types  = "D,T,Z,C,C,I,I,I,Q,S,C,C,C,C,I":U
     3295       .
     3296       if num-entries( p-list-length ) <> num-entries( p-list-label ) or
     3297          num-entries( p-list-length ) <> num-entries( p-list-types )
     3298       then do:
     3299         message "Заголовки:"   p-list-label  num-entries( p-list-label  ) skip( 0 )
     3300                 "Длины полей:" p-list-length num-entries( p-list-length ) skip( 0 )
     3301                 "Типы данных:" p-list-types  num-entries( p-list-types  ) skip( 1 )
     3302         view-as alert-box .
     3303         undo, return error "Размерности массивов: заголовков, длин полей и типов данных  НЕ СОВПАДАЮТ." .
     3304       end.
     3305     end.
     3306   end procedure.
     3307   procedure get-indent :
     3308     define  input parameter p-for-column-no as integer   no-undo .
     3309     define output parameter p-indent-length as integer   no-undo initial 0 .
     3310     define output parameter p-text-indent   as character no-undo initial "":U .
     3311     define output parameter p-excel-indent  as character no-undo initial "":U .
     3312     define variable v_list-label  as character no-undo initial "":U .
     3313     define variable v_list-types  as character no-undo initial "":U .
     3314     define variable v_list-length as character no-undo initial "":U .
     3315     define variable v_length      as character no-undo initial "":U .
     3316     define variable j_length      as integer   no-undo initial 0    .
     3317     define variable jj            as integer   no-undo initial 0    .
     3318     do
     3319     on error undo, return error return-value
     3320     :
     3321       run get-lbl-data in this-procedure
     3322         (
     3323           output v_list-label
     3324         , output v_list-length
     3325         , output v_list-types
     3326         ) .
     3327       do jj = 1 to min( num-entries( v_list-length ), p-for-column-no - 1 )
     3328       :
     3329         if use-column[ jj ] <> yes
     3330         then do:
     3331           next .
     3332         end.
     3333         assign
     3334           v_length = trim( entry( jj, v_list-length ) )
     3335         .
     3336         assign
     3337           j_length = integer( v_length )
     3338         no-error .
     3339         assign
     3340           p-indent-length = p-indent-length + j_length + 1
     3341           p-excel-indent  = p-excel-indent  + CHR(9)
     3342         .
     3343       end.
     3344       assign
     3345         p-indent-length = p-indent-length + 1
     3346       .
     3347       assign
     3348         p-text-indent = fill( " ":U, p-indent-length )
     3349       .
     3350     end.
     3351   end procedure.
