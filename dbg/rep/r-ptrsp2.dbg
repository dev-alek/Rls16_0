      148   procedure create_obj-list :
      149      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      150      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      151      do
      152      on error undo, return error return-value
      153      :
      154         define buffer cli-obj for ub.clients .
      155         define variable p-var as integer no-undo .
      156         define buffer buf_obj-list for obj-list .
      157         find last buf_obj-list  use-index pi no-error .
      158         if available buf_obj-list
      159         then
      160            p-var = buf_obj-list.obj-id + 1.
      161         else
      162            p-var = 1.
      163         find first cli-obj where
      164                   cli-obj.obj-type = p-obj-type
      165               and cli-obj.obj-code = p-obj-code
      166         no-lock no-error.
      167         if available cli-obj
      168         then do:
      169            create buf_obj-list.
      170            assign
      171               buf_obj-list.obj-id   = p-var
      172               buf_obj-list.obj-code = cli-obj.obj-code
      173               buf_obj-list.obj-type = cli-obj.obj-type
      174               buf_obj-list.obj-name = cli-obj.obj-name
      175               buf_obj-list.db-num   = cli-obj.db-num
      176            .
      177         end.
      178      end.
      179   end.
