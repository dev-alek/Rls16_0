     1876   FUNCTION Centering RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     1877     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     1878     RUN get-centre-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     1879     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     1880   END FUNCTION.
     1881   PROCEDURE get-centre-string :
     1882     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     1883     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     1884     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     1885     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     1886     DEFINE VARIABLE j-left   AS INTEGER NO-UNDO.
     1887     DO ON ERROR UNDO, RETURN ERROR :
     1888       ASSIGN p-instring = TRIM(   p-instring )
     1889              j-format   = LENGTH( p-instring ).
     1890       IF           j-format > p-length THEN DO:
     1891         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     1892       END. ELSE IF j-format < p-length THEN DO:
     1893         ASSIGN j-left      = INTEGER( ( p-length - ( j-format + 1 ) ) * 0.5 )
     1894                p-outstring = FILL( " ":U, j-left ) + p-instring + FILL( " ":U, p-length - ( j-left + j-format ) ).
     1895       END.                             ELSE DO:
     1896         ASSIGN p-outstring = p-instring.
     1897       END.
     1898     END.
     1899   END PROCEDURE.
     1900   FUNCTION ShiftRight RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     1901     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     1902     RUN get-right-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     1903     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     1904   END FUNCTION.
     1905   PROCEDURE get-right-string :
     1906     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     1907     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     1908     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     1909     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     1910     DO ON ERROR UNDO, RETURN ERROR :
     1911       ASSIGN p-instring = TRIM(   p-instring )
     1912              j-format   = LENGTH( p-instring ).
     1913       IF           j-format > p-length THEN DO:
     1914         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     1915       END. ELSE IF j-format < p-length THEN DO:
     1916         ASSIGN p-outstring = FILL( " ":U, p-length - j-format ) + p-instring.
     1917       END.                             ELSE DO:
     1918         ASSIGN p-outstring = p-instring.
     1919       END.
     1920     END.
     1921   END PROCEDURE.
     1922   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
     1923     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     1924     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
     1925     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
     1926   END FUNCTION.
     1927   PROCEDURE get-sparsed-string :
     1928     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     1929     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     1930     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     1931     DO ON ERROR UNDO, RETURN ERROR :
     1932       DO jj = 1 TO LENGTH( p-instring ) :
     1933         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
     1934       END.
     1935       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
     1936     END.
     1937   END PROCEDURE.
