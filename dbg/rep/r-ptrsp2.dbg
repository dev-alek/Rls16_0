     2760         (
     2761             input  ""
     2762            ,input  8
     2763            ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2764            ,input  7
     2765            ,output v-user-action
     2766            ,output v-printed
     2767         ) .
     2768     end.
     2769     else do:
