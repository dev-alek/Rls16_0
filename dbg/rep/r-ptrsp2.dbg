     2430                                        page-size  value(62) .
     2431     end.
     2432     if XLS-page-num > 1
     2433     then do:
     2434       if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     2435     end.
     2436     assign
     2437       ReportName   = "Почасовая статистика продаж ТРК с детализацией по пистолетам"
     2438       ReportHeader = substitute( "Дата печати: &1, время: &2."
     2439                                , string( t_today, "99.99.9999":U )
