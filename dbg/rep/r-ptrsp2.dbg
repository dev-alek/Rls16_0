     2527                 " ":U
     2528               .
     2529             end.
     2530             put stream text_out unformatted
     2531               fill( "-", 21 )
     2532             .
     2533           end.
     2534           put stream text_out unformatted
     2535             skip
     2536           .
     2537         end.
     2538         if use-column[  9 ] = yes or
     2539            use-column[ 10 ] = yes
     2540         then do:
     2541           if use-column[  9 ] = yes
     2542           then do:
