     2555               v_excel-indent
     2556               string( d_base-qnty, "->>>>>>>9.999":U )
     2557             .
     2558           end.
     2559           if use-column[ 10 ] = yes
     2560           then do:
     2561             if use-column[  9 ] <> yes
