     2364                         + ( if v_total-lines = "":U then "":U else chr(44) )
     2365                         + string( j_row-counter )
     2366         .
     2367       end.
     2368       assign
     2369         j_row-counter = j_row-counter + 1
     2370       no-error.
     2371     end.
     2372     assign
