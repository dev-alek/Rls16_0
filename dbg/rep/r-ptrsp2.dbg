     2590           put stream text_out unformatted
     2591             skip Under_Line skip
     2592           .
     2593           if Make-Excel then  put   stream ForExcel unformatted
     2594             skip
     2595           .
     2596         end.
     2597         assign
     2598           j_hour-from = j_tmp-hour-from
     2599           j_hour-till = j_tmp-hour-till
     2600           t_tmp-date  = tt_line.chk-date
     2601           d_sum-sale  = tt_line.sum-sale
     2602           d_base-qnty = tt_line.base-qnty
     2603         .
