     2809                                               input obj-list.obj-code,
     2810                                               output v-fact-order) no-error.
     2811         end.
     2812       for each gds-list :
     2813         find first ub.gds-obj no-lock where
     2814           ub.gds-obj.gds-code = gds-list.gds-code and
     2815           ub.gds-obj.obj-type = obj-list.obj-type and
     2816           ub.gds-obj.obj-code = obj-list.obj-code no-error .
     2817         if not available ub.gds-obj  then
     2818         do:
     2819           l-error = yes.
     2820           run writelog in this-procedure (v-proc-name-err, 1, substitute("У товара &1 &2 нет продажной цены",gds-list.artic,gds-list.gds-name)).
     2821           next.
     2822         end.
     2823         if ub.gds-obj.price-sale = 0  then
     2824         do:
     2825           l-error = yes.
     2826           run writelog in this-procedure (v-proc-name-err, 1, substitute("У товара &1 &2 нулевая цена продажи",gds-list.artic,gds-list.gds-name)).
     2827           next.
     2828         end.
     2829         run gds-attr-value in this-procedure (
     2830           input gds-list.gds-code
     2831           ,input "image-list"
     2832           ,output v-value
     2833           ,output v-type) no-error.
     2834         if v-value <> "" then
     2835         do:
     2836           if v-val-integer = 1 then
     2837           do:
     2838             Path-To-Dir-Pictures = vPar-val.
     2839           end.
     2840           else
     2841           do:
     2842             Path-To-Dir-Pictures = vPar-val + "\" + string(gds-list.gds-code).
     2843           end.
     2844         end.
     2845         if  p-minpart and not (gds-list.qnty-cart > 0) then
     2846         do:
     2847           l-error = yes.
     2848           run writelog in this-procedure (v-proc-name-err, 1, substitute("У товара &1 &2 не указана минимальная партия",gds-list.artic,gds-list.gds-name)).
     2849           next.
     2850         end.
     2851         if  p-ost and gds-list.qnty-cart > 0 and ub.gds-obj.free-qnty < gds-list.qnty-cart then
     2852         do:
     2853           l-error = yes.
     2854           run writelog in this-procedure (v-proc-name-err, 1, substitute("У товара &1 &2 остаток меньше минимальной партии или мин.партия не указана",gds-list.artic,gds-list.gds-name)).
     2855           next.
     2856         end.
     2857         find first temp-list where
     2858           temp-list.gds-code = ub.gds-obj.gds-code no-error .
     2859         if not available temp-list then
     2860         do:
     2861           if p-ref-rec = "" then v-price = ub.gds-obj.price-sale.
     2862           else
     2863           do:
     2864             for first buf_buyer-group where recid (buf_buyer-group) = int(p-ref-rec):
     2865               run get_price in this-procedure(input ub.gds-obj.obj-type,
     2866                 input ub.gds-obj.obj-code,
     2867                 input buf_buyer-group.bgr-id,
     2868                 input buf_buyer-group.bgr-db-num,
     2869                 input ub.gds-obj.gds-code,
     2870                 input v-fact-order,
     2871                 output v-price).
     2872               if v-price = 0 then
     2873               do:
     2874                 l-error = yes.
     2875                 run writelog in this-procedure (v-proc-name-err, 1, substitute("У товара &1 &2 нулевая цена продажи",gds-list.artic,gds-list.gds-name)).
     2876                 next.
     2877               end.
     2878             end.
     2879           end.
     2880           run gbl/newbase.p
     2881             (input ub.gds-obj.gds-code
     2882             ,input 16
     2883             ,output HexStr
     2884             ).
     2885           create temp-list.
     2886           case p-sort-type :
     2887             when "sort-name" then
     2888               do:
     2889                 temp-list.f-sort          = gds-list.gds-name .
     2890               end.
     2891             when "sort-code" then
     2892               do:
     2893                 temp-list.f-sort          = string(ub.gds-obj.gds-code, "9999999999999999").
     2894               end.
     2895             when "sort-artic" then
     2896               do:
     2897                 temp-list.f-sort          = ub.gds-obj.artic.
     2898               end.
     2899           end case.
     2900           assign
     2901             temp-list.gds-code   = ub.gds-obj.gds-code
     2902             temp-list.artic      = ub.gds-obj.artic
     2903             temp-list.gds-name   = gds-list.gds-name
     2904             temp-list.price-sale = v-price
     2905             temp-list.min-part   = if gds-list.qnty-cart = 0 then  ""  else string(gds-list.qnty-cart)
     2906             temp-list.f-name     = if v-value > '' then  substitute("&1\&2" ,Path-To-Dir-Pictures, entry(1,v-value) ) else ''
     2907             .
     2908             if search(temp-list.f-name) = ? then temp-list.f-name = ''.
     2909   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2910     (input  ub.gds-obj.gds-code
     2911     ,input  ?
     2912     ,output v-b-code
     2913     )  .
     2914           temp-list.b-code = v-b-code.
     2915           run gen-bc in this-procedure
     2916             ( input v-b-code
     2917             ,output v-ean
     2918             ).
     2919           temp-list.big-code = v-ean.
     2920         end.
     2921       end.
     2922     end.
     2923     if l-error = yes then
     2924       message "Не все товары попали в прайс-лист." skip
     2925       substitute("Подробности в файле &1",v-proc-name-err) view-as alert-box warning.
     2926     else os-delete value(v-proc-name-err).
     2927      make-excel = true .
     2928      os-delete value( string( session:temp-directory ) +
     2929                                 "rpt" + string( g#report-num ) + ".txt":u ) .
     2930      output stream forexcel to value( string( session:temp-directory ) +
     2931                                 "rpt" + string( g#report-num ) + ".txt":u ) .
     2932   reportheader =  "".
     2933   reportname   =  "".
     2934   str1 =  "".
     2935   str2 =  "".
     2936   str3 =  "".
     2937   str4 =  "".
     2938   run rep/extitle.p (1) no-error .
     2939   if error-status :error then message
     2940     vss-workfile vss-revision vss-description skip
     2941     error-status :get-message(1) skip
     2942     return-value skip
     2943     ""
     2944     view-as alert-box error
     2945   .
     2946   Sheetf.Bas-Params =
     2947         p-name            + chr(4) +
     2948         p-dostavka        + chr(4) +
     2949         p-telefon-1       + chr(4) +
     2950         p-telefon-2       + chr(4) +
     2951         p-info            + chr(4) +
     2952         p-orderinfo       + chr(4) +
     2953         p-action          + chr(4) +
     2954         p-skidki          + chr(4) +
     2955         p-skidki-2        + chr(4) +
     2956         p-skidki-3        + chr(4) +
     2957         p-skidki-4        + chr(4) +
     2958         p-skidki-5        + chr(4) +
     2959         p-skidki-6        + chr(4) +
     2960         p-skidki-7        + chr(4) +
     2961         p-skidki-8        + chr(4) +
     2962         string(p-colsize) + chr(4) +
     2963         p-hot             + chr(4) +
     2964         v-dircode1        + chr(4) +
     2965         v-dircode2
     2966         .
     2967           for each  temp-list break by temp-list.f-sort :
     2968             if Make-Excel then  put   stream ForExcel unformatted
     2969               temp-list.artic  CHR(9)
     2970               temp-list.b-code    CHR(9)
     2971               temp-list.gds-name  CHR(9)
     2972               temp-list.price-sal CHR(9)
     2973               temp-list.min-part  CHR(9)
     2974               temp-list.f-name    CHR(9)
     2975               chr(10)
     2976               .
     2977           end.
     2978   if session:set-wait-state("") then.
     2979    if Make-Excel then output stream ForExcel close.
     2980    run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     2981   os-delete value( string( session:temp-directory ) +
     2982                              "rpt" + string( g#report-num ) + ".txt":u ) .
     2983   procedure get_price:
     2984   define input parameter p-obj-type as character no-undo.
     2985   define input parameter p-obj-code as integer no-undo.
     2986   define input parameter p-bgr-id as integer no-undo.
     2987   define input parameter p-bgr-db-num as integer no-undo.
     2988   define input parameter p-gds-code as integer no-undo.
     2989   define input parameter p-fact-order as decimal no-undo.
     2990   define output parameter p-price-sale as decimal no-undo.
     2991   define variable v-root-b-code as integer no-undo.
     2992   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2993     (input  p-gds-code
     2994     ,input  ?
     2995     ,output v-root-b-code
     2996     ) no-error .
     2997   for first buf_price-all no-lock use-index by_fact-order where
     2998       buf_price-all.obj-type = p-obj-type and
     2999       buf_price-all.obj-code = p-obj-code and
     3000       buf_price-all.main-indication = 0 and
     3001       buf_price-all.b-code = v-root-b-code and
     3002       buf_price-all.bgr-id = p-bgr-id and
     3003       buf_price-all.bgr-db-num = p-bgr-db-num and
     3004       ((buf_price-all.fact-order-sys-from = 0) or (buf_price-all.fact-order-sys-from <= p-fact-order)) and
     3005       ((buf_price-all.fact-order-sys-to = 0) or (buf_price-all.fact-order-sys-to >= p-fact-order))
     3006       by buf_price-all.fact-order descending:
     3007           p-price-sale = buf_price-all.price-sale.
     3008   end.
     3009   end procedure.
