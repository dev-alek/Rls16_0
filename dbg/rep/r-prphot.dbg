     2051   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2052       def var log-file-name as char no-undo.
     2053       assign
     2054           log-file-name = v-proc-name-err
     2055       .
     2056       if log-file-name <> "":U
     2057       then do:
     2058           if search( v-proc-name-err ) = ?
     2059           then do:
     2060               output to value( v-proc-name-err ).
     2061               output close.
     2062           end.
     2063       end.
     2064       DEF STREAM stm-log.
     2065       PROCEDURE writelog:
     2066       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     2067       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     2068       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     2069       if p-file-name <> ""
     2070       then do:
     2071       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     2072           PUT STREAM stm-log UNFORMATTED chr(10).
     2073           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     2074                                           OR p-log-string = "&Line") THEN "" ELSE
     2075                                           cur-time-string-sec() + " ").
     2076           PUT STREAM stm-log UNFORMATTED
     2077                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     2078                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     2079                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     2080       OUTPUT STREAM stm-log CLOSE.
     2081       end.
     2082       END PROCEDURE.
     2083   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     2084     if num-entries(string(p-dec), '.') = 2
     2085       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     2086       else return( string(p-dec)) .
     2087   end function.
     2088   function format-point-to-comma returns char (input orig as char ) .
     2089   define variable rtext as character no-undo .
     2090   define variable strt as integer no-undo .
     2091   define variable leng as integer no-undo .
     2092   assign rtext = orig .
     2093   repeat:
     2094     strt =  index(rtext,'.').
     2095     if strt = 0 then leave.
     2096     leng = 1.
     2097     substring(rtext,strt,leng,"character") = v-delim .
     2098   end.
     2099   return rtext.
     2100   end function.
     2101   function format-excel-text returns char ( input start-text as char ) :
     2102   def var  i    as int no-undo.
     2103   def var  ch   as char no-undo.
     2104   def var  n    as int no-undo.
     2105   def var  ipos as int no-undo.
     2106     n = num-entries(trim(start-text), chr(10)) - 1 .
     2107     do i = 1 to n :
     2108       ipos = index( start-text, chr(10)).
     2109       if ipos > 0 then
     2110         substr( start-text, ipos, 1 ) = ' '.
     2111     end.
     2112     n = num-entries(trim(start-text), chr(13)) - 1 .
     2113     do i = 1 to n :
     2114       ipos = index( start-text, chr(13)).
     2115       if ipos > 0 then
     2116         substr( start-text, ipos, 1 ) = ' '.
     2117     end.
     2118     if index( start-text, '"' ) = 0 then
     2119       start-text =  '="'   + trim( start-text) + '"'   .
     2120       else do:
     2121         n = num-entries(trim(start-text), '"') - 1.
     2122         do i = 1 to n :
     2123           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2124         end.
     2125         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2126         start-text = '="'  + ch  + '"' .
     2127       end.
     2128     return start-text.
     2129   end.
     2130   function excel-sum returns char (input p-dec as decimal ).
     2131     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     2132   end function.
     2133   function excel-qnty returns char (input p-dec as decimal ).
     2134     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     2135   end function.
     2136   function format-excel-text-macr returns char ( input start-text as char ) :
     2137   def var  i    as int no-undo.
     2138   def var  ch   as char no-undo.
     2139   def var  n    as int no-undo.
     2140   def var  ipos as int no-undo.
     2141     n = num-entries(trim(start-text), chr(10)) - 1 .
     2142     do i = 1 to n :
     2143       ipos = index( start-text, chr(10)).
     2144       if ipos > 0 then
     2145         substring( start-text, ipos , 1 ) = ' '.
     2146     end.
     2147     n = num-entries(trim(start-text), chr(13)) - 1 .
     2148     do i = 1 to n :
     2149       ipos = index( start-text, chr(13)).
     2150       if ipos > 0 then
     2151         substring( start-text, ipos, 1 ) = ' '.
     2152     end.
     2153     if index( start-text, '"' ) = 0 then
     2154       start-text =  '"'   + trim( start-text) + '"'   .
     2155       else do:
     2156         n = num-entries(trim(start-text), '"') - 1.
     2157         do i = 1 to n :
     2158           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2159         end.
     2160         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2161         start-text = '"'  + ch  + '"' .
     2162       end.
     2163     n = num-entries(trim(start-text), chr(10)) - 1 .
     2164     do i = 1 to n :
     2165       ipos = index( start-text, chr(10)).
     2166       if ipos > 0 then
     2167         substring( start-text, ipos , 1 ) = ' '.
     2168     end.
     2169       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     2170     return start-text.
     2171   end.
