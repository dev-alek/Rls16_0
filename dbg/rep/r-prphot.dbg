      779   procedure cur-time :
      780      define output parameter p-today as date      no-undo .
      781      define output parameter p-time  as integer   no-undo .
      782     do
      783     on error undo, return error
      784     :
      785       define variable v-date1 as date      no-undo .
      786       define variable v-date2 as date      no-undo .
      787       define variable v-time  as integer   no-undo .
      788       assign
      789         v-date1 = today
      790         v-time  = time
      791         v-date2 = today
      792       .
      793       if v-date1 <> v-date2
      794       then do:
      795         assign
      796           v-date1 = today
      797           v-time  = v-time
      798         .
      799       end.
      800       assign
      801         p-today = v-date1
      802         p-time  = v-time
      803       .
      804     end.
      805   end.
      806   function cur-time-date returns character
      807   :
      808     return string(today, '99/99/9999':U) .
      809   end.
      810   function cur-time-mjd returns decimal
      811   :
      812     define variable v-date as date      no-undo .
      813     define variable v-time as integer   no-undo .
      814     run cur-time in this-procedure
      815       (output v-date
      816       ,output v-time
      817       ) .
      818     return integer(v-date) - 2400002 + (v-time / 86400) .
      819   end.
      820   function cur-time-get-ending-index returns integer
      821   (input p-number as integer
      822   )
      823   :
      824     if p-number < 0
      825     or p-number = ?
      826     then do:
      827       return 1 .
      828     end.
      829     define variable v-rest as integer   no-undo .
      830     assign
      831       p-number = p-number modulo 100
      832     .
      833     if p-number < 20
      834     then do:
      835       assign
      836         v-rest = p-number
      837       .
      838     end.
      839     else do:
      840       assign
      841         v-rest = p-number modulo 10
      842       .
      843     end.
      844     case v-rest :
      845       when 1
      846       then do:
      847         return 2 .
      848       end.
      849       when 2 or
      850       when 3 or
      851       when 4
      852       then do:
      853         return 3 .
      854       end.
      855       otherwise do:
      856         return 1 .
      857       end.
      858     end case .
      859   end.
      860   procedure cur-time-mjd-to-date :
      861      define input  parameter i-mjd-diff as decimal no-undo.
      862      define output parameter o-Date     as date    no-undo.
      863      define output parameter o-Time     as integer no-undo.
      864      define variable v-day-number as integer   no-undo .
      865      if    i-mjd-diff < 0
      866         or i-mjd-diff = ?
      867      then do:
      868         return "?" .
      869      end.
      870      assign
      871         v-day-number = truncate(i-mjd-diff,0).
      872         o-Date = date(v-day-number + 2400002).
      873         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      874     .
      875   end.
      876   function cur-time-mjd-to-string returns character
      877   (input p-mjd-diff as decimal
      878   )
      879   :
      880     define variable v-day-number as integer   no-undo .
      881     define variable v-seconds    as integer   no-undo .
      882     define variable v-hour       as integer   no-undo .
      883     define variable v-min        as integer   no-undo .
      884     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      885     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      886     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      887     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      888     if p-mjd-diff < 0
      889     or p-mjd-diff = ?
      890     then do:
      891       return "?" .
      892     end.
      893     assign
      894       v-day-number = integer(truncate(p-mjd-diff,0))
      895       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      896     .
      897     if v-seconds > 86400
      898     then do:
      899       assign
      900         v-seconds = 86400 - 1
      901       .
      902     end.
      903     if v-seconds < 0
      904     then do:
      905       assign
      906         v-seconds = 0
      907       .
      908     end.
      909     assign
      910       v-hour = truncate(v-seconds / 3600, 0)
      911     .
      912     assign
      913       v-seconds = v-seconds modulo 3600
      914     .
      915     assign
      916       v-min = truncate(v-seconds / 60, 0)
      917     .
      918     assign
      919       v-seconds = v-seconds modulo 60
      920     .
      921     return
      922         (if v-day-number <> 0
      923           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      924           else ""
      925         )
      926       + (if v-day-number <> 0 or v-hour <> 0
      927           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      928           else ""
      929         )
      930       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      931           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      932           else ""
      933         )
      934       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      935       .
      936   end.
      937   function cur-time-string returns character
      938   :
      939     define variable v-date as date      no-undo .
      940     define variable v-time as integer   no-undo .
      941     run cur-time in this-procedure
      942       (output v-date
      943       ,output v-time
      944       ) .
      945     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      946   end.
      947   function cur-time-string-sec returns character
      948   :
      949     define variable v-date as date      no-undo .
      950     define variable v-time as integer   no-undo .
      951     run cur-time in this-procedure
      952       (output v-date
      953       ,output v-time
      954       ) .
      955     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      956   end.
      957   function cur-time-custom  returns character
      958   (input p-prefix as character
      959   ,input p-date-format as character
      960   ,input p-delimiter as character
      961   ,input p-time-format as character
      962   ,input p-suffix as character
      963   )
      964   :
      965     define variable v-date as date      no-undo .
      966     define variable v-time as integer   no-undo .
      967     run cur-time in this-procedure
      968       (output v-date
      969       ,output v-time
      970       ) .
      971     return
      972       p-prefix
      973       + string(v-date, p-date-format)
      974       + p-delimiter
      975       + string(v-time, p-time-format)
      976       + p-suffix
      977       .
      978   end.
      979   function cur-time-print  returns character
      980   :
      981     define variable v-date as date      no-undo .
      982     define variable v-time as integer   no-undo .
      983     run cur-time in this-procedure
      984       (output v-date
      985       ,output v-time
      986       ) .
      987     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      988   end.
      989   function cur-time-datetime returns datetime
      990   :
      991     define variable v-char as character no-undo .
      992     define variable v-datetime as datetime no-undo .
      993     v-char = cur-time-string().
      994     v-datetime = datetime(v-char).
      995     return  v-datetime.
      996   end.
      997   function cur-time-string-msec returns character
      998   :
      999     define variable v-date as datetime  no-undo .
     1000     v-date = now.
     1001     return string(v-date) .
     1002   end.
     1003   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1004   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1005   procedure paramls-clear :
     1006     define buffer buf_temp-param for temp-param .
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       for each buf_temp-param
     1011       on error undo, return error
     1012       :
     1013         delete buf_temp-param .
     1014       end.
     1015     end.
     1016   end procedure.
     1017   procedure paramls-write :
     1018     define input  parameter p-code     as character no-undo .
     1019     define input  parameter p-sub-code as character no-undo .
     1020     define input  parameter p-value    as character no-undo .
     1021     define buffer buf_temp-param for temp-param .
     1022     do
     1023     on error undo, return error return-value
     1024     :
     1025       find first buf_temp-param
     1026         where buf_temp-param.param-code     = p-code
     1027           and buf_temp-param.param-sub-code = p-sub-code
     1028         no-error .
     1029       if not available buf_temp-param then do:
     1030         create buf_temp-param .
     1031         assign
     1032           buf_temp-param.param-code     = p-code
     1033           buf_temp-param.param-sub-code = p-sub-code
     1034         .
     1035       end.
     1036       assign
     1037         buf_temp-param.param-value = p-value
     1038       .
     1039     end.
     1040   end procedure.
     1041   procedure paramls-read :
     1042     define input  parameter p-code          as character no-undo .
     1043     define input  parameter p-sub-code      as character no-undo .
     1044     define input  parameter p-default-value as character no-undo .
     1045     define output parameter p-value         as character no-undo .
     1046     define buffer buf_temp-param for temp-param .
     1047     do
     1048     on error undo, return error return-value
     1049     :
     1050       find first buf_temp-param
     1051         where buf_temp-param.param-code     = p-code
     1052           and buf_temp-param.param-sub-code = p-sub-code
     1053         no-error .
     1054       if available buf_temp-param then do:
     1055         assign
     1056           p-value = buf_temp-param.param-value
     1057         .
     1058       end.
     1059       else do:
     1060         assign
     1061           p-value = p-default-value
     1062         .
     1063       end.
     1064     end.
     1065   end procedure.
     1066   procedure paramls-append :
     1067     define input  parameter p-code     as character no-undo .
     1068     define input  parameter p-sub-code as character no-undo .
     1069     define input  parameter p-value    as character no-undo .
     1070     define buffer buf_temp-param for temp-param .
     1071     do
     1072     on error undo, return error return-value
     1073     :
     1074       find first buf_temp-param
     1075            where buf_temp-param.param-code     = p-code
     1076              and buf_temp-param.param-sub-code = p-sub-code
     1077         no-error .
     1078       if not available buf_temp-param then do:
     1079         create buf_temp-param .
     1080         assign
     1081           buf_temp-param.param-code     = p-code
     1082           buf_temp-param.param-sub-code = p-sub-code
     1083           buf_temp-param.param-value    = p-value
     1084         .
     1085       end.
     1086       else do:
     1087           assign
     1088               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1089           .
     1090       end.
     1091     end.
     1092   end procedure.
     1093   define temp-table temp-font no-undo
     1094     field fontnum  as integer
     1095     field fontname as character
     1096     field fontsize as character
     1097     field fonttype as character
     1098     field font-h   as integer
     1099     field font-w   as integer
     1100     field v-row    as integer
     1101     field v-col    as integer
     1102     field v-row-lans as integer
     1103     field v-col-lans as integer
     1104   index pi fontnum
     1105   .
     1106   procedure get-font-ini :
     1107     do
     1108     on error undo, return error return-value
     1109     :
     1110   define variable ii as integer   no-undo .
     1111   define variable v-font7 as character no-undo .
     1112   define variable v-font as character no-undo .
     1113   define variable loc-name as character no-undo .
     1114   define variable loc-size as character no-undo .
     1115   define variable loc-type as character no-undo .
     1116   define variable old_H as integer   no-undo .
     1117   define variable old_w as integer   no-undo .
     1118   define variable old-row  as integer   no-undo .
     1119   define variable old-col  as integer   no-undo .
     1120   define variable old-row-lans  as integer   no-undo .
     1121   define variable old-col-lans  as integer   no-undo .
     1122   define variable vv as integer   no-undo .
     1123   empty temp-table temp-font.
     1124     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1125       case num-entries (v-font7) :
     1126         when 4 then do:
     1127             assign
     1128               loc-name = entry ( 1 , v-font7 )
     1129               loc-size = entry ( 2 , v-font7 )
     1130               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1131             .
     1132         end.
     1133         when 3 then do:
     1134             assign
     1135               loc-name = entry ( 1 , v-font7 )
     1136               loc-size = entry ( 2 , v-font7 )
     1137               loc-type = entry ( 3 , v-font7 )
     1138             .
     1139         end.
     1140         when 2 then  do:
     1141             assign
     1142               loc-name = entry ( 1 , v-font7 )
     1143               loc-size = entry ( 2 , v-font7 )
     1144               loc-type = ""
     1145             .
     1146         end.
     1147         when 1 then do:
     1148             assign
     1149               loc-name = trim(entry ( 1 , v-font7 ))
     1150               loc-size = ""
     1151               loc-type = ""
     1152             .
     1153         end.
     1154       end case.
     1155     create temp-font.
     1156     assign
     1157       temp-font.fontnum  = 7
     1158       temp-font.fontname = trim(loc-name)
     1159       temp-font.fontsize = trim(loc-size)
     1160       temp-font.fonttype = trim(loc-type)
     1161       temp-font.v-row    = 62
     1162       temp-font.v-col    = 136
     1163       temp-font.v-row-lans = 43
     1164       temp-font.v-col-lans = 198
     1165     .
     1166     repeat ii = 16 to 100 :
     1167       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1168       if v-font = "" or v-font = ? then leave.
     1169       case num-entries (v-font) :
     1170         when 4 then do:
     1171             assign
     1172               loc-name = entry ( 1 , v-font )
     1173               loc-size = entry ( 2 , v-font )
     1174               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1175             .
     1176         end.
     1177         when 3 then do:
     1178             assign
     1179               loc-name = entry ( 1 , v-font )
     1180               loc-size = entry ( 2 , v-font )
     1181               loc-type = entry ( 3 , v-font )
     1182             .
     1183         end.
     1184         when 2 then do:
     1185             assign
     1186               loc-name = entry ( 1 , v-font )
     1187               loc-size = entry ( 2 , v-font )
     1188               loc-type = ""
     1189             .
     1190         end.
     1191         when 1 then do:
     1192             assign
     1193               loc-name = trim(entry ( 1 , v-font ))
     1194               loc-size = ""
     1195               loc-type = ""
     1196             .
     1197         end.
     1198       end case.
     1199     create temp-font.
     1200     assign
     1201       temp-font.fontnum  = ii
     1202       temp-font.fontname = trim(loc-name)
     1203       temp-font.fontsize = trim(loc-size)
     1204       temp-font.fonttype = trim(loc-type)
     1205     .
     1206     end.
     1207       for each temp-font :
     1208          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1209          if  vv = ? then vv =  0 .
     1210           run rep/exfont.p (
     1211             input   temp-font.fontname ,
     1212             input   vv ,
     1213             input   temp-font.fonttype ,
     1214             output  temp-font.font-h   ,
     1215             output  temp-font.font-w   )
     1216           .
     1217       end.
     1218   find first temp-font where  temp-font.fontnum  = 7  .
     1219   old_H = temp-font.font-H .
     1220   old_w = temp-font.font-W .
     1221   old-row = temp-font.v-row .
     1222   old-col = temp-font.v-col .
     1223   old-row-lans = temp-font.v-row-lans .
     1224   old-col-lans = temp-font.v-col-lans .
     1225       for each temp-font where
     1226                temp-font.fontnum  <> 7 :
     1227           assign
     1228               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1229               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1230               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1231               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1232           .
     1233       end.
     1234     end.
     1235   end procedure.
     1236   PROCEDURE How-name :
     1237   define input  parameter h as integer no-undo .
     1238   define input  parameter w as integer no-undo .
     1239   define output parameter n as character  no-undo .
     1240   define variable A4port-H as integer   no-undo init 63.
     1241   define variable A4port-W as integer   no-undo init 136.
     1242   define variable A4lans-H as integer   no-undo init 43.
     1243   define variable A4lans-W as integer   no-undo init 198.
     1244   define variable Strim-W  as integer   no-undo init 278.
     1245   run define-a4-size (
     1246        input ReportFontNum
     1247       ,output A4port-H
     1248       ,output A4port-W
     1249       ,output A4lans-H
     1250       ,output A4lans-W ).
     1251   If w >= 1 and w <= A4port-W Then DO:
     1252     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1253     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1254     If h > A4port-H              Then n = "to-file":U.
     1255   End.
     1256   If w > A4port-W and w <= A4lans-W Then DO:
     1257     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1258     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1259     If h > A4port-H              Then n = "to-file":U.
     1260   End.
     1261   If w > A4lans-W and w <= Strim-W Then DO:
     1262     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1263     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1264     If h > A4port-H              Then n = "to-file":U.
     1265   End.
     1266   If w > Strim-W Then DO:
     1267      n = "to-file":U.
     1268   End.
     1269   END PROCEDURE.
     1270   PROCEDURE define-a4-size :
     1271   define input  parameter p-ReportFontNum as integer   no-undo .
     1272   define output parameter A4port-H as integer   no-undo .
     1273   define output parameter A4port-W as integer   no-undo .
     1274   define output parameter A4lans-H as integer   no-undo .
     1275   define output parameter A4lans-W as integer   no-undo .
     1276   if not can-find (first temp-font ) then do:
     1277      run get-font-ini .
     1278   end.
     1279   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1280   if available temp-font then do:
     1281   assign
     1282     A4port-H = temp-font.v-row
     1283     A4port-W = temp-font.v-col
     1284     A4lans-H = temp-font.v-row-lans
     1285     A4lans-W = temp-font.v-col-lans
     1286   .
     1287   end.
     1288   else do:
     1289   assign
     1290     A4port-H = 63
     1291     A4port-W = 136
     1292     A4lans-H = 43
     1293     A4lans-W = 198
     1294   .
     1295   end.
     1296   END PROCEDURE.
     1297   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1298   PROCEDURE verify-ini-entry:
     1299   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1300   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1301   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1302   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1303   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1304   define variable v-mess as character no-undo .
     1305   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1306   if ini-entry-value = ? and ini-key-name begins "spl"
     1307   then
     1308   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1309   if ini-entry-value = ? and ini-key-name begins "sav"
     1310   then
     1311   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1312   if ini-entry-value = ? then do:
     1313     assign
     1314     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1315                       , chr(10)
     1316                       , ini-section-name
     1317                       , ini-key-name
     1318                       , error-msg-text).
     1319       if not silence then do:
     1320         message
     1321         v-mess
     1322         view-as alert-box ERROR  .
     1323         return error.
     1324       end.
     1325       else do:
     1326         return error v-mess.
     1327       end.
     1328   end.
     1329   END PROCEDURE.
     1330   PROCEDURE verify-file:
     1331   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1332   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1333   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1334   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1335   file-info:file-name = filename.
     1336   found = NOT (file-info:full-pathname = ?).
     1337   if NOT found  then do:
     1338     if not silence then do:
     1339       message error-msg-text
     1340       view-as alert-box ERROR.
     1341       return error.
     1342     end.
     1343     else return error error-msg-text.
     1344   end.
     1345   END PROCEDURE.
     1346   def new shared var bc-frmt as character no-undo .
     1347   def new shared var bc-pfx  as character no-undo .
     1348   def var bc-par-type as character no-undo .
     1349       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
     1350       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
     1351           do:
     1352               message "Не задан или не верно задан ТИП собственного бар-кода!"
     1353                   view-as alert-box ERROR TITLE "".
     1354               return error.
     1355           end.
     1356       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
     1357       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
     1358           do:
     1359               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
     1360                   view-as alert-box ERROR TITLE "".
     1361               return error.
     1362           end.
     1363   PROCEDURE gen-bc:
     1364     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
     1365     def output parameter full-b-code     as character init ""    no-undo .
     1366   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1367     define variable tmp-str17  as character no-undo.
     1368     define variable tmp-num17  as character no-undo.
     1369     define variable i17        as integer   no-undo.
     1370     define variable sum17      as integer   no-undo.
     1371     define variable len-code17 as integer   no-undo.
     1372     define variable varcont17  as logical   initial yes no-undo.
     1373     CASE bc-frmt :
     1374       WHEN "EAN13" THEN do:
     1375         assign
     1376           tmp-str17 = string( internal-b-code, "999999999999" )
     1377         .
     1378       end.
     1379       WHEN "EAN8" THEN do:
     1380         assign
     1381           tmp-str17 = string( internal-b-code, "9999999" )
     1382         .
     1383       end.
     1384       OTHERWISE DO:
     1385           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
     1386           view-as alert-box error.
     1387           return error.
     1388       END.
     1389     END CASE.
     1390     if varcont17 = yes then do:
     1391       if integer( substring( tmp-str17, 1, length( bc-pfx ) ) ) <> 0
     1392       then do:
     1393         message
     1394           "Невозможно сформировать бар-код" SKIP
     1395           "для товара с кодом: " internal-b-code
     1396           view-as alert-box error title "подрезание кода".
     1397         return error.
     1398       end.
     1399       else do:
     1400         assign
     1401           full-b-code = bc-pfx + substring( tmp-str17, length( bc-pfx ) + 1, length( tmp-str17 ) - length( bc-pfx ) )
     1402           len-code17    = length( full-b-code )
     1403         .
     1404         define variable v-sum-char17 as character no-undo .
     1405         assign
     1406           sum17 = 0
     1407         .
     1408         do i17 = 1 to len-code17 by 2
     1409         :
     1410           assign
     1411             v-sum-char17 = substr(full-b-code, len-code17 - i17 + 1, 1)
     1412           .
     1413           if v-sum-char17 < "0"
     1414           or v-sum-char17 > "9"
     1415           then do:
     1416             message
     1417               "Невозможно сформировать бар-код" skip
     1418               "для товара с кодом: " internal-b-code skip
     1419               view-as alert-box error title "подсчет контрольной суммы".
     1420             return error.
     1421           end.
     1422           assign
     1423             sum17 = sum17 + integer(v-sum-char17)
     1424           .
     1425         end.
     1426         if varcont17 = yes then do:
     1427           assign
     1428             sum17 = sum17 * 3
     1429           .
     1430           do i17 = 2 to len-code17 by 2
     1431           :
     1432             assign
     1433               v-sum-char17 = substr(full-b-code, len-code17 - i17 + 1, 1)
     1434             .
     1435             if v-sum-char17 < "0"
     1436             or v-sum-char17 > "9"
     1437             then do:
     1438               message
     1439                 "Невозможно сформировать бар-код" skip
     1440                 "для товара с кодом: " internal-b-code skip
     1441                 view-as alert-box error title "подсчет контрольной суммы".
     1442               return error.
     1443             end.
     1444             assign
     1445               sum17 = sum17 + integer(v-sum-char17)
     1446             .
     1447           end.
     1448           if varcont17 = yes then do:
     1449              if sum17 mod 10 = 0 then do:
     1450                assign
     1451                  full-b-code = full-b-code + '0'
     1452                .
     1453              end.
     1454              else do:
     1455                assign
     1456                  full-b-code = full-b-code + string(10 - sum17 mod 10)
     1457                .
     1458              end.
     1459           end.
     1460         end.
     1461       end.
     1462     end.
     1463   END PROCEDURE.
     1464   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1466   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1467   procedure factord :
     1468     define input  parameter p-fact-date            as date    no-undo .
     1469     define input  parameter p-fact-time            as integer no-undo .
     1470     define input  parameter p-fact-num             as integer no-undo .
     1471     define input  parameter p-shift-date           as date    no-undo .
     1472     define input  parameter p-shift-num            as integer no-undo .
     1473     define input  parameter p-shift-on             as logical no-undo .
     1474     define output parameter p-fact-order           as decimal no-undo .
     1475     define output parameter p-shift-end-fact-order as decimal no-undo .
     1476     define output parameter p-day-end-fact-order   as decimal no-undo .
     1477     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1478     if p-fact-date = ?
     1479     then do:
     1480       return error "Не указана фактическая дата" .
     1481     end.
     1482     define variable v-fact-date-num as integer no-undo .
     1483     assign
     1484       v-fact-date-num = integer(p-fact-date)
     1485     .
     1486     if p-fact-num = ?
     1487     or p-fact-num = 0
     1488     then do:
     1489       return error "Не задан p-fact-num " + string(p-fact-num) .
     1490     end.
     1491     if p-fact-num < 0
     1492     then do:
     1493       return error "Отрицательный fact-num " + string(p-fact-num) .
     1494     end.
     1495     if p-fact-num >= 100000000
     1496     then do:
     1497       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1498     end.
     1499     if p-shift-on = true
     1500     then do:
     1501       if p-shift-date = ?
     1502       then do:
     1503         return error "Не задана дата смены" .
     1504       end.
     1505       if p-shift-num = ?
     1506       or p-shift-num = 0
     1507       then do:
     1508         return error "Не задан номер смены" .
     1509       end.
     1510     end.
     1511     else do:
     1512       assign
     1513         p-shift-date = p-fact-date
     1514         p-shift-num  = 24
     1515       .
     1516     end.
     1517     define variable v-shift-offset as integer no-undo .
     1518     if p-shift-date = p-fact-date
     1519     then do:
     1520       assign
     1521         v-shift-offset = 1
     1522       .
     1523     end.
     1524     if p-shift-date < p-fact-date
     1525     then do:
     1526       assign
     1527         v-shift-offset = 0
     1528       .
     1529     end.
     1530     if p-shift-date > p-fact-date
     1531     then do:
     1532       message
     1533         vss-workfile vss-revision vss-description skip
     1534         "Неправильная дата закрытия смены" skip
     1535         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1536         view-as alert-box error .
     1537       undo, return error
     1538         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1539           ,string(p-fact-date, '99/99/9999':U)
     1540           ,string(p-shift-date, '99/99/9999':U)
     1541           )
     1542       .
     1543     end.
     1544     if p-shift-num < 1
     1545     or p-shift-num > 24
     1546     then do:
     1547       message
     1548         vss-workfile vss-revision vss-description skip
     1549         "Неправильный номер смены" skip
     1550         "p-shift-num" p-shift-num skip
     1551         view-as alert-box error .
     1552       undo, return error return-value .
     1553     end.
     1554     assign
     1555       p-fact-order           = v-fact-date-num
     1556                              + v-shift-offset * 0.5
     1557                              + p-shift-num    * 0.02 - 0.01
     1558                              + p-fact-num     * 0.0000000001
     1559       p-shift-end-fact-order = v-fact-date-num
     1560                              + v-shift-offset * 0.5
     1561                              + p-shift-num    * 0.02
     1562       p-day-end-fact-order   = v-fact-date-num
     1563                              + 0.99
     1564     .
     1565     if p-fact-order           <= v-fact-date-num
     1566     or p-shift-end-fact-order <= v-fact-date-num
     1567     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1568     or p-shift-end-fact-order >= p-day-end-fact-order
     1569     then do:
     1570       message
     1571         vss-workfile vss-revision vss-description skip
     1572         "Внутренняя ошибка при генерации фактического номера" skip
     1573         "p-fact-date"            p-fact-date            skip
     1574         "p-fact-time"            p-fact-time            skip
     1575         "p-fact-num"             p-fact-num             skip
     1576         "p-shift-date"           p-shift-date           skip
     1577         "p-shift-num"            p-shift-num            skip
     1578         "p-shift-on"             p-shift-on             skip
     1579         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1580         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1581         "v-fact-date-num"        v-fact-date-num        skip
     1582         view-as alert-box error .
     1583       undo, return error return-value .
     1584     end.
     1585   end procedure.
     1586   procedure day-begin-fact-order :
     1587     define input  parameter p-fact-date            as date    no-undo .
     1588     define output parameter p-day-begin-fact-order as decimal no-undo .
     1589     do
     1590     on error undo, return error return-value
     1591     :
     1592       if p-fact-date = ?
     1593       then do:
     1594         assign
     1595           p-day-begin-fact-order = 0
     1596         .
     1597       end.
     1598       else do:
     1599         assign
     1600           p-day-begin-fact-order = integer(p-fact-date)
     1601         .
     1602       end.
     1603     end.
     1604   end procedure.
     1605   procedure factord-max-fact-order :
     1606     define output parameter p-max-fact-order as decimal   no-undo .
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610       run day-begin-fact-order in this-procedure
     1611         (input  date(1, 1, 5000)
     1612         ,output p-max-fact-order
     1613         ) .
     1614     end.
     1615   end procedure.
     1616   procedure factord-cut-archive :
     1617     define input  parameter p-obj-type             as character no-undo .
     1618     define input  parameter p-obj-code             as integer   no-undo .
     1619     define input  parameter p-fact-date            as date      no-undo .
     1620     define output parameter p-shift-on             as logical   no-undo .
     1621     define output parameter p-shift-date           as date      no-undo .
     1622     define output parameter p-shift-num            as integer   no-undo .
     1623     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1624     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1625     define variable v-fact-order as decimal   no-undo .
     1626     define buffer buf_shift-obj for ub.shift-obj .
     1627     do
     1628     on error undo, return error return-value
     1629     :
     1630   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1632     (input  p-obj-type
     1633     ,input  p-obj-code
     1634     ,input  'shift-on=request'
     1635     ,output p-shift-on
     1636     ) no-error .
     1637       if error-status :error
     1638       then do:
     1639         message
     1640           vss-workfile vss-revision vss-description skip
     1641           "Ошибка при определении атрибута объекта" skip
     1642           "Объект" p-obj-type p-obj-code skip
     1643           error-status :get-message(1) skip
     1644           return-value skip
     1645           view-as alert-box error .
     1646         undo, return error return-value .
     1647       end.
     1648       if p-shift-on = false
     1649       then do:
     1650         assign
     1651           p-shift-date               = ?
     1652           p-shift-num                = 0
     1653         .
     1654       end.
     1655       else do:
     1656         find first buf_shift-obj share-lock
     1657           where buf_shift-obj.obj-type   = p-obj-type
     1658             and buf_shift-obj.obj-code   = p-obj-code
     1659             and buf_shift-obj.shift-date > p-fact-date
     1660           use-index pi
     1661           no-error .
     1662         if not available buf_shift-obj
     1663         or buf_shift-obj.status_ <> 'зкр':U
     1664         then do:
     1665           message
     1666             vss-workfile vss-revision vss-description skip
     1667             "Невозможно вычислить последнюю смену" skip
     1668             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1669             "Объект" p-obj-type p-obj-code skip
     1670             "Дата" p-fact-date skip
     1671             view-as alert-box error .
     1672           undo, return error return-value .
     1673         end.
     1674         find last buf_shift-obj share-lock
     1675           where buf_shift-obj.obj-type = p-obj-type
     1676             and buf_shift-obj.obj-code = p-obj-code
     1677             and buf_shift-obj.shift-date <= p-fact-date
     1678           use-index pi
     1679           no-error .
     1680         if available buf_shift-obj
     1681         then do:
     1682           if  buf_shift-obj.status_ = 'зкр':U
     1683           then do:
     1684             assign
     1685               p-shift-date = buf_shift-obj.shift-date
     1686               p-shift-num  = buf_shift-obj.shift-num
     1687             .
     1688           end.
     1689           else do:
     1690             message
     1691               vss-workfile vss-revision vss-description skip
     1692               "Невозможно вычислить последнюю смену" skip
     1693               "Статус смены отличен от статуса" 'зкр':U skip
     1694               "Объект" p-obj-type p-obj-code skip
     1695               "Дата" p-fact-date skip
     1696               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1697               view-as alert-box error .
     1698             undo, return error return-value .
     1699           end.
     1700         end.
     1701         else do:
     1702           assign
     1703             p-shift-date = p-fact-date - 1
     1704             p-shift-num  = 1
     1705           .
     1706         end.
     1707       end.
     1708       run factord in this-procedure
     1709         (input  p-fact-date
     1710         ,input  1
     1711         ,input  1
     1712         ,input  p-shift-date
     1713         ,input  p-shift-num
     1714         ,input  p-shift-on
     1715         ,output v-fact-order
     1716         ,output p-shift-end-fact-order
     1717         ,output p-day-end-fact-order
     1718         ) no-error .
     1719       if error-status :error
     1720       then do:
     1721         message
     1722           vss-workfile vss-revision vss-description skip
     1723           "Ошибка при вызове процедуры factord"
     1724           error-status :get-message(1) skip
     1725           return-value skip
     1726           view-as alert-box error .
     1727         undo, return error return-value .
     1728       end.
     1729     end.
     1730   end procedure.
     1731   procedure factord-lock-shift :
     1732     define input  parameter p-obj-type  as character no-undo .
     1733     define input  parameter p-obj-code  as integer   no-undo .
     1734     define input  parameter p-fact-date as date      no-undo .
     1735     define parameter buffer buf_shift-obj for ub.shift-obj .
     1736     define variable v-shift-on      as logical   no-undo .
     1737     define variable v-extra-message as character no-undo .
     1738     define variable v-error as character no-undo .
     1739     do
     1740     on error undo, return error return-value
     1741     :
     1742   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1744     (input  p-obj-type
     1745     ,input  p-obj-code
     1746     ,input  'shift-on=request'
     1747     ,output v-shift-on
     1748     ) no-error .
     1749       if error-status :error
     1750       then do:
     1751         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1752         undo, return error v-error .
     1753       end.
     1754       if v-shift-on = true
     1755       then do:
     1756         find first buf_shift-obj share-lock
     1757           where buf_shift-obj.obj-type   = p-obj-type
     1758             and buf_shift-obj.obj-code   = p-obj-code
     1759             and buf_shift-obj.shift-date > p-fact-date
     1760           use-index pi
     1761           no-error .
     1762         if not available buf_shift-obj
     1763         or buf_shift-obj.status_ <> 'зкр':U
     1764         then do:
     1765           find last buf_shift-obj
     1766             where buf_shift-obj.obj-type = p-obj-type
     1767               and buf_shift-obj.obj-code = p-obj-code
     1768               and buf_shift-obj.status_  = 'зкр':U
     1769             use-index stts
     1770             no-error .
     1771           if available buf_shift-obj
     1772           then do:
     1773             assign
     1774               v-extra-message =
     1775                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1776                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1777                               )
     1778             .
     1779           end.
     1780           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1781           undo, return error v-error .
     1782         end.
     1783       end.
     1784     end.
     1785   end procedure.
     1786   procedure factord-end-day :
     1787     define input  parameter p-fact-date            as date    no-undo .
     1788     define output parameter p-day-end-fact-order   as decimal no-undo .
     1789     do
     1790     on error undo, return error return-value
     1791     :
     1792       if p-fact-date = ?
     1793       then do:
     1794         return error "Не указана фактическая дата" .
     1795       end.
     1796       assign
     1797         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1798       .
     1799     end.
     1800   end procedure.
     1801   procedure factord-to-date :
     1802     define input  parameter p-fact-order as decimal no-undo .
     1803     define output parameter p-fact-date  as date    no-undo .
     1804     define variable v-ref-date  as date      no-undo .
     1805     define variable v-ref-delta as integer   no-undo .
     1806     do
     1807     on error undo, return error return-value
     1808     :
     1809       if p-fact-order = ?
     1810       or p-fact-order = 0
     1811       then do:
     1812         return error "Не указан fact-order" .
     1813       end.
     1814       assign
     1815         v-ref-date  = date(1, 1, 2000)
     1816       .
     1817       assign
     1818         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1819       .
     1820       assign
     1821         p-fact-date = v-ref-date + v-ref-delta
     1822       .
     1823     end.
     1824   end procedure.
     1825   procedure factord-to-fact-num :
     1826     define input  parameter p-fact-order as decimal no-undo .
     1827     define output parameter p-fact-num   as integer no-undo .
     1828     define variable v-fact-order-trunc as decimal no-undo .
     1829     do
     1830     on error undo, return error return-value
     1831     :
     1832       if p-fact-order = ?
     1833       or p-fact-order = 0
     1834       then do:
     1835         return error "Не указан fact-order" .
     1836       end.
     1837       assign
     1838        v-fact-order-trunc = truncate(p-fact-order, 2)
     1839       .
     1840       assign
     1841         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1842       .
     1843     end.
     1844   end procedure.
     1845   procedure factord-to-shift-num :
     1846     define input  parameter p-fact-order as decimal no-undo .
     1847     define output parameter p-shift-num   as integer no-undo .
     1848     define variable  p-shift-numd  as decimal   no-undo .
     1849     define variable v-fact-order-trunc as decimal no-undo .
     1850     do
     1851     on error undo, return error return-value
     1852     :
     1853       if p-fact-order = ?
     1854       or p-fact-order = 0
     1855       then do:
     1856         return error "Не указан fact-order" .
     1857       end.
     1858       assign
     1859        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1860       .
     1861       if v-fact-order-trunc < 0.5 then do:
     1862         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1863       end.
     1864       assign
     1865         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1866         .
     1867        assign
     1868         p-shift-num = truncate (p-shift-numd , 0)
     1869       .
     1870     end.
     1871   end procedure.
     1872   procedure fact-order-mpl :
     1873     do
     1874     on error undo, return error return-value
     1875     :
     1876   define input  parameter p-doc-date as date     no-undo .
     1877   define input  parameter p-obj-type as character no-undo .
     1878   define input  parameter p-obj-code as integer   no-undo .
     1879   define output parameter p-fact-order as decimal   no-undo .
     1880   define variable v-fact-date            as date    no-undo .
     1881   define variable v-fact-time            as integer no-undo .
     1882   define variable v-fact-order           as decimal no-undo .
     1883   define variable v-shift-end-fact-order as decimal no-undo .
     1884   define variable v-day-end-fact-order   as decimal no-undo .
     1885   define variable l-shift-on as logical no-undo .
     1886   define variable l-date as date      no-undo .
     1887   define variable l-time as integer   no-undo .
     1888   define variable shift-date as date      no-undo .
     1889   define variable shift-num  as integer   no-undo .
     1890   define variable shift-name as character no-undo .
     1891   define variable max-fact-order as decimal   no-undo .
     1892   define buffer buf_global-state for ub.global-state  .
     1893   find first buf_global-state no-lock no-error .
     1894   if not available buf_global-state then do:
     1895      message
     1896        "Не заданы параметры ценообразования!"
     1897        view-as alert-box error
     1898      .
     1899      return error return-value .
     1900   end.
     1901     run cur-time in this-procedure
     1902     ( output v-fact-date ,
     1903       output v-fact-time  ).
     1904   if p-doc-date = ? then do:
     1905   if buf_global-state.pl-use-sys-date-time  = true then do:
     1906         run factord in this-procedure
     1907           (input  v-fact-date
     1908           ,input  v-fact-time
     1909           ,input  v-fact-time
     1910           ,input  ?
     1911           ,input  ?
     1912           ,input  false
     1913           ,output v-fact-order
     1914           ,output v-shift-end-fact-order
     1915           ,output v-day-end-fact-order
     1916           ) no-error .
     1917         if error-status :error
     1918         or v-fact-order = ?
     1919         or v-fact-order = 0 then do:
     1920           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1921         end.
     1922         p-fact-order = v-fact-order .
     1923   end.
     1924   else do:
     1925   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1926   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1927     (input  p-obj-type
     1928     ,input  p-obj-code
     1929     ,input  'shift-on=request'
     1930     ,output l-shift-on
     1931     ) no-error .
     1932         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1933         if p-doc-date <> ? then do:
     1934         end.
     1935          run gbl/factdate.p
     1936          ( input        p-obj-type  ,
     1937            input        p-obj-code  ,
     1938            input-output v-fact-date ,
     1939            input-output v-fact-time ,
     1940            input-output shift-date      ,
     1941            input-output shift-num       ,
     1942            input-output shift-name      ,
     1943            input        yes
     1944            ) no-error .
     1945         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1946         run factord in this-procedure
     1947           (input  v-fact-date
     1948           ,input  v-fact-time
     1949           ,input  v-fact-time
     1950           ,input  shift-date
     1951           ,input  shift-num
     1952           ,input  l-shift-on
     1953           ,output v-fact-order
     1954           ,output v-shift-end-fact-order
     1955           ,output v-day-end-fact-order
     1956           ) no-error .
     1957         if error-status :error
     1958         or v-fact-order = ?
     1959         or v-fact-order = 0 then do:
     1960           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1961         end.
     1962         p-fact-order = v-fact-order .
     1963   end.
     1964   end.
     1965   else do:
     1966          run gbl/factdate.p
     1967          ( input        p-obj-type  ,
     1968            input        p-obj-code  ,
     1969            input-output v-fact-date ,
     1970            input-output v-fact-time ,
     1971            input-output shift-date      ,
     1972            input-output shift-num       ,
     1973            input-output shift-name      ,
     1974            input        yes
     1975            ) no-error .
     1976         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1977         v-fact-date = p-doc-date .
     1978         run factord in this-procedure
     1979           (input  v-fact-date
     1980           ,input  v-fact-time
     1981           ,input  v-fact-time
     1982           ,input  shift-date
     1983           ,input  shift-num
     1984           ,input  l-shift-on
     1985           ,output v-fact-order
     1986           ,output v-shift-end-fact-order
     1987           ,output v-day-end-fact-order
     1988           ) no-error .
     1989         if error-status :error
     1990         or v-fact-order = ?
     1991         or v-fact-order = 0 then do:
     1992           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1993         end.
     1994         p-fact-order = v-fact-order .
