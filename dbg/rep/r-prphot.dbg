      161   procedure create_obj-list :
      162      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      163      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      164      do
      165      on error undo, return error return-value
      166      :
      167         define buffer cli-obj for ub.clients .
      168         define variable p-var as integer no-undo .
      169         define buffer buf_obj-list for obj-list .
      170         find last buf_obj-list  use-index pi no-error .
      171         if available buf_obj-list
      172         then
      173            p-var = buf_obj-list.obj-id + 1.
      174         else
      175            p-var = 1.
      176         find first cli-obj where
      177                   cli-obj.obj-type = p-obj-type
      178               and cli-obj.obj-code = p-obj-code
      179         no-lock no-error.
      180         if available cli-obj
      181         then do:
      182            create buf_obj-list.
      183            assign
      184               buf_obj-list.obj-id   = p-var
      185               buf_obj-list.obj-code = cli-obj.obj-code
      186               buf_obj-list.obj-type = cli-obj.obj-type
      187               buf_obj-list.obj-name = cli-obj.obj-name
      188               buf_obj-list.db-num   = cli-obj.db-num
      189            .
      190         end.
      191      end.
      192   end.
