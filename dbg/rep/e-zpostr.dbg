      956   PROCEDURE reposition-query :
      957       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      958       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      959       RETURN.
      960   END PROCEDURE.
      961     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      962     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      963     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      964     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      965     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      966     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      967     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      968     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      969     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      970     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      971     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      972     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      973     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      974     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      975     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      976     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      977     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      978     IF "":U = "":U THEN
      979       RUN modify-list-attribute IN adm-broker-hdl
      980         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      981     RUN use-create-on-add(?).
      982   PROCEDURE adm-add-record :
      983       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      984          "must have at least one Enabled Table to perform Add.":U
      985          VIEW-AS ALERT-BOX ERROR.
      986       RETURN.
      987   END PROCEDURE.
      988   PROCEDURE adm-assign-record :
