      780   DEFINE FRAME F-Main
      781        PostName AT ROW 1.92 COL 15.38 NO-LABEL
      782        RADPost AT ROW 2 COL 2.75 NO-LABEL
      783        SortType AT ROW 2.5 COL 51.88 NO-LABEL
      784        Tog-obj AT ROW 5.54 COL 2.75
      785        type-stor AT ROW 5.92 COL 48.13 NO-LABEL
      786        Classify AT ROW 6.79 COL 2.75 NO-LABEL
      787        Tog-lavel-2 AT ROW 7.75 COL 28.25
      788        var-lavel-2 AT ROW 7.75 COL 39.13 COLON-ALIGNED NO-LABEL
      789        var-lavel AT ROW 8.58 COL 39.13 COLON-ALIGNED NO-LABEL
      790        Tog-lavel AT ROW 8.63 COL 28.25
      791        SumsOnly AT ROW 16.04 COL 2.88
      792        ShowZero AT ROW 16.88 COL 2.88
      793        "Классификация :" VIEW-AS TEXT
      794             SIZE 15 BY .75 AT ROW 4.83 COL 7.13
      795             FGCOLOR 4
      796        "Сортировка :" VIEW-AS TEXT
