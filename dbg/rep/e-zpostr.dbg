      696   DEFINE VARIABLE PostName AS CHARACTER
      697        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      698        SIZE 31 BY 2.46 TOOLTIP "Список выбранных Поставщиков"
      699        FONT 4 NO-UNDO.
      700   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      701        VIEW-AS FILL-IN NATIVE
      702        SIZE 5 BY .79 NO-UNDO.
      703   DEFINE VARIABLE var-lavel-2 AS INTEGER FORMAT ">>9":U INITIAL 1
      704        VIEW-AS FILL-IN NATIVE
      705        SIZE 5 BY .79 NO-UNDO.
      706   DEFINE VARIABLE Classify AS CHARACTER
      707        VIEW-AS RADIO-SET VERTICAL
      708        RADIO-BUTTONS
      709             "Без классификации", "no-classify":U,
      710   "Группы поставщиков", "post":U,
      711   "Группы товаров", "grp-goods":U,
      712   "Группы поставщиков/Группы товаров", "post/grp-goods":U,
      713   "Группы товаров/Группы поставщиков", "grp-goods/post":U,
      714   "Производители", "prod":U,
