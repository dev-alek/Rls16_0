      800             SIZE 11.5 BY .75 AT ROW 15.17 COL 7
      801             FGCOLOR 4
      802        "Выбор поставщика:" VIEW-AS TEXT
      803             SIZE 19.38 BY .67 AT ROW 1.25 COL 7.13
      804             FGCOLOR 4
      805        RECT-8 AT ROW 15 COL 1.75
      806        RECT-9 AT ROW 5.5 COL 47.75
      807        RECT-5 AT ROW 4.5 COL 1.75
      808        RECT-7 AT ROW 1.04 COL 1.75
      809        RECT-6 AT ROW 1.04 COL 47.75
      810       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      811            SIDE-LABELS NO-UNDERLINE THREE-D
      812            AT COL 1 ROW 1 SCROLLABLE .
      813   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      814   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      815   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      816   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      817   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      818   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      819   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      820   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      821         adm-object-hdl = FRAME F-Main:HANDLE.
      822   RUN ensure-broker.
      823   THIS-PROCEDURE:ADM-DATA =
      824        'ADM1.1~`':U +
      825        'SmartObject~`':U +
      826        '~`':U +
      827        'NO ~`':U +
      828        '~`':U +
      829        '~`':U +
      830        '~`':U +
      831        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      832           + "~`":U +
      833        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      834        'Record-Source,Record-Target,TableIO-Target~`':U +
      835        '~`':U +
      836        '~`~`~`~`~`~`~`~`~`~`~`':U +
      837        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      838            THEN "^^":U
      839        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      840             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      841   PROCEDURE adm-apply-entry :
      842     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      843   END PROCEDURE.
      844   PROCEDURE adm-destroy :
      845    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      846   END PROCEDURE.
      847   PROCEDURE adm-disable :
      848       DISABLE RECT-8 RECT-9 RECT-5 RECT-7 RECT-6 PostName RADPost SortType Tog-obj type-stor Classify SumsOnly ShowZero WITH FRAME F-Main.
      849       RUN dispatch ('disable-fields':U).
      850       RUN set-attribute-list ('ENABLED=no':U).
      851       RETURN.
      852   END PROCEDURE.
      853   PROCEDURE adm-edit-attribute-list :
      854         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      855         RETURN.
      856   END PROCEDURE.
      857   PROCEDURE adm-enable :
      858       ENABLE UNLESS-HIDDEN RECT-8 RECT-9 RECT-5 RECT-7 RECT-6 PostName RADPost SortType Tog-obj type-stor Classify SumsOnly ShowZero WITH FRAME F-Main.
      859       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      860       RUN set-attribute-list ('ENABLED=yes':U).
      861       RETURN.
      862   END PROCEDURE.
      863   PROCEDURE adm-exit :
      864        RUN notify ('exit':U).
      865     RETURN.
      866   END PROCEDURE.
      867   PROCEDURE adm-hide :
      868     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      869   END PROCEDURE.
      870   PROCEDURE adm-initialize :
      871     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      872   END PROCEDURE.
      873   PROCEDURE adm-show-errors :
      874       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      875       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      876           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      877       END.
      878       RETURN.
      879   END PROCEDURE.
      880   PROCEDURE adm-UIB-mode :
      881     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      882   END PROCEDURE.
      883   PROCEDURE adm-view :
      884     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      885   END PROCEDURE.
      886   PROCEDURE dispatch :
      887       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      888       RUN broker-dispatch IN adm-broker-hdl
      889           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      890       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      891   END PROCEDURE.
      892   PROCEDURE ensure-broker :
      893   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      894   IF RETURN-VALUE NE "ADM-Broker":U THEN
      895   DO:
      896       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      897       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      898   END.
      899   END PROCEDURE.
      900   PROCEDURE get-attribute :
      901     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      902     RUN broker-get-attribute IN adm-broker-hdl
      903         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      904     RETURN RETURN-VALUE.
      905   END PROCEDURE.
      906   PROCEDURE get-attribute-list :
      907     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      908     RUN broker-get-attribute-list IN adm-broker-hdl
      909         (INPUT THIS-PROCEDURE,
      910          INPUT ?,
      911          OUTPUT p-attr-list) NO-ERROR.
      912     RETURN.
      913   END PROCEDURE.
      914   PROCEDURE new-state :
      915     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      916     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      917     RETURN.
      918   END PROCEDURE.
      919   PROCEDURE notify :
      920     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      921     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      922     IF RETURN-VALUE = "ADM-ERROR":U THEN
      923         RETURN "ADM-ERROR":U.
      924     RETURN.
      925   END PROCEDURE.
      926   PROCEDURE set-attribute-list :
      927     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      928     RUN ensure-broker.
      929     RUN broker-set-attribute-list IN adm-broker-hdl
      930         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      931     RETURN.
      932   END PROCEDURE.
      933   PROCEDURE set-position :
      934       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      935       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      936       IF VALID-HANDLE(adm-object-hdl) THEN
      937       DO:
      938         ASSIGN adm-object-hdl:ROW    =   p-row
      939                adm-object-hdl:COLUMN =   p-col.
      940       END.
      941       RETURN.
      942   END PROCEDURE.
      943   PROCEDURE adm-display-fields :
      944       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
