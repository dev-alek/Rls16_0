     1000     END PROCEDURE.
     1001   PROCEDURE adm-copy-record :
     1002       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1003        "must have at least one Enabled Table to perform Copy.":U
     1004          VIEW-AS ALERT-BOX ERROR.
     1005       RETURN.
     1006   END PROCEDURE.
     1007   PROCEDURE adm-create-record :
     1008      RETURN.
     1009   END PROCEDURE.
     1010   PROCEDURE adm-current-changed :
     1011     RETURN.
     1012   END PROCEDURE.
     1013   PROCEDURE adm-delete-record :
     1014    MESSAGE
     1015          "Object ":U THIS-PROCEDURE:FILE-NAME
     1016            "must have at least one Enabled Table to perform Delete.":U
     1017              VIEW-AS ALERT-BOX ERROR.
     1018       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1019       RETURN.
     1020   END PROCEDURE.
