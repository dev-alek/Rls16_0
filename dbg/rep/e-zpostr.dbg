     1040   END PROCEDURE.
     1041   PROCEDURE check-modified :
     1042   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1043   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1044   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1045   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1046     IF check-state = "check":U THEN
     1047     DO:
     1048       RUN get-link-handle IN adm-broker-hdl
     1049         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1050            OUTPUT group-target-list).
     1051       IF group-target-list NE "":U THEN
     1052       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1053         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1054         RUN check-modified IN curr-widget ('group-check':U).
     1055         IF RETURN-VALUE NE "":U THEN
     1056         DO:
     1057           RUN check-modified-message(RETURN-VALUE).
     1058           RETURN "":U.
     1059         END.
     1060       END.
     1061     END.
     1062     RETURN "":U.
     1063   END PROCEDURE.
     1064   PROCEDURE check-modified-message :
     1065     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1066        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1067           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1068        IF RETURN-VALUE = "YES":U THEN
     1069           RUN notify ('view,CONTAINER-SOURCE':U).
     1070        MESSAGE IF p-changed-table NE ? THEN
     1071           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1072           ELSE "Current values have been changed."
     1073           SKIP "  Do you wish to save those changes?"
     1074           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1075        IF ANS THEN
     1076        DO:
     1077           IF group-assign-target THEN
     1078             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1079           ELSE RUN dispatch('update-record':U).
     1080           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1081           DO:
     1082               MESSAGE "Changes to the previous record were not saved."
     1083                 VIEW-AS ALERT-BOX ERROR.
     1084               IF group-assign-target THEN
     1085                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1086               ELSE RUN dispatch ('cancel-record':U).
     1087           END.
     1088        END.
     1089        ELSE DO:
     1090          IF group-assign-target THEN
     1091             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1092          ELSE RUN dispatch('cancel-record':U).
     1093        END.
     1094        RETURN.
     1095   END PROCEDURE.
     1096   PROCEDURE get-rowid :
     1097       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1098       ASSIGN
     1099       p-table   =   adm-first-table.
     1100       RETURN.
     1101   END PROCEDURE.
     1102   PROCEDURE init-group-assign :
     1103       RUN request-attribute IN adm-broker-hdl
     1104         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1105       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1106         group-assign-target = yes.
     1107       ELSE group-assign-target = no.
     1108       RETURN.
     1109   END PROCEDURE.
     1110   PROCEDURE set-editors :
     1111       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1112       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1113       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1114       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1115       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1116       DO WHILE VALID-HANDLE (curr-widget):
     1117           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1118              curr-widget:HIDDEN = no THEN DO:
     1119             CASE p-field-setting:
     1120               WHEN "INITIALIZE":U THEN
     1121               DO:
     1122                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1123                     read-only-list +
     1124                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1125                        STRING(curr-widget).
     1126               END.
     1127               WHEN "DISABLE":U OR
     1128               WHEN "ENABLE":U THEN
     1129               DO:
     1130                   curr-widget:SENSITIVE = yes.
     1131                   RUN get-attribute ('Read-Only-Editors':U).
     1132                   IF RETURN-VALUE = ? OR
     1133                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1134                       curr-widget:READ-ONLY =
     1135                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1136               END.
     1137               WHEN "CLEAR":U THEN
     1138                   curr-widget:SCREEN-VALUE = "":U.
     1139             END CASE.
     1140           END.
     1141           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1142       END.
     1143       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1144         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1145           + '"':U).
     1146       RETURN.
     1147   END PROCEDURE.
     1148   PROCEDURE use-check-modified-all :
     1149    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1150     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1151     RETURN.
     1152   END PROCEDURE.
     1153   PROCEDURE use-create-on-add :
     1154   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1155      RETURN.
     1156   END PROCEDURE.
     1157   PROCEDURE use-initial-lock :
     1158     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1159     ASSIGN adm-initial-lock = p-attr-value.
     1160     RETURN.
     1161   END PROCEDURE.
     1162     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1163   ASSIGN
     1164          FRAME F-Main:SCROLLABLE       = FALSE
     1165          FRAME F-Main:HIDDEN           = TRUE.
     1166   ASSIGN
     1167          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
     1168   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1169   DO:
     1170     Assign Classify.
     1171     if Classify = "grp-goods":U  Then do:
     1172       display TOG-lavel   with frame F-Main .
     1173       enable  TOG-lavel   with frame F-Main .
     1174     end.
     1175     Else do:
     1176       display  TOG-lavel  var-Lavel with frame F-Main .
     1177       disable  TOG-lavel  var-Lavel with frame F-Main .
     1178     end.
     1179     if Classify = "post":U Then do:
     1180       display TOG-lavel-2   with frame F-Main .
     1181       enable  TOG-lavel-2   with frame F-Main .
     1182     end.
     1183     Else do:
     1184       display  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1185       disable  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1186     end.
     1187   END.
     1188   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1189   DO:
     1190     Assign RadPost.
     1191     for each g#post share-lock : delete g#post. end.
     1192     Case RAdPost :
     1193     when 1 then DO:
     1194       Assign  Postname = 'все':U.
     1195       Display PostName with frame F-Main .
     1196     END.
     1197     when 2 then do:
     1198       run ref/cli-all.w ( my-handle
     1199                            , "b-sel,b-mark"
     1200                            , 'все':U
     1201                            , 'все':U
     1202                            , 'текущие':U
     1203                            , ?
     1204                            , ",,,,,,NO,,"
     1205                            , ?
     1206               , output post-grp_recids ) .
     1207       if post-grp_recids = "" then do:
     1208         Assign  Postname = 'все':U radpost = 1.
     1209         Display PostName radpost with frame F-Main .
     1210       end.
     1211       else do:
     1212         Assign  Postname = ''.
     1213         DO ii = 1 TO num-entries( post-grp_recids ) :
     1214           FIND cli-post WHERE recid( cli-post ) = int(entry( ii, post-grp_recids )) NO-LOCK.
     1215           create g#post.
     1216           assign
     1217             g#post.obj-type = cli-post.obj-type
     1218             g#post.obj-code = cli-post.obj-code
     1219             g#post.obj-name = cli-post.obj-name
     1220             Postname = PostName + cli-post.obj-name + chr(10).
     1221           END.
     1222           Display PostName with frame F-Main .
     1223         end.
     1224       end.
     1225     End case.
     1226   END.
     1227   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1228   DO:
     1229     Assign tog-lavel.
     1230     if tog-lavel =TRUE Then do:
     1231       display  var-Lavel  with frame F-Main .
     1232       enable   var-Lavel  with frame F-Main .
     1233     end.
     1234     Else do:
     1235       display    var-Lavel with frame F-Main .
     1236       disable    var-Lavel with frame F-Main .
     1237     end.
     1238   END.
     1239   ON VALUE-CHANGED OF Tog-lavel-2 IN FRAME F-Main
     1240   DO:
     1241      Assign tog-lavel-2.
     1242      if tog-lavel-2 = TRUE Then do:
     1243        display  var-Lavel-2  with frame F-Main .
     1244        enable   var-Lavel-2  with frame F-Main .
     1245      end.
     1246      Else do:
     1247        display    var-Lavel-2 with frame F-Main .
     1248        disable    var-Lavel-2 with frame F-Main .
     1249      end.
     1250   END.
     1251   ON VALUE-CHANGED OF Tog-obj IN FRAME F-Main
     1252   DO:
     1253     assign Tog-obj.
     1254   END.
     1255   if not this-procedure :persistent
     1256   then do:
     1257     message
     1258       vss-workfile vss-revision vss-description skip
     1259       "Ошибка при запуске процедуры" skip
     1260       "Данную процедуру следует запускать только с параметром persistent" skip
     1261       view-as alert-box error .
     1262     undo, return error .
     1263   end.
     1264   PROCEDURE disable_UI :
     1265     HIDE FRAME F-Main.
     1266     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1267   END PROCEDURE.
     1268   PROCEDURE local-initialize :
     1269     run dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1270      Tog-obj:screen-value in frame F-Main = 'yes':U.
     1271       var-lavel:screen-value in frame F-Main = '1'.
     1272       var-lavel-2:screen-value in frame F-Main = '1'.
     1273   END PROCEDURE.
     1274   PROCEDURE my-report :
     1275     def var par-val as character no-undo .
     1276   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1277   empty temp-table thbjattr_thbj-attr.
     1278   run adm/shattri.p (
     1279      input "get":U
     1280     ,input v-cntxt-obj-type
     1281     ,input v-cntxt-obj-code
     1282     ,input 'rezerv-obj':U
     1283     ,input  ""
     1284     ,output v-value-character
     1285     ,output v-value-date
     1286     ,output v-value-decimal
     1287     ,output v-value-integer
     1288     ,output v-value-logical
     1289     ,output par-type
     1290     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1291     ) no-error .
     1292   for each thbjattr_thbj-attr :
     1293       if thbjattr_thbj-attr.prop-code = 'negparts'  then par-val  = thbjattr_thbj-attr.property-value-character.
     1294   end.
     1295     if error-status:error then par-val = '' .
     1296     if CAPS(par-val) <> "DISABLE" Then do:
     1297       Message
     1298         "В системе разрешена работа с отрицательными партиями, "   "поэтому отчет по товарам поставщика может выдать сумму "
     1299         "остатка большую, чем состояние запаса по этому товару. " skip
     1300         "Разница отнесена на текущую фирму, поскольку поставщиком "  "в партиях отрицательных остатков считается текущая фирма. " skip
     1301         "Отрицательные партии товара могут быть скомпенсированы "    "в документе инвентаризации операцией пересортицы по партиям. "
     1302       view-as alert-box information.
     1303     End.
     1304    assign sheetf.Excel-Column-Lable = ""  sheetf.Sizes = "" .
     1305    if use-column[1]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "№ п\п,"                   sheetf.Sizes = sheetf.Sizes +  "5," .
     1306    if use-column[2]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Код,"                     sheetf.Sizes = sheetf.Sizes +  "10," .
     1307    if use-column[3]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Артикул,"                 sheetf.Sizes = sheetf.Sizes +  "16," .
     1308    if use-column[4]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Название товара,"         sheetf.Sizes = sheetf.Sizes +  "40," .
     1309    if use-column[5]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Ед. изм,"                 sheetf.Sizes = sheetf.Sizes +  "3," .
     1310    if use-column[6]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Факт. кол-во,"            sheetf.Sizes = sheetf.Sizes +  "14," .
     1311    if use-column[7]   = yes then do:
     1312        assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Своб. кол-во,"            sheetf.Sizes = sheetf.Sizes +  "14," .
     1313    end.
     1314    if use-column[8]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Учет. цена с НДС,"        sheetf.Sizes = sheetf.Sizes +  "15," .
     1315    if use-column[9]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Продажная цена,"          sheetf.Sizes = sheetf.Sizes +  "15," .
     1316    if use-column[10]  = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Сумма в уч.ценах с НДС,"  sheetf.Sizes = sheetf.Sizes +  "15," .
     1317    if use-column[11]  = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Сумма наценки,"           sheetf.Sizes = sheetf.Sizes +  "15," .
     1318    if use-column[12]  = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "% наценки,"               sheetf.Sizes = sheetf.Sizes +  "9," .
     1319    if use-column[13]  = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Ожидаемое кол-во,"        sheetf.Sizes = sheetf.Sizes +  "13," .
     1320    if LENGTH( sheetf.Excel-Column-Lable ) > 0 then do:
     1321      substr ( sheetf.Excel-Column-Lable, LENGTH( sheetf.Excel-Column-Lable )) = "" .
     1322      substr ( sheetf.Sizes, LENGTH( sheetf.Sizes )) = "" .
     1323      run rep/r-zpostr.p  (input base-type   ,
     1324                     input base-code   ,
     1325                     input PostName    ,
     1326                     input RADPost     ,
     1327                     input Classify    ,
     1328                     input SortType    ,
     1329                     input SumsOnly    ,
     1330                     input ShowZero    ,
     1331                     input tog-obj     ,
     1332                     input type-stor   ,
     1333                     input tog-lavel   ,
     1334                     input var-lavel   ,
     1335                     input tog-lavel-2 ,
     1336                     input var-lavel-2) .
     1337    end.
     1338    else do:
     1339      return error "format-page".
     1340    end.
     1341   END PROCEDURE.
     1342   PROCEDURE my-var :
     1343   assign frame F-Main PostName  RADPost type-stor ShowZero Classify
     1344    SortType SumsOnly Tog-obj Tog-lavel  var-lavel Tog-lavel-2  Var-lavel-2 .
     1345   def var t-class as char no-undo.
     1346   def var t-sort as char no-undo.
     1347     case classify:
     1348       when "no-classify":u    then t-class =   "Без классификации" .
     1349       when "prod":u           then t-class =   "Производители"   .
     1350       when "post":u           then t-class =   "Поставщики"   .
     1351       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1352       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1353       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1354       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1355       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1356       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1357       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1358       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1359       when  "t-level":u       then t-class =   "Терминальные группы" .
     1360    end case.
     1361     case sorttype:
     1362       when "sort-pp":u               then t-sort =   "по порядку" .
     1363       when "sort-code":u             then t-sort =   "по коду" .
     1364       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1365       when "sort-qunty":u            then t-sort =   "по реализации".
     1366       when "sort-name":u             then t-sort =   "по наименованию".
     1367       when "sort-type":u             then t-sort =   "по типу ткани".
     1368       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1369       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1370    end case.
     1371   ReportNAme = "Состояние запаса по поставщикам  (с учетом резервов) " + str1 .
     1372   ReportHeader = "Поставщики : " + PostName  + chr(10).
     1373   ReportHeader = ReportHeader + "Классификация : " + t-Class .
     1374   ReportHeader = ReportHeader + (if tog-lavel  then "    Итоги с уровня товаров "  + String(var-lavel)  else " "    ).
     1375   ReportHeader = ReportHeader + (if tog-lavel-2  then "    Итоги с уровня поставщиков "  + String(var-lavel-2)  else " "    ).
     1376   ReportHeader = ReportHeader  + chr(10) +
     1377                  "Сортировка " + t-Sort  + chr(10) +
     1378                  "Показать : " + (if SumsOnly     then "Только итоги, "  else " "             ) +
     1379                  (if ShowZero     then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" )
     1380                  + chr(10) + Entry(((type-stor * 2) - 1), type-stor:RADIO-BUTTONS) + chr(10) +
     1381                  "Цены указаны в " + (if x-SET_val_TYPE = 1 then "РУБ" else base-type )
     1382    .
     1383    sheetf.Excel-Column-Lable =
     1384             "№ п\п"
     1385     + ","  + "Код"
     1386     + ","  + "Артикул"
     1387     + ","  + "Название товара"
     1388     + ","  + "Ед. изм"
     1389     + ","  + "Факт. кол-во"
     1390     + ","  + "Своб. кол-во"
     1391     + ","  + "Учет. цена с НДС"
     1392     + ","  + "Продажная цена"
     1393     + ","  + "Сумма в уч.ценах с НДС"
     1394     + ","  + "Сумма наценки"
     1395     + ","  + "% наценки"
     1396     + ","  + "Ожидаемое кол-во"
     1397    .
     1398    sheetf.Sizes        =  "5,10,16,40,3,14,14,15,15,15,15,9,13" .
     1399    sheetf.ColFormat = "2=@;3=@;" .
     1400    Sheetf.make-correct = "true,true,true,true,true,true,true,true,true,true,true,true,true" .
     1401     str1 = ' '  .
     1402   END PROCEDURE.
     1403   PROCEDURE state-changed :
     1404     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1405     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1406     CASE p-state:
     1407     END CASE.
     1408   END PROCEDURE.
