        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: 899f5f3721f3, 1951, rls $":U.
        3   define variable vss-author      as character no-undo initial "$Author: ASMorozov $":U.
        4   define variable vss-date        as character no-undo initial "$Date: Fri Jul 26 11:39:33 2019 +0300 $":U.
        5   define variable vss-workfile    as character no-undo initial "$Workfile: r-ptrpmp.p $":U.
        6   define variable vss-archive     as character no-undo initial "$Archive: rep/r-ptrpmp.p $":U.
