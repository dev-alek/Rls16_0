     1277   with frame BottomFrame width 232 page-bottom no-labels no-box.
     1278   run WaitFram-Show in this-procedure ( input "Идет сбор данных для отчета, ждите..." ).
     1279   assign Line    = fill( "-", 136 )
     1280          v_today = '" ' + trim( string( day( x-date-alone ), ">9":U   ) ) + ' "  ' +
     1281                    MonthNameRusGen( month(   x-date-alone ) )             + " ":U  +
     1282                    trim( string(      year(  x-date-alone ), "9999":U ) ) + "г.".
     1283   for each Sheetf where Sheetf.Sheet-Num > 1 :
     1284     process events.
     1285     delete Sheetf.
     1286   end.
     1287   find first Sheetf where Sheetf.Sheet-Num = 1 no-error.
     1288   if not available Sheetf then do:
     1289     create Sheetf.
     1290     assign Sheetf.Sheet-num = 1.
     1291   end.
     1292   assign Sheetf.Excel-Column-Lable = "Наименование нефтепродукта" + chr(44) +
     1293                                      "№ ТРК"                      + chr(44) +
     1294                                      "Дата Время       час мин."  + chr(44) +
     1295                                      "Объем (л)"                  + chr(44) +
     1296                                      "Примечание"
     1297          Sheetf.Sizes              = "40,5,15,11,127".
     1298   assign str1 = "":U
     1299          str2 = "":U
     1300          str3 = "":U
     1301          str4 = "":U.
     1302   run spill-fuel          in this-procedure.
     1303   run prn-lib-open-stream in this-procedure ( input my-handle,
     1304                                                input 62,
     1305                                                input yes,
     1306                                                input no          ).
     1307   view stream PrnLibStream frame BottomFrame.
     1308   run WaitFram-Show in this-procedure ( input "Идет формирование отчета, ждите..." ).
     1309   assign j_order = 0.
     1310   for each obj-list no-lock
     1311      where obj-list.obj-id   > 0           and
     1312            obj-list.obj-id   > j-min-objid and
     1313            obj-list.obj-id   < j-max-objid
     1314   break by obj-list.obj-type
     1315         by obj-list.obj-code :
     1316     process events.
     1317     view stream PrnLibStream frame BottomFrame.
     1318     find first tt_tsf no-lock where
     1319                tt_tsf.obj-type = obj-list.obj-type and
     1320                tt_tsf.obj-code = obj-list.obj-code no-error.
     1321     if not available tt_tsf then do: next. end.
     1322   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1324     (input  obj-list.obj-type
     1325     ,input  obj-list.obj-code
     1326     ,output j-host-code
     1327     ,output v-host-name
     1328     ) no-error .
     1329     if error-status :error then do: next. end.
     1330     assign v-obj-name  = trim( obj-list.obj-name ) + fill( "_", 40 )
     1331            v-host-nmhd = trim( v-host-name       ) + fill( "_", 40 ).
     1332     assign ReportHeader =
     1333       fill( " ":U, 97 ) + string( v-host-nmhd, "x(40)":U )             + chr(10) +
     1334       fill( " ":U, 97 ) + string( v-obj-name,  "x(40)":U )             + chr(10) +
     1335                                                                                                chr(10) +
     1336                                                                                                chr(10) +
     1337       fill( " ":U, 64            ) + "А К Т"                                                 + chr(10) +
     1338       fill( " ":U, 54            ) + "прокачки топлива через ТРК"                            + chr(10) +
     1339                                                                                                chr(10) +
     1340                                                                                                chr(10) +
     1341       fill( " ":U, 56            ) + string( v_today,     "x(24)":U            )             + chr(10) +
     1342                                                                                                chr(10) +
     1343                                                                                                chr(10) +
     1344       '           Мы, нижеподписавшиеся, представители "' + v-host-name + '" составили'      + chr(10) +
     1345       "настоящий Акт о том, что при проведении технических работ, проверке точности отпуска дозы (ненужное зачеркнуть) " + chr(10) +
     1346       "через ТРК было прокачено в мерник и слито (возвращено) в резервуар в соответствии с видом топлива:"  + chr(10) +
     1347                                                                                                               chr(10) .
     1348     assign j_order = j_order + 1.
     1349     find first Sheetf where Sheetf.Sheet-Num = j_order no-error.
     1350     if not available Sheetf then do:
     1351       create Sheetf.
     1352       assign Sheetf.Sheet-num = j_order.
     1353     end.
     1354     assign Sheetf.Excel-Column-Lable = "Наименование нефтепродукта" + chr(44) +
     1355                                        "№ ТРК"                      + chr(44) +
     1356                                        "Дата Время       час мин."  + chr(44) +
     1357                                        "Объем (л)"                  + chr(44) +
     1358                                        "Примечание"
     1359            Sheetf.Sizes              = "40,5,15,11,127".
     1360     run rep/extitle.p ( input j_order ) no-error.
     1361     run print-header in this-procedure.
     1362     put stream PrnLibStream unformatted
     1363       "----------------------------------------------------------------------------------------------------------------------------------------" skip
     1364       ":              Наименование              : № :  Дата, Время, : Объем (л) : Примечание                                                  :" skip
     1365       ":              нефтепродукта             :ТРК:   час,  мин.  :           :                                                             :" skip
     1366       "----------------------------------------------------------------------------------------------------------------------------------------" skip.
     1367     for each tt_tsf no-lock where
     1368              tt_tsf.obj-type  = obj-list.obj-type and
     1369              tt_tsf.obj-code  = obj-list.obj-code use-index ttpi
     1370     break by tt_tsf.obj-type
     1371           by tt_tsf.obj-code
     1372           by tt_tsf.gds-code
     1373           by tt_tsf.pump-code
     1374           by tt_tsf.chk-date
     1375           by tt_tsf.chk-time  :
     1376       process events.
     1377       put stream PrnLibStream unformatted ":".
     1378       if first-of( tt_tsf.gds-code ) then do:
     1379         put stream PrnLibStream unformatted string( tt_tsf.gds-name, "x(40)":U ).
     1380       end.
     1381       else do:
     1382         put stream PrnLibStream unformatted string( "           ":U, "x(40)":U ).
     1383       end.
     1384       put stream PrnLibStream unformatted
     1385         ":" + ( if tt_tsf.pump-code < 10 then
     1386               ( " ":U + string( tt_tsf.pump-code, "9":U     ) ) + " ":U
     1387                                            else
     1388               ( " ":U + string( tt_tsf.pump-code, ">9":U  ) ) ) +
     1389         ":" + string( tt_tsf.chk-date,  "99/99/99":U          ) + ", ":U +
     1390               string( tt_tsf.chk-time,  "HH:MM":U             ) +
     1391         ":" + string( tt_tsf.doc-qnty,  "zzzzzzz9.99":U       ) +
     1392         ":" + string( tt_tsf.ps,        "x(61)"               ) + ":"    skip.
     1393       if last-of( tt_tsf.gds-code ) then do:
     1394           if not last( tt_tsf.gds-code ) then do:
     1395         put stream PrnLibStream unformatted
     1396           ":----------------------------------------:-------------------:-----------:-------------------------------------------------------------:" skip.
     1397           end.
     1398       end.
     1399       else do:
     1400         put stream PrnLibStream unformatted
     1401           ":                                        :-------------------:-----------:-------------------------------------------------------------:" skip.
     1402       end.
     1403       if first-of( tt_tsf.gds-code ) then do:
     1404         if Make-Excel then  put   stream ForExcel unformatted string( tt_tsf.gds-name, "x(40)":U ) CHR(9).
     1405       end.
     1406       else do:
     1407         if Make-Excel then  put   stream ForExcel unformatted string( "           ":U, "x(40)":U ) CHR(9).
     1408       end.
     1409       if Make-Excel then  put   stream ForExcel unformatted string( tt_tsf.pump-code, "z9":U          ) CHR(9)
     1410                   string( tt_tsf.chk-date,  "99/99/99":U    ) + ", ":U +
     1411                   string( tt_tsf.chk-time,  "HH:MM":U       ) CHR(9)
     1412                   string( tt_tsf.doc-qnty,  "zzzzzzz9.99":U ) CHR(9)
     1413                   string( tt_tsf.ps,        "x(61)"         ) chr(10).
     1414     end.
     1415     find first tt_tsf no-lock no-error.
     1416     if available tt_tsf then do:
     1417       put stream PrnLibStream unformatted
     1418         "----------------------------------------------------------------------------------------------------------------------------------------" skip( 1 ).
     1419     end.
     1420     run print-footer in this-procedure.
     1421     if not last( obj-list.obj-type ) then do:
     1422       hide stream PrnLibStream frame BottomFrame.
     1423       page stream PrnLibStream.
     1424       if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1425     end.
     1426   end.
     1427   if Make-Excel then output stream ForExcel close.
     1428   hide stream PrnLibStream frame BottomFrame.
     1429   output stream PrnLibStream close.
     1430   run waitfram-hide in this-procedure.
     1431   find first tt_tsf no-lock no-error.
     1432   if not available tt_tsf then do:
     1433     message "За" x-date-alone "по выбранным объектам не было тех.проливов." view-as alert-box information.
     1434     return.
     1435   end.
     1436   else do:
     1437     run prn-lib-prn-file in this-procedure ( input my-handle, input 0 ).
     1438   end.
     1439   procedure print-header :
     1440     put stream PrnLibStream unformatted                                                        skip( 1 )
     1441       string( v-host-nmhd, "x(40)":U ) format "x(40)":U at 97 skip
     1442       string( v-obj-name,  "x(40)":U ) format "x(40)":U at 97 skip( 2 )
     1443                 "А К Т"                                                       at 65            skip
     1444       "прокачки топлива через ТРК"                                            at 55            skip( 1 )
     1445       string( v_today,     "x(24)":U            ) format "x(24)":U            at 57            skip( 1 )
     1446       '           Мы, нижеподписавшиеся, представители "' + v-host-name + '" составили'        skip
     1447       "настоящий Акт о том, что при проведении технических работ, проверке точности отпуска дозы (ненужное зачеркнуть) через "   skip
     1448       "ТРК было прокачено в мерник и слито (возвращено) в резервуар в соответствии с видом топлива:" skip( 1 ).
     1449   end procedure.
     1450   procedure spill-fuel :
     1451     define variable j-host-code as integer   no-undo.
     1452     define variable v-host-name as character no-undo.
     1453     define variable v-obj-name  as character no-undo.
     1454     define variable is-petrol   as logical   no-undo.
     1455     define variable is-pieces   as logical   no-undo.
     1456     define variable was-found   as logical   no-undo.
     1457     define buffer bf_chk-doc  for ub.chk-doc.
     1458     define buffer bf_chk-gds  for ub.chk-gds.
     1459     define buffer bf_goods    for ub.goods.
     1460     define buffer bf_bar-code for ub.bar-code.
     1461     define buffer bf_obj-list for obj-list.
     1462     find first obj-list no-lock use-index pi no-error.
     1463     assign j-min-objid = ( if available obj-list then obj-list.obj-id else 0 ) - 1.
     1464     find last  obj-list no-lock use-index pi no-error.
     1465     assign j-max-objid = ( if available obj-list then obj-list.obj-id else 0 ) + 1.
     1466     for each obj-list no-lock where
     1467              obj-list.obj-id > j-min-objid and
     1468              obj-list.obj-id < j-max-objid :
     1469       process events.
     1470       assign was-found = no.
     1471       for each bf_chk-doc no-lock where
     1472                bf_chk-doc.obj-type = obj-list.obj-type and
     1473                bf_chk-doc.obj-code = obj-list.obj-code and
     1474                bf_chk-doc.chk-date = x-date-alone      use-index obj-date :
     1475         process events.
     1476         find first bf_inkas where bf_inkas.inkas-code = bf_chk-doc.out-code no-lock no-error.
     1477         if not available bf_inkas then do:
     1478           next.
     1479         end.
     1480         if bf_chk-doc.chk-type <> integer( '17':U ) then do: next. end.
     1481         for each bf_chk-gds no-lock where
     1482                  bf_chk-gds.doc-code = bf_chk-doc.doc-code :
     1483           process events.
     1484           if bf_chk-gds.pump = 0 then do: next. end.
     1485           find first bf_bar-code no-lock where bf_bar-code.b-code = bf_chk-gds.b-code    no-error.
     1486           if not available bf_bar-code then do: next. end.
     1487           find first bf_goods    no-lock where bf_goods.gds-code  = bf_bar-code.gds-code no-error.
     1488           if not available bf_goods then do: next. end.
     1489   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1490     (
     1491        input bf_goods.artic
     1492     ,  input bf_goods.prod-type
     1493     ,  input bf_goods.prod-code
     1494     , output is-petrol
     1495     , output is-pieces
     1496     ) no-error.
     1497           if error-status :error then do: next. end.
     1498           def var v-value as character no-undo.
     1499           def var v-type  as character no-undo.
     1500           def var v-tech-pass as logical no-undo.
     1501   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf-spi_trn-doc.doc-code ,
     1502                           input 'techpass':U ,
     1503                          output v-value ,
     1504                          output v-type ) no-error .
     1505           assign
     1506             v-tech-pass = yes when v-value = "yes".
     1507           create tt_tsf.
     1508           assign tt_tsf.obj-type  = bf_chk-doc.obj-type
     1509                  tt_tsf.obj-code  = bf_chk-doc.obj-code
     1510                  tt_tsf.gds-code  = bf_goods.gds-code
     1511                  tt_tsf.gds-name  = bf_goods.gds-name
     1512                  tt_tsf.pump-code = bf_chk-gds.pump
     1513                  tt_tsf.chk-date  = bf_chk-doc.chk-date
     1514                  tt_tsf.chk-time  = bf_chk-doc.chk-time
     1515                  tt_tsf.doc-qnty  = bf_chk-gds.doc-qnty.
     1516           define buffer buf_sale-doc for ub.sale-doc.
     1517           find first buf_sale-doc no-lock where
     1518                     buf_Sale-doc.inkas-code = bf_inkas.inkas-code
     1519                and  buf_Sale-doc.doc-kind = 'trf':U no-error.
     1520           if available buf_sale-doc or v-tech-pass then do:
     1521             find first bf-spi_trn-doc where bf-spi_trn-doc.doc-code = v-value no-lock no-error.
     1522             if available bf-spi_trn-doc and
     1523               substring(bf-spi_trn-doc.ps, 1, 1) <> "@" then do:
     1524               assign
     1525                 tt_tsf.ps = substring(replace(replace(bf-spi_trn-doc.ps, chr(13), "":u), chr(10), "":u), 1, 61).
     1526             end.
     1527           end.
     1528           assign was-found        = yes.
     1529         end.
     1530       end.
     1531       find bf_obj-list exclusive-lock where recid( bf_obj-list ) = recid( obj-list ).
     1532       if was-found <> yes then do:
     1533         assign bf_obj-list.obj-id = - ( abs( bf_obj-list.obj-id ) + abs( j-min-objid ) ).
     1534       end.
     1535       else do:
     1536         assign bf_obj-list.obj-id =   ( abs( bf_obj-list.obj-id ) + abs( j-max-objid ) ).
     1537       end.
     1538       find bf_obj-list        no-lock where recid( bf_obj-list ) = recid( obj-list ).
     1539     end.
     1540     find first obj-list no-lock where
     1541                obj-list.obj-id > 0 use-index pi no-error.
     1542     assign j-min-objid = ( if available obj-list then obj-list.obj-id else 0 ) - 1.
     1543     find last  obj-list no-lock    use-index pi no-error.
     1544     assign j-max-objid = ( if available obj-list then obj-list.obj-id else 0 ) + 1.
     1545   end procedure.
     1546   procedure print-footer :
     1547     put stream PrnLibStream unformatted                                                          skip( 1 )
     1548       "Председатель комиссии:"                                                                   skip
     1549       "________________________    (                                                         )" at 50 skip( 2 )
     1550       "Члены комиссии:"                                                                          skip
     1551       "________________________    (                                                         )" at 50 skip( 1 )
     1552       "________________________    (                                                         )" at 50 skip( 1 )
     1553       "________________________    (                                                         )" at 50 skip( 1 )
     1554       "________________________    (                                                         )" at 50 skip( 1 ).
     1555     if Make-Excel then  put   stream ForExcel unformatted                                                                                     chr(10)
     1556                                                                                                     chr(10)
     1557                 "Председатель комиссии:"                                                            chr(10)
     1558                 fill( " ":U, 49 ) +
     1559                 "_______________________    (                                                    )" chr(10)
     1560                                                                                                     chr(10)
     1561                                                                                                     chr(10)
     1562                 "Члены комиссии:"                                                                   chr(10)
     1563                 fill( " ":U, 50 ) +
     1564                 "_______________________    (                                                    )" chr(10)
     1565                                                                                                     chr(10)
     1566                 fill( " ":U, 50 ) +
     1567                 "_______________________    (                                                    )" chr(10)
     1568                                                                                                     chr(10)
     1569                 fill( " ":U, 50 ) +
     1570                 "_______________________    (                                                    )" chr(10)
     1571                                                                                                     chr(10)
     1572                 fill( " ":U, 50 ) +
     1573                 "_______________________    (                                                    )" chr(10)
     1574                                                                                                     chr(10).
     1575   end procedure.
