      750   define variable var-report-r-b as character no-undo .
      751   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      752   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      753     (output var-report-r-b
      754     )  .
      755   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      757   define  shared variable RepPathName        as character no-undo .
      758   define  shared variable PrintRubl          as logical   no-undo .
      759   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760   procedure cur-time :
      761      define output parameter p-today as date      no-undo .
      762      define output parameter p-time  as integer   no-undo .
      763     do
      764     on error undo, return error
      765     :
      766       define variable v-date1 as date      no-undo .
      767       define variable v-date2 as date      no-undo .
      768       define variable v-time  as integer   no-undo .
      769       assign
      770         v-date1 = today
      771         v-time  = time
      772         v-date2 = today
      773       .
      774       if v-date1 <> v-date2
      775       then do:
      776         assign
      777           v-date1 = today
      778           v-time  = v-time
      779         .
      780       end.
      781       assign
      782         p-today = v-date1
      783         p-time  = v-time
      784       .
      785     end.
      786   end.
      787   function cur-time-date returns character
      788   :
      789     return string(today, '99/99/9999':U) .
      790   end.
      791   function cur-time-mjd returns decimal
      792   :
      793     define variable v-date as date      no-undo .
      794     define variable v-time as integer   no-undo .
      795     run cur-time in this-procedure
      796       (output v-date
      797       ,output v-time
      798       ) .
      799     return integer(v-date) - 2400002 + (v-time / 86400) .
      800   end.
      801   function cur-time-get-ending-index returns integer
      802   (input p-number as integer
      803   )
      804   :
      805     if p-number < 0
      806     or p-number = ?
      807     then do:
      808       return 1 .
      809     end.
      810     define variable v-rest as integer   no-undo .
      811     assign
      812       p-number = p-number modulo 100
      813     .
      814     if p-number < 20
      815     then do:
      816       assign
      817         v-rest = p-number
      818       .
      819     end.
      820     else do:
      821       assign
      822         v-rest = p-number modulo 10
      823       .
      824     end.
      825     case v-rest :
      826       when 1
      827       then do:
      828         return 2 .
      829       end.
      830       when 2 or
      831       when 3 or
      832       when 4
      833       then do:
      834         return 3 .
      835       end.
      836       otherwise do:
      837         return 1 .
      838       end.
      839     end case .
      840   end.
      841   procedure cur-time-mjd-to-date :
      842      define input  parameter i-mjd-diff as decimal no-undo.
      843      define output parameter o-Date     as date    no-undo.
      844      define output parameter o-Time     as integer no-undo.
      845      define variable v-day-number as integer   no-undo .
      846      if    i-mjd-diff < 0
      847         or i-mjd-diff = ?
      848      then do:
      849         return "?" .
      850      end.
      851      assign
      852         v-day-number = truncate(i-mjd-diff,0).
      853         o-Date = date(v-day-number + 2400002).
      854         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      855     .
      856   end.
      857   function cur-time-mjd-to-string returns character
      858   (input p-mjd-diff as decimal
      859   )
      860   :
      861     define variable v-day-number as integer   no-undo .
      862     define variable v-seconds    as integer   no-undo .
      863     define variable v-hour       as integer   no-undo .
      864     define variable v-min        as integer   no-undo .
      865     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      866     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      867     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      868     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      869     if p-mjd-diff < 0
      870     or p-mjd-diff = ?
      871     then do:
      872       return "?" .
      873     end.
      874     assign
      875       v-day-number = integer(truncate(p-mjd-diff,0))
      876       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      877     .
      878     if v-seconds > 86400
      879     then do:
      880       assign
      881         v-seconds = 86400 - 1
      882       .
      883     end.
      884     if v-seconds < 0
      885     then do:
      886       assign
      887         v-seconds = 0
      888       .
      889     end.
      890     assign
      891       v-hour = truncate(v-seconds / 3600, 0)
      892     .
      893     assign
      894       v-seconds = v-seconds modulo 3600
      895     .
      896     assign
      897       v-min = truncate(v-seconds / 60, 0)
      898     .
      899     assign
      900       v-seconds = v-seconds modulo 60
      901     .
      902     return
      903         (if v-day-number <> 0
      904           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      905           else ""
      906         )
      907       + (if v-day-number <> 0 or v-hour <> 0
      908           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      909           else ""
      910         )
      911       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      912           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      913           else ""
      914         )
      915       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      916       .
      917   end.
      918   function cur-time-string returns character
      919   :
      920     define variable v-date as date      no-undo .
      921     define variable v-time as integer   no-undo .
      922     run cur-time in this-procedure
      923       (output v-date
      924       ,output v-time
      925       ) .
      926     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      927   end.
      928   function cur-time-string-sec returns character
      929   :
      930     define variable v-date as date      no-undo .
      931     define variable v-time as integer   no-undo .
      932     run cur-time in this-procedure
      933       (output v-date
      934       ,output v-time
      935       ) .
      936     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      937   end.
      938   function cur-time-custom  returns character
      939   (input p-prefix as character
      940   ,input p-date-format as character
      941   ,input p-delimiter as character
      942   ,input p-time-format as character
      943   ,input p-suffix as character
      944   )
      945   :
      946     define variable v-date as date      no-undo .
      947     define variable v-time as integer   no-undo .
      948     run cur-time in this-procedure
      949       (output v-date
      950       ,output v-time
      951       ) .
      952     return
      953       p-prefix
      954       + string(v-date, p-date-format)
      955       + p-delimiter
      956       + string(v-time, p-time-format)
      957       + p-suffix
      958       .
      959   end.
      960   function cur-time-print  returns character
      961   :
      962     define variable v-date as date      no-undo .
      963     define variable v-time as integer   no-undo .
      964     run cur-time in this-procedure
      965       (output v-date
      966       ,output v-time
      967       ) .
      968     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      969   end.
      970   function cur-time-datetime returns datetime
      971   :
      972     define variable v-char as character no-undo .
      973     define variable v-datetime as datetime no-undo .
      974     v-char = cur-time-string().
      975     v-datetime = datetime(v-char).
      976     return  v-datetime.
      977   end.
      978   function cur-time-string-msec returns character
      979   :
      980     define variable v-date as datetime  no-undo .
      981     v-date = now.
      982     return string(v-date) .
      983   end.
      984   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   define variable v-waitfram-action01         as character   no-undo .
      986   define variable v-waitfram-action02         as character   no-undo .
      987   define variable v-waitfram-action03         as character   no-undo .
      988   define variable mWaitFramTextBeg            as character   no-undo.
      989   define variable mWaitFramTextEnd            as character   no-undo.
      990   define variable mWaitFramView               as logical     no-undo.
      991   define variable mWaitProcEvent              as logical     no-undo init yes.
      992   define variable mWaitFramInterval           as integer     no-undo init 1 .
      993   define variable mWaitFramStop               as logical     no-undo.
      994   define variable mWaitFramStopUser           as logical     no-undo.
      995   define variable mWaitFramStopTimeOut        as logical     no-undo.
      996   define variable mWaitFramStartProc          as datetime-tz no-undo.
      997   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      998   define button B-WaitFramStop auto-end-key
      999        label "Стоп"
     1000        size 10 by 1 tooltip "Остоновить процесс".
     1001   define button B-viewProcInfo
     1002        label "Информация"
     1003        size 15 by 1 tooltip "Информация о процесс".
     1004   define frame waitfram
     1005     v-waitfram-action01 format "x(72)" no-label skip
     1006     v-waitfram-action02 format "x(72)" no-label skip
     1007     v-waitfram-action03 format "x(72)" no-label skip
     1008     B-viewProcInfo
     1009     B-WaitFramStop at row 4 col 30
     1010     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1011     .
     1012   define new global shared variable mBatchMode as logical no-undo init ?.
     1013   define variable mFramBachModHandle as handle no-undo.
     1014   mFramBachModHandle = frame waitfram:handle.
     1015   define variable mFameOldVis as logical no-undo.
     1016   define variable mVisCUrentVin as logical no-undo.
     1017   if session:batch-mode
     1018   then
     1019      mBatchMode = yes.
     1020   if mBatchMode = ? then do:
     1021     mVisCUrentVin = current-window:visible.
     1022     mFameOldVis = mFramBachModHandle:visible.
     1023     mFramBachModHandle:visible  = yes.
     1024     mBatchMode = mFramBachModHandle:visible ne yes.
     1025     mFramBachModHandle:visible = mFameOldVis.
     1026     current-window:visible = mVisCUrentVin.
     1027   end.
     1028    if  log-manager:logfile-name ne ?
     1029     then DO:
     1030         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1031         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1032         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1033     end.
     1034   on choose of B-WaitFramStop in frame waitfram
     1035   do:
     1036     mWaitFramStop = yes.
     1037     mWaitFramStopUser = yes.
     1038   end.
     1039   function waitfram-check-timeout returns logical():
     1040      define variable vtime as int64 no-undo.
     1041      if mWaitFramStopTimeOut
     1042      then
     1043         return yes.
     1044      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1045      if     mWaitFramTimeOut ne ?
     1046         and mWaitFramTimeOut ne 0
     1047         and mWaitFramTimeOut lt vtime
     1048      then do:
     1049         mWaitFramStopTimeOut = yes.
     1050      end.
     1051      return mWaitFramStopTimeOut.
     1052   end.
     1053   procedure waitfram-hide :
     1054     if not session:batch-mode
     1055     then do
     1056     on error undo, return error return-value
     1057     :
     1058       pause 0 before-hide .
     1059       if not mBatchMode then
     1060         hide frame waitfram .
     1061     if     not mWaitFramView
     1062        and mWaitProcEvent
     1063     then
     1064       process events .
     1065     end.
     1066   end procedure.
     1067   procedure waitfram-show :
     1068     define input  parameter p-message as character no-undo .
     1069     define variable v-left-margin as integer   no-undo .
     1070     if not session:batch-mode
     1071     then do
     1072     on error undo, return error return-value
     1073     :
     1074       if length(p-message) <= 70 then do:
     1075         assign
     1076           v-left-margin = integer((70 - length(p-message)) / 2)
     1077         .
     1078         assign
     1079           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1080         .
     1081         assign
     1082           v-waitfram-action01 = " "
     1083           v-waitfram-action02 = " "
     1084                                    + fill(" ", v-left-margin)
     1085                                    + p-message
     1086           v-waitfram-action03 = " "
     1087         .
     1088       end.
     1089       else do:
     1090         define variable vRindex1 as integer no-undo.
     1091         define variable vRindex2 as integer no-undo.
     1092         vRindex1 = r-index(p-message," ",70).
     1093         if vRindex1 = 0
     1094         then
     1095            vRindex1 = 70.
     1096         if length(p-message)  <= vRindex1 + 70 then do:
     1097           assign
     1098             v-waitfram-action01 = " "
     1099             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1100             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1101           .
     1102         end.
     1103         else do:
     1104           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1105           if vRindex2 <= vRindex1
     1106           then
     1107              vRindex2 = vRindex1 + 70.
     1108           assign
     1109             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1110             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1111             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1112           .
     1113         end.
     1114       end.
     1115       B-viewProcInfo:visible   in frame waitfram = no.
     1116       B-viewProcInfo:sensitive in frame waitfram = no.
     1117       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1118       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1119       if  (   mWaitFramView
     1120          or  mWaitProcEvent)
     1121          and not mBatchMode
     1122       then
     1123          display
     1124             v-waitfram-action01 skip
     1125             v-waitfram-action02 skip
     1126             v-waitfram-action03 skip
     1127          with frame waitfram .
     1128       if     mWaitFramView
     1129          then do:
     1130             if     mWaitFramInterval ne ?
     1131                and not mBatchMode
     1132             then
     1133                wait-for go of frame waitfram pause mWaitFramInterval.
     1134          end.
     1135          else
     1136             if     mWaitProcEvent
     1137                and not mBatchMode
     1138             then
     1139                process events .
     1140     end.
     1141   end procedure.
     1142      procedure waitfram-show-this:
     1143         define input  parameter iInterval as int64 no-undo.
     1144         define variable vtime as int64 no-undo.
     1145         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1146         mWaitFramInterval = iInterval.
     1147         run waitfram-show (substitute("&1&2 &3&4" ,
     1148                                       mWaitFramTextBeg ,
     1149                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1150                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1151                                       mWaitFramTextEnd
     1152                                      )
     1153                           ).
     1154      end.
     1155      procedure WaitFramRunPause:
     1156         define input  parameter iInterval as dec no-undo.
     1157         define variable vStart  as datetime-tz no-undo.
     1158         define variable vend    as datetime-tz no-undo.
     1159         define variable vint as int64 no-undo.
     1160         define variable vOk as logical no-undo.
     1161         vStart = now.
     1162         vend   = vStart.
     1163         publish "WaitFramPause" (iInterval,output vOk).
     1164         vend   =  now.
     1165         vint = vend - vStart.
     1166         vint = iInterval - vint / 1000.
     1167         if     not mWaitFramStop
     1168            and (   vint > 0
     1169                 or (    not vOk
     1170                     and iInterval eq ?
     1171                     )
     1172                 )
     1173         then
     1174            run waitfram-show-this (iInterval).
     1175         vend   =  now.
     1176         vint = vend - vStart.
     1177         vint = iInterval - vint / 1000.
     1178         if     not mWaitFramStop
     1179            and vint > 0
     1180         then do:
     1181            run gbl/pause.p (vint * 1000).
     1182         end.
     1183         if iInterval ne ?
     1184         then
     1185            publish "WaitFramStop".
     1186         waitfram-check-timeout().
     1187      end.
     1188      procedure WaitFramWaitFor:
     1189         define input  parameter iInterval as dec no-undo.
     1190         assign
     1191            mWaitFramStartProc   = now
     1192            mWaitFramStopUser    = no
     1193            mWaitFramStopTimeOut = no
     1194         .
     1195         block-wait:
     1196         do while not mWaitFramStop:
     1197            run WaitFramRunPause (iInterval).
     1198            if  waitfram-check-timeout()
     1199            then do:
     1200               leave block-wait.
     1201            end.
     1202         end.
     1203         run waitfram-hide.
     1204      end.
     1205   procedure waitfram-join :
     1206     define input  parameter p-line-1  as character no-undo .
     1207     define input  parameter p-line-2  as character no-undo .
     1208     define input  parameter p-line-3  as character no-undo .
     1209     define output parameter p-message as character no-undo .
     1210     do
     1211     on error undo, return error return-value
     1212     :
     1213       assign
     1214         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1215                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1216                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1217       .
     1218     end.
     1219   end procedure.
     1220   function waitfram-join-function returns character
     1221     (input p-line-1 as character
     1222     ,input p-line-2 as character
     1223     ,input p-line-3 as character
     1224     ).
     1225     define variable v-message as character no-undo .
     1226     run waitfram-join in this-procedure
     1227       (input  p-line-1
     1228       ,input  p-line-2
     1229       ,input  p-line-3
     1230       ,output v-message
     1231       ) .
     1232     return v-message .
     1233   end function .
     1234   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     1235     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     1236     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     1237     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     1238   END FUNCTION.
     1239   PROCEDURE get-month-name-gen :
     1240     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     1241     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     1242     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     1243     DO ON ERROR UNDO, RETURN ERROR :
     1244       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     1245     END.
     1246   END PROCEDURE.
     1247   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1248   define new global shared variable g#trdcalib as handle no-undo.
     1249   define temp-table tt_tsf no-undo
     1250     field obj-type  as character
     1251     field obj-code  as integer
     1252     field gds-code  as integer
     1253     field gds-name  as character
     1254     field pump-code as integer
     1255     field chk-date  as date
     1256     field chk-time  as integer
     1257     field doc-qnty  as decimal
     1258     field ps        as character
     1259     index ttpi      is primary   obj-type obj-code gds-code pump-code chk-date chk-time.
     1260   define variable Line        as character no-undo.
     1261   define variable j_time      as integer   no-undo.
     1262   define variable v_today     as character no-undo.
     1263   define variable j-host-code as integer   no-undo.
     1264   define variable v-host-name as character no-undo.
     1265   define variable v-host-nmhd as character no-undo.
     1266   define variable v-obj-name  as character no-undo.
     1267   define variable j-max-objid as integer   no-undo.
     1268   define variable j-min-objid as integer   no-undo.
