      895       .
      896       find first bar-code no-lock
      897            where bar-code.gds-code = goods.gds-code
      898              and bar-code.unit-cli = goods.unit-base
      899              and bar-code.node-code = rootnode_code
      900              and bar-code.part-code = ""
      901              and bar-code.in-code = ""
      902       .
      903       find first gds-dtl no-lock
      904            where gds-dtl.doc-code = doc-line.doc-code
      905              and gds-dtl.prod-type = doc-line.prod-type
      906              and gds-dtl.prod-code = doc-line.prod-code
      907              and gds-dtl.artic = doc-line.artic
      908              and gds-dtl.prt-code = rootnode_code
      909       .
      910       assign
      911           v-doc-line-counter = v-doc-line-counter + 1
      912           v-bar-code      = goods.gds-code
      913           v-need-qnty     = gds-dtl.doc-qnty
      914           v-qnty-all      = gds-dtl.fact-qnty
      915           v-unit-name     = goods.unit-base
      916           v-cost-sum      = v-cost-price * v-qnty-all
      917           v-sale-price    = ( if PrintRubl then gds-dtl.price-rubl else gds-dtl.price-base )
      918           v-sale-sum      = v-sale-price * v-qnty-all
      919       .
