     1129       skip
     1130         space(10)
     1131         "подпись"                                 at center-field( 10 + 61, 10 + 81, 6)
     1132         "расшифровка подписи"                     at center-field( 10 + 81, 10 + 101, 19)
     1133       skip
     1134        space(10) "Проверил бухгалтер "
     1135         v-underline format "X(19)"                at 10 + 61
     1136         v-underline format "X(30)"                at 10 + 81
     1137       skip
     1138         space(10)
     1139         "подпись"                                 at center-field( 10 + 61, 10 + 81, 6)
     1140         "расшифровка подписи"                     at center-field( 10 + 81, 10 + 101, 19)
     1141       .
     1142     output stream Out-Stream close.
     1143   if session :set-wait-state( "" ) then.
     1144   if g#quest-print = false
     1145   then do:
     1146     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1147                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1148                                         OUTPUT g#log ).
     1149   end.
     1150   else do:
     1151     os-command silent
     1152       value( "COPY /b " +
     1153         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1154         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1155         string( session:temp-directory) +  "$" + string( g#report-num )
     1156                 ) .
     1157     os-command silent
     1158       value( "COPY /b " +
     1159         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1160         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1161         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1162                 ) .
     1163   end.
     1164   end.
