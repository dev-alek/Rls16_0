      478           v-doc-line-counter column-label " 1" format ">>>9" space(1)
      479           sym2 column-label ":" format "X(1)" space(0)
      480           v-goods-artic column-label "        2       " format "X(6)" space(0)
      481           sym3 column-label ":" format "X(1)" space(0)
      482           v-goods-name column-label "                     3                      " format "X(48)" space(0)
      483           sym4 column-label ":" format "X(1)" space(0)
      484           v-bar-code column-label "    4    " format ">>>>>>>>>>>9" space(0)
      485           sym5 column-label ":" format "X(1)" space(0)
      486           v-qnty-all column-label "  5 " format ">>>>>>>>>>9.999" space(0)
      487           sym6 column-label ":" format "X(1)" space(0)
      488           v-sale-price column-label "     6      " format  "->>,>>>,>>>,>>9.99" space(0)
      489           sym7 column-label ":" format "X(1)" space(0)
      490           v-sale-sum column-label   "     7       " format "->>,>>>,>>>,>>9.99" space(0)
      491           sym8 column-label ":" format "X(1)" space(0)
      492           v-cost-price column-label "     8      " format  "->>,>>>,>>>,>>9.99" space(0)
      493           sym9 column-label ":" format "X(1)" space(0)
      494           v-cost-sum column-label   "      9      " format "->>,>>>,>>>,>>9.99" space(0)
      495           sym10 column-label ":" format "X(1)" space(0)
      496           v-comment column-label "        10         " format "X(24)" space(0)
      497           sym11 column-label "|" format "X(1)" space(0)
      498       with width 235 down stream-io.
      499   assign
      500       v-valut-name   = ( if PrintRubl then "рублях" else "баз.вал" )
      501       v-single-line  = fill("-", 230)
      502       v-underline    = fill("_", 230)
      503       v-line-counter = 1
      504   .
      505   assign
      506       tdoc-code = t-doc.doc-code
      507       tdoc-date = (if t-doc.status_ <> 'факт':U then t-doc.doc-date else t-doc.fact-date )
      508   .
      509   find first buf_clients no-lock
      510        where buf_clients.obj-type = t-doc.obj-type
      511          and buf_clients.obj-code = t-doc.obj-code
      512   no-error.
      513     case buf_clients.obj-type :
      514       when 'маг':U then do:
      515         find first shop no-lock where shop.obj-code = buf_clients.obj-code .
      516         assign tdoc-prt = shop.doc-prt .
      517       end.
      518       when 'скл':U then do:
      519         find first store no-lock where store.obj-code = buf_clients.obj-code .
      520         assign tdoc-prt = store.doc-prt .
      521       end.
      522     end case.
      523     assign v-org-from = buf_clients.obj-name .
      524     if not tdoc-prt then PrintScale = no .
      525   find first buf_clients no-lock where buf_clients.obj-type = t-doc.cli-type and buf_clients.obj-code = t-doc.cli-code no-error.
      526   assign
      527       v-org-to = buf_clients.obj-name
      528   .
      529   if session :set-wait-state( "compiler" ) then.
      530   output stream Out-Stream to value( string( session:temp-directory +
      531                                        "rpt" + string( g#report-num ) ) )
      532                                        page-size  value(43) .
      533   form header
      534       v-single-line format "X(193)" at 1 skip
      535       "Продолжение - на следующей странице" at 30 skip
      536       with frame BottomFrame width 235 page-bottom no-labels no-box .
      537   view stream Out-Stream frame BottomFr&DOS_CWame .
      538   find first clients no-lock where clients.obj-type = 'орг':U and clients.obj-code = t-doc.host-code .
      539       case clients.obj-type:
      540          when 'орг':U
      541          then do:
      542               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
      543               if available ub.firm
      544               then do:
      545                   assign
      546                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
      547                       t-addres = t-addres
      548                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
      549                               then ""
      550                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
      551                             )
      552                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
      553                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      554                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      555                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
      556                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
      557                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      558                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      559                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
      560                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      561                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      562                       t-phone = ub.firm.phone
      563                       t-inn   = ub.firm.inn
      564                       t-okpo  = ub.firm.okpo
      565                   .
      566               end.
      567          end.
      568          when 'маг':U
      569          then do:
      570               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
      571               if available ub.shop
      572               then do:
      573                   assign
      574                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
      575                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
      576                       t-phone = shop.phone
      577                       t-inn = ""
      578                       t-okpo = ""
      579                   .
      580               end.
      581          end.
      582          when 'скл':U
      583          then do:
      584               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
      585               if available ub.store
      586               then do:
      587                   assign
      588                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
      589                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
      590                       t-phone = ub.store.phone
      591                       t-inn = ""
      592                       t-okpo = ""
      593                   .
      594               end.
      595          end.
      596          when 'чел':U
      597          then do:
      598               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
      599               if available ub.person
      600               then do:
      601                   assign
      602                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
      603                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
      604                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
      605                       t-phone = ub.person.phone1
      606                       t-inn = ub.person.inn
      607                       t-okpo = ub.person.okpo
      608                   .
      609               end.
      610          end.
      611       end case.
      612   assign
      613       v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")" + t-addres + t-phone)
      614   .
      615   put stream Out-Stream  skip string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 5 + 193, 13) .
      616   put stream Out-Stream
      617     skip    space(5) v-single-line format  "X(19)"             at 180
      618     skip    space(5) "| "                                      at 180
      619                     'код':U                               at 188
      620                     "|"                                       at 5 + 193
      621     skip    space(5) "Форма по ОКУД" format "X(14)"            at 166
      622                     "| "                                      at 180
      623                     "0330512"
      624                     "|"                                       at 5 + 193
      625     skip    space(5) "Организация:                         "
      626                v-organization             format "X(100)"
      627                "по ОКПО"                  format "X(7)"       at 172
      628                "| "                                           at 180
      629                t-okpo                     format "X(16)" "|"  at 5 + 193
      630     skip    space(5) "Струрное подразделение:              "
      631                     (if t-doc.doc-type = 'при':U then v-org-to else v-org-from) format "X(80)"
      632                     "| "                                      at 180
      633                     "|"                                       at 5 + 193
      634     skip
      635       space(5) "Вид деятельности по ОКДП" format "X(25)" at 155
      636                     "| "                                      at 180
      637                     "|"                                       at 5 + 193
      638     skip
      639       space(5) "Вид операции"        format "X(12)"      at 167
      640                     "| "                                      at 180
      641                      " "                    format "X(16)"
      642                      "|"                                      at 5 + 193
      643     skip
      644       space(5) v-single-line         format  "X(19)"     at 180
      645   .
      646   put stream Out-Stream
      647      skip    space(74) v-single-line format "X(33)"                               "УТВЕРЖДАЮ" at 176
      648      skip    space(74) "|"
      649         "Номер"   at  center-field(75, 93, 5)    "|"  at 94   "Дата"   at  center-field(95, 106, 4)   "|"  at 107  format "X(33)"   "Руководитель"     at 175
      650      skip    space(74) "|"
      651         "документа" format "X(9)" at  center-field(75, 93, 9)        "|"  at 94
      652          "составления" format "X(11)" at  center-field(95, 106, 11)  "|"  at 107     "_______________________"    at 171
      653      skip    space(74) "|"   v-single-line format "X(31)"   "|"  at 107              "должность"                  at 178
      654      skip    space(70) string( "АКТ | "
      655                                   + string( tdoc-code , "X(16)") + " | " + string( tdoc-date, "99/99/9999") + " | "
      656                                   + (if t-doc.status_ <> 'факт':U then string( "(" + CAPS(t-doc.status_) + ")" ) else "")
      657                                   ) format "X(80)"                                  "_____________  __________________"    at 165
      658      skip    space(74) v-single-line format "X(33)"                                  "подпись     расшифровка подписи"    at 168
      659      skip    space(45) "О РЕАЛИЗАЦИИ ГОТОВЫХ ИЗДЕЛИЙ КУХНИ ЗА НАЛИЧНЫЙ РАСЧЕТ" format "X(70)"         "<_____> ___________________ г."  at 168
      660   .
      661   form with frame f-doc .
      662   down stream Out-Stream 1 with frame f-doc no-labels.
      663   put stream Out-Stream
      664       skip space(5)
      665         "Комиссия установила:"
      666         string( "Цены и суммы указаны в " + trim( v-valut-name ) ) format "X(30)"    at 100
      667         ( if t-doc.status_ <> 'факт':U  then string( "Статус документа: " + t-doc.status_ + " " + string( t-doc.flag_, "+/-" ) ) else " " )   at 150 format "X(30)"
      668   .
      669   put stream Out-Stream
      670      skip space(5)
      671        v-single-line format "X(193)"
      672      skip space(5)
      673        "|Номер"
      674        ":" at 5 + 7
      675        "Номер"
      676        ":" at 5 + 14
      677        "Готовое изделие " at center-field( 5 + 14, 5 + 76, 17)
      678        ":" at 5 + 76
      679        "Реализовано" at center-field( 5 + 76, 5 + 168, 15)
      680        ":" at 5 + 168
      681        "|" at 5 + 193
      682      skip space(5)
      683        "| по "
      684        ":" at 5 + 7
      685        "каль-"
      686        ":" at 5 + 14
      687        v-single-line format "X(153)" at (5 + 14 + 1)
      688        ":" at 5 + 168
      689        "|" at 5 + 193
      690      skip
      691        space(5)
      692        "| по- "
      693        ":" at 5 + 7
      694        "куля-"
      695        ":" at 5 + 14
      696        "наименование"   at center-field( 5 + 14, 5 + 63, 12)
      697        ":" at 5 + 63
      698        "код"   at center-field( 5 + 63, 5 + 76, 3)
      699        ":" at 5 + 76
      700        "Количество" at center-field( 5 + 76, 5 + 92, 10)
      701        ":" at 5 + 92
      702        "По ценам продажи" at center-field( 5 + 92, 5 + 130, 17)
      703        ":" at 5 + 130
      704        "По учетным ценам" at center-field( 5 + 130, 5 + 168, 17)
      705        ":" at 5 + 168
      706        "Примечание" at center-field( 5 + 168, 5 + 193, 10)
      707        "|" at 5 + 193
      708      skip space(5)
      709        "|рядку"
      710        ":"                  at 5 + 7
      711        "цион. "
      712        ":"                  at 5 + 14
      713        ":"                  at 5 + 63
      714        ":"                  at 5 + 76
      715        ":"                  at 5 + 92
      716        v-single-line format "X(75)" at (5 + 92 + 1)
      717        ":"                  at 5 + 168
      718        "|"                  at 5 + 193
      719      skip space(5)
      720        "|"
      721        ":"                  at 5 + 7
      722        "карт."
      723        ":"                  at 5 + 14
      724        ":"                  at 5 + 63
      725        ":"                  at 5 + 76
      726        ":"                  at 5 + 92
      727        "Цена, руб.коп" at center-field( 5 + 92, 5 + 111, 17)
      728        ":"                  at 5 + 111
      729        "Сумма, руб.коп" at center-field( 5 + 111, 5 + 130, 17)
      730        ":"                  at 5 + 130
      731        "Цена, руб.коп" at center-field( 5 + 130, 5 + 149, 17)
      732        ":"                  at 5 + 149
      733        "Сумма, руб.коп" at center-field( 5 + 149, 5 + 168, 17)
      734        ":"                  at 5 + 168
      735        "|"                  at 5 + 193
      736      skip space(5)
      737        "|"
      738        v-single-line format "X(191)"
      739        "|" at 5 + 193
      740   .
      741   define variable vss-include-info2 as character format "X(65)" no-undo
      742   initial "@(#)$Workfile$ $Revision$".
      743           PUT stream Out-Stream
      744               skip space(5)
      745                 "|  1"
      746                 ":"                  at 5 + 7
      747                 "2"                  at center-field( 5 + 7, 5 + 14, 1)
      748                 ":"                  at 5 + 14
      749                 "3"                  at center-field( 5 + 14, 5 + 63, 1)
      750                 ":"                  at 5 + 63
      751                 "4"                  at center-field( 5 + 63, 5 + 76, 1)
      752                 ":"                  at 5 + 76
      753                 "5"                  at center-field( 5 + 76, 5 + 92, 1)
      754                 ":"                  at 5 + 92
      755                 "6"                  at center-field( 5 + 92, 5 + 111, 1)
      756                 ":"                  at 5 + 111
      757                 "7"                  at center-field( 5 + 111, 5 + 130, 1)
      758                 ":"                  at 5 + 130
      759                 "8"                  at center-field( 5 + 130, 5 + 149, 1)
      760                 ":"                  at 5 + 149
      761                 "9"                  at center-field( 5 + 149, 5 + 168, 1)
      762                 ":"                  at 5 + 168
      763                 "10"                 at center-field( 5 + 168, 5 + 193, 2)
      764                 "|"                  at 5 + 193
      765               skip space(5)
      766                 "|"
      767                 v-single-line format "X(191)"
      768                 "|"                  at 5 + 193
      769           .
      770   for each doc-line no-lock where doc-line.doc-code = t-doc.doc-code
      771      break BY doc-line.artic
      772   :
      773       find first goods no-lock
      774            where goods.prod-type = doc-line.prod-type
      775              and goods.prod-code = doc-line.prod-code
      776              and goods.artic = doc-line.artic
      777       .
      778       find first gds-prt no-lock where gds-prt.upper-code = goods.prt-root .
      779       rootnode_code = gds-prt.node-code.
      780   assign
      781     price-rubl-with-tax-loc = doc-line.price-rubl
      782     price-base-with-tax-loc = doc-line.price-base
      783   .
      784   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      785   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      786     (output varinvprb
      787     )  .
      788      find first in-vatp_doc-attr no-lock
      789       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
      790         and in-vatp_doc-attr.attr-code = 'envd':U
      791       no-error .
      792       if available in-vatp_doc-attr
      793          then do:
      794          assign
      795            in-vatp-have-vat-slt = no.
      796      end.
      797      else do:
      798        assign
      799          in-vatp-have-vat-slt = yes.
      800      end.
      801      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
      802                                        in-vatp-goods.prod-type = doc-line.prod-type and
      803                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
      804      if (not t-doc.internal and
      805              t-doc.doc-type = 'при':U) or
      806         in-vatp-goods.gds-type = 'у':U then do:
      807         if varinvprb = "base":u then do:
      808           assign
      809             road-tax-base-loc = doc-line.road-tax
      810             road-tax-rubl-loc = doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
      811         end.
      812         else do:
      813           ASSIGN
      814             road-tax-rubl-loc = doc-line.road-tax
      815             road-tax-base-loc = doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
      816         end.
      817         if road-tax-base-loc = ? then road-tax-base-loc = 0.
      818         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
      819         assign
      820           road-tax-cli-loc = ?.
      821         ASSIGN
      822           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
      823           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
      824           transport-cli-loc  = 0
      825           other-base-loc     = (if doc-line.other-base     = ? then 0 else doc-line.other-base)
      826           other-rubl-loc     = (if doc-line.other-rubl     = ? then 0 else doc-line.other-rubl)
      827           other-cli-loc      = 0
      828           vat-pc-loc         = (if doc-line.vat-pc         = ? then 0 else doc-line.vat-pc)
      829           slt-pc-loc         = (if doc-line.slt-pc         = ? then 0 else doc-line.slt-pc).
      830                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      831               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      832         assign
      833           vat-cli-loc            = ?
      834           slt-cli-loc            = ?
      835           price-cli-with-tax-loc = ?.
      836      end.
      837      else do:
      838                                                   for each in-vatp-parts where in-vatp-parts.out-code  = doc-line.doc-code  and
      839                                         in-vatp-parts.obj-type  = doc-line.obj-type  and
      840                                         in-vatp-parts.obj-code  = doc-line.obj-code  and
      841                                         in-vatp-parts.artic     = doc-line.artic     and
      842                                         in-vatp-parts.prod-type = doc-line.prod-type and
      843                                         in-vatp-parts.prod-code = doc-line.prod-code
      844                            use-index out-code no-lock:
      845             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
      846                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
      847                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
      848                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
      849                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
      850                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
      851                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      852                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      853                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      854                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      855                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      856                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      857                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      858                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      859                         .
