      601   procedure create_obj-list :
      602      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      603      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      604      do
      605      on error undo, return error return-value
      606      :
      607         define buffer cli-obj for ub.clients .
      608         define variable p-var as integer no-undo .
      609         define buffer buf_obj-list for obj-list .
      610         find last buf_obj-list  use-index pi no-error .
      611         if available buf_obj-list
      612         then
      613            p-var = buf_obj-list.obj-id + 1.
      614         else
      615            p-var = 1.
      616         find first cli-obj where
      617                   cli-obj.obj-type = p-obj-type
      618               and cli-obj.obj-code = p-obj-code
      619         no-lock no-error.
      620         if available cli-obj
      621         then do:
      622            create buf_obj-list.
      623            assign
      624               buf_obj-list.obj-id   = p-var
      625               buf_obj-list.obj-code = cli-obj.obj-code
      626               buf_obj-list.obj-type = cli-obj.obj-type
      627               buf_obj-list.obj-name = cli-obj.obj-name
      628               buf_obj-list.db-num   = cli-obj.db-num
      629            .
      630         end.
      631      end.
      632   end.
