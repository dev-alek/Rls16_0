      269   procedure grp-obj-notcorr-value :
      270   do
      271   on error undo, return error
      272   :
      273   define input parameter p-node-code             as integer      no-undo.
      274   define input parameter p-obj-type              as character    no-undo.
      275   define input parameter p-obj-code              as integer      no-undo.
      276   define output parameter p-notcorr              as character    no-undo init ?.
      277   define output parameter p-range-notcorr     as integer      no-undo.
      278   define output parameter p-exists-notcorr    as logical      no-undo.
      279   define variable v-host-code as integer      no-undo.
      280   DEFINE VARIABLE v-found as logical no-undo .
      281   DEFINE VARIABLE v-exists as logical no-undo .
      282   DEFINE VARIABLE v-range as integer no-undo .
      283   DEFINE VARIABLE jj as integer no-undo .
      284   DEFINE VARIABLE v-notcorr-found as logical no-undo .
      285   DEFINE VARIABLE v-notcorr-value as char      no-undo.
      286   define buffer buf_gds-grp for ub.gds-grp.
      287   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      288   find first buf_gds-grp no-lock where
      289              buf_gds-grp.node-code = p-node-code no-error .
      290   if not avail buf_gds-grp and p-node-code <> 0 then do:
      291     message
      292       vss-workfile vss-revision vss-description
      293       skip "Не удалось найти группу товаров с кодом" p-node-code
      294       view-as alert-box error .
      295     undo, return error .
      296   end.
      297   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      299     (input  p-obj-type
      300     ,input  p-obj-code
      301     ,output v-host-code
      302     ) no-error .
      303   if error-status :error
      304   then do:
      305       message
      306         vss-workfile vss-revision vss-description
      307         skip "Не удалось найти фирму объекта"
      308         skip p-obj-type p-obj-code
      309         skip return-value
      310         skip trim(error-status :get-message(1))
      311       view-as alert-box error.
      312       undo, return error .
      313   end.
      314   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      315   do while v-found = no and jj < 2:
      316     if v-range <> 3 then do:
      317       find first buf_gds-grp-obj no-lock
      318           where buf_gds-grp-obj.node-code = p-node-code
      319             and buf_gds-grp-obj.host-code = v-host-code
      320             and buf_gds-grp-obj.obj-type  = p-obj-type
      321             and buf_gds-grp-obj.obj-code  = p-obj-code
      322       no-error .
      323     end.
      324     if v-range = 3 or not available buf_gds-grp-obj
      325     then do:
      326        if v-range <> 2 then do:
      327           find first buf_gds-grp-obj no-lock
      328               where buf_gds-grp-obj.node-code = p-node-code
      329                 and buf_gds-grp-obj.host-code = v-host-code
      330                 and buf_gds-grp-obj.obj-type  = ""
      331                 and buf_gds-grp-obj.obj-code  = 0
      332           no-error .
      333         end.
      334         if v-range = 2 or not available buf_gds-grp-obj
      335         then do:
      336             if v-range <> 1 then do:
      337               find first buf_gds-grp-obj no-lock
      338                   where buf_gds-grp-obj.node-code = p-node-code
      339                   and buf_gds-grp-obj.host-code = 0
      340                   and buf_gds-grp-obj.obj-type  = ""
      341                   and buf_gds-grp-obj.obj-code  = 0
      342               no-error .
      343             end.
      344             if v-range = 1 or not available buf_gds-grp-obj
      345             then do:
      346                 assign
      347                     v-exists = no
      348                 .
      349             end.
      350             else do:
      351                 assign
      352                     v-exists = yes
      353                     v-range = 1
      354                 .
      355             end.
      356         end.
      357         else do:
      358             assign
      359                 v-exists = yes
      360                 v-range  = 2
      361             .
      362         end.
      363     end.
      364     else do:
      365         assign
      366             v-exists = yes
      367             v-range  = 3
      368         .
      369     end.
      370     if available buf_gds-grp-obj
      371     then do:
      372       find first buf_gds-grp-obj-attr no-lock
      373         where buf_gds-grp-obj-attr.node-code   = p-node-code
      374           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
      375           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
      376           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
      377           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
      378         no-error .
      379       if available buf_gds-grp-obj-attr then do:
      380         assign
      381           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
      382         .
      383       end.
      384       else do:
      385         assign
      386           v-notcorr-value = ?
      387         .
      388       end.
      389       assign
      390       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
      391                           then yes
      392                           else p-exists-notcorr)
      393       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
      394                         then v-range
      395                         else p-range-notcorr
      396       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
      397                         then v-notcorr-value
      398                         else p-notcorr
      399       v-found =  (p-exists-notcorr ) or (v-range <= 1)
      400       jj = jj + 1
      401       .
      402     end.
      403     else do:
      404       assign
      405       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
      406       jj = jj + 1
      407       .
      408     end.
      409   end.
      410   end.
      411   end procedure.
      412   define variable vss-include-info2 as character format "X(65)" no-undo
      413   initial "@(#)$Workfile$ $Revision$".
      414   procedure grplib-get-full-name :
      415      define input parameter p-node-code  as integer      no-undo.
      416      define output parameter p-full-name as character    no-undo.
      417      do
      418   on error undo, return error
      419   :
      420       define variable v-upper-code    as integer           no-undo.
      421       define buffer buf_gds-grp       for ub.gds-grp.
      422       define buffer buf_upper_gds-grp for ub.gds-grp.
      423       find first buf_gds-grp no-lock
      424            where buf_gds-grp.node-code = p-node-code
      425       no-error.
      426       if not available buf_gds-grp
      427       then do:
      428           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      429       end.
      430       assign
      431           p-full-name  = ""
      432           v-upper-code = 1
      433       .
      434       do while buf_gds-grp.upper-code <> 0
      435       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      436       :
      437           assign
      438               p-full-name  = buf_gds-grp.node-name
      439                            + (if p-full-name <> "" then chr(47) else "")
      440                            + p-full-name
      441               v-upper-code = buf_gds-grp.upper-code
      442           .
      443           find first buf_gds-grp no-lock
      444                where buf_gds-grp.node-code = v-upper-code
      445           no-error.
      446           if not available buf_gds-grp
      447           then do:
      448               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      449                                   + string( v-upper-code )
      450                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      451           end.
      452       end.
      453       assign
      454       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      455       .
      456   end.
      457   end .
      458   procedure grplib-get-node-from-full-name :
      459   define input parameter p-full-name as character no-undo .
      460   define output parameter p-node-code as integer no-undo .
      461   define variable v-ii as integer no-undo .
      462   define variable v-upper-code as integer no-undo .
      463   define variable v-root-code as integer no-undo .
      464   define variable v-entry as character no-undo .
      465   define buffer buf_gds-grp       for ub.gds-grp.
      466   do
      467   on error undo, return error
      468   :
      469     find first buf_gds-grp no-lock
      470         where buf_gds-grp.upper-code = 0
      471     no-error .
      472     if not available buf_gds-grp
      473     then do:
      474         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      475     end.
      476     else do:
      477       assign
      478       v-root-code = buf_gds-grp.node-code
      479       .
      480     end.
      481     v-upper-code = v-root-code.
      482     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      483       assign
      484       v-entry = entry(v-ii, p-full-name, chr(47)).
      485       if v-entry = '' then leave.
      486       find first buf_gds-grp no-lock where
      487                 buf_gds-grp.node-name = v-entry
      488             and buf_gds-grp.upper-code = v-upper-code
      489             no-error.
      490       if not available buf_gds-grp then do:
      491         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      492       end.
      493       else do:
      494         p-node-code = buf_gds-grp.node-code.
      495         v-upper-code = buf_gds-grp.node-code.
      496       end.
      497     end.
      498   end.
      499   end .
