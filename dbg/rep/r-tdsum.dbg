     1025   define variable var-report-r-b as character no-undo .
     1026   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1027   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1028     (output var-report-r-b
     1029     )  .
     1030   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1032   define  shared variable RepPathName        as character no-undo .
     1033   define  shared variable PrintRubl          as logical   no-undo .
     1034   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1035   procedure factord :
     1036     define input  parameter p-fact-date            as date    no-undo .
     1037     define input  parameter p-fact-time            as integer no-undo .
     1038     define input  parameter p-fact-num             as integer no-undo .
     1039     define input  parameter p-shift-date           as date    no-undo .
     1040     define input  parameter p-shift-num            as integer no-undo .
     1041     define input  parameter p-shift-on             as logical no-undo .
     1042     define output parameter p-fact-order           as decimal no-undo .
     1043     define output parameter p-shift-end-fact-order as decimal no-undo .
     1044     define output parameter p-day-end-fact-order   as decimal no-undo .
     1045     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1046     if p-fact-date = ?
     1047     then do:
     1048       return error "Не указана фактическая дата" .
     1049     end.
     1050     define variable v-fact-date-num as integer no-undo .
     1051     assign
     1052       v-fact-date-num = integer(p-fact-date)
     1053     .
     1054     if p-fact-num = ?
     1055     or p-fact-num = 0
     1056     then do:
     1057       return error "Не задан p-fact-num " + string(p-fact-num) .
     1058     end.
     1059     if p-fact-num < 0
     1060     then do:
     1061       return error "Отрицательный fact-num " + string(p-fact-num) .
     1062     end.
     1063     if p-fact-num >= 100000000
     1064     then do:
     1065       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1066     end.
     1067     if p-shift-on = true
     1068     then do:
     1069       if p-shift-date = ?
     1070       then do:
     1071         return error "Не задана дата смены" .
     1072       end.
     1073       if p-shift-num = ?
     1074       or p-shift-num = 0
     1075       then do:
     1076         return error "Не задан номер смены" .
     1077       end.
     1078     end.
     1079     else do:
     1080       assign
     1081         p-shift-date = p-fact-date
     1082         p-shift-num  = 24
     1083       .
     1084     end.
     1085     define variable v-shift-offset as integer no-undo .
     1086     if p-shift-date = p-fact-date
     1087     then do:
     1088       assign
     1089         v-shift-offset = 1
     1090       .
     1091     end.
     1092     if p-shift-date < p-fact-date
     1093     then do:
     1094       assign
     1095         v-shift-offset = 0
     1096       .
     1097     end.
     1098     if p-shift-date > p-fact-date
     1099     then do:
     1100       message
     1101         vss-workfile vss-revision vss-description skip
     1102         "Неправильная дата закрытия смены" skip
     1103         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1104         view-as alert-box error .
     1105       undo, return error
     1106         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1107           ,string(p-fact-date, '99/99/9999':U)
     1108           ,string(p-shift-date, '99/99/9999':U)
     1109           )
     1110       .
     1111     end.
     1112     if p-shift-num < 1
     1113     or p-shift-num > 24
     1114     then do:
     1115       message
     1116         vss-workfile vss-revision vss-description skip
     1117         "Неправильный номер смены" skip
     1118         "p-shift-num" p-shift-num skip
     1119         view-as alert-box error .
     1120       undo, return error return-value .
     1121     end.
     1122     assign
     1123       p-fact-order           = v-fact-date-num
     1124                              + v-shift-offset * 0.5
     1125                              + p-shift-num    * 0.02 - 0.01
     1126                              + p-fact-num     * 0.0000000001
     1127       p-shift-end-fact-order = v-fact-date-num
     1128                              + v-shift-offset * 0.5
     1129                              + p-shift-num    * 0.02
     1130       p-day-end-fact-order   = v-fact-date-num
     1131                              + 0.99
     1132     .
     1133     if p-fact-order           <= v-fact-date-num
     1134     or p-shift-end-fact-order <= v-fact-date-num
     1135     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1136     or p-shift-end-fact-order >= p-day-end-fact-order
     1137     then do:
     1138       message
     1139         vss-workfile vss-revision vss-description skip
     1140         "Внутренняя ошибка при генерации фактического номера" skip
     1141         "p-fact-date"            p-fact-date            skip
     1142         "p-fact-time"            p-fact-time            skip
     1143         "p-fact-num"             p-fact-num             skip
     1144         "p-shift-date"           p-shift-date           skip
     1145         "p-shift-num"            p-shift-num            skip
     1146         "p-shift-on"             p-shift-on             skip
     1147         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1148         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1149         "v-fact-date-num"        v-fact-date-num        skip
     1150         view-as alert-box error .
     1151       undo, return error return-value .
     1152     end.
     1153   end procedure.
     1154   procedure day-begin-fact-order :
     1155     define input  parameter p-fact-date            as date    no-undo .
     1156     define output parameter p-day-begin-fact-order as decimal no-undo .
     1157     do
     1158     on error undo, return error return-value
     1159     :
     1160       if p-fact-date = ?
     1161       then do:
     1162         assign
     1163           p-day-begin-fact-order = 0
     1164         .
     1165       end.
     1166       else do:
     1167         assign
     1168           p-day-begin-fact-order = integer(p-fact-date)
     1169         .
     1170       end.
     1171     end.
     1172   end procedure.
     1173   procedure factord-max-fact-order :
     1174     define output parameter p-max-fact-order as decimal   no-undo .
     1175     do
     1176     on error undo, return error return-value
     1177     :
     1178       run day-begin-fact-order in this-procedure
     1179         (input  date(1, 1, 5000)
     1180         ,output p-max-fact-order
     1181         ) .
     1182     end.
     1183   end procedure.
     1184   procedure factord-cut-archive :
     1185     define input  parameter p-obj-type             as character no-undo .
     1186     define input  parameter p-obj-code             as integer   no-undo .
     1187     define input  parameter p-fact-date            as date      no-undo .
     1188     define output parameter p-shift-on             as logical   no-undo .
     1189     define output parameter p-shift-date           as date      no-undo .
     1190     define output parameter p-shift-num            as integer   no-undo .
     1191     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1192     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1193     define variable v-fact-order as decimal   no-undo .
     1194     define buffer buf_shift-obj for ub.shift-obj .
     1195     do
     1196     on error undo, return error return-value
     1197     :
     1198   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1200     (input  p-obj-type
     1201     ,input  p-obj-code
     1202     ,input  'shift-on=request'
     1203     ,output p-shift-on
     1204     ) no-error .
     1205       if error-status :error
     1206       then do:
     1207         message
     1208           vss-workfile vss-revision vss-description skip
     1209           "Ошибка при определении атрибута объекта" skip
     1210           "Объект" p-obj-type p-obj-code skip
     1211           error-status :get-message(1) skip
     1212           return-value skip
     1213           view-as alert-box error .
     1214         undo, return error return-value .
     1215       end.
     1216       if p-shift-on = false
     1217       then do:
     1218         assign
     1219           p-shift-date               = ?
     1220           p-shift-num                = 0
     1221         .
     1222       end.
     1223       else do:
     1224         find first buf_shift-obj share-lock
     1225           where buf_shift-obj.obj-type   = p-obj-type
     1226             and buf_shift-obj.obj-code   = p-obj-code
     1227             and buf_shift-obj.shift-date > p-fact-date
     1228           use-index pi
     1229           no-error .
     1230         if not available buf_shift-obj
     1231         or buf_shift-obj.status_ <> 'зкр':U
     1232         then do:
     1233           message
     1234             vss-workfile vss-revision vss-description skip
     1235             "Невозможно вычислить последнюю смену" skip
     1236             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1237             "Объект" p-obj-type p-obj-code skip
     1238             "Дата" p-fact-date skip
     1239             view-as alert-box error .
     1240           undo, return error return-value .
     1241         end.
     1242         find last buf_shift-obj share-lock
     1243           where buf_shift-obj.obj-type = p-obj-type
     1244             and buf_shift-obj.obj-code = p-obj-code
     1245             and buf_shift-obj.shift-date <= p-fact-date
     1246           use-index pi
     1247           no-error .
     1248         if available buf_shift-obj
     1249         then do:
     1250           if  buf_shift-obj.status_ = 'зкр':U
     1251           then do:
     1252             assign
     1253               p-shift-date = buf_shift-obj.shift-date
     1254               p-shift-num  = buf_shift-obj.shift-num
     1255             .
     1256           end.
     1257           else do:
     1258             message
     1259               vss-workfile vss-revision vss-description skip
     1260               "Невозможно вычислить последнюю смену" skip
     1261               "Статус смены отличен от статуса" 'зкр':U skip
     1262               "Объект" p-obj-type p-obj-code skip
     1263               "Дата" p-fact-date skip
     1264               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1265               view-as alert-box error .
     1266             undo, return error return-value .
     1267           end.
     1268         end.
     1269         else do:
     1270           assign
     1271             p-shift-date = p-fact-date - 1
     1272             p-shift-num  = 1
     1273           .
     1274         end.
     1275       end.
     1276       run factord in this-procedure
     1277         (input  p-fact-date
     1278         ,input  1
     1279         ,input  1
     1280         ,input  p-shift-date
     1281         ,input  p-shift-num
     1282         ,input  p-shift-on
     1283         ,output v-fact-order
     1284         ,output p-shift-end-fact-order
     1285         ,output p-day-end-fact-order
     1286         ) no-error .
     1287       if error-status :error
     1288       then do:
     1289         message
     1290           vss-workfile vss-revision vss-description skip
     1291           "Ошибка при вызове процедуры factord"
     1292           error-status :get-message(1) skip
     1293           return-value skip
     1294           view-as alert-box error .
     1295         undo, return error return-value .
     1296       end.
     1297     end.
     1298   end procedure.
     1299   procedure factord-lock-shift :
     1300     define input  parameter p-obj-type  as character no-undo .
     1301     define input  parameter p-obj-code  as integer   no-undo .
     1302     define input  parameter p-fact-date as date      no-undo .
     1303     define parameter buffer buf_shift-obj for ub.shift-obj .
     1304     define variable v-shift-on      as logical   no-undo .
     1305     define variable v-extra-message as character no-undo .
     1306     define variable v-error as character no-undo .
     1307     do
     1308     on error undo, return error return-value
     1309     :
     1310   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1311   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1312     (input  p-obj-type
     1313     ,input  p-obj-code
     1314     ,input  'shift-on=request'
     1315     ,output v-shift-on
     1316     ) no-error .
     1317       if error-status :error
     1318       then do:
     1319         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1320         undo, return error v-error .
     1321       end.
     1322       if v-shift-on = true
     1323       then do:
     1324         find first buf_shift-obj share-lock
     1325           where buf_shift-obj.obj-type   = p-obj-type
     1326             and buf_shift-obj.obj-code   = p-obj-code
     1327             and buf_shift-obj.shift-date > p-fact-date
     1328           use-index pi
     1329           no-error .
     1330         if not available buf_shift-obj
     1331         or buf_shift-obj.status_ <> 'зкр':U
     1332         then do:
     1333           find last buf_shift-obj
     1334             where buf_shift-obj.obj-type = p-obj-type
     1335               and buf_shift-obj.obj-code = p-obj-code
     1336               and buf_shift-obj.status_  = 'зкр':U
     1337             use-index stts
     1338             no-error .
     1339           if available buf_shift-obj
     1340           then do:
     1341             assign
     1342               v-extra-message =
     1343                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1344                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1345                               )
     1346             .
     1347           end.
     1348           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1349           undo, return error v-error .
     1350         end.
     1351       end.
     1352     end.
     1353   end procedure.
     1354   procedure factord-end-day :
     1355     define input  parameter p-fact-date            as date    no-undo .
     1356     define output parameter p-day-end-fact-order   as decimal no-undo .
     1357     do
     1358     on error undo, return error return-value
     1359     :
     1360       if p-fact-date = ?
     1361       then do:
     1362         return error "Не указана фактическая дата" .
     1363       end.
     1364       assign
     1365         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1366       .
     1367     end.
     1368   end procedure.
     1369   procedure factord-to-date :
     1370     define input  parameter p-fact-order as decimal no-undo .
     1371     define output parameter p-fact-date  as date    no-undo .
     1372     define variable v-ref-date  as date      no-undo .
     1373     define variable v-ref-delta as integer   no-undo .
     1374     do
     1375     on error undo, return error return-value
     1376     :
     1377       if p-fact-order = ?
     1378       or p-fact-order = 0
     1379       then do:
     1380         return error "Не указан fact-order" .
     1381       end.
     1382       assign
     1383         v-ref-date  = date(1, 1, 2000)
     1384       .
     1385       assign
     1386         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1387       .
     1388       assign
     1389         p-fact-date = v-ref-date + v-ref-delta
     1390       .
     1391     end.
     1392   end procedure.
     1393   procedure factord-to-fact-num :
     1394     define input  parameter p-fact-order as decimal no-undo .
     1395     define output parameter p-fact-num   as integer no-undo .
     1396     define variable v-fact-order-trunc as decimal no-undo .
     1397     do
     1398     on error undo, return error return-value
     1399     :
     1400       if p-fact-order = ?
     1401       or p-fact-order = 0
     1402       then do:
     1403         return error "Не указан fact-order" .
     1404       end.
     1405       assign
     1406        v-fact-order-trunc = truncate(p-fact-order, 2)
     1407       .
     1408       assign
     1409         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1410       .
     1411     end.
     1412   end procedure.
     1413   procedure factord-to-shift-num :
     1414     define input  parameter p-fact-order as decimal no-undo .
     1415     define output parameter p-shift-num   as integer no-undo .
     1416     define variable  p-shift-numd  as decimal   no-undo .
     1417     define variable v-fact-order-trunc as decimal no-undo .
     1418     do
     1419     on error undo, return error return-value
     1420     :
     1421       if p-fact-order = ?
     1422       or p-fact-order = 0
     1423       then do:
     1424         return error "Не указан fact-order" .
     1425       end.
     1426       assign
     1427        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1428       .
     1429       if v-fact-order-trunc < 0.5 then do:
     1430         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1431       end.
     1432       assign
     1433         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1434         .
     1435        assign
     1436         p-shift-num = truncate (p-shift-numd , 0)
     1437       .
     1438     end.
     1439   end procedure.
     1440   PROCEDURE ostatok :
     1441   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1442   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1443   def input parameter x-tog-shift   as   logical             no-undo.
     1444   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1445   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1446   def input parameter x-shift-start as integer               no-undo.
     1447   def input parameter x-shift-end   as integer               no-undo.
     1448   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1449   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1450   def input parameter xTog-obj   as log no-undo.
     1451   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1452   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1453   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1454   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1455   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1456   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1457   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1458   def var              Fact-orderS   as char  no-undo.
     1459   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1460      Assign
     1461         Fact-order   = 0
     1462         Quantity     = 0
     1463         Coast_R      = 0
     1464         Coast_V      = 0
     1465         VAT_R        = 0
     1466         VAT_V        = 0 .
     1467    x-date-start-t  = x-date-start + 1 .
     1468   IF x-date-end = date('') then DO:
     1469      Fact-order = 0 .
     1470      for each obj-list
     1471          where  ( not xtog-obj or
     1472                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1473                 no-lock :
     1474         if  x-tog-shift = false then do:
     1475                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1476                               ub.stk-tot.Fact-date <=  x-date-start
     1477                               and ub.stk-tot.shift-num = 0
     1478                               USE-INDEX fact-date no-lock no-error .
     1479              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1480         End.
     1481         Else  DO :
     1482             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1483              (ub.stk-tot.shift-date  = x-date-start-t and
     1484               ub.stk-tot.shift-num  < x-shift-start or
     1485               ub.stk-tot.shift-date  < x-date-start-t  )
     1486               and ub.stk-tot.shift-num  > 0
     1487               USE-INDEX Shift-num no-lock no-error .
     1488            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1489           END.
     1490       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1491     End.
     1492   End.
     1493   Else DO:
     1494     For each obj-list  WHERE
     1495        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1496         no-lock :
     1497      IF  x-TOG-Shift = False Then DO:
     1498          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1499               ub.stk-tot.Fact-date <= x-date-end
     1500               and ub.stk-tot.shift-num = 0
     1501               USE-INDEX fact-date no-lock no-error.
     1502          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1503      END.
     1504      Else DO:
     1505           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1506               (ub.stk-tot.shift-date  = x-date-end and
     1507               ub.stk-tot.shift-num  <= x-shift-end or
     1508               ub.stk-tot.shift-date  < x-date-end       ) and
     1509               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1510               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1511       End.
     1512       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1513     End.
     1514   End.
     1515   END PROCEDURE.
     1516   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1517   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1518   procedure paramls-clear :
     1519     define buffer buf_temp-param for temp-param .
     1520     do
     1521     on error undo, return error return-value
     1522     :
     1523       for each buf_temp-param
     1524       on error undo, return error
     1525       :
     1526         delete buf_temp-param .
     1527       end.
     1528     end.
     1529   end procedure.
     1530   procedure paramls-write :
     1531     define input  parameter p-code     as character no-undo .
     1532     define input  parameter p-sub-code as character no-undo .
     1533     define input  parameter p-value    as character no-undo .
     1534     define buffer buf_temp-param for temp-param .
     1535     do
     1536     on error undo, return error return-value
     1537     :
     1538       find first buf_temp-param
     1539         where buf_temp-param.param-code     = p-code
     1540           and buf_temp-param.param-sub-code = p-sub-code
     1541         no-error .
     1542       if not available buf_temp-param then do:
     1543         create buf_temp-param .
     1544         assign
     1545           buf_temp-param.param-code     = p-code
     1546           buf_temp-param.param-sub-code = p-sub-code
     1547         .
     1548       end.
     1549       assign
     1550         buf_temp-param.param-value = p-value
     1551       .
     1552     end.
     1553   end procedure.
     1554   procedure paramls-read :
     1555     define input  parameter p-code          as character no-undo .
     1556     define input  parameter p-sub-code      as character no-undo .
     1557     define input  parameter p-default-value as character no-undo .
     1558     define output parameter p-value         as character no-undo .
     1559     define buffer buf_temp-param for temp-param .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       find first buf_temp-param
     1564         where buf_temp-param.param-code     = p-code
     1565           and buf_temp-param.param-sub-code = p-sub-code
     1566         no-error .
     1567       if available buf_temp-param then do:
     1568         assign
     1569           p-value = buf_temp-param.param-value
     1570         .
     1571       end.
     1572       else do:
     1573         assign
     1574           p-value = p-default-value
     1575         .
     1576       end.
     1577     end.
     1578   end procedure.
     1579   procedure paramls-append :
     1580     define input  parameter p-code     as character no-undo .
     1581     define input  parameter p-sub-code as character no-undo .
     1582     define input  parameter p-value    as character no-undo .
     1583     define buffer buf_temp-param for temp-param .
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587       find first buf_temp-param
     1588            where buf_temp-param.param-code     = p-code
     1589              and buf_temp-param.param-sub-code = p-sub-code
     1590         no-error .
     1591       if not available buf_temp-param then do:
     1592         create buf_temp-param .
     1593         assign
     1594           buf_temp-param.param-code     = p-code
     1595           buf_temp-param.param-sub-code = p-sub-code
     1596           buf_temp-param.param-value    = p-value
     1597         .
     1598       end.
     1599       else do:
     1600           assign
     1601               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1602           .
     1603       end.
     1604     end.
     1605   end procedure.
     1606   define stream excel-line.
     1607   define stream excel-cell.
     1608   define variable v-tdsxl-sheet1-cur-data-row     as integer      no-undo.
     1609   define variable v-tdsxl-sheet2-cur-data-row     as integer      no-undo.
     1610   define variable v-tdsxl-cell-file-name       as character    no-undo.
     1611   define variable v-tdsxl-data-file-name       as character    no-undo.
     1612   procedure tdsxl-init :
     1613       run gbl/_tmpfile.p (
     1614             input "xd"
     1615           , input ".txt"
     1616           , output v-tdsxl-data-file-name
     1617       ).
     1618       output stream excel-line to value( v-tdsxl-data-file-name ).
     1619       run gbl/_tmpfile.p (
     1620             input "xc"
     1621           , input ".txt"
     1622           , output v-tdsxl-cell-file-name
     1623       ).
     1624       output stream excel-cell to value( v-tdsxl-cell-file-name ).
     1625       run tdsxl-write-cell-data in this-procedure (
     1626             input "sheetList":U
     1627           , input "Сводка":U
     1628       ).
     1629       run tdsxl-write-cell-data in this-procedure (
     1630             input "Сводка_valutCode":U
     1631           , input "0":U
     1632       ).
     1633       run tdsxl-write-cell-data in this-procedure (
     1634             input "Сводка_columnList":U
     1635           , input "shop_num,gds_name,impl_day,impl_month,price_impl_now,price_impl_change,f1,f2,f3,f4,f5,proc_day,proc_month":U
     1636       ).
     1637       run tdsxl-write-cell-data in this-procedure (
     1638             input "Сводка_columnType":U
     1639           , input "I,S,D,D,D,D,D,D,D,D,D,D,D":U
     1640       ).
     1641       run tdsxl-write-cell-data in this-procedure (
     1642             input "Сводка_subtotalList":U
     1643           , input "":U
     1644       ).
     1645       run tdsxl-write-cell-data in this-procedure (
     1646             input "Сводка_subtotalType":U
     1647           , input "":U
     1648       ).
     1649   end procedure.
     1650   procedure tdsxl-sheet1-write-line-data :
     1651       define input parameter p-shop-num as character no-undo.
     1652       define input parameter p-gds-name as character no-undo.
     1653       define input parameter p-impl-day as decimal no-undo.
     1654       define input parameter p-impl-month as decimal no-undo.
     1655       define input parameter p-price-impl-now as decimal no-undo.
     1656       define input parameter p-price-impl-change as decimal no-undo.
     1657       define input parameter p-proc-day as character no-undo.
     1658       define input parameter p-proc-month as character no-undo.
     1659       put stream excel-line UNFORMATTED
     1660           "Сводка":U
     1661           CHR(9) "DTA":U
     1662           CHR(9) p-shop-num
     1663           CHR(9) p-gds-name
     1664           CHR(9) p-impl-day
     1665           CHR(9) p-impl-month
     1666           CHR(9) p-price-impl-now
     1667           CHR(9) p-price-impl-change
     1668           CHR(9) 0
     1669           CHR(9) 0
     1670           CHR(9) 0
     1671           CHR(9) 0
     1672           CHR(9) 0
     1673           CHR(9) p-proc-day
     1674           CHR(9) p-proc-month
     1675           chr(10)
     1676       .
     1677   end procedure.
     1678   procedure tdsxl-write-cell-data :
     1679       define input parameter p-key as character no-undo.
     1680       define input parameter p-val as character no-undo.
     1681       put stream excel-cell UNFORMATTED
     1682           p-key CHR(9) p-val chr(10)
     1683       .
     1684   end procedure.
     1685   procedure tdsxl-close :
     1686       output to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".txl" ) append.
     1687       export "exe/tdsum.xlt":U.
     1688       export "exe/t_form.bas":U.
     1689       export v-tdsxl-cell-file-name.
     1690       export v-tdsxl-data-file-name.
     1691       output stream excel-line close.
     1692       output stream excel-cell close.
     1693   end procedure.
     1694   define variable v-all-units as character no-undo.
     1695   define stream Out-Stream.
     1696   define temp-table tt-line no-undo
     1697       field artic as character
     1698       field prod-type as character
     1699       field prod-code as integer
     1700       field obj-type as character
     1701       field obj-code as integer
     1702       field gds-code as integer
     1703       field gds-name as character
     1704       field is-petrol as logical
     1705       field qnty-start-month as decimal
     1706       field qnty-start-day as decimal
     1707       field price-end-shift as decimal
     1708       field price-shift-change as decimal
     1709       field sum-day as decimal
     1710       field sum-month as decimal
     1711       index pi as unique artic prod-type prod-code obj-type obj-code
     1712       index pi2 as unique primary gds-code obj-type obj-code
     1713   .
     1714   define temp-table tt-sum no-undo
     1715       field obj-type as character
     1716       field obj-code as integer
     1717       field sum-day as decimal
     1718       field sum-month as decimal
     1719       index pi as unique obj-type obj-code
     1720   .
     1721   run prepare-rep.
     1722   run fill-goods.
     1723   run calc.
     1724   run format-rep.
     1725   run close-rep.
     1726   procedure prepare-rep:
     1727       run get-gds-engl    in my-handle ( output g#gds-engl ).
     1728       run get-quest-print in my-handle ( output g#quest-print ).
     1729       run get-report-num  in my-handle ( output g#report-num ).
     1730   output STREAM Out-Stream to value( string( session:temp-directory +
     1731                                        "rpt" + string( g#report-num ) ) )
     1732                                        page-size  value(43) .
     1733       put stream Out-Stream UNFORMATTED "Отчет доступен только в формате Excel.".
     1734   end.
     1735   procedure close-rep:
     1736       define variable v-user-action   as character no-undo .
     1737       define variable v-printed       as logical   no-undo .
     1738       define variable ReportFontNum   as integer   no-undo .
     1739       output stream Out-Stream close.
     1740       run gbl/prnfilen.w
     1741           ( input  ""
     1742           , input  8
     1743           , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1744           , input  ReportFontNum
     1745           , output v-user-action
     1746           , output v-printed
     1747           ) .
     1748       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1749   end.
     1750   procedure fill-goods:
     1751       define variable v-grp-fullname as character no-undo.
     1752       define buffer lc_goods for ub.goods.
     1753       define buffer lc_gds-obj for ub.gds-obj.
     1754       for each obj-list no-lock:
     1755           case x-SelectGood:
     1756               when 1 then do:
     1757                    for each lc_gds-obj no-lock
     1758                       where lc_gds-obj.obj-type = obj-list.obj-type
     1759                       and lc_gds-obj.obj-code = obj-list.obj-code
     1760                       :
     1761                           run create-line(
     1762                               lc_gds-obj.artic,
     1763                               lc_gds-obj.prod-type,
     1764                               lc_gds-obj.prod-code,
     1765                               lc_gds-obj.obj-type,
     1766                               lc_gds-obj.obj-code
     1767                           ).
     1768                    end.
     1769               end.
     1770               when 3 then do:
     1771                   for each g#cli no-lock:
     1772                       for each lc_gds-obj no-lock
     1773                           where lc_gds-obj.obj-type = obj-list.obj-type
     1774                           and lc_gds-obj.obj-code = obj-list.obj-code
     1775                           and lc_gds-obj.prod-type = g#cli.obj-type
     1776                           and lc_gds-obj.prod-code = g#cli.obj-code
     1777                           :
     1778                               run create-line(
     1779                                   lc_gds-obj.artic,
     1780                                   lc_gds-obj.prod-type,
     1781                                   lc_gds-obj.prod-code,
     1782                                   lc_gds-obj.obj-type,
     1783                                   lc_gds-obj.obj-code
     1784                               ).
     1785                       end.
     1786                   end.
     1787               end.
     1788               when 2 then do:
     1789                   for each tmp#grp no-lock:
     1790                       run grplib-get-full-name(tmp#grp.node-code, output v-grp-fullname).
     1791                       for each lc_gds-obj no-lock
     1792                           where lc_gds-obj.obj-type = obj-list.obj-type
     1793                           and lc_gds-obj.obj-code = obj-list.obj-code
     1794                           and lc_gds-obj.grp-name begins v-grp-fullname
     1795                           :
     1796                               run create-line(
     1797                                   lc_gds-obj.artic,
     1798                                   lc_gds-obj.prod-type,
     1799                                   lc_gds-obj.prod-code,
     1800                                   lc_gds-obj.obj-type,
     1801                                   lc_gds-obj.obj-code
     1802                               ).
     1803                       end.
     1804                   end.
     1805               end.
     1806               otherwise do:
     1807                   for each gds-list no-lock:
     1808                       for each lc_gds-obj no-lock
     1809                           where lc_gds-obj.obj-type = obj-list.obj-type
     1810                           and lc_gds-obj.obj-code = obj-list.obj-code
     1811                           and lc_gds-obj.artic = gds-list.artic
     1812                           and lc_gds-obj.prod-type = gds-list.prod-type
     1813                           and lc_gds-obj.prod-code = gds-list.prod-code
     1814                           :
     1815                               run create-line(
     1816                                   lc_gds-obj.artic,
     1817                                   lc_gds-obj.prod-type,
     1818                                   lc_gds-obj.prod-code,
     1819                                   lc_gds-obj.obj-type,
     1820                                   lc_gds-obj.obj-code
     1821                               ).
     1822                       end.
     1823                   end.
     1824               end.
     1825           end.
     1826       end.
     1827   end.
     1828   procedure get-factord:
     1829       define input parameter p-obj-type       as character no-undo.
     1830       define input parameter p-obj-code       as integer   no-undo.
     1831       define input parameter p-shift-date     as date      no-undo.
     1832       define input parameter p-shift-num      as integer   no-undo.
     1833       define input parameter p-type           as integer   no-undo.
     1834       define output parameter p-factord        as decimal   no-undo.
     1835       define variable tmp as decimal no-undo.
     1836       if p-type = 1 and p-shift-num > 0 then
     1837           run ostatok(
     1838               p-obj-code,
     1839               p-obj-type,
     1840               true,
     1841               p-shift-date - 1,
     1842               date(''),
     1843               p-shift-num,
     1844               p-shift-num,
     1845               'cost':U,
     1846               '##,##':U,
     1847               true,
     1848               output tmp,
     1849               output tmp,
     1850               output tmp,
     1851               output tmp,
     1852               output tmp,
     1853               output p-factord
     1854           ).
     1855       else if p-type = 2 and p-shift-num > 0 then
     1856           run ostatok(
     1857               p-obj-code,
     1858               p-obj-type,
     1859               true,
     1860               p-shift-date,
     1861               p-shift-date,
     1862               p-shift-num,
     1863               p-shift-num,
     1864               'cost':U,
     1865               '##,##':U,
     1866               true,
     1867               output tmp,
     1868               output tmp,
     1869               output tmp,
     1870               output tmp,
     1871               output tmp,
     1872               output p-factord
     1873           ).
     1874       else if p-type = 1 then
     1875           run day-begin-fact-order(p-shift-date, output p-factord).
     1876       else if p-type = 2 then
     1877           run factord-end-day(p-shift-date, output p-factord).
     1878   end.
     1879   procedure calc:
     1880       for each tt-line:
     1881           run calc-day.
     1882           run calc-month.
     1883           if tt-line.is-petrol then
     1884               run calc-price.
     1885       end.
     1886       run calc-sum-etc.
     1887   end.
     1888   procedure calc-sum-etc:
     1889       for each obj-list,
     1890           each tt-line
     1891           where tt-line.obj-type = obj-list.obj-type
     1892           and tt-line.obj-code = obj-list.obj-code
     1893           break by obj-list.obj-code:
     1894               if first-of(obj-list.obj-code) then do:
     1895                   create tt-sum.
     1896                   assign
     1897                       tt-sum.obj-type = obj-list.obj-type
     1898                       tt-sum.obj-code = obj-list.obj-code
     1899                       tt-sum.sum-day = tt-line.sum-day
     1900                       tt-sum.sum-month = tt-line.sum-month
     1901                   .
     1902               end.
     1903               else do:
     1904                   assign
     1905                       tt-sum.sum-day = tt-sum.sum-day + tt-line.sum-day.
     1906                       tt-sum.sum-month = tt-line.sum-month + tt-line.sum-month.
     1907                   .
     1908               end.
     1909       end.
     1910   end.
     1911   procedure calc-price:
     1912       define variable v-b-code as integer no-undo.
     1913       define variable v-doc-num as integer no-undo.
     1914       define variable v-price-sale as integer no-undo.
     1915       define variable v-road-tax as integer no-undo.
     1916       define variable v-excise as integer no-undo.
     1917       define variable v-factord-end as decimal no-undo.
     1918       define variable v-factorder-last as decimal no-undo.
     1919       define variable v-prev-date as date no-undo.
     1920       run get-factord(
     1921           tt-line.obj-type,
     1922           tt-line.obj-code,
     1923           x-Date-Start,
     1924           x-Shift-Start,
     1925           2,
     1926           output v-factord-end
     1927       ).
     1928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1929     (input  tt-line.gds-code
     1930     ,input  ?
     1931     ,output v-b-code
     1932     ) no-error .
     1933   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1935     (input  tt-line.obj-type
     1936     ,input  tt-line.obj-code
     1937     ,input  v-b-code
     1938     ,input  0
     1939     ,input  v-factord-end
     1940     ,output v-doc-num
     1941     ,output v-price-sale
     1942     ,output v-road-tax
     1943     ,output v-excise
     1944     )  .
     1945       if v-price-sale = ? then
     1946           v-price-sale = 0.
     1947       tt-line.price-end-shift = v-price-sale.
     1948       v-prev-date = add-interval(today, -1, "days").
     1949       run factord-end-day(v-prev-date, output v-factorder-last).
     1950   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1951   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1952     (input  tt-line.obj-type
     1953     ,input  tt-line.obj-code
     1954     ,input  v-b-code
     1955     ,input  0
     1956     ,input  v-factorder-last
     1957     ,output v-doc-num
     1958     ,output v-price-sale
     1959     ,output v-road-tax
     1960     ,output v-excise
     1961     )  .
     1962       if v-price-sale = ? then
     1963           v-price-sale = 0.
     1964       tt-line.price-shift-change = tt-line.price-end-shift - v-price-sale.
     1965   end.
     1966   procedure calc-month:
     1967       define variable v-factord-start as decimal no-undo.
     1968       define variable v-factord-end   as decimal no-undo.
     1969       define variable v-date          as date    no-undo.
     1970       define buffer lc_ot-line for ub.ot-line.
     1971       v-date = add-interval(x-Date-Start, -1, "months").
     1972       run get-factord(
     1973           tt-line.obj-type,
     1974           tt-line.obj-code,
     1975           v-date,
     1976           0,
     1977           1,
     1978           output v-factord-start
     1979       ).
     1980       run get-factord(
     1981           tt-line.obj-type,
     1982           tt-line.obj-code,
     1983           x-Date-Start,
     1984           0,
     1985           2,
     1986           output v-factord-end
     1987       ).
     1988       for each lc_ot-line no-lock
     1989           where lc_ot-line.artic = tt-line.artic
     1990           and lc_ot-line.prod-type = tt-line.prod-type
     1991           and lc_ot-line.prod-code = tt-line.prod-code
     1992           and lc_ot-line.obj-type = tt-line.obj-type
     1993           and lc_ot-line.obj-code = tt-line.obj-code
     1994           and lc_ot-line.cat-id = '##,##':U
     1995           and lc_ot-line.sum-type = 'cost':U
     1996           and lc_ot-line.fact-order >= v-factord-start
     1997           and lc_ot-line.fact-order <= v-factord-end
     1998           :
     1999               if lc_ot-line.ext-doc-type = 'rs':U then do:
     2000                   if tt-line.is-petrol then
     2001                       tt-line.qnty-start-month = tt-line.qnty-start-month + lc_ot-line.fact-qnty.
     2002                   else
     2003                       tt-line.sum-month = tt-line.sum-month + lc_ot-line.sum-rubl.
     2004               end.
     2005               else if lc_ot-line.ext-doc-type = 'es':U then do:
     2006                   if tt-line.is-petrol then
     2007                       tt-line.qnty-start-month = tt-line.qnty-start-month - lc_ot-line.fact-qnty.
     2008                   else
     2009                       tt-line.sum-month = tt-line.sum-month - lc_ot-line.sum-rubl.
     2010               end.
     2011       end.
     2012   end.
     2013   procedure calc-day:
     2014       define variable v-factord-start as decimal no-undo.
     2015       define variable v-factord-end   as decimal no-undo.
     2016       define buffer lc_ot-line for ub.ot-line.
     2017       run get-factord(
     2018           tt-line.obj-type,
     2019           tt-line.obj-code,
     2020           x-Date-Start,
     2021           x-Shift-Start,
     2022           1,
     2023           output v-factord-start
     2024       ).
     2025       run get-factord(
     2026           tt-line.obj-type,
     2027           tt-line.obj-code,
     2028           x-Date-Start,
     2029           x-Shift-Start,
     2030           2,
     2031           output v-factord-end
     2032       ).
     2033       for each lc_ot-line no-lock
     2034           where lc_ot-line.artic = tt-line.artic
     2035           and lc_ot-line.prod-type = tt-line.prod-type
     2036           and lc_ot-line.prod-code = tt-line.prod-code
     2037           and lc_ot-line.obj-type = tt-line.obj-type
     2038           and lc_ot-line.obj-code = tt-line.obj-code
     2039           and lc_ot-line.cat-id = '##,##':U
     2040           and lc_ot-line.sum-type = 'cost':U
     2041           and lc_ot-line.fact-order >= v-factord-start
     2042           and lc_ot-line.fact-order <= v-factord-end
     2043           :
     2044               if lc_ot-line.ext-doc-type = 'rs':U then do:
     2045                   if tt-line.is-petrol then
     2046                       tt-line.qnty-start-day = tt-line.qnty-start-day + lc_ot-line.fact-qnty.
     2047                   else
     2048                       tt-line.sum-day = tt-line.sum-day + lc_ot-line.sum-rubl.
     2049               end.
     2050               else if lc_ot-line.ext-doc-type = 'es':U then do:
     2051                   if tt-line.is-petrol then
     2052                       tt-line.qnty-start-day = tt-line.qnty-start-day - lc_ot-line.fact-qnty.
     2053                   else
     2054                       tt-line.sum-day = tt-line.sum-day - lc_ot-line.sum-rubl.
     2055               end.
     2056       end.
     2057   end.
     2058   procedure create-line:
     2059       define input parameter p-artic as character no-undo.
     2060       define input parameter p-prod-type as character no-undo.
     2061       define input parameter p-prod-code as integer no-undo.
     2062       define input parameter p-obj-type as character no-undo.
     2063       define input parameter p-obj-code as integer no-undo.
     2064       define variable v-is-pieces as logical no-undo.
     2065       define buffer lc_goods for ub.goods.
     2066       find first tt-line
     2067           where tt-line.artic = p-artic
     2068           and tt-line.prod-type = p-prod-type
     2069           and tt-line.prod-code = p-prod-code
     2070           and tt-line.obj-type = p-obj-type
     2071           and tt-line.obj-code = p-obj-code
     2072           no-error.
     2073       if not avail tt-line then do:
     2074           find first lc_goods no-lock
     2075               where lc_goods.artic = p-artic
     2076               and lc_goods.prod-type = p-prod-type
     2077               and lc_goods.prod-code = p-prod-code.
     2078           create tt-line.
     2079           assign
     2080               tt-line.gds-code = lc_goods.gds-code
     2081               tt-line.artic = p-artic
     2082               tt-line.prod-type = p-prod-type
     2083               tt-line.prod-code = p-prod-code
     2084               tt-line.obj-type = p-obj-type
     2085               tt-line.obj-code = p-obj-code
     2086               tt-line.gds-name = lc_goods.gds-name
     2087           .
     2088   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2089     (
     2090        input tt-line.artic
     2091     ,  input tt-line.prod-type
     2092     ,  input tt-line.prod-code
     2093     , output tt-line.is-petrol
     2094     , output v-is-pieces
     2095     ) .
     2096       end.
     2097   end.
     2098   procedure format-rep:
     2099       define variable v-org-name as character no-undo.
     2100       define variable v-org-code as integer no-undo.
     2101       define variable v-shop-num as character no-undo.
     2102       define variable v-sum-day as character no-undo.
     2103       define variable v-sum-month as character no-undo.
     2104       run tdsxl-init.
     2105       find first obj-list.
     2106   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     2108     (input  obj-list.obj-type
     2109     ,input  obj-list.obj-code
     2110     ,output v-org-code
     2111     ,output v-org-name
     2112     )  .
     2113       run tdsxl-write-cell-data("org_name":U, v-org-name).
     2114       run tdsxl-write-cell-data("date_day":U, day(today)).
     2115       run tdsxl-write-cell-data("date_month":U, month(today)).
     2116       run tdsxl-write-cell-data("date_year":U, year(today)).
     2117       for each obj-list,
     2118           each tt-line
     2119               where tt-line.obj-type = obj-list.obj-type
     2120               and tt-line.obj-code = obj-list.obj-code
     2121               and tt-line.is-petrol,
     2122           first tt-sum
     2123               where obj-list.obj-type = tt-sum.obj-type
     2124               and obj-list.obj-code = tt-sum.obj-code
     2125           break by obj-list.obj-code
     2126           by tt-line.gds-name:
     2127               if first-of(obj-list.obj-code) then do:
     2128                   assign
     2129                       v-shop-num = string(obj-list.obj-code)
     2130                       v-sum-day = string(tt-sum.sum-day)
     2131                       v-sum-month = string(tt-sum.sum-month)
     2132                   .
     2133               end.
     2134               else do:
     2135                   assign
     2136                       v-shop-num = ""
     2137                       v-sum-day = ""
     2138                       v-sum-month = ""
     2139                   .
     2140               end.
     2141               run tdsxl-sheet1-write-line-data(
     2142                   v-shop-num,
     2143                   tt-line.gds-name,
     2144                   tt-line.qnty-start-day,
     2145                   tt-line.qnty-start-month,
     2146                   tt-line.price-end-shift,
     2147                   tt-line.price-shift-change,
     2148                   v-sum-day,
     2149                   v-sum-month
     2150               ).
     2151       end.
     2152       run tdsxl-close.
     2153   end.
