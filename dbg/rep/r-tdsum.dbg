        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: r-tdsum.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/r-tdsum.p $":U .
        7   define variable vss-description as character no-undo init "Суточные сводки (ТамбовНП)".
        8   define variable g#gds-engl       as logical    no-undo .
        9   define variable g#log            as logical    no-undo .
       10   define variable g#quest-print    as logical    no-undo .
       11   define variable g#report-num     as integer    no-undo .
