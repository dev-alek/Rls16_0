     1113     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1114     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1115     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1116     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1117     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1118     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1119     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1120     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1121     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1122     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1123     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1124     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1125     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1126     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1127     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1128     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1129     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1130     IF "":U = "":U THEN
     1131       RUN modify-list-attribute IN adm-broker-hdl
     1132         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1133     RUN use-create-on-add(?).
