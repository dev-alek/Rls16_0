     1069     RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE notify :
     1072     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1073     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1074     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1075         RETURN "ADM-ERROR":U.
     1076     RETURN.
