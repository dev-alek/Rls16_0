      902   DEFINE TEMP-TABLE tt-season NO-UNDO LIKE ub.season.
      903   CREATE WIDGET-POOL.
      904   define variable State-source    as  WIDGET-HANDLE   no-undo.
      905   define variable v-today         as date             no-undo.
      906   define variable v-time          as integer          no-undo.
      907   define variable v-prizn         as character        no-undo init "".
      908   DEFINE VARIABLE txt-prizn AS CHARACTER
      909        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      910        SIZE 38 BY 3.81 NO-UNDO.
      911   DEFINE VARIABLE Classify AS INTEGER INITIAL 1
      912        VIEW-AS RADIO-SET VERTICAL
      913        RADIO-BUTTONS
      914             "Без классификации", 1,
      915   "По производителю", 2,
      916   "По группам товаров", 3,
      917   "По НДС из карточки товара", 4
      918        SIZE 28.6 BY 3.71 NO-UNDO.
      919   DEFINE VARIABLE rs-prizn AS INTEGER
      920        VIEW-AS RADIO-SET VERTICAL
      921        RADIO-BUTTONS
      922             "Все признаки", 1,
      923   "Выборочно", 2
      924        SIZE 24 BY 1.91 NO-UNDO.
      925   DEFINE RECTANGLE RECT-12
      926        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      927        SIZE 77.8 BY 18.67.
      928   DEFINE VARIABLE Itog AS LOGICAL INITIAL no
      929        LABEL "Только итоги"
      930        VIEW-AS TOGGLE-BOX
      931        SIZE 28.8 BY .81 NO-UNDO.
      932   DEFINE VARIABLE tog-obj AS LOGICAL INITIAL yes
      933        LABEL "Раздельно по объектам"
      934        VIEW-AS TOGGLE-BOX
      935        SIZE 28.8 BY .81 NO-UNDO.
      936   DEFINE VARIABLE Zero AS LOGICAL INITIAL no
      937        LABEL "Нулевые количества по признакам"
      938        VIEW-AS TOGGLE-BOX
      939        SIZE 34.6 BY .81 NO-UNDO.
      940   DEFINE VARIABLE Zero-ost AS LOGICAL INITIAL no
      941        LABEL "Нулевые остатки"
      942        VIEW-AS TOGGLE-BOX
      943        SIZE 34.6 BY .81 NO-UNDO.
      944   DEFINE FRAME F-Main
      945        Classify AT ROW 2.38 COL 3 NO-LABEL
      946        Itog AT ROW 7.76 COL 3
      947        Zero-ost AT ROW 8.62 COL 3 WIDGET-ID 2
      948        Zero AT ROW 9.62 COL 3
      949        tog-obj AT ROW 10.62 COL 3
      950        rs-prizn AT ROW 13.48 COL 3 NO-LABEL WIDGET-ID 4
      951        txt-prizn AT ROW 15.52 COL 3 NO-LABEL WIDGET-ID 12
      952        "Классификация:":C28 VIEW-AS TEXT
      953             SIZE 28.8 BY .76 AT ROW 1.43 COL 3
      954             FGCOLOR 4
      955        "Показать:":C28 VIEW-AS TEXT
      956             SIZE 28.8 BY .76 AT ROW 6.81 COL 3
      957             FGCOLOR 4
      958        "Признаки:":C28 VIEW-AS TEXT
      959             SIZE 28.8 BY .76 AT ROW 12.52 COL 3 WIDGET-ID 8
      960             FGCOLOR 4
      961        RECT-12 AT ROW 1.14 COL 1
      962       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      963            SIDE-LABELS NO-UNDERLINE THREE-D
      964            AT COL 1 ROW 1 SCROLLABLE .
      965   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      966   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      967   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      968   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      969   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      970   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      971   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      972   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      973         adm-object-hdl = FRAME F-Main:HANDLE.
      974   RUN ensure-broker.
      975   THIS-PROCEDURE:ADM-DATA =
      976        'ADM1.1~`':U +
      977        'SmartObject~`':U +
      978        '~`':U +
      979        'NO ~`':U +
      980        '~`':U +
      981        '~`':U +
      982        '~`':U +
      983        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      984           + "~`":U +
      985        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      986        'Record-Source,Record-Target,TableIO-Target~`':U +
      987        '~`':U +
      988        '~`~`~`~`~`~`~`~`~`~`~`':U +
      989        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      990            THEN "^^":U
      991        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      992             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      993   PROCEDURE adm-apply-entry :
      994     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      995   END PROCEDURE.
      996   PROCEDURE adm-destroy :
      997    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      998   END PROCEDURE.
      999   PROCEDURE adm-disable :
     1000       DISABLE RECT-12 Classify Itog Zero-ost Zero tog-obj rs-prizn txt-prizn WITH FRAME F-Main.
     1001       RUN dispatch ('disable-fields':U).
     1002       RUN set-attribute-list ('ENABLED=no':U).
     1003       RETURN.
     1004   END PROCEDURE.
