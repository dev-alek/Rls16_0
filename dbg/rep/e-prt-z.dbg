     1186   PROCEDURE adm-update-record :
     1187       MESSAGE
     1188         "Object ":U THIS-PROCEDURE:FILE-NAME
     1189           "must have at least one Enabled Table to perform Update.":U
     1190             VIEW-AS ALERT-BOX ERROR.
     1191      RETURN.
     1192   END PROCEDURE.
     1193   PROCEDURE check-modified :
     1194   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1195   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1196   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1197   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1198     IF check-state = "check":U THEN
     1199     DO:
     1200       RUN get-link-handle IN adm-broker-hdl
     1201         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1202            OUTPUT group-target-list).
     1203       IF group-target-list NE "":U THEN
     1204       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1205         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1206         RUN check-modified IN curr-widget ('group-check':U).
     1207         IF RETURN-VALUE NE "":U THEN
     1208         DO:
     1209           RUN check-modified-message(RETURN-VALUE).
     1210           RETURN "":U.
     1211         END.
     1212       END.
     1213     END.
     1214     RETURN "":U.
     1215   END PROCEDURE.
     1216   PROCEDURE check-modified-message :
     1217     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1218        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1219           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1220        IF RETURN-VALUE = "YES":U THEN
     1221           RUN notify ('view,CONTAINER-SOURCE':U).
     1222        MESSAGE IF p-changed-table NE ? THEN
     1223           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1224           ELSE "Current values have been changed."
     1225           SKIP "  Do you wish to save those changes?"
     1226           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1227        IF ANS THEN
     1228        DO:
     1229           IF group-assign-target THEN
     1230             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1231           ELSE RUN dispatch('update-record':U).
     1232           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1233           DO:
     1234               MESSAGE "Changes to the previous record were not saved."
     1235                 VIEW-AS ALERT-BOX ERROR.
     1236               IF group-assign-target THEN
     1237                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1238               ELSE RUN dispatch ('cancel-record':U).
     1239           END.
     1240        END.
     1241        ELSE DO:
     1242          IF group-assign-target THEN
     1243             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1244          ELSE RUN dispatch('cancel-record':U).
     1245        END.
     1246        RETURN.
     1247   END PROCEDURE.
     1248   PROCEDURE get-rowid :
     1249       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1250       ASSIGN
     1251       p-table   =   adm-first-table.
     1252       RETURN.
     1253   END PROCEDURE.
     1254   PROCEDURE init-group-assign :
     1255       RUN request-attribute IN adm-broker-hdl
     1256         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1257       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1258         group-assign-target = yes.
     1259       ELSE group-assign-target = no.
     1260       RETURN.
     1261   END PROCEDURE.
     1262   PROCEDURE set-editors :
     1263       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1264       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1265       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1266       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1267       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1268       DO WHILE VALID-HANDLE (curr-widget):
     1269           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1270              curr-widget:HIDDEN = no THEN DO:
     1271             CASE p-field-setting:
     1272               WHEN "INITIALIZE":U THEN
     1273               DO:
     1274                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1275                     read-only-list +
     1276                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1277                        STRING(curr-widget).
     1278               END.
     1279               WHEN "DISABLE":U OR
     1280               WHEN "ENABLE":U THEN
     1281               DO:
     1282                   curr-widget:SENSITIVE = yes.
     1283                   RUN get-attribute ('Read-Only-Editors':U).
     1284                   IF RETURN-VALUE = ? OR
     1285                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1286                       curr-widget:READ-ONLY =
     1287                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1288               END.
     1289               WHEN "CLEAR":U THEN
     1290                   curr-widget:SCREEN-VALUE = "":U.
     1291             END CASE.
     1292           END.
     1293           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1294       END.
     1295       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1296         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1297           + '"':U).
     1298       RETURN.
     1299   END PROCEDURE.
     1300   PROCEDURE use-check-modified-all :
     1301    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1302     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1303     RETURN.
     1304   END PROCEDURE.
     1305   PROCEDURE use-create-on-add :
     1306   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1307      RETURN.
     1308   END PROCEDURE.
     1309   PROCEDURE use-initial-lock :
     1310     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1311     ASSIGN adm-initial-lock = p-attr-value.
     1312     RETURN.
     1313   END PROCEDURE.
     1314     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1315   ASSIGN
     1316          FRAME F-Main:SCROLLABLE       = FALSE
     1317          FRAME F-Main:HIDDEN           = TRUE.
     1318   ASSIGN
     1319          txt-prizn:READ-ONLY IN FRAME F-Main        = TRUE.
     1320   ON MOUSE-SELECT-DBLCLICK OF rs-prizn IN FRAME F-Main
     1321       do:
     1322   apply "VALUE-CHANGED" to rs-prizn in frame F-Main.
     1323   END.
     1324   ON VALUE-CHANGED OF tog-obj IN FRAME F-Main
     1325   DO:
     1326     ASSIGN tog-obj.
     1327   END.
     1328   ON VALUE-CHANGED OF rs-prizn IN FRAME F-Main
     1329   DO:
     1330       define variable prizn-cur as integer no-undo init 0.
     1331       assign rs-prizn.
     1332       case rs-prizn:
     1333           when 1 then do:
     1334               v-prizn = "".
     1335               txt-prizn:screen-value = "Выбраны признаки: все.".
     1336           end.
     1337           when 2 then do:
     1338               run rep/e-prt-z-d.p (input my-handle, input-output v-prizn).
     1339               if v-prizn = "" then do:
     1340                   rs-prizn = 1.
     1341                   rs-prizn:screen-value = "1".
     1342                   txt-prizn:screen-value = "Выбраны признаки: все.".
     1343               end.
     1344               else do:
     1345                   v-prizn = right-trim(v-prizn,",").
     1346                   txt-prizn:screen-value = "Выбраны признаки: ".
     1347                   do while prizn-cur < num-entries(v-prizn,","):
     1348                       prizn-cur = prizn-cur + 1.
     1349                       for first gds-prt where gds-prt.node-code = integer(entry(prizn-cur, v-prizn, ",")) no-lock:
     1350                           txt-prizn:screen-value = txt-prizn:screen-value + gds-prt.f-name + ", ".
     1351                       end.
     1352                   end.
     1353                   txt-prizn:screen-value = right-trim(txt-prizn:screen-value, ", ").
     1354               end.
     1355           end.
     1356       end case.
     1357   END.
     1358   if not this-procedure :persistent
     1359   then do:
     1360     message
     1361       vss-workfile vss-revision vss-description skip
     1362       "Ошибка при запуске процедуры" skip
     1363       "Данную процедуру следует запускать только с параметром persistent" skip
     1364       view-as alert-box error .
     1365     undo, return error .
     1366   end.
     1367   PROCEDURE disable_UI :
     1368     HIDE FRAME F-Main.
     1369     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1370   END PROCEDURE.
     1371   PROCEDURE enable_UI :
     1372     DISPLAY Classify Itog Zero-ost Zero tog-obj rs-prizn txt-prizn
     1373         WITH FRAME F-Main.
     1374     ENABLE RECT-12 Classify Itog Zero-ost Zero tog-obj rs-prizn txt-prizn
     1375         WITH FRAME F-Main.
     1376   END PROCEDURE.
     1377   PROCEDURE my-report :
     1378   define buffer tt-goods for goods .
     1379   define variable v-col-rec  as integer init 0 no-undo .
     1380   if x-selectgood = 2 then do:
     1381   v-col-rec = 0.
     1382   for each gds-list : delete gds-list . end.
     1383       for each tmp#grp :
     1384         for each tt-goods no-lock where tt-goods.grp-name begins tmp#grp.grp-name :
     1385           create gds-list.
     1386           buffer-copy tt-goods to gds-list.
     1387           v-col-rec = 1 + v-col-rec  .
     1388         end.
     1389       end.
     1390     if v-col-rec = 0 then do:
     1391     message "Не выбрана группа товаров !!" view-as alert-box information .
     1392     return  .
     1393     end.
     1394   end.
     1395   if x-selectgood = 3 then do:
     1396   v-col-rec = 0.
     1397   for each gds-list : delete gds-list . end.
     1398       for each g#cli :
     1399         for each tt-goods no-lock where tt-goods.prod-code = g#cli.obj-code and
     1400                                         tt-goods.prod-type = g#cli.obj-type
     1401          :
     1402           v-col-rec = 1 + v-col-rec  .
     1403           create gds-list.
     1404           buffer-copy tt-goods to gds-list.
     1405         end.
     1406       end.
     1407     if v-col-rec = 0 then do:
     1408     message "Не выбраны производители !!" view-as alert-box information .
     1409     return  .
     1410     end.
     1411   end.
     1412   run cur-time in this-procedure ( output v-today
     1413                                  , output v-time
     1414                                  ).
     1415   if tog-obj = true then do:
     1416   If x-date-alone <> v-today Then do:
     1417         if x-SelectGood = 1 Then DO:
     1418             If x-SET_val_TYPE = 1
     1419               then DO :
     1420                   run rep/r-prt-z5.p
     1421                      (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1422                   End.
     1423               Else do:
     1424                   run rep/r-prt-z6.p
     1425                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1426                   End.
     1427         End.
     1428         Else DO:
     1429             If x-SET_val_TYPE = 1
     1430               then do:
     1431                   run rep/r-prt-z7.p
     1432                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1433                   End.
     1434               Else do:
     1435                   run rep/r-prt-z8.p
     1436                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1437                   End.
     1438         End.
     1439   End.
     1440   Else do:
     1441         if x-SelectGood = 1 Then DO:
     1442             If x-SET_val_TYPE = 1
     1443               then DO :
     1444                   run rep/r-prt-z1.p
     1445                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1446                   End.
     1447               Else do:
     1448                   run rep/r-prt-z2.p
     1449                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1450                   End.
     1451         End.
     1452         Else DO:
     1453             If x-SET_val_TYPE = 1
     1454               then do:
     1455                   run rep/r-prt-z3.p
     1456                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1457                   End.
     1458               Else do:
     1459                   run rep/r-prt-z4.p
     1460                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1461                   End.
     1462         End.
     1463   End.
     1464   End.
     1465   else do:
     1466       If x-date-alone <> v-today Then do:
     1467             if x-SelectGood = 1 Then DO:
     1468                 If x-SET_val_TYPE = 1
     1469                   then DO :
     1470                       run rep/r-prttz5.p
     1471                         (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1472                       End.
     1473                   Else do:
     1474                       run rep/r-prttz6.p
     1475                           (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1476                       End.
     1477             End.
     1478             Else DO:
     1479                 If x-SET_val_TYPE = 1
     1480                   then do:
     1481                       run rep/r-prttz7.p
     1482                           (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1483                       End.
     1484                   Else do:
     1485                       run rep/r-prttz8.p
     1486                           (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1487                       End.
     1488             End.
     1489       End.
     1490       Else do:
     1491             if x-SelectGood = 1 Then DO:
     1492                 If x-SET_val_TYPE = 1
     1493                   then DO :
     1494                       run rep/r-prttz1.p
     1495                           (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1496                       End.
     1497                   Else do:
     1498                       run rep/r-prttz2.p
     1499                           (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1500                       End.
     1501             End.
     1502             Else DO:
     1503                 If x-SET_val_TYPE = 1
     1504                   then do:
     1505                       run rep/r-prttz3.p
     1506                           (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1507                       End.
     1508                   Else do:
     1509                       run rep/r-prttz4.p
     1510                           (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input zero,  input zero-ost,  input Itog ,   input tog-obj ,   input table tt-season ,   input v-prizn  ) .
     1511                       End.
     1512             End.
     1513       End.
     1514   end.
     1515   END PROCEDURE.
     1516   PROCEDURE my-var :
     1517   assign frame F-Main
     1518    Classify itog zero zero-ost tog-obj .
     1519   Sheetf.Excel-Column-Lable =
     1520   "N п\п,
     1521   Код,
     1522   Артикул,
     1523   Название товара ,
     1524   Признак товара,
     1525   Количество,
     1526   Учетные цена с НДС,
     1527   Сумма в уч.ценах,
     1528   Продажная цена,
     1529   Суммы в продажных ценах,
     1530   % наценки,
     1531   Свободное количество,
     1532   Ожидаемое количество,
     1533   Резерв количество,
     1534   Сумма в учетных ценах,
     1535   Сумма в ценах докум.,
     1536   Учетная цена резерва," .
     1537   Sheetf.ColFormat = "2=@;3=@;4=@;5=@"  .
     1538   Sheetf.make-correct = fill ("true ," , 17) .
     1539   Sheetf.Sizes = "6,16,9,60,20," + fill ("15,", 12)  .
     1540    run cur-time in this-procedure ( output v-today
     1541                                   , output v-time
     1542                                   ).
     1543    if x-date-alone  <> v-today then
     1544        Sheetf.rights-column =
     1545        "true  ,true ,true ,true ,true ,true ,true ,true, true ,true ,true, false ,true ,false ,false ,false ,false ," .
     1546        else
     1547         Sheetf.rights-column  =  fill ("true ," , 17) .
     1548   END PROCEDURE.
