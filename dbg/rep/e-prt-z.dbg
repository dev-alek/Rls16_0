     1044   PROCEDURE ensure-broker :
     1045   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1046   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1047   DO:
     1048       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1049       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1050   END.
     1051   END PROCEDURE.
     1052   PROCEDURE get-attribute :
     1053     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
