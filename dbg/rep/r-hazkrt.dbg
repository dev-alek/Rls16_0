     1417   define temp-table tt-report no-undo
     1418     field db-num      like obj-list.db-num
     1419     field db-name     as character
     1420     field gds-order   as integer
     1421     field gds-name    as character
     1422     field vol-rtl     as decimal
     1423     field price-rtl   as decimal
     1424     field sale-sum    as decimal
     1425   index pi is primary unique db-num gds-order
     1426   .
     1427   define variable v-hosts as character no-undo .
     1428   define frame hazkrt
     1429           sym1 column-label ":!:" format "X(1)" space(0)
     1430           tt-report.db-name column-label "№ АЗС ! " format "X(10)" space(0)
     1431           sym2 column-label ":!:" format "X(1)" space(0)
     1432           tt-report.gds-name column-label "Топливо ! " format "X(20)" space(0)
     1433           sym3 column-label ":!:" format "X(1)" space(0)
     1434           tt-report.vol-rtl column-label "Реализация за сутки ! (тонн)" format ">>>>>>>>>9.99" space(0)
     1435           sym4 column-label ":!:" format "X(1)" space(0)
     1436           tt-report.price-rtl column-label "Цена реализации! " format ">>>>>>>>>9.99" space(0)
     1437           sym5 column-label ":!:" format "X(1)" space(0)
     1438           tt-report.sale-sum column-label "Выручка от реализации сопутствующих ! товаров за сутки " format "->>>>>>>>>>>>9.99" space(0)
     1439           sym6 column-label ":!:" format "X(1)" space(0)
     1440   header
     1441     v-hosts skip(1)
     1442     "C:  " string(p-date-start , "99/99/9999") format "X(12)" string(p-time-start-sec, "hh:mm")  skip
     1443     "По: " string(p-date-end , "99/99/9999") format "X(12)" string(p-time-end-sec, "hh:mm")  skip
     1444     fill('-',106) format "X(106)"
     1445   with width 235 down stream-io.
     1446   function is-correct-name return logical ( input p-name as character) forward.
     1447   do on error undo , return error return-value :
     1448   if session :set-wait-state( "compiler" ) then.
     1449     run hazkrtxl-init in this-procedure .
     1450     run waitfram-show in this-procedure ("Проверка топливных товаров...").
     1451     run load-param-ptrl-gds in this-procedure .
     1452     run load-chk in this-procedure .
     1453     run calc-chk in this-procedure .
     1454     run print-header in this-procedure .
     1455     define stream out-stream.
     1456   output stream out-stream to value( string( session:temp-directory +
     1457                                        "rpt" + string( g#report-num ) ) )
     1458                                        page-size  value(62) .
     1459     put stream out-stream "1" skip.
     1460     output stream out-stream close.
     1461     run waitfram-show in this-procedure ("Удаление временных данных...").
     1462     run clear-tt in this-procedure .
     1463     run hazkrtxl-close in this-procedure .
     1464     run waitfram-hide in this-procedure .
     1465   if session :set-wait-state( "" ) then.
     1466     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1467     os-rename
     1468       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1469       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1470     .
     1471     define variable v-user-action   as character no-undo .
     1472     define variable v-printed       as logical   no-undo .
     1473     define variable DisabledOptions as integer   no-undo .
     1474     define variable v-orient-page as character no-undo .
     1475     run How-name in this-procedure (
     1476         input ReportPageHeight,
     1477         input ReportPageWidth,
     1478         output v-orient-page )
     1479         .
     1480     if v-orient-page = "A4-lans":U then DisabledOptions = 20 .
     1481                                   else DisabledOptions = 0 .
     1482     run gbl/prnfilen.w
     1483         (input  ""
     1484         ,input  DisabledOptions
     1485         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1486         ,input  ReportFontNum
     1487         ,output v-user-action
     1488         ,output v-printed
     1489         ) .
     1490     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) ) .
     1491     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" ) .
     1492   end.
     1493   procedure load-param-ptrl-gds :
     1494   do
     1495   on error undo, return error return-value
     1496   :
     1497     define buffer buf_bar-code      for ub.bar-code.
     1498     define buffer buf_goods         for ub.goods.
     1499     define buffer buf_tt-fuel-goods for tt-fuel-goods.
     1500     define buffer buf_gds-prt       for ub.gds-prt.
     1501     define variable v-par-val       as character no-undo .
     1502     define variable v-par-type      as character no-undo .
     1503     define variable v-value-date    as date      no-undo .
     1504     define variable v-value-decimal as decimal   no-undo .
     1505     define variable v-value-integer as integer   no-undo .
     1506     define variable v-value-logical as logical   no-undo .
     1507     define variable v-tth           as handle               no-undo .
     1508     define variable v-num           as integer              no-undo .
     1509     define variable v-i             as integer              no-undo .
     1510     define variable v-bc            like ub.bar-code.b-code no-undo .
     1511     define variable v-gds-code      like ub.goods.gds-code  no-undo .
     1512     define variable v-gds-code-str  as character            no-undo .
     1513     run adm/shattri.p (
     1514         input "get":U
     1515         ,input  ''
     1516         ,input  0
     1517         ,input  'report-glob':U
     1518         ,input  'rep-sort':U
     1519         ,output v-par-val
     1520         ,output v-value-date
     1521         ,output v-value-decimal
     1522         ,output v-value-integer
     1523         ,output v-value-logical
     1524         ,output v-par-type
     1525         ,INPUT-OUTPUT table-handle v-tth
     1526                       ) no-error.
     1527     if error-status :error
     1528        or v-par-val = "":U
     1529     then do:
     1530       delete object v-tth.
     1531       message
     1532         vss-workfile vss-revision vss-description skip
     1533         "Ошибка чтения конфигурационного параметра " + 'rep-sort':U + "." skip
     1534         "Отчет не может быть сформирован"
     1535         view-as alert-box error.
     1536       undo, return error.
     1537     end.
     1538     else do:
     1539     assign
     1540       v-num = num-entries(v-par-val).
     1541     end.
     1542     delete object v-tth.
     1543     do v-i = 1 to v-num:
     1544       assign
     1545         v-gds-code =  integer( entry( v-i , v-par-val ) )
     1546       .
     1547       find first buf_goods no-lock
     1548         where   buf_goods.gds-code = v-gds-code
     1549       no-error .
     1550       if not available buf_goods then do:
     1551         message
     1552           vss-workfile vss-revision vss-description skip
     1553           "Не найден товар с кодом " + string(v-gds-code) + "." skip
     1554           "Отчет не может быть сформирован."
     1555           view-as alert-box error.
     1556         undo, return error.
     1557       end.
     1558       find first buf_gds-prt no-lock
     1559         where buf_gds-prt.upper-code = buf_goods.prt-root
     1560       .
     1561       find first buf_bar-code no-lock
     1562         where buf_bar-code.gds-code   = buf_goods.gds-code
     1563           and buf_bar-code.unit-cli   = buf_goods.unit-base
     1564           and buf_bar-code.node-code  = buf_gds-prt.node-code
     1565           and buf_bar-code.part-code  = ""
     1566           and buf_bar-code.in-code    = ""
     1567       no-error .
     1568       if not available buf_bar-code then do:
     1569         message
     1570           vss-workfile vss-revision vss-description skip
     1571           "Не найден бар-код для товара " + string(buf_goods.gds-code)+ " заданый в параметре " + "rep-sort":U + "." skip
     1572           "Отчет не может быть сформирован."
     1573           view-as alert-box error.
     1574         undo, return error.
     1575       end.
     1576       else do:
     1577         find first buf_tt-fuel-goods
     1578           where buf_tt-fuel-goods.gds-code = buf_goods.gds-code
     1579         no-error .
     1580         if available buf_tt-fuel-goods then do:
     1581           message
     1582             vss-workfile vss-revision vss-description skip
     1583             "В параметре " + "rep-sort":U + " заданы повторяющиеся коды " + string(v-gds-code)  skip
     1584             "Отчет не может быть сформирован."
     1585             view-as alert-box error.
     1586           undo, return error.
     1587         end.
     1588         create buf_tt-fuel-goods.
     1589         buffer-copy buf_goods to buf_tt-fuel-goods
     1590         assign
     1591           buf_tt-fuel-goods.gds-order = v-i
     1592           buf_tt-fuel-goods.b-code    = buf_bar-code.b-code
     1593         .
     1594       end.
     1595     end.
     1596   end.
     1597   end procedure.
     1598   procedure load-firms :
     1599   do
     1600   on error undo, return error return-value
     1601   :
     1602     define variable v-host-code as integer    no-undo .
     1603     define variable v-host-name as character  no-undo .
     1604     empty temp-table tt-host-list.
     1605     for each obj-list no-lock
     1606     :
     1607   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1609     (input  obj-list.obj-type
     1610     ,input  obj-list.obj-code
     1611     ,output v-host-code
     1612     ,output v-host-name
     1613     )  .
     1614       find first tt-host-list
     1615         where tt-host-list.host-code = v-host-code
     1616       no-error .
     1617       if not available tt-host-list then do:
     1618         create tt-host-list.
     1619         assign
     1620           tt-host-list.host-code = v-host-code
     1621           tt-host-list.host-name = v-host-name
     1622         .
     1623       end.
     1624     end.
     1625   end.
     1626   end procedure.
     1627   procedure load-chk :
     1628   define buffer buf_chk-doc         for ub.chk-doc.
     1629   define buffer buf_chk-pay         for ub.chk-pay.
     1630   define buffer buf_chk-gds         for ub.chk-gds.
     1631   define buffer buf_inkas           for ub.inkas.
     1632   define buffer buf_goods           for ub.goods.
     1633   define buffer buf_tt-fuel-goods   for tt-fuel-goods.
     1634   define buffer buf_tt-fuel-density for tt-fuel-density.
     1635   define buffer buf_tt-gds-sale     for tt-gds-sale.
     1636   define buffer buf_tt-fuel-chk     for tt-fuel-chk.
     1637   define variable v-ptrl-volume   as decimal   no-undo .
     1638   define variable v-gds-sale-sum  as decimal   no-undo .
     1639   define variable v-days-num      as integer   no-undo .
     1640   define variable v-day           as integer   no-undo .
     1641   do
     1642   on error undo, return error return-value
     1643   :
     1644     assign
     1645       v-days-num = p-date-end - p-date-start
     1646     .
     1647     for each obj-list no-lock
     1648     :
     1649       assign
     1650         v-gds-sale-sum = 0
     1651       .
     1652       run waitfram-show in this-procedure ("Обработка чеков по объекту " + obj-list.obj-name + " ..." ).
     1653       _chk-doc:
     1654       for each buf_chk-doc no-lock
     1655           where buf_chk-doc.obj-type  = obj-list.obj-type
     1656             and buf_chk-doc.obj-code  = obj-list.obj-code
     1657             and buf_chk-doc.chk-date >= p-date-start
     1658             and buf_chk-doc.chk-date <= p-date-end ,
     1659           first buf_inkas no-lock
     1660           where buf_inkas.inkas-code = buf_chk-doc.out-code
     1661             and buf_inkas.status_    = 'факт':U
     1662       :
     1663         if      buf_chk-doc.chk-date = p-date-start
     1664             and buf_chk-doc.chk-time < p-time-start-sec
     1665         then do:
     1666           next _chk-doc.
     1667         end.
     1668         if      buf_chk-doc.chk-date = p-date-end
     1669             and buf_chk-doc.chk-time > ( p-time-end-sec + 60 )
     1670         then do:
     1671           next _chk-doc.
     1672         end.
     1673         if lookup( string(buf_chk-doc.chk-type) , '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U ) > 0 then do :
     1674           next _chk-doc.
     1675         end.
     1676         for each buf_chk-gds no-lock
     1677           where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     1678         :
     1679           find first buf_tt-fuel-goods no-lock
     1680             where buf_tt-fuel-goods.b-code = buf_chk-gds.b-code
     1681           no-error .
     1682           if available buf_tt-fuel-goods then do:
     1683             find first buf_tt-fuel-chk
     1684               where buf_tt-fuel-chk.obj-type = buf_chk-doc.obj-type
     1685                 and buf_tt-fuel-chk.obj-code = buf_chk-doc.obj-code
     1686                 and buf_tt-fuel-chk.b-code   = buf_chk-gds.b-code
     1687                 and buf_tt-fuel-chk.doc-code = buf_chk-gds.doc-code
     1688                 and buf_tt-fuel-chk.line-num = buf_chk-gds.line-num
     1689             no-error .
     1690             if not available buf_tt-fuel-chk then do:
     1691               create buf_tt-fuel-chk.
     1692               buffer-copy buf_chk-gds to buf_tt-fuel-chk
     1693               assign
     1694                 buf_tt-fuel-chk.obj-type    = buf_chk-doc.obj-type
     1695                 buf_tt-fuel-chk.obj-code    = buf_chk-doc.obj-code
     1696                 buf_tt-fuel-chk.db-num      = obj-list.db-num
     1697                 buf_tt-fuel-chk.price-base  = ( buf_chk-gds.price-base - buf_chk-gds.discnt)
     1698               .
     1699             end.
     1700           end.
     1701           else do:
     1702           assign
     1703             v-gds-sale-sum = v-gds-sale-sum + ( buf_chk-gds.doc-qnty * ( buf_chk-gds.price-base - buf_chk-gds.discnt) )
     1704           .
     1705           end.
     1706         end.
     1707       end.
     1708       find first buf_tt-gds-sale
     1709         where buf_tt-gds-sale.db-num = obj-list.db-num
     1710       no-error .
     1711       if not available buf_tt-gds-sale then do:
     1712         create buf_tt-gds-sale.
     1713       end.
     1714       assign
     1715         buf_tt-gds-sale.db-num   = obj-list.db-num
     1716         buf_tt-gds-sale.sale-sum = buf_tt-gds-sale.sale-sum + v-gds-sale-sum
     1717       .
     1718     end.
     1719   end.
     1720   end procedure.
     1721   procedure calc-chk :
     1722   define buffer buf_tt-fuel-chk     for tt-fuel-chk.
     1723   define buffer sch_tt-fuel-chk     for tt-fuel-chk.
     1724   define buffer buf_tt-price        for tt-price.
     1725   define buffer buf_tt-fuel-density for tt-fuel-density.
     1726   define buffer bf_tt-fuel-density  for tt-fuel-density.
     1727   define buffer buf_tt-report       for tt-report.
     1728   define buffer buf_tt-gds-sale     for tt-gds-sale .
     1729   define buffer buf_tt-fuel-goods   for tt-fuel-goods.
     1730   define variable v-density       like ub.doc-line.fact-density.
     1731   define variable v-unique-price  as logical   no-undo .
     1732   define variable v-sum1          as decimal   no-undo .
     1733   define variable v-sum2          as decimal   no-undo .
     1734   define variable v-gds-sale-sum  as decimal   no-undo .
     1735   define variable v-db-name       as character no-undo .
     1736   do
     1737   on error undo, return error return-value
     1738   :
     1739      for each buf_tt-fuel-chk
     1740         break by buf_tt-fuel-chk.db-num
     1741         by buf_tt-fuel-chk.b-code
     1742         :
     1743         if first-of(buf_tt-fuel-chk.db-num) or first-of(buf_tt-fuel-chk.b-code) then
     1744         do:
     1745            run waitfram-show in this-procedure ("Расчет по базе " + string( buf_tt-fuel-chk.db-num ) + " ..." ).
     1746            find first sch_tt-fuel-chk no-lock
     1747               where sch_tt-fuel-chk.db-num      = buf_tt-fuel-chk.db-num
     1748               and sch_tt-fuel-chk.b-code      = buf_tt-fuel-chk.b-code
     1749               and sch_tt-fuel-chk.price-base <> buf_tt-fuel-chk.price-base
     1750               no-error .
     1751            create buf_tt-price.
     1752            assign
     1753               buf_tt-price.db-num    = buf_tt-fuel-chk.db-num
     1754               buf_tt-price.b-code    = buf_tt-fuel-chk.b-code
     1755               buf_tt-price.price     = buf_tt-fuel-chk.price-base
     1756               buf_tt-price.is-unique = if available sch_tt-fuel-chk then no else yes
     1757               v-unique-price         = if available sch_tt-fuel-chk then no else yes
     1758               .
     1759         end.
     1760         if not v-unique-price then
     1761         do :
     1762            assign
     1763               v-sum1 = v-sum1 + ( buf_tt-fuel-chk.price-base * buf_tt-fuel-chk.doc-qnty )
     1764               v-sum2 = v-sum2 + buf_tt-fuel-chk.doc-qnty
     1765               .
     1766         end.
     1767         if last-of(buf_tt-fuel-chk.db-num) or last-of(buf_tt-fuel-chk.b-code) then
     1768         do:
     1769            if not v-unique-price then
     1770            do :
     1771               find first buf_tt-price
     1772                  where buf_tt-price.db-num    = buf_tt-fuel-chk.db-num
     1773                  and buf_tt-price.b-code  = buf_tt-fuel-chk.b-code
     1774                  no-error .
     1775               if available buf_tt-price then
     1776               do:
     1777                  assign
     1778                     buf_tt-price.price = if v-sum2 > 0 then ( v-sum1 / v-sum2 ) else 0
     1779                     .
     1780               end.
     1781            end.
     1782            assign
     1783               v-sum1 = 0
     1784               v-sum2 = 0
     1785               .
     1786         end.
     1787         find first buf_tt-fuel-density
     1788            where buf_tt-fuel-density.obj-type  = buf_tt-fuel-chk.obj-type
     1789            and buf_tt-fuel-density.obj-code  = buf_tt-fuel-chk.obj-code
     1790            and buf_tt-fuel-density.den-date  = buf_tt-fuel-chk.chk-date
     1791            and buf_tt-fuel-density.b-code    = buf_tt-fuel-chk.b-code
     1792            no-error .
     1793         if not available buf_tt-fuel-density then
     1794         do:
     1795            run find-density in this-procedure ( input buf_tt-fuel-chk.obj-type
     1796               , input buf_tt-fuel-chk.obj-code
     1797               , input buf_tt-fuel-chk.chk-date
     1798               , input buf_tt-fuel-chk.b-code
     1799               , output v-density
     1800               ) .
     1801            if v-density <> 0 then
     1802            do:
     1803               create buf_tt-fuel-density .
     1804               assign
     1805                  buf_tt-fuel-density.obj-type = buf_tt-fuel-chk.obj-type
     1806                  buf_tt-fuel-density.obj-code = buf_tt-fuel-chk.obj-code
     1807                  buf_tt-fuel-density.den-date = buf_tt-fuel-chk.chk-date
     1808                  buf_tt-fuel-density.b-code   = buf_tt-fuel-chk.b-code
     1809                  buf_tt-fuel-density.density  = v-density
     1810                  .
     1811            end.
     1812            else
     1813            do:
     1814               find first bf_tt-fuel-density
     1815                  where bf_tt-fuel-density.obj-type  = buf_tt-fuel-chk.obj-type
     1816                  and bf_tt-fuel-density.obj-code  = buf_tt-fuel-chk.obj-code
     1817                  and bf_tt-fuel-density.b-code    = buf_tt-fuel-chk.b-code
     1818                  no-error .
     1819               if available (bf_tt-fuel-density) then
     1820               do:
     1821                  create buf_tt-fuel-density .
     1822                  assign
     1823                     buf_tt-fuel-density.obj-type = buf_tt-fuel-chk.obj-type
     1824                     buf_tt-fuel-density.obj-code = buf_tt-fuel-chk.obj-code
     1825                     buf_tt-fuel-density.den-date = buf_tt-fuel-chk.chk-date
     1826                     buf_tt-fuel-density.b-code   = buf_tt-fuel-chk.b-code
     1827                     buf_tt-fuel-density.density  = bf_tt-fuel-density.density
     1828                     .
     1829               end.
     1830               else
     1831               do:
     1832                  for first ub.bar-code no-lock where ub.bar-code.b-code = buf_tt-fuel-density.b-code,
     1833                     first ub.goods no-lock where ub.goods.gds-code = ub.bar-code.gds-code:
     1834                     message
     1835                        substitute( "Для объекта &5 &6 не найден ни один документ &4 для товара артикул: &2 , наименование: &3 . &4 Плотность для товара будет равно 0 ."
     1836                        , ""
     1837                        , ub.goods.artic
     1838                        , ub.goods.gds-name
     1839                        , chr(10)
     1840                        , buf_tt-fuel-chk.obj-type
     1841                        , buf_tt-fuel-chk.obj-code
     1842                        )
     1843                        view-as alert-box information.
     1844                  end.
     1845                  create buf_tt-fuel-density .
     1846                  assign
     1847                     buf_tt-fuel-density.obj-type = buf_tt-fuel-chk.obj-type
     1848                     buf_tt-fuel-density.obj-code = buf_tt-fuel-chk.obj-code
     1849                     buf_tt-fuel-density.den-date = buf_tt-fuel-chk.chk-date
     1850                     buf_tt-fuel-density.b-code   = buf_tt-fuel-chk.b-code
     1851                     buf_tt-fuel-density.density  = v-density
     1852                     .
     1853               end.
     1854            end.
     1855         end.
     1856      end.
     1857     for each buf_tt-fuel-chk
     1858     break by buf_tt-fuel-chk.db-num
     1859           by buf_tt-fuel-chk.b-code
     1860     :
     1861       if first-of(buf_tt-fuel-chk.db-num) or first-of (buf_tt-fuel-chk.b-code) then do:
     1862         find first buf_tt-gds-sale
     1863           where buf_tt-gds-sale.db-num = buf_tt-fuel-chk.db-num
     1864         no-error .
     1865         find first tt-fuel-goods
     1866           where tt-fuel-goods.b-code = buf_tt-fuel-chk.b-code
     1867         no-error .
     1868         find first buf_tt-price
     1869           where buf_tt-price.db-num = buf_tt-fuel-chk.db-num
     1870             and buf_tt-price.b-code = buf_tt-fuel-chk.b-code
     1871         no-error .
     1872         create buf_tt-report.
     1873         assign
     1874           buf_tt-report.db-num    = buf_tt-fuel-chk.db-num
     1875           buf_tt-report.db-name   = buf_tt-gds-sale.db-name
     1876           buf_tt-report.gds-order = tt-fuel-goods.gds-order
     1877           buf_tt-report.gds-name  = tt-fuel-goods.gds-name
     1878           buf_tt-report.sale-sum  = buf_tt-gds-sale.sale-sum
     1879           buf_tt-report.price-rtl = buf_tt-price.price
     1880         .
     1881       end.
     1882       find first buf_tt-fuel-density
     1883         where buf_tt-fuel-density.obj-type = buf_tt-fuel-chk.obj-type
     1884           and buf_tt-fuel-density.obj-code = buf_tt-fuel-chk.obj-code
     1885           and buf_tt-fuel-density.den-date = buf_tt-fuel-chk.chk-date
     1886           and buf_tt-fuel-density.b-code   = buf_tt-fuel-chk.b-code
     1887       no-error .
     1888       if not available buf_tt-fuel-density then do:
     1889         message
     1890           substitute ( "Не найдено значение плотности для топлива с бар-кодом: &1&5 на  объекте &2 &3 за &4"
     1891                      , buf_tt-fuel-chk.b-code
     1892                      , buf_tt-fuel-chk.obj-type
     1893                      , buf_tt-fuel-chk.obj-code
     1894                      , buf_tt-fuel-chk.chk-date
     1895                      , chr(10)
     1896                      )
     1897         view-as alert-box error.
     1898         undo, return error.
     1899       end.
     1900       assign
     1901         buf_tt-report.vol-rtl = buf_tt-report.vol-rtl + ( buf_tt-fuel-chk.doc-qnty * buf_tt-fuel-density.density )
     1902       .
     1903     end.
     1904     define variable v-gds-name  as character no-undo .
     1905     define variable v-vol-rtl   as character no-undo .
     1906     define variable v-price-rtl as character no-undo .
     1907     for each buf_tt-report
     1908     break by buf_tt-report.db-num
     1909           by buf_tt-report.gds-order
     1910     :
     1911       assign
     1912         buf_tt-report.vol-rtl   = round( ( buf_tt-report.vol-rtl / 1000 ) , 2 )
     1913         buf_tt-report.sale-sum  = round( ( buf_tt-report.sale-sum / 1000 ) , 2 )
     1914       .
     1915     end.
     1916     for each obj-list no-lock
     1917       break by obj-list.db-num
     1918     :
     1919       if first-of(obj-list.db-num) then do:
     1920         assign
     1921           v-db-name = ""
     1922         .
     1923         for each buf_tt-fuel-goods no-lock
     1924         :
     1925           find first buf_tt-report
     1926             where buf_tt-report.db-num    = obj-list.db-num
     1927               and buf_tt-report.gds-order = buf_tt-fuel-goods.gds-order
     1928           no-error .
     1929           if not available buf_tt-report then do:
     1930             find first buf_tt-gds-sale
     1931               where buf_tt-gds-sale.db-num = obj-list.db-num
     1932             no-error .
     1933             create buf_tt-report.
     1934             assign
     1935               buf_tt-report.db-num    = obj-list.db-num
     1936               buf_tt-report.gds-order = buf_tt-fuel-goods.gds-order
     1937               buf_tt-report.gds-name  = buf_tt-fuel-goods.gds-name
     1938               buf_tt-report.vol-rtl   = 0
     1939               buf_tt-report.price-rtl = 0
     1940               buf_tt-report.sale-sum  = if available buf_tt-gds-sale then
     1941                                           round( ( buf_tt-gds-sale.sale-sum / 1000 ) , 2 )
     1942                                         else
     1943                                           0
     1944             .
     1945           end.
     1946         end.
     1947       end.
     1948       if is-correct-name( input obj-list.obj-name ) then do:
     1949         assign
     1950           v-db-name = obj-list.obj-name
     1951         .
     1952       end.
     1953       if last-of(obj-list.db-num) then do:
     1954         if v-db-name = "" then do:
     1955           assign
     1956             v-db-name = "БД " + string(obj-list.db-num)
     1957           .
     1958         end.
     1959         assign
     1960           buf_tt-report.db-name = v-db-name
     1961         .
     1962       end.
     1963     end.
     1964     for each buf_tt-report
     1965     break by buf_tt-report.db-num
     1966           by buf_tt-report.gds-order
     1967     :
     1968       assign
     1969         v-gds-name   = v-gds-name   + chr(6) + buf_tt-report.gds-name
     1970         v-vol-rtl    = v-vol-rtl    + chr(6) + string(buf_tt-report.vol-rtl)
     1971         v-price-rtl  = v-price-rtl  + chr(6) + string( buf_tt-report.price-rtl , ">>>>>>9.99" )
     1972       .
     1973       if last-of (buf_tt-report.db-num) then do:
     1974         assign
     1975           v-gds-name   = trim( v-gds-name  , chr(6) )
     1976           v-vol-rtl    = trim( v-vol-rtl   , chr(6) )
     1977           v-price-rtl  = trim( v-price-rtl , chr(6) )
     1978         .
     1979         run hazkrtxl-write-line-data in this-procedure ( input buf_tt-report.db-name
     1980                                                        , input v-gds-name
     1981                                                        , input v-vol-rtl
     1982                                                        , input v-price-rtl
     1983                                                        , input buf_tt-report.sale-sum
     1984                                                        ) .
     1985         assign
     1986           v-gds-name  = "":U
     1987           v-vol-rtl   = "":U
     1988           v-price-rtl = "":U
     1989         .
     1990       end.
     1991     end.
     1992   end.
     1993   end procedure.
     1994   procedure find-density :
     1995   define input  parameter p-obj-type  like obj-list.obj-type    no-undo .
     1996   define input  parameter p-obj-code  like obj-list.obj-code    no-undo .
     1997   define input  parameter p-date      as date                   no-undo .
     1998   define input  parameter p-b-code    like ub.bar-code.b-code   no-undo .
     1999   define output parameter p-density   like ub.doc-line.fact-density  no-undo .
     2000   define buffer buf_trn-doc       for ub.trn-doc.
     2001   define buffer buf_doc-line      for ub.doc-line.
     2002   define buffer buf_goods         for ub.goods.
     2003   define buffer buf_tt-fuel-goods for tt-fuel-goods.
     2004   define variable v-i     as integer   no-undo .
     2005   define variable v-sum1  as decimal   no-undo .
     2006   define variable v-sum2  as decimal   no-undo .
     2007   do
     2008   on error undo, return error return-value
     2009   :
     2010     find first buf_tt-fuel-goods
     2011       where buf_tt-fuel-goods.b-code = p-b-code
     2012     no-error .
     2013     if not available buf_tt-fuel-goods then return.
     2014     find first buf_goods no-lock
     2015       where buf_goods.gds-code = buf_tt-fuel-goods.gds-code
     2016     no-error .
     2017     if not available buf_goods then do :
     2018       message
     2019         "Не найден товар с бар-кодом " + string( p-b-code )
     2020       view-as alert-box error.
     2021       undo, return error.
     2022     end.
     2023     for each buf_trn-doc no-lock
     2024           where buf_trn-doc.obj-type     = p-obj-type
     2025             and buf_trn-doc.obj-code     = p-obj-code
     2026             and buf_trn-doc.status_      = 'факт':U
     2027             and buf_trn-doc.fact-date    = p-date
     2028             and buf_trn-doc.ext-doc-type = 'ie':U,
     2029         each buf_doc-line no-lock
     2030           where buf_doc-line.doc-code   = buf_trn-doc.doc-code
     2031             and buf_doc-line.artic      = buf_goods.artic
     2032             and buf_doc-line.prod-type  = buf_goods.prod-type
     2033             and buf_doc-line.prod-code  = buf_goods.prod-code
     2034     :
     2035       assign
     2036         v-sum1 = v-sum1 + (buf_doc-line.fact-qnty * buf_doc-line.fact-density)
     2037         v-sum2 = v-sum2 + buf_doc-line.fact-qnty
     2038       .
     2039     end.
     2040     if v-sum2 > 0 then do:
     2041       assign
     2042         p-density = v-sum1 / v-sum2
     2043       .
     2044       return .
     2045     end.
     2046     _find-last-doc:
     2047     for each buf_trn-doc no-lock
     2048           where buf_trn-doc.obj-type     = p-obj-type
     2049             and buf_trn-doc.obj-code     = p-obj-code
     2050             and buf_trn-doc.status_      = 'факт':U
     2051             and buf_trn-doc.fact-date    < p-date
     2052             and buf_trn-doc.ext-doc-type = 'ie':U
     2053     by fact-date descending
     2054     :
     2055       find first buf_doc-line no-lock
     2056         where buf_doc-line.doc-code   = buf_trn-doc.doc-code
     2057           and buf_doc-line.artic      = buf_goods.artic
     2058           and buf_doc-line.prod-type  = buf_goods.prod-type
     2059           and buf_doc-line.prod-code  = buf_goods.prod-code
     2060       no-error .
     2061       if available buf_doc-line then do:
     2062         assign
     2063           v-sum1 = buf_doc-line.fact-density
     2064         .
     2065         leave _find-last-doc .
     2066       end.
     2067     end.
     2068     if v-sum1 > 0 then do:
     2069       assign
     2070         p-density = v-sum1
     2071       .
     2072     end.
     2073     else do:
     2074       assign
     2075         p-density = 0
     2076       .
     2077     end.
     2078   end.
     2079   end procedure.
     2080   procedure get-hosts :
     2081   define output parameter p-host-list as character no-undo .
     2082   define buffer buf_tt-host-list for tt-host-list.
     2083   do
     2084   on error undo, return error return-value
     2085   :
     2086     run load-firms in this-procedure .
     2087     for each buf_tt-host-list :
     2088       assign
     2089         p-host-list = p-host-list + buf_tt-host-list.host-name + "\n"
     2090       .
     2091     end.
     2092     assign
     2093       p-host-list = trim( p-host-list , "\n" )
     2094     .
     2095   end.
     2096   end procedure.
     2097   procedure print-header :
     2098   do
     2099   on error undo, return error return-value
     2100   :
     2101     run get-hosts in this-procedure ( output v-hosts ).
     2102     run hazkrtxl-write-cell-data in this-procedure ( input "h_hostName":U
     2103                                                    , input v-hosts
     2104                                                    ).
     2105     run hazkrtxl-write-cell-data in this-procedure ( input "h_dateDayStart":U
     2106                                                    , input day(p-date-start)
     2107                                                    ).
     2108     run hazkrtxl-write-cell-data in this-procedure ( input "h_dateMonthStart":U
     2109                                                    , input month(p-date-start)
     2110                                                    ).
     2111     run hazkrtxl-write-cell-data in this-procedure ( input "h_dateYearStart":U
     2112                                                    , input year(p-date-start)
     2113                                                    ).
     2114     run hazkrtxl-write-cell-data in this-procedure ( input "h_dateTimeStart":U
     2115                                                    , input string( p-time-start-sec , "HH:MM")
     2116                                                    ).
     2117     run hazkrtxl-write-cell-data in this-procedure ( input "h_dateDayEnd":U
     2118                                                    , input day(p-date-end)
     2119                                                    ).
     2120     run hazkrtxl-write-cell-data in this-procedure ( input "h_dateMonthEnd":U
     2121                                                    , input month(p-date-end)
     2122                                                    ).
     2123     run hazkrtxl-write-cell-data in this-procedure ( input "h_dateYearEnd":U
     2124                                                    , input year(p-date-end)
     2125                                                    ).
     2126     run hazkrtxl-write-cell-data in this-procedure ( input "h_dateTimeEnd":U
     2127                                                    , input string( p-time-end-sec , "HH:MM")
     2128                                                    ).
     2129   end.
     2130   end procedure.
     2131   procedure clear-tt :
     2132   do
     2133   on error undo, return error return-value
     2134   :
     2135     empty temp-table tt-fuel-goods .
     2136     empty temp-table tt-fuel-density .
     2137     empty temp-table tt-host-list .
     2138     empty temp-table tt-fuel-chk .
     2139     empty temp-table tt-gds-sale .
     2140     empty temp-table tt-price .
     2141     empty temp-table tt-report .
     2142   end.
     2143   end procedure.
     2144   function is-correct-name return logical ( input p-name as character) :
     2145   define variable v-word  as character  no-undo.
     2146   define variable v-num   as integer    no-undo.
     2147   define variable v-i     as integer    no-undo.
     2148   v-num = num-entries("АЗС,АЗК":U).
     2149   _find-cycle:
     2150   do v-i = 1 to v-num :
     2151       v-word = entry( v-i , "АЗС,АЗК":U ) .
     2152       if ( index( caps(p-name) , v-word ) > 0 ) then do :
     2153           return yes.
     2154       end.
     2155   end.
     2156   return no.
     2157   end function.
