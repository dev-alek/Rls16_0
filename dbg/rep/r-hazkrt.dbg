      605   define variable temp1 as integer   no-undo.
      606   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      607   define variable v-waitfram-action01         as character   no-undo .
      608   define variable v-waitfram-action02         as character   no-undo .
      609   define variable v-waitfram-action03         as character   no-undo .
      610   define variable mWaitFramTextBeg            as character   no-undo.
      611   define variable mWaitFramTextEnd            as character   no-undo.
      612   define variable mWaitFramView               as logical     no-undo.
      613   define variable mWaitProcEvent              as logical     no-undo init yes.
      614   define variable mWaitFramInterval           as integer     no-undo init 1 .
      615   define variable mWaitFramStop               as logical     no-undo.
      616   define variable mWaitFramStopUser           as logical     no-undo.
      617   define variable mWaitFramStopTimeOut        as logical     no-undo.
      618   define variable mWaitFramStartProc          as datetime-tz no-undo.
      619   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      620   define button B-WaitFramStop auto-end-key
      621        label "Стоп"
      622        size 10 by 1 tooltip "Остоновить процесс".
      623   define button B-viewProcInfo
      624        label "Информация"
      625        size 15 by 1 tooltip "Информация о процесс".
      626   define frame waitfram
      627     v-waitfram-action01 format "x(72)" no-label skip
      628     v-waitfram-action02 format "x(72)" no-label skip
      629     v-waitfram-action03 format "x(72)" no-label skip
      630     B-viewProcInfo
      631     B-WaitFramStop at row 4 col 30
      632     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      633     .
      634   define new global shared variable mBatchMode as logical no-undo init ?.
      635   define variable mFramBachModHandle as handle no-undo.
      636   mFramBachModHandle = frame waitfram:handle.
      637   define variable mFameOldVis as logical no-undo.
      638   define variable mVisCUrentVin as logical no-undo.
      639   if session:batch-mode
      640   then
      641      mBatchMode = yes.
      642   if mBatchMode = ? then do:
      643     mVisCUrentVin = current-window:visible.
      644     mFameOldVis = mFramBachModHandle:visible.
      645     mFramBachModHandle:visible  = yes.
      646     mBatchMode = mFramBachModHandle:visible ne yes.
      647     mFramBachModHandle:visible = mFameOldVis.
      648     current-window:visible = mVisCUrentVin.
      649   end.
      650    if  log-manager:logfile-name ne ?
      651     then DO:
      652         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      653         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      654         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      655     end.
      656   on choose of B-WaitFramStop in frame waitfram
      657   do:
      658     mWaitFramStop = yes.
      659     mWaitFramStopUser = yes.
      660   end.
      661   function waitfram-check-timeout returns logical():
      662      define variable vtime as int64 no-undo.
      663      if mWaitFramStopTimeOut
      664      then
      665         return yes.
      666      vtime = ( now - mWaitFramStartProc ) / 1000 .
      667      if     mWaitFramTimeOut ne ?
      668         and mWaitFramTimeOut ne 0
      669         and mWaitFramTimeOut lt vtime
      670      then do:
      671         mWaitFramStopTimeOut = yes.
      672      end.
      673      return mWaitFramStopTimeOut.
      674   end.
      675   procedure waitfram-hide :
      676     if not session:batch-mode
      677     then do
      678     on error undo, return error return-value
      679     :
      680       pause 0 before-hide .
      681       if not mBatchMode then
      682         hide frame waitfram .
      683     if     not mWaitFramView
      684        and mWaitProcEvent
      685     then
      686       process events .
      687     end.
      688   end procedure.
      689   procedure waitfram-show :
      690     define input  parameter p-message as character no-undo .
      691     define variable v-left-margin as integer   no-undo .
      692     if not session:batch-mode
      693     then do
      694     on error undo, return error return-value
      695     :
      696       if length(p-message) <= 70 then do:
      697         assign
      698           v-left-margin = integer((70 - length(p-message)) / 2)
      699         .
      700         assign
      701           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      702         .
      703         assign
      704           v-waitfram-action01 = " "
      705           v-waitfram-action02 = " "
      706                                    + fill(" ", v-left-margin)
      707                                    + p-message
      708           v-waitfram-action03 = " "
      709         .
      710       end.
      711       else do:
      712         define variable vRindex1 as integer no-undo.
      713         define variable vRindex2 as integer no-undo.
      714         vRindex1 = r-index(p-message," ",70).
      715         if vRindex1 = 0
      716         then
      717            vRindex1 = 70.
      718         if length(p-message)  <= vRindex1 + 70 then do:
      719           assign
      720             v-waitfram-action01 = " "
      721             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      722             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      723           .
      724         end.
      725         else do:
      726           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      727           if vRindex2 <= vRindex1
      728           then
      729              vRindex2 = vRindex1 + 70.
      730           assign
      731             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      732             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      733             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      734           .
      735         end.
      736       end.
      737       B-viewProcInfo:visible   in frame waitfram = no.
      738       B-viewProcInfo:sensitive in frame waitfram = no.
      739       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      740       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      741       if  (   mWaitFramView
      742          or  mWaitProcEvent)
      743          and not mBatchMode
      744       then
      745          display
      746             v-waitfram-action01 skip
      747             v-waitfram-action02 skip
      748             v-waitfram-action03 skip
      749          with frame waitfram .
      750       if     mWaitFramView
      751          then do:
      752             if     mWaitFramInterval ne ?
      753                and not mBatchMode
      754             then
      755                wait-for go of frame waitfram pause mWaitFramInterval.
      756          end.
      757          else
      758             if     mWaitProcEvent
      759                and not mBatchMode
      760             then
      761                process events .
      762     end.
      763   end procedure.
      764      procedure waitfram-show-this:
      765         define input  parameter iInterval as int64 no-undo.
      766         define variable vtime as int64 no-undo.
      767         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      768         mWaitFramInterval = iInterval.
      769         run waitfram-show (substitute("&1&2 &3&4" ,
      770                                       mWaitFramTextBeg ,
      771                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      772                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      773                                       mWaitFramTextEnd
      774                                      )
      775                           ).
      776      end.
      777      procedure WaitFramRunPause:
      778         define input  parameter iInterval as dec no-undo.
      779         define variable vStart  as datetime-tz no-undo.
      780         define variable vend    as datetime-tz no-undo.
      781         define variable vint as int64 no-undo.
      782         define variable vOk as logical no-undo.
      783         vStart = now.
      784         vend   = vStart.
      785         publish "WaitFramPause" (iInterval,output vOk).
      786         vend   =  now.
      787         vint = vend - vStart.
      788         vint = iInterval - vint / 1000.
      789         if     not mWaitFramStop
      790            and (   vint > 0
      791                 or (    not vOk
      792                     and iInterval eq ?
      793                     )
      794                 )
      795         then
      796            run waitfram-show-this (iInterval).
      797         vend   =  now.
      798         vint = vend - vStart.
      799         vint = iInterval - vint / 1000.
      800         if     not mWaitFramStop
      801            and vint > 0
      802         then do:
      803            run gbl/pause.p (vint * 1000).
      804         end.
      805         if iInterval ne ?
      806         then
      807            publish "WaitFramStop".
      808         waitfram-check-timeout().
      809      end.
      810      procedure WaitFramWaitFor:
      811         define input  parameter iInterval as dec no-undo.
      812         assign
      813            mWaitFramStartProc   = now
      814            mWaitFramStopUser    = no
      815            mWaitFramStopTimeOut = no
      816         .
      817         block-wait:
      818         do while not mWaitFramStop:
      819            run WaitFramRunPause (iInterval).
      820            if  waitfram-check-timeout()
      821            then do:
      822               leave block-wait.
      823            end.
      824         end.
      825         run waitfram-hide.
      826      end.
      827   procedure waitfram-join :
      828     define input  parameter p-line-1  as character no-undo .
      829     define input  parameter p-line-2  as character no-undo .
      830     define input  parameter p-line-3  as character no-undo .
      831     define output parameter p-message as character no-undo .
      832     do
      833     on error undo, return error return-value
      834     :
      835       assign
      836         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      837                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      838                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      839       .
      840     end.
      841   end procedure.
      842   function waitfram-join-function returns character
      843     (input p-line-1 as character
      844     ,input p-line-2 as character
      845     ,input p-line-3 as character
      846     ).
      847     define variable v-message as character no-undo .
      848     run waitfram-join in this-procedure
      849       (input  p-line-1
      850       ,input  p-line-2
      851       ,input  p-line-3
      852       ,output v-message
      853       ) .
      854     return v-message .
      855   end function .
      856   define temp-table temp-font no-undo
      857     field fontnum  as integer
      858     field fontname as character
      859     field fontsize as character
      860     field fonttype as character
      861     field font-h   as integer
      862     field font-w   as integer
      863     field v-row    as integer
      864     field v-col    as integer
      865     field v-row-lans as integer
      866     field v-col-lans as integer
      867   index pi fontnum
      868   .
      869   procedure get-font-ini :
      870     do
      871     on error undo, return error return-value
      872     :
      873   define variable ii as integer   no-undo .
      874   define variable v-font7 as character no-undo .
      875   define variable v-font as character no-undo .
      876   define variable loc-name as character no-undo .
      877   define variable loc-size as character no-undo .
      878   define variable loc-type as character no-undo .
      879   define variable old_H as integer   no-undo .
      880   define variable old_w as integer   no-undo .
      881   define variable old-row  as integer   no-undo .
      882   define variable old-col  as integer   no-undo .
      883   define variable old-row-lans  as integer   no-undo .
      884   define variable old-col-lans  as integer   no-undo .
      885   define variable vv as integer   no-undo .
      886   empty temp-table temp-font.
      887     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
      888       case num-entries (v-font7) :
      889         when 4 then do:
      890             assign
      891               loc-name = entry ( 1 , v-font7 )
      892               loc-size = entry ( 2 , v-font7 )
      893               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
      894             .
      895         end.
      896         when 3 then do:
      897             assign
      898               loc-name = entry ( 1 , v-font7 )
      899               loc-size = entry ( 2 , v-font7 )
      900               loc-type = entry ( 3 , v-font7 )
      901             .
      902         end.
      903         when 2 then  do:
      904             assign
      905               loc-name = entry ( 1 , v-font7 )
      906               loc-size = entry ( 2 , v-font7 )
      907               loc-type = ""
      908             .
      909         end.
      910         when 1 then do:
      911             assign
      912               loc-name = trim(entry ( 1 , v-font7 ))
      913               loc-size = ""
      914               loc-type = ""
      915             .
      916         end.
      917       end case.
      918     create temp-font.
      919     assign
      920       temp-font.fontnum  = 7
      921       temp-font.fontname = trim(loc-name)
      922       temp-font.fontsize = trim(loc-size)
      923       temp-font.fonttype = trim(loc-type)
      924       temp-font.v-row    = 62
      925       temp-font.v-col    = 136
      926       temp-font.v-row-lans = 43
      927       temp-font.v-col-lans = 198
      928     .
      929     repeat ii = 16 to 100 :
      930       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
      931       if v-font = "" or v-font = ? then leave.
      932       case num-entries (v-font) :
      933         when 4 then do:
      934             assign
      935               loc-name = entry ( 1 , v-font )
      936               loc-size = entry ( 2 , v-font )
      937               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
      938             .
      939         end.
      940         when 3 then do:
      941             assign
      942               loc-name = entry ( 1 , v-font )
      943               loc-size = entry ( 2 , v-font )
      944               loc-type = entry ( 3 , v-font )
      945             .
      946         end.
      947         when 2 then do:
      948             assign
      949               loc-name = entry ( 1 , v-font )
      950               loc-size = entry ( 2 , v-font )
      951               loc-type = ""
      952             .
      953         end.
      954         when 1 then do:
      955             assign
      956               loc-name = trim(entry ( 1 , v-font ))
      957               loc-size = ""
      958               loc-type = ""
      959             .
      960         end.
      961       end case.
      962     create temp-font.
      963     assign
      964       temp-font.fontnum  = ii
      965       temp-font.fontname = trim(loc-name)
      966       temp-font.fontsize = trim(loc-size)
      967       temp-font.fonttype = trim(loc-type)
      968     .
      969     end.
      970       for each temp-font :
      971          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
      972          if  vv = ? then vv =  0 .
      973           run rep/exfont.p (
      974             input   temp-font.fontname ,
      975             input   vv ,
      976             input   temp-font.fonttype ,
      977             output  temp-font.font-h   ,
      978             output  temp-font.font-w   )
      979           .
      980       end.
      981   find first temp-font where  temp-font.fontnum  = 7  .
      982   old_H = temp-font.font-H .
      983   old_w = temp-font.font-W .
      984   old-row = temp-font.v-row .
      985   old-col = temp-font.v-col .
      986   old-row-lans = temp-font.v-row-lans .
      987   old-col-lans = temp-font.v-col-lans .
      988       for each temp-font where
      989                temp-font.fontnum  <> 7 :
      990           assign
      991               temp-font.v-row    = old_H * old-row / temp-font.font-h
      992               temp-font.v-col    = old_W * old-col / temp-font.font-W
      993               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
      994               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
      995           .
      996       end.
      997     end.
      998   end procedure.
      999   PROCEDURE How-name :
     1000   define input  parameter h as integer no-undo .
     1001   define input  parameter w as integer no-undo .
     1002   define output parameter n as character  no-undo .
     1003   define variable A4port-H as integer   no-undo init 63.
     1004   define variable A4port-W as integer   no-undo init 136.
     1005   define variable A4lans-H as integer   no-undo init 43.
     1006   define variable A4lans-W as integer   no-undo init 198.
     1007   define variable Strim-W  as integer   no-undo init 278.
     1008   run define-a4-size (
     1009        input ReportFontNum
     1010       ,output A4port-H
     1011       ,output A4port-W
     1012       ,output A4lans-H
     1013       ,output A4lans-W ).
     1014   If w >= 1 and w <= A4port-W Then DO:
     1015     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1016     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1017     If h > A4port-H              Then n = "to-file":U.
     1018   End.
     1019   If w > A4port-W and w <= A4lans-W Then DO:
     1020     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1021     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1022     If h > A4port-H              Then n = "to-file":U.
     1023   End.
     1024   If w > A4lans-W and w <= Strim-W Then DO:
     1025     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1026     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1027     If h > A4port-H              Then n = "to-file":U.
     1028   End.
     1029   If w > Strim-W Then DO:
     1030      n = "to-file":U.
     1031   End.
     1032   END PROCEDURE.
     1033   PROCEDURE define-a4-size :
     1034   define input  parameter p-ReportFontNum as integer   no-undo .
     1035   define output parameter A4port-H as integer   no-undo .
     1036   define output parameter A4port-W as integer   no-undo .
     1037   define output parameter A4lans-H as integer   no-undo .
     1038   define output parameter A4lans-W as integer   no-undo .
     1039   if not can-find (first temp-font ) then do:
     1040      run get-font-ini .
     1041   end.
     1042   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1043   if available temp-font then do:
     1044   assign
     1045     A4port-H = temp-font.v-row
     1046     A4port-W = temp-font.v-col
     1047     A4lans-H = temp-font.v-row-lans
     1048     A4lans-W = temp-font.v-col-lans
     1049   .
     1050   end.
     1051   else do:
     1052   assign
     1053     A4port-H = 63
     1054     A4port-W = 136
     1055     A4lans-H = 43
     1056     A4lans-W = 198
     1057   .
     1058   end.
     1059   END PROCEDURE.
     1060   define variable g#report-num  as integer no-undo .
     1061   run get-report-num in my-handle (output g#report-num).
     1062   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1063   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1064   procedure paramls-clear :
     1065     define buffer buf_temp-param for temp-param .
     1066     do
     1067     on error undo, return error return-value
     1068     :
     1069       for each buf_temp-param
     1070       on error undo, return error
     1071       :
     1072         delete buf_temp-param .
     1073       end.
     1074     end.
     1075   end procedure.
     1076   procedure paramls-write :
     1077     define input  parameter p-code     as character no-undo .
     1078     define input  parameter p-sub-code as character no-undo .
     1079     define input  parameter p-value    as character no-undo .
     1080     define buffer buf_temp-param for temp-param .
     1081     do
     1082     on error undo, return error return-value
     1083     :
     1084       find first buf_temp-param
     1085         where buf_temp-param.param-code     = p-code
     1086           and buf_temp-param.param-sub-code = p-sub-code
     1087         no-error .
     1088       if not available buf_temp-param then do:
     1089         create buf_temp-param .
     1090         assign
     1091           buf_temp-param.param-code     = p-code
     1092           buf_temp-param.param-sub-code = p-sub-code
     1093         .
     1094       end.
     1095       assign
     1096         buf_temp-param.param-value = p-value
     1097       .
     1098     end.
     1099   end procedure.
     1100   procedure paramls-read :
     1101     define input  parameter p-code          as character no-undo .
     1102     define input  parameter p-sub-code      as character no-undo .
     1103     define input  parameter p-default-value as character no-undo .
     1104     define output parameter p-value         as character no-undo .
     1105     define buffer buf_temp-param for temp-param .
     1106     do
     1107     on error undo, return error return-value
     1108     :
     1109       find first buf_temp-param
     1110         where buf_temp-param.param-code     = p-code
     1111           and buf_temp-param.param-sub-code = p-sub-code
     1112         no-error .
     1113       if available buf_temp-param then do:
     1114         assign
     1115           p-value = buf_temp-param.param-value
     1116         .
     1117       end.
     1118       else do:
     1119         assign
     1120           p-value = p-default-value
     1121         .
     1122       end.
     1123     end.
     1124   end procedure.
     1125   procedure paramls-append :
     1126     define input  parameter p-code     as character no-undo .
     1127     define input  parameter p-sub-code as character no-undo .
     1128     define input  parameter p-value    as character no-undo .
     1129     define buffer buf_temp-param for temp-param .
     1130     do
     1131     on error undo, return error return-value
     1132     :
     1133       find first buf_temp-param
     1134            where buf_temp-param.param-code     = p-code
     1135              and buf_temp-param.param-sub-code = p-sub-code
     1136         no-error .
     1137       if not available buf_temp-param then do:
     1138         create buf_temp-param .
     1139         assign
     1140           buf_temp-param.param-code     = p-code
     1141           buf_temp-param.param-sub-code = p-sub-code
     1142           buf_temp-param.param-value    = p-value
     1143         .
     1144       end.
     1145       else do:
     1146           assign
     1147               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1148           .
     1149       end.
     1150     end.
     1151   end procedure.
     1152   define variable vss-include-info10 as character format "X(65)" no-undo
     1153   initial "@(#)$Workfile$ $Revision$".
     1154   define stream excel-line.
     1155   define stream excel-cell.
     1156   define temp-table temp_cell-data no-undo
     1157       field data-key as character
     1158       field data-value as character
     1159       index pi is primary unique data-key
     1160   .
     1161   define temp-table temp_sheet1_line-data no-undo
     1162       field sheet-name    as character
     1163       field xl-line-id    as integer
     1164       field objName      as character
     1165       field fuelName     as character
     1166       field daySale      as character
     1167       field salePrice    as character
     1168       field notFuelSale as character
     1169       index pi is primary unique
     1170           xl-line-id
     1171   .
     1172   define variable v-hazkrtxl-sheet1-cur-data-row  as integer      no-undo.
     1173   define variable v-hazkrtxl-cell-file-name       as character    no-undo.
     1174   define variable v-hazkrtxl-data-file-name       as character    no-undo.
     1175   procedure hazkrtxl-init :
     1176   do
     1177   on error undo, return error
     1178   :
     1179       assign
     1180           v-hazkrtxl-sheet1-cur-data-row = 0
     1181       .
     1182       run gbl/_tmpfile.p (
     1183             input "xd"
     1184           , input ".txt"
     1185           , output v-hazkrtxl-data-file-name
     1186       ).
     1187       output stream excel-line to value( v-hazkrtxl-data-file-name ).
     1188       run gbl/_tmpfile.p (
     1189             input "xc"
     1190           , input ".txt"
     1191           , output v-hazkrtxl-cell-file-name
     1192       ).
     1193       output stream excel-cell to value( v-hazkrtxl-cell-file-name ).
     1194       run hazkrtxl-write-cell-data in this-procedure (
     1195             input "sheetList":U
     1196           , input "Сводка":U
     1197       ).
     1198       run hazkrtxl-write-cell-data in this-procedure (
     1199             input "Сводка_regularExpressions":U
     1200           , input "1":U
     1201       ).
     1202       if printrubl
     1203       then do:
     1204           run hazkrtxl-write-cell-data in this-procedure (
     1205                 input "Сводка_valutCode":U
     1206               , input "0":U
     1207           ).
     1208       end.
     1209       else do:
     1210           run hazkrtxl-write-cell-data in this-procedure (
     1211                 input "Сводка_valutCode":U
     1212               , input "1":U
     1213           ).
     1214       end.
     1215       run hazkrtxl-write-cell-data in this-procedure (
     1216             input "Сводка_columnList":U
     1217           , input "objName,fuelName,daySale,salePrice,notFuelSale":U
     1218       ).
     1219       run hazkrtxl-write-cell-data in this-procedure (
     1220             input "Сводка_columnType":U
     1221           , input "S,S,S,S,D":U
     1222       ).
     1223   end.
     1224   end procedure.
     1225   procedure hazkrtxl-write-line-data :
     1226   define input parameter p-obj-name       as character        no-undo.
     1227   define input parameter p-fuel-name      as character        no-undo.
     1228   define input parameter p-day-sale       as character        no-undo.
     1229   define input parameter p-sale-price     as character        no-undo.
     1230   define input parameter p-not-fuel-sale  as character        no-undo.
     1231       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     1232   do
     1233   for buf_temp_sheet1_line-data
     1234   on error undo, return error
     1235   :
     1236       for each buf_temp_sheet1_line-data
     1237       :
     1238           delete buf_temp_sheet1_line-data.
     1239       end.
     1240       create buf_temp_sheet1_line-data.
     1241       assign
     1242           v-hazkrtxl-sheet1-cur-data-row = v-hazkrtxl-sheet1-cur-data-row + 1
     1243       .
     1244       assign
     1245           buf_temp_sheet1_line-data.sheet-name  = "Сводка":U
     1246           buf_temp_sheet1_line-data.xl-line-id  = v-hazkrtxl-sheet1-cur-data-row
     1247           buf_temp_sheet1_line-data.objName     = p-obj-name
     1248           buf_temp_sheet1_line-data.fuelName    = p-fuel-name
     1249           buf_temp_sheet1_line-data.daySale     = p-day-sale
     1250           buf_temp_sheet1_line-data.salePrice   = p-sale-price
     1251           buf_temp_sheet1_line-data.notFuelSale = p-not-fuel-sale
     1252       .
     1253       put stream excel-line unformatted
     1254                           buf_temp_sheet1_line-data.sheet-name
     1255           CHR(9)   "DTA":U
     1256           CHR(9)   buf_temp_sheet1_line-data.objName
     1257           CHR(9)   buf_temp_sheet1_line-data.fuelName
     1258           CHR(9)   buf_temp_sheet1_line-data.daySale
     1259           CHR(9)   buf_temp_sheet1_line-data.salePrice
     1260           CHR(9)   buf_temp_sheet1_line-data.notFuelSale
     1261           chr(10)
     1262       .
     1263   end.
     1264   end procedure.
     1265   procedure hazkrtxl-write-cell-data :
     1266   define input parameter p-data-key   as character        no-undo.
     1267   define input parameter p-data-value as character        no-undo.
     1268       define buffer buf_temp_cell-data     for temp_cell-data.
     1269   do
     1270   for buf_temp_cell-data
     1271   on error undo, return error
     1272   :
     1273       find first buf_temp_cell-data
     1274            where buf_temp_cell-data.data-key = p-data-key
     1275       no-error.
     1276       if not available buf_temp_cell-data
     1277       then do:
     1278           create buf_temp_cell-data.
     1279           assign
     1280               buf_temp_cell-data.data-key = p-data-key
     1281           .
     1282       end.
     1283       assign
     1284           buf_temp_cell-data.data-value = p-data-value
     1285       .
     1286       put stream excel-cell unformatted
     1287                           buf_temp_cell-data.data-key
     1288           CHR(9)   buf_temp_cell-data.data-value
     1289           chr(10)
     1290       .
     1291   end.
     1292   end procedure.
     1293   procedure hazkrtxl-run-excel :
     1294   define input parameter p-header-filename    as character        no-undo.
     1295   define input parameter p-data-filename      as character        no-undo.
     1296       define variable v-template-file-name    as character    no-undo.
     1297       define variable v-vb-file-name          as character    no-undo.
     1298       define buffer buf_temp-param for temp-param .
     1299   do
     1300   for buf_temp-param
     1301   on error undo, return error
     1302   :
     1303       create buf_temp-param.
     1304       assign
     1305           v-template-file-name    = search( "exe/hazkrt1.xlt" )
     1306           v-vb-file-name          = search( "exe/t_form.bas" )
     1307       .
     1308       if v-template-file-name = ?
     1309       or v-template-file-name = "":U
     1310       then do:
     1311           message
     1312               "Ошибка имени файла шаблона."
     1313           view-as alert-box error.
     1314       end.
     1315       if v-vb-file-name = ?
     1316       or v-vb-file-name = "":U
     1317       then do:
     1318           message
     1319               "Ошибка имени файла кода обработки."
     1320           view-as alert-box error.
     1321       end.
     1322       run paramls-write in this-procedure (
     1323             input "template":U
     1324           , input "template-file-name":U
     1325           , input v-template-file-name
     1326       ).
     1327       run paramls-write in this-procedure (
     1328             input "template":U
     1329           , input "vb-file-name":U
     1330           , input v-vb-file-name
     1331       ).
     1332       run paramls-write in this-procedure (
     1333             input "data":U
     1334           , input "data-header-filename":U
     1335           , input p-header-filename
     1336       ).
     1337       run paramls-write in this-procedure (
     1338             input "data":U
     1339           , input "data-filename":U
     1340           , input p-data-filename
     1341       ).
     1342       run gbl/macroxlt.p (
     1343           input-output table buf_temp-param
     1344       ) no-error.
     1345       if error-status :error
     1346       then do:
     1347           message
     1348                    vss-workfile vss-revision vss-description
     1349               skip(1)
     1350               skip "Ошибка создания файла Excel."
     1351               skip return-value
     1352               skip trim(error-status :get-message(1))
     1353                    trim(error-status :get-message(2))
     1354                    trim(error-status :get-message(3))
     1355           view-as alert-box error.
     1356           undo, return error .
     1357       end.
     1358   end.
     1359   end procedure.
     1360   procedure hazkrtxl-close :
     1361   do
     1362   on error undo, return error
     1363   :
     1364       output stream excel-line close.
     1365       output stream excel-cell close.
     1366       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1367           export "exe/hazkrt1.xlt":U.
     1368           export "exe/t_form.bas":U.
     1369           export v-hazkrtxl-cell-file-name.
     1370           export v-hazkrtxl-data-file-name.
     1371       output close.
     1372   end.
     1373   end procedure.
