     1160   PROCEDURE adm-cancel-record :
     1161      RETURN.
     1162     END PROCEDURE.
     1163   PROCEDURE adm-copy-record :
     1164       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1165        "must have at least one Enabled Table to perform Copy.":U
     1166          VIEW-AS ALERT-BOX ERROR.
     1167       RETURN.
     1168   END PROCEDURE.
     1169   PROCEDURE adm-create-record :
     1170      RETURN.
     1171   END PROCEDURE.
     1172   PROCEDURE adm-current-changed :
     1173     RETURN.
     1174   END PROCEDURE.
     1175   PROCEDURE adm-delete-record :
     1176    MESSAGE
     1177          "Object ":U THIS-PROCEDURE:FILE-NAME
     1178            "must have at least one Enabled Table to perform Delete.":U
     1179              VIEW-AS ALERT-BOX ERROR.
     1180       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1181       RETURN.
     1182   END PROCEDURE.
     1183   PROCEDURE adm-disable-fields :
     1184         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1185       RETURN.
     1186   END PROCEDURE.
     1187   PROCEDURE adm-enable-fields :
     1188       RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE adm-end-update :
     1191     RETURN.
     1192   END PROCEDURE.
     1193   PROCEDURE adm-reset-record :
     1194       RETURN.
     1195   END PROCEDURE.
     1196   PROCEDURE adm-update-record :
     1197       MESSAGE
     1198         "Object ":U THIS-PROCEDURE:FILE-NAME
     1199           "must have at least one Enabled Table to perform Update.":U
     1200             VIEW-AS ALERT-BOX ERROR.
     1201      RETURN.
     1202   END PROCEDURE.
     1203   PROCEDURE check-modified :
     1204   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1205   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1206   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1207   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1208     IF check-state = "check":U THEN
     1209     DO:
     1210       RUN get-link-handle IN adm-broker-hdl
     1211         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1212            OUTPUT group-target-list).
     1213       IF group-target-list NE "":U THEN
     1214       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1215         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1216         RUN check-modified IN curr-widget ('group-check':U).
     1217         IF RETURN-VALUE NE "":U THEN
     1218         DO:
     1219           RUN check-modified-message(RETURN-VALUE).
     1220           RETURN "":U.
     1221         END.
     1222       END.
     1223     END.
     1224     RETURN "":U.
     1225   END PROCEDURE.
     1226   PROCEDURE check-modified-message :
     1227     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1228        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1229           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1230        IF RETURN-VALUE = "YES":U THEN
     1231           RUN notify ('view,CONTAINER-SOURCE':U).
     1232        MESSAGE IF p-changed-table NE ? THEN
     1233           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1234           ELSE "Current values have been changed."
     1235           SKIP "  Do you wish to save those changes?"
     1236           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1237        IF ANS THEN
     1238        DO:
     1239           IF group-assign-target THEN
     1240             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1241           ELSE RUN dispatch('update-record':U).
     1242           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1243           DO:
     1244               MESSAGE "Changes to the previous record were not saved."
     1245                 VIEW-AS ALERT-BOX ERROR.
     1246               IF group-assign-target THEN
     1247                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1248               ELSE RUN dispatch ('cancel-record':U).
     1249           END.
     1250        END.
     1251        ELSE DO:
     1252          IF group-assign-target THEN
     1253             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1254          ELSE RUN dispatch('cancel-record':U).
     1255        END.
     1256        RETURN.
     1257   END PROCEDURE.
     1258   PROCEDURE get-rowid :
     1259       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1260       ASSIGN
     1261       p-table   =   adm-first-table.
     1262       RETURN.
     1263   END PROCEDURE.
     1264   PROCEDURE init-group-assign :
     1265       RUN request-attribute IN adm-broker-hdl
     1266         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1267       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1268         group-assign-target = yes.
     1269       ELSE group-assign-target = no.
     1270       RETURN.
     1271   END PROCEDURE.
     1272   PROCEDURE set-editors :
     1273       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1274       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1275       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1276       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1277       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1278       DO WHILE VALID-HANDLE (curr-widget):
     1279           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1280              curr-widget:HIDDEN = no THEN DO:
     1281             CASE p-field-setting:
     1282               WHEN "INITIALIZE":U THEN
     1283               DO:
     1284                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1285                     read-only-list +
     1286                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1287                        STRING(curr-widget).
     1288               END.
     1289               WHEN "DISABLE":U OR
     1290               WHEN "ENABLE":U THEN
     1291               DO:
     1292                   curr-widget:SENSITIVE = yes.
     1293                   RUN get-attribute ('Read-Only-Editors':U).
     1294                   IF RETURN-VALUE = ? OR
     1295                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1296                       curr-widget:READ-ONLY =
     1297                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1298               END.
     1299               WHEN "CLEAR":U THEN
     1300                   curr-widget:SCREEN-VALUE = "":U.
     1301             END CASE.
     1302           END.
     1303           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1304       END.
     1305       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1306         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1307           + '"':U).
     1308       RETURN.
     1309   END PROCEDURE.
     1310   PROCEDURE use-check-modified-all :
     1311    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1312     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1313     RETURN.
     1314   END PROCEDURE.
     1315   PROCEDURE use-create-on-add :
     1316   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1317      RETURN.
     1318   END PROCEDURE.
     1319   PROCEDURE use-initial-lock :
     1320     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1321     ASSIGN adm-initial-lock = p-attr-value.
     1322     RETURN.
     1323   END PROCEDURE.
     1324     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1325   ASSIGN
     1326          FRAME F-Main:SCROLLABLE       = FALSE
     1327          FRAME F-Main:HIDDEN           = TRUE.
     1328   ON VALUE-CHANGED OF tg-absence-period IN FRAME F-Main
     1329   DO:
     1330     run proc-tg-absence-period in this-procedure no-error .
     1331     if error-status :error = yes
     1332     then do:
     1333       return no-apply.
     1334     end.
     1335   END.
     1336   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1337   on ' ' of fi-absence-period-from in frame F-Main
     1338   do:
     1339     if (can-query (self, "sensitive")
     1340        and
     1341        self :sensitive = true
     1342        )
     1343     or (can-query (self, "read-only")
     1344        and
     1345        self :read-only = false
     1346        )
     1347     then do:
     1348       assign
     1349         self :screen-value = ?
     1350       .
     1351     end.
     1352     return no-apply.
     1353   end.
     1354   on delete-character of fi-absence-period-from in frame F-Main
     1355   do:
     1356     if (can-query (self, "sensitive")
     1357        and
     1358        self :sensitive = true
     1359        )
     1360     or (can-query (self, "read-only")
     1361        and
     1362        self :read-only = false
     1363        )
     1364     then do:
     1365       assign
     1366         self :screen-value = ?
     1367       .
     1368     end.
     1369     return no-apply.
     1370   end.
     1371   on ctrl-d of fi-absence-period-from in frame F-Main
     1372   do:
     1373     define variable v-curr-sv-date as date no-undo .
     1374     if (can-query (self, "sensitive")
     1375        and
     1376        self :sensitive = true
     1377        )
     1378     or (can-query (self, "read-only")
     1379        and
     1380        self :read-only = false
     1381        )
     1382     then do:
     1383       if self :handle <> focus :handle
     1384       then do:
     1385         apply "entry":u to self .
     1386       end.
     1387       run gbl/getcurdt.p
     1388         (output v-curr-sv-date
     1389         ) .
     1390       assign
     1391         self :screen-value = string(v-curr-sv-date) .
     1392       .
     1393     end.
     1394     return no-apply.
     1395   end.
     1396   on ctrl-b of fi-absence-period-from in frame F-Main
     1397   do:
     1398     if (can-query (self, "sensitive")
     1399        and
     1400        self :sensitive = true
     1401        )
     1402     or (can-query (self, "read-only")
     1403        and
     1404        self :read-only = false
     1405        )
     1406     then do:
     1407       if self :handle <> focus :handle
     1408       then do:
     1409         apply "entry":u to self .
     1410       end.
     1411       define variable v-curr-sv-date as date no-undo .
     1412       define variable v-new-sv-date  as date no-undo .
     1413       assign
     1414         v-curr-sv-date = date(self :screen-value) no-error
     1415       .
     1416       if v-curr-sv-date = ?
     1417       then do:
     1418         run gbl/getcurdt.p
     1419           (output v-curr-sv-date
     1420           ) .
     1421       end.
     1422       if v-curr-sv-date <> ?
     1423       then do:
     1424         assign
     1425           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1426         .
     1427         assign
     1428           self :screen-value = string(v-new-sv-date) .
     1429         .
     1430       end.
     1431     end.
     1432     return no-apply .
     1433   end.
     1434   on ctrl-e of fi-absence-period-from in frame F-Main
     1435   do:
     1436     if (can-query (self, "sensitive")
     1437        and
     1438        self :sensitive = true
     1439        )
     1440     or (can-query (self, "read-only")
     1441        and
     1442        self :read-only = false
     1443        )
     1444     then do:
     1445       if self :handle <> focus :handle
     1446       then do:
     1447         apply "entry":u to self .
     1448       end.
     1449       define variable v-curr-sv-date as date no-undo .
     1450       define variable v-new-sv-date  as date no-undo .
     1451       assign
     1452         v-curr-sv-date = date(self :screen-value) no-error
     1453       .
     1454       if v-curr-sv-date = ?
     1455       then do:
     1456         run gbl/getcurdt.p
     1457           (output v-curr-sv-date
     1458           ) .
     1459       end.
     1460       if v-curr-sv-date <> ?
     1461       then do:
     1462         run gbl/lastdate.p
     1463           (input  v-curr-sv-date
     1464           ,output v-new-sv-date
     1465           ).
     1466         assign
     1467           self :screen-value = string(v-new-sv-date) .
     1468         .
     1469       end.
     1470     end.
     1471     return no-apply .
     1472   end.
     1473   on ctrl-f of fi-absence-period-from in frame F-Main
     1474   do:
     1475     if (can-query (self, "sensitive")
     1476        and
     1477        self :sensitive = true
     1478        )
     1479     or (can-query (self, "read-only")
     1480        and
     1481        self :read-only = false
     1482        )
     1483     then do:
     1484       if self :handle <> focus :handle
     1485       then do:
     1486         apply "entry":u to self .
     1487       end.
     1488       define variable v-ok            as logical   no-undo .
     1489       define variable v-curr-sv-date  as date      no-undo .
     1490       define variable v-description   as character no-undo .
     1491       assign
     1492         v-curr-sv-date = date(self :screen-value) no-error
     1493       .
     1494       if v-curr-sv-date = ?
     1495       then do:
     1496         run gbl/getcurdt.p
     1497           (output v-curr-sv-date
     1498           ) .
     1499       end.
     1500       if v-curr-sv-date <> ?
     1501       then do:
     1502         run gbl/d-inpday.w
     1503           (input ?
     1504           ,input "Выбор даты"
     1505           ,input v-description
     1506           ,input ""
     1507           ,input-output v-curr-sv-date
     1508           ,output v-ok
     1509           ).
     1510         if v-ok = true
     1511         then do:
     1512           assign
     1513             self :screen-value = string(v-curr-sv-date) .
     1514           .
     1515         end.
     1516       end.
     1517     end.
     1518     return no-apply .
     1519   end.
     1520     define MENU m-ed-date15
     1521       MENU-ITEM m-ed-date15-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1522       MENU-ITEM m-ed-date15-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
