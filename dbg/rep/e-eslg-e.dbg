      687   procedure uf-name :
      688     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      689     define output parameter p-use-List_     as logical   no-undo .
      690     define output parameter p-type-List_     as character no-undo .
      691     define output parameter p-format-List_   as character no-undo .
      692     define output parameter p-use-Naim      as logical   no-undo .
