      766               when 'wrsttl2':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Реестр отоваренных талонов"     p-tooltip = "Реестр отоваренных талонов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      767               when 'wthobr-sup':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Оборотная ведомость серийных МЦ по контрагентам"     p-tooltip = "Оборотная ведомость серийных МЦ по контрагентам"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      768               when 'wthobr-wth':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Оборотная ведомость серийных МЦ по контрагентам"     p-tooltip = "Оборотная ведомость серийных МЦ по контрагентам"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      769               when 'e-ptlbal':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      770               when 'ctrasm':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Контроль ассортиментной матрицы"     p-tooltip = "Контроль ассортиментной матрицы"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      771               when 'e-eslg-e':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      772               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      773               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      774               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      775               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      776                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      777               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      778         otherwise do:
      779           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      780         end.
      781       end CASE.
      782     end.
      783   end procedure.
      784   procedure uf-get :
      785     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      786     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      787     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      788     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      789     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      790     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      791     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      792     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      793     do
      794     on error undo, return error
      795     :
      796       define buffer buf_usr-flt for ubflt.usr-flt .
      797       define variable v-use-List_     as logical   no-undo .
      798       define variable v-type-List_     as character no-undo .
      799       define variable v-format-List_   as character no-undo .
      800       define variable v-use-Naim      as logical   no-undo .
      801       define variable v-type-Naim      as character no-undo .
      802       define variable v-format-Naim    as character no-undo .
      803       define variable v-use-print-graft as logical   no-undo .
      804       define variable v-use-sort-gr     as logical   no-undo .
      805       define variable v-use-type-price  as logical   no-undo .
      806       define variable v-use-type-val    as logical   no-undo .
      807       define variable v-label          as character no-undo .
      808       define variable v-tooltip        as character no-undo .
      809       define variable v-user-can-edit  as logical   no-undo .
      810       define variable v-output-display as logical   no-undo .
      811       define variable v-other          as character no-undo .
      812       run uf-name in this-procedure
      813          (input  entry(1, p-code, chr(4))
      814         ,output v-use-List_
      815         ,output v-type-List_
      816         ,output v-format-List_
      817         ,output v-use-Naim
      818         ,output v-type-Naim
      819         ,output v-format-Naim
      820         ,output v-use-print-graft
      821         ,output v-use-sort-gr
      822         ,output v-use-type-price
      823         ,output v-use-type-val
      824         ,output v-label
      825         ,output v-tooltip
      826         ,output v-user-can-edit
      827         ,output v-output-display
      828         ,output v-other
      829         ) no-error .
      830       if error-status :error then do:
      831         undo, return error return-value .
      832       end.
      833       find first buf_usr-flt no-lock where
      834                  buf_usr-flt.Call-point     = p-code AND
      835                  buf_usr-flt.user-name       = p-user-name
      836         no-error .
      837       if avail buf_usr-flt then do:
      838         assign
      839         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      840         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      841         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      842         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      843         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      844         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      845         .
      846       end.
      847       else do:
      848         assign
      849         p-List_        = (if v-use-List_       then "":U                    else ?)
      850         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      851         p-print-graft  = (if v-use-print-graft then no                      else ?)
      852         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      853         p-type-price   = (if v-use-type-price  then no                      else ?)
      854         p-type-val     = (if v-use-List_       then no                      else ?)
      855         .
      856       end.
      857     end.
      858   end procedure.
      859   procedure uf-set :
      860     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      861     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      862     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      863     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      864     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      865     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      866     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      867     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      868     do
      869     on error undo, return error
      870     :
      871       define buffer buf_usr-flt for ubflt.usr-flt .
      872       define variable v-use-List_     as logical   no-undo .
      873       define variable v-type-List_     as character no-undo .
      874       define variable v-format-List_   as character no-undo .
      875       define variable v-use-Naim      as logical   no-undo .
      876       define variable v-type-Naim      as character no-undo .
      877       define variable v-format-Naim    as character no-undo .
      878       define variable v-use-print-graft as logical   no-undo .
      879       define variable v-use-sort-gr   as logical   no-undo .
      880       define variable v-use-type-price as logical   no-undo .
      881       define variable v-use-type-val  as logical   no-undo .
      882       define variable v-tooltip        as character no-undo .
      883       define variable v-label          as character no-undo .
      884       define variable v-user-can-edit  as logical   no-undo .
      885       define variable v-output-display as logical   no-undo .
      886       define variable v-other          as character no-undo .
      887       run uf-name in this-procedure
      888         (input  entry(1, p-code, chr(4))
      889         ,output v-use-List_
      890         ,output v-type-List_
      891         ,output v-format-List_
      892         ,output v-use-Naim
      893         ,output v-type-Naim
      894         ,output v-format-Naim
      895         ,output v-use-print-graft
      896         ,output v-use-sort-gr
      897         ,output v-use-type-price
      898         ,output v-use-type-val
      899         ,output v-label
      900         ,output v-tooltip
      901         ,output v-user-can-edit
      902         ,output v-output-display
      903         ,output v-other
      904         ) no-error .
      905       if error-status :error then do:
      906         undo, return error return-value .
      907       end.
      908       find first buf_usr-flt where
      909                  buf_usr-flt.Call-point     = p-code AND
      910                  buf_usr-flt.user-name       = p-user-name
      911         no-error .
      912       if not avail buf_usr-flt then do:
      913           create buf_usr-flt .
      914           assign
      915           buf_usr-flt.call-point = p-code
      916           buf_usr-flt.user-name  = p-user-name
      917           .
      918       end.
      919       if avail buf_usr-flt then do:
      920        assign
      921        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      922        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      923        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      924        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      925        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      926        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      927       .
      928       release buf_usr-flt.
      929       end.
      930       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      931     end.
      932   end procedure.
      933   DEFINE VARIABLE fi-absence-period-from AS DATE FORMAT "99/99/9999":U
      934        LABEL "с"
      935        VIEW-AS FILL-IN
      936        SIZE 11 BY 1 NO-UNDO.
      937   DEFINE VARIABLE fi-absence-period-to AS DATE FORMAT "99/99/9999":U
      938        LABEL "по"
      939        VIEW-AS FILL-IN
      940        SIZE 11 BY 1 NO-UNDO.
      941   DEFINE VARIABLE fi-critical-balance AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
      942        LABEL "Критический остаток товара"
      943        VIEW-AS FILL-IN
      944        SIZE 7 BY 1 NO-UNDO.
      945   DEFINE VARIABLE fi-days-absence AS INTEGER FORMAT ">>9":U INITIAL 1
      946        LABEL "Количество дней отсутствия товара"
      947        VIEW-AS FILL-IN
      948        SIZE 7 BY 1 NO-UNDO.
      949   DEFINE RECTANGLE RECT-6
      950        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      951        SIZE 69.5 BY 12.
      952   DEFINE RECTANGLE RECT-7
      953        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      954        SIZE 66.5 BY 3.
      955   DEFINE VARIABLE NullStr AS LOGICAL INITIAL no
      956        LABEL "Показать непроходившие товары"
      957        VIEW-AS TOGGLE-BOX
      958        SIZE 33 BY .83 NO-UNDO.
      959   DEFINE VARIABLE tg-absence-period AS LOGICAL INITIAL no
      960        LABEL "Отсутствуют продажи за период"
      961        VIEW-AS TOGGLE-BOX
      962        SIZE 47.5 BY .83 NO-UNDO.
      963   DEFINE FRAME F-Main
      964        NullStr AT ROW 2 COL 3.5
      965        fi-days-absence AT ROW 3 COL 37 COLON-ALIGNED WIDGET-ID 2
      966        fi-critical-balance AT ROW 4 COL 37 COLON-ALIGNED WIDGET-ID 4
      967        tg-absence-period AT ROW 5 COL 3.5 WIDGET-ID 6
      968        fi-absence-period-from AT ROW 7 COL 6 COLON-ALIGNED WIDGET-ID 8
      969        fi-absence-period-to AT ROW 7 COL 22.5 COLON-ALIGNED WIDGET-ID 10
      970        RECT-6 AT ROW 1.5 COL 2
      971        RECT-7 AT ROW 6 COL 3.5 WIDGET-ID 12
      972       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      973            SIDE-LABELS NO-UNDERLINE THREE-D
      974            AT COL 1 ROW 1 SCROLLABLE .
      975   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      976   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      977   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      978   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      979   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      980   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      981   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      982   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      983         adm-object-hdl = FRAME F-Main:HANDLE.
      984   RUN ensure-broker.
      985   THIS-PROCEDURE:ADM-DATA =
      986        'ADM1.1~`':U +
      987        'SmartObject~`':U +
      988        '~`':U +
      989        'NO ~`':U +
      990        '~`':U +
      991        '~`':U +
      992        '~`':U +
      993        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      994           + "~`":U +
      995        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      996        'Record-Source,Record-Target,TableIO-Target~`':U +
      997        '~`':U +
      998        '~`~`~`~`~`~`~`~`~`~`~`':U +
      999        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1000            THEN "^^":U
     1001        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1002             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1003   PROCEDURE adm-apply-entry :
     1004     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1005   END PROCEDURE.
     1006   PROCEDURE adm-destroy :
     1007    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1008   END PROCEDURE.
     1009   PROCEDURE adm-disable :
     1010       DISABLE RECT-6 RECT-7 NullStr fi-days-absence fi-critical-balance tg-absence-period fi-absence-period-from fi-absence-period-to WITH FRAME F-Main.
     1011       RUN dispatch ('disable-fields':U).
     1012       RUN set-attribute-list ('ENABLED=no':U).
     1013       RETURN.
     1014   END PROCEDURE.
     1015   PROCEDURE adm-edit-attribute-list :
     1016         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1017         RETURN.
     1018   END PROCEDURE.
     1019   PROCEDURE adm-enable :
     1020       ENABLE UNLESS-HIDDEN RECT-6 RECT-7 NullStr fi-days-absence fi-critical-balance tg-absence-period fi-absence-period-from fi-absence-period-to WITH FRAME F-Main.
     1021       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1022       RUN set-attribute-list ('ENABLED=yes':U).
     1023       RETURN.
     1024   END PROCEDURE.
     1025   PROCEDURE adm-exit :
     1026        RUN notify ('exit':U).
     1027     RETURN.
     1028   END PROCEDURE.
     1029   PROCEDURE adm-hide :
     1030     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1031   END PROCEDURE.
     1032   PROCEDURE adm-initialize :
     1033     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1034   END PROCEDURE.
     1035   PROCEDURE adm-show-errors :
     1036       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1037       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1038           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1039       END.
     1040       RETURN.
     1041   END PROCEDURE.
     1042   PROCEDURE adm-UIB-mode :
     1043     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1044   END PROCEDURE.
     1045   PROCEDURE adm-view :
     1046     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1047   END PROCEDURE.
     1048   PROCEDURE dispatch :
     1049       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1050       RUN broker-dispatch IN adm-broker-hdl
     1051           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1052       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1053   END PROCEDURE.
     1054   PROCEDURE ensure-broker :
     1055   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1056   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1057   DO:
     1058       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1059       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1060   END.
     1061   END PROCEDURE.
     1062   PROCEDURE get-attribute :
     1063     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1064     RUN broker-get-attribute IN adm-broker-hdl
     1065         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1066     RETURN RETURN-VALUE.
     1067   END PROCEDURE.
     1068   PROCEDURE get-attribute-list :
     1069     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1070     RUN broker-get-attribute-list IN adm-broker-hdl
     1071         (INPUT THIS-PROCEDURE,
     1072          INPUT ?,
     1073          OUTPUT p-attr-list) NO-ERROR.
     1074     RETURN.
     1075   END PROCEDURE.
     1076   PROCEDURE new-state :
     1077     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1078     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1079     RETURN.
     1080   END PROCEDURE.
     1081   PROCEDURE notify :
     1082     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1083     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1084     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1085         RETURN "ADM-ERROR":U.
     1086     RETURN.
     1087   END PROCEDURE.
     1088   PROCEDURE set-attribute-list :
     1089     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1090     RUN ensure-broker.
     1091     RUN broker-set-attribute-list IN adm-broker-hdl
     1092         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1093     RETURN.
     1094   END PROCEDURE.
     1095   PROCEDURE set-position :
     1096       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1097       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1098       IF VALID-HANDLE(adm-object-hdl) THEN
     1099       DO:
     1100         ASSIGN adm-object-hdl:ROW    =   p-row
     1101                adm-object-hdl:COLUMN =   p-col.
     1102       END.
     1103       RETURN.
     1104   END PROCEDURE.
     1105   PROCEDURE adm-display-fields :
     1106       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1107       RETURN.
     1108   END PROCEDURE.
     1109   PROCEDURE adm-open-query :
     1110     RETURN.
     1111   END PROCEDURE.
     1112   PROCEDURE adm-row-changed :
     1113         IF VALID-HANDLE(adm-object-hdl) THEN
     1114           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1115         RUN notify ('row-available':U).
     1116         RETURN.
     1117   END PROCEDURE.
     1118   PROCEDURE reposition-query :
     1119       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1120       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1121       RETURN.
     1122   END PROCEDURE.
     1123     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1124     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1125     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1126     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1127     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1128     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1129     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1130     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1131     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1132     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1133     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1134     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1135     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1136     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1137     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1138     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1139     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1140     IF "":U = "":U THEN
     1141       RUN modify-list-attribute IN adm-broker-hdl
     1142         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1143     RUN use-create-on-add(?).
     1144   PROCEDURE adm-add-record :
