     1595   do:
     1596     define variable v-curr-sv-date as date no-undo .
     1597     if (can-query (self, "sensitive")
     1598        and
     1599        self :sensitive = true
     1600        )
     1601     or (can-query (self, "read-only")
     1602        and
     1603        self :read-only = false
     1604        )
     1605     then do:
     1606       if self :handle <> focus :handle
     1607       then do:
     1608         apply "entry":u to self .
     1609       end.
     1610       run gbl/getcurdt.p
     1611         (output v-curr-sv-date
     1612         ) .
     1613       assign
     1614         self :screen-value = string(v-curr-sv-date) .
     1615       .
     1616     end.
     1617     return no-apply.
     1618   end.
     1619   on ctrl-b of fi-absence-period-to in frame F-Main
     1620   do:
     1621     if (can-query (self, "sensitive")
     1622        and
     1623        self :sensitive = true
     1624        )
     1625     or (can-query (self, "read-only")
     1626        and
     1627        self :read-only = false
     1628        )
     1629     then do:
     1630       if self :handle <> focus :handle
     1631       then do:
     1632         apply "entry":u to self .
     1633       end.
     1634       define variable v-curr-sv-date as date no-undo .
     1635       define variable v-new-sv-date  as date no-undo .
     1636       assign
     1637         v-curr-sv-date = date(self :screen-value) no-error
     1638       .
     1639       if v-curr-sv-date = ?
     1640       then do:
     1641         run gbl/getcurdt.p
     1642           (output v-curr-sv-date
     1643           ) .
     1644       end.
     1645       if v-curr-sv-date <> ?
     1646       then do:
     1647         assign
     1648           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1649         .
     1650         assign
     1651           self :screen-value = string(v-new-sv-date) .
     1652         .
     1653       end.
     1654     end.
     1655     return no-apply .
     1656   end.
     1657   on ctrl-e of fi-absence-period-to in frame F-Main
     1658   do:
     1659     if (can-query (self, "sensitive")
     1660        and
     1661        self :sensitive = true
     1662        )
     1663     or (can-query (self, "read-only")
     1664        and
     1665        self :read-only = false
     1666        )
     1667     then do:
     1668       if self :handle <> focus :handle
     1669       then do:
     1670         apply "entry":u to self .
     1671       end.
     1672       define variable v-curr-sv-date as date no-undo .
     1673       define variable v-new-sv-date  as date no-undo .
     1674       assign
     1675         v-curr-sv-date = date(self :screen-value) no-error
     1676       .
     1677       if v-curr-sv-date = ?
     1678       then do:
     1679         run gbl/getcurdt.p
     1680           (output v-curr-sv-date
     1681           ) .
     1682       end.
     1683       if v-curr-sv-date <> ?
     1684       then do:
     1685         run gbl/lastdate.p
     1686           (input  v-curr-sv-date
     1687           ,output v-new-sv-date
     1688           ).
     1689         assign
     1690           self :screen-value = string(v-new-sv-date) .
     1691         .
     1692       end.
     1693     end.
     1694     return no-apply .
     1695   end.
     1696   on ctrl-f of fi-absence-period-to in frame F-Main
     1697   do:
     1698     if (can-query (self, "sensitive")
     1699        and
     1700        self :sensitive = true
     1701        )
     1702     or (can-query (self, "read-only")
     1703        and
     1704        self :read-only = false
     1705        )
     1706     then do:
     1707       if self :handle <> focus :handle
     1708       then do:
     1709         apply "entry":u to self .
     1710       end.
     1711       define variable v-ok            as logical   no-undo .
     1712       define variable v-curr-sv-date  as date      no-undo .
     1713       define variable v-description   as character no-undo .
     1714       assign
     1715         v-curr-sv-date = date(self :screen-value) no-error
     1716       .
     1717       if v-curr-sv-date = ?
     1718       then do:
     1719         run gbl/getcurdt.p
     1720           (output v-curr-sv-date
     1721           ) .
     1722       end.
     1723       if v-curr-sv-date <> ?
     1724       then do:
     1725         run gbl/d-inpday.w
     1726           (input ?
     1727           ,input "Выбор даты"
     1728           ,input v-description
     1729           ,input ""
     1730           ,input-output v-curr-sv-date
     1731           ,output v-ok
     1732           ).
     1733         if v-ok = true
     1734         then do:
     1735           assign
     1736             self :screen-value = string(v-curr-sv-date) .
     1737           .
     1738         end.
     1739       end.
     1740     end.
     1741     return no-apply .
     1742   end.
     1743     define MENU m-ed-date17
     1744       MENU-ITEM m-ed-date17-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1745       MENU-ITEM m-ed-date17-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1746       MENU-ITEM m-ed-date17-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1747       MENU-ITEM m-ed-date17-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1748       .
     1749     if fi-absence-period-to :POPUP-MENU in frame F-Main = ?
     1750     then do:
     1751       ASSIGN
     1752         fi-absence-period-to :POPUP-MENU in frame F-Main = MENU m-ed-date17 :HANDLE
     1753         fi-absence-period-to :MENU-MOUSE in frame F-Main = 3
     1754       .
     1755     end.
     1756     define variable v-label-handle17 as handle no-undo .
     1757     assign
     1758       v-label-handle17 = fi-absence-period-to :side-label-handle in frame F-Main
     1759     .
     1760     if valid-handle (v-label-handle17)
     1761     then do:
     1762       if v-label-handle17 :tooltip = ""
     1763       or v-label-handle17 :tooltip = ?
     1764       then do:
     1765         assign
     1766           v-label-handle17 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1767         .
     1768       end.
     1769     end.
     1770     ON CHOOSE OF MENU-ITEM m-ed-date17-1 in menu m-ed-date17 DO:
     1771       apply "ctrl-b":U to fi-absence-period-to in frame F-Main .
     1772     END.
     1773     ON CHOOSE OF MENU-ITEM m-ed-date17-2 in menu m-ed-date17 DO:
     1774       apply "ctrl-d":U to fi-absence-period-to in frame F-Main .
     1775     END.
     1776     ON CHOOSE OF MENU-ITEM m-ed-date17-3 in menu m-ed-date17 DO:
     1777       apply "ctrl-e":U to fi-absence-period-to in frame F-Main .
     1778     END.
     1779     ON CHOOSE OF MENU-ITEM m-ed-date17-4 in menu m-ed-date17 DO:
     1780       apply "ctrl-f":U to fi-absence-period-to in frame F-Main .
     1781     END.
     1782   PROCEDURE disable_UI :
     1783     HIDE FRAME F-Main.
     1784     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1785   END PROCEDURE.
     1786   PROCEDURE local-apply-layout :
     1787     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1788     define variable v-naim           as character        no-undo.
     1789     define variable v-list           as character        no-undo.
     1790     define variable v-print-graft    as logical          no-undo.
     1791     define variable v-sort-gr        as logical          no-undo.
     1792     define variable v-type-price     as logical          no-undo.
     1793     define variable v-type-val       as logical          no-undo.
     1794     run uf-get( input 'e-eslg-e':U
     1795               , input v-cntxt-userid
     1796               , output v-list
     1797               , output v-naim
     1798               , output v-print-graft
     1799               , output v-sort-gr
     1800               , output v-type-price
     1801               , output v-type-val
     1802               ) .
     1803     if num-entries(v-list , chr(4)) = 6
     1804     then do:
     1805       assign
     1806         NullStr                 = logical(entry(1 , v-list , chr(4)))
     1807         fi-days-absence         = integer(entry(2 , v-list , chr(4)))
     1808         fi-critical-balance     = integer(entry(3 , v-list , chr(4)))
     1809         tg-absence-period       = logical(entry(4 , v-list , chr(4)))
     1810         fi-absence-period-from  = date(entry(5 , v-list , chr(4)))
     1811         fi-absence-period-to    = date(entry(6 , v-list , chr(4)))
     1812       no-error .
     1813       display
     1814         NullStr
     1815         fi-days-absence
     1816         fi-critical-balance
     1817         tg-absence-period
     1818         fi-absence-period-from
     1819         fi-absence-period-to
     1820       with frame F-Main.
     1821       run proc-tg-absence-period in this-procedure .
     1822     end.
     1823   END PROCEDURE.
     1824   PROCEDURE my-report :
     1825   define variable v-naim           as character        no-undo.
     1826     define variable v-list           as character        no-undo.
     1827     define variable v-print-graft    as logical          no-undo.
     1828     define variable v-sort-gr        as logical          no-undo.
     1829     define variable v-type-price     as logical          no-undo.
     1830     define variable v-type-val       as logical          no-undo.
     1831   do
     1832   on error undo, return error return-value
     1833   :
     1834     assign frame F-Main
     1835       NullStr
     1836       fi-days-absence
     1837       fi-critical-balance
     1838       tg-absence-period
     1839       fi-absence-period-from
     1840       fi-absence-period-to
     1841     .
     1842     if  tg-absence-period = yes and
     1843         fi-absence-period-from > fi-absence-period-to
     1844     then do:
     1845       message
     1846         "Период отсутствия продаж задан некорректно!"
     1847       view-as alert-box error.
     1848       return.
     1849     end.
     1850     assign
     1851       v-list = substitute( "&2&1&3&1&4&1&5&1&6&1&7"
     1852                          , chr(4)
     1853                          , NullStr
     1854                          , fi-days-absence
     1855                          , fi-critical-balance
     1856                          , tg-absence-period
     1857                          , fi-absence-period-from
     1858                          , fi-absence-period-to
     1859                          )
     1860     .
     1861     run uf-set( input 'e-eslg-e':U
     1862               , input v-cntxt-userid
     1863               , input v-list
     1864               , input v-naim
     1865               , input v-print-graft
     1866               , input v-sort-gr
     1867               , input v-type-price
     1868               , input v-type-val
     1869               ) .
     1870     run rep/r-eslg-e.p ( input NullStr
     1871                        , input fi-days-absence
     1872                        , input fi-critical-balance
     1873                        , input tg-absence-period
     1874                        , input fi-absence-period-from
     1875                        , input fi-absence-period-to
     1876                        ) .
     1877   end.
     1878   END PROCEDURE.
     1879   PROCEDURE my-var :
     1880     Assign frame F-Main NullStr .
     1881     Assign
     1882       STR-obj-type = ''
     1883       STR-obj-code = ''
     1884       STR-obj-name = ''
     1885       STR-obj      = ''
     1886     .
     1887     For each obj-list no-lock:
     1888       Assign
     1889         STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1890         STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1891         STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1892         STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1893       .
     1894     End.
     1895   END PROCEDURE.
     1896   PROCEDURE proc-tg-absence-period :
     1897   do
     1898   on error undo, return error return-value
     1899   :
     1900     assign frame F-Main
     1901       tg-absence-period
     1902     .
     1903     assign
     1904       fi-absence-period-from :sensitive = tg-absence-period
     1905       fi-absence-period-to :sensitive   = tg-absence-period
     1906     .
     1907   end.
     1908   END PROCEDURE.
     1909   PROCEDURE state-changed :
     1910     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1911     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1912     CASE p-state:
     1913       when "link-changed":U then  DO:
     1914            Run my-var.
     1915            End.
     1916     END CASE.
     1917   END PROCEDURE.
