      140   procedure create_obj-list :
      141      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      142      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      143      do
      144      on error undo, return error return-value
      145      :
      146         define buffer cli-obj for ub.clients .
      147         define variable p-var as integer no-undo .
      148         define buffer buf_obj-list for obj-list .
      149         find last buf_obj-list  use-index pi no-error .
      150         if available buf_obj-list
      151         then
      152            p-var = buf_obj-list.obj-id + 1.
      153         else
      154            p-var = 1.
      155         find first cli-obj where
      156                   cli-obj.obj-type = p-obj-type
      157               and cli-obj.obj-code = p-obj-code
      158         no-lock no-error.
      159         if available cli-obj
      160         then do:
      161            create buf_obj-list.
      162            assign
      163               buf_obj-list.obj-id   = p-var
      164               buf_obj-list.obj-code = cli-obj.obj-code
      165               buf_obj-list.obj-type = cli-obj.obj-type
      166               buf_obj-list.obj-name = cli-obj.obj-name
      167               buf_obj-list.db-num   = cli-obj.db-num
      168            .
      169         end.
      170      end.
      171   end.
