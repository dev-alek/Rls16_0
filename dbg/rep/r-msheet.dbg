      226   procedure prn-lib-reportviewer :
      227     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      228     define input parameter p-report-name-html as character no-undo .
      229     define input parameter p-param        as character no-undo .
      230     define variable v-excel           as character no-undo init 'TRUE' .
      231     define variable v-value-character as character no-undo .
      232     define variable v-value-integer   as character no-undo .
      233     define variable v-value-date      as date      no-undo .
      234     define variable v-value-decimal   as decimal   no-undo .
      235     define variable rep-excel         as logical   no-undo .
      236     define variable excel-string      as character no-undo .
      237     define variable v-param-type      as character no-undo .
      238     define variable v-tth             as handle    no-undo .
      239     run adm/shattri.p (
      240       input "get":U
      241       ,input  ""
      242       ,input  0
      243       ,input  'report-glob':U
      244       ,input  'rep-excel':U
      245       ,output v-value-character
      246       ,output v-value-date
      247       ,output v-value-decimal
      248       ,output v-value-integer
      249       ,output rep-excel
      250       ,output v-param-type
      251       ,INPUT-OUTPUT table-handle v-tth
      252       )  .
      253     if rep-excel then v-excel = "TRUE" .
      254     else v-excel = "FALSE" .
      255     if p-param eq ""
      256     then
      257        p-param = "EXCEL:" + v-excel.
      258     else
      259        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      260     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      261   end procedure.
      262   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263   procedure cur-time :
      264      define output parameter p-today as date      no-undo .
      265      define output parameter p-time  as integer   no-undo .
      266     do
      267     on error undo, return error
      268     :
      269       define variable v-date1 as date      no-undo .
      270       define variable v-date2 as date      no-undo .
      271       define variable v-time  as integer   no-undo .
      272       assign
      273         v-date1 = today
      274         v-time  = time
      275         v-date2 = today
      276       .
      277       if v-date1 <> v-date2
      278       then do:
      279         assign
      280           v-date1 = today
      281           v-time  = v-time
      282         .
      283       end.
      284       assign
      285         p-today = v-date1
      286         p-time  = v-time
      287       .
      288     end.
      289   end.
      290   function cur-time-date returns character
      291   :
      292     return string(today, '99/99/9999':U) .
      293   end.
      294   function cur-time-mjd returns decimal
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return integer(v-date) - 2400002 + (v-time / 86400) .
      303   end.
      304   function cur-time-get-ending-index returns integer
      305   (input p-number as integer
      306   )
      307   :
      308     if p-number < 0
      309     or p-number = ?
      310     then do:
      311       return 1 .
      312     end.
      313     define variable v-rest as integer   no-undo .
      314     assign
      315       p-number = p-number modulo 100
      316     .
      317     if p-number < 20
      318     then do:
      319       assign
      320         v-rest = p-number
      321       .
      322     end.
      323     else do:
      324       assign
      325         v-rest = p-number modulo 10
      326       .
      327     end.
      328     case v-rest :
      329       when 1
      330       then do:
      331         return 2 .
      332       end.
      333       when 2 or
      334       when 3 or
      335       when 4
      336       then do:
      337         return 3 .
      338       end.
      339       otherwise do:
      340         return 1 .
      341       end.
      342     end case .
      343   end.
      344   procedure cur-time-mjd-to-date :
      345      define input  parameter i-mjd-diff as decimal no-undo.
      346      define output parameter o-Date     as date    no-undo.
      347      define output parameter o-Time     as integer no-undo.
      348      define variable v-day-number as integer   no-undo .
      349      if    i-mjd-diff < 0
      350         or i-mjd-diff = ?
      351      then do:
      352         return "?" .
      353      end.
      354      assign
      355         v-day-number = truncate(i-mjd-diff,0).
      356         o-Date = date(v-day-number + 2400002).
      357         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      358     .
      359   end.
      360   function cur-time-mjd-to-string returns character
      361   (input p-mjd-diff as decimal
      362   )
      363   :
      364     define variable v-day-number as integer   no-undo .
      365     define variable v-seconds    as integer   no-undo .
      366     define variable v-hour       as integer   no-undo .
      367     define variable v-min        as integer   no-undo .
      368     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      369     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      370     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      371     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      372     if p-mjd-diff < 0
      373     or p-mjd-diff = ?
      374     then do:
      375       return "?" .
      376     end.
      377     assign
      378       v-day-number = integer(truncate(p-mjd-diff,0))
      379       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      380     .
      381     if v-seconds > 86400
      382     then do:
      383       assign
      384         v-seconds = 86400 - 1
      385       .
      386     end.
      387     if v-seconds < 0
      388     then do:
      389       assign
      390         v-seconds = 0
      391       .
      392     end.
      393     assign
      394       v-hour = truncate(v-seconds / 3600, 0)
      395     .
      396     assign
      397       v-seconds = v-seconds modulo 3600
      398     .
      399     assign
      400       v-min = truncate(v-seconds / 60, 0)
      401     .
      402     assign
      403       v-seconds = v-seconds modulo 60
      404     .
      405     return
      406         (if v-day-number <> 0
      407           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      408           else ""
      409         )
      410       + (if v-day-number <> 0 or v-hour <> 0
      411           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      412           else ""
      413         )
      414       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      415           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      416           else ""
      417         )
      418       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      419       .
      420   end.
      421   function cur-time-string returns character
      422   :
      423     define variable v-date as date      no-undo .
      424     define variable v-time as integer   no-undo .
      425     run cur-time in this-procedure
      426       (output v-date
      427       ,output v-time
      428       ) .
      429     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      430   end.
      431   function cur-time-string-sec returns character
      432   :
      433     define variable v-date as date      no-undo .
      434     define variable v-time as integer   no-undo .
      435     run cur-time in this-procedure
      436       (output v-date
      437       ,output v-time
      438       ) .
      439     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      440   end.
      441   function cur-time-custom  returns character
      442   (input p-prefix as character
      443   ,input p-date-format as character
      444   ,input p-delimiter as character
      445   ,input p-time-format as character
      446   ,input p-suffix as character
      447   )
      448   :
      449     define variable v-date as date      no-undo .
      450     define variable v-time as integer   no-undo .
      451     run cur-time in this-procedure
      452       (output v-date
      453       ,output v-time
      454       ) .
      455     return
      456       p-prefix
      457       + string(v-date, p-date-format)
      458       + p-delimiter
      459       + string(v-time, p-time-format)
      460       + p-suffix
      461       .
      462   end.
      463   function cur-time-print  returns character
      464   :
      465     define variable v-date as date      no-undo .
      466     define variable v-time as integer   no-undo .
      467     run cur-time in this-procedure
      468       (output v-date
      469       ,output v-time
      470       ) .
      471     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      472   end.
      473   function cur-time-datetime returns datetime
      474   :
      475     define variable v-char as character no-undo .
      476     define variable v-datetime as datetime no-undo .
      477     v-char = cur-time-string().
      478     v-datetime = datetime(v-char).
      479     return  v-datetime.
      480   end.
      481   function cur-time-string-msec returns character
      482   :
      483     define variable v-date as datetime  no-undo .
      484     v-date = now.
      485     return string(v-date) .
      486   end.
      487   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      488   define variable v-waitfram-action01         as character   no-undo .
      489   define variable v-waitfram-action02         as character   no-undo .
      490   define variable v-waitfram-action03         as character   no-undo .
      491   define variable mWaitFramTextBeg            as character   no-undo.
      492   define variable mWaitFramTextEnd            as character   no-undo.
      493   define variable mWaitFramView               as logical     no-undo.
      494   define variable mWaitProcEvent              as logical     no-undo init yes.
      495   define variable mWaitFramInterval           as integer     no-undo init 1 .
      496   define variable mWaitFramStop               as logical     no-undo.
      497   define variable mWaitFramStopUser           as logical     no-undo.
      498   define variable mWaitFramStopTimeOut        as logical     no-undo.
      499   define variable mWaitFramStartProc          as datetime-tz no-undo.
      500   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      501   define button B-WaitFramStop auto-end-key
      502        label "Стоп"
      503        size 10 by 1 tooltip "Остоновить процесс".
      504   define button B-viewProcInfo
      505        label "Информация"
      506        size 15 by 1 tooltip "Информация о процесс".
      507   define frame waitfram
      508     v-waitfram-action01 format "x(72)" no-label skip
      509     v-waitfram-action02 format "x(72)" no-label skip
      510     v-waitfram-action03 format "x(72)" no-label skip
      511     B-viewProcInfo
      512     B-WaitFramStop at row 4 col 30
      513     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      514     .
      515   define new global shared variable mBatchMode as logical no-undo init ?.
      516   define variable mFramBachModHandle as handle no-undo.
      517   mFramBachModHandle = frame waitfram:handle.
      518   define variable mFameOldVis as logical no-undo.
      519   define variable mVisCUrentVin as logical no-undo.
      520   if session:batch-mode
      521   then
      522      mBatchMode = yes.
      523   if mBatchMode = ? then do:
      524     mVisCUrentVin = current-window:visible.
      525     mFameOldVis = mFramBachModHandle:visible.
      526     mFramBachModHandle:visible  = yes.
      527     mBatchMode = mFramBachModHandle:visible ne yes.
      528     mFramBachModHandle:visible = mFameOldVis.
      529     current-window:visible = mVisCUrentVin.
      530   end.
      531    if  log-manager:logfile-name ne ?
      532     then DO:
      533         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      534         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      535         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      536     end.
      537   on choose of B-WaitFramStop in frame waitfram
      538   do:
      539     mWaitFramStop = yes.
      540     mWaitFramStopUser = yes.
      541   end.
      542   function waitfram-check-timeout returns logical():
      543      define variable vtime as int64 no-undo.
      544      if mWaitFramStopTimeOut
      545      then
      546         return yes.
      547      vtime = ( now - mWaitFramStartProc ) / 1000 .
      548      if     mWaitFramTimeOut ne ?
      549         and mWaitFramTimeOut ne 0
      550         and mWaitFramTimeOut lt vtime
      551      then do:
      552         mWaitFramStopTimeOut = yes.
      553      end.
      554      return mWaitFramStopTimeOut.
      555   end.
      556   procedure waitfram-hide :
      557     if not session:batch-mode
      558     then do
      559     on error undo, return error return-value
      560     :
      561       pause 0 before-hide .
      562       if not mBatchMode then
      563         hide frame waitfram .
      564     if     not mWaitFramView
      565        and mWaitProcEvent
      566     then
      567       process events .
      568     end.
      569   end procedure.
      570   procedure waitfram-show :
      571     define input  parameter p-message as character no-undo .
      572     define variable v-left-margin as integer   no-undo .
      573     if not session:batch-mode
      574     then do
      575     on error undo, return error return-value
      576     :
      577       if length(p-message) <= 70 then do:
      578         assign
      579           v-left-margin = integer((70 - length(p-message)) / 2)
      580         .
      581         assign
      582           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      583         .
      584         assign
      585           v-waitfram-action01 = " "
      586           v-waitfram-action02 = " "
      587                                    + fill(" ", v-left-margin)
      588                                    + p-message
      589           v-waitfram-action03 = " "
      590         .
      591       end.
      592       else do:
      593         define variable vRindex1 as integer no-undo.
      594         define variable vRindex2 as integer no-undo.
      595         vRindex1 = r-index(p-message," ",70).
      596         if vRindex1 = 0
      597         then
      598            vRindex1 = 70.
      599         if length(p-message)  <= vRindex1 + 70 then do:
      600           assign
      601             v-waitfram-action01 = " "
      602             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      603             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      604           .
      605         end.
      606         else do:
      607           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      608           if vRindex2 <= vRindex1
      609           then
      610              vRindex2 = vRindex1 + 70.
      611           assign
      612             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      613             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      614             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      615           .
      616         end.
      617       end.
      618       B-viewProcInfo:visible   in frame waitfram = no.
      619       B-viewProcInfo:sensitive in frame waitfram = no.
      620       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      621       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      622       if  (   mWaitFramView
      623          or  mWaitProcEvent)
      624          and not mBatchMode
      625       then
      626          display
      627             v-waitfram-action01 skip
      628             v-waitfram-action02 skip
      629             v-waitfram-action03 skip
      630          with frame waitfram .
      631       if     mWaitFramView
      632          then do:
      633             if     mWaitFramInterval ne ?
      634                and not mBatchMode
      635             then
      636                wait-for go of frame waitfram pause mWaitFramInterval.
      637          end.
      638          else
      639             if     mWaitProcEvent
      640                and not mBatchMode
      641             then
      642                process events .
      643     end.
      644   end procedure.
      645      procedure waitfram-show-this:
      646         define input  parameter iInterval as int64 no-undo.
      647         define variable vtime as int64 no-undo.
      648         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      649         mWaitFramInterval = iInterval.
      650         run waitfram-show (substitute("&1&2 &3&4" ,
      651                                       mWaitFramTextBeg ,
      652                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      653                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      654                                       mWaitFramTextEnd
      655                                      )
      656                           ).
      657      end.
      658      procedure WaitFramRunPause:
      659         define input  parameter iInterval as dec no-undo.
      660         define variable vStart  as datetime-tz no-undo.
      661         define variable vend    as datetime-tz no-undo.
      662         define variable vint as int64 no-undo.
      663         define variable vOk as logical no-undo.
      664         vStart = now.
      665         vend   = vStart.
      666         publish "WaitFramPause" (iInterval,output vOk).
      667         vend   =  now.
      668         vint = vend - vStart.
      669         vint = iInterval - vint / 1000.
      670         if     not mWaitFramStop
      671            and (   vint > 0
      672                 or (    not vOk
      673                     and iInterval eq ?
      674                     )
      675                 )
      676         then
      677            run waitfram-show-this (iInterval).
      678         vend   =  now.
      679         vint = vend - vStart.
      680         vint = iInterval - vint / 1000.
      681         if     not mWaitFramStop
      682            and vint > 0
      683         then do:
      684            run gbl/pause.p (vint * 1000).
      685         end.
      686         if iInterval ne ?
      687         then
      688            publish "WaitFramStop".
      689         waitfram-check-timeout().
      690      end.
      691      procedure WaitFramWaitFor:
      692         define input  parameter iInterval as dec no-undo.
      693         assign
      694            mWaitFramStartProc   = now
      695            mWaitFramStopUser    = no
      696            mWaitFramStopTimeOut = no
      697         .
      698         block-wait:
      699         do while not mWaitFramStop:
      700            run WaitFramRunPause (iInterval).
      701            if  waitfram-check-timeout()
      702            then do:
      703               leave block-wait.
      704            end.
      705         end.
      706         run waitfram-hide.
      707      end.
      708   procedure waitfram-join :
      709     define input  parameter p-line-1  as character no-undo .
      710     define input  parameter p-line-2  as character no-undo .
      711     define input  parameter p-line-3  as character no-undo .
      712     define output parameter p-message as character no-undo .
      713     do
      714     on error undo, return error return-value
      715     :
      716       assign
      717         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      718                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      719                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      720       .
      721     end.
      722   end procedure.
      723   function waitfram-join-function returns character
      724     (input p-line-1 as character
      725     ,input p-line-2 as character
      726     ,input p-line-3 as character
      727     ).
      728     define variable v-message as character no-undo .
      729     run waitfram-join in this-procedure
      730       (input  p-line-1
      731       ,input  p-line-2
      732       ,input  p-line-3
      733       ,output v-message
      734       ) .
      735     return v-message .
      736   end function .
      737   define variable p-host-code as integer no-undo.
      738   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      739   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      740     (input  parobj-type
      741     ,input  parobj-code
      742     ,output p-host-code
      743     )  .
      744   define buffer frm-clients  for ub.clients.
      745   define buffer bef-rvs-doc  for ub.rvs-doc.
      746   define buffer aft-rvs-doc  for ub.rvs-doc.
      747   define buffer bef-rvs-line for ub.rvs-line.
      748   define buffer aft-rvs-line for ub.rvs-line.
      749   define buffer buf_goods    for ub.goods .
      750   define buffer buf_clients  for ub.clients .
      751   define buffer buf_trn-doc  for ub.trn-doc .
      752   define buffer buf_doc-line for ub.doc-line .
      753   define buffer buf_doc-pl   for ub.doc-pl .
      754   def var v-ind         as integer   no-undo .
      755   def var v-line        as character no-undo format "X(135)" .
      756   assign
      757     v-line = fill("-", 135 )
      758   .
