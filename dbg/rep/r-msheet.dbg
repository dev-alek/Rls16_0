      992                                           bef-rvs-line.obj-code = buf_doc-pl.obj-code      and
      993                                           bef-rvs-line.pl-code  = buf_doc-pl.pl-code       and
      994                                           bef-rvs-line.gds-code = buf_doc-pl.gds-code      no-lock.
      995             find first aft-rvs-line where aft-rvs-line.rvs-code = aft-rvs-doc.rvs-code and
      996                                           aft-rvs-line.obj-type = buf_doc-pl.obj-type      and
      997                                           aft-rvs-line.obj-code = buf_doc-pl.obj-code      and
      998                                           aft-rvs-line.pl-code  = buf_doc-pl.pl-code       and
      999                                           aft-rvs-line.gds-code = buf_doc-pl.gds-code      no-lock.
