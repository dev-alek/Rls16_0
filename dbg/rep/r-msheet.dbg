      766   .
      767   def var sym1  as character no-undo format "x(1)":u label '!':u init ":":u .
      768   def var sym2  as character no-undo format "x(1)":u label '!':u init ":":u .
      769   def var sym3  as character no-undo format "x(1)":u label '!':u init ":":u .
      770   def var sym4  as character no-undo format "x(1)":u label '!':u init ":":u .
      771   def var sym5  as character no-undo format "x(1)":u label '!':u init ":":u .
      772   def var sym6  as character no-undo format "x(1)":u label '!':u init ":":u .
      773   def var sym7  as character no-undo format "x(1)":u label '!':u init ":":u .
      774   def var sym8  as character no-undo format "x(1)":u label '!':u init ":":u .
      775   def var sym9  as character no-undo format "x(1)":u label '!':u init ":":u .
      776   def var sym10 as character no-undo format "x(1)":u label '!':u init ":":u .
      777   def var sym11 as character no-undo format "x(1)":u label '!':u init ":":u .
      778   def var sym12 as character no-undo format "x(1)":u label '!':u init ":":u .
      779   run waitfram-show in this-procedure ( input 'Подождите ...' ).
      780   run prn-lib-open-stream in this-procedure ( input parparentproc, input 45, input yes, input no ).
      781   def var v-host-name   as character no-undo.
      782   def var v-obj-name    as character no-undo.
      783   def var v-header-name as character no-undo.
      784   def var v-print-time  as character no-undo.
      785   define variable vardate-shift  as   character      no-undo.
      786   define variable vardeviationdoc-qnty like ub.doc-line.doc-qnty         no-undo.
      787   define variable vardeviationcli-qnty like ub.doc-line.fact-qnty        no-undo.
      788   define variable vardeviationperc     as decimal format "->>>9.99<"  no-undo.
      789   define variable vardevfactdoc-qnty   like ub.doc-line.doc-qnty         no-undo.
      790   define variable vardevfactcli-qnty   like ub.doc-line.fact-qnty        no-undo.
      791   define variable vardevfactperc       as decimal format "->>>9.99<"  no-undo.
      792   define variable varmeasure-qnty      like ub.rvs-line.measure-qnty     no-undo.
      793   define variable varmeasure-cli-qnty  like ub.rvs-line.measure-cli-qnty no-undo.
      794   assign
      795     v-header-name = "                           Н А К О П И Т Е Л Ь Н А Я  В Е Д О М О С Т Ь "
      796     v-print-time  = cur-time-string()
      797   .
