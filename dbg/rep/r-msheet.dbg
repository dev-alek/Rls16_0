        1   block-level on error undo, throw.
        2   define input parameter parparentproc      as widget-handle      no-undo.
        3   define input parameter pardate-shift      as integer            no-undo.
        4   define input parameter parstart_date      as date               no-undo.
        5   define input parameter parstart_shift_num as integer            no-undo.
        6   define input parameter parend_date        as date               no-undo.
        7   define input parameter parend_shift_num   as integer            no-undo.
        8   define input parameter pargds-code        like ub.goods.gds-code   no-undo.
        9   define input parameter parobj-type        like ub.clients.obj-type no-undo.
       10   define input parameter parobj-code        like ub.clients.obj-code no-undo.
       11   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   def var vss-author      as character no-undo init "$Author: expertek $":U .
       13   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   def var vss-workfile    as character no-undo init "$Workfile: r-msheet.p $":U .
       15   def var vss-archive     as character no-undo init "$Archive: rep/r-msheet.p $":U .
       16   def var vss-description as character no-undo init "Накопительная ведомость".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
