      951   vardeviationcli-qnty = buf_doc-line.cli-qnty - varmeasure-cli-qnty
      952   vardeviationperc     = vardeviationdoc-qnty / buf_doc-line.doc-qnty * 100
      953   vardevfactdoc-qnty   = buf_doc-line.doc-qnty - buf_doc-line.fact-qnty
      954   vardevfactcli-qnty   = buf_doc-line.cli-qnty - buf_doc-line.fact-qnty / buf_doc-line.cli-base-rate
      955   vardevfactperc       = vardevfactdoc-qnty   / buf_doc-line.doc-qnty * 100.
