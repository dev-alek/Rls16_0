       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       79   define new shared variable RepPathName        as character no-undo .
       80   define new shared variable PrintRubl          as logical   no-undo .
       81   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define   stream repstr.
       83   procedure prn-lib-prn-file :
       84     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       85     define input parameter p-DIsabledoptions as integer no-undo .
       86     define variable v-report-name as character no-undo .
       87     define variable v-user-action as character no-undo .
       88     define variable v-printed     as logical   no-undo .
       89     define variable v-exist       as logical   no-undo .
       90     do
       91       on error undo, return error
       92       :
       93       run prn-lib-get-report-name  in this-procedure (
       94         input parParentProc
       95         ,output v-report-name
       96         ).
       97   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       99     (input  v-report-name
      100     ,input  2
      101     ,output v-exist
      102     )  .
      103       if NOT v-exist then
      104       DO:
      105         Message
      106           "Нет заданий на печать ! "
      107           view-as alert-box .
      108         Return  .
      109       End.
      110       run gbl/prnfilen.w
      111         (input  ""
      112         ,input  p-DisabledOptions
      113         ,input  string(v-report-name )
      114         ,input  7
      115         ,output v-user-action
      116         ,output v-printed
      117         ) .
      118       if v-printed then
      119       do:
      120         return "YES" .
      121       end.
      122       else
      123       do:
      124         return "NO" .
      125       end.
      126     end.
      127   end procedure.
      128   procedure prn-lib-open-stream :
      129     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      130     define input parameter p-page-size    as integer no-undo .
      131     define input parameter p-is-stream    as logical no-undo .
      132     define input parameter p-append       as logical no-undo .
      133     define variable v-report-name as character no-undo .
      134     do
      135       on error undo, return error
      136       :
      137       run prn-lib-get-report-name  in this-procedure (
      138         input parParentProc
      139         ,output v-report-name
      140         ).
      141       if p-is-stream then
      142       do:
      143         if p-append then
      144         do:
      145           output stream repstr to value( v-report-name )
      146             page-size value(p-page-size) append .
      147         end.
      148         if not p-append then
      149         do:
      150           output stream repstr to value( v-report-name )
      151             page-size value(p-page-size) .
      152         end.
      153       end.
      154       if not p-is-stream then
      155       do:
      156         if p-append then
      157         do:
      158           output to value( v-report-name )
      159             page-size value(p-page-size) append .
      160         end.
      161         if not p-append then
      162         do:
      163           output to value( v-report-name )
      164             page-size value(p-page-size) .
      165         end.
      166       end.
      167     end.
      168   end procedure.
      169   procedure prn-lib-open-exp :
      170     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      171     define input parameter p-is-stream    as logical no-undo .
      172     define input parameter p-is-append    as logical no-undo .
      173     define output parameter p-ReportFileName as char init "report" no-undo.
      174     define output parameter p-process as logical no-undo .
      175     define variable glog as logical no-undo .
      176     do
      177       on error undo, return error
      178       :
      179       SYSTEM-DIALOG GET-FILE p-ReportFileName
      180         TITLE      "Укажите путь"
      181         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      182         ASK-OVERWRITE
      183         CREATE-TEST-FILE
      184         SAVE-AS
      185         USE-FILENAME
      186         DEFAULT-EXTENSION "txt"
      187         UPDATE glog
      188         .
      189       if not glog then  return.
      190       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      191       if p-is-stream then
      192       do:
      193         if p-is-append then
      194         do:
      195           OUTPUT stream repstr TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      196         end.
      197         else
      198         do:
      199           OUTPUT stream repstr TO value ( p-ReportFileName ) PAGE-SIZE 0.
      200         end.
      201       end.
      202       else
      203       do:
      204         if p-is-append then
      205         do:
      206           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      207         end.
      208         else
      209         do:
      210           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      211         end.
      212       end.
      213       p-process = yes.
      214     end.
      215   end procedure.
      216   procedure prn-lib-get-report-name :
      217     define input parameter parParentProc  as widget-handle no-undo.
      218     define output parameter p-report-name as character no-undo .
      219     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
