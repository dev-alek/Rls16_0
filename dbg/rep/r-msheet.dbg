      812   .
      813   define frame doc-line-frm
      814     sym1  space(0) buf_trn-doc.shift-name   format "X(5)" column-label "1" space(0)
      815     sym2  space(0) buf_trn-doc.shift-date   format "99/99/99" column-label "2" space(0)
      816     sym3  space(0) buf_trn-doc.doc-code     format "x(14)" column-label "3" space(0)
      817     sym4  space(0) buf_doc-line.doc-qnty    format "->>,>>>,>>9.<<<" column-label "4" space(0)
      818     sym5  space(0) buf_doc-line.cli-qnty    format "->>,>>>,>>9.<<<" column-label "5" space(0)
      819     sym6  space(0) vardeviationdoc-qnty    format "->>,>>>,>>9.<<<" column-label "6" space(0)
      820     sym7  space(0) vardeviationcli-qnty    format "->>,>>>,>>9.<<<" column-label "7" space(0)
      821     sym8  space(0) vardeviationperc        format "->>>,>>>9.99<" column-label "8" space(0)
      822     sym9  space(0) vardevfactdoc-qnty      format "->>,>>>,>>9.<<<" column-label "9" space(0)
      823     sym10 space(0) vardevfactcli-qnty      format "->>,>>>,>>9.<<<" column-label "10" space(0)
      824     sym11 space(0) vardevfactperc          format "->>>,>>>9.99<" column-label "11" space(0)
      825     sym12 space(0)
      826     with width 137  down stream-io use-text .
      827   form with frame doc-line-frm .
      828   put stream repstr unformatted
      829     "   Наименование организации " string(v-host-name + fill(" ", 40), "x(40)")  skip
      830     "   АЗС: "  v-obj-name  skip
      831     "                           Н А К О П И Т Е Л Ь Н А Я  В Е Д О М О С Т Ь " skip
      832     "   Начало периода " (if pardate-shift <= 2 then string(parstart_date) else string(parstart_date) + ":" + string(parstart_shift_num)) skip
      833     "   Конец периода  " (if pardate-shift <= 2 then string(parend_date)   else string(parend_date)   + ":" + string(parend_shift_num))   skip
      834     "   Наименование нефтепродукта " buf_goods.artic " " buf_goods.gds-name skip
      835     .
      836   put stream repstr unformatted
      837     v-line skip
      838      STRING("!     ", "X(6)") STRING("!        ", "X(9)") STRING("!              ", "X(15)") STRING("!            ", "X(13)") STRING("             ", "X(13)") STRING("!  Отклонение", "X(13)") STRING(" принятого   ", "X(13)") STRING("!            ", "X(13)") STRING("!  Отклонение", "X(13)") STRING(" принятого   ", "X(13)") STRING("!            !", "X(14)") skip
      839      STRING("!Номер", "X(6)") STRING("!  Дата  ", "X(9)") STRING("!              ", "X(15)") STRING("!  Поступило ", "X(13)") STRING("по ТТН       ", "X(13)") STRING("!          по", "X(13)") STRING(" приборам    ", "X(13)") STRING("!Погрешность ", "X(13)") STRING("!          по", "X(13)") STRING(" факту       ", "X(13)") STRING("!Погрешность !", "X(14)") skip
      840      STRING("!смены", "X(6)") STRING("! начала ", "X(9)") STRING("!    № ТТН     ", "X(15)") STRING("!____________", "X(13)") STRING("_____________", "X(13)") STRING("!____________", "X(13)") STRING("_____________", "X(13)") STRING("!     в %    ", "X(13)") STRING("!____________", "X(13)") STRING("_____________", "X(13)") STRING("!     в %    !", "X(14)") skip
      841      STRING("!     ", "X(6)") STRING("! смены  ", "X(9)") STRING("!              ", "X(15)") STRING("!      в     ", "X(13)") STRING("!     в      ", "X(13)") STRING("!      в     ", "X(13)") STRING("!      в     ", "X(13)") STRING("!            ", "X(13)") STRING("!      в     ", "X(13)") STRING("!      в     ", "X(13)") STRING("!            !", "X(14)") skip
      842      STRING("!     ", "X(6)") STRING("!        ", "X(9)") STRING("!              ", "X(15)") STRING("!   литрах   ", "X(13)") STRING("!килограммах ", "X(13)") STRING("!    литрах  ", "X(13)") STRING("! килограммах", "X(13)") STRING("!            ", "X(13)") STRING("!    литрах  ", "X(13)") STRING("! килограммах", "X(13)") STRING("!            !", "X(14)") skip
      843     v-line
      844     .
      845   form header
      846     v-line1 at 1 skip
      847     v-header-name format "x(50)" at 1
      848       "Дата:" at 60
      849       v-print-time format "x(20)"
      850       "Стр." at 100 string( page-number(repstr), ">>>9" )  skip
      851     v-line2 at 1 skip
      852     with frame topframe
      853     width 137 page-top no-labels no-box .
      854   view stream repstr frame topframe .
      855   form header
      856     v-line skip
      857     "Продолжение на следующей странице " at 30 skip
      858     with frame bottomframe
      859     width 137 page-bottom no-labels no-box .
      860   view stream repstr frame bottomframe .
      861   CASE pardate-shift :
      862       WHEN 1 THEN DO:
      863               for each buf_trn-doc where                             buf_trn-doc.obj-type    = parobj-type and                             buf_trn-doc.obj-code    = parobj-code and                             buf_trn-doc.fact-date >= parstart_date and buf_trn-doc.fact-date <= parend_date and                             buf_trn-doc.status_     = 'факт':U                              and buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = no,                                                     each buf_doc-line no-lock where                             buf_doc-line.doc-code   = buf_trn-doc.doc-code     and                             buf_doc-line.artic      = buf_goods.artic     and                             buf_doc-line.prod-type  = buf_goods.prod-type and                             buf_doc-line.prod-code  = buf_goods.prod-code                                                  :
      864   ASSIGN varmeasure-qnty     = ?
      865          varmeasure-cli-qnty = ?.
      866   find first bef-rvs-doc where bef-rvs-doc.out-code = buf_trn-doc.doc-code and
      867                                bef-rvs-doc.rvs-type = 'перед_док':U no-lock no-error.
      868   if available bef-rvs-doc then do:
      869      find first aft-rvs-doc where aft-rvs-doc.out-code = buf_trn-doc.doc-code and
      870                                   aft-rvs-doc.rvs-type = 'перед_док':U no-lock no-error.
      871      if available aft-rvs-doc then do:
      872         for each buf_doc-pl where buf_doc-pl.out-code = buf_trn-doc.doc-code and
      873                               buf_doc-pl.gds-code = buf_goods.gds-code   no-lock:
      874             find first bef-rvs-line where bef-rvs-line.rvs-code = bef-rvs-doc.rvs-code and
      875                                           bef-rvs-line.obj-type = buf_doc-pl.obj-type      and
      876                                           bef-rvs-line.obj-code = buf_doc-pl.obj-code      and
      877                                           bef-rvs-line.pl-code  = buf_doc-pl.pl-code       and
      878                                           bef-rvs-line.gds-code = buf_doc-pl.gds-code      no-lock.
      879             find first aft-rvs-line where aft-rvs-line.rvs-code = aft-rvs-doc.rvs-code and
      880                                           aft-rvs-line.obj-type = buf_doc-pl.obj-type      and
      881                                           aft-rvs-line.obj-code = buf_doc-pl.obj-code      and
      882                                           aft-rvs-line.pl-code  = buf_doc-pl.pl-code       and
      883                                           aft-rvs-line.gds-code = buf_doc-pl.gds-code      no-lock.
      884             ACCUMULATE (aft-rvs-line.measure-qnty     - bef-rvs-line.measure-qnty)     (TOTAL)
      885                        (aft-rvs-line.measure-cli-qnty - bef-rvs-line.measure-cli-qnty) (TOTAL).
      886         end.
      887         ASSIGN varmeasure-qnty     = (ACCUM TOTAL (aft-rvs-line.measure-qnty     - bef-rvs-line.measure-qnty)    )
      888                varmeasure-cli-qnty = (ACCUM TOTAL (aft-rvs-line.measure-cli-qnty - bef-rvs-line.measure-cli-qnty)).
      889      end.
      890   end.
      891   ASSIGN
      892   vardeviationdoc-qnty = buf_doc-line.doc-qnty - varmeasure-qnty
      893   vardeviationcli-qnty = buf_doc-line.cli-qnty - varmeasure-cli-qnty
      894   vardeviationperc     = vardeviationdoc-qnty / buf_doc-line.doc-qnty * 100
      895   vardevfactdoc-qnty   = buf_doc-line.doc-qnty - buf_doc-line.fact-qnty
      896   vardevfactcli-qnty   = buf_doc-line.cli-qnty - buf_doc-line.fact-qnty / buf_doc-line.cli-base-rate
      897   vardevfactperc       = vardevfactdoc-qnty   / buf_doc-line.doc-qnty * 100.
      898   ACCUMULATE buf_doc-line.doc-qnty    (TOTAL)
      899              buf_doc-line.cli-qnty    (TOTAL)
      900              vardeviationdoc-qnty (TOTAL)
      901              vardeviationcli-qnty (TOTAL)
      902              vardevfactdoc-qnty   (TOTAL)
      903              vardevfactcli-qnty   (TOTAL).
      904   display stream repstr
      905   sym1  space(0) buf_trn-doc.shift-name
      906   sym2  space(0) buf_trn-doc.shift-date
      907   sym3  space(0) buf_trn-doc.doc-code
      908   sym4  space(0) buf_doc-line.doc-qnty
      909   sym5  space(0) buf_doc-line.cli-qnty
      910   sym6  space(0) vardeviationdoc-qnty
      911   sym7  space(0) vardeviationcli-qnty
      912   sym8  space(0) vardeviationperc
      913   sym9  space(0) vardevfactdoc-qnty
      914   sym10 space(0) vardevfactcli-qnty
      915   sym11 space(0) vardevfactperc
      916   sym12 space(0)
      917   with frame doc-line-frm .
      918   down stream repstr 1 with frame doc-line-frm.                    end.
      919       END.
      920       WHEN 2 THEN DO:
      921               for each buf_trn-doc where                             buf_trn-doc.obj-type    = parobj-type and                             buf_trn-doc.obj-code    = parobj-code and                             buf_trn-doc.shift-date >= parstart_date and buf_trn-doc.shift-date <= parend_date and                             buf_trn-doc.status_     = 'факт':U                              and buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = no,                                                     each buf_doc-line no-lock where                             buf_doc-line.doc-code   = buf_trn-doc.doc-code     and                             buf_doc-line.artic      = buf_goods.artic     and                             buf_doc-line.prod-type  = buf_goods.prod-type and                             buf_doc-line.prod-code  = buf_goods.prod-code                                                  :
      922   ASSIGN varmeasure-qnty     = ?
      923          varmeasure-cli-qnty = ?.
      924   find first bef-rvs-doc where bef-rvs-doc.out-code = buf_trn-doc.doc-code and
      925                                bef-rvs-doc.rvs-type = 'перед_док':U no-lock no-error.
      926   if available bef-rvs-doc then do:
      927      find first aft-rvs-doc where aft-rvs-doc.out-code = buf_trn-doc.doc-code and
      928                                   aft-rvs-doc.rvs-type = 'перед_док':U no-lock no-error.
      929      if available aft-rvs-doc then do:
      930         for each buf_doc-pl where buf_doc-pl.out-code = buf_trn-doc.doc-code and
      931                               buf_doc-pl.gds-code = buf_goods.gds-code   no-lock:
      932             find first bef-rvs-line where bef-rvs-line.rvs-code = bef-rvs-doc.rvs-code and
      933                                           bef-rvs-line.obj-type = buf_doc-pl.obj-type      and
      934                                           bef-rvs-line.obj-code = buf_doc-pl.obj-code      and
      935                                           bef-rvs-line.pl-code  = buf_doc-pl.pl-code       and
      936                                           bef-rvs-line.gds-code = buf_doc-pl.gds-code      no-lock.
      937             find first aft-rvs-line where aft-rvs-line.rvs-code = aft-rvs-doc.rvs-code and
      938                                           aft-rvs-line.obj-type = buf_doc-pl.obj-type      and
      939                                           aft-rvs-line.obj-code = buf_doc-pl.obj-code      and
      940                                           aft-rvs-line.pl-code  = buf_doc-pl.pl-code       and
      941                                           aft-rvs-line.gds-code = buf_doc-pl.gds-code      no-lock.
