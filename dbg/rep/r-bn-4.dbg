     4450   procedure Print-Header :
     4451   define input parameter N as integer no-undo .
     4452   define input parameter Name as char no-undo .
     4453   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4454   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4455   END PROCEDURE.
     4456   procedure run1-0 :
     4457          for each obj-list no-lock :
     4458             for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     4459             for each post-stk-line  no-lock where
     4460                     post-stk-line.obj-type = obj-list.obj-type and
