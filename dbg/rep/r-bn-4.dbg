     4876   PROCEDURE write-retro-bonus :
     4877   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4878   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4879   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4880   define input  parameter v-retro-bonus as character   no-undo .
     4881     do
     4882     on error undo, return error return-value
     4883     :
     4884       find first ub.contract-specif-attr exclusive-lock  where
     4885                 ub.contract-specif-attr.contract-num = p-contract-num  and
     4886                 ub.contract-specif-attr.host-code    = p-host-code     and
     4887                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     4888                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     4889                 no-error .
     4890         if not available ub.contract-specif-attr then do:
     4891            create ub.contract-specif-attr .
     4892            assign
     4893                 ub.contract-specif-attr.contract-num = p-contract-num
     4894                 ub.contract-specif-attr.host-code    = p-host-code
     4895                 ub.contract-specif-attr.gds-code     = p-gds-code
     4896                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     4897            .
     4898            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     4899            if error-status:error then
     4900               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     4901         end.
     4902         else do:
     4903            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     4904            if error-status:error then
     4905               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     4906         end.
     4907       find first ub.contract-specif exclusive-lock where
     4908           ub.contract-specif.contract-num = p-contract-num and
     4909           ub.contract-specif.host-code    = p-host-code    and
     4910           ub.contract-specif.gds-code     = p-gds-code.
     4911           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     4912   end.
     4913   END PROCEDURE.
     4914   PROCEDURE read-retro-bonus :
     4915   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4916   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4917   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4918   define output parameter v-retro-bonus as character   no-undo .
     4919     do
     4920     on error undo, return error return-value
     4921     :
     4922   find first ub.contract-specif-attr no-lock  where
