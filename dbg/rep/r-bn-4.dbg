     4779   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4780   PROCEDURE write-bonus :
     4781   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4782   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4783   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4784   define input  parameter v-bonus as decimal   no-undo .
     4785     do
     4786     on error undo, return error return-value
     4787     :
     4788       find first ub.contract-specif-attr exclusive-lock  where
     4789                  ub.contract-specif-attr.contract-num = p-contract-num  and
     4790                  ub.contract-specif-attr.host-code    = p-host-code     and
     4791                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     4792                  ub.contract-specif-attr.attr-code    = 'bonus':U
     4793                 no-error .
     4794         if not available ub.contract-specif-attr then do:
     4795            create ub.contract-specif-attr .
     4796            assign
     4797                 ub.contract-specif-attr.contract-num = p-contract-num
     4798                 ub.contract-specif-attr.host-code    = p-host-code
     4799                 ub.contract-specif-attr.gds-code     = p-gds-code
     4800                 ub.contract-specif-attr.attr-code    = 'bonus':U
     4801            .
     4802         end.
     4803         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     4804   end.
     4805   END PROCEDURE.
     4806   PROCEDURE read-bonus :
     4807   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4808   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4809   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4810   define output parameter v-bonus as decimal   no-undo .
     4811     do
     4812     on error undo, return error return-value
     4813     :
     4814   find first ub.contract-specif-attr no-lock  where
     4815              ub.contract-specif-attr.contract-num = p-contract-num  and
     4816              ub.contract-specif-attr.host-code    = p-host-code     and
     4817              ub.contract-specif-attr.gds-code     = p-gds-code      and
     4818              ub.contract-specif-attr.attr-code    = 'bonus':U
     4819              no-error .
     4820      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     4821                                           else  v-bonus = 0 .
     4822   end.
     4823   END PROCEDURE.
     4824   PROCEDURE write-prc-min :
     4825   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4826   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4827   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4828   define input  parameter v-prc-min        as decimal   no-undo .
     4829     do
     4830     on error undo, return error return-value
     4831     :
     4832       find first ub.contract-specif-attr exclusive-lock  where
     4833                 ub.contract-specif-attr.contract-num = p-contract-num  and
     4834                 ub.contract-specif-attr.host-code    = p-host-code     and
     4835                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     4836                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     4837                 no-error .
     4838         if not available ub.contract-specif-attr then do:
     4839            create ub.contract-specif-attr .
     4840            assign
     4841                 ub.contract-specif-attr.contract-num = p-contract-num
     4842                 ub.contract-specif-attr.host-code    = p-host-code
     4843                 ub.contract-specif-attr.gds-code     = p-gds-code
     4844                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     4845                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     4846            .
     4847         end.
     4848         else do:
     4849            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     4850         end.
     4851       find first ub.contract-specif exclusive-lock where
     4852           ub.contract-specif.contract-num = p-contract-num and
     4853           ub.contract-specif.host-code    = p-host-code    and
     4854           ub.contract-specif.gds-code     = p-gds-code.
     4855           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     4856   end.
     4857   END PROCEDURE.
     4858   PROCEDURE read-prc-min :
     4859   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     4860   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     4861   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     4862   define output parameter v-prc-min as decimal   no-undo .
     4863     do
     4864     on error undo, return error return-value
     4865     :
     4866   find first ub.contract-specif-attr no-lock  where
     4867              ub.contract-specif-attr.contract-num = p-contract-num  and
     4868              ub.contract-specif-attr.host-code    = p-host-code     and
     4869              ub.contract-specif-attr.gds-code     = p-gds-code      and
     4870              ub.contract-specif-attr.attr-code    = 'prc-min':U
