     1360     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1361     .
     1362   define new global shared variable mBatchMode as logical no-undo init ?.
     1363   define variable mFramBachModHandle as handle no-undo.
     1364   mFramBachModHandle = frame waitfram:handle.
     1365   define variable mFameOldVis as logical no-undo.
     1366   define variable mVisCUrentVin as logical no-undo.
     1367   if session:batch-mode
     1368   then
     1369      mBatchMode = yes.
     1370   if mBatchMode = ? then do:
     1371     mVisCUrentVin = current-window:visible.
     1372     mFameOldVis = mFramBachModHandle:visible.
     1373     mFramBachModHandle:visible  = yes.
     1374     mBatchMode = mFramBachModHandle:visible ne yes.
     1375     mFramBachModHandle:visible = mFameOldVis.
     1376     current-window:visible = mVisCUrentVin.
     1377   end.
     1378    if  log-manager:logfile-name ne ?
     1379     then DO:
     1380         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1381         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1382         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1383     end.
     1384   on choose of B-WaitFramStop in frame waitfram
     1385   do:
     1386     mWaitFramStop = yes.
     1387     mWaitFramStopUser = yes.
     1388   end.
     1389   function waitfram-check-timeout returns logical():
     1390      define variable vtime as int64 no-undo.
     1391      if mWaitFramStopTimeOut
     1392      then
     1393         return yes.
     1394      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1395      if     mWaitFramTimeOut ne ?
     1396         and mWaitFramTimeOut ne 0
     1397         and mWaitFramTimeOut lt vtime
     1398      then do:
     1399         mWaitFramStopTimeOut = yes.
     1400      end.
     1401      return mWaitFramStopTimeOut.
     1402   end.
     1403   procedure waitfram-hide :
     1404     if not session:batch-mode
     1405     then do
     1406     on error undo, return error return-value
     1407     :
     1408       pause 0 before-hide .
     1409       if not mBatchMode then
     1410         hide frame waitfram .
     1411     if     not mWaitFramView
     1412        and mWaitProcEvent
     1413     then
     1414       process events .
     1415     end.
     1416   end procedure.
     1417   procedure waitfram-show :
     1418     define input  parameter p-message as character no-undo .
     1419     define variable v-left-margin as integer   no-undo .
     1420     if not session:batch-mode
     1421     then do
     1422     on error undo, return error return-value
     1423     :
     1424       if length(p-message) <= 70 then do:
     1425         assign
     1426           v-left-margin = integer((70 - length(p-message)) / 2)
     1427         .
     1428         assign
     1429           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1430         .
     1431         assign
     1432           v-waitfram-action01 = " "
     1433           v-waitfram-action02 = " "
     1434                                    + fill(" ", v-left-margin)
     1435                                    + p-message
     1436           v-waitfram-action03 = " "
     1437         .
     1438       end.
     1439       else do:
     1440         define variable vRindex1 as integer no-undo.
     1441         define variable vRindex2 as integer no-undo.
     1442         vRindex1 = r-index(p-message," ",70).
     1443         if vRindex1 = 0
     1444         then
     1445            vRindex1 = 70.
     1446         if length(p-message)  <= vRindex1 + 70 then do:
     1447           assign
     1448             v-waitfram-action01 = " "
     1449             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1450             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1451           .
     1452         end.
     1453         else do:
     1454           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1455           if vRindex2 <= vRindex1
     1456           then
     1457              vRindex2 = vRindex1 + 70.
     1458           assign
     1459             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1460             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1461             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1462           .
     1463         end.
     1464       end.
     1465       B-viewProcInfo:visible   in frame waitfram = no.
     1466       B-viewProcInfo:sensitive in frame waitfram = no.
     1467       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1468       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1469       if  (   mWaitFramView
     1470          or  mWaitProcEvent)
     1471          and not mBatchMode
     1472       then
     1473          display
     1474             v-waitfram-action01 skip
     1475             v-waitfram-action02 skip
     1476             v-waitfram-action03 skip
     1477          with frame waitfram .
     1478       if     mWaitFramView
     1479          then do:
     1480             if     mWaitFramInterval ne ?
     1481                and not mBatchMode
     1482             then
     1483                wait-for go of frame waitfram pause mWaitFramInterval.
     1484          end.
     1485          else
     1486             if     mWaitProcEvent
     1487                and not mBatchMode
     1488             then
     1489                process events .
     1490     end.
     1491   end procedure.
     1492      procedure waitfram-show-this:
     1493         define input  parameter iInterval as int64 no-undo.
     1494         define variable vtime as int64 no-undo.
     1495         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1496         mWaitFramInterval = iInterval.
     1497         run waitfram-show (substitute("&1&2 &3&4" ,
     1498                                       mWaitFramTextBeg ,
     1499                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1500                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1501                                       mWaitFramTextEnd
     1502                                      )
     1503                           ).
     1504      end.
     1505      procedure WaitFramRunPause:
     1506         define input  parameter iInterval as dec no-undo.
     1507         define variable vStart  as datetime-tz no-undo.
     1508         define variable vend    as datetime-tz no-undo.
     1509         define variable vint as int64 no-undo.
     1510         define variable vOk as logical no-undo.
     1511         vStart = now.
     1512         vend   = vStart.
     1513         publish "WaitFramPause" (iInterval,output vOk).
     1514         vend   =  now.
     1515         vint = vend - vStart.
     1516         vint = iInterval - vint / 1000.
     1517         if     not mWaitFramStop
     1518            and (   vint > 0
     1519                 or (    not vOk
     1520                     and iInterval eq ?
     1521                     )
     1522                 )
     1523         then
     1524            run waitfram-show-this (iInterval).
     1525         vend   =  now.
     1526         vint = vend - vStart.
     1527         vint = iInterval - vint / 1000.
     1528         if     not mWaitFramStop
     1529            and vint > 0
     1530         then do:
     1531            run gbl/pause.p (vint * 1000).
     1532         end.
     1533         if iInterval ne ?
     1534         then
     1535            publish "WaitFramStop".
     1536         waitfram-check-timeout().
     1537      end.
     1538      procedure WaitFramWaitFor:
     1539         define input  parameter iInterval as dec no-undo.
     1540         assign
     1541            mWaitFramStartProc   = now
     1542            mWaitFramStopUser    = no
     1543            mWaitFramStopTimeOut = no
     1544         .
     1545         block-wait:
     1546         do while not mWaitFramStop:
     1547            run WaitFramRunPause (iInterval).
     1548            if  waitfram-check-timeout()
     1549            then do:
     1550               leave block-wait.
     1551            end.
     1552         end.
     1553         run waitfram-hide.
     1554      end.
     1555   procedure waitfram-join :
     1556     define input  parameter p-line-1  as character no-undo .
     1557     define input  parameter p-line-2  as character no-undo .
     1558     define input  parameter p-line-3  as character no-undo .
     1559     define output parameter p-message as character no-undo .
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       assign
     1564         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1565                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1566                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1567       .
     1568     end.
     1569   end procedure.
     1570   function waitfram-join-function returns character
     1571     (input p-line-1 as character
     1572     ,input p-line-2 as character
     1573     ,input p-line-3 as character
     1574     ).
     1575     define variable v-message as character no-undo .
     1576     run waitfram-join in this-procedure
     1577       (input  p-line-1
     1578       ,input  p-line-2
     1579       ,input  p-line-3
     1580       ,output v-message
     1581       ) .
     1582     return v-message .
     1583   end function .
     1584   define buffer goods   for ub.goods  .
     1585   define buffer gds-obj for ub.gds-obj  .
     1586   define buffer clients for ub.clients  .
     1587   define variable ii like i init 0 no-undo .
     1588   define variable t#cat-id like stk-line.cat-id no-undo .
     1589   define variable t#Sum-type like stk-line.Sum-type no-undo .
     1590   define variable t#kol-rec-obj like i init 0  no-undo .
     1591   if Show-Negativ then null-fact-order = 0 .
     1592      else  null-fact-order = fact-order-1 .
     1593   for each obj-list no-lock :
     1594     t#kol-rec-obj = t#kol-rec-obj + 1.
     1595   End.
     1596   case type-stor  :
     1597     when 1 then  do:
     1598       Assign
     1599         t#cat-id   = '##':U
     1600         t#sum-type = 'cost':U  .
     1601     end.
     1602     when 2 then do:
     1603       Assign
     1604         t#cat-id   = 'prch':U
     1605         t#sum-type = 'cost':U + 'p':U .
     1606     end.
     1607     when 3 then do:
     1608       Assign
     1609         t#cat-id   = 'cacc':U
     1610         t#sum-type = 'cost':U + 'p':U .
     1611     end.
     1612     when 4 then do:
     1613       Assign
     1614         t#cat-id   = 'stor':U
     1615         t#sum-type = 'cost':U + 'p':U .
     1616     end.
     1617     when 5 then do:
     1618       Assign
     1619         t#cat-id   = 'cons':U
     1620         t#sum-type = 'cost':U + 'p':U .
     1621     end.
     1622   End case.
     1623   if xTogobj = false  then DO:
     1624     Case Select-Good :
     1625       when 1   then    RUN Run1-0.
     1626       when 2   then    run run2-0.
     1627       when 3  then    run run3-0.
     1628       otherwise do:
     1629           run run45-0.
     1630       end.
     1631     End case.
     1632   End.
     1633   Else do:
     1634     Case Select-Good :
     1635       when 1  then    RUN Run1.
     1636       when 2  then    run run2.
     1637       when 3 then    run run3.
     1638       otherwise do:
     1639         run run45.
     1640       end.
     1641     End case.
     1642   End.
     1643   procedure run1 :
     1644   CASE RetClassify :
     1645     when "no-classify":U then  DO:
     1646          For each obj-list no-lock :
     1647             find first sheetf where entry(3, sheetf.colformat, chr(4))  = obj-list.obj-name no-error.
     1648             if available sheetf then do:
     1649               run rep/extitle.p ( input sheetf.sheet-num ).
     1650               assign
     1651               Sheetf.Bas-Params = obj-list.obj-name
     1652               .
     1653             end.
     1654            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1655            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1656             For each post-stk-line  no-lock where
     1657                                               post-stk-line.obj-type = obj-list.obj-type and
     1658                                               post-stk-line.obj-code = obj-list.obj-code and
     1659                                               post-stk-line.fact-order >= null-fact-order   and
     1660                                               post-stk-line.fact-order <= fact-order-2   and
     1661                                               post-stk-line.sum-type    = 'cost':U    and
     1662                                               post-stk-line.cat-id      = '##':U
     1663                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1664                                               :
     1665                    find first  temp-t-post-stk-line where
     1666                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1667                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1668                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1669                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1670                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1671                      if not available  temp-t-post-stk-line then do:
     1672                         find first  ub.goods no-lock where
     1673                                               ub.goods.artic     = post-stk-line.artic     and
     1674                                               ub.goods.prod-type = post-stk-line.prod-type and
     1675                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1676                         find first  prod-cli no-lock  where
     1677                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1678                                                   prod-cli.obj-code = post-stk-line.prod-code
     1679                                                   no-error .
     1680                         find first  ub.clients  no-lock  where
     1681                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1682                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1683                           run create-temp-t-post-stk-line .
     1684                    end.
     1685                    else do:
     1686                            assign
     1687                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1688                            .
     1689                    end.
     1690             end.
     1691             For each temp-t-post-stk-line no-lock   ,
     1692                    Last temp-post-stk-line  where
     1693                         temp-post-stk-line.fact-order <= fact-order-2   and
     1694                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1695                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1696                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1697                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1698                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1699                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1700                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1701                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1702                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1703                         no-lock
     1704                         on error undo , next
     1705                         break
     1706                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1707                         By temp-t-post-stk-line.gds-code
     1708                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1709                         By Temp-t-post-stk-line.Fact-order
     1710                        :
     1711                 if NOT(Sums-Only = true ) then DO:
     1712                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1713                 End.
     1714                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     1715                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     1716                                            run display-line .
     1717                                       End.
     1718                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     1719             End.
     1720            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1721           if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1722           .
     1723          End.
     1724     End.
     1725     when "grp-goods":U  then     DO:
     1726       if xLavel = 0 THEN  DO:
     1727          For each obj-list no-lock :
     1728             find first sheetf where entry(3, sheetf.colformat, chr(4))  = obj-list.obj-name no-error.
     1729             if available sheetf then do:
     1730               run rep/extitle.p ( input sheetf.sheet-num ).
     1731               assign
     1732               Sheetf.Bas-Params = obj-list.obj-name
     1733               .
     1734             end.
     1735            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1736            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1737             For each post-stk-line  no-lock where
     1738                                               post-stk-line.obj-type = obj-list.obj-type and
     1739                                               post-stk-line.obj-code = obj-list.obj-code and
     1740                                               post-stk-line.fact-order >= null-fact-order   and
     1741                                               post-stk-line.fact-order <= fact-order-2   and
     1742                                               post-stk-line.sum-type    = 'cost':U    and
     1743                                               post-stk-line.cat-id      = '##':U
     1744                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1745                                               :
     1746                    find first  temp-t-post-stk-line where
     1747                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1748                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1749                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1750                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1751                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1752                      if not available  temp-t-post-stk-line then do:
     1753                         find first  ub.goods no-lock where
     1754                                               ub.goods.artic     = post-stk-line.artic     and
     1755                                               ub.goods.prod-type = post-stk-line.prod-type and
     1756                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1757                         find first  prod-cli no-lock  where
     1758                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1759                                                   prod-cli.obj-code = post-stk-line.prod-code
     1760                                                   no-error .
     1761                         find first  ub.clients  no-lock  where
     1762                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1763                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1764                           run create-temp-t-post-stk-line .
     1765                    end.
     1766                    else do:
     1767                            assign
     1768                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1769                            .
     1770                    end.
     1771             end.
     1772             For each temp-t-post-stk-line no-lock   ,
     1773                    Last temp-post-stk-line  where
     1774                         temp-post-stk-line.fact-order <= fact-order-2   and
     1775                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1776                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1777                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1778                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1779                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1780                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1781                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1782                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1783                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1784                         no-lock
     1785                         on error undo , next
     1786                         break
     1787                         BY
     1788                             temp-t-post-stk-line.goods-grp-name
     1789                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1790                         By temp-t-post-stk-line.gds-code
     1791                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1792                         By Temp-t-post-stk-line.Fact-order
     1793                        :
     1794                  if first-of(  temp-t-post-stk-line.goods-grp-name  )  Then DO : run print-header (1, temp-t-post-stk-line.goods-grp-name ). end.
     1795                 if NOT(Sums-Only = true ) then DO:
     1796                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1797                 End.
