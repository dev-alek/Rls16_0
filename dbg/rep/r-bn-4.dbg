     4931   END PROCEDURE.
     4932   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4933   define buffer buf_contract-specif for ub.contract-specif.
     4934   define input parameter x-cont-code like contract.contract-code no-undo.
     4935   PROCEDURE Goods-start :
     4936   END PROCEDURE.
     4937   PROCEDURE Goods-end :
     4938   END PROCEDURE.
     4939   PROCEDURE display-line :
     4940   find first ub.contract-specif no-lock where
     4941     ub.contract-specif.contract-num = x-cont-code                    and
     4942     ub.contract-specif.gds-code     = temp-t-post-stk-line.gds-code  and
     4943     ub.contract-specif.gds-name     = temp-t-post-stk-line.gds-name  and
     4944     ub.contract-specif.artic        = temp-t-post-stk-line.artic     and
     4945     ub.contract-specif.prod-type    = temp-t-post-stk-line.prod-type and
     4946     ub.contract-specif.prod-code    = temp-t-post-stk-line.prod-code no-error.
     4947   if available ub.contract-specif then do :
     4948         i = i + 1.
     4949   If Integer(10) = 0 Then Temp1  = 100  .
     4950                         Else Temp1 = Integer(10) .
     4951        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4952            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4953       run clear-item.
     4954       assign
     4955         gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4956         gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4957         gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4958         gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4959         gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4960         gds-zap-artic      = temp-t-post-stk-line.artic
     4961         gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4962         gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4963         gds-zap-type       = temp-t-post-stk-line.gds-type
     4964         pos-cli-type       = temp-t-post-stk-line.Cli-type
     4965         pos-cli-code       = temp-t-post-stk-line.Cli-code
     4966         pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4967       run ob-line
     4968       (temp-t-post-stk-line.obj-code    ,
     4969         temp-t-post-stk-line.obj-type    ,
     4970         temp-t-post-stk-line.cli-code    ,
     4971         temp-t-post-stk-line.cli-type    ,
     4972         temp-t-post-stk-line.artic       ,
     4973         temp-t-post-stk-line.prod-code   ,
     4974         temp-t-post-stk-line.prod-type   ,
     4975         temp-t-post-stk-line.gds-code    ,
     4976         ub.contract-specif.host-code     ,
     4977         Fact-order-1     ,
     4978         Fact-order-2     ,
     4979         t#sum-type       ,
     4980         t#cat-id         ,
     4981         ""               ,
     4982         yes) .
     4983       run display-str1.
     4984       run clear-item   in this-procedure .
     4985   end.
     4986   END PROCEDURE.
     4987   PROCEDURE display-str1  :
     4988   run di-qnty  ( "", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,"","").
     4989   run clear-item in this-procedure .
     4990   END PROCEDURE.
     4991   PROCEDURE p-line :
     4992    underline stream outstream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     4993     gds-zap-b-code
     4994     gds-zap-artic
     4995     gds-zap-gds-name
     4996     F-bonus
     4997     F-price-sale
     4998     F-kassa
     4999     F-bonus-dohod
     5000     F-nacenka
     5001     with FRAME ZAPAS.
     5002     DOWN stream   OutStream 1 with FRAME ZAPAS .
     5003   END PROCEDURE.
     5004   PROCEDURE Di :
     5005   END PROCEDURE.
     5006   PROCEDURE Di-qnty :
     5007   define input parameter p1 as char no-undo.
     5008   define input parameter p2 as int no-undo.
     5009   define input parameter p3 as char no-undo.
     5010   define input parameter p4 as char no-undo.
     5011   define input parameter p5 as char no-undo.
     5012   define input parameter p6 as char no-undo.
     5013   define input parameter p7 as char no-undo.
     5014   CASE CAPS ( p7) :
     5015    WHEN  ""  Then DO :
     5016                 DISPLAY stream  OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     5017                   p3               @ gds-zap-b-code
     5018                   p4               @ gds-zap-artic
     5019                   p5               @ gds-zap-gds-name
     5020                   v-bonus[1]       @  F-bonus
     5021                   v-price-sale[1]  @  F-price-sale
     5022                   v-kassa[1]       @  F-kassa
     5023                   v-bonus-dohod[1] @  F-bonus-dohod
     5024                   v-nacenka[1]     @  F-nacenka
     5025                   with FRAME ZAPAS .
     5026       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     5027                   p4 CHR(9)
     5028                   p5 CHR(9)
     5029                   v-bonus       [1] FORMAT ">>9.99"        +  CHR(9)
     5030                   v-price-sale  [1] FORMAT ">>>>>>>>9.99"  +  CHR(9)
     5031                   v-kassa       [1] FORMAT "->>>>>>>>9.99" +  CHR(9)
     5032                   v-bonus-dohod [1] FORMAT "->>>>>>>>9.99"  +  CHR(9)
     5033                   v-nacenka     [1] FORMAT "->>9.99"
     5034                   chr(10).
     5035    End.
     5036   End case.
     5037   DOWN stream   OutStream 1 with FRAME ZAPAS.
     5038   END PROCEDURE.
     5039   PROCEDURE Print-Footer :
     5040   define input parameter Nx as integer no-undo .
     5041   define input parameter Name as char no-undo .
     5042   run p-line.
     5043   END PROCEDURE.
     5044   PROCEDURE Clear-item :
     5045   define var kk as int no-undo.
     5046    REPEAT kk = 1 to 9:
     5047    Assign
     5048      v-bonus        [kk]  = 0
     5049      v-price-sale   [kk]  = 0
     5050      v-kassa        [kk]  = 0
     5051      v-bonus-dohod  [kk]  = 0
     5052      v-nacenka      [kk]  = 0
     5053      s-kassa        [kk]  = 0
     5054      s-bonus-dohod  [kk]  = 0
     5055      s-nacenka      [kk]  = 0
     5056      .
     5057    End.
     5058   END PROCEDURE.
     5059   PROCEDURE ob-line :
     5060   define input  parameter x-store-code     like ub.clients.obj-code                no-undo.
     5061   define input  parameter x-store-type     like ub.clients.obj-type                no-undo.
     5062   define input  parameter x-cli-code       like ub.clients.obj-code                no-undo.
     5063   define input  parameter x-cli-type       like ub.clients.obj-type                no-undo.
     5064   define INPUT  parameter x-artic          like post-ot-line.artic              no-undo.
     5065   define INPUT  parameter x-prod-code      like post-ot-line.prod-code          no-undo.
     5066   define INPUT  parameter x-prod-type      like post-ot-line.prod-type          no-undo.
     5067   define input  parameter x-b-code         like temp-t-post-stk-line.gds-code   no-undo.
     5068   define input  parameter x-host-code      like ub.contract-specif.host-code    no-undo.
     5069   define INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order         no-undo.
     5070   define INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order         no-undo.
     5071   define input  parameter x-sum-type       like post-ot-line.sum-type           no-undo.
     5072   define input  parameter x-cat-id         like post-ot-line.cat-id             no-undo.
     5073   define input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type       no-undo.
     5074   define input  parameter xTog-obj           as logical                         no-undo.
     5075   define        variable  bonus              as decimal                         no-undo.
     5076   define        variable  num-cont           as decimal                         no-undo.
     5077   define        variable  v-doc-num          as character                       no-undo.
     5078   define        variable  price-sale         as decimal                         no-undo.
     5079   define        variable  v-road-tax         as decimal                         no-undo.
     5080   define        variable  v-excise           as decimal                         no-undo.
     5081   FOR each post-ot-line where
     5082           post-ot-line.artic        = x-artic
     5083     and   post-ot-line.fact-order  <= x-fact-order-2
     5084     and   post-ot-line.fact-order  >= x-fact-order-1
     5085     and   post-ot-line.obj-code     = x-store-code
     5086     and   post-ot-line.obj-type     = x-store-type
     5087     and   post-ot-line.prod-code    = x-prod-code
     5088     and   post-ot-line.prod-type    = x-prod-type
     5089     and   post-ot-line.cli-code     = x-cli-code
     5090     and   post-ot-line.cli-type     = x-cli-type
     5091     and   post-ot-line.sum-type     = 'sale':U
     5092     and   post-ot-line.cat-id       = x-cat-id
     5093             no-lock :
     5094     CASE post-ot-line.ext-doc-type:
     5095      WHEN       'es':U  OR
     5096      WHEN       'rs':U
     5097      THEN  DO :
     5098       ASSIGN v-kassa[1] = v-kassa[1] - post-ot-line.sum-rubl
     5099              v-kassa[2] = v-kassa[2] - post-ot-line.fact-qnty
     5100             .
     5101      End.
     5102     End CASE.
     5103   END.
     5104   FOR each post-ot-line where
     5105           post-ot-line.artic        = x-artic
     5106     and   post-ot-line.fact-order  <= x-fact-order-2
     5107     and   post-ot-line.fact-order  >= x-fact-order-1
     5108     and   post-ot-line.obj-code     = x-store-code
     5109     and   post-ot-line.obj-type     = x-store-type
     5110     and   post-ot-line.prod-code    = x-prod-code
     5111     and   post-ot-line.prod-type    = x-prod-type
     5112     and   post-ot-line.cli-code     = x-cli-code
     5113     and   post-ot-line.cli-type     = x-cli-type
     5114     and   post-ot-line.sum-type     = 'cost':U
     5115     and   post-ot-line.cat-id       = x-cat-id
     5116             no-lock :
     5117     CASE post-ot-line.ext-doc-type:
     5118      WHEN       'es':U  OR
     5119      WHEN       'rs':U
     5120      THEN  DO :
     5121       ASSIGN
     5122       v-kassa[3] = v-kassa[3] - post-ot-line.sum-rubl.
     5123      End.
     5124     End CASE.
     5125   END.
     5126   run read-bonus in this-procedure
     5127     (input x-cont-code
     5128     ,input x-host-code
     5129     ,input x-b-code
     5130     ,output bonus )
     5131     .
     5132   v-bonus[1] = bonus.
     5133   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5135     (input  x-store-type
     5136     ,input  x-store-code
     5137     ,input  x-b-code
     5138     ,input  0
     5139     ,input  0
     5140     ,output v-doc-num
     5141     ,output price-sale
     5142     ,output v-road-tax
     5143     ,output v-excise
     5144     )  .
     5145   v-price-sale[1] = price-sale.
     5146   assign
     5147     v-bonus-dohod[1] = ( v-price-sale[1] * v-kassa[2] ) * v-bonus[1] / 100
     5148     v-nacenka[1] = ( v-kassa[1] - v-kassa[3] ) / v-kassa[1] * 100
     5149     s-kassa[1] =  s-kassa[1] + v-kassa[1]
     5150     s-bonus-dohod[1] =  s-bonus-dohod[1] + v-bonus-dohod[1]
     5151     s-nacenka[1] = s-nacenka[1] + v-nacenka[1]
     5152     .
     5153   find first tmp-itog where tmp-gds-code = x-b-code no-error.
     5154   if not available tmp-itog then do :
     5155     create tmp-itog.
     5156      assign
     5157       tmp-itog.tmp-gds-code             = x-b-code
     5158       tmp-itog.tmp-artic                = x-artic
     5159       tmp-itog.tmp-gds-name             = temp-t-post-stk-line.gds-name
     5160       tmp-itog.tmp-goods-grp-name       = temp-t-post-stk-line.goods-grp-name
     5161       tmp-itog.tmp-clients-grp-name     = temp-t-post-stk-line.clients-grp-name
     5162       tmp-itog.tmp-fact-order           = temp-t-post-stk-line.fact-order
     5163       tmp-itog.tmp-prod-type            = temp-t-post-stk-line.prod-type
     5164       tmp-itog.tmp-prod-code            = temp-t-post-stk-line.prod-code
     5165       tmp-itog.tmp-cli-type             = temp-t-post-stk-line.cli-type
     5166       tmp-itog.tmp-cli-code             = temp-t-post-stk-line.cli-code
     5167       tmp-itog.tmp-prod-cli-obj-name    = temp-t-post-stk-line.prod-cli-obj-name
     5168       tmp-itog.tmp-prod-cli-obj-type    = temp-t-post-stk-line.prod-cli-obj-type
     5169       tmp-itog.tmp-prod-cli-obj-code    = temp-t-post-stk-line.prod-cli-obj-code
     5170       tmp-itog.bn-col                   = 1
     5171       tmp-itog.bonus                    = v-bonus[1]
     5172       tmp-itog.sum-kassa                = s-kassa[1]
     5173       tmp-itog.sum-bonus-dohod          = s-bonus-dohod[1]
     5174       tmp-itog.sum-nacenka              = s-nacenka[1]
     5175       .
     5176   end.
     5177   else do :
     5178      assign
     5179       tmp-itog.bn-col          = tmp-itog.bn-col + 1
     5180       tmp-itog.sum-kassa       = tmp-itog.sum-kassa + s-kassa[1]
     5181       tmp-itog.sum-bonus-dohod = tmp-itog.sum-bonus-dohod + s-bonus-dohod[1]
     5182       tmp-itog.sum-nacenka     = tmp-itog.sum-nacenka + s-nacenka[1]
     5183       .
     5184   end.
     5185   END PROCEDURE.
     5186   PROCEDURE U-LINE :
     5187   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     5188     gds-zap-b-code
     5189     gds-zap-artic
     5190     gds-zap-gds-name
     5191     F-bonus
     5192     F-price-sale
     5193     F-kassa
     5194     F-bonus-dohod
     5195     F-nacenka
     5196     with FRAME ZAPAS .
     5197     DOWN stream   OutStream 1 with FRAME ZAPAS.
     5198   END PROCEDURE.
     5199   PROCEDURE display-str :
     5200   DISPLAY stream  OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9
     5201                   tmp-itog.tmp-gds-code @  gds-zap-b-code
     5202                   tmp-itog.tmp-artic    @  gds-zap-artic
     5203                   tmp-itog.tmp-gds-name @  gds-zap-gds-name
     5204                   v-bonus[2]            @  F-bonus
     5205                   "----------------"    @  F-price-sale
     5206                   s-kassa[2]            @  F-kassa
     5207                   s-bonus-dohod[2]      @  F-bonus-dohod
     5208                   s-nacenka[2]          @  F-nacenka
     5209                   with FRAME ZAPAS .
     5210                   DOWN stream   OutStream 1 with FRAME ZAPAS.
     5211     if Make-Excel then  put   stream ForExcel unformatted   tmp-itog.tmp-gds-code   CHR(9)
     5212                   tmp-itog.tmp-artic      CHR(9)
     5213                   tmp-itog.tmp-gds-name   CHR(9)
     5214                   v-bonus       [2] FORMAT ">>9.99"        +  CHR(9)
     5215                   s-kassa       [2] FORMAT "->>>>>>>>9.99"  +  CHR(9)
     5216                   s-bonus-dohod [2] FORMAT "->>>>>>>>9.99"  +  CHR(9)
     5217                   s-nacenka     [2] FORMAT "->>9.99"        +  CHR(9)
     5218                   chr(10).
     5219   END PROCEDURE.
