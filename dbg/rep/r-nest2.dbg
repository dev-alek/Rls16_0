      382   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383     run mainmenu_getcntxt in p-mainmenu-handle
      384       (output v-cntxt-db-num
      385       ,output v-cntxt-userid
      386       ,output v-cntxt-level
      387       ,output v-cntxt-host-code-obj
      388       ,output v-cntxt-obj-type
      389       ,output v-cntxt-obj-code
      390       ,output v-cntxt-db-num-obj
