      360           ub.gds-dtl.doc-qnty COLUMN-LABEL "Количество  !по док-ту" format "->>>>>>9.<<<"
      361           ub.gds-dtl.fact-qnty COLUMN-LABEL "Количество   !фактически" format "->>>>>>>9.<<<"
      362           Sub_Qnty COLUMN-LABEL "Разница кол-во! " format "->>,>>>,>>9.<<"
      363           Sub_Price-Rubl COLUMN-LABEL "Разница сумма!(РУБ)" format "->>>,>>>,>>9.99" space(0)
