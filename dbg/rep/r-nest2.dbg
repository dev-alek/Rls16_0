      344           ub.gds-dtl.doc-qnty COLUMN-LABEL "Количество  !по док-ту" format "->>>>>>9.<<<"
      345           ub.gds-dtl.fact-qnty COLUMN-LABEL "Количество   !фактически" format "->>>>>>>9.<<<"
