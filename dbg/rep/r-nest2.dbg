      399   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      401     (input  v-cntxt-host-code-obj
      402     ,output v-base-code
      403     )  .
      404   FIND ub.trn-doc WHERE recid( ub.trn-doc ) = rec_id  NO-LOCK .
      405   if NOT ub.trn-doc.print-rubl then
      406       message "Документ печатать в РУБЛЯХ ?"
      407               VIEW-AS ALERT-BOX QUESTION BUTTONS yes-no TITLE "" UPDATE PrintRubl.
      408   else
      409       assign PrintRubl = yes .
      410   Line = fill("-", 140).
      411   FIND ub.clients WHERE ub.clients.obj-type = ub.trn-doc.cli-type and
      412                                      ub.clients.obj-code = ub.trn-doc.cli-code NO-LOCK .
      413   FIND ub.pay-type WHERE ub.pay-type.obj-code = ub.trn-doc.pay-code NO-LOCK NO-ERROR.
      414   s1 = if available ub.pay-type then ub.pay-type.obj-name else "" .
      415   FIND Our_Object WHERE Our_Object .obj-type = ub.trn-doc.obj-type AND
      416                                             Our_Object .obj-code = ub.trn-doc.obj-code NO-LOCK .
      417   run rep/get-psn.p ( input trn-doc.boss, output s2 ).
      418   run rep/get-psn.p ( input trn-doc.wrkr, output s3 ).
      419   run rep/get-psn.p ( input trn-doc.agnt, output Isp_name ) .
      420   output   to value( string( session:temp-directory +
      421                                        "rpt" + string( g#report-num ) ) )
      422                                        page-size 62 .
      423   PUT SKIP SPACE(35) "АКТ НЕСООТВЕТСТВИЯ по " format "X(22)".
      424   CASE trn-doc.doc-type :
      425       WHEN 'при':U then
      426           PUT "приходной накладной N " format "X(22)".
      427       WHEN 'рас':U then
      428           do:
      429               if  trn-doc.internal then
      430                   PUT "требованию N " format "X(13)".
      431               else
      432                   PUT "расходной накладной N " format "X(22)".
      433           end.
      434       WHEN 'возврат':U then
      435           PUT "возвратной накладной N " format "X(24)".
      436       WHEN 'инв':U then do:
      437         if trn-doc.ext-doc-type = 'vt':U then do:
      438           PUT "инвентаризационной описи N " format "X(30)".
      439         end.
      440         if trn-doc.ext-doc-type = 'vp':U then do:
      441           PUT "пересортицы N " format "X(18)".
      442         end.
      443         if trn-doc.ext-doc-type = 'ap':U then do:
      444           put "документа коррекции учетных цен N " format "X(34)".
      445         end.
      446         if trn-doc.ext-doc-type = 'pc':U then do:
      447           put "документа смены типа приобретения N " format "x(36)".
      448         end.
      449       end.
      450   END CASE.
      451   PUT trn-doc.doc-code + "  от  " + string(day(trn-doc.doc-date)) + chr(47) +
      452           string(month(trn-doc.doc-date)) + chr(47) +
      453           string(year(trn-doc.doc-date)) format "X(100)" SKIP(1).
      454   if can-do( 'при,возврат':U , trn-doc.doc-type ) then
      455       PUT SPACE(10) "От кого : " clients.obj-name format "x(40)" SKIP
      456               SPACE(10) "Кому    : " Our_Object .obj-type format "x(4)"
      457               Our_Object .obj-name format "x(40)" SKIP(1).
      458   else
      459       if can-do( 'инв':U , trn-doc.doc-type ) then
      460           PUT SPACE(10) "От кого : " Our_Object.obj-name format "x(40)" SKIP
      461                   SPACE(10) "Кому    : " Our_Object.obj-name format "x(40)" SKIP(1).
      462       else
      463           PUT SPACE(10) "От кого : " Our_Object.obj-name format "x(40)" SKIP
      464                   SPACE(10) "Кому    : " clients.obj-name format "x(40)" SKIP(1).
      465   PUT SPACE(10) "Торговый представитель : " + s2 format "X(60)" space(5)
      466           "Кладовщик              : " + s3 format "X(60)" SKIP
      467           SPACE(10) "Исполнитель            : " + Isp_name format "X(60)" space(5)
      468           "Вид оплаты             : " + s1 format "X(60)" SKIP .
      469   PUT SPACE(75)
      470           "Курс                   : " + string( trn-doc.base-rate / trn-doc.base-scale, ">>>,>>9.9999" )
      471           format "X(60)" SKIP(1) .
      472   if can-do( "Учетные", PriceType ) then
      473       PUT SPACE(40) "Указаны  У Ч Е Т Н Ы Е  цены." format "X(60)" SKIP .
      474   else
      475       PUT SPACE(40) "Указаны  П Р О Д А Ж Н Ы Е  цены." format "X(60)" SKIP .
      476   if PrintRubl then FORM with frame x1-rubl .
      477   else FORM with frame x1 .
      478   FORM HEADER
      479           Line format "X(136)" AT 1 SKIP
      480           "Продолжение - на следующей странице" AT 30 SKIP
      481           with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
      482   VIEW FRAME BottomFrame .
      483   if session :set-wait-state( "compiler" ) then.
      484   FOR EACH ub.doc-line where ub.doc-line.doc-code = ub.trn-doc.doc-code NO-LOCK ,
      485           EACH ub.goods WHERE ub.goods.prod-type = ub.doc-line.prod-type AND
      486                                         ub.goods.prod-code = ub.doc-line.prod-code AND
      487                                         ub.goods.artic = ub.doc-line.artic NO-LOCK ,
      488           EACH ub.gds-dtl where ub.gds-dtl.prod-type = ub.doc-line.prod-type
      489                               and ub.gds-dtl.prod-code = ub.doc-line.prod-code
      490                               and ub.gds-dtl.artic = ub.doc-line.artic
      491                               and ub.gds-dtl.doc-code = ub.doc-line.doc-code NO-LOCK
      492                               BREAK BY ub.doc-line.artic :
      493       assign
      494           tprice-base = ( if can-do( "Учетные", PriceType )
      495                                   then round(ub.doc-line.price-base, 2)    else round(ub.gds-dtl.price-base, 2) )
      496           tprice-rubl = ( if can-do( "Учетные", PriceType )
      497                                 then round(ub.doc-line.price-rubl, 2)   else round(ub.gds-dtl.price-rubl, 2) )
      498           .
      499       ACCUMULATE
      500                       doc-line.artic ( COUNT )
      501                       gds-dtl.fact-qnty ( TOTAL )
      502                       gds-dtl.doc-qnty ( TOTAL )
      503                       ( gds-dtl.fact-qnty - gds-dtl.doc-qnty ) ( TOTAL )
      504                       ( gds-dtl.fact-qnty - gds-dtl.doc-qnty ) * tprice-base ( TOTAL )
      505                       ( gds-dtl.fact-qnty - gds-dtl.doc-qnty ) * tprice-rubl ( TOTAL )
      506                       gds-dtl.doc-qnty * tprice-base ( TOTAL )
      507                       gds-dtl.fact-qnty * tprice-base ( TOTAL )
      508                       gds-dtl.doc-qnty * tprice-rubl ( TOTAL )
      509                       gds-dtl.fact-qnty * tprice-rubl ( TOTAL )
      510                       gds-dtl.doc-qnty * ( tprice-base - round(gds-dtl.discnt-base, 2) ) ( TOTAL )
      511                       gds-dtl.fact-qnty * ( tprice-base - round(gds-dtl.discnt-base, 2) ) ( TOTAL )
      512                       gds-dtl.doc-qnty * ( tprice-rubl - round(gds-dtl.discnt-rubl, 2) ) ( TOTAL )
      513                       gds-dtl.fact-qnty * ( tprice-rubl - round(gds-dtl.discnt-rubl, 2) ) ( TOTAL ) .
      514       if ( NOT trn-doc.doc-type = 'инв':U AND ( gds-dtl.doc-qnty <> gds-dtl.fact-qnty ) ) OR
      515          ( trn-doc.doc-type = 'инв':U AND
      516               gds-dtl.doc-qnty <> 0 AND gds-dtl.doc-qnty <> ? )    then
      517           do:
      518               assign
      519                   upper = gds-dtl.prt-code
      520                   Gds_Name = goods.gds-name
      521                   Sub_Qnty = ( if trn-doc.doc-type = 'инв':U
      522                                         then gds-dtl.doc-qnty
      523                                         else ( gds-dtl.doc-qnty - gds-dtl.fact-qnty ) )
      524                   .
      525               if trn-doc.doc-type = 'инв':U  then
      526                   do:
      527                       assign
      528                           Sub_Price-Base = Sub_Qnty * tprice-base
      529                           Sub_Price-Rubl = Sub_Qnty * tprice-rubl .
      530                       if Sub_Qnty > 0 then
      531                           assign
      532                               UpSub_Qnty = Sub_Qnty
      533                               UpSub_Price-Base = Sub_Price-Base
      534                               UpSub_Price-Rubl = Sub_Price-Rubl
      535                               DownSub_Qnty = 0
      536                               DownSub_Price-Base = 0
      537                               DownSub_Price-Rubl = 0 .
      538                       else
      539                           assign
      540                               UpSub_Qnty = 0
      541                               UpSub_Price-Base = 0
      542                               UpSub_Price-Rubl = 0
      543                               DownSub_Qnty = Sub_Qnty
      544                               DownSub_Price-Base = Sub_Price-Base
      545                               DownSub_Price-Rubl = Sub_Price-Rubl .
      546                   end.
      547               else
      548                   do:
      549                       assign
      550                           Sub_Price-Base = ( if Discnt_Type = 1
      551                                                           then Sub_Qnty * ( tprice-base - round(gds-dtl.discnt-base, 2) )
      552                                                           else Sub_Qnty * tprice-base )
      553                           Sub_Price-Rubl = ( if Discnt_Type = 1
      554                                                          then Sub_Qnty * ( tprice-rubl - round(gds-dtl.discnt-rubl, 2) )
      555                                                          else Sub_Qnty * tprice-rubl ) .
      556                       if gds-dtl.doc-qnty > gds-dtl.fact-qnty then
      557                           assign
      558                               UpSub_Qnty = 0
      559                               UpSub_Price-Base = 0
      560                               UpSub_Price-Rubl = 0
      561                               DownSub_Qnty = Sub_Qnty
      562                               DownSub_Price-Base = Sub_Price-Base
      563                               DownSub_Price-Rubl = Sub_Price-Rubl .
      564                       else
      565                           assign
      566                               UpSub_Qnty = - Sub_Qnty
      567                               UpSub_Price-Base = - Sub_Price-Base
      568                               UpSub_Price-Rubl = - Sub_Price-Rubl
      569                               DownSub_Qnty = 0
      570                               DownSub_Price-Base = 0
      571                               DownSub_Price-Rubl = 0 .
      572                   end.
      573               ACCUMULATE
      574                   Sub_Qnty (TOTAL)
      575                   Sub_Price-Base (TOTAL)
      576                   Sub_Price-Rubl (TOTAL)
      577                   UpSub_Qnty (TOTAL)
      578                   UpSub_Price-Base (TOTAL)
      579                   UpSub_Price-Rubl (TOTAL)
      580                   DownSub_Qnty (TOTAL)
      581                   DownSub_Price-Base (TOTAL)
      582                   DownSub_Price-Rubl (TOTAL) .
      583               FIND ub.bar-code WHERE ub.bar-code.gds-code = ub.goods.gds-code AND
      584                                                     ub.bar-code.unit-cli = ub.goods.unit-base AND
      585                                                     ub.bar-code.node-code = ub.gds-dtl.prt-code AND
      586                                                     ub.bar-code.part-code = "" AND
      587                                                     ub.bar-code.in-code = "" NO-LOCK .
      588               REPEAT :
      589                   FIND ub.gds-prt where ub.gds-prt.node-code = upper AND
      590                                                   NOT ub.gds-prt.root NO-LOCK NO-ERROR .
      591                   if not available ub.gds-prt then
      592                       leave.
      593                   assign
      594                       Gds_Name = Gds_Name + chr(47) + ub.gds-prt.node-name
      595                       upper = ub.gds-prt.upper-code .
      596               END.
      597               if PrintRubl then
      598                   do:
      599                       DISPLAY sym1 bar-code.b-code
      600                                       goods.artic
      601                                       Gds_Name
      602                                       ( if Discnt_Type = 1
      603                                         then ( tprice-rubl - round(gds-dtl.discnt-rubl, 2) )
      604                                         else tprice-rubl ) @ tprice-rubl
      605                                       ( if trn-doc.doc-type = 'инв':U
      606                                         then ( gds-dtl.fact-qnty - gds-dtl.doc-qnty )
      607                                         else gds-dtl.doc-qnty ) @ gds-dtl.doc-qnty
      608                                       gds-dtl.fact-qnty       when gds-dtl.fact-qnty  <> 0
      609                                       Sub_Qnty
      610                                       Sub_Price-Rubl
      611                                       sym2    with frame x1-rubl.
      612                       DOWN 1 with frame x1-rubl.
      613                   end .
      614               else
      615                   do:
      616                       DISPLAY sym1 bar-code.b-code
      617                                       goods.artic
      618                                       Gds_Name
      619                                       ( if Discnt_Type = 1
      620                                         then ( tprice-base - round(gds-dtl.discnt-base, 2) )
      621                                         else tprice-base ) @ tprice-base
      622                                       ( if trn-doc.doc-type = 'инв':U
      623                                         then ( gds-dtl.fact-qnty - gds-dtl.doc-qnty )
      624                                         else gds-dtl.doc-qnty ) @ gds-dtl.doc-qnty
      625                                       gds-dtl.fact-qnty       when gds-dtl.fact-qnty  <> 0
      626                                       Sub_Qnty
      627                                       Sub_Price-Base
      628                                       sym2    with frame x1.
      629                       DOWN 1 with frame x1 .
      630                   end .
      631           end .
      632       if last( doc-line.artic ) then
      633           do:
      634               PUT Line format "X(136)" SKIP.
      635               if PrintRubl then
      636                   do:
      637                       DISPLAY "ИТОГО" @ Gds_Name
      638                                       ACCUM TOTAL Sub_Qnty @ Sub_Qnty
      639                                       ACCUM TOTAL Sub_Price-Rubl @ Sub_Price-Rubl
      640                                       with frame x1-rubl.
      641                       UNDERLINE Gds_Name Sub_Qnty Sub_Price-Rubl with frame x1-rubl.
      642                       DOWN 2 with frame x1-rubl.
      643                   end .
      644               else
      645                   do:
      646                       DISPLAY "ИТОГО" @ Gds_Name
      647                                       ACCUM TOTAL Sub_Qnty @ Sub_Qnty
      648                                       ACCUM TOTAL Sub_Price-Base @ Sub_Price-Base
      649                                       with frame x1 .
      650                       UNDERLINE Gds_Name Sub_Qnty Sub_Price-Base with frame x1 .
      651                       DOWN 2 with frame x1 .
      652                   end .
      653           end.
      654   END.
      655   if session :set-wait-state( "" ) then.
      656   if PrintRubl then
      657       REPEAT with FRAME x2-rubl:
      658           DISPLAY  "По документу" @ s1
      659               ub.trn-doc.doc-date @ s2
      660               ( if ub.trn-doc.doc-type = 'инв':U
      661                     then ( ACCUM TOTAL ( ub.gds-dtl.fact-qnty - ub.gds-dtl.doc-qnty ) )
      662                     else ( ACCUM TOTAL ub.gds-dtl.doc-qnty ) ) @ tqnty_
      663               ( if ub.trn-doc.doc-type = 'инв':U then
      664                     ACCUM TOTAL ( ub.gds-dtl.fact-qnty - ub.gds-dtl.doc-qnty ) * tprice-rubl
      665                 else
      666                     if Discnt_Type = 1
      667                         then ACCUM TOTAL ub.gds-dtl.doc-qnty * ( tprice-rubl - round(ub.gds-dtl.discnt-rubl, 2) )
      668                         else ACCUM TOTAL ub.gds-dtl.doc-qnty * tprice-rubl ) @ tsum_rubl .
      669           down 2.
      670           DISPLAY "Фактически" @ s1
      671               ub.trn-doc.fact-date @ s2
      672               ( ACCUM TOTAL ub.gds-dtl.fact-qnty ) @ tqnty_
      673               ( if ub.trn-doc.doc-type = 'инв':U then
      674                     ACCUM TOTAL ub.gds-dtl.fact-qnty * tprice-rubl
      675                 else
      676                     if Discnt_Type = 1
      677                         then ACCUM TOTAL ub.gds-dtl.fact-qnty * ( tprice-rubl - round(ub.gds-dtl.discnt-rubl, 2) )
      678                         else ACCUM TOTAL ub.gds-dtl.fact-qnty * tprice-rubl ) @ tsum_rubl .
      679           down 2.
      680           DISPLAY "Разница" @ s1
      681                   " " @ s2
      682                   ACCUM TOTAL Sub_Qnty @ tqnty_
      683                   ACCUM TOTAL Sub_Price-Rubl @ tsum_rubl .
      684           down 2.
      685           DISPLAY  "   в т.ч. недостача" @ s1
      686                   " " @ s2
      687                   ACCUM TOTAL DownSub_Qnty @ tqnty_
      688                   ACCUM TOTAL DownSub_Price-Rubl @ tsum_rubl .
      689           down 2.
      690           DISPLAY "          излишки " @ s1
      691                   " " @ s2
      692                   ACCUM TOTAL UpSub_Qnty @ tqnty_
      693                   ACCUM TOTAL UpSub_Price-Rubl @ tsum_rubl .
      694           down 3.
      695           LEAVE.
      696       END .
      697   else
      698       REPEAT with FRAME x2:
      699           DISPLAY  "По документу" @ s1
      700               ub.trn-doc.doc-date @ s2
      701               ( if ub.trn-doc.doc-type = 'инв':U
      702                     then ( ACCUM TOTAL ( ub.gds-dtl.fact-qnty - ub.gds-dtl.doc-qnty ) )
      703                     else ( ACCUM TOTAL ub.gds-dtl.doc-qnty ) ) @ tqnty_
      704               ( if ub.trn-doc.doc-type = 'инв':U then
      705                     ACCUM TOTAL ( ub.gds-dtl.fact-qnty - ub.gds-dtl.doc-qnty ) * tprice-base
      706                 else
      707                     if Discnt_Type = 1
      708                         then ACCUM TOTAL ub.gds-dtl.doc-qnty * ( tprice-base - round(ub.gds-dtl.discnt-base, 2) )
      709                         else ACCUM TOTAL ub.gds-dtl.doc-qnty * tprice-base ) @ tsum_base .
      710               .
      711           down 2.
      712           DISPLAY "Фактически" @ s1
      713               ub.trn-doc.fact-date @ s2
      714               ( ACCUM TOTAL ub.gds-dtl.fact-qnty ) @ tqnty_
      715               ( if ub.trn-doc.doc-type = 'инв':U then
      716                     ACCUM TOTAL ub.gds-dtl.fact-qnty * tprice-base
      717                 else
      718                     if Discnt_Type = 1
      719                         then ACCUM TOTAL ub.gds-dtl.fact-qnty * ( tprice-base - round(ub.gds-dtl.discnt-base, 2) )
      720                         else ACCUM TOTAL ub.gds-dtl.fact-qnty * tprice-base ) @ tsum_base .
      721           .
      722           down 2.
      723           DISPLAY "Разница" @ s1
      724                   " " @ s2
      725                   ACCUM TOTAL Sub_Qnty @ tqnty_
      726                   ACCUM TOTAL Sub_Price-Base @ tsum_base
      727                   .
      728           down 2.
      729           DISPLAY "   в т.ч. недостача" @ s1
      730                   " " @ s2
      731                   ACCUM TOTAL DownSub_Qnty @ tqnty_
      732                   ACCUM TOTAL DownSub_Price-Base @ tsum_base
      733                   .
      734           down 2.
      735           DISPLAY "          излишки " @ s1
      736                   " " @ s2
      737                   ACCUM TOTAL UpSub_Qnty @ tqnty_
      738                   ACCUM TOTAL UpSub_Price-Base @ tsum_base
      739                   .
      740           down 3.
      741           LEAVE.
      742       END .
      743   HIDE FRAME BottomFrame .
      744   if NOT PrintRubl then
      745       run rep/wp.p ( input p-mainmenu-handle, input abs( ACCUM TOTAL Sub_Price-Base ), output s1, output s2 ) .
      746   else
      747       run rep/wp-rub.p ( input abs( ACCUM TOTAL Sub_Price-Rubl ), output s1, output s2 ) .
      748   PUT SPACE(5) "Разница составила     :  " + CAPS(s1) format "X(128)" SKIP(1).
      749   if v-base-code <> 0 and NOT PrintRubl then
      750           do:
      751               run rep/wp-rub.p ( input abs( ACCUM TOTAL Sub_Price-Rubl ), output s1, output s2 ) .
      752               PUT SPACE(5)
      753                   "( Рублевый эквивалент :  " + trim( CAPS(s1) ) + " )" format "X(128)" SKIP(1).
      754           end.
      755   output CLOSE.
      756       define variable Log-Res as log no-undo .
      757   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   do:
      759     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      760       (input  v-cntxt-db-num
      761       ,input  v-cntxt-userid
      762       ,input  0
      763       ,input  'actn_waybills-to-file_print':U
      764       ,input  'firm':U
      765       ,input  v-cntxt-host-code-obj
      766       ,input  '':U
      767       ,input  0
      768       ,input  0
      769       ,input  0
      770       ,input  0
      771       ,input  no
      772       ,output Log-Res
      773       )  .
      774   end.
      775       if Log-Res then do:
      776   if g#quest-print = false
      777   then do:
      778     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      779                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
      780                                         OUTPUT g#log ).
      781   end.
      782   else do:
      783     os-command silent
      784       value( "COPY /b " +
      785         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      786         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      787         string( session:temp-directory) +  "$" + string( g#report-num )
      788                 ) .
      789     os-command silent
      790       value( "COPY /b " +
      791         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      792         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      793         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      794                 ) .
      795   end.
      796       end.
      797       else do:
      798   if g#quest-print = false
      799   then do:
      800     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      801                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      802                                         OUTPUT g#log ).
      803   end.
      804   else do:
      805     os-command silent
      806       value( "COPY /b " +
      807         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      808         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      809         string( session:temp-directory) +  "$" + string( g#report-num )
      810                 ) .
      811     os-command silent
      812       value( "COPY /b " +
      813         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      814         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      815         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      816                 ) .
      817   end.
      818       end.
