      322   define variable     Sub_Price-Base  like    ub.gds-dtl.price-base  no-undo.
      323   define variable     Sub_Price-Rubl   like    ub.gds-dtl.price-rubl  no-undo.
      324   define variable     Sub_Qnty            like    ub.gds-dtl.doc-qnty     no-undo.
      325   define variable     Gds_Name    like    ub.goods.gds-name  no-undo.
      326   define variable     tprice-base     like    ub.gds-dtl.price-base  no-undo.
      327   define variable     tprice-rubl     like    ub.gds-dtl.price-rubl  no-undo.
      328   def buffer Our_Object for ub.clients.
      329   define variable     tsum_base    as decimal     no-undo.
      330   define variable     tsum_rubl    as decimal     no-undo.
      331   define variable     tqnty_    as decimal    no-undo.
