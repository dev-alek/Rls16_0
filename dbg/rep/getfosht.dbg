        1   block-level on error undo, throw.
        2   define input parameter p-obj-type           as character        no-undo.
        3   define input parameter p-obj-code           as integer          no-undo.
        4   define input parameter p-shift-date         as date             no-undo.
        5   define input parameter p-shift-num          as integer          no-undo.
        6   define output parameter p-fact-order-from   as decimal          no-undo.
        7   define output parameter p-fact-order-to     as decimal          no-undo.
        8   define output parameter p-docs-exists       as logical          no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: getfosht.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: rep/getfosht.p $":U .
       14   define variable vss-description as character no-undo init "Определение диапазона fact-order по диапазону дат или смен".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75       define variable v-shift-on    as logical      no-undo.
       76       define buffer buf_stk-tot for ub.stk-tot.
       77   do
       78   for buf_stk-tot
       79   on error undo, return error
       80   :
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
       83     (input  p-obj-type
       84     ,input  p-obj-code
       85     ,input  'shift-on=request'
       86     ,output v-shift-on
       87     ) no-error .
       88       if error-status :error
       89       then do:
       90           message
       91                       vss-workfile vss-revision vss-description
       92               skip(1)
       93               skip "Невозможно определить тип сменный/не сменный"
       94               skip "для заданного объекта."
       95               skip "Объект:" p-obj-type p-obj-code
       96               skip return-value
       97               skip trim(error-status :get-message(1))
       98                       trim(error-status :get-message(2))
       99                       trim(error-status :get-message(3))
      100           view-as alert-box error.
      101           undo, return error .
      102       end.
      103       if v-shift-on = no
      104       then do:
      105           message
      106               "Неверно задан тип объекта" p-obj-type p-obj-code
      107               skip "Объект не сменный."
      108           view-as alert-box information.
      109       end.
      110       assign
      111           p-docs-exists = no
      112       .
      113       find last buf_stk-tot no-lock
      114           where buf_stk-tot.obj-type   = p-obj-type
      115             and buf_stk-tot.obj-code   = p-obj-code
      116             and buf_stk-tot.shift-date = p-shift-date
      117             and buf_stk-tot.shift-num  = p-shift-num
      118       use-index shift-num
      119       no-error.
      120       if not available buf_stk-tot
      121       then do:
      122           assign
      123               p-docs-exists = no
      124           .
      125       end.
      126       else do:
      127           assign
      128               p-fact-order-to = buf_stk-tot.fact-order
      129               p-docs-exists   = yes
      130           .
      131           find last buf_stk-tot no-lock
      132               where buf_stk-tot.obj-type   = p-obj-type
      133                 and buf_stk-tot.obj-code   = p-obj-code
      134                 and buf_stk-tot.shift-date = p-shift-date
      135                 and buf_stk-tot.shift-num  < p-shift-num
      136           use-index shift-num
      137           no-error.
      138           if not available buf_stk-tot
      139           then do:
      140               find last buf_stk-tot no-lock
      141                   where buf_stk-tot.obj-type   = p-obj-type
      142                     and buf_stk-tot.obj-code   = p-obj-code
      143                     and buf_stk-tot.shift-date < p-shift-date
      144               use-index shift-num
      145               no-error.
      146               if not available buf_stk-tot
      147               then do:
      148                   assign
      149                       p-docs-exists       = yes
      150                       p-fact-order-from   = 0
      151                   .
      152               end.
      153           end.
      154           if available buf_stk-tot
      155           then do:
      156               if buf_stk-tot.fact-order >= p-fact-order-to
      157               then do:
      158                   assign
      159                       p-docs-exists = no
      160                   .
      161               end.
      162               else do:
      163                   assign
      164                       p-docs-exists       = yes
      165                       p-fact-order-from   = buf_stk-tot.fact-order
      166                   .
      167               end.
      168           end.
      169       end.
      170   end.
