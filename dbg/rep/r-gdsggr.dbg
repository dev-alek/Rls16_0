        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-obj-type           as character    no-undo.
        4   define input parameter p-obj-code           as integer      no-undo.
        5   define input parameter p-fbr-gds-grp-recid  as  recid no-undo.
        6   define input parameter p-print-option       as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: r-gdsggr.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/r-gdsggr.p $":U .
       12   define variable vss-description as character no-undo init "Список групп блюд".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      309   define new shared variable RepPathName        as character no-undo .
      310   define new shared variable PrintRubl          as logical   no-undo .
      311   define variable vss-include-info2 as character format "X(65)" no-undo
      312   initial "@(#)$Workfile$ $Revision$".
      313   define temp-table temp_fbrglib_grp no-undo
      314       field sel           as character
      315       field full-name     as character
      316       field out-code      as integer
      317       field sort-name     as character
      318       field node-code     as integer
      319       field upper-code    as integer
      320       field name          as character
      321       field level         as integer
      322       field mark          as character
      323       field obj-type      as character
      324       field obj-code      as integer
      325       field global-code   as integer
      326       index pi is primary unique obj-type obj-code sort-name
      327       index fn obj-type obj-code full-name
      328       index nc is unique obj-type obj-code node-code
      329       index sl obj-type obj-code sel
      330       index uc obj-type obj-code upper-code
      331   .
      332   define temp-table temp_fbrglib_found-grp no-undo
      333       field full-name   as character
      334       field sort-name   as character
      335       field node-code   as integer
      336       field level       as integer
      337       field is-terminal as logical
      338       field obj-type      as character
      339       field obj-code      as integer
      340       index pi is primary unique obj-type obj-code sort-name
      341       index fn obj-type obj-code full-name
      342       index lv obj-type obj-code level
      343       index it obj-type obj-code is-terminal
      344   .
      345   define temp-table temp_found-result-nodelist no-undo
      346       field node-code     as integer
      347       field processed     as logical
      348       field sort-name     as character
      349       field full-name     as character
      350       index pi is primary unique node-code
      351       index ps processed
      352   .
      353   procedure fbrglib-get-sort-name :
      354   do
      355   on error undo, return error
      356   :
      357   define input parameter p-obj-type   as character    no-undo.
      358   define input parameter p-obj-code   as integer      no-undo.
      359   define input parameter p-node-code  as integer      no-undo.
      360   define output parameter p-sort-name as character    no-undo.
      361       define variable v-upper-code    as integer           no-undo.
      362       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      363       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      364       find first buf_fbr-gds-grp no-lock
      365            where buf_fbr-gds-grp.obj-type  = p-obj-type
      366              and buf_fbr-gds-grp.obj-code  = p-obj-code
      367              and buf_fbr-gds-grp.node-code = p-node-code
      368       no-error.
      369       if not available buf_fbr-gds-grp
      370       then do:
      371           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      372       end.
      373       assign
      374           p-sort-name  = ""
      375           v-upper-code = 1
      376       .
      377       do while true
      378       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
      379       :
      380           assign
      381               p-sort-name  = buf_fbr-gds-grp.node-name
      382                            + (if p-sort-name <> "" then chr(2) else "")
      383                            + p-sort-name
      384               v-upper-code = buf_fbr-gds-grp.upper-code
      385           .
      386           if buf_fbr-gds-grp.upper-code = 1
      387           then do:
      388               leave.
      389           end.
      390           find first buf_fbr-gds-grp no-lock
      391                where buf_fbr-gds-grp.obj-type  = p-obj-type
      392                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      393                  and buf_fbr-gds-grp.node-code = v-upper-code
      394           no-error.
      395           if not available buf_fbr-gds-grp
      396           then do:
      397               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
      398                                   + string( v-upper-code )
      399                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      400           end.
      401       end.
      402   end.
      403   end procedure.
      404   procedure fbrglib-get-full-name :
      405   do
      406   on error undo, return error
      407   :
      408   define input parameter p-obj-type   as character    no-undo.
      409   define input parameter p-obj-code   as integer      no-undo.
      410   define input parameter p-node-code  as integer      no-undo.
      411   define output parameter p-full-name as character    no-undo.
      412       define variable v-upper-code    as integer           no-undo.
      413       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      414       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
      415       if p-node-code = 1
      416       then do:
      417           assign
      418               p-full-name = ""
      419           .
      420       end.
      421       else do:
      422           find first buf_fbr-gds-grp no-lock
      423                where buf_fbr-gds-grp.obj-type  = p-obj-type
      424                  and buf_fbr-gds-grp.obj-code  = p-obj-code
      425                  and buf_fbr-gds-grp.node-code = p-node-code
      426           no-error.
      427           if not available buf_fbr-gds-grp
      428           then do:
      429               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      430           end.
      431           assign
      432               p-full-name  = ""
      433               v-upper-code = 1
      434           .
      435           do while true
      436           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
      437           :
      438               assign
      439                   p-full-name  = buf_fbr-gds-grp.node-name
      440                               + (if p-full-name <> "" then chr(47) else "")
      441                               + p-full-name
      442                   v-upper-code = buf_fbr-gds-grp.upper-code
      443               .
      444               if buf_fbr-gds-grp.upper-code = 1
      445               then do:
      446                   leave.
      447               end.
      448               find first buf_fbr-gds-grp no-lock
      449                    where buf_fbr-gds-grp.obj-type  = p-obj-type
      450                      and buf_fbr-gds-grp.obj-code  = p-obj-code
      451                      and buf_fbr-gds-grp.node-code = v-upper-code
      452               no-error.
      453               if not available buf_fbr-gds-grp
      454               then do:
      455                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
      456                                       + string( v-upper-code )
      457                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      458               end.
      459           end.
      460           assign
      461               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      462           .
      463       end.
      464   end.
      465   end procedure.
      466   procedure fbrglib-get-root-code :
      467   do
      468   on error undo, return error
      469   :
      470   define output parameter p-root-code as integer      no-undo.
      471       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      472       find first buf_fbr-gds-grp no-lock
      473            where buf_fbr-gds-grp.upper-code = 0
      474       no-error .
      475       if not available buf_fbr-gds-grp
      476       then do:
      477           undo, return error .
      478       end.
      479       else do:
      480           assign
      481               p-root-code = buf_fbr-gds-grp.node-code
      482           .
      483       end.
      484   end.
      485   end procedure.
      486   procedure fbrglib-find-grp-by-full-name :
      487   do
      488   on error undo, return error
      489   :
      490   define input parameter p-obj-type     as character    no-undo.
      491   define input parameter p-obj-code     as integer      no-undo.
      492   define input parameter p-search-name  as character    no-undo.
      493   define input parameter p-fill-path    as logical      no-undo.
      494       define variable v-upper-code    as integer          no-undo.
      495       define variable v-not-found     as logical init yes no-undo.
      496       define variable v-counter       as integer           no-undo.
      497       define variable v-level         as integer           no-undo.
      498       define variable v-full-name     as character         no-undo.
      499       define variable v-sort-name     as character         no-undo.
      500       define variable v-node-name     as character      no-undo.
      501       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      502       assign
      503           p-search-name = replace( p-search-name, chr(47), chr(2) )
      504       .
      505       run fbrglib-get-root-code ( output v-upper-code ) no-error .
      506       if error-status :error
      507       then do:
      508           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
      509       end.
      510       assign
      511           v-full-name  = ""
      512           v-level      = num-entries( p-search-name, chr(2) )
      513       .
      514       for each temp_fbrglib_found-grp
      515       :
      516           delete temp_fbrglib_found-grp.
      517       end.
      518       start-name-analyze:
      519       do v-counter = 1 to v-level
      520       :
      521           if v-counter < v-level
      522           then do:
      523               assign
      524                   v-node-name = entry( v-counter, p-search-name, chr(2) )
      525               .
      526               find first buf_fbr-gds-grp no-lock
      527                    where buf_fbr-gds-grp.obj-type   = p-obj-type
      528                      and buf_fbr-gds-grp.obj-code   = p-obj-code
      529                      and buf_fbr-gds-grp.upper-code = v-upper-code
      530                      and buf_fbr-gds-grp.node-name  = v-node-name
      531               no-error .
      532               if not available buf_fbr-gds-grp
      533               then do:
      534                   assign
      535                       v-full-name  = p-search-name
      536                       v-sort-name  = p-search-name
      537                   .
      538                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
      539               end.
      540               else do:
      541                   assign
      542                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
      543                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
      544                       v-upper-code = buf_fbr-gds-grp.node-code
      545                   .
      546                   if p-fill-path = yes
      547                   then do:
      548                       create temp_fbrglib_found-grp.
      549                       assign
      550                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
      551                           temp_fbrglib_found-grp.sort-name = v-sort-name
      552                           temp_fbrglib_found-grp.node-code = v-upper-code
      553                           temp_fbrglib_found-grp.level     = v-counter
      554                           temp_fbrglib_found-grp.obj-type  = p-obj-type
      555                           temp_fbrglib_found-grp.obj-code  = p-obj-code
      556                       .
      557                   end.
      558               end.
      559           end.
      560           else do:
      561               for each buf_fbr-gds-grp no-lock
      562                  where buf_fbr-gds-grp.obj-type   = p-obj-type
      563                    and buf_fbr-gds-grp.obj-code   = p-obj-code
      564                    and buf_fbr-gds-grp.upper-code = v-upper-code
      565                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      566               :
      567                   assign
      568                       v-not-found = no
      569                   .
      570                   create temp_fbrglib_found-grp.
      571                   assign
      572                       temp_fbrglib_found-grp.full-name = v-full-name
      573                                                           + (if v-full-name = "" then "" else chr(47) )
      574                                                           + buf_fbr-gds-grp.node-name + chr(47)
      575                       temp_fbrglib_found-grp.sort-name = v-sort-name
      576                                                           + ( if v-sort-name = "" then "" else chr(2) )
      577                                                           + buf_fbr-gds-grp.node-name
      578                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
      579                       temp_fbrglib_found-grp.level     = v-level
      580                       temp_fbrglib_found-grp.obj-type  = p-obj-type
      581                       temp_fbrglib_found-grp.obj-code  = p-obj-code
      582                   .
      583               end.
      584               if v-not-found = yes
      585               then do:
      586                   assign
      587                       v-full-name  = p-search-name
      588                       v-sort-name  = p-search-name
      589                   .
      590                   for each temp_fbrglib_found-grp
      591                   :
      592                       delete temp_fbrglib_found-grp.
      593                   end.
      594                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      595               end.
      596           end.
      597       end.
      598   end.
      599   end procedure.
      600   procedure fbrglib-find-all-subgroup :
      601   do
      602   on error undo, return error
      603   :
      604   define input parameter p-start-obj-type     as character    no-undo.
      605   define input parameter p-start-obj-code     as integer      no-undo.
      606   define input parameter p-start-node-code    as integer      no-undo.
      607   define input parameter p-terminal-only      as logical      no-undo.
      608       define variable v-start-full-name   as character     no-undo.
      609       define variable v-start-sort-name   as character     no-undo.
      610       define variable v-not-found         as logical       no-undo.
      611       define variable v-is-terminal       as logical       no-undo.
      612       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      613       create temp_found-result-nodelist.
      614       assign
      615           temp_found-result-nodelist.node-code = p-start-node-code
      616           temp_found-result-nodelist.processed = no
      617       .
      618       run fbrglib-get-full-name in this-procedure (
      619             input p-start-obj-type
      620           , input p-start-obj-code
      621           , input p-start-node-code
      622           , output v-start-full-name
      623       ).
      624       run fbrglib-get-full-name in this-procedure (
      625             input p-start-obj-type
      626           , input p-start-obj-code
      627           , input p-start-node-code
      628           , output v-start-sort-name
      629       ).
      630       process-nodes:
      631       do while yes
      632       :
      633           find first temp_found-result-nodelist
      634                where temp_found-result-nodelist.node-code = p-start-node-code
      635           .
      636           assign
      637               temp_found-result-nodelist.processed = yes
      638           .
      639           for each buf_fbr-gds-grp no-lock
      640              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
      641                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
      642                and buf_fbr-gds-grp.upper-code = p-start-node-code
      643           on error undo, return error
      644           :
      645               run fbrglib-is-terminal in this-procedure (
      646                     input buf_fbr-gds-grp.obj-type
      647                   , input buf_fbr-gds-grp.obj-code
      648                   , input buf_fbr-gds-grp.node-code
      649                   , output v-is-terminal
      650               ).
      651               if v-is-terminal = yes
      652               then do:
      653                   create temp_fbrglib_found-grp.
      654                   assign
      655                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      656                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      657                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      658                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      659                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      660                       temp_fbrglib_found-grp.is-terminal = yes
      661                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      662                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      663                   .
      664               end.
      665               else do:
      666                   create temp_found-result-nodelist.
      667                   assign
      668                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
      669                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      670                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      671                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      672                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      673                       temp_found-result-nodelist.processed = no
      674                   .
      675                   if p-terminal-only = no
      676                   then do:
      677                       create temp_fbrglib_found-grp.
      678                       assign
      679                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      680                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
      681                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      682                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
      683                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
      684                           temp_fbrglib_found-grp.is-terminal = no
      685                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
      686                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
      687                       .
      688                   end.
      689               end.
      690           end.
      691           find first temp_found-result-nodelist
      692                where temp_found-result-nodelist.processed = no
      693           no-error.
      694           if not available temp_found-result-nodelist
      695           then do:
      696               leave process-nodes.
      697           end.
      698           else do:
      699               assign
      700                   p-start-node-code = temp_found-result-nodelist.node-code
      701                   v-start-full-name = temp_found-result-nodelist.full-name
      702                   v-start-sort-name = temp_found-result-nodelist.sort-name
      703               .
      704           end.
      705       end.
      706   end.
      707   end procedure.
      708   procedure fbrglib-expand-name :
      709   do
      710   on error undo, return error
      711   :
      712   define input parameter p-obj-type   as character    no-undo.
      713   define input parameter p-obj-code   as integer      no-undo.
      714   define input parameter p-start-name as character    no-undo.
      715   define output parameter p-end-name  as character    no-undo.
      716       define variable v-is-terminal     as logical           no-undo.
      717       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
      718       run fbrglib-find-grp-by-full-name in this-procedure (
      719             input p-obj-type
      720           , input p-obj-code
      721           , input p-start-name
      722           , input no
      723       ) no-error.
      724       run fbrglib-get-max-substring in this-procedure (
      725              input p-obj-type
      726           ,  input p-obj-code
      727           ,  input length( p-start-name )
      728           , output p-end-name
      729       ) no-error .
      730       if error-status :error
      731       then do:
      732           assign
      733               p-end-name = ""
      734           .
      735       end.
      736       else do:
      737           find first temp_fbrglib_found-grp
      738                where temp_fbrglib_found-grp.full-name = p-end-name
      739                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      740                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      741                        no-error.
      742           if available temp_fbrglib_found-grp
      743           then do:
      744               find first buf_temp_fbrglib_found-grp
      745                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
      746                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
      747                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
      748                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      749               no-error.
      750               if not available buf_temp_fbrglib_found-grp
      751               then do:
      752                   run fbrglib-is-terminal in this-procedure (
      753                         input p-obj-type
      754                       , input p-obj-code
      755                       , input temp_fbrglib_found-grp.node-code
      756                       , output v-is-terminal
      757                   ).
      758               end.
      759           end.
      760       end.
      761   end.
      762   end procedure.
      763   procedure fbrglib-get-max-substring :
      764   do
      765   on error undo, return error
      766   :
      767   define input parameter p-obj-type as character no-undo .
      768   define input parameter p-obj-code as integer no-undo .
      769   define input parameter p-min-substring-length   as integer      no-undo.
      770   define output parameter p-substring             as character    no-undo.
      771           define variable v-char-counter  as integer           no-undo.
      772           define variable v-current-char  as character         no-undo.
      773           define variable v-names-counter  as integer           no-undo.
      774           define variable v-base-string   as character         no-undo.
      775           assign
      776               v-char-counter  = p-min-substring-length
      777           .
      778           find first temp_fbrglib_found-grp  where
      779                      temp_fbrglib_found-grp.obj-type  = p-obj-type
      780                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      781           no-error.
      782           if not available temp_fbrglib_found-grp
      783           then do:
      784               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
      785           end.
      786           else do:
      787               assign
      788                   v-base-string = temp_fbrglib_found-grp.full-name
      789               .
      790               counter-block:
      791               do while yes
      792               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
      793               :
      794                   assign
      795                       v-char-counter  = v-char-counter + 1
      796                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      797                       v-names-counter = 0
      798                   .
      799                   compare-block:
      800                   for each temp_fbrglib_found-grp
      801                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
      802                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
      803                   :
      804                       assign
      805                           v-names-counter = v-names-counter + 1
      806                       .
      807                       if v-names-counter = 1
      808                       then do:
      809                           next compare-block.
      810                       end.
      811                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      812                       then do:
      813                           leave counter-block.
      814                       end.
      815                   end.
      816                   if v-names-counter = 1
      817                   then do:
      818                       assign
      819                           p-substring = v-base-string
      820                       .
      821                       return.
      822                   end.
      823               end.
      824               assign
      825                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      826               .
      827           end.
      828   end.
      829   end procedure.
      830   procedure fbrglib-is-terminal :
      831   do
      832   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
      833   :
      834   define input parameter p-obj-type       as character    no-undo.
      835   define input parameter p-obj-code       as integer      no-undo.
      836   define input parameter p-node-code      as integer      no-undo.
      837   define output parameter p-is-terminal   as logical      no-undo.
      838       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      839       find first buf_fbr-gds-grp no-lock
      840            where buf_fbr-gds-grp.obj-type   = p-obj-type
      841              and buf_fbr-gds-grp.obj-code   = p-obj-code
      842              and buf_fbr-gds-grp.upper-code = p-node-code
      843       no-error .
      844       if not available buf_fbr-gds-grp
      845       then do:
      846           assign
      847               p-is-terminal = yes
      848           .
      849       end.
      850       else do:
      851           assign
      852               p-is-terminal = no
      853           .
      854       end.
      855   end.
      856   end procedure.
      857   procedure fbrglib-have-goods :
      858   do
      859   on error undo, return error
      860   :
      861   define input parameter p-obj-type           as character    no-undo.
      862   define input parameter p-obj-code           as integer      no-undo.
      863   define input parameter p-node-code          as integer      no-undo.
      864   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
      865       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
      866       find first buf_fbr-gds-obj no-lock
      867            where buf_fbr-gds-obj.obj-type     = p-obj-type
      868              and buf_fbr-gds-obj.obj-code     = p-obj-code
      869              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
      870       no-error .
      871       if available buf_fbr-gds-obj
      872       then do:
      873           assign
      874               p-have-fbr-gds-obj = yes
      875           .
      876       end.
      877       else do:
      878           assign
      879               p-have-fbr-gds-obj = no
      880           .
      881       end.
      882   end.
      883   end procedure.
      884   procedure fbrglib-find-by-substring :
      885   do
      886   on error undo, return error
      887   :
      888   define input parameter p-start-obj-type     as character    no-undo.
      889   define input parameter p-start-obj-code     as integer      no-undo.
      890   define input parameter p-start-code         as integer      no-undo.
      891   define input parameter p-full-search-string as character    no-undo.
      892   define output parameter p-found-code        as integer      no-undo.
      893   define output parameter p-full-name         as character    no-undo.
      894       define variable v-start-code     as integer           no-undo.
      895       define variable v-found          as logical  init no  no-undo.
      896       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      897       search-grp:
      898       for each buf_fbr-gds-grp no-lock
      899           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
      900             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
      901             and buf_fbr-gds-grp.node-code > p-start-code
      902       :
      903           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
      904           then do:
      905               assign
      906                   p-found-code = buf_fbr-gds-grp.node-code
      907                   v-found      = yes
      908               .
      909               run fbrglib-get-full-name in this-procedure (
      910                     input p-start-obj-type
      911                   , input p-start-obj-code
      912                   , input p-found-code
      913                   , output p-full-name
      914               ) no-error .
      915               if error-status :error
      916               then do:
      917                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      918               end.
      919               leave search-grp.
      920           end.
      921       end.
      922       if v-found = yes
      923       then do:
      924       end.
      925       else do:
      926           assign
      927               p-full-name  = ""
      928               p-found-code = 0
      929           .
      930       end.
      931   end.
      932   end procedure.
      933   procedure fbrglib-analyze-grp-name :
      934   do
      935   on error undo, return error
      936   :
      937   define input parameter p-grp-name       as character            no-undo.
      938   define input parameter p-obj-type       as character            no-undo.
      939   define input parameter p-obj-code       as integer              no-undo.
      940   define input parameter p-upper-code     as integer              no-undo.
      941   define output parameter p-error-message as character init ""    no-undo.
      942       define variable v-char-list     as character    no-undo.
      943       define variable v-char-counter  as integer      no-undo.
      944       define variable v-full-name     as character    no-undo.
      945       if p-grp-name = "" then do:
      946           assign
      947               p-error-message = "Название группы не может быть пустым.".
      948           .
      949       end.
      950       else do:
      951           assign
      952               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      953           .
      954           do v-char-counter = 1 to num-entries( v-char-list )
      955           :
      956               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      957               then do:
      958                   assign
      959                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      960                   .
      961                   return.
      962               end.
      963           end.
      964           run fbrglib-get-full-name in this-procedure (
      965                 input p-obj-type
      966               , input p-obj-code
      967               , input p-upper-code
      968               , output v-full-name
      969           ) no-error .
      970           if error-status :error
      971           then do:
      972               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      973           end.
      974           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
      975           then do:
      976               assign
      977                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
      978               .
      979           end.
      980       end.
      981   end.
      982   end procedure.
      983   procedure fbrglib-delete-grp :
      984   do
      985   on error undo, return error
      986   :
      987   define input parameter p-obj-type   as character    no-undo.
      988   define input parameter p-obj-code   as integer      no-undo.
      989   define input parameter p-node-code  as integer      no-undo.
      990   define output parameter p-deleted   as logical      no-undo.
      991       define variable v-have-goods    as logical        no-undo.
      992       define variable v-yesno         as logical        no-undo.
      993       define variable v-upper-code    as integer        no-undo.
      994       define variable v-root-code     as integer        no-undo.
      995       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
      996       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
      997       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
      998       run fbrglib-get-root-code in this-procedure (
      999           output v-root-code
     1000       ) no-error.
     1001       if error-status :error
     1002       then do:
     1003           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     1004       end.
     1005       if p-node-code = v-root-code
     1006       then do:
     1007           message
     1008               "Корневую группу удалить невозможно."
     1009           view-as alert-box error.
     1010           assign
     1011               p-deleted = no
     1012           .
     1013           undo, return.
     1014       end.
     1015       find first buf_fbr-gds-grp no-lock
     1016            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1017              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1018              and buf_fbr-gds-grp.upper-code   = p-node-code
     1019       no-error.
     1020       if available buf_fbr-gds-grp
     1021       then do:
     1022           message
     1023               "Не терминальную группу удалить невозможно."
     1024           view-as alert-box error.
     1025           assign
     1026               p-deleted = no
     1027           .
     1028           undo, return.
     1029       end.
     1030       find first buf_fbr-gds-grp no-lock
     1031            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1032              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1033              and buf_fbr-gds-grp.node-code    = p-node-code
     1034       .
     1035       assign
     1036           v-upper-code = buf_fbr-gds-grp.upper-code
     1037       .
     1038       run fbrglib-have-goods in this-procedure (
     1039             input p-obj-type
     1040           , input p-obj-code
     1041           , input p-node-code
     1042           , output v-have-goods
     1043       ).
     1044       if v-have-goods = yes
     1045       then do:
     1046           find first buf_second_fbr-gds-grp no-lock
     1047                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     1048                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     1049                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     1050                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     1051           no-error.
     1052           if available buf_second_fbr-gds-grp
     1053           then do:
     1054               message
     1055                   "В группе есть товары,"
     1056                   skip "которые нельзя перенести в родительскую группу,"
     1057                   skip "потому что у родительской группы есть еще одна подгруппа."
     1058                   skip(1)
     1059                   skip "Перенесите товары в другую группу"
     1060                   skip "или удалите все остальные подгруппы родительской группы."
     1061               view-as alert-box error.
     1062               assign
     1063                   p-deleted = no
     1064               .
     1065               undo, return.
     1066           end.
     1067           message
     1068               "В группе есть товары."
     1069               skip "После удаления группы"
     1070               skip "все ее товары будут привязаны"
     1071               skip "к ее родительской группе."
     1072               skip(1)
     1073               skip "Удалить группу?"
     1074           view-as alert-box warning
     1075           buttons yes-no
     1076           title "Удаление группы"
     1077           update v-yesno
     1078           .
     1079           if v-yesno = yes
     1080           then do:
     1081               do transaction
     1082               on error undo, return error
     1083               :
     1084                   for each buf_fbr-gds-obj exclusive-lock
     1085                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     1086                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     1087                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1088                   on error undo, return error
     1089                   :
     1090                       assign
     1091                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     1092                       .
     1093                   end.
     1094               end.
     1095               do transaction
     1096               on error undo, return error
     1097               :
     1098                   find current buf_fbr-gds-grp exclusive-lock .
     1099                   delete buf_fbr-gds-grp no-error .
     1100                   if error-status:error then do:
     1101                     undo, return error return-value .
     1102                   end.
     1103               end.
     1104           end.
     1105       end.
     1106       else do:
     1107           message
     1108               "Имя группы: " buf_fbr-gds-grp.node-name
     1109               "Код группы: " buf_fbr-gds-grp.node-code
     1110               skip(1)
     1111               skip "Удалить группу?"
     1112           view-as alert-box warning
     1113           buttons yes-no
     1114           title "Удаление группы"
     1115           update v-yesno
     1116           .
     1117           if v-yesno = yes
     1118           then do:
     1119               do transaction
     1120               on error undo, return error
     1121               :
     1122                   find current buf_fbr-gds-grp exclusive-lock .
     1123                   delete buf_fbr-gds-grp no-error.
     1124                   if error-status:error then do:
     1125                     undo, return error return-value .
     1126                   end.
     1127               end.
     1128           end.
     1129       end.
     1130   end.
     1131   end procedure.
     1132   procedure fbrglib-add-grp :
     1133   do
     1134   on error undo, return error
     1135   :
     1136   define input parameter p-obj-type       as character    no-undo.
     1137   define input parameter p-obj-code       as integer      no-undo.
     1138   define input parameter p-node-code      as integer      no-undo.
     1139   define input parameter p-interface      as logical      no-undo.
     1140   define input parameter p-node-name      as character    no-undo.
     1141   define input parameter p-out-code       as integer      no-undo.
     1142   define input parameter p-global-code    as integer      no-undo.
     1143   define output parameter p-new-node-code as integer      no-undo.
     1144   define output parameter p-cancel        as logical      no-undo.
     1145       define variable v-have-goods    as logical  no-undo.
     1146       define variable v-host-code     as integer        no-undo.
     1147       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1148       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     1149       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     1150       run fbrglib-have-goods in this-procedure (
     1151             input p-obj-type
     1152           , input p-obj-code
     1153           , input p-node-code
     1154           , output v-have-goods
     1155       ) no-error .
     1156       if error-status :error
     1157       then do:
     1158           message
     1159                    vss-workfile vss-revision vss-description
     1160               skip "Ошибка определения наличия товаров в группе."
     1161               skip return-value
     1162               skip trim(error-status :get-message(1))
     1163                    trim(error-status :get-message(2))
     1164                    trim(error-status :get-message(3))
     1165           view-as alert-box error.
     1166           undo, return error .
     1167       end.
     1168   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1169   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1170     (input  p-obj-type
     1171     ,input  p-obj-code
     1172     ,output v-host-code
     1173     )  .
     1174       find first buf_fbr-gds-grp no-lock where
     1175                 buf_fbr-gds-grp.upper-code = p-node-code
     1176             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1177             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     1178             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     1179       if available buf_fbr-gds-grp then do:
     1180           if p-node-code <> 1 then do:
     1181             find first buf_fbr-gds-grp no-lock where
     1182                       buf_fbr-gds-grp.node-code = p-node-code
     1183                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     1184                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     1185           end.
     1186                   message
     1187           "Для объекта" p-obj-type p-obj-code
     1188           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     1189           view-as alert-box error .
     1190           undo, return error .
     1191       end.
     1192       do transaction
     1193       on error undo, return error
     1194       :
     1195           create buf_fbr-gds-grp.
     1196           assign
     1197               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     1198               p-new-node-code             = buf_fbr-gds-grp.node-code
     1199               buf_fbr-gds-grp.upper-code  = p-node-code
     1200               buf_fbr-gds-grp.host-code   = v-host-code
     1201               buf_fbr-gds-grp.obj-type    = p-obj-type
     1202               buf_fbr-gds-grp.obj-code    = p-obj-code
     1203               buf_fbr-gds-grp.node-name    = ""
     1204               buf_fbr-gds-grp.out-code    = 0
     1205           .
     1206           if p-interface then do:
     1207             run ref/fbrggrpd.w (
     1208                   input parparentproc
     1209                 , input 'ИЗМЕНЕНИЕ':U
     1210                 , input p-obj-type
     1211                 , input p-obj-code
     1212                 , input buf_fbr-gds-grp.node-code
     1213                 , input buf_fbr-gds-grp.upper-code
     1214                 , input buf_fbr-gds-grp.node-name
     1215                 , input buf_fbr-gds-grp.out-code
     1216                 , output buf_fbr-gds-grp.node-name
     1217                 , output buf_fbr-gds-grp.out-code
     1218                 , output p-cancel
     1219             ).
     1220             if p-cancel = yes
     1221             then do:
     1222                 delete buf_fbr-gds-grp.
     1223                 undo, return.
     1224             end.
     1225           end.
     1226           else do:
     1227             find first bf_fbr-gds-grp no-lock
     1228                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     1229                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     1230                   and bf_fbr-gds-grp.out-code   = p-out-code
     1231             no-error.
     1232             assign
     1233             buf_fbr-gds-grp.node-name    = p-node-name
     1234             buf_fbr-gds-grp.global-code  = p-global-code
     1235             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     1236             .
     1237           end.
     1238           if v-have-goods = yes
     1239           then do:
     1240               for each buf_fbr-gds-obj exclusive-lock
     1241                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     1242                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     1243                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     1244               on error undo, return error
     1245               :
     1246                   assign
     1247                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     1248                   .
     1249               end.
     1250           end.
     1251       end.
     1252   end.
     1253   end procedure.
     1254   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1255   define  stream PrnLibStream.
     1256   procedure prn-lib-prn-file :
     1257     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1258     define input parameter p-DIsabledoptions as integer no-undo .
     1259     define variable v-report-name as character no-undo .
     1260     define variable v-user-action as character no-undo .
     1261     define variable v-printed     as logical   no-undo .
     1262     define variable v-exist       as logical   no-undo .
     1263     do
     1264       on error undo, return error
     1265       :
     1266       run prn-lib-get-report-name  in this-procedure (
     1267         input parParentProc
     1268         ,output v-report-name
     1269         ).
     1270   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1272     (input  v-report-name
     1273     ,input  2
     1274     ,output v-exist
     1275     )  .
     1276       if NOT v-exist then
     1277       DO:
     1278         Message
     1279           "Нет заданий на печать ! "
     1280           view-as alert-box .
     1281         Return  .
     1282       End.
     1283       run gbl/prnfilen.w
     1284         (input  ""
     1285         ,input  p-DisabledOptions
     1286         ,input  string(v-report-name )
     1287         ,input  7
     1288         ,output v-user-action
     1289         ,output v-printed
     1290         ) .
     1291       if v-printed then
     1292       do:
     1293         return "YES" .
     1294       end.
     1295       else
     1296       do:
     1297         return "NO" .
     1298       end.
     1299     end.
     1300   end procedure.
     1301   procedure prn-lib-open-stream :
     1302     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1303     define input parameter p-page-size    as integer no-undo .
     1304     define input parameter p-is-stream    as logical no-undo .
     1305     define input parameter p-append       as logical no-undo .
     1306     define variable v-report-name as character no-undo .
     1307     do
     1308       on error undo, return error
     1309       :
     1310       run prn-lib-get-report-name  in this-procedure (
     1311         input parParentProc
     1312         ,output v-report-name
     1313         ).
     1314       if p-is-stream then
     1315       do:
     1316         if p-append then
     1317         do:
     1318           output stream PrnLibStream to value( v-report-name )
     1319             page-size value(p-page-size) append .
     1320         end.
     1321         if not p-append then
     1322         do:
     1323           output stream PrnLibStream to value( v-report-name )
     1324             page-size value(p-page-size) .
     1325         end.
     1326       end.
     1327       if not p-is-stream then
     1328       do:
     1329         if p-append then
     1330         do:
     1331           output to value( v-report-name )
     1332             page-size value(p-page-size) append .
     1333         end.
     1334         if not p-append then
     1335         do:
     1336           output to value( v-report-name )
     1337             page-size value(p-page-size) .
     1338         end.
     1339       end.
     1340     end.
     1341   end procedure.
     1342   procedure prn-lib-open-exp :
     1343     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1344     define input parameter p-is-stream    as logical no-undo .
     1345     define input parameter p-is-append    as logical no-undo .
     1346     define output parameter p-ReportFileName as char init "report" no-undo.
     1347     define output parameter p-process as logical no-undo .
     1348     define variable glog as logical no-undo .
     1349     do
     1350       on error undo, return error
     1351       :
     1352       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1353         TITLE      "Укажите путь"
     1354         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1355         ASK-OVERWRITE
     1356         CREATE-TEST-FILE
     1357         SAVE-AS
     1358         USE-FILENAME
     1359         DEFAULT-EXTENSION "txt"
     1360         UPDATE glog
     1361         .
     1362       if not glog then  return.
     1363       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1364       if p-is-stream then
     1365       do:
     1366         if p-is-append then
     1367         do:
     1368           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1369         end.
     1370         else
     1371         do:
     1372           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1373         end.
     1374       end.
     1375       else
     1376       do:
     1377         if p-is-append then
     1378         do:
     1379           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1380         end.
     1381         else
     1382         do:
     1383           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1384         end.
     1385       end.
     1386       p-process = yes.
     1387     end.
     1388   end procedure.
     1389   procedure prn-lib-get-report-name :
     1390     define input parameter parParentProc  as widget-handle no-undo.
     1391     define output parameter p-report-name as character no-undo .
     1392     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1393   end procedure.
     1394   procedure prn-lib-reportviewer-report-name :
     1395     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1396     define input parameter p-report-name-html as character no-undo .
     1397     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1398   end procedure.
     1399   procedure prn-lib-reportviewer :
     1400     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1401     define input parameter p-report-name-html as character no-undo .
     1402     define input parameter p-param        as character no-undo .
     1403     define variable v-excel           as character no-undo init 'TRUE' .
     1404     define variable v-value-character as character no-undo .
     1405     define variable v-value-integer   as character no-undo .
     1406     define variable v-value-date      as date      no-undo .
     1407     define variable v-value-decimal   as decimal   no-undo .
     1408     define variable rep-excel         as logical   no-undo .
     1409     define variable excel-string      as character no-undo .
     1410     define variable v-param-type      as character no-undo .
     1411     define variable v-tth             as handle    no-undo .
     1412     run adm/shattri.p (
     1413       input "get":U
     1414       ,input  ""
     1415       ,input  0
     1416       ,input  'report-glob':U
     1417       ,input  'rep-excel':U
     1418       ,output v-value-character
     1419       ,output v-value-date
     1420       ,output v-value-decimal
     1421       ,output v-value-integer
     1422       ,output rep-excel
     1423       ,output v-param-type
     1424       ,INPUT-OUTPUT table-handle v-tth
     1425       )  .
     1426     if rep-excel then v-excel = "TRUE" .
     1427     else v-excel = "FALSE" .
     1428     if p-param eq ""
     1429     then
     1430        p-param = "EXCEL:" + v-excel.
     1431     else
     1432        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1433     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1434   end procedure.
     1435   do
     1436   on error undo, return error
     1437   :
     1438   define temp-table temp_goods no-undo
     1439       field gds-code  as integer
     1440       field artic     as character
     1441       field prod-type as character
     1442       field prod-code as integer
     1443       field full-grp-name  as character
     1444       field gds-name  as character
     1445       index pi    is primary unique gds-code
     1446       index apc   is unique artic prod-type prod-code
     1447       index grp full-grp-name
     1448   .
     1449   define variable grp-path    like clients.grp-name  no-undo.
     1450   define variable v-line              as character         no-undo.
     1451   define variable v-status            as character         no-undo.
     1452   define variable v-node-name         as character         no-undo.
     1453   define variable v-start-node-name   as character     no-undo.
     1454   define variable v-is-terminal       as logical       no-undo.
     1455   define variable sym1 as character  init ":"   no-undo.
     1456   define variable sym2 as character  init ":"   no-undo.
     1457   define variable sym3 as character  init ":"   no-undo.
     1458   define variable sym4 as character  init ":"   no-undo.
     1459   define variable i           as integer no-undo .
     1460   define variable v-gds-name  as character      no-undo.
     1461   define variable v-artic     as character      no-undo.
     1462   define buffer buf_start_fbr-gds-grp for fbr-gds-grp.
     1463   define buffer buf_fbr-gds-grp       for fbr-gds-grp.
     1464   define buffer buf_fbr-gds-obj       for fbr-gds-obj.
     1465   define buffer buf_goods             for goods.
     1466   define frame GdsListRpt
     1467       sym1 column-label ":" format "x(1)"
     1468       v-gds-name column-label "Наименование" format "x(50)"
     1469       sym2 column-label ":" format "x(1)"
     1470       v-artic column-label "Артикул" format "x(16)"
     1471       sym3 column-label ":" format "x(1)"
     1472       v-status column-label "Статус" format "x(5)"
     1473       sym4 column-label ":" format "x(1)"
     1474       header
     1475           cur-time-print() at 5 format "X(35)"
     1476           string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>>>9") ) at 54 format "X(17)" skip
     1477           v-line format "X(82)" at 1
     1478   with width 235 down stream-io use-text .
     1479   define frame frmgrp
     1480       v-node-name   format "X(130)"
     1481       with width 160 down stream-io use-text no-labels no-box .
     1482   find first buf_start_fbr-gds-grp no-lock
     1483        where recid( buf_start_fbr-gds-grp ) = p-fbr-gds-grp-recid
     1484   .
     1485   run fbrglib-get-full-name in this-procedure(
     1486         input p-obj-type
     1487       , input p-obj-code
     1488       , input buf_start_fbr-gds-grp.node-code
     1489       , output grp-path
     1490   ).
     1491   if session :set-wait-state( "compiler" ) then.
     1492   run prn-lib-open-stream  in this-procedure (
     1493                                                input parParentProc
     1494                                               ,input 43
     1495                                               ,input yes
     1496                                               ,input no
     1497                                               ).
     1498   assign
     1499       v-line = fill( "-", 82 )
     1500   .
     1501   put stream PrnLibStream space(20) "СПИСОК  ГРУПП  БЛЮД." format "x(30)" skip(1).
     1502   form header
     1503       v-line format "X(82)"
     1504       skip "Продолжение - на следующей странице" at 30
     1505       skip
     1506   with frame GdsBottomframe
     1507   width 235
     1508   page-bottom
     1509   no-labels
     1510   no-box
     1511   .
     1512   run fbrglib-find-all-subgroup in this-procedure (
     1513         input p-obj-type
     1514       , input p-obj-code
     1515       , input buf_start_fbr-gds-grp.node-code
     1516       , input no
     1517   ).
     1518   if p-print-option = "terminal":U
     1519   then do:
     1520       view stream PrnLibStream frame gdsbottomframe .
     1521       run fbrglib-is-terminal in this-procedure (
     1522             input p-obj-type
     1523           , input p-obj-code
     1524           , input buf_start_fbr-gds-grp.node-code
     1525           , output v-is-terminal
     1526       ).
     1527       if v-is-terminal = yes then do:
     1528           put stream PrnLibStream
     1529               space(2) string( "Группа: " + grp-path ) format "X(80)"
     1530               skip
     1531               v-line format "X(82)"
     1532               skip
     1533           .
     1534           view stream PrnLibStream frame GdsListRpt.
     1535           for each buf_fbr-gds-obj no-lock
     1536              where buf_fbr-gds-obj.obj-type       = p-obj-type
     1537                and buf_fbr-gds-obj.obj-code       = p-obj-code
     1538                and buf_fbr-gds-obj.fbr-grp-code   = buf_start_fbr-gds-grp.node-code
     1539           on error undo, return error
     1540           :
     1541               find first buf_goods no-lock
     1542                    where buf_goods.gds-code = buf_fbr-gds-obj.gds-code
     1543               .
     1544               assign
     1545                   v-gds-name = buf_goods.gds-name
     1546                   v-artic    = buf_goods.artic
     1547               .
     1548               display stream PrnLibStream
     1549                   sym1 v-gds-name
     1550                   sym2 v-artic
     1551                   sym3 "УДАЛЕН" when buf_goods.stts <> 0      @ v-status
     1552                   sym4
     1553               with frame GdsListRpt.
     1554               down stream PrnLibStream 1 with frame GdsListRpt .
     1555           end.
     1556           put stream PrnLibStream
     1557               v-line format "X(82)"
     1558               skip
     1559           .
     1560       end.
     1561       for each temp_fbrglib_found-grp
     1562          where temp_fbrglib_found-grp.is-terminal = yes
     1563       :
     1564           down stream PrnLibStream 1 with frame GdsListRpt .
     1565           put stream PrnLibStream
     1566               space(2) string( "Группа: " + temp_fbrglib_found-grp.full-name ) format "X(80)"
     1567               skip
     1568               v-line format "X(82)"
     1569               skip
     1570           .
     1571           for each buf_fbr-gds-obj no-lock
     1572              where buf_fbr-gds-obj.obj-type       = p-obj-type
     1573                and buf_fbr-gds-obj.obj-code       = p-obj-code
     1574                and buf_fbr-gds-obj.fbr-grp-code   = temp_fbrglib_found-grp.node-code
     1575           on error undo, return error
     1576           :
     1577               find first buf_goods no-lock
     1578                    where buf_goods.gds-code = buf_fbr-gds-obj.gds-code
     1579               .
     1580               assign
     1581                   v-gds-name = buf_goods.gds-name
     1582                   v-artic    = buf_goods.artic
     1583               .
     1584               display stream PrnLibStream
     1585                   sym1 v-gds-name
     1586                   sym2 v-artic
     1587                   sym3 "УДАЛЕН" when buf_goods.stts <> 0      @ v-status
     1588                   sym4
     1589               with frame GdsListRpt.
     1590               down stream PrnLibStream 1 with frame GdsListRpt .
     1591           end.
     1592           put stream PrnLibStream
     1593               v-line format "X(82)"
     1594               skip
     1595           .
     1596       end.
     1597       hide stream PrnLibStream frame GdsBottomframe .
     1598       put stream PrnLibStream v-line format "X(82)" skip.
     1599   end.
     1600   else do:
     1601       form with frame frmgrp .
     1602       display stream PrnLibStream
     1603       grp-path @ v-node-name
     1604       with frame frmgrp .
     1605       down stream PrnLibStream 1 with frame frmgrp .
     1606       for each temp_fbrglib_found-grp
     1607       :
     1608           display stream PrnLibStream
     1609               temp_fbrglib_found-grp.full-name     @ v-node-name
     1610           with frame frmgrp .
     1611           down stream PrnLibStream 1 with frame frmgrp .
     1612       end.
     1613       hide stream PrnLibStream frame GdsBottomframe .
     1614   end.
     1615   if session :set-wait-state( "" ) then.
     1616   output stream PrnLibStream close.
     1617   run prn-lib-prn-file in this-procedure (
     1618                                             input parParentProc
     1619                                             ,input 0
     1620                                             ).
     1621   end.
