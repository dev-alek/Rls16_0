     2529   define temp-table tt-goods no-undo like ub.goods.
     2530   define variable v-gds as character no-undo.
     2531   define buffer buf_goods   for ub.goods.
     2532   define buffer buf_cli-gds for ub.cli-gds.
     2533   define variable v-gds-counter   as integer   no-undo.
     2534   define variable v-curr-grp-name as character no-undo .
     2535   define variable v-host-code     like ub.clients.host-code no-undo .
     2536   do on error undo, return error return-value:
     2537      empty temp-table tt-goods.
     2538      case x-SelectGood:
     2539         when 1 then
     2540            do:
     2541               v-gds = 'Все'.
     2542               for each buf_goods no-lock
     2543                  where buf_goods.stts = 0:
     2544                  create tt-goods.
     2545                  buffer-copy buf_goods to tt-goods.
     2546                  v-gds-counter = v-gds-counter + 1.
     2547               end.
     2548            end.
     2549         when 2 then
     2550            do:
     2551               v-gds = 'По группам товаров'.
     2552               for each tmp#grp no-lock:
     2553                  run grplib-get-full-name in this-procedure(input tmp#grp.node-code, output v-curr-grp-name).
     2554                  v-gds = v-gds + ": " + v-curr-grp-name .
     2555                  for each buf_goods no-lock where buf_goods.grp-name begins v-curr-grp-name:
     2556                     find first tt-goods no-lock
     2557                        where tt-goods.artic = buf_goods.artic
     2558                        and tt-goods.prod-type = buf_goods.prod-type
     2559                        and tt-goods.prod-code = buf_goods.prod-code no-error.
     2560                     if not available tt-goods then
     2561                     do:
     2562                        create tt-goods.
     2563                        buffer-copy buf_goods to tt-goods.
     2564                        v-gds-counter = v-gds-counter + 1.
     2565                     end.
     2566                  end.
     2567               end.
     2568            end.
     2569         when 3 then
     2570            do:
     2571               v-gds = 'Производители'.
     2572               for each buf_goods no-lock
     2573                  where buf_goods.stts = 0 ,
     2574                  each buf_cli-gds no-lock
     2575                  where buf_cli-gds.prod-type = buf_goods.prod-type
     2576                  and buf_cli-gds.prod-code = buf_goods.prod-code
     2577                  and buf_cli-gds.artic = buf_goods.artic,
     2578                  first g#cli where g#cli.obj-type = buf_cli-gds.cli-type
     2579                  and g#cli.obj-code = buf_cli-gds.cli-code:
     2580                  find first tt-goods no-lock
     2581                     where tt-goods.prod-type = buf_goods.prod-type
     2582                     and tt-goods.prod-code = buf_goods.prod-code
     2583                     and tt-goods.artic = buf_goods.artic no-error.
     2584                  if not available tt-goods then
     2585                  do:
     2586                     create tt-goods.
     2587                     buffer-copy buf_goods to tt-goods no-error.
     2588                     v-gds-counter = v-gds-counter + 1.
     2589                  end.
     2590               end.
     2591            end.
     2592         when 4 or
     2593         when 5 then
     2594            do:
     2595               v-gds = 'Выборочно'.
     2596               for each gds-list:
     2597                  find first buf_goods no-lock
     2598                     where buf_goods.gds-code = gds-list.gds-code no-error.
     2599                  if available buf_goods then
     2600                  do:
     2601                     create tt-goods.
     2602                     buffer-copy buf_goods to tt-goods.
     2603                     v-gds-counter = v-gds-counter + 1.
     2604                  end.
     2605               end.
     2606            end.
     2607         when 7 then
     2608            do:
     2609               v-gds = 'Группы товаров и Производители'.
     2610               for each tmp#grp no-lock:
     2611                  run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     2612                  for each buf_goods no-lock where buf_goods.grp-name begins v-curr-grp-name:
     2613                     find first tt-goods no-lock
     2614                        where tt-goods.artic = buf_goods.artic
     2615                        and tt-goods.prod-type = buf_goods.prod-type
     2616                        and tt-goods.prod-code = buf_goods.prod-code no-error.
     2617                     if not available tt-goods then
     2618                     do:
     2619                        create tt-goods.
     2620                        buffer-copy buf_goods to tt-goods no-error.
     2621                        v-gds-counter = v-gds-counter + 1.
     2622                     end.
     2623                  end.
     2624               end.
     2625               for each buf_goods no-lock
     2626                  where buf_goods.stts = 0,
     2627                  each buf_cli-gds no-lock
     2628                  where buf_cli-gds.prod-type = buf_goods.prod-type
     2629                  and buf_cli-gds.prod-code = buf_goods.prod-code
     2630                  and buf_cli-gds.artic = buf_goods.artic,
     2631                  first g#cli where g#cli.obj-type = buf_cli-gds.cli-type
     2632                  and g#cli.obj-code = buf_cli-gds.cli-code:
     2633                  find first tt-goods no-lock
     2634                     where tt-goods.prod-type = buf_goods.prod-type
     2635                     and tt-goods.prod-code = buf_goods.prod-code
     2636                     and tt-goods.artic = buf_goods.artic no-error.
     2637                  if not available tt-goods then
     2638                  do:
     2639                     create tt-goods.
     2640                     buffer-copy buf_goods to tt-goods no-error.
     2641                     v-gds-counter = v-gds-counter + 1.
     2642                  end.
     2643               end.
     2644            end.
     2645      end case.
     2646   end.
     2647   FIND FIRST tt-goods no-lock no-error .
     2648   IF NOT AVAILABLE tt-goods THEN
     2649   DO:
     2650      MESSAGE 'Не выбрана группа товаров!' VIEW-AS ALERT-BOX error.
     2651      return error.
     2652   END.
