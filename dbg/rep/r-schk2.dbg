     2754   FOR EACH obj-list  NO-LOCK:
     2755      qnt-vchk  = 0.
     2756      if x-tog-shift then
     2757      do:
     2758         run rep/rpychk0.p ( input "r-shftc2"
     2759            ,input obj-list.obj-type
     2760            ,input obj-list.obj-code
     2761            ,input ?
     2762            ,input ?
     2763            ,input X-date-start
     2764            ,input X-date-end
     2765            ,input X-shift-start
     2766            ,input X-shift-end
     2767            ,input ?
     2768            ).
     2769         FOR EACH ub.chk-doc where ub.chk-doc.obj-code = obj-list.obj-code
     2770            and ub.chk-doc.shift-date >= X-date-Start
     2771            and ub.chk-doc.shift-date <= x-Date-End
     2772            and (ub.chk-doc.chk-type = 1 or ub.chk-doc.chk-type = 6)
     2773            and ub.chk-doc.out-code <> ? NO-LOCK:
     2774            if ub.chk-doc.shift-date = X-date-Start and ub.chk-doc.shift-num < X-Shift-Start then next .
     2775            if ub.chk-doc.shift-date = X-date-End   and ub.chk-doc.shift-num > X-Shift-End then next .
     2776            if ub.chk-doc.chk-type = 1 then qnt-pchk = qnt-pchk + 1 .
     2777            run proc-report .
     2778         end.
     2779      end.
     2780      else
     2781      do:
     2782         run rep/rpychk0.p ( input "r-date"
     2783            ,input obj-list.obj-type
     2784            ,input obj-list.obj-code
     2785            ,input ?
     2786            ,input ?
     2787            ,input X-date-start
     2788            ,input X-date-end
     2789            ,input ?
     2790            ,input ?
     2791            ,input ?
     2792            ).
     2793         FOR EACH chk-doc where chk-doc.obj-code = obj-list.obj-code
     2794            and chk-date >= x-Date-Start
     2795            and chk-date <= x-Date-End
     2796            and (chk-doc.chk-type = 1 or chk-doc.chk-type = 6)
     2797            and chk-doc.out-code <> ? NO-LOCK:
     2798            if ub.chk-doc.chk-type = 1 then qnt-pchk = qnt-pchk + 1 .
     2799            run proc-report .
     2800         end.
     2801      end.
     2802      for each tt-chk-doc where tt-chk-doc.obj-code = obj-list.obj-code and tt-chk-doc.obj-type = obj-list.obj-type:
     2803         if tt-chk-doc.vozvrat then o-qnt-chk = o-qnt-chk + 1 .
     2804         if tt-chk-doc.vozvrat_part then qnt-vcchk-all = qnt-vcchk-all + 1 .
     2805         if tt-chk-doc.vozvrat_part_num then qnt-vcchk-num-all = qnt-vcchk-num-all + 1 .
     2806         if tt-chk-doc.vozvrat_full_num then qnt-vnchk-all = qnt-vnchk-all + 1 .
     2807         if tt-chk-doc.vozvrat_dry then qnt-vchk = qnt-vchk + 1 .
     2808         if tt-chk-doc.vozvrat_full then qnt-vpchk-all = qnt-vpchk-all + 1 .
     2809      end.
     2810      pr-qnt-vp = ( o-qnt-chk / qnt-pchk ) * 100 .
     2811      pr-qnt-co = ((qnt-vcchk-all) / o-qnt-chk ) * 100 .
     2812      pr-qnt-pvov = ((qnt-vnchk-all + qnt-vcchk-num-all + qnt-vpchk-all) / o-qnt-chk ) * 100 .
     2813      pr-qnt-suhob = qnt-vchk / o-qnt-chk * 100 .
     2814      pr-qnt-ostv = ((qnt-vnchk-all + qnt-vcchk-num-all + qnt-vpchk-all + qnt-vchk) / o-qnt-chk) * 100 .
     2815      pr-qnt-ostp = ((qnt-vnchk-all + qnt-vcchk-num-all + qnt-vpchk-all + qnt-vchk) / qnt-pchk) * 100 .
     2816      IF o-qnt-chk > 0 THEN
     2817      DO:
     2818         put stream OutStr-html unformatted
     2819            '<tr>' skip
     2820            '<th><b>Итог по кол-ву:</b></th>'
     2821            '<th>' obj-list.obj-name '</th>' skip
     2822            '<th style="text-align:center;"> Всего чеков возврата: </th>' skip
     2823            '<th style="text-align:center;">' o-qnt-chk  '</th>' skip
     2824            '<th style="text-align:center;"> Всего чеков с частичным возвратом: </th>' skip
     2825            '<th style="text-align:center;">' qnt-vcchk-all '</th>'skip
     2826            '<th style="text-align:center;"> Всего возвратов по номеру чека/полных по транзакции:</th>' skip
     2827            '<th>' qnt-vnchk-all + qnt-vcchk-num-all + qnt-vpchk-all '</th>' skip
     2828            '<th style="text-align:center;"> Всего сухих чеков возврата: </th>' skip
     2829            '<th style="text-align:center;">' qnt-vchk '</th>' skip
     2830            '<td></td> <td></td> <td></td> <td></td> <td></td> <td></td> <td></td> <td></td> <td></td> <td></td> ' skip
     2831            '</tr>' skip
     2832            '<tr>' skip
     2833            '<th><b>Итого по соотношению:</b></th>' skip
     2834            '<th>' obj-list.obj-name '</th>' skip
     2835            '<th style="text-align:center;"> % чеков возврата к общему количеству чеков продажи:</th>' skip
     2836            '<th style="text-align:center;">' pr-qnt-vp '%' '</th>' skip
     2837            '<th> % частичного возврата к общему количеству чеков возврата: </th>' skip
     2838            '<th style="text-align:center;">' pr-qnt-co '%' '</th>' skip
     2839            '<th style="text-align:center;">% остальных чеков  возврата к общему количеству чеков возврата:</th>' skip
     2840            '<th style="text-align:center;">' pr-qnt-ostv '%' '</th>' skip
     2841            '<th>% остальных чеков  возврата к общему количеству чеков продажи: </th>' skip
     2842            '<th style="text-align:center;">' pr-qnt-ostp '%' '</th>' skip
     2843            '<th>% всех возвратов по номеру чека/полных по транзакции к общему кол-ву чеков возврата:</th>' skip
     2844            '<th style="text-align:center;">' pr-qnt-pvov '%' '</th>' skip
     2845            '<th>% всех сухих чеков возврата к общему кол-ву чеков возврата</th>' skip
     2846            '<th style="text-align:center;">' pr-qnt-suhob '%' '</th>' skip
     2847            '<td></td><td></td><td></td><td></td><td></td><td></td>' skip
     2848            '</tr>' skip.
     2849      END.
     2850      assign
     2851         itog-o-qnt-chk         = itog-o-qnt-chk + o-qnt-chk
     2852         itog-qnt-vchk          = itog-qnt-vchk + qnt-vchk
     2853         itog-qnt-vnchk-all     = itog-qnt-vnchk-all + qnt-vnchk-all
     2854         itog-qnt-vcchk-num-all = itog-qnt-vcchk-num-all + qnt-vcchk-num-all
     2855         itog-qnt-vpchk-all     = itog-qnt-vpchk-all + qnt-vpchk-all
     2856         itog-qnt-vcchk-all     = itog-qnt-vcchk-all + qnt-vcchk-all
     2857         itog-o-qnt-pchk        = itog-o-qnt-pchk + o-qnt-pchk
     2858         itog-o-qnt-vchk        = itog-o-qnt-vchk + o-qnt-vchk
     2859         itog-qnt-pchk          = itog-qnt-pchk + qnt-pchk
     2860         .
     2861      assign
     2862         o-qnt-chk         = 0
     2863         qnt-vchk          = 0
     2864         qnt-vnchk-all     = 0
     2865         qnt-vcchk-num-all = 0
     2866         qnt-vpchk-all     = 0
     2867         qnt-vcchk-all     = 0
     2868         o-qnt-pchk        = 0
     2869         o-qnt-vchk        = 0
     2870         qnt-pchk          = 0
     2871         .
     2872   END.
     2873   itog-pr-qnt-vp = ( itog-o-qnt-chk / itog-qnt-pchk ) * 100 .
     2874   itog-pr-qnt-co = ((itog-qnt-vcchk-all) / itog-o-qnt-chk ) * 100 .
     2875   itog-pr-qnt-pvov = ((itog-qnt-vnchk-all + itog-qnt-vcchk-num-all + itog-qnt-vpchk-all) / itog-o-qnt-chk ) * 100 .
     2876   itog-pr-qnt-suhob = itog-qnt-vchk / itog-o-qnt-chk * 100 .
     2877   itog-pr-qnt-ostv = ((itog-qnt-vnchk-all + itog-qnt-vcchk-num-all + itog-qnt-vpchk-all + itog-qnt-vchk) / itog-o-qnt-chk) * 100 .
     2878   itog-pr-qnt-ostp = ((itog-qnt-vnchk-all + itog-qnt-vcchk-num-all + itog-qnt-vpchk-all + itog-qnt-vchk) / itog-qnt-pchk) * 100 .
     2879   IF itog-o-qnt-chk > 0 THEN
     2880   DO:
     2881      put stream OutStr-html unformatted
     2882         '<tr>' skip
     2883         '<th><b>Итог по кол-ву:</b></th>'
     2884         '<th>Все объекты</th>' skip
     2885         '<th style="text-align:center;"> Всего чеков возврата: </th>' skip
     2886         '<th style="text-align:center;">' itog-o-qnt-chk  '</th>' skip
     2887         '<th style="text-align:center;"> Всего чеков с частичным возвратом: </th>' skip
     2888         '<th style="text-align:center;">' itog-qnt-vcchk-all '</th>'skip
     2889         '<th style="text-align:center;"> Всего возвратов по номеру чека/полных по транзакции:</th>' skip
     2890         '<th>' itog-qnt-vnchk-all + itog-qnt-vcchk-num-all + itog-qnt-vpchk-all '</th>' skip
     2891         '<th style="text-align:center;"> Всего сухих чеков возврата: </th>' skip
     2892         '<th style="text-align:center;">' itog-qnt-vchk '</th>' skip
     2893         '<td></td> <td></td> <td></td> <td></td> <td></td> <td></td> <td></td> <td></td> <td></td> <td></td> ' skip
     2894         '</tr>' skip
     2895         '<tr>' skip
     2896         '<th><b>Итого по соотношению:</b></th>' skip
     2897         '<th>Все объекты</th>' skip
     2898         '<th style="text-align:center;"> % чеков возврата к общему количеству чеков продажи:</th>' skip
     2899         '<th style="text-align:center;">' itog-pr-qnt-vp '%' '</th>' skip
     2900         '<th> % частичного возврата к общему количеству чеков возврата: </th>' skip
     2901         '<th style="text-align:center;">' itog-pr-qnt-co '%' '</th>' skip
     2902         '<th style="text-align:center;">% остальных чеков  возврата к общему количеству чеков возврата:</th>' skip
     2903         '<th style="text-align:center;">' itog-pr-qnt-ostv '%' '</th>' skip
     2904         '<th>% остальных чеков  возврата к общему количеству чеков продажи: </th>' skip
     2905         '<th style="text-align:center;">' itog-pr-qnt-ostp '%' '</th>' skip
     2906         '<th>% всех возвратов по номеру чека/полных по транзакции к общему кол-ву чеков возврата:</th>' skip
     2907         '<th style="text-align:center;">' itog-pr-qnt-pvov '%' '</th>' skip
     2908         '<th>% всех сухих чеков возврата к общему кол-ву чеков возврата</th>' skip
     2909         '<th style="text-align:center;">' itog-pr-qnt-suhob '%' '</th>' skip
     2910         '<td></td><td></td><td></td><td></td><td></td><td></td>' skip
     2911         '</tr>' skip.
     2912   END.
     2913   procedure proc-report:
     2914      FOR EACH chk-gds where chk-gds.doc-code = chk-doc.doc-code AND chk-doc.chk-type = 6 NO-LOCK:
     2915         produkt = ''.
     2916         time-chk-chr = ''.
     2917         gds_chk = 0.
     2918         find first bar-code where bar-code.b-code eq chk-gds.b-code no-lock no-error.
     2919         IF AVAILABLE bar-code THEN  gds_chk = bar-code.gds-code.
     2920         find first goods where gds_chk eq goods.gds-code no-lock no-error.
     2921         if not available (goods) then next .
     2922         find first tt-goods where tt-goods.gds-code = goods.gds-code no-error .
     2923         if not available (tt-goods) then next .
     2924         produkt = TRIM(tt-goods.gds-name).
     2925         if p-tog-with-tot-day = no  then kd-tv = string(chk-gds.b-code) .
     2926         if p-tog-with-tot-day = yes then kd-tv = chk-gds.src-code .
     2927         find first person where person.psn-code = chk-doc.cashier-psn-code no-lock no-error.
     2928         IF AVAILABLE person THEN  kassir-chr = person.name1 + ' ' + person.name2 + ' '.
     2929         find first clients where person.psn-code = clients.obj-code and clients.obj-type = 'чел' no-lock no-error.
     2930         IF AVAILABLE clients THEN kassir-chr = kassir-chr + clients.obj-name.
     2931         trnz-chr = "" .
     2932         vozvrtrn = '-' .
     2933         find first chk-doc-attr where chk-doc-attr.attr-code = 'CheckId' and chk-doc-attr.doc-code = chk-doc.doc-code no-lock no-error.
     2934         IF AVAILABLE chk-doc-attr THEN
     2935         DO:
     2936            find first tran-fuel  where  tran-fuel.uuid-cheq eq chk-doc-attr.attr-value no-lock no-error.
     2937            IF AVAILABLE tran-fuel then
     2938            assign
     2939            trnz-chr = string(tran-fuel.tran-num)
     2940            vozvrtrn = '+' .
     2941         END.
     2942         time-chk-chr = string(chk-gds.time-oper, "HH:MM").
     2943         find first tt-chk-doc where tt-chk-doc.doc-code = chk-doc.doc-code no-error .
     2944         if not available (tt-chk-doc) then
     2945         do:
     2946            create tt-chk-doc.
     2947            buffer-copy chk-doc to tt-chk-doc .
     2948         end.
     2949         tt-chk-doc.vozvrat = true .
     2950         IF chk-doc.chk-type = 1 THEN o-qnt-pchk = o-qnt-pchk + 1.
     2951         IF chk-doc.chk-type = 6 THEN o-qnt-vchk = o-qnt-vchk + 1.
     2952         find first chk-doc-attr where chk-doc-attr.doc-code = chk-doc.doc-code
     2953            and chk-doc-attr.attr-code = 'CHFlag1' no-lock no-error.
     2954         IF AVAILABLE chk-doc-attr THEN
     2955         DO:
     2956            suhoi = "-" .
     2957            if chk-doc-attr.attr-value = '0' then vCHFlag1 = 'Свободный возврат' .
     2958            else if chk-doc-attr.attr-value = '1' then vCHFlag1 = 'Частичный возврат' .
     2959               else if chk-doc-attr.attr-value = '2' then vCHFlag1 = 'Полный возврат по номеру чека' .
     2960                  else if chk-doc-attr.attr-value = '3' then vCHFlag1 = 'Частичный возврат по номеру чека'.
     2961                     else if chk-doc-attr.attr-value = '4' then vCHFlag1 = 'возврат полностью не пролитого топлива' .
     2962            if chk-doc-attr.attr-value = '0' then
     2963            do:
     2964               find first tt-chk-doc where tt-chk-doc.doc-code = chk-doc.doc-code no-error .
     2965               if not available (tt-chk-doc) then
     2966               do:
     2967                  create tt-chk-doc.
     2968                  buffer-copy chk-doc to tt-chk-doc .
     2969               end.
     2970               tt-chk-doc.vozvrat_dry = true .
     2971               suhoi = '+'.
     2972            end.
     2973            if chk-doc-attr.attr-value = '1' then
     2974            do:
     2975               find first tt-chk-doc where tt-chk-doc.doc-code = chk-doc.doc-code no-error .
     2976               if not available (tt-chk-doc) then
     2977               do:
     2978                  create tt-chk-doc.
     2979                  buffer-copy chk-doc to tt-chk-doc .
     2980               end.
     2981               tt-chk-doc.vozvrat_part = true .
     2982            end.
     2983            else if chk-doc-attr.attr-value = '2' then
     2984               do:
     2985                  find first tt-chk-doc where tt-chk-doc.doc-code = chk-doc.doc-code no-error .
     2986                  if not available (tt-chk-doc) then
     2987                  do:
     2988                     create tt-chk-doc.
     2989                     buffer-copy chk-doc to tt-chk-doc .
     2990                  end.
     2991                  tt-chk-doc.vozvrat_full_num = true .
     2992               end.
     2993               else if chk-doc-attr.attr-value = '3' then
     2994                  do:
     2995                     find first tt-chk-doc where tt-chk-doc.doc-code = chk-doc.doc-code no-error .
     2996                     if not available (tt-chk-doc) then
     2997                     do:
     2998                        create tt-chk-doc.
     2999                        buffer-copy chk-doc to tt-chk-doc .
     3000                     end.
     3001                     tt-chk-doc.vozvrat_part_num = true .
     3002                  end.
     3003                  else if chk-doc-attr.attr-value = '4' then
     3004                     do:
     3005                        find first tt-chk-doc where tt-chk-doc.doc-code = chk-doc.doc-code no-error .
     3006                        if not available (tt-chk-doc) then
     3007                        do:
     3008                           create tt-chk-doc.
     3009                           buffer-copy chk-doc to tt-chk-doc .
     3010                        end.
     3011                        tt-chk-doc.vozvrat_full = true .
     3012                     end.
     3013         END.
     3014         find first chk-doc-attr where chk-doc-attr.doc-code = chk-doc.doc-code
     3015            and chk-doc-attr.attr-code = 'CHMgrKey' no-lock no-error.
     3016         IF AVAILABLE chk-doc-attr THEN
     3017         DO:
     3018            if chk-doc-attr.attr-value = '0' then vCHMgrKey = '-'.
     3019            else if chk-doc-attr.attr-value = '1' then vCHMgrKey = '+'.
     3020         END.
     3021         opl-chr = ''.
     3022         for EACH  chk-gds-pay where chk-gds-pay.doc-code = chk-gds.doc-code
     3023                                 and chk-gds-pay.line-num = chk-gds.line-num
     3024         no-lock :
     3025            find first cash-pay where cash-pay.cdpay-code = chk-gds-pay.pay-code no-lock no-error.
     3026            IF AVAILABLE cash-pay THEN opl-chr = cash-pay.obj-name.
     3027            put stream OutStr-html unformatted
     3028               '<tr>' skip
     3029               '<td text_wrap="true">' v-host-name       '</td>' skip
     3030               '<td text_wrap="true">' obj-list.obj-name '</td>' skip
     3031               '<td text_wrap="true" style="text-align:center;">' chk-doc.pay-desk   '</td>' skip
     3032               '<td text_wrap="true" style="text-align:center;">' chk-doc.shift-name '</td>' skip
     3033               '<td text_wrap="true" style="text-align:center;">' chk-doc.shift-date '</td>' skip
     3034               '<td text_wrap="true" style="text-align:center;">' chk-doc.chk-num ': ' chk-doc.z-number '</td>' skip
     3035               '<td text_wrap="true" style="text-align:center;">' chk-gds.chk-date '</td>' skip
     3036               '<td text_wrap="true" style="text-align:center;">' string(chk-doc.chk-time, "HH:MM") '</td>' skip
     3037               '<td text_wrap="true">' SUBSTRING(produkt,1,50)   '</td>' skip
     3038               '<td text_wrap="true">' kd-tv   '</td>' skip
     3039               '<td text_wrap="true" style="text-align:center;">' string(ABSOLUTE(chk-gds.doc-qnty),"->>>>>>>>9.99") '</td>' skip
     3040               '<td text_wrap="true" style="text-align:center;">' string(ABSOLUTE(chk-gds.src-sum),"->>>>>>>>9.99")  '</td>' skip
     3041               '<td text_wrap="true" style="text-align:center;">' + string(ABSOLUTE(chk-gds-pay.tot-r-b),"->>>>>>>>9.99") + '</td>' skip
     3042               '<td text_wrap="true">'                            opl-chr    '</td>' skip
     3043               '<td text_wrap="true" style="text-align:center;">' trnz-chr   '</td>' skip
     3044               '<td text_wrap="true" style="text-align:center;">' vozvrtrn   '</td>' skip
     3045               '<td text_wrap="true" style="text-align:center;">' chk-doc.doc-num2   '</td>' skip
     3046               '<td text_wrap="true" style="text-align:center;">' suhoi      '</td>' skip
     3047               '<td text_wrap="true" style="text-align:center;">' vCHMgrKey  '</td>' skip
     3048               '<td text_wrap="true" >'                            kassir-chr '</td>' skip
     3049               '</tr>' skip .
     3050         END.
     3051         opl-sum = ''.
     3052         opl-chr = ''.
     3053      END.
     3054   end.
     3055   put stream OutStr-html unformatted
     3056      substitute (' </tbody></table> </body> </html>  ').
     3057   output stream OutStr-html close.
     3058   run prn-lib-reportviewer in this-procedure (
     3059      input parparentproc
     3060      ,input v-file-name-rep-htm
     3061      ,input ""
     3062      ) no-error.
     3063   if error-status:error then
     3064   do:
     3065      message return-value view-as alert-box.
     3066      return .
     3067   end.
