      991   define variable v-waitfram-action01         as character   no-undo .
      992   define variable v-waitfram-action02         as character   no-undo .
      993   define variable v-waitfram-action03         as character   no-undo .
      994   define variable mWaitFramTextBeg            as character   no-undo.
      995   define variable mWaitFramTextEnd            as character   no-undo.
      996   define variable mWaitFramView               as logical     no-undo.
      997   define variable mWaitProcEvent              as logical     no-undo init yes.
      998   define variable mWaitFramInterval           as integer     no-undo init 1 .
      999   define variable mWaitFramStop               as logical     no-undo.
     1000   define variable mWaitFramStopUser           as logical     no-undo.
     1001   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1002   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1003   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1004   define button B-WaitFramStop auto-end-key
     1005        label "Стоп"
     1006        size 10 by 1 tooltip "Остоновить процесс".
     1007   define button B-viewProcInfo
     1008        label "Информация"
     1009        size 15 by 1 tooltip "Информация о процесс".
     1010   define frame waitfram
     1011     v-waitfram-action01 format "x(72)" no-label skip
     1012     v-waitfram-action02 format "x(72)" no-label skip
     1013     v-waitfram-action03 format "x(72)" no-label skip
     1014     B-viewProcInfo
     1015     B-WaitFramStop at row 4 col 30
     1016     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1017     .
     1018   define new global shared variable mBatchMode as logical no-undo init ?.
     1019   define variable mFramBachModHandle as handle no-undo.
     1020   mFramBachModHandle = frame waitfram:handle.
     1021   define variable mFameOldVis as logical no-undo.
     1022   define variable mVisCUrentVin as logical no-undo.
     1023   if session:batch-mode
     1024   then
     1025      mBatchMode = yes.
     1026   if mBatchMode = ? then do:
     1027     mVisCUrentVin = current-window:visible.
     1028     mFameOldVis = mFramBachModHandle:visible.
     1029     mFramBachModHandle:visible  = yes.
     1030     mBatchMode = mFramBachModHandle:visible ne yes.
     1031     mFramBachModHandle:visible = mFameOldVis.
     1032     current-window:visible = mVisCUrentVin.
     1033   end.
     1034    if  log-manager:logfile-name ne ?
     1035     then DO:
     1036         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1037         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1038         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1039     end.
     1040   on choose of B-WaitFramStop in frame waitfram
     1041   do:
     1042     mWaitFramStop = yes.
     1043     mWaitFramStopUser = yes.
     1044   end.
     1045   function waitfram-check-timeout returns logical():
     1046      define variable vtime as int64 no-undo.
     1047      if mWaitFramStopTimeOut
     1048      then
     1049         return yes.
     1050      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1051      if     mWaitFramTimeOut ne ?
     1052         and mWaitFramTimeOut ne 0
     1053         and mWaitFramTimeOut lt vtime
     1054      then do:
     1055         mWaitFramStopTimeOut = yes.
     1056      end.
     1057      return mWaitFramStopTimeOut.
     1058   end.
     1059   procedure waitfram-hide :
     1060     if not session:batch-mode
     1061     then do
     1062     on error undo, return error return-value
     1063     :
     1064       pause 0 before-hide .
     1065       if not mBatchMode then
     1066         hide frame waitfram .
     1067     if     not mWaitFramView
     1068        and mWaitProcEvent
     1069     then
     1070       process events .
     1071     end.
     1072   end procedure.
     1073   procedure waitfram-show :
     1074     define input  parameter p-message as character no-undo .
     1075     define variable v-left-margin as integer   no-undo .
     1076     if not session:batch-mode
     1077     then do
     1078     on error undo, return error return-value
     1079     :
     1080       if length(p-message) <= 70 then do:
     1081         assign
     1082           v-left-margin = integer((70 - length(p-message)) / 2)
     1083         .
     1084         assign
     1085           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1086         .
     1087         assign
     1088           v-waitfram-action01 = " "
     1089           v-waitfram-action02 = " "
     1090                                    + fill(" ", v-left-margin)
     1091                                    + p-message
     1092           v-waitfram-action03 = " "
     1093         .
     1094       end.
     1095       else do:
     1096         define variable vRindex1 as integer no-undo.
     1097         define variable vRindex2 as integer no-undo.
     1098         vRindex1 = r-index(p-message," ",70).
     1099         if vRindex1 = 0
     1100         then
     1101            vRindex1 = 70.
     1102         if length(p-message)  <= vRindex1 + 70 then do:
     1103           assign
     1104             v-waitfram-action01 = " "
     1105             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1106             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1107           .
     1108         end.
     1109         else do:
     1110           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1111           if vRindex2 <= vRindex1
     1112           then
     1113              vRindex2 = vRindex1 + 70.
     1114           assign
     1115             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1116             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1117             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1118           .
     1119         end.
     1120       end.
     1121       B-viewProcInfo:visible   in frame waitfram = no.
     1122       B-viewProcInfo:sensitive in frame waitfram = no.
     1123       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1124       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1125       if  (   mWaitFramView
     1126          or  mWaitProcEvent)
     1127          and not mBatchMode
     1128       then
     1129          display
     1130             v-waitfram-action01 skip
     1131             v-waitfram-action02 skip
     1132             v-waitfram-action03 skip
     1133          with frame waitfram .
     1134       if     mWaitFramView
     1135          then do:
     1136             if     mWaitFramInterval ne ?
     1137                and not mBatchMode
     1138             then
     1139                wait-for go of frame waitfram pause mWaitFramInterval.
     1140          end.
     1141          else
     1142             if     mWaitProcEvent
     1143                and not mBatchMode
     1144             then
     1145                process events .
     1146     end.
     1147   end procedure.
     1148      procedure waitfram-show-this:
     1149         define input  parameter iInterval as int64 no-undo.
     1150         define variable vtime as int64 no-undo.
     1151         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1152         mWaitFramInterval = iInterval.
     1153         run waitfram-show (substitute("&1&2 &3&4" ,
     1154                                       mWaitFramTextBeg ,
     1155                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1156                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1157                                       mWaitFramTextEnd
     1158                                      )
     1159                           ).
     1160      end.
     1161      procedure WaitFramRunPause:
     1162         define input  parameter iInterval as dec no-undo.
     1163         define variable vStart  as datetime-tz no-undo.
     1164         define variable vend    as datetime-tz no-undo.
     1165         define variable vint as int64 no-undo.
     1166         define variable vOk as logical no-undo.
     1167         vStart = now.
     1168         vend   = vStart.
     1169         publish "WaitFramPause" (iInterval,output vOk).
     1170         vend   =  now.
     1171         vint = vend - vStart.
     1172         vint = iInterval - vint / 1000.
     1173         if     not mWaitFramStop
     1174            and (   vint > 0
     1175                 or (    not vOk
     1176                     and iInterval eq ?
     1177                     )
     1178                 )
     1179         then
     1180            run waitfram-show-this (iInterval).
     1181         vend   =  now.
     1182         vint = vend - vStart.
     1183         vint = iInterval - vint / 1000.
     1184         if     not mWaitFramStop
     1185            and vint > 0
     1186         then do:
     1187            run gbl/pause.p (vint * 1000).
     1188         end.
     1189         if iInterval ne ?
     1190         then
     1191            publish "WaitFramStop".
     1192         waitfram-check-timeout().
     1193      end.
     1194      procedure WaitFramWaitFor:
     1195         define input  parameter iInterval as dec no-undo.
     1196         assign
     1197            mWaitFramStartProc   = now
     1198            mWaitFramStopUser    = no
     1199            mWaitFramStopTimeOut = no
     1200         .
     1201         block-wait:
     1202         do while not mWaitFramStop:
     1203            run WaitFramRunPause (iInterval).
     1204            if  waitfram-check-timeout()
     1205            then do:
     1206               leave block-wait.
     1207            end.
     1208         end.
     1209         run waitfram-hide.
     1210      end.
     1211   procedure waitfram-join :
     1212     define input  parameter p-line-1  as character no-undo .
     1213     define input  parameter p-line-2  as character no-undo .
     1214     define input  parameter p-line-3  as character no-undo .
     1215     define output parameter p-message as character no-undo .
     1216     do
     1217     on error undo, return error return-value
     1218     :
     1219       assign
     1220         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1221                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1222                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1223       .
     1224     end.
     1225   end procedure.
     1226   function waitfram-join-function returns character
     1227     (input p-line-1 as character
     1228     ,input p-line-2 as character
     1229     ,input p-line-3 as character
     1230     ).
     1231     define variable v-message as character no-undo .
     1232     run waitfram-join in this-procedure
     1233       (input  p-line-1
     1234       ,input  p-line-2
     1235       ,input  p-line-3
     1236       ,output v-message
     1237       ) .
     1238     return v-message .
     1239   end function .
     1240   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1241   procedure sys-time_get-sys :
     1242     define output parameter p-year         as integer   no-undo .
     1243     define output parameter p-month        as integer   no-undo .
     1244     define output parameter p-day          as integer   no-undo .
     1245     define output parameter p-hour         as integer   no-undo .
     1246     define output parameter p-minute       as integer   no-undo .
     1247     define output parameter p-second       as integer   no-undo .
     1248     define output parameter p-milliseconds as integer   no-undo .
     1249     define variable v-system-time-structure as memptr    no-undo.
     1250     do
     1251     on error undo, return error return-value
     1252     :
     1253       assign
     1254         set-size(v-system-time-structure) = 16
     1255       .
     1256       run GetSystemTime
     1257         (input  get-pointer-value(v-system-time-structure)
     1258         ) .
     1259       assign
     1260         p-year         = get-short(v-system-time-structure,  1)
     1261         p-month        = get-short(v-system-time-structure,  3)
     1262         p-day          = get-short(v-system-time-structure,  7)
     1263         p-hour         = get-short(v-system-time-structure,  9)
     1264         p-minute       = get-short(v-system-time-structure, 11)
     1265         p-second       = get-short(v-system-time-structure, 13)
     1266         p-milliseconds = get-short(v-system-time-structure, 15)
     1267       .
     1268       assign
     1269         set-size(v-system-time-structure) = 0
     1270       .
     1271     end.
     1272   end procedure.
     1273   procedure sys-time_get-comp-user-name :
     1274     define output parameter p-computer-name as character no-undo .
     1275     define output parameter p-user-name     as character no-undo .
     1276     define output parameter p-process-pid   as integer   no-undo .
     1277     define variable v-return-value  as integer   no-undo .
     1278     define variable v-buffer-length as integer   no-undo .
     1279     define variable v-buffer-memptr as memptr    no-undo .
     1280     do
     1281     on error undo, return error return-value
     1282     :
     1283       assign
     1284         v-buffer-length = 1024
     1285         set-size(v-buffer-memptr) = v-buffer-length + 4
     1286       .
     1287       assign
     1288         put-long(v-buffer-memptr, 1) = v-buffer-length
     1289       .
     1290       run GetComputerNameA
     1291         (input  get-pointer-value(v-buffer-memptr) + 4
     1292         ,input  get-pointer-value(v-buffer-memptr)
     1293         ,output v-return-value
     1294         ) .
     1295       if v-return-value <> 0
     1296       then do:
     1297         assign
     1298           p-computer-name = get-string(v-buffer-memptr, 5)
     1299         .
     1300       end.
     1301       assign
     1302         put-long(v-buffer-memptr, 1) = v-buffer-length
     1303       .
     1304       run GetUserNameA
     1305         (input  get-pointer-value(v-buffer-memptr) + 4
     1306         ,input  get-pointer-value(v-buffer-memptr)
     1307         ,output v-return-value
     1308         ) .
     1309       if v-return-value <> 0
     1310       then do:
     1311         assign
     1312           p-user-name = get-string(v-buffer-memptr, 5)
     1313         .
     1314       end.
     1315       run GetCurrentProcessId
     1316         (output p-process-pid
     1317         ) .
     1318       assign
     1319         set-size(v-buffer-memptr) = 0
     1320       .
     1321     end.
     1322   end procedure.
     1323   procedure sys-time_get-http :
     1324     define output parameter p-http-time as character no-undo .
     1325     define variable v-year         as integer   no-undo .
     1326     define variable v-month        as integer   no-undo .
     1327     define variable v-day-of-week  as integer   no-undo .
     1328     define variable v-day          as integer   no-undo .
     1329     define variable v-hour         as integer   no-undo .
     1330     define variable v-minute       as integer   no-undo .
     1331     define variable v-second       as integer   no-undo .
     1332     define variable v-milliseconds as integer   no-undo .
     1333     do
     1334     on error undo, return error return-value
     1335     :
     1336       run sys-time_get-sys in this-procedure
     1337         (output v-year
     1338         ,output v-month
     1339         ,output v-day
     1340         ,output v-hour
     1341         ,output v-minute
     1342         ,output v-second
     1343         ,output v-milliseconds
     1344         ) .
     1345       assign
     1346         v-day-of-week = weekday(date(v-month, v-day, v-year))
     1347         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
     1348                     + ', ':u
     1349                     + string(v-day, '99':u)
     1350                     + ' ':u
     1351                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
     1352                     + ' ':u
     1353                     + string(v-year, '9999':u)
     1354                     + ' ':u
     1355                     + string(v-hour, '99':u)
     1356                     + ':':u
     1357                     + string(v-minute, '99':u)
     1358                     + ':':u
     1359                     + string(v-second, '99':u)
     1360                     + ' ':u
     1361                     + 'GMT':u
     1362       .
     1363     end.
     1364   end procedure.
     1365   procedure sys-time_set-sys :
     1366     define input  parameter p-year         as integer   no-undo .
     1367     define input  parameter p-month        as integer   no-undo .
     1368     define input  parameter p-day          as integer   no-undo .
     1369     define input  parameter p-hour         as integer   no-undo .
     1370     define input  parameter p-minute       as integer   no-undo .
     1371     define input  parameter p-second       as integer   no-undo .
     1372     define input  parameter p-milliseconds as integer   no-undo .
     1373     define variable v-system-time-structure as memptr    no-undo.
     1374     define variable v-return-value as integer   no-undo .
     1375     define variable v-day-of-week  as integer   no-undo .
     1376     do
     1377     on error undo, return error return-value
     1378     :
     1379       assign
     1380         v-day-of-week = weekday(date(p-month, p-day, p-year))
     1381       .
     1382       assign
     1383         set-size(v-system-time-structure) = 16
     1384       .
     1385       assign
     1386         put-short(v-system-time-structure,  1) = p-year
     1387         put-short(v-system-time-structure,  3) = p-month
     1388         put-short(v-system-time-structure,  5) = v-day-of-week
     1389         put-short(v-system-time-structure,  7) = p-day
     1390         put-short(v-system-time-structure,  9) = p-hour
     1391         put-short(v-system-time-structure, 11) = p-minute
     1392         put-short(v-system-time-structure, 13) = p-second
     1393         put-short(v-system-time-structure, 15) = p-milliseconds
     1394       .
     1395       run SetSystemTime
     1396         (input  get-pointer-value(v-system-time-structure)
     1397         ,output v-return-value
     1398         ) .
     1399       assign
     1400         set-size(v-system-time-structure) = 0
     1401       .
     1402       if v-return-value = 0
     1403       then do:
     1404         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1405       end.
     1406     end.
     1407   end procedure.
     1408   procedure sys-time_sys-to-mjd :
     1409     define input  parameter p-year         as integer   no-undo .
     1410     define input  parameter p-month        as integer   no-undo .
     1411     define input  parameter p-day          as integer   no-undo .
     1412     define input  parameter p-hour         as integer   no-undo .
     1413     define input  parameter p-minute       as integer   no-undo .
     1414     define input  parameter p-second       as integer   no-undo .
     1415     define input  parameter p-milliseconds as integer   no-undo .
     1416     define output parameter p-mjd          as decimal   no-undo .
     1417     define variable v-year-correction as decimal   no-undo .
     1418     define variable v-shift-year as decimal   no-undo .
     1419     do
     1420     on error undo, return error return-value
     1421     :
     1422       assign
     1423         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
     1424         v-shift-year      = decimal(p-year) + v-year-correction
     1425         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
     1426               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
     1427               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
     1428               + decimal(p-day) - 2432076.0
     1429               + p-hour / 24.0
     1430               + p-minute / 1440.0
     1431               + p-second / 86400.0
     1432               + p-milliseconds / 86400000.0
     1433       .
     1434     end.
     1435   end procedure.
     1436   procedure sys-time_sys-to-loc :
     1437     define input  parameter p-sys-year         as integer   no-undo .
     1438     define input  parameter p-sys-month        as integer   no-undo .
     1439     define input  parameter p-sys-day          as integer   no-undo .
     1440     define input  parameter p-sys-hour         as integer   no-undo .
     1441     define input  parameter p-sys-minute       as integer   no-undo .
     1442     define input  parameter p-sys-second       as integer   no-undo .
     1443     define input  parameter p-sys-milliseconds as integer   no-undo .
     1444     define output parameter p-loc-year         as integer   no-undo .
     1445     define output parameter p-loc-month        as integer   no-undo .
     1446     define output parameter p-loc-day          as integer   no-undo .
     1447     define output parameter p-loc-hour         as integer   no-undo .
     1448     define output parameter p-loc-minute       as integer   no-undo .
     1449     define output parameter p-loc-second       as integer   no-undo .
     1450     define output parameter p-loc-milliseconds as integer   no-undo .
     1451     define variable v-system-time-structure as memptr    no-undo.
     1452     define variable v-return-value          as integer   no-undo .
     1453     define variable v-sys-day-of-week       as integer   no-undo .
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457       assign
     1458         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
     1459       .
     1460       assign
     1461         set-size(v-system-time-structure) = 32
     1462       .
     1463       assign
     1464         put-short(v-system-time-structure,  1) = p-sys-year
     1465         put-short(v-system-time-structure,  3) = p-sys-month
     1466         put-short(v-system-time-structure,  5) = v-sys-day-of-week
     1467         put-short(v-system-time-structure,  7) = p-sys-day
     1468         put-short(v-system-time-structure,  9) = p-sys-hour
     1469         put-short(v-system-time-structure, 11) = p-sys-minute
     1470         put-short(v-system-time-structure, 13) = p-sys-second
     1471         put-short(v-system-time-structure, 15) = p-sys-milliseconds
     1472       .
     1473       run SystemTimeToTzSpecificLocalTime
     1474         (input  0
     1475         ,input  get-pointer-value(v-system-time-structure)
     1476         ,input  get-pointer-value(v-system-time-structure) + 16
     1477         ,output v-return-value
     1478         ) .
     1479       assign
     1480         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
     1481         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
     1482         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
     1483         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
     1484         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
     1485         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
     1486         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
     1487       .
     1488       assign
     1489         set-size(v-system-time-structure) = 0
     1490       .
     1491       if v-return-value = 0
     1492       then do:
     1493         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1494       end.
     1495     end.
     1496   end procedure.
     1497   procedure sys-time_mjd-to-sys :
     1498     define input  parameter p-mjd          as decimal   no-undo .
     1499     define output parameter p-year         as integer   no-undo .
     1500     define output parameter p-month        as integer   no-undo .
     1501     define output parameter p-day          as integer   no-undo .
     1502     define output parameter p-hour         as integer   no-undo .
     1503     define output parameter p-minute       as integer   no-undo .
     1504     define output parameter p-second       as integer   no-undo .
     1505     define output parameter p-milliseconds as integer   no-undo .
     1506     define variable v-year-correction as decimal   no-undo .
     1507     define variable v-shift-year      as decimal   no-undo .
     1508     define variable v-conv-date     as date      no-undo .
     1509     define variable v-int-part      as integer   no-undo .
     1510     define variable v-fraction-part as decimal   no-undo .
     1511     do
     1512     on error undo, return error return-value
     1513     :
     1514       assign
     1515         v-int-part      = integer(truncate(p-mjd, 0))
     1516         v-fraction-part = p-mjd - v-int-part
     1517         v-conv-date     = date(11, 17, 1858) + v-int-part
     1518         p-year          = year(v-conv-date)
     1519         p-month         = month(v-conv-date)
     1520         p-day           = day(v-conv-date)
     1521         v-fraction-part = v-fraction-part * 24.0
     1522         p-hour          = integer(truncate(v-fraction-part, 0))
     1523         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     1524         p-minute        = integer(truncate(v-fraction-part, 0))
     1525         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     1526         p-second        = integer(truncate(v-fraction-part, 0))
     1527         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     1528         p-milliseconds  = integer(v-fraction-part)
     1529       .
     1530     end.
     1531   end procedure.
     1532   procedure sys-time_mjd-to-loc :
     1533     define input  parameter p-mjd              as decimal   no-undo .
     1534     define output parameter p-loc-year         as integer   no-undo .
     1535     define output parameter p-loc-month        as integer   no-undo .
     1536     define output parameter p-loc-day          as integer   no-undo .
     1537     define output parameter p-loc-hour         as integer   no-undo .
     1538     define output parameter p-loc-minute       as integer   no-undo .
     1539     define output parameter p-loc-second       as integer   no-undo .
     1540     define output parameter p-loc-milliseconds as integer   no-undo .
     1541     define variable v-sys-year         as integer   no-undo .
     1542     define variable v-sys-month        as integer   no-undo .
     1543     define variable v-sys-day          as integer   no-undo .
     1544     define variable v-sys-hour         as integer   no-undo .
     1545     define variable v-sys-minute       as integer   no-undo .
     1546     define variable v-sys-second       as integer   no-undo .
     1547     define variable v-sys-milliseconds as integer   no-undo .
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551       run sys-time_mjd-to-sys
     1552         (input  p-mjd
     1553         ,output v-sys-year
     1554         ,output v-sys-month
     1555         ,output v-sys-day
     1556         ,output v-sys-hour
     1557         ,output v-sys-minute
     1558         ,output v-sys-second
     1559         ,output v-sys-milliseconds
     1560         ) .
     1561       run sys-time_sys-to-loc
     1562         (input  v-sys-year
     1563         ,input  v-sys-month
     1564         ,input  v-sys-day
     1565         ,input  v-sys-hour
     1566         ,input  v-sys-minute
     1567         ,input  v-sys-second
     1568         ,input  v-sys-milliseconds
     1569         ,output p-loc-year
     1570         ,output p-loc-month
     1571         ,output p-loc-day
     1572         ,output p-loc-hour
     1573         ,output p-loc-minute
     1574         ,output p-loc-second
     1575         ,output p-loc-milliseconds
     1576         ) .
     1577     end.
     1578   end procedure.
     1579   function sys-time_get-mjd-func returns decimal
     1580   :
     1581     define variable v-year         as integer   no-undo .
     1582     define variable v-month        as integer   no-undo .
     1583     define variable v-day          as integer   no-undo .
     1584     define variable v-hour         as integer   no-undo .
     1585     define variable v-minute       as integer   no-undo .
     1586     define variable v-second       as integer   no-undo .
     1587     define variable v-milliseconds as integer   no-undo .
     1588     define variable v-mjd          as decimal   no-undo .
     1589     run sys-time_get-sys in this-procedure
     1590       (output v-year
     1591       ,output v-month
     1592       ,output v-day
     1593       ,output v-hour
     1594       ,output v-minute
     1595       ,output v-second
     1596       ,output v-milliseconds
     1597       ) .
     1598     run sys-time_sys-to-mjd in this-procedure
     1599       (input  v-year
     1600       ,input  v-month
     1601       ,input  v-day
     1602       ,input  v-hour
     1603       ,input  v-minute
     1604       ,input  v-second
     1605       ,input  v-milliseconds
     1606       ,output v-mjd
     1607       ) .
     1608     return v-mjd .
     1609   end function .
     1610   function sys-time_get-sys-str-func returns character
     1611   :
     1612     define variable v-utc-time as character no-undo .
     1613     define variable v-year         as integer   no-undo .
     1614     define variable v-month        as integer   no-undo .
     1615     define variable v-day          as integer   no-undo .
     1616     define variable v-hour         as integer   no-undo .
     1617     define variable v-minute       as integer   no-undo .
     1618     define variable v-second       as integer   no-undo .
     1619     define variable v-milliseconds as integer   no-undo .
     1620     run sys-time_get-sys in this-procedure
     1621       (output v-year
     1622       ,output v-month
     1623       ,output v-day
     1624       ,output v-hour
     1625       ,output v-minute
     1626       ,output v-second
     1627       ,output v-milliseconds
     1628       ) .
     1629     assign
     1630       v-utc-time  = 'UTC ':u
     1631                   + string(v-year,         '9999':u)
     1632                   + '/':u
     1633                   + string(v-month,        '99':u)
     1634                   + '/':u
     1635                   + string(v-day,          '99':u)
     1636                   + ' ':u
     1637                   + string(v-hour,         '99':u)
     1638                   + ':':u
     1639                   + string(v-minute,       '99':u)
     1640                   + ':':u
     1641                   + string(v-second,       '99':u)
     1642                   + ' ':u
     1643                   + string(v-milliseconds, '999':u)
     1644     .
     1645     return v-utc-time.
     1646   end function .
     1647   function sys-time_mjd-to-loc-str-func returns character
     1648     (v-sys-mjd as decimal)
     1649   :
     1650     define variable v-loc-str          as character no-undo .
     1651     define variable v-loc-year         as integer   no-undo .
     1652     define variable v-loc-month        as integer   no-undo .
     1653     define variable v-loc-day          as integer   no-undo .
     1654     define variable v-loc-hour         as integer   no-undo .
     1655     define variable v-loc-minute       as integer   no-undo .
     1656     define variable v-loc-second       as integer   no-undo .
     1657     define variable v-loc-milliseconds as integer   no-undo .
     1658     run sys-time_mjd-to-loc in this-procedure
     1659       (input  v-sys-mjd
     1660       ,output v-loc-year
     1661       ,output v-loc-month
     1662       ,output v-loc-day
     1663       ,output v-loc-hour
     1664       ,output v-loc-minute
     1665       ,output v-loc-second
     1666       ,output v-loc-milliseconds
     1667       ) .
     1668     assign
     1669       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1670                             ,string(v-loc-day,    '99':U)
     1671                             ,string(v-loc-month,  '99':U)
     1672                             ,string(v-loc-year,   '9999':U)
     1673                             ,string(v-loc-hour,   '99':U)
     1674                             ,string(v-loc-minute, '99':U)
     1675                             )
     1676     .
     1677     return v-loc-str .
     1678   end function .
