     2317   define variable vss-include-info15 as character format "X(65)" no-undo
     2318   initial "@(#)$Workfile$ $Revision$".
     2319   procedure grplib-get-full-name :
     2320      define input parameter p-node-code  as integer      no-undo.
     2321      define output parameter p-full-name as character    no-undo.
     2322      do
     2323   on error undo, return error
     2324   :
     2325       define variable v-upper-code    as integer           no-undo.
     2326       define buffer buf_gds-grp       for ub.gds-grp.
     2327       define buffer buf_upper_gds-grp for ub.gds-grp.
     2328       find first buf_gds-grp no-lock
     2329            where buf_gds-grp.node-code = p-node-code
     2330       no-error.
     2331       if not available buf_gds-grp
     2332       then do:
     2333           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2334       end.
     2335       assign
     2336           p-full-name  = ""
     2337           v-upper-code = 1
     2338       .
     2339       do while buf_gds-grp.upper-code <> 0
     2340       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2341       :
     2342           assign
     2343               p-full-name  = buf_gds-grp.node-name
     2344                            + (if p-full-name <> "" then chr(47) else "")
     2345                            + p-full-name
     2346               v-upper-code = buf_gds-grp.upper-code
     2347           .
     2348           find first buf_gds-grp no-lock
     2349                where buf_gds-grp.node-code = v-upper-code
     2350           no-error.
     2351           if not available buf_gds-grp
     2352           then do:
     2353               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2354                                   + string( v-upper-code )
     2355                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2356           end.
     2357       end.
     2358       assign
     2359       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2360       .
     2361   end.
     2362   end .
     2363   procedure grplib-get-node-from-full-name :
     2364   define input parameter p-full-name as character no-undo .
     2365   define output parameter p-node-code as integer no-undo .
     2366   define variable v-ii as integer no-undo .
     2367   define variable v-upper-code as integer no-undo .
     2368   define variable v-root-code as integer no-undo .
     2369   define variable v-entry as character no-undo .
     2370   define buffer buf_gds-grp       for ub.gds-grp.
     2371   do
     2372   on error undo, return error
     2373   :
     2374     find first buf_gds-grp no-lock
     2375         where buf_gds-grp.upper-code = 0
     2376     no-error .
     2377     if not available buf_gds-grp
     2378     then do:
     2379         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2380     end.
     2381     else do:
     2382       assign
     2383       v-root-code = buf_gds-grp.node-code
     2384       .
     2385     end.
     2386     v-upper-code = v-root-code.
     2387     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2388       assign
     2389       v-entry = entry(v-ii, p-full-name, chr(47)).
     2390       if v-entry = '' then leave.
     2391       find first buf_gds-grp no-lock where
     2392                 buf_gds-grp.node-name = v-entry
     2393             and buf_gds-grp.upper-code = v-upper-code
     2394             no-error.
     2395       if not available buf_gds-grp then do:
     2396         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2397       end.
     2398       else do:
     2399         p-node-code = buf_gds-grp.node-code.
     2400         v-upper-code = buf_gds-grp.node-code.
     2401       end.
     2402     end.
     2403   end.
     2404   end .
