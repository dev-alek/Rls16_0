      712   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   procedure wthcattr-sprcli :
      714   define input parameter parparentproc  as widget-handle no-undo.
      715   define input parameter p-mode  as character no-undo.
      716   define input-output parameter p-value as character no-undo .
      717   define output parameter p-setted as logical no-undo .
      718     DEFINE VARIABLE v-value as character no-undo .
      719     define variable v-cli-type as character no-undo .
      720     define variable v-cli-code as integer no-undo .
      721     define buffer buf_clients   for ub.clients.
      722     define variable v_rid as character no-undo.
      723     define variable ref-rec as recid no-undo .
      724     do
      725     on error undo, return error
      726     :
      727         v-value = p-value.
      728      if p-value <> '':U then do:
      729       assign
      730       v-cli-type = substring(p-value, 1, 3)
      731       v-cli-code = integer(substring(p-value, 4))
      732       no-error.
      733       if error-status:error then do:
      734         assign
      735         v-cli-type = '':U
      736         v-cli-code = 0
      737         .
      738       end.
      739      end.
      740      FIND FIRST buf_clients NO-LOCK WHERE
      741               buf_clients.obj-type = v-cli-type AND
      742               buf_clients.obj-code = v-cli-code  NO-ERROR.
      743      IF available(buf_clients) then do:
      744       run ref/cli-all.w (
      745                   input parparentproc
      746                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      747                  ,input v-cli-type
      748                  ,input 'все':U
      749                  ,input 'все':U
      750                  ,input RECID( buf_clients )
      751                  ,input ",,,,,,NO"
      752                  ,input ?
      753                  ,OUTPUT v_rid ).
      754     END.
      755     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      756       run ref/cli-all.w (
      757                    input parparentproc
      758                   ,INPUT "b-sel":U
      759                  ,input  v-cli-type
      760                  ,input 'все':U
      761                  ,input 'текущие':U
      762                  ,input ?
      763                  ,input ",,,,,,NO"
      764                  ,input ?
      765                  ,OUTPUT v_rid ).
      766     END.
      767     else do:
      768       message
      769       if p-value = "":U then 'Атрибут не задан!'
      770       else substitute('Не найден клиент &1',p-value)
      771       view-as alert-box warning.
      772     end.
      773     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      774       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      775       IF ERROR-STATUS:ERROR THEN DO:
      776           RETURN NO-APPLY.
      777       END.
      778       FIND FIRST buf_clients NO-LOCK WHERE
      779                  RECID( buf_clients ) = ref-rec NO-ERROR.
      780       IF AVAIL buf_clients THEN DO:
      781         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      782       end.
      783     end.
      784     if v-value <> p-value then do:
      785       p-value = v-value.
      786       p-setted = yes.
      787     end.
      788     end.
      789   end procedure.
      790     define new global shared variable g#wthcalib as handle no-undo.
      791   procedure torgconf-read :
      792   do
      793   on error undo, return error
      794   :
      795       define input parameter p-form-name  as character    no-undo.
      796       define input parameter p-host-code  as integer      no-undo.
      797       define input parameter p-obj-type   as character    no-undo.
      798       define input parameter p-obj-code   as integer      no-undo.
      799       define variable v-outdate   as character     no-undo.
      800       define variable v-outares   as character     no-undo.
      801       define variable v-outsend   as character     no-undo.
      802       define variable v-outasend  as character     no-undo.
      803       define variable v-outprops  as character     no-undo.
      804       define variable v-outnum    as character     no-undo.
      805       define variable v-outprim   as character     no-undo.
      806       define variable v-outdisc   as character     no-undo.
      807       define variable v-outsubs   as character     no-undo.
      808       define variable v-outrecv   as character     no-undo.
      809       define variable v-outegrp   as character     no-undo.
      810       define variable v-outt12    as character     no-undo.
      811       define variable v-outappr   as character     no-undo.
      812       define variable v-outrubl   as character     no-undo.
      813       define variable v-outhold   as character     no-undo.
      814       define variable v-outobj    as character     no-undo.
      815       define variable v-outexlst  as character     no-undo.
      816       define variable v-outprncd  as character     no-undo.
      817       define variable v-par-type  as character     no-undo.
      818       define variable v-outogr    as character     no-undo.
      819       define variable v-outR      as character     no-undo.
      820       define variable v-outB      as character     no-undo.
      821       define variable v-outC      as character     no-undo.
      822       assign
      823           v-torgconf-outdate  = no
      824           v-torgconf-outnum   = no
      825           v-torgconf-outprim  = no
      826           v-torgconf-outdisc  = no
      827           v-torgconf-outsubs  = no
      828           v-torgconf-outrecv  = no
      829           v-torgconf-outegrp  = no
      830           v-torgconf-outt12   = no
      831           v-torgconf-outappr  = no
      832           v-torgconf-outrubl  = no
      833           v-torgconf-outhold  = no
      834           v-torgconf-outobj   = no
      835           v-torgconf-outexlst = no
      836           v-torgconf-outexpas = "":U
      837           v-torgconf-outprncd = yes
      838           v-torgconf-outares  = no
      839           v-torgconf-outsend  = no
      840           v-torgconf-outasend  = no
      841           v-torgconf-outprops  = no
      842           v-form-name          = p-form-name
      843       .
      844   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   empty temp-table thbjattr_thbj-attr.
      846   run adm/shattri.p (
      847      input "get":U
      848     ,input ''
      849     ,input 0
      850     ,input 'prt-glob':U
      851     ,input  ""
      852     ,output v-value-character
      853     ,output v-value-date
      854     ,output v-value-decimal
      855     ,output v-value-integer
      856     ,output v-value-logical
      857     ,output par-type
      858     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      859     ) no-error .
      860   for each thbjattr_thbj-attr :
      861       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
      862       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
      863       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
      864   end.
      865   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   empty temp-table thbjattr_thbj-attr.
      867   run adm/shattri.p (
      868      input "get":U
      869     ,input p-obj-type
      870     ,input p-obj-code
      871     ,input 'prt-obj':U
      872     ,input  ""
      873     ,output v-value-character
      874     ,output v-value-date
      875     ,output v-value-decimal
      876     ,output v-value-integer
      877     ,output v-value-logical
      878     ,output par-type
      879     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      880     ) no-error .
      881   for each thbjattr_thbj-attr :
      882       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
      883       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
      884       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
      885       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
      886       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
      887       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
      888       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
