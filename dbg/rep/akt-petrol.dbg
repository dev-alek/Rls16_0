     5383       '<TD style="text-align: center;">2</TD>' skip
     5384       '<TD style="text-align: center;">3</TD>' skip
     5385       '<TD style="text-align: center;">4</TD>' skip
     5386       '<TD colspan="2" style="text-align: center;">14</TD>' skip
     5387       '<TD colspan="3" style="text-align: center;">15</TD>' skip
     5388       '<TD style="text-align: center;">16</TD>' skip
