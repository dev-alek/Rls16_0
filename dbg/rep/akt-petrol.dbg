     4182   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4183   define  stream PrnLibStream.
     4184   procedure prn-lib-prn-file :
     4185     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4186     define input parameter p-DIsabledoptions as integer no-undo .
     4187     define variable v-report-name as character no-undo .
     4188     define variable v-user-action as character no-undo .
     4189     define variable v-printed     as logical   no-undo .
     4190     define variable v-exist       as logical   no-undo .
     4191     do
     4192       on error undo, return error
     4193       :
     4194       run prn-lib-get-report-name  in this-procedure (
     4195         input parParentProc
     4196         ,output v-report-name
     4197         ).
     4198   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     4200     (input  v-report-name
     4201     ,input  2
     4202     ,output v-exist
     4203     )  .
     4204       if NOT v-exist then
     4205       DO:
     4206         Message
     4207           "Нет заданий на печать ! "
     4208           view-as alert-box .
     4209         Return  .
     4210       End.
     4211       run gbl/prnfilen.w
     4212         (input  ""
     4213         ,input  p-DisabledOptions
     4214         ,input  string(v-report-name )
     4215         ,input  7
     4216         ,output v-user-action
     4217         ,output v-printed
     4218         ) .
     4219       if v-printed then
     4220       do:
     4221         return "YES" .
     4222       end.
     4223       else
     4224       do:
     4225         return "NO" .
     4226       end.
     4227     end.
     4228   end procedure.
     4229   procedure prn-lib-open-stream :
     4230     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4231     define input parameter p-page-size    as integer no-undo .
     4232     define input parameter p-is-stream    as logical no-undo .
     4233     define input parameter p-append       as logical no-undo .
     4234     define variable v-report-name as character no-undo .
     4235     do
     4236       on error undo, return error
     4237       :
     4238       run prn-lib-get-report-name  in this-procedure (
     4239         input parParentProc
     4240         ,output v-report-name
     4241         ).
     4242       if p-is-stream then
     4243       do:
     4244         if p-append then
     4245         do:
     4246           output stream PrnLibStream to value( v-report-name )
     4247             page-size value(p-page-size) append .
     4248         end.
     4249         if not p-append then
     4250         do:
     4251           output stream PrnLibStream to value( v-report-name )
     4252             page-size value(p-page-size) .
     4253         end.
     4254       end.
     4255       if not p-is-stream then
     4256       do:
     4257         if p-append then
     4258         do:
     4259           output to value( v-report-name )
     4260             page-size value(p-page-size) append .
     4261         end.
     4262         if not p-append then
     4263         do:
     4264           output to value( v-report-name )
     4265             page-size value(p-page-size) .
     4266         end.
     4267       end.
     4268     end.
     4269   end procedure.
     4270   procedure prn-lib-open-exp :
     4271     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4272     define input parameter p-is-stream    as logical no-undo .
     4273     define input parameter p-is-append    as logical no-undo .
     4274     define output parameter p-ReportFileName as char init "report" no-undo.
     4275     define output parameter p-process as logical no-undo .
     4276     define variable glog as logical no-undo .
     4277     do
     4278       on error undo, return error
     4279       :
     4280       SYSTEM-DIALOG GET-FILE p-ReportFileName
     4281         TITLE      "Укажите путь"
     4282         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     4283         ASK-OVERWRITE
     4284         CREATE-TEST-FILE
     4285         SAVE-AS
     4286         USE-FILENAME
     4287         DEFAULT-EXTENSION "txt"
     4288         UPDATE glog
     4289         .
     4290       if not glog then  return.
     4291       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     4292       if p-is-stream then
     4293       do:
     4294         if p-is-append then
     4295         do:
     4296           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4297         end.
     4298         else
     4299         do:
     4300           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4301         end.
     4302       end.
     4303       else
     4304       do:
     4305         if p-is-append then
     4306         do:
     4307           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4308         end.
     4309         else
     4310         do:
     4311           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4312         end.
     4313       end.
     4314       p-process = yes.
     4315     end.
     4316   end procedure.
     4317   procedure prn-lib-get-report-name :
     4318     define input parameter parParentProc  as widget-handle no-undo.
     4319     define output parameter p-report-name as character no-undo .
     4320     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     4321   end procedure.
     4322   procedure prn-lib-reportviewer-report-name :
     4323     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4324     define input parameter p-report-name-html as character no-undo .
     4325     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     4326   end procedure.
     4327   procedure prn-lib-reportviewer :
     4328     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4329     define input parameter p-report-name-html as character no-undo .
     4330     define input parameter p-param        as character no-undo .
     4331     define variable v-excel           as character no-undo init 'TRUE' .
     4332     define variable v-value-character as character no-undo .
     4333     define variable v-value-integer   as character no-undo .
     4334     define variable v-value-date      as date      no-undo .
     4335     define variable v-value-decimal   as decimal   no-undo .
     4336     define variable rep-excel         as logical   no-undo .
     4337     define variable excel-string      as character no-undo .
     4338     define variable v-param-type      as character no-undo .
     4339     define variable v-tth             as handle    no-undo .
     4340     run adm/shattri.p (
     4341       input "get":U
     4342       ,input  ""
     4343       ,input  0
     4344       ,input  'report-glob':U
     4345       ,input  'rep-excel':U
     4346       ,output v-value-character
     4347       ,output v-value-date
     4348       ,output v-value-decimal
     4349       ,output v-value-integer
     4350       ,output rep-excel
     4351       ,output v-param-type
     4352       ,INPUT-OUTPUT table-handle v-tth
     4353       )  .
     4354     if rep-excel then v-excel = "TRUE" .
     4355     else v-excel = "FALSE" .
     4356     if p-param eq ""
     4357     then
     4358        p-param = "EXCEL:" + v-excel.
     4359     else
     4360        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     4361     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     4362   end procedure.
     4363   function fnc-convert-dot-to-colon returns character
     4364       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     4365   function fnc-convert-dot-to-colon returns character
     4366   (input p-data as decimal, input p-accur as character, input p-num as integer):
     4367       define variable result as character no-undo.
     4368       define variable v-str-result as character no-undo.
     4369       if p-data = ? then p-data = 0 .
     4370       p-data = round(p-data, p-num).
     4371       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     4372       return v-str-result.
     4373   END FUNCTION.
     4374   procedure placelib_write-attr:
     4375   define input  parameter p-code     like ub.place-attr.attr-code .
     4376   define input  parameter p-obj-code like ub.place-attr.obj-code .
     4377   define input  parameter p-obj-type like ub.place-attr.obj-type .
     4378   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     4379   define input  parameter p-value    like ub.place-attr.attr-value .
     4380   define output parameter p-ok       as logical.
     4381   define buffer buf_place-attr for ub.place-attr .
     4382     do on error undo, return error return-value :
     4383        p-ok = false.
     4384        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     4385                                                   and buf_place-attr.obj-code    = p-obj-code
     4386                                                   and buf_place-attr.obj-type    = p-obj-type
     4387                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     4388        if not available buf_place-attr then do :
     4389           create buf_place-attr.
     4390           assign
     4391             buf_place-attr.attr-code   = p-code
     4392             buf_place-attr.attr-value  = p-value
     4393             buf_place-attr.obj-code    = p-obj-code
     4394             buf_place-attr.obj-type    = p-obj-type
     4395             buf_place-attr.pl-code     = p-pl-code
     4396           .
     4397           p-ok = true.
     4398        end.
     4399        else do:
     4400           buf_place-attr.attr-value  = p-value .
     4401           p-ok = true.
     4402        end.
     4403     end.
     4404   end.
     4405   procedure placelib_get-attr:
     4406   define input  parameter  p-code     like ub.place-attr.attr-code .
     4407   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     4408   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     4409   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     4410   define output parameter  p-value    like ub.place-attr.attr-value .
     4411   define output parameter  p-ok       as logical.
     4412   define buffer buf_place-attr for ub.place-attr .
     4413     do on error undo, return error return-value :
     4414        p-ok = false.
     4415        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     4416                                                   and buf_place-attr.obj-code    = p-obj-code
     4417                                                   and buf_place-attr.obj-type    = p-obj-type
     4418                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     4419        if available buf_place-attr then do :
     4420          p-value = buf_place-attr.attr-value.
     4421          p-ok = true.
     4422        end.
     4423        else do :
     4424          p-ok = false.
     4425        end.
     4426     end.
     4427   end.
     4428   procedure placelib_del-attr:
     4429   define input parameter  p-code     like ub.place-attr.attr-code .
     4430   define input parameter  p-obj-code like ub.place-attr.obj-code .
     4431   define input parameter  p-obj-type like ub.place-attr.obj-type .
     4432   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     4433   define input parameter  p-value    like ub.place-attr.attr-value .
     4434   define output parameter p-ok       as logical.
     4435   define buffer buf_place-attr for ub.place-attr .
     4436     do on error undo, return error return-value :
     4437        p-ok = false.
     4438        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     4439                                                   and buf_place-attr.obj-code    = p-obj-code
     4440                                                   and buf_place-attr.obj-type    = p-obj-type
     4441                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     4442        if available buf_place-attr then do :
     4443           delete buf_place-attr.
     4444           p-ok = true.
     4445        end.
     4446     end.
     4447   end.
     4448   define variable is-petrolium         as logical   no-undo.
     4449   define variable is-pieces            as logical   no-undo.
     4450   define variable v-doc-code           like ub.trn-doc.doc-code no-undo .
     4451   define variable v-gds-code           like ub.goods.gds-code no-undo .
     4452   define variable v-fio                as character no-undo .
     4453   define variable v-InfoSectionsTotal  as class     InfoSectionsTotal no-undo .
     4454   define variable v-InfoSection        as class     InfoSection       no-undo .
     4455   define variable iNum                 as integer   no-undo .
     4456   define variable jj                   as integer   no-undo .
     4457   define variable v-producer           as character no-undo .
     4458   define variable v-obj-name           as character no-undo .
     4459   define variable v-driver             as character no-undo .
     4460   define variable v-car-num            as character no-undo .
     4461   define variable v-car-type           as character no-undo .
     4462   define VARIABLE v-gds-name           as character no-undo .
     4463   define VARIABLE v-num-prob           as character no-undo .
     4464   DEFINE VARIABLE v-norm-doc           as character no-undo .
     4465   define VARIABLE v-kol-prob           as decimal   no-undo .
     4466   define VARIABLE v-tank-vol           as decimal   no-undo .
     4467   DEFINE VARIABLE v-tank-density       as DECIMAL   no-undo .
     4468   define VARIABLE v-tank-weight        as decimal   no-undo .
     4469   define variable v-tank-temp          as decimal   no-undo .
     4470   define variable v-date-prob          as date      no-undo .
     4471   define variable v-ship-date          as date      no-undo .
     4472   define variable v-hour-prob          as integer   no-undo .
     4473   define variable v-min-prob           as integer   no-undo .
     4474   define VARIABLE v-obj-adress         as character no-undo .
     4475   define VARIABLE v-carrier            as character no-undo .
     4476   define variable v-date-prob-propis   as character no-undo .
     4477   define VARIABLE v-meneger            as character no-undo .
     4478   define VARIABLE v-manager-position   as character no-undo .
     4479   define VARIABLE v-fio-position       as character no-undo .
     4480   define VARIABLE v-num-print-prob     as character no-undo .
     4481   define VARIABLE v-time-income        as character no-undo .
     4482   define VARIABLE v-hour-income        as integer   no-undo .
     4483   define VARIABLE v-min-income         as integer   no-undo .
     4484   define variable v-DD-Month-YYYY      as character no-undo .
     4485   define variable v-DD-Month-YYYY-cert as character no-undo.
     4486   define variable v-condition          as character no-undo .
     4487   define variable v-inspection-cert    as character no-undo .
     4488   define variable v-seals              as character no-undo .
     4489   define variable v-seals-condition    as character no-undo .
     4490   define variable v-seals-condition-2  as character no-undo .
     4491   define variable v-date-cert          as character no-undo .
     4492   define variable v-nakl               as character no-undo .
     4493   define variable v-date               as character no-undo .
     4494   define variable v-car-vol            as integer   no-undo .
     4495   define variable v-mouth              as integer   no-undo .
     4496   define variable v-doc-not            as character no-undo .
     4497   define variable v-spisok-doc         as character no-undo .
     4498   define variable v-attr-type          as character no-undo .
     4499   define variable v-komis              as logical   no-undo .
     4500   define stream Out-Stream.
     4501   define stream OutStr-html.
     4502   define VARIABLE p-report-id         as character no-undo .
     4503   define variable v-file-name-rep-htm as character no-undo .
     4504   define VARIABLE v-attr-value        as character no-undo .
     4505   define variable v-obj-type          as character no-undo .
     4506   define variable v-obj-code          as integer   no-undo .
     4507   define variable sgdkk               as logical   no-undo .
     4508   define variable v-msg               as character no-undo .
     4509   define variable v-kpsecs            as character no-undo .
     4510   define variable v-kpgds             as character no-undo .
     4511   define variable is-kp               as logical   no-undo .
     4512   define variable is-kprvs            as logical   no-undo .
     4513   define variable v-dec               as decimal   no-undo .
     4514   define variable v-sec-name          as character no-undo .
     4515   define variable varvalue            as character no-undo .
     4516   define variable v-ok                as logical   no-undo .
     4517   define buffer buf_trn-doc       for ub.trn-doc.
     4518   define buffer buf_doc-line      for ub.doc-line.
     4519   define buffer buf_doc-line-attr for ub.doc-line-attr.
     4520   define buffer buf_doc-attr      for ub.doc-attr.
     4521   define buffer buf_goods         for ub.goods.
     4522   define buffer buf_place         for ub.place.
     4523   define buffer buf_c-place-attr  for ub.c-place-attr .
     4524   define buffer buf2_c-place-attr for ub.c-place-attr .
     4525   define buffer buf_rvs-line      for ub.rvs-line.
     4526   define buffer buf_rvs-doc       for ub.rvs-doc.
     4527   define buffer buf_clients       for ub.clients.
     4528   define buffer buf_firm          for ub.firm.
     4529   define buffer buf_shop          for ub.shop.
     4530   define buffer buf_doc-pl        for ub.doc-pl.
     4531   define TEMP-TABLE tt-petrol no-undo
     4532     field date-TH       as character
     4533     field num-TH        as character
     4534     field type-AC       as character
     4535     field num-AC        as character
     4536     field name-gds      as character
     4537     field vol-TH        as Decimal
     4538     field density-TH    as decimal
     4539     field temp-TH       as decimal
     4540     field weight-TH     as decimal
     4541     field urov-AC       as character
     4542     field vol-AC        as decimal
     4543     field density-AC    as decimal
     4544     field temp-AC       as decimal
     4545     field weight-AC     as decimal
     4546     field passport      as character
     4547     field passport-date as date
     4548     field limit         as decimal
     4549     field deficit       as decimal
     4550     field excess        as decimal
     4551     field weight-pri    as decimal
     4552     field weight-est    as decimal
     4553     field num-pl        as character
     4554     field num-section   as integer
     4555     field komis-priem   as logical
     4556     index num-TH num-section passport type-AC num-AC .
     4557   define buffer buf_tt-petrol for tt-petrol .
     4558   do
     4559     on error undo, return error return-value
     4560     :
     4561     find first buf_trn-doc no-lock
     4562       where recid( buf_trn-doc ) = rec_id.
     4563     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'car-num':U,OUTPUT v-car-num) no-error .
     4564     find first ub.auto-tank-attr no-lock where ub.auto-tank-attr.auto-num = v-car-num and
     4565       ub.auto-tank-attr.attr-code = "auto-sep" and
     4566       logical(ub.auto-tank-attr.attr-value) = true no-error .
     4567     if available ub.auto-tank-attr then sgdkk = true .
     4568     v-InfoSectionsTotal = new InfoSectionsTotal().
     4569     gdsecs_ :
     4570     for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
     4571        first buf_goods where buf_goods.artic = buf_doc-line.artic
     4572          and buf_goods.prod-code = buf_doc-line.prod-code
     4573          and buf_goods.prod-type = buf_doc-line.prod-type
     4574     :
     4575       v-InfoSectionsTotal:Initialization(buf_trn-doc.doc-code, buf_goods.gds-code).
     4576       v-InfoSectionsTotal:GetDBAllAttr().
     4577       do iNum = 1 to v-InfoSectionsTotal:SectionNum:
     4578         v-InfoSection = v-InfoSectionsTotal:GetInfoSectionProp(iNum).
     4579         if v-InfoSection:IsKP
     4580         then do :
     4581           is-kp = yes .
     4582           if v-InfoSection:AccMeth = 1
     4583           then do :
     4584             is-kprvs = yes .
     4585           end .
     4586         end .
     4587       end .
     4588     end .
     4589     v-kpsecs = "" .
     4590     v-kpgds = "" .
     4591     if is-kprvs
     4592     then do :
     4593       for each buf_rvs-doc no-lock where buf_rvs-doc.rvs-type = 'после_док':U
     4594                                      and buf_rvs-doc.out-code = buf_trn-doc.doc-code,
     4595           each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code,
     4596           first buf_goods where buf_goods.gds-code = buf_rvs-line.gds-code,
     4597           first buf_place no-lock where buf_place.obj-type = buf_rvs-doc.obj-type
     4598                                     and buf_place.obj-code = buf_rvs-doc.obj-code
     4599                                     and buf_place.pl-code  = buf_rvs-line.pl-code
     4600       :
     4601         if buf_rvs-line.state-measure-cli-qnty = ?
     4602         then do :
     4603           if lookup(buf_place.loc1 + " " + buf_place.pl-name, v-kpsecs) > 0
     4604           then next .
     4605           v-kpsecs = v-kpsecs + buf_place.loc1 + " " + buf_place.pl-name + ", " .
     4606           v-kpgds = v-kpgds + string(buf_goods.gds-code) + " " + buf_goods.gds-name + ", " .
     4607         end .
     4608       end .
     4609     end .
     4610     else if is-kp
     4611     then do :
     4612       gdsecs_ :
     4613       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
     4614          first buf_goods where buf_goods.artic = buf_doc-line.artic
     4615            and buf_goods.prod-code = buf_doc-line.prod-code
     4616            and buf_goods.prod-type = buf_doc-line.prod-type
     4617       :
     4618         v-InfoSectionsTotal:Initialization(buf_trn-doc.doc-code, buf_goods.gds-code).
     4619         v-InfoSectionsTotal:GetDBAllAttr().
     4620         do iNum = 1 to v-InfoSectionsTotal:SectionNum:
     4621           v-InfoSection = v-InfoSectionsTotal:GetInfoSectionProp(iNum).
     4622           if (sgdkk and v-InfoSection:alarm-SGDKK and v-InfoSection:IsKP)
     4623           or (not sgdkk)
     4624           then do :
     4625             v-dec = decimal(v-InfoSection:TankWeight) no-error .
     4626             if error-status:error
     4627             or v-dec = 0
     4628             then do :
     4629               v-kpsecs = v-kpsecs + v-InfoSection:SectionName + ", " .
     4630               v-kpgds = v-kpgds + string(buf_goods.gds-code) + " " + buf_goods.gds-name + ", " .
     4631             end .
     4632           end .
     4633         end .
     4634       end .
     4635     end .
     4636     v-kpsecs = trim(v-kpsecs, ", ") .
     4637     v-kpgds = trim(v-kpgds, ", ") .
     4638     if v-kpsecs > ""
     4639     and v-kpgds > ""
     4640     then do :
     4641       if is-kprvs
     4642       then do :
     4643         message "Не заполнены данные по замерам в резервуаре " + v-kpsecs +
     4644                 ". Не может быть определено принимаемое к учету количество " + v-kpgds +
     4645                 ". Печать Акта приема нефтепродуктов возможна только после определения количества принимаемого к учету по всем НП. Заполните данные по замерам в резервуаре " + v-kpsecs +
     4646                 "."
     4647         view-as alert-box .
     4648       end .
     4649       else
     4650       if is-kp
     4651       then do :
     4652         message "Не заполнены данные по замерам в секции " + v-kpsecs +
     4653                 ". Не может быть определено принимаемое к учету количество " + v-kpgds +
     4654                 ". Печать Акта приема нефтепродуктов возможна только после определения количества принимаемого к учету по всем НП. Заполните данные по замерам в секции " + v-kpsecs +
     4655                 "."
     4656         view-as alert-box .
     4657       end .
     4658       return .
     4659     end .
     4660     run clients-write(INPUT buf_trn-doc.obj-code,INPUT buf_trn-doc.obj-type,OUTPUT v-obj-name) no-error .
     4661     find first buf_shop no-lock where buf_shop.obj-code = buf_trn-doc.obj-code no-error .
     4662     if AVAILABLE buf_shop then
     4663     do:
     4664       v-obj-adress = buf_shop.addres1 .
     4665     end.
     4666     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'ptbobj':U,OUTPUT v-attr-value) no-error .
     4667     if v-attr-value <> "" then
     4668     do:
     4669       assign
     4670         v-obj-code = integer (entry (2, v-attr-value, ";"))
     4671         v-obj-type = entry (1, v-attr-value, ";")
     4672         .
     4673       run clients-write(INPUT v-obj-code,INPUT v-obj-type,OUTPUT v-producer) no-error .
     4674     end.
     4675     else
     4676     do:
     4677       assign
     4678         v-obj-code = buf_trn-doc.cli-code
     4679         v-obj-type = buf_trn-doc.cli-type
     4680         .
     4681       run clients-write(INPUT v-obj-code,INPUT v-obj-type,OUTPUT v-producer) no-error .
     4682     end.
     4683     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'fio-driver':U,OUTPUT v-driver) no-error .
     4684     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'time-income':U,OUTPUT v-time-income) no-error .
     4685     v-hour-income = integer(substring(v-time-income, 1, 2)) no-error.
     4686     v-min-income = integer(substring(v-time-income, 4, 2)) no-error.
     4687     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'condition':U,OUTPUT v-condition) no-error .
     4688     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'date-cert':U,OUTPUT v-date-cert) no-error .
     4689     if v-date-cert <> ? and v-date-cert <> "" then
     4690     do:
     4691       run get-DD-month-YYYY(input v-date-cert, output v-DD-Month-YYYY-cert).
     4692     end.
     4693     else v-DD-Month-YYYY-cert = "".
     4694     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'inspection-cert':U,OUTPUT v-inspection-cert) no-error .
     4695     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'seals-condition':U,OUTPUT v-seals) no-error .
     4696     if v-seals <> "" then
     4697     do:
     4698       assign
     4699         v-seals-condition = entry (1, v-seals, chr(4)) .
     4700       v-seals-condition-2 = entry (2, v-seals, chr(4)) no-error .
     4701     end.
     4702     run person-write(INPUT buf_trn-doc.boss, OUTPUT v-meneger, output v-manager-position) no-error .
     4703     run person-write(INPUT buf_trn-doc.wrkr, OUTPUT v-fio, output v-fio-position) no-error .
     4704     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'autoent':U,OUTPUT v-attr-value) no-error .
     4705     if v-attr-value <> "" then
     4706     do:
     4707       assign
     4708         v-obj-code = integer (entry (2, v-attr-value, ";"))
     4709         v-obj-type = entry (1, v-attr-value, ";")
     4710         .
     4711       run clients-write(INPUT v-obj-code,INPUT v-obj-type,OUTPUT v-carrier) no-error .
     4712     end.
     4713     run get-DD-month-YYYY(input buf_trn-doc.doc-date, output v-DD-Month-YYYY).
     4714     run doc-attr-write(INPUT buf_trn-doc.doc-code,INPUT 'spisok-not-doc':U,OUTPUT v-attr-value) no-error .
     4715     if v-attr-value = "" then v-doc-not = "ПРЕДОСТАВЛЕНЫ" .
     4716     else
     4717     do:
     4718       assign
     4719         v-doc-not    = "НЕ ПРЕДОСТАВЛЕНЫ"
     4720         v-spisok-doc = v-attr-value .
     4721     end.
     4722     run get-report-num (output p-report-id).
     4723     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     4724     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     4725     put stream OutStr-html unformatted
     4726       "<!DOCTYPE HTML>" skip
     4727       ' <html>' skip
     4728       '  <head>' skip
     4729       '   <meta charset="utf-8">' skip
     4730       '    <style type="text/css">' skip
     4731       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     4732       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     4733       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     4734       '   </style>' skip
     4735       '  </head>' skip
     4736       .
     4737     put stream OutStr-html unformatted
     4738       '<body>' skip
     4739       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     4740       '<thead>' skip
     4741       .
     4742     put stream OutStr-html unformatted
     4743       '<tr>' skip
     4744       '<td style="width: 64px;"></td>' skip
     4745       '<td style="width: 64px;"></td>' skip
     4746       '<td style="width: 64px;"></td>' skip
     4747       '<td style="width: 64px;"></td>' skip
     4748       '<td style="width: 64px;"></td>' skip
     4749       '<td style="width: 64px;"></td>' skip
     4750       '<td style="width: 64px;"></td>' skip
     4751       '<td style="width: 64px;"></td>' skip
     4752       '<td style="width: 64px;"></td>' skip
     4753       '<td style="width: 64px;"></td>' skip
     4754       '</tr>' skip
     4755       .
     4756     put stream OutStr-html unformatted
     4757       '<TR><TD colspan="10"></TD></TR>' skip
     4758       '<TR>' skip
     4759       '<TD colspan="4" style="height: 14px; text-align: center;">' + v-obj-name + '</TD>' skip
     4760       '<TD colspan="6" style="text-align: right;"></TD>' skip
     4761       '</TR>'skip
     4762       '<TR>' skip
     4763       '<TD colspan="4" style="border-top: 1px solid black; text-align: center;">АЗС/АЗК</TD>' skip
     4764       '<TD colspan="6" style="text-align: right;"></TD>' skip
     4765       '</TR>'skip
     4766       '<TR>' skip
     4767       '<TD colspan="5" style=""></TD>' skip
     4768       '<TD colspan="5" style="text-align: center;">УТВЕРЖДАЮ</TD>' skip
     4769       '</TR>'skip
