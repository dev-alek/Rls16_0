     1029   procedure torgconf-get-self-param :
     1030   define input parameter p-obj-type           as character        no-undo.
     1031   define input parameter p-obj-code           as integer          no-undo.
     1032   define input parameter p-curr-code          as integer          no-undo.
     1033       define variable v-host-code    as integer      no-undo.
     1034       define variable v-par-type     as character    no-undo.
     1035   do
     1036   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1037   :
     1038   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1039   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1040     (input  p-obj-type
     1041     ,input  p-obj-code
     1042     ,output v-host-code
     1043     )  .
     1044       if v-torgconf-outhold = yes
     1045       then do:
     1046           run torgconf-get-holdfirm-code in this-procedure (
     1047                 input p-obj-type
     1048               , input p-obj-code
     1049               , output v-torgconf-self-host-code
     1050           ).
     1051           if v-torgconf-self-host-code = 0
     1052           then do:
     1053               return error.
     1054           end.
     1055       end.
     1056       else do:
     1057           assign
     1058               v-torgconf-self-host-code = v-host-code
     1059           .
     1060       end.
     1061       if v-torgconf-self-host-code = 0
     1062       then do:
     1063           assign
     1064               v-torgconf-self-host-name           = "":U
     1065               v-torgconf-self-host-addres         = "":U
     1066               v-torgconf-self-host-post-addres    = "":U
     1067               v-torgconf-self-host-phone          = "":U
     1068               v-torgconf-self-host-inn            = "":U
     1069               v-torgconf-self-host-kpp            = "":U
     1070               v-torgconf-self-host-okpo           = "":U
     1071               v-torgconf-self-host-egrip-date     = "":U
     1072               v-torgconf-self-host-egrip-num      = "":U
     1073           .
     1074       end.
     1075       else do:
     1076           run fmtcli-get-client in this-procedure (
     1077                 input 'орг':U
     1078               , input v-torgconf-self-host-code
     1079           ).
     1080           assign
     1081               v-torgconf-self-host-name        = v-fmtcli-name
     1082               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1083               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1084               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1085               v-torgconf-self-host-phone       = v-fmtcli-phone
     1086               v-torgconf-self-host-inn         = v-fmtcli-inn
     1087               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1088               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1089           .
     1090           run gbl/clntat-v.p (
     1091                 input 'орг':U
     1092               , input v-torgconf-self-host-code
     1093               , input 'egrip-date':U
     1094               , output v-torgconf-self-host-egrip-date
     1095               , output v-par-type
     1096           ).
     1097           run gbl/clntat-v.p (
     1098                 input 'орг':U
     1099               , input v-torgconf-self-host-code
     1100               , input 'egrip-num':U
     1101               , output v-torgconf-self-host-egrip-num
     1102               , output v-par-type
     1103           ).
     1104           run fmtcli-get-bank in this-procedure (
     1105                 input v-host-code
     1106               , input 'орг':U
     1107               , input v-torgconf-self-host-code
     1108               , input p-curr-code
     1109           ).
     1110       end.
     1111       assign
     1112           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1113           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1114           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1115           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1116           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1117           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1118           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1119           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1120       .
     1121       assign
     1122           v-torgconf-self-obj-type = p-obj-type
     1123           v-torgconf-self-obj-code = p-obj-code
     1124       .
     1125       run fmtcli-get-client in this-procedure (
     1126             input p-obj-type
     1127           , input p-obj-code
     1128       ).
     1129       assign
     1130           v-torgconf-self-obj-name       = v-fmtcli-name
     1131           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1132           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1133           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1134           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1135           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1136           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1137       .
     1138   end.
     1139   end procedure.
     1140   procedure torgconf-get-recepient-param :
     1141   define input parameter torgconfdoc-code   as character                  no-undo.
     1142   define output parameter v-code-rec        as integer                    no-undo .
     1143   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1144   define output parameter v-codefirm-rec    as integer                    no-undo .
     1145   define output parameter v-curcode-rec     as integer                    no-undo .
     1146        define variable  v-recipient-code  as character                  no-undo .
     1147        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1148        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1149   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1150                           input 'Recipient':U ,
     1151                          output v-recipient-code ,
     1152                          output v-trdcattr-type ) no-error .
     1153       if error-status :error then do:
     1154        message
     1155         vss-workfile vss-revision vss-description skip
     1156         "Ошибка при вызове процедуры tdat-val":U skip
     1157         "Документ: " torgconfdoc-code skip
     1158         "Атрибут: " 'Recipient':U skip
     1159         "Значение: " v-recipient skip
     1160         trim( error-status :get-message (1) ) skip
     1161         return-value skip
     1162         view-as alert-box error.
     1163       undo, return error return-value.
     1164       end.
     1165     assign
     1166       v-recipient  = v-recipient-code
     1167       v-type-rec = substring(v-recipient-code,1,3)
     1168       v-code-rec  = int(substring(v-recipient-code,4,15))
     1169       no-error
     1170     .
     1171     if v-type-rec = ? then v-type-rec = "" .
     1172     if v-code-rec  = ? then v-code-rec  =  0 .
     1173     end procedure.
