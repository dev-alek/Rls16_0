     1369   procedure torgconf-get-sup-param :
     1370   define input parameter p-obj-type           as character        no-undo.
     1371   define input parameter p-obj-code           as integer          no-undo.
     1372   define input parameter p-curr-code          as integer          no-undo.
     1373       define variable v-host-code    as integer      no-undo.
     1374       define variable v-par-type     as character    no-undo.
     1375   do
     1376   on error undo, return error
     1377   :
     1378       assign
     1379          v-torgconf-sup-host-code = v-host-code
     1380       .
     1381       if v-torgconf-sup-host-code = 0
     1382       then do:
     1383           assign
     1384               v-torgconf-sup-host-name           = "":U
     1385               v-torgconf-sup-host-addres         = "":U
     1386               v-torgconf-sup-host-post-addres    = "":U
     1387               v-torgconf-sup-host-phone          = "":U
     1388               v-torgconf-sup-host-inn            = "":U
     1389               v-torgconf-sup-host-kpp            = "":U
     1390               v-torgconf-sup-host-okpo           = "":U
     1391               v-torgconf-sup-host-egrip-date     = "":U
     1392               v-torgconf-sup-host-egrip-num      = "":U
     1393           .
     1394       end.
     1395       else do:
     1396           run fmtcli-get-client in this-procedure (
     1397                 input 'орг':U
     1398               , input v-torgconf-sup-host-code
     1399           ).
     1400           assign
     1401               v-torgconf-sup-host-name        = v-fmtcli-name
     1402               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1403               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1404               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1405               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1406               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1407               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1408               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1409           .
     1410           run gbl/clntat-v.p (
     1411                 input 'орг':U
     1412               , input v-torgconf-sup-host-code
     1413               , input 'egrip-date':U
     1414               , output v-torgconf-sup-host-egrip-date
     1415               , output v-par-type
     1416           ).
     1417           run gbl/clntat-v.p (
     1418                 input 'орг':U
     1419               , input v-torgconf-sup-host-code
     1420               , input 'egrip-num':U
     1421               , output v-torgconf-sup-host-egrip-num
     1422               , output v-par-type
     1423           ).
     1424           run fmtcli-get-bank in this-procedure (
     1425                 input v-host-code
     1426               , input 'орг':U
     1427               , input v-torgconf-sup-host-code
     1428               , input p-curr-code
     1429           ).
     1430       end.
     1431       assign
     1432           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1433           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1434           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1435           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1436           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1437           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1438           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1439           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1440       .
     1441       assign
     1442           v-torgconf-sup-obj-type = p-obj-type
     1443           v-torgconf-sup-obj-code = p-obj-code
     1444       .
     1445       if trim(p-obj-type) <> ""
     1446       and p-obj-code <> 0
     1447       then do:
     1448       run fmtcli-get-client in this-procedure (
     1449             input p-obj-type
     1450           , input p-obj-code
     1451       ).
     1452       assign
     1453           v-torgconf-sup-obj-name        = v-fmtcli-name
     1454           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1455           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1456           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1457           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1458           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1459           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1460       .
     1461      end.
     1462      end.
     1463   end procedure.
     1464   procedure torgconf-get-cli-param :
     1465   define input parameter p-host-obj-code      as integer          no-undo.
     1466   define input parameter p-obj-type           as character        no-undo.
     1467   define input parameter p-obj-code           as integer          no-undo.
     1468   define input parameter p-curr-code          as integer          no-undo.
     1469       define variable v-host-code    as integer      no-undo.
     1470   do
     1471   on error undo, return error
     1472   :
     1473       assign
     1474           v-torgconf-cli-type = p-obj-type
     1475           v-torgconf-cli-code = p-obj-code
     1476       .
     1477       run fmtcli-get-client in this-procedure (
     1478             input p-obj-type
     1479           , input p-obj-code
     1480       ).
     1481       assign
     1482           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1483           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1484           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1485           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1486           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1487           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1488           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1489           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1490       .
     1491      run fmtcli-get-bank in this-procedure (
     1492             input p-host-obj-code
     1493           , input p-obj-type
     1494           , input p-obj-code
     1495           , input p-curr-code
     1496       ).
     1497       assign
     1498           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1499           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1500           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1501           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1502           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1503           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1504           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1505           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1506       .
     1507   end.
     1508   end procedure.
     1509   procedure torgconf-get-ship-param :
     1510   define input parameter p-host-obj-code      as integer          no-undo.
     1511   define input parameter p-obj-type           as character        no-undo.
     1512   define input parameter p-obj-code           as integer          no-undo.
     1513   define input parameter p-curr-code          as integer          no-undo.
     1514       define variable v-host-code    as integer      no-undo.
     1515   do
     1516   on error undo, return error
     1517   :
     1518       assign
     1519           v-torgconf-ship-type = p-obj-type
     1520           v-torgconf-ship-code = p-obj-code
     1521       .
     1522       if trim(p-obj-type) = ""
     1523       and p-obj-code = 0
     1524       then do:
     1525       assign
     1526           v-torgconf-ship-name         = "":U
     1527           v-torgconf-ship-addres       = "":U
     1528           v-torgconf-ship-post-addres  = "":U
     1529           v-torgconf-ship-phone        = "":U
     1530           v-torgconf-ship-inn          = "":U
     1531           v-torgconf-ship-kpp          = "":U
     1532           v-torgconf-ship-okpo         = "":U
     1533       .
     1534       end.
     1535       else do:
     1536       run fmtcli-get-client in this-procedure (
     1537             input p-obj-type
     1538           , input p-obj-code
     1539       ).
     1540       assign
     1541           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1542           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1543           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1544           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1545           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1546           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1547           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1548           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1549       .
     1550       end.
     1551           run fmtcli-get-bank in this-procedure (
     1552             input p-host-obj-code
     1553           , input p-obj-type
     1554           , input p-obj-code
     1555           , input p-curr-code
     1556       ).
     1557       assign
     1558           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1559           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1560           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1561           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1562           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1563           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1564           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1565           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1566       .
     1567   end.
     1568   end procedure.
     1569   procedure torgconf-get-holdfirm-code :
     1570   define input parameter p-obj-type   as character        no-undo.
     1571   define input parameter p-obj-code   as integer          no-undo.
     1572   define output parameter p-firm-code as integer          no-undo.
     1573       define variable v-firm-code-str     as character    no-undo.
     1574       define variable v-par-type          as character    no-undo.
     1575       define buffer buf_clients       for ub.clients.
     1576   do
     1577   for buf_clients
     1578   on error undo, return error
     1579   :
     1580       run gbl/clntat-v.p (
     1581             input p-obj-type
     1582           , input p-obj-code
     1583           , input 'holdfirm-code':U
     1584           , output v-firm-code-str
     1585           , output v-par-type
     1586       ).
     1587       assign
     1588           p-firm-code = integer( v-firm-code-str )
     1589       no-error.
     1590       if error-status :error
     1591       then do:
     1592           message
     1593               "Неверно задан код фирмы для печати накладных."
     1594           view-as alert-box warning.
     1595           assign
     1596               p-firm-code = 0
     1597           .
     1598       end.
     1599       else do:
     1600           find first buf_clients no-lock
     1601                where buf_clients.obj-type = 'орг':U
     1602                  and buf_clients.obj-code = p-firm-code
     1603           no-error.
     1604           if not available buf_clients
     1605           then do:
     1606               message
     1607                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1608                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1609               view-as alert-box warning.
     1610               assign
     1611                   p-firm-code = 0
     1612               .
     1613           end.
     1614       end.
     1615   end.
     1616   end procedure.
     1617   procedure torgconf-get-post-head:
     1618   define input  parameter p-obj-type             as character        no-undo.
     1619   define input  parameter p-obj-code             as integer          no-undo.
     1620   define output parameter p-torgconf-post-head   as character        no-undo.
     1621      define variable v-host-code         as integer      no-undo.
     1622      define buffer buf_sysconf     for ub.sysconf.
     1623        assign
     1624         p-torgconf-post-head  = ""
     1625        .
     1626   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1627   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1628     (input  p-obj-type
     1629     ,input  p-obj-code
     1630     ,output v-host-code
     1631     )  .
     1632      find first buf_sysconf no-lock
     1633      where buf_sysconf.host-code = v-host-code
     1634      no-error.
     1635      if available buf_sysconf
     1636      then do:
     1637         assign
     1638            p-torgconf-post-head = buf_sysconf.head-position
     1639         .
     1640      end.
     1641   end procedure.
     1642   procedure torgconf-get-storekeeper:
     1643   define input  parameter p-wrkr                   as integer          no-undo.
     1644   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1645   define output parameter p-torgconf-post          as character        no-undo.
     1646      define buffer buf_sysconf     for ub.sysconf.
     1647      define buffer buf_person      for ub.person.
     1648      define buffer buf_shop        for ub.shop .
     1649      define buffer buf_store       for ub.store .
     1650      if v-torgconf-outC = "no_print"
     1651      then do:
     1652         assign p-torgconf-post = ""
     1653                p-torgconf-wrkr-name = ""
     1654                .
     1655      end.
     1656      if v-torgconf-outC = "clad_doc"
     1657      then do:
     1658         run rep/get-psn.p
     1659               (input  p-wrkr
     1660               ,output p-torgconf-wrkr-name
     1661               ) .
     1662         find first buf_person no-lock
     1663         where buf_person.psn-code = p-wrkr
     1664         no-error.
     1665         if available buf_person
     1666         then do:
     1667           p-torgconf-post = buf_person.position.
     1668         end.
     1669         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1670         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1671      end.
     1672      if v-torgconf-outC = "clad_obj"
     1673      then do:
     1674         CASE v-torgconf-self-obj-type:
     1675         WHEN 'маг':U
     1676         THEN DO:
     1677            find first buf_shop no-lock
     1678            where buf_shop.obj-code = v-torgconf-self-obj-code
     1679            .
     1680            assign
     1681               p-torgconf-wrkr-name = buf_shop.store-man
     1682               p-torgconf-post = ""
     1683            .
     1684            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1685         END.
     1686         WHEN 'скл':U
     1687         THEN DO:
     1688            find first buf_store no-lock
     1689            where buf_store.obj-code = v-torgconf-self-obj-code
     1690            .
     1691            assign
     1692               p-torgconf-wrkr-name = buf_store.store-man
     1693               p-torgconf-post = ""
     1694            .
     1695            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1696         END.
     1697         OTHERWISE DO:
     1698            assign
     1699               p-torgconf-post = "":U
     1700               p-torgconf-wrkr-name = "":U
     1701            .
     1702         END.
     1703         END CASE.
     1704      end.
     1705    end procedure.
     1706   procedure torgconf-get-form-header :
     1707   define input parameter p-for-inverse    as logical          no-undo.
     1708   define input parameter p-doc-code       as character        no-undo.
     1709   define input parameter p-print-doc      as logical          no-undo.
     1710   define input parameter p-doc-date       as date             no-undo.
     1711   define input parameter p-fact-date      as date             no-undo.
     1712   define input parameter p-doc-type       as character        no-undo.
     1713   define input parameter p-status_        as character        no-undo.
     1714   define input parameter p-reverse        as logical          no-undo.
     1715   define input parameter p-sf-par         as logical          no-undo.
     1716       define variable v-attr-type         as character    no-undo.
     1717       define variable v-doc-code-standard as logical      no-undo.
     1718       define variable v-doc-date-standard as logical      no-undo.
     1719       define variable v-par-consignee-addres  as character    no-undo.
     1720       define variable v-host-code         as integer      no-undo.
     1721       define variable v-dcode-attr        as character    no-undo.
     1722       define variable v-ddate-attr        as character    no-undo.
     1723       define variable v-doc-date          as character    no-undo.
     1724       define variable v-doc-code          as character    no-undo.
     1725       define variable v-par-type          as character    no-undo.
     1726       define variable v-attr              as character    no-undo.
     1727       define buffer buf_firm          for ub.firm .
     1728       define buffer buf_clients       for ub.clients .
     1729       define buffer buf_sysconf       for ub.sysconf .
     1730       define buffer buf_shop          for ub.shop .
     1731       define buffer buf_store         for ub.store .
     1732       define buffer buf_person        for ub.person .
     1733       define buffer buf_trn-doc       for ub.trn-doc .
     1734       define buffer buf_wth-doc       for ub.wth-doc .
     1735       do
     1736   for buf_firm
     1737     , buf_clients
     1738     , buf_sysconf
     1739     , buf_shop
     1740     , buf_trn-doc
     1741     , buf_person
     1742     , buf_wth-doc
     1743   on error undo, return error
     1744   :
     1745       if p-doc-type = 'при':U
     1746       or p-doc-type = 'возврат':U
     1747       then do:
     1748           assign
     1749               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1750                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1751               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1752                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1753               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1754                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1755               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1756                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1757               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1758               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1759               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1760               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1761               v-torgconf-supplier-type    = v-torgconf-cli-type
     1762               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1763               v-torgconf-saler-type       = v-torgconf-self-host-type
     1764               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     1765               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     1766               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     1767               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     1768               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     1769               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     1770               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     1771               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     1772               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     1773               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     1774               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     1775               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     1776               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     1777               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     1778               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     1779           .
     1780           if v-torgconf-cli-schet-exists = yes
     1781           AND v-form-name                  = "torg12":U
     1782           then do:
     1783               assign
     1784                   v-torgconf-supplier = v-torgconf-supplier
     1785                       + substitute( ", р/с &1 к/с &2"
     1786                                   , v-torgconf-cli-bank-r-schet
     1787                                   , v-torgconf-cli-bank-c-schet
     1788                                   )
     1789                   v-torgconf-suppi = v-torgconf-supplier
     1790                       + substitute( ", р/с &1 к/с &2"
     1791                                   , v-torgconf-cli-bank-r-schet
     1792                                   , v-torgconf-cli-bank-c-schet
     1793                                   )
     1794               .
     1795               if v-torgconf-cli-bank-exists = yes
     1796               then do:
     1797                   assign
     1798                       v-torgconf-supplier = v-torgconf-supplier
     1799                           + substitute( " БИК &1 в &2 &3"
     1800                                       , v-torgconf-cli-bank-bik
     1801                                       , v-torgconf-cli-bank-name
     1802                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     1803                                       )
     1804                      v-torgconf-suppi = v-torgconf-supplier
     1805                           + substitute( " БИК &1 в &2 &3"
     1806                                       , v-torgconf-cli-bank-bik
     1807                                       , v-torgconf-cli-bank-name
     1808                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     1809                                       )
     1810                   .
     1811               end.
     1812           end.
     1813           if v-torgconf-self-schet-exists = yes
     1814           AND v-form-name                  = "torg12":U
     1815           then do:
     1816               assign
     1817                   v-torgconf-saler = v-torgconf-saler
     1818                       + substitute( ", р/с &1 к/с &2"
     1819                                   , v-torgconf-self-bank-r-schet
     1820                                   , v-torgconf-self-bank-c-schet
     1821                                   )
     1822               .
     1823               if v-torgconf-self-bank-exists = yes
     1824               then do:
     1825                   assign
     1826                       v-torgconf-saler = v-torgconf-saler
     1827                           + substitute( " БИК &1 в &2 &3"
     1828                                       , v-torgconf-self-bank-bik
     1829                                       , v-torgconf-self-bank-name
     1830                                       , v-torgconf-self-bank-addres
     1831                                       )
     1832                   .
     1833               end.
     1834           end.
     1835           if v-torgconf-sup-schet-exists = yes
     1836           AND v-form-name                  = "torg12":U
     1837           then do:
     1838               assign
     1839                   v-torgconf-consignee = v-torgconf-consignee
     1840                       + substitute( ", р/с &1 к/с &2"
     1841                                   , v-torgconf-sup-bank-r-schet
     1842                                   , v-torgconf-sup-bank-c-schet
     1843                                   )
     1844               .
     1845             if v-torgconf-sup-bank-exists = yes
     1846              then do:
     1847                assign
     1848                   v-torgconf-consignee = v-torgconf-consignee
     1849                           + substitute( " БИК &1 в &2 &3"
     1850                                       , v-torgconf-sup-bank-bik
     1851                                       , v-torgconf-sup-bank-name
     1852                                       , v-torgconf-sup-bank-addres
     1853                                       )
     1854                   .
     1855               end.
     1856           end.
     1857      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     1858      then do:
     1859          assign
     1860            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     1861                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     1862                                                   , v-torgconf-cli-name
     1863                                                   , ( if v-torgconf-outprncd = yes
     1864                                                         then substitute( " (&1)", v-torgconf-cli-code )
     1865                                                         else "":U )
     1866                                                   , v-torgconf-cli-post-addres
     1867                                                   , v-torgconf-cli-phone
     1868                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     1869                                                       AND v-form-name                  = "torg12":U
     1870                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     1871                                                               , v-torgconf-cli-bank-r-schet
     1872                                                               , v-torgconf-cli-bank-c-schet
     1873                                                               , v-torgconf-cli-bank-bik
     1874                                                               , v-torgconf-cli-bank-name
     1875                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     1876                                                         else "":U )
     1877                                                )
     1878         .
     1879      end.
     1880       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     1881                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     1882                                        , v-torgconf-cli-name
     1883                                        , ( if v-torgconf-outprncd = yes
     1884                                            then substitute( " (&1)", v-torgconf-cli-code )
     1885                                            else "":U )
     1886                                        , v-torgconf-cli-addres
     1887                                        , v-torgconf-cli-phone
     1888                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     1889                                            AND v-form-name                  = "torg12":U
     1890                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     1891                                                           , v-torgconf-cli-bank-r-schet
     1892                                                           , v-torgconf-cli-bank-c-schet
     1893                                                           , v-torgconf-cli-bank-bik
     1894                                                           , v-torgconf-cli-bank-name
     1895                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     1896                                                   else "":U )
     1897                                        ).
     1898       end.
     1899       else do:
     1900       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     1901                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     1902                                        , v-torgconf-self-host-name
     1903                                        , ( if v-torgconf-outprncd = yes
     1904                                            then substitute( " (&1)", v-torgconf-self-host-code )
     1905                                            else "":U )
     1906                                        , v-torgconf-self-host-addres
     1907                                        , v-torgconf-self-host-phone
     1908                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     1909                                            AND v-form-name                  = "torg12":U
     1910                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     1911                                                           , v-torgconf-self-bank-r-schet
     1912                                                           , v-torgconf-self-bank-c-schet
     1913                                                           , v-torgconf-self-bank-bik
     1914                                                           , v-torgconf-self-bank-name
     1915                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     1916                                                   else "":U )
     1917                                           ).
     1918         if v-torgconf-outares = yes
     1919         and p-reverse = no
     1920         then do:
     1921            assign
     1922               v-par-consignee-addres = v-torgconf-ship-post-addres
     1923            .
     1924         end.
     1925         if v-torgconf-outares = no
     1926         and p-reverse = no
     1927         then do:
     1928            assign
     1929               v-par-consignee-addres = v-torgconf-ship-addres
     1930            .
     1931         end.
     1932         if p-reverse = yes
     1933         then do:
     1934             assign
     1935               v-par-consignee-addres = v-torgconf-ship-addres
     1936             .
     1937         end.
     1938           assign
     1939               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     1940                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     1941               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     1942                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1943               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     1944                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     1945               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     1946               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     1947               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     1948               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     1949               v-torgconf-supplier-code    = v-torgconf-self-host-type
     1950               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     1951               v-torgconf-saler-type       = v-torgconf-cli-type
     1952               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     1953               v-torgconf-consignee-type   = v-torgconf-ship-type
     1954               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     1955               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     1956               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     1957               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     1958               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     1959               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     1960               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     1961               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     1962               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     1963               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     1964               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     1965               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     1966               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     1967               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     1968               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     1969               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     1970               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     1971           .
     1972           if v-torgconf-self-schet-exists = yes
     1973           AND v-form-name                  = "torg12":U
     1974           then do:
     1975               assign
     1976                   v-torgconf-supplier = v-torgconf-supplier
     1977                       + substitute( ", р/с &1 к/с &2"
     1978                                   , v-torgconf-self-bank-r-schet
     1979                                   , v-torgconf-self-bank-c-schet
     1980                                   )
     1981               .
     1982               if v-torgconf-self-bank-exists = yes
     1983               then do:
     1984                   assign
     1985                       v-torgconf-supplier = v-torgconf-supplier
     1986                           + substitute( " БИК &1 в &2 &3"
     1987                                       , v-torgconf-self-bank-bik
     1988                                       , v-torgconf-self-bank-name
     1989                                       , v-torgconf-self-bank-addres
     1990                                       )
     1991                   .
     1992               end.
     1993           end.
     1994           if v-torgconf-cli-schet-exists = yes
     1995           AND v-form-name                  = "torg12":U
     1996           then do:
     1997               assign
     1998                   v-torgconf-saler = v-torgconf-saler
     1999                       + substitute( ", р/с &1 к/с &2"
     2000                                   , v-torgconf-cli-bank-r-schet
     2001                                   , v-torgconf-cli-bank-c-schet
     2002                                   )
     2003               .
     2004               if v-torgconf-cli-bank-exists = yes
     2005               then do:
     2006                   assign
     2007                       v-torgconf-saler = v-torgconf-saler
     2008                           + substitute( " БИК &1 в &2 &3"
     2009                                       , v-torgconf-cli-bank-bik
     2010                                       , v-torgconf-cli-bank-name
     2011                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2012                                       )
     2013                   .
     2014               end.
     2015           end.
     2016           if v-torgconf-ship-schet-exists = yes
     2017           AND v-form-name                  = "torg12":U
     2018           then do:
     2019               assign
     2020                   v-torgconf-consignee = v-torgconf-consignee
     2021                       + substitute( ", р/с &1 к/с &2"
     2022                                   , v-torgconf-ship-bank-r-schet
     2023                                   , v-torgconf-ship-bank-c-schet
     2024                                   )
     2025               .
     2026               if v-torgconf-ship-bank-exists = yes
     2027               then do:
     2028                   assign
     2029                       v-torgconf-consignee = v-torgconf-consignee
     2030                           + substitute( " БИК &1 в &2  &3"
     2031                                       , v-torgconf-ship-bank-bik
     2032                                       , v-torgconf-ship-bank-name
     2033                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     2034                                       )
     2035                   .
     2036               end.
     2037           end.
     2038      if p-reverse = yes
     2039         then do:
     2040          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     2041            .
     2042          else v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres       ) .
     2043                 if v-torgconf-cli-schet-exists = yes
     2044                 AND v-form-name                  = "torg12":U
     2045                     then do:
     2046                           assign
     2047                              v-torgconf-saler = v-torgconf-saler
     2048                                 + substitute( ", р/с &1 к/с &2"
     2049                                             , v-torgconf-cli-bank-r-schet
     2050                                             , v-torgconf-cli-bank-c-schet
     2051                                             )
     2052               .
     2053               if v-torgconf-cli-bank-exists = yes
     2054               AND v-form-name                  = "torg12":U
     2055                  then do:
     2056                     assign
     2057                        v-torgconf-saler = v-torgconf-saler
     2058                              + substitute( " БИК &1 в &2  &3"
     2059                                          , v-torgconf-cli-bank-bik
     2060                                          , v-torgconf-cli-bank-name
     2061                                          , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2062                                          )
     2063                     .
     2064               end.
     2065           end.
     2066           v-torgconf-saler-name = v-torgconf-cli-name .
     2067           v-torgconf-saler-okpo = v-torgconf-cli-okpo.
     2068      end.
     2069       if trim(v-torgconf-consignee) = ""
     2070       and v-torgconf-outares = yes
     2071       and p-reverse = no
     2072       then do:
     2073         assign
     2074         v-torgconf-consignee = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres)
     2075         .
     2076            if v-torgconf-cli-schet-exists = yes
     2077            AND v-form-name                  = "torg12":U
     2078               then do:
     2079                     assign
     2080                        v-torgconf-consignee = v-torgconf-consignee
     2081                           + substitute( ", р/с &1 к/с &2"
     2082                                       , v-torgconf-cli-bank-r-schet
     2083                                       , v-torgconf-cli-bank-c-schet
     2084                                       )
     2085                     .
