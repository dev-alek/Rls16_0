     4864     put stream OutStr-html unformatted
     4865       '</thead>' skip
     4866       '</table>' skip
     4867       '<TABLE name="2"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     4868       '<thead>' skip
     4869       .
     4870     put stream OutStr-html unformatted
     4871       '<tr>' skip
     4872       '<td style="width: 64px;"></td>' skip
     4873       '<td style="width: 64px;"></td>' skip
     4874       '<td style="width: 74px;"></td>' skip
     4875       '<td style="width: 112px;"></td>' skip
     4876       '<td style="width: 56px;"></td>' skip
     4877       '<td style="width: 21px;"></td>' skip
     4878       '<td style="width: 64px;"></td>' skip
     4879       '<td style="width: 50px;"></td>' skip
     4880       '<td style="width: 95px;"></td>' skip
     4881       '<td style="width: 75px;"></td>' skip
     4882       '<td style="width: 37px;"></td>' skip
