     3453   procedure torgconf-get-reason  :
     3454   define input parameter  p-doc-code       as character        no-undo.
     3455   define input parameter  p-reason-code    as integer          no-undo .
     3456   define input parameter  p-doc-type       as character        no-undo.
     3457       if p-reason-code > 0
     3458       then do:
     3459           define buffer buf_trn-reason for ub.trn-reason.
     3460           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3461           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3462       end.
     3463       else do:
     3464           if p-doc-type = 'при':U
     3465           then  do:
     3466               define variable v-attr-type     as character    no-undo.
     3467               define variable v-attr-value    as character    no-undo.
     3468               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3469               assign v-torgconf-reason = v-attr-value .
     3470               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3471               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3472           end.
     3473       end.
     3474   end procedure.
