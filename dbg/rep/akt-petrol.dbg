        1   using ibs.th.str.*.
        2   block-level on error undo, throw.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Акт приема нефтепродуктов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define input parameter p-mainmenu-handle    as handle           no-undo.
       64   define input parameter rec_id               as recid            no-undo.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
       70     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
       71     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
       72     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
       73   END FUNCTION.
       74   PROCEDURE get-month-name-case :
       75     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
       76     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
       77     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
       78     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
       79       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
       80         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
       81         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
       82         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
       83         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
       84         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
       85     DO ON ERROR UNDO, RETURN ERROR :
       86       IF p-month < 1 OR p-month > 12 OR
       87          p-case  < 1 OR p-case  >  6 THEN DO:
       88         ASSIGN p-name = ?.
       89       END.                           ELSE DO:
       90         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
       91       END.
       92     END.
       93   END PROCEDURE.
       94   define stream out-stream.
       95   define new global shared variable g#library  as handle no-undo .
       96   define new global shared variable g#library2 as handle no-undo .
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       99   define  shared variable RepPathName        as character no-undo .
      100   define  shared variable PrintRubl          as logical   no-undo .
      101   define new global shared variable g#lib-trn  as handle no-undo .
      102   define new global shared variable g#lib-trn2 as handle no-undo .
      103   define new global shared variable g#lib-trn3 as handle no-undo .
      104   define new global shared variable g#lib-trn4 as handle no-undo .
      105   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   define new global shared variable g#trdcalib as handle no-undo.
      107   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      108                                     iInput AS INTEGER).
      109     def var v-start-print as integer no-undo .
      110     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      111     assign
      112       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      113     .
      114     RETURN v-start-print .
      115   END FUNCTION.
      116   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      117                                     iInput AS INTEGER).
      118     def var v-start-print as integer no-undo .
      119     assign
      120       v-start-print = INTEGER(iEndPix - 1 - iInput)
      121     .
      122     if v-start-print < 0 then return 0.
      123     RETURN v-start-print .
      124   END FUNCTION.
      125   define variable vss-include-info2 as character format "X(65)" no-undo
      126   initial "@(#)$Workfile$ $Revision$".
      127   define variable v-fmtcli-name          as character    no-undo.
      128   define variable v-fmtcli-engl-name     as character    no-undo.
      129   define variable v-fmtcli-addres        as character    no-undo.
      130   define variable v-fmtcli-post-addres   as character    no-undo.
      131   define variable v-fmtcli-full-addres   as character    no-undo.
      132   define variable v-fmtcli-phone         as character    no-undo.
      133   define variable v-fmtcli-inn           as character    no-undo.
      134   define variable v-fmtcli-kpp           as character    no-undo.
      135   define variable v-fmtcli-okpo          as character    no-undo.
      136   define variable v-fmtcli-country       as character    no-undo.
      137   define variable v-fmtcli-city          as character    no-undo.
      138   define variable v-fmtcli-index         as character    no-undo.
      139   define variable v-fmtcli-schet-exists  as logical      no-undo.
      140   define variable v-fmtcli-bank-exists   as logical      no-undo.
      141   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      142   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      143   define variable v-fmtcli-bank-bik      as character    no-undo.
      144   define variable v-fmtcli-bank-name     as character    no-undo.
      145   define variable v-fmtcli-bank-addres   as character    no-undo.
      146   define variable v-fmtcli-bank-city     as character    no-undo.
      147   procedure fmtcli-get-bank :
      148   define input parameter p-host-code      as integer          no-undo.
      149   define input parameter p-obj-type       as character        no-undo.
      150   define input parameter p-obj-code       as integer          no-undo.
      151   define input parameter p-curr-code      as integer          no-undo.
      152       define buffer buf_fin-schet     for ub.fin-schet.
      153       define buffer buf_fin-bank      for ub.fin-bank.
      154   do
      155   for buf_fin-schet
      156     , buf_fin-bank
      157   on error undo, return error
      158   :
      159       assign
      160           v-fmtcli-schet-exists       = no
      161           v-fmtcli-bank-exists        = no
      162           v-fmtcli-bank-r-schet       = "":U
      163           v-fmtcli-bank-c-schet       = "":U
      164           v-fmtcli-bank-bik           = "":U
      165           v-fmtcli-bank-name          = "":U
      166           v-fmtcli-bank-addres        = "":U
      167           v-fmtcli-bank-city          = "":U
      168       .
      169       search-for-schet:
      170       for each buf_fin-schet no-lock
      171          where buf_fin-schet.host-code = p-host-code
      172            and buf_fin-schet.cli-type  = p-obj-type
      173            and buf_fin-schet.cli-code  = p-obj-code
      174            and buf_fin-schet.curr-code = p-curr-code
      175       on error undo, return error
      176       :
      177           if buf_fin-schet.status_   = 'удал':U
      178           then do:
      179           end.
      180           else do:
      181               assign
      182                   v-fmtcli-schet-exists   = yes
      183                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      184                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      185               .
      186               find first buf_fin-bank no-lock
      187                    where buf_fin-bank.host-code = p-host-code
      188                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      189               no-error.
      190               if available buf_fin-bank
      191               then do:
      192                   assign
      193                       v-fmtcli-bank-exists      = yes
      194                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      195                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      196                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      197                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      198                   .
      199               end.
      200               else do:
      201                   assign
      202                       v-fmtcli-bank-exists    = no
      203                       v-fmtcli-bank-bik       = "":U
      204                       v-fmtcli-bank-name      = "":U
      205                       v-fmtcli-bank-addres    = "":U
      206                       v-fmtcli-bank-city      = "":U
      207                   .
      208               end.
      209               leave search-for-schet.
      210           end.
      211       end.
      212   end.
      213   end procedure.
      214   procedure fmtcli-get-client :
      215   define input parameter p-obj-type       as character    no-undo.
      216   define input parameter p-obj-code       as integer      no-undo.
      217       define variable v-temp-fmtcli-address      as character     no-undo.
      218       define variable v-num-country-city    as integer      no-undo.
      219       define buffer buf_clients   for ub.clients.
      220       define buffer buf_firm      for ub.firm.
      221       define buffer buf_store     for ub.store.
      222       define buffer buf_shop      for ub.shop.
      223       define buffer buf_person    for ub.person.
      224   do
      225   for buf_clients
      226     , buf_firm
      227     , buf_store
      228     , buf_shop
      229     , buf_person
      230   on error undo, return error
      231   :
      232       assign
      233           v-fmtcli-name           = "":U
      234           v-fmtcli-addres         = "":U
      235           v-fmtcli-post-addres    = "":U
      236           v-fmtcli-full-addres    = "":U
      237           v-fmtcli-phone          = "":U
      238           v-fmtcli-inn            = "":U
      239           v-fmtcli-kpp            = "":U
      240           v-fmtcli-okpo           = "":U
      241           v-fmtcli-city           = "":U
      242           v-fmtcli-index          = "":U
      243           v-fmtcli-country        = "":U
      244       .
      245       find first buf_clients no-lock
      246            where buf_clients.obj-type = p-obj-type
      247              and buf_clients.obj-code = p-obj-code
      248       .
      249       assign
      250           v-fmtcli-name = buf_clients.obj-name
      251       .
      252       case buf_clients.obj-type:
      253          when 'орг':U
      254          then do:
      255               find first buf_firm no-lock
      256                    where buf_firm.firm-code = buf_clients.obj-code
      257                    no-error
      258               .
      259               if available buf_firm
      260               then do:
      261                   assign
      262                       v-num-country-city = num-entries( buf_firm.city )
      263                       v-fmtcli-engl-name = buf_firm.engl-name
      264                   .
      265                   if v-num-country-city > 0
      266                   then do:
      267                       assign
      268                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      269                       .
      270                   end.
      271                   if v-num-country-city > 1
      272                   then do:
      273                       assign
      274                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      275                       .
      276                   end.
      277                   run fmtcli-concatenate-strings in this-procedure (
      278                         input v-fmtcli-full-addres
      279                       , input v-fmtcli-country
      280                       , input ", ":U
      281                       , input 50
      282                       , output v-fmtcli-full-addres
      283                   ).
      284                   run fmtcli-concatenate-strings in this-procedure (
      285                         input v-fmtcli-full-addres
      286                       , input v-fmtcli-city
      287                       , input ", ":U
      288                       , input 50
      289                       , output v-fmtcli-full-addres
      290                   ).
      291                   run fmtcli-concatenate-strings in this-procedure (
      292                         input v-fmtcli-full-addres
      293                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      294                       , input ", ":U
      295                       , input 50
      296                       , output v-fmtcli-full-addres
      297                   ).
      298                   run fmtcli-concatenate-strings in this-procedure (
      299                         input v-fmtcli-post-addres
      300                       , input v-fmtcli-country
      301                       , input ", ":U
      302                       , input 50
      303                       , output v-fmtcli-post-addres
      304                   ).
      305                   run fmtcli-concatenate-strings in this-procedure (
      306                         input v-fmtcli-post-addres
      307                       , input v-fmtcli-city
      308                       , input ", ":U
      309                       , input 50
      310                       , output v-fmtcli-post-addres
      311                   ).
      312                   run fmtcli-concatenate-strings in this-procedure (
      313                         input v-fmtcli-post-addres
      314                       , input string( buf_firm.ind )
      315                       , input ", ":U
      316                       , input 50
      317                       , output v-fmtcli-post-addres
      318                   ).
      319                   run fmtcli-concatenate-strings in this-procedure (
      320                         input substring( buf_firm.addres1, 1, 50 )
      321                       , input buf_firm.addres2
      322                       , input " ":U
      323                       , input 50
      324                       , output v-temp-fmtcli-address
      325                   ).
      326                   run fmtcli-concatenate-strings in this-procedure (
      327                         input v-temp-fmtcli-address
      328                       , input substring( buf_firm.addres1, 51, 50 )
      329                       , input " ":U
      330                       , input 50
      331                       , output v-temp-fmtcli-address
      332                   ).
      333                   run fmtcli-concatenate-strings in this-procedure (
      334                         input v-temp-fmtcli-address
      335                       , input substring( buf_firm.addres1, 101, 50 )
      336                       , input " ":U
      337                       , input 50
      338                       , output v-temp-fmtcli-address
      339                   ).
      340                   assign
      341                       v-fmtcli-addres = v-temp-fmtcli-address
      342                   .
      343                   if buf_firm.addres1 <> ?
      344                   then do:
      345                       run fmtcli-concatenate-strings in this-procedure (
      346                             input v-fmtcli-full-addres
      347                           , input v-fmtcli-addres
      348                           , input ", ":U
      349                           , input 0
      350                           , output v-fmtcli-full-addres
      351                       ).
      352                   end.
      353                   run fmtcli-concatenate-strings in this-procedure (
      354                         input substring( buf_firm.post-addr1, 1, 50 )
      355                       , input buf_firm.post-addr2
      356                       , input " ":U
      357                       , input 50
      358                       , output v-fmtcli-post-addres
      359                   ).
      360                   run fmtcli-concatenate-strings in this-procedure (
      361                         input v-fmtcli-post-addres
      362                       , input substring( buf_firm.post-addr1, 51, 50 )
      363                       , input " ":U
      364                       , input 50
      365                       , output v-fmtcli-post-addres
      366                   ).
      367                   run fmtcli-concatenate-strings in this-procedure (
      368                         input v-fmtcli-post-addres
      369                       , input substring( buf_firm.post-addr1, 101, 50 )
      370                       , input " ":U
      371                       , input 50
      372                       , output v-fmtcli-post-addres
      373                   ).
      374                   assign
      375                       v-fmtcli-phone         = buf_firm.phone
      376                       v-fmtcli-inn           = buf_firm.inn
      377                       v-fmtcli-kpp           = buf_firm.kpp
      378                       v-fmtcli-okpo          = buf_firm.okpo
      379                       v-fmtcli-index         = string( buf_firm.ind )
      380                   .
      381               end.
      382          end.
      383          when 'маг':U
      384          then do:
      385               find first buf_shop no-lock
      386                    where buf_shop.obj-code = buf_clients.obj-code
      387               .
      388               if available buf_shop
      389               then do:
      390                   run fmtcli-concatenate-strings in this-procedure (
      391                         input buf_shop.addres1
      392                       , input buf_shop.addres2
      393                       , input " ":U
      394                       , input 50
      395                       , output v-fmtcli-addres
      396                   ).
      397                   assign
      398                       v-fmtcli-full-addres = v-fmtcli-addres
      399                       v-fmtcli-post-addres = v-fmtcli-addres
      400                       v-fmtcli-phone       = buf_shop.phone
      401                       v-fmtcli-inn         = "":U
      402                       v-fmtcli-kpp         = "":U
      403                       v-fmtcli-okpo        = "":U
      404                       v-fmtcli-city        = "":U
      405                       v-fmtcli-index       = "":U
      406                   .
      407               end.
      408          end.
      409          when 'скл':U
      410          then do:
      411               find first buf_store no-lock
      412                    where buf_store.obj-code = buf_clients.obj-code
      413               .
      414               if available buf_store
      415               then do:
      416                   run fmtcli-concatenate-strings in this-procedure (
      417                         input buf_store.addres1
      418                       , input buf_store.addres2
      419                       , input " ":U
      420                       , input 50
      421                       , output v-fmtcli-addres
      422                   ).
      423                   assign
      424                       v-fmtcli-full-addres = v-fmtcli-addres
      425                       v-fmtcli-phone       = buf_store.phone
      426                       v-fmtcli-inn         = "":U
      427                       v-fmtcli-kpp         = "":U
      428                       v-fmtcli-okpo        = "":U
      429                       v-fmtcli-city        = "":U
      430                       v-fmtcli-index       = "":U
      431                   .
      432               end.
      433          end.
      434          when 'чел':U
      435          then do:
      436               find first buf_person no-lock
      437                    where buf_person.psn-code = buf_clients.obj-code
      438               .
      439               if available buf_person
      440               then do:
      441                   run fmtcli-concatenate-strings in this-procedure (
      442                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      443                                 then "":U
      444                                 else string( buf_person.ind, "999999")
      445                                 )
      446                       , input buf_person.city
      447                       , input ", ":U
      448                       , input 0
      449                       , output v-fmtcli-full-addres
      450                   ).
      451                   assign
      452                       v-fmtcli-addres = buf_person.address
      453                   .
      454                   run fmtcli-concatenate-strings in this-procedure (
      455                         input v-fmtcli-full-addres
      456                       , input v-fmtcli-addres
      457                       , input ", ":U
      458                       , input 0
      459                       , output v-fmtcli-full-addres
      460                   ).
      461                   assign
      462                       v-fmtcli-phone     = buf_person.phone1
      463                       v-fmtcli-inn       = buf_person.inn
      464                       v-fmtcli-kpp       = buf_person.kpp
      465                       v-fmtcli-okpo      = buf_person.okpo
      466                       v-fmtcli-city      = buf_person.city
      467                       v-fmtcli-index     = string( buf_person.ind )
      468                   .
      469               end.
      470          end.
      471       end case.
      472   end.
      473   end procedure.
      474   procedure fmtcli-concatenate-strings :
      475   define input parameter p-string-1       as character        no-undo.
      476   define input parameter p-string-2       as character        no-undo.
      477   define input parameter p-delimiter      as character        no-undo.
      478   define input parameter p-length         as integer          no-undo.
      479   define output parameter p-out-string    as character        no-undo.
      480   do
      481   on error undo, return error
      482   :
      483       assign
      484           p-out-string = ( if p-string-1 = ?
      485                            then "":U
      486                            else trim( p-string-1 ) )
      487       .
      488       assign
      489           p-out-string = p-out-string
      490                        + ( if p-out-string = "":U
      491                            or length( p-out-string ) = p-length
      492                            or p-string-2 = ?
      493                            or trim( p-string-2 ) = "":U
      494                            then "":U
      495                            else p-delimiter )
      496                        + ( if p-string-2 = ?
      497                            or trim( p-string-2 ) = "":U
      498                            then "":U
      499                            else trim( p-string-2 ) )
      500       .
      501   end.
      502   end procedure.
      503   define variable vss-include-info3 as character format "X(65)" no-undo
      504   initial "@(#)$Workfile$ $Revision$".
      505   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      508   define variable par-type          as character no-undo.
      509   define variable v-value-character as character no-undo .
      510   define variable v-value-date      as date      no-undo .
      511   define variable v-value-decimal   as decimal   no-undo .
      512   define variable v-value-integer   as integer   no-undo .
      513   define variable v-value-logical   as logical   no-undo .
      514   define variable v-torgconf-ext-doc-type as character    no-undo.
      515   define variable v-torgconf-outdate   as logical  init no    no-undo.
      516   define variable v-torgconf-outnum    as logical  init no    no-undo.
