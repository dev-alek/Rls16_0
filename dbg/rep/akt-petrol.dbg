     3510   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3511   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3512   procedure paramls-clear :
     3513     define buffer buf_temp-param for temp-param .
     3514     do
     3515     on error undo, return error return-value
     3516     :
     3517       for each buf_temp-param
     3518       on error undo, return error
     3519       :
     3520         delete buf_temp-param .
     3521       end.
     3522     end.
     3523   end procedure.
     3524   procedure paramls-write :
     3525     define input  parameter p-code     as character no-undo .
     3526     define input  parameter p-sub-code as character no-undo .
     3527     define input  parameter p-value    as character no-undo .
     3528     define buffer buf_temp-param for temp-param .
     3529     do
     3530     on error undo, return error return-value
     3531     :
     3532       find first buf_temp-param
     3533         where buf_temp-param.param-code     = p-code
     3534           and buf_temp-param.param-sub-code = p-sub-code
     3535         no-error .
     3536       if not available buf_temp-param then do:
     3537         create buf_temp-param .
     3538         assign
     3539           buf_temp-param.param-code     = p-code
     3540           buf_temp-param.param-sub-code = p-sub-code
     3541         .
     3542       end.
     3543       assign
     3544         buf_temp-param.param-value = p-value
     3545       .
     3546     end.
     3547   end procedure.
     3548   procedure paramls-read :
     3549     define input  parameter p-code          as character no-undo .
     3550     define input  parameter p-sub-code      as character no-undo .
     3551     define input  parameter p-default-value as character no-undo .
     3552     define output parameter p-value         as character no-undo .
     3553     define buffer buf_temp-param for temp-param .
     3554     do
     3555     on error undo, return error return-value
     3556     :
     3557       find first buf_temp-param
     3558         where buf_temp-param.param-code     = p-code
     3559           and buf_temp-param.param-sub-code = p-sub-code
     3560         no-error .
     3561       if available buf_temp-param then do:
     3562         assign
     3563           p-value = buf_temp-param.param-value
     3564         .
     3565       end.
     3566       else do:
     3567         assign
     3568           p-value = p-default-value
     3569         .
     3570       end.
     3571     end.
     3572   end procedure.
     3573   procedure paramls-append :
     3574     define input  parameter p-code     as character no-undo .
     3575     define input  parameter p-sub-code as character no-undo .
     3576     define input  parameter p-value    as character no-undo .
     3577     define buffer buf_temp-param for temp-param .
     3578     do
     3579     on error undo, return error return-value
     3580     :
     3581       find first buf_temp-param
     3582            where buf_temp-param.param-code     = p-code
     3583              and buf_temp-param.param-sub-code = p-sub-code
     3584         no-error .
     3585       if not available buf_temp-param then do:
     3586         create buf_temp-param .
     3587         assign
     3588           buf_temp-param.param-code     = p-code
     3589           buf_temp-param.param-sub-code = p-sub-code
     3590           buf_temp-param.param-value    = p-value
     3591         .
     3592       end.
     3593       else do:
     3594           assign
     3595               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     3596           .
     3597       end.
     3598     end.
     3599   end procedure.
