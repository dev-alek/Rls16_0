     5204         '<TD colspan="6"></TD>'
     5205         '</TR>'skip
     5206         .
     5207     end.
     5208     put stream OutStr-html unformatted
     5209       '</tfoot>' skip
     5210       '</table>' skip
     5211       '</body>' skip
     5212       '</html>' skip
     5213       .
     5214     output stream OutStr-html close.
     5215     run prn-lib-reportviewer-report-name in this-procedure (
     5216       input THIS-PROCEDURE
     5217       ,input v-file-name-rep-htm
     5218       ).
     5219   end.
     5220   procedure doc-attr-write:
     5221     DEFINE input PARAMETER   p-doc-code      as character    no-undo .
     5222     DEFINE INPUT PARAMETER   p-attr-code     as character    no-undo .
     5223     DEFINE OUTPUT PARAMETER  p-attr-value    as character    no-undo .
     5224     find first buf_doc-attr no-lock where buf_doc-attr.doc-code = p-doc-code
     5225       and buf_doc-attr.attr-code = p-attr-code no-error .
     5226     if AVAILABLE buf_doc-attr then
     5227     do:
     5228       p-attr-value = buf_doc-attr.attr-value .
     5229     end.
     5230   end.
     5231   procedure person-write:
     5232     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     5233     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     5234     define OUTPUT PARAMETER  p-position      as CHARACTER       NO-UNDO .
     5235     define variable v-name as character no-undo .
     5236     define buffer buf_person for ub.person .
     5237     find first buf_person no-lock where buf_person.psn-code = p-obj-code no-error .
     5238     if AVAILABLE buf_person then
     5239     do:
     5240       run rep/get-psn.p(input buf_person.psn-code, output v-name ).
     5241       p-obj-name = v-name + '  ' + buf_person.name1 + ' ':U + buf_person.name2.
     5242       p-position = buf_person.position .
     5243     end.
     5244   end.
     5245   procedure clients-write:
     5246     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     5247     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     5248     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     5249     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     5250       and buf_clients.obj-type = p-obj-type no-error .
     5251     if AVAILABLE buf_clients then
     5252     do:
     5253       p-obj-name = buf_clients.obj-name .
     5254     end.
     5255   end.
     5256   PROCEDURE get-report-num :
     5257     define output parameter p-report-num as integer no-undo .
     5258     do
     5259       on error undo, return error return-value
     5260       :
     5261       run gbl/getrpnum.p (output p-report-num).
     5262     end.
     5263   END PROCEDURE.
     5264   procedure get-DD-Month-YYYY:
     5265     define input parameter p-dat-date as date no-undo.
     5266     define output parameter p-str-date as character no-undo.
     5267     define variable v-str-date  as character no-undo.
     5268     define variable v-str-day   as character no-undo.
     5269     define variable v-num-month as character no-undo.
     5270     define variable v-str-month as character no-undo.
     5271     define variable v-str-year  as character no-undo.
     5272     v-str-date = string(p-dat-date).
     5273     do:
     5274       v-str-day = string(entry(1, v-str-date, "/")).
     5275     end.
     5276     do:
     5277       v-num-month = entry(2, v-str-date, "/").
     5278       v-str-month = MonthNameRusCase(integer(v-num-month), 2).
     5279     end.
     5280     do:
     5281       v-str-year = string(year(p-dat-date)).
     5282     end.
     5283     p-str-date = '" ' + v-str-day + ' "' + " " + v-str-month + " " + v-str-year + " г.".
     5284   end procedure.
     5285   procedure print-table1:
     5286     put stream OutStr-html unformatted
     5287       '<TR>' skip
     5288       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Дата и номер ТТН (ТН)</TD>' skip
     5289       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Тип АЦ</TD>' skip
     5290       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Номер АЦ</TD>' skip
     5291       '<TD text_wrap="true" rowspan="2" style="text-align: center;">Наименование нефтепродуктов</TD>' skip
     5292       '<TD text_wrap="true" colspan="5" style="text-align: center;">Показатели по ТТН (ТН)</TD>' skip
     5293       '<TD text_wrap="true" colspan="9" style="text-align: center;">Результаты измерений в АЦ/приемном резервуаре</TD>' skip
     5294       '</TR>'skip
     5295       '<TR style="height: 20px;">' skip
     5296       '<TD text_wrap="true" style="text-align: center;">объем (1), л</TD>' skip
     5297       '<TD text_wrap="true" colspan="2" style="text-align: center;">плотность (2), кг/м3</TD>' skip
     5298       '<TD text_wrap="true" style="text-align: center;">температура,С </TD>' skip
     5299       '<TD text_wrap="true" style="text-align: center;">масса, кг</TD>' skip
     5300       '<TD text_wrap="true" colspan="2" style="text-align: center; height: 25px;">фактический уровень наполнения (3), мм</TD>' skip
     5301       '<TD text_wrap="true" colspan="2" style="text-align: center;">объем, м3</TD>' skip
     5302       '<TD text_wrap="true" colspan="2" style="text-align: center;">плотность, кг/м3</TD>' skip
     5303       '<TD text_wrap="true" style="text-align: center;">температура,С </TD>' skip
     5304       '<TD text_wrap="true" colspan="2" style="text-align: center;">масса, кг</TD>' skip
     5305       '</TR>'skip
     5306       '<TR>' skip
     5307       '<TD style="text-align: center;">1</TD>' skip
     5308       '<TD style="text-align: center;">2</TD>' skip
     5309       '<TD style="text-align: center;">3</TD>' skip
     5310       '<TD style="text-align: center;">4</TD>' skip
     5311       '<TD style="text-align: center;">5</TD>' skip
     5312       '<TD colspan="2" style="text-align: center;">6</TD>' skip
     5313       '<TD style="text-align: center;">7</TD>' skip
     5314       '<TD style="text-align: center;">8</TD>' skip
     5315       '<TD colspan="2" style="text-align: center;">9</TD>' skip
     5316       '<TD colspan="2" style="text-align: center;">10</TD>' skip
     5317       '<TD colspan="2" style="text-align: center;">11</TD>' skip
     5318       '<TD style="text-align: center;">12</TD>' skip
     5319       '<TD colspan="2"  style="text-align: center;">13</TD>' skip
     5320       '</TR>'skip
     5321       .
     5322     for each tt-petrol:
     5323       put stream OutStr-html unformatted
     5324         '<TR>' skip
     5325         '<TD text_wrap="true" style="text-align: center;">' + string(tt-petrol.num-TH) + " " + string(tt-petrol.date-TH) + '</TD>' skip
     5326         '<TD text_wrap="true" style="text-align: center;">' + string(tt-petrol.type-AC) + '</TD>' skip
     5327         '<TD text_wrap="true" style="text-align: center;">' + string(tt-petrol.num-AC) + '</TD>' skip
     5328         '<TD text_wrap="true" style="text-align: center;">' + if tt-petrol.name-gds <> ? then string(tt-petrol.name-gds) + '</TD>' else " "  + '</TD>' skip
     5329         '<TD text_wrap="true" num="0" val="' + fnc-convert-dot-to-colon(tt-petrol.vol-TH,"->>>>>>>>>>>9",0) + '" style="text-align: center;">' + fnc-convert-dot-to-colon(tt-petrol.vol-TH,"->>>>>>>>>>>9",0) + '</TD>' skip
     5330         '<TD text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.density-TH,"->>>>>>>>>>>9.9",1) + '" colspan="2" style="text-align: center;">' + fnc-convert-dot-to-colon(tt-petrol.density-TH,"->>>>>>>>>>>9.9",1) + '</TD>' skip
     5331         '<TD text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.temp-TH,"->>>>>>>>>>>9.9",1) + '" style="text-align: center;">' + fnc-convert-dot-to-colon(tt-petrol.temp-TH,"->>>>>>>>>>>9.9",1) + '</TD>' skip
     5332         '<TD text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.weight-TH,"->>>>>>>>>>>9.9",1) + '" style="text-align: center;">' + fnc-convert-dot-to-colon(tt-petrol.weight-TH,"->>>>>>>>>>>9.9",1) + '</TD>' skip
     5333       .
     5334       if tt-petrol.urov-AC = "SGDKK"
     5335       then do :
     5336         put stream OutStr-html unformatted
     5337         '<TD text_wrap="true" colspan="2" style="text-align: center;"> </TD>' skip
     5338         '<TD colspan="2";></TD>' skip
     5339         '<TD colspan="2";></TD>' skip
     5340         '<TD></TD>' skip
     5341         '<TD colspan="2";></TD>' skip
     5342         '</TR>'skip
     5343         .
     5344       end .
     5345       else do :
     5346         put stream OutStr-html unformatted
     5347         '<TD text_wrap="true" colspan="2" style="text-align: center;">' + tt-petrol.urov-AC + '</TD>' skip
     5348         '<TD text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-petrol.vol-AC,"->>>>>>>>>>>9.999",3) + '" colspan="2"  style="text-align: center;">' + fnc-convert-dot-to-colon(tt-petrol.vol-AC,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     5349         '<TD text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.density-AC,"->>>>>>>>>>>9.9",1) + '" colspan="2"  style="text-align: center;">' + (if tt-petrol.density-AC = ? then " " else fnc-convert-dot-to-colon(tt-petrol.density-AC,"->>>>>>>>>>>9.9",1)) + '</TD>' skip
     5350         '<TD text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.temp-AC,"->>>>>>>>>>>9.9",1) + '" style="text-align: center;">' + (if tt-petrol.temp-AC = ? then " " else fnc-convert-dot-to-colon(tt-petrol.temp-AC,"->>>>>>>>>>>9.9",1)) + '</TD>' skip
     5351         '<TD text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.weight-AC,"->>>>>>>>>>>9.9",1) + '" colspan="2"  style="text-align: center;">' + fnc-convert-dot-to-colon(tt-petrol.weight-AC,"->>>>>>>>>>>9.9",1) + '</TD>' skip
     5352         '</TR>'skip
     5353         .
     5354       end .
     5355     end.
     5356   end procedure .
