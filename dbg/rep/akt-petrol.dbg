     4899       .
     4900   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     4901                           input 'nids':U ,
     4902                          output v-attr-value ,
     4903                          output v-attr-type )  .
     4904     if v-attr-value > "" then
     4905     do :
     4906       assign
     4907         v-nakl = v-attr-value .
     4908     end .
     4909     else
     4910     do :
     4911       assign
     4912         v-nakl = buf_trn-doc.doc-code .
     4913     end.
     4914   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     4915                           input 'dids':U ,
     4916                          output v-attr-value ,
     4917                          output v-attr-type )  .
     4918     if v-attr-value > "" then v-date = v-attr-value.
     4919     else
     4920     do :
     4921       if integer(substring(string(date(buf_trn-doc.doc-date), "99/99/9999") , 1, 2)) > 12
     4922         then v-date = string(date(buf_trn-doc.doc-date), "99/99/9999").
     4923       else v-date = substring(string(date(buf_trn-doc.doc-date), "99/99/9999") , 4, 3)
     4924           + substring(string(date(buf_trn-doc.doc-date), "99/99/9999") , 1, 3)
     4925           + substring(string(date(buf_trn-doc.doc-date), "99/99/9999") , 7, 4).
     4926     end.
     4927     for first ub.auto-tank no-lock where ub.auto-tank.auto-num = v-car-num:
     4928       case ub.auto-tank.type-AC:
     4929         when 1 then
     4930           do:
     4931             v-car-type = "Бензовоз" .
     4932           end.
     4933         when 2 then
     4934           do:
     4935             v-car-type = "Газовоз" .
     4936           end.
     4937       end case .
     4938     end.
     4939     if sgdkk then v-car-type = "СЭП" .
     4940     if v-car-type = "" then v-car-type = "Бензовоз" .
     4941     next_:
     4942     for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     4943   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4944     (
     4945        input buf_doc-line.artic
     4946     ,  input buf_doc-line.prod-type
     4947     ,  input buf_doc-line.prod-code
     4948     , output is-petrolium
     4949     , output is-pieces
     4950     ) no-error.
     4951       if error-status :error
     4952         then
     4953       do:
     4954         return error return-value .
     4955       end.
     4956       if is-petrolium then
     4957       do
     4958         :
     4959         find first buf_goods where buf_goods.artic = buf_doc-line.artic
     4960           and buf_goods.prod-code = buf_doc-line.prod-code
     4961           and buf_goods.prod-type = buf_doc-line.prod-type no-lock no-error.
     4962         if AVAILABLE buf_goods then
     4963         do:
     4964           assign
     4965             v-doc-code = buf_trn-doc.doc-code
     4966             .
     4967           if buf_goods.engl-name = "" or buf_goods.engl-name = ? then v-gds-name = buf_goods.gds-name .
     4968           else v-gds-name = buf_goods.engl-name .
     4969           run gds-attr-value in this-procedure
     4970             (  input buf_goods.gds-code
     4971             ,input 'fuel-type':U
     4972             ,output v-attr-value
     4973             ,output v-attr-type
     4974             ) .
     4975           if v-attr-value = "lgas" then
     4976           do:
     4977             next next_  .
     4978           end.
     4979           v-InfoSectionsTotal:Initialization(v-doc-code, buf_goods.gds-code).
     4980           v-InfoSectionsTotal:GetDBAllAttr().
     4981           do iNum = 1 to v-InfoSectionsTotal:SectionNum:
     4982             v-InfoSection = v-InfoSectionsTotal:GetInfoSectionProp(iNum) .
     4983             assign
     4984               v-num-prob       = v-InfoSection:Tests
     4985               v-norm-doc       = v-InfoSection:NormDoc
     4986               v-kol-prob       = v-InfoSection:KolProb
     4987               v-tank-vol       = v-InfoSection:TankVol
     4988               v-tank-density   = v-InfoSection:TankDensity
     4989               v-tank-weight    = v-InfoSection:TankWeight / 1000
     4990               v-tank-temp      = v-InfoSection:DensTemp
     4991               v-date-prob      = v-InfoSection:DateProb
     4992               v-hour-prob      = v-InfoSection:HourProb
     4993               v-min-prob       = v-InfoSection:MinProb
     4994               v-num-print-prob = v-InfoSection:NumPrintProb
     4995               v-car-vol        = v-InfoSection:CarVol
     4996               v-mouth          = v-InfoSection:Mouth
     4997               .
     4998             if v-komis <> yes then v-komis          = v-InfoSection:IsKP .
     4999             create tt-petrol .
     5000             assign
     5001               tt-petrol.num-TH      = v-nakl
     5002               tt-petrol.date-TH     = v-date
     5003               tt-petrol.num-AC      = v-car-num
     5004               tt-petrol.type-AC     = v-car-type
     5005               tt-petrol.num-section = v-InfoSectionsTotal:SectionNum
     5006               .
     5007             assign
     5008               tt-petrol.name-gds   = v-gds-name
     5009               tt-petrol.vol-TH     = decimal(v-InfoSection:DocQnty)
     5010               tt-petrol.density-TH = decimal(v-InfoSection:DocDensity) * 1000
     5011               tt-petrol.temp-TH    = decimal(v-InfoSection:TTNTemp)
     5012               .
     5013             tt-petrol.weight-TH   = tt-petrol.vol-TH  * tt-petrol.density-TH / 1000.
     5014             if v-InfoSection:ABTarir <> 0 then
     5015             do:
     5016               tt-petrol.urov-AC = string(((v-InfoSection:ABTarir) * 100),"->>>>>>>>>>>9,99") .
     5017             end.
     5018             else
     5019             do:
     5020               tt-petrol.urov-AC = "по планку".
     5021             end.
     5022             assign
     5023               tt-petrol.vol-AC     = decimal(v-InfoSection:TankVol) / 1000
     5024               tt-petrol.density-AC = decimal(v-InfoSection:TankDensity) * 1000
     5025               tt-petrol.temp-AC    = decimal(v-InfoSection:DensTemp)
     5026               tt-petrol.weight-AC  = decimal(v-InfoSection:TankWeight)
     5027               tt-petrol.passport   = v-InfoSection:NumPassport
     5028               .
     5029             assign
     5030               tt-petrol.limit      = v-InfoSection:AccAbsFact
     5031               tt-petrol.weight-est = v-InfoSection:NaturalLoss
     5032               tt-petrol.deficit    = v-InfoSection:Deficit
     5033               tt-petrol.excess     = v-InfoSection:Excess
     5034               tt-petrol.weight-pri = v-InfoSection:FactKgQnty
     5035               tt-petrol.num-pl     = v-InfoSection:ListTank
     5036               .
     5037             pl_ :
     5038             for each buf_place no-lock where buf_place.obj-type = buf_doc-line.obj-type
     5039                                          and buf_place.obj-code = buf_doc-line.obj-code
     5040                                          and buf_place.loc1     = tt-petrol.num-pl :
     5041               find first buf_doc-pl no-lock where buf_doc-pl.obj-type = buf_doc-line.obj-type
     5042                                               and buf_doc-pl.obj-code = buf_doc-line.obj-code
     5043                                               and buf_doc-pl.out-code = buf_doc-line.doc-code
     5044                                               and buf_doc-pl.gds-code = buf_goods.gds-code
     5045                                               and buf_doc-pl.pl-code  = buf_place.pl-code
     5046                                               no-error .
     5047               if available buf_doc-pl
     5048               then do :
     5049                 leave pl_ .
     5050               end .
     5051             end .
     5052             find last buf_c-place-attr no-lock where buf_c-place-attr.obj-type  = buf_place.obj-type
     5053                                                  and buf_c-place-attr.obj-code  = buf_place.obj-code
     5054                                                  and buf_c-place-attr.pl-code   = buf_place.pl-code
     5055                                                  and buf_c-place-attr.attr-code = "place-com-tanks"
     5056                                                  and (buf_c-place-attr.corr-date < buf_trn-doc.fact-date
     5057                                                    or buf_c-place-attr.corr-date = buf_trn-doc.fact-date and buf_c-place-attr.corr-time < buf_trn-doc.fact-time)
     5058                                                  no-error .
     5059             if available buf_c-place-attr
     5060             then do :
     5061               find first buf2_c-place-attr no-lock where buf2_c-place-attr.obj-type = buf_c-place-attr.obj-type
     5062                                                      and buf2_c-place-attr.obj-code = buf_c-place-attr.obj-code
     5063                                                      and buf2_c-place-attr.pl-code  = buf_c-place-attr.pl-code
     5064                                                      and buf2_c-place-attr.attr-code = buf_c-place-attr.attr-code
     5065                                                      and buf2_c-place-attr.chip-num > buf_c-place-attr.chip-num
     5066                                                      no-error .
     5067               if available buf2_c-place-attr
     5068               then do :
     5069                 if buf2_c-place-attr.attr-value > ""
     5070                 then do :
     5071                   assign
     5072                     tt-petrol.num-pl  = buf_place.loc1 + "," + buf2_c-place-attr.attr-value
     5073                   .
     5074                 end .
     5075               end .
     5076               else do :
     5077                 run placelib_get-attr  ( input "place-com-tanks"
     5078                   ,input buf_place.obj-code
     5079                   ,input buf_place.obj-type
     5080                   ,input buf_place.pl-code
     5081                   ,output varvalue
     5082                   ,output v-ok      ) no-error.
     5083                 if v-ok
     5084                 and varvalue > ""
     5085                 then do :
     5086                   assign
     5087                     tt-petrol.num-pl  = buf_place.loc1 + "," + varvalue
     5088                   .
     5089                 end .
     5090               end .
     5091             end .
     5092             else do :
     5093               run placelib_get-attr  ( input "place-com-tanks"
     5094                 ,input buf_place.obj-code
     5095                 ,input buf_place.obj-type
     5096                 ,input buf_place.pl-code
     5097                 ,output varvalue
     5098                 ,output v-ok      ) no-error.
     5099               if v-ok
     5100               and varvalue > ""
     5101               then do :
     5102                 assign
     5103                   tt-petrol.num-pl  = buf_place.loc1 + "," + varvalue
     5104                 .
     5105               end .
     5106             end .
     5107             if sgdkk
     5108             and not v-InfoSection:IsKP
     5109             then do :
     5110               tt-petrol.urov-AC = "SGDKK".
     5111             end .
     5112             if v-InfoSection:IsKP
     5113             and v-InfoSection:AccMeth = 1
     5114             then do :
     5115               tt-petrol.urov-AC = "".
     5116               tt-petrol.density-AC = ? .
     5117               tt-petrol.temp-AC    = ? .
     5118               tt-petrol.vol-AC     = decimal(v-InfoSection:TankVolPomiRvs) / 1000 .
     5119               tt-petrol.weight-AC  = v-InfoSection:TankWeightRvs .
     5120             end .
     5121           end.
     5122         end.
     5123       end.
     5124     end.
     5125     run print-table1 no-error .
     5126     run print-table2 no-error .
     5127     put stream OutStr-html unformatted
     5128       '</tbody>' skip
     5129       '<tfoot>' skip
     5130       '<TR><TD colspan="18" style="height: 14px;"></TD></TR>' skip
     5131       '<TR><TD colspan="18" style="font-style: italic;">Примечания:</TD></TR>' skip
     5132       '<TR><TD text_wrap="true" colspan="18" style="font-style: italic;">1 - используется расчётное значение, является информационным</TD></TR>' skip
     5133       '<TR><TD text_wrap="true" colspan="18" style="font-style: italic;">2 - указывается с обозначением метода определения плотности у поставщика</TD></TR>' skip
     5134       '<TR><TD text_wrap="true" colspan="18" style="font-style: italic;">3 - указывается - "по планку", или величина отклонения уровня от планки со знаком "+" если фактический уровень нефтепродукта выше планки, и "-", если ниже. Если горловина отсутствует (планка находится вне горловины) - указываются только знаки - "+" или "-"</TD></TR>' skip
     5135       '<TR><TD text_wrap="true" colspan="18" style="font-style: italic;">Записи в таблице делаются построчно для каждой группы (подгруппы, марки) нефтепродукта. Построчно делаются записи и для одной марки нефтепродукта, если при его приеме происходит смена приемного резервуара.</TD></TR>' skip
     5136       '<TR><TD text_wrap="true" colspan="18" style="font-style: italic;">При приеме на АЗС/АЗК АЦ, оборудованных СЭП, в случае, если при распечатке чек-отчета СЭП не выявлено инцидентом в пути следования нефтепродукта, графы 9-13, 15-17 не заполняются, в графе 18 указывается значение, соответствующее значению, указанному в графе 8.</TD></TR>' skip
     5137       '<TR><TD colspan="18" style="height: 14px;"></TD></TR>' skip
     5138       '<TR><TD text_wrap="true" colspan="18" style="">6. Прилагаемые к акту документы ________________________________________________________________________</TD></TR>' skip
     5139       '<TR><TD text_wrap="true" colspan="18" style="">7. Время: начала приема ____ ч ______ мин</TD></TR>' skip
     5140       '<TR><TD text_wrap="true" colspan="18" style="">          окончания приема ____ ч ______ мин.</TD></TR>' skip
     5141       '<TR><TD colspan="18" style="height: 14px;"></TD></TR>' skip
     5142       '<TR>' skip
     5143       '<TD colspan="3"></TD>'
     5144       '<TD colspan="2" style="">Подпись (и)</TD>' skip
     5145       '<TD colspan="7" style="text-align: center;">' + v-fio-position + " " + v-fio + '</TD>'
     5146       '<TD colspan="6"></TD>'
     5147       '</TR>'skip
     5148       '<TR>' skip
     5149       '<TD colspan="3"></TD>'
     5150       '<TD colspan="2" style=""></TD>' skip
     5151       '<TD colspan="7" style="border-top: 1px solid black;">должность, Ф.И.О. работника АЗС/АЗК (членов комиссии)</TD>'
     5152       '<TD colspan="6"></TD>'
     5153       '</TR>'skip
     5154       '<TR>' skip
     5155       '<TD colspan="3"></TD>'
     5156       '<TD colspan="2" style="height: 14px;"></TD>' skip
     5157       '<TD colspan="7" style="text-align: center;">' + v-driver + '</TD>'
     5158       '<TD colspan="6"></TD>'
     5159       '</TR>'skip
     5160       '<TR>' skip
     5161       '<TD colspan="3"></TD>'
     5162       '<TD colspan="2" style=""></TD>' skip
     5163       '<TD colspan="7" style="border-top: 1px solid black;">должность, Ф.И.О. водителя АЦ</TD>'
     5164       '<TD colspan="6"></TD>'
     5165       '</TR>'skip
     5166       .
     5167     if v-komis = yes then
     5168     do:
     5169       put stream OutStr-html unformatted
     5170         '<TR>' skip
     5171         '<TD colspan="3"></TD>'
     5172         '<TD colspan="2" style="">Состав комиссии:</TD>' skip
     5173         '<TD colspan="7" style="text-align: center;"></TD>'
     5174         '<TD colspan="6"></TD>'
     5175         '</TR>'skip
     5176         '<TR>' skip
     5177         '<TD colspan="3"></TD>'
     5178         '<TD colspan="2" style="height: 14px;"></TD>' skip
     5179         '<TD colspan="7" style="border-top: 1px solid black;"></TD>'
     5180         '<TD colspan="6"></TD>'
     5181         '</TR>'skip
     5182         '<TR>' skip
     5183         '<TD colspan="3"></TD>'
     5184         '<TD colspan="2" style="height: 14px;"></TD>' skip
     5185         '<TD colspan="7" style="text-align: center;"></TD>'
     5186         '<TD colspan="6"></TD>'
     5187         '</TR>'skip
     5188         '<TR>' skip
     5189         '<TD colspan="3"></TD>'
     5190         '<TD colspan="2" style="height: 14px;"></TD>' skip
     5191         '<TD colspan="7" style="border-top: 1px solid black;"></TD>'
     5192         '<TD colspan="6"></TD>'
     5193         '</TR>'skip
     5194         '<TR>' skip
     5195         '<TD colspan="3"></TD>'
     5196         '<TD colspan="2" style="height: 14px;"></TD>' skip
     5197         '<TD colspan="7" style="text-align: center;"></TD>'
     5198         '<TD colspan="6"></TD>'
     5199         '</TR>'skip
     5200         '<TR>' skip
