     4855       .
     4856     if v-doc-not = "НЕ ПРЕДОСТАВЛЕНЫ" then
     4857     do:
     4858       put stream OutStr-html unformatted
     4859         '<TR>' skip
     4860         '<TD colspan="10" style="height: 14px;">Не предоставлены: ' + v-spisok-doc + '</TD>' skip
     4861         '</TR>'skip
