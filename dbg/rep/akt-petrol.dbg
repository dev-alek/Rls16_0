     5415         '<TD text_wrap="true" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.deficit,"->>>>>>>>>>9.9",1) + '" style="text-align: center;">' + (if tt-petrol.limit = ? then " " else fnc-convert-dot-to-colon(tt-petrol.deficit,"->>>>>>>>>>9.9",1)) + '</TD>' skip
     5416         '<TD text_wrap="true" colspan="2" num="0.0" val="' + fnc-convert-dot-to-colon(tt-petrol.excess,"->>>>>>>>>>9.9",1) + '" style="text-align: center;">' + (if tt-petrol.limit = ? then " " else fnc-convert-dot-to-colon(tt-petrol.excess,"->>>>>>>>>>9.9",1)) + '</TD>' skip
     5417         .
     5418       end .
