      836          "Object ":U THIS-PROCEDURE:FILE-NAME
      837            "must have at least one Enabled Table to perform Assign.":U
      838              VIEW-AS ALERT-BOX ERROR.
      839      RETURN.
      840     END PROCEDURE.
      841   PROCEDURE adm-assign-statement :
      842     RETURN.
      843   END PROCEDURE.
      844   PROCEDURE adm-cancel-record :
      845      RETURN.
      846     END PROCEDURE.
      847   PROCEDURE adm-copy-record :
      848       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      849        "must have at least one Enabled Table to perform Copy.":U
      850          VIEW-AS ALERT-BOX ERROR.
      851       RETURN.
      852   END PROCEDURE.
      853   PROCEDURE adm-create-record :
      854      RETURN.
      855   END PROCEDURE.
      856   PROCEDURE adm-current-changed :
      857     RETURN.
      858   END PROCEDURE.
      859   PROCEDURE adm-delete-record :
      860    MESSAGE
      861          "Object ":U THIS-PROCEDURE:FILE-NAME
      862            "must have at least one Enabled Table to perform Delete.":U
      863              VIEW-AS ALERT-BOX ERROR.
      864       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      865       RETURN.
      866   END PROCEDURE.
      867   PROCEDURE adm-disable-fields :
      868         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      869       RETURN.
      870   END PROCEDURE.
      871   PROCEDURE adm-enable-fields :
      872       RETURN.
      873   END PROCEDURE.
      874   PROCEDURE adm-end-update :
      875     RETURN.
      876   END PROCEDURE.
      877   PROCEDURE adm-reset-record :
      878       RETURN.
      879   END PROCEDURE.
      880   PROCEDURE adm-update-record :
      881       MESSAGE
      882         "Object ":U THIS-PROCEDURE:FILE-NAME
      883           "must have at least one Enabled Table to perform Update.":U
      884             VIEW-AS ALERT-BOX ERROR.
      885      RETURN.
      886   END PROCEDURE.
      887   PROCEDURE check-modified :
      888   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      889   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      890   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      891   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      892     IF check-state = "check":U THEN
      893     DO:
      894       RUN get-link-handle IN adm-broker-hdl
      895         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      896            OUTPUT group-target-list).
      897       IF group-target-list NE "":U THEN
      898       DO i = 1 TO NUM-ENTRIES(group-target-list):
      899         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      900         RUN check-modified IN curr-widget ('group-check':U).
      901         IF RETURN-VALUE NE "":U THEN
      902         DO:
      903           RUN check-modified-message(RETURN-VALUE).
      904           RETURN "":U.
      905         END.
      906       END.
      907     END.
      908     RETURN "":U.
      909   END PROCEDURE.
      910   PROCEDURE check-modified-message :
      911     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      912        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      913           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      914        IF RETURN-VALUE = "YES":U THEN
      915           RUN notify ('view,CONTAINER-SOURCE':U).
      916        MESSAGE IF p-changed-table NE ? THEN
      917           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      918           ELSE "Current values have been changed."
      919           SKIP "  Do you wish to save those changes?"
      920           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      921        IF ANS THEN
      922        DO:
      923           IF group-assign-target THEN
      924             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      925           ELSE RUN dispatch('update-record':U).
      926           IF RETURN-VALUE = "ADM-ERROR":U THEN
      927           DO:
      928               MESSAGE "Changes to the previous record were not saved."
      929                 VIEW-AS ALERT-BOX ERROR.
      930               IF group-assign-target THEN
      931                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      932               ELSE RUN dispatch ('cancel-record':U).
      933           END.
      934        END.
      935        ELSE DO:
      936          IF group-assign-target THEN
      937             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      938          ELSE RUN dispatch('cancel-record':U).
      939        END.
      940        RETURN.
      941   END PROCEDURE.
      942   PROCEDURE get-rowid :
      943       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      944       ASSIGN
      945       p-table   =   adm-first-table.
      946       RETURN.
      947   END PROCEDURE.
      948   PROCEDURE init-group-assign :
      949       RUN request-attribute IN adm-broker-hdl
      950         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      951       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      952         group-assign-target = yes.
      953       ELSE group-assign-target = no.
      954       RETURN.
      955   END PROCEDURE.
      956   PROCEDURE set-editors :
      957       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      958       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      959       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      960       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      961       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      962       DO WHILE VALID-HANDLE (curr-widget):
      963           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      964              curr-widget:HIDDEN = no THEN DO:
      965             CASE p-field-setting:
      966               WHEN "INITIALIZE":U THEN
      967               DO:
      968                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      969                     read-only-list +
      970                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      971                        STRING(curr-widget).
      972               END.
      973               WHEN "DISABLE":U OR
      974               WHEN "ENABLE":U THEN
      975               DO:
      976                   curr-widget:SENSITIVE = yes.
      977                   RUN get-attribute ('Read-Only-Editors':U).
      978                   IF RETURN-VALUE = ? OR
      979                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      980                       curr-widget:READ-ONLY =
      981                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      982               END.
      983               WHEN "CLEAR":U THEN
      984                   curr-widget:SCREEN-VALUE = "":U.
      985             END CASE.
      986           END.
      987           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      988       END.
      989       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      990         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      991           + '"':U).
      992       RETURN.
      993   END PROCEDURE.
      994   PROCEDURE use-check-modified-all :
      995    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      996     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      997     RETURN.
      998   END PROCEDURE.
      999   PROCEDURE use-create-on-add :
     1000   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1001      RETURN.
     1002   END PROCEDURE.
     1003   PROCEDURE use-initial-lock :
     1004     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1005     ASSIGN adm-initial-lock = p-attr-value.
     1006     RETURN.
     1007   END PROCEDURE.
     1008     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1009   ASSIGN
     1010          FRAME F-Main:SCROLLABLE       = FALSE
     1011          FRAME F-Main:HIDDEN           = TRUE.
     1012   if not this-procedure :persistent
     1013   then do:
     1014     message
     1015       vss-workfile vss-revision vss-description skip
     1016       "Ошибка при запуске процедуры" skip
     1017       "Данную процедуру следует запускать только с параметром persistent" skip
     1018       view-as alert-box error .
     1019     undo, return error .
     1020   end.
     1021   PROCEDURE disable_UI :
     1022     HIDE FRAME F-Main.
     1023     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1024   END PROCEDURE.
     1025   PROCEDURE local-apply-layout :
     1026     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1027   END PROCEDURE.
     1028   PROCEDURE my-report :
     1029   run rep/r-balcnt.p ( itog-comp, itog-contract ) .
     1030   END PROCEDURE.
     1031   PROCEDURE my-var :
     1032     Assign frame F-Main itog-comp itog-contract .
     1033     find first clients no-lock where clients.obj-type = 'орг':U and clients.obj-code = v-cntxt-host-code-obj .
     1034     assign
     1035       ReportNAme = "Баланс фин.обязательств и выплат по контрагенту с: " + string(x-date-start,"99/99/9999") + "г. по: "  + string(x-date-end, "99/99/9999") + "г.".
     1036       str1 = "Фирма: " + clients.obj-name +  chr(10) .
     1037     .
     1038   END PROCEDURE.
     1039   PROCEDURE state-changed :
     1040     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1041     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1042     CASE p-state:
     1043       when "link-changed":U then  DO:
     1044            Run my-var.
     1045            End.
     1046     END CASE.
     1047   END PROCEDURE.
