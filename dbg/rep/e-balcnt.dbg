      637       ) .
      638   DEFINE RECTANGLE RECT-6
      639        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      640        SIZE 41.5 BY 4.63.
      641   DEFINE VARIABLE itog-comp AS LOGICAL INITIAL no
      642        LABEL "только итоги"
      643        VIEW-AS TOGGLE-BOX
      644        SIZE 22.88 BY .83 NO-UNDO.
      645   DEFINE VARIABLE itog-contract AS LOGICAL INITIAL no
      646        LABEL "Показать итоги по договорам"
      647        VIEW-AS TOGGLE-BOX
      648        SIZE 33 BY .83 NO-UNDO.
      649   DEFINE FRAME F-Main
      650        itog-comp AT ROW 2.96 COL 4.75
      651        itog-contract AT ROW 4.29 COL 4.63
      652        "Показать:" VIEW-AS TEXT
      653             SIZE 26.88 BY 1 AT ROW 1.5 COL 3.38
      654             FGCOLOR 4
      655        RECT-6 AT ROW 1.25 COL 2.25
      656       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      657            SIDE-LABELS NO-UNDERLINE THREE-D
      658            AT COL 1 ROW 1 SCROLLABLE .
      659   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      660   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      661   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      662   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      663   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      664   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      665   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      666   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      667         adm-object-hdl = FRAME F-Main:HANDLE.
      668   RUN ensure-broker.
      669   THIS-PROCEDURE:ADM-DATA =
      670        'ADM1.1~`':U +
      671        'SmartObject~`':U +
      672        '~`':U +
      673        'NO ~`':U +
      674        '~`':U +
      675        '~`':U +
      676        '~`':U +
      677        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      678           + "~`":U +
      679        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      680        'Record-Source,Record-Target,TableIO-Target~`':U +
      681        '~`':U +
      682        '~`~`~`~`~`~`~`~`~`~`~`':U +
      683        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      684            THEN "^^":U
      685        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      686             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      687   PROCEDURE adm-apply-entry :
      688     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      689   END PROCEDURE.
      690   PROCEDURE adm-destroy :
      691    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      692   END PROCEDURE.
      693   PROCEDURE adm-disable :
      694       DISABLE RECT-6 itog-comp itog-contract WITH FRAME F-Main.
      695       RUN dispatch ('disable-fields':U).
      696       RUN set-attribute-list ('ENABLED=no':U).
      697       RETURN.
      698   END PROCEDURE.
      699   PROCEDURE adm-edit-attribute-list :
      700         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      701         RETURN.
      702   END PROCEDURE.
      703   PROCEDURE adm-enable :
      704       ENABLE UNLESS-HIDDEN RECT-6 itog-comp itog-contract WITH FRAME F-Main.
      705       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      706       RUN set-attribute-list ('ENABLED=yes':U).
      707       RETURN.
      708   END PROCEDURE.
      709   PROCEDURE adm-exit :
      710        RUN notify ('exit':U).
      711     RETURN.
      712   END PROCEDURE.
      713   PROCEDURE adm-hide :
      714     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      715   END PROCEDURE.
      716   PROCEDURE adm-initialize :
      717     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      718   END PROCEDURE.
      719   PROCEDURE adm-show-errors :
      720       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      721       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      722           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      723       END.
      724       RETURN.
      725   END PROCEDURE.
      726   PROCEDURE adm-UIB-mode :
      727     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      728   END PROCEDURE.
      729   PROCEDURE adm-view :
      730     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      731   END PROCEDURE.
      732   PROCEDURE dispatch :
      733       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      734       RUN broker-dispatch IN adm-broker-hdl
      735           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      736       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      737   END PROCEDURE.
      738   PROCEDURE ensure-broker :
      739   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      740   IF RETURN-VALUE NE "ADM-Broker":U THEN
      741   DO:
      742       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      743       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      744   END.
      745   END PROCEDURE.
      746   PROCEDURE get-attribute :
      747     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      748     RUN broker-get-attribute IN adm-broker-hdl
      749         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      750     RETURN RETURN-VALUE.
      751   END PROCEDURE.
      752   PROCEDURE get-attribute-list :
      753     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      754     RUN broker-get-attribute-list IN adm-broker-hdl
      755         (INPUT THIS-PROCEDURE,
      756          INPUT ?,
      757          OUTPUT p-attr-list) NO-ERROR.
      758     RETURN.
      759   END PROCEDURE.
      760   PROCEDURE new-state :
      761     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      762     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      763     RETURN.
      764   END PROCEDURE.
      765   PROCEDURE notify :
      766     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      767     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      768     IF RETURN-VALUE = "ADM-ERROR":U THEN
      769         RETURN "ADM-ERROR":U.
      770     RETURN.
      771   END PROCEDURE.
      772   PROCEDURE set-attribute-list :
      773     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      774     RUN ensure-broker.
      775     RUN broker-set-attribute-list IN adm-broker-hdl
      776         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      777     RETURN.
      778   END PROCEDURE.
      779   PROCEDURE set-position :
      780       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      781       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      782       IF VALID-HANDLE(adm-object-hdl) THEN
      783       DO:
      784         ASSIGN adm-object-hdl:ROW    =   p-row
      785                adm-object-hdl:COLUMN =   p-col.
      786       END.
      787       RETURN.
      788   END PROCEDURE.
      789   PROCEDURE adm-display-fields :
      790       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      791       RETURN.
      792   END PROCEDURE.
      793   PROCEDURE adm-open-query :
      794     RETURN.
      795   END PROCEDURE.
      796   PROCEDURE adm-row-changed :
      797         IF VALID-HANDLE(adm-object-hdl) THEN
      798           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      799         RUN notify ('row-available':U).
      800         RETURN.
      801   END PROCEDURE.
      802   PROCEDURE reposition-query :
      803       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      804       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      805       RETURN.
      806   END PROCEDURE.
      807     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      808     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      809     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      810     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      811     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      812     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      813     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      814     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      815     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      816     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      817     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      818     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      819     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      820     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      821     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      822     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      823     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      824     IF "":U = "":U THEN
      825       RUN modify-list-attribute IN adm-broker-hdl
      826         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      827     RUN use-create-on-add(?).
      828   PROCEDURE adm-add-record :
      829       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      830          "must have at least one Enabled Table to perform Add.":U
      831          VIEW-AS ALERT-BOX ERROR.
      832       RETURN.
      833   END PROCEDURE.
      834   PROCEDURE adm-assign-record :
