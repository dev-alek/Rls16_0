      172   def
      173    shared
      174   temp-table  obj-list no-undo
      175     field obj-type like ub.clients.obj-type
      176     field obj-code like ub.clients.obj-code
      177     field obj-name like ub.clients.obj-name
      178     field obj-id   as integer
