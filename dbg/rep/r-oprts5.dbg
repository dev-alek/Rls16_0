     2404   procedure prdoclib-calc-prc :
     2405     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2406     define input  parameter p-cons-pay        as   integer                no-undo.
     2407     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2408     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2409     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2410     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2411     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2412     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2413     do
     2414     on error undo, return error return-value
     2415     :
     2416       define buffer buf_price-doc       for ub.price-doc .
     2417       define buffer buf_price-list      for ub.price-list .
     2418       define buffer buf_parts           for ub.parts .
     2419       define variable v-ov-qnty     as decimal   no-undo .
     2420       define variable v-ov-base     as decimal   no-undo .
     2421       define variable v-ov-VAT-base as decimal   no-undo .
     2422       define variable v-ov-SLT-base as decimal   no-undo .
     2423       define variable v-cons-qnty   as decimal   no-undo .
     2424       define variable v-prch-qnty   as decimal   no-undo .
     2425       define variable v-cons-mult   as decimal   no-undo .
     2426       define variable v-prch-mult   as decimal   no-undo .
     2427       find first buf_price-doc no-lock
     2428         where recid(buf_price-doc) = p-price-doc-recid
     2429         no-error .
     2430       if not available buf_price-doc
     2431       then do:
     2432         message
     2433           vss-workfile vss-revision vss-description skip
     2434           vss-include-info16 skip
     2435           "Ошибка задания входных параметров" skip
     2436           "Не найден документ переоценки" skip
     2437           "Код записи (recid)" p-price-doc-recid skip
     2438           view-as alert-box error .
     2439         undo, return error .
     2440       end.
     2441       for each buf_price-list no-lock
     2442         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2443           and buf_price-list.main-price = true
     2444       on error undo, return error return-value
     2445       :
     2446         run prdoclib-calc-ov
     2447           (input recid(buf_price-list)
     2448           ,output v-ov-qnty
     2449           ,output v-ov-base
     2450           ,output v-ov-VAT-base
     2451           ,output v-ov-SLT-base
     2452           ) no-error .
     2453         if error-status :error
     2454         then do:
     2455           if error-status :get-message(1) <> ""
     2456           then do:
     2457             message
     2458               vss-workfile vss-revision vss-description skip
     2459               vss-include-info16 skip
     2460               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2461               error-status :get-message(1) skip
     2462               return-value skip
     2463               view-as alert-box error .
     2464           end.
     2465           undo, return error return-value .
     2466         end.
     2467         assign
     2468           v-cons-qnty = 0
     2469           v-prch-qnty = 0
     2470         .
     2471         for each buf_parts no-lock
     2472           where buf_parts.out-code  = buf_price-list.doc-num
     2473             and buf_parts.obj-type  = buf_price-list.obj-type
     2474             and buf_parts.obj-code  = buf_price-list.obj-code
     2475             and buf_parts.artic     = buf_price-list.artic
     2476             and buf_parts.prod-type = buf_price-list.prod-type
     2477             and buf_parts.prod-code = buf_price-list.prod-code
     2478         on error undo, return error return-value
     2479         :
     2480           if buf_parts.pay-code = p-cons-pay
     2481           then do:
     2482             assign
     2483               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2484             .
     2485           end.
     2486           else do:
     2487             assign
     2488               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2489             .
     2490           end.
     2491         end.
     2492         if (v-cons-qnty + v-prch-qnty) = 0
     2493         then do:
     2494           assign
     2495             v-cons-mult = 0
     2496             v-prch-mult = 1
     2497           .
     2498         end.
     2499         else do:
     2500           assign
     2501             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2502             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2503           .
     2504         end.
     2505         assign
     2506           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2507           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2508           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2509           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2510           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2511           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2512         .
     2513       end.
     2514     end.
     2515   end procedure.
     2516   procedure prdoclib-calc-ov :
     2517     define input  parameter p-price-list-recid as recid     no-undo .
     2518     define output parameter p-fact-qnty        as decimal   no-undo .
     2519     define output parameter p-ov-base          as decimal   no-undo .
     2520     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2521     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2522     do
     2523     on error undo, return error return-value
     2524     :
     2525       define buffer buf_main_price-list    for ub.price-list .
     2526       define buffer buf_prev_price-list    for ub.price-list .
     2527       define buffer buf_special_price-list for ub.price-list .
     2528       define buffer buf_goods              for ub.goods .
     2529       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2530       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2531       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2532       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2533       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2534       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2535       define variable v-prev-price-list-recid as   recid                  no-undo.
     2536       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2537       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2538       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2539       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2540       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2541       find first buf_main_price-list no-lock
     2542         where recid(buf_main_price-list) = p-price-list-recid
     2543         no-error .
     2544       if not available buf_main_price-list
     2545       then do:
     2546         message
     2547           vss-workfile vss-revision vss-description skip
     2548           vss-include-info16 skip
     2549           "Ошибка задания входных параметров" skip
     2550           "Не найдена строка переоценки" skip
     2551           "Код записи (recid)" p-price-list-recid skip
     2552           view-as alert-box error .
     2553         undo, return error .
     2554       end.
     2555       if buf_main_price-list.main-price <> true
     2556       then do:
     2557         message
     2558           vss-workfile vss-revision vss-description skip
     2559           vss-include-info16 skip
     2560           "Ошибка задания входных параметров" skip
     2561           "Строка переоценки не является основной" skip
     2562           "Код записи (recid)" p-price-list-recid skip
     2563           "Переоценка" buf_main_price-list.doc-num skip
     2564           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2565           "Бар-код" buf_main_price-list.b-code skip
     2566           view-as alert-box error .
     2567         undo, return error .
     2568       end.
     2569       run prdoclib-calc-fact-sale in this-procedure
     2570         (input  recid(buf_main_price-list)
     2571         ,output v-fact-qnty
     2572         ,output v-cur-base
     2573         ,output v-cur-VAT-base
     2574         ,output v-cur-SLT-base
     2575         ,output v-cur-road-tax-base
     2576         ,output v-cur-excise-base
     2577         ) no-error.
     2578       if error-status :error
     2579       then do:
     2580         message
     2581           vss-workfile vss-revision vss-description skip
     2582           vss-include-info16 skip
     2583           "Ошибка при расчете сумм переоценки." skip
     2584           "Документ переоценки" buf_main_price-list.doc-num skip
     2585           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2586           error-status :get-message(1) skip
     2587           return-value skip
     2588           view-as alert-box error .
     2589         undo, return error .
     2590       end.
     2591   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2592   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2593     (input  buf_main_price-list.obj-type
     2594     ,input  buf_main_price-list.obj-code
     2595     ,input  buf_main_price-list.b-code
     2596     ,input  buf_main_price-list.b-code
     2597     ,input  buf_main_price-list.fact-order
     2598     ,output v-prev-price-list-recid
     2599     ,output v-prev-cli-base-rate
     2600     ) no-error .
     2601       if error-status :error
     2602       then do:
     2603         message
     2604           vss-workfile vss-revision vss-description skip
     2605           vss-include-info16 skip
     2606           "Ошибка при поиске предыдущей переоценки." skip
     2607           "Документ переоценки " buf_main_price-list.doc-num skip
     2608           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2609           error-status :get-message(1) skip
     2610           return-value skip
     2611           view-as alert-box error .
     2612         undo, return error .
     2613       end.
     2614       if v-prev-price-list-recid <> ?
     2615       then do:
     2616         find first buf_prev_price-list no-lock
     2617           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2618           .
     2619         find first buf_special_price-list no-lock
     2620           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2621             and buf_special_price-list.main-price = false
     2622             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2623             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2624             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2625             and buf_special_price-list.doc-qnty   <> ?
     2626           no-error .
     2627         if available buf_special_price-list
     2628         then do:
     2629           message
     2630             "Товар имеет специальные цены на признаки" skip
     2631             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2632             "Переоценка" buf_prev_price-list.doc-num skip
     2633             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2634             view-as alert-box error .
     2635           undo, return error .
     2636         end.
     2637         find first buf_goods no-lock
     2638           where buf_goods.artic     = buf_main_price-list.artic
     2639             and buf_goods.prod-type = buf_main_price-list.prod-type
     2640             and buf_goods.prod-code = buf_main_price-list.prod-code
     2641           no-error .
     2642         if not available buf_goods
     2643         then do:
     2644           message
     2645             vss-workfile vss-revision vss-description skip
     2646             vss-include-info16 skip
     2647             "Не найден товар" skip
     2648             "Переоценка" buf_main_price-list.doc-num skip
     2649             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2650             view-as alert-box error .
     2651           undo, return error .
     2652         end.
     2653         if buf_prev_price-list.vat-pc = ?
     2654         or buf_prev_price-list.slt-pc = ?
     2655         then do:
     2656           message
     2657             "В переоценке не заданы налоги товара" skip
     2658             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2659             "Переоценка" buf_prev_price-list.doc-num skip
     2660             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2661             "НДС" buf_prev_price-list.vat-pc skip
     2662             "НП" buf_prev_price-list.slt-pc skip
     2663             view-as alert-box error .
     2664           undo, return error return-value .
     2665         end.
     2666         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2667         assign
     2668           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2669         .
     2670         assign
     2671           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2672           v-prev-cur-VAT-base = v-fact-qnty
     2673                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2674                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2675           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2676         .
     2677         assign
     2678           p-fact-qnty   = v-fact-qnty
     2679           p-ov-base     = v-cur-base     - v-prev-cur-base
     2680           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2681           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2682         .
     2683       end.
     2684       else do:
     2685         assign
     2686           v-prev-cur-base     = 0
     2687           v-prev-cur-VAT-base = 0
     2688           v-prev-cur-SLT-base = 0
     2689           .
     2690         assign
     2691           p-fact-qnty   = v-fact-qnty
     2692           p-ov-base     = v-cur-base     - v-prev-cur-base
     2693           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2694           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2695         .
     2696       end.
     2697     end.
     2698   end procedure.
     2699   procedure prdoclib-init-prt-obj-by-factord :
     2700     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2701     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2702     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2703     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2704     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2705     define input parameter p-fact-order         as decimal   no-undo .
     2706     define input parameter p-include-fact-order as logical   no-undo .
     2707     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2708     define buffer buf_gds-obj      for ub.gds-obj .
     2709     define buffer buf_doc-line     for ub.doc-line .
     2710     define buffer buf_temp-prt-obj for temp-prt-obj .
     2711     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2712     do
     2713     on error undo, return error return-value
     2714     :
     2715       do transaction
     2716       on error undo, return error return-value
     2717       :
     2718   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2719   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2720     (input  p-obj-type
     2721     ,input  p-obj-code
     2722     ,input  p-artic
     2723     ,input  p-prod-type
     2724     ,input  p-prod-code
     2725     ,buffer buf_gds-obj
     2726     ) no-error .
     2727         if error-status :error
     2728         then do:
     2729           message
     2730             vss-workfile vss-revision vss-description skip
     2731             vss-include-info16 skip
     2732             "Невозможно найти gds-obj" skip
     2733             error-status :get-message(1) skip
     2734             return-value skip
     2735             view-as alert-box error .
     2736           undo, return error .
     2737         end.
     2738         find current buf_gds-obj exclusive-lock .
     2739       end.
     2740       run prdoclib-init-temp-prt-obj in this-procedure
     2741         (input p-obj-type
     2742         ,input p-obj-code
     2743         ,input p-artic
     2744         ,input p-prod-type
     2745         ,input p-prod-code
     2746         ,input 0
     2747         ) .
     2748       for each buf_temp-prt-obj
     2749         where buf_temp-prt-obj.is-term <> true
     2750       on error undo, return error return-value
     2751       :
     2752         delete buf_temp-prt-obj .
     2753       end.
     2754       if p-include-fact-order = true
     2755       then do:
     2756         assign
     2757          p-fact-order = p-fact-order - 0.0000000001
     2758         .
     2759       end.
     2760       for each buf_doc-line no-lock
     2761         where buf_doc-line.obj-type   = p-obj-type
     2762           and buf_doc-line.obj-code   = p-obj-code
     2763           and buf_doc-line.artic      = p-artic
     2764           and buf_doc-line.prod-type  = p-prod-type
     2765           and buf_doc-line.prod-code  = p-prod-code
     2766           and buf_doc-line.status_    = 'факт':U
     2767           and buf_doc-line.fact-order >= p-fact-order
     2768       on error undo, return error return-value
     2769       :
     2770         run prdoclib-process-document in this-procedure
     2771           (input  buf_doc-line.doc-code
     2772           ,input  p-obj-type
     2773           ,input  p-obj-code
     2774           ,input  p-artic
     2775           ,input  p-prod-type
     2776           ,input  p-prod-code
     2777           ,output v-total-gds-dtl-qnty
     2778           ) .
     2779       end.
     2780     end.
     2781   end procedure.
     2782   procedure prdoclib-process-document :
     2783     define input  parameter p-doc-code           as character no-undo .
     2784     define input  parameter p-obj-type           as character no-undo .
     2785     define input  parameter p-obj-code           as integer   no-undo .
     2786     define input  parameter p-artic              as character no-undo .
     2787     define input  parameter p-prod-type          as character no-undo .
     2788     define input  parameter p-prod-code          as integer   no-undo .
     2789     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2790     define buffer buf_trn-doc      for ub.trn-doc .
     2791     define buffer buf_gds-dtl      for ub.gds-dtl .
     2792     define buffer buf_temp-prt-obj for temp-prt-obj .
     2793     do
     2794     on error undo, return error return-value
     2795     :
     2796       find first buf_trn-doc no-lock
     2797         where buf_trn-doc.doc-code = p-doc-code
     2798         no-error .
     2799       if not available buf_trn-doc then do:
     2800         message
     2801           vss-workfile vss-revision vss-description skip
     2802           vss-include-info16 skip
     2803           "Ошибка при поиске документа" skip
     2804           "Документ" p-doc-code skip
     2805           "Объект" p-obj-type p-obj-code skip
     2806           "Артикул" p-artic p-prod-type p-prod-code skip
     2807           view-as alert-box error .
     2808         undo, return error .
     2809       end.
     2810       assign
     2811         p-total-gds-dtl-qnty = 0
     2812       .
     2813       for each buf_gds-dtl no-lock
     2814         where buf_gds-dtl.doc-code  = p-doc-code
     2815           and buf_gds-dtl.artic     = p-artic
     2816           and buf_gds-dtl.prod-type = p-prod-type
     2817           and buf_gds-dtl.prod-code = p-prod-code
     2818       on error undo, return error
     2819       :
     2820         define variable v-term-node as integer   no-undo .
     2821   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2822     (input  buf_gds-dtl.prt-code
     2823     ,output v-term-node
     2824     )  .
     2825         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2826           (input  v-term-node
     2827           ,buffer buf_temp-prt-obj
     2828           ) .
     2829         if buf_temp-prt-obj.is-term <> true then do:
     2830           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2831                                        ,buf_gds-dtl.prt-code
     2832                                        ) .
     2833         end.
     2834         case buf_trn-doc.doc-type :
     2835           when 'при':U or
     2836           when 'возврат':U
     2837           then do:
     2838             assign
     2839               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2840                                           - buf_gds-dtl.fact-qnty
     2841               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2842                                           - buf_gds-dtl.fact-qnty
     2843             .
     2844           end.
     2845           when 'рас':U or
     2846           when 'спи':U
     2847           then do:
     2848             assign
     2849               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2850                                           + buf_gds-dtl.fact-qnty
     2851               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2852                                           + buf_gds-dtl.fact-qnty
     2853             .
     2854           end.
     2855           when 'инв':U
     2856           then do:
     2857             assign
     2858               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2859                                           - buf_gds-dtl.doc-qnty
     2860               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2861                                           - buf_gds-dtl.doc-qnty
     2862             .
     2863           end.
     2864           otherwise do:
     2865             undo, return error substitute("Неизвестный тип документа &1"
     2866                                          ,buf_trn-doc.doc-type
     2867                                          ) .
     2868           end.
     2869         end.
     2870       end.
     2871     end.
     2872   end procedure.
     2873   procedure prdoclib-prc-pl-document :
     2874     define input  parameter p-doc-code              as character no-undo .
     2875     define input  parameter p-obj-type              as character no-undo .
     2876     define input  parameter p-obj-code              as integer   no-undo .
     2877     define input  parameter p-gds-code              as integer   no-undo .
     2878     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2879     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2880     do
     2881     on error undo, return error return-value
     2882     :
     2883       define buffer buf_trn-doc      for ub.trn-doc .
     2884       define buffer buf_doc-pl       for ub.doc-pl .
     2885       define buffer buf_temp-pl-gds for temp-pl-gds .
     2886       define variable v-sign as decimal   no-undo .
     2887       find first buf_trn-doc no-lock
     2888         where buf_trn-doc.doc-code = p-doc-code
     2889         no-error .
     2890       if not available buf_trn-doc then do:
     2891         message
     2892           vss-workfile vss-revision vss-description skip
     2893           vss-include-info16 skip
     2894           "Ошибка при поиске документа" skip
     2895           "Документ" p-doc-code skip
     2896           "Объект" p-obj-type p-obj-code skip
     2897           "Товар" p-gds-code skip
     2898           view-as alert-box error .
     2899         undo, return error .
     2900       end.
     2901       assign
     2902         p-total-pl-gds-qnty     = 0
     2903         p-total-pl-gds-cli-qnty = 0
     2904       .
     2905       for each buf_doc-pl no-lock
     2906         where buf_doc-pl.out-code  = p-doc-code
     2907           and buf_doc-pl.gds-code  = p-gds-code
     2908       on error undo, return error return-value
     2909       :
     2910         find first buf_temp-pl-gds
     2911           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2912             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2913             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2914           .
     2915         case buf_trn-doc.doc-type :
     2916           when 'при':U
     2917           or when 'возврат':U
     2918           or when 'инв':U
     2919           then do:
     2920             assign
     2921               v-sign = -1.0
     2922             .
     2923           end.
     2924           when 'рас':U or
     2925           when 'спи':U
     2926           then do:
     2927             assign
     2928               v-sign = 1.0
     2929             .
     2930           end.
     2931           otherwise do:
     2932             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2933           end.
     2934         end case.
     2935         assign
     2936           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2937           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2938           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2939           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2940         .
     2941       end.
     2942     end.
     2943   end procedure.
     2944   procedure prdoclib-init-prt-obj-by-date :
     2945     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2946     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2947     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2948     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2949     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2950     define input parameter p-fact-date  as date      no-undo .
     2951     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2952     do
     2953     on error undo, return error return-value
     2954     :
     2955       define variable v-fact-order                as decimal   no-undo .
     2956       define variable v-shift-end-fact-order      as decimal   no-undo .
     2957       define variable v-day-end-fact-order        as decimal   no-undo .
     2958       run factord in this-procedure
     2959         (input  p-fact-date
     2960         ,input  1
     2961         ,input  1
     2962         ,input  ?
     2963         ,input  0
     2964         ,input  false
     2965         ,output v-fact-order
     2966         ,output v-shift-end-fact-order
     2967         ,output v-day-end-fact-order
     2968         ) no-error .
     2969       if error-status :error
     2970       then do:
     2971         message
     2972           vss-workfile vss-revision vss-description skip
     2973           vss-include-info16 skip
     2974           "Ошибка при определении момента времени, на который требуется остаток" skip
     2975           "Объект" p-obj-type p-obj-code skip
     2976           "Артикул" p-artic p-prod-type p-prod-code skip
     2977           "Дата" p-fact-date skip
     2978           view-as alert-box error .
     2979         undo, return error .
     2980       end.
     2981       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2982         (input p-obj-type
     2983         ,input p-obj-code
     2984         ,input p-artic
     2985         ,input p-prod-type
     2986         ,input p-prod-code
     2987         ,input v-day-end-fact-order
     2988         ,input false
     2989         ) no-error .
     2990       if error-status :error
     2991       then do:
     2992         message
     2993           vss-workfile vss-revision vss-description skip
     2994           vss-include-info16 skip
     2995           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2996           "Объект" p-obj-type p-obj-code skip
     2997           "Артикул" p-artic p-prod-type p-prod-code skip
     2998           "Дата" p-fact-date skip
     2999           view-as alert-box error .
     3000         undo, return error .
     3001       end.
     3002     end.
     3003   end procedure.
     3004   procedure prdoclib-calc-temp-fact-sale :
     3005     define input  parameter p-obj-type           as character no-undo .
     3006     define input  parameter p-obj-code           as integer   no-undo .
     3007     define input  parameter p-gds-code           as integer   no-undo .
     3008     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3009     define input  parameter p-curr-r-b           as character no-undo .
     3010     define output parameter p-fact-qnty          as decimal   no-undo .
     3011     define output parameter p-cur-base           as decimal   no-undo .
     3012     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3013     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3014     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3015     define output parameter p-cur-excise-base    as decimal   no-undo .
     3016     define buffer buf_temp-prt-obj for temp-prt-obj .
     3017     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3018     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3019     define variable parrecid-prl        as recid     no-undo .
     3020     define variable v-fact-qnty         as decimal   no-undo .
     3021     define variable v-cur-base          as decimal   no-undo .
     3022     define variable v-cur-VAT-base      as decimal   no-undo .
     3023     define variable v-cur-SLT-base      as decimal   no-undo .
     3024     define variable v-cur-road-tax-base as decimal   no-undo .
     3025     define variable v-cur-excise-base   as decimal   no-undo .
     3026     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3027     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3028     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3029     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3030     define variable vat-base-sale-prl               as decimal   no-undo .
     3031     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3032     define variable vat-base-buyer-prl              as decimal   no-undo .
     3033     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3034     define variable slt-base-sale-prl               as decimal   no-undo .
