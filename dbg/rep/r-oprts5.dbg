     1498     define variable v-gds-code             like ub.goods.gds-code    no-undo .
     1499     define variable v-root-node            like ub.prt-obj.prt-code  no-undo .
     1500     define variable v-root-b-code          like ub.bar-code.b-code   no-undo .
     1501     define variable v-total-term-fact-qnty like ub.prt-obj.fact-qnty no-undo .
     1502     define variable v-total-fact-sale      like ub.gds-obj.fact-sale no-undo .
     1503     define variable v-doc-num     like ub.price-list.doc-num    no-undo .
     1504     define variable v-price-sale  like ub.price-list.price-sale no-undo .
     1505     define variable v-road-tax    like ub.price-list.road-tax   no-undo .
     1506     define variable v-excise      like ub.price-list.excise     no-undo .
     1507     do
     1508     on error undo, return error return-value
     1509     :
     1510   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1512     (input  p-artic
     1513     ,input  p-prod-type
     1514     ,input  p-prod-code
     1515     ,output v-root-node
     1516     )  .
     1517   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1518   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscr in g#library
     1519     (input  p-obj-type
