     8517   END PROCEDURE.
     8518   PROCEDURE Display-prt :
     8519   if goods.prt-root <> Prtroot Then DO:
     8520   If v-var = "no-today"  then
     8521   run prdoclib-init-prt-obj-by-factord in this-procedure
     8522   ( input gds-obj.obj-type  ,
     8523   input gds-obj.obj-code  ,
     8524   input gds-obj.artic     ,
     8525   input gds-obj.prod-type ,
     8526   input gds-obj.prod-code ,
     8527   input fact-order-2 ,
     8528   input false ) .
     8529   for each ub.prt-obj where
     8530     ub.prt-obj.artic     = goods.artic         and
     8531     ub.prt-obj.prod-type = goods.prod-type and
     8532     ub.prt-obj.prod-code = goods.prod-code and
     8533     ub.prt-obj.obj-code  = obj-list.obj-code   and
     8534     ub.prt-obj.obj-type  = obj-list.obj-type   and
     8535     ub.prt-obj.IS-term   =  true no-lock
     8536           BREAK BY ub.prt-obj.prt-code with FRAME Zapas:
     8537                 if v-var <> "no-today" then do:
     8538                   Assign
     8539                     p-qnty-o     = p-qnty-o     + ub.prt-obj.fact-qnty
     8540                     p-crsa-sum-o = p-crsa-sum-o + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     8541                 End.
     8542   IF last-of(prt-obj.prt-code) THEN DO:
     8543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8544     (input  gds-obj.gds-code
     8545     ,input  ub.prt-obj.prt-code
     8546     ,output v-bar-code
     8547     )  .
     8548             if v-var = "no-today" then do:
     8549               find first temp-prt-obj no-lock
     8550                     where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     8551                     if avail temp-prt-obj then do :
     8552                       run calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     8553                       Assign
     8554                         p-qnty-o      = temp-prt-obj.fact-qnty
     8555                         p-crsa-sum-o  = temp-prt-obj.fact-qnty * v-price-sale      .
     8556                     End.
     8557                     Else
     8558                       Assign
     8559                         p-qnty-o      = 0
     8560                         p-crsa-sum-o  = 0   .
     8561             End.
     8562       FIND first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code NO-LOCK no-error .
     8563       for each ub.gds-dtl no-lock where
     8564           ub.gds-dtl.artic      = goods.artic     and
     8565           ub.gds-dtl.prod-code  = goods.prod-code and
     8566           ub.gds-dtl.prod-type  = goods.prod-type and
     8567           ub.gds-dtl.prt-code   = ub.prt-obj.prt-code  and
     8568           ub.gds-dtl.obj-code   = obj-list.obj-code  and
     8569           ub.gds-dtl.obj-type   = obj-list.obj-type :
     8570               find first temp-doc-code where temp-doc-code.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     8571                 if avail temp-doc-code then DO:
     8572                 Assign
     8573                     t-qnty = if temp-doc-code.ext-doc-type = 'vt':U
     8574                                 then ub.gds-dtl.doc-qnty
     8575                                 else ( ub.gds-dtl.fact-qnty * temp-doc-code.si )
     8576                     p-qnty       = p-qnty       + t-qnty
     8577                     p-sale-sum   = p-sale-sum   + (gds-dtl.price-rubl * t-qnty)
     8578                     p-sale-other = p-sale-other + (gds-dtl.discnt-rubl * temp-doc-code.si2)
     8579                     p-crsa-sum   = p-crsa-sum   + (gds-dtl.cur-base * t-qnty)
     8580                     .
     8581               End.
     8582               find first temp-doc-code-all where temp-doc-code-all.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     8583                 if avail temp-doc-code-all then DO:
     8584                     Assign
     8585                     t-qnty-all = if temp-doc-code-all.ext-doc-type = 'vt':U
     8586                                       then ub.gds-dtl.doc-qnty
     8587                                       else ( ub.gds-dtl.fact-qnty * temp-doc-code-all.si )
     8588                       p-qnty-all       = p-qnty-all  + t-qnty-all
     8589                       p-crsa-sum-all   = p-crsa-sum-all   + (gds-dtl.cur-base * t-qnty-all ).
     8590                 End.
     8591       end.
     8592       if f-qnty <> ? and f-qnty <> 0 then
     8593           Assign
     8594             p-cost-sum     = f-cost-sum      * p-qnty     / f-qnty
     8595           .
     8596       else
     8597           Assign
     8598               p-cost-sum     = 0
     8599           .
     8600       if f-qnty-all <> ? and f-qnty-all <> 0 then
     8601           Assign
     8602             p-cost-sum-all = f-cost-sum-all  * p-qnty-all / f-qnty-all
     8603           .
     8604       else
     8605           Assign
     8606               p-cost-sum-all = 0
     8607             .
     8608       if f-qnty-o <> ? and f-qnty-o <> 0 then
     8609           Assign
     8610             p-cost-sum-o   = f-cost-sum-o    * p-qnty-o   / f-qnty-o
     8611           .
     8612       else
     8613           Assign
     8614               p-cost-sum-o   = 0
     8615           .
     8616       if  NOT(p-qnty      =  0 and
     8617             p-cost-sum    =  0     and
     8618             p-sale-sum    =  0     and
     8619             p-sale-other  =  0     and
     8620             p-crsa-sum    =  0     and
     8621             p-qnty-all    =  0     and
     8622             p-cost-sum-all = 0     and
     8623             p-crsa-sum-all=  0    ) then dO:
     8624     if c-nn <>  ?  then do :
     8625       c-nn:screen-value = string('') .
     8626       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8627           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8628           display STREAM OutStream    with frame top-frame .
     8629       End.
     8630     End.
     8631     if c-f-artic <>  ?  then do :
     8632       c-f-artic:screen-value = string('') .
     8633       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8634           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8635           display STREAM OutStream    with frame top-frame .
     8636       End.
     8637     End.
     8638     if c-f-b-code <>  ?  then do :
     8639       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     8640       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8641           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8642           display STREAM OutStream    with frame top-frame .
     8643       End.
     8644     End.
     8645     if c-f-gds-name <>  ?  then do :
     8646       c-f-gds-name:screen-value = string(ub.gds-prt.f-name) .
     8647       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8648           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8649           display STREAM OutStream    with frame top-frame .
     8650       End.
     8651     End.
     8652     if c-f-qnty <>  ?  then do :
     8653       c-f-qnty:screen-value = string(p-qnty) .
     8654       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8655           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8656           display STREAM OutStream    with frame top-frame .
     8657       End.
     8658     End.
     8659     if c-f-cost-sum <>  ?  then do :
     8660       c-f-cost-sum:screen-value = string(p-cost-sum) .
     8661       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8662           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8663           display STREAM OutStream    with frame top-frame .
     8664       End.
     8665     End.
     8666     if c-f-sale-sum <>  ?  then do :
     8667       c-f-sale-sum:screen-value = string(p-sale-sum) .
     8668       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8669           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8670           display STREAM OutStream    with frame top-frame .
     8671       End.
     8672     End.
     8673     if c-f-sale-other <>  ?  then do :
     8674       c-f-sale-other:screen-value = string(p-sale-other) .
     8675       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8676           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8677           display STREAM OutStream    with frame top-frame .
     8678       End.
     8679     End.
     8680     if c-f-crsa-sum <>  ?  then do :
     8681       c-f-crsa-sum:screen-value = string(p-crsa-sum) .
     8682       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8683           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8684           display STREAM OutStream    with frame top-frame .
     8685       End.
     8686     End.
     8687     if c-f-qnty-all <>  ?  then do :
     8688       c-f-qnty-all:screen-value = string(p-qnty-all) .
     8689       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8690           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8691           display STREAM OutStream    with frame top-frame .
     8692       End.
     8693     End.
     8694     if c-f-cost-sum-all <>  ?  then do :
     8695       c-f-cost-sum-all:screen-value = string(p-cost-sum-all) .
     8696       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8697           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8698           display STREAM OutStream    with frame top-frame .
     8699       End.
     8700     End.
     8701     if c-f-crsa-sum-all <>  ?  then do :
     8702       c-f-crsa-sum-all:screen-value = string(p-crsa-sum-all) .
     8703       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8704           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8705           display STREAM OutStream    with frame top-frame .
     8706       End.
     8707     End.
     8708     if c-f-qnty-o <>  ?  then do :
     8709       c-f-qnty-o:screen-value = string(p-qnty-o) .
     8710       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8711           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8712           display STREAM OutStream    with frame top-frame .
     8713       End.
     8714     End.
     8715     if c-f-cost-sum-o <>  ?  then do :
     8716       c-f-cost-sum-o:screen-value = string(p-cost-sum-o) .
     8717       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8718           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8719           display STREAM OutStream    with frame top-frame .
     8720       End.
     8721     End.
     8722     if c-f-crsa-sum-o <>  ?  then do :
     8723       c-f-crsa-sum-o:screen-value = string(p-crsa-sum-o) .
     8724       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8725           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8726           display STREAM OutStream    with frame top-frame .
     8727       End.
     8728     End.
     8729           Display stream OutStream no-error.
     8730           DOWN stream OutStream .
     8731       if Make-Excel then  put   stream ForExcel unformatted
     8732             " "                             CHR(9)
     8733             " "                             CHR(9)
     8734             format-excel-text(string(v-bar-code,"999999999"))  CHR(9)
     8735             ub.gds-prt.f-name                 CHR(9)
     8736             round(p-qnty,3)                CHR(9)
     8737             round(p-cost-sum,2)            CHR(9)
     8738             round(p-sale-sum,2)            CHR(9)
     8739             round(p-sale-other,2)          CHR(9)
     8740             round(p-crsa-sum,2)            CHR(9)
     8741             round(p-qnty-all,3)            CHR(9)
     8742             round(p-cost-sum-all,2)        CHR(9)
     8743             round(p-crsa-sum-all,2)        CHR(9)
     8744             round(p-qnty-o,3)              CHR(9)
     8745             round(p-cost-sum-o,2)          CHR(9)
     8746             round(p-crsa-sum-o,2)          chr(10) .
     8747       End.
     8748       Assign
     8749         p-qnty        =  0
     8750         p-cost-sum    =  0
     8751         p-sale-sum    =  0
     8752         p-sale-other  =  0
     8753         p-crsa-sum    =  0
     8754         p-qnty-all    =  0
     8755         p-cost-sum-all = 0
     8756         p-crsa-sum-all=  0
     8757         p-qnty-o      =  0
     8758         p-cost-sum-o  =  0
     8759         p-crsa-sum-o  =  0 .
     8760   End.
     8761   End.
     8762   End.
     8763   END PROCEDURE.
     8764   PROCEDURE on-same-page :
     8765     define input parameter p-line-number as integer  no-undo .
     8766     if p-line-number > page-size( OutStream ) then do:
     8767       return .
     8768     end.
     8769     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     8770       page stream OutStream .
     8771     end.
     8772   end procedure.
     8773   procedure ost-line :
     8774     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     8775     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     8776     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     8777     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     8778     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     8779     define input  parameter x-tog-shift  as logical no-undo .
     8780     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     8781     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     8782     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     8783     define input  parameter xtog-obj     as logical no-undo .
     8784     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     8785     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     8786     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     8787     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     8788     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     8789     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     8790     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     8791     define buffer buff-obj-list  for obj-list .
     8792     define buffer buff-stk-line  for ub.stk-line .
     8793     assign
     8794       Quantity = 0
     8795       Coast_R  = 0
     8796       Coast_V  = 0
     8797       VAT_R    = 0
     8798       VAT_V    = 0
     8799       SLT_R    = 0
     8800       SLT_V    = 0
     8801     .
     8802     if  x-tog-shift = false then do:
     8803       for each buff-obj-list no-lock
     8804         where xtog-obj = false
     8805            or (buff-obj-list.obj-type = x-store-type
     8806               and buff-obj-list.obj-code = x-store-code
     8807               )
     8808       on error undo, return error
     8809       :
     8810       find last buff-stk-line no-lock
     8811         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8812           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8813           and buff-stk-line.artic      = x-artic
     8814           and buff-stk-line.prod-type  = x-prod-type
     8815           and buff-stk-line.prod-code  = x-prod-code
     8816           and buff-stk-line.sum-type   = x-sum-type
     8817           and buff-stk-line.cat-id     = '##,##':U
     8818           and buff-stk-line.fact-order <= x-fact-order
     8819           and buff-stk-line.shift-num  = 0
     8820         use-index category
     8821         no-error .
     8822       if available buff-stk-line then do:
     8823         assign
     8824           Quantity = Quantity + buff-stk-line.fact-qnty
     8825           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8826           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8827           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8828           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8829           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8830           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8831         .
     8832       end.
     8833      end.
     8834     end.
     8835     else do:
     8836       for each buff-obj-list no-lock
     8837         where xtog-obj = false
     8838            or (buff-obj-list.obj-type = x-store-type
     8839               and buff-obj-list.obj-code = x-store-code
     8840               )
     8841       on error undo, return error
     8842       :
     8843         find last buff-stk-line no-lock
     8844           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8845             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8846             and buff-stk-line.artic      = x-artic
     8847             and buff-stk-line.prod-type  = x-prod-type
     8848             and buff-stk-line.prod-code  = x-prod-code
     8849             and buff-stk-line.sum-type   = x-sum-type
     8850             and buff-stk-line.cat-id     = '##,##':U
     8851             and buff-stk-line.fact-order <= x-fact-order
     8852             and buff-stk-line.shift-num  > 0
     8853           use-index category
     8854           no-error .
     8855         if available buff-stk-line then do:
     8856           assign
     8857             Quantity = Quantity +  buff-stk-line.fact-qnty
     8858             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8859             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8860             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8861             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8862             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8863             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8864           .
     8865         end.
     8866       end.
     8867     end.
     8868   end procedure.
     8869   procedure ost-lineother-tax :
     8870     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     8871     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     8872     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     8873     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     8874     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     8875     define input  parameter x-tog-shift  as logical no-undo .
     8876     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     8877     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     8878     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     8879     define input  parameter xTog-obj     as logical no-undo .
     8880     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     8881     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     8882     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     8883     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     8884     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     8885     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     8886     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     8887     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     8888     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     8889     define buffer buff-obj-list  for obj-list .
     8890     define buffer buff-stk-line  for ub.stk-line .
     8891     assign
     8892       Quantity = 0
     8893       Coast_R  = 0
     8894       Coast_V  = 0
     8895       VAT_R    = 0
     8896       VAT_V    = 0
     8897       SLT_R    = 0
     8898       SLT_V    = 0
     8899       other_R  = 0
     8900       other_V  = 0
     8901     .
     8902     if  x-tog-shift = false then do:
     8903       for each buff-obj-list no-lock
     8904         where xtog-obj = false
     8905            or (buff-obj-list.obj-type = x-store-type
     8906               and buff-obj-list.obj-code = x-store-code
     8907               )
     8908       on error undo, return error
     8909       :
     8910       find last buff-stk-line no-lock
     8911         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8912           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8913           and buff-stk-line.artic      = x-artic
     8914           and buff-stk-line.prod-type  = x-prod-type
     8915           and buff-stk-line.prod-code  = x-prod-code
     8916           and buff-stk-line.sum-type   = x-sum-type
     8917           and buff-stk-line.cat-id     = '##,##':U
     8918           and buff-stk-line.fact-order <= x-fact-order
     8919           and buff-stk-line.shift-num  = 0
     8920         use-index category
     8921         no-error .
     8922       if available buff-stk-line then do:
     8923         assign
     8924           Quantity = Quantity + buff-stk-line.fact-qnty
     8925           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8926           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8927           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8928           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8929           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8930           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8931           other_R  = other_R  + buff-stk-line.other-rubl
     8932           other_V  = other_V  + buff-stk-line.other-base
     8933         .
     8934       end.
     8935    end.
     8936     end.
     8937     else do:
     8938       for each buff-obj-list no-lock
     8939         where xtog-obj = false
     8940            or (buff-obj-list.obj-type = x-store-type
     8941               and buff-obj-list.obj-code = x-store-code
     8942               )
     8943       on error undo, return error
     8944       :
     8945         find last buff-stk-line no-lock
     8946           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8947             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8948             and buff-stk-line.artic      = x-artic
     8949             and buff-stk-line.prod-type  = x-prod-type
     8950             and buff-stk-line.prod-code  = x-prod-code
     8951             and buff-stk-line.sum-type   = x-sum-type
     8952             and buff-stk-line.cat-id     = '##,##':U
     8953             and buff-stk-line.fact-order <= x-fact-order
     8954             and buff-stk-line.shift-num  > 0
     8955           use-index category
     8956           no-error .
     8957         if available buff-stk-line then do:
     8958           assign
     8959             Quantity = Quantity +  buff-stk-line.fact-qnty
     8960             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8961             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8962             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8963             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8964             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8965             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8966             other_R = other_R   +  buff-stk-line.other-rubl
     8967             other_V = other_V   +  buff-stk-line.other-base
     8968           .
     8969         end.
     8970       end.
     8971     end.
     8972   end procedure.
     8973   procedure ost-line-kg :
     8974     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     8975     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     8976     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     8977     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     8978     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     8979     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     8980     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     8981     define buffer buff-obj-list  for obj-list .
     8982     define buffer buf_doc-line for ub.doc-line .
     8983     define buffer buf_inv-line for ub.inv-line .
     8984     do
     8985     on error undo, return error
     8986     :
     8987       for each buf_doc-line no-lock where
     8988                buf_doc-line.obj-type    = p-obj-type   and
     8989                buf_doc-line.obj-code    = p-obj-code   and
     8990                buf_doc-line.prod-type   = p-prod-type  and
     8991                buf_doc-line.prod-code   = p-prod-code  and
     8992                buf_doc-line.artic       = p-artic      and
     8993                buf_doc-line.status_     = 'факт':U      and
     8994                buf_doc-line.fact-order <= p-fact-order
     8995             by buf_doc-line.fact-order    descending
     8996       :
     8997         find first buf_inv-line no-lock where
     8998                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     8999                    buf_inv-line.artic     = buf_doc-line.artic     and
     9000                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     9001                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     9002         if available buf_inv-line
     9003         then do:
     9004           if buf_inv-line.after-cli-qnty <> ?
     9005           then do:
     9006             assign
     9007               p-quantity-kg = buf_inv-line.after-cli-qnty
     9008             .
     9009             leave .
     9010           end.
     9011         end.
     9012       end.
     9013       if p-quantity-kg = ?
     9014       then do:
     9015         assign
     9016           p-quantity-kg = 0
     9017         .
     9018       end.
     9019     end.
     9020   end procedure.
