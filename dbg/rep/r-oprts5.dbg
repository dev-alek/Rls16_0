     2063     do
     2064     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     2065     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2066     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2067     :
     2068       find first buf_main_price-list no-lock
     2069         where recid(buf_main_price-list) = p-price-list-recid
     2070         no-error .
     2071       if not available buf_main_price-list
     2072       then do:
     2073         message
     2074           vss-workfile vss-revision vss-description skip
     2075           vss-include-info16 skip
     2076           "Ошибка задания входных параметров" skip
     2077           "Не найдена строка переоценки" skip
     2078           "Код записи (recid)" p-price-list-recid skip
     2079           view-as alert-box error .
     2080         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2081       end.
     2082       if buf_main_price-list.main-price <> true
     2083       then do:
     2084         message
     2085           vss-workfile vss-revision vss-description skip
     2086           vss-include-info16 skip
