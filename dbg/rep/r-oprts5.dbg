     7948      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     7949             n-nn = 0.
     7950             n-no = n-no + 1 .
     7951   for each tt-season no-lock ,
     7952       each ub.gds-season no-lock where
     7953            ub.gds-season.db-num   = tt-season.db-num and
     7954            ub.gds-season.sea-code = tt-season.sea-code ,
     7955       each gds-obj where
     7956             gds-obj.gds-code    = ub.gds-season.gds-code and
     7957             gds-obj.obj-code    = obj-list.obj-code and
     7958             gds-obj.obj-type    = obj-list.obj-type
     7959             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     7960             no-lock,
     7961             first goods where   gds-obj.gds-code  = goods.gds-code and
     7962                                 goods.gds-type    = 'т':U
     7963                                 no-lock
     7964               break
     7965                   by goods.grp-name
     7966                   by ub.gds-season.db-num
     7967                   by ub.gds-season.sea-code
     7968                   by ub.gds-season.gds-code
     7969                   with FRAME Zapas :
     7970                IF first-of(ub.gds-season.gds-code) then DO:
     7971                   assign
     7972                     f-qnty         = 0
     7973                     f-cost-sum     = 0
     7974                     f-sale-sum     = 0
     7975                     f-sale-other   = 0
     7976                     f-crsa-sum     = 0
     7977                     f-qnty-all     = 0
     7978                     f-cost-sum-all = 0
     7979                     f-crsa-sum-all = 0
     7980                     f-qnty-o       = 0
