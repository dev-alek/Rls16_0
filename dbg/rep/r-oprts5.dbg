     4316                          ub.gds-season.sea-code = tt-season.sea-code and
     4317                          ub.gds-season.db-num   = tt-season.db-num
     4318                          ,
     4319                     each goods no-lock where
     4320                          goods.gds-code    = ub.gds-season.gds-code and
     4321                          goods.gds-type   = 'т':U ,
     4322                     Each ub.ot-line where
     4323                             ub.ot-line.fact-order <= fact-order-2 and
     4324                             ub.ot-line.fact-order >= fact-order-1 and
     4325                             ub.ot-line.obj-code    = obj-list.obj-code and
     4326                             ub.ot-line.obj-type    = obj-list.obj-type  and
     4327                             ub.ot-line.prod-type   = goods.prod-type and
     4328                             ub.ot-line.prod-code   = goods.prod-code and
     4329                             ub.ot-line.artic       = goods.artic  and
     4330                             (ub.ot-line.sum-type   = 'sale':U OR
     4331                               ub.ot-line.sum-type  = 'crsa':U OR
     4332                               ub.ot-line.sum-type  = 'cost':U )
     4333                         break
     4334                             by (ub.gds-season.gds-code ) by goods.grp-name
     4335                             with FRAME Zapas :
     4336                n-nm = n-nm + 1.
     4337               IF first-of(ub.gds-season.gds-code) then DO:
     4338                   assign
     4339                     f-qnty         = 0
     4340                     f-cost-sum     = 0
     4341                     f-sale-sum     = 0
     4342                     f-sale-other   = 0
     4343                     f-crsa-sum     = 0
     4344                     f-qnty-all     = 0
     4345                     f-cost-sum-all = 0
     4346                     f-crsa-sum-all = 0
     4347                     f-qnty-o       = 0
     4348                     f-cost-sum-o   = 0
     4349                     f-crsa-sum-o   = 0.
     4350                  For Each temp-doc-code  : delete temp-doc-code . end.
     4351                  For Each temp-doc-code-all  : delete temp-doc-code-all . end.
     4352               End.
     4353               if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     4354                   Case  ub.ot-line.sum-type :
     4355                       When 'cost':U then do:
     4356                           f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     4357                       End.
     4358                       When 'sale':U then do:
     4359                           f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     4360                           f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     4361                       End.
     4362                       When  'crsa':U then do:
