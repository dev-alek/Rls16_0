     9308   procedure init-p2 :
     9309   run cur-time in this-procedure ( output v-today
     9310                               , output x-time
     9311                               ).
     9312   find last ub.ot-tot  no-lock use-index pi .
     9313   if avail  ub.ot-tot then fix-doc-code = ub.ot-tot.doc-code.
     9314                 else fix-doc-code = "".
     9315   FIND first clients where x-store-type = clients.obj-type AND
     9316           x-store-code = clients.obj-code no-lock no-error.
     9317           If available clients then  ObjName = clients.obj-name.
     9318                                         else  ObjName="объект не определен".
     9319     assign
     9320       i=0
     9321       startdate     = x-date-start
     9322       enddate       = x-date-end
     9323       PayType       = x-SET_PAY_TYPE
     9324       v-var         = string("no-today")
     9325       ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     9326       Find first ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     9327       If available  ub.gds-prt then   Prtroot = ub.gds-prt.prt-root.
     9328                             Else   Prtroot = 0.
     9329   end procedure.
     9330   procedure in-proc:
     9331     if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     9332         Case  ub.ot-line.sum-type :
     9333             When 'cost':U then do:
     9334                 f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     9335             End.
     9336             When 'sale':U then do:
     9337                 f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     9338                 f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     9339             End.
     9340             When  'crsa':U then do:
     9341                 f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     9342                 f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     9343                 IF itog = false then do:
     9344                     Create temp-doc-code .
     9345                     Assign  temp-doc-code.doc-code = ub.ot-line.doc-code
     9346                             temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     9347                     .
     9348                 End.
     9349             End.
     9350         End case.
     9351       End.
     9352         Case  ub.ot-line.sum-type :
     9353             when 'cost':U then do:
     9354               f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     9355             end.
     9356             when  'crsa':U then do:
     9357               f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     9358               f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     9359             end.
     9360         End case.
     9361   end procedure.
     9362   procedure last-of-artic :
     9363           n-nm = n-nm + 1.
     9364           Assign
     9365             f-qnty-o     = gds-obj.fact-qnty
     9366             f-cost-sum-o = gds-obj.fact-rubl
     9367             f-crsa-sum-o = gds-obj.fact-sale.
     9368           if itog = false and
     9369             ( x-zero  or
     9370             not(f-qnty        = 0 and
     9371                 f-cost-sum    = 0 and
     9372                 f-sale-sum    = 0 and
     9373                 f-sale-other  = 0 and
     9374                 f-crsa-sum    = 0 and
     9375                 f-qnty-all    = 0 and
     9376                 f-cost-sum-all =0 and
     9377                 f-crsa-sum-all =0 and
     9378                 f-qnty-o       =0 and
     9379                 f-cost-sum-o   =0 and
     9380                 f-crsa-sum-o   =0 ))
     9381             Then DO:
     9382             if x-zero = true and v-show-all-goods = false and
     9383                (f-qnty        = 0 and
     9384                 f-cost-sum    = 0 and
     9385                 f-sale-sum    = 0 and
     9386                 f-sale-other  = 0 and
     9387                 f-crsa-sum    = 0 and
     9388                 f-qnty-all    = 0 and
     9389                 f-cost-sum-all =0 and
     9390                 f-crsa-sum-all =0 and
     9391                 f-qnty-o       =0 and
     9392                 f-cost-sum-o   =0 and
     9393                 f-crsa-sum-o   =0 ) then next.
     9394                 n-nn = n-nn + 1 .
