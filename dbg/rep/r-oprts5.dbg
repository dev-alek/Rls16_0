     4369                                  temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     4370                                  temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     4371                                  temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     4372                                  .
