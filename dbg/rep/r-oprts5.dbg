     3186   procedure prdoclib-clear-temp-pl-gds :
     3187     define buffer buf_temp-pl-gds for temp-pl-gds .
     3188     do
     3189     on error undo, return error return-value
     3190     :
     3191       for each buf_temp-pl-gds
     3192       on error undo, return error return-value
     3193       :
     3194         delete buf_temp-pl-gds .
     3195       end.
     3196     end.
     3197   end procedure.
     3198   procedure prdoclib-init-temp-pl-gds :
     3199     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3200     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3201     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3202     define buffer buf_pl-gds      for ub.pl-gds .
     3203     define buffer buf_temp-pl-gds for temp-pl-gds .
     3204     do
     3205     on error undo, return error return-value
     3206     :
     3207       run prdoclib-clear-temp-pl-gds in this-procedure .
     3208       for each buf_pl-gds
     3209         where buf_pl-gds.obj-type = p-obj-type
     3210           and buf_pl-gds.obj-code = p-obj-code
     3211           and buf_pl-gds.gds-code = p-gds-code
     3212       on error undo, return error return-value
     3213       :
     3214         create buf_temp-pl-gds .
     3215         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3216       end.
     3217     end.
     3218   end procedure.
     3219   procedure prdoclib-init-pl-gds-by-factord :
     3220     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3221     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3222     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3223     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3224     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3225     define input parameter p-fact-order         as decimal   no-undo .
     3226     define input parameter p-include-fact-order as logical   no-undo .
     3227     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3228     define buffer buf_goods       for ub.goods .
     3229     define buffer buf_gds-obj     for ub.gds-obj .
     3230     define buffer buf_doc-line    for ub.doc-line .
     3231     define buffer buf_temp-pl-gds for temp-pl-gds .
     3232     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3233     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3234     do
     3235     on error undo, return error return-value
     3236     :
     3237       do transaction
     3238       on error undo, return error return-value
     3239       :
     3240   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3242     (input  p-obj-type
     3243     ,input  p-obj-code
     3244     ,input  p-artic
     3245     ,input  p-prod-type
     3246     ,input  p-prod-code
     3247     ,buffer buf_gds-obj
     3248     ) no-error .
     3249         if error-status :error
     3250         then do:
     3251           message
     3252             vss-workfile vss-revision vss-description skip
     3253             vss-include-info16 skip
     3254             "Невозможно найти gds-obj" skip
     3255             error-status :get-message(1) skip
     3256             return-value skip
     3257             view-as alert-box error .
     3258           undo, return error return-value .
     3259         end.
     3260         find current buf_gds-obj exclusive-lock .
     3261       end.
     3262       find first buf_goods no-lock
     3263         where buf_goods.artic     = p-artic
     3264           and buf_goods.prod-type = p-prod-type
     3265           and buf_goods.prod-code = p-prod-code
     3266         .
     3267       run prdoclib-init-temp-pl-gds in this-procedure
     3268         (input p-obj-type
     3269         ,input p-obj-code
     3270         ,input buf_goods.gds-code
     3271         ) .
     3272       if p-include-fact-order = true
     3273       then do:
     3274         assign
     3275          p-fact-order = p-fact-order - 0.0000000001
     3276         .
     3277       end.
     3278       for each buf_doc-line no-lock
     3279         where buf_doc-line.obj-type   = p-obj-type
     3280           and buf_doc-line.obj-code   = p-obj-code
     3281           and buf_doc-line.artic      = p-artic
     3282           and buf_doc-line.prod-type  = p-prod-type
     3283           and buf_doc-line.prod-code  = p-prod-code
     3284           and buf_doc-line.status_    = 'факт':U
     3285           and buf_doc-line.fact-order >= p-fact-order
     3286       on error undo, return error return-value
     3287       :
     3288         run prdoclib-prc-pl-document in this-procedure
     3289           ( input  buf_doc-line.doc-code
     3290            ,input  p-obj-type
     3291            ,input  p-obj-code
     3292            ,input  buf_goods.gds-code
     3293            ,output v-total-pl-gds-qnty
     3294            ,output v-total-pl-gds-cli-qnty
     3295           ) .
     3296       end.
     3297     end.
     3298   end procedure.
     3299   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     3300     if num-entries(string(p-dec), '.') = 2
     3301       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     3302       else return( string(p-dec)) .
     3303   end function.
     3304   function format-point-to-comma returns char (input orig as char ) .
     3305   define variable rtext as character no-undo .
     3306   define variable strt as integer no-undo .
     3307   define variable leng as integer no-undo .
     3308   assign rtext = orig .
     3309   repeat:
     3310     strt =  index(rtext,'.').
     3311     if strt = 0 then leave.
     3312     leng = 1.
     3313     substring(rtext,strt,leng,"character") = v-delim .
     3314   end.
     3315   return rtext.
     3316   end function.
     3317   function format-excel-text returns char ( input start-text as char ) :
     3318   def var  i    as int no-undo.
     3319   def var  ch   as char no-undo.
     3320   def var  n    as int no-undo.
     3321   def var  ipos as int no-undo.
     3322     n = num-entries(trim(start-text), chr(10)) - 1 .
     3323     do i = 1 to n :
     3324       ipos = index( start-text, chr(10)).
     3325       if ipos > 0 then
     3326         substr( start-text, ipos, 1 ) = ' '.
     3327     end.
     3328     n = num-entries(trim(start-text), chr(13)) - 1 .
     3329     do i = 1 to n :
     3330       ipos = index( start-text, chr(13)).
     3331       if ipos > 0 then
     3332         substr( start-text, ipos, 1 ) = ' '.
     3333     end.
     3334     if index( start-text, '"' ) = 0 then
     3335       start-text =  '="'   + trim( start-text) + '"'   .
     3336       else do:
     3337         n = num-entries(trim(start-text), '"') - 1.
     3338         do i = 1 to n :
     3339           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     3340         end.
     3341         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     3342         start-text = '="'  + ch  + '"' .
     3343       end.
     3344     return start-text.
     3345   end.
     3346   function excel-sum returns char (input p-dec as decimal ).
     3347     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     3348   end function.
     3349   function excel-qnty returns char (input p-dec as decimal ).
     3350     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     3351   end function.
     3352   function format-excel-text-macr returns char ( input start-text as char ) :
     3353   def var  i    as int no-undo.
     3354   def var  ch   as char no-undo.
     3355   def var  n    as int no-undo.
     3356   def var  ipos as int no-undo.
     3357     n = num-entries(trim(start-text), chr(10)) - 1 .
     3358     do i = 1 to n :
     3359       ipos = index( start-text, chr(10)).
     3360       if ipos > 0 then
     3361         substring( start-text, ipos , 1 ) = ' '.
     3362     end.
     3363     n = num-entries(trim(start-text), chr(13)) - 1 .
     3364     do i = 1 to n :
     3365       ipos = index( start-text, chr(13)).
     3366       if ipos > 0 then
     3367         substring( start-text, ipos, 1 ) = ' '.
     3368     end.
     3369     if index( start-text, '"' ) = 0 then
     3370       start-text =  '"'   + trim( start-text) + '"'   .
     3371       else do:
     3372         n = num-entries(trim(start-text), '"') - 1.
     3373         do i = 1 to n :
     3374           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     3375         end.
     3376         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     3377         start-text = '"'  + ch  + '"' .
     3378       end.
     3379     n = num-entries(trim(start-text), chr(10)) - 1 .
     3380     do i = 1 to n :
     3381       ipos = index( start-text, chr(10)).
     3382       if ipos > 0 then
     3383         substring( start-text, ipos , 1 ) = ' '.
     3384     end.
     3385       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     3386     return start-text.
     3387   end.
     3388   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3389   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     3390      IF parundefine-var = ? THEN RETURN 0.00.
     3391                             ELSE RETURN parundefine-var.
     3392   END FUNCTION.
     3393   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     3394      IF p-undef-char = ? THEN do:
     3395        RETURN "?".
     3396      end.
     3397      ELSE do:
     3398        RETURN p-undef-char .
     3399      end.
     3400   END FUNCTION.
