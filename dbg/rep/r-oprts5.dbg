     4847   PROCEDURE foreach6 :
     4848     for each obj-list no-lock with FRAME Zapas :
     4849       if NOT( classify = 1 and Itog = true) then dO:
     4850     if c-f-gds-name <>  ?  then do :
     4851       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     4852       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4853           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4854           display STREAM OutStream    with frame top-frame .
     4855       End.
     4856     End.
     4857   if c-f-qnty <>  ?  then do :
     4858   Assign
     4859       l1f-qnty  = c-f-qnty:DATA-TYPE
     4860       l2f-qnty  = c-f-qnty:FORMAT
     4861       c-f-qnty:DATA-TYPE = "CHARACTER"
     4862       c-f-qnty:FORMAT    = "x(" + string(C-f-qnty:WIDTH-CHARS) + ")"
     4863       c-f-qnty:screen-value = string('')  .
     4864   End.
     4865   if c-f-cost-sum <>  ?  then do :
     4866   Assign
     4867       l1f-cost-sum  = c-f-cost-sum:DATA-TYPE
     4868       l2f-cost-sum  = c-f-cost-sum:FORMAT
