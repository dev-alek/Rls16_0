     9507                 if Make-Excel then  put   stream ForExcel unformatted
     9508                   string(n-nn)                      CHR(9)
     9509                   v-bar-code                        CHR(9)
     9510                   (gds-obj.artic)                   CHR(9)
     9511                   goods.gds-name                    CHR(9)
     9512                   excel-qnty(f-qnty        )        CHR(9)
     9513                   excel-sum (f-cost-sum    )        CHR(9)
     9514                   excel-sum (f-sale-sum    )        CHR(9)
     9515                   excel-sum (f-sale-other  )        CHR(9)
     9516                   excel-sum (f-crsa-sum    )        CHR(9)
     9517                   excel-sum (f-qnty-all    )        CHR(9)
     9518                   excel-sum (f-cost-sum-all)        CHR(9)
     9519                   excel-sum (f-crsa-sum-all)        CHR(9)
     9520                   excel-sum (f-qnty-o      )        CHR(9)
     9521                   excel-qnty(f-cost-sum-o  )        CHR(9)
     9522                   excel-qnty(f-crsa-sum-o  )        chr(10) .
     9523                   run display-prt in this-procedure .
     9524            End.
     9525   end procedure.
