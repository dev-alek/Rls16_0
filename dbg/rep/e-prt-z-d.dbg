      470   def  query   br-gds-prt for prt-tree SCROLLING.
      471   def  browse  br-gds-prt
      472          query br-gds-prt
      473          disp
      474          is-sel format "x(1)" column-label "*"
      475          fnc-shift-name (prt-tree.level, prt-tree.mark, prt-tree.n-name) @ shift-name
      476          format "x(55)" column-label "Признак"
      477   WITH SIZE 57 BY 16 separators.
      478   DEFINE BUTTON b-exp-nd
      479        LABEL "&>>":L
      480        SIZE 4.5 BY 1.
      481   DEFINE BUTTON b-exp-tree
      482        LABEL ">>&->>":L
      483        SIZE 9 BY 1.
      484   DEFINE BUTTON b-exit AUTO-go
      485        LABEL "&Выход ":L
      486        SIZE 9 BY 1.
      487   DEFINE BUTTON b-sel AUTO-go
      488        LABEL "Вы&бор ":L
      489        SIZE 9 BY 1.
      490   DEFINE BUTTON b-help
      491        LABEL "Помо&щь":L
      492        SIZE 9 BY 1.
      493   DEFINE BUTTON b-snezhinka
      494        LABEL "*":L
      495        SIZE 3 BY 1.
      496   DEFINE BUTTON b-sel-all
      497        LABEL "+":L
      498        SIZE 3 BY 1.
      499   DEFINE BUTTON b-unsel-all
      500        LABEL "-":L
      501        SIZE 3 BY 1.
      502   DEFINE FRAME e-prt-z-dlg
      503     b-exit     AT ROW 1.25  COL 1
      504     b-sel      AT ROW 1.25  COL 10
      505     b-help     AT ROW 1.25  COL 22
      506     b-snezhinka AT ROW 3 COL 2
      507     b-sel-all   at row 3 col 5
      508     b-unsel-all at row 3 col 8
      509     br-gds-prt      AT ROW 4.5   COL 2
      510     b-exp-nd   AT ROW 3  COL 23
      511     b-exp-tree AT ROW 3  COL 27.5
      512     WITH size 60 by 21 VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D.
      513   on row-display of br-gds-prt do:
      514     if prt-tree.is-root then
      515       shift-name :fgcolor in browse br-gds-prt = BLUE_COLOR.
      516     else
      517       if not prt-tree.is-term then
      518         shift-name :fgcolor in browse br-gds-prt = BROWN_COLOR.
      519     prt-tree.is-sel = "".
      520     for first work-elems where work-elems.elem = prt-tree.n-code:
      521         prt-tree.is-sel = "*".
      522     end.
      523   end.
      524   ON CHOOSE OF b-exit IN FRAME e-prt-z-dlg  DO:
      525     return "exit":U.
      526   END.
      527   ON CHOOSE OF b-sel IN FRAME e-prt-z-dlg  DO:
      528         v-prizn = "".
      529         for each work-elems:
      530             v-prizn = v-prizn + string(work-elems.elem) + ",".
      531         end.
      532   END.
      533   ON choose of b-exp-nd IN FRAME e-prt-z-dlg DO:
      534     gds-prt-row = current-result-row ("br-gds-prt").
      535     run exp-nd (?).
      536     run UI-on.
      537   END.
      538   ON choose of b-exp-tree IN FRAME e-prt-z-dlg DO:
      539     gds-prt-row = current-result-row ("br-gds-prt").
      540     run exp-tree.
      541     run UI-on.
      542   END.
      543   ON choose of b-snezhinka IN FRAME e-prt-z-dlg DO:
      544      if prt-tree.is-sel = "*" then do:
      545         run waitfram-show in this-procedure
      546         (input "Производится удаление признаков из списка. Ждите..."
      547         ).
      548         if not prt-tree.is-term then run delete-child (prt-tree.n-code).
      549         else do:
      550           for each work-elems where elem = prt-tree.n-code:
      551               delete work-elems.
      552           end.
      553         end.
      554         run waitfram-hide in this-procedure .
      555       end.
      556       else do:
      557           found = no.
      558           run waitfram-show in this-procedure
      559           (input "Производится добавление признаков в список. Ждите..."
      560           ).
      561           if not prt-tree.is-term then run write-child (prt-tree.n-code).
      562           else do:
      563               for first work-elems where elem = prt-tree.n-code:
      564                   found = yes.
      565               end.
      566               if not found then do:
      567                   create work-elems.
      568                   assign elem = prt-tree.n-code.
      569               end.
      570           end.
      571           run waitfram-hide in this-procedure .
      572       end.
      573       gds-prt-row = current-result-row ("br-gds-prt").
      574       run ui-on.
      575   END.
      576   ON MOUSE-SELECT-DBLCLICK, return OF br-gds-prt IN FRAME e-prt-z-dlg DO:
      577       apply "choose" to b-exp-nd in frame e-prt-z-dlg.
      578       return no-apply.
      579   END.
      580   ON choose of b-sel-all IN FRAME e-prt-z-dlg DO:
      581     for each work-elems:
      582         delete work-elems.
      583     end.
      584     for each gds-prt no-lock:
      585         create work-elems.
      586         assign work-elems.elem = gds-prt.node-code.
      587     end.
      588     run UI-on.
      589   END.
      590   ON choose of b-unsel-all IN FRAME e-prt-z-dlg DO:
      591     for each work-elems:
      592         delete work-elems.
      593     end.
      594     run UI-on.
      595   END.
      596   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED THEN
      597     CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      598   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   on help of frame e-prt-z-dlg
      600   do:
      601     run gbl/app_help.p
      602       (input this-procedure :file-name
      603       ,input ''
      604       ,input ?
      605       ) no-error.
      606     if error-status :error then do:
      607       message
      608         "Ошибка при вызове помощи"
      609         error-status :get-message(1)
      610         view-as alert-box .
      611     end.
      612   end.
      613   run minbtn-set in this-procedure .
      614   on choose of b-help in frame e-prt-z-dlg
      615   do:
      616     apply "help":u to frame e-prt-z-dlg .
      617   end.
      618   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   procedure minbtn-set :
      620       do
      621           on error undo, return error return-value
      622           :
      623           define variable ii              as integer       no-undo .
      624           define variable fh              as widget-handle no-undo .
      625           define variable hh              as widget-handle no-undo .
      626           define variable v-h             as handle        extent 4 no-undo .
      627           define variable v-name-button   as character     no-undo .
      628           define variable v-help-old-x    as decimal       no-undo .
      629           define variable v-help-old-y    as decimal       no-undo .
      630           define variable v-help-old-size as decimal       no-undo .
      631           define variable v-frame-width   as decimal       no-undo .
      632           define variable jj              as integer       no-undo .
      633           do
      634               on error undo, return error
      635               :
      636               assign
      637                   v-frame-width = frame e-prt-z-dlg:width - 0.3
      638                   fh            = frame e-prt-z-dlg:first-child
      639                   hh            = fh:first-child
      640                   ii            = 1
      641                   .
      642               do while valid-handle(hh):
      643                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      644                   do:
      645                       case lc(hh:name) :
      646                           when "b-help" then
      647                               do:
      648                                   hh:load-image-up("cmp/b-help.bmp":u) .
      649                                   hh:load-image-down("cmp/b-help.bmp":u) .
      650                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      651                                   hh:TOOLTIP = "Помощь" .
      652                                   v-help-old-x = hh:column .
      653                                   v-help-old-y = hh:row    .
      654                                   v-help-old-size = hh:width .
      655                                   hh:width-chars = 2.5 .
      656                               end.
      657                           when "b-print" then
      658                               do:
      659                                   hh:load-image("cmp/b-print.bmp":u) .
      660                                   hh:TOOLTIP = "Печать" .
      661                                   v-h[ii] = hh:handle .
      662                                   ii = ii + 1 .
      663                                   hh:width-chars = 3 .
      664                               end.
      665                           when "b-history" or
      666                           when "b-hist" then
      667                               do:
      668                                   hh:load-image("cmp/b-hist.bmp":u) .
      669                                   hh:TOOLTIP = "История" .
      670                                   v-h[ii] = hh:handle .
      671                                   ii = ii + 1 .
      672                                   hh:width-chars = 3 .
      673                               end.
      674                           when "b-sch" then
      675                               do:
      676                                   hh:load-image("cmp/b-sch.bmp":u) .
      677                                   hh:TOOLTIP = "Установка Фильтра" .
      678                                   v-h[ii] = hh:handle .
      679                                   ii = ii + 1 .
      680                                   hh:width-chars = 3 .
      681                               end.
      682                           when "b-hist-user" then
      683                               do:
      684                                   hh:load-image("cmp/b-hist.bmp":u) .
      685                                   hh:TOOLTIP = "История пользователя" .
      686                                   ii = ii + 1 .
      687                               end.
      688                       end case.
      689                   end.
      690                   hh = hh:next-sibling.
      691               end.
      692               b-help:column = v-frame-width - b-help:width-chars.
      693               jj = 0.
      694               repeat ii = 4 to 1 by -1 :
      695                   if valid-handle (v-h[ii] ) then
      696                   do:
      697                       jj  = jj + 1 .
      698                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      699                       v-h[ii]:row    = v-help-old-y .
      700                   end.
      701               end.
      702           end.
      703       end.
      704   end procedure.
      705   ON WINDOW-CLOSE OF FRAME e-prt-z-dlg APPLY "END-ERROR":U TO SELF.
      706    ENABLE br-gds-prt
      707              b-exit
      708              b-help
      709              b-exp-nd
      710              b-exp-tree
      711              b-snezhinka
      712              b-sel-all
      713              b-unsel-all
      714              with FRAME e-prt-z-dlg.
      715   define variable pr-cur as integer no-undo init 0.
      716   if v-prizn <> "" then do:
      717       do while pr-cur < num-entries(v-prizn,","):
      718           pr-cur = pr-cur + 1.
      719           create work-elems.
      720           assign elem = integer(entry(pr-cur,v-prizn,",")).
      721       end.
      722   end.
      723   for each gds-prt  where gds-prt.root no-lock:
      724       g#log = session:set-wait-state ("COMPILER") .
      725       run cre-nd (buffer gds-prt, buffer prt-tree, 0).
      726   end.
      727   find first prt-tree.
      728   FRAME e-prt-z-dlg:title = "Выбор признака".
      729   ENABLE b-sel
      730          with FRAME e-prt-z-dlg.
      731   find first prt-tree.
      732   run ui-on.
      733   g#log = session:set-wait-state ( "" ) .
      734   do on endkey undo, leave  on error undo, leave:
      735     WAIT-FOR GO OF FRAME e-prt-z-dlg.
      736   end.
      737   run disable_ui.
      738   PROCEDURE disable_UI :
      739     HIDE FRAME e-prt-z-dlg.
      740   END PROCEDURE.
      741   PROCEDURE UI-on :
      742   OPEN QUERY br-gds-prt
      743       FOR EACH  prt-tree where
      744                 prt-tree.visible = yes and
      745                 (prt-tree.is-term = no
      746                 ) no-lock.
      747   OPEN QUERY  br-gds-prt
      748     FOR EACH  prt-tree where
      749               prt-tree.visible = yes no-lock.
      750   reposition br-gds-prt to row gds-prt-row no-error.
      751   apply "ENTRY":U to br-gds-prt in frame e-prt-z-dlg.
      752   END PROCEDURE.
      753   PROCEDURE exp-nd :
      754   def input param make-visible as logical no-undo.
      755   define variable nd-level as integer no-undo.
      756   def buffer b-prt-tree for prt-tree.
      757   if prt-tree.exp then do:
      758     nd-level = prt-tree.level.
      759     find b-prt-tree where
      760          recid (b-prt-tree) = recid (prt-tree).
      761     inverse:
      762     do while true:
      763       find next b-prt-tree no-error.
      764       if not available b-prt-tree then
      765         leave inverse.
      766       if b-prt-tree.level > nd-level then do:
      767         if make-visible = ? then
      768           make-visible = not (b-prt-tree.visible).
      769         if not make-visible or
      770            b-prt-tree.level - nd-level = 1 then do:
      771           b-prt-tree.visible = make-visible.
      772           if not b-prt-tree.is-term then
      773             b-prt-tree.mark = "»".
      774         end.
      775       end.
      776       else
      777         leave inverse.
      778     end.
      779   end.
      780   else do:
      781     prt-tree.exp = yes.
      782     run cre-level (recid (prt-tree), prt-tree.level + 1).
      783     make-visible = yes.
      784   end.
      785   if not prt-tree.is-term then
      786     if make-visible then
      787       prt-tree.mark = "".
      788     else
      789       prt-tree.mark = "»".
      790   END PROCEDURE.
      791   procedure write-child :
      792       define input parameter parnode as integer no-undo.
      793       define buffer b-prt-tree for gds-prt.
      794           create work-elems.
      795           assign elem = parnode.
      796       for each b-prt-tree where b-prt-tree.upper-code = parnode no-lock:
      797           if b-prt-tree.is-term then do:
      798                   create work-elems.
      799                   assign elem = b-prt-tree.node-code.
      800           end.
      801           else run write-child (b-prt-tree.node-code).
      802       end.
      803   end.
      804   procedure delete-child :
      805       define input parameter parnode as integer no-undo.
      806       define buffer b-prt-tree for gds-prt.
      807       for each work-elems where elem = parnode:
      808           delete work-elems.
      809       end.
      810       for each b-prt-tree where b-prt-tree.upper-code = parnode no-lock:
      811           if b-prt-tree.is-term then do:
      812               for each work-elems where elem = b-prt-tree.node-code:
      813                   delete work-elems.
      814               end.
      815           end.
      816           else run delete-child (b-prt-tree.node-code).
      817       end.
      818   end.
      819   PROCEDURE exp-tree :
      820     define variable rid as recid no-undo.
      821     do
      822     on error undo, return error return-value
      823     :
      824       tree-level = prt-tree.level.
      825       run waitfram-show in this-procedure
      826         (input "Раскрывается шкала. Ждите..."
      827         ).
      828       tree:
      829       do while true:
      830         rid = recid (prt-tree).
      831         run exp-nd (yes).
      832         find prt-tree where rid = recid (prt-tree).
      833         find next prt-tree no-error.
      834         if not available prt-tree or
      835           prt-tree.level <= tree-level
      836           then
      837           leave tree.
      838       end.
      839       run waitfram-hide in this-procedure .
      840     end.
      841   END PROCEDURE.
      842   PROCEDURE cre-level:
      843   def input param prt-tree-rec as recid   no-undo.
      844   def input param cur-lev      as integer no-undo.
      845   def buffer b-gds-prt  for gds-prt.
      846   def buffer b-prt-tree for prt-tree.
      847   define variable up-code like gds-prt.node-code no-undo.
      848   find b-prt-tree where
      849        recid (b-prt-tree) = prt-tree-rec.
      850   up-code = b-prt-tree.n-code.
      851   for each b-gds-prt no-lock where
      852            b-gds-prt.upper-code = up-code
      853            by b-gds-prt.prt-num:
      854     run cre-nd (buffer b-gds-prt, buffer b-prt-tree, cur-lev).
      855   end.
      856   END PROCEDURE.
      857   PROCEDURE cre-nd:
      858   def param buffer b-gds-prt  for gds-prt.
      859   def param buffer b-prt-tree for prt-tree.
      860   def input param cur-lev as integer no-undo.
      861   def buffer bf-prt-tree for prt-tree.
      862   create b-prt-tree.
      863   assign
      864     b-prt-tree.n-code   = b-gds-prt.node-code
      865     b-prt-tree.level    = cur-lev
      866     b-prt-tree.n-name   = b-gds-prt.node-name
      867     b-prt-tree.rid      = recid (b-gds-prt)
      868     b-prt-tree.visible  = yes
      869     b-prt-tree.is-term  = b-gds-prt.is-term
      870     b-prt-tree.is-root  = b-gds-prt.root
      871     b-prt-tree.parnt    = b-gds-prt.upper-code
      872     .
      873   for first bf-prt-tree where bf-prt-tree.n-code = b-gds-prt.upper-code.
      874       if bf-prt-tree.is-sel = "*" then do:
      875           b-prt-tree.is-sel = "*".
      876       end.
      877   end.
      878   if b-gds-prt.is-term then
      879     assign
      880       b-prt-tree.mark = "  "
      881       b-prt-tree.exp = yes
      882       .
      883   else
      884     assign
      885       b-prt-tree.mark = "  »"
      886       b-prt-tree.exp = no
      887       .
      888   END PROCEDURE.
      889   PROCEDURE cre-code:
      890   define variable is-new as log no-undo.
      891   def buffer buf_bar-code for bar-code.
      892     if not prt-tree.is-term and
      893        not prt-tree.is-root then do:
      894       message
      895         "Узел промежуточный. Работа с кодами запрещена."
      896         view-as alert-box error.
      897       return error.
      898     end.
      899   end.
