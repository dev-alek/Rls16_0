     1345     assign frame F-Main
     1346       Tog-Excel
     1347       use-column[  1 ]
     1348       use-column[  2 ]
     1349       use-column[  3 ]
     1350       use-column[  4 ]
     1351       use-column[  5 ]
     1352       use-column[  6 ]
     1353       use-column[  7 ]
     1354       use-column[  8 ]
     1355       use-column[  9 ]
     1356       use-column[ 10 ]
     1357       use-column[ 11 ]
     1358       use-column[ 12 ]
     1359       use-column[ 13 ]
     1360       use-column[ 14 ]
     1361       use-column[ 15 ]
     1362       .
     1363     assign
     1364       STR-obj-type = '':U
     1365       STR-obj-code = '':U
     1366       STR-obj-name = '':U
     1367       STR-obj      = '':U
     1368     .
     1369     for each obj-list no-lock
     1370     :
     1371       assign
     1372         STR-obj-type = STR-obj-type +         obj-list.obj-type   + chr(44)
     1373         STR-obj-code = STR-obj-code + string( obj-list.obj-code ) + chr(44)
     1374         STR-obj-name = STR-obj-name +         obj-list.obj-name   + chr(44)
     1375         STR-obj      = STR-obj      +         obj-list.obj-type   + '#':U
     1376                                     + string( obj-list.obj-code ) + chr(44)
     1377       .
     1378     end.
     1379     assign
     1380       ReportName   = 'Почасовая статистика продаж ТРК с детализацией по пистолетам':U
     1381       ReportHeader = '':U
     1382     .
     1383   end procedure.
     1384   procedure state-changed :
     1385     define input parameter p-issuer-hdl as handle    no-undo .
     1386     define input parameter p-state      as character no-undo .
     1387     case p-state :
     1388       when 'link-changed':U
     1389       then do:
     1390         run my-var in this-procedure .
     1391       end.
     1392     end case.
     1393   end procedure.
