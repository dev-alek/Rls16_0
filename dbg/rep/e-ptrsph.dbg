     1097         buf_usr-flt.user-name  = v-cntxt-userid
     1098         buf_usr-flt.call-point = c-flt
     1099       .
     1100     end.
     1101     assign
     1102       r-flt = recid( buf_usr-flt )
     1103     .
     1104     find first buf_usr-flt exclusive-lock where
     1105         recid( buf_usr-flt ) = r-flt .
     1106       assign
     1107         buf_usr-flt.list_ = '':U
     1108         .
     1109       do jj = 1 to 15
     1110         :
     1111         assign
     1112           buf_usr-flt.list_ = buf_usr-flt.list_ + ( if use-column[ jj ] = yes then '+':U else '-':U )
     1113           .
     1114         if use-column[ jj ] = yes
     1115           then
     1116         do:
     1117           assign
     1118             jndex = jndex + 1
     1119             .
     1120         end.
     1121       end.
     1122       release buf_usr-flt no-error .
     1123       if error-status :error
     1124         then
     1125       do:
     1126         message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1127           error-status :get-message(1) skip
     1128           return-value skip
     1129           'Ошибка  release'
     1130           view-as alert-box error .
     1131       end.
     1132       if jndex = 0
     1133         then
     1134       do:
     1135         message 'Не выбрано ни одно поле для печати.' view-as alert-box error .
     1136         return no-apply .
     1137       end.
     1138     end.
     1139   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1140   on F7, CTRL-S, CTRL-Ы of frame F-Main anywhere do:
