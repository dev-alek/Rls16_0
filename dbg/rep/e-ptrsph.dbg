     1162       "Ошибка при запуске процедуры" skip
     1163       "Данную процедуру следует запускать только с параметром persistent" skip
     1164       view-as alert-box error .
     1165     undo, return error .
     1166   end.
     1167   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
