      660   .
      661   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      662   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      663   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      664   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      665   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      666   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      667   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      668   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      669         adm-object-hdl = FRAME F-Main:HANDLE.
      670   RUN ensure-broker.
      671   THIS-PROCEDURE:ADM-DATA =
      672        'ADM1.1~`':U +
      673        'SmartObject~`':U +
      674        '~`':U +
      675        'NO ~`':U +
      676        '~`':U +
      677        '~`':U +
      678        '~`':U +
      679        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      680           + "~`":U +
      681        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      682        'Record-Source,Record-Target,TableIO-Target~`':U +
      683        '~`':U +
      684        '~`~`~`~`~`~`~`~`~`~`~`':U +
      685        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      686            THEN "^^":U
      687        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      688             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      689   PROCEDURE adm-apply-entry :
      690     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      691   END PROCEDURE.
      692   PROCEDURE adm-destroy :
      693    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      694   END PROCEDURE.
      695   PROCEDURE adm-disable :
      696       DISABLE b-mark Btn_UnMark b-save use-column[ 1 ] use-column[ 2 ] use-column[ 3 ] use-column[ 4 ] use-column[ 5 ] use-column[ 6 ] use-column[ 7 ] use-column[ 8 ] use-column[ 9 ] use-column[ 10 ] use-column[ 11 ] use-column[ 12 ] use-column[ 13 ] use-column[ 14 ] use-column[ 15 ] WITH FRAME F-Main.
      697       RUN dispatch ('disable-fields':U).
      698       RUN set-attribute-list ('ENABLED=no':U).
      699       RETURN.
      700   END PROCEDURE.
      701   PROCEDURE adm-edit-attribute-list :
      702         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      703         RETURN.
      704   END PROCEDURE.
      705   PROCEDURE adm-enable :
      706       ENABLE UNLESS-HIDDEN b-mark Btn_UnMark b-save use-column[ 1 ] use-column[ 2 ] use-column[ 3 ] use-column[ 4 ] use-column[ 5 ] use-column[ 6 ] use-column[ 7 ] use-column[ 8 ] use-column[ 9 ] use-column[ 10 ] use-column[ 11 ] use-column[ 12 ] use-column[ 13 ] use-column[ 14 ] use-column[ 15 ] WITH FRAME F-Main.
      707       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      708       RUN set-attribute-list ('ENABLED=yes':U).
      709       RETURN.
      710   END PROCEDURE.
      711   PROCEDURE adm-exit :
      712        RUN notify ('exit':U).
      713     RETURN.
      714   END PROCEDURE.
      715   PROCEDURE adm-hide :
      716     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      717   END PROCEDURE.
      718   PROCEDURE adm-initialize :
      719     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      720   END PROCEDURE.
      721   PROCEDURE adm-show-errors :
      722       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      723       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      724           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      725       END.
      726       RETURN.
      727   END PROCEDURE.
      728   PROCEDURE adm-UIB-mode :
      729     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      730   END PROCEDURE.
      731   PROCEDURE adm-view :
      732     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      733   END PROCEDURE.
      734   PROCEDURE dispatch :
      735       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      736       RUN broker-dispatch IN adm-broker-hdl
      737           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      738       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      739   END PROCEDURE.
      740   PROCEDURE ensure-broker :
      741   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      742   IF RETURN-VALUE NE "ADM-Broker":U THEN
      743   DO:
      744       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      745       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      746   END.
      747   END PROCEDURE.
      748   PROCEDURE get-attribute :
      749     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      750     RUN broker-get-attribute IN adm-broker-hdl
      751         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      752     RETURN RETURN-VALUE.
      753   END PROCEDURE.
      754   PROCEDURE get-attribute-list :
      755     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      756     RUN broker-get-attribute-list IN adm-broker-hdl
      757         (INPUT THIS-PROCEDURE,
      758          INPUT ?,
      759          OUTPUT p-attr-list) NO-ERROR.
      760     RETURN.
      761   END PROCEDURE.
      762   PROCEDURE new-state :
      763     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      764     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      765     RETURN.
      766   END PROCEDURE.
      767   PROCEDURE notify :
      768     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      769     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      770     IF RETURN-VALUE = "ADM-ERROR":U THEN
      771         RETURN "ADM-ERROR":U.
      772     RETURN.
      773   END PROCEDURE.
      774   PROCEDURE set-attribute-list :
      775     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      776     RUN ensure-broker.
      777     RUN broker-set-attribute-list IN adm-broker-hdl
      778         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      779     RETURN.
      780   END PROCEDURE.
      781   PROCEDURE set-position :
      782       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      783       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      784       IF VALID-HANDLE(adm-object-hdl) THEN
      785       DO:
      786         ASSIGN adm-object-hdl:ROW    =   p-row
      787                adm-object-hdl:COLUMN =   p-col.
      788       END.
      789       RETURN.
      790   END PROCEDURE.
      791   PROCEDURE adm-display-fields :
      792       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      793       RETURN.
      794   END PROCEDURE.
      795   PROCEDURE adm-open-query :
      796     RETURN.
      797   END PROCEDURE.
      798   PROCEDURE adm-row-changed :
      799         IF VALID-HANDLE(adm-object-hdl) THEN
      800           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      801         RUN notify ('row-available':U).
      802         RETURN.
      803   END PROCEDURE.
      804   PROCEDURE reposition-query :
      805       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      806       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      807       RETURN.
      808   END PROCEDURE.
      809     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      810     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      811     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      812     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      813     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      814     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      815     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      816     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      817     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      818     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      819     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      820     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      821     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      822     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      823     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      824     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      825     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      826     IF "":U = "":U THEN
      827       RUN modify-list-attribute IN adm-broker-hdl
      828         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      829     RUN use-create-on-add(?).
      830   PROCEDURE adm-add-record :
      831       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      832          "must have at least one Enabled Table to perform Add.":U
      833          VIEW-AS ALERT-BOX ERROR.
      834       RETURN.
      835   END PROCEDURE.
      836   PROCEDURE adm-assign-record :
      837    MESSAGE
      838          "Object ":U THIS-PROCEDURE:FILE-NAME
      839            "must have at least one Enabled Table to perform Assign.":U
      840              VIEW-AS ALERT-BOX ERROR.
      841      RETURN.
      842     END PROCEDURE.
      843   PROCEDURE adm-assign-statement :
      844     RETURN.
      845   END PROCEDURE.
      846   PROCEDURE adm-cancel-record :
      847      RETURN.
      848     END PROCEDURE.
      849   PROCEDURE adm-copy-record :
      850       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      851        "must have at least one Enabled Table to perform Copy.":U
      852          VIEW-AS ALERT-BOX ERROR.
      853       RETURN.
      854   END PROCEDURE.
      855   PROCEDURE adm-create-record :
      856      RETURN.
      857   END PROCEDURE.
      858   PROCEDURE adm-current-changed :
      859     RETURN.
      860   END PROCEDURE.
      861   PROCEDURE adm-delete-record :
      862    MESSAGE
      863          "Object ":U THIS-PROCEDURE:FILE-NAME
      864            "must have at least one Enabled Table to perform Delete.":U
      865              VIEW-AS ALERT-BOX ERROR.
      866       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      867       RETURN.
      868   END PROCEDURE.
      869   PROCEDURE adm-disable-fields :
      870         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      871       RETURN.
      872   END PROCEDURE.
      873   PROCEDURE adm-enable-fields :
      874       RETURN.
      875   END PROCEDURE.
      876   PROCEDURE adm-end-update :
      877     RETURN.
      878   END PROCEDURE.
      879   PROCEDURE adm-reset-record :
      880       RETURN.
      881   END PROCEDURE.
      882   PROCEDURE adm-update-record :
      883       MESSAGE
      884         "Object ":U THIS-PROCEDURE:FILE-NAME
      885           "must have at least one Enabled Table to perform Update.":U
      886             VIEW-AS ALERT-BOX ERROR.
      887      RETURN.
      888   END PROCEDURE.
      889   PROCEDURE check-modified :
      890   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      891   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      892   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      893   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      894     IF check-state = "check":U THEN
      895     DO:
      896       RUN get-link-handle IN adm-broker-hdl
      897         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      898            OUTPUT group-target-list).
      899       IF group-target-list NE "":U THEN
      900       DO i = 1 TO NUM-ENTRIES(group-target-list):
      901         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      902         RUN check-modified IN curr-widget ('group-check':U).
      903         IF RETURN-VALUE NE "":U THEN
      904         DO:
      905           RUN check-modified-message(RETURN-VALUE).
      906           RETURN "":U.
      907         END.
      908       END.
      909     END.
      910     RETURN "":U.
      911   END PROCEDURE.
      912   PROCEDURE check-modified-message :
      913     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      914        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      915           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      916        IF RETURN-VALUE = "YES":U THEN
      917           RUN notify ('view,CONTAINER-SOURCE':U).
      918        MESSAGE IF p-changed-table NE ? THEN
      919           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      920           ELSE "Current values have been changed."
      921           SKIP "  Do you wish to save those changes?"
      922           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      923        IF ANS THEN
      924        DO:
      925           IF group-assign-target THEN
      926             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      927           ELSE RUN dispatch('update-record':U).
      928           IF RETURN-VALUE = "ADM-ERROR":U THEN
      929           DO:
      930               MESSAGE "Changes to the previous record were not saved."
      931                 VIEW-AS ALERT-BOX ERROR.
      932               IF group-assign-target THEN
      933                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      934               ELSE RUN dispatch ('cancel-record':U).
      935           END.
      936        END.
      937        ELSE DO:
      938          IF group-assign-target THEN
      939             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      940          ELSE RUN dispatch('cancel-record':U).
      941        END.
      942        RETURN.
      943   END PROCEDURE.
      944   PROCEDURE get-rowid :
      945       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      946       ASSIGN
      947       p-table   =   adm-first-table.
      948       RETURN.
      949   END PROCEDURE.
      950   PROCEDURE init-group-assign :
      951       RUN request-attribute IN adm-broker-hdl
      952         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      953       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      954         group-assign-target = yes.
      955       ELSE group-assign-target = no.
      956       RETURN.
      957   END PROCEDURE.
      958   PROCEDURE set-editors :
      959       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      960       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      961       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      962       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      963       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      964       DO WHILE VALID-HANDLE (curr-widget):
      965           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      966              curr-widget:HIDDEN = no THEN DO:
      967             CASE p-field-setting:
      968               WHEN "INITIALIZE":U THEN
      969               DO:
      970                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      971                     read-only-list +
      972                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      973                        STRING(curr-widget).
      974               END.
      975               WHEN "DISABLE":U OR
      976               WHEN "ENABLE":U THEN
      977               DO:
      978                   curr-widget:SENSITIVE = yes.
      979                   RUN get-attribute ('Read-Only-Editors':U).
      980                   IF RETURN-VALUE = ? OR
      981                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      982                       curr-widget:READ-ONLY =
      983                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      984               END.
      985               WHEN "CLEAR":U THEN
      986                   curr-widget:SCREEN-VALUE = "":U.
      987             END CASE.
      988           END.
      989           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      990       END.
      991       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      992         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      993           + '"':U).
      994       RETURN.
      995   END PROCEDURE.
      996   PROCEDURE use-check-modified-all :
      997    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      998     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      999     RETURN.
     1000   END PROCEDURE.
     1001   PROCEDURE use-create-on-add :
     1002   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1003      RETURN.
     1004   END PROCEDURE.
     1005   PROCEDURE use-initial-lock :
     1006     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1007     ASSIGN adm-initial-lock = p-attr-value.
     1008     RETURN.
     1009   END PROCEDURE.
