     1142     return no-apply.
     1143   end.
     1144   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1145   on INS of frame F-Main anywhere do:
     1146     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame F-Main. END.
     1147     return no-apply.
     1148   end.
