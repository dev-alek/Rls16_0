     1176       ,output v-cntxt-is-admin
     1177       ) .
     1178   procedure disable_UI :
     1179     hide frame F-Main no-pause .
     1180     if this-procedure :persistent
     1181     then do:
     1182       delete procedure this-procedure .
     1183     end.
     1184   end procedure.
     1185   procedure local-initialize :
     1186     run dispatch in this-procedure
     1187       ( input 'initialize':U
     1188       ) .
     1189     assign
     1190       c-flt = 'r-ptrsph':U
     1191       jj    = 0
     1192       .
     1193     do jndex = 1 to 15
     1194       :
     1195       assign
     1196         use-column[ jndex ] = no
     1197       .
     1198     end.
     1199     find first buf_usr-flt no-lock where
     1200                buf_usr-flt.user-name  = v-cntxt-userid and
     1201                buf_usr-flt.call-point = c-flt no-error .
     1202     if available buf_usr-flt
     1203     then do:
     1204       find first buf_usr-flt exclusive-lock where
     1205                  buf_usr-flt.user-name  = v-cntxt-userid and
     1206                  buf_usr-flt.call-point = c-flt .
     1207       do jndex = 1 to length( buf_usr-flt.list_ )
     1208       :
     1209         if substring( buf_usr-flt.list_, jndex, 1 ) = '+':U
     1210         then do:
     1211           assign
     1212             use-column[ jndex ] = yes
     1213             jj                  = jj + 1
     1214           .
     1215         end.
     1216       end.
     1217       if length( buf_usr-flt.list_ ) < 15
     1218         then
     1219       do:
     1220         do jndex = length( buf_usr-flt.list_ ) + 1 to 15
     1221           :
     1222           assign
     1223             use-column[ jndex ] = yes
     1224             jj                  = jj + 1
     1225           .
     1226         end.
     1227       end.
     1228     end.
     1229     else
     1230     do:
     1231       do jndex = 1 to 15
     1232         :
     1233         if use-column[ jndex ] = yes
     1234         then do:
     1235           assign
     1236             jj = jj + 1
     1237           .
     1238         end.
     1239       end.
     1240       create buf_usr-flt .
     1241       assign
     1242         buf_usr-flt.user-name  = v-cntxt-userid
     1243         buf_usr-flt.call-point = c-flt
     1244         buf_usr-flt.list_      = '':U
     1245         .
     1246       do jndex = 1 to 15
     1247         :
     1248         assign
     1249           buf_usr-flt.list_ = buf_usr-flt.list_ + ( if use-column[ jndex ] = yes then '+':U else '-':U )
     1250         .
     1251       end.
     1252     end.
     1253     if jj = 0
     1254     then do:
     1255       apply "CHOOSE":U to b-mark in frame F-Main .
     1256     end.
     1257     display
     1258       use-column[  1 ]
     1259       use-column[  2 ]
     1260       use-column[  3 ]
     1261       use-column[  4 ]
     1262       use-column[  5 ]
     1263       use-column[  6 ]
     1264       use-column[  7 ]
     1265       use-column[  8 ]
     1266       use-column[  9 ]
     1267       use-column[ 10 ]
     1268       use-column[ 11 ]
     1269       use-column[ 12 ]
     1270       use-column[ 13 ]
     1271       use-column[ 14 ]
     1272       use-column[ 15 ]
     1273       with frame F-Main .
     1274   end procedure.
     1275   procedure my-report :
     1276     define variable jndex as integer no-undo .
     1277     do
     1278     on error undo, leave
     1279     on stop  undo, leave
     1280     :
     1281       apply "CHOOSE":U to b-save in frame F-Main .
     1282       if available buf_usr-flt
     1283       then do:
     1284         assign
     1285           r-flt = recid( buf_usr-flt )
     1286         .
     1287       end.
     1288       else do:
     1289         find first buf_usr-flt no-lock where
     1290                    buf_usr-flt.user-name  = v-cntxt-userid and
     1291                    buf_usr-flt.call-point = c-flt no-error .
     1292       end.
     1293       if available buf_usr-flt
     1294       then do:
     1295         assign
     1296           r-flt = recid( buf_usr-flt )
     1297         .
     1298       end.
     1299       else do:
     1300         create buf_usr-flt .
     1301         assign
     1302           buf_usr-flt.user-name  = v-cntxt-userid
     1303           buf_usr-flt.call-point = c-flt
     1304         .
     1305         assign
     1306           r-flt = recid( buf_usr-flt )
     1307         .
     1308       end.
     1309       find first buf_usr-flt exclusive-lock where
     1310           recid( buf_usr-flt ) = r-flt .
     1311       assign
     1312         buf_usr-flt.list_ = '':U
     1313         .
     1314       do jndex = 1 to 15
     1315         :
     1316         assign
     1317           buf_usr-flt.list_ = buf_usr-flt.list_ + ( if use-column[ jndex ] = yes then '+':U else '-':U )
     1318         .
     1319       end.
     1320       find first obj-list no-lock .
     1321       run rep/r-ptrsp2.p
     1322         ( input my-handle
     1323         , input obj-list.obj-type
     1324         , input obj-list.obj-code
     1325         ) no-error .
     1326       if error-status :error
     1327       then do:
     1328         message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1329                 'Ошибка выполнения отчета' skip( 0 )
     1330                 return-value skip( 0 )
     1331                 error-status :get-message( 1 ) skip( 1 )
     1332         view-as alert-box error .
     1333       end.
     1334     end.
     1335     if error-status :error
     1336     then do:
     1337       message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1338               'Ошибка выполнения отчета' skip( 0 )
     1339               return-value skip( 0 )
     1340               error-status :get-message( 1 ) skip( 1 )
     1341       view-as alert-box error .
     1342     end.
     1343   end procedure.
