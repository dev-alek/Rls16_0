     1005       assign
     1006         p-gds-obj-fact-qnty = buf_gds-obj.fact-qnty
     1007       .
     1008   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1009   if  buf_gds-obj.first-doc <> ?
     1010   and buf_gds-obj.first-doc > p-fact-date then do:
     1011     assign
     1012       buf_gds-obj.first-doc  = p-fact-date
     1013     .
     1014   end.
     1015   if  buf_gds-obj.last-doc <> ?
     1016   and buf_gds-obj.last-doc < p-fact-date then do:
     1017     assign
