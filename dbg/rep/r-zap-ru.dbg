      572   define temp-table temp-prt-obj no-undo   field prt-code         like ub.prt-obj.prt-code     field price-sale       like ub.prt-obj.price-sale   field fact-qnty        like ub.prt-obj.fact-qnty    field price-list-qnty  like ub.prt-obj.fact-qnty    field is-term          as logical   field prt-obj-recid    as recid     field price-list-recid as recid     index xpk is primary unique prt-code   index xie1 is-term .
      573   procedure prdoclib-process-goods :
      574     define input  parameter p-obj-type          as character no-undo .
      575     define input  parameter p-obj-code          as integer   no-undo .
      576     define input  parameter p-artic             as character no-undo .
