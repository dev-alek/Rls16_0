      636         undo, return error .
      637       end.
      638       find current buf_gds-obj  exclusive-lock .
      639       find current buf_prt-obj  exclusive-lock .
      640   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      642     (input  p-artic
      643     ,input  p-prod-type
      644     ,input  p-prod-code
      645     ,output v-gds-code
      646     )  .
      647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      648     (input  v-gds-code
      649     ,input  v-root-node
      650     ,output v-root-b-code
      651     )  .
      652   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      654     (input  p-obj-type
      655     ,input  p-obj-code
      656     ,input  v-root-b-code
      657     ,input  v-root-b-code
      658     ,input  0
      659     ,output v-doc-num
      660     ,output v-price-sale
      661     ,output v-road-tax
      662     ,output v-excise
      663     ) no-error .
      664       if error-status :error
      665       then do:
      666         message
      667           vss-workfile vss-revision vss-description skip
      668           vss-include-info7 skip
      669           "Ошибка при определении цены признака на объекте" skip
      670           "Объект"     p-obj-type p-obj-code  skip
      671           "Бар-код"    v-root-b-code skip
      672           error-status :get-message(1) skip
      673           return-value skip
      674           view-as alert-box error .
      675         undo, return error .
      676       end.
      677       run prdoclib-init-temp-prt-obj in this-procedure
      678         (input p-obj-type
      679         ,input p-obj-code
      680         ,input p-artic
      681         ,input p-prod-type
      682         ,input p-prod-code
      683         ,input v-price-sale
      684         ) .
      685       find first buf_price-list no-lock
      686         where buf_price-list.doc-num    = v-doc-num
      687           and buf_price-list.price-type = ""
      688           and buf_price-list.b-code     = v-root-b-code
      689         .
      690       find first buf_temp-prt-obj
      691         where buf_temp-prt-obj.prt-code = v-root-node
      692         .
      693       assign
      694         buf_temp-prt-obj.price-sale       = v-price-sale
      695         buf_temp-prt-obj.price-list-qnty  = buf_price-list.doc-qnty
      696         buf_temp-prt-obj.price-list-recid = recid(buf_price-list)
      697       .
      698       define variable l-empty-scale as logical no-undo .
      699   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      700     (input  v-root-node
      701     ,input  'empty-scale=request'
      702     ,output l-empty-scale
      703     ) no-error .
      704       if error-status :error
      705       then do:
      706         message
      707           vss-workfile vss-revision vss-description skip
      708           vss-include-info7 skip
      709           "Ошибка при определении атрибута шкалы" skip
      710           "Код признака" v-root-node skip
      711           "Запрашивался атрибут" "empty-scale=request" skip
      712           error-status :get-message(1) skip
      713           return-value skip
      714           view-as alert-box error .
      715         undo, return error .
      716       end.
      717       assign
      718         v-total-term-fact-qnty = 0
      719         v-total-fact-sale      = 0
      720       .
      721       if l-empty-scale = true
      722       then do:
      723         for each buf_price-list
      724           where buf_price-list.doc-num    = v-doc-num
      725             and buf_price-list.main-price = false
      726             and buf_price-list.artic      = p-artic
      727             and buf_price-list.prod-type  = p-prod-type
      728             and buf_price-list.prod-code  = p-prod-code
      729             and buf_price-list.price-type = ""
      730         on error undo, return error return-value
      731         :
      732           if buf_price-list.doc-qnty <> ? and p-check-price-parts
      733           then do:
      734             message
      735               vss-workfile vss-revision vss-description skip
      736               vss-include-info7 skip
      737               "Ошибка при закрытии переоценки" skip
      738               "Для неосновного бар-кода товара с пустой шкалой" skip
      739               "указано количество отличное от ?" skip
      740               "Переоценка" v-doc-num skip
      741               "Бар-код" buf_price-list.b-code skip
      742               "Артикул" p-artic p-prod-type p-prod-code skip
      743               "Количество" buf_price-list.doc-qnty skip
      744               view-as alert-box error .
      745             undo, return error .
      746           end.
      747         end.
      748       end.
      749       if l-empty-scale = false
      750       then do:
      751         define variable v-unit-base like ub.goods.unit-base no-undo .
      752   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      753   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
      754     (input  v-gds-code
      755     ,output v-unit-base
      756     ) no-error .
      757         if error-status :error
      758         then do:
      759           message
      760             vss-workfile vss-revision vss-description skip
      761             vss-include-info7 skip
      762             "Ошибка при определении базовой единицы измерения товара" skip
      763             "Код товара" v-gds-code skip
      764             error-status :get-message(1) skip
      765             return-value skip
      766             view-as alert-box error .
      767           undo, return error .
      768         end.
      769         for each buf_price-list
      770           where buf_price-list.doc-num    = v-doc-num
      771             and buf_price-list.main-price = false
      772             and buf_price-list.artic      = p-artic
      773             and buf_price-list.prod-type  = p-prod-type
      774             and buf_price-list.prod-code  = p-prod-code
      775             and buf_price-list.price-type = ""
      776         on error undo, return error
      777         :
      778           if buf_price-list.doc-qnty = ?
      779           then do:
      780             find first buf_bar-code no-lock
      781               where buf_bar-code.b-code = buf_price-list.b-code
      782               no-error .
      783             if  available buf_bar-code
      784             and buf_bar-code.unit-cli = v-unit-base
      785             then do:
      786               message
      787                 vss-workfile vss-revision vss-description skip
      788                 vss-include-info7 skip
      789                 "Ошибка при закрытии переоценки" skip
      790                 "Не задано количество для бар-кода с основной единицей измерения" skip
      791                 "Переоценка" v-doc-num skip
      792                 "Бар-код" buf_price-list.b-code skip
      793                 "Артикул" p-artic p-prod-type p-prod-code skip
      794                 "Количество" buf_price-list.doc-qnty skip
      795                 "Основная единица измерения" v-unit-base skip
      796                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
      797                 view-as alert-box error .
      798               undo, return error .
      799             end.
      800             next .
      801           end.
      802           find first buf_bar-code no-lock
      803             where buf_bar-code.b-code = buf_price-list.b-code
      804             no-error .
      805           if not available buf_bar-code
      806           then do:
      807             message
      808               vss-workfile vss-revision vss-description skip
      809               vss-include-info7 skip
      810               "В переоценке задан несуществующий бар-код" skip
      811               "Переоценка" v-doc-num skip
      812               "Артикул" p-artic p-prod-type p-prod-code skip
      813               "Бар-код" buf_price-list.b-code skip
      814               view-as alert-box error .
      815             undo, return error .
      816           end.
      817           if buf_bar-code.in-code <> ""
      818           or buf_bar-code.part-code <> ""
      819           then do:
      820             message
      821               vss-workfile vss-revision vss-description skip
      822               vss-include-info7 skip
      823               "В переоценке задан бар-код партии" skip
      824               "Данная версия системы не рассчитана на работу со специальными ценами по партиям" skip
      825               "Переоценка" v-doc-num skip
      826               "Бар-код" buf_price-list.b-code skip
      827               "Артикул" p-artic p-prod-type p-prod-code skip
      828               "Код ПН" buf_bar-code.in-code buf_bar-code.part-code skip
      829               view-as alert-box error .
      830             undo, return error .
      831           end.
      832           if buf_bar-code.node-code <> v-root-node
      833           then do:
      834   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
      836     (input  p-obj-type
      837     ,input  p-obj-code
      838     ,input  p-artic
      839     ,input  p-prod-type
      840     ,input  p-prod-code
      841     ,input  buf_bar-code.node-code
      842     ,buffer buf_prt-obj
      843     ) no-error .
      844             if error-status :error
      845             then do:
      846               message
      847                 vss-workfile vss-revision vss-description skip
      848                 vss-include-info7 skip
      849                 "Невозможно найти prt-obj" skip
      850                 error-status :get-message(1) skip
      851                 return-value skip
      852                 view-as alert-box error .
      853               undo, return error .
      854             end.
      855             run prdoclib-create-temp-prt-obj in this-procedure
      856               (input  v-price-sale
      857               ,buffer buf_prt-obj
      858               ,buffer buf_temp-prt-obj
      859               ).
      860             assign
      861               buf_temp-prt-obj.price-sale       = buf_price-list.price-sale
      862               buf_temp-prt-obj.price-list-qnty  = buf_price-list.doc-qnty
      863               buf_temp-prt-obj.price-list-recid = recid(buf_price-list)
      864             .
      865           end.
      866         end.
      867         for each buf_temp-prt-obj
      868           where buf_temp-prt-obj.is-term = true
      869         :
      870           if buf_temp-prt-obj.price-list-recid <> ?
      871           then do:
      872             assign
      873               v-total-term-fact-qnty = v-total-term-fact-qnty
      874                                     + buf_temp-prt-obj.fact-qnty
      875               v-total-fact-sale = v-total-fact-sale
      876                                 + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
      877             .
      878           end.
      879           if p-check-price-list = true
      880           then do:
      881             if buf_temp-prt-obj.price-list-recid = ?
      882             or buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.price-list-qnty
      883             then do:
      884             end.
      885             else do:
      886               message
      887                 vss-workfile vss-revision vss-description skip
      888                 vss-include-info7 skip
      889                 "Ошибка при закрытии переоценки" skip
      890                 "Несовпадают текущие количества по признаку" skip
      891                 "и количество признака в переоценке" skip
      892                 "Переоценка" v-doc-num skip
      893                 "Артикул" p-artic p-prod-type p-prod-code skip
      894                 "Код признака" buf_temp-prt-obj.prt-code skip
      895                 "Количество по признаку" buf_temp-prt-obj.fact-qnty skip
      896                 "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
      897                 "Корень шкалы товара" v-root-node skip
      898                 view-as alert-box error .
      899               undo, return error .
      900             end.
      901           end.
      902         end.
      903       end.
      904       find first buf_temp-prt-obj
      905         where buf_temp-prt-obj.prt-code = v-root-node
      906         .
      907       assign
      908         buf_temp-prt-obj.fact-qnty = buf_temp-prt-obj.fact-qnty
      909                                     - v-total-term-fact-qnty
      910       .
      911       if p-check-price-list = true
      912       then do:
      913         if buf_temp-prt-obj.fact-qnty <> buf_temp-prt-obj.price-list-qnty and p-check-price-parts
      914         then do:
      915           message
      916             vss-workfile vss-revision vss-description skip
      917             vss-include-info7 skip
      918             "Ошибка при закрытии переоценки" skip
      919             "Несовпадают текущие количества по корневому признаку" skip
      920             "и количество признака в переоценке" skip
      921             "Переоценка" v-doc-num skip
      922             "Артикул" p-artic p-prod-type p-prod-code skip
      923             "Код признака" buf_temp-prt-obj.prt-code skip
      924             "Количество по признаку" buf_temp-prt-obj.fact-qnty skip
      925             "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
      926             view-as alert-box error .
      927           undo, return error .
      928         end.
      929       end.
      930       assign
      931         v-total-fact-sale = v-total-fact-sale
      932                           + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
      933       .
      934       if v-total-fact-sale = ?
      935       then do:
      936         message
      937           vss-workfile vss-revision vss-description skip
      938           vss-include-info7 skip
      939           "Ошибка при вычислении суммы в продажных ценах" skip
      940           "Получено неопределенное значение" skip
      941           "Переоценка" v-doc-num skip
      942           "Артикул" p-artic p-prod-type p-prod-code skip
      943           "Код признака" buf_temp-prt-obj.prt-code skip
      944           "Сумма в продажных ценах" v-total-fact-sale skip
      945           view-as alert-box error .
      946         undo, return error .
      947       end.
      948       define variable v-old-fact-qnty     as decimal   no-undo .
      949       define variable v-old-fact-cli-qnty as decimal   no-undo .
      950       define variable v-old-fact-base     as decimal   no-undo .
      951       define variable v-old-fact-rubl     as decimal   no-undo .
      952       define variable v-old-fact-sale     as decimal   no-undo .
      953       assign
      954         v-old-fact-qnty     = buf_gds-obj.fact-qnty
      955         v-old-fact-cli-qnty = buf_gds-obj.fact-cli-qnty
      956         v-old-fact-base     = buf_gds-obj.fact-base
      957         v-old-fact-rubl     = buf_gds-obj.fact-rubl
      958         v-old-fact-sale     = buf_gds-obj.fact-sale
      959       .
      960       assign
      961         buf_gds-obj.price-sale = v-price-sale
      962         buf_gds-obj.fact-sale  = v-total-fact-sale
      963       .
      964       define variable v-corr-date as date      no-undo .
      965       define variable v-corr-time as integer   no-undo .
      966       run cur-time in this-procedure
      967         (output v-corr-date
      968         ,output v-corr-time
      969         ) .
      970   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      971   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gohist in g#library
      972     (input  buf_gds-obj.obj-type
      973     ,input  buf_gds-obj.obj-code
      974     ,input  buf_gds-obj.gds-code
      975     ,input  'close':U
      976     ,input  buf_gds-obj.fact-qnty
      977     ,input  buf_gds-obj.fact-cli-qnty
      978     ,input  buf_gds-obj.fact-base
      979     ,input  buf_gds-obj.fact-rubl
      980     ,input  buf_gds-obj.fact-sale
      981     ,input  v-old-fact-qnty
      982     ,input  v-old-fact-cli-qnty
      983     ,input  v-old-fact-base
      984     ,input  v-old-fact-rubl
      985     ,input  v-old-fact-sale
      986     ,input  'price-doc':U
      987     ,input  p-doc-num
