     1032   procedure prdoclib-clear-temp-prt-obj :
     1033     define buffer buf_temp-prt-obj for temp-prt-obj .
     1034     do
     1035     on error undo, return error return-value
     1036     :
     1037       for each buf_temp-prt-obj
     1038       on error undo, return error return-value
     1039       :
     1040         delete buf_temp-prt-obj .
     1041       end.
     1042     end.
     1043   end procedure.
     1044   procedure prdoclib-create-temp-prt-obj :
     1045     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1046     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1047     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1048     define buffer buf_gds-prt for ub.gds-prt .
     1049     do
     1050     on error undo, return error return-value
     1051     :
     1052       find first buf_temp-prt-obj
     1053         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1054         no-error .
     1055       if not available buf_temp-prt-obj
     1056       then do:
     1057         create buf_temp-prt-obj .
     1058         assign
     1059           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1060           buf_temp-prt-obj.price-sale       = ?
     1061           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1062           buf_temp-prt-obj.price-list-qnty  = ?
     1063           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1064           buf_temp-prt-obj.price-list-recid = ?
     1065         .
     1066         find first buf_gds-prt no-lock
     1067           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1068           .
     1069         assign
     1070           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1071         .
     1072         if buf_temp-prt-obj.is-term
     1073         then do:
     1074           assign
     1075             buf_temp-prt-obj.price-sale = p-root-price-sale
     1076           .
     1077         end.
     1078       end.
     1079     end.
     1080   end procedure.
     1081   procedure prdoclib-temp-prt-obj-by-prt-root :
     1082     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1083     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1084     define buffer buf_gds-prt for ub.gds-prt .
     1085     do
     1086     on error undo, return error return-value
     1087     :
     1088       find first buf_temp-prt-obj
     1089         where buf_temp-prt-obj.prt-code = p-prt-code
     1090         no-error .
     1091       if not available buf_temp-prt-obj
     1092       then do:
     1093         create buf_temp-prt-obj .
     1094         assign
     1095           buf_temp-prt-obj.prt-code         = p-prt-code
     1096           buf_temp-prt-obj.price-sale       = ?
     1097           buf_temp-prt-obj.fact-qnty        = 0
     1098           buf_temp-prt-obj.price-list-qnty  = ?
     1099           buf_temp-prt-obj.prt-obj-recid    = ?
     1100           buf_temp-prt-obj.price-list-recid = ?
     1101         .
     1102         find first buf_gds-prt no-lock
     1103           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1104           .
     1105         assign
     1106           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1107         .
     1108         if buf_temp-prt-obj.is-term
     1109         then do:
     1110           assign
     1111             buf_temp-prt-obj.price-sale = 0
     1112           .
     1113         end.
     1114       end.
     1115     end.
     1116   end procedure.
     1117   procedure prdoclib-init-temp-prt-obj :
     1118     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1119     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1120     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1121     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1122     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1123     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1124     define buffer buf_prt-obj      for ub.prt-obj .
     1125     define buffer buf_temp-prt-obj for temp-prt-obj .
     1126     do
     1127     on error undo, return error return-value
     1128     :
     1129       run prdoclib-clear-temp-prt-obj in this-procedure .
     1130       for each buf_prt-obj
     1131         where buf_prt-obj.obj-type  = p-obj-type
     1132           and buf_prt-obj.obj-code  = p-obj-code
     1133           and buf_prt-obj.artic     = p-artic
     1134           and buf_prt-obj.prod-type = p-prod-type
     1135           and buf_prt-obj.prod-code = p-prod-code
     1136       on error undo, return error return-value
     1137       :
     1138         run prdoclib-create-temp-prt-obj in this-procedure
     1139           (input  p-root-price-sale
     1140           ,buffer buf_prt-obj
     1141           ,buffer buf_temp-prt-obj
     1142           ).
     1143       end.
     1144     end.
     1145   end procedure.
     1146   procedure prdoclib-calc-fact-sale :
     1147     define input  parameter p-price-list-recid   as recid     no-undo .
     1148     define output parameter p-fact-qnty          as decimal   no-undo .
     1149     define output parameter p-cur-base           as decimal   no-undo .
     1150     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1151     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1152     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1153     define output parameter p-cur-excise-base    as decimal   no-undo .
     1154     define buffer buf_main_price-list for ub.price-list .
     1155     define buffer buf_price-list      for ub.price-list .
     1156     define buffer buf_goods           for ub.goods .
     1157     define buffer buf_gds-obj         for ub.gds-obj .
     1158     define buffer buf_bar-code        for ub.bar-code .
     1159     define variable l-empty-scale   as logical   no-undo .
     1160     do
     1161     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     1162     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     1163     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     1164     :
     1165       find first buf_main_price-list no-lock
     1166         where recid(buf_main_price-list) = p-price-list-recid
     1167         no-error .
     1168       if not available buf_main_price-list
     1169       then do:
     1170         message
     1171           vss-workfile vss-revision vss-description skip
     1172           vss-include-info7 skip
     1173           "Ошибка задания входных параметров" skip
     1174           "Не найдена строка переоценки" skip
     1175           "Код записи (recid)" p-price-list-recid skip
     1176           view-as alert-box error .
     1177         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1178       end.
     1179       if buf_main_price-list.main-price <> true
     1180       then do:
     1181         message
     1182           vss-workfile vss-revision vss-description skip
     1183           vss-include-info7 skip
     1184           "Ошибка задания входных параметров" skip
     1185           "Строка переоценки не является основной" skip
     1186           "Код записи (recid)" p-price-list-recid skip
     1187           "Переоценка" buf_main_price-list.doc-num skip
     1188           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1189           "Бар-код" buf_main_price-list.b-code skip
     1190           view-as alert-box error .
     1191         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     1192       end.
     1193       find first buf_goods no-lock
     1194         where buf_goods.artic     = buf_main_price-list.artic
     1195           and buf_goods.prod-type = buf_main_price-list.prod-type
     1196           and buf_goods.prod-code = buf_main_price-list.prod-code
     1197         no-error .
     1198       if not available buf_goods
     1199       then do:
     1200         message
     1201           vss-workfile vss-revision vss-description skip
     1202           vss-include-info7 skip
     1203           "Не найден товар" skip
     1204           "Переоценка" buf_main_price-list.doc-num skip
     1205           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1206           view-as alert-box error .
     1207         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1208       end.
     1209   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1211     (input  buf_main_price-list.artic
     1212     ,input  buf_main_price-list.prod-type
     1213     ,input  buf_main_price-list.prod-code
     1214     ,input  'empty-scale=request':u
     1215     ,output l-empty-scale
     1216     ) no-error .
     1217       if error-status :error
     1218       then do:
     1219         message
     1220           vss-workfile vss-revision vss-description skip
     1221           vss-include-info7 skip
     1222           "Ошибка при определении атрибута товара" skip
     1223           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1224           'empty-scale=request':u skip
     1225           error-status :get-message(1) skip
     1226           return-value skip
     1227           view-as alert-box error .
     1228         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1229       end.
     1230       find first buf_gds-obj no-lock
     1231         where buf_gds-obj.gds-code = buf_goods.gds-code
     1232           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     1233           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     1234         no-error .
     1235         if not available buf_gds-obj then do:
     1236   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1238     (input  buf_main_price-list.obj-type
     1239     ,input  buf_main_price-list.obj-code
     1240     ,input  buf_goods.artic
     1241     ,input  buf_goods.prod-type
     1242     ,input  buf_goods.prod-code
     1243     ,buffer buf_gds-obj
     1244     ) no-error .
     1245           if error-status :error then do:
     1246              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1247           end.
     1248         end.
     1249       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1250       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1251       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1252       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1253       define variable vat-base-sale-prl               as decimal   no-undo .
     1254       define variable vat-rubl-sale-prl               as decimal   no-undo .
     1255       define variable vat-base-buyer-prl              as decimal   no-undo .
     1256       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1257       define variable slt-base-sale-prl               as decimal   no-undo .
     1258       define variable slt-rubl-sale-prl               as decimal   no-undo .
     1259       define variable road-tax-base-sale-prl          as decimal   no-undo .
     1260       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1261       define variable excise-base-sale-prl            as decimal   no-undo .
     1262       define variable excise-rubl-sale-prl            as decimal   no-undo .
     1263       define variable discnt-base-sale-prl            as decimal   no-undo .
     1264       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1265       if buf_main_price-list.doc-qnty <> 0
     1266       then do:
     1267         run prl-vat in this-procedure
     1268           (input  recid(buf_main_price-list)
     1269           ,output price-rubl-with-tax-sale-prl
     1270           ,output price-base-with-tax-sale-prl
     1271           ,output price-rubl-without-tax-sale-prl
     1272           ,output price-base-without-tax-sale-prl
     1273           ,output vat-base-sale-prl
     1274           ,output vat-rubl-sale-prl
     1275           ,output vat-base-buyer-prl
     1276           ,output vat-rubl-buyer-prl
     1277           ,output slt-base-sale-prl
     1278           ,output slt-rubl-sale-prl
     1279           ,output road-tax-base-sale-prl
     1280           ,output road-tax-rubl-sale-prl
     1281           ,output excise-base-sale-prl
     1282           ,output excise-rubl-sale-prl
     1283           ,output discnt-base-sale-prl
     1284           ,output discnt-rubl-sale-prl
     1285           ) no-error .
     1286         if error-status :error
     1287         then do:
     1288           message
     1289             vss-workfile vss-revision vss-description skip
     1290             vss-include-info7 skip
     1291             "Ошибка при вызове процеды prl-vat" skip
     1292             "Документ" buf_main_price-list.doc-num skip
     1293             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1294             error-status :get-message(1) skip
     1295             return-value skip
     1296             view-as alert-box error .
     1297           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1298         end.
     1299       end.
     1300       else do:
     1301         assign
     1302           price-rubl-with-tax-sale-prl    = 0
     1303           price-base-with-tax-sale-prl    = 0
     1304           price-rubl-without-tax-sale-prl = 0
     1305           price-base-without-tax-sale-prl = 0
     1306           vat-base-sale-prl               = 0
     1307           vat-rubl-sale-prl               = 0
     1308           vat-base-buyer-prl              = 0
     1309           vat-rubl-buyer-prl              = 0
     1310           slt-base-sale-prl               = 0
     1311           slt-rubl-sale-prl               = 0
     1312           road-tax-base-sale-prl          = 0
     1313           road-tax-rubl-sale-prl          = 0
     1314           excise-base-sale-prl            = 0
     1315           excise-rubl-sale-prl            = 0
     1316           discnt-base-sale-prl            = 0
     1317           discnt-rubl-sale-prl            = 0
     1318         .
     1319       end.
     1320       define variable v-curr-r-b as character no-undo .
     1321   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1322   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1323     (output v-curr-r-b
     1324     )  .
     1325       if v-curr-r-b = 'base':U
     1326       then do:
     1327         assign
     1328           p-fact-qnty         = buf_main_price-list.doc-qnty
     1329           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1330           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     1331           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     1332           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     1333           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     1334         .
     1335       end.
     1336       else do:
     1337         assign
     1338           p-fact-qnty         = buf_main_price-list.doc-qnty
     1339           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1340           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     1341           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     1342           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     1343           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     1344         .
     1345       end.
     1346         define variable v-unit-base like ub.goods.unit-base no-undo .
     1347   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1348   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1349     (input  buf_goods.gds-code
     1350     ,output v-unit-base
     1351     ) no-error .
     1352         if error-status :error
     1353         then do:
     1354           message
     1355             vss-workfile vss-revision vss-description skip
     1356             vss-include-info7 skip
     1357             "Ошибка при определении базовой единицы измерения товара" skip
     1358             "Код товара" buf_goods.gds-code skip
     1359             error-status :get-message(1) skip
     1360             return-value skip
     1361             view-as alert-box error .
     1362           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1363         end.
     1364         for each buf_price-list no-lock
     1365           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1366             and buf_price-list.main-price = false
     1367             and buf_price-list.artic      = buf_main_price-list.artic
     1368             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     1369             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     1370         :
     1371           if buf_price-list.doc-qnty = ?
     1372           then do:
     1373             find first buf_bar-code no-lock
     1374               where buf_bar-code.b-code = buf_price-list.b-code
     1375               no-error .
     1376             if available buf_bar-code
     1377             and buf_bar-code.unit-cli = v-unit-base
     1378             then do:
     1379               message
     1380                 vss-workfile vss-revision vss-description skip
     1381                 vss-include-info7 skip
     1382                 "Ошибка при закрытии переоценки" skip
     1383                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1384                 "Переоценка" buf_main_price-list.doc-num skip
     1385                 "Бар-код" buf_price-list.b-code skip
     1386                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1387                 "Количество" buf_price-list.doc-qnty skip
     1388                 "Основная единица измерения" v-unit-base skip
     1389                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1390                 view-as alert-box error .
     1391               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1392             end.
     1393             next .
     1394           end.
     1395           if not can-find
     1396             (first buf_bar-code
     1397             where buf_bar-code.b-code = buf_price-list.b-code
     1398             )
     1399           then do:
     1400             message
     1401               vss-workfile vss-revision vss-description skip
     1402               vss-include-info7 skip
     1403               "В переоценке задан несуществующий бар-код" skip
     1404               "Переоценка" buf_price-list.doc-num skip
     1405               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1406               "Бар-код" buf_price-list.b-code skip
     1407               view-as alert-box error .
     1408             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1409           end.
     1410           if buf_price-list.doc-qnty <> 0
     1411           then do:
     1412             run prl-vat in this-procedure
     1413               (input  recid(buf_price-list)
     1414               ,output price-rubl-with-tax-sale-prl
     1415               ,output price-base-with-tax-sale-prl
     1416               ,output price-rubl-without-tax-sale-prl
     1417               ,output price-base-without-tax-sale-prl
     1418               ,output vat-base-sale-prl
     1419               ,output vat-rubl-sale-prl
     1420               ,output vat-base-buyer-prl
     1421               ,output vat-rubl-buyer-prl
     1422               ,output slt-base-sale-prl
     1423               ,output slt-rubl-sale-prl
     1424               ,output road-tax-base-sale-prl
     1425               ,output road-tax-rubl-sale-prl
     1426               ,output excise-base-sale-prl
     1427               ,output excise-rubl-sale-prl
     1428               ,output discnt-base-sale-prl
     1429               ,output discnt-rubl-sale-prl
     1430               ) no-error .
     1431             if error-status :error
     1432             then do:
     1433               message
     1434                 vss-workfile vss-revision vss-description skip
     1435                 vss-include-info7 skip
     1436                 "Ошибка при вызове процеды prl-vat" skip
     1437                 "Документ" buf_price-list.doc-num skip
     1438                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1439                 error-status :get-message(1) skip
     1440                 return-value skip
     1441                 view-as alert-box error .
     1442               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1443             end.
     1444           end.
     1445           else do:
     1446             assign
     1447               price-rubl-with-tax-sale-prl    = 0
     1448               price-base-with-tax-sale-prl    = 0
     1449               price-rubl-without-tax-sale-prl = 0
     1450               price-base-without-tax-sale-prl = 0
     1451               vat-base-sale-prl               = 0
     1452               vat-rubl-sale-prl               = 0
     1453               vat-base-buyer-prl              = 0
     1454               vat-rubl-buyer-prl              = 0
     1455               slt-base-sale-prl               = 0
     1456               slt-rubl-sale-prl               = 0
     1457               road-tax-base-sale-prl          = 0
     1458               road-tax-rubl-sale-prl          = 0
     1459               excise-base-sale-prl            = 0
     1460               excise-rubl-sale-prl            = 0
     1461               discnt-base-sale-prl            = 0
     1462               discnt-rubl-sale-prl            = 0
     1463             .
     1464           end.
     1465           if v-curr-r-b = 'base':U
     1466           then do:
     1467             assign
     1468               p-fact-qnty         = p-fact-qnty
     1469                                   + buf_price-list.doc-qnty
     1470               p-cur-base          = p-cur-base
     1471                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1472               p-cur-VAT-base      = p-cur-VAT-base
     1473                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1474               p-cur-SLT-base      = p-cur-SLT-base
     1475                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1476               p-cur-road-tax-base = p-cur-road-tax-base
     1477                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1478               p-cur-excise-base   = p-cur-excise-base
     1479                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1480             .
     1481           end.
     1482           else do:
     1483             assign
     1484               p-fact-qnty         = p-fact-qnty
     1485                                   + buf_price-list.doc-qnty
     1486               p-cur-base          = p-cur-base
     1487                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1488               p-cur-VAT-base      = p-cur-VAT-base
     1489                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1490               p-cur-SLT-base      = p-cur-SLT-base
     1491                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1492               p-cur-road-tax-base = p-cur-road-tax-base
     1493                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1494               p-cur-excise-base   = p-cur-excise-base
     1495                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1496             .
     1497           end.
     1498         end.
     1499     end.
     1500   end procedure.
     1501   procedure prdoclib-calc-prc :
     1502     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1503     define input  parameter p-cons-pay        as   integer                no-undo.
     1504     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1505     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1506     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1507     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1508     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1509     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513       define buffer buf_price-doc       for ub.price-doc .
     1514       define buffer buf_price-list      for ub.price-list .
     1515       define buffer buf_parts           for ub.parts .
     1516       define variable v-ov-qnty     as decimal   no-undo .
     1517       define variable v-ov-base     as decimal   no-undo .
     1518       define variable v-ov-VAT-base as decimal   no-undo .
     1519       define variable v-ov-SLT-base as decimal   no-undo .
     1520       define variable v-cons-qnty   as decimal   no-undo .
     1521       define variable v-prch-qnty   as decimal   no-undo .
     1522       define variable v-cons-mult   as decimal   no-undo .
     1523       define variable v-prch-mult   as decimal   no-undo .
     1524       find first buf_price-doc no-lock
     1525         where recid(buf_price-doc) = p-price-doc-recid
     1526         no-error .
     1527       if not available buf_price-doc
     1528       then do:
     1529         message
     1530           vss-workfile vss-revision vss-description skip
     1531           vss-include-info7 skip
     1532           "Ошибка задания входных параметров" skip
     1533           "Не найден документ переоценки" skip
     1534           "Код записи (recid)" p-price-doc-recid skip
     1535           view-as alert-box error .
     1536         undo, return error .
     1537       end.
     1538       for each buf_price-list no-lock
     1539         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1540           and buf_price-list.main-price = true
     1541       on error undo, return error return-value
     1542       :
     1543         run prdoclib-calc-ov
     1544           (input recid(buf_price-list)
     1545           ,output v-ov-qnty
     1546           ,output v-ov-base
     1547           ,output v-ov-VAT-base
     1548           ,output v-ov-SLT-base
     1549           ) no-error .
     1550         if error-status :error
     1551         then do:
     1552           if error-status :get-message(1) <> ""
     1553           then do:
     1554             message
     1555               vss-workfile vss-revision vss-description skip
     1556               vss-include-info7 skip
     1557               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1558               error-status :get-message(1) skip
     1559               return-value skip
     1560               view-as alert-box error .
     1561           end.
     1562           undo, return error return-value .
     1563         end.
     1564         assign
     1565           v-cons-qnty = 0
     1566           v-prch-qnty = 0
     1567         .
     1568         for each buf_parts no-lock
     1569           where buf_parts.out-code  = buf_price-list.doc-num
     1570             and buf_parts.obj-type  = buf_price-list.obj-type
     1571             and buf_parts.obj-code  = buf_price-list.obj-code
     1572             and buf_parts.artic     = buf_price-list.artic
     1573             and buf_parts.prod-type = buf_price-list.prod-type
     1574             and buf_parts.prod-code = buf_price-list.prod-code
     1575         on error undo, return error return-value
     1576         :
     1577           if buf_parts.pay-code = p-cons-pay
     1578           then do:
     1579             assign
     1580               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1581             .
     1582           end.
     1583           else do:
     1584             assign
     1585               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1586             .
     1587           end.
     1588         end.
     1589         if (v-cons-qnty + v-prch-qnty) = 0
     1590         then do:
     1591           assign
     1592             v-cons-mult = 0
     1593             v-prch-mult = 1
     1594           .
     1595         end.
     1596         else do:
     1597           assign
     1598             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1599             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1600           .
     1601         end.
     1602         assign
     1603           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1604           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1605           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1606           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1607           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1608           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1609         .
     1610       end.
     1611     end.
     1612   end procedure.
     1613   procedure prdoclib-calc-ov :
     1614     define input  parameter p-price-list-recid as recid     no-undo .
     1615     define output parameter p-fact-qnty        as decimal   no-undo .
     1616     define output parameter p-ov-base          as decimal   no-undo .
     1617     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1618     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1619     do
     1620     on error undo, return error return-value
     1621     :
     1622       define buffer buf_main_price-list    for ub.price-list .
     1623       define buffer buf_prev_price-list    for ub.price-list .
     1624       define buffer buf_special_price-list for ub.price-list .
     1625       define buffer buf_goods              for ub.goods .
     1626       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1627       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1628       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1629       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1630       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1631       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1632       define variable v-prev-price-list-recid as   recid                  no-undo.
     1633       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1634       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1635       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1636       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1637       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1638       find first buf_main_price-list no-lock
     1639         where recid(buf_main_price-list) = p-price-list-recid
     1640         no-error .
     1641       if not available buf_main_price-list
     1642       then do:
     1643         message
     1644           vss-workfile vss-revision vss-description skip
     1645           vss-include-info7 skip
     1646           "Ошибка задания входных параметров" skip
     1647           "Не найдена строка переоценки" skip
     1648           "Код записи (recid)" p-price-list-recid skip
     1649           view-as alert-box error .
     1650         undo, return error .
     1651       end.
     1652       if buf_main_price-list.main-price <> true
     1653       then do:
     1654         message
     1655           vss-workfile vss-revision vss-description skip
     1656           vss-include-info7 skip
     1657           "Ошибка задания входных параметров" skip
     1658           "Строка переоценки не является основной" skip
     1659           "Код записи (recid)" p-price-list-recid skip
     1660           "Переоценка" buf_main_price-list.doc-num skip
     1661           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1662           "Бар-код" buf_main_price-list.b-code skip
     1663           view-as alert-box error .
     1664         undo, return error .
     1665       end.
     1666       run prdoclib-calc-fact-sale in this-procedure
     1667         (input  recid(buf_main_price-list)
     1668         ,output v-fact-qnty
     1669         ,output v-cur-base
     1670         ,output v-cur-VAT-base
     1671         ,output v-cur-SLT-base
     1672         ,output v-cur-road-tax-base
     1673         ,output v-cur-excise-base
     1674         ) no-error.
     1675       if error-status :error
     1676       then do:
     1677         message
     1678           vss-workfile vss-revision vss-description skip
     1679           vss-include-info7 skip
     1680           "Ошибка при расчете сумм переоценки." skip
     1681           "Документ переоценки" buf_main_price-list.doc-num skip
     1682           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1683           error-status :get-message(1) skip
     1684           return-value skip
     1685           view-as alert-box error .
     1686         undo, return error .
     1687       end.
     1688   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1690     (input  buf_main_price-list.obj-type
     1691     ,input  buf_main_price-list.obj-code
     1692     ,input  buf_main_price-list.b-code
     1693     ,input  buf_main_price-list.b-code
     1694     ,input  buf_main_price-list.fact-order
     1695     ,output v-prev-price-list-recid
     1696     ,output v-prev-cli-base-rate
     1697     ) no-error .
     1698       if error-status :error
     1699       then do:
     1700         message
     1701           vss-workfile vss-revision vss-description skip
     1702           vss-include-info7 skip
     1703           "Ошибка при поиске предыдущей переоценки." skip
     1704           "Документ переоценки " buf_main_price-list.doc-num skip
     1705           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1706           error-status :get-message(1) skip
     1707           return-value skip
     1708           view-as alert-box error .
     1709         undo, return error .
     1710       end.
     1711       if v-prev-price-list-recid <> ?
     1712       then do:
     1713         find first buf_prev_price-list no-lock
     1714           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1715           .
     1716         find first buf_special_price-list no-lock
     1717           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1718             and buf_special_price-list.main-price = false
     1719             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1720             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1721             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1722             and buf_special_price-list.doc-qnty   <> ?
     1723           no-error .
     1724         if available buf_special_price-list
     1725         then do:
     1726           message
     1727             "Товар имеет специальные цены на признаки" skip
     1728             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1729             "Переоценка" buf_prev_price-list.doc-num skip
     1730             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1731             view-as alert-box error .
     1732           undo, return error .
     1733         end.
     1734         find first buf_goods no-lock
     1735           where buf_goods.artic     = buf_main_price-list.artic
     1736             and buf_goods.prod-type = buf_main_price-list.prod-type
     1737             and buf_goods.prod-code = buf_main_price-list.prod-code
     1738           no-error .
     1739         if not available buf_goods
     1740         then do:
     1741           message
     1742             vss-workfile vss-revision vss-description skip
     1743             vss-include-info7 skip
     1744             "Не найден товар" skip
     1745             "Переоценка" buf_main_price-list.doc-num skip
     1746             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1747             view-as alert-box error .
     1748           undo, return error .
     1749         end.
     1750         if buf_prev_price-list.vat-pc = ?
     1751         or buf_prev_price-list.slt-pc = ?
     1752         then do:
     1753           message
     1754             "В переоценке не заданы налоги товара" skip
     1755             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1756             "Переоценка" buf_prev_price-list.doc-num skip
     1757             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1758             "НДС" buf_prev_price-list.vat-pc skip
     1759             "НП" buf_prev_price-list.slt-pc skip
     1760             view-as alert-box error .
     1761           undo, return error return-value .
     1762         end.
     1763         define variable v-prev-cur-SLT-pc as decimal no-undo .
     1764         assign
     1765           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     1766         .
     1767         assign
     1768           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     1769           v-prev-cur-VAT-base = v-fact-qnty
     1770                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     1771                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     1772           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     1773         .
     1774         assign
     1775           p-fact-qnty   = v-fact-qnty
     1776           p-ov-base     = v-cur-base     - v-prev-cur-base
     1777           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1778           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1779         .
     1780       end.
     1781       else do:
     1782         assign
     1783           v-prev-cur-base     = 0
     1784           v-prev-cur-VAT-base = 0
     1785           v-prev-cur-SLT-base = 0
     1786           .
     1787         assign
     1788           p-fact-qnty   = v-fact-qnty
     1789           p-ov-base     = v-cur-base     - v-prev-cur-base
     1790           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1791           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1792         .
     1793       end.
     1794     end.
     1795   end procedure.
     1796   procedure prdoclib-init-prt-obj-by-factord :
     1797     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1798     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1799     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1800     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1801     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1802     define input parameter p-fact-order         as decimal   no-undo .
     1803     define input parameter p-include-fact-order as logical   no-undo .
     1804     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     1805     define buffer buf_gds-obj      for ub.gds-obj .
     1806     define buffer buf_doc-line     for ub.doc-line .
     1807     define buffer buf_temp-prt-obj for temp-prt-obj .
     1808     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     1809     do
     1810     on error undo, return error return-value
     1811     :
     1812       do transaction
     1813       on error undo, return error return-value
     1814       :
     1815   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1816   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1817     (input  p-obj-type
     1818     ,input  p-obj-code
     1819     ,input  p-artic
     1820     ,input  p-prod-type
     1821     ,input  p-prod-code
     1822     ,buffer buf_gds-obj
     1823     ) no-error .
     1824         if error-status :error
     1825         then do:
     1826           message
     1827             vss-workfile vss-revision vss-description skip
     1828             vss-include-info7 skip
     1829             "Невозможно найти gds-obj" skip
     1830             error-status :get-message(1) skip
     1831             return-value skip
     1832             view-as alert-box error .
     1833           undo, return error .
     1834         end.
     1835         find current buf_gds-obj exclusive-lock .
     1836       end.
     1837       run prdoclib-init-temp-prt-obj in this-procedure
     1838         (input p-obj-type
     1839         ,input p-obj-code
     1840         ,input p-artic
     1841         ,input p-prod-type
     1842         ,input p-prod-code
     1843         ,input 0
     1844         ) .
     1845       for each buf_temp-prt-obj
     1846         where buf_temp-prt-obj.is-term <> true
     1847       on error undo, return error return-value
     1848       :
     1849         delete buf_temp-prt-obj .
     1850       end.
     1851       if p-include-fact-order = true
     1852       then do:
     1853         assign
     1854          p-fact-order = p-fact-order - 0.0000000001
     1855         .
     1856       end.
     1857       for each buf_doc-line no-lock
     1858         where buf_doc-line.obj-type   = p-obj-type
     1859           and buf_doc-line.obj-code   = p-obj-code
     1860           and buf_doc-line.artic      = p-artic
     1861           and buf_doc-line.prod-type  = p-prod-type
     1862           and buf_doc-line.prod-code  = p-prod-code
     1863           and buf_doc-line.status_    = 'факт':U
     1864           and buf_doc-line.fact-order >= p-fact-order
     1865       on error undo, return error return-value
     1866       :
     1867         run prdoclib-process-document in this-procedure
     1868           (input  buf_doc-line.doc-code
     1869           ,input  p-obj-type
     1870           ,input  p-obj-code
     1871           ,input  p-artic
     1872           ,input  p-prod-type
     1873           ,input  p-prod-code
     1874           ,output v-total-gds-dtl-qnty
     1875           ) .
     1876       end.
     1877     end.
     1878   end procedure.
     1879   procedure prdoclib-process-document :
     1880     define input  parameter p-doc-code           as character no-undo .
     1881     define input  parameter p-obj-type           as character no-undo .
     1882     define input  parameter p-obj-code           as integer   no-undo .
     1883     define input  parameter p-artic              as character no-undo .
     1884     define input  parameter p-prod-type          as character no-undo .
     1885     define input  parameter p-prod-code          as integer   no-undo .
     1886     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     1887     define buffer buf_trn-doc      for ub.trn-doc .
     1888     define buffer buf_gds-dtl      for ub.gds-dtl .
     1889     define buffer buf_temp-prt-obj for temp-prt-obj .
     1890     do
     1891     on error undo, return error return-value
     1892     :
     1893       find first buf_trn-doc no-lock
     1894         where buf_trn-doc.doc-code = p-doc-code
     1895         no-error .
     1896       if not available buf_trn-doc then do:
     1897         message
     1898           vss-workfile vss-revision vss-description skip
     1899           vss-include-info7 skip
     1900           "Ошибка при поиске документа" skip
     1901           "Документ" p-doc-code skip
     1902           "Объект" p-obj-type p-obj-code skip
     1903           "Артикул" p-artic p-prod-type p-prod-code skip
     1904           view-as alert-box error .
     1905         undo, return error .
     1906       end.
     1907       assign
     1908         p-total-gds-dtl-qnty = 0
     1909       .
     1910       for each buf_gds-dtl no-lock
     1911         where buf_gds-dtl.doc-code  = p-doc-code
     1912           and buf_gds-dtl.artic     = p-artic
     1913           and buf_gds-dtl.prod-type = p-prod-type
     1914           and buf_gds-dtl.prod-code = p-prod-code
     1915       on error undo, return error
     1916       :
     1917         define variable v-term-node as integer   no-undo .
     1918   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     1919     (input  buf_gds-dtl.prt-code
     1920     ,output v-term-node
     1921     )  .
     1922         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     1923           (input  v-term-node
     1924           ,buffer buf_temp-prt-obj
     1925           ) .
     1926         if buf_temp-prt-obj.is-term <> true then do:
     1927           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     1928                                        ,buf_gds-dtl.prt-code
     1929                                        ) .
     1930         end.
     1931         case buf_trn-doc.doc-type :
     1932           when 'при':U or
     1933           when 'возврат':U
     1934           then do:
     1935             assign
     1936               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1937                                           - buf_gds-dtl.fact-qnty
     1938               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1939                                           - buf_gds-dtl.fact-qnty
     1940             .
     1941           end.
     1942           when 'рас':U or
     1943           when 'спи':U
     1944           then do:
     1945             assign
     1946               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1947                                           + buf_gds-dtl.fact-qnty
     1948               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1949                                           + buf_gds-dtl.fact-qnty
     1950             .
     1951           end.
     1952           when 'инв':U
     1953           then do:
     1954             assign
     1955               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1956                                           - buf_gds-dtl.doc-qnty
     1957               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1958                                           - buf_gds-dtl.doc-qnty
     1959             .
     1960           end.
     1961           otherwise do:
     1962             undo, return error substitute("Неизвестный тип документа &1"
     1963                                          ,buf_trn-doc.doc-type
     1964                                          ) .
     1965           end.
     1966         end.
     1967       end.
     1968     end.
     1969   end procedure.
     1970   procedure prdoclib-prc-pl-document :
     1971     define input  parameter p-doc-code              as character no-undo .
     1972     define input  parameter p-obj-type              as character no-undo .
     1973     define input  parameter p-obj-code              as integer   no-undo .
     1974     define input  parameter p-gds-code              as integer   no-undo .
     1975     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     1976     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     1977     do
     1978     on error undo, return error return-value
     1979     :
     1980       define buffer buf_trn-doc      for ub.trn-doc .
     1981       define buffer buf_doc-pl       for ub.doc-pl .
     1982       define buffer buf_temp-pl-gds for temp-pl-gds .
     1983       define variable v-sign as decimal   no-undo .
     1984       find first buf_trn-doc no-lock
     1985         where buf_trn-doc.doc-code = p-doc-code
     1986         no-error .
     1987       if not available buf_trn-doc then do:
     1988         message
     1989           vss-workfile vss-revision vss-description skip
     1990           vss-include-info7 skip
     1991           "Ошибка при поиске документа" skip
     1992           "Документ" p-doc-code skip
     1993           "Объект" p-obj-type p-obj-code skip
     1994           "Товар" p-gds-code skip
     1995           view-as alert-box error .
     1996         undo, return error .
     1997       end.
     1998       assign
     1999         p-total-pl-gds-qnty     = 0
     2000         p-total-pl-gds-cli-qnty = 0
     2001       .
     2002       for each buf_doc-pl no-lock
     2003         where buf_doc-pl.out-code  = p-doc-code
     2004           and buf_doc-pl.gds-code  = p-gds-code
     2005       on error undo, return error return-value
     2006       :
     2007         find first buf_temp-pl-gds
     2008           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2009             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2010             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2011           .
     2012         case buf_trn-doc.doc-type :
     2013           when 'при':U
     2014           or when 'возврат':U
     2015           or when 'инв':U
     2016           then do:
     2017             assign
     2018               v-sign = -1.0
     2019             .
     2020           end.
     2021           when 'рас':U or
     2022           when 'спи':U
     2023           then do:
     2024             assign
     2025               v-sign = 1.0
     2026             .
     2027           end.
     2028           otherwise do:
     2029             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2030           end.
     2031         end case.
     2032         assign
     2033           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2034           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2035           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2036           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2037         .
     2038       end.
     2039     end.
     2040   end procedure.
     2041   procedure prdoclib-init-prt-obj-by-date :
     2042     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2043     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2044     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2045     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2046     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2047     define input parameter p-fact-date  as date      no-undo .
     2048     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2049     do
     2050     on error undo, return error return-value
     2051     :
     2052       define variable v-fact-order                as decimal   no-undo .
     2053       define variable v-shift-end-fact-order      as decimal   no-undo .
     2054       define variable v-day-end-fact-order        as decimal   no-undo .
     2055       run factord in this-procedure
     2056         (input  p-fact-date
     2057         ,input  1
     2058         ,input  1
     2059         ,input  ?
     2060         ,input  0
     2061         ,input  false
     2062         ,output v-fact-order
     2063         ,output v-shift-end-fact-order
     2064         ,output v-day-end-fact-order
     2065         ) no-error .
     2066       if error-status :error
     2067       then do:
     2068         message
     2069           vss-workfile vss-revision vss-description skip
     2070           vss-include-info7 skip
     2071           "Ошибка при определении момента времени, на который требуется остаток" skip
     2072           "Объект" p-obj-type p-obj-code skip
     2073           "Артикул" p-artic p-prod-type p-prod-code skip
     2074           "Дата" p-fact-date skip
     2075           view-as alert-box error .
     2076         undo, return error .
     2077       end.
     2078       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2079         (input p-obj-type
     2080         ,input p-obj-code
     2081         ,input p-artic
     2082         ,input p-prod-type
     2083         ,input p-prod-code
     2084         ,input v-day-end-fact-order
     2085         ,input false
     2086         ) no-error .
     2087       if error-status :error
     2088       then do:
     2089         message
     2090           vss-workfile vss-revision vss-description skip
     2091           vss-include-info7 skip
     2092           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2093           "Объект" p-obj-type p-obj-code skip
     2094           "Артикул" p-artic p-prod-type p-prod-code skip
     2095           "Дата" p-fact-date skip
     2096           view-as alert-box error .
     2097         undo, return error .
     2098       end.
     2099     end.
     2100   end procedure.
     2101   procedure prdoclib-calc-temp-fact-sale :
     2102     define input  parameter p-obj-type           as character no-undo .
     2103     define input  parameter p-obj-code           as integer   no-undo .
     2104     define input  parameter p-gds-code           as integer   no-undo .
     2105     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2106     define input  parameter p-curr-r-b           as character no-undo .
     2107     define output parameter p-fact-qnty          as decimal   no-undo .
     2108     define output parameter p-cur-base           as decimal   no-undo .
     2109     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2110     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2111     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2112     define output parameter p-cur-excise-base    as decimal   no-undo .
     2113     define buffer buf_temp-prt-obj for temp-prt-obj .
     2114     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2115     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2116     define variable parrecid-prl        as recid     no-undo .
     2117     define variable v-fact-qnty         as decimal   no-undo .
     2118     define variable v-cur-base          as decimal   no-undo .
     2119     define variable v-cur-VAT-base      as decimal   no-undo .
     2120     define variable v-cur-SLT-base      as decimal   no-undo .
     2121     define variable v-cur-road-tax-base as decimal   no-undo .
     2122     define variable v-cur-excise-base   as decimal   no-undo .
     2123     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2124     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2125     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2126     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2127     define variable vat-base-sale-prl               as decimal   no-undo .
     2128     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2129     define variable vat-base-buyer-prl              as decimal   no-undo .
     2130     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2131     define variable slt-base-sale-prl               as decimal   no-undo .
     2132     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2133     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2134     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2135     define variable excise-base-sale-prl            as decimal   no-undo .
     2136     define variable excise-rubl-sale-prl            as decimal   no-undo .
     2137     define variable discnt-base-sale-prl            as decimal   no-undo .
     2138     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2139     do
     2140     on error undo, return error return-value
     2141     :
     2142       for each buf_temp-prt-obj no-lock
     2143       on error undo, return error return-value
     2144       :
     2145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2146     (input  p-gds-code
     2147     ,input  buf_temp-prt-obj.prt-code
     2148     ,output v-prt-b-code
     2149     ) no-error .
     2150         if error-status :error
     2151         then do:
     2152           message
     2153             vss-workfile vss-revision vss-description skip
     2154             "Ошибка при определении бар-кода признака" skip
     2155             "Код товара"   p-gds-code skip
     2156             "Код признака" buf_temp-prt-obj.prt-code skip
     2157             error-status :get-message(1) skip
     2158             return-value skip
     2159             view-as alert-box error .
     2160           undo, return error .
     2161         end.
     2162   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2164     (input  p-obj-type
     2165     ,input  p-obj-code
     2166     ,input  v-prt-b-code
     2167     ,input  0
     2168     ,input  p-day-end-fact-order
     2169     ,output parrecid-prl
     2170     ,output v-cli-base-rate
     2171     ) no-error .
     2172         if error-status :error
     2173         then do:
     2174           message
     2175             vss-workfile vss-revision vss-description skip
     2176             "Ошибка при определении цены бар-кода" skip
     2177             "Объект" p-obj-type p-obj-code skip
     2178             "Бар-код" v-prt-b-code skip
     2179             "fact-order" p-day-end-fact-order skip
     2180             error-status :get-message(1) skip
     2181             return-value skip
     2182             view-as alert-box error .
     2183           undo, return error .
     2184         end.
     2185         if parrecid-prl <> ?
     2186         then do:
     2187           run prl-vat in this-procedure
     2188             (input  parrecid-prl
     2189             ,output price-rubl-with-tax-sale-prl
     2190             ,output price-base-with-tax-sale-prl
     2191             ,output price-rubl-without-tax-sale-prl
     2192             ,output price-base-without-tax-sale-prl
     2193             ,output vat-base-sale-prl
     2194             ,output vat-rubl-sale-prl
     2195             ,output vat-base-buyer-prl
     2196             ,output vat-rubl-buyer-prl
     2197             ,output slt-base-sale-prl
     2198             ,output slt-rubl-sale-prl
     2199             ,output road-tax-base-sale-prl
     2200             ,output road-tax-rubl-sale-prl
     2201             ,output excise-base-sale-prl
     2202             ,output excise-rubl-sale-prl
     2203             ,output discnt-base-sale-prl
     2204             ,output discnt-rubl-sale-prl
     2205             ) no-error .
     2206           if error-status :error
     2207           then do:
     2208             message
     2209               vss-workfile vss-revision vss-description skip
     2210               "Ошибка при вызове процеды prl-vat" skip
     2211               "Объект" p-obj-type p-obj-code skip
     2212               "Код товара" p-gds-code skip
     2213               "Указатель на запись переоценки" parrecid-prl skip
     2214               error-status :get-message(1) skip
     2215               return-value skip
     2216               view-as alert-box error .
     2217             undo, return error .
     2218           end.
     2219         end.
     2220         else do:
     2221           assign
     2222             price-rubl-with-tax-sale-prl    = 0
     2223             price-base-with-tax-sale-prl    = 0
     2224             price-rubl-without-tax-sale-prl = 0
     2225             price-base-without-tax-sale-prl = 0
     2226             vat-base-sale-prl               = 0
     2227             vat-rubl-sale-prl               = 0
     2228             slt-base-sale-prl               = 0
     2229             slt-rubl-sale-prl               = 0
     2230             road-tax-base-sale-prl          = 0
     2231             road-tax-rubl-sale-prl          = 0
     2232             excise-base-sale-prl            = 0
     2233             excise-rubl-sale-prl            = 0
     2234             discnt-base-sale-prl            = 0
     2235             discnt-rubl-sale-prl            = 0
     2236           .
     2237         end.
     2238         assign
     2239           v-fact-qnty         = v-fact-qnty
     2240                               + buf_temp-prt-obj.fact-qnty
     2241           v-cur-base          = v-cur-base
     2242                               + (if p-curr-r-b = 'base':U
     2243                                   then price-base-with-tax-sale-prl
     2244                                   else price-rubl-with-tax-sale-prl
     2245                                 )
     2246                               * buf_temp-prt-obj.fact-qnty
     2247           v-cur-VAT-base      = v-cur-VAT-base
     2248                               + (if p-curr-r-b = 'base':U
     2249                                   then vat-base-sale-prl
     2250                                   else vat-rubl-sale-prl
     2251                                 )
     2252                               * buf_temp-prt-obj.fact-qnty
     2253           v-cur-SLT-base      = v-cur-SLT-base
     2254                               + (if p-curr-r-b = 'base':U
     2255                                   then slt-base-sale-prl
     2256                                   else slt-rubl-sale-prl
     2257                                 )
     2258                               * buf_temp-prt-obj.fact-qnty
     2259           v-cur-road-tax-base = v-cur-road-tax-base
     2260                               + (if p-curr-r-b = 'base':U
     2261                                   then road-tax-base-sale-prl
     2262                                   else road-tax-rubl-sale-prl
     2263                                 )
     2264                               * buf_temp-prt-obj.fact-qnty
     2265           v-cur-excise-base   = v-cur-excise-base
     2266                               + (if p-curr-r-b = 'base':U
     2267                                   then excise-base-sale-prl
     2268                                   else excise-rubl-sale-prl
     2269                                 )
     2270                               * buf_temp-prt-obj.fact-qnty
     2271         .
     2272       end.
     2273       assign
     2274         p-fact-qnty         = v-fact-qnty
     2275         p-cur-base          = v-cur-base
     2276         p-cur-VAT-base      = v-cur-VAT-base
     2277         p-cur-SLT-base      = v-cur-SLT-base
     2278         p-cur-road-tax-base = v-cur-road-tax-base
     2279         p-cur-excise-base   = v-cur-excise-base
     2280       .
     2281     end.
     2282   end procedure.
     2283   procedure prdoclib-clear-temp-pl-gds :
     2284     define buffer buf_temp-pl-gds for temp-pl-gds .
     2285     do
     2286     on error undo, return error return-value
     2287     :
     2288       for each buf_temp-pl-gds
     2289       on error undo, return error return-value
     2290       :
     2291         delete buf_temp-pl-gds .
     2292       end.
     2293     end.
     2294   end procedure.
     2295   procedure prdoclib-init-temp-pl-gds :
     2296     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2297     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2298     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2299     define buffer buf_pl-gds      for ub.pl-gds .
     2300     define buffer buf_temp-pl-gds for temp-pl-gds .
     2301     do
     2302     on error undo, return error return-value
     2303     :
     2304       run prdoclib-clear-temp-pl-gds in this-procedure .
     2305       for each buf_pl-gds
     2306         where buf_pl-gds.obj-type = p-obj-type
     2307           and buf_pl-gds.obj-code = p-obj-code
     2308           and buf_pl-gds.gds-code = p-gds-code
     2309       on error undo, return error return-value
     2310       :
     2311         create buf_temp-pl-gds .
     2312         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2313       end.
     2314     end.
     2315   end procedure.
     2316   procedure prdoclib-init-pl-gds-by-factord :
     2317     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2318     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2319     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2320     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2321     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2322     define input parameter p-fact-order         as decimal   no-undo .
     2323     define input parameter p-include-fact-order as logical   no-undo .
     2324     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     2325     define buffer buf_goods       for ub.goods .
     2326     define buffer buf_gds-obj     for ub.gds-obj .
     2327     define buffer buf_doc-line    for ub.doc-line .
     2328     define buffer buf_temp-pl-gds for temp-pl-gds .
     2329     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     2330     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     2331     do
     2332     on error undo, return error return-value
     2333     :
     2334       do transaction
     2335       on error undo, return error return-value
     2336       :
     2337   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2339     (input  p-obj-type
     2340     ,input  p-obj-code
     2341     ,input  p-artic
     2342     ,input  p-prod-type
     2343     ,input  p-prod-code
     2344     ,buffer buf_gds-obj
     2345     ) no-error .
     2346         if error-status :error
     2347         then do:
     2348           message
     2349             vss-workfile vss-revision vss-description skip
     2350             vss-include-info7 skip
     2351             "Невозможно найти gds-obj" skip
     2352             error-status :get-message(1) skip
     2353             return-value skip
     2354             view-as alert-box error .
     2355           undo, return error return-value .
     2356         end.
     2357         find current buf_gds-obj exclusive-lock .
     2358       end.
     2359       find first buf_goods no-lock
     2360         where buf_goods.artic     = p-artic
     2361           and buf_goods.prod-type = p-prod-type
     2362           and buf_goods.prod-code = p-prod-code
     2363         .
     2364       run prdoclib-init-temp-pl-gds in this-procedure
     2365         (input p-obj-type
     2366         ,input p-obj-code
     2367         ,input buf_goods.gds-code
     2368         ) .
     2369       if p-include-fact-order = true
     2370       then do:
     2371         assign
     2372          p-fact-order = p-fact-order - 0.0000000001
     2373         .
     2374       end.
     2375       for each buf_doc-line no-lock
     2376         where buf_doc-line.obj-type   = p-obj-type
     2377           and buf_doc-line.obj-code   = p-obj-code
     2378           and buf_doc-line.artic      = p-artic
     2379           and buf_doc-line.prod-type  = p-prod-type
     2380           and buf_doc-line.prod-code  = p-prod-code
     2381           and buf_doc-line.status_    = 'факт':U
     2382           and buf_doc-line.fact-order >= p-fact-order
     2383       on error undo, return error return-value
     2384       :
     2385         run prdoclib-prc-pl-document in this-procedure
     2386           ( input  buf_doc-line.doc-code
     2387            ,input  p-obj-type
     2388            ,input  p-obj-code
     2389            ,input  buf_goods.gds-code
     2390            ,output v-total-pl-gds-qnty
     2391            ,output v-total-pl-gds-cli-qnty
     2392           ) .
     2393       end.
     2394     end.
     2395   end procedure.
     2396   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2397   procedure factord :
     2398     define input  parameter p-fact-date            as date    no-undo .
     2399     define input  parameter p-fact-time            as integer no-undo .
     2400     define input  parameter p-fact-num             as integer no-undo .
     2401     define input  parameter p-shift-date           as date    no-undo .
     2402     define input  parameter p-shift-num            as integer no-undo .
     2403     define input  parameter p-shift-on             as logical no-undo .
     2404     define output parameter p-fact-order           as decimal no-undo .
     2405     define output parameter p-shift-end-fact-order as decimal no-undo .
     2406     define output parameter p-day-end-fact-order   as decimal no-undo .
     2407     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2408     if p-fact-date = ?
     2409     then do:
     2410       return error "Не указана фактическая дата" .
     2411     end.
     2412     define variable v-fact-date-num as integer no-undo .
     2413     assign
     2414       v-fact-date-num = integer(p-fact-date)
     2415     .
     2416     if p-fact-num = ?
     2417     or p-fact-num = 0
     2418     then do:
     2419       return error "Не задан p-fact-num " + string(p-fact-num) .
     2420     end.
     2421     if p-fact-num < 0
     2422     then do:
     2423       return error "Отрицательный fact-num " + string(p-fact-num) .
     2424     end.
     2425     if p-fact-num >= 100000000
     2426     then do:
     2427       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2428     end.
     2429     if p-shift-on = true
     2430     then do:
     2431       if p-shift-date = ?
     2432       then do:
     2433         return error "Не задана дата смены" .
     2434       end.
     2435       if p-shift-num = ?
     2436       or p-shift-num = 0
     2437       then do:
     2438         return error "Не задан номер смены" .
     2439       end.
     2440     end.
     2441     else do:
     2442       assign
     2443         p-shift-date = p-fact-date
     2444         p-shift-num  = 24
     2445       .
     2446     end.
     2447     define variable v-shift-offset as integer no-undo .
     2448     if p-shift-date = p-fact-date
     2449     then do:
     2450       assign
     2451         v-shift-offset = 1
     2452       .
     2453     end.
     2454     if p-shift-date < p-fact-date
     2455     then do:
     2456       assign
     2457         v-shift-offset = 0
     2458       .
     2459     end.
     2460     if p-shift-date > p-fact-date
     2461     then do:
     2462       message
     2463         vss-workfile vss-revision vss-description skip
     2464         "Неправильная дата закрытия смены" skip
     2465         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2466         view-as alert-box error .
     2467       undo, return error
     2468         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2469           ,string(p-fact-date, '99/99/9999':U)
     2470           ,string(p-shift-date, '99/99/9999':U)
     2471           )
     2472       .
     2473     end.
     2474     if p-shift-num < 1
     2475     or p-shift-num > 24
     2476     then do:
     2477       message
     2478         vss-workfile vss-revision vss-description skip
     2479         "Неправильный номер смены" skip
     2480         "p-shift-num" p-shift-num skip
     2481         view-as alert-box error .
     2482       undo, return error return-value .
     2483     end.
     2484     assign
     2485       p-fact-order           = v-fact-date-num
     2486                              + v-shift-offset * 0.5
     2487                              + p-shift-num    * 0.02 - 0.01
     2488                              + p-fact-num     * 0.0000000001
     2489       p-shift-end-fact-order = v-fact-date-num
     2490                              + v-shift-offset * 0.5
     2491                              + p-shift-num    * 0.02
     2492       p-day-end-fact-order   = v-fact-date-num
     2493                              + 0.99
     2494     .
     2495     if p-fact-order           <= v-fact-date-num
     2496     or p-shift-end-fact-order <= v-fact-date-num
     2497     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2498     or p-shift-end-fact-order >= p-day-end-fact-order
     2499     then do:
     2500       message
     2501         vss-workfile vss-revision vss-description skip
     2502         "Внутренняя ошибка при генерации фактического номера" skip
     2503         "p-fact-date"            p-fact-date            skip
     2504         "p-fact-time"            p-fact-time            skip
     2505         "p-fact-num"             p-fact-num             skip
     2506         "p-shift-date"           p-shift-date           skip
     2507         "p-shift-num"            p-shift-num            skip
     2508         "p-shift-on"             p-shift-on             skip
     2509         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2510         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2511         "v-fact-date-num"        v-fact-date-num        skip
     2512         view-as alert-box error .
     2513       undo, return error return-value .
     2514     end.
     2515   end procedure.
     2516   procedure day-begin-fact-order :
     2517     define input  parameter p-fact-date            as date    no-undo .
     2518     define output parameter p-day-begin-fact-order as decimal no-undo .
     2519     do
     2520     on error undo, return error return-value
     2521     :
     2522       if p-fact-date = ?
     2523       then do:
     2524         assign
     2525           p-day-begin-fact-order = 0
     2526         .
     2527       end.
     2528       else do:
     2529         assign
     2530           p-day-begin-fact-order = integer(p-fact-date)
     2531         .
     2532       end.
     2533     end.
     2534   end procedure.
     2535   procedure factord-max-fact-order :
     2536     define output parameter p-max-fact-order as decimal   no-undo .
     2537     do
     2538     on error undo, return error return-value
     2539     :
     2540       run day-begin-fact-order in this-procedure
     2541         (input  date(1, 1, 5000)
     2542         ,output p-max-fact-order
     2543         ) .
     2544     end.
     2545   end procedure.
     2546   procedure factord-cut-archive :
     2547     define input  parameter p-obj-type             as character no-undo .
     2548     define input  parameter p-obj-code             as integer   no-undo .
     2549     define input  parameter p-fact-date            as date      no-undo .
     2550     define output parameter p-shift-on             as logical   no-undo .
     2551     define output parameter p-shift-date           as date      no-undo .
     2552     define output parameter p-shift-num            as integer   no-undo .
     2553     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2554     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2555     define variable v-fact-order as decimal   no-undo .
     2556     define buffer buf_shift-obj for ub.shift-obj .
     2557     do
     2558     on error undo, return error return-value
     2559     :
     2560   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2562     (input  p-obj-type
     2563     ,input  p-obj-code
     2564     ,input  'shift-on=request'
     2565     ,output p-shift-on
     2566     ) no-error .
     2567       if error-status :error
     2568       then do:
     2569         message
     2570           vss-workfile vss-revision vss-description skip
     2571           "Ошибка при определении атрибута объекта" skip
     2572           "Объект" p-obj-type p-obj-code skip
     2573           error-status :get-message(1) skip
     2574           return-value skip
     2575           view-as alert-box error .
     2576         undo, return error return-value .
     2577       end.
     2578       if p-shift-on = false
     2579       then do:
     2580         assign
     2581           p-shift-date               = ?
     2582           p-shift-num                = 0
     2583         .
     2584       end.
     2585       else do:
     2586         find first buf_shift-obj share-lock
     2587           where buf_shift-obj.obj-type   = p-obj-type
     2588             and buf_shift-obj.obj-code   = p-obj-code
     2589             and buf_shift-obj.shift-date > p-fact-date
     2590           use-index pi
     2591           no-error .
     2592         if not available buf_shift-obj
     2593         or buf_shift-obj.status_ <> 'зкр':U
     2594         then do:
     2595           message
     2596             vss-workfile vss-revision vss-description skip
     2597             "Невозможно вычислить последнюю смену" skip
     2598             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2599             "Объект" p-obj-type p-obj-code skip
     2600             "Дата" p-fact-date skip
     2601             view-as alert-box error .
     2602           undo, return error return-value .
     2603         end.
     2604         find last buf_shift-obj share-lock
     2605           where buf_shift-obj.obj-type = p-obj-type
     2606             and buf_shift-obj.obj-code = p-obj-code
     2607             and buf_shift-obj.shift-date <= p-fact-date
     2608           use-index pi
     2609           no-error .
     2610         if available buf_shift-obj
     2611         then do:
     2612           if  buf_shift-obj.status_ = 'зкр':U
     2613           then do:
     2614             assign
     2615               p-shift-date = buf_shift-obj.shift-date
     2616               p-shift-num  = buf_shift-obj.shift-num
     2617             .
     2618           end.
     2619           else do:
     2620             message
     2621               vss-workfile vss-revision vss-description skip
     2622               "Невозможно вычислить последнюю смену" skip
     2623               "Статус смены отличен от статуса" 'зкр':U skip
     2624               "Объект" p-obj-type p-obj-code skip
     2625               "Дата" p-fact-date skip
     2626               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2627               view-as alert-box error .
     2628             undo, return error return-value .
     2629           end.
     2630         end.
     2631         else do:
     2632           assign
     2633             p-shift-date = p-fact-date - 1
     2634             p-shift-num  = 1
     2635           .
     2636         end.
     2637       end.
     2638       run factord in this-procedure
     2639         (input  p-fact-date
     2640         ,input  1
     2641         ,input  1
     2642         ,input  p-shift-date
     2643         ,input  p-shift-num
     2644         ,input  p-shift-on
     2645         ,output v-fact-order
     2646         ,output p-shift-end-fact-order
     2647         ,output p-day-end-fact-order
     2648         ) no-error .
     2649       if error-status :error
     2650       then do:
     2651         message
     2652           vss-workfile vss-revision vss-description skip
     2653           "Ошибка при вызове процедуры factord"
     2654           error-status :get-message(1) skip
     2655           return-value skip
     2656           view-as alert-box error .
     2657         undo, return error return-value .
     2658       end.
     2659     end.
     2660   end procedure.
     2661   procedure factord-lock-shift :
     2662     define input  parameter p-obj-type  as character no-undo .
     2663     define input  parameter p-obj-code  as integer   no-undo .
     2664     define input  parameter p-fact-date as date      no-undo .
     2665     define parameter buffer buf_shift-obj for ub.shift-obj .
     2666     define variable v-shift-on      as logical   no-undo .
     2667     define variable v-extra-message as character no-undo .
     2668     define variable v-error as character no-undo .
     2669     do
     2670     on error undo, return error return-value
     2671     :
     2672   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2673   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2674     (input  p-obj-type
     2675     ,input  p-obj-code
     2676     ,input  'shift-on=request'
     2677     ,output v-shift-on
     2678     ) no-error .
     2679       if error-status :error
     2680       then do:
     2681         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2682         undo, return error v-error .
     2683       end.
     2684       if v-shift-on = true
     2685       then do:
     2686         find first buf_shift-obj share-lock
     2687           where buf_shift-obj.obj-type   = p-obj-type
     2688             and buf_shift-obj.obj-code   = p-obj-code
     2689             and buf_shift-obj.shift-date > p-fact-date
     2690           use-index pi
     2691           no-error .
     2692         if not available buf_shift-obj
     2693         or buf_shift-obj.status_ <> 'зкр':U
     2694         then do:
     2695           find last buf_shift-obj
     2696             where buf_shift-obj.obj-type = p-obj-type
     2697               and buf_shift-obj.obj-code = p-obj-code
     2698               and buf_shift-obj.status_  = 'зкр':U
     2699             use-index stts
     2700             no-error .
     2701           if available buf_shift-obj
     2702           then do:
     2703             assign
     2704               v-extra-message =
     2705                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2706                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2707                               )
     2708             .
     2709           end.
     2710           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2711           undo, return error v-error .
     2712         end.
     2713       end.
     2714     end.
     2715   end procedure.
     2716   procedure factord-end-day :
     2717     define input  parameter p-fact-date            as date    no-undo .
     2718     define output parameter p-day-end-fact-order   as decimal no-undo .
     2719     do
     2720     on error undo, return error return-value
     2721     :
     2722       if p-fact-date = ?
     2723       then do:
     2724         return error "Не указана фактическая дата" .
     2725       end.
     2726       assign
     2727         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2728       .
     2729     end.
     2730   end procedure.
     2731   procedure factord-to-date :
     2732     define input  parameter p-fact-order as decimal no-undo .
     2733     define output parameter p-fact-date  as date    no-undo .
     2734     define variable v-ref-date  as date      no-undo .
     2735     define variable v-ref-delta as integer   no-undo .
     2736     do
     2737     on error undo, return error return-value
     2738     :
     2739       if p-fact-order = ?
     2740       or p-fact-order = 0
     2741       then do:
     2742         return error "Не указан fact-order" .
     2743       end.
     2744       assign
     2745         v-ref-date  = date(1, 1, 2000)
     2746       .
     2747       assign
     2748         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2749       .
     2750       assign
     2751         p-fact-date = v-ref-date + v-ref-delta
     2752       .
     2753     end.
     2754   end procedure.
     2755   procedure factord-to-fact-num :
     2756     define input  parameter p-fact-order as decimal no-undo .
     2757     define output parameter p-fact-num   as integer no-undo .
     2758     define variable v-fact-order-trunc as decimal no-undo .
     2759     do
     2760     on error undo, return error return-value
     2761     :
     2762       if p-fact-order = ?
     2763       or p-fact-order = 0
     2764       then do:
     2765         return error "Не указан fact-order" .
     2766       end.
     2767       assign
     2768        v-fact-order-trunc = truncate(p-fact-order, 2)
     2769       .
     2770       assign
     2771         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2772       .
     2773     end.
     2774   end procedure.
     2775   procedure factord-to-shift-num :
     2776     define input  parameter p-fact-order as decimal no-undo .
     2777     define output parameter p-shift-num   as integer no-undo .
     2778     define variable  p-shift-numd  as decimal   no-undo .
     2779     define variable v-fact-order-trunc as decimal no-undo .
     2780     do
     2781     on error undo, return error return-value
     2782     :
     2783       if p-fact-order = ?
     2784       or p-fact-order = 0
     2785       then do:
     2786         return error "Не указан fact-order" .
     2787       end.
     2788       assign
     2789        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2790       .
     2791       if v-fact-order-trunc < 0.5 then do:
     2792         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2793       end.
     2794       assign
     2795         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2796         .
     2797        assign
     2798         p-shift-num = truncate (p-shift-numd , 0)
     2799       .
     2800     end.
     2801   end procedure.
     2802   define variable vss-include-info27 as character format "X(65)" no-undo
     2803   initial "@(#)$Workfile$ $Revision$".
     2804   procedure grplib-get-full-name :
     2805      define input parameter p-node-code  as integer      no-undo.
     2806      define output parameter p-full-name as character    no-undo.
     2807      do
     2808   on error undo, return error
     2809   :
     2810       define variable v-upper-code    as integer           no-undo.
     2811       define buffer buf_gds-grp       for ub.gds-grp.
     2812       define buffer buf_upper_gds-grp for ub.gds-grp.
     2813       find first buf_gds-grp no-lock
     2814            where buf_gds-grp.node-code = p-node-code
     2815       no-error.
     2816       if not available buf_gds-grp
     2817       then do:
     2818           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2819       end.
     2820       assign
     2821           p-full-name  = ""
     2822           v-upper-code = 1
     2823       .
     2824       do while buf_gds-grp.upper-code <> 0
     2825       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2826       :
     2827           assign
     2828               p-full-name  = buf_gds-grp.node-name
     2829                            + (if p-full-name <> "" then chr(47) else "")
     2830                            + p-full-name
     2831               v-upper-code = buf_gds-grp.upper-code
     2832           .
     2833           find first buf_gds-grp no-lock
     2834                where buf_gds-grp.node-code = v-upper-code
     2835           no-error.
     2836           if not available buf_gds-grp
     2837           then do:
     2838               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2839                                   + string( v-upper-code )
     2840                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2841           end.
     2842       end.
     2843       assign
     2844       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2845       .
     2846   end.
     2847   end .
     2848   procedure grplib-get-node-from-full-name :
     2849   define input parameter p-full-name as character no-undo .
     2850   define output parameter p-node-code as integer no-undo .
     2851   define variable v-ii as integer no-undo .
     2852   define variable v-upper-code as integer no-undo .
     2853   define variable v-root-code as integer no-undo .
     2854   define variable v-entry as character no-undo .
     2855   define buffer buf_gds-grp       for ub.gds-grp.
     2856   do
     2857   on error undo, return error
     2858   :
     2859     find first buf_gds-grp no-lock
     2860         where buf_gds-grp.upper-code = 0
     2861     no-error .
     2862     if not available buf_gds-grp
     2863     then do:
     2864         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2865     end.
     2866     else do:
     2867       assign
     2868       v-root-code = buf_gds-grp.node-code
     2869       .
     2870     end.
     2871     v-upper-code = v-root-code.
     2872     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2873       assign
     2874       v-entry = entry(v-ii, p-full-name, chr(47)).
     2875       if v-entry = '' then leave.
     2876       find first buf_gds-grp no-lock where
     2877                 buf_gds-grp.node-name = v-entry
     2878             and buf_gds-grp.upper-code = v-upper-code
     2879             no-error.
     2880       if not available buf_gds-grp then do:
     2881         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2882       end.
     2883       else do:
     2884         p-node-code = buf_gds-grp.node-code.
     2885         v-upper-code = buf_gds-grp.node-code.
     2886       end.
     2887     end.
     2888   end.
     2889   end .
     2890   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2891   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     2892   define  shared variable RepPathName        as character no-undo .
     2893   define  shared variable PrintRubl          as logical   no-undo .
     2894   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     2895     if num-entries(string(p-dec), '.') = 2
     2896       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     2897       else return( string(p-dec)) .
     2898   end function.
     2899   function format-point-to-comma returns char (input orig as char ) .
     2900   define variable rtext as character no-undo .
     2901   define variable strt as integer no-undo .
     2902   define variable leng as integer no-undo .
     2903   assign rtext = orig .
     2904   repeat:
     2905     strt =  index(rtext,'.').
     2906     if strt = 0 then leave.
     2907     leng = 1.
     2908     substring(rtext,strt,leng,"character") = v-delim .
     2909   end.
     2910   return rtext.
     2911   end function.
     2912   function format-excel-text returns char ( input start-text as char ) :
     2913   def var  i    as int no-undo.
     2914   def var  ch   as char no-undo.
     2915   def var  n    as int no-undo.
     2916   def var  ipos as int no-undo.
     2917     n = num-entries(trim(start-text), chr(10)) - 1 .
     2918     do i = 1 to n :
     2919       ipos = index( start-text, chr(10)).
     2920       if ipos > 0 then
     2921         substr( start-text, ipos, 1 ) = ' '.
     2922     end.
     2923     n = num-entries(trim(start-text), chr(13)) - 1 .
     2924     do i = 1 to n :
     2925       ipos = index( start-text, chr(13)).
     2926       if ipos > 0 then
     2927         substr( start-text, ipos, 1 ) = ' '.
     2928     end.
     2929     if index( start-text, '"' ) = 0 then
     2930       start-text =  '="'   + trim( start-text) + '"'   .
     2931       else do:
     2932         n = num-entries(trim(start-text), '"') - 1.
     2933         do i = 1 to n :
     2934           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2935         end.
     2936         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2937         start-text = '="'  + ch  + '"' .
     2938       end.
     2939     return start-text.
     2940   end.
     2941   function excel-sum returns char (input p-dec as decimal ).
     2942     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     2943   end function.
     2944   function excel-qnty returns char (input p-dec as decimal ).
     2945     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     2946   end function.
     2947   function format-excel-text-macr returns char ( input start-text as char ) :
     2948   def var  i    as int no-undo.
     2949   def var  ch   as char no-undo.
     2950   def var  n    as int no-undo.
     2951   def var  ipos as int no-undo.
     2952     n = num-entries(trim(start-text), chr(10)) - 1 .
     2953     do i = 1 to n :
     2954       ipos = index( start-text, chr(10)).
     2955       if ipos > 0 then
     2956         substring( start-text, ipos , 1 ) = ' '.
     2957     end.
     2958     n = num-entries(trim(start-text), chr(13)) - 1 .
     2959     do i = 1 to n :
     2960       ipos = index( start-text, chr(13)).
     2961       if ipos > 0 then
     2962         substring( start-text, ipos, 1 ) = ' '.
     2963     end.
     2964     if index( start-text, '"' ) = 0 then
     2965       start-text =  '"'   + trim( start-text) + '"'   .
     2966       else do:
     2967         n = num-entries(trim(start-text), '"') - 1.
     2968         do i = 1 to n :
     2969           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2970         end.
     2971         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2972         start-text = '"'  + ch  + '"' .
     2973       end.
     2974     n = num-entries(trim(start-text), chr(10)) - 1 .
     2975     do i = 1 to n :
     2976       ipos = index( start-text, chr(10)).
     2977       if ipos > 0 then
     2978         substring( start-text, ipos , 1 ) = ' '.
     2979     end.
     2980       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     2981     return start-text.
     2982   end.
     2983   def var vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2984   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2985   procedure paramls-clear :
     2986     define buffer buf_temp-param for temp-param .
     2987     do
     2988     on error undo, return error return-value
     2989     :
     2990       for each buf_temp-param
     2991       on error undo, return error
     2992       :
     2993         delete buf_temp-param .
     2994       end.
     2995     end.
     2996   end procedure.
     2997   procedure paramls-write :
     2998     define input  parameter p-code     as character no-undo .
     2999     define input  parameter p-sub-code as character no-undo .
     3000     define input  parameter p-value    as character no-undo .
     3001     define buffer buf_temp-param for temp-param .
     3002     do
     3003     on error undo, return error return-value
     3004     :
     3005       find first buf_temp-param
     3006         where buf_temp-param.param-code     = p-code
     3007           and buf_temp-param.param-sub-code = p-sub-code
     3008         no-error .
     3009       if not available buf_temp-param then do:
     3010         create buf_temp-param .
     3011         assign
     3012           buf_temp-param.param-code     = p-code
     3013           buf_temp-param.param-sub-code = p-sub-code
     3014         .
     3015       end.
     3016       assign
     3017         buf_temp-param.param-value = p-value
     3018       .
     3019     end.
     3020   end procedure.
     3021   procedure paramls-read :
     3022     define input  parameter p-code          as character no-undo .
     3023     define input  parameter p-sub-code      as character no-undo .
     3024     define input  parameter p-default-value as character no-undo .
     3025     define output parameter p-value         as character no-undo .
     3026     define buffer buf_temp-param for temp-param .
     3027     do
     3028     on error undo, return error return-value
     3029     :
     3030       find first buf_temp-param
     3031         where buf_temp-param.param-code     = p-code
     3032           and buf_temp-param.param-sub-code = p-sub-code
     3033         no-error .
     3034       if available buf_temp-param then do:
     3035         assign
     3036           p-value = buf_temp-param.param-value
     3037         .
     3038       end.
     3039       else do:
     3040         assign
     3041           p-value = p-default-value
     3042         .
     3043       end.
     3044     end.
     3045   end procedure.
     3046   procedure paramls-append :
     3047     define input  parameter p-code     as character no-undo .
     3048     define input  parameter p-sub-code as character no-undo .
     3049     define input  parameter p-value    as character no-undo .
     3050     define buffer buf_temp-param for temp-param .
