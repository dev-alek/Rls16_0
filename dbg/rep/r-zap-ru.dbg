      580     define input  parameter p-check-price-parts as logical   no-undo .
      581     define input  parameter p-doc-num           as character no-undo .
      582     define input  parameter p-fact-date         as date      no-undo .
      583     define input  parameter p-corr-user-db-num  as integer   no-undo .
      584     define input  parameter p-corr-user-name    as character no-undo .
      585     define input  parameter p-corr-date         as date      no-undo .
      586     define input  parameter p-corr-time         as integer   no-undo .
      587     define input  parameter p-corr-time-str     as character no-undo .
      588     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
      589     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
      590     define buffer buf_gds-obj      for ub.gds-obj .
      591     define buffer buf_prt-obj      for ub.prt-obj .
      592     define buffer buf_price-list   for ub.price-list .
      593     define buffer buf_bar-code     for ub.bar-code .
      594     define buffer buf_temp-prt-obj for temp-prt-obj .
      595     define variable v-gds-code             like ub.goods.gds-code    no-undo .
      596     define variable v-root-node            like ub.prt-obj.prt-code  no-undo .
      597     define variable v-root-b-code          like ub.bar-code.b-code   no-undo .
      598     define variable v-total-term-fact-qnty like ub.prt-obj.fact-qnty no-undo .
      599     define variable v-total-fact-sale      like ub.gds-obj.fact-sale no-undo .
      600     define variable v-doc-num     like ub.price-list.doc-num    no-undo .
      601     define variable v-price-sale  like ub.price-list.price-sale no-undo .
      602     define variable v-road-tax    like ub.price-list.road-tax   no-undo .
      603     define variable v-excise      like ub.price-list.excise     no-undo .
      604     do
      605     on error undo, return error return-value
      606     :
      607   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      609     (input  p-artic
