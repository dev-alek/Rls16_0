      333   procedure create_obj-list :
      334      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      335      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      336      do
      337      on error undo, return error return-value
      338      :
      339         define buffer cli-obj for ub.clients .
      340         define variable p-var as integer no-undo .
      341         define buffer buf_obj-list for obj-list .
      342         find last buf_obj-list  use-index pi no-error .
      343         if available buf_obj-list
      344         then
      345            p-var = buf_obj-list.obj-id + 1.
      346         else
      347            p-var = 1.
      348         find first cli-obj where
      349                   cli-obj.obj-type = p-obj-type
      350               and cli-obj.obj-code = p-obj-code
      351         no-lock no-error.
      352         if available cli-obj
      353         then do:
      354            create buf_obj-list.
      355            assign
      356               buf_obj-list.obj-id   = p-var
      357               buf_obj-list.obj-code = cli-obj.obj-code
      358               buf_obj-list.obj-type = cli-obj.obj-type
      359               buf_obj-list.obj-name = cli-obj.obj-name
      360               buf_obj-list.db-num   = cli-obj.db-num
      361            .
      362         end.
      363      end.
      364   end.
