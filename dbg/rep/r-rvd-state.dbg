       81   procedure prn-lib-prn-file :
       82     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       83     define input parameter p-DIsabledoptions as integer no-undo .
       84     define variable v-report-name as character no-undo .
       85     define variable v-user-action as character no-undo .
       86     define variable v-printed     as logical   no-undo .
       87     define variable v-exist       as logical   no-undo .
       88     do
       89       on error undo, return error
       90       :
       91       run prn-lib-get-report-name  in this-procedure (
       92         input parParentProc
       93         ,output v-report-name
       94         ).
       95   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       97     (input  v-report-name
       98     ,input  2
       99     ,output v-exist
      100     )  .
      101       if NOT v-exist then
      102       DO:
      103         Message
      104           "Нет заданий на печать ! "
      105           view-as alert-box .
      106         Return  .
      107       End.
      108       run gbl/prnfilen.w
      109         (input  ""
      110         ,input  p-DisabledOptions
      111         ,input  string(v-report-name )
      112         ,input  7
      113         ,output v-user-action
      114         ,output v-printed
      115         ) .
      116       if v-printed then
      117       do:
      118         return "YES" .
      119       end.
      120       else
      121       do:
      122         return "NO" .
      123       end.
      124     end.
      125   end procedure.
      126   procedure prn-lib-open-stream :
      127     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      128     define input parameter p-page-size    as integer no-undo .
      129     define input parameter p-is-stream    as logical no-undo .
      130     define input parameter p-append       as logical no-undo .
      131     define variable v-report-name as character no-undo .
      132     do
      133       on error undo, return error
      134       :
      135       run prn-lib-get-report-name  in this-procedure (
      136         input parParentProc
      137         ,output v-report-name
      138         ).
      139       if p-is-stream then
      140       do:
      141         if p-append then
      142         do:
      143           output stream PrnLibStream to value( v-report-name )
      144             page-size value(p-page-size) append .
      145         end.
      146         if not p-append then
      147         do:
      148           output stream PrnLibStream to value( v-report-name )
      149             page-size value(p-page-size) .
      150         end.
      151       end.
      152       if not p-is-stream then
      153       do:
      154         if p-append then
      155         do:
      156           output to value( v-report-name )
      157             page-size value(p-page-size) append .
      158         end.
      159         if not p-append then
      160         do:
      161           output to value( v-report-name )
      162             page-size value(p-page-size) .
      163         end.
      164       end.
      165     end.
      166   end procedure.
      167   procedure prn-lib-open-exp :
      168     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      169     define input parameter p-is-stream    as logical no-undo .
      170     define input parameter p-is-append    as logical no-undo .
      171     define output parameter p-ReportFileName as char init "report" no-undo.
      172     define output parameter p-process as logical no-undo .
      173     define variable glog as logical no-undo .
      174     do
      175       on error undo, return error
      176       :
      177       SYSTEM-DIALOG GET-FILE p-ReportFileName
      178         TITLE      "Укажите путь"
      179         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      180         ASK-OVERWRITE
      181         CREATE-TEST-FILE
      182         SAVE-AS
      183         USE-FILENAME
      184         DEFAULT-EXTENSION "txt"
      185         UPDATE glog
      186         .
      187       if not glog then  return.
      188       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      189       if p-is-stream then
      190       do:
      191         if p-is-append then
      192         do:
      193           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      194         end.
      195         else
      196         do:
      197           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      198         end.
      199       end.
      200       else
      201       do:
      202         if p-is-append then
      203         do:
      204           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      205         end.
      206         else
      207         do:
      208           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      209         end.
      210       end.
      211       p-process = yes.
      212     end.
      213   end procedure.
