      224   procedure prn-lib-reportviewer :
      225     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      226     define input parameter p-report-name-html as character no-undo .
      227     define input parameter p-param        as character no-undo .
      228     define variable v-excel           as character no-undo init 'TRUE' .
      229     define variable v-value-character as character no-undo .
      230     define variable v-value-integer   as character no-undo .
      231     define variable v-value-date      as date      no-undo .
      232     define variable v-value-decimal   as decimal   no-undo .
      233     define variable rep-excel         as logical   no-undo .
      234     define variable excel-string      as character no-undo .
      235     define variable v-param-type      as character no-undo .
      236     define variable v-tth             as handle    no-undo .
      237     run adm/shattri.p (
      238       input "get":U
      239       ,input  ""
      240       ,input  0
      241       ,input  'report-glob':U
      242       ,input  'rep-excel':U
      243       ,output v-value-character
      244       ,output v-value-date
      245       ,output v-value-decimal
      246       ,output v-value-integer
      247       ,output rep-excel
      248       ,output v-param-type
      249       ,INPUT-OUTPUT table-handle v-tth
      250       )  .
      251     if rep-excel then v-excel = "TRUE" .
      252     else v-excel = "FALSE" .
      253     if p-param eq ""
      254     then
      255        p-param = "EXCEL:" + v-excel.
      256     else
      257        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      258     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      259   end procedure.
