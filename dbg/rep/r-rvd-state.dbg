      757   define variable var-report-r-b as character no-undo .
      758   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      759   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      760     (output var-report-r-b
      761     )  .
      762   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      764   define variable v-waitfram-action01         as character   no-undo .
      765   define variable v-waitfram-action02         as character   no-undo .
      766   define variable v-waitfram-action03         as character   no-undo .
      767   define variable mWaitFramTextBeg            as character   no-undo.
      768   define variable mWaitFramTextEnd            as character   no-undo.
      769   define variable mWaitFramView               as logical     no-undo.
      770   define variable mWaitProcEvent              as logical     no-undo init yes.
      771   define variable mWaitFramInterval           as integer     no-undo init 1 .
      772   define variable mWaitFramStop               as logical     no-undo.
      773   define variable mWaitFramStopUser           as logical     no-undo.
      774   define variable mWaitFramStopTimeOut        as logical     no-undo.
      775   define variable mWaitFramStartProc          as datetime-tz no-undo.
      776   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      777   define button B-WaitFramStop auto-end-key
      778        label "Стоп"
      779        size 10 by 1 tooltip "Остоновить процесс".
      780   define button B-viewProcInfo
      781        label "Информация"
      782        size 15 by 1 tooltip "Информация о процесс".
      783   define frame waitfram
      784     v-waitfram-action01 format "x(72)" no-label skip
      785     v-waitfram-action02 format "x(72)" no-label skip
      786     v-waitfram-action03 format "x(72)" no-label skip
      787     B-viewProcInfo
      788     B-WaitFramStop at row 4 col 30
      789     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      790     .
      791   define new global shared variable mBatchMode as logical no-undo init ?.
      792   define variable mFramBachModHandle as handle no-undo.
      793   mFramBachModHandle = frame waitfram:handle.
      794   define variable mFameOldVis as logical no-undo.
      795   define variable mVisCUrentVin as logical no-undo.
      796   if session:batch-mode
      797   then
      798      mBatchMode = yes.
      799   if mBatchMode = ? then do:
      800     mVisCUrentVin = current-window:visible.
      801     mFameOldVis = mFramBachModHandle:visible.
      802     mFramBachModHandle:visible  = yes.
      803     mBatchMode = mFramBachModHandle:visible ne yes.
      804     mFramBachModHandle:visible = mFameOldVis.
      805     current-window:visible = mVisCUrentVin.
      806   end.
      807    if  log-manager:logfile-name ne ?
      808     then DO:
      809         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      810         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      811         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      812     end.
      813   on choose of B-WaitFramStop in frame waitfram
      814   do:
      815     mWaitFramStop = yes.
      816     mWaitFramStopUser = yes.
      817   end.
      818   function waitfram-check-timeout returns logical():
      819      define variable vtime as int64 no-undo.
      820      if mWaitFramStopTimeOut
      821      then
      822         return yes.
      823      vtime = ( now - mWaitFramStartProc ) / 1000 .
      824      if     mWaitFramTimeOut ne ?
      825         and mWaitFramTimeOut ne 0
      826         and mWaitFramTimeOut lt vtime
      827      then do:
      828         mWaitFramStopTimeOut = yes.
      829      end.
      830      return mWaitFramStopTimeOut.
      831   end.
      832   procedure waitfram-hide :
      833     if not session:batch-mode
      834     then do
      835     on error undo, return error return-value
      836     :
      837       pause 0 before-hide .
      838       if not mBatchMode then
      839         hide frame waitfram .
      840     if     not mWaitFramView
      841        and mWaitProcEvent
      842     then
      843       process events .
      844     end.
      845   end procedure.
      846   procedure waitfram-show :
      847     define input  parameter p-message as character no-undo .
      848     define variable v-left-margin as integer   no-undo .
      849     if not session:batch-mode
      850     then do
      851     on error undo, return error return-value
      852     :
      853       if length(p-message) <= 70 then do:
      854         assign
      855           v-left-margin = integer((70 - length(p-message)) / 2)
      856         .
      857         assign
      858           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      859         .
      860         assign
      861           v-waitfram-action01 = " "
      862           v-waitfram-action02 = " "
      863                                    + fill(" ", v-left-margin)
      864                                    + p-message
      865           v-waitfram-action03 = " "
      866         .
      867       end.
      868       else do:
      869         define variable vRindex1 as integer no-undo.
      870         define variable vRindex2 as integer no-undo.
      871         vRindex1 = r-index(p-message," ",70).
      872         if vRindex1 = 0
      873         then
      874            vRindex1 = 70.
      875         if length(p-message)  <= vRindex1 + 70 then do:
      876           assign
      877             v-waitfram-action01 = " "
      878             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      879             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      880           .
      881         end.
      882         else do:
      883           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      884           if vRindex2 <= vRindex1
      885           then
      886              vRindex2 = vRindex1 + 70.
      887           assign
      888             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      889             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      890             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      891           .
      892         end.
      893       end.
      894       B-viewProcInfo:visible   in frame waitfram = no.
      895       B-viewProcInfo:sensitive in frame waitfram = no.
      896       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      897       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      898       if  (   mWaitFramView
      899          or  mWaitProcEvent)
      900          and not mBatchMode
      901       then
      902          display
      903             v-waitfram-action01 skip
      904             v-waitfram-action02 skip
      905             v-waitfram-action03 skip
      906          with frame waitfram .
      907       if     mWaitFramView
      908          then do:
      909             if     mWaitFramInterval ne ?
      910                and not mBatchMode
      911             then
      912                wait-for go of frame waitfram pause mWaitFramInterval.
      913          end.
      914          else
      915             if     mWaitProcEvent
      916                and not mBatchMode
      917             then
      918                process events .
      919     end.
      920   end procedure.
      921      procedure waitfram-show-this:
      922         define input  parameter iInterval as int64 no-undo.
      923         define variable vtime as int64 no-undo.
      924         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      925         mWaitFramInterval = iInterval.
      926         run waitfram-show (substitute("&1&2 &3&4" ,
      927                                       mWaitFramTextBeg ,
      928                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      929                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      930                                       mWaitFramTextEnd
      931                                      )
      932                           ).
      933      end.
      934      procedure WaitFramRunPause:
      935         define input  parameter iInterval as dec no-undo.
      936         define variable vStart  as datetime-tz no-undo.
      937         define variable vend    as datetime-tz no-undo.
      938         define variable vint as int64 no-undo.
      939         define variable vOk as logical no-undo.
      940         vStart = now.
      941         vend   = vStart.
      942         publish "WaitFramPause" (iInterval,output vOk).
      943         vend   =  now.
      944         vint = vend - vStart.
      945         vint = iInterval - vint / 1000.
      946         if     not mWaitFramStop
      947            and (   vint > 0
      948                 or (    not vOk
      949                     and iInterval eq ?
      950                     )
      951                 )
      952         then
      953            run waitfram-show-this (iInterval).
      954         vend   =  now.
      955         vint = vend - vStart.
      956         vint = iInterval - vint / 1000.
      957         if     not mWaitFramStop
      958            and vint > 0
      959         then do:
      960            run gbl/pause.p (vint * 1000).
      961         end.
      962         if iInterval ne ?
      963         then
      964            publish "WaitFramStop".
      965         waitfram-check-timeout().
      966      end.
      967      procedure WaitFramWaitFor:
      968         define input  parameter iInterval as dec no-undo.
      969         assign
      970            mWaitFramStartProc   = now
      971            mWaitFramStopUser    = no
      972            mWaitFramStopTimeOut = no
      973         .
      974         block-wait:
      975         do while not mWaitFramStop:
      976            run WaitFramRunPause (iInterval).
      977            if  waitfram-check-timeout()
      978            then do:
      979               leave block-wait.
      980            end.
      981         end.
      982         run waitfram-hide.
      983      end.
      984   procedure waitfram-join :
      985     define input  parameter p-line-1  as character no-undo .
      986     define input  parameter p-line-2  as character no-undo .
      987     define input  parameter p-line-3  as character no-undo .
      988     define output parameter p-message as character no-undo .
      989     do
      990     on error undo, return error return-value
      991     :
      992       assign
      993         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      994                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      995                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      996       .
      997     end.
      998   end procedure.
      999   function waitfram-join-function returns character
     1000     (input p-line-1 as character
     1001     ,input p-line-2 as character
     1002     ,input p-line-3 as character
     1003     ).
     1004     define variable v-message as character no-undo .
     1005     run waitfram-join in this-procedure
     1006       (input  p-line-1
     1007       ,input  p-line-2
     1008       ,input  p-line-3
     1009       ,output v-message
     1010       ) .
     1011     return v-message .
     1012   end function .
     1013   function fnc-convert-dot-to-colon returns character
     1014       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1015   function fnc-convert-dot-to-colon returns character
     1016   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1017       define variable result as character no-undo.
     1018       define variable v-str-result as character no-undo.
     1019       if p-data = ? then p-data = 0 .
     1020       p-data = round(p-data, p-num).
     1021       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1022       return v-str-result.
     1023   END FUNCTION.
     1024   procedure placelib_write-attr:
     1025   define input  parameter p-code     like ub.place-attr.attr-code .
     1026   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1027   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1028   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1029   define input  parameter p-value    like ub.place-attr.attr-value .
     1030   define output parameter p-ok       as logical.
     1031   define buffer buf_place-attr for ub.place-attr .
     1032     do on error undo, return error return-value :
     1033        p-ok = false.
     1034        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1035                                                   and buf_place-attr.obj-code    = p-obj-code
     1036                                                   and buf_place-attr.obj-type    = p-obj-type
     1037                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1038        if not available buf_place-attr then do :
     1039           create buf_place-attr.
     1040           assign
     1041             buf_place-attr.attr-code   = p-code
     1042             buf_place-attr.attr-value  = p-value
     1043             buf_place-attr.obj-code    = p-obj-code
     1044             buf_place-attr.obj-type    = p-obj-type
     1045             buf_place-attr.pl-code     = p-pl-code
     1046           .
     1047           p-ok = true.
     1048        end.
     1049        else do:
     1050           buf_place-attr.attr-value  = p-value .
     1051           p-ok = true.
     1052        end.
     1053     end.
     1054   end.
     1055   procedure placelib_get-attr:
     1056   define input  parameter  p-code     like ub.place-attr.attr-code .
     1057   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1058   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1059   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1060   define output parameter  p-value    like ub.place-attr.attr-value .
     1061   define output parameter  p-ok       as logical.
     1062   define buffer buf_place-attr for ub.place-attr .
     1063     do on error undo, return error return-value :
     1064        p-ok = false.
     1065        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1066                                                   and buf_place-attr.obj-code    = p-obj-code
     1067                                                   and buf_place-attr.obj-type    = p-obj-type
     1068                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1069        if available buf_place-attr then do :
     1070          p-value = buf_place-attr.attr-value.
     1071          p-ok = true.
     1072        end.
     1073        else do :
     1074          p-ok = false.
     1075        end.
     1076     end.
     1077   end.
     1078   procedure placelib_del-attr:
     1079   define input parameter  p-code     like ub.place-attr.attr-code .
     1080   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1081   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1082   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1083   define input parameter  p-value    like ub.place-attr.attr-value .
     1084   define output parameter p-ok       as logical.
     1085   define buffer buf_place-attr for ub.place-attr .
     1086     do on error undo, return error return-value :
     1087        p-ok = false.
     1088        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1089                                                   and buf_place-attr.obj-code    = p-obj-code
     1090                                                   and buf_place-attr.obj-type    = p-obj-type
     1091                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1092        if available buf_place-attr then do :
     1093           delete buf_place-attr.
     1094           p-ok = true.
     1095        end.
     1096     end.
     1097   end.
     1098   define variable is-petrol   as logical   no-undo.
     1099   define variable is-pieces   as logical   no-undo.
     1100   define variable store-name as character no-undo.
     1101   define variable v-count as integer initial 0  no-undo .
     1102   define variable v-full-path-RepView as character no-undo.
     1103   define variable v-file-name-rep-htm as character no-undo.
     1104   define variable g#report-num        as integer   no-undo.
     1105   define variable v-report-name       as character no-undo.
     1106   define variable v-azk-list          as character no-undo .
     1107   define variable v-org-list          as character no-undo .
     1108   define variable v-legend1           as character no-undo .
     1109   define variable v-legend2           as character no-undo .
     1110   define variable v-legend3           as character no-undo .
     1111   define variable v-legend4           as character no-undo .
     1112   define stream OutStr-html.
     1113   define buffer bf-gds-list for gds-list .
     1114   define buffer buf_clients for ub.clients .
     1115   define buffer buf_goods for ub.goods .
     1116   define buffer buf_units for ub.units  .
     1117   define BUFFER bf_c-user-log for ub.c-user-log .
     1118   define temp-table tt-report no-undo
     1119     field firm-name     as character
     1120     field obj-type      as character
     1121     field obj-code      as integer
     1122     field host-code     as integer
     1123     field obj-name      as character
     1124     field pl-code       as integer
     1125     field loc1          as character
     1126     field pl-name       as character
     1127     field gds-code      as integer
     1128     field gds-name      as character
     1129     field corr-dt       as character
     1130     field corr-date     as date
     1131     field corr-time     as int64
     1132     field rvd-reason    as character
     1133     field rvd-reason-code as character
     1134     field pl-state      as character
     1135     field corr-period   as character
     1136     field shift-num     as character
     1137     field ITSM-num      as character
     1138     field executor      as character
     1139     field initiator     as character
     1140     field rvd-par       as character
     1141     field rvd-dens      as logical
     1142     field rvd-level     as logical
     1143     field rvd-temp      as logical
     1144     field is-copy       as logical
     1145   .
     1146   if not can-find( first obj-list ) then do:
     1147     message "Вы не выбрали объект." view-as alert-box error.
     1148     return.
     1149   end.
     1150   find first obj-list.
     1151   if not can-find( first gds-list )
     1152   then do:
     1153     for each buf_units no-lock where
     1154           lookup( 'топ':U, buf_units.type) > 0,
     1155       each buf_goods no-lock where
     1156             buf_goods.unit-base = buf_units.unit-name
     1157             :
     1158       create gds-list.
     1159       buffer-copy buf_goods to  gds-list .
     1160     end.
     1161   end.
     1162   find first gds-list.
     1163   for each bf-gds-list :
     1164     find first ub.goods no-lock where
     1165                 ub.goods.artic     = bf-gds-list.artic     and
     1166                 ub.goods.prod-type = bf-gds-list.prod-type and
     1167                 ub.goods.prod-code = bf-gds-list.prod-code no-error.
     1168     if not available ub.goods then do: next. end.
     1169   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1170     (
     1171        input ub.goods.artic
     1172     ,  input ub.goods.prod-type
     1173     ,  input ub.goods.prod-code
     1174     , output is-petrol
     1175     , output is-pieces
     1176     ) no-error.
     1177     if error-status :error
     1178       or is-petrol <> yes
     1179       or is-pieces <> no
     1180     then do:
     1181       message
     1182         substitute("Отчет может быть запущен только для топливного товара") skip
     1183         view-as alert-box error .
     1184       return .
     1185     end.
     1186   end.
     1187   run waitfram-show in this-procedure ( "ЖДИТЕ... Формирование отчёта") .
     1188   v-legend1 = "А – автоматический ввод данных (Если в системе установлен маркер «Измеряется приборами» и РВД по параметрам отключен)" .
     1189   v-legend2 = "Р – ручной ввод данных (Если в системе не установлен маркер «Измеряется приборами или в системе установлен маркер «Измеряется приборами», но разрешение РВД установлено для всех трех парамет-ров»)" .
     1190   v-legend3 = "ПА – полуавтоматический ввод данных (Если в системе установлен маркер «Измеряется приборами», но разрешение РВД установлено для одного или двух параметров)" .
     1191   v-legend4 = "Ограничение: Актуальность данных отчета соответствует дате и времени формирования отчёта." .
     1192   case p-rep-type :
     1193     when 1 then run make-rep .
     1194     when 2 then run make-rep-ext .
     1195   end case .
     1196   run waitfram-hide in this-procedure .
     1197   case p-rep-type :
     1198     when 1 then run print-rep .
     1199     when 2 then run print-rep-ext .
     1200   end case .
     1201   procedure make-rep :
     1202     define variable v-RVD-dens  as logical no-undo .
     1203     define variable v-RVD-temp  as logical no-undo .
     1204     define variable v-RVD-level as logical no-undo .
     1205     define variable v-host-code as integer no-undo .
     1206     define variable v-gds-code  as integer no-undo .
     1207     define buffer buf_place for ub.place .
     1208     define buffer buf_pl-gds for ub.pl-gds .
     1209     define buffer buf_place-attr for ub.place-attr .
     1210     define buffer buf_goods for ub.goods .
     1211     define buffer buf_clients for ub.clients .
     1212     define buffer buf2_clients for ub.clients .
     1213     empty temp-table tt-report .
     1214     v-org-list = "" .
     1215     v-azk-list = "" .
     1216     for each buf_clients no-lock,
     1217     first obj-list no-lock where obj-list.obj-type = buf_clients.obj-type
     1218                              and obj-list.obj-code = buf_clients.obj-code
     1219                              break by buf_clients.host-code
     1220                              :
     1221       if first-of(buf_clients.host-code)
     1222       then do :
     1223         for first buf2_clients no-lock where buf2_clients.obj-type = 'орг':U
     1224                                          and buf2_clients.obj-code = buf_clients.host-code
     1225                                          :
     1226           v-org-list = v-org-list + buf2_clients.obj-name + ", " .
     1227         end .
     1228       end .
     1229     end .
     1230     v-org-list = trim(v-org-list, ", ") .
     1231     for each obj-list no-lock break by obj-list.obj-code :
     1232       v-azk-list = v-azk-list + obj-list.obj-name + ", " .
     1233       place_ :
     1234       for each buf_place no-lock where buf_place.obj-type = obj-list.obj-type
     1235                                    and buf_place.obj-code = obj-list.obj-code
     1236                                    and buf_place.status_  = ""
     1237                                    :
     1238         for first buf_pl-gds no-lock where buf_pl-gds.obj-type  = buf_place.obj-type
     1239                                        and buf_pl-gds.obj-code  = buf_place.obj-code
     1240                                        and buf_pl-gds.pl-code   = buf_place.pl-code
     1241                                        :
     1242           v-gds-code = buf_pl-gds.gds-code .
     1243           if not can-find( gds-list where gds-list.gds-code = buf_pl-gds.gds-code )
     1244           then next place_ .
     1245         end .
     1246         for first buf_place-attr no-lock where buf_place-attr.obj-type  = buf_place.obj-type
     1247                                            and buf_place-attr.obj-code  = buf_place.obj-code
     1248                                            and buf_place-attr.pl-code   = buf_place.pl-code
     1249                                            and buf_place-attr.attr-code = "place-rvd-dnsty"
     1250                                            :
     1251           assign v-RVD-dens = logical(buf_place-attr.attr-value) .
     1252         end .
     1253         for first buf_place-attr no-lock where buf_place-attr.obj-type  = buf_place.obj-type
     1254                                            and buf_place-attr.obj-code  = buf_place.obj-code
     1255                                            and buf_place-attr.pl-code   = buf_place.pl-code
     1256                                            and buf_place-attr.attr-code = "place-rvd-lvl"
     1257                                            :
     1258           assign v-RVD-level = logical(buf_place-attr.attr-value) .
     1259         end .
     1260         for first buf_place-attr no-lock where buf_place-attr.obj-type  = buf_place.obj-type
     1261                                            and buf_place-attr.obj-code  = buf_place.obj-code
     1262                                            and buf_place-attr.pl-code   = buf_place.pl-code
     1263                                            and buf_place-attr.attr-code = "place-rvd-tmp"
     1264                                            :
     1265           assign v-RVD-temp = logical(buf_place-attr.attr-value) .
     1266         end .
     1267         create tt-report .
     1268         assign
     1269           tt-report.obj-type  = buf_place.obj-type
     1270           tt-report.obj-code  = buf_place.obj-code
     1271           tt-report.pl-code   = buf_place.pl-code
     1272           tt-report.pl-name   = buf_place.pl-name
     1273           tt-report.loc1      = buf_place.loc1
     1274           tt-report.gds-code  = v-gds-code
     1275           tt-report.rvd-dens  = v-RVD-dens
     1276           tt-report.rvd-level = v-RVD-level
     1277           tt-report.rvd-temp  = v-RVD-temp
     1278         .
     1279         for first buf_clients no-lock where buf_clients.obj-type = tt-report.obj-type
     1280                                         and buf_clients.obj-code = tt-report.obj-code
     1281                                         :
     1282           assign
     1283             v-host-code = buf_clients.host-code
     1284             tt-report.obj-name = buf_clients.obj-name
     1285             tt-report.host-code = buf_clients.host-code
     1286           .
     1287         end .
     1288         for first buf_clients no-lock where buf_clients.obj-type = 'орг':U
     1289                                         and buf_clients.obj-code = v-host-code
     1290                                         :
     1291           assign tt-report.firm-name = buf_clients.obj-name .
     1292         end .
     1293         for first buf_goods no-lock where buf_goods.gds-code = tt-report.gds-code :
     1294           assign tt-report.gds-name = buf_goods.gds-name .
     1295         end .
     1296         if (v-RVD-dens
     1297         and v-RVD-level
     1298         and v-RVD-temp)
     1299         or
     1300         (not buf_place.is-meas)
     1301         then do :
     1302           assign tt-report.pl-state = "Р" .
     1303         end .
     1304         else
     1305         if not v-RVD-dens
     1306         and not v-RVD-level
     1307         and not v-RVD-temp
     1308         then do :
     1309           assign tt-report.pl-state = "А" .
     1310         end .
     1311         else
     1312         if v-RVD-dens
     1313         and v-RVD-level
     1314         and not v-RVD-temp
     1315         then do :
     1316           assign tt-report.pl-state = "ПА(Уровень, Плотность)" .
     1317         end .
     1318         else
     1319         if v-RVD-dens
     1320         and not v-RVD-level
     1321         and v-RVD-temp
     1322         then do :
     1323           assign tt-report.pl-state = "ПА(Температура, Плотность)" .
     1324         end .
     1325         else
     1326         if not v-RVD-dens
     1327         and v-RVD-level
     1328         and v-RVD-temp
     1329         then do :
     1330           assign tt-report.pl-state = "ПА(Уровень, Температура)" .
     1331         end .
     1332         else
     1333         if v-RVD-dens
     1334         and not v-RVD-level
     1335         and not v-RVD-temp
     1336         then do :
     1337           assign tt-report.pl-state = "ПА(Плотность)" .
     1338         end .
     1339         else
     1340         if not v-RVD-dens
     1341         and v-RVD-level
     1342         and not v-RVD-temp
     1343         then do :
     1344           assign tt-report.pl-state = "ПА(Уровень)" .
     1345         end .
     1346         else
     1347         if not v-RVD-dens
     1348         and not v-RVD-level
     1349         and v-RVD-temp
     1350         then do :
     1351           assign tt-report.pl-state = "ПА(Температура)" .
     1352         end .
     1353       end .
     1354     end .
     1355     v-azk-list = trim(v-azk-list, ", ") .
     1356     for each tt-report :
     1357       if p-rvd-on
     1358       and not p-rvd-off
     1359       then do :
     1360         if p-dens
     1361         and not tt-report.rvd-dens
     1362         then
     1363           delete tt-report .
     1364         else
     1365         if p-level
     1366         and not tt-report.rvd-level
     1367         then
     1368           delete tt-report .
     1369         else
     1370         if p-temp
     1371         and not tt-report.rvd-temp
     1372         then
     1373           delete tt-report .
     1374       end .
     1375       else
     1376       if p-rvd-off
     1377       and not p-rvd-on
     1378       then do :
     1379         if p-dens
     1380         and tt-report.rvd-dens
     1381         then
     1382           delete tt-report .
     1383         else
     1384         if p-level
     1385         and tt-report.rvd-level
     1386         then
     1387           delete tt-report .
     1388         else
     1389         if p-temp
     1390         and tt-report.rvd-temp
     1391         then
     1392           delete tt-report .
     1393       end .
     1394     end .
     1395   end procedure .
     1396   procedure print-rep :
     1397     run gbl/getrpnum.p (output g#report-num).
     1398     run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1399     run create-file(v-file-name-rep-htm).
     1400     if x-SelectObject = "firm":U
     1401     or x-SelectObject = 'все':U
     1402     then do :
     1403       v-azk-list = "ВСЕ" .
     1404     end .
     1405     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1406     put stream OutStr-html unformatted
     1407         "<!DOCTYPE HTML>" skip
     1408         ' <html>' skip
     1409         '  <head>' skip
     1410         '   <meta charset="utf-8">' skip
     1411         '    <style type="text/css">' skip
     1412         '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 500px; padding: 3px; ' + chr(125) skip
     1413         '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     1414         '      htm' skip
     1415         '      .rotate ' + chr(123) skip
     1416         '        -webkit-transform: rotate(-90deg);' skip
     1417         '        -moz-transform: rotate(-90deg);' skip
     1418         '        -ms-transform: rotate(-90deg);' skip
     1419         '        -o-transform: rotate(-90deg);' skip
     1420         '        transform: rotate(-90deg);' skip
     1421         '        -webkit-transform-origin: 50% 50%;' skip
     1422         '        -moz-transform-origin: 50% 50%;' skip
     1423         '        -ms-transform-origin: 50% 50%;' skip
     1424         '        -o-transform-origin: 50% 50%;' skip
     1425         '        transform-origin: 50% 50%;' skip
     1426         '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     1427         '          ' + chr(125) skip
     1428         '            th' + ' ' + chr(123) skip
     1429         '            border: 1px black solid;' skip
     1430         '            word-wrap: break-word;' skip
     1431         '          ' + chr(125) skip
     1432         '   </style>' skip
     1433         '  </head>' skip
     1434     .
     1435     put stream OutStr-html unformatted
     1436         '<body>' skip
     1437         '<table name="Лист1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1438         '<thead>' skip
     1439     .
     1440     put stream OutStr-html unformatted
     1441         '<tr class="set_columns">' skip
     1442         '<td style="width: 60px; border: none;"></td>' skip
     1443         '<td style="width: 60px; border: none;"></td>' skip
     1444         '<td style="width: 65px; border: none;"></td>' skip
     1445         '<td style="width: 65px; border: none;"></td>' skip
     1446         '<td style="width: 90px; border: none;"></td>' skip
     1447         '<td style="width: 100px; border: none;"></td>' skip
     1448         '</tr>' skip
     1449     .
     1450     put stream OutStr-html unformatted
     1451         '<tr>' skip
     1452         '<td colspan="6" style="text-align: left; font-weight:bold;"></td>' skip
     1453         '</tr>' skip
     1454         '<tr>' skip
     1455         '<td colspan="5" style="text-align: left; font-weight:bold;">Стандартный вариант отчёта "Состояние изменения режима ввода данных по резервуарам"</td>' skip
     1456         '<td colspan="9" style="text-align: left;;">' + v-legend1 + '</td>' skip
     1457         '</tr>' skip
     1458         '<tr>' skip
     1459         '<td colspan="5" style="text-align: left; font-weight:bold;">Организация: ' + v-org-list + '</td>' skip
     1460         '<td colspan="9" style="text-align: left;">' + v-legend2 + '</td>' skip
     1461         '</tr>' skip
     1462         '<tr>' skip
     1463         '<td colspan="5" style="text-align: left; font-weight:bold;">Выбор Объекта: ' + v-azk-list + '</td>' skip
     1464         '<td colspan="9" style="text-align: left;">' + v-legend3 + '</td>' skip
     1465         '</tr>' skip
     1466         '<tr>' skip
     1467         '<td colspan="5" style="text-align: left; font-weight:bold;">Дата печати: ' + string(today) + ' Время: ' + string(time, "hh:mm:ss") + '</td>' skip
     1468         '<td colspan="9" style="text-align: left;">' + v-legend4 + '</td>' skip
     1469         '</tr>' skip
     1470         '</thead>' skip
     1471     .
     1472     put stream OutStr-html unformatted
     1473         '     <tbody>' skip
     1474         '       <tr>' skip
     1475         '         <th style="text-align: center; font-weight:bold; background-color: silver;">ПНПО</th>' skip
     1476         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование объекта (АЗК/АЗС)</th>' skip
     1477         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Номер резервуара</th>' skip
     1478         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование резервуара</th>' skip
     1479         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование НП в резервуаре</th>' skip
     1480         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Текущее состояние РВД/АВД резервуара</th>' skip
     1481         '       </tr>' skip
     1482         '       <tr>' skip
     1483         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1</th>' skip
     1484         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">2</th>' skip
     1485         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">3</th>' skip
     1486         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">4</th>' skip
     1487         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">5</th>' skip
     1488         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">6</th>' skip
     1489         '       </tr>' skip
     1490     .
     1491     for each tt-report break by tt-report.host-code
     1492                              by tt-report.obj-code
     1493                              by tt-report.pl-code
     1494                              :
     1495       put stream OutStr-html unformatted
     1496         '     <tbody>' skip
     1497         '       <tr>' skip
     1498         '         <th style="text-align: center;">' + tt-report.firm-name + '</th>' skip
     1499         '         <th style="text-align: center;">' + tt-report.obj-name + '</th>' skip
     1500         '         <th style="text-align: center;">' + tt-report.loc1 + '</th>' skip
     1501         '         <th style="text-align: center;">' + tt-report.pl-name + '</th>' skip
     1502         '         <th style="text-align: center;">' + tt-report.gds-name + '</th>' skip
     1503         '         <th style="text-align: center;">' + tt-report.pl-state + '</th>' skip
     1504         '       </tr>' skip
     1505       .
     1506     end .
     1507     put stream OutStr-html unformatted
     1508         '     </tbody>' skip
     1509         '   </table>' skip
     1510         '  </body>' skip
     1511         ' </html>' skip
     1512         .
     1513     output stream OutStr-html close.
     1514     run prn-lib-reportviewer-report-name in this-procedure (
     1515         input this-procedure
     1516         ,input v-file-name-rep-htm
     1517         ) no-error.
     1518     if error-status:error then
     1519     do:
     1520         message return-value view-as alert-box.
     1521         return .
     1522     end.
     1523   end procedure .
     1524   procedure make-rep-ext :
     1525     define variable v-shift-num as integer no-undo .
     1526     define variable v-shift-date as date no-undo .
     1527     define variable v-obj-type  as character no-undo .
     1528     define variable v-obj-code  as integer no-undo .
     1529     define variable v-pl-code   as integer no-undo .
     1530     define variable v-rvd-reason-code as character no-undo .
     1531     define variable v-host-code as integer no-undo .
     1532     define variable v-RVD-on    as logical no-undo .
     1533     define variable v-RVD-params as character no-undo .
     1534     define variable v-RVD-dens  as logical no-undo .
     1535     define variable v-RVD-temp  as logical no-undo .
     1536     define variable v-RVD-level as logical no-undo .
     1537     define variable v-date1 as date no-undo .
     1538     define variable v-date2 as date no-undo .
     1539     define variable v-date-diff as integer no-undo .
     1540     define variable v-time1 as integer no-undo .
     1541     define variable v-time2 as integer no-undo .
     1542     define variable v-time-diff as integer no-undo .
     1543     define variable v-gds-code  as integer no-undo .
     1544     define variable v-found-next as logical no-undo .
     1545     define buffer buf_pl-gds for ub.pl-gds .
     1546     define buffer buf_ext-classif for ub.ext-classif .
     1547     define buffer buf_place for ub.place .
     1548     define buffer buf_place-attr for ub.place-attr .
     1549     define buffer buf_goods for ub.goods .
     1550     define buffer buf_user-account for ub.user-account .
     1551     define buffer buf_c-user-log for ub.c-user-log .
     1552     define buffer buf_tt-report for tt-report .
     1553     define buffer buf_clients for ub.clients .
     1554     define buffer buf2_clients for ub.clients .
     1555     empty temp-table tt-report .
     1556     v-date2 = today .
     1557     v-time2 = time .
     1558     v-org-list = "" .
     1559     v-azk-list = "" .
     1560     for each buf_clients no-lock,
     1561     first obj-list no-lock where obj-list.obj-type = buf_clients.obj-type
     1562                              and obj-list.obj-code = buf_clients.obj-code
     1563                              break by buf_clients.host-code
     1564                              :
     1565       if first-of(buf_clients.host-code)
     1566       then do :
     1567         for first buf2_clients no-lock where buf2_clients.obj-type = 'орг':U
     1568                                          and buf2_clients.obj-code = buf_clients.host-code
     1569                                          :
     1570           v-org-list = v-org-list + buf2_clients.obj-name + ", " .
     1571         end .
     1572       end .
     1573     end .
     1574     v-org-list = trim(v-org-list, ", ") .
     1575     for each obj-list no-lock break by obj-list.obj-code :
     1576       v-azk-list = v-azk-list + obj-list.obj-name + ", " .
     1577       place_ :
     1578       for each buf_place no-lock where buf_place.obj-type = obj-list.obj-type
     1579                                    and buf_place.obj-code = obj-list.obj-code
     1580                                    and buf_place.status_  = ""
     1581                                    :
     1582         for first buf_pl-gds no-lock where buf_pl-gds.obj-type  = buf_place.obj-type
     1583                                        and buf_pl-gds.obj-code  = buf_place.obj-code
     1584                                        and buf_pl-gds.pl-code   = buf_place.pl-code
     1585                                        :
     1586           v-gds-code = buf_pl-gds.gds-code .
     1587           if not can-find( gds-list where gds-list.gds-code = buf_pl-gds.gds-code )
     1588           then next place_ .
     1589         end .
     1590         for first buf_place-attr no-lock where buf_place-attr.obj-type  = buf_place.obj-type
     1591                                            and buf_place-attr.obj-code  = buf_place.obj-code
     1592                                            and buf_place-attr.pl-code   = buf_place.pl-code
     1593                                            and buf_place-attr.attr-code = "place-rvd-dnsty"
     1594                                            :
     1595           assign v-RVD-dens = logical(buf_place-attr.attr-value) .
     1596         end .
     1597         for first buf_place-attr no-lock where buf_place-attr.obj-type  = buf_place.obj-type
     1598                                            and buf_place-attr.obj-code  = buf_place.obj-code
     1599                                            and buf_place-attr.pl-code   = buf_place.pl-code
     1600                                            and buf_place-attr.attr-code = "place-rvd-lvl"
     1601                                            :
     1602           assign v-RVD-level = logical(buf_place-attr.attr-value) .
     1603         end .
     1604         for first buf_place-attr no-lock where buf_place-attr.obj-type  = buf_place.obj-type
     1605                                            and buf_place-attr.obj-code  = buf_place.obj-code
     1606                                            and buf_place-attr.pl-code   = buf_place.pl-code
     1607                                            and buf_place-attr.attr-code = "place-rvd-tmp"
     1608                                            :
     1609           assign v-RVD-temp = logical(buf_place-attr.attr-value) .
     1610         end .
     1611         create tt-report .
     1612         assign
     1613           tt-report.obj-type  = buf_place.obj-type
     1614           tt-report.obj-code  = buf_place.obj-code
     1615           tt-report.pl-code   = buf_place.pl-code
     1616           tt-report.pl-name   = buf_place.pl-name
     1617           tt-report.loc1      = buf_place.loc1
     1618           tt-report.gds-code  = v-gds-code
     1619           tt-report.rvd-dens  = v-RVD-dens
     1620           tt-report.rvd-level = v-RVD-level
     1621           tt-report.rvd-temp  = v-RVD-temp
     1622         .
     1623         for first buf_clients no-lock where buf_clients.obj-type = tt-report.obj-type
     1624                                         and buf_clients.obj-code = tt-report.obj-code
     1625                                         :
     1626           assign
     1627             v-host-code = buf_clients.host-code
     1628             tt-report.obj-name = buf_clients.obj-name
     1629             tt-report.host-code = buf_clients.host-code
     1630           .
     1631         end .
     1632         for first buf_clients no-lock where buf_clients.obj-type = 'орг':U
     1633                                         and buf_clients.obj-code = v-host-code
     1634                                         :
     1635           assign tt-report.firm-name = buf_clients.obj-name .
     1636         end .
     1637         for first buf_goods no-lock where buf_goods.gds-code = tt-report.gds-code :
     1638           assign tt-report.gds-name = buf_goods.gds-name .
     1639         end .
     1640         if (v-RVD-dens
     1641         and v-RVD-level
     1642         and v-RVD-temp)
     1643         or
     1644         (not buf_place.is-meas)
     1645         then do :
     1646           assign tt-report.pl-state = "Р" .
     1647         end .
     1648         else
     1649         if not v-RVD-dens
     1650         and not v-RVD-level
     1651         and not v-RVD-temp
     1652         then do :
     1653           assign tt-report.pl-state = "А" .
     1654         end .
     1655         else
     1656         if v-RVD-dens
     1657         and v-RVD-level
     1658         and not v-RVD-temp
     1659         then do :
     1660           assign tt-report.pl-state = "ПА(Уровень, Плотность)" .
     1661         end .
     1662         else
     1663         if v-RVD-dens
     1664         and not v-RVD-level
     1665         and v-RVD-temp
     1666         then do :
     1667           assign tt-report.pl-state = "ПА(Температура, Плотность)" .
     1668         end .
     1669         else
     1670         if not v-RVD-dens
     1671         and v-RVD-level
     1672         and v-RVD-temp
     1673         then do :
     1674           assign tt-report.pl-state = "ПА(Уровень, Температура)" .
     1675         end .
     1676         else
     1677         if v-RVD-dens
     1678         and not v-RVD-level
     1679         and not v-RVD-temp
     1680         then do :
     1681           assign
     1682             tt-report.pl-state = "ПА(Плотность)"
     1683             tt-report.rvd-par = "Плотность"
     1684           .
     1685         end .
     1686         else
     1687         if not v-RVD-dens
     1688         and v-RVD-level
     1689         and not v-RVD-temp
     1690         then do :
     1691           assign
     1692             tt-report.pl-state = "ПА(Уровень)"
     1693             tt-report.rvd-par = "Уровень"
     1694           .
     1695         end .
     1696         else
     1697         if not v-RVD-dens
     1698         and not v-RVD-level
     1699         and v-RVD-temp
     1700         then do :
     1701           assign
     1702             tt-report.pl-state = "ПА(Температура)"
     1703             tt-report.rvd-par = "Температура"
     1704           .
     1705         end .
     1706       end .
     1707     end .
     1708     v-azk-list = trim(v-azk-list, ", ") .
     1709     for each tt-report where tt-report.pl-state = "ПА(Уровень, Плотность)"
     1710                           or tt-report.pl-state = "ПА(Температура, Плотность)"
     1711                           or tt-report.pl-state = "ПА(Уровень, Температура)"
     1712                           :
     1713       if tt-report.is-copy
     1714       then next .
     1715       create buf_tt-report .
     1716       buffer-copy tt-report to buf_tt-report .
     1717       case tt-report.pl-state :
     1718         when "ПА(Уровень, Плотность)"
     1719         then do :
     1720           tt-report.rvd-par = "Уровень" .
     1721           buf_tt-report.rvd-par = "Плотность" .
     1722         end .
     1723         when "ПА(Температура, Плотность)"
     1724         then do :
     1725           tt-report.rvd-par = "Температура" .
     1726           buf_tt-report.rvd-par = "Плотность" .
     1727         end .
     1728         when "ПА(Уровень, Температура)"
     1729         then do :
     1730           tt-report.rvd-par = "Уровень" .
     1731           buf_tt-report.rvd-par = "Температура" .
     1732         end .
     1733       end case .
     1734       tt-report.is-copy = yes .
     1735       buf_tt-report.is-copy = yes .
     1736     end .
     1737     for each tt-report :
     1738       user-log_ :
     1739       for each bf_c-user-log no-lock where bf_c-user-log.head-table = 'rvd-reasons':U
     1740                                      break by bf_c-user-log.corr-date desc by bf_c-user-log.corr-time desc
     1741                                      :
     1742         if num-entries(bf_c-user-log.head-table-key, chr(6)) = 23
     1743         then next user-log_ .
     1744         v-shift-date = date(entry(3, bf_c-user-log.head-table-key, chr(6))) .
     1745         v-shift-num = integer(entry(4, bf_c-user-log.head-table-key, chr(6))) .
     1746         v-obj-type = entry(1, bf_c-user-log.head-table-key, chr(6)) .
     1747         v-obj-code = integer(entry(2, bf_c-user-log.head-table-key, chr(6))) .
     1748         if not (v-obj-type = tt-report.obj-type and v-obj-code = tt-report.obj-code) then next user-log_ .
     1749         v-pl-code = integer(entry(5, bf_c-user-log.head-table-key, chr(6))) .
     1750         if not (v-pl-code = tt-report.pl-code) then next user-log_ .
     1751         v-RVD-params = entry(6, bf_c-user-log.head-table-key, chr(6)) .
     1752         if tt-report.rvd-par = "Уровень"
     1753         and not can-do(v-RVD-params, 'l')
     1754         then next user-log_ .
     1755         if tt-report.rvd-par = "Температура"
     1756         and not can-do(v-RVD-params, 'T')
     1757         then next user-log_ .
     1758         if tt-report.rvd-par = "Плотность"
     1759         and not can-do(v-RVD-params, 'p')
     1760         then next user-log_ .
     1761         v-rvd-reason-code = entry(8, bf_c-user-log.head-table-key, chr(6)) .
     1762         find first buf_ext-classif no-lock where buf_ext-classif.CharKey_One = v-rvd-reason-code
     1763                                              and buf_ext-classif.classif-subject = 'rvd-reason':U
     1764                                              and buf_ext-classif.classif-name = 'rvd-reason':U
     1765                                              no-error .
     1766         if not available buf_ext-classif
     1767         then next user-log_ .
     1768         for first buf_user-account no-lock where buf_user-account.user-id = bf_c-user-log.corr-user-name :
     1769           assign tt-report.executor = buf_user-account.nik .
     1770         end .
     1771         assign
     1772           tt-report.rvd-reason  = buf_ext-classif.CharKey_Two
     1773           tt-report.rvd-reason-code = entry(8, bf_c-user-log.head-table-key, chr(6))
     1774           tt-report.corr-date   = bf_c-user-log.corr-date
     1775           tt-report.corr-time   = bf_c-user-log.corr-time
     1776           tt-report.corr-dt     = string(bf_c-user-log.corr-date, "99.99.9999") + " " + string(bf_c-user-log.corr-time, "hh:mm")
     1777           tt-report.corr-dt     = replace(tt-report.corr-dt, ":", "-")
     1778           tt-report.shift-num   = string(v-shift-num)
     1779           tt-report.ITSM-num    = entry(9, bf_c-user-log.head-table-key, chr(6))
     1780           tt-report.initiator   = entry(10, bf_c-user-log.head-table-key, chr(6))
     1781         .
     1782         v-date1 = bf_c-user-log.corr-date .
     1783         v-time1 = bf_c-user-log.corr-time .
     1784         v-date-diff = v-date2 - v-date1 .
     1785         v-time-diff = v-time2 - v-time1 .
     1786         if v-time-diff < 0
     1787         then do :
     1788           v-date-diff = v-date-diff - 1 .
     1789           v-time-diff = v-time-diff + 86400 .
     1790         end .
     1791         assign tt-report.corr-period = string(v-date-diff) + "д. " + string(v-time-diff, "hh:mm:ss") .
     1792         leave user-log_ .
     1793       end .
     1794     end .
     1795     for each tt-report :
     1796       if p-rvd-on
     1797       and not p-rvd-off
     1798       then do :
     1799         if p-dens
     1800         and not tt-report.rvd-dens
     1801         then
     1802           delete tt-report .
     1803         else
     1804         if p-level
     1805         and not tt-report.rvd-level
     1806         then
     1807           delete tt-report .
     1808         else
     1809         if p-temp
     1810         and not tt-report.rvd-temp
     1811         then
     1812           delete tt-report .
     1813       end .
     1814       else
     1815       if p-rvd-off
     1816       and not p-rvd-on
     1817       then do :
     1818         if p-dens
     1819         and tt-report.rvd-dens
     1820         then
     1821           delete tt-report .
     1822         else
     1823         if p-level
     1824         and tt-report.rvd-level
     1825         then
     1826           delete tt-report .
     1827         else
     1828         if p-temp
     1829         and tt-report.rvd-temp
     1830         then
     1831           delete tt-report .
     1832       end .
     1833     end .
     1834     if p-rvd-reason-list > ""
     1835     then do :
     1836       for each tt-report :
     1837         if not can-do(p-rvd-reason-list, tt-report.rvd-reason-code)
     1838         then
     1839           delete tt-report .
     1840       end .
     1841     end .
     1842   end procedure .
     1843   procedure print-rep-ext :
     1844     run gbl/getrpnum.p (output g#report-num).
     1845     run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1846     run create-file(v-file-name-rep-htm).
     1847     if x-SelectObject = "firm":U
     1848     or x-SelectObject = 'все':U
     1849     then do :
     1850       v-azk-list = "ВСЕ" .
     1851     end .
     1852     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1853     put stream OutStr-html unformatted
     1854         "<!DOCTYPE HTML>" skip
     1855         ' <html>' skip
     1856         '  <head>' skip
     1857         '   <meta charset="utf-8">' skip
     1858         '    <style type="text/css">' skip
     1859         '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 500px; padding: 3px; ' + chr(125) skip
     1860         '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     1861         '      htm' skip
     1862         '      .rotate ' + chr(123) skip
     1863         '        -webkit-transform: rotate(-90deg);' skip
     1864         '        -moz-transform: rotate(-90deg);' skip
     1865         '        -ms-transform: rotate(-90deg);' skip
     1866         '        -o-transform: rotate(-90deg);' skip
     1867         '        transform: rotate(-90deg);' skip
     1868         '        -webkit-transform-origin: 50% 50%;' skip
     1869         '        -moz-transform-origin: 50% 50%;' skip
     1870         '        -ms-transform-origin: 50% 50%;' skip
     1871         '        -o-transform-origin: 50% 50%;' skip
     1872         '        transform-origin: 50% 50%;' skip
     1873         '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     1874         '          ' + chr(125) skip
     1875         '            th' + ' ' + chr(123) skip
     1876         '            border: 1px black solid;' skip
     1877         '            word-wrap: break-word;' skip
     1878         '          ' + chr(125) skip
     1879         '   </style>' skip
     1880         '  </head>' skip
     1881     .
     1882     put stream OutStr-html unformatted
     1883         '<body>' skip
     1884         '<table name="Лист1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1885         '<thead>' skip
     1886     .
     1887     put stream OutStr-html unformatted
     1888         '<tr class="set_columns">' skip
     1889         '<td style="width: 60px; border: none;"></td>' skip
     1890         '<td style="width: 60px; border: none;"></td>' skip
     1891         '<td style="width: 65px; border: none;"></td>' skip
     1892         '<td style="width: 65px; border: none;"></td>' skip
     1893         '<td style="width: 90px; border: none;"></td>' skip
     1894         '<td style="width: 80px; border: none;"></td>' skip
     1895         '<td style="width: 80px; border: none;"></td>' skip
     1896         '<td style="width: 90px; border: none;"></td>' skip
     1897         '<td style="width: 80px; border: none;"></td>' skip
     1898         '<td style="width: 85px; border: none;"></td>' skip
     1899         '<td style="width: 80px; border: none;"></td>' skip
     1900         '<td style="width: 65px; border: none;"></td>' skip
     1901         '<td style="width: 65px; border: none;"></td>' skip
     1902         '<td style="width: 60px; border: none;"></td>' skip
     1903         '</tr>' skip
     1904     .
     1905     put stream OutStr-html unformatted
     1906         '<tr>' skip
     1907         '<td colspan="14" style="text-align: left; font-weight:bold;"></td>' skip
     1908         '</tr>' skip
     1909         '<tr>' skip
     1910         '<td colspan="5" style="text-align: left; font-weight:bold;">Развернутый вариант отчёта "Состояние изменения режима ввода данных по резервуарам"</td>' skip
     1911         '<td colspan="9" style="text-align: left;;">' + v-legend1 + '</td>' skip
     1912         '</tr>' skip
     1913         '<tr>' skip
     1914         '<td colspan="5" style="text-align: left; font-weight:bold;">Организация: ' + v-org-list + '</td>' skip
     1915         '<td colspan="9" style="text-align: left;">' + v-legend2 + '</td>' skip
     1916         '</tr>' skip
     1917         '<tr>' skip
     1918         '<td colspan="5" style="text-align: left; font-weight:bold;">Выбор Объекта: ' + v-azk-list + '</td>' skip
     1919         '<td colspan="9" style="text-align: left;">' + v-legend3 + '</td>' skip
     1920         '</tr>' skip
     1921         '<tr>' skip
     1922         '<td colspan="5" style="text-align: left; font-weight:bold;">Дата и время формирования отчёта: ' + string(today) + ', ' + string(time, "hh:mm:ss") + '</td>' skip
     1923         '<td colspan="9" style="text-align: left;">' + v-legend4 + '</td>' skip
     1924         '</tr>' skip
     1925         '</thead>' skip
     1926     .
     1927     put stream OutStr-html unformatted
     1928         '     <tbody>' skip
     1929         '       <tr>' skip
     1930         '         <th style="text-align: center; font-weight:bold; background-color: silver;">ПНПО</th>' skip
     1931         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование объекта (АЗК/АЗС)</th>' skip
     1932         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Номер резервуара</th>' skip
     1933         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование резервуара</th>' skip
     1934         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Наименование НП в резервуаре</th>' skip
     1935         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Дата/время изменения режима</th>' skip
     1936         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Длительность состояния по резервуару</th>' skip
     1937         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Текущее состояние РВД/АВД резервуара</th>' skip
     1938         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Параметр для РВД</th>' skip
     1939         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Причина перевода на РВД</th>' skip
     1940         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Смена</th>' skip
     1941         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Номер заявки ITSM</th>' skip
     1942         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Исполнитель заявки</th>' skip
     1943         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Инициатор заявки</th>' skip
     1944         '       </tr>' skip
     1945         '       <tr>' skip
     1946         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1</th>' skip
     1947         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">2</th>' skip
     1948         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">3</th>' skip
     1949         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">4</th>' skip
     1950         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">5</th>' skip
     1951         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">6</th>' skip
     1952         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">7</th>' skip
     1953         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">8</th>' skip
     1954         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">9</th>' skip
     1955         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">10</th>' skip
     1956         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">11</th>' skip
     1957         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">12</th>' skip
     1958         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">13</th>' skip
     1959         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">14</th>' skip
     1960         '       </tr>' skip
     1961     .
     1962     for each tt-report break by tt-report.host-code
     1963                              by tt-report.obj-code
     1964                              by tt-report.corr-date
     1965                              by tt-report.corr-time
     1966                              :
     1967       put stream OutStr-html unformatted
     1968         '     <tbody>' skip
     1969         '       <tr>' skip
     1970         '         <th style="text-align: center;">' + tt-report.firm-name + '</th>' skip
     1971         '         <th style="text-align: center;">' + tt-report.obj-name + '</th>' skip
     1972         '         <th style="text-align: center;">' + tt-report.loc1 + '</th>' skip
     1973         '         <th style="text-align: center;">' + tt-report.pl-name + '</th>' skip
     1974         '         <th style="text-align: center;">' + tt-report.gds-name + '</th>' skip
     1975         '         <th style="text-align: center;">' + tt-report.corr-dt + '</th>' skip
     1976         '         <th style="text-align: center;">' + tt-report.corr-period + '</th>' skip
     1977         '         <th style="text-align: center;">' + tt-report.pl-state + '</th>' skip
     1978         '         <th style="text-align: center;">' + tt-report.rvd-par + '</th>' skip
     1979         '         <th style="text-align: center;">' + tt-report.rvd-reason + '</th>' skip
     1980         '         <th style="text-align: center;">' + tt-report.shift-num + '</th>' skip
     1981         '         <th style="text-align: center;">' + tt-report.ITSM-num + '</th>' skip
     1982         '         <th style="text-align: center;">' + tt-report.executor + '</th>' skip
     1983         '         <th style="text-align: center;">' + tt-report.initiator + '</th>' skip
     1984         '       </tr>' skip
     1985       .
     1986     end .
     1987     put stream OutStr-html unformatted
     1988         '     </tbody>' skip
     1989         '   </table>' skip
     1990         '  </body>' skip
     1991         ' </html>' skip
     1992         .
     1993     output stream OutStr-html close.
     1994     run prn-lib-reportviewer-report-name in this-procedure (
     1995         input this-procedure
     1996         ,input v-file-name-rep-htm
     1997         ) no-error.
     1998     if error-status:error then
     1999     do:
     2000         message return-value view-as alert-box.
     2001         return .
     2002     end.
     2003   end procedure .
     2004   procedure define-full-path-Report:
     2005       define input parameter p-rep-num as integer no-undo.
     2006       define output parameter p-file-name-rep-htm as character no-undo.
     2007       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     2008   end procedure.
     2009   procedure create-file:
     2010       define input parameter p-file-name as character no-undo.
     2011       output to value(string(p-file-name)).
     2012       output close.
     2013   end procedure.
     2014   PROCEDURE write-to-log :
     2015   define input param p-str as char no-undo.
     2016   do
     2017   on error undo, return error
     2018   :
     2019      message
     2020         p-str
     2021         skip
     2022      view-as alert-box error.
     2023   end.
     2024   END PROCEDURE.
