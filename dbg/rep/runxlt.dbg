        1   block-level on error undo, throw.
        2   define input parameter p-data-file-list-name    as character        no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: runxlt.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: rep/runxlt.p $":U .
        8   define variable vss-description as character no-undo init "Печать в Excel по шаблону и списку файлов данных.".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
       69   procedure paramls-clear :
       70     define buffer buf_temp-param for temp-param .
       71     do
       72     on error undo, return error return-value
       73     :
       74       for each buf_temp-param
       75       on error undo, return error
       76       :
       77         delete buf_temp-param .
       78       end.
       79     end.
       80   end procedure.
       81   procedure paramls-write :
       82     define input  parameter p-code     as character no-undo .
       83     define input  parameter p-sub-code as character no-undo .
       84     define input  parameter p-value    as character no-undo .
       85     define buffer buf_temp-param for temp-param .
       86     do
       87     on error undo, return error return-value
       88     :
       89       find first buf_temp-param
       90         where buf_temp-param.param-code     = p-code
       91           and buf_temp-param.param-sub-code = p-sub-code
       92         no-error .
       93       if not available buf_temp-param then do:
       94         create buf_temp-param .
       95         assign
       96           buf_temp-param.param-code     = p-code
       97           buf_temp-param.param-sub-code = p-sub-code
       98         .
       99       end.
      100       assign
      101         buf_temp-param.param-value = p-value
      102       .
      103     end.
      104   end procedure.
      105   procedure paramls-read :
      106     define input  parameter p-code          as character no-undo .
      107     define input  parameter p-sub-code      as character no-undo .
      108     define input  parameter p-default-value as character no-undo .
      109     define output parameter p-value         as character no-undo .
      110     define buffer buf_temp-param for temp-param .
      111     do
      112     on error undo, return error return-value
      113     :
      114       find first buf_temp-param
      115         where buf_temp-param.param-code     = p-code
      116           and buf_temp-param.param-sub-code = p-sub-code
      117         no-error .
      118       if available buf_temp-param then do:
      119         assign
      120           p-value = buf_temp-param.param-value
      121         .
      122       end.
      123       else do:
      124         assign
      125           p-value = p-default-value
      126         .
      127       end.
      128     end.
      129   end procedure.
      130   procedure paramls-append :
      131     define input  parameter p-code     as character no-undo .
      132     define input  parameter p-sub-code as character no-undo .
      133     define input  parameter p-value    as character no-undo .
      134     define buffer buf_temp-param for temp-param .
      135     do
      136     on error undo, return error return-value
      137     :
      138       find first buf_temp-param
      139            where buf_temp-param.param-code     = p-code
      140              and buf_temp-param.param-sub-code = p-sub-code
      141         no-error .
      142       if not available buf_temp-param then do:
      143         create buf_temp-param .
      144         assign
      145           buf_temp-param.param-code     = p-code
      146           buf_temp-param.param-sub-code = p-sub-code
      147           buf_temp-param.param-value    = p-value
      148         .
      149       end.
      150       else do:
      151           assign
      152               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      153           .
      154       end.
      155     end.
      156   end procedure.
      157       define stream in-stream.
      158       define variable v-template-file-name    as character    no-undo.
      159       define variable v-vb-file-name          as character    no-undo.
      160       define variable v-data-header-filename  as character    no-undo.
      161       define variable v-data-filename         as character    no-undo.
      162       define buffer buf_temp-param for temp-param .
      163   do
      164   for buf_temp-param
      165   on error undo, return error
      166   :
      167       assign
      168           p-data-file-list-name = search( p-data-file-list-name )
      169       .
      170       if p-data-file-list-name = ?
      171       or p-data-file-list-name = "":U
      172       then do:
      173           message
      174               "Не найден список файлов данных."
      175               skip (1)
      176               skip "Указан файл:" p-data-file-list-name
      177           view-as alert-box error.
      178       end.
      179       define variable v-counter               as integer      no-undo.
      180       define variable v-excel-files-count     as integer      no-undo.
      181       assign
      182           v-counter           = 0
      183           v-excel-files-count = 0
      184       .
      185       input stream in-stream from value( p-data-file-list-name ).
      186       repeat
      187       :
      188           import stream in-stream v-template-file-name   .
      189           import stream in-stream v-vb-file-name         .
      190           import stream in-stream v-data-header-filename .
      191           import stream in-stream v-data-filename        .
      192           assign
      193               v-excel-files-count = v-excel-files-count + 1
      194           .
      195       end.
      196       input stream in-stream close.
      197       input stream in-stream from value( p-data-file-list-name ).
      198       repeat
      199       :
      200           import stream in-stream v-template-file-name   .
      201           import stream in-stream v-vb-file-name         .
      202           import stream in-stream v-data-header-filename .
      203           import stream in-stream v-data-filename        .
      204           if search( v-template-file-name ) = ?
      205           then do:
      206               message
      207                   skip "Не найден шаблон Excel для вывода данных."
      208                   skip(1)
      209                   skip "Указан файл шаблона:" v-template-file-name
      210               view-as alert-box error.
      211               undo, return error .
      212           end.
      213           if search( v-vb-file-name ) = ?
      214           then do:
      215               message
      216                   skip "Не найден текст программы заполнения"
      217                   skip "шаблона Excel."
      218                   skip(1)
      219                   skip "Файл шаблона:" v-template-file-name
      220                   skip "Указан файл программы:" v-vb-file-name
      221               view-as alert-box error.
      222               undo, return error .
      223           end.
      224           if v-data-header-filename <> "":U
      225           and search( v-data-header-filename ) = ?
      226           then do:
      227               message
      228                   skip "Не найден файл шапки."
      229                   skip(1)
      230                   skip "Файл шаблона:" v-template-file-name
      231                   skip "Указан файл шапки:" v-data-header-filename
      232               view-as alert-box error.
      233               undo, return error .
      234           end.
      235           if v-data-filename <> "":U
      236           and search( v-data-filename )   = ?
      237           then do:
      238               message
      239                   skip "Не найден файл строк данных."
      240                   skip(1)
      241                   skip "Файл шаблона:" v-template-file-name
      242                   skip "Указан файл строк данных:" v-data-filename
      243               view-as alert-box error.
      244               undo, return error .
      245           end.
      246           for each buf_temp-param
      247           :
      248               if buf_temp-param.param-code <> "file":U
      249               or buf_temp-param.param-sub-code <> "file-out-list":U
      250               then do:
      251                   delete buf_temp-param.
      252               end.
      253           end.
      254           create buf_temp-param.
      255           assign
      256               v-template-file-name = search( v-template-file-name )
      257           .
      258           if v-template-file-name = ?
      259           or v-template-file-name = "":U
      260           then do:
      261               message
      262                   "Ошибка имени файла шаблона."
      263               view-as alert-box error.
      264           end.
      265           run paramls-write in this-procedure (
      266                 input "template":U
      267               , input "template-file-name":U
      268               , input v-template-file-name
      269           ).
      270           run paramls-write in this-procedure (
      271                 input "template":U
      272               , input "vb-file-name":U
      273               , input v-vb-file-name
      274           ).
      275           run paramls-write in this-procedure (
      276                 input "data":U
      277               , input "data-header-filename":U
      278               , input v-data-header-filename
      279           ).
      280           run paramls-write in this-procedure (
      281                 input "data":U
      282               , input "data-filename":U
      283               , input v-data-filename
      284           ).
      285           assign
      286               v-counter = v-counter + 1
      287           .
      288           if v-counter < v-excel-files-count
      289           then do:
      290               run paramls-write in this-procedure (
      291                     input "file":U
      292                   , input "file-no-open":U
      293                   , input "yes":U
      294               ).
      295           end.
      296           else do:
      297               run paramls-write in this-procedure (
      298                     input "file":U
      299                   , input "file-no-open":U
      300                   , input "no":U
      301               ).
      302           end.
      303           run gbl/macroxlt.p (
      304               input-output table buf_temp-param
      305           ) no-error.
      306           if error-status :error
      307           and return-value <> "quit"
      308           then do:
      309               message
      310                       vss-workfile vss-revision vss-description
      311                   skip(1)
      312                   skip "Ошибка создания файла Excel."
      313                   skip return-value
      314                   skip trim(error-status :get-message(1))
      315                       trim(error-status :get-message(2))
      316                       trim(error-status :get-message(3))
      317               view-as alert-box error.
      318               undo, return error .
      319           end.
      320       end.
      321       input stream in-stream close.
      322       os-delete value(p-data-file-list-name).
      323   end.
