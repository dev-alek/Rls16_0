     2079   procedure rwthobxl-sheet1-add-line-data :
     2080   define input parameter p-obj-type       as character        no-undo.
     2081   define input parameter p-obj-code       as integer          no-undo.
     2082   define input parameter p-wth-code       as integer          no-undo.
     2083   define input parameter p-par-code       as integer          no-undo.
     2084   define input parameter p-ext-doc-type   as character        no-undo.
     2085   define input parameter p-sum-type       as character        no-undo.
     2086   define input parameter p-stkSt          as decimal          no-undo.
     2087   define input parameter p-stkLt          as decimal          no-undo.
     2088   define input parameter p-stkRb          as decimal          no-undo.
     2089       define variable v-gds-name    as character    no-undo.
     2090       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     2091       define buffer buf_wth-par       for ub.wth-par.
     2092       define buffer buf_wealth        for ub.wealth.
     2093   do
     2094   for buf_temp_sheet1_line-data
     2095     , buf_wth-par
     2096     , buf_wealth
     2097   on error undo, return error
     2098   :
     2099       find first buf_temp_sheet1_line-data
     2100            where buf_temp_sheet1_line-data.obj-type   = p-obj-type
     2101              and buf_temp_sheet1_line-data.obj-code   = p-obj-code
     2102              and buf_temp_sheet1_line-data.wth-code   = p-wth-code
     2103              and buf_temp_sheet1_line-data.par-code   = p-par-code
     2104       no-error.
     2105       if not available buf_temp_sheet1_line-data
     2106       then do:
     2107           find first buf_wealth no-lock
     2108                where buf_wealth.wth-code = p-wth-code
     2109           .
     2110           assign
     2111               v-gds-name = buf_wealth.wth-name
     2112           .
     2113           find first buf_wth-par no-lock
     2114                where buf_wth-par.par-code = p-par-code
     2115           no-error.
     2116           create buf_temp_sheet1_line-data.
     2117           assign
     2118               v-rwthobxl-sheet1-cur-data-row          = v-rwthobxl-sheet1-cur-data-row + 1
     2119               buf_temp_sheet1_line-data.sheet-name    = "НачалоПериода":U
     2120               buf_temp_sheet1_line-data.xl-line-id    = v-rwthobxl-sheet1-cur-data-row
     2121               buf_temp_sheet1_line-data.obj-type      = p-obj-type
     2122               buf_temp_sheet1_line-data.obj-code      = p-obj-code
     2123               buf_temp_sheet1_line-data.wth-code      = p-wth-code
     2124               buf_temp_sheet1_line-data.par-code      = p-par-code
     2125               buf_temp_sheet1_line-data.goodsName     = v-gds-name
     2126               buf_temp_sheet1_line-data.wthPar        = ( if available buf_wth-par then string( buf_wth-par.par-val ) else "":U )
     2127           .
     2128           assign
     2129               buf_temp_sheet1_line-data.stkRealSt     = 0.0
     2130               buf_temp_sheet1_line-data.stkPOffSt     = 0.0
     2131               buf_temp_sheet1_line-data.stkRealLt     = 0.0
     2132               buf_temp_sheet1_line-data.stkPOffLt     = 0.0
     2133               buf_temp_sheet1_line-data.stkRealRb     = 0.0
     2134               buf_temp_sheet1_line-data.stkPOffRb     = 0.0
     2135           .
     2136       end.
     2137       case p-ext-doc-type
     2138       :
     2139           when 'ie':U
     2140           or when 'ff':U
     2141           or when 'rf':U
     2142           then do:
     2143               assign
     2144                   buf_temp_sheet1_line-data.stkRealSt     = buf_temp_sheet1_line-data.stkRealSt  + p-stkSt
     2145                   buf_temp_sheet1_line-data.stkRealLt     = buf_temp_sheet1_line-data.stkRealLt  + p-stkLt
     2146                   buf_temp_sheet1_line-data.stkRealRb     = buf_temp_sheet1_line-data.stkRealRb  + p-stkRb
     2147               .
     2148           end.
     2149           when 'ee':U
     2150           or when 'df':U
     2151           or when 'rf':U
     2152           or when 'ef':U
     2153           then do:
     2154               assign
     2155                   buf_temp_sheet1_line-data.stkRealSt     = buf_temp_sheet1_line-data.stkRealSt  + p-stkSt
     2156                   buf_temp_sheet1_line-data.stkRealLt     = buf_temp_sheet1_line-data.stkRealLt  + p-stkLt
     2157                   buf_temp_sheet1_line-data.stkRealRb     = buf_temp_sheet1_line-data.stkRealRb  + p-stkRb
     2158               .
     2159           end.
     2160           when 'ip':U
     2161           or when 'rp':U
     2162           or when 'pc':U
     2163           or when 'ps':U
     2164           or when 'pz':U
     2165           then do:
     2166               assign
     2167                   buf_temp_sheet1_line-data.stkPOffSt     = buf_temp_sheet1_line-data.stkPOffSt  + p-stkSt
     2168                   buf_temp_sheet1_line-data.stkPOffLt     = buf_temp_sheet1_line-data.stkPOffLt  + p-stkLt
     2169                   buf_temp_sheet1_line-data.stkPOffRb     = buf_temp_sheet1_line-data.stkPOffRb  + p-stkRb
     2170               .
     2171           end.
     2172           when 'ep':U
     2173           or when 'dp':U
     2174           then do:
     2175               assign
     2176                   buf_temp_sheet1_line-data.stkPOffSt     = buf_temp_sheet1_line-data.stkPOffSt  + p-stkSt
     2177                   buf_temp_sheet1_line-data.stkPOffLt     = buf_temp_sheet1_line-data.stkPOffLt  + p-stkLt
     2178                   buf_temp_sheet1_line-data.stkPOffRb     = buf_temp_sheet1_line-data.stkPOffRb  + p-stkRb
     2179               .
     2180           end.
     2181           when 'xc':U
     2182           then do:
     2183               if p-sum-type = 'при':U
     2184               then do:
     2185                   assign
     2186                       buf_temp_sheet1_line-data.stkPOffSt     = buf_temp_sheet1_line-data.stkPOffSt  + p-stkSt
     2187                       buf_temp_sheet1_line-data.stkPOffLt     = buf_temp_sheet1_line-data.stkPOffLt  + p-stkLt
     2188                       buf_temp_sheet1_line-data.stkPOffRb     = buf_temp_sheet1_line-data.stkPOffRb  + p-stkRb
     2189                   .
     2190               end.
     2191               else do:
     2192                   assign
     2193                       buf_temp_sheet1_line-data.stkRealSt     = buf_temp_sheet1_line-data.stkRealSt  + p-stkSt
     2194                       buf_temp_sheet1_line-data.stkRealLt     = buf_temp_sheet1_line-data.stkRealLt  + p-stkLt
     2195                       buf_temp_sheet1_line-data.stkRealRb     = buf_temp_sheet1_line-data.stkRealRb  + p-stkRb
     2196                   .
     2197               end.
     2198           end.
     2199           otherwise do:
     2200           end.
     2201       end case.
     2202   end.
     2203   end procedure.
     2204   procedure rwthobxl-sheet1-write-line-data :
     2205       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     2206   do
     2207   for buf_temp_sheet1_line-data
     2208   on error undo, return error
     2209   :
     2210       for each buf_temp_sheet1_line-data
     2211       break by buf_temp_sheet1_line-data.obj-type
     2212             by buf_temp_sheet1_line-data.obj-code
     2213             by buf_temp_sheet1_line-data.wth-code
     2214             by buf_temp_sheet1_line-data.par-code
     2215       :
     2216           if first-of ( buf_temp_sheet1_line-data.obj-code )
     2217           then do:
     2218               put stream excel-line unformatted
     2219                                   buf_temp_sheet1_line-data.sheet-name
     2220                   CHR(9)   "DTA":U
     2221                   CHR(9)   substitute( "По объекту &1 &2", buf_temp_sheet1_line-data.obj-type, buf_temp_sheet1_line-data.obj-code )
     2222                   CHR(9)   " ":U
     2223                   CHR(9)   " ":U
     2224                   CHR(9)   " ":U
     2225                   CHR(9)   " ":U
     2226                   CHR(9)   " ":U
     2227                   chr(10)
     2228               .
     2229               run rwthobxl-sheet1-write-line-format in this-procedure (
     2230                   input "Объект":U
     2231               ).
     2232           end.
     2233           put stream excel-line unformatted
     2234                               buf_temp_sheet1_line-data.sheet-name
     2235               CHR(9)   "DTA":U
     2236               CHR(9)   buf_temp_sheet1_line-data.goodsName
     2237               CHR(9)   buf_temp_sheet1_line-data.wthPar
     2238               CHR(9)   string( buf_temp_sheet1_line-data.stkRealSt )
     2239               CHR(9)   string( buf_temp_sheet1_line-data.stkPOffSt )
     2240               CHR(9)   string( buf_temp_sheet1_line-data.stkRealLt )
     2241               CHR(9)   string( buf_temp_sheet1_line-data.stkPOffLt )
     2242               chr(10)
     2243           .
     2244       end.
     2245   end.
     2246   end procedure.
