     3033   procedure rwthobxl-write-cell-data :
     3034   define input parameter p-data-key   as character        no-undo.
     3035   define input parameter p-data-value as character        no-undo.
     3036       define buffer buf_temp_cell-data     for temp_cell-data.
     3037   do
     3038   for buf_temp_cell-data
     3039   on error undo, return error
     3040   :
     3041       find first buf_temp_cell-data
     3042            where buf_temp_cell-data.data-key = p-data-key
     3043       no-error.
     3044       if not available buf_temp_cell-data
     3045       then do:
     3046           create buf_temp_cell-data.
     3047           assign
     3048               buf_temp_cell-data.data-key = p-data-key
     3049           .
     3050       end.
     3051       assign
     3052           buf_temp_cell-data.data-value = p-data-value
     3053       .
     3054       put stream excel-cell unformatted
     3055                           buf_temp_cell-data.data-key
     3056           CHR(9)   buf_temp_cell-data.data-value
     3057           chr(10)
     3058       .
     3059   end.
     3060   end procedure.
     3061   procedure rwthobxl-run-excel :
     3062   define input parameter p-header-filename    as character        no-undo.
     3063   define input parameter p-data-filename      as character        no-undo.
     3064       define variable v-template-file-name    as character    no-undo.
     3065       define variable v-vb-file-name          as character    no-undo.
     3066       define buffer buf_temp-param for temp-param .
     3067   do
     3068   for buf_temp-param
     3069   on error undo, return error
     3070   :
     3071       create buf_temp-param.
     3072       assign
     3073           v-template-file-name    = search( "exe/rwthob.xlt" )
     3074           v-vb-file-name          = search( "exe/t_form.bas")
     3075       .
     3076       if v-template-file-name = ?
     3077       or v-template-file-name = "":U
     3078       then do:
     3079           message
     3080               "Ошибка имени файла шаблона."
     3081           view-as alert-box error.
     3082       end.
     3083       if v-vb-file-name = ?
     3084       or v-vb-file-name = "":U
     3085       then do:
     3086           message
     3087               "Ошибка имени файла кода обработки."
     3088           view-as alert-box error.
     3089       end.
     3090       run paramls-write in this-procedure (
     3091             input "template":U
     3092           , input "template-file-name":U
     3093           , input v-template-file-name
     3094       ).
     3095       run paramls-write in this-procedure (
     3096             input "template":U
     3097           , input "vb-file-name":U
     3098           , input v-vb-file-name
     3099       ).
     3100       run paramls-write in this-procedure (
     3101             input "data":U
     3102           , input "data-header-filename":U
     3103           , input p-header-filename
     3104       ).
     3105       run paramls-write in this-procedure (
     3106             input "data":U
     3107           , input "data-filename":U
     3108           , input p-data-filename
     3109       ).
     3110       run gbl/macroxlt.p (
     3111           input-output table buf_temp-param
     3112       ) no-error.
     3113       if error-status :error
     3114       then do:
     3115           message
     3116                    vss-workfile vss-revision vss-description
     3117               skip(1)
     3118               skip "Ошибка создания файла Excel."
     3119               skip return-value
     3120               skip trim(error-status :get-message(1))
     3121                    trim(error-status :get-message(2))
     3122                    trim(error-status :get-message(3))
     3123           view-as alert-box error.
     3124           undo, return error .
     3125       end.
     3126   end.
     3127   end procedure.
     3128   procedure rwthobxl-close :
     3129   do
     3130   on error undo, return error
     3131   :
     3132       output stream excel-line close.
     3133       output stream excel-cell close.
     3134       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     3135           export "exe/rwthob.xlt":U.
     3136           export "exe/t_form.bas":U.
     3137           export v-rwthobxl-cell-file-name.
     3138           export v-rwthobxl-data-file-name.
     3139       output close.
     3140   end.
     3141   end procedure.
     3142   procedure rwthobxl-sheet1-write-line-format :
     3143   define input parameter p-fmt-label       as character  no-undo.
     3144       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     3145   do
     3146   for buf_temp_sheet1_line-data
     3147   on error undo, return error
     3148   :
     3149       put stream excel-line unformatted
     3150                           "НачалоПериода":U
     3151           CHR(9)   "FMT":U
     3152           CHR(9)   p-fmt-label
     3153           chr(10)
     3154       .
     3155   end.
     3156   end procedure.
