      827   define  stream PrnLibStream.
      828   procedure prn-lib-prn-file :
      829     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      830     define input parameter p-DIsabledoptions as integer no-undo .
      831     define variable v-report-name as character no-undo .
      832     define variable v-user-action as character no-undo .
      833     define variable v-printed     as logical   no-undo .
      834     define variable v-exist       as logical   no-undo .
      835     do
      836       on error undo, return error
      837       :
      838       run prn-lib-get-report-name  in this-procedure (
      839         input parParentProc
      840         ,output v-report-name
      841         ).
      842   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      844     (input  v-report-name
      845     ,input  2
      846     ,output v-exist
      847     )  .
      848       if NOT v-exist then
      849       DO:
      850         Message
      851           "Нет заданий на печать ! "
      852           view-as alert-box .
      853         Return  .
      854       End.
      855       run gbl/prnfilen.w
      856         (input  ""
      857         ,input  p-DisabledOptions
      858         ,input  string(v-report-name )
      859         ,input  7
      860         ,output v-user-action
      861         ,output v-printed
      862         ) .
      863       if v-printed then
      864       do:
      865         return "YES" .
      866       end.
      867       else
      868       do:
      869         return "NO" .
      870       end.
      871     end.
      872   end procedure.
      873   procedure prn-lib-open-stream :
      874     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      875     define input parameter p-page-size    as integer no-undo .
      876     define input parameter p-is-stream    as logical no-undo .
      877     define input parameter p-append       as logical no-undo .
      878     define variable v-report-name as character no-undo .
      879     do
      880       on error undo, return error
      881       :
      882       run prn-lib-get-report-name  in this-procedure (
      883         input parParentProc
      884         ,output v-report-name
      885         ).
      886       if p-is-stream then
      887       do:
      888         if p-append then
      889         do:
      890           output stream PrnLibStream to value( v-report-name )
      891             page-size value(p-page-size) append .
      892         end.
      893         if not p-append then
      894         do:
      895           output stream PrnLibStream to value( v-report-name )
      896             page-size value(p-page-size) .
      897         end.
      898       end.
      899       if not p-is-stream then
      900       do:
      901         if p-append then
      902         do:
      903           output to value( v-report-name )
      904             page-size value(p-page-size) append .
      905         end.
      906         if not p-append then
      907         do:
      908           output to value( v-report-name )
      909             page-size value(p-page-size) .
      910         end.
      911       end.
      912     end.
      913   end procedure.
      914   procedure prn-lib-open-exp :
      915     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      916     define input parameter p-is-stream    as logical no-undo .
      917     define input parameter p-is-append    as logical no-undo .
      918     define output parameter p-ReportFileName as char init "report" no-undo.
      919     define output parameter p-process as logical no-undo .
      920     define variable glog as logical no-undo .
      921     do
      922       on error undo, return error
      923       :
      924       SYSTEM-DIALOG GET-FILE p-ReportFileName
      925         TITLE      "Укажите путь"
      926         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      927         ASK-OVERWRITE
      928         CREATE-TEST-FILE
      929         SAVE-AS
      930         USE-FILENAME
      931         DEFAULT-EXTENSION "txt"
      932         UPDATE glog
      933         .
      934       if not glog then  return.
      935       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      936       if p-is-stream then
      937       do:
      938         if p-is-append then
      939         do:
      940           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      941         end.
      942         else
      943         do:
      944           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      945         end.
      946       end.
      947       else
      948       do:
      949         if p-is-append then
      950         do:
      951           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      952         end.
      953         else
      954         do:
      955           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      956         end.
      957       end.
      958       p-process = yes.
      959     end.
      960   end procedure.
      961   procedure prn-lib-get-report-name :
      962     define input parameter parParentProc  as widget-handle no-undo.
      963     define output parameter p-report-name as character no-undo .
      964     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      965   end procedure.
      966   procedure prn-lib-reportviewer-report-name :
      967     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      968     define input parameter p-report-name-html as character no-undo .
      969     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      970   end procedure.
      971   procedure prn-lib-reportviewer :
      972     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      973     define input parameter p-report-name-html as character no-undo .
      974     define input parameter p-param        as character no-undo .
      975     define variable v-excel           as character no-undo init 'TRUE' .
      976     define variable v-value-character as character no-undo .
      977     define variable v-value-integer   as character no-undo .
      978     define variable v-value-date      as date      no-undo .
      979     define variable v-value-decimal   as decimal   no-undo .
      980     define variable rep-excel         as logical   no-undo .
      981     define variable excel-string      as character no-undo .
      982     define variable v-param-type      as character no-undo .
      983     define variable v-tth             as handle    no-undo .
      984     run adm/shattri.p (
      985       input "get":U
      986       ,input  ""
      987       ,input  0
      988       ,input  'report-glob':U
      989       ,input  'rep-excel':U
      990       ,output v-value-character
      991       ,output v-value-date
      992       ,output v-value-decimal
      993       ,output v-value-integer
      994       ,output rep-excel
      995       ,output v-param-type
      996       ,INPUT-OUTPUT table-handle v-tth
      997       )  .
      998     if rep-excel then v-excel = "TRUE" .
      999     else v-excel = "FALSE" .
     1000     if p-param eq ""
     1001     then
     1002        p-param = "EXCEL:" + v-excel.
     1003     else
     1004        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1005     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1006   end procedure.
     1007   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1009   procedure paramls-clear :
     1010     define buffer buf_temp-param for temp-param .
     1011     do
     1012     on error undo, return error return-value
     1013     :
     1014       for each buf_temp-param
     1015       on error undo, return error
     1016       :
     1017         delete buf_temp-param .
     1018       end.
     1019     end.
     1020   end procedure.
     1021   procedure paramls-write :
     1022     define input  parameter p-code     as character no-undo .
     1023     define input  parameter p-sub-code as character no-undo .
     1024     define input  parameter p-value    as character no-undo .
     1025     define buffer buf_temp-param for temp-param .
     1026     do
     1027     on error undo, return error return-value
     1028     :
     1029       find first buf_temp-param
     1030         where buf_temp-param.param-code     = p-code
     1031           and buf_temp-param.param-sub-code = p-sub-code
     1032         no-error .
     1033       if not available buf_temp-param then do:
     1034         create buf_temp-param .
     1035         assign
     1036           buf_temp-param.param-code     = p-code
     1037           buf_temp-param.param-sub-code = p-sub-code
     1038         .
     1039       end.
     1040       assign
     1041         buf_temp-param.param-value = p-value
     1042       .
     1043     end.
     1044   end procedure.
     1045   procedure paramls-read :
     1046     define input  parameter p-code          as character no-undo .
     1047     define input  parameter p-sub-code      as character no-undo .
     1048     define input  parameter p-default-value as character no-undo .
     1049     define output parameter p-value         as character no-undo .
     1050     define buffer buf_temp-param for temp-param .
     1051     do
     1052     on error undo, return error return-value
     1053     :
     1054       find first buf_temp-param
     1055         where buf_temp-param.param-code     = p-code
     1056           and buf_temp-param.param-sub-code = p-sub-code
     1057         no-error .
     1058       if available buf_temp-param then do:
     1059         assign
     1060           p-value = buf_temp-param.param-value
     1061         .
     1062       end.
     1063       else do:
     1064         assign
     1065           p-value = p-default-value
     1066         .
     1067       end.
     1068     end.
     1069   end procedure.
     1070   procedure paramls-append :
     1071     define input  parameter p-code     as character no-undo .
     1072     define input  parameter p-sub-code as character no-undo .
     1073     define input  parameter p-value    as character no-undo .
     1074     define buffer buf_temp-param for temp-param .
     1075     do
     1076     on error undo, return error return-value
     1077     :
     1078       find first buf_temp-param
     1079            where buf_temp-param.param-code     = p-code
     1080              and buf_temp-param.param-sub-code = p-sub-code
     1081         no-error .
     1082       if not available buf_temp-param then do:
     1083         create buf_temp-param .
     1084         assign
     1085           buf_temp-param.param-code     = p-code
     1086           buf_temp-param.param-sub-code = p-sub-code
     1087           buf_temp-param.param-value    = p-value
     1088         .
     1089       end.
     1090       else do:
     1091           assign
     1092               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1093           .
     1094       end.
     1095     end.
     1096   end procedure.
     1097   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   procedure factord :
     1099     define input  parameter p-fact-date            as date    no-undo .
     1100     define input  parameter p-fact-time            as integer no-undo .
     1101     define input  parameter p-fact-num             as integer no-undo .
     1102     define input  parameter p-shift-date           as date    no-undo .
     1103     define input  parameter p-shift-num            as integer no-undo .
     1104     define input  parameter p-shift-on             as logical no-undo .
     1105     define output parameter p-fact-order           as decimal no-undo .
     1106     define output parameter p-shift-end-fact-order as decimal no-undo .
     1107     define output parameter p-day-end-fact-order   as decimal no-undo .
     1108     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1109     if p-fact-date = ?
     1110     then do:
     1111       return error "Не указана фактическая дата" .
     1112     end.
     1113     define variable v-fact-date-num as integer no-undo .
     1114     assign
     1115       v-fact-date-num = integer(p-fact-date)
     1116     .
     1117     if p-fact-num = ?
     1118     or p-fact-num = 0
     1119     then do:
     1120       return error "Не задан p-fact-num " + string(p-fact-num) .
     1121     end.
     1122     if p-fact-num < 0
     1123     then do:
     1124       return error "Отрицательный fact-num " + string(p-fact-num) .
     1125     end.
     1126     if p-fact-num >= 100000000
     1127     then do:
     1128       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1129     end.
     1130     if p-shift-on = true
     1131     then do:
     1132       if p-shift-date = ?
     1133       then do:
     1134         return error "Не задана дата смены" .
     1135       end.
     1136       if p-shift-num = ?
     1137       or p-shift-num = 0
     1138       then do:
     1139         return error "Не задан номер смены" .
     1140       end.
     1141     end.
     1142     else do:
     1143       assign
     1144         p-shift-date = p-fact-date
     1145         p-shift-num  = 24
     1146       .
     1147     end.
     1148     define variable v-shift-offset as integer no-undo .
     1149     if p-shift-date = p-fact-date
     1150     then do:
     1151       assign
     1152         v-shift-offset = 1
     1153       .
     1154     end.
     1155     if p-shift-date < p-fact-date
     1156     then do:
     1157       assign
     1158         v-shift-offset = 0
     1159       .
     1160     end.
     1161     if p-shift-date > p-fact-date
     1162     then do:
     1163       message
     1164         vss-workfile vss-revision vss-description skip
     1165         "Неправильная дата закрытия смены" skip
     1166         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1167         view-as alert-box error .
     1168       undo, return error
     1169         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1170           ,string(p-fact-date, '99/99/9999':U)
     1171           ,string(p-shift-date, '99/99/9999':U)
     1172           )
     1173       .
     1174     end.
     1175     if p-shift-num < 1
     1176     or p-shift-num > 24
     1177     then do:
     1178       message
     1179         vss-workfile vss-revision vss-description skip
     1180         "Неправильный номер смены" skip
     1181         "p-shift-num" p-shift-num skip
     1182         view-as alert-box error .
     1183       undo, return error return-value .
     1184     end.
     1185     assign
     1186       p-fact-order           = v-fact-date-num
     1187                              + v-shift-offset * 0.5
     1188                              + p-shift-num    * 0.02 - 0.01
     1189                              + p-fact-num     * 0.0000000001
     1190       p-shift-end-fact-order = v-fact-date-num
     1191                              + v-shift-offset * 0.5
     1192                              + p-shift-num    * 0.02
     1193       p-day-end-fact-order   = v-fact-date-num
     1194                              + 0.99
     1195     .
     1196     if p-fact-order           <= v-fact-date-num
     1197     or p-shift-end-fact-order <= v-fact-date-num
     1198     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1199     or p-shift-end-fact-order >= p-day-end-fact-order
     1200     then do:
     1201       message
     1202         vss-workfile vss-revision vss-description skip
     1203         "Внутренняя ошибка при генерации фактического номера" skip
     1204         "p-fact-date"            p-fact-date            skip
     1205         "p-fact-time"            p-fact-time            skip
     1206         "p-fact-num"             p-fact-num             skip
     1207         "p-shift-date"           p-shift-date           skip
     1208         "p-shift-num"            p-shift-num            skip
     1209         "p-shift-on"             p-shift-on             skip
     1210         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1211         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1212         "v-fact-date-num"        v-fact-date-num        skip
     1213         view-as alert-box error .
     1214       undo, return error return-value .
     1215     end.
     1216   end procedure.
     1217   procedure day-begin-fact-order :
     1218     define input  parameter p-fact-date            as date    no-undo .
     1219     define output parameter p-day-begin-fact-order as decimal no-undo .
     1220     do
     1221     on error undo, return error return-value
     1222     :
     1223       if p-fact-date = ?
     1224       then do:
     1225         assign
     1226           p-day-begin-fact-order = 0
     1227         .
     1228       end.
     1229       else do:
     1230         assign
     1231           p-day-begin-fact-order = integer(p-fact-date)
     1232         .
     1233       end.
     1234     end.
     1235   end procedure.
     1236   procedure factord-max-fact-order :
     1237     define output parameter p-max-fact-order as decimal   no-undo .
     1238     do
     1239     on error undo, return error return-value
     1240     :
     1241       run day-begin-fact-order in this-procedure
     1242         (input  date(1, 1, 5000)
     1243         ,output p-max-fact-order
     1244         ) .
     1245     end.
     1246   end procedure.
     1247   procedure factord-cut-archive :
     1248     define input  parameter p-obj-type             as character no-undo .
     1249     define input  parameter p-obj-code             as integer   no-undo .
     1250     define input  parameter p-fact-date            as date      no-undo .
     1251     define output parameter p-shift-on             as logical   no-undo .
     1252     define output parameter p-shift-date           as date      no-undo .
     1253     define output parameter p-shift-num            as integer   no-undo .
     1254     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1255     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1256     define variable v-fact-order as decimal   no-undo .
     1257     define buffer buf_shift-obj for ub.shift-obj .
     1258     do
     1259     on error undo, return error return-value
     1260     :
     1261   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1262   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1263     (input  p-obj-type
     1264     ,input  p-obj-code
     1265     ,input  'shift-on=request'
     1266     ,output p-shift-on
     1267     ) no-error .
     1268       if error-status :error
     1269       then do:
     1270         message
     1271           vss-workfile vss-revision vss-description skip
     1272           "Ошибка при определении атрибута объекта" skip
     1273           "Объект" p-obj-type p-obj-code skip
     1274           error-status :get-message(1) skip
     1275           return-value skip
     1276           view-as alert-box error .
     1277         undo, return error return-value .
     1278       end.
     1279       if p-shift-on = false
     1280       then do:
     1281         assign
     1282           p-shift-date               = ?
     1283           p-shift-num                = 0
     1284         .
     1285       end.
     1286       else do:
     1287         find first buf_shift-obj share-lock
     1288           where buf_shift-obj.obj-type   = p-obj-type
     1289             and buf_shift-obj.obj-code   = p-obj-code
     1290             and buf_shift-obj.shift-date > p-fact-date
     1291           use-index pi
     1292           no-error .
     1293         if not available buf_shift-obj
     1294         or buf_shift-obj.status_ <> 'зкр':U
     1295         then do:
     1296           message
     1297             vss-workfile vss-revision vss-description skip
     1298             "Невозможно вычислить последнюю смену" skip
     1299             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1300             "Объект" p-obj-type p-obj-code skip
     1301             "Дата" p-fact-date skip
     1302             view-as alert-box error .
     1303           undo, return error return-value .
     1304         end.
     1305         find last buf_shift-obj share-lock
     1306           where buf_shift-obj.obj-type = p-obj-type
     1307             and buf_shift-obj.obj-code = p-obj-code
     1308             and buf_shift-obj.shift-date <= p-fact-date
     1309           use-index pi
     1310           no-error .
     1311         if available buf_shift-obj
     1312         then do:
     1313           if  buf_shift-obj.status_ = 'зкр':U
     1314           then do:
     1315             assign
     1316               p-shift-date = buf_shift-obj.shift-date
     1317               p-shift-num  = buf_shift-obj.shift-num
     1318             .
     1319           end.
     1320           else do:
     1321             message
     1322               vss-workfile vss-revision vss-description skip
     1323               "Невозможно вычислить последнюю смену" skip
     1324               "Статус смены отличен от статуса" 'зкр':U skip
     1325               "Объект" p-obj-type p-obj-code skip
     1326               "Дата" p-fact-date skip
     1327               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1328               view-as alert-box error .
     1329             undo, return error return-value .
     1330           end.
     1331         end.
     1332         else do:
     1333           assign
     1334             p-shift-date = p-fact-date - 1
     1335             p-shift-num  = 1
     1336           .
     1337         end.
     1338       end.
     1339       run factord in this-procedure
     1340         (input  p-fact-date
     1341         ,input  1
     1342         ,input  1
     1343         ,input  p-shift-date
     1344         ,input  p-shift-num
     1345         ,input  p-shift-on
     1346         ,output v-fact-order
     1347         ,output p-shift-end-fact-order
     1348         ,output p-day-end-fact-order
     1349         ) no-error .
     1350       if error-status :error
     1351       then do:
     1352         message
     1353           vss-workfile vss-revision vss-description skip
     1354           "Ошибка при вызове процедуры factord"
     1355           error-status :get-message(1) skip
     1356           return-value skip
     1357           view-as alert-box error .
     1358         undo, return error return-value .
     1359       end.
     1360     end.
     1361   end procedure.
     1362   procedure factord-lock-shift :
     1363     define input  parameter p-obj-type  as character no-undo .
     1364     define input  parameter p-obj-code  as integer   no-undo .
     1365     define input  parameter p-fact-date as date      no-undo .
     1366     define parameter buffer buf_shift-obj for ub.shift-obj .
     1367     define variable v-shift-on      as logical   no-undo .
     1368     define variable v-extra-message as character no-undo .
     1369     define variable v-error as character no-undo .
     1370     do
     1371     on error undo, return error return-value
     1372     :
     1373   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1375     (input  p-obj-type
     1376     ,input  p-obj-code
     1377     ,input  'shift-on=request'
     1378     ,output v-shift-on
     1379     ) no-error .
     1380       if error-status :error
     1381       then do:
     1382         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1383         undo, return error v-error .
     1384       end.
     1385       if v-shift-on = true
     1386       then do:
     1387         find first buf_shift-obj share-lock
     1388           where buf_shift-obj.obj-type   = p-obj-type
     1389             and buf_shift-obj.obj-code   = p-obj-code
     1390             and buf_shift-obj.shift-date > p-fact-date
     1391           use-index pi
     1392           no-error .
     1393         if not available buf_shift-obj
     1394         or buf_shift-obj.status_ <> 'зкр':U
     1395         then do:
     1396           find last buf_shift-obj
     1397             where buf_shift-obj.obj-type = p-obj-type
     1398               and buf_shift-obj.obj-code = p-obj-code
     1399               and buf_shift-obj.status_  = 'зкр':U
     1400             use-index stts
     1401             no-error .
     1402           if available buf_shift-obj
     1403           then do:
     1404             assign
     1405               v-extra-message =
     1406                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1407                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1408                               )
     1409             .
     1410           end.
     1411           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1412           undo, return error v-error .
     1413         end.
     1414       end.
     1415     end.
     1416   end procedure.
     1417   procedure factord-end-day :
     1418     define input  parameter p-fact-date            as date    no-undo .
     1419     define output parameter p-day-end-fact-order   as decimal no-undo .
     1420     do
     1421     on error undo, return error return-value
     1422     :
     1423       if p-fact-date = ?
     1424       then do:
     1425         return error "Не указана фактическая дата" .
     1426       end.
     1427       assign
     1428         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1429       .
     1430     end.
     1431   end procedure.
     1432   procedure factord-to-date :
     1433     define input  parameter p-fact-order as decimal no-undo .
     1434     define output parameter p-fact-date  as date    no-undo .
     1435     define variable v-ref-date  as date      no-undo .
     1436     define variable v-ref-delta as integer   no-undo .
     1437     do
     1438     on error undo, return error return-value
     1439     :
     1440       if p-fact-order = ?
     1441       or p-fact-order = 0
     1442       then do:
     1443         return error "Не указан fact-order" .
     1444       end.
     1445       assign
     1446         v-ref-date  = date(1, 1, 2000)
     1447       .
     1448       assign
     1449         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1450       .
     1451       assign
     1452         p-fact-date = v-ref-date + v-ref-delta
     1453       .
     1454     end.
     1455   end procedure.
     1456   procedure factord-to-fact-num :
     1457     define input  parameter p-fact-order as decimal no-undo .
     1458     define output parameter p-fact-num   as integer no-undo .
     1459     define variable v-fact-order-trunc as decimal no-undo .
     1460     do
     1461     on error undo, return error return-value
     1462     :
     1463       if p-fact-order = ?
     1464       or p-fact-order = 0
     1465       then do:
     1466         return error "Не указан fact-order" .
     1467       end.
     1468       assign
     1469        v-fact-order-trunc = truncate(p-fact-order, 2)
     1470       .
     1471       assign
     1472         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1473       .
     1474     end.
     1475   end procedure.
     1476   procedure factord-to-shift-num :
     1477     define input  parameter p-fact-order as decimal no-undo .
     1478     define output parameter p-shift-num   as integer no-undo .
     1479     define variable  p-shift-numd  as decimal   no-undo .
     1480     define variable v-fact-order-trunc as decimal no-undo .
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484       if p-fact-order = ?
     1485       or p-fact-order = 0
     1486       then do:
     1487         return error "Не указан fact-order" .
     1488       end.
     1489       assign
     1490        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1491       .
     1492       if v-fact-order-trunc < 0.5 then do:
     1493         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1494       end.
     1495       assign
     1496         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1497         .
     1498        assign
     1499         p-shift-num = truncate (p-shift-numd , 0)
     1500       .
     1501     end.
     1502   end procedure.
     1503   define variable vss-include-info15 as character format "X(65)" no-undo
     1504   initial "@(#)$Workfile$ $Revision$".
     1505   define temp-table temp_shiftfo_fo-range no-undo
     1506       field frn-key           as integer
     1507       field obj-type          as character
     1508       field obj-code          as integer
     1509       field fact-order-from   as decimal
     1510       field fact-order-to     as decimal
     1511       field date-from         as date
     1512       field date-to           as date
     1513       field shift-from        as integer
     1514       field shift-to          as integer
     1515       index pi is primary unique
     1516           frn-key
     1517   .
     1518   define temp-table temp_shiftfo_obj-list no-undo
     1519       field obj-type  as character
     1520       field obj-code  as integer
     1521       index pi is primary unique
     1522           obj-type
     1523           obj-code
     1524   .
     1525   define variable v-shiftfo15-frn-key     as integer      no-undo.
     1526   procedure fill-temp_shiftfo_fo-range :
     1527   define input parameter p-mode               as integer          no-undo.
     1528   define input parameter p-date-beg           as date             no-undo.
     1529   define input parameter p-date-end           as date             no-undo.
     1530   define input parameter p-shift-num-beg      as integer          no-undo.
     1531   define input parameter p-shift-num-end      as integer          no-undo.
     1532   define input parameter p-shift-num-alone    as integer          no-undo.
     1533   define output parameter p-date-string       as character        no-undo.
     1534   define output parameter p-date-from-string  as character        no-undo.
     1535   define output parameter p-date-to-string    as character        no-undo.
     1536       define variable v-fact-order-beg    as decimal      no-undo.
     1537       define variable v-fact-order-end    as decimal      no-undo.
     1538       define variable v-date-from         as date         no-undo.
     1539       define variable v-date-to           as date         no-undo.
     1540       define variable v-shift-from        as integer      no-undo.
     1541       define variable v-shift-to          as integer      no-undo.
     1542       define variable v-docs-exists       as logical      no-undo.
     1543       define variable v-max-fact-order    as decimal      no-undo.
     1544       define variable v-shift-obj-on      as logical      no-undo.
     1545       define buffer buf_temp_shiftfo_fo-range     for temp_shiftfo_fo-range.
     1546       define buffer buf_obj-list                  for temp_shiftfo_obj-list.
     1547       define buffer buf_shift-obj                 for ub.shift-obj.
     1548       define buffer buf_prev_shift-obj            for ub.shift-obj.
     1549   do
     1550   for buf_temp_shiftfo_fo-range
     1551     , buf_obj-list
     1552     , buf_shift-obj
     1553     , buf_prev_shift-obj
     1554   on error undo, return error
     1555   :
     1556       empty temp-table buf_temp_shiftfo_fo-range.
     1557       assign
     1558           v-shiftfo15-frn-key = 0
     1559       .
     1560       case p-mode
     1561       :
     1562           when 1
     1563           then do:
     1564               run day-begin-fact-order in this-procedure (
     1565                     input p-date-beg
     1566                   , output v-fact-order-beg
     1567               ).
     1568               run factord-end-day in this-procedure (
     1569                     input p-date-end
     1570                   , output v-fact-order-end
     1571               ).
     1572               for each buf_obj-list
     1573               :
     1574                       assign
     1575                           v-shiftfo15-frn-key = v-shiftfo15-frn-key + 1
     1576                       .
