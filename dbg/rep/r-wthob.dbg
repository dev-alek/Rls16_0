     3187       define variable v-obj-list-string   as character    no-undo.
     3188       define variable v-date-from         as date         no-undo.
     3189       define variable v-date-to           as date         no-undo.
     3190       define variable v-date-string       as character    no-undo.
     3191       define variable v-date-from-string  as character    no-undo.
     3192       define variable v-date-to-string    as character    no-undo.
     3193       define variable v-ext-doc-type-list as character    no-undo.
     3194       define variable v-counter           as integer      no-undo.
     3195       define variable v-fact-order-start  as decimal      no-undo.
     3196       define variable v-fact-order-end    as decimal      no-undo.
     3197       define variable v-hide-list         as character    no-undo.
     3198       define buffer buf_clients               for ub.clients.
     3199       define buffer buf_obj-list              for obj-list.
     3200       define buffer buf_temp_shiftfo_obj-list for temp_shiftfo_obj-list.
     3201   do
     3202   for buf_clients
     3203     , buf_obj-list
     3204     , buf_temp_shiftfo_obj-list
     3205   on error undo, return error
     3206   :
     3207   if session :set-wait-state( "compiler" ) then.
     3208   output stream out-stream to value( string( session:temp-directory +
     3209                                        "rpt" + string( g#report-num ) ) )
     3210                                        page-size  value(43) .
     3211       put stream out-stream unformatted
     3212             chr(10)
     3213           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     3214           + chr(10)
     3215       .
     3216       output stream out-stream close.
     3217       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     3218       output close.
     3219       run rwthobxl-init in this-procedure.
     3220       run rwthobxl-write-cell-data in this-procedure (
     3221             input "НачалоПериода_datePrint":U
     3222           , input cur-time-string()
     3223       ).
     3224       run get-hide-list in this-procedure (
     3225             input p-ext-doc-type-list
     3226           , input p-ob-liter
     3227           , input p-ob-rubl
     3228           , input p-ob-tal
     3229           , output v-hide-list
     3230       ).
     3231       run rwthobxl-write-cell-data in this-procedure (
     3232             input "Обороты_hideColList":U
     3233           , input v-hide-list
     3234       ).
     3235       run write-stLtRbList in this-procedure (
     3236             input p-ob-tal
     3237           , input p-ob-liter
     3238           , input p-ob-rubl
     3239       ).
     3240       find first buf_obj-list
     3241       no-error.
     3242       if not available buf_obj-list
     3243       then do:
     3244           message
     3245                    vss-workfile vss-revision vss-description
     3246               skip(1)
     3247               skip "Список объектов пуст."
     3248           view-as alert-box error.
     3249           undo, return error.
     3250       end.
     3251       case p-obj-selection-type
     3252       :
     3253           when "1"
     3254           then do:
     3255               assign
     3256                   v-obj-list-string = substitute( "Все по фирме: &1", buf_obj-list.obj-name )
     3257               .
     3258           end.
     3259           when "2"
     3260           then do:
     3261               assign
     3262                   v-obj-list-string = substitute( "Текущий объект: &1", buf_obj-list.obj-name )
     3263               .
     3264           end.
     3265           otherwise do:
     3266               assign
     3267                   v-obj-list-string = ""
     3268               .
     3269               for each buf_obj-list
     3270               on error undo, return error
     3271               :
     3272                   assign
     3273                       v-obj-list-string = substitute( "&1&2 &3"
     3274                                               , v-obj-list-string
     3275                                               , ( if v-obj-list-string = "" then "" else "," )
     3276                                               , buf_obj-list.obj-name )
     3277                   .
     3278               end.
     3279           end.
     3280       end case.
     3281       run rwthobxl-write-cell-data in this-procedure (
     3282             input "НачалоПериода_objList":U
     3283           , input v-obj-list-string
     3284       ).
     3285       for each buf_obj-list
     3286       on error undo, return error
     3287       :
     3288           create buf_temp_shiftfo_obj-list.
     3289           assign
     3290               buf_temp_shiftfo_obj-list.obj-type = buf_obj-list.obj-type
     3291               buf_temp_shiftfo_obj-list.obj-code = buf_obj-list.obj-code
     3292           .
     3293       end.
     3294       run fill-temp_shiftfo_fo-range in this-procedure (
     3295             input x-Radio-Task
     3296           , input x-Date-Start
     3297           , input x-Date-End
     3298           , input x-Shift-Start
     3299           , input x-Shift-End
     3300           , input x-Shift-Alone
     3301           , output v-date-string
     3302           , output v-date-from-string
     3303           , output v-date-to-string
     3304       ).
     3305        ASSIGN
     3306           v-date-string       = substitute( "с &1 по &2", v-date-from-string, v-date-to-string )
     3307       .
     3308       run rwthobxl-write-cell-data in this-procedure (
     3309             input "НачалоПериода_dateString":U
     3310           , input v-date-string
     3311       ).
     3312       run rwthobxl-write-cell-data in this-procedure (
     3313             input "Обороты_dateString":U
     3314           , input v-date-string
     3315       ).
     3316       run rwthobxl-write-cell-data in this-procedure (
     3317             input "НачалоПериода_dateFromString":U
     3318           , input v-date-from-string
     3319       ).
     3320       run rwthobxl-write-cell-data in this-procedure (
     3321             input "КонецПериода_dateToString":U
     3322           , input v-date-to-string
     3323       ).
     3324       run rwthobxl-write-cell-data in this-procedure (
     3325             input "НачалоПериода_detail":U
     3326           , input ( if p-detal = yes then "есть" else "нет" )
     3327       ).
     3328       run rwthobxl-write-cell-data in this-procedure (
     3329             input "НачалоПериода_detail":U
     3330           , input ( if p-detal = yes then "есть" else "нет" )
     3331       ).
     3332       if p-ext-doc-type-list = "":U
     3333       then do:
     3334           assign
     3335               v-ext-doc-type-list = "все"
     3336           .
     3337       end.
     3338       else do:
     3339           do v-counter = 1 to num-entries( p-ext-doc-type-list )
     3340           on error undo, return error
     3341           :
     3342               assign
     3343                   v-ext-doc-type-list = substitute( "&1&2&3"
     3344                                               , v-ext-doc-type-list
     3345                                               , ( if v-ext-doc-type-list = "":U then "":U else ", ":U )
     3346                                               , entry( v-counter, 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u ) )
     3347               .
     3348           end.
     3349       end.
     3350       run rwthobxl-write-cell-data in this-procedure (
     3351             input "НачалоПериода_extDocTypeList":U
     3352           , input v-ext-doc-type-list
     3353       ).
     3354       for each temp_shiftfo_fo-range
     3355       :
     3356           run fill-temp-tables in this-procedure (
     3357                 input temp_shiftfo_fo-range.obj-type
     3358               , input temp_shiftfo_fo-range.obj-code
     3359               , input temp_shiftfo_fo-range.fact-order-from
     3360               , input temp_shiftfo_fo-range.fact-order-to
     3361           ).
     3362       end.
     3363       run rwthobxl-sheet1-write-line-data in this-procedure .
     3364       run rwthobxl-sheet2-write-line-data in this-procedure .
     3365       run rwthobxl-sheet3-write-line-data in this-procedure .
     3366       run rwthobxl-close in this-procedure .
     3367       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3368       os-rename
     3369           value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     3370           value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     3371       .
     3372   if session :set-wait-state( "" ) then.
     3373       define variable v-user-action   as character no-undo .
     3374       define variable v-printed       as logical   no-undo .
     3375       define variable DisabledOptions as integer   no-undo .
     3376       define variable v-orient-page as character no-undo .
     3377       run gbl/prnfilen.w (
     3378             input "":U
     3379           , input 8
     3380           , input string(session :temp-directory) + "rpt" + string( g#report-num )
     3381           , input ReportFontNum
     3382           , output v-user-action
     3383           , output v-printed
     3384       ).
     3385       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3386   end.
     3387   procedure fill-temp-tables :
     3388   define input parameter p-obj-type           as character        no-undo.
     3389   define input parameter p-obj-code           as integer          no-undo.
     3390   define input parameter p-fact-order-from    as decimal          no-undo.
     3391   define input parameter p-fact-order-to      as decimal          no-undo.
     3392       define variable v-counter           as integer      no-undo.
     3393       define variable v-counter-sum-type  as integer      no-undo.
     3394       define variable v-sum-type          as character    no-undo.
     3395       define variable v-ext-doc-type          as character    no-undo.
     3396       define buffer buf_wealth        for ub.wealth.
     3397       define buffer buf_wth-par       for ub.wth-par.
     3398       define buffer buf_obj-list      for obj-list.
     3399   do
     3400   for buf_wealth
     3401     , buf_wth-par
     3402     , buf_obj-list
     3403   on error undo, return error
     3404   :
     3405       for each buf_wealth no-lock
     3406           where buf_wealth.is-ser = 1
     3407       on error undo, return error
     3408       :
     3409           for each buf_wth-par no-lock
     3410               where buf_wth-par.wth-code = buf_wealth.wth-code
     3411           on error undo, return error
     3412           :
     3413               loop-sum-type:
     3414               do v-counter-sum-type = 1 to num-entries( 'рас,при,возврат,спи':U )
     3415               on error undo, return error
     3416               :
     3417                   assign
     3418                       v-sum-type = entry( v-counter-sum-type, 'рас,при,возврат,спи':U )
     3419                   .
     3420                   loop-ext-type:
     3421                   do v-counter = 1 to num-entries( 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u )
     3422                   on error undo, return error
     3423                   :
     3424                       assign
     3425                           v-ext-doc-type = entry( v-counter, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u )
     3426                       .
     3427                       if ( v-sum-type = 'при':U
     3428                       and lookup( v-ext-doc-type, 'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U ) <> 0 )
     3429                       or ( v-sum-type = 'возврат':U
     3430                       and lookup( v-ext-doc-type, 'rj,rf,rp':U ) <> 0 )
     3431                       or ( v-sum-type = 'рас':U
     3432                       and lookup( v-ext-doc-type, 'ee,ei,ej,jj,oj,ce,ef,ep':U ) <> 0 )
     3433                       or ( v-sum-type = 'спи':U
     3434                       and lookup( v-ext-doc-type, 'we,dc,dp,df':U ) <> 0 )
     3435                       or ( lookup( v-sum-type, 'рас,при':U ) <> 0
     3436                       and v-ext-doc-type = 'xc':U )
     3437                       then do:
     3438                           run fill-temp-tables-by-doc-type in this-procedure (
     3439                                 input p-obj-type
     3440                               , input p-obj-code
     3441                               , input buf_wealth.wth-code
     3442                               , input buf_wth-par.par-code
     3443                               , input v-ext-doc-type
     3444                               , input v-sum-type
     3445                               , input p-fact-order-from
     3446                               , input p-fact-order-to
     3447                               , input buf_wth-par.par-val
     3448                           ).
     3449                       end.
     3450                   end.
     3451               end.
     3452           end.
     3453       end.
     3454   end.
     3455   end procedure.
     3456   procedure fill-temp-tables-by-doc-type :
     3457   define input parameter p-obj-type           as character        no-undo.
     3458   define input parameter p-obj-code           as integer          no-undo.
     3459   define input parameter p-wth-code           as integer          no-undo.
     3460   define input parameter p-par-code           as integer          no-undo.
     3461   define input parameter p-ext-doc-type       as character        no-undo.
     3462   define input parameter p-sum-type           as character        no-undo.
     3463   define input parameter p-fact-order-from    as decimal          no-undo.
     3464   define input parameter p-fact-order-to      as decimal          no-undo.
     3465   define input parameter p-par-val            as decimal          no-undo.
     3466       define variable v-incIncmSt          as decimal      no-undo.
     3467       define variable v-incIncmLt          as decimal      no-undo.
     3468       define variable v-incRetnSt          as decimal      no-undo.
     3469       define variable v-incRetnLt          as decimal      no-undo.
     3470       define variable v-outSaleSt          as decimal      no-undo.
     3471       define variable v-outSaleLt          as decimal      no-undo.
     3472       define variable v-outSaleRb          as decimal      no-undo.
     3473       define variable v-outExchSt          as decimal      no-undo.
     3474       define variable v-outExchLt          as decimal      no-undo.
     3475       define variable v-outExchRb          as decimal      no-undo.
     3476       define variable v-payPaydDeskSt      as decimal      no-undo.
     3477       define variable v-payPaydDeskLt      as decimal      no-undo.
     3478       define variable v-payPaydDeskRb      as decimal      no-undo.
     3479       define variable v-payPaydSt          as decimal      no-undo.
     3480       define variable v-payPaydLt          as decimal      no-undo.
     3481       define variable v-payPaydRb          as decimal      no-undo.
     3482       define variable v-payExchSt          as decimal      no-undo.
     3483       define variable v-payExchLt          as decimal      no-undo.
     3484       define variable v-payExchRb          as decimal      no-undo.
     3485       define variable v-payRetnSt          as decimal      no-undo.
     3486       define variable v-payRetnLt          as decimal      no-undo.
     3487       define variable v-payRetnRb          as decimal      no-undo.
     3488       define variable v-clrRealSt          as decimal      no-undo.
     3489       define variable v-clrRealLt          as decimal      no-undo.
     3490       define variable v-clrRealRb          as decimal      no-undo.
     3491       define variable v-clrPOffSt          as decimal      no-undo.
     3492       define variable v-clrPOffLt          as decimal      no-undo.
     3493       define variable v-clrPOffRb          as decimal      no-undo.
     3494       define variable v-trsRealExpsSt      as decimal      no-undo.
     3495       define variable v-trsRealExpsLt      as decimal      no-undo.
     3496       define variable v-trsRealIncmSt      as decimal      no-undo.
     3497       define variable v-trsRealIncmLt      as decimal      no-undo.
     3498       define variable v-trsRealTrnsSt      as decimal      no-undo.
     3499       define variable v-trsRealTrnsLt      as decimal      no-undo.
     3500       define variable v-trsPOffExpsSt      as decimal      no-undo.
     3501       define variable v-trsPOffExpsLt      as decimal      no-undo.
     3502       define variable v-trsPOffExpsRb      as decimal      no-undo.
     3503       define variable v-trsPOffIncmSt      as decimal      no-undo.
     3504       define variable v-trsPOffIncmLt      as decimal      no-undo.
     3505       define variable v-trsPOffIncmRb      as decimal      no-undo.
     3506       define variable v-trsPOffTrnsSt      as decimal      no-undo.
     3507       define variable v-trsPOffTrnsLt      as decimal      no-undo.
     3508       define variable v-trsPOffTrnsRb      as decimal      no-undo.
     3509       define variable v-stkRealSt          as decimal      no-undo.
     3510       define variable v-stkPOffSt          as decimal      no-undo.
     3511       define variable v-stkRealLt          as decimal      no-undo.
     3512       define variable v-stkPOffLt          as decimal      no-undo.
     3513       define variable v-stkRealRb          as decimal      no-undo.
     3514       define variable v-stkPOffRb          as decimal      no-undo.
     3515       define variable v-arh-exists         as logical      no-undo.
     3516       define variable v-sum-St-start    as decimal      no-undo.
     3517       define variable v-sum-Lt-start    as decimal      no-undo.
     3518       define variable v-sum-Rb-start    as decimal      no-undo.
     3519       define variable v-sum-St-end      as decimal      no-undo.
     3520       define variable v-sum-Lt-end      as decimal      no-undo.
     3521       define variable v-sum-Rb-end      as decimal      no-undo.
     3522       define buffer buf_arh-wth-tot       for ub.arh-wth-tot.
     3523   do
     3524   for buf_arh-wth-tot
     3525   on error undo, return error
     3526   :
     3527       assign
     3528           v-sum-St-start = 0.0
     3529           v-sum-Lt-start = 0.0
     3530           v-sum-Rb-start = 0.0
     3531       .
     3532       find last buf_arh-wth-tot
     3533           where buf_arh-wth-tot.obj-type       = p-obj-type
     3534             and buf_arh-wth-tot.obj-code       = p-obj-code
     3535             and buf_arh-wth-tot.wth-code       = p-wth-code
     3536             and buf_arh-wth-tot.par-code       = p-par-code
     3537             and buf_arh-wth-tot.ext-doc-type   = p-ext-doc-type
     3538             and buf_arh-wth-tot.sum-type       = p-sum-type
     3539             and buf_arh-wth-tot.fact-order    <= p-fact-order-from
     3540       use-index pi
     3541       no-error.
     3542       if available buf_arh-wth-tot
     3543       then do:
     3544           assign
     3545               v-sum-St-start = buf_arh-wth-tot.in-qnty - buf_arh-wth-tot.out-qnty
     3546               v-sum-Lt-start = ( buf_arh-wth-tot.in-qnty - buf_arh-wth-tot.out-qnty ) * p-par-val
     3547               v-sum-Rb-start = buf_arh-wth-tot.in-sum-rubl - buf_arh-wth-tot.out-sum-rubl
     3548           .
     3549       end.
     3550       assign
     3551           v-sum-St-end   = 0.0
     3552           v-sum-Lt-end   = 0.0
     3553           v-sum-Rb-end   = 0.0
     3554       .
     3555       find last buf_arh-wth-tot
     3556           where buf_arh-wth-tot.obj-type       = p-obj-type
     3557             and buf_arh-wth-tot.obj-code       = p-obj-code
     3558             and buf_arh-wth-tot.wth-code       = p-wth-code
     3559             and buf_arh-wth-tot.par-code       = p-par-code
     3560             and buf_arh-wth-tot.ext-doc-type   = p-ext-doc-type
     3561             and buf_arh-wth-tot.sum-type       = p-sum-type
     3562             and buf_arh-wth-tot.fact-order    <= p-fact-order-to
     3563       use-index pi
     3564       no-error.
     3565       if available buf_arh-wth-tot
     3566       then do:
     3567           assign
     3568               v-sum-St-end   = buf_arh-wth-tot.in-qnty - buf_arh-wth-tot.out-qnty
     3569               v-sum-Lt-end   = ( buf_arh-wth-tot.in-qnty - buf_arh-wth-tot.out-qnty ) * p-par-val
     3570               v-sum-Rb-end   = buf_arh-wth-tot.in-sum-rubl - buf_arh-wth-tot.out-sum-rubl
     3571           .
     3572       end.
     3573       run rwthobxl-sheet1-add-line-data in this-procedure (
     3574             input p-obj-type
     3575           , input p-obj-code
     3576           , input p-wth-code
     3577           , input p-par-code
     3578           , input p-ext-doc-type
     3579           , input p-sum-type
     3580           , input v-sum-St-start
     3581           , input v-sum-Lt-start
     3582           , input v-sum-Rb-start
     3583       ).
     3584       run rwthobxl-sheet3-add-line-data in this-procedure (
     3585             input p-obj-type
     3586           , input p-obj-code
     3587           , input p-wth-code
     3588           , input p-par-code
     3589           , input p-ext-doc-type
     3590           , input p-sum-type
     3591           , input v-sum-St-end
     3592           , input v-sum-Lt-end
     3593           , input v-sum-Rb-end
     3594       ).
     3595       assign
     3596           v-incIncmSt     = 0.0
     3597           v-incIncmLt     = 0.0
     3598           v-incRetnSt     = 0.0
     3599           v-incRetnLt     = 0.0
     3600           v-outSaleSt     = 0.0
     3601           v-outSaleLt     = 0.0
     3602           v-outSaleRb     = 0.0
     3603           v-outExchSt     = 0.0
     3604           v-outExchLt     = 0.0
     3605           v-outExchRb     = 0.0
     3606           v-payPaydDeskSt = 0.0
     3607           v-payPaydDeskLt = 0.0
     3608           v-payPaydDeskRb = 0.0
     3609           v-payPaydSt     = 0.0
     3610           v-payPaydLt     = 0.0
     3611           v-payPaydRb     = 0.0
     3612           v-payExchSt     = 0.0
     3613           v-payExchLt     = 0.0
     3614           v-payExchRb     = 0.0
     3615           v-payRetnSt     = 0.0
     3616           v-payRetnLt     = 0.0
     3617           v-payRetnRb     = 0.0
     3618           v-clrRealSt     = 0.0
     3619           v-clrRealLt     = 0.0
     3620           v-clrRealRb     = 0.0
     3621           v-clrPOffSt     = 0.0
     3622           v-clrPOffLt     = 0.0
     3623           v-clrPOffRb     = 0.0
     3624           v-trsRealExpsSt = 0.0
     3625           v-trsRealExpsLt = 0.0
     3626           v-trsRealIncmSt = 0.0
     3627           v-trsRealIncmLt = 0.0
     3628           v-trsRealTrnsSt = 0.0
     3629           v-trsRealTrnsLt = 0.0
     3630           v-trsPOffExpsSt = 0.0
     3631           v-trsPOffExpsLt = 0.0
     3632           v-trsPOffExpsRb = 0.0
     3633           v-trsPOffIncmSt = 0.0
     3634           v-trsPOffIncmLt = 0.0
     3635           v-trsPOffIncmRb = 0.0
     3636           v-trsPOffTrnsSt = 0.0
     3637           v-trsPOffTrnsLt = 0.0
     3638           v-trsPOffTrnsRb = 0.0
     3639       .
     3640       case p-ext-doc-type
     3641       :
     3642           when 'ie':U
     3643           then do:
     3644               assign
     3645                   v-incIncmSt = v-sum-St-end - v-sum-St-start
     3646                   v-incIncmLt = v-sum-Lt-end - v-sum-Lt-start
     3647               .
     3648           end.
     3649           when 'ee':U
     3650           then do:
     3651               assign
     3652                   v-outSaleSt = - ( v-sum-St-end - v-sum-St-start )
     3653                   v-outSaleLt = - ( v-sum-Lt-end - v-sum-Lt-start )
     3654                   v-outSaleRb = - ( v-sum-Rb-end - v-sum-Rb-start )
     3655               .
     3656           end.
     3657           when 'pc':U
     3658           then do:
     3659               assign
     3660                   v-payPaydDeskSt = v-sum-St-end - v-sum-St-start
     3661                   v-payPaydDeskLt = v-sum-Lt-end - v-sum-Lt-start
     3662                   v-payPaydDeskRb = v-sum-Rb-end - v-sum-Rb-start
     3663               .
     3664           end.
     3665           when 'ps':U
     3666           then do:
     3667               assign
     3668                   v-payPaydSt     = v-sum-St-end - v-sum-St-start
     3669                   v-payPaydLt     = v-sum-Lt-end - v-sum-Lt-start
     3670                   v-payPaydRb     = v-sum-Rb-end - v-sum-Rb-start
     3671               .
     3672           end.
     3673           when 'pz':U
     3674           then do:
     3675               assign
     3676                   v-payRetnSt     = v-sum-St-end - v-sum-St-start
     3677                   v-payRetnLt     = v-sum-Lt-end - v-sum-Lt-start
     3678                   v-payRetnRb     = v-sum-Rb-end - v-sum-Rb-start
     3679               .
     3680           end.
     3681           when 'df':U
     3682           then do:
     3683               assign
     3684                   v-clrRealSt = - ( v-sum-St-end - v-sum-St-start )
     3685                   v-clrRealLt = - ( v-sum-Lt-end - v-sum-Lt-start )
     3686                   v-clrRealRb = - ( v-sum-Rb-end - v-sum-Rb-start )
     3687               .
     3688           end.
     3689           when 'dp':U
     3690           then do:
     3691               assign
     3692                   v-clrPOffSt = - ( v-sum-St-end - v-sum-St-start )
     3693                   v-clrPOffLt = - ( v-sum-Lt-end - v-sum-Lt-start )
     3694                   v-clrPOffRb = - ( v-sum-Rb-end - v-sum-Rb-start )
     3695               .
     3696           end.
     3697           when 'ip':U
     3698           then do:
     3699               assign
     3700                   v-trsPOffIncmSt =  ( v-sum-St-end - v-sum-St-start )
     3701                   v-trsPOffIncmLt =  ( v-sum-Lt-end - v-sum-Lt-start )
     3702                   v-trsPOffIncmRb =  ( v-sum-Rb-end - v-sum-Rb-start )
     3703               .
     3704           end.
     3705           when 'ep':U
     3706           then do:
     3707               assign
     3708                   v-trsPOffExpsSt = - ( v-sum-St-end - v-sum-St-start )
     3709                   v-trsPOffExpsLt = - ( v-sum-Lt-end - v-sum-Lt-start )
     3710                   v-trsPOffExpsRb = - ( v-sum-Rb-end - v-sum-Rb-start )
     3711               .
     3712           end.
     3713           when 'rp':U
     3714           then do:
     3715               assign
     3716                   v-trsPOffTrnsSt = v-sum-St-end - v-sum-St-start
     3717                   v-trsPOffTrnsLt = v-sum-Lt-end - v-sum-Lt-start
     3718                   v-trsPOffTrnsRb = v-sum-Rb-end - v-sum-Rb-start
     3719               .
     3720           end.
     3721           when 'ff':U
     3722           then do:
     3723               assign
     3724                   v-trsRealIncmSt = v-sum-St-end - v-sum-St-start
     3725                   v-trsRealIncmLt = v-sum-Lt-end - v-sum-Lt-start
     3726               .
     3727           end.
     3728           when 'ef':U
     3729           then do:
     3730               assign
     3731                   v-trsRealExpsSt = - ( v-sum-St-end - v-sum-St-start )
     3732                   v-trsRealExpsLt = - ( v-sum-Lt-end - v-sum-Lt-start )
     3733               .
     3734           end.
     3735           when 'rf':U
     3736           then do:
     3737               assign
     3738                   v-trsRealTrnsSt = v-sum-St-end - v-sum-St-start
     3739                   v-trsRealTrnsLt = v-sum-Lt-end - v-sum-Lt-start
     3740               .
     3741           end.
     3742           when 'xc':U
     3743           then do:
     3744               if p-sum-type = 'при':U
     3745               then do:
     3746                   assign
     3747                       v-payExchSt = v-sum-St-end - v-sum-St-start
     3748                       v-payExchLt = v-sum-Lt-end - v-sum-Lt-start
     3749                       v-payExchRb = v-sum-Rb-end - v-sum-Rb-start
     3750                   .
     3751               end.
     3752               else do:
     3753                   assign
     3754                       v-outExchSt = - ( v-sum-St-end - v-sum-St-start )
     3755                       v-outExchLt = - ( v-sum-Lt-end - v-sum-Lt-start )
     3756                       v-outExchRb = - ( v-sum-Rb-end - v-sum-Rb-start )
     3757                   .
     3758               end.
     3759           end.
     3760       end case.
     3761       run rwthobxl-sheet2-add-line-data in this-procedure (
     3762             input p-obj-type
     3763           , input p-obj-code
     3764           , input p-wth-code
     3765           , input p-par-code
     3766           , input v-incIncmSt
     3767           , input v-incIncmLt
     3768           , input v-incRetnSt
     3769           , input v-incRetnLt
     3770           , input v-outSaleSt
     3771           , input v-outSaleLt
     3772           , input v-outSaleRb
     3773           , input v-outExchSt
     3774           , input v-outExchLt
     3775           , input v-outExchRb
     3776           , input v-payPaydDeskSt
     3777           , input v-payPaydDeskLt
     3778           , input v-payPaydDeskRb
     3779           , input v-payPaydSt
     3780           , input v-payPaydLt
     3781           , input v-payPaydRb
     3782           , input v-payExchSt
     3783           , input v-payExchLt
     3784           , input v-payExchRb
     3785           , input v-payRetnSt
     3786           , input v-payRetnLt
     3787           , input v-payRetnRb
     3788           , input v-clrRealSt
     3789           , input v-clrRealLt
     3790           , input v-clrRealRb
     3791           , input v-clrPOffSt
     3792           , input v-clrPOffLt
     3793           , input v-clrPOffRb
     3794           , input v-trsRealExpsSt
     3795           , input v-trsRealExpsLt
     3796           , input v-trsRealIncmSt
     3797           , input v-trsRealIncmLt
     3798           , input v-trsRealTrnsSt
     3799           , input v-trsRealTrnsLt
     3800           , input v-trsPOffExpsSt
     3801           , input v-trsPOffExpsLt
     3802           , input v-trsPOffExpsRb
     3803           , input v-trsPOffIncmSt
     3804           , input v-trsPOffIncmLt
     3805           , input v-trsPOffIncmRb
     3806           , input v-trsPOffTrnsSt
     3807           , input v-trsPOffTrnsLt
     3808           , input v-trsPOffTrnsRb
     3809       ).
     3810   end.
     3811   end procedure.
     3812   procedure get-hide-list :
     3813   define input parameter p-ext-doc-type-list  as character        no-undo.
     3814   define input parameter p-ob-liter           as logical          no-undo.
     3815   define input parameter p-ob-rubl            as logical          no-undo.
     3816   define input parameter p-ob-tal             as logical          no-undo.
     3817   define output parameter p-hide-list         as character        no-undo.
     3818       define variable v-counter       as integer      no-undo.
     3819       define variable v-rec-amount    as integer      no-undo.
     3820       define variable v-ext-doc-type  as character    no-undo.
     3821       define buffer buf_temp_hideCol      for temp_hideCol.
     3822   do
     3823   for buf_temp_hideCol
     3824   on error undo, return error
     3825   :
     3826       empty temp-table buf_temp_hideCol.
     3827       if p-ob-tal = no
     3828       then do:
     3829           assign
     3830               v-rec-amount =  num-entries( "incIncmSt,incRetnSt,outSaleSt,outExchSt,payPaydDeskSt,payPaydSt,payExchSt,payRetnSt,clrRealSt,clrPOffSt,trsRealExpsSt,trsRealIncmSt,trsRealTrnsSt,trsPOffExpsSt,trsPOffIncmSt,trsPOffTrnsSt":U )
     3831           .
     3832           do v-counter = 1 to v-rec-amount
     3833           :
     3834               run hide-list-add-item in this-procedure ( input entry( v-counter, "incIncmSt,incRetnSt,outSaleSt,outExchSt,payPaydDeskSt,payPaydSt,payExchSt,payRetnSt,clrRealSt,clrPOffSt,trsRealExpsSt,trsRealIncmSt,trsRealTrnsSt,trsPOffExpsSt,trsPOffIncmSt,trsPOffTrnsSt":U ) ).
     3835           end.
     3836       end.
     3837       if p-ob-liter = no
     3838       then do:
     3839           assign
     3840               v-rec-amount =  num-entries( "incIncmLt,incRetnLt,outSaleLt,outExchLt,payPaydDeskLt,payPaydLt,payExchLt,payRetnLt,clrRealLt,clrPOffLt,trsRealExpsLt,trsRealIncmLt,trsRealTrnsLt,trsPOffExpsLt,trsPOffIncmLt,trsPOffTrnsLt":U )
     3841           .
     3842           do v-counter = 1 to v-rec-amount
     3843           :
     3844               run hide-list-add-item in this-procedure ( input entry( v-counter, "incIncmLt,incRetnLt,outSaleLt,outExchLt,payPaydDeskLt,payPaydLt,payExchLt,payRetnLt,clrRealLt,clrPOffLt,trsRealExpsLt,trsRealIncmLt,trsRealTrnsLt,trsPOffExpsLt,trsPOffIncmLt,trsPOffTrnsLt":U ) ).
     3845           end.
     3846       end.
     3847       if p-ob-rubl  = no
     3848       then do:
     3849           assign
     3850               v-rec-amount =  num-entries( "outSaleRb,outExchRb,payPaydRb,payExchRb,payPaydDeskRb,payRetnRb,clrRealRb,clrPOffRb,trsPOffExpsRb,trsPOffIncmRb,trsPOffTrnsRb":U )
     3851           .
     3852           do v-counter = 1 to v-rec-amount
     3853           :
     3854               run hide-list-add-item in this-procedure ( input entry( v-counter, "outSaleRb,outExchRb,payPaydRb,payExchRb,payPaydDeskRb,payRetnRb,clrRealRb,clrPOffRb,trsPOffExpsRb,trsPOffIncmRb,trsPOffTrnsRb":U ) ).
     3855           end.
     3856       end.
     3857       if p-ext-doc-type-list <> "":U
     3858       then do:
     3859           assign
     3860               v-rec-amount =  num-entries( 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u )
     3861           .
     3862           do v-counter = 1 to v-rec-amount
     3863           :
     3864               assign
     3865                   v-ext-doc-type = entry( v-counter, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u )
     3866               .
     3867               if lookup( v-ext-doc-type, p-ext-doc-type-list ) = 0
     3868               then do:
     3869                   case v-ext-doc-type
     3870                   :
     3871                       when 'ie':U
     3872                       then do:
     3873                           run hide-list-add-item in this-procedure ( input "incIncmSt":U ).
     3874                           run hide-list-add-item in this-procedure ( input "incIncmLt":U ).
     3875                       end.
     3876                       when 'ee':U
     3877                       then do:
     3878                           run hide-list-add-item in this-procedure ( input "outSaleSt":U ).
     3879                           run hide-list-add-item in this-procedure ( input "outSaleLt":U ).
     3880                       end.
     3881                       when 'pc':U
     3882                       then do:
     3883                           run hide-list-add-item in this-procedure ( input "payPaydDeskSt":U ).
     3884                           run hide-list-add-item in this-procedure ( input "payPaydDeskLt":U ).
     3885                           run hide-list-add-item in this-procedure ( input "payPaydDeskRb":U ).
     3886                       end.
     3887                       when 'ps':U
     3888                       then do:
     3889                           run hide-list-add-item in this-procedure ( input "payPaydSt":U ).
     3890                           run hide-list-add-item in this-procedure ( input "payPaydLt":U ).
     3891                           run hide-list-add-item in this-procedure ( input "payPaydRb":U ).
     3892                       end.
     3893                       when 'pz':U
     3894                       then do:
     3895                           run hide-list-add-item in this-procedure ( input "payRetnSt":U ).
     3896                           run hide-list-add-item in this-procedure ( input "payRetnLt":U ).
     3897                           run hide-list-add-item in this-procedure ( input "payRetnRb":U ).
     3898                       end.
     3899                       when 'df':U
     3900                       then do:
     3901                           run hide-list-add-item in this-procedure ( input "clrRealSt":U ).
     3902                           run hide-list-add-item in this-procedure ( input "clrRealLt":U ).
     3903                           run hide-list-add-item in this-procedure ( input "clrRealRb":U ).
     3904                       end.
     3905                       when 'dp':U
     3906                       then do:
     3907                           run hide-list-add-item in this-procedure ( input "clrPOffSt":U ).
     3908                           run hide-list-add-item in this-procedure ( input "clrPOffLt":U ).
     3909                           run hide-list-add-item in this-procedure ( input "clrPOffRb":U ).
     3910                       end.
     3911                       when 'ip':U
     3912                       then do:
     3913                           run hide-list-add-item in this-procedure ( input "trsPOffIncmSt":U ).
     3914                           run hide-list-add-item in this-procedure ( input "trsPOffIncmLt":U ).
     3915                           run hide-list-add-item in this-procedure ( input "trsPOffIncmRb":U ).
     3916                       end.
     3917                       when 'ep':U
     3918                       then do:
     3919                           run hide-list-add-item in this-procedure ( input "trsPOffExpsSt":U ).
     3920                           run hide-list-add-item in this-procedure ( input "trsPOffExpsLt":U ).
     3921                           run hide-list-add-item in this-procedure ( input "trsPOffExpsRb":U ).
     3922                       end.
     3923                       when 'rp':U
     3924                       then do:
     3925                           run hide-list-add-item in this-procedure ( input "trsPOffTrnsSt":U ).
     3926                           run hide-list-add-item in this-procedure ( input "trsPOffTrnsLt":U ).
     3927                           run hide-list-add-item in this-procedure ( input "trsPOffTrnsRb":U ).
     3928                       end.
     3929                       when 'ff':U
     3930                       then do:
     3931                           run hide-list-add-item in this-procedure ( input "trsRealIncmSt":U ).
     3932                           run hide-list-add-item in this-procedure ( input "trsRealIncmLt":U ).
     3933                       end.
     3934                       when 'ef':U
     3935                       then do:
     3936                           run hide-list-add-item in this-procedure ( input "trsRealExpsSt":U ).
     3937                           run hide-list-add-item in this-procedure ( input "trsRealExpsLt":U ).
     3938                       end.
     3939                       when 'rf':U
     3940                       then do:
     3941                           run hide-list-add-item in this-procedure ( input "trsRealTrnsSt":U ).
     3942                           run hide-list-add-item in this-procedure ( input "trsRealTrnsLt":U ).
     3943                       end.
     3944                       when 'xc':U
     3945                       then do:
     3946                           run hide-list-add-item in this-procedure ( input "payExchSt":U ).
     3947                           run hide-list-add-item in this-procedure ( input "payExchLt":U ).
     3948                           run hide-list-add-item in this-procedure ( input "payExchRb":U ).
     3949                           run hide-list-add-item in this-procedure ( input "outExchSt":U ).
     3950                           run hide-list-add-item in this-procedure ( input "outExchLt":U ).
     3951                           run hide-list-add-item in this-procedure ( input "outExchRb":U ).
     3952                       end.
     3953                   end case.
     3954               end.
     3955           end.
     3956       end.
     3957       assign
     3958           p-hide-list = "":U
     3959       .
     3960       for each buf_temp_hideCol
     3961       on error undo, return error
     3962       :
     3963           assign
     3964               p-hide-list = substitute( "&1&2&3"
     3965                                       , p-hide-list
     3966                                       , ( if p-hide-list = "":U then "":U else ",":U )
     3967                                       , buf_temp_hideCol.colName )
     3968           .
     3969       end.
     3970   end.
     3971   end procedure.
     3972   procedure hide-list-add-item :
     3973   define input parameter p-item-name  as character        no-undo.
     3974       define buffer buf_temp_hideCol      for temp_hideCol.
     3975   do
     3976   for buf_temp_hideCol
     3977   on error undo, return error
     3978   :
     3979       find first buf_temp_hideCol
     3980            where buf_temp_hideCol.colName = p-item-name
     3981       no-error.
     3982       if not available buf_temp_hideCol
     3983       then do:
     3984           create buf_temp_hideCol.
     3985           assign
     3986               buf_temp_hideCol.colName = p-item-name
     3987           .
     3988       end.
     3989   end.
     3990   end procedure.
     3991   procedure write-stLtRbList :
     3992   define input parameter p-ob-tal   as logical          no-undo.
     3993   define input parameter p-ob-liter as logical          no-undo.
     3994   define input parameter p-ob-rubl  as logical          no-undo.
     3995       define variable v-stLtRbList    as character    no-undo.
     3996       define variable v-list-num      as integer      no-undo.
     3997   do
     3998   on error undo, return error
     3999   :
     4000       assign
     4001           v-stLtRbList = "":U
     4002       .
     4003       if p-ob-tal = yes
     4004       then do:
     4005           assign
     4006               v-stLtRbList = substitute( "&1&2&3":U
     4007                               , v-stLtRbList
     4008                               , ( if v-stLtRbList = "":U then "":U else ",":U )
     4009                               , "количестве талонов"
     4010                               )
     4011           .
     4012       end.
     4013       if p-ob-liter = yes
     4014       then do:
     4015           assign
     4016               v-stLtRbList = substitute( "&1&2&3":U
     4017                               , v-stLtRbList
     4018                               , ( if v-stLtRbList = "":U then "":U else ",":U )
     4019                               , "л топлива"
     4020                               )
     4021           .
     4022       end.
     4023       if p-ob-rubl = yes
     4024       then do:
     4025           assign
     4026               v-stLtRbList = substitute( "&1&2&3":U
     4027                               , v-stLtRbList
     4028                               , ( if v-stLtRbList = "":U then "":U else ",":U )
     4029                               , "суммах в рубл"
     4030                               )
     4031           .
     4032       end.
     4033                   run rwthobxl-write-cell-data in this-procedure (
     4034                     input "НачалоПериода_showStLtRb1":U
     4035                   , input v-stLtRbList
     4036               ).
     4037   end.
     4038   end procedure.
