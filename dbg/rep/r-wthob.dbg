      172   procedure create_obj-list :
      173      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      174      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      175      do
      176      on error undo, return error return-value
      177      :
      178         define buffer cli-obj for ub.clients .
      179         define variable p-var as integer no-undo .
      180         define buffer buf_obj-list for obj-list .
      181         find last buf_obj-list  use-index pi no-error .
      182         if available buf_obj-list
      183         then
      184            p-var = buf_obj-list.obj-id + 1.
      185         else
      186            p-var = 1.
      187         find first cli-obj where
      188                   cli-obj.obj-type = p-obj-type
      189               and cli-obj.obj-code = p-obj-code
      190         no-lock no-error.
      191         if available cli-obj
      192         then do:
      193            create buf_obj-list.
      194            assign
      195               buf_obj-list.obj-id   = p-var
      196               buf_obj-list.obj-code = cli-obj.obj-code
      197               buf_obj-list.obj-type = cli-obj.obj-type
      198               buf_obj-list.obj-name = cli-obj.obj-name
      199               buf_obj-list.db-num   = cli-obj.db-num
      200            .
      201         end.
      202      end.
      203   end.
