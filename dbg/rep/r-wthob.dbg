     3169       .
     3170   end.
     3171   end procedure.
     3172   procedure rwthobxl-sheet3-write-line-format :
     3173   define input parameter p-fmt-label       as character  no-undo.
     3174       define buffer buf_temp_sheet3_line-data        for temp_sheet3_line-data.
