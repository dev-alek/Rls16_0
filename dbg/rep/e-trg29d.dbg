      677   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   procedure gen-key-rec :
      679     define input  parameter p-tbl-name    as character no-undo.
      680     define input  parameter p-bh_tbl-name as handle    no-undo.
      681     define output parameter p-key-rec     as character no-undo.
      682     do
      683     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      684     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      685     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      686     :
      687       define variable fh               as handle    no-undo .
      688       define variable v-ok             as logical   no-undo .
      689       define variable v-inform         as character no-undo .
      690       define variable v-ind            as integer   no-undo .
      691       define variable v-idx-field-qnty as integer   no-undo .
      692       if p-tbl-name = ?
      693         or p-tbl-name = "":U
      694       then do:
      695         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info13 ).
      696       end.
      697       if not p-bh_tbl-name:available then do:
      698         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info13, p-tbl-name ).
      699       end.
      700       assign
      701         p-key-rec = p-tbl-name
      702         v-inform  = p-bh_tbl-name:index-information(1)
      703         v-ind     = 2
      704       .
      705       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      706       on error undo, return error
      707       :
      708         assign
      709           v-inform = p-bh_tbl-name:index-information( v-ind )
      710           v-ind    = v-ind + 1
      711         .
      712       end.
      713       if v-inform = ?
      714         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      715         or entry( 3, v-inform, ",":U ) <> "1":U
      716       then do:
      717         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, p-tbl-name ).
      718       end.
      719       else do:
      720         assign
      721           v-idx-field-qnty = num-entries( v-inform ) - 4
      722         .
      723         if v-idx-field-qnty < 2 then do:
      724           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, p-tbl-name ).
      725         end.
      726         do v-ind = 1 to v-idx-field-qnty by 2
      727         on error undo, return error
      728         :
      729           assign
      730             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      731             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      732           .
      733         end.
      734       end.
      735       if p-key-rec = ? then do:
      736         assign
      737           p-key-rec = "":U
      738         .
      739         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info13, p-tbl-name ).
      740       end.
      741     end.
      742     return.
      743   end procedure.
      744   procedure gen-where-keyr-tab :
      745     define input  parameter i-tableSerach as character no-undo.
      746     define input  parameter i-tablekey   as character  no-undo.
      747     define input  parameter p-key-rec    as character  no-undo.
      748     define input  parameter p-key-handle as handle     no-undo .
      749     define input  parameter p-db-name    as character  no-undo .
      750     define input  parameter p-tt-handle  as handle     no-undo .
      751     define output parameter o-Where      as character  no-undo.
      752     do
      753     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      754     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      755     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      756     :
      757       define variable v-full-tbl-name  as character no-undo .
      758       define variable bh_tbl-name      as handle    no-undo .
      759       define variable fh_key           as handle    no-undo .
      760       define variable fh_search        as handle    no-undo .
      761       define variable v-field-num      as integer   no-undo .
      762       define variable v-count-fld      as integer   no-undo .
      763       define variable v-inform         as character no-undo .
      764       define variable v-ind            as integer   no-undo .
      765       define variable v-idx-field-qnty as integer   no-undo .
      766       define variable v-field-name     as character no-undo .
      767       define variable v-field-val      as character no-undo .
      768       define variable v-word-link      as character no-undo .
      769       define variable vTable           as character no-undo.
      770       define variable bh_tbl-key       as handle    no-undo .
      771       assign
      772         p-key-rec = trim( p-key-rec )
      773       .
      774       if p-key-handle <> ? then do:
      775         if not valid-handle(p-key-handle)
      776            or p-key-handle:type <> "buffer"
      777         then do:
      778           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info13 ).
      779         end.
      780         if num-entries( p-key-rec, chr(3) ) > 1
      781           or p-key-rec = ?
      782           or p-key-rec = "":U
      783         then do:
      784           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info13, p-key-rec ).
      785         end.
      786       end.
      787       else do:
      788         if p-key-rec = ?
      789           or p-key-rec = "":U
      790         then do:
      791           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info13 ).
      792         end.
      793       end.
      794       assign
      795         vTable = entry( 1 , p-key-rec, chr(3) )
      796       .
      797       if p-tt-handle <> ?
      798         and ( not valid-handle(p-tt-handle)
      799               or p-tt-handle:type <> "buffer"
      800             )
      801       then do:
      802         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info13, vTable, chr(10) ).
      803       end.
      804       if p-tt-handle = ? then do:
      805         assign
      806           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      807         .
      808         create buffer bh_tbl-name for table v-full-tbl-name .
      809       end.
      810       else do:
      811         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      812       end.
      813       assign
      814         v-inform = bh_tbl-name:index-information(1)
      815         v-ind    = 2
      816       .
      817       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      818       on error undo, return error
      819       :
      820         assign
      821           v-inform = bh_tbl-name:index-information( v-ind )
      822           v-ind    = v-ind + 1
      823         .
      824       end.
      825       if v-inform = ?
      826         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      827         or entry( 3, v-inform, ",":U ) <> "1":U
      828       then do:
      829         delete object bh_tbl-name no-error.
      830         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info13, vTable ).
      831       end.
      832       assign
      833         v-idx-field-qnty = num-entries( v-inform ) - 4
      834       .
      835       if v-idx-field-qnty < 2 then do:
      836         delete object bh_tbl-name no-error.
      837         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, vTable ).
      838       end.
      839       assign
      840         o-where     = "where":U
      841         v-word-link = "":U
      842         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      843         v-count-fld = 0
      844       .
      845       if i-tablekey ne "" and i-tablekey ne ?
      846       then do:
      847         assign
      848           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      849         .
      850         create buffer bh_tbl-key for table v-full-tbl-name .
      851       end.
      852       if i-tableSerach ne "" and i-tableSerach ne ?
      853       then do:
      854         delete object bh_tbl-name no-error.
      855         assign
      856           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      857         .
      858         create buffer bh_tbl-name for table v-full-tbl-name .
      859       end.
      860       block_where:
      861       do v-ind = 1 to v-idx-field-qnty by 2
      862       on error undo, return error
      863       :
      864         assign
      865           v-count-fld = v-count-fld + 1
      866         .
      867         if p-key-handle = ?
      868           and v-count-fld > v-field-num
      869         then do:
      870           leave block_where.
      871         end.
      872         define variable VfieldKeyTable as handle no-undo.
      873         assign
      874           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      875           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      876         .
      877         if     bh_tbl-key ne ?
      878         then do:
      879            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      880            if VfieldKeyTable eq ?
      881            then next block_where.
      882         end.
      883         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      884         then
      885            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      886         else
      887            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      888         if p-key-handle = ? then do:
      889           assign
      890             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      891           .
      892         end.
      893         else do:
      894           assign
      895             fh_key = p-key-handle:buffer-field( v-field-name )
      896           .
      897           if fh_key = ?
      898             or not valid-handle( fh_key )
      899           then do:
      900             delete object bh_tbl-name.
      901             if     bh_tbl-key ne ?
      902             then
      903                delete object bh_tbl-key.
      904             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info13, p-key-handle:name, v-field-name ).
      905           end.
      906           assign
      907             v-field-val = fh_key:buffer-value
      908           .
      909         end.
      910         if fh_search:data-type ="character":U then do:
      911           assign
      912             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      913             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      914             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      915             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      916             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      917             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      918             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      919             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      920             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      921             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      922             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      923             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      924             v-field-val = substitute( '"&1"', v-field-val )
      925           .
      926         end.
      927         assign
      928           o-where = substitute( "&1 &2", o-where, v-field-val )
      929         .
      930         if v-word-link = "":U then do:
      931           assign
      932             v-word-link = "and":U
      933           .
      934         end.
      935       end.
      936       delete object bh_tbl-name.
      937       if     bh_tbl-key ne ?
      938       then
      939          delete object bh_tbl-key.
      940       if p-key-handle = ?
      941         and v-count-fld <> v-field-num
      942       then do:
      943         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info13, vTable ).
      944       end.
      945     end.
      946   end procedure.
      947   procedure gen-hn-keyr-tab :
      948     define input  parameter i-tableSerach as character no-undo.
      949     define input  parameter i-tablekey   as character no-undo.
      950     define input  parameter p-key-rec    as character no-undo.
      951     define input  parameter p-key-handle as handle    no-undo .
      952     define input  parameter p-db-name    as character no-undo .
      953     define input  parameter p-tt-handle  as handle    no-undo .
      954     define input  parameter p-stts-lock  as integer   no-undo .
      955     define output parameter o-hn         as handle    no-undo.
      956     define variable v-full-tbl-name as character no-undo.
      957     define variable v-where         as character no-undo.
      958     define variable bh_tbl-name     as handle    no-undo.
      959     define variable vTable          as character no-undo.
      960     do
      961     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      962     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      963     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      964         run gen-where-keyr-tab(i-tableSerach,
      965                                i-tablekey,
      966                                p-key-rec,
      967                                p-key-handle,
      968                                p-db-name,
      969                                p-tt-handle,
      970                                output v-where).
      971         if i-tableSerach ne "" and i-tableSerach ne ?
      972         then do:
      973            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      974            create buffer bh_tbl-name for table v-full-tbl-name .
      975         end.
      976         else do:
      977            if p-tt-handle = ? then do:
      978               assign
      979                  vTable = entry( 1 , p-key-rec, chr(3) )
      980               .
      981               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      982               create buffer bh_tbl-name for table v-full-tbl-name .
      983            end.
      984            else do:
      985               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      986            end.
      987         end.
      988         if p-tt-handle = ? then do:
      989            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      990         end.
      991         else do:
      992            bh_tbl-name:find-first( v-where ) no-error .
      993         end.
      994         o-hn = bh_tbl-name.
      995      end.
      996   end procedure.
      997   procedure gen-hn-keyr :
      998     define input  parameter p-key-rec    as character no-undo.
      999     define input  parameter p-key-handle as handle    no-undo .
     1000     define input  parameter p-db-name    as character no-undo .
     1001     define input  parameter p-tt-handle  as handle    no-undo .
     1002     define input  parameter p-stts-lock  as integer   no-undo .
     1003     define output parameter o-hn         as handle    no-undo.
     1004     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1005   end.
     1006   procedure gen-row-keyr :
     1007     define input  parameter p-key-rec    as character no-undo.
     1008     define input  parameter p-key-handle as handle    no-undo .
     1009     define input  parameter p-db-name    as character no-undo .
     1010     define input  parameter p-tt-handle  as handle    no-undo .
     1011     define input  parameter p-stts-lock  as integer   no-undo .
     1012     define output parameter p-tbl-row    as rowid     no-undo.
     1013     define output parameter p-tbl-name   as character no-undo.
     1014     define variable vHn as handle no-undo.
     1015       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1016       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1017       p-tbl-name =  vHn:table.
     1018       delete object vHn no-error.
     1019     if p-tbl-row = ? then do:
     1020       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info13, p-tbl-name, p-key-rec ).
     1021     end.
     1022     else do:
     1023       return.
     1024     end.
     1025   end procedure.
     1026   procedure gen-key-fv :
     1027     define input  parameter p-key-rec    as character no-undo .
     1028     define output parameter p-field-list as character no-undo .
     1029     define output parameter p-value-list as character no-undo.
     1030     do
     1031     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1032     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1033     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1034     :
     1035       define variable v-full-tbl-name  as character no-undo .
     1036       define variable bh_tbl-name      as handle    no-undo .
     1037       define variable v-tbl-name       as character no-undo .
     1038       define variable v-field-num      as integer   no-undo .
     1039       define variable v-count-fld      as integer   no-undo .
     1040       define variable v-inform         as character no-undo .
     1041       define variable v-ind            as integer   no-undo .
     1042       define variable v-idx-field-qnty as integer   no-undo .
     1043       define variable v-delim-key      as character no-undo .
     1044       if p-key-rec = ?
     1045         or p-key-rec = "":U
     1046       then do:
     1047         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info13 ).
     1048       end.
     1049       assign
     1050         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1051         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1052       .
     1053       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1054       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info13 ).
     1055       assign
     1056         v-inform = bh_tbl-name:index-information(1)
     1057         v-ind    = 2
     1058       .
     1059       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1060       on error undo, return error
     1061       :
     1062         assign
     1063           v-inform = bh_tbl-name:index-information( v-ind )
     1064           v-ind    = v-ind + 1
     1065         .
     1066       end.
     1067       if v-inform = ?
     1068         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1069         or entry( 3, v-inform, ",":U ) <> "1":U
     1070       then do:
     1071         delete object bh_tbl-name no-error.
     1072         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, v-tbl-name ).
     1073       end.
     1074       assign
     1075         v-idx-field-qnty = num-entries( v-inform ) - 4
     1076       .
     1077       if v-idx-field-qnty < 2 then do:
     1078         delete object bh_tbl-name no-error.
     1079         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, v-tbl-name ).
     1080       end.
     1081       assign
     1082         p-field-list = "":U
     1083         p-value-list = "":U
     1084         v-delim-key  = "":U
     1085         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1086         v-count-fld  = 0
     1087       .
     1088       block_where:
     1089       do v-ind = 1 to v-idx-field-qnty by 2
     1090       on error undo, return error
     1091       :
     1092         assign
     1093           v-count-fld = v-count-fld + 1
     1094         .
     1095         if v-count-fld > v-field-num then do:
     1096           leave block_where.
     1097         end.
     1098         assign
     1099           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1100           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1101         .
     1102         if v-ind = 1 then do:
     1103           assign
     1104             v-delim-key = chr(3)
     1105           .
     1106         end.
     1107       end.
     1108       delete object bh_tbl-name.
     1109       if v-count-fld <> v-field-num then do:
     1110         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info13, v-tbl-name ).
     1111       end.
     1112     end.
     1113   end procedure.
     1114   procedure gen-key-field :
     1115     define input  parameter p-table      as character no-undo .
     1116     define output parameter p-field-list as character no-undo .
     1117     do
     1118     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1119     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1120     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1121     :
     1122       define variable v-full-tbl-name  as character no-undo .
     1123       define variable bh_tbl-name      as handle    no-undo .
     1124       define variable v-tbl-name       as character no-undo .
     1125       define variable v-field-num      as integer   no-undo .
     1126       define variable v-count-fld      as integer   no-undo .
     1127       define variable v-inform         as character no-undo .
     1128       define variable v-ind            as integer   no-undo .
     1129       define variable v-idx-field-qnty as integer   no-undo .
     1130       define variable v-delim-key      as character no-undo .
     1131       if p-table = ?
     1132         or p-table = "":U
     1133       then do:
     1134         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info13 ).
     1135       end.
     1136       assign
     1137         v-tbl-name      = p-table
     1138         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1139       .
     1140       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1141       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info13 ).
     1142       assign
     1143         v-inform = bh_tbl-name:index-information(1)
     1144         v-ind    = 2
     1145       .
     1146       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1147       on error undo, return error
     1148       :
     1149         assign
     1150           v-inform = bh_tbl-name:index-information( v-ind )
     1151           v-ind    = v-ind + 1
     1152         .
     1153       end.
     1154       if v-inform = ?
     1155         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1156         or entry( 3, v-inform, ",":U ) <> "1":U
     1157       then do:
     1158         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info13, v-tbl-name ).
     1159       end.
     1160       assign
     1161         v-idx-field-qnty = num-entries( v-inform ) - 4
     1162       .
     1163       if v-idx-field-qnty < 2 then do:
     1164         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info13, v-inform, v-tbl-name ).
     1165       end.
     1166       assign
     1167         p-field-list = "":U
     1168         v-delim-key  = "":U
     1169         v-count-fld  = 0
     1170       .
     1171       block_where:
     1172       do v-ind = 1 to v-idx-field-qnty by 2
     1173       on error undo, return error
     1174       :
     1175         assign
     1176           v-count-fld = v-count-fld + 1
     1177         .
     1178         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1179         if v-ind = 1 then do:
     1180           assign
     1181             v-delim-key = chr(3)
     1182           .
     1183         end.
     1184       end.
     1185       delete object bh_tbl-name.
     1186     end.
     1187   end procedure.
     1188   define variable v-profile-id as integer no-undo .
     1189   define variable v-output-type as character no-undo .
     1190   define variable v-price-type as integer no-undo .
     1191   define variable v-val-type as character no-undo .
     1192   CREATE WIDGET-POOL.
     1193   def var State-source as  WIDGET-HANDLE.
     1194   define variable lns-cnt as integer   no-undo .
     1195   define variable v-tax-rate-list as character no-undo .
     1196   DEFINE BUTTON r-tax
     1197        IMAGE-UP FILE "btn-down-arrow":U
     1198        IMAGE-DOWN FILE "btn-down-arrow":U
     1199        IMAGE-INSENSITIVE FILE "btn-down-arrow":U NO-FOCUS
     1200        LABEL ""
     1201        SIZE 4.4 BY .8 TOOLTIP "Выбор ставки НДС"
     1202        BGCOLOR 8 FGCOLOR 8 .
     1203   DEFINE VARIABLE E-tax-list AS CHARACTER
     1204        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1205        SIZE 78 BY 7.73 NO-UNDO.
     1206   DEFINE VARIABLE f-tax-rate AS CHARACTER FORMAT "X(256)":U INITIAL "Выбор ставки НДС"
     1207         VIEW-AS TEXT
     1208        SIZE 19.5 BY .67 NO-UNDO.
     1209   DEFINE VARIABLE t-break-by-cp AS LOGICAL INITIAL no
     1210        LABEL "С разбивкой по типам кассовых платежей (только для документов продажи)"
     1211        VIEW-AS TOGGLE-BOX
     1212        SIZE 76.5 BY 1.07 NO-UNDO.
     1213   DEFINE VARIABLE t-excel AS LOGICAL INITIAL no
     1214        LABEL "Excel"
     1215        VIEW-AS TOGGLE-BOX
     1216        SIZE 13 BY 1 NO-UNDO.
     1217   DEFINE VARIABLE t-ext-doc-type-subtotals AS LOGICAL INITIAL no
     1218        LABEL "Разделять по типам документов и выводить подитоги"
     1219        VIEW-AS TOGGLE-BOX
     1220        SIZE 76.5 BY 1.07 NO-UNDO.
     1221   DEFINE VARIABLE t-no-covered-techrfsl AS LOGICAL INITIAL no
     1222        LABEL "Не выводить полностью ПОГАШЕННЫЕ списание/приход по техпроливу"
     1223        VIEW-AS TOGGLE-BOX
     1224        SIZE 76.5 BY 1.07 NO-UNDO.
     1225   DEFINE VARIABLE t-TEXT AS LOGICAL INITIAL no
     1226        LABEL "TEXT"
     1227        VIEW-AS TOGGLE-BOX
     1228        SIZE 13 BY 1 NO-UNDO.
     1229   DEFINE VARIABLE T-without-vat AS LOGICAL INITIAL no
     1230        LABEL "Суммы без НДС"
     1231        VIEW-AS TOGGLE-BOX
     1232        SIZE 21 BY 1 NO-UNDO.
     1233   DEFINE FRAME F-Main
     1234        r-tax AT ROW 3.37 COL 26 WIDGET-ID 4
     1235        T-without-vat AT ROW 2.07 COL 35.5 WIDGET-ID 16
     1236        E-tax-list AT ROW 4.73 COL 4.5 NO-LABEL WIDGET-ID 6
     1237        t-break-by-cp AT ROW 12.73 COL 4.5 WIDGET-ID 10
     1238        t-no-covered-techrfsl AT ROW 13.8 COL 4.5 WIDGET-ID 12
     1239        t-ext-doc-type-subtotals AT ROW 15.07 COL 4.5 WIDGET-ID 14
     1240        t-excel AT ROW 17 COL 4.5 WIDGET-ID 20
     1241        t-TEXT AT ROW 17 COL 25 WIDGET-ID 22
     1242        f-tax-rate AT ROW 3.13 COL 2.5 COLON-ALIGNED NO-LABEL WIDGET-ID 24
     1243       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1244            SIDE-LABELS NO-UNDERLINE THREE-D
     1245            AT COL 1 ROW 1 SCROLLABLE .
     1246   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1247   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1248   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1249   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1250   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1251   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1252   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1253   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1254         adm-object-hdl = FRAME F-Main:HANDLE.
     1255   RUN ensure-broker.
     1256   THIS-PROCEDURE:ADM-DATA =
     1257        'ADM1.1~`':U +
     1258        'SmartObject~`':U +
     1259        '~`':U +
     1260        'NO ~`':U +
     1261        '~`':U +
     1262        '~`':U +
     1263        '~`':U +
     1264        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1265           + "~`":U +
     1266        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1267        'Record-Source,Record-Target,TableIO-Target~`':U +
     1268        '~`':U +
     1269        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1270        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1271            THEN "^^":U
     1272        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1273             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1274   PROCEDURE adm-apply-entry :
     1275     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1276   END PROCEDURE.
     1277   PROCEDURE adm-destroy :
     1278    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1279   END PROCEDURE.
     1280   PROCEDURE adm-disable :
     1281       DISABLE r-tax T-without-vat E-tax-list t-break-by-cp t-no-covered-techrfsl t-ext-doc-type-subtotals t-excel t-TEXT f-tax-rate WITH FRAME F-Main.
     1282       RUN dispatch ('disable-fields':U).
     1283       RUN set-attribute-list ('ENABLED=no':U).
     1284       RETURN.
     1285   END PROCEDURE.
     1286   PROCEDURE adm-edit-attribute-list :
     1287         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1288         RETURN.
     1289   END PROCEDURE.
     1290   PROCEDURE adm-enable :
     1291       ENABLE UNLESS-HIDDEN r-tax T-without-vat E-tax-list t-break-by-cp t-no-covered-techrfsl t-ext-doc-type-subtotals t-excel t-TEXT f-tax-rate WITH FRAME F-Main.
     1292       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1293       RUN set-attribute-list ('ENABLED=yes':U).
     1294       RETURN.
     1295   END PROCEDURE.
     1296   PROCEDURE adm-exit :
     1297        RUN notify ('exit':U).
     1298     RETURN.
     1299   END PROCEDURE.
     1300   PROCEDURE adm-hide :
     1301     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1302   END PROCEDURE.
     1303   PROCEDURE adm-initialize :
     1304     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1305   END PROCEDURE.
     1306   PROCEDURE adm-show-errors :
     1307       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1308       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1309           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1310       END.
     1311       RETURN.
     1312   END PROCEDURE.
     1313   PROCEDURE adm-UIB-mode :
     1314     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1315   END PROCEDURE.
     1316   PROCEDURE adm-view :
     1317     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1318   END PROCEDURE.
     1319   PROCEDURE dispatch :
     1320       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1321       RUN broker-dispatch IN adm-broker-hdl
     1322           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1323       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1324   END PROCEDURE.
     1325   PROCEDURE ensure-broker :
     1326   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1327   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1328   DO:
     1329       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1330       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1331   END.
     1332   END PROCEDURE.
     1333   PROCEDURE get-attribute :
     1334     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1335     RUN broker-get-attribute IN adm-broker-hdl
     1336         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1337     RETURN RETURN-VALUE.
     1338   END PROCEDURE.
     1339   PROCEDURE get-attribute-list :
     1340     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1341     RUN broker-get-attribute-list IN adm-broker-hdl
     1342         (INPUT THIS-PROCEDURE,
     1343          INPUT ?,
     1344          OUTPUT p-attr-list) NO-ERROR.
     1345     RETURN.
     1346   END PROCEDURE.
     1347   PROCEDURE new-state :
     1348     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1349     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1350     RETURN.
     1351   END PROCEDURE.
     1352   PROCEDURE notify :
     1353     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1354     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1355     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1356         RETURN "ADM-ERROR":U.
     1357     RETURN.
     1358   END PROCEDURE.
     1359   PROCEDURE set-attribute-list :
     1360     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1361     RUN ensure-broker.
     1362     RUN broker-set-attribute-list IN adm-broker-hdl
     1363         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1364     RETURN.
     1365   END PROCEDURE.
     1366   PROCEDURE set-position :
     1367       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1368       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1369       IF VALID-HANDLE(adm-object-hdl) THEN
     1370       DO:
     1371         ASSIGN adm-object-hdl:ROW    =   p-row
     1372                adm-object-hdl:COLUMN =   p-col.
     1373       END.
     1374       RETURN.
     1375   END PROCEDURE.
     1376   PROCEDURE adm-display-fields :
     1377       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1378       RETURN.
     1379   END PROCEDURE.
     1380   PROCEDURE adm-open-query :
     1381     RETURN.
     1382   END PROCEDURE.
     1383   PROCEDURE adm-row-changed :
     1384         IF VALID-HANDLE(adm-object-hdl) THEN
     1385           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1386         RUN notify ('row-available':U).
     1387         RETURN.
     1388   END PROCEDURE.
     1389   PROCEDURE reposition-query :
     1390       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1391       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1392       RETURN.
     1393   END PROCEDURE.
     1394     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1395     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1396     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1397     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1398     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1399     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1400     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1401     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1402     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1403     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1404     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1405     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1406     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1407     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1408     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1409     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1410     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1411     IF "":U = "":U THEN
     1412       RUN modify-list-attribute IN adm-broker-hdl
     1413         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1414     RUN use-create-on-add(?).
     1415   PROCEDURE adm-add-record :
     1416       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1417          "must have at least one Enabled Table to perform Add.":U
     1418          VIEW-AS ALERT-BOX ERROR.
     1419       RETURN.
     1420   END PROCEDURE.
     1421   PROCEDURE adm-assign-record :
     1422    MESSAGE
     1423          "Object ":U THIS-PROCEDURE:FILE-NAME
     1424            "must have at least one Enabled Table to perform Assign.":U
     1425              VIEW-AS ALERT-BOX ERROR.
     1426      RETURN.
     1427     END PROCEDURE.
     1428   PROCEDURE adm-assign-statement :
     1429     RETURN.
     1430   END PROCEDURE.
     1431   PROCEDURE adm-cancel-record :
     1432      RETURN.
     1433     END PROCEDURE.
     1434   PROCEDURE adm-copy-record :
     1435       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1436        "must have at least one Enabled Table to perform Copy.":U
     1437          VIEW-AS ALERT-BOX ERROR.
     1438       RETURN.
     1439   END PROCEDURE.
     1440   PROCEDURE adm-create-record :
     1441      RETURN.
     1442   END PROCEDURE.
     1443   PROCEDURE adm-current-changed :
     1444     RETURN.
     1445   END PROCEDURE.
     1446   PROCEDURE adm-delete-record :
     1447    MESSAGE
     1448          "Object ":U THIS-PROCEDURE:FILE-NAME
     1449            "must have at least one Enabled Table to perform Delete.":U
     1450              VIEW-AS ALERT-BOX ERROR.
     1451       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1452       RETURN.
     1453   END PROCEDURE.
     1454   PROCEDURE adm-disable-fields :
     1455         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1456       RETURN.
     1457   END PROCEDURE.
     1458   PROCEDURE adm-enable-fields :
     1459       RETURN.
     1460   END PROCEDURE.
     1461   PROCEDURE adm-end-update :
     1462     RETURN.
     1463   END PROCEDURE.
     1464   PROCEDURE adm-reset-record :
     1465       RETURN.
     1466   END PROCEDURE.
     1467   PROCEDURE adm-update-record :
     1468       MESSAGE
     1469         "Object ":U THIS-PROCEDURE:FILE-NAME
     1470           "must have at least one Enabled Table to perform Update.":U
     1471             VIEW-AS ALERT-BOX ERROR.
     1472      RETURN.
     1473   END PROCEDURE.
     1474   PROCEDURE check-modified :
     1475   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1476   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1477   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1478   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1479     IF check-state = "check":U THEN
     1480     DO:
     1481       RUN get-link-handle IN adm-broker-hdl
     1482         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1483            OUTPUT group-target-list).
     1484       IF group-target-list NE "":U THEN
     1485       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1486         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1487         RUN check-modified IN curr-widget ('group-check':U).
     1488         IF RETURN-VALUE NE "":U THEN
     1489         DO:
     1490           RUN check-modified-message(RETURN-VALUE).
     1491           RETURN "":U.
     1492         END.
     1493       END.
     1494     END.
     1495     RETURN "":U.
     1496   END PROCEDURE.
     1497   PROCEDURE check-modified-message :
     1498     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1499        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1500           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1501        IF RETURN-VALUE = "YES":U THEN
     1502           RUN notify ('view,CONTAINER-SOURCE':U).
     1503        MESSAGE IF p-changed-table NE ? THEN
     1504           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1505           ELSE "Current values have been changed."
     1506           SKIP "  Do you wish to save those changes?"
     1507           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1508        IF ANS THEN
     1509        DO:
     1510           IF group-assign-target THEN
     1511             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1512           ELSE RUN dispatch('update-record':U).
     1513           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1514           DO:
     1515               MESSAGE "Changes to the previous record were not saved."
     1516                 VIEW-AS ALERT-BOX ERROR.
     1517               IF group-assign-target THEN
     1518                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1519               ELSE RUN dispatch ('cancel-record':U).
     1520           END.
     1521        END.
     1522        ELSE DO:
     1523          IF group-assign-target THEN
     1524             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1525          ELSE RUN dispatch('cancel-record':U).
     1526        END.
     1527        RETURN.
     1528   END PROCEDURE.
     1529   PROCEDURE get-rowid :
     1530       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1531       ASSIGN
     1532       p-table   =   adm-first-table.
     1533       RETURN.
     1534   END PROCEDURE.
     1535   PROCEDURE init-group-assign :
     1536       RUN request-attribute IN adm-broker-hdl
     1537         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1538       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1539         group-assign-target = yes.
     1540       ELSE group-assign-target = no.
     1541       RETURN.
     1542   END PROCEDURE.
     1543   PROCEDURE set-editors :
     1544       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1545       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1546       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1547       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1548       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1549       DO WHILE VALID-HANDLE (curr-widget):
     1550           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1551              curr-widget:HIDDEN = no THEN DO:
     1552             CASE p-field-setting:
     1553               WHEN "INITIALIZE":U THEN
     1554               DO:
     1555                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1556                     read-only-list +
     1557                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1558                        STRING(curr-widget).
     1559               END.
     1560               WHEN "DISABLE":U OR
     1561               WHEN "ENABLE":U THEN
     1562               DO:
     1563                   curr-widget:SENSITIVE = yes.
     1564                   RUN get-attribute ('Read-Only-Editors':U).
     1565                   IF RETURN-VALUE = ? OR
     1566                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1567                       curr-widget:READ-ONLY =
     1568                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1569               END.
     1570               WHEN "CLEAR":U THEN
     1571                   curr-widget:SCREEN-VALUE = "":U.
     1572             END CASE.
     1573           END.
     1574           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1575       END.
     1576       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1577         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1578           + '"':U).
     1579       RETURN.
     1580   END PROCEDURE.
     1581   PROCEDURE use-check-modified-all :
     1582    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1583     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1584     RETURN.
     1585   END PROCEDURE.
     1586   PROCEDURE use-create-on-add :
     1587   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1588      RETURN.
     1589   END PROCEDURE.
     1590   PROCEDURE use-initial-lock :
     1591     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1592     ASSIGN adm-initial-lock = p-attr-value.
     1593     RETURN.
     1594   END PROCEDURE.
     1595     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1596   ASSIGN
     1597          FRAME F-Main:SCROLLABLE       = FALSE
     1598          FRAME F-Main:PRIVATE-DATA     =
     1599                   "DLGCLOSE".
     1600   ON CHOOSE OF r-tax IN FRAME F-Main
     1601   DO:
     1602     define variable v-num               as integer      no-undo.
     1603     define variable v-ind               as integer      no-undo.
     1604     define variable v-curr-rid          as integer      no-undo.
     1605     define buffer buf_tax-rate          for ub.tax-rate.
     1606     define variable tax-rate-rid as char no-undo init "".
     1607     run ref/tax-tree.w (
     1608            input my-handle
     1609            ,INPUT "b-seltax-rate,b-marktax-rate"
     1610            ,INPUT "ALL-TAX-RATES"
     1611            ,INPUT 0
     1612            ,INPUT ""
     1613            ,INPUT 0
     1614            ,INPUT ?
     1615            ,INPUT-OUTPUT tax-rate-rid
     1616            ) NO-ERROR.
     1617      IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1618      ASSIGN
     1619      v-num = num-entries (tax-rate-rid)
     1620      e-tax-list = "":U
     1621     v-tax-rate-list = ''
     1622          .
     1623      DO v-ind = 1 to v-num
     1624       :
     1625       v-curr-rid = int(entry(v-ind, tax-rate-rid)).
     1626       find first buf_tax-rate no-lock
     1627       where  recid(buf_tax-rate) = v-curr-rid
     1628       no-error.
     1629       if available buf_tax-rate
     1630       then do:
     1631           ASSIGN
     1632           e-tax-list = SUBSTITUTE("&1&2&3", e-tax-list, (if e-tax-list = '' then '' else chr(10)), buf_tax-rate.rate-name)
     1633           v-tax-rate-list = v-tax-rate-list + (if v-tax-rate-list = '' then '' else chr(44)) + string(buf_tax-rate.rate-code)
     1634           .
     1635        END.
     1636      END.
     1637      DISPLAY e-tax-list with frame F-Main.
     1638   END.
     1639   if not this-procedure :persistent
     1640   then do:
     1641     message
     1642       vss-workfile vss-revision vss-description skip
     1643       "Ошибка при запуске процедуры" skip
     1644       "Данную процедуру следует запускать только с параметром persistent" skip
     1645       view-as alert-box error .
     1646     undo, return error .
     1647   end.
     1648   PROCEDURE disable_UI :
     1649     HIDE FRAME F-Main.
     1650     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1651   END PROCEDURE.
     1652   PROCEDURE GOTO-first-page :
     1653   message " Для этого отчета надо выбрать только один товар ! вернитесь на закладку <Параметры> и выберите 1 товар ".
     1654     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1655     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1656       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1657       State-source = WIDGET-HANDLE ( source-str ).
     1658       IF not VALID-HANDLE ( State-source ) THEN
     1659         Message "Не определен линк " 'State':U view-as alert-box error.
     1660     END.
     1661      run Select1 IN State-source.
     1662   END PROCEDURE.
     1663   PROCEDURE ini-from-SET_PAY_TYPE :
     1664   CASE x-SET_PAY_TYPE :
     1665       WHEN 2 THEN DO:
     1666         ENABLE
     1667         t-without-vat
     1668         WITH FRAME F-Main.
     1669       END.
     1670       otherwise DO:
     1671         ASSIGN
     1672         t-without-vat = NO
     1673         .
     1674         DISPLAY
     1675         t-without-vat
     1676         WITH FRAME F-Main.
     1677         DISABLE
     1678         t-without-vat
     1679         WITH FRAME F-Main.
     1680       END.
     1681     END CASE.
     1682   END PROCEDURE.
     1683   PROCEDURE local-initialize :
     1684   CASE place-call:
     1685     WHEN 'schedule':U
     1686     or when 'rp-by-call':U
     1687     THEN DO:
     1688       RUN rcps_get-profile-id IN parent-handle ( OUTPUT v-profile-id).
     1689       CASE v-profile-id:
     1690         WHEN 69 THEN DO:
     1691           disable
     1692           r-tax
     1693           e-tax-list
     1694           f-tax-rate
     1695           with frame F-Main .
     1696           hide
     1697           f-tax-rate
     1698           r-tax
     1699           e-tax-list
     1700           in frame F-Main .
     1701           enable
     1702           t-excel
     1703           t-text
     1704           with frame F-Main .
     1705         end.
     1706       end case.
     1707     end.
     1708     otherwise do:
     1709       disable
     1710       t-excel
     1711       t-text
     1712       with frame F-Main .
     1713       hide
     1714       t-excel
     1715       t-text
     1716       in frame F-Main .
     1717     end.
     1718   end case.
     1719     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1720     RUN ini-from-SET_PAY_TYPE IN THIS-PROCEDURE.
     1721      END PROCEDURE.
     1722   PROCEDURE my-params :
     1723   define input parameter p-action as character no-undo .
     1724   define variable v-index-id as integer no-undo .
     1725   define variable v-value-character as character no-undo .
     1726   define variable v-value-date as date no-undo .
     1727   define variable v-value-decimal as decimal no-undo .
     1728   define variable v-value-integer as integer no-undo .
     1729   define variable v-value-logical as logical no-undo .
     1730   CASE p-action :
     1731     WHEN 'get' THEN DO:
     1732       IF v-profile-id = 69  THEN DO:
     1733          v-index-id = 0.
     1734          RUN rcps_get-value IN parent-handle (
     1735                                             input "p-without-vat"
     1736                                            ,INPUT-output v-index-id
     1737                                            ,output v-value-character
     1738                                            ,output v-value-date
     1739                                            ,output v-value-decimal
     1740                                            ,output v-value-integer
     1741                                            ,output t-without-vat
     1742                                            ) no-error .
     1743          v-index-id = 0.
     1744          RUN rcps_get-value IN parent-handle (
     1745                                             input "p-break-by-cp"
     1746                                            ,INPUT-output v-index-id
     1747                                            ,output v-value-character
     1748                                            ,output v-value-date
     1749                                            ,output v-value-decimal
     1750                                            ,output v-value-integer
     1751                                            ,output t-break-by-cp
     1752                                            ) no-error .
     1753          v-index-id = 0.
     1754          RUN rcps_get-value IN parent-handle (
     1755                                             input "p-no-covered-techrfsl"
     1756                                            ,INPUT-output v-index-id
     1757                                            ,output v-value-character
     1758                                            ,output v-value-date
     1759                                            ,output v-value-decimal
     1760                                            ,output v-value-integer
     1761                                            ,output t-no-covered-techrfsl
     1762                                            ) no-error .
     1763          v-index-id = 0.
     1764          RUN rcps_get-value IN parent-handle (
     1765                                             input "p-ext-doc-type-subtotals"
     1766                                            ,INPUT-output v-index-id
     1767                                            ,output v-value-character
     1768                                            ,output v-value-date
     1769                                            ,output v-value-decimal
     1770                                            ,output v-value-integer
     1771                                            ,output t-ext-doc-type-subtotals
     1772                                            ) no-error .
     1773          v-index-id = 0.
     1774          RUN rcps_get-value IN parent-handle (
     1775                                             input "p-price-type"
     1776                                            ,INPUT-output v-index-id
     1777                                            ,output v-value-character
     1778                                            ,output v-value-date
     1779                                            ,output v-value-decimal
     1780                                            ,output v-price-type
     1781                                            ,output v-value-logical
     1782                                            ) no-error .
     1783          v-index-id = 0.
     1784          RUN rcps_get-value IN parent-handle (
     1785                                             input "p-r-b"
     1786                                            ,INPUT-output v-index-id
     1787                                            ,output v-val-type
     1788                                            ,output v-value-date
     1789                                            ,output v-value-decimal
     1790                                            ,output v-value-integer
     1791                                            ,output v-value-logical
     1792                                            ) no-error .
     1793          v-index-id = 0.
     1794          RUN rcps_get-value IN parent-handle (
     1795                                             input "p-output-type"
     1796                                            ,INPUT-output v-index-id
     1797                                            ,output v-output-type
     1798                                            ,output v-value-date
     1799                                            ,output v-value-decimal
     1800                                            ,output v-value-integer
     1801                                            ,output v-value-logical
     1802                                            ) no-error .
     1803          assign
     1804          t-without-vat:screen-value in frame F-Main =  string(t-without-vat)
     1805          t-break-by-cp:screen-value in frame F-Main =  string(t-break-by-cp)
     1806          t-no-covered-techrfsl:screen-value in frame F-Main =  string(t-no-covered-techrfsl)
     1807          t-ext-doc-type-subtotals:screen-value in frame F-Main =  string(t-ext-doc-type-subtotals)
     1808          t-excel:screen-value in frame F-Main =  string(lookup('excel':U, v-output-type) > 0)
     1809          t-text:screen-value in frame F-Main = string(lookup('text':U, v-output-type) > 0)
     1810          .
     1811       END.
     1812       RUN local-initialize IN THIS-PROCEDURE.
     1813     END.
     1814     WHEN 'set' THEN DO:
     1815       IF v-profile-id = 69 THEN DO:
     1816         ASSIGN
     1817         FRAME F-Main
     1818         t-without-vat
     1819         t-break-by-cp
     1820         t-no-covered-techrfsl
     1821         t-ext-doc-type-subtotals
     1822         t-text
     1823         t-excel
     1824         v-output-type = ","
     1825         ENTRY(1, v-output-type) = (IF t-excel THEN 'excel':U ELSE '')
     1826         ENTRY(2, v-output-type) = (IF t-text THEN 'text':U ELSE '')
     1827         v-output-type = TRIM(v-output-type, chr(44))
     1828         .
     1829         if not t-excel
     1830         and not t-text then do:
     1831           define variable glog as logical no-undo .
     1832           message
     1833           "Внимание!! Вы не выбрали ни вывод в текстовый файл, ни вывод в Excel!" skip
     1834           "Продолжить?"
     1835           view-as alert-box question buttons yes-no update glog.
     1836           if not glog then return error.
     1837         end.
     1838         RUN rcps_set-value IN parent-handle (
     1839                                           input "p-without-vat"
     1840                                         ,INPUT 0
     1841                                         ,input ''
     1842                                         ,input ?
     1843                                         ,input 0.0
     1844                                         ,input 0
     1845                                         ,input t-without-vat
     1846                                         ) no-error .
     1847         RUN rcps_set-value IN parent-handle (
     1848                                           input "p-break-by-cp"
     1849                                         ,INPUT 0
     1850                                         ,input ''
     1851                                         ,input ?
     1852                                         ,input 0.0
     1853                                         ,input 0
     1854                                         ,input t-break-by-cp
     1855                                         ) no-error .
     1856         RUN rcps_set-value IN parent-handle (
     1857                                           input "p-no-covered-techrfsl"
     1858                                         ,INPUT 0
     1859                                         ,input ''
     1860                                         ,input ?
     1861                                         ,input 0.0
     1862                                         ,input 0
     1863                                         ,input t-no-covered-techrfsl
     1864                                         ) no-error .
     1865         RUN rcps_set-value IN parent-handle (
     1866                                           input "p-ext-doc-type-subtotals"
     1867                                         ,INPUT 0
     1868                                         ,input ''
     1869                                         ,input ?
     1870                                         ,input 0.0
     1871                                         ,input 0
     1872                                         ,input t-ext-doc-type-subtotals
     1873                                         ) no-error .
     1874         RUN rcps_set-value IN parent-handle (
     1875                                           input "p-output-type"
     1876                                         ,INPUT 0
     1877                                         ,input v-output-type
     1878                                         ,input ?
     1879                                         ,input 0.0
     1880                                         ,input 0
     1881                                         ,input no
     1882                                         ) no-error .
     1883         RUN rcps_set-value IN parent-handle (
     1884                                           input "p-price-type"
     1885                                         ,INPUT 0
     1886                                         ,input ''
     1887                                         ,input ?
     1888                                         ,input 0.0
     1889                                         ,input x-SET_PAY_TYPE
     1890                                         ,input no
     1891                                         ) no-error .
     1892         v-val-type = if X-SET_val_TYPE = 2 then 'base':U else 'rubl':U.
     1893         RUN rcps_set-value IN parent-handle (
     1894                                           input "p-r-b"
     1895                                         ,INPUT 0
     1896                                         ,input v-val-type
     1897                                         ,input ?
     1898                                         ,input 0.0
     1899                                         ,input x-SET_PAY_TYPE
     1900                                         ,input no
     1901                                         ) no-error .
     1902       END.
     1903     END.
     1904   END CASE.
     1905   END PROCEDURE.
     1906   PROCEDURE my-report :
     1907   run rep/r-trg29d.p (
     1908                        input my-handle
     1909                       ,input this-procedure:handle
     1910                       ,input this-procedure:handle
     1911                       ,input this-procedure:handle
     1912                       ,input this-procedure:handle
     1913                       ,input ?
     1914                       ,input ?
     1915                       ,input ''
     1916                       ,input integer('0':U)
     1917                       ,input 0
     1918                       ,input 0
     1919                       ,input ""
     1920                       ,input t-without-vat
     1921                      ,input v-tax-rate-list
     1922                      ,INPUT t-break-by-cp
     1923                      ,input t-no-covered-techrfsl
     1924                      ,input t-ext-doc-type-subtotals
     1925                       ,input t-text
     1926                       ,input t-excel
     1927                       ,input ''
     1928                       ) no-error.
     1929   END PROCEDURE.
     1930   PROCEDURE my-var :
     1931    Assign
     1932    STR-obj-type = ''
     1933    STR-obj-code = ''
     1934    STR-obj-name = ''
     1935    STR-obj      = ''.
     1936   For each obj-list no-lock:
     1937    Assign
     1938    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1939    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1940    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1941    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1942   End.
     1943   ASSIGN FRAME F-Main
     1944   t-without-vat
     1945   t-break-by-cp
     1946   t-no-covered-techrfsl
     1947   t-ext-doc-type-subtotals
     1948   .
     1949   ASSIGN
     1950   reportheader  =
     1951   (IF v-tax-rate-list <> ''
     1952   THEN substitute("Только товары со ставкой НДС на &1 из списка &2"
     1953                   , STRING(X-date-start)
     1954                   , v-tax-rate-list)
     1955   ELSE '') + chr(10) +
     1956   (IF t-Without-vat
     1957   THEN "Суммы БЕЗ НДС"
     1958   ELSE '') + chr(10) +
     1959   (IF t-break-by-cp
     1960   THEN "С разбивкой по типам кассовых платежей (только для документов продажи)"
     1961   ELSE '') + chr(10) +
     1962   (IF t-no-covered-techrfsl
     1963   THEN "Не выводить полностью ПОГАШЕННЫЕ списание/приход по техпроливу"
     1964   ELSE '') + chr(10) +
     1965   (IF t-ext-doc-type-subtotals
     1966   THEN "Рзаделять по типам документов и выводить подитоги"
     1967   ELSE '')
     1968   .
     1969   END PROCEDURE.
     1970   PROCEDURE state-changed :
     1971     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1972     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1973     CASE p-state:
     1974       When 'link-changed':U then do:
     1975            if lns-cnt > 1 and NOT Link# Then
     1976               run goto-first-page in this-procedure.
     1977         RUN ini-from-SET_PAY_TYPE IN THIS-PROCEDURE.
     1978       End.
     1979     END CASE.
     1980   END PROCEDURE.
     1981   PROCEDURE write-to-log :
     1982   define input param p-str as char no-undo.
     1983   do
     1984   on error undo, return error
     1985   :
     1986      message
     1987         p-str
     1988         skip
     1989      view-as alert-box error.
     1990   end.
     1991   END PROCEDURE.
