      612   define new global shared variable g#library  as handle no-undo .
      613   define new global shared variable g#library2 as handle no-undo .
      614   define variable var-report-r-b as character no-undo .
      615   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      617     (output var-report-r-b
      618     )  .
      619   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      620   ASSIGN parParentProc =  my-handle .
      621     define variable g#userid as character no-undo .
      622     run get-userid  in parParentProc ( output g#userid ).
      623   DEFINE BUTTON B-columns
      624        LABEL "Выбор колонок для печати"
      625        SIZE 26.75 BY 1.5 TOOLTIP "Выбор колонок для печати".
      626   DEFINE VARIABLE FILL-IN-30 AS CHARACTER FORMAT "X(30)":U INITIAL "Сортировка списка контрагентов :"
      627         VIEW-AS TEXT
      628        SIZE 33.63 BY .92
      629        FGCOLOR 4 .
      630   DEFINE VARIABLE FILL-IN-31 AS CHARACTER FORMAT "X(56)":U INITIAL "Менеджеры:"
      631         VIEW-AS TEXT
      632        SIZE 13.63 BY .67
      633        FGCOLOR 4  NO-UNDO.
      634   DEFINE VARIABLE FILL-IN-33 AS CHARACTER FORMAT "X(30)":U INITIAL "Показать :"
      635         VIEW-AS TEXT
      636        SIZE 12.75 BY .92
      637        FGCOLOR 4 .
      638   DEFINE VARIABLE FILL-IN-34 AS CHARACTER FORMAT "X(56)":U INITIAL "Контрагенты:"
      639         VIEW-AS TEXT
      640        SIZE 13.63 BY .67
      641        FGCOLOR 4  NO-UNDO.
      642   DEFINE VARIABLE FILL-IN-35 AS CHARACTER FORMAT "X(30)":U INITIAL "Упорядочение списка товаров"
      643         VIEW-AS TEXT
      644        SIZE 33.63 BY .92
      645        FGCOLOR 15 .
      646   DEFINE VARIABLE FILL-IN-36 AS CHARACTER FORMAT "X(56)":U INITIAL "Классификация :"
      647         VIEW-AS TEXT
      648        SIZE 18.5 BY .67
      649        FGCOLOR 4  NO-UNDO.
      650   DEFINE VARIABLE Classify AS CHARACTER
      651        VIEW-AS RADIO-SET VERTICAL
      652        RADIO-BUTTONS
      653             "Без классификации", "no-classify":U,
      654   "Группы товаров", "grp-goods":U
      655        size 21 by 2.42 NO-UNDO.
      656   DEFINE VARIABLE RADIO-boss AS INTEGER
      657        VIEW-AS RADIO-SET VERTICAL
      658        RADIO-BUTTONS
      659             "Все", 1,
      660   "Выборочно", 2
      661        SIZE 16.38 BY 2.17 NO-UNDO.
      662   DEFINE VARIABLE RADIO-Sort AS INTEGER
      663        VIEW-AS RADIO-SET VERTICAL
      664        RADIO-BUTTONS
      665             "По алфавиту", 1,
      666   "По менеджерам", 2,
      667   "По исполнителям", 3,
      668   "По формам оплаты", 4,
      669   "По группам клиентов", 5
      670        SIZE 32 BY 6.54 NO-UNDO.
      671   DEFINE VARIABLE SelectOrg AS INTEGER
      672        VIEW-AS RADIO-SET VERTICAL
      673        RADIO-BUTTONS
      674             "Все", 1,
      675   "Выборочно", 2
      676        SIZE 16.38 BY 2.17 NO-UNDO.
      677   DEFINE VARIABLE SortType AS CHARACTER
      678        VIEW-AS RADIO-SET VERTICAL
      679        RADIO-BUTTONS
      680             "по коду", "sort-code":U,
      681   "по артикулу", "sort-article":U
      682        size 20.5 by 2.54 NO-UNDO.
      683   DEFINE RECTANGLE RECT-5
      684        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      685        SIZE 27.75 BY 14.29.
      686   DEFINE RECTANGLE RECT-6
      687        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      688        SIZE 46 BY 7.38.
      689   DEFINE RECTANGLE RECT-7
      690        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      691        SIZE 46 BY 9.29.
      692   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL yes
      693        LABEL "Только итоги"
      694        VIEW-AS TOGGLE-BOX
      695        SIZE 23 BY .83 NO-UNDO.
      696   DEFINE VARIABLE TOGGLE-1 AS LOGICAL INITIAL yes
      697        LABEL "Закрытые документы"
      698        VIEW-AS TOGGLE-BOX
      699        SIZE 22.5 BY .83 NO-UNDO.
      700   DEFINE VARIABLE TOGGLE-2 AS LOGICAL INITIAL no
      701        LABEL "Незакрытые документы"
      702        VIEW-AS TOGGLE-BOX
      703        SIZE 24 BY .83 NO-UNDO.
      704   DEFINE FRAME F-Main
      705        TOGGLE-1 AT ROW 2.5 COL 3
      706        RADIO-Sort AT ROW 2.88 COL 36 NO-LABEL
      707        TOGGLE-2 AT ROW 4 COL 3
      708        SumsOnly AT ROW 5.5 COL 3
      709        RADIO-boss AT ROW 8.21 COL 5 NO-LABEL
      710        SelectOrg AT ROW 12.71 COL 4.25 NO-LABEL
      711        Classify at row 14.5 col 32.13 NO-LABEL
      712        SortType at row 14.58 col 55.5 NO-LABEL
      713        B-columns AT ROW 16.04 COL 2.38
      714        FILL-IN-33 AT ROW 1.38 COL 7.88 NO-LABEL
      715        FILL-IN-30 AT ROW 1.71 COL 35.88 NO-LABEL
      716        FILL-IN-31 AT ROW 7.21 COL 4.63 NO-LABEL
      717        FILL-IN-35 AT ROW 11.42 COL 37.13 NO-LABEL
      718        FILL-IN-34 AT ROW 11.58 COL 4.38 NO-LABEL
      719        FILL-IN-36 AT ROW 13.5 COL 32.13 NO-LABEL
      720        "Сортировка :" VIEW-AS TEXT
      721             size 13.63 by 0.75 at row 13.5 col 55.38
      722             FGCOLOR 4
      723        RECT-6 AT ROW 10.83 COL 31
      724        RECT-5 AT ROW 1.21 COL 1.75
      725        RECT-7 AT ROW 1.21 COL 31
      726       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      727            SIDE-LABELS NO-UNDERLINE THREE-D
      728            AT COL 1 ROW 1 SCROLLABLE .
      729   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      730   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      731   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      732   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      733   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      734   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      735   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      736   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      737         adm-object-hdl = FRAME F-Main:HANDLE.
      738   RUN ensure-broker.
      739   THIS-PROCEDURE:ADM-DATA =
      740        'ADM1.1~`':U +
      741        'SmartObject~`':U +
      742        '~`':U +
      743        'NO ~`':U +
      744        '~`':U +
      745        '~`':U +
      746        '~`':U +
      747        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      748           + "~`":U +
      749        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      750        'Record-Source,Record-Target,TableIO-Target~`':U +
      751        '~`':U +
      752        '~`~`~`~`~`~`~`~`~`~`~`':U +
      753        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      754            THEN "^^":U
      755        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      756             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      757   PROCEDURE adm-apply-entry :
      758     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      759   END PROCEDURE.
      760   PROCEDURE adm-destroy :
      761    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      762   END PROCEDURE.
      763   PROCEDURE adm-disable :
      764       DISABLE RECT-6 RECT-5 RECT-7 TOGGLE-1 RADIO-Sort TOGGLE-2 SumsOnly RADIO-boss SelectOrg Classify SortType B-columns FILL-IN-33 FILL-IN-30 FILL-IN-31 FILL-IN-35 FILL-IN-34 FILL-IN-36 WITH FRAME F-Main.
      765       RUN dispatch ('disable-fields':U).
      766       RUN set-attribute-list ('ENABLED=no':U).
      767       RETURN.
      768   END PROCEDURE.
      769   PROCEDURE adm-edit-attribute-list :
      770         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      771         RETURN.
      772   END PROCEDURE.
      773   PROCEDURE adm-enable :
      774       ENABLE UNLESS-HIDDEN RECT-6 RECT-5 RECT-7 TOGGLE-1 RADIO-Sort TOGGLE-2 SumsOnly RADIO-boss SelectOrg Classify SortType B-columns FILL-IN-33 FILL-IN-30 FILL-IN-31 FILL-IN-35 FILL-IN-34 FILL-IN-36 WITH FRAME F-Main.
      775       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      776       RUN set-attribute-list ('ENABLED=yes':U).
      777       RETURN.
      778   END PROCEDURE.
      779   PROCEDURE adm-exit :
      780        RUN notify ('exit':U).
      781     RETURN.
      782   END PROCEDURE.
      783   PROCEDURE adm-hide :
      784     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      785   END PROCEDURE.
      786   PROCEDURE adm-initialize :
      787     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      788   END PROCEDURE.
      789   PROCEDURE adm-show-errors :
      790       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      791       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      792           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      793       END.
      794       RETURN.
      795   END PROCEDURE.
      796   PROCEDURE adm-UIB-mode :
      797     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      798   END PROCEDURE.
      799   PROCEDURE adm-view :
      800     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      801   END PROCEDURE.
      802   PROCEDURE dispatch :
      803       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      804       RUN broker-dispatch IN adm-broker-hdl
      805           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      806       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      807   END PROCEDURE.
      808   PROCEDURE ensure-broker :
      809   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      810   IF RETURN-VALUE NE "ADM-Broker":U THEN
      811   DO:
      812       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      813       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      814   END.
      815   END PROCEDURE.
      816   PROCEDURE get-attribute :
      817     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      818     RUN broker-get-attribute IN adm-broker-hdl
      819         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      820     RETURN RETURN-VALUE.
      821   END PROCEDURE.
      822   PROCEDURE get-attribute-list :
      823     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      824     RUN broker-get-attribute-list IN adm-broker-hdl
      825         (INPUT THIS-PROCEDURE,
      826          INPUT ?,
      827          OUTPUT p-attr-list) NO-ERROR.
      828     RETURN.
      829   END PROCEDURE.
      830   PROCEDURE new-state :
      831     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      832     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      833     RETURN.
      834   END PROCEDURE.
      835   PROCEDURE notify :
      836     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      837     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      838     IF RETURN-VALUE = "ADM-ERROR":U THEN
      839         RETURN "ADM-ERROR":U.
      840     RETURN.
      841   END PROCEDURE.
      842   PROCEDURE set-attribute-list :
      843     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      844     RUN ensure-broker.
      845     RUN broker-set-attribute-list IN adm-broker-hdl
      846         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      847     RETURN.
      848   END PROCEDURE.
      849   PROCEDURE set-position :
      850       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      851       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      852       IF VALID-HANDLE(adm-object-hdl) THEN
      853       DO:
      854         ASSIGN adm-object-hdl:ROW    =   p-row
      855                adm-object-hdl:COLUMN =   p-col.
      856       END.
      857       RETURN.
      858   END PROCEDURE.
      859   PROCEDURE adm-display-fields :
      860       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      861       RETURN.
      862   END PROCEDURE.
      863   PROCEDURE adm-open-query :
      864     RETURN.
      865   END PROCEDURE.
      866   PROCEDURE adm-row-changed :
      867         IF VALID-HANDLE(adm-object-hdl) THEN
      868           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      869         RUN notify ('row-available':U).
      870         RETURN.
      871   END PROCEDURE.
      872   PROCEDURE reposition-query :
      873       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      874       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      875       RETURN.
      876   END PROCEDURE.
      877     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      878     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      879     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      880     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      881     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      882     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      883     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      884     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      885     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      886     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      887     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      888     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      889     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      890     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      891     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      892     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      893     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      894     IF "":U = "":U THEN
      895       RUN modify-list-attribute IN adm-broker-hdl
      896         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      897     RUN use-create-on-add(?).
      898   PROCEDURE adm-add-record :
      899       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      900          "must have at least one Enabled Table to perform Add.":U
      901          VIEW-AS ALERT-BOX ERROR.
      902       RETURN.
      903   END PROCEDURE.
      904   PROCEDURE adm-assign-record :
      905    MESSAGE
      906          "Object ":U THIS-PROCEDURE:FILE-NAME
      907            "must have at least one Enabled Table to perform Assign.":U
      908              VIEW-AS ALERT-BOX ERROR.
      909      RETURN.
      910     END PROCEDURE.
      911   PROCEDURE adm-assign-statement :
      912     RETURN.
      913   END PROCEDURE.
      914   PROCEDURE adm-cancel-record :
      915      RETURN.
      916     END PROCEDURE.
      917   PROCEDURE adm-copy-record :
      918       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      919        "must have at least one Enabled Table to perform Copy.":U
      920          VIEW-AS ALERT-BOX ERROR.
      921       RETURN.
      922   END PROCEDURE.
      923   PROCEDURE adm-create-record :
      924      RETURN.
      925   END PROCEDURE.
      926   PROCEDURE adm-current-changed :
      927     RETURN.
      928   END PROCEDURE.
      929   PROCEDURE adm-delete-record :
      930    MESSAGE
      931          "Object ":U THIS-PROCEDURE:FILE-NAME
      932            "must have at least one Enabled Table to perform Delete.":U
      933              VIEW-AS ALERT-BOX ERROR.
      934       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      935       RETURN.
      936   END PROCEDURE.
      937   PROCEDURE adm-disable-fields :
      938         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      939       RETURN.
      940   END PROCEDURE.
      941   PROCEDURE adm-enable-fields :
      942       RETURN.
      943   END PROCEDURE.
      944   PROCEDURE adm-end-update :
      945     RETURN.
      946   END PROCEDURE.
      947   PROCEDURE adm-reset-record :
      948       RETURN.
      949   END PROCEDURE.
      950   PROCEDURE adm-update-record :
      951       MESSAGE
      952         "Object ":U THIS-PROCEDURE:FILE-NAME
      953           "must have at least one Enabled Table to perform Update.":U
      954             VIEW-AS ALERT-BOX ERROR.
      955      RETURN.
      956   END PROCEDURE.
      957   PROCEDURE check-modified :
      958   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      959   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      960   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      961   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      962     IF check-state = "check":U THEN
      963     DO:
      964       RUN get-link-handle IN adm-broker-hdl
      965         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      966            OUTPUT group-target-list).
      967       IF group-target-list NE "":U THEN
      968       DO i = 1 TO NUM-ENTRIES(group-target-list):
      969         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      970         RUN check-modified IN curr-widget ('group-check':U).
      971         IF RETURN-VALUE NE "":U THEN
      972         DO:
      973           RUN check-modified-message(RETURN-VALUE).
      974           RETURN "":U.
      975         END.
      976       END.
      977     END.
      978     RETURN "":U.
      979   END PROCEDURE.
      980   PROCEDURE check-modified-message :
      981     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      982        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      983           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      984        IF RETURN-VALUE = "YES":U THEN
      985           RUN notify ('view,CONTAINER-SOURCE':U).
      986        MESSAGE IF p-changed-table NE ? THEN
      987           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      988           ELSE "Current values have been changed."
      989           SKIP "  Do you wish to save those changes?"
      990           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      991        IF ANS THEN
      992        DO:
      993           IF group-assign-target THEN
      994             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      995           ELSE RUN dispatch('update-record':U).
      996           IF RETURN-VALUE = "ADM-ERROR":U THEN
      997           DO:
      998               MESSAGE "Changes to the previous record were not saved."
      999                 VIEW-AS ALERT-BOX ERROR.
     1000               IF group-assign-target THEN
     1001                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1002               ELSE RUN dispatch ('cancel-record':U).
     1003           END.
     1004        END.
     1005        ELSE DO:
     1006          IF group-assign-target THEN
     1007             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1008          ELSE RUN dispatch('cancel-record':U).
     1009        END.
     1010        RETURN.
     1011   END PROCEDURE.
     1012   PROCEDURE get-rowid :
     1013       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1014       ASSIGN
     1015       p-table   =   adm-first-table.
     1016       RETURN.
     1017   END PROCEDURE.
     1018   PROCEDURE init-group-assign :
     1019       RUN request-attribute IN adm-broker-hdl
     1020         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1021       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1022         group-assign-target = yes.
     1023       ELSE group-assign-target = no.
     1024       RETURN.
     1025   END PROCEDURE.
     1026   PROCEDURE set-editors :
     1027       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1028       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1029       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1030       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1031       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1032       DO WHILE VALID-HANDLE (curr-widget):
     1033           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1034              curr-widget:HIDDEN = no THEN DO:
     1035             CASE p-field-setting:
     1036               WHEN "INITIALIZE":U THEN
     1037               DO:
     1038                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1039                     read-only-list +
     1040                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1041                        STRING(curr-widget).
     1042               END.
     1043               WHEN "DISABLE":U OR
     1044               WHEN "ENABLE":U THEN
     1045               DO:
     1046                   curr-widget:SENSITIVE = yes.
     1047                   RUN get-attribute ('Read-Only-Editors':U).
     1048                   IF RETURN-VALUE = ? OR
     1049                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1050                       curr-widget:READ-ONLY =
     1051                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1052               END.
     1053               WHEN "CLEAR":U THEN
     1054                   curr-widget:SCREEN-VALUE = "":U.
     1055             END CASE.
     1056           END.
     1057           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1058       END.
     1059       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1060         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1061           + '"':U).
     1062       RETURN.
     1063   END PROCEDURE.
     1064   PROCEDURE use-check-modified-all :
     1065    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1066     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1067     RETURN.
     1068   END PROCEDURE.
     1069   PROCEDURE use-create-on-add :
     1070   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1071      RETURN.
     1072   END PROCEDURE.
     1073   PROCEDURE use-initial-lock :
     1074     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1075     ASSIGN adm-initial-lock = p-attr-value.
     1076     RETURN.
     1077   END PROCEDURE.
     1078     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1079   ASSIGN
     1080          FRAME F-Main:SCROLLABLE       = FALSE
     1081          FRAME F-Main:HIDDEN           = TRUE.
     1082   ON CHOOSE OF B-columns IN FRAME F-Main
     1083   DO:
     1084     run rep/e-ob-pr1.w  .
     1085   END.
     1086   ON VALUE-CHANGED OF RADIO-boss IN FRAME F-Main
     1087   DO:
     1088     define variable ref-list as character no-undo .
     1089     define variable i as integer   no-undo .
     1090     assign RADIO-boss .
     1091     assign
     1092       ref-list = ""
     1093       MngrCodes = ""
     1094     .
     1095     if RADIO-boss = 2 then  do:
     1096       run ref/cli-all.w ( parParentProc
     1097                      , "b-sel,b-mark"
     1098                      , 'чел':U
     1099                      , 'все':U
     1100                      , 'текущие':U
     1101                      , ?
     1102                      , ",,,,,,NO"
     1103                      ,?
     1104                     , output ref-list ) .
     1105       if ref-list <> "" then do:
     1106         DO i = 1 to num-entries( ref-list ) :
     1107           FIND clients WHERE recid( clients ) = integer( entry( i, ref-list ) ) NO-LOCK .
     1108           MngrCodes = MngrCodes + string( clients.obj-code ) + "," .
     1109         END.
     1110         MngrCodes = right-trim( MngrCodes, "," ) .
     1111       end.
     1112       else do:
     1113         assign
     1114           RADIO-boss = 1
     1115           MngrCodes = ""
     1116         .
     1117         DISPLAY RADIO-boss with frame F-Main .
     1118       end.
     1119     end.
     1120   END.
     1121   ON VALUE-CHANGED OF SelectOrg IN FRAME F-Main
     1122   DO:
     1123     assign SelectOrg .
     1124     if SelectOrg = 2 then do:
     1125       assign
     1126         org-list = ""
     1127       .
     1128       run ref/cli-all.w ( parParentProc
     1129                      , "b-sel"
     1130                      , 'все':U
     1131                      , 'все':U
     1132                      , 'текущие':U
     1133                      , ?
     1134                      ,",,,,,,NO"
     1135                      ,?
     1136                     , output org-list ) .
     1137       if org-list = "" then do:
     1138         SelectOrg = 1 .
     1139         disp SelectOrg with frame F-Main.
     1140       end.
     1141     end .
     1142   END.
     1143   ON VALUE-CHANGED OF SumsOnly IN FRAME F-Main
     1144   DO:
     1145     Assign SumsOnly.
     1146     if SumsOnly = no then enable  RECT-6 Classify SortType with frame F-Main .
     1147     else                  disable RECT-6 Classify SortType with frame F-Main .
     1148   END.
     1149   if not this-procedure :persistent
     1150   then do:
     1151     message
     1152       vss-workfile vss-revision vss-description skip
     1153       "Ошибка при запуске процедуры" skip
     1154       "Данную процедуру следует запускать только с параметром persistent" skip
     1155       view-as alert-box error .
     1156     undo, return error .
     1157   end.
     1158   PROCEDURE disable_UI :
     1159     HIDE FRAME F-Main.
     1160     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1161   END PROCEDURE.
     1162   PROCEDURE local-apply-layout :
     1163     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1164   END PROCEDURE.
     1165   PROCEDURE local-initialize :
     1166   def var  l-ind as integer no-undo .
     1167     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1168     repeat l-ind = 1 to 88 :  use-column[ l-ind ] =  false . End.
     1169    find first ubflt.usr-flt share-lock where ubflt.usr-flt.user-name  = g#userid and ubflt.usr-flt.call-point = "e-ob-prd":U no-error .
     1170    if not avail ubflt.usr-flt then run rep/e-ob-pr1.w .
     1171    else do:
     1172      repeat l-ind = 1 to num-entries(ubflt.usr-flt.list_) :
     1173        if index ( entry(l-ind,ubflt.usr-flt.list_),"=") = 0 THEN DO :
     1174          if int(entry(l-ind,ubflt.usr-flt.list_)) > 0 and int(entry(l-ind,ubflt.usr-flt.list_)) <= 28  then use-column[int(entry(l-ind,ubflt.usr-flt.list_)) ] =  true  .
     1175        End.
     1176        Else DO :
     1177          if error-status :error then DO:
     1178            run rep/e-ob-pr1.w .
     1179            return no-apply.
     1180          End.
     1181        End.
     1182      End.
     1183    End.
     1184    assign TOGGLE-1 = yes SumsOnly = yes .
     1185    disable RECT-6 Classify SortType with frame F-Main .
     1186    display FILL-IN-30 FILL-IN-31  FILL-IN-33  FILL-IN-34  FILL-IN-35 FILL-IN-36 TOGGLE-1 SumsOnly with frame F-Main .
     1187   END PROCEDURE.
     1188   PROCEDURE my-report :
     1189   if TOGGLE-1 = no and TOGGLE-2 = no then do:
     1190       message  "Нет выбранных документов!"  view-as alert-box.
     1191       leave .
     1192     end.
     1193     if SumsOnly = yes then  assign  print-o = 31 .
     1194     else                    assign  print-o = 90 .
     1195     define variable ii as integer   no-undo .
     1196     do ii = 1 to 24:
     1197       if use-column[ii] = TRUE then do:
     1198         if ii = 9 or ii = 14 or ii = 19 or ii = 24 then assign  print-o = print-o + 10 .
     1199         else                                            assign  print-o = print-o + 14 .
     1200       end.
     1201     end.
     1202     run rep/r-ob-prd.p  (
     1203      input RADIO-Sort  ,
     1204      input SelectOrg   ,
     1205      input org-list    ,
     1206      input RADIO-boss  ,
     1207      input MngrCodes   ,
     1208      input Classify    ,
     1209      input SortType    ,
     1210      input TOGGLE-1    ,
     1211      input TOGGLE-2    ,
     1212      input SumsOnly    ,
     1213      input print-o
     1214     ).
     1215   END PROCEDURE.
     1216   PROCEDURE my-var :
     1217    Assign frame F-Main SumsOnly Classify SortType SelectOrg TOGGLE-1 TOGGLE-2 RADIO-boss RADIO-Sort .
     1218    Assign
     1219      STR-obj-type = ''
     1220      STR-obj-code = ''
     1221      STR-obj-name = ''
     1222      STR-obj      = ''
     1223      str4  = ""
     1224    .
     1225    For each obj-list no-lock:
     1226      Assign
     1227        STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1228        STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1229        STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1230        STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1231      .
     1232    End.
     1233    ReportNAme = "Обороты по производителям с: " + string(x-date-start,"99/99/9999") + "г. по: "  + string(x-date-end, "99/99/9999") + "г.".
     1234   def var t-class as char no-undo.
     1235   def var t-sort as char no-undo.
     1236     case classify:
     1237       when "no-classify":u    then t-class =   "Без классификации" .
     1238       when "prod":u           then t-class =   "Производители"   .
     1239       when "post":u           then t-class =   "Поставщики"   .
     1240       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1241       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1242       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1243       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1244       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1245       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1246       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1247       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1248       when  "t-level":u       then t-class =   "Терминальные группы" .
     1249    end case.
     1250     case sorttype:
     1251       when "sort-pp":u               then t-sort =   "по порядку" .
     1252       when "sort-code":u             then t-sort =   "по коду" .
     1253       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1254       when "sort-qunty":u            then t-sort =   "по реализации".
     1255       when "sort-name":u             then t-sort =   "по наименованию".
     1256       when "sort-type":u             then t-sort =   "по типу ткани".
     1257       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1258       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1259    end case.
     1260    ReportHeader = "Классификация : " + t-Class + "   Сортировка : "  + t-sort .
     1261    assign str1 = "Показать : " + (if SumsOnly then " только итоги, " else " " ) .
     1262    if TOGGLE-1 = yes then assign str1 = str1 + "закрытые документы, " .
     1263    if TOGGLE-2 = yes then assign str1 = str1 + "незакрытые документы " .
     1264    assign str2 = "Сортировка организаций : " .
     1265    case RADIO-Sort :
     1266      when 1 then assign str2 = str2 + "по алфавиту" .
     1267      when 2 then assign str2 = str2 + "по менеджерам" .
     1268      when 3 then assign str2 = str2 + "по исполнителям" .
     1269      when 4 then assign str2 = str2 + "по формам оплаты" .
     1270      when 5 then assign str2 = str2 + "по группам клиентов" .
     1271    end.
     1272    assign str3 = "Контрагенты : " + (if SelectOrg = 1 then " все, " else org-list ) + "Менеджеры : " + (if RADIO-boss = 1 then " все" else MngrCodes ) .
     1273   END PROCEDURE.
     1274   PROCEDURE state-changed :
     1275     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1276     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1277     CASE p-state:
     1278       when "link-changed":U then  DO:
     1279            Run my-var.
     1280            End.
     1281     END CASE.
     1282   END PROCEDURE.
