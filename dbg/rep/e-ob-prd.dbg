      176   def
      177    shared
      178   temp-table  obj-list no-undo
      179     field obj-type like ub.clients.obj-type
      180     field obj-code like ub.clients.obj-code
      181     field obj-name like ub.clients.obj-name
      182     field obj-id   as integer
      183     field db-num   as integer
