      187   .
      188   procedure create_obj-list :
      189      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      190      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      191      do
      192      on error undo, return error return-value
      193      :
      194         define buffer cli-obj for ub.clients .
      195         define variable p-var as integer no-undo .
      196         define buffer buf_obj-list for obj-list .
      197         find last buf_obj-list  use-index pi no-error .
      198         if available buf_obj-list
      199         then
      200            p-var = buf_obj-list.obj-id + 1.
      201         else
      202            p-var = 1.
      203         find first cli-obj where
      204                   cli-obj.obj-type = p-obj-type
      205               and cli-obj.obj-code = p-obj-code
      206         no-lock no-error.
      207         if available cli-obj
      208         then do:
      209            create buf_obj-list.
      210            assign
      211               buf_obj-list.obj-id   = p-var
      212               buf_obj-list.obj-code = cli-obj.obj-code
      213               buf_obj-list.obj-type = cli-obj.obj-type
      214               buf_obj-list.obj-name = cli-obj.obj-name
      215               buf_obj-list.db-num   = cli-obj.db-num
      216            .
      217         end.
      218      end.
      219   end.
