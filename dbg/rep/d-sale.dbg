        1   define input parameter parparentproc       as widget-handle no-undo .
        2   DEFINE INPUT PARAMETER rec_id              as  RECID .
        3   define input parameter p-quest-print       as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Список печатных форм  для продажи".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      117   define new shared variable RepPathName        as character no-undo .
      118   define new shared variable PrintRubl          as logical   no-undo .
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      121   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      122   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      123   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      124   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      125   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      126   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      127   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      128   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      129   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      130   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      131   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      132   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      133   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      134   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      135   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      136   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      137   define variable vss-include-info2 as character format "X(65)" no-undo
      138   initial "@(#)$Workfile$ $Revision$".
      139       define temp-table Tmp#List no-undo like ub.ord-blank
      140           field id                        as integer
      141           field proc-name                 as character
      142           field proc-param                as character
      143           field print-options             as character
      144           field orient                    as character
      145           field orient-orientation        as character
      146           field orient-font-num           as integer
      147           field font-num                  as character
      148           field filtr                     as character
      149           field view_                     as integer  init 1
      150           field sys-key                   as character
      151           field sys-key-black             as character
      152           field type-parts                as character
      153           field type-parts-enabled        as logical
      154           field type-price                as character
      155           field type-price-enabled        as logical
      156           field type-scale                as character
      157           field type-scale-enabled        as logical
      158           field type-val                  as character
      159           field type-val-enabled          as logical
      160           field sort-name                 as character
      161           field sort-name-enabled         as logical
      162           field sort-gr                   as character
      163           field sort-gr-enabled           as logical
      164           field print-graft               as character
      165           field print-graft-enabled       as logical
      166           field no-vat                    as character
      167           field no-vat-enabled            as logical
      168           index pi is primary unique id
      169           index in-name
      170              blank-name
      171           index lu
      172               last-use
      173       .
      174       define temp-table temp_form-list no-undo
      175           field doc-code  as character
      176           field id        as integer
      177           field doc-type  as character
      178           field status_   as character
      179           field internal  as character
      180           field flag      as character
      181           index pi is primary unique
      182               doc-code
      183               id
      184           index idx
      185               id
      186       .
      187       define temp-table temp_menu-doc_disabled-doc-list no-undo
      188           field doc-code      as character
      189           field blank-name    as character
      190           field reason        as character
      191           index pi is primary unique
      192                   doc-code
      193                   blank-name
      194       .
      195       define variable v-menu-doc-sys-key              as character    no-undo.
      196       define variable v-menu-doc-doc-code             as character    no-undo.
      197       define variable v-menu-doc-doc-type             as character    no-undo.
      198       define variable v-menu-doc-ext-doc-type         as character    no-undo.
      199       define variable v-menu-doc-status_              as character    no-undo.
      200       define variable v-menu-doc-internal             as character    no-undo.
      201       define variable v-menu-doc-flag                 as character    no-undo.
      202       define variable v-menu-doc-item-counter         as integer      no-undo.
      203       define variable v-menu-doc-item-disabled        as logical      no-undo.
      204   define variable vss-include-info3 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      205   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      206     define variable p-entry   as logical   no-undo .
      207     define variable v-ind as integer   no-undo .
      208     if p-delimiter = "*":U then do:
      209       message
      210         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      211         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      212         view-as alert-box error .
      213       return ? .
      214     end.
      215     assign
      216       p-entry = true
      217     .
      218     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      219       assign
      220         p-entry = false
      221       .
      222       if num-entries( p-list, "*":U ) > 1 then do:
      223         block_check-list:
      224         do v-ind = 1 to num-entries( p-list, p-delimiter )
      225         :
      226           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      227             assign
      228               p-entry = true
      229             .
      230             leave block_check-list .
      231           end.
      232         end.
      233       end.
      234     end.
      235     return p-entry .
      236   end function .
      237       procedure menu-doc-create-menu-item
      238       :
      239       define input parameter p-type   as   character no-undo.
      240       define input parameter p-stat   as   character no-undo.
      241       define input parameter p-intr   as   character no-undo.
      242       define input parameter p-flag   as   character no-undo.
      243       define input parameter param-1  as   character no-undo.
      244       define input parameter param-2  as   character no-undo.
      245       define input parameter param-3  as   character no-undo.
      246       define input parameter param-4  as   character no-undo.
      247       define input parameter param-5  as   character no-undo.
      248       define input parameter param-6  as   character no-undo.
      249       define input parameter param-7  as   character no-undo.
      250       define input parameter param-8  as   character no-undo.
      251       define input parameter param-9  as   character no-undo.
      252       define input parameter param-10 as   character no-undo.
      253       define input parameter param-11 as   character no-undo.
      254       define input parameter param-12 as   character no-undo.
      255       do
      256       on error undo, return error
      257       :
      258           assign
      259               v-menu-doc-item-disabled = yes
      260           .
      261           if v-menu-doc-sys-key <> 'ExpertekIBS':U
      262           and ( ( param-10 <> "":U
      263                   and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      264                 )
      265                 or ( param-12 <> "":U
      266                      and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      267                    )
      268           then do:
      269               undo, return .
      270           end.
      271           if param-7 = "":U
      272           then do:
      273               undo, return .
      274           end.
      275           if param-1 = '*':U
      276           or lookup( p-type, param-1 ) > 0
      277           then do:
      278               if param-2 = '*':U
      279               or lookup( p-stat, param-2 ) > 0
      280               then do:
      281                   if param-3 = '*':U
      282                   or lookup( p-intr, param-3 ) > 0
      283                   then do:
      284                       if param-4 = '*':U
      285                       or lookup( p-flag, param-4 ) > 0
      286                       then do:
      287                           assign
      288                               v-menu-doc-item-disabled = no
      289                           .
      290                           find first tmp#list
      291                                where tmp#list.blank-name     = param-5
      292                                  and tmp#list.filtr          = param-6
      293                                  and tmp#list.proc-name      = param-7
      294                                  and tmp#list.proc-param     = param-8
      295                                  and tmp#list.print-options  = param-9
      296                                  and tmp#list.sys-key        = param-10
      297                                  and tmp#list.orient         = param-11
      298                                  and tmp#list.sys-key-black  = param-12
      299                           no-error.
      300                           if not available tmp#list
      301                           then do:
      302                               assign
      303                                   v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      304                               .
      305                               create tmp#list.
      306                               assign
      307                                   tmp#list.id             = v-menu-doc-item-counter
      308                                   tmp#list.cli-code       = v-menu-doc-item-counter
      309                                   tmp#list.blank-name     = param-5
      310                                   tmp#list.filtr          = param-6
      311                                   tmp#list.proc-name      = param-7
      312                                   tmp#list.proc-param     = param-8
      313                                   tmp#list.print-options  = param-9
      314                                   tmp#list.sys-key        = param-10
      315                                   tmp#list.orient         = param-11
      316                                   tmp#list.sys-key-black  = param-12
      317                               .
      318                               assign
      319                                   tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      320                                   tmp#list.orient-font-num        = 7
      321                               .
      322                               assign
      323                                   tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      324                                                                     then integer( entry( 2, tmp#list.orient ) )
      325                                                                     else 7 )
      326                               no-error.
      327                               if error-status :error
      328                               then do:
      329                                   assign
      330                                       tmp#list.orient-font-num = 7
      331                                   .
      332                               end.
      333                               run menu-doc-set-visible-options in this-procedure (
      334                                     input tmp#list.print-options
      335                                   , output tmp#list.type-parts-enabled
      336                                   , output tmp#list.type-price-enabled
      337                                   , output tmp#list.type-scale-enabled
      338                                   , output tmp#list.type-val-enabled
      339                                   , output tmp#list.sort-name-enabled
      340                                   , output tmp#list.sort-gr-enabled
      341                                   , output tmp#list.print-graft-enabled
      342                                   , output tmp#list.no-vat-enabled
      343                               ).
      344                           end.
      345                       end.
      346                   end.
      347               end.
      348           end.
      349           if v-menu-doc-item-disabled = yes
      350           then do:
      351               find first tmp#list
      352                    where tmp#list.blank-name     = param-5
      353                      and tmp#list.filtr          = param-6
      354                      and tmp#list.proc-name      = param-7
      355                      and tmp#list.proc-param     = param-8
      356                      and tmp#list.print-options  = param-9
      357                      and tmp#list.sys-key        = param-10
      358                      and tmp#list.orient         = param-11
      359                      and tmp#list.sys-key-black  = param-12
      360               no-error.
      361               if available tmp#list
      362               then do:
      363                   find first temp_menu-doc_disabled-doc-list
      364                        where temp_menu-doc_disabled-doc-list.doc-code     = v-menu-doc-doc-code
      365                          and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      366                   no-error.
      367                   if not available temp_menu-doc_disabled-doc-list
      368                   then do:
      369                       create temp_menu-doc_disabled-doc-list.
      370                       assign
      371                           temp_menu-doc_disabled-doc-list.doc-code    = v-menu-doc-doc-code
      372                           temp_menu-doc_disabled-doc-list.blank-name  = param-5
      373                       .
      374                   end.
      375                   if param-1 <> '*':U
      376                   and lookup( p-type, param-1 ) > 0
      377                   then do:
      378                       assign
      379                           temp_menu-doc_disabled-doc-list.reason   = "type":U
      380                       .
      381                   end.
      382                   assign
      383                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      384                   .
      385                   if param-2 <> '*':U
      386                   and lookup( p-stat, param-2 ) > 0
      387                   then do:
      388                       assign
      389                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      390                       .
      391                   end.
      392                   assign
      393                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      394                   .
      395                   if param-3 <> '*':U
      396                   and lookup( p-intr, param-3 ) > 0
      397                   then do:
      398                       assign
      399                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "intr":U
      400                       .
      401                   end.
      402                   assign
      403                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      404                   .
      405                   if param-4 <> '*':U
      406                   and lookup( p-flag, param-4 ) > 0
      407                   then do:
      408                       assign
      409                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "flag":U
      410                       .
      411                   end.
      412                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      413                   then do:
      414                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      415                             input tmp#list.blank-name
      416                           , input tmp#list.sys-key
      417                           , input Tmp#List.sys-key-black
      418                           , output tmp#list.blank-name
      419                       ).
      420                   end.
      421               end.
      422               else do:
      423                   assign
      424                       v-menu-doc-item-disabled = no
      425                   .
      426               end.
      427           end.
      428           if v-menu-doc-item-disabled = no
      429           then do:
      430               find first tmp#list
      431                    where tmp#list.blank-name     = param-5
      432                      and tmp#list.filtr          = param-6
      433                      and tmp#list.proc-name      = param-7
      434                      and tmp#list.proc-param     = param-8
      435                      and tmp#list.print-options  = param-9
      436                      and tmp#list.sys-key        = param-10
      437                      and tmp#list.orient         = param-11
      438                      and tmp#list.sys-key-black  = param-12
      439               no-error.
      440               if available tmp#list
      441               then do:
      442                   find first temp_form-list
      443                        where temp_form-list.doc-code  = v-menu-doc-doc-code
      444                          and temp_form-list.id        = tmp#list.id
      445                   no-error.
      446                   if not available temp_form-list
      447                   then do:
      448                       create temp_form-list.
      449                       assign
      450                           temp_form-list.doc-code  = v-menu-doc-doc-code
      451                           temp_form-list.id        = tmp#list.id
      452                           temp_form-list.doc-type  = v-menu-doc-doc-type
      453                           temp_form-list.status_   = v-menu-doc-status_
      454                           temp_form-list.internal  = v-menu-doc-internal
      455                           temp_form-list.flag      = v-menu-doc-flag
      456                       .
      457                   end.
      458                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      459                   then do:
      460                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      461                             input tmp#list.blank-name
      462                           , input tmp#list.sys-key
      463                           , input Tmp#List.sys-key-black
      464                           , output tmp#list.blank-name
      465                       ).
      466                   end.
      467               end.
      468           end.
      469       end.
      470       end procedure.
      471       procedure menu-doc-set-visible-options :
      472       define input parameter p-print-options          as character        no-undo.
      473       define output parameter p-type-parts-enabled    as logical          no-undo.
      474       define output parameter p-type-price-enabled    as logical          no-undo.
      475       define output parameter p-type-scale-enabled    as logical          no-undo.
      476       define output parameter p-type-val-enabled      as logical          no-undo.
      477       define output parameter p-sort-name-enabled     as logical          no-undo.
      478       define output parameter p-sort-gr-enabled       as logical          no-undo.
      479       define output parameter p-print-graft-enabled   as logical          no-undo.
      480       define output parameter p-no-vat-enabled        as logical          no-undo.
      481       do
      482       on error undo, return error
      483       :
      484           assign
      485               p-type-parts-enabled    = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      486               p-type-price-enabled    = ( if substring( p-print-options, 2, 1 ) = "+" then yes else no )
      487               p-type-scale-enabled    = ( if substring( p-print-options, 3, 1 ) = "+" then yes else no )
      488               p-type-val-enabled      = ( if substring( p-print-options, 4, 1 ) = "+" then yes else no )
      489               p-sort-name-enabled     = ( if substring( p-print-options, 5, 1 ) = "+" then yes else no )
      490               p-sort-gr-enabled       = ( if substring( p-print-options, 6, 1 ) = "+" then yes else no )
      491               p-print-graft-enabled   = ( if substring( p-print-options, 7, 1 ) = "+" then yes else no )
      492               p-no-vat-enabled        = ( if substring( p-print-options, 8, 1 ) = "+" then yes else no )
      493           .
      494       end.
      495       end procedure.
      496       procedure menu-doc-create-options-string :
      497       define input parameter p-tmp-list-id        as integer          no-undo.
      498       define output parameter p-options-string    as character        no-undo.
      499           define buffer buf_tmp#list      for tmp#list.
      500       do
      501       for buf_tmp#list
      502       on error undo, return error
      503       :
      504           find first buf_tmp#list
      505                where buf_tmp#list.id = p-tmp-list-id
      506           .
      507           assign
      508               p-options-string =  ( if trim( buf_tmp#list.type-parts  ) = "+":U then "+":U else "-":U )
      509                                 + ( if trim( buf_tmp#list.type-price  ) = "+":U then "+":U else "-":U )
      510                                 + ( if trim( buf_tmp#list.type-scale  ) = "+":U then "+":U else "-":U )
      511                                 + ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      512                                 + ( if trim( buf_tmp#list.sort-name   ) = "+":U then "+":U else "-":U )
      513                                 + ( if trim( buf_tmp#list.sort-gr     ) = "+":U then "+":U else "-":U )
      514                                 + ( if trim( buf_tmp#list.print-graft ) = "+":U then "+":U else "-":U )
      515                                 + ( if trim( buf_tmp#list.no-vat      ) = "+":U then "+":U else "-":U )
      516           .
      517       end.
      518       end procedure.
      519       procedure menu-doc-set-options-string :
      520       define input parameter p-tmp-list-id            as integer          no-undo.
      521       define input parameter p-options-string         as character        no-undo.
      522           define buffer buf_tmp#list      for tmp#list.
      523       do
      524       for buf_tmp#list
      525       on error undo, return error
      526       :
      527           find first buf_tmp#list
      528                where buf_tmp#list.id = p-tmp-list-id
      529           .
      530           assign
      531               buf_tmp#list.type-parts  = ( if buf_tmp#list.type-parts-enabled     = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      532               buf_tmp#list.type-price  = ( if buf_tmp#list.type-price-enabled     = yes then substitute( "  &1", substring( p-options-string, 2, 1 ) ) else " ":U )
      533               buf_tmp#list.type-scale  = ( if buf_tmp#list.type-scale-enabled     = yes then substitute( "  &1", substring( p-options-string, 3, 1 ) ) else " ":U )
      534               buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 4, 1 ) ) else " ":U )
      535               buf_tmp#list.sort-name   = ( if buf_tmp#list.sort-name-enabled      = yes then substitute( "  &1", substring( p-options-string, 5, 1 ) ) else " ":U )
      536               buf_tmp#list.sort-gr     = ( if buf_tmp#list.sort-gr-enabled        = yes then substitute( "  &1", substring( p-options-string, 6, 1 ) ) else " ":U )
      537               buf_tmp#list.print-graft = ( if buf_tmp#list.print-graft-enabled    = yes then substitute( "  &1", substring( p-options-string, 7, 1 ) ) else " ":U )
      538               buf_tmp#list.no-vat      = ( if buf_tmp#list.no-vat-enabled         = yes then substitute( "  &1", substring( p-options-string, 8, 1 ) ) else " ":U )
      539           .
      540       end.
      541       end procedure.
      542       procedure menu-doc-create-options-enabled-string :
      543       define input parameter p-tmp-list-id                as integer          no-undo.
      544       define output parameter p-options-enabled-string    as character        no-undo.
      545           define buffer buf_tmp#list      for tmp#list.
      546       do
      547       for buf_tmp#list
      548       on error undo, return error
      549       :
      550           find first buf_tmp#list
      551                where buf_tmp#list.id = p-tmp-list-id
      552           .
      553           assign
      554               p-options-enabled-string =  ( if buf_tmp#list.type-parts-enabled  = yes then "+":U else "-":U )
      555                                         + ( if buf_tmp#list.type-price-enabled  = yes then "+":U else "-":U )
      556                                         + ( if buf_tmp#list.type-scale-enabled  = yes then "+":U else "-":U )
      557                                         + ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
      558                                         + ( if buf_tmp#list.sort-name-enabled   = yes then "+":U else "-":U )
      559                                         + ( if buf_tmp#list.sort-gr-enabled     = yes then "+":U else "-":U )
      560                                         + ( if buf_tmp#list.print-graft-enabled = yes then "+":U else "-":U )
      561                                         + ( if buf_tmp#list.no-vat-enabled      = yes then "+":U else "-":U )
      562           .
      563       end.
      564       end procedure.
      565       procedure menu-doc-extend-blank-name-for-IBS :
      566       define input parameter p-in-blank-name      as character        no-undo.
      567       define input parameter p-sys-key            as character        no-undo.
      568       define input parameter p-sys-key-black      as character        no-undo.
      569       define output parameter p-out-blank-name    as character        no-undo.
      570       do
      571       on error undo, return error
      572       :
      573           assign
      574               p-out-blank-name = p-in-blank-name
      575           .
      576           if p-sys-key <> "":U
      577           then do:
      578               assign
      579                   p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
      580               .
      581           end.
      582           if p-sys-key-black <> ""
      583           then do:
      584               assign
      585                   p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
      586               .
      587           end.
      588       end.
      589       end procedure.
      590   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   procedure cur-time :
      592      define output parameter p-today as date      no-undo .
      593      define output parameter p-time  as integer   no-undo .
      594     do
      595     on error undo, return error
      596     :
      597       define variable v-date1 as date      no-undo .
      598       define variable v-date2 as date      no-undo .
      599       define variable v-time  as integer   no-undo .
      600       assign
      601         v-date1 = today
      602         v-time  = time
      603         v-date2 = today
      604       .
      605       if v-date1 <> v-date2
      606       then do:
      607         assign
      608           v-date1 = today
      609           v-time  = v-time
      610         .
      611       end.
      612       assign
      613         p-today = v-date1
      614         p-time  = v-time
      615       .
      616     end.
      617   end.
      618   function cur-time-date returns character
      619   :
      620     return string(today, '99/99/9999':U) .
      621   end.
      622   function cur-time-mjd returns decimal
      623   :
      624     define variable v-date as date      no-undo .
      625     define variable v-time as integer   no-undo .
      626     run cur-time in this-procedure
      627       (output v-date
      628       ,output v-time
      629       ) .
      630     return integer(v-date) - 2400002 + (v-time / 86400) .
      631   end.
      632   function cur-time-get-ending-index returns integer
      633   (input p-number as integer
      634   )
      635   :
      636     if p-number < 0
      637     or p-number = ?
      638     then do:
      639       return 1 .
      640     end.
      641     define variable v-rest as integer   no-undo .
      642     assign
      643       p-number = p-number modulo 100
      644     .
      645     if p-number < 20
      646     then do:
      647       assign
      648         v-rest = p-number
      649       .
      650     end.
      651     else do:
      652       assign
      653         v-rest = p-number modulo 10
      654       .
      655     end.
      656     case v-rest :
      657       when 1
      658       then do:
      659         return 2 .
      660       end.
      661       when 2 or
      662       when 3 or
      663       when 4
      664       then do:
      665         return 3 .
      666       end.
      667       otherwise do:
      668         return 1 .
      669       end.
      670     end case .
      671   end.
      672   procedure cur-time-mjd-to-date :
      673      define input  parameter i-mjd-diff as decimal no-undo.
      674      define output parameter o-Date     as date    no-undo.
      675      define output parameter o-Time     as integer no-undo.
      676      define variable v-day-number as integer   no-undo .
      677      if    i-mjd-diff < 0
      678         or i-mjd-diff = ?
      679      then do:
      680         return "?" .
      681      end.
      682      assign
      683         v-day-number = truncate(i-mjd-diff,0).
      684         o-Date = date(v-day-number + 2400002).
      685         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      686     .
      687   end.
      688   function cur-time-mjd-to-string returns character
      689   (input p-mjd-diff as decimal
      690   )
      691   :
      692     define variable v-day-number as integer   no-undo .
      693     define variable v-seconds    as integer   no-undo .
      694     define variable v-hour       as integer   no-undo .
      695     define variable v-min        as integer   no-undo .
      696     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      697     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      698     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      699     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      700     if p-mjd-diff < 0
      701     or p-mjd-diff = ?
      702     then do:
      703       return "?" .
      704     end.
      705     assign
      706       v-day-number = integer(truncate(p-mjd-diff,0))
      707       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      708     .
      709     if v-seconds > 86400
      710     then do:
      711       assign
      712         v-seconds = 86400 - 1
      713       .
      714     end.
      715     if v-seconds < 0
      716     then do:
      717       assign
      718         v-seconds = 0
      719       .
      720     end.
      721     assign
      722       v-hour = truncate(v-seconds / 3600, 0)
      723     .
      724     assign
      725       v-seconds = v-seconds modulo 3600
      726     .
      727     assign
      728       v-min = truncate(v-seconds / 60, 0)
      729     .
      730     assign
      731       v-seconds = v-seconds modulo 60
      732     .
      733     return
      734         (if v-day-number <> 0
      735           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      736           else ""
      737         )
      738       + (if v-day-number <> 0 or v-hour <> 0
      739           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      740           else ""
      741         )
      742       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      743           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      744           else ""
      745         )
      746       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      747       .
      748   end.
      749   function cur-time-string returns character
      750   :
      751     define variable v-date as date      no-undo .
      752     define variable v-time as integer   no-undo .
      753     run cur-time in this-procedure
      754       (output v-date
      755       ,output v-time
      756       ) .
      757     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      758   end.
      759   function cur-time-string-sec returns character
      760   :
      761     define variable v-date as date      no-undo .
      762     define variable v-time as integer   no-undo .
      763     run cur-time in this-procedure
      764       (output v-date
      765       ,output v-time
      766       ) .
      767     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      768   end.
      769   function cur-time-custom  returns character
      770   (input p-prefix as character
      771   ,input p-date-format as character
      772   ,input p-delimiter as character
      773   ,input p-time-format as character
      774   ,input p-suffix as character
      775   )
      776   :
      777     define variable v-date as date      no-undo .
      778     define variable v-time as integer   no-undo .
      779     run cur-time in this-procedure
      780       (output v-date
      781       ,output v-time
      782       ) .
      783     return
      784       p-prefix
      785       + string(v-date, p-date-format)
      786       + p-delimiter
      787       + string(v-time, p-time-format)
      788       + p-suffix
      789       .
      790   end.
      791   function cur-time-print  returns character
      792   :
      793     define variable v-date as date      no-undo .
      794     define variable v-time as integer   no-undo .
      795     run cur-time in this-procedure
      796       (output v-date
      797       ,output v-time
      798       ) .
      799     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      800   end.
      801   function cur-time-datetime returns datetime
      802   :
      803     define variable v-char as character no-undo .
      804     define variable v-datetime as datetime no-undo .
      805     v-char = cur-time-string().
      806     v-datetime = datetime(v-char).
      807     return  v-datetime.
      808   end.
      809   function cur-time-string-msec returns character
      810   :
      811     define variable v-date as datetime  no-undo .
      812     v-date = now.
      813     return string(v-date) .
      814   end.
      815   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   define  stream PrnLibStream.
      817   procedure prn-lib-prn-file :
      818     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      819     define input parameter p-DIsabledoptions as integer no-undo .
      820     define variable v-report-name as character no-undo .
      821     define variable v-user-action as character no-undo .
      822     define variable v-printed     as logical   no-undo .
      823     define variable v-exist       as logical   no-undo .
      824     do
      825       on error undo, return error
      826       :
      827       run prn-lib-get-report-name  in this-procedure (
      828         input parParentProc
      829         ,output v-report-name
      830         ).
      831   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      833     (input  v-report-name
      834     ,input  2
      835     ,output v-exist
      836     )  .
      837       if NOT v-exist then
      838       DO:
      839         Message
      840           "Нет заданий на печать ! "
      841           view-as alert-box .
      842         Return  .
      843       End.
      844       run gbl/prnfilen.w
      845         (input  ""
      846         ,input  p-DisabledOptions
      847         ,input  string(v-report-name )
      848         ,input  7
      849         ,output v-user-action
      850         ,output v-printed
      851         ) .
      852       if v-printed then
      853       do:
      854         return "YES" .
      855       end.
      856       else
      857       do:
      858         return "NO" .
      859       end.
      860     end.
      861   end procedure.
      862   procedure prn-lib-open-stream :
      863     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      864     define input parameter p-page-size    as integer no-undo .
      865     define input parameter p-is-stream    as logical no-undo .
      866     define input parameter p-append       as logical no-undo .
      867     define variable v-report-name as character no-undo .
      868     do
      869       on error undo, return error
      870       :
      871       run prn-lib-get-report-name  in this-procedure (
      872         input parParentProc
      873         ,output v-report-name
      874         ).
      875       if p-is-stream then
      876       do:
      877         if p-append then
      878         do:
      879           output stream PrnLibStream to value( v-report-name )
      880             page-size value(p-page-size) append .
      881         end.
      882         if not p-append then
      883         do:
      884           output stream PrnLibStream to value( v-report-name )
      885             page-size value(p-page-size) .
      886         end.
      887       end.
      888       if not p-is-stream then
      889       do:
      890         if p-append then
      891         do:
      892           output to value( v-report-name )
      893             page-size value(p-page-size) append .
      894         end.
      895         if not p-append then
      896         do:
      897           output to value( v-report-name )
      898             page-size value(p-page-size) .
      899         end.
      900       end.
      901     end.
      902   end procedure.
      903   procedure prn-lib-open-exp :
      904     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      905     define input parameter p-is-stream    as logical no-undo .
      906     define input parameter p-is-append    as logical no-undo .
      907     define output parameter p-ReportFileName as char init "report" no-undo.
      908     define output parameter p-process as logical no-undo .
      909     define variable glog as logical no-undo .
      910     do
      911       on error undo, return error
      912       :
      913       SYSTEM-DIALOG GET-FILE p-ReportFileName
      914         TITLE      "Укажите путь"
      915         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      916         ASK-OVERWRITE
      917         CREATE-TEST-FILE
      918         SAVE-AS
      919         USE-FILENAME
      920         DEFAULT-EXTENSION "txt"
      921         UPDATE glog
      922         .
      923       if not glog then  return.
      924       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      925       if p-is-stream then
      926       do:
      927         if p-is-append then
      928         do:
      929           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      930         end.
      931         else
      932         do:
      933           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      934         end.
      935       end.
      936       else
      937       do:
      938         if p-is-append then
      939         do:
      940           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      941         end.
      942         else
      943         do:
      944           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      945         end.
      946       end.
      947       p-process = yes.
      948     end.
      949   end procedure.
      950   procedure prn-lib-get-report-name :
      951     define input parameter parParentProc  as widget-handle no-undo.
      952     define output parameter p-report-name as character no-undo .
      953     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      954   end procedure.
      955   procedure prn-lib-reportviewer-report-name :
      956     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      957     define input parameter p-report-name-html as character no-undo .
      958     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      959   end procedure.
      960   procedure prn-lib-reportviewer :
      961     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      962     define input parameter p-report-name-html as character no-undo .
      963     define input parameter p-param        as character no-undo .
      964     define variable v-excel           as character no-undo init 'TRUE' .
      965     define variable v-value-character as character no-undo .
      966     define variable v-value-integer   as character no-undo .
      967     define variable v-value-date      as date      no-undo .
      968     define variable v-value-decimal   as decimal   no-undo .
      969     define variable rep-excel         as logical   no-undo .
      970     define variable excel-string      as character no-undo .
      971     define variable v-param-type      as character no-undo .
      972     define variable v-tth             as handle    no-undo .
      973     run adm/shattri.p (
      974       input "get":U
      975       ,input  ""
      976       ,input  0
      977       ,input  'report-glob':U
      978       ,input  'rep-excel':U
      979       ,output v-value-character
      980       ,output v-value-date
      981       ,output v-value-decimal
      982       ,output v-value-integer
      983       ,output rep-excel
      984       ,output v-param-type
      985       ,INPUT-OUTPUT table-handle v-tth
      986       )  .
      987     if rep-excel then v-excel = "TRUE" .
      988     else v-excel = "FALSE" .
      989     if p-param eq ""
      990     then
      991        p-param = "EXCEL:" + v-excel.
      992     else
      993        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      994     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      995   end procedure.
      996   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   define variable v-waitfram-action01         as character   no-undo .
      998   define variable v-waitfram-action02         as character   no-undo .
      999   define variable v-waitfram-action03         as character   no-undo .
     1000   define variable mWaitFramTextBeg            as character   no-undo.
     1001   define variable mWaitFramTextEnd            as character   no-undo.
     1002   define variable mWaitFramView               as logical     no-undo.
     1003   define variable mWaitProcEvent              as logical     no-undo init yes.
     1004   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1005   define variable mWaitFramStop               as logical     no-undo.
     1006   define variable mWaitFramStopUser           as logical     no-undo.
     1007   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1008   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1009   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1010   define button B-WaitFramStop auto-end-key
     1011        label "Стоп"
     1012        size 10 by 1 tooltip "Остоновить процесс".
     1013   define button B-viewProcInfo
     1014        label "Информация"
     1015        size 15 by 1 tooltip "Информация о процесс".
     1016   define frame waitfram
     1017     v-waitfram-action01 format "x(72)" no-label skip
     1018     v-waitfram-action02 format "x(72)" no-label skip
     1019     v-waitfram-action03 format "x(72)" no-label skip
     1020     B-viewProcInfo
     1021     B-WaitFramStop at row 4 col 30
     1022     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1023     .
     1024   define new global shared variable mBatchMode as logical no-undo init ?.
     1025   define variable mFramBachModHandle as handle no-undo.
     1026   mFramBachModHandle = frame waitfram:handle.
     1027   define variable mFameOldVis as logical no-undo.
     1028   define variable mVisCUrentVin as logical no-undo.
     1029   if session:batch-mode
     1030   then
     1031      mBatchMode = yes.
     1032   if mBatchMode = ? then do:
     1033     mVisCUrentVin = current-window:visible.
     1034     mFameOldVis = mFramBachModHandle:visible.
     1035     mFramBachModHandle:visible  = yes.
     1036     mBatchMode = mFramBachModHandle:visible ne yes.
     1037     mFramBachModHandle:visible = mFameOldVis.
     1038     current-window:visible = mVisCUrentVin.
     1039   end.
     1040    if  log-manager:logfile-name ne ?
     1041     then DO:
     1042         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1043         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1044         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1045     end.
     1046   on choose of B-WaitFramStop in frame waitfram
     1047   do:
     1048     mWaitFramStop = yes.
     1049     mWaitFramStopUser = yes.
     1050   end.
     1051   function waitfram-check-timeout returns logical():
     1052      define variable vtime as int64 no-undo.
     1053      if mWaitFramStopTimeOut
     1054      then
     1055         return yes.
     1056      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1057      if     mWaitFramTimeOut ne ?
     1058         and mWaitFramTimeOut ne 0
     1059         and mWaitFramTimeOut lt vtime
     1060      then do:
     1061         mWaitFramStopTimeOut = yes.
     1062      end.
     1063      return mWaitFramStopTimeOut.
     1064   end.
     1065   procedure waitfram-hide :
     1066     if not session:batch-mode
     1067     then do
     1068     on error undo, return error return-value
     1069     :
     1070       pause 0 before-hide .
     1071       if not mBatchMode then
     1072         hide frame waitfram .
     1073     if     not mWaitFramView
     1074        and mWaitProcEvent
     1075     then
     1076       process events .
     1077     end.
     1078   end procedure.
     1079   procedure waitfram-show :
     1080     define input  parameter p-message as character no-undo .
     1081     define variable v-left-margin as integer   no-undo .
     1082     if not session:batch-mode
     1083     then do
     1084     on error undo, return error return-value
     1085     :
     1086       if length(p-message) <= 70 then do:
     1087         assign
     1088           v-left-margin = integer((70 - length(p-message)) / 2)
     1089         .
     1090         assign
     1091           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1092         .
     1093         assign
     1094           v-waitfram-action01 = " "
     1095           v-waitfram-action02 = " "
     1096                                    + fill(" ", v-left-margin)
     1097                                    + p-message
     1098           v-waitfram-action03 = " "
     1099         .
     1100       end.
     1101       else do:
     1102         define variable vRindex1 as integer no-undo.
     1103         define variable vRindex2 as integer no-undo.
     1104         vRindex1 = r-index(p-message," ",70).
     1105         if vRindex1 = 0
     1106         then
     1107            vRindex1 = 70.
     1108         if length(p-message)  <= vRindex1 + 70 then do:
     1109           assign
     1110             v-waitfram-action01 = " "
     1111             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1112             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1113           .
     1114         end.
     1115         else do:
     1116           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1117           if vRindex2 <= vRindex1
     1118           then
     1119              vRindex2 = vRindex1 + 70.
     1120           assign
     1121             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1122             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1123             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1124           .
     1125         end.
     1126       end.
     1127       B-viewProcInfo:visible   in frame waitfram = no.
     1128       B-viewProcInfo:sensitive in frame waitfram = no.
     1129       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1130       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1131       if  (   mWaitFramView
     1132          or  mWaitProcEvent)
     1133          and not mBatchMode
     1134       then
     1135          display
     1136             v-waitfram-action01 skip
     1137             v-waitfram-action02 skip
     1138             v-waitfram-action03 skip
     1139          with frame waitfram .
     1140       if     mWaitFramView
     1141          then do:
     1142             if     mWaitFramInterval ne ?
     1143                and not mBatchMode
     1144             then
     1145                wait-for go of frame waitfram pause mWaitFramInterval.
     1146          end.
     1147          else
     1148             if     mWaitProcEvent
     1149                and not mBatchMode
     1150             then
     1151                process events .
     1152     end.
     1153   end procedure.
     1154      procedure waitfram-show-this:
     1155         define input  parameter iInterval as int64 no-undo.
     1156         define variable vtime as int64 no-undo.
     1157         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1158         mWaitFramInterval = iInterval.
     1159         run waitfram-show (substitute("&1&2 &3&4" ,
     1160                                       mWaitFramTextBeg ,
     1161                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1162                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1163                                       mWaitFramTextEnd
     1164                                      )
     1165                           ).
     1166      end.
     1167      procedure WaitFramRunPause:
     1168         define input  parameter iInterval as dec no-undo.
     1169         define variable vStart  as datetime-tz no-undo.
     1170         define variable vend    as datetime-tz no-undo.
     1171         define variable vint as int64 no-undo.
     1172         define variable vOk as logical no-undo.
     1173         vStart = now.
     1174         vend   = vStart.
     1175         publish "WaitFramPause" (iInterval,output vOk).
     1176         vend   =  now.
     1177         vint = vend - vStart.
     1178         vint = iInterval - vint / 1000.
     1179         if     not mWaitFramStop
     1180            and (   vint > 0
     1181                 or (    not vOk
     1182                     and iInterval eq ?
     1183                     )
     1184                 )
     1185         then
     1186            run waitfram-show-this (iInterval).
     1187         vend   =  now.
     1188         vint = vend - vStart.
     1189         vint = iInterval - vint / 1000.
     1190         if     not mWaitFramStop
     1191            and vint > 0
     1192         then do:
     1193            run gbl/pause.p (vint * 1000).
     1194         end.
     1195         if iInterval ne ?
     1196         then
     1197            publish "WaitFramStop".
     1198         waitfram-check-timeout().
     1199      end.
     1200      procedure WaitFramWaitFor:
     1201         define input  parameter iInterval as dec no-undo.
     1202         assign
     1203            mWaitFramStartProc   = now
     1204            mWaitFramStopUser    = no
     1205            mWaitFramStopTimeOut = no
     1206         .
     1207         block-wait:
     1208         do while not mWaitFramStop:
     1209            run WaitFramRunPause (iInterval).
     1210            if  waitfram-check-timeout()
     1211            then do:
     1212               leave block-wait.
     1213            end.
     1214         end.
     1215         run waitfram-hide.
     1216      end.
     1217   procedure waitfram-join :
     1218     define input  parameter p-line-1  as character no-undo .
     1219     define input  parameter p-line-2  as character no-undo .
     1220     define input  parameter p-line-3  as character no-undo .
     1221     define output parameter p-message as character no-undo .
     1222     do
     1223     on error undo, return error return-value
     1224     :
     1225       assign
     1226         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1227                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1228                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1229       .
     1230     end.
     1231   end procedure.
     1232   function waitfram-join-function returns character
     1233     (input p-line-1 as character
     1234     ,input p-line-2 as character
     1235     ,input p-line-3 as character
     1236     ).
     1237     define variable v-message as character no-undo .
     1238     run waitfram-join in this-procedure
     1239       (input  p-line-1
     1240       ,input  p-line-2
     1241       ,input  p-line-3
     1242       ,output v-message
     1243       ) .
     1244     return v-message .
     1245   end function .
     1246   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247     define variable v-cntxt-db-num        as integer   no-undo .
     1248     define variable v-cntxt-userid        as character no-undo .
     1249     define variable v-cntxt-level         as character no-undo .
     1250     define variable v-cntxt-host-code-obj as integer   no-undo .
     1251     define variable v-cntxt-obj-type      as character no-undo .
     1252     define variable v-cntxt-obj-code      as integer   no-undo .
     1253     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1254     define variable v-cntxt-is-admin      as logical   no-undo .
     1255   define variable ii as int no-undo .
     1256   define variable Nesoot_Flag  as logical  no-undo .
     1257   define variable stat                 as logical  no-undo .
     1258   define variable in-docprvalue as character no-undo.
     1259   define variable in-docprtype  as character no-undo.
     1260   define variable List_  as character no-undo.
     1261   def new shared  var CostPrice as logical no-undo .
     1262   def new shared  var PrintScale as logical no-undo .
     1263   define variable sys-key as char no-undo.
     1264   define variable p-doc-tp as character no-undo .
     1265   define buffer buf_inkas for ub.inkas.
     1266   define buffer buf_usr-flt for ubflt.usr-flt .
     1267   DEFINE BUTTON b-erase
     1268        LABEL "&Снять все *":L
     1269        SIZE 12 BY 1 TOOLTIP "Снять все отметки"
     1270        BGCOLOR 8 .
     1271   DEFINE BUTTON b-exit AUTO-END-KEY
     1272        LABEL "&Выход ":L
     1273        SIZE 10 BY 1
     1274        BGCOLOR 8 .
     1275   DEFINE BUTTON b-help
     1276        LABEL "&Помощь":L
     1277        SIZE 10 BY 1
     1278        BGCOLOR 8 .
     1279   DEFINE BUTTON b-mark
     1280        LABEL "&*":L
     1281        SIZE 3 BY 1
     1282        BGCOLOR 8 .
     1283   DEFINE BUTTON b-print
     1284        LABEL "Выполнить/Пе&чать":L
     1285        SIZE 20 BY 1
     1286        BGCOLOR 8 .
     1287   DEFINE VARIABLE v-printer-name AS CHARACTER FORMAT "X(256)":U
     1288        LABEL "Текущий принтер"
     1289         VIEW-AS TEXT
     1290        SIZE 46.13 BY .67
     1291        FGCOLOR 4  NO-UNDO.
     1292   DEFINE QUERY BROWSE-2 FOR
     1293         Tmp#List SCROLLING.
     1294   DEFINE BROWSE BROWSE-2
     1295     QUERY BROWSE-2 DISPLAY
     1296         Tmp#List.last-use COLUMN-LABEL "*" FORMAT "*/"
     1297         Tmp#List.blank-name COLUMN-LABEL "Название документа":C59 FORMAT "X(59)"
     1298     ENABLE
     1299         Tmp#List.last-use
     1300       WITH NO-BOX NO-ROW-MARKERS SEPARATORS SIZE 63.88 BY 14.58.
     1301   DEFINE FRAME Dialog-Frame
     1302        b-exit AT ROW 1 COL 1
     1303        b-mark AT ROW 1 COL 11
     1304        b-erase AT ROW 1 COL 14
     1305        b-print AT ROW 1 COL 34
     1306        b-help AT ROW 1 COL 54
     1307        BROWSE-2 AT ROW 2.25 COL 1.38
     1308        v-printer-name AT ROW 17.13 COL 17 COLON-ALIGNED
     1309        SPACE(1.11) SKIP(0.27)
     1310       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1311            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1312            TITLE "".
     1313   ASSIGN
     1314          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1315          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1316   ASSIGN
     1317          BROWSE-2:MAX-DATA-GUESS IN FRAME Dialog-Frame         = 200.
     1318   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1319   DO:
     1320     APPLY "END-ERROR":U TO SELF.
     1321   END.
     1322   ON ROW-DISPLAY OF BROWSE-2 IN FRAME Dialog-Frame
     1323   DO:
     1324     if Tmp#List.orient = 'A4port'
     1325     or Tmp#List.orient = 'A3port'
     1326     then do:
     1327         Tmp#List.last-use          :fgcolor in browse BROWSE-2 = blue_color.
     1328         Tmp#List.blank-name        :fgcolor in browse BROWSE-2 = blue_color.
     1329     end.
     1330     else do:
     1331       if Tmp#List.orient = 'EXCEL'
     1332       or Tmp#List.orient = 'self'
     1333       then do:
     1334           Tmp#List.last-use   :fgcolor in browse BROWSE-2 = CYAN_COLOR.
     1335           Tmp#List.blank-name :fgcolor in browse BROWSE-2 = CYAN_COLOR.
     1336       end.
     1337       else do:
     1338           Tmp#List.last-use   :fgcolor in browse BROWSE-2 = black_color.
     1339           Tmp#List.blank-name :fgcolor in browse BROWSE-2 = black_color.
     1340       end.
     1341     end.
     1342   END.
     1343   ON CHOOSE OF b-erase IN FRAME Dialog-Frame
     1344   DO:
     1345     for each tmp#list
     1346     :
     1347       assign
     1348         Tmp#List.last-use = false
     1349       .
     1350     end.
     1351     OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.id.
     1352   END.
     1353   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1354   OR MOUSE-SELECT-DBLCLICK OF BROWSE-2 IN FRAME Dialog-Frame
     1355   DO:
     1356   define variable glog as logical no-undo .
     1357       if not available tmp#list
     1358       then do:
     1359           message "Неправильный выбор строки.".
     1360           return no-apply.
     1361       end.
     1362       BROWSE-2 :refresh ().
     1363       if Tmp#List.last-use = true
     1364       then do:
     1365           assign
     1366               Tmp#List.last-use = false
     1367           .
     1368           display
     1369               "" @ Tmp#List.last-use
     1370           with browse BROWSE-2.
     1371       end.
     1372       else do:
     1373           assign
     1374               Tmp#List.last-use = true
     1375           .
     1376           display
     1377               "*" @ Tmp#List.last-use
     1378           with browse BROWSE-2.
     1379       end.
     1380       apply "VALUE-CHANGED" to BROWSE-2 in frame Dialog-Frame.
     1381       assign
     1382           glog = BROWSE-2:select-next-row ()
     1383       .
     1384   END.
     1385   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1386   DO:
     1387     define variable lok as logical no-undo .
     1388     define variable v-frame-width as integer no-undo .
     1389     define variable g#quest-print as logical no-undo .
     1390     define variable g#report-num as integer no-undo .
     1391     Find first ub.Sysconf where buf_inkas.host-code = ub.Sysconf.host-code
     1392         no-lock no-error.
     1393     define variable         PrintDoc              as      logical no-undo .
     1394     define variable         PrintSet              as      logical no-undo .
     1395     define variable         Print-Round           AS      LOGICAL INITIAL yes no-undo .
     1396       define variable l-recid as recid no-undo .
     1397       Assign List_ = '' ii = 0.
     1398       l-recid = recid(Tmp#List) .
     1399       For each Tmp#List
     1400       :
     1401           if Tmp#List.last-use <> false
     1402           then Assign
     1403               ii = ii + 1
     1404               List_ = List_ + ',' + string(tmp#list.id)
     1405           .
     1406       End.
     1407       if ii = 0 then DO :
     1408         Message
     1409         "Отметьте формы документа для печати!"
     1410         view-as alert-box INFORMATION title "Внимание !".
     1411         find first Tmp#List where l-recid = recid(Tmp#List) no-lock  .
     1412         return no-apply.
     1413       End.
     1414       find first buf_usr-flt exclusive-lock
     1415            where buf_usr-flt.user-name = v-cntxt-userid
     1416              and buf_usr-flt.call-point  = String( p-doc-tp) + ","
     1417                                     + String(  buf_inkas.status_ )
     1418    no-error .
     1419    if avail buf_usr-flt
     1420    then Assign
     1421    buf_usr-flt.list_       = list_
     1422    .
     1423       run get-quest-print  in parparentproc(output g#quest-print).
     1424       if g#quest-print = true or p-quest-print
     1425       then do:
     1426           run get-report-num in parparentproc ( output g#report-num).
     1427           output  to value( string( session:temp-directory + "$" + string( g#report-num ) ) ) .
     1428           output close.
     1429       End.
     1430       for each Tmp#List no-lock
     1431          where Tmp#List.last-use = true
     1432       :
     1433           case num-entries(tmp#list.proc-param)
     1434           :
     1435               when 0
     1436               then do:
     1437                   run value (tmp#list.proc-name)  (input parparentproc
     1438                                                   ,input buf_inkas.inkas-code
     1439                                                   ,output v-frame-width
     1440                                                   ).
     1441               end.
     1442               when 1
     1443               then do:
     1444                   run value (tmp#list.proc-name)  (     input parparentproc
     1445                                                       , input buf_inkas.inkas-code
     1446                                                       , input tmp#list.proc-param
     1447                                                       , output v-frame-width
     1448                                                   ).
     1449               end.
     1450               when 2
     1451               then do:
     1452                   run value (tmp#list.proc-name)  (     input parparentproc
     1453                                                       , input buf_inkas.inkas-code
     1454                                                       , input Entry(1,tmp#list.proc-param)
     1455                                                       , input Entry(2,tmp#list.proc-param)
     1456                                                       , output v-frame-width
     1457                                                   ).
     1458               end.
     1459               when 3
     1460               then do:
     1461                   run value (tmp#list.proc-name)  (     input parparentproc
     1462                                                       , input buf_inkas.inkas-code
     1463                                                       , input Entry(1,tmp#list.proc-param)
     1464                                                       , input Entry(2,tmp#list.proc-param)
     1465                                                       , input Entry(3,tmp#list.proc-param)
     1466                                                       , output v-frame-width
     1467                                                   ).
     1468               end.
     1469               when 4
     1470               then do:
     1471                   run value (tmp#list.proc-name)  (     input parparentproc
     1472                                                       , input buf_inkas.inkas-code
     1473                                                       , input Entry(1,tmp#list.proc-param)
     1474                                                       , input Entry(2,tmp#list.proc-param)
     1475                                                       , input Entry(3,tmp#list.proc-param)
     1476                                                       , input Entry(4,tmp#list.proc-param)
     1477                                                       , output v-frame-width
     1478                                                   ).
     1479               end.
     1480               when 5
     1481               then do:
     1482                   run value (tmp#list.proc-name)  (     input parparentproc
     1483                                                       , input buf_inkas.inkas-code
     1484                                                       , input Entry(1,tmp#list.proc-param)
     1485                                                       , input Entry(2,tmp#list.proc-param)
     1486                                                       , input Entry(3,tmp#list.proc-param)
     1487                                                       , input Entry(4,tmp#list.proc-param)
     1488                                                       , input Entry(5,tmp#list.proc-param)
     1489                                                       , output v-frame-width
     1490                                                   ).
     1491               end.
     1492               when 6
     1493               then do:
     1494                   run value (tmp#list.proc-name)  (     input parparentproc
     1495                                                       , input buf_inkas.inkas-code
     1496                                                       , input Entry(1,tmp#list.proc-param)
     1497                                                       , input Entry(2,tmp#list.proc-param)
     1498                                                       , input Entry(3,tmp#list.proc-param)
     1499                                                       , input Entry(4,tmp#list.proc-param)
     1500                                                       , input Entry(5,tmp#list.proc-param)
     1501                                                       , input Entry(6,tmp#list.proc-param)
     1502                                                       , output v-frame-width
     1503                                                   ).
     1504               end.
     1505           End case.
     1506       End.
     1507       run waitfram-hide in this-procedure .
     1508       if g#quest-print = true or p-quest-print
     1509       Then do:
     1510           os-delete
     1511               value( string( session:temp-directory ) + "rpt" + string( g#report-num ) )
     1512           .
     1513           os-rename
     1514               value(  string( session:temp-directory ) + "$" + string( g#report-num ) )
     1515               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) )
     1516           .
     1517           os-delete
     1518               value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1519           .
     1520           os-rename
     1521               value(  string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1522               value(  string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1523           .
     1524           find first tmp#list
     1525                 where Tmp#List.last-use = true
     1526           no-error .
     1527           case Tmp#list.orient
     1528           :
     1529               when 'A4port'
     1530               then do:
     1531                 run prn-lib-prn-file in this-procedure (
     1532                                                           input parParentProc
     1533                                                           ,input 0
     1534                                                           ).
     1535               end.
     1536               when 'A4lans'
     1537               or when ""
     1538               then do:
     1539                 run prn-lib-prn-file in this-procedure (
     1540                                                           input parParentProc
     1541                                                           ,input 8
     1542                                                           ).
     1543               end.
     1544               when 'output':U then do:
     1545                 if v-frame-width <= 198 then do:
     1546                   if v-frame-width < 136 then do:
     1547                     run prn-lib-prn-file in this-procedure (
     1548                                                               input parParentProc
     1549                                                               ,input 0
     1550                                                               ).
     1551                   end.
     1552                   if v-frame-width <= 198 and v-frame-width >= 136 then do:
     1553                     run prn-lib-prn-file in this-procedure (
     1554                                                               input parParentProc
     1555                                                               ,input 8
     1556                                                               ).
     1557                    end.
     1558                 end.
     1559                 else do:
     1560                   if v-frame-width <= 255 then
     1561                   run prn-lib-prn-file in this-procedure (
     1562                                                             input parParentProc
     1563                                                             ,input 1
     1564                                                             ).
     1565                   else
     1566                   run prn-lib-prn-file in this-procedure (
     1567                                                             input parParentProc
     1568                                                             ,input 20
     1569                                                             ).
     1570                 end.
     1571               end.
     1572           end case.
     1573       end.
     1574       else do:
     1575           Message 'Задание распечатано'.
     1576       end.
     1577   END.
     1578   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1579   on help of frame Dialog-Frame
     1580   do:
     1581     run gbl/app_help.p
     1582       (input this-procedure :file-name
     1583       ,input ''
     1584       ,input ?
     1585       ) no-error.
     1586     if error-status :error then do:
     1587       message
     1588         "Ошибка при вызове помощи"
     1589         error-status :get-message(1)
     1590         view-as alert-box .
     1591     end.
     1592   end.
     1593   run minbtn-set in this-procedure .
     1594   on choose of b-help in frame Dialog-Frame
     1595   do:
     1596     apply "help":u to frame Dialog-Frame .
     1597   end.
     1598   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1599   procedure minbtn-set :
     1600       do
     1601           on error undo, return error return-value
     1602           :
     1603           define variable ii              as integer       no-undo .
     1604           define variable fh              as widget-handle no-undo .
     1605           define variable hh              as widget-handle no-undo .
     1606           define variable v-h             as handle        extent 4 no-undo .
     1607           define variable v-name-button   as character     no-undo .
     1608           define variable v-help-old-x    as decimal       no-undo .
     1609           define variable v-help-old-y    as decimal       no-undo .
     1610           define variable v-help-old-size as decimal       no-undo .
     1611           define variable v-frame-width   as decimal       no-undo .
     1612           define variable jj              as integer       no-undo .
     1613           do
     1614               on error undo, return error
     1615               :
     1616               assign
     1617                   v-frame-width = frame Dialog-Frame:width - 0.3
     1618                   fh            = frame Dialog-Frame:first-child
     1619                   hh            = fh:first-child
     1620                   ii            = 1
     1621                   .
     1622               do while valid-handle(hh):
     1623                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1624                   do:
     1625                       case lc(hh:name) :
     1626                           when "b-help" then
     1627                               do:
     1628                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1629                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1630                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1631                                   hh:TOOLTIP = "Помощь" .
     1632                                   v-help-old-x = hh:column .
     1633                                   v-help-old-y = hh:row    .
     1634                                   v-help-old-size = hh:width .
     1635                                   hh:width-chars = 2.5 .
     1636                               end.
     1637                           when "b-print" then
     1638                               do:
     1639                                   hh:load-image("cmp/b-print.bmp":u) .
     1640                                   hh:TOOLTIP = "Печать" .
     1641                                   v-h[ii] = hh:handle .
     1642                                   ii = ii + 1 .
     1643                                   hh:width-chars = 3 .
     1644                               end.
     1645                           when "b-history" or
     1646                           when "b-hist" then
     1647                               do:
     1648                                   hh:load-image("cmp/b-hist.bmp":u) .
     1649                                   hh:TOOLTIP = "История" .
     1650                                   v-h[ii] = hh:handle .
     1651                                   ii = ii + 1 .
     1652                                   hh:width-chars = 3 .
     1653                               end.
     1654                           when "b-sch" then
     1655                               do:
     1656                                   hh:load-image("cmp/b-sch.bmp":u) .
     1657                                   hh:TOOLTIP = "Установка Фильтра" .
     1658                                   v-h[ii] = hh:handle .
     1659                                   ii = ii + 1 .
     1660                                   hh:width-chars = 3 .
     1661                               end.
     1662                           when "b-hist-user" then
     1663                               do:
     1664                                   hh:load-image("cmp/b-hist.bmp":u) .
     1665                                   hh:TOOLTIP = "История пользователя" .
     1666                                   ii = ii + 1 .
     1667                               end.
     1668                       end case.
     1669                   end.
     1670                   hh = hh:next-sibling.
     1671               end.
     1672               b-help:column = v-frame-width - b-help:width-chars.
     1673               jj = 0.
     1674               repeat ii = 4 to 1 by -1 :
     1675                   if valid-handle (v-h[ii] ) then
     1676                   do:
     1677                       jj  = jj + 1 .
     1678                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1679                       v-h[ii]:row    = v-help-old-y .
     1680                   end.
     1681               end.
     1682           end.
     1683       end.
     1684   end procedure.
     1685   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1686   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1687   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1688   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1689   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1690   define variable v-diasize-current-frame-height as decimal   no-undo .
     1691   define variable v-diasize-change-size          as logical   no-undo .
     1692   define variable v-diasize-resize-button        as handle    no-undo .
     1693   define variable v-diasize-wndmax               as logical   no-undo .
     1694   define variable v-diasize-wndstore             as logical   no-undo .
     1695   define variable v-diasize-proc-name            as character no-undo .
     1696   define variable v-diasize-browse-handle        as handle    no-undo .
     1697   define variable v-diasize-browse-number        as integer   no-undo .
     1698   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1699   define temp-table temp-diasize-handle no-undo
     1700     field handle-value  as handle
     1701     field save-position as decimal
     1702     index xpk is primary unique handle-value
     1703     .
     1704   define temp-table temp-browse-handle no-undo
     1705     field browse-type   as character
     1706     field browse-number as integer
     1707     field browse-handle as handle
     1708     field original-size as decimal
     1709     index xpk is primary unique browse-type browse-number
     1710     index xie browse-type browse-handle
     1711   .
     1712   procedure diasize_change-height :
     1713     define input  parameter p-change-value  as decimal   no-undo .
     1714     define input  parameter p-move-resize   as logical   no-undo .
     1715     define variable v-field-group-handle    as handle    no-undo .
     1716     define variable v-object-handle         as handle    no-undo .
     1717     define variable v-frame-height          as decimal   no-undo .
     1718     define variable v-frame-virtual-height  as decimal   no-undo .
     1719     define variable v-browse-height         as decimal   no-undo .
     1720     define variable v-window-height         as decimal   no-undo .
     1721     define variable v-window-virtual-height as decimal   no-undo .
     1722     define variable v-change-sign           as integer   no-undo .
     1723     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1724     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1725     if p-change-value > 0
     1726     then do:
     1727       if frame Dialog-Frame :height + p-change-value
     1728           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1729       then do:
     1730         assign
     1731           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1732                           - (frame Dialog-Frame :height-chars)
     1733         .
     1734         if p-change-value <= 0
     1735         then do:
     1736           run diasize_position-resize-button in this-procedure .
     1737           return .
     1738         end.
     1739       end.
     1740     end.
     1741     if p-change-value < 0
     1742     then do:
     1743       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1744       then do:
     1745         assign
     1746           p-change-value = v-diasize-orig-frame-height
     1747                          - (frame Dialog-Frame :height-chars)
     1748         .
     1749         if p-change-value >= 0
     1750         then do:
     1751           run diasize_position-resize-button in this-procedure .
     1752           return .
     1753         end.
     1754       end.
     1755     end.
     1756     if p-change-value >= 0
     1757     then do:
     1758       assign
     1759         v-change-sign = 1
     1760       .
     1761     end.
     1762     else do:
     1763       assign
     1764         v-change-sign = -1
     1765       .
     1766     end.
     1767     assign
     1768       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1769     .
     1770     if p-change-value = 0
     1771     then do:
     1772       run diasize_position-resize-button in this-procedure .
     1773       return .
     1774     end.
     1775     move_block:
     1776     do
     1777     on error undo move_block, retry move_block
     1778     :
     1779       if retry
     1780       then do:
     1781         do
     1782         on error undo move_block, leave move_block
     1783         :
     1784           if p-change-value > 0
     1785           then do:
     1786             for each buf_temp-diasize-handle
     1787             on error undo, next
     1788             :
     1789               assign
     1790                 v-object-handle = buf_temp-diasize-handle.handle-value
     1791               .
     1792               if v-object-handle <> v-diasize-resize-button
     1793               then do:
     1794                 assign
     1795                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1796                 .
     1797               end.
     1798             end.
     1799             assign
     1800               v-diasize-browse-handle :height = v-browse-height
     1801             .
     1802             for each buf_temp-browse-handle
     1803               where buf_temp-browse-handle.browse-type = 'height':u
     1804             on error undo, next
     1805             :
     1806               assign
     1807                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1808               .
     1809             end.
     1810             assign
     1811               frame Dialog-Frame :height = v-frame-height
     1812             .
     1813             if frame Dialog-Frame :scrollable = true
     1814             then do:
     1815               assign
     1816                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1817               .
     1818             end.
     1819             run diasize_position-resize-button in this-procedure .
     1820           end.
     1821           else do:
     1822             if frame Dialog-Frame :scrollable = true
     1823             then do:
     1824               assign
     1825                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1826               .
     1827             end.
     1828             assign
     1829               frame Dialog-Frame :height = v-frame-height
     1830             .
     1831             assign
     1832               v-diasize-browse-handle :height = v-browse-height
     1833             .
     1834             for each buf_temp-browse-handle
     1835               where buf_temp-browse-handle.browse-type = 'height':u
     1836             on error undo, next
     1837             :
     1838               assign
     1839                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1840               .
     1841             end.
     1842             for each buf_temp-diasize-handle
     1843             on error undo, next
     1844             :
     1845               assign
     1846                 v-object-handle = buf_temp-diasize-handle.handle-value
     1847               .
     1848               if v-object-handle <> v-diasize-resize-button
     1849               then do:
     1850                 assign
     1851                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1852                 .
     1853               end.
     1854             end.
     1855             run diasize_position-resize-button in this-procedure .
     1856           end.
     1857           assign
     1858             v-diasize-change-size = false
     1859           .
     1860           leave move_block .
     1861         end.
     1862       end.
     1863       assign
     1864         v-diasize-need-full-display = true
     1865       .
     1866       if v-diasize-change-size = false
     1867       then do:
     1868         assign
     1869           v-diasize-change-size = true
     1870         .
     1871       end.
     1872       else do:
     1873         return .
     1874       end.
     1875       assign
     1876         v-frame-height = frame Dialog-Frame :height
     1877         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1878         v-browse-height = v-diasize-browse-handle :height
     1879       .
     1880       for each buf_temp-browse-handle
     1881         where buf_temp-browse-handle.browse-type = 'height':u
     1882       :
     1883         assign
     1884           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1885         .
     1886       end.
     1887       for each buf_temp-diasize-handle
     1888       :
     1889         delete buf_temp-diasize-handle .
     1890       end.
     1891       assign
     1892         v-field-group-handle = frame Dialog-Frame :first-child
     1893       .
     1894       do while valid-handle(v-field-group-handle)
     1895       :
     1896         assign
     1897           v-object-handle = v-field-group-handle :first-child
     1898         .
     1899         do while valid-handle(v-object-handle)
     1900         :
     1901           if  v-object-handle <> v-diasize-browse-handle :handle
     1902           and can-query(v-object-handle, "row")
     1903           and can-query(v-object-handle, "height")
     1904           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1905           then do:
     1906             find first buf_temp-browse-handle
     1907               where buf_temp-browse-handle.browse-type   = 'height':u
     1908                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1909               no-error .
     1910             if available buf_temp-browse-handle
     1911             then do:
     1912             end.
     1913             else do:
     1914               create buf_temp-diasize-handle .
     1915               assign
     1916                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1917                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1918               .
     1919             end.
     1920           end.
     1921           assign
     1922             v-object-handle = v-object-handle :next-sibling
     1923           .
     1924         end.
     1925         assign
     1926           v-field-group-handle = v-field-group-handle :next-sibling
     1927         .
     1928       end.
     1929       do with frame Dialog-Frame
     1930       :
     1931         hide v-diasize-resize-button .
     1932         assign
     1933           v-diasize-resize-button :row    = 1
     1934           v-diasize-resize-button :column = 1
     1935         .
     1936       end.
     1937       if p-change-value > 0
     1938       then do:
     1939         if frame Dialog-Frame :scrollable = true
     1940         then do:
     1941           assign
     1942             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1943             no-error .
     1944           if error-status :error
     1945           or error-status :get-message(1) <> ""
     1946           then do:
     1947             undo move_block, retry move_block .
     1948           end.
     1949         end.
     1950         assign
     1951           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1952           no-error .
     1953         if error-status :error
     1954         or error-status :get-message(1) <> ""
     1955         then do:
     1956           undo move_block, retry move_block .
     1957         end.
     1958         assign
     1959           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1960           no-error .
     1961         if error-status :error
     1962         or error-status :get-message(1) <> ""
     1963         then do:
     1964           undo move_block, retry move_block .
     1965         end.
     1966         for each buf_temp-browse-handle
     1967           where buf_temp-browse-handle.browse-type = 'height':u
     1968         on error undo move_block, retry move_block
     1969         :
     1970           assign
     1971             buf_temp-browse-handle.browse-handle :height
     1972               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1973             no-error .
     1974           if error-status :error
     1975           or error-status :get-message(1) <> ""
     1976           then do:
     1977             undo move_block, retry move_block .
     1978           end.
     1979         end.
     1980         for each buf_temp-diasize-handle
     1981         on error undo move_block, retry move_block
     1982         :
     1983           assign
     1984             v-object-handle = buf_temp-diasize-handle.handle-value
     1985           .
     1986           if v-object-handle <> v-diasize-resize-button
     1987           then do:
     1988             assign
     1989               v-object-handle :row = v-object-handle :row + p-change-value
     1990               no-error .
     1991             if error-status :error
     1992             or error-status :get-message(1) <> ""
     1993             then do:
     1994               undo move_block, retry move_block .
     1995             end.
     1996           end.
     1997         end.
     1998       end.
     1999       else do:
     2000         for each buf_temp-diasize-handle
     2001         on error undo move_block, retry move_block
     2002         :
     2003           assign
     2004             v-object-handle = buf_temp-diasize-handle.handle-value
     2005           .
     2006           if v-object-handle <> v-diasize-resize-button
     2007           then do:
     2008             assign
     2009               v-object-handle :row = v-object-handle :row + p-change-value
     2010               no-error .
     2011             if error-status :error
     2012             or error-status :get-message(1) <> ""
     2013             then do:
     2014               undo move_block, retry move_block .
     2015             end.
     2016           end.
     2017         end.
     2018         assign
     2019           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2020           no-error .
     2021         if error-status :error
     2022         or error-status :get-message(1) <> ""
     2023         then do:
     2024           undo move_block, retry move_block .
     2025         end.
     2026         for each buf_temp-browse-handle
     2027           where buf_temp-browse-handle.browse-type = 'height':u
     2028         on error undo move_block, retry move_block
     2029         :
     2030           assign
     2031             buf_temp-browse-handle.browse-handle :height
     2032               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2033             no-error .
     2034           if error-status :error
     2035           or error-status :get-message(1) <> ""
     2036           then do:
     2037             undo move_block, retry move_block .
     2038           end.
     2039         end.
     2040         assign
     2041           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2042           no-error .
     2043         if error-status :error
     2044         or error-status :get-message(1) <> ""
     2045         then do:
     2046           undo move_block, retry move_block .
     2047         end.
     2048         if frame Dialog-Frame :scrollable = true
     2049         then do:
     2050           assign
     2051             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2052             no-error .
     2053           if error-status :error
     2054           or error-status :get-message(1) <> ""
     2055           then do:
     2056             undo move_block, retry move_block .
     2057           end.
     2058         end.
     2059       end.
     2060       if p-move-resize = true
     2061       then do:
     2062         run diasize_position-resize-button in this-procedure .
     2063       end.
     2064       if v-diasize-wndstore = true
     2065       then do:
     2066         if connected("ub") = true
     2067         then do:
     2068           define variable v-cntxt-db-num        as integer   no-undo .
     2069           define variable v-cntxt-userid        as character no-undo .
     2070           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2071                                             , OUTPUT v-cntxt-userid
     2072                                             ) .
     2073           run gbl/wndsizew.p
     2074             (input  v-cntxt-db-num
     2075             ,input  v-cntxt-userid
     2076             ,input  v-diasize-proc-name
     2077             ,input  'height':u
     2078             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2079             ) .
     2080         end.
     2081       end.
     2082     end.
     2083     assign
     2084       v-diasize-change-size = false
     2085     .
     2086   end procedure.
     2087   procedure diasize_set-height :
     2088     define input  parameter p-new-height  as decimal   no-undo .
     2089     define input  parameter p-move-resize as logical   no-undo .
     2090     do
     2091     on error undo, return error return-value
     2092     :
     2093       run diasize_change-height in this-procedure
     2094         (input  (p-new-height - frame Dialog-Frame :height)
     2095         ,input  p-move-resize
     2096         ) .
     2097     end.
     2098   end procedure.
     2099   procedure diasize_change-width :
     2100     define input  parameter p-change-value as decimal   no-undo .
     2101     define input  parameter p-move-resize  as logical   no-undo .
     2102     define variable v-field-group-handle   as handle    no-undo .
     2103     define variable v-object-handle        as handle    no-undo .
     2104     define variable v-frame-width          as decimal   no-undo .
     2105     define variable v-frame-virtual-width  as decimal   no-undo .
     2106     define variable v-browse-width         as decimal   no-undo .
     2107     define variable v-window-width         as decimal   no-undo .
     2108     define variable v-window-virtual-width as decimal   no-undo .
     2109     define variable v-change-sign          as integer   no-undo .
     2110     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2111     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2112     if p-change-value > 0
     2113     then do:
     2114       if frame Dialog-Frame :width + p-change-value >
     2115           session :width-chars
     2116       then do:
     2117         assign
     2118           p-change-value = session :width-chars - frame Dialog-Frame :width
     2119         .
     2120         if p-change-value <= 0
     2121         then do:
     2122           run diasize_position-resize-button in this-procedure .
     2123           return .
     2124         end.
     2125       end.
     2126     end.
     2127     if p-change-value < 0
     2128     then do:
     2129       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2130       then do:
     2131         assign
     2132           p-change-value = v-diasize-orig-frame-width
     2133                          - frame Dialog-Frame :width
     2134         .
     2135         if p-change-value >= 0
     2136         then do:
     2137           run diasize_position-resize-button in this-procedure .
     2138           return .
     2139         end.
     2140       end.
     2141     end.
     2142     if p-change-value >= 0
     2143     then do:
     2144       assign
     2145         v-change-sign = 1
     2146       .
     2147     end.
     2148     else do:
     2149       assign
     2150         v-change-sign = -1
     2151       .
     2152     end.
     2153     assign
     2154       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2155     .
     2156     if p-change-value = 0
     2157     then do:
     2158       run diasize_position-resize-button in this-procedure .
     2159       return .
     2160     end.
     2161     move_block:
     2162     do
     2163     on error undo move_block, leave move_block
     2164     :
     2165       if retry
     2166       then do:
     2167         do
     2168         on error undo move_block, leave move_block
     2169         :
     2170           if p-change-value > 0
     2171           then do:
     2172             for each buf_temp-diasize-handle
     2173             on error undo, next
     2174             :
     2175               assign
     2176                 v-object-handle = buf_temp-diasize-handle.handle-value
     2177               .
     2178               if v-object-handle <> v-diasize-resize-button
     2179               then do:
     2180                 assign
     2181                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2182                 .
     2183               end.
     2184             end.
     2185             assign
     2186               v-diasize-browse-handle :width = v-browse-width
     2187             .
     2188             for each buf_temp-browse-handle
     2189               where buf_temp-browse-handle.browse-type = 'width':u
     2190             on error undo, next
     2191             :
     2192               assign
     2193                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2194               .
     2195             end.
     2196             assign
     2197               frame Dialog-Frame :width = v-frame-width
     2198             .
     2199             if frame Dialog-Frame :scrollable = true
     2200             then do:
     2201               assign
     2202                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2203               .
     2204             end.
     2205             run diasize_position-resize-button in this-procedure .
     2206           end.
     2207           else do:
     2208             if frame Dialog-Frame :scrollable = true
     2209             then do:
     2210               assign
     2211                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2212               .
     2213             end.
     2214             assign
     2215               frame Dialog-Frame :width = v-frame-width
     2216             .
     2217             for each buf_temp-browse-handle
     2218               where buf_temp-browse-handle.browse-type = 'width':u
     2219             on error undo, next
     2220             :
     2221               assign
     2222                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2223               .
     2224             end.
     2225             assign
     2226               v-diasize-browse-handle :width = v-browse-width
     2227             .
     2228             for each buf_temp-diasize-handle
     2229             on error undo, next
     2230             :
     2231               assign
     2232                 v-object-handle = buf_temp-diasize-handle.handle-value
     2233               .
     2234               if v-object-handle <> v-diasize-resize-button
     2235               then do:
     2236                 assign
     2237                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2238                 .
     2239               end.
     2240             end.
     2241             run diasize_position-resize-button in this-procedure .
     2242           end.
     2243           assign
     2244             v-diasize-change-size = false
     2245           .
     2246           leave move_block .
     2247         end.
     2248       end.
     2249       assign
     2250         v-diasize-need-full-display = true
     2251       .
     2252       if v-diasize-change-size = false
     2253       then do:
     2254         assign
     2255           v-diasize-change-size = true
     2256         .
     2257       end.
     2258       else do:
     2259         return .
     2260       end.
     2261       assign
     2262         v-frame-width = frame Dialog-Frame :width
     2263         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2264         v-browse-width = v-diasize-browse-handle :width
     2265       .
     2266       for each buf_temp-browse-handle
     2267         where buf_temp-browse-handle.browse-type = 'width':u
     2268       :
     2269         assign
     2270           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2271         .
     2272       end.
     2273       for each buf_temp-diasize-handle
     2274       :
     2275         delete buf_temp-diasize-handle .
     2276       end.
     2277       assign
     2278         v-field-group-handle = frame Dialog-Frame :first-child
     2279       .
     2280       do while valid-handle(v-field-group-handle)
     2281       :
     2282         assign
     2283           v-object-handle = v-field-group-handle :first-child
     2284         .
     2285         do while valid-handle(v-object-handle)
     2286         :
     2287           if  v-object-handle <> v-diasize-browse-handle :handle
     2288           and v-object-handle <> v-diasize-resize-button
     2289           and can-query(v-object-handle, "row")
     2290           and can-query(v-object-handle, "height")
     2291           and ( v-object-handle :col + v-object-handle :width
     2292                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2293               )
     2294           then do:
     2295             find first buf_temp-browse-handle
     2296               where buf_temp-browse-handle.browse-type   = 'width':u
     2297                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2298               no-error .
     2299             if available buf_temp-browse-handle
     2300             then do:
     2301             end.
     2302             else do:
     2303               create buf_temp-diasize-handle .
     2304               assign
     2305                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2306                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2307               .
     2308             end.
     2309           end.
     2310           assign
     2311             v-object-handle = v-object-handle :next-sibling
     2312           .
     2313         end.
     2314         assign
     2315           v-field-group-handle = v-field-group-handle :next-sibling
     2316         .
     2317       end.
     2318       do with frame Dialog-Frame
     2319       :
     2320         hide v-diasize-resize-button .
     2321         v-diasize-resize-button :row = 1.
     2322         v-diasize-resize-button :column = 1.
     2323       end.
     2324       if p-change-value > 0
     2325       then do:
     2326         if frame Dialog-Frame :scrollable = true
     2327         then do:
     2328           assign
     2329             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2330             no-error .
     2331           if error-status :error
     2332           or error-status :get-message(1) <> ""
     2333           then do:
     2334             undo move_block, retry move_block.
     2335           end.
     2336         end.
     2337         assign
     2338           frame Dialog-Frame :width = v-frame-width + p-change-value
     2339           no-error .
     2340         if error-status :error
     2341         or error-status :get-message(1) <> ""
     2342         then do:
     2343           undo move_block, retry move_block.
     2344         end.
     2345         assign
     2346           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2347         no-error .
     2348         if error-status :error
     2349         or error-status :get-message(1) <> ""
     2350         then do:
     2351           undo move_block, retry move_block.
     2352         end.
     2353         for each buf_temp-browse-handle
     2354           where buf_temp-browse-handle.browse-type = 'width':u
     2355         on error undo move_block, retry move_block
     2356         :
     2357           assign
     2358             buf_temp-browse-handle.browse-handle :width
     2359               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2360             no-error .
     2361           if error-status :error
     2362           or error-status :get-message(1) <> ""
     2363           then do:
     2364             undo move_block, retry move_block .
     2365           end.
     2366         end.
     2367         for each buf_temp-diasize-handle
     2368         on error undo move_block, retry move_block
     2369         :
     2370           assign
     2371             v-object-handle = buf_temp-diasize-handle.handle-value
     2372           .
     2373           if v-object-handle <> v-diasize-resize-button
     2374           then do:
     2375             assign
     2376               v-object-handle :col = v-object-handle :col + p-change-value
     2377               no-error .
     2378             if error-status :error
     2379             or error-status :get-message(1) <> ""
     2380             then do:
     2381               undo move_block, retry move_block .
     2382             end.
     2383           end.
     2384         end.
     2385       end.
     2386       else do:
     2387         for each buf_temp-diasize-handle
     2388         on error undo move_block, retry move_block
     2389         :
     2390           assign
     2391             v-object-handle = buf_temp-diasize-handle.handle-value
     2392           .
     2393           if v-object-handle <> v-diasize-resize-button
     2394           then do:
     2395             assign
     2396               v-object-handle :col = v-object-handle :col + p-change-value
     2397               no-error .
     2398             if error-status :error
     2399             or error-status :get-message(1) <> ""
     2400             then do:
     2401               undo move_block, retry move_block .
     2402             end.
     2403           end.
     2404         end.
     2405         for each buf_temp-browse-handle
     2406           where buf_temp-browse-handle.browse-type = 'width':u
     2407         on error undo move_block, retry move_block
     2408         :
     2409           assign
     2410             buf_temp-browse-handle.browse-handle :width
     2411               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2412             no-error .
     2413           if error-status :error
     2414           or error-status :get-message(1) <> ""
     2415           then do:
     2416             undo move_block, retry move_block .
     2417           end.
     2418         end.
     2419         assign
     2420           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2421           no-error .
     2422         if error-status :error
     2423         or error-status :get-message(1) <> ""
     2424         then do:
     2425           undo move_block, retry move_block.
     2426         end.
     2427         assign
     2428           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2429         no-error .
     2430         if error-status :error
     2431         or error-status :get-message(1) <> ""
     2432         then do:
     2433           undo move_block, retry move_block.
     2434         end.
     2435         if frame Dialog-Frame :scrollable = true
     2436         then do:
     2437           assign
     2438             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2439           no-error .
     2440           if error-status :error
     2441           or error-status :get-message(1) <> ""
     2442           then do:
     2443             undo move_block, retry move_block.
     2444           end.
     2445         end.
     2446       end.
     2447       if p-move-resize
     2448       then do:
     2449         run diasize_position-resize-button in this-procedure .
     2450       end.
     2451       if v-diasize-wndstore = true
     2452       then do:
     2453         if connected("ub") = true
     2454         then do:
     2455           define variable v-cntxt-db-num        as integer   no-undo .
     2456           define variable v-cntxt-userid        as character no-undo .
     2457           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2458                                             , OUTPUT v-cntxt-userid
     2459                                             ) .
     2460           run gbl/wndsizew.p
     2461             (input  v-cntxt-db-num
     2462             ,input  v-cntxt-userid
     2463             ,input  v-diasize-proc-name
     2464             ,input  'width':u
     2465             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2466             ) .
     2467         end.
     2468       end.
     2469     end.
     2470     assign
     2471       v-diasize-change-size = false
     2472     .
     2473   end procedure.
     2474   procedure diasize_set-width :
     2475     define input  parameter p-new-width  as decimal   no-undo .
     2476     define input  parameter p-move-resize as logical   no-undo .
     2477     do
     2478     on error undo, return error return-value
     2479     :
     2480       run diasize_change-width in this-procedure
     2481         (input  (p-new-width - frame Dialog-Frame :width)
     2482         ,input  p-move-resize
     2483         ) .
     2484     end.
     2485   end procedure.
     2486   procedure diasize_position-resize-button :
     2487     do with frame Dialog-Frame
     2488     :
     2489       hide v-diasize-resize-button .
     2490       assign
     2491         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2492                     - 1
     2493                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2494         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2495                     - 1
     2496                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2497       .
     2498       view v-diasize-resize-button .
     2499     end.
     2500   end procedure.
     2501   on alt-right anywhere
     2502   do:
     2503     run diasize_change-width in this-procedure
     2504       (input 1
     2505       ,input true
     2506       ) .
     2507     return no-apply .
     2508   end.
     2509   on alt-left anywhere
     2510   do:
     2511     run diasize_change-width in this-procedure
     2512       (input -1
     2513       ,input true
     2514       ) .
     2515     return no-apply .
     2516   end.
     2517   on alt-down anywhere
     2518   do:
     2519     run diasize_change-height in this-procedure
     2520       (input 1
     2521       ,input true
     2522       ) .
     2523     return no-apply .
     2524   end.
     2525   on alt-up anywhere
     2526   do:
     2527     run diasize_change-height in this-procedure
     2528       (input -1
     2529       ,input true
     2530       ) .
     2531     return no-apply .
     2532   end.
     2533   on alt-enter of frame Dialog-Frame
     2534   do:
     2535     run diasize_maximize in this-procedure
     2536       (input  ?
     2537       ).
     2538     return no-apply .
     2539   end.
     2540   procedure diasize_end-move :
     2541     do
     2542     on error undo, return error return-value
     2543     :
     2544       define variable v-row-delta as decimal   no-undo .
     2545       define variable v-col-delta as decimal   no-undo .
     2546       define variable v-new-row as decimal   no-undo .
     2547       define variable v-new-col as decimal   no-undo .
     2548       assign
     2549         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2550         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2551       .
     2552       assign
     2553         v-row-delta = v-new-row - frame Dialog-Frame :height
     2554         v-col-delta = v-new-col - frame Dialog-Frame :width
     2555       .
     2556       run diasize_change-height in this-procedure
     2557         (input v-row-delta
     2558         ,input true
     2559         ) .
     2560       run diasize_change-width in this-procedure
     2561         (input v-col-delta
     2562         ,input true
     2563         ) .
     2564     end.
     2565   end procedure.
     2566   procedure diasize_maximize :
     2567     define input  parameter p-action as logical   no-undo .
     2568     do
     2569     on error undo, return error return-value
     2570     :
     2571       if p-action = ?
     2572       then do:
     2573         if v-diasize-need-maximize = true
     2574         then do:
     2575           assign
     2576             p-action = true
     2577           .
     2578         end.
     2579         else do:
     2580           assign
     2581             p-action = false
     2582           .
     2583         end.
     2584       end.
     2585       if p-action = true
     2586       then do:
     2587         run diasize_change-height in this-procedure
     2588           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2589               - frame Dialog-Frame :height-chars
     2590           ,input true
     2591           ) .
     2592         run diasize_change-width in this-procedure
     2593           (input session :width-chars
     2594               - frame Dialog-Frame :width-chars
     2595           ,input true
     2596           ) .
     2597         assign
     2598           v-diasize-need-maximize = false
     2599         .
     2600       end.
     2601       else do:
     2602         run diasize_change-width in this-procedure
     2603           (input v-diasize-orig-frame-width
     2604               - frame Dialog-Frame :width-chars
     2605           ,input true
     2606           ) .
     2607         run diasize_change-height in this-procedure
     2608           (input v-diasize-orig-frame-height
     2609               - frame Dialog-Frame :height-chars
     2610           ,input true
     2611           ) .
     2612         assign
     2613           v-diasize-need-maximize = true
     2614         .
     2615       end.
     2616     end.
     2617   end procedure.
     2618   procedure diasize_restore-orig-size :
     2619     do
     2620     on error undo, return error return-value
     2621     :
     2622       assign
     2623         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2624         v-diasize-current-frame-height = frame Dialog-Frame :height
     2625       .
     2626       run diasize_set-height in this-procedure
     2627         (input  v-diasize-orig-frame-height
     2628         ,input  true
     2629         ) .
     2630       run diasize_set-width in this-procedure
     2631         (input  v-diasize-orig-frame-width
     2632         ,input  true
     2633         ) .
     2634     end.
     2635   end procedure.
     2636   procedure diasize_restore-current-size :
     2637     do
     2638     on error undo, return error return-value
     2639     :
     2640       run diasize_set-height in this-procedure
     2641         (input  v-diasize-current-frame-height
     2642         ,input  true
     2643         ) .
     2644       run diasize_set-width in this-procedure
     2645         (input  v-diasize-current-frame-width
     2646         ,input  true
     2647         ) .
     2648     end.
     2649   end procedure.
     2650   procedure diasize_set-browse-handle :
     2651     define input  parameter p-browse-handle as handle   no-undo .
     2652     define buffer buf_temp-browse-handle for temp-browse-handle .
     2653     do
     2654     on error undo, return error return-value
     2655     :
     2656       assign
     2657         v-diasize-browse-handle = p-browse-handle
     2658       .
     2659       for each buf_temp-browse-handle
     2660       on error undo, return error return-value
     2661       :
     2662         delete buf_temp-browse-handle .
     2663       end.
     2664     end.
     2665   end procedure.
     2666   procedure diasize_add_browse :
     2667     define input  parameter p-browse-type   as character no-undo .
     2668     define input  parameter p-browse-handle as handle    no-undo .
     2669     define buffer buf_temp-browse-handle for temp-browse-handle .
     2670     do
     2671     on error undo, return error return-value
     2672     :
     2673       assign
     2674         v-diasize-browse-number = v-diasize-browse-number + 1
     2675       .
     2676       create buf_temp-browse-handle .
     2677       assign
     2678         buf_temp-browse-handle.browse-type   = p-browse-type
     2679         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2680         buf_temp-browse-handle.browse-handle = p-browse-handle
     2681       .
     2682     end.
     2683   end procedure.
     2684   procedure diasize_init :
     2685     define variable v-default-value    as logical   no-undo .
     2686     define variable v-restore-saved    as logical   no-undo .
     2687     define variable v-resize-value-str as character no-undo .
     2688     do
     2689     on error undo, return error return-value
     2690     :
     2691       do with frame Dialog-Frame
     2692       :
     2693         assign
     2694           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2695           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2696           v-diasize-browse-handle     = browse BROWSE-2 :handle
     2697         .
     2698         create button v-diasize-resize-button
     2699         assign
     2700           parent        = frame Dialog-Frame :first-child
     2701           label         = "s"
     2702           height-pixels = 16
     2703           width-pixels  = 16
     2704           visible       = true
     2705           sensitive     = true
     2706           movable       = true
     2707           triggers:
     2708             on end-move persistent run diasize_end-move in this-procedure .
     2709           end triggers.
     2710         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2711         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2712         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2713         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2714         assign
     2715           v-diasize-wndmax = false
     2716         .
     2717         if connected("ub") = true
     2718         then do:
     2719           define variable v-cntxt-db-num        as integer   no-undo .
     2720           define variable v-cntxt-userid        as character no-undo .
     2721           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2722                                             , OUTPUT v-cntxt-userid
     2723                                             ) .
     2724           run gbl/wndpar_r.p
     2725             (input  v-cntxt-db-num
     2726             ,input  v-cntxt-userid
     2727             ,input  'wndmax':U
     2728             ,output v-diasize-wndmax
     2729             ,output v-default-value
     2730             ) .
     2731         end.
     2732         assign
     2733           v-diasize-wndstore = false
     2734         .
     2735         if connected("ub") = true
     2736         then do:
     2737           run gbl/wndpar_r.p
     2738             (input  v-cntxt-db-num
     2739             ,input  v-cntxt-userid
     2740             ,input  'wndstore':U
     2741             ,output v-diasize-wndstore
     2742             ,output v-default-value
     2743             ) .
     2744         end.
     2745         assign
     2746           v-diasize-proc-name = entry(1, program-name(2), '.')
     2747         .
     2748         if v-diasize-wndstore = true
     2749         then do:
     2750           assign
     2751             v-restore-saved = false
     2752           .
     2753           if connected("ub") = true
     2754           then do:
     2755             run gbl/wndsizer.p
     2756               (input  v-cntxt-db-num
     2757               ,input  v-cntxt-userid
     2758               ,input  v-diasize-proc-name
     2759               ,input  'height':u
     2760               ,output v-resize-value-str
     2761               ) .
     2762             if v-resize-value-str <> '':U
     2763             then do:
     2764               run diasize_change-height in this-procedure
     2765                 (input  integer(v-resize-value-str)
     2766                 ,input  true
     2767                 ) .
     2768               assign
     2769                 v-restore-saved = true
     2770               .
     2771             end.
     2772           end.
     2773           if connected("ub") = true
     2774           then do:
     2775             run gbl/wndsizer.p
     2776               (input  v-cntxt-db-num
     2777               ,input  v-cntxt-userid
     2778               ,input  v-diasize-proc-name
     2779               ,input  'width':u
     2780               ,output v-resize-value-str
     2781               ) .
     2782             if v-resize-value-str <> '':U
     2783             then do:
     2784               run diasize_change-width in this-procedure
     2785                 (input  integer(v-resize-value-str)
     2786                 ,input  true
     2787                 ) .
     2788               assign
     2789                 v-restore-saved = true
     2790               .
     2791             end.
     2792           end.
     2793           if v-restore-saved <> true
     2794           then do:
     2795             if v-diasize-wndmax = true
     2796             then do:
     2797               run diasize_maximize in this-procedure
     2798                 (input  true
     2799                 ) .
     2800             end.
     2801           end.
     2802         end.
     2803         else do:
     2804           if v-diasize-wndmax = true
     2805           then do:
     2806             run diasize_maximize in this-procedure
     2807               (input  true
     2808               ) .
     2809           end.
     2810         end.
     2811       end.
     2812     end.
     2813   end procedure.
     2814   procedure diasize_need-full-display :
     2815     define output parameter p-need-full-display as logical   no-undo .
     2816     do
     2817     on error undo, return error return-value
     2818     :
     2819       assign
     2820         p-need-full-display = v-diasize-need-full-display
     2821       .
     2822       assign
     2823         v-diasize-need-full-display = false
     2824       .
     2825     end.
     2826   end procedure.
     2827   procedure get-context :
     2828      define output parameter p-db-num as integer          no-undo.
     2829      define output parameter p-user-id as character        no-undo.
     2830      define variable v-login               as character    no-undo.
     2831      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2832      define buffer buf_user-login  for ub.user-login .
     2833      do
     2834      on error undo, return error
     2835      :
     2836            FIND FIRST buf_sys-ctrl no-lock.
     2837            ASSIGN
     2838               v-login = USERID("ub")
     2839               p-db-num = buf_sys-ctrl.db-num
     2840            .
     2841            FIND FIRST buf_user-login
     2842                 WHERE buf_user-login.db-num = p-db-num
     2843                   AND buf_user-login.user-login = v-login
     2844                 no-lock
     2845                 no-error
     2846                 .
     2847            IF AVAILABLE buf_user-login
     2848            THEN DO:
     2849               assign
     2850                  p-user-id = buf_user-login.user-id
     2851               .
     2852            END.
     2853      end.
     2854   end procedure.
     2855       run diasize_init in this-procedure .
     2856   find first buf_inkas where recid(buf_inkas) = rec_id no-lock.
     2857   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2858   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2859     v-printer-name = session:printer-name.
     2860   Assign
     2861   p-doc-tp = "inkas":U .
     2862   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2863     run mainmenu_getcntxt in parparentproc
     2864       (output v-cntxt-db-num
     2865       ,output v-cntxt-userid
     2866       ,output v-cntxt-level
     2867       ,output v-cntxt-host-code-obj
     2868       ,output v-cntxt-obj-type
     2869       ,output v-cntxt-obj-code
     2870       ,output v-cntxt-db-num-obj
     2871       ,output v-cntxt-is-admin
     2872       ) .
     2873   run load-menu in this-procedure (
     2874       input buf_inkas.inkas-code
     2875     , input p-doc-tp
     2876     , input buf_inkas.status_).
     2877   MAIN-BLOCK:
     2878   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2879      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2880     RUN enable_UI.
     2881     Tmp#List.last-use      :read-only in browse BROWSE-2 =  true .
     2882     Tmp#List.blank-name:width in browse browse-2 = 59.
     2883     Tmp#List.blank-name:resizable in browse browse-2 = yes.
     2884       ASSIGN frame Dialog-Frame:TITLE =  "Работа с отчетом о продаже (печать и не только)"
     2885       + " Статус: " + buf_inkas.status_
     2886       + "  № "  + buf_inkas.inkas-code.
     2887       if sys-key = 'ExpertekIBS':U
     2888       then do:
     2889           run init-syskey-names in this-procedure.
     2890       end.
     2891     WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-2.
     2892   END.
     2893   RUN disable_UI.
     2894   PROCEDURE disable_UI :
     2895     HIDE FRAME Dialog-Frame.
     2896   END PROCEDURE.
     2897   PROCEDURE enable_UI :
     2898     DISPLAY v-printer-name
     2899         WITH FRAME Dialog-Frame.
     2900     ENABLE b-exit b-mark b-erase b-print b-help BROWSE-2 v-printer-name
     2901         WITH FRAME Dialog-Frame.
     2902     VIEW FRAME Dialog-Frame.
     2903     OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.id.
     2904   END PROCEDURE.
     2905   PROCEDURE init-syskey-names :
     2906   do
     2907   on error undo, return error
     2908   :
     2909       define variable v-next-line as logical       no-undo.
     2910       lines-of-browse:
     2911       for each tmp#list
     2912       :
     2913           if v-next-line = yes
     2914           then do:
     2915               assign
     2916                   v-next-line = no
     2917               .
     2918               next lines-of-browse.
     2919           end.
     2920           if tmp#list.sys-key <> ""
     2921           then do:
     2922               assign
     2923                   tmp#list.blank-name = substring( tmp#list.blank-name + " '" + tmp#list.sys-key + "'" , 1, 120 )
     2924                   v-next-line = yes
     2925               .
     2926           end.
     2927           if Tmp#List.sys-key-black <> ""
     2928           then do:
     2929               assign
     2930                   Tmp#List.blank-name = substring( Tmp#List.blank-name + " no-'" + Tmp#List.sys-key-black + "'", 1, 120 )
     2931                   v-next-line = yes
     2932               .
     2933           end.
     2934       end.
     2935       OPEN QUERY BROWSE-2 FOR EACH Tmp#List NO-LOCK where     Tmp#List.view_ <> 0     BY Tmp#List.id.
     2936   end.
     2937   END PROCEDURE.
     2938   PROCEDURE Load-menu :
     2939   define input parameter p-inkas-code as character        no-undo.
     2940   define input parameter xtype        as character        no-undo.
     2941   define input parameter xstatus      as character        no-undo.
     2942   define variable xInternal as char no-undo init no.
     2943   define variable xflag     as char no-undo init yes.
     2944   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2945   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2946     (output v-menu-doc-sys-key
     2947     ) no-error .
     2948       assign
     2949           v-menu-doc-doc-code = p-inkas-code
     2950           v-menu-doc-doc-type = xtype
     2951           v-menu-doc-status_  = xstatus
     2952           v-menu-doc-internal = xInternal
     2953           v-menu-doc-flag     = xflag
     2954           sys-key             = v-menu-doc-sys-key
     2955       .
     2956   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2957   define variable is-ptrl  as character no-undo .
     2958   define variable is-jwlr  as character no-undo .
     2959   define variable ptwounit as logical no-undo init yes .
     2960   define variable cas-shft as logical no-undo init no.
     2961   define variable conf-attr as character no-undo .
     2962   define variable conf-par as character no-undo .
     2963   define variable par-type as character no-undo .
     2964   run gbl/conf-rd.p ("is-ptrl", "", "", 0, "", "", "", no, output is-ptrl, output par-type) no-error.
     2965   if error-status :error
     2966     or par-type <> "l"
     2967     or is-ptrl  <> "yes"
     2968   then do:
     2969     assign is-ptrl = "no".
     2970   end.
     2971   run gbl/conf-rd.p ("is-jwlr", "", "", 0, "", "", "", no, output is-jwlr, output par-type) no-error.
     2972   if error-status :error
     2973     or par-type <> "l"
     2974     or is-jwlr  <> "yes"
     2975   then do:
     2976     assign is-jwlr = "no".
     2977   end.
     2978   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2979   define variable v-param-type15 as character no-undo .
     2980   define variable v-value-character15 as character no-undo .
     2981   define variable v-value-date15 as date no-undo .
     2982   define variable v-value-decimal15 as decimal no-undo .
     2983   define variable v-value-integer15 as INTEGER no-undo .
     2984   define variable v-tth15 as handle no-undo .
     2985   run adm/shattri.p (
     2986       input "get":U
     2987       ,input  buf_inkas.obj-type
     2988       ,input  buf_inkas.obj-code
     2989       ,input  'get-chk':U
     2990       ,input  'cas-shft':U
