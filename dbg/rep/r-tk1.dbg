      697   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      698   procedure cur-time :
      699      define output parameter p-today as date      no-undo .
      700      define output parameter p-time  as integer   no-undo .
      701     do
      702     on error undo, return error
      703     :
      704       define variable v-date1 as date      no-undo .
      705       define variable v-date2 as date      no-undo .
      706       define variable v-time  as integer   no-undo .
      707       assign
      708         v-date1 = today
      709         v-time  = time
      710         v-date2 = today
      711       .
      712       if v-date1 <> v-date2
      713       then do:
      714         assign
      715           v-date1 = today
      716           v-time  = v-time
      717         .
      718       end.
      719       assign
      720         p-today = v-date1
      721         p-time  = v-time
      722       .
      723     end.
      724   end.
      725   function cur-time-date returns character
      726   :
      727     return string(today, '99/99/9999':U) .
      728   end.
      729   function cur-time-mjd returns decimal
      730   :
      731     define variable v-date as date      no-undo .
      732     define variable v-time as integer   no-undo .
      733     run cur-time in this-procedure
      734       (output v-date
      735       ,output v-time
      736       ) .
      737     return integer(v-date) - 2400002 + (v-time / 86400) .
      738   end.
      739   function cur-time-get-ending-index returns integer
      740   (input p-number as integer
      741   )
      742   :
      743     if p-number < 0
      744     or p-number = ?
      745     then do:
      746       return 1 .
      747     end.
      748     define variable v-rest as integer   no-undo .
      749     assign
      750       p-number = p-number modulo 100
      751     .
      752     if p-number < 20
      753     then do:
      754       assign
      755         v-rest = p-number
      756       .
      757     end.
      758     else do:
      759       assign
      760         v-rest = p-number modulo 10
      761       .
      762     end.
      763     case v-rest :
      764       when 1
      765       then do:
      766         return 2 .
      767       end.
      768       when 2 or
      769       when 3 or
      770       when 4
      771       then do:
      772         return 3 .
      773       end.
      774       otherwise do:
      775         return 1 .
      776       end.
      777     end case .
      778   end.
      779   procedure cur-time-mjd-to-date :
      780      define input  parameter i-mjd-diff as decimal no-undo.
      781      define output parameter o-Date     as date    no-undo.
      782      define output parameter o-Time     as integer no-undo.
      783      define variable v-day-number as integer   no-undo .
      784      if    i-mjd-diff < 0
      785         or i-mjd-diff = ?
      786      then do:
      787         return "?" .
      788      end.
      789      assign
      790         v-day-number = truncate(i-mjd-diff,0).
      791         o-Date = date(v-day-number + 2400002).
      792         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      793     .
      794   end.
      795   function cur-time-mjd-to-string returns character
      796   (input p-mjd-diff as decimal
      797   )
      798   :
      799     define variable v-day-number as integer   no-undo .
      800     define variable v-seconds    as integer   no-undo .
      801     define variable v-hour       as integer   no-undo .
      802     define variable v-min        as integer   no-undo .
      803     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      804     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      805     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      806     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      807     if p-mjd-diff < 0
      808     or p-mjd-diff = ?
      809     then do:
      810       return "?" .
      811     end.
      812     assign
      813       v-day-number = integer(truncate(p-mjd-diff,0))
      814       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      815     .
      816     if v-seconds > 86400
      817     then do:
      818       assign
      819         v-seconds = 86400 - 1
      820       .
      821     end.
      822     if v-seconds < 0
      823     then do:
      824       assign
      825         v-seconds = 0
      826       .
      827     end.
      828     assign
      829       v-hour = truncate(v-seconds / 3600, 0)
      830     .
      831     assign
      832       v-seconds = v-seconds modulo 3600
      833     .
      834     assign
      835       v-min = truncate(v-seconds / 60, 0)
      836     .
      837     assign
      838       v-seconds = v-seconds modulo 60
      839     .
      840     return
      841         (if v-day-number <> 0
      842           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      843           else ""
      844         )
      845       + (if v-day-number <> 0 or v-hour <> 0
      846           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      847           else ""
      848         )
      849       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      850           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      851           else ""
      852         )
      853       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      854       .
      855   end.
      856   function cur-time-string returns character
      857   :
      858     define variable v-date as date      no-undo .
      859     define variable v-time as integer   no-undo .
      860     run cur-time in this-procedure
      861       (output v-date
      862       ,output v-time
      863       ) .
      864     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      865   end.
      866   function cur-time-string-sec returns character
      867   :
      868     define variable v-date as date      no-undo .
      869     define variable v-time as integer   no-undo .
      870     run cur-time in this-procedure
      871       (output v-date
      872       ,output v-time
      873       ) .
      874     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      875   end.
      876   function cur-time-custom  returns character
      877   (input p-prefix as character
      878   ,input p-date-format as character
      879   ,input p-delimiter as character
      880   ,input p-time-format as character
      881   ,input p-suffix as character
      882   )
      883   :
      884     define variable v-date as date      no-undo .
      885     define variable v-time as integer   no-undo .
      886     run cur-time in this-procedure
      887       (output v-date
      888       ,output v-time
      889       ) .
      890     return
      891       p-prefix
      892       + string(v-date, p-date-format)
      893       + p-delimiter
      894       + string(v-time, p-time-format)
      895       + p-suffix
      896       .
      897   end.
      898   function cur-time-print  returns character
      899   :
      900     define variable v-date as date      no-undo .
      901     define variable v-time as integer   no-undo .
      902     run cur-time in this-procedure
      903       (output v-date
      904       ,output v-time
      905       ) .
      906     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      907   end.
      908   function cur-time-datetime returns datetime
      909   :
      910     define variable v-char as character no-undo .
      911     define variable v-datetime as datetime no-undo .
      912     v-char = cur-time-string().
      913     v-datetime = datetime(v-char).
      914     return  v-datetime.
      915   end.
      916   function cur-time-string-msec returns character
      917   :
      918     define variable v-date as datetime  no-undo .
      919     v-date = now.
      920     return string(v-date) .
      921   end.
      922   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   function breakstr returns character ( input        for-name    as character,
      924                                         input        line-length as integer,
      925                                         input-output line1       as character,
      926                                         input-output line2       as character ) :
      927     define variable ii as integer no-undo.
      928     if length( for-name ) > line-length then do:
      929       assign ii    = 1
      930              line1 = "":u
      931              line2 = "":u.
      932       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      933         assign line1 =       substring( for-name, 1, line-length     )
      934                line2 = trim( substring( for-name,    line-length + 1 ) ).
      935       end.                                                     else do:
      936         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      937           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      938                  ii    = ii    + 1.
      939           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      940             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      941           end.
      942         end.
      943         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      944       end.
      945     end.                                else do:
      946       assign line1 = for-name
      947              line2 = "":u.
      948     end.
      949     return ( line1 ).
      950   end function.
      951       def var t-addres        like ub.firm.addres1   no-undo.
      952       def var t-phone         like ub.firm.phone     no-undo.
      953       def var t-inn           like ub.firm.inn       no-undo.
      954       def var t-okpo          like ub.firm.okpo      no-undo.
