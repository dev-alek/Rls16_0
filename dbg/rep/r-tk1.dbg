     5595   function nutro_get-carbohydrate returns decimal
     5596     ( input p-artic     as character
     5597     , input p-prod-type as character
     5598     , input p-prod-code as integer
     5599     , input p-obj-type  as character
     5600     , input p-obj-code  as integer
     5601     )
     5602   :
     5603     define variable v-carbohydrate as decimal   no-undo .
     5604     run nutro_proc-get-carbohydrate in this-procedure ( input p-artic
     5605                                                       , input p-prod-type
     5606                                                       , input p-prod-code
     5607                                                       , input p-obj-type
     5608                                                       , input p-obj-code
     5609                                                       , output v-carbohydrate
     5610                                                       ) no-error .
     5611     if error-status :error = yes
     5612     then do:
     5613       assign
     5614         v-carbohydrate = ?
     5615       .
     5616     end.
     5617     return v-carbohydrate.
     5618   end function.
