     5793                                                    , input  p-obj-code
     5794                                                    , output v-calories
     5795                                                    , output v-protein
     5796                                                    , output v-carbohydrate
     5797                                                    , output v-fat
     5798                                                    ) no-error .
     5799     if error-status :error = yes
     5800     then do:
     5801       return .
     5802     end.
     5803     assign
     5804       p-protein = v-protein
     5805     .
     5806   end.
     5807   end procedure.
     5808   procedure nutro_proc-get-calories :
     5809     define input  parameter p-artic         as character no-undo .
     5810     define input  parameter p-prod-type     as character no-undo .
     5811     define input  parameter p-prod-code     as integer   no-undo .
     5812     define input  parameter p-obj-type      as character no-undo .
     5813     define input  parameter p-obj-code      as integer   no-undo .
     5814     define output parameter p-calories      as decimal   no-undo .
     5815     define buffer buf_goods    for ub.goods .
     5816     define variable v-attr-value    as character no-undo .
     5817     define variable v-attr-type     as character no-undo .
     5818     define variable v-calories      as decimal   no-undo .
     5819     define variable v-protein       as decimal   no-undo .
     5820     define variable v-carbohydrate  as decimal   no-undo .
     5821     define variable v-fat           as decimal   no-undo .
     5822   do
     5823   on error undo, return error return-value
     5824   :
     5825     assign
     5826       p-calories = ?
     5827     .
     5828     run nutro_get-nutrition-info in this-procedure ( input  p-artic
     5829                                                    , input  p-prod-type
     5830                                                    , input  p-prod-code
     5831                                                    , input  p-obj-type
     5832                                                    , input  p-obj-code
     5833                                                    , output v-calories
     5834                                                    , output v-protein
     5835                                                    , output v-carbohydrate
     5836                                                    , output v-fat
     5837                                                    ) no-error .
     5838     if error-status :error = yes
     5839     then do:
     5840       return .
     5841     end.
     5842     assign
     5843       p-calories = v-calories
     5844     .
     5845   end.
     5846   end procedure.
     5847   procedure nutro_get-nutrition-info :
     5848     define input  parameter p-artic         as character no-undo .
     5849     define input  parameter p-prod-type     as character no-undo .
     5850     define input  parameter p-prod-code     as integer   no-undo .
     5851     define input  parameter p-obj-type      as character no-undo .
     5852     define input  parameter p-obj-code      as integer   no-undo .
     5853     define output parameter p-calories      as decimal   no-undo .
     5854     define output parameter p-protein       as decimal   no-undo .
     5855     define output parameter p-carbohydrate  as decimal   no-undo .
     5856     define output parameter p-fat           as decimal   no-undo .
     5857     define buffer buf_goods    for ub.goods .
     5858     define variable v-attr-value    as character no-undo .
     5859     define variable v-attr-type     as character no-undo .
     5860     define variable v-attr-code     as character no-undo .
     5861     define variable v-exist         as logical   no-undo .
     5862     define variable v-is-global     as logical   no-undo .
     5863     define variable v-nutro-value   as decimal   no-undo .
     5864     define buffer buf_fbr-gds-obj  for ub.fbr-gds-obj.
     5865     define buffer buf_recipe       for ub.recipe.
     5866   do
     5867   on error undo, return error return-value
     5868   :
     5869     assign
     5870       p-carbohydrate  = ?
     5871       p-fat           = ?
     5872       p-protein       = ?
     5873       p-calories      = ?
     5874     .
     5875     find first buf_goods no-lock
     5876       where buf_goods.artic     = p-artic
     5877         and buf_goods.prod-type = p-prod-type
     5878         and buf_goods.prod-code = p-prod-code
     5879     no-error .
     5880     if not available buf_goods
     5881     then do:
     5882       return .
     5883     end.
     5884     assign
     5885       v-is-global = yes
     5886     .
     5887     find first buf_fbr-gds-obj no-lock
     5888       where buf_fbr-gds-obj.obj-type = p-obj-type
     5889         and buf_fbr-gds-obj.obj-code = p-obj-code
     5890         and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     5891     no-error .
     5892     if available buf_fbr-gds-obj
     5893     then do:
     5894       if  buf_fbr-gds-obj.is-semi-finished or
     5895           buf_fbr-gds-obj.is-menu
     5896       then do:
     5897         assign
     5898           v-is-global = no
     5899         .
     5900         find first buf_recipe no-lock
     5901           where buf_recipe.recipe-code = buf_fbr-gds-obj.default-recipe-code
     5902         no-error .
     5903         if available buf_recipe
     5904         then do:
     5905           assign
     5906             v-is-global = ( buf_recipe.host-code = 0    ) and
     5907                           ( buf_recipe.obj-type  = "":U ) and
     5908                           ( buf_recipe.obj-code  = 0    )
     5909           .
     5910         end.
     5911       end.
     5912     end.
     5913     if v-is-global = yes
     5914     then do:
     5915       assign
     5916         v-attr-code = 'calories':U
     5917       .
     5918       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5919       assign
     5920         p-calories  = v-nutro-value
     5921         v-attr-code = 'carbohydrate':U
     5922       .
     5923       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5924       assign
     5925         p-carbohydrate  = v-nutro-value
     5926         v-attr-code     = 'fat':U
     5927       .
     5928       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5929       assign
     5930         p-fat       = v-nutro-value
     5931         v-attr-code = 'protein':U
     5932       .
     5933       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5934       assign
     5935         p-protein = v-nutro-value
     5936       .
     5937     end.
     5938     else do:
     5939       assign
     5940         v-attr-code = 'calories-o':U
     5941       .
     5942       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5943       assign
     5944         p-calories  = v-nutro-value
     5945         v-attr-code = 'carbohydrate-o':U
     5946       .
     5947       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5948       assign
     5949         p-carbohydrate  = v-nutro-value
     5950         v-attr-code     = 'fat-o':U
     5951       .
     5952       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5953       assign
     5954         p-fat       = v-nutro-value
     5955         v-attr-code = 'protein-o':U
     5956       .
     5957       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5958       assign
     5959         p-protein = v-nutro-value
     5960       .
     5961     end.
     5962   end.
     5963   end procedure.
