     1515   procedure partslib-calc-cost :
     1516     define output parameter p-fact-qnty      as decimal   no-undo .
     1517     define output parameter p-vat-pc         as decimal   no-undo .
     1518     define output parameter p-slt-pc         as decimal   no-undo .
     1519     define output parameter p-sum-base       as decimal   no-undo .
     1520     define output parameter p-sum-rubl       as decimal   no-undo .
     1521     define output parameter p-vat-base       as decimal   no-undo .
     1522     define output parameter p-vat-rubl       as decimal   no-undo .
     1523     define output parameter p-slt-base       as decimal   no-undo .
     1524     define output parameter p-slt-rubl       as decimal   no-undo .
     1525     define output parameter p-road-tax-base  as decimal   no-undo .
     1526     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1527     define output parameter p-transport-base as decimal   no-undo .
     1528     define output parameter p-transport-rubl as decimal   no-undo .
     1529     define output parameter p-other-base     as decimal   no-undo .
     1530     define output parameter p-other-rubl     as decimal   no-undo .
     1531     define output parameter p-excise-base    as decimal   no-undo .
     1532     define output parameter p-excise-rubl    as decimal   no-undo .
     1533     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1534     do
     1535     on error undo, return error return-value
     1536     :
     1537       define buffer buf_temp-parts for temp-parts .
     1538       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1539       define buffer   in-vatp-parts    for ub.parts   .
     1540       define buffer   in-vatp-doc      for ub.trn-doc .
     1541       define buffer   in-vatp-goods    for ub.goods   .
     1542       define buffer   in-vatp-sysconf  for ub.sysconf .
     1543       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1544       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1545       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1546       define variable varinvprb                  as   character              no-undo.
     1547       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1548       define variable cli-base-rate              as   decimal                no-undo.
     1549       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1550       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1551       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1552       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1553       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1554       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1555       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1556       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1557       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1558       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1559       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1560       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1561       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1562       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1563       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1564       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1565       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1566       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1567       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1568       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1569       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1570       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1571       define variable varinvatp-envd             as   character              no-undo.
     1572       define variable varinvatp-type             as   character              no-undo.
     1573       for each buf_temp-parts
     1574       on error undo, return error
     1575       :
     1576   assign
     1577     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1578     price-base-with-tax-loc = buf_temp-parts.price-base
     1579   .
     1580   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1582     (output varinvprb
     1583     )  .
     1584     if buf_temp-parts.out-code = 'free-zone':U     or
     1585        buf_temp-parts.out-code = 'out-zone':U   or
     1586        buf_temp-parts.doc-type = 'акт':U then do:
     1587       assign
     1588         in-vatp-have-vat-slt = yes.
     1589     end.
     1590     else do:
     1591       find first in-vatp_doc-attr no-lock
     1592         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1593           and in-vatp_doc-attr.attr-code = 'envd':U
     1594         no-error .
     1595       if not available in-vatp_doc-attr then do:
     1596         assign
     1597           in-vatp-have-vat-slt = yes.
     1598       end.
     1599       else do:
     1600            in-vatp-have-vat-slt = no.
     1601       end.
     1602     end.
     1603     assign
     1604      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1605      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1606     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1607              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1608     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1609             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1610             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1611             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1612             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1613             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1614             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1615       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1616     assign
     1617       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1618     assign
     1619       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1620       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1621       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1622       transport-cli-loc  = 0
     1623       other-cli-loc      = 0
     1624     .
     1625   ASSIGN
     1626             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1627       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1628   .
     1629         assign
     1630           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1631           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1632           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1633           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1634           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1635           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1636           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1637           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1638           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1639           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1640           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1641           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1642           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1643           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1644           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1645           p-excise-base    = p-excise-base    + 0
     1646           p-excise-rubl    = p-excise-rubl    + 0
     1647         .
     1648       end.
     1649       if p-fact-qnty      = ?
     1650       or p-sum-base       = ?
     1651       or p-sum-rubl       = ?
     1652       or p-vat-base       = ?
     1653       or p-vat-rubl       = ?
     1654       or p-slt-base       = ?
     1655       or p-slt-rubl       = ?
     1656       or p-road-tax-base  = ?
     1657       or p-road-tax-rubl  = ?
     1658       or p-transport-base = ?
     1659       or p-transport-rubl = ?
     1660       or p-other-base     = ?
     1661       or p-other-rubl     = ?
     1662       or p-excise-base    = ?
     1663       or p-excise-rubl    = ?
     1664       then do:
     1665         message
     1666           vss-workfile vss-revision vss-description skip
     1667           vss-include-info16 skip
     1668           "Программа in-vatp.i вернула неопределенные значения" skip
     1669           "p-fact-qnty"      p-fact-qnty      skip
     1670           "p-sum-base"       p-sum-base       skip
     1671           "p-sum-rubl"       p-sum-rubl       skip
     1672           "p-vat-base"       p-vat-base       skip
     1673           "p-vat-rubl"       p-vat-rubl       skip
     1674           "p-slt-base"       p-slt-base       skip
     1675           "p-slt-rubl"       p-slt-rubl       skip
     1676           "p-road-tax-base"  p-road-tax-base  skip
     1677           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1678           "p-transport-base" p-transport-base skip
     1679           "p-transport-rubl" p-transport-rubl skip
     1680           "p-other-base"     p-other-base     skip
     1681           "p-other-rubl"     p-other-rubl     skip
     1682           "p-excise-base"    p-excise-base    skip
     1683           "p-excise-rubl"    p-excise-rubl    skip
     1684           view-as alert-box error .
     1685         undo, return error .
     1686       end.
     1687     end.
     1688   end procedure.
