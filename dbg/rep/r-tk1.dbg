      956   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      958   procedure partslib-clear-temp-parts :
      959     define buffer buf_temp-parts for temp-parts .
      960     do
      961     on error undo, return error
      962     :
      963       for each buf_temp-parts
      964       on error undo, return error
      965       :
      966         delete buf_temp-parts .
      967       end.
      968     end.
      969   end procedure.
      970   procedure partslib-create-temp-parts :
      971     define parameter buffer buf_parts       for ub.parts .
      972     define parameter buffer buf_temp-parts  for temp-parts .
      973     define input  parameter p-goods-twounit as logical   no-undo .
      974     define variable v-base-part-code as character no-undo .
      975     do
      976     on error undo, return error
      977     :
      978       if p-goods-twounit = true
      979       then do:
      980         assign
      981           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      982         .
      983       end.
      984       else do:
      985         assign
      986           v-base-part-code = buf_parts.part-code
      987         .
      988       end.
      989       find first buf_temp-parts exclusive-lock
      990         where buf_temp-parts.obj-type  = buf_parts.obj-type
      991           and buf_temp-parts.obj-code  = buf_parts.obj-code
      992           and buf_temp-parts.artic     = buf_parts.artic
      993           and buf_temp-parts.prod-type = buf_parts.prod-type
      994           and buf_temp-parts.prod-code = buf_parts.prod-code
      995           and buf_temp-parts.in-code   = buf_parts.in-code
      996           and buf_temp-parts.out-code  = 'free-zone':U
      997           and buf_temp-parts.part-code = v-base-part-code
      998         no-error.
      999       if not available buf_temp-parts
     1000       then do:
     1001         create buf_temp-parts .
     1002         buffer-copy buf_parts to buf_temp-parts
     1003         assign
     1004           buf_temp-parts.out-code  = 'free-zone':U
     1005           buf_temp-parts.part-code = v-base-part-code
     1006           buf_temp-parts.rsrv-free = yes
     1007           buf_temp-parts.status_   = no
     1008           buf_temp-parts.qnty      = 0
     1009           buf_temp-parts.fact-qnty = 0
     1010           buf_temp-parts.real-qnty = 0
     1011           buf_temp-parts.cli-qnty  = 0
     1012         .
     1013       end.
     1014     end.
     1015   end procedure.
     1016   procedure partslib-init-temp-parts :
     1017     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1018     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1019     define input parameter p-artic           like ub.parts.artic     no-undo .
     1020     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1021     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1022     define buffer buf_parts      for ub.parts .
     1023     define buffer buf_temp-parts for temp-parts .
     1024     define variable v-goods-twounit    as logical   no-undo .
     1025     do
     1026     on error undo, return error
     1027     :
     1028   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1029   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1030     (input  p-artic
     1031     ,input  p-prod-type
     1032     ,input  p-prod-code
     1033     ,input  'twounit=request':u
     1034     ,output v-goods-twounit
     1035     ) no-error .
     1036       if error-status :error
     1037       then do:
     1038         message
     1039           vss-workfile vss-revision vss-description skip
     1040           vss-include-info16 skip
     1041           "Ошибка при определении атрибута товара" skip
     1042           "Артикул" p-artic p-prod-type p-prod-code skip
     1043           "twounit=request" skip
     1044           error-status :get-message(1) skip
     1045           return-value skip
     1046           view-as alert-box error .
     1047         undo, return error return-value .
     1048       end.
     1049       run partslib-clear-temp-parts in this-procedure .
     1050       for each buf_parts
     1051         where buf_parts.obj-type  = p-obj-type
     1052           and buf_parts.obj-code  = p-obj-code
     1053           and buf_parts.artic     = p-artic
     1054           and buf_parts.prod-type = p-prod-type
     1055           and buf_parts.prod-code = p-prod-code
     1056           and buf_parts.rsrv-free = yes
     1057           and buf_parts.status_   = no
     1058           and buf_parts.in-code   <> buf_parts.out-code
     1059       on error undo, return error
     1060       :
     1061         run partslib-create-temp-parts in this-procedure
     1062           (buffer buf_parts
     1063           ,buffer buf_temp-parts
     1064           ,input  v-goods-twounit
     1065           ) .
     1066         define variable v-parts-qnty          as decimal   no-undo .
     1067         define variable v-parts-cli-qnty      as decimal   no-undo .
     1068         define variable v-parts-free-qnty     as decimal   no-undo .
     1069         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1070         if buf_parts.out-code = 'free-zone':U
     1071         then do:
     1072           assign
     1073             v-parts-qnty          = buf_parts.qnty
     1074             v-parts-cli-qnty      = buf_parts.cli-qnty
     1075             v-parts-free-qnty     = buf_parts.qnty
     1076             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1077           .
     1078         end.
     1079         else do:
     1080           assign
     1081             v-parts-qnty          = abs(buf_parts.qnty)
     1082             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1083             v-parts-free-qnty     = 0
     1084             v-parts-free-cli-qnty = 0
     1085           .
     1086         end.
     1087         assign
     1088           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1089           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1090           buf_temp-parts.real-qnty     = 0
     1091           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1092           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1093           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1094         .
     1095       end.
     1096     end.
     1097   end procedure.
     1098   procedure partslib-init-temp-parts-by-factord :
     1099     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1100     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1101     define input parameter p-artic              like ub.parts.artic     no-undo .
     1102     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1103     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1104     define input parameter p-fact-order         as decimal   no-undo .
     1105     define input parameter p-include-fact-order as logical   no-undo .
     1106     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1107     define buffer buf_gds-obj  for ub.gds-obj .
     1108     do
     1109     on error undo, return error
     1110     :
     1111       do transaction
     1112       on error undo, return error
     1113       :
     1114   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1116     (input  p-obj-type
     1117     ,input  p-obj-code
     1118     ,input  p-artic
     1119     ,input  p-prod-type
     1120     ,input  p-prod-code
     1121     ,buffer buf_gds-obj
     1122     ) no-error .
     1123         if error-status :error
     1124         then do:
     1125           message
     1126             vss-workfile vss-revision vss-description skip
     1127             vss-include-info16 skip
     1128             "Невозможно найти товар на объекте" skip
     1129             "Объект" p-obj-type p-obj-code skip
     1130             "Артикул" p-artic p-prod-type p-prod-code skip
     1131             error-status :get-message(1) skip
     1132             return-value skip
     1133             view-as alert-box error .
     1134           undo, return error .
     1135         end.
     1136         find current buf_gds-obj exclusive-lock .
     1137       end.
     1138       run partslib-init-temp-parts in this-procedure
     1139         (input p-obj-type
     1140         ,input p-obj-code
     1141         ,input p-artic
     1142         ,input p-prod-type
     1143         ,input p-prod-code
     1144         ) no-error .
     1145       if error-status :error
     1146       then do:
     1147         message
     1148           vss-workfile vss-revision vss-description skip
     1149           vss-include-info16 skip
     1150           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1151           "Объект" p-obj-type p-obj-code skip
     1152           "Артикул" p-artic p-prod-type p-prod-code skip
     1153           "p-fact-order" p-fact-order skip
     1154           view-as alert-box error .
     1155         undo, return error .
     1156       end.
     1157       if p-include-fact-order = true
     1158       then do:
     1159         assign
     1160           p-fact-order = p-fact-order - 0.0000000001
     1161         .
     1162       end.
     1163       define variable v-max-fact-order as character no-undo .
     1164       run factord-max-fact-order in this-procedure
     1165         (output v-max-fact-order
     1166         ) no-error .
     1167       if error-status :error
     1168       then do:
     1169         message
     1170           vss-workfile vss-revision vss-description skip
     1171           vss-include-info16 skip
     1172           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1173           "Объект" p-obj-type p-obj-code skip
     1174           "Артикул" p-artic p-prod-type p-prod-code skip
     1175           "p-fact-order" p-fact-order skip
     1176           view-as alert-box error .
     1177         undo, return error .
     1178       end.
     1179       run partslib-update-by-factord in this-procedure
     1180         (input p-obj-type
     1181         ,input p-obj-code
     1182         ,input p-artic
     1183         ,input p-prod-type
     1184         ,input p-prod-code
     1185         ,input p-fact-order
     1186         ,input v-max-fact-order
     1187         ,input false
     1188         ) no-error .
     1189       if error-status :error
     1190       then do:
     1191         message
     1192           vss-workfile vss-revision vss-description skip
     1193           vss-include-info16 skip
     1194           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1195           "Объект" p-obj-type p-obj-code skip
     1196           "Артикул" p-artic p-prod-type p-prod-code skip
     1197           "p-fact-order" p-fact-order skip
     1198           "v-max-fact-order" v-max-fact-order skip
     1199           view-as alert-box error .
     1200         undo, return error .
     1201       end.
     1202     end.
     1203   end procedure.
     1204   procedure partslib-update-by-factord :
     1205     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1206     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1207     define input parameter p-artic              like ub.parts.artic     no-undo .
     1208     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1209     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1210     define input parameter p-start-fact-order   as decimal   no-undo .
     1211     define input parameter p-end-fact-order     as decimal   no-undo .
     1212     define input parameter p-lock-gds-obj       as logical   no-undo .
     1213     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1214     define buffer buf_gds-obj  for ub.gds-obj .
     1215     define buffer buf_doc-line for ub.doc-line .
     1216     define variable v-total-parts-qnty as decimal   no-undo .
     1217     define variable v-goods-gds-goods  as logical   no-undo .
     1218     define variable v-goods-twounit    as logical   no-undo .
     1219     do
     1220     on error undo, return error
     1221     :
     1222       if p-start-fact-order > p-end-fact-order
     1223       then do:
     1224         message
     1225           vss-workfile vss-revision vss-description skip
     1226           vss-include-info16 skip
     1227           "Ошибка задания входных параметров" skip
     1228           "Начало интервала превышает конец интервала" skip
     1229           "Объект" p-obj-type p-obj-code skip
     1230           "Артикул" p-artic p-prod-type p-prod-code skip
     1231           "p-start-fact-order" p-start-fact-order skip
     1232           "p-end-fact-order"   p-end-fact-order skip
     1233           view-as alert-box error .
     1234         undo, return error .
     1235       end.
     1236       if p-lock-gds-obj = true
     1237       then do:
     1238         do transaction
     1239         on error undo, return error
     1240         :
     1241   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1243     (input  p-obj-type
     1244     ,input  p-obj-code
     1245     ,input  p-artic
     1246     ,input  p-prod-type
     1247     ,input  p-prod-code
     1248     ,buffer buf_gds-obj
     1249     ) no-error .
     1250           if error-status :error
     1251           then do:
     1252             message
     1253               vss-workfile vss-revision vss-description skip
     1254               vss-include-info16 skip
     1255               "Невозможно найти gds-obj" skip
     1256               error-status :get-message(1) skip
     1257               return-value skip
     1258               view-as alert-box error .
     1259             undo, return error .
     1260           end.
     1261           find current buf_gds-obj exclusive-lock .
     1262         end.
     1263       end.
     1264   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1266     (input  p-artic
     1267     ,input  p-prod-type
     1268     ,input  p-prod-code
     1269     ,input  'gds-goods=request':u
     1270     ,output v-goods-gds-goods
     1271     ) no-error .
     1272       if error-status :error
     1273       then do:
     1274         message
     1275           vss-workfile vss-revision vss-description skip
     1276           vss-include-info16 skip
     1277           "Ошибка при определении атрибута товара" skip
     1278           "Артикул" p-artic p-prod-type p-prod-code skip
     1279           "gds-goods=request" skip
     1280           error-status :get-message(1) skip
     1281           return-value skip
     1282           view-as alert-box error .
     1283         undo, return error return-value .
     1284       end.
     1285   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1287     (input  p-artic
     1288     ,input  p-prod-type
     1289     ,input  p-prod-code
     1290     ,input  'twounit=request':u
     1291     ,output v-goods-twounit
     1292     ) no-error .
     1293       if error-status :error
     1294       then do:
     1295         message
     1296           vss-workfile vss-revision vss-description skip
     1297           vss-include-info16 skip
     1298           "Ошибка при определении атрибута товара" skip
     1299           "Артикул" p-artic p-prod-type p-prod-code skip
     1300           "twounit=request" skip
     1301           error-status :get-message(1) skip
     1302           return-value skip
     1303           view-as alert-box error .
     1304         undo, return error return-value .
     1305       end.
     1306       for each buf_doc-line no-lock
     1307         where buf_doc-line.obj-type   = p-obj-type
     1308           and buf_doc-line.obj-code   = p-obj-code
     1309           and buf_doc-line.artic      = p-artic
     1310           and buf_doc-line.prod-type  = p-prod-type
     1311           and buf_doc-line.prod-code  = p-prod-code
     1312           and buf_doc-line.status_    = 'факт':U
     1313           and buf_doc-line.fact-order > p-start-fact-order
     1314           and buf_doc-line.fact-order <= p-end-fact-order
     1315       on error undo, return error
     1316       :
     1317         run partslib-process-document in this-procedure
     1318           (input  buf_doc-line.doc-code
     1319           ,input  p-obj-type
     1320           ,input  p-obj-code
     1321           ,input  p-artic
     1322           ,input  p-prod-type
     1323           ,input  p-prod-code
     1324           ,input  v-goods-gds-goods
     1325           ,input  v-goods-twounit
     1326           ,output v-total-parts-qnty
     1327           ) no-error .
     1328         if error-status :error
     1329         then do:
     1330           message
     1331             vss-workfile vss-revision vss-description skip
     1332             vss-include-info16 skip
     1333             "Ошибка при вызове процедуры partslib-process-document" skip
     1334             "Документ" buf_doc-line.doc-code skip
     1335             "Объект" p-obj-type p-obj-code skip
     1336             "Артикул" p-artic p-prod-type p-prod-code skip
     1337             "p-start-fact-order" p-start-fact-order skip
     1338             "p-end-fact-order" p-end-fact-order skip
     1339             error-status :get-message(1) skip
     1340             return-value skip
     1341             view-as alert-box error .
     1342           undo, return error return-value .
     1343         end.
     1344       end.
     1345     end.
     1346   end procedure.
     1347   procedure partslib-process-document :
     1348     define input  parameter p-doc-code         as character no-undo .
     1349     define input  parameter p-obj-type         as character no-undo .
     1350     define input  parameter p-obj-code         as integer   no-undo .
     1351     define input  parameter p-artic            as character no-undo .
     1352     define input  parameter p-prod-type        as character no-undo .
     1353     define input  parameter p-prod-code        as integer   no-undo .
     1354     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1355     define input  parameter p-goods-twounit    as logical   no-undo .
     1356     define output parameter p-total-parts-qnty as decimal   no-undo .
     1357     define variable v-parts-sign as integer   no-undo .
     1358     define buffer buf_trn-doc    for ub.trn-doc .
     1359     define buffer buf_doc-line   for ub.doc-line .
     1360     define buffer buf_parts      for ub.parts .
     1361     define buffer buf_temp-parts for temp-parts .
     1362     do
     1363     on error undo, return error return-value
     1364     :
     1365       find first buf_trn-doc no-lock
     1366         where buf_trn-doc.doc-code = p-doc-code
     1367         no-error .
     1368       if not available buf_trn-doc
     1369       then do:
     1370         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1371                                      ,p-doc-code
     1372                                      ) .
     1373       end.
     1374       case buf_trn-doc.doc-type
     1375       :
     1376         when 'при':U or
     1377         when 'возврат':U or
     1378         when 'инв':U
     1379         then do:
     1380           assign
     1381             v-parts-sign = -1
     1382           .
     1383         end.
     1384         when 'рас':U or
     1385         when 'спи':U
     1386         then do:
     1387           assign
     1388             v-parts-sign = 1
     1389           .
     1390         end.
     1391         otherwise do:
     1392           undo, return error substitute("Неизвестный тип документа &1"
     1393                                       ,buf_trn-doc.doc-type
     1394                                       ) .
     1395         end.
     1396       end.
     1397       find first buf_doc-line no-lock
     1398         where buf_doc-line.doc-code  = p-doc-code
     1399           and buf_doc-line.artic     = p-artic
     1400           and buf_doc-line.prod-type = p-prod-type
     1401           and buf_doc-line.prod-code = p-prod-code
     1402         no-error .
     1403       if not available buf_doc-line
     1404       then do:
     1405         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1406                                      ,p-doc-code
     1407                                      ,artic
     1408                                      ,prod-type
     1409                                      ,prod-code
     1410                                      ) .
     1411       end.
     1412       assign
     1413         p-total-parts-qnty = 0
     1414       .
     1415       if p-goods-gds-goods = true
     1416       then do:
     1417         for each buf_parts no-lock
     1418           where buf_parts.out-code  = p-doc-code
     1419             and buf_parts.obj-type  = p-obj-type
     1420             and buf_parts.obj-code  = p-obj-code
     1421             and buf_parts.artic     = p-artic
     1422             and buf_parts.prod-type = p-prod-type
     1423             and buf_parts.prod-code = p-prod-code
     1424         on error undo, return error
     1425         :
     1426           run partslib-create-temp-parts in this-procedure
     1427             (buffer buf_parts
     1428             ,buffer buf_temp-parts
     1429             ,input  p-goods-twounit
     1430             ) .
     1431           assign
     1432             p-total-parts-qnty        = p-total-parts-qnty
     1433                                       + v-parts-sign * buf_parts.fact-qnty
     1434             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1435                                       + v-parts-sign * buf_parts.fact-qnty
     1436             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1437                                       + v-parts-sign * buf_parts.fact-qnty
     1438             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1439                                       + v-parts-sign * buf_parts.cli-qnty
     1440           .
     1441           if buf_temp-parts.qnty = 0
     1442           then do:
     1443             delete buf_temp-parts .
     1444           end.
     1445         end.
     1446       end.
     1447       else do:
     1448         assign
     1449           p-total-parts-qnty = p-total-parts-qnty
     1450                              + v-parts-sign * buf_doc-line.fact-qnty
     1451         .
     1452       end.
     1453     end.
     1454   end procedure.
     1455   procedure partslib-init-temp-parts-by-date :
     1456     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1457     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1458     define input parameter p-artic           like ub.parts.artic     no-undo .
     1459     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1460     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1461     define input parameter p-fact-date       as date      no-undo .
     1462     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1463     do
     1464     on error undo, return error
     1465     :
     1466       define variable v-fact-order                as decimal   no-undo .
     1467       define variable v-shift-end-fact-order      as decimal   no-undo .
     1468       define variable v-day-end-fact-order        as decimal   no-undo .
     1469       run factord in this-procedure
     1470         (input  p-fact-date
     1471         ,input  1
     1472         ,input  1
     1473         ,input  ?
     1474         ,input  0
     1475         ,input  false
