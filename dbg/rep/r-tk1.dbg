     6140            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     6141            TITLE "Процесс"
     6142            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     6143   define variable mFrameView      as logical   no-undo init yes.
     6144     define variable mFramHandle as handle no-undo.
     6145     mFramHandle = frame InfoFrame:handle.
     6146     if  log-manager:logfile-name ne ?
     6147     then DO:
     6148         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     6149         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     6150         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     6151     end.
     6152     mFrameView = not session:batch-mode and mFramHandle:visible.
     6153     if mFrameView
     6154     then do:
     6155       ASSIGN
     6156          FRAME InfoFrame:HIDDEN                           = TRUE
     6157          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     6158     end.
     6159   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     6160   DO:
     6161     IF not StopProcessing THEN
     6162       Message "Вы действительно хотите прервать" SKIP
     6163               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     6164                 UPDATE StopProcessing.
     6165     IF StopProcessing THEN do:
     6166        if mFrameView
     6167        then do:
     6168           HIDE FRAME InfoFrame.
     6169        end.
     6170     End.
     6171   END.
     6172   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     6173     if  log-manager:logfile-name ne ?
     6174     then DO:
     6175         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     6176     end.
     6177     if not session:batch-mode then
     6178     do:
     6179       VIEW FRAME InfoFrame.
     6180       mFrameView = true.
     6181     end.
     6182      v-button-stop = false .
     6183         if mFrameView
     6184         then do:
     6185         if v-button-stop then view STOPBTN in frame InfoFrame.
     6186                          else Hide STOPBTN in frame InfoFrame.
     6187         end.
     6188   v-ind = 0    .
     6189   FORM with frame teh-card  .
     6190   define variable v-type-goods as character no-undo .
     6191   define variable v-ves        as logical no-undo .
     6192   define buffer buf_init-goods for goods .
     6193   define variable ii as integer no-undo .
     6194   define variable v-se-qnty-brutto   as decimal no-undo .
     6195   define variable v-se-qnty-netto    as decimal no-undo .
     6196   for each recipe no-lock where   recipe.recipe-code    =  p-doc-code  :
     6197    netto20:label = "Вес нетто на " + string(recipe.portion-qnty)  .
     6198         find first buf_init-goods no-lock where
     6199                     buf_init-goods.artic      =  recipe.artic      and
     6200                     buf_init-goods.prod-type  =  recipe.prod-type  and
     6201                     buf_init-goods.prod-code  =  recipe.prod-code no-error .
     6202      run PrintTitul .
     6203         for each recipe-gds no-lock where recipe-gds.recipe-code = recipe.recipe-code
     6204             on error undo, return error :
     6205               FIND goods WHERE goods.prod-type = recipe-gds.prod-type AND
     6206                                goods.prod-code = recipe-gds.prod-code AND
     6207                                goods.artic = recipe-gds.artic NO-LOCK .
     6208                               run get-brutto-netto-seson (
     6209                                input  goods.artic
     6210                               ,input  goods.prod-type
     6211                               ,input  goods.prod-code
     6212                               ,input  recipe-gds.recipe-code
     6213                               ,output  v-se-qnty-brutto
     6214                               ,output  v-se-qnty-netto
     6215                               ) no-error .
     6216                                if error-status :error then
     6217                                message vss-workfile vss-revision vss-description skip
     6218                                   "Ошибка get-brutto-netto-seson  " skip
     6219                                   skip
     6220                                   error-status :get-message(1) skip
     6221                                   return-value skip
     6222                                   view-as alert-box error
     6223                                .
     6224                                brutto   = v-se-qnty-brutto * 1000 .
     6225                                netto    = v-se-qnty-netto * 1000 .
     6226                                netto10  = netto / recipe.portion-qnty  .
     6227                                netto20  = v-se-qnty-netto   .
     6228                                find next temp-str no-error .
     6229                                if available temp-str then do:
     6230                                     str = temp-str.str-1 .
     6231                                     temp-str.pr = true .
     6232                                     end.
     6233                                     else str = "".
     6234               DISPLAY stream OutStream
     6235                               sym1 goods.gds-name
     6236                                           sym2
     6237                               netto when netto <> 0
     6238                               sym3
     6239                               brutto  when brutto <> 0
     6240                               sym4
     6241                               netto10  when netto10 <> 0
     6242                               sym5
     6243                               netto20 when netto20 <> 0
     6244                               sym6
     6245                               str
     6246                               sym6 str
     6247                               sym7
     6248                               with frame teh-card  .
     6249               DOWN stream OutStream 1 with frame teh-card  .
     6250               assign
     6251                 ii =  ii + 1
     6252                 brutto   = 0
     6253                 netto    = 0
     6254                 netto10  = 0
     6255                 netto20  = 0
     6256                 str = ""
     6257              .
     6258         end.
     6259         for each temp-str where temp-str.pr = false  and temp-str.str <> "" and temp-str.str-1 <> ?:
     6260          PUT STREAM OutStream UNFORMATTED ":" + string(temp-str.str-1,"x(60)") + ":"  at 92  format "x(62)"  skip .
     6261         end.
     6262     put stream  OutStream  Line format "X(157)" AT 1 skip(2).
     6263     run print-nutrition in this-procedure ( input recipe.artic
     6264                                           , input recipe.prod-type
     6265                                           , input recipe.prod-code
     6266                                           ) .
     6267     run on-same-page in this-procedure (input 11) .
     6268     run PrintPodval in this-procedure .
     6269        page stream OutStream .
     6270   end.
     6271   HIDE   STREAM OutStream FRAME teh-card .
     6272   HIDE   stream OutStream FRAME BottomFrame .
     6273   HIDE   stream OutStream FRAME BottomFrame2 .
     6274   output stream OutStream CLOSE .
     6275   if mFrameView
     6276   then do:
     6277      HIDE FRAME InfoFrame.
     6278   end.
     6279   define variable g#quest-print  as logical   no-undo .
     6280   define variable g#log as logical   no-undo .
     6281   run get-quest-print in parparentproc ( output g#quest-print ).
     6282     define variable v-user-action as character no-undo .
     6283     define variable v-printed as logical   no-undo .
     6284      if p-type = "recipe":U then
     6285          run gbl/prnfilen.w
     6286            (input  ""
     6287            ,input  8
     6288            ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     6289            ,input  7
     6290            ,output v-user-action
     6291            ,output v-printed
     6292            ) .
     6293      else do:
     6294   if g#quest-print = false
     6295   then do:
     6296     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     6297                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     6298                                         OUTPUT g#log ).
     6299   end.
     6300   else do:
     6301     os-command silent
     6302       value( "COPY /b " +
     6303         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6304         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6305         string( session:temp-directory) +  "$" + string( g#report-num )
     6306                 ) .
     6307     os-command silent
     6308       value( "COPY /b " +
     6309         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     6310         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6311         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6312                 ) .
     6313   end.
     6314      end.
     6315   end.
     6316   procedure PrintTitul :
     6317     do  on error undo, return error return-value  :
     6318    define buffer buf_obj-clients for ub.clients  .
     6319    find first buf_obj-clients no-lock where
     6320         buf_obj-clients.obj-type = v-cntxt-obj-type and
     6321         buf_obj-clients.obj-code = v-cntxt-obj-code no-error .
     6322   PUT STREAM OutStream UNFORMATTED
     6323   CAPS( v-cntxt-host-name-obj )     format "x(30)"  "Рецептура : "        + string ( recipe.recipe-ref-num )  at 60  format "x(60)"  skip
     6324   CAPS( buf_obj-clients.obj-name )  format "x(30)"  "Название блюда   : " + CAPS ( buf_init-goods.gds-name )  at 60  format "x(120)" skip
     6325   .
     6326    PUT STREAM OutStream UNFORMATTED
     6327       skip
     6328       space(50) string( " ТЕХНОЛОГИЧЕСКАЯ КАРТА "   )           skip
     6329         .
     6330    if p-type = "recipe":U then
     6331    PUT STREAM OutStream UNFORMATTED
     6332        "Дата составления " + cur-time-date()   at 120 skip   .
     6333        else
     6334    PUT STREAM OutStream UNFORMATTED
     6335        "Дата составления " + p-type   at 120 skip   .
     6336    define variable v-max as integer no-undo .
     6337    define variable v-max-dop as integer no-undo .
     6338    define variable v as integer no-undo .
     6339     define variable vvv as character no-undo .
     6340    create temp-str .
     6341    temp-str.str-1  = "Описание технологии приготовления :  " .
     6342    temp-str.pr = false  .
     6343    vvv =  recipe.recipe-technique.
     6344    v-max = ( integer (length(vvv) / 60 ) ) .   if (  length(vvv) modulo 60  ) > 0 then  v-max-dop = 1 . else v-max-dop = 0  .  if vvv <> "" then do:      create temp-str .           temp-str.str-1 = substring( vvv , 1 , 60) .      temp-str.pr = false  .      repeat v = 1 to v-max + v-max-dop    :         if substring( vvv , (60 * v ) + 1 , 60) <> "" then do :               create temp-str .                     temp-str.str-1 = substring(vvv , (60 * v) + 1 , 60) .                temp-str.pr = false  .               if temp-str.str-1 = ? then temp-str.str-1 = " " .               temp-str.str-1 = REPLACE (temp-str.str-1 , chr(10) ,chr(32) ) .               end.      end.  end.
     6345    create temp-str .
     6346    temp-str.str-1  = "Показатели качества готовой продукции :  ".
     6347    temp-str.pr = false  .
     6348    vvv =  recipe.recipe-quality.
     6349    v-max = ( integer (length(vvv) / 60 ) ) .   if (  length(vvv) modulo 60  ) > 0 then  v-max-dop = 1 . else v-max-dop = 0  .  if vvv <> "" then do:      create temp-str .           temp-str.str-1 = substring( vvv , 1 , 60) .      temp-str.pr = false  .      repeat v = 1 to v-max + v-max-dop    :         if substring( vvv , (60 * v ) + 1 , 60) <> "" then do :               create temp-str .                     temp-str.str-1 = substring(vvv , (60 * v) + 1 , 60) .                temp-str.pr = false  .               if temp-str.str-1 = ? then temp-str.str-1 = " " .               temp-str.str-1 = REPLACE (temp-str.str-1 , chr(10) ,chr(32) ) .               end.      end.  end.
     6350    create temp-str .
     6351    temp-str.str-1  ="Способ оформления блюда :  " .
     6352    temp-str.pr = false  .
     6353    vvv =  recipe.recipe-design.
     6354    v-max = ( integer (length(vvv) / 60 ) ) .   if (  length(vvv) modulo 60  ) > 0 then  v-max-dop = 1 . else v-max-dop = 0  .  if vvv <> "" then do:      create temp-str .           temp-str.str-1 = substring( vvv , 1 , 60) .      temp-str.pr = false  .      repeat v = 1 to v-max + v-max-dop    :         if substring( vvv , (60 * v ) + 1 , 60) <> "" then do :               create temp-str .                     temp-str.str-1 = substring(vvv , (60 * v) + 1 , 60) .                temp-str.pr = false  .               if temp-str.str-1 = ? then temp-str.str-1 = " " .               temp-str.str-1 = REPLACE (temp-str.str-1 , chr(10) ,chr(32) ) .               end.      end.  end.
     6355     end.
     6356   end procedure.
     6357   procedure PrintPodval :
     6358     do on error undo, return error return-value  :
     6359     define variable pp as integer no-undo .
     6360     define variable rr as integer no-undo .
     6361     PUT  STREAM OutStream
     6362         " Директор _______________________          "
     6363         " Заведующий производством _______________________          "
     6364         " Калькулятор _______________________ " skip
     6365         .
     6366     end.
     6367   end procedure.
     6368   PROCEDURE on-same-page :
     6369     define input parameter p-line-number as integer  no-undo .
     6370     if p-line-number > page-size( OutStream ) then return .
     6371     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     6372   end procedure.
     6373   procedure get-brutto-netto-seson :
     6374    do
     6375    on error undo, return error return-value
     6376    :
     6377   define input parameter p-artic     like  ub.goods.artic      no-undo.
     6378   define input parameter p-prod-type like  ub.goods.prod-type  no-undo.
     6379   define input parameter p-prod-code like  ub.goods.prod-code  no-undo.
     6380   define input parameter p-recipe-code like ub.recipe-gds.recipe-code no-undo.
     6381   define output parameter p-se-qnty as decimal no-undo .
     6382   define output parameter p-se-qnty-netto as decimal no-undo .
     6383   define buffer local-recipe-gds for  ub.recipe-gds  .
     6384   define buffer bf_goods for ub.goods.
     6385   define variable varcoeff as decimal no-undo.
     6386   find first bf_goods no-lock where
     6387             bf_goods.artic     = p-artic and
     6388             bf_goods.prod-type = p-prod-type and
     6389             bf_goods.prod-code = p-prod-code no-error .
     6390   if error-status :error then return error .
     6391   find first local-recipe-gds no-lock where
     6392             local-recipe-gds.recipe-code = p-recipe-code and
     6393             local-recipe-gds.artic       = p-artic and
     6394             local-recipe-gds.prod-type   = p-prod-type and
     6395             local-recipe-gds.prod-code   = p-prod-code no-error .
     6396   if error-status :error then return error .
     6397    varcoeff = 1.
     6398    p-se-qnty =       local-recipe-gds.brutto-qnty * varcoeff.
     6399    p-se-qnty-netto = local-recipe-gds.qnty        * varcoeff.
     6400    define buffer buf_units for ub.units  .
     6401    find first buf_units no-lock where buf_units.unit-name = bf_goods.unit-base no-error .
     6402    if lookup('шту':U, buf_units.type) > 0  or lookup('сер':U, buf_units.type) > 0 then do:
     6403       if bf_goods.wt-base = 0 or bf_goods.wt-base = ? then do:
     6404           p-se-qnty =    0   .
     6405           p-se-qnty-netto = 0 .
     6406       end.
     6407       else do:
     6408           p-se-qnty-netto = bf_goods.wt-base * local-recipe-gds.qnty.
     6409           p-se-qnty       = p-se-qnty-netto + (p-se-qnty-netto * local-recipe-gds.coeff-waste / 100) .
     6410       end.
     6411    end.
     6412    end.
     6413   end procedure.
     6414   procedure print-nutrition :
     6415     define input  parameter p-artic     as character no-undo .
     6416     define input  parameter p-prod-type as character no-undo .
     6417     define input  parameter p-prod-code as integer   no-undo .
     6418     define buffer buf_goods for ub.goods.
     6419     define variable v-calories      as decimal   no-undo .
     6420     define variable v-protein       as decimal   no-undo .
     6421     define variable v-carbohydrate  as decimal   no-undo .
     6422     define variable v-fat           as decimal   no-undo .
     6423   do
     6424   on error undo, return error return-value
     6425   :
     6426     find first buf_goods no-lock
     6427       where buf_goods.artic     = p-artic
     6428         and buf_goods.prod-type = p-prod-type
     6429         and buf_goods.prod-code = p-prod-code
     6430     no-error .
     6431     if not available buf_goods
     6432     then do:
     6433       message
     6434         substitute( "Не найден товар &1 &2 &3"
     6435                   , p-artic
     6436                   , p-prod-type
     6437                   , p-prod-code
     6438                   )
     6439       view-as alert-box error.
     6440       return .
     6441     end.
     6442     run on-same-page in this-procedure (input 9) .
     6443     run nutro_get-nutrition-info in this-procedure ( input  p-artic
     6444                                                    , input  p-prod-type
     6445                                                    , input  p-prod-code
     6446                                                    , input  v-cntxt-obj-type
     6447                                                    , input  v-cntxt-obj-code
     6448                                                    , output v-calories
     6449                                                    , output v-protein
     6450                                                    , output v-carbohydrate
     6451                                                    , output v-fat
     6452                                                    ).
     6453     put stream OutStream
     6454       'Сведения о пищевой и энергетической ценности:':U skip
     6455       'Пищевая и энергетическая ценность на 100 г. готового продукта':U skip
     6456     .
     6457     view frame nutrition-frame.
     6458     display stream OutStream
     6459     v-calories     @ v-tk-calories
     6460     v-protein      @ v-tk-protein
     6461     v-carbohydrate @ v-tk-carbohydrate
     6462     v-fat          @ v-tk-fat
     6463     sym1
     6464     sym2
     6465     sym3
     6466     sym4
     6467     sym5
     6468     with frame nutrition-frame.
     6469     put stream  OutStream  Line format "X(52)" at 1 skip(2).
     6470   end.
     6471   end procedure.
