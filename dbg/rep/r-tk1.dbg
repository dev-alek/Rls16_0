     1801     )  .
     1802   find last buf_curr-accnt no-lock
     1803       where buf_curr-accnt.curr-code = v-base-code
     1804         and buf_curr-accnt.exch-date <= v-today use-index pi
     1805   no-error.
     1806   if not available buf_curr-accnt
     1807   then do:
     1808     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     1809                                     , string(v-today, "99/99/9999")
     1810                                     , v-base-code).
     1811   end.
     1812   run doc-code in this-procedure (
     1813         input  "main"
     1814       , input  p-obj-type
     1815       , input  p-obj-code
     1816       , input  ?
     1817       , output v-doc-code
     1818   ) no-error.
     1819   if error-status:error
     1820   then do:
     1821     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
     1822                                   , chr(10)
     1823                                   , error-status:get-message(1)
     1824                                   , return-value ).
     1825   end.
     1826   run trg/chkdocnm.p (
     1827         input v-doc-code
     1828       , input 'fbr-doc':U
     1829       , input ?
     1830   ) no-error.
     1831   if error-status:error
     1832   then do:
     1833     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     1834                                   , chr(10)
     1835                                   , error-status:get-message(1)
     1836                                   , return-value ).
     1837   end.
     1838   create buf_fbr-doc.
     1839   assign
     1840   buf_fbr-doc.doc-code  = v-doc-code
     1841   buf_fbr-doc.creid     = p-userid
     1842   buf_fbr-doc.doc-date  = v-today
     1843   buf_fbr-doc.doc-type  = 'производство':U
     1844   buf_fbr-doc.host-code = v-host-code
     1845   buf_fbr-doc.obj-code  = p-obj-code
     1846   buf_fbr-doc.obj-type  = p-obj-type
     1847   buf_fbr-doc.PS        = "@"
     1848   buf_fbr-doc.status_   = 'новый':U
     1849   buf_fbr-doc.user-db-num = v-obj-db-num
     1850   buf_fbr-doc.user-name   = p-userid
     1851   .
     1852   run fbrlib_get-default-pay-code in this-procedure (
     1853         input buf_fbr-doc.obj-type
     1854       , input buf_fbr-doc.obj-code
     1855       , output fi-pay-code
     1856   ).
     1857   buf_fbr-doc.pay-code = fi-pay-code.
     1858   p-recid = recid(buf_fbr-doc).
     1859   p-fbr-doc-code = buf_fbr-doc.doc-code.
     1860   end.
     1861   end procedure.
     1862   procedure fbrlib_get-default-pay-code :
     1863   define input parameter p-obj-type   as character        no-undo.
     1864   define input parameter p-obj-code   as integer          no-undo.
     1865   define output parameter p-pay-code  as integer          no-undo.
     1866   define variable v-host-code as integer no-undo .
     1867   define buffer buf_shop          for ub.shop.
     1868   define buffer buf_store         for ub.store.
     1869   define buffer buf_sysconf       for ub.sysconf.
     1870   do
     1871   for buf_shop
     1872     , buf_store
     1873     , buf_sysconf
     1874   on error undo, return error
     1875   :
     1876     case p-obj-type  :
     1877       when 'маг':U then do:
     1878           find first buf_shop no-lock
     1879                 where buf_shop.obj-code = p-obj-code
     1880           no-error.
     1881           if available buf_shop
     1882           then do:
     1883               assign
     1884                   p-pay-code = buf_shop.fbr-pay
     1885               .
     1886           end.
     1887       end.
     1888       when 'скл':U then do:
     1889           find first buf_store no-lock
     1890                 where buf_store.obj-code = p-obj-code
     1891           no-error.
     1892           if available buf_store
     1893           then do:
     1894               assign
     1895                   p-pay-code = buf_store.fbr-pay
     1896               .
     1897           end.
     1898       end.
     1899     end case.
     1900     if p-pay-code = ?
     1901     or p-pay-code = 0
     1902     then do:
     1903   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1904   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1905     (input  p-obj-type
     1906     ,input  p-obj-code
     1907     ,output v-host-code
     1908     )  .
     1909         find first buf_sysconf no-lock
     1910               where buf_sysconf.host-code = v-host-code
     1911         no-error.
     1912         if available buf_sysconf
     1913         then do:
     1914             assign
     1915                 p-pay-code = buf_sysconf.fbr-pay
     1916             .
     1917         end.
     1918     end.
     1919     if p-pay-code = ?
     1920     or p-pay-code = 0
     1921     then do:
     1922   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1923   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1924     (input  p-obj-type
     1925     ,input  p-obj-code
     1926     ,output p-pay-code
     1927     )  .
     1928     end.
     1929   end.
     1930   end procedure.
     1931   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1932   do
     1933   on error undo, return error
     1934   :
     1935   define input parameter p-fbr-doc-code as character    no-undo.
     1936       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1937       define variable v-gds-name      as character    no-undo.
     1938       define buffer buf_fbr-doc               for ub.fbr-doc.
     1939       define buffer buf_fbr-line              for ub.fbr-line.
     1940       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1941       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1942       find first buf_fbr-doc no-lock
     1943            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1944       .
     1945       for each buf_temp_fbrlib_recipe
     1946       :
     1947           delete buf_temp_fbrlib_recipe.
     1948       end.
     1949       for each buf_fbr-line no-lock
     1950          where buf_fbr-line.doc-code = p-fbr-doc-code
     1951       :
     1952           find first buf_temp_fbrlib_recipe
     1953                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1954           no-error.
     1955           if not available buf_temp_fbrlib_recipe
     1956           then do:
     1957               create buf_temp_fbrlib_recipe.
     1958               assign
     1959                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1960                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1961               .
     1962           end.
     1963       end.
     1964       for each buf_temp_fbrlib_recipe
     1965       :
     1966           assign
     1967               buf_temp_fbrlib_recipe.count-income                = 0
     1968               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1969               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1970               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1971               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1972               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1973               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1974               buf_temp_fbrlib_recipe.count-write-off             = 0
     1975               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1976               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1977               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1978               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1979               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1980               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1981           .
     1982           for each buf_fbr-line no-lock
     1983              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1984                and buf_fbr-line.trn-type     = 'при':U
     1985                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1986           :
     1987               if ( buf_fbr-line.price-base   = ?
     1988                   or buf_fbr-line.price-rubl = ?
     1989                   or buf_fbr-line.price-base <= 0
     1990                   or buf_fbr-line.price-rubl <= 0 )
     1991               and buf_fbr-line.fact-qnty <> 0
     1992               and buf_fbr-line.rsrv-qnty <> ?
     1993               and buf_fbr-doc.is-free    = no
     1994               then do:
     1995   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1997     (input  buf_fbr-line.artic
     1998     ,input  buf_fbr-line.prod-type
     1999     ,input  buf_fbr-line.prod-code
     2000     ,output v-gds-name
     2001     ) no-error .
     2002                   if error-status :error
     2003                   then do:
     2004                       assign
     2005                           v-gds-name = ""
     2006                       .
     2007                   end.
     2008                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2009                                                 ,vss-description
     2010                                                 ,buf_fbr-doc.doc-code
     2011                                                 ,chr(10)
     2012                                                 ,buf_fbr-line.recipe-code
     2013                                                 ,buf_fbr-line.artic
     2014                                                 ,v-gds-name).
     2015               end.
     2016               assign
     2017                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     2018                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     2019                                                                   + buf_fbr-line.fact-qnty
     2020                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     2021                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2022               .
     2023               if buf_fbr-line.is-waste = no
     2024               then do:
     2025                   assign
     2026                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     2027                                                                       + buf_fbr-line.price-sum-base
     2028                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2029                                                                       + buf_fbr-line.price-sum-rubl
     2030                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2031                                                                       + buf_fbr-line.price-sum-vat-base
     2032                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2033                                                                       + buf_fbr-line.price-sum-vat-rubl
     2034                   .
     2035               end.
     2036           end.
     2037           for each buf_fbr-line no-lock
     2038              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2039                and buf_fbr-line.trn-type     = 'спи':U
     2040                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2041           :
     2042               if ( buf_fbr-line.price-base   = ?
     2043                   or buf_fbr-line.price-rubl = ?
     2044                   or buf_fbr-line.price-base <= 0
     2045                   or buf_fbr-line.price-rubl <= 0 )
     2046               and buf_fbr-line.fact-qnty <> 0
     2047               and buf_fbr-line.rsrv-qnty <> ?
     2048               and buf_fbr-doc.is-free    = no
     2049               and buf_fbr-doc.status_    = 'разрешен':U
     2050               then do:
     2051   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2052   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2053     (input  buf_fbr-line.artic
     2054     ,input  buf_fbr-line.prod-type
     2055     ,input  buf_fbr-line.prod-code
     2056     ,output v-gds-name
     2057     ) no-error .
     2058                   if error-status :error
     2059                   then do:
     2060                       assign
     2061                           v-gds-name = ""
     2062                       .
     2063                   end.
     2064                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2065                                                 ,vss-description
     2066                                                 ,buf_fbr-doc.doc-code
     2067                                                 ,chr(10)
     2068                                                 ,buf_fbr-line.recipe-code
     2069                                                 ,buf_fbr-line.artic
     2070                                                 ,v-gds-name).
     2071               end.
     2072               assign
     2073                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     2074                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     2075                                                                   + buf_fbr-line.fact-qnty
     2076                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     2077                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2078               .
     2079               if buf_fbr-line.is-waste = no
     2080               then do:
     2081                   assign
     2082                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2083                                                                       + buf_fbr-line.price-sum-base
     2084                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2085                                                                       + buf_fbr-line.price-sum-rubl
     2086                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2087                                                                       + buf_fbr-line.price-sum-vat-base
     2088                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2089                                                                       + buf_fbr-line.price-sum-vat-rubl
     2090                   .
     2091               end.
     2092           end.
     2093           if buf_fbr-doc.status_    = 'разрешен':U
     2094           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     2095           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     2096           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     2097           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     2098               )
     2099           then do:
     2100            undo, return error
     2101               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     2102                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     2103                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     2104                           "Сумма в &9.&4&7&4&4&8&2"
     2105                          , buf_fbr-doc.doc-code
     2106                          , chr(10)
     2107                          , buf_temp_fbrlib_recipe.recipe-code
     2108                          , CHR(9)
     2109                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2110                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     2111                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2112                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2113                          , "руб"
     2114                          )
     2115              +
     2116              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     2117                         "НДС в &7.&1&5&1&1&6&4"
     2118                        ,  CHR(9)
     2119                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2120                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2121                        ,chr(10)
     2122                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2123                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2124                        ,"руб"
     2125                        )       .
     2126           end.
     2127       end.
     2128   end.
     2129   end procedure.
     2130   procedure fbrlib-fill-sum-fbr-doc :
     2131   do
     2132   on error undo, return error
     2133   :
     2134   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2135   define input parameter p-mode           as character    no-undo.
     2136       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2137       define buffer buf_fbr-doc           for ub.fbr-doc.
     2138       define buffer buf_fbr-line          for ub.fbr-line.
     2139       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2140       define variable v-in-count          as integer       no-undo.
     2141       define variable v-out-count         as integer       no-undo.
     2142       find first buf_fbr-doc exclusive-lock
     2143            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2144       .
     2145       find first buf_temp_fbrlib_recipe no-error.
     2146       if not available buf_temp_fbrlib_recipe
     2147       then do:
     2148           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2149               input buf_fbr-doc.doc-code
     2150           ) no-error.
     2151           if error-status :error
     2152           then do:
     2153               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2154                                              , vss-description
     2155                                              , chr(10)
     2156                                              , error-status:get-message(1)
     2157                                              , return-value ).
     2158           end.
     2159       end.
     2160       assign
     2161           v-in-count                  = 0
     2162           buf_fbr-doc.in-qnty         = 0
     2163           buf_fbr-doc.in-sale         = 0
     2164           buf_fbr-doc.in-base         = 0
     2165           buf_fbr-doc.in-rubl         = 0
     2166           buf_fbr-doc.in-vat-base     = 0
     2167           buf_fbr-doc.in-vat-rubl     = 0
     2168           v-out-count                 = 0
     2169           buf_fbr-doc.out-qnty        = 0
     2170           buf_fbr-doc.out-sale        = 0
     2171           buf_fbr-doc.out-base        = 0
     2172           buf_fbr-doc.out-rubl        = 0
     2173           buf_fbr-doc.out-vat-base    = 0
     2174           buf_fbr-doc.out-vat-rubl    = 0
     2175       .
     2176       for each buf_temp_fbrlib_recipe
     2177       :
     2178           assign
     2179               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2180               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2181               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2182               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2183               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2184               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2185               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2186               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2187               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2188               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2189               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2190               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2191               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2192               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2193           .
     2194       end.
     2195       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2196       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2197       or p-mode <> 'факт':U
     2198       then do:
     2199           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2200           then do:
     2201               assign
     2202                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2203                                   + string( v-out-count, ">>>,>>9" )
     2204                                   + chr(10) + "Строк исходных товаров : "
     2205                                   + string( v-in-count, ">>>,>>9" )
     2206               .
     2207           end.
     2208       end.
     2209       else do:
     2210         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2211                                       "Сумма списанных товаров в &3 - &4&2" +
     2212                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2213                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2214                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2215                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2216                                       , buf_fbr-doc.doc-code
     2217                                       , chr(10)
     2218                                       , "рублях"
     2219                                       , round( buf_fbr-doc.out-rubl, 2 )
     2220                                       , round( buf_fbr-doc.in-rubl,  2 )
     2221                                       , round( buf_fbr-doc.in-rubl,  2 )
     2222                                       , round( buf_fbr-doc.out-base, 2 )
     2223                                       , round( buf_fbr-doc.in-base,  2 )).
     2224       end.
     2225   end.
     2226   end procedure.
     2227   procedure fbrlib-calc-prices :
     2228   do
     2229   on error undo, return error
     2230   :
     2231   define input parameter p-fbr-line-recid as recid        no-undo.
     2232   define input parameter p-price-obj-type as character    no-undo.
     2233   define input parameter p-price-obj-code as integer      no-undo.
     2234   define output parameter p-current-price as decimal      no-undo.
     2235       define variable v-void          as decimal       no-undo.
     2236       define variable v-void-char     as character     no-undo.
     2237       define variable v-gds-code      as integer       no-undo.
     2238       define variable v-b-code        as integer       no-undo.
     2239       define buffer buf_fbr-doc   for ub.fbr-doc.
     2240       define buffer buf_fbr-line  for ub.fbr-line.
     2241       define buffer buf_gds-prt   for ub.gds-prt.
     2242       define buffer buf_bar-code  for ub.bar-code.
     2243       find first buf_fbr-line no-lock
     2244           where recid( buf_fbr-line ) = p-fbr-line-recid
     2245       .
     2246   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2247   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2248     (input  buf_fbr-line.artic
     2249     ,input  buf_fbr-line.prod-type
     2250     ,input  buf_fbr-line.prod-code
     2251     ,output v-gds-code
     2252     ) no-error .
     2253       if error-status :error
     2254       then do:
     2255         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2256                                         ,vss-workfile
     2257                                         ,vss-revision
     2258                                         ,vss-description
     2259                                         ,chr(10)
     2260                                         , error-status:get-message(1)
     2261                                         , return-value
     2262                                         , buf_fbr-line.artic
     2263                                         ).
     2264       end.
     2265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2266     (input  v-gds-code
     2267     ,input  ?
     2268     ,output v-b-code
     2269     ) no-error .
     2270       if error-status :error
     2271       then do:
     2272         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2273                                         ,vss-workfile
     2274                                         ,vss-revision
     2275                                         ,vss-description
     2276                                         ,chr(10)
     2277                                         , error-status:get-message(1)
     2278                                         , return-value
     2279                                         , v-gds-code
     2280                                         ).
     2281       end.
     2282       if buf_fbr-line.is-calc = no
     2283       then do:
     2284   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2285   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2286     (input  p-price-obj-type
     2287     ,input  p-price-obj-code
     2288     ,input  v-b-code
     2289     ,input  0
     2290     ,input  0
     2291     ,output v-void-char
     2292     ,output p-current-price
     2293     ,output v-void
     2294     ,output v-void
     2295     ) no-error .
     2296           if error-status :error
     2297           then do:
     2298             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2299                                             ,vss-workfile
     2300                                             ,vss-revision
     2301                                             ,vss-description
     2302                                             ,chr(10)
     2303                                             , error-status:get-message(1)
     2304                                             , return-value
     2305                                             , v-gds-code
     2306                                             ).
     2307           end.
     2308       end.
     2309       else do:
     2310           assign
     2311               p-current-price = buf_fbr-line.price-sale
     2312           .
     2313       end.
     2314   end.
     2315   end procedure.
     2316   procedure fbrlib-put-in-order-recipe :
     2317   do
     2318   on error undo, return error
     2319   :
     2320   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2321       define variable v-recipe-counter    as integer          no-undo.
     2322       define variable v-recipe-amount     as integer init 0   no-undo.
     2323       define variable v-child-counter     as integer          no-undo.
     2324       define variable v-is-call-cycle     as logical          no-undo.
     2325       define variable v-str as character     no-undo.
     2326       define buffer buf_in_fbr-line       for ub.fbr-line.
     2327       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2328       define buffer buf_fbr-line          for ub.fbr-line.
     2329       define buffer buf_recipe-gds        for ub.recipe-gds.
     2330       define buffer buf_recipe            for ub.recipe.
     2331       for each temp_recipe-childs-qnty
     2332       :
     2333           delete temp_recipe-childs-qnty.
     2334       end.
     2335       for each temp_recipe-childs
     2336       :
     2337           delete temp_recipe-childs.
     2338       end.
     2339       for each temp_recipe-order
     2340       :
     2341           delete temp_recipe-order.
     2342       end.
     2343       for each buf_fbr-line no-lock
     2344          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2345       on error undo, return error
     2346       :
     2347           find first temp_recipe-childs-qnty
     2348                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2349           no-error.
     2350           if not available temp_recipe-childs-qnty
     2351           then do:
     2352               create temp_recipe-childs-qnty.
     2353               assign
     2354                   v-recipe-amount                     = v-recipe-amount + 1
     2355                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2356                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2357                   temp_recipe-childs-qnty.childs-qnty = 0
     2358                   v-child-counter                     = 0
     2359               .
     2360           end.
     2361       end.
     2362       for each buf_in_fbr-line no-lock
     2363          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2364            and buf_in_fbr-line.trn-type = 'спи':U
     2365       on error undo, return error
     2366       :
     2367           for each buf_dress_fbr-line no-lock
     2368              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2369                and buf_dress_fbr-line.trn-type    = 'при':U
     2370                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2371                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2372                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2373           on error undo, return error
     2374           :
     2375               find first buf_recipe no-lock
     2376                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2377               .
     2378               if buf_in_fbr-line.is-comp = yes
     2379               then do:
     2380                   find last temp_recipe-childs-qnty
     2381                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2382                   .
     2383                   assign
     2384                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2385                   .
     2386                   create temp_recipe-childs.
     2387                   assign
     2388                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2389                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2390                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2391                   .
     2392               end.
     2393               else do:
     2394               end.
     2395           end.
     2396       end.
     2397       for each buf_in_fbr-line no-lock
     2398          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2399            and buf_in_fbr-line.trn-type = 'при':U
     2400       on error undo, return error
     2401       :
     2402           find first buf_recipe no-lock
     2403                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2404           no-error.
     2405           if buf_in_fbr-line.is-comp = no
     2406           then do:
     2407           end.
     2408           else do:
     2409               for each buf_recipe-gds no-lock
     2410               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2411               :
     2412                   for each buf_fbr-line no-lock
     2413                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2414                       and buf_fbr-line.trn-type    = 'при':U
     2415                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2416                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2417                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2418                   on error undo, return error
     2419                   :
     2420                       find first buf_recipe no-lock
     2421                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2422                       .
     2423                       if buf_recipe.recipe-type = 'разделка':U
     2424                       then do:
     2425                       end.
     2426                       else do:
     2427                           find last temp_recipe-childs-qnty
     2428                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2429                           .
     2430                           assign
     2431                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2432                           .
     2433                           create temp_recipe-childs.
     2434                           assign
     2435                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2436                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2437                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2438                           .
     2439                       end.
     2440                   end.
     2441               end.
     2442           end.
     2443       end.
     2444       for each temp_recipe-order
     2445       on error undo, return error
     2446       :
     2447           delete temp_recipe-order.
     2448       end.
     2449       assign
     2450           v-fbrlib-recipe-order = 0
     2451       .
     2452       do v-recipe-counter = 1 to v-recipe-amount
     2453       on error undo, return error
     2454       :
     2455           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2456                 input v-recipe-counter
     2457               , input 0
     2458               , output v-is-call-cycle
     2459           ).
     2460           if v-is-call-cycle = yes
     2461           then do:
     2462               message
     2463                       "Достигнут максимальный уровень вложенности рецептов."
     2464                   skip(1)
     2465                   skip "Невозможно упорядочить рецепты."
     2466                   skip(1)
     2467                   skip "Необходимо изменить структуру рецептов,"
     2468                   skip "используемых при формировании"
     2469                   skip "данного документа производства."
     2470               view-as alert-box error
     2471               title "Невозможно рассчитать документ производства".
     2472               for each temp_recipe-childs-qnty
     2473               :
     2474                   delete temp_recipe-childs-qnty.
     2475               end.
     2476               for each temp_recipe-childs
     2477               :
     2478                   delete temp_recipe-childs.
     2479               end.
     2480               for each temp_recipe-order
     2481               :
     2482                   delete temp_recipe-order.
     2483               end.
     2484               for each temp_recipe-order
     2485               on error undo, return error
     2486               :
     2487                   delete temp_recipe-order.
     2488               end.
     2489               for each temp_fbrlib_recipe
     2490               on error undo, return error
     2491               :
     2492                   delete temp_recipe-order.
     2493               end.
     2494               undo, return error.
     2495           end.
     2496       end.
     2497   end.
     2498   end procedure.
     2499   procedure fbrlib-add-recipe-in-tmp-order :
     2500   do
     2501   on error undo, return error
     2502   :
     2503   define input parameter p-order              as integer      no-undo.
     2504   define input parameter p-call-counter       as integer      no-undo.
     2505   define output parameter p-is-call-cycle     as logical      no-undo.
     2506       define variable v-nodes-counter     as integer       no-undo.
     2507       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2508       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2509       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2510       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2511       assign
     2512           p-call-counter = p-call-counter + 1
     2513       .
     2514       if p-call-counter > 50
     2515       then do:
     2516           assign
     2517               p-is-call-cycle = yes
     2518           .
     2519       end.
     2520       else do:
     2521           find first buf_temp_recipe-childs-qnty
     2522                where buf_temp_recipe-childs-qnty.order = p-order
     2523           .
     2524           find first buf_temp_recipe-order
     2525                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2526           no-error.
     2527           if not available buf_temp_recipe-order
     2528           then do:
     2529               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2530               :
     2531                   find first buf_temp_recipe-childs
     2532                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2533                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2534                   .
     2535                   find first buf_c_temp_recipe-childs-qnty
     2536                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2537                   .
     2538                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2539                         input buf_c_temp_recipe-childs-qnty.order
     2540                       , input p-call-counter
     2541                       , output p-is-call-cycle
     2542                   ).
     2543                   if p-is-call-cycle = yes
     2544                   then do:
     2545                       return.
     2546                   end.
     2547               end.
     2548               assign
     2549                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2550               .
     2551               create buf_temp_recipe-order.
     2552               assign
     2553                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2554                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2555               .
     2556           end.
     2557       end.
     2558   end.
     2559   end procedure.
     2560   procedure fbrlib-get-trn-type :
     2561   define input parameter p-recipe-code    as character    no-undo.
     2562   define input parameter p-goods-recid    as recid        no-undo.
     2563   define input parameter p-is-integration as logical      no-undo.
     2564   define output parameter p-is-comp       as logical      no-undo.
     2565   define output parameter p-trn-type      as character    no-undo.
     2566   define buffer buf_recipe    for ub.recipe.
     2567   define buffer buf_goods     for ub.goods.
     2568   do
     2569   for buf_recipe
     2570     , buf_goods
     2571   on error undo, return error
     2572   :
     2573       find first buf_goods no-lock
     2574            where recid( buf_goods ) = p-goods-recid
     2575       .
     2576       find first buf_recipe no-lock
     2577            where buf_recipe.recipe-code = p-recipe-code
     2578       no-error.
     2579       if not available buf_recipe
     2580       then do:
     2581           assign
     2582               p-is-comp = no
     2583               p-trn-type = "":U
     2584           .
     2585           undo, return.
     2586       end.
     2587       if  buf_recipe.artic        = buf_goods.artic
     2588       and buf_recipe.prod-type    = buf_goods.prod-type
     2589       and buf_recipe.prod-code    = buf_goods.prod-code
     2590       then do:
     2591           assign
     2592               p-is-comp = yes
     2593           .
     2594       end.
     2595       else do:
     2596           assign
     2597               p-is-comp = no
     2598           .
     2599       end.
     2600       case buf_recipe.recipe-type
     2601       :
     2602           when 'производство':U
     2603           then do:
     2604               if p-is-comp = yes
     2605               then do:
     2606                   assign
     2607                       p-trn-type = 'при':U
     2608                   .
     2609               end.
     2610               else do:
     2611                   assign
     2612                       p-trn-type = 'спи':U
     2613                   .
     2614               end.
     2615           end.
     2616           when 'альтернатива':U
     2617           then do:
     2618               if p-is-comp = yes
     2619               then do:
     2620                   assign
     2621                       p-trn-type = 'при':U
     2622                   .
     2623               end.
     2624               else do:
     2625                   assign
     2626                       p-trn-type = 'спи':U
     2627                   .
     2628               end.
     2629           end.
     2630           when 'разделка':U
     2631           then do:
     2632               if p-is-comp = no
     2633               then do:
     2634                   assign
     2635                       p-trn-type = 'при':U
     2636                   .
     2637               end.
     2638               else do:
     2639                   assign
     2640                       p-trn-type = 'спи':U
     2641                   .
     2642               end.
     2643           end.
     2644           when 'комплектация':U
     2645           then do:
     2646               if p-is-integration = ?
     2647               then do:
     2648                   message
     2649                       "Выберите тип операции по рецепту комплектации:"
     2650                       skip (2) "YES - комплектация"
     2651                       skip     "NO - разукомплектация"
     2652                   view-as alert-box question
     2653                   buttons YES-NO
     2654                   update p-is-integration.
     2655               end.
     2656               if p-is-integration = yes
     2657               then do:
     2658                   if p-is-comp = yes
     2659                   then do:
     2660                       assign
     2661                           p-trn-type = 'при':U
     2662                       .
     2663                   end.
     2664                   else do:
     2665                       assign
     2666                           p-trn-type = 'спи':U
     2667                       .
     2668                   end.
     2669               end.
     2670               else do:
     2671                   if p-is-comp = yes
     2672                   then do:
     2673                       assign
     2674                           p-trn-type = 'спи':U
     2675                       .
     2676                   end.
     2677                   else do:
     2678                       assign
     2679                           p-trn-type = 'при':U
     2680                       .
     2681                   end.
     2682               end.
     2683           end.
     2684       end case.
     2685   end.
     2686   end procedure.
     2687   procedure fbrlib-get-mark :
     2688   define input parameter p-recipe-code    as character    no-undo.
     2689   define output parameter p-mark          as logical    no-undo.
     2690   define buffer buf_goods-attr     for ub.goods-attr.
     2691   define buffer buf_recipe-gds for ub.recipe-gds .
     2692       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2693            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2694                                               buf_goods-attr.attr-code = 'mark-type':U:
     2695            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2696               p-mark = true .
     2697               return .
     2698            end.
     2699       end.
     2700   end procedure.
     2701   procedure fbrlib-check-temp-tables :
     2702   do
     2703   on error undo, return error
     2704   :
     2705   define input parameter p-title  as character    no-undo.
     2706       define variable v-str               as character        no-undo.
     2707       assign
     2708           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2709       .
     2710       for each temp_recipe-childs-qnty
     2711       on error undo, return error
     2712       :
     2713           assign
     2714               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2715                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2716                       + "   " + string( temp_recipe-childs-qnty.order )
     2717                       + chr(10)
     2718           .
     2719       end.
     2720       assign
     2721           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2722       .
     2723       for each temp_recipe-childs
     2724       on error undo, return error
     2725       :
     2726           assign
     2727               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2728                       + "   " + string( temp_recipe-childs.child-code )
     2729                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2730                       + chr(10)
     2731           .
     2732       end.
     2733       assign
     2734           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2735       .
     2736       for each temp_recipe-order
     2737       on error undo, return error
     2738       :
     2739           assign
     2740               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2741                       + "   " + string( temp_recipe-order.order )
     2742                       + chr(10)
     2743           .
     2744       end.
     2745       assign
     2746           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2747       .
     2748       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2749       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2750       for each temp_fbrlib_recipe
     2751       on error undo, return error
     2752       :
     2753           assign
     2754               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2755                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2756                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2757                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2758                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2759                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2760                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2761                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2762                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2763                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2764                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2765                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2766                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2767                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2768                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2769                       + chr(10)
     2770           .
     2771           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2772       end.
     2773   end.
     2774   end procedure.
     2775   procedure fbrlib-s-coeff-value :
     2776   define input  parameter p-gds-code    as integer        no-undo.
     2777   define input  parameter p-date        as date           no-undo.
     2778   define input  parameter p-obj-type    as character      no-undo.
     2779   define input  parameter p-obj-code    as integer        no-undo.
     2780   define output parameter p-coeff-value as decimal        no-undo.
     2781   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2782       define variable v-date          as date         no-undo.
     2783       define variable v-host-code     as integer      no-undo.
     2784       define buffer buf_goods       for ub.goods.
     2785       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2786       define buffer buf_clients     for ub.clients.
     2787       define buffer buf_s-coeff     for ub.s-coeff.
     2788   do
     2789   for buf_goods
     2790     , buf_fbr-gds-obj
     2791     , buf_clients
     2792     , buf_s-coeff
     2793   on error undo, return error return-value
     2794   :
     2795       find first buf_goods no-lock
     2796            where buf_goods.gds-code = p-gds-code
     2797       no-error .
     2798       if not available buf_goods
     2799       then do:
     2800          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2801       end.
     2802       find first buf_clients no-lock
     2803            where buf_clients.obj-type = p-obj-type
     2804              and buf_clients.obj-code = p-obj-code
     2805       no-error.
     2806       if not available buf_clients
     2807       then do:
     2808          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2809       end.
     2810       assign
     2811           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2812       .
     2813       find first buf_fbr-gds-obj no-lock
     2814            where buf_fbr-gds-obj.gds-code = p-gds-code
     2815              and buf_fbr-gds-obj.obj-type = p-obj-type
     2816              and buf_fbr-gds-obj.obj-code = p-obj-code
     2817       no-error.
     2818       if not available buf_fbr-gds-obj
     2819       or buf_fbr-gds-obj.is-season = no
     2820       then do:
     2821           assign
     2822               p-coeff-value = 0
     2823           .
     2824           return.
     2825       end.
     2826   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2827   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2828     (input  p-obj-type
     2829     ,input  p-obj-code
     2830     ,output v-host-code
     2831     )  .
     2832       find last buf_s-coeff no-lock
     2833           where buf_s-coeff.gds-code = p-gds-code
     2834             and buf_s-coeff.host-code = v-host-code
     2835             and buf_s-coeff.obj-type = p-obj-type
     2836             and buf_s-coeff.obj-code = p-obj-code
     2837             and buf_s-coeff.s-date <= v-date
     2838       no-error.
     2839       if available buf_s-coeff
     2840       then do:
     2841           assign
     2842               p-coeff-value = buf_s-coeff.coeff-value
     2843           .
     2844           return.
     2845       end.
     2846       find last buf_s-coeff no-lock
     2847           where buf_s-coeff.gds-code = p-gds-code
     2848             and buf_s-coeff.host-code = v-host-code
     2849             and buf_s-coeff.obj-type = "":U
     2850             and buf_s-coeff.obj-code = 0
     2851             and buf_s-coeff.s-date <= v-date
     2852       no-error.
     2853       if available buf_s-coeff
     2854       then do:
     2855           assign
     2856               p-coeff-value = buf_s-coeff.coeff-value
     2857           .
     2858           return.
     2859       end.
     2860       find last buf_s-coeff no-lock
     2861           where buf_s-coeff.gds-code = p-gds-code
     2862             and buf_s-coeff.host-code = 0
     2863             and buf_s-coeff.obj-type = "":U
     2864             and buf_s-coeff.obj-code = 0
     2865             and buf_s-coeff.s-date <= v-date
     2866       no-error.
     2867       if available buf_s-coeff
     2868       then do:
     2869           assign
     2870               p-coeff-value = buf_s-coeff.coeff-value
     2871           .
     2872       end.
     2873       else do:
     2874           assign
     2875               p-coeff-value = 0
     2876           .
     2877       end.
     2878   end.
     2879   end procedure.
     2880   procedure fbrlib_create-fbr-recipe-gds :
     2881   define input parameter p-doc-code         as character      no-undo.
     2882   define input parameter p-recipe-code      as character      no-undo.
     2883   define input parameter p-prod-type        as character      no-undo.
     2884   define input parameter p-prod-code        as integer        no-undo.
     2885   define input parameter p-artic            as character      no-undo.
     2886   define input parameter p-gds-code         as integer        no-undo.
     2887   define input parameter p-is-waste         as logical        no-undo.
     2888   define input parameter p-proc-number      as integer        no-undo.
     2889   define input parameter p-obj-date         as date           no-undo.
     2890   define input parameter p-obj-type         as character      no-undo.
     2891   define input parameter p-obj-code         as integer        no-undo.
     2892   define input parameter p-calc-method      as decimal        no-undo.
     2893   define input parameter p-coeff-waste      as decimal        no-undo.
     2894   define input parameter p-orig-qnty        as decimal        no-undo.
     2895   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2896       define variable v-coeff-season  as decimal      no-undo.
     2897       define variable v-void-decimal  as decimal      no-undo.
     2898       define variable v-void-integer  as integer      no-undo.
     2899       define variable v-recipe-type   as character    no-undo.
     2900       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2901       define buffer buf_goods             for ub.goods.
     2902       define buffer buf_recipe            for ub.recipe.
     2903   do
     2904   for buf_fbr-recipe-gds
     2905     , buf_recipe
     2906     , buf_goods
     2907   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2908   :
     2909       find first buf_fbr-recipe-gds exclusive-lock
     2910            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2911              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2912              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2913              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2914              and buf_fbr-recipe-gds.artic       = p-artic
     2915       no-error.
     2916       if not available buf_fbr-recipe-gds
     2917       then do:
     2918           create buf_fbr-recipe-gds.
     2919           assign
     2920               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2921               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2922               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2923               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2924               buf_fbr-recipe-gds.artic              = p-artic
     2925               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2926               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2927               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2928               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2929               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2930           .
     2931           find first buf_goods no-lock
     2932                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2933                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2934                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2935           .
     2936           run fbrlib-s-coeff-value in this-procedure (
     2937                 input buf_goods.gds-code
     2938               , input p-obj-date
     2939               , input p-obj-type
     2940               , input p-obj-code
     2941               , output v-coeff-season
     2942           ) no-error.
     2943           if error-status:error
     2944           then do:
     2945               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2946           end.
     2947           assign
     2948               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2949               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2950               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2951           .
     2952           run fbrlib-get-recipe-type in this-procedure (
     2953                 input buf_fbr-recipe-gds.doc-code
     2954               , input buf_fbr-recipe-gds.recipe-code
     2955               , output v-recipe-type
     2956           ).
     2957           if v-recipe-type <> 'производство':U
     2958           then do:
     2959               assign
     2960                   buf_fbr-recipe-gds.coeff-value  = 0
     2961                   buf_fbr-recipe-gds.coeff-waste  = 0
     2962                   buf_fbr-recipe-gds.calc-method  = 1
     2963                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2964               .
     2965           end.
     2966           else do:
     2967               run fbrlib-calc-brutto in this-procedure (
     2968                     input v-recipe-type
     2969                   , input buf_fbr-recipe-gds.qnty
     2970                   , input buf_fbr-recipe-gds.coeff-value
     2971                   , input buf_fbr-recipe-gds.coeff-waste
     2972                   , input 0
     2973                   , input 3
     2974                   , output v-void-decimal
     2975                   , output v-void-decimal
     2976                   , output buf_fbr-recipe-gds.brutto-qnty
     2977                   , output v-void-integer
     2978               ).
     2979               assign
     2980                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2981               .
     2982               run fbrlib-calc-brutto in this-procedure (
     2983                     input v-recipe-type
     2984                   , input buf_fbr-recipe-gds.qnty
     2985                   , input buf_fbr-recipe-gds.coeff-value
     2986                   , input buf_fbr-recipe-gds.coeff-waste
     2987                   , input buf_fbr-recipe-gds.brutto-qnty
     2988                   , input buf_fbr-recipe-gds.calc-method
     2989                   , output buf_fbr-recipe-gds.qnty
     2990                   , output v-void-decimal
     2991                   , output v-void-decimal
     2992                   , output v-void-integer
     2993               ).
     2994           end.
     2995       end.
     2996   end.
     2997   end procedure.
     2998   procedure fbrlib-set-default-recipe :
     2999   define input parameter p-obj-type   as character    no-undo.
     3000   define input parameter p-obj-code   as integer      no-undo.
     3001   define input parameter p-gds-code   as integer      no-undo.
     3002       define variable v-artic             as character    no-undo.
     3003       define variable v-prod-type         as character    no-undo.
     3004       define variable v-prod-code         as character    no-undo.
     3005       define variable v-recipe-code       as character    no-undo.
     3006       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3007       define variable v-recipe-found      as logical      no-undo.
     3008       define buffer buf_recipe        for ub.recipe.
     3009       define buffer buf_other_recipe  for ub.recipe.
     3010       define buffer buf_goods         for ub.goods.
     3011       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3012   do
     3013   for buf_recipe
     3014     , buf_goods
     3015     , buf_fbr-gds-obj
     3016   on error undo, return error
     3017   :
     3018       find first buf_goods no-lock
     3019            where buf_goods.gds-code = p-gds-code
     3020       .
     3021       run fbrlib-get-obj-recipe in this-procedure (
     3022             input p-obj-type
     3023           , input p-obj-code
     3024           , input p-gds-code
     3025           , output v-recipe-code
     3026       ).
     3027       if v-recipe-code <> ""
     3028       then do:
     3029           find first buf_recipe no-lock
     3030               where buf_recipe.recipe-code = v-recipe-code
     3031           no-error.
     3032           if not available buf_recipe
     3033           then do:
     3034               assign
     3035                   v-recipe-code = ""
     3036               .
     3037           end.
     3038       end.
     3039       if v-recipe-code = ""
     3040       then do:
     3041           find first buf_fbr-gds-obj exclusive-lock
     3042                where buf_fbr-gds-obj.obj-type = p-obj-type
     3043                  and buf_fbr-gds-obj.obj-code = p-obj-code
     3044                  and buf_fbr-gds-obj.gds-code = p-gds-code
     3045           no-error.
     3046           if not available buf_fbr-gds-obj
     3047           then do:
     3048               run ref/fgdsobj1.p (
     3049                     input-output v-fbr-gds-obj-recid
     3050                   , input 'ДОБАВЛЕНИЕ':U
     3051                   , input no
     3052                   , input p-gds-code
     3053                   , input p-obj-type
     3054                   , input p-obj-code
     3055                   , input 0
     3056                   , input ""
     3057                   , input 0
     3058                   , input no
     3059                   , input no
     3060                   , input no
     3061                   , input no
     3062                   , input no
     3063                   , input no
     3064               ) no-error.
     3065               if error-status:error
     3066               then do:
     3067                   message
     3068                           vss-workfile vss-revision vss-description
     3069                       skip "Ошибка изменения атрибутов товара на объекте"
     3070                       skip return-value
     3071                       skip trim(error-status :get-message(1))
     3072                               trim(error-status :get-message(2))
     3073                               trim(error-status :get-message(3))
     3074                   view-as alert-box error.
     3075                   undo, return error .
     3076               end.
     3077               find first buf_fbr-gds-obj exclusive-lock
     3078                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     3079               .
     3080           end.
     3081           assign
     3082               v-recipe-found = no
     3083           .
     3084           for first buf_recipe no-lock
     3085               where buf_recipe.obj-type    = p-obj-type
     3086                 and buf_recipe.obj-code    = p-obj-code
     3087                 and buf_recipe.artic       = buf_goods.artic
     3088                 and buf_recipe.prod-type   = buf_goods.prod-type
     3089                 and buf_recipe.prod-code   = buf_goods.prod-code
     3090                 and buf_recipe.recipe-type = 'производство':U
     3091                 or (
     3092                     buf_recipe.obj-type    = ""
     3093                 and buf_recipe.obj-code    = 0
     3094                 and buf_recipe.artic       = buf_goods.artic
     3095                 and buf_recipe.prod-type   = buf_goods.prod-type
     3096                 and buf_recipe.prod-code   = buf_goods.prod-code
     3097                 and buf_recipe.recipe-type = 'производство':U
     3098                     )
     3099           :
     3100               assign
     3101                   v-recipe-found = yes
     3102                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3103               .
     3104           end.
     3105           if v-recipe-found = no
     3106           then do:
     3107               for first buf_recipe no-lock
     3108                   where buf_recipe.obj-type    = p-obj-type
     3109                     and buf_recipe.obj-code    = p-obj-code
     3110                     and buf_recipe.artic       = buf_goods.artic
     3111                     and buf_recipe.prod-type   = buf_goods.prod-type
     3112                     and buf_recipe.prod-code   = buf_goods.prod-code
     3113                     and buf_recipe.recipe-type <> 'альтернатива':U
     3114                     or (
     3115                         buf_recipe.obj-type    = ""
     3116                     and buf_recipe.obj-code    = 0
     3117                     and buf_recipe.artic       = buf_goods.artic
     3118                     and buf_recipe.prod-type   = buf_goods.prod-type
     3119                     and buf_recipe.prod-code   = buf_goods.prod-code
     3120                     and buf_recipe.recipe-type <> 'альтернатива':U
     3121                         )
     3122               :
     3123                   assign
     3124                       v-recipe-found = yes
     3125                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3126                   .
     3127               end.
     3128               if v-recipe-found = no
     3129               then do:
     3130                   for first buf_recipe no-lock
     3131                       where buf_recipe.obj-type    = p-obj-type
     3132                         and buf_recipe.obj-code    = p-obj-code
     3133                         and buf_recipe.artic       = buf_goods.artic
     3134                         and buf_recipe.prod-type   = buf_goods.prod-type
     3135                         and buf_recipe.prod-code   = buf_goods.prod-code
     3136                         or (
     3137                             buf_recipe.obj-type    = ""
     3138                         and buf_recipe.obj-code    = 0
     3139                         and buf_recipe.artic       = buf_goods.artic
     3140                         and buf_recipe.prod-type   = buf_goods.prod-type
     3141                         and buf_recipe.prod-code   = buf_goods.prod-code
     3142                             )
     3143                   :
     3144                       assign
     3145                           v-recipe-found = yes
     3146                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3147                       .
     3148                   end.
     3149                   if v-recipe-found = no
     3150                   then do:
     3151                       assign
     3152                           buf_fbr-gds-obj.default-recipe-code = ""
     3153                       .
     3154                   end.
     3155               end.
     3156           end.
     3157       end.
     3158   end.
     3159   end procedure.
     3160   procedure fbrlib-get-obj-recipe :
     3161   define input parameter p-obj-type       as character    no-undo.
     3162   define input parameter p-obj-code       as integer      no-undo.
     3163   define input parameter p-gds-code       as integer      no-undo.
     3164   define output parameter p-recipe-code   as character    no-undo.
     3165       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3166   do
     3167   for buf_fbr-gds-obj
     3168   on error undo, return error
     3169   :
     3170       find first buf_fbr-gds-obj no-lock
     3171            where buf_fbr-gds-obj.obj-type = p-obj-type
     3172              and buf_fbr-gds-obj.obj-code = p-obj-code
     3173              and buf_fbr-gds-obj.gds-code = p-gds-code
     3174       no-error.
     3175       if available buf_fbr-gds-obj
     3176       then do:
     3177           assign
     3178               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3179           .
     3180       end.
     3181       else do:
     3182           assign
     3183               p-recipe-code = ""
     3184           .
     3185       end.
     3186   end.
     3187   end procedure.
     3188   procedure fbrlib-create-or-update-recipe-gds :
     3189   define input parameter p-recipe-code    as character        no-undo.
     3190   define input parameter p-gds-code       as integer          no-undo.
     3191   define input parameter p-is-waste       as logical          no-undo.
     3192   define input parameter p-qnty           as decimal          no-undo.
     3193   define input parameter p-proc-number    as integer          no-undo.
     3194   define input parameter p-nws-self       as logical          no-undo.
     3195       define variable v-max-proc-num  as integer      no-undo.
     3196       define variable v-recipe-type   as character    no-undo.
     3197       define buffer buf_goods             for ub.goods.
     3198       define buffer buf_recipe-gds        for ub.recipe-gds.
     3199       define buffer buf_recipe            for ub.recipe.
     3200       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3201   do
     3202   for buf_goods
     3203     , buf_recipe-gds
     3204     , buf_recipe
     3205     , buf_proc_recipe-gds
     3206   on error undo, return error
     3207   :
     3208       find first buf_recipe no-lock
     3209            where buf_recipe.recipe-code = p-recipe-code
     3210       .
     3211       find first buf_goods no-lock
     3212            where buf_goods.gds-code = p-gds-code
     3213       .
     3214       find first buf_recipe-gds
     3215            where buf_recipe-gds.recipe-code = p-recipe-code
     3216              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3217              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3218              and buf_recipe-gds.artic       = buf_goods.artic
     3219       no-error.
     3220       if not available buf_recipe-gds
     3221       then do:
     3222           create buf_recipe-gds.
     3223           assign
     3224               buf_recipe-gds.recipe-code = p-recipe-code
     3225               buf_recipe-gds.gds-code    = p-gds-code
     3226               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3227               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3228               buf_recipe-gds.artic       = buf_goods.artic
     3229           .
     3230           assign
     3231               buf_recipe-gds.is-waste    = no
     3232               buf_recipe-gds.qnty        = 0
     3233               buf_recipe-gds.coeff-waste = 0
     3234               buf_recipe-gds.brutto-qnty = 0
     3235               buf_recipe-gds.proc-number = 0
     3236               buf_recipe-gds.nws-self    = no
     3237           .
     3238       end.
     3239       assign
     3240           buf_recipe-gds.is-waste    = p-is-waste
     3241       .
     3242       run fbrlib-get-recipe-type in this-procedure (
     3243             input "":U
     3244           , input buf_recipe-gds.recipe-code
     3245           , output v-recipe-type
     3246       ).
     3247       if v-recipe-type <> 'производство':U
     3248       then do:
     3249           assign
     3250               buf_recipe-gds.calc-method = 1
     3251               buf_recipe-gds.qnty        = p-qnty
     3252               buf_recipe-gds.brutto-qnty = p-qnty
     3253               buf_recipe-gds.coeff-waste = 0
     3254           .
     3255       end.
     3256       else do:
     3257           assign
     3258               buf_recipe-gds.calc-method = 1
     3259               buf_recipe-gds.brutto-qnty = p-qnty
     3260           .
     3261           run fbrlib-calc-brutto in this-procedure (
     3262                 input v-recipe-type
     3263               , input 0
     3264               , input 0
     3265               , input buf_recipe-gds.coeff-waste
     3266               , input buf_recipe-gds.brutto-qnty
     3267               , input 1
     3268               , output buf_recipe-gds.qnty
     3269               , output buf_recipe-gds.coeff-waste
     3270               , output buf_recipe-gds.brutto-qnty
     3271               , output buf_recipe-gds.calc-method
     3272           ).
     3273       end.
     3274       assign
     3275           buf_recipe-gds.nws-self    = p-nws-self
     3276       .
     3277       if buf_recipe.recipe-type = 'альтернатива':U
     3278       and buf_recipe-gds.proc-number <> 0
     3279       then do:
     3280       end.
     3281       else do:
     3282           if p-proc-number <> 0
     3283           then do:
     3284               assign
     3285                   buf_recipe-gds.proc-number = p-proc-number
     3286               .
     3287           end.
     3288           else do:
     3289               assign
     3290                   v-max-proc-num = 0
     3291               .
     3292               for each buf_proc_recipe-gds no-lock
     3293                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3294               :
     3295                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3296                   then do:
     3297                       assign
     3298                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3299                       .
     3300                   end.
     3301               end.
     3302               assign
     3303                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3304               .
     3305           end.
     3306       end.
     3307   end.
     3308   end procedure.
     3309   PROCEDURE fbrlib-create-or-update-recipe :
     3310   define input parameter p-mode               as character    no-undo.
     3311   define input parameter p-obj-type           as character    no-undo.
     3312   define input parameter p-obj-code           as integer      no-undo.
     3313   define input parameter p-recipe-code        as character    no-undo.
     3314   define input parameter p-recipe-type        as character    no-undo.
     3315   define input parameter p-gds-code           as integer      no-undo.
     3316   define input parameter p-name               as character    no-undo.
     3317   define input parameter p-design             as character    no-undo.
     3318   define input parameter p-order              as integer      no-undo.
     3319   define input parameter p-quality            as character    no-undo.
     3320   define input parameter p-ref-num            as character    no-undo.
     3321   define input parameter p-technique          as character    no-undo.
     3322   define input parameter p-template           as character    no-undo.
     3323   define input parameter p-qnty               as decimal      no-undo.
     3324   define input parameter p-portion-qnty       as integer      no-undo.
     3325   define input parameter p-portion-weight     as decimal      no-undo.
     3326   define output parameter p-new-recipe-code   as character    no-undo.
     3327       define variable v-host-code         as integer      no-undo.
     3328       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3329       define buffer buf_recipe    for ub.recipe.
     3330       define buffer buf_goods     for ub.goods.
     3331   do
     3332   for buf_recipe
     3333     , buf_goods
     3334   on error undo, return error
     3335   :
     3336       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3337       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3338       then do:
     3339           message
     3340               skip "Ошибка задания типа операции для создания или измения рецепта."
     3341               skip (1)
     3342               skip "Задан тип операции:" p-mode
     3343           view-as alert-box error.
     3344           undo, return error .
     3345       end.
     3346       if p-recipe-code = ""
     3347       then do:
     3348   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3349   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3350     (input  p-obj-type
     3351     ,input  p-obj-code
     3352     ,output v-host-code
     3353     )  .
     3354           find first buf_goods no-lock
     3355                where buf_goods.gds-code = p-gds-code
     3356           .
     3357           create buf_recipe .
     3358           run fbrcode-gen-recipe-code in this-procedure (
     3359                 input p-obj-type
     3360               , input p-obj-code
     3361               , output buf_recipe.recipe-code
     3362           ).
     3363           assign
     3364               buf_recipe.artic               = buf_goods.artic
     3365               buf_recipe.prod-type           = buf_goods.prod-type
     3366               buf_recipe.prod-code           = buf_goods.prod-code
     3367               buf_recipe.recipe-type         = p-recipe-type
     3368               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3369               buf_recipe.gds-code            = p-gds-code
     3370               buf_recipe.host-code           = v-host-code
     3371               buf_recipe.obj-type            = p-obj-type
     3372               buf_recipe.obj-code            = p-obj-code
     3373               buf_recipe.recipe-design       = ""
     3374               buf_recipe.recipe-order        = 0
     3375               buf_recipe.recipe-quality      = ""
     3376               buf_recipe.recipe-ref-num      = ""
     3377               buf_recipe.recipe-technique    = ""
     3378               buf_recipe.recipe-template     = ""
     3379               buf_recipe.qnty                = 1.0
     3380               buf_recipe.portion-qnty        = 1
     3381               buf_recipe.portion-weight      = 0
     3382           .
     3383       end.
     3384       if p-name <> ""
     3385       then do:
     3386           assign
     3387               buf_recipe.recipe-name = p-name
     3388           .
     3389       end.
     3390       assign
     3391           buf_recipe.recipe-design       = p-design
     3392           buf_recipe.recipe-order        = p-order
     3393           buf_recipe.recipe-quality      = p-quality
     3394           buf_recipe.recipe-ref-num      = p-ref-num
     3395           buf_recipe.recipe-technique    = p-technique
     3396           buf_recipe.recipe-template     = p-template
     3397           buf_recipe.qnty                = p-qnty
     3398           buf_recipe.portion-qnty        = p-portion-qnty
     3399           buf_recipe.portion-weight      = p-portion-weight
     3400       .
     3401       assign
     3402           p-new-recipe-code = buf_recipe.recipe-code
     3403       .
     3404       run fbrlib-set-default-recipe in this-procedure (
     3405             input p-obj-type
     3406           , input p-obj-code
     3407           , input buf_goods.gds-code
     3408       ).
     3409   end.
     3410   END PROCEDURE.
     3411   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3412   define input parameter parparentproc-handle as widget-handle no-undo .
     3413   define input parameter p-doc-code   as character no-undo.
     3414   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3415       define variable v-shift-on      as logical      no-undo.
     3416       define variable v-shift-date    as date         no-undo.
     3417       define variable v-shift-num     as integer      no-undo.
     3418       define variable v-shift-name    as character    no-undo.
     3419       define variable v-obj-date      as date         no-undo.
     3420       define variable v-chip-num      as integer      no-undo.
     3421       define buffer buf_fbr-doc       for ub.fbr-doc.
     3422       define buffer buf_fbr-line      for ub.fbr-line.
     3423       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3424       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3425       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3426       define buffer buf_marking-lines for ub.marking-lines .
     3427       define buffer buf_marking       for ub.marking .
     3428       define buffer buf_goods         for ub.goods .
     3429   do
     3430   for buf_fbr-doc
     3431     , buf_fbr-line
     3432     , buf_c-fbr-doc
     3433     , buf_fbr-recipe
     3434     , buf_fbr-recipe-gds
     3435     , buf_goods
     3436     , buf_marking
     3437     , buf_marking-lines
     3438   on error undo, return error
     3439   :
     3440   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3441     define variable v-cntxt-db-num        as integer   no-undo .
     3442     define variable v-cntxt-userid        as character no-undo .
     3443     define variable v-cntxt-level         as character no-undo .
     3444     define variable v-cntxt-host-code-obj as integer   no-undo .
     3445     define variable v-cntxt-obj-type      as character no-undo .
     3446     define variable v-cntxt-obj-code      as integer   no-undo .
     3447     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3448     define variable v-cntxt-is-admin      as logical   no-undo .
     3449   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3450     run mainmenu_getcntxt in parparentproc-handle
     3451       (output v-cntxt-db-num
     3452       ,output v-cntxt-userid
     3453       ,output v-cntxt-level
     3454       ,output v-cntxt-host-code-obj
     3455       ,output v-cntxt-obj-type
     3456       ,output v-cntxt-obj-code
     3457       ,output v-cntxt-db-num-obj
     3458       ,output v-cntxt-is-admin
     3459       ) .
     3460       if search ("delfbr.err") <> ?
     3461       then do:
     3462           os-delete "delfbr.err".
     3463       end.
     3464     _del-block:
     3465       do transaction
     3466     on error undo _del-block, return error return-value
     3467     on endkey undo _del-block , return error return-value
     3468     on stop undo _del-block , return error return-value
     3469       :
     3470           find first buf_fbr-doc exclusive-lock
     3471                where buf_fbr-doc.doc-code = p-doc-code
     3472           no-error.
     3473           if not available buf_fbr-doc
     3474           then do:
     3475         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3476                                           ,vss-workfile
     3477                                           ,vss-revision
     3478                                           ,vss-description
     3479                                           ,chr(10)
     3480                                           , p-doc-code).
     3481           end.
     3482           run fbrlib-delete-fact-trn-doc in this-procedure (
     3483               input parparentproc-handle
     3484              ,input p-doc-code
     3485              ,input 'при':U
     3486              ,input p-chip-num
     3487              ,output v-chip-num
     3488           ) no-error.
     3489           if error-status :error
     3490           then do:
     3491               run fbrlib-print-del-error-message in this-procedure .
     3492         undo _del-block, return error.
     3493           end.
     3494           assign
     3495           p-chip-num = (if p-chip-num = ?
     3496                         then v-chip-num
     3497                         else p-chip-num).
     3498           run fbrlib-delete-fact-trn-doc in this-procedure (
     3499               input parparentproc-handle
     3500              ,input p-doc-code
     3501              ,input 'рас':U
     3502              ,input p-chip-num
     3503              ,output v-chip-num
     3504           ) no-error.
     3505           if error-status :error
     3506           then do:
     3507               run fbrlib-print-del-error-message in this-procedure .
     3508         undo _del-block, return error.
     3509           end.
     3510           run fbrlib-delete-fact-trn-doc in this-procedure (
     3511               input parparentproc-handle
     3512              ,input p-doc-code
     3513              ,input 'спи':U
     3514              ,input p-chip-num
     3515              ,output v-chip-num
     3516           ) no-error.
     3517           if error-status :error
     3518           then do:
     3519               run fbrlib-print-del-error-message in this-procedure .
     3520         undo _del-block, return error.
     3521           end.
     3522           create buf_c-fbr-doc.
     3523           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3524   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3525   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3526     (input  buf_fbr-doc.obj-type
     3527     ,input  buf_fbr-doc.obj-code
     3528     ,output v-obj-date
     3529     ) no-error .
     3530           if error-status :error
     3531           or v-obj-date = ?
     3532           then do:
     3533         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3534           end.
     3535   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3536   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3537     (input  buf_fbr-doc.obj-type
     3538     ,input  buf_fbr-doc.obj-code
     3539     ,input  'shift-on=request'
     3540     ,output v-shift-on
     3541     )  .
     3542           if v-shift-on
     3543           then do:
     3544   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3545   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3546     (input  buf_fbr-doc.obj-type
     3547     ,input  buf_fbr-doc.obj-code
     3548     ,output v-shift-date
     3549     ,output v-shift-num
     3550     ,output v-shift-name
     3551     ) no-error .
     3552               if error-status :error
     3553               then do:
     3554           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3555               end.
     3556           end.
     3557           else do:
     3558               assign
     3559                   v-shift-date = ?
     3560                   v-shift-num  = ?
     3561                   v-shift-name = ?
     3562               .
     3563           end.
     3564           define variable v-today       as date         no-undo.
     3565           define variable v-time        as integer      no-undo.
     3566           run cur-time in this-procedure (
     3567                 output v-today
     3568               , output v-time
     3569           ).
     3570           assign
     3571               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3572               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3573               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3574               buf_c-fbr-doc.corr-date        = v-today
     3575               buf_c-fbr-doc.corr-time        = v-time
     3576               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3577               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3578               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3579               buf_c-fbr-doc.is-del           = yes
     3580           .
     3581           assign
     3582               buf_fbr-doc.is-del = yes
     3583           .
     3584           for each buf_fbr-line exclusive-lock
     3585              where buf_fbr-line.doc-code = p-doc-code
     3586       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3587       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3588       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3589           :
     3590               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3591                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3592                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3593               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3594                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3595                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3596                                                       and buf_marking-lines.in-code  = "manufacturing"
     3597                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3598                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3599                                                       and buf_marking-lines.prt-code = 0
     3600               :
     3601                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3602                   assign
     3603                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3604                   .
     3605                 end .
     3606                 delete buf_marking-lines.
     3607               end .
     3608               delete buf_fbr-line.
     3609           end.
     3610           for each buf_fbr-recipe exclusive-lock
     3611              where buf_fbr-recipe.doc-code = p-doc-code
     3612       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3613       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3614       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3615           :
     3616               delete buf_fbr-recipe.
     3617           end.
     3618           for each buf_fbr-recipe-gds exclusive-lock
     3619              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3620       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3621       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3622       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3623           :
     3624               delete buf_fbr-recipe-gds.
     3625           end.
     3626           delete buf_fbr-doc.
     3627       end.
     3628   end.
     3629   END PROCEDURE.
     3630   PROCEDURE fbrlib-del-trn-doc :
     3631   do
     3632   on error undo, return error
     3633   :
     3634   define input parameter parparentproc        as widget-handle no-undo .
     3635   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3636   define input parameter p-trn-doc-type       as character    no-undo.
     3637   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3638   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3639       define variable v-trn-doc-doc-code  as character     no-undo.
     3640       define buffer buf_trn-doc       for ub.trn-doc.
     3641   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3642     define variable v-cntxt-db-num        as integer   no-undo .
     3643     define variable v-cntxt-userid        as character no-undo .
     3644     define variable v-cntxt-level         as character no-undo .
     3645     define variable v-cntxt-host-code-obj as integer   no-undo .
     3646     define variable v-cntxt-obj-type      as character no-undo .
     3647     define variable v-cntxt-obj-code      as integer   no-undo .
     3648     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3649     define variable v-cntxt-is-admin      as logical   no-undo .
     3650   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3651     run mainmenu_getcntxt in parparentproc
     3652       (output v-cntxt-db-num
     3653       ,output v-cntxt-userid
     3654       ,output v-cntxt-level
     3655       ,output v-cntxt-host-code-obj
     3656       ,output v-cntxt-obj-type
     3657       ,output v-cntxt-obj-code
     3658       ,output v-cntxt-db-num-obj
     3659       ,output v-cntxt-is-admin
     3660       ) .
     3661       run fbrcode-trn-doc in this-procedure (
     3662             input 'производство':U
     3663           , input p-fbr-doc-doc-code
     3664           , input p-trn-doc-type
     3665           , output v-trn-doc-doc-code
     3666       ).
     3667       find first buf_trn-doc no-lock
     3668            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3669       no-error.
     3670       if available buf_trn-doc
     3671       then do:
     3672           run str/del-doc.p (
     3673                 input parparentproc
     3674               , input buf_trn-doc.doc-code
     3675               , input v-cntxt-db-num
     3676               , input "del-doc.err"
     3677               , input ?
     3678               , input p-fbr-doc-doc-code
     3679               , input v-cntxt-userid
     3680               , input 0
     3681               , input p-phchip-num
     3682               , output p-chip-num
     3683           ) no-error.
     3684           if error-status :error
     3685           then do:
     3686             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3687                                           ,v-trn-doc-doc-code
     3688                                           ,p-fbr-doc-doc-code
     3689                                           , chr(10)
     3690                                           , error-status:get-message(1)
     3691                                           , return-value ).
     3692           end.
     3693       end.
     3694   end.
     3695   END PROCEDURE.
     3696   PROCEDURE fbrlib-delete-fact-trn-doc :
     3697   define input parameter parparentproc    as widget-handle    no-undo.
     3698   define input parameter p-fbr-doc-code   as character        no-undo.
     3699   define input parameter p-doc-type       as character    no-undo.
     3700   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3701   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3702       define variable v-doc-code          as character        no-undo.
     3703       define variable v-ext-doc-type      as character        no-undo.
     3704       define variable v-trn-doc-recid     as recid            no-undo.
     3705       define variable varchip-code        as integer          no-undo.
     3706       define variable varchip-code2       as integer          no-undo.
     3707       define variable v-chip-counter      as integer          no-undo.
     3708       define buffer buf_trn-doc       for ub.trn-doc.
     3709       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3710       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3711   do
     3712   for buf_trn-doc
     3713     , buf_pri_trn-doc
     3714     , buf_cons_trn-doc
     3715   on error undo, return error
     3716   :
     3717   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3718     define variable v-cntxt-db-num        as integer   no-undo .
     3719     define variable v-cntxt-userid        as character no-undo .
     3720     define variable v-cntxt-level         as character no-undo .
     3721     define variable v-cntxt-host-code-obj as integer   no-undo .
     3722     define variable v-cntxt-obj-type      as character no-undo .
     3723     define variable v-cntxt-obj-code      as integer   no-undo .
     3724     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3725     define variable v-cntxt-is-admin      as logical   no-undo .
     3726   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3727     run mainmenu_getcntxt in parparentproc
     3728       (output v-cntxt-db-num
     3729       ,output v-cntxt-userid
     3730       ,output v-cntxt-level
     3731       ,output v-cntxt-host-code-obj
     3732       ,output v-cntxt-obj-type
     3733       ,output v-cntxt-obj-code
     3734       ,output v-cntxt-db-num-obj
     3735       ,output v-cntxt-is-admin
     3736       ) .
     3737       run fbrcode-trn-doc in this-procedure (
     3738             input 'производство':U
     3739           , input p-fbr-doc-code
     3740           , input p-doc-type
     3741           , output v-doc-code
     3742       ).
     3743       find first buf_trn-doc no-lock
     3744            where buf_trn-doc.doc-code = v-doc-code
     3745       no-error.
     3746       if not available buf_trn-doc
     3747       then do:
     3748           if p-doc-type <> 'спи':U
     3749           then do:
     3750               message
     3751                   "Не найден документ '" p-doc-type "'"
     3752                   "по документу производства " p-fbr-doc-code
     3753               view-as alert-box.
     3754               undo, return error.
     3755           end.
     3756           else do:
     3757           end.
     3758       end.
     3759       else do:
     3760           assign
     3761               v-trn-doc-recid = recid( buf_trn-doc )
     3762               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3763           .
     3764           if v-ext-doc-type = 'ev':U
     3765           then do:
     3766               find first buf_pri_trn-doc no-lock
     3767                    where buf_pri_trn-doc.out-code     = v-doc-code
     3768                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3769               no-error.
     3770               if available buf_pri_trn-doc
     3771               then do:
     3772                   run str/del-doc.p (
     3773                         input parparentproc
     3774                       , input buf_pri_trn-doc.doc-code
     3775                       , input v-cntxt-db-num
     3776                       , input "delfbr.err"
     3777                       , input ?
     3778                       , input p-fbr-doc-code
     3779                       , input v-cntxt-userid
     3780                       , input 0
     3781                       , input (if p-ph-chip-num <> ?
     3782                               then p-ph-chip-num
     3783                               else (if varchip-code <> 0
     3784                                   then varchip-code
     3785                                   else ?)
     3786                               )
     3787                       , output varchip-code2
     3788                   ) no-error.
     3789                   if error-status :error
     3790                   then do:
     3791                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3792                                                   ,buf_pri_trn-doc.doc-code
     3793                                                   ,p-fbr-doc-code
     3794                                                   , chr(10)
     3795                                                   , error-status:get-message(1)
     3796                                                   , return-value ).
     3797                   end.
     3798               end.
     3799           end.
     3800           define buffer buf_out_trn-doc       for ub.trn-doc.
     3801           if p-doc-type = 'при':U
     3802           then do:
     3803               assign
     3804                   v-chip-counter = 0
     3805               .
     3806               for each buf_out_trn-doc exclusive-lock
     3807                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3808               on error undo, return error
     3809               :
     3810                   assign
     3811                       v-chip-counter = v-chip-counter + 1
     3812                   .
     3813                   if v-chip-counter > 1
     3814                   then do:
     3815                       assign
     3816                           varchip-code = varchip-code2
     3817                       .
     3818                   end.
     3819                   run str/del-doc.p (
     3820                         input parparentproc
     3821                       , input buf_out_trn-doc.doc-code
     3822                       , input v-cntxt-db-num
     3823                       , input "delfbr.err"
     3824                       , input ?
     3825                       , input p-fbr-doc-code
     3826                       , input v-cntxt-userid
     3827                       , input 0
     3828                       , input (if p-ph-chip-num <> ?
     3829                               then p-ph-chip-num
     3830                               else (if varchip-code <> 0
     3831                                   then varchip-code
     3832                                   else ?)
     3833                               )
     3834                       , output varchip-code2
     3835                   ) no-error.
     3836                   if error-status :error
     3837                   then do:
     3838                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3839                                                   ,buf_out_trn-doc.doc-code
     3840                                                   ,buf_trn-doc.doc-code
     3841                                                   ,p-fbr-doc-code
     3842                                                   , chr(10)
     3843                                                   , error-status:get-message(1)
     3844                                                   , return-value ).
     3845                   end.
     3846               end.
     3847           end.
     3848           run str/del-doc.p (
     3849                 input parparentproc
     3850               , input buf_trn-doc.doc-code
     3851               , input v-cntxt-db-num
     3852               , input "delfbr.err"
     3853               , input ?
     3854               , input p-fbr-doc-code
     3855               , input v-cntxt-userid
     3856               , input 0
     3857               , input (if p-ph-chip-num <> ?
     3858                        then p-ph-chip-num
     3859                        else (if varchip-code <> 0
     3860                              then varchip-code
     3861                              else ?)
     3862                        )
     3863               , output varchip-code2
     3864           ) no-error.
     3865           if error-status :error
     3866           then do:
     3867               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3868                                             ,buf_trn-doc.doc-code
     3869                                             ,p-fbr-doc-code
     3870                                             , chr(10)
     3871                                             , error-status:get-message(1)
     3872                                             , return-value ).
     3873           end.
     3874           if p-doc-type = 'рас':U
     3875           or p-doc-type = 'спи':U
     3876           then do:
     3877               assign
     3878                   v-chip-counter = 0
     3879               .
     3880               for each buf_cons_trn-doc no-lock
     3881                  where buf_cons_trn-doc.out-code      = v-doc-code
     3882                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3883               :
     3884                   assign
     3885                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3886                       v-chip-counter = v-chip-counter + 1
     3887                   .
     3888                   assign
     3889                   varchip-code = if v-chip-counter = 2
     3890                                  then varchip-code2
     3891                                  else varchip-code.
     3892                   run str/del-doc.p (
     3893                         input parparentproc
     3894                       , input buf_cons_trn-doc.doc-code
     3895                       , input v-cntxt-db-num
     3896                       , input "delfbr.err"
     3897                       , input ?
     3898                       , input ?
     3899                       , input v-cntxt-userid
     3900                       , input 0
     3901                       , input (if p-ph-chip-num <> ?
     3902                                then p-ph-chip-num
     3903                                else ( if v-chip-counter = 1
     3904                                       then ?
     3905                                       else varchip-code )
     3906                                )
     3907                       , output varchip-code2
     3908                   ) no-error.
     3909                   if error-status :error
     3910                   then do:
     3911                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3912                                                     ,buf_cons_trn-doc.doc-code
     3913                                                     ,p-fbr-doc-code
     3914                                                     , chr(10)
     3915                                                     , error-status:get-message(1)
     3916                                                     , return-value ).
     3917                   end.
     3918                   assign
     3919                       p-chip-num = varchip-code2
     3920                   .
     3921               end.
     3922           end.
     3923           assign
     3924               p-chip-num = varchip-code2
     3925           .
     3926       end.
     3927   end.
     3928   END PROCEDURE.
     3929   PROCEDURE fbrlib-print-del-error-message :
     3930   do
     3931   on error undo, return error
     3932   :
     3933       define variable v-user-action   as character    no-undo.
     3934       define variable v-printed       as logical      no-undo.
     3935       message
     3936           vss-workfile vss-revision vss-description
     3937           skip "Ошибка при удалении документа."
     3938           skip return-value
     3939           skip trim(error-status :get-message(1))
     3940           skip trim(error-status :get-message(2))
     3941           skip trim(error-status :get-message(3))
     3942       view-as alert-box error.
     3943       if search ("delfbr.err") <> ?
     3944       then do:
     3945         run gbl/prnfilen.w
     3946           (input  "Ошибки при удалении документа производства"
     3947           ,input  0
     3948           ,input  "delfbr.err"
     3949           ,input  7
     3950           ,output v-user-action
     3951           ,output v-printed
     3952           ).
     3953       end.
     3954   end.
     3955   END PROCEDURE.
     3956   procedure fbrlib-calc-brutto :
     3957   define input parameter p-recipe-type        as character        no-undo.
     3958   define input parameter p-netto              as decimal          no-undo.
     3959   define input parameter p-coeff-value        as decimal          no-undo.
     3960   define input parameter p-coeff-waste        as decimal          no-undo.
     3961   define input parameter p-brutto             as decimal          no-undo.
     3962   define input parameter p-calc-method        as integer          no-undo.
     3963   define output parameter p-new-netto         as decimal          no-undo.
     3964   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3965   define output parameter p-new-brutto        as decimal          no-undo.
     3966   define output parameter p-new-calc-method   as integer          no-undo.
     3967   do
     3968   on error undo, return error
     3969   :
     3970       if p-recipe-type <> 'производство':U
     3971       then do:
     3972           assign
     3973               p-new-coeff-waste = 0
     3974               p-new-calc-method = 1
     3975               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3976               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3977           .
     3978       end.
     3979       else do:
     3980           assign
     3981               p-new-calc-method = p-calc-method
     3982           .
     3983           if p-coeff-waste = 0
     3984           then do:
     3985               assign
     3986                   p-coeff-value = 0
     3987               .
     3988           end.
     3989           case p-calc-method
     3990           :
     3991               when 1
     3992               then do:
     3993                   assign
     3994                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3995                       p-new-coeff-waste   = p-coeff-waste
     3996                       p-new-brutto        = p-brutto
     3997                   .
     3998               end.
     3999               when 2
     4000               then do:
     4001                   assign
     4002                       p-new-netto         = p-netto
     4003                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     4004                       p-new-brutto        = p-brutto
     4005                   .
     4006               end.
     4007               when 3
     4008               then do:
     4009                   assign
     4010                       p-new-netto         = p-netto
     4011                       p-new-coeff-waste   = p-coeff-waste
     4012                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     4013                   .
     4014               end.
     4015               otherwise do:
     4016                   define variable v-yesno    as logical      no-undo.
     4017                   assign
     4018                       v-yesno = yes
     4019                   .
     4020                   message
     4021                       "Неверный метод для расчета брутто, нетто и процента потерь."
     4022                       skip "Значение метода должно быть 1, 2 или 3."
     4023                       skip(1)
     4024                       skip "Заданное значение:" p-calc-method
     4025                       skip(1)
     4026                       skip "Установить значение метода расчета 1"
     4027                       skip "(расчет нетто по брутто и проценту потерь)?"
     4028                   view-as alert-box warning
     4029                   buttons yes-no
     4030                   title "Неверное значение метода пересчета в строках документа-производства"
     4031                   update v-yesno
     4032                   .
     4033                   if v-yesno = yes
     4034                   then do:
     4035                       assign
     4036                           p-new-calc-method   = 1
     4037                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4038                           p-new-coeff-waste   = p-coeff-waste
     4039                           p-new-brutto        = p-brutto
     4040                       .
     4041                   end.
     4042                   else do:
     4043                       message
     4044                               vss-workfile vss-revision vss-description
     4045                           skip(1)
     4046                           skip "Ошибка расчета брутто, нетто и процента потерь."
     4047                           skip return-value
     4048                           skip trim(error-status :get-message(1))
     4049                               trim(error-status :get-message(2))
     4050                               trim(error-status :get-message(3))
     4051                       view-as alert-box error
     4052                       title "Неверное значение метода расчета"
     4053                       .
     4054                       undo, return error .
     4055                   end.
     4056               end.
     4057           end case.
     4058       end.
     4059   end.
     4060   end procedure.
     4061   procedure fbrlib-check-brutto :
     4062   define input parameter p-recipe-type        as character        no-undo.
     4063   define input parameter p-netto              as decimal          no-undo.
     4064   define input parameter p-coeff-value        as decimal          no-undo.
     4065   define input parameter p-coeff-waste        as decimal          no-undo.
     4066   define input parameter p-brutto             as decimal          no-undo.
     4067   define input parameter p-calc-method        as integer          no-undo.
     4068   define output parameter p-error-message     as character        no-undo.
     4069   define output parameter p-not-good          as logical          no-undo.
     4070   do
     4071   on error undo, return error
     4072   :
     4073       if p-recipe-type <> 'производство':U
     4074       then do:
     4075           if p-netto <> p-brutto
     4076           or p-coeff-waste <> 0
     4077           then do:
     4078               assign
     4079                   p-not-good      = yes
     4080                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     4081                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     4082               .
     4083           end.
     4084       end.
     4085       else do:
     4086           if p-coeff-waste = 0
     4087           then do:
     4088               assign
     4089                   p-coeff-value = 0
     4090               .
     4091           end.
     4092           case p-calc-method
     4093           :
     4094               when 1
     4095               then do:
     4096                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     4097                   then do:
     4098                       assign
     4099                           p-not-good      = yes
     4100                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     4101                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4102                       .
     4103                   end.
     4104               end.
     4105               when 2
     4106               then do:
     4107                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     4108                   then do:
     4109                       assign
     4110                           p-not-good      = yes
     4111                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     4112                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     4113                       .
     4114                   end.
     4115               end.
     4116               when 3
     4117               then do:
     4118                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     4119                   then do:
     4120                       assign
     4121                           p-not-good      = yes
     4122                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4123                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4124                       .
     4125                   end.
     4126               end.
     4127               otherwise do:
     4128                   assign
     4129                       p-not-good      = yes
     4130                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4131                   .
     4132               end.
     4133           end case.
     4134       end.
     4135   end.
     4136   end procedure.
     4137   procedure fbrlib-check-fbr-recipe :
     4138   define input parameter p-doc-code       as character        no-undo.
     4139   define input parameter p-recipe-code    as character        no-undo.
     4140   define output parameter p-is-correct    as logical          no-undo.
     4141       define variable v-comp-factor    as decimal      no-undo.
     4142       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4143       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4144       define buffer buf_fbr-line          for ub.fbr-line.
     4145   do
     4146   for buf_fbr-recipe
     4147     , buf_fbr-recipe-gds
     4148     , buf_fbr-line
     4149   on error undo, return error
     4150   :
     4151       assign
     4152           p-is-correct = yes
     4153       .
     4154       find first buf_fbr-recipe no-lock
     4155            where buf_fbr-recipe.doc-code    = p-doc-code
     4156              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4157       .
     4158       if not available buf_fbr-recipe then do:
     4159         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4160       end.
     4161       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4162       then do:
     4163       end.
     4164       else do:
     4165           find first buf_fbr-line no-lock
     4166                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4167                  and buf_fbr-line.is-comp     = yes
     4168                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4169                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4170                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4171                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4172           .
     4173           assign
     4174               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4175           .
     4176           recipe-line-cycle:
     4177           for each buf_fbr-recipe-gds no-lock
     4178              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4179                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4180           on error undo, return error
     4181           :
     4182               find first buf_fbr-line no-lock
     4183                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4184                      and buf_fbr-line.is-comp     = no
     4185                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4186                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4187                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4188                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4189               .
     4190               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4191               then do:
     4192                   assign
     4193                       p-is-correct = no
     4194                   .
     4195                   leave recipe-line-cycle.
     4196               end.
     4197           end.
     4198       end.
     4199   end.
     4200   end procedure.
     4201   procedure fbrlib-get-recipe-type :
     4202   define input parameter p-fbr-doc-code   as character        no-undo.
     4203   define input parameter p-recipe-code    as character        no-undo.
     4204   define output parameter p-recipe-type   as character        no-undo.
     4205       define buffer buf_recipe        for ub.recipe.
     4206       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4207   do
     4208   for buf_recipe
     4209     , buf_fbr-recipe
     4210   on error undo, return error
     4211   :
     4212       if p-fbr-doc-code = ""
     4213       then do:
     4214           find first buf_recipe no-lock
     4215                where buf_recipe.recipe-code = p-recipe-code
     4216           no-error.
     4217           if available buf_recipe
     4218           then do:
     4219               assign
     4220                   p-recipe-type = buf_recipe.recipe-type
     4221               .
     4222           end.
     4223           else do:
     4224               assign
     4225                   p-recipe-type = "":U
     4226               .
     4227           end.
     4228       end.
     4229       else do:
     4230           find first buf_fbr-recipe no-lock
     4231                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4232                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4233           no-error.
     4234           if available buf_fbr-recipe
     4235           then do:
     4236               assign
     4237                   p-recipe-type = buf_fbr-recipe.recipe-type
     4238               .
     4239           end.
     4240           else do:
     4241               assign
     4242                   p-recipe-type = "":U
     4243               .
     4244           end.
     4245       end.
     4246   end.
     4247   end procedure.
     4248   PROCEDURE calc-comp-from-ingr :
     4249   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4250   define input parameter p-fact-qnty                          as decimal      no-undo.
     4251   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4252   define output parameter p-comp-qnty                         as decimal      no-undo.
     4253       define variable v-ingr-qnty     as decimal       no-undo.
     4254       define buffer buf_i_fbr-line    for ub.fbr-line.
     4255       define buffer buf_fbr-line      for ub.fbr-line.
     4256       define buffer buf_recipe        for ub.fbr-recipe.
     4257       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4258   do
     4259   for buf_i_fbr-line
     4260     , buf_fbr-line
     4261     , buf_recipe
     4262     , buf_recipe-gds
     4263   on error undo, return error
     4264   :
     4265       find first buf_i_fbr-line no-lock
     4266            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4267       .
     4268       find first buf_recipe no-lock
     4269            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4270              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4271       no-error.
     4272       if not available buf_recipe
     4273       then do:
     4274           message
     4275                   vss-workfile vss-revision vss-description
     4276               skip "В строке производства не указан рецепт."
     4277               skip "Невозможно рассчитать количество составного товара."
     4278               skip return-value
     4279               skip trim(error-status :get-message(1))
     4280                   trim(error-status :get-message(2))
     4281                   trim(error-status :get-message(3))
     4282           view-as alert-box error.
     4283           undo, return error .
     4284       end.
     4285       if buf_recipe.recipe-type = 'альтернатива':U
     4286       then do:
     4287           for each buf_fbr-line no-lock
     4288              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4289                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4290                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4291           on error undo, return error
     4292           :
     4293               find first buf_recipe-gds no-lock
     4294                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4295                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4296                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4297                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4298                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4299               .
     4300               assign
     4301                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4302               .
     4303           end.
     4304           assign
     4305               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4306           .
     4307       end.
     4308       else do:
     4309           find first buf_recipe-gds no-lock
     4310                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4311                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4312                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4313                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4314                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4315           .
     4316           assign
     4317               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4318           .
     4319       end.
     4320       find first buf_fbr-line no-lock
     4321            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4322              and buf_fbr-line.is-comp     = yes
     4323              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4324       .
     4325       assign
     4326           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4327       .
     4328   end.
     4329   END PROCEDURE.
     4330   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4331   define input parameter p-recipe-code    as character    no-undo.
     4332   define input parameter p-gds-code       as integer      no-undo.
     4333   define output parameter p-line-qnty     as decimal      no-undo.
     4334   define output parameter p-used-qnty     as decimal      no-undo.
     4335   define output parameter p-recipe-qnty   as decimal      no-undo.
     4336       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4337   do
     4338   for buf_temp_dressing-ingr
     4339   on error undo, return error
     4340   :
     4341       find first buf_temp_dressing-ingr no-lock
     4342            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4343              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4344       no-error.
     4345       if available buf_temp_dressing-ingr
     4346       then do:
     4347           assign
     4348               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4349               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4350               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4351           .
     4352       end.
     4353       else do:
     4354           assign
     4355               p-line-qnty     = 0
     4356               p-used-qnty     = 0
     4357               p-recipe-qnty   = 0
     4358           .
     4359       end.
     4360   end.
     4361   END PROCEDURE.
     4362   PROCEDURE fbrlib_adjust-recipe :
     4363   do
     4364   on error undo, return error
     4365   :
     4366   define input parameter parparentproc as widget-handle no-undo .
     4367   define input parameter p-fbrhist-handle as handle no-undo .
     4368   define input parameter p-doc-code       as character    no-undo.
     4369   define input parameter p-recipe-code    as character    no-undo.
     4370   define input parameter p-price-sale-obj-type as character no-undo .
     4371   define input parameter p-price-sale-obj-code as integer no-undo .
     4372       define variable v-recipe-qnty       as decimal      no-undo.
     4373       define variable v-comp-qnty         as decimal      no-undo.
     4374       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4375       define variable v-ingr-qnty         as decimal      no-undo.
     4376       define variable v-qnty              as decimal      no-undo.
     4377       define variable v-coeff-waste       as decimal      no-undo.
     4378       define variable v-brutto-qnty       as decimal      no-undo.
     4379       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4380       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4381       define buffer buf_fbr-line          for ub.fbr-line.
     4382       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4383       find first buf_fbr-recipe no-lock
     4384            where buf_fbr-recipe.doc-code      = p-doc-code
     4385              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4386       .
     4387       assign
     4388           v-recipe-qnty = buf_fbr-recipe.qnty
     4389       .
     4390       find first buf_fbr-line no-lock
     4391            where buf_fbr-line.doc-code    = p-doc-code
     4392              and buf_fbr-line.is-comp     = yes
     4393              and buf_fbr-line.recipe-code = p-recipe-code
     4394       .
     4395       assign
     4396           v-comp-qnty = buf_fbr-line.fact-qnty
     4397       .
     4398       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4399       then do:
     4400       end.
     4401       else do:
     4402           for each buf_fbr-recipe-gds no-lock
     4403              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4404                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4405           on error undo, return error
     4406           :
     4407               find first buf_fbr-line no-lock
     4408                    where buf_fbr-line.doc-code    = p-doc-code
     4409                      and buf_fbr-line.is-comp     = no
     4410                      and buf_fbr-line.recipe-code = p-recipe-code
     4411                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4412                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4413                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4414               .
     4415               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4416               then do:
     4417                   do transaction
     4418                   on error undo, return error
     4419                   :
     4420                       find first buf_el_fbr-recipe-gds exclusive-lock
     4421                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4422                       .
     4423                       assign
     4424                           buf_el_fbr-recipe-gds.calc-method   = 1
     4425                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4426                       .
     4427                       run fbrlib-calc-brutto in this-procedure (
     4428                             input buf_fbr-recipe.recipe-type
     4429                           , input 0
     4430                           , input buf_el_fbr-recipe-gds.coeff-value
     4431                           , input buf_el_fbr-recipe-gds.coeff-waste
     4432                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4433                           , input 1
     4434                           , output buf_el_fbr-recipe-gds.qnty
     4435                           , output buf_el_fbr-recipe-gds.coeff-waste
     4436                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4437                           , output buf_el_fbr-recipe-gds.calc-method
     4438                       ).
     4439                   end.
     4440               end.
     4441           end.
     4442           run fbrlib_adjust-doc-lines in this-procedure (
     4443                 input parparentproc
     4444               , input p-fbrhist-handle
     4445               , input p-doc-code
     4446               , input p-recipe-code
     4447               , input p-price-sale-obj-type
     4448               , input p-price-sale-obj-code
     4449           ).
     4450       end.
     4451   end.
     4452   END PROCEDURE.
     4453   PROCEDURE fbrlib_adjust-doc-lines :
     4454   define input parameter parparentproc as widget-handle no-undo .
     4455   define input parameter p-fbrhist-handle as handle no-undo .
     4456   define input parameter p-doc-code       as character    no-undo.
     4457   define input parameter p-recipe-code    as character    no-undo.
     4458   define input parameter p-price-sale-obj-type as character no-undo .
     4459   define input parameter p-price-sale-obj-code as integer no-undo .
     4460   define variable v-comp-qnty         as decimal      no-undo.
     4461   define variable v-trn-type          as character    no-undo.
     4462   define variable v-ingr-qnty         as decimal      no-undo.
     4463   define variable v-recipe-qnty       as decimal      no-undo.
     4464   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4465   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4466   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4467   define buffer buf_fbr-line          for ub.fbr-line.
     4468   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4469   define buffer buf_goods             for ub.goods.
     4470   define buffer buf_fbr-doc           for ub.fbr-doc.
     4471   do
     4472   for buf_fbr-recipe
     4473     , buf_fbr-recipe-gds
     4474     , buf_fbr-line
     4475     , buf_coeff_fbr-line
     4476     , buf_goods
     4477     , buf_fbr-doc
     4478   on error undo, return error
     4479   :
     4480       find first buf_fbr-line no-lock
     4481            where buf_fbr-line.doc-code      = p-doc-code
     4482              and buf_fbr-line.is-comp       = yes
     4483              and buf_fbr-line.recipe-code   = p-recipe-code
     4484       .
     4485       find first buf_fbr-doc no-lock
     4486            where buf_fbr-doc.doc-code      = p-doc-code
     4487       .
     4488       assign
     4489           v-comp-qnty = buf_fbr-line.fact-qnty
     4490           v-trn-type  = buf_fbr-line.trn-type
     4491       .
     4492       find first buf_fbr-recipe no-lock
     4493            where buf_fbr-recipe.doc-code    = p-doc-code
     4494              and buf_fbr-recipe.recipe-code = p-recipe-code
     4495       .
     4496       assign
     4497       v-recipe-qnty = buf_fbr-recipe.qnty
     4498       .
     4499       do transaction
     4500       on error undo, return error
     4501       :
     4502           for each buf_fbr-recipe-gds no-lock
     4503              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4504                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4505           on error undo, return error
     4506           :
     4507               find first buf_fbr-line no-lock
     4508                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4509                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4510                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4511                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4512                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4513               no-error.
     4514               if not available buf_fbr-line
     4515               then do:
     4516                   find first buf_goods no-lock
     4517                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4518                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4519                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4520                   .
     4521                   run str/fbr-crln.p (
     4522                         input parparentproc
     4523                       , input recid( buf_fbr-doc )
     4524                       , input recid( buf_goods )
     4525                       , input buf_fbr-recipe-gds.recipe-code
     4526                       , input v-trn-type
     4527                       , input no
     4528                       , input no
     4529                       , input buf_fbr-doc.obj-type
     4530                       , input buf_fbr-doc.obj-code
     4531                       , output v-fbr-v-fbr-doc-line-recid
     4532                   ).
     4533                   find first buf_fbr-line no-lock
     4534                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4535                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4536                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4537                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4538                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4539                   no-error.
     4540                   if not available buf_fbr-line
     4541                   then do:
     4542                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4543                                                      , p-doc-code
     4544                                                      , buf_fbr-recipe-gds.artic
     4545                                                      , buf_fbr-recipe-gds.prod-type
     4546                                                      , buf_fbr-recipe-gds.prod-code).
     4547                   end.
     4548               end.
     4549               find first buf_coeff_fbr-line exclusive-lock
     4550                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4551               .
     4552               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4553               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4554               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4555               then do:
     4556                   assign
     4557                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4558                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4559                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4560                   .
     4561               end.
     4562           end.
     4563       end.
     4564       define variable v-need-goods    as logical       no-undo.
     4565       define variable v-need-goods-list       as character     no-undo.
     4566       define variable v-need-goods-qnty-list  as character     no-undo.
     4567       find first buf_fbr-line no-lock
     4568            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4569              and buf_fbr-line.is-comp     = yes
     4570              and buf_fbr-line.recipe-code = p-recipe-code
     4571       .
     4572       run str/fbr-qnty.p (
     4573             input parparentproc
     4574           , input p-fbrhist-handle
     4575           , input recid( buf_fbr-doc )
     4576           , input recid( buf_fbr-line )
     4577           , input no
     4578           , input "ingr"
     4579           , input no
     4580           , input p-price-sale-obj-type
     4581           , input p-price-sale-obj-code
     4582           , input no
     4583           , input no
     4584           , input no
     4585           , output v-need-goods
     4586           , output v-need-goods-list
     4587           , output v-need-goods-qnty-list
     4588       ).
     4589   end.
     4590   END PROCEDURE.
     4591   procedure fbrlib_check-before-close :
     4592   define input parameter p-doc-code as character no-undo .
     4593   define variable same-sale as decimal no-undo .
     4594   define variable is-waste as logical no-undo .
     4595   define variable fix-price as logical no-undo .
     4596   define buffer buf_fbr-doc for ub.fbr-doc.
     4597   define buffer buf_fbr-line for ub.fbr-line.
     4598   define buffer buf_goods for ub.goods.
     4599   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4600   do
     4601   on error undo, return error
     4602   :
     4603     for each buf_fbr-line no-lock
     4604         where buf_fbr-line.doc-code = p-doc-code
     4605       , each buf_goods no-lock
     4606         where buf_goods.artic     = buf_fbr-line.artic
     4607           and buf_goods.prod-type = buf_fbr-line.prod-type
     4608           and buf_goods.prod-code = buf_fbr-line.prod-code
     4609     break by buf_fbr-line.prod-type
     4610           by buf_fbr-line.prod-code
     4611           by buf_fbr-line.artic
     4612     :
     4613       if first-of (buf_fbr-line.artic)
     4614       then do:
     4615         assign
     4616         same-sale = buf_fbr-line.price-sale
     4617         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4618         fix-price = buf_fbr-line.is-calc
     4619         .
     4620       end.
     4621       if same-sale <> buf_fbr-line.price-sale
     4622       then do:
     4623           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4624                                         ,p-doc-code
     4625                                         ,buf_goods.artic
     4626                                         ,buf_goods.gds-name
     4627                                         ,chr(10)).
     4628       end.
     4629       if fix-price <> buf_fbr-line.is-calc then do:
     4630           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4631                                         ,p-doc-code
     4632                                         ,buf_goods.artic
     4633                                         ,buf_goods.gds-name
     4634                                         ,chr(10)).
     4635       end.
     4636       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4637       then do:
     4638         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4639                                         ,p-doc-code
     4640                                         ,buf_goods.artic
     4641                                         ,buf_goods.gds-name
     4642                                         ,chr(10)).
     4643       end.
     4644       if buf_fbr-line.rsrv-qnty <> ?
     4645       and buf_goods.gds-type <> 'у':U
     4646       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4647       and buf_fbr-line.fact-qnty <> 0
     4648       then do:
     4649         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4650           if  can-find(first buf_fbr-gds-obj no-lock where
     4651                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4652               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4653               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4654               and buf_fbr-gds-obj.is-null-price  )  then .
     4655                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4656                                         ,p-doc-code
     4657                                         ,buf_goods.artic
     4658                                         ,buf_goods.gds-name
     4659                                         ,chr(10)
     4660                                         ,buf_fbr-line.recipe-code
     4661                                         ).
     4662         end.
     4663         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4664                                         ,p-doc-code
     4665                                         ,buf_goods.artic
     4666                                         ,buf_goods.gds-name
     4667                                         ,chr(10)
     4668                                         ,buf_fbr-line.recipe-code
     4669                                         ).
     4670       end.
     4671     end.
     4672   end.
     4673   end procedure.
     4674   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4675   define new global shared variable g#attr-lib  as handle no-undo .
