      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   def var State-source as  WIDGET-HANDLE.
      679   def buffer cli-post for clients .
      680   def New SHARED temp-table g#post NO-UNDO
      681       field obj-type like ub.clients.obj-type
      682       field obj-code like ub.clients.obj-code
      683       field obj-name like ub.clients.obj-name
      684       INDEX pi IS UNIQUE PRIMARY obj-type obj-code.
      685   def var  post-grp_recids as character no-undo .
      686   def var ii as integer no-undo .
      687   DEFINE VARIABLE PostName AS CHARACTER
      688        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      689        SIZE 31 BY 2.17 TOOLTIP "Список выбранных Поставщиков" NO-UNDO.
      690   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      691        VIEW-AS FILL-IN NATIVE
      692        SIZE 5 BY .79 NO-UNDO.
      693   DEFINE VARIABLE var-lavel-2 AS INTEGER FORMAT ">>9":U INITIAL 1
      694        VIEW-AS FILL-IN NATIVE
      695        SIZE 5 BY .79 NO-UNDO.
      696   DEFINE VARIABLE Classify AS CHARACTER
      697        VIEW-AS RADIO-SET VERTICAL
      698        RADIO-BUTTONS
      699             "Без классификации", "no-classify":U,
      700   "Группы контрагентов", "post":U,
      701   "Группы товаров", "grp-goods":U,
      702   "Группы контрагентов/Группы товаров", "post/grp-goods":U,
      703   "Группы товаров/Группы контрагентов", "grp-goods/post":U
      704        size 37.38 by 4.63 NO-UNDO.
      705   DEFINE VARIABLE RADPost AS INTEGER
      706        VIEW-AS RADIO-SET VERTICAL
      707        RADIO-BUTTONS
      708             "все", 1,
      709   "Выборочно", 2
      710        SIZE 12 BY 2.17 NO-UNDO.
      711   DEFINE VARIABLE serv AS CHARACTER INITIAL "all"
      712        VIEW-AS RADIO-SET VERTICAL
      713        RADIO-BUTTONS
      714             "Все", "all":U,
      715   "Товары", "goods":U,
      716   "Услуги  ", "office":U
      717        SIZE 12 BY 2.29 NO-UNDO.
      718   DEFINE VARIABLE SortType AS CHARACTER
      719        VIEW-AS RADIO-SET VERTICAL
      720        RADIO-BUTTONS
      721             "по коду", "sort-code":U,
      722   "по артикулу", "sort-article":U
      723        size 14 by 2.17
      724        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      725   DEFINE RECTANGLE RECT-5
      726        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      727        SIZE 45.75 BY 6.96.
      728   DEFINE RECTANGLE RECT-6
      729        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      730        SIZE 22.75 BY 4.42.
      731   DEFINE RECTANGLE RECT-7
      732        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      733        SIZE 45.5 BY 3.42.
      734   DEFINE RECTANGLE RECT-8
      735        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      736        SIZE 45.75 BY 5.92.
      737   DEFINE RECTANGLE RECT-9
      738        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      739        SIZE 22.75 BY 12.08.
      740   DEFINE VARIABLE Show-discnt AS LOGICAL INITIAL yes
      741        LABEL "Скидки":L
      742        VIEW-AS TOGGLE-BOX
      743        size 10.88 by 0.83 NO-UNDO.
      744   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
      745        LABEL "Нулевые остатки":L
      746        VIEW-AS TOGGLE-BOX
      747        size 19 by 0.83 NO-UNDO.
      748   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      749        LABEL "Только итоги":L
      750        VIEW-AS TOGGLE-BOX
      751        SIZE 19 BY .83 NO-UNDO.
      752   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      753        LABEL "с уровня":L
      754        VIEW-AS TOGGLE-BOX
      755        size 12.63 by 0.79
      756        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      757   DEFINE VARIABLE Tog-lavel-2 AS LOGICAL INITIAL no
      758        LABEL "с уровня":L
      759        VIEW-AS TOGGLE-BOX
      760        size 12.63 by 0.79
      761        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      762   DEFINE VARIABLE Tog-obj AS LOGICAL INITIAL yes
      763        LABEL "Раздельно по объектам":L
      764        VIEW-AS TOGGLE-BOX
      765        size 31 by 1
      766        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      767   DEFINE FRAME F-Main
      768        RADPost AT ROW 2 COL 3.25 NO-LABEL
      769        PostName AT ROW 2 COL 15.38 NO-LABEL
      770        SortType at row 2.5 col 51.88 NO-LABEL
      771        Tog-obj at row 5.54 col 3.38
      772        Classify at row 6.79 col 3.25 NO-LABEL
      773        Tog-lavel-2 at row 7.75 col 28.25
      774        var-lavel-2 AT ROW 7.75 COL 39.13 COLON-ALIGNED NO-LABEL
      775        var-lavel AT ROW 8.58 COL 39.13 COLON-ALIGNED NO-LABEL
      776        Tog-lavel at row 8.63 col 28.25
      777        serv AT ROW 13.21 COL 3.25 NO-LABEL
      778        Show-discnt at row 13.21 col 26.5
      779        ShowZero at row 15.58 col 3.25
      780        SumsOnly AT ROW 16.46 COL 3.25
      781        "Выбор контрагента:" VIEW-AS TEXT
      782             SIZE 19.38 BY .67 AT ROW 1.25 COL 7.13
      783             FGCOLOR 4
      784        "Показать :" VIEW-AS TEXT
      785             size 11.5 by 0.75 at row 11.83 col 7.25
      786             FGCOLOR 4
      787        "Классификация :" VIEW-AS TEXT
      788             size 15 by 0.75 at row 4.83 col 7.13
      789             FGCOLOR 4
      790        "Сортировка :" VIEW-AS TEXT
      791             size 13.63 by 0.75 at row 1.42 col 51.88
      792             FGCOLOR 4
      793        RECT-7 AT ROW 1.04 COL 1.75
      794        RECT-6 AT ROW 1.04 COL 48.13
      795        RECT-5 AT ROW 4.63 COL 1.75
      796        RECT-9 AT ROW 5.5 COL 48.13
      797        RECT-8 AT ROW 11.63 COL 1.75
      798       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      799            SIDE-LABELS NO-UNDERLINE THREE-D
      800            AT COL 1 ROW 1 SCROLLABLE .
      801   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      802   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      803   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      804   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      805   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      806   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      807   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      808   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      809         adm-object-hdl = FRAME F-Main:HANDLE.
      810   RUN ensure-broker.
      811   THIS-PROCEDURE:ADM-DATA =
      812        'ADM1.1~`':U +
      813        'SmartObject~`':U +
      814        '~`':U +
      815        'NO ~`':U +
      816        '~`':U +
      817        '~`':U +
      818        '~`':U +
      819        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      820           + "~`":U +
      821        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      822        'Record-Source,Record-Target,TableIO-Target~`':U +
      823        '~`':U +
      824        '~`~`~`~`~`~`~`~`~`~`~`':U +
      825        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      826            THEN "^^":U
      827        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      828             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      829   PROCEDURE adm-apply-entry :
      830     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      831   END PROCEDURE.
      832   PROCEDURE adm-destroy :
      833    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      834   END PROCEDURE.
      835   PROCEDURE adm-disable :
      836       DISABLE RECT-7 RECT-6 RECT-5 RECT-9 RECT-8 RADPost PostName SortType Tog-obj Classify serv Show-discnt ShowZero WITH FRAME F-Main.
      837       RUN dispatch ('disable-fields':U).
      838       RUN set-attribute-list ('ENABLED=no':U).
      839       RETURN.
      840   END PROCEDURE.
      841   PROCEDURE adm-edit-attribute-list :
      842         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      843         RETURN.
      844   END PROCEDURE.
      845   PROCEDURE adm-enable :
      846       ENABLE UNLESS-HIDDEN RECT-7 RECT-6 RECT-5 RECT-9 RECT-8 RADPost PostName SortType Tog-obj Classify serv Show-discnt ShowZero WITH FRAME F-Main.
      847       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      848       RUN set-attribute-list ('ENABLED=yes':U).
      849       RETURN.
      850   END PROCEDURE.
      851   PROCEDURE adm-exit :
      852        RUN notify ('exit':U).
      853     RETURN.
      854   END PROCEDURE.
      855   PROCEDURE adm-hide :
      856     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      857   END PROCEDURE.
      858   PROCEDURE adm-initialize :
      859     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      860   END PROCEDURE.
      861   PROCEDURE adm-show-errors :
      862       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      863       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      864           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      865       END.
      866       RETURN.
      867   END PROCEDURE.
      868   PROCEDURE adm-UIB-mode :
      869     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      870   END PROCEDURE.
      871   PROCEDURE adm-view :
      872     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      873   END PROCEDURE.
      874   PROCEDURE dispatch :
      875       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      876       RUN broker-dispatch IN adm-broker-hdl
      877           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      878       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      879   END PROCEDURE.
      880   PROCEDURE ensure-broker :
      881   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      882   IF RETURN-VALUE NE "ADM-Broker":U THEN
      883   DO:
      884       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      885       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      886   END.
      887   END PROCEDURE.
      888   PROCEDURE get-attribute :
      889     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      890     RUN broker-get-attribute IN adm-broker-hdl
      891         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      892     RETURN RETURN-VALUE.
      893   END PROCEDURE.
      894   PROCEDURE get-attribute-list :
      895     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      896     RUN broker-get-attribute-list IN adm-broker-hdl
      897         (INPUT THIS-PROCEDURE,
      898          INPUT ?,
      899          OUTPUT p-attr-list) NO-ERROR.
      900     RETURN.
      901   END PROCEDURE.
      902   PROCEDURE new-state :
      903     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      904     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      905     RETURN.
      906   END PROCEDURE.
      907   PROCEDURE notify :
      908     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      909     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      910     IF RETURN-VALUE = "ADM-ERROR":U THEN
      911         RETURN "ADM-ERROR":U.
      912     RETURN.
      913   END PROCEDURE.
      914   PROCEDURE set-attribute-list :
      915     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      916     RUN ensure-broker.
      917     RUN broker-set-attribute-list IN adm-broker-hdl
      918         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      919     RETURN.
      920   END PROCEDURE.
      921   PROCEDURE set-position :
      922       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      923       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      924       IF VALID-HANDLE(adm-object-hdl) THEN
      925       DO:
      926         ASSIGN adm-object-hdl:ROW    =   p-row
      927                adm-object-hdl:COLUMN =   p-col.
      928       END.
      929       RETURN.
      930   END PROCEDURE.
      931   PROCEDURE adm-display-fields :
      932       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      933       RETURN.
      934   END PROCEDURE.
      935   PROCEDURE adm-open-query :
      936     RETURN.
      937   END PROCEDURE.
      938   PROCEDURE adm-row-changed :
      939         IF VALID-HANDLE(adm-object-hdl) THEN
      940           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      941         RUN notify ('row-available':U).
      942         RETURN.
      943   END PROCEDURE.
      944   PROCEDURE reposition-query :
      945       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      946       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      947       RETURN.
      948   END PROCEDURE.
      949     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      950     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      951     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      952     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      953     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      954     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      955     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      956     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      957     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      958     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      959     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      960     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      961     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      962     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      963     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      964     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      965     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      966     IF "":U = "":U THEN
      967       RUN modify-list-attribute IN adm-broker-hdl
      968         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      969     RUN use-create-on-add(?).
      970   PROCEDURE adm-add-record :
      971       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      972          "must have at least one Enabled Table to perform Add.":U
      973          VIEW-AS ALERT-BOX ERROR.
      974       RETURN.
      975   END PROCEDURE.
      976   PROCEDURE adm-assign-record :
      977    MESSAGE
      978          "Object ":U THIS-PROCEDURE:FILE-NAME
      979            "must have at least one Enabled Table to perform Assign.":U
      980              VIEW-AS ALERT-BOX ERROR.
      981      RETURN.
      982     END PROCEDURE.
      983   PROCEDURE adm-assign-statement :
      984     RETURN.
      985   END PROCEDURE.
      986   PROCEDURE adm-cancel-record :
      987      RETURN.
      988     END PROCEDURE.
      989   PROCEDURE adm-copy-record :
      990       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      991        "must have at least one Enabled Table to perform Copy.":U
      992          VIEW-AS ALERT-BOX ERROR.
      993       RETURN.
      994   END PROCEDURE.
      995   PROCEDURE adm-create-record :
      996      RETURN.
      997   END PROCEDURE.
      998   PROCEDURE adm-current-changed :
      999     RETURN.
     1000   END PROCEDURE.
     1001   PROCEDURE adm-delete-record :
     1002    MESSAGE
     1003          "Object ":U THIS-PROCEDURE:FILE-NAME
     1004            "must have at least one Enabled Table to perform Delete.":U
     1005              VIEW-AS ALERT-BOX ERROR.
     1006       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1007       RETURN.
     1008   END PROCEDURE.
     1009   PROCEDURE adm-disable-fields :
     1010         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1011       RETURN.
     1012   END PROCEDURE.
     1013   PROCEDURE adm-enable-fields :
     1014       RETURN.
     1015   END PROCEDURE.
     1016   PROCEDURE adm-end-update :
     1017     RETURN.
     1018   END PROCEDURE.
     1019   PROCEDURE adm-reset-record :
     1020       RETURN.
     1021   END PROCEDURE.
     1022   PROCEDURE adm-update-record :
     1023       MESSAGE
     1024         "Object ":U THIS-PROCEDURE:FILE-NAME
     1025           "must have at least one Enabled Table to perform Update.":U
     1026             VIEW-AS ALERT-BOX ERROR.
     1027      RETURN.
     1028   END PROCEDURE.
     1029   PROCEDURE check-modified :
     1030   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1031   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1032   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1033   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1034     IF check-state = "check":U THEN
     1035     DO:
     1036       RUN get-link-handle IN adm-broker-hdl
     1037         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1038            OUTPUT group-target-list).
     1039       IF group-target-list NE "":U THEN
     1040       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1041         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1042         RUN check-modified IN curr-widget ('group-check':U).
     1043         IF RETURN-VALUE NE "":U THEN
     1044         DO:
     1045           RUN check-modified-message(RETURN-VALUE).
     1046           RETURN "":U.
     1047         END.
     1048       END.
     1049     END.
     1050     RETURN "":U.
     1051   END PROCEDURE.
     1052   PROCEDURE check-modified-message :
     1053     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1054        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1055           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1056        IF RETURN-VALUE = "YES":U THEN
     1057           RUN notify ('view,CONTAINER-SOURCE':U).
     1058        MESSAGE IF p-changed-table NE ? THEN
     1059           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1060           ELSE "Current values have been changed."
     1061           SKIP "  Do you wish to save those changes?"
     1062           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1063        IF ANS THEN
     1064        DO:
     1065           IF group-assign-target THEN
     1066             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1067           ELSE RUN dispatch('update-record':U).
     1068           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1069           DO:
     1070               MESSAGE "Changes to the previous record were not saved."
     1071                 VIEW-AS ALERT-BOX ERROR.
     1072               IF group-assign-target THEN
     1073                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1074               ELSE RUN dispatch ('cancel-record':U).
     1075           END.
     1076        END.
     1077        ELSE DO:
     1078          IF group-assign-target THEN
     1079             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1080          ELSE RUN dispatch('cancel-record':U).
     1081        END.
     1082        RETURN.
     1083   END PROCEDURE.
     1084   PROCEDURE get-rowid :
     1085       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1086       ASSIGN
     1087       p-table   =   adm-first-table.
     1088       RETURN.
     1089   END PROCEDURE.
     1090   PROCEDURE init-group-assign :
     1091       RUN request-attribute IN adm-broker-hdl
     1092         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1093       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1094         group-assign-target = yes.
     1095       ELSE group-assign-target = no.
     1096       RETURN.
     1097   END PROCEDURE.
     1098   PROCEDURE set-editors :
     1099       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1100       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1101       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1102       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1103       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1104       DO WHILE VALID-HANDLE (curr-widget):
     1105           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1106              curr-widget:HIDDEN = no THEN DO:
     1107             CASE p-field-setting:
     1108               WHEN "INITIALIZE":U THEN
     1109               DO:
     1110                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1111                     read-only-list +
     1112                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1113                        STRING(curr-widget).
     1114               END.
     1115               WHEN "DISABLE":U OR
     1116               WHEN "ENABLE":U THEN
     1117               DO:
     1118                   curr-widget:SENSITIVE = yes.
     1119                   RUN get-attribute ('Read-Only-Editors':U).
     1120                   IF RETURN-VALUE = ? OR
     1121                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1122                       curr-widget:READ-ONLY =
     1123                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1124               END.
     1125               WHEN "CLEAR":U THEN
     1126                   curr-widget:SCREEN-VALUE = "":U.
     1127             END CASE.
     1128           END.
     1129           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1130       END.
     1131       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1132         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1133           + '"':U).
     1134       RETURN.
     1135   END PROCEDURE.
     1136   PROCEDURE use-check-modified-all :
     1137    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1138     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1139     RETURN.
     1140   END PROCEDURE.
     1141   PROCEDURE use-create-on-add :
     1142   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1143      RETURN.
     1144   END PROCEDURE.
     1145   PROCEDURE use-initial-lock :
     1146     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1147     ASSIGN adm-initial-lock = p-attr-value.
     1148     RETURN.
     1149   END PROCEDURE.
     1150     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1151   ASSIGN
     1152          FRAME F-Main:SCROLLABLE       = FALSE
     1153          FRAME F-Main:HIDDEN           = TRUE.
     1154   ASSIGN
     1155          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
     1156   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1157   DO:
     1158       Assign Classify.
     1159       if Classify  Begins "post":U OR
     1160          Classify  Begins "grp-goods":U         then
     1161           enable SumsOnly with frame F-Main .
     1162      if Classify = "no-classify":U
     1163         Then do:
     1164               SumsOnly = FALSE .
     1165               display SumsOnly with frame F-Main .
     1166               disable SumsOnly with frame F-Main .
     1167           end.
     1168      if Classify = "grp-goods":U
     1169            Then do:
     1170               display TOG-lavel   with frame F-Main .
     1171               enable  TOG-lavel   with frame F-Main .
     1172           end.
     1173            Else do:
     1174               display  TOG-lavel  var-Lavel with frame F-Main .
     1175               disable  TOG-lavel  var-Lavel with frame F-Main .
     1176           end.
     1177    if Classify = "post":U
     1178            Then do:
     1179               display TOG-lavel-2   with frame F-Main .
     1180               enable  TOG-lavel-2   with frame F-Main .
     1181           end.
     1182            Else do:
     1183               display  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1184               disable  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1185           end.
     1186   END.
     1187   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1188   DO:
     1189     Assign RadPost.
     1190     for each g#post share-lock : delete g#post. end.
     1191     Case RAdPost :
     1192     when 1 then DO:
     1193             Assign  Postname = 'все':U.
     1194             Display PostName with frame F-Main .
     1195          END.
     1196     when 2 then
     1197           do:
     1198               run ref/cli-all.w
     1199                             ( my-handle
     1200                              , "b-sel,b-mark"
     1201                              , 'про':U
     1202                              , 'все':U
     1203                              , 'текущие':U
     1204                              , ?
     1205                              , ",,,,,,NO,,"
     1206                              , ?
     1207                             , output post-grp_recids ) .
     1208               if post-grp_recids = "" then do:
     1209                    Assign  Postname = 'все':U radpost = 1.
     1210                    Display PostName radpost with frame F-Main .
     1211               end.
     1212               else do:
     1213                   Assign  Postname = ''.
     1214                   DO ii = 1 TO num-entries( post-grp_recids ) :
     1215                       FIND cli-post WHERE recid( cli-post ) = int(entry( ii, post-grp_recids )) NO-LOCK.
     1216                       create g#post.
     1217                       assign
     1218                       g#post.obj-type = cli-post.obj-type
     1219                       g#post.obj-code = cli-post.obj-code
     1220                       g#post.obj-name = cli-post.obj-name
     1221                       Postname = PostName + cli-post.obj-name + chr(10).
     1222                   END.
     1223                    Display PostName with frame F-Main .
     1224               end.
     1225           end.
     1226     End case.
     1227     END.
     1228   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1229   DO:
     1230      Assign tog-lavel.
     1231     if tog-lavel =TRUE
     1232           Then do:
     1233               display  var-Lavel  with frame F-Main .
     1234               enable   var-Lavel  with frame F-Main .
     1235           end.
     1236            Else do:
     1237               display    var-Lavel with frame F-Main .
     1238               disable    var-Lavel with frame F-Main .
     1239           end.
     1240   END.
     1241   ON VALUE-CHANGED OF Tog-lavel-2 IN FRAME F-Main
     1242   DO:
     1243      Assign tog-lavel-2.
     1244     if tog-lavel-2 = TRUE
     1245           Then do:
     1246               display  var-Lavel-2  with frame F-Main .
     1247               enable   var-Lavel-2  with frame F-Main .
     1248           end.
     1249            Else do:
     1250               display    var-Lavel-2 with frame F-Main .
     1251               disable    var-Lavel-2 with frame F-Main .
     1252           end.
     1253   END.
     1254   if not this-procedure :persistent
     1255   then do:
     1256     message
     1257       vss-workfile vss-revision vss-description skip
     1258       "Ошибка при запуске процедуры" skip
     1259       "Данную процедуру следует запускать только с параметром persistent" skip
     1260       view-as alert-box error .
     1261     undo, return error .
     1262   end.
     1263   PROCEDURE disable_UI :
     1264     HIDE FRAME F-Main.
     1265     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1266   END PROCEDURE.
     1267   PROCEDURE local-initialize :
     1268     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1269      Tog-obj:screen-value in frame F-Main = 'yes':U.
     1270       var-lavel:screen-value in frame F-Main = '1'.
     1271       var-lavel-2:screen-value in frame F-Main = '1'.
     1272       show-discnt:screen-value in frame F-Main = 'yes'.
     1273   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1274   run create_obj-list in this-procedure
     1275    ( input v-cntxt-obj-type ,
     1276      input v-cntxt-obj-code )
     1277      .
     1278   END PROCEDURE.
     1279   PROCEDURE my-report :
     1280    run rep/r-obcl.p
     1281                    (input v-cntxt-obj-code ,
     1282                     input v-cntxt-obj-type ,
     1283                     input base-type  ,
     1284                     input base-code  ,
     1285                     serv, ? , ? ,PostName, ?, rADPost, Show-discnt  ,? ,
     1286                     input Classify   ,
     1287                     input SortType   ,
     1288                     input SumsOnly   ,
     1289                     input ShowZero   ,
     1290                     input tog-obj    ,
     1291                     ?   ,
     1292                     ?   ,
     1293                     input tog-lavel  ,
     1294                     input var-lavel  ,
     1295                     input tog-lavel-2  ,
     1296                     input var-lavel-2  ) .
     1297   END PROCEDURE.
     1298   PROCEDURE my-var :
     1299   assign frame F-Main
     1300   PostName  RADPost
     1301    ShowZero Classify  SortType  SumsOnly Tog-obj serv
     1302   Tog-lavel  var-lavel Tog-lavel-2  Var-lavel-2 Show-discnt .
     1303   ReportNAme = "Оборотная ведомость по контрагентам " .
     1304   def var t-class as char no-undo.
     1305   def var t-sort as char no-undo.
     1306     case classify:
     1307       when "no-classify":u    then t-class =   "Без классификации" .
     1308       when "prod":u           then t-class =   "Производители"   .
     1309       when "post":u           then t-class =   "Поставщики"   .
     1310       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1311       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1312       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1313       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1314       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1315       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1316       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1317       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1318       when  "t-level":u       then t-class =   "Терминальные группы" .
     1319    end case.
     1320     case sorttype:
     1321       when "sort-pp":u               then t-sort =   "по порядку" .
     1322       when "sort-code":u             then t-sort =   "по коду" .
     1323       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1324       when "sort-qunty":u            then t-sort =   "по реализации".
     1325       when "sort-name":u             then t-sort =   "по наименованию".
     1326       when "sort-type":u             then t-sort =   "по типу ткани".
     1327       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1328       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1329    end case.
     1330   ReportHeader = "Контрагенты : " + PostName + chr(10).
     1331   ReportHeader = ReportHeader + "Классификация : " + t-Class.
     1332   ReportHeader = ReportHeader +
     1333                  (if tog-lavel  then "    Итоги с уровня товаров "  + String(var-lavel)  else " "    ).
     1334   ReportHeader = ReportHeader +
     1335                  (if tog-lavel-2  then "    Итоги с уровня контрагентов "  + String(var-lavel-2)  else " "    ).
     1336   ReportHeader = ReportHeader  + chr(10).
     1337   ReportHeader = ReportHeader +
     1338                  "Сортировка " + t-Sort + chr(10) +
     1339                  "Показать : " +
     1340                  (if SumsOnly     then "Только итоги, "  else " "             ) +
     1341                  (if Show-Cost     then "Суммы в учетных ценах, "  else " "    ) +
     1342                  (if Show-Crsa     then "Суммы в продажных ценах, "  else " "  ) +
     1343                  (if Show-Sale then "Суммы в ценах документа, "  else " " ) +
     1344                  (if Show-discnt then " + Скидки "  else " " ) +
     1345                  (if ShowZero     then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) .
     1346    sheetf.Excel-Column-Lable = "Код,Артикул,Название товара ,Ед.изм,т/у,Приход,,Расход,,Возврат,,Возврат поставщику,, " + chr(10).
     1347    sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",,,,,количество,сумма,количество,сумма,количество,сумма,количество,сумма,".
     1348    sheetf.Sizes = "10,16,60,7,3,13,13,13,13,13,13,13,13,".
     1349   END PROCEDURE.
