      968   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
      969     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      970     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
      971     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      972   END FUNCTION.
      973   PROCEDURE get-month-name-case :
      974     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      975     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
      976     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      977     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
      978       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
      979         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
      980         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
      981         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
      982         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
      983         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
      984     DO ON ERROR UNDO, RETURN ERROR :
      985       IF p-month < 1 OR p-month > 12 OR
      986          p-case  < 1 OR p-case  >  6 THEN DO:
      987         ASSIGN p-name = ?.
      988       END.                           ELSE DO:
      989         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
      990       END.
      991     END.
      992   END PROCEDURE.
      993   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
      994     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
      995     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
      996     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
      997   END FUNCTION.
      998   PROCEDURE get-sparsed-string :
      999     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     1000     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     1001     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     1002     DO ON ERROR UNDO, RETURN ERROR :
     1003       DO jj = 1 TO LENGTH( p-instring ) :
     1004         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
     1005       END.
     1006       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
     1007     END.
     1008   END PROCEDURE.
     1009   function OutDec returns character ( input p-sum  as decimal
     1010                                     , input p-hide as logical ) :
     1011     define variable v-sum as character no-undo .
     1012     run dec2char in this-procedure
     1013       (  input p-sum
     1014       ,  input p-hide
     1015       , output v-sum
     1016       ) no-error.
     1017     return ( if error-status :error then '':U else v-sum ) .
     1018   end function.
     1019   function CenterLine returns character ( input p-in-string as character
     1020                                         , input p-rep-width as integer ) :
     1021     define variable v-out-string as character no-undo .
     1022     run get-center-line in this-procedure
     1023       (  input p-in-string
     1024       ,  input p-rep-width
     1025       , output v-out-string
     1026       ) no-error .
     1027     return ( if error-status :error then '':U else v-out-string ) .
     1028   end function.
     1029   function OutQty returns character ( input p-qty  as decimal
     1030                                     , input p-hide as logical ) :
     1031     define variable v-qty as character no-undo .
     1032     run get-dec-string in this-procedure
     1033       (  input p-qty
     1034       ,  input 3
     1035       ,  input p-hide
     1036       , output v-qty
     1037       ) no-error.
     1038     return ( if error-status :error then '':U else v-qty ) .
     1039   end function.
     1040   function OutSum returns character ( input p-sum  as decimal
     1041                                     , input p-hide as logical ) :
     1042     define variable v-sum as character no-undo .
     1043     run get-dec-string in this-procedure
     1044       (  input p-sum
     1045       ,  input 2
     1046       ,  input p-hide
     1047       , output v-sum
     1048       ) no-error.
     1049     return ( if error-status :error then '':U else v-sum ) .
     1050   end function.
     1051   define stream s-out .
     1052   do
     1053   on error undo, return error return-value
     1054   :
     1055     run WaitFram-Show in this-procedure
     1056       ( input 'Идет формирование отчета, ждите...'
     1057       ) .
     1058     run get-report-num  in p-parent-proc
     1059       (
     1060         output g#report-num
     1061       ) .
     1062     run get-quest-print in p-parent-proc
     1063       (
     1064         output g#quest-print
     1065       ) .
     1066     find first bf_trn-doc no-lock where
     1067         recid( bf_trn-doc ) = p-rec-invent no-error .
     1068     if not available bf_trn-doc
     1069     then do:
     1070       run waitfram-hide in this-procedure .
