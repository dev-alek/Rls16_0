        1   block-level on error undo, throw.
        2   define input parameter p-parent-proc as widget-handle no-undo .
        3   define input parameter p-rec-invent  as recid         no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision: 0ec5d11e52eb, 2015, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Wed Sep 18 21:05:06 2019 +0300 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: r-orsvx1.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: rep/r-orsvx1.p $":U .
        9   define variable vss-description as character no-undo initial "Сличительная ведомость результатов инвентаризации нефтепродуктов (Орел)":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       76   define  shared variable RepPathName        as character no-undo .
       77   define  shared variable PrintRubl          as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define variable v-waitfram-action01         as character   no-undo .
       80   define variable v-waitfram-action02         as character   no-undo .
       81   define variable v-waitfram-action03         as character   no-undo .
       82   define variable mWaitFramTextBeg            as character   no-undo.
       83   define variable mWaitFramTextEnd            as character   no-undo.
       84   define variable mWaitFramView               as logical     no-undo.
       85   define variable mWaitProcEvent              as logical     no-undo init yes.
       86   define variable mWaitFramInterval           as integer     no-undo init 1 .
       87   define variable mWaitFramStop               as logical     no-undo.
       88   define variable mWaitFramStopUser           as logical     no-undo.
       89   define variable mWaitFramStopTimeOut        as logical     no-undo.
       90   define variable mWaitFramStartProc          as datetime-tz no-undo.
       91   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       92   define button B-WaitFramStop auto-end-key
       93        label "Стоп"
       94        size 10 by 1 tooltip "Остоновить процесс".
       95   define button B-viewProcInfo
       96        label "Информация"
       97        size 15 by 1 tooltip "Информация о процесс".
       98   define frame waitfram
       99     v-waitfram-action01 format "x(72)" no-label skip
      100     v-waitfram-action02 format "x(72)" no-label skip
      101     v-waitfram-action03 format "x(72)" no-label skip
      102     B-viewProcInfo
      103     B-WaitFramStop at row 4 col 30
      104     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      105     .
      106   define new global shared variable mBatchMode as logical no-undo init ?.
      107   define variable mFramBachModHandle as handle no-undo.
      108   mFramBachModHandle = frame waitfram:handle.
      109   define variable mFameOldVis as logical no-undo.
      110   define variable mVisCUrentVin as logical no-undo.
      111   if session:batch-mode
      112   then
      113      mBatchMode = yes.
      114   if mBatchMode = ? then do:
      115     mVisCUrentVin = current-window:visible.
      116     mFameOldVis = mFramBachModHandle:visible.
      117     mFramBachModHandle:visible  = yes.
      118     mBatchMode = mFramBachModHandle:visible ne yes.
      119     mFramBachModHandle:visible = mFameOldVis.
      120     current-window:visible = mVisCUrentVin.
      121   end.
      122    if  log-manager:logfile-name ne ?
      123     then DO:
      124         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      125         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      126         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      127     end.
      128   on choose of B-WaitFramStop in frame waitfram
      129   do:
      130     mWaitFramStop = yes.
      131     mWaitFramStopUser = yes.
      132   end.
      133   function waitfram-check-timeout returns logical():
      134      define variable vtime as int64 no-undo.
      135      if mWaitFramStopTimeOut
      136      then
      137         return yes.
      138      vtime = ( now - mWaitFramStartProc ) / 1000 .
      139      if     mWaitFramTimeOut ne ?
      140         and mWaitFramTimeOut ne 0
      141         and mWaitFramTimeOut lt vtime
      142      then do:
      143         mWaitFramStopTimeOut = yes.
      144      end.
      145      return mWaitFramStopTimeOut.
      146   end.
      147   procedure waitfram-hide :
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       pause 0 before-hide .
      153       if not mBatchMode then
      154         hide frame waitfram .
      155     if     not mWaitFramView
      156        and mWaitProcEvent
      157     then
      158       process events .
      159     end.
      160   end procedure.
      161   procedure waitfram-show :
      162     define input  parameter p-message as character no-undo .
      163     define variable v-left-margin as integer   no-undo .
      164     if not session:batch-mode
      165     then do
      166     on error undo, return error return-value
      167     :
      168       if length(p-message) <= 70 then do:
      169         assign
      170           v-left-margin = integer((70 - length(p-message)) / 2)
      171         .
      172         assign
      173           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      174         .
      175         assign
      176           v-waitfram-action01 = " "
      177           v-waitfram-action02 = " "
      178                                    + fill(" ", v-left-margin)
      179                                    + p-message
      180           v-waitfram-action03 = " "
      181         .
      182       end.
      183       else do:
      184         define variable vRindex1 as integer no-undo.
      185         define variable vRindex2 as integer no-undo.
      186         vRindex1 = r-index(p-message," ",70).
      187         if vRindex1 = 0
      188         then
      189            vRindex1 = 70.
      190         if length(p-message)  <= vRindex1 + 70 then do:
      191           assign
      192             v-waitfram-action01 = " "
      193             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      195           .
      196         end.
      197         else do:
      198           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      199           if vRindex2 <= vRindex1
      200           then
      201              vRindex2 = vRindex1 + 70.
      202           assign
      203             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      204             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      205             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      206           .
      207         end.
      208       end.
      209       B-viewProcInfo:visible   in frame waitfram = no.
      210       B-viewProcInfo:sensitive in frame waitfram = no.
      211       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      212       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       if  (   mWaitFramView
      214          or  mWaitProcEvent)
      215          and not mBatchMode
      216       then
      217          display
      218             v-waitfram-action01 skip
      219             v-waitfram-action02 skip
      220             v-waitfram-action03 skip
      221          with frame waitfram .
      222       if     mWaitFramView
      223          then do:
      224             if     mWaitFramInterval ne ?
      225                and not mBatchMode
      226             then
      227                wait-for go of frame waitfram pause mWaitFramInterval.
      228          end.
      229          else
      230             if     mWaitProcEvent
      231                and not mBatchMode
      232             then
      233                process events .
      234     end.
      235   end procedure.
      236      procedure waitfram-show-this:
      237         define input  parameter iInterval as int64 no-undo.
      238         define variable vtime as int64 no-undo.
      239         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      240         mWaitFramInterval = iInterval.
      241         run waitfram-show (substitute("&1&2 &3&4" ,
      242                                       mWaitFramTextBeg ,
      243                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      244                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      245                                       mWaitFramTextEnd
      246                                      )
      247                           ).
      248      end.
      249      procedure WaitFramRunPause:
      250         define input  parameter iInterval as dec no-undo.
      251         define variable vStart  as datetime-tz no-undo.
      252         define variable vend    as datetime-tz no-undo.
      253         define variable vint as int64 no-undo.
      254         define variable vOk as logical no-undo.
      255         vStart = now.
      256         vend   = vStart.
      257         publish "WaitFramPause" (iInterval,output vOk).
      258         vend   =  now.
      259         vint = vend - vStart.
      260         vint = iInterval - vint / 1000.
      261         if     not mWaitFramStop
      262            and (   vint > 0
      263                 or (    not vOk
      264                     and iInterval eq ?
      265                     )
      266                 )
      267         then
      268            run waitfram-show-this (iInterval).
      269         vend   =  now.
      270         vint = vend - vStart.
      271         vint = iInterval - vint / 1000.
      272         if     not mWaitFramStop
      273            and vint > 0
      274         then do:
      275            run gbl/pause.p (vint * 1000).
      276         end.
      277         if iInterval ne ?
      278         then
      279            publish "WaitFramStop".
      280         waitfram-check-timeout().
      281      end.
      282      procedure WaitFramWaitFor:
      283         define input  parameter iInterval as dec no-undo.
      284         assign
      285            mWaitFramStartProc   = now
      286            mWaitFramStopUser    = no
      287            mWaitFramStopTimeOut = no
      288         .
      289         block-wait:
      290         do while not mWaitFramStop:
      291            run WaitFramRunPause (iInterval).
      292            if  waitfram-check-timeout()
      293            then do:
      294               leave block-wait.
      295            end.
      296         end.
      297         run waitfram-hide.
      298      end.
      299   procedure waitfram-join :
      300     define input  parameter p-line-1  as character no-undo .
      301     define input  parameter p-line-2  as character no-undo .
      302     define input  parameter p-line-3  as character no-undo .
      303     define output parameter p-message as character no-undo .
      304     do
      305     on error undo, return error return-value
      306     :
      307       assign
      308         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      309                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      311       .
      312     end.
      313   end procedure.
      314   function waitfram-join-function returns character
      315     (input p-line-1 as character
      316     ,input p-line-2 as character
      317     ,input p-line-3 as character
      318     ).
      319     define variable v-message as character no-undo .
      320     run waitfram-join in this-procedure
      321       (input  p-line-1
      322       ,input  p-line-2
      323       ,input  p-line-3
      324       ,output v-message
      325       ) .
      326     return v-message .
      327   end function .
      328   define variable g#report-num  as integer no-undo .
      329   define variable g#quest-print as logical no-undo .
      330   define variable g#log         as logical no-undo .
      331   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      332   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      333   procedure paramls-clear :
      334     define buffer buf_temp-param for temp-param .
      335     do
      336     on error undo, return error return-value
      337     :
      338       for each buf_temp-param
      339       on error undo, return error
      340       :
      341         delete buf_temp-param .
      342       end.
      343     end.
      344   end procedure.
      345   procedure paramls-write :
      346     define input  parameter p-code     as character no-undo .
      347     define input  parameter p-sub-code as character no-undo .
      348     define input  parameter p-value    as character no-undo .
      349     define buffer buf_temp-param for temp-param .
      350     do
      351     on error undo, return error return-value
      352     :
      353       find first buf_temp-param
      354         where buf_temp-param.param-code     = p-code
      355           and buf_temp-param.param-sub-code = p-sub-code
      356         no-error .
      357       if not available buf_temp-param then do:
      358         create buf_temp-param .
      359         assign
      360           buf_temp-param.param-code     = p-code
      361           buf_temp-param.param-sub-code = p-sub-code
      362         .
      363       end.
      364       assign
      365         buf_temp-param.param-value = p-value
      366       .
      367     end.
      368   end procedure.
      369   procedure paramls-read :
      370     define input  parameter p-code          as character no-undo .
      371     define input  parameter p-sub-code      as character no-undo .
      372     define input  parameter p-default-value as character no-undo .
      373     define output parameter p-value         as character no-undo .
      374     define buffer buf_temp-param for temp-param .
      375     do
      376     on error undo, return error return-value
      377     :
      378       find first buf_temp-param
      379         where buf_temp-param.param-code     = p-code
      380           and buf_temp-param.param-sub-code = p-sub-code
      381         no-error .
      382       if available buf_temp-param then do:
      383         assign
      384           p-value = buf_temp-param.param-value
      385         .
      386       end.
      387       else do:
      388         assign
      389           p-value = p-default-value
      390         .
      391       end.
      392     end.
      393   end procedure.
      394   procedure paramls-append :
      395     define input  parameter p-code     as character no-undo .
      396     define input  parameter p-sub-code as character no-undo .
      397     define input  parameter p-value    as character no-undo .
      398     define buffer buf_temp-param for temp-param .
      399     do
      400     on error undo, return error return-value
      401     :
      402       find first buf_temp-param
      403            where buf_temp-param.param-code     = p-code
      404              and buf_temp-param.param-sub-code = p-sub-code
      405         no-error .
      406       if not available buf_temp-param then do:
      407         create buf_temp-param .
      408         assign
      409           buf_temp-param.param-code     = p-code
      410           buf_temp-param.param-sub-code = p-sub-code
      411           buf_temp-param.param-value    = p-value
      412         .
      413       end.
      414       else do:
      415           assign
      416               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      417           .
      418       end.
      419     end.
      420   end procedure.
      421   define variable vss-include-info3 as character no-undo format "x(65)":U
      422     initial "@(#)$Workfile$ $Revision$":U .
      423   define stream excel-line .
      424   define stream excel-cell .
      425   define temp-table temp_cell-data no-undo
      426     field data-key   as character
      427     field data-value as character
      428     index pi         is primary   unique data-key
      429   .
      430   define temp-table temp_line-data no-undo
      431     field data-key   as character
      432     field xl-line-id as integer
      433     field Num        as integer
      434     field Name       as character
      435     field artic      as character
      436     field locate     as character
      437     field EdIzm      as character
      438     field Price      as character
      439     field ExtraQnty  as character
      440     field ExtraSum   as character
      441     field MissQnty   as character
      442     field MissSum    as character
      443     field LossQnty   as character
      444     field LossSum    as character
      445     field NormQnty   as character
      446     field NormSum    as character
      447     field XcalcQnty  as character
      448     field XcalcSum   as character
      449     field LcalcQnty  as character
      450     field LcalcSum   as character
      451     index pi         is primary   unique xl-line-id
      452   .
      453   define variable v-r-orsvxl-current-data-row as integer   no-undo .
      454   define variable v-r-orsvxl-cell-file-name   as character no-undo .
      455   define variable v-r-orsvxl-data-file-name   as character no-undo .
      456   procedure r-orsvxl-init :
      457     define buffer buf_temp_cell-data for temp_cell-data .
      458     define buffer buf_usr-flt        for ubflt.usr-flt .
      459     do
      460     for buf_temp_cell-data
      461       , buf_usr-flt
      462     on error undo, return error
      463     :
      464       assign
      465         v-r-orsvxl-current-data-row = 0
      466       .
      467       run gbl/_tmpfile.p
      468         ( input "xd"
      469         , input ".txt"
      470         , output v-r-orsvxl-data-file-name
      471         ) .
      472       output stream excel-line to value( v-r-orsvxl-data-file-name ) .
      473       run gbl/_tmpfile.p
      474         ( input "xc"
      475         , input ".txt"
      476         , output v-r-orsvxl-cell-file-name
      477         ) .
      478       output stream excel-cell to value( v-r-orsvxl-cell-file-name ) .
      479       run r-orsvxl-write-cell-data in this-procedure
      480         ( input "valutCode":U
      481         , input "0":U
      482         ) .
      483       run r-orsvxl-write-cell-data in this-procedure
      484         ( input "columnList":U
      485         , input "Num,Name,artic,locate,EdIzm,Price,ExtraQnty,ExtraSum,MissQnty,MissSum,":U
      486         +       "LossQnty,LossSum,NormQnty,NormSum,XcalcQnty,XcalcSum,LcalcQnty,LcalcSum":U
      487         ) .
      488       run r-orsvxl-write-cell-data in this-procedure
      489         ( input "columnType":U
      490         , input "I,S,S,I,S,C,D,C,D,C,D,C,D,C,D,C,D,C":U
      491         ) .
      492       run r-orsvxl-write-cell-data in this-procedure
      493         ( input "columnAmount":U
      494         , input "18":U
      495         ) .
      496     end.
      497   end procedure.
      498   procedure r-orsvxl-close :
      499     do
      500     on error undo, return error
      501     :
      502       output stream excel-line close .
      503       output stream excel-cell close .
      504       output to value( string( session :temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append .
      505       export "exe/t33np_97.xlt":U .
      506       export "exe/t_97.bas":U .
      507       export v-r-orsvxl-cell-file-name .
      508       export v-r-orsvxl-data-file-name .
      509       output close .
      510     end.
      511   end procedure.
      512   procedure r-orsvxl-write-cell-data :
      513     define input parameter p-data-key   as character no-undo .
      514     define input parameter p-data-value as character no-undo .
      515     define buffer buf_temp_cell-data for temp_cell-data .
      516     do
      517     for buf_temp_cell-data
      518     on error undo, return error
      519     :
      520       find first buf_temp_cell-data where
      521                  buf_temp_cell-data.data-key = p-data-key no-error.
      522       if not available buf_temp_cell-data
      523       then do:
      524         create buf_temp_cell-data .
      525         assign
      526           buf_temp_cell-data.data-key = p-data-key
      527         .
      528       end.
      529       assign
      530         buf_temp_cell-data.data-value = p-data-value
      531       .
      532       put stream excel-cell unformatted
      533         buf_temp_cell-data.data-key   chr(9)
      534         buf_temp_cell-data.data-value chr(10)
      535       .
      536     end.
      537   end procedure.
      538   procedure r-orsvxl-write-line-data :
      539     define input parameter p-Num       as integer   no-undo .
      540     define input parameter p-Name      as character no-undo .
      541     define input parameter p-artic     as character no-undo .
      542     define input parameter p-locate    as character no-undo .
      543     define input parameter p-EdIzm     as character no-undo .
      544     define input parameter p-Price     as character no-undo .
      545     define input parameter p-ExtraQnty as character no-undo .
      546     define input parameter p-ExtraSum  as character no-undo .
      547     define input parameter p-MissQnty  as character no-undo .
      548     define input parameter p-MissSum   as character no-undo .
      549     define input parameter p-LossQnty  as character no-undo .
      550     define input parameter p-LossSum   as character no-undo .
      551     define input parameter p-NormQnty  as character no-undo .
      552     define input parameter p-NormSum   as character no-undo .
      553     define input parameter p-XcalcQnty as character no-undo .
      554     define input parameter p-XcalcSum  as character no-undo .
      555     define input parameter p-LcalcQnty as character no-undo .
      556     define input parameter p-LcalcSum  as character no-undo .
      557     define buffer buf_temp_line-data for temp_line-data .
      558     do
      559     for buf_temp_line-data
      560     on error undo, return error
      561     :
      562       for each buf_temp_line-data
      563       :
      564         delete buf_temp_line-data .
      565       end.
      566       create buf_temp_line-data .
      567       assign
      568         v-r-orsvxl-current-data-row = v-r-orsvxl-current-data-row + 1
      569       .
      570       assign
      571         buf_temp_line-data.data-key   = "LD":U
      572         buf_temp_line-data.xl-line-id = v-r-orsvxl-current-data-row
      573         buf_temp_line-data.Num        = p-Num
      574         buf_temp_line-data.Name       = p-Name
      575         buf_temp_line-data.artic      = p-artic
      576         buf_temp_line-data.locate     = p-locate
      577         buf_temp_line-data.EdIzm      = p-EdIzm
      578         buf_temp_line-data.Price      = p-Price
      579         buf_temp_line-data.ExtraQnty  = p-ExtraQnty
      580         buf_temp_line-data.ExtraSum   = p-ExtraSum
      581         buf_temp_line-data.MissQnty   = p-MissQnty
      582         buf_temp_line-data.MissSum    = p-MissSum
      583         buf_temp_line-data.LossQnty   = p-LossQnty
      584         buf_temp_line-data.LossSum    = p-LossSum
      585         buf_temp_line-data.NormQnty   = p-NormQnty
      586         buf_temp_line-data.NormSum    = p-NormSum
      587         buf_temp_line-data.XcalcQnty  = p-XcalcQnty
      588         buf_temp_line-data.XcalcSum   = p-XcalcSum
      589         buf_temp_line-data.LcalcQnty  = p-LcalcQnty
      590         buf_temp_line-data.LcalcSum   = p-LcalcSum
      591       .
      592       put stream excel-line unformatted
      593         buf_temp_line-data.data-key  chr(9)
      594         buf_temp_line-data.Num       chr(9)
      595         buf_temp_line-data.Name      chr(9)
      596         buf_temp_line-data.artic     chr(9)
      597         buf_temp_line-data.locate    chr(9)
      598         buf_temp_line-data.EdIzm     chr(9)
      599         buf_temp_line-data.Price     chr(9)
      600         buf_temp_line-data.ExtraQnty chr(9)
      601         buf_temp_line-data.ExtraSum  chr(9)
      602         buf_temp_line-data.MissQnty  chr(9)
      603         buf_temp_line-data.MissSum   chr(9)
      604         buf_temp_line-data.LossQnty  chr(9)
      605         buf_temp_line-data.LossSum   chr(9)
      606         buf_temp_line-data.NormQnty  chr(9)
      607         buf_temp_line-data.NormSum   chr(9)
      608         buf_temp_line-data.XcalcQnty chr(9)
      609         buf_temp_line-data.XcalcSum  chr(9)
      610         buf_temp_line-data.LcalcQnty chr(9)
      611         buf_temp_line-data.LcalcSum  chr(10)
      612       .
      613     end.
      614   end procedure.
      615   procedure r-orsvxl-run-excel :
      616     define input parameter p-header-filename as character no-undo .
      617     define input parameter p-data-filename   as character no-undo .
      618     define variable v-template-file-name as character no-undo .
      619     define variable v-vb-file-name       as character no-undo .
      620     define buffer buf_temp-param for temp-param .
      621     do
      622     for buf_temp-param
      623     on error undo, return error
      624     :
      625       create buf_temp-param.
      626       assign
      627         v-template-file-name = search( "exe/t33np_97.xlt" )
      628         v-vb-file-name       = search( "exe/t_97.bas" )
      629       .
      630       if v-template-file-name = ? or
      631          v-template-file-name = "":U
      632       then do:
      633         message
      634           "Ошибка имени файла шаблона."
      635         view-as alert-box error .
      636       end.
      637       if v-vb-file-name = ? or
      638          v-vb-file-name = "":U
      639       then do:
      640         message
      641           "Ошибка имени файла кода обработки."
      642         view-as alert-box error .
      643       end.
      644       run paramls-write in this-procedure
      645         ( input "template":U
      646         , input "template-file-name":U
      647         , input v-template-file-name
      648         ) .
      649       run paramls-write in this-procedure
      650         ( input "template":U
      651         , input "vb-file-name":U
      652         , input v-vb-file-name
      653         ) .
      654       run paramls-write in this-procedure
      655         ( input "data":U
      656         , input "data-header-filename":U
      657         , input p-header-filename
      658         ) .
      659       run paramls-write in this-procedure
      660         ( input "data":U
      661         , input "data-filename":U
      662         , input p-data-filename
      663         ) .
      664       run gbl/macroxlt.p
      665         ( input-output table buf_temp-param
      666         ) no-error .
      667       if error-status :error
      668       then do:
      669         message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      670                 "Ошибка создания файла Excel."  skip( 0 )
      671                 return-value                    skip( 0 )
      672                 trim( error-status :get-message( 1 ) )
      673                 trim( error-status :get-message( 2 ) )
      674                 trim( error-status :get-message( 3 ) )
      675         view-as alert-box error .
      676         undo, return error .
      677       end.
      678     end.
      679   end procedure.
      680   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      683   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
      684   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
      685   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
      686   define variable ptrlprop-autopump      as logical   no-undo initial false .
      687   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
      688   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
      689   define variable ptrlprop-olddens       as logical   no-undo initial false .
      690   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
      691   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
      692   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
      693   define variable ptrlprop-algoincome as integer no-undo init 0.
      694   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
      695   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
      696   define variable ptrlprop-Delta-mass-vert       as character no-undo .
      697   define variable ptrlprop-calc-free-vol as logical no-undo init false.
      698   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
      699   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
      700   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
      701   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
      702   define variable ptrlprop-block-nozzle as logical no-undo init false.
      703   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
      704   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
      705   procedure get-ptrl-prop :
      706     define input  parameter p-obj-type as character no-undo .
      707     define input  parameter p-obj-code as integer   no-undo .
      708     do
      709     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      710     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
      711     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
      712     :
      713       define variable par-type          as character no-undo.
      714       define variable v-value-character as character no-undo .
      715       define variable v-value-date      as date      no-undo .
      716       define variable v-value-decimal   as decimal   no-undo .
      717       define variable v-value-integer   as integer   no-undo .
      718       define variable v-value-logical   as logical   no-undo .
      719       for each thbjattr_thbj-attr
      720       :
      721         delete thbjattr_thbj-attr .
      722       end.
      723       run adm/shattri.p
      724         ( input "get":U
      725         , input p-obj-type
      726         , input p-obj-code
      727         , input 'petrol':U
      728         , input  ""
      729         , output v-value-character
      730         , output v-value-date
      731         , output v-value-decimal
      732         , output v-value-integer
      733         , output v-value-logical
      734         , output par-type
      735         , input-output table thbjattr_thbj-attr
      736         ) no-error .
      737       for each thbjattr_thbj-attr
      738       on error undo, return error return-value
      739       :
      740         case thbjattr_thbj-attr.prop-code :
      741           when 'denstclc':U then do:
      742             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      743               assign
      744                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
      745               .
      746             end.
      747           end.
      748           when 'expptrl':U then do:
      749             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      750               and thbjattr_thbj-attr.prop-value-type = 'character':U
      751             then do:
      752               assign
      753                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
      754               .
      755             end.
      756           end.
      757           when 'inpptrl':U then do:
      758             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
      759               and thbjattr_thbj-attr.prop-value-type = 'character':U
      760             then do:
      761               assign
      762                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
      763               .
      764             end.
      765           end.
      766           when 'autopump':U then do:
      767             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      768               assign
      769                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
      770               .
      771             end.
      772           end.
      773           when 'rvsnmter':U then do:
      774             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      775               assign
      776                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
      777               .
      778             end.
      779           end.
      780           when 'avtinvpm':U then do:
      781             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      782               assign
      783                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
      784               .
      785             end.
      786           end.
      787           when 'invclipt':U then do:
      788             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      789               assign
      790                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
      791               .
      792             end.
      793           end.
      794           when 'olddens':U then do:
      795             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      796               assign
      797                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
      798               .
      799             end.
      800           end.
      801           when 'algrvspt':U then do:
      802             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      803               assign
      804                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
      805               .
      806             end.
      807           end.
      808           when 'temp-for-pomi':U then do:
      809             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      810               assign
      811                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
      812               .
      813             end.
      814           end.
      815           when 'algoincome':U then do:
      816             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      817               assign
      818                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
      819               .
      820             end.
      821           end.
      822           when 'mand-choice-autocar':U then do:
      823             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      824               assign
      825                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
      826               .
      827             end.
      828           end.
      829           when 'block-nozzle':U then do:
      830             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      831               assign
      832                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
      833               .
      834             end.
      835           end.
      836           when 'timeout-block-nozzle':U then do:
      837             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      838               assign
      839                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
      840               .
      841             end.
      842           end.
      843           when 'Delta-mass-horiz':U then do:
      844             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      845               assign
      846                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
      847               .
      848             end.
      849           end.
      850           when 'Delta-mass-vert':U then do:
      851             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
      852               assign
      853                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
      854               .
      855             end.
      856           end.
      857           when 'calc-free-vol':U then do:
      858             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      859               assign
      860                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
      861               .
      862             end.
      863           end.
      864           when 'calc-free-vol-sug':U then do:
      865             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      866               assign
      867                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
      868               .
      869             end.
      870           end.
      871           when 'trn-reas-sug':U then do:
      872             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      873               assign
      874                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
      875               .
      876             end.
      877           end.
      878                 when 'rvd-own-nb':U then do:
      879             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
      880               assign
      881                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
      882               .
      883             end.
      884           end.
      885           when 'qr-scan-time':U then do:
      886             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      887               assign
      888                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
      889               .
      890             end.
      891           end.
      892           when 'autopump-skip-time':U then do:
      893             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
      894               assign
      895                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
      896               .
      897             end.
      898           end.
      899         end case.
      900         delete thbjattr_thbj-attr .
      901       end.
      902     end.
      903     return .
      904   end procedure.
