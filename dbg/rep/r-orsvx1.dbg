     1455       '                                                                                                                   '
     1456       '                                    (подпись)'                                                  skip
     1457     .
     1458     run waitfram-hide  in this-procedure .
     1459     run r-orsvxl-close in this-procedure .
     1460     output stream s-out close .
     1461   if g#quest-print = false
     1462   then do:
     1463     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1464                                         7, (if 2 >= 8 then 2 else 0), 0, 0,
     1465                                         OUTPUT g#log ).
     1466   end.
     1467   else do:
     1468     os-command silent
     1469       value( "COPY /b " +
     1470         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1471         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1472         string( session:temp-directory) +  "$" + string( g#report-num )
     1473                 ) .
     1474     os-command silent
     1475       value( "COPY /b " +
     1476         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1477         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1478         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1479                 ) .
     1480   end.
     1481   end.
     1482   procedure dec2char :
     1483     define  input parameter p-dec  as decimal   no-undo .
     1484     define  input parameter p-hide as logical   no-undo .
     1485     define output parameter p-char as character no-undo .
     1486     do
     1487     on error undo, return error return-value
     1488     :
     1489       if p-dec  = ?
     1490       then do:
     1491         assign
     1492           p-char = "":U
     1493         .
     1494       end.
     1495       else
     1496       if p-dec  = 0.00 and
     1497          p-hide = yes
     1498       then do:
     1499         assign
     1500           p-char = "":U
     1501         .
     1502       end.
     1503       else do:
     1504         assign
     1505           p-char = trim( string( p-dec,  "->>>>>>>>>>>>>9.9<<<<<<<<<":U ) )
     1506         .
     1507       end.
     1508     end.
     1509   end procedure.
     1510   procedure get-center-line :
     1511     define  input parameter p-in-string  as character no-undo .
     1512     define  input parameter p-rep-width  as integer   no-undo .
     1513     define output parameter p-out-string as character no-undo .
     1514     do
     1515     on error undo, return error return-value
     1516     :
     1517       if length( p-in-string ) < p-rep-width
     1518       then do:
     1519         assign
     1520           p-out-string = fill( ' ':U, integer( ( p-rep-width - length( p-in-string ) ) * 0.5 ) ) + p-in-string
     1521         .
     1522       end.
     1523       else do:
     1524         assign
     1525           p-out-string = p-in-string
     1526         .
     1527       end.
     1528     end.
     1529   end procedure.
     1530   procedure get-dec-string :
     1531     define  input parameter p-dec  as decimal   no-undo .
     1532     define  input parameter p-int  as integer   no-undo .
     1533     define  input parameter p-hide as logical   no-undo .
     1534     define output parameter p-char as character no-undo .
     1535     do
     1536     on error undo, return error return-value
     1537     :
     1538       if p-dec  = ?
     1539       then do:
     1540         assign
     1541           p-char = "":U
     1542         .
     1543       end.
     1544       else
     1545       if p-dec  = 0.00 and
     1546          p-hide = yes
     1547       then do:
     1548         assign
     1549           p-char = "":U
     1550         .
     1551       end.
     1552       else do:
     1553         if p-int = 3
     1554         then do:
     1555           assign
     1556             p-char = trim( string( p-dec, "->>>>>>9.999":U ) )
     1557             p-char = fill( ' ':U, 12 - length( p-char ) ) + p-char
     1558           .
     1559         end.
     1560         else do:
     1561           assign
     1562             p-char = trim( string( p-dec, "->>>>>>9.99":U ) )
     1563             p-char = fill( ' ':U,  8 - length( p-char ) ) + p-char
     1564           .
     1565         end.
     1566       end.
     1567     end.
     1568   end procedure.
