     1949         if not g#auto then do:
     1950   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1951     run mainmenu_getcntxt in parparentproc
     1952       (output v-cntxt-db-num
     1953       ,output v-cntxt-userid
