     2235   define input parameter p-errmessage as character no-undo .
     2236   define variable v-errnum as integer no-undo .
     2237   do
     2238   on error undo, return error
     2239   :
     2240     p-rebh:find-last() no-error.
     2241     if not p-rebh:available then do:
