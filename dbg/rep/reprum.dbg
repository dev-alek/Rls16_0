     1472   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1473   procedure init-rule-call-params :
     1474   define input parameter p-uniq-key-rec as character no-undo .
     1475   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1476   define buffer buf_rule-call-param for ub.rule-call-param.
     1477   do
     1478   on error undo, return error
     1479   :
     1480     empty temp-table temp-rule-call-param.
     1481     for each buf_rule-call-param where
     1482             buf_rule-call-param.call_id = p-uniq-key-rec:
     1483       create buf_temp-rule-call-param.
     1484       buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     1485       if lookup("container", buf_rule-call-param.param-3-data-type) > 0 then do:
     1486         find first buf_temp-rule-call-param where
     1487               buf_temp-rule-call-param.call_id = p-uniq-key-rec
     1488           and buf_temp-rule-call-param.codex_id = 0
     1489           and buf_temp-rule-call-param.ruleset_id = 0
     1490           and buf_temp-rule-call-param.order_id = 0
     1491           and buf_temp-rule-call-param.param-name = buf_rule-call-param.param-name
     1492           and buf_temp-rule-call-param.p-index = buf_rule-call-param.p-index no-error.
     1493         if not available buf_temp-rule-call-param then do:
     1494           create buf_temp-rule-call-param.
     1495           buffer-copy buf_rule-call-param
     1496           except
     1497           codex_id
     1498           ruleset_id
     1499           order_id
     1500           to buf_temp-rule-call-param.
     1501         end.
     1502       end.
     1503     end.
     1504   end.
     1505   end procedure.
     1506   procedure update-rule-call-params :
     1507   define input parameter p-profile-type as character no-undo .
     1508   define input parameter p-uniq-key-rec as character no-undo .
     1509   do
     1510   on error undo, return error
     1511   :
     1512     for each temp-rule-call-param where
     1513             temp-rule-call-param.call_id = p-uniq-key-rec
     1514         and temp-rule-call-param.codex_id = 0
     1515         and temp-rule-call-param.ruleset_id = 0
     1516         and temp-rule-call-param.order_id = 0:
     1517       delete temp-rule-call-param.
     1518     end.
     1519     run rul/ruprcall.p (
     1520                          input p-profile-type
     1521                         ,input p-uniq-key-rec
     1522                         ,input 'rule-call-param':U
     1523                         ,input ?
     1524                         ,input 0
     1525                         ,INPUT TABLE tt0-rp-by-call
     1526                         ,INPUT TABLE tt0-rule-by-call
     1527                         ,INPUT TABLE temp-rule-call-param) no-error .
     1528   end.
     1529   end procedure.
     1530   procedure cb_rcps-run_get-value :
     1531   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1532   define input parameter p-codex-id as integer no-undo .
     1533   define input parameter p-ruleset-id as integer no-undo .
     1534   define input parameter p-order-id as integer no-undo .
     1535   DEFINE INPUT PARAMETER p-param-name AS CHARACTER NO-UNDO.
     1536   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     1537   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     1538   DEFINE output parameter p-value-date AS date NO-UNDO.
     1539   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     1540   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     1541   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     1542   define variable v-current-index as integer no-undo init -1.
     1543   define variable v-start as logical no-undo init yes.
     1544   DEFINE BUFFER buf_temp-rule-call-param FOR temp-rule-call-param.
     1545   do
     1546   on error undo, return error
     1547   :
     1548    for each buf_temp-rule-call-param where
     1549          buf_temp-rule-call-param.call_id = p-call-id
     1550      and buf_temp-rule-call-param.codex_id = p-codex-id
     1551      and buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     1552      and buf_temp-rule-call-param.order_id = p-order-id
     1553      and buf_temp-rule-call-param.param-name = p-param-name
     1554      and buf_temp-rule-call-param.p-index >= pp-index :
     1555     if v-start then do:
     1556         assign
     1557         pp-index = buf_temp-rule-call-param.p-index
     1558         p-value-character = buf_temp-rule-call-param.param-value-character
     1559         p-value-date      = buf_temp-rule-call-param.param-value-date
     1560         p-value-decimal   = buf_temp-rule-call-param.param-value-decimal
     1561         p-value-integer   = buf_temp-rule-call-param.param-value-integer
     1562         p-value-logical   = buf_temp-rule-call-param.param-value-logical
     1563         v-start = no
     1564         .
     1565       end.
     1566       else do:
     1567         if buf_temp-rule-call-param.p-index > pp-index then do:
     1568           v-current-index = buf_temp-rule-call-param.p-index.
     1569           leave.
     1570         end.
     1571       end.
     1572     end.
     1573     pp-index = v-current-index.
     1574   end.
     1575   end procedure.
     1576   PROCEDURE cb_rcps-run_set-value :
     1577   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     1578   define input parameter p-codex-id as integer no-undo .
     1579   define input parameter p-ruleset-id as integer no-undo .
     1580   define input parameter p-order-id as integer no-undo .
     1581   DEFINE INPUT PARAMETER p-param-name AS CHARACTER NO-UNDO.
     1582   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1583   define input parameter p-param-mode as character no-undo .
     1584   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     1585   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     1586   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     1587   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     1588   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     1589   define variable v-found as logical no-undo .
     1590   define variable v-rp-param-name as character no-undo .
     1591   DEFINE BUFFER buf_temp-rule-call-param FOR temp-rule-call-param.
     1592   DEFINE BUFFER buf2_temp-rule-call-param FOR temp-rule-call-param.
     1593   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1594   find first buf_temp-rule-call-param WHERE
     1595           buf_temp-rule-call-param.call_id = p-CALL-id
     1596       AND buf_temp-rule-call-param.codex_id = p-codex-id
     1597       AND buf_temp-rule-call-param.ruleset_id = p-ruleset-id
     1598       AND buf_temp-rule-call-param.order_id = p-order-id
     1599       AND buf_temp-rule-call-param.param-name = p-param-name
     1600       AND buf_temp-rule-call-param.p-index = pp-index no-error.
     1601   if pp-index > 0
     1602   then do:
     1603     if not available buf_temp-rule-call-param then do:
     1604       find first buf2_temp-rule-call-param WHERE
     1605               buf2_temp-rule-call-param.call_id = p-CALL-id
     1606           AND buf2_temp-rule-call-param.codex_id = p-codex-id
     1607           AND buf2_temp-rule-call-param.ruleset_id = p-ruleset-id
     1608           AND buf2_temp-rule-call-param.order_id = p-order-id
     1609           AND buf2_temp-rule-call-param.param-name = p-param-name
     1610           AND buf2_temp-rule-call-param.p-index = 0 no-error.
     1611       create buf_temp-rule-call-param.
     1612       buffer-copy buf2_temp-rule-call-param
     1613       except p-index
     1614       to buf_temp-rule-call-param
     1615       assign
     1616       buf_temp-rule-call-param.p-index = pp-index
     1617       .
     1618     end.
     1619   end.
     1620   else do:
     1621     if not available buf_temp-rule-call-param then do:
     1622       undo, return error substitute("Отсутствует параметр &1/&6 для вызова &2 кодекс &3 набор правил &4 порядок &5"
     1623                                     , p-param-name
     1624                                     , p-call-id
     1625                                     , p-codex-id
     1626                                     , p-ruleset-id
     1627                                     , p-order-id
     1628                                     , pp-index).
     1629     end.
     1630   end.
     1631   assign
     1632   buf_temp-rule-call-param.param-value-character = p-value-character
     1633   buf_temp-rule-call-param.param-value-date      = p-value-date
     1634   buf_temp-rule-call-param.param-value-decimal   = p-value-decimal
     1635   buf_temp-rule-call-param.param-value-integer   = p-value-integer
     1636   buf_temp-rule-call-param.param-value-logical   = p-value-logical
     1637   .
     1638   if not (p-codex-id = 0
     1639           and
     1640           p-ruleset-id = 0
     1641           and
     1642           p-order-id = 0)   then do:
     1643   find first buf_rp-rule-param no-lock where
     1644            buf_rp-rule-param.profile_id = buf_temp-rule-call-param.profile_id
     1645       and  buf_rp-rule-param.codex_id = p-codex-id
     1646       and  buf_rp-rule-param.ruleset_id = p-ruleset-id
     1647       and  buf_rp-rule-param.rule_id = buf_temp-rule-call-param.rule_id
     1648       and  buf_rp-rule-param.rule-param-name = p-param-name.
     1649   assign
     1650   v-rp-param-name = buf_rp-rule-param.rp-param-name.
     1651   for each buf_rp-rule-param no-lock where
     1652            buf_rp-rule-param.profile_id = buf_temp-rule-call-param.profile_id
     1653        and buf_rp-rule-param.rp-param-name = v-rp-param-name,
     1654       each buf2_temp-rule-call-param where
     1655           buf2_temp-rule-call-param.call_id = p-call-id
     1656       and buf2_temp-rule-call-param.profile_id = buf_temp-rule-call-param.profile_id
     1657       and buf2_temp-rule-call-param.once-more = buf_temp-rule-call-param.once-more
     1658       and buf2_temp-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1659       and buf2_temp-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1660       and buf2_temp-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1661       and buf2_temp-rule-call-param.p-index = pp-index
     1662       :
     1663     assign
     1664     buf2_temp-rule-call-param.param-value-character = p-value-character
     1665     buf2_temp-rule-call-param.param-value-date      = p-value-date
     1666     buf2_temp-rule-call-param.param-value-decimal   = p-value-decimal
     1667     buf2_temp-rule-call-param.param-value-integer   = p-value-integer
     1668     buf2_temp-rule-call-param.param-value-logical   = p-value-logical
     1669     .
     1670   end.
     1671   end.
     1672   end procedure.
     1673   procedure cb_rcps-run_fill-rcp-from-tt0 :
     1674   define input parameter p-call-id as character no-undo .
     1675   define input parameter p-bh as handle no-undo .
     1676   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1677   for each buf_tt0-rule-call-param where
     1678          buf_tt0-rule-call-param.call_id = p-call-id
     1679   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1680   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1681   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1682   :
     1683     p-bh:buffer-create ().
     1684     p-bh:buffer-copy(buffer buf_tt0-rule-call-param:handle).
     1685     p-bh:buffer-release.
     1686   end.
     1687   end procedure.
     1688   define variable v-cont-handle as handle no-undo .
     1689   define buffer buf_rule-by-call for ub.rule-by-call.
     1690   define buffer buf_rule-call-param for ub.rule-call-param.
     1691   define buffer buf_temp-pers-proc  for temp-pers-proc.
     1692   define buffer buf_db for ub.db.
     1693   define buffer buf_sysconf for ub.sysconf.
     1694   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   define NEW SHARED temp-table temp-cmd no-undo
     1697   field cmd-code as integer
     1698   field db-list as character
     1699   index pi is unique primary
     1700   db-list
     1701   index icmd
     1702   cmd-code
     1703   .
     1704   define NEW SHARED temp-table temp-smart-route no-undo
     1705   field key-field as character
     1706   field db-num as integer
     1707   index pi is unique primary
     1708   key-field
     1709   db-num
     1710   .
     1711   define NEW SHARED temp-table temp-no-route no-undo
     1712   field rec-ord as integer
     1713   field db-num as integer
     1714   index pi is unique primary
     1715   db-num
     1716   rec-ord
     1717   index iro
     1718   rec-ord
     1719   .
     1720   define NEW SHARED temp-table temp-smart-link no-undo
     1721   field uniq-key-rec as character
     1722   field key-field as character
     1723   field rec-ord as integer
     1724   field is-smart as logical
     1725   index pi is unique primary
     1726   key-field
     1727   uniq-key-rec
     1728   rec-ord
     1729   index iu
     1730   uniq-key-rec
     1731   index iro
     1732   rec-ord
     1733   .
     1734   define NEW SHARED temp-table temp-nws-outline no-undo
     1735   like ub.nws-outline.
     1736   procedure create-smart-route :
     1737   define input parameter p-key-field as character no-undo .
     1738   define input parameter p-db-num as integer no-undo .
     1739   define buffer buf_temp-smart-route for temp-smart-route.
     1740     do
     1741     on error undo, return error
     1742     :
     1743       find first buf_temp-smart-route where
     1744                 buf_temp-smart-route.key-field = p-key-field
     1745             and buf_temp-smart-route.db-num = p-db-num no-error.
     1746       if not available buf_temp-smart-route then do:
     1747         create buf_temp-smart-route.
     1748         assign
     1749         buf_temp-smart-route.key-field = p-key-field
     1750         buf_temp-smart-route.db-num = p-db-num
     1751         .
     1752       end.
     1753     end.
     1754   end procedure.
     1755   procedure create-smart-route-link :
     1756   define input parameter p-tbl-name as character no-undo .
     1757   define input parameter p-bh_tbl-name as handle no-undo .
     1758   define input parameter p-key-field as character no-undo .
     1759   define input parameter p-rec-ord as integer no-undo .
     1760   define input parameter p-is-smart as logical no-undo .
     1761   define variable v-key-rec as character no-undo .
     1762   define buffer buf_temp-smart-link for temp-smart-link.
     1763     do
     1764     on error undo, return error
     1765     :
     1766       run gen-key-rec in this-procedure ( input p-tbl-name
     1767                                          ,input p-bh_tbl-name
     1768                                          ,output v-key-rec     ).
     1769      find first buf_temp-smart-link where
     1770                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1771              and buf_temp-smart-link.key-field = p-key-field
     1772              and buf_temp-smart-link.rec-ord = p-rec-ord
     1773              no-error .
     1774      if not available buf_temp-smart-link then do:
     1775        create buf_temp-smart-link.
     1776        assign
     1777        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1778        buf_temp-smart-link.key-field = p-key-field
     1779        buf_temp-smart-link.rec-ord = p-rec-ord
     1780        buf_temp-smart-link.is-smart = p-is-smart
     1781        .
     1782      end.
     1783     end.
     1784   end procedure.
     1785   procedure create-nws-outline :
     1786   define input parameter p-cmd-proc-handle as handle no-undo .
     1787   define input parameter p-cmd-code as integer no-undo .
     1788   define input parameter p-outline-type as character no-undo .
     1789   define input parameter p-charkey_one as character no-undo .
     1790   define input parameter p-charkey_two as character no-undo .
     1791   define input parameter p-charkey_three as character no-undo .
     1792   define input parameter p-key#_one as integer no-undo .
     1793   define input parameter p-key#_two as integer no-undo .
     1794   define input parameter p-key#_three as integer no-undo .
     1795   define variable v-no-id as integer no-undo .
     1796   define variable v-rec-ord as integer no-undo .
     1797     do
     1798     on error undo, return error return-value
     1799     :
     1800       find last temp-nws-outline use-index pi no-error .
     1801       v-no-id = (if available temp-nws-outline
     1802                  then (temp-nws-outline.no-id  + 1)
     1803                  else 1).
     1804       create temp-nws-outline.
     1805       assign
     1806       temp-nws-outline.charkeY_one = p-charkey_one
     1807       temp-nws-outline.charkeY_two = p-charkey_two
     1808       temp-nws-outline.charkeY_three = p-charkey_three
     1809       temp-nws-outline.key#_one = p-key#_one
     1810       temp-nws-outline.key#_two = p-key#_two
     1811       temp-nws-outline.key#_three = p-key#_three
     1812       temp-nws-outline.no-id = v-no-id
     1813       temp-nws-outline.outline-type = p-outline-type
     1814       .
     1815                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1816       run  create-smart-route in this-procedure (
     1817                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1818                                                  ,input -1).
     1819       run create-smart-route-link in this-procedure (
     1820                                                      input 'nws-outline':U
