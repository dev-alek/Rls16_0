     1993       end.
     1994       otherwise do:
     1995         undo _main, return error substitute("&1 &2 &3&4Ошибка входных параметров процедуры reprum.p&4Невернoе значение p-process = &5"
     1996                                             ,vss-workfile
     1997                                             ,vss-revision
     1998                                             ,vss-description
     1999                                             ,chr(10)
     2000                                             ,p-process
