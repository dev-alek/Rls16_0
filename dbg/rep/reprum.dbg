     2086                                             , "&DLine").
     2087                           if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input substitute("...(&1) - Закончен", buf_rule-by-call.rule_id)).
     2088             end.
     2089           end.
