     2062                                                 , error-status:get-message(1)
     2063                                                 , return-value
     2064                                                   ).
     2065             end.
     2066               when integer(5) then do:
     2067               end.
     2068               when integer(6) then do:
     2069               end.
     2070               otherwise do:
     2071              return error substitute("&1&2Ошибка при обработке отчетов&2" +
     2072                                                 "&3&2&4"
     2073                                                 ,vss-workfile
     2074                                                 ,chr(10)
     2075                                                 , error-status:get-message(1)
     2076                                                 , return-value
     2077                                                   ).
     2078             end.
     2079             end case.
     2080           end.
     2081           if not error-status:error then do:
     2082             if v-ruleset-id = integer(1)
     2083             then do:
