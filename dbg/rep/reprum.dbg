     2277     p-rpbh::parameter-name    = p-param-name
     2278     p-rpbh::parameter-label   = p-param-label
     2279     p-rpbh::parameter-value-type = p-param-data-type
     2280     p-rpbh::parameter-value = if p-param-data-type = 'character':U
     2281                           then p-param-value-character
     2282                           else p-rpbh::parameter-value
     2283     p-rpbh::parameter-value = if p-param-data-type = 'date':U
     2284                           then string(p-param-value-date, "99/99/9999")
     2285                           else p-rpbh::parameter-value
     2286     p-rpbh::parameter-value = if p-param-data-type = 'decimal':U
     2287                           then string(p-param-value-decimal)
     2288                           else p-rpbh::parameter-value
     2289     p-rpbh::parameter-value = if p-param-data-type = 'logical':U
     2290                           then string(p-param-value-logical)
     2291                           else p-rpbh::parameter-value
     2292     p-rpbh::parameter-value = if p-param-data-type = 'integer':U
     2293                           then string(p-param-value-integer)
     2294                           else p-rpbh::parameter-value
     2295     p-rpbh::parameter-index = pp-index
     2296     p-rpbh::parameter-des = p-param-des
     2297     .
     2298     p-rpbh:buffer-release.
     2299   end.
     2300   end procedure.
     2301   procedure cb_fill-report-destination :
     2302   define input parameter p-rdbh as handle no-undo .
     2303   define input parameter p-report-id as character no-undo .
     2304   define input parameter p-destination-id as character no-undo .
     2305   define input parameter p-destination as character no-undo .
     2306   define input parameter p-destination-details as character no-undo .
     2307   do
     2308   on error undo, return error
     2309   :
     2310   p-rdbh:buffer-create().
     2311   assign
     2312   p-rdbh::destination-id  = p-destination-id
     2313   p-rdbh::report-id       = p-report-id
     2314   p-rdbh::destination     = p-destination
     2315   p-rdbh::destination-details     = p-destination-details
     2316   .
     2317   p-rdbh:buffer-release.
     2318   end.
     2319   end procedure.
     2320   procedure get-batch-rep-dir :
     2321   define input-output parameter p-batch-rep-1 as character no-undo .
     2322   define input-output parameter p-batch-rep-2 as character no-undo .
     2323   define input parameter p-allow-current-dir as logical no-undo .
     2324   define variable glog as logical no-undo .
     2325   define variable v-flag-1 as logical no-undo .
     2326   define variable v-flag-2 as logical no-undo .
     2327   run  verify-ini-entry in this-procedure ( input "batch-rep"
     2328                                             ,input "REP-SETS"
     2329                                             ,input substitute("не указан путь к директории для сохранения отчетов, выполняемых в пакетном режиме")
     2330                                             ,input yes
     2331                                             ,output p-batch-rep-1
     2332                                             ) no-error.
     2333   if error-status:error or p-batch-rep-1 = ? then do:
     2334       if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input return-value).
     2335     if p-allow-current-dir then do:
     2336       file-info:file-name = ".".
     2337       assign
     2338       p-batch-rep-1 = file-info:full-pathname.
     2339           if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input substitute("Отчеты, выводимые в текстовом виде и в EXCEL, будут сохраняться в рабочей директории")).
     2340       v-flag-1 = yes.
     2341     end.
     2342     else do:
     2343       undo, return error .
     2344     end.
     2345   end.
     2346   if not v-flag-1 then do:
     2347     p-batch-rep-1 = prepare-path2(p-batch-rep-1) + chr(92).
     2348     RUN verify-file in this-procedure
     2349                                       ( input p-batch-rep-1
     2350                                       , input substitute("Не найден каталог &1 параметр batch-rep, секция [REP-SETS] ini-файла", p-batch-rep-1)
     2351                                       , input yes
     2352                                       ,output glog) no-error.
     2353     if error-status:error
     2354     or not glog then do:
     2355           if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input return-value).
     2356       if p-allow-current-dir then do:
     2357         file-info:file-name = ".".
     2358         assign
     2359         p-batch-rep-1 = file-info:full-pathname.
     2360               if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input substitute("Отчеты, выводимые в текстовом виде и EXCEL будут сохраняться в рабочей директории")).
     2361       end.
     2362       else do:
     2363         undo, return error .
     2364       end.
     2365     end.
     2366   end.
     2367   run  verify-ini-entry in this-procedure ( input "batch-rep-xml"
     2368                                             ,input "REP-SETS"
     2369                                             ,input substitute("не указан путь к директории для сохранения отчетов, выполняемых в пакетном режиме")
     2370                                             ,input yes
     2371                                             ,output p-batch-rep-2
     2372                                             ) no-error.
     2373   if error-status:error or p-batch-rep-2 = ? then do:
     2374       if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input return-value).
     2375     if p-allow-current-dir then do:
     2376       assign
     2377       p-batch-rep-2 = ".".
     2378       v-flag-2 = yes.
     2379           if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input substitute("Отчеты, выводимые в XML, будут сохраняться в рабочей директории")).
     2380     end.
     2381     else do:
     2382       undo, return error .
     2383     end.
     2384   end.
     2385   if v-flag-2 then do:
     2386     p-batch-rep-2 = prepare-path2(p-batch-rep-2) + chr(92).
     2387     RUN verify-file in this-procedure
     2388                                       ( input p-batch-rep-2
     2389                                       , input substitute("Не найден каталог &1 параметр batch-rep-xml, секция [REP-SETS] ini-файла", p-batch-rep-1)
     2390                                       , input yes
     2391                                       ,output glog) no-error.
     2392     if error-status:error
     2393     or not glog then do:
     2394           if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input return-value).
     2395       if p-allow-current-dir then do:
     2396         assign
     2397         p-batch-rep-2 = ".".
     2398               if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input substitute("Отчеты, выводимые в XML, будут сохраняться в рабочей директории")).
     2399       end.
     2400       else do:
     2401         undo, return error .
     2402       end.
     2403     end.
     2404   end.
     2405   end procedure.
     2406   procedure verify-write-to-dir :
     2407   define input parameter p-dirs0 as character no-undo .
     2408   define output parameter p-dirs as character no-undo .
     2409   define variable v-ii as integer no-undo .
     2410   define variable v-process-file-name as character no-undo .
     2411   do
     2412   on error undo, return error
     2413   :
     2414     do v-ii = 1 to num-entries( p-dirs0, chr(124)):
     2415       v-process-dir-name = entry(v-ii, p-dirs0, chr(124)).
     2416       if v-process-dir-name = ?
     2417       or v-process-dir-name = '' then do:
     2418         v-process-dir-name = ".".
     2419       end.
     2420       else do:
     2421         v-process-dir-name = right-trim(v-process-dir-name, chr(92)).
     2422         v-process-dir-name = v-process-dir-name  + chr(92).
     2423       end.
     2424       run gbl/dir-canw.p ( input v-process-dir-name) no-error.
     2425       if error-status:error then do:
     2426               if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input substitute("!!!! Нет возможности вывести отчет в директорию &1&2&3&2&4"                                 , v-process-dir-name                                 , chr(10)                                 , error-status:get-message(1)                                  , return-value )).
     2427         undo, return error .
     2428       end.
     2429       p-dirs = p-dirs + (if v-ii = 1 then '' else chr(124)) + v-process-dir-name.
     2430     end.
     2431   end.
     2432   end procedure.
