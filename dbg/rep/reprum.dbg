     1851   do
     1852   on error undo, return error
     1853   :
     1854   for each buf_temp-no-route where
     1855           buf_temp-no-route.rec-ord > p-rec-ord:
     1856     delete buf_temp-no-route.
     1857   end.
     1858   for each buf_temp-smart-link where
     1859           buf_temp-smart-link.rec-ord > p-rec-ord:
     1860      delete buf_temp-smart-link.
     1861   end.
     1862   end.
