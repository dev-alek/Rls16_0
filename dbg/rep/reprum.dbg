        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-parent-handle as handle no-undo .
        4   define input  parameter p-log-handle  as handle no-undo .
        5   define input  parameter p-process    as character no-undo .
        6   define input  parameter p-profile-id as integer   no-undo .
        7   define input  parameter p-codex-id as integer   no-undo .
        8   define input  parameter p-ruleset-id as integer   no-undo .
        9   define input  parameter p-once-more as integer no-undo .
       10   define input  parameter p-db-num like ub.db.db-num no-undo .
       11   define input  parameter p-uniq-key-rec as character no-undo .
       12   define input  parameter p-doc-code as character no-undo .
       13   define input  parameter p-save        as logical no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
       15   define variable vss-author      as character no-undo init "$Author: expertek $":u .
       16   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
       17   define variable vss-workfile    as character no-undo init "$Workfile: reprum.p $":u .
       18   define variable vss-archive     as character no-undo init "$Archive: rep/reprum.p $":u .
       19   define variable vss-description as character no-undo init "Вызов процедур RUM для обработки отчетов" .
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38       assign
       39         p-vss-parameters = substitute('&1|&2|&3':u
       40                                 ,p-process
       41                                 ,p-db-num
       42                                 ,p-doc-code
       43                                 )
       44       .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define   shared variable g#auto as logical no-undo.
       88   define   shared variable g#news as logical no-undo.
       89   define   shared variable g#oxml as logical no-undo.
       90   define   shared variable g#esys as logical no-undo.
       91   define   shared variable g#news-source-db as integer no-undo.
       92   define   shared variable g#esys-source-esys as integer no-undo.
       93   define   shared variable g#db-num as integer   no-undo .
       94   define   shared variable g#userid as character no-undo .
       95   define   shared variable g#passwd as character no-undo .
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97     define variable v-cntxt-db-num        as integer   no-undo .
       98     define variable v-cntxt-userid        as character no-undo .
       99     define variable v-cntxt-level         as character no-undo .
      100     define variable v-cntxt-host-code-obj as integer   no-undo .
      101     define variable v-cntxt-obj-type      as character no-undo .
      102     define variable v-cntxt-obj-code      as integer   no-undo .
      103     define variable v-cntxt-db-num-obj    as integer   no-undo .
      104     define variable v-cntxt-is-admin      as logical   no-undo .
      105   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   define   temp-table temp-pers-proc no-undo
      107   field proc-name as character
      108   field vproc-handle as handle
      109   field vparent-handle as handle
      110   field user-name as character
      111   field id as integer
      112   field vpar as character
      113   field rank-to-delete as integer
      114   index pi is unique primary
      115   proc-name
      116   id
      117   index puser
      118   proc-name
      119   user-name
      120   index ppar
      121   proc-name
      122   vpar
      123   index iparent
      124   vparent-handle
      125   proc-name
      126   index iid
      127   id
      128   index ird
      129   rank-to-delete
      130   .
      131   define variable v-per-proc-num as integer no-undo .
      132   procedure perproc-create-proc :
      133   define input  parameter p-parent-handle as handle no-undo .
      134   define input  parameter p-proc-name as character no-undo .
      135   define input  parameter p-proc-handle  as handle no-undo .
      136   define input  parameter p-run        as logical no-undo .
      137   define input  parameter p-parameter as character no-undo .
      138   define input  parameter p-userid as character no-undo .
      139   define input  parameter p-rank-to-delete as integer no-undo .
      140   define output parameter p-id as integer   no-undo .
      141   define variable ii as integer   no-undo .
      142   define variable v-proc-handle as handle no-undo .
      143   define buffer buf_temp-pers-proc for temp-pers-proc.
      144   define buffer buf0_temp-pers-proc for temp-pers-proc.
      145     do
      146     on error undo, return error return-value
      147     :
      148       if v-per-proc-num > 100 then return error '>'.
      149       find first buf0_temp-pers-proc no-lock where
      150                 buf0_temp-pers-proc.proc-name = p-proc-name use-index pi    no-error.
      151       if not available buf0_temp-pers-proc then do:
      152         if p-run then do:
      153           run value(p-proc-name) persistent SET v-proc-handle (input p-parameter) no-error.
      154           if error-status :error then undo, return error return-value .
      155         end.
      156         else v-proc-handle = p-proc-handle.
      157         find last buf0_temp-pers-proc no-lock use-index iid  no-error.
      158         create buf_temp-pers-proc.
      159         assign
      160         buf_temp-pers-proc.proc-name = p-proc-name
      161         buf_temp-pers-proc.id = (if not available buf0_temp-pers-proc
      162                                   then  0
      163                                   else buf0_temp-pers-proc.id + 1)
      164         buf_temp-pers-proc.user-name = p-userid
      165         buf_temp-pers-proc.vpar      = p-parameter
      166         buf_temp-pers-proc.vparent-handle = p-parent-handle
      167         buf_temp-pers-proc.vproc-handle = v-proc-handle
      168         buf_temp-pers-proc.rank-to-delete = p-rank-to-delete
      169         p-id = buf_temp-pers-proc.id
      170         v-per-proc-num = v-per-proc-num + 1
      171         .
      172       end.
      173       else p-id = buf0_temp-pers-proc.id.
      174     end.
      175   end procedure.
      176   procedure perproc-delete-proc-user :
      177   define input  parameter p-proc-name as character no-undo .
      178   define input  parameter p-user-name as character no-undo .
      179   define buffer buf_temp-pers-proc for temp-pers-proc.
      180     do
      181     on error undo, return error return-value
      182     :
      183        for each buf_temp-pers-proc where
      184               buf_temp-pers-proc.proc-name = p-proc-name
      185          AND  buf_temp-pers-proc.user-name = p-user-name:
      186           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      187           delete procedure buf_temp-pers-proc.vproc-handle.
      188           delete buf_temp-pers-proc.
      189           v-per-proc-num = v-per-proc-num - 1.
      190        end.
      191     end.
      192   end procedure.
      193   procedure perproc-delete-proc-id :
      194   define input  parameter p-id        as integer   no-undo .
      195   define buffer buf_temp-pers-proc for temp-pers-proc.
      196     do
      197     on error undo, return error return-value
      198     :
      199        for each buf_temp-pers-proc where
      200           buf_temp-pers-proc.id        = p-id:
      201           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      202           delete procedure buf_temp-pers-proc.vproc-handle.
      203           delete buf_temp-pers-proc.
      204           v-per-proc-num = v-per-proc-num - 1.
      205        end.
      206     end.
      207   end procedure.
      208   procedure perproc-delete-by-rank :
      209   define buffer buf_temp-pers-proc for temp-pers-proc.
      210     do
      211     on error undo, return error return-value
      212     :
      213       for each buf_temp-pers-proc where
      214       by buf_temp-pers-proc.rank-to-delete:
      215         APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      216         delete procedure buf_temp-pers-proc.vproc-handle.
      217         delete buf_temp-pers-proc.
      218         v-per-proc-num = v-per-proc-num - 1.
      219       end.
      220     end.
      221   end procedure.
      222   procedure perproc-delete-proc-name-id :
      223   define input  parameter p-proc-name as character no-undo .
      224   define input  parameter p-id        as integer   no-undo .
      225   define buffer buf_temp-pers-proc for temp-pers-proc.
      226     do
      227     on error undo, return error return-value
      228     :
      229        for each buf_temp-pers-proc where
      230               buf_temp-pers-proc.proc-name = p-proc-name
      231          AND  buf_temp-pers-proc.id        = p-id:
      232           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      233           delete procedure buf_temp-pers-proc.vproc-handle.
      234           delete buf_temp-pers-proc.
      235           v-per-proc-num = v-per-proc-num - 1.
      236        end.
      237     end.
      238   end procedure.
      239   procedure perproc-delete-par :
      240   define input  parameter p-proc-name as character no-undo .
      241   define input  parameter p-parameter as character no-undo .
      242   define buffer buf_temp-pers-proc for temp-pers-proc.
      243     do
      244     on error undo, return error return-value
      245     :
      246        for each buf_temp-pers-proc where
      247               buf_temp-pers-proc.proc-name = p-proc-name
      248          AND  buf_temp-pers-proc.vpar      = p-parameter:
      249           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      250           delete procedure buf_temp-pers-proc.vproc-handle.
      251           delete buf_temp-pers-proc.
      252           v-per-proc-num = v-per-proc-num - 1.
      253        end.
      254     end.
      255   end procedure.
      256   procedure perproc-delete-from-parent :
      257   define input  parameter p-parent-handle as handle no-undo .
      258   define input  parameter p-proc-name as character no-undo .
      259   define buffer buf_temp-pers-proc for temp-pers-proc.
      260     do
      261     on error undo, return error return-value
      262     :
      263        if p-proc-name = "":u then do:
      264         for each buf_temp-pers-proc where
      265            buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      266             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      267             delete procedure buf_temp-pers-proc.vproc-handle.
      268             delete buf_temp-pers-proc.
      269             v-per-proc-num = v-per-proc-num - 1.
      270         end.
      271        end.
      272        else do:
      273         for each buf_temp-pers-proc where
      274                 buf_temp-pers-proc.proc-name = p-proc-name
      275           AND  buf_temp-pers-proc.vparent-handle      = p-parent-handle:
      276             APPLY "delete" to buf_temp-pers-proc.vproc-handle.
      277             delete procedure buf_temp-pers-proc.vproc-handle.
      278             delete buf_temp-pers-proc.
      279             v-per-proc-num = v-per-proc-num - 1.
      280         end.
      281       end.
      282     end.
      283   end procedure.
      284   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      285   define new global shared variable g#lib-nws as handle no-undo .
      286   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      287   procedure gen-key-rec :
      288     define input  parameter p-tbl-name    as character no-undo.
      289     define input  parameter p-bh_tbl-name as handle    no-undo.
      290     define output parameter p-key-rec     as character no-undo.
      291     do
      292     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      293     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      294     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      295     :
      296       define variable fh               as handle    no-undo .
      297       define variable v-ok             as logical   no-undo .
      298       define variable v-inform         as character no-undo .
      299       define variable v-ind            as integer   no-undo .
      300       define variable v-idx-field-qnty as integer   no-undo .
      301       if p-tbl-name = ?
      302         or p-tbl-name = "":U
      303       then do:
      304         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      305       end.
      306       if not p-bh_tbl-name:available then do:
      307         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      308       end.
      309       assign
      310         p-key-rec = p-tbl-name
      311         v-inform  = p-bh_tbl-name:index-information(1)
      312         v-ind     = 2
      313       .
      314       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      315       on error undo, return error
      316       :
      317         assign
      318           v-inform = p-bh_tbl-name:index-information( v-ind )
      319           v-ind    = v-ind + 1
      320         .
      321       end.
      322       if v-inform = ?
      323         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      324         or entry( 3, v-inform, ",":U ) <> "1":U
      325       then do:
      326         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      327       end.
      328       else do:
      329         assign
      330           v-idx-field-qnty = num-entries( v-inform ) - 4
      331         .
      332         if v-idx-field-qnty < 2 then do:
      333           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      334         end.
      335         do v-ind = 1 to v-idx-field-qnty by 2
      336         on error undo, return error
      337         :
      338           assign
      339             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      340             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      341           .
      342         end.
      343       end.
      344       if p-key-rec = ? then do:
      345         assign
      346           p-key-rec = "":U
      347         .
      348         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      349       end.
      350     end.
      351     return.
      352   end procedure.
      353   procedure gen-where-keyr-tab :
      354     define input  parameter i-tableSerach as character no-undo.
      355     define input  parameter i-tablekey   as character  no-undo.
      356     define input  parameter p-key-rec    as character  no-undo.
      357     define input  parameter p-key-handle as handle     no-undo .
      358     define input  parameter p-db-name    as character  no-undo .
      359     define input  parameter p-tt-handle  as handle     no-undo .
      360     define output parameter o-Where      as character  no-undo.
      361     do
      362     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      363     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      364     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      365     :
      366       define variable v-full-tbl-name  as character no-undo .
      367       define variable bh_tbl-name      as handle    no-undo .
      368       define variable fh_key           as handle    no-undo .
      369       define variable fh_search        as handle    no-undo .
      370       define variable v-field-num      as integer   no-undo .
      371       define variable v-count-fld      as integer   no-undo .
      372       define variable v-inform         as character no-undo .
      373       define variable v-ind            as integer   no-undo .
      374       define variable v-idx-field-qnty as integer   no-undo .
      375       define variable v-field-name     as character no-undo .
      376       define variable v-field-val      as character no-undo .
      377       define variable v-word-link      as character no-undo .
      378       define variable vTable           as character no-undo.
      379       define variable bh_tbl-key       as handle    no-undo .
      380       assign
      381         p-key-rec = trim( p-key-rec )
      382       .
      383       if p-key-handle <> ? then do:
      384         if not valid-handle(p-key-handle)
      385            or p-key-handle:type <> "buffer"
      386         then do:
      387           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      388         end.
      389         if num-entries( p-key-rec, chr(3) ) > 1
      390           or p-key-rec = ?
      391           or p-key-rec = "":U
      392         then do:
      393           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      394         end.
      395       end.
      396       else do:
      397         if p-key-rec = ?
      398           or p-key-rec = "":U
      399         then do:
      400           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      401         end.
      402       end.
      403       assign
      404         vTable = entry( 1 , p-key-rec, chr(3) )
      405       .
      406       if p-tt-handle <> ?
      407         and ( not valid-handle(p-tt-handle)
      408               or p-tt-handle:type <> "buffer"
      409             )
      410       then do:
      411         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      412       end.
      413       if p-tt-handle = ? then do:
      414         assign
      415           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      416         .
      417         create buffer bh_tbl-name for table v-full-tbl-name .
      418       end.
      419       else do:
      420         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      421       end.
      422       assign
      423         v-inform = bh_tbl-name:index-information(1)
      424         v-ind    = 2
      425       .
      426       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      427       on error undo, return error
      428       :
      429         assign
      430           v-inform = bh_tbl-name:index-information( v-ind )
      431           v-ind    = v-ind + 1
      432         .
      433       end.
      434       if v-inform = ?
      435         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      436         or entry( 3, v-inform, ",":U ) <> "1":U
      437       then do:
      438         delete object bh_tbl-name no-error.
      439         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      440       end.
      441       assign
      442         v-idx-field-qnty = num-entries( v-inform ) - 4
      443       .
      444       if v-idx-field-qnty < 2 then do:
      445         delete object bh_tbl-name no-error.
      446         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      447       end.
      448       assign
      449         o-where     = "where":U
      450         v-word-link = "":U
      451         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      452         v-count-fld = 0
      453       .
      454       if i-tablekey ne "" and i-tablekey ne ?
      455       then do:
      456         assign
      457           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      458         .
      459         create buffer bh_tbl-key for table v-full-tbl-name .
      460       end.
      461       if i-tableSerach ne "" and i-tableSerach ne ?
      462       then do:
      463         delete object bh_tbl-name no-error.
      464         assign
      465           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      466         .
      467         create buffer bh_tbl-name for table v-full-tbl-name .
      468       end.
      469       block_where:
      470       do v-ind = 1 to v-idx-field-qnty by 2
      471       on error undo, return error
      472       :
      473         assign
      474           v-count-fld = v-count-fld + 1
      475         .
      476         if p-key-handle = ?
      477           and v-count-fld > v-field-num
      478         then do:
      479           leave block_where.
      480         end.
      481         define variable VfieldKeyTable as handle no-undo.
      482         assign
      483           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      484           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      485         .
      486         if     bh_tbl-key ne ?
      487         then do:
      488            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      489            if VfieldKeyTable eq ?
      490            then next block_where.
      491         end.
      492         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      493         then
      494            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      495         else
      496            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      497         if p-key-handle = ? then do:
      498           assign
      499             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      500           .
      501         end.
      502         else do:
      503           assign
      504             fh_key = p-key-handle:buffer-field( v-field-name )
      505           .
      506           if fh_key = ?
      507             or not valid-handle( fh_key )
      508           then do:
      509             delete object bh_tbl-name.
      510             if     bh_tbl-key ne ?
      511             then
      512                delete object bh_tbl-key.
      513             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      514           end.
      515           assign
      516             v-field-val = fh_key:buffer-value
      517           .
      518         end.
      519         if fh_search:data-type ="character":U then do:
      520           assign
      521             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      522             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      523             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      524             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      525             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      526             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      527             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      528             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      529             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      530             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      531             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      532             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      533             v-field-val = substitute( '"&1"', v-field-val )
      534           .
      535         end.
      536         assign
      537           o-where = substitute( "&1 &2", o-where, v-field-val )
      538         .
      539         if v-word-link = "":U then do:
      540           assign
      541             v-word-link = "and":U
      542           .
      543         end.
      544       end.
      545       delete object bh_tbl-name.
      546       if     bh_tbl-key ne ?
      547       then
      548          delete object bh_tbl-key.
      549       if p-key-handle = ?
      550         and v-count-fld <> v-field-num
      551       then do:
      552         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      553       end.
      554     end.
      555   end procedure.
      556   procedure gen-hn-keyr-tab :
      557     define input  parameter i-tableSerach as character no-undo.
      558     define input  parameter i-tablekey   as character no-undo.
      559     define input  parameter p-key-rec    as character no-undo.
      560     define input  parameter p-key-handle as handle    no-undo .
      561     define input  parameter p-db-name    as character no-undo .
      562     define input  parameter p-tt-handle  as handle    no-undo .
      563     define input  parameter p-stts-lock  as integer   no-undo .
      564     define output parameter o-hn         as handle    no-undo.
      565     define variable v-full-tbl-name as character no-undo.
      566     define variable v-where         as character no-undo.
      567     define variable bh_tbl-name     as handle    no-undo.
      568     define variable vTable          as character no-undo.
      569     do
      570     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      571     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      572     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      573         run gen-where-keyr-tab(i-tableSerach,
      574                                i-tablekey,
      575                                p-key-rec,
      576                                p-key-handle,
      577                                p-db-name,
      578                                p-tt-handle,
      579                                output v-where).
      580         if i-tableSerach ne "" and i-tableSerach ne ?
      581         then do:
      582            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      583            create buffer bh_tbl-name for table v-full-tbl-name .
      584         end.
      585         else do:
      586            if p-tt-handle = ? then do:
      587               assign
      588                  vTable = entry( 1 , p-key-rec, chr(3) )
      589               .
      590               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      591               create buffer bh_tbl-name for table v-full-tbl-name .
      592            end.
      593            else do:
      594               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      595            end.
      596         end.
      597         if p-tt-handle = ? then do:
      598            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      599         end.
      600         else do:
      601            bh_tbl-name:find-first( v-where ) no-error .
      602         end.
      603         o-hn = bh_tbl-name.
      604      end.
      605   end procedure.
      606   procedure gen-hn-keyr :
      607     define input  parameter p-key-rec    as character no-undo.
      608     define input  parameter p-key-handle as handle    no-undo .
      609     define input  parameter p-db-name    as character no-undo .
      610     define input  parameter p-tt-handle  as handle    no-undo .
      611     define input  parameter p-stts-lock  as integer   no-undo .
      612     define output parameter o-hn         as handle    no-undo.
      613     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      614   end.
      615   procedure gen-row-keyr :
      616     define input  parameter p-key-rec    as character no-undo.
      617     define input  parameter p-key-handle as handle    no-undo .
      618     define input  parameter p-db-name    as character no-undo .
      619     define input  parameter p-tt-handle  as handle    no-undo .
      620     define input  parameter p-stts-lock  as integer   no-undo .
      621     define output parameter p-tbl-row    as rowid     no-undo.
      622     define output parameter p-tbl-name   as character no-undo.
      623     define variable vHn as handle no-undo.
      624       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      625       p-tbl-row = if vHn:available then vHn:rowid else ?.
      626       p-tbl-name =  vHn:table.
      627       delete object vHn no-error.
      628     if p-tbl-row = ? then do:
      629       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      630     end.
      631     else do:
      632       return.
      633     end.
      634   end procedure.
      635   procedure gen-key-fv :
      636     define input  parameter p-key-rec    as character no-undo .
      637     define output parameter p-field-list as character no-undo .
      638     define output parameter p-value-list as character no-undo.
      639     do
      640     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      641     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      642     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      643     :
      644       define variable v-full-tbl-name  as character no-undo .
      645       define variable bh_tbl-name      as handle    no-undo .
      646       define variable v-tbl-name       as character no-undo .
      647       define variable v-field-num      as integer   no-undo .
      648       define variable v-count-fld      as integer   no-undo .
      649       define variable v-inform         as character no-undo .
      650       define variable v-ind            as integer   no-undo .
      651       define variable v-idx-field-qnty as integer   no-undo .
      652       define variable v-delim-key      as character no-undo .
      653       if p-key-rec = ?
      654         or p-key-rec = "":U
      655       then do:
      656         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      657       end.
      658       assign
      659         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      660         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      661       .
      662       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      663       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      664       assign
      665         v-inform = bh_tbl-name:index-information(1)
      666         v-ind    = 2
      667       .
      668       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      669       on error undo, return error
      670       :
      671         assign
      672           v-inform = bh_tbl-name:index-information( v-ind )
      673           v-ind    = v-ind + 1
      674         .
      675       end.
      676       if v-inform = ?
      677         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      678         or entry( 3, v-inform, ",":U ) <> "1":U
      679       then do:
      680         delete object bh_tbl-name no-error.
      681         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      682       end.
      683       assign
      684         v-idx-field-qnty = num-entries( v-inform ) - 4
      685       .
      686       if v-idx-field-qnty < 2 then do:
      687         delete object bh_tbl-name no-error.
      688         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      689       end.
      690       assign
      691         p-field-list = "":U
      692         p-value-list = "":U
      693         v-delim-key  = "":U
      694         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      695         v-count-fld  = 0
      696       .
      697       block_where:
      698       do v-ind = 1 to v-idx-field-qnty by 2
      699       on error undo, return error
      700       :
      701         assign
      702           v-count-fld = v-count-fld + 1
      703         .
      704         if v-count-fld > v-field-num then do:
      705           leave block_where.
      706         end.
      707         assign
      708           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      709           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      710         .
      711         if v-ind = 1 then do:
      712           assign
      713             v-delim-key = chr(3)
      714           .
      715         end.
      716       end.
      717       delete object bh_tbl-name.
      718       if v-count-fld <> v-field-num then do:
      719         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      720       end.
      721     end.
      722   end procedure.
      723   procedure gen-key-field :
      724     define input  parameter p-table      as character no-undo .
      725     define output parameter p-field-list as character no-undo .
      726     do
      727     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      728     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      729     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      730     :
      731       define variable v-full-tbl-name  as character no-undo .
      732       define variable bh_tbl-name      as handle    no-undo .
      733       define variable v-tbl-name       as character no-undo .
      734       define variable v-field-num      as integer   no-undo .
      735       define variable v-count-fld      as integer   no-undo .
      736       define variable v-inform         as character no-undo .
      737       define variable v-ind            as integer   no-undo .
      738       define variable v-idx-field-qnty as integer   no-undo .
      739       define variable v-delim-key      as character no-undo .
      740       if p-table = ?
      741         or p-table = "":U
      742       then do:
      743         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      744       end.
      745       assign
      746         v-tbl-name      = p-table
      747         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      748       .
      749       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      750       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      751       assign
      752         v-inform = bh_tbl-name:index-information(1)
      753         v-ind    = 2
      754       .
      755       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      756       on error undo, return error
      757       :
      758         assign
      759           v-inform = bh_tbl-name:index-information( v-ind )
      760           v-ind    = v-ind + 1
      761         .
      762       end.
      763       if v-inform = ?
      764         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      765         or entry( 3, v-inform, ",":U ) <> "1":U
      766       then do:
      767         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      768       end.
      769       assign
      770         v-idx-field-qnty = num-entries( v-inform ) - 4
      771       .
      772       if v-idx-field-qnty < 2 then do:
      773         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      774       end.
      775       assign
      776         p-field-list = "":U
      777         v-delim-key  = "":U
      778         v-count-fld  = 0
      779       .
      780       block_where:
      781       do v-ind = 1 to v-idx-field-qnty by 2
      782       on error undo, return error
      783       :
      784         assign
      785           v-count-fld = v-count-fld + 1
      786         .
      787         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      788         if v-ind = 1 then do:
      789           assign
      790             v-delim-key = chr(3)
      791           .
      792         end.
      793       end.
      794       delete object bh_tbl-name.
      795     end.
      796   end procedure.
      797   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      798   procedure cur-time :
      799      define output parameter p-today as date      no-undo .
      800      define output parameter p-time  as integer   no-undo .
      801     do
      802     on error undo, return error
      803     :
      804       define variable v-date1 as date      no-undo .
      805       define variable v-date2 as date      no-undo .
      806       define variable v-time  as integer   no-undo .
      807       assign
      808         v-date1 = today
      809         v-time  = time
      810         v-date2 = today
      811       .
      812       if v-date1 <> v-date2
      813       then do:
      814         assign
      815           v-date1 = today
      816           v-time  = v-time
      817         .
      818       end.
      819       assign
      820         p-today = v-date1
      821         p-time  = v-time
      822       .
      823     end.
      824   end.
      825   function cur-time-date returns character
      826   :
      827     return string(today, '99/99/9999':U) .
      828   end.
      829   function cur-time-mjd returns decimal
      830   :
      831     define variable v-date as date      no-undo .
      832     define variable v-time as integer   no-undo .
      833     run cur-time in this-procedure
      834       (output v-date
      835       ,output v-time
      836       ) .
      837     return integer(v-date) - 2400002 + (v-time / 86400) .
      838   end.
      839   function cur-time-get-ending-index returns integer
      840   (input p-number as integer
      841   )
      842   :
      843     if p-number < 0
      844     or p-number = ?
      845     then do:
      846       return 1 .
      847     end.
      848     define variable v-rest as integer   no-undo .
      849     assign
      850       p-number = p-number modulo 100
      851     .
      852     if p-number < 20
      853     then do:
      854       assign
      855         v-rest = p-number
      856       .
      857     end.
      858     else do:
      859       assign
      860         v-rest = p-number modulo 10
      861       .
      862     end.
      863     case v-rest :
      864       when 1
      865       then do:
      866         return 2 .
      867       end.
      868       when 2 or
      869       when 3 or
      870       when 4
      871       then do:
      872         return 3 .
      873       end.
      874       otherwise do:
      875         return 1 .
      876       end.
      877     end case .
      878   end.
      879   procedure cur-time-mjd-to-date :
      880      define input  parameter i-mjd-diff as decimal no-undo.
      881      define output parameter o-Date     as date    no-undo.
      882      define output parameter o-Time     as integer no-undo.
      883      define variable v-day-number as integer   no-undo .
      884      if    i-mjd-diff < 0
      885         or i-mjd-diff = ?
      886      then do:
      887         return "?" .
      888      end.
      889      assign
      890         v-day-number = truncate(i-mjd-diff,0).
      891         o-Date = date(v-day-number + 2400002).
      892         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      893     .
      894   end.
      895   function cur-time-mjd-to-string returns character
      896   (input p-mjd-diff as decimal
      897   )
      898   :
      899     define variable v-day-number as integer   no-undo .
      900     define variable v-seconds    as integer   no-undo .
      901     define variable v-hour       as integer   no-undo .
      902     define variable v-min        as integer   no-undo .
      903     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      904     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      905     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      906     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      907     if p-mjd-diff < 0
      908     or p-mjd-diff = ?
      909     then do:
      910       return "?" .
      911     end.
      912     assign
      913       v-day-number = integer(truncate(p-mjd-diff,0))
      914       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      915     .
      916     if v-seconds > 86400
      917     then do:
      918       assign
      919         v-seconds = 86400 - 1
      920       .
      921     end.
      922     if v-seconds < 0
      923     then do:
      924       assign
      925         v-seconds = 0
      926       .
      927     end.
      928     assign
      929       v-hour = truncate(v-seconds / 3600, 0)
      930     .
      931     assign
      932       v-seconds = v-seconds modulo 3600
      933     .
      934     assign
      935       v-min = truncate(v-seconds / 60, 0)
      936     .
      937     assign
      938       v-seconds = v-seconds modulo 60
      939     .
      940     return
      941         (if v-day-number <> 0
      942           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      943           else ""
      944         )
      945       + (if v-day-number <> 0 or v-hour <> 0
      946           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      947           else ""
      948         )
      949       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      950           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      951           else ""
      952         )
      953       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      954       .
      955   end.
      956   function cur-time-string returns character
      957   :
      958     define variable v-date as date      no-undo .
      959     define variable v-time as integer   no-undo .
      960     run cur-time in this-procedure
      961       (output v-date
      962       ,output v-time
      963       ) .
      964     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      965   end.
      966   function cur-time-string-sec returns character
      967   :
      968     define variable v-date as date      no-undo .
      969     define variable v-time as integer   no-undo .
      970     run cur-time in this-procedure
      971       (output v-date
      972       ,output v-time
      973       ) .
      974     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      975   end.
      976   function cur-time-custom  returns character
      977   (input p-prefix as character
      978   ,input p-date-format as character
      979   ,input p-delimiter as character
      980   ,input p-time-format as character
      981   ,input p-suffix as character
      982   )
      983   :
      984     define variable v-date as date      no-undo .
      985     define variable v-time as integer   no-undo .
      986     run cur-time in this-procedure
      987       (output v-date
      988       ,output v-time
      989       ) .
      990     return
      991       p-prefix
      992       + string(v-date, p-date-format)
      993       + p-delimiter
      994       + string(v-time, p-time-format)
      995       + p-suffix
      996       .
      997   end.
      998   function cur-time-print  returns character
      999   :
     1000     define variable v-date as date      no-undo .
     1001     define variable v-time as integer   no-undo .
     1002     run cur-time in this-procedure
     1003       (output v-date
     1004       ,output v-time
     1005       ) .
     1006     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1007   end.
     1008   function cur-time-datetime returns datetime
     1009   :
     1010     define variable v-char as character no-undo .
     1011     define variable v-datetime as datetime no-undo .
     1012     v-char = cur-time-string().
     1013     v-datetime = datetime(v-char).
     1014     return  v-datetime.
     1015   end.
     1016   function cur-time-string-msec returns character
     1017   :
     1018     define variable v-date as datetime  no-undo .
     1019     v-date = now.
     1020     return string(v-date) .
     1021   end.
     1022   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1023   define new shared temp-table temp-hist-nws-option no-undo
     1024   like ub.hist-nws-option
     1025   .
     1026   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1029   FUNCTION get-region RETURNS CHARACTER
     1030     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1031     define variable par-region as character no-undo.
     1032     if parhost-code = 0 and
     1033          parobj-type = "":U and
     1034          parobj-code = 0 then do:
     1035          par-region = "Глобально".
     1036          return par-region.
     1037       end.
     1038       if parobj-type = 'орг':U then do:
     1039          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1040          return par-region.
     1041       end.
     1042       if parobj-type = 'регион':U
     1043       then do:
     1044          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1045          return par-region.
     1046       end.
     1047       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1048       return par-region.
     1049   END FUNCTION.
     1050   FUNCTION get-objregion RETURNS CHARACTER
     1051     (  input parobj-type as character, input parobj-code as integer ) :
     1052     define variable par-region as character no-undo.
     1053     if  parobj-type = "":U and
     1054         parobj-code = 0
     1055     then do:
     1056        par-region = "Глобально".
     1057     end.
     1058     else if parobj-type = 'орг':U
     1059     then do:
     1060        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1061     end.
     1062     else if parobj-type = 'регион':U
     1063     then do:
     1064        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1065     end.
     1066     else
     1067        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1068     return par-region.
     1069   END FUNCTION.
     1070   FUNCTION calldscr returns character ( input p-call-id as character):
     1071   define variable v-descr as character no-undo .
     1072   define variable v-field-list as character no-undo .
     1073   define variable v-value-list as character no-undo.
     1074   define variable v-prop-label as character no-undo .
     1075   define variable v-node-label as character no-undo .
     1076   define variable v-dt-code as integer no-undo .
     1077   define variable v-host-code as integer no-undo .
     1078   define variable v-obj-type as character no-undo .
     1079   define variable v-obj-code as integer no-undo .
     1080   define variable v-label as character no-undo .
     1081   define variable v-node-code as integer no-undo .
     1082   define buffer buf_prop-head for ub.prop-head.
     1083   define buffer buf_prop-ref for ub.prop-ref.
     1084   define buffer buf_prop-map for ub.prop-map.
     1085   run gen-key-fv in this-procedure ( input p-call-id
     1086                                     ,output v-field-list
     1087                                     ,output v-value-list) no-error .
     1088   if error-status:error then return p-call-id.
     1089   CASE entry(1, p-call-id, chr(3)):
     1090     when 'dis-card-type':U then do:
     1091       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1092                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1093                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1094                            ).
     1095     end.
     1096     when 'dis-card':U then do:
     1097       v-descr = substitute("ДК: № &1"
     1098                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1099                            ).
     1100     end.
     1101     when 'dis-card-property':U then do:
     1102       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1103       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1104       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1105       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1106       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1107       find first buf_prop-ref no-lock where
     1108                 buf_prop-ref.dt-code = v-dt-code no-error .
     1109       if available buf_prop-ref then do:
     1110         find first buf_prop-head no-lock where
     1111                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1112         v-prop-label = buf_prop-head.prop-label.
     1113         find first buf_prop-map no-lock where
     1114                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1115               and buf_prop-map.node-code = v-node-code no-error .
     1116         if available buf_prop-map then do:
     1117           v-label = buf_prop-map.node-label.
     1118         end.
     1119       end.
     1120       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1121                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1122                            ,v-prop-label
     1123                            ,v-label
     1124                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1125                            ).
     1126     end.
     1127     when 'clients':U then do:
     1128       v-descr = substitute("&1&2"
     1129                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1130                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1131                            ).
     1132     end.
     1133     when 'ext-system':U then do:
     1134       v-descr = substitute("Внешняя система &1"
     1135                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1136                            ).
     1137     end.
     1138     WHEN 'thbj-attr':U then do:
     1139       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1140       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1141       then do:
     1142         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1143           v-descr = "Операции с товарами".
     1144         end.
     1145         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1146           v-descr = "Операции с клиентами".
     1147         end.
     1148         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1149           v-descr = "Операции с группами товаров".
     1150         end.
     1151         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1152           v-descr = "Операции с группами клиентов".
     1153         end.
     1154         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1155           v-descr = "Операции с чеками на POS IBS-TH".
     1156         end.
     1157         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1158           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1159         end.
     1160         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1161           v-descr = "Операции в системе электронного документооборота".
     1162         end.
     1163         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1164           v-descr = "Операции со справочниками".
     1165         end.
     1166         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1167           v-descr = "Операции с ДНЦ и переоценками".
     1168         end.
     1169         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1170           v-descr = "Отчеты".
     1171         end.
     1172         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1173           v-descr = "Операции с заказами".
     1174         end.
     1175       end.
     1176     end.
     1177     when 'cash-desk':U then do:
     1178       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1179                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1180                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1181                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1182                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1183                            ).
     1184     end.
     1185     when 'ext-file':U then do:
     1186       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1187                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1188                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1189                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1190                            ).
     1191     end.
     1192   end case.
     1193   return v-descr.
     1194   end function.
     1195   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   define new shared temp-table temp-param-name no-undo
     1197   field profile_id as integer
     1198   field profile-type as character
     1199   field schema-name as character
     1200   field esys-id as integer
     1201   field call_id as character
     1202   field once-more as integer
     1203   field codex_id as integer
     1204   field ruleset_id as integer
     1205   field order_id as integer
     1206   field param-name as character
     1207   field param-type as character
     1208   field pack-process-uniq-key-rec as character
     1209   index pi is primary unique
     1210   esys-id
     1211   schema-name
     1212   profile_id
     1213   call_id
     1214   .
     1215   procedure xmlischn_fill :
     1216   define input  parameter p-codex-id  as integer   no-undo .
     1217   define input  parameter p-ruleset-id as integer   no-undo .
     1218   define buffer buf_rule-call-param  for ub.rule-call-param.
     1219   define buffer buf2_rule-call-param for ub.rule-call-param.
     1220   define buffer buf_temp-param-name for temp-param-name.
     1221   define variable v-esys-id-list as character no-undo .
     1222   define variable v-ii as integer no-undo .
     1223     do
     1224     on error undo, return error return-value
     1225     :
     1226       for each buf_rule-call-param where
     1227               buf_rule-call-param.codex_id = p-codex-id
     1228           and buf_rule-call-param.ruleset_id = p-ruleset-id
     1229       break
     1230       by buf_rule-call-param.call_id
     1231       by buf_rule-call-param.profile_id
     1232       by buf_rule-call-param.once-more
     1233       :
     1234         if first-of(buf_rule-call-param.once-more) then do:
     1235           v-esys-id-list = ''.
     1236           for each buf2_rule-call-param no-lock
     1237              where buf2_rule-call-param.call_id    = buf_rule-call-param.call_id
     1238                and buf2_rule-call-param.codex_id   = buf_rule-call-param.codex_id
     1239                and buf2_rule-call-param.ruleset_id = buf_rule-call-param.ruleset_id
     1240                and buf2_rule-call-param.profile_id = buf_rule-call-param.profile_id
     1241                and buf2_rule-call-param.once-more  = buf_rule-call-param.once-more
     1242                and buf2_rule-call-param.param-2-data-type = 'ext-system':U :
     1243             if buf2_rule-call-param.param-name = "p-esys-id"
     1244                  or
     1245                  (buf2_rule-call-param.param-name = "p-esys-id-list"
     1246                  and
     1247                  buf2_rule-call-param.p-index > 0)
     1248             then do:
     1249               assign
     1250               v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(44)) +
     1251                               string( buf2_rule-call-param.param-value-integer)
     1252               .
     1253             end.
     1254           end.
     1255         end.
     1256         if v-esys-id-list = "" then v-esys-id-list = "-1".
     1257         if buf_rule-call-param.param-2-data-type = "xsd" then do:
     1258           find first buf_temp-param-name where
     1259                   buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1260             and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1261             and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1262             and buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1263             no-error.
     1264           if not available buf_temp-param-name then do:
     1265             do v-ii = 1 to num-entries(v-esys-id-list):
     1266               find first buf_temp-param-name where
     1267                       buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1268                 and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1269                 and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1270                 and buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1271                 no-error.
     1272               if not available buf_temp-param-name then do:
     1273             create buf_temp-param-name.
     1274             assign
     1275             buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1276             buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1277             buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1278             buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1279             buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1280             buf_temp-param-name.ruleset_id = buf_rule-call-param.ruleset_id
     1281             buf_temp-param-name.codex_id = buf_rule-call-param.codex_id
     1282             buf_temp-param-name.order_id = buf_rule-call-param.order_id
     1283             buf_temp-param-name.param-name = buf_rule-call-param.param-name
     1284               buf_temp-param-name.param-type = "xsd"
     1285               buf_temp-param-name.profile-type = entry (buf_rule-call-param.codex_id, 'dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,,,,,goods,clients,gds-grp,cli-grp,,,,edoc,chk-doc,thref,pdf,rep,ord,fdoc':U)
     1286               buf_temp-param-name.pack-process-uniq-key-rec =
     1287               substitute("&2&1&3&1&4&1&5"
     1288                                                                         , chr(4)
     1289                                                                         , buf_rule-call-param.call_id
     1290                                                                         , buf_rule-call-param.codex_id
     1291                                                                         , buf_rule-call-param.ruleset_id
     1292                                                                         , buf_rule-call-param.order_id)
     1293               .
     1294               end.
     1295             end.
     1296           end.
     1297         end.
     1298         if buf_rule-call-param.param-2-data-type = "sub-type" then do:
     1299           find first buf_temp-param-name where
     1300                   buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1301             and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1302             and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1303             and buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1304             no-error.
     1305           if not available buf_temp-param-name then do:
     1306             do v-ii = 1 to num-entries(v-esys-id-list):
     1307               find first buf_temp-param-name where
     1308                       buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1309                 and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1310                 and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1311                 and buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1312                 no-error.
     1313               if not available buf_temp-param-name then do:
     1314               create buf_temp-param-name.
     1315               assign
     1316               buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1317               buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1318               buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1319               buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1320               buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1321               buf_temp-param-name.ruleset_id = buf_rule-call-param.ruleset_id
     1322               buf_temp-param-name.codex_id = buf_rule-call-param.codex_id
     1323               buf_temp-param-name.order_id = buf_rule-call-param.order_id
     1324               buf_temp-param-name.param-name = buf_rule-call-param.param-name
     1325               buf_temp-param-name.param-type = "no-xsd"
     1326             buf_temp-param-name.profile-type = entry (buf_rule-call-param.codex_id, 'dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,,,,,goods,clients,gds-grp,cli-grp,,,,edoc,chk-doc,thref,pdf,rep,ord,fdoc':U)
     1327             buf_temp-param-name.pack-process-uniq-key-rec =
     1328             substitute("&2&1&3&1&4&1&5"
     1329                                                                        , chr(4)
     1330                                                                        , buf_rule-call-param.call_id
     1331                                                                        , buf_rule-call-param.codex_id
     1332                                                                        , buf_rule-call-param.ruleset_id
     1333                                                                        , buf_rule-call-param.order_id)
     1334             .
     1335           end.
     1336         end.
     1337       end.
     1338       end.
     1339       end.
     1340     end.
     1341   end procedure.
     1342   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1343   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   PROCEDURE verify-ini-entry:
     1345   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1346   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1347   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1348   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1349   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1350   define variable v-mess as character no-undo .
     1351   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1352   if ini-entry-value = ? and ini-key-name begins "spl"
     1353   then
     1354   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1355   if ini-entry-value = ? and ini-key-name begins "sav"
     1356   then
     1357   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1358   if ini-entry-value = ? then do:
     1359     assign
     1360     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1361                       , chr(10)
     1362                       , ini-section-name
     1363                       , ini-key-name
     1364                       , error-msg-text).
     1365       if not silence then do:
     1366         message
     1367         v-mess
     1368         view-as alert-box ERROR  .
     1369         return error.
     1370       end.
     1371       else do:
     1372         return error v-mess.
     1373       end.
     1374   end.
     1375   END PROCEDURE.
     1376   PROCEDURE verify-file:
     1377   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1378   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1379   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1380   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1381   file-info:file-name = filename.
     1382   found = NOT (file-info:full-pathname = ?).
     1383   if NOT found  then do:
     1384     if not silence then do:
     1385       message error-msg-text
     1386       view-as alert-box ERROR.
     1387       return error.
     1388     end.
     1389     else return error error-msg-text.
     1390   end.
     1391   END PROCEDURE.
     1392   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1393   function prepare-path returns character ( input p-nonprepared-path as character ):
     1394   define variable v-prepared-path as character no-undo .
     1395   assign
     1396   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
     1397   v-prepared-path = right-trim(v-prepared-path, chr(47))
     1398   .
     1399   return v-prepared-path.
     1400   END FUNCTION.
     1401   function prepare-path2 returns character ( input p-nonprepared-path as character ):
     1402   define variable v-prepared-path as character no-undo .
     1403   assign
     1404   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
     1405   v-prepared-path = right-trim(v-prepared-path, chr(92))
     1406   .
     1407   return v-prepared-path.
     1408   END FUNCTION.
     1409   function quote-spaces returns character ( input p-full-path as character):
     1410   define variable v-ii as integer no-undo .
     1411   define variable v-result as character no-undo .
     1412   do v-ii = 1 to num-entries(p-full-path, chr(92)):
     1413     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
     1414                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
     1415                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
     1416                else entry(v-ii, p-full-path, chr(92))
     1417                )
     1418     .
     1419   end.
     1420   return v-result.
     1421   end function.
