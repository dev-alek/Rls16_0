     2029                       if log-file-name <> '':U then run write-log-and-file in p-log-handle (      input 1                                                        , input log-file-name                                            , input 1                                                        , input substitute("...(&2) &1", buf_rule-by-call.algo-des, buf_rule-by-call.rule_id)).
     2030           v-found = yes.
     2031           run value(v-proc-name)  (
     2032                                                                 input parparentproc
     2033                                                               ,input this-procedure:handle
     2034                                                               ,input p-log-handle
     2035                                                               ,input v-cont-handle
     2036                                                               ,input v-codex-id
     2037                                                               ,input v-ruleset-id
     2038                                                               ,input buf_rule-by-call.call_id
     2039                                                               ,input buf_rule-by-call.order_id
     2040                                                               ,input buf_rule-by-call.rule_id
     2041                                                               ,input buf_rule-by-call.profile
     2042                                                               ,input buf_rule-by-call.is_dynamic
     2043                                                               ,input v-doc-type
     2044                                                               ,input v-host-code
     2045                                                               ,input v-obj-type
     2046                                                               ,input v-obj-code
     2047                                                               ,input v-doc-code
     2048                                                               ,input v-dirs
     2049                                                               ,input v-save-int
     2050                                                               ,input v-curr-r-b
     2051                                                               ,input v-cmd-proc-handle
     2052                                                               ,input 0
     2053                                                               ) no-error .
     2054           if error-status:error
