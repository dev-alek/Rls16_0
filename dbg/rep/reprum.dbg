     2186   procedure cb_fill-report-parameters :
     2187   define input parameter p-rpbh as handle no-undo .
     2188   define input parameter p-report-id as character no-undo .
     2189   main-block:
     2190   for each buf_rule-call-param where
     2191           buf_rule-call-param.call_id = p-uniq-key-rec
     2192       and buf_rule-call-param.codex_id = v-codex-id
     2193       and buf_rule-call-param.ruleset_id = v-ruleset-id
     2194       and buf_rule-call-param.order_id = buf_rule-by-call.order_id
     2195    on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2196    on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2197    on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2198    :
     2199     if lookup("hidden", buf_rule-call-param.param-3-data-type) > 0 then next.
     2200     if buf_rule-call-param.param-mode <> 'input':U then next.
     2201     if buf_rule-call-param.p-index = 0
     2202     and lookup("LIST", buf_rule-call-param.param-3-data-type) > 0 then next.
     2203     p-rpbh:buffer-create().
     2204     assign
     2205     p-rpbh::report-id     = p-report-id
     2206     p-rpbh::parameter-name    = buf_rule-call-param.param-name
     2207     p-rpbh::parameter-label   = buf_rule-call-param.param-label
     2208     p-rpbh::parameter-value-type = buf_rule-call-param.param-data-type
     2209     p-rpbh::parameter-value = if buf_rule-call-param.param-data-type = 'character':U
     2210                           then buf_rule-call-param.param-value-character
     2211                           else p-rpbh::parameter-value
     2212     p-rpbh::parameter-value = if buf_rule-call-param.param-data-type = 'date':U
     2213                           then string(buf_rule-call-param.param-value-date, "99/99/9999")
     2214                           else p-rpbh::parameter-value
     2215     p-rpbh::parameter-value = if buf_rule-call-param.param-data-type = 'decimal':U
     2216                           then string(buf_rule-call-param.param-value-decimal)
     2217                           else p-rpbh::parameter-value
     2218     p-rpbh::parameter-value = if buf_rule-call-param.param-data-type = 'logical':U
     2219                           then string(buf_rule-call-param.param-value-logical)
     2220                           else p-rpbh::parameter-value
     2221     p-rpbh::parameter-value = if buf_rule-call-param.param-data-type = 'integer':U
     2222                           then string(buf_rule-call-param.param-value-integer)
     2223                           else p-rpbh::parameter-value
     2224     p-rpbh::parameter-index = buf_rule-call-param.p-index
     2225     p-rpbh::parameter-des = buf_rule-call-param.param-des
     2226     .
     2227     p-rpbh:buffer-release.
     2228   end.
     2229   end procedure.
     2230   procedure cb_write-report-error :
     2231   define input parameter p-rebh as handle no-undo .
     2232   define input parameter p-report-id as character no-undo .
     2233   define input parameter p-errcode as integer no-undo .
