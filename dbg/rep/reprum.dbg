     2024         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
     2025           v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     2026             run write-log  in p-log-handle (
