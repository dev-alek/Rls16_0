     1822                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1823                                                     ,input v-rec-ord
     1824                                                     ,input no
     1825                                                     ).
     1826     end.
     1827   end procedure.
     1828   procedure create-no-route :
     1829   define input parameter p-rec-ord as integer no-undo .
     1830   define input parameter p-db-num as integer no-undo .
     1831   define buffer buf_temp-no-route for temp-no-route.
     1832   do
     1833   on error undo, return error
     1834   :
     1835      find first buf_temp-no-route where
     1836                 buf_temp-no-route.rec-ord = p-rec-ord
     1837              and buf_temp-no-route.db-num = p-db-num no-error .
     1838      if not available buf_temp-no-route then do:
     1839        create buf_temp-no-route.
     1840        assign
     1841        buf_temp-no-route.rec-ord = p-rec-ord
     1842        buf_temp-no-route.db-num = p-db-num
     1843        .
     1844      end.
     1845   end.
     1846   end procedure.
     1847   procedure clear-from-rec-ord :
     1848   define input parameter p-rec-ord as integer no-undo .
