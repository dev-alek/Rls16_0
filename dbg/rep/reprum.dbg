     2163   procedure cb_fill-report-header :
     2164   define input parameter p-rbh as handle no-undo .
     2165   define input parameter p-report-id as character no-undo .
     2166   define input parameter p-report-name  as character no-undo .
     2167   define input parameter p-report-label as character no-undo .
     2168   define input parameter p-datestart as datetime no-undo .
     2169   define input parameter p-dateend as datetime no-undo .
