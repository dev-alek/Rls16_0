     2003     END CASE.
     2004     run init-rule-call-params in this-procedure (input p-uniq-key-rec).
     2005     _codex:
     2006     do v-jj = 1 to num-entries(v-codex-id-list):
     2007       if entry(v-jj, v-codex-id-list) = '':U then next _codex.
     2008       v-codex-id = integer(entry(v-jj, v-codex-id-list)).
     2009       do v-ii = 1 to num-entries(v-ruleset-id-list[v-jj]):
     2010           if entry(v-ii, v-ruleset-id-list[v-jj]) = '':U then next.
     2011           v-ruleset-id = integer(entry(v-ii, v-ruleset-id-list[v-jj])).
     2012         _rule-by-call:
     2013         for each buf_rule-by-call no-lock where
     2014                   buf_rule-by-call.call_id = p-uniq-key-rec
     2015             and buf_rule-by-call.can-calc = yes
     2016             and buf_rule-by-call.codex_id = v-codex-id
     2017             and buf_rule-by-call.ruleset_id = v-ruleset-id
     2018         by buf_rule-by-call.call_Id
