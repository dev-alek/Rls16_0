     2243     end.
     2244     else do:
     2245      v-errnum = p-rebh::ErrNum + 1.
     2246     end.
     2247     p-rebh:buffer-create().
     2248     assign
     2249     p-rebh::report-id     = p-report-id
     2250     p-rebh::errNum        = v-errnum
