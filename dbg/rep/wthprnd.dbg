        1   define input parameter p-form-name                  as character        no-undo.
        2   define input parameter p-parameters-string-old      as character        no-undo.
        3   define input parameter p-parameters-enabled-string  as character        no-undo.
        4   define output parameter p-parameters-string-new     as character        no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Параметры печати формы для материальных ценностей".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "X(65)" no-undo
       81   initial "@(#)$Workfile$ $Revision$".
       82       define temp-table Tmp#List no-undo like ub.ord-blank
       83           field id                        as integer
       84           field proc-name                 as character
       85           field proc-param                as character
       86           field print-options             as character
       87           field orient                    as character
       88           field orient-orientation        as character
       89           field orient-font-num           as integer
       90           field font-num                  as character
       91           field filtr                     as character
       92           field view_                     as integer  init 1
       93           field sys-key                   as character
       94           field sys-key-black             as character
       95           field type-parts                as character
       96           field type-parts-enabled        as logical
       97           field type-price                as character
       98           field type-price-enabled        as logical
       99           field type-scale                as character
      100           field type-scale-enabled        as logical
      101           field type-val                  as character
      102           field type-val-enabled          as logical
      103           field sort-name                 as character
      104           field sort-name-enabled         as logical
      105           field sort-gr                   as character
      106           field sort-gr-enabled           as logical
      107           field print-graft               as character
      108           field print-graft-enabled       as logical
      109           field no-vat                    as character
      110           field no-vat-enabled            as logical
      111           index pi is primary unique id
      112           index in-name
      113              blank-name
      114           index lu
      115               last-use
      116       .
      117       define temp-table temp_form-list no-undo
      118           field doc-code  as character
      119           field id        as integer
      120           field doc-type  as character
      121           field status_   as character
      122           field internal  as character
      123           field flag      as character
      124           index pi is primary unique
      125               doc-code
      126               id
      127           index idx
      128               id
      129       .
      130       define temp-table temp_menu-doc_disabled-doc-list no-undo
      131           field doc-code      as character
      132           field blank-name    as character
      133           field reason        as character
      134           index pi is primary unique
      135                   doc-code
      136                   blank-name
      137       .
      138       define variable v-menu-doc-sys-key              as character    no-undo.
      139       define variable v-menu-doc-doc-code             as character    no-undo.
      140       define variable v-menu-doc-doc-type             as character    no-undo.
      141       define variable v-menu-doc-ext-doc-type         as character    no-undo.
      142       define variable v-menu-doc-status_              as character    no-undo.
      143       define variable v-menu-doc-internal             as character    no-undo.
      144       define variable v-menu-doc-flag                 as character    no-undo.
      145       define variable v-menu-doc-item-counter         as integer      no-undo.
      146       define variable v-menu-doc-item-disabled        as logical      no-undo.
      147   define variable vss-include-info1 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      148   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      149     define variable p-entry   as logical   no-undo .
      150     define variable v-ind as integer   no-undo .
      151     if p-delimiter = "*":U then do:
      152       message
      153         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      154         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      155         view-as alert-box error .
      156       return ? .
      157     end.
      158     assign
      159       p-entry = true
      160     .
      161     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      162       assign
      163         p-entry = false
      164       .
      165       if num-entries( p-list, "*":U ) > 1 then do:
      166         block_check-list:
      167         do v-ind = 1 to num-entries( p-list, p-delimiter )
      168         :
      169           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      170             assign
      171               p-entry = true
      172             .
      173             leave block_check-list .
      174           end.
      175         end.
      176       end.
      177     end.
      178     return p-entry .
      179   end function .
      180       procedure menu-doc-create-menu-item
      181       :
      182       define input parameter p-type   as   character no-undo.
      183       define input parameter p-stat   as   character no-undo.
      184       define input parameter p-intr   as   character no-undo.
      185       define input parameter p-flag   as   character no-undo.
      186       define input parameter param-1  as   character no-undo.
      187       define input parameter param-2  as   character no-undo.
      188       define input parameter param-3  as   character no-undo.
      189       define input parameter param-4  as   character no-undo.
      190       define input parameter param-5  as   character no-undo.
      191       define input parameter param-6  as   character no-undo.
      192       define input parameter param-7  as   character no-undo.
      193       define input parameter param-8  as   character no-undo.
      194       define input parameter param-9  as   character no-undo.
      195       define input parameter param-10 as   character no-undo.
      196       define input parameter param-11 as   character no-undo.
      197       define input parameter param-12 as   character no-undo.
      198       do
      199       on error undo, return error
      200       :
      201           assign
      202               v-menu-doc-item-disabled = yes
      203           .
      204           if v-menu-doc-sys-key <> 'ExpertekIBS':U
      205           and ( ( param-10 <> "":U
      206                   and check-entry-with-mask( v-menu-doc-sys-key, param-10, chr(44) ) = false
      207                 )
      208                 or ( param-12 <> "":U
      209                      and check-entry-with-mask( v-menu-doc-sys-key, param-12, chr(44) ) = true )
      210                    )
      211           then do:
      212               undo, return .
      213           end.
      214           if param-7 = "":U
      215           then do:
      216               undo, return .
      217           end.
      218           if param-1 = '*':U
      219           or lookup( p-type, param-1 ) > 0
      220           then do:
      221               if param-2 = '*':U
      222               or lookup( p-stat, param-2 ) > 0
      223               then do:
      224                   if param-3 = '*':U
      225                   or lookup( p-intr, param-3 ) > 0
      226                   then do:
      227                       if param-4 = '*':U
      228                       or lookup( p-flag, param-4 ) > 0
      229                       then do:
      230                           assign
      231                               v-menu-doc-item-disabled = no
      232                           .
      233                           find first tmp#list
      234                                where tmp#list.blank-name     = param-5
      235                                  and tmp#list.filtr          = param-6
      236                                  and tmp#list.proc-name      = param-7
      237                                  and tmp#list.proc-param     = param-8
      238                                  and tmp#list.print-options  = param-9
      239                                  and tmp#list.sys-key        = param-10
      240                                  and tmp#list.orient         = param-11
      241                                  and tmp#list.sys-key-black  = param-12
      242                           no-error.
      243                           if not available tmp#list
      244                           then do:
      245                               assign
      246                                   v-menu-doc-item-counter = v-menu-doc-item-counter + 1
      247                               .
      248                               create tmp#list.
      249                               assign
      250                                   tmp#list.id             = v-menu-doc-item-counter
      251                                   tmp#list.cli-code       = v-menu-doc-item-counter
      252                                   tmp#list.blank-name     = param-5
      253                                   tmp#list.filtr          = param-6
      254                                   tmp#list.proc-name      = param-7
      255                                   tmp#list.proc-param     = param-8
      256                                   tmp#list.print-options  = param-9
      257                                   tmp#list.sys-key        = param-10
      258                                   tmp#list.orient         = param-11
      259                                   tmp#list.sys-key-black  = param-12
      260                               .
      261                               assign
      262                                   tmp#list.orient-orientation     = entry( 1, tmp#list.orient )
      263                                   tmp#list.orient-font-num        = 7
      264                               .
      265                               assign
      266                                   tmp#list.orient-font-num      = ( if num-entries( tmp#list.orient ) > 1
      267                                                                     then integer( entry( 2, tmp#list.orient ) )
      268                                                                     else 7 )
      269                               no-error.
      270                               if error-status :error
      271                               then do:
      272                                   assign
      273                                       tmp#list.orient-font-num = 7
      274                                   .
      275                               end.
      276                               run menu-doc-set-visible-options in this-procedure (
      277                                     input tmp#list.print-options
      278                                   , output tmp#list.type-parts-enabled
      279                                   , output tmp#list.type-price-enabled
      280                                   , output tmp#list.type-scale-enabled
      281                                   , output tmp#list.type-val-enabled
      282                                   , output tmp#list.sort-name-enabled
      283                                   , output tmp#list.sort-gr-enabled
      284                                   , output tmp#list.print-graft-enabled
      285                                   , output tmp#list.no-vat-enabled
      286                               ).
      287                           end.
      288                       end.
      289                   end.
      290               end.
      291           end.
      292           if v-menu-doc-item-disabled = yes
      293           then do:
      294               find first tmp#list
      295                    where tmp#list.blank-name     = param-5
      296                      and tmp#list.filtr          = param-6
      297                      and tmp#list.proc-name      = param-7
      298                      and tmp#list.proc-param     = param-8
      299                      and tmp#list.print-options  = param-9
      300                      and tmp#list.sys-key        = param-10
      301                      and tmp#list.orient         = param-11
      302                      and tmp#list.sys-key-black  = param-12
      303               no-error.
      304               if available tmp#list
      305               then do:
      306                   find first temp_menu-doc_disabled-doc-list
      307                        where temp_menu-doc_disabled-doc-list.doc-code     = v-menu-doc-doc-code
      308                          and temp_menu-doc_disabled-doc-list.blank-name   = param-5
      309                   no-error.
      310                   if not available temp_menu-doc_disabled-doc-list
      311                   then do:
      312                       create temp_menu-doc_disabled-doc-list.
      313                       assign
      314                           temp_menu-doc_disabled-doc-list.doc-code    = v-menu-doc-doc-code
      315                           temp_menu-doc_disabled-doc-list.blank-name  = param-5
      316                       .
      317                   end.
      318                   if param-1 <> '*':U
      319                   and lookup( p-type, param-1 ) > 0
      320                   then do:
      321                       assign
      322                           temp_menu-doc_disabled-doc-list.reason   = "type":U
      323                       .
      324                   end.
      325                   assign
      326                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      327                   .
      328                   if param-2 <> '*':U
      329                   and lookup( p-stat, param-2 ) > 0
      330                   then do:
      331                       assign
      332                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "stat":U
      333                       .
      334                   end.
      335                   assign
      336                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      337                   .
      338                   if param-3 <> '*':U
      339                   and lookup( p-intr, param-3 ) > 0
      340                   then do:
      341                       assign
      342                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "intr":U
      343                       .
      344                   end.
      345                   assign
      346                       temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + ",":U
      347                   .
      348                   if param-4 <> '*':U
      349                   and lookup( p-flag, param-4 ) > 0
      350                   then do:
      351                       assign
      352                           temp_menu-doc_disabled-doc-list.reason = temp_menu-doc_disabled-doc-list.reason + "flag":U
      353                       .
      354                   end.
      355                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      356                   then do:
      357                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      358                             input tmp#list.blank-name
      359                           , input tmp#list.sys-key
      360                           , input Tmp#List.sys-key-black
      361                           , output tmp#list.blank-name
      362                       ).
      363                   end.
      364               end.
      365               else do:
      366                   assign
      367                       v-menu-doc-item-disabled = no
      368                   .
      369               end.
      370           end.
      371           if v-menu-doc-item-disabled = no
      372           then do:
      373               find first tmp#list
      374                    where tmp#list.blank-name     = param-5
      375                      and tmp#list.filtr          = param-6
      376                      and tmp#list.proc-name      = param-7
      377                      and tmp#list.proc-param     = param-8
      378                      and tmp#list.print-options  = param-9
      379                      and tmp#list.sys-key        = param-10
      380                      and tmp#list.orient         = param-11
      381                      and tmp#list.sys-key-black  = param-12
      382               no-error.
      383               if available tmp#list
      384               then do:
      385                   find first temp_form-list
      386                        where temp_form-list.doc-code  = v-menu-doc-doc-code
      387                          and temp_form-list.id        = tmp#list.id
      388                   no-error.
      389                   if not available temp_form-list
      390                   then do:
      391                       create temp_form-list.
      392                       assign
      393                           temp_form-list.doc-code  = v-menu-doc-doc-code
      394                           temp_form-list.id        = tmp#list.id
      395                           temp_form-list.doc-type  = v-menu-doc-doc-type
      396                           temp_form-list.status_   = v-menu-doc-status_
      397                           temp_form-list.internal  = v-menu-doc-internal
      398                           temp_form-list.flag      = v-menu-doc-flag
      399                       .
      400                   end.
      401                   if v-menu-doc-sys-key = 'ExpertekIBS':U
      402                   then do:
      403                       run menu-doc-extend-blank-name-for-IBS in this-procedure (
      404                             input tmp#list.blank-name
      405                           , input tmp#list.sys-key
      406                           , input Tmp#List.sys-key-black
      407                           , output tmp#list.blank-name
      408                       ).
      409                   end.
      410               end.
      411           end.
      412       end.
      413       end procedure.
      414       procedure menu-doc-set-visible-options :
      415       define input parameter p-print-options          as character        no-undo.
      416       define output parameter p-type-parts-enabled    as logical          no-undo.
      417       define output parameter p-type-price-enabled    as logical          no-undo.
      418       define output parameter p-type-scale-enabled    as logical          no-undo.
      419       define output parameter p-type-val-enabled      as logical          no-undo.
      420       define output parameter p-sort-name-enabled     as logical          no-undo.
      421       define output parameter p-sort-gr-enabled       as logical          no-undo.
      422       define output parameter p-print-graft-enabled   as logical          no-undo.
      423       define output parameter p-no-vat-enabled        as logical          no-undo.
      424       do
      425       on error undo, return error
      426       :
      427           assign
      428               p-type-parts-enabled    = ( if substring( p-print-options, 1, 1 ) = "+" then yes else no )
      429               p-type-price-enabled    = ( if substring( p-print-options, 2, 1 ) = "+" then yes else no )
      430               p-type-scale-enabled    = ( if substring( p-print-options, 3, 1 ) = "+" then yes else no )
      431               p-type-val-enabled      = ( if substring( p-print-options, 4, 1 ) = "+" then yes else no )
      432               p-sort-name-enabled     = ( if substring( p-print-options, 5, 1 ) = "+" then yes else no )
      433               p-sort-gr-enabled       = ( if substring( p-print-options, 6, 1 ) = "+" then yes else no )
      434               p-print-graft-enabled   = ( if substring( p-print-options, 7, 1 ) = "+" then yes else no )
      435               p-no-vat-enabled        = ( if substring( p-print-options, 8, 1 ) = "+" then yes else no )
      436           .
      437       end.
      438       end procedure.
      439       procedure menu-doc-create-options-string :
      440       define input parameter p-tmp-list-id        as integer          no-undo.
      441       define output parameter p-options-string    as character        no-undo.
      442           define buffer buf_tmp#list      for tmp#list.
      443       do
      444       for buf_tmp#list
      445       on error undo, return error
      446       :
      447           find first buf_tmp#list
      448                where buf_tmp#list.id = p-tmp-list-id
      449           .
      450           assign
      451               p-options-string =  ( if trim( buf_tmp#list.type-parts  ) = "+":U then "+":U else "-":U )
      452                                 + ( if trim( buf_tmp#list.type-price  ) = "+":U then "+":U else "-":U )
      453                                 + ( if trim( buf_tmp#list.type-scale  ) = "+":U then "+":U else "-":U )
      454                                 + ( if trim( buf_tmp#list.type-val    ) = "+":U then "+":U else "-":U )
      455                                 + ( if trim( buf_tmp#list.sort-name   ) = "+":U then "+":U else "-":U )
      456                                 + ( if trim( buf_tmp#list.sort-gr     ) = "+":U then "+":U else "-":U )
      457                                 + ( if trim( buf_tmp#list.print-graft ) = "+":U then "+":U else "-":U )
      458                                 + ( if trim( buf_tmp#list.no-vat      ) = "+":U then "+":U else "-":U )
      459           .
      460       end.
      461       end procedure.
      462       procedure menu-doc-set-options-string :
      463       define input parameter p-tmp-list-id            as integer          no-undo.
      464       define input parameter p-options-string         as character        no-undo.
      465           define buffer buf_tmp#list      for tmp#list.
      466       do
      467       for buf_tmp#list
      468       on error undo, return error
      469       :
      470           find first buf_tmp#list
      471                where buf_tmp#list.id = p-tmp-list-id
      472           .
      473           assign
      474               buf_tmp#list.type-parts  = ( if buf_tmp#list.type-parts-enabled     = yes then substitute( "  &1", substring( p-options-string, 1, 1 ) ) else " ":U )
      475               buf_tmp#list.type-price  = ( if buf_tmp#list.type-price-enabled     = yes then substitute( "  &1", substring( p-options-string, 2, 1 ) ) else " ":U )
      476               buf_tmp#list.type-scale  = ( if buf_tmp#list.type-scale-enabled     = yes then substitute( "  &1", substring( p-options-string, 3, 1 ) ) else " ":U )
      477               buf_tmp#list.type-val    = ( if buf_tmp#list.type-val-enabled       = yes then substitute( "  &1", substring( p-options-string, 4, 1 ) ) else " ":U )
      478               buf_tmp#list.sort-name   = ( if buf_tmp#list.sort-name-enabled      = yes then substitute( "  &1", substring( p-options-string, 5, 1 ) ) else " ":U )
      479               buf_tmp#list.sort-gr     = ( if buf_tmp#list.sort-gr-enabled        = yes then substitute( "  &1", substring( p-options-string, 6, 1 ) ) else " ":U )
      480               buf_tmp#list.print-graft = ( if buf_tmp#list.print-graft-enabled    = yes then substitute( "  &1", substring( p-options-string, 7, 1 ) ) else " ":U )
      481               buf_tmp#list.no-vat      = ( if buf_tmp#list.no-vat-enabled         = yes then substitute( "  &1", substring( p-options-string, 8, 1 ) ) else " ":U )
      482           .
      483       end.
      484       end procedure.
      485       procedure menu-doc-create-options-enabled-string :
      486       define input parameter p-tmp-list-id                as integer          no-undo.
      487       define output parameter p-options-enabled-string    as character        no-undo.
      488           define buffer buf_tmp#list      for tmp#list.
      489       do
      490       for buf_tmp#list
      491       on error undo, return error
      492       :
      493           find first buf_tmp#list
      494                where buf_tmp#list.id = p-tmp-list-id
      495           .
      496           assign
      497               p-options-enabled-string =  ( if buf_tmp#list.type-parts-enabled  = yes then "+":U else "-":U )
      498                                         + ( if buf_tmp#list.type-price-enabled  = yes then "+":U else "-":U )
      499                                         + ( if buf_tmp#list.type-scale-enabled  = yes then "+":U else "-":U )
      500                                         + ( if buf_tmp#list.type-val-enabled    = yes then "+":U else "-":U )
      501                                         + ( if buf_tmp#list.sort-name-enabled   = yes then "+":U else "-":U )
      502                                         + ( if buf_tmp#list.sort-gr-enabled     = yes then "+":U else "-":U )
      503                                         + ( if buf_tmp#list.print-graft-enabled = yes then "+":U else "-":U )
      504                                         + ( if buf_tmp#list.no-vat-enabled      = yes then "+":U else "-":U )
      505           .
      506       end.
      507       end procedure.
      508       procedure menu-doc-extend-blank-name-for-IBS :
      509       define input parameter p-in-blank-name      as character        no-undo.
      510       define input parameter p-sys-key            as character        no-undo.
      511       define input parameter p-sys-key-black      as character        no-undo.
      512       define output parameter p-out-blank-name    as character        no-undo.
      513       do
      514       on error undo, return error
      515       :
      516           assign
      517               p-out-blank-name = p-in-blank-name
      518           .
      519           if p-sys-key <> "":U
      520           then do:
      521               assign
      522                   p-out-blank-name = substring( p-in-blank-name + " '" + p-sys-key + "'" , 1, 120 )
      523               .
      524           end.
      525           if p-sys-key-black <> ""
      526           then do:
      527               assign
      528                   p-out-blank-name = substring( p-in-blank-name + " no-'" + p-sys-key-black + "'", 1, 120 )
      529               .
      530           end.
      531       end.
      532       end procedure.
      533   procedure proc-alt-shift-f2:
      534     if not ibs.th.gbl.gbl-var:rcode
      535   then
      536     run gbl\inidebug.p .
      537   end.
      538   procedure proc-alt-shift-f3:
      539     run gbl/prvssinf.p
      540       ( input this-procedure
      541       ) .
      542   end.
      543   define variable v-inform-launched as logical no-undo initial false .
      544   procedure proc-alt-shift-f4:
      545     define variable v-action as character no-undo .
      546     if v-inform-launched = false then do:
      547       assign
      548         v-inform-launched = true
      549       .
      550       run gbl/d-inform.w
      551         (  input self
      552         ,  input this-procedure
      553         , output v-action
      554         ) no-error .
      555       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      556       assign
      557         v-inform-launched = false
      558       .
      559     end.
      560   end.
      561   procedure proc-alt-f1:
      562     run gbl/corrhelp.p
      563       (input this-procedure
      564       ) .
      565   end .
      566   on alt-shift-f2 anywhere do:
      567     run proc-alt-shift-f2.
      568   end.
      569   on alt-shift-f3 anywhere do:
      570     run proc-alt-shift-f3 in this-procedure .
      571   end.
      572   on alt-shift-f4 anywhere do:
      573     run proc-alt-shift-f4 in this-procedure.
      574   end.
      575   on alt-f1 anywhere do:
      576     run proc-alt-f1 in this-procedure .
      577   end.
      578   DEFINE BUTTON b-cancel AUTO-END-KEY
      579        LABEL "&Отмена"
      580        SIZE 10 BY 1
      581        BGCOLOR 8 .
      582   DEFINE BUTTON b-exit AUTO-GO
      583        LABEL "В&вод"
      584        SIZE 10 BY 1
      585        BGCOLOR 8 .
      586   DEFINE BUTTON b-help
      587        LABEL "Помо&щь"
      588        SIZE 10 BY 1
      589        BGCOLOR 8 .
      590   DEFINE VARIABLE ed-form-name AS CHARACTER
      591        VIEW-AS EDITOR NO-BOX
      592        SIZE 43 BY 2.75
      593        FGCOLOR 4  NO-UNDO.
      594   DEFINE VARIABLE tg-print-graft AS LOGICAL INITIAL no
      595        LABEL "Сортировка по артикулу"
      596        VIEW-AS TOGGLE-BOX
      597        SIZE 41 BY .83 NO-UNDO.
      598   DEFINE VARIABLE tg-sort-gr AS LOGICAL INITIAL no
      599        LABEL "Сортировка по группе"
      600        VIEW-AS TOGGLE-BOX
      601        SIZE 41 BY .83 NO-UNDO.
      602   DEFINE VARIABLE tg-sort-name AS LOGICAL INITIAL no
      603        LABEL "Сортировка по имени"
      604        VIEW-AS TOGGLE-BOX
      605        SIZE 41 BY .83 NO-UNDO.
      606   DEFINE VARIABLE tg-type-price AS LOGICAL INITIAL no
      607        LABEL "Печать в ценах документа"
      608        VIEW-AS TOGGLE-BOX
      609        SIZE 41 BY .83 NO-UNDO.
      610   DEFINE VARIABLE tg-type-scale AS LOGICAL INITIAL no
      611        LABEL "Печать по шкалам"
      612        VIEW-AS TOGGLE-BOX
      613        SIZE 41 BY .83 NO-UNDO.
      614   DEFINE VARIABLE tg-type-val AS LOGICAL INITIAL no
      615        LABEL "Печать в рублях"
      616        VIEW-AS TOGGLE-BOX
      617        SIZE 41 BY .83 NO-UNDO.
      618   DEFINE FRAME Dialog-Frame
      619        b-exit AT ROW 1 COL 1
      620        b-help AT ROW 1 COL 24.5
      621        b-cancel AT ROW 1 COL 34.5
      622        ed-form-name AT ROW 2.25 COL 1.5 NO-LABEL
      623        tg-type-price AT ROW 5.75 COL 3
      624        tg-type-scale AT ROW 6.75 COL 3
      625        tg-type-val AT ROW 7.75 COL 3
      626        tg-sort-name AT ROW 8.75 COL 3
      627        tg-sort-gr AT ROW 9.75 COL 3
      628        tg-print-graft AT ROW 10.75 COL 3
      629        SPACE(0.87) SKIP(0.70)
      630       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      631            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      632            TITLE "Параметры печати формы"
      633            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      634   ASSIGN
      635          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      636          FRAME Dialog-Frame:HIDDEN           = TRUE.
      637   ASSIGN
      638          ed-form-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      639   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      640   DO:
      641     APPLY "END-ERROR":U TO SELF.
      642   END.
      643   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      644   DO:
      645       assign
      646           tg-type-price
      647           tg-type-scale
      648           tg-type-val
      649           tg-sort-name
      650           tg-sort-gr
      651           tg-print-graft
      652       .
      653       assign
      654           p-parameters-string-new =   ( if tg-type-price    = yes then "+":U else "-":U )
      655                                     + ( if tg-type-scale    = yes then "+":U else "-":U )
      656                                     + ( if tg-type-val      = yes then "+":U else "-":U )
      657                                     + ( if tg-sort-name     = yes then "+":U else "-":U )
      658                                     + ( if tg-sort-gr       = yes then "+":U else "-":U )
      659                                     + ( if tg-print-graft   = yes then "+":U else "-":U )
      660       .
      661   END.
      662   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      663   OR HELP OF FRAME Dialog-Frame
      664   DO:
      665   END.
      666   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   on F2 of frame Dialog-Frame anywhere do:
      668     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
      669     return no-apply.
      670   end.
      671   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      672   on F1 of frame Dialog-Frame anywhere do:
      673     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame Dialog-Frame. END.
      674     return no-apply.
      675   end.
      676   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      677   on help of frame Dialog-Frame
      678   do:
      679     run gbl/app_help.p
      680       (input this-procedure :file-name
      681       ,input ''
      682       ,input ?
      683       ) no-error.
      684     if error-status :error then do:
      685       message
      686         "Ошибка при вызове помощи"
      687         error-status :get-message(1)
      688         view-as alert-box .
      689     end.
      690   end.
      691   run minbtn-set in this-procedure .
      692   on choose of b-help in frame Dialog-Frame
      693   do:
      694     apply "help":u to frame Dialog-Frame .
      695   end.
      696   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      697   procedure minbtn-set :
      698       do
      699           on error undo, return error return-value
      700           :
      701           define variable ii              as integer       no-undo .
      702           define variable fh              as widget-handle no-undo .
      703           define variable hh              as widget-handle no-undo .
      704           define variable v-h             as handle        extent 4 no-undo .
      705           define variable v-name-button   as character     no-undo .
      706           define variable v-help-old-x    as decimal       no-undo .
      707           define variable v-help-old-y    as decimal       no-undo .
      708           define variable v-help-old-size as decimal       no-undo .
      709           define variable v-frame-width   as decimal       no-undo .
      710           define variable jj              as integer       no-undo .
      711           do
      712               on error undo, return error
      713               :
      714               assign
      715                   v-frame-width = frame Dialog-Frame:width - 0.3
      716                   fh            = frame Dialog-Frame:first-child
      717                   hh            = fh:first-child
      718                   ii            = 1
      719                   .
      720               do while valid-handle(hh):
      721                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      722                   do:
      723                       case lc(hh:name) :
      724                           when "b-help" then
      725                               do:
      726                                   hh:load-image-up("cmp/b-help.bmp":u) .
      727                                   hh:load-image-down("cmp/b-help.bmp":u) .
      728                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      729                                   hh:TOOLTIP = "Помощь" .
      730                                   v-help-old-x = hh:column .
      731                                   v-help-old-y = hh:row    .
      732                                   v-help-old-size = hh:width .
      733                                   hh:width-chars = 2.5 .
      734                               end.
      735                           when "b-print" then
      736                               do:
      737                                   hh:load-image("cmp/b-print.bmp":u) .
      738                                   hh:TOOLTIP = "Печать" .
      739                                   v-h[ii] = hh:handle .
      740                                   ii = ii + 1 .
      741                                   hh:width-chars = 3 .
      742                               end.
      743                           when "b-history" or
      744                           when "b-hist" then
      745                               do:
      746                                   hh:load-image("cmp/b-hist.bmp":u) .
      747                                   hh:TOOLTIP = "История" .
      748                                   v-h[ii] = hh:handle .
      749                                   ii = ii + 1 .
      750                                   hh:width-chars = 3 .
      751                               end.
      752                           when "b-sch" then
      753                               do:
      754                                   hh:load-image("cmp/b-sch.bmp":u) .
      755                                   hh:TOOLTIP = "Установка Фильтра" .
      756                                   v-h[ii] = hh:handle .
      757                                   ii = ii + 1 .
      758                                   hh:width-chars = 3 .
      759                               end.
      760                           when "b-hist-user" then
      761                               do:
      762                                   hh:load-image("cmp/b-hist.bmp":u) .
      763                                   hh:TOOLTIP = "История пользователя" .
      764                                   ii = ii + 1 .
      765                               end.
      766                       end case.
      767                   end.
      768                   hh = hh:next-sibling.
      769               end.
      770               b-help:column = v-frame-width - b-help:width-chars.
      771               jj = 0.
      772               repeat ii = 4 to 1 by -1 :
      773                   if valid-handle (v-h[ii] ) then
      774                   do:
      775                       jj  = jj + 1 .
      776                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      777                       v-h[ii]:row    = v-help-old-y .
      778                   end.
      779               end.
      780           end.
      781       end.
      782   end procedure.
      783   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      784   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      785   MAIN-BLOCK:
      786   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      787      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      788      run init-fields in this-procedure .
      789     RUN enable_UI.
      790     run disable-fields in this-procedure .
      791     WAIT-FOR GO OF FRAME Dialog-Frame.
      792   END.
      793   RUN disable_UI.
      794   PROCEDURE disable-fields :
      795   do
      796   with frame Dialog-Frame
      797   on error undo, return error
      798   :
      799       if substring( p-parameters-enabled-string, 1, 1 ) <> "+":U
      800       then do:
      801           disable
      802               tg-type-price
      803           .
      804       end.
      805       if substring( p-parameters-enabled-string, 2, 1 ) <> "+":U
      806       then do:
      807           disable
      808               tg-type-scale
      809           .
      810       end.
      811       if substring( p-parameters-enabled-string, 3, 1 ) <> "+":U
      812       then do:
      813           disable
      814               tg-type-val
      815           .
      816       end.
      817       if substring( p-parameters-enabled-string, 4, 1 ) <> "+":U
      818       then do:
      819           disable
      820               tg-sort-name
      821           .
      822       end.
      823       if substring( p-parameters-enabled-string, 5, 1 ) <> "+":U
      824       then do:
      825           disable
      826               tg-sort-gr
      827           .
      828       end.
      829       if substring( p-parameters-enabled-string, 6, 1 ) <> "+":U
      830       then do:
      831           disable
      832               tg-print-graft
      833           .
      834       end.
      835   end.
      836   END PROCEDURE.
      837   PROCEDURE disable_UI :
      838     HIDE FRAME Dialog-Frame.
      839   END PROCEDURE.
      840   PROCEDURE enable_UI :
      841     DISPLAY ed-form-name tg-type-price tg-type-scale tg-type-val tg-sort-name
      842             tg-sort-gr tg-print-graft
      843         WITH FRAME Dialog-Frame.
      844     ENABLE b-exit b-help b-cancel ed-form-name tg-type-price tg-type-scale
      845            tg-type-val tg-sort-name tg-sort-gr tg-print-graft
      846         WITH FRAME Dialog-Frame.
      847     VIEW FRAME Dialog-Frame.
      848   END PROCEDURE.
      849   PROCEDURE init-fields :
      850       define variable v-void-logical      as logical      no-undo.
      851   do
      852   with frame Dialog-Frame
      853   on error undo, return error
      854   :
      855       assign
      856           ed-form-name :screen-value = p-form-name
      857       .
      858       run menu-doc-set-visible-options in this-procedure (
      859             input p-parameters-string-old
      860           , output tg-type-price
      861           , output tg-type-scale
      862           , output tg-type-val
      863           , output tg-sort-name
      864           , output tg-sort-gr
      865           , output tg-print-graft
      866           , output v-void-logical
      867       ).
      868       assign
      869           p-parameters-string-new = p-parameters-string-old
      870       .
      871   end.
      872   END PROCEDURE.
