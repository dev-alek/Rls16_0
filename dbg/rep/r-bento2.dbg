     1361         FOR EACH buf_inkas NO-LOCK WHERE
     1362                 buf_inkas.obj-type = obj-list.obj-type AND
     1363                 buf_inkas.obj-code = obj-list.obj-code AND
     1364                 buf_inkas.status_ = 'факт':U AND
     1365                 buf_inkas.doc-date >= X-date-start AND
