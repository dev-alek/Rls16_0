     1374   PROCEDURE no-benq-i-office.
     1375   DEFINE OUTPUT PARAMETER found as logical init no.
     1376   define buffer buf_sale-doc for ub.sale-doc.
     1377   CASE X-Radio-Task > 1:
     1378     WHEN YES then do:
     1379       FOR EACH obj-list WHERE
     1380               obj-list.obj-type = 'маг':U NO-LOCK :
     1381         FOR EACH buf_sale-doc NO-LOCK WHERE
     1382                  buf_Sale-doc.obj-type = obj-list.obj-type
     1383              AND buf_sale-doc.obj-code = obj-list.obj-code
     1384              AND buf_sale-doc.status_ = 'факт':U
     1385              AND buf_sale-doc.chr-office = 'у':U
     1386              AND (
     1387                 buf_sale-doc.shift-date >= X-date-start
     1388                 AND
     1389                 buf_sale-doc.shift-date <= X-date-end):
     1390           IF X-Radio-Task = 3 AND
     1391           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1392             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1393           IF X-Radio-Task = 4 AND
     1394           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1395           found = yes.
     1396           return.
     1397         END.
     1398       END.
     1399     END.
     1400     WHEN NO THEN DO:
     1401       FOR EACH obj-list WHERE
     1402               obj-list.obj-type = 'маг':U NO-LOCK :
     1403         FOR EACH buf_sale-doc NO-LOCK WHERE
     1404                 buf_sale-doc.obj-type = obj-list.obj-type
     1405            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1406            AND  buf_sale-doc.status_ = 'факт':U
     1407            AND  buf_sale-doc.chr-office = 'у':U
     1408            AND  buf_sale-doc.doc-date >= X-date-start
     1409            AND  buf_sale-doc.doc-date <= X-date-end :
     1410           found = yes.
     1411           return.
     1412         END.
     1413       END.
     1414     END.
     1415   END CASE.
     1416   END PROCEDURE.
