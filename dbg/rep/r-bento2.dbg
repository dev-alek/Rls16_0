     1506   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   procedure cur-time :
     1508      define output parameter p-today as date      no-undo .
     1509      define output parameter p-time  as integer   no-undo .
     1510     do
     1511     on error undo, return error
     1512     :
     1513       define variable v-date1 as date      no-undo .
     1514       define variable v-date2 as date      no-undo .
     1515       define variable v-time  as integer   no-undo .
     1516       assign
     1517         v-date1 = today
     1518         v-time  = time
     1519         v-date2 = today
     1520       .
     1521       if v-date1 <> v-date2
     1522       then do:
     1523         assign
     1524           v-date1 = today
     1525           v-time  = v-time
     1526         .
     1527       end.
     1528       assign
     1529         p-today = v-date1
     1530         p-time  = v-time
     1531       .
     1532     end.
     1533   end.
     1534   function cur-time-date returns character
     1535   :
     1536     return string(today, '99/99/9999':U) .
     1537   end.
     1538   function cur-time-mjd returns decimal
     1539   :
     1540     define variable v-date as date      no-undo .
     1541     define variable v-time as integer   no-undo .
     1542     run cur-time in this-procedure
     1543       (output v-date
     1544       ,output v-time
     1545       ) .
     1546     return integer(v-date) - 2400002 + (v-time / 86400) .
     1547   end.
     1548   function cur-time-get-ending-index returns integer
     1549   (input p-number as integer
     1550   )
     1551   :
     1552     if p-number < 0
     1553     or p-number = ?
     1554     then do:
     1555       return 1 .
     1556     end.
     1557     define variable v-rest as integer   no-undo .
     1558     assign
     1559       p-number = p-number modulo 100
     1560     .
     1561     if p-number < 20
     1562     then do:
     1563       assign
     1564         v-rest = p-number
     1565       .
     1566     end.
     1567     else do:
     1568       assign
     1569         v-rest = p-number modulo 10
     1570       .
     1571     end.
     1572     case v-rest :
     1573       when 1
     1574       then do:
     1575         return 2 .
     1576       end.
     1577       when 2 or
     1578       when 3 or
     1579       when 4
     1580       then do:
     1581         return 3 .
     1582       end.
     1583       otherwise do:
     1584         return 1 .
     1585       end.
     1586     end case .
     1587   end.
     1588   procedure cur-time-mjd-to-date :
     1589      define input  parameter i-mjd-diff as decimal no-undo.
     1590      define output parameter o-Date     as date    no-undo.
     1591      define output parameter o-Time     as integer no-undo.
     1592      define variable v-day-number as integer   no-undo .
     1593      if    i-mjd-diff < 0
     1594         or i-mjd-diff = ?
     1595      then do:
     1596         return "?" .
     1597      end.
     1598      assign
     1599         v-day-number = truncate(i-mjd-diff,0).
     1600         o-Date = date(v-day-number + 2400002).
     1601         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1602     .
     1603   end.
     1604   function cur-time-mjd-to-string returns character
     1605   (input p-mjd-diff as decimal
     1606   )
     1607   :
     1608     define variable v-day-number as integer   no-undo .
     1609     define variable v-seconds    as integer   no-undo .
     1610     define variable v-hour       as integer   no-undo .
     1611     define variable v-min        as integer   no-undo .
     1612     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1613     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1614     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1615     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1616     if p-mjd-diff < 0
     1617     or p-mjd-diff = ?
     1618     then do:
     1619       return "?" .
     1620     end.
     1621     assign
     1622       v-day-number = integer(truncate(p-mjd-diff,0))
     1623       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1624     .
     1625     if v-seconds > 86400
     1626     then do:
     1627       assign
     1628         v-seconds = 86400 - 1
     1629       .
     1630     end.
     1631     if v-seconds < 0
     1632     then do:
     1633       assign
     1634         v-seconds = 0
     1635       .
     1636     end.
     1637     assign
     1638       v-hour = truncate(v-seconds / 3600, 0)
     1639     .
     1640     assign
     1641       v-seconds = v-seconds modulo 3600
     1642     .
     1643     assign
     1644       v-min = truncate(v-seconds / 60, 0)
     1645     .
     1646     assign
     1647       v-seconds = v-seconds modulo 60
     1648     .
     1649     return
     1650         (if v-day-number <> 0
     1651           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1652           else ""
     1653         )
     1654       + (if v-day-number <> 0 or v-hour <> 0
     1655           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1656           else ""
     1657         )
     1658       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1659           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1660           else ""
     1661         )
     1662       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1663       .
     1664   end.
     1665   function cur-time-string returns character
     1666   :
     1667     define variable v-date as date      no-undo .
     1668     define variable v-time as integer   no-undo .
     1669     run cur-time in this-procedure
     1670       (output v-date
     1671       ,output v-time
     1672       ) .
     1673     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1674   end.
     1675   function cur-time-string-sec returns character
     1676   :
     1677     define variable v-date as date      no-undo .
     1678     define variable v-time as integer   no-undo .
     1679     run cur-time in this-procedure
     1680       (output v-date
     1681       ,output v-time
     1682       ) .
     1683     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1684   end.
     1685   function cur-time-custom  returns character
     1686   (input p-prefix as character
     1687   ,input p-date-format as character
     1688   ,input p-delimiter as character
     1689   ,input p-time-format as character
     1690   ,input p-suffix as character
     1691   )
     1692   :
     1693     define variable v-date as date      no-undo .
     1694     define variable v-time as integer   no-undo .
     1695     run cur-time in this-procedure
     1696       (output v-date
     1697       ,output v-time
     1698       ) .
     1699     return
     1700       p-prefix
     1701       + string(v-date, p-date-format)
     1702       + p-delimiter
     1703       + string(v-time, p-time-format)
     1704       + p-suffix
     1705       .
     1706   end.
     1707   function cur-time-print  returns character
     1708   :
     1709     define variable v-date as date      no-undo .
     1710     define variable v-time as integer   no-undo .
     1711     run cur-time in this-procedure
     1712       (output v-date
     1713       ,output v-time
     1714       ) .
     1715     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1716   end.
     1717   function cur-time-datetime returns datetime
     1718   :
     1719     define variable v-char as character no-undo .
     1720     define variable v-datetime as datetime no-undo .
     1721     v-char = cur-time-string().
     1722     v-datetime = datetime(v-char).
     1723     return  v-datetime.
     1724   end.
     1725   function cur-time-string-msec returns character
     1726   :
     1727     define variable v-date as datetime  no-undo .
     1728     v-date = now.
     1729     return string(v-date) .
     1730   end.
     1731   function fnc-convert-dot-to-colon returns character
     1732       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1733   function fnc-convert-dot-to-colon returns character
     1734   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1735       define variable result as character no-undo.
     1736       define variable v-str-result as character no-undo.
     1737       if p-data = ? then p-data = 0 .
     1738       p-data = round(p-data, p-num).
     1739       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1740       return v-str-result.
     1741   END FUNCTION.
     1742   function putRowAmount1 returns character private
     1743   (input p-curr-name as character
     1744   ,input p-total1    as decimal
     1745   ) :
     1746   define variable v-row-amount as character no-undo .
     1747   define variable v-curr-name  as character no-undo .
     1748     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1749     v-row-amount = substitute (
     1750         '<td>&1</td><td num="0.00" val="&2">&2</td><td><br /></td><td><br /></td>'
     1751         , v-curr-name
     1752         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1753     ) .
     1754     return v-row-amount .
     1755   end function .
     1756   function putRowAmount returns character private
     1757   (input p-curr-name as character
     1758   ,input p-total1    as decimal
     1759   ,input p-total2    as decimal
     1760   ,input p-total3    as decimal
     1761   ) :
     1762   define variable v-row-amount as character no-undo .
     1763   define variable v-curr-name  as character no-undo .
     1764     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1765     v-row-amount = substitute (
     1766         '<td>&1</td><td num="0.00" val="&2">&2</td><td num="0.00" val="&3">&3</td><td num="0.00" val="&4">&4</td>'
     1767         , v-curr-name
     1768         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1769         , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1770         , fnc-convert-dot-to-colon(p-total3, "->>>>>>>>>>>9.99", 2)
     1771     ) .
     1772     return v-row-amount .
     1773   end function .
     1774   procedure CreateBenefits2 private :
     1775   define input parameter p-obj-type  as character no-undo .
     1776   define input parameter p-obj-code  as integer no-undo .
     1777   define input parameter p-pay-code  as integer no-undo .
     1778   define input parameter p-curr-code as integer no-undo .
     1779   define input parameter p-pay-desk  as integer no-undo .
     1780   define input parameter p-sum       as decimal no-undo .
     1781   define input parameter p-base      as decimal no-undo .
     1782   define input parameter p-rubl      as decimal no-undo .
     1783   define buffer buf_benefits for benefits .
     1784   define buffer buf_cash-pay for ub.cash-pay .
     1785   define buffer buf_currency for ub.currency .
     1786     find first buf_benefits
     1787          where buf_benefits.obj-type  = p-obj-type
     1788            and buf_benefits.obj-code  = p-obj-code
     1789            and buf_benefits.pay-code  = p-pay-code
     1790            and buf_benefits.curr-code = p-curr-code
     1791     and buf_benefits.pay-desk  = p-pay-desk no-error .
     1792     if not available buf_benefits then do:
     1793       FIND FIRST buf_cash-pay NO-LOCK
     1794            WHERE buf_cash-pay.cdpay-code = p-pay-code
     1795              AND buf_cash-pay.curr-code  = p-curr-code NO-ERROR.
     1796       FIND FIRST buf_currency NO-LOCK
     1797            WHERE buf_currency.curr-code = p-curr-code NO-ERROR.
     1798       create buf_benefits.
     1799       assign
     1800         buf_benefits.pay-desk  = p-pay-desk
     1801         buf_benefits.obj-type  = p-obj-type
     1802         buf_benefits.obj-code  = p-obj-code
     1803         buf_benefits.pay-code  = p-pay-code
     1804         buf_benefits.pay-name  = if available buf_cash-pay then buf_cash-pay.obj-name  else "Неопознанная оплата"
     1805         buf_benefits.curr-code = p-curr-code
     1806         buf_benefits.curr-name = if available buf_currency then buf_currency.curr-name else "Неопознанная валюта"
     1807         buf_benefits.tot-sum   = p-sum
     1808         buf_benefits.tot-base  = p-base
     1809         buf_benefits.tot-rubl  = p-rubl
     1810       .
     1811     end .
     1812     else assign
     1813       buf_benefits.tot-sum  = buf_benefits.tot-sum  + p-sum
     1814       buf_benefits.tot-base = buf_benefits.tot-base + p-base
     1815       buf_benefits.tot-rubl = buf_benefits.tot-rubl + p-rubl
     1816     .
     1817   end procedure .
     1818   empty temp-table benefits .
     1819   empty temp-table inkas-num .
     1820   empty temp-table day_sum .
     1821   empty temp-table all-days_sum .
     1822   empty temp-table ben-chk-count .
     1823   assign
     1824   date_string = cur-time-print()
     1825   .
     1826   assign
     1827   ChkAmount = 0
     1828   ObjAmount = 0
     1829   AllDay-BaseSum = 0
     1830   AllDay-RublSum = 0
     1831     acc-count-ln = 0
     1832     acc-count-step = 0
     1833   .
     1834   FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U NO-LOCK :
     1835     ACCUMULATE obj-list.obj-code ( COUNT ).
     1836     assign
     1837     acc-day-base = 0
     1838     acc-day-rubl = 0
     1839     acc-day-cnt = 0
     1840     acc-day-nf  = 0
     1841     .
     1842     CASE X-radio-Task > 1 :
     1843       WHEN YES THEN DO:
     1844         _chk-doc3:
     1845         FOR EACH chk-doc WHERE
     1846                   chk-doc.obj-type = obj-list.obj-type AND
     1847                 chk-doc.obj-code = obj-list.obj-code AND
     1848                 chk-doc.shift-date >= x-date-start AND
     1849                 chk-doc.shift-date <= x-date-end AND
     1850                 (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE) NO-LOCK
     1851         BREAK
     1852         by chk-doc.obj-type
     1853         by chk-doc.obj-code
     1854         by chk-doc.pay-desk :
     1855           IF FIRST-OF(chk-doc.pay-desk) then assign
     1856             acc-desk-rubl = 0
     1857             acc-desk-base = 0
     1858             acc-desk-count = 0
     1859             acc-desk-count-nf = 0
     1860           .
     1861           v-skip-line =
     1862           (
     1863                X-Radio-task = 3 AND
     1864                ((chk-doc.shift-date = x-date-start AND chk-doc.shift-num < X-shift-start) OR
     1865                 (chk-doc.shift-date = x-date-end   AND chk-doc.shift-num > X-shift-end))
     1866           ) OR (
     1867                X-radio-task = 4 AND
     1868                chk-doc.shift-num <> X-Shift-Alone
     1869           ) .
     1870           if not v-skip-line then do :
     1871             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1872             found = false .
     1873             if v-is-sub-count then do :
     1874               for EACH chk-pay NO-LOCK
     1875                  WHERE chk-pay.doc-code = chk-doc.doc-code :
     1876                 if chk-pay.tot-sum <> 0 then do :
     1877                   found = true .
     1878                   leave .
     1879                 end .
     1880               END .
     1881             end .
     1882             else do :
     1883               for EACH chk-pay NO-LOCK
     1884                  WHERE chk-pay.doc-code = chk-doc.doc-code
     1885               BREAK
     1886               BY chk-pay.pay-code
     1887               BY chk-pay.curr-code:
     1888                 if chk-pay.tot-sum <> 0 then do :
     1889                   found = true .
     1890   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1891           acc-count-ln = acc-count-ln + 1.
     1892   if acc-count-ln > acc-count-step then do:
     1893     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1894                                     ", обработано строк чеков : " +
     1895                                     string( ACC-count-ln) ) .
     1896     acc-count-step = acc-count-ln + 96 .
     1897   end.
     1898           if FIRST-of( chk-pay.curr-code ) then assign
     1899             acc-curr-sum  = 0
     1900             acc-curr-base = 0
     1901             acc-curr-rubl = 0
     1902           .
     1903         assign
     1904             acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     1905             acc-curr-base = acc-curr-base + chk-pay.tot-base
     1906             acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     1907             acc-desk-base = acc-desk-base + chk-pay.tot-base
     1908             acc-desk-rubl = acc-desk-rubl + chk-pay.tot-rubl
     1909         .
     1910   if last-of( chk-pay.curr-code ) then do:
     1911     run CreateBenefits2 in this-procedure
     1912     ( obj-list.obj-type
     1913     , obj-list.obj-code
     1914     , chk-pay.pay-code
     1915     , chk-pay.curr-code
     1916     , chk-doc.pay-desk
     1917     , acc-curr-sum
     1918     , acc-curr-base
     1919     , acc-curr-rubl
     1920     ) .
     1921     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     1922                                            and ben-chk-count.obj-type  = obj-list.obj-type
     1923                                            and ben-chk-count.obj-code  = obj-list.obj-code
     1924                                            and ben-chk-count.pay-desk  = chk-doc.pay-desk
     1925                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     1926                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     1927       create ben-chk-count.
     1928       assign
     1929         ben-chk-count.doc-code  = chk-pay.doc-code
     1930         ben-chk-count.obj-type  = obj-list.obj-type
     1931         ben-chk-count.obj-code  = obj-list.obj-code
     1932         ben-chk-count.pay-desk  = chk-doc.pay-desk
     1933         ben-chk-count.pay-code  = chk-pay.pay-code
     1934         ben-chk-count.curr-code = chk-pay.curr-code
     1935       .
     1936     end.
     1937   end.
     1938                 end .
     1939               END .
     1940             end .
     1941             if found then assign
     1942               acc-desk-count    = acc-desk-count    + 1
     1943               acc-desk-count-nf = acc-desk-count-nf + 1 when (v-is-sub-count)
     1944             .
     1945           end .
     1946           if last-of( chk-doc.pay-desk ) then do:
     1947             create day_sum.
     1948             assign
     1949               day_sum.obj-type = obj-list.obj-type
     1950               day_sum.obj-code = obj-list.obj-code
     1951               day_sum.pay-desk = chk-doc.pay-desk
     1952               day_sum.tot-rubl = acc-desk-rubl
     1953               day_sum.tot-base = acc-desk-base
     1954               day_sum.chk-cnt-all =  acc-desk-count
     1955               day_sum.chk-cnt-nf  =  acc-desk-count-nf
     1956             .
     1957             assign
     1958               acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     1959               acc-day-base = acc-day-base + day_sum.tot-base
     1960               acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     1961               acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     1962             .
     1963           end.
     1964         END.
     1965       END.
     1966       WHEN NO THEN DO:
     1967         _chk-doc4:
     1968         FOR EACH chk-doc WHERE
     1969                     chk-doc.obj-type = obj-list.obj-type AND
     1970                   chk-doc.obj-code = obj-list.obj-code AND
     1971                   chk-doc.chk-date >= x-date-start AND
     1972                   chk-doc.chk-date <= x-date-end AND
     1973                   (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE) NO-LOCK
     1974           BREAK
     1975           by chk-doc.obj-type
     1976           by chk-doc.obj-code
     1977           by chk-doc.pay-desk :
     1978           IF FIRST-OF(chk-doc.pay-desk) then assign
     1979             acc-desk-rubl = 0
     1980             acc-desk-base = 0
     1981             acc-desk-count = 0
     1982             acc-desk-count-nf = 0
     1983           .
     1984           v-skip-line = false .
     1985           if not v-skip-line then do :
     1986             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1987             found = false .
     1988             if v-is-sub-count then do :
     1989               for EACH chk-pay NO-LOCK
     1990                  WHERE chk-pay.doc-code = chk-doc.doc-code :
     1991                 if chk-pay.tot-sum <> 0 then do :
     1992                   found = true .
     1993                   leave .
     1994                 end .
     1995               END .
     1996             end .
     1997             else do :
     1998               for EACH chk-pay NO-LOCK
     1999                  WHERE chk-pay.doc-code = chk-doc.doc-code
     2000               BREAK
     2001               BY chk-pay.pay-code
     2002               BY chk-pay.curr-code:
     2003                 if chk-pay.tot-sum <> 0 then do :
     2004                   found = true .
     2005   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2006           acc-count-ln = acc-count-ln + 1.
     2007   if acc-count-ln > acc-count-step then do:
     2008     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     2009                                     ", обработано строк чеков : " +
     2010                                     string( ACC-count-ln) ) .
     2011     acc-count-step = acc-count-ln + 96 .
     2012   end.
     2013           if FIRST-of( chk-pay.curr-code ) then assign
     2014             acc-curr-sum  = 0
     2015             acc-curr-base = 0
     2016             acc-curr-rubl = 0
     2017           .
     2018         assign
     2019             acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     2020             acc-curr-base = acc-curr-base + chk-pay.tot-base
     2021             acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     2022             acc-desk-base = acc-desk-base + chk-pay.tot-base
     2023             acc-desk-rubl = acc-desk-rubl + chk-pay.tot-rubl
     2024         .
     2025   if last-of( chk-pay.curr-code ) then do:
     2026     run CreateBenefits2 in this-procedure
     2027     ( obj-list.obj-type
     2028     , obj-list.obj-code
     2029     , chk-pay.pay-code
     2030     , chk-pay.curr-code
     2031     , chk-doc.pay-desk
     2032     , acc-curr-sum
     2033     , acc-curr-base
     2034     , acc-curr-rubl
     2035     ) .
     2036     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     2037                                            and ben-chk-count.obj-type  = obj-list.obj-type
     2038                                            and ben-chk-count.obj-code  = obj-list.obj-code
     2039                                            and ben-chk-count.pay-desk  = chk-doc.pay-desk
     2040                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     2041                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     2042       create ben-chk-count.
     2043       assign
     2044         ben-chk-count.doc-code  = chk-pay.doc-code
     2045         ben-chk-count.obj-type  = obj-list.obj-type
     2046         ben-chk-count.obj-code  = obj-list.obj-code
     2047         ben-chk-count.pay-desk  = chk-doc.pay-desk
     2048         ben-chk-count.pay-code  = chk-pay.pay-code
     2049         ben-chk-count.curr-code = chk-pay.curr-code
     2050       .
     2051     end.
     2052   end.
     2053                 end .
     2054               END .
     2055             end .
     2056             if found then assign
     2057               acc-desk-count    = acc-desk-count    + 1
     2058               acc-desk-count-nf = acc-desk-count-nf + 1 when (v-is-sub-count)
     2059             .
     2060           end .
     2061           if last-of( chk-doc.pay-desk ) then do:
     2062             create day_sum.
     2063             assign
     2064               day_sum.obj-type = obj-list.obj-type
     2065               day_sum.obj-code = obj-list.obj-code
     2066               day_sum.pay-desk = chk-doc.pay-desk
     2067               day_sum.tot-rubl = acc-desk-rubl
     2068               day_sum.tot-base = acc-desk-base
     2069               day_sum.chk-cnt-all =  acc-desk-count
     2070               day_sum.chk-cnt-nf  =  acc-desk-count-nf
     2071             .
     2072             assign
     2073               acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     2074               acc-day-base = acc-day-base + day_sum.tot-base
     2075               acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     2076               acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     2077             .
     2078           end.
     2079         END.
     2080       END.
     2081     END CASE.
     2082     CREATE all-days_sum .
     2083     assign
     2084       all-days_sum.obj-type = obj-list.obj-type
     2085       all-days_sum.obj-code = obj-list.obj-code
     2086       all-days_sum.tot-base = acc-day-base
     2087       all-days_sum.tot-rubl = acc-day-rubl
     2088       all-days_sum.chk-cnt-all  = acc-day-cnt
     2089       all-days_sum.chk-cnt-nf   = acc-day-nf
     2090     .
     2091     assign
     2092       AllDay-BaseSum = AllDay-BaseSum + acc-day-base
     2093       AllDay-RublSum = AllDay-RublSum + acc-day-rubl
     2094       ObjAmount      = ObjAmount + 1
     2095       ChkAmount      = ChkAmount + (all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf)
     2096     .
     2097   END.
     2098   if not can-find (first benefits) then do:
     2099     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     2100     return.
     2101   end.
     2102   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2103   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2104     (output v-curr-r-b
     2105     )  .
     2106   if v-curr-r-b = 'base':U then do:
     2107   sale-price-type = base-type.
     2108   end.
     2109   else sale-price-type = "рублей".
     2110   for each benefits :
     2111     benefits.tot-r-b = if v-curr-r-b = 'base':U then benefits.tot-base else benefits.tot-rubl .
     2112   end .
     2113   for each day_sum :
     2114     day_sum.tot-r-b = if v-curr-r-b = 'base':U then day_sum.tot-base else day_sum.tot-rubl .
     2115   end .
     2116   for each all-days_sum :
     2117     all-days_sum.tot-r-b = if v-curr-r-b = 'rubl':U then all-days_sum.tot-rubl else all-days_sum.tot-base .
     2118   end .
     2119   run waitfram-hide in this-procedure .
     2120       run prn-lib-get-report-name  in this-procedure (
     2121                                                          input parParentProc
     2122                                                         ,output v-report-name
     2123                                                       ).
     2124     assign
     2125       v-file-name-rep-htm = v-report-name + ".html"
     2126       v-vsex-cas = IF cas-num = 0 then "ВСЕХ КАСС" ELSE ("КАССЫ " + string(cas-num))
     2127       v-avg-chk  = if ChkAmount > 0 then round(
     2128         (if v-curr-r-b = 'rubl':U then AllDay-RublSum else AllDay-BaseSum)  /  ChkAmount
     2129                                                , 2 ) else 0
     2130     .
     2131   do :
     2132     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     2133     put stream OutStr-html unformatted
     2134       "<!DOCTYPE HTML>" skip
     2135       '<html>' skip
     2136       '<head>' skip
     2137       '  <meta charset="utf-8">' skip
     2138       '  <style type="text/css">' skip
     2139       '      table ~{border-collapse: collapse~;~}' skip
     2140       '      tbody td, th ~{border: 1px solid black~; height: 14px~;}' skip
     2141       '      tbody td:nth-child(4), tbody td:nth-child(5), tbody td:nth-child(6) ~{text-align: right~; padding-right: 4px~;~}' skip
     2142       '      tfoot td ~{height: 14px~;}' skip
     2143       '      .sumtotal ~{text-align: right~; padding-right: 4px~;~}' skip
     2144       '  </style>' skip
     2145       '</head>' skip
     2146       '<body>' skip
     2147       '<TABLE name="1" fit_to_page="true" orientation="portrait">' skip
     2148       '<thead>' skip
     2149       '  <tr>' skip
     2150       '    <td style="width:  35px;"></td>' skip
     2151       '    <td style="width: 124px;"></td>' skip
     2152       '    <td style="width: 31px;"></td>' skip
     2153       '    <td style="width: 71px;"></td>' skip
     2154       '    <td style="width: 63px;"></td>' skip
     2155       '    <td style="width: 63px;"></td>' skip
     2156       '    <td style="width: 49px;"></td>' skip
     2157       '    <td style="width: 41px;"></td>' skip
     2158       '  </tr>' skip
     2159       '  <tr>' skip
     2160       '    <td colspan="8">' + date_string + '</td>' skip
     2161       '  </tr>' skip
     2162       '  <tr>' skip
     2163       '    <td colspan="8">ОТЧЕТ  О  ВЫРУЧКЕ ' + str1
     2164            + '<br />' + str4
     2165            + '<br />( сформирован по ВСЕМ ЧЕКАМ '
     2166            + (IF NotInc then v-vsex-cas + ", включая невошедшие в отчеты о продажах" else v-vsex-cas)
     2167            + ' )'
     2168            + '<br />'
     2169            + substitute("( всего чеков : &1, в среднем &2 &3 / чек )",  ChkAmount,  v-avg-chk,  sale-price-type  )
     2170            + '</td>' skip
     2171       '  </tr>' skip
     2172     .
     2173     put stream OutStr-html unformatted
     2174       '</thead>' skip
     2175       '<tbody>' skip
     2176       '  <tr>' skip
     2177       '    <th>Касса</th>' skip
     2178       '    <th>Вид оплаты</th>' skip
     2179       '    <th>Валюта продаж</th>' skip
     2180       '    <th>Сумма в валюте продаж</th>' skip
     2181       '    <th>Сумма в Б.Вал.</th>' skip
     2182       '    <th>Сумма в рублях</th>' skip
     2183       '    <th>~% от суммы</th>' skip
     2184       '    <th>Кол-во фиск. чеков</th>' skip
     2185       '  </tr>' skip
     2186     .
     2187   end .
     2188   FOR EACH obj-list WHERE
     2189             obj-list.obj-type = 'маг':U ,
     2190       EACH all-days_sum WHERE
     2191             all-days_sum.obj-type = obj-list.obj-type AND
     2192             all-days_sum.obj-code = obj-list.obj-code
     2193   BREAK
     2194   BY obj-list.obj-type
     2195   BY obj-list.obj-code :
     2196     ACCUMULATE
     2197     all-days_sum.tot-base ( TOTAL )
     2198     all-days_sum.tot-rubl ( TOTAL )
     2199     all-days_sum.tot-r-b ( TOTAL )
     2200     all-days_sum.chk-cnt-all ( TOTAL )
     2201     all-days_sum.chk-cnt-nf  ( TOTAL )
     2202     obj-list.obj-code ( COUNT ) .
     2203       if first-of( obj-list.obj-code ) then do:
     2204         FIND FIRST clients WHERE
     2205                      clients.obj-type = obj-list.obj-type  AND
     2206                      clients.obj-code = obj-list.obj-code  NO-LOCK no-error .
     2207         put stream OutStr-html unformatted
     2208             '  <tr><td colspan="8">'
     2209             if available clients then clients.obj-name else '<br />'
     2210             '</td></tr>'
     2211         .
     2212       end.
     2213     FOR EACH benefits WHERE
     2214                 benefits.obj-type = obj-list.obj-type AND
     2215                 benefits.obj-code = obj-list.obj-code
     2216     BREAK
     2217     BY benefits.obj-type
     2218     BY benefits.obj-code
     2219     BY benefits.pay-desk
     2220     BY benefits.pay-code
     2221     BY benefits.curr-code :
     2222       if first-of( benefits.pay-desk ) then do:
     2223           FIND FIRST day_sum WHERE
     2224                       day_sum.obj-type = obj-list.obj-type AND
     2225                       day_sum.obj-code = obj-list.obj-code AND
     2226                       day_sum.pay-desk = benefits.pay-desk NO-ERROR.
     2227           DatePrinted = FALSE .
     2228       end.
     2229       benefits.pcnt = round( benefits.tot-r-b / day_sum.tot-r-b * 100 , 2 ) .
     2230       if benefits.tot-base  <> 0
     2231       or (day_sum.chk-cnt-all > day_sum.chk-cnt-nf)
     2232       then do:
     2233         if DatePrinted then assign
     2234           v-td-date = '<br />'
     2235         .
     2236         else assign
     2237           v-td-date   = string(benefits.pay-desk)
     2238           DatePrinted = TRUE
     2239         .
     2240         open query qben-chk-count
     2241          preselect each ben-chk-count
     2242                   where ben-chk-count.obj-type  = obj-list.obj-type
     2243                     and ben-chk-count.obj-code  = obj-list.obj-code
     2244                     and ben-chk-count.pay-desk  = benefits.pay-desk
     2245                     and ben-chk-count.pay-code  = benefits.pay-code
     2246                     and ben-chk-count.curr-code = benefits.curr-code.
     2247         v-chk-count = query qben-chk-count:num-results .
     2248         close query qben-chk-count.
     2249         put stream OutStr-html unformatted
     2250           '  <tr>'
     2251           '<td>' + v-td-date + '</td>'
     2252           '<td>' + benefits.pay-name + '</td>'
     2253           putRowAmount (benefits.curr-name, benefits.tot-sum, benefits.tot-base, benefits.tot-rubl)
     2254           substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(benefits.pcnt,    "->>9.99",2)  )
     2255           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2256           '</tr>' skip
     2257         .
     2258       end.
     2259       if last-of( benefits.pay-desk ) then do:
     2260         if day_sum.chk-cnt-all > day_sum.chk-cnt-nf then do:
     2261           put stream OutStr-html unformatted
     2262             substitute(  '  <td colspan="3">средн.чек: &1</td>',
     2263               ROUND(day_sum.tot-base / (day_sum.chk-cnt-all - day_sum.chk-cnt-nf), 2)  )
     2264             substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(day_sum.tot-base,"->>>>>>>>>>>9.99",2)  )
     2265             '<td></td>'
     2266             substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(day_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2267             '<td>100.00%</td>'
     2268             substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  day_sum.chk-cnt-all - day_sum.chk-cnt-nf  )
     2269             '</tr>' skip
     2270           .
     2271         end.
     2272       end.
     2273       if last-of( benefits.obj-code ) then do:
     2274         put stream OutStr-html unformatted
     2275           '  <tr><td colspan="3">ИТОГО:</td>'
     2276           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-base,"->>>>>>>>>>>9.99",2)  )
     2277           '<td></td>'
     2278           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2279           '<td></td>'
     2280           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     2281           '</tr>' skip
     2282         .
     2283       end.
     2284     END.
     2285     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then do:
     2286       put stream OutStr-html unformatted
     2287         '  <tr><td colspan="3">ИТОГО по всем</td>'
     2288         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-base,"->>>>>>>>>>>9.99",2)  )
     2289         '<td></td>'
     2290         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2291         '<td></td>'
     2292         substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',
     2293           (ACCUM TOTAL all-days_sum.chk-cnt-all) - (ACCUM TOTAL all-days_sum.chk-cnt-nf)  )
     2294         '</tr>' skip
     2295       .
     2296     end.
     2297   END.
     2298   if  ObjAmount > 1  then do:
     2299     FOR EACH benefits
     2300     BREAK
     2301     BY benefits.pay-code :
     2302       ACCUMULATE
     2303       benefits.tot-base ( SUB-TOTAL BY benefits.pay-code )
     2304       benefits.tot-rubl ( SUB-TOTAL BY benefits.pay-code )
     2305       benefits.tot-r-b  ( SUB-TOTAL BY benefits.pay-code )
     2306       .
     2307       if last-of( benefits.pay-code ) AND
     2308           ( ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base ) <> 0 then do:
     2309         open query qben-chk-count
     2310          preselect each ben-chk-count
     2311                   where ben-chk-count.pay-code  = benefits.pay-code.
     2312         v-chk-count = query qben-chk-count:num-results .
     2313         close query qben-chk-count.
     2314         put stream OutStr-html unformatted
     2315           substitute(  '  <tr><td colspan="3">/итого по &1</td>',  benefits.pay-name  )
     2316           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base,"->>>>>>>>>>>9.99",2)  )
     2317           '<td></td>'
     2318           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2319           '<td></td>'
     2320           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2321           '</tr>' skip
     2322         .
     2323       end.
     2324     END.
     2325   end.
     2326   put stream OutStr-html unformatted
     2327     '</tbody>' skip
     2328     '<tfoot>' skip
     2329   .
     2330   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2331     put stream OutStr-html unformatted
     2332       '  <tr><td colspan="8"><br /></td></tr>' skip
     2333       '  <tr><td colspan="4">Директор _______________</td><td colspan="4">Старший продавец ______________</td></tr>' skip
     2334       '  <tr><td colspan="8"><br /></td></tr>' skip
     2335       '  <tr><td colspan="4">Бухгалтер ______________</td><td colspan="4">Кассир ________________________</td></tr>' skip
     2336     .
     2337   end.
     2338   put stream OutStr-html unformatted
     2339     '</tfoot>' skip
     2340     '</table>' skip
     2341     '</body>' skip
     2342     '</html>' skip
     2343   .
     2344   output stream OutStr-html close.
     2345   run prn-lib-reportviewer in this-procedure (
     2346       input this-procedure
     2347       ,input v-file-name-rep-htm
     2348       ,input ""
     2349       ) no-error.
     2350   if error-status:error then
     2351   do:
     2352       message return-value view-as alert-box.
     2353       return .
     2354   end.
