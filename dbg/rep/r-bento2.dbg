     1229   PROCEDURE no-benq.
     1230   DEFINE OUTPUT PARAMETER found as logical init no.
     1231   define buffer buf_chk-doc for ub.chk-doc.
     1232   FOR EACH obj-list WHERE
     1233           obj-list.obj-type = 'маг':U NO-LOCK :
     1234     CASE X-Radio-Task > 1 :
     1235       WHEN YES THEN DO:
     1236         FOR EACH buf_chk-doc NO-LOCK WHERE
     1237                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1238                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1239                 (
     1240                   buf_chk-doc.shift-date >= X-date-start AND
     1241                   buf_chk-doc.shift-date <= X-date-end)
     1242                   AND
     1243                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1244           IF X-Radio-Task = 3 AND
     1245           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1246             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1247           IF X-Radio-Task = 4 AND
     1248           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1249           found = yes.
     1250           return.
     1251         END.
     1252       END.
     1253       WHEN NO THEN DO:
     1254         FOR EACH buf_chk-doc NO-LOCK WHERE
     1255               buf_chk-doc.obj-type = obj-list.obj-type AND
     1256               buf_chk-doc.obj-code = obj-list.obj-code AND
     1257               buf_chk-doc.chk-date >= X-date-start AND
     1258               buf_chk-doc.chk-date <= X-date-end   AND
     1259               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1260           found = yes.
     1261           return.
     1262         END.
     1263        END.
     1264      END CASE.
     1265    END.
     1266   END PROCEDURE.
     1267   PROCEDURE no-benqi.
     1268   DEFINE OUTPUT PARAMETER found as logical init no.
     1269   define buffer buf_chk-doc for ub.chk-doc.
     1270   define buffer buf_inkas for ub.inkas.
     1271   FOR EACH obj-list WHERE
     1272         obj-list.obj-type = 'маг':U NO-LOCK :
     1273     CASE X-Radio-Task > 1 :
     1274       WHEN YES THEN DO:
     1275         FOR EACH buf_chk-doc No-LOCK WHERE
     1276                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1277                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1278                 (
     1279                   buf_chk-doc.shift-date >= X-date-start AND
     1280                   buf_chk-doc.shift-date <= X-date-end)
     1281                   AND
     1282                   buf_Chk-doc.out-code = ? AND
     1283                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1284           IF X-Radio-Task = 3 AND
     1285           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1286             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1287           IF X-Radio-Task = 4 AND
     1288           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1289           found = yes.
     1290           return.
     1291         END.
     1292         FOR EACH buf_inkas No-LOCK WHERE
     1293                   buf_inkas.obj-type = obj-list.obj-type AND
     1294                   buf_inkas.obj-code = obj-list.obj-code AND
     1295                   (
     1296                   buf_inkas.shift-date >= X-date-start AND
     1297                   buf_inkas.shift-date <= X-date-end):
     1298           if buf_inkas.status_ = 'факт':U
     1299           or buf_inkas.status_ = 'запрос':U then next.
     1300           IF X-Radio-Task = 3 AND
     1301           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1302             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1303           IF X-Radio-Task = 4 AND
     1304           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1305           found = yes.
     1306           return.
     1307         END.
     1308       END.
     1309       WHEN NO THEN DO:
     1310         FOR EACH buf_chk-doc NO-LOCK WHERE
     1311                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1312                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1313                 buf_chk-doc.chk-date >= X-date-start AND
     1314                 buf_chk-doc.chk-date <= X-date-end   AND
     1315                 buf_Chk-doc.out-code = ? AND
     1316                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1317           found = yes.
     1318           return.
     1319         END.
     1320         FOR EACH buf_inkas NO-LOCK WHERE
     1321                 buf_inkas.obj-type = obj-list.obj-type AND
     1322                 buf_inkas.obj-code = obj-list.obj-code AND
     1323                 buf_inkas.doc-date >= X-date-start AND
     1324                 buf_inkas.doc-date <= X-date-end :
     1325           if buf_inkas.status_ = 'факт':U
     1326           or buf_inkas.status_ = 'запрос':U then next.
     1327           found = yes.
     1328           return.
     1329         END.
     1330       END.
     1331     END CASE.
     1332   END.
     1333   END PROCEDURE.
     1334   PROCEDURE no-benq-i.
     1335   DEFINE OUTPUT PARAMETER found as logical init no.
     1336   define buffer buf_inkas for ub.inkas.
     1337   CASE X-Radio-Task > 1:
