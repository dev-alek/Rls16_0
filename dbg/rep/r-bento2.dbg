     1481   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1482   define variable acc-count-ln as integer no-undo .
     1483   define variable acc-count-step as integer no-undo .
     1484   define variable acc-day-base as decimal no-undo .
     1485   define variable acc-day-rubl as decimal no-undo .
     1486   define variable acc-day-cnt  as integer no-undo .
     1487   define variable acc-day-nf   as integer no-undo .
     1488   define variable acc-desk-rubl  as decimal no-undo .
     1489   define variable acc-desk-base  as decimal no-undo .
     1490   define variable acc-desk-count as integer no-undo .
     1491   define variable acc-desk-count-nf as integer no-undo .
