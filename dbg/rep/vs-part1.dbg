      853   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   procedure minbtn-set :
      855       do
      856           on error undo, return error return-value
      857           :
      858           define variable ii              as integer       no-undo .
      859           define variable fh              as widget-handle no-undo .
      860           define variable hh              as widget-handle no-undo .
      861           define variable v-h             as handle        extent 4 no-undo .
      862           define variable v-name-button   as character     no-undo .
      863           define variable v-help-old-x    as decimal       no-undo .
      864           define variable v-help-old-y    as decimal       no-undo .
      865           define variable v-help-old-size as decimal       no-undo .
      866           define variable v-frame-width   as decimal       no-undo .
      867           define variable jj              as integer       no-undo .
      868           do
      869               on error undo, return error
      870               :
      871               assign
      872                   v-frame-width = frame vs-parts:width - 0.3
      873                   fh            = frame vs-parts:first-child
      874                   hh            = fh:first-child
      875                   ii            = 1
      876                   .
      877               do while valid-handle(hh):
      878                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      879                   do:
      880                       case lc(hh:name) :
      881                           when "b-help" then
      882                               do:
      883                                   hh:load-image-up("cmp/b-help.bmp":u) .
      884                                   hh:load-image-down("cmp/b-help.bmp":u) .
      885                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      886                                   hh:TOOLTIP = "Помощь" .
      887                                   v-help-old-x = hh:column .
      888                                   v-help-old-y = hh:row    .
      889                                   v-help-old-size = hh:width .
      890                                   hh:width-chars = 2.5 .
      891                               end.
      892                           when "b-print" then
      893                               do:
      894                                   hh:load-image("cmp/b-print.bmp":u) .
      895                                   hh:TOOLTIP = "Печать" .
      896                                   v-h[ii] = hh:handle .
      897                                   ii = ii + 1 .
      898                                   hh:width-chars = 3 .
      899                               end.
      900                           when "b-history" or
      901                           when "b-hist" then
      902                               do:
      903                                   hh:load-image("cmp/b-hist.bmp":u) .
      904                                   hh:TOOLTIP = "История" .
      905                                   v-h[ii] = hh:handle .
      906                                   ii = ii + 1 .
      907                                   hh:width-chars = 3 .
      908                               end.
      909                           when "b-sch" then
      910                               do:
      911                                   hh:load-image("cmp/b-sch.bmp":u) .
      912                                   hh:TOOLTIP = "Установка Фильтра" .
      913                                   v-h[ii] = hh:handle .
      914                                   ii = ii + 1 .
      915                                   hh:width-chars = 3 .
      916                               end.
      917                           when "b-hist-user" then
      918                               do:
      919                                   hh:load-image("cmp/b-hist.bmp":u) .
      920                                   hh:TOOLTIP = "История пользователя" .
      921                                   ii = ii + 1 .
      922                               end.
      923                       end case.
      924                   end.
      925                   hh = hh:next-sibling.
      926               end.
      927               b-help:column = v-frame-width - b-help:width-chars.
      928               jj = 0.
      929               repeat ii = 4 to 1 by -1 :
      930                   if valid-handle (v-h[ii] ) then
      931                   do:
      932                       jj  = jj + 1 .
      933                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      934                       v-h[ii]:row    = v-help-old-y .
      935                   end.
      936               end.
      937           end.
      938       end.
      939   end procedure.
      940   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      941   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      942   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      943   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      944   define variable v-diasize-current-frame-width  as decimal   no-undo .
      945   define variable v-diasize-current-frame-height as decimal   no-undo .
      946   define variable v-diasize-change-size          as logical   no-undo .
      947   define variable v-diasize-resize-button        as handle    no-undo .
      948   define variable v-diasize-wndmax               as logical   no-undo .
      949   define variable v-diasize-wndstore             as logical   no-undo .
      950   define variable v-diasize-proc-name            as character no-undo .
      951   define variable v-diasize-browse-handle        as handle    no-undo .
      952   define variable v-diasize-browse-number        as integer   no-undo .
      953   define variable v-diasize-need-full-display    as logical   no-undo init false .
      954   define temp-table temp-diasize-handle no-undo
      955     field handle-value  as handle
      956     field save-position as decimal
      957     index xpk is primary unique handle-value
      958     .
      959   define temp-table temp-browse-handle no-undo
      960     field browse-type   as character
      961     field browse-number as integer
      962     field browse-handle as handle
      963     field original-size as decimal
      964     index xpk is primary unique browse-type browse-number
      965     index xie browse-type browse-handle
      966   .
      967   procedure diasize_change-height :
      968     define input  parameter p-change-value  as decimal   no-undo .
      969     define input  parameter p-move-resize   as logical   no-undo .
      970     define variable v-field-group-handle    as handle    no-undo .
      971     define variable v-object-handle         as handle    no-undo .
      972     define variable v-frame-height          as decimal   no-undo .
      973     define variable v-frame-virtual-height  as decimal   no-undo .
      974     define variable v-browse-height         as decimal   no-undo .
      975     define variable v-window-height         as decimal   no-undo .
      976     define variable v-window-virtual-height as decimal   no-undo .
      977     define variable v-change-sign           as integer   no-undo .
      978     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      979     define buffer buf_temp-browse-handle  for temp-browse-handle .
      980     if p-change-value > 0
      981     then do:
      982       if frame vs-parts :height + p-change-value
      983           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      984       then do:
      985         assign
      986           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      987                           - (frame vs-parts :height-chars)
      988         .
      989         if p-change-value <= 0
      990         then do:
      991           run diasize_position-resize-button in this-procedure .
      992           return .
      993         end.
      994       end.
      995     end.
      996     if p-change-value < 0
      997     then do:
      998       if frame vs-parts :height + p-change-value < v-diasize-orig-frame-height
      999       then do:
     1000         assign
     1001           p-change-value = v-diasize-orig-frame-height
     1002                          - (frame vs-parts :height-chars)
     1003         .
     1004         if p-change-value >= 0
     1005         then do:
     1006           run diasize_position-resize-button in this-procedure .
     1007           return .
     1008         end.
     1009       end.
     1010     end.
     1011     if p-change-value >= 0
     1012     then do:
     1013       assign
     1014         v-change-sign = 1
     1015       .
     1016     end.
     1017     else do:
     1018       assign
     1019         v-change-sign = -1
     1020       .
     1021     end.
     1022     assign
     1023       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1024     .
     1025     if p-change-value = 0
     1026     then do:
     1027       run diasize_position-resize-button in this-procedure .
     1028       return .
     1029     end.
     1030     move_block:
     1031     do
     1032     on error undo move_block, retry move_block
     1033     :
     1034       if retry
     1035       then do:
     1036         do
     1037         on error undo move_block, leave move_block
     1038         :
     1039           if p-change-value > 0
     1040           then do:
     1041             for each buf_temp-diasize-handle
     1042             on error undo, next
     1043             :
     1044               assign
     1045                 v-object-handle = buf_temp-diasize-handle.handle-value
     1046               .
     1047               if v-object-handle <> v-diasize-resize-button
     1048               then do:
     1049                 assign
     1050                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1051                 .
     1052               end.
     1053             end.
     1054             assign
     1055               v-diasize-browse-handle :height = v-browse-height
     1056             .
     1057             for each buf_temp-browse-handle
     1058               where buf_temp-browse-handle.browse-type = 'height':u
     1059             on error undo, next
     1060             :
     1061               assign
     1062                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1063               .
     1064             end.
     1065             assign
     1066               frame vs-parts :height = v-frame-height
     1067             .
     1068             if frame vs-parts :scrollable = true
     1069             then do:
     1070               assign
     1071                 frame vs-parts :virtual-height = v-frame-virtual-height
     1072               .
     1073             end.
     1074             run diasize_position-resize-button in this-procedure .
     1075           end.
     1076           else do:
     1077             if frame vs-parts :scrollable = true
     1078             then do:
     1079               assign
     1080                 frame vs-parts :virtual-height = v-frame-virtual-height
     1081               .
     1082             end.
     1083             assign
     1084               frame vs-parts :height = v-frame-height
     1085             .
     1086             assign
     1087               v-diasize-browse-handle :height = v-browse-height
     1088             .
     1089             for each buf_temp-browse-handle
     1090               where buf_temp-browse-handle.browse-type = 'height':u
     1091             on error undo, next
     1092             :
     1093               assign
     1094                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1095               .
     1096             end.
     1097             for each buf_temp-diasize-handle
     1098             on error undo, next
     1099             :
     1100               assign
     1101                 v-object-handle = buf_temp-diasize-handle.handle-value
     1102               .
     1103               if v-object-handle <> v-diasize-resize-button
     1104               then do:
     1105                 assign
     1106                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1107                 .
     1108               end.
     1109             end.
     1110             run diasize_position-resize-button in this-procedure .
     1111           end.
     1112           assign
     1113             v-diasize-change-size = false
     1114           .
     1115           leave move_block .
     1116         end.
     1117       end.
     1118       assign
     1119         v-diasize-need-full-display = true
     1120       .
     1121       if v-diasize-change-size = false
     1122       then do:
     1123         assign
     1124           v-diasize-change-size = true
     1125         .
     1126       end.
     1127       else do:
     1128         return .
     1129       end.
     1130       assign
     1131         v-frame-height = frame vs-parts :height
     1132         v-frame-virtual-height = frame vs-parts :virtual-height
     1133         v-browse-height = v-diasize-browse-handle :height
     1134       .
     1135       for each buf_temp-browse-handle
     1136         where buf_temp-browse-handle.browse-type = 'height':u
     1137       :
     1138         assign
     1139           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1140         .
     1141       end.
     1142       for each buf_temp-diasize-handle
     1143       :
     1144         delete buf_temp-diasize-handle .
     1145       end.
     1146       assign
     1147         v-field-group-handle = frame vs-parts :first-child
     1148       .
     1149       do while valid-handle(v-field-group-handle)
     1150       :
     1151         assign
     1152           v-object-handle = v-field-group-handle :first-child
     1153         .
     1154         do while valid-handle(v-object-handle)
     1155         :
     1156           if  v-object-handle <> v-diasize-browse-handle :handle
     1157           and can-query(v-object-handle, "row")
     1158           and can-query(v-object-handle, "height")
     1159           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1160           then do:
     1161             find first buf_temp-browse-handle
     1162               where buf_temp-browse-handle.browse-type   = 'height':u
     1163                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1164               no-error .
     1165             if available buf_temp-browse-handle
     1166             then do:
     1167             end.
     1168             else do:
     1169               create buf_temp-diasize-handle .
     1170               assign
     1171                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1172                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1173               .
     1174             end.
     1175           end.
     1176           assign
     1177             v-object-handle = v-object-handle :next-sibling
     1178           .
     1179         end.
     1180         assign
     1181           v-field-group-handle = v-field-group-handle :next-sibling
     1182         .
     1183       end.
     1184       do with frame vs-parts
     1185       :
     1186         hide v-diasize-resize-button .
     1187         assign
     1188           v-diasize-resize-button :row    = 1
     1189           v-diasize-resize-button :column = 1
     1190         .
     1191       end.
     1192       if p-change-value > 0
     1193       then do:
     1194         if frame vs-parts :scrollable = true
     1195         then do:
     1196           assign
     1197             frame vs-parts :virtual-height = frame vs-parts :virtual-height + p-change-value
     1198             no-error .
     1199           if error-status :error
     1200           or error-status :get-message(1) <> ""
     1201           then do:
     1202             undo move_block, retry move_block .
     1203           end.
     1204         end.
     1205         assign
     1206           frame vs-parts :height = frame vs-parts :height + p-change-value
     1207           no-error .
     1208         if error-status :error
     1209         or error-status :get-message(1) <> ""
     1210         then do:
     1211           undo move_block, retry move_block .
     1212         end.
     1213         assign
     1214           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1215           no-error .
     1216         if error-status :error
     1217         or error-status :get-message(1) <> ""
     1218         then do:
     1219           undo move_block, retry move_block .
     1220         end.
     1221         for each buf_temp-browse-handle
     1222           where buf_temp-browse-handle.browse-type = 'height':u
     1223         on error undo move_block, retry move_block
     1224         :
     1225           assign
     1226             buf_temp-browse-handle.browse-handle :height
     1227               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1228             no-error .
     1229           if error-status :error
     1230           or error-status :get-message(1) <> ""
     1231           then do:
     1232             undo move_block, retry move_block .
     1233           end.
     1234         end.
     1235         for each buf_temp-diasize-handle
     1236         on error undo move_block, retry move_block
     1237         :
     1238           assign
     1239             v-object-handle = buf_temp-diasize-handle.handle-value
     1240           .
     1241           if v-object-handle <> v-diasize-resize-button
     1242           then do:
     1243             assign
     1244               v-object-handle :row = v-object-handle :row + p-change-value
     1245               no-error .
     1246             if error-status :error
     1247             or error-status :get-message(1) <> ""
     1248             then do:
     1249               undo move_block, retry move_block .
     1250             end.
     1251           end.
     1252         end.
     1253       end.
     1254       else do:
     1255         for each buf_temp-diasize-handle
     1256         on error undo move_block, retry move_block
     1257         :
     1258           assign
     1259             v-object-handle = buf_temp-diasize-handle.handle-value
     1260           .
     1261           if v-object-handle <> v-diasize-resize-button
     1262           then do:
     1263             assign
     1264               v-object-handle :row = v-object-handle :row + p-change-value
     1265               no-error .
     1266             if error-status :error
     1267             or error-status :get-message(1) <> ""
     1268             then do:
     1269               undo move_block, retry move_block .
     1270             end.
     1271           end.
     1272         end.
     1273         assign
     1274           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1275           no-error .
     1276         if error-status :error
     1277         or error-status :get-message(1) <> ""
     1278         then do:
     1279           undo move_block, retry move_block .
     1280         end.
     1281         for each buf_temp-browse-handle
     1282           where buf_temp-browse-handle.browse-type = 'height':u
     1283         on error undo move_block, retry move_block
     1284         :
     1285           assign
     1286             buf_temp-browse-handle.browse-handle :height
     1287               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1288             no-error .
     1289           if error-status :error
     1290           or error-status :get-message(1) <> ""
     1291           then do:
     1292             undo move_block, retry move_block .
     1293           end.
     1294         end.
     1295         assign
     1296           frame vs-parts :height = frame vs-parts :height + p-change-value
     1297           no-error .
     1298         if error-status :error
     1299         or error-status :get-message(1) <> ""
     1300         then do:
     1301           undo move_block, retry move_block .
     1302         end.
     1303         if frame vs-parts :scrollable = true
     1304         then do:
     1305           assign
     1306             frame vs-parts :virtual-height = frame vs-parts :virtual-height + p-change-value
     1307             no-error .
     1308           if error-status :error
     1309           or error-status :get-message(1) <> ""
     1310           then do:
     1311             undo move_block, retry move_block .
     1312           end.
     1313         end.
     1314       end.
     1315       if p-move-resize = true
     1316       then do:
     1317         run diasize_position-resize-button in this-procedure .
     1318       end.
     1319       if v-diasize-wndstore = true
     1320       then do:
     1321         if connected("ub") = true
     1322         then do:
     1323           define variable v-cntxt-db-num        as integer   no-undo .
     1324           define variable v-cntxt-userid        as character no-undo .
     1325           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1326                                             , OUTPUT v-cntxt-userid
     1327                                             ) .
     1328           run gbl/wndsizew.p
     1329             (input  v-cntxt-db-num
     1330             ,input  v-cntxt-userid
     1331             ,input  v-diasize-proc-name
     1332             ,input  'height':u
     1333             ,input  string(frame vs-parts :height - v-diasize-orig-frame-height)
     1334             ) .
     1335         end.
     1336       end.
     1337     end.
     1338     assign
     1339       v-diasize-change-size = false
     1340     .
     1341   end procedure.
     1342   procedure diasize_set-height :
     1343     define input  parameter p-new-height  as decimal   no-undo .
     1344     define input  parameter p-move-resize as logical   no-undo .
     1345     do
     1346     on error undo, return error return-value
     1347     :
     1348       run diasize_change-height in this-procedure
     1349         (input  (p-new-height - frame vs-parts :height)
     1350         ,input  p-move-resize
     1351         ) .
     1352     end.
     1353   end procedure.
     1354   procedure diasize_change-width :
     1355     define input  parameter p-change-value as decimal   no-undo .
     1356     define input  parameter p-move-resize  as logical   no-undo .
     1357     define variable v-field-group-handle   as handle    no-undo .
     1358     define variable v-object-handle        as handle    no-undo .
     1359     define variable v-frame-width          as decimal   no-undo .
     1360     define variable v-frame-virtual-width  as decimal   no-undo .
     1361     define variable v-browse-width         as decimal   no-undo .
     1362     define variable v-window-width         as decimal   no-undo .
     1363     define variable v-window-virtual-width as decimal   no-undo .
     1364     define variable v-change-sign          as integer   no-undo .
     1365     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1366     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1367     if p-change-value > 0
     1368     then do:
     1369       if frame vs-parts :width + p-change-value >
     1370           session :width-chars
     1371       then do:
     1372         assign
     1373           p-change-value = session :width-chars - frame vs-parts :width
     1374         .
     1375         if p-change-value <= 0
     1376         then do:
     1377           run diasize_position-resize-button in this-procedure .
     1378           return .
     1379         end.
     1380       end.
     1381     end.
     1382     if p-change-value < 0
     1383     then do:
     1384       if frame vs-parts :width + p-change-value < v-diasize-orig-frame-width
     1385       then do:
     1386         assign
     1387           p-change-value = v-diasize-orig-frame-width
     1388                          - frame vs-parts :width
     1389         .
     1390         if p-change-value >= 0
     1391         then do:
     1392           run diasize_position-resize-button in this-procedure .
     1393           return .
     1394         end.
     1395       end.
     1396     end.
     1397     if p-change-value >= 0
     1398     then do:
     1399       assign
     1400         v-change-sign = 1
     1401       .
     1402     end.
     1403     else do:
     1404       assign
     1405         v-change-sign = -1
     1406       .
     1407     end.
     1408     assign
     1409       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1410     .
     1411     if p-change-value = 0
     1412     then do:
     1413       run diasize_position-resize-button in this-procedure .
     1414       return .
     1415     end.
     1416     move_block:
     1417     do
     1418     on error undo move_block, leave move_block
     1419     :
     1420       if retry
     1421       then do:
     1422         do
     1423         on error undo move_block, leave move_block
     1424         :
     1425           if p-change-value > 0
     1426           then do:
     1427             for each buf_temp-diasize-handle
     1428             on error undo, next
     1429             :
     1430               assign
     1431                 v-object-handle = buf_temp-diasize-handle.handle-value
     1432               .
     1433               if v-object-handle <> v-diasize-resize-button
     1434               then do:
     1435                 assign
     1436                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1437                 .
     1438               end.
     1439             end.
     1440             assign
     1441               v-diasize-browse-handle :width = v-browse-width
     1442             .
     1443             for each buf_temp-browse-handle
     1444               where buf_temp-browse-handle.browse-type = 'width':u
     1445             on error undo, next
     1446             :
     1447               assign
     1448                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1449               .
     1450             end.
     1451             assign
     1452               frame vs-parts :width = v-frame-width
     1453             .
     1454             if frame vs-parts :scrollable = true
     1455             then do:
     1456               assign
     1457                 frame vs-parts :virtual-width = v-frame-virtual-width
     1458               .
     1459             end.
     1460             run diasize_position-resize-button in this-procedure .
     1461           end.
     1462           else do:
     1463             if frame vs-parts :scrollable = true
     1464             then do:
     1465               assign
     1466                 frame vs-parts :virtual-width = v-frame-virtual-width
     1467               .
     1468             end.
     1469             assign
     1470               frame vs-parts :width = v-frame-width
     1471             .
     1472             for each buf_temp-browse-handle
     1473               where buf_temp-browse-handle.browse-type = 'width':u
     1474             on error undo, next
     1475             :
     1476               assign
     1477                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1478               .
     1479             end.
     1480             assign
     1481               v-diasize-browse-handle :width = v-browse-width
     1482             .
     1483             for each buf_temp-diasize-handle
     1484             on error undo, next
     1485             :
     1486               assign
     1487                 v-object-handle = buf_temp-diasize-handle.handle-value
     1488               .
     1489               if v-object-handle <> v-diasize-resize-button
     1490               then do:
     1491                 assign
     1492                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1493                 .
     1494               end.
     1495             end.
     1496             run diasize_position-resize-button in this-procedure .
     1497           end.
     1498           assign
     1499             v-diasize-change-size = false
     1500           .
     1501           leave move_block .
     1502         end.
     1503       end.
     1504       assign
     1505         v-diasize-need-full-display = true
     1506       .
     1507       if v-diasize-change-size = false
     1508       then do:
     1509         assign
     1510           v-diasize-change-size = true
     1511         .
     1512       end.
     1513       else do:
     1514         return .
     1515       end.
     1516       assign
     1517         v-frame-width = frame vs-parts :width
     1518         v-frame-virtual-width = frame vs-parts :virtual-width
     1519         v-browse-width = v-diasize-browse-handle :width
     1520       .
     1521       for each buf_temp-browse-handle
     1522         where buf_temp-browse-handle.browse-type = 'width':u
     1523       :
     1524         assign
     1525           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1526         .
     1527       end.
     1528       for each buf_temp-diasize-handle
     1529       :
     1530         delete buf_temp-diasize-handle .
     1531       end.
     1532       assign
     1533         v-field-group-handle = frame vs-parts :first-child
     1534       .
     1535       do while valid-handle(v-field-group-handle)
     1536       :
     1537         assign
     1538           v-object-handle = v-field-group-handle :first-child
     1539         .
     1540         do while valid-handle(v-object-handle)
     1541         :
     1542           if  v-object-handle <> v-diasize-browse-handle :handle
     1543           and v-object-handle <> v-diasize-resize-button
     1544           and can-query(v-object-handle, "row")
     1545           and can-query(v-object-handle, "height")
     1546           and ( v-object-handle :col + v-object-handle :width
     1547                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1548               )
     1549           then do:
     1550             find first buf_temp-browse-handle
     1551               where buf_temp-browse-handle.browse-type   = 'width':u
     1552                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1553               no-error .
     1554             if available buf_temp-browse-handle
     1555             then do:
     1556             end.
     1557             else do:
     1558               create buf_temp-diasize-handle .
     1559               assign
     1560                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1561                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1562               .
     1563             end.
     1564           end.
     1565           assign
     1566             v-object-handle = v-object-handle :next-sibling
     1567           .
     1568         end.
     1569         assign
     1570           v-field-group-handle = v-field-group-handle :next-sibling
     1571         .
     1572       end.
     1573       do with frame vs-parts
     1574       :
     1575         hide v-diasize-resize-button .
     1576         v-diasize-resize-button :row = 1.
     1577         v-diasize-resize-button :column = 1.
     1578       end.
     1579       if p-change-value > 0
     1580       then do:
     1581         if frame vs-parts :scrollable = true
     1582         then do:
     1583           assign
     1584             frame vs-parts :virtual-width = frame vs-parts :virtual-width + p-change-value
     1585             no-error .
     1586           if error-status :error
     1587           or error-status :get-message(1) <> ""
     1588           then do:
     1589             undo move_block, retry move_block.
     1590           end.
     1591         end.
     1592         assign
     1593           frame vs-parts :width = v-frame-width + p-change-value
     1594           no-error .
     1595         if error-status :error
     1596         or error-status :get-message(1) <> ""
     1597         then do:
     1598           undo move_block, retry move_block.
     1599         end.
     1600         assign
     1601           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1602         no-error .
     1603         if error-status :error
     1604         or error-status :get-message(1) <> ""
     1605         then do:
     1606           undo move_block, retry move_block.
     1607         end.
     1608         for each buf_temp-browse-handle
     1609           where buf_temp-browse-handle.browse-type = 'width':u
     1610         on error undo move_block, retry move_block
     1611         :
     1612           assign
     1613             buf_temp-browse-handle.browse-handle :width
     1614               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1615             no-error .
     1616           if error-status :error
     1617           or error-status :get-message(1) <> ""
     1618           then do:
     1619             undo move_block, retry move_block .
     1620           end.
     1621         end.
     1622         for each buf_temp-diasize-handle
     1623         on error undo move_block, retry move_block
     1624         :
     1625           assign
     1626             v-object-handle = buf_temp-diasize-handle.handle-value
     1627           .
     1628           if v-object-handle <> v-diasize-resize-button
     1629           then do:
     1630             assign
     1631               v-object-handle :col = v-object-handle :col + p-change-value
     1632               no-error .
     1633             if error-status :error
     1634             or error-status :get-message(1) <> ""
     1635             then do:
     1636               undo move_block, retry move_block .
     1637             end.
     1638           end.
     1639         end.
     1640       end.
     1641       else do:
     1642         for each buf_temp-diasize-handle
     1643         on error undo move_block, retry move_block
     1644         :
     1645           assign
     1646             v-object-handle = buf_temp-diasize-handle.handle-value
     1647           .
     1648           if v-object-handle <> v-diasize-resize-button
     1649           then do:
     1650             assign
     1651               v-object-handle :col = v-object-handle :col + p-change-value
     1652               no-error .
     1653             if error-status :error
     1654             or error-status :get-message(1) <> ""
     1655             then do:
     1656               undo move_block, retry move_block .
     1657             end.
     1658           end.
     1659         end.
     1660         for each buf_temp-browse-handle
     1661           where buf_temp-browse-handle.browse-type = 'width':u
     1662         on error undo move_block, retry move_block
     1663         :
     1664           assign
     1665             buf_temp-browse-handle.browse-handle :width
     1666               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1667             no-error .
     1668           if error-status :error
     1669           or error-status :get-message(1) <> ""
     1670           then do:
     1671             undo move_block, retry move_block .
     1672           end.
     1673         end.
     1674         assign
     1675           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1676           no-error .
     1677         if error-status :error
     1678         or error-status :get-message(1) <> ""
     1679         then do:
     1680           undo move_block, retry move_block.
     1681         end.
     1682         assign
     1683           frame vs-parts :width = frame vs-parts :width + p-change-value
     1684         no-error .
     1685         if error-status :error
     1686         or error-status :get-message(1) <> ""
     1687         then do:
     1688           undo move_block, retry move_block.
     1689         end.
     1690         if frame vs-parts :scrollable = true
     1691         then do:
     1692           assign
     1693             frame vs-parts :virtual-width = frame vs-parts :virtual-width + p-change-value
     1694           no-error .
     1695           if error-status :error
     1696           or error-status :get-message(1) <> ""
     1697           then do:
     1698             undo move_block, retry move_block.
     1699           end.
     1700         end.
     1701       end.
     1702       if p-move-resize
     1703       then do:
     1704         run diasize_position-resize-button in this-procedure .
     1705       end.
     1706       if v-diasize-wndstore = true
     1707       then do:
     1708         if connected("ub") = true
     1709         then do:
     1710           define variable v-cntxt-db-num        as integer   no-undo .
     1711           define variable v-cntxt-userid        as character no-undo .
     1712           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1713                                             , OUTPUT v-cntxt-userid
     1714                                             ) .
     1715           run gbl/wndsizew.p
     1716             (input  v-cntxt-db-num
     1717             ,input  v-cntxt-userid
     1718             ,input  v-diasize-proc-name
     1719             ,input  'width':u
     1720             ,input  string(frame vs-parts :width - v-diasize-orig-frame-width)
     1721             ) .
     1722         end.
     1723       end.
     1724     end.
     1725     assign
     1726       v-diasize-change-size = false
     1727     .
     1728   end procedure.
     1729   procedure diasize_set-width :
     1730     define input  parameter p-new-width  as decimal   no-undo .
     1731     define input  parameter p-move-resize as logical   no-undo .
     1732     do
     1733     on error undo, return error return-value
     1734     :
     1735       run diasize_change-width in this-procedure
     1736         (input  (p-new-width - frame vs-parts :width)
     1737         ,input  p-move-resize
     1738         ) .
     1739     end.
     1740   end procedure.
     1741   procedure diasize_position-resize-button :
     1742     do with frame vs-parts
     1743     :
     1744       hide v-diasize-resize-button .
     1745       assign
     1746         v-diasize-resize-button :row = frame vs-parts :height - v-diasize-resize-button :height
     1747                     - 1
     1748                     - (frame vs-parts :border-bottom-pixels / session :pixels-per-row)
     1749         v-diasize-resize-button :col = frame vs-parts :width - v-diasize-resize-button :width
     1750                     - 1
     1751                     - (frame vs-parts :border-right-pixels / session :pixels-per-column)
     1752       .
     1753       view v-diasize-resize-button .
     1754     end.
     1755   end procedure.
     1756   on alt-right anywhere
     1757   do:
     1758     run diasize_change-width in this-procedure
     1759       (input 1
     1760       ,input true
     1761       ) .
     1762     return no-apply .
     1763   end.
     1764   on alt-left anywhere
     1765   do:
     1766     run diasize_change-width in this-procedure
     1767       (input -1
     1768       ,input true
     1769       ) .
     1770     return no-apply .
     1771   end.
     1772   on alt-down anywhere
     1773   do:
     1774     run diasize_change-height in this-procedure
     1775       (input 1
     1776       ,input true
     1777       ) .
     1778     return no-apply .
     1779   end.
     1780   on alt-up anywhere
     1781   do:
     1782     run diasize_change-height in this-procedure
     1783       (input -1
     1784       ,input true
     1785       ) .
     1786     return no-apply .
     1787   end.
     1788   on alt-enter of frame vs-parts
     1789   do:
     1790     run diasize_maximize in this-procedure
     1791       (input  ?
     1792       ).
     1793     return no-apply .
     1794   end.
     1795   procedure diasize_end-move :
     1796     do
     1797     on error undo, return error return-value
     1798     :
     1799       define variable v-row-delta as decimal   no-undo .
     1800       define variable v-col-delta as decimal   no-undo .
     1801       define variable v-new-row as decimal   no-undo .
     1802       define variable v-new-col as decimal   no-undo .
     1803       assign
     1804         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1805         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1806       .
     1807       assign
     1808         v-row-delta = v-new-row - frame vs-parts :height
     1809         v-col-delta = v-new-col - frame vs-parts :width
     1810       .
     1811       run diasize_change-height in this-procedure
     1812         (input v-row-delta
     1813         ,input true
     1814         ) .
     1815       run diasize_change-width in this-procedure
     1816         (input v-col-delta
     1817         ,input true
     1818         ) .
     1819     end.
     1820   end procedure.
     1821   procedure diasize_maximize :
     1822     define input  parameter p-action as logical   no-undo .
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       if p-action = ?
     1827       then do:
     1828         if v-diasize-need-maximize = true
     1829         then do:
     1830           assign
     1831             p-action = true
     1832           .
     1833         end.
     1834         else do:
     1835           assign
     1836             p-action = false
     1837           .
     1838         end.
     1839       end.
     1840       if p-action = true
     1841       then do:
     1842         run diasize_change-height in this-procedure
     1843           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1844               - frame vs-parts :height-chars
     1845           ,input true
     1846           ) .
     1847         run diasize_change-width in this-procedure
     1848           (input session :width-chars
     1849               - frame vs-parts :width-chars
     1850           ,input true
     1851           ) .
     1852         assign
     1853           v-diasize-need-maximize = false
     1854         .
     1855       end.
     1856       else do:
     1857         run diasize_change-width in this-procedure
     1858           (input v-diasize-orig-frame-width
     1859               - frame vs-parts :width-chars
     1860           ,input true
     1861           ) .
     1862         run diasize_change-height in this-procedure
     1863           (input v-diasize-orig-frame-height
     1864               - frame vs-parts :height-chars
     1865           ,input true
     1866           ) .
     1867         assign
     1868           v-diasize-need-maximize = true
     1869         .
     1870       end.
     1871     end.
     1872   end procedure.
     1873   procedure diasize_restore-orig-size :
     1874     do
     1875     on error undo, return error return-value
     1876     :
     1877       assign
     1878         v-diasize-current-frame-width  = frame vs-parts :width
     1879         v-diasize-current-frame-height = frame vs-parts :height
     1880       .
     1881       run diasize_set-height in this-procedure
     1882         (input  v-diasize-orig-frame-height
     1883         ,input  true
     1884         ) .
     1885       run diasize_set-width in this-procedure
     1886         (input  v-diasize-orig-frame-width
     1887         ,input  true
     1888         ) .
     1889     end.
     1890   end procedure.
     1891   procedure diasize_restore-current-size :
     1892     do
     1893     on error undo, return error return-value
     1894     :
     1895       run diasize_set-height in this-procedure
     1896         (input  v-diasize-current-frame-height
     1897         ,input  true
     1898         ) .
     1899       run diasize_set-width in this-procedure
     1900         (input  v-diasize-current-frame-width
     1901         ,input  true
     1902         ) .
     1903     end.
     1904   end procedure.
     1905   procedure diasize_set-browse-handle :
     1906     define input  parameter p-browse-handle as handle   no-undo .
     1907     define buffer buf_temp-browse-handle for temp-browse-handle .
     1908     do
     1909     on error undo, return error return-value
     1910     :
     1911       assign
     1912         v-diasize-browse-handle = p-browse-handle
     1913       .
     1914       for each buf_temp-browse-handle
     1915       on error undo, return error return-value
     1916       :
     1917         delete buf_temp-browse-handle .
     1918       end.
     1919     end.
     1920   end procedure.
     1921   procedure diasize_add_browse :
     1922     define input  parameter p-browse-type   as character no-undo .
     1923     define input  parameter p-browse-handle as handle    no-undo .
     1924     define buffer buf_temp-browse-handle for temp-browse-handle .
     1925     do
     1926     on error undo, return error return-value
     1927     :
     1928       assign
     1929         v-diasize-browse-number = v-diasize-browse-number + 1
     1930       .
     1931       create buf_temp-browse-handle .
     1932       assign
     1933         buf_temp-browse-handle.browse-type   = p-browse-type
     1934         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1935         buf_temp-browse-handle.browse-handle = p-browse-handle
     1936       .
     1937     end.
     1938   end procedure.
     1939   procedure diasize_init :
     1940     define variable v-default-value    as logical   no-undo .
     1941     define variable v-restore-saved    as logical   no-undo .
     1942     define variable v-resize-value-str as character no-undo .
     1943     do
     1944     on error undo, return error return-value
     1945     :
     1946       do with frame vs-parts
     1947       :
     1948         assign
     1949           v-diasize-orig-frame-height = frame vs-parts :height
     1950           v-diasize-orig-frame-width  = frame vs-parts :width
     1951           v-diasize-browse-handle     = browse br-parts :handle
     1952         .
     1953         create button v-diasize-resize-button
     1954         assign
     1955           parent        = frame vs-parts :first-child
     1956           label         = "s"
     1957           height-pixels = 16
     1958           width-pixels  = 16
     1959           visible       = true
     1960           sensitive     = true
     1961           movable       = true
     1962           triggers:
     1963             on end-move persistent run diasize_end-move in this-procedure .
     1964           end triggers.
     1965         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1966         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1967         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1968         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1969         assign
     1970           v-diasize-wndmax = false
     1971         .
     1972         if connected("ub") = true
     1973         then do:
     1974           define variable v-cntxt-db-num        as integer   no-undo .
     1975           define variable v-cntxt-userid        as character no-undo .
     1976           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1977                                             , OUTPUT v-cntxt-userid
     1978                                             ) .
     1979           run gbl/wndpar_r.p
     1980             (input  v-cntxt-db-num
     1981             ,input  v-cntxt-userid
     1982             ,input  'wndmax':U
     1983             ,output v-diasize-wndmax
     1984             ,output v-default-value
     1985             ) .
     1986         end.
     1987         assign
     1988           v-diasize-wndstore = false
     1989         .
     1990         if connected("ub") = true
     1991         then do:
     1992           run gbl/wndpar_r.p
     1993             (input  v-cntxt-db-num
     1994             ,input  v-cntxt-userid
     1995             ,input  'wndstore':U
     1996             ,output v-diasize-wndstore
     1997             ,output v-default-value
     1998             ) .
     1999         end.
     2000         assign
     2001           v-diasize-proc-name = entry(1, program-name(2), '.')
     2002         .
     2003         if v-diasize-wndstore = true
     2004         then do:
     2005           assign
     2006             v-restore-saved = false
     2007           .
     2008           if connected("ub") = true
     2009           then do:
     2010             run gbl/wndsizer.p
     2011               (input  v-cntxt-db-num
     2012               ,input  v-cntxt-userid
     2013               ,input  v-diasize-proc-name
     2014               ,input  'height':u
     2015               ,output v-resize-value-str
     2016               ) .
     2017             if v-resize-value-str <> '':U
     2018             then do:
     2019               run diasize_change-height in this-procedure
     2020                 (input  integer(v-resize-value-str)
     2021                 ,input  true
     2022                 ) .
     2023               assign
     2024                 v-restore-saved = true
     2025               .
     2026             end.
     2027           end.
     2028           if connected("ub") = true
     2029           then do:
     2030             run gbl/wndsizer.p
     2031               (input  v-cntxt-db-num
     2032               ,input  v-cntxt-userid
     2033               ,input  v-diasize-proc-name
     2034               ,input  'width':u
     2035               ,output v-resize-value-str
     2036               ) .
     2037             if v-resize-value-str <> '':U
     2038             then do:
     2039               run diasize_change-width in this-procedure
     2040                 (input  integer(v-resize-value-str)
     2041                 ,input  true
     2042                 ) .
     2043               assign
     2044                 v-restore-saved = true
     2045               .
     2046             end.
     2047           end.
     2048           if v-restore-saved <> true
     2049           then do:
     2050             if v-diasize-wndmax = true
     2051             then do:
     2052               run diasize_maximize in this-procedure
     2053                 (input  true
     2054                 ) .
     2055             end.
     2056           end.
     2057         end.
     2058         else do:
     2059           if v-diasize-wndmax = true
     2060           then do:
     2061             run diasize_maximize in this-procedure
     2062               (input  true
     2063               ) .
     2064           end.
     2065         end.
     2066       end.
     2067     end.
     2068   end procedure.
     2069   procedure diasize_need-full-display :
     2070     define output parameter p-need-full-display as logical   no-undo .
     2071     do
     2072     on error undo, return error return-value
     2073     :
     2074       assign
     2075         p-need-full-display = v-diasize-need-full-display
     2076       .
     2077       assign
     2078         v-diasize-need-full-display = false
     2079       .
     2080     end.
     2081   end procedure.
     2082   procedure get-context :
     2083      define output parameter p-db-num as integer          no-undo.
     2084      define output parameter p-user-id as character        no-undo.
     2085      define variable v-login               as character    no-undo.
     2086      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2087      define buffer buf_user-login  for ub.user-login .
     2088      do
     2089      on error undo, return error
     2090      :
     2091            FIND FIRST buf_sys-ctrl no-lock.
     2092            ASSIGN
     2093               v-login = USERID("ub")
     2094               p-db-num = buf_sys-ctrl.db-num
     2095            .
     2096            FIND FIRST buf_user-login
     2097                 WHERE buf_user-login.db-num = p-db-num
     2098                   AND buf_user-login.user-login = v-login
     2099                 no-lock
     2100                 no-error
     2101                 .
     2102            IF AVAILABLE buf_user-login
     2103            THEN DO:
     2104               assign
     2105                  p-user-id = buf_user-login.user-id
     2106               .
     2107            END.
     2108      end.
     2109   end procedure.
     2110       run diasize_init in this-procedure .
     2111     RUN calc.
     2112     assign
     2113     MENU-ITEM m-cycle-rubl:label in menu m-cycle = "в рублях"
     2114     tot-in-sum0-rubl:label = "сумма (руб)"
     2115     .
     2116     RUN enable_UI.
     2117     assign b-print:MENU-MOUSE = 1.
     2118     if gds-art = "" then
     2119         FRAME vs-parts:TITLE = string( "Приходные партии товара: " +
     2120                                                                           suppl-gds.artic + " " + suppl-gds.gds-name ).
     2121     else
     2122         do:
     2123             if num-doc = "" then
     2124                 FRAME vs-parts:TITLE = string( "Поставки с: " + string(from-date,"99/99/9999") +
     2125                                                                                   " по: " + string(to-date,"99/99/9999") +
     2126                                                                                   " Поставщик: " + supplier.obj-name +
     2127                                                                                   " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" ).
     2128             else
     2129                 do:
     2130                     find ub.trn-doc where ub.trn-doc.doc-code = num-doc no-lock.
     2131                     FRAME vs-parts:TITLE = string( "Поставки по документу: " + num-doc + " от " + string( ub.trn-doc.fact-date, "99/99/9999" ) ).
     2132                 end.
     2133         end.
     2134     apply "entry" to br-parts in frame vs-parts.
     2135     WAIT-FOR GO OF FRAME vs-parts.
     2136   END.
     2137   RUN disable_UI.
     2138   PROCEDURE calc :
     2139   define buffer    b-parts    for ub.parts.
     2140   define variable  out-qnty  like ub.parts.fact-qnty no-undo.
     2141   define variable  free-qnty like ub.parts.fact-qnty no-undo.
     2142   define variable  qnty_sale like suppl-gds.qnty-sale no-undo.
     2143   define variable  f-date as date no-undo.
     2144   define variable  l-date as date no-undo.
     2145   define variable v-host-code like ub.sysconf.host-code no-undo .
     2146   if session:set-wait-state("COMPILER") then.
     2147   run waitfram-show in this-procedure ("Подождите...").
     2148   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
