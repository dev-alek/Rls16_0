      730   suppl-parts.out-sum0-base COLUMN-LABEL "Расход сумма!уч. цен (б.вал)" FORMAT "->>>,>>>,>>9.99"
      731   suppl-parts.out-sum-cli COLUMN-LABEL "Расход сумма!вал. поставщика" FORMAT "->>>,>>>,>>9.99"
      732   suppl-parts.free-qnty COLUMN-LABEL "Остаток!количество" FORMAT "->,>>>,>>9.<<<"
      733   suppl-parts.free-sum0-rubl COLUMN-LABEL "Остаток сумма!уч. цен (руб)" FORMAT "->>>,>>>,>>9.99"
      734   suppl-parts.free-sum0-base COLUMN-LABEL "Остаток сумма!уч. цен (б.вал)" FORMAT "->>>,>>>,>>9.99"
      735   suppl-parts.free-sum-cli COLUMN-LABEL "Остаток сумма!вал. поставщика" FORMAT "->>>,>>>,>>9.99"
