      805   END.
      806   ON CHOOSE OF MENU-ITEM m-cycle-cli
      807   DO:
      808     if prev-exch-code = ? then
      809         message "Отчет не может быть напечатан!" SKIP
      810                         "Т.к. были приходы от данного поставщика" SKIP
      811                         "за данный период в разных валютах." view-as alert-box ERROR.
      812     else
      813         do:
      814             FIND ub.currency WHERE ub.currency.curr-code = prev-exch-code NO-LOCK.
      815             assign cli-val = ub.currency.curr-abbr.
      816             RUN print-cycle ("cli").
      817         end.
      818   END.
      819   ON CHOOSE OF MENU-ITEM m-cycle-rubl
      820   DO:
      821     RUN print-cycle ("rubl").
      822   END.
      823   ON CHOOSE OF MENU-ITEM m-order
      824   DO:
      825     run print-order.
      826     APPLY "ENTRY" TO BROWSE br-parts.
      827   END.
      828   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME vs-parts:PARENT eq ?
      829   THEN FRAME vs-parts:PARENT = ACTIVE-WINDOW.
      830   MAIN-BLOCK:
