      741   (suppl-parts.free-qnty / (suppl-parts.out-qnty / (suppl-parts.ls-date - suppl-parts.fs-date))) COLUMN-LABEL "Обеспе-!ченность" FORMAT "->>>>>9."
      742   (if suppl-parts.part-code = "" then "------" else suppl-parts.part-code) COLUMN-LABEL "Партия! " FORMAT "x(14)"
      743       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.5 BY 17.17.
      744   DEFINE FRAME vs-parts
