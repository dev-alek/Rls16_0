      355   define variable v-waitfram-action01         as character   no-undo .
      356   define variable v-waitfram-action02         as character   no-undo .
      357   define variable v-waitfram-action03         as character   no-undo .
      358   define variable mWaitFramTextBeg            as character   no-undo.
      359   define variable mWaitFramTextEnd            as character   no-undo.
      360   define variable mWaitFramView               as logical     no-undo.
      361   define variable mWaitProcEvent              as logical     no-undo init yes.
      362   define variable mWaitFramInterval           as integer     no-undo init 1 .
      363   define variable mWaitFramStop               as logical     no-undo.
      364   define variable mWaitFramStopUser           as logical     no-undo.
      365   define variable mWaitFramStopTimeOut        as logical     no-undo.
      366   define variable mWaitFramStartProc          as datetime-tz no-undo.
      367   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      368   define button B-WaitFramStop auto-end-key
      369        label "Стоп"
      370        size 10 by 1 tooltip "Остоновить процесс".
      371   define button B-viewProcInfo
      372        label "Информация"
      373        size 15 by 1 tooltip "Информация о процесс".
      374   define frame waitfram
      375     v-waitfram-action01 format "x(72)" no-label skip
      376     v-waitfram-action02 format "x(72)" no-label skip
      377     v-waitfram-action03 format "x(72)" no-label skip
      378     B-viewProcInfo
      379     B-WaitFramStop at row 4 col 30
      380     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      381     .
      382   define new global shared variable mBatchMode as logical no-undo init ?.
      383   define variable mFramBachModHandle as handle no-undo.
      384   mFramBachModHandle = frame waitfram:handle.
      385   define variable mFameOldVis as logical no-undo.
      386   define variable mVisCUrentVin as logical no-undo.
      387   if session:batch-mode
      388   then
      389      mBatchMode = yes.
      390   if mBatchMode = ? then do:
      391     mVisCUrentVin = current-window:visible.
      392     mFameOldVis = mFramBachModHandle:visible.
      393     mFramBachModHandle:visible  = yes.
      394     mBatchMode = mFramBachModHandle:visible ne yes.
      395     mFramBachModHandle:visible = mFameOldVis.
      396     current-window:visible = mVisCUrentVin.
      397   end.
      398    if  log-manager:logfile-name ne ?
      399     then DO:
      400         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      401         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      402         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      403     end.
      404   on choose of B-WaitFramStop in frame waitfram
      405   do:
      406     mWaitFramStop = yes.
      407     mWaitFramStopUser = yes.
      408   end.
      409   function waitfram-check-timeout returns logical():
      410      define variable vtime as int64 no-undo.
      411      if mWaitFramStopTimeOut
      412      then
      413         return yes.
      414      vtime = ( now - mWaitFramStartProc ) / 1000 .
      415      if     mWaitFramTimeOut ne ?
      416         and mWaitFramTimeOut ne 0
      417         and mWaitFramTimeOut lt vtime
      418      then do:
      419         mWaitFramStopTimeOut = yes.
      420      end.
      421      return mWaitFramStopTimeOut.
      422   end.
      423   procedure waitfram-hide :
      424     if not session:batch-mode
      425     then do
      426     on error undo, return error return-value
      427     :
      428       pause 0 before-hide .
      429       if not mBatchMode then
      430         hide frame waitfram .
      431     if     not mWaitFramView
      432        and mWaitProcEvent
      433     then
      434       process events .
      435     end.
      436   end procedure.
      437   procedure waitfram-show :
      438     define input  parameter p-message as character no-undo .
      439     define variable v-left-margin as integer   no-undo .
      440     if not session:batch-mode
      441     then do
      442     on error undo, return error return-value
      443     :
      444       if length(p-message) <= 70 then do:
      445         assign
      446           v-left-margin = integer((70 - length(p-message)) / 2)
      447         .
      448         assign
      449           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      450         .
      451         assign
      452           v-waitfram-action01 = " "
      453           v-waitfram-action02 = " "
      454                                    + fill(" ", v-left-margin)
      455                                    + p-message
      456           v-waitfram-action03 = " "
      457         .
      458       end.
      459       else do:
      460         define variable vRindex1 as integer no-undo.
      461         define variable vRindex2 as integer no-undo.
      462         vRindex1 = r-index(p-message," ",70).
      463         if vRindex1 = 0
      464         then
      465            vRindex1 = 70.
      466         if length(p-message)  <= vRindex1 + 70 then do:
      467           assign
      468             v-waitfram-action01 = " "
      469             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      470             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      471           .
      472         end.
      473         else do:
      474           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      475           if vRindex2 <= vRindex1
      476           then
      477              vRindex2 = vRindex1 + 70.
      478           assign
      479             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      480             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      481             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      482           .
      483         end.
      484       end.
      485       B-viewProcInfo:visible   in frame waitfram = no.
      486       B-viewProcInfo:sensitive in frame waitfram = no.
      487       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      488       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      489       if  (   mWaitFramView
      490          or  mWaitProcEvent)
      491          and not mBatchMode
      492       then
      493          display
      494             v-waitfram-action01 skip
      495             v-waitfram-action02 skip
      496             v-waitfram-action03 skip
      497          with frame waitfram .
      498       if     mWaitFramView
      499          then do:
      500             if     mWaitFramInterval ne ?
      501                and not mBatchMode
      502             then
      503                wait-for go of frame waitfram pause mWaitFramInterval.
      504          end.
      505          else
      506             if     mWaitProcEvent
      507                and not mBatchMode
      508             then
      509                process events .
      510     end.
      511   end procedure.
      512      procedure waitfram-show-this:
      513         define input  parameter iInterval as int64 no-undo.
      514         define variable vtime as int64 no-undo.
      515         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      516         mWaitFramInterval = iInterval.
      517         run waitfram-show (substitute("&1&2 &3&4" ,
      518                                       mWaitFramTextBeg ,
      519                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      520                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      521                                       mWaitFramTextEnd
      522                                      )
      523                           ).
      524      end.
      525      procedure WaitFramRunPause:
      526         define input  parameter iInterval as dec no-undo.
      527         define variable vStart  as datetime-tz no-undo.
      528         define variable vend    as datetime-tz no-undo.
      529         define variable vint as int64 no-undo.
      530         define variable vOk as logical no-undo.
      531         vStart = now.
      532         vend   = vStart.
      533         publish "WaitFramPause" (iInterval,output vOk).
      534         vend   =  now.
      535         vint = vend - vStart.
      536         vint = iInterval - vint / 1000.
      537         if     not mWaitFramStop
      538            and (   vint > 0
      539                 or (    not vOk
      540                     and iInterval eq ?
      541                     )
      542                 )
      543         then
      544            run waitfram-show-this (iInterval).
      545         vend   =  now.
      546         vint = vend - vStart.
      547         vint = iInterval - vint / 1000.
      548         if     not mWaitFramStop
      549            and vint > 0
      550         then do:
      551            run gbl/pause.p (vint * 1000).
      552         end.
      553         if iInterval ne ?
      554         then
      555            publish "WaitFramStop".
      556         waitfram-check-timeout().
      557      end.
      558      procedure WaitFramWaitFor:
      559         define input  parameter iInterval as dec no-undo.
      560         assign
      561            mWaitFramStartProc   = now
      562            mWaitFramStopUser    = no
      563            mWaitFramStopTimeOut = no
      564         .
      565         block-wait:
      566         do while not mWaitFramStop:
      567            run WaitFramRunPause (iInterval).
      568            if  waitfram-check-timeout()
      569            then do:
      570               leave block-wait.
      571            end.
      572         end.
      573         run waitfram-hide.
      574      end.
      575   procedure waitfram-join :
      576     define input  parameter p-line-1  as character no-undo .
      577     define input  parameter p-line-2  as character no-undo .
      578     define input  parameter p-line-3  as character no-undo .
      579     define output parameter p-message as character no-undo .
      580     do
      581     on error undo, return error return-value
      582     :
      583       assign
      584         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      585                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      586                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      587       .
      588     end.
      589   end procedure.
      590   function waitfram-join-function returns character
      591     (input p-line-1 as character
      592     ,input p-line-2 as character
      593     ,input p-line-3 as character
      594     ).
      595     define variable v-message as character no-undo .
      596     run waitfram-join in this-procedure
      597       (input  p-line-1
      598       ,input  p-line-2
      599       ,input  p-line-3
      600       ,output v-message
      601       ) .
      602     return v-message .
      603   end function .
      604   procedure proc-alt-shift-f2:
      605     if not ibs.th.gbl.gbl-var:rcode
      606   then
      607     run gbl\inidebug.p .
      608   end.
      609   procedure proc-alt-shift-f3:
      610     run gbl/prvssinf.p
      611       ( input this-procedure
      612       ) .
      613   end.
      614   define variable v-inform-launched as logical no-undo initial false .
      615   procedure proc-alt-shift-f4:
      616     define variable v-action as character no-undo .
      617     if v-inform-launched = false then do:
      618       assign
      619         v-inform-launched = true
      620       .
      621       run gbl/d-inform.w
      622         (  input self
      623         ,  input this-procedure
      624         , output v-action
      625         ) no-error .
      626       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      627       assign
      628         v-inform-launched = false
      629       .
      630     end.
      631   end.
      632   procedure proc-alt-f1:
      633     run gbl/corrhelp.p
      634       (input this-procedure
      635       ) .
      636   end .
