        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter from-date as date no-undo .
        5   define input parameter to-date as date no-undo .
        6   define input parameter gds-art as char no-undo.
        7   define input parameter num-doc as char no-undo.
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define new global shared variable g#library  as handle no-undo .
       13   define new global shared variable g#library2 as handle no-undo .
       14   define new global shared variable g#lib-trn  as handle no-undo .
       15   define new global shared variable g#lib-trn2 as handle no-undo .
       16   define new global shared variable g#lib-trn3 as handle no-undo .
       17   define new global shared variable g#lib-trn4 as handle no-undo .
       18   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       19   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       20   define  shared variable RepPathName        as character no-undo .
       21   define  shared variable PrintRubl          as logical   no-undo .
       22   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       23   define  stream PrnLibStream.
       24   procedure prn-lib-prn-file :
       25     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       26     define input parameter p-DIsabledoptions as integer no-undo .
       27     define variable v-report-name as character no-undo .
       28     define variable v-user-action as character no-undo .
       29     define variable v-printed     as logical   no-undo .
       30     define variable v-exist       as logical   no-undo .
       31     do
       32       on error undo, return error
       33       :
       34       run prn-lib-get-report-name  in this-procedure (
       35         input parParentProc
       36         ,output v-report-name
       37         ).
       38   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       39   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       40     (input  v-report-name
       41     ,input  2
       42     ,output v-exist
       43     )  .
       44       if NOT v-exist then
       45       DO:
       46         Message
       47           "Нет заданий на печать ! "
       48           view-as alert-box .
       49         Return  .
       50       End.
       51       run gbl/prnfilen.w
       52         (input  ""
       53         ,input  p-DisabledOptions
       54         ,input  string(v-report-name )
       55         ,input  7
       56         ,output v-user-action
       57         ,output v-printed
       58         ) .
       59       if v-printed then
       60       do:
       61         return "YES" .
       62       end.
       63       else
       64       do:
       65         return "NO" .
       66       end.
       67     end.
       68   end procedure.
       69   procedure prn-lib-open-stream :
       70     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       71     define input parameter p-page-size    as integer no-undo .
       72     define input parameter p-is-stream    as logical no-undo .
       73     define input parameter p-append       as logical no-undo .
       74     define variable v-report-name as character no-undo .
       75     do
       76       on error undo, return error
       77       :
       78       run prn-lib-get-report-name  in this-procedure (
       79         input parParentProc
       80         ,output v-report-name
       81         ).
       82       if p-is-stream then
       83       do:
       84         if p-append then
       85         do:
       86           output stream PrnLibStream to value( v-report-name )
       87             page-size value(p-page-size) append .
       88         end.
       89         if not p-append then
       90         do:
       91           output stream PrnLibStream to value( v-report-name )
       92             page-size value(p-page-size) .
       93         end.
       94       end.
       95       if not p-is-stream then
       96       do:
       97         if p-append then
       98         do:
       99           output to value( v-report-name )
      100             page-size value(p-page-size) append .
      101         end.
      102         if not p-append then
      103         do:
      104           output to value( v-report-name )
      105             page-size value(p-page-size) .
      106         end.
      107       end.
      108     end.
      109   end procedure.
      110   procedure prn-lib-open-exp :
      111     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      112     define input parameter p-is-stream    as logical no-undo .
      113     define input parameter p-is-append    as logical no-undo .
      114     define output parameter p-ReportFileName as char init "report" no-undo.
      115     define output parameter p-process as logical no-undo .
      116     define variable glog as logical no-undo .
      117     do
      118       on error undo, return error
      119       :
      120       SYSTEM-DIALOG GET-FILE p-ReportFileName
      121         TITLE      "Укажите путь"
      122         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      123         ASK-OVERWRITE
      124         CREATE-TEST-FILE
      125         SAVE-AS
      126         USE-FILENAME
      127         DEFAULT-EXTENSION "txt"
      128         UPDATE glog
      129         .
      130       if not glog then  return.
      131       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      132       if p-is-stream then
      133       do:
      134         if p-is-append then
      135         do:
      136           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      137         end.
      138         else
      139         do:
      140           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      141         end.
      142       end.
      143       else
      144       do:
      145         if p-is-append then
      146         do:
      147           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      148         end.
      149         else
      150         do:
      151           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      152         end.
      153       end.
      154       p-process = yes.
      155     end.
      156   end procedure.
      157   procedure prn-lib-get-report-name :
      158     define input parameter parParentProc  as widget-handle no-undo.
      159     define output parameter p-report-name as character no-undo .
      160     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      161   end procedure.
      162   procedure prn-lib-reportviewer-report-name :
      163     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      164     define input parameter p-report-name-html as character no-undo .
      165     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      166   end procedure.
      167   procedure prn-lib-reportviewer :
      168     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      169     define input parameter p-report-name-html as character no-undo .
      170     define input parameter p-param        as character no-undo .
      171     define variable v-excel           as character no-undo init 'TRUE' .
      172     define variable v-value-character as character no-undo .
      173     define variable v-value-integer   as character no-undo .
      174     define variable v-value-date      as date      no-undo .
      175     define variable v-value-decimal   as decimal   no-undo .
      176     define variable rep-excel         as logical   no-undo .
      177     define variable excel-string      as character no-undo .
      178     define variable v-param-type      as character no-undo .
      179     define variable v-tth             as handle    no-undo .
      180     run adm/shattri.p (
      181       input "get":U
      182       ,input  ""
      183       ,input  0
      184       ,input  'report-glob':U
      185       ,input  'rep-excel':U
      186       ,output v-value-character
      187       ,output v-value-date
      188       ,output v-value-decimal
      189       ,output v-value-integer
      190       ,output rep-excel
      191       ,output v-param-type
      192       ,INPUT-OUTPUT table-handle v-tth
      193       )  .
      194     if rep-excel then v-excel = "TRUE" .
      195     else v-excel = "FALSE" .
      196     if p-param eq ""
      197     then
      198        p-param = "EXCEL:" + v-excel.
      199     else
      200        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      201     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      202   end procedure.
