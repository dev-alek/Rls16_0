     2494     ASSIGN  transport-base-loc = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
     2495             transport-rubl-loc = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
     2496             other-base-loc     = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
     2497             other-rubl-loc     = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
     2498             vat-pc-loc         = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
     2499             slt-pc-loc         = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
     2500             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2501       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2502     assign
     2503       exch-rate-cli-loc = (ub.parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / ub.parts.price-cli .
     2504     assign
     2505       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2506       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2507       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2508       transport-cli-loc  = 0
     2509       other-cli-loc      = 0
     2510     .
     2511   ASSIGN
     2512             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2513       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2514   .
     2515   ACCUMULATE
     2516       ub.parts.fact-qnty (TOTAL)
     2517       ub.parts.fact-qnty * ub.parts.price-rubl (TOTAL)
     2518       ub.parts.fact-qnty * ub.parts.price-base (TOTAL)
     2519       out-qnty (TOTAL)
     2520       out-qnty * ub.parts.price-rubl (TOTAL)
     2521       out-qnty * ub.parts.price-base (TOTAL)
     2522       free-qnty (TOTAL)
     2523       free-qnty * vat-rubl-loc (TOTAL)
     2524       free-qnty * vat-base-loc (TOTAL)
     2525       free-qnty * price-rubl-with-tax-loc (TOTAL)
     2526       free-qnty * price-base-with-tax-loc (TOTAL)
     2527       .
     2528   CREATE suppl-parts.
     2529   assign
     2530       suppl-parts.num-doc = num-doc
     2531       suppl-parts.artic = ub.parts.artic
     2532       suppl-parts.prod-type = ub.parts.prod-type
     2533       suppl-parts.prod-code = ub.parts.prod-code
     2534       suppl-parts.gds-code = ub.goods.gds-code
     2535       suppl-parts.gds-name = ub.goods.gds-name
     2536       suppl-parts.doc-type = ub.parts.doc-type
     2537       suppl-parts.in-code = ub.parts.in-code
     2538       suppl-parts.out-code = ub.parts.out-code
     2539       suppl-parts.fact-date = ub.parts.fact-date
     2540       suppl-parts.price0-base = ub.parts.price-base
     2541       suppl-parts.price0-rubl = ub.parts.price-rubl
     2542       suppl-parts.price-cli = ub.parts.price-cli / ub.parts.cli-base-rate
     2543       suppl-parts.obj-type = ub.parts.obj-type
     2544       suppl-parts.obj-code = ub.parts.obj-code
     2545       suppl-parts.part-code = ub.parts.part-code
     2546       suppl-parts.in-qnty = ub.parts.fact-qnty
     2547       suppl-parts.in-sum0-rubl = ub.parts.fact-qnty * ub.parts.price-rubl
     2548       suppl-parts.in-sum0-base = ub.parts.fact-qnty * ub.parts.price-base
     2549       suppl-parts.in-sum-cli = ub.parts.fact-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     2550       suppl-parts.out-qnty = out-qnty
     2551       suppl-parts.out-sum0-rubl = out-qnty * ub.parts.price-rubl
     2552       suppl-parts.out-sum0-base = out-qnty * ub.parts.price-base
     2553       suppl-parts.out-sum-cli = out-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     2554       suppl-parts.free-qnty = free-qnty
     2555       suppl-parts.free-NDS0-rubl = free-qnty * vat-rubl-loc
     2556       suppl-parts.free-NDS0-base = free-qnty * vat-base-loc
     2557       suppl-parts.free-sum0-rubl = free-qnty * price-rubl-with-tax-loc
     2558       suppl-parts.free-sum0-base = free-qnty * price-base-with-tax-loc
     2559       suppl-parts.free-sum-cli = free-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     2560       suppl-parts.qnty-sale = qnty_sale
     2561       suppl-parts.fs-date = ub.parts.fact-date
     2562       suppl-parts.ls-date = l-date
     2563       .
     2564           end.
     2565       end.
     2566       else do:
     2567           for each ub.parts where
     2568                     ub.parts.host-code = v-host-code
     2569                 and ub.parts.supp-type = supplier.obj-type
     2570                 and ub.parts.supp-code = supplier.obj-code
     2571                 and ub.parts.status_   = yes
     2572                 and ub.parts.out-code  = ub.parts.in-code
     2573                 and ub.parts.out-code  = num-doc
     2574               no-lock break by ub.parts.fact-date:
     2575     find ub.goods where
     2576         ub.goods.artic = ub.parts.artic
     2577     and ub.goods.prod-type = ub.parts.prod-type
     2578     and ub.goods.prod-code = ub.parts.prod-code
     2579     no-lock.
     2580   assign
     2581       l-date = ub.parts.fact-date
     2582       qnty_sale = 0
     2583       .
     2584   if FIRST( ub.parts.fact-date ) then
     2585       assign prev-exch-code = ub.parts.exch-code.
     2586   if prev-exch-code <> ? and prev-exch-code <> ub.parts.exch-code then
     2587       assign prev-exch-code = ?.
     2588   FOR EACH b-parts WHERE b-parts.artic = ub.parts.artic
     2589                                               AND b-parts.prod-type = ub.parts.prod-type
     2590                                               AND b-parts.prod-code = ub.parts.prod-code
     2591                                               AND b-parts.status_ = yes
     2592                                               AND b-parts.doc-type = 'рас':U NO-LOCK,
     2593       each  ub.parts-attr where
     2594             ub.parts-attr.gds-code  = ub.goods.gds-code and
     2595             ub.parts-attr.in-code   = b-parts.in-code and
     2596             ub.parts-attr.part-code = b-parts.part-code and
     2597             ub.parts-attr.income-in-code = num-doc no-lock ,
     2598        EACH ub.trn-doc WHERE ub.trn-doc.doc-code = b-parts.out-code
     2599                                               AND ub.trn-doc.internal = no NO-LOCK
     2600                                               BREAK BY b-parts.fact-date:
     2601       if LAST-OF( b-parts.fact-date ) then
     2602           assign qnty_sale = qnty_sale + 1.
     2603       if LAST( b-parts.fact-date ) AND l-date - 1 < b-parts.fact-date then
     2604           assign l-date = b-parts.fact-date + 1.
     2605   END.
     2606   FOR EACH b-parts WHERE b-parts.artic = ub.parts.artic
     2607                        AND b-parts.prod-type = ub.parts.prod-type
     2608                        AND b-parts.prod-code = ub.parts.prod-code
     2609                        AND b-parts.out-code = 'out-zone':U
     2610                        NO-LOCK,
     2611       each  ub.parts-attr where
     2612             ub.parts-attr.gds-code  = ub.goods.gds-code and
     2613             ub.parts-attr.in-code   = b-parts.in-code and
     2614             ub.parts-attr.part-code = b-parts.part-code and
     2615             ub.parts-attr.income-in-code = num-doc no-lock
     2616                        :
     2617       ACCUMULATE b-parts.fact-qnty (TOTAL).
     2618   END.
     2619   assign out-qnty = (ACCUM TOTAL b-parts.fact-qnty) .
     2620   FOR EACH b-parts WHERE b-parts.artic = ub.parts.artic
     2621                          AND b-parts.prod-type = ub.parts.prod-type
     2622                          AND b-parts.prod-code = ub.parts.prod-code
     2623                          AND b-parts.rsrv-free = yes
     2624                          NO-LOCK  ,
     2625       each  ub.parts-attr where
     2626             ub.parts-attr.gds-code  = ub.goods.gds-code and
     2627             ub.parts-attr.in-code   = b-parts.in-code and
     2628             ub.parts-attr.part-code = b-parts.part-code and
     2629             ub.parts-attr.income-in-code = num-doc no-lock
     2630                          :
     2631       ACCUMULATE b-parts.fact-qnty (TOTAL).
     2632   END.
     2633   assign free-qnty = (ACCUM TOTAL b-parts.fact-qnty) .
     2634   FOR EACH b-parts WHERE b-parts.artic = ub.parts.artic
     2635                                               AND b-parts.prod-type = ub.parts.prod-type
     2636                                               AND b-parts.prod-code = ub.parts.prod-code
     2637                                               AND b-parts.status_ = no
     2638                                               AND b-parts.doc-type = 'при':U NO-LOCK,
     2639       each  ub.parts-attr where
     2640             ub.parts-attr.gds-code  = ub.goods.gds-code and
     2641             ub.parts-attr.in-code   = b-parts.in-code and
     2642             ub.parts-attr.part-code = b-parts.part-code and
     2643             ub.parts-attr.income-in-code = num-doc no-lock ,
     2644           EACH ub.trn-doc WHERE ub.trn-doc.doc-code = b-parts.out-code
     2645                                               AND ub.trn-doc.internal = yes NO-LOCK:
     2646       ACCUMULATE b-parts.qnty (TOTAL).
     2647   END.
     2648   assign free-qnty = free-qnty + (ACCUM TOTAL b-parts.qnty) .
     2649   FOR EACH b-parts WHERE b-parts.artic = ub.parts.artic
     2650                                               AND b-parts.prod-type = ub.parts.prod-type
     2651                                               AND b-parts.prod-code = ub.parts.prod-code
     2652                                               AND b-parts.status_ = no
     2653                                               AND b-parts.doc-type = 'возврат':U NO-LOCK,
     2654       each  ub.parts-attr where
     2655             ub.parts-attr.gds-code  = ub.goods.gds-code and
     2656             ub.parts-attr.in-code   = b-parts.in-code and
     2657             ub.parts-attr.part-code = b-parts.part-code and
     2658             ub.parts-attr.income-in-code = num-doc no-lock ,
     2659           EACH ub.trn-doc WHERE ub.trn-doc.doc-code = b-parts.out-code
     2660                                               AND ub.trn-doc.internal = yes NO-LOCK:
     2661       ACCUMULATE b-parts.qnty (TOTAL).
     2662   END.
     2663   assign free-qnty = free-qnty + (ACCUM TOTAL b-parts.qnty) .
     2664   if free-qnty > 0 then
     2665       assign l-date = TODAY + 1.
     2666   assign
     2667     price-rubl-with-tax-loc = ub.parts.price-rubl
     2668     price-base-with-tax-loc = ub.parts.price-base
     2669   .
     2670   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2671   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2672     (output varinvprb
     2673     )  .
     2674     if ub.parts.out-code = 'free-zone':U     or
     2675        ub.parts.out-code = 'out-zone':U   or
     2676        ub.parts.doc-type = 'акт':U then do:
     2677       assign
     2678         in-vatp-have-vat-slt = yes.
     2679     end.
     2680     else do:
     2681       find first in-vatp_doc-attr no-lock
     2682         where in-vatp_doc-attr.doc-code  = ub.parts.out-code
     2683           and in-vatp_doc-attr.attr-code = 'envd':U
     2684         no-error .
     2685       if not available in-vatp_doc-attr then do:
     2686         assign
     2687           in-vatp-have-vat-slt = yes.
     2688       end.
     2689       else do:
     2690            in-vatp-have-vat-slt = no.
     2691       end.
     2692     end.
     2693     assign
     2694      price-cli-with-tax-loc = ub.parts.price-cli
     2695      cli-base-rate          = ub.parts.cli-base-rate.
     2696     ASSIGN   road-tax-base-loc  = (if ub.parts.road-tax-base  = ? then 0 else ub.parts.road-tax-base)
     2697              road-tax-rubl-loc  = (if ub.parts.road-tax-rubl  = ? then 0 else ub.parts.road-tax-rubl).
     2698     ASSIGN  transport-base-loc = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
     2699             transport-rubl-loc = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
     2700             other-base-loc     = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
     2701             other-rubl-loc     = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
     2702             vat-pc-loc         = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
     2703             slt-pc-loc         = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
     2704             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2705       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2706     assign
     2707       exch-rate-cli-loc = (ub.parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / ub.parts.price-cli .
     2708     assign
     2709       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2710       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2711       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2712       transport-cli-loc  = 0
     2713       other-cli-loc      = 0
     2714     .
     2715   ASSIGN
     2716             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2717       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2718   .
     2719   ACCUMULATE
     2720       ub.parts.fact-qnty (TOTAL)
     2721       ub.parts.fact-qnty * ub.parts.price-rubl (TOTAL)
     2722       ub.parts.fact-qnty * ub.parts.price-base (TOTAL)
     2723       out-qnty (TOTAL)
     2724       out-qnty * ub.parts.price-rubl (TOTAL)
     2725       out-qnty * ub.parts.price-base (TOTAL)
     2726       free-qnty (TOTAL)
     2727       free-qnty * vat-rubl-loc (TOTAL)
     2728       free-qnty * vat-base-loc (TOTAL)
     2729       free-qnty * price-rubl-with-tax-loc (TOTAL)
     2730       free-qnty * price-base-with-tax-loc (TOTAL)
     2731       .
     2732   CREATE suppl-parts.
     2733   assign
     2734       suppl-parts.num-doc = num-doc
     2735       suppl-parts.artic = ub.parts.artic
     2736       suppl-parts.prod-type = ub.parts.prod-type
     2737       suppl-parts.prod-code = ub.parts.prod-code
     2738       suppl-parts.gds-code = ub.goods.gds-code
     2739       suppl-parts.gds-name = ub.goods.gds-name
     2740       suppl-parts.doc-type = ub.parts.doc-type
     2741       suppl-parts.in-code = ub.parts.in-code
     2742       suppl-parts.out-code = ub.parts.out-code
     2743       suppl-parts.fact-date = ub.parts.fact-date
     2744       suppl-parts.price0-base = ub.parts.price-base
     2745       suppl-parts.price0-rubl = ub.parts.price-rubl
     2746       suppl-parts.price-cli = ub.parts.price-cli / ub.parts.cli-base-rate
     2747       suppl-parts.obj-type = ub.parts.obj-type
     2748       suppl-parts.obj-code = ub.parts.obj-code
     2749       suppl-parts.part-code = ub.parts.part-code
     2750       suppl-parts.in-qnty = ub.parts.fact-qnty
     2751       suppl-parts.in-sum0-rubl = ub.parts.fact-qnty * ub.parts.price-rubl
     2752       suppl-parts.in-sum0-base = ub.parts.fact-qnty * ub.parts.price-base
     2753       suppl-parts.in-sum-cli = ub.parts.fact-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     2754       suppl-parts.out-qnty = out-qnty
     2755       suppl-parts.out-sum0-rubl = out-qnty * ub.parts.price-rubl
     2756       suppl-parts.out-sum0-base = out-qnty * ub.parts.price-base
     2757       suppl-parts.out-sum-cli = out-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     2758       suppl-parts.free-qnty = free-qnty
     2759       suppl-parts.free-NDS0-rubl = free-qnty * vat-rubl-loc
     2760       suppl-parts.free-NDS0-base = free-qnty * vat-base-loc
     2761       suppl-parts.free-sum0-rubl = free-qnty * price-rubl-with-tax-loc
     2762       suppl-parts.free-sum0-base = free-qnty * price-base-with-tax-loc
     2763       suppl-parts.free-sum-cli = free-qnty * ub.parts.price-cli / ub.parts.cli-base-rate
     2764       suppl-parts.qnty-sale = qnty_sale
     2765       suppl-parts.fs-date = ub.parts.fact-date
     2766       suppl-parts.ls-date = l-date
     2767       .
     2768           end.
     2769       end.
     2770   end.
     2771   assign
     2772       tot-in-qnty = (ACCUM TOTAL ub.parts.fact-qnty)
     2773       tot-in-sum0-rubl = (ACCUM TOTAL ub.parts.fact-qnty * ub.parts.price-rubl)
     2774       tot-in-sum0-base = (ACCUM TOTAL ub.parts.fact-qnty * ub.parts.price-base)
     2775       tot-out-qnty = (ACCUM TOTAL out-qnty)
     2776       tot-out-sum0-rubl = (ACCUM TOTAL out-qnty * ub.parts.price-rubl)
     2777       tot-out-sum0-base = (ACCUM TOTAL out-qnty * ub.parts.price-base)
     2778       tot-free-qnty = (ACCUM TOTAL free-qnty)
     2779       tot-free-sum0-rubl = (ACCUM TOTAL free-qnty * price-rubl-with-tax-loc)
     2780       tot-free-sum0-base = (ACCUM TOTAL free-qnty * price-base-with-tax-loc)
     2781       .
     2782   if session:set-wait-state("") then.
     2783   run waitfram-hide in this-procedure .
     2784   END PROCEDURE.
     2785   PROCEDURE disable_UI :
     2786     HIDE FRAME vs-parts.
     2787   END PROCEDURE.
     2788   PROCEDURE enable_UI :
     2789     DISPLAY tot-in-qnty tot-out-qnty tot-free-qnty tot-in-sum0-rubl
     2790             tot-out-sum0-rubl tot-free-sum0-rubl tot-in-sum0-base
     2791             tot-out-sum0-base tot-free-sum0-base
     2792         WITH FRAME vs-parts.
     2793     ENABLE b-quit b-print b-docs b-help br-parts
     2794         WITH FRAME vs-parts.
     2795     VIEW FRAME vs-parts.
     2796     OPEN QUERY br-parts FOR EACH suppl-parts NO-LOCK,            EACH ub.goods WHERE ub.goods.artic = suppl-parts.artic                      AND ub.goods.prod-type = suppl-parts.prod-type                      AND ub.goods.prod-code = suppl-parts.prod-code NO-LOCK     BY ub.goods.artic BY ub.goods.prod-type BY ub.goods.prod-code BY ub.goods.grp-name BY suppl-parts.in-code.
     2797   END PROCEDURE.
     2798   PROCEDURE print-cycle :
     2799       define input parameter val-type as char no-undo.
     2800       define variable  object as char no-undo.
     2801       define variable  PartCode LIKE ub.parts.part-code no-undo.
     2802       define variable  price0 LIKE ub.parts.price-rubl no-undo.
     2803       define variable  in-sum0 LIKE ub.parts.price-rubl no-undo.
     2804       define variable  out-sum0 LIKE ub.parts.price-rubl no-undo.
     2805       define variable  free-sum0 LIKE ub.parts.price-rubl no-undo.
     2806       define variable  sym1 as char init ":"   no-undo.
     2807       define variable  sym2 as char init ":"   no-undo.
     2808       define variable  sym3 as char init ":"   no-undo.
     2809       define variable  sym4 as char init ":"   no-undo.
     2810       define variable  sym5 as char init ":"   no-undo.
     2811       define variable  sym6 as char init ":"   no-undo.
     2812       define variable  sym7 as char init ":"   no-undo.
     2813       define variable  sym8 as char init ":"   no-undo.
     2814       define variable  sym9 as char init ":"   no-undo.
     2815       define variable  sym10 as char init ":"   no-undo.
     2816       define variable  sym11 as char init ":"   no-undo.
     2817       define variable  sym12 as char init ":"   no-undo.
     2818       define variable  sym13 as char init ":"   no-undo.
     2819       define variable  Line as char no-undo.
     2820       define variable base-type as character no-undo .
     2821       define variable v-base-code like ub.sysconf.base-code no-undo .
     2822       define variable v-host-code like ub.sysconf.host-code no-undo .
     2823       define buffer buf_rep_currency for ub.currency.
     2824   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2825   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2826     (input  p-curr-obj-type
     2827     ,input  p-curr-obj-code
     2828     ,output v-host-code
     2829     )  .
     2830   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2831   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2832     (input  v-host-code
     2833     ,output v-base-code
     2834     )  .
     2835       find first buf_rep_currency no-lock
     2836       where buf_rep_currency.curr-code = v-base-code
     2837       no-error .
     2838       if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     2839                   else base-type = "б.в." .
     2840       DEFINE FRAME supp-gds
     2841             sym1 column-label ":!:" format "X(1)" space(0)
     2842             suppl-parts.gds-name COLUMN-LABEL "Наименование!товара" FORMAT "x(40)" space(0)
     2843             sym2 column-label ":!:" format "X(1)" space(0)
     2844             suppl-parts.in-code COLUMN-LABEL "№ ПН! " FORMAT "x(16)" space(0)
     2845             sym3 column-label ":!:" format "X(1)" space(0)
     2846             suppl-parts.fact-date COLUMN-LABEL "Дата!прихода" FORMAT "99/99/99" space(0)
     2847             sym4 column-label ":!:" format "X(1)" space(0)
     2848             price0 COLUMN-LABEL "Учетная!цена" FORMAT "->>,>>9.99"  space(0)
     2849             sym5 column-label ":!:" format "X(1)" space(0)
     2850             suppl-parts.in-qnty COLUMN-LABEL "Приход!    количество" FORMAT "->,>>>,>>9.<<<" space(0)
     2851             sym6 column-label ":!:" format "X(1)" space(0)
     2852             in-sum0 COLUMN-LABEL "Приход сумма!учетных цен" FORMAT "->>>,>>>,>>9.99" space(0)
     2853             sym7 column-label ":!:" format "X(1)" space(0)
     2854             suppl-parts.out-qnty COLUMN-LABEL "Расход!    количество" FORMAT "->,>>>,>>9.<<<" space(0)
     2855             sym8 column-label ":!:" format "X(1)" space(0)
     2856             out-sum0 COLUMN-LABEL "Расход сумма!учетных цен" FORMAT "->>>,>>>,>>9.99" space(0)
     2857             sym9 column-label ":!:" format "X(1)" space(0)
     2858             suppl-parts.free-qnty COLUMN-LABEL "Остаток!    количество" FORMAT "->,>>>,>>9.<<<" space(0)
     2859             sym10 column-label ":!:" format "X(1)" space(0)
     2860             free-sum0 COLUMN-LABEL "Остаток сумма!учетных цен" FORMAT "->>>,>>>,>>9.99" space(0)
     2861             sym11 column-label ":!:" format "X(1)" space(0)
     2862             object COLUMN-LABEL "Объект! " FORMAT "x(10)"  space(0)
     2863             sym12 column-label ":!:" format "X(1)" space(0)
     2864             PartCode COLUMN-LABEL "Партия! " FORMAT "x(14)" space(0)
     2865             sym13 column-label ":!:" format "X(1)" space(0)
     2866           HEADER
     2867               string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") ) AT 5 format "X(35)"
     2868               string( "Отчет по поставщику: " + supplier.obj-name ) AT 45 format "X(71)"
     2869               string( "Cуммы указаны в " + (if val-type = "rubl" then "руб" else (if val-type = "base" then base-type else cli-val ) ) ) AT 145 format "X(20)"
     2870               string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 170 format "X(13)" SKIP
     2871               Line format "X(198)" AT 1
     2872           with width 232 down stream-io.
     2873       if session:set-wait-state("COMPILER") then.
     2874       assign Line = fill("-", 232).
     2875       run prn-lib-open-stream  in this-procedure (
     2876                                                   input parParentProc
     2877                                                   ,input 43
     2878                                                   ,input yes
     2879                                                   ,input no
     2880                                                   ).
     2881       FORM with FRAME supp-gds.
     2882       FORM HEADER
     2883           Line format "X(198)" AT 1 SKIP
     2884           "Продолжение - на следующей странице" AT 60 SKIP
     2885           with FRAME BottomFrame width 232
     2886           PAGE-BOTTOM no-labels no-box.
     2887       VIEW STREAM PrnLibStream FRAME BottomFrame .
     2888       PUT STREAM PrnLibStream string( "П Р И Х О Д Н Ы Е   П А Р Т И И   за период с: " + string(from-date,"99/99/9999") +
     2889                                                             " по: " + string(to-date,"99/99/9999") )
     2890                                                      AT 62 format "X(198)"
     2891                                                  SKIP(1)
     2892                                                  string( "ПОСТАВЩИК: " + supplier.obj-name +
     2893                                                             " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" )
     2894                                                      AT 10 format "X(198)"
     2895                                                  SKIP.
     2896       if gds-art = "" then
     2897           PUT STREAM PrnLibStream string( "ТОВАР: " + suppl-gds.artic + ' "' + suppl-gds.gds-name + '"' )
     2898                                                          AT 14 format "X(198)"
     2899                                                      SKIP.
     2900       PUT STREAM PrnLibStream " " SKIP.
     2901       FOR EACH suppl-parts NO-LOCK BREAK BY suppl-parts.artic BY suppl-parts.prod-type BY suppl-parts.prod-code BY suppl-parts.in-code:
     2902           CASE val-type:
     2903               WHEN "rubl" THEN
     2904                   assign
     2905                       price0 = suppl-parts.price0-rubl
     2906                       in-sum0 = suppl-parts.in-sum0-rubl
     2907                       out-sum0 = suppl-parts.out-sum0-rubl
     2908                       free-sum0 = suppl-parts.free-sum0-rubl
     2909                       .
     2910               WHEN "base" THEN
     2911                   assign
     2912                       price0 = suppl-parts.price0-base
     2913                       in-sum0 = suppl-parts.in-sum0-base
     2914                       out-sum0 = suppl-parts.out-sum0-base
     2915                       free-sum0 = suppl-parts.free-sum0-base
     2916                       .
     2917               WHEN "cli" THEN
     2918                   assign
     2919                       price0 = suppl-parts.price-cli
     2920                       in-sum0 = suppl-parts.in-sum-cli
     2921                       out-sum0 = suppl-parts.out-sum-cli
     2922                       free-sum0 = suppl-parts.free-sum-cli
     2923                       .
     2924           END CASE.
     2925           DISPLAY STREAM PrnLibStream
     2926               sym1 suppl-parts.in-code
     2927               sym2 string( suppl-parts.artic + " " + suppl-parts.gds-name ) @ suppl-parts.gds-name
     2928               sym3 suppl-parts.fact-date
     2929               sym4 price0
     2930               sym5 suppl-parts.in-qnty
     2931               sym6 in-sum0
     2932               sym7 suppl-parts.out-qnty
     2933               sym8 out-sum0
     2934               sym9 suppl-parts.free-qnty
     2935               sym10 free-sum0
     2936               sym11 (suppl-parts.obj-type + " " + STRING (suppl-parts.obj-code)) @ object
     2937               sym12 (if suppl-parts.part-code = "" then "------" else suppl-parts.part-code) @ PartCode
     2938               sym13
     2939               with FRAME supp-gds .
     2940           DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     2941           ACCUMULATE
     2942               suppl-parts.in-qnty (TOTAL)
     2943               in-sum0 (TOTAL)
     2944               suppl-parts.out-qnty (TOTAL)
     2945               out-sum0 (TOTAL)
     2946               suppl-parts.free-qnty (TOTAL)
     2947               free-sum0 (TOTAL)
     2948               suppl-parts.prod-code (SUB-COUNT BY suppl-parts.prod-code)
     2949               suppl-parts.in-qnty (SUB-TOTAL BY suppl-parts.prod-code)
     2950               in-sum0 (SUB-TOTAL BY suppl-parts.prod-code)
     2951               suppl-parts.out-qnty (SUB-TOTAL BY suppl-parts.prod-code)
     2952               out-sum0 (SUB-TOTAL BY suppl-parts.prod-code)
     2953               suppl-parts.free-qnty (SUB-TOTAL BY suppl-parts.prod-code)
     2954               free-sum0 (SUB-TOTAL BY suppl-parts.prod-code)
     2955               .
     2956           if LAST-OF( suppl-parts.prod-code ) then
     2957               do:
     2958                   if (ACCUM SUB-COUNT BY suppl-parts.prod-code suppl-parts.prod-code) > 1 then
     2959                       do:
     2960                           DISPLAY STREAM PrnLibStream
     2961                               sym1
     2962                               sym2 string( "  Итого по товару" ) @ suppl-parts.gds-name
     2963                               sym3 sym4
     2964                               sym5 (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.in-qnty) @ suppl-parts.in-qnty
     2965                               sym6 (ACCUM SUB-TOTAL BY suppl-parts.prod-code in-sum0) @ in-sum0
     2966                               sym7 (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.out-qnty) @ suppl-parts.out-qnty
     2967                               sym8 (ACCUM SUB-TOTAL BY suppl-parts.prod-code out-sum0) @ out-sum0
     2968                               sym9 (ACCUM SUB-TOTAL BY suppl-parts.prod-code suppl-parts.free-qnty) @ suppl-parts.free-qnty
     2969                               sym10 (ACCUM SUB-TOTAL BY suppl-parts.prod-code free-sum0) @ free-sum0
     2970                               sym11 sym12 sym13
     2971                               with FRAME supp-gds .
     2972                           DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     2973                       end.
     2974                   DISPLAY STREAM PrnLibStream
     2975                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     2976                       with FRAME supp-gds .
     2977                   DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     2978               end.
     2979       END.
     2980       PUT STREAM PrnLibStream Line format "X(198)" SKIP.
     2981       DISPLAY STREAM PrnLibStream
     2982           "Итого" @ price0
     2983           (ACCUM TOTAL suppl-parts.in-qnty) @ suppl-parts.in-qnty
     2984           (ACCUM TOTAL in-sum0) @ in-sum0
     2985           (ACCUM TOTAL suppl-parts.out-qnty) @ suppl-parts.out-qnty
     2986           (ACCUM TOTAL out-sum0) @ out-sum0
     2987           (ACCUM TOTAL suppl-parts.free-qnty) @ suppl-parts.free-qnty
     2988           (ACCUM TOTAL free-sum0) @ free-sum0
     2989           with FRAME supp-gds .
     2990       DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     2991       HIDE STREAM PrnLibStream FRAME BottomFrame .
     2992       OUTPUT STREAM PrnLibStream CLOSE.
     2993       if session:set-wait-state("") then.
     2994       run prn-lib-prn-file in this-procedure (
     2995                                                 input parParentProc
     2996                                                 ,input 8
     2997                                                 ).
     2998       APPLY "ENTRY" TO BROWSE br-parts.
     2999   END PROCEDURE.
     3000   PROCEDURE print-order :
     3001     define variable  tb-code as char no-undo.
     3002     define variable  price0 LIKE ub.parts.price-rubl no-undo.
     3003     define variable  in-sum0 LIKE ub.parts.price-rubl no-undo.
     3004     define variable  free-noNDS0 LIKE ub.parts.price-rubl no-undo.
     3005     define variable  free-NDS0 LIKE ub.parts.price-rubl no-undo.
     3006     define variable  free-sum0 LIKE ub.parts.price-rubl no-undo.
     3007     define variable  resource as int init ? no-undo.
     3008     define variable  avrg-sale as decimal no-undo.
     3009     define variable  sum-price-s as decimal no-undo.
     3010     define variable  UpFact as decimal no-undo.
     3011     define variable  sym1 as char init ":"   no-undo.
     3012     define variable  sym2 as char init ":"   no-undo.
     3013     define variable  sym3 as char init ":"   no-undo.
     3014     define variable  sym4 as char init ":"   no-undo.
     3015     define variable  sym5 as char init ":"   no-undo.
     3016     define variable  sym6 as char init ":"   no-undo.
     3017     define variable  sym7 as char init ":"   no-undo.
     3018     define variable  sym8 as char init ":"   no-undo.
     3019     define variable  sym9 as char init ":"   no-undo.
     3020     define variable  sym10 as char init ":"   no-undo.
     3021     define variable  sym11 as char init ":"   no-undo.
     3022     define variable  sym12 as char init ":"   no-undo.
     3023     define variable  sym13 as char init ":"   no-undo.
     3024     define variable  sym14 as char init ":"   no-undo.
     3025     define variable  Line as char no-undo.
     3026     define variable base-type as character no-undo .
     3027     define variable v-base-code like ub.sysconf.base-code no-undo .
     3028     define variable v-host-code like ub.sysconf.host-code no-undo .
     3029     define buffer buf_rep_currency for ub.currency.
     3030   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3031   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3032     (input  p-curr-obj-type
     3033     ,input  p-curr-obj-code
     3034     ,output v-host-code
     3035     )  .
     3036   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3037   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3038     (input  v-host-code
     3039     ,output v-base-code
     3040     )  .
     3041     find first buf_rep_currency no-lock
     3042     where buf_rep_currency.curr-code = v-base-code
     3043     no-error .
     3044     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     3045                 else base-type = "б.в." .
     3046     DEFINE FRAME supp-gds
     3047           sym1 column-label ":!:" format "X(1)" space(0)
     3048           suppl-parts.in-code COLUMN-LABEL "№ ПН! " FORMAT "x(16)" space(0)
     3049           sym2 column-label ":!:" format "X(1)" space(0)
     3050           suppl-parts.fact-date COLUMN-LABEL "Дата!прихода" FORMAT "99/99/9999" space(0)
     3051           sym3 column-label ":!:" format "X(1)" space(0)
     3052           suppl-parts.in-qnty COLUMN-LABEL "Приход!    количество" FORMAT "->,>>>,>>9.<<<" space(0)
     3053           sym4 column-label ":!:" format "X(1)" space(0)
     3054           price0 COLUMN-LABEL "Учетная!цена" FORMAT "->>>,>>9.99"  space(0)
     3055           sym5 column-label ":!:" format "X(1)" space(0)
     3056           in-sum0 COLUMN-LABEL "Приход сумма!учетных цен" FORMAT "->>>,>>>,>>9.99" space(0)
     3057           sym6 column-label ":!:" format "X(1)" space(0)
     3058           resource COLUMN-LABEL "Обеспе-!ченность" FORMAT "->>>>>>9" space(0)
     3059           sym7 column-label ":!:" format "X(1)" space(0)
     3060           avrg-sale COLUMN-LABEL "Средние!продажи" FORMAT "->>>>>9"
     3061           sym8 column-label ":!:" format "X(1)"
     3062           suppl-parts.free-qnty COLUMN-LABEL "Остаток!    количество" FORMAT "->,>>>,>>9.<<<"
     3063           sym9 column-label ":!:" format "X(1)"
     3064           free-noNDS0 COLUMN-LABEL "Остаток сумма!уч. цен без НДС" FORMAT "->>>,>>>,>>9.99"
     3065           sym10 column-label ":!:" format "X(1)"
     3066           free-NDS0 COLUMN-LABEL "Остаток сумма!НДС" FORMAT "->>>,>>>,>>9.99"
     3067           sym11 column-label ":!:" format "X(1)"
     3068           free-sum0 COLUMN-LABEL "Остаток сумма!уч. цен c НДС" FORMAT "->>>,>>>,>>9.99"
     3069           sym12 column-label ":!:" format "X(1)"
     3070           sum-price-s COLUMN-LABEL "Остаток cумма!продажных цен" FORMAT "->>>,>>>,>>9.99"
     3071           sym13 column-label ":!:" format "X(1)"
     3072           UpFact COLUMN-LABEL "Наценка! " FORMAT "->>>,>>>,>>9.99%"
     3073           sym14 column-label ":!:" format "X(1)" space(0)
     3074         HEADER
     3075             string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") ) AT 5 format "X(35)"
     3076             string( "Отчет для заказа товаров от поставщика: " + supplier.obj-name ) AT 45 format "X(95)"
     3077             string( "Cуммы указаны в " + (if PrintRubl then "руб" else base-type) ) AT 145 format "X(20)"
     3078             string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 170 format "X(13)" SKIP
     3079             Line format "X(198)" AT 1
     3080         with width 232 down stream-io.
     3081     assign PrintRubl = yes .
     3082     if v-base-code <> 0 and var-report-r-b = "base" then
     3083         assign PrintRubl = no .
     3084     if session:set-wait-state("COMPILER") then.
     3085     assign Line = fill("-", 232).
     3086     run prn-lib-open-stream  in this-procedure (
     3087                                                 input parParentProc
     3088                                                 ,input 43
     3089                                                 ,input yes
     3090                                                 ,input no
     3091                                                 ).
     3092     FORM with FRAME supp-gds.
     3093     FORM HEADER
     3094         Line format "X(198)" AT 1 SKIP
     3095         "Продолжение - на следующей странице" AT 60 SKIP
     3096         with FRAME BottomFrame width 232
     3097         PAGE-BOTTOM no-labels no-box.
     3098     VIEW STREAM PrnLibStream FRAME BottomFrame .
     3099     if num-doc = "" then
     3100         PUT STREAM PrnLibStream string( "П Р И Х О Д Н Ы Е   П А Р Т И И   за период с: " + string(from-date,"99/99/9999") +
     3101                                                               " по: " + string(to-date,"99/99/9999") )
     3102                                                        AT 62 format "X(198)"
     3103                                                    SKIP(1)
     3104                                                    .
     3105     else
     3106         PUT STREAM PrnLibStream string( "П Р И Х О Д Н Ы Е   П А Р Т И И   по документу: " + num-doc + " от " + string( ub.trn-doc.fact-date, "99/99/9999" ) )
     3107                                                        AT 62 format "X(198)"
     3108                                                    SKIP(1)
     3109                                                    .
     3110     PUT STREAM PrnLibStream string( "ПОСТАВЩИК: " + supplier.obj-name +
     3111                                                           " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" )
     3112                                                    AT 10 format "X(198)"
     3113                                                  SKIP.
     3114     if gds-art = "" then
     3115         PUT STREAM PrnLibStream string( "ТОВАР: " + suppl-gds.artic + ' "' + suppl-gds.gds-name + '"' )
     3116                                                        AT 14 format "X(198)"
     3117                                                    SKIP.
     3118     PUT STREAM PrnLibStream " " SKIP.
     3119     FOR EACH suppl-parts NO-LOCK,
     3120             EACH ub.goods WHERE ub.goods.artic = suppl-parts.artic
     3121                                                AND ub.goods.prod-type = suppl-parts.prod-type
     3122                                                AND ub.goods.prod-code = suppl-parts.prod-code
     3123                                                NO-LOCK
     3124                                                BREAK BY ub.goods.grp-name BY ub.goods.artic BY ub.goods.prod-type BY ub.goods.prod-code BY suppl-parts.in-code:
     3125         FIND ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK.
     3126         FIND ub.bar-code WHERE ub.bar-code.gds-code = ub.goods.gds-code
     3127                         AND ub.bar-code.unit-cli = ub.goods.unit-base
     3128                         AND ub.bar-code.node-code = ub.gds-prt.node-code
     3129                         AND ub.bar-code.part-code = ""
     3130                         AND ub.bar-code.in-code = ""
     3131                         NO-LOCK.
     3132   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3133   gp-fact-order = 0 .
     3134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3135     (input  ub.goods.gds-code
     3136     ,input  ub.bar-code.node-code
     3137     ,output gp-b-code
     3138     ) no-error .
     3139   if error-status:error then do:
     3140     message
     3141       error-status :get-message(1) skip
     3142       return-value skip
     3143       view-as alert-box error .
     3144     return no-apply.
     3145   end.
     3146   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3148     (input  p-curr-obj-type
     3149     ,input  p-curr-obj-code
     3150     ,input  gp-b-code
     3151     ,input  0
     3152     ,input  gp-fact-order
     3153     ,output gp-doc-num
     3154     ,output gp-price-sale
     3155     ,output gp-road-tax
     3156     ,output gp-excise
     3157     ) no-error .
     3158   if error-status:error then do:
     3159     return no-apply.
     3160   end.
     3161   gp-price-sale-parts = gp-price-sale.
     3162   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3163   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     3164     (input  p-curr-obj-type
     3165     ,input  p-curr-obj-code
     3166     ,input  gp-b-code
     3167     ,input  0
     3168     ,input  gp-fact-order
     3169     ,output gp-doc-num
     3170     ,output gp-price-sale-parts
     3171     ,output gp-road-tax
     3172     ,output gp-excise
     3173     ) no-error .
     3174   if error-status:error then do:
     3175     return no-apply.
     3176   end.
     3177   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     3178       gp-price-sale = gp-price-sale-parts.
     3179    end.
     3180         assign
     3181             price0 = (if PrintRubl then suppl-parts.price0-rubl else suppl-parts.price0-base)
     3182             in-sum0 = (if PrintRubl then suppl-parts.in-sum0-rubl else suppl-parts.in-sum0-base)
     3183             free-sum0 = (if PrintRubl then suppl-parts.free-sum0-rubl else suppl-parts.free-sum0-base)
     3184             free-NDS0 = (if PrintRubl then suppl-parts.free-NDS0-rubl else suppl-parts.free-NDS0-base)
     3185             free-noNDS0 = free-sum0 - free-NDS0
     3186             avrg-sale = suppl-parts.out-qnty / (suppl-parts.ls-date - suppl-parts.fs-date)
     3187             resource = suppl-parts.free-qnty / avrg-sale
     3188             .
     3189         if FIRST-OF (ub.goods.grp-name) then
     3190             do:
     3191                 DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3192                 PUT STREAM PrnLibStream SPACE(20) string("Группа: " + ub.goods.grp-name) format "X(100)".
     3193             end.
     3194         if FIRST-OF (ub.goods.prod-code) then
     3195             do:
     3196                 DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3197                 PUT STREAM PrnLibStream
     3198                     SPACE(5)
     3199                     "Артикул: " ub.goods.artic format "X(16)"
     3200                     SPACE
     3201                     "Код: " string( ub.bar-code.b-code ) format "x(13)"
     3202                     SPACE
     3203                     suppl-parts.gds-name format "x(50)"
     3204                     .
     3205             end.
     3206         DISPLAY STREAM PrnLibStream
     3207             sym1 suppl-parts.in-code
     3208             sym2 suppl-parts.fact-date
     3209             sym3 suppl-parts.in-qnty
     3210             sym4 price0
     3211             sym5 in-sum0
     3212             sym6 resource
     3213             sym7 suppl-parts.free-qnty
     3214             sym8 avrg-sale
     3215             sym9 free-noNDS0
     3216             sym10 free-NDS0
     3217             sym11 free-sum0
     3218             sym12 sum-price-s
     3219             sym13 ( ( sum-price-s - free-sum0 ) / free-sum0 * 100 ) @ UpFact
     3220             sym14
     3221             with FRAME supp-gds .
     3222         DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3223         ACCUMULATE
     3224             suppl-parts.in-qnty (TOTAL)
     3225             in-sum0 (TOTAL)
     3226             suppl-parts.free-qnty (TOTAL)
     3227             free-noNDS0 (TOTAL)
     3228             free-NDS0 (TOTAL)
     3229             free-sum0 (TOTAL)
     3230             sum-price-s (TOTAL)
     3231             suppl-parts.prod-code (SUB-COUNT BY ub.goods.prod-code)
     3232             suppl-parts.in-qnty (SUB-TOTAL BY ub.goods.prod-code)
     3233             in-sum0 (SUB-TOTAL BY ub.goods.prod-code)
     3234             suppl-parts.free-qnty (SUB-TOTAL BY ub.goods.prod-code)
     3235             free-noNDS0 (SUB-TOTAL BY ub.goods.prod-code)
     3236             free-NDS0 (SUB-TOTAL BY ub.goods.prod-code)
     3237             free-sum0 (SUB-TOTAL BY ub.goods.prod-code)
     3238             sum-price-s (SUB-TOTAL BY ub.goods.prod-code)
     3239             .
     3240         if LAST-OF( ub.goods.prod-code ) AND (ACCUM SUB-COUNT BY ub.goods.prod-code suppl-parts.prod-code) > 1 then
     3241             do:
     3242                 DISPLAY STREAM PrnLibStream
     3243                     sym1 string( "Итого по товару" ) @ suppl-parts.in-code
     3244                     sym2
     3245                     sym3 (ACCUM SUB-TOTAL BY ub.goods.prod-code suppl-parts.in-qnty) @ suppl-parts.in-qnty
     3246                     sym4
     3247                     sym5 (ACCUM SUB-TOTAL BY ub.goods.prod-code in-sum0) @ in-sum0
     3248                     sym6
     3249                     sym7
     3250                     sym8 (ACCUM SUB-TOTAL BY ub.goods.prod-code suppl-parts.free-qnty) @ suppl-parts.free-qnty
     3251                     sym9 (ACCUM SUB-TOTAL BY ub.goods.prod-code free-noNDS0) @ free-noNDS0
     3252                     sym10 (ACCUM SUB-TOTAL BY ub.goods.prod-code free-NDS0) @ free-NDS0
     3253                     sym11 (ACCUM SUB-TOTAL BY ub.goods.prod-code free-sum0) @ free-sum0
     3254                     sym12 (ACCUM SUB-TOTAL BY ub.goods.prod-code sum-price-s) @ sum-price-s
     3255                     sym13 ( ( (ACCUM SUB-TOTAL BY ub.goods.prod-code sum-price-s) - (ACCUM SUB-TOTAL BY ub.goods.prod-code free-sum0) ) /
     3256                                       (ACCUM SUB-TOTAL BY ub.goods.prod-code free-sum0) * 100 ) @ UpFact
     3257                     sym14
     3258                     with FRAME supp-gds .
     3259                 DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3260             end.
     3261     END.
     3262     PUT STREAM PrnLibStream Line format "X(198)" SKIP.
     3263     DISPLAY STREAM PrnLibStream
     3264         "Итого" @ suppl-parts.in-code
     3265         (ACCUM TOTAL suppl-parts.in-qnty) @ suppl-parts.in-qnty
     3266         (ACCUM TOTAL in-sum0) @ in-sum0
     3267         (ACCUM TOTAL suppl-parts.free-qnty) @ suppl-parts.free-qnty
     3268         (ACCUM TOTAL free-noNDS0) @ free-noNDS0
     3269         (ACCUM TOTAL free-NDS0) @ free-NDS0
     3270         (ACCUM TOTAL free-sum0) @ free-sum0
     3271         (ACCUM TOTAL sum-price-s) @ sum-price-s
     3272         with FRAME supp-gds .
     3273     DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     3274     HIDE STREAM PrnLibStream FRAME BottomFrame .
     3275     OUTPUT STREAM PrnLibStream CLOSE.
     3276     if session:set-wait-state("") then.
     3277     run prn-lib-prn-file in this-procedure (
     3278                                               input parParentProc
     3279                                               ,input 8
     3280                                               ).
     3281   END PROCEDURE.
