      883   procedure twowin_clear :
      884       define buffer buf_temp_twowin_items        for temp_twowin_items.
      885   do
      886   for buf_temp_twowin_items
      887   on error undo, return error
      888   :
      889       empty temp-table buf_temp_twowin_items.
      890   end.
      891   end procedure.
      892   procedure twowin_add-item :
      893   define input parameter p-ext-key   as character        no-undo.
      894   define input parameter p-item-name as character        no-undo.
      895   define input parameter p-item-desc as character        no-undo.
      896   define input parameter p-selected  as logical          no-undo.
      897       define buffer buf_temp_twowin_items        for temp_twowin_items.
      898   do
      899   for buf_temp_twowin_items
      900   on error undo, return error
      901   :
      902       assign
      903           v-twowin13-itm-key = v-twowin13-itm-key + 1
      904       .
      905       create temp_twowin_items.
      906       assign
      907           temp_twowin_items.itm-key      = v-twowin13-itm-key
      908           temp_twowin_items.itmExtKey    = p-ext-key
      909           temp_twowin_items.itmName      = p-item-name
      910           temp_twowin_items.itmDesc      = p-item-desc
      911           temp_twowin_items.itmSelected  = p-selected
      912           temp_twowin_items.selLeft      = no
      913           temp_twowin_items.selRight     = no
      914       .
      915   end.
      916   end procedure.
      917   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      919   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      920   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      921   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      922   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      923   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      924   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      925   procedure uf-name :
      926     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      927     define output parameter p-use-List_     as logical   no-undo .
      928     define output parameter p-type-List_     as character no-undo .
      929     define output parameter p-format-List_   as character no-undo .
      930     define output parameter p-use-Naim      as logical   no-undo .
      931     define output parameter p-type-Naim      as character no-undo .
      932     define output parameter p-format-Naim    as character no-undo .
      933     define output parameter p-use-print-graft as logical   no-undo .
      934     define output parameter p-use-sort-gr   as logical   no-undo .
      935     define output parameter p-use-type-price as logical   no-undo .
      936     define output parameter p-use-type-val  as logical   no-undo .
      937     define output parameter p-label          as character no-undo .
      938     define output parameter p-tooltip        as character no-undo .
      939     define output parameter p-user-can-edit  as logical   no-undo .
      940     define output parameter p-output-display as logical   no-undo .
      941     define output parameter p-other          as character no-undo .
      942     do
      943     on error undo, return error
      944     :
      945       case p-code :
      946               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
