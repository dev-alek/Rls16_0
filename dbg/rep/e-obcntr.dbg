     1022   procedure uf-get :
     1023     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1024     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1025     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1026     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1027     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1028     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1029     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1030     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1031     do
     1032     on error undo, return error
     1033     :
     1034       define buffer buf_usr-flt for ubflt.usr-flt .
     1035       define variable v-use-List_     as logical   no-undo .
     1036       define variable v-type-List_     as character no-undo .
     1037       define variable v-format-List_   as character no-undo .
     1038       define variable v-use-Naim      as logical   no-undo .
     1039       define variable v-type-Naim      as character no-undo .
     1040       define variable v-format-Naim    as character no-undo .
     1041       define variable v-use-print-graft as logical   no-undo .
     1042       define variable v-use-sort-gr     as logical   no-undo .
     1043       define variable v-use-type-price  as logical   no-undo .
     1044       define variable v-use-type-val    as logical   no-undo .
     1045       define variable v-label          as character no-undo .
     1046       define variable v-tooltip        as character no-undo .
     1047       define variable v-user-can-edit  as logical   no-undo .
     1048       define variable v-output-display as logical   no-undo .
     1049       define variable v-other          as character no-undo .
     1050       run uf-name in this-procedure
     1051          (input  entry(1, p-code, chr(4))
     1052         ,output v-use-List_
     1053         ,output v-type-List_
     1054         ,output v-format-List_
     1055         ,output v-use-Naim
     1056         ,output v-type-Naim
     1057         ,output v-format-Naim
     1058         ,output v-use-print-graft
     1059         ,output v-use-sort-gr
     1060         ,output v-use-type-price
     1061         ,output v-use-type-val
     1062         ,output v-label
     1063         ,output v-tooltip
     1064         ,output v-user-can-edit
     1065         ,output v-output-display
     1066         ,output v-other
     1067         ) no-error .
     1068       if error-status :error then do:
     1069         undo, return error return-value .
     1070       end.
     1071       find first buf_usr-flt no-lock where
     1072                  buf_usr-flt.Call-point     = p-code AND
     1073                  buf_usr-flt.user-name       = p-user-name
     1074         no-error .
     1075       if avail buf_usr-flt then do:
     1076         assign
     1077         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1078         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1079         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1080         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1081         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1082         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1083         .
     1084       end.
     1085       else do:
     1086         assign
     1087         p-List_        = (if v-use-List_       then "":U                    else ?)
     1088         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1089         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1090         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1091         p-type-price   = (if v-use-type-price  then no                      else ?)
     1092         p-type-val     = (if v-use-List_       then no                      else ?)
     1093         .
     1094       end.
     1095     end.
     1096   end procedure.
     1097   procedure uf-set :
     1098     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1099     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1100     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1101     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1102     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1103     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1104     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1105     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1106     do
     1107     on error undo, return error
     1108     :
     1109       define buffer buf_usr-flt for ubflt.usr-flt .
     1110       define variable v-use-List_     as logical   no-undo .
     1111       define variable v-type-List_     as character no-undo .
     1112       define variable v-format-List_   as character no-undo .
     1113       define variable v-use-Naim      as logical   no-undo .
     1114       define variable v-type-Naim      as character no-undo .
     1115       define variable v-format-Naim    as character no-undo .
     1116       define variable v-use-print-graft as logical   no-undo .
     1117       define variable v-use-sort-gr   as logical   no-undo .
     1118       define variable v-use-type-price as logical   no-undo .
     1119       define variable v-use-type-val  as logical   no-undo .
     1120       define variable v-tooltip        as character no-undo .
     1121       define variable v-label          as character no-undo .
     1122       define variable v-user-can-edit  as logical   no-undo .
     1123       define variable v-output-display as logical   no-undo .
     1124       define variable v-other          as character no-undo .
     1125       run uf-name in this-procedure
     1126         (input  entry(1, p-code, chr(4))
     1127         ,output v-use-List_
     1128         ,output v-type-List_
     1129         ,output v-format-List_
     1130         ,output v-use-Naim
     1131         ,output v-type-Naim
     1132         ,output v-format-Naim
     1133         ,output v-use-print-graft
     1134         ,output v-use-sort-gr
     1135         ,output v-use-type-price
     1136         ,output v-use-type-val
     1137         ,output v-label
     1138         ,output v-tooltip
     1139         ,output v-user-can-edit
     1140         ,output v-output-display
     1141         ,output v-other
     1142         ) no-error .
     1143       if error-status :error then do:
     1144         undo, return error return-value .
     1145       end.
     1146       find first buf_usr-flt where
     1147                  buf_usr-flt.Call-point     = p-code AND
     1148                  buf_usr-flt.user-name       = p-user-name
     1149         no-error .
     1150       if not avail buf_usr-flt then do:
     1151           create buf_usr-flt .
     1152           assign
     1153           buf_usr-flt.call-point = p-code
     1154           buf_usr-flt.user-name  = p-user-name
     1155           .
     1156       end.
     1157       if avail buf_usr-flt then do:
     1158        assign
     1159        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1160        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1161        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1162        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1163        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1164        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1165       .
     1166       release buf_usr-flt.
     1167       end.
     1168       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1169     end.
     1170   end procedure.
     1171   CREATE WIDGET-POOL.
     1172   define variable v-nn as integer   no-undo .
     1173   define variable State-source as  WIDGET-HANDLE.
     1174   define variable g#log as logical   no-undo .
     1175   def buffer cli-post for clients .
     1176   define variable v-curr-r-b               as character no-undo .
     1177   define variable v-print-rubl             as logical   no-undo .
     1178     def var p-customer as int.
     1179     def var v-res as char.
     1180     def new  SHARED temp-table g#post NO-UNDO
     1181        field obj-type like ub.clients.obj-type
     1182        field obj-code like ub.clients.obj-code
     1183        field obj-name like ub.clients.obj-name
     1184        INDEX pi IS UNIQUE PRIMARY obj-type obj-code.
     1185   def New SHARED temp-table g#post-f NO-UNDO
     1186        field obj-type like ub.clients.obj-type
     1187        field obj-code like ub.clients.obj-code
     1188        field obj-name like ub.clients.obj-name
     1189        field grp-code like ub.clients.grp-code
     1190        field grp-name like ub.clients.grp-name
     1191        field lvl-num like  ub.cli-grp.lvl-num
     1192        INDEX pi IS UNIQUE PRIMARY obj-type obj-code
     1193        INDEX p1  obj-name
     1194       .
     1195   define variable  post-grp_recids as character no-undo .
     1196   define variable ii as integer no-undo .
     1197   DEFINE VARIABLE v-detdoctip AS LOGICAL NO-UNDO.
     1198   DEFINE VARIABLE v-detgoods AS LOGICAL NO-UNDO.
     1199   DEFINE RECTANGLE RECT-11
     1200        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1201        SIZE 42.5 BY 2.75.
     1202   DEFINE RECTANGLE RECT-12
     1203        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1204        SIZE 42.5 BY 2.25.
     1205   DEFINE VARIABLE Detdoctip AS LOGICAL INITIAL no
     1206        LABEL "Детализация по типам документов":L
     1207        VIEW-AS TOGGLE-BOX
     1208        SIZE 34.5 BY .83 TOOLTIP "Выводит разделение по типу документа" NO-UNDO.
     1209   DEFINE VARIABLE Detgoods AS LOGICAL INITIAL no
     1210        LABEL "Детализация по товарам":L
     1211        VIEW-AS TOGGLE-BOX
     1212        SIZE 26 BY .83 TOOLTIP "Выводит детализацию по товарам" NO-UNDO.
     1213   DEFINE FRAME F-Main
     1214        Detgoods AT ROW 2.25 COL 6 WIDGET-ID 6
     1215        Detdoctip AT ROW 4.75 COL 6 WIDGET-ID 8
     1216        RECT-11 AT ROW 1 COL 4 WIDGET-ID 10
     1217        RECT-12 AT ROW 4 COL 4 WIDGET-ID 12
     1218       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1219            SIDE-LABELS NO-UNDERLINE THREE-D
     1220            AT COL 1 ROW 1 SCROLLABLE .
     1221   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1222   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1223   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1224   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1225   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1226   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1227   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1228   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1229         adm-object-hdl = FRAME F-Main:HANDLE.
     1230   RUN ensure-broker.
     1231   THIS-PROCEDURE:ADM-DATA =
     1232        'ADM1.1~`':U +
     1233        'SmartObject~`':U +
     1234        '~`':U +
     1235        'NO ~`':U +
     1236        '~`':U +
     1237        '~`':U +
     1238        '~`':U +
     1239        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1240           + "~`":U +
     1241        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1242        'Record-Source,Record-Target,TableIO-Target~`':U +
     1243        '~`':U +
     1244        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1245        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1246            THEN "^^":U
     1247        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1248             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1249   PROCEDURE adm-apply-entry :
     1250     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1251   END PROCEDURE.
     1252   PROCEDURE adm-destroy :
     1253    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1254   END PROCEDURE.
     1255   PROCEDURE adm-disable :
     1256       DISABLE RECT-11 RECT-12 DetGoods Detdoctip WITH FRAME F-Main.
     1257       RUN dispatch ('disable-fields':U).
     1258       RUN set-attribute-list ('ENABLED=no':U).
     1259       RETURN.
     1260   END PROCEDURE.
     1261   PROCEDURE adm-edit-attribute-list :
     1262         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1263         RETURN.
     1264   END PROCEDURE.
     1265   PROCEDURE adm-enable :
     1266       ENABLE UNLESS-HIDDEN RECT-11 RECT-12 DetGoods Detdoctip WITH FRAME F-Main.
     1267       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1268       RUN set-attribute-list ('ENABLED=yes':U).
     1269       RETURN.
     1270   END PROCEDURE.
     1271   PROCEDURE adm-exit :
     1272        RUN notify ('exit':U).
     1273     RETURN.
     1274   END PROCEDURE.
     1275   PROCEDURE adm-hide :
     1276     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1277   END PROCEDURE.
     1278   PROCEDURE adm-initialize :
     1279     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1280   END PROCEDURE.
     1281   PROCEDURE adm-show-errors :
     1282       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1283       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1284           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1285       END.
     1286       RETURN.
     1287   END PROCEDURE.
     1288   PROCEDURE adm-UIB-mode :
     1289     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1290   END PROCEDURE.
     1291   PROCEDURE adm-view :
     1292     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1293   END PROCEDURE.
     1294   PROCEDURE dispatch :
     1295       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1296       RUN broker-dispatch IN adm-broker-hdl
     1297           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1298       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1299   END PROCEDURE.
     1300   PROCEDURE ensure-broker :
     1301   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1302   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1303   DO:
     1304       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1305       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1306   END.
     1307   END PROCEDURE.
     1308   PROCEDURE get-attribute :
     1309     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1310     RUN broker-get-attribute IN adm-broker-hdl
     1311         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1312     RETURN RETURN-VALUE.
     1313   END PROCEDURE.
     1314   PROCEDURE get-attribute-list :
     1315     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1316     RUN broker-get-attribute-list IN adm-broker-hdl
     1317         (INPUT THIS-PROCEDURE,
     1318          INPUT ?,
     1319          OUTPUT p-attr-list) NO-ERROR.
     1320     RETURN.
     1321   END PROCEDURE.
     1322   PROCEDURE new-state :
     1323     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1324     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1325     RETURN.
     1326   END PROCEDURE.
     1327   PROCEDURE notify :
     1328     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1329     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1330     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1331         RETURN "ADM-ERROR":U.
     1332     RETURN.
     1333   END PROCEDURE.
     1334   PROCEDURE set-attribute-list :
     1335     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1336     RUN ensure-broker.
     1337     RUN broker-set-attribute-list IN adm-broker-hdl
     1338         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1339     RETURN.
     1340   END PROCEDURE.
     1341   PROCEDURE set-position :
     1342       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1343       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1344       IF VALID-HANDLE(adm-object-hdl) THEN
     1345       DO:
     1346         ASSIGN adm-object-hdl:ROW    =   p-row
     1347                adm-object-hdl:COLUMN =   p-col.
     1348       END.
     1349       RETURN.
     1350   END PROCEDURE.
     1351   PROCEDURE adm-display-fields :
     1352       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1353       RETURN.
     1354   END PROCEDURE.
     1355   PROCEDURE adm-open-query :
     1356     RETURN.
     1357   END PROCEDURE.
     1358   PROCEDURE adm-row-changed :
     1359         IF VALID-HANDLE(adm-object-hdl) THEN
     1360           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1361         RUN notify ('row-available':U).
     1362         RETURN.
     1363   END PROCEDURE.
     1364   PROCEDURE reposition-query :
     1365       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1366       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1367       RETURN.
     1368   END PROCEDURE.
     1369     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1370     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1371     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1372     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1373     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1374     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1375     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1376     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1377     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1378     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1379     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1380     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1381     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1382     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1383     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1384     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1385     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1386     IF "":U = "":U THEN
     1387       RUN modify-list-attribute IN adm-broker-hdl
     1388         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1389     RUN use-create-on-add(?).
     1390   PROCEDURE adm-add-record :
     1391       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1392          "must have at least one Enabled Table to perform Add.":U
     1393          VIEW-AS ALERT-BOX ERROR.
     1394       RETURN.
     1395   END PROCEDURE.
     1396   PROCEDURE adm-assign-record :
     1397    MESSAGE
     1398          "Object ":U THIS-PROCEDURE:FILE-NAME
     1399            "must have at least one Enabled Table to perform Assign.":U
     1400              VIEW-AS ALERT-BOX ERROR.
     1401      RETURN.
     1402     END PROCEDURE.
     1403   PROCEDURE adm-assign-statement :
     1404     RETURN.
     1405   END PROCEDURE.
     1406   PROCEDURE adm-cancel-record :
     1407      RETURN.
     1408     END PROCEDURE.
     1409   PROCEDURE adm-copy-record :
     1410       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1411        "must have at least one Enabled Table to perform Copy.":U
     1412          VIEW-AS ALERT-BOX ERROR.
     1413       RETURN.
     1414   END PROCEDURE.
     1415   PROCEDURE adm-create-record :
     1416      RETURN.
     1417   END PROCEDURE.
     1418   PROCEDURE adm-current-changed :
     1419     RETURN.
     1420   END PROCEDURE.
     1421   PROCEDURE adm-delete-record :
     1422    MESSAGE
     1423          "Object ":U THIS-PROCEDURE:FILE-NAME
     1424            "must have at least one Enabled Table to perform Delete.":U
     1425              VIEW-AS ALERT-BOX ERROR.
     1426       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1427       RETURN.
     1428   END PROCEDURE.
     1429   PROCEDURE adm-disable-fields :
     1430         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1431       RETURN.
     1432   END PROCEDURE.
     1433   PROCEDURE adm-enable-fields :
     1434       RETURN.
     1435   END PROCEDURE.
     1436   PROCEDURE adm-end-update :
     1437     RETURN.
     1438   END PROCEDURE.
     1439   PROCEDURE adm-reset-record :
     1440       RETURN.
     1441   END PROCEDURE.
     1442   PROCEDURE adm-update-record :
     1443       MESSAGE
     1444         "Object ":U THIS-PROCEDURE:FILE-NAME
     1445           "must have at least one Enabled Table to perform Update.":U
     1446             VIEW-AS ALERT-BOX ERROR.
     1447      RETURN.
     1448   END PROCEDURE.
     1449   PROCEDURE check-modified :
     1450   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1451   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1452   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1453   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1454     IF check-state = "check":U THEN
     1455     DO:
     1456       RUN get-link-handle IN adm-broker-hdl
     1457         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1458            OUTPUT group-target-list).
     1459       IF group-target-list NE "":U THEN
     1460       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1461         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1462         RUN check-modified IN curr-widget ('group-check':U).
     1463         IF RETURN-VALUE NE "":U THEN
     1464         DO:
     1465           RUN check-modified-message(RETURN-VALUE).
     1466           RETURN "":U.
     1467         END.
     1468       END.
     1469     END.
     1470     RETURN "":U.
     1471   END PROCEDURE.
     1472   PROCEDURE check-modified-message :
     1473     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1474        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1475           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1476        IF RETURN-VALUE = "YES":U THEN
     1477           RUN notify ('view,CONTAINER-SOURCE':U).
     1478        MESSAGE IF p-changed-table NE ? THEN
     1479           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1480           ELSE "Current values have been changed."
     1481           SKIP "  Do you wish to save those changes?"
     1482           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1483        IF ANS THEN
     1484        DO:
     1485           IF group-assign-target THEN
     1486             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1487           ELSE RUN dispatch('update-record':U).
     1488           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1489           DO:
     1490               MESSAGE "Changes to the previous record were not saved."
     1491                 VIEW-AS ALERT-BOX ERROR.
     1492               IF group-assign-target THEN
     1493                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1494               ELSE RUN dispatch ('cancel-record':U).
     1495           END.
     1496        END.
     1497        ELSE DO:
     1498          IF group-assign-target THEN
     1499             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1500          ELSE RUN dispatch('cancel-record':U).
     1501        END.
     1502        RETURN.
     1503   END PROCEDURE.
     1504   PROCEDURE get-rowid :
     1505       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1506       ASSIGN
     1507       p-table   =   adm-first-table.
     1508       RETURN.
     1509   END PROCEDURE.
     1510   PROCEDURE init-group-assign :
     1511       RUN request-attribute IN adm-broker-hdl
     1512         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1513       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1514         group-assign-target = yes.
     1515       ELSE group-assign-target = no.
     1516       RETURN.
     1517   END PROCEDURE.
     1518   PROCEDURE set-editors :
     1519       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1520       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1521       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1522       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1523       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1524       DO WHILE VALID-HANDLE (curr-widget):
     1525           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1526              curr-widget:HIDDEN = no THEN DO:
     1527             CASE p-field-setting:
     1528               WHEN "INITIALIZE":U THEN
     1529               DO:
     1530                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1531                     read-only-list +
     1532                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1533                        STRING(curr-widget).
     1534               END.
     1535               WHEN "DISABLE":U OR
     1536               WHEN "ENABLE":U THEN
     1537               DO:
     1538                   curr-widget:SENSITIVE = yes.
     1539                   RUN get-attribute ('Read-Only-Editors':U).
     1540                   IF RETURN-VALUE = ? OR
     1541                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1542                       curr-widget:READ-ONLY =
     1543                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1544               END.
     1545               WHEN "CLEAR":U THEN
     1546                   curr-widget:SCREEN-VALUE = "":U.
     1547             END CASE.
     1548           END.
     1549           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1550       END.
     1551       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1552         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1553           + '"':U).
     1554       RETURN.
     1555   END PROCEDURE.
     1556   PROCEDURE use-check-modified-all :
     1557    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1558     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1559     RETURN.
     1560   END PROCEDURE.
     1561   PROCEDURE use-create-on-add :
     1562   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1563      RETURN.
     1564   END PROCEDURE.
     1565   PROCEDURE use-initial-lock :
     1566     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1567     ASSIGN adm-initial-lock = p-attr-value.
     1568     RETURN.
     1569   END PROCEDURE.
     1570     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1571   ASSIGN
     1572          FRAME F-Main:SCROLLABLE       = FALSE
     1573          FRAME F-Main:HIDDEN           = TRUE.
     1574   ON VALUE-CHANGED OF Detdoctip IN FRAME F-Main
     1575   DO:
     1576     assign DetDocTip.
     1577   assign
     1578     v-detdoctip = detdoctip
     1579   .
     1580   END.
     1581   ON VALUE-CHANGED OF Detgoods IN FRAME F-Main
     1582   DO:
     1583     assign Detgoods.
     1584    assign
     1585     v-detgoods = DetGoods
     1586   .
     1587   END.
     1588   if not this-procedure :persistent
     1589   then do:
     1590     message
     1591       vss-workfile vss-revision vss-description skip
     1592       "Ошибка при запуске процедуры" skip
     1593       "Данную процедуру следует запускать только с параметром persistent" skip
     1594       view-as alert-box error .
     1595     undo, return error .
     1596   end.
     1597   PROCEDURE disable_UI :
     1598     HIDE FRAME F-Main.
     1599     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1600   END PROCEDURE.
     1601   PROCEDURE local-initialize :
     1602     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1603   END PROCEDURE.
     1604   PROCEDURE my-report :
     1605   run rep/r-obcntr.p
     1606       ( input v-cntxt-obj-code    ,
     1607         input v-cntxt-obj-type    ,
     1608         input base-type           ,
     1609         input base-code           ,
     1610         input v-DetGoods          ,
     1611         input v-Detdoctip         ) .
     1612   END PROCEDURE.
     1613   PROCEDURE my-var :
     1614   assign frame F-Main DetGoods Detdoctip
     1615   .
     1616   ReportNAme = "Оборотная ведомость по покупателям (по товарам) " .
     1617   assign
     1618   sheetf.Excel-Column-Lable = "Код,Артикул,Наименование" +
     1619   (if v-detdoctip then (",Расход Количество,Расход Сумма,Возврат Количество,Возврат Сумма")  else "") + ",Итого количество,Итого обороты"
     1620   sheetf.Sizes  = "9,16,40" + (if v-detdoctip then ",12,12,12,12" else "") + ",12,12"
     1621   .
     1622   END PROCEDURE.
