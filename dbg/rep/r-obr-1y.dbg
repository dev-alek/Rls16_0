      760   procedure ost-line :
      761     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
      762     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
      763     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
      764     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
      765     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
      766     define input  parameter x-tog-shift  as logical no-undo .
      767     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
      768     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
      769     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
      770     define input  parameter xtog-obj     as logical no-undo .
      771     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
      772     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
      773     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
      774     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
      775     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
      776     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
      777     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
      778     define buffer buff-obj-list  for obj-list .
      779     define buffer buff-stk-line  for ub.stk-line .
      780     assign
      781       Quantity = 0
      782       Coast_R  = 0
      783       Coast_V  = 0
      784       VAT_R    = 0
      785       VAT_V    = 0
      786       SLT_R    = 0
      787       SLT_V    = 0
      788     .
      789     if  x-tog-shift = false then do:
      790       for each buff-obj-list no-lock
      791         where xtog-obj = false
      792            or (buff-obj-list.obj-type = x-store-type
      793               and buff-obj-list.obj-code = x-store-code
      794               )
      795       on error undo, return error
      796       :
      797       find last buff-stk-line no-lock
      798         where buff-stk-line.obj-type   = buff-obj-list.obj-type
      799           and buff-stk-line.obj-code   = buff-obj-list.obj-code
      800           and buff-stk-line.artic      = x-artic
      801           and buff-stk-line.prod-type  = x-prod-type
      802           and buff-stk-line.prod-code  = x-prod-code
      803           and buff-stk-line.sum-type   = x-sum-type
      804           and buff-stk-line.cat-id     = '##,##':U
      805           and buff-stk-line.fact-order <= x-fact-order
      806           and buff-stk-line.shift-num  = 0
      807         use-index category
      808         no-error .
      809       if available buff-stk-line then do:
      810         assign
      811           Quantity = Quantity + buff-stk-line.fact-qnty
      812           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
      813           Coast_V  = Coast_V  + buff-stk-line.sum-base
      814           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
      815           VAT_V    = VAT_V    + buff-stk-line.VAT-base
      816           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
      817           SLT_V    = SLT_V    + buff-stk-line.SLT-base
      818         .
      819       end.
      820      end.
      821     end.
      822     else do:
      823       for each buff-obj-list no-lock
      824         where xtog-obj = false
      825            or (buff-obj-list.obj-type = x-store-type
      826               and buff-obj-list.obj-code = x-store-code
      827               )
      828       on error undo, return error
      829       :
      830         find last buff-stk-line no-lock
      831           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      832             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      833             and buff-stk-line.artic      = x-artic
      834             and buff-stk-line.prod-type  = x-prod-type
      835             and buff-stk-line.prod-code  = x-prod-code
      836             and buff-stk-line.sum-type   = x-sum-type
      837             and buff-stk-line.cat-id     = '##,##':U
      838             and buff-stk-line.fact-order <= x-fact-order
      839             and buff-stk-line.shift-num  > 0
      840           use-index category
      841           no-error .
      842         if available buff-stk-line then do:
      843           assign
      844             Quantity = Quantity +  buff-stk-line.fact-qnty
      845             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      846             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      847             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      848             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      849             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      850             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      851           .
      852         end.
      853       end.
      854     end.
      855   end procedure.
      856   procedure ost-lineother-tax :
      857     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
      858     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
      859     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
      860     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
      861     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
      862     define input  parameter x-tog-shift  as logical no-undo .
      863     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
      864     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
      865     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
      866     define input  parameter xTog-obj     as logical no-undo .
      867     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
      868     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
      869     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
      870     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
      871     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
      872     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
      873     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
      874     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
      875     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
      876     define buffer buff-obj-list  for obj-list .
      877     define buffer buff-stk-line  for ub.stk-line .
      878     assign
      879       Quantity = 0
      880       Coast_R  = 0
      881       Coast_V  = 0
      882       VAT_R    = 0
      883       VAT_V    = 0
      884       SLT_R    = 0
      885       SLT_V    = 0
      886       other_R  = 0
      887       other_V  = 0
      888     .
      889     if  x-tog-shift = false then do:
      890       for each buff-obj-list no-lock
      891         where xtog-obj = false
      892            or (buff-obj-list.obj-type = x-store-type
      893               and buff-obj-list.obj-code = x-store-code
      894               )
      895       on error undo, return error
      896       :
      897       find last buff-stk-line no-lock
      898         where buff-stk-line.obj-type   = buff-obj-list.obj-type
      899           and buff-stk-line.obj-code   = buff-obj-list.obj-code
      900           and buff-stk-line.artic      = x-artic
      901           and buff-stk-line.prod-type  = x-prod-type
      902           and buff-stk-line.prod-code  = x-prod-code
      903           and buff-stk-line.sum-type   = x-sum-type
      904           and buff-stk-line.cat-id     = '##,##':U
      905           and buff-stk-line.fact-order <= x-fact-order
      906           and buff-stk-line.shift-num  = 0
      907         use-index category
      908         no-error .
      909       if available buff-stk-line then do:
      910         assign
      911           Quantity = Quantity + buff-stk-line.fact-qnty
      912           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
      913           Coast_V  = Coast_V  + buff-stk-line.sum-base
      914           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
      915           VAT_V    = VAT_V    + buff-stk-line.VAT-base
      916           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
      917           SLT_V    = SLT_V    + buff-stk-line.SLT-base
      918           other_R  = other_R  + buff-stk-line.other-rubl
      919           other_V  = other_V  + buff-stk-line.other-base
      920         .
      921       end.
      922    end.
      923     end.
      924     else do:
      925       for each buff-obj-list no-lock
      926         where xtog-obj = false
      927            or (buff-obj-list.obj-type = x-store-type
      928               and buff-obj-list.obj-code = x-store-code
      929               )
      930       on error undo, return error
      931       :
      932         find last buff-stk-line no-lock
      933           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      934             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      935             and buff-stk-line.artic      = x-artic
      936             and buff-stk-line.prod-type  = x-prod-type
      937             and buff-stk-line.prod-code  = x-prod-code
      938             and buff-stk-line.sum-type   = x-sum-type
      939             and buff-stk-line.cat-id     = '##,##':U
      940             and buff-stk-line.fact-order <= x-fact-order
      941             and buff-stk-line.shift-num  > 0
      942           use-index category
      943           no-error .
      944         if available buff-stk-line then do:
      945           assign
      946             Quantity = Quantity +  buff-stk-line.fact-qnty
      947             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      948             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      949             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      950             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      951             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      952             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      953             other_R = other_R   +  buff-stk-line.other-rubl
      954             other_V = other_V   +  buff-stk-line.other-base
      955           .
      956         end.
      957       end.
      958     end.
      959   end procedure.
      960   procedure ost-line-kg :
      961     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
      962     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
      963     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
      964     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
      965     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
      966     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
      967     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
      968     define buffer buff-obj-list  for obj-list .
      969     define buffer buf_doc-line for ub.doc-line .
      970     define buffer buf_inv-line for ub.inv-line .
      971     do
      972     on error undo, return error
      973     :
      974       for each buf_doc-line no-lock where
      975                buf_doc-line.obj-type    = p-obj-type   and
      976                buf_doc-line.obj-code    = p-obj-code   and
      977                buf_doc-line.prod-type   = p-prod-type  and
      978                buf_doc-line.prod-code   = p-prod-code  and
      979                buf_doc-line.artic       = p-artic      and
      980                buf_doc-line.status_     = 'факт':U      and
      981                buf_doc-line.fact-order <= p-fact-order
      982             by buf_doc-line.fact-order    descending
      983       :
      984         find first buf_inv-line no-lock where
      985                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
      986                    buf_inv-line.artic     = buf_doc-line.artic     and
      987                    buf_inv-line.prod-type = buf_doc-line.prod-type and
      988                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
      989         if available buf_inv-line
      990         then do:
      991           if buf_inv-line.after-cli-qnty <> ?
      992           then do:
      993             assign
      994               p-quantity-kg = buf_inv-line.after-cli-qnty
      995             .
      996             leave .
      997           end.
      998         end.
      999       end.
     1000       if p-quantity-kg = ?
     1001       then do:
     1002         assign
     1003           p-quantity-kg = 0
     1004         .
     1005       end.
     1006     end.
     1007   end procedure.
     1008   PROCEDURE ostatok :
     1009   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1010   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1011   def input parameter x-tog-shift   as   logical             no-undo.
     1012   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1013   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1014   def input parameter x-shift-start as integer               no-undo.
     1015   def input parameter x-shift-end   as integer               no-undo.
     1016   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1017   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1018   def input parameter xTog-obj   as log no-undo.
     1019   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1020   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1021   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1022   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1023   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1024   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1025   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1026   def var              Fact-orderS   as char  no-undo.
     1027   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1028      Assign
     1029         Fact-order   = 0
     1030         Quantity     = 0
     1031         Coast_R      = 0
     1032         Coast_V      = 0
     1033         VAT_R        = 0
     1034         VAT_V        = 0 .
     1035    x-date-start-t  = x-date-start + 1 .
     1036   IF x-date-end = date('') then DO:
     1037      Fact-order = 0 .
     1038      for each obj-list
     1039          where  ( not xtog-obj or
     1040                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1041                 no-lock :
     1042         if  x-tog-shift = false then do:
     1043                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1044                               ub.stk-tot.Fact-date <=  x-date-start
     1045                               and ub.stk-tot.shift-num = 0
     1046                               USE-INDEX fact-date no-lock no-error .
     1047              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1048         End.
     1049         Else  DO :
     1050             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1051              (ub.stk-tot.shift-date  = x-date-start-t and
     1052               ub.stk-tot.shift-num  < x-shift-start or
     1053               ub.stk-tot.shift-date  < x-date-start-t  )
     1054               and ub.stk-tot.shift-num  > 0
     1055               USE-INDEX Shift-num no-lock no-error .
     1056            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1057           END.
     1058       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1059     End.
     1060   End.
     1061   Else DO:
     1062     For each obj-list  WHERE
     1063        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1064         no-lock :
     1065      IF  x-TOG-Shift = False Then DO:
     1066          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1067               ub.stk-tot.Fact-date <= x-date-end
     1068               and ub.stk-tot.shift-num = 0
     1069               USE-INDEX fact-date no-lock no-error.
     1070          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1071      END.
     1072      Else DO:
     1073           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1074               (ub.stk-tot.shift-date  = x-date-end and
     1075               ub.stk-tot.shift-num  <= x-shift-end or
     1076               ub.stk-tot.shift-date  < x-date-end       ) and
     1077               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1078               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1079       End.
     1080       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1081     End.
     1082   End.
     1083   END PROCEDURE.
     1084   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1085     if num-entries(string(p-dec), '.') = 2
     1086       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1087       else return( string(p-dec)) .
     1088   end function.
     1089   function format-point-to-comma returns char (input orig as char ) .
     1090   define variable rtext as character no-undo .
     1091   define variable strt as integer no-undo .
     1092   define variable leng as integer no-undo .
     1093   assign rtext = orig .
     1094   repeat:
     1095     strt =  index(rtext,'.').
     1096     if strt = 0 then leave.
     1097     leng = 1.
     1098     substring(rtext,strt,leng,"character") = v-delim .
     1099   end.
     1100   return rtext.
     1101   end function.
     1102   function format-excel-text returns char ( input start-text as char ) :
     1103   def var  i    as int no-undo.
     1104   def var  ch   as char no-undo.
     1105   def var  n    as int no-undo.
     1106   def var  ipos as int no-undo.
     1107     n = num-entries(trim(start-text), chr(10)) - 1 .
     1108     do i = 1 to n :
     1109       ipos = index( start-text, chr(10)).
     1110       if ipos > 0 then
     1111         substr( start-text, ipos, 1 ) = ' '.
     1112     end.
     1113     n = num-entries(trim(start-text), chr(13)) - 1 .
     1114     do i = 1 to n :
     1115       ipos = index( start-text, chr(13)).
     1116       if ipos > 0 then
     1117         substr( start-text, ipos, 1 ) = ' '.
     1118     end.
     1119     if index( start-text, '"' ) = 0 then
     1120       start-text =  '="'   + trim( start-text) + '"'   .
     1121       else do:
     1122         n = num-entries(trim(start-text), '"') - 1.
     1123         do i = 1 to n :
     1124           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1125         end.
     1126         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1127         start-text = '="'  + ch  + '"' .
     1128       end.
     1129     return start-text.
     1130   end.
     1131   function excel-sum returns char (input p-dec as decimal ).
     1132     if p-access = true then do:
     1133        return(string(round(p-dec,2))) .
     1134     end.
     1135     else do:
     1136         return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1137     end.
     1138   end function.
     1139   function excel-qnty returns char (input p-dec as decimal ).
     1140     if p-access = true then do:
     1141        return(string(round(p-dec,3))) .
     1142     end.
     1143     else do:
     1144         return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1145     end.
     1146   end function.
     1147   function format-excel-text-macr returns char ( input start-text as char ) :
     1148   def var  i    as int no-undo.
     1149   def var  ch   as char no-undo.
     1150   def var  n    as int no-undo.
     1151   def var  ipos as int no-undo.
     1152     n = num-entries(trim(start-text), chr(10)) - 1 .
     1153     do i = 1 to n :
     1154       ipos = index( start-text, chr(10)).
     1155       if ipos > 0 then
     1156         substring( start-text, ipos , 1 ) = ' '.
     1157     end.
     1158     n = num-entries(trim(start-text), chr(13)) - 1 .
     1159     do i = 1 to n :
     1160       ipos = index( start-text, chr(13)).
     1161       if ipos > 0 then
     1162         substring( start-text, ipos, 1 ) = ' '.
     1163     end.
     1164     if index( start-text, '"' ) = 0 then
     1165       start-text =  '"'   + trim( start-text) + '"'   .
     1166       else do:
     1167         n = num-entries(trim(start-text), '"') - 1.
     1168         do i = 1 to n :
     1169           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1170         end.
     1171         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1172         start-text = '"'  + ch  + '"' .
     1173       end.
     1174     n = num-entries(trim(start-text), chr(10)) - 1 .
     1175     do i = 1 to n :
     1176       ipos = index( start-text, chr(10)).
     1177       if ipos > 0 then
     1178         substring( start-text, ipos , 1 ) = ' '.
     1179     end.
     1180       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1181     return start-text.
     1182   end.
     1183   function func-vat returns decimal (
     1184       input p-gds-code as integer  ,
     1185       input p-obj-type as character ,
     1186       input p-obj-code as integer  ).
     1187   define variable i-vat-pc as decimal no-undo .
     1188   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1189   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1190     (input  p-gds-code
     1191     ,input  '1':U
     1192     ,input  x-Date-End
     1193     ,input  v-cntxt-host-code-obj
     1194     ,input  p-obj-type
     1195     ,input  p-obj-code
     1196     ,output i-vat-pc
     1197     ) no-error .
     1198   if error-status :error then return 0 .
     1199   else return i-vat-pc.
     1200   end function .
     1201   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1202   procedure cur-time :
     1203      define output parameter p-today as date      no-undo .
     1204      define output parameter p-time  as integer   no-undo .
     1205     do
     1206     on error undo, return error
     1207     :
     1208       define variable v-date1 as date      no-undo .
     1209       define variable v-date2 as date      no-undo .
     1210       define variable v-time  as integer   no-undo .
     1211       assign
     1212         v-date1 = today
     1213         v-time  = time
     1214         v-date2 = today
     1215       .
     1216       if v-date1 <> v-date2
     1217       then do:
     1218         assign
     1219           v-date1 = today
     1220           v-time  = v-time
     1221         .
     1222       end.
     1223       assign
     1224         p-today = v-date1
     1225         p-time  = v-time
     1226       .
     1227     end.
     1228   end.
     1229   function cur-time-date returns character
     1230   :
     1231     return string(today, '99/99/9999':U) .
     1232   end.
     1233   function cur-time-mjd returns decimal
     1234   :
     1235     define variable v-date as date      no-undo .
     1236     define variable v-time as integer   no-undo .
     1237     run cur-time in this-procedure
     1238       (output v-date
     1239       ,output v-time
     1240       ) .
     1241     return integer(v-date) - 2400002 + (v-time / 86400) .
     1242   end.
     1243   function cur-time-get-ending-index returns integer
     1244   (input p-number as integer
     1245   )
     1246   :
     1247     if p-number < 0
     1248     or p-number = ?
     1249     then do:
     1250       return 1 .
     1251     end.
     1252     define variable v-rest as integer   no-undo .
     1253     assign
     1254       p-number = p-number modulo 100
     1255     .
     1256     if p-number < 20
     1257     then do:
     1258       assign
     1259         v-rest = p-number
     1260       .
     1261     end.
     1262     else do:
     1263       assign
     1264         v-rest = p-number modulo 10
     1265       .
     1266     end.
     1267     case v-rest :
     1268       when 1
     1269       then do:
     1270         return 2 .
     1271       end.
     1272       when 2 or
     1273       when 3 or
     1274       when 4
     1275       then do:
     1276         return 3 .
     1277       end.
     1278       otherwise do:
     1279         return 1 .
     1280       end.
     1281     end case .
     1282   end.
     1283   procedure cur-time-mjd-to-date :
     1284      define input  parameter i-mjd-diff as decimal no-undo.
     1285      define output parameter o-Date     as date    no-undo.
     1286      define output parameter o-Time     as integer no-undo.
     1287      define variable v-day-number as integer   no-undo .
     1288      if    i-mjd-diff < 0
     1289         or i-mjd-diff = ?
     1290      then do:
     1291         return "?" .
     1292      end.
     1293      assign
     1294         v-day-number = truncate(i-mjd-diff,0).
     1295         o-Date = date(v-day-number + 2400002).
     1296         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1297     .
     1298   end.
     1299   function cur-time-mjd-to-string returns character
     1300   (input p-mjd-diff as decimal
     1301   )
     1302   :
     1303     define variable v-day-number as integer   no-undo .
     1304     define variable v-seconds    as integer   no-undo .
     1305     define variable v-hour       as integer   no-undo .
     1306     define variable v-min        as integer   no-undo .
     1307     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1308     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1309     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1310     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1311     if p-mjd-diff < 0
     1312     or p-mjd-diff = ?
     1313     then do:
     1314       return "?" .
     1315     end.
     1316     assign
     1317       v-day-number = integer(truncate(p-mjd-diff,0))
     1318       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1319     .
     1320     if v-seconds > 86400
     1321     then do:
     1322       assign
     1323         v-seconds = 86400 - 1
     1324       .
     1325     end.
     1326     if v-seconds < 0
     1327     then do:
     1328       assign
     1329         v-seconds = 0
     1330       .
     1331     end.
     1332     assign
     1333       v-hour = truncate(v-seconds / 3600, 0)
     1334     .
     1335     assign
     1336       v-seconds = v-seconds modulo 3600
     1337     .
     1338     assign
     1339       v-min = truncate(v-seconds / 60, 0)
     1340     .
     1341     assign
     1342       v-seconds = v-seconds modulo 60
     1343     .
     1344     return
     1345         (if v-day-number <> 0
     1346           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1347           else ""
     1348         )
     1349       + (if v-day-number <> 0 or v-hour <> 0
     1350           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1351           else ""
     1352         )
     1353       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1354           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1355           else ""
     1356         )
     1357       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1358       .
     1359   end.
     1360   function cur-time-string returns character
     1361   :
     1362     define variable v-date as date      no-undo .
     1363     define variable v-time as integer   no-undo .
     1364     run cur-time in this-procedure
     1365       (output v-date
     1366       ,output v-time
     1367       ) .
     1368     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1369   end.
     1370   function cur-time-string-sec returns character
     1371   :
     1372     define variable v-date as date      no-undo .
     1373     define variable v-time as integer   no-undo .
     1374     run cur-time in this-procedure
     1375       (output v-date
     1376       ,output v-time
     1377       ) .
     1378     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1379   end.
     1380   function cur-time-custom  returns character
     1381   (input p-prefix as character
     1382   ,input p-date-format as character
     1383   ,input p-delimiter as character
     1384   ,input p-time-format as character
     1385   ,input p-suffix as character
     1386   )
     1387   :
     1388     define variable v-date as date      no-undo .
     1389     define variable v-time as integer   no-undo .
     1390     run cur-time in this-procedure
     1391       (output v-date
     1392       ,output v-time
     1393       ) .
     1394     return
     1395       p-prefix
     1396       + string(v-date, p-date-format)
     1397       + p-delimiter
     1398       + string(v-time, p-time-format)
     1399       + p-suffix
     1400       .
     1401   end.
     1402   function cur-time-print  returns character
     1403   :
     1404     define variable v-date as date      no-undo .
     1405     define variable v-time as integer   no-undo .
     1406     run cur-time in this-procedure
     1407       (output v-date
     1408       ,output v-time
     1409       ) .
     1410     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1411   end.
     1412   function cur-time-datetime returns datetime
     1413   :
     1414     define variable v-char as character no-undo .
     1415     define variable v-datetime as datetime no-undo .
     1416     v-char = cur-time-string().
     1417     v-datetime = datetime(v-char).
     1418     return  v-datetime.
     1419   end.
     1420   function cur-time-string-msec returns character
     1421   :
     1422     define variable v-date as datetime  no-undo .
     1423     v-date = now.
     1424     return string(v-date) .
     1425   end.
     1426   define temp-table temp-font no-undo
     1427     field fontnum  as integer
     1428     field fontname as character
     1429     field fontsize as character
     1430     field fonttype as character
     1431     field font-h   as integer
     1432     field font-w   as integer
     1433     field v-row    as integer
     1434     field v-col    as integer
     1435     field v-row-lans as integer
     1436     field v-col-lans as integer
     1437   index pi fontnum
     1438   .
     1439   procedure get-font-ini :
     1440     do
     1441     on error undo, return error return-value
     1442     :
     1443   define variable ii as integer   no-undo .
     1444   define variable v-font7 as character no-undo .
     1445   define variable v-font as character no-undo .
     1446   define variable loc-name as character no-undo .
     1447   define variable loc-size as character no-undo .
     1448   define variable loc-type as character no-undo .
     1449   define variable old_H as integer   no-undo .
     1450   define variable old_w as integer   no-undo .
     1451   define variable old-row  as integer   no-undo .
     1452   define variable old-col  as integer   no-undo .
     1453   define variable old-row-lans  as integer   no-undo .
     1454   define variable old-col-lans  as integer   no-undo .
     1455   define variable vv as integer   no-undo .
     1456   empty temp-table temp-font.
     1457     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1458       case num-entries (v-font7) :
     1459         when 4 then do:
     1460             assign
     1461               loc-name = entry ( 1 , v-font7 )
     1462               loc-size = entry ( 2 , v-font7 )
     1463               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1464             .
     1465         end.
     1466         when 3 then do:
     1467             assign
     1468               loc-name = entry ( 1 , v-font7 )
     1469               loc-size = entry ( 2 , v-font7 )
     1470               loc-type = entry ( 3 , v-font7 )
     1471             .
     1472         end.
     1473         when 2 then  do:
     1474             assign
     1475               loc-name = entry ( 1 , v-font7 )
     1476               loc-size = entry ( 2 , v-font7 )
     1477               loc-type = ""
     1478             .
     1479         end.
     1480         when 1 then do:
     1481             assign
     1482               loc-name = trim(entry ( 1 , v-font7 ))
     1483               loc-size = ""
     1484               loc-type = ""
     1485             .
     1486         end.
     1487       end case.
     1488     create temp-font.
     1489     assign
     1490       temp-font.fontnum  = 7
     1491       temp-font.fontname = trim(loc-name)
     1492       temp-font.fontsize = trim(loc-size)
     1493       temp-font.fonttype = trim(loc-type)
     1494       temp-font.v-row    = 62
     1495       temp-font.v-col    = 136
     1496       temp-font.v-row-lans = 43
     1497       temp-font.v-col-lans = 198
     1498     .
     1499     repeat ii = 16 to 100 :
     1500       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1501       if v-font = "" or v-font = ? then leave.
     1502       case num-entries (v-font) :
     1503         when 4 then do:
     1504             assign
     1505               loc-name = entry ( 1 , v-font )
     1506               loc-size = entry ( 2 , v-font )
     1507               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1508             .
     1509         end.
     1510         when 3 then do:
     1511             assign
     1512               loc-name = entry ( 1 , v-font )
     1513               loc-size = entry ( 2 , v-font )
     1514               loc-type = entry ( 3 , v-font )
     1515             .
     1516         end.
     1517         when 2 then do:
     1518             assign
     1519               loc-name = entry ( 1 , v-font )
     1520               loc-size = entry ( 2 , v-font )
     1521               loc-type = ""
     1522             .
     1523         end.
     1524         when 1 then do:
     1525             assign
     1526               loc-name = trim(entry ( 1 , v-font ))
     1527               loc-size = ""
     1528               loc-type = ""
     1529             .
     1530         end.
     1531       end case.
     1532     create temp-font.
     1533     assign
     1534       temp-font.fontnum  = ii
     1535       temp-font.fontname = trim(loc-name)
     1536       temp-font.fontsize = trim(loc-size)
     1537       temp-font.fonttype = trim(loc-type)
     1538     .
     1539     end.
     1540       for each temp-font :
     1541          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1542          if  vv = ? then vv =  0 .
     1543           run rep/exfont.p (
     1544             input   temp-font.fontname ,
     1545             input   vv ,
     1546             input   temp-font.fonttype ,
     1547             output  temp-font.font-h   ,
     1548             output  temp-font.font-w   )
     1549           .
     1550       end.
     1551   find first temp-font where  temp-font.fontnum  = 7  .
     1552   old_H = temp-font.font-H .
     1553   old_w = temp-font.font-W .
     1554   old-row = temp-font.v-row .
     1555   old-col = temp-font.v-col .
     1556   old-row-lans = temp-font.v-row-lans .
     1557   old-col-lans = temp-font.v-col-lans .
     1558       for each temp-font where
     1559                temp-font.fontnum  <> 7 :
     1560           assign
     1561               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1562               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1563               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1564               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1565           .
     1566       end.
     1567     end.
     1568   end procedure.
     1569   PROCEDURE How-name :
     1570   define input  parameter h as integer no-undo .
     1571   define input  parameter w as integer no-undo .
     1572   define output parameter n as character  no-undo .
     1573   define variable A4port-H as integer   no-undo init 63.
     1574   define variable A4port-W as integer   no-undo init 136.
     1575   define variable A4lans-H as integer   no-undo init 43.
     1576   define variable A4lans-W as integer   no-undo init 198.
     1577   define variable Strim-W  as integer   no-undo init 278.
     1578   run define-a4-size (
     1579        input ReportFontNum
     1580       ,output A4port-H
     1581       ,output A4port-W
     1582       ,output A4lans-H
     1583       ,output A4lans-W ).
     1584   If w >= 1 and w <= A4port-W Then DO:
     1585     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1586     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1587     If h > A4port-H              Then n = "to-file":U.
     1588   End.
     1589   If w > A4port-W and w <= A4lans-W Then DO:
     1590     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1591     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1592     If h > A4port-H              Then n = "to-file":U.
     1593   End.
     1594   If w > A4lans-W and w <= Strim-W Then DO:
     1595     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1596     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1597     If h > A4port-H              Then n = "to-file":U.
     1598   End.
     1599   If w > Strim-W Then DO:
     1600      n = "to-file":U.
     1601   End.
     1602   END PROCEDURE.
     1603   PROCEDURE define-a4-size :
     1604   define input  parameter p-ReportFontNum as integer   no-undo .
     1605   define output parameter A4port-H as integer   no-undo .
     1606   define output parameter A4port-W as integer   no-undo .
     1607   define output parameter A4lans-H as integer   no-undo .
     1608   define output parameter A4lans-W as integer   no-undo .
     1609   if not can-find (first temp-font ) then do:
     1610      run get-font-ini .
     1611   end.
     1612   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1613   if available temp-font then do:
     1614   assign
     1615     A4port-H = temp-font.v-row
     1616     A4port-W = temp-font.v-col
     1617     A4lans-H = temp-font.v-row-lans
     1618     A4lans-W = temp-font.v-col-lans
     1619   .
     1620   end.
     1621   else do:
     1622   assign
     1623     A4port-H = 63
     1624     A4port-W = 136
     1625     A4lans-H = 43
     1626     A4lans-W = 198
     1627   .
     1628   end.
     1629   END PROCEDURE.
