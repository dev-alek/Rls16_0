     2239    ostatok-end [3 + 6]   = if tprintrubl then vat_r   else vat_v
     2240    ostatok-end [10]        = if tprintrubl then slt_r   else slt_v
     2241    b1-ostatok-end [1 + 6] =  b1-ostatok-end [1 + 6] + ostatok-end [1 + 6]
     2242    b1-ostatok-end [2 + 6] =  b1-ostatok-end [2 + 6] + ostatok-end [2 + 6]
