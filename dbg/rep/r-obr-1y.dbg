     2627                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2628                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2629                       Create temp-gds-list.
     2630                       Assign
     2631                         temp-gds-list.prod-code = gds-obj.prod-code
     2632                         temp-gds-list.grp-name  = gds-obj.grp-name
     2633                         temp-gds-list.gds-name  = goods.gds-name
     2634                         temp-gds-list.gds-code  = gds-obj.gds-code
     2635                         temp-gds-list.artic     = gds-obj.artic
     2636                       .
     2637                   End.
     2638               End.
     2639     End.
     2640     for each temp-gds-list no-lock
     2641       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2642         BREAK
     2643       BY gds-list.artic :
     2644       run item-goods ( "1" , "gds-list" ) .
     2645         if return-value <> "" then NEXT.
     2646     End.
     2647   End.
     2648           end.
     2649           end case.
     2650   end procedure.
     2651   procedure calcitog :
     2652       run ostatok  in this-procedure(
     2653           input x-store-code  ,
     2654           input x-store-type  ,x-tog-shift,
     2655           input x-date-start - 1 ,
     2656           input date('')      , x-shift-start,x-shift-end,
     2657           input 'crsa':U   ,
     2658           input '##,##':U,
     2659           input xtog-obj ,
     2660           output  quantity1  ,
     2661           output  coast_r1   ,
     2662           output  coast_v1   ,
     2663           output  vat_r1     ,
     2664           output  vat_v1     ,
     2665           output  fact-order-1 ).
     2666       run ostatok  in this-procedure (
     2667           input x-store-code  ,
     2668           input x-store-type  , x-tog-shift,
     2669           input x-date-start  ,
     2670           input x-date-end    , x-shift-start,x-shift-end,
     2671           input 'crsa':U   ,
     2672           input '##,##':U,
     2673           input xtog-obj ,
     2674           output  quantity1  ,
     2675           output  coast_r1   ,
     2676           output  coast_v1   ,
     2677           output  vat_r1     ,
     2678           output  vat_v1     ,
     2679           output  fact-order-2 ).
     2680             quantity1  = 0.
     2681             coast_r1   = 0.
     2682             coast_v1   = 0.
     2683             vat_r1     = 0.
     2684             vat_v1     = 0.
     2685   end procedure.
     2686   procedure display-str1  :
     2687              run di-qnty  in this-procedure("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2688            if xshowcost    then do: run di  in this-procedure( "учет.", 2,"","","","",""). end.
     2689            if xshowcrsa    then do: run di  in this-procedure( "прод.", 5,"","","","","" ).  end.
     2690            if xshowsale    then do: run di  in this-procedure( "док." , 8,"","","","","" ).  end.
     2691            if vat-cost    then do: run di  in this-procedure( "уч.НДС", 3,"","","","","" ). end.
     2692            if vat-crsa    then do: run di  in this-procedure( "пр.НДС", 6,"","","","","" ).  end.
     2693            if vat-sale    then do: run di  in this-procedure( "дк.НДС", 9,"","","","","" ).  end.
     2694   end procedure.
     2695   procedure display-bi  :
