     3565   procedure oborot-stk :
     3566   define input  parameter l-store-code   like ub.clients.obj-code      no-undo.
     3567   define input  parameter l-store-type   like ub.clients.obj-type      no-undo.
     3568   define input  parameter l-artic        like ub.stk-line.artic        no-undo.
     3569   define input  parameter l-prod-code    like ub.stk-line.prod-code    no-undo.
     3570   define input  parameter l-prod-type    like ub.stk-line.prod-type    no-undo.
     3571   define input  parameter l-tog-shift    as   logical                  no-undo.
     3572   define input  parameter l-fact-order-1   like ub.stk-line.fact-order   no-undo.
     3573   define input  parameter l-fact-order-2   like ub.stk-line.fact-order   no-undo.
     3574   define input  parameter l-sum-type     like ub.stk-line.sum-type     no-undo.
     3575   define input  parameter l-cat-id       like ub.stk-line.cat-id       no-undo.
     3576   define input  parameter l-tog-obj       as log no-undo.
     3577   define output parameter quantity    like ub.stk-line.fact-qnty   no-undo.
     3578   define output parameter coast_r     like ub.stk-line.sum-rubl    no-undo.
     3579   define output parameter coast_v     like ub.stk-line.sum-rubl    no-undo.
     3580   define output parameter vat_r       like ub.stk-line.sum-rubl    no-undo.
     3581   define output parameter vat_v       like ub.stk-line.sum-rubl    no-undo.
     3582   define output parameter slt_r       like ub.stk-line.sum-rubl    no-undo.
     3583   define output parameter slt_v       like ub.stk-line.sum-rubl    no-undo.
     3584   define output parameter other_r     like ub.stk-line.sum-rubl    no-undo.
     3585   define output parameter other_v     like ub.stk-line.sum-rubl    no-undo.
     3586   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3587   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3588   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3589   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3590   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3591   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3592   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3593   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3594   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3595   define variable  quantity#2    like ub.stk-line.fact-qnty   no-undo.
     3596   define variable  coast_r#2     like ub.stk-line.sum-rubl    no-undo.
     3597   define variable  coast_v#2     like ub.stk-line.sum-rubl    no-undo.
     3598   define variable  vat_r#2       like ub.stk-line.sum-rubl    no-undo.
     3599   define variable  vat_v#2       like ub.stk-line.sum-rubl    no-undo.
     3600   define variable  slt_r#2       like ub.stk-line.sum-rubl    no-undo.
     3601   define variable  slt_v#2       like ub.stk-line.sum-rubl    no-undo.
     3602   define variable  other_r#2     like ub.stk-line.sum-rubl    no-undo.
     3603   define variable  other_v#2     like ub.stk-line.sum-rubl    no-undo.
     3604   run ost-lineother-tax  in this-procedure
     3605    (  input   l-store-code  ,
     3606       input   l-store-type  ,
     3607       input   l-artic       ,
     3608       input   l-prod-code   ,
     3609       input   l-prod-type   ,
     3610       input   l-tog-shift   ,
     3611       input   l-fact-order-1,
     3612       input   l-sum-type    ,
     3613       input   l-cat-id      ,
     3614       input   l-tog-obj     ,
     3615       output  quantity#1 ,
     3616       output  coast_r#1  ,
     3617       output  coast_v#1  ,
     3618       output  vat_r#1    ,
     3619       output  vat_v#1    ,
     3620       output  slt_r#1    ,
     3621       output  slt_v#1    ,
     3622       output  other_r#1  ,
     3623       output  other_v#1  ).
     3624   run ost-lineother-tax  in this-procedure
     3625    (  input   l-store-code  ,
     3626       input   l-store-type  ,
     3627       input   l-artic       ,
     3628       input   l-prod-code   ,
     3629       input   l-prod-type   ,
     3630       input   l-tog-shift   ,
     3631       input   l-fact-order-2,
     3632       input   l-sum-type    ,
     3633       input   l-cat-id      ,
     3634       input   l-tog-obj     ,
     3635       output  quantity#2 ,
     3636       output  coast_r#2  ,
     3637       output  coast_v#2  ,
     3638       output  vat_r#2    ,
     3639       output  vat_v#2    ,
     3640       output  slt_r#2    ,
     3641       output  slt_v#2    ,
     3642       output  other_r#2  ,
     3643       output  other_v#2  ).
     3644       assign
     3645         quantity =   quantity#2 -  quantity#1
     3646         coast_r  =   coast_r#2  -  coast_r#1
     3647         coast_v  =   coast_v#2  -  coast_v#1
     3648         vat_r    =   vat_r#2    -  vat_r#1
     3649         vat_v    =   vat_v#2    -  vat_v#1
     3650         slt_r    =   slt_r#2    -  slt_r#1
     3651         slt_v    =   slt_v#2    -  slt_v#1
     3652         other_r  =   other_r#2  -  other_r#1
     3653         other_v  =   other_v#2  -  other_v#1
     3654         .
     3655    end procedure.
