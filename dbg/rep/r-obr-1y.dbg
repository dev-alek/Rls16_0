     2356   procedure display-line :
     2357        i = i + 1.
     2358           if not( not show-negativ-2 and
     2359            ( prih         [1]   = 0 and
     2360             rash          [1]   = 0 and
     2361             kassa         [1]   = 0 and
     2362             inv           [1]   = 0 and
     2363             overturn      [1]   = 0 and
     2364             overturn      [5]   = 0 and
     2365             gds-zap-other       = 0 and
     2366             overturn      [8]   = 0 ) ) then do:
     2367           if  not (not show-negativ  and (
     2368                 prih          [1]   = 0 and
     2369                 rash          [1]   = 0 and
     2370                 kassa         [1]   = 0 and
     2371                 inv           [1]   = 0 and
     2372                 overturn      [1]   = 0 and
     2373                 overturn      [5]   = 0 and
     2374                 gds-zap-other       = 0 and
     2375                 ostatok-start [1]   = 0 and
     2376                 ostatok-end   [1]   = 0   )) then do:
     2377           if not sums-only then do:
     2378               if fr0 = true then do:
     2379                 put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2380                 if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2381                 fr0 = false .
     2382               end.
     2383               if fr = true then do:
     2384                 put stream outstream space(10) temp-str format "x(100)" skip.
     2385                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) string(temp-str) skip.
     2386                 fr = false .
     2387               end.
     2388              run display-str1 in this-procedure.
     2389             end.
     2390           end.
     2391        end.
     2392     end procedure.
     2393   procedure print-header :
     2394   if not firstline then do:
     2395      run display-title  in this-procedure.
     2396      form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2397   end.
     2398    firstline = true .
     2399       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2400             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + caps(clients.obj-name)  at 30 format "x(170)" skip.
     2401             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + caps(clients.obj-name) format "x(170)" skip.
     2402         end.
     2403         run clear-b1  in this-procedure.
     2404         run clear-b2  in this-procedure.
     2405         run clear-bi  in this-procedure.
     2406         break_group = true.
     2407         break_group1 = true.
     2408      end procedure.
     2409   procedure print-footer :
     2410         if retclassify = "no-classify":u  then run u-line in this-procedure.
     2411          gds-zap-artic = "ИТОГО" .
     2412          run display-bi  in this-procedure.
     2413          run u-line in this-procedure.
     2414          end procedure.
