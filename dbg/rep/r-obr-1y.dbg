     2453   procedure run1sort2 :
     2454          case select-good :
     2455           when 1  then do:
     2456   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2457   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2458       for each gds-obj  where
     2459             gds-obj.obj-type = x-store-type  and
     2460             gds-obj.obj-code = x-store-code
     2461             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2462                   no-lock,
     2463             First goods  where  gds-obj.gds-code   = goods.gds-code
     2464   no-lock
     2465   BREAK
     2466       BY (goods.artic) :
     2467         run item-goods ( "1" , "goods" ) .
     2468         if return-value <> "" then NEXT.
     2469       End.
     2470     END.
     2471     Else DO:
     2472      For each obj-list no-lock :
     2473                     FOR EACH gds-obj where
     2474                   gds-obj.obj-type = obj-list.obj-type    and
     2475                   gds-obj.obj-code = obj-list.obj-code
     2476                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2477                   no-lock :
     2478                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2479                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2480                       Create temp-gds-list.
     2481                       Assign
     2482                         temp-gds-list.prod-code = gds-obj.prod-code
     2483                         temp-gds-list.grp-name  = gds-obj.grp-name
     2484                         temp-gds-list.gds-name  = goods.gds-name
     2485                         temp-gds-list.gds-code  = gds-obj.gds-code
     2486                         temp-gds-list.artic     = gds-obj.artic
     2487                       .
     2488                   End.
     2489               End.
     2490     End.
     2491     for each temp-gds-list no-lock
     2492       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2493         BREAK
     2494       BY goods.artic :
     2495       run item-goods ( "1" , "goods" ) .
     2496         if return-value <> "" then NEXT.
     2497     End.
     2498   End.
     2499     end.
     2500           when 2  then do:
