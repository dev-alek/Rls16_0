     2706            if xshowcost    then do: run di in this-procedure ("учет." , 2 , "","", "", "", "bo":u).  end.
     2707            if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "",  "bo":u).  end.
     2708            if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "",  "bo":u).  end.
     2709            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","bo":u ). end.
     2710            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","bo":u ).  end.
     2711            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","bo":u ).  end.
     2712   end procedure.
     2713   procedure display-b1  :
     2714        if not( not show-negativ-2 and
     2715            ( b1-prih         [1]   = 0 and
     2716              b1-rash          [1]   = 0 and
     2717              b1-kassa         [1]   = 0 and
     2718              b1-inv           [1]   = 0 and
     2719              b1-overturn      [1]   = 0 and
     2720              b1-overturn      [5]   = 0 and
     2721              b1-gds-zap-other       = 0 and
     2722              b1-overturn      [8]   = 0 ) ) then do:
     2723           if  not (not show-negativ  and (
     2724                 b1-prih          [1]   = 0 and
     2725                 b1-rash          [1]   = 0 and
     2726                 b1-kassa         [1]   = 0 and
     2727                 b1-inv           [1]   = 0 and
     2728                 b1-gds-zap-other       = 0 and
     2729                 b1-overturn      [1]   = 0 and
     2730                 b1-overturn      [5]   = 0 and
     2731                 b1-ostatok-start [1]   = 0 and
     2732                 b1-ostatok-end   [1]   = 0   )) then do:
     2733                 if sums-only then do:
     2734                     if fr0 = true then do:
     2735                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2736                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2737                         fr0 = false .
     2738                       end.
     2739                  end.
     2740           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2741           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2742           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2743           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2744           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2745           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2746           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2747          if not sums-only then run p-line.
     2748    end.
     2749    end.
     2750   end procedure.
     2751   procedure display-b2  :
     2752        if not( not show-negativ-2 and
     2753            ( b2-prih         [1]   = 0 and
     2754              b2-rash          [1]   = 0 and
     2755              b2-kassa         [1]   = 0 and
     2756              b2-inv           [1]   = 0 and
     2757              b2-gds-zap-other       = 0 and
     2758              b2-overturn      [1]   = 0 and
     2759              b2-overturn      [5]   = 0 and
     2760              b2-overturn      [8]   = 0 ) ) then do:
     2761           if  not (not show-negativ  and (
     2762                 b2-prih          [1]   = 0 and
     2763                 b2-rash          [1]   = 0 and
     2764                 b2-kassa         [1]   = 0 and
     2765                 b2-inv           [1]   = 0 and
     2766                 b2-gds-zap-other       = 0 and
     2767                 b2-overturn      [1]   = 0 and
     2768                 b2-overturn      [5]   = 0 and
     2769                 b2-ostatok-start [1]   = 0 and
     2770                 b2-ostatok-end   [1]   = 0   )) then do:
     2771           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     2772           if xshowcost    then do: run di in this-procedure ("учет.", 2, "","", "", "", "b2":u).  end.
     2773           if xshowcrsa    then do: run di in this-procedure ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2774           if xshowsale    then do: run di in this-procedure ("док.", 8 ,"","", "", "", "b2":u).  end.
     2775            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b2":u ). end.
     2776            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2777            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2778            if not sums-only then run u-line.
     2779    end.
     2780   end.
     2781   end procedure.
     2782   procedure clear-b1  :
     2783    b1-gds-zap-other           = 0.
     2784    repeat kk = 1 to 9 :
     2785    assign
     2786       b1-prih                                            [kk]    = 0
     2787       b1-rash                                            [kk]    = 0
     2788       b1-kassa                                           [kk]    = 0
     2789       b1-inv                                             [kk]    = 0
     2790       b1-overturn                                        [kk]    = 0
     2791       b1-ostatok-end                                     [kk]    = 0
     2792       b1-ostatok-start                                   [kk]    = 0   .
     2793      end.
     2794    end procedure.
     2795   procedure clear-b2  :
     2796    b2-gds-zap-other           = 0.
     2797    repeat kk = 1 to 9 :
     2798    assign
     2799       b2-prih                                            [kk]    = 0
     2800       b2-rash                                            [kk]    = 0
     2801       b2-kassa                                           [kk]    = 0
     2802       b2-inv                                             [kk]    = 0
     2803       b2-overturn                                        [kk]    = 0
     2804       b2-ostatok-end                                     [kk]    = 0
     2805       b2-ostatok-start                                   [kk]    = 0   .
     2806      end.
     2807   end procedure.
     2808   procedure clear-bi  :
     2809    bi-gds-zap-other           = 0.
     2810    repeat kk = 1 to 9 :
     2811    assign
     2812       bi-prih                                            [kk]    = 0
     2813       bi-rash                                            [kk]    = 0
     2814       bi-kassa                                           [kk]    = 0
     2815       bi-inv                                             [kk]    = 0
     2816       bi-overturn                                        [kk]    = 0
     2817       bi-ostatok-end                                     [kk]    = 0
     2818       bi-ostatok-start                                   [kk]    = 0   .
     2819      end.
     2820   end procedure.
     2821   procedure display-title :
     2822      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2823             reportname  at 20 format "x(170)" skip
     2824             trim(str1)  at 35 format "x(75)" skip.
     2825        repeat i = 1 to num-entries(str2,chr(10)) :
     2826         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2827        end.
     2828       i=0.
     2829          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2830        repeat i = 1 to num-entries(str4,chr(10)) :
     2831         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2832        end.
     2833       i=0.
     2834        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2835         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2836        end.
     2837       i=0.
     2838       run rep/extitle.p (1) .
     2839   end procedure.
     2840   procedure ob-line  :
     2841   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2842   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2843   define input  parameter x-artic        like ub.ot-line.artic        no-undo.
     2844   define input  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2845   define input  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2846   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     2847   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     2848   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2849   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2850   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2851   define input  parameter xtog-obj           as log no-undo.
     2852   define variable  tt#          as   int                 no-undo.
     2853   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     2854   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     2855   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     2856   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     2857   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     2858   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     2859   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     2860   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     2861   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     2862   define variable  l-sum-type as character no-undo .
     2863   define variable  l-cat-id   as character no-undo .
     2864   define variable v-s# as character no-undo .
     2865    if (x-sum-type = 'sale':U ) then assign tt# = 6 v-s# = 'sadt':U .
     2866    if (x-sum-type = 'crsa':U ) then assign tt# = 3 v-s# = 'cgdt':U .
     2867    if (x-sum-type = 'cost':U ) then assign tt# = 0 v-s# = 'csdt':U .
     2868    if (x-sum-type = 'sasr':U) then assign tt# = 6 v-s# = 'adsr':U .
     2869    if (x-sum-type = 'cgsr':U) then assign tt# = 3 v-s# = 'gdsr':U .
     2870    if (x-sum-type = 'cssr':U) then assign tt# = 0 v-s# = 'sdsr':U .
     2871   define variable v-i as integer no-undo .
     2872   repeat v-i = 1 to  extent(m-prih) :
     2873    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input v-s# + m-prih[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2874       assign prih[1 + tt#]   = prih[1 + tt#] + quantity#1
     2875              prih[2 + tt#]   = prih[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     2876              prih[3 + tt#]   = prih[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     2877       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2878   end.
     2879   repeat v-i = 1 to  extent(m-rash) :
     2880    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-rash[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2881       assign rash[1 + tt#]   = rash[1 + tt#] +  quantity#1
     2882              rash[2 + tt#]   = rash[2 + tt#] +  if tprintrubl then coast_r#1 else coast_v#1
     2883              rash[3 + tt#]   = rash[3 + tt#] +  if tprintrubl then vat_r#1   else vat_v#1 .
     2884       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2885   end.
     2886   repeat v-i = 1 to  extent(m-kassa) :
     2887    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-kassa[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2888       assign kassa[1 + tt#]   = kassa[1 + tt#] + quantity#1
     2889              kassa[2 + tt#]   = kassa[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     2890              kassa[3 + tt#]   = kassa[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     2891       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2892    end.
     2893   repeat v-i = 1 to  extent(m-inv) :
     2894    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-inv[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2895       assign inv[1 + tt#]   = inv[1 + tt#] + quantity#1
     2896              inv[2 + tt#]   = inv[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     2897              inv[3 + tt#]   = inv[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     2898       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2899   end.
     2900   repeat v-i = 1 to  extent(m-overturn) :
     2901    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-overturn[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2902       assign overturn[1 + tt#]   = overturn[1 + tt#] + quantity#1
     2903              overturn[2 + tt#]   = overturn[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     2904              overturn[3 + tt#]   = overturn[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     2905       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2906   end.
     2907     if tt# = 6 then do:
     2908          if (x-sum-type = 'sasr':U) then do:
     2909              assign
     2910              prih[1 ]   = prih[7 ]
     2911              rash[1 ]   = rash[7 ]
     2912              kassa[1]   = kassa[7]
     2913              inv[1]     = inv[7  ]
     2914              .
     2915              end.
     2916              assign overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2917                     overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  +  gds-zap-other )
     2918                     overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2919     end.
     2920   end procedure.
     2921   procedure report-exec1  :
     2922      find first clients where x-store-type = clients.obj-type and
     2923                               x-store-code = clients.obj-code no-lock no-error.
     2924   IF ( i modulo v-account = 0 )  then DO:
     2925    Assign
     2926       v-kol-spice = (50 - LENGTH(clients.obj-name)) / 2
     2927       RecordsString = fill(' ',v-kol-spice) + string(clients.obj-name)
     2928       .
     2929             if  log-manager:logfile-name ne ?
     2930             then DO:
     2931                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2932             end.
     2933              if mFrameView
     2934              then do:
     2935               DISPLAY
     2936                 i @ RecordsDone
     2937                 RecordsString   @ RecordsString
     2938                 WITH FRAME InfoFrame.
     2939              end.
     2940   End.
     2941      if v-button-stop then  DO:
     2942            if mFrameView
     2943            then
     2944               PROCESS EVENTS.
     2945            IF StopProcessing THEN DO:
     2946            RETURN error.
     2947            End.
     2948      end.
     2949     run calcitog.
     2950     run print-header.
     2951      case retclassify :
     2952        when "no-classify":u  then   run run1.
     2953      end case.
     2954     run print-footer.
     2955     end procedure.
     2956   procedure calc-sub-itog :
     2957   define input parameter tt as int no-undo.
     2958   define variable b as int no-undo.
     2959   if tt = 6  then assign
     2960     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     2961     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     2962     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     2963     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     2964     .
     2965   repeat b = 1 to 3:
     2966     assign
     2967     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     2968     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     2969     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     2970     bo-prih[b + tt]    = bo-prih[b + tt]    +  prih[b + tt]
     2971     bo-ostatok-start[b + tt]    = bo-ostatok-start[b + tt]    +  ostatok-start[b + tt]
     2972     bo-ostatok-end[b + tt]      = bo-ostatok-end[b + tt]      +  ostatok-end[b + tt]
     2973     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     2974     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     2975     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     2976     bo-rash[b + tt]    = bo-rash[b + tt]    +  rash[b + tt]
     2977     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     2978     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     2979     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     2980     bo-kassa[b + tt]    = bo-kassa[b + tt]    +  kassa[b + tt]
     2981     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     2982     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     2983     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     2984     bo-inv[b + tt]    = bo-inv[b + tt]    +  inv[b + tt]
     2985     b1-overturn[b + tt]    = b1-overturn[b + tt]    +  overturn[b + tt]
     2986     b2-overturn[b + tt]    = b2-overturn[b + tt]    +  overturn[b + tt]
     2987     bi-overturn[b + tt]    = bi-overturn[b + tt]    +  overturn[b + tt]
     2988     bo-overturn[b + tt]    = bo-overturn[b + tt]    +  overturn[b + tt] .
     2989   end.
     2990   end procedure.
     2991   procedure clear-item :
     2992   define variable kk as int no-undo.
     2993    gds-zap-other = 0 .
     2994    repeat kk = 1 to 9 :
     2995    assign
     2996       prih            [kk]    = 0
     2997       rash            [kk]    = 0
     2998       kassa           [kk]    = 0
     2999       inv             [kk]    = 0
     3000       overturn        [kk]    = 0
     3001       ostatok-end     [kk]    = 0
     3002       ostatok-start   [kk]    = 0 .
     3003          end.
     3004    end procedure.
     3005   procedure item-goods :
     3006      define input parameter  par-3 as char no-undo.
     3007      define input parameter  par-4 as char no-undo.
     3008        if par-4 = "goods":u  then do:
     3009           assign
     3010               gds-zap-unit-base  = goods.unit-base
     3011               gds-zap-prt-root   = goods.prt-root
     3012               gds-zap-prod-type  = goods.prod-type
     3013               gds-zap-prod-code  = goods.prod-code
     3014               gds-zap-artic      = goods.artic
     3015               gds-zap-grp-name   = goods.grp-name
     3016               gds-zap-b-code     = goods.gds-code
     3017               gds-zap-type       = goods.gds-type.
     3018           if g#gds-engl then
     3019               assign gds-zap-gds-name = goods.engl-name.
     3020           else
     3021               assign gds-zap-gds-name = goods.gds-name.
     3022        end.
     3023        if par-4 = "gds-list":u  then do:
     3024           assign
     3025               gds-zap-unit-base  = gds-list.unit-base
     3026               gds-zap-prt-root   = gds-list.prt-root
     3027               gds-zap-prod-type  = gds-list.prod-type
     3028               gds-zap-prod-code  = gds-list.prod-code
     3029               gds-zap-artic      = gds-list.artic
     3030               gds-zap-grp-name   = gds-list.grp-name
     3031               gds-zap-b-code     = gds-list.gds-code
     3032               gds-zap-type       = gds-list.gds-type.
     3033           if g#gds-engl then
     3034               assign gds-zap-gds-name = gds-list.engl-name.
     3035           else
     3036               assign gds-zap-gds-name = gds-list.gds-name.
     3037       end.
     3038       run foreach  in this-procedure.
     3039   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3040     (input  gds-zap-b-code
     3041     ,input  ?
     3042     ,output v-bar-code
     3043     )  .
     3044   s-bar-code = string (v-bar-code,"999999999").
     3045       If  break_group = true  and par-3 <> "1"  then DO :
     3046            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3047            gds-zap-prod-name  = clients.obj-name.
     3048             If break_group1 = true  THEN  DO :
     3049               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3050                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3051                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3052               if par-3 = "6"  then  dO:
     3053                  if xTog-obj = true then do:
     3054                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3055                     .
     3056                   end.
     3057                  else do:
     3058                   var-vat-pc = temp-gds-list.vat-pc .
     3059                   end.
     3060                   assign
     3061                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3062                       b1-name = temp-str.
     3063                   end.
     3064               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3065                   fr0 = true .
     3066                   tmp#stroka0 = temp-str.
     3067               End.
     3068             End.
     3069               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3070                 if par-3 = "4"
     3071                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3072                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3073                 if NOT xSumsOnly THEN DO:
     3074                     fr = true .
     3075                 End.
     3076                 break_group1 = false.
     3077               END.
     3078          break_group = false.
     3079       End.
     3080       run display-line  in this-procedure.
     3081    end procedure.
     3082   procedure di :
