     2697            if xshowcost    then do: run di in this-procedure ("учет." , 2 , "","", "", "", "bi":u).  end.
     2698            if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "",  "bi":u).  end.
     2699            if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "",  "bi":u).  end.
     2700            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","bi":u ). end.
     2701            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","bi":u ).  end.
     2702            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","bi":u ).  end.
     2703   end procedure.
     2704   procedure display-bo  :
