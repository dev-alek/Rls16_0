     1826           sym11 column-label ":!:!:" format "x(1)" space(0)
     1827           gds-zap-other      column-label "Скидка! ! ":c13     space(0)
     1828           sym12 column-label ":!:!:" format "x(1)" space(0)
     1829           f-ostatok-end     column-label "Остаток!на конец! ":c14 format "x(14)"           space(0)
     1830       header
     1831            cur-time-print() at 5 format "x(35)"
     1832           "Цены указаны в" (if tprintrubl then "РУБ" else x-base-type )
     1833           string( "Страница " + string( page-number( outstream ), ">>>>>9") ) at 147 format "x(53)" skip
     1834           line format "x(194)" at 1
     1835      with width 232 down stream-io use-text no-box.
     1836   define variable v-account as integer init 0 no-undo .
     1837   define variable v-account-lavel as character no-undo .
     1838   define variable v-button-stop as logical no-undo .
     1839   define variable v-kol-spice as integer no-undo .
     1840   define variable v-kol-spice2 as integer no-undo .
     1841   define variable v-kol-spice3 as integer no-undo .
     1842   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1843   DEFINE BUTTON StopBtn AUTO-END-KEY
     1844        LABEL "Стоп"
     1845        SIZE 10 BY 1.
     1846   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1847        LABEL "Обработано записей"
     1848         VIEW-AS TEXT
     1849        SIZE 14 BY .67 NO-UNDO.
     1850   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1851         VIEW-AS TEXT
     1852        SIZE 53.25 BY .67
     1853        FGCOLOR 1  NO-UNDO.
     1854   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1855         VIEW-AS TEXT
     1856        SIZE 53.25 BY .67
     1857        FGCOLOR 1  NO-UNDO.
     1858   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1859         VIEW-AS TEXT
     1860        SIZE 53.25 BY .67
     1861        FGCOLOR 1  NO-UNDO.
     1862   DEFINE RECTANGLE RECT-1
     1863        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1864        SIZE 55.13 BY 4.46.
     1865   DEFINE FRAME InfoFrame
     1866        StopBtn AT ROW 4.25 COL 21.75
     1867        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1868        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1869        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1870        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1871        RECT-1 AT ROW 1 COL 1
     1872       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1873            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1874            TITLE "Процесс"
     1875            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1876   define variable mFrameView      as logical   no-undo init yes.
     1877     define variable mFramHandle as handle no-undo.
     1878     mFramHandle = frame InfoFrame:handle.
     1879     if  log-manager:logfile-name ne ?
     1880     then DO:
     1881         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1882         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1883         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1884     end.
     1885     mFrameView = not session:batch-mode and mFramHandle:visible.
     1886     if mFrameView
     1887     then do:
     1888       ASSIGN
     1889          FRAME InfoFrame:HIDDEN                           = TRUE
     1890          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1891     end.
     1892   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1893   DO:
     1894     IF not StopProcessing THEN
     1895       Message "Вы действительно хотите прервать" SKIP
     1896               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1897                 UPDATE StopProcessing.
     1898     IF StopProcessing THEN do:
     1899        if mFrameView
     1900        then do:
     1901           HIDE FRAME InfoFrame.
     1902        end.
     1903     End.
     1904   END.
     1905        assign
     1906           i=0
     1907           xlavel = xvar-lavel
     1908           select-good   = x-selectgood
     1909           paytype       = x-set_pay_type
     1910           retclassify   = xclassify
     1911           retsorttype   = xsorttype
     1912           sums-only     = xsumsonly
     1913           show-negativ  = xshowzero
     1914           show-negativ-2  = xshowzero-2
     1915           xshowcost     = show-cost
     1916           xshowsale     = show-sale
     1917           xshowcrsa     = show-crsa
     1918           firstline     = false
     1919           line          = fill("-", 232)
     1920           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     1921        run report-execute  in this-procedure .
     1922   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1923   define variable  str  as char format "X(60)"  no-undo.
     1924   define variable  str2 as char no-undo.
     1925   define variable v-r as character no-undo init "" .
     1926   define variable  i#i as int no-undo.
     1927   STR = "".
     1928   repeat i#i =1 to lavel#:
     1929       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1930       else do:
     1931           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1932           if not error-status:error  and str2 <> "":u then
     1933                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1934           end.
     1935   end.
     1936   if str <> ? then do:
     1937   v-r = str + chr(47) .
     1938   end.
     1939   RETURN v-r .
     1940   END FUNCTION.
     1941   procedure report-execute :
     1942   define variable gj as integer no-undo init 0.
     1943     if (valtype=0 and x-base-code=0)  or valtype=1
     1944                                   then   assign tprintrubl = yes .
     1945                                   else   assign tprintrubl = no .
     1946   assign v-account = ( if integer( 30 ) = 0 then 100 else integer( 30 ) ).
     1947     if  log-manager:logfile-name ne ?
     1948     then DO:
     1949         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1950     end.
     1951     if not session:batch-mode then
     1952     do:
     1953       VIEW FRAME InfoFrame.
     1954       mFrameView = true.
     1955     end.
     1956      v-button-stop = false .
     1957         if mFrameView
     1958         then do:
     1959         if v-button-stop then view STOPBTN in frame InfoFrame.
     1960                          else Hide STOPBTN in frame InfoFrame.
     1961         end.
     1962     if reportpageheight = 0 then reportpageheight  = 43.
     1963   output stream outstream to value( string( session:temp-directory +
     1964                                        "rpt" + string( g#report-num ) ) )
     1965                                        page-size  value(reportpageheight) .
     1966     find first clients where x-store-type = clients.obj-type and
     1967                              x-store-code = clients.obj-code no-lock no-error.
     1968     if available clients then  objname = clients.obj-name.
     1969                                   else  objname="объект не определен".
     1970   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1971   form header
     1972     line format "x(194)" at 1 skip
     1973     "Продолжение - на следующей странице" at 30 skip
     1974     with frame bottomframe width 232 page-bottom no-labels no-box .
     1975   view stream outstream frame bottomframe .
     1976          for each obj-list no-lock:
     1977             x-store-type = obj-list.obj-type.
     1978             x-store-code = obj-list.obj-code.
     1979             gj = gj + 1.
     1980             run report-exec1  in this-procedure.
     1981         end.
     1982         if gj > 1 then do:
     1983           hide stream outstream frame bottomframe .
     1984           run display-bo in this-procedure.
     1985           run u-line in this-procedure.
     1986         end.
     1987     hide stream outstream frame bottomframe .
     1988     hide   stream outstream frame zapas .
     1989     output stream outstream close.
     1990   if mFrameView
     1991   then do:
     1992      HIDE FRAME InfoFrame.
     1993   end.
     1994     if Make-Excel then output stream ForExcel close.
     1995     define variable v-user-action as character no-undo .
     1996     define variable v-printed as logical   no-undo .
     1997     define variable disabledoptions as integer   no-undo .
     1998     define variable v-orient-page as character no-undo .
     1999     run How-name in this-procedure (
     2000         input ReportPageHeight,
     2001         input ReportPageWidth,
     2002         output v-orient-page )
     2003         .
     2004     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2005                                    else DisabledOptions = 0 .
     2006     run gbl/prnfilen.w
     2007       (input  ""
     2008       ,input  disabledoptions
     2009       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2010       ,input  ReportFontNum
     2011       ,output v-user-action
     2012       ,output v-printed
     2013       ) .
     2014   end procedure.
     2015   procedure foreach :
     2016   IF ( i modulo v-account = 0 )  then DO:
     2017             if  log-manager:logfile-name ne ?
     2018             then DO:
     2019                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2020             end.
     2021              if mFrameView
     2022              then do:
     2023               DISPLAY
     2024                 i @ RecordsDone
     2025                 WITH FRAME InfoFrame.
     2026              end.
     2027   End.
     2028      if v-button-stop then  DO:
     2029            if mFrameView
     2030            then
     2031               PROCESS EVENTS.
