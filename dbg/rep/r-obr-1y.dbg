     2068     bi-ostatok-start [2 + 0] =  bi-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     2069     bi-ostatok-start [3 + 0] =  bi-ostatok-start [3 + 0] + ostatok-start [3 + 0]
