     1093   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1094   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1095   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1096   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1097   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1098   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1099   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1100   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1101         adm-object-hdl = FRAME F-Main:HANDLE.
     1102   RUN ensure-broker.
     1103   THIS-PROCEDURE:ADM-DATA =
     1104        'ADM1.1~`':U +
     1105        'SmartObject~`':U +
     1106        '~`':U +
     1107        'NO ~`':U +
     1108        '~`':U +
     1109        '~`':U +
     1110        '~`':U +
     1111        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1112           + "~`":U +
     1113        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1114        'Record-Source,Record-Target,TableIO-Target~`':U +
     1115        '~`':U +
     1116        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1117        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1118            THEN "^^":U
     1119        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1120             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1121   PROCEDURE adm-apply-entry :
     1122     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1123   END PROCEDURE.
     1124   PROCEDURE adm-destroy :
     1125    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1126   END PROCEDURE.
     1127   PROCEDURE adm-disable :
     1128       DISABLE RECT-6 IMAGE-1 IMAGE-2 f-name f-dostavka SortType f-orderinfo f-action btn-grp EDITOR-grp f-skidki f-skidki-2 f-skidki-3 t-minpart T-ost f-skidki-4 v-colsize f-skidki-5 f-skidki-6 f-telefon-1 f-skidki-7 f-telefon-2 f-skidki-8 f-hot f-info WITH FRAME F-Main.
     1129       RUN dispatch ('disable-fields':U).
     1130       RUN set-attribute-list ('ENABLED=no':U).
     1131       RETURN.
     1132   END PROCEDURE.
     1133   PROCEDURE adm-edit-attribute-list :
     1134         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1135         RETURN.
     1136   END PROCEDURE.
     1137   PROCEDURE adm-enable :
     1138       ENABLE UNLESS-HIDDEN RECT-6 IMAGE-1 IMAGE-2 f-name f-dostavka SortType f-orderinfo f-action btn-grp EDITOR-grp f-skidki f-skidki-2 f-skidki-3 t-minpart T-ost f-skidki-4 v-colsize f-skidki-5 f-skidki-6 f-telefon-1 f-skidki-7 f-telefon-2 f-skidki-8 f-hot f-info WITH FRAME F-Main.
     1139       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1140       RUN set-attribute-list ('ENABLED=yes':U).
     1141       RETURN.
     1142   END PROCEDURE.
     1143   PROCEDURE adm-exit :
     1144        RUN notify ('exit':U).
     1145     RETURN.
     1146   END PROCEDURE.
     1147   PROCEDURE adm-hide :
     1148     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1149   END PROCEDURE.
     1150   PROCEDURE adm-initialize :
     1151     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1152   END PROCEDURE.
     1153   PROCEDURE adm-show-errors :
     1154       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1155       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1156           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1157       END.
     1158       RETURN.
     1159   END PROCEDURE.
     1160   PROCEDURE adm-UIB-mode :
     1161     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1162   END PROCEDURE.
     1163   PROCEDURE adm-view :
     1164     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1165   END PROCEDURE.
     1166   PROCEDURE dispatch :
     1167       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1168       RUN broker-dispatch IN adm-broker-hdl
     1169           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1170       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1171   END PROCEDURE.
     1172   PROCEDURE ensure-broker :
     1173   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1174   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1175   DO:
     1176       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1177       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1178   END.
     1179   END PROCEDURE.
     1180   PROCEDURE get-attribute :
     1181     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1182     RUN broker-get-attribute IN adm-broker-hdl
     1183         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1184     RETURN RETURN-VALUE.
     1185   END PROCEDURE.
     1186   PROCEDURE get-attribute-list :
     1187     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1188     RUN broker-get-attribute-list IN adm-broker-hdl
     1189         (INPUT THIS-PROCEDURE,
     1190          INPUT ?,
     1191          OUTPUT p-attr-list) NO-ERROR.
     1192     RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE new-state :
     1195     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1196     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1197     RETURN.
     1198   END PROCEDURE.
     1199   PROCEDURE notify :
     1200     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1201     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1202     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1203         RETURN "ADM-ERROR":U.
     1204     RETURN.
     1205   END PROCEDURE.
     1206   PROCEDURE set-attribute-list :
     1207     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1208     RUN ensure-broker.
     1209     RUN broker-set-attribute-list IN adm-broker-hdl
     1210         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1211     RETURN.
     1212   END PROCEDURE.
     1213   PROCEDURE set-position :
     1214       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1215       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1216       IF VALID-HANDLE(adm-object-hdl) THEN
     1217       DO:
     1218         ASSIGN adm-object-hdl:ROW    =   p-row
     1219                adm-object-hdl:COLUMN =   p-col.
     1220       END.
     1221       RETURN.
     1222   END PROCEDURE.
     1223   PROCEDURE adm-display-fields :
     1224       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1225       RETURN.
     1226   END PROCEDURE.
     1227   PROCEDURE adm-open-query :
     1228     RETURN.
     1229   END PROCEDURE.
     1230   PROCEDURE adm-row-changed :
     1231         IF VALID-HANDLE(adm-object-hdl) THEN
     1232           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1233         RUN notify ('row-available':U).
     1234         RETURN.
     1235   END PROCEDURE.
     1236   PROCEDURE reposition-query :
     1237       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1238       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1239       RETURN.
     1240   END PROCEDURE.
     1241     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1242     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1243     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1244     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1245     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1246     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1247     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1248     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1249     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1250     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1251     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1252     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1253     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1254     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1255     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1256     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1257     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1258     IF "":U = "":U THEN
     1259       RUN modify-list-attribute IN adm-broker-hdl
     1260         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1261     RUN use-create-on-add(?).
     1262   PROCEDURE adm-add-record :
     1263       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1264          "must have at least one Enabled Table to perform Add.":U
     1265          VIEW-AS ALERT-BOX ERROR.
     1266       RETURN.
     1267   END PROCEDURE.
     1268   PROCEDURE adm-assign-record :
     1269    MESSAGE
     1270          "Object ":U THIS-PROCEDURE:FILE-NAME
     1271            "must have at least one Enabled Table to perform Assign.":U
     1272              VIEW-AS ALERT-BOX ERROR.
     1273      RETURN.
     1274     END PROCEDURE.
     1275   PROCEDURE adm-assign-statement :
     1276     RETURN.
     1277   END PROCEDURE.
     1278   PROCEDURE adm-cancel-record :
     1279      RETURN.
     1280     END PROCEDURE.
     1281   PROCEDURE adm-copy-record :
     1282       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1283        "must have at least one Enabled Table to perform Copy.":U
     1284          VIEW-AS ALERT-BOX ERROR.
     1285       RETURN.
     1286   END PROCEDURE.
     1287   PROCEDURE adm-create-record :
     1288      RETURN.
     1289   END PROCEDURE.
     1290   PROCEDURE adm-current-changed :
     1291     RETURN.
     1292   END PROCEDURE.
     1293   PROCEDURE adm-delete-record :
     1294    MESSAGE
     1295          "Object ":U THIS-PROCEDURE:FILE-NAME
     1296            "must have at least one Enabled Table to perform Delete.":U
     1297              VIEW-AS ALERT-BOX ERROR.
     1298       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1299       RETURN.
     1300   END PROCEDURE.
     1301   PROCEDURE adm-disable-fields :
     1302         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1303       RETURN.
     1304   END PROCEDURE.
     1305   PROCEDURE adm-enable-fields :
     1306       RETURN.
     1307   END PROCEDURE.
     1308   PROCEDURE adm-end-update :
     1309     RETURN.
     1310   END PROCEDURE.
     1311   PROCEDURE adm-reset-record :
     1312       RETURN.
     1313   END PROCEDURE.
     1314   PROCEDURE adm-update-record :
     1315       MESSAGE
     1316         "Object ":U THIS-PROCEDURE:FILE-NAME
     1317           "must have at least one Enabled Table to perform Update.":U
     1318             VIEW-AS ALERT-BOX ERROR.
     1319      RETURN.
     1320   END PROCEDURE.
     1321   PROCEDURE check-modified :
     1322   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1323   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1324   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1325   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1326     IF check-state = "check":U THEN
     1327     DO:
     1328       RUN get-link-handle IN adm-broker-hdl
     1329         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1330            OUTPUT group-target-list).
     1331       IF group-target-list NE "":U THEN
     1332       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1333         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1334         RUN check-modified IN curr-widget ('group-check':U).
     1335         IF RETURN-VALUE NE "":U THEN
     1336         DO:
     1337           RUN check-modified-message(RETURN-VALUE).
     1338           RETURN "":U.
     1339         END.
     1340       END.
     1341     END.
     1342     RETURN "":U.
     1343   END PROCEDURE.
     1344   PROCEDURE check-modified-message :
     1345     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1346        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1347           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1348        IF RETURN-VALUE = "YES":U THEN
     1349           RUN notify ('view,CONTAINER-SOURCE':U).
     1350        MESSAGE IF p-changed-table NE ? THEN
     1351           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1352           ELSE "Current values have been changed."
     1353           SKIP "  Do you wish to save those changes?"
     1354           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1355        IF ANS THEN
     1356        DO:
     1357           IF group-assign-target THEN
     1358             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1359           ELSE RUN dispatch('update-record':U).
     1360           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1361           DO:
     1362               MESSAGE "Changes to the previous record were not saved."
     1363                 VIEW-AS ALERT-BOX ERROR.
     1364               IF group-assign-target THEN
     1365                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1366               ELSE RUN dispatch ('cancel-record':U).
     1367           END.
     1368        END.
     1369        ELSE DO:
     1370          IF group-assign-target THEN
     1371             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1372          ELSE RUN dispatch('cancel-record':U).
     1373        END.
     1374        RETURN.
     1375   END PROCEDURE.
     1376   PROCEDURE get-rowid :
     1377       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1378       ASSIGN
     1379       p-table   =   adm-first-table.
     1380       RETURN.
     1381   END PROCEDURE.
     1382   PROCEDURE init-group-assign :
     1383       RUN request-attribute IN adm-broker-hdl
     1384         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1385       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1386         group-assign-target = yes.
     1387       ELSE group-assign-target = no.
     1388       RETURN.
     1389   END PROCEDURE.
     1390   PROCEDURE set-editors :
     1391       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1392       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1393       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1394       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1395       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1396       DO WHILE VALID-HANDLE (curr-widget):
     1397           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1398              curr-widget:HIDDEN = no THEN DO:
     1399             CASE p-field-setting:
     1400               WHEN "INITIALIZE":U THEN
     1401               DO:
     1402                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1403                     read-only-list +
     1404                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1405                        STRING(curr-widget).
     1406               END.
     1407               WHEN "DISABLE":U OR
     1408               WHEN "ENABLE":U THEN
     1409               DO:
     1410                   curr-widget:SENSITIVE = yes.
     1411                   RUN get-attribute ('Read-Only-Editors':U).
     1412                   IF RETURN-VALUE = ? OR
     1413                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1414                       curr-widget:READ-ONLY =
     1415                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1416               END.
     1417               WHEN "CLEAR":U THEN
     1418                   curr-widget:SCREEN-VALUE = "":U.
     1419             END CASE.
     1420           END.
     1421           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1422       END.
     1423       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1424         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1425           + '"':U).
     1426       RETURN.
     1427   END PROCEDURE.
     1428   PROCEDURE use-check-modified-all :
     1429    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1430     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1431     RETURN.
     1432   END PROCEDURE.
     1433   PROCEDURE use-create-on-add :
     1434   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1435      RETURN.
     1436   END PROCEDURE.
     1437   PROCEDURE use-initial-lock :
     1438     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1439     ASSIGN adm-initial-lock = p-attr-value.
     1440     RETURN.
     1441   END PROCEDURE.
     1442     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1443   ASSIGN
     1444          FRAME F-Main:SCROLLABLE       = FALSE
     1445          FRAME F-Main:HIDDEN           = TRUE.
     1446   ASSIGN
     1447          EDITOR-grp:READ-ONLY IN FRAME F-Main        = TRUE.
     1448   ON CHOOSE OF btn-grp IN FRAME F-Main
     1449   DO:
     1450     define variable ix        as integer no-undo.
     1451     define variable  lns-cnt      as integer    no-undo .
     1452     define variable v-ref-rec as character no-undo.
     1453     run ref/gr-bupr.w (input  my-handle , "b-sel", input-output v-ref-rec ).
     1454     s-ref-rec = v-ref-rec.
     1455     EDITOR-grp = "".
     1456     for first buf_buyer-group where recid(buf_buyer-group) = int(s-ref-rec):
     1457       if error-status :error then do:
     1458         return no-apply.
     1459       end.
     1460       assign
     1461         EDITOR-grp = EDITOR-grp + buf_buyer-group.name + chr(10).
     1462       .
     1463     end.
     1464     display
     1465       EDITOR-grp
     1466       with frame F-Main
     1467     .
     1468   END.
     1469   if not this-procedure :persistent
     1470   then do:
     1471     message
     1472       vss-workfile vss-revision vss-description skip
     1473       "Ошибка при запуске процедуры" skip
     1474       "Данную процедуру следует запускать только с параметром persistent" skip
     1475       view-as alert-box error .
     1476     undo, return error .
     1477   end.
     1478   PROCEDURE disable_UI :
     1479     HIDE FRAME F-Main.
     1480     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1481   END PROCEDURE.
     1482   PROCEDURE local-apply-layout :
     1483     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1484   END PROCEDURE.
     1485   PROCEDURE local-initialize :
     1486   define variable v-void-log    as logical   no-undo .
     1487   define variable v-naim    as character    no-undo.
     1488   define variable v-list    as character    no-undo.
     1489     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1490      run uf-get ( input 'prphoto':U
     1491                        , input v-cntxt-userid
     1492                        , output v-list
     1493                        , output v-naim
     1494                        , output v-void-log
     1495                        , output v-void-log
     1496                        , output v-void-log
     1497                        , output v-void-log
     1498                        ) .
     1499    if num-entries(v-list, chr(4))  >= 10  then do:
     1500      assign
     1501        f-name        = entry(1,v-list, chr(4))
     1502        f-dostavka    = entry(2,v-list, chr(4))
     1503        f-telefon-1   = entry(3,v-list, chr(4))
     1504        f-telefon-2   = entry(4,v-list, chr(4))
     1505        f-info        = entry(5,v-list, chr(4))
     1506        f-orderinfo   = entry(6,v-list, chr(4))
     1507        f-action      = entry(7,v-list, chr(4))
     1508        f-skidki      = entry(8,v-list, chr(4))
     1509        f-skidki-2    = entry(9,v-list, chr(4))
     1510        f-skidki-3    = entry(10,v-list, chr(4))
     1511        f-skidki-4    = entry(11,v-list, chr(4))
     1512        f-skidki-5    = entry(12,v-list, chr(4))
     1513        f-skidki-6    = entry(13,v-list, chr(4))
     1514        f-skidki-7    = entry(14,v-list, chr(4))
     1515        f-skidki-8    = entry(15,v-list, chr(4))
     1516        v-colsize     = integer(entry(16,v-list, chr(4)))
     1517        f-hot         = entry(17,v-list, chr(4))
     1518      .
     1519       assign
     1520       t-minpart = logical(entry(18,v-list, chr(4)))
     1521       T-ost = logical(entry(19,v-list, chr(4)))
     1522       s-ref-rec = entry(20,v-list, chr(4))
     1523       no-error.
     1524       for first buf_buyer-group where recid (buf_buyer-group) = int(s-ref-rec):
     1525           EDITOR-grp = buf_buyer-group.name.
     1526       end.
     1527        display
     1528        f-name
     1529        f-dostavka
     1530        f-telefon-1
     1531        f-telefon-2
     1532        f-info
     1533        f-orderinfo
     1534        f-action
     1535        f-skidki
     1536        f-skidki-2
     1537        f-skidki-3
     1538        f-skidki-4
     1539        f-skidki-5
     1540        f-skidki-6
     1541        f-skidki-7
     1542        f-skidki-8
     1543        v-colsize
     1544        f-hot
     1545        t-minpart
     1546        T-ost
     1547        EDITOR-grp
     1548        with frame F-Main .
     1549    end.
     1550    else do:
     1551      assign
     1552        f-name        = "МЯГКАЯ ИГРУШКА производство Швеция"
     1553        f-dostavka    = "- апрель 2010"
     1554        f-telefon-1   = "(495) 980-98-98"
     1555        f-telefon-2   = "(495) 980-98-91"
     1556        f-info        = "Внимание! Компания <Бизнес Букет> оставляет за собой право изменения цен при изменении курса валют более чем на 50 коп. от курса установленного ЦБ."
     1557        f-orderinfo =  "Заказы по текущему прайс-листу присылайте не позднее 15-ти часов в субботу. Растения отпускаются по предоплате."
     1558        f-action    = '1 минимальной партии'
     1559        f-skidki    = 'от 1000 скидка 5%'
     1560        v-colsize   =  50
     1561        f-hot       = "Указывайте степень утепления, если это необходимо!"
     1562      .
     1563        display
     1564        f-name
     1565        f-dostavka
     1566        f-telefon-1
     1567        f-telefon-2
     1568        f-info
     1569        f-orderinfo
     1570        f-action
     1571        f-skidki
     1572        v-colsize
     1573        f-hot
     1574        f-skidki-2
     1575        f-skidki-3
     1576        f-skidki-4
     1577        f-skidki-5
     1578        f-skidki-6
     1579        f-skidki-7
     1580        f-skidki-8
     1581        t-minpart
     1582        T-ost
     1583        EDITOR-grp
     1584        with frame F-Main .
     1585    end.
     1586   END PROCEDURE.
     1587   PROCEDURE local-view :
     1588     RUN dispatch IN THIS-PROCEDURE ( INPUT 'view':U ) .
     1589   END PROCEDURE.
     1590   PROCEDURE my-report :
     1591     run rep/r-prphot.p (
     1592      input my-handle,
     1593      input SortType,
     1594      input f-name ,
     1595      input f-dostavka  ,
     1596      input f-telefon-1 ,
     1597      input f-telefon-2 ,
     1598      input f-info ,
     1599      input f-orderinfo  ,
     1600      input f-action     ,
     1601      input f-skidki     ,
     1602      input f-skidki-2   ,
     1603      input f-skidki-3   ,
     1604      input f-skidki-4   ,
     1605      input f-skidki-5   ,
     1606      input f-skidki-6   ,
     1607      input f-skidki-7   ,
     1608      input f-skidki-8   ,
     1609      input v-colsize    ,
     1610      input f-hot        ,
     1611      input t-minpart,
     1612      input T-ost   ,
     1613      input s-ref-rec
     1614      ).
     1615   END PROCEDURE.
     1616   PROCEDURE my-var :
     1617   assign frame F-Main  SortType
     1618           f-dostavka
     1619           f-name
     1620           f-telefon-1
     1621           f-telefon-2
     1622           f-info
     1623           f-orderinfo
     1624           f-action
     1625           f-skidki
     1626           f-skidki-2
     1627           f-skidki-3
     1628           f-skidki-4
     1629           f-skidki-5
     1630           f-skidki-6
     1631           f-skidki-7
     1632           f-skidki-8
     1633           v-colsize
     1634           f-hot
     1635           T-ost
     1636           t-minpart
     1637          .
     1638   x-date-end = x-date-alone.
     1639    sheetf.Excel-Column-Lable =
     1640              "Артикул"
     1641     + ","  + "Код"
     1642     + ","  + "Название товара"
     1643     + ","  + "Опт. цена руб"
     1644     + ","  + "Мин.опт. партия шт"
     1645     + ","  + "Фото"
     1646     + ","  + "ВАШ ЗАКАЗ"
     1647     .
     1648    sheetf.make-correct = "".
     1649    sheetf.sizes = "15,10,20,8,8,20,10,".
     1650    Sheetf.Bas-File = "exe/r-prphot.bas" .
     1651   define variable v-void-log    as logical   no-undo .
     1652   define variable v-naim    as character    no-undo.
     1653   define variable v-list    as character    no-undo.
     1654    v-List =
     1655       f-name + chr(4) +
     1656       f-dostavka  + chr(4) +
     1657       f-telefon-1 + chr(4) +
     1658       f-telefon-2 + chr(4) +
     1659       f-info      + chr(4) +
     1660       f-orderinfo + chr(4) +
     1661       f-action    + chr(4) +
     1662       f-skidki    + chr(4) +
     1663       f-skidki-2  + chr(4) +
     1664       f-skidki-3  + chr(4) +
     1665       f-skidki-4  + chr(4) +
     1666       f-skidki-5  + chr(4) +
     1667       f-skidki-6  + chr(4) +
     1668       f-skidki-7  + chr(4) +
     1669       f-skidki-8  + chr(4) +
     1670       string(v-colsize) + chr(4) +
     1671       f-hot + chr(4) +
     1672       string(t-minpart) + chr(4) +
     1673       string(t-ost) + chr(4) +
     1674       s-ref-rec.
     1675     run uf-set in this-procedure (
     1676        input  'prphoto':U
     1677       ,input  v-cntxt-userid
     1678       ,input v-List
     1679       ,input v-Naim
     1680       ,input v-void-log
     1681       ,input v-void-log
     1682       ,input v-void-log
     1683       ,input v-void-log
     1684   )  no-error .
     1685   END PROCEDURE.
     1686   PROCEDURE state-changed :
