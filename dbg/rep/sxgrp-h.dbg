     1390     _cycle2:
     1391     DO cycle = 1 to 0 by -1:
     1392        if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle2.
     1393       _obj-list2:
     1394       for each obj-list no-lock:
     1395         if not byobject and cycle = 1 then LEAVE _obj-list2.
     1396         if cycle = 1 then v-obj-code = obj-list.obj-code.
     1397         if cycle = 0 then v-obj-code = 0.
     1398         if cycle = 1 then do:
     1399           FIND FIRST ub.clients NO-LOCK WHERE
     1400                     ub.clients.obj-code = v-obj-code AND
     1401                     ub.clients.obj-type = 'маг':U NO-ERROR.
     1402           if available ub.clients then do:
     1403             v-obj-name = ub.clients.obj-name.
     1404           end.
     1405           else v-obj-name = string(v-obj-code).
     1406         end.
     1407         if byobject and cycle = 0 then do:
     1408           v-obj-name = "ПО_ВСЕМ_ ОБЪЕКТАМ".
     1409         end.
     1410         if  byobject and not (cycle = 0 and method = "pay-desk")  then
     1411         PUT stream PrnLibStream unformatted
     1412         v-obj-name
     1413         skip.
     1414         assign
     1415         tot-nc-by-grp  = 0
     1416         tot-by-grp     = 0
     1417         accum-sum[1]   = 0
     1418         accum-sum[2]   = 0
     1419         accum-sum[3]   = 0
     1420         accum-sum[4]   = 0
     1421         accum-sum[5]   = 0
     1422         accum-sum[6]   = 0
     1423         accum-sum[7]   = 0
     1424         accum-sum[8]   = 0
     1425         accum-sum[9]   = 0
     1426         accum-sum[10]  = 0
     1427         accum-sum[11]  = 0
     1428         accum-sum[12]  = 0
     1429         accum-sum[13]  = 0
     1430         accum-sum[14]  = 0
     1431         accum-sum[15]  = 0
     1432         accum-sum[16]  = 0
     1433         accum-sum[17]  = 0
     1434         accum-sum[18]  = 0
     1435         accum-sum[19]  = 0
     1436         accum-sum[20]  = 0
     1437         accum-sum[21]  = 0
     1438         accum-sum[22]  = 0
     1439         accum-sum[23]  = 0
     1440         accum-sum[24]  = 0
     1441         accum-tot-by-grp = 0
     1442         accum-num-chk[1] =  0
     1443         accum-num-chk[2] =  0
     1444         accum-num-chk[3] =  0
     1445         accum-num-chk[4] =  0
     1446         accum-num-chk[5] =  0
     1447         accum-num-chk[6] =  0
     1448         accum-num-chk[7] =  0
     1449         accum-num-chk[8] =  0
     1450         accum-num-chk[9] =  0
     1451         accum-num-chk[10] = 0
     1452         accum-num-chk[11] = 0
     1453         accum-num-chk[12] = 0
     1454         accum-num-chk[13] = 0
     1455         accum-num-chk[14] = 0
     1456         accum-num-chk[15] = 0
     1457         accum-num-chk[16] = 0
     1458         accum-num-chk[17] = 0
     1459         accum-num-chk[18] = 0
     1460         accum-num-chk[19] = 0
     1461         accum-num-chk[20] = 0
     1462         accum-num-chk[21] = 0
     1463         accum-num-chk[22] = 0
     1464         accum-num-chk[23] = 0
     1465         accum-num-chk[24] = 0
     1466         accum-tot-nc-by-grp = 0
     1467         .
     1468         FOR EACH full-grp NO-LOCK,
     1469             EACH grp-h WHERE
     1470                  grp-h.obj-code = v-obj-code
     1471              AND grp-h.grp-code = full-grp.grp-code
     1472         BREAK
     1473         BY full-grp.full-name
     1474         BY grp-h.obj-code
     1475         BY grp-h.grp-code
     1476         BY grp-h.other-code :
     1477           if cycle = 1 and method = "pay-desk" and full-grp.other-code <> v-obj-code then next.
     1478           if (method = "pays":U and first-of( grp-h.other-code )) or
     1479              (method <> "pays":U and first-of(grp-h.grp-code)) then do:
     1480            assign
     1481               tot-nc-by-grp = 0
     1482               tot-by-grp = 0
     1483             .
     1484             if method = "pay-desk":U or method = "pays":U then do:
     1485               do cycle1 = 1 to 24.
     1486                 if use-column[cycle1 + 3] then tot-nc-by-grp = grp-h.num-chk[cycle1] + tot-nc-by-grp .
     1487               end.
     1488             end.
     1489             do cycle1 = 1 to 24.
     1490               if use-column[cycle1 + 3] then tot-by-grp = grp-h.sum[cycle1] + tot-by-grp .
     1491             end.
     1492             if method = "pay-desk":U  or method = "pays":U then do:
     1493               if method = "pay-desk" and cycle = 0 then.
     1494               else do:
     1495                 PUT stream PrnLibStream UNFORMATTED
     1496                 full-grp.FULL-NAME p-XL-delim.
     1497                 do cycle1 = 1 to 24.
     1498                   if use-column[cycle1 + 3] then
     1499                     PUT stream PrnLibStream UNFORMATTED
     1500                     grp-h.sum[cycle1]     p-XL-delim.
     1501                 end.
     1502                 PUT stream PrnLibStream UNFORMATTED
     1503                 tot-by-grp p-XL-delim
     1504                 .
     1505                 PUT stream PrnLibStream UNFORMATTED
     1506                 (if method = "pays":U
     1507                 then "число_платежей"
     1508                 else "пробито_чеков")      p-XL-delim.
     1509                 do cycle1 = 1 to 24.
     1510                   if use-column[cycle1 + 3] then
     1511                     PUT stream PrnLibStream UNFORMATTED
     1512                     grp-h.num-chk[cycle1]     p-XL-delim.
     1513                 end.
     1514                 PUT stream PrnLibStream UNFORMATTED
     1515                 tot-nc-by-grp p-XL-delim
     1516                 SKIP .
     1517               end.
     1518               assign
     1519               accum-num-chk[1] = accum-num-chk[1] + grp-h.num-chk[1]
     1520               accum-num-chk[2] = accum-num-chk[2] + grp-h.num-chk[2]
     1521               accum-num-chk[3] = accum-num-chk[3] + grp-h.num-chk[3]
     1522               accum-num-chk[4] = accum-num-chk[4] + grp-h.num-chk[4]
     1523               accum-num-chk[5] = accum-num-chk[5] + grp-h.num-chk[5]
     1524               accum-num-chk[6] = accum-num-chk[6] + grp-h.num-chk[6]
     1525               accum-num-chk[7] = accum-num-chk[7] + grp-h.num-chk[7]
     1526               accum-num-chk[8] = accum-num-chk[8] + grp-h.num-chk[8]
     1527               accum-num-chk[9] = accum-num-chk[9] + grp-h.num-chk[9]
     1528               accum-num-chk[10] = accum-num-chk[10] + grp-h.num-chk[10]
     1529               accum-num-chk[11] = accum-num-chk[11] + grp-h.num-chk[11]
     1530               accum-num-chk[12] = accum-num-chk[12] + grp-h.num-chk[12]
     1531               accum-num-chk[13] = accum-num-chk[13] + grp-h.num-chk[13]
     1532               accum-num-chk[14] = accum-num-chk[14] + grp-h.num-chk[14]
     1533               accum-num-chk[15] = accum-num-chk[15] + grp-h.num-chk[15]
     1534               accum-num-chk[16] = accum-num-chk[16] + grp-h.num-chk[16]
     1535               accum-num-chk[17] = accum-num-chk[17] + grp-h.num-chk[17]
     1536               accum-num-chk[18] = accum-num-chk[18] + grp-h.num-chk[18]
     1537               accum-num-chk[19] = accum-num-chk[19] + grp-h.num-chk[19]
     1538               accum-num-chk[20] = accum-num-chk[20] + grp-h.num-chk[20]
     1539               accum-num-chk[21] = accum-num-chk[21] + grp-h.num-chk[21]
     1540               accum-num-chk[22] = accum-num-chk[22] + grp-h.num-chk[22]
     1541               accum-num-chk[23] = accum-num-chk[23] + grp-h.num-chk[23]
     1542               accum-num-chk[24] = accum-num-chk[24] + grp-h.num-chk[24]
     1543               accum-tot-nc-by-grp = accum-tot-nc-by-grp + tot-nc-by-grp
     1544               .
     1545             end.
     1546             else do:
     1547               PUT stream PrnLibStream UNFORMATTED
     1548               full-grp.full-name p-XL-delim
     1549               (if With-Goods then p-XL-delim else "").
     1550               do cycle1 = 1 to 24.
     1551                 if use-column[cycle1 + 3] then
     1552                   PUT stream PrnLibStream UNFORMATTED
     1553                   grp-h.sum[cycle1]     p-XL-delim.
     1554               end.
     1555               PUT stream PrnLibStream UNFORMATTED
     1556               tot-by-grp
     1557               SKIP .
     1558             end.
     1559             if With-Goods then do:
     1560               FOR EACH gds-h WHERE
     1561                       gds-h.obj-code = grp-h.obj-code
     1562                   AND gds-h.grp-code = grp-h.grp-code
     1563                       use-index uu BREAK BY gds-h.uniq :
     1564                 if first-of( gds-h.uniq ) then do:
     1565                   PUT stream PrnLibStream UNFORMATTED
     1566                   string( gds-h.artic, "x(16)" )  p-XL-delim
     1567                   replace(gds-h.gds-name, " " , "_" ) p-XL-delim.
     1568                   do cycle1 = 1 to 24.
     1569                     if use-column[cycle1 + 3] then
     1570                       PUT stream PrnLibStream UNFORMATTED
     1571                       gds-h.sum[cycle1]     p-XL-delim.
     1572                   end.
     1573                   PUT stream PrnLibStream UNFORMATTED
     1574                   SKIP.
     1575                 end.
     1576               END .
     1577             end.
     1578             ASSIGN
     1579             accum-sum[1] = accum-sum[1] + grp-h.sum[1]
     1580             accum-sum[2] = accum-sum[2] + grp-h.sum[2]
     1581             accum-sum[3] = accum-sum[3] + grp-h.sum[3]
     1582             accum-sum[4] = accum-sum[4] + grp-h.sum[4]
     1583             accum-sum[5] = accum-sum[5] + grp-h.sum[5]
     1584             accum-sum[6] = accum-sum[6] + grp-h.sum[6]
     1585             accum-sum[7] = accum-sum[7] + grp-h.sum[7]
     1586             accum-sum[8] = accum-sum[8] + grp-h.sum[8]
     1587             accum-sum[9] = accum-sum[9] + grp-h.sum[9]
     1588             accum-sum[10] = accum-sum[10] + grp-h.sum[10]
     1589             accum-sum[11] = accum-sum[11] + grp-h.sum[11]
     1590             accum-sum[12] = accum-sum[12] + grp-h.sum[12]
     1591             accum-sum[13] = accum-sum[13] + grp-h.sum[13]
     1592             accum-sum[14] = accum-sum[14] + grp-h.sum[14]
     1593             accum-sum[15] = accum-sum[15] + grp-h.sum[15]
     1594             accum-sum[16] = accum-sum[16] + grp-h.sum[16]
     1595             accum-sum[17] = accum-sum[17] + grp-h.sum[17]
     1596             accum-sum[18] = accum-sum[18] + grp-h.sum[18]
     1597             accum-sum[19] = accum-sum[19] + grp-h.sum[19]
     1598             accum-sum[20] = accum-sum[20] + grp-h.sum[20]
     1599             accum-sum[21] = accum-sum[21] + grp-h.sum[21]
     1600             accum-sum[22] = accum-sum[22] + grp-h.sum[22]
     1601             accum-sum[23] = accum-sum[23] + grp-h.sum[23]
     1602             accum-sum[24] = accum-sum[24] + grp-h.sum[24]
     1603             accum-tot-by-grp = accum-tot-by-grp + tot-by-grp
     1604             .
     1605           end.
     1606         END .
     1607       CASE method:
     1608         when "pay-desk":U then do:
     1609           PUT stream PrnLibStream UNFORMATTED
     1610           substitute("ИТОГО_&1_по_всем_кассам", v-obj-name)
     1611           p-XL-delim
     1612           .
     1613         end.
     1614         when "GROUPS":U then do:
     1615           PUT stream PrnLibStream UNFORMATTED
     1616           substitute("ИТОГО_&1_по_всем_группам", v-obj-name)
     1617           p-XL-delim
     1618           .
     1619         end.
     1620         when "pays":U then do:
     1621           PUT stream PrnLibStream UNFORMATTED
     1622           substitute("ИТОГО_&1_по_всем_платежам", v-obj-name)
     1623           p-XL-delim
     1624           .
     1625         end.
     1626         otherwise do:
     1627           PUT stream PrnLibStream UNFORMATTED
     1628           substitute("ИТОГО_&1_по_всем_платежам", v-obj-name) p-xl-delim
     1629           p-XL-delim
     1630           .
     1631         end.
     1632       END.
     1633       do cycle1 = 1 to 24.
     1634         if use-column[cycle1 + 3] then
     1635           PUT stream PrnLibStream UNFORMATTED
     1636           ACCUM-sum[cycle1]     p-XL-delim.
     1637       end.
     1638       PUT stream PrnLibStream UNFORMATTED
     1639         ACCUM-tot-by-grp            .
     1640         IF method = "pay-desk":U or method = "pays":U then do:
     1641           PUT stream PrnLibStream  UNFORMATTED p-XL-delim.
     1642         end.
     1643         else do:
     1644           PUT stream PrnLibStream  UNFORMATTED SKIP .
     1645         end.
     1646         IF method = "pay-desk":U
     1647         or method = "pays" then do:
     1648           PUT stream PrnLibStream UNFORMATTED
     1649           (if method = "pay-desk":U
     1650           then "пробито_чеков"
     1651           else "количество_платежей")      p-XL-delim.
     1652           do cycle1 = 1 to 24.
     1653             if use-column[cycle1 + 3] then
     1654               PUT stream PrnLibStream UNFORMATTED
     1655               ACCUM-num-chk[cycle1]     p-XL-delim.
     1656           end.
     1657           PUT stream PrnLibStream UNFORMATTED
     1658           ACCUM-tot-nc-by-grp format ">>>>>9" p-XL-delim
     1659           SKIP .
     1660         end.
     1661         if cycle = 0 then LEAVE _obj-list2.
     1662       end.
     1663     end.
     1664   END.
     1665   output stream PrnLibStream CLOSE .
