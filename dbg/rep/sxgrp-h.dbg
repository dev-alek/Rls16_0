      563   define button B-viewProcInfo
      564        label "Информация"
      565        size 15 by 1 tooltip "Информация о процесс".
      566   define frame waitfram
      567     v-waitfram-action01 format "x(72)" no-label skip
      568     v-waitfram-action02 format "x(72)" no-label skip
      569     v-waitfram-action03 format "x(72)" no-label skip
      570     B-viewProcInfo
      571     B-WaitFramStop at row 4 col 30
      572     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      573     .
      574   define new global shared variable mBatchMode as logical no-undo init ?.
      575   define variable mFramBachModHandle as handle no-undo.
      576   mFramBachModHandle = frame waitfram:handle.
      577   define variable mFameOldVis as logical no-undo.
      578   define variable mVisCUrentVin as logical no-undo.
      579   if session:batch-mode
      580   then
      581      mBatchMode = yes.
      582   if mBatchMode = ? then do:
      583     mVisCUrentVin = current-window:visible.
      584     mFameOldVis = mFramBachModHandle:visible.
      585     mFramBachModHandle:visible  = yes.
      586     mBatchMode = mFramBachModHandle:visible ne yes.
      587     mFramBachModHandle:visible = mFameOldVis.
      588     current-window:visible = mVisCUrentVin.
      589   end.
      590    if  log-manager:logfile-name ne ?
      591     then DO:
      592         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      593         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      594         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      595     end.
      596   on choose of B-WaitFramStop in frame waitfram
      597   do:
      598     mWaitFramStop = yes.
      599     mWaitFramStopUser = yes.
      600   end.
      601   function waitfram-check-timeout returns logical():
      602      define variable vtime as int64 no-undo.
      603      if mWaitFramStopTimeOut
      604      then
      605         return yes.
      606      vtime = ( now - mWaitFramStartProc ) / 1000 .
      607      if     mWaitFramTimeOut ne ?
      608         and mWaitFramTimeOut ne 0
      609         and mWaitFramTimeOut lt vtime
      610      then do:
      611         mWaitFramStopTimeOut = yes.
      612      end.
      613      return mWaitFramStopTimeOut.
      614   end.
      615   procedure waitfram-hide :
      616     if not session:batch-mode
      617     then do
      618     on error undo, return error return-value
      619     :
      620       pause 0 before-hide .
      621       if not mBatchMode then
      622         hide frame waitfram .
      623     if     not mWaitFramView
      624        and mWaitProcEvent
      625     then
      626       process events .
      627     end.
      628   end procedure.
      629   procedure waitfram-show :
      630     define input  parameter p-message as character no-undo .
      631     define variable v-left-margin as integer   no-undo .
      632     if not session:batch-mode
      633     then do
      634     on error undo, return error return-value
      635     :
      636       if length(p-message) <= 70 then do:
      637         assign
      638           v-left-margin = integer((70 - length(p-message)) / 2)
      639         .
      640         assign
      641           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      642         .
      643         assign
      644           v-waitfram-action01 = " "
      645           v-waitfram-action02 = " "
      646                                    + fill(" ", v-left-margin)
      647                                    + p-message
      648           v-waitfram-action03 = " "
      649         .
      650       end.
      651       else do:
      652         define variable vRindex1 as integer no-undo.
      653         define variable vRindex2 as integer no-undo.
      654         vRindex1 = r-index(p-message," ",70).
      655         if vRindex1 = 0
      656         then
      657            vRindex1 = 70.
      658         if length(p-message)  <= vRindex1 + 70 then do:
      659           assign
      660             v-waitfram-action01 = " "
      661             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      662             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      663           .
      664         end.
      665         else do:
      666           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      667           if vRindex2 <= vRindex1
      668           then
      669              vRindex2 = vRindex1 + 70.
      670           assign
      671             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      672             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      673             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      674           .
      675         end.
      676       end.
      677       B-viewProcInfo:visible   in frame waitfram = no.
      678       B-viewProcInfo:sensitive in frame waitfram = no.
      679       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      680       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      681       if  (   mWaitFramView
      682          or  mWaitProcEvent)
      683          and not mBatchMode
      684       then
      685          display
      686             v-waitfram-action01 skip
      687             v-waitfram-action02 skip
      688             v-waitfram-action03 skip
      689          with frame waitfram .
      690       if     mWaitFramView
      691          then do:
      692             if     mWaitFramInterval ne ?
      693                and not mBatchMode
      694             then
      695                wait-for go of frame waitfram pause mWaitFramInterval.
      696          end.
      697          else
      698             if     mWaitProcEvent
      699                and not mBatchMode
      700             then
      701                process events .
      702     end.
      703   end procedure.
      704      procedure waitfram-show-this:
      705         define input  parameter iInterval as int64 no-undo.
      706         define variable vtime as int64 no-undo.
      707         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      708         mWaitFramInterval = iInterval.
      709         run waitfram-show (substitute("&1&2 &3&4" ,
      710                                       mWaitFramTextBeg ,
      711                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      712                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      713                                       mWaitFramTextEnd
      714                                      )
      715                           ).
      716      end.
      717      procedure WaitFramRunPause:
      718         define input  parameter iInterval as dec no-undo.
      719         define variable vStart  as datetime-tz no-undo.
      720         define variable vend    as datetime-tz no-undo.
      721         define variable vint as int64 no-undo.
      722         define variable vOk as logical no-undo.
      723         vStart = now.
      724         vend   = vStart.
      725         publish "WaitFramPause" (iInterval,output vOk).
      726         vend   =  now.
      727         vint = vend - vStart.
      728         vint = iInterval - vint / 1000.
      729         if     not mWaitFramStop
      730            and (   vint > 0
      731                 or (    not vOk
      732                     and iInterval eq ?
      733                     )
      734                 )
      735         then
      736            run waitfram-show-this (iInterval).
      737         vend   =  now.
      738         vint = vend - vStart.
      739         vint = iInterval - vint / 1000.
      740         if     not mWaitFramStop
      741            and vint > 0
      742         then do:
      743            run gbl/pause.p (vint * 1000).
      744         end.
      745         if iInterval ne ?
      746         then
      747            publish "WaitFramStop".
      748         waitfram-check-timeout().
      749      end.
      750      procedure WaitFramWaitFor:
      751         define input  parameter iInterval as dec no-undo.
      752         assign
      753            mWaitFramStartProc   = now
      754            mWaitFramStopUser    = no
      755            mWaitFramStopTimeOut = no
      756         .
      757         block-wait:
      758         do while not mWaitFramStop:
      759            run WaitFramRunPause (iInterval).
      760            if  waitfram-check-timeout()
      761            then do:
      762               leave block-wait.
      763            end.
      764         end.
      765         run waitfram-hide.
      766      end.
      767   procedure waitfram-join :
      768     define input  parameter p-line-1  as character no-undo .
      769     define input  parameter p-line-2  as character no-undo .
      770     define input  parameter p-line-3  as character no-undo .
      771     define output parameter p-message as character no-undo .
      772     do
      773     on error undo, return error return-value
      774     :
      775       assign
      776         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      777                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      778                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      779       .
      780     end.
      781   end procedure.
      782   function waitfram-join-function returns character
      783     (input p-line-1 as character
      784     ,input p-line-2 as character
      785     ,input p-line-3 as character
      786     ).
      787     define variable v-message as character no-undo .
      788     run waitfram-join in this-procedure
      789       (input  p-line-1
      790       ,input  p-line-2
      791       ,input  p-line-3
      792       ,output v-message
      793       ) .
      794     return v-message .
      795   end function .
      796   define variable  With-Goods as logical no-undo.
      797   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      798   DEFINE SHARED temp-table grp-h no-undo
      799       field obj-code like ub.clients.obj-code
      800       field grp-code like ub.goods.grp-code
      801       field other-code as integer
      802       field sum      as   decimal extent 24
      803       field sum_disc as   decimal extent 24
      804       field num-chk as integer extent 24 format ">>>>>9"
      805       INDEX pi IS PRIMARY obj-code grp-code other-code ASCENDING .
      806   DEFINE SHARED temp-table gds-h no-undo
      807      field obj-code like ub.clients.obj-code
      808       field grp-code like ub.goods.grp-code
      809       field b-code   like ub.bar-code.b-code
      810       field gds-name like ub.goods.gds-name
      811       field uniq     as   char
      812       field artic    like ub.goods.artic
      813       field sum      as   decimal extent 24
      814       field sum_disc as   decimal extent 24
      815       INDEX pi IS PRIMARY obj-code grp-code b-code ASCENDING
      816       INDEX uu obj-code grp-code uniq ASCENDING .
      817   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      818   DEFINE   temp-table full-grp no-undo
      819       field obj-code like ub.clients.obj-code
      820       field grp-code like ub.gds-grp.node-code
      821       field full-name like ub.goods.grp-name
      822       field other-code as integer
      823       INDEX i1 full-name ASCENDING
      824       INDEX i2
      825       obj-code
      826       grp-code other-code
      827         .
      828   define variable vss-include-info8 as character format "X(65)" no-undo
      829   initial "@(#)$Workfile$ $Revision$".
      830   procedure grplib-get-full-name :
      831      define input parameter p-node-code  as integer      no-undo.
      832      define output parameter p-full-name as character    no-undo.
      833      do
      834   on error undo, return error
      835   :
      836       define variable v-upper-code    as integer           no-undo.
      837       define buffer buf_gds-grp       for ub.gds-grp.
      838       define buffer buf_upper_gds-grp for ub.gds-grp.
      839       find first buf_gds-grp no-lock
      840            where buf_gds-grp.node-code = p-node-code
      841       no-error.
      842       if not available buf_gds-grp
      843       then do:
      844           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      845       end.
      846       assign
      847           p-full-name  = ""
      848           v-upper-code = 1
      849       .
      850       do while buf_gds-grp.upper-code <> 0
      851       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      852       :
      853           assign
      854               p-full-name  = buf_gds-grp.node-name
      855                            + (if p-full-name <> "" then chr(47) else "")
      856                            + p-full-name
      857               v-upper-code = buf_gds-grp.upper-code
      858           .
      859           find first buf_gds-grp no-lock
      860                where buf_gds-grp.node-code = v-upper-code
      861           no-error.
      862           if not available buf_gds-grp
      863           then do:
      864               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      865                                   + string( v-upper-code )
      866                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      867           end.
      868       end.
      869       assign
      870       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      871       .
      872   end.
      873   end .
      874   procedure grplib-get-node-from-full-name :
      875   define input parameter p-full-name as character no-undo .
      876   define output parameter p-node-code as integer no-undo .
      877   define variable v-ii as integer no-undo .
      878   define variable v-upper-code as integer no-undo .
      879   define variable v-root-code as integer no-undo .
      880   define variable v-entry as character no-undo .
      881   define buffer buf_gds-grp       for ub.gds-grp.
      882   do
      883   on error undo, return error
      884   :
      885     find first buf_gds-grp no-lock
      886         where buf_gds-grp.upper-code = 0
      887     no-error .
      888     if not available buf_gds-grp
      889     then do:
      890         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      891     end.
      892     else do:
      893       assign
      894       v-root-code = buf_gds-grp.node-code
      895       .
      896     end.
      897     v-upper-code = v-root-code.
      898     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      899       assign
      900       v-entry = entry(v-ii, p-full-name, chr(47)).
      901       if v-entry = '' then leave.
      902       find first buf_gds-grp no-lock where
      903                 buf_gds-grp.node-name = v-entry
      904             and buf_gds-grp.upper-code = v-upper-code
      905             no-error.
      906       if not available buf_gds-grp then do:
      907         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      908       end.
      909       else do:
      910         p-node-code = buf_gds-grp.node-code.
      911         v-upper-code = buf_gds-grp.node-code.
      912       end.
      913     end.
      914   end.
      915   end .
      916   define variable p-XL-delim as character no-undo .
      917   define variable type-par1 as character no-undo .
      918   define variable tmp-var1  as character no-undo .
      919   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      922   define variable par-type          as character no-undo.
      923   define variable v-value-character as character no-undo .
      924   define variable v-value-date      as date      no-undo .
      925   define variable v-value-decimal   as decimal   no-undo .
      926   define variable v-value-integer   as integer   no-undo .
      927   define variable v-value-logical   as logical   no-undo .
      928   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   empty temp-table thbjattr_thbj-attr.
      930   run adm/shattri.p (
      931      input "get":U
      932     ,input 'орг':U
      933     ,input p-curr-host-code
      934     ,input 'report-firm':U
      935     ,input  ""
      936     ,output v-value-character
      937     ,output v-value-date
      938     ,output v-value-decimal
      939     ,output v-value-integer
      940     ,output v-value-logical
      941     ,output par-type
      942     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      943     ) no-error .
      944   for each thbjattr_thbj-attr :
      945       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
      946   end.
      947   IF tmp-var1 = "" then p-XL-delim = ";".
      948   else p-XL-delim = tmp-var1.
      949   define SHARED temp-table temp-dis-card-type no-undo like ub.dis-card-type.
      950   define   shared variable Use-column   as logical extent 256 no-undo .
      951   define buffer b-grp-h for grp-h .
      952   define buffer b-gds-h for gds-h .
      953   define buffer for-grp for ub.gds-grp.
      954   define variable tot-by-grp as decimal no-undo .
      955   define variable tot-nc-by-grp as decimal no-undo format ">>>>>9".
      956   define variable ii as integer no-undo .
      957   define variable kk as integer no-undo .
      958   define variable cycle as integer no-undo .
      959   define variable cycle1 as integer no-undo .
      960   define variable hours as character no-undo.
      961   define variable sums as decimal no-undo.
      962   define variable v-accum-sum as decimal no-undo .
      963   define variable v-accum-sum_disc as decimal no-undo .
      964   define variable v-accum-num-chk as integer no-undo .
      965   define variable accum-sum as decimal extent 24 no-undo .
      966   define variable accum-num-chk as integer extent 24 no-undo .
      967   define variable accum-tot-by-grp as decimal no-undo .
      968   define variable accum-tot-nc-by-grp as decimal no-undo format ">>>>>9".
      969   define variable v-obj-code like ub.clients.obj-code no-undo .
      970   define variable v-obj-name as character no-undo .
      971   define variable accum-obj-list as integer no-undo .
      972   define variable  for-title as char no-undo.
      973   define buffer cli-obj for ub.clients .
      974   CASE method:
      975     when "pay-desk":U then for-title = "Кассы".
      976     when "pays":U then for-title = "Виды кассовых платежей".
      977     otherwise for-title = "Группа товаров ( по классификатору )".
      978   END CASE.
      979   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   define buffer tot_full-grp for full-grp.
      981   for each obj-list no-lock:
      982     assign
      983     accum-obj-list = accum-obj-list + 1.
      984     if accum-obj-list > 1 then LEAVE.
      985   end.
      986   IF METHOD = "GOODS" then WIth-goods = yes.
      987   else with-goods = no.
      988   CASE method:
      989     when "pay-desk":U then do:
      990       for each ub.cash-desk no-lock :
      991         if X-SelectObject = 'все':U then.
      992         else do:
      993           find first obj-list No-LOCK WHERE
      994                     obj-list.obj-code = ub.cash-desk.obj-code AND
      995                     obj-list.obj-type = 'маг':U No-ERROR.
      996           if not available obj-list then next.
      997         end.
      998         create full-grp.
      999         assign
     1000         full-grp.grp-code =   ub.cash-desk.cash-num
     1001         full-grp.other-code = ub.cash-desk.obj-code
     1002         full-grp.full-name = substitute("БД_&1_маг_&2_Касса_&3"
     1003                                                   ,  ub.cash-desk.db-num
     1004                                                   ,  ub.cash-desk.obj-code
     1005                                                   ,  ub.cash-desk.cash-num)
     1006         .
     1007       end.
     1008       create full-grp.
     1009       assign
     1010       full-grp.grp-code =   0
     1011       full-grp.other-code = 0
     1012       full-grp.full-name = '':U
     1013       .
     1014     end.
     1015     when "pays":U then do:
     1016       for each ub.cash-pay No-LOCK:
     1017         create full-grp.
     1018         assign
     1019         full-grp.obj-code = 0
     1020         full-grp.grp-code = ub.cash-pay.cdpay-code
     1021         full-grp.other-code = ub.cash-pay.curr-code
     1022         .
     1023         FIND FIRST ub.currency No-LOCK WHERE
     1024                   ub.currency.curr-code = ub.cash-pay.curr-code no-error.
     1025         full-grp.full-name = substitute("&1_Валюта_&2"
     1026                                         , ub.cash-pay.obj-name
     1027                                         ,(if available ub.currency
     1028                                           then ub.currency.curr-abbr
     1029                                           else string(cash-pay.curr-code))).
     1030       end.
     1031     end.
     1032     when "GOODS" or
     1033     when "GROUPS" then do:
     1034       run waitfram-show in this-procedure ("Строю дерево групп ...").
     1035       for each ub.gds-grp no-lock:
     1036         find first for-grp where
     1037                   for-grp.upper-code = ub.gds-grp.node-code No-LOCK No-ERROR.
     1038         if not avail for-grp then do:
     1039           create full-grp.
     1040           assign
     1041           full-grp.obj-code = 0
     1042           full-grp.grp-code = ub.gds-grp.node-code.
     1043           if tree then
     1044           run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output full-grp.full-name).
     1045           else
     1046           full-grp.full-name = ub.gds-grp.node-name.
     1047           full-grp.full-name = replace(full-grp.full-name, " ", "_").
     1048         end.
     1049       end.
     1050       run waitfram-hide in this-procedure .
     1051     end.
     1052   end CASE.
     1053   if method <> "TOTALS":U and method <> "pays":U then do:
     1054     for each grp-h :
     1055       assign
     1056       grp-h.sum[1] = grp-h.sum[1] - grp-h.sum_disc[1]
     1057       grp-h.sum[2] = grp-h.sum[2] - grp-h.sum_disc[2]
     1058       grp-h.sum[3] = grp-h.sum[3] - grp-h.sum_disc[3]
     1059       grp-h.sum[4] = grp-h.sum[4] - grp-h.sum_disc[4]
     1060       grp-h.sum[5] = grp-h.sum[5] - grp-h.sum_disc[5]
     1061       grp-h.sum[6] = grp-h.sum[6] - grp-h.sum_disc[6]
     1062       grp-h.sum[7] = grp-h.sum[7] - grp-h.sum_disc[7]
     1063       grp-h.sum[8] = grp-h.sum[8] - grp-h.sum_disc[8]
     1064       grp-h.sum[9] = grp-h.sum[9] - grp-h.sum_disc[9]
     1065       grp-h.sum[10] = grp-h.sum[10] - grp-h.sum_disc[10]
     1066       grp-h.sum[11] = grp-h.sum[11] - grp-h.sum_disc[11]
     1067       grp-h.sum[12] = grp-h.sum[12] - grp-h.sum_disc[12]
