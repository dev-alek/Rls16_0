       92   procedure cur-time :
       93      define output parameter p-today as date      no-undo .
       94      define output parameter p-time  as integer   no-undo .
       95     do
       96     on error undo, return error
       97     :
       98       define variable v-date1 as date      no-undo .
       99       define variable v-date2 as date      no-undo .
      100       define variable v-time  as integer   no-undo .
      101       assign
      102         v-date1 = today
      103         v-time  = time
      104         v-date2 = today
      105       .
      106       if v-date1 <> v-date2
      107       then do:
      108         assign
      109           v-date1 = today
      110           v-time  = v-time
      111         .
      112       end.
      113       assign
      114         p-today = v-date1
      115         p-time  = v-time
      116       .
      117     end.
      118   end.
      119   function cur-time-date returns character
      120   :
      121     return string(today, '99/99/9999':U) .
      122   end.
      123   function cur-time-mjd returns decimal
      124   :
      125     define variable v-date as date      no-undo .
      126     define variable v-time as integer   no-undo .
      127     run cur-time in this-procedure
      128       (output v-date
      129       ,output v-time
      130       ) .
      131     return integer(v-date) - 2400002 + (v-time / 86400) .
      132   end.
      133   function cur-time-get-ending-index returns integer
      134   (input p-number as integer
      135   )
      136   :
      137     if p-number < 0
      138     or p-number = ?
      139     then do:
      140       return 1 .
      141     end.
      142     define variable v-rest as integer   no-undo .
      143     assign
      144       p-number = p-number modulo 100
      145     .
      146     if p-number < 20
      147     then do:
      148       assign
      149         v-rest = p-number
      150       .
      151     end.
      152     else do:
      153       assign
      154         v-rest = p-number modulo 10
      155       .
      156     end.
      157     case v-rest :
      158       when 1
      159       then do:
      160         return 2 .
      161       end.
      162       when 2 or
      163       when 3 or
      164       when 4
      165       then do:
      166         return 3 .
      167       end.
      168       otherwise do:
      169         return 1 .
      170       end.
      171     end case .
      172   end.
      173   procedure cur-time-mjd-to-date :
      174      define input  parameter i-mjd-diff as decimal no-undo.
      175      define output parameter o-Date     as date    no-undo.
      176      define output parameter o-Time     as integer no-undo.
      177      define variable v-day-number as integer   no-undo .
      178      if    i-mjd-diff < 0
      179         or i-mjd-diff = ?
      180      then do:
      181         return "?" .
      182      end.
      183      assign
      184         v-day-number = truncate(i-mjd-diff,0).
      185         o-Date = date(v-day-number + 2400002).
      186         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188   end.
      189   function cur-time-mjd-to-string returns character
      190   (input p-mjd-diff as decimal
      191   )
      192   :
      193     define variable v-day-number as integer   no-undo .
      194     define variable v-seconds    as integer   no-undo .
      195     define variable v-hour       as integer   no-undo .
      196     define variable v-min        as integer   no-undo .
      197     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      198     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      199     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      200     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      201     if p-mjd-diff < 0
      202     or p-mjd-diff = ?
      203     then do:
      204       return "?" .
      205     end.
      206     assign
      207       v-day-number = integer(truncate(p-mjd-diff,0))
      208       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      209     .
      210     if v-seconds > 86400
      211     then do:
      212       assign
      213         v-seconds = 86400 - 1
      214       .
      215     end.
      216     if v-seconds < 0
      217     then do:
      218       assign
      219         v-seconds = 0
      220       .
      221     end.
      222     assign
      223       v-hour = truncate(v-seconds / 3600, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 3600
      227     .
      228     assign
      229       v-min = truncate(v-seconds / 60, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 60
      233     .
      234     return
      235         (if v-day-number <> 0
      236           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0
      240           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      241           else ""
      242         )
      243       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      244           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      245           else ""
      246         )
      247       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      248       .
      249   end.
      250   function cur-time-string returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      259   end.
      260   function cur-time-string-sec returns character
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      269   end.
      270   function cur-time-custom  returns character
      271   (input p-prefix as character
      272   ,input p-date-format as character
      273   ,input p-delimiter as character
      274   ,input p-time-format as character
      275   ,input p-suffix as character
      276   )
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return
      285       p-prefix
      286       + string(v-date, p-date-format)
      287       + p-delimiter
      288       + string(v-time, p-time-format)
      289       + p-suffix
      290       .
      291   end.
      292   function cur-time-print  returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-datetime returns datetime
      303   :
      304     define variable v-char as character no-undo .
      305     define variable v-datetime as datetime no-undo .
      306     v-char = cur-time-string().
      307     v-datetime = datetime(v-char).
      308     return  v-datetime.
      309   end.
      310   function cur-time-string-msec returns character
      311   :
      312     define variable v-date as datetime  no-undo .
      313     v-date = now.
      314     return string(v-date) .
      315   end.
      316   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      317   def
      318    shared
      319   temp-table  obj-list no-undo
      320     field obj-type like ub.clients.obj-type
      321     field obj-code like ub.clients.obj-code
      322     field obj-name like ub.clients.obj-name
      323     field obj-id   as integer
      324     field db-num   as integer
      325     index pi is primary unique obj-id
      326     index ie1 obj-type obj-code
      327     index ie2 obj-name
      328   .
      329   procedure create_obj-list :
      330      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      331      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      332      do
      333      on error undo, return error return-value
      334      :
      335         define buffer cli-obj for ub.clients .
      336         define variable p-var as integer no-undo .
      337         define buffer buf_obj-list for obj-list .
      338         find last buf_obj-list  use-index pi no-error .
      339         if available buf_obj-list
      340         then
      341            p-var = buf_obj-list.obj-id + 1.
      342         else
      343            p-var = 1.
      344         find first cli-obj where
      345                   cli-obj.obj-type = p-obj-type
      346               and cli-obj.obj-code = p-obj-code
      347         no-lock no-error.
      348         if available cli-obj
      349         then do:
      350            create buf_obj-list.
      351            assign
      352               buf_obj-list.obj-id   = p-var
      353               buf_obj-list.obj-code = cli-obj.obj-code
      354               buf_obj-list.obj-type = cli-obj.obj-type
      355               buf_obj-list.obj-name = cli-obj.obj-name
      356               buf_obj-list.db-num   = cli-obj.db-num
      357            .
      358         end.
      359      end.
      360   end.
      361   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      363   define new shared variable RepPathName        as character no-undo .
      364   define new shared variable PrintRubl          as logical   no-undo .
      365   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   define  stream PrnLibStream.
      367   procedure prn-lib-prn-file :
      368     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      369     define input parameter p-DIsabledoptions as integer no-undo .
      370     define variable v-report-name as character no-undo .
      371     define variable v-user-action as character no-undo .
      372     define variable v-printed     as logical   no-undo .
      373     define variable v-exist       as logical   no-undo .
      374     do
      375       on error undo, return error
      376       :
      377       run prn-lib-get-report-name  in this-procedure (
      378         input parParentProc
      379         ,output v-report-name
      380         ).
      381   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      383     (input  v-report-name
      384     ,input  2
      385     ,output v-exist
      386     )  .
      387       if NOT v-exist then
      388       DO:
      389         Message
      390           "Нет заданий на печать ! "
      391           view-as alert-box .
      392         Return  .
      393       End.
      394       run gbl/prnfilen.w
      395         (input  ""
      396         ,input  p-DisabledOptions
      397         ,input  string(v-report-name )
      398         ,input  7
      399         ,output v-user-action
      400         ,output v-printed
      401         ) .
      402       if v-printed then
      403       do:
      404         return "YES" .
      405       end.
      406       else
      407       do:
      408         return "NO" .
      409       end.
      410     end.
      411   end procedure.
      412   procedure prn-lib-open-stream :
      413     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      414     define input parameter p-page-size    as integer no-undo .
      415     define input parameter p-is-stream    as logical no-undo .
      416     define input parameter p-append       as logical no-undo .
      417     define variable v-report-name as character no-undo .
      418     do
      419       on error undo, return error
      420       :
      421       run prn-lib-get-report-name  in this-procedure (
      422         input parParentProc
      423         ,output v-report-name
      424         ).
      425       if p-is-stream then
      426       do:
      427         if p-append then
      428         do:
      429           output stream PrnLibStream to value( v-report-name )
      430             page-size value(p-page-size) append .
      431         end.
      432         if not p-append then
      433         do:
      434           output stream PrnLibStream to value( v-report-name )
      435             page-size value(p-page-size) .
      436         end.
      437       end.
      438       if not p-is-stream then
      439       do:
      440         if p-append then
      441         do:
      442           output to value( v-report-name )
      443             page-size value(p-page-size) append .
      444         end.
      445         if not p-append then
      446         do:
      447           output to value( v-report-name )
      448             page-size value(p-page-size) .
      449         end.
      450       end.
      451     end.
      452   end procedure.
      453   procedure prn-lib-open-exp :
      454     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      455     define input parameter p-is-stream    as logical no-undo .
      456     define input parameter p-is-append    as logical no-undo .
      457     define output parameter p-ReportFileName as char init "report" no-undo.
      458     define output parameter p-process as logical no-undo .
      459     define variable glog as logical no-undo .
      460     do
      461       on error undo, return error
      462       :
      463       SYSTEM-DIALOG GET-FILE p-ReportFileName
      464         TITLE      "Укажите путь"
      465         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      466         ASK-OVERWRITE
      467         CREATE-TEST-FILE
      468         SAVE-AS
      469         USE-FILENAME
      470         DEFAULT-EXTENSION "txt"
      471         UPDATE glog
      472         .
      473       if not glog then  return.
      474       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      475       if p-is-stream then
      476       do:
      477         if p-is-append then
      478         do:
      479           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      480         end.
      481         else
      482         do:
      483           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      484         end.
      485       end.
      486       else
      487       do:
      488         if p-is-append then
      489         do:
      490           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      491         end.
      492         else
      493         do:
      494           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      495         end.
      496       end.
      497       p-process = yes.
      498     end.
      499   end procedure.
      500   procedure prn-lib-get-report-name :
      501     define input parameter parParentProc  as widget-handle no-undo.
      502     define output parameter p-report-name as character no-undo .
      503     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      504   end procedure.
      505   procedure prn-lib-reportviewer-report-name :
      506     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      507     define input parameter p-report-name-html as character no-undo .
      508     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      509   end procedure.
      510   procedure prn-lib-reportviewer :
      511     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      512     define input parameter p-report-name-html as character no-undo .
      513     define input parameter p-param        as character no-undo .
      514     define variable v-excel           as character no-undo init 'TRUE' .
      515     define variable v-value-character as character no-undo .
      516     define variable v-value-integer   as character no-undo .
      517     define variable v-value-date      as date      no-undo .
      518     define variable v-value-decimal   as decimal   no-undo .
      519     define variable rep-excel         as logical   no-undo .
      520     define variable excel-string      as character no-undo .
      521     define variable v-param-type      as character no-undo .
      522     define variable v-tth             as handle    no-undo .
      523     run adm/shattri.p (
      524       input "get":U
      525       ,input  ""
      526       ,input  0
      527       ,input  'report-glob':U
      528       ,input  'rep-excel':U
      529       ,output v-value-character
      530       ,output v-value-date
      531       ,output v-value-decimal
      532       ,output v-value-integer
      533       ,output rep-excel
      534       ,output v-param-type
      535       ,INPUT-OUTPUT table-handle v-tth
      536       )  .
      537     if rep-excel then v-excel = "TRUE" .
      538     else v-excel = "FALSE" .
      539     if p-param eq ""
      540     then
      541        p-param = "EXCEL:" + v-excel.
      542     else
      543        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      544     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      545   end procedure.
