     1111   run prn-lib-open-stream  in this-procedure (
     1112                                                input parParentProc
     1113                                               ,input 62
     1114                                               ,input yes
     1115                                               ,input no
     1116                                               ).
     1117   PUT stream PrnLibStream UNFORMATTED
     1118   "Почасовая статистика розничных продаж ( по СУММЕ ПРОДАЖ ) ЗА ПЕРИОД c" +
     1119   string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + "."      format "x(110)" SKIP(1).
     1120   if t-dis-card then do:
     1121     PUT stream PrnLibStream UNFORMATTED
     1122     "Только покупки по дисконтным картам" skip.
     1123     if rs-dis-card = 1 then do:
     1124       for each temp-dis-card-type No-LOCK:
     1125         PUT stream PrnLibStream UNFORMATTED
     1126         temp-dis-card-type.type
     1127         skip.
     1128       END.
     1129     end.
     1130   end.
     1131   PUT stream PrnLibStream UNFORMATTED
     1132   SPACE(10) SelectObject SKIP(0)
     1133   (if byobject then "С разбивкой по объектам" else '')  SKIP(1).
     1134   PUT stream PrnLibStream UNFORMATTED
     1135   SKIP
     1136   cur-time-print() format "x(35)" SKIP.
     1137   IF METHOD = "TOTALS" THEN DO:
     1138     PUT stream PrnLibStream UNformatted
     1139     "_" p-XL-delim
     1140     "Сумма_брутто" p-XL-delim
     1141     "Сумма_скидок" p-XL-delim
     1142     "Сумма_нетто"  p-XL-delim
     1143     "Количество_чеков" p-XL-delim
     1144     skip.
     1145     _cycle:
     1146     do  cycle = 1 to 0 by -1:
     1147       if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     1148       _obj-list:
     1149       for each obj-list no-lock:
     1150         if not byobject and cycle = 1 then LEAVE _obj-list.
     1151         if cycle = 1 then v-obj-code = obj-list.obj-code.
     1152         if cycle = 0 then v-obj-code = 0.
     1153         ASSIGN
     1154         v-accum-SUM = 0
     1155         v-accum-SUM_DISC = 0
     1156         v-accum-NUM-CHK = 0
     1157         .
     1158         if cycle = 1 then do:
     1159           FIND FIRST ub.clients NO-LOCK WHERE
     1160                     ub.clients.obj-code = v-obj-code AND
     1161                     ub.clients.obj-type = 'маг':U NO-ERROR.
     1162           if available ub.clients then do:
     1163             v-obj-name = replace(ub.clients.obj-name, chr(32), "_").
     1164           end.
     1165           else v-obj-name = string(v-obj-code).
     1166         end.
     1167         if byobject and cycle = 0 then do:
     1168           v-obj-name = "ПО_ВСЕМ_ОБЪЕКТАМ".
     1169         end.
     1170         put stream PrnLibstream Unformatted
     1171         v-obj-name
     1172         skip.
     1173         FOR EACH grp-h No-LOCK where
     1174                 grp-h.obj-code = v-obj-code
     1175         by grp-h.obj-code :
     1176           DO ii = 0 TO 23 :
     1177               if entry(ii + 1, checked-time-intervals) = "no" then next.
     1178               HOURS = string(ii, "99") + ".00-" + string(ii, "99") + ".59".
     1179               PUT stream PrnLibStream UNFORMATTED
     1180               HOURS p-XL-delim
     1181               grp-h.sum[ii + 1] p-XL-delim
     1182               grp-h.sum_disc[ii + 1] p-XL-delim
     1183               grp-h.sum[ii + 1] - grp-h.sum_disc[ii + 1] p-XL-delim
     1184               grp-h.num-chk[ii + 1] p-XL-delim
     1185               skip
     1186               .
     1187               assign
     1188               V-ACCUM-sum = v-accum-sum + grp-h.sum[ii + 1]
     1189               V-ACCUM-sum_disc = v-accum-sum_disc + grp-h.sum_disc[ii + 1]
     1190               V-ACCUM-num-chk = v-accum-num-chk + grp-h.num-chk[ii + 1]
     1191               .
     1192               IF ii = 23 then do:
     1193                 PUT stream PrnLibStream UNFORMATTED
     1194                 (if cycle = 1
     1195                 then substitute("Итого_&1", grp-h.obj-code)
     1196                 else "ИТОГО") p-XL-delim
     1197                 v-ACCUM-sum p-XL-delim
     1198                 v-ACCUM-sum_disc p-XL-delim
     1199                 v-ACCUM-sum - v-accum-sum_disc p-XL-delim
     1200                 v-aCCUM-num-chk p-XL-delim
     1201               SKIP.
     1202               end.
     1203             END.
     1204           END.
     1205           if cycle = 0 then LEAVE _obj-list.
     1206        end.
     1207      end.
     1208   END.
