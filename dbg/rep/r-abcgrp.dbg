     1159   index  pi  IS PRIMARY  prc
     1160   index  pi1 grp-code
     1161   .
     1162   define temp-table temp-abc no-undo
     1163     field  nn          as integer
     1164     field  id          as integer
     1165     field  db-num      like ub.abc-analysis.db-num
     1166     field  type        as character
     1167     field  name        like ub.abc-analysis.abc-name
     1168     field  des         like ub.abc-analysis.abc-des
     1169     field  name-cral   like ub.criterion-analysis.cral-name
     1170     field  A           like ub.abc-analysis.abc-a
     1171     field  B           like ub.abc-analysis.abc-b
     1172     field  C           like ub.abc-analysis.abc-c
     1173     field  D           like ub.abc-analysis.abc-d
     1174     field  E           like ub.abc-analysis.abc-E
     1175     field  F           like ub.abc-analysis.abc-F
     1176     field  date-cr     like ub.abc-analysis.abc-date-create
     1177     field  period       as character
     1178     field  ext-doc-type as character
     1179     field  obj          as character
     1180     index pi nn
     1181     index pi2 id db-num
     1182   .
     1183   define variable var-i as integer   no-undo .
     1184   define variable var-kol as integer   no-undo .
     1185   define variable number-group as character no-undo .
     1186   define variable i-numb as integer   no-undo .
     1187   var-kol = num-entries (p-rez).
     1188   repeat var-i = 1 to var-kol :
     1189      find first buf_abc-analysis no-lock where recid(buf_abc-analysis) = int(entry(var-i,p-rez )) no-error .
     1190      if not available buf_abc-analysis  then next.
     1191      find first  buf_criterion-analysis no-lock where buf_criterion-analysis.cral-id = buf_abc-analysis.cral-id no-error .
     1192      if not available buf_criterion-analysis  then next.
     1193       create temp-abc.
     1194       assign
     1195       temp-abc.nn          = var-i
     1196       temp-abc.id          = buf_abc-analysis.abc-id
     1197       temp-abc.db-num      = buf_abc-analysis.db-num
     1198       temp-abc.type        = if buf_abc-analysis.abc-type = "2"  then "Двухпроходный, ограничение Е <= " + string(buf_abc-analysis.le-proc)  else " "
     1199       temp-abc.name        = buf_abc-analysis.abc-name
     1200       temp-abc.des         = buf_abc-analysis.abc-des
     1201       temp-abc.name-cral   = buf_criterion-analysis.cral-name
     1202       temp-abc.A           = buf_abc-analysis.abc-a
     1203       temp-abc.B           = buf_abc-analysis.abc-b
     1204       temp-abc.C           = buf_abc-analysis.abc-c
     1205       temp-abc.D           = buf_abc-analysis.abc-d
     1206       temp-abc.E           = buf_abc-analysis.abc-E
     1207       temp-abc.F           = buf_abc-analysis.abc-F
     1208       temp-abc.date-cr     = buf_abc-analysis.abc-date-create
     1209       temp-abc.period      = buf_abc-analysis.abc-string-period
     1210       temp-abc.ext-doc-type = ""
     1211       .
     1212       define buffer buf_abc-analysis-doc for ub.abc-analysis-doc.
     1213        for each buf_abc-analysis-doc no-lock where
     1214                 buf_abc-analysis-doc.abc-id = buf_abc-analysis.abc-id and
     1215                 buf_abc-analysis-doc.db-num = buf_abc-analysis.db-num
     1216        :
     1217        temp-abc.ext-doc-type = temp-abc.ext-doc-type + func-get-name-from-ext-type (buf_abc-analysis-doc.abcd-ext-doc-type , true ) + "," .
     1218        end.
     1219        for each buf_abc-analysis-obj no-lock where
     1220                 buf_abc-analysis-obj.abc-id = buf_abc-analysis.abc-id and
     1221                 buf_abc-analysis-obj.db-num = buf_abc-analysis.db-num
     1222        :
     1223        temp-abc.obj = temp-abc.obj +  buf_abc-analysis-obj.obj-type + " " + string(buf_abc-analysis-obj.obj-code) + "," .
     1224        end.
     1225   end.
     1226   define stream  macr_excel .
     1227   define variable g#report-num  as integer   no-undo .
     1228   define variable v-file-name as character no-undo .
     1229   define variable p-file-name as character no-undo .
     1230   define variable v-ind       as integer   no-undo .
     1231   define variable num#col#    as integer no-undo .
     1232   define variable C-c         as integer no-undo .
     1233   define variable C-str       as character no-undo .
     1234   define variable str--1      as character Format "x(60)" no-undo.
     1235   define variable str--2      as integer no-undo .
     1236   define variable C-i         as integer no-undo .
     1237   define variable p-var       as integer no-undo .
     1238   define variable var-1       as integer no-undo .
     1239   define variable var-2       as integer no-undo .
     1240   def buffer buf_clients for ub.clients .
     1241   def buffer This_Object for ub.clients .
     1242   def buffer buf_goods   for ub.goods .
     1243   define variable qnty as decimal   no-undo .
     1244   define variable sum  as decimal   no-undo .
     1245   define variable vv-qnty1 as decimal   no-undo .
     1246   define variable vv-qnty2 as decimal   no-undo .
     1247   define variable num-ln as integer   no-undo .
     1248   def var i as int no-undo.
     1249   def var j as int no-undo.
     1250   define variable Counter1 as integer init 0  no-undo .
     1251   def var LineBuf       as char    no-undo.
     1252   def var Line       as char    no-undo.
     1253   def var UndLine    as char    no-undo.
     1254   def var Lines_Counter as   int  init 0  no-undo.
     1255   def var Tmp_Counter   as   int  init 0  no-undo.
     1256   def var tdoc-date     like ub.fbr-pln.doc-date no-undo.
     1257   def var tdoc-code     like ub.fbr-pln.doc-code no-undo.
     1258   def var  abbr              as  char no-undo.
     1259   def var  pp                as  char no-undo.
     1260     if session:set-wait-state("compiler") then.
     1261     define variable v-prn0 as character no-undo .
     1262     if var-report-r-b = "rubl" then assign pp = "Цены руб.".
     1263                                else assign pp = "Цены  баз.вал." .
     1264   define variable v-account as integer init 0 no-undo .
     1265   define variable v-account-lavel as character no-undo .
     1266   define variable v-button-stop as logical no-undo .
     1267   define variable v-kol-spice as integer no-undo .
     1268   define variable v-kol-spice2 as integer no-undo .
     1269   define variable v-kol-spice3 as integer no-undo .
     1270   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1271   DEFINE BUTTON StopBtn AUTO-END-KEY
     1272        LABEL "Стоп"
     1273        SIZE 10 BY 1.
     1274   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1275        LABEL "Обработано записей"
     1276         VIEW-AS TEXT
     1277        SIZE 14 BY .67 NO-UNDO.
     1278   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1279         VIEW-AS TEXT
     1280        SIZE 53.25 BY .67
     1281        FGCOLOR 1  NO-UNDO.
     1282   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1283         VIEW-AS TEXT
     1284        SIZE 53.25 BY .67
     1285        FGCOLOR 1  NO-UNDO.
     1286   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1287         VIEW-AS TEXT
     1288        SIZE 53.25 BY .67
     1289        FGCOLOR 1  NO-UNDO.
     1290   DEFINE RECTANGLE RECT-1
     1291        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1292        SIZE 55.13 BY 4.46.
     1293   DEFINE FRAME InfoFrame
     1294        StopBtn AT ROW 4.25 COL 21.75
     1295        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1296        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1297        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1298        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1299        RECT-1 AT ROW 1 COL 1
     1300       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1301            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1302            TITLE "Процесс"
     1303            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1304   define variable mFrameView      as logical   no-undo init yes.
     1305     define variable mFramHandle as handle no-undo.
     1306     mFramHandle = frame InfoFrame:handle.
     1307     if  log-manager:logfile-name ne ?
     1308     then DO:
     1309         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1310         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1311         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1312     end.
     1313     mFrameView = not session:batch-mode and mFramHandle:visible.
     1314     if mFrameView
     1315     then do:
     1316       ASSIGN
     1317          FRAME InfoFrame:HIDDEN                           = TRUE
     1318          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1319     end.
     1320   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1321   DO:
     1322     IF not StopProcessing THEN
     1323       Message "Вы действительно хотите прервать" SKIP
     1324               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1325                 UPDATE StopProcessing.
     1326     IF StopProcessing THEN do:
     1327        if mFrameView
     1328        then do:
     1329           HIDE FRAME InfoFrame.
     1330        end.
     1331     End.
     1332   END.
     1333   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1334     if  log-manager:logfile-name ne ?
     1335     then DO:
     1336         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1337     end.
     1338     if not session:batch-mode then
     1339     do:
     1340       VIEW FRAME InfoFrame.
     1341       mFrameView = true.
     1342     end.
     1343      v-button-stop = false .
     1344         if mFrameView
     1345         then do:
     1346         if v-button-stop then view STOPBTN in frame InfoFrame.
     1347                          else Hide STOPBTN in frame InfoFrame.
     1348         end.
     1349   v-ind = 0    .
     1350    run paramls-clear in this-procedure .
     1351    run paramls-write in this-procedure
     1352       (input 'rowsgroup-enable':u
     1353       ,input '':u
     1354       ,input 'yes':u
     1355       ) .
     1356       Output stream Macr_Excel  close .
     1357       num#str# = 0 .
     1358       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1359       output stream macr_excel to value(v-file-name)   .
     1360       v-ind = v-ind + 1.
     1361    run get-report-num  in parParentProc(output g#report-num).
     1362       define stream  Stream-rpt .
     1363       p-file-name =  string( session:temp-directory +
     1364                     "rpt" + string( g#report-num ) + ".txt" ) .
     1365       output stream stream-rpt to value(p-file-name)   .
     1366       output stream stream-rpt close  .
     1367     run PrintTitul in this-procedure .
     1368     for each temp-str :  delete temp-str.  end.
     1369     run make-tt in this-procedure .
     1370     define variable v-row as integer   no-undo .
     1371     for each temp-grp :
     1372        i-numb = i-numb + 1 .
     1373        number-group = string(i-numb,"99999") .
     1374         run print-grp-name ( output v-row ) .
     1375         for each temp-str where temp-str.grp-code =  temp-grp.grp-code no-lock :
     1376             run print-line in this-procedure .
     1377         end.
     1378         run print-grp-itogo (input v-row ) .
     1379      end.
     1380     run PrintPodval in this-procedure .
     1381     run paramls-write in this-procedure
     1382       (input "file"
     1383       ,input string(v-ind)
     1384       ,input v-file-name
     1385       ) .
     1386   Output stream Macr_Excel  close .
     1387   if mFrameView
     1388   then do:
     1389      HIDE FRAME InfoFrame.
     1390   end.
     1391       run paramls-write in this-procedure
     1392           (input "charcol"
     1393           ,input ""
     1394           ,input "1,3,4,5,6"
     1395           ) .
     1396     run end-proc in this-procedure .
     1397     run rep/runexcel.p (p-file-name ).
     1398   procedure print-line :
     1399     do on error undo, return error return-value :
     1400   num#str# = num#str# + 1.
     1401   num#col# = 1.
     1402   run macr_excel_char ( temp-str.artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1403   run macr_excel_char ( temp-str.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1404   run macr_excel_char ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1405   run macr_excel_char ( temp-str.grp-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1406   run macr_excel_char ( temp-str.prod-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1407   for each temp-abc:
     1408     find first ub.abc-analysis-goods no-lock where
     1409                ub.abc-analysis-goods.abc-id = temp-abc.id and
     1410                ub.abc-analysis-goods.db-num = temp-abc.db-num and
     1411                ub.abc-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1412     if available ub.abc-analysis-goods then do:
     1413        run macr_excel_char ( ub.abc-analysis-goods.abcg-abc + string(ub.abc-analysis-goods.rating) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1414        run macr_excel_DEC ( ub.abc-analysis-goods.proc-from-all , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1415        run macr_excel_DEC ( ub.abc-analysis-goods.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1416   define variable v-color as integer   no-undo .
     1417       if ub.abc-analysis-goods.abcg-abc = "A" then
     1418          assign
     1419            v-color = 3
     1420          .
     1421       if ub.abc-analysis-goods.abcg-abc = "C" then
     1422          assign
     1423            v-color = 0
     1424          .
     1425       if ub.abc-analysis-goods.abcg-abc = "B" then
     1426          assign
     1427             v-color = 41
     1428          .
     1429       if ub.abc-analysis-goods.abcg-abc = "D" then
     1430          assign
     1431            v-color = 14
     1432          .
     1433       if ub.abc-analysis-goods.abcg-abc = "E" then
     1434          assign
     1435            v-color = 13
     1436          .
     1437       if ub.abc-analysis-goods.abcg-abc = "F" then
     1438          assign
     1439             v-color = 48
     1440          .
     1441      put  stream macr_excel unformatted
     1442           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1443           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1444        assign    num#col# = num#col# + 1 .
     1445     end.
     1446     ELSE
     1447     num#col# = num#col# + 3 .
     1448   end.
     1449     end.
     1450   end procedure.
     1451   procedure print-all-itog :
     1452   end procedure.
     1453   procedure PrintTitul :
     1454     do  on error undo, return error return-value  :
     1455     define variable cc as integer no-undo .
     1456     define variable tt as integer no-undo .
     1457       num#str# = num#str# + 1.
     1458       num#col# = 2.
     1459       cc = num#str# .
     1460       run macr_excel_char ( "Сравнение ABC анализов по группам товаров"  , num#str# , num#col#   ) .
     1461       num#str# = num#str# + 1.
     1462       num#col# = 2.
     1463       run macr_excel_char ("Печать " + cur-time-date()  , num#str# , num#col#   ) .
     1464       run macr_cell_format
     1465           ( 12     ,
     1466             true   ,
     1467             false  ,
     1468             ?      ,
     1469             cc     ,
     1470             2      ,
     1471             num#str# ,
     1472             2 ) .
     1473       run pshap in this-procedure .
     1474        num#str# = num#str# + 1.
     1475       num#col# = 1.
     1476       run macr_excel_char ( "Артикул товара"   , num#str# , num#col#   ) .
     1477       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1478       num#col# = 2.
     1479       run macr_excel_char ( "Код"   , num#str# , num#col#   ) .
     1480       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1481       num#col# = 3.
     1482       run macr_excel_char ( "ТМЦ"   , num#str# , num#col#   ) .
     1483       run macr_cell_size ( 25 , ? , num#str# , num#col# , ?, ? ) .
     1484       num#col# = 4.
     1485       run macr_excel_char ( "Группа"   , num#str# , num#col#   ) .
     1486       run macr_cell_size ( 32 , ? , num#str# , num#col# , ?, ? ) .
     1487       num#col# = 5.
     1488       run macr_excel_char ( "Производитель"   , num#str# , num#col#   ) .
     1489       run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1490       for each temp-abc :
     1491           num#col# = num#col# + 1.
     1492           run macr_excel_char ( "Анализ № " + string(temp-abc.nn) , num#str# , num#col#   ) .
     1493           run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1494           num#col# = num#col# + 1.
     1495           run macr_excel_char (  "%"  , num#str# , num#col#   ) .
     1496           run macr_cell_size ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1497           num#col# = num#col# + 1.
     1498           run macr_excel_char ( "Сумма по критерию"  , num#str# , num#col#   ) .
     1499           run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1500           if temp-abc.nn modulo 2 = 0 then do:
     1501               run macr_cell_format
     1502               ( 10    ,
     1503                 true  ,
     1504                 false  ,
     1505                 33    ,
     1506                 num#str# ,
     1507                 num#col# - 2 ,
     1508                 num#str# ,
     1509                 num#col# ) .
     1510           end.
     1511           else do:
     1512               run macr_cell_format
     1513               ( 10    ,
     1514                 true  ,
     1515                 false  ,
     1516                 34    ,
     1517                 num#str# ,
     1518                 num#col# - 2 ,
     1519                 num#str# ,
     1520                 num#col# ) .
     1521           end.
     1522       end.
     1523       run macr_cell_format
     1524       ( 10    ,
     1525         true  ,
     1526         false  ,
     1527         ?    ,
     1528         num#str# ,
     1529         1 ,
     1530         num#str# ,
     1531         14 ) .
     1532        put  stream macr_excel unformatted
     1533          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1534          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1535          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1536          .
     1537     end.
     1538   end procedure.
     1539   procedure PrintPodval :
     1540     do on error undo, return error return-value  :
     1541       num#str# = num#str# + 3.
     1542       num#col# = 1.
     1543       run macr_excel_char ( "Исполнитель"   , num#str# , num#col#   ) .
     1544       num#col# = 3.
     1545       run macr_excel_char ( p-user-name  , num#str# , num#col#   ) .
     1546     end.
     1547   end procedure.
     1548   procedure make-tt :
     1549     do
     1550     on error undo, return error return-value
     1551     :
     1552   define buffer buf_abc-analysis-goods  for ub.abc-analysis-goods.
     1553   define buffer buf_goods               for ub.goods.
     1554   define buffer buf_clients             for ub.clients  .
     1555   define variable  v-izt      as character no-undo .
     1556   define variable  v-acc-mat as character no-undo .
     1557   define variable  v-Amin    as character no-undo .
     1558   define variable  counter        as integer   no-undo init 0 .
     1559   define variable  v-repfrm-title as character no-undo .
     1560   v-repfrm-title = "Сбор данных ABC анализа" .
     1561   for each temp-abc :
     1562     for each buf_abc-analysis-goods no-lock where
     1563              buf_abc-analysis-goods.abc-id = temp-abc.id  and
     1564              buf_abc-analysis-goods.db-num = temp-abc.db-num :
     1565       if not can-find ( first temp-str where temp-str.gds-code  = buf_abc-analysis-goods.gds-code) then do:
     1566           find first buf_goods no-lock where buf_goods.gds-code =  buf_abc-analysis-goods.gds-code no-error .
     1567           find first buf_clients no-lock where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-error .
     1568           if available buf_goods and available buf_clients  then do:
     1569               assign
     1570                 counter = counter + 1
     1571               .
     1572   IF ( counter modulo v-account = 0 )  then DO:
     1573    Assign
     1574       v-kol-spice = (50 - LENGTH(v-repfrm-title)) / 2
     1575       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-title)
     1576       .
     1577             if  log-manager:logfile-name ne ?
     1578             then DO:
     1579                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1580             end.
     1581              if mFrameView
     1582              then do:
     1583               DISPLAY
     1584                 counter @ RecordsDone
     1585                 RecordsString   @ RecordsString
     1586                 WITH FRAME InfoFrame.
     1587              end.
     1588   End.
     1589      if v-button-stop then  DO:
     1590            if mFrameView
     1591            then
     1592               PROCESS EVENTS.
     1593            IF StopProcessing THEN DO:
     1594            RETURN error.
     1595            End.
     1596      end.
     1597                 create temp-str .
     1598                 assign
     1599                     temp-str.prc       = buf_abc-analysis-goods.abcg-abc + string ( buf_abc-analysis-goods.rating , "999999999999" )
     1600                     temp-str.gds-code  = buf_abc-analysis-goods.gds-code
     1601                     temp-str.artic     = buf_goods.artic
     1602                     temp-str.gds-name  = buf_goods.gds-name
     1603                     temp-str.grp-code  = buf_goods.grp-code
     1604                     temp-str.grp-name  = buf_goods.grp-name
     1605                     temp-str.prod-name = buf_clients.obj-name
     1606                 .
     1607           end.
     1608       end.
     1609     end.
     1610     v-repfrm-title = "Сбор по группам товаров" .
     1611     counter = 0 .
     1612     for each buf_abc-analysis-grp no-lock where
     1613              buf_abc-analysis-grp.abc-id = temp-abc.id  and
     1614              buf_abc-analysis-grp.db-num = temp-abc.db-num :
     1615       if not can-find ( first temp-grp where temp-grp.grp-code  = buf_abc-analysis-grp.grp-code) then do:
     1616           find first buf_gds-grp no-lock where buf_gds-grp.node-code =  buf_abc-analysis-grp.grp-code no-error .
     1617              if available buf_gds-grp then do:
     1618                 assign
     1619                   counter = counter + 1
     1620                 .
     1621   IF ( counter modulo v-account = 0 )  then DO:
     1622    Assign
     1623       v-kol-spice = (50 - LENGTH(v-repfrm-title)) / 2
     1624       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-title)
     1625       .
     1626             if  log-manager:logfile-name ne ?
     1627             then DO:
     1628                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1629             end.
     1630              if mFrameView
     1631              then do:
     1632               DISPLAY
     1633                 counter @ RecordsDone
     1634                 RecordsString   @ RecordsString
     1635                 WITH FRAME InfoFrame.
     1636              end.
     1637   End.
     1638      if v-button-stop then  DO:
     1639            if mFrameView
     1640            then
     1641               PROCESS EVENTS.
     1642            IF StopProcessing THEN DO:
     1643            RETURN error.
     1644            End.
     1645      end.
     1646                   create temp-grp .
     1647                   assign
     1648                       temp-grp.prc        = buf_abc-analysis-grp.abcg-abc + string( buf_abc-analysis-grp.rating ,"9999999999")
     1649                       temp-grp.grp-code   = buf_gds-grp.node-code
     1650                       temp-grp.is-term    = buf_gds-grp.is-term
     1651                       temp-grp.lvl-num    = buf_gds-grp.lvl-num
     1652                       temp-grp.node-name  = buf_gds-grp.node-name
     1653                       temp-grp.upper-code = buf_gds-grp.upper-code
     1654                   .
     1655             end.
     1656       end.
     1657     end.
     1658   end.
     1659     end.
     1660    end procedure.
     1661   procedure pshap :
     1662     do
     1663     on error undo, return error return-value
     1664     :
     1665     define variable tt as integer   no-undo .
     1666       num#str# = num#str# + 1.
     1667       num#col# = 1.
     1668       tt = num#str# .
     1669       for each temp-abc :
     1670           run macr_excel_char ( "Анализ № " + string(temp-abc.nn )                , num#str# , num#col#   ) .
     1671               run macr_cell_format
     1672               ( 10    ,
     1673                 true  ,
     1674                 false  ,
     1675                 ?    ,
     1676                 num#str# ,
     1677                 num#col#  ,
     1678                 num#str# ,
     1679                 num#col# ) .
     1680           num#str# = num#str# + 1.
     1681           run macr_excel_char ( temp-abc.name               , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1682           if temp-abc.des <> "" then do:  run macr_excel_char ( temp-abc.des                , num#str# , num#col#   ) . num#str# = num#str# + 1. end.
     1683           run macr_excel_char ( temp-abc.name-cral          , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1684           run macr_excel_char ( "A=" + string( temp-abc.A )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1685           run macr_excel_char ( "B=" + string( temp-abc.B )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1686           run macr_excel_char ( "C=" + string( temp-abc.C )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1687           if temp-abc.D > 0 then do:  run macr_excel_char ( "D=" + string(temp-abc.D )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1688           if temp-abc.E > 0 then do:  run macr_excel_char ( "E=" + string(temp-abc.E )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1689           if temp-abc.F > 0 then do:  run macr_excel_char ( "F=" + string(temp-abc.F )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1690           if temp-abc.type <> " " then do: run macr_excel_char ( temp-abc.type          , num#str# , num#col#   ) .  num#str# = num#str# + 1.    end.
     1691           run macr_excel_char ( "создан : " + string(temp-abc.date-cr , "99/99/9999")            , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1692           run macr_excel_char ( temp-abc.period             , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1693           run macr_excel_char ( temp-abc.ext-doc-type       , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1694           run macr_excel_char ( temp-abc.obj                , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1695       end.
     1696     end.
     1697   end procedure.
     1698   procedure print-grp-name :
     1699   define output parameter p-row as integer   no-undo .
     1700     do
     1701     on error undo, return error return-value
     1702     :
     1703   num#str# = num#str# + 1.
     1704   num#col# = 1.
     1705   define variable v-full-name as character no-undo .
     1706   run grplib-get-full-name ( input temp-grp.grp-code , output v-full-name ) .
     1707   run macr_excel_char (  v-full-name    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1708    assign    num#col# = num#col# + 1 .
     1709    assign    num#col# = num#col# + 1 .
     1710   run macr_excel_char ( "ГРУППА"     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1711       run macr_cell_format
     1712           ( 12     ,
     1713             true   ,
     1714             false  ,
     1715             48      ,
     1716             num#str# ,
     1717             1      ,
     1718             num#str# ,
     1719             5 + ( var-kol * 3 ) ) .
     1720   p-row =  num#str# .
     1721     end.
     1722   end procedure.
     1723   procedure print-grp-itogo :
     1724   define input  parameter p-row as integer   no-undo .
     1725     do
     1726     on error undo, return error return-value
     1727     :
     1728     run paramls-write in this-procedure
     1729       (input "rowsgroup"
     1730       ,input string(v-ind) + ',':u + number-group
     1731       ,input substitute('&1:&2' ,  p-row, num#str# )
     1732       ) .
     1733   num#str# = num#str# + 1.
     1734   num#col# = 1.
     1735       run macr_cell_format
     1736           ( ?     ,
     1737             true   ,
     1738             false  ,
     1739             ?      ,
     1740             num#str# ,
     1741             1      ,
     1742             num#str# ,
     1743             5 + ( var-kol * 3 ) ) .
     1744   define variable v-full-name as character no-undo .
     1745   run grplib-get-full-name ( input temp-grp.grp-code , output v-full-name ) .
     1746   run macr_excel_char (  v-full-name    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1747    assign    num#col# = num#col# + 1 .
     1748    assign    num#col# = num#col# + 1 .
     1749   run macr_excel_char ( "Итого по ГРУППЕ"   , num#str# , num#col#   ) . assign num#col# = num#col# + 1 .
     1750   run macr_excel_char ( ""                  , num#str# , num#col#   ) . assign num#col# = num#col# + 1 .
     1751   for each temp-abc:
     1752     find first ub.abc-analysis-grp no-lock where
     1753                ub.abc-analysis-grp.abc-id = temp-abc.id and
     1754                ub.abc-analysis-grp.db-num = temp-abc.db-num and
     1755                ub.abc-analysis-grp.grp-code = temp-grp.grp-code no-error .
     1756     if available ub.abc-analysis-grp then do:
     1757        run macr_excel_char ( ub.abc-analysis-grp.abcg-abc + string(ub.abc-analysis-grp.rating) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1758        run macr_excel_DEC ( ub.abc-analysis-grp.proc-from-all , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1759        run macr_excel_DEC ( ub.abc-analysis-grp.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1760   define variable v-color as integer   no-undo .
     1761       if ub.abc-analysis-grp.abcg-abc = "A" then
     1762          assign
     1763            v-color = 3
     1764          .
     1765       if ub.abc-analysis-grp.abcg-abc = "C" then
     1766          assign
     1767            v-color = 0
     1768          .
     1769       if ub.abc-analysis-grp.abcg-abc = "B" then
     1770          assign
     1771             v-color = 41
     1772          .
     1773       if ub.abc-analysis-grp.abcg-abc = "D" then
     1774          assign
     1775            v-color = 14
     1776          .
     1777       if ub.abc-analysis-grp.abcg-abc = "E" then
     1778          assign
     1779            v-color = 13
     1780          .
     1781       if ub.abc-analysis-grp.abcg-abc = "F" then
     1782          assign
     1783             v-color = 48
     1784          .
     1785      put  stream macr_excel unformatted
     1786           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1787           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10)
     1788           .
     1789        assign    num#col# = num#col# + 1 .
     1790     end.
     1791     ELSE
     1792     num#col# = num#col# + 3 .
     1793   end.
     1794     end.
     1795   end procedure.
     1796   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1797   procedure macr_excel_char :
     1798    do
     1799    on error undo, return error return-value
     1800    :
     1801    define input parameter  p-val as character no-undo .
     1802    define input parameter  p-row as integer no-undo .
     1803    define input parameter  p-col as integer no-undo .
     1804    if p-val = ? then p-val = "" .
     1805       put stream macr_excel unformatted
     1806             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1807    end.
     1808   end procedure.
     1809   procedure macr_excel_char_with_format :
     1810    do
     1811    on error undo, return error return-value
     1812    :
     1813    define input parameter  p-val as character no-undo .
     1814    define input parameter  p-row as integer no-undo .
     1815    define input parameter  p-col as integer no-undo .
     1816    if p-val = ? then p-val = "" .
     1817       put stream macr_excel unformatted
     1818             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1819       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1820       put stream macr_excel unformatted
     1821             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1822    end.
     1823   end procedure.
     1824   procedure macr_excel_cell_format :
     1825    do
     1826    on error undo, return error return-value
     1827    :
     1828    define input parameter  p-val    as character no-undo .
     1829    define input parameter  p-row    as integer   no-undo .
     1830    define input parameter  p-col    as integer   no-undo .
     1831    define input parameter  p-format as character no-undo .
     1832    if p-val = ? then p-val = "" .
     1833       put stream macr_excel unformatted
     1834             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1835       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1836       put stream macr_excel unformatted
     1837             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1838    end.
     1839   end procedure.
     1840   procedure macr_excel_sum :
     1841    do
     1842    on error undo, return error return-value
     1843    :
     1844    define input parameter  p-row as integer no-undo .
     1845    define input parameter  p-col as integer no-undo .
     1846    define input parameter  p-row1 as integer no-undo .
     1847    define input parameter  p-col1 as integer no-undo .
     1848    define input parameter  p-row2 as integer no-undo .
     1849    define input parameter  p-col2 as integer no-undo .
     1850       put stream macr_excel unformatted
     1851             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1852    end.
     1853   end procedure.
     1854   procedure macr_excel_dec :
     1855    do
     1856    on error undo, return error return-value
     1857    :
     1858    define input parameter  p-val as character no-undo .
     1859    define input parameter  p-row as integer   no-undo .
     1860    define input parameter  p-col as integer   no-undo .
     1861     if p-val = ? then p-val =  "" .
     1862      put  stream macr_excel unformatted
     1863           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1864    end.
     1865   end procedure.
     1866   procedure macr_cell_format :
     1867    do
     1868    on error undo, return error return-value
     1869    :
     1870    define input parameter  p-size   as integer   no-undo .
     1871    define input parameter  p-bold   as logical   no-undo .
     1872    define input parameter  p-italic as logical   no-undo .
     1873    define input parameter  p-color  as integer   no-undo .
     1874    define input parameter  p-row    as integer   no-undo .
     1875    define input parameter  p-col    as integer   no-undo .
     1876    define input parameter  p-row-2  as integer   no-undo .
     1877    define input parameter  p-col-2  as integer   no-undo .
     1878     if p-size = ? then p-size = 10 .
     1879     if p-bold = ? then p-bold = false .
     1880     if p-italic = ? then p-italic = false .
     1881     if p-row-2 = ? then p-row-2 = p-row .
     1882     if p-col-2 = ? then p-col-2 = p-col .
     1883     put  stream macr_excel unformatted
     1884      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1885     if p-color <> ? then do:
     1886        put  stream macr_excel unformatted
     1887          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1888     end.
     1889     put  stream macr_excel unformatted
     1890          substitute('format.font(,&1,&2,&3)' , p-size,
     1891                                           string ( p-bold  , "true/false" ) ,
     1892                                           string ( p-italic , "true/false" )
     1893                                           ) + chr(10) .
     1894    end.
     1895   end procedure.
     1896   procedure macr_cell_size :
     1897    do
     1898    on error undo, return error return-value
     1899    :
     1900    define input parameter  p-w   as integer   no-undo .
     1901    define input parameter  p-l   as integer   no-undo .
     1902    define input parameter  p-row    as integer   no-undo .
     1903    define input parameter  p-col    as integer   no-undo .
     1904    define input parameter  p-row-2  as integer   no-undo .
     1905    define input parameter  p-col-2  as integer   no-undo .
     1906     if p-row-2 = ? then p-row-2 = p-row .
     1907     if p-col-2 = ? then p-col-2 = p-col .
     1908     if p-w = ? then    p-w = 0 .
     1909     if p-l = ? then    p-l = 0 .
     1910    define variable s-w as character no-undo .
     1911    define variable s-l as character no-undo .
     1912    if p-w = 0 then s-w = "" .
     1913               else s-w = string(p-w)  .
     1914    if p-l = 0 then s-l = "" .
     1915               else s-l = string(p-l)  .
     1916   put  stream macr_excel unformatted
     1917        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1918   put  stream macr_excel unformatted
     1919        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1920   put  stream macr_excel unformatted
     1921        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1922    end.
     1923   end procedure.
     1924   procedure proc-print-header :
     1925    do
     1926    on error undo, return error return-value
     1927    :
     1928      find first sheetf .
     1929        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1930        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1931        var-1 =  num#str# .
     1932        repeat c-c = 1 to sheetf.excel-row-title :
     1933        num#str# = num#str# + 1 .
     1934        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1935        do c-i = 1 to p-var :
     1936           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1937           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1938           num#col# = c-i .
     1939           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1940           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1941        end.
     1942       c-i = 0.
     1943       end.
     1944       run macr_cell_format (
     1945           10       ,
     1946           true     ,
     1947           false    ,
     1948           35       ,
     1949           var-1 + 1,
     1950           1        ,
     1951           num#str# ,
     1952           num#col# )
     1953           .
     1954     put  stream macr_excel unformatted
     1955          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1956          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1957          .
     1958    end.
     1959   end procedure.
     1960   procedure end-proc :
     1961    do
     1962    on error undo, return error return-value
     1963    :
     1964     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1965     OUTPUT to VALUE (v-file-name) .
     1966     for each temp-param :
     1967       export  temp-param  .
     1968     end.
     1969    end.
     1970   end procedure.
