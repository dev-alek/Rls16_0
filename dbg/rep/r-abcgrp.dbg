      382   procedure create_obj-list :
      383      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      384      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      385      do
      386      on error undo, return error return-value
      387      :
      388         define buffer cli-obj for ub.clients .
      389         define variable p-var as integer no-undo .
      390         define buffer buf_obj-list for obj-list .
      391         find last buf_obj-list  use-index pi no-error .
      392         if available buf_obj-list
      393         then
      394            p-var = buf_obj-list.obj-id + 1.
      395         else
      396            p-var = 1.
      397         find first cli-obj where
      398                   cli-obj.obj-type = p-obj-type
      399               and cli-obj.obj-code = p-obj-code
      400         no-lock no-error.
      401         if available cli-obj
      402         then do:
      403            create buf_obj-list.
      404            assign
      405               buf_obj-list.obj-id   = p-var
      406               buf_obj-list.obj-code = cli-obj.obj-code
      407               buf_obj-list.obj-type = cli-obj.obj-type
      408               buf_obj-list.obj-name = cli-obj.obj-name
      409               buf_obj-list.db-num   = cli-obj.db-num
      410            .
      411         end.
      412      end.
      413   end.
