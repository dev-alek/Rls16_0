      822   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      824   procedure paramls-clear :
      825     define buffer buf_temp-param for temp-param .
      826     do
      827     on error undo, return error return-value
      828     :
      829       for each buf_temp-param
      830       on error undo, return error
      831       :
      832         delete buf_temp-param .
      833       end.
      834     end.
      835   end procedure.
      836   procedure paramls-write :
      837     define input  parameter p-code     as character no-undo .
      838     define input  parameter p-sub-code as character no-undo .
      839     define input  parameter p-value    as character no-undo .
      840     define buffer buf_temp-param for temp-param .
      841     do
      842     on error undo, return error return-value
      843     :
      844       find first buf_temp-param
      845         where buf_temp-param.param-code     = p-code
      846           and buf_temp-param.param-sub-code = p-sub-code
      847         no-error .
      848       if not available buf_temp-param then do:
      849         create buf_temp-param .
      850         assign
      851           buf_temp-param.param-code     = p-code
      852           buf_temp-param.param-sub-code = p-sub-code
      853         .
      854       end.
      855       assign
      856         buf_temp-param.param-value = p-value
      857       .
      858     end.
      859   end procedure.
      860   procedure paramls-read :
      861     define input  parameter p-code          as character no-undo .
      862     define input  parameter p-sub-code      as character no-undo .
      863     define input  parameter p-default-value as character no-undo .
      864     define output parameter p-value         as character no-undo .
      865     define buffer buf_temp-param for temp-param .
      866     do
      867     on error undo, return error return-value
      868     :
      869       find first buf_temp-param
      870         where buf_temp-param.param-code     = p-code
      871           and buf_temp-param.param-sub-code = p-sub-code
      872         no-error .
      873       if available buf_temp-param then do:
      874         assign
      875           p-value = buf_temp-param.param-value
      876         .
      877       end.
      878       else do:
      879         assign
      880           p-value = p-default-value
      881         .
      882       end.
      883     end.
      884   end procedure.
      885   procedure paramls-append :
      886     define input  parameter p-code     as character no-undo .
      887     define input  parameter p-sub-code as character no-undo .
      888     define input  parameter p-value    as character no-undo .
      889     define buffer buf_temp-param for temp-param .
      890     do
      891     on error undo, return error return-value
      892     :
      893       find first buf_temp-param
      894            where buf_temp-param.param-code     = p-code
      895              and buf_temp-param.param-sub-code = p-sub-code
      896         no-error .
      897       if not available buf_temp-param then do:
      898         create buf_temp-param .
      899         assign
      900           buf_temp-param.param-code     = p-code
      901           buf_temp-param.param-sub-code = p-sub-code
      902           buf_temp-param.param-value    = p-value
      903         .
      904       end.
      905       else do:
      906           assign
      907               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      908           .
      909       end.
      910     end.
      911   end procedure.
      912   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      913     if num-entries(string(p-dec), '.') = 2
      914       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      915       else return( string(p-dec)) .
      916   end function.
      917   function format-point-to-comma returns char (input orig as char ) .
      918   define variable rtext as character no-undo .
      919   define variable strt as integer no-undo .
      920   define variable leng as integer no-undo .
      921   assign rtext = orig .
      922   repeat:
      923     strt =  index(rtext,'.').
      924     if strt = 0 then leave.
      925     leng = 1.
      926     substring(rtext,strt,leng,"character") = v-delim .
      927   end.
      928   return rtext.
      929   end function.
      930   function format-excel-text returns char ( input start-text as char ) :
      931   def var  i    as int no-undo.
      932   def var  ch   as char no-undo.
      933   def var  n    as int no-undo.
      934   def var  ipos as int no-undo.
      935     n = num-entries(trim(start-text), chr(10)) - 1 .
      936     do i = 1 to n :
      937       ipos = index( start-text, chr(10)).
      938       if ipos > 0 then
      939         substr( start-text, ipos, 1 ) = ' '.
      940     end.
      941     n = num-entries(trim(start-text), chr(13)) - 1 .
      942     do i = 1 to n :
      943       ipos = index( start-text, chr(13)).
      944       if ipos > 0 then
      945         substr( start-text, ipos, 1 ) = ' '.
      946     end.
      947     if index( start-text, '"' ) = 0 then
      948       start-text =  '="'   + trim( start-text) + '"'   .
      949       else do:
      950         n = num-entries(trim(start-text), '"') - 1.
      951         do i = 1 to n :
      952           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      953         end.
      954         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      955         start-text = '="'  + ch  + '"' .
      956       end.
      957     return start-text.
      958   end.
      959   function excel-sum returns char (input p-dec as decimal ).
      960     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      961   end function.
      962   function excel-qnty returns char (input p-dec as decimal ).
      963     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      964   end function.
      965   function format-excel-text-macr returns char ( input start-text as char ) :
      966   def var  i    as int no-undo.
      967   def var  ch   as char no-undo.
      968   def var  n    as int no-undo.
      969   def var  ipos as int no-undo.
      970     n = num-entries(trim(start-text), chr(10)) - 1 .
      971     do i = 1 to n :
      972       ipos = index( start-text, chr(10)).
      973       if ipos > 0 then
      974         substring( start-text, ipos , 1 ) = ' '.
      975     end.
      976     n = num-entries(trim(start-text), chr(13)) - 1 .
      977     do i = 1 to n :
      978       ipos = index( start-text, chr(13)).
      979       if ipos > 0 then
      980         substring( start-text, ipos, 1 ) = ' '.
      981     end.
      982     if index( start-text, '"' ) = 0 then
      983       start-text =  '"'   + trim( start-text) + '"'   .
      984       else do:
      985         n = num-entries(trim(start-text), '"') - 1.
      986         do i = 1 to n :
      987           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      988         end.
      989         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      990         start-text = '"'  + ch  + '"' .
      991       end.
      992     n = num-entries(trim(start-text), chr(10)) - 1 .
      993     do i = 1 to n :
      994       ipos = index( start-text, chr(10)).
      995       if ipos > 0 then
      996         substring( start-text, ipos , 1 ) = ' '.
      997     end.
      998       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      999     return start-text.
     1000   end.
     1001   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   function func-get-name-from-ext-type   returns char
     1003     ( p-ext-type as character   ,
     1004       p-caps     as logical ).
     1005   define variable v-ext-name as character no-undo .
     1006   run get-name-from-ext-type in this-procedure (
     1007       input p-ext-type  ,
     1008       input p-caps  ,
     1009       output v-ext-name )
     1010       no-error .
     1011       if error-status :error then do:
     1012          assign
     1013            v-ext-name = p-ext-type
     1014          .
     1015       end.
     1016    return (v-ext-name) .
     1017   end.
     1018   procedure get-name-from-ext-type :
     1019    do
     1020    on error undo, return error return-value
     1021    :
     1022   define input  parameter p-ext-type as character no-undo .
     1023   define input  parameter p-caps     as logical no-undo   .
     1024   define output parameter p-ext-name as character no-undo .
     1025   define variable v-num as integer no-undo .
     1026     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1027       message
     1028         vss-include-info10 skip
     1029         "Неправильно задано значение входящего параметра! "
     1030         "Нет такого типа документов " p-ext-type
     1031         view-as alert-box error .
     1032         undo, return error .
     1033     end.
     1034     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1035     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1036     if p-caps  = true then do :
     1037        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1038     end .
     1039     end.
     1040   end procedure.
     1041   define variable vss-include-info11 as character format "X(65)" no-undo
     1042   initial "@(#)$Workfile$ $Revision$".
     1043   procedure grplib-get-full-name :
     1044      define input parameter p-node-code  as integer      no-undo.
     1045      define output parameter p-full-name as character    no-undo.
     1046      do
     1047   on error undo, return error
     1048   :
     1049       define variable v-upper-code    as integer           no-undo.
     1050       define buffer buf_gds-grp       for ub.gds-grp.
     1051       define buffer buf_upper_gds-grp for ub.gds-grp.
     1052       find first buf_gds-grp no-lock
     1053            where buf_gds-grp.node-code = p-node-code
     1054       no-error.
     1055       if not available buf_gds-grp
     1056       then do:
     1057           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1058       end.
     1059       assign
     1060           p-full-name  = ""
     1061           v-upper-code = 1
     1062       .
     1063       do while buf_gds-grp.upper-code <> 0
     1064       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1065       :
     1066           assign
     1067               p-full-name  = buf_gds-grp.node-name
     1068                            + (if p-full-name <> "" then chr(47) else "")
     1069                            + p-full-name
     1070               v-upper-code = buf_gds-grp.upper-code
     1071           .
     1072           find first buf_gds-grp no-lock
     1073                where buf_gds-grp.node-code = v-upper-code
     1074           no-error.
     1075           if not available buf_gds-grp
     1076           then do:
     1077               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1078                                   + string( v-upper-code )
     1079                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1080           end.
     1081       end.
     1082       assign
     1083       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1084       .
     1085   end.
     1086   end .
     1087   procedure grplib-get-node-from-full-name :
     1088   define input parameter p-full-name as character no-undo .
     1089   define output parameter p-node-code as integer no-undo .
     1090   define variable v-ii as integer no-undo .
     1091   define variable v-upper-code as integer no-undo .
     1092   define variable v-root-code as integer no-undo .
     1093   define variable v-entry as character no-undo .
     1094   define buffer buf_gds-grp       for ub.gds-grp.
     1095   do
     1096   on error undo, return error
     1097   :
     1098     find first buf_gds-grp no-lock
     1099         where buf_gds-grp.upper-code = 0
     1100     no-error .
     1101     if not available buf_gds-grp
     1102     then do:
     1103         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1104     end.
     1105     else do:
     1106       assign
     1107       v-root-code = buf_gds-grp.node-code
     1108       .
     1109     end.
     1110     v-upper-code = v-root-code.
     1111     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1112       assign
     1113       v-entry = entry(v-ii, p-full-name, chr(47)).
     1114       if v-entry = '' then leave.
     1115       find first buf_gds-grp no-lock where
     1116                 buf_gds-grp.node-name = v-entry
     1117             and buf_gds-grp.upper-code = v-upper-code
     1118             no-error.
     1119       if not available buf_gds-grp then do:
     1120         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1121       end.
     1122       else do:
     1123         p-node-code = buf_gds-grp.node-code.
     1124         v-upper-code = buf_gds-grp.node-code.
     1125       end.
     1126     end.
     1127   end.
     1128   end .
     1129   Make-Excel      = true.
     1130   Make-Excel-com  = false .
     1131   define buffer buf_abc-analysis            for ub.abc-analysis.
     1132   define buffer buf_abc-analysis-goods      for ub.abc-analysis-goods.
     1133   define buffer buf_abc-analysis-gds-obj    for ub.abc-analysis-gds-obj.
     1134   define buffer buf_abc-analysis-obj        for ub.abc-analysis-obj.
     1135   define buffer buf_assortment-matrix       for ub.assortment-matrix.
     1136   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods.
     1137   define buffer buf_gds-obj-prop            for ub.gds-obj-prop .
     1138   define buffer buf_criterion-analysis      for ub.criterion-analysis .
     1139   define buffer buf_abc-analysis-grp        for ub.abc-analysis-grp  .
     1140   define buffer buf_gds-grp                 for ub.gds-grp  .
     1141   DEFINE temp-table temp-str no-undo
     1142     field   gds-code    as integer
     1143     field   artic       as character
     1144     field   gds-name    as character
     1145     field   grp-code    as integer
     1146     field   grp-name    as character
     1147     field   prod-name   as character
     1148     field   prc         as character
     1149   index  pi  IS PRIMARY  prc
     1150   .
     1151   DEFINE temp-table temp-grp no-undo
     1152     field prc          as character
     1153     field grp-code     as integer
     1154     field grp-name     as character
     1155     field is-term      as logical
     1156     field lvl-num      as integer
     1157     field node-name    as character
