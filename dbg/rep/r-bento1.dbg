     1232   PROCEDURE no-benq.
     1233   DEFINE OUTPUT PARAMETER found as logical init no.
     1234   define buffer buf_chk-doc for ub.chk-doc.
     1235   FOR EACH obj-list WHERE
     1236           obj-list.obj-type = 'маг':U NO-LOCK :
     1237     CASE X-Radio-Task > 1 :
     1238       WHEN YES THEN DO:
     1239         FOR EACH buf_chk-doc NO-LOCK WHERE
     1240                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1241                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1242                 (
     1243                   buf_chk-doc.shift-date >= X-date-start AND
     1244                   buf_chk-doc.shift-date <= X-date-end)
     1245                   AND
     1246                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1247           IF X-Radio-Task = 3 AND
     1248           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1249             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1250           IF X-Radio-Task = 4 AND
     1251           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1252           found = yes.
     1253           return.
     1254         END.
     1255       END.
     1256       WHEN NO THEN DO:
     1257         FOR EACH buf_chk-doc NO-LOCK WHERE
     1258               buf_chk-doc.obj-type = obj-list.obj-type AND
     1259               buf_chk-doc.obj-code = obj-list.obj-code AND
     1260               buf_chk-doc.chk-date >= X-date-start AND
     1261               buf_chk-doc.chk-date <= X-date-end   AND
     1262               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1263           found = yes.
     1264           return.
     1265         END.
     1266        END.
     1267      END CASE.
     1268    END.
     1269   END PROCEDURE.
     1270   PROCEDURE no-benqi.
     1271   DEFINE OUTPUT PARAMETER found as logical init no.
     1272   define buffer buf_chk-doc for ub.chk-doc.
     1273   define buffer buf_inkas for ub.inkas.
     1274   FOR EACH obj-list WHERE
     1275         obj-list.obj-type = 'маг':U NO-LOCK :
     1276     CASE X-Radio-Task > 1 :
     1277       WHEN YES THEN DO:
     1278         FOR EACH buf_chk-doc No-LOCK WHERE
     1279                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1280                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1281                 (
     1282                   buf_chk-doc.shift-date >= X-date-start AND
     1283                   buf_chk-doc.shift-date <= X-date-end)
     1284                   AND
     1285                   buf_Chk-doc.out-code = ? AND
     1286                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1287           IF X-Radio-Task = 3 AND
     1288           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1289             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1290           IF X-Radio-Task = 4 AND
     1291           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1292           found = yes.
     1293           return.
     1294         END.
     1295         FOR EACH buf_inkas No-LOCK WHERE
     1296                   buf_inkas.obj-type = obj-list.obj-type AND
     1297                   buf_inkas.obj-code = obj-list.obj-code AND
     1298                   (
     1299                   buf_inkas.shift-date >= X-date-start AND
     1300                   buf_inkas.shift-date <= X-date-end):
     1301           if buf_inkas.status_ = 'факт':U
     1302           or buf_inkas.status_ = 'запрос':U then next.
     1303           IF X-Radio-Task = 3 AND
     1304           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1305             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1306           IF X-Radio-Task = 4 AND
     1307           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1308           found = yes.
     1309           return.
     1310         END.
     1311       END.
     1312       WHEN NO THEN DO:
     1313         FOR EACH buf_chk-doc NO-LOCK WHERE
     1314                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1315                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1316                 buf_chk-doc.chk-date >= X-date-start AND
     1317                 buf_chk-doc.chk-date <= X-date-end   AND
     1318                 buf_Chk-doc.out-code = ? AND
     1319                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1320           found = yes.
     1321           return.
     1322         END.
     1323         FOR EACH buf_inkas NO-LOCK WHERE
     1324                 buf_inkas.obj-type = obj-list.obj-type AND
     1325                 buf_inkas.obj-code = obj-list.obj-code AND
     1326                 buf_inkas.doc-date >= X-date-start AND
     1327                 buf_inkas.doc-date <= X-date-end :
     1328           if buf_inkas.status_ = 'факт':U
     1329           or buf_inkas.status_ = 'запрос':U then next.
     1330           found = yes.
     1331           return.
     1332         END.
     1333       END.
     1334     END CASE.
     1335   END.
     1336   END PROCEDURE.
