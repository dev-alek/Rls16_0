     1484   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1485   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1486   procedure cur-time :
     1487      define output parameter p-today as date      no-undo .
     1488      define output parameter p-time  as integer   no-undo .
     1489     do
     1490     on error undo, return error
     1491     :
     1492       define variable v-date1 as date      no-undo .
     1493       define variable v-date2 as date      no-undo .
     1494       define variable v-time  as integer   no-undo .
     1495       assign
     1496         v-date1 = today
     1497         v-time  = time
     1498         v-date2 = today
     1499       .
     1500       if v-date1 <> v-date2
     1501       then do:
     1502         assign
     1503           v-date1 = today
     1504           v-time  = v-time
     1505         .
     1506       end.
     1507       assign
     1508         p-today = v-date1
     1509         p-time  = v-time
     1510       .
     1511     end.
     1512   end.
     1513   function cur-time-date returns character
     1514   :
     1515     return string(today, '99/99/9999':U) .
     1516   end.
     1517   function cur-time-mjd returns decimal
     1518   :
     1519     define variable v-date as date      no-undo .
     1520     define variable v-time as integer   no-undo .
     1521     run cur-time in this-procedure
     1522       (output v-date
     1523       ,output v-time
     1524       ) .
     1525     return integer(v-date) - 2400002 + (v-time / 86400) .
     1526   end.
     1527   function cur-time-get-ending-index returns integer
     1528   (input p-number as integer
     1529   )
     1530   :
     1531     if p-number < 0
     1532     or p-number = ?
     1533     then do:
     1534       return 1 .
     1535     end.
     1536     define variable v-rest as integer   no-undo .
     1537     assign
     1538       p-number = p-number modulo 100
     1539     .
     1540     if p-number < 20
     1541     then do:
     1542       assign
     1543         v-rest = p-number
     1544       .
     1545     end.
     1546     else do:
     1547       assign
     1548         v-rest = p-number modulo 10
     1549       .
     1550     end.
     1551     case v-rest :
     1552       when 1
     1553       then do:
     1554         return 2 .
     1555       end.
     1556       when 2 or
     1557       when 3 or
     1558       when 4
     1559       then do:
     1560         return 3 .
     1561       end.
     1562       otherwise do:
     1563         return 1 .
     1564       end.
     1565     end case .
     1566   end.
     1567   procedure cur-time-mjd-to-date :
     1568      define input  parameter i-mjd-diff as decimal no-undo.
     1569      define output parameter o-Date     as date    no-undo.
     1570      define output parameter o-Time     as integer no-undo.
     1571      define variable v-day-number as integer   no-undo .
     1572      if    i-mjd-diff < 0
     1573         or i-mjd-diff = ?
     1574      then do:
     1575         return "?" .
     1576      end.
     1577      assign
     1578         v-day-number = truncate(i-mjd-diff,0).
     1579         o-Date = date(v-day-number + 2400002).
     1580         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1581     .
     1582   end.
     1583   function cur-time-mjd-to-string returns character
     1584   (input p-mjd-diff as decimal
     1585   )
     1586   :
     1587     define variable v-day-number as integer   no-undo .
     1588     define variable v-seconds    as integer   no-undo .
     1589     define variable v-hour       as integer   no-undo .
     1590     define variable v-min        as integer   no-undo .
     1591     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1592     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1593     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1594     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1595     if p-mjd-diff < 0
     1596     or p-mjd-diff = ?
     1597     then do:
     1598       return "?" .
     1599     end.
     1600     assign
     1601       v-day-number = integer(truncate(p-mjd-diff,0))
     1602       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1603     .
     1604     if v-seconds > 86400
     1605     then do:
     1606       assign
     1607         v-seconds = 86400 - 1
     1608       .
     1609     end.
     1610     if v-seconds < 0
     1611     then do:
     1612       assign
     1613         v-seconds = 0
     1614       .
     1615     end.
     1616     assign
     1617       v-hour = truncate(v-seconds / 3600, 0)
     1618     .
     1619     assign
     1620       v-seconds = v-seconds modulo 3600
     1621     .
     1622     assign
     1623       v-min = truncate(v-seconds / 60, 0)
     1624     .
     1625     assign
     1626       v-seconds = v-seconds modulo 60
     1627     .
     1628     return
     1629         (if v-day-number <> 0
     1630           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1631           else ""
     1632         )
     1633       + (if v-day-number <> 0 or v-hour <> 0
     1634           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1635           else ""
     1636         )
     1637       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1638           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1639           else ""
     1640         )
     1641       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1642       .
     1643   end.
     1644   function cur-time-string returns character
     1645   :
     1646     define variable v-date as date      no-undo .
     1647     define variable v-time as integer   no-undo .
     1648     run cur-time in this-procedure
     1649       (output v-date
     1650       ,output v-time
     1651       ) .
     1652     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1653   end.
     1654   function cur-time-string-sec returns character
     1655   :
     1656     define variable v-date as date      no-undo .
     1657     define variable v-time as integer   no-undo .
     1658     run cur-time in this-procedure
     1659       (output v-date
     1660       ,output v-time
     1661       ) .
     1662     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1663   end.
     1664   function cur-time-custom  returns character
     1665   (input p-prefix as character
     1666   ,input p-date-format as character
     1667   ,input p-delimiter as character
     1668   ,input p-time-format as character
     1669   ,input p-suffix as character
     1670   )
     1671   :
     1672     define variable v-date as date      no-undo .
     1673     define variable v-time as integer   no-undo .
     1674     run cur-time in this-procedure
     1675       (output v-date
     1676       ,output v-time
     1677       ) .
     1678     return
     1679       p-prefix
     1680       + string(v-date, p-date-format)
     1681       + p-delimiter
     1682       + string(v-time, p-time-format)
     1683       + p-suffix
     1684       .
     1685   end.
     1686   function cur-time-print  returns character
     1687   :
     1688     define variable v-date as date      no-undo .
     1689     define variable v-time as integer   no-undo .
     1690     run cur-time in this-procedure
     1691       (output v-date
     1692       ,output v-time
     1693       ) .
     1694     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1695   end.
     1696   function cur-time-datetime returns datetime
     1697   :
     1698     define variable v-char as character no-undo .
     1699     define variable v-datetime as datetime no-undo .
     1700     v-char = cur-time-string().
     1701     v-datetime = datetime(v-char).
     1702     return  v-datetime.
     1703   end.
     1704   function cur-time-string-msec returns character
     1705   :
     1706     define variable v-date as datetime  no-undo .
     1707     v-date = now.
     1708     return string(v-date) .
     1709   end.
     1710   function fnc-convert-dot-to-colon returns character
     1711       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1712   function fnc-convert-dot-to-colon returns character
     1713   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1714       define variable result as character no-undo.
     1715       define variable v-str-result as character no-undo.
     1716       if p-data = ? then p-data = 0 .
     1717       p-data = round(p-data, p-num).
     1718       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1719       return v-str-result.
     1720   END FUNCTION.
     1721   function putRowAmount1 returns character private
     1722   (input p-curr-name as character
     1723   ,input p-total1    as decimal
     1724   ) :
     1725   define variable v-row-amount as character no-undo .
     1726   define variable v-curr-name  as character no-undo .
     1727     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1728     v-row-amount = substitute (
     1729         '<td>&1</td><td num="0.00" val="&2">&2</td><td><br /></td><td><br /></td>'
     1730         , v-curr-name
     1731         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1732     ) .
     1733     return v-row-amount .
     1734   end function .
     1735   function putRowAmount returns character private
     1736   (input p-curr-name as character
     1737   ,input p-total1    as decimal
     1738   ,input p-total2    as decimal
     1739   ,input p-total3    as decimal
     1740   ) :
     1741   define variable v-row-amount as character no-undo .
     1742   define variable v-curr-name  as character no-undo .
     1743     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1744     v-row-amount = substitute (
     1745         '<td>&1</td><td num="0.00" val="&2">&2</td><td num="0.00" val="&3">&3</td><td num="0.00" val="&4">&4</td>'
     1746         , v-curr-name
     1747         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1748         , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1749         , fnc-convert-dot-to-colon(p-total3, "->>>>>>>>>>>9.99", 2)
     1750     ) .
     1751     return v-row-amount .
     1752   end function .
     1753   function putRowDayTotal1 returns character private
     1754   (input p-numchk-fisc as integer
     1755   ,input p-total1    as decimal
     1756   ) :
     1757   define variable v-day-amount as character no-undo .
     1758     v-day-amount = substitute (
     1759       '<td colspan="3">средн.чек: &1</td><td num="0.00" val="&2" class="sumtotal">&2</td><td><br /></td><td><br /></td>'
     1760       , ROUND(p-total1 / p-numchk-fisc, 2)
     1761       , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1762     ) .
     1763     return v-day-amount .
     1764   end function .
     1765   function putRowDayTotal returns character private
     1766   (input p-numchk-fisc as integer
     1767   ,input p-total1    as decimal
     1768   ,input p-total2    as decimal
     1769   ) :
     1770   define variable v-day-amount as character no-undo .
     1771     v-day-amount = substitute (
     1772       '<td colspan="3">средн.чек: &1</td><td num="0.00" val="&2" class="sumtotal">&2</td><td><br /></td><td num="0.00" val="&3" class="sumtotal">&3</td>'
     1773       , ROUND(p-total1 / p-numchk-fisc, 2)
     1774       , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1775       , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1776     ) .
     1777     return v-day-amount .
     1778   end function .
     1779   define VARIABLE v-report-id         as integer   no-undo .
     1780   define variable v-report-name       as character no-undo .
     1781   define variable v-file-name-rep-htm as character no-undo .
     1782   define stream OutStr-html.
     1783   define variable v-vsex-cas  as character no-undo.
     1784   define variable v-avg-chk   as decimal decimals  2 no-undo .
     1785   define variable v-times     as character no-undo.
     1786   define variable v-td-date   as character no-undo.
     1787   define variable v-pcnt      as decimal decimals  2 no-undo .
     1788   define variable v-accum     as decimal no-undo .
     1789   define variable v-accum-b   as decimal no-undo .
     1790   define variable v-accum-r   as decimal no-undo .
     1791   define variable v-accum-t   as decimal no-undo .
     1792   define variable v-accum-s   as decimal no-undo .
     1793   define variable v-chk-count as integer no-undo .
     1794   define variable v-err-message as character no-undo .
     1795   define query qben-chk-count for ben-chk-count .
     1796   empty temp-table benefits .
     1797   empty temp-table inkas-num .
     1798   empty temp-table day_sum .
     1799   empty temp-table all-days_sum .
     1800   empty temp-table ben-chk-count .
     1801   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1803     (output v-curr-r-b
     1804     )  .
     1805   if v-curr-r-b = 'base':U then do:
     1806       sale-price-type = base-type.
     1807   end.
     1808   else sale-price-type = "рублей".
     1809   run no-benqi(output NotInc).
     1810     run rep/r-beneq1.p (
     1811                    input parparentproc
     1812                   ,input cas-num
     1813                   ,input no
     1814                   ,input v-curr-r-b
     1815                   ,output allday-basesum
     1816                   ,output allday-Rublsum
     1817                   ,output ObjAmount
     1818                   ,output ChkAmount
     1819                   ) no-error.
     1820     if error-status:error then do :
     1821       v-err-message = substitute("Ошибка формирования отчёта&1&2&1&3&1всего ошибок &4",
     1822                                  chr(10), return-value, error-status:get-message(1), error-status:num-messages) .
     1823       message v-err-message view-as alert-box.
     1824       return error return-value.
     1825     end .
     1826   if not can-find (first benefits) then do:
     1827     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1828     return.
     1829   end.
     1830   if x-date-start = x-date-end
     1831   then choice = TRUE .
     1832   else choice = HowBreak .
     1833       run prn-lib-get-report-name  in this-procedure (
     1834                                                          input parParentProc
     1835                                                         ,output v-report-name
     1836                                                       ).
     1837     assign
     1838       v-file-name-rep-htm = v-report-name + ".html"
     1839       date_string = cur-time-print()
     1840       v-vsex-cas = IF cas-num = 0 then "ВСЕХ КАСС" ELSE ("КАССЫ " + string(cas-num))
     1841       v-avg-chk  = if ChkAmount > 0 then round(
     1842    AllDay-BaseSum / ChkAmount
     1843                          , 2 ) else 0
     1844     .
     1845   do :
     1846     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1847     put stream OutStr-html unformatted
     1848       "<!DOCTYPE HTML>" skip
     1849       '<html>' skip
     1850       '<head>' skip
     1851       '  <meta charset="utf-8">' skip
     1852       '  <style type="text/css">' skip
     1853       '      table ~{border-collapse: collapse~;~}' skip
     1854       '      tbody td, th ~{border: 1px solid black~; height: 14px~;}' skip
     1855       '      tbody td:nth-child(4), tbody td:nth-child(5), tbody td:nth-child(6) ~{text-align: right~; padding-right: 4px~;~}' skip
     1856       '      tfoot td ~{height: 14px~;}' skip
     1857       '      .sumtotal ~{text-align: right~; padding-right: 4px~;~}' skip
     1858       '  </style>' skip
     1859       '</head>' skip
     1860       '<body>' skip
     1861       '<TABLE name="1" fit_to_page="true" orientation="portrait">' skip
     1862       '<thead>' skip
     1863       '  <tr class="set_columns">' skip
     1864       '    <td style="width:  53px;"></td>' skip
     1865       '    <td style="width: 124px;"></td>' skip
     1866       '    <td style="width: 31px;"></td>' skip
     1867       '    <td style="width: 71px;"></td>' skip
     1868       '    <td style="width: 63px;"></td>' skip
     1869       '    <td style="width: 63px;"></td>' skip
     1870       '    <td style="width: 49px;"></td>' skip
     1871       '    <td style="width: 41px;"></td>' skip
     1872       '  </tr>' skip
     1873       '  <tr>' skip
     1874       '    <td colspan="8">' + date_string + '</td>' skip
     1875       '  </tr>' skip
     1876       '  <tr>' skip
     1877       '    <td colspan="8">ОТЧЕТ  О  ВЫРУЧКЕ  ' + str1
     1878            + '<br />' + str4
     1879            + '<br />( сформирован по ВСЕМ ЧЕКАМ '
     1880            + (IF NotInc then v-vsex-cas + ", включая невошедшие в отчеты о продажах" else v-vsex-cas )
     1881            + ' )'
     1882            + '<br />'
     1883            + substitute("( всего чеков : &1, в среднем &2 &3 / чек )",  ChkAmount,  v-avg-chk,  sale-price-type  )
     1884            + '</td>' skip
     1885       '  </tr>' skip
     1886     .
     1887     put stream OutStr-html unformatted
     1888       '</thead>' skip
     1889       '<tbody>' skip
     1890       '  <tr>' skip
     1891       '    <th>Дата</th>' skip
     1892       '    <th>Вид оплаты</th>' skip
     1893       '    <th>Валюта продаж</th>' skip
     1894       '    <th>Сумма в валюте продаж</th>' skip
     1895       '    <th>Сумма в Б.Вал.</th>' skip
     1896       '    <th>Сумма в рублях</th>' skip
     1897       '    <th>~% от суммы</th>' skip
     1898       '    <th>Кол-во фиск. чеков</th>' skip
     1899       '  </tr>' skip
     1900     .
     1901   end .
     1902   FOR EACH obj-list WHERE
     1903             obj-list.obj-type = 'маг':U ,
     1904       EACH all-days_sum WHERE
     1905             all-days_sum.obj-type = obj-list.obj-type AND
     1906             all-days_sum.obj-code = obj-list.obj-code
     1907   BREAK
     1908   BY obj-list.obj-type
     1909   BY obj-list.obj-code :
     1910     ACCUMULATE
     1911     all-days_sum.tot-base ( TOTAL )
     1912     all-days_sum.tot-rubl ( TOTAL )
     1913     all-days_sum.tot-r-b  ( TOTAL )
     1914     all-days_sum.chk-cnt-all ( TOTAL )
     1915     all-days_sum.chk-cnt-nf  ( TOTAL )
     1916     obj-list.obj-code ( COUNT ) .
     1917       run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1918                                     ", компоновка отчёта " ) .
     1919       FIND FIRST clients no-lock
     1920            WHERE clients.obj-type = obj-list.obj-type
     1921              AND clients.obj-code = obj-list.obj-code no-error .
     1922       put stream OutStr-html unformatted
     1923         '  <tr><td colspan="8">'
     1924         if available clients then clients.obj-name else '<br />'
     1925         '</td></tr>' skip
     1926       .
     1927     if choice then do:
     1928       FOR EACH benefits WHERE
     1929                 benefits.obj-type = obj-list.obj-type AND
     1930                 benefits.obj-code = obj-list.obj-code
     1931       BREAK
     1932       BY benefits.obj-type
     1933       BY benefits.obj-code
     1934       BY benefits.date_
     1935       BY benefits.pay-code
     1936       BY benefits.curr-code :
     1937         if first-of( benefits.date_ ) then do:
     1938           FIND FIRST day_sum WHERE
     1939                     day_sum.obj-type = obj-list.obj-type AND
     1940                     day_sum.obj-code = obj-list.obj-code AND
     1941                     day_sum.date_ = benefits.date_   NO-ERROR.
     1942           DatePrinted = FALSE .
     1943         end.
     1944         benefits.pcnt = round( benefits.tot-rubl / day_sum.tot-rubl * 100 , 2 ) .
     1945         if benefits.tot-base <> 0 or day_sum.chk-cnt-all > 0 or day_sum.chk-cnt-nf > 0
     1946         then do:
     1947           if DatePrinted then assign
     1948             v-td-date = '<br />'
     1949           .
     1950           else assign
     1951             v-td-date   = string(benefits.date_)
     1952             DatePrinted = TRUE
     1953           .
     1954           open query qben-chk-count
     1955            preselect each ben-chk-count
     1956                     where ben-chk-count.date_     = benefits.date_
     1957                       and ben-chk-count.pay-code  = benefits.pay-code
     1958                       and ben-chk-count.obj-code  = obj-list.obj-code
     1959                       and ben-chk-count.obj-type  = obj-list.obj-type
     1960                       and ben-chk-count.curr-code = benefits.curr-code.
     1961           v-chk-count = query qben-chk-count:num-results .
     1962           close query qben-chk-count.
     1963           put stream OutStr-html unformatted
     1964             '  <tr>'
     1965                 '<td>' + v-td-date + '</td>'
     1966                 '<td>' + benefits.pay-name + '</td>'
     1967                 putRowAmount (benefits.curr-name, benefits.tot-sum, benefits.tot-base, benefits.tot-rubl)
     1968             substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(benefits.pcnt,    "->>9.99",2)  )
     1969             substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     1970             '</tr>' skip
     1971           .
     1972         end.
     1973         if last-of( benefits.date_ ) then  do:
     1974           if day_sum.chk-cnt-all > day_sum.chk-cnt-nf then do:
     1975             put stream OutStr-html unformatted
     1976               '  <tr>'
     1977               putRowDayTotal  ( day_sum.chk-cnt-all - day_sum.chk-cnt-nf, day_sum.tot-base, day_sum.tot-rubl )
     1978               '<td>100.00%</td>'
     1979               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  day_sum.chk-cnt-all - day_sum.chk-cnt-nf  )
     1980               '</tr>' skip
     1981             .
     1982           end.
     1983         end.
     1984         if last-of (benefits.obj-code) then do:
     1985           put stream OutStr-html unformatted
     1986               '<tr><td colspan="3">ИТОГО:</td>'
     1987               substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-base,"->>>>>>>>>>>9.99",2)  )
     1988               '<td></td>'
     1989               substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     1990               '<td>100.00%</td>'
     1991               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     1992               '</tr>' skip
     1993           .
     1994         end.
     1995       END.
     1996     end.
     1997     else do:
     1998       FOR EACH benefits WHERE
     1999                benefits.obj-type = obj-list.obj-type AND
     2000                benefits.obj-code = obj-list.obj-code
     2001       BREAK
     2002       BY benefits.obj-type
     2003       BY benefits.obj-code
     2004       BY benefits.pay-code
     2005       BY benefits.curr-code :
     2006         ACCUMULATE
     2007           benefits.tot-base ( TOTAL )
     2008           benefits.tot-rubl ( TOTAL )
     2009           benefits.tot-r-b ( TOTAL )
     2010           benefits.tot-sum ( SUB-TOTAL BY benefits.curr-code )
     2011           benefits.tot-base ( SUB-TOTAL BY benefits.curr-code )
     2012           benefits.tot-rubl ( SUB-TOTAL BY benefits.curr-code )
     2013           benefits.tot-r-b ( SUB-TOTAL BY benefits.curr-code )
     2014         .
     2015         if first-of( benefits.curr-code ) then do:
     2016           v-accum-b = 0 .
     2017           v-accum-t = 0 .
     2018           define buffer buf_benefits for benefits .
     2019           for each buf_benefits where buf_benefits.obj-type  = benefits.obj-type
     2020                                   and buf_benefits.obj-code  = benefits.obj-code
     2021                                   and buf_benefits.pay-code  = benefits.pay-code
     2022                                   and buf_benefits.curr-code = benefits.curr-code :
     2023             v-accum-b = v-accum-b + buf_benefits.tot-base .
     2024             v-accum-t = v-accum-t + buf_benefits.tot-r-b .
     2025           end .
     2026         end.
     2027         if last-of( benefits.curr-code ) then do:
     2028           define variable v-if-accum as decimal no-undo .
     2029             v-if-accum = v-accum-b .
     2030           if v-if-accum <> 0 then do :
     2031           open query qben-chk-count
     2032            preselect each ben-chk-count
     2033                     where ben-chk-count.obj-type  = obj-list.obj-type
     2034                       and ben-chk-count.obj-code  = obj-list.obj-code
     2035                       and ben-chk-count.pay-code  = benefits.pay-code
     2036                       and ben-chk-count.curr-code = benefits.curr-code.
     2037           v-chk-count = query qben-chk-count:num-results .
     2038           close query qben-chk-count.
     2039           put stream OutStr-html unformatted
     2040             '  <tr>'
     2041                 '<td></td>'
     2042                 '<td>' + benefits.pay-name + '</td>'
     2043           .
     2044             v-accum-s = ACCUM SUB-TOTAL BY benefits.curr-code benefits.tot-sum .
     2045             v-accum-r = ACCUM SUB-TOTAL BY benefits.curr-code benefits.tot-rubl .
     2046             v-pcnt = round(  v-accum-b  /  all-days_sum.tot-base  *  100  ,  2  ) .
     2047           put stream OutStr-html unformatted
     2048             putRowAmount (benefits.curr-name, v-accum-s, v-accum-b, v-accum-r)
     2049           .
     2050             put stream OutStr-html unformatted
     2051               substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(v-pcnt,"->>9.99",2)  )
     2052               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2053               '</tr>' skip
     2054             .
     2055           end.
     2056         end.
     2057         if last-of (benefits.obj-code) then do:
     2058           put stream OutStr-html unformatted
     2059               '  <tr><td colspan="3">ИТОГО:</td>'
     2060               substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL benefits.tot-base,"->>>>>>>>>>>9.99",2)  )
     2061               '<td></td>'
     2062               substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL benefits.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2063               '<td>100.00%</td>'
     2064               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     2065               '</tr>' skip
     2066           .
     2067         end.
     2068       END.
     2069     end.
     2070     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then  do:
     2071       put stream OutStr-html unformatted
     2072         '<tr><td colspan="3">ИТОГО по всем</td>' +
     2073         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-base,"->>>>>>>>>>>9.99",2)  )
     2074         '<td></td>'
     2075         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2076         '<td></td>'
     2077         substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',
     2078           (ACCUM TOTAL all-days_sum.chk-cnt-all) - (ACCUM TOTAL all-days_sum.chk-cnt-nf)  )
     2079         '</tr>' skip
     2080       .
     2081     end.
     2082   END.
     2083   if choice AND ( ObjAmount > 1 ) then do:
     2084     FOR EACH benefits
     2085     BREAK
     2086     BY benefits.pay-code :
     2087       ACCUMULATE
     2088       benefits.tot-base ( SUB-TOTAL BY benefits.pay-code )
     2089       benefits.tot-rubl ( SUB-TOTAL BY benefits.pay-code )
     2090       benefits.tot-r-b  ( SUB-TOTAL BY benefits.pay-code )
     2091       .
     2092       if last-of( benefits.pay-code ) AND
     2093           ( ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base ) <> 0 then do:
     2094         open query qben-chk-count
     2095          preselect each ben-chk-count
     2096                   where ben-chk-count.pay-code  = benefits.pay-code.
     2097         v-chk-count = query qben-chk-count:num-results .
     2098         close query qben-chk-count.
     2099         put stream OutStr-html unformatted
     2100           substitute(  '  <tr><td colspan="3">/итого по &1</td>',  benefits.pay-name  )
     2101           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base,"->>>>>>>>>>>9.99",2)  )
     2102           '<td></td>'
     2103           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2104           '<td></td>'
     2105           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2106           '</tr>' skip
     2107         .
     2108       end.
     2109     END.
     2110   end.
     2111   put stream OutStr-html unformatted
     2112     '</tbody>' skip
     2113     '<tfoot>' skip
     2114   .
     2115   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2116     put stream OutStr-html unformatted
     2117       '  <tr><td colspan="8"><br /></td></tr>' skip
     2118       '  <tr><td colspan="4">Директор _______________</td><td colspan="4">Старший продавец ______________</td></tr>' skip
     2119       '  <tr><td colspan="8"><br /></td></tr>' skip
     2120       '  <tr><td colspan="4">Бухгалтер ______________</td><td colspan="4">Кассир ________________________</td></tr>' skip
     2121     .
     2122   end.
     2123   put stream OutStr-html unformatted
     2124     '</tfoot>' skip
     2125     '</table>' skip
     2126     '</body>' skip
     2127     '</html>' skip
     2128   .
     2129   output stream OutStr-html close.
     2130   run prn-lib-reportviewer in this-procedure (
     2131       input this-procedure
     2132       ,input v-file-name-rep-htm
     2133       ,input ""
     2134       ) no-error.
     2135   if error-status:error then
     2136   do:
     2137       message return-value view-as alert-box.
     2138       return .
     2139   end.
