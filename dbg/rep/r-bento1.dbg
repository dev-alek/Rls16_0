     1465                           "Страница " AT 115 PAGE-NUMBER( PrnLibStream ) AT 125 FORMAT ">>9" SKIP
     1466                       Line format "X(136)" AT 1
     1467       with width 160 down stream-io use-text .
     1468   DEFINE FRAME ZUM-PayCodes-Tot
     1469           sym1 column-label ":!:" format "X(1)"
     1470           benefits.pay-name column-label "Вид !оплаты" format "X(30)"
     1471           sym3 column-label ":!:" format "X(1)"
     1472           benefits.curr-name column-label "Валюта ! " format "X(19)"
     1473           sym4 column-label ":!:" format "X(1)"
     1474           benefits.tot-sum column-label "Сумма!в валюте" format "->>>>,>>>,>>>,>>9.99"
     1475           sym5 column-label ":!:" format "X(1)"
