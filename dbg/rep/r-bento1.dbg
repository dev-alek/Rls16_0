     1409            AND  buf_sale-doc.status_ = 'факт':U
     1410            AND  buf_sale-doc.chr-office = 'у':U
     1411            AND  buf_sale-doc.doc-date >= X-date-start
     1412            AND  buf_sale-doc.doc-date <= X-date-end :
     1413           found = yes.
