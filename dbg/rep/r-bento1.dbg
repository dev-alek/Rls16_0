     1396           IF X-Radio-Task = 4 AND
     1397           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1398           found = yes.
     1399           return.
     1400         END.
     1401       END.
     1402     END.
     1403     WHEN NO THEN DO:
     1404       FOR EACH obj-list WHERE
     1405               obj-list.obj-type = 'маг':U NO-LOCK :
