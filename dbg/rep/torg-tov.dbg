     1108     varprice-base-cons = 0
     1109     varprice-rubl-cons = 0.
     1110   find first out-vatp_doc-line where
     1111              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     1112          and out-vatp_doc-line.artic      = buf_doc-line.artic
     1113          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     1114          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     1115   if available out-vatp_doc-line           and
     1116     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
