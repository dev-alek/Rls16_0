     1540      else do:
     1541        assign
     1542          in-vatp-have-vat-slt = yes.
     1543      end.
     1544      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1545                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1546                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1547      if (not buf_trn-doc.internal and
     1548              buf_trn-doc.doc-type = 'при':U) or
     1549         in-vatp-goods.gds-type = 'у':U then do:
     1550         if varinvprb = "base":u then do:
     1551           assign
     1552             road-tax-base-loc = buf_doc-line.road-tax
     1553             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1554         end.
     1555         else do:
     1556           ASSIGN
     1557             road-tax-rubl-loc = buf_doc-line.road-tax
     1558             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1559         end.
     1560         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1561         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1562         assign
     1563           road-tax-cli-loc = ?.
     1564         ASSIGN
     1565           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1566           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
