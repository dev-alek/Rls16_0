      373   procedure r-cost :
      374     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      375     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      376     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      377     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      378     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      379     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      380     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      381     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      382     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      383     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      384     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      385     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      386     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      387     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      388     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      389     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      390     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      391     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      392     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      393     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      394     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      395     do
      396     on error undo, return error
      397     :
      398       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      399       define buffer   in-vatp-parts    for ub.parts   .
      400       define buffer   in-vatp-doc      for ub.trn-doc .
      401       define buffer   in-vatp-goods    for ub.goods   .
      402       define buffer   in-vatp-sysconf  for ub.sysconf .
      403       define buffer   in-vatp_doc-attr for ub.doc-attr.
      404       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      405       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      406       define variable varinvprb                  as   character              no-undo.
      407       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      408       define variable cli-base-rate              as   decimal                no-undo.
      409       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      410       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      411       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      412       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      413       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      414       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      415       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      416       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      417       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      418       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      419       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      420       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      421       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      422       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      423       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      424       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      425       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      426       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      427       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      428       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      429       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      430       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      431       define variable varinvatp-envd             as   character              no-undo.
      432       define variable varinvatp-type             as   character              no-undo.
      433       def var v-parts-fact-qnty as decimal   no-undo .
      434       define buffer buf_parts    for ub.parts    .
      435       define buffer buf_goods    for ub.goods    .
      436       define buffer buf_trn-doc  for ub.trn-doc  .
      437       define buffer buf_doc-line for ub.doc-line .
      438       find first buf_doc-line no-lock
      439         where buf_doc-line.doc-code  = v-doc-code
      440           and buf_doc-line.artic     = v-artic
      441           and buf_doc-line.prod-type = v-prod-type
      442           and buf_doc-line.prod-code = v-prod-code
      443         no-error .
      444       if not available buf_doc-line then do:
      445         message
      446           vss-workfile vss-revision vss-description skip
      447           vss-include-info4 skip
      448           "Ошибка задания входных параметров" skip
      449           "Не найдена строка документа"  skip
      450           "Документ" v-doc-code skip
      451           "Артикул" v-artic v-prod-type v-prod-code skip
      452           view-as alert-box error .
      453         return error .
      454       end.
      455       find first buf_trn-doc no-lock
      456         where buf_trn-doc.doc-code = v-doc-code
      457         no-error .
      458       if not available buf_trn-doc then do:
      459         message
      460           vss-workfile vss-revision vss-description skip
      461           vss-include-info4 skip
      462           "Ошибка задания входных параметров" skip
      463           "Не найден документ" skip
      464           "Документ" v-doc-code skip
      465           "Артикул" v-artic v-prod-type v-prod-code skip
      466           view-as alert-box error .
      467         undo, return error .
      468       end.
      469       find first buf_goods no-lock
      470         where buf_goods.artic     = buf_doc-line.artic
      471           and buf_goods.prod-type = buf_doc-line.prod-type
      472           and buf_goods.prod-code = buf_doc-line.prod-code
      473         no-error .
      474       if not available buf_goods then do:
      475         message
      476           vss-workfile vss-revision vss-description skip
      477           vss-include-info4 skip
      478           "Ошибка задания входных параметров" skip
      479           "Не найден товар" skip
      480           "Документ" v-doc-code skip
      481           "Артикул" v-artic v-prod-type v-prod-code skip
      482           view-as alert-box error .
      483         undo, return error .
      484       end.
      485       if buf_goods.gds-type = 'т':U then do:
      486             for each buf_parts no-lock
      487               where buf_parts.out-code  = buf_trn-doc.doc-code
      488                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      489                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      490                 and buf_parts.artic     = buf_doc-line.artic
      491                 and buf_parts.prod-type = buf_doc-line.prod-type
      492                 and buf_parts.prod-code = buf_doc-line.prod-code
      493             on error undo, return error
      494             :
      495   assign
      496     price-rubl-with-tax-loc = buf_parts.price-rubl
      497     price-base-with-tax-loc = buf_parts.price-base
      498   .
      499   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      500   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      501     (output varinvprb
      502     )  .
      503     if buf_parts.out-code = 'free-zone':U     or
      504        buf_parts.out-code = 'out-zone':U   or
      505        buf_parts.doc-type = 'акт':U then do:
      506       assign
      507         in-vatp-have-vat-slt = yes.
      508     end.
      509     else do:
      510       find first in-vatp_doc-attr no-lock
      511         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      512           and in-vatp_doc-attr.attr-code = 'envd':U
      513         no-error .
      514       if not available in-vatp_doc-attr then do:
      515         assign
      516           in-vatp-have-vat-slt = yes.
      517       end.
      518       else do:
      519            in-vatp-have-vat-slt = no.
      520       end.
      521     end.
      522     assign
      523      price-cli-with-tax-loc = buf_parts.price-cli
      524      cli-base-rate          = buf_parts.cli-base-rate.
      525     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      526              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      527     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      528             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      529             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      530             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      531             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      532             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      533             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      534       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      535     assign
      536       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      537     assign
      538       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      539       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      540       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      541       transport-cli-loc  = 0
      542       other-cli-loc      = 0
      543     .
      544   ASSIGN
      545             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      546       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      547   .
      548               assign
      549                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
      550                                       or buf_trn-doc.doc-type = 'возврат':U
      551                                       or buf_trn-doc.doc-type = 'инв':U
      552                                       then buf_parts.fact-qnty
      553                                       else - buf_parts.fact-qnty
      554                                      )
      555               .
      556               assign
      557                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
      558                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
      559                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
      560                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
      561                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
      562                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
      563                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
      564                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
      565                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
      566                 v-excise-base         =   0
      567                 v-excise-rubl         =   0
      568                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
      569                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
      570                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
      571                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
      572               .
      573           end.
      574   assign
      575     price-rubl-with-tax-loc = buf_doc-line.price-rubl
      576     price-base-with-tax-loc = buf_doc-line.price-base
      577   .
      578   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      579   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      580     (output varinvprb
      581     )  .
      582      find first in-vatp_doc-attr no-lock
      583       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      584         and in-vatp_doc-attr.attr-code = 'envd':U
      585       no-error .
      586       if available in-vatp_doc-attr
      587          then do:
      588          assign
