      817               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
      818               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
      819               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
      820               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
      821               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
      822               v-road-tax-base       =  0
      823               v-road-tax-rubl       =  0
      824               v-excise-base         =  0
      825               v-excise-rubl         =  0
      826               v-transport-base      =  0
      827               v-transport-rubl      =  0
      828               v-other-base          =  0
      829               v-other-rubl          =  0
      830             .
      831       end.
      832     end.
      833   end procedure.
