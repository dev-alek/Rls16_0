     1119   end.
     1120   else do:
     1121     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     1122                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     1123                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     1124                                  and out-vatp_parts.artic      = buf_doc-line.artic
     1125                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     1126                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     1127       if out-vatp_parts.purch-code = 2 then do:
     1128   assign
     1129     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1130     price-base-with-tax-loco = out-vatp_parts.price-base
     1131   .
     1132   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1134     (output varinvprbo
     1135     )  .
     1136     if out-vatp_parts.out-code = 'free-zone':U     or
     1137        out-vatp_parts.out-code = 'out-zone':U   or
     1138        out-vatp_parts.doc-type = 'акт':U then do:
     1139       assign
     1140         in-vatp-have-vat-slto = yes.
     1141     end.
     1142     else do:
     1143       find first in-vatp_doc-attro no-lock
     1144         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1145           and in-vatp_doc-attro.attr-code = 'envd':U
     1146         no-error .
     1147       if not available in-vatp_doc-attro then do:
     1148         assign
     1149           in-vatp-have-vat-slto = yes.
     1150       end.
     1151       else do:
     1152            in-vatp-have-vat-slto = no.
     1153       end.
     1154     end.
     1155     assign
     1156      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1157      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1158     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1159              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1160     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1161             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1162             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1163             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1164             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1165             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1166             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1167       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1168     assign
     1169       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1170     assign
     1171       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1172       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1173       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1174       transport-cli-loco  = 0
     1175       other-cli-loco      = 0
     1176     .
     1177   ASSIGN
     1178             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1179       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1180   .
     1181         assign
     1182           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     1183           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     1184         assign
     1185           varis-cons-parts-have = yes
     1186           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     1187       end.
     1188       assign
     1189         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     1190     end.
     1191   end.
     1192   assign
     1193     varprice-base-cons = varprice-base-cons / varcons-qnty
     1194     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     1195   if varprice-base-cons = ? then do:
     1196     assign
     1197       varprice-base-cons = 0.
     1198   end.
     1199   if varprice-rubl-cons = ? then do:
     1200     assign
     1201       varprice-rubl-cons = 0.
     1202   end.
     1203   assign
     1204       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1205     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1206     discnt-base-sale            = buf_gds-dtl.discnt-base
     1207     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1208       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1209     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1210     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     1211     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1212     .
     1213   if buf_trn-doc.doc-type = 'инв':U then do:
     1214     assign
     1215       varfact-qnty = buf_gds-dtl.doc-qnty.
     1216   end.
     1217   else do:
     1218     assign
     1219       varfact-qnty = buf_gds-dtl.fact-qnty.
     1220   end.
     1221   if varis-cons-parts-have = no then do:
     1222     assign
     1223           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1224           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     1225   end.
     1226   else do:
     1227     if buf_trn-doc.doc-type = 'инв':U then do:
     1228       assign
     1229               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1230               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1231        .
     1232     end.
     1233     else do:
     1234       assign
     1235               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1236               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1237        .
     1238     end.
     1239   end.
     1240   assign
     1241   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1242   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1243               ASSIGN
     1244                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1245                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1246                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1247                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1248                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1249                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1250                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1251                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1252                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1253                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1254                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1255                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1256                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1257               .
     1258           end.
     1259       end.
     1260       assign
     1261           p-transport-base      = 0
     1262           p-transport-rubl      = 0
     1263           p-vat-pc              = buf_doc-line.vat-pc
     1264           p-slt-pc              = buf_doc-line.slt-pc
     1265       .
     1266     end.
     1267     if p-fact-qnty      = ?
     1268     or p-vat-pc         = ?
     1269     or p-slt-pc         = ?
     1270     or p-sum-base       = ?
     1271     or p-sum-rubl       = ?
     1272     or p-vat-base       = ?
     1273     or p-vat-rubl       = ?
     1274     or p-slt-base       = ?
     1275     or p-slt-rubl       = ?
     1276     or p-road-tax-base  = ?
     1277     or p-road-tax-rubl  = ?
     1278     or p-transport-base = ?
     1279     or p-transport-rubl = ?
     1280     or p-other-base     = ?
     1281     or p-other-rubl     = ?
     1282     or p-excise-base    = ?
     1283     or p-excise-rubl    = ?
     1284     then do:
     1285       message
     1286         vss-workfile vss-revision vss-description skip
     1287         vss-include-info9 skip
     1288         "Получены неопределенные значения" skip
     1289         "Документ" p-doc-code skip
     1290         "Артикул" p-artic p-prod-type p-prod-code skip
     1291         "fact-qnty     " p-fact-qnty      skip
     1292         "vat-pc        " p-vat-pc         skip
     1293         "slt-pc        " p-slt-pc         skip
     1294         "sum-base      " p-sum-base       skip
     1295         "sum-rubl      " p-sum-rubl       skip
     1296         "vat-base      " p-vat-base       skip
     1297         "vat-rubl      " p-vat-rubl       skip
     1298         "slt-base      " p-slt-base       skip
     1299         "slt-rubl      " p-slt-rubl       skip
     1300         "road-tax-base " p-road-tax-base  skip
     1301         "road-tax-rubl " p-road-tax-rubl  skip
     1302         "transport-base" p-transport-base skip
     1303         "transport-rubl" p-transport-rubl skip
     1304         "other-base    " p-other-base     skip
     1305         "other-rubl    " p-other-rubl     skip
     1306         "excise-base   " p-excise-base    skip
     1307         "excise-rubl   " p-excise-rubl    skip
     1308         view-as alert-box error .
     1309       undo, return error .
     1310     end.
     1311   end procedure.
     1312   procedure r-getsum :
     1313   do
     1314   on error undo, return error
     1315   :
     1316   def input parameter p-doc-line-recid    as recid    no-undo.
     1317   def input parameter p-cost-prices       as logical  no-undo.
     1318   def input parameter p-rubl-prices       as logical  no-undo.
     1319       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1320       define buffer   in-vatp-parts    for ub.parts   .
     1321       define buffer   in-vatp-doc      for ub.trn-doc .
     1322       define buffer   in-vatp-goods    for ub.goods   .
     1323       define buffer   in-vatp-sysconf  for ub.sysconf .
     1324       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1325       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1326       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1327       define variable varinvprb                  as   character              no-undo.
     1328       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1329       define variable cli-base-rate              as   decimal                no-undo.
     1330       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1331       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1332       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1333       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1334       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1335       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1336       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1337       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1338       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1339       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1340       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1341       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1342       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1343       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1344       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1345       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1346       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1347       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1348       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1349       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1350       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1351       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1352       define variable varinvatp-envd             as   character              no-undo.
     1353       define variable varinvatp-type             as   character              no-undo.
     1354       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     1355       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     1356       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     1357       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     1358       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     1359       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     1360       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     1361       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
     1362       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
     1363       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
     1364       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
     1365       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
     1366       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
     1367       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
     1368       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
     1369       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
     1370       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
     1371       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
     1372       define buffer out-vatp_parts       for ub.parts.
     1373       define buffer out-vatp_sysconf     for ub.sysconf.
     1374       define buffer out-vatp_doc-line    for ub.doc-line.
     1375       define buffer out-vatp_goods       for ub.goods.
