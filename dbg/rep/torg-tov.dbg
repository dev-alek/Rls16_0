     2123   do
     2124   on error undo, return error
     2125   :
     2126   def shared var CostPrice    as logical          no-undo.
     2127   def shared var PrintScale   as logical              no-undo.
     2128   def shared var sort-name    as logical              no-undo.
     2129   def shared var sort-gr      as logical              no-undo.
     2130   def stream out-stream .
     2131   def buffer buf_trn-doc          for trn-doc.
     2132   def buffer buf_goods            for goods.
     2133   def buffer buf_clients          for clients.
     2134   def buffer buf_doc-line         for doc-line.
     2135   def buffer buf_gds-dtl          for gds-dtl.
     2136   def buffer buf_gds-prt          for gds-prt.
     2137   define variable v-line-counter      as integer                  no-undo.
     2138   define variable v-single-line       as character                no-undo.
     2139   define variable v-cli-name          as character                no-undo.
     2140   define variable v-obj-name          as character                no-undo.
     2141   define variable v-income            as logical                  no-undo.
     2142   define variable v-prt-name          as character                no-undo.
     2143   define variable v-pg-sum-qnty       like doc-line.fact-qnty     no-undo.
     2144   define variable v-tot-sum-qnty      like doc-line.fact-qnty     no-undo.
     2145   define variable v-host-code         like sysconf.host-code      no-undo.
     2146   define variable g#report-num    as integer      no-undo.
     2147   define variable g#quest-print   as logical      no-undo.
     2148   define variable g#log           as logical      no-undo.
     2149   run get-report-num in p-mainmenu-handle (
     2150       output g#report-num
     2151   ).
     2152   run get-quest-print in p-mainmenu-handle (
     2153       output g#quest-print
     2154   ).
     2155   find first buf_trn-doc no-lock where recid(buf_trn-doc) = p-trn-doc-recid.
     2156   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2157   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2158     (input  buf_trn-doc.obj-type
     2159     ,input  buf_trn-doc.obj-code
     2160     ,output v-host-code
     2161     )  .
     2162   find first buf_clients no-lock
     2163        where buf_clients.obj-type = buf_trn-doc.obj-type
     2164          and buf_clients.obj-code = buf_trn-doc.obj-code
     2165   .
     2166   assign
     2167           v-obj-name = string(buf_clients.obj-name)
     2168   .
     2169   find first buf_clients no-lock
     2170        where buf_clients.obj-type = buf_trn-doc.cli-type
     2171          and buf_clients.obj-code = buf_trn-doc.cli-code
     2172   .
     2173   if available buf_clients
     2174   then do:
     2175       assign
     2176           v-cli-name = string(buf_clients.obj-name)
     2177       .
     2178   end.
     2179   else do:
     2180       assign
     2181           v-cli-name = ""
     2182       .
     2183   end.
     2184   assign
     2185       v-income = ( if buf_trn-doc.doc-type = 'при':U or buf_trn-doc.doc-type = 'возврат':U then yes else no )
     2186       v-single-line       = fill("-", 230)
     2187       v-line-counter      = 0
     2188   .
     2189   output stream out-stream to value( string( session:temp-directory +
     2190                                        "rpt" + string( g#report-num ) ) )
     2191                                        page-size  value(62) .
     2192   form header
     2193       v-single-line format "X(130)" at 1 SKIP
     2194       "Продолжение - на следующей странице" at 30 SKIP
     2195       with frame BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     2196   view stream out-stream frame BottomFrame .
     2197   find first buf_clients no-lock
     2198        where buf_clients.obj-type = 'орг':U
     2199          and buf_clients.obj-code = v-host-code
     2200   .
     2201   if session :set-wait-state( "compiler" ) then.
     2202   put stream out-stream
     2203       skip (1) space( 34 )
     2204       "Товарная накладная к документу. Тип: "
     2205   .
     2206   put stream out-stream
     2207          buf_trn-doc.doc-type                                     format "X(20)"
     2208          "   Номер: "
     2209          buf_trn-doc.doc-code                                     format "X(14)"
     2210          "   Дата: "
     2211          string(buf_trn-doc.doc-date)                             format "X(10)"
     2212          ( if buf_trn-doc.status_ <> 'факт':U then "   Статус: " + caps(buf_trn-doc.status_) else " " )
     2213                                                                   format "X(25)"
     2214       skip space( 34 ) "Поставщик (отправитель): "
     2215           (if v-income = yes then v-cli-name else v-obj-name )    format "X(60)"
     2216       skip space( 34 ) "Покупатель (получатель): "
     2217           (if v-income = yes then v-obj-name else v-cli-name )    format "X(60)"
     2218   .
     2219   if buf_trn-doc.PS <> ?
     2220   and trim( buf_trn-doc.PS ) <> ""
     2221   and substring( buf_trn-doc.PS, 1, 1 ) <> "@"
     2222   then do:
     2223       put stream out-stream
     2224           skip space( 34 ) string( "Примечание:              "
     2225               + substring( buf_trn-doc.PS, 1, 101 - 25 ) )  format "X(101)"
     2226           skip space( 34 )
     2227               substring( buf_trn-doc.PS, 101 - 25 + 1, 101 ) format "X(101)"
     2228           skip space( 34 )
     2229               substring( buf_trn-doc.PS, 101 - 25 + 101 + 1, 101 ) format "X(101)"
     2230       .
     2231   end.
     2232   put stream out-stream
     2233       skip
     2234       space(5)       v-single-line   format "X(130)"
     2235       skip space(5)  "|"
     2236           "Код"               at center-field(5 + 1, 5 + 11, 3)
     2237           "|"                 at 5 + 11
     2238           "Артикул"           at center-field(5 + 11, 5 + 28, 7)
     2239           "|"                 at 5 + 28
     2240           "Название товара"   at center-field(5 + 28, 5 + 108, 15)
     2241           "|"                 at 5 + 108
     2242           "Ед.Изм."           at center-field(5 + 108, 5 + 118, 7)
     2243           "|"                 at 5 + 118
     2244           "Количество"        at center-field(5 + 118, 5 + 130, 10)
     2245           "|"                 at 5 + 130
     2246       skip space(5)
     2247           "|" v-single-line format "X(128)" "|"
     2248   .
     2249   assign
     2250       v-pg-sum-qnty       = 0
     2251       v-tot-sum-qnty      = 0
     2252   .
     2253   if sort-gr = yes
     2254   then do:
     2255       if sort-name = yes
     2256       then do:
     2257           for each buf_doc-line no-lock
     2258           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2259           , first buf_goods no-lock
     2260           where buf_goods.artic      = buf_doc-line.artic
     2261               and buf_goods.prod-type  = buf_doc-line.prod-type
     2262               and buf_goods.prod-code  = buf_doc-line.prod-code
     2263           break by buf_goods.grp-name
     2264                 by buf_goods.gds-name
     2265           :
     2266               if first-of( buf_goods.grp-name )
     2267               then do:
     2268                   if not first ( buf_goods.grp-name )
     2269                   then do:
     2270                       put stream out-stream
     2271                           skip space(5)
     2272                               "|" v-single-line format "X(128)" "|"
     2273                       .
     2274                   end.
     2275                   run print-group-line in this-procedure .
     2276               end.
     2277               run print-line in this-procedure .
     2278           end.
     2279       end.
     2280       else do:
     2281           for each buf_doc-line no-lock
     2282           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2283           , first buf_goods no-lock
     2284           where buf_goods.artic      = buf_doc-line.artic
     2285               and buf_goods.prod-type  = buf_doc-line.prod-type
     2286               and buf_goods.prod-code  = buf_doc-line.prod-code
     2287           break by buf_goods.grp-name
     2288                 by buf_goods.artic
     2289           :
     2290               if first-of( buf_goods.grp-name )
     2291               then do:
     2292                   if not first ( buf_goods.grp-name )
     2293                   then do:
     2294                       put stream out-stream
     2295                           skip space(5)
     2296                               "|" v-single-line format "X(128)" "|"
     2297                       .
     2298                   end.
     2299                   run print-group-line in this-procedure .
     2300               end.
     2301               run print-line in this-procedure .
     2302           end.
     2303       end.
     2304   end.
     2305   else do:
     2306       if sort-name = yes
     2307       then do:
     2308           for each buf_doc-line no-lock
     2309           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2310           , first buf_goods no-lock
     2311           where buf_goods.artic      = buf_doc-line.artic
     2312               and buf_goods.prod-type  = buf_doc-line.prod-type
     2313               and buf_goods.prod-code  = buf_doc-line.prod-code
     2314           break by buf_goods.gds-name
     2315           :
     2316               run print-line in this-procedure .
     2317           end.
     2318       end.
     2319       else do:
     2320           for each buf_doc-line no-lock
     2321           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2322           , first buf_goods no-lock
     2323           where buf_goods.artic      = buf_doc-line.artic
     2324               and buf_goods.prod-type  = buf_doc-line.prod-type
     2325               and buf_goods.prod-code  = buf_doc-line.prod-code
     2326           break by buf_goods.artic
     2327           :
     2328               run print-line in this-procedure .
     2329           end.
     2330       end.
     2331   end.
     2332   if v-pg-sum-qnty <> 0
     2333   then do:
     2334           run print-page-result in this-procedure .
     2335   end.
     2336   if line-counter( Out-Stream ) + 8 > page-size( Out-Stream )
     2337   then do:
     2338       page stream Out-Stream .
     2339   end.
     2340   run print-total-result in this-procedure .
     2341   hide stream Out-Stream frame BottomFrame .
     2342   run print-note in this-procedure .
     2343   if session :set-wait-state( "" ) then.
     2344   output stream out-stream close.
     2345   if g#quest-print = false
     2346   then do:
     2347     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     2348                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     2349                                         OUTPUT g#log ).
     2350   end.
     2351   else do:
     2352     os-command silent
     2353       value( "COPY /b " +
     2354         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     2355         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     2356         string( session:temp-directory) +  "$" + string( g#report-num )
     2357                 ) .
     2358     os-command silent
     2359       value( "COPY /b " +
     2360         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     2361         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     2362         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     2363                 ) .
     2364   end.
     2365   end.
     2366   procedure print-line :
     2367   do
     2368   on error undo, return error
     2369   :
     2370       find first buf_gds-prt no-lock
     2371            where buf_gds-prt.upper-code = buf_goods.prt-root
     2372       .
     2373       if PrintScale = yes
     2374           and ( buf_gds-prt.node-name <> '_Пустая шкала':U )
     2375           and v-cntxp-doc-prt = yes
     2376       then do:
     2377           put stream out-stream
     2378               skip space(5)  "|"
     2379                   string(buf_goods.gds-code, "999999999") format "X(9)"
     2380                   "|"   at 5 + 11
     2381                   string(buf_doc-line.artic)              format "X(16)"
     2382                   "|"   at 5 + 28
     2383                   buf_goods.gds-name                      format "X(79)"
     2384                   "|"   at 5 + 108
     2385                   buf_goods.unit-base                     format "X(3)"           at center-field( 5 + 108, 5 + 118, 3)
     2386                   "|"   at 5 + 118
     2387                   "|"   at 5 + 130
     2388           .
     2389           for each buf_gds-dtl no-lock
     2390              where buf_gds-dtl.prod-type  = buf_doc-line.prod-type
     2391                and buf_gds-dtl.prod-code  = buf_doc-line.prod-code
     2392                and buf_gds-dtl.artic      = buf_doc-line.artic
     2393                and buf_gds-dtl.doc-code   = buf_doc-line.doc-code
     2394            , first buf_gds-prt no-lock
     2395              where buf_gds-prt.node-code = buf_gds-dtl.prt-code
     2396           break by buf_gds-dtl.prt-code
     2397           :
     2398               assign
     2399                   v-prt-name = "   //" + buf_gds-prt.f-name
     2400               .
     2401               put stream out-stream
     2402                   skip space(5)  "|"
     2403                       "|"   at 5 + 11
     2404                       "|"   at 5 + 28
     2405                       v-prt-name                              format "X(79)"
     2406                       "|"   at 5 + 108
     2407                       "|"   at 5 + 118
     2408                       buf_gds-dtl.fact-qnty                   format "->>>>>9.<<<"
     2409                       "|"   at 5 + 130
     2410               .
     2411               assign
     2412                   v-line-counter      = v-line-counter    + 1
     2413                   v-pg-sum-qnty       = v-pg-sum-qnty     + buf_gds-dtl.fact-qnty
     2414               .
     2415               if line-counter( Out-Stream ) + 4 > page-size( Out-Stream )
     2416               then do:
     2417                   run print-page-result in this-procedure .
     2418                   page stream Out-Stream .
     2419               end.
     2420           end.
     2421       end.
     2422       else do:
     2423           run r-getsum in this-procedure ( input recid ( buf_doc-line )
     2424                                       ,  input CostPrice
     2425                                       ,  input PrintRubl
     2426                                       ).
     2427           put stream out-stream
     2428               skip space(5)  "|"
     2429                   string(buf_goods.gds-code, "999999999") format "X(9)"
     2430                   "|"   at 5 + 11
     2431                   string(buf_doc-line.artic)              format "X(16)"
     2432                   "|"   at 5 + 28
     2433                   buf_goods.gds-name                      format "X(79)"
     2434                   "|"   at 5 + 108
     2435                   buf_goods.unit-base                     format "X(3)"           at center-field( 5 + 108, 5 + 118, 3)
     2436                   "|"   at 5 + 118
     2437                   abs( temp_r-getsum.qnty )               format "->>>>>9.<<<"
     2438                   "|"   at 5 + 130
     2439           .
     2440           assign
     2441               v-line-counter      = v-line-counter    + 1
     2442               v-pg-sum-qnty       = v-pg-sum-qnty     + abs( temp_r-getsum.qnty )
     2443           .
     2444           if line-counter( Out-Stream ) + 4 > page-size( Out-Stream )
     2445           then do:
     2446               run print-page-result in this-procedure .
     2447               page stream Out-Stream .
     2448           end.
     2449       end.
     2450   end.
     2451   end procedure.
     2452   procedure print-page-result :
     2453   do
     2454   on error undo, return error
     2455   :
     2456   if page-number ( Out-Stream ) > 1
     2457   then do:
     2458       put stream out-stream
     2459           skip space(5)
     2460               "|" v-single-line format "X(128)" "|"
     2461           skip space(5)  "|        Итого по странице "
     2462               "|"                 at 5 + 118
     2463               v-pg-sum-qnty                       format "->>>>>9.<<<"
     2464               "|"                 at 5 + 130
     2465       .
     2466   end.
     2467   assign
     2468       v-tot-sum-qnty      = v-tot-sum-qnty        + v-pg-sum-qnty
     2469       v-pg-sum-qnty       = 0
     2470   .
     2471   end.
     2472   end procedure.
     2473   procedure print-total-result :
     2474   do
     2475   on error undo, return error
     2476   :
     2477       put stream out-stream
     2478           skip space(5)
     2479               "|" v-single-line format "X(128)" "|"
     2480           skip space(5)  "|        В С Е Г О "
     2481               "|"                 at 5 + 118
     2482               v-tot-sum-qnty                       format "->>>>>9.<<<"
     2483               "|"                 at 5 + 130
     2484           skip space(5)
     2485               v-single-line format "X(130)"
     2486       .
     2487   end.
     2488   end procedure.
     2489   procedure print-note :
     2490   do
     2491   on error undo, return error
     2492   :
     2493       put stream out-stream
     2494           skip(1) space(34)
     2495               "Всего наименований: "
     2496               v-line-counter  format ">>>>>9"
     2497           skip(3) space(34)
     2498               "Зав. складом/Зав. секцией: _____________________________________________ /                          /"
     2499       .
     2500   end.
     2501   end procedure.
     2502   procedure print-group-line :
     2503   do
     2504   on error undo, return error
     2505   :
     2506     put stream out-stream
     2507       skip space(5)
     2508         "|"
     2509         space(5) "Группа:" space(2)
     2510         buf_goods.grp-name
     2511         "|" at 5 + 130
     2512     .
     2513   end.
     2514   end procedure.
