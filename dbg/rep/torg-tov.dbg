     2110     define variable v-cntxp-conf-par        as   character                no-undo.
     2111     define variable v-cntxp-par-type        as   character                no-undo.
     2112     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     2113     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     2114     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     2115     define variable v-cntxp-db-num          as integer   no-undo .
     2116     define variable v-cntxp-userid          as character no-undo .
     2117     define variable v-cntxp-level           as character no-undo .
     2118     define variable v-cntxp-db-num-obj      as integer   no-undo .
     2119     define variable v-cntxp-is-admin        as logical   no-undo .
