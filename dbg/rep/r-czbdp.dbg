     3105                                         temp-t.cli-code = g#customer.obj-code
     3106                                         temp-t.obj-type = temp-obj.obj-type
     3107                                         temp-t.obj-code = temp-obj.obj-code
     3108                                         temp-t.sum-fo   = temp-t.sum-fo  + b1_arh-fin-ob-obj.expense
     3109                                         v-summ-obj      = v-summ-obj     + b1_arh-fin-ob-obj.expense
