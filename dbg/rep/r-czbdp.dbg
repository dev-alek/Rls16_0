     1831   define variable vss-include-info15 as character format "X(65)" no-undo
     1832   initial "@(#)$Workfile$ $Revision$".
     1833   define temp-table temp_p-fmt_string-part no-undo
     1834       field str-key       as integer
     1835       field string-part   as character
     1836       index pi is primary unique
     1837           str-key
     1838   .
     1839   define variable v-p-fmt-15-str-key    as integer      no-undo.
     1840   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1841                                     iInput AS INTEGER).
     1842     def var v-start-print as integer no-undo .
     1843     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1844     assign
     1845       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1846     .
     1847     RETURN v-start-print .
     1848   END FUNCTION.
     1849   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1850                                     iInput AS INTEGER).
     1851     def var v-start-print as integer no-undo .
     1852     assign
     1853       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1854     .
     1855     if v-start-print < 0 then return 0.
     1856     RETURN v-start-print .
     1857   END FUNCTION.
     1858   function p-fmt-align-string returns character (
     1859         p-in-string      as character
     1860       , p-page-width     as integer
     1861       , p-align-type     as character
     1862   ).
     1863       define variable v-string-length     as integer      no-undo.
     1864       define variable v-out-string        as character    no-undo.
     1865       assign
     1866           v-string-length = length( trim( p-in-string ) )
     1867       .
     1868       if v-string-length >= p-page-width
     1869       then do:
     1870           assign
     1871               v-out-string = trim( p-in-string )
     1872           .
     1873       end.
     1874       else do:
     1875           case p-align-type
     1876           :
     1877               when 'left':U
     1878               then do:
     1879                   assign
     1880                       v-out-string = trim( p-in-string )
     1881                   .
     1882               end.
     1883               when 'right':U
     1884               then do:
     1885                   assign
     1886                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     1887                   .
     1888               end.
     1889               when 'center':U
     1890               then do:
     1891                   assign
     1892                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     1893                   .
     1894               end.
     1895           end case.
     1896       end.
     1897       return v-out-string .
     1898   end function.
     1899   procedure p-fmt-split-string :
     1900   define input parameter p-source-string  as character        no-undo.
     1901   define input parameter p-split-length   as integer          no-undo.
     1902   define output parameter p-string-1      as character        no-undo.
     1903   define output parameter p-string-2      as character        no-undo.
     1904   do
     1905   on error undo, return error
     1906   :
     1907       define variable v-space-pos    as integer      no-undo.
     1908       if length( p-source-string ) <= p-split-length
     1909       then do:
     1910           assign
     1911               p-string-1 = p-source-string
     1912           .
     1913       end.
     1914       else do:
     1915           assign
     1916               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     1917           .
     1918           if v-space-pos = 0
     1919           then do:
     1920               assign
     1921                   v-space-pos = index( p-source-string, " ":U )
     1922               .
     1923           end.
     1924           if v-space-pos = 0
     1925           then do:
     1926               assign
     1927                   p-string-1 = substring( p-source-string, 1, p-split-length )
     1928                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     1929               .
     1930           end.
     1931           else do:
     1932               assign
     1933                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     1934                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     1935               .
     1936           end.
     1937       end.
     1938   end.
     1939   end procedure.
     1940   procedure p-fmt-round :
     1941   define input parameter p-qnty               as decimal          no-undo.
     1942   define input parameter p-price-no-VAT       as decimal          no-undo.
     1943   define input parameter p-VAT                as decimal          no-undo.
     1944   define input parameter p-SLT                as decimal          no-undo.
     1945   define input parameter p-road-tax           as decimal          no-undo.
     1946   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     1947   define output parameter p-new-VAT           as decimal          no-undo.
     1948   define output parameter p-new-SLT           as decimal          no-undo.
     1949   define output parameter p-new-sum-VAT       as decimal          no-undo.
     1950   define output parameter p-new-sum-SLT       as decimal          no-undo.
     1951   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     1952   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     1953   define output parameter p-new-sum-full      as decimal          no-undo.
     1954       define variable v-vat-pc    as decimal      no-undo.
     1955       define variable v-slt-pc    as decimal      no-undo.
     1956   do
     1957   on error undo, return error
     1958   :
     1959       if p-price-no-VAT = 0
     1960       then do:
     1961           assign
     1962               p-new-price-no-VAT = 0.0
     1963               p-new-VAT          = ?
     1964               p-new-SLT          = ?
     1965               p-new-sum-VAT      = 0.0
     1966               p-new-sum-SLT      = 0.0
     1967               p-new-sum-no-VAT   = 0.0
     1968               p-new-sum-road-tax = 0.0
     1969               p-new-sum-full     = 0.0
     1970           .
     1971       end.
     1972       else do:
     1973           assign
     1974               v-vat-pc            = p-VAT / p-price-no-VAT
     1975               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     1976               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     1977               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     1978               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     1979               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     1980               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     1981               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     1982               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     1983               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     1984           .
     1985       end.
     1986   end.
     1987   end procedure.
     1988   procedure p-fmt-split :
     1989   define input parameter p-in-string      as character        no-undo.
     1990   define input parameter p-split-length   as integer          no-undo.
     1991       define variable v-start-pos     as integer      no-undo.
     1992       define variable v-end-pos       as integer      no-undo.
     1993       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     1994   do
     1995   for buf_temp_p-fmt_string-part
     1996   on error undo, return error
     1997   :
     1998       empty temp-table buf_temp_p-fmt_string-part.
     1999       if p-split-length < 1
     2000       then do:
     2001           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     2002       end.
     2003       assign
     2004           p-in-string                 = trim( p-in-string )
     2005           v-p-fmt-15-str-key   = 0
     2006           v-start-pos                 = 1
     2007           v-end-pos                   = length( p-in-string )
     2008       .
     2009       run p-fmt-get-string-range in this-procedure (
     2010             input p-in-string
     2011           , input p-split-length
     2012           , input v-start-pos
     2013           , output v-start-pos
     2014           , output v-end-pos
     2015       ).
     2016       do while v-end-pos <> 0
     2017       :
     2018           create buf_temp_p-fmt_string-part.
     2019           assign
     2020               v-p-fmt-15-str-key = v-p-fmt-15-str-key + 1
     2021           .
     2022           assign
     2023               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-15-str-key
     2024               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     2025           .
     2026           assign
     2027               v-start-pos = v-end-pos + 1
     2028           .
     2029           run p-fmt-get-string-range in this-procedure (
     2030                 input p-in-string
     2031               , input p-split-length
     2032               , input v-start-pos
     2033               , output v-start-pos
     2034               , output v-end-pos
     2035           ).
     2036       end.
     2037   end.
     2038   end procedure.
     2039   procedure p-fmt-get-string-range :
     2040   define input parameter p-in-string      as character        no-undo.
     2041   define input parameter p-split-length   as integer          no-undo.
     2042   define input parameter p-old-start-pos  as integer          no-undo.
     2043   define output parameter p-start-pos     as integer          no-undo.
     2044   define output parameter p-end-pos       as integer          no-undo.
     2045       define variable v-init-string    as character    no-undo.
     2046       define variable v-temp-char      as character    no-undo.
     2047       define variable v-temp-pos       as integer      no-undo.
     2048       define variable v-counter        as integer      no-undo.
     2049   do
     2050   on error undo, return error
     2051   :
     2052       assign
     2053           p-start-pos   = p-old-start-pos
     2054           v-init-string = substring( p-in-string, p-start-pos )
     2055       no-error.
     2056       if error-status :error
     2057       or trim( v-init-string ) = "":U
     2058       then do:
     2059           assign
     2060               p-end-pos = 0
     2061           .
     2062           undo, return .
     2063       end.
     2064       assign
     2065           v-temp-char   = substring( v-init-string, 1, 1 )
     2066       .
     2067       do
     2068       while trim( v-temp-char ) = "":U
     2069       :
     2070           assign
     2071               p-start-pos     = p-start-pos + 1
     2072               v-init-string   = substring( p-in-string, p-start-pos )
     2073               v-temp-char     = substring( v-init-string, 1, 1 )
     2074           .
     2075       end.
     2076       assign
     2077           v-temp-pos  = p-split-length
     2078           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     2079           v-counter   = 0
     2080       .
     2081       search-word-end:
     2082       do
     2083       while trim( v-temp-char ) <> "":U
     2084       :
     2085           assign
     2086               v-counter   = v-counter + 1
     2087           .
     2088           if v-counter > 20
     2089           then do:
     2090               assign
     2091                   v-temp-pos  = p-split-length
     2092               .
     2093               leave search-word-end.
     2094           end.
     2095           assign
     2096               v-temp-pos  = v-temp-pos - 1
     2097               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     2098           .
     2099       end.
     2100       assign
     2101           p-end-pos = p-start-pos + v-temp-pos - 1
     2102       .
     2103   end.
     2104   end procedure.
     2105   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2106   procedure factord :
     2107     define input  parameter p-fact-date            as date    no-undo .
     2108     define input  parameter p-fact-time            as integer no-undo .
     2109     define input  parameter p-fact-num             as integer no-undo .
     2110     define input  parameter p-shift-date           as date    no-undo .
     2111     define input  parameter p-shift-num            as integer no-undo .
     2112     define input  parameter p-shift-on             as logical no-undo .
     2113     define output parameter p-fact-order           as decimal no-undo .
     2114     define output parameter p-shift-end-fact-order as decimal no-undo .
     2115     define output parameter p-day-end-fact-order   as decimal no-undo .
     2116     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2117     if p-fact-date = ?
     2118     then do:
     2119       return error "Не указана фактическая дата" .
     2120     end.
     2121     define variable v-fact-date-num as integer no-undo .
     2122     assign
     2123       v-fact-date-num = integer(p-fact-date)
     2124     .
     2125     if p-fact-num = ?
     2126     or p-fact-num = 0
     2127     then do:
     2128       return error "Не задан p-fact-num " + string(p-fact-num) .
     2129     end.
     2130     if p-fact-num < 0
     2131     then do:
     2132       return error "Отрицательный fact-num " + string(p-fact-num) .
     2133     end.
     2134     if p-fact-num >= 100000000
     2135     then do:
     2136       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2137     end.
     2138     if p-shift-on = true
     2139     then do:
     2140       if p-shift-date = ?
     2141       then do:
     2142         return error "Не задана дата смены" .
     2143       end.
     2144       if p-shift-num = ?
     2145       or p-shift-num = 0
     2146       then do:
     2147         return error "Не задан номер смены" .
     2148       end.
     2149     end.
     2150     else do:
     2151       assign
     2152         p-shift-date = p-fact-date
     2153         p-shift-num  = 24
     2154       .
     2155     end.
     2156     define variable v-shift-offset as integer no-undo .
     2157     if p-shift-date = p-fact-date
     2158     then do:
     2159       assign
     2160         v-shift-offset = 1
     2161       .
     2162     end.
     2163     if p-shift-date < p-fact-date
     2164     then do:
     2165       assign
     2166         v-shift-offset = 0
     2167       .
     2168     end.
     2169     if p-shift-date > p-fact-date
     2170     then do:
     2171       message
     2172         vss-workfile vss-revision vss-description skip
     2173         "Неправильная дата закрытия смены" skip
     2174         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2175         view-as alert-box error .
     2176       undo, return error
     2177         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2178           ,string(p-fact-date, '99/99/9999':U)
     2179           ,string(p-shift-date, '99/99/9999':U)
     2180           )
     2181       .
     2182     end.
     2183     if p-shift-num < 1
     2184     or p-shift-num > 24
     2185     then do:
     2186       message
     2187         vss-workfile vss-revision vss-description skip
     2188         "Неправильный номер смены" skip
     2189         "p-shift-num" p-shift-num skip
     2190         view-as alert-box error .
     2191       undo, return error return-value .
     2192     end.
     2193     assign
     2194       p-fact-order           = v-fact-date-num
     2195                              + v-shift-offset * 0.5
     2196                              + p-shift-num    * 0.02 - 0.01
     2197                              + p-fact-num     * 0.0000000001
     2198       p-shift-end-fact-order = v-fact-date-num
     2199                              + v-shift-offset * 0.5
     2200                              + p-shift-num    * 0.02
     2201       p-day-end-fact-order   = v-fact-date-num
     2202                              + 0.99
     2203     .
     2204     if p-fact-order           <= v-fact-date-num
     2205     or p-shift-end-fact-order <= v-fact-date-num
     2206     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2207     or p-shift-end-fact-order >= p-day-end-fact-order
     2208     then do:
     2209       message
     2210         vss-workfile vss-revision vss-description skip
     2211         "Внутренняя ошибка при генерации фактического номера" skip
     2212         "p-fact-date"            p-fact-date            skip
     2213         "p-fact-time"            p-fact-time            skip
     2214         "p-fact-num"             p-fact-num             skip
     2215         "p-shift-date"           p-shift-date           skip
     2216         "p-shift-num"            p-shift-num            skip
     2217         "p-shift-on"             p-shift-on             skip
     2218         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2219         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2220         "v-fact-date-num"        v-fact-date-num        skip
     2221         view-as alert-box error .
     2222       undo, return error return-value .
     2223     end.
     2224   end procedure.
     2225   procedure day-begin-fact-order :
     2226     define input  parameter p-fact-date            as date    no-undo .
     2227     define output parameter p-day-begin-fact-order as decimal no-undo .
     2228     do
     2229     on error undo, return error return-value
     2230     :
     2231       if p-fact-date = ?
     2232       then do:
     2233         assign
     2234           p-day-begin-fact-order = 0
     2235         .
     2236       end.
     2237       else do:
     2238         assign
     2239           p-day-begin-fact-order = integer(p-fact-date)
     2240         .
     2241       end.
     2242     end.
     2243   end procedure.
     2244   procedure factord-max-fact-order :
     2245     define output parameter p-max-fact-order as decimal   no-undo .
     2246     do
     2247     on error undo, return error return-value
     2248     :
     2249       run day-begin-fact-order in this-procedure
     2250         (input  date(1, 1, 5000)
     2251         ,output p-max-fact-order
     2252         ) .
     2253     end.
     2254   end procedure.
     2255   procedure factord-cut-archive :
     2256     define input  parameter p-obj-type             as character no-undo .
     2257     define input  parameter p-obj-code             as integer   no-undo .
     2258     define input  parameter p-fact-date            as date      no-undo .
     2259     define output parameter p-shift-on             as logical   no-undo .
     2260     define output parameter p-shift-date           as date      no-undo .
     2261     define output parameter p-shift-num            as integer   no-undo .
     2262     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2263     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2264     define variable v-fact-order as decimal   no-undo .
     2265     define buffer buf_shift-obj for ub.shift-obj .
     2266     do
     2267     on error undo, return error return-value
     2268     :
     2269   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2270   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2271     (input  p-obj-type
     2272     ,input  p-obj-code
     2273     ,input  'shift-on=request'
     2274     ,output p-shift-on
     2275     ) no-error .
     2276       if error-status :error
     2277       then do:
     2278         message
     2279           vss-workfile vss-revision vss-description skip
     2280           "Ошибка при определении атрибута объекта" skip
     2281           "Объект" p-obj-type p-obj-code skip
     2282           error-status :get-message(1) skip
     2283           return-value skip
     2284           view-as alert-box error .
     2285         undo, return error return-value .
     2286       end.
     2287       if p-shift-on = false
     2288       then do:
     2289         assign
     2290           p-shift-date               = ?
     2291           p-shift-num                = 0
     2292         .
     2293       end.
     2294       else do:
     2295         find first buf_shift-obj share-lock
     2296           where buf_shift-obj.obj-type   = p-obj-type
     2297             and buf_shift-obj.obj-code   = p-obj-code
     2298             and buf_shift-obj.shift-date > p-fact-date
     2299           use-index pi
     2300           no-error .
     2301         if not available buf_shift-obj
     2302         or buf_shift-obj.status_ <> 'зкр':U
     2303         then do:
     2304           message
     2305             vss-workfile vss-revision vss-description skip
     2306             "Невозможно вычислить последнюю смену" skip
     2307             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2308             "Объект" p-obj-type p-obj-code skip
     2309             "Дата" p-fact-date skip
     2310             view-as alert-box error .
     2311           undo, return error return-value .
     2312         end.
     2313         find last buf_shift-obj share-lock
     2314           where buf_shift-obj.obj-type = p-obj-type
     2315             and buf_shift-obj.obj-code = p-obj-code
     2316             and buf_shift-obj.shift-date <= p-fact-date
     2317           use-index pi
     2318           no-error .
     2319         if available buf_shift-obj
     2320         then do:
     2321           if  buf_shift-obj.status_ = 'зкр':U
     2322           then do:
     2323             assign
     2324               p-shift-date = buf_shift-obj.shift-date
     2325               p-shift-num  = buf_shift-obj.shift-num
     2326             .
     2327           end.
     2328           else do:
     2329             message
     2330               vss-workfile vss-revision vss-description skip
     2331               "Невозможно вычислить последнюю смену" skip
     2332               "Статус смены отличен от статуса" 'зкр':U skip
     2333               "Объект" p-obj-type p-obj-code skip
     2334               "Дата" p-fact-date skip
     2335               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2336               view-as alert-box error .
     2337             undo, return error return-value .
     2338           end.
     2339         end.
     2340         else do:
     2341           assign
     2342             p-shift-date = p-fact-date - 1
     2343             p-shift-num  = 1
     2344           .
     2345         end.
     2346       end.
     2347       run factord in this-procedure
     2348         (input  p-fact-date
     2349         ,input  1
     2350         ,input  1
     2351         ,input  p-shift-date
     2352         ,input  p-shift-num
     2353         ,input  p-shift-on
     2354         ,output v-fact-order
     2355         ,output p-shift-end-fact-order
     2356         ,output p-day-end-fact-order
     2357         ) no-error .
     2358       if error-status :error
     2359       then do:
     2360         message
     2361           vss-workfile vss-revision vss-description skip
     2362           "Ошибка при вызове процедуры factord"
     2363           error-status :get-message(1) skip
     2364           return-value skip
     2365           view-as alert-box error .
     2366         undo, return error return-value .
     2367       end.
     2368     end.
     2369   end procedure.
     2370   procedure factord-lock-shift :
     2371     define input  parameter p-obj-type  as character no-undo .
     2372     define input  parameter p-obj-code  as integer   no-undo .
     2373     define input  parameter p-fact-date as date      no-undo .
     2374     define parameter buffer buf_shift-obj for ub.shift-obj .
     2375     define variable v-shift-on      as logical   no-undo .
     2376     define variable v-extra-message as character no-undo .
     2377     define variable v-error as character no-undo .
     2378     do
     2379     on error undo, return error return-value
     2380     :
     2381   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2382   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2383     (input  p-obj-type
     2384     ,input  p-obj-code
     2385     ,input  'shift-on=request'
     2386     ,output v-shift-on
     2387     ) no-error .
     2388       if error-status :error
     2389       then do:
     2390         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2391         undo, return error v-error .
     2392       end.
     2393       if v-shift-on = true
     2394       then do:
     2395         find first buf_shift-obj share-lock
     2396           where buf_shift-obj.obj-type   = p-obj-type
     2397             and buf_shift-obj.obj-code   = p-obj-code
     2398             and buf_shift-obj.shift-date > p-fact-date
     2399           use-index pi
     2400           no-error .
     2401         if not available buf_shift-obj
     2402         or buf_shift-obj.status_ <> 'зкр':U
     2403         then do:
     2404           find last buf_shift-obj
     2405             where buf_shift-obj.obj-type = p-obj-type
     2406               and buf_shift-obj.obj-code = p-obj-code
     2407               and buf_shift-obj.status_  = 'зкр':U
     2408             use-index stts
     2409             no-error .
     2410           if available buf_shift-obj
     2411           then do:
     2412             assign
     2413               v-extra-message =
     2414                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2415                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2416                               )
     2417             .
     2418           end.
     2419           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2420           undo, return error v-error .
     2421         end.
     2422       end.
     2423     end.
     2424   end procedure.
     2425   procedure factord-end-day :
     2426     define input  parameter p-fact-date            as date    no-undo .
     2427     define output parameter p-day-end-fact-order   as decimal no-undo .
     2428     do
     2429     on error undo, return error return-value
     2430     :
     2431       if p-fact-date = ?
     2432       then do:
     2433         return error "Не указана фактическая дата" .
     2434       end.
     2435       assign
     2436         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2437       .
     2438     end.
     2439   end procedure.
     2440   procedure factord-to-date :
     2441     define input  parameter p-fact-order as decimal no-undo .
     2442     define output parameter p-fact-date  as date    no-undo .
     2443     define variable v-ref-date  as date      no-undo .
     2444     define variable v-ref-delta as integer   no-undo .
     2445     do
     2446     on error undo, return error return-value
     2447     :
     2448       if p-fact-order = ?
     2449       or p-fact-order = 0
     2450       then do:
     2451         return error "Не указан fact-order" .
     2452       end.
     2453       assign
     2454         v-ref-date  = date(1, 1, 2000)
     2455       .
     2456       assign
     2457         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2458       .
     2459       assign
     2460         p-fact-date = v-ref-date + v-ref-delta
     2461       .
     2462     end.
     2463   end procedure.
     2464   procedure factord-to-fact-num :
     2465     define input  parameter p-fact-order as decimal no-undo .
     2466     define output parameter p-fact-num   as integer no-undo .
     2467     define variable v-fact-order-trunc as decimal no-undo .
     2468     do
     2469     on error undo, return error return-value
     2470     :
     2471       if p-fact-order = ?
     2472       or p-fact-order = 0
     2473       then do:
     2474         return error "Не указан fact-order" .
     2475       end.
     2476       assign
     2477        v-fact-order-trunc = truncate(p-fact-order, 2)
     2478       .
     2479       assign
     2480         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2481       .
     2482     end.
     2483   end procedure.
     2484   procedure factord-to-shift-num :
     2485     define input  parameter p-fact-order as decimal no-undo .
     2486     define output parameter p-shift-num   as integer no-undo .
     2487     define variable  p-shift-numd  as decimal   no-undo .
     2488     define variable v-fact-order-trunc as decimal no-undo .
     2489     do
     2490     on error undo, return error return-value
     2491     :
     2492       if p-fact-order = ?
     2493       or p-fact-order = 0
     2494       then do:
     2495         return error "Не указан fact-order" .
     2496       end.
     2497       assign
     2498        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2499       .
     2500       if v-fact-order-trunc < 0.5 then do:
     2501         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2502       end.
     2503       assign
     2504         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2505         .
     2506        assign
     2507         p-shift-num = truncate (p-shift-numd , 0)
     2508       .
     2509     end.
     2510   end procedure.
     2511   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
