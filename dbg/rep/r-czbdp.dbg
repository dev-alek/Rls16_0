      841   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      842     if num-entries(string(p-dec), '.') = 2
      843       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      844       else return( string(p-dec)) .
      845   end function.
      846   function format-point-to-comma returns char (input orig as char ) .
      847   define variable rtext as character no-undo .
      848   define variable strt as integer no-undo .
      849   define variable leng as integer no-undo .
      850   assign rtext = orig .
      851   repeat:
      852     strt =  index(rtext,'.').
      853     if strt = 0 then leave.
      854     leng = 1.
      855     substring(rtext,strt,leng,"character") = v-delim .
      856   end.
      857   return rtext.
      858   end function.
      859   function format-excel-text returns char ( input start-text as char ) :
      860   def var  i    as int no-undo.
      861   def var  ch   as char no-undo.
      862   def var  n    as int no-undo.
      863   def var  ipos as int no-undo.
      864     n = num-entries(trim(start-text), chr(10)) - 1 .
      865     do i = 1 to n :
      866       ipos = index( start-text, chr(10)).
      867       if ipos > 0 then
      868         substr( start-text, ipos, 1 ) = ' '.
      869     end.
      870     n = num-entries(trim(start-text), chr(13)) - 1 .
      871     do i = 1 to n :
      872       ipos = index( start-text, chr(13)).
      873       if ipos > 0 then
      874         substr( start-text, ipos, 1 ) = ' '.
      875     end.
      876     if index( start-text, '"' ) = 0 then
      877       start-text =  '="'   + trim( start-text) + '"'   .
      878       else do:
      879         n = num-entries(trim(start-text), '"') - 1.
      880         do i = 1 to n :
      881           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      882         end.
      883         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      884         start-text = '="'  + ch  + '"' .
      885       end.
      886     return start-text.
      887   end.
      888   function excel-sum returns char (input p-dec as decimal ).
      889     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      890   end function.
      891   function excel-qnty returns char (input p-dec as decimal ).
      892     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      893   end function.
      894   function format-excel-text-macr returns char ( input start-text as char ) :
      895   def var  i    as int no-undo.
      896   def var  ch   as char no-undo.
      897   def var  n    as int no-undo.
      898   def var  ipos as int no-undo.
      899     n = num-entries(trim(start-text), chr(10)) - 1 .
      900     do i = 1 to n :
      901       ipos = index( start-text, chr(10)).
      902       if ipos > 0 then
      903         substring( start-text, ipos , 1 ) = ' '.
      904     end.
      905     n = num-entries(trim(start-text), chr(13)) - 1 .
      906     do i = 1 to n :
      907       ipos = index( start-text, chr(13)).
      908       if ipos > 0 then
      909         substring( start-text, ipos, 1 ) = ' '.
      910     end.
      911     if index( start-text, '"' ) = 0 then
      912       start-text =  '"'   + trim( start-text) + '"'   .
      913       else do:
      914         n = num-entries(trim(start-text), '"') - 1.
      915         do i = 1 to n :
      916           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      917         end.
      918         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      919         start-text = '"'  + ch  + '"' .
      920       end.
      921     n = num-entries(trim(start-text), chr(10)) - 1 .
      922     do i = 1 to n :
      923       ipos = index( start-text, chr(10)).
      924       if ipos > 0 then
      925         substring( start-text, ipos , 1 ) = ' '.
      926     end.
      927       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      928     return start-text.
      929   end.
      930   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      931   procedure cur-time :
      932      define output parameter p-today as date      no-undo .
      933      define output parameter p-time  as integer   no-undo .
      934     do
      935     on error undo, return error
      936     :
      937       define variable v-date1 as date      no-undo .
      938       define variable v-date2 as date      no-undo .
      939       define variable v-time  as integer   no-undo .
      940       assign
      941         v-date1 = today
      942         v-time  = time
      943         v-date2 = today
      944       .
      945       if v-date1 <> v-date2
      946       then do:
      947         assign
      948           v-date1 = today
      949           v-time  = v-time
      950         .
      951       end.
      952       assign
      953         p-today = v-date1
      954         p-time  = v-time
      955       .
      956     end.
      957   end.
      958   function cur-time-date returns character
      959   :
      960     return string(today, '99/99/9999':U) .
      961   end.
      962   function cur-time-mjd returns decimal
      963   :
      964     define variable v-date as date      no-undo .
      965     define variable v-time as integer   no-undo .
      966     run cur-time in this-procedure
      967       (output v-date
      968       ,output v-time
      969       ) .
      970     return integer(v-date) - 2400002 + (v-time / 86400) .
      971   end.
      972   function cur-time-get-ending-index returns integer
      973   (input p-number as integer
      974   )
      975   :
      976     if p-number < 0
      977     or p-number = ?
      978     then do:
      979       return 1 .
      980     end.
      981     define variable v-rest as integer   no-undo .
      982     assign
      983       p-number = p-number modulo 100
      984     .
      985     if p-number < 20
      986     then do:
      987       assign
      988         v-rest = p-number
      989       .
      990     end.
      991     else do:
      992       assign
      993         v-rest = p-number modulo 10
      994       .
      995     end.
      996     case v-rest :
      997       when 1
      998       then do:
      999         return 2 .
     1000       end.
     1001       when 2 or
     1002       when 3 or
     1003       when 4
     1004       then do:
     1005         return 3 .
     1006       end.
     1007       otherwise do:
     1008         return 1 .
     1009       end.
     1010     end case .
     1011   end.
     1012   procedure cur-time-mjd-to-date :
     1013      define input  parameter i-mjd-diff as decimal no-undo.
     1014      define output parameter o-Date     as date    no-undo.
     1015      define output parameter o-Time     as integer no-undo.
     1016      define variable v-day-number as integer   no-undo .
     1017      if    i-mjd-diff < 0
     1018         or i-mjd-diff = ?
     1019      then do:
     1020         return "?" .
     1021      end.
     1022      assign
     1023         v-day-number = truncate(i-mjd-diff,0).
     1024         o-Date = date(v-day-number + 2400002).
     1025         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1026     .
     1027   end.
     1028   function cur-time-mjd-to-string returns character
     1029   (input p-mjd-diff as decimal
     1030   )
     1031   :
     1032     define variable v-day-number as integer   no-undo .
     1033     define variable v-seconds    as integer   no-undo .
     1034     define variable v-hour       as integer   no-undo .
     1035     define variable v-min        as integer   no-undo .
     1036     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1037     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1038     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1039     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1040     if p-mjd-diff < 0
     1041     or p-mjd-diff = ?
     1042     then do:
     1043       return "?" .
     1044     end.
     1045     assign
     1046       v-day-number = integer(truncate(p-mjd-diff,0))
     1047       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1048     .
     1049     if v-seconds > 86400
     1050     then do:
     1051       assign
     1052         v-seconds = 86400 - 1
     1053       .
     1054     end.
     1055     if v-seconds < 0
     1056     then do:
     1057       assign
     1058         v-seconds = 0
     1059       .
     1060     end.
     1061     assign
     1062       v-hour = truncate(v-seconds / 3600, 0)
     1063     .
     1064     assign
     1065       v-seconds = v-seconds modulo 3600
     1066     .
     1067     assign
     1068       v-min = truncate(v-seconds / 60, 0)
     1069     .
     1070     assign
     1071       v-seconds = v-seconds modulo 60
     1072     .
     1073     return
     1074         (if v-day-number <> 0
     1075           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1076           else ""
     1077         )
     1078       + (if v-day-number <> 0 or v-hour <> 0
     1079           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1080           else ""
     1081         )
     1082       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1083           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1084           else ""
     1085         )
     1086       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1087       .
     1088   end.
     1089   function cur-time-string returns character
     1090   :
     1091     define variable v-date as date      no-undo .
     1092     define variable v-time as integer   no-undo .
     1093     run cur-time in this-procedure
     1094       (output v-date
     1095       ,output v-time
     1096       ) .
     1097     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1098   end.
     1099   function cur-time-string-sec returns character
     1100   :
     1101     define variable v-date as date      no-undo .
     1102     define variable v-time as integer   no-undo .
     1103     run cur-time in this-procedure
     1104       (output v-date
     1105       ,output v-time
     1106       ) .
     1107     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1108   end.
     1109   function cur-time-custom  returns character
     1110   (input p-prefix as character
     1111   ,input p-date-format as character
     1112   ,input p-delimiter as character
     1113   ,input p-time-format as character
     1114   ,input p-suffix as character
     1115   )
     1116   :
     1117     define variable v-date as date      no-undo .
     1118     define variable v-time as integer   no-undo .
     1119     run cur-time in this-procedure
     1120       (output v-date
     1121       ,output v-time
     1122       ) .
     1123     return
     1124       p-prefix
     1125       + string(v-date, p-date-format)
     1126       + p-delimiter
     1127       + string(v-time, p-time-format)
     1128       + p-suffix
     1129       .
     1130   end.
     1131   function cur-time-print  returns character
     1132   :
     1133     define variable v-date as date      no-undo .
     1134     define variable v-time as integer   no-undo .
     1135     run cur-time in this-procedure
     1136       (output v-date
     1137       ,output v-time
     1138       ) .
     1139     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1140   end.
     1141   function cur-time-datetime returns datetime
     1142   :
     1143     define variable v-char as character no-undo .
     1144     define variable v-datetime as datetime no-undo .
     1145     v-char = cur-time-string().
     1146     v-datetime = datetime(v-char).
     1147     return  v-datetime.
     1148   end.
     1149   function cur-time-string-msec returns character
     1150   :
     1151     define variable v-date as datetime  no-undo .
     1152     v-date = now.
     1153     return string(v-date) .
     1154   end.
     1155   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1156   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1157   procedure paramls-clear :
     1158     define buffer buf_temp-param for temp-param .
     1159     do
     1160     on error undo, return error return-value
     1161     :
     1162       for each buf_temp-param
     1163       on error undo, return error
     1164       :
     1165         delete buf_temp-param .
     1166       end.
     1167     end.
     1168   end procedure.
     1169   procedure paramls-write :
     1170     define input  parameter p-code     as character no-undo .
     1171     define input  parameter p-sub-code as character no-undo .
     1172     define input  parameter p-value    as character no-undo .
     1173     define buffer buf_temp-param for temp-param .
     1174     do
     1175     on error undo, return error return-value
     1176     :
     1177       find first buf_temp-param
     1178         where buf_temp-param.param-code     = p-code
     1179           and buf_temp-param.param-sub-code = p-sub-code
     1180         no-error .
     1181       if not available buf_temp-param then do:
     1182         create buf_temp-param .
     1183         assign
     1184           buf_temp-param.param-code     = p-code
     1185           buf_temp-param.param-sub-code = p-sub-code
     1186         .
     1187       end.
     1188       assign
     1189         buf_temp-param.param-value = p-value
     1190       .
     1191     end.
     1192   end procedure.
     1193   procedure paramls-read :
     1194     define input  parameter p-code          as character no-undo .
     1195     define input  parameter p-sub-code      as character no-undo .
     1196     define input  parameter p-default-value as character no-undo .
     1197     define output parameter p-value         as character no-undo .
     1198     define buffer buf_temp-param for temp-param .
     1199     do
     1200     on error undo, return error return-value
     1201     :
     1202       find first buf_temp-param
     1203         where buf_temp-param.param-code     = p-code
     1204           and buf_temp-param.param-sub-code = p-sub-code
     1205         no-error .
     1206       if available buf_temp-param then do:
     1207         assign
     1208           p-value = buf_temp-param.param-value
     1209         .
     1210       end.
     1211       else do:
     1212         assign
     1213           p-value = p-default-value
     1214         .
     1215       end.
     1216     end.
     1217   end procedure.
     1218   procedure paramls-append :
     1219     define input  parameter p-code     as character no-undo .
     1220     define input  parameter p-sub-code as character no-undo .
     1221     define input  parameter p-value    as character no-undo .
     1222     define buffer buf_temp-param for temp-param .
     1223     do
     1224     on error undo, return error return-value
     1225     :
     1226       find first buf_temp-param
     1227            where buf_temp-param.param-code     = p-code
     1228              and buf_temp-param.param-sub-code = p-sub-code
     1229         no-error .
     1230       if not available buf_temp-param then do:
     1231         create buf_temp-param .
     1232         assign
     1233           buf_temp-param.param-code     = p-code
     1234           buf_temp-param.param-sub-code = p-sub-code
     1235           buf_temp-param.param-value    = p-value
     1236         .
     1237       end.
     1238       else do:
     1239           assign
     1240               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1241           .
     1242       end.
     1243     end.
     1244   end procedure.
     1245   procedure proc-alt-shift-f2:
     1246     if not ibs.th.gbl.gbl-var:rcode
     1247   then
     1248     run gbl\inidebug.p .
     1249   end.
     1250   procedure proc-alt-shift-f3:
     1251     run gbl/prvssinf.p
     1252       ( input this-procedure
     1253       ) .
     1254   end.
     1255   define variable v-inform-launched as logical no-undo initial false .
     1256   procedure proc-alt-shift-f4:
     1257     define variable v-action as character no-undo .
     1258     if v-inform-launched = false then do:
     1259       assign
     1260         v-inform-launched = true
     1261       .
     1262       run gbl/d-inform.w
     1263         (  input self
     1264         ,  input this-procedure
     1265         , output v-action
     1266         ) no-error .
     1267       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1268       assign
     1269         v-inform-launched = false
     1270       .
     1271     end.
     1272   end.
     1273   procedure proc-alt-f1:
     1274     run gbl/corrhelp.p
     1275       (input this-procedure
     1276       ) .
     1277   end .
     1278   on alt-shift-f2 anywhere do:
     1279     run proc-alt-shift-f2.
     1280   end.
     1281   on alt-shift-f3 anywhere do:
     1282     run proc-alt-shift-f3 in this-procedure .
     1283   end.
     1284   on alt-shift-f4 anywhere do:
     1285     run proc-alt-shift-f4 in this-procedure.
     1286   end.
     1287   on alt-f1 anywhere do:
     1288     run proc-alt-f1 in this-procedure .
     1289   end.
     1290   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   define variable v-waitfram-action01         as character   no-undo .
     1292   define variable v-waitfram-action02         as character   no-undo .
     1293   define variable v-waitfram-action03         as character   no-undo .
     1294   define variable mWaitFramTextBeg            as character   no-undo.
     1295   define variable mWaitFramTextEnd            as character   no-undo.
     1296   define variable mWaitFramView               as logical     no-undo.
     1297   define variable mWaitProcEvent              as logical     no-undo init yes.
     1298   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1299   define variable mWaitFramStop               as logical     no-undo.
     1300   define variable mWaitFramStopUser           as logical     no-undo.
     1301   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1302   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1303   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1304   define button B-WaitFramStop auto-end-key
     1305        label "Стоп"
     1306        size 10 by 1 tooltip "Остоновить процесс".
     1307   define button B-viewProcInfo
     1308        label "Информация"
     1309        size 15 by 1 tooltip "Информация о процесс".
     1310   define frame waitfram
     1311     v-waitfram-action01 format "x(72)" no-label skip
     1312     v-waitfram-action02 format "x(72)" no-label skip
     1313     v-waitfram-action03 format "x(72)" no-label skip
     1314     B-viewProcInfo
     1315     B-WaitFramStop at row 4 col 30
     1316     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1317     .
     1318   define new global shared variable mBatchMode as logical no-undo init ?.
     1319   define variable mFramBachModHandle as handle no-undo.
     1320   mFramBachModHandle = frame waitfram:handle.
     1321   define variable mFameOldVis as logical no-undo.
     1322   define variable mVisCUrentVin as logical no-undo.
     1323   if session:batch-mode
     1324   then
     1325      mBatchMode = yes.
     1326   if mBatchMode = ? then do:
     1327     mVisCUrentVin = current-window:visible.
     1328     mFameOldVis = mFramBachModHandle:visible.
     1329     mFramBachModHandle:visible  = yes.
     1330     mBatchMode = mFramBachModHandle:visible ne yes.
     1331     mFramBachModHandle:visible = mFameOldVis.
     1332     current-window:visible = mVisCUrentVin.
     1333   end.
     1334    if  log-manager:logfile-name ne ?
     1335     then DO:
     1336         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1337         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1338         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1339     end.
     1340   on choose of B-WaitFramStop in frame waitfram
     1341   do:
     1342     mWaitFramStop = yes.
     1343     mWaitFramStopUser = yes.
     1344   end.
     1345   function waitfram-check-timeout returns logical():
     1346      define variable vtime as int64 no-undo.
     1347      if mWaitFramStopTimeOut
     1348      then
     1349         return yes.
     1350      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1351      if     mWaitFramTimeOut ne ?
     1352         and mWaitFramTimeOut ne 0
     1353         and mWaitFramTimeOut lt vtime
     1354      then do:
     1355         mWaitFramStopTimeOut = yes.
     1356      end.
     1357      return mWaitFramStopTimeOut.
     1358   end.
     1359   procedure waitfram-hide :
     1360     if not session:batch-mode
     1361     then do
     1362     on error undo, return error return-value
     1363     :
     1364       pause 0 before-hide .
     1365       if not mBatchMode then
     1366         hide frame waitfram .
     1367     if     not mWaitFramView
     1368        and mWaitProcEvent
     1369     then
     1370       process events .
     1371     end.
     1372   end procedure.
     1373   procedure waitfram-show :
     1374     define input  parameter p-message as character no-undo .
     1375     define variable v-left-margin as integer   no-undo .
     1376     if not session:batch-mode
     1377     then do
     1378     on error undo, return error return-value
     1379     :
     1380       if length(p-message) <= 70 then do:
     1381         assign
     1382           v-left-margin = integer((70 - length(p-message)) / 2)
     1383         .
     1384         assign
     1385           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1386         .
     1387         assign
     1388           v-waitfram-action01 = " "
     1389           v-waitfram-action02 = " "
     1390                                    + fill(" ", v-left-margin)
     1391                                    + p-message
     1392           v-waitfram-action03 = " "
     1393         .
     1394       end.
     1395       else do:
     1396         define variable vRindex1 as integer no-undo.
     1397         define variable vRindex2 as integer no-undo.
     1398         vRindex1 = r-index(p-message," ",70).
     1399         if vRindex1 = 0
     1400         then
     1401            vRindex1 = 70.
     1402         if length(p-message)  <= vRindex1 + 70 then do:
     1403           assign
     1404             v-waitfram-action01 = " "
     1405             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1406             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1407           .
     1408         end.
     1409         else do:
     1410           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1411           if vRindex2 <= vRindex1
     1412           then
     1413              vRindex2 = vRindex1 + 70.
     1414           assign
     1415             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1416             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1417             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1418           .
     1419         end.
     1420       end.
     1421       B-viewProcInfo:visible   in frame waitfram = no.
     1422       B-viewProcInfo:sensitive in frame waitfram = no.
     1423       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1424       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1425       if  (   mWaitFramView
     1426          or  mWaitProcEvent)
     1427          and not mBatchMode
     1428       then
     1429          display
     1430             v-waitfram-action01 skip
     1431             v-waitfram-action02 skip
     1432             v-waitfram-action03 skip
     1433          with frame waitfram .
     1434       if     mWaitFramView
     1435          then do:
     1436             if     mWaitFramInterval ne ?
     1437                and not mBatchMode
     1438             then
     1439                wait-for go of frame waitfram pause mWaitFramInterval.
     1440          end.
     1441          else
     1442             if     mWaitProcEvent
     1443                and not mBatchMode
     1444             then
     1445                process events .
     1446     end.
     1447   end procedure.
     1448      procedure waitfram-show-this:
     1449         define input  parameter iInterval as int64 no-undo.
     1450         define variable vtime as int64 no-undo.
     1451         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1452         mWaitFramInterval = iInterval.
     1453         run waitfram-show (substitute("&1&2 &3&4" ,
     1454                                       mWaitFramTextBeg ,
     1455                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1456                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1457                                       mWaitFramTextEnd
     1458                                      )
     1459                           ).
     1460      end.
     1461      procedure WaitFramRunPause:
     1462         define input  parameter iInterval as dec no-undo.
     1463         define variable vStart  as datetime-tz no-undo.
     1464         define variable vend    as datetime-tz no-undo.
     1465         define variable vint as int64 no-undo.
     1466         define variable vOk as logical no-undo.
     1467         vStart = now.
     1468         vend   = vStart.
     1469         publish "WaitFramPause" (iInterval,output vOk).
     1470         vend   =  now.
     1471         vint = vend - vStart.
     1472         vint = iInterval - vint / 1000.
     1473         if     not mWaitFramStop
     1474            and (   vint > 0
     1475                 or (    not vOk
     1476                     and iInterval eq ?
     1477                     )
     1478                 )
     1479         then
     1480            run waitfram-show-this (iInterval).
     1481         vend   =  now.
     1482         vint = vend - vStart.
     1483         vint = iInterval - vint / 1000.
     1484         if     not mWaitFramStop
     1485            and vint > 0
     1486         then do:
     1487            run gbl/pause.p (vint * 1000).
     1488         end.
     1489         if iInterval ne ?
     1490         then
     1491            publish "WaitFramStop".
     1492         waitfram-check-timeout().
     1493      end.
     1494      procedure WaitFramWaitFor:
     1495         define input  parameter iInterval as dec no-undo.
     1496         assign
     1497            mWaitFramStartProc   = now
     1498            mWaitFramStopUser    = no
     1499            mWaitFramStopTimeOut = no
     1500         .
     1501         block-wait:
     1502         do while not mWaitFramStop:
     1503            run WaitFramRunPause (iInterval).
     1504            if  waitfram-check-timeout()
     1505            then do:
     1506               leave block-wait.
     1507            end.
     1508         end.
     1509         run waitfram-hide.
     1510      end.
     1511   procedure waitfram-join :
     1512     define input  parameter p-line-1  as character no-undo .
     1513     define input  parameter p-line-2  as character no-undo .
     1514     define input  parameter p-line-3  as character no-undo .
     1515     define output parameter p-message as character no-undo .
     1516     do
     1517     on error undo, return error return-value
     1518     :
     1519       assign
     1520         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1521                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1522                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1523       .
     1524     end.
     1525   end procedure.
     1526   function waitfram-join-function returns character
     1527     (input p-line-1 as character
     1528     ,input p-line-2 as character
     1529     ,input p-line-3 as character
     1530     ).
     1531     define variable v-message as character no-undo .
     1532     run waitfram-join in this-procedure
     1533       (input  p-line-1
     1534       ,input  p-line-2
     1535       ,input  p-line-3
     1536       ,output v-message
     1537       ) .
     1538     return v-message .
     1539   end function .
