     3323                                     .
     3324                           end.
     3325         end.
     3326    end.
     3327   end procedure.
     3328   procedure proc-body-plat :
     3329    do
     3330    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3331    :
     3332   for each temp-obj :
     3333     for each buf_fin-doc no-lock
     3334         where
     3335         buf_fin-doc.host-code = v-host-code                and
     3336         buf_fin-doc.obj-type  = temp-obj.obj-type          and
     3337         buf_fin-doc.obj-code  = temp-obj.obj-code          and
     3338         buf_fin-doc.status_    <> 'факт':U              and
     3339         buf_fin-doc.doc-date  = x-date-alone               and
     3340        (
     3341         (
     3342           buf_fin-doc.receiver-type  = g#customer.obj-type        and
     3343           buf_fin-doc.receiver-code  = g#customer.obj-code        )
     3344           or
     3345         (
     3346           buf_fin-doc.payer-type = g#customer.obj-type        and
     3347           buf_fin-doc.payer-code = g#customer.obj-code        )
     3348           )
     3349           :
     3350           find first temp-t where
     3351                       temp-t.cli-type = g#customer.obj-type and
     3352                       temp-t.cli-code = g#customer.obj-code and
     3353                       temp-t.obj-type = temp-obj.obj-type   and
     3354                       temp-t.obj-code = temp-obj.obj-code  no-error .
     3355               if not available temp-t then
     3356                 create temp-t.
     3357                   assign
     3358                       temp-t.cli-type = g#customer.obj-type
     3359                       temp-t.cli-code = g#customer.obj-code
     3360                       temp-t.obj-type = temp-obj.obj-type
     3361                       temp-t.obj-code = temp-obj.obj-code
     3362                   .
     3363                 v-vvdec = (if v-curr = 0 then buf_fin-doc.sum-rubl else buf_fin-doc.sum-base ).
     3364               if  buf_fin-doc.fin-ext-doc-type    = 'апп':U or
     3365                   buf_fin-doc.fin-ext-doc-type    = 'пко':U or
     3366                   buf_fin-doc.fin-ext-doc-type    = 'ппп':U
     3367                 then do:
     3368                       temp-t.sum-op    = temp-t.sum-op  + v-vvdec.
     3369                       v-summ-obj       = v-summ-obj     + v-vvdec.
     3370               end.
     3371               else do:
     3372                       temp-t.sum-op    = temp-t.sum-op - v-vvdec .
     3373                       v-summ-obj       = v-summ-obj    - v-vvdec .
     3374               end.
     3375     end.
     3376   end.
     3377    end.
     3378   end procedure.
