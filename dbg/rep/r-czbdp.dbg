     2571   define variable C-c    as integer no-undo .
     2572   define variable C-str  as character no-undo .
     2573   define variable str--1 as character Format "x(60)" no-undo.
     2574   define variable str--2 as integer no-undo .
     2575   define variable C-i    as integer no-undo .
     2576   define variable p-var  as integer no-undo .
     2577   define variable var-1  as integer no-undo .
     2578   define variable var-2  as integer no-undo .
     2579   define variable num-ln as integer   no-undo .
     2580   define variable i as int no-undo.
     2581   define variable j as int no-undo.
     2582   define variable Counter1 as integer init 0  no-undo .
     2583   define variable LineBuf       as char    no-undo.
     2584   define variable Line       as char    no-undo.
     2585   define variable UndLine    as char    no-undo.
     2586   define variable     Lines_Counter as   int  init 0  no-undo.
     2587   define variable     Tmp_Counter   as   int  init 0  no-undo.
     2588   define variable fact-order-2 as decimal no-undo .
     2589   define variable v-host-code as integer no-undo .
