     3628   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3629   procedure macr_excel_char :
     3630    do
     3631    on error undo, return error return-value
     3632    :
     3633    define input parameter  p-val as character no-undo .
     3634    define input parameter  p-row as integer no-undo .
     3635    define input parameter  p-col as integer no-undo .
     3636    if p-val = ? then p-val = "" .
     3637       put stream macr_excel unformatted
     3638             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3639    end.
     3640   end procedure.
     3641   procedure macr_excel_char_with_format :
     3642    do
     3643    on error undo, return error return-value
     3644    :
     3645    define input parameter  p-val as character no-undo .
     3646    define input parameter  p-row as integer no-undo .
     3647    define input parameter  p-col as integer no-undo .
     3648    if p-val = ? then p-val = "" .
     3649       put stream macr_excel unformatted
     3650             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3651       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     3652       put stream macr_excel unformatted
     3653             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3654    end.
     3655   end procedure.
     3656   procedure macr_excel_cell_format :
     3657    do
     3658    on error undo, return error return-value
     3659    :
     3660    define input parameter  p-val    as character no-undo .
     3661    define input parameter  p-row    as integer   no-undo .
     3662    define input parameter  p-col    as integer   no-undo .
     3663    define input parameter  p-format as character no-undo .
     3664    if p-val = ? then p-val = "" .
     3665       put stream macr_excel unformatted
     3666             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3667       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     3668       put stream macr_excel unformatted
     3669             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3670    end.
     3671   end procedure.
     3672   procedure macr_excel_sum :
     3673    do
     3674    on error undo, return error return-value
     3675    :
     3676    define input parameter  p-row as integer no-undo .
     3677    define input parameter  p-col as integer no-undo .
     3678    define input parameter  p-row1 as integer no-undo .
     3679    define input parameter  p-col1 as integer no-undo .
     3680    define input parameter  p-row2 as integer no-undo .
     3681    define input parameter  p-col2 as integer no-undo .
     3682       put stream macr_excel unformatted
     3683             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     3684    end.
     3685   end procedure.
     3686   procedure macr_excel_dec :
     3687    do
     3688    on error undo, return error return-value
     3689    :
     3690    define input parameter  p-val as character no-undo .
     3691    define input parameter  p-row as integer   no-undo .
     3692    define input parameter  p-col as integer   no-undo .
     3693     if p-val = ? then p-val =  "" .
     3694      put  stream macr_excel unformatted
     3695           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     3696    end.
     3697   end procedure.
     3698   procedure macr_cell_format :
     3699    do
     3700    on error undo, return error return-value
     3701    :
     3702    define input parameter  p-size   as integer   no-undo .
     3703    define input parameter  p-bold   as logical   no-undo .
     3704    define input parameter  p-italic as logical   no-undo .
     3705    define input parameter  p-color  as integer   no-undo .
     3706    define input parameter  p-row    as integer   no-undo .
     3707    define input parameter  p-col    as integer   no-undo .
     3708    define input parameter  p-row-2  as integer   no-undo .
     3709    define input parameter  p-col-2  as integer   no-undo .
     3710     if p-size = ? then p-size = 10 .
     3711     if p-bold = ? then p-bold = false .
     3712     if p-italic = ? then p-italic = false .
     3713     if p-row-2 = ? then p-row-2 = p-row .
     3714     if p-col-2 = ? then p-col-2 = p-col .
     3715     put  stream macr_excel unformatted
     3716      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     3717     if p-color <> ? then do:
     3718        put  stream macr_excel unformatted
     3719          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     3720     end.
     3721     put  stream macr_excel unformatted
     3722          substitute('format.font(,&1,&2,&3)' , p-size,
     3723                                           string ( p-bold  , "true/false" ) ,
     3724                                           string ( p-italic , "true/false" )
     3725                                           ) + chr(10) .
     3726    end.
     3727   end procedure.
     3728   procedure macr_cell_size :
     3729    do
     3730    on error undo, return error return-value
     3731    :
     3732    define input parameter  p-w   as integer   no-undo .
     3733    define input parameter  p-l   as integer   no-undo .
     3734    define input parameter  p-row    as integer   no-undo .
     3735    define input parameter  p-col    as integer   no-undo .
     3736    define input parameter  p-row-2  as integer   no-undo .
     3737    define input parameter  p-col-2  as integer   no-undo .
     3738     if p-row-2 = ? then p-row-2 = p-row .
     3739     if p-col-2 = ? then p-col-2 = p-col .
     3740     if p-w = ? then    p-w = 0 .
     3741     if p-l = ? then    p-l = 0 .
     3742    define variable s-w as character no-undo .
     3743    define variable s-l as character no-undo .
     3744    if p-w = 0 then s-w = "" .
     3745               else s-w = string(p-w)  .
     3746    if p-l = 0 then s-l = "" .
     3747               else s-l = string(p-l)  .
     3748   put  stream macr_excel unformatted
     3749        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     3750   put  stream macr_excel unformatted
     3751        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     3752   put  stream macr_excel unformatted
     3753        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     3754    end.
     3755   end procedure.
     3756   procedure proc-print-header :
     3757    do
     3758    on error undo, return error return-value
     3759    :
     3760      find first sheetf .
     3761        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     3762        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     3763        var-1 =  num#str# .
     3764        repeat c-c = 1 to sheetf.excel-row-title :
     3765        num#str# = num#str# + 1 .
     3766        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     3767        do c-i = 1 to p-var :
     3768           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     3769           str--2 = integer(entry( c-i, sheetf.sizes )) .
     3770           num#col# = c-i .
     3771           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     3772           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     3773        end.
     3774       c-i = 0.
     3775       end.
     3776       run macr_cell_format (
     3777           10       ,
     3778           true     ,
     3779           false    ,
     3780           35       ,
     3781           var-1 + 1,
     3782           1        ,
     3783           num#str# ,
     3784           num#col# )
     3785           .
     3786     put  stream macr_excel unformatted
     3787          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     3788          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     3789          .
     3790    end.
     3791   end procedure.
     3792   procedure end-proc :
     3793    do
     3794    on error undo, return error return-value
     3795    :
     3796     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     3797     OUTPUT to VALUE (v-file-name) .
     3798     for each temp-param :
     3799       export  temp-param  .
     3800     end.
     3801    end.
     3802   end procedure.
