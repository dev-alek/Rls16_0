     2675         ,input string(v-ind)
     2676         ,input v-file-name
     2677         ) .
     2678       run paramls-write in this-procedure
     2679           (input "charcol"
     2680           ,input ""
     2681           ,input "1"
     2682           ) .
     2683       run end-proc in this-procedure .
     2684       run waitfram-hide in this-procedure .
     2685       run prn-lib-prn-file in this-procedure (
     2686           input parParentProc
     2687          ,input 8
     2688           ).
     2689   end.
     2690   procedure print-title :
     2691    do
     2692    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2693    :
     2694   define variable l-ii  as integer no-undo .
     2695   define variable l-jj  as integer no-undo .
     2696   define variable l-len as integer no-undo .
     2697   define variable l-m   as integer no-undo .
     2698         num#str# = num#str# + 1 .
     2699         num#col# =  1 .
     2700         run macr_excel_char_with_format in this-procedure ( reportname + " на " + string(x-date-alone, "99/99/9999") , num#str# , num#col#  ).
     2701         run macr_cell_format in this-procedure
     2702             ( 12       ,
     2703               true     ,
     2704               false    ,
     2705               ?        ,
     2706               num#str# ,
     2707               num#col# ,
     2708               ?        ,
     2709               ?         ) .
     2710   num#str# = num#str# + 1.
     2711   num#col# = 1.
     2712    end.
     2713   end procedure.
     2714   procedure print-1-razd :
     2715    do
     2716    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2717    :
     2718   define variable str as character no-undo .
     2719   define variable v-dec as decimal no-undo .
     2720   define variable num#at as integer no-undo .
     2721   define variable p-value    as character no-undo .
     2722   define variable p-type     as character no-undo .
     2723   run print-ll  in this-procedure .
     2724     assign
     2725       num#str# = num#str# + 1
     2726       num#col# =  2
     2727       num#at   =  30
     2728     .
     2729     for each temp-obj   where temp-obj.nn = i-page
     2730         on error undo, return error :
     2731         str  =  temp-obj.obj-type + " " + string(temp-obj.obj-code) .
     2732         run macr_excel_char_with_format in this-procedure ( str , num#str# , num#col#  ).
     2733         put stream prnlibstream unformatted p-fmt-align-string(str , 12 , 'right':U ) + "|"  at num#at format "x(13)" .
     2734         num#col# = num#col# +  1 .
     2735         num#at   = num#at + 13 .
     2736     end.
     2737     run macr_cell_format in this-procedure
     2738         ( 10    ,
     2739           true  ,
     2740           true  ,
     2741           33    ,
     2742           num#str# ,
     2743           1 ,
     2744           num#str# ,
     2745           num#col#  ) .
     2746   put stream prnlibstream   unformatted skip .
     2747     run print-ll in this-procedure  .
     2748     run print-h in this-procedure  ( input "Остаток на нач.дня в кассах" ,
     2749                   input   'fin-ostatok-start':U)
     2750                   .
     2751     run print-h in this-procedure  ( input  "План прихода" ,
     2752                   input   'fin-plan-pri':U)
     2753                   .
     2754     run print-h in this-procedure  ( input  "Прочие доходы" ,
     2755                   input  'fin-proch':U)
     2756                   .
     2757     run print-h in this-procedure  ( input "Прочие расходы" ,
     2758                   input  'fin-proch-ras':U)
     2759                   .
     2760     run print-ll in this-procedure  .
     2761     run print-cli in this-procedure  ( input "Итого к распределению" ,
     2762                     input  "sum-obj":U )
     2763                   .
     2764     run print-ll in this-procedure  .
     2765    end.
     2766   end procedure.
     2767   procedure make-tt :
     2768    do
     2769    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2770    :
     2771   if not can-find( first g#customer ) then do:
     2772      run waitfram-show in this-procedure ("Подготовка списка Поставщиков...").
     2773      for each buf_clients no-lock where
     2774               (buf_clients.obj-type = 'орг':U or
     2775                buf_clients.obj-type = 'чел':U )
     2776               :
     2777               if
     2778               (buf_clients.obj-type = 'орг':U and
     2779                buf_clients.obj-code = v-host-code ) then next.
     2780               create g#customer.
     2781               BUFFER-COPY buf_clients to g#customer.
     2782      end.
     2783   end.
     2784   run waitfram-show in this-procedure ("Подготовка списка Объектов...").
     2785   for each obj-list
     2786       on error undo, return error :
     2787       var-calc-page = var-calc-page + 1 .
     2788       create temp-obj.
     2789       buffer-copy obj-list to temp-obj
     2790       assign
     2791         temp-obj.nn = truncate ( var-calc-page / 12.1 , 0 ) + 1
     2792         glob-page   = temp-obj.nn
     2793       .
     2794   end.
     2795   run waitfram-show in this-procedure ("Проход по архивам...").
     2796       for each g#customer :
     2797           for each buf_contract no-lock where
     2798               buf_contract.host-code = v-host-code and
     2799               buf_contract.cli-type  = g#customer.obj-type   and
     2800               buf_contract.cli-code  = g#customer.obj-code
     2801               :
     2802                  run proc-body in this-procedure  (input buf_contract.contract-code ) .
     2803           end.
     2804           run proc-body-cli in this-procedure    .
     2805           if not can-find(first temp-cli where temp-cli.obj-type = g#customer.obj-type   and
     2806                                                temp-cli.obj-code = g#customer.obj-code ) then do:
     2807               if can-find(first temp-t where temp-t.cli-type = g#customer.obj-type   and
     2808                                              temp-t.cli-code = g#customer.obj-code ) then do:
     2809                   create temp-cli.
     2810                   BUFFER-COPY g#customer to temp-cli
     2811                   assign
     2812                     temp-cli.summ = v-summ-obj.
     2813                   .
     2814                   v-summ-obj = 0 .
     2815               end.
     2816           end.
     2817          run waitfram-show in this-procedure ("Обработан поставщик: " + g#customer.obj-name ).
     2818       end.
     2819       run waitfram-show in this-procedure ("Подготовка к печати" ).
     2820    end.
     2821   end procedure.
     2822   procedure print-h :
     2823     do
     2824     on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2825     :
     2826   define input parameter p-str as character no-undo .
     2827   define input parameter p-prop-code as character no-undo .
     2828   define variable v-dec  as decimal no-undo init 0 .
     2829   define variable num#at as integer no-undo .
     2830   define variable p-type     as character no-undo .
     2831   define variable v-value-character like ub.thbj-attr.property-value-character no-undo .
     2832   define variable v-value-date    like ub.thbj-attr.property-value-date no-undo .
     2833   define variable v-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
     2834   define variable v-value-logical like ub.thbj-attr.property-value-logical no-undo .
     2835   define variable v-value-integer like ub.thbj-attr.property-value-integer no-undo .
     2836   define variable v-type     as character no-undo .
     2837   define variable v-found as decimal no-undo .
     2838   assign
     2839     num#str# = num#str# + 1
     2840     num#col# =  1
     2841     num#at   = 30
     2842   .
     2843   run macr_excel_char_with_format in this-procedure ( p-str , num#str# , num#col#  ) .
     2844   put stream prnlibstream  unformatted p-str  at 1.
     2845   num#col# = num#col# + 1 .
     2846     for each temp-obj  where temp-obj.nn = i-page
     2847         on error undo, return error :
     2848         run thbjattr_value in this-procedure  (
     2849             input   temp-obj.obj-type ,
     2850             input   temp-obj.obj-code ,
     2851             input   p-prop-code       ,
     2852             input   'fin-plan':U  ,
     2853             output  v-value-character ,
     2854             output  v-value-date      ,
     2855             output  v-value-decimal   ,
     2856             output  v-value-integer   ,
     2857             output  v-value-logical   ,
     2858             output  v-type            ,
     2859             output  v-found
     2860             )
     2861             .
     2862         temp-obj.sum-obj = temp-obj.sum-obj + v-value-decimal .
     2863         define variable v-temp-dec as decimal no-undo .
     2864         case p-prop-code :
     2865           when 'fin-ostatok-start':U then do:
     2866             sum-ostatok-start = sum-ostatok-start + v-value-decimal.
     2867             v-temp-dec        = sum-ostatok-start .
     2868           end.
     2869           when 'fin-plan-pri':U then do:
     2870             sum-plan-pri = sum-plan-pri +  v-value-decimal .
     2871             v-temp-dec   = sum-plan-pri .
     2872           end.
     2873           when 'fin-proch':U then do:
     2874             sum-proch   = sum-proch +  v-value-decimal .
     2875             v-temp-dec  = sum-proch .
     2876           end.
     2877           when 'fin-proch-ras':U then do:
     2878             sum-proch-ras   = sum-proch-ras +  v-value-decimal .
     2879             v-temp-dec  = sum-proch-ras .
     2880           end.
     2881           otherwise do:
     2882              v-temp-dec  = 0 .
     2883           end.
     2884         end case.
     2885         run macr_excel_dec in this-procedure ( v-value-decimal , num#str# , num#col#  ).
     2886         put stream prnlibstream   unformatted v-value-decimal at num#at  format "->>>>>>>>9.99" .
     2887         num#col# = num#col# +  1  .
     2888         num#at   = num#at   +  13 .
     2889     end.
     2890     run print-itog-col in this-procedure ( v-temp-dec , num#at ) .
     2891     put stream prnlibstream unformatted skip.
     2892     end.
     2893   end procedure.
     2894   procedure print-cli :
     2895     do
     2896     on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2897     :
     2898   define input parameter p-str as character no-undo .
     2899   define input parameter p-dec as character no-undo .
     2900   define variable num#at as integer no-undo .
     2901   define variable v-dec  as decimal no-undo .
     2902   assign
     2903     num#str# = num#str# + 1
     2904     num#col# =  1
     2905     num#at   = 30
     2906   .
     2907   run macr_excel_char_with_format in this-procedure ( p-str , num#str# , num#col#  ) .
     2908   put stream prnlibstream  unformatted p-str  at 1.
     2909   num#col# = num#col# + 1 .
     2910     for each temp-obj  where temp-obj.nn = i-page
     2911         on error undo, return error :
     2912         case p-dec :
     2913             when "sum-obj" then do:
     2914               v-dec = temp-obj.sum-obj.
     2915               all-summ-dec-razd-1 = all-summ-dec-razd-1  + v-dec .
     2916             end.
     2917             when "sum-obj-arh" then do:
     2918               v-dec = temp-obj.sum-obj-arh .
     2919               all-summ-dec-razd-2 = all-summ-dec-razd-2  + v-dec .
     2920             end.
     2921             when "sum-ost" then do:
     2922                 v-dec =  temp-obj.sum-obj - temp-obj.sum-obj-arh .
     2923                 all-summ-dec-razd-3 = all-summ-dec-razd-3  + v-dec .
     2924             end.
     2925         end case.
     2926         run macr_excel_dec in this-procedure ( v-dec , num#str# , num#col#  ).
     2927         put stream prnlibstream   unformatted v-dec at num#at  format "->>>>>>>>9.99" .
     2928         num#col# = num#col# +  1  .
     2929         num#at   = num#at   +  13 .
     2930     end.
     2931     if i-page = glob-page then do:
     2932         case p-dec :
     2933             when "sum-obj" then do:
     2934                 run macr_excel_dec in this-procedure ( all-summ-dec-razd-1 , num#str# , num#col#  ).
     2935                 put stream prnlibstream   unformatted all-summ-dec-razd-1 at num#at  format "->>>>>>>>9.99" .
     2936              end.
     2937             when "sum-obj-arh" then do:
     2938                 run macr_excel_dec in this-procedure ( all-summ-dec-razd-2 , num#str# , num#col#  ).
     2939                 put stream prnlibstream   unformatted all-summ-dec-razd-2 at num#at  format "->>>>>>>>9.99" .
     2940              end.
     2941             when "sum-ost" then do:
     2942                 run macr_excel_dec in this-procedure ( all-summ-dec-razd-3 , num#str# , num#col#  ).
     2943                 put stream prnlibstream   unformatted all-summ-dec-razd-3 at num#at  format "->>>>>>>>9.99" .
     2944              end.
     2945          end case.
     2946         num#col# = num#col# +  1  .
     2947         num#at   = num#at   +  13 .
     2948     end.
     2949     put stream prnlibstream unformatted skip.
     2950     end.
     2951   end procedure.
     2952    procedure print-ll :
     2953     do
     2954     on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2955     :
     2956   define variable num#at as integer no-undo .
     2957   define variable str as character no-undo .
     2958     assign
     2959       num#at   =  30
     2960     .
     2961     for each temp-obj where temp-obj.nn = i-page :
     2962         str  = "------------+".
     2963         put stream prnlibstream unformatted str at num#at format "x(13)" .
     2964         num#at   = num#at + 13 .
     2965     end.
     2966     if i-page = glob-page then do:
     2967        put stream prnlibstream unformatted str at num#at format "x(13)" .
     2968     end.
     2969     end.
     2970    end procedure.
     2971   procedure print-itog-col :
     2972   do
     2973   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2974   :
     2975   define input parameter v-summa as decimal no-undo .
     2976   define input parameter v-at as integer no-undo .
     2977       if i-page = glob-page then do:
     2978           run macr_excel_dec in this-procedure ( v-summa , num#str# , num#col#  ).
     2979           put stream prnlibstream   unformatted v-summa at  v-at  format "->>>>>>>>9.99" .
     2980       end.
     2981   end.
     2982   end procedure.
     2983   procedure print-2-razd :
     2984    do
     2985    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2986    :
     2987   define variable str as character no-undo .
     2988   define variable v-dec as decimal no-undo .
     2989   define variable num#at as integer no-undo .
     2990   define variable p-value    as character no-undo .
     2991   define variable p-type     as character no-undo .
     2992   run print-ll in this-procedure .
     2993     assign
     2994       num#str# = num#str# + 1
     2995       num#col# =  1
     2996       num#at   =  1
     2997       str      = "ПЛАН ВЫПЛАТ"
     2998     .
     2999     run macr_excel_char_with_format in this-procedure ( str , num#str# , num#col#  ).
     3000     put stream prnlibstream unformatted str  at num#at format "x(13)" .
     3001     assign
     3002       num#col# =  2
     3003       num#at   =  30
     3004     .
     3005     for each temp-obj   where temp-obj.nn = i-page
     3006         on error undo, return error :
     3007         str  = temp-obj.obj-name .
     3008         run macr_excel_char_with_format in this-procedure ( str , num#str# , num#col#  ).
     3009         put stream prnlibstream unformatted p-fmt-align-string(str , 12 , 'right':U ) + "|"  at num#at format "x(13)" .
     3010         num#col# = num#col# +  1 .
     3011         num#at   = num#at + 13 .
     3012     end.
     3013     if i-page = glob-page then do:
     3014       str =  "ИТОГО по пост.".
     3015       run macr_excel_char_with_format in this-procedure ( str , num#str# , num#col#  ).
     3016       put stream prnlibstream unformatted str  at num#at format "x(13)" .
     3017     end.
     3018     run macr_cell_format in this-procedure
     3019         ( 10    ,
     3020           true  ,
     3021           true  ,
     3022           40    ,
     3023           num#str# ,
     3024           1 ,
     3025           num#str# ,
     3026           num#col#  ) .
     3027   put stream prnlibstream   unformatted skip .
     3028     run print-ll in this-procedure .
     3029    end.
     3030   end procedure.
     3031   procedure print-3-razd :
     3032    do
     3033    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3034    :
     3035   define variable str as character no-undo .
     3036   define variable v-dec as decimal no-undo .
     3037   define variable num#at as integer no-undo .
     3038   define variable p-value    as character no-undo .
     3039   define variable p-type     as character no-undo .
     3040    for each  temp-cli
     3041        on error undo, return error  with FRAME prt-frame :
     3042         assign
     3043           num#str# = num#str# + 1
     3044           num#col# =  1
     3045           num#at   =  1
     3046           .
     3047         str = temp-cli.obj-name .
     3048         run macr_excel_char_with_format in this-procedure ( str , num#str# , num#col#  ).
     3049         put stream prnlibstream unformatted str  at num#at format "x(29)" .
     3050         assign
     3051           num#col# =  2
     3052           num#at   =  30
     3053         .
     3054             for each temp-obj where temp-obj.nn = i-page
     3055                 on error undo, return error :
     3056                 for each temp-t where
     3057                          temp-t.cli-type = temp-cli.obj-type and
     3058                          temp-t.cli-code = temp-cli.obj-code and
     3059                          temp-t.obj-type = temp-obj.obj-type and
     3060                          temp-t.obj-code = temp-obj.obj-code :
     3061                   v-dec =  temp-t.sum-fo - temp-t.sum-p + temp-t.sum-op .
     3062                   temp-obj.sum-obj-arh = temp-obj.sum-obj-arh + v-dec .
     3063                   run macr_excel_dec in this-procedure ( v-dec , num#str# , num#col#  ).
     3064                   put stream prnlibstream unformatted v-dec  at num#at format "->>>>>>>>9.99" .
     3065                 end.
     3066                 num#col# = num#col# +  1 .
     3067                 num#at   = num#at + 13 .
     3068             end.
     3069         if i-page = glob-page then do:
     3070           v-dec =  temp-cli.summ .
     3071           run macr_excel_dec in this-procedure ( v-dec , num#str# , num#col#  ).
     3072           put stream prnlibstream unformatted v-dec  at num#at format "->>>>>>>>9.99" .
     3073         end.
     3074    end.
     3075    end.
     3076   end procedure.
     3077   procedure proc-body :
