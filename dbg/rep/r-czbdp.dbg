      587   define  stream PrnLibStream.
      588   procedure prn-lib-prn-file :
      589     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      590     define input parameter p-DIsabledoptions as integer no-undo .
      591     define variable v-report-name as character no-undo .
      592     define variable v-user-action as character no-undo .
      593     define variable v-printed     as logical   no-undo .
      594     define variable v-exist       as logical   no-undo .
      595     do
      596       on error undo, return error
      597       :
      598       run prn-lib-get-report-name  in this-procedure (
      599         input parParentProc
      600         ,output v-report-name
      601         ).
      602   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      604     (input  v-report-name
      605     ,input  2
      606     ,output v-exist
      607     )  .
      608       if NOT v-exist then
      609       DO:
      610         Message
      611           "Нет заданий на печать ! "
      612           view-as alert-box .
      613         Return  .
      614       End.
      615       run gbl/prnfilen.w
      616         (input  ""
      617         ,input  p-DisabledOptions
      618         ,input  string(v-report-name )
      619         ,input  7
      620         ,output v-user-action
      621         ,output v-printed
      622         ) .
      623       if v-printed then
      624       do:
      625         return "YES" .
      626       end.
      627       else
      628       do:
      629         return "NO" .
      630       end.
      631     end.
      632   end procedure.
      633   procedure prn-lib-open-stream :
      634     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      635     define input parameter p-page-size    as integer no-undo .
      636     define input parameter p-is-stream    as logical no-undo .
      637     define input parameter p-append       as logical no-undo .
      638     define variable v-report-name as character no-undo .
      639     do
      640       on error undo, return error
      641       :
      642       run prn-lib-get-report-name  in this-procedure (
      643         input parParentProc
      644         ,output v-report-name
      645         ).
      646       if p-is-stream then
      647       do:
      648         if p-append then
      649         do:
      650           output stream PrnLibStream to value( v-report-name )
      651             page-size value(p-page-size) append .
      652         end.
      653         if not p-append then
      654         do:
      655           output stream PrnLibStream to value( v-report-name )
      656             page-size value(p-page-size) .
      657         end.
      658       end.
      659       if not p-is-stream then
      660       do:
      661         if p-append then
      662         do:
      663           output to value( v-report-name )
      664             page-size value(p-page-size) append .
      665         end.
      666         if not p-append then
      667         do:
      668           output to value( v-report-name )
      669             page-size value(p-page-size) .
      670         end.
      671       end.
      672     end.
      673   end procedure.
      674   procedure prn-lib-open-exp :
      675     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      676     define input parameter p-is-stream    as logical no-undo .
      677     define input parameter p-is-append    as logical no-undo .
      678     define output parameter p-ReportFileName as char init "report" no-undo.
      679     define output parameter p-process as logical no-undo .
      680     define variable glog as logical no-undo .
      681     do
      682       on error undo, return error
      683       :
      684       SYSTEM-DIALOG GET-FILE p-ReportFileName
      685         TITLE      "Укажите путь"
      686         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      687         ASK-OVERWRITE
      688         CREATE-TEST-FILE
      689         SAVE-AS
      690         USE-FILENAME
      691         DEFAULT-EXTENSION "txt"
      692         UPDATE glog
      693         .
      694       if not glog then  return.
      695       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      696       if p-is-stream then
      697       do:
      698         if p-is-append then
      699         do:
      700           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      701         end.
      702         else
      703         do:
      704           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      705         end.
      706       end.
      707       else
      708       do:
      709         if p-is-append then
      710         do:
      711           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      712         end.
      713         else
      714         do:
      715           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      716         end.
      717       end.
      718       p-process = yes.
      719     end.
      720   end procedure.
      721   procedure prn-lib-get-report-name :
      722     define input parameter parParentProc  as widget-handle no-undo.
      723     define output parameter p-report-name as character no-undo .
      724     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      725   end procedure.
      726   procedure prn-lib-reportviewer-report-name :
      727     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      728     define input parameter p-report-name-html as character no-undo .
      729     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      730   end procedure.
      731   procedure prn-lib-reportviewer :
      732     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      733     define input parameter p-report-name-html as character no-undo .
      734     define input parameter p-param        as character no-undo .
      735     define variable v-excel           as character no-undo init 'TRUE' .
      736     define variable v-value-character as character no-undo .
      737     define variable v-value-integer   as character no-undo .
      738     define variable v-value-date      as date      no-undo .
      739     define variable v-value-decimal   as decimal   no-undo .
      740     define variable rep-excel         as logical   no-undo .
      741     define variable excel-string      as character no-undo .
      742     define variable v-param-type      as character no-undo .
      743     define variable v-tth             as handle    no-undo .
      744     run adm/shattri.p (
      745       input "get":U
      746       ,input  ""
      747       ,input  0
      748       ,input  'report-glob':U
      749       ,input  'rep-excel':U
      750       ,output v-value-character
      751       ,output v-value-date
      752       ,output v-value-decimal
      753       ,output v-value-integer
      754       ,output rep-excel
      755       ,output v-param-type
      756       ,INPUT-OUTPUT table-handle v-tth
      757       )  .
      758     if rep-excel then v-excel = "TRUE" .
      759     else v-excel = "FALSE" .
      760     if p-param eq ""
      761     then
      762        p-param = "EXCEL:" + v-excel.
      763     else
      764        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      765     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      766   end procedure.
