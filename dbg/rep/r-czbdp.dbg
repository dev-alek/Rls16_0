     2564   define variable all-summ-dec-razd-3 as decimal no-undo init 0 .
     2565   define temp-table temp-cli no-undo like clients
     2566   field summ as decimal
     2567   .
     2568   define variable v-file-name as character no-undo .
     2569   define variable v-ind       as integer   no-undo .
