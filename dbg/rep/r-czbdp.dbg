     2591   define variable v-obj-type as character no-undo .
     2592   define variable v-curr as integer no-undo .
     2593   define variable var-calc-page as integer no-undo .
     2594   define variable var-page as integer no-undo .
     2595   define buffer buf_clients  for clients .
     2596   define buffer buf_contract for contract.
     2597   define buffer b1_beznal_arh-fin for arh-fin-doc-contr-schet-obj.
     2598   define buffer b2_beznal_arh-fin for arh-fin-doc-contr-schet-obj.
     2599   define buffer b1_nal_arh-fin    for arh-fin-doc-contr-s-nal-obj.
     2600   define buffer b2_nal_arh-fin    for arh-fin-doc-contr-s-nal-obj.
     2601   define buffer b3_nal_arh-fin    for arh-fin-doc-contr-s-nal-obj.
     2602   define buffer b4_nal_arh-fin    for arh-fin-doc-contr-s-nal-obj.
     2603   define buffer b1_arh-fin-ob-obj for arh-fin-ob-contr-obj.
     2604   define buffer b2_arh-fin-ob-obj for arh-fin-ob-contr-obj.
     2605   define buffer buf_fin-doc for fin-doc.
     2606   define variable v-summ-obj as decimal no-undo init 0.
     2607   define variable v-vvdec as decimal no-undo .
     2608   run factord-end-day in this-procedure (input x-date-alone  , output  fact-order-2 ) .
     2609   run get-report-num in parParentProc(output g#report-num ) .
     2610   v-host-code  = v-cntxt-host-code-obj.
     2611   v-obj-type   = v-cntxt-obj-type .
     2612   v-obj-code   = v-cntxt-obj-code .
     2613   if x-SET_val_TYPE = 1 then v-curr = 0 .
     2614      else do:
     2615   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2616   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2617     (input  v-host-code
     2618     ,output v-curr
     2619     )  .
     2620      end.
     2621   define stream  macr_excel .
     2622   DEFINE FRAME prt-frame
     2623     HEADER  date_string AT 5 format "X(35)"
     2624             string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     2625             Line format "X(116)" AT 1
     2626             with width 232 down stream-io use-text
     2627             .
     2628       Line = fill("-", 146).
     2629       date_string = cur-time-print() .
     2630   run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     2631   output stream macr_excel to value(v-file-name)   .
     2632   v-ind = 1    .
     2633   num#str# = 0 .
     2634       run prn-lib-open-stream in this-procedure (
     2635          input parParentProc
     2636         ,input 43
     2637         ,input yes
     2638         ,input no
     2639         ).
     2640       PUT  STREAM PrnLibStream reportname + " на " + string(x-date-alone, "99/99/9999")
     2641            format "x(116)" SKIP .
     2642       FORM HEADER
     2643           Line format "X(146)" AT 1 SKIP
     2644           "Продолжение - на следующей странице" AT 1
     2645           date_string AT 50 format "X(35)"
     2646           string( "Страница " ) format "X(9)" AT 90 PAGE-NUMBER( PrnLibStream) AT 100 FORMAT ">>>>9"
     2647           with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2648       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2649       FORM with FRAME prt-frame  .
     2650       run waitfram-show in this-procedure ("Ждите печатаю...").
     2651       run print-title in this-procedure .
     2652       run make-tt in this-procedure .
     2653       define variable i-page as integer no-undo .
     2654       repeat i-page = 1 to glob-page :
     2655           if i-page > 1 then
     2656              Page  STREAM PrnLibStream .
     2657           run print-1-razd in this-procedure .
     2658           run print-2-razd in this-procedure .
     2659           run print-3-razd in this-procedure .
     2660           run print-ll in this-procedure .
     2661           run print-cli in this-procedure ( input "Итого к выдаче" ,
     2662                           input  "sum-obj-arh":U )
     2663                         .
     2664           run print-ll in this-procedure .
     2665           run print-cli in this-procedure ( input "Плановый остаток на конец дня" ,
     2666                           input  "sum-ost":U )
     2667                         .
     2668       end.
     2669       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     2670       HIDE  STREAM PrnLibStream FRAME CheckList.
     2671       output STREAM PrnLibStream CLOSE.
