     2223            "На объекте выключены смены." skip
     2224            "Работа со сменами невозможна." skip
     2225            "Объект:" v-obj-type v-obj-code skip
     2226            view-as alert-box error .
     2227         return.
     2228      end.
     2229      find first buf_shift-obj
     2230           where buf_shift-obj.obj-type = v-obj-type
     2231             and buf_shift-obj.obj-code = v-obj-code
     2232             and buf_shift-obj.status_  = 'тек':U
     2233           no-lock
     2234           no-error
     2235           .
     2236      IF not available buf_shift-obj then do:
     2237         message
     2238            "На объекте" v-obj-type v-obj-code skip
     2239            "Не найдена текущая смена" skip
     2240            view-as alert-box error .
     2241         return.
     2242      end.
     2243   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2245     (input  v-obj-type
     2246     ,input  v-obj-code
     2247     ,output v-curr-date
     2248     )  .
     2249      assign
     2250         v-date-prediction = v-curr-date - 7
     2251         v-shift-date      = buf_shift-obj.shift-date
     2252         v-shift-num       = buf_shift-obj.shift-num
     2253      .
     2254      release buf_shift-obj.
     2255      FIND LAST  buf_shift-obj
     2256           WHERE buf_shift-obj.obj-type = v-obj-type
     2257             AND buf_shift-obj.obj-code = v-obj-code
     2258             AND buf_shift-obj.shift-date = v-date-prediction
     2259             AND buf_shift-obj.shift-num  = v-shift-num
     2260      no-lock
     2261      no-error.
     2262      IF AVAILABLE buf_shift-obj then do:
     2263         assign
     2264            v-shift-num-prediction = v-shift-num
     2265         .
     2266      end.
     2267      release buf_shift-obj.
     2268      FIND LAST  buf_shift-obj
     2269           WHERE buf_shift-obj.obj-type = v-obj-type
     2270             AND buf_shift-obj.obj-code = v-obj-code
     2271             AND ((    buf_shift-obj.shift-date = v-shift-date
     2272                   AND buf_shift-obj.shift-num  < v-shift-num
     2273                  )
     2274                  OR   buf_shift-obj.shift-date < v-shift-date
     2275                 )
     2276           use-index pi
     2277           no-lock
     2278           NO-ERROR.
     2279      if available buf_shift-obj then do:
     2280         assign
     2281            v-shift-date-prev = buf_shift-obj.shift-date
     2282            v-shift-num-prev  = buf_shift-obj.shift-num
     2283         .
     2284      end.
     2285      else do:
     2286         message
     2287            "На объекте" v-obj-type v-obj-code skip
     2288            "Нет закрытых смен" skip
     2289            view-as alert-box error .
     2290         return.
     2291      end.
     2292      release buf_shift-obj.
     2293      run fill-place in this-procedure .
     2294      run fill-sale in this-procedure .
     2295      RUN find-date-shift in this-procedure
     2296            ( input v-obj-type
     2297            , input v-obj-code
     2298            , input v-date-prediction
     2299            , input v-start-time-prediction
     2300            , output v-shift-date-prediction
     2301            , output v-shift-num-prediction
     2302            ) .
     2303      define variable v-sec    as integer      no-undo.
     2304      assign
     2305         v-sec = v-start-time-prediction MOD 60
     2306         v-minute-prediction = ((v-start-time-prediction - v-sec) / 60) mod 60
     2307         v-hour-prediction   = (((v-start-time-prediction - v-sec) / 60) - v-minute-prediction) / 60
     2308      .
     2309      IF v-shift-num-prediction = 0
     2310      THEN DO:
     2311         message
     2312            "Не существует смены недельной давности, требуемой для прогноза."
     2313            skip "Выберите смену для прогноза."
     2314         view-as alert-box information.
     2315         run select-shift in this-procedure .
     2316      END.
     2317      run fill-prediction in this-procedure .
     2318      run draw-place in this-procedure .
     2319      run draw-pred in this-procedure .
     2320      run enable_UI.
     2321      WAIT-FOR GO OF FRAME Dialog-Frame.
     2322   END.
     2323   run disable_UI.
     2324   PROCEDURE del-prediction :
     2325   define buffer buf_tt-place    for tt-place.
     2326   define buffer buf_tt-gds-pred for tt-gds-pred.
     2327   do
     2328   on error undo, return error
     2329   :
     2330      for each buf_tt-place
     2331         :
     2332         assign
     2333            buf_tt-place.sale-start-qnty-prev = 0.0
     2334            buf_tt-place.sale-end-qnty-prev   = 0.0
     2335            buf_tt-place.sale-qnty-prev       = 0.0
     2336            buf_tt-place.sale-time-prev       = 999999
     2337            buf_tt-place.sale-time-prev-end   = 999999
     2338         .
     2339      end.
     2340      FOR EACH buf_tt-gds-pred
     2341          :
     2342         assign
     2343            buf_tt-gds-pred.prediction-qnty  = 0.0
     2344         .
     2345         DELETE OBJECT buf_tt-gds-pred.hnd .
     2346         DELETE OBJECT buf_tt-gds-pred.hnd-name .
     2347         DELETE OBJECT buf_tt-gds-pred.hnd-sale-qnty .
     2348         DELETE OBJECT buf_tt-gds-pred.hnd-qnty .
     2349         DELETE OBJECT buf_tt-gds-pred.hnd-pred-qnty .
     2350         DELETE OBJECT buf_tt-gds-pred.hnd-total-qnty .
     2351         DELETE OBJECT buf_tt-gds-pred.hnd-sale-qnty-l .
     2352         DELETE OBJECT buf_tt-gds-pred.hnd-qnty-l .
     2353         DELETE OBJECT buf_tt-gds-pred.hnd-pred-qnty-l .
     2354         DELETE OBJECT buf_tt-gds-pred.hnd-total-qnty-l .
     2355      end.
     2356   end.
     2357   END PROCEDURE.
     2358   PROCEDURE disable_UI :
     2359     HIDE FRAME Dialog-Frame.
     2360   END PROCEDURE.
     2361   PROCEDURE draw-place :
     2362   define variable v-frame-width    as integer      no-undo.
     2363   define variable v-frame-left     as integer      no-undo.
     2364   define variable v-frame-bottom   as integer      no-undo.
     2365   define variable v-frame-top   as integer      no-undo.
     2366   define variable v-step    as integer      no-undo.
     2367   define variable v-rect-width    as integer      no-undo.
     2368   define variable v-c    as integer      no-undo.
     2369   DEFINE VARIABLE  but1  AS HANDLE.
     2370   define buffer buf_tt-place    for tt-place.
     2371   do
     2372   on error undo, return error
     2373   :
     2374      assign
     2375         v-frame-width  = RECT-1:width IN FRAME Dialog-Frame
     2376         v-frame-left   = 0.5 + RECT-1:column   IN FRAME Dialog-Frame
     2377         v-frame-top    = 2 + RECT-1:row      IN FRAME Dialog-Frame
     2378         v-rect-width   = (v-frame-width - 2 ) / v-count-place
     2379         v-frame-bottom = RECT-1:row          IN FRAME Dialog-Frame + RECT-1:height   IN FRAME Dialog-Frame
     2380         v-step         = DECIMAL( v-max-qnty / (RECT-1:height IN FRAME Dialog-Frame - 3))
     2381      .
     2382      FOR EACH buf_tt-place:
     2383         assign
     2384            v-c = v-c + 1
     2385         .
     2386         CREATE RECTANGLE buf_tt-place.hnd-top
     2387         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - 1)
     2388                ROW           = v-frame-top + DECIMAL(( v-max-qnty - buf_tt-place.max-qnty) / v-step)
     2389                WIDTH         = v-rect-width
     2390                HEIGHT        = IF DECIMAL((buf_tt-place.max-qnty) / v-step ) <= 0 THEN 0.1 ELSE DECIMAL((buf_tt-place.max-qnty) / v-step )
     2391                FRAME         = FRAME Dialog-Frame:HANDLE
     2392                SENSITIVE     = FALSE
     2393                VISIBLE       = FALSE
     2394                FILLED        = TRUE
     2395         .
     2396         CREATE RECTANGLE buf_tt-place.hnd
     2397         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - 1)
     2398                ROW           = v-frame-top + DECIMAL(( v-max-qnty - buf_tt-place.curr-qnty) / v-step)
     2399                WIDTH         = v-rect-width
     2400                HEIGHT        = IF DECIMAL((buf_tt-place.curr-qnty) / v-step ) <= 0.1 THEN 0.1 ELSE DECIMAL((buf_tt-place.curr-qnty) / v-step )
     2401                BGCOLOR       = (v-c - 1)
     2402                FRAME         = FRAME Dialog-Frame:HANDLE
     2403                SENSITIVE     = FALSE
     2404                VISIBLE       = FALSE
     2405         .
     2406         CREATE TEXT buf_tt-place.hnd-name
     2407         ASSIGN COLUMN             = v-frame-left + v-rect-width * (v-c - 1)
     2408                row           = RECT-1:ROW + 0.2
     2409                FGCOLOR       = (v-c - 1)
     2410                FRAME         = FRAME Dialog-Frame:HANDLE
     2411                SENSITIVE     = FALSE
     2412                VISIBLE       = FALSE
     2413                width         = 15
     2414                data-type     = "character"
     2415                format        = "x(16)"
     2416                SCREEN-VALUE  = buf_tt-place.gds-name
     2417         .
     2418         CREATE TEXT buf_tt-place.hnd-max-qnty
     2419         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - 1) + 1
     2420                ROW           = MINIMUM( buf_tt-place.hnd-top:ROW - 0.7, buf_tt-place.hnd:ROW - 1.4)
     2421                FGCOLOR       = (v-c - 1)
     2422                FRAME         = FRAME Dialog-Frame:HANDLE
     2423                SENSITIVE     = FALSE
     2424                VISIBLE       = FALSE
     2425                width         = 9
     2426                data-type     = "character"
     2427                format        = "x(16)"
     2428                SCREEN-VALUE  = SUBSTITUTE("Max &1", buf_tt-place.max-qnty)
     2429         .
     2430         CREATE TEXT buf_tt-place.hnd-qnty
     2431         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - 1) + 1
     2432                ROW           = buf_tt-place.hnd:ROW - 0.7
     2433                FGCOLOR       = (v-c - 1)
     2434                BGCOLOR       = 15
     2435                FRAME         = FRAME Dialog-Frame:HANDLE
     2436                SENSITIVE     = FALSE
     2437                VISIBLE       = FALSE
     2438                width         = 9
     2439                data-type     = "character"
     2440                format        = "x(16)"
     2441                SCREEN-VALUE  = SUBSTITUTE("Тек &1", buf_tt-place.curr-qnty)
     2442         .
     2443      end.
     2444   end.
     2445   END PROCEDURE.
     2446   PROCEDURE draw-pred :
     2447   define variable v-frame-width    as integer      no-undo.
     2448   define variable v-frame-left     as integer      no-undo.
     2449   define variable v-frame-top   as integer      no-undo.
     2450   define variable v-rect-width    as integer      no-undo.
     2451   define variable v-c    as integer      no-undo.
     2452   DEFINE VARIABLE  but1  AS HANDLE.
     2453   define buffer buf_tt-place    for tt-place.
     2454   define buffer buf_tt-gds-pred     for tt-gds-pred.
     2455   do
     2456   on error undo, return error
     2457   :
     2458      assign
     2459         v-frame-width  = RECT-2:width IN FRAME Dialog-Frame
     2460         v-frame-left   = 0.5 + RECT-2:column   IN FRAME Dialog-Frame
     2461         v-frame-top    = RECT-2:row      IN FRAME Dialog-Frame
     2462         v-rect-width   = (v-frame-width - 2 ) / v-count-place
     2463      .
     2464      FOR EACH buf_tt-gds-pred:
     2465         assign
     2466            v-c = v-c + buf_tt-gds-pred.count-pl
     2467         .
     2468         CREATE RECTANGLE buf_tt-gds-pred.hnd
     2469         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl)
     2470                ROW           = v-frame-top - 0.25
     2471                WIDTH         = v-rect-width * count-pl
     2472                HEIGHT        = RECT-2:height - 0.5
     2473                BGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2474                FRAME         = FRAME Dialog-Frame:HANDLE
     2475                SENSITIVE     = FALSE
     2476                VISIBLE       = FALSE
     2477         .
     2478         CREATE TEXT buf_tt-gds-pred.hnd-name
     2479         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2480                row           = RECT-2:ROW + 0.7
     2481                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2482                FRAME         = FRAME Dialog-Frame:HANDLE
     2483                SENSITIVE     = FALSE
     2484                VISIBLE       = FALSE
     2485                width         = 15
     2486                data-type     = "character"
     2487                format        = "x(16)"
     2488                SCREEN-VALUE  = buf_tt-gds-pred.gds-name
     2489         .
     2490         CREATE TEXT buf_tt-gds-pred.hnd-sale-qnty-l
     2491         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2492                ROW           = RECT-2:ROW + 1.4
     2493                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2494                FRAME         = FRAME Dialog-Frame:HANDLE
     2495                SENSITIVE     = FALSE
     2496                VISIBLE       = FALSE
     2497                width         = 15
     2498                data-type     = "character"
     2499                format        = "x(16)"
     2500                SCREEN-VALUE  = "Реализация"
     2501         .
     2502         CREATE TEXT buf_tt-gds-pred.hnd-sale-qnty
     2503         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2504                ROW           = RECT-2:ROW + 2.1
     2505                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2506                FRAME         = FRAME Dialog-Frame:HANDLE
     2507                SENSITIVE     = FALSE
     2508                VISIBLE       = FALSE
     2509                width         = 15
     2510                data-type     = "character"
     2511                format        = "x(16)"
     2512                SCREEN-VALUE  = STRING( buf_tt-gds-pred.sale-qnty)
     2513         .
     2514         CREATE TEXT buf_tt-gds-pred.hnd-qnty-l
     2515         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2516                ROW           = RECT-2:ROW + 2.85
     2517                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2518                BGCOLOR       = 15
     2519                FRAME         = FRAME Dialog-Frame:HANDLE
     2520                SENSITIVE     = FALSE
     2521                VISIBLE       = FALSE
     2522                width         = 15
     2523                data-type     = "character"
     2524                format        = "x(16)"
     2525                SCREEN-VALUE  = "Остаток"
     2526         .
     2527         CREATE TEXT buf_tt-gds-pred.hnd-qnty
     2528         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2529                ROW           = RECT-2:ROW + 3.5
     2530                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2531                BGCOLOR       = 15
     2532                FRAME         = FRAME Dialog-Frame:HANDLE
     2533                SENSITIVE     = FALSE
     2534                VISIBLE       = FALSE
     2535                width         = 15
     2536                data-type     = "character"
     2537                format        = "x(16)"
     2538                SCREEN-VALUE  = STRING(buf_tt-gds-pred.curr-qnty)
     2539         .
     2540         CREATE TEXT buf_tt-gds-pred.hnd-pred-qnty-l
     2541         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2542                ROW           = RECT-2:ROW + 4.25
     2543                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2544                BGCOLOR       = 15
     2545                FRAME         = FRAME Dialog-Frame:HANDLE
     2546                SENSITIVE     = FALSE
     2547                VISIBLE       = FALSE
     2548                width         = 15
     2549                data-type     = "character"
     2550                format        = "x(16)"
     2551                SCREEN-VALUE  = "Прогноз"
     2552         .
     2553         CREATE TEXT buf_tt-gds-pred.hnd-pred-qnty
     2554         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2555                ROW           = RECT-2:ROW + 4.9
     2556                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2557                BGCOLOR       = 15
     2558                FRAME         = FRAME Dialog-Frame:HANDLE
     2559                SENSITIVE     = FALSE
     2560                VISIBLE       = FALSE
     2561                width         = 15
     2562                data-type     = "character"
     2563                format        = "x(16)"
     2564                SCREEN-VALUE  = STRING(buf_tt-gds-pred.prediction-qnty)
     2565         .
     2566         CREATE TEXT buf_tt-gds-pred.hnd-total-qnty-l
     2567         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2568                ROW           = RECT-2:ROW + 5.65
     2569                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2570                BGCOLOR       = 15
     2571                FRAME         = FRAME Dialog-Frame:HANDLE
     2572                SENSITIVE     = FALSE
     2573                VISIBLE       = FALSE
     2574                width         = 15
     2575                data-type     = "character"
     2576                format        = "x(16)"
     2577                SCREEN-VALUE  = "Итого"
     2578         .
     2579         CREATE TEXT buf_tt-gds-pred.hnd-total-qnty
     2580         ASSIGN COLUMN        = v-frame-left + v-rect-width * (v-c - buf_tt-gds-pred.count-pl) + 1
     2581                ROW           = RECT-2:ROW + 6.3
     2582                FGCOLOR       = (v-c - buf_tt-gds-pred.count-pl)
     2583                BGCOLOR       = 15
     2584                FRAME         = FRAME Dialog-Frame:HANDLE
     2585                SENSITIVE     = FALSE
     2586                VISIBLE       = FALSE
     2587                width         = 15
     2588                data-type     = "character"
     2589                format        = "x(16)"
     2590                SCREEN-VALUE  = SUBSTITUTE("&1", (IF (rs-prediction = 1)
     2591                                                   THEN (buf_tt-gds-pred.curr-qnty - buf_tt-gds-pred.prediction-qnty + buf_tt-gds-pred.sale-qnty)
     2592                                                   ELSE (buf_tt-gds-pred.curr-qnty - buf_tt-gds-pred.prediction-qnty))
     2593                                                   )
     2594         .
     2595      end.
     2596   end.
     2597   END PROCEDURE.
     2598   PROCEDURE enable_UI :
     2599     DISPLAY v-date-prediction rs-prediction v-hour-prediction v-minute-prediction
     2600             v-shift-num-prediction
     2601         WITH FRAME Dialog-Frame.
     2602     ENABLE b-quit b-help RECT-1 RECT-2 BROWSE-3 v-date-prediction b-sale
     2603            rs-prediction b-shift BROWSE-4
     2604         WITH FRAME Dialog-Frame.
     2605     VIEW FRAME Dialog-Frame.
     2606     OPEN QUERY BROWSE-3 FOR EACH br_tt-place.    OPEN QUERY BROWSE-4 FOR EACH br_tt-gds-pred.
     2607   END PROCEDURE.
     2608   PROCEDURE fill-place :
     2609   DEFINE BUFFER buf_place       FOR ub.place.
     2610   define buffer buf_rvs-doc     for ub.rvs-doc.
     2611   define buffer buf_rvs-line    for ub.rvs-line.
     2612   define buffer buf_rvs-line-pump     for ub.rvs-line-pump .
     2613   define buffer buf_goods       for ub.goods.
     2614   define buffer buf_pl-gds      for ub.pl-gds .
     2615   define buffer buf_tt-place    for tt-place.
     2616   define variable v-start-sale-qnty    as decimal      no-undo.
     2617   define variable v-found    as logical      no-undo.
     2618   define variable v-fill               as logical      no-undo.
     2619   do
     2620   on error undo, return error:
     2621      find first buf_rvs-doc
     2622         where  buf_rvs-doc.obj-type   = v-obj-type
     2623            and buf_rvs-doc.obj-code   = v-obj-code
     2624            and buf_rvs-doc.shift-date = v-shift-date-prev
     2625            and buf_rvs-doc.shift-num  = v-shift-num-prev
     2626            and buf_rvs-doc.status_    = 'факт':U
     2627            and buf_rvs-doc.rvs-type   = 'смена':U
     2628         no-lock
     2629         no-error
     2630         .
     2631      _place:
     2632      FOR EACH buf_place
     2633          WHERE buf_place.obj-type = v-obj-type
     2634            and buf_place.obj-code = v-obj-code
     2635          no-lock
     2636          :
     2637         find first buf_pl-gds
     2638              where buf_pl-gds.pl-code = buf_place.pl-code
     2639              no-lock
     2640              no-error
     2641              .
     2642         IF NOT AVAILABLE buf_pl-gds THEN do:
     2643            message
     2644               "Не найдена привязка товара к резервуару:" buf_place.pl-code
     2645               skip
     2646            view-as alert-box information.
     2647            NEXT _place.
     2648         end.
     2649         find first buf_goods
     2650            where buf_goods.gds-code = buf_pl-gds.gds-code
     2651            no-lock
     2652            no-error
     2653            .
     2654         IF NOT AVAILABLE buf_goods THEN do:
     2655            message
     2656               "Не найден товар " buf_pl-gds.gds-code
     2657               "для резервуара "  buf_place.pl-code
     2658               skip
     2659            view-as alert-box information.
     2660            NEXT _place.
     2661         end.
     2662         CREATE buf_tt-place.
     2663         assign
     2664            buf_tt-place.gds-code   = buf_goods.gds-code
     2665            buf_tt-place.pl-code    = buf_place.pl-code
     2666            buf_tt-place.max-qnty   = buf_place.max-qnty
     2667            buf_tt-place.loc1       = buf_place.loc1
     2668            buf_tt-place.gds-name   = buf_goods.gds-name
     2669            v-count-place           = v-count-place + 1
     2670            v-max-qnty             = IF v-max-qnty > buf_place.max-qnty THEN v-max-qnty ELSE buf_place.max-qnty
     2671         .
     2672         assign
     2673            v-start-sale-qnty = 0.0
     2674         .
     2675         FOR EACH   buf_rvs-line-pump
     2676              WHERE buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     2677                and buf_rvs-line-pump.obj-type = buf_rvs-doc.obj-type
     2678                and buf_rvs-line-pump.obj-code = buf_rvs-doc.obj-code
     2679                and buf_rvs-line-pump.pl-code  = buf_place.pl-code
     2680                and buf_rvs-line-pump.gds-code = buf_goods.gds-code
     2681              NO-LOCK
     2682              :
     2683              ASSIGN
     2684                  v-start-sale-qnty = v-start-sale-qnty + buf_rvs-line-pump.state-mh-cnt
     2685              .
     2686         END.
     2687         ASSIGN
     2688            buf_tt-place.sale-start-qnty = v-start-sale-qnty
     2689            buf_tt-place.sale-qnty-curr  = buf_tt-place.sale-qnty-curr - v-start-sale-qnty
     2690         .
     2691         FIND FIRST buf_rvs-line
     2692               WHERE buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2693                  and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     2694                  and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     2695                  and buf_rvs-line.pl-code  = buf_tt-place.pl-code
     2696                  and buf_rvs-line.gds-code = buf_tt-place.gds-code
     2697            NO-LOCK
     2698            no-error
     2699            .
     2700         IF  AVAILABLE buf_rvs-line
     2701         then do:
     2702            assign
     2703               buf_tt-place.curr-qnty-start        = buf_rvs-line.state-measure-qnty
     2704            .
     2705         end.
     2706      END.
     2707      IF NOT CAN-FIND( FIRST buf_rvs-doc
     2708         where buf_rvs-doc.obj-type   = v-obj-type
     2709           and buf_rvs-doc.obj-code   = v-obj-code
     2710           and buf_rvs-doc.shift-date = v-shift-date
     2711           and buf_rvs-doc.shift-num  = v-shift-num
     2712           and buf_rvs-doc.status_    = 'факт':U
     2713           and buf_rvs-doc.rvs-type   = 'контроль':U
     2714           )
     2715      THEN DO:
     2716         message
     2717            "В текущей смене нет контрольных сверок"
     2718            skip
     2719         view-as alert-box error.
     2720         return error.
     2721      END.
     2722      FOR each buf_rvs-doc
     2723         where buf_rvs-doc.obj-type   = v-obj-type
     2724           and buf_rvs-doc.obj-code   = v-obj-code
     2725           and buf_rvs-doc.shift-date = v-shift-date
     2726           and buf_rvs-doc.shift-num  = v-shift-num
     2727           and buf_rvs-doc.status_    = 'факт':U
     2728           and buf_rvs-doc.rvs-type   = 'контроль':U
     2729           use-index shift
     2730         no-lock
     2731         :
     2732         FOR EACH  buf_tt-place
     2733             :
     2734             IF  buf_tt-place.sale-fact-order < buf_rvs-doc.fact-order THEN DO:
     2735                  assign
     2736                     v-found = FALSE
     2737                  .
     2738                  FOR EACH buf_rvs-line-pump
     2739                        WHERE   buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     2740                           and  buf_rvs-line-pump.obj-type = buf_rvs-doc.obj-type
     2741                           and  buf_rvs-line-pump.obj-code = buf_rvs-doc.obj-code
     2742                           and  buf_rvs-line-pump.pl-code  = buf_tt-place.pl-code
     2743                           and  buf_rvs-line-pump.gds-code = buf_tt-place.gds-code
     2744                  :
     2745                     IF v-found = FALSE THEN DO:
     2746                        assign
     2747                           v-found = TRUE
     2748                           buf_tt-place.sale-qnty-curr = 0
     2749                        .
     2750                     END.
     2751                     assign
     2752                        buf_tt-place.sale-fact-order  = buf_rvs-doc.fact-order
     2753                        buf_tt-place.sale-qnty-curr   = buf_tt-place.sale-qnty-curr + buf_rvs-line-pump.state-mh-cnt
     2754                        buf_tt-place.sale-time        = buf_rvs-doc.fact-time
     2755                        buf_tt-place.sale-fill        = TRUE
     2756                     .
     2757                  END.
     2758                  IF v-found = TRUE THEN DO:
     2759                        assign
     2760                           buf_tt-place.sale-qnty-curr = buf_tt-place.sale-qnty-curr - buf_tt-place.sale-start-qnty
     2761                        .
     2762                  END.
     2763             END.
     2764         end.
     2765         FOR EACH  buf_tt-place
     2766             where buf_tt-place.curr-fill     = FALSE
     2767              :
     2768               FIND FIRST buf_rvs-line
     2769                    WHERE buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2770                      and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     2771                      and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     2772                      and buf_rvs-line.pl-code  = buf_tt-place.pl-code
     2773                      and buf_rvs-line.gds-code = buf_tt-place.gds-code
     2774                  NO-LOCK
     2775                  no-error
     2776                  .
     2777               IF  AVAILABLE buf_rvs-line
     2778               AND buf_tt-place.curr-fact-order < buf_rvs-doc.fact-order
     2779               then do:
     2780                  assign
     2781                     buf_tt-place.curr-qnty        = buf_rvs-line.state-measure-qnty
     2782                     buf_tt-place.curr-fact-order  = buf_rvs-doc.fact-order
     2783                     buf_tt-place.free-qnty        = buf_tt-place.max-qnty - buf_rvs-line.state-measure-qnty
     2784                     buf_tt-place.curr-fill        = TRUE
     2785                     v-max-qnty                    = IF v-max-qnty > buf_tt-place.curr-qnty THEN v-max-qnty ELSE buf_tt-place.curr-qnty
     2786                  .
     2787               end.
     2788         end.
     2789      END.
     2790      IF can-find(FIRST buf_tt-place
     2791                  WHERE buf_tt-place.sale-fill = FALSE
     2792                  )
     2793      OR can-find(FIRST buf_tt-place
     2794                  WHERE buf_tt-place.curr-fill = FALSE
     2795                  )
     2796      THEN DO:
     2797         message
     2798                 "Не все топливные товары,"
     2799            skip "привязанные к резервуарам и ТРК,"
     2800            skip "присутствуют в сверках текущей смены."
     2801         view-as alert-box information.
     2802      end.
     2803      FOR EACH  buf_tt-place
     2804          WHERE buf_tt-place.sale-fill = FALSE
     2805          :
     2806          assign
     2807            buf_tt-place.sale-qnty-curr = 0.0
     2808          .
     2809      end.
     2810      FOR EACH  buf_tt-place
     2811          WHERE buf_tt-place.curr-fill = FALSE
     2812          :
     2813            assign
     2814               buf_tt-place.curr-qnty        = buf_tt-place.curr-qnty-start
     2815            .
     2816      end.
     2817   END.
     2818   END PROCEDURE.
     2819   PROCEDURE fill-prediction :
     2820   define buffer buf_rvs-doc     for ub.rvs-doc.
     2821   define buffer buf_rvs-line    for ub.rvs-line.
     2822   define buffer buf_rvs-line-pump    for ub.rvs-line-pump.
     2823   define buffer buf_tt-place    for tt-place.
     2824   define buffer buf_tt-gds-pred for tt-gds-pred.
     2825   define buffer buf_shift-obj      for ub.shift-obj .
     2826   define variable v-end-qnty-prev  as decimal      no-undo.
     2827   define variable v-sale-qnty-prev   as decimal      no-undo.
     2828   define variable v-meas-date-pred   as date         no-undo.
     2829   define variable v-meas-time-pred   as integer      no-undo.
     2830   define variable v-time             as integer init 999999     no-undo.
     2831   define variable v-delta-time       as integer      no-undo.
     2832   define variable v-delta-time-end       as integer      no-undo.
     2833   define variable v-rvs-code         as character    no-undo.
     2834   define variable v-found    as logical      no-undo.
     2835   define variable v-found-control    as logical      no-undo.
     2836   define variable v-found-control-end    as logical      no-undo.
     2837   do
     2838   on error undo, return error
     2839   :
     2840      FIND LAST  buf_shift-obj
     2841           WHERE buf_shift-obj.obj-type = v-obj-type
     2842             AND buf_shift-obj.obj-code = v-obj-code
     2843             AND ((    buf_shift-obj.shift-date = v-shift-date-prediction
     2844                   AND buf_shift-obj.shift-num  < v-shift-num-prediction
     2845                  )
     2846                  OR   buf_shift-obj.shift-date < v-shift-date-prediction
     2847                 )
     2848           use-index pi
     2849           no-lock
     2850           NO-ERROR.
     2851      if available buf_shift-obj then do:
     2852         find first buf_rvs-doc
     2853            where buf_rvs-doc.obj-type = v-obj-type
     2854            and buf_rvs-doc.obj-code   = v-obj-code
     2855            and buf_rvs-doc.shift-date = buf_shift-obj.shift-date
     2856            and buf_rvs-doc.shift-num  = buf_shift-obj.shift-num
     2857            and buf_rvs-doc.status_    = 'факт':U
     2858            and buf_rvs-doc.rvs-type   = 'смена':U
     2859            no-lock
     2860            .
     2861         FOR EACH   buf_tt-place,
     2862             each   buf_rvs-line-pump
     2863              WHERE buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     2864                and buf_rvs-line-pump.obj-type = buf_rvs-doc.obj-type
     2865                and buf_rvs-line-pump.obj-code = buf_rvs-doc.obj-code
     2866                and buf_rvs-line-pump.pl-code  = buf_tt-place.pl-code
     2867                and buf_rvs-line-pump.gds-code = buf_tt-place.gds-code
     2868              NO-LOCK
     2869              :
     2870               assign
     2871                  buf_tt-place.sale-start-qnty-prev = buf_tt-place.sale-start-qnty-prev + buf_rvs-line-pump.state-mh-cnt
     2872               .
     2873         END.
     2874      end.
     2875      FOR each buf_rvs-doc
     2876         where buf_rvs-doc.obj-type   = v-obj-type
     2877           and buf_rvs-doc.obj-code   = v-obj-code
     2878           and buf_rvs-doc.shift-date = v-shift-date-prediction
     2879           and buf_rvs-doc.shift-num  = v-shift-num-prediction
     2880           and buf_rvs-doc.status_    = 'факт':U
     2881           and (buf_rvs-doc.rvs-type   = 'контроль':U
     2882            OR buf_rvs-doc.rvs-type   = 'смена':U)
     2883         no-lock
     2884         :
     2885         IF NOT v-found-control THEN DO:
     2886            assign
     2887               v-found-control = TRUE
     2888            .
     2889         END.
     2890         FOR EACH  buf_tt-place
     2891             :
     2892             IF   ABS(buf_tt-place.sale-time - buf_rvs-doc.fact-time)
     2893               < ABS(buf_tt-place.sale-time - buf_tt-place.sale-time-prev)
     2894             THEN DO:
     2895                  assign
     2896                     v-found = FALSE
     2897                  .
     2898                  FOR EACH buf_rvs-line-pump
     2899                        WHERE   buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     2900                           and  buf_rvs-line-pump.obj-type = buf_rvs-doc.obj-type
     2901                           and  buf_rvs-line-pump.obj-code = buf_rvs-doc.obj-code
     2902                           and  buf_rvs-line-pump.pl-code  = buf_tt-place.pl-code
     2903                           and  buf_rvs-line-pump.gds-code = buf_tt-place.gds-code
     2904                  :
     2905                     IF v-found = FALSE THEN DO:
     2906                        assign
     2907                           v-found = TRUE
     2908                           buf_tt-place.sale-qnty-prev = 0
     2909                        .
     2910                     END.
     2911                     assign
     2912                        buf_tt-place.sale-qnty-prev   = buf_tt-place.sale-qnty-prev + buf_rvs-line-pump.state-mh-cnt
     2913                        buf_tt-place.sale-time-prev   = buf_rvs-doc.fact-time
     2914                        v-delta-time = IF (buf_tt-place.sale-time - buf_tt-place.sale-time-prev) > v-delta-time THEN (buf_tt-place.sale-time - buf_tt-place.sale-time-prev) ELSE v-delta-time
     2915                        v-start-time-prediction  = buf_tt-place.sale-time-prev
     2916                     .
     2917                  END.
     2918                  IF v-found = TRUE THEN DO:
     2919                        assign
     2920                           buf_tt-place.sale-qnty-prev = buf_tt-place.sale-qnty-prev - buf_tt-place.sale-start-qnty-prev
     2921                        .
     2922                  END.
     2923             END.
     2924         end.
     2925      end.
     2926      IF NOT v-found-control then do:
     2927         message
     2928            "В смене, заданной для прогноза, нет контрольных сверок"
     2929            skip
     2930         view-as alert-box information.
     2931         return .
     2932      end.
     2933      IF v-delta-time > 1800 then do:
     2934         message
     2935            "В смене, заданной для прогноза, контрольная сверка"
     2936            "отстоит по времени от точки начала прогноза более чем на 30 минут"
     2937            skip
     2938         view-as alert-box information.
     2939      end.
     2940      _buf_rvs-line-pump:
     2941      for EACH buf_rvs-line-pump
     2942         WHERE buf_rvs-line-pump.rvs-code = v-rvs-code
     2943         NO-LOCK
     2944         :
     2945         find first buf_tt-place
     2946              where buf_tt-place.gds-code = buf_rvs-line-pump.gds-code
     2947                and buf_tt-place.pl-code  = buf_rvs-line-pump.pl-code
     2948                no-error
     2949                .
     2950         IF NOT available buf_tt-place then do:
     2951            next _buf_rvs-line-pump.
     2952         end.
     2953         assign
     2954            buf_tt-place.sale-qnty-prev = buf_rvs-line-pump.state-mh-cnt
     2955         .
     2956      END.
     2957      CASE rs-prediction :
     2958      WHEN 1 THEN DO:
     2959         find first buf_rvs-doc
     2960            where buf_rvs-doc.obj-type = v-obj-type
     2961            and buf_rvs-doc.obj-code   = v-obj-code
     2962            and buf_rvs-doc.shift-date = v-shift-date-prediction
     2963            and buf_rvs-doc.shift-num  = v-shift-num-prediction
     2964            and buf_rvs-doc.status_    = 'факт':U
     2965            and buf_rvs-doc.rvs-type   = 'смена':U
     2966            no-lock
     2967            .
     2968            assign
     2969               v-found-control-end = TRUE
     2970            .
     2971         FOR EACH   buf_tt-place
     2972         :
     2973            FOR each buf_rvs-line-pump
     2974               WHERE buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     2975                 and buf_rvs-line-pump.obj-type = buf_rvs-doc.obj-type
     2976                 and buf_rvs-line-pump.obj-code = buf_rvs-doc.obj-code
     2977                 and buf_rvs-line-pump.pl-code  = buf_tt-place.pl-code
     2978                 and buf_rvs-line-pump.gds-code = buf_tt-place.gds-code
     2979               NO-LOCK
     2980               :
     2981               assign
     2982                  buf_tt-place.sale-end-qnty-prev = buf_tt-place.sale-end-qnty-prev + buf_rvs-line-pump.state-mh-cnt
     2983               .
     2984            END.
     2985            assign
     2986               buf_tt-place.sale-end-qnty-prev = buf_tt-place.sale-end-qnty-prev - buf_tt-place.sale-start-qnty-prev
     2987            .
     2988         END.
     2989      END.
     2990      OTHERWISE DO:
     2991         FOR each buf_rvs-doc
     2992            where buf_rvs-doc.obj-type   = v-obj-type
     2993            and buf_rvs-doc.obj-code   = v-obj-code
     2994            and buf_rvs-doc.shift-date = v-shift-date-prediction
     2995            and buf_rvs-doc.shift-num  = v-shift-num-prediction
     2996            and buf_rvs-doc.status_    = 'факт':U
     2997            and (buf_rvs-doc.rvs-type  = 'контроль':U
     2998                  OR
     2999                  buf_rvs-doc.rvs-type   = 'смена':U)
     3000            no-lock
     3001            :
     3002            IF NOT v-found-control-end THEN DO:
     3003               assign
     3004                  v-found-control-end = TRUE
     3005               .
     3006            END.
     3007            FOR EACH  buf_tt-place
     3008               :
     3009               IF  ABS(v-end-time-prediction - buf_rvs-doc.fact-time)
     3010                  < ABS(v-end-time-prediction - buf_tt-place.sale-time-prev-end)
     3011               THEN DO:
     3012                     assign
     3013                        v-found = FALSE
     3014                     .
     3015                     FOR EACH buf_rvs-line-pump
     3016                           WHERE   buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     3017                              and  buf_rvs-line-pump.obj-type = buf_rvs-doc.obj-type
     3018                              and  buf_rvs-line-pump.obj-code = buf_rvs-doc.obj-code
     3019                              and  buf_rvs-line-pump.pl-code  = buf_tt-place.pl-code
     3020                              and  buf_rvs-line-pump.gds-code = buf_tt-place.gds-code
     3021                     :
     3022                        IF v-found = FALSE THEN DO:
     3023                           assign
     3024                              v-found = TRUE
     3025                              buf_tt-place.sale-end-qnty-prev = 0
     3026                           .
     3027                        END.
     3028                        assign
     3029                           buf_tt-place.sale-end-qnty-prev   = buf_tt-place.sale-end-qnty-prev + buf_rvs-line-pump.state-mh-cnt
     3030                           buf_tt-place.sale-time-prev-end   = buf_rvs-doc.fact-time
     3031                           v-delta-time-end = IF (buf_tt-place.sale-time - buf_tt-place.sale-time-prev-end) > v-delta-time THEN (buf_tt-place.sale-time - buf_tt-place.sale-time-prev-end) ELSE v-delta-time-end
     3032                        .
     3033                     END.
     3034                     IF v-found = TRUE THEN DO:
     3035                           assign
     3036                              buf_tt-place.sale-end-qnty-prev = buf_tt-place.sale-end-qnty-prev - buf_tt-place.sale-start-qnty-prev
     3037                           .
     3038                     END.
     3039               END.
     3040            end.
     3041         end.
     3042      END.
     3043      END CASE.
     3044      IF NOT v-found-control-end then do:
     3045         message
     3046            "В смене, заданной для прогноза, нет контрольных сверок"
     3047            skip
     3048         view-as alert-box information.
     3049         return .
     3050      end.
     3051      IF v-delta-time-end > 1800 then do:
     3052         message
     3053            "В смене, заданной для прогноза, контрольная сверка"
     3054            "отстоит по времени от точки начала прогноза более чем на 30 минут"
     3055            skip v-delta-time
     3056         view-as alert-box information.
     3057      end.
     3058      define variable v-delta    as integer      no-undo.
     3059      for each buf_tt-place
     3060          no-lock
     3061          break by buf_tt-place.gds-code
     3062          :
     3063        assign
     3064           v-end-qnty-prev   = v-end-qnty-prev  + buf_tt-place.sale-end-qnty-prev
     3065           v-sale-qnty-prev  = v-sale-qnty-prev   + buf_tt-place.sale-qnty-prev
     3066           v-delta           = IF (v-delta > ABS((buf_tt-place.sale-time-prev - buf_tt-place.sale-time) / 60)) THEN v-delta ELSE ABS((buf_tt-place.sale-time-prev - buf_tt-place.sale-time) / 60)
     3067           v-time            = IF (v-time > buf_tt-place.sale-time) THEN buf_tt-place.sale-time ELSE v-time
     3068        .
     3069        IF LAST-OF(buf_tt-place.gds-code) then do:
     3070           find first buf_tt-gds-pred
     3071                where buf_tt-gds-pred.gds-code = buf_tt-place.gds-code
     3072                no-lock
     3073                .
     3074                  IF v-sale-qnty-prev = 0 THEN message
     3075                     SUBSTITUTE("Для топлива &1 невозможно рассчитать прогноз", buf_tt-gds-pred.gds-name)
     3076                     skip
     3077                  view-as alert-box information.
     3078                  assign
     3079                     buf_tt-gds-pred.prediction-qnty  = IF (rs-prediction = 1) THEN  v-end-qnty-prev                     * buf_tt-gds-pred.sale-qnty / v-sale-qnty-prev
     3080                                                                               ELSE (v-end-qnty-prev - v-sale-qnty-prev) * buf_tt-gds-pred.sale-qnty / v-sale-qnty-prev
     3081                     buf_tt-gds-pred.delta-time = v-delta
     3082                     buf_tt-gds-pred.sale-time = v-time
     3083                     v-sale-qnty-prev   = 0.0
     3084                     v-end-qnty-prev    = 0.0
     3085                     v-delta            = 0
     3086                     v-time             = 999999
     3087                  .
     3088        end.
     3089      end.
     3090   end.
     3091   END PROCEDURE.
     3092   PROCEDURE fill-sale :
     3093   define buffer buf_rvs-doc     for ub.rvs-doc.
     3094   define buffer buf_rvs-line    for ub.rvs-line.
     3095   define buffer buf_rvs-line-pump    for ub.rvs-line-pump.
     3096   DEFINE BUFFER buf_place       FOR ub.place.
     3097   define buffer buf_goods       for ub.goods.
     3098   define buffer buf_tt-place    for tt-place.
     3099   define buffer buf_tt-gds-pred for tt-gds-pred.
     3100   define variable v-counter     as integer      no-undo.
     3101   define variable v-start-qnty  as decimal      no-undo.
     3102   define variable v-sale-qnty   as decimal      no-undo.
     3103   define variable v-curr-qnty   as decimal      no-undo.
     3104   define variable v-rvs-code    as character      no-undo.
     3105   do
     3106   on error undo, return error
     3107   :
     3108      assign
     3109         v-counter = 0
     3110      .
     3111      for each buf_tt-place
     3112         no-lock
     3113         break by buf_tt-place.gds-code
     3114         :
     3115         assign
     3116            v-counter      = v-counter + 1
     3117            v-start-qnty   = v-start-qnty  + buf_tt-place.curr-qnty
     3118            v-sale-qnty    = v-sale-qnty   + buf_tt-place.sale-qnty-curr
     3119            v-curr-qnty    = v-curr-qnty   + buf_tt-place.curr-qnty
     3120         .
     3121         IF LAST-OF(buf_tt-place.gds-code) then do:
     3122            create buf_tt-gds-pred.
     3123            assign
     3124               buf_tt-gds-pred.gds-code   = buf_tt-place.gds-code
     3125               buf_tt-gds-pred.gds-name   = buf_tt-place.gds-name
     3126               buf_tt-gds-pred.start-qnty = v-start-qnty
     3127               buf_tt-gds-pred.sale-qnty  = v-sale-qnty
     3128               buf_tt-gds-pred.curr-qnty  = v-curr-qnty
     3129               buf_tt-gds-pred.count-pl   = v-counter
     3130               v-start-qnty       = 0.0
     3131               v-sale-qnty        = 0.0
     3132               v-curr-qnty        = 0.0
     3133               v-counter          = 0
     3134            .
     3135         end.
     3136      end.
     3137   end.
     3138   END PROCEDURE.
     3139   PROCEDURE find-date-shift :
     3140   define input parameter p-obj-type as character no-undo .
     3141   define input parameter p-obj-code as integer no-undo .
     3142   define input parameter p-date as date no-undo .
     3143   define input parameter p-time as integer no-undo .
     3144   define output parameter p-shift-date as date no-undo .
     3145   define output parameter p-shift-num as integer no-undo .
     3146   define buffer buf_shift-obj      for ub.shift-obj.
     3147   define variable v-fact-order    as decimal      no-undo.
     3148   do
     3149   on error undo, return error
     3150   :
     3151      run  day-begin-fact-order in this-procedure
     3152           ( input p-date
     3153           , output v-fact-order
     3154           ) .
     3155      for each  buf_shift-obj
     3156         where buf_shift-obj.obj-type = p-obj-type
     3157            and buf_shift-obj.obj-code =  p-obj-code
     3158            and buf_shift-obj.fact-order >= v-fact-order
     3159            and (buf_shift-obj.open-date < p-date
     3160               or (buf_shift-obj.open-date = p-date
     3161                  and buf_shift-obj.open-time > p-time))
     3162            and (buf_shift-obj.close-date > p-date
     3163               or (buf_shift-obj.close-date = p-date
     3164                  and buf_shift-obj.close-time > p-time))
     3165            and buf_shift-obj.status_ = 'зкр':U
     3166         no-lock
     3167         :
     3168         assign
     3169            p-shift-date = buf_shift-obj.shift-date
     3170            p-shift-num  = buf_shift-obj.shift-num
     3171         .
     3172         return .
     3173      end.
     3174   end.
     3175   END PROCEDURE.
     3176   PROCEDURE mandatory-24 :
     3177   DEFINE INPUT-OUTPUT PARAMETER p-time AS INTEGER NO-UNDO .
     3178   DO
     3179   ON error undo, RETURN:
     3180      IF p-time > 23 THEN DO:
     3181          ASSIGN
     3182              p-time = 23
     3183          .
     3184          RETURN .
     3185      END.
     3186      IF p-time < 0 THEN DO:
     3187          ASSIGN
     3188              p-time = 0
     3189          .
     3190          RETURN .
     3191      END.
     3192   END.
     3193   END PROCEDURE.
     3194   PROCEDURE mandatory-60 :
     3195   DEFINE INPUT-OUTPUT PARAMETER p-time AS INTEGER NO-UNDO .
     3196   DO
     3197   ON error undo, RETURN:
     3198      IF p-time > 59 THEN DO:
     3199          ASSIGN
     3200              p-time = 59
     3201          .
     3202          RETURN .
     3203      END.
     3204      IF p-time < 0 THEN DO:
     3205          ASSIGN
     3206              p-time = 0
     3207          .
     3208          RETURN .
     3209      END.
     3210   END.
     3211   END PROCEDURE.
     3212   PROCEDURE select-shift :
     3213   define variable v-ok    as logical      no-undo.
     3214   define variable v-shift-list    as character    no-undo.
     3215   define buffer buf_rvs-doc     for ub.rvs-doc .
     3216   define buffer buf_shift-obj      for ub.shift-obj.
     3217   do
     3218   on error undo, return error
     3219   :
     3220      _shift:
     3221      do
     3222      on error undo, retry
     3223      :
     3224         assign
     3225            v-ok = false
     3226         .
     3227         run str/sht-all.w ( parparentproc
     3228                           , v-obj-type
     3229                           , v-obj-code
     3230                           , "b-sel"
     3231                           , "obj"
     3232                           , v-obj-type
     3233                           , v-obj-code
     3234                           , ""
     3235                           , input-output v-shift-list
     3236                           ) no-error.
     3237         IF error-status:error
     3238         THEN do:
     3239            message
     3240               vss-workfile vss-revision vss-description skip
     3241               "Ошибка при выборе смены"  skip
     3242               error-status :get-message( 1 ) skip
     3243               return-value skip
     3244            view-as alert-box error .
     3245            return no-apply.
     3246         end.
     3247         IF v-shift-list =  "":U
     3248         THEN do:
     3249            return no-apply.
     3250         end.
     3251         find first buf_shift-obj
     3252            where recid (buf_shift-obj) = integer (entry(1,v-shift-list))
     3253            no-lock
     3254            .
     3255         IF buf_shift-obj.status_ = 'тек':U
     3256         then do:
     3257            message
     3258               "Выбранная смена не закрыта" skip
     3259               "Выбрать другую ?"
     3260               view-as alert-box error
     3261               buttons YES-NO
     3262               update v-ok
     3263               .
     3264            IF v-ok then dO:
     3265               undo _shift, retry _shift.
     3266            end.
     3267            else do:
     3268               return no-apply.
     3269            end.
     3270         end.
     3271      END.
     3272      find first buf_rvs-doc
     3273         where buf_rvs-doc.obj-type    = v-obj-type
     3274            and buf_rvs-doc.obj-code   = v-obj-code
     3275            and buf_rvs-doc.shift-date = buf_shift-obj.shift-date
     3276            and buf_rvs-doc.shift-num  = buf_shift-obj.shift-num
     3277            and buf_rvs-doc.status_    = 'факт':U
     3278            and buf_rvs-doc.rvs-type   = 'смена':U
     3279         no-lock
     3280         no-error
     3281         .
     3282      Assign
     3283         v-date-prediction       = buf_shift-obj.shift-date
     3284         v-shift-date-prediction = buf_shift-obj.shift-date
     3285         v-shift-num-prediction  = buf_shift-obj.shift-num
     3286         v-end-time-prediction   = IF ( rs-prediction = 1 ) THEN buf_rvs-doc.fact-time ELSE v-end-time-prediction
     3287         v-end-time-prediction-shift = buf_rvs-doc.fact-time
     3288      .
     3289      release buf_shift-obj.
     3290   end.
     3291   END PROCEDURE.
     3292   PROCEDURE show-browser :
     3293   do
     3294   on error undo, return error
     3295   WITH FRAME Dialog-Frame
     3296   :
     3297     define buffer buf_tt-place     for tt-place.
     3298     define buffer buf_tt-gds-pred     for tt-gds-pred.
     3299     HIDE rect-1.
     3300     HIDE rect-2.
     3301     FOR EACH buf_tt-place :
     3302         hide
     3303            buf_tt-place.hnd
     3304            buf_tt-place.hnd-top
     3305            buf_tt-place.hnd-qnty
     3306            buf_tt-place.hnd-max-qnty
     3307            buf_tt-place.hnd-name
     3308         .
     3309     END.
     3310     FOR EACH buf_tt-gds-pred :
     3311         hide
     3312            buf_tt-gds-pred.hnd
     3313            buf_tt-gds-pred.hnd-name
     3314            buf_tt-gds-pred.hnd-qnty
     3315            buf_tt-gds-pred.hnd-sale-qnty
     3316            buf_tt-gds-pred.hnd-pred-qnty
     3317            buf_tt-gds-pred.hnd-total-qnty
     3318            buf_tt-gds-pred.hnd-qnty-l
     3319            buf_tt-gds-pred.hnd-sale-qnty-l
     3320            buf_tt-gds-pred.hnd-pred-qnty-l
     3321            buf_tt-gds-pred.hnd-total-qnty-l
     3322         .
     3323     END.
     3324     DISPLAY
     3325         BROWSE-3
     3326         BROWSE-4
     3327     .
     3328   end.
     3329   END PROCEDURE.
     3330   PROCEDURE show-histogramm :
     3331   do
     3332   on error undo, return error
     3333   WITH FRAME Dialog-Frame
     3334   :
     3335     define buffer buf_tt-place     for tt-place.
     3336     define buffer buf_tt-gds-pred     for tt-gds-pred.
     3337     HIDE browse-3.
     3338     HIDE browse-4.
     3339     DISPLAY
     3340         RECT-1
     3341         RECT-2
     3342         .
     3343     FOR EACH buf_tt-place :
     3344         Assign
     3345               buf_tt-place.hnd-name      :HIDDEN = FALSE
     3346               buf_tt-place.hnd-max-qnty  :HIDDEN = FALSE
     3347               buf_tt-place.hnd-qnty      :HIDDEN = FALSE
     3348               buf_tt-place.hnd-top       :HIDDEN = FALSE
     3349               buf_tt-place.hnd           :HIDDEN = FALSE
     3350         .
     3351     END.
     3352     FOR EACH buf_tt-gds-pred :
     3353         assign
     3354            buf_tt-gds-pred.hnd           :HIDDEN = FALSE
     3355            buf_tt-gds-pred.hnd-name      :HIDDEN = FALSE
     3356            buf_tt-gds-pred.hnd-qnty      :HIDDEN = FALSE
     3357            buf_tt-gds-pred.hnd-sale-qnty :HIDDEN = FALSE
     3358            buf_tt-gds-pred.hnd-pred-qnty :HIDDEN = FALSE
     3359            buf_tt-gds-pred.hnd-total-qnty :HIDDEN = FALSE
     3360            buf_tt-gds-pred.hnd-qnty-l      :HIDDEN = FALSE
     3361            buf_tt-gds-pred.hnd-sale-qnty-l :HIDDEN = FALSE
     3362            buf_tt-gds-pred.hnd-pred-qnty-l :HIDDEN = FALSE
     3363            buf_tt-gds-pred.hnd-total-qnty-l :HIDDEN = FALSE
     3364         .
     3365     END.
     3366   end.
     3367   END PROCEDURE.
