        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Мониторинг остатков резервуаров и прогноз реализации".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114     define variable v-cntxt-db-num        as integer   no-undo .
      115     define variable v-cntxt-userid        as character no-undo .
      116     define variable v-cntxt-level         as character no-undo .
      117     define variable v-cntxt-host-code-obj as integer   no-undo .
      118     define variable v-cntxt-obj-type      as character no-undo .
      119     define variable v-cntxt-obj-code      as integer   no-undo .
      120     define variable v-cntxt-db-num-obj    as integer   no-undo .
      121     define variable v-cntxt-is-admin      as logical   no-undo .
      122   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   procedure factord :
      124     define input  parameter p-fact-date            as date    no-undo .
      125     define input  parameter p-fact-time            as integer no-undo .
      126     define input  parameter p-fact-num             as integer no-undo .
      127     define input  parameter p-shift-date           as date    no-undo .
      128     define input  parameter p-shift-num            as integer no-undo .
      129     define input  parameter p-shift-on             as logical no-undo .
      130     define output parameter p-fact-order           as decimal no-undo .
      131     define output parameter p-shift-end-fact-order as decimal no-undo .
      132     define output parameter p-day-end-fact-order   as decimal no-undo .
      133     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      134     if p-fact-date = ?
      135     then do:
      136       return error "Не указана фактическая дата" .
      137     end.
      138     define variable v-fact-date-num as integer no-undo .
      139     assign
      140       v-fact-date-num = integer(p-fact-date)
      141     .
      142     if p-fact-num = ?
      143     or p-fact-num = 0
      144     then do:
      145       return error "Не задан p-fact-num " + string(p-fact-num) .
      146     end.
      147     if p-fact-num < 0
      148     then do:
      149       return error "Отрицательный fact-num " + string(p-fact-num) .
      150     end.
      151     if p-fact-num >= 100000000
      152     then do:
      153       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      154     end.
      155     if p-shift-on = true
      156     then do:
      157       if p-shift-date = ?
      158       then do:
      159         return error "Не задана дата смены" .
      160       end.
      161       if p-shift-num = ?
      162       or p-shift-num = 0
      163       then do:
      164         return error "Не задан номер смены" .
      165       end.
      166     end.
      167     else do:
      168       assign
      169         p-shift-date = p-fact-date
      170         p-shift-num  = 24
      171       .
      172     end.
      173     define variable v-shift-offset as integer no-undo .
      174     if p-shift-date = p-fact-date
      175     then do:
      176       assign
      177         v-shift-offset = 1
      178       .
      179     end.
      180     if p-shift-date < p-fact-date
      181     then do:
      182       assign
      183         v-shift-offset = 0
      184       .
      185     end.
      186     if p-shift-date > p-fact-date
      187     then do:
      188       message
      189         vss-workfile vss-revision vss-description skip
      190         "Неправильная дата закрытия смены" skip
      191         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      192         view-as alert-box error .
      193       undo, return error
      194         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      195           ,string(p-fact-date, '99/99/9999':U)
      196           ,string(p-shift-date, '99/99/9999':U)
      197           )
      198       .
      199     end.
      200     if p-shift-num < 1
      201     or p-shift-num > 24
      202     then do:
      203       message
      204         vss-workfile vss-revision vss-description skip
      205         "Неправильный номер смены" skip
      206         "p-shift-num" p-shift-num skip
      207         view-as alert-box error .
      208       undo, return error return-value .
      209     end.
      210     assign
      211       p-fact-order           = v-fact-date-num
      212                              + v-shift-offset * 0.5
      213                              + p-shift-num    * 0.02 - 0.01
      214                              + p-fact-num     * 0.0000000001
      215       p-shift-end-fact-order = v-fact-date-num
      216                              + v-shift-offset * 0.5
      217                              + p-shift-num    * 0.02
      218       p-day-end-fact-order   = v-fact-date-num
      219                              + 0.99
      220     .
      221     if p-fact-order           <= v-fact-date-num
      222     or p-shift-end-fact-order <= v-fact-date-num
      223     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      224     or p-shift-end-fact-order >= p-day-end-fact-order
      225     then do:
      226       message
      227         vss-workfile vss-revision vss-description skip
      228         "Внутренняя ошибка при генерации фактического номера" skip
      229         "p-fact-date"            p-fact-date            skip
      230         "p-fact-time"            p-fact-time            skip
      231         "p-fact-num"             p-fact-num             skip
      232         "p-shift-date"           p-shift-date           skip
      233         "p-shift-num"            p-shift-num            skip
      234         "p-shift-on"             p-shift-on             skip
      235         "p-shift-end-fact-order" p-shift-end-fact-order skip
      236         "p-day-end-fact-order"   p-day-end-fact-order   skip
      237         "v-fact-date-num"        v-fact-date-num        skip
      238         view-as alert-box error .
      239       undo, return error return-value .
      240     end.
      241   end procedure.
      242   procedure day-begin-fact-order :
      243     define input  parameter p-fact-date            as date    no-undo .
      244     define output parameter p-day-begin-fact-order as decimal no-undo .
      245     do
      246     on error undo, return error return-value
      247     :
      248       if p-fact-date = ?
      249       then do:
      250         assign
      251           p-day-begin-fact-order = 0
      252         .
      253       end.
      254       else do:
      255         assign
      256           p-day-begin-fact-order = integer(p-fact-date)
      257         .
      258       end.
      259     end.
      260   end procedure.
      261   procedure factord-max-fact-order :
      262     define output parameter p-max-fact-order as decimal   no-undo .
      263     do
      264     on error undo, return error return-value
      265     :
      266       run day-begin-fact-order in this-procedure
      267         (input  date(1, 1, 5000)
      268         ,output p-max-fact-order
      269         ) .
      270     end.
      271   end procedure.
      272   procedure factord-cut-archive :
      273     define input  parameter p-obj-type             as character no-undo .
      274     define input  parameter p-obj-code             as integer   no-undo .
      275     define input  parameter p-fact-date            as date      no-undo .
      276     define output parameter p-shift-on             as logical   no-undo .
      277     define output parameter p-shift-date           as date      no-undo .
      278     define output parameter p-shift-num            as integer   no-undo .
      279     define output parameter p-day-end-fact-order   as decimal   no-undo .
      280     define output parameter p-shift-end-fact-order as decimal   no-undo .
      281     define variable v-fact-order as decimal   no-undo .
      282     define buffer buf_shift-obj for ub.shift-obj .
      283     do
      284     on error undo, return error return-value
      285     :
      286   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      287   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      288     (input  p-obj-type
      289     ,input  p-obj-code
      290     ,input  'shift-on=request'
      291     ,output p-shift-on
      292     ) no-error .
      293       if error-status :error
      294       then do:
      295         message
      296           vss-workfile vss-revision vss-description skip
      297           "Ошибка при определении атрибута объекта" skip
      298           "Объект" p-obj-type p-obj-code skip
      299           error-status :get-message(1) skip
      300           return-value skip
      301           view-as alert-box error .
      302         undo, return error return-value .
      303       end.
      304       if p-shift-on = false
      305       then do:
      306         assign
      307           p-shift-date               = ?
      308           p-shift-num                = 0
      309         .
      310       end.
      311       else do:
      312         find first buf_shift-obj share-lock
      313           where buf_shift-obj.obj-type   = p-obj-type
      314             and buf_shift-obj.obj-code   = p-obj-code
      315             and buf_shift-obj.shift-date > p-fact-date
      316           use-index pi
      317           no-error .
      318         if not available buf_shift-obj
      319         or buf_shift-obj.status_ <> 'зкр':U
      320         then do:
      321           message
      322             vss-workfile vss-revision vss-description skip
      323             "Невозможно вычислить последнюю смену" skip
      324             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      325             "Объект" p-obj-type p-obj-code skip
      326             "Дата" p-fact-date skip
      327             view-as alert-box error .
      328           undo, return error return-value .
      329         end.
      330         find last buf_shift-obj share-lock
      331           where buf_shift-obj.obj-type = p-obj-type
      332             and buf_shift-obj.obj-code = p-obj-code
      333             and buf_shift-obj.shift-date <= p-fact-date
      334           use-index pi
      335           no-error .
      336         if available buf_shift-obj
      337         then do:
      338           if  buf_shift-obj.status_ = 'зкр':U
      339           then do:
      340             assign
      341               p-shift-date = buf_shift-obj.shift-date
      342               p-shift-num  = buf_shift-obj.shift-num
      343             .
      344           end.
      345           else do:
      346             message
      347               vss-workfile vss-revision vss-description skip
      348               "Невозможно вычислить последнюю смену" skip
      349               "Статус смены отличен от статуса" 'зкр':U skip
      350               "Объект" p-obj-type p-obj-code skip
      351               "Дата" p-fact-date skip
      352               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      353               view-as alert-box error .
      354             undo, return error return-value .
      355           end.
      356         end.
      357         else do:
      358           assign
      359             p-shift-date = p-fact-date - 1
      360             p-shift-num  = 1
      361           .
      362         end.
      363       end.
      364       run factord in this-procedure
      365         (input  p-fact-date
      366         ,input  1
      367         ,input  1
      368         ,input  p-shift-date
      369         ,input  p-shift-num
      370         ,input  p-shift-on
      371         ,output v-fact-order
      372         ,output p-shift-end-fact-order
      373         ,output p-day-end-fact-order
      374         ) no-error .
      375       if error-status :error
      376       then do:
      377         message
      378           vss-workfile vss-revision vss-description skip
      379           "Ошибка при вызове процедуры factord"
      380           error-status :get-message(1) skip
      381           return-value skip
      382           view-as alert-box error .
      383         undo, return error return-value .
      384       end.
      385     end.
      386   end procedure.
      387   procedure factord-lock-shift :
      388     define input  parameter p-obj-type  as character no-undo .
      389     define input  parameter p-obj-code  as integer   no-undo .
      390     define input  parameter p-fact-date as date      no-undo .
      391     define parameter buffer buf_shift-obj for ub.shift-obj .
      392     define variable v-shift-on      as logical   no-undo .
      393     define variable v-extra-message as character no-undo .
      394     define variable v-error as character no-undo .
      395     do
      396     on error undo, return error return-value
      397     :
      398   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      400     (input  p-obj-type
      401     ,input  p-obj-code
      402     ,input  'shift-on=request'
      403     ,output v-shift-on
      404     ) no-error .
      405       if error-status :error
      406       then do:
      407         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      408         undo, return error v-error .
      409       end.
      410       if v-shift-on = true
      411       then do:
      412         find first buf_shift-obj share-lock
      413           where buf_shift-obj.obj-type   = p-obj-type
      414             and buf_shift-obj.obj-code   = p-obj-code
      415             and buf_shift-obj.shift-date > p-fact-date
      416           use-index pi
      417           no-error .
      418         if not available buf_shift-obj
      419         or buf_shift-obj.status_ <> 'зкр':U
      420         then do:
      421           find last buf_shift-obj
      422             where buf_shift-obj.obj-type = p-obj-type
      423               and buf_shift-obj.obj-code = p-obj-code
      424               and buf_shift-obj.status_  = 'зкр':U
      425             use-index stts
      426             no-error .
      427           if available buf_shift-obj
      428           then do:
      429             assign
      430               v-extra-message =
      431                     substitute("Дата начала последеней закрытой смены на объекте &1"
      432                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      433                               )
      434             .
      435           end.
      436           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      437           undo, return error v-error .
      438         end.
      439       end.
      440     end.
      441   end procedure.
      442   procedure factord-end-day :
      443     define input  parameter p-fact-date            as date    no-undo .
      444     define output parameter p-day-end-fact-order   as decimal no-undo .
      445     do
      446     on error undo, return error return-value
      447     :
      448       if p-fact-date = ?
      449       then do:
      450         return error "Не указана фактическая дата" .
      451       end.
      452       assign
      453         p-day-end-fact-order = integer(p-fact-date) + 0.99
      454       .
      455     end.
      456   end procedure.
      457   procedure factord-to-date :
      458     define input  parameter p-fact-order as decimal no-undo .
      459     define output parameter p-fact-date  as date    no-undo .
      460     define variable v-ref-date  as date      no-undo .
      461     define variable v-ref-delta as integer   no-undo .
      462     do
      463     on error undo, return error return-value
      464     :
      465       if p-fact-order = ?
      466       or p-fact-order = 0
      467       then do:
      468         return error "Не указан fact-order" .
      469       end.
      470       assign
      471         v-ref-date  = date(1, 1, 2000)
      472       .
      473       assign
      474         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      475       .
      476       assign
      477         p-fact-date = v-ref-date + v-ref-delta
      478       .
      479     end.
      480   end procedure.
      481   procedure factord-to-fact-num :
      482     define input  parameter p-fact-order as decimal no-undo .
      483     define output parameter p-fact-num   as integer no-undo .
      484     define variable v-fact-order-trunc as decimal no-undo .
      485     do
      486     on error undo, return error return-value
      487     :
      488       if p-fact-order = ?
      489       or p-fact-order = 0
      490       then do:
      491         return error "Не указан fact-order" .
      492       end.
      493       assign
      494        v-fact-order-trunc = truncate(p-fact-order, 2)
      495       .
      496       assign
      497         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      498       .
      499     end.
      500   end procedure.
      501   procedure factord-to-shift-num :
      502     define input  parameter p-fact-order as decimal no-undo .
      503     define output parameter p-shift-num   as integer no-undo .
      504     define variable  p-shift-numd  as decimal   no-undo .
      505     define variable v-fact-order-trunc as decimal no-undo .
      506     do
      507     on error undo, return error return-value
      508     :
      509       if p-fact-order = ?
      510       or p-fact-order = 0
      511       then do:
      512         return error "Не указан fact-order" .
      513       end.
      514       assign
      515        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      516       .
      517       if v-fact-order-trunc < 0.5 then do:
      518         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      519       end.
      520       assign
      521         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      522         .
      523        assign
      524         p-shift-num = truncate (p-shift-numd , 0)
      525       .
      526     end.
      527   end procedure.
      528   DEFINE TEMP-TABLE tt-place NO-UNDO
      529      field gds-code           like ub.goods.gds-code
      530      field pl-code            like ub.place.pl-code
      531      field loc1               like ub.place.loc1
      532      field gds-name           like ub.goods.gds-name
      533      field max-qnty           like ub.place.max-qnty
      534      field curr-qnty          like ub.rvs-line.state-measure-qnty
      535      field curr-qnty-start    like ub.rvs-line.state-measure-qnty
      536      field curr-fact-order    like ub.rvs-doc.fact-order
      537      field curr-rvs-code      like ub.rvs-doc.rvs-code
      538      field free-qnty          like ub.rvs-line.state-measure-qnty
      539      field curr-fill          as logical
      540      field sale-qnty-curr     like ub.rvs-line.state-measure-qnty
      541      field sale-start-qnty    like ub.rvs-line.state-measure-qnty
      542      field sale-fact-order    like ub.rvs-doc.fact-order
      543      field sale-time          as   integer
      544      field sale-rvs-code      like ub.rvs-doc.rvs-code
      545      field sale-fill            as logical
      546      field sale-qnty-prev       like ub.rvs-line.state-measure-qnty
      547      field sale-start-qnty-prev like ub.rvs-line.state-measure-qnty
      548      field sale-end-qnty-prev   like ub.rvs-line.state-measure-qnty
      549      field sale-time-prev       as   integer     INITIAL 999999
      550      field sale-time-prev-end   as   integer     INITIAL 999999
      551      field hnd                as   HANDLE
      552      field hnd-top            as   HANDLE
      553      field hnd-name           as   HANDLE
      554      field hnd-max-qnty       as   HANDLE
      555      field hnd-free-qnty      as   HANDLE
      556      field hnd-qnty           as   HANDLE
      557   index pu as primary unique
      558         gds-code
      559         pl-code
      560   index by-fill-sale
      561         sale-fill
      562   index by-fill-curr
      563         curr-fill
      564   .
      565   DEFINE TEMP-TABLE tt-gds-pred NO-UNDO
      566      field gds-code           like ub.goods.gds-code
      567      field gds-name           like ub.goods.gds-name
      568      field start-qnty         like ub.rvs-line.state-measure-qnty
      569      field sale-qnty          like ub.rvs-line.state-measure-qnty
      570      field curr-qnty          like ub.rvs-line.state-measure-qnty
      571      field prediction-qnty    like ub.rvs-line.state-measure-qnty
      572      FIELD delta-time         AS INTEGER
      573      field count-pl           as integer
      574      field hnd                as   HANDLE
      575      field hnd-name           as   HANDLE
      576      field hnd-sale-qnty      as   HANDLE
      577      field hnd-qnty           as   HANDLE
      578      field hnd-pred-qnty      as   HANDLE
      579      field hnd-total-qnty     as   HANDLE
      580      field hnd-sale-qnty-l    as   HANDLE
      581      field hnd-qnty-l         as   HANDLE
      582      field hnd-pred-qnty-l    as   HANDLE
      583      field hnd-total-qnty-l   as   HANDLE
      584      field sale-time          as   integer
      585   index pu as primary unique
      586         gds-code
      587   .
      588   define buffer buf_shift-obj   for ub.shift-obj.
      589   define buffer br_tt-place     for tt-place.
      590   define buffer br_tt-gds-pred  for tt-gds-pred.
      591   define variable v-obj-code        as integer      no-undo.
      592   define variable v-obj-type        as character    no-undo.
      593   define variable v-shift-on        as logical no-undo .
      594   define variable v-count-place     as integer      no-undo.
      595   define variable v-max-qnty        as decimal      no-undo.
      596   define variable v-rid-list        as character    no-undo.
      597   DEFINE VARIABLE v-shift-date      AS DATE NO-UNDO.
      598   DEFINE VARIABLE v-shift-num       AS INTEGER NO-UNDO.
      599   define variable v-meas-time       as integer      no-undo.
      600   define variable v-meas-date       as date      no-undo.
      601   DEFINE VARIABLE v-shift-date-prev AS DATE NO-UNDO.
      602   DEFINE VARIABLE v-shift-num-prev  AS INTEGER NO-UNDO.
      603   DEFINE VARIABLE v-shift-date-prediction AS DATE    NO-UNDO.
      604   DEFINE VARIABLE v-end-time-prediction   AS integer NO-UNDO.
      605   DEFINE VARIABLE v-end-time-prediction-shift   AS integer NO-UNDO.
      606   DEFINE VARIABLE v-start-time-prediction AS integer NO-UNDO.
      607   define variable v-curr-date             as date    no-undo.
      608   define variable v-browser    as logical      no-undo.
      609   DEFINE BUTTON b-help
      610        LABEL "Помо&щь"
      611        SIZE 10 BY 1
      612        BGCOLOR 8 .
      613   DEFINE BUTTON b-quit AUTO-END-KEY
      614        LABEL "&Выход"
      615        SIZE 10 BY 1
      616        BGCOLOR 8 .
      617   DEFINE BUTTON b-sale
      618        LABEL "&Реализация"
      619        SIZE 12 BY 1.
      620   DEFINE BUTTON b-shift
      621        IMAGE-UP FILE "btn-down-arrow":U
      622        IMAGE-DOWN FILE "btn-down-arrow":U
      623        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      624        LABEL "Button 2"
      625        SIZE 3 BY 1.
      626   DEFINE VARIABLE v-date-prediction AS DATE FORMAT "99/99/99":U
      627        LABEL "Сменная дата для прогноза"
      628        VIEW-AS FILL-IN
      629        SIZE 9.5 BY 1 DROP-TARGET NO-UNDO.
      630   DEFINE VARIABLE v-hour-prediction AS INTEGER FORMAT "99":U INITIAL 0
      631        VIEW-AS FILL-IN
      632        SIZE 3 BY 1 NO-UNDO.
      633   DEFINE VARIABLE v-minute-prediction AS INTEGER FORMAT "99":U INITIAL 0
      634        LABEL ""
      635        VIEW-AS FILL-IN
      636        SIZE 3 BY 1 NO-UNDO.
      637   DEFINE VARIABLE v-shift-num-prediction AS INTEGER FORMAT ">>9":U INITIAL 0
      638        LABEL "Порядок смены прогноза"
      639        VIEW-AS FILL-IN
      640        SIZE 3 BY 1 NO-UNDO.
      641   DEFINE VARIABLE rs-prediction AS INTEGER INITIAL 1
      642        VIEW-AS RADIO-SET VERTICAL
      643        RADIO-BUTTONS
      644             "На конец смены", 1,
      645   "На конкретное время", 2
      646        SIZE 21.5 BY 1.5 NO-UNDO.
      647   DEFINE RECTANGLE RECT-1
      648        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      649        SIZE 94 BY 10.75.
      650   DEFINE RECTANGLE RECT-2
      651        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      652        SIZE 94 BY 7.5.
      653   DEFINE QUERY BROWSE-3 FOR
      654         br_tt-place SCROLLING.
      655   DEFINE QUERY BROWSE-4 FOR
      656         br_tt-gds-pred SCROLLING.
      657   DEFINE BROWSE BROWSE-3
      658     QUERY BROWSE-3 DISPLAY
      659         br_tt-place.gds-name FORMAT "x(40)" COLUMN-LABEL "Топливо"
      660    br_tt-place.loc1                        COLUMN-LABEL "Резервуар"
      661    br_tt-place.max-qnty
      662    br_tt-place.curr-qnty             COLUMN-LABEL "Текущее количество"
      663    (br_tt-place.max-qnty - br_tt-place.curr-qnty)             COLUMN-LABEL "Свободно"
      664       WITH NO-ROW-MARKERS SEPARATORS SIZE 94 BY 10.5 EXPANDABLE.
      665   DEFINE BROWSE BROWSE-4
      666     QUERY BROWSE-4 DISPLAY
      667         br_tt-gds-pred.gds-name FORMAT "x(40)" COLUMN-LABEL "Топливо"
      668   br_tt-gds-pred.curr-qnty COLUMN-LABEL "Остаток"
      669   br_tt-gds-pred.sale-qnty COLUMN-LABEL "Реализация"
      670   br_tt-gds-pred.prediction-qnty COLUMN-LABEL "Прогноз"
      671   STRING(br_tt-gds-pred.sale-time, "HH:MM") FORMAT "x(6)" COLUMN-LABEL "измер.":C6
      672   br_tt-gds-pred.delta-time FORMAT ">>>>9" COLUMN-LABEL "мин+/-"
      673       WITH NO-ROW-MARKERS SEPARATORS NO-TAB-STOP SIZE 94 BY 7.25 EXPANDABLE.
      674   DEFINE FRAME Dialog-Frame
      675        b-quit AT ROW 1 COL 1
      676        b-help AT ROW 1 COL 89
      677        BROWSE-3 AT ROW 2.5 COL 2.5
      678        v-date-prediction AT ROW 13.25 COL 27.5 COLON-ALIGNED
      679        b-sale AT ROW 13.25 COL 84.5
      680        rs-prediction AT ROW 13.5 COL 53 NO-LABEL
      681        v-hour-prediction AT ROW 14.08 COL 73.5 COLON-ALIGNED NO-LABEL
      682        v-minute-prediction AT ROW 14.08 COL 79 COLON-ALIGNED
      683        v-shift-num-prediction AT ROW 14.25 COL 27.5 COLON-ALIGNED
      684        b-shift AT ROW 14.25 COL 36
      685        BROWSE-4 AT ROW 15.5 COL 2.5
      686        "Тип прогноза:" VIEW-AS TEXT
      687             SIZE 13.5 BY .67 AT ROW 13.5 COL 39.5
      688        RECT-1 AT ROW 2.5 COL 2.5
      689        RECT-2 AT ROW 15.5 COL 2.5
      690        SPACE(2.50) SKIP(0.00)
      691       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      692            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      693            TITLE "Мониторинг остатков резервуаров и прогноз реализации"
      694            CANCEL-BUTTON b-quit.
      695   ASSIGN
      696          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      697          FRAME Dialog-Frame:HIDDEN           = TRUE.
      698   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      699   DO:
      700     APPLY "END-ERROR":U TO SELF.
      701   END.
      702   ON CHOOSE OF b-sale IN FRAME Dialog-Frame
      703   DO:
      704      define variable v-shift-list    as character    no-undo.
      705      define buffer buf_shift-obj      for ub.shift-obj.
      706      run rep/restsale.w ( parparentproc
      707                     , v-obj-type
      708                     , v-obj-code
      709                     , v-date-prediction
      710                     , v-start-time-prediction
      711                     , v-date-prediction
      712                     , v-end-time-prediction
      713                     ) NO-ERROR.
      714      if error-status :error
      715      then do:
      716         message
      717            vss-workfile vss-revision vss-description skip
      718            "Ошибка при вызове процедуры расчета продаж за интервал restsale.w" skip
      719            error-status :get-message(1) skip
      720            return-value skip
      721            view-as alert-box error .
      722      end.
      723   END.
      724   ON CHOOSE OF b-shift IN FRAME Dialog-Frame
      725   DO:
      726      run select-shift in this-procedure .
      727      run del-prediction in this-procedure .
      728      run fill-prediction in this-procedure .
      729      run draw-pred in this-procedure .
      730      run enable_UI IN THIS-PROCEDURE.
      731      IF v-browser then do:
      732         run show-browser  in this-procedure.
      733      end.
      734      else do:
      735         run show-histogramm in this-procedure.
      736      end.
      737   END.
      738   ON MOUSE-SELECT-DBLCLICK OF BROWSE-3 IN FRAME Dialog-Frame
      739   DO:
      740      run show-histogramm in this-procedure.
      741      assign
      742         v-browser = FALSE
      743      .
      744   END.
      745   ON MOUSE-SELECT-DBLCLICK OF BROWSE-4 IN FRAME Dialog-Frame
      746   DO:
      747      run show-histogramm in this-procedure.
      748      assign
      749         v-browser = FALSE
      750      .
      751   END.
      752   ON MOUSE-SELECT-DBLCLICK OF RECT-1 IN FRAME Dialog-Frame
      753   DO:
      754     run show-browser  in this-procedure.
      755      assign
      756         v-browser = TRUE
      757      .
      758   END.
      759   ON MOUSE-SELECT-DBLCLICK OF RECT-2 IN FRAME Dialog-Frame
      760   DO:
      761     run show-browser  in this-procedure.
      762      assign
      763         v-browser = TRUE
      764      .
      765   END.
      766   ON VALUE-CHANGED OF rs-prediction IN FRAME Dialog-Frame
      767   DO:
      768      ASSIGN
      769        rs-prediction
      770      .
      771      CASE rs-prediction:
      772         WHEN 1 THEN DO:
      773            DISABLE v-hour-prediction
      774                  v-minute-prediction
      775            with frame Dialog-Frame.
      776            assign
      777               v-end-time-prediction = v-end-time-prediction-shift
      778            .
      779         END.
      780         OTHERWISE DO:
      781            ENABLE v-hour-prediction
      782                  v-minute-prediction
      783            with frame Dialog-Frame.
      784            ASSIGN
      785               v-end-time-prediction = v-hour-prediction * 60 * 60 + v-minute-prediction * 60
      786            .
      787         END.
      788      END CASE.
      789      run del-prediction   in this-procedure .
      790      run fill-prediction  in this-procedure .
      791      run draw-pred        in this-procedure .
      792      run enable_UI IN THIS-PROCEDURE.
      793      IF v-browser then do:
      794         run show-browser  in this-procedure.
      795      end.
      796      else do:
      797         run show-histogramm in this-procedure.
      798      end.
      799   END.
      800   ON LEAVE OF v-date-prediction IN FRAME Dialog-Frame
      801   DO:
      802     ASSIGN
      803         v-date-prediction
      804     .
      805     run find-date-shift in this-procedure
      806         ( input v-obj-type
      807         , input v-obj-code
      808         , input v-date-prediction
      809         , input v-start-time-prediction
      810         , output v-shift-date-prediction
      811         , output v-shift-num-prediction
      812         ) .
      813      run del-prediction   in this-procedure .
      814      run fill-prediction  in this-procedure .
      815      run draw-pred        in this-procedure .
      816      run enable_UI IN THIS-PROCEDURE.
      817      IF v-browser then do:
      818         run show-browser  in this-procedure.
      819      end.
      820      else do:
      821         run show-histogramm in this-procedure.
      822      end.
      823      DISPLAY v-shift-num-prediction
      824      WITH FRAME Dialog-Frame.
      825   END.
      826   ON LEAVE OF v-hour-prediction IN FRAME Dialog-Frame
      827   DO:
      828      ASSIGN
      829         v-hour-prediction
      830      .
      831      run mandatory-24 IN THIS-PROCEDURE
      832         (INPUT-OUTPUT v-hour-prediction ) .
      833      ASSIGN
      834          v-end-time-prediction = v-hour-prediction * 60 * 60 + v-minute-prediction * 60
      835      .
      836      run del-prediction   in this-procedure .
      837      run fill-prediction in this-procedure .
      838      run draw-pred in this-procedure .
      839      run enable_UI IN THIS-PROCEDURE.
      840      IF v-browser then do:
      841         run show-browser  in this-procedure.
      842      end.
      843      else do:
      844         run show-histogramm in this-procedure.
      845      end.
      846   END.
      847   ON LEAVE OF v-minute-prediction IN FRAME Dialog-Frame
      848   DO:
      849      ASSIGN
      850         v-minute-prediction
      851      .
      852      run mandatory-60 IN THIS-PROCEDURE
      853         (INPUT-OUTPUT v-minute-prediction ) .
      854      ASSIGN
      855            v-end-time-prediction = v-hour-prediction * 60 * 60 + v-minute-prediction * 60
      856      .
      857      run del-prediction   in this-procedure .
      858      run fill-prediction in this-procedure .
      859      run draw-pred in this-procedure .
      860      run enable_UI IN THIS-PROCEDURE.
      861      IF v-browser then do:
      862         run show-browser  in this-procedure.
      863      end.
      864      else do:
      865         run show-histogramm in this-procedure.
      866      end.
      867   END.
      868   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      869     run mainmenu_getcntxt in parparentproc
      870       (output v-cntxt-db-num
      871       ,output v-cntxt-userid
      872       ,output v-cntxt-level
      873       ,output v-cntxt-host-code-obj
      874       ,output v-cntxt-obj-type
      875       ,output v-cntxt-obj-code
      876       ,output v-cntxt-db-num-obj
      877       ,output v-cntxt-is-admin
      878       ) .
      879   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   on help of frame Dialog-Frame
      881   do:
      882     run gbl/app_help.p
      883       (input this-procedure :file-name
      884       ,input ''
      885       ,input ?
      886       ) no-error.
      887     if error-status :error then do:
      888       message
      889         "Ошибка при вызове помощи"
      890         error-status :get-message(1)
      891         view-as alert-box .
      892     end.
      893   end.
      894   run minbtn-set in this-procedure .
      895   on choose of b-help in frame Dialog-Frame
      896   do:
      897     apply "help":u to frame Dialog-Frame .
      898   end.
      899   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   procedure minbtn-set :
      901       do
      902           on error undo, return error return-value
      903           :
      904           define variable ii              as integer       no-undo .
      905           define variable fh              as widget-handle no-undo .
      906           define variable hh              as widget-handle no-undo .
      907           define variable v-h             as handle        extent 4 no-undo .
      908           define variable v-name-button   as character     no-undo .
      909           define variable v-help-old-x    as decimal       no-undo .
      910           define variable v-help-old-y    as decimal       no-undo .
      911           define variable v-help-old-size as decimal       no-undo .
      912           define variable v-frame-width   as decimal       no-undo .
      913           define variable jj              as integer       no-undo .
      914           do
      915               on error undo, return error
      916               :
      917               assign
      918                   v-frame-width = frame Dialog-Frame:width - 0.3
      919                   fh            = frame Dialog-Frame:first-child
      920                   hh            = fh:first-child
      921                   ii            = 1
      922                   .
      923               do while valid-handle(hh):
      924                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      925                   do:
      926                       case lc(hh:name) :
      927                           when "b-help" then
      928                               do:
      929                                   hh:load-image-up("cmp/b-help.bmp":u) .
      930                                   hh:load-image-down("cmp/b-help.bmp":u) .
      931                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      932                                   hh:TOOLTIP = "Помощь" .
      933                                   v-help-old-x = hh:column .
      934                                   v-help-old-y = hh:row    .
      935                                   v-help-old-size = hh:width .
      936                                   hh:width-chars = 2.5 .
      937                               end.
      938                           when "b-print" then
      939                               do:
      940                                   hh:load-image("cmp/b-print.bmp":u) .
      941                                   hh:TOOLTIP = "Печать" .
      942                                   v-h[ii] = hh:handle .
      943                                   ii = ii + 1 .
      944                                   hh:width-chars = 3 .
      945                               end.
      946                           when "b-history" or
      947                           when "b-hist" then
      948                               do:
      949                                   hh:load-image("cmp/b-hist.bmp":u) .
      950                                   hh:TOOLTIP = "История" .
      951                                   v-h[ii] = hh:handle .
      952                                   ii = ii + 1 .
      953                                   hh:width-chars = 3 .
      954                               end.
      955                           when "b-sch" then
      956                               do:
      957                                   hh:load-image("cmp/b-sch.bmp":u) .
      958                                   hh:TOOLTIP = "Установка Фильтра" .
      959                                   v-h[ii] = hh:handle .
      960                                   ii = ii + 1 .
      961                                   hh:width-chars = 3 .
      962                               end.
      963                           when "b-hist-user" then
      964                               do:
      965                                   hh:load-image("cmp/b-hist.bmp":u) .
      966                                   hh:TOOLTIP = "История пользователя" .
      967                                   ii = ii + 1 .
      968                               end.
      969                       end case.
      970                   end.
      971                   hh = hh:next-sibling.
      972               end.
      973               b-help:column = v-frame-width - b-help:width-chars.
      974               jj = 0.
      975               repeat ii = 4 to 1 by -1 :
      976                   if valid-handle (v-h[ii] ) then
      977                   do:
      978                       jj  = jj + 1 .
      979                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      980                       v-h[ii]:row    = v-help-old-y .
      981                   end.
      982               end.
      983           end.
      984       end.
      985   end procedure.
      986   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      987   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      988   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      989   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      990   define variable v-diasize-current-frame-width  as decimal   no-undo .
      991   define variable v-diasize-current-frame-height as decimal   no-undo .
      992   define variable v-diasize-change-size          as logical   no-undo .
      993   define variable v-diasize-resize-button        as handle    no-undo .
      994   define variable v-diasize-wndmax               as logical   no-undo .
      995   define variable v-diasize-wndstore             as logical   no-undo .
      996   define variable v-diasize-proc-name            as character no-undo .
      997   define variable v-diasize-browse-handle        as handle    no-undo .
      998   define variable v-diasize-browse-number        as integer   no-undo .
      999   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1000   define temp-table temp-diasize-handle no-undo
     1001     field handle-value  as handle
     1002     field save-position as decimal
     1003     index xpk is primary unique handle-value
     1004     .
     1005   define temp-table temp-browse-handle no-undo
     1006     field browse-type   as character
     1007     field browse-number as integer
     1008     field browse-handle as handle
     1009     field original-size as decimal
     1010     index xpk is primary unique browse-type browse-number
     1011     index xie browse-type browse-handle
     1012   .
     1013   procedure diasize_change-height :
     1014     define input  parameter p-change-value  as decimal   no-undo .
     1015     define input  parameter p-move-resize   as logical   no-undo .
     1016     define variable v-field-group-handle    as handle    no-undo .
     1017     define variable v-object-handle         as handle    no-undo .
     1018     define variable v-frame-height          as decimal   no-undo .
     1019     define variable v-frame-virtual-height  as decimal   no-undo .
     1020     define variable v-browse-height         as decimal   no-undo .
     1021     define variable v-window-height         as decimal   no-undo .
     1022     define variable v-window-virtual-height as decimal   no-undo .
     1023     define variable v-change-sign           as integer   no-undo .
     1024     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1025     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1026     if p-change-value > 0
     1027     then do:
     1028       if frame Dialog-Frame :height + p-change-value
     1029           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1030       then do:
     1031         assign
     1032           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1033                           - (frame Dialog-Frame :height-chars)
     1034         .
     1035         if p-change-value <= 0
     1036         then do:
     1037           run diasize_position-resize-button in this-procedure .
     1038           return .
     1039         end.
     1040       end.
     1041     end.
     1042     if p-change-value < 0
     1043     then do:
     1044       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1045       then do:
     1046         assign
     1047           p-change-value = v-diasize-orig-frame-height
     1048                          - (frame Dialog-Frame :height-chars)
     1049         .
     1050         if p-change-value >= 0
     1051         then do:
     1052           run diasize_position-resize-button in this-procedure .
     1053           return .
     1054         end.
     1055       end.
     1056     end.
     1057     if p-change-value >= 0
     1058     then do:
     1059       assign
     1060         v-change-sign = 1
     1061       .
     1062     end.
     1063     else do:
     1064       assign
     1065         v-change-sign = -1
     1066       .
     1067     end.
     1068     assign
     1069       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1070     .
     1071     if p-change-value = 0
     1072     then do:
     1073       run diasize_position-resize-button in this-procedure .
     1074       return .
     1075     end.
     1076     move_block:
     1077     do
     1078     on error undo move_block, retry move_block
     1079     :
     1080       if retry
     1081       then do:
     1082         do
     1083         on error undo move_block, leave move_block
     1084         :
     1085           if p-change-value > 0
     1086           then do:
     1087             for each buf_temp-diasize-handle
     1088             on error undo, next
     1089             :
     1090               assign
     1091                 v-object-handle = buf_temp-diasize-handle.handle-value
     1092               .
     1093               if v-object-handle <> v-diasize-resize-button
     1094               then do:
     1095                 assign
     1096                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1097                 .
     1098               end.
     1099             end.
     1100             assign
     1101               v-diasize-browse-handle :height = v-browse-height
     1102             .
     1103             for each buf_temp-browse-handle
     1104               where buf_temp-browse-handle.browse-type = 'height':u
     1105             on error undo, next
     1106             :
     1107               assign
     1108                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1109               .
     1110             end.
     1111             assign
     1112               frame Dialog-Frame :height = v-frame-height
     1113             .
     1114             if frame Dialog-Frame :scrollable = true
     1115             then do:
     1116               assign
     1117                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1118               .
     1119             end.
     1120             run diasize_position-resize-button in this-procedure .
     1121           end.
     1122           else do:
     1123             if frame Dialog-Frame :scrollable = true
     1124             then do:
     1125               assign
     1126                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1127               .
     1128             end.
     1129             assign
     1130               frame Dialog-Frame :height = v-frame-height
     1131             .
     1132             assign
     1133               v-diasize-browse-handle :height = v-browse-height
     1134             .
     1135             for each buf_temp-browse-handle
     1136               where buf_temp-browse-handle.browse-type = 'height':u
     1137             on error undo, next
     1138             :
     1139               assign
     1140                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1141               .
     1142             end.
     1143             for each buf_temp-diasize-handle
     1144             on error undo, next
     1145             :
     1146               assign
     1147                 v-object-handle = buf_temp-diasize-handle.handle-value
     1148               .
     1149               if v-object-handle <> v-diasize-resize-button
     1150               then do:
     1151                 assign
     1152                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1153                 .
     1154               end.
     1155             end.
     1156             run diasize_position-resize-button in this-procedure .
     1157           end.
     1158           assign
     1159             v-diasize-change-size = false
     1160           .
     1161           leave move_block .
     1162         end.
     1163       end.
     1164       assign
     1165         v-diasize-need-full-display = true
     1166       .
     1167       if v-diasize-change-size = false
     1168       then do:
     1169         assign
     1170           v-diasize-change-size = true
     1171         .
     1172       end.
     1173       else do:
     1174         return .
     1175       end.
     1176       assign
     1177         v-frame-height = frame Dialog-Frame :height
     1178         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1179         v-browse-height = v-diasize-browse-handle :height
     1180       .
     1181       for each buf_temp-browse-handle
     1182         where buf_temp-browse-handle.browse-type = 'height':u
     1183       :
     1184         assign
     1185           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1186         .
     1187       end.
     1188       for each buf_temp-diasize-handle
     1189       :
     1190         delete buf_temp-diasize-handle .
     1191       end.
     1192       assign
     1193         v-field-group-handle = frame Dialog-Frame :first-child
     1194       .
     1195       do while valid-handle(v-field-group-handle)
     1196       :
     1197         assign
     1198           v-object-handle = v-field-group-handle :first-child
     1199         .
     1200         do while valid-handle(v-object-handle)
     1201         :
     1202           if  v-object-handle <> v-diasize-browse-handle :handle
     1203           and can-query(v-object-handle, "row")
     1204           and can-query(v-object-handle, "height")
     1205           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1206           then do:
     1207             find first buf_temp-browse-handle
     1208               where buf_temp-browse-handle.browse-type   = 'height':u
     1209                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1210               no-error .
     1211             if available buf_temp-browse-handle
     1212             then do:
     1213             end.
     1214             else do:
     1215               create buf_temp-diasize-handle .
     1216               assign
     1217                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1218                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1219               .
     1220             end.
     1221           end.
     1222           assign
     1223             v-object-handle = v-object-handle :next-sibling
     1224           .
     1225         end.
     1226         assign
     1227           v-field-group-handle = v-field-group-handle :next-sibling
     1228         .
     1229       end.
     1230       do with frame Dialog-Frame
     1231       :
     1232         hide v-diasize-resize-button .
     1233         assign
     1234           v-diasize-resize-button :row    = 1
     1235           v-diasize-resize-button :column = 1
     1236         .
     1237       end.
     1238       if p-change-value > 0
     1239       then do:
     1240         if frame Dialog-Frame :scrollable = true
     1241         then do:
     1242           assign
     1243             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1244             no-error .
     1245           if error-status :error
     1246           or error-status :get-message(1) <> ""
     1247           then do:
     1248             undo move_block, retry move_block .
     1249           end.
     1250         end.
     1251         assign
     1252           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1253           no-error .
     1254         if error-status :error
     1255         or error-status :get-message(1) <> ""
     1256         then do:
     1257           undo move_block, retry move_block .
     1258         end.
     1259         assign
     1260           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1261           no-error .
     1262         if error-status :error
     1263         or error-status :get-message(1) <> ""
     1264         then do:
     1265           undo move_block, retry move_block .
     1266         end.
     1267         for each buf_temp-browse-handle
     1268           where buf_temp-browse-handle.browse-type = 'height':u
     1269         on error undo move_block, retry move_block
     1270         :
     1271           assign
     1272             buf_temp-browse-handle.browse-handle :height
     1273               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1274             no-error .
     1275           if error-status :error
     1276           or error-status :get-message(1) <> ""
     1277           then do:
     1278             undo move_block, retry move_block .
     1279           end.
     1280         end.
     1281         for each buf_temp-diasize-handle
     1282         on error undo move_block, retry move_block
     1283         :
     1284           assign
     1285             v-object-handle = buf_temp-diasize-handle.handle-value
     1286           .
     1287           if v-object-handle <> v-diasize-resize-button
     1288           then do:
     1289             assign
     1290               v-object-handle :row = v-object-handle :row + p-change-value
     1291               no-error .
     1292             if error-status :error
     1293             or error-status :get-message(1) <> ""
     1294             then do:
     1295               undo move_block, retry move_block .
     1296             end.
     1297           end.
     1298         end.
     1299       end.
     1300       else do:
     1301         for each buf_temp-diasize-handle
     1302         on error undo move_block, retry move_block
     1303         :
     1304           assign
     1305             v-object-handle = buf_temp-diasize-handle.handle-value
     1306           .
     1307           if v-object-handle <> v-diasize-resize-button
     1308           then do:
     1309             assign
     1310               v-object-handle :row = v-object-handle :row + p-change-value
     1311               no-error .
     1312             if error-status :error
     1313             or error-status :get-message(1) <> ""
     1314             then do:
     1315               undo move_block, retry move_block .
     1316             end.
     1317           end.
     1318         end.
     1319         assign
     1320           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1321           no-error .
     1322         if error-status :error
     1323         or error-status :get-message(1) <> ""
     1324         then do:
     1325           undo move_block, retry move_block .
     1326         end.
     1327         for each buf_temp-browse-handle
     1328           where buf_temp-browse-handle.browse-type = 'height':u
     1329         on error undo move_block, retry move_block
     1330         :
     1331           assign
     1332             buf_temp-browse-handle.browse-handle :height
     1333               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1334             no-error .
     1335           if error-status :error
     1336           or error-status :get-message(1) <> ""
     1337           then do:
     1338             undo move_block, retry move_block .
     1339           end.
     1340         end.
     1341         assign
     1342           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1343           no-error .
     1344         if error-status :error
     1345         or error-status :get-message(1) <> ""
     1346         then do:
     1347           undo move_block, retry move_block .
     1348         end.
     1349         if frame Dialog-Frame :scrollable = true
     1350         then do:
     1351           assign
     1352             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1353             no-error .
     1354           if error-status :error
     1355           or error-status :get-message(1) <> ""
     1356           then do:
     1357             undo move_block, retry move_block .
     1358           end.
     1359         end.
     1360       end.
     1361       if p-move-resize = true
     1362       then do:
     1363         run diasize_position-resize-button in this-procedure .
     1364       end.
     1365       if v-diasize-wndstore = true
     1366       then do:
     1367         if connected("ub") = true
     1368         then do:
     1369           define variable v-cntxt-db-num        as integer   no-undo .
     1370           define variable v-cntxt-userid        as character no-undo .
     1371           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1372                                             , OUTPUT v-cntxt-userid
     1373                                             ) .
     1374           run gbl/wndsizew.p
     1375             (input  v-cntxt-db-num
     1376             ,input  v-cntxt-userid
     1377             ,input  v-diasize-proc-name
     1378             ,input  'height':u
     1379             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1380             ) .
     1381         end.
     1382       end.
     1383     end.
     1384     assign
     1385       v-diasize-change-size = false
     1386     .
     1387   end procedure.
     1388   procedure diasize_set-height :
     1389     define input  parameter p-new-height  as decimal   no-undo .
     1390     define input  parameter p-move-resize as logical   no-undo .
     1391     do
     1392     on error undo, return error return-value
     1393     :
     1394       run diasize_change-height in this-procedure
     1395         (input  (p-new-height - frame Dialog-Frame :height)
     1396         ,input  p-move-resize
     1397         ) .
     1398     end.
     1399   end procedure.
     1400   procedure diasize_change-width :
     1401     define input  parameter p-change-value as decimal   no-undo .
     1402     define input  parameter p-move-resize  as logical   no-undo .
     1403     define variable v-field-group-handle   as handle    no-undo .
     1404     define variable v-object-handle        as handle    no-undo .
     1405     define variable v-frame-width          as decimal   no-undo .
     1406     define variable v-frame-virtual-width  as decimal   no-undo .
     1407     define variable v-browse-width         as decimal   no-undo .
     1408     define variable v-window-width         as decimal   no-undo .
     1409     define variable v-window-virtual-width as decimal   no-undo .
     1410     define variable v-change-sign          as integer   no-undo .
     1411     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1412     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1413     if p-change-value > 0
     1414     then do:
     1415       if frame Dialog-Frame :width + p-change-value >
     1416           session :width-chars
     1417       then do:
     1418         assign
     1419           p-change-value = session :width-chars - frame Dialog-Frame :width
     1420         .
     1421         if p-change-value <= 0
     1422         then do:
     1423           run diasize_position-resize-button in this-procedure .
     1424           return .
     1425         end.
     1426       end.
     1427     end.
     1428     if p-change-value < 0
     1429     then do:
     1430       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1431       then do:
     1432         assign
     1433           p-change-value = v-diasize-orig-frame-width
     1434                          - frame Dialog-Frame :width
     1435         .
     1436         if p-change-value >= 0
     1437         then do:
     1438           run diasize_position-resize-button in this-procedure .
     1439           return .
     1440         end.
     1441       end.
     1442     end.
     1443     if p-change-value >= 0
     1444     then do:
     1445       assign
     1446         v-change-sign = 1
     1447       .
     1448     end.
     1449     else do:
     1450       assign
     1451         v-change-sign = -1
     1452       .
     1453     end.
     1454     assign
     1455       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1456     .
     1457     if p-change-value = 0
     1458     then do:
     1459       run diasize_position-resize-button in this-procedure .
     1460       return .
     1461     end.
     1462     move_block:
     1463     do
     1464     on error undo move_block, leave move_block
     1465     :
     1466       if retry
     1467       then do:
     1468         do
     1469         on error undo move_block, leave move_block
     1470         :
     1471           if p-change-value > 0
     1472           then do:
     1473             for each buf_temp-diasize-handle
     1474             on error undo, next
     1475             :
     1476               assign
     1477                 v-object-handle = buf_temp-diasize-handle.handle-value
     1478               .
     1479               if v-object-handle <> v-diasize-resize-button
     1480               then do:
     1481                 assign
     1482                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1483                 .
     1484               end.
     1485             end.
     1486             assign
     1487               v-diasize-browse-handle :width = v-browse-width
     1488             .
     1489             for each buf_temp-browse-handle
     1490               where buf_temp-browse-handle.browse-type = 'width':u
     1491             on error undo, next
     1492             :
     1493               assign
     1494                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1495               .
     1496             end.
     1497             assign
     1498               frame Dialog-Frame :width = v-frame-width
     1499             .
     1500             if frame Dialog-Frame :scrollable = true
     1501             then do:
     1502               assign
     1503                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1504               .
     1505             end.
     1506             run diasize_position-resize-button in this-procedure .
     1507           end.
     1508           else do:
     1509             if frame Dialog-Frame :scrollable = true
     1510             then do:
     1511               assign
     1512                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1513               .
     1514             end.
     1515             assign
     1516               frame Dialog-Frame :width = v-frame-width
     1517             .
     1518             for each buf_temp-browse-handle
     1519               where buf_temp-browse-handle.browse-type = 'width':u
     1520             on error undo, next
     1521             :
     1522               assign
     1523                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1524               .
     1525             end.
     1526             assign
     1527               v-diasize-browse-handle :width = v-browse-width
     1528             .
     1529             for each buf_temp-diasize-handle
     1530             on error undo, next
     1531             :
     1532               assign
     1533                 v-object-handle = buf_temp-diasize-handle.handle-value
     1534               .
     1535               if v-object-handle <> v-diasize-resize-button
     1536               then do:
     1537                 assign
     1538                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1539                 .
     1540               end.
     1541             end.
     1542             run diasize_position-resize-button in this-procedure .
     1543           end.
     1544           assign
     1545             v-diasize-change-size = false
     1546           .
     1547           leave move_block .
     1548         end.
     1549       end.
     1550       assign
     1551         v-diasize-need-full-display = true
     1552       .
     1553       if v-diasize-change-size = false
     1554       then do:
     1555         assign
     1556           v-diasize-change-size = true
     1557         .
     1558       end.
     1559       else do:
     1560         return .
     1561       end.
     1562       assign
     1563         v-frame-width = frame Dialog-Frame :width
     1564         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1565         v-browse-width = v-diasize-browse-handle :width
     1566       .
     1567       for each buf_temp-browse-handle
     1568         where buf_temp-browse-handle.browse-type = 'width':u
     1569       :
     1570         assign
     1571           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1572         .
     1573       end.
     1574       for each buf_temp-diasize-handle
     1575       :
     1576         delete buf_temp-diasize-handle .
     1577       end.
     1578       assign
     1579         v-field-group-handle = frame Dialog-Frame :first-child
     1580       .
     1581       do while valid-handle(v-field-group-handle)
     1582       :
     1583         assign
     1584           v-object-handle = v-field-group-handle :first-child
     1585         .
     1586         do while valid-handle(v-object-handle)
     1587         :
     1588           if  v-object-handle <> v-diasize-browse-handle :handle
     1589           and v-object-handle <> v-diasize-resize-button
     1590           and can-query(v-object-handle, "row")
     1591           and can-query(v-object-handle, "height")
     1592           and ( v-object-handle :col + v-object-handle :width
     1593                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1594               )
     1595           then do:
     1596             find first buf_temp-browse-handle
     1597               where buf_temp-browse-handle.browse-type   = 'width':u
     1598                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1599               no-error .
     1600             if available buf_temp-browse-handle
     1601             then do:
     1602             end.
     1603             else do:
     1604               create buf_temp-diasize-handle .
     1605               assign
     1606                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1607                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1608               .
     1609             end.
     1610           end.
     1611           assign
     1612             v-object-handle = v-object-handle :next-sibling
     1613           .
     1614         end.
     1615         assign
     1616           v-field-group-handle = v-field-group-handle :next-sibling
     1617         .
     1618       end.
     1619       do with frame Dialog-Frame
     1620       :
     1621         hide v-diasize-resize-button .
     1622         v-diasize-resize-button :row = 1.
     1623         v-diasize-resize-button :column = 1.
     1624       end.
     1625       if p-change-value > 0
     1626       then do:
     1627         if frame Dialog-Frame :scrollable = true
     1628         then do:
     1629           assign
     1630             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1631             no-error .
     1632           if error-status :error
     1633           or error-status :get-message(1) <> ""
     1634           then do:
     1635             undo move_block, retry move_block.
     1636           end.
     1637         end.
     1638         assign
     1639           frame Dialog-Frame :width = v-frame-width + p-change-value
     1640           no-error .
     1641         if error-status :error
     1642         or error-status :get-message(1) <> ""
     1643         then do:
     1644           undo move_block, retry move_block.
     1645         end.
     1646         assign
     1647           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1648         no-error .
     1649         if error-status :error
     1650         or error-status :get-message(1) <> ""
     1651         then do:
     1652           undo move_block, retry move_block.
     1653         end.
     1654         for each buf_temp-browse-handle
     1655           where buf_temp-browse-handle.browse-type = 'width':u
     1656         on error undo move_block, retry move_block
     1657         :
     1658           assign
     1659             buf_temp-browse-handle.browse-handle :width
     1660               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1661             no-error .
     1662           if error-status :error
     1663           or error-status :get-message(1) <> ""
     1664           then do:
     1665             undo move_block, retry move_block .
     1666           end.
     1667         end.
     1668         for each buf_temp-diasize-handle
     1669         on error undo move_block, retry move_block
     1670         :
     1671           assign
     1672             v-object-handle = buf_temp-diasize-handle.handle-value
     1673           .
     1674           if v-object-handle <> v-diasize-resize-button
     1675           then do:
     1676             assign
     1677               v-object-handle :col = v-object-handle :col + p-change-value
     1678               no-error .
     1679             if error-status :error
     1680             or error-status :get-message(1) <> ""
     1681             then do:
     1682               undo move_block, retry move_block .
     1683             end.
     1684           end.
     1685         end.
     1686       end.
     1687       else do:
     1688         for each buf_temp-diasize-handle
     1689         on error undo move_block, retry move_block
     1690         :
     1691           assign
     1692             v-object-handle = buf_temp-diasize-handle.handle-value
     1693           .
     1694           if v-object-handle <> v-diasize-resize-button
     1695           then do:
     1696             assign
     1697               v-object-handle :col = v-object-handle :col + p-change-value
     1698               no-error .
     1699             if error-status :error
     1700             or error-status :get-message(1) <> ""
     1701             then do:
     1702               undo move_block, retry move_block .
     1703             end.
     1704           end.
     1705         end.
     1706         for each buf_temp-browse-handle
     1707           where buf_temp-browse-handle.browse-type = 'width':u
     1708         on error undo move_block, retry move_block
     1709         :
     1710           assign
     1711             buf_temp-browse-handle.browse-handle :width
     1712               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1713             no-error .
     1714           if error-status :error
     1715           or error-status :get-message(1) <> ""
     1716           then do:
     1717             undo move_block, retry move_block .
     1718           end.
     1719         end.
     1720         assign
     1721           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1722           no-error .
     1723         if error-status :error
     1724         or error-status :get-message(1) <> ""
     1725         then do:
     1726           undo move_block, retry move_block.
     1727         end.
     1728         assign
     1729           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1730         no-error .
     1731         if error-status :error
     1732         or error-status :get-message(1) <> ""
     1733         then do:
     1734           undo move_block, retry move_block.
     1735         end.
     1736         if frame Dialog-Frame :scrollable = true
     1737         then do:
     1738           assign
     1739             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1740           no-error .
     1741           if error-status :error
     1742           or error-status :get-message(1) <> ""
     1743           then do:
     1744             undo move_block, retry move_block.
     1745           end.
     1746         end.
     1747       end.
     1748       if p-move-resize
     1749       then do:
     1750         run diasize_position-resize-button in this-procedure .
     1751       end.
     1752       if v-diasize-wndstore = true
     1753       then do:
     1754         if connected("ub") = true
     1755         then do:
     1756           define variable v-cntxt-db-num        as integer   no-undo .
     1757           define variable v-cntxt-userid        as character no-undo .
     1758           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1759                                             , OUTPUT v-cntxt-userid
     1760                                             ) .
     1761           run gbl/wndsizew.p
     1762             (input  v-cntxt-db-num
     1763             ,input  v-cntxt-userid
     1764             ,input  v-diasize-proc-name
     1765             ,input  'width':u
     1766             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1767             ) .
     1768         end.
     1769       end.
     1770     end.
     1771     assign
     1772       v-diasize-change-size = false
     1773     .
     1774   end procedure.
     1775   procedure diasize_set-width :
     1776     define input  parameter p-new-width  as decimal   no-undo .
     1777     define input  parameter p-move-resize as logical   no-undo .
     1778     do
     1779     on error undo, return error return-value
     1780     :
     1781       run diasize_change-width in this-procedure
     1782         (input  (p-new-width - frame Dialog-Frame :width)
     1783         ,input  p-move-resize
     1784         ) .
     1785     end.
     1786   end procedure.
     1787   procedure diasize_position-resize-button :
     1788     do with frame Dialog-Frame
     1789     :
     1790       hide v-diasize-resize-button .
     1791       assign
     1792         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1793                     - 1
     1794                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1795         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1796                     - 1
     1797                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1798       .
     1799       view v-diasize-resize-button .
     1800     end.
     1801   end procedure.
     1802   on alt-right anywhere
     1803   do:
     1804     run diasize_change-width in this-procedure
     1805       (input 1
     1806       ,input true
     1807       ) .
     1808     return no-apply .
     1809   end.
     1810   on alt-left anywhere
     1811   do:
     1812     run diasize_change-width in this-procedure
     1813       (input -1
     1814       ,input true
     1815       ) .
     1816     return no-apply .
     1817   end.
     1818   on alt-down anywhere
     1819   do:
     1820     run diasize_change-height in this-procedure
     1821       (input 1
     1822       ,input true
     1823       ) .
     1824     return no-apply .
     1825   end.
     1826   on alt-up anywhere
     1827   do:
     1828     run diasize_change-height in this-procedure
     1829       (input -1
     1830       ,input true
     1831       ) .
     1832     return no-apply .
     1833   end.
     1834   on alt-enter of frame Dialog-Frame
     1835   do:
     1836     run diasize_maximize in this-procedure
     1837       (input  ?
     1838       ).
     1839     return no-apply .
     1840   end.
     1841   procedure diasize_end-move :
     1842     do
     1843     on error undo, return error return-value
     1844     :
     1845       define variable v-row-delta as decimal   no-undo .
     1846       define variable v-col-delta as decimal   no-undo .
     1847       define variable v-new-row as decimal   no-undo .
     1848       define variable v-new-col as decimal   no-undo .
     1849       assign
     1850         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1851         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1852       .
     1853       assign
     1854         v-row-delta = v-new-row - frame Dialog-Frame :height
     1855         v-col-delta = v-new-col - frame Dialog-Frame :width
     1856       .
     1857       run diasize_change-height in this-procedure
     1858         (input v-row-delta
     1859         ,input true
     1860         ) .
     1861       run diasize_change-width in this-procedure
     1862         (input v-col-delta
     1863         ,input true
     1864         ) .
     1865     end.
     1866   end procedure.
     1867   procedure diasize_maximize :
     1868     define input  parameter p-action as logical   no-undo .
     1869     do
     1870     on error undo, return error return-value
     1871     :
     1872       if p-action = ?
     1873       then do:
     1874         if v-diasize-need-maximize = true
     1875         then do:
     1876           assign
     1877             p-action = true
     1878           .
     1879         end.
     1880         else do:
     1881           assign
     1882             p-action = false
     1883           .
     1884         end.
     1885       end.
     1886       if p-action = true
     1887       then do:
     1888         run diasize_change-height in this-procedure
     1889           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1890               - frame Dialog-Frame :height-chars
     1891           ,input true
     1892           ) .
     1893         run diasize_change-width in this-procedure
     1894           (input session :width-chars
     1895               - frame Dialog-Frame :width-chars
     1896           ,input true
     1897           ) .
     1898         assign
     1899           v-diasize-need-maximize = false
     1900         .
     1901       end.
     1902       else do:
     1903         run diasize_change-width in this-procedure
     1904           (input v-diasize-orig-frame-width
     1905               - frame Dialog-Frame :width-chars
     1906           ,input true
     1907           ) .
     1908         run diasize_change-height in this-procedure
     1909           (input v-diasize-orig-frame-height
     1910               - frame Dialog-Frame :height-chars
     1911           ,input true
     1912           ) .
     1913         assign
     1914           v-diasize-need-maximize = true
     1915         .
     1916       end.
     1917     end.
     1918   end procedure.
     1919   procedure diasize_restore-orig-size :
     1920     do
     1921     on error undo, return error return-value
     1922     :
     1923       assign
     1924         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1925         v-diasize-current-frame-height = frame Dialog-Frame :height
     1926       .
     1927       run diasize_set-height in this-procedure
     1928         (input  v-diasize-orig-frame-height
     1929         ,input  true
     1930         ) .
     1931       run diasize_set-width in this-procedure
     1932         (input  v-diasize-orig-frame-width
     1933         ,input  true
     1934         ) .
     1935     end.
     1936   end procedure.
     1937   procedure diasize_restore-current-size :
     1938     do
     1939     on error undo, return error return-value
     1940     :
     1941       run diasize_set-height in this-procedure
     1942         (input  v-diasize-current-frame-height
     1943         ,input  true
     1944         ) .
     1945       run diasize_set-width in this-procedure
     1946         (input  v-diasize-current-frame-width
     1947         ,input  true
     1948         ) .
     1949     end.
     1950   end procedure.
     1951   procedure diasize_set-browse-handle :
     1952     define input  parameter p-browse-handle as handle   no-undo .
     1953     define buffer buf_temp-browse-handle for temp-browse-handle .
     1954     do
     1955     on error undo, return error return-value
     1956     :
     1957       assign
     1958         v-diasize-browse-handle = p-browse-handle
     1959       .
     1960       for each buf_temp-browse-handle
     1961       on error undo, return error return-value
     1962       :
     1963         delete buf_temp-browse-handle .
     1964       end.
     1965     end.
     1966   end procedure.
     1967   procedure diasize_add_browse :
     1968     define input  parameter p-browse-type   as character no-undo .
     1969     define input  parameter p-browse-handle as handle    no-undo .
     1970     define buffer buf_temp-browse-handle for temp-browse-handle .
     1971     do
     1972     on error undo, return error return-value
     1973     :
     1974       assign
     1975         v-diasize-browse-number = v-diasize-browse-number + 1
     1976       .
     1977       create buf_temp-browse-handle .
     1978       assign
     1979         buf_temp-browse-handle.browse-type   = p-browse-type
     1980         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1981         buf_temp-browse-handle.browse-handle = p-browse-handle
     1982       .
     1983     end.
