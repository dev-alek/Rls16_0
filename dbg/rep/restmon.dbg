     1985   procedure diasize_init :
     1986     define variable v-default-value    as logical   no-undo .
     1987     define variable v-restore-saved    as logical   no-undo .
     1988     define variable v-resize-value-str as character no-undo .
     1989     do
     1990     on error undo, return error return-value
     1991     :
     1992       do with frame Dialog-Frame
     1993       :
     1994         assign
     1995           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1996           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1997           v-diasize-browse-handle     = browse BROWSE-3 :handle
     1998         .
     1999         create button v-diasize-resize-button
     2000         assign
     2001           parent        = frame Dialog-Frame :first-child
     2002           label         = "s"
     2003           height-pixels = 16
     2004           width-pixels  = 16
     2005           visible       = true
     2006           sensitive     = true
     2007           movable       = true
     2008           triggers:
     2009             on end-move persistent run diasize_end-move in this-procedure .
     2010           end triggers.
     2011         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2012         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2013         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2014         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2015         assign
     2016           v-diasize-wndmax = false
     2017         .
     2018         if connected("ub") = true
     2019         then do:
     2020           define variable v-cntxt-db-num        as integer   no-undo .
     2021           define variable v-cntxt-userid        as character no-undo .
     2022           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2023                                             , OUTPUT v-cntxt-userid
     2024                                             ) .
     2025           run gbl/wndpar_r.p
     2026             (input  v-cntxt-db-num
     2027             ,input  v-cntxt-userid
     2028             ,input  'wndmax':U
     2029             ,output v-diasize-wndmax
     2030             ,output v-default-value
     2031             ) .
     2032         end.
     2033         assign
     2034           v-diasize-wndstore = false
     2035         .
     2036         if connected("ub") = true
     2037         then do:
     2038           run gbl/wndpar_r.p
     2039             (input  v-cntxt-db-num
     2040             ,input  v-cntxt-userid
     2041             ,input  'wndstore':U
     2042             ,output v-diasize-wndstore
     2043             ,output v-default-value
     2044             ) .
     2045         end.
     2046         assign
     2047           v-diasize-proc-name = entry(1, program-name(2), '.')
     2048         .
     2049         if v-diasize-wndstore = true
     2050         then do:
     2051           assign
     2052             v-restore-saved = false
     2053           .
     2054           if connected("ub") = true
     2055           then do:
     2056             run gbl/wndsizer.p
     2057               (input  v-cntxt-db-num
     2058               ,input  v-cntxt-userid
     2059               ,input  v-diasize-proc-name
     2060               ,input  'height':u
     2061               ,output v-resize-value-str
     2062               ) .
     2063             if v-resize-value-str <> '':U
     2064             then do:
     2065               run diasize_change-height in this-procedure
     2066                 (input  integer(v-resize-value-str)
     2067                 ,input  true
     2068                 ) .
     2069               assign
     2070                 v-restore-saved = true
     2071               .
     2072             end.
     2073           end.
     2074           if connected("ub") = true
     2075           then do:
     2076             run gbl/wndsizer.p
     2077               (input  v-cntxt-db-num
     2078               ,input  v-cntxt-userid
     2079               ,input  v-diasize-proc-name
     2080               ,input  'width':u
     2081               ,output v-resize-value-str
     2082               ) .
     2083             if v-resize-value-str <> '':U
     2084             then do:
     2085               run diasize_change-width in this-procedure
     2086                 (input  integer(v-resize-value-str)
     2087                 ,input  true
     2088                 ) .
     2089               assign
     2090                 v-restore-saved = true
     2091               .
     2092             end.
     2093           end.
     2094           if v-restore-saved <> true
     2095           then do:
     2096             if v-diasize-wndmax = true
     2097             then do:
     2098               run diasize_maximize in this-procedure
     2099                 (input  true
     2100                 ) .
     2101             end.
     2102           end.
     2103         end.
     2104         else do:
     2105           if v-diasize-wndmax = true
     2106           then do:
     2107             run diasize_maximize in this-procedure
     2108               (input  true
     2109               ) .
     2110           end.
     2111         end.
     2112       end.
     2113     end.
     2114   end procedure.
     2115   procedure diasize_need-full-display :
     2116     define output parameter p-need-full-display as logical   no-undo .
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       assign
     2121         p-need-full-display = v-diasize-need-full-display
     2122       .
     2123       assign
     2124         v-diasize-need-full-display = false
     2125       .
     2126     end.
     2127   end procedure.
     2128   procedure get-context :
     2129      define output parameter p-db-num as integer          no-undo.
     2130      define output parameter p-user-id as character        no-undo.
     2131      define variable v-login               as character    no-undo.
     2132      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2133      define buffer buf_user-login  for ub.user-login .
     2134      do
     2135      on error undo, return error
     2136      :
     2137            FIND FIRST buf_sys-ctrl no-lock.
     2138            ASSIGN
     2139               v-login = USERID("ub")
     2140               p-db-num = buf_sys-ctrl.db-num
     2141            .
     2142            FIND FIRST buf_user-login
     2143                 WHERE buf_user-login.db-num = p-db-num
     2144                   AND buf_user-login.user-login = v-login
     2145                 no-lock
     2146                 no-error
     2147                 .
     2148            IF AVAILABLE buf_user-login
     2149            THEN DO:
     2150               assign
     2151                  p-user-id = buf_user-login.user-id
     2152               .
     2153            END.
     2154      end.
     2155   end procedure.
     2156       run diasize_init in this-procedure .
     2157   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2158   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2159   MAIN-BLOCK:
     2160   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2161      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2162      assign
     2163         v-browser = TRUE
     2164      .
     2165      IF v-cntxt-db-num = 0 then do:
     2166         define buffer buf_clients     for ub.clients.
     2167       define variable v-ok    as logical      no-undo.
     2168       run gbl/userobjs.w
     2169         (input  parparentproc
     2170         ,input  this-procedure :handle
     2171         ,input  v-cntxt-db-num
     2172         ,input  v-cntxt-userid
     2173         ,input  v-cntxt-host-code-obj
     2174         ,input  v-cntxt-obj-type
     2175         ,input  v-cntxt-obj-code
     2176         ,INPUT  "b-sel"
     2177         ,output v-ok
     2178         ,output v-obj-type
     2179         ,output v-obj-code
     2180         ) NO-ERROR.
     2181         if error-status :error
     2182         then do:
     2183            message
     2184               vss-workfile vss-revision vss-description skip
     2185               "Ошибка при выборе объекта" skip
     2186               error-status :get-message(1) skip
     2187               return-value skip
     2188               view-as alert-box error .
     2189            return.
     2190         end.
     2191         IF NOT v-ok THEN dO:
     2192            message
     2193               "Пользователь отказался от выбора объекта" skip
     2194               view-as alert-box error .
     2195            return.
     2196         end.
     2197      end.
     2198      else do:
     2199         assign
     2200               v-obj-type = v-cntxt-obj-type
     2201               v-obj-code = v-cntxt-obj-code
     2202         .
     2203      end.
     2204   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2206     (input  v-obj-type
     2207     ,input  v-obj-code
     2208     ,input  'shift-on=request'
     2209     ,output v-shift-on
     2210     ) no-error .
     2211      if error-status :error then do:
     2212         message
     2213            vss-workfile vss-revision vss-description skip
     2214            "Ошибка при запуске процедуры objat" skip
     2215            error-status :get-message(1) skip
     2216            return-value skip
     2217            view-as alert-box error .
     2218         return.
     2219      end.
     2220      if not v-shift-on then do:
