        1   define input parameter p-mainmenu-handle    as handle           no-undo.
        2   define input parameter Record-Id            as recid            no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Список на отгрузку.".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure cur-time :
       71      define output parameter p-today as date      no-undo .
       72      define output parameter p-time  as integer   no-undo .
       73     do
       74     on error undo, return error
       75     :
       76       define variable v-date1 as date      no-undo .
       77       define variable v-date2 as date      no-undo .
       78       define variable v-time  as integer   no-undo .
       79       assign
       80         v-date1 = today
       81         v-time  = time
       82         v-date2 = today
       83       .
       84       if v-date1 <> v-date2
       85       then do:
       86         assign
       87           v-date1 = today
       88           v-time  = v-time
       89         .
       90       end.
       91       assign
       92         p-today = v-date1
       93         p-time  = v-time
       94       .
       95     end.
       96   end.
       97   function cur-time-date returns character
       98   :
       99     return string(today, '99/99/9999':U) .
      100   end.
      101   function cur-time-mjd returns decimal
      102   :
      103     define variable v-date as date      no-undo .
      104     define variable v-time as integer   no-undo .
      105     run cur-time in this-procedure
      106       (output v-date
      107       ,output v-time
      108       ) .
      109     return integer(v-date) - 2400002 + (v-time / 86400) .
      110   end.
      111   function cur-time-get-ending-index returns integer
      112   (input p-number as integer
      113   )
      114   :
      115     if p-number < 0
      116     or p-number = ?
      117     then do:
      118       return 1 .
      119     end.
      120     define variable v-rest as integer   no-undo .
      121     assign
      122       p-number = p-number modulo 100
      123     .
      124     if p-number < 20
      125     then do:
      126       assign
      127         v-rest = p-number
      128       .
      129     end.
      130     else do:
      131       assign
      132         v-rest = p-number modulo 10
      133       .
      134     end.
      135     case v-rest :
      136       when 1
      137       then do:
      138         return 2 .
      139       end.
      140       when 2 or
      141       when 3 or
      142       when 4
      143       then do:
      144         return 3 .
      145       end.
      146       otherwise do:
      147         return 1 .
      148       end.
      149     end case .
      150   end.
      151   procedure cur-time-mjd-to-date :
      152      define input  parameter i-mjd-diff as decimal no-undo.
      153      define output parameter o-Date     as date    no-undo.
      154      define output parameter o-Time     as integer no-undo.
      155      define variable v-day-number as integer   no-undo .
      156      if    i-mjd-diff < 0
      157         or i-mjd-diff = ?
      158      then do:
      159         return "?" .
      160      end.
      161      assign
      162         v-day-number = truncate(i-mjd-diff,0).
      163         o-Date = date(v-day-number + 2400002).
      164         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      165     .
      166   end.
      167   function cur-time-mjd-to-string returns character
      168   (input p-mjd-diff as decimal
      169   )
      170   :
      171     define variable v-day-number as integer   no-undo .
      172     define variable v-seconds    as integer   no-undo .
      173     define variable v-hour       as integer   no-undo .
      174     define variable v-min        as integer   no-undo .
      175     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      176     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      177     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      178     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      179     if p-mjd-diff < 0
      180     or p-mjd-diff = ?
      181     then do:
      182       return "?" .
      183     end.
      184     assign
      185       v-day-number = integer(truncate(p-mjd-diff,0))
      186       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188     if v-seconds > 86400
      189     then do:
      190       assign
      191         v-seconds = 86400 - 1
      192       .
      193     end.
      194     if v-seconds < 0
      195     then do:
      196       assign
      197         v-seconds = 0
      198       .
      199     end.
      200     assign
      201       v-hour = truncate(v-seconds / 3600, 0)
      202     .
      203     assign
      204       v-seconds = v-seconds modulo 3600
      205     .
      206     assign
      207       v-min = truncate(v-seconds / 60, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 60
      211     .
      212     return
      213         (if v-day-number <> 0
      214           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0
      218           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      222           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      223           else ""
      224         )
      225       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      226       .
      227   end.
      228   function cur-time-string returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-string-sec returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      247   end.
      248   function cur-time-custom  returns character
      249   (input p-prefix as character
      250   ,input p-date-format as character
      251   ,input p-delimiter as character
      252   ,input p-time-format as character
      253   ,input p-suffix as character
      254   )
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return
      263       p-prefix
      264       + string(v-date, p-date-format)
      265       + p-delimiter
      266       + string(v-time, p-time-format)
      267       + p-suffix
      268       .
      269   end.
      270   function cur-time-print  returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-datetime returns datetime
      281   :
      282     define variable v-char as character no-undo .
      283     define variable v-datetime as datetime no-undo .
      284     v-char = cur-time-string().
      285     v-datetime = datetime(v-char).
      286     return  v-datetime.
      287   end.
      288   function cur-time-string-msec returns character
      289   :
      290     define variable v-date as datetime  no-undo .
      291     v-date = now.
      292     return string(v-date) .
      293   end.
      294   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      296   define  shared variable RepPathName        as character no-undo .
      297   define  shared variable PrintRubl          as logical   no-undo .
      298   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299     define variable v-cntxt-db-num        as integer   no-undo .
      300     define variable v-cntxt-userid        as character no-undo .
      301     define variable v-cntxt-level         as character no-undo .
      302     define variable v-cntxt-host-code-obj as integer   no-undo .
      303     define variable v-cntxt-obj-type      as character no-undo .
      304     define variable v-cntxt-obj-code      as integer   no-undo .
      305     define variable v-cntxt-db-num-obj    as integer   no-undo .
      306     define variable v-cntxt-is-admin      as logical   no-undo .
      307   procedure proc-alt-shift-f2:
      308     if not ibs.th.gbl.gbl-var:rcode
      309   then
      310     run gbl\inidebug.p .
      311   end.
      312   procedure proc-alt-shift-f3:
      313     run gbl/prvssinf.p
      314       ( input this-procedure
      315       ) .
      316   end.
      317   define variable v-inform-launched as logical no-undo initial false .
      318   procedure proc-alt-shift-f4:
      319     define variable v-action as character no-undo .
      320     if v-inform-launched = false then do:
      321       assign
      322         v-inform-launched = true
      323       .
      324       run gbl/d-inform.w
      325         (  input self
      326         ,  input this-procedure
      327         , output v-action
      328         ) no-error .
      329       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      330       assign
      331         v-inform-launched = false
      332       .
      333     end.
      334   end.
      335   procedure proc-alt-f1:
      336     run gbl/corrhelp.p
      337       (input this-procedure
      338       ) .
      339   end .
      340   on alt-shift-f2 anywhere do:
      341     run proc-alt-shift-f2.
      342   end.
      343   on alt-shift-f3 anywhere do:
      344     run proc-alt-shift-f3 in this-procedure .
      345   end.
      346   on alt-shift-f4 anywhere do:
      347     run proc-alt-shift-f4 in this-procedure.
      348   end.
      349   on alt-f1 anywhere do:
      350     run proc-alt-f1 in this-procedure .
      351   end.
      352   def     buffer  cli-prod        for     clients .
      353   def     buffer  bR-trn-doc   for     trn-doc .
      354   define variable Log-Res1       as      log         no-undo.
      355   define variable Log-Res2       as      log         no-undo.
      356   define variable sym0 as char init ":"   no-undo.
      357   define variable sym1 as char init ":"   no-undo.
      358   define variable sym2 as char init ":"   no-undo.
      359   define variable sym3 as char init ":"   no-undo.
      360   define variable sym4 as char init ":"   no-undo.
      361   define variable sym5 as char init ":"   no-undo.
      362   define variable sym6 as char init ":"   no-undo.
      363   define variable sym7 as char init ":"   no-undo.
      364   define variable  Line               as    char   no-undo.
      365   define variable  tb-code          as    char   no-undo.
      366   define variable  rsrv-FactDate  as  date    no-undo .
      367   define variable  ind                            as    int                no-undo.
      368   define variable rootnode_code        as      integer       no-undo.
      369   def stream RepStr .
      370   def stream  i_inp1.
      371       define variable  InputFileName    as  char    no-undo.
      372       define variable  text-string            as  char    FORMAT "x(232)" no-undo .
      373       define variable g#report-num    as integer      no-undo.
      374       define variable g#quest-print   as logical      no-undo.
      375       define variable g#log           as logical      no-undo.
      376   DEFINE WORK-TABLE doc-recids no-undo
      377       field   DocRecid    as  recid
      378       field   doc-code     like trn-doc.doc-code
      379       .
      380   def FRAME DocsList
      381           sym0 column-label ":!:" format "X(1)"
      382           ind column-label "N!п/п" format ">>9"
      383           sym1 column-label ":!:" format "X(1)"
      384           trn-doc.rsrv-date column-label "Дата!отгрузки" format "99/99/9999"
      385           sym2 column-label ":!:" format "X(1)"
      386           trn-doc.doc-code column-label "Номер!документа" format "X(11)"
      387           sym3 column-label ":!:" format "X(1)"
      388           trn-doc.cli-name column-label "Контрагент! " format "X(60)"
      389           sym4 column-label ":!:" format "X(1)"
      390           trn-doc.doc-qnty column-label "Количество! " format "->>,>>>,>>9.999"
      391           sym5 column-label ":!:" format "X(1)"
      392       HEADER
      393           cur-time-print() AT 5 format "X(35)"
      394               "Страница " AT 100 PAGE-NUMBER( RepStr ) AT 110 FORMAT ">>9" SKIP
      395           Line format "X(115)" AT 1
      396       with width 160 down stream-io NO-BOX.
      397   DEFINE FRAME GoodsList
      398           sym1 column-label ":!:" format "X(1)"
      399           ind column-label "N!п/п" format ">>9"
      400           sym3 column-label ":!:" format "X(1)"
      401           doc-line.artic column-label "Артикул! " format "X(20)"
      402           sym4 column-label ":!:" format "X(1)"
      403           goods.gds-name column-label "Название товара! " format "X(50)"
      404           sym2 column-label ":!:" format "X(1)"
      405           tb-code column-label "Код! " format "x(10)"
      406           sym5 column-label ":!:" format "X(1)"
      407           goods.unit-base column-label "Единица!измерения" format "X(9)"
      408           sym6 column-label ":!:" format "X(1)"
      409           doc-line.doc-qnty column-label "Количество!единиц" format ">>>,>>>,>>9.99"
      410           sym7 column-label ":!:" format "X(1)"
      411       HEADER
      412           cur-time-print() AT 5 format "X(35)"
      413               "Страница " AT 110 PAGE-NUMBER ( RepStr ) AT 120 FORMAT ">>9" SKIP
      414           Line format "X(125)" AT 1
      415       with width 160 down stream-io .
      416   DEFINE BUTTON b-help
      417        LABEL "&Помощь":L
      418        SIZE 10 BY 1
      419        BGCOLOR 8 .
      420   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      421        LABEL "&Отмена":L
      422        SIZE 10 BY 1
      423        BGCOLOR 8 .
      424   DEFINE BUTTON Btn_OK
      425        LABEL "&Ввод ":L
      426        SIZE 10 BY 1
      427        BGCOLOR 8 .
      428   DEFINE VARIABLE startdate AS DATE FORMAT "99/99/9999":U
      429        LABEL "Введите дату отгрузки"
      430        VIEW-AS FILL-IN
      431        SIZE 11 BY 1
      432        BGCOLOR 15  NO-UNDO.
      433   DEFINE RECTANGLE RECT-1
      434        EDGE-PIXELS 2 GRAPHIC-EDGE
      435        SIZE 46.5 BY 6.75.
      436   DEFINE VARIABLE NotPrint-GdsList AS LOGICAL INITIAL no
      437        LABEL "Не выводить список товаров на отгрузку"
      438        VIEW-AS TOGGLE-BOX
      439        SIZE 42.5 BY .75 NO-UNDO.
      440   DEFINE VARIABLE Repeated AS LOGICAL INITIAL no
      441        LABEL "Повторно в набор"
      442        VIEW-AS TOGGLE-BOX
      443        SIZE 18.5 BY 1 NO-UNDO.
      444   DEFINE FRAME DLGOKCAN
      445        Btn_OK AT ROW 1 COL 1
      446        Btn_Cancel AT ROW 1 COL 11
      447        b-help AT ROW 1 COL 21
      448        startdate AT ROW 3.5 COL 25 COLON-ALIGNED
      449        Repeated AT ROW 5.5 COL 15
      450        NotPrint-GdsList AT ROW 7.5 COL 4
      451        RECT-1 AT ROW 2.5 COL 1.5
      452        SPACE(1.12) SKIP(0.57)
      453       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      454            SIDE-LABELS THREE-D  SCROLLABLE
      455            BGCOLOR 8 FGCOLOR 0
      456            TITLE BGCOLOR 8 FGCOLOR 1 "Отправить в набор":L
      457            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      458   ASSIGN
      459          FRAME DLGOKCAN:SCROLLABLE       = FALSE.
      460   ON CHOOSE OF Btn_OK IN FRAME DLGOKCAN
      461   DO:
      462       assign startdate Repeated NotPrint-GdsList .
      463       FOR EACH doc-recids :
      464           delete doc-recids .
      465       END.
      466       if can-find( first trn-doc WHERE trn-doc.obj-type = v-cntxt-obj-type AND
      467                                        trn-doc.obj-code = v-cntxt-obj-code AND
      468                                        trn-doc.rsrv-date = startdate AND
      469                                        trn-doc.doc-type = 'рас':U AND
      470                                        trn-doc.status_ = 'разрешен':U AND
      471                                        trn-doc.flag_ )
      472                                        OR
      473          can-find( first trn-doc WHERE recid( trn-doc ) = Record-Id AND ( not trn-doc.flag_ ) ) then
      474           do:
      475               RUN main_proc.
      476               if return-value <> "Bad-Reading"
      477               then do:
      478   if g#quest-print = false
      479   then do:
      480     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      481                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
      482                                         OUTPUT g#log ).
      483   end.
      484   else do:
      485     os-command silent
      486       value( "COPY /b " +
      487         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      488         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      489         string( session:temp-directory) +  "$" + string( g#report-num )
      490                 ) .
      491     os-command silent
      492       value( "COPY /b " +
      493         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      494         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      495         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      496                 ) .
      497   end.
      498               end.
      499           end.
      500       else
      501           message "Нет ни одного документа," skip
      502                           "подготовленного к отгрузке" skip
      503                           "на текущем объекте" skip
      504                           "в указанный Вами день."
      505                           view-as alert-box information buttons ok .
      506   END.
      507   ON VALUE-CHANGED OF NotPrint-GdsList IN FRAME DLGOKCAN
      508   DO:
      509       assign NotPrint-GdsList .
      510   END.
      511   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      512   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      513   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   on help of frame DLGOKCAN
      515   do:
      516     run gbl/app_help.p
      517       (input this-procedure :file-name
      518       ,input ''
      519       ,input ?
      520       ) no-error.
      521     if error-status :error then do:
      522       message
      523         "Ошибка при вызове помощи"
      524         error-status :get-message(1)
      525         view-as alert-box .
      526     end.
      527   end.
      528   run minbtn-set in this-procedure .
      529   on choose of b-help in frame DLGOKCAN
      530   do:
      531     apply "help":u to frame DLGOKCAN .
      532   end.
      533   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      534   procedure minbtn-set :
      535       do
      536           on error undo, return error return-value
      537           :
      538           define variable ii              as integer       no-undo .
      539           define variable fh              as widget-handle no-undo .
      540           define variable hh              as widget-handle no-undo .
      541           define variable v-h             as handle        extent 4 no-undo .
      542           define variable v-name-button   as character     no-undo .
      543           define variable v-help-old-x    as decimal       no-undo .
      544           define variable v-help-old-y    as decimal       no-undo .
      545           define variable v-help-old-size as decimal       no-undo .
      546           define variable v-frame-width   as decimal       no-undo .
      547           define variable jj              as integer       no-undo .
      548           do
      549               on error undo, return error
      550               :
      551               assign
      552                   v-frame-width = frame DLGOKCAN:width - 0.3
      553                   fh            = frame DLGOKCAN:first-child
      554                   hh            = fh:first-child
      555                   ii            = 1
      556                   .
      557               do while valid-handle(hh):
      558                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      559                   do:
      560                       case lc(hh:name) :
      561                           when "b-help" then
      562                               do:
      563                                   hh:load-image-up("cmp/b-help.bmp":u) .
      564                                   hh:load-image-down("cmp/b-help.bmp":u) .
      565                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      566                                   hh:TOOLTIP = "Помощь" .
      567                                   v-help-old-x = hh:column .
      568                                   v-help-old-y = hh:row    .
      569                                   v-help-old-size = hh:width .
      570                                   hh:width-chars = 2.5 .
      571                               end.
      572                           when "b-print" then
      573                               do:
      574                                   hh:load-image("cmp/b-print.bmp":u) .
      575                                   hh:TOOLTIP = "Печать" .
      576                                   v-h[ii] = hh:handle .
      577                                   ii = ii + 1 .
      578                                   hh:width-chars = 3 .
      579                               end.
      580                           when "b-history" or
      581                           when "b-hist" then
      582                               do:
      583                                   hh:load-image("cmp/b-hist.bmp":u) .
      584                                   hh:TOOLTIP = "История" .
      585                                   v-h[ii] = hh:handle .
      586                                   ii = ii + 1 .
      587                                   hh:width-chars = 3 .
      588                               end.
      589                           when "b-sch" then
      590                               do:
      591                                   hh:load-image("cmp/b-sch.bmp":u) .
      592                                   hh:TOOLTIP = "Установка Фильтра" .
      593                                   v-h[ii] = hh:handle .
      594                                   ii = ii + 1 .
      595                                   hh:width-chars = 3 .
      596                               end.
      597                           when "b-hist-user" then
      598                               do:
      599                                   hh:load-image("cmp/b-hist.bmp":u) .
      600                                   hh:TOOLTIP = "История пользователя" .
      601                                   ii = ii + 1 .
      602                               end.
      603                       end case.
      604                   end.
      605                   hh = hh:next-sibling.
      606               end.
      607               b-help:column = v-frame-width - b-help:width-chars.
      608               jj = 0.
      609               repeat ii = 4 to 1 by -1 :
      610                   if valid-handle (v-h[ii] ) then
      611                   do:
      612                       jj  = jj + 1 .
      613                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      614                       v-h[ii]:row    = v-help-old-y .
      615                   end.
      616               end.
      617           end.
      618       end.
      619   end procedure.
      620   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
      621   define variable v-today as date      no-undo.
      622   define variable v-time  as integer   no-undo.
      623   run cur-time in this-procedure ( output v-today
      624                                  , output v-time
      625                                  ).
      626   assign startdate = v-today .
      627   MAIN-BLOCK:
      628   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      629      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      630   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631     run mainmenu_getcntxt in p-mainmenu-handle
      632       (output v-cntxt-db-num
      633       ,output v-cntxt-userid
      634       ,output v-cntxt-level
      635       ,output v-cntxt-host-code-obj
      636       ,output v-cntxt-obj-type
      637       ,output v-cntxt-obj-code
      638       ,output v-cntxt-db-num-obj
      639       ,output v-cntxt-is-admin
      640       ) .
      641       run get-report-num in p-mainmenu-handle (
      642           output g#report-num
      643       ).
      644       run get-quest-print in p-mainmenu-handle (
      645           output g#quest-print
      646       ).
      647       RUN enable_UI.
      648   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649   do:
      650     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      651       (input  v-cntxt-db-num
      652       ,input  v-cntxt-userid
      653       ,input  0
      654       ,input  'actn_composition-reprint_print':U
      655       ,input  'firm':U
      656       ,input  v-cntxt-host-code-obj
      657       ,input  '':U
      658       ,input  0
      659       ,input  0
      660       ,input  0
      661       ,input  0
      662       ,input  false
      663       ,output Log-Res1
      664       )  .
      665   end.
      666       if not Log-Res1
      667       then do:
      668           DISABLE Repeated WITH FRAME DLGOKCAN.
      669       end.
      670   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   do:
      672     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      673       (input  v-cntxt-db-num
      674       ,input  v-cntxt-userid
      675       ,input  0
      676       ,input  'actn_composition-print_print':U
      677       ,input  'firm':U
      678       ,input  v-cntxt-host-code-obj
      679       ,input  '':U
      680       ,input  0
      681       ,input  0
      682       ,input  0
      683       ,input  0
      684       ,input  false
      685       ,output Log-Res2
      686       )  .
      687   end.
      688       if not ( Log-Res1 OR Log-Res2 )
      689       then do:
      690               message
      691                   "У Вас недостаточно ПРАВ" skip
      692                   "для выполнения данного действия." skip
      693                   "Обратитесь к администратору" skip
      694                   "системы." view-as alert-box error.
      695               LEAVE MAIN-BLOCK .
      696       end.
      697       WAIT-FOR GO OF FRAME DLGOKCAN.
      698   END.
      699   RUN disable_UI.
      700   PROCEDURE disable_UI :
      701     HIDE FRAME DLGOKCAN.
      702   END PROCEDURE.
      703   PROCEDURE enable_UI :
      704     DISPLAY startdate Repeated NotPrint-GdsList
      705         WITH FRAME DLGOKCAN.
      706     ENABLE Btn_OK Btn_Cancel b-help RECT-1 startdate Repeated NotPrint-GdsList
      707         WITH FRAME DLGOKCAN.
      708   END PROCEDURE.
      709   PROCEDURE main_proc :
      710   define buffer b-trn-doc for trn-doc .
      711   if session :set-wait-state( "compiler" ) then.
      712       Line = fill( "-", 140) .
      713       output stream RepStr to value( string( session:temp-directory +
      714                                        "plt" + string( g#report-num ) ) ) page-size 62 .
      715       FIND clients WHERE clients.obj-type = v-cntxt-obj-type AND
      716                                          clients.obj-code = v-cntxt-obj-code NO-LOCK .
      717       FORM HEADER
      718                   Line format "X(115)" AT 1 SKIP
      719                   "Продолжение - на следующей странице" AT 30 SKIP
      720                   with FRAME BottomFrame-1 width 160 PAGE-BOTTOM no-labels no-box.
      721       VIEW stream RepStr FRAME BottomFrame-1 .
      722       PUT stream RepStr space(10) CAPS( clients.obj-name ) format "x(100)" SKIP(1) .
      723       PUT stream RepStr space(30) string( "Список документов на отгрузку за " +
      724               string( ( if Repeated then rsrv-FactDate else startdate ), "99/99/9999" ) + "." )
      725               format "x(100)" SKIP(2) .
      726       FORM with frame DocsList .
      727       DO FOR b-trn-doc :
      728           if Repeated then
      729               FOR EACH b-trn-doc WHERE b-trn-doc.obj-type = v-cntxt-obj-type    AND
      730                                        b-trn-doc.obj-code  = v-cntxt-obj-code   AND
      731                                        b-trn-doc.doc-type  = 'рас':U   AND
      732                                        b-trn-doc.status_   = 'разрешен':U AND
      733                                        b-trn-doc.rsrv-date = rsrv-FactDate
      734                                        use-index obj-load
      735                                        SHARE-LOCK BREAK BY b-trn-doc.doc-code :
      736                   FIND LAST doc-recids NO-ERROR .
      737                   CREATE doc-recids.
      738                   assign
      739                       doc-recids.DocRecid = recid( b-trn-doc )
      740                       doc-recids.doc-code = b-trn-doc.doc-code .
      741                   ACCUMULATE b-trn-doc.doc-code ( COUNT )
      742                                           b-trn-doc.doc-qnty ( TOTAL ) .
      743                   DISPLAY stream RepStr
      744                       sym0 ( ACCUM COUNT b-trn-doc.doc-code ) @ ind
      745                       sym1 b-trn-doc.fact-date @ trn-doc.fact-date
      746                       sym2 b-trn-doc.doc-code @ trn-doc.doc-code
      747                       sym3 b-trn-doc.cli-name @ trn-doc.cli-name
      748                       sym4 b-trn-doc.doc-qnty @ trn-doc.doc-qnty
      749                       sym5 with frame DocsList .
      750                   DOWN stream RepStr 1 with frame DocsList .
      751               END .
      752           else
      753               FOR EACH b-trn-doc WHERE b-trn-doc.obj-type = v-cntxt-obj-type  AND
      754                                        b-trn-doc.obj-code = v-cntxt-obj-code  AND
      755                                        b-trn-doc.status_ = 'разрешен':U AND
      756                                        b-trn-doc.rsrv-date = startdate  AND
      757                                        b-trn-doc.flag_                  AND
      758                                        b-trn-doc.doc-type = 'рас':U
      759                                        SHARE-LOCK BREAK BY b-trn-doc.doc-code :
      760                   FIND LAST doc-recids NO-ERROR .
      761                   CREATE doc-recids.
      762                   assign
      763                       doc-recids.DocRecid = recid( b-trn-doc )
      764                       doc-recids.doc-code = b-trn-doc.doc-code .
      765                   ACCUMULATE b-trn-doc.doc-code ( COUNT )
      766                                           b-trn-doc.doc-qnty ( TOTAL ) .
      767                   DISPLAY stream RepStr
      768                       sym0 ( ACCUM COUNT b-trn-doc.doc-code ) @ ind
      769                       sym1 b-trn-doc.fact-date @ trn-doc.fact-date
      770                       sym2 b-trn-doc.doc-code @ trn-doc.doc-code
      771                       sym3 b-trn-doc.cli-name @ trn-doc.cli-name
      772                       sym4 b-trn-doc.doc-qnty @ trn-doc.doc-qnty
      773                       sym5 with frame DocsList .
      774                   DOWN stream RepStr 1 with frame DocsList .
      775               END .
      776           PUT stream RepStr Line format "x(115)" SKIP .
      777           DISPLAY stream RepStr
      778                               "ИТОГО" @ trn-doc.doc-code
      779                               ( ACCUM TOTAL b-trn-doc.doc-qnty ) @ trn-doc.doc-qnty
      780                               with frame DocsList .
      781           DOWN stream RepStr 1 with frame DocsList .
      782           UNDERLINE stream RepStr trn-doc.doc-code trn-doc.doc-qnty with frame DocsList .
      783           HIDE stream RepStr FRAME BottomFrame-1 .
      784           output stream RepStr CLOSE .
      785           FOR EACH doc-recids BREAK BY doc-recids.doc-code :
      786                   FIND b-trn-doc WHERE recid( b-trn-doc ) = doc-recids.DocRecid NO-LOCK .
      787                   ACCUMULATE b-trn-doc.doc-code ( COUNT ) .
      788                   if first( doc-recids.doc-code ) then
      789                       run rep/r-outret.p ( input p-mainmenu-handle, input doc-recids.DocRecid, input no) .
      790                   else
      791                       run rep/r-outret.p ( input p-mainmenu-handle, input doc-recids.DocRecid, input no) .
      792   if session :set-wait-state( "" ) then.
      793           END .
      794           InputFileName = "plt" .
      795   output     to value( string( session:temp-directory +
      796                                        "rpt" + string( g#report-num ) ) )
      797                                        page-size 62 append .
      798   define variable vss-include-info8 as character format "X(65)" no-undo
      799   initial "@(#)$Workfile$ $Revision$".
      800   DO WHILE PrintCopiesCounter <> 0 :
      801       INPUT stream i_inp1
      802           FROM value ( string( session:temp-directory + InputFileName + string( g#report-num ) ) ).
      803       FORM with FRAME x1 .
      804       REPEAT on endkey undo, leave :
      805           DO on endkey undo, leave:
      806               IMPORT stream  i_inp1 UNFORMATTED text-string NO-ERROR.
      807           END.
      808           IF ERROR-STATUS:ERROR THEN
      809               UNDO, LEAVE.
      810           if integer ( asc ( substring ( text-string, 1, 1 ) ) ) = 12
      811              and "yes" = "yes" then
      812               text-string = substring ( text-string, 2 ) .
      813           DISPLAY text-string no-label with width 235 DOWN FRAME x1 .
      814           DOWN WITH FRAME x1.
      815           text-string = "".
      816       END.
      817       PrintCopiesCounter = PrintCopiesCounter - 1.
      818       INPUT stream i_inp1 CLOSE.
      819   END.
      820   PrintCopiesCounter = 1.
      821           DO WHILE line-counter <= page-size :
      822               PUT " " SKIP .
      823           END.
      824           output CLOSE .
      825           if NOT NotPrint-GdsList then
      826               do:
      827   output stream RepStr to value( string( session:temp-directory +
      828                                        "rpt" + string( g#report-num ) ) )
      829                                        page-size 62 append .
      830                   PUT stream RepStr space(10) CAPS( clients.obj-name ) format "x(100)" SKIP(1) .
      831                   PUT stream RepStr space(30) string( "Список товаров на отгрузку за " +
      832                           string( ( if Repeated then rsrv-FactDate else startdate ), "99/99/9999" ) + "." )
      833                           format "x(100)" SKIP(2) .
      834                   FORM HEADER
      835                       Line format "X(125)" AT 1 SKIP
      836                       "Продолжение - на следующей странице" AT 30 SKIP
      837                       with FRAME BottomFrame-2 width 160 PAGE-BOTTOM no-labels no-box.
      838                   VIEW stream RepStr FRAME BottomFrame-2 .
      839                   ind = 0 .
      840                   FOR EACH doc-recids ,
      841                           EACH doc-line WHERE doc-line.doc-code = doc-recids.doc-code NO-LOCK
      842                               BREAK BY string( doc-line.prod-type + string( doc-line.prod-code ) )
      843                                            BY doc-line.artic
      844                                            with frame GoodsList :
      845                       if first-of( string( doc-line.prod-type + string( doc-line.prod-code ) ) ) then
      846                           do:
      847                               if NOT first( string( doc-line.prod-type + string( doc-line.prod-code ) ) ) then
      848                                   UNDERLINE stream RepStr doc-line.artic goods.gds-name .
      849                               FIND cli-prod WHERE cli-prod.obj-type = doc-line.prod-type AND
      850                                                                   cli-prod.obj-code = doc-line.prod-code NO-LOCK .
      851                               DISPLAY stream RepStr
      852                                           "Производитель" @ doc-line.artic
      853                                           cli-prod.obj-name @ goods.gds-name .
      854                               DOWN stream RepStr 1 .
      855                               UNDERLINE stream RepStr doc-line.artic goods.gds-name .
      856                           end.
      857                       FIND goods WHERE goods.prod-type = doc-line.prod-type AND
      858                                                     goods.prod-code = doc-line.prod-code AND
      859                                                     goods.artic = doc-line.artic NO-LOCK .
      860                       FIND gds-prt where gds-prt.upper-code = doc-line.prt-root NO-LOCK .
      861                       rootnode_code = gds-prt.node-code .
      862                       FIND bar-code WHERE bar-code.gds-code = goods.gds-code AND
      863                                         bar-code.unit-cli = goods.unit-base AND
      864                                         bar-code.node-code = rootnode_code AND
      865                                         bar-code.part-code = "" AND
      866                                         bar-code.in-code = ""
      867                                         NO-LOCK NO-ERROR.
      868                       if not available bar-code then
      869                           tb-code = "?".
      870                       else
      871                           tb-code = trim ( string (bar-code.b-code )) .
      872                       ACCUMULATE doc-line.doc-qnty ( SUB-TOTAL BY doc-line.artic )
      873                                               doc-line.doc-qnty ( TOTAL )
      874                                               doc-line.artic ( COUNT ) .
      875                       if last-of( doc-line.artic ) then
      876                           do:
      877                               ind = ind + 1 .
      878                               DISPLAY stream RepStr
      879                                       sym1 ind
      880                                       sym3 doc-line.artic
      881                                       sym4 goods.gds-name
      882                                       sym2 tb-code
      883                                       sym5 goods.unit-base
      884       sym6 ( ACCUM SUB-TOTAL BY doc-line.artic doc-line.doc-qnty ) @ doc-line.doc-qnty
      885                                       sym7 .
      886                               DOWN stream RepStr 1 .
      887                           end.
      888                       if last( string( doc-line.prod-type + string( doc-line.prod-code ) ) ) then
      889                           do:
      890                               PUT stream RepStr Line format "x(125)" SKIP .
      891                               DISPLAY stream RepStr
      892                                   "ИТОГО" @ doc-line.artic
      893                                   ( ACCUM TOTAL doc-line.doc-qnty ) @ doc-line.doc-qnty .
      894                               DOWN stream RepStr 1 .
      895                               UNDERLINE stream RepStr doc-line.artic doc-line.doc-qnty .
      896                           end.
      897                   END .
      898                   HIDE stream RepStr FRAME BottomFrame-2 .
      899                   output stream RepStr CLOSE .
      900               end.
      901   if session :set-wait-state( "" ) then.
      902           if NOT Repeated then
      903               do:
      904                   FOR EACH doc-recids ,
      905                           EACH b-trn-doc OF doc-recids EXCLUSIVE-LOCK
      906                               on error undo, return "Bad-Reading" :
      907                           delete doc-recids .
      908                   END .
      909               end.
      910       END.
      911   END PROCEDURE.
