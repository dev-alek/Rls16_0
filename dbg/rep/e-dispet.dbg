      787   define new global shared variable g#library  as handle no-undo .
      788   define new global shared variable g#library2 as handle no-undo .
      789   define variable var-report-r-b as character no-undo .
      790   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      792     (output var-report-r-b
      793     )  .
      794   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   procedure gen-key-rec :
      796     define input  parameter p-tbl-name    as character no-undo.
      797     define input  parameter p-bh_tbl-name as handle    no-undo.
      798     define output parameter p-key-rec     as character no-undo.
      799     do
      800     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      801     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      802     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      803     :
      804       define variable fh               as handle    no-undo .
      805       define variable v-ok             as logical   no-undo .
      806       define variable v-inform         as character no-undo .
      807       define variable v-ind            as integer   no-undo .
      808       define variable v-idx-field-qnty as integer   no-undo .
      809       if p-tbl-name = ?
      810         or p-tbl-name = "":U
      811       then do:
      812         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
      813       end.
      814       if not p-bh_tbl-name:available then do:
      815         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
      816       end.
      817       assign
      818         p-key-rec = p-tbl-name
      819         v-inform  = p-bh_tbl-name:index-information(1)
      820         v-ind     = 2
      821       .
      822       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      823       on error undo, return error
      824       :
      825         assign
      826           v-inform = p-bh_tbl-name:index-information( v-ind )
      827           v-ind    = v-ind + 1
      828         .
      829       end.
      830       if v-inform = ?
      831         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      832         or entry( 3, v-inform, ",":U ) <> "1":U
      833       then do:
      834         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
      835       end.
      836       else do:
      837         assign
      838           v-idx-field-qnty = num-entries( v-inform ) - 4
      839         .
      840         if v-idx-field-qnty < 2 then do:
      841           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
      842         end.
      843         do v-ind = 1 to v-idx-field-qnty by 2
      844         on error undo, return error
      845         :
      846           assign
      847             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      848             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      849           .
      850         end.
      851       end.
      852       if p-key-rec = ? then do:
      853         assign
      854           p-key-rec = "":U
      855         .
      856         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
      857       end.
      858     end.
      859     return.
      860   end procedure.
      861   procedure gen-where-keyr-tab :
      862     define input  parameter i-tableSerach as character no-undo.
      863     define input  parameter i-tablekey   as character  no-undo.
      864     define input  parameter p-key-rec    as character  no-undo.
      865     define input  parameter p-key-handle as handle     no-undo .
      866     define input  parameter p-db-name    as character  no-undo .
      867     define input  parameter p-tt-handle  as handle     no-undo .
      868     define output parameter o-Where      as character  no-undo.
      869     do
      870     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      871     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      872     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      873     :
      874       define variable v-full-tbl-name  as character no-undo .
      875       define variable bh_tbl-name      as handle    no-undo .
      876       define variable fh_key           as handle    no-undo .
      877       define variable fh_search        as handle    no-undo .
      878       define variable v-field-num      as integer   no-undo .
      879       define variable v-count-fld      as integer   no-undo .
      880       define variable v-inform         as character no-undo .
      881       define variable v-ind            as integer   no-undo .
      882       define variable v-idx-field-qnty as integer   no-undo .
      883       define variable v-field-name     as character no-undo .
      884       define variable v-field-val      as character no-undo .
      885       define variable v-word-link      as character no-undo .
      886       define variable vTable           as character no-undo.
      887       define variable bh_tbl-key       as handle    no-undo .
      888       assign
      889         p-key-rec = trim( p-key-rec )
      890       .
      891       if p-key-handle <> ? then do:
      892         if not valid-handle(p-key-handle)
      893            or p-key-handle:type <> "buffer"
      894         then do:
      895           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
      896         end.
      897         if num-entries( p-key-rec, chr(3) ) > 1
      898           or p-key-rec = ?
      899           or p-key-rec = "":U
      900         then do:
      901           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
      902         end.
      903       end.
      904       else do:
      905         if p-key-rec = ?
      906           or p-key-rec = "":U
      907         then do:
      908           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
      909         end.
      910       end.
      911       assign
      912         vTable = entry( 1 , p-key-rec, chr(3) )
      913       .
      914       if p-tt-handle <> ?
      915         and ( not valid-handle(p-tt-handle)
      916               or p-tt-handle:type <> "buffer"
      917             )
      918       then do:
      919         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
      920       end.
      921       if p-tt-handle = ? then do:
      922         assign
      923           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      924         .
      925         create buffer bh_tbl-name for table v-full-tbl-name .
      926       end.
      927       else do:
      928         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      929       end.
      930       assign
      931         v-inform = bh_tbl-name:index-information(1)
      932         v-ind    = 2
      933       .
      934       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      935       on error undo, return error
      936       :
      937         assign
      938           v-inform = bh_tbl-name:index-information( v-ind )
      939           v-ind    = v-ind + 1
      940         .
      941       end.
      942       if v-inform = ?
      943         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      944         or entry( 3, v-inform, ",":U ) <> "1":U
      945       then do:
      946         delete object bh_tbl-name no-error.
      947         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
      948       end.
      949       assign
      950         v-idx-field-qnty = num-entries( v-inform ) - 4
      951       .
      952       if v-idx-field-qnty < 2 then do:
      953         delete object bh_tbl-name no-error.
      954         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
      955       end.
      956       assign
      957         o-where     = "where":U
      958         v-word-link = "":U
      959         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      960         v-count-fld = 0
      961       .
      962       if i-tablekey ne "" and i-tablekey ne ?
      963       then do:
      964         assign
      965           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      966         .
      967         create buffer bh_tbl-key for table v-full-tbl-name .
      968       end.
      969       if i-tableSerach ne "" and i-tableSerach ne ?
      970       then do:
      971         delete object bh_tbl-name no-error.
      972         assign
      973           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      974         .
      975         create buffer bh_tbl-name for table v-full-tbl-name .
      976       end.
      977       block_where:
      978       do v-ind = 1 to v-idx-field-qnty by 2
      979       on error undo, return error
      980       :
      981         assign
      982           v-count-fld = v-count-fld + 1
      983         .
      984         if p-key-handle = ?
      985           and v-count-fld > v-field-num
      986         then do:
      987           leave block_where.
      988         end.
      989         define variable VfieldKeyTable as handle no-undo.
      990         assign
      991           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      992           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      993         .
      994         if     bh_tbl-key ne ?
      995         then do:
      996            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      997            if VfieldKeyTable eq ?
      998            then next block_where.
      999         end.
     1000         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1001         then
     1002            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1003         else
     1004            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1005         if p-key-handle = ? then do:
     1006           assign
     1007             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1008           .
     1009         end.
     1010         else do:
     1011           assign
     1012             fh_key = p-key-handle:buffer-field( v-field-name )
     1013           .
     1014           if fh_key = ?
     1015             or not valid-handle( fh_key )
     1016           then do:
     1017             delete object bh_tbl-name.
     1018             if     bh_tbl-key ne ?
     1019             then
     1020                delete object bh_tbl-key.
     1021             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
     1022           end.
     1023           assign
     1024             v-field-val = fh_key:buffer-value
     1025           .
     1026         end.
     1027         if fh_search:data-type ="character":U then do:
     1028           assign
     1029             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1030             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1031             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1032             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1033             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1034             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1035             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1036             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1037             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1038             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1039             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1040             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1041             v-field-val = substitute( '"&1"', v-field-val )
     1042           .
     1043         end.
     1044         assign
     1045           o-where = substitute( "&1 &2", o-where, v-field-val )
     1046         .
     1047         if v-word-link = "":U then do:
     1048           assign
     1049             v-word-link = "and":U
     1050           .
     1051         end.
     1052       end.
     1053       delete object bh_tbl-name.
     1054       if     bh_tbl-key ne ?
     1055       then
     1056          delete object bh_tbl-key.
     1057       if p-key-handle = ?
     1058         and v-count-fld <> v-field-num
     1059       then do:
     1060         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
     1061       end.
     1062     end.
     1063   end procedure.
     1064   procedure gen-hn-keyr-tab :
     1065     define input  parameter i-tableSerach as character no-undo.
     1066     define input  parameter i-tablekey   as character no-undo.
     1067     define input  parameter p-key-rec    as character no-undo.
     1068     define input  parameter p-key-handle as handle    no-undo .
     1069     define input  parameter p-db-name    as character no-undo .
     1070     define input  parameter p-tt-handle  as handle    no-undo .
     1071     define input  parameter p-stts-lock  as integer   no-undo .
     1072     define output parameter o-hn         as handle    no-undo.
     1073     define variable v-full-tbl-name as character no-undo.
     1074     define variable v-where         as character no-undo.
     1075     define variable bh_tbl-name     as handle    no-undo.
     1076     define variable vTable          as character no-undo.
     1077     do
     1078     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1079     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1080     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1081         run gen-where-keyr-tab(i-tableSerach,
     1082                                i-tablekey,
     1083                                p-key-rec,
     1084                                p-key-handle,
     1085                                p-db-name,
     1086                                p-tt-handle,
     1087                                output v-where).
     1088         if i-tableSerach ne "" and i-tableSerach ne ?
     1089         then do:
     1090            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1091            create buffer bh_tbl-name for table v-full-tbl-name .
     1092         end.
     1093         else do:
     1094            if p-tt-handle = ? then do:
     1095               assign
     1096                  vTable = entry( 1 , p-key-rec, chr(3) )
     1097               .
     1098               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1099               create buffer bh_tbl-name for table v-full-tbl-name .
     1100            end.
     1101            else do:
     1102               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1103            end.
     1104         end.
     1105         if p-tt-handle = ? then do:
     1106            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1107         end.
     1108         else do:
     1109            bh_tbl-name:find-first( v-where ) no-error .
     1110         end.
     1111         o-hn = bh_tbl-name.
     1112      end.
     1113   end procedure.
     1114   procedure gen-hn-keyr :
     1115     define input  parameter p-key-rec    as character no-undo.
     1116     define input  parameter p-key-handle as handle    no-undo .
     1117     define input  parameter p-db-name    as character no-undo .
     1118     define input  parameter p-tt-handle  as handle    no-undo .
     1119     define input  parameter p-stts-lock  as integer   no-undo .
     1120     define output parameter o-hn         as handle    no-undo.
     1121     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1122   end.
     1123   procedure gen-row-keyr :
     1124     define input  parameter p-key-rec    as character no-undo.
     1125     define input  parameter p-key-handle as handle    no-undo .
     1126     define input  parameter p-db-name    as character no-undo .
     1127     define input  parameter p-tt-handle  as handle    no-undo .
     1128     define input  parameter p-stts-lock  as integer   no-undo .
     1129     define output parameter p-tbl-row    as rowid     no-undo.
     1130     define output parameter p-tbl-name   as character no-undo.
     1131     define variable vHn as handle no-undo.
     1132       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1133       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1134       p-tbl-name =  vHn:table.
     1135       delete object vHn no-error.
     1136     if p-tbl-row = ? then do:
     1137       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
     1138     end.
     1139     else do:
     1140       return.
     1141     end.
     1142   end procedure.
     1143   procedure gen-key-fv :
     1144     define input  parameter p-key-rec    as character no-undo .
     1145     define output parameter p-field-list as character no-undo .
     1146     define output parameter p-value-list as character no-undo.
     1147     do
     1148     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1149     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1150     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1151     :
     1152       define variable v-full-tbl-name  as character no-undo .
     1153       define variable bh_tbl-name      as handle    no-undo .
     1154       define variable v-tbl-name       as character no-undo .
     1155       define variable v-field-num      as integer   no-undo .
     1156       define variable v-count-fld      as integer   no-undo .
     1157       define variable v-inform         as character no-undo .
     1158       define variable v-ind            as integer   no-undo .
     1159       define variable v-idx-field-qnty as integer   no-undo .
     1160       define variable v-delim-key      as character no-undo .
     1161       if p-key-rec = ?
     1162         or p-key-rec = "":U
     1163       then do:
     1164         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1165       end.
     1166       assign
     1167         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1168         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1169       .
     1170       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1171       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
     1172       assign
     1173         v-inform = bh_tbl-name:index-information(1)
     1174         v-ind    = 2
     1175       .
     1176       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1177       on error undo, return error
     1178       :
     1179         assign
     1180           v-inform = bh_tbl-name:index-information( v-ind )
     1181           v-ind    = v-ind + 1
     1182         .
     1183       end.
     1184       if v-inform = ?
     1185         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1186         or entry( 3, v-inform, ",":U ) <> "1":U
     1187       then do:
     1188         delete object bh_tbl-name no-error.
     1189         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1190       end.
     1191       assign
     1192         v-idx-field-qnty = num-entries( v-inform ) - 4
     1193       .
     1194       if v-idx-field-qnty < 2 then do:
     1195         delete object bh_tbl-name no-error.
     1196         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1197       end.
     1198       assign
     1199         p-field-list = "":U
     1200         p-value-list = "":U
     1201         v-delim-key  = "":U
     1202         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1203         v-count-fld  = 0
     1204       .
     1205       block_where:
     1206       do v-ind = 1 to v-idx-field-qnty by 2
     1207       on error undo, return error
     1208       :
     1209         assign
     1210           v-count-fld = v-count-fld + 1
     1211         .
     1212         if v-count-fld > v-field-num then do:
     1213           leave block_where.
     1214         end.
     1215         assign
     1216           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1217           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1218         .
     1219         if v-ind = 1 then do:
     1220           assign
     1221             v-delim-key = chr(3)
     1222           .
     1223         end.
     1224       end.
     1225       delete object bh_tbl-name.
     1226       if v-count-fld <> v-field-num then do:
     1227         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     1228       end.
     1229     end.
     1230   end procedure.
     1231   procedure gen-key-field :
     1232     define input  parameter p-table      as character no-undo .
     1233     define output parameter p-field-list as character no-undo .
     1234     do
     1235     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1236     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1237     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1238     :
     1239       define variable v-full-tbl-name  as character no-undo .
     1240       define variable bh_tbl-name      as handle    no-undo .
     1241       define variable v-tbl-name       as character no-undo .
     1242       define variable v-field-num      as integer   no-undo .
     1243       define variable v-count-fld      as integer   no-undo .
     1244       define variable v-inform         as character no-undo .
     1245       define variable v-ind            as integer   no-undo .
     1246       define variable v-idx-field-qnty as integer   no-undo .
     1247       define variable v-delim-key      as character no-undo .
     1248       if p-table = ?
     1249         or p-table = "":U
     1250       then do:
     1251         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
     1252       end.
     1253       assign
     1254         v-tbl-name      = p-table
     1255         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1256       .
     1257       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1258       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
     1259       assign
     1260         v-inform = bh_tbl-name:index-information(1)
     1261         v-ind    = 2
     1262       .
     1263       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1264       on error undo, return error
     1265       :
     1266         assign
     1267           v-inform = bh_tbl-name:index-information( v-ind )
     1268           v-ind    = v-ind + 1
     1269         .
     1270       end.
     1271       if v-inform = ?
     1272         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1273         or entry( 3, v-inform, ",":U ) <> "1":U
     1274       then do:
     1275         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1276       end.
     1277       assign
     1278         v-idx-field-qnty = num-entries( v-inform ) - 4
     1279       .
     1280       if v-idx-field-qnty < 2 then do:
     1281         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1282       end.
     1283       assign
     1284         p-field-list = "":U
     1285         v-delim-key  = "":U
     1286         v-count-fld  = 0
     1287       .
     1288       block_where:
     1289       do v-ind = 1 to v-idx-field-qnty by 2
     1290       on error undo, return error
     1291       :
     1292         assign
     1293           v-count-fld = v-count-fld + 1
     1294         .
     1295         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1296         if v-ind = 1 then do:
     1297           assign
     1298             v-delim-key = chr(3)
     1299           .
     1300         end.
     1301       end.
     1302       delete object bh_tbl-name.
     1303     end.
     1304   end procedure.
     1305   CREATE WIDGET-POOL.
     1306   DEFINE VARIABLE State-source      as WIDGET-HANDLE NO-UNDO .
     1307   DEFINE VARIABLE v-time-prediction AS INTEGER       NO-UNDO .
     1308   DEFINE VARIABLE v-date-prediction AS DATE          NO-UNDO .
     1309   define variable v-cli-list        as character     no-undo .
     1310   DEFINE VARIABLE v-output-type     AS CHARACTER NO-UNDO.
     1311   DEFINE VARIABLE v-esys-id         AS integer NO-UNDO.
     1312   DEFINE VARIABLE v-profile-id         AS integer NO-UNDO.
     1313   define variable loc-ref-list as character no-undo .
     1314   DEFINE BUTTON b-esys
     1315        IMAGE-UP FILE "btn-down-arrow":U
     1316        IMAGE-DOWN FILE "btn-down-arrow":U
     1317        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1318        LABEL "Btn 1"
     1319        SIZE 4 BY 1.
     1320   DEFINE VARIABLE f-esys-id AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1321        LABEL "Код Внеш.системы, в которую идет выгрузка"
     1322         VIEW-AS TEXT
     1323        SIZE 10 BY .67 NO-UNDO.
     1324   DEFINE VARIABLE f-esys-name AS CHARACTER FORMAT "X(256)":U
     1325         VIEW-AS TEXT
     1326        SIZE 68.5 BY .67
     1327        FGCOLOR 4  NO-UNDO.
     1328   DEFINE VARIABLE f-text-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Время отчета"
     1329         VIEW-AS TEXT
     1330        SIZE 13.5 BY .67
     1331        FGCOLOR 4  NO-UNDO.
     1332   DEFINE VARIABLE f-text-2 AS CHARACTER FORMAT "X(256)":U INITIAL ":"
     1333         VIEW-AS TEXT
     1334        SIZE .8 BY .67
     1335        FGCOLOR 4  NO-UNDO.
     1336   DEFINE VARIABLE v-hours AS INTEGER FORMAT "99":U INITIAL 0
     1337        VIEW-AS FILL-IN
     1338        SIZE 3 BY 1
     1339        BGCOLOR 15  NO-UNDO.
     1340   DEFINE VARIABLE v-minutes AS INTEGER FORMAT "99":U INITIAL 0
     1341        VIEW-AS FILL-IN
     1342        SIZE 3 BY 1
     1343        BGCOLOR 15  NO-UNDO.
     1344   DEFINE RECTANGLE RECT-7
     1345        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1346        SIZE 71.4 BY 16.27.
     1347   DEFINE VARIABLE t-excel AS LOGICAL INITIAL no
     1348        LABEL "Excel"
     1349        VIEW-AS TOGGLE-BOX
     1350        SIZE 20 BY 1 NO-UNDO.
     1351   DEFINE VARIABLE t-xml AS LOGICAL INITIAL no
     1352        LABEL "XML"
     1353        VIEW-AS TOGGLE-BOX
     1354        SIZE 20 BY 1 NO-UNDO.
     1355   DEFINE FRAME F-Main
     1356        v-hours AT ROW 2.13 COL 17.5 COLON-ALIGNED NO-LABEL
     1357        v-minutes AT ROW 2.13 COL 22 COLON-ALIGNED NO-LABEL
     1358        t-excel AT ROW 4 COL 10.5 WIDGET-ID 6
     1359        t-xml AT ROW 5 COL 10.5 WIDGET-ID 8
     1360        b-esys AT ROW 7.4 COL 63 WIDGET-ID 16
     1361        f-text-2 AT ROW 2.3 COL 22.8 NO-LABEL WIDGET-ID 12
     1362        f-text-1 AT ROW 2.33 COL 2.5 COLON-ALIGNED NO-LABEL WIDGET-ID 10
     1363        f-esys-id AT ROW 7.4 COL 48 COLON-ALIGNED WIDGET-ID 14
     1364        f-esys-name AT ROW 9.53 COL 2 COLON-ALIGNED NO-LABEL WIDGET-ID 18
     1365        RECT-7 AT ROW 1.27 COL 2
     1366       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1367            SIDE-LABELS NO-UNDERLINE THREE-D
     1368            AT COL 1 ROW 1 SCROLLABLE
     1369            BGCOLOR 8 .
     1370   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1371     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-dispet.w should only be RUN PERSISTENT.":U
     1372             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1373     RETURN.
     1374   END.
     1375   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1376   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1377   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1378   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1379   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1380   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1381   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1382   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1383         adm-object-hdl = FRAME F-Main:HANDLE.
     1384   RUN ensure-broker.
     1385   THIS-PROCEDURE:ADM-DATA =
     1386        'ADM1.1~`':U +
     1387        'SmartViewer~`':U +
     1388        '~`':U +
     1389        'NO ~`':U +
     1390        '~`':U +
     1391        '~`':U +
     1392        '~`':U +
     1393        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1394           + "~`":U +
     1395        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1396        'Record-Source,Record-Target,TableIO-Target~`':U +
     1397        '~`':U +
     1398        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1399        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1400            THEN "^^":U
     1401        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1402             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1403   PROCEDURE adm-apply-entry :
     1404     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1405   END PROCEDURE.
     1406   PROCEDURE adm-destroy :
     1407    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1408   END PROCEDURE.
     1409   PROCEDURE adm-disable :
     1410       DISABLE RECT-7 v-hours v-minutes t-excel t-xml b-esys WITH FRAME F-Main.
     1411       RUN dispatch ('disable-fields':U).
     1412       RUN set-attribute-list ('ENABLED=no':U).
     1413       RETURN.
     1414   END PROCEDURE.
     1415   PROCEDURE adm-edit-attribute-list :
     1416         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1417         RETURN.
     1418   END PROCEDURE.
     1419   PROCEDURE adm-enable :
     1420       ENABLE UNLESS-HIDDEN RECT-7 v-hours v-minutes t-excel t-xml b-esys WITH FRAME F-Main.
     1421       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1422       RUN set-attribute-list ('ENABLED=yes':U).
     1423       RETURN.
     1424   END PROCEDURE.
     1425   PROCEDURE adm-exit :
     1426        RUN notify ('exit':U).
     1427     RETURN.
     1428   END PROCEDURE.
     1429   PROCEDURE adm-hide :
     1430     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1431   END PROCEDURE.
     1432   PROCEDURE adm-initialize :
     1433     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1434   END PROCEDURE.
     1435   PROCEDURE adm-show-errors :
     1436       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1437       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1438           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1439       END.
     1440       RETURN.
     1441   END PROCEDURE.
     1442   PROCEDURE adm-UIB-mode :
     1443     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1444   END PROCEDURE.
     1445   PROCEDURE adm-view :
     1446     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1447   END PROCEDURE.
     1448   PROCEDURE dispatch :
     1449       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1450       RUN broker-dispatch IN adm-broker-hdl
     1451           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1452       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1453   END PROCEDURE.
     1454   PROCEDURE ensure-broker :
     1455   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1456   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1457   DO:
     1458       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1459       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1460   END.
     1461   END PROCEDURE.
     1462   PROCEDURE get-attribute :
     1463     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1464     RUN broker-get-attribute IN adm-broker-hdl
     1465         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1466     RETURN RETURN-VALUE.
     1467   END PROCEDURE.
     1468   PROCEDURE get-attribute-list :
     1469     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1470     RUN broker-get-attribute-list IN adm-broker-hdl
     1471         (INPUT THIS-PROCEDURE,
     1472          INPUT ?,
     1473          OUTPUT p-attr-list) NO-ERROR.
     1474     RETURN.
     1475   END PROCEDURE.
     1476   PROCEDURE new-state :
     1477     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1478     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1479     RETURN.
     1480   END PROCEDURE.
     1481   PROCEDURE notify :
     1482     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1483     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1484     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1485         RETURN "ADM-ERROR":U.
     1486     RETURN.
     1487   END PROCEDURE.
     1488   PROCEDURE set-attribute-list :
     1489     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1490     RUN ensure-broker.
     1491     RUN broker-set-attribute-list IN adm-broker-hdl
     1492         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1493     RETURN.
     1494   END PROCEDURE.
     1495   PROCEDURE set-position :
     1496       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1497       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1498       IF VALID-HANDLE(adm-object-hdl) THEN
     1499       DO:
     1500         ASSIGN adm-object-hdl:ROW    =   p-row
     1501                adm-object-hdl:COLUMN =   p-col.
     1502       END.
     1503       RETURN.
     1504   END PROCEDURE.
     1505   PROCEDURE adm-display-fields :
     1506       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1507       RETURN.
     1508   END PROCEDURE.
     1509   PROCEDURE adm-open-query :
     1510     RETURN.
     1511   END PROCEDURE.
     1512   PROCEDURE adm-row-changed :
     1513         IF VALID-HANDLE(adm-object-hdl) THEN
     1514           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1515         RUN notify ('row-available':U).
     1516         RETURN.
     1517   END PROCEDURE.
     1518   PROCEDURE reposition-query :
     1519       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1520       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1521       RETURN.
     1522   END PROCEDURE.
     1523     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1524     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1525     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1526     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1527     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1528     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1529     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1530     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1531     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1532     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1533     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1534     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1535     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1536     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1537     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1538     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1539     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1540     IF "":U = "":U THEN
     1541       RUN modify-list-attribute IN adm-broker-hdl
     1542         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1543     RUN use-create-on-add(?).
     1544   PROCEDURE adm-add-record :
     1545       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1546          "must have at least one Enabled Table to perform Add.":U
     1547          VIEW-AS ALERT-BOX ERROR.
     1548       RETURN.
     1549   END PROCEDURE.
     1550   PROCEDURE adm-assign-record :
     1551    MESSAGE
     1552          "Object ":U THIS-PROCEDURE:FILE-NAME
     1553            "must have at least one Enabled Table to perform Assign.":U
     1554              VIEW-AS ALERT-BOX ERROR.
     1555      RETURN.
     1556     END PROCEDURE.
     1557   PROCEDURE adm-assign-statement :
     1558     RETURN.
     1559   END PROCEDURE.
     1560   PROCEDURE adm-cancel-record :
     1561      RETURN.
     1562     END PROCEDURE.
     1563   PROCEDURE adm-copy-record :
     1564       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1565        "must have at least one Enabled Table to perform Copy.":U
     1566          VIEW-AS ALERT-BOX ERROR.
     1567       RETURN.
     1568   END PROCEDURE.
     1569   PROCEDURE adm-create-record :
     1570      RETURN.
     1571   END PROCEDURE.
     1572   PROCEDURE adm-current-changed :
     1573     RETURN.
     1574   END PROCEDURE.
     1575   PROCEDURE adm-delete-record :
     1576    MESSAGE
     1577          "Object ":U THIS-PROCEDURE:FILE-NAME
     1578            "must have at least one Enabled Table to perform Delete.":U
     1579              VIEW-AS ALERT-BOX ERROR.
     1580       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1581       RETURN.
     1582   END PROCEDURE.
     1583   PROCEDURE adm-disable-fields :
     1584         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1585       RETURN.
     1586   END PROCEDURE.
     1587   PROCEDURE adm-enable-fields :
     1588       RETURN.
     1589   END PROCEDURE.
     1590   PROCEDURE adm-end-update :
     1591     RETURN.
     1592   END PROCEDURE.
     1593   PROCEDURE adm-reset-record :
     1594       RETURN.
     1595   END PROCEDURE.
     1596   PROCEDURE adm-update-record :
     1597       MESSAGE
     1598         "Object ":U THIS-PROCEDURE:FILE-NAME
     1599           "must have at least one Enabled Table to perform Update.":U
     1600             VIEW-AS ALERT-BOX ERROR.
     1601      RETURN.
     1602   END PROCEDURE.
     1603   PROCEDURE check-modified :
     1604   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1605   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1606   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1607   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1608     IF check-state = "check":U THEN
     1609     DO:
     1610       RUN get-link-handle IN adm-broker-hdl
     1611         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1612            OUTPUT group-target-list).
     1613       IF group-target-list NE "":U THEN
     1614       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1615         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1616         RUN check-modified IN curr-widget ('group-check':U).
     1617         IF RETURN-VALUE NE "":U THEN
     1618         DO:
     1619           RUN check-modified-message(RETURN-VALUE).
     1620           RETURN "":U.
     1621         END.
     1622       END.
     1623     END.
     1624     RETURN "":U.
     1625   END PROCEDURE.
     1626   PROCEDURE check-modified-message :
     1627     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1628        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1629           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1630        IF RETURN-VALUE = "YES":U THEN
     1631           RUN notify ('view,CONTAINER-SOURCE':U).
     1632        MESSAGE IF p-changed-table NE ? THEN
     1633           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1634           ELSE "Current values have been changed."
     1635           SKIP "  Do you wish to save those changes?"
     1636           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1637        IF ANS THEN
     1638        DO:
     1639           IF group-assign-target THEN
     1640             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1641           ELSE RUN dispatch('update-record':U).
     1642           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1643           DO:
     1644               MESSAGE "Changes to the previous record were not saved."
     1645                 VIEW-AS ALERT-BOX ERROR.
     1646               IF group-assign-target THEN
     1647                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1648               ELSE RUN dispatch ('cancel-record':U).
     1649           END.
     1650        END.
     1651        ELSE DO:
     1652          IF group-assign-target THEN
     1653             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1654          ELSE RUN dispatch('cancel-record':U).
     1655        END.
     1656        RETURN.
     1657   END PROCEDURE.
     1658   PROCEDURE get-rowid :
     1659       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1660       ASSIGN
     1661       p-table   =   adm-first-table.
     1662       RETURN.
     1663   END PROCEDURE.
     1664   PROCEDURE init-group-assign :
     1665       RUN request-attribute IN adm-broker-hdl
     1666         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1667       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1668         group-assign-target = yes.
     1669       ELSE group-assign-target = no.
     1670       RETURN.
     1671   END PROCEDURE.
     1672   PROCEDURE set-editors :
     1673       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1674       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1675       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1676       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1677       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1678       DO WHILE VALID-HANDLE (curr-widget):
     1679           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1680              curr-widget:HIDDEN = no THEN DO:
     1681             CASE p-field-setting:
     1682               WHEN "INITIALIZE":U THEN
     1683               DO:
     1684                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1685                     read-only-list +
     1686                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1687                        STRING(curr-widget).
     1688               END.
     1689               WHEN "DISABLE":U OR
     1690               WHEN "ENABLE":U THEN
     1691               DO:
     1692                   curr-widget:SENSITIVE = yes.
     1693                   RUN get-attribute ('Read-Only-Editors':U).
     1694                   IF RETURN-VALUE = ? OR
     1695                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1696                       curr-widget:READ-ONLY =
     1697                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1698               END.
     1699               WHEN "CLEAR":U THEN
     1700                   curr-widget:SCREEN-VALUE = "":U.
     1701             END CASE.
     1702           END.
     1703           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1704       END.
     1705       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1706         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1707           + '"':U).
     1708       RETURN.
     1709   END PROCEDURE.
     1710   PROCEDURE use-check-modified-all :
     1711    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1712     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1713     RETURN.
     1714   END PROCEDURE.
     1715   PROCEDURE use-create-on-add :
     1716   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1717      RETURN.
     1718   END PROCEDURE.
     1719   PROCEDURE use-initial-lock :
     1720     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1721     ASSIGN adm-initial-lock = p-attr-value.
     1722     RETURN.
     1723   END PROCEDURE.
     1724     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1725   ASSIGN
     1726          FRAME F-Main:SCROLLABLE       = FALSE
     1727          FRAME F-Main:HIDDEN           = TRUE.
     1728   ASSIGN
     1729          f-esys-id:READ-ONLY IN FRAME F-Main        = TRUE.
     1730   ASSIGN
     1731          t-excel:HIDDEN IN FRAME F-Main           = TRUE.
     1732   ASSIGN
     1733          t-xml:HIDDEN IN FRAME F-Main           = TRUE.
     1734   ON CHOOSE OF b-esys IN FRAME F-Main
     1735   DO:
     1736   RUN get-ext-system IN THIS-PROCEDURE  ( INPUT YES).
     1737   END.
     1738   ON LEAVE OF v-hours IN FRAME F-Main
     1739   DO:
     1740      ASSIGN
     1741        v-hours
     1742      .
     1743      RUN mandatory-24 IN THIS-PROCEDURE
     1744         (INPUT-OUTPUT v-hours ) .
     1745      ASSIGN
     1746         v-time-prediction = v-hours * 60 * 60 + v-minutes * 60
     1747      .
     1748   END.
     1749   ON LEAVE OF v-minutes IN FRAME F-Main
     1750   DO:
     1751      ASSIGN
     1752        v-minutes
     1753      .
     1754      RUN mandatory-60 IN THIS-PROCEDURE
     1755         (INPUT-OUTPUT v-minutes ) .
     1756      ASSIGN
     1757           v-time-prediction = v-hours * 60 * 60 + v-minutes * 60
     1758      .
     1759   END.
     1760   PROCEDURE disable_UI :
     1761     HIDE FRAME F-Main.
     1762     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1763   END PROCEDURE.
     1764   PROCEDURE get-ext-system :
     1765   DEFINE INPUT PARAMETER p-interface AS LOGICAL NO-UNDO.
     1766   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     1767   DEFINE VARIABLE v-int AS integer NO-UNDO.
     1768   DEFINE VARIABLE v-uniq-key-rec AS CHARACTER NO-UNDO.
     1769   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1770   DEFINE VARIABLE v-tbl-row AS rowid NO-UNDO.
     1771   DEFINE VARIABLE v-tbl-name AS CHARACTER NO-UNDO.
     1772   DEFINE BUFFER buf_ext-system FOR ub.ext-system.
     1773   IF f-esys-id <> 0  THEN DO:
     1774      FIND FIRST buf_ext-system NO-LOCK WHERE
     1775                   buf_ext-system.esys-id = f-esys-id
     1776            AND buf_ext-system.db-num = 0 NO-ERROR.
     1777      IF AVAILABLE buf_ext-system THEN DO:
     1778          RUN gen-key-rec IN THIS-PROCEDURE ( INPUT 'ext-system':U
     1779                                             ,INPUT (BUFFER buf_ext-system:HANDLE)
     1780                                             ,OUTPUT v-uniq-key-rec) NO-ERROR.
     1781      END.
     1782   END.
     1783    IF p-interface THEN DO:
     1784         run bge/oxmlexts.p (
     1785               input my-handle
     1786             , input 2
     1787             , input substitute("esys-type = &1", '6':U)
     1788             , input v-uniq-key-rec
     1789             , output v-rid-list
     1790             , output v-ok
     1791         ).
     1792        IF NOT v-ok  THEN RETURN ERROR.
     1793             run gen-row-keyr in this-procedure
     1794             ( input v-rid-list
     1795              ,input ?
     1796              ,input "ub"
     1797              ,input ?
     1798              ,input no-lock
     1799              ,output v-tbl-row
     1800              ,output v-tbl-name
     1801            ).
     1802           find first buf_ext-system no-lock where
     1803                     rowid(buf_ext-system) = v-tbl-row.
     1804     END.
     1805     IF AVAILABLE buf_ext-system
     1806     AND (buf_ext-system.esys-id   <> f-esys-id
     1807     OR NOT p-interface) THEN DO:
     1808       f-esys-id = buf_ext-system.esys-id.
     1809       f-esys-name = buf_ext-system.esys-NAME.
     1810       DISPLAY
     1811       f-esys-id
     1812       f-esys-name
     1813       WITH FRAME F-Main.
     1814     END.
     1815   END PROCEDURE.
     1816   PROCEDURE local-apply-layout :
     1817     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1818   END PROCEDURE.
     1819   PROCEDURE local-initialize :
     1820   define variable v-seconds    as integer      no-undo.
     1821      define variable v-time    as integer      no-undo.
     1822      RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1823      CASE place-call:
     1824        WHEN 'schedule':U THEN DO:
     1825          RUN rcps_get-profile-id IN parent-handle ( OUTPUT v-profile-id).
     1826          CASE v-profile-id:
     1827            WHEN 50 THEN DO:
     1828          HIDE
     1829          v-hours IN FRAME F-Main
     1830          v-minutes
     1831          f-text-1
     1832                  f-esys-id
     1833                  b-esys
     1834                  f-esys-name
     1835          IN FRAME F-Main.
     1836          t-excel = LOOKUP('excel':U, v-output-type) > 0.
     1837          t-xml = LOOKUP('xml':U, v-output-type) > 0.
     1838          display
     1839          t-excel
     1840          t-xml
     1841          WITH FRAME F-Main.
     1842          ENABLE
     1843          t-excel WHEN params-only-mode <> 'ПРОСМОТР':U
     1844          t-xml WHEN params-only-mode <> 'ПРОСМОТР':U
     1845          WITH FRAME F-Main.
     1846        END.
     1847              WHEN 52 THEN DO:
     1848                HIDE
     1849                v-hours IN FRAME F-Main
     1850                v-minutes
     1851                f-text-1
     1852                t-excel
     1853                t-xml
     1854                IN FRAME F-Main.
     1855                f-esys-id = v-esys-id.
     1856                RUN get-ext-system IN THIS-PROCEDURE ( INPUT NO).
     1857                DISPLAY
     1858                f-esys-id
     1859                f-esys-name
     1860                WITH FRAME F-Main.
     1861                ENABLE
     1862                b-esys WHEN params-only-mode <> 'ПРОСМОТР':U
     1863                WITH FRAME F-Main.
     1864              END.
     1865          END CASE.
     1866        END.
     1867        OTHERWISE DO:
     1868            run cur-time ( output v-date-prediction
     1869                         , output v-time-prediction
     1870                         ).
     1871            assign
     1872               v-time = v-time-prediction
     1873               v-seconds = v-time MODULO 60
     1874               v-time = (v-time - v-seconds) / 60
     1875            .
     1876            assign
     1877               v-minutes = v-time MODULO 60
     1878            .
     1879            assign
     1880               v-hours = (v-time - v-minutes) / 60
     1881            .
     1882            display
     1883            v-hours
     1884            v-minutes
     1885            f-text-1
     1886            f-text-2
     1887            with frame F-Main .
     1888            HIDE
     1889            t-excel
     1890            t-xml
     1891            b-esys
     1892            f-esys-id
     1893            f-esys-name
     1894            in FRAME F-Main.
     1895        END.
     1896      END CASE.
     1897   END PROCEDURE.
     1898   PROCEDURE mandatory-24 :
     1899   DEFINE INPUT-OUTPUT PARAMETER p-time AS INTEGER NO-UNDO .
     1900   DO
     1901   ON error undo, RETURN:
     1902      IF p-time > 23 THEN DO:
     1903          ASSIGN
     1904              p-time = 23
     1905          .
     1906          RETURN .
     1907      END.
     1908      IF p-time < 0 THEN DO:
     1909          ASSIGN
     1910              p-time = 0
     1911          .
     1912          RETURN .
     1913      END.
     1914   END.
     1915   END PROCEDURE.
     1916   PROCEDURE mandatory-60 :
     1917   DEFINE INPUT-OUTPUT PARAMETER p-time AS INTEGER NO-UNDO .
     1918   DO
     1919   ON error undo, RETURN:
     1920      IF p-time > 59 THEN DO:
     1921          ASSIGN
     1922              p-time = 59
     1923          .
     1924          RETURN .
     1925      END.
     1926      IF p-time < 0 THEN DO:
     1927          ASSIGN
     1928              p-time = 0
     1929          .
     1930          RETURN .
     1931      END.
     1932   END.
     1933   END PROCEDURE.
     1934   PROCEDURE my-params :
     1935   define input parameter p-action as character no-undo .
     1936   define variable v-shop-code as integer no-undo .
     1937   define variable v-index-id as integer no-undo .
     1938   define variable v-value-character as character no-undo .
     1939   define variable v-value-date as date no-undo .
     1940   define variable v-value-decimal as decimal no-undo .
     1941   define variable v-value-integer as integer no-undo .
     1942   define variable v-value-logical as logical no-undo .
     1943   define variable v-loc-output-type as character no-undo .
     1944   case p-action:
     1945     when "get" then do:
     1946       empty temp-table X-init_obj-list.
     1947       v-index-id = 1.
     1948       do while v-index-id >= 1 :
     1949         RUN rcps_get-value IN parent-handle (
     1950                                          input "p-shops"
     1951                                         ,INPUT-output v-index-id
     1952                                         ,output v-value-character
     1953                                         ,output v-value-date
     1954                                         ,output v-value-decimal
     1955                                         ,output v-shop-code
     1956                                         ,output v-value-logical
     1957                                         ) no-error .
     1958         if error-status:error
     1959         or v-shop-code <= 0
     1960         then do:
     1961          leave.
     1962         end.
     1963         find first X-init_obj-list where
     1964                   X-init_obj-list.obj-type = 'маг':U
     1965               and  X-init_obj-list.obj-code = v-shop-code no-error.
     1966         if not available X-init_obj-list then do:
     1967           create X-init_obj-list.
     1968           assign
     1969           X-init_obj-list.obj-type = 'маг':U
     1970           X-init_obj-list.obj-code = v-shop-code
     1971           .
     1972           release X-init_obj-list.
     1973         end.
     1974       end.
     1975        X-selectobject =  "choice":U.
     1976        IF v-profile-id = 50 THEN DO:
     1977        RUN rcps_get-value IN parent-handle (
     1978                                         input "p-output-type"
     1979                                        ,INPUT-output v-index-id
     1980                                        ,output v-output-type
     1981                                        ,output v-value-date
     1982                                        ,output v-value-decimal
     1983                                        ,output v-shop-code
     1984                                        ,output v-value-logical
     1985                                        ) no-error .
     1986        END.
     1987        IF v-profile-id = 52  THEN DO:
     1988          v-index-id = 0.
     1989          RUN rcps_get-value IN parent-handle (
     1990                                             input "p-esys-id"
     1991                                            ,INPUT-output v-index-id
     1992                                            ,output v-output-type
     1993                                            ,output v-value-date
     1994                                            ,output v-value-decimal
     1995                                            ,output v-esys-id
     1996                                            ,output v-value-logical
     1997                                            ) no-error .
     1998        END.
     1999       RUN local-initialize IN THIS-PROCEDURE.
     2000     end.
     2001     when "set" then do:
     2002       IF v-profile-id = 50 THEN DO:
     2003       ASSIGN
     2004       FRAME F-Main
     2005       t-excel
     2006       t-xml
     2007       v-loc-output-type = ","
     2008       ENTRY(1, v-loc-output-type) = (IF t-excel THEN 'excel':U ELSE '')
     2009       ENTRY(2, v-loc-output-type) = (IF t-xml THEN 'xml':U ELSE '')
     2010       v-loc-output-type = TRIM(v-loc-output-type, chr(44))
     2011       .
     2012       RUN rcps_set-value IN parent-handle (
     2013                                        input "p-output-type"
     2014                                       ,INPUT 0
     2015                                       ,input v-loc-output-type
     2016                                       ,input ?
     2017                                       ,input 0.0
     2018                                       ,input 0
     2019                                       ,input no
     2020                                       ) no-error .
     2021       END.
     2022       IF v-profile-id = 52 THEN DO:
     2023           ASSIGN
     2024           FRAME F-Main
     2025           f-esys-id
     2026           .
     2027           RUN rcps_set-value IN parent-handle (
     2028                                            input "p-esys-id"
     2029                                           ,INPUT 0
     2030                                           ,input ''
     2031                                           ,input ?
     2032                                           ,input 0.0
     2033                                           ,input f-esys-id
     2034                                           ,input no
     2035                                           ) no-error .
     2036       END.
     2037       v-index-id = 0.
     2038       for each obj-list :
     2039         v-index-id = v-index-id + 1.
     2040         RUN rcps_set-value IN parent-handle (
     2041                                          input "p-shops"
     2042                                         ,INPUT v-index-id
     2043                                         ,input ''
     2044                                         ,input ?
     2045                                         ,input 0.0
     2046                                         ,input obj-list.obj-code
     2047                                         ,input no
     2048                                         ) no-error .
     2049         if error-status:error then do:
     2050           message
     2051           error-status:get-message(1) return-value
     2052           view-as alert-box .
     2053           undo, return error .
     2054         end.
     2055       end.
     2056       v-index-id = v-index-id + 1.
     2057       do while true:
     2058         run rcps_proc-b-del in parent-handle (
     2059                                                 input "p-shops"
     2060                                                ,input v-index-id) no-error.
     2061         if error-status:error
     2062         or return-value = "not-found" then leave.
     2063         v-index-id = v-index-id + 1.
     2064       end.
     2065       if error-status:error then do:
     2066         message
     2067         error-status:get-message(1) return-value
     2068         view-as alert-box .
     2069         undo, return error .
     2070       end.
     2071     end.
     2072   end case.
     2073   END PROCEDURE.
     2074   PROCEDURE my-report :
     2075   define variable v-dataseth as handle no-undo .
     2076   define variable v-xmlh as handle no-undo .
     2077   define buffer buf_clients     for ub.clients .
     2078       ASSIGN
     2079           v-cli-list = "":U
     2080       .
     2081       FOR EACH obj-list
     2082           ,
     2083           FIRST buf_clients
     2084           WHERE buf_clients.obj-type = obj-list.obj-type
     2085             AND buf_clients.obj-code = obj-list.obj-code
     2086           NO-LOCK
     2087           :
     2088           ASSIGN
     2089              v-cli-list = v-cli-list + "," + STRING(RECID(buf_clients))
     2090           .
     2091       END.
     2092       ASSIGN
     2093           v-cli-list = TRIM(v-cli-list, ",")
     2094       .
     2095       run rep/r-dispet.p ( INPUT my-handle
     2096                     , input ?
     2097                     , input this-procedure
     2098                     , input ?
     2099                     , input this-procedure:handle
     2100                     , input ?
     2101                     , input ?
     2102                     , input ""
     2103                     , input ''
     2104                     , input ''
     2105                     , input integer('0':U)
     2106                     , input 0
     2107                     , input 0
     2108                     , input v-time-prediction
     2109                     , input x-Date-Alone
     2110                     , input v-cli-list
     2111                     , input FALSE
     2112                     , input FALSE
     2113                     , input "":U
     2114                     , input "":U
     2115                     , output v-dataseth
     2116                     , output v-xmlh
     2117                     ) .
     2118   END PROCEDURE.
     2119   PROCEDURE my-var :
     2120   CASE place-call:
     2121     WHEN 'schedule':U THEN DO:
     2122       case v-profile-id:
     2123         when 50 THEN DO:
     2124           assign
     2125           frame F-Main
     2126           t-excel
     2127           t-xml
     2128           ReportHeader = substitute("&1Направление вывода: &2 &3"
     2129                                     , chr(10)
     2130                                     , (if t-excel then 'excel':U else '')
     2131                                     , (if t-xml then 'xml':U else '')).
     2132         end.
     2133         when 52 then do:
     2134           assign
     2135           frame F-Main
     2136           f-esys-id
     2137           .
     2138           ReportHeader = substitute("&1Маршрутизация во ВС: &2 &3"
     2139                                     , chr(10)
     2140                                     , f-esys-id
     2141                                     , f-esys-name).
     2142         end.
     2143       end case.
     2144     end.
     2145     otherwise do:
     2146       assign
     2147       frame F-Main
     2148       v-hours v-minutes .
     2149       assign
     2150       ReportHeader = substitute("&1Время отчета: &2:&3"
     2151                                 , chr(10)
     2152                                 , v-hours
     2153                                 , v-minutes).
     2154    end.
     2155   end case.
     2156   END PROCEDURE.
     2157   PROCEDURE state-changed :
     2158     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2159     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2160     CASE p-state:
     2161     END CASE.
     2162     END PROCEDURE.
     2163   PROCEDURE write-to-log :
     2164   define input param p-str as char no-undo.
     2165   do
     2166   on error undo, return error
     2167   :
     2168      message
     2169         p-str
     2170         skip
     2171      view-as alert-box error.
     2172   end.
     2173   END PROCEDURE.
