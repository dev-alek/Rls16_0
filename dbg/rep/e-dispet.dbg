      363   procedure create_obj-list :
      364      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      365      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      366      do
      367      on error undo, return error return-value
      368      :
      369         define buffer cli-obj for ub.clients .
      370         define variable p-var as integer no-undo .
      371         define buffer buf_obj-list for obj-list .
      372         find last buf_obj-list  use-index pi no-error .
      373         if available buf_obj-list
      374         then
      375            p-var = buf_obj-list.obj-id + 1.
      376         else
      377            p-var = 1.
      378         find first cli-obj where
      379                   cli-obj.obj-type = p-obj-type
      380               and cli-obj.obj-code = p-obj-code
      381         no-lock no-error.
      382         if available cli-obj
      383         then do:
      384            create buf_obj-list.
      385            assign
      386               buf_obj-list.obj-id   = p-var
      387               buf_obj-list.obj-code = cli-obj.obj-code
      388               buf_obj-list.obj-type = cli-obj.obj-type
      389               buf_obj-list.obj-name = cli-obj.obj-name
      390               buf_obj-list.db-num   = cli-obj.db-num
      391            .
      392         end.
      393      end.
      394   end.
