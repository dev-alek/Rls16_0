        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Отчет диспетчера  (ЗАКЛАДКА №2)".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   procedure cur-time :
       67      define output parameter p-today as date      no-undo .
       68      define output parameter p-time  as integer   no-undo .
       69     do
       70     on error undo, return error
       71     :
       72       define variable v-date1 as date      no-undo .
       73       define variable v-date2 as date      no-undo .
       74       define variable v-time  as integer   no-undo .
       75       assign
       76         v-date1 = today
       77         v-time  = time
       78         v-date2 = today
       79       .
       80       if v-date1 <> v-date2
       81       then do:
       82         assign
       83           v-date1 = today
       84           v-time  = v-time
       85         .
       86       end.
       87       assign
       88         p-today = v-date1
       89         p-time  = v-time
       90       .
       91     end.
       92   end.
       93   function cur-time-date returns character
       94   :
       95     return string(today, '99/99/9999':U) .
       96   end.
       97   function cur-time-mjd returns decimal
       98   :
       99     define variable v-date as date      no-undo .
      100     define variable v-time as integer   no-undo .
      101     run cur-time in this-procedure
      102       (output v-date
      103       ,output v-time
      104       ) .
      105     return integer(v-date) - 2400002 + (v-time / 86400) .
      106   end.
      107   function cur-time-get-ending-index returns integer
      108   (input p-number as integer
      109   )
      110   :
      111     if p-number < 0
      112     or p-number = ?
      113     then do:
      114       return 1 .
      115     end.
      116     define variable v-rest as integer   no-undo .
      117     assign
      118       p-number = p-number modulo 100
      119     .
      120     if p-number < 20
      121     then do:
      122       assign
      123         v-rest = p-number
      124       .
      125     end.
      126     else do:
      127       assign
      128         v-rest = p-number modulo 10
      129       .
      130     end.
      131     case v-rest :
      132       when 1
      133       then do:
      134         return 2 .
      135       end.
      136       when 2 or
      137       when 3 or
      138       when 4
      139       then do:
      140         return 3 .
      141       end.
      142       otherwise do:
      143         return 1 .
      144       end.
      145     end case .
      146   end.
      147   procedure cur-time-mjd-to-date :
      148      define input  parameter i-mjd-diff as decimal no-undo.
      149      define output parameter o-Date     as date    no-undo.
      150      define output parameter o-Time     as integer no-undo.
      151      define variable v-day-number as integer   no-undo .
      152      if    i-mjd-diff < 0
      153         or i-mjd-diff = ?
      154      then do:
      155         return "?" .
      156      end.
      157      assign
      158         v-day-number = truncate(i-mjd-diff,0).
      159         o-Date = date(v-day-number + 2400002).
      160         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      161     .
      162   end.
      163   function cur-time-mjd-to-string returns character
      164   (input p-mjd-diff as decimal
      165   )
      166   :
      167     define variable v-day-number as integer   no-undo .
      168     define variable v-seconds    as integer   no-undo .
      169     define variable v-hour       as integer   no-undo .
      170     define variable v-min        as integer   no-undo .
      171     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      172     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      173     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      174     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      175     if p-mjd-diff < 0
      176     or p-mjd-diff = ?
      177     then do:
      178       return "?" .
      179     end.
      180     assign
      181       v-day-number = integer(truncate(p-mjd-diff,0))
      182       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184     if v-seconds > 86400
      185     then do:
      186       assign
      187         v-seconds = 86400 - 1
      188       .
      189     end.
      190     if v-seconds < 0
      191     then do:
      192       assign
      193         v-seconds = 0
      194       .
      195     end.
      196     assign
      197       v-hour = truncate(v-seconds / 3600, 0)
      198     .
      199     assign
      200       v-seconds = v-seconds modulo 3600
      201     .
      202     assign
      203       v-min = truncate(v-seconds / 60, 0)
      204     .
      205     assign
      206       v-seconds = v-seconds modulo 60
      207     .
      208     return
      209         (if v-day-number <> 0
      210           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      211           else ""
      212         )
      213       + (if v-day-number <> 0 or v-hour <> 0
      214           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      218           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      219           else ""
      220         )
      221       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      222       .
      223   end.
      224   function cur-time-string returns character
      225   :
      226     define variable v-date as date      no-undo .
      227     define variable v-time as integer   no-undo .
      228     run cur-time in this-procedure
      229       (output v-date
      230       ,output v-time
      231       ) .
      232     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      233   end.
      234   function cur-time-string-sec returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      243   end.
      244   function cur-time-custom  returns character
      245   (input p-prefix as character
      246   ,input p-date-format as character
      247   ,input p-delimiter as character
      248   ,input p-time-format as character
      249   ,input p-suffix as character
      250   )
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return
      259       p-prefix
      260       + string(v-date, p-date-format)
      261       + p-delimiter
      262       + string(v-time, p-time-format)
      263       + p-suffix
      264       .
      265   end.
      266   function cur-time-print  returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      275   end.
      276   function cur-time-datetime returns datetime
      277   :
      278     define variable v-char as character no-undo .
      279     define variable v-datetime as datetime no-undo .
      280     v-char = cur-time-string().
      281     v-datetime = datetime(v-char).
      282     return  v-datetime.
      283   end.
      284   function cur-time-string-msec returns character
      285   :
      286     define variable v-date as datetime  no-undo .
      287     v-date = now.
      288     return string(v-date) .
      289   end.
