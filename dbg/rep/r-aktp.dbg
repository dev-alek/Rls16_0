        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define input parameter p-price-celection    as integer          no-undo.
        5   define input parameter p-print-null-qnty    as logical          no-undo.
        6   define input parameter p-sort-by-group      as logical          no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: r-aktp.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/r-aktp.p $":U .
       12   define variable vss-description as character no-undo init "Протокол согласования отпускных цен".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       75   define new shared variable RepPathName        as character no-undo .
       76   define new shared variable PrintRubl          as logical   no-undo .
       77   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
       79      IF parundefine-var = ? THEN RETURN 0.00.
       80                             ELSE RETURN parundefine-var.
       81   END FUNCTION.
       82   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
       83      IF p-undef-char = ? THEN do:
       84        RETURN "?".
       85      end.
       86      ELSE do:
       87        RETURN p-undef-char .
       88      end.
       89   END FUNCTION.
       90   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316       def var log-file-name as char no-undo.
      317       assign
      318           log-file-name = 'r-akt.log'
      319       .
      320       if log-file-name <> "":U
      321       then do:
      322           if search( 'r-akt.log' ) = ?
      323           then do:
      324               output to value( 'r-akt.log' ).
      325               output close.
      326           end.
      327       end.
      328       DEF STREAM stm-log.
      329       PROCEDURE writelog:
      330       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      331       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      332       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      333       if p-file-name <> ""
      334       then do:
      335       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      336           PUT STREAM stm-log UNFORMATTED chr(10).
      337           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      338                                           OR p-log-string = "&Line") THEN "" ELSE
      339                                           cur-time-string-sec() + " ").
      340           PUT STREAM stm-log UNFORMATTED
      341                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      342                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      343                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      344       OUTPUT STREAM stm-log CLOSE.
      345       end.
      346       END PROCEDURE.
      347   define variable vss-include-info4 as character format "X(65)" no-undo
      348   initial "@(#)$Workfile$ $Revision$".
      349       def var v-price-list-doc-num            like price-list.doc-num     no-undo.
      350       def var v-price-list-price-sale         like price-list.price-sale  no-undo.
      351       def var v-price-list-price-sale_old     like price-list.price-sale  no-undo.
      352       def var v-price-list-road-tax           like price-list.road-tax    no-undo.
      353       def var v-price-list-excise             like price-list.excise      no-undo.
      354       def var v-price-list-b-code             like bar-code.b-code        no-undo.
      355       def var v-gds-obj-last-price            like gds-obj.last-rubl      no-undo.
      356       def var v-gds-prt-node-code             like gds-prt.node-code      no-undo.
      357       def var v-gds-prt-node-name             like gds-prt.node-name      no-undo.
      358       def var v-code-is-main                  as logical                  no-undo.
      359       def var v-not-main-unit-cli             like bar-code.unit-cli      no-undo.
      360       def var v-not-main-cli-base-rate        like bar-code.cli-base-rate no-undo.
      361       def var v-not-main-b-code               like bar-code.cli-base-rate no-undo.
      362       def var v-taxname                       as char                     no-undo.
      363       def var v-tax                           as decimal  init 0          no-undo.
      364       def var v-tax-sum                       as decimal  init 0          no-undo.
      365       def var v-tax-parts-qnty                as decimal  init 0          no-undo.
      366   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367     define variable v-cntxt-db-num        as integer   no-undo .
      368     define variable v-cntxt-userid        as character no-undo .
      369     define variable v-cntxt-level         as character no-undo .
      370     define variable v-cntxt-host-code-obj as integer   no-undo .
      371     define variable v-cntxt-obj-type      as character no-undo .
      372     define variable v-cntxt-obj-code      as integer   no-undo .
      373     define variable v-cntxt-db-num-obj    as integer   no-undo .
      374     define variable v-cntxt-is-admin      as logical   no-undo .
      375   do
      376   on error undo, return error
      377   :
      378   define variable v-single-line       as char    no-undo.
      379   define variable v-line-counter      as integer no-undo.
      380   define variable v-good-line-counter as integer no-undo.
      381   define variable v-price-doc-doc-num          like price-doc.doc-num     no-undo.
      382   define variable v-b-code            as char    no-undo.
      383   define variable v-rb-is-base        as logical      no-undo.
      384   define variable sym1  as char init ":"   no-undo.
      385   define variable sym2  as char init ":"   no-undo.
      386   define variable sym3  as char init ":"   no-undo.
      387   define variable sym4  as char init ":"   no-undo.
      388   define variable sym5  as char init ":"   no-undo.
      389   define variable sym6  as char init ":"   no-undo.
      390   define variable sym10 as char init ":"   no-undo.
      391   define variable g#report-num    as integer      no-undo.
      392   define variable g#quest-print   as logical      no-undo.
      393   define variable g#log           as logical      no-undo.
      394   def stream Prtcl .
      395   define frame Protocol
      396           sym1 column-label ":!:" format "X(1)"
      397           v-good-line-counter column-label "N!п/п" format ">>>9"
      398           sym2 column-label ":!:" format "X(1)"
      399           v-b-code column-label "Код! " format "x(10)"
      400           sym3 column-label ":!:" format "X(1)"
      401           price-list.artic column-label "Артикул! " format "X(20)"
      402           sym4 column-label ":!:" format "X(1)"
      403           goods.gds-name column-label "Название товара! " format "X(55)"
      404           sym5 column-label ":!:" format "X(1)"
      405           units.long-name column-label "Единица!измерения" format "X(10)"
      406           sym6 column-label ":!:" format "X(1)"
      407           price-list.price-sale column-label "Цена за единицу!"
      408               format ">>>,>>>,>>>,>>9.99"
      409           sym10 column-label ":!:" format "X(1)"
      410       header
      411           v-price-doc-doc-num at 70 format "X(10)"
      412           string( "Страница " + string( PAGE-NUMBER( Prtcl ), ">>9" ) ) at 120 format "X(13)" skip
      413           v-single-line format "X(136)" at 1
      414       with width 160 down stream-io use-text .
      415   if session :set-wait-state( "compiler" ) then.
      416   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417     run mainmenu_getcntxt in p-mainmenu-handle
      418       (output v-cntxt-db-num
      419       ,output v-cntxt-userid
      420       ,output v-cntxt-level
      421       ,output v-cntxt-host-code-obj
      422       ,output v-cntxt-obj-type
      423       ,output v-cntxt-obj-code
      424       ,output v-cntxt-db-num-obj
      425       ,output v-cntxt-is-admin
      426       ) .
      427       run get-report-num in p-mainmenu-handle (
      428           output g#report-num
      429       ).
      430       run get-quest-print in p-mainmenu-handle (
      431           output g#quest-print
      432       ).
      433   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      435     (output v-rb-is-base
      436     )  .
      437       assign
      438           v-single-line = fill("-", 136)
      439           v-line-counter = 1
      440           v-good-line-counter = 1
      441       .
      442       find first price-doc no-lock
      443           where recid(price-doc) = rec_id .
      444       if not available price-doc
      445       then do:
      446           bell.
      447           message vss-workfile + '. Порушена табличка price-doc'.
      448           return error.
      449       end.
      450       assign
      451           v-price-doc-doc-num  = price-doc.doc-num
      452       .
      453       output stream Prtcl to value( string( session:temp-directory +
      454                                   "rpt" + string( g#report-num ) ) ) page-size 62 .
      455       put stream Prtcl space(20)
      456                   "П Р О Т О К О Л   СОГЛАСОВАНИЯ  СВОБОДНЫХ  ОТПУСКНЫХ  ЦЕН"
      457                   format "X(100)" skip(1)
      458               space(40) string( caps( price-doc.status_ ) + "  N " + v-price-doc-doc-num )
      459                   format "X(60)" skip(1)
      460       .
      461       if price-doc.status_ = 'акт':U
      462       then do:
      463           put stream Prtcl
      464               space(100) "Цены введены с " format "X(20)"
      465               price-doc.doc-date format "99.99.9999"
      466               skip(1)
      467           .
      468       end.
      469       else do:
      470           put stream Prtcl
      471               skip(1)
      472           .
      473       end.
      474       form header
      475           v-single-line format "X(136)" at 1 skip
      476           "Продолжение - на следующей странице" at 30 skip
      477               with frame Bttmframe width 160 page-bottom no-labels no-box .
      478       view stream Prtcl frame Bttmframe .
      479       for each price-list no-lock
      480          where price-list.doc-num = price-doc.doc-num
      481         , each goods no-lock
      482          where goods.artic     = price-list.artic
      483            and goods.prod-type = price-list.prod-type
      484            and goods.prod-code = price-list.prod-code
      485       break by price-list.artic with frame Protocol
      486       :
      487   define variable vss-include-info8 as character format "X(65)" no-undo
      488   initial "@(#)$Workfile$ $Revision$".
      489               find first bar-code no-lock
      490                    where bar-code.b-code = price-list.b-code
      491               .
      492               if bar-code.unit-cli = goods.unit-base
      493               then do:
      494                   assign
      495                       v-code-is-main = yes
      496                   .
      497               end.
      498               else do:
      499                   assign
      500                       v-code-is-main = no
      501                   .
      502               end.
      503               if not (v-code-is-main = yes)
      504               then do:
      505                   assign
      506                       v-not-main-unit-cli       = bar-code.unit-cli
      507                       v-not-main-cli-base-rate  = bar-code.cli-base-rate
      508                       v-not-main-b-code         = bar-code.b-code
      509                   .
      510               end.
      511               find first gds-prt no-lock
      512                    where gds-prt.node-code = bar-code.node-code
      513               .
      514               assign
      515                 v-gds-prt-node-name =
      516                 ( if gds-prt.upper-code = goods.prt-root
      517                   then if bar-code.in-code = ''
      518                       then goods.gds-name
      519                       else bar-code.in-code + '    ' + bar-code.part-code
      520                   else
      521                           '    ' + gds-prt.f-name
      522                 )
      523               .
      524               run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Определили имя товара со шкалой ( "
      525                                                   + dtm-char(v-gds-prt-node-name)
      526                                                   + " )").
      527               find first gds-obj no-lock
      528                    where gds-obj.obj-type  = price-list.obj-type
      529                      and gds-obj.obj-code  = price-list.obj-code
      530                      and gds-obj.prod-type = price-list.prod-type
      531                      and gds-obj.prod-code = price-list.prod-code
      532                      and gds-obj.artic     = price-list.artic
      533               no-error.
      534               if available gds-obj
      535               then do:
      536                   assign
      537                       v-gds-obj-last-price = ( if v-rb-is-base = yes then gds-obj.last-base else gds-obj.last-rubl )
      538                   .
      539                   if v-gds-obj-last-price = ?
      540                   then do:
      541                       assign
      542                           v-gds-obj-last-price = 0
      543                       .
      544                   end.
      545                   run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Нашли товар ( "
      546                                   + string(gds-obj.artic) + " )" + " на объекте ( "
      547                                   + price-list.obj-type + string(price-list.obj-code) + " ). Определили цену закупки ( "
      548                                   + dtm-char(string(v-gds-obj-last-price)) + " )"
      549                                                       ).
      550               end.
      551               else do:
      552                   assign
      553                       v-gds-obj-last-price = 0
      554                   .
      555                   run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Не нашли товара ( "
      556                                   + string(price-list.artic) + " )" + " на объекте ( "
      557                                   + price-list.obj-type + string(price-list.obj-code) + " ). Назначили цену закупки ( 0 )"
      558                                                       ).
      559               end.
      560               find first gds-prt no-lock
      561                    where gds-prt.upper-code = goods.prt-root
      562               .
      563               assign
      564                   v-gds-prt-node-code = gds-prt.node-code
      565               .
      566   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      568     (input  price-list.obj-type
      569     ,input  price-list.obj-code
      570     ,input  price-list.b-code
      571     ,input  0
      572     ,input  price-list.fact-order
      573     ,output v-price-list-doc-num
      574     ,output v-price-list-price-sale
      575     ,output v-price-list-road-tax
      576     ,output v-price-list-excise
      577     )  .
      578               if v-price-list-price-sale = ?
      579               then do:
      580                   assign
      581                       v-price-list-price-sale = 0
      582                   .
      583               end.
      584               if v-price-list-road-tax = ?
      585               then do:
      586                   assign
      587                       v-price-list-road-tax = 0
      588                   .
      589               end.
      590               assign
      591                   v-price-list-price-sale_old = v-price-list-price-sale
      592               .
      593               run writelog in this-procedure (log-file-name, 4,
      594                                                           "R-AKT.i   Определили продажную цену из прайс-листа ( "
      595                                                           + dtm-char(string(v-price-list-price-sale)) + " )"
      596                                                   ).
      597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      598     (input  goods.gds-code
      599     ,input  bar-code.node-code
      600     ,output v-price-list-b-code
      601     )  .
      602               find first bar-code no-lock
      603                    where bar-code.b-code = v-price-list-b-code
      604               .
      605               accumulate bar-code.b-code ( count ) .
      606           if v-code-is-main
      607           then do:
      608             find first units no-lock
      609                  where units.unit-name = goods.unit-base
      610             no-error.
      611             display stream Prtcl sym1 v-good-line-counter
      612                             sym2 trim (string ( bar-code.b-code ))        @ v-b-code
      613                             sym3 price-list.artic
      614                             sym4  v-gds-prt-node-name   @ goods.gds-name
      615                             sym5 units.long-name
      616                             sym6 price-list.price-sale
      617                             sym10
      618             .
      619             if not LAST( price-list.artic )
      620             then do:
      621               assign
      622                   v-line-counter = v-line-counter  + 1
      623                   v-good-line-counter = v-good-line-counter  + 1
      624               .
      625             end.
      626           end.
      627       end.
      628       hide stream Prtcl frame Bttmframe .
      629       if line-counter( Prtcl ) + 13 > page-size( Prtcl ) then
      630           page stream Prtcl .
      631       put stream Prtcl v-single-line      format "X(136)" skip(1) space(5) "Всего "
      632                       v-good-line-counter format ">,>>>,>>9" space(2)
      633                       "наименований"      format "x(13)" skip(1)
      634       .
      635       define variable v-user-name as character no-undo .
      636   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      637   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      638     (input  v-cntxt-userid
      639     ,output v-user-name
      640     )  .
      641       put stream Prtcl skip(1) space(10) "Подписи сторон" format "x(100)" skip(1)
      642                       space(10) "Генеральный директор        : " format "x(70)" skip(1)
      643                       space(10) "Планово-экономический отдел : " format "x(70)" skip(1)
      644                       space(10) "Управляющий  магазином      : " format "x(70)" skip(3)
      645                       space(20) string( "Исполнитель : " + v-user-name ) format "x(70)" skip
      646       .
      647       output stream Prtcl close.
      648   if session :set-wait-state( "" ) then.
      649   if g#quest-print = false
      650   then do:
      651     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      652                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      653                                         OUTPUT g#log ).
      654   end.
      655   else do:
      656     os-command silent
      657       value( "COPY /b " +
      658         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      659         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      660         string( session:temp-directory) +  "$" + string( g#report-num )
      661                 ) .
      662     os-command silent
      663       value( "COPY /b " +
      664         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      665         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      666         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      667                 ) .
      668   end.
      669   end.
