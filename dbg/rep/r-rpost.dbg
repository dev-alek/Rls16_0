     1458   procedure create-temp-t-post-stk-line :
     1459       define variable str  as char      format "X(60)" no-undo.
     1460       define variable str2 as char      no-undo.
     1461       define variable v-r  as character no-undo init "" .
     1462       define variable i#i  as int       no-undo.
     1463    do
     1464    on error undo, return error return-value
     1465    :
     1466    if available ub.goods and
     1467       available ub.clients and
     1468       available prod-cli then do:
     1469     create temp-t-post-stk-line .
     1470     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1471     assign
     1472       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1473       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1474       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1475       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1476       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1477       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1478       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1479       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1480       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1481       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1482       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1483     .
     1484               if xlavel > 0 then
     1485               do:
     1486                   repeat i#i =1 to xlavel:
     1487                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1488                       else
     1489                       do:
     1490                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1491                           if not error-status:error  and str2 <> "":u then
     1492                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1493                       end.
     1494                   end.
     1495                   if str <> ? then
     1496                   do:
     1497                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1498                   end.
     1499               end.
     1500               else
     1501               do :
     1502                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1503               end.
     1504           end.
     1505    end.
     1506   end procedure.
     1507   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1508     if num-entries(string(p-dec), '.') = 2
     1509       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1510       else return( string(p-dec)) .
     1511   end function.
     1512   function format-point-to-comma returns char (input orig as char ) .
     1513   define variable rtext as character no-undo .
     1514   define variable strt as integer no-undo .
     1515   define variable leng as integer no-undo .
     1516   assign rtext = orig .
     1517   repeat:
     1518     strt =  index(rtext,'.').
     1519     if strt = 0 then leave.
     1520     leng = 1.
     1521     substring(rtext,strt,leng,"character") = v-delim .
     1522   end.
     1523   return rtext.
     1524   end function.
     1525   function format-excel-text returns char ( input start-text as char ) :
     1526   def var  i    as int no-undo.
     1527   def var  ch   as char no-undo.
     1528   def var  n    as int no-undo.
     1529   def var  ipos as int no-undo.
     1530     n = num-entries(trim(start-text), chr(10)) - 1 .
     1531     do i = 1 to n :
     1532       ipos = index( start-text, chr(10)).
     1533       if ipos > 0 then
     1534         substr( start-text, ipos, 1 ) = ' '.
     1535     end.
     1536     n = num-entries(trim(start-text), chr(13)) - 1 .
     1537     do i = 1 to n :
     1538       ipos = index( start-text, chr(13)).
     1539       if ipos > 0 then
     1540         substr( start-text, ipos, 1 ) = ' '.
     1541     end.
     1542     if index( start-text, '"' ) = 0 then
     1543       start-text =  '="'   + trim( start-text) + '"'   .
     1544       else do:
     1545         n = num-entries(trim(start-text), '"') - 1.
     1546         do i = 1 to n :
     1547           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1548         end.
     1549         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1550         start-text = '="'  + ch  + '"' .
     1551       end.
     1552     return start-text.
     1553   end.
     1554   function excel-sum returns char (input p-dec as decimal ).
     1555     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1556   end function.
     1557   function excel-qnty returns char (input p-dec as decimal ).
     1558     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1559   end function.
     1560   function format-excel-text-macr returns char ( input start-text as char ) :
     1561   def var  i    as int no-undo.
     1562   def var  ch   as char no-undo.
     1563   def var  n    as int no-undo.
     1564   def var  ipos as int no-undo.
     1565     n = num-entries(trim(start-text), chr(10)) - 1 .
     1566     do i = 1 to n :
     1567       ipos = index( start-text, chr(10)).
     1568       if ipos > 0 then
     1569         substring( start-text, ipos , 1 ) = ' '.
     1570     end.
     1571     n = num-entries(trim(start-text), chr(13)) - 1 .
     1572     do i = 1 to n :
     1573       ipos = index( start-text, chr(13)).
     1574       if ipos > 0 then
     1575         substring( start-text, ipos, 1 ) = ' '.
     1576     end.
     1577     if index( start-text, '"' ) = 0 then
     1578       start-text =  '"'   + trim( start-text) + '"'   .
     1579       else do:
     1580         n = num-entries(trim(start-text), '"') - 1.
     1581         do i = 1 to n :
     1582           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1583         end.
     1584         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1585         start-text = '"'  + ch  + '"' .
     1586       end.
     1587     n = num-entries(trim(start-text), chr(10)) - 1 .
     1588     do i = 1 to n :
     1589       ipos = index( start-text, chr(10)).
     1590       if ipos > 0 then
     1591         substring( start-text, ipos , 1 ) = ' '.
     1592     end.
     1593       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1594     return start-text.
     1595   end.
     1596   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1597   define variable  str  as char format "X(60)"  no-undo.
     1598   define variable  str2 as char no-undo.
     1599   define variable v-r as character no-undo init "" .
     1600   define variable  i#i as int no-undo.
     1601   STR = "".
     1602   repeat i#i =1 to lavel#:
     1603       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1604       else do:
     1605           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1606           if not error-status:error  and str2 <> "":u then
     1607                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1608           end.
     1609   end.
     1610   if str <> ? then do:
     1611   v-r = str + chr(47) .
     1612   end.
     1613   RETURN v-r .
     1614   END FUNCTION.
     1615   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616   procedure factord :
     1617     define input  parameter p-fact-date            as date    no-undo .
     1618     define input  parameter p-fact-time            as integer no-undo .
     1619     define input  parameter p-fact-num             as integer no-undo .
     1620     define input  parameter p-shift-date           as date    no-undo .
     1621     define input  parameter p-shift-num            as integer no-undo .
     1622     define input  parameter p-shift-on             as logical no-undo .
     1623     define output parameter p-fact-order           as decimal no-undo .
     1624     define output parameter p-shift-end-fact-order as decimal no-undo .
     1625     define output parameter p-day-end-fact-order   as decimal no-undo .
     1626     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1627     if p-fact-date = ?
     1628     then do:
     1629       return error "Не указана фактическая дата" .
     1630     end.
     1631     define variable v-fact-date-num as integer no-undo .
     1632     assign
     1633       v-fact-date-num = integer(p-fact-date)
     1634     .
     1635     if p-fact-num = ?
     1636     or p-fact-num = 0
     1637     then do:
     1638       return error "Не задан p-fact-num " + string(p-fact-num) .
     1639     end.
     1640     if p-fact-num < 0
     1641     then do:
     1642       return error "Отрицательный fact-num " + string(p-fact-num) .
     1643     end.
     1644     if p-fact-num >= 100000000
     1645     then do:
     1646       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1647     end.
     1648     if p-shift-on = true
     1649     then do:
     1650       if p-shift-date = ?
     1651       then do:
     1652         return error "Не задана дата смены" .
     1653       end.
     1654       if p-shift-num = ?
     1655       or p-shift-num = 0
     1656       then do:
     1657         return error "Не задан номер смены" .
     1658       end.
     1659     end.
     1660     else do:
     1661       assign
     1662         p-shift-date = p-fact-date
     1663         p-shift-num  = 24
     1664       .
     1665     end.
     1666     define variable v-shift-offset as integer no-undo .
     1667     if p-shift-date = p-fact-date
     1668     then do:
     1669       assign
     1670         v-shift-offset = 1
     1671       .
     1672     end.
     1673     if p-shift-date < p-fact-date
     1674     then do:
     1675       assign
     1676         v-shift-offset = 0
     1677       .
     1678     end.
     1679     if p-shift-date > p-fact-date
     1680     then do:
     1681       message
     1682         vss-workfile vss-revision vss-description skip
     1683         "Неправильная дата закрытия смены" skip
     1684         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1685         view-as alert-box error .
     1686       undo, return error
     1687         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1688           ,string(p-fact-date, '99/99/9999':U)
     1689           ,string(p-shift-date, '99/99/9999':U)
     1690           )
     1691       .
     1692     end.
     1693     if p-shift-num < 1
     1694     or p-shift-num > 24
     1695     then do:
     1696       message
     1697         vss-workfile vss-revision vss-description skip
     1698         "Неправильный номер смены" skip
     1699         "p-shift-num" p-shift-num skip
     1700         view-as alert-box error .
     1701       undo, return error return-value .
     1702     end.
     1703     assign
     1704       p-fact-order           = v-fact-date-num
     1705                              + v-shift-offset * 0.5
     1706                              + p-shift-num    * 0.02 - 0.01
     1707                              + p-fact-num     * 0.0000000001
     1708       p-shift-end-fact-order = v-fact-date-num
     1709                              + v-shift-offset * 0.5
     1710                              + p-shift-num    * 0.02
     1711       p-day-end-fact-order   = v-fact-date-num
     1712                              + 0.99
     1713     .
     1714     if p-fact-order           <= v-fact-date-num
     1715     or p-shift-end-fact-order <= v-fact-date-num
     1716     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1717     or p-shift-end-fact-order >= p-day-end-fact-order
     1718     then do:
     1719       message
     1720         vss-workfile vss-revision vss-description skip
     1721         "Внутренняя ошибка при генерации фактического номера" skip
     1722         "p-fact-date"            p-fact-date            skip
     1723         "p-fact-time"            p-fact-time            skip
     1724         "p-fact-num"             p-fact-num             skip
     1725         "p-shift-date"           p-shift-date           skip
     1726         "p-shift-num"            p-shift-num            skip
     1727         "p-shift-on"             p-shift-on             skip
     1728         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1729         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1730         "v-fact-date-num"        v-fact-date-num        skip
     1731         view-as alert-box error .
     1732       undo, return error return-value .
     1733     end.
     1734   end procedure.
     1735   procedure day-begin-fact-order :
     1736     define input  parameter p-fact-date            as date    no-undo .
     1737     define output parameter p-day-begin-fact-order as decimal no-undo .
     1738     do
     1739     on error undo, return error return-value
     1740     :
     1741       if p-fact-date = ?
     1742       then do:
     1743         assign
     1744           p-day-begin-fact-order = 0
     1745         .
     1746       end.
     1747       else do:
     1748         assign
     1749           p-day-begin-fact-order = integer(p-fact-date)
     1750         .
     1751       end.
     1752     end.
     1753   end procedure.
     1754   procedure factord-max-fact-order :
     1755     define output parameter p-max-fact-order as decimal   no-undo .
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759       run day-begin-fact-order in this-procedure
     1760         (input  date(1, 1, 5000)
     1761         ,output p-max-fact-order
     1762         ) .
     1763     end.
     1764   end procedure.
     1765   procedure factord-cut-archive :
     1766     define input  parameter p-obj-type             as character no-undo .
     1767     define input  parameter p-obj-code             as integer   no-undo .
     1768     define input  parameter p-fact-date            as date      no-undo .
     1769     define output parameter p-shift-on             as logical   no-undo .
     1770     define output parameter p-shift-date           as date      no-undo .
     1771     define output parameter p-shift-num            as integer   no-undo .
     1772     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1773     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1774     define variable v-fact-order as decimal   no-undo .
     1775     define buffer buf_shift-obj for ub.shift-obj .
     1776     do
     1777     on error undo, return error return-value
     1778     :
     1779   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1780   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1781     (input  p-obj-type
     1782     ,input  p-obj-code
     1783     ,input  'shift-on=request'
     1784     ,output p-shift-on
     1785     ) no-error .
     1786       if error-status :error
     1787       then do:
     1788         message
     1789           vss-workfile vss-revision vss-description skip
     1790           "Ошибка при определении атрибута объекта" skip
     1791           "Объект" p-obj-type p-obj-code skip
     1792           error-status :get-message(1) skip
     1793           return-value skip
     1794           view-as alert-box error .
     1795         undo, return error return-value .
     1796       end.
     1797       if p-shift-on = false
     1798       then do:
     1799         assign
     1800           p-shift-date               = ?
     1801           p-shift-num                = 0
     1802         .
     1803       end.
     1804       else do:
     1805         find first buf_shift-obj share-lock
     1806           where buf_shift-obj.obj-type   = p-obj-type
     1807             and buf_shift-obj.obj-code   = p-obj-code
     1808             and buf_shift-obj.shift-date > p-fact-date
     1809           use-index pi
     1810           no-error .
     1811         if not available buf_shift-obj
     1812         or buf_shift-obj.status_ <> 'зкр':U
     1813         then do:
     1814           message
     1815             vss-workfile vss-revision vss-description skip
     1816             "Невозможно вычислить последнюю смену" skip
     1817             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1818             "Объект" p-obj-type p-obj-code skip
     1819             "Дата" p-fact-date skip
     1820             view-as alert-box error .
     1821           undo, return error return-value .
     1822         end.
     1823         find last buf_shift-obj share-lock
     1824           where buf_shift-obj.obj-type = p-obj-type
     1825             and buf_shift-obj.obj-code = p-obj-code
     1826             and buf_shift-obj.shift-date <= p-fact-date
     1827           use-index pi
     1828           no-error .
     1829         if available buf_shift-obj
     1830         then do:
     1831           if  buf_shift-obj.status_ = 'зкр':U
     1832           then do:
     1833             assign
     1834               p-shift-date = buf_shift-obj.shift-date
     1835               p-shift-num  = buf_shift-obj.shift-num
     1836             .
     1837           end.
     1838           else do:
     1839             message
     1840               vss-workfile vss-revision vss-description skip
     1841               "Невозможно вычислить последнюю смену" skip
     1842               "Статус смены отличен от статуса" 'зкр':U skip
     1843               "Объект" p-obj-type p-obj-code skip
     1844               "Дата" p-fact-date skip
     1845               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1846               view-as alert-box error .
     1847             undo, return error return-value .
     1848           end.
     1849         end.
     1850         else do:
     1851           assign
     1852             p-shift-date = p-fact-date - 1
     1853             p-shift-num  = 1
     1854           .
     1855         end.
     1856       end.
     1857       run factord in this-procedure
     1858         (input  p-fact-date
     1859         ,input  1
     1860         ,input  1
     1861         ,input  p-shift-date
     1862         ,input  p-shift-num
     1863         ,input  p-shift-on
     1864         ,output v-fact-order
     1865         ,output p-shift-end-fact-order
     1866         ,output p-day-end-fact-order
     1867         ) no-error .
     1868       if error-status :error
     1869       then do:
     1870         message
     1871           vss-workfile vss-revision vss-description skip
     1872           "Ошибка при вызове процедуры factord"
     1873           error-status :get-message(1) skip
     1874           return-value skip
     1875           view-as alert-box error .
     1876         undo, return error return-value .
     1877       end.
     1878     end.
     1879   end procedure.
     1880   procedure factord-lock-shift :
     1881     define input  parameter p-obj-type  as character no-undo .
     1882     define input  parameter p-obj-code  as integer   no-undo .
     1883     define input  parameter p-fact-date as date      no-undo .
     1884     define parameter buffer buf_shift-obj for ub.shift-obj .
     1885     define variable v-shift-on      as logical   no-undo .
     1886     define variable v-extra-message as character no-undo .
     1887     define variable v-error as character no-undo .
     1888     do
     1889     on error undo, return error return-value
     1890     :
     1891   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1892   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1893     (input  p-obj-type
     1894     ,input  p-obj-code
     1895     ,input  'shift-on=request'
     1896     ,output v-shift-on
     1897     ) no-error .
     1898       if error-status :error
     1899       then do:
     1900         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1901         undo, return error v-error .
     1902       end.
     1903       if v-shift-on = true
     1904       then do:
     1905         find first buf_shift-obj share-lock
     1906           where buf_shift-obj.obj-type   = p-obj-type
     1907             and buf_shift-obj.obj-code   = p-obj-code
     1908             and buf_shift-obj.shift-date > p-fact-date
     1909           use-index pi
     1910           no-error .
     1911         if not available buf_shift-obj
     1912         or buf_shift-obj.status_ <> 'зкр':U
     1913         then do:
     1914           find last buf_shift-obj
     1915             where buf_shift-obj.obj-type = p-obj-type
     1916               and buf_shift-obj.obj-code = p-obj-code
     1917               and buf_shift-obj.status_  = 'зкр':U
     1918             use-index stts
     1919             no-error .
     1920           if available buf_shift-obj
     1921           then do:
     1922             assign
     1923               v-extra-message =
     1924                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1925                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1926                               )
     1927             .
     1928           end.
     1929           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1930           undo, return error v-error .
     1931         end.
     1932       end.
     1933     end.
     1934   end procedure.
     1935   procedure factord-end-day :
     1936     define input  parameter p-fact-date            as date    no-undo .
     1937     define output parameter p-day-end-fact-order   as decimal no-undo .
     1938     do
     1939     on error undo, return error return-value
     1940     :
     1941       if p-fact-date = ?
     1942       then do:
     1943         return error "Не указана фактическая дата" .
     1944       end.
     1945       assign
     1946         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1947       .
     1948     end.
     1949   end procedure.
     1950   procedure factord-to-date :
     1951     define input  parameter p-fact-order as decimal no-undo .
     1952     define output parameter p-fact-date  as date    no-undo .
     1953     define variable v-ref-date  as date      no-undo .
     1954     define variable v-ref-delta as integer   no-undo .
     1955     do
     1956     on error undo, return error return-value
     1957     :
     1958       if p-fact-order = ?
     1959       or p-fact-order = 0
     1960       then do:
     1961         return error "Не указан fact-order" .
     1962       end.
     1963       assign
     1964         v-ref-date  = date(1, 1, 2000)
     1965       .
     1966       assign
     1967         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1968       .
     1969       assign
     1970         p-fact-date = v-ref-date + v-ref-delta
     1971       .
     1972     end.
     1973   end procedure.
     1974   procedure factord-to-fact-num :
     1975     define input  parameter p-fact-order as decimal no-undo .
     1976     define output parameter p-fact-num   as integer no-undo .
     1977     define variable v-fact-order-trunc as decimal no-undo .
     1978     do
     1979     on error undo, return error return-value
     1980     :
     1981       if p-fact-order = ?
     1982       or p-fact-order = 0
     1983       then do:
     1984         return error "Не указан fact-order" .
     1985       end.
     1986       assign
     1987        v-fact-order-trunc = truncate(p-fact-order, 2)
     1988       .
     1989       assign
     1990         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1991       .
     1992     end.
     1993   end procedure.
     1994   procedure factord-to-shift-num :
     1995     define input  parameter p-fact-order as decimal no-undo .
     1996     define output parameter p-shift-num   as integer no-undo .
     1997     define variable  p-shift-numd  as decimal   no-undo .
     1998     define variable v-fact-order-trunc as decimal no-undo .
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002       if p-fact-order = ?
     2003       or p-fact-order = 0
     2004       then do:
     2005         return error "Не указан fact-order" .
     2006       end.
     2007       assign
     2008        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2009       .
     2010       if v-fact-order-trunc < 0.5 then do:
     2011         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2012       end.
     2013       assign
     2014         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2015         .
     2016        assign
     2017         p-shift-num = truncate (p-shift-numd , 0)
     2018       .
     2019     end.
     2020   end procedure.
     2021   define temp-table temp-font no-undo
     2022     field fontnum  as integer
     2023     field fontname as character
     2024     field fontsize as character
     2025     field fonttype as character
     2026     field font-h   as integer
     2027     field font-w   as integer
     2028     field v-row    as integer
     2029     field v-col    as integer
     2030     field v-row-lans as integer
     2031     field v-col-lans as integer
     2032   index pi fontnum
     2033   .
     2034   procedure get-font-ini :
     2035     do
     2036     on error undo, return error return-value
     2037     :
     2038   define variable ii as integer   no-undo .
     2039   define variable v-font7 as character no-undo .
     2040   define variable v-font as character no-undo .
     2041   define variable loc-name as character no-undo .
     2042   define variable loc-size as character no-undo .
     2043   define variable loc-type as character no-undo .
     2044   define variable old_H as integer   no-undo .
     2045   define variable old_w as integer   no-undo .
     2046   define variable old-row  as integer   no-undo .
     2047   define variable old-col  as integer   no-undo .
     2048   define variable old-row-lans  as integer   no-undo .
     2049   define variable old-col-lans  as integer   no-undo .
     2050   define variable vv as integer   no-undo .
     2051   empty temp-table temp-font.
     2052     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     2053       case num-entries (v-font7) :
     2054         when 4 then do:
     2055             assign
     2056               loc-name = entry ( 1 , v-font7 )
     2057               loc-size = entry ( 2 , v-font7 )
     2058               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     2059             .
     2060         end.
     2061         when 3 then do:
     2062             assign
     2063               loc-name = entry ( 1 , v-font7 )
     2064               loc-size = entry ( 2 , v-font7 )
     2065               loc-type = entry ( 3 , v-font7 )
     2066             .
     2067         end.
     2068         when 2 then  do:
     2069             assign
     2070               loc-name = entry ( 1 , v-font7 )
     2071               loc-size = entry ( 2 , v-font7 )
     2072               loc-type = ""
     2073             .
     2074         end.
     2075         when 1 then do:
     2076             assign
     2077               loc-name = trim(entry ( 1 , v-font7 ))
     2078               loc-size = ""
     2079               loc-type = ""
     2080             .
     2081         end.
     2082       end case.
     2083     create temp-font.
     2084     assign
     2085       temp-font.fontnum  = 7
     2086       temp-font.fontname = trim(loc-name)
     2087       temp-font.fontsize = trim(loc-size)
     2088       temp-font.fonttype = trim(loc-type)
     2089       temp-font.v-row    = 62
     2090       temp-font.v-col    = 136
     2091       temp-font.v-row-lans = 43
     2092       temp-font.v-col-lans = 198
     2093     .
     2094     repeat ii = 16 to 100 :
     2095       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     2096       if v-font = "" or v-font = ? then leave.
     2097       case num-entries (v-font) :
     2098         when 4 then do:
     2099             assign
     2100               loc-name = entry ( 1 , v-font )
     2101               loc-size = entry ( 2 , v-font )
     2102               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     2103             .
     2104         end.
     2105         when 3 then do:
     2106             assign
     2107               loc-name = entry ( 1 , v-font )
     2108               loc-size = entry ( 2 , v-font )
     2109               loc-type = entry ( 3 , v-font )
     2110             .
     2111         end.
     2112         when 2 then do:
     2113             assign
     2114               loc-name = entry ( 1 , v-font )
     2115               loc-size = entry ( 2 , v-font )
     2116               loc-type = ""
     2117             .
     2118         end.
     2119         when 1 then do:
     2120             assign
     2121               loc-name = trim(entry ( 1 , v-font ))
     2122               loc-size = ""
     2123               loc-type = ""
     2124             .
     2125         end.
     2126       end case.
     2127     create temp-font.
     2128     assign
     2129       temp-font.fontnum  = ii
     2130       temp-font.fontname = trim(loc-name)
     2131       temp-font.fontsize = trim(loc-size)
     2132       temp-font.fonttype = trim(loc-type)
     2133     .
     2134     end.
     2135       for each temp-font :
     2136          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     2137          if  vv = ? then vv =  0 .
     2138           run rep/exfont.p (
     2139             input   temp-font.fontname ,
     2140             input   vv ,
     2141             input   temp-font.fonttype ,
     2142             output  temp-font.font-h   ,
     2143             output  temp-font.font-w   )
     2144           .
     2145       end.
     2146   find first temp-font where  temp-font.fontnum  = 7  .
     2147   old_H = temp-font.font-H .
     2148   old_w = temp-font.font-W .
     2149   old-row = temp-font.v-row .
     2150   old-col = temp-font.v-col .
     2151   old-row-lans = temp-font.v-row-lans .
     2152   old-col-lans = temp-font.v-col-lans .
     2153       for each temp-font where
     2154                temp-font.fontnum  <> 7 :
     2155           assign
     2156               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2157               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2158               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2159               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2160           .
     2161       end.
     2162     end.
     2163   end procedure.
     2164   PROCEDURE How-name :
     2165   define input  parameter h as integer no-undo .
     2166   define input  parameter w as integer no-undo .
     2167   define output parameter n as character  no-undo .
     2168   define variable A4port-H as integer   no-undo init 63.
     2169   define variable A4port-W as integer   no-undo init 136.
     2170   define variable A4lans-H as integer   no-undo init 43.
     2171   define variable A4lans-W as integer   no-undo init 198.
     2172   define variable Strim-W  as integer   no-undo init 278.
     2173   run define-a4-size (
     2174        input ReportFontNum
     2175       ,output A4port-H
     2176       ,output A4port-W
     2177       ,output A4lans-H
     2178       ,output A4lans-W ).
     2179   If w >= 1 and w <= A4port-W Then DO:
     2180     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2181     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2182     If h > A4port-H              Then n = "to-file":U.
     2183   End.
     2184   If w > A4port-W and w <= A4lans-W Then DO:
     2185     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2186     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2187     If h > A4port-H              Then n = "to-file":U.
     2188   End.
     2189   If w > A4lans-W and w <= Strim-W Then DO:
     2190     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2191     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2192     If h > A4port-H              Then n = "to-file":U.
     2193   End.
     2194   If w > Strim-W Then DO:
     2195      n = "to-file":U.
     2196   End.
     2197   END PROCEDURE.
     2198   PROCEDURE define-a4-size :
     2199   define input  parameter p-ReportFontNum as integer   no-undo .
     2200   define output parameter A4port-H as integer   no-undo .
     2201   define output parameter A4port-W as integer   no-undo .
     2202   define output parameter A4lans-H as integer   no-undo .
     2203   define output parameter A4lans-W as integer   no-undo .
     2204   if not can-find (first temp-font ) then do:
     2205      run get-font-ini .
     2206   end.
     2207   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2208   if available temp-font then do:
     2209   assign
     2210     A4port-H = temp-font.v-row
     2211     A4port-W = temp-font.v-col
     2212     A4lans-H = temp-font.v-row-lans
     2213     A4lans-W = temp-font.v-col-lans
     2214   .
     2215   end.
     2216   else do:
     2217   assign
     2218     A4port-H = 63
     2219     A4port-W = 136
     2220     A4lans-H = 43
     2221     A4lans-W = 198
     2222   .
     2223   end.
     2224   END PROCEDURE.
