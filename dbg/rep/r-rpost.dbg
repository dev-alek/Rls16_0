      621   def
      622    shared
      623   temp-table  obj-list no-undo
      624     field obj-type like ub.clients.obj-type
      625     field obj-code like ub.clients.obj-code
      626     field obj-name like ub.clients.obj-name
      627     field obj-id   as integer
      628     field db-num   as integer
