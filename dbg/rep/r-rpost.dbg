     2288           run report-execute.
     2289   procedure report-execute :
     2290     if (valtype=0 and x-base-code=0)  or valtype=1
     2291                                   then   assign tprintrubl = yes .
     2292                                   else   assign tprintrubl = no .
     2293     run waitfram-show ( 'Подождите ...' ) .
     2294   output stream outstream to value( string( session:temp-directory +
     2295                                        "rpt" + string( g#report-num ) ) )
     2296                                        page-size  value(reportpageheight) .
     2297    run report-exec1.
     2298     hide   stream outstream frame zapas .
     2299     output stream outstream close.
     2300     run waitfram-hide .
     2301     if Make-Excel then output stream ForExcel close.
     2302     define variable v-user-action as character no-undo .
     2303     define variable v-printed as logical   no-undo .
     2304     define variable disabledoptions as integer   no-undo .
     2305     define variable v-orient-page as character no-undo .
     2306     run How-name in this-procedure (
     2307         input ReportPageHeight,
     2308         input ReportPageWidth,
     2309         output v-orient-page )
     2310         .
     2311     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2312                                    else DisabledOptions = 0 .
     2313     run gbl/prnfilen.w
     2314       (input  ""
     2315       ,input  disabledoptions
     2316       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2317       ,input ReportFontNum
     2318       ,output v-user-action
     2319       ,output v-printed
     2320       ) .
     2321   end procedure.
     2322   procedure print-header :
     2323   if not firstline then  run display-title.
     2324       firstline = true .
     2325        form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2326         run clear-b1 .
     2327         run clear-b2.
     2328         run clear-bi .
     2329         break_group = true.
     2330         break_group1 = true.
     2331      end procedure.
     2332   procedure print-footer :
     2333         if retclassify = "no-classify":u  then run u-line.
     2334          gds-zap-artic = "ИТОГО" .
     2335          run display-bi.
     2336          run u-line.
     2337          end procedure.
     2338   procedure u-line :
     2339   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2340           gds-zap-b-code
     2341           gds-zap-artic
     2342           gds-zap-gds-name
     2343           gds-zap-unit-base
     2344           gds-type
     2345           f-vzvr
     2346           f-rash
     2347           f-kassa
     2348           f-inv
     2349           f-vzvr-post
     2350           f-spis
     2351           with FRAME ZAPAS .
     2352           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2353           end procedure.
     2354   procedure p-line :
     2355   underline stream outstream
     2356           sym3
     2357           gds-zap-gds-name
     2358           sym4
     2359           gds-zap-unit-base
     2360           sym5
     2361           with FRAME ZAPAS.
     2362           DOWN stream   OutStream 1 with FRAME ZAPAS .
     2363           end procedure.
     2364   procedure calcitog :
     2365   xtog-obj = false .
     2366         run factord-end-day (input x-date-start - 1 , output fact-order-1 ) .
     2367         run factord-end-day (input x-date-end,        output fact-order-2 ) .
     2368        xtog-obj = xtogobj .
     2369   end procedure.
     2370   procedure display-bi  :
     2371                                 run di-qnty ("кол-во" , 1 , "", gds-zap-artic ,"" ,"", "bi":u).
     2372            if show-cost        then do: run di ("учет."  , 2 , "","", "", "", "bi":u).  end.
     2373            if show-cost-vat    then do: run di ("уч.НДС" , 3 , "","", "", "", "bi":u).  end.
     2374            if show-sale        then do: run di ("док-т." , 5 , "","", "", "", "bi":u).  end.
     2375            if show-sale-vat    then do: run di ("д .НДС" , 6 , "","", "", "", "bi":u).  end.
     2376   end procedure.
     2377   procedure clear-b1  :
     2378    repeat kk = 1 to 9 :
     2379    assign
     2380       b1-spis                                            [kk]    = 0
     2381       b1-rash                                            [kk]    = 0
     2382       b1-kassa                                           [kk]    = 0
     2383       b1-inv                                             [kk]    = 0
     2384       b1-vzvr-post                                       [kk]    = 0
     2385       b1-vzvr                                            [kk]    = 0   .
     2386      end.
     2387    end procedure.
     2388   procedure clear-b2  :
     2389    repeat kk = 1 to 9 :
     2390    assign
     2391       b2-spis                                            [kk]    = 0
     2392       b2-rash                                            [kk]    = 0
     2393       b2-kassa                                           [kk]    = 0
     2394       b2-inv                                             [kk]    = 0
     2395       b2-vzvr-post                                       [kk]    = 0
     2396       b2-vzvr                                            [kk]    = 0   .
     2397      end.
     2398   end procedure.
     2399   procedure clear-bi  :
     2400    repeat kk = 1 to 9 :
     2401    assign
     2402       bi-spis                                            [kk]    = 0
     2403       bi-rash                                            [kk]    = 0
     2404       bi-kassa                                           [kk]    = 0
     2405       bi-inv                                             [kk]    = 0
     2406       bi-vzvr-post                                       [kk]    = 0
     2407       bi-vzvr                                            [kk]    = 0   .
     2408      end.
     2409   end procedure.
     2410   procedure display-title :
     2411      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2412             reportname  at 20 format "x(170)" skip
     2413             trim(str1)  at 35 format "x(75)" skip.
     2414        repeat i = 1 to num-entries(str2,chr(10)) :
     2415         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2416        end.
     2417       i=0.
     2418          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2419        repeat i = 1 to num-entries(str4,chr(10)) :
     2420         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2421        end.
     2422       i=0.
     2423        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2424         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2425        end.
     2426       i=0.
     2427       run rep/extitle.p (1).
     2428   end procedure.
     2429   PROCEDURE ostatok :
     2430   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2431   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2432   def input parameter x-tog-shift   as   logical             no-undo.
     2433   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2434   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2435   def input parameter x-shift-start as integer               no-undo.
     2436   def input parameter x-shift-end   as integer               no-undo.
     2437   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2438   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2439   def input parameter xTog-obj   as log no-undo.
     2440   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2441   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2442   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2443   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2444   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2445   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2446   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2447   def var              Fact-orderS   as char  no-undo.
     2448   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2449      Assign
     2450         Fact-order   = 0
     2451         Quantity     = 0
     2452         Coast_R      = 0
     2453         Coast_V      = 0
     2454         VAT_R        = 0
     2455         VAT_V        = 0 .
     2456    x-date-start-t  = x-date-start + 1 .
     2457   IF x-date-end = date('') then DO:
     2458      Fact-order = 0 .
     2459      for each obj-list
     2460          where  ( not xtog-obj or
     2461                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2462                 no-lock :
     2463         if  x-tog-shift = false then do:
     2464                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2465                               ub.stk-tot.Fact-date <=  x-date-start
     2466                               and ub.stk-tot.shift-num = 0
     2467                               USE-INDEX fact-date no-lock no-error .
     2468              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2469         End.
     2470         Else  DO :
     2471             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2472              (ub.stk-tot.shift-date  = x-date-start-t and
     2473               ub.stk-tot.shift-num  < x-shift-start or
     2474               ub.stk-tot.shift-date  < x-date-start-t  )
     2475               and ub.stk-tot.shift-num  > 0
     2476               USE-INDEX Shift-num no-lock no-error .
     2477            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2478           END.
     2479       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2480     End.
     2481   End.
     2482   Else DO:
     2483     For each obj-list  WHERE
     2484        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2485         no-lock :
     2486      IF  x-TOG-Shift = False Then DO:
     2487          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2488               ub.stk-tot.Fact-date <= x-date-end
     2489               and ub.stk-tot.shift-num = 0
     2490               USE-INDEX fact-date no-lock no-error.
     2491          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2492      END.
     2493      Else DO:
     2494           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2495               (ub.stk-tot.shift-date  = x-date-end and
     2496               ub.stk-tot.shift-num  <= x-shift-end or
     2497               ub.stk-tot.shift-date  < x-date-end       ) and
     2498               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2499               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2500       End.
     2501       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2502     End.
     2503   End.
     2504   END PROCEDURE.
     2505   procedure report-exec1  :
     2506      find first a-clients where x-store-type = a-clients.obj-type and
     2507                               x-store-code = a-clients.obj-code no-lock no-error.
     2508              if available a-clients then  objname = a-clients.obj-name. else  objname = "объект не определен".
     2509     run waitfram-show (objname) .
     2510     form with frame zapas .
     2511   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2512   form header
     2513     line format "x(194)" at 1 skip
     2514     "Продолжение - на следующей странице" at 30 skip
     2515     with frame bottomframe width 232 page-bottom no-labels no-box .
     2516   view stream outstream frame bottomframe .
     2517     run calcitog.
     2518     run print-header.
     2519     case retsorttype :
     2520         when "sort-article":u  or when "sort-artic":u  then
     2521         if not can-find(first g#post no-lock)
     2522             then   run rep/r-rpost1.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2523             else   run rep/r-rpost2.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2524         when "sort-code":u  then
     2525         if not can-find(first g#post no-lock)
     2526             then   run rep/r-rpost3.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2527             else   run rep/r-rpost4.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2528     end case.
     2529     hide stream outstream frame bottomframe .
     2530     run print-footer.
     2531     end procedure.
     2532   procedure calc-sub-itog :
     2533   define input parameter tt as int no-undo.
     2534   define variable b as int no-undo.
     2535   repeat b = 1 to 3:
     2536     assign
     2537     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     2538     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     2539     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     2540     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     2541     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     2542     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     2543     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     2544     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     2545     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     2546      .
     2547   end.
     2548   end procedure.
     2549   procedure clear-item :
     2550   define variable kk as int no-undo.
     2551    repeat kk = 1 to 9:
     2552    assign
     2553       rash             [kk]  = 0
     2554       kassa            [kk]  = 0
     2555       inv              [kk]  = 0
     2556       vzvr-post        [kk]  = 0
     2557       vzvr             [kk]  = 0
     2558       spis             [kk]  = 0 .
     2559          end.
     2560    end procedure.
     2561   procedure di :
     2562   define input parameter p1 as char no-undo.
     2563   define input parameter p2 as int no-undo.
     2564   define input parameter p3 as char no-undo.
     2565   define input parameter p4 as char no-undo.
     2566   define input parameter p5 as char no-undo.
     2567   define input parameter p6 as char no-undo.
     2568   define input parameter p7 as char no-undo.
     2569    case caps(p7) :
     2570      when "bi":u then do:
     2571                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2572                   p3 @ gds-zap-b-code
     2573                   p4 @ gds-zap-artic
     2574                   p5 @ gds-zap-gds-name
     2575                   p6 @ gds-zap-unit-base
     2576                   p1 @ gds-type
     2577                  bi-vzvr      [p2]    @  F-vzvr
     2578                  bi-vzvr-post [p2]    @  F-vzvr-post
     2579                  bi-RAsh      [p2]    @  F-RAsh
     2580                  bi-KAssa     [p2]    @  F-KAssa
     2581                  bi-Inv       [p2]    @  F-Inv
     2582                  bi-spis      [p2]    @  F-spis
     2583                  with FRAME ZAPAS .
     2584                end.
     2585      end case.
     2586                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2587    end procedure.
     2588   procedure di-qnty :
     2589   define input parameter p1 as char no-undo.
     2590   define input parameter p2 as int no-undo.
     2591   define input parameter p3 as char no-undo.
     2592   define input parameter p4 as char no-undo.
     2593   define input parameter p5 as char no-undo.
     2594   define input parameter p6 as char no-undo.
     2595   define input parameter p7 as char no-undo.
     2596    case caps(p7) :
     2597      when "bi":u then  do :
     2598                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2599                   p3 @ gds-zap-b-code
     2600                   p4 @ gds-zap-artic
     2601                   p5 @ gds-zap-gds-name
     2602                   p6 @ gds-zap-unit-base
     2603                   p1 @ gds-type
     2604                  bi-vzvr      [p2]    @  F-vzvr
     2605                  bi-vzvr-post [p2]    @  F-vzvr-post
     2606                  bi-RAsh      [p2]    @  F-RAsh
     2607                  bi-KAssa     [p2]    @  F-KAssa
     2608                  bi-Inv       [p2]    @  F-Inv
     2609                  bi-spis      [p2]    @  F-spis
     2610                  with FRAME ZAPAS .
     2611       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     2612                   p4 CHR(9)
     2613                   p5 CHR(9)
     2614                   p6 CHR(9)
     2615                   gds-zap-type CHR(9)
     2616                    excel-qnty(bi-RAsh         [1]  ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2617   if Showcost       then (     excel-sum  (   bi-RAsh[2] )  + CHR(9)   ) else ("")
     2618   if Show-cost-vat  then (     excel-sum  (   bi-RAsh[3] )  + CHR(9)   ) else ("")
     2619   if Showsale       then (     excel-sum  (   bi-RAsh[5] )  + CHR(9)   ) else ("")
     2620   if Show-sale-vat  then (     excel-sum  (   bi-RAsh[6] )  + CHR(9)   ) else ("")
     2621                    excel-qnty(bi-KAssa        [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2622   if Showcost       then (     excel-sum  (   bi-KAssa[2])  + CHR(9)    ) else ("")
     2623   if Show-cost-vat  then (     excel-sum  (   bi-KAssa[3])  + CHR(9)    ) else ("")
     2624   if Showsale       then (     excel-sum  (   bi-KAssa[5])  + CHR(9)    ) else ("")
     2625   if Show-sale-vat  then (     excel-sum  (   bi-KAssa[6])  + CHR(9)    ) else ("")
     2626   .
     2627   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( bi-Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2628   if Showcost       then (     excel-sum  (   bi-Inv [2] ) + CHR(9)    ) else ("")
     2629   if Show-cost-vat  then (     excel-sum  (   bi-Inv [3] ) + CHR(9)    ) else ("")
     2630   if Showsale       then (     excel-sum  (   bi-Inv [5] ) + CHR(9)    ) else ("")
     2631   if Show-sale-vat  then (     excel-sum  (   bi-Inv [6] ) + CHR(9)    ) else ("")
     2632                    excel-qnty(bi-vzvr         [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2633   if Showcost       then (     excel-sum  (   bi-vzvr [2] ) + CHR(9)    ) else ("")
     2634   if Show-cost-vat  then (     excel-sum  (   bi-vzvr [3] ) + CHR(9)    ) else ("")
     2635   if Showsale       then (     excel-sum  (   bi-vzvr [5] ) + CHR(9)    ) else ("")
     2636   if Show-sale-vat  then (     excel-sum  (   bi-vzvr [6] ) + CHR(9)    ) else ("")
     2637                   excel-qnty(bi-vzvr-post    [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2638   if Showcost       then (     excel-sum  (   bi-vzvr-post[2] ) + CHR(9)     ) else ("")
     2639   if Show-cost-vat  then (     excel-sum  (   bi-vzvr-post[3] ) + CHR(9)     ) else ("")
     2640   if Showsale       then (     excel-sum  (   bi-vzvr-post[5] ) + CHR(9)     ) else ("")
     2641   if Show-sale-vat  then (     excel-sum  (   bi-vzvr-post[6] ) + CHR(9)     ) else ("")
     2642                   excel-qnty(bi-spis    [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     2643   if Showcost       then (     excel-sum  (   bi-spis[2] ) + CHR(9)     ) else ("")
     2644   if Show-cost-vat  then (     excel-sum  (   bi-spis[3] ) + CHR(9)     ) else ("")
     2645   if Showsale       then (     excel-sum  (   bi-spis[5] ) + CHR(9)     ) else ("")
     2646   if Show-sale-vat  then (     excel-sum  (   bi-spis[6] ) + CHR(9)     ) else ("")
     2647            chr(10).
     2648                end.
     2649      end case.
     2650                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2651    end procedure.
