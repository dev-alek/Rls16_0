     5601   PROCEDURE select1 :
     5602   Link# = true.
     5603     run select-page in state-source ( 1 ).
     5604     run local-apply-layout in this-procedure .
     5605   END PROCEDURE.
     5606   PROCEDURE Set_VAl :
     5607      IF SET_PAY_TYPE:screen-value IN frame F-Main = "3"
     5608          then   enable SET_VAL_TYPE with frame F-Main .
     5609      IF SET_PAY_TYPE:screen-value IN frame F-Main = "2"
     5610          then   enable SET_VAL_TYPE with frame F-Main .
     5611      IF SET_PAY_TYPE:screen-value IN frame F-Main = "1"
     5612          THEN   disable SET_VAL_TYPE with frame F-Main .
     5613      IF temp-param-pay = "" AND  temp-param-pay-hide = ""   THEN DO:
     5614         disable SET_VAL_TYPE with frame F-Main .
     5615         hide  SET_val_TYPE  in frame F-Main .
     5616         End.
     5617   END PROCEDURE.
     5618   PROCEDURE sss :
     5619   define buffer buf_clients for ub.clients .
     5620   define buffer cli-obj      for ub.clients .
     5621   define buffer buf_user-obj for ub.user-obj .
     5622   define buffer buf_db for ub.db .
     5623   define buffer buf_store for ub.store .
     5624   define buffer buf_shop for ub.shop .
     5625   define buffer buf_sysconf for ub.sysconf .
     5626    If NOT (temp-param-obj = '*'
     5627       OR Lookup(string(4),replace(temp-param-obj,"!","")) > 0
     5628       OR Lookup(string(1),replace(temp-param-obj,"!","")) > 0  ) then DO:
     5629      message "Выполнить невозможно, смените текущий объект !" view-as alert-box error .
     5630     return error.
     5631    End.
     5632     FOR EACH obj-list :  delete obj-list.  END.
     5633     assign
     5634       str-obj#  = ''
     5635       str-obj2# = ''
     5636       str-obj3# = ''
     5637     .
     5638     for each buf_user-obj no-lock
     5639       where buf_user-obj.db-num  = v-cntxt-db-num
     5640         and buf_user-obj.user-id = v-cntxt-userid ,
     5641      each cli-obj no-lock
     5642       where cli-obj.obj-type = buf_user-obj.obj-type
     5643         and cli-obj.obj-code = buf_user-obj.obj-code
     5644         and ( ( cli-obj.db-num = v-cntxt-db-num ) or v-cntxt-db-num = 0 )
     5645     :
     5646             find first buf_clients no-lock
     5647               where buf_clients.obj-type = buf_user-obj.obj-type
     5648                 and buf_clients.obj-code = buf_user-obj.obj-code
     5649               .
     5650             if buf_clients.stts <> 0 then next.
     5651             if verify-send-check and buf_clients.db-num <> v-cntxt-db-num  and v-all-object = false  then do:
     5652                find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
     5653                if buf_db.send-check = false then do:
     5654                 str-obj2# = str-obj2#  + " " + buf_clients.obj-name + ",".
     5655                 next.
     5656               end.
     5657             end.
     5658             if temp-param-obj-type = 'shop':U and v-all-object = false  then do:
     5659                 if buf_user-obj.obj-type = 'скл':U then DO:
     5660                   str-obj# = str-obj#  +  " " + buf_clients.obj-name + ",".
     5661                   NEXT.
     5662                 End.
     5663             End.
     5664             if temp-param-obj-type = 'stock':U and v-all-object = false then do:
     5665                 if buf_user-obj.obj-type = 'маг':U then DO:
     5666                   str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     5667                   next.
     5668                 end.
     5669             end.
     5670           CASE buf_user-obj.obj-type:
     5671               when 'скл':U then do:
     5672                       find first buf_store WHERE buf_store.obj-code = buf_user-obj.obj-code NO-LOCK.
     5673                       if SelectObject = "firm":U and v-all-object = false then do:
     5674                         if buf_store.host-code <> v-cntxt-host-code-obj then do:
     5675                             str-obj3# = str-obj3#  + " " + buf_clients.obj-name + ",".
     5676                             next.
     5677                         end.
     5678                       end.
     5679                       FIND FIRST buf_sysconf No-LOCK where buf_sysconf.host-code = buf_store.host-code No-ERROR.
     5680                       Find first buf_clients no-lock where
     5681                                   buf_clients.obj-type = buf_user-obj.obj-type AND
     5682                                   buf_clients.obj-code = buf_user-obj.obj-code No-ERROR.
     5683                       if buf_sysconf.base-code = base-code then
     5684                           do:
     5685   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5686   run create_obj-list in this-procedure
     5687    ( input buf_user-obj.obj-type ,
     5688      input buf_user-obj.obj-code )
     5689      .
     5690                           end.
     5691                           else do :
     5692                           if v-all-object = false then  str-obj# = str-obj#  +  " "  +  buf_clients.obj-name +  "," .
     5693                               else do:
     5694   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5695   run create_obj-list in this-procedure
     5696    ( input buf_user-obj.obj-type ,
     5697      input buf_user-obj.obj-code )
     5698      .
     5699                               end.
     5700                           end.
     5701               end.
     5702               when 'маг':U then  do:
     5703                       find first buf_shop where buf_shop.obj-code = buf_user-obj.obj-code no-lock.
     5704                       if selectobject = "firm":U and v-all-object = false then do:
     5705                         if buf_shop.host-code <> v-cntxt-host-code-obj then do:
     5706                             str-obj3# = str-obj3#  + " " + buf_clients.obj-name + "," .
     5707                             next.
     5708                         end.
     5709                       end.
     5710                       find first buf_sysconf no-lock where buf_sysconf.host-code = buf_shop.host-code no-error.
     5711                       find first buf_clients no-lock where
     5712                                   buf_clients.obj-type = buf_user-obj.obj-type and
     5713                                   buf_clients.obj-code = buf_user-obj.obj-code no-error.
     5714                       if buf_sysconf.base-code = base-code then
     5715                           do:
     5716   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5717   run create_obj-list in this-procedure
     5718    ( input buf_user-obj.obj-type ,
     5719      input buf_user-obj.obj-code )
     5720      .
     5721                           end.
     5722                           else do:
     5723                               if v-all-object = false then   str-obj# = str-obj#  +  " " +  buf_clients.obj-name +  "," .
     5724                                   else do:
     5725   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5726   run create_obj-list in this-procedure
     5727    ( input buf_user-obj.obj-type ,
     5728      input buf_user-obj.obj-code )
     5729      .
     5730                                   end.
     5731                           end.
     5732                   end.
     5733           END CASE.
     5734    END.
     5735    END PROCEDURE.
     5736   PROCEDURE state-changed :
     5737     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     5738     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     5739     define variable fl as integer   no-undo .
     5740     assign
     5741       fl = 0
     5742     .
     5743     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     5744     IF RETURN-VALUE NE "DESIGN" THEN DO:
     5745       DEFINE VARIABLE source-str AS CHARACTER.
     5746       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'Record':U , OUTPUT source-str ) no-error.
     5747       assign
     5748         State-source = WIDGET-HANDLE ( source-str )
     5749       .
     5750       if valid-handle ( state-source ) then do:
     5751         run return-var in state-source no-error.
     5752       end.
     5753       if date-start <> x-date-start
     5754       or date-end <> x-date-end
     5755       then do:
     5756         assign
     5757           FL = 1
     5758         .
     5759       end.
     5760     END.
     5761     CASE p-state:
     5762       when "link-changed":U then  DO:
     5763           IF FL = 0 Then DO:
     5764               run assign-frame in this-procedure  .
     5765               run local-apply-layout in this-procedure .
     5766               end.
     5767            else do:
     5768               run local-apply-layout in this-procedure .
     5769               run assign-frame in this-procedure  .
     5770               end.
     5771            run take-var in this-procedure .
     5772       end.
     5773     END CASE.
     5774   END PROCEDURE.
     5775   PROCEDURE take-var :
     5776     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     5777     IF RETURN-VALUE NE "DESIGN" THEN DO:
     5778       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'Record':U , OUTPUT source-str ).
     5779       State-source = WIDGET-HANDLE ( source-str ).
     5780       IF not VALID-HANDLE ( State-source ) THEN
     5781         Message "Не определен линк " 'Record':U view-as alert-box error.
     5782     END.
     5783      Run get-var in State-source (OUTPUT temp-str,
     5784       OUTPUT temp-param-date,
     5785       OUTPUT temp-param-date-type-period,
     5786       OUTPUT temp-param-goods,
     5787       OUTPUT temp-param-obj,
     5788       OUTPUT temp-param-pay,
     5789       OUTPUT temp-param-pay-hide,
     5790       OUTPUT temp-param-obj-type,
     5791       OUTPUT temp-param-Alon  ,
     5792       OUTPUT temp-param-customer,
     5793       OUTPUT temp-param-customer-type,
     5794       OUTPUT temp-param-schet        ,
     5795       OUTPUT temp-param-schet-hide   ,
     5796       OUTPUT temp-param-schet-init   ,
     5797       OUTPUT temp-param-schet-mode ,
     5798       output v-all-object
     5799       ).
     5800     define variable temp-param-time   as character no-undo .
     5801     define variable temp-param-goods1 as character no-undo .
     5802     define variable ii                as integer   no-undo .
     5803     temp-param-goods-choose = "" .
     5804     if temp-param-goods <> "" then
     5805     do:
     5806       if num-entries(temp-param-goods,":") > 1 then
     5807       do:
     5808         do ii = 1 to num-entries (temp-param-goods,","):
     5809           temp-param-time = entry (ii,temp-param-goods,",") .
     5810           if num-entries(temp-param-time,":") > 1 then
     5811           do:
     5812             temp-param-goods1 = temp-param-goods1 + "," + entry(1,temp-param-time,":") .
     5813             temp-param-goods-choose = temp-param-goods-choose + "," + entry(2,temp-param-time,":") .
     5814           end.
     5815           else
     5816           do:
     5817             temp-param-goods1 = temp-param-goods1 + "," + temp-param-time .
     5818           end.
     5819         end.
     5820       end.
     5821     end.
     5822     if temp-param-goods1 <> "" then temp-param-goods = trim(temp-param-goods1,",") .
     5823     temp-param-goods-choose = trim(temp-param-goods-choose,",") .
     5824   END PROCEDURE.
     5825   PROCEDURE val-goods :
     5826   If temp-param-goods <> "" THEN DO:
     5827    assign
     5828     goods-count  = ''
     5829     Goods-Editor = ''
     5830     .
     5831   Case Integer(SelectGood:screen-value IN frame F-Main):
     5832       When 1 then DO:
     5833          Disable RECT-node RECT-node-2 BUTTON-gds button-keep-spis BUTTON-node BUTTON-prod BUTTON-one BUTTON-prod-2 BUTTON-node-2 with frame F-Main .
     5834          Goods-Editor = " По всем товарам ".
     5835          RECT-node:bgcolor = 8.
     5836          RECT-node-2:bgcolor = 8.
     5837          End.
     5838       When 2 then DO:
     5839          Disable RECT-node RECT-node-2 BUTTON-gds button-keep-spis BUTTON-prod  BUTTON-one BUTTON-prod-2 BUTTON-node-2  with frame F-Main .
     5840          enable BUTTON-node  with frame F-Main .
     5841          RECT-node:bgcolor = 8.
     5842          RECT-node-2:bgcolor = 8.
     5843          End.
     5844       When 3 then DO:
     5845          Disable RECT-node RECT-node-2 BUTTON-gds button-keep-spis BUTTON-node   BUTTON-one BUTTON-prod-2 BUTTON-node-2  with frame F-Main .
     5846          enable BUTTON-prod  with frame F-Main .
     5847          RECT-node:bgcolor = 8.
     5848          RECT-node-2:bgcolor = 8.
     5849          End.
     5850       When 4 then DO:
     5851          Disable RECT-node RECT-node-2 BUTTON-node BUTTON-prod button-keep-spis BUTTON-one BUTTON-prod-2 BUTTON-node-2  with frame F-Main .
     5852          enable BUTTON-gds with frame F-Main .
     5853          RECT-node:bgcolor = 8.
     5854          RECT-node-2:bgcolor = 8.
     5855           END.
     5856       When 6 then DO:
     5857          Disable RECT-node RECT-node-2 BUTTON-node button-gds BUTTON-prod BUTTON-one BUTTON-prod-2 BUTTON-node-2  with frame F-Main .
     5858          enable button-keep-spis with frame F-Main .
     5859          RECT-node:bgcolor = 8.
     5860          RECT-node-2:bgcolor = 8.
     5861          END.
     5862       When 5 then DO:
     5863          Disable RECT-node RECT-node-2  BUTTON-node BUTTON-prod  BUTTON-gds button-keep-spis BUTTON-prod-2 BUTTON-node-2 with frame F-Main .
     5864          enable BUTTON-one with frame F-Main .
     5865          RECT-node:bgcolor = 8.
     5866          RECT-node-2:bgcolor = 8.
     5867          End.
     5868       When 7 then DO:
     5869          Disable RECT-node RECT-node-2 BUTTON-one BUTTON-node BUTTON-prod  BUTTON-gds button-keep-spis with frame F-Main .
     5870          enable BUTTON-prod-2 BUTTON-node-2  with frame F-Main .
     5871          End.
     5872     End case.
     5873     enable goods-count   Goods-Editor  with frame F-Main.
     5874     display goods-count   Goods-Editor with frame F-Main.
     5875   End.
     5876     Else  hide goods-count Goods-Editor in frame F-Main.
     5877   END PROCEDURE.
     5878   PROCEDURE val-obj :
     5879   If SelectObject:screen-value IN FRAME F-Main = "choice":U
     5880       then  enable BUTTON-obj with frame F-Main .
     5881       Else Disable BUTTON-obj with frame F-Main .
     5882   END PROCEDURE.
     5883   PROCEDURE val-shift :
     5884   define buffer buf_shift-obj for ub.shift-obj .
     5885   if TOG-Shift:screen-value IN frame F-Main = string(true)  Then DO:
     5886       TOG-Shift = true .
     5887       if tog-shift-2 then do:
     5888         enable  shift-start tog-shift-2 with frame F-Main .
     5889         display shift-start tog-shift-2 with frame F-Main .
     5890         disable button-shift-end with frame F-Main .
     5891       end.
     5892       else do:
     5893         enable shift-end shift-start tog-shift-2 with frame F-Main .
     5894         display shift-end shift-start tog-shift-2 with frame F-Main .
     5895       end.
     5896       if  can-find(first buf_shift-obj where
     5897                          buf_shift-obj.obj-code = v-cntxt-obj-code and
     5898                          buf_shift-obj.obj-type = v-cntxt-obj-type no-lock )
     5899           then do:
     5900             enable  button-shift-start button-shift-end  with frame F-Main .
     5901             display button-shift-start button-shift-end  with frame F-Main .
     5902              if tog-shift-2 then do:
     5903                 disable  button-shift-end with frame F-Main .
     5904              end.
     5905              else do:
     5906                 enable  button-shift-end with frame F-Main .
     5907              end.
     5908                 display button-shift-end with frame F-Main .
     5909           end.
     5910    End.
     5911    Else DO:
     5912     Tog-Shift-2 = False.
     5913     Tog-Shift   = False.
     5914     enable date-end with frame F-Main .
     5915     disable Shift-End Shift-Start Tog-Shift-2 button-shift-end button-shift-start with frame F-Main .
     5916     display Shift-End Shift-Start Tog-Shift-2 date-end with frame F-Main .
     5917     hide Shift-End Shift-Start Tog-Shift-2 button-shift-start button-shift-end in frame F-Main .
     5918    End.
     5919   END PROCEDURE.
     5920   PROCEDURE verify-check :
     5921   define buffer buf_clients for ub.clients .
     5922   define buffer buf_db for ub.db .
     5923       Find first buf_clients no-lock where
     5924                                                   buf_clients.obj-type = v-cntxt-obj-TYPE AND
     5925                                                   buf_clients.obj-code = v-cntxt-obj-CODE No-ERROR.
     5926                If Verify-send-check and buf_Clients.db-num <> v-cntxt-db-num  THEN DO:
     5927                   Find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
     5928                       if buf_db.send-check = false then DO:
     5929                                                   MESSAGE 'Нельзя выбрать текущий объект !' view-as alert-box error.
     5930                                                   run verify-check-currency in this-procedure .
     5931                                                   End.
     5932                       else do:
     5933   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5934   run create_obj-list in this-procedure
     5935    ( input buf_clients.obj-type ,
     5936      input buf_clients.obj-code )
     5937      .
     5938                       end.
     5939                   END.
     5940                   else do:
     5941   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5942   run create_obj-list in this-procedure
     5943    ( input buf_clients.obj-type ,
     5944      input buf_clients.obj-code )
     5945      .
     5946                   end.
     5947   END PROCEDURE.
     5948   PROCEDURE verify-check-currency :
     5949   define buffer buf_clients for ub.clients .
     5950   define buffer buf_db for ub.db .
     5951   if selectobject = "currency":U then do:
     5952       find first buf_clients no-lock where  buf_clients.obj-type = v-cntxt-obj-type and
     5953                                         buf_clients.obj-code = v-cntxt-obj-code no-error.
     5954                if verify-send-check and buf_clients.db-num <> v-cntxt-db-num  then do:
     5955                   find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
     5956                       if buf_db.send-check = false then do:
     5957                         str-obj2# = str-obj2#  + " " + buf_clients.obj-name + ",".
     5958                         assign selectobject = 'все':U .
     5959                         display selectobject with frame F-Main .
     5960                         disable button-obj   with frame F-Main .
     5961                         run sss in this-procedure .
     5962                         return error.
     5963                         end.
     5964                end.
     5965   end.
     5966   END PROCEDURE.
     5967   PROCEDURE verify-date :
     5968   if Date(Date-End:screen-value In frame F-Main) < DATE(Date-Start:screen-value In frame F-Main) then DO:
     5969      message "Интервал дат введен неверно !" view-as alert-box error TITLE "О Ш И Б К А !!!".
     5970      Return error.
     5971   End.
     5972   END PROCEDURE.
     5973   PROCEDURE verify-obj :
     5974   if temp-param-obj <> "" Then DO:
     5975      if selectobject = "choice":U then do:
     5976         my-request = true .
     5977         run select-objects-proc.
     5978      end.
     5979     if not can-find (first obj-list no-lock) then do:
     5980         message "Не выбран объект !" skip
     5981                 "Объекты не включенные в список" str-obj#    skip
     5982                 str-obj2#   skip
     5983                 str-obj3#   skip
     5984                 view-as alert-box error.
     5985     return error.
     5986     end.
     5987   end.
     5988   END PROCEDURE.
     5989   PROCEDURE verify-shift :
     5990   def input parameter date1 as date no-undo.
     5991   def input parameter Shift1 as int no-undo.
     5992   define buffer buf_shift-obj for ub.shift-obj .
     5993   if NOT can-find
     5994   (first buf_Shift-obj where  buf_Shift-obj.shift-num = Shift1
     5995                       AND buf_Shift-obj.shift-date = date1
     5996                       AND can-find (first obj-list where obj-list.obj-code = buf_shift-obj.obj-code
     5997                                                      AND obj-list.obj-type = buf_shift-obj.obj-type)=true)
     5998     THEN DO:
     5999      Bell.
     6000      message "Нет смены " shift1 date1 " !" view-as alert-box error TITLE "О Ш И Б К А !!!".
     6001      Return error.
     6002      End.
     6003      else do:
     6004        x-tog-shift = true .
     6005      end.
     6006   END PROCEDURE.
     6007   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     6008   DEFINE VARIABLE var-stat-line as character no-undo .
     6009   CASE p-status-chr:
     6010     when 'все':U then do:
     6011       assign
     6012       var-stat-line = "(текущие и неактивные товары)"
     6013       .
     6014     end.
     6015     when 'текущие':U then do:
     6016       assign
     6017       var-stat-line = "(текущие товары)"
     6018       .
     6019     end.
     6020     when 'удаленные':U then do:
     6021       assign
     6022       var-stat-line = "(неактивные товары)"
     6023       .
     6024     end.
     6025   END CASE.
     6026   return var-stat-line .
     6027   END.
