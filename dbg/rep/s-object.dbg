     4073       define variable v-ok            as logical   no-undo .
     4074       define variable v-curr-sv-date  as date      no-undo .
     4075       define variable v-description   as character no-undo .
     4076       assign
     4077         v-curr-sv-date = date(self :screen-value) no-error
     4078       .
     4079       if v-curr-sv-date = ?
     4080       then do:
     4081         run gbl/getcurdt.p
     4082           (output v-curr-sv-date
     4083           ) .
     4084       end.
     4085       if v-curr-sv-date <> ?
     4086       then do:
     4087         run gbl/d-inpday.w
     4088           (input ?
     4089           ,input "Выбор даты"
     4090           ,input v-description
     4091           ,input ""
     4092           ,input-output v-curr-sv-date
     4093           ,output v-ok
     4094           ).
     4095         if v-ok = true
     4096         then do:
     4097           assign
     4098             self :screen-value = string(v-curr-sv-date) .
     4099           .
     4100         end.
     4101       end.
     4102     end.
     4103     return no-apply .
     4104   end.
     4105     define MENU m-ed-date25
     4106       MENU-ITEM m-ed-date25-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     4107       MENU-ITEM m-ed-date25-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
