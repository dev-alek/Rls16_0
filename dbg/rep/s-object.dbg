     3180   ON CHOOSE OF BUTTON-Shift-Start IN FRAME F-Main
     3181   DO:
     3182     define variable v-doc-rec as recid no-undo .
     3183     define variable rec-list-2      as char no-undo.
     3184     define buffer buf_shift-obj for ub.shift-obj .
     3185     IF  SelectObject:screen-value = "currency":U then do:
     3186       find first buf_shift-obj No-LOCK WHERE
     3187                 buf_shift-obj.shift-date = date-start AND
     3188                 buf_shift-obj.shift-num = shift-start AND
     3189                 buf_shift-obj.obj-type = v-cntxt-obj-type AND
     3190                 buf_shift-obj.obj-code = v-cntxt-obj-code No-ERROR.
     3191       if available buf_shift-obj then
     3192       rec-list-2 = string(recid(buf_shift-obj)).
     3193     end.
     3194     IF  SelectObject:screen-value = "currency":U
     3195     then do:
     3196         run str/sht-all.w
     3197         (             input my-handle
     3198                      ,input v-cntxt-obj-type
     3199                      ,input v-cntxt-obj-code
     3200                      ,input  "b-sel"
     3201                      ,input "obj":U
     3202                      ,input v-cntxt-obj-type
     3203                      ,input v-cntxt-obj-code
     3204                      ,input ReportProc
     3205                      ,input-output rec-list-2 ).
     3206     end.
     3207     Else do:
     3208         run str/sht-all.w
     3209           (             input my-handle
     3210           ,input v-cntxt-obj-type
     3211           ,input v-cntxt-obj-code
     3212           ,input  "b-sel"
     3213           ,input "all":U
     3214           ,input '':U
     3215           ,input 0
     3216           ,input ReportProc
     3217           ,input-output rec-list-2 ).
     3218       end.
     3219       find shift-obj where recid (shift-obj) = integer (entry(1,rec-list-2))  no-lock no-error.
     3220       if AVAILABLE  shift-obj then
     3221       DO:
     3222         Assign
     3223           date-start  = shift-obj.shift-date
     3224           shift-start = shift-obj.shift-num.
     3225         enable date-start  shift-start with frame F-Main.
     3226         Display date-start  shift-start with frame F-Main.
     3227           if TOG-Shift-2 then do:
     3228               assign
     3229                Date-End = Date-Start
     3230                Shift-End = Shift-Start
     3231                Date-End:SCREEN-VALUE = string(Date-Start)
     3232                Shift-End:SCREEN-VALUE = string(Shift-Start)
     3233                x-Date-End  = Date-End
     3234                x-Shift-End = Shift-End
     3235               .
     3236       Display date-end  shift-end with frame F-Main.
     3237           end.
     3238         apply "leave" to shift-start .
     3239         apply "leave" to date-start .
     3240       End.
     3241    END.
     3242   ON LEAVE OF Date-Alone IN FRAME F-Main
     3243   DO:
     3244     Assign Date-Alone no-error.
     3245     x-date-start = Date-Alone.
     3246     x-date-end = Date-Alone.
     3247     x-date-alone = Date-Alone.
     3248     run new-state ("DATE-ALONE="  + String(DATE-ALONE:screen-value)).
     3249   END.
     3250   ON LEAVE OF Date-End IN FRAME F-Main
     3251   DO:
     3252       Assign  Date-End no-error.
     3253       X-Date-End       = Date-End.
     3254       run verify-date in this-procedure .
     3255       run new-state ("DATE-END="  + String(DATE-END:screen-value)).
     3256   END.
     3257   ON LEAVE OF Date-Start IN FRAME F-Main
     3258   DO:
     3259       Assign  Date-Start no-error.
     3260       X-Date-Start     = Date-Start.
     3261       run new-state ("DATE-START="  + String(DATE-START:screen-value)).
     3262   END.
     3263   ON VALUE-CHANGED OF Radio-customer IN FRAME F-Main
     3264   DO:
     3265       Assign
     3266         Radio-customer
     3267       .
     3268   DEFINE VARIABLE customer-recids AS CHARACTER NO-UNDO.
     3269   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     3270   define buffer buf_clients for ub.clients.
     3271   for each g#customer : delete g#customer. end.
     3272     Case Radio-customer :
     3273     when 1 then DO:
     3274             Assign  customer-name = 'все':U.
     3275             Display customer-name with frame F-Main .
     3276          END.
     3277     when 2 then
     3278           do:
     3279               if temp-param-customer-type  = "" then temp-param-customer-type = 'все':U.
     3280               run str/cli-list.w
     3281                            ( my-handle
     3282                            , v-cntxt-host-code-obj
     3283                            , v-cntxt-obj-type
     3284                            , v-cntxt-obj-code
     3285                               ) .
     3286               if not can-find (first cli-list no-lock ) then do:
     3287                    Assign  customer-name = 'все':U Radio-customer = 1.
     3288                    Display customer-name Radio-customer with frame F-Main .
     3289               end.
     3290               else do:
     3291                   Assign  customer-name = ''.
     3292                   for each cli-list  :
     3293                       create g#customer.
     3294                       assign
     3295                       g#customer.obj-type = cli-list.obj-type
     3296                       g#customer.obj-code = cli-list.obj-code
     3297                       g#customer.obj-name = cli-list.obj-name.
     3298                       if LENGTH (customer-name) >= 10000 then do:
     3299                          customer-name = trim(customer-name , '...') .
     3300                          customer-name = customer-name + '...' .
     3301                       end.
     3302                       else customer-name = customer-name + cli-list.obj-name + chr(10).
     3303                   END.
     3304                    Display customer-name with frame F-Main .
     3305               end.
     3306           end.
     3307     End case.
     3308     run new-state ("RADIO-CUSTOMER="  + string(Radio-customer)).
     3309     END.
     3310   ON VALUE-CHANGED OF Radio-Period IN FRAME F-Main
     3311   DO:
     3312     assign radio-period.
     3313   END.
     3314   ON VALUE-CHANGED OF Radio-schet IN FRAME F-Main
     3315   DO:
     3316    Assign Radio-schet.
     3317    display Radio-schet with frame F-Main .
     3318    run select-radio-schet in this-procedure .
     3319   END.
     3320   ON VALUE-CHANGED OF RADIO-task IN FRAME F-Main
     3321   DO:
     3322   Assign RADIO-task Date-End Date-Start shift-end shift-start.
     3323   x-RADIO-task  = RADIO-task.
     3324   x-Date-End    = Date-End .
     3325   x-Date-Start  = Date-Start.
     3326   x-shift-End   = shift-End .
     3327   x-shift-Start = shift-Start.
     3328   x-shift-alone = shift-alone.
     3329   run display-radio-task in this-procedure .
     3330   run new-state ( "RADIO-TASK="  + String(RADIO-TASK:screen-value)).
     3331   END.
     3332   ON VALUE-CHANGED OF SelectGood IN FRAME F-Main
     3333   DO:
     3334     run val-goods in this-procedure .
     3335     RUN new-state ("SELECTGOOD="  + String(SelectGood:screen-value)).
     3336   END.
     3337   ON VALUE-CHANGED OF SelectObject IN FRAME F-Main
     3338   DO:
     3339   Assign SelectObject.
     3340   run select-objects-proc in this-procedure .
     3341   run val-obj in this-procedure .
     3342   run new-state ("SELECTOBJECT="  + SelectObject).
     3343   END.
     3344   ON VALUE-CHANGED OF SET_PAY_TYPE IN FRAME F-Main
     3345   DO:
     3346       Assign SET_PAY_TYPE.
     3347               X-SET_PAY_TYPE   = SET_PAY_TYPE.
     3348      run set_val in this-procedure .
     3349      run new-state ( "SET_PAY_TYPE ="  + String(SET_PAY_TYPE:screen-value)).
     3350   END.
     3351   ON VALUE-CHANGED OF SET_val_TYPE IN FRAME F-Main
     3352   DO:
     3353     assign
     3354       SET_val_TYPE
     3355     .
     3356     x-SET_val_TYPE = SET_val_TYPE.
     3357       if Verify-Arc-stk then do:
     3358         If var-report-r-b = "base" then do:
     3359           if X-SET_val_TYPE = 1 and base-code <> 0
     3360           then message
     3361               "В валютной версии программы при базовой валюте, не равной рубл. - " skip
     3362               "в колонках остатки по товару и автоматическая переоценка не будет учтена курсовая" skip
     3363               "разница при печати отчета в продажных ценах и рублях. "
     3364               view-as alert-box information Title "В н и м а н и е".
     3365         end.
     3366         else do:
     3367         end.
     3368       end.
     3369     run new-state ("SET_VAL_TYPE="  + String(SET_VAL_TYPE:screen-value)).
     3370   END.
     3371   ON LEAVE OF Shift-Alone IN FRAME F-Main
     3372     DO:
     3373       Assign Shift-Alone Shift-End Shift-start.
     3374       X-Shift-Alone   = Shift-Alone.
     3375       X-Shift-End     = Shift-Alone.
     3376       X-Shift-start   = Shift-alone.
     3377       Shift-End       = Shift-Alone.
     3378       Shift-start     = Shift-alone.
     3379       if Shift-End:visible in frame F-Main    then   display Shift-end with frame F-Main .
     3380       if Shift-start:visible in frame F-Main  then   display Shift-start with frame F-Main .
     3381       display Shift-Alone with frame F-Main .
     3382       run new-state ("SHIFT-ALONE="  + String(SHIFT-Alone:screen-value)).
     3383     END.
     3384   ON LEAVE OF Shift-End IN FRAME F-Main
     3385     DO:
     3386       Assign Shift-End.
     3387       X-Shift-End  = Shift-End.
     3388       run new-state ( "SHIFT-END="  + String(SHIFT-END:screen-value)).
     3389     END.
     3390   ON LEAVE OF Shift-Start IN FRAME F-Main
     3391     DO:
     3392       Assign Shift-Start.
     3393       X-Shift-Start = Shift-Start.
     3394       run new-state ( "SHIFT-START="  + String(SHIFT-START:screen-value)).
     3395     END.
     3396   ON VALUE-CHANGED OF TOG-Excel IN FRAME F-Main
     3397     DO:
     3398       Assign Tog-Excel.
     3399       If Tog-Excel Then Make-Excel = True.
     3400       Else Make-Excel = False.
     3401       run new-state ( "TOG-EXCEL ="  + String(Tog-Excel)).
     3402     END.
     3403   ON VALUE-CHANGED OF TOG-list-hist IN FRAME F-Main
     3404     DO:
     3405       Assign Tog-list-hist.
     3406       If Tog-list-hist Then print-list-hist = True.
     3407       Else print-list-hist = False.
     3408       run new-state ("TOG-list-hist ="  + String(Tog-list-hist)).
     3409     END.
     3410   ON VALUE-CHANGED OF TOG-Shift IN FRAME F-Main
     3411     DO:
     3412       assign TOG-Shift .
     3413       run val-shift  in this-procedure .
     3414       if tog-shift:screen-value = string(true) then tog-shift = true .
     3415       else tog-shift = false .
     3416       if tog-shift = false  then x-tog-shift   = false .
     3417       else x-tog-shift   = true .
     3418       RUN new-state ("TOG-SHIFT ="  + String(Tog-SHIFT:screen-value)).
     3419     END.
     3420   ON VALUE-CHANGED OF TOG-Shift-2 IN FRAME F-Main
     3421   DO:
     3422     define buffer buf_shift-obj for ub.shift-obj .
     3423   Assign TOG-Shift-2.
     3424   Date-End:screen-value IN frame F-Main  = Date-Start:screen-value IN frame F-Main.
     3425   Shift-End:screen-value IN frame F-Main = Shift-Start:screen-value IN frame F-Main.
     3426   Date-End  = date (Date-Start:screen-value IN frame F-Main).
     3427   Shift-End = integer(Shift-Start:screen-value IN frame F-Main).
     3428   x-Date-End  = DAte(Date-Start:screen-value IN frame F-Main).
     3429   x-Shift-End = integer(Shift-Start:screen-value IN frame F-Main).
     3430   if TOG-Shift-2 then
     3431       do:
     3432           disable
     3433               Date-End
     3434               shift-end
     3435           with frame F-Main.
     3436       end.
     3437   else
     3438       do:
     3439           enable
     3440               Date-End
     3441               shift-end
     3442           with frame F-Main.
     3443       end.
     3444   Display Date-End shift-end with frame F-Main.
     3445   if can-find(first buf_shift-obj where buf_shift-obj.obj-code = v-cntxt-obj-code and
     3446       buf_shift-obj.obj-type = v-cntxt-obj-type no-lock) then
     3447           do:
     3448               if tog-shift-2 then
     3449                   do:
     3450                       disable button-shift-end with frame F-Main .
     3451                   end.
     3452               else
     3453                   do:
     3454                       enable button-shift-end with frame F-Main .
     3455                   end.
     3456               display button-shift-end with frame F-Main .
     3457           end.
     3458   END.
     3459   if not this-procedure :persistent
     3460   then do:
     3461     message
     3462       vss-workfile vss-revision vss-description skip
     3463       "Ошибка при запуске процедуры" skip
     3464       "Данную процедуру следует запускать только с параметром persistent" skip
     3465       view-as alert-box error .
     3466     undo, return error .
     3467   end.
