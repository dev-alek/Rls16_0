     3148                      ,input v-cntxt-obj-type
     3149                      ,input v-cntxt-obj-code
     3150                      ,input  "b-sel"
     3151                      ,input "obj":U
     3152                      ,input v-cntxt-obj-type
     3153                      ,input v-cntxt-obj-code
     3154                      ,input ReportProc
     3155                      ,input-output rec-list-2 ).
