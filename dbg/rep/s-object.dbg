     3160                      ,input v-cntxt-obj-type
     3161                      ,input v-cntxt-obj-code
     3162                      ,input  "b-sel"
     3163                      ,input "all":U
     3164                      ,input '':U
     3165                      ,input 0
     3166                      ,input ReportProc
     3167                      ,input-output rec-list-2 ).
     3168       end.
     3169       find first buf_shift-obj where recid (buf_shift-obj) = integer (entry(1,rec-list-2))  no-lock no-error.
     3170       if available buf_shift-obj then DO:
     3171          Assign
     3172           date-end  = buf_shift-obj.shift-date
     3173           shift-end = buf_shift-obj.shift-num.
