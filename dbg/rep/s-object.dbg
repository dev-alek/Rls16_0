     3559       if v-curr-sv-date <> ?
     3560       then do:
     3561         assign
     3562           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3563         .
     3564         assign
     3565           self :screen-value = string(v-new-sv-date) .
     3566         .
     3567       end.
     3568     end.
     3569     return no-apply .
