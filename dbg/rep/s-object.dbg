      993   procedure userobjs_object-count :
      994     define output parameter p-total-count as integer   no-undo .
      995     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      996     do
      997     on error undo, return error return-value
      998     :
      999       assign
     1000         p-total-count = 0
     1001       .
     1002       for each buf_userobjs_temp-user-obj
     1003       on error undo, return error return-value
     1004       :
     1005         assign
     1006           p-total-count = p-total-count + 1
     1007         .
     1008       end.
     1009     end.
     1010   end.
     1011   procedure userobjs_append :
     1012      define input  parameter p-obj-type as character no-undo .
     1013      define input  parameter p-obj-code as integer   no-undo .
     1014     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1015     do
     1016     on error undo, return error return-value
     1017     :
     1018       find first buf_userobjs_temp-user-obj
     1019         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1020           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1021         no-error .
     1022       if not available buf_userobjs_temp-user-obj
     1023       then do:
     1024         create buf_userobjs_temp-user-obj .
     1025         assign
     1026           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1027           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1028         .
     1029       end.
     1030     end.
     1031   end.
     1032   procedure userobjs_object-exist :
     1033     define output parameter p-object-exist as logical   no-undo .
     1034     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1035     do
     1036     on error undo, return error return-value
     1037     :
     1038       find first buf_userobjs_temp-user-obj
     1039         no-error .
     1040       if not available buf_userobjs_temp-user-obj
     1041       then do:
     1042         assign
     1043           p-object-exist = false
     1044         .
     1045       end.
     1046       else do:
     1047         assign
     1048           p-object-exist = true
     1049         .
     1050       end.
     1051     end.
     1052   end.
     1053   procedure userobjs_transfer :
     1054     define input  parameter p-callback-handle as handle no-undo .
     1055     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1056     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1057     do
     1058     on error undo, return error return-value
     1059     :
     1060       if valid-handle(p-callback-handle) <> true
     1061       then do:
     1062         message
     1063           vss-workfile vss-revision vss-description skip
     1064           "Ошибка задания входных параметров" skip
     1065           "Неизвестный указатель на процедуру" skip
     1066           view-as alert-box error .
     1067         undo, return error return-value .
     1068       end.
     1069       if p-callback-handle :get-signature("userobjs_append") = ""
     1070       then do:
     1071         message
     1072           vss-workfile vss-revision vss-description skip
     1073           "Ошибка задания входных параметров" skip
     1074           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1075                     ,p-callback-handle :file-name
     1076                     ) skip
     1077           view-as alert-box error .
     1078         undo, return error return-value .
     1079       end.
     1080       for each buf_userobjs_temp-user-obj
     1081       on error undo, return error return-value
     1082       :
     1083         run userobjs_append in p-callback-handle
     1084           (input  buf_userobjs_temp-user-obj.obj-type
     1085           ,input  buf_userobjs_temp-user-obj.obj-code
     1086           ) .
     1087       end.
     1088     end.
     1089   end procedure.
     1090   procedure userobjs_select-one :
     1091      define input  parameter parparentproc     as widget-handle no-undo .
     1092      define input  parameter p-db-num          as integer   no-undo .
     1093      define input  parameter p-user-id         as character no-undo .
     1094      define input  parameter p-host-code-obj   as integer   no-undo .
     1095      define input  parameter p-obj-type        as character no-undo .
     1096      define input  parameter p-obj-code        as integer   no-undo .
     1097      define output parameter p-user-select     as logical   no-undo .
     1098      define output parameter p-select-obj-type as character no-undo .
     1099      define output parameter p-select-obj-code as character no-undo .
     1100     do
     1101     on error undo, return error return-value
     1102     :
     1103       run gbl/userobjs.w
     1104         (input  parparentproc
     1105         ,input  this-procedure :handle
     1106         ,input  p-db-num
     1107         ,input  p-user-id
     1108         ,input  p-host-code-obj
     1109         ,input  p-obj-type
     1110         ,input  p-obj-code
     1111         ,INPUT  "b-sel"
     1112         ,output p-user-select
     1113         ,output p-select-obj-type
     1114         ,output p-select-obj-code
     1115         ) .
     1116     end.
     1117   end.
     1118   procedure userobjs_select-many :
     1119     define input  parameter parparentproc   as widget-handle no-undo .
     1120     define input  parameter p-db-num        as integer   no-undo .
     1121     define input  parameter p-user-id       as character no-undo .
     1122     define input  parameter p-host-code-obj as integer   no-undo .
     1123     define input  parameter p-obj-type      as character no-undo .
     1124     define input  parameter p-obj-code      as integer   no-undo .
     1125     define output parameter p-user-select   as logical   no-undo .
     1126     define variable v-select-obj-type as character no-undo .
     1127     define variable v-select-obj-code as integer   no-undo .
     1128     do
     1129     on error undo, return error return-value
     1130     :
     1131       run gbl/userobjs.w
     1132         (input  parparentproc
     1133         ,input  this-procedure :handle
     1134         ,input  p-db-num
     1135         ,input  p-user-id
     1136         ,input  p-host-code-obj
     1137         ,input  p-obj-type
     1138         ,input  p-obj-code
     1139         ,INPUT  "b-sel,b-mark"
     1140         ,output p-user-select
     1141         ,output v-select-obj-type
     1142         ,output v-select-obj-code
     1143         ) .
     1144     end.
     1145   end.
     1146   procedure thobjs :
     1147      define input        parameter parparentproc     as widget-handle no-undo .
     1148      define input        parameter i-bttns           as character     no-undo .
     1149      define input        parameter i-list-mode       as character     no-undo.
     1150      define input        parameter i-obj-type        as character     no-undo.
     1151      define input        parameter i-db-num          as integer       no-undo.
     1152      define input        parameter i-host-code       as integer       no-undo.
     1153      define input-output parameter p-rid-list        as character     no-undo .
     1154   run ref/thobjs.p
     1155           ( input parparentproc
     1156            ,input  this-procedure :handle
     1157           , input i-bttns
     1158           , input i-list-mode
     1159           , input i-obj-type
     1160           , input i-db-num
     1161           , input i-host-code
     1162           , input-output p-rid-list ) no-error .
     1163   end.
     1164   define new global shared variable g#lib-trn  as handle no-undo .
     1165   define new global shared variable g#lib-trn2 as handle no-undo .
     1166   define new global shared variable g#lib-trn3 as handle no-undo .
     1167   define new global shared variable g#lib-trn4 as handle no-undo .
     1168   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1169   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1170   procedure gen-key-rec :
     1171     define input  parameter p-tbl-name    as character no-undo.
     1172     define input  parameter p-bh_tbl-name as handle    no-undo.
     1173     define output parameter p-key-rec     as character no-undo.
     1174     do
     1175     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1176     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1177     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1178     :
     1179       define variable fh               as handle    no-undo .
     1180       define variable v-ok             as logical   no-undo .
     1181       define variable v-inform         as character no-undo .
     1182       define variable v-ind            as integer   no-undo .
     1183       define variable v-idx-field-qnty as integer   no-undo .
     1184       if p-tbl-name = ?
     1185         or p-tbl-name = "":U
     1186       then do:
     1187         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info18 ).
     1188       end.
     1189       if not p-bh_tbl-name:available then do:
     1190         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info18, p-tbl-name ).
     1191       end.
     1192       assign
     1193         p-key-rec = p-tbl-name
     1194         v-inform  = p-bh_tbl-name:index-information(1)
     1195         v-ind     = 2
     1196       .
     1197       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1198       on error undo, return error
     1199       :
     1200         assign
     1201           v-inform = p-bh_tbl-name:index-information( v-ind )
     1202           v-ind    = v-ind + 1
     1203         .
     1204       end.
     1205       if v-inform = ?
     1206         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1207         or entry( 3, v-inform, ",":U ) <> "1":U
     1208       then do:
     1209         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, p-tbl-name ).
     1210       end.
     1211       else do:
     1212         assign
     1213           v-idx-field-qnty = num-entries( v-inform ) - 4
     1214         .
     1215         if v-idx-field-qnty < 2 then do:
     1216           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, p-tbl-name ).
     1217         end.
     1218         do v-ind = 1 to v-idx-field-qnty by 2
     1219         on error undo, return error
     1220         :
     1221           assign
     1222             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1223             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1224           .
     1225         end.
     1226       end.
     1227       if p-key-rec = ? then do:
     1228         assign
     1229           p-key-rec = "":U
     1230         .
     1231         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info18, p-tbl-name ).
     1232       end.
     1233     end.
     1234     return.
     1235   end procedure.
     1236   procedure gen-where-keyr-tab :
     1237     define input  parameter i-tableSerach as character no-undo.
     1238     define input  parameter i-tablekey   as character  no-undo.
     1239     define input  parameter p-key-rec    as character  no-undo.
     1240     define input  parameter p-key-handle as handle     no-undo .
     1241     define input  parameter p-db-name    as character  no-undo .
     1242     define input  parameter p-tt-handle  as handle     no-undo .
     1243     define output parameter o-Where      as character  no-undo.
     1244     do
     1245     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1246     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1247     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1248     :
     1249       define variable v-full-tbl-name  as character no-undo .
     1250       define variable bh_tbl-name      as handle    no-undo .
     1251       define variable fh_key           as handle    no-undo .
     1252       define variable fh_search        as handle    no-undo .
     1253       define variable v-field-num      as integer   no-undo .
     1254       define variable v-count-fld      as integer   no-undo .
     1255       define variable v-inform         as character no-undo .
     1256       define variable v-ind            as integer   no-undo .
     1257       define variable v-idx-field-qnty as integer   no-undo .
     1258       define variable v-field-name     as character no-undo .
     1259       define variable v-field-val      as character no-undo .
     1260       define variable v-word-link      as character no-undo .
     1261       define variable vTable           as character no-undo.
     1262       define variable bh_tbl-key       as handle    no-undo .
     1263       assign
     1264         p-key-rec = trim( p-key-rec )
     1265       .
     1266       if p-key-handle <> ? then do:
     1267         if not valid-handle(p-key-handle)
     1268            or p-key-handle:type <> "buffer"
     1269         then do:
     1270           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info18 ).
     1271         end.
     1272         if num-entries( p-key-rec, chr(3) ) > 1
     1273           or p-key-rec = ?
     1274           or p-key-rec = "":U
     1275         then do:
     1276           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info18, p-key-rec ).
     1277         end.
     1278       end.
     1279       else do:
     1280         if p-key-rec = ?
     1281           or p-key-rec = "":U
     1282         then do:
     1283           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info18 ).
     1284         end.
     1285       end.
     1286       assign
     1287         vTable = entry( 1 , p-key-rec, chr(3) )
     1288       .
     1289       if p-tt-handle <> ?
     1290         and ( not valid-handle(p-tt-handle)
     1291               or p-tt-handle:type <> "buffer"
     1292             )
     1293       then do:
     1294         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info18, vTable, chr(10) ).
     1295       end.
     1296       if p-tt-handle = ? then do:
     1297         assign
     1298           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1299         .
     1300         create buffer bh_tbl-name for table v-full-tbl-name .
     1301       end.
     1302       else do:
     1303         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1304       end.
     1305       assign
     1306         v-inform = bh_tbl-name:index-information(1)
     1307         v-ind    = 2
     1308       .
     1309       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1310       on error undo, return error
     1311       :
     1312         assign
     1313           v-inform = bh_tbl-name:index-information( v-ind )
     1314           v-ind    = v-ind + 1
     1315         .
     1316       end.
     1317       if v-inform = ?
     1318         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1319         or entry( 3, v-inform, ",":U ) <> "1":U
     1320       then do:
     1321         delete object bh_tbl-name no-error.
     1322         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info18, vTable ).
     1323       end.
     1324       assign
     1325         v-idx-field-qnty = num-entries( v-inform ) - 4
     1326       .
     1327       if v-idx-field-qnty < 2 then do:
     1328         delete object bh_tbl-name no-error.
     1329         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, vTable ).
     1330       end.
     1331       assign
     1332         o-where     = "where":U
     1333         v-word-link = "":U
     1334         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1335         v-count-fld = 0
     1336       .
     1337       if i-tablekey ne "" and i-tablekey ne ?
     1338       then do:
     1339         assign
     1340           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1341         .
     1342         create buffer bh_tbl-key for table v-full-tbl-name .
     1343       end.
     1344       if i-tableSerach ne "" and i-tableSerach ne ?
     1345       then do:
     1346         delete object bh_tbl-name no-error.
     1347         assign
     1348           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1349         .
     1350         create buffer bh_tbl-name for table v-full-tbl-name .
     1351       end.
     1352       block_where:
     1353       do v-ind = 1 to v-idx-field-qnty by 2
     1354       on error undo, return error
     1355       :
     1356         assign
     1357           v-count-fld = v-count-fld + 1
     1358         .
     1359         if p-key-handle = ?
     1360           and v-count-fld > v-field-num
     1361         then do:
     1362           leave block_where.
     1363         end.
     1364         define variable VfieldKeyTable as handle no-undo.
     1365         assign
     1366           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1367           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1368         .
     1369         if     bh_tbl-key ne ?
     1370         then do:
     1371            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1372            if VfieldKeyTable eq ?
     1373            then next block_where.
     1374         end.
     1375         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1376         then
     1377            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1378         else
     1379            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1380         if p-key-handle = ? then do:
     1381           assign
     1382             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1383           .
     1384         end.
     1385         else do:
     1386           assign
     1387             fh_key = p-key-handle:buffer-field( v-field-name )
     1388           .
     1389           if fh_key = ?
     1390             or not valid-handle( fh_key )
     1391           then do:
     1392             delete object bh_tbl-name.
     1393             if     bh_tbl-key ne ?
     1394             then
     1395                delete object bh_tbl-key.
     1396             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info18, p-key-handle:name, v-field-name ).
     1397           end.
     1398           assign
     1399             v-field-val = fh_key:buffer-value
     1400           .
     1401         end.
     1402         if fh_search:data-type ="character":U then do:
     1403           assign
     1404             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1405             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1406             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1407             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1408             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1409             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1410             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1411             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1412             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1413             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1414             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1415             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1416             v-field-val = substitute( '"&1"', v-field-val )
     1417           .
     1418         end.
     1419         assign
     1420           o-where = substitute( "&1 &2", o-where, v-field-val )
     1421         .
     1422         if v-word-link = "":U then do:
     1423           assign
     1424             v-word-link = "and":U
     1425           .
     1426         end.
     1427       end.
     1428       delete object bh_tbl-name.
     1429       if     bh_tbl-key ne ?
     1430       then
     1431          delete object bh_tbl-key.
     1432       if p-key-handle = ?
     1433         and v-count-fld <> v-field-num
     1434       then do:
     1435         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info18, vTable ).
     1436       end.
     1437     end.
     1438   end procedure.
     1439   procedure gen-hn-keyr-tab :
     1440     define input  parameter i-tableSerach as character no-undo.
     1441     define input  parameter i-tablekey   as character no-undo.
     1442     define input  parameter p-key-rec    as character no-undo.
     1443     define input  parameter p-key-handle as handle    no-undo .
     1444     define input  parameter p-db-name    as character no-undo .
     1445     define input  parameter p-tt-handle  as handle    no-undo .
     1446     define input  parameter p-stts-lock  as integer   no-undo .
     1447     define output parameter o-hn         as handle    no-undo.
     1448     define variable v-full-tbl-name as character no-undo.
     1449     define variable v-where         as character no-undo.
     1450     define variable bh_tbl-name     as handle    no-undo.
     1451     define variable vTable          as character no-undo.
     1452     do
     1453     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1454     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1455     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1456         run gen-where-keyr-tab(i-tableSerach,
     1457                                i-tablekey,
     1458                                p-key-rec,
     1459                                p-key-handle,
     1460                                p-db-name,
     1461                                p-tt-handle,
     1462                                output v-where).
     1463         if i-tableSerach ne "" and i-tableSerach ne ?
     1464         then do:
     1465            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1466            create buffer bh_tbl-name for table v-full-tbl-name .
     1467         end.
     1468         else do:
     1469            if p-tt-handle = ? then do:
     1470               assign
     1471                  vTable = entry( 1 , p-key-rec, chr(3) )
     1472               .
     1473               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1474               create buffer bh_tbl-name for table v-full-tbl-name .
     1475            end.
     1476            else do:
     1477               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1478            end.
     1479         end.
     1480         if p-tt-handle = ? then do:
     1481            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1482         end.
     1483         else do:
     1484            bh_tbl-name:find-first( v-where ) no-error .
     1485         end.
     1486         o-hn = bh_tbl-name.
     1487      end.
     1488   end procedure.
     1489   procedure gen-hn-keyr :
     1490     define input  parameter p-key-rec    as character no-undo.
     1491     define input  parameter p-key-handle as handle    no-undo .
     1492     define input  parameter p-db-name    as character no-undo .
     1493     define input  parameter p-tt-handle  as handle    no-undo .
     1494     define input  parameter p-stts-lock  as integer   no-undo .
     1495     define output parameter o-hn         as handle    no-undo.
     1496     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1497   end.
     1498   procedure gen-row-keyr :
     1499     define input  parameter p-key-rec    as character no-undo.
     1500     define input  parameter p-key-handle as handle    no-undo .
     1501     define input  parameter p-db-name    as character no-undo .
     1502     define input  parameter p-tt-handle  as handle    no-undo .
     1503     define input  parameter p-stts-lock  as integer   no-undo .
     1504     define output parameter p-tbl-row    as rowid     no-undo.
     1505     define output parameter p-tbl-name   as character no-undo.
     1506     define variable vHn as handle no-undo.
     1507       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1508       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1509       p-tbl-name =  vHn:table.
     1510       delete object vHn no-error.
     1511     if p-tbl-row = ? then do:
     1512       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info18, p-tbl-name, p-key-rec ).
     1513     end.
     1514     else do:
     1515       return.
     1516     end.
     1517   end procedure.
     1518   procedure gen-key-fv :
     1519     define input  parameter p-key-rec    as character no-undo .
     1520     define output parameter p-field-list as character no-undo .
     1521     define output parameter p-value-list as character no-undo.
     1522     do
     1523     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1524     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1525     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1526     :
     1527       define variable v-full-tbl-name  as character no-undo .
     1528       define variable bh_tbl-name      as handle    no-undo .
     1529       define variable v-tbl-name       as character no-undo .
     1530       define variable v-field-num      as integer   no-undo .
     1531       define variable v-count-fld      as integer   no-undo .
     1532       define variable v-inform         as character no-undo .
     1533       define variable v-ind            as integer   no-undo .
     1534       define variable v-idx-field-qnty as integer   no-undo .
     1535       define variable v-delim-key      as character no-undo .
     1536       if p-key-rec = ?
     1537         or p-key-rec = "":U
     1538       then do:
     1539         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info18 ).
     1540       end.
     1541       assign
     1542         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1543         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1544       .
     1545       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1546       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info18 ).
     1547       assign
     1548         v-inform = bh_tbl-name:index-information(1)
     1549         v-ind    = 2
     1550       .
     1551       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1552       on error undo, return error
     1553       :
     1554         assign
     1555           v-inform = bh_tbl-name:index-information( v-ind )
     1556           v-ind    = v-ind + 1
     1557         .
     1558       end.
     1559       if v-inform = ?
     1560         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1561         or entry( 3, v-inform, ",":U ) <> "1":U
     1562       then do:
     1563         delete object bh_tbl-name no-error.
     1564         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, v-tbl-name ).
     1565       end.
     1566       assign
     1567         v-idx-field-qnty = num-entries( v-inform ) - 4
     1568       .
     1569       if v-idx-field-qnty < 2 then do:
     1570         delete object bh_tbl-name no-error.
     1571         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, v-tbl-name ).
     1572       end.
     1573       assign
     1574         p-field-list = "":U
     1575         p-value-list = "":U
     1576         v-delim-key  = "":U
     1577         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1578         v-count-fld  = 0
     1579       .
     1580       block_where:
     1581       do v-ind = 1 to v-idx-field-qnty by 2
     1582       on error undo, return error
     1583       :
     1584         assign
     1585           v-count-fld = v-count-fld + 1
     1586         .
     1587         if v-count-fld > v-field-num then do:
     1588           leave block_where.
     1589         end.
     1590         assign
     1591           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1592           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1593         .
     1594         if v-ind = 1 then do:
     1595           assign
     1596             v-delim-key = chr(3)
     1597           .
     1598         end.
     1599       end.
     1600       delete object bh_tbl-name.
     1601       if v-count-fld <> v-field-num then do:
     1602         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info18, v-tbl-name ).
     1603       end.
     1604     end.
     1605   end procedure.
     1606   procedure gen-key-field :
     1607     define input  parameter p-table      as character no-undo .
     1608     define output parameter p-field-list as character no-undo .
     1609     do
     1610     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1611     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1612     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1613     :
     1614       define variable v-full-tbl-name  as character no-undo .
     1615       define variable bh_tbl-name      as handle    no-undo .
     1616       define variable v-tbl-name       as character no-undo .
     1617       define variable v-field-num      as integer   no-undo .
     1618       define variable v-count-fld      as integer   no-undo .
     1619       define variable v-inform         as character no-undo .
     1620       define variable v-ind            as integer   no-undo .
     1621       define variable v-idx-field-qnty as integer   no-undo .
     1622       define variable v-delim-key      as character no-undo .
     1623       if p-table = ?
     1624         or p-table = "":U
     1625       then do:
     1626         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info18 ).
     1627       end.
     1628       assign
     1629         v-tbl-name      = p-table
     1630         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1631       .
     1632       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1633       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info18 ).
     1634       assign
     1635         v-inform = bh_tbl-name:index-information(1)
     1636         v-ind    = 2
     1637       .
     1638       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1639       on error undo, return error
     1640       :
     1641         assign
     1642           v-inform = bh_tbl-name:index-information( v-ind )
     1643           v-ind    = v-ind + 1
     1644         .
     1645       end.
     1646       if v-inform = ?
     1647         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1648         or entry( 3, v-inform, ",":U ) <> "1":U
     1649       then do:
     1650         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, v-tbl-name ).
     1651       end.
     1652       assign
     1653         v-idx-field-qnty = num-entries( v-inform ) - 4
     1654       .
     1655       if v-idx-field-qnty < 2 then do:
     1656         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, v-tbl-name ).
     1657       end.
     1658       assign
     1659         p-field-list = "":U
     1660         v-delim-key  = "":U
     1661         v-count-fld  = 0
     1662       .
     1663       block_where:
     1664       do v-ind = 1 to v-idx-field-qnty by 2
     1665       on error undo, return error
     1666       :
     1667         assign
     1668           v-count-fld = v-count-fld + 1
     1669         .
     1670         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1671         if v-ind = 1 then do:
     1672           assign
     1673             v-delim-key = chr(3)
     1674           .
     1675         end.
     1676       end.
     1677       delete object bh_tbl-name.
     1678     end.
     1679   end procedure.
     1680   procedure create-gds-list-hist :
     1681   define input parameter p-mode as character no-undo .
     1682   define input-output parameter p-seq as integer no-undo .
     1683   define input parameter p-line as integer no-undo .
     1684   define variable p-list-table as character no-undo .
     1685   define input parameter p-hist-mode as character no-undo .
     1686   define input parameter p-des as character no-undo .
     1687   define input parameter p-num-recs as integer no-undo .
     1688   define input parameter p-option as character no-undo .
     1689   define input parameter p-status_ as character no-undo .
     1690   define input parameter p-item as character no-undo .
     1691   define input parameter p-tbl-name as character no-undo .
     1692   define input parameter p-bh_tbl-name as handle no-undo .
     1693   define variable v-num-add as integer no-undo .
     1694   define variable v-num-ignored as integer no-undo .
     1695   define buffer buf_gds-list-hist for gds-list-hist.
     1696     do
     1697     on error undo, return error
     1698     :
     1699       CASE p-mode:
     1700         when 'title' then do:
     1701           find first buf_gds-list-hist where
     1702                      buf_gds-list-hist.id = 0   no-error.
     1703           if not available buf_gds-list-hist then do:
     1704             create buf_gds-list-hist.
     1705             assign
     1706             buf_gds-list-hist.id = 0
     1707             buf_gds-list-hist.line = 0
     1708             buf_gds-list-hist.list-table = '':U
     1709             .
     1710           end.
     1711           assign
     1712           buf_gds-list-hist.des =  p-des
     1713           buf_gds-list-hist.num-recs = p-num-recs
     1714           buf_gds-list-hist.option_  = p-option
     1715           buf_gds-list-hist.item_ = p-item
     1716           .
     1717         end.
     1718         when 'ДОБАВЛЕНИЕ':U then do:
     1719           if p-option begins 'single' then do:
     1720             CASE p-hist-mode:
     1721               when '+':U then do:
     1722                 assign
     1723                 v-num-add = 1
     1724                 v-num-ignored  = 0
     1725                 .
     1726               end.
     1727               when '-':U then do:
     1728                 assign
     1729                 v-num-add = 1
     1730                 v-num-ignored  = 0
     1731                 .
     1732               end.
     1733               when '*':U then do:
     1734                 assign
     1735                 v-num-add = p-num-recs - 1
     1736                 p-num-recs = 1
     1737                 v-num-ignored  = 0
     1738                 .
     1739               end.
     1740             END CASE.
     1741           end.
     1742           create buf_gds-list-hist.
     1743           assign
     1744           buf_gds-list-hist.id = p-seq
     1745           buf_gds-list-hist.list-table = p-list-table
     1746            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
     1747           buf_gds-list-hist.des =  p-des
     1748           buf_gds-list-hist.line = p-line
     1749           buf_gds-list-hist.num-recs = p-num-recs
     1750           buf_gds-list-hist.option_  = p-option
     1751           buf_gds-list-hist.item_ = p-item
     1752           buf_gds-list-hist.hist-mode =  p-hist-mode
     1753           buf_gds-list-hist.status_ =  p-status_
     1754           buf_gds-list-hist.num-add = v-num-add
     1755           buf_gds-list-hist.num-ignored = v-num-ignored
     1756           .
     1757         end.
     1758         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
     1759           find first buf_gds-list-hist where
     1760                     buf_gds-list-hist.id = p-seq
     1761                 and buf_gds-list-hist.line = p-line no-error .
     1762           if  available buf_gds-list-hist then do:
     1763             assign
     1764             buf_gds-list-hist.des =  p-des
     1765             buf_gds-list-hist.num-recs = p-num-recs
     1766             buf_gds-list-hist.option_  = p-option
     1767             buf_gds-list-hist.item_ = p-item
     1768             buf_gds-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
     1769                                        then p-list-table
     1770                                        else buf_gds-list-hist.list-table)
     1771             .
     1772           end.
     1773         end.
     1774         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
     1775           find first buf_gds-list-hist where
     1776                     buf_gds-list-hist.id = p-seq
     1777                 and buf_gds-list-hist.line = p-line  no-error .
     1778           if available buf_gds-list-hist then do:
     1779             assign
     1780             buf_gds-list-hist.hist-mode =  p-hist-mode
     1781             buf_gds-list-hist.num-recs  = (if buf_gds-list-hist.line = 0 then p-num-recs else buf_gds-list-hist.num-recs)
     1782             buf_gds-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
     1783                                        then p-list-table
     1784                                        else buf_gds-list-hist.list-table)
     1785             .
     1786           end.
     1787         end.
     1788       END CASE.
     1789       if p-tbl-name <> "":U
     1790       and valid-handle(p-bh_tbl-name)
     1791       then do:
     1792         run gen-key-rec  in this-procedure (
     1793                                               input  p-tbl-name
     1794                                              ,input  p-bh_tbl-name
     1795                                              ,output p-item) no-error .
     1796         if not error-status:error then do:
     1797           assign
     1798           buf_gds-list-hist.item_ = p-item
     1799           .
     1800         end.
     1801         else do:
     1802           assign
     1803           buf_gds-list-hist.item_ = "!ERROR"
     1804           .
     1805         end.
     1806       end.
     1807     end.
     1808   end procedure.
     1809   FUNCTION get-line-mode returns character(input p-hist-mode as character):
     1810   case p-hist-mode:
     1811     when '+':U then
     1812       return  'ДОБАВЛЕНИЕ':U.
     1813     when '-':U then
     1814       return  'удаление':U.
     1815     when '*':U then
     1816       return  'ОСТАВИТЬ':U.
     1817   end CASE.
     1818   END FUNCTION.
     1819   FUNCTION get-hist-mode returns character(input p-line-mode as character):
     1820   case p-line-mode:
     1821     when 'ДОБАВЛЕНИЕ':U then
     1822       return  "+".
     1823     when 'удаление':U then
     1824       return  "-".
     1825     when 'ОСТАВИТЬ':U then
     1826       return  "*".
     1827   end CASE.
     1828   END FUNCTION.
     1829   procedure proc-write-filter-expression :
     1830   define input parameter p-filter-expression as character no-undo .
     1831   define variable v-ii as integer no-undo .
     1832   output to value(string(g#report-num) + ".whr").
     1833   put .
     1834   if num-entries(p-filter-expression) > 0 then do:
     1835      put unformatted 'and ('.
     1836      do v-ii = 1 to num-entries(p-filter-expression):
     1837        put unformatted entry(v-ii, p-filter-expression) skip.
     1838      end.
     1839      put unformatted ')'.
     1840   end.
     1841   output close.
     1842   end procedure.
     1843   procedure proc-write-filter-expression-var :
     1844   define input parameter p-filter-expression as character no-undo .
     1845   define output parameter p-string as character no-undo .
     1846   define variable v-ii as integer no-undo .
     1847   if num-entries(p-filter-expression) > 0 then do:
     1848      p-string = 'and ('.
     1849      do v-ii = 1 to num-entries(p-filter-expression):
     1850        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
     1851      end.
     1852      p-string = p-string + ')'.
     1853   end.
     1854   end procedure.
