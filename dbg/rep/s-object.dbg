     4145   procedure proc-mi-ed_date :
     4146       define variable v-widget-ref as character no-undo .
     4147       if (can-query (self, "sensitive")
     4148           and
     4149           self :sensitive = true
     4150           )
     4151           or (can-query (self, "read-only")
     4152           and
     4153           self :read-only = false
     4154           )
     4155           then
     4156       do:
     4157           if self :handle <> focus :handle
     4158               then
     4159           do:
     4160               apply "entry":u to self .
     4161           end.
     4162       define variable v-curr-sv-date  as date      no-undo .
     4163           assign
     4164               v-curr-sv-date = date(self :screen-value) no-error
     4165               .
     4166           case self:handle:
     4167               when mi-ed_date-alone-handle then
     4168                   do:
     4169                       v-widget-ref = ref_date-alone.
     4170                   end.
     4171               when mi-ed_date-start-handle then
     4172                   do:
     4173                       v-widget-ref = ref_date-start.
     4174                   end.
     4175               when mi-ed_date-end-handle then
     4176                   do:
     4177                       v-widget-ref = ref_date-end.
     4178                   end.
     4179           end case.
     4180           assign
     4181               v-widget-ref = substring(v-widget-ref, index(v-widget-ref, chr(4)) + 1).
     4182           run gbl/getrefdt.p
     4183               ( input my-handle
     4184               ,input v-widget-ref
     4185               ,input-output v-curr-sv-date
     4186               ) no-error .
     4187       end.
     4188       return.
     4189   end procedure.
     4190   assign
     4191     Radio-period :LIST-ITEM-PAIRS in frame F-Main = 'Год,year,Год (прошлый),year-last,Полугодие,halfyear,Полугодие (прошлое),halfyear-last,Квартал,quarter,Квартал (прошлый),quarter-last,Месяц,month,Месяц (прошлый),month-last,Неделя,week,Неделя (прошлая),week-last,День,day,Вчера,yesterday,Час (текущий),hour,Час (прошлый),hour-last,Смена,shift,Смена (прошлая),shift-last':U
     4192     Radio-schet  :radio-buttons   in frame F-Main = "Все по фирме,1,Своей фирмы,2,Выборочно,3,Один,4,Все рублевые,5,Все валютные,6,По валюте,7"
     4193     SET_val_TYPE :radio-buttons in frame F-Main   = "руб,1,вал,2,обе валюты,3"
     4194     .
     4195   if v-r-b = 'base':U
     4196     then
     4197   do:
     4198     assign
     4199       SET_val_TYPE = 2 .
     4200     display  set_val_type with frame F-Main .
     4201   end.
     4202   PROCEDURE Assign-frame :
     4203     define variable L#obj-code like obj-list.obj-code no-undo.
     4204     define variable l#obj-type like obj-list.obj-type no-undo.
     4205       define buffer cli-obj   for ub.clients .
     4206       define buffer o-clients for ub.clients.
     4207       Assign frame F-Main
     4208           Date-Alone Date-End Date-Start Goods-count
     4209           Goods-Editor Obj-count SelectGood SelectObject
     4210           SET_PAY_TYPE SET_val_TYPE Shift-Alone
     4211           Shift-End Shift-Start TEXT-1 TEXT-2 TEXT-3 TEXT-4 TOG-Shift
     4212           RADIO-task Tog-Excel tog-list-hist tog-shift-2 showcost showcrsa showsale
     4213           RADIO-period
     4214     no-error.
     4215     if  temp-param-date = 8  or temp-param-date = 7 then  tog-shift = true .
     4216     if  tog-shift AND tog-shift-2 THEN
     4217       Assign
     4218         Date-End  = Date-start
     4219         Shift-End = Shift-Start.
     4220     If Tog-Excel Then Make-Excel = True.
     4221     Else Make-Excel = False.
     4222     If Tog-list-hist Then Print-List-Hist = True.
     4223     Else Print-List-Hist = False.
     4224   Assign
     4225     X-Date-Alone     = Date-Alone
     4226     X-Date-End       = Date-End
     4227     X-Date-Start     = Date-Start
     4228     X-Goods-Editor   = Goods-Editor
     4229     X-SelectGood     = SelectGood
     4230     X-SelectObject   = SelectObject
     4231     X-SET_PAY_TYPE   = SET_PAY_TYPE
     4232     X-SET_val_TYPE   = SET_val_TYPE
     4233     X-Shift-Alone    = Shift-Alone
     4234     X-Shift-End      = Shift-End
     4235     X-Shift-Start    = Shift-Start
     4236     X-TEXT-1         = TEXT-1
     4237     X-TEXT-2         = TEXT-2
     4238     X-TEXT-3         = TEXT-3
     4239     X-TEXT-4         = TEXT-4
     4240     X-TOG-Shift      = TOG-Shift
     4241     x-RADIO-task     = RADIO-task
     4242     show-cost  = showcost
     4243     show-crsa  = showcrsa
     4244     show-sale  = showsale
     4245     fin-schet-recid =  schet-list
     4246       .
     4247   if Date-Alone:visible and date-end:visible = false then do:
     4248      x-date-start = Date-Alone .
     4249      x-date-end   = Date-Alone   .
     4250   end.
     4251   if RADIO-task = 4 then
     4252   assign
     4253     X-Shift-End      = X-Shift-Alone
     4254     X-Shift-Start    = X-Shift-Alone
     4255     .
     4256    Assign
     4257    L#obj-code=0
     4258    l#obj-type="".
     4259     for each obj-list  by obj-list.obj-code by obj-list.obj-type :
     4260         find first  o-clients where
     4261         o-clients.obj-code = obj-list.obj-code and
     4262         o-clients.obj-type = obj-list.obj-type  no-lock no-error .
     4263         Assign obj-list.obj-name = if avail o-clients then  o-clients.obj-name else "".
     4264        if obj-list.obj-code = L#obj-code and
     4265           obj-list.obj-type = l#obj-type then  do:
     4266           delete obj-list.
     4267        end.
     4268        else do:
     4269           assign l#obj-code = obj-list.obj-code
     4270                  l#obj-type = obj-list.obj-type   .
     4271        end.
     4272     End.
     4273       Case temp-param-date :
     4274         When 0 then t-str = "" .
     4275         When 1 then t-str = " На " + string(X-Date-Alone,"99/99/9999").
     4276         When 2 then t-str = " За период с  " + string(X-Date-Start,"99/99/9999") + "  по " + string(X-Date-End,"99/99/9999") .
     4277         When 3 then t-str = " По смене № " + string(X-Shift-Alone) + "  за период с " + string(X-Date-Start,"99/99/9999") + "  по " + string(X-Date-End,"99/99/9999") .
     4278         When 4 then DO:
     4279             if  tog-shift AND tog-shift-2 THEN
     4280                   t-str =
     4281                   " По смене № "  + string(X-Shift-Start)   +
     4282                   " на  " + string(X-Date-Start,"99/99/9999") .
     4283             Else
     4284                   t-str =  (If X-TOG-Shift Then
     4285                   "Смены с "  + string(X-Shift-Start)   + " по "  + string(X-Shift-End)  Else "" ) +
     4286                   " За период с  " + string(X-Date-Start,"99/99/9999") + "  по " + string(X-Date-End,"99/99/9999") .
     4287                   End.
     4288         When 5 OR when 6 then DO:
     4289          CASE RAdio-TAsk:
     4290               When 1 then  t-str = "Календарные сутки , За период с  " + string(X-Date-Start,"99/99/9999") + "  по " + string(X-Date-End,"99/99/9999") .
     4291               when 2  then  t-str = "Сменные сутки , За период с  " + string(X-Date-Start,"99/99/9999") + "  по " + string(X-Date-End,"99/99/9999") .
     4292               When 3 then  t-str = "Сменные сутки,  За период с  " + string(X-Date-Start,"99/99/9999") + "  по " + string(X-Date-End,"99/99/9999") +
     4293                                     " Смены с "  + string(X-Shift-Start)   + " по "  + string(X-Shift-End)   .
     4294               When 4 then  t-str = " По смене № " + string(X-Shift-Alone) + " За период с  " + string(X-Date-Start,"99/99/9999") + "  по " + string(X-Date-End,"99/99/9999") .
     4295          End case.
     4296                 End.
     4297         When 7 then t-str = " По смене № " + string(X-Shift-Alone) + "  дата открытия " + string(X-Date-Start,"99/99/9999") .
     4298         When 8 then DO:
     4299                   t-str =
     4300                   "Смены с "  + string(X-Shift-Start)   + " по "  + string(X-Shift-End)  +
     4301                   " За период с  " + string(X-Date-Start,"99/99/9999") + "  по " + string(X-Date-End,"99/99/9999") .
     4302         End.
     4303         When 9 then DO:
     4304                   t-str =
     4305                   "Период : за " +  string (entry ( (lookup(radio-period,'Год,year,Год (прошлый),year-last,Полугодие,halfyear,Полугодие (прошлое),halfyear-last,Квартал,quarter,Квартал (прошлый),quarter-last,Месяц,month,Месяц (прошлый),month-last,Неделя,week,Неделя (прошлая),week-last,День,day,Вчера,yesterday,Час (текущий),hour,Час (прошлый),hour-last,Смена,shift,Смена (прошлая),shift-last':U) - 1)  , 'Год,year,Год (прошлый),year-last,Полугодие,halfyear,Полугодие (прошлое),halfyear-last,Квартал,quarter,Квартал (прошлый),quarter-last,Месяц,month,Месяц (прошлый),month-last,Неделя,week,Неделя (прошлая),week-last,День,day,Вчера,yesterday,Час (текущий),hour,Час (прошлый),hour-last,Смена,shift,Смена (прошлая),shift-last':U ) ) .
     4306         End.
     4307       End case.
     4308        str1 = t-str.
     4309       t-str = '' .
     4310       if temp-param-goods = ""   Then str2 =" ".
     4311       Else DO:
     4312            run sel-x-selectgood  in this-procedure .
     4313            str2 = Text-2 + ": "  + t-str .        .
     4314            End.
     4315       if temp-param-pay = ""   Then str3 =''.
     4316          Else DO:
     4317             If ( x-SET_val_TYPE = 0 and base-code=0)  Or x-SET_val_TYPE=1
     4318               then  DO:
     4319                     case X-SET_PAY_TYPE :
     4320                       when 1 then str3 = Text-4 + ": "    +  "в рублевых ценах РЕАЛИЗАЦИИ".
     4321                       when 2 then str3 = Text-4 + ": "    +  "в УЧЕТНЫХ рублевых ценах".
     4322                       when 3 then str3 = Text-4 + ": "    +  "в рублевых ценах ДОКУМЕНТА".
     4323                     end case.
     4324                     End.
     4325               else  DO:
     4326                     case X-SET_PAY_TYPE :
     4327                       when 1 then str3 = Text-4 + ": "    +  "в валютных ценах РЕАЛИЗАЦИИ".
     4328                       when 2 then str3 = Text-4 + ": "    +  "в УЧЕТНЫХ валютных ценах".
     4329                       when 3 then str3 = Text-4 + ": "    +  "в валютных ценах ДОКУМЕНТА".
     4330                     end case.
     4331                     End.
     4332           End.
     4333       if temp-param-obj = ""   Then str4 =''.
     4334       Else do:
     4335         t-str=''.
     4336           if temp-param-Alon then do:
     4337           if SelectObject = 'все':U THEN run sss in this-procedure .
     4338           if SelectObject = "firm":U THEN run sss in this-procedure .
     4339           if SelectObject = "currency":U then  run select-objects-proc in this-procedure .
     4340           end.
     4341           CAse SelectObject:
     4342             When 'все':U then t-str = " По всем объектам ".
     4343             OTHERWISE DO:
     4344                 FOR each Obj-list :
     4345                     FIND cli-obj WHERE cli-obj.obj-type = obj-list.obj-type  AND
     4346                                        cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     4347                 if LENGTH(t-str) <= 6000 then
     4348                    t-str = t-str + chr(10) + "     " + cli-obj.obj-name  + ' ' + obj-list.obj-type.
     4349                 End.
     4350             End.
     4351          End case.
     4352          str4 = TEXT-1 + ": " + t-str.
     4353          IF str-obj# <> "" Then
     4354             str4 = str4  + chr(10) + "Не включены в список : " + str-obj# .
     4355          IF str-obj2# <> "" Then
     4356             str4 = str4   + chr(10) +  "Нет информации о чеках на объектах : " + str-obj2# .
     4357          IF str-obj3# <> "" Then do:
     4358             if not SelectObject = "firm":U then do:
     4359                str4 = str4   + chr(10) +  "Не текущая фирма : " + str-obj3# .
     4360             end.
     4361          end.
     4362        End.
     4363        if temp-param-customer <> "" then do:
     4364           t-str = "" .
     4365                 t-str = t-str + chr(10) + text-5 + ": " .
     4366                   for each g#customer:
     4367                       if LENGTH (t-str) >= 10000 then do:
     4368                          t-str = trim( t-str , '...') .
     4369                          t-str = t-str + '...' .
     4370                       end.
     4371                       else t-str = t-str + chr(10) + "     " + g#customer.obj-name .
     4372                   End.
     4373           if Radio-customer = 0 then Radio-customer = 1.
     4374           if Radio-customer = 1 then t-str = t-str + chr(10) + "все" .
     4375           str4 = str4 + t-str .
     4376        end.
     4377        if temp-param-schet <> "" then do:
     4378           t-str = "" .
     4379                 t-str = t-str + chr(10) .
     4380           if Radio-schet = 0 then Radio-schet = 1.
     4381           t-str = t-str + chr(10) + lkp-schet .
     4382           str4 = str4 + t-str .
     4383        end.
     4384   run set-attribute-list IN THIS-PROCEDURE (
     4385   'KEEP-SPIS':U  + "=" + string(keep-spis) + "," +
     4386   'RADIO-CUSTOMER':U  + "=" + string(RADIO-CUSTOMER) + "," +
     4387   'RADIO-SCHET':U     + "=" + string(RADIO-SCHET)    + "," +
     4388   'EX-CURR-CODE':U     + "=" + string(v-curr-code)
     4389    ) .
     4390   END PROCEDURE.
     4391   PROCEDURE disable_UI :
     4392     HIDE FRAME F-Main.
     4393     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     4394   END PROCEDURE.
     4395   PROCEDURE Display-count :
     4396   if SelectGood = 6 then do:
     4397           Assign
     4398             goods-count = '(Выбрано ' + string(lns-cnt) + ' список)'
     4399             Goods-Editor= s-notes
     4400             .
     4401   end.
     4402   else do:
     4403   If can-find (First gds-list no-lock)
     4404        then
     4405           Assign
     4406             goods-count = '(Выбрано ' + string(lns-cnt) + ' товаров)'
     4407             Goods-Editor= s-notes
     4408             .
     4409        else
     4410          Assign
     4411          goods-count = ''
     4412          Goods-Editor = ''
     4413          .
     4414    end.
     4415     Display goods-count Goods-Editor with frame F-Main .
     4416     x-Goods-Editor = Goods-Editor.
     4417   END PROCEDURE.
     4418   PROCEDURE Display-count-OTHER :
     4419    x-SelectGood = Integer(SelectGood:screen-value IN frame F-Main).
     4420      run sel-x-selectgood in this-procedure .
     4421           if LENGTH (t-str) > 6000 then do:
     4422             Assign  Goods-Editor = substring(T-str ,1, 6000) + chr(10) + "выборка для просмотра обрезана - слишком много записей " .
     4423         end.
     4424         else Assign  Goods-Editor = T-str  .
     4425         Display goods-count Goods-Editor with frame F-Main .
     4426                 x-Goods-Editor = Goods-Editor.
     4427   END PROCEDURE.
     4428   PROCEDURE display-date :
     4429   define buffer buf_shift-obj for ub.shift-obj .
     4430   case temp-param-date:
     4431       when 0 then do:
     4432            disable Radio-task TEXT-3 Date-Alone BUTTON-shift Shift-Alone Date-End Date-Start  Shift-End Shift-Start TOG-Shift Radio-Period with frame F-Main .
     4433            hide RADIO-task TEXT-3  Date-Alone BUTTON-shift  Shift-Alone Date-End Date-Start Shift-End Shift-Start TOG-Shift BUTTON-Shift-end BUTTON-Shift-Start  Radio-Period in frame F-Main .
     4434            End.
     4435       when 1 then do:
     4436            enable TEXT-3  Date-Alone with frame F-Main .
     4437            display TEXT-3  Date-Alone with frame F-Main .
     4438            disable Radio-task Date-End Date-Start Shift-Alone  BUTTON-shift  Shift-End Shift-Start TOG-Shift  Radio-Period with frame F-Main .
     4439            hide  RADIO-task   Date-End Date-Start Shift-Alone  BUTTON-shift Shift-End Shift-Start TOG-Shift BUTTON-Shift-end BUTTON-Shift-Start  Radio-Period in frame F-Main .
     4440            End.
     4441       when 2 then do:
     4442            TEXT-3 = 'Выбор периода'.
     4443            enable TEXT-3  Date-End Date-Start  with frame F-Main .
     4444            display TEXT-3  Date-End Date-Start  with frame F-Main .
     4445            disable Radio-task Date-Alone Shift-Alone  BUTTON-shift  Shift-End Shift-Start TOG-Shift  Radio-Period with frame F-Main .
     4446            hide   RADIO-task Date-Alone  Shift-Alone  BUTTON-shift Shift-End Shift-Start TOG-Shift BUTTON-Shift-end BUTTON-Shift-Start  Radio-Period in frame F-Main .
     4447            End.
     4448       when 3 then do:
     4449           TEXT-3 = 'Выбор смены'.
     4450            enable  TEXT-3  Date-End Date-Start Shift-Start   Shift-Alone with frame F-Main .
     4451            disable Date-Alone Shift-End shift-start TOG-Shift RADIO-task  Radio-Period with frame F-Main .
     4452            hide    Date-Alone Shift-End shift-start  BUTTON-shift TOG-Shift RADIO-task BUTTON-Shift-end BUTTON-Shift-Start  Radio-Period  in   frame F-Main .
     4453            display   TEXT-3  Date-End Date-Start Shift-Alone with frame F-Main .
     4454            End.
     4455       when 4 then do:
     4456            if TOG-Shift-2 THEN DO:
     4457               disable Date-End  shift-end  with frame F-Main .
     4458            End.
     4459            ELSE DO:
     4460                enable Date-End shift-end  with frame F-Main   .
     4461            End.
     4462            enable  TEXT-3   Date-Start  Shift-Start TOG-Shift with frame F-Main .
     4463            if not tog-shift then do:
     4464               disable Shift-start shift-end BUTTON-Shift-end BUTTON-Shift-Start  Radio-Period with frame F-Main .
     4465               hide Shift-start shift-end BUTTON-Shift-end BUTTON-Shift-Start  Radio-Period in frame F-Main .
     4466            end .
     4467            else do:
     4468               if tog-shift-2 then
     4469                   do:
     4470                       disable shift-end BUTTON-Shift-end Date-End with frame F-Main .
     4471                       enable  Shift-start BUTTON-Shift-Start with frame F-Main .
     4472                       display Shift-start BUTTON-Shift-Start with frame F-Main .
     4473                       display TEXT-3 Date-Start Date-End Shift-Start Shift-End TOG-Shift with frame F-Main .
     4474                   end.
     4475               else
     4476                   do:
     4477                       enable  Shift-start shift-end BUTTON-Shift-end BUTTON-Shift-Start with frame F-Main .
     4478                       display Shift-start shift-end BUTTON-Shift-end BUTTON-Shift-Start with frame F-Main .
     4479                       display TEXT-3 Date-Start Date-End Shift-Start Shift-End TOG-Shift with frame F-Main .
     4480                   end.
     4481            end.
     4482            display Date-Start Date-End TOG-Shift with frame F-Main .
     4483            disable Date-Alone BUTTON-shift Shift-Alone Radio-task  Radio-Period with frame F-Main .
     4484            hide    RADIO-task BUTTON-shift Date-Alone Shift-Alone   Radio-Period in frame F-Main .
     4485            if temp-param-obj = "" then do:
     4486               if NOT can-find(first buf_shift-obj where buf_shift-obj.obj-code = v-cntxt-obj-code and
     4487                                                     buf_shift-obj.obj-type = v-cntxt-obj-type no-lock ) then  DO:
     4488                   hide  Shift-Start TOG-Shift Shift-End TOG-Shift-2 BUTTON-Shift-end BUTTON-Shift-Start in frame F-Main .
     4489               end.
     4490               else do:
     4491                 if tog-shift then do:
     4492                    enable BUTTON-Shift-Start with frame F-Main .
     4493                     if not tog-shift-2 then
     4494                       enable BUTTON-Shift-end  with frame F-Main .
     4495                 end.
     4496               end.
     4497            End.
     4498       End.
     4499       when 5 then do:
     4500            enable  TEXT-3  Date-End Date-Start  RADIO-task  with frame F-Main .
     4501            display TEXT-3  Date-End Date-Start  RADIO-task  with frame F-Main .
     4502            disable Date-Alone BUTTON-shift  TOG-Shift   Radio-Period  with frame F-Main .
     4503            hide Date-Alone BUTTON-shift  Shift-Alone TOG-Shift  Radio-Period  in frame F-Main .
     4504            End.
     4505       when 6 then do:
     4506            enable  TEXT-3  Date-End Date-Start  RADIO-task  with frame F-Main .
     4507            display TEXT-3  Date-End Date-Start  RADIO-task  with frame F-Main .
     4508            disable Date-Alone TOG-Shift   Radio-Period with frame F-Main .
     4509            hide Date-Alone BUTTON-shift  Shift-Alone TOG-Shift  Radio-Period  in frame F-Main .
     4510            v-ok = RADIO-TASK:disable(radio-label("3", RADIO-TASK:radio-buttons)).
     4511            v-ok = RADIO-TASK:disable(radio-label("4", RADIO-TASK:radio-buttons)).
     4512            End.
     4513       when 7 then do:
     4514           TEXT-3 = 'Выбор смены'.
     4515            enable  TEXT-3   Date-Start Shift-Start Shift-Alone with frame F-Main .
     4516            disable Date-Alone date-end Shift-End shift-start TOG-Shift RADIO-task  Radio-Period  with frame F-Main .
     4517            hide    Date-Alone date-end Shift-End shift-start TOG-Shift RADIO-task  Radio-Period  in   frame F-Main .
     4518            display   TEXT-3  Date-Start Shift-Alone  BUTTON-shift  with frame F-Main .
     4519            End.
     4520       when 8 then do:
     4521            tog-shift = true .
     4522            tog-shift-2 = false  .
     4523            x-tog-shift = true .
     4524            enable   Date-Start  Shift-Start
     4525                     Date-End  shift-end
     4526                     BUTTON-Shift-end BUTTON-Shift-Start  with frame F-Main .
     4527             display Shift-start shift-end
     4528                     TEXT-3   Date-Start  Shift-Start Date-End Shift-End   with frame F-Main .
     4529            hide  Date-Alone BUTTON-shift  Shift-Alone Radio-task   tog-shift tog-shift-2    Radio-Period
     4530                   RADIO-task   BUTTON-shift Date-Alone Shift-Alone in frame F-Main .
     4531       End.
     4532       when 9 then do:
     4533            TEXT-3 ='Выбор периода'.
     4534            enable  RADIO-period  with frame F-Main .
     4535            display TEXT-3  RADIO-period  with frame F-Main .
     4536            disable Date-Alone BUTTON-shift  TOG-Shift   Radio-task  with frame F-Main .
     4537            hide Date-Alone BUTTON-shift  Shift-Alone TOG-Shift  Radio-task
     4538                 Date-Start  Date-End
     4539                 in frame F-Main .
     4540      End.
     4541   End case.
     4542   if choose-shift
     4543   and TOG-Shift:sensitive
     4544   then do :
     4545     TOG-Shift:screen-value in frame F-Main = "yes" .
     4546     TOG-Shift = yes.
     4547     apply "value-changed" to TOG-Shift in frame F-Main .
     4548   end .
     4549   END PROCEDURE.
     4550   PROCEDURE display-goods :
     4551       define buffer buf_clob-bind for ub.clob-bind  .
     4552       define variable v-temp-str as character no-undo .
     4553       define variable J#         as integer   no-undo .
     4554       define variable L#         as integer   no-undo .
     4555       define variable RET#       as logical   no-undo .
     4556       define variable R#         as integer   no-undo .
     4557       IF  temp-param-goods = ""
     4558           then
     4559       DO:
     4560           disable TEXT-2 SelectGood BUTTON-gds button-keep-spis BUTTON-node BUTTON-prod BUTTON-node-2 BUTTON-prod-2 BUTTON-one Goods-count Goods-Editor  with frame F-Main .
     4561           hide TEXT-2 SelectGood  BUTTON-gds button-keep-spis  BUTTON-node BUTTON-prod  BUTTON-node-2 BUTTON-prod-2  BUTTON-one Goods-count Goods-Editor   in frame F-Main .
     4562       End.
     4563       Else
     4564       DO:
     4565           enable TEXT-2 with frame F-Main .
     4566           display TEXT-2 SelectGood with frame F-Main .
     4567   if temp-param-goods <> "*":U then do :
     4568     v-temp-str="".
     4569     repeat l# =1 to num-entries(SelectGood:radio-buttons) / 2
     4570     :
     4571         if lookup(string(l#),replace(temp-param-goods,"!","")) = 0 then
     4572           v-temp-str = v-temp-str + string(l#) + ','.
     4573     end.
     4574     repeat l# = 1  to num-entries(v-temp-str)
     4575     :
     4576       r# = 0.
     4577       repeat j# = 1 to num-entries(SelectGood:radio-buttons) by 2
     4578       :
     4579         r# = r# + 1.
     4580         if r# = integer(entry(l#,v-temp-str)) then
     4581            ret# = SelectGood:disable(entry(j#,SelectGood:radio-buttons)).
     4582       end.
     4583     end.
     4584     do l# = 1 to num-entries(temp-param-goods):
     4585       if entry(l#,temp-param-goods) begins "!" then
     4586       do:
     4587         r# = integer(substring(entry(l#,temp-param-goods),2)) no-error.
     4588         SelectGood:screen-value = entry(r# * 2,SelectGood:radio-buttons).
     4589         assign SelectGood.
     4590       end.
     4591     end.
     4592   end.
     4593           lns-cnt = 0 .
     4594           for each gds-list :
     4595               lns-cnt = lns-cnt + 1 .
     4596           end.
     4597           define variable v-i as integer no-undo .
     4598           s-notes =  "" .
     4599           for each gds-list-hist :
     4600               v-i = v-i + 1 .
     4601               s-notes = s-notes + chr(10) + gds-list-hist.hist-mode +  gds-list-hist.des .
     4602               if v-i > 10 then
     4603               do:
     4604                   s-notes = s-notes + " ... " .
     4605                   leave.
     4606               end.
     4607           end.
     4608           if keep-spis <> "" then
     4609           do:
     4610               find first buf_clob-bind no-lock where
     4611                   buf_clob-bind.field-name_ = keep-spis no-error .
     4612               if available buf_clob-bind then
     4613               do:
     4614                   keep-spis = buf_clob-bind.field-name_ .
     4615                   s-notes =  substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name, buf_clob-bind.descr ).
     4616               end.
     4617           end.
     4618       run display-count-other in this-procedure .
     4619     End.
     4620   END PROCEDURE.
     4621   PROCEDURE display-obj :
     4622   define variable v-temp-str  as character no-undo .
     4623   define variable J#          as integer   no-undo .
     4624   define variable L#          as integer   no-undo .
     4625   define variable RET#        as logical   no-undo .
     4626   define variable R#          as integer   no-undo .
     4627    IF temp-param-obj = ""
     4628       then DO:
     4629          disable TEXT-1 BUTTON-obj SelectObject Obj-count   with frame F-Main .
     4630          hide    TEXT-1  BUTTON-obj SelectObject Obj-count   in frame F-Main .
     4631       End.
     4632       Else DO:  enable TEXT-1 with frame F-Main .
     4633                 display TEXT-1  SelectObject Obj-count  with frame F-Main .
     4634   if temp-param-obj <> "*":U then do :
     4635     v-temp-str="".
     4636     repeat l# =1 to num-entries(SelectObject:radio-buttons) / 2
     4637     :
     4638         if lookup(string(l#),replace(temp-param-obj,"!","")) = 0 then
     4639           v-temp-str = v-temp-str + string(l#) + ','.
     4640     end.
     4641     repeat l# = 1  to num-entries(v-temp-str)
     4642     :
     4643       r# = 0.
     4644       repeat j# = 1 to num-entries(SelectObject:radio-buttons) by 2
     4645       :
     4646         r# = r# + 1.
     4647         if r# = integer(entry(l#,v-temp-str)) then
     4648            ret# = SelectObject:disable(entry(j#,SelectObject:radio-buttons)).
     4649       end.
     4650     end.
     4651     do l# = 1 to num-entries(temp-param-obj):
     4652       if entry(l#,temp-param-obj) begins "!" then
     4653       do:
     4654         r# = integer(substring(entry(l#,temp-param-obj),2)) no-error.
     4655         SelectObject:screen-value = entry(r# * 2,SelectObject:radio-buttons).
     4656         assign SelectObject.
     4657       end.
     4658     end.
     4659   end.
     4660       if SelectObject = "choice":U then do:
     4661           if not can-find (first userobjs_temp-user-obj) then do:
     4662             for each X-init_obj-list:
     4663                   create userobjs_temp-user-obj.
     4664                   assign
     4665                     userobjs_temp-user-obj.obj-code = X-init_obj-list.obj-code
     4666                     userobjs_temp-user-obj.obj-type = X-init_obj-list.obj-type
     4667                   .
     4668             end.
     4669            end.
     4670       end.
     4671        if (v-cntxt-obj-type = 'скл':U and temp-param-obj-type = 'shop')
     4672        or (v-cntxt-obj-type = 'маг':U  and temp-param-obj-type = 'stock')
     4673        then do:
     4674           ret# = selectobject:disable(entry(3,selectobject:radio-buttons)).
     4675           apply "value-changed" to selectobject in frame f-main.
     4676           end.
     4677        end.
     4678   END PROCEDURE.
     4679   PROCEDURE display-pay :
     4680   define variable v-temp-str  as character no-undo .
     4681   define variable J#          as integer   no-undo .
     4682   define variable L#          as integer   no-undo .
     4683   define variable RET#        as logical   no-undo .
     4684   define variable R#          as integer   no-undo .
     4685   IF temp-param-pay = "" then DO:
     4686            disable   SET_PAY_TYPE   with frame F-Main .
     4687            hide  SET_PAy_TYPE  in frame F-Main .
     4688            SET_PAY_TYPE:screen-value IN frame F-Main = "2".
     4689            SET_PAY_TYPE = 2.
     4690                           end.
     4691      Else do:
     4692            enable TEXT-4  SET_PAY_TYPE SET_val_TYPE with frame F-Main .
     4693            display TEXT-4 SET_PAY_TYPE with frame F-Main .
     4694   if temp-param-pay <> "*":U then do :
     4695     v-temp-str="".
     4696     repeat l# =1 to num-entries(SET_pay_TYPE:radio-buttons) / 2
     4697     :
     4698         if lookup(string(l#),replace(temp-param-pay,"!","")) = 0 then
     4699           v-temp-str = v-temp-str + string(l#) + ','.
     4700     end.
     4701     repeat l# = 1  to num-entries(v-temp-str)
     4702     :
     4703       r# = 0.
     4704       repeat j# = 1 to num-entries(SET_pay_TYPE:radio-buttons) by 2
     4705       :
     4706         r# = r# + 1.
     4707         if r# = integer(entry(l#,v-temp-str)) then
     4708            ret# = SET_pay_TYPE:disable(entry(j#,SET_pay_TYPE:radio-buttons)).
     4709       end.
     4710     end.
     4711     do l# = 1 to num-entries(temp-param-pay):
     4712       if entry(l#,temp-param-pay) begins "!" then
     4713       do:
     4714         r# = integer(substring(entry(l#,temp-param-pay),2)) no-error.
     4715         SET_pay_TYPE:screen-value = entry(r# * 2,SET_pay_TYPE:radio-buttons).
     4716         assign SET_pay_TYPE.
     4717       end.
     4718     end.
     4719   end.
     4720            if Lookup(temp-param-pay, "2" ) > 0 Then
     4721            Assign SET_PAY_TYPE:screen-value IN frame F-Main = "2"
     4722                   SET_PAY_TYPE = 2.
     4723            End.
     4724   IF temp-param-pay-hide = "" then DO:
     4725            disable   SET_val_TYPE  with frame F-Main .
     4726            hide  SET_val_TYPE  in frame F-Main .
     4727                           end.
     4728      Else do:
     4729            enable  SET_val_TYPE with frame F-Main .
     4730            display TEXT-4  with frame F-Main .
     4731   if temp-param-pay-hide <> "*":U then do :
     4732     v-temp-str="".
     4733     repeat l# =1 to num-entries(SET_val_TYPE:radio-buttons) / 2
     4734     :
     4735         if lookup(string(l#),replace(temp-param-pay-hide,"!","")) = 0 then
     4736           v-temp-str = v-temp-str + string(l#) + ','.
     4737     end.
     4738     repeat l# = 1  to num-entries(v-temp-str)
     4739     :
     4740       r# = 0.
     4741       repeat j# = 1 to num-entries(SET_val_TYPE:radio-buttons) by 2
     4742       :
     4743         r# = r# + 1.
     4744         if r# = integer(entry(l#,v-temp-str)) then
     4745            ret# = SET_val_TYPE:disable(entry(j#,SET_val_TYPE:radio-buttons)).
     4746       end.
     4747     end.
     4748     do l# = 1 to num-entries(temp-param-pay-hide):
     4749       if entry(l#,temp-param-pay-hide) begins "!" then
     4750       do:
     4751         r# = integer(substring(entry(l#,temp-param-pay-hide),2)) no-error.
     4752         SET_val_TYPE:screen-value = entry(r# * 2,SET_val_TYPE:radio-buttons).
     4753         assign SET_val_TYPE.
     4754       end.
     4755     end.
     4756   end.
     4757            End.
     4758    IF temp-param-pay = ""  And  temp-param-pay-hide = "" then DO:
     4759            disable  TEXT-4 SET_PAY_TYPE SET_val_TYPE  with frame F-Main .
     4760            hide TEXT-4  SET_PAY_TYPE SET_val_TYPE  in frame F-Main .
     4761                           end.
     4762      Else do:
     4763            enable  TEXT-4   with frame F-Main .
     4764            display TEXT-4   with frame F-Main .
     4765            end.
     4766   END PROCEDURE.
     4767   PROCEDURE display-RAdio-task :
     4768   Case RAdio-task:screen-value in frame F-Main :
     4769     When '1' then DO:
     4770       TOG-Shift = False.
     4771       Hide   Date-Alone Shift-Alone  BUTTON-shift   Shift-End Shift-Start  TOG-Shift in frame F-Main .
     4772       Display Date-End Date-Start with frame F-Main .
     4773       x-TOG-Shift = False.
     4774                   End.
     4775     When '2' then DO:
     4776       TOG-Shift=true.
     4777       Hide    Date-Alone Shift-Alone  BUTTON-shift Shift-End Shift-Start  TOG-Shift in frame F-Main .
     4778       Display Date-End Date-Start with frame F-Main .
     4779       x-TOG-Shift = True.
     4780                   End.
     4781     When '3' then DO:
     4782         TOG-Shift=true.
     4783         enable Date-End Date-Start  Shift-End Shift-Start with frame F-Main .
     4784         Hide   Date-Alone Shift-Alone    BUTTON-shift   TOG-Shift in frame F-Main .
     4785         Display Date-End Date-Start Shift-End Shift-Start with frame F-Main .
     4786         assign
     4787         x-TOG-Shift = True.
     4788                   End.
     4789     When '4' then DO:
     4790          TOG-Shift=true.
     4791          enable Date-End Date-Start  Shift-Alone with frame F-Main .
     4792          Hide   Date-Alone   Shift-End  BUTTON-shift  Shift-Start TOG-Shift in frame F-Main .
     4793          Display Date-End Date-Start  Shift-Alone  with frame F-Main .
     4794          assign Date-End Date-Start  Shift-Alone.
     4795          assign Shift-End   = Shift-Alone
     4796                 Shift-Start = Shift-Alone
     4797                 x-Shift-End   = Shift-Alone
     4798                 x-Shift-Start = Shift-Alone
     4799                 Shift-start:screen-value = string(Shift-Alone)
     4800                 Shift-End:screen-value = string(Shift-Alone)
     4801                 .
     4802          x-TOG-Shift = True.
     4803                   End.
     4804     End.
     4805   END PROCEDURE.
     4806   PROCEDURE init-radio-schet :
     4807    do
     4808    on error undo, return error return-value
     4809    :
     4810   define variable ll as integer no-undo .
     4811   define buffer buf_fin-schet for ub.fin-schet.
     4812     if temp-param-schet = "" then do:
     4813        hide Radio-schet in frame F-Main
     4814        Radio-schet BUTTON-schet BUTTON-schet-one BUTTON-schet-val lkp-schet text-6 in frame F-Main .
     4815     end.
     4816     else do:
     4817       text-6 = temp-param-schet .
     4818       display text-6 with frame F-Main .
     4819         if temp-param-schet-init <> "" then do:
     4820            radio-schet = 4 .
     4821         end.
     4822         if temp-param-schet-hide <> "" then do:
     4823            repeat ll = 1 to num-entries(temp-param-schet-hide) - 1 :
     4824              if radio-schet = 4  and entry(ll,temp-param-schet-hide) =  string( 4 )
     4825                 then message "Не верно заданы параметры для блока ВЫБОР СЧЕТА в вызывающей процедуре g- " view-as alert-box error .
     4826              v-ok = radio-schet:disable ( radio-label(entry(ll,temp-param-schet-hide), radio-schet:radio-buttons)) .
     4827              case integer (entry(ll,temp-param-schet-hide)) :
     4828                 when 4 then do:
     4829                   hide button-schet-one in frame F-Main .
     4830                 end.
     4831                 when 3 then do:
     4832                   hide button-schet in frame F-Main .
     4833                 end.
     4834                 when 7 then do:
     4835                   hide button-schet-val in frame F-Main .
     4836                 end.
     4837              end case.
     4838            end.
     4839            repeat ll = 7 to 1 by -1 :
     4840                 if radio-schet <> 4 then do:
     4841                     if lookup( string(ll) , temp-param-schet-hide) <> 0 then next.
     4842                     radio-schet = ll .
     4843                 end.
     4844            end.
     4845                   case radio-schet :
     4846                         when 3 then do:
     4847                             enable button-schet with frame F-Main .
     4848                             disable button-schet-one button-schet-val with frame F-Main .
     4849                         end.
     4850                         when 4 then do:
     4851                             enable button-schet-one with frame F-Main .
     4852                             disable button-schet button-schet-val with frame F-Main .
     4853                               if temp-param-schet-init <> "" and temp-param-schet-init <> ? then do:
     4854                                     find first buf_fin-schet no-lock where
     4855                                         buf_fin-schet.code-schet = integer (temp-param-schet-init) and
     4856                                         buf_fin-schet.host-code  = v-cntxt-host-code-obj no-error .
     4857                                         if available buf_fin-schet then
     4858                                         assign
     4859                                           schet-list = string(recid(buf_fin-schet))
     4860                                         .
     4861                               end.
     4862                         end.
     4863                         when 7 then do:
     4864                             enable button-schet-val with frame F-Main .
     4865                             disable button-schet-one button-schet with frame F-Main .
     4866                         end.
     4867                   end case.
     4868                   lkp-schet = temp-param-schet + " по : " +
     4869                               radio-label(string(RADIO-schet) , radio-schet:radio-buttons)
     4870                               + chr(10) .
     4871                   define variable v-iii as integer no-undo .
     4872                   if schet-list <> ""
     4873                      then do:
     4874                         repeat v-iii = 1 to num-entries(schet-list) :
     4875                           find first buf_fin-schet no-lock where    recid(buf_fin-schet) = integer (entry(v-iii,schet-list))   no-error .
     4876                           if available buf_fin-schet then
     4877                              lkp-schet  = lkp-schet  + string( buf_fin-schet.code-schet) + ", " .
     4878                         end.
     4879                   end .
     4880                   display lkp-schet with frame F-Main .
     4881         end.
     4882         display radio-schet with frame F-Main .
     4883     end.
     4884     end.
     4885   END PROCEDURE.
     4886   PROCEDURE local-apply-layout :
     4887   define buffer buf_shift-obj for ub.shift-obj .
     4888   RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     4889   run take-var in this-procedure .
     4890   if temp-param-date = 10
     4891   then do :
     4892     temp-param-date = 4 .
     4893   end .
     4894   Assign
     4895    Date-Alone   = X-Date-Alone
     4896    Date-End     = X-Date-End
     4897    Date-Start   = X-Date-Start
     4898    Goods-Editor = X-Goods-Editor
     4899    SelectGood   = X-SelectGood
     4900    SelectObject = X-SelectObject
     4901    SET_PAY_TYPE = X-SET_PAY_TYPE
     4902    SET_val_TYPE = X-SET_val_TYPE
     4903    Shift-Alone  = X-Shift-Alone
     4904    Shift-End    = X-Shift-End
     4905    Shift-Start  = X-Shift-Start
     4906    TOG-Shift    = X-TOG-Shift
     4907    RADIO-task   = x-RADIO-task      .
     4908    if (init-SET_PAY_TYPE <> 0 or init-SET_PAY_TYPE <> ?)  and (x-SET_PAY_TYPE = ? or x-SET_PAY_TYPE = 0) then do:
     4909       SET_PAY_TYPE = init-SET_PAY_TYPE.
     4910    end.
     4911   If NOT can-find (First gds-list no-lock)
     4912        then lns-cnt = 0.
     4913       If x-Date-Alone = date('') then  Date-Alone   = init-Date-Alone.
     4914       If x-Date-End   = date('') then  Date-End     = init-Date-End  .
     4915       If x-Date-Start = date('') then  Date-Start   = init-Date-Start.
     4916       If x-Shift-alone = 0 then        Shift-alone  = init-shift-alone.
     4917       If x-Shift-start = 0 then        Shift-start  = init-shift-start.
     4918       If x-Shift-end = 0 then          Shift-end    = init-shift-end  .
     4919       if  temp-param-date  = 9  and ( radio-period = ? or radio-period = "" ) then do:
     4920           if temp-param-date-type-period <> ? then radio-period = temp-param-date-type-period.
     4921       end.
     4922      Assign
     4923         RADIO-task = x-RADIO-task
     4924         .
     4925        if can-find(first buf_shift-obj where buf_shift-obj.obj-code = v-cntxt-obj-code and
     4926                                          buf_shift-obj.obj-type = v-cntxt-obj-type no-lock ) then  DO:
     4927           If temp-param-date = 4 then  tog-shift = true .
     4928           If temp-param-date = 8 or temp-param-date = 7 then  assign
     4929                                           tog-shift = true
     4930                                           x-tog-shift = true
     4931                                           .
     4932        end.
     4933         If temp-param-date < 5 OR
     4934            temp-param-date = 7 Then
     4935           Assign
     4936           RAdio-task = 0
     4937           RAdio-task:screen-value in frame F-Main="".
     4938         run val-shift    in this-procedure .
     4939         run display-date in this-procedure .
     4940         run verify-date  in this-procedure .
     4941         If temp-param-date = 5  OR
     4942            temp-param-date = 6
     4943              Then   run display-radio-task in this-procedure .
     4944         run display-goods in this-procedure .
     4945         run val-goods in this-procedure .
     4946         if temp-param-goods <> "" then do:
     4947            run display-count-other in this-procedure .
     4948         end.
     4949         else
     4950           hide goods-editor in frame F-Main.
     4951     run display-obj in this-procedure .
     4952     run val-obj in this-procedure .
     4953     run display-pay in this-procedure .
     4954     run set_val in this-procedure .
     4955     if selectobject = 'все':U then run sss in this-procedure .
     4956     if selectobject = "firm":U then run sss in this-procedure .
     4957     run verify-check-currency in this-procedure .
     4958     run sel-customer in this-procedure  .
     4959     if ref_date-end <> '':U then do:
     4960       if not valid-handle(mi-ed_date-end-handle) then do:
     4961         create menu-item mi-ed_date-end-handle
     4962         assign
     4963         label = entry(1, ref_date-end, chr(4))
     4964         name = 'mi-ed_date-alone'
     4965         parent = menu-ed_date-end-handle
     4966         triggers:
     4967           on choose
     4968             persistent run proc-mi-ed_date in this-procedure .
     4969         end triggers.
     4970       end.
     4971     end.
     4972     if ref_date-alone <> '':U then do:
     4973       if not valid-handle(mi-ed_date-alone-handle) then do:
     4974         create menu-item mi-ed_date-alone-handle
     4975         assign
     4976         label = entry(1, ref_date-alone, chr(4))
     4977         name = 'mi-ed_date-alone'
     4978         parent = menu-ed_date-alone-handle
     4979         triggers:
     4980           on choose
     4981             persistent run proc-mi-ed_date in this-procedure .
     4982         end triggers.
     4983       end.
     4984     end.
     4985     if ref_date-start <> '':U then do:
     4986       if not valid-handle(mi-ed_date-start-handle) then do:
     4987         create menu-item mi-ed_date-start-handle
     4988         assign
     4989         label = entry(1, ref_date-start, chr(4))
     4990         name = 'mi-ed_date-alone'
     4991         parent = menu-ed_date-start-handle
     4992         triggers:
     4993           on choose
     4994             persistent run proc-mi-ed_date in this-procedure .
     4995         end triggers.
     4996       end.
     4997     end.
     4998    if params-only-mode  = 'ПРОСМОТР':U then do:
     4999         disable
     5000         radio-task
     5001         date-alone
     5002         tog-shift-2
     5003         tog-shift
     5004         showcrsa
     5005         showcost
     5006         showsale
     5007         shift-alone
     5008         shift-end
     5009         date-start
     5010         date-end
     5011         set_pay_type
     5012         set_val_type
     5013         selectgood
     5014         selectobject
     5015         radio-customer
     5016         radio-schet
     5017         radio-period
     5018         tog-excel
     5019         tog-list-hist
     5020         with frame F-Main .
     5021    end.
     5022   END PROCEDURE.
     5023   PROCEDURE local-enable :
     5024     RUN dispatch IN THIS-PROCEDURE ( INPUT 'enable':U ) .
     5025   END PROCEDURE.
     5026   PROCEDURE local-initialize :
     5027   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
     5028   ASSIGN parParentProc = my-handle.
     5029    do with frame F-Main:
     5030         if not (v-cntxt-level = 'firm':U  or
     5031                 v-cntxt-level = 'global':U )  then do:
     5032           assign
     5033             SelectObject :radio-buttons =
     5034                 "Все по фирме" + chr(44) + "firm":U
     5035               + chr(44) + "Текущий" + chr(44) + "currency":U
     5036               + chr(44) + "Выборочно" + chr(44) + "choice":U
     5037               + chr(44) + "Все" + chr(44) + 'все':U
     5038           .
     5039       end.
     5040       else do:
     5041           assign
     5042             SelectObject :radio-buttons =
     5043                 "Все по фирме" + chr(44) + "firm":U
     5044               + chr(44) + "Выборочно" + chr(44) + "choice":U
     5045               + chr(44) + "Все" + chr(44) + 'все':U
     5046           .
     5047           BUTTON-obj:ROW = 7.92 .
     5048       end.
     5049     end.
     5050   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5051   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5052     (input  v-cntxt-host-code-obj
     5053     ,output base-code
     5054     )  .
     5055   run take-var in this-procedure .
     5056   run init-radio-schet in this-procedure  .
     5057   If temp-param-date = 10 then
     5058     tog-shift:screen-value in frame F-Main = string(true) .
     5059     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     5060      if temp-param-obj <> ""  then do:
     5061         if not (v-cntxt-level = 'firm':U  or
     5062                 v-cntxt-level = 'global':U )
     5063                 then    SelectObject =  "currency":U .
     5064         Display SelectObject with frame F-Main.
     5065         if SelectObject =  "choice":U then do:
     5066            empty temp-table userobjs_temp-user-obj.
     5067         end.
     5068         else do:
     5069   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5070   run create_obj-list in this-procedure
     5071    ( input v-cntxt-obj-type ,
     5072      input v-cntxt-obj-code )
     5073      .
     5074         end.
     5075     end.
     5076     If Make-Excel then DO:
     5077        TOG-Excel = tRUE .
     5078        Disable TOG-Excel  with frame F-Main.
     5079        DISPLAY TOG-Excel  with frame F-Main.
     5080        End.
     5081        Else DO:
     5082             Disable TOG-Excel  with frame F-Main.
     5083             Hide    TOG-Excel  in frame F-Main.
     5084             End.
     5085     If Print-List-Hist then DO:
     5086       TOG-List-hist = tRUE .
     5087       ENABLE TOG-List-hist  with frame F-Main.
     5088       DISPLAY TOG-List-hist  with frame F-Main.
     5089     End.
     5090     Else DO:
     5091       Disable TOG-List-hist  with frame F-Main.
     5092       Hide    TOG-List-hist  in frame F-Main.
     5093     End.
     5094     If Show-Cost then DO:
     5095       Showcost = Show-cost.
     5096        enable showcost  with frame F-Main.
     5097        DISPLAY showcost  with frame F-Main.
     5098        End.
     5099     If Show-Crsa then DO:
     5100       Showcrsa = Show-crsa.
     5101        enable showcrsa  with frame F-Main.
     5102        DISPLAY showcrsa  with frame F-Main.
     5103        End.
     5104     If Show-sale then DO:
     5105       Showsale = Show-sale.
     5106        enable showsale  with frame F-Main.
     5107        DISPLAY showsale  with frame F-Main.
     5108        End.
     5109       IF Name-Sale-price <> "" THEN DO :
     5110          define variable str as character no-undo .
     5111          str = SET_PAY_TYPE:radio-buttons IN frame F-Main.
     5112          str = entry(1,str) + ","  + entry(2,str) + "," + entry(3,str) + ","+ entry(4,str) + "," + Name-Sale-price + "," + entry(6,str).
     5113          SET_PAY_TYPE:radio-buttons IN frame F-Main = str.
     5114          showsale:label = Name-Sale-price .
     5115        end.
     5116         if (init-SET_val_type <> 0)
     5117         and set_val_type:sensitive in frame F-Main
     5118         and set_val_type:visible in frame F-Main
     5119         then do:
     5120           assign
     5121           set_val_type:screen-value = string(init-SET_val_type)
     5122           no-error .
     5123         end.
     5124   END PROCEDURE.
     5125   PROCEDURE make-6-gds-list :
     5126    define buffer buf-goods for ub.goods.
     5127    if X-SelectGood = 7 Then do:
     5128     run set-cursor IN adm-broker-hdl ("WAIT").
     5129     for each gds-list  :
     5130       delete gds-list.
     5131     End.
     5132         for each g#cli no-lock :
     5133           for each tmp#grp no-lock :
     5134             for each buf-goods where
     5135                 buf-goods.prod-type = g#cli.obj-type and
     5136                 buf-goods.prod-code = g#cli.obj-code and
     5137                 ( trim(buf-goods.grp-name)  begins trim(tmp#grp.grp-name) )
     5138                 no-lock :
     5139                    if not can-find(first gds-list where gds-list.gds-code= buf-goods.gds-code) then  do:
     5140                       create gds-list.
     5141                       BUFFER-copy buf-goods TO gds-list  no-error  .
     5142                    End.
     5143              End.
     5144           End.
     5145         End.
     5146       RUN set-cursor IN adm-broker-hdl ("").
     5147    End.
     5148   END PROCEDURE.
     5149   PROCEDURE return-var :
     5150   def output parameter param-1 as char.
     5151   param-1 = 'qqqq'.
     5152   END PROCEDURE.
     5153   PROCEDURE sel-customer :
     5154    do
     5155    on error undo, return error return-value
     5156    :
     5157     if temp-param-customer = "" then do:
     5158        hide Radio-customer in frame F-Main
     5159        customer-name text-5 rect-7 in frame F-Main .
     5160     end.
     5161     else do:
     5162       text-5 = temp-param-customer .
     5163       display text-5 with frame F-Main .
     5164     end.
     5165     end.
     5166   END PROCEDURE.
     5167   PROCEDURE sel-x-SelectGood :
     5168   define variable grp_name    as char.
     5169   define buffer buf_gds-grp for ub.gds-grp .
     5170   define variable my-c as int no-undo.
     5171   IF temp-param-goods <> "" THEN DO:
     5172           Case x-SelectGood :
     5173             When 1 then t-str = " По всем товарам ".
     5174             When 2 then DO:
     5175                 t-str = " По группам "  .
     5176                           For each  tmp#grp :
     5177                                delete tmp#grp.
     5178                           End.
     5179                           define variable v-ind as integer   no-undo .
     5180                           Repeat v-ind = 1 To num-entries( gdsgrp_recids )
     5181                           :
     5182                                 find first buf_gds-grp WHERE recid ( buf_gds-grp ) = integer ( Entry(v-ind,gdsgrp_recids )) NO-LOCK.
     5183                                 RUN grplib-get-full-name in this-procedure( input buf_gds-grp.node-code, output Grp_Name ).
     5184                                   if Grp_Name <> ? Then  if LENGTH(t-str) <= 6000 then t-str = t-str + chr(10) + "     " + Grp_Name .
     5185                                   Create tmp#grp.
     5186                                   Assign tmp#grp.node-code = buf_gds-grp.node-code
     5187                                          tmp#grp.grp-name = Grp_Name
     5188                                          tmp#grp.is-term = buf_gds-grp.is-term
     5189                                          tmp#grp.lvl-num = buf_gds-grp.lvl-num
     5190                                          .
     5191                               end.
     5192                   if num-entries( gdsgrp_recids ) > 0 THEN
     5193                      goods-count = "выбрано " + string(num-entries( gdsgrp_recids )) + " групп " .
     5194                      ELSE goods-count = "НЕ выбрано !!!".
     5195                 End.
     5196             When 3 then DO:
     5197                 t-str = ''.
     5198                 t-str = " По производителям " .
     5199                  my-c = 0.
     5200                   for each g#cli no-lock:
     5201                       if LENGTH(t-str) <= 6000 then t-str = t-str + chr(10) + "     " + g#cli.obj-name .
     5202                       my-c =  my-c + 1 .
     5203                   End.
     5204                   if my-c > 0 THEN
     5205                      goods-count = "выбрано " + String(my-c) .
     5206                      ELSE goods-count = "НЕ выбрано !!!".
     5207                 END.
     5208             When 4 then DO:
     5209                           if can-find (first gds-list no-lock ) then DO:
     5210                               t-str = " По списку товаров " +  s-Notes.
     5211                               goods-count = "выбрано " + String(lns-cnt) .
     5212                               End.
     5213                            Else Assign goods-count = "НЕ выбрано !!!" t-str = "" lns-cnt = 0 .
     5214                          End.
     5215             When  6  then DO:
     5216                 if  keep-spis <> "" then DO:
     5217                     t-str = s-Notes.
     5218                     goods-count = "выбрано списков : " + String(lns-cnt) .
     5219                     End.
     5220                   Else Assign goods-count = "НЕ выбрано !!!" t-str = "" lns-cnt = 0 .
     5221                 End.
     5222             When 5 then DO:
     5223                     find first gds-list no-lock no-error.
     5224                      if available gds-list THEN  Assign t-str = " " +  gds-list.gds-name goods-count = "выбран 1 товар".
     5225                                             ELSE Assign t-str = "" goods-count = "НЕ выбрано !!!" lns-cnt = 0 .
     5226                    END.
     5227             When 7 then DO:
     5228                 t-str = " По группам "  .
     5229                           For each  tmp#grp :
     5230                                delete tmp#grp.
     5231                           End.
     5232                           Repeat v-ind = 1 To num-entries( gdsgrp_recids ):
     5233                               find first buf_gds-grp WHERE recid ( buf_gds-grp ) = integer ( Entry(v-ind,gdsgrp_recids )) NO-LOCK.
     5234                                 run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output Grp_Name ).
     5235                                   if Grp_Name <> ? Then if LENGTH(t-str) <= 6000 then t-str = t-str + chr(10) + "     " + Grp_Name .
     5236                                   Create tmp#grp.
     5237                                   Assign tmp#grp.node-code = buf_gds-grp.node-code
     5238                                          tmp#grp.grp-name = Grp_Name
     5239                                          tmp#grp.is-term = buf_gds-grp.is-term
     5240                                          tmp#grp.lvl-num = buf_gds-grp.lvl-num
     5241                                          .
     5242                               end.
     5243                 t-str = t-str + chr(10) +  " По производителям " .
     5244                  my-c = 0.
     5245                   for each g#cli no-lock:
     5246                       t-str = t-str + chr(10) + "     " + g#cli.obj-name no-error .
     5247                       my-c =  my-c + 1 .
     5248                   End.
     5249                   if num-entries( gdsgrp_recids ) > 0  and my-c > 0 THEN DO:
     5250                      goods-count = "выбрано " + string(num-entries( gdsgrp_recids )) + " групп "
     5251                        + string(my-c) + " производителей " .
     5252                      End.
     5253                      ELSE goods-count = "НЕ выбрано !!!".
     5254                 End.
     5255           End case.
     5256    END.
     5257   END PROCEDURE.
     5258   PROCEDURE select-keep-spis :
     5259   define input  parameter p-keep-spis as character no-undo .
     5260   define buffer buf_clob-bind for ub.clob-bind  .
     5261   keep-spis = p-keep-spis.
     5262   find first buf_clob-bind no-lock where
     5263             buf_clob-bind.field-name_ = keep-spis no-error .
     5264     if available buf_clob-bind then do:
     5265       keep-spis = buf_clob-bind.field-name_ .
     5266       lns-cnt = 1 .
     5267       s-notes = substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name, buf_clob-bind.descr ).
     5268     end.
     5269     else do:
     5270       keep-spis = "".
     5271       lns-cnt = 0 .
     5272       s-notes = " " .
     5273     end.
     5274     run display-count       in this-procedure .
     5275     run display-count-other in this-procedure .
     5276     selectgood    = 6 .
     5277     x-selectgood  = 6 .
     5278     run val-goods in this-procedure .
     5279   END PROCEDURE.
     5280   PROCEDURE select-objects-proc :
     5281     define variable v-ii as integer   no-undo .
     5282     def buffer cli-obj  for ub.clients .
     5283   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5284   for each obj-list :
     5285    delete obj-list.
     5286   end.
     5287   str-obj#  = "" .
     5288   str-obj2# = "" .
     5289   str-obj3# = "" .
     5290   case selectobject :
     5291   when "currency":U then do:
     5292    run verify-check.
     5293   end.
     5294   when 'все':U then   do:
     5295    run sss.
     5296   end.
     5297   when "all" then   do:
     5298    run sss.
     5299   end.
     5300   when "firm":U then   do:
     5301    run sss.
     5302   end.
     5303   when "choice":U then do:
     5304     for each obj-list :
     5305         delete obj-list.
     5306     end.
     5307     define variable v-object-exist as logical   no-undo .
     5308   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5309   run userobjs_object-exist in this-procedure
     5310     (output v-object-exist
     5311     )  .
     5312     if not params-only and v-object-exist = false then do:
     5313   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5314   run userobjs_append in this-procedure
     5315     (input  v-cntxt-obj-type
     5316     ,input  v-cntxt-obj-code
     5317     )  .
     5318        v-object-exist = true .
     5319     end.
     5320     if my-request     = false
     5321     or v-object-exist = false
     5322     then do:
     5323       define variable v-user-select as logical   no-undo .
     5324       define variable v-recids as character no-undo .
     5325       if params-only then do:
     5326       run ref/thobjs.w
     5327           ( input my-handle
     5328           , input this-procedure:handle
     5329           , input (if params-only-mode = 'ПРОСМОТР':U then "b-mark-hidden" else "b-mark,b-sel")
     5330           , input 'все':U
     5331           , input ''
     5332           , input ?
     5333           , input ?
     5334           , input-output v-recids ) no-error .
     5335        end.
     5336        else do:
     5337   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5338   run userobjs_select-many in this-procedure
     5339     (input  my-handle
     5340     ,input  v-cntxt-db-num
     5341     ,input  v-cntxt-userid
     5342     ,input  v-cntxt-host-code-obj
     5343     ,input  v-cntxt-obj-type
     5344     ,input  v-cntxt-obj-code
     5345     ,output v-user-select
     5346     )  .
     5347        end.
     5348     end.
     5349     my-request = true .
     5350   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5351   run userobjs_object-exist in this-procedure
     5352     (output v-object-exist
     5353     )  .
     5354     if v-object-exist = false
     5355     then do:
     5356       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u then do:
     5357         assign selectobject = "firm":U .
     5358       end.
     5359       else do:
     5360         assign selectobject =  "currency":u .
     5361       end.
     5362       display selectobject with frame F-Main .
     5363       disable button-obj   with frame F-Main .
     5364       find cli-obj where cli-obj.obj-type = v-cntxt-obj-type and
     5365                           cli-obj.obj-code = v-cntxt-obj-code no-lock .
     5366       if temp-param-obj-type = 'shop':u or temp-param-obj-type = 'stock':u
     5367       then do:
     5368         run sss.
     5369       end.
     5370       else do:
     5371         run verify-check.
     5372       end.
     5373     end.
     5374     else do:
     5375         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     5376         define buffer buf_clients for ub.clients .
     5377         define buffer buf_db for ub.db .
     5378         define buffer buf_shop for ub.shop .
     5379         define buffer buf_store for ub.store .
     5380         define buffer buf_sysconf for ub.sysconf .
     5381         for each buf_userobjs_temp-user-obj
     5382         :
     5383           find first buf_clients no-lock
     5384             where buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     5385               and buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     5386             .
     5387             if verify-send-check  and buf_clients.db-num <> v-cntxt-db-num  and v-all-object = false then do:
     5388                   find first buf_db where buf_db.db-num = buf_clients.db-num no-lock.
     5389                   if buf_db.send-check = false then do:
     5390                     str-obj2# = str-obj2#  + " " + buf_clients.obj-name + ",".
     5391                     next.
     5392                   end.
     5393             end.
     5394             if temp-param-obj-type = 'shop':u and v-all-object = false then do:
     5395                 if buf_userobjs_temp-user-obj.obj-type = 'скл':U then do:
     5396                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     5397                     next.
     5398                   end.
     5399             end.
     5400             if temp-param-obj-type = 'stock':u and v-all-object = false then do:
     5401                 if buf_userobjs_temp-user-obj.obj-type = 'маг':U then do:
     5402                     str-obj# = str-obj#  +  " " +  buf_clients.obj-name  .
     5403                     next.
     5404                 end.
     5405             end.
     5406             case buf_userobjs_temp-user-obj.obj-type:
     5407                 when 'скл':U then
     5408                     do:
     5409                         find buf_store where buf_store.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     5410                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_store.host-code no-error.
     5411                         find first buf_clients no-lock where
     5412                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     5413                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     5414                             .
     5415                         if buf_sysconf.base-code = base-code or v-all-object = true
     5416                             then do:
     5417   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5418   run create_obj-list in this-procedure
     5419    ( input buf_userobjs_temp-user-obj.obj-type ,
     5420      input buf_userobjs_temp-user-obj.obj-code )
     5421      .
     5422                             end.
     5423                             else do:
     5424                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     5425                             end.
     5426                     end.
     5427                 when 'маг':U then
     5428                     do:
     5429                         find first buf_shop where buf_shop.obj-code = buf_userobjs_temp-user-obj.obj-code no-lock.
     5430                         find first buf_sysconf no-lock where buf_sysconf.host-code = buf_shop.host-code no-error.
     5431                         find first buf_clients no-lock where
     5432                                     buf_clients.obj-type = buf_userobjs_temp-user-obj.obj-type and
     5433                                     buf_clients.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
     5434                         if buf_sysconf.base-code = base-code or v-all-object = true
     5435                               then do:
     5436   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5437   run create_obj-list in this-procedure
     5438    ( input buf_userobjs_temp-user-obj.obj-type ,
     5439      input buf_userobjs_temp-user-obj.obj-code )
     5440      .
     5441                             end.
     5442                             else do:
     5443                               str-obj# = str-obj#  +  " " +  buf_clients.obj-name + "," .
     5444                             end.
     5445                     end.
     5446             end case.
     5447           end.
     5448       end.
     5449   end.
     5450   end case.
     5451   END PROCEDURE.
     5452   PROCEDURE select-radio-period :
     5453   define input  parameter p-radio-period as character no-undo .
     5454     radio-period = p-radio-period .
     5455   display radio-period with frame F-Main .
     5456   END PROCEDURE.
     5457   PROCEDURE select-Radio-schet :
     5458    do
     5459    on error undo, return error return-value
     5460    :
     5461   define buffer buf_fin-schet for ub.fin-schet.
     5462   assign frame F-Main
     5463     RADIO-schet
     5464   .
     5465   lkp-schet = temp-param-schet + " по : " +
     5466               radio-label(string(RADIO-schet  ) , radio-schet:radio-buttons)
     5467               .
     5468   define variable v-iii as integer no-undo .
     5469   case radio-schet :
     5470       when 3 then do:
     5471         enable button-schet with frame F-Main .
     5472         disable button-schet-one button-schet-val with frame F-Main .
     5473         apply "CHOOSE" to button-schet IN  frame F-Main .
     5474         lkp-schet = lkp-schet + chr(10)  .
     5475             repeat v-iii = 1 to num-entries(schet-list) :
     5476               find first buf_fin-schet no-lock where    recid(buf_fin-schet) = integer (entry(v-iii,schet-list))   no-error .
     5477               if available buf_fin-schet then
     5478                   lkp-schet = lkp-schet  + string( buf_fin-schet.code-schet) + ", ".
     5479             end.
     5480       end.
     5481       when 4 then do:
     5482         enable button-schet-one with frame F-Main .
     5483         disable button-schet button-schet-val with frame F-Main .
     5484         apply "CHOOSE" to button-schet-one IN  frame F-Main .
     5485       end.
     5486       when 7 then do:
     5487         enable button-schet-val with frame F-Main .
     5488         disable button-schet-one button-schet with frame F-Main .
     5489         apply "CHOOSE" to button-schet-val IN  frame F-Main .
     5490       end.
     5491       otherwise do:
     5492       if button-schet-val:visible then  disable button-schet-val with frame F-Main .
     5493       if button-schet-one:visible then  disable button-schet-one with frame F-Main .
     5494       if button-schet    :visible then  disable button-schet with frame F-Main .
     5495       end.
     5496   end case.
     5497   display lkp-schet with frame F-Main .
     5498   run new-state("RADIO-SCHET="  + string(Radio-schet)) .
     5499   case radio-schet:
     5500     when 1
     5501     or
     5502     when 2
     5503     or
     5504     when 3
     5505     or
     5506     when 6
     5507     or
     5508     when 4
     5509     then do:
     5510       if ref_date-start <> '':u
     5511       and entry(2, ref_date-start, chr(4)) = "finsttms":U then do:
     5512         entry(3, ref_date-start, chr(4)) = "ext-type-stat-start".
     5513         entry(4, ref_date-start, chr(4)) = "".
     5514       end.
     5515       if ref_date-end <> '':u
     5516       and entry(2, ref_date-end, chr(4)) = "finsttms":U then do:
     5517         entry(3, ref_date-end, chr(4)) = "ext-type-stat-end".
     5518         entry(4, ref_date-end, chr(4)) = "".
     5519       end.
     5520       if ref_date-alone <> '':u
     5521       and entry(2, ref_date-alone, chr(4)) = "finsttms":U then do:
     5522         entry(3, ref_date-alone, chr(4)) = "ext-type-stat-start".
     5523         entry(4, ref_date-alone, chr(4)) = "".
     5524       end.
     5525     end.
     5526     when 4
     5527     then do:
     5528     end.
     5529     when 5
     5530     or when 7
     5531     then do:
     5532       if ref_date-start <> '':u
     5533       and entry(2, ref_date-start, chr(4)) = "finsttms":U then do:
     5534         entry(3, ref_date-start, chr(4)) = "currency-start".
     5535         if radio-schet = 5 then  do:
     5536           entry(4, ref_date-start, chr(4)) = "0".
     5537         end.
     5538         else do:
     5539           entry(4, ref_date-start, chr(4)) = entry(2, schet-list, "=").
     5540         end.
     5541       end.
     5542       if ref_date-end <> '':u
     5543       and entry(2, ref_date-end, chr(4)) = "finsttms":U then do:
     5544         entry(3, ref_date-end, chr(4)) = "currency-end".
     5545         if radio-schet = 5 then  do:
     5546           entry(4, ref_date-end, chr(4)) = "0".
     5547         end.
     5548         else do:
     5549           entry(4, ref_date-end, chr(4)) = entry(2, schet-list, "=").
     5550         end.
     5551       end.
     5552       if ref_date-alone <> '':u
     5553       and entry(2, ref_date-alone, chr(4)) = "finsttms":U then do:
     5554         entry(3, ref_date-alone, chr(4)) = "currency-end1".
     5555         if radio-schet = 5 then  do:
     5556           entry(4, ref_date-alone, chr(4)) = "0".
     5557         end.
     5558         else do:
     5559           entry(4, ref_date-alone, chr(4)) = entry(2, schet-list, "=").
     5560         end.
     5561       end.
     5562     end.
     5563   end case.
     5564   end.
     5565   END PROCEDURE.
     5566   PROCEDURE select-radio-schet-no-apply :
     5567    do
     5568    on error undo, return error return-value
     5569    :
     5570   define buffer buf_fin-schet for ub.fin-schet.
     5571   assign frame F-Main
     5572     RADIO-schet
     5573   .
     5574   lkp-schet = temp-param-schet + " по : " +
     5575               radio-label(string(RADIO-schet  ) , radio-schet:radio-buttons)
     5576               .
     5577   define variable v-iii as integer no-undo .
     5578       case radio-schet :
     5579          when 3 then do:
     5580             enable button-schet with frame F-Main .
     5581             disable button-schet-one button-schet-val with frame F-Main .
     5582          end.
     5583          when 4 then do:
     5584             enable button-schet-one with frame F-Main .
     5585             disable button-schet button-schet-val with frame F-Main .
     5586          end.
     5587          when 7 then do:
     5588             enable button-schet-val with frame F-Main .
     5589             disable button-schet-one button-schet with frame F-Main .
     5590          end.
     5591          otherwise do:
     5592           if button-schet-val:visible then  disable button-schet-val with frame F-Main .
     5593           if button-schet-one:visible then  disable button-schet-one with frame F-Main .
     5594           if button-schet    :visible then  disable button-schet with frame F-Main .
