     3998       assign
     3999         v-curr-sv-date = date(self :screen-value) no-error
     4000       .
     4001       if v-curr-sv-date = ?
     4002       then do:
     4003         run gbl/getcurdt.p
     4004           (output v-curr-sv-date
     4005           ) .
     4006       end.
     4007       if v-curr-sv-date <> ?
     4008       then do:
     4009         assign
     4010           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     4011         .
     4012         assign
     4013           self :screen-value = string(v-new-sv-date) .
     4014         .
     4015       end.
     4016     end.
     4017     return no-apply .
     4018   end.
     4019   on ctrl-e of date-Start in frame F-Main
     4020   do:
     4021     if (can-query (self, "sensitive")
