      570   function diff-list returns character (
      571     input parfirst-list  as character,
      572     input parsecond-list as character,
      573     input pardelim       as character).
      574     if pardelim = ""
      575     or pardelim = ?
      576     then do:
      577       assign
      578         pardelim = ","
      579       .
      580     end.
      581     def var ind as integer no-undo .
      582     def var v-elem as character no-undo .
      583     def var v-result-list as character no-undo init "".
      584     def var v-num-parfirst-list as integer no-undo .
      585     assign
      586       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      587     .
      588     do ind = 1 to v-num-parfirst-list
      589     :
      590       assign
      591         v-elem = entry(ind, parfirst-list, pardelim)
      592       .
      593       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      594         assign
      595           v-result-list = v-result-list
      596                         + (if v-result-list > "" then pardelim else "")
      597                         + v-elem
      598         .
      599       end.
      600     end.
      601     return v-result-list .
      602   end function.
      603   function add-list returns character (
      604    input parfirst-list  as character,
      605    input parsecond-list as character,
      606    input pardelim       as character).
      607     if pardelim = ""
      608     or pardelim = ?
      609     then do:
      610       assign
      611         pardelim = ","
      612       .
      613     end.
      614     def var ind as integer no-undo .
      615     def var v-elem as character no-undo .
      616     def var v-result-list as character no-undo init "".
      617     def var v-num-parfirst-list as integer no-undo .
      618     assign
      619       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      620     .
      621     do ind = 1 to v-num-parfirst-list
      622     :
      623       assign
      624         v-elem = entry(ind, parfirst-list, pardelim)
      625       .
      626       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      627         assign
      628           v-result-list = v-result-list
      629                         + (if v-result-list > "" then pardelim else "")
      630                         + v-elem
      631         .
      632       end.
      633     end.
      634     def var v-num-parsecond-list as integer no-undo .
      635     assign
      636       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      637     .
      638     do ind = 1 to v-num-parsecond-list
      639     :
      640       assign
      641         v-elem = entry(ind, parsecond-list, pardelim)
      642       .
      643       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      644         assign
      645           v-result-list = v-result-list
      646                         + (if v-result-list > "" then pardelim else "")
      647                         + v-elem
      648         .
      649       end.
      650     end.
      651     return v-result-list .
      652   end function.
      653   function cross-list returns character (
      654    input parfirst-list  as character,
      655    input parsecond-list as character,
      656    input pardelim       as character).
      657     if pardelim = ""
      658     or pardelim = ?
      659     then do:
      660       assign
      661         pardelim = ","
      662       .
      663     end.
      664     def var ind as integer no-undo .
      665     def var v-elem as character no-undo .
      666     def var v-result-list as character no-undo init "".
      667     def var v-num-parfirst-list as integer no-undo .
      668     assign
      669       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      670     .
      671     do ind = 1 to v-num-parfirst-list
      672     :
      673       assign
      674         v-elem = entry(ind, parfirst-list, pardelim)
      675       .
      676       if lookup(v-elem, v-result-list, pardelim) = 0
      677       and lookup(v-elem, parsecond-list, pardelim) > 0
      678       then do:
      679         assign
      680           v-result-list = v-result-list
      681                         + (if v-result-list > "" then pardelim else "")
      682                         + v-elem
      683         .
      684       end.
      685     end.
      686     return v-result-list .
      687   end function.
      688   function radio-label returns character (
      689    input par-rs-value  as character,
      690    input par-rs-radio-buttons as character)
      691    .
      692    DEFINE variable v-result-label as character no-undo.
      693    assign
      694    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      695                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      696                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      697                             ), par-rs-radio-buttons
      698                           )
      699    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      700    .
      701   return v-result-label.
      702   end function.
      703   function m-radio-label returns character (
      704    input par-rs-value  as character,
      705    input par-rs-radio-buttons as character,
      706    input par-delim as character
      707    )
      708    .
      709    DEFINE variable v-result-label as character no-undo.
      710    assign
      711    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      712                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      713                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      714                             ), par-rs-radio-buttons, par-delim
      715                           )
      716    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      717    .
      718   return v-result-label.
      719   end function.
      720   FUNCTION mixlist returns character
      721   (
      722    input parfirst-list  as character
      723    ,input parsecond-list as character
      724    ,input pardelim       as character
      725    ,input pardelim-result as character ) :
      726     if pardelim = ""
      727     or pardelim = ?
      728     then do:
      729       assign
      730         pardelim = ","
      731       .
      732     end.
      733     def var ind as integer no-undo .
      734     def var v-elem1 as character no-undo .
      735     def var v-elem2 as character no-undo .
      736     def var v-result-list as character no-undo init "".
      737     do ind = 1 to num-entries(parfirst-list, pardelim)
      738     :
      739       assign
      740         v-elem1 = entry(ind, parfirst-list, pardelim)
      741         v-elem2 = entry(ind, parsecond-list, pardelim)
      742       .
      743         assign
      744           v-result-list = v-result-list
      745                         + (if v-result-list > "" then pardelim-result else "")
      746                         + v-elem1 + pardelim-result + v-elem2
      747         .
      748     end.
      749     return v-result-list .
      750   END FUNCTION.
      751   define variable vss-include-info7 as character format "X(65)" no-undo
      752   initial "@(#)$Workfile$ $Revision$".
      753   procedure grplib-get-full-name :
      754      define input parameter p-node-code  as integer      no-undo.
      755      define output parameter p-full-name as character    no-undo.
      756      do
      757   on error undo, return error
      758   :
      759       define variable v-upper-code    as integer           no-undo.
      760       define buffer buf_gds-grp       for ub.gds-grp.
      761       define buffer buf_upper_gds-grp for ub.gds-grp.
      762       find first buf_gds-grp no-lock
      763            where buf_gds-grp.node-code = p-node-code
      764       no-error.
      765       if not available buf_gds-grp
      766       then do:
      767           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      768       end.
      769       assign
      770           p-full-name  = ""
      771           v-upper-code = 1
      772       .
      773       do while buf_gds-grp.upper-code <> 0
      774       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      775       :
      776           assign
      777               p-full-name  = buf_gds-grp.node-name
      778                            + (if p-full-name <> "" then chr(47) else "")
      779                            + p-full-name
      780               v-upper-code = buf_gds-grp.upper-code
      781           .
      782           find first buf_gds-grp no-lock
      783                where buf_gds-grp.node-code = v-upper-code
      784           no-error.
      785           if not available buf_gds-grp
      786           then do:
      787               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      788                                   + string( v-upper-code )
      789                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      790           end.
      791       end.
      792       assign
      793       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      794       .
      795   end.
      796   end .
      797   procedure grplib-get-node-from-full-name :
      798   define input parameter p-full-name as character no-undo .
      799   define output parameter p-node-code as integer no-undo .
      800   define variable v-ii as integer no-undo .
      801   define variable v-upper-code as integer no-undo .
      802   define variable v-root-code as integer no-undo .
      803   define variable v-entry as character no-undo .
      804   define buffer buf_gds-grp       for ub.gds-grp.
      805   do
      806   on error undo, return error
      807   :
      808     find first buf_gds-grp no-lock
      809         where buf_gds-grp.upper-code = 0
      810     no-error .
      811     if not available buf_gds-grp
      812     then do:
      813         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      814     end.
      815     else do:
      816       assign
      817       v-root-code = buf_gds-grp.node-code
      818       .
      819     end.
      820     v-upper-code = v-root-code.
      821     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      822       assign
      823       v-entry = entry(v-ii, p-full-name, chr(47)).
      824       if v-entry = '' then leave.
      825       find first buf_gds-grp no-lock where
      826                 buf_gds-grp.node-name = v-entry
      827             and buf_gds-grp.upper-code = v-upper-code
      828             no-error.
      829       if not available buf_gds-grp then do:
      830         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      831       end.
      832       else do:
      833         p-node-code = buf_gds-grp.node-code.
      834         v-upper-code = buf_gds-grp.node-code.
      835       end.
      836     end.
      837   end.
      838   end .
