     3477        and
     3478        self :sensitive = true
     3479        )
     3480     or (can-query (self, "read-only")
     3481        and
     3482        self :read-only = false
     3483        )
     3484     then do:
     3485       assign
     3486         self :screen-value = ?
     3487       .
     3488     end.
     3489     return no-apply.
     3490   end.
     3491   on delete-character of date-Alone in frame F-Main
     3492   do:
     3493     if (can-query (self, "sensitive")
     3494        and
     3495        self :sensitive = true
     3496        )
