     1856   define shared variable s-notes   as character no-undo .
     1857   define variable proba1 as integer no-undo .
     1858   define variable list-mode                 as character no-undo .
     1859   define variable doc-mode                  as character no-undo .
     1860   define variable doc-rec                   as recid     no-undo .
     1861   define variable line-rec                  as recid     no-undo .
     1862   define variable gds-rec                   as recid     no-undo .
     1863   define variable prt-rec                   as recid     no-undo .
     1864   define variable line-mode                 as character no-undo .
     1865   define variable v-ok                      as logical   no-undo .
     1866   define variable state-source              as widget-handle no-undo .
     1867   define variable temp-str                  as character no-undo .
     1868   define variable temp-param-date           as integer   no-undo .
     1869   define variable temp-param-date-type-period  as character no-undo .
     1870   define variable temp-param-goods          as character no-undo .
     1871   define variable temp-param-obj            as character no-undo .
     1872   define variable temp-param-Pay            as character no-undo .
     1873   define variable temp-param-Pay-hide       as character no-undo .
     1874   define variable temp-param-obj-type       as character no-undo .
     1875   define variable temp-param-alon           as logical   no-undo .
     1876   define variable temp-param-customer       as character no-undo .
     1877   define variable temp-param-customer-type  as character no-undo .
     1878   define variable temp-param-schet          as character no-undo .
     1879   define variable temp-param-schet-hide     as character no-undo .
     1880   define variable temp-param-schet-init     as character no-undo .
     1881   define variable temp-param-schet-mode     as character no-undo .
     1882   define variable v-all-object              as logical   no-undo .
     1883   define variable t-str                     as character no-undo .
     1884   define variable str-obj#                  as character no-undo .
     1885   define variable str-obj2#                 as character no-undo .
     1886   define variable str-obj3#                 as character no-undo .
     1887   define variable v-curr-code               as integer   no-undo .
     1888   define variable schet-list                as character no-undo .
     1889   define variable init-shet-init            as character no-undo .
     1890   define variable v-curr-abbr               as character no-undo .
     1891   define variable mi-ed_date-alone-handle   as handle    no-undo .
     1892   define variable mi-ed_date-start-handle   as handle    no-undo .
     1893   define variable mi-ed_date-end-handle     as handle    no-undo .
     1894   define variable menu-ed_date-alone-handle   as handle    no-undo .
     1895   define variable menu-ed_date-start-handle   as handle    no-undo .
     1896   define variable menu-ed_date-end-handle     as handle    no-undo .
     1897   define variable keep-spis as character no-undo .
     1898   define variable choose-shift as logical no-undo init no .
     1899   define variable temp-param-goods-choose as character no-undo .
