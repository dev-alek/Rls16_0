     3516        and
     3517        self :read-only = false
     3518        )
     3519     then do:
     3520       if self :handle <> focus :handle
     3521       then do:
     3522         apply "entry":u to self .
     3523       end.
     3524       run gbl/getcurdt.p
     3525         (output v-curr-sv-date
     3526         ) .
