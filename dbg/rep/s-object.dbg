     2225        text-5 AT ROW 5.76 COL 59.4 COLON-ALIGNED NO-LABEL
     2226        TEXT-1 AT ROW 5.81 COL 39.6 COLON-ALIGNED NO-LABEL
     2227        Obj-count AT ROW 9.24 COL 34.6 COLON-ALIGNED NO-LABEL
     2228        text-6 AT ROW 10.24 COL 35 COLON-ALIGNED NO-LABEL
     2229        Goods-count AT ROW 12.91 COL 1 NO-LABEL
     2230        RECT-1 AT ROW 1 COL 1
     2231        RECT-2 AT ROW 1 COL 60.8
     2232        RECT-3 AT ROW 5.52 COL 35.2
     2233        RECT-4 AT ROW 5.52 COL 1
     2234        RECT-7 AT ROW 5.52 COL 61
     2235        RECT-node AT ROW 11.05 COL 4.2
     2236        RECT-node-2 AT ROW 11.05 COL 8.6
     2237       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     2238            SIDE-LABELS NO-UNDERLINE THREE-D
     2239            AT COL 1 ROW 1 SCROLLABLE
     2240            BGCOLOR 8 FGCOLOR 0 .
     2241   FUNCTION stat-line RETURNS CHARACTER
     2242     (input p-status-chr as character )  FORWARD.
     2243   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     2244   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     2245   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     2246   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     2247   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     2248   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     2249   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     2250   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     2251         adm-object-hdl = FRAME F-Main:HANDLE.
     2252   RUN ensure-broker.
     2253   THIS-PROCEDURE:ADM-DATA =
     2254        'ADM1.1~`':U +
     2255        'SmartObject~`':U +
     2256        '~`':U +
     2257        'NO ~`':U +
     2258        '~`':U +
     2259        '~`':U +
     2260        '~`':U +
     2261        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     2262           + "~`":U +
     2263        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     2264        'Record-Source,Record-Target,TableIO-Target~`':U +
     2265        '~`':U +
     2266        '~`~`~`~`~`~`~`~`~`~`~`':U +
     2267        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     2268            THEN "^^":U
     2269        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     2270             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     2271   PROCEDURE adm-apply-entry :
     2272     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2273   END PROCEDURE.
     2274   PROCEDURE adm-destroy :
     2275    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2276   END PROCEDURE.
     2277   PROCEDURE adm-disable :
     2278       DISABLE RECT-1 RECT-2 RECT-3 RECT-4 RECT-7 RECT-node RECT-node-2 Radio-Period TOG-Shift SET_PAY_TYPE Date-Alone TOG-Shift-2 ShowCrsa RADIO-task ShowCost Shift-Alone BUTTON-shift Shift-Start BUTTON-Shift-Start Shift-End BUTTON-Shift-end ShowSale Date-Start Date-End SET_val_TYPE SelectGood SelectObject Radio-customer BUTTON-node customer-name BUTTON-obj BUTTON-prod BUTTON-gds BUTTON-one BUTTON-keep-spis Radio-schet BUTTON-node-2 BUTTON-prod-2 Goods-Editor lkp-schet TOG-Excel TOG-list-hist TEXT-3 TEXT-4 TEXT-2 text-5 TEXT-1 Obj-count text-6 Goods-count WITH FRAME F-Main.
     2279       RUN dispatch ('disable-fields':U).
     2280       RUN set-attribute-list ('ENABLED=no':U).
     2281       RETURN.
     2282   END PROCEDURE.
     2283   PROCEDURE adm-edit-attribute-list :
     2284         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     2285         RETURN.
     2286   END PROCEDURE.
     2287   PROCEDURE adm-enable :
     2288       ENABLE UNLESS-HIDDEN RECT-1 RECT-2 RECT-3 RECT-4 RECT-7 RECT-node RECT-node-2 Radio-Period TOG-Shift SET_PAY_TYPE Date-Alone TOG-Shift-2 ShowCrsa RADIO-task ShowCost Shift-Alone BUTTON-shift Shift-Start BUTTON-Shift-Start Shift-End BUTTON-Shift-end ShowSale Date-Start Date-End SET_val_TYPE SelectGood SelectObject Radio-customer BUTTON-node customer-name BUTTON-obj BUTTON-prod BUTTON-gds BUTTON-one BUTTON-keep-spis Radio-schet BUTTON-node-2 BUTTON-prod-2 Goods-Editor lkp-schet TOG-Excel TOG-list-hist TEXT-3 TEXT-4 TEXT-2 text-5 TEXT-1 Obj-count text-6 Goods-count WITH FRAME F-Main.
     2289       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     2290       RUN set-attribute-list ('ENABLED=yes':U).
     2291       RETURN.
     2292   END PROCEDURE.
     2293   PROCEDURE adm-exit :
     2294        RUN notify ('exit':U).
     2295     RETURN.
     2296   END PROCEDURE.
     2297   PROCEDURE adm-hide :
     2298     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2299   END PROCEDURE.
     2300   PROCEDURE adm-initialize :
     2301     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2302   END PROCEDURE.
     2303   PROCEDURE adm-show-errors :
     2304       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     2305       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2306           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     2307       END.
     2308       RETURN.
     2309   END PROCEDURE.
     2310   PROCEDURE adm-UIB-mode :
     2311     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2312   END PROCEDURE.
     2313   PROCEDURE adm-view :
     2314     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2315   END PROCEDURE.
     2316   PROCEDURE dispatch :
     2317       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     2318       RUN broker-dispatch IN adm-broker-hdl
     2319           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     2320       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     2321   END PROCEDURE.
     2322   PROCEDURE ensure-broker :
     2323   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     2324   IF RETURN-VALUE NE "ADM-Broker":U THEN
     2325   DO:
     2326       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     2327       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     2328   END.
     2329   END PROCEDURE.
     2330   PROCEDURE get-attribute :
     2331     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     2332     RUN broker-get-attribute IN adm-broker-hdl
     2333         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     2334     RETURN RETURN-VALUE.
     2335   END PROCEDURE.
     2336   PROCEDURE get-attribute-list :
     2337     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     2338     RUN broker-get-attribute-list IN adm-broker-hdl
     2339         (INPUT THIS-PROCEDURE,
     2340          INPUT ?,
     2341          OUTPUT p-attr-list) NO-ERROR.
     2342     RETURN.
     2343   END PROCEDURE.
     2344   PROCEDURE new-state :
     2345     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2346     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     2347     RETURN.
     2348   END PROCEDURE.
     2349   PROCEDURE notify :
     2350     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     2351     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     2352     IF RETURN-VALUE = "ADM-ERROR":U THEN
     2353         RETURN "ADM-ERROR":U.
     2354     RETURN.
     2355   END PROCEDURE.
     2356   PROCEDURE set-attribute-list :
     2357     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     2358     RUN ensure-broker.
     2359     RUN broker-set-attribute-list IN adm-broker-hdl
     2360         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     2361     RETURN.
     2362   END PROCEDURE.
     2363   PROCEDURE set-position :
     2364       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     2365       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     2366       IF VALID-HANDLE(adm-object-hdl) THEN
     2367       DO:
     2368         ASSIGN adm-object-hdl:ROW    =   p-row
     2369                adm-object-hdl:COLUMN =   p-col.
     2370       END.
     2371       RETURN.
     2372   END PROCEDURE.
     2373   PROCEDURE adm-display-fields :
     2374       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     2375       RETURN.
     2376   END PROCEDURE.
     2377   PROCEDURE adm-open-query :
     2378     RETURN.
     2379   END PROCEDURE.
     2380   PROCEDURE adm-row-changed :
     2381         IF VALID-HANDLE(adm-object-hdl) THEN
     2382           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2383         RUN notify ('row-available':U).
     2384         RETURN.
     2385   END PROCEDURE.
     2386   PROCEDURE reposition-query :
     2387       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     2388       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     2389       RETURN.
     2390   END PROCEDURE.
     2391     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     2392     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     2393     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     2394     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     2395     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     2396     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     2397     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     2398     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     2399     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     2400     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     2401     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     2402     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     2403     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     2404     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     2405     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     2406     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     2407     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     2408     IF "":U = "":U THEN
     2409       RUN modify-list-attribute IN adm-broker-hdl
     2410         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     2411     RUN use-create-on-add(?).
     2412   PROCEDURE adm-add-record :
     2413       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     2414          "must have at least one Enabled Table to perform Add.":U
     2415          VIEW-AS ALERT-BOX ERROR.
     2416       RETURN.
     2417   END PROCEDURE.
     2418   PROCEDURE adm-assign-record :
     2419    MESSAGE
     2420          "Object ":U THIS-PROCEDURE:FILE-NAME
     2421            "must have at least one Enabled Table to perform Assign.":U
     2422              VIEW-AS ALERT-BOX ERROR.
     2423      RETURN.
     2424     END PROCEDURE.
     2425   PROCEDURE adm-assign-statement :
     2426     RETURN.
     2427   END PROCEDURE.
     2428   PROCEDURE adm-cancel-record :
     2429      RETURN.
     2430     END PROCEDURE.
     2431   PROCEDURE adm-copy-record :
     2432       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     2433        "must have at least one Enabled Table to perform Copy.":U
     2434          VIEW-AS ALERT-BOX ERROR.
     2435       RETURN.
     2436   END PROCEDURE.
     2437   PROCEDURE adm-create-record :
     2438      RETURN.
     2439   END PROCEDURE.
     2440   PROCEDURE adm-current-changed :
     2441     RETURN.
     2442   END PROCEDURE.
     2443   PROCEDURE adm-delete-record :
     2444    MESSAGE
     2445          "Object ":U THIS-PROCEDURE:FILE-NAME
     2446            "must have at least one Enabled Table to perform Delete.":U
     2447              VIEW-AS ALERT-BOX ERROR.
     2448       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     2449       RETURN.
     2450   END PROCEDURE.
     2451   PROCEDURE adm-disable-fields :
     2452         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     2453       RETURN.
     2454   END PROCEDURE.
     2455   PROCEDURE adm-enable-fields :
     2456       RETURN.
     2457   END PROCEDURE.
     2458   PROCEDURE adm-end-update :
     2459     RETURN.
     2460   END PROCEDURE.
     2461   PROCEDURE adm-reset-record :
     2462       RETURN.
     2463   END PROCEDURE.
     2464   PROCEDURE adm-update-record :
     2465       MESSAGE
     2466         "Object ":U THIS-PROCEDURE:FILE-NAME
     2467           "must have at least one Enabled Table to perform Update.":U
     2468             VIEW-AS ALERT-BOX ERROR.
     2469      RETURN.
     2470   END PROCEDURE.
     2471   PROCEDURE check-modified :
     2472   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     2473   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     2474   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     2475   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     2476     IF check-state = "check":U THEN
     2477     DO:
     2478       RUN get-link-handle IN adm-broker-hdl
     2479         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     2480            OUTPUT group-target-list).
     2481       IF group-target-list NE "":U THEN
     2482       DO i = 1 TO NUM-ENTRIES(group-target-list):
     2483         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     2484         RUN check-modified IN curr-widget ('group-check':U).
     2485         IF RETURN-VALUE NE "":U THEN
     2486         DO:
     2487           RUN check-modified-message(RETURN-VALUE).
     2488           RETURN "":U.
     2489         END.
     2490       END.
     2491     END.
     2492     RETURN "":U.
     2493   END PROCEDURE.
     2494   PROCEDURE check-modified-message :
     2495     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     2496        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     2497           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     2498        IF RETURN-VALUE = "YES":U THEN
     2499           RUN notify ('view,CONTAINER-SOURCE':U).
     2500        MESSAGE IF p-changed-table NE ? THEN
     2501           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     2502           ELSE "Current values have been changed."
     2503           SKIP "  Do you wish to save those changes?"
     2504           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     2505        IF ANS THEN
     2506        DO:
     2507           IF group-assign-target THEN
     2508             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     2509           ELSE RUN dispatch('update-record':U).
     2510           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2511           DO:
     2512               MESSAGE "Changes to the previous record were not saved."
     2513                 VIEW-AS ALERT-BOX ERROR.
     2514               IF group-assign-target THEN
     2515                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2516               ELSE RUN dispatch ('cancel-record':U).
     2517           END.
     2518        END.
     2519        ELSE DO:
     2520          IF group-assign-target THEN
     2521             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2522          ELSE RUN dispatch('cancel-record':U).
     2523        END.
     2524        RETURN.
     2525   END PROCEDURE.
     2526   PROCEDURE get-rowid :
     2527       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2528       ASSIGN
     2529       p-table   =   adm-first-table.
     2530       RETURN.
     2531   END PROCEDURE.
     2532   PROCEDURE init-group-assign :
     2533       RUN request-attribute IN adm-broker-hdl
     2534         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2535       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2536         group-assign-target = yes.
     2537       ELSE group-assign-target = no.
     2538       RETURN.
     2539   END PROCEDURE.
     2540   PROCEDURE set-editors :
     2541       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2542       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2543       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2544       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     2545       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2546       DO WHILE VALID-HANDLE (curr-widget):
     2547           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2548              curr-widget:HIDDEN = no THEN DO:
     2549             CASE p-field-setting:
     2550               WHEN "INITIALIZE":U THEN
     2551               DO:
     2552                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2553                     read-only-list +
     2554                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2555                        STRING(curr-widget).
     2556               END.
     2557               WHEN "DISABLE":U OR
     2558               WHEN "ENABLE":U THEN
     2559               DO:
     2560                   curr-widget:SENSITIVE = yes.
     2561                   RUN get-attribute ('Read-Only-Editors':U).
     2562                   IF RETURN-VALUE = ? OR
     2563                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2564                       curr-widget:READ-ONLY =
     2565                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2566               END.
     2567               WHEN "CLEAR":U THEN
     2568                   curr-widget:SCREEN-VALUE = "":U.
     2569             END CASE.
     2570           END.
     2571           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2572       END.
     2573       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2574         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2575           + '"':U).
     2576       RETURN.
     2577   END PROCEDURE.
     2578   PROCEDURE use-check-modified-all :
     2579    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2580     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2581     RETURN.
     2582   END PROCEDURE.
     2583   PROCEDURE use-create-on-add :
     2584   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2585      RETURN.
     2586   END PROCEDURE.
     2587   PROCEDURE use-initial-lock :
     2588     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2589     ASSIGN adm-initial-lock = p-attr-value.
     2590     RETURN.
     2591   END PROCEDURE.
     2592     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2593   ASSIGN
     2594          FRAME F-Main:SCROLLABLE       = FALSE
     2595          FRAME F-Main:HIDDEN           = TRUE.
     2596   ASSIGN
     2597          BUTTON-gds:HIDDEN IN FRAME F-Main           = TRUE.
     2598   ASSIGN
     2599          BUTTON-keep-spis:HIDDEN IN FRAME F-Main           = TRUE.
     2600   ASSIGN
     2601          BUTTON-node:HIDDEN IN FRAME F-Main           = TRUE.
     2602   ASSIGN
     2603          BUTTON-node-2:HIDDEN IN FRAME F-Main           = TRUE.
     2604   ASSIGN
     2605          BUTTON-one:HIDDEN IN FRAME F-Main           = TRUE.
     2606   ASSIGN
     2607          BUTTON-prod:HIDDEN IN FRAME F-Main           = TRUE.
     2608   ASSIGN
     2609          BUTTON-prod-2:HIDDEN IN FRAME F-Main           = TRUE.
     2610   ASSIGN
     2611     customer-name:READ-ONLY IN FRAME F-Main = TRUE.
     2612   ASSIGN
     2613     Goods-Editor:READ-ONLY IN FRAME F-Main = TRUE.
     2614   ASSIGN
     2615     lkp-schet:READ-ONLY IN FRAME F-Main = TRUE.
     2616   ASSIGN
     2617     ShowCost:HIDDEN IN FRAME F-Main = TRUE.
     2618   ASSIGN
     2619     ShowCrsa:HIDDEN IN FRAME F-Main = TRUE.
     2620   ASSIGN
     2621     ShowSale:HIDDEN IN FRAME F-Main = TRUE.
     2622   ON CHOOSE OF BUTTON-gds IN FRAME F-Main
     2623   DO:
     2624     define variable ref-list       as character no-undo.
     2625     define variable vRecId         as recid     no-undo.
     2626     define variable vAnswer        as logical   no-undo.
     2627     define variable vI             as integer   no-undo.
     2628     define variable v-seq          as integer   no-undo .
     2629     define variable num-rec        as integer   init 0 no-undo.
     2630     define variable v-bh           as handle    no-undo .
     2631     define variable v-recs         as integer   no-undo .
     2632     define variable v-temp-seq     as integer   no-undo .
     2633     define variable v-line         as integer   no-undo .
     2634     define variable v-item         as character no-undo .
     2635     define variable v-tot-lns      as integer   no-undo .
     2636     define variable v-ref-rec      as recid     no-undo .
     2637     define variable dsp-rs         as character no-undo .
     2638     define variable rs-status      as character no-undo init 'текущие':U.
     2639     define variable v-tbl-name     as character no-undo .
     2640     define variable rs-list-method as character no-undo init "goods".
     2641     define variable tot-lns        as integer   init ? no-undo.
     2642     define variable v-no-hist      as integer   no-undo init -1.
     2643     if not params-only then
     2644     do:
     2645       for each gds-list :
     2646         delete gds-list.
     2647       end.
     2648     end.
     2649     if temp-param-goods-choose <> "" then
     2650     do:
     2651       run ref/gds-ref.p (
     2652         input my-handle
     2653         ,input "b-mark,b-sel"
     2654         ,input 'все':U
     2655         ,input "ptrlsug"
     2656         ,input ?
     2657         ,input ?
     2658         ,input ?
     2659         ,input ?
     2660         ,input ?
     2661         ,input v-cntxt-obj-type
     2662         ,input v-cntxt-obj-code
     2663         ,input ?
     2664         ,output ref-list).
     2665       if ref-list = "" and can-find(first gds-list) then
     2666       do:
     2667         message
     2668           "Не было выбрано ни одного товара. Очистить список ранее выбранных товаров?"
     2669           view-as alert-box QUESTION buttons YES-NO update vAnswer.
     2670         if not vAnswer then return.
     2671       end.
     2672       if ref-list <> "" then
     2673       do:
     2674         v-recs = num-entries (ref-list).
     2675         do num-rec = 0 to v-recs:
     2676           if v-recs = 1 then
     2677           do:
     2678             num-rec = 1 .
     2679           end.
     2680           if num-rec > 0 then
     2681           do:
     2682             v-ref-rec = integer (entry (num-rec, ref-list)).
     2683             find goods where recid (goods) = v-ref-rec no-lock.
     2684             create gds-list .
     2685             buffer-copy goods to gds-list .
     2686           end.
     2687           if v-recs = 1 then
     2688           do:
     2689             assign
     2690               v-temp-seq = v-seq
     2691               v-line     = 0
     2692               dsp-rs     = substitute("Товар :&1 &2", goods.gds-name, stat-line(rs-status))
     2693               v-item     = '':U
     2694               v-tbl-name = 'goods':U
     2695               v-bh       = buffer goods:handle
     2696               v-tot-lns  = tot-lns
     2697               .
     2698           end.
     2699           else
     2700           do:
     2701             if num-rec = 0 then
     2702             do:
     2703               assign
     2704                 v-temp-seq = v-seq
     2705                 v-line     = 0
     2706                 dsp-rs     = substitute("Товары : &1", stat-line(rs-status))
     2707                 v-item     = '':U
     2708                 v-tbl-name = '':U
     2709                 v-bh       = ?
     2710                 v-tot-lns  = tot-lns
     2711                 .
     2712             end.
     2713             else
     2714             do:
     2715               assign
     2716                 v-temp-seq = v-seq - 1
     2717                 v-line     = num-rec
     2718                 dsp-rs     = substitute("код &1 &2 &3&4 &5", goods.gds-code, goods.artic, goods.prod-type, goods.prod-code, goods.gds-name)
     2719                 v-item     = '':U
     2720                 v-tbl-name = 'goods':U
     2721                 v-bh       = buffer goods:handle
     2722                 v-tot-lns  = tot-lns + num-rec
     2723                 .
     2724             end.
     2725           end.
     2726           v-no-hist = (if num-rec = 1 then 0 else num-rec).
     2727           run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     2728             , input-output v-temp-seq
     2729             , input v-line
     2730             , input '':U
     2731             , input dsp-rs
     2732             , input v-tot-lns
     2733             , input rs-list-method
     2734             , input rs-status
     2735             , input v-item
     2736             , input v-tbl-name
     2737             , input v-bh
     2738             ).
     2739           if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     2740         end.
     2741       end.
     2742     end.
     2743     else
     2744     do:
     2745       run str/gds-list.w ( input my-handle, input v-cntxt-host-code-obj, input v-cntxt-obj-type, input v-cntxt-obj-code ).
     2746     end.
     2747       lns-cnt = 0 .
     2748       for each gds-list :
     2749         lns-cnt = lns-cnt + 1 .
     2750       end.
     2751     define variable v-i as integer no-undo .
     2752     s-notes =  "" .
     2753       for each gds-list-hist :
     2754         v-i = v-i + 1 .
     2755         s-notes = s-notes + chr(10) + gds-list-hist.hist-mode +  gds-list-hist.des .
     2756         if v-i > 10 then
     2757         do:
     2758           s-notes = s-notes + " ... " .
     2759           leave.
     2760         end.
     2761       end.
     2762       run display-count-other in this-procedure .
     2763     END.
     2764   ON CHOOSE OF BUTTON-keep-spis IN FRAME F-Main
     2765     DO:
     2766       for each gds-list :
     2767         delete gds-list.
     2768       end.
     2769       keep-spis = "".
     2770       define buffer buf_clob-bind for ub.clob-bind  .
     2771       define variable v-rid-list as character no-undo .
     2772   run ref/clobbnds.w ( input my-handle
     2773                       ,input this-procedure:handle
     2774                       ,input 'b-sel'
     2775                       ,input "uniq-key-rec"
     2776                       ,input ""
     2777                       ,input 'list':U
     2778                       ,input 'gds-list'
     2779                       ,input -1
     2780                       ,input-output v-rid-list) no-error.
     2781     find first buf_clob-bind no-lock where
     2782               recid(buf_clob-bind) = integer(v-rid-list) no-error .
     2783     if available buf_clob-bind then do:
     2784       keep-spis = buf_clob-bind.field-name_ .
     2785       lns-cnt = 1 .
     2786       s-notes = substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name, buf_clob-bind.descr ).
     2787     end.
     2788     else do:
     2789       keep-spis = "".
     2790       lns-cnt = 0 .
     2791       s-notes = " " .
     2792     end.
     2793       run new-state ("KEEP-SPIS="  + string(keep-spis)).
     2794       run display-count in this-procedure .
     2795       run display-count-other in this-procedure .
     2796     END.
     2797   ON CHOOSE OF BUTTON-node IN FRAME F-Main
     2798   DO:
     2799     run ref/gds-grp.w
     2800      (             input my-handle
     2801                   ,input "b-sel,b-mark"
     2802                   ,input v-cntxt-obj-type
     2803                   ,input v-cntxt-obj-code
     2804                   ,input-output gdsgrp_recids ).
     2805     run display-count-other in this-procedure .
     2806   END.
     2807   ON CHOOSE OF BUTTON-node-2 IN FRAME F-Main
     2808   DO:
     2809     run ref/gds-grp.w
     2810     (              input my-handle
     2811                   ,input "b-sel,b-mark"
     2812                   ,input v-cntxt-obj-type
     2813                   ,input v-cntxt-obj-code
     2814                   ,input-output gdsgrp_recids ).
     2815     if num-entries(gdsgrp_recids) > 0
     2816            then do:
     2817               rect-node:bgcolor = 3 .
     2818            end.
     2819            else do:
     2820               rect-node:bgcolor = 8 .
     2821            end.
     2822     run display-count-other in this-procedure  .
     2823   END.
     2824   ON CHOOSE OF BUTTON-obj IN FRAME F-Main
     2825   DO:
     2826     assign SelectObject.
     2827     my-request = false .
     2828     run select-objects-proc in this-procedure .
     2829   END.
     2830   ON CHOOSE OF BUTTON-one IN FRAME F-Main
     2831   DO:
     2832     define variable ri-list         as char no-undo .
     2833     define buffer buf_goods for ub.goods .
     2834     run ref/gds-ref.p
     2835       ( my-handle
     2836         ,'b-sel'
     2837         ,?
     2838         ,?
     2839         ,?
     2840         ,?
     2841         ,?
     2842         ,?
     2843         ,?
     2844         ,v-cntxt-obj-type
     2845         ,v-cntxt-obj-code
     2846         ,?
     2847         , output ri-list) .
     2848     for each gds-list :
     2849        delete gds-list.
     2850     End.
     2851     If ri-list <> "" then DO:
     2852        find first buf_goods where recid(buf_goods) = integer (ri-list) no-lock.
     2853        buffer-copy buf_goods TO gds-list no-error.
     2854        run display-count-other in this-procedure .
     2855     End.
     2856   END.
     2857   ON CHOOSE OF BUTTON-prod IN FRAME F-Main
     2858   DO:
     2859     define variable v-ind as integer   no-undo .
     2860     define buffer cli-prod for ub.clients .
     2861     define variable cli-grp_recids as character no-undo .
     2862             FOR EACH g#cli :
     2863               delete g#cli .
     2864              END .
     2865        if SelectGood:screen-value = "3" then
     2866           do:
     2867               run ref/cli-all.w
     2868                   ( my-handle
     2869                   , "b-sel,b-mark"
     2870                   , 'про':U
     2871                   , 'все':U
     2872                   , 'текущие':U
     2873                   , ?
     2874                   , ",,,,,,NO,,"
     2875                   , ?
     2876                 , output cli-grp_recids ) no-error .
     2877                if error-status :error then
     2878                   message vss-workfile vss-revision vss-description skip
     2879                           error-status :get-message(1) skip
     2880                           "Ошибка вызова cli-all.w"
     2881                           view-as alert-box error .
     2882               if cli-grp_recids = "" then do:
     2883                    Assign goods-count = '' Goods-Editor = ''.
     2884                    Display goods-count Goods-Editor with frame F-Main .
     2885               end.
     2886               else do:
     2887                   DO v-ind = 1 TO num-entries( cli-grp_recids )
     2888                   :
     2889                       FIND cli-prod WHERE recid( cli-prod ) = int( entry(v-ind, cli-grp_recids ) ) NO-LOCK.
     2890                       create g#cli.
     2891                       assign
     2892                       g#cli.obj-type = cli-prod.obj-type
     2893                       g#cli.obj-code = cli-prod.obj-code
     2894                       g#cli.obj-name = cli-prod.obj-name.
     2895                   END.
     2896               end.
     2897           end.
     2898       else do:
     2899          FOR EACH g#cli :
     2900               delete g#cli .
     2901           END .
     2902           cli-grp_recids = "" .
     2903       end.
     2904   run display-count-other in this-procedure .
     2905   END.
     2906   ON CHOOSE OF BUTTON-prod-2 IN FRAME F-Main
     2907   DO  :
     2908     define variable v-ind as integer   no-undo .
     2909     define buffer cli-prod for ub.clients .
     2910     define variable cli-grp_recids as character no-undo .
     2911             FOR EACH g#cli :
     2912               delete g#cli .
     2913              END .
     2914        if SelectGood:screen-value = "7" then
     2915           do with frame F-Main:
     2916             run ref/cli-all.w
     2917               (  my-handle
     2918               ,  "b-sel,b-mark"
     2919               ,  'про':U
     2920               ,  'все':U
     2921               ,  'текущие':U
     2922               ,  ?
     2923               ,  ",,,,,,NO,,"
     2924               , ?
     2925               , output cli-grp_recids ) .
     2926               if cli-grp_recids = "" then do:
     2927                    Assign goods-count = '' Goods-Editor = ''.
     2928                    Display goods-count Goods-Editor with frame F-Main .
     2929               end.
     2930               else do:
     2931                   DO v-ind = 1 TO num-entries( cli-grp_recids ) :
     2932                       FIND cli-prod WHERE recid( cli-prod ) = int( entry(v-ind, cli-grp_recids ) ) NO-LOCK.
     2933                       create g#cli.
     2934                       assign
     2935                       g#cli.obj-type = cli-prod.obj-type
     2936                       g#cli.obj-code = cli-prod.obj-code
     2937                       g#cli.obj-name = cli-prod.obj-name.
     2938                   END.
     2939               end.
     2940               RECT-node-2:bgcolor = 3 .
     2941           end.
     2942       else do:
     2943          FOR EACH g#cli :
     2944               delete g#cli .
     2945           END .
     2946           cli-grp_recids = "" .
     2947           RECT-node-2:bgcolor = 8 .
     2948       end.
     2949    if not can-find (first g#cli no-lock )  then  RECT-node-2:bgcolor = 8 .
     2950   run display-count-other in this-procedure  .
     2951   END.
     2952   ON CHOOSE OF BUTTON-schet IN FRAME F-Main
     2953   DO:
     2954   define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
     2955    schet-list = "" .
     2956     assign radio-schet.
     2957          run ref/finschts.w
     2958          (   input my-handle,
     2959              input v-cntxt-host-code-obj,
     2960              input "b-mark,b-sel",
     2961              input temp-param-schet-mode,
     2962              input ?,
     2963              input ?,
     2964              input 0,
     2965              input v-cntxt-host-code-obj ,
     2966              input 0,
     2967              input-output v-status_,
     2968              input-output schet-list).
     2969         if  schet-list = "" then do:
     2970            define variable var-ll as integer no-undo .
     2971            repeat var-ll = 7 to 1 by -1 :
     2972               if lookup( string(var-ll) , temp-param-schet-hide) <> 0 then next.
     2973               radio-schet = var-ll .
     2974            end.
     2975            display RADIO-schet with frame F-Main .
     2976            run select-radio-schet-no-apply in this-procedure .
     2977        end.
     2978    fin-schet-recid =  schet-list .
     2979   END.
     2980   ON CHOOSE OF BUTTON-schet-one IN FRAME F-Main
     2981   DO:
     2982    define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
     2983    define buffer buf_fin-schet for ub.fin-schet.
     2984     schet-list          = "" .
     2985    if temp-param-schet-init <> "" and temp-param-schet-init <> ? then do:
     2986         find first buf_fin-schet no-lock where
     2987           buf_fin-schet.code-schet = integer (temp-param-schet-init) and
     2988           buf_fin-schet.host-code  = v-cntxt-host-code-obj no-error .
     2989         if available buf_fin-schet then
     2990           assign
     2991             schet-list = string(recid(buf_fin-schet))
     2992             v-status_  = buf_fin-schet.status_
     2993             .
     2994       end.
     2995       run ref/finschts.w
     2996         (   input my-handle,
     2997         input v-cntxt-host-code-obj,
     2998         input "b-sel",
     2999         input temp-param-schet-mode,
     3000         input ?,
     3001         input ?,
     3002         input 0,
     3003         input v-cntxt-host-code-obj ,
     3004         input 0,
     3005         input-output v-status_,
     3006         input-output schet-list).
     3007       fin-schet-recid =  schet-list .
     3008       if num-entries(schet-list) > 1 then
     3009       do:
     3010         message "Можно выбрать только один счет !!!" view-as alert-box .
     3011         return no-apply.
     3012       end.
     3013       find first buf_fin-schet no-lock where    recid(buf_fin-schet) = integer (schet-list)   no-error .
     3014       if not available buf_fin-schet
     3015         then
     3016       do :
     3017         define variable var-ll as integer no-undo .
     3018         repeat var-ll = 7 to 1 by -1 :
     3019           if lookup( string(var-ll) , temp-param-schet-hide) <> 0 then next.
     3020           radio-schet = var-ll .
     3021         end.
     3022       display RADIO-schet with frame F-Main .
     3023       run select-radio-schet-no-apply in this-procedure .
     3024     end.
     3025     else do:
     3026       lkp-schet = "Выбран счет  " +  string( buf_fin-schet.code-schet) .
     3027       display lkp-schet with frame F-Main .
     3028     end.
     3029     if radio-schet = 4 then do:
     3030       define variable v-code-schet as integer no-undo .
     3031       if available buf_Fin-schet then do:
     3032         assign
     3033         v-code-schet = buf_fin-schet.code-schet.
     3034       end.
     3035       if ref_date-start <> '':u
     3036       and entry(2, ref_date-start, chr(4)) = "finsttms":U then do:
     3037         entry(3, ref_date-start, chr(4)) = "code-schet-start".
     3038         entry(4, ref_date-start, chr(4)) = string(v-code-schet).
     3039       end.
     3040       if ref_date-end <> '':u
     3041       and entry(2, ref_date-end, chr(4)) = "finsttms":U then do:
     3042         entry(3, ref_date-end, chr(4)) = "code-schet-end".
     3043         entry(4, ref_date-end, chr(4)) = string(v-code-schet).
     3044       end.
     3045       if ref_date-alone <> '':u
     3046       and entry(2, ref_date-alone, chr(4)) = "finsttms":U then do:
     3047         entry(3, ref_date-alone, chr(4)) = "code-schet-end1".
     3048         entry(4, ref_date-alone, chr(4)) = string(v-code-schet).
     3049       end.
     3050     end.
     3051     END.
     3052   ON CHOOSE OF BUTTON-schet-val IN FRAME F-Main
     3053   DO:
     3054     define variable ref-rec as recid no-undo.
     3055     define buffer buf_currency for ub.currency .
     3056     v-curr-abbr =  "" .
     3057       run ref/currency.w ( my-handle, "b-sel", input-output ref-rec ).
     3058       if ref-rec = ? then
     3059       do:
     3060         define variable var-ll as integer no-undo .
     3061         repeat var-ll = 7 to 1 by -1 :
     3062           if lookup( string(var-ll) , temp-param-schet-hide) <> 0 then next.
     3063           radio-schet = var-ll .
     3064         end.
     3065         display RADIO-schet with frame F-Main .
     3066         run select-radio-schet-no-apply in this-procedure .
     3067       end.
     3068       else
     3069       do:
     3070         find currency where recid ( currency ) = ref-rec no-lock.
     3071         assign
     3072           v-curr-code = currency.curr-code
     3073           schet-list  = "curr-code=" + string(currency.curr-code)
     3074           v-curr-abbr = currency.curr-abbr
     3075           lkp-schet   = temp-param-schet + " по : " + currency.curr-abbr
     3076           .
     3077         display lkp-schet with frame F-Main .
     3078       end.
     3079     END.
     3080   ON CHOOSE OF BUTTON-shift IN FRAME F-Main
     3081   DO:
     3082     define variable v-doc-rec as recid no-undo.
     3083     define variable rec-list-2 as character no-undo.
     3084     define buffer buf_shift-obj for ub.shift-obj .
     3085     IF  SelectObject:screen-value = "currency":U then do:
     3086       find first buf_shift-obj No-LOCK WHERE
     3087                 buf_shift-obj.shift-date = date-start AND
     3088                 buf_shift-obj.shift-num = shift-alone AND
     3089                 buf_shift-obj.obj-type = v-cntxt-obj-type AND
     3090                 buf_shift-obj.obj-code = v-cntxt-obj-code No-ERROR.
     3091       if available buf_shift-obj then
     3092         rec-list-2 = string(recid(buf_shift-obj)).
     3093     end.
     3094     IF  SelectObject:screen-value = "currency":U
     3095     then do:
     3096         run str/sht-all.w
     3097         (             input my-handle
     3098                      ,input v-cntxt-obj-type
     3099                      ,input v-cntxt-obj-code
     3100                      ,input  "b-sel"
     3101                      ,input "obj":U
     3102                      ,input v-cntxt-obj-type
     3103                      ,input v-cntxt-obj-code
     3104                      ,input ReportProc
     3105                      ,input-output rec-list-2 ).
     3106     end.
     3107     Else do:
     3108         run str/sht-all.w
     3109         (             input my-handle
     3110                      ,input v-cntxt-obj-type
     3111                      ,input v-cntxt-obj-code
     3112                      ,input  "b-sel"
     3113                      ,input "all":U
     3114                      ,input '':U
     3115                      ,input 0
     3116                      ,input ReportProc
     3117                      ,input-output rec-list-2 ).
     3118       end.
     3119       find first buf_shift-obj where recid (buf_shift-obj) = integer (entry(1,rec-list-2))  no-lock no-error.
     3120       if available buf_shift-obj then DO:
     3121          Assign
     3122           date-start  = buf_shift-obj.shift-date
     3123           shift-alone = buf_shift-obj.shift-num.
     3124            enable date-start  shift-alone with frame F-Main.
     3125          Display date-start  shift-alone with frame F-Main.
     3126           apply "leave" to shift-alone .
     3127           apply "leave" to date-start .
     3128       End.
     3129    END.
     3130   ON CHOOSE OF BUTTON-Shift-end IN FRAME F-Main
     3131   DO:
     3132     define variable v-doc-rec as recid no-undo .
     3133     define variable rec-list-2      as char no-undo.
     3134     define buffer buf_shift-obj for ub.shift-obj .
     3135     IF  SelectObject:screen-value = "currency":U then do:
     3136       find first buf_shift-obj No-LOCK WHERE
     3137                 buf_shift-obj.shift-date = date-end AND
     3138                 buf_shift-obj.shift-num = shift-end AND
     3139                 buf_shift-obj.obj-type = v-cntxt-obj-type AND
     3140                 buf_shift-obj.obj-code = v-cntxt-obj-code No-ERROR.
     3141       if available buf_shift-obj then
     3142       rec-list-2 = string(recid(buf_shift-obj)).
     3143     end.
     3144     IF  SelectObject:screen-value = "currency":U
     3145     then do:
