     2608          num#str# = num#str# + 1
     2609          num#col# =  1
     2610          var-1 = num#str#
     2611          var-2 = num#col#
     2612          .
     2613          run macr_excel_char_with_format( "ИТОГО по объекту"  , num#str# , num#col#  ) .
     2614                                                                      assign  num#col# = num#col# + 5.
     2615          run macr_excel_dec( oTot-1, num#str# , num#col# ) .         assign  num#col# = num#col# + 2.
     2616          run macr_excel_dec( round(oTot-2,2), num#str# , num#col# ) .         assign  num#col# = num#col# + 1.
     2617          run macr_excel_dec( round(oTot-4,2), num#str# , num#col# ) .         assign  num#col# = num#col# + 1.
     2618          run macr_excel_dec( round(oTot-5,2), num#str# , num#col# ) .         assign  num#col# = num#col# + 2.
     2619          run macr_excel_dec( round(oTot-3,2), num#str# , num#col# ) .
     2620         run macr_cell_format
     2621             ( 10    ,
     2622               true  ,
     2623               false ,
     2624               ?     ,
     2625               var-1 ,
     2626               var-2 ,
     2627               num#str# ,
     2628               num#col#          ) .
     2629      Assign
     2630         oTot-1=0
     2631         oTot-2=0
     2632         oTot-3=0
     2633         oTot-4=0
     2634         oTot-5=0.
     2635      Run U-line.
     2636    end.
