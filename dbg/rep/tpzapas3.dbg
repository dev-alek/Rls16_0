     3433                       end.
     3434                   end.
     3435        run display-line.
     3436   if last-of(b-clients.obj-name) then do:
     3437     if  not (not show-negativ  and
     3438               ( tot-1-1 = 0 and
     3439                   tot-1-2 = 0 and
     3440                   tot-1-4 = 0 and
     3441                   tot-1-5 = 0 and
     3442                   tot-1-3 = 0 )) then do:
     3443                 if not sums-only then run u-line.
     3444                 if sums-only then do:
     3445                     if fr0 = true then do:
     3446                         run proc-prt-3 .
     3447                         fr0 = false .
     3448                       end.
     3449                  end.
     3450                 tmp#stroka = "Итого по " + (if string(entry(2,"b-clients.obj-name",".")) <> "grp-name":u then "произв." + gds-zap-prod-name else "группе " + gds-zap-grp-name).
     3451                 run proc-prt-1.
     3452           end.
     3453         end.
     3454   end.
     3455     End.
     3456           otherwise do:
     3457   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3458   for each gds-obj
     3459       where  gds-obj.obj-code   = x-store-code
     3460         and  gds-obj.obj-type   = x-store-type
     3461                                   no-lock ,
     3462       first gds-list
     3463             where gds-obj.prod-code  = gds-list.prod-code and
     3464                   gds-obj.prod-type  = gds-list.prod-type and
     3465                   gds-obj.artic      = gds-list.artic  no-lock ,
     3466       first b-clients no-lock where b-clients.obj-type = gds-list.prod-type and
     3467                                     b-clients.obj-code = gds-list.prod-code
     3468             break
     3469             by b-clients.obj-name
     3470             by gds-list.gds-name :
     3471     assign
     3472         gds-zap-unit-base  = gds-list.unit-base
     3473         gds-zap-prt-root   = gds-list.prt-root
     3474         gds-zap-prod-type  = gds-list.prod-type
     3475         gds-zap-prod-code  = gds-list.prod-code
     3476         gds-zap-artic      = gds-list.artic
     3477         gds-zap-grp-name   = gds-list.grp-name
     3478         gds-zap-b-code     = gds-list.gds-code
     3479         gds-zap-prod-name  = b-clients.obj-name
     3480         gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name else gds-list.gds-name
     3481     .
     3482         gds-zap-gds-long-name = substring(
     3483                   (if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     3484                   (if gds-list.label-name <> ? then trim(gds-list.label-name) else "" ),1,120 ) .
     3485   if Parts-Det then do :
     3486     if zap-date < today then do:
     3487       run partslib-init-temp-parts-by-factord in this-procedure( input gds-obj.obj-type, input gds-obj.obj-code, input gds-obj.artic, input gds-obj.prod-type, input gds-obj.prod-code, input v-fact-order-end, input false ) .
     3488     end.
     3489     else do:
     3490       run partslib-init-temp-parts in this-procedure( input gds-obj.obj-type, input gds-obj.obj-code, input gds-obj.artic, input gds-obj.prod-type, input gds-obj.prod-code ) .
     3491     end.
     3492   end.
     3493        run foreach.
     3494                    if not sums-only then do:
     3495                       if first-of(b-clients.obj-name) then do:
     3496                           tmp#stroka = (if string(entry(2,"b-clients.obj-name",".")) <> "grp-name" then "произв." + gds-zap-prod-name else "группа " + gds-zap-grp-name ).
     3497                           fr = true.
     3498                       end.
     3499                   end.
     3500        run display-line.
     3501   if last-of(b-clients.obj-name) then do:
     3502     if  not (not show-negativ  and
     3503               ( tot-1-1 = 0 and
     3504                   tot-1-2 = 0 and
     3505                   tot-1-4 = 0 and
     3506                   tot-1-5 = 0 and
     3507                   tot-1-3 = 0 )) then do:
     3508                 if not sums-only then run u-line.
     3509                 if sums-only then do:
     3510                     if fr0 = true then do:
     3511                         run proc-prt-3 .
     3512                         fr0 = false .
     3513                       end.
     3514                  end.
     3515                 tmp#stroka = "Итого по " + (if string(entry(2,"b-clients.obj-name",".")) <> "grp-name":u then "произв." + gds-zap-prod-name else "группе " + gds-zap-grp-name).
     3516                 run proc-prt-1.
     3517           end.
     3518         end.
     3519   end.
     3520     end.
     3521           End case.
     3522          End.
     3523      end case.
     3524    end.
     3525   END PROCEDURE.
     3526   procedure proc-prt-1 :
     3527    do
     3528    on error undo, return error return-value
     3529    :
     3530    run new-tmp-page .
     3531         DISPLAY stream  OutStream sym11 sym1 sym5 sym6 sym7 sym8 sym9 sym10
     3532                 substring(tmp#stroka,1,16)  @  gds-zap-artic
     3533                 substring(tmp#stroka,17,60)  @  gds-zap-gds-name
     3534                 Tot-1-1     @  gds-zap-qnty
     3535                 Tot-1-2     @  gds-zap-stoim-base
     3536                 Tot-1-4     @  gds-zap-Nds
     3537                 Tot-1-5     @  gds-zap-Np
     3538                 Tot-1-3     @  tot_tqnty
     3539                 with FRAME  zapas    .
     3540         DOWN stream  OutStream 1 with FRAME zapas    .
     3541         assign
     3542           num#str# = num#str# + 1
     3543           num#col# =  1
     3544           var-1 = num#str#
     3545           var-2 = num#col#
     3546         .
     3547         run macr_excel_char( tmp#stroka, num#str# , num#col# ). assign   num#col# = num#col# + 5.
     3548         run macr_excel_dec ( Tot-1-1 , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     3549         run macr_excel_dec ( round(Tot-1-2,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3550         run macr_excel_dec ( round(Tot-1-4,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3551         run macr_excel_dec ( round(Tot-1-5,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     3552         run macr_excel_dec ( round(Tot-1-3,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3553         run macr_cell_format
     3554             ( 10    ,
     3555               true  ,
     3556               true  ,
     3557               ?     ,
     3558               var-1 ,
     3559               var-2 ,
     3560               num#str# ,
     3561               num#col# ) .
     3562       IF NOT Sums-Only THEN Run U-LINE.
     3563       Assign break_group = true
     3564         Tot-1-1=0
     3565         Tot-1-2=0
     3566         Tot-1-3=0
     3567         Tot-1-4=0
     3568         Tot-1-5=0 .
     3569    end.
     3570   end procedure.
     3571   procedure proc-prt-2 :
     3572    do
     3573    on error undo, return error return-value
     3574    :
     3575   run new-tmp-page .
     3576   DISPLAY stream  OutStream sym11 sym1 sym5 sym6 sym7 sym8 sym9 sym10
     3577             substring(tmp#stroka,1,10)   @  gds-zap-b-code
     3578             substring(tmp#stroka,11,18)  @  gds-zap-artic
     3579             substring(tmp#stroka,29,60)  @  gds-zap-gds-name
     3580             Tot-2-1     @  gds-zap-qnty
     3581             Tot-2-2     @  gds-zap-stoim-base
     3582             Tot-2-4     @  gds-zap-Nds
     3583             Tot-2-5     @  gds-zap-Np
     3584             Tot-2-3     @  tot_tqnty
     3585             with FRAME  zapas    .
     3586   DOWN stream  OutStream 1 with FRAME zapas    .
     3587     assign
     3588     num#str# = num#str# + 1
     3589     num#col# =  1
     3590     var-1 = num#str#
     3591     var-2 = num#col#
     3592     .
     3593     run macr_excel_char( tmp#stroka, num#str# , num#col# ). assign   num#col# = num#col# + 5.
     3594     run macr_excel_dec ( Tot-2-1 , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     3595     run macr_excel_dec ( round(Tot-2-2,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3596     run macr_excel_dec ( round(Tot-2-4,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3597     run macr_excel_dec ( round(Tot-2-5,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     3598     run macr_excel_dec ( round(Tot-2-3,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     3599     run macr_cell_format
     3600         ( 10    ,
     3601           true  ,
     3602           true  ,
     3603           ?     ,
     3604           var-1 ,
     3605           var-2 ,
     3606           num#str# ,
     3607           num#col# ) .
     3608    end.
     3609   end procedure.
     3610   procedure proc-prt-3 :
     3611    do
     3612    on error undo, return error return-value
     3613    :
     3614     PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     3615     assign
     3616     num#str# = num#str# + 1
     3617     num#col# =  1
     3618     var-1 = num#str#
     3619     var-2 = num#col#
     3620     .
     3621     run macr_excel_char( tmp#stroka0, num#str# , num#col# ). assign   num#col# = num#col# + 5.
     3622     run macr_cell_format
     3623     ( 10    ,
     3624       true  ,
     3625       true  ,
     3626       40    ,
     3627       var-1 ,
     3628       var-2 ,
     3629       num#str# ,
     3630       num#col# ) .
     3631    end.
     3632   end procedure.
     3633   procedure new-tmp-page :
     3634    do
     3635    on error undo, return error return-value
     3636    :
     3637       if   num#str#  >= 63000 then do:
     3638           Output stream Macr_Excel  close .
     3639           run paramls-write in this-procedure
     3640             (input "file"
     3641             ,input string(v-ind)
     3642             ,input v-file-name
     3643             ) .
     3644           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     3645           output stream  Macr_Excel to value(v-file-name) .
     3646           v-ind = v-ind + 1 .
     3647           num#str# = 0 .
     3648           run proc-print-header-my.
     3649       end.
     3650    end.
     3651   end procedure.
     3652   procedure proc-print-header-my :
     3653    do
     3654    on error undo, return error return-value
     3655    :
     3656      find first sheetf .
     3657        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     3658        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     3659        var-1 =  num#str# .
     3660        repeat c-c = 1 to sheetf.excel-row-title :
     3661        num#str# = num#str# + 1 .
     3662        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     3663        do c-i = 1 to p-var :
     3664           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     3665           str--2 = integer(entry( c-i, sheetf.sizes )) .
     3666           num#col# = c-i .
     3667           run macr_excel_char( str--1  , num#str# , num#col#  ) .
     3668           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     3669        end.
     3670       c-i = 0.
     3671       end.
     3672       run macr_cell_format (
     3673           10       ,
     3674           true     ,
     3675           false    ,
     3676           35       ,
     3677           var-1 + 1,
     3678           1        ,
     3679           num#str# ,
     3680           num#col# )
     3681           .
     3682     put  stream macr_excel unformatted
     3683          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     3684           'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     3685          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     3686          .
     3687    end.
     3688   end procedure.
     3689   PROCEDURE report-execute :
     3690    do
     3691    on error undo, return error return-value
     3692    :
     3693   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3694   case x-set_pay_type :
     3695     when 1 then do:
     3696           tprintrubl = ( var-report-r-b = 'rubl':U ) .
     3697     end.
     3698     when 2 or when 3 then do:
     3699           if x-set_val_type = 1  then tprintrubl = yes .
     3700           if x-set_val_type = 2  then tprintrubl = no  .
     3701     end.
     3702   end case.
     3703       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     3704       output stream macr_excel to value(v-file-name)   .
     3705       v-ind = 1    .
     3706       num#str# = 0 .
     3707   output stream OutStream to value( string( session:temp-directory +
     3708                                        "rpt" + string( g#report-num ) ) )
     3709                                        page-size  value(ReportPageHeight) .
     3710     FORM with FRAME zapas .
     3711     Line = fill("-", 187).
     3712   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3713   form header
     3714     line format "X(187)" at 1 skip
     3715     "Продолжение - на следующей странице" at 30 skip
     3716     with frame bottomframe width 232 page-bottom no-labels no-box .
     3717   view stream outstream frame bottomframe .
     3718     FIND First ub.clients where
     3719                x-store-type = ub.clients.obj-type AND
     3720                x-store-code = ub.clients.obj-code no-lock no-error.
     3721       If available ub.clients then  ObjName = ub.clients.obj-name.
     3722                            else  ObjName="объект не определен".
     3723     Run Print-Header .
     3724         num#str# = num#str# + 1 .
     3725         num#col# =  1 .
     3726         run macr_excel_char_with_format( ReportNAme , num#str# , num#col#  ).
     3727         run macr_cell_format
     3728             ( 12    ,
     3729               true  ,
     3730               false ,
     3731               ?     ,
     3732               num#str# ,
     3733               num#col# ,
     3734               ? ,
     3735               ?         ) .
     3736   define variable l-ii  as integer no-undo .
     3737   define variable l-jj  as integer no-undo .
     3738   define variable l-len as integer no-undo .
     3739   define variable l-m   as integer no-undo .
     3740   define variable v-nn as integer   no-undo .
     3741   v-nn =  num-entries( str1 , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3742   v-nn =  num-entries( str2 , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3743   v-nn =  num-entries( str3 , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3744   v-nn =  num-entries( str4 , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3745   v-nn =  num-entries( reportheader , "chr(10)"  )   .   do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3746     num#str# = num#str# + 1.
     3747     num#col# = 1.
     3748     run macr_excel_char_with_format( string(
     3749         cur-time-print()  +
     3750         " Цены указаны в " +
     3751         (if tPrintRubl then "руб" else x-base-type )  )
     3752         , num#str#
     3753         , num#col#
     3754           ) .
     3755      Run proc-print-header-my.
     3756      For each obj-list no-lock :
     3757         x-store-type  =  obj-list.obj-type .
     3758         x-store-code  =  obj-list.obj-code .
     3759         FIND First ub.clients where x-store-type = ub.clients.obj-type AND
     3760                                  x-store-code = ub.clients.obj-code no-lock no-error.
     3761           If available ub.clients then  ObjName = ub.clients.obj-name.
     3762                                else  ObjName = "объект не определен".
     3763         PUT stream OutStream  string(  "ПО ОБЬЕКТУ : (" + x-store-type  + string(x-store-code)  +  ") " + ObjName) at 2 format "x(100)" chr(10) .
     3764          CASE RetClassify :
     3765             when "no-classify":U  then DO:
     3766               run run1 in this-procedure .
     3767               End.
     3768             when "grp-goods":U then DO:
     3769               run run2 in this-procedure .
     3770               END.
     3771             when "prod":U then DO:
     3772               run run3 in this-procedure .
     3773               End.
     3774             when "prod/grp-goods":U then DO:
     3775               end.
     3776             when "grp-goods/prod":u then do:
     3777               end.
     3778         End case.
     3779         Run Print-footer-o.
     3780     End.
     3781     HIDE stream OutStream FRAME BottomFrame .
     3782     Run Print-footer.
     3783     HIDE STREAM   OutStream   FRAME ZAPAS .
     3784     Output stream OutStream   close .
     3785     Output stream Macr_Excel  close .
     3786   if mFrameView
     3787   then do:
     3788      HIDE FRAME InfoFrame.
     3789   end.
     3790       run paramls-write in this-procedure
     3791         (input "file"
     3792         ,input string(v-ind)
     3793         ,input v-file-name
     3794         ) .
     3795       run paramls-write in this-procedure
     3796           (input "charcol"
     3797           ,input ""
     3798           ,input "2,3,4,5"
     3799           ) .
     3800     run end-proc .
     3801     define variable v-user-action as character no-undo .
     3802     define variable v-printed as logical   no-undo .
     3803     define variable DisabledOptions as integer   no-undo .
     3804     define variable v-orient-page as character no-undo .
     3805     run How-name in this-procedure (
     3806         input ReportPageHeight,
     3807         input ReportPageWidth,
     3808         output v-orient-page )
     3809         .
     3810     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     3811                                    else DisabledOptions = 0 .
     3812     run gbl/prnfilen.w
     3813       (input  ""
     3814       ,input  DisabledOptions
     3815       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3816       ,input REportFontNum
     3817       ,output v-user-action
     3818       ,output v-printed
     3819       ) .
     3820    end.
     3821   END PROCEDURE.
     3822   procedure one-type :
     3823    do
     3824    on error undo, return error return-value
     3825    :
     3826    FIND LAST  ub.aht-stk-line where
     3827                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     3828                     AND   ub.aht-stk-line.fact-order <= fact-order-2
     3829                     AND   ub.aht-stk-line.obj-code   = x-store-code
     3830                     AND   ub.aht-stk-line.obj-type   = x-store-type
     3831                     AND   ub.aht-stk-line.sum-type   = p-type-pr
     3832                           USE-INDEX category no-lock no-error.
     3833           IF AVAILABLE ub.aht-stk-line Then DO:
     3834               IF  tPrintRubl  THEN
     3835                     ASSIGN gds-zap-qnty       =  ub.aht-stk-line.fact-qnty
     3836                           gds-zap-stoim-base  = IF PayType = 2  then  ub.aht-stk-line.cost-sum-rubl
     3837                                                                 else  ub.aht-stk-line.crsa-sum-rubl
     3838                           gds-zap-Nds         = IF PayType = 2  then  ub.aht-stk-line.cost-VAT-rubl
     3839                                                                 else  ub.aht-stk-line.crsa-VAT-rubl
     3840                           gds-zap-Np          = IF PayType = 2  then  ub.aht-stk-line.cost-SLT-rubl
     3841                                                                 else  ub.aht-stk-line.crsa-SLT-rubl  .
     3842                 ELSE
     3843                     ASSIGN gds-zap-qnty       =  ub.aht-stk-line.fact-qnty
     3844                           gds-zap-stoim-base  = IF PayType = 2  then ub.aht-stk-line.cost-sum-base
     3845                                                                 else ub.aht-stk-line.crsa-sum-base
     3846                           gds-zap-Nds         = IF PayType = 2  then ub.aht-stk-line.cost-VAT-base
     3847                                                                 else ub.aht-stk-line.crsa-VAT-base
     3848                           gds-zap-Np          = IF PayType = 2  then ub.aht-stk-line.cost-SLT-base
     3849                                                                else  ub.aht-stk-line.crsa-SLT-base .
     3850                End.
     3851             Else ASSIGN gds-zap-qnty       = 0
     3852                         gds-zap-price-base = 0
     3853                         gds-zap-price-nds  = 0
     3854                         gds-zap-stoim-base = 0
     3855                         gds-zap-Nds        = 0
     3856                         gds-zap-Np         = 0 .
     3857           Assign
     3858             gds-zap-price-base = if (gds-zap-qnty <> 0) Then (gds-zap-stoim-base / gds-zap-qnty) Else 0
     3859             tot_tqnty          = gds-zap-stoim-base - gds-zap-Nds
     3860             gds-zap-price-nds = if (gds-zap-qnty <> 0) Then (tot_tqnty / gds-zap-qnty)  Else 0
     3861             .
     3862    end.
     3863   end procedure.
     3864   procedure many-type :
     3865    do
     3866    on error undo, return error return-value
     3867    :
     3868    define variable tt as integer no-undo .
     3869    define variable tv as character no-undo .
     3870    ASSIGN gds-zap-qnty       = 0
     3871       gds-zap-price-base = 0
     3872       gds-zap-price-nds  = 0
     3873       gds-zap-stoim-base = 0
     3874       gds-zap-Nds        = 0
     3875       gds-zap-Np         = 0 .
     3876   define variable v-1 as integer   no-undo .
     3877   v-1 = num-entries(p-type-pr)  .
     3878    do tt = 1 to v-1 :
     3879    tv = entry(tt,p-type-pr) .
     3880    FIND LAST  ub.aht-stk-line where
     3881                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     3882                     AND   ub.aht-stk-line.fact-order <= fact-order-2
     3883                     AND   ub.aht-stk-line.obj-code   = x-store-code
     3884                     AND   ub.aht-stk-line.obj-type   = x-store-type
     3885                     AND   ub.aht-stk-line.sum-type   = tv
     3886                           USE-INDEX category no-lock no-error.
     3887           IF AVAILABLE ub.aht-stk-line Then DO:
     3888               IF  tPrintRubl  THEN
     3889                     ASSIGN gds-zap-qnty        = gds-zap-qnty      +  (if ub.aht-stk-line.sum-type <> "b"
     3890                                                                           then  ub.aht-stk-line.fact-qnty else 0 )
     3891                            gds-zap-stoim-base  = gds-zap-stoim-base + IF PayType = 2  then  ub.aht-stk-line.cost-sum-rubl
     3892                                                                                       else  ub.aht-stk-line.crsa-sum-rubl
     3893                            gds-zap-Nds         = gds-zap-Nds        + IF PayType = 2  then  ub.aht-stk-line.cost-VAT-rubl
     3894                                                                                       else  ub.aht-stk-line.crsa-VAT-rubl
     3895                            gds-zap-Np          = gds-zap-Np         + IF PayType = 2  then  ub.aht-stk-line.cost-SLT-rubl
     3896                                                                                       else  ub.aht-stk-line.crsa-SLT-rubl  .
     3897                 ELSE
     3898                     ASSIGN gds-zap-qnty        = gds-zap-qnty       + (if ub.aht-stk-line.sum-type <> "b"
     3899                                                                           then  ub.aht-stk-line.fact-qnty else 0 )
     3900                            gds-zap-stoim-base  = gds-zap-stoim-base + IF PayType = 2  then ub.aht-stk-line.cost-sum-base
     3901                                                                                       else ub.aht-stk-line.crsa-sum-base
     3902                            gds-zap-Nds         = gds-zap-Nds        + IF PayType = 2  then ub.aht-stk-line.cost-VAT-base
     3903                                                                                       else ub.aht-stk-line.crsa-VAT-base
     3904                            gds-zap-Np          = gds-zap-Np         + IF PayType = 2  then ub.aht-stk-line.cost-SLT-base
     3905                                                                else ub.aht-stk-line.crsa-SLT-base .
     3906                End.
     3907           Assign
     3908             gds-zap-price-base = if (gds-zap-qnty <> 0) Then (gds-zap-stoim-base / gds-zap-qnty) Else 0
     3909             tot_tqnty          = gds-zap-stoim-base - gds-zap-Nds
     3910             gds-zap-price-nds = if (gds-zap-qnty <> 0) Then  ( tot_tqnty / gds-zap-qnty )  Else 0
     3911             .
     3912      end.
     3913    end.
     3914   end procedure.
     3915   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3916   procedure macr_excel_char :
     3917    do
     3918    on error undo, return error return-value
     3919    :
     3920    define input parameter  p-val as character no-undo .
     3921    define input parameter  p-row as integer no-undo .
     3922    define input parameter  p-col as integer no-undo .
     3923    if p-val = ? then p-val = "" .
     3924       put stream macr_excel unformatted
     3925             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3926    end.
     3927   end procedure.
     3928   procedure macr_excel_char_with_format :
     3929    do
     3930    on error undo, return error return-value
     3931    :
     3932    define input parameter  p-val as character no-undo .
     3933    define input parameter  p-row as integer no-undo .
     3934    define input parameter  p-col as integer no-undo .
     3935    if p-val = ? then p-val = "" .
     3936       put stream macr_excel unformatted
     3937             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3938       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     3939       put stream macr_excel unformatted
     3940             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3941    end.
     3942   end procedure.
     3943   procedure macr_excel_cell_format :
     3944    do
     3945    on error undo, return error return-value
     3946    :
     3947    define input parameter  p-val    as character no-undo .
     3948    define input parameter  p-row    as integer   no-undo .
     3949    define input parameter  p-col    as integer   no-undo .
     3950    define input parameter  p-format as character no-undo .
     3951    if p-val = ? then p-val = "" .
     3952       put stream macr_excel unformatted
     3953             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3954       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     3955       put stream macr_excel unformatted
     3956             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3957    end.
     3958   end procedure.
     3959   procedure macr_excel_sum :
     3960    do
     3961    on error undo, return error return-value
     3962    :
     3963    define input parameter  p-row as integer no-undo .
     3964    define input parameter  p-col as integer no-undo .
     3965    define input parameter  p-row1 as integer no-undo .
     3966    define input parameter  p-col1 as integer no-undo .
     3967    define input parameter  p-row2 as integer no-undo .
     3968    define input parameter  p-col2 as integer no-undo .
     3969       put stream macr_excel unformatted
     3970             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     3971    end.
     3972   end procedure.
     3973   procedure macr_excel_dec :
     3974    do
     3975    on error undo, return error return-value
     3976    :
     3977    define input parameter  p-val as character no-undo .
     3978    define input parameter  p-row as integer   no-undo .
     3979    define input parameter  p-col as integer   no-undo .
     3980     if p-val = ? then p-val =  "" .
     3981      put  stream macr_excel unformatted
     3982           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     3983    end.
     3984   end procedure.
     3985   procedure macr_cell_format :
     3986    do
     3987    on error undo, return error return-value
     3988    :
     3989    define input parameter  p-size   as integer   no-undo .
     3990    define input parameter  p-bold   as logical   no-undo .
     3991    define input parameter  p-italic as logical   no-undo .
     3992    define input parameter  p-color  as integer   no-undo .
     3993    define input parameter  p-row    as integer   no-undo .
     3994    define input parameter  p-col    as integer   no-undo .
     3995    define input parameter  p-row-2  as integer   no-undo .
     3996    define input parameter  p-col-2  as integer   no-undo .
     3997     if p-size = ? then p-size = 10 .
     3998     if p-bold = ? then p-bold = false .
     3999     if p-italic = ? then p-italic = false .
     4000     if p-row-2 = ? then p-row-2 = p-row .
     4001     if p-col-2 = ? then p-col-2 = p-col .
     4002     put  stream macr_excel unformatted
     4003      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     4004     if p-color <> ? then do:
     4005        put  stream macr_excel unformatted
     4006          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     4007     end.
     4008     put  stream macr_excel unformatted
     4009          substitute('format.font(,&1,&2,&3)' , p-size,
     4010                                           string ( p-bold  , "true/false" ) ,
     4011                                           string ( p-italic , "true/false" )
     4012                                           ) + chr(10) .
     4013    end.
     4014   end procedure.
     4015   procedure macr_cell_size :
     4016    do
     4017    on error undo, return error return-value
     4018    :
     4019    define input parameter  p-w   as integer   no-undo .
     4020    define input parameter  p-l   as integer   no-undo .
     4021    define input parameter  p-row    as integer   no-undo .
     4022    define input parameter  p-col    as integer   no-undo .
     4023    define input parameter  p-row-2  as integer   no-undo .
     4024    define input parameter  p-col-2  as integer   no-undo .
     4025     if p-row-2 = ? then p-row-2 = p-row .
     4026     if p-col-2 = ? then p-col-2 = p-col .
     4027     if p-w = ? then    p-w = 0 .
     4028     if p-l = ? then    p-l = 0 .
     4029    define variable s-w as character no-undo .
     4030    define variable s-l as character no-undo .
     4031    if p-w = 0 then s-w = "" .
     4032               else s-w = string(p-w)  .
     4033    if p-l = 0 then s-l = "" .
     4034               else s-l = string(p-l)  .
     4035   put  stream macr_excel unformatted
     4036        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     4037   put  stream macr_excel unformatted
     4038        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     4039   put  stream macr_excel unformatted
     4040        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     4041    end.
     4042   end procedure.
     4043   procedure proc-print-header :
     4044    do
     4045    on error undo, return error return-value
     4046    :
     4047      find first sheetf .
     4048        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     4049        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     4050        var-1 =  num#str# .
     4051        repeat c-c = 1 to sheetf.excel-row-title :
     4052        num#str# = num#str# + 1 .
     4053        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     4054        do c-i = 1 to p-var :
     4055           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     4056           str--2 = integer(entry( c-i, sheetf.sizes )) .
     4057           num#col# = c-i .
     4058           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     4059           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     4060        end.
     4061       c-i = 0.
     4062       end.
     4063       run macr_cell_format (
     4064           10       ,
     4065           true     ,
     4066           false    ,
     4067           35       ,
     4068           var-1 + 1,
     4069           1        ,
     4070           num#str# ,
     4071           num#col# )
     4072           .
     4073     put  stream macr_excel unformatted
     4074          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     4075          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4076          .
     4077    end.
     4078   end procedure.
     4079   procedure end-proc :
     4080    do
     4081    on error undo, return error return-value
     4082    :
     4083     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     4084     OUTPUT to VALUE (v-file-name) .
     4085     for each temp-param :
     4086       export  temp-param  .
     4087     end.
     4088    end.
     4089   end procedure.
