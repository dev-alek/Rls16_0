     2160   define variable arh-type-crsa as character no-undo .
     2161   define variable arh-type-cost as character no-undo .
     2162   define variable arh-type-sadt as character no-undo .
     2163   define variable arh-type-cgdt as character no-undo .
     2164   define variable arh-type-csdt as character no-undo .
     2165   define variable arh-type-allsum  as character no-undo .
     2166   assign
     2167     i=0
     2168     zap-date      = x-Date-Alone
     2169     Select-Good   = x-SelectGood
     2170     PayType       = x-SET_PAY_TYPE
     2171     RetClassify   = xClassify
     2172     RetSortType   = xSortType
     2173     Sums-Only     = xSumsOnly
     2174     Show-Negativ  = xShowZero
     2175     a-name        = fill(" ",26) + "Итого по типам"
     2176     ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     2177     time-start    = time.
     2178       run aht-ostatok   in this-procedure (
     2179           input x-store-code  ,
     2180           input x-store-type  ,
     2181           input false         ,
     2182           input ?  ,
     2183           input zap-date      ,
     2184           input ?             ,
     2185           input ?             ,
     2186           input "n"           ,
     2187           input true          ,
     2188           output  Fact-order-2 ) .
     2189     Run report-execute.
     2190   procedure foreach :
     2191    do
     2192    on error undo, return error return-value
     2193    :
     2194   define variable old-name as character no-undo .
     2195   define variable c-fl as integer no-undo .
     2196    c-fl = 0 .
     2197   IF ( i modulo v-account = 0 )  then DO:
     2198    Assign
     2199       v-kol-spice = (50 - LENGTH(reportname)) / 2
     2200       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     2201       .
     2202    Assign
     2203       v-kol-spice = (50 - LENGTH(ObjName)) / 2
     2204       RecordsString2 = fill(' ',v-kol-spice) + string(ObjName)
     2205       .
     2206             if  log-manager:logfile-name ne ?
     2207             then DO:
     2208                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2209             end.
     2210              if mFrameView
     2211              then do:
     2212               DISPLAY
     2213                 i @ RecordsDone
     2214                 RecordsString   @ RecordsString
     2215                 RecordsString2  @ RecordsString2
     2216                 WITH FRAME InfoFrame.
     2217              end.
     2218   End.
     2219      if v-button-stop then  DO:
     2220            if mFrameView
     2221            then
     2222               PROCESS EVENTS.
     2223            IF StopProcessing THEN DO:
     2224            RETURN error.
     2225            End.
     2226      end.
     2227    old-name = gds-zap-gds-name.
     2228    if x-type-pr = "all"  then do:
     2229        run many-type.
     2230        if x-type-pr = 'all'  then p-type-pr = 'r':U .
     2231        run one-type.
     2232        gds-zap-gds-name = string(old-name,"x(34)") + "Выкуп".
     2233        gds-zap-gds-name1 = old-name.
     2234        gds-zap-gds-name2 =  "Выкуп".
     2235        run display-line-new .
     2236            if flag-print = true then c-fl = c-fl + 1.
     2237        if x-type-pr = 'all'  then p-type-pr = 'c,b':U .
     2238        run many-type.
     2239        gds-zap-gds-name = string(old-name,"x(34)") + "Консиг".
     2240        gds-zap-gds-name1 = old-name.
     2241        gds-zap-gds-name2 =  "Консиг".
     2242        run display-line-new .
     2243            if flag-print = true then c-fl = c-fl + 1.
     2244        if x-type-pr = 'all'  then p-type-pr = 'o':U .
     2245        run one-type.
     2246        gds-zap-gds-name = string(old-name,"x(34)") + "Ст.Конс".
     2247        gds-zap-gds-name1 = old-name.
     2248        gds-zap-gds-name2 =  "Ст.Конс".
     2249        run display-line-new .
     2250            if flag-print = true then c-fl = c-fl + 1.
     2251        if x-type-pr = 'all'  then p-type-pr = 's':U .
     2252        run one-type.
     2253        gds-zap-gds-name = string(old-name,"x(34)") + "Отв.хр".
     2254        gds-zap-gds-name1 = old-name.
     2255        gds-zap-gds-name2 =  "Отв.хр".
     2256        run display-line-new .
     2257            if flag-print = true then c-fl = c-fl + 1.
     2258        if c-fl >= 1 then do:
     2259           if x-type-pr = 'all'  then p-type-pr = 'r,c,b,o,s':U  .
     2260           gds-zap-gds-name = a-name.
     2261           run many-type.
     2262        end.
     2263    end.
     2264   if x-type-pr = 'cb' then do:
     2265          p-type-pr = 'c,b':U .
     2266          run many-type.
     2267   end.
     2268   if not (x-type-pr = 'cb' or  x-type-pr = 'all' )  then do:
     2269     p-type-pr = x-type-pr.
     2270     run one-type.
     2271    end.
     2272    end.
     2273   end procedure.
     2274   procedure display-line :
     2275    do
     2276    on error undo, return error return-value
     2277    :
     2278        i = i + 1.
     2279        flag-print = false  .
     2280        IF  NOT (NOT Show-Negativ  AND (gds-zap-qnty = 0 and gds-zap-stoim-base = 0 and gds-zap-Nds = 0 )) then DO:
     2281           IF NOT Sums-Only then DO:
     2282             if fr = true then do:
     2283                             if fr0 = true then do:
     2284                                 PUT stream  OutStream  tmp#stroka0 format "X(100)" skip .
     2285                                 num#str# = num#str# + 1.
     2286                                 num#col# = 1.
     2287                                 run macr_excel_char_with_format( String(tmp#stroka0)  , num#str# , num#col#  ) .
     2288                                 run macr_cell_format
     2289                                 ( 10    ,
     2290                                   true  ,
     2291                                   true  ,
     2292                                   33    ,
     2293                                   num#str# ,
     2294                                   num#col# ,
     2295                                   num#str# ,
     2296                                   5 ) .
     2297                                 fr0 = false .
     2298                              end.
     2299                           PUT stream  OutStream   space(6) tmp#stroka format "X(100)" skip .
     2300                           num#str# = num#str# + 1.
     2301                           num#col# = 2.
     2302                           run macr_excel_char_with_format( String(tmp#stroka)  , num#str# , num#col#  ) .
     2303                           run macr_cell_format
     2304                             ( 10    ,
     2305                               true  ,
     2306                               true  ,
     2307                               36    ,
     2308                               num#str# ,
     2309                               num#col# ,
     2310                               num#str# ,
     2311                               5 ) .
     2312                           fr = false .
     2313             end.
     2314                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11
     2315                                 gds-zap-b-code
     2316                                 gds-zap-artic
     2317                                 gds-zap-gds-name
     2318                                 gds-zap-unit-base
     2319                                 gds-zap-qnty
     2320                                 gds-zap-price-base      when  gds-zap-gds-name <> a-name
     2321                                 gds-zap-price-nds       when  gds-zap-gds-name <> a-name
     2322                                 gds-zap-stoim-base
     2323                                 gds-zap-Nds
     2324                                 gds-zap-Np
     2325                                 tot_tqnty
     2326                                 with FRAME  zapas    .
     2327               DOWN stream  OutStream 1 with FRAME zapas    .
     2328               flag-print = true .
     2329               run new-tmp-page .
     2330                 num#str# = num#str# + 1.
     2331                 num#col# = 1.
     2332                   run macr_excel_dec ( gds-zap-b-code     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2333                   run macr_excel_char( gds-zap-artic      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2334                  if gds-zap-gds-name1 = ""  then  run macr_excel_char( gds-zap-gds-name   , num#str# , num#col#   ) .
     2335                                             else  run macr_excel_char( gds-zap-gds-name1   , num#str# , num#col#   ) .
     2336                                               assign    num#col# = num#col# + 1 .
     2337                  if gds-zap-gds-name <> a-name then run macr_excel_char( gds-zap-gds-name2   , num#str# , num#col#   ) .
     2338                                                else run macr_excel_char( a-name   , num#str# , num#col#   ) .
     2339                  assign    num#col# = num#col# + 1 .
     2340                   run macr_excel_char( gds-zap-unit-base  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2341                   run macr_excel_dec ( gds-zap-qnty       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2342                  if gds-zap-gds-name <> a-name then run macr_excel_dec ( round(gds-zap-price-base,2) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2343                   run macr_excel_dec ( round(gds-zap-stoim-base,2) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2344                   run macr_excel_dec ( round(gds-zap-Nds,2)        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2345                   run macr_excel_dec ( round(gds-zap-Np,2)         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2346                  if gds-zap-gds-name <> a-name then run macr_excel_dec ( round(gds-zap-price-nds,2)  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2347                   run macr_excel_dec ( round(tot_tqnty,2)          , num#str# , num#col#   ) .
     2348          End.
     2349          if gds-zap-gds-name <> a-name then do:
     2350               Assign
     2351                 tot-1   = tot-1 + gds-zap-qnty
     2352                 tot-2   = tot-2 + gds-zap-stoim-base
     2353                 tot-3   = tot-3 + tot_tqnty
     2354                 tot-4   = tot-4 + gds-zap-nds
     2355                 tot-5   = tot-5 + gds-zap-np
     2356                 otot-1  = otot-1 + gds-zap-qnty
     2357                 otot-2  = otot-2 + gds-zap-stoim-base
     2358                 otot-3  = otot-3 + tot_tqnty
     2359                 otot-4  = otot-4 + gds-zap-nds
     2360                 otot-5  = otot-5 + gds-zap-np
     2361                 tot-1-1 = tot-1-1 + gds-zap-qnty
     2362                 tot-1-2 = tot-1-2 + gds-zap-stoim-base
     2363                 tot-1-3 = tot-1-3 + tot_tqnty
     2364                 tot-1-4 = tot-1-4 + gds-zap-nds
     2365                 tot-1-5 = tot-1-5 + gds-zap-np
     2366                 tot-2-1 = tot-2-1 + gds-zap-qnty
     2367                 tot-2-2 = tot-2-2 + gds-zap-stoim-base
     2368                 tot-2-3 = tot-2-3 + tot_tqnty
     2369                 tot-2-4 = tot-2-4 + gds-zap-nds
     2370                 tot-2-5 = tot-2-5 + gds-zap-np
     2371                 .
     2372                 end.
     2373       end.
     2374    end.
     2375   end.
     2376   procedure display-line-new :
     2377    do
     2378    on error undo, return error return-value
     2379    :
     2380        i = i + 1.
     2381        flag-print = false  .
     2382        IF  NOT (NOT Show-Negativ  AND (gds-zap-qnty = 0 and gds-zap-stoim-base = 0 and gds-zap-Nds = 0 )) then DO:
     2383           IF NOT Sums-Only then DO:
     2384             if fr = true then do:
     2385                             if fr0 = true then do:
     2386                                 PUT stream  OutStream  tmp#stroka0 format "X(100)" skip .
     2387                                 num#str# = num#str# + 1.
     2388                                 num#col# = 1.
     2389                                 run macr_excel_char_with_format( String(tmp#stroka0)  , num#str# , num#col#  ) .
     2390                                 run macr_cell_format
     2391                                 ( 10    ,
     2392                                   true  ,
     2393                                   true  ,
     2394                                   33    ,
     2395                                   num#str# ,
     2396                                   num#col# ,
     2397                                   num#str# ,
     2398                                   5 ) .
     2399                                 fr0 = false .
     2400                              end.
     2401                           PUT stream  OutStream   space(6) tmp#stroka format "X(100)" skip .
     2402                           num#str# = num#str# + 1.
     2403                           num#col# = 2.
     2404                           run macr_excel_char_with_format( String(tmp#stroka)  , num#str# , num#col#  ) .
     2405                           run macr_cell_format
     2406                             ( 10    ,
     2407                               true  ,
     2408                               true  ,
     2409                               36    ,
     2410                               num#str# ,
     2411                               num#col# ,
     2412                               num#str# ,
     2413                               5 ) .
     2414                           fr = false .
     2415             end.
     2416                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11
     2417                                 gds-zap-b-code
     2418                                 gds-zap-artic
     2419                                 gds-zap-gds-name
     2420                                 gds-zap-unit-base
     2421                                 gds-zap-qnty
     2422                                 gds-zap-price-base      when  gds-zap-gds-name <> a-name
     2423                                 gds-zap-price-nds       when  gds-zap-gds-name <> a-name
     2424                                 gds-zap-stoim-base
     2425                                 gds-zap-Nds
     2426                                 gds-zap-Np
     2427                                 tot_tqnty
     2428                                 with FRAME  zapas    .
     2429               DOWN stream  OutStream 1 with FRAME zapas    .
     2430               flag-print = true .
     2431               run new-tmp-page .
     2432                 num#str# = num#str# + 1.
     2433                 num#col# = 1.
     2434                   run macr_excel_dec ( gds-zap-b-code     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2435                   run macr_excel_char( gds-zap-artic      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2436                   run macr_excel_char( gds-zap-gds-name1   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2437                  if gds-zap-gds-name <> a-name then  run macr_excel_char( gds-zap-gds-name2   , num#str# , num#col#   ) .
     2438                    else run macr_excel_char( a-name   , num#str# , num#col#   ) .
     2439                   assign    num#col# = num#col# + 1 .
     2440                   run macr_excel_char( gds-zap-unit-base  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2441                   run macr_excel_dec ( gds-zap-qnty       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2442                  if gds-zap-gds-name <> a-name then run macr_excel_dec ( round(gds-zap-price-base,2) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2443                   run macr_excel_dec ( round(gds-zap-stoim-base,2) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2444                   run macr_excel_dec ( round(gds-zap-Nds,2)        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2445                   run macr_excel_dec ( round(gds-zap-Np,2)         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2446                  if gds-zap-gds-name <> a-name then run macr_excel_dec ( round(gds-zap-price-nds,2)  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2447                   run macr_excel_dec ( round(tot_tqnty,2)          , num#str# , num#col#   ) .
     2448          End.
     2449          IF    true = true  then DO:
     2450          if gds-zap-gds-name <> a-name then do:
     2451               Assign
     2452                 tot-1   = tot-1 + gds-zap-qnty
     2453                 tot-2   = tot-2 + gds-zap-stoim-base
     2454                 tot-3   = tot-3 + tot_tqnty
     2455                 tot-4   = tot-4 + gds-zap-nds
     2456                 tot-5   = tot-5 + gds-zap-np
     2457                 otot-1  = otot-1 + gds-zap-qnty
     2458                 otot-2  = otot-2 + gds-zap-stoim-base
     2459                 otot-3  = otot-3 + tot_tqnty
     2460                 otot-4  = otot-4 + gds-zap-nds
     2461                 otot-5  = otot-5 + gds-zap-np
     2462                 tot-1-1 = tot-1-1 + gds-zap-qnty
     2463                 tot-1-2 = tot-1-2 + gds-zap-stoim-base
     2464                 tot-1-3 = tot-1-3 + tot_tqnty
     2465                 tot-1-4 = tot-1-4 + gds-zap-nds
     2466                 tot-1-5 = tot-1-5 + gds-zap-np
     2467                 tot-2-1 = tot-2-1 + gds-zap-qnty
     2468                 tot-2-2 = tot-2-2 + gds-zap-stoim-base
     2469                 tot-2-3 = tot-2-3 + tot_tqnty
     2470                 tot-2-4 = tot-2-4 + gds-zap-nds
     2471                 tot-2-5 = tot-2-5 + gds-zap-np
     2472                 .
     2473                 end.
     2474                 end.
     2475       end.
     2476    end.
     2477   end procedure.
     2478   procedure print-header :
     2479    do
     2480    on error undo, return error return-value
     2481    :
     2482   define variable v-nn as integer   no-undo .
     2483   PUT stream OutStream
     2484       string( v-cntxt-host-name-obj )     AT 50 format "X(85)" skip (2)
     2485       reportname          AT 5  format "X(100)"
     2486       " на " zap-date     format "99.99.9999" skip (2)
     2487       "ФАКТИЧЕСКОЕ наличие  " + Trim(str3)  AT 35 format "X(75)" skip (1) .
     2488        put stream outstream str2 at 35 format "x(200)"  skip .
     2489        v-nn = num-entries ( str4 , chr(10)) .
     2490        repeat i = 1 to v-nn :
     2491          put stream outstream  entry(i,str4,chr(10))  at 1 format "x(170)" skip .
     2492        end.
     2493        v-nn = num-entries(reportheader,chr(10)) .
     2494        repeat i = 1 to v-nn :
     2495          put stream outstream  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip .
     2496        end.
     2497        i=0.
     2498         FirstLine = TRUE .
     2499          FORM with FRAME zapas .
     2500          DOWN stream  OutStream 1 with FRAME zapas.
     2501      Assign
     2502         Tot-1=0
     2503         Tot-2=0
     2504         Tot-3=0
     2505         Tot-4=0
     2506         Tot-5=0
     2507         Tot-1-1=0
     2508         Tot-1-2=0
     2509         Tot-1-3=0
     2510         Tot-1-4=0
     2511         Tot-1-5=0
     2512         Tot-2-1=0
     2513         Tot-2-2=0
     2514         Tot-2-3=0
     2515         Tot-2-4=0
     2516         Tot-2-5=0
     2517         break_group = true
     2518         break_group1 = true.
     2519    end.
     2520   end procedure.
     2521   procedure Print-Footer :
     2522    do
     2523    on error undo, return error return-value
     2524    :
     2525    define variable var-1 as integer no-undo .
     2526    define variable var-2 as integer no-undo .
     2527         DISPLAY stream  OutStream
     2528                         sym1
     2529                       " ИТОГО" @ gds-zap-b-code
     2530                         sym4
     2531                         sym5
     2532                         Tot-1  @ gds-zap-qnty
     2533                         sym6
     2534                         Tot-2  @ gds-zap-stoim-base
     2535                         sym7
     2536                         sym8
     2537                         Tot-4  @ gds-zap-nds
     2538                         sym9
     2539                         Tot-5  @ gds-zap-nP
     2540                         sym10
     2541                         Tot-3  @ tot_tqnty
     2542                         sym11
     2543                         with FRAME zapas.
     2544         DOWN stream  OutStream 1 with FRAME zapas.
     2545         assign
     2546          num#str# = num#str# + 1
     2547          num#col# =  1
     2548          var-1 = num#str#
     2549          var-2 = num#col#
     2550          .
     2551          run macr_excel_char_with_format( "ИТОГО", num#str# , num#col# ). assign   num#col# = num#col# + 5.
     2552          run macr_excel_dec ( Tot-1 , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     2553          run macr_excel_dec ( round(Tot-2,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     2554          run macr_excel_dec ( round(Tot-4,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     2555          run macr_excel_dec ( round(Tot-5,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 2.
     2556          run macr_excel_dec ( round(Tot-3,2) , num#str# , num#col# ) . assign   num#col# = num#col# + 1.
     2557          run macr_cell_format
     2558             ( 10    ,
     2559               true  ,
     2560               false ,
     2561               ?     ,
     2562               var-1 ,
     2563               var-2 ,
     2564               num#str# ,
     2565               num#col# ) .
     2566         assign
     2567          num#str# = num#str# + 1
     2568          num#col# =  1
     2569          .
     2570         run macr_excel_char_with_format ( "Время формирования отчета " + string( time - time-start ) , num#str# , num#col# ) .
     2571         run u-line.
     2572         put stream  outstream unformatted
     2573           "Итого " tot-1 " единиц , "  " на сумму "    trim( string(tot-2,"->>>>>>>>>>>>9.99"))
     2574           "(" + (if tprintrubl then "руб" else x-base-type ) + ")"
     2575           skip
     2576           string("Время формирования отчета ")
     2577           string( time - time-start)
     2578         .
     2579    end.
     2580   end procedure.
     2581   procedure Print-Footer-o :
     2582    do
     2583    on error undo, return error return-value
     2584    :
     2585   define variable var-1 as integer no-undo .
