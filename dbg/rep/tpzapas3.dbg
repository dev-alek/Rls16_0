     2074   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     2075   DEFINE BUTTON StopBtn AUTO-END-KEY
     2076        LABEL "Стоп"
     2077        SIZE 10 BY 1.
     2078   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     2079        LABEL "Обработано записей"
     2080         VIEW-AS TEXT
     2081        SIZE 14 BY .67 NO-UNDO.
