     2095        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2096        SIZE 55.13 BY 4.46.
     2097   DEFINE FRAME InfoFrame
     2098        StopBtn AT ROW 4.25 COL 21.75
     2099        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2100        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2101        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2102        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2103        RECT-1 AT ROW 1 COL 1
     2104       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2105            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2106            TITLE "Процесс"
     2107            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2108   define variable mFrameView      as logical   no-undo init yes.
     2109     define variable mFramHandle as handle no-undo.
     2110     mFramHandle = frame InfoFrame:handle.
     2111     if  log-manager:logfile-name ne ?
     2112     then DO:
     2113         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2114         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2115         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2116     end.
     2117     mFrameView = not session:batch-mode and mFramHandle:visible.
     2118     if mFrameView
     2119     then do:
     2120       ASSIGN
     2121          FRAME InfoFrame:HIDDEN                           = TRUE
     2122          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2123     end.
     2124   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2125   DO:
     2126     IF not StopProcessing THEN
     2127       Message "Вы действительно хотите прервать" SKIP
     2128               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2129                 UPDATE StopProcessing.
     2130     IF StopProcessing THEN do:
     2131        if mFrameView
     2132        then do:
     2133           HIDE FRAME InfoFrame.
     2134        end.
     2135     End.
     2136   END.
     2137   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     2138     if  log-manager:logfile-name ne ?
     2139     then DO:
     2140         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2141     end.
     2142     if not session:batch-mode then
     2143     do:
     2144       VIEW FRAME InfoFrame.
     2145       mFrameView = true.
     2146     end.
     2147      v-button-stop = false .
     2148         if mFrameView
     2149         then do:
     2150         if v-button-stop then view STOPBTN in frame InfoFrame.
     2151                          else Hide STOPBTN in frame InfoFrame.
     2152         end.
