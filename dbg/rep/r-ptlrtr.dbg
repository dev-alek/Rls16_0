      585   define  stream PrnLibStream.
      586   procedure prn-lib-prn-file :
      587     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      588     define input parameter p-DIsabledoptions as integer no-undo .
      589     define variable v-report-name as character no-undo .
      590     define variable v-user-action as character no-undo .
      591     define variable v-printed     as logical   no-undo .
      592     define variable v-exist       as logical   no-undo .
      593     do
      594       on error undo, return error
      595       :
      596       run prn-lib-get-report-name  in this-procedure (
      597         input parParentProc
      598         ,output v-report-name
      599         ).
      600   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      602     (input  v-report-name
      603     ,input  2
      604     ,output v-exist
      605     )  .
      606       if NOT v-exist then
      607       DO:
      608         Message
      609           "Нет заданий на печать ! "
      610           view-as alert-box .
      611         Return  .
      612       End.
      613       run gbl/prnfilen.w
      614         (input  ""
      615         ,input  p-DisabledOptions
      616         ,input  string(v-report-name )
      617         ,input  7
      618         ,output v-user-action
      619         ,output v-printed
      620         ) .
      621       if v-printed then
      622       do:
      623         return "YES" .
      624       end.
      625       else
      626       do:
      627         return "NO" .
      628       end.
      629     end.
      630   end procedure.
      631   procedure prn-lib-open-stream :
      632     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      633     define input parameter p-page-size    as integer no-undo .
      634     define input parameter p-is-stream    as logical no-undo .
      635     define input parameter p-append       as logical no-undo .
      636     define variable v-report-name as character no-undo .
      637     do
      638       on error undo, return error
      639       :
      640       run prn-lib-get-report-name  in this-procedure (
      641         input parParentProc
      642         ,output v-report-name
      643         ).
      644       if p-is-stream then
      645       do:
      646         if p-append then
      647         do:
      648           output stream PrnLibStream to value( v-report-name )
      649             page-size value(p-page-size) append .
      650         end.
      651         if not p-append then
      652         do:
      653           output stream PrnLibStream to value( v-report-name )
      654             page-size value(p-page-size) .
      655         end.
      656       end.
      657       if not p-is-stream then
      658       do:
      659         if p-append then
      660         do:
      661           output to value( v-report-name )
      662             page-size value(p-page-size) append .
      663         end.
      664         if not p-append then
      665         do:
      666           output to value( v-report-name )
      667             page-size value(p-page-size) .
      668         end.
      669       end.
      670     end.
      671   end procedure.
      672   procedure prn-lib-open-exp :
      673     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      674     define input parameter p-is-stream    as logical no-undo .
      675     define input parameter p-is-append    as logical no-undo .
      676     define output parameter p-ReportFileName as char init "report" no-undo.
      677     define output parameter p-process as logical no-undo .
      678     define variable glog as logical no-undo .
      679     do
      680       on error undo, return error
      681       :
      682       SYSTEM-DIALOG GET-FILE p-ReportFileName
      683         TITLE      "Укажите путь"
      684         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      685         ASK-OVERWRITE
      686         CREATE-TEST-FILE
      687         SAVE-AS
      688         USE-FILENAME
      689         DEFAULT-EXTENSION "txt"
      690         UPDATE glog
      691         .
      692       if not glog then  return.
      693       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      694       if p-is-stream then
      695       do:
      696         if p-is-append then
      697         do:
      698           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      699         end.
      700         else
      701         do:
      702           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      703         end.
      704       end.
      705       else
      706       do:
      707         if p-is-append then
      708         do:
      709           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      710         end.
      711         else
      712         do:
      713           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      714         end.
      715       end.
      716       p-process = yes.
      717     end.
      718   end procedure.
      719   procedure prn-lib-get-report-name :
      720     define input parameter parParentProc  as widget-handle no-undo.
      721     define output parameter p-report-name as character no-undo .
      722     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      723   end procedure.
      724   procedure prn-lib-reportviewer-report-name :
      725     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      726     define input parameter p-report-name-html as character no-undo .
      727     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      728   end procedure.
      729   procedure prn-lib-reportviewer :
      730     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      731     define input parameter p-report-name-html as character no-undo .
      732     define input parameter p-param        as character no-undo .
      733     define variable v-excel           as character no-undo init 'TRUE' .
      734     define variable v-value-character as character no-undo .
      735     define variable v-value-integer   as character no-undo .
      736     define variable v-value-date      as date      no-undo .
      737     define variable v-value-decimal   as decimal   no-undo .
      738     define variable rep-excel         as logical   no-undo .
      739     define variable excel-string      as character no-undo .
      740     define variable v-param-type      as character no-undo .
      741     define variable v-tth             as handle    no-undo .
      742     run adm/shattri.p (
      743       input "get":U
      744       ,input  ""
      745       ,input  0
      746       ,input  'report-glob':U
      747       ,input  'rep-excel':U
      748       ,output v-value-character
      749       ,output v-value-date
      750       ,output v-value-decimal
      751       ,output v-value-integer
      752       ,output rep-excel
      753       ,output v-param-type
      754       ,INPUT-OUTPUT table-handle v-tth
      755       )  .
      756     if rep-excel then v-excel = "TRUE" .
      757     else v-excel = "FALSE" .
      758     if p-param eq ""
      759     then
      760        p-param = "EXCEL:" + v-excel.
      761     else
      762        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      763     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      764   end procedure.
      765   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   procedure cur-time :
      767      define output parameter p-today as date      no-undo .
      768      define output parameter p-time  as integer   no-undo .
      769     do
      770     on error undo, return error
      771     :
      772       define variable v-date1 as date      no-undo .
      773       define variable v-date2 as date      no-undo .
      774       define variable v-time  as integer   no-undo .
      775       assign
      776         v-date1 = today
      777         v-time  = time
      778         v-date2 = today
      779       .
      780       if v-date1 <> v-date2
      781       then do:
      782         assign
      783           v-date1 = today
      784           v-time  = v-time
      785         .
      786       end.
      787       assign
      788         p-today = v-date1
      789         p-time  = v-time
      790       .
      791     end.
      792   end.
      793   function cur-time-date returns character
      794   :
      795     return string(today, '99/99/9999':U) .
      796   end.
      797   function cur-time-mjd returns decimal
      798   :
      799     define variable v-date as date      no-undo .
      800     define variable v-time as integer   no-undo .
      801     run cur-time in this-procedure
      802       (output v-date
      803       ,output v-time
      804       ) .
      805     return integer(v-date) - 2400002 + (v-time / 86400) .
      806   end.
      807   function cur-time-get-ending-index returns integer
      808   (input p-number as integer
      809   )
      810   :
      811     if p-number < 0
      812     or p-number = ?
      813     then do:
      814       return 1 .
      815     end.
      816     define variable v-rest as integer   no-undo .
      817     assign
      818       p-number = p-number modulo 100
      819     .
      820     if p-number < 20
      821     then do:
      822       assign
      823         v-rest = p-number
      824       .
      825     end.
      826     else do:
      827       assign
      828         v-rest = p-number modulo 10
      829       .
      830     end.
      831     case v-rest :
      832       when 1
      833       then do:
      834         return 2 .
      835       end.
      836       when 2 or
      837       when 3 or
      838       when 4
      839       then do:
      840         return 3 .
      841       end.
      842       otherwise do:
      843         return 1 .
      844       end.
      845     end case .
      846   end.
      847   procedure cur-time-mjd-to-date :
      848      define input  parameter i-mjd-diff as decimal no-undo.
      849      define output parameter o-Date     as date    no-undo.
      850      define output parameter o-Time     as integer no-undo.
      851      define variable v-day-number as integer   no-undo .
      852      if    i-mjd-diff < 0
      853         or i-mjd-diff = ?
      854      then do:
      855         return "?" .
      856      end.
      857      assign
      858         v-day-number = truncate(i-mjd-diff,0).
      859         o-Date = date(v-day-number + 2400002).
      860         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      861     .
      862   end.
      863   function cur-time-mjd-to-string returns character
      864   (input p-mjd-diff as decimal
      865   )
      866   :
      867     define variable v-day-number as integer   no-undo .
      868     define variable v-seconds    as integer   no-undo .
      869     define variable v-hour       as integer   no-undo .
      870     define variable v-min        as integer   no-undo .
      871     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      872     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      873     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      874     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      875     if p-mjd-diff < 0
      876     or p-mjd-diff = ?
      877     then do:
      878       return "?" .
      879     end.
      880     assign
      881       v-day-number = integer(truncate(p-mjd-diff,0))
      882       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      883     .
      884     if v-seconds > 86400
      885     then do:
      886       assign
      887         v-seconds = 86400 - 1
      888       .
      889     end.
      890     if v-seconds < 0
      891     then do:
      892       assign
      893         v-seconds = 0
      894       .
      895     end.
      896     assign
      897       v-hour = truncate(v-seconds / 3600, 0)
      898     .
      899     assign
      900       v-seconds = v-seconds modulo 3600
      901     .
      902     assign
      903       v-min = truncate(v-seconds / 60, 0)
      904     .
      905     assign
      906       v-seconds = v-seconds modulo 60
      907     .
      908     return
      909         (if v-day-number <> 0
      910           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      911           else ""
      912         )
      913       + (if v-day-number <> 0 or v-hour <> 0
      914           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      915           else ""
      916         )
      917       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      918           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      919           else ""
      920         )
      921       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      922       .
      923   end.
      924   function cur-time-string returns character
      925   :
      926     define variable v-date as date      no-undo .
      927     define variable v-time as integer   no-undo .
      928     run cur-time in this-procedure
      929       (output v-date
      930       ,output v-time
      931       ) .
      932     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      933   end.
      934   function cur-time-string-sec returns character
      935   :
      936     define variable v-date as date      no-undo .
      937     define variable v-time as integer   no-undo .
      938     run cur-time in this-procedure
      939       (output v-date
      940       ,output v-time
      941       ) .
      942     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      943   end.
      944   function cur-time-custom  returns character
      945   (input p-prefix as character
      946   ,input p-date-format as character
      947   ,input p-delimiter as character
      948   ,input p-time-format as character
      949   ,input p-suffix as character
      950   )
      951   :
      952     define variable v-date as date      no-undo .
      953     define variable v-time as integer   no-undo .
      954     run cur-time in this-procedure
      955       (output v-date
      956       ,output v-time
      957       ) .
      958     return
      959       p-prefix
      960       + string(v-date, p-date-format)
      961       + p-delimiter
      962       + string(v-time, p-time-format)
      963       + p-suffix
      964       .
      965   end.
      966   function cur-time-print  returns character
      967   :
      968     define variable v-date as date      no-undo .
      969     define variable v-time as integer   no-undo .
      970     run cur-time in this-procedure
      971       (output v-date
      972       ,output v-time
      973       ) .
      974     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      975   end.
      976   function cur-time-datetime returns datetime
      977   :
      978     define variable v-char as character no-undo .
      979     define variable v-datetime as datetime no-undo .
      980     v-char = cur-time-string().
      981     v-datetime = datetime(v-char).
      982     return  v-datetime.
      983   end.
      984   function cur-time-string-msec returns character
      985   :
      986     define variable v-date as datetime  no-undo .
      987     v-date = now.
      988     return string(v-date) .
      989   end.
