     1272   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   define variable v-waitfram-action01         as character   no-undo .
     1274   define variable v-waitfram-action02         as character   no-undo .
     1275   define variable v-waitfram-action03         as character   no-undo .
     1276   define variable mWaitFramTextBeg            as character   no-undo.
     1277   define variable mWaitFramTextEnd            as character   no-undo.
     1278   define variable mWaitFramView               as logical     no-undo.
     1279   define variable mWaitProcEvent              as logical     no-undo init yes.
     1280   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1281   define variable mWaitFramStop               as logical     no-undo.
     1282   define variable mWaitFramStopUser           as logical     no-undo.
     1283   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1284   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1285   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1286   define button B-WaitFramStop auto-end-key
     1287        label "Стоп"
     1288        size 10 by 1 tooltip "Остоновить процесс".
     1289   define button B-viewProcInfo
     1290        label "Информация"
     1291        size 15 by 1 tooltip "Информация о процесс".
     1292   define frame waitfram
     1293     v-waitfram-action01 format "x(72)" no-label skip
     1294     v-waitfram-action02 format "x(72)" no-label skip
     1295     v-waitfram-action03 format "x(72)" no-label skip
     1296     B-viewProcInfo
     1297     B-WaitFramStop at row 4 col 30
     1298     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1299     .
     1300   define new global shared variable mBatchMode as logical no-undo init ?.
     1301   define variable mFramBachModHandle as handle no-undo.
     1302   mFramBachModHandle = frame waitfram:handle.
     1303   define variable mFameOldVis as logical no-undo.
     1304   define variable mVisCUrentVin as logical no-undo.
     1305   if session:batch-mode
     1306   then
     1307      mBatchMode = yes.
     1308   if mBatchMode = ? then do:
     1309     mVisCUrentVin = current-window:visible.
     1310     mFameOldVis = mFramBachModHandle:visible.
     1311     mFramBachModHandle:visible  = yes.
     1312     mBatchMode = mFramBachModHandle:visible ne yes.
     1313     mFramBachModHandle:visible = mFameOldVis.
     1314     current-window:visible = mVisCUrentVin.
     1315   end.
     1316    if  log-manager:logfile-name ne ?
     1317     then DO:
     1318         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1319         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1320         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1321     end.
     1322   on choose of B-WaitFramStop in frame waitfram
     1323   do:
     1324     mWaitFramStop = yes.
     1325     mWaitFramStopUser = yes.
     1326   end.
     1327   function waitfram-check-timeout returns logical():
     1328      define variable vtime as int64 no-undo.
     1329      if mWaitFramStopTimeOut
     1330      then
     1331         return yes.
     1332      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1333      if     mWaitFramTimeOut ne ?
     1334         and mWaitFramTimeOut ne 0
     1335         and mWaitFramTimeOut lt vtime
     1336      then do:
     1337         mWaitFramStopTimeOut = yes.
     1338      end.
     1339      return mWaitFramStopTimeOut.
     1340   end.
     1341   procedure waitfram-hide :
     1342     if not session:batch-mode
     1343     then do
     1344     on error undo, return error return-value
     1345     :
     1346       pause 0 before-hide .
     1347       if not mBatchMode then
     1348         hide frame waitfram .
     1349     if     not mWaitFramView
     1350        and mWaitProcEvent
     1351     then
     1352       process events .
     1353     end.
     1354   end procedure.
     1355   procedure waitfram-show :
     1356     define input  parameter p-message as character no-undo .
     1357     define variable v-left-margin as integer   no-undo .
     1358     if not session:batch-mode
     1359     then do
     1360     on error undo, return error return-value
     1361     :
     1362       if length(p-message) <= 70 then do:
     1363         assign
     1364           v-left-margin = integer((70 - length(p-message)) / 2)
     1365         .
     1366         assign
     1367           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1368         .
     1369         assign
     1370           v-waitfram-action01 = " "
     1371           v-waitfram-action02 = " "
     1372                                    + fill(" ", v-left-margin)
     1373                                    + p-message
     1374           v-waitfram-action03 = " "
     1375         .
     1376       end.
     1377       else do:
     1378         define variable vRindex1 as integer no-undo.
     1379         define variable vRindex2 as integer no-undo.
     1380         vRindex1 = r-index(p-message," ",70).
     1381         if vRindex1 = 0
     1382         then
     1383            vRindex1 = 70.
     1384         if length(p-message)  <= vRindex1 + 70 then do:
     1385           assign
     1386             v-waitfram-action01 = " "
     1387             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1388             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1389           .
     1390         end.
     1391         else do:
     1392           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1393           if vRindex2 <= vRindex1
     1394           then
     1395              vRindex2 = vRindex1 + 70.
     1396           assign
     1397             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1398             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1399             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1400           .
     1401         end.
     1402       end.
     1403       B-viewProcInfo:visible   in frame waitfram = no.
     1404       B-viewProcInfo:sensitive in frame waitfram = no.
     1405       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1406       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1407       if  (   mWaitFramView
     1408          or  mWaitProcEvent)
     1409          and not mBatchMode
     1410       then
     1411          display
     1412             v-waitfram-action01 skip
     1413             v-waitfram-action02 skip
     1414             v-waitfram-action03 skip
     1415          with frame waitfram .
     1416       if     mWaitFramView
     1417          then do:
     1418             if     mWaitFramInterval ne ?
     1419                and not mBatchMode
     1420             then
     1421                wait-for go of frame waitfram pause mWaitFramInterval.
     1422          end.
     1423          else
     1424             if     mWaitProcEvent
     1425                and not mBatchMode
     1426             then
     1427                process events .
     1428     end.
     1429   end procedure.
     1430      procedure waitfram-show-this:
     1431         define input  parameter iInterval as int64 no-undo.
     1432         define variable vtime as int64 no-undo.
     1433         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1434         mWaitFramInterval = iInterval.
     1435         run waitfram-show (substitute("&1&2 &3&4" ,
     1436                                       mWaitFramTextBeg ,
     1437                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1438                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1439                                       mWaitFramTextEnd
     1440                                      )
     1441                           ).
     1442      end.
     1443      procedure WaitFramRunPause:
     1444         define input  parameter iInterval as dec no-undo.
     1445         define variable vStart  as datetime-tz no-undo.
     1446         define variable vend    as datetime-tz no-undo.
     1447         define variable vint as int64 no-undo.
     1448         define variable vOk as logical no-undo.
     1449         vStart = now.
     1450         vend   = vStart.
     1451         publish "WaitFramPause" (iInterval,output vOk).
     1452         vend   =  now.
     1453         vint = vend - vStart.
     1454         vint = iInterval - vint / 1000.
     1455         if     not mWaitFramStop
     1456            and (   vint > 0
     1457                 or (    not vOk
     1458                     and iInterval eq ?
     1459                     )
     1460                 )
     1461         then
     1462            run waitfram-show-this (iInterval).
     1463         vend   =  now.
     1464         vint = vend - vStart.
     1465         vint = iInterval - vint / 1000.
     1466         if     not mWaitFramStop
     1467            and vint > 0
     1468         then do:
     1469            run gbl/pause.p (vint * 1000).
     1470         end.
     1471         if iInterval ne ?
     1472         then
     1473            publish "WaitFramStop".
     1474         waitfram-check-timeout().
     1475      end.
     1476      procedure WaitFramWaitFor:
     1477         define input  parameter iInterval as dec no-undo.
     1478         assign
     1479            mWaitFramStartProc   = now
     1480            mWaitFramStopUser    = no
     1481            mWaitFramStopTimeOut = no
     1482         .
     1483         block-wait:
     1484         do while not mWaitFramStop:
     1485            run WaitFramRunPause (iInterval).
     1486            if  waitfram-check-timeout()
     1487            then do:
     1488               leave block-wait.
     1489            end.
     1490         end.
     1491         run waitfram-hide.
     1492      end.
     1493   procedure waitfram-join :
     1494     define input  parameter p-line-1  as character no-undo .
     1495     define input  parameter p-line-2  as character no-undo .
     1496     define input  parameter p-line-3  as character no-undo .
     1497     define output parameter p-message as character no-undo .
     1498     do
     1499     on error undo, return error return-value
     1500     :
     1501       assign
     1502         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1503                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1504                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1505       .
     1506     end.
     1507   end procedure.
     1508   function waitfram-join-function returns character
     1509     (input p-line-1 as character
     1510     ,input p-line-2 as character
     1511     ,input p-line-3 as character
     1512     ).
     1513     define variable v-message as character no-undo .
     1514     run waitfram-join in this-procedure
     1515       (input  p-line-1
     1516       ,input  p-line-2
     1517       ,input  p-line-3
     1518       ,output v-message
     1519       ) .
     1520     return v-message .
     1521   end function .
     1522   define variable v-ind         as integer   no-undo .
     1523   define variable v-line        as character no-undo format "X(120)" .
     1524   define variable l-ps as character no-undo .
     1525   assign
     1526     v-line = fill("-", 120 )
     1527   .
     1528   define variable v-line1        as character no-undo format "X(120)" .
     1529   define variable v-line2        as character no-undo format "X(120)" .
     1530   define variable v-line3        as character no-undo format "X(120)" .
     1531   assign
     1532     v-line1 = v-line
     1533     v-line2 = v-line
     1534     v-line3 = v-line
     1535   .
     1536   define variable sym1  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1537   define variable sym2  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1538   define variable sym3  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1539   define variable sym4  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1540   define variable sym5  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1541   define variable sym6  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1542   define variable sym7  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1543   define variable sym8  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1544   define variable sym9  as character no-undo format "x(1)":U label '!':U initial ":":U .
     1545   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1546   run prn-lib-open-stream  in this-procedure (
     1547                                                input parParentProc
     1548                                               ,input 45
     1549                                               ,input yes
     1550                                               ,input no
     1551                                               ).
     1552   define variable v-host-code like ub.sysconf.host-code no-undo .
     1553   define variable v-host-name   as character no-undo.
     1554   define variable v-obj-name    as character no-undo.
     1555   define variable v-header-name as character no-undo.
     1556   define variable v-print-time  as character no-undo.
     1557   define variable vardate-shift  as   character      no-undo.
     1558   define variable vardoc-qnty like ub.doc-line.doc-qnty no-undo.
     1559   define variable varcli-qnty like ub.doc-line.cli-qnty no-undo.
     1560   define variable str-inv  as character initial "" no-undo .
     1561   define variable str-inv1 as character initial "" no-undo .
     1562   define buffer buf_doc-attr     for ub.doc-attr.
     1563   define buffer buf_trn-doc      for ub.trn-doc .
     1564   define buffer buf_doc-line     for ub.doc-line .
     1565   define buffer buf_goods        for ub.goods .
     1566   define buffer buf_clients      for ub.clients .
     1567   define buffer buf_clients-attr for ub.clients-attr .
     1568   assign
     1569     v-header-name = "                           Р Е Е С Т Р  Н А  Н Е Ф Т Е П Р О Д У К Т Ы  З А  П Е Р И О Д "
     1570     v-print-time  = cur-time-string()
     1571     .
     1572   define frame doc-line-frm
     1573     sym1  space(0) vardate-shift           format "x(8)" column-label "1" space(0)
     1574     sym2  space(0) buf_trn-doc.doc-code        format "x(14)" column-label "2" space(0)
     1575     sym3  space(0) buf_doc-line.doc-qnty       format ">>>,>>>,>>9.<<<" column-label "3" space(0)
     1576     sym4  space(0) vardoc-qnty             format ">>>,>>>,>>9.<<<" column-label "4" space(0)
     1577     sym5  space(0) buf_doc-line.doc-density    format ">>>,>>>,>>9.<<<" column-label "5" space(0)
     1578     sym6  space(0) buf_doc-line.cli-qnty       format ">>>,>>>,>>9.<<<" column-label "6" space(0)
     1579     sym7  space(0) varcli-qnty             format ">>>,>>>,>>9.<<<" column-label "7" space(0)
     1580     sym8  space(0) l-ps                    format "x(29)" column-label "8" space(0)
     1581     sym9  space(0)
     1582     with width 123  down stream-io use-text .
     1583   form with frame doc-line-frm .
     1584   find first buf_goods where buf_goods.gds-code = pargds-code no-lock.
     1585   for each obj-list :
     1586             parobj-type = obj-list.obj-type .
     1587             parobj-code = obj-list.obj-code .
     1588             find first buf_clients no-lock
     1589               where buf_clients.obj-type = parobj-type
     1590                 and buf_clients.obj-code = parobj-code
     1591               .
     1592             assign
     1593               v-obj-name = buf_clients.obj-name
     1594             .
     1595   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1597     (input  parobj-type
     1598     ,input  parobj-code
     1599     ,output v-host-code
     1600     )  .
     1601             find first frm-clients no-lock
     1602               where frm-clients.obj-type = 'орг':U
     1603                 and frm-clients.obj-code = v-host-code
     1604               .
     1605             assign
     1606               v-host-name = frm-clients.obj-name
     1607             .
     1608             put stream PrnLibStream unformatted
     1609               "   Наименование организации " string(v-host-name + fill(" ", 40), "x(40)")  skip
     1610               "   АЗС: "  v-obj-name  skip
     1611               "                           Р Е Е С Т Р  Н А  Н Е Ф Т Е П Р О Д У К Т Ы  З А  П Е Р И О Д " skip
     1612               "   Начало периода " (if pardate-shift <= 2 then string(parstart_date) else string(parstart_date) + ":" + string(parstart_shift_num)) skip
     1613               "   Конец периода  " (if pardate-shift <= 2 then string(parend_date)   else string(parend_date)   + ":" + string(parend_shift_num))   skip
     1614               "   Наименование нефтепродукта " buf_goods.artic " " buf_goods.gds-name skip
     1615               .
     1616             put stream PrnLibStream unformatted
     1617               v-line skip
     1618               STRING("!         ", "X(9)") STRING("!              ", "X(15)") STRING("!            ", "X(13)") STRING("!            ", "X(13)") STRING("!            ", "X(13)") STRING("!            ", "X(13)") STRING("!            !", "X(14)") STRING("                             !", "X(30)")  skip
     1619               STRING("!         ", "X(9)") STRING("!              ", "X(15)") STRING("! Количество ", "X(13)") STRING("!Суммарно от ", "X(13)") STRING("!Плотность по", "X(13)") STRING("! Количество ", "X(13)") STRING("!Суммарно от !", "X(14)") STRING("            № ТТН            !", "X(30)")  skip
     1620               STRING("!  Дата   ", "X(9)") STRING("!    № ТТН     ", "X(15)") STRING("!   по ТТН   ", "X(13)") STRING("!   начала   ", "X(13)") STRING("!    ТТН     ", "X(13)") STRING("!      по    ", "X(13)") STRING("!   начала   !", "X(14)") STRING("         от поставщика       !", "X(30)")  skip
     1621               STRING("!         ", "X(9)") STRING("!              ", "X(15)") STRING("!  в литрах  ", "X(13)") STRING("!  периода   ", "X(13)") STRING("! в г/куб.см ", "X(13)") STRING("!   ТТН в кг ", "X(13)") STRING("!   периода  !", "X(14)") STRING("                             !", "X(30)")  skip
     1622               STRING("!         ", "X(9)") STRING("!              ", "X(15)") STRING("!            ", "X(13)") STRING("!  в литрах  ", "X(13)") STRING("!            ", "X(13)") STRING("!            ", "X(13)") STRING("!    в кг    !", "X(14)") STRING("                             !", "X(30)")  skip
     1623               v-line
     1624               .
     1625             form header
     1626               v-line1 at 1 skip
     1627               v-header-name format "x(50)" at 1
     1628                 "Дата:" at 60
     1629                 v-print-time format "x(20)"
     1630                 "Стр." at 69 string( page-number(PrnLibStream), ">>>9" )  skip
     1631               v-line2 at 1 skip
     1632               with frame topframe
     1633               width 123 page-top no-labels no-box .
     1634             view stream PrnLibStream frame topframe .
     1635             form header
     1636               v-line skip
     1637               "Продолжение на следующей странице " at 30 skip
     1638               with frame bottomframe
     1639               width 123 page-bottom no-labels no-box .
     1640             view stream PrnLibStream frame bottomframe .
     1641             assign vardoc-qnty = 0
     1642                   varcli-qnty = 0.
     1643   CASE pardate-shift :
     1644       WHEN 1 THEN DO:
     1645               for each buf_trn-doc where                             buf_trn-doc.obj-type    = parobj-type and                             buf_trn-doc.obj-code    = parobj-code and                             buf_trn-doc.fact-date >= parstart_date and buf_trn-doc.fact-date <= parend_date and                             buf_trn-doc.status_     = 'факт':U                              and buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = no,                                                     each buf_doc-line no-lock where                             buf_doc-line.doc-code   = buf_trn-doc.doc-code     and                             buf_doc-line.artic      = buf_goods.artic     and                             buf_doc-line.prod-type  = buf_goods.prod-type and                             buf_doc-line.prod-code  = buf_goods.prod-code                                                  :
     1646   find first buf_clients-attr no-lock
     1647     where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1648       and buf_clients-attr.obj-code   = buf_trn-doc.cli-code
     1649       and buf_clients-attr.attr-code  = 'shftrep2':U
     1650       and buf_clients-attr.attr-value = "yes":U
     1651     no-error .
     1652   if available  buf_clients-attr then next .
     1653     str-inv1 = "" .
     1654     str-inv = ""  .
     1655     find first buf_doc-attr no-lock
     1656       where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     1657         and buf_doc-attr.attr-code = 'nids':U
     1658     no-error .
     1659     if avail buf_doc-attr then assign  str-inv1 = buf_doc-attr.attr-value .
     1660     find first buf_doc-attr no-lock
     1661       where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     1662         and buf_doc-attr.attr-code = 'dids':U
     1663     no-error .
     1664     if avail buf_doc-attr then assign  str-inv1 = str-inv1  +  ( if  buf_doc-attr.attr-value <> ? and buf_doc-attr.attr-value <> ""  then (  " от " + buf_doc-attr.attr-value ) else " " ).
     1665     if trim(str-inv1) <> "" then assign str-inv = "Основ. " .
     1666   assign vardoc-qnty = vardoc-qnty + buf_doc-line.doc-qnty
     1667          varcli-qnty = varcli-qnty + buf_doc-line.cli-qnty
     1668          l-ps = str-inv1
     1669          .
     1670   display stream PrnLibStream
     1671     sym1 string(buf_trn-doc.fact-date) + ":" + string(buf_trn-doc.shift-name) @ vardate-shift
     1672     sym2 buf_trn-doc.doc-code
     1673     sym3 buf_doc-line.doc-qnty
     1674     sym4 vardoc-qnty
     1675     sym5 buf_doc-line.doc-density
     1676     sym6 buf_doc-line.cli-qnty
     1677     sym7 varcli-qnty
     1678     sym8 l-PS
     1679     sym9
     1680     with frame doc-line-frm .
     1681     down stream PrnLibStream 1 with frame doc-line-frm.
     1682                        end.
     1683       END.
     1684       WHEN 2 THEN DO:
     1685               for each buf_trn-doc where                             buf_trn-doc.obj-type    = parobj-type and                             buf_trn-doc.obj-code    = parobj-code and                             buf_trn-doc.shift-date >= parstart_date and buf_trn-doc.shift-date <= parend_date and                             buf_trn-doc.status_     = 'факт':U                              and buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = no,                                                     each buf_doc-line no-lock where                             buf_doc-line.doc-code   = buf_trn-doc.doc-code     and                             buf_doc-line.artic      = buf_goods.artic     and                             buf_doc-line.prod-type  = buf_goods.prod-type and                             buf_doc-line.prod-code  = buf_goods.prod-code                                                  :
     1686   find first buf_clients-attr no-lock
     1687     where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1688       and buf_clients-attr.obj-code   = buf_trn-doc.cli-code
     1689       and buf_clients-attr.attr-code  = 'shftrep2':U
     1690       and buf_clients-attr.attr-value = "yes":U
     1691     no-error .
     1692   if available  buf_clients-attr then next .
     1693     str-inv1 = "" .
     1694     str-inv = ""  .
     1695     find first buf_doc-attr no-lock
     1696       where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     1697         and buf_doc-attr.attr-code = 'nids':U
     1698     no-error .
     1699     if avail buf_doc-attr then assign  str-inv1 = buf_doc-attr.attr-value .
     1700     find first buf_doc-attr no-lock
     1701       where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     1702         and buf_doc-attr.attr-code = 'dids':U
     1703     no-error .
     1704     if avail buf_doc-attr then assign  str-inv1 = str-inv1  +  ( if  buf_doc-attr.attr-value <> ? and buf_doc-attr.attr-value <> ""  then (  " от " + buf_doc-attr.attr-value ) else " " ).
     1705     if trim(str-inv1) <> "" then assign str-inv = "Основ. " .
     1706   assign vardoc-qnty = vardoc-qnty + buf_doc-line.doc-qnty
     1707          varcli-qnty = varcli-qnty + buf_doc-line.cli-qnty
     1708          l-ps = str-inv1
     1709          .
     1710   display stream PrnLibStream
     1711     sym1 string(buf_trn-doc.fact-date) + ":" + string(buf_trn-doc.shift-name) @ vardate-shift
     1712     sym2 buf_trn-doc.doc-code
     1713     sym3 buf_doc-line.doc-qnty
     1714     sym4 vardoc-qnty
     1715     sym5 buf_doc-line.doc-density
     1716     sym6 buf_doc-line.cli-qnty
     1717     sym7 varcli-qnty
     1718     sym8 l-PS
     1719     sym9
     1720     with frame doc-line-frm .
     1721     down stream PrnLibStream 1 with frame doc-line-frm.
     1722                        end.
     1723       END.
     1724       WHEN 3 THEN DO:
     1725                 for each buf_trn-doc where                             buf_trn-doc.obj-type    = parobj-type and                             buf_trn-doc.obj-code    = parobj-code and                             ( buf_trn-doc.shift-date >  parstart_date        or                                buf_trn-doc.shift-date  = parstart_date        and                               buf_trn-doc.shift-num  >= parstart_shift_num ) and                             ( buf_trn-doc.shift-date <  parend_date          or                                buf_trn-doc.shift-date  = parend_date          and                               buf_trn-doc.shift-num  <= parend_shift_num )   and                             buf_trn-doc.status_     = 'факт':U                              and buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = no,                                                     each buf_doc-line no-lock where                             buf_doc-line.doc-code   = buf_trn-doc.doc-code     and                             buf_doc-line.artic      = buf_goods.artic     and                             buf_doc-line.prod-type  = buf_goods.prod-type and                             buf_doc-line.prod-code  = buf_goods.prod-code                                                  :
     1726   find first buf_clients-attr no-lock
     1727     where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1728       and buf_clients-attr.obj-code   = buf_trn-doc.cli-code
     1729       and buf_clients-attr.attr-code  = 'shftrep2':U
     1730       and buf_clients-attr.attr-value = "yes":U
     1731     no-error .
     1732   if available  buf_clients-attr then next .
     1733     str-inv1 = "" .
     1734     str-inv = ""  .
     1735     find first buf_doc-attr no-lock
     1736       where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     1737         and buf_doc-attr.attr-code = 'nids':U
     1738     no-error .
     1739     if avail buf_doc-attr then assign  str-inv1 = buf_doc-attr.attr-value .
     1740     find first buf_doc-attr no-lock
     1741       where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     1742         and buf_doc-attr.attr-code = 'dids':U
     1743     no-error .
     1744     if avail buf_doc-attr then assign  str-inv1 = str-inv1  +  ( if  buf_doc-attr.attr-value <> ? and buf_doc-attr.attr-value <> ""  then (  " от " + buf_doc-attr.attr-value ) else " " ).
     1745     if trim(str-inv1) <> "" then assign str-inv = "Основ. " .
     1746   assign vardoc-qnty = vardoc-qnty + buf_doc-line.doc-qnty
     1747          varcli-qnty = varcli-qnty + buf_doc-line.cli-qnty
     1748          l-ps = str-inv1
     1749          .
     1750   display stream PrnLibStream
     1751     sym1 string(buf_trn-doc.fact-date) + ":" + string(buf_trn-doc.shift-name) @ vardate-shift
     1752     sym2 buf_trn-doc.doc-code
     1753     sym3 buf_doc-line.doc-qnty
     1754     sym4 vardoc-qnty
     1755     sym5 buf_doc-line.doc-density
     1756     sym6 buf_doc-line.cli-qnty
     1757     sym7 varcli-qnty
     1758     sym8 l-PS
     1759     sym9
     1760     with frame doc-line-frm .
     1761     down stream PrnLibStream 1 with frame doc-line-frm.
     1762                        end.
     1763       END.
     1764       WHEN 4 THEN DO:
     1765                  for each buf_trn-doc where                             buf_trn-doc.obj-type    = parobj-type and                             buf_trn-doc.obj-code    = parobj-code and                             buf_trn-doc.shift-date >= parstart_date      and                             buf_trn-doc.shift-num   = parstart_shift_num and                             buf_trn-doc.shift-date <= parend_date        and                             buf_trn-doc.shift-num   = parend_shift_num   and                             buf_trn-doc.status_     = 'факт':U                              and buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = no,                                                     each buf_doc-line no-lock where                             buf_doc-line.doc-code   = buf_trn-doc.doc-code     and                             buf_doc-line.artic      = buf_goods.artic     and                             buf_doc-line.prod-type  = buf_goods.prod-type and                             buf_doc-line.prod-code  = buf_goods.prod-code                                                  :
     1766   find first buf_clients-attr no-lock
     1767     where buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     1768       and buf_clients-attr.obj-code   = buf_trn-doc.cli-code
     1769       and buf_clients-attr.attr-code  = 'shftrep2':U
     1770       and buf_clients-attr.attr-value = "yes":U
     1771     no-error .
     1772   if available  buf_clients-attr then next .
     1773     str-inv1 = "" .
     1774     str-inv = ""  .
     1775     find first buf_doc-attr no-lock
     1776       where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     1777         and buf_doc-attr.attr-code = 'nids':U
     1778     no-error .
     1779     if avail buf_doc-attr then assign  str-inv1 = buf_doc-attr.attr-value .
     1780     find first buf_doc-attr no-lock
     1781       where buf_doc-attr.doc-code  = buf_trn-doc.doc-code
     1782         and buf_doc-attr.attr-code = 'dids':U
     1783     no-error .
     1784     if avail buf_doc-attr then assign  str-inv1 = str-inv1  +  ( if  buf_doc-attr.attr-value <> ? and buf_doc-attr.attr-value <> ""  then (  " от " + buf_doc-attr.attr-value ) else " " ).
     1785     if trim(str-inv1) <> "" then assign str-inv = "Основ. " .
     1786   assign vardoc-qnty = vardoc-qnty + buf_doc-line.doc-qnty
     1787          varcli-qnty = varcli-qnty + buf_doc-line.cli-qnty
     1788          l-ps = str-inv1
     1789          .
     1790   display stream PrnLibStream
     1791     sym1 string(buf_trn-doc.fact-date) + ":" + string(buf_trn-doc.shift-name) @ vardate-shift
     1792     sym2 buf_trn-doc.doc-code
     1793     sym3 buf_doc-line.doc-qnty
     1794     sym4 vardoc-qnty
     1795     sym5 buf_doc-line.doc-density
     1796     sym6 buf_doc-line.cli-qnty
     1797     sym7 varcli-qnty
     1798     sym8 l-PS
     1799     sym9
     1800     with frame doc-line-frm .
     1801     down stream PrnLibStream 1 with frame doc-line-frm.
     1802                        end.
     1803       END.
     1804   END CASE.
     1805             put stream PrnLibStream
     1806               v-line
     1807               skip(2)
     1808               .
     1809             put stream PrnLibStream unformatted
     1810               "   Начальник АЗС ___________________________ "
     1811               .
     1812   end.
     1813   hide stream PrnLibStream frame bottomframe .
     1814   output stream PrnLibStream close.
     1815   run waitfram-hide in this-procedure .
     1816   run prn-lib-prn-file in this-procedure (
     1817                                             input parParentProc
     1818                                             ,input 7
     1819                                             ).
