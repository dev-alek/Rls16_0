     5297     define input parameter p-report-name-html as character no-undo .
     5298     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     5299   end procedure.
     5300   procedure prn-lib-reportviewer :
     5301     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5302     define input parameter p-report-name-html as character no-undo .
     5303     define input parameter p-param        as character no-undo .
     5304     define variable v-excel           as character no-undo init 'TRUE' .
     5305     define variable v-value-character as character no-undo .
     5306     define variable v-value-integer   as character no-undo .
     5307     define variable v-value-date      as date      no-undo .
     5308     define variable v-value-decimal   as decimal   no-undo .
     5309     define variable rep-excel         as logical   no-undo .
     5310     define variable excel-string      as character no-undo .
     5311     define variable v-param-type      as character no-undo .
     5312     define variable v-tth             as handle    no-undo .
     5313     run adm/shattri.p (
     5314       input "get":U
     5315       ,input  ""
     5316       ,input  0
     5317       ,input  'report-glob':U
     5318       ,input  'rep-excel':U
     5319       ,output v-value-character
     5320       ,output v-value-date
     5321       ,output v-value-decimal
     5322       ,output v-value-integer
     5323       ,output rep-excel
     5324       ,output v-param-type
     5325       ,INPUT-OUTPUT table-handle v-tth
     5326       )  .
     5327     if rep-excel then v-excel = "TRUE" .
     5328     else v-excel = "FALSE" .
     5329     if p-param eq ""
     5330     then
     5331        p-param = "EXCEL:" + v-excel.
     5332     else
     5333        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     5334     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     5335   end procedure.
     5336   function fnc-convert-dot-to-colon returns character
     5337       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     5338   function fnc-convert-dot-to-colon returns character
     5339   (input p-data as decimal, input p-accur as character, input p-num as integer):
     5340       define variable result as character no-undo.
     5341       define variable v-str-result as character no-undo.
     5342       if p-data = ? then p-data = 0 .
     5343       p-data = round(p-data, p-num).
     5344       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     5345       return v-str-result.
     5346   END FUNCTION.
     5347   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5348     define variable v-cntxt-db-num        as integer   no-undo .
     5349     define variable v-cntxt-userid        as character no-undo .
     5350     define variable v-cntxt-level         as character no-undo .
     5351     define variable v-cntxt-host-code-obj as integer   no-undo .
     5352     define variable v-cntxt-obj-type      as character no-undo .
     5353     define variable v-cntxt-obj-code      as integer   no-undo .
     5354     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5355     define variable v-cntxt-is-admin      as logical   no-undo .
     5356   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5357     run mainmenu_getcntxt in parparentproc
     5358       (output v-cntxt-db-num
     5359       ,output v-cntxt-userid
     5360       ,output v-cntxt-level
     5361       ,output v-cntxt-host-code-obj
     5362       ,output v-cntxt-obj-type
     5363       ,output v-cntxt-obj-code
     5364       ,output v-cntxt-db-num-obj
     5365       ,output v-cntxt-is-admin
     5366       ) .
     5367   define stream Out-Stream.
     5368   define stream OutStr-html.
     5369   DEFINE TEMP-TABLE tt-return
     5370     field obj-code as integer
     5371     field obj-type as character
     5372     field obj-name as character
     5373     field date_    as date
     5374     field time_    as integer
     5375     field chk-num  as integer
     5376     field doc-code as character
     5377     field chk-type as character
     5378     field cash-num as integer
     5379     field fio      as character
     5380     Index pi obj-code obj-type doc-code
     5381     .
     5382   DEFINE TEMP-TABLE tt-gds-pay
     5383     field obj-code  as integer
     5384     field obj-type  as character
     5385     field doc-code  as character
     5386     field gds-code  as integer
     5387     field gds-name  as character
     5388     field price     as decimal
     5389     field qnty      as decimal
     5390     field sum_      as decimal
     5391     field d-card    as character
     5392     field line-num  as integer
     5393     field pay-type  as character
     5394     field p-card    as character
     5395     field pay_qnty  as decimal
     5396     field sum_total as decimal
     5397     field print     as integer
     5398     field sbprrn    as character
     5399     field sbpstat   as character
     5400     Index pi obj-code obj-type doc-code line-num
     5401     .
     5402   define VARIABLE p-report-id         as character no-undo .
     5403   define variable v-file-name-rep-htm as character no-undo .
     5404   define VARIABLE v-attr-value        as character no-undo .
     5405   define variable v-obj-type          as character no-undo .
     5406   define variable v-obj-code          as integer   no-undo .
     5407   define variable v-obj-name          as character no-undo .
     5408   define variable v-period            as character no-undo .
     5409   define variable v-list-obj          as character no-undo .
     5410   define variable v-print-date        as character no-undo .
     5411   define variable v-doc-num2          as character no-undo .
     5412   define variable v-name-chk-type     as character no-undo .
     5413   define variable v-gds-line          as logical   no-undo .
     5414   define variable v-pay-line          as logical   no-undo .
     5415   define variable ii                  as integer   no-undo .
     5416   define variable jj                  as integer   no-undo .
     5417   define buffer buf_chk-doc      for ub.chk-doc .
     5418   define buffer bf_chk-doc       for ub.chk-doc .
     5419   define buffer buf_clients      for ub.clients .
     5420   define buffer buf_chk-disnt    for ub.chk-discnt .
     5421   define buffer buf_chk-pay-attr for ub.chk-pay-attr .
     5422   define buffer buf_chk-pay      for ub.chk-pay .
     5423   define buffer buf_chk-gds      for ub.chk-gds .
     5424   define buffer buf_chk-gds-pay  for ub.chk-gds-pay .
     5425   define buffer buf_goods        for ub.goods .
     5426   define buffer buf_bar-code     for ub.bar-code .
     5427   define buffer buf_cash-pay     for ub.cash-pay .
     5428   do
     5429     on error undo, return error return-value
     5430     :
     5431     find first obj-list no-error .
     5432     if not available obj-list then
     5433     do:
     5434       message
     5435         "Не указан объект для формирования отчета!"
     5436         view-as alert-box error.
     5437       undo, return error.
     5438     end.
     5439     DEFINE VARIABLE v-dop   AS character NO-UNDO .
     5440     DEFINE VARIABLE v-value AS character NO-UNDO.
     5441     DEFINE VARIABLE v-type  AS character NO-UNDO.
     5442     if x-TOG-Shift then
     5443     do:
     5444       v-period = "Смены с " + string (x-Shift-Start) + " по " + string (x-Shift-End) + " За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5445     end.
     5446     else
     5447     do:
     5448       v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5449     end.
     5450     run clients-write(INPUT v-cntxt-host-code-obj, INPUT 'орг':U, OUTPUT v-obj-name) no-error .
     5451     DEFINE VARIABLE v-today as date    no-undo .
     5452     DEFINE VARIABLE v-time  as integer no-undo .
     5453     run cur-time in this-procedure (
     5454       output v-today
     5455       , output v-time
     5456       ).
     5457     v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     5458     for each obj-list no-lock:
     5459       if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     5460       else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     5461       if x-TOG-Shift then
     5462       do:
     5463         for each buf_chk-doc no-lock
     5464           where buf_chk-doc.obj-code = obj-list.obj-code
     5465           and buf_chk-doc.obj-type = obj-list.obj-type
     5466           and buf_chk-doc.shift-date >= x-Date-Start
     5467           and buf_chk-doc.shift-date <= x-Date-End
     5468           and buf_chk-doc.out-code <> ?
     5469           and  (buf_chk-doc.chk-type = integer('6':U)
     5470           or buf_chk-doc.chk-type = integer('96':U)):
     5471           if (buf_chk-doc.shift-date = X-date-Start)
     5472             and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     5473           if (buf_chk-doc.shift-date = X-date-End)
     5474             and (buf_chk-doc.shift-num > x-Shift-End) then next.
     5475           run report .
     5476         end.
     5477       end.
     5478       else
     5479       do:
     5480         for each buf_chk-doc no-lock
     5481           where buf_chk-doc.obj-code = obj-list.obj-code
     5482           and buf_chk-doc.obj-type = obj-list.obj-type
     5483           and buf_chk-doc.chk-date >= x-Date-Start
     5484           and buf_chk-doc.chk-date <= x-Date-End
     5485           and buf_chk-doc.out-code <> ?
     5486           and  (buf_chk-doc.chk-type = integer('6':U)
     5487           or buf_chk-doc.chk-type = integer('96':U))  :
     5488           run report .
     5489         end.
     5490       end.
     5491     end.
     5492   procedure report:
     5493     ii = 0 .
     5494     jj = 0 .
     5495     find first tt-return where tt-return.doc-code = buf_chk-doc.doc-code and tt-return.obj-code = buf_chk-doc.obj-code
     5496       and tt-return.obj-type = buf_chk-doc.obj-type no-error .
     5497     if not available (tt-return) then
     5498     do:
     5499       create tt-return .
     5500       assign
     5501         tt-return.doc-code = buf_chk-doc.doc-code
     5502         tt-return.obj-code = buf_chk-doc.obj-code
     5503         tt-return.obj-type = buf_chk-doc.obj-type
     5504         tt-return.cash-num = buf_chk-doc.pay-desk
     5505         tt-return.chk-num  = buf_chk-doc.chk-num
     5506         tt-return.date_    = buf_chk-doc.chk-date
     5507         tt-return.time_    = buf_chk-doc.chk-time
     5508         .
     5509       run ConvertStr-chk-type(INPUT buf_chk-doc.chk-type,OUTPUT tt-return.chk-type) .
     5510       run clients-write(INPUT buf_chk-doc.cashier-psn-code,INPUT 'чел':U,OUTPUT tt-return.fio) .
     5511       run clients-write(INPUT buf_chk-doc.obj-code,INPUT buf_chk-doc.obj-type,OUTPUT tt-return.obj-name) .
     5512     end.
     5513     for each buf_chk-gds no-lock where buf_chk-gds.doc-code = tt-return.doc-code,
     5514       first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code,
     5515       first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code:
     5516       find first buf_chk-gds-pay no-lock where buf_chk-gds-pay.line-num = buf_chk-gds.line-num and buf_chk-gds-pay.doc-code = buf_chk-gds.doc-code no-error .
     5517       ii = ii + 1 .
     5518       find first tt-gds-pay where tt-gds-pay.doc-code = tt-return.doc-code and tt-gds-pay.obj-code = tt-return.obj-code
     5519         and tt-gds-pay.obj-type = tt-return.obj-type and tt-gds-pay.line-num = ii no-error .
     5520       if not available (tt-gds-pay) then
     5521       do:
     5522         create tt-gds-pay .
     5523         assign
     5524           tt-gds-pay.doc-code = tt-return.doc-code
     5525           tt-gds-pay.obj-code = tt-return.obj-code
     5526           tt-gds-pay.obj-type = tt-return.obj-type
     5527           tt-gds-pay.line-num = ii
     5528           tt-gds-pay.gds-code = buf_goods.gds-code
     5529           tt-gds-pay.gds-name = buf_goods.gds-name .
     5530         if available (buf_chk-gds-pay) then tt-gds-pay.price    = buf_chk-gds-pay.price-base .
     5531         tt-gds-pay.qnty     = buf_chk-gds.doc-qnty .
     5532         if available (buf_chk-gds-pay) then tt-gds-pay.sum_     = buf_chk-gds-pay.tot-r-b .
     5533         if buf_chk-gds.d-card <> ? then do:
     5534         if length (buf_chk-gds.d-card) = 9 then tt-gds-pay.d-card = "XXXXX" + substring (buf_chk-gds.d-card,5,4).
     5535         else tt-gds-pay.d-card = substring(buf_chk-gds.d-card,1,6) + "XXXXXX" + substring (buf_chk-gds.d-card,13,4).
     5536         end.
     5537         else tt-gds-pay.d-card = "" .
     5538       end.
     5539     end.
     5540     for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code:
     5541       jj = jj + 1 .
     5542       find first tt-gds-pay where tt-gds-pay.doc-code = buf_chk-pay.doc-code and tt-gds-pay.obj-code = buf_chk-pay.obj-code
     5543         and tt-gds-pay.obj-type = buf_chk-pay.obj-type and tt-gds-pay.line-num = jj no-error .
     5544       if not available (tt-gds-pay) then
     5545       do:
     5546         create tt-gds-pay .
     5547         assign
     5548           tt-gds-pay.doc-code = buf_chk-pay.doc-code
     5549           tt-gds-pay.line-num = jj
     5550           tt-gds-pay.obj-code = buf_chk-pay.obj-code
     5551           tt-gds-pay.obj-type = buf_chk-pay.obj-type
     5552           .
     5553       end.
     5554       assign
     5555         tt-gds-pay.pay-type  = string(buf_chk-pay.pay-code)
     5556         tt-gds-pay.pay_qnty  = buf_chk-pay.tot-rubl
     5557         tt-gds-pay.sum_total = buf_chk-doc.tot-doc
     5558         .
     5559       if buf_chk-pay.pay-card <> ? and buf_chk-pay.pay-card <> "" and buf_chk-pay.pay-card <> "0" then do:
     5560       if length (buf_chk-pay.pay-card) = 9 then tt-gds-pay.p-card = "XXXXX" + substring (buf_chk-pay.pay-card,5,4).
     5561       else tt-gds-pay.p-card = substring(buf_chk-pay.pay-card,1,6) + "XXXXXX" + substring (buf_chk-pay.pay-card,13,4).
     5562       end.
     5563       run ConvertStr-pay-type(INPUT buf_chk-pay.pay-code,OUTPUT tt-gds-pay.pay-type) .
     5564       for first buf_chk-pay-attr no-lock where buf_chk-pay-attr.attr-code = "CPAgreement"
     5565         and buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code and buf_chk-pay-attr.line-num = buf_chk-pay.line-num:
     5566         tt-gds-pay.print = 1 .
     5567       end.
     5568       for first buf_chk-pay-attr no-lock where buf_chk-pay-attr.attr-code = "sbpstat"
     5569         and buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code and buf_chk-pay-attr.line-num = buf_chk-pay.line-num:
     5570         tt-gds-pay.sbpstat = buf_chk-pay-attr.attr-value .
     5571       end.
     5572       for first buf_chk-pay-attr no-lock where buf_chk-pay-attr.attr-code = "sbprrn"
     5573         and buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code and buf_chk-pay-attr.line-num = buf_chk-pay.line-num:
     5574         tt-gds-pay.sbprrn = buf_chk-pay-attr.attr-value .
     5575       end.
     5576               if p-oplat <> "" and LOOKUP(string(buf_chk-pay.pay-code), p-oplat) = 0 then do:
     5577                 if available (tt-gds-pay) then delete tt-gds-pay .
     5578                 if available (tt-return) then  delete tt-return .
     5579               end.
     5580     end.
     5581   end procedure.
     5582     run get-report-num (output p-report-id).
     5583     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     5584     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     5585     put stream OutStr-html unformatted
     5586       "<!DOCTYPE HTML>" skip
     5587       ' <html>' skip
     5588       '  <head>' skip
     5589       '   <meta charset="utf-8">' skip
     5590       '    <style type="text/css">' skip
     5591       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5592       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5593       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     5594       '   </style>' skip
     5595       '  </head>' skip
     5596       .
     5597     put stream OutStr-html unformatted
     5598       '<body>' skip
     5599       '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     5600       '<thead>' skip
     5601       .
     5602       if p-itog then do:
     5603     put stream OutStr-html unformatted
     5604       '<tr class="set_columns">' skip
     5605       '<td style="width: 160px;"></td>' skip
     5606       '<td style="width: 160px;"></td>' skip
     5607       '<td style="width: 60px;"></td>' skip
     5608       '<td style="width: 60px;"></td>' skip
     5609       '<td style="width: 60px;"></td>' skip
     5610       '<td style="width: 160px;"></td>' skip
     5611       '<td style="width: 160px;"></td>' skip
     5612       '<td style="width: 160px;"></td>' skip
     5613       '<td style="width: 160px;"></td>' skip
     5614       '<td style="width: 60px;"></td>' skip
     5615       '<td style="width: 60px;"></td>' skip
     5616       '<td style="width: 100px;"></td>' skip
     5617       '<td style="width: 100px;"></td>' skip
     5618       '<td style="width: 150px;"></td>' skip
     5619       '</tr>' skip
     5620       .
     5621     put stream OutStr-html unformatted
     5622       '<TR><TD colspan="14"></TD></TR>' skip
     5623       '<TR>' skip
     5624       '<TD colspan="14" style="font-weight: bold;">Отчет для контроля возвратных операций</TD>' skip
     5625       '</TR>'skip
     5626       '<TR>' skip
     5627       '<TD colspan="14">' + v-period + '</TD>' skip
     5628       '</TR>'skip
     5629       '<TR>' skip
     5630       '<TD colspan="14">' + v-obj-name + '</TD>' skip
     5631       '</TR>'skip
     5632       '<TR>' skip
     5633       '<TD colspan="14">Выбор объекта:</TD>' skip
     5634       '</TR>'skip
     5635       '<TR>' skip
     5636       '<TD colspan="14">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     5637       '</TR>'skip
     5638       '<TR>' skip
     5639       '<TD colspan="14">' + v-print-date + '</TD>' skip
     5640       '</TR>'skip
     5641       '</thead>' skip
     5642       '<tbody>' skip
     5643       .
     5644     put stream OutStr-html unformatted
     5645       '<TR>' skip
     5646       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Дата и время чека</TD>' skip
     5647       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Название АЗК/АЗС</TD>' skip
     5648       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Номер чека</TD>' skip
     5649       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Тип чека</TD>' skip
     5650       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Номер кассы</TD>' skip
     5651       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">ФИО кассира</TD>' skip
     5652       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Номер дисконтной карты</TD>' skip
     5653       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Вид оплаты</TD>' skip
     5654       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Номер платежной карты</TD>' skip
     5655       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Сумма возврата по типу оплаты</TD>' skip
     5656       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Общая сумма возврата</TD>' skip
     5657       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Печать без повторного обращения к ПЦ</TD>' skip
     5658       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Неопределенный статус возврата через СБП</TD>' skip
     5659       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">RRN СБП</TD>' skip
     5660       '</TR>'skip
     5661       .
     5662       end.
     5663       else do:
     5664     put stream OutStr-html unformatted
     5665       '<tr class="set_columns">' skip
     5666       '<td style="width: 160px;"></td>' skip
     5667       '<td style="width: 160px;"></td>' skip
     5668       '<td style="width: 60px;"></td>' skip
     5669       '<td style="width: 60px;"></td>' skip
     5670       '<td style="width: 60px;"></td>' skip
     5671       '<td style="width: 160px;"></td>' skip
     5672       '<td style="width: 80px;"></td>' skip
     5673       '<td style="width: 160px;"></td>' skip
     5674       '<td style="width: 60px;"></td>' skip
     5675       '<td style="width: 60px;"></td>' skip
     5676       '<td style="width: 60px;"></td>' skip
     5677       '<td style="width: 160px;"></td>' skip
     5678       '<td style="width: 160px;"></td>' skip
     5679       '<td style="width: 160px;"></td>' skip
     5680       '<td style="width: 60px;"></td>' skip
     5681       '<td style="width: 60px;"></td>' skip
     5682       '<td style="width: 100px;"></td>' skip
     5683       '<td style="width: 100px;"></td>' skip
     5684       '<td style="width: 150px;"></td>' skip
     5685       '</tr>' skip
     5686       .
     5687     put stream OutStr-html unformatted
     5688       '<TR><TD colspan="19"></TD></TR>' skip
     5689       '<TR>' skip
     5690       '<TD colspan="19" style="font-weight: bold;">Отчет для контроля возвратных операций</TD>' skip
     5691       '</TR>'skip
     5692       '<TR>' skip
     5693       '<TD colspan="19">' + v-period + '</TD>' skip
     5694       '</TR>'skip
     5695       '<TR>' skip
     5696       '<TD colspan="19">' + v-obj-name + '</TD>' skip
     5697       '</TR>'skip
     5698       '<TR>' skip
     5699       '<TD colspan="17">Выбор объекта:</TD>' skip
     5700       '</TR>'skip
     5701       '<TR>' skip
     5702       '<TD colspan="19">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     5703       '</TR>'skip
     5704       '<TR>' skip
     5705       '<TD colspan="19">' + v-print-date + '</TD>' skip
     5706       '</TR>'skip
     5707       '</thead>' skip
     5708       '<tbody>' skip
     5709       .
     5710     put stream OutStr-html unformatted
     5711       '<TR>' skip
     5712       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Дата и время чека</TD>' skip
     5713       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Название АЗК/АЗС</TD>' skip
     5714       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Номер чека</TD>' skip
     5715       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Тип чека</TD>' skip
     5716       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Номер кассы</TD>' skip
     5717       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">ФИО кассира</TD>' skip
     5718       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Код товара</TD>' skip
     5719       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Название товара</TD>' skip
     5720       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Цена в чеке</TD>' skip
     5721       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Количество в чеке</TD>' skip
     5722       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Стоимость в чеке</TD>' skip
     5723       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Номер дисконтной карты</TD>' skip
     5724       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Вид оплаты</TD>' skip
     5725       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Номер платежной карты</TD>' skip
     5726       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Сумма возврата по типу оплаты</TD>' skip
     5727       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Общая сумма возврата</TD>' skip
     5728       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Печать без повторного обращения к ПЦ</TD>' skip
     5729       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Неопределенный статус возврата через СБП</TD>' skip
     5730       '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">RRN СБП</TD>' skip
     5731       '</TR>'skip
     5732       .
     5733       end.
     5734     for each tt-return:
     5735       v-pay-line = no .
     5736       v-gds-line = no .
     5737       put stream OutStr-html unformatted
     5738         '<TR>' skip
     5739         '<TD text_wrap="true" style="text-align: center;">' + string(tt-return.date_,"99/99/9999") + " " + string(tt-return.time_,"HH:MM:SS") + '</TD>' skip
     5740         '<TD text_wrap="true" style="text-align: center;">' + string(tt-return.obj-name) + '</TD>' skip
     5741         '<TD text_wrap="true" style="text-align: center;">' + string(tt-return.chk-num) + '</TD>' skip
     5742         '<TD text_wrap="true" style="text-align: center;">' + string(tt-return.chk-type) + '</TD>' skip
     5743         '<TD text_wrap="true" style="text-align: center;">' + string(tt-return.cash-num) + '</TD>' skip
     5744         '<TD text_wrap="true" style="text-align: center;">' + string(tt-return.fio) + '</TD>' skip
     5745         .
     5746    if not p-itog then do:
     5747       for each tt-gds-pay where tt-gds-pay.doc-code = tt-return.doc-code and tt-gds-pay.obj-code = tt-return.obj-code and tt-gds-pay.obj-type = tt-return.obj-type:
     5748         if v-gds-line then
     5749         do:
     5750           put stream OutStr-html unformatted
     5751             '<TR>' skip
     5752             '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     5753             '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     5754             '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     5755             '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     5756             '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     5757             '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     5758             .
     5759         end.
     5760         put stream OutStr-html unformatted
     5761           '<TD text_wrap="true" style="text-align: center;">' + if tt-gds-pay.gds-code <> 0 then string(tt-gds-pay.gds-code) + '</TD>' else " "  + '</TD>' skip
     5762           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.gds-name) + '</TD>' skip
     5763           '<TD text_wrap="true" style="text-align: right;">' + if tt-gds-pay.price <> 0 then fnc-convert-dot-to-colon(tt-gds-pay.price,"->>>>>>>>>>>9.99",2) + '</TD>' else " " + '</TD>' skip
     5764           '<TD text_wrap="true" style="text-align: right;">' + if tt-gds-pay.qnty <> 0 then fnc-convert-dot-to-colon(tt-gds-pay.qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else " " + '</TD>' skip
     5765           '<TD text_wrap="true" style="text-align: right;">' + if tt-gds-pay.sum_ <> 0 then fnc-convert-dot-to-colon(tt-gds-pay.sum_,"->>>>>>>>>>>9.99",2) + '</TD>' else " " + '</TD>' skip
     5766           .
     5767         put stream OutStr-html unformatted
     5768           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.d-card) + '</TD>' skip
     5769           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.pay-type) + '</TD>' skip
     5770           '<TD text_wrap="true" style="text-align: center;">' + if tt-gds-pay.p-card <> "0" then string(tt-gds-pay.p-card) + '</TD>' else " " + '</TD>' skip
     5771           '<TD text_wrap="true" style="text-align: right;">' + if tt-gds-pay.pay_qnty <> 0 then fnc-convert-dot-to-colon(tt-gds-pay.pay_qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else " " + '</TD>' skip
     5772           '<TD text_wrap="true" style="text-align: right;">' + if tt-gds-pay.sum_total <> 0 then fnc-convert-dot-to-colon(tt-gds-pay.sum_total,"->>>>>>>>>>>9.99",2) + '</TD>' else " " + '</TD>' skip
     5773           '<TD text_wrap="true" style="text-align: center;">' + if tt-gds-pay.sum_total <> 0 then string(tt-gds-pay.print) + '</TD>' else " " + '</TD>' skip
     5774           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.sbpstat) + '</TD>' skip
     5775           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.sbprrn) + '</TD>' skip
     5776           '</TR>'skip
     5777           .
     5778         v-gds-line = yes .
     5779       end.
     5780   end.
     5781   else do:
     5782       for first tt-gds-pay where tt-gds-pay.doc-code = tt-return.doc-code and tt-gds-pay.obj-code = tt-return.obj-code and tt-gds-pay.obj-type = tt-return.obj-type and tt-gds-pay.line-num = 1:
     5783             put stream OutStr-html unformatted
     5784           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.d-card) + '</TD>' skip
     5785           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.pay-type) + '</TD>' skip
     5786           '<TD text_wrap="true" style="text-align: center;">' + if tt-gds-pay.p-card <> "0" then string(tt-gds-pay.p-card) + '</TD>' else " " + '</TD>' skip
     5787           '<TD text_wrap="true" style="text-align: right;">' + if tt-gds-pay.pay_qnty <> 0 then fnc-convert-dot-to-colon(tt-gds-pay.pay_qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else " " + '</TD>' skip
     5788           '<TD text_wrap="true" style="text-align: right;">' + if tt-gds-pay.sum_total <> 0 then fnc-convert-dot-to-colon(tt-gds-pay.sum_total,"->>>>>>>>>>>9.99",2) + '</TD>' else " " + '</TD>' skip
     5789           '<TD text_wrap="true" style="text-align: center;">' + if tt-gds-pay.sum_total <> 0 then string(tt-gds-pay.print) + '</TD>' else " " + '</TD>' skip
     5790           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.sbpstat) + '</TD>' skip
     5791           '<TD text_wrap="true" style="text-align: center;">' + string(tt-gds-pay.sbprrn) + '</TD>' skip
     5792           '</TR>'skip
     5793           .
     5794         end.
     5795   end.
     5796     end.
     5797     put stream OutStr-html unformatted
     5798       '</table>' skip
     5799       '</body>' skip
     5800       '</html>' skip
     5801       .
     5802     output stream OutStr-html close.
     5803     run prn-lib-reportviewer-report-name in this-procedure (
     5804       input THIS-PROCEDURE
     5805       ,input v-file-name-rep-htm
     5806       ).
     5807   PROCEDURE get-report-num :
     5808     define output parameter p-report-num as integer no-undo .
     5809     do
     5810       on error undo, return error return-value
     5811       :
     5812       run gbl/getrpnum.p (output p-report-num).
     5813     end.
     5814   END PROCEDURE.
     5815   procedure clients-write:
     5816     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     5817     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     5818     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     5819     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     5820       and buf_clients.obj-type = p-obj-type no-error .
     5821     if AVAILABLE buf_clients then
     5822     do:
     5823       p-obj-name = buf_clients.obj-name .
     5824     end.
     5825   end.
     5826   end.
     5827   procedure ConvertStr-chk-type:
     5828     define input parameter p-chk-type as character no-undo.
     5829     define output parameter p-name-chk-type as character no-undo.
     5830     define variable v-num-element as integer no-undo.
     5831     v-num-element = lookup(p-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U).
     5832     p-name-chk-type = entry(v-num-element, 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U).
     5833     if p-chk-type <> "" and v-num-element = 0 then
     5834     do:
     5835       message "Ошибка 115." view-as alert-box.
     5836       return.
     5837     end.
     5838   end procedure.
     5839   procedure ConvertStr-pay-type:
     5840     define input parameter p-pay-code as integer no-undo.
     5841     define output parameter p-name-pay-type as character no-undo.
     5842     find first ub.cash-pay no-lock where ub.cash-pay.cdpay-code = p-pay-code and ub.cash-pay.status_ = 'тек':U no-error .
     5843     if available (ub.cash-pay) then p-name-pay-type = ub.cash-pay.obj-name .
     5844   end procedure.
