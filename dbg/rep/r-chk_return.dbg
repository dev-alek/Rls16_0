     2491           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2492           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2493           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2494           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2495           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2496           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2497           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2498       .
     2499      run fmtcli-get-bank in this-procedure (
     2500             input p-host-obj-code
     2501           , input p-obj-type
     2502           , input p-obj-code
     2503           , input p-curr-code
     2504       ).
     2505       assign
     2506           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2507           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2508           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2509           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2510           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2511           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2512           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2513           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2514       .
     2515   end.
     2516   end procedure.
     2517   procedure torgconf-get-ship-param :
     2518   define input parameter p-host-obj-code      as integer          no-undo.
     2519   define input parameter p-obj-type           as character        no-undo.
     2520   define input parameter p-obj-code           as integer          no-undo.
     2521   define input parameter p-curr-code          as integer          no-undo.
     2522       define variable v-host-code    as integer      no-undo.
     2523   do
     2524   on error undo, return error
     2525   :
     2526       assign
     2527           v-torgconf-ship-type = p-obj-type
     2528           v-torgconf-ship-code = p-obj-code
     2529       .
     2530       if trim(p-obj-type) = ""
     2531       and p-obj-code = 0
     2532       then do:
     2533       assign
     2534           v-torgconf-ship-name         = "":U
     2535           v-torgconf-ship-addres       = "":U
     2536           v-torgconf-ship-post-addres  = "":U
     2537           v-torgconf-ship-phone        = "":U
     2538           v-torgconf-ship-inn          = "":U
     2539           v-torgconf-ship-kpp          = "":U
     2540           v-torgconf-ship-okpo         = "":U
     2541       .
     2542       end.
     2543       else do:
     2544       run fmtcli-get-client in this-procedure (
     2545             input p-obj-type
     2546           , input p-obj-code
     2547       ).
     2548       assign
     2549           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2550           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2551           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2552           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2553           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2554           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2555           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2556           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2557       .
     2558       end.
     2559           run fmtcli-get-bank in this-procedure (
     2560             input p-host-obj-code
     2561           , input p-obj-type
     2562           , input p-obj-code
     2563           , input p-curr-code
     2564       ).
     2565       assign
     2566           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2567           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2568           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2569           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2570           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2571           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2572           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2573           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2574       .
     2575   end.
     2576   end procedure.
     2577   procedure torgconf-get-holdfirm-code :
     2578   define input parameter p-obj-type   as character        no-undo.
     2579   define input parameter p-obj-code   as integer          no-undo.
     2580   define output parameter p-firm-code as integer          no-undo.
     2581       define variable v-firm-code-str     as character    no-undo.
     2582       define variable v-par-type          as character    no-undo.
     2583       define buffer buf_clients       for ub.clients.
     2584   do
     2585   for buf_clients
     2586   on error undo, return error
     2587   :
     2588       run gbl/clntat-v.p (
     2589             input p-obj-type
     2590           , input p-obj-code
     2591           , input 'holdfirm-code':U
     2592           , output v-firm-code-str
     2593           , output v-par-type
     2594       ).
     2595       assign
     2596           p-firm-code = integer( v-firm-code-str )
     2597       no-error.
     2598       if error-status :error
     2599       then do:
     2600           message
     2601               "Неверно задан код фирмы для печати накладных."
     2602           view-as alert-box warning.
     2603           assign
     2604               p-firm-code = 0
     2605           .
     2606       end.
     2607       else do:
     2608           find first buf_clients no-lock
     2609                where buf_clients.obj-type = 'орг':U
     2610                  and buf_clients.obj-code = p-firm-code
     2611           no-error.
     2612           if not available buf_clients
     2613           then do:
     2614               message
     2615                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2616                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2617               view-as alert-box warning.
     2618               assign
     2619                   p-firm-code = 0
     2620               .
     2621           end.
     2622       end.
     2623   end.
     2624   end procedure.
     2625   procedure torgconf-get-post-head:
     2626   define input  parameter p-obj-type             as character        no-undo.
     2627   define input  parameter p-obj-code             as integer          no-undo.
     2628   define output parameter p-torgconf-post-head   as character        no-undo.
     2629      define variable v-host-code         as integer      no-undo.
     2630      define buffer buf_sysconf     for ub.sysconf.
     2631        assign
     2632         p-torgconf-post-head  = ""
     2633        .
     2634   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2635   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2636     (input  p-obj-type
     2637     ,input  p-obj-code
     2638     ,output v-host-code
     2639     )  .
     2640      find first buf_sysconf no-lock
     2641      where buf_sysconf.host-code = v-host-code
     2642      no-error.
     2643      if available buf_sysconf
     2644      then do:
     2645         assign
     2646            p-torgconf-post-head = buf_sysconf.head-position
     2647         .
     2648      end.
     2649   end procedure.
     2650   procedure torgconf-get-storekeeper:
     2651   define input  parameter p-wrkr                   as integer          no-undo.
     2652   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2653   define output parameter p-torgconf-post          as character        no-undo.
     2654      define buffer buf_sysconf     for ub.sysconf.
     2655      define buffer buf_person      for ub.person.
     2656      define buffer buf_shop        for ub.shop .
     2657      define buffer buf_store       for ub.store .
     2658      if v-torgconf-outC = "no_print"
     2659      then do:
     2660         assign p-torgconf-post = ""
     2661                p-torgconf-wrkr-name = ""
     2662                .
     2663      end.
     2664      if v-torgconf-outC = "clad_doc"
     2665      then do:
     2666         run rep/get-psn.p
     2667               (input  p-wrkr
     2668               ,output p-torgconf-wrkr-name
     2669               ) .
     2670         find first buf_person no-lock
     2671         where buf_person.psn-code = p-wrkr
     2672         no-error.
     2673         if available buf_person
     2674         then do:
     2675           p-torgconf-post = buf_person.position.
     2676         end.
     2677         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2678         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2679      end.
     2680      if v-torgconf-outC = "clad_obj"
     2681      then do:
     2682         CASE v-torgconf-self-obj-type:
     2683         WHEN 'маг':U
     2684         THEN DO:
     2685            find first buf_shop no-lock
     2686            where buf_shop.obj-code = v-torgconf-self-obj-code
     2687            .
     2688            assign
     2689               p-torgconf-wrkr-name = buf_shop.store-man
     2690               p-torgconf-post = ""
     2691            .
     2692            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2693         END.
     2694         WHEN 'скл':U
     2695         THEN DO:
     2696            find first buf_store no-lock
     2697            where buf_store.obj-code = v-torgconf-self-obj-code
     2698            .
     2699            assign
     2700               p-torgconf-wrkr-name = buf_store.store-man
     2701               p-torgconf-post = ""
     2702            .
     2703            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2704         END.
     2705         OTHERWISE DO:
     2706            assign
     2707               p-torgconf-post = "":U
     2708               p-torgconf-wrkr-name = "":U
     2709            .
     2710         END.
     2711         END CASE.
     2712      end.
     2713    end procedure.
     2714   procedure torgconf-get-form-header :
     2715   define input parameter p-for-inverse    as logical          no-undo.
     2716   define input parameter p-doc-code       as character        no-undo.
     2717   define input parameter p-print-doc      as logical          no-undo.
     2718   define input parameter p-doc-date       as date             no-undo.
     2719   define input parameter p-fact-date      as date             no-undo.
     2720   define input parameter p-doc-type       as character        no-undo.
     2721   define input parameter p-status_        as character        no-undo.
     2722   define input parameter p-reverse        as logical          no-undo.
     2723   define input parameter p-sf-par         as logical          no-undo.
     2724       define variable v-attr-type         as character    no-undo.
     2725       define variable v-doc-code-standard as logical      no-undo.
     2726       define variable v-doc-date-standard as logical      no-undo.
     2727       define variable v-par-consignee-addres  as character    no-undo.
     2728       define variable v-host-code         as integer      no-undo.
     2729       define variable v-dcode-attr        as character    no-undo.
     2730       define variable v-ddate-attr        as character    no-undo.
     2731       define variable v-doc-date          as character    no-undo.
     2732       define variable v-doc-code          as character    no-undo.
     2733       define variable v-par-type          as character    no-undo.
     2734       define variable v-attr              as character    no-undo.
     2735       define buffer buf_firm          for ub.firm .
     2736       define buffer buf_clients       for ub.clients .
     2737       define buffer buf_sysconf       for ub.sysconf .
     2738       define buffer buf_shop          for ub.shop .
     2739       define buffer buf_store         for ub.store .
     2740       define buffer buf_person        for ub.person .
     2741       define buffer buf_trn-doc       for ub.trn-doc .
     2742       define buffer buf_wth-doc       for ub.wth-doc .
     2743       do
     2744   for buf_firm
     2745     , buf_clients
     2746     , buf_sysconf
     2747     , buf_shop
     2748     , buf_trn-doc
     2749     , buf_person
     2750     , buf_wth-doc
     2751   on error undo, return error
     2752   :
     2753       if p-doc-type = 'при':U
     2754       or p-doc-type = 'возврат':U
     2755       then do:
     2756           assign
     2757               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2758                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2759               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2760                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2761               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2762                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2763               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2764                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2765               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2766               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2767               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2768               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2769               v-torgconf-supplier-type    = v-torgconf-cli-type
     2770               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2771               v-torgconf-saler-type       = v-torgconf-self-host-type
     2772               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2773               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2774               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2775               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2776               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2777               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2778               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2779               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2780               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2781               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2782               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2783               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2784               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2785               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2786               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2787           .
     2788           if v-torgconf-cli-schet-exists = yes
     2789           AND v-form-name                  = "torg12":U
     2790           then do:
     2791               assign
     2792                   v-torgconf-supplier = v-torgconf-supplier
     2793                       + substitute( ", р/с &1 к/с &2"
     2794                                   , v-torgconf-cli-bank-r-schet
     2795                                   , v-torgconf-cli-bank-c-schet
     2796                                   )
     2797                   v-torgconf-suppi = v-torgconf-supplier
     2798                       + substitute( ", р/с &1 к/с &2"
     2799                                   , v-torgconf-cli-bank-r-schet
     2800                                   , v-torgconf-cli-bank-c-schet
     2801                                   )
     2802               .
     2803               if v-torgconf-cli-bank-exists = yes
     2804               then do:
     2805                   assign
     2806                       v-torgconf-supplier = v-torgconf-supplier
     2807                           + substitute( " БИК &1 в &2 &3"
     2808                                       , v-torgconf-cli-bank-bik
     2809                                       , v-torgconf-cli-bank-name
     2810                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2811                                       )
     2812                      v-torgconf-suppi = v-torgconf-supplier
     2813                           + substitute( " БИК &1 в &2 &3"
     2814                                       , v-torgconf-cli-bank-bik
     2815                                       , v-torgconf-cli-bank-name
     2816                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2817                                       )
     2818                   .
     2819               end.
     2820           end.
     2821           if v-torgconf-self-schet-exists = yes
     2822           AND v-form-name                  = "torg12":U
     2823           then do:
     2824               assign
     2825                   v-torgconf-saler = v-torgconf-saler
     2826                       + substitute( ", р/с &1 к/с &2"
     2827                                   , v-torgconf-self-bank-r-schet
     2828                                   , v-torgconf-self-bank-c-schet
     2829                                   )
     2830               .
     2831               if v-torgconf-self-bank-exists = yes
     2832               then do:
     2833                   assign
     2834                       v-torgconf-saler = v-torgconf-saler
     2835                           + substitute( " БИК &1 в &2 &3"
     2836                                       , v-torgconf-self-bank-bik
     2837                                       , v-torgconf-self-bank-name
     2838                                       , v-torgconf-self-bank-addres
     2839                                       )
     2840                   .
     2841               end.
     2842           end.
     2843           if v-torgconf-sup-schet-exists = yes
     2844           AND v-form-name                  = "torg12":U
     2845           then do:
     2846               assign
     2847                   v-torgconf-consignee = v-torgconf-consignee
     2848                       + substitute( ", р/с &1 к/с &2"
     2849                                   , v-torgconf-sup-bank-r-schet
     2850                                   , v-torgconf-sup-bank-c-schet
     2851                                   )
     2852               .
     2853             if v-torgconf-sup-bank-exists = yes
     2854              then do:
     2855                assign
     2856                   v-torgconf-consignee = v-torgconf-consignee
     2857                           + substitute( " БИК &1 в &2 &3"
     2858                                       , v-torgconf-sup-bank-bik
     2859                                       , v-torgconf-sup-bank-name
     2860                                       , v-torgconf-sup-bank-addres
     2861                                       )
     2862                   .
     2863               end.
     2864           end.
     2865      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2866      then do:
     2867          assign
     2868            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2869                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2870                                                   , v-torgconf-cli-name
     2871                                                   , ( if v-torgconf-outprncd = yes
     2872                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2873                                                         else "":U )
     2874                                                   , v-torgconf-cli-post-addres
     2875                                                   , v-torgconf-cli-phone
     2876                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2877                                                       AND v-form-name                  = "torg12":U
     2878                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2879                                                               , v-torgconf-cli-bank-r-schet
     2880                                                               , v-torgconf-cli-bank-c-schet
     2881                                                               , v-torgconf-cli-bank-bik
     2882                                                               , v-torgconf-cli-bank-name
     2883                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2884                                                         else "":U )
     2885                                                )
     2886         .
     2887      end.
     2888       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2889                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2890                                        , v-torgconf-cli-name
     2891                                        , ( if v-torgconf-outprncd = yes
     2892                                            then substitute( " (&1)", v-torgconf-cli-code )
     2893                                            else "":U )
     2894                                        , v-torgconf-cli-addres
     2895                                        , v-torgconf-cli-phone
     2896                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2897                                            AND v-form-name                  = "torg12":U
     2898                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2899                                                           , v-torgconf-cli-bank-r-schet
     2900                                                           , v-torgconf-cli-bank-c-schet
     2901                                                           , v-torgconf-cli-bank-bik
     2902                                                           , v-torgconf-cli-bank-name
     2903                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2904                                                   else "":U )
     2905                                        ).
     2906       end.
     2907       else do:
     2908       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2909                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2910                                        , v-torgconf-self-host-name
     2911                                        , ( if v-torgconf-outprncd = yes
     2912                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2913                                            else "":U )
     2914                                        , v-torgconf-self-host-addres
     2915                                        , v-torgconf-self-host-phone
     2916                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2917                                            AND v-form-name                  = "torg12":U
     2918                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2919                                                           , v-torgconf-self-bank-r-schet
     2920                                                           , v-torgconf-self-bank-c-schet
     2921                                                           , v-torgconf-self-bank-bik
     2922                                                           , v-torgconf-self-bank-name
     2923                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2924                                                   else "":U )
     2925                                           ).
     2926         if v-torgconf-outares = yes
     2927         and p-reverse = no
     2928         then do:
     2929            assign
     2930               v-par-consignee-addres = v-torgconf-ship-post-addres
     2931            .
     2932         end.
     2933         if v-torgconf-outares = no
     2934         and p-reverse = no
     2935         then do:
     2936            assign
     2937               v-par-consignee-addres = v-torgconf-ship-addres
     2938            .
     2939         end.
     2940         if p-reverse = yes
     2941         then do:
     2942             assign
     2943               v-par-consignee-addres = v-torgconf-ship-addres
     2944             .
     2945         end.
     2946           assign
     2947               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2948                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2949               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2950                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2951               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2952                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2953               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2954               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2955               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2956               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2957               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2958               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2959               v-torgconf-saler-type       = v-torgconf-cli-type
     2960               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2961               v-torgconf-consignee-type   = v-torgconf-ship-type
     2962               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2963               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2964               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2965               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2966               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2967               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2968               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2969               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2970               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2971               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2972               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2973               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2974               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2975               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2976               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2977               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2978               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2979           .
     2980           if v-torgconf-self-schet-exists = yes
     2981           AND v-form-name                  = "torg12":U
     2982           then do:
     2983               assign
     2984                   v-torgconf-supplier = v-torgconf-supplier
     2985                       + substitute( ", р/с &1 к/с &2"
     2986                                   , v-torgconf-self-bank-r-schet
     2987                                   , v-torgconf-self-bank-c-schet
     2988                                   )
     2989               .
     2990               if v-torgconf-self-bank-exists = yes
     2991               then do:
     2992                   assign
     2993                       v-torgconf-supplier = v-torgconf-supplier
     2994                           + substitute( " БИК &1 в &2 &3"
     2995                                       , v-torgconf-self-bank-bik
     2996                                       , v-torgconf-self-bank-name
     2997                                       , v-torgconf-self-bank-addres
     2998                                       )
     2999                   .
     3000               end.
     3001           end.
     3002           if v-torgconf-cli-schet-exists = yes
     3003           AND v-form-name                  = "torg12":U
     3004           then do:
     3005               assign
     3006                   v-torgconf-saler = v-torgconf-saler
     3007                       + substitute( ", р/с &1 к/с &2"
     3008                                   , v-torgconf-cli-bank-r-schet
     3009                                   , v-torgconf-cli-bank-c-schet
