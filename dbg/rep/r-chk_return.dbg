      568   define variable var-report-r-b as character no-undo .
      569   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      571     (output var-report-r-b
      572     )  .
      573   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      575   define  shared variable RepPathName        as character no-undo .
      576   define  shared variable PrintRubl          as logical   no-undo .
      577   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   procedure cur-time :
      580      define output parameter p-today as date      no-undo .
      581      define output parameter p-time  as integer   no-undo .
      582     do
      583     on error undo, return error
      584     :
      585       define variable v-date1 as date      no-undo .
      586       define variable v-date2 as date      no-undo .
      587       define variable v-time  as integer   no-undo .
      588       assign
      589         v-date1 = today
      590         v-time  = time
      591         v-date2 = today
      592       .
      593       if v-date1 <> v-date2
      594       then do:
      595         assign
      596           v-date1 = today
      597           v-time  = v-time
      598         .
      599       end.
      600       assign
      601         p-today = v-date1
      602         p-time  = v-time
      603       .
      604     end.
      605   end.
      606   function cur-time-date returns character
      607   :
      608     return string(today, '99/99/9999':U) .
      609   end.
      610   function cur-time-mjd returns decimal
      611   :
      612     define variable v-date as date      no-undo .
      613     define variable v-time as integer   no-undo .
      614     run cur-time in this-procedure
      615       (output v-date
      616       ,output v-time
      617       ) .
      618     return integer(v-date) - 2400002 + (v-time / 86400) .
      619   end.
      620   function cur-time-get-ending-index returns integer
      621   (input p-number as integer
      622   )
      623   :
      624     if p-number < 0
      625     or p-number = ?
      626     then do:
      627       return 1 .
      628     end.
      629     define variable v-rest as integer   no-undo .
      630     assign
      631       p-number = p-number modulo 100
      632     .
      633     if p-number < 20
      634     then do:
      635       assign
      636         v-rest = p-number
      637       .
      638     end.
      639     else do:
      640       assign
      641         v-rest = p-number modulo 10
      642       .
      643     end.
      644     case v-rest :
      645       when 1
      646       then do:
      647         return 2 .
      648       end.
      649       when 2 or
      650       when 3 or
      651       when 4
      652       then do:
      653         return 3 .
      654       end.
      655       otherwise do:
      656         return 1 .
      657       end.
      658     end case .
      659   end.
      660   procedure cur-time-mjd-to-date :
      661      define input  parameter i-mjd-diff as decimal no-undo.
      662      define output parameter o-Date     as date    no-undo.
      663      define output parameter o-Time     as integer no-undo.
      664      define variable v-day-number as integer   no-undo .
      665      if    i-mjd-diff < 0
      666         or i-mjd-diff = ?
      667      then do:
      668         return "?" .
      669      end.
      670      assign
      671         v-day-number = truncate(i-mjd-diff,0).
      672         o-Date = date(v-day-number + 2400002).
      673         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      674     .
      675   end.
      676   function cur-time-mjd-to-string returns character
      677   (input p-mjd-diff as decimal
      678   )
      679   :
      680     define variable v-day-number as integer   no-undo .
      681     define variable v-seconds    as integer   no-undo .
      682     define variable v-hour       as integer   no-undo .
      683     define variable v-min        as integer   no-undo .
      684     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      685     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      686     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      687     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      688     if p-mjd-diff < 0
      689     or p-mjd-diff = ?
      690     then do:
      691       return "?" .
      692     end.
      693     assign
      694       v-day-number = integer(truncate(p-mjd-diff,0))
      695       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      696     .
      697     if v-seconds > 86400
      698     then do:
      699       assign
      700         v-seconds = 86400 - 1
      701       .
      702     end.
      703     if v-seconds < 0
      704     then do:
      705       assign
      706         v-seconds = 0
      707       .
      708     end.
      709     assign
      710       v-hour = truncate(v-seconds / 3600, 0)
      711     .
      712     assign
      713       v-seconds = v-seconds modulo 3600
      714     .
      715     assign
      716       v-min = truncate(v-seconds / 60, 0)
      717     .
      718     assign
      719       v-seconds = v-seconds modulo 60
      720     .
      721     return
      722         (if v-day-number <> 0
      723           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      724           else ""
      725         )
      726       + (if v-day-number <> 0 or v-hour <> 0
      727           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      728           else ""
      729         )
      730       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      731           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      732           else ""
      733         )
      734       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      735       .
      736   end.
      737   function cur-time-string returns character
      738   :
      739     define variable v-date as date      no-undo .
      740     define variable v-time as integer   no-undo .
      741     run cur-time in this-procedure
      742       (output v-date
      743       ,output v-time
      744       ) .
      745     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      746   end.
      747   function cur-time-string-sec returns character
      748   :
      749     define variable v-date as date      no-undo .
      750     define variable v-time as integer   no-undo .
      751     run cur-time in this-procedure
      752       (output v-date
      753       ,output v-time
      754       ) .
      755     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      756   end.
      757   function cur-time-custom  returns character
      758   (input p-prefix as character
      759   ,input p-date-format as character
      760   ,input p-delimiter as character
      761   ,input p-time-format as character
      762   ,input p-suffix as character
      763   )
      764   :
      765     define variable v-date as date      no-undo .
      766     define variable v-time as integer   no-undo .
      767     run cur-time in this-procedure
      768       (output v-date
      769       ,output v-time
      770       ) .
      771     return
      772       p-prefix
      773       + string(v-date, p-date-format)
      774       + p-delimiter
      775       + string(v-time, p-time-format)
      776       + p-suffix
      777       .
      778   end.
      779   function cur-time-print  returns character
      780   :
      781     define variable v-date as date      no-undo .
      782     define variable v-time as integer   no-undo .
      783     run cur-time in this-procedure
      784       (output v-date
      785       ,output v-time
      786       ) .
      787     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      788   end.
      789   function cur-time-datetime returns datetime
      790   :
      791     define variable v-char as character no-undo .
      792     define variable v-datetime as datetime no-undo .
      793     v-char = cur-time-string().
      794     v-datetime = datetime(v-char).
      795     return  v-datetime.
      796   end.
      797   function cur-time-string-msec returns character
      798   :
      799     define variable v-date as datetime  no-undo .
      800     v-date = now.
      801     return string(v-date) .
      802   end.
      803   procedure cp-attr-code :
      804     do
      805     on error undo, return error
      806     :
      807       define input  parameter p-code           as character no-undo .
      808       define output parameter p-type           as character no-undo .
      809       define output parameter p-format         as character no-undo .
      810       define output parameter p-label          as character no-undo .
      811       define output parameter p-range          as integer   no-undo .
      812       define output parameter p-user-can-edit  as logical   no-undo .
      813       define output parameter p-output-display as logical   no-undo .
      814       define output parameter p-other          as character no-undo .
      815       case p-code :
      816               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      817               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      818               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      819               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      820               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      821               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      822               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      823               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      824               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      825               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      826         otherwise do:
      827           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      828         end.
      829       end.
      830     end.
      831   end procedure.
      832   procedure cp-attr-tooltip :
      833     do
      834     on error undo, return error
      835     :
      836       define input  parameter p-code    as character no-undo .
      837       define output parameter p-tooltip as character no-undo .
      838       define output parameter p-label   as character no-undo .
      839       case p-code :
      840               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      841               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      842               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      843               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      844               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      845               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      846               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      847               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      848               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      849               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      850         otherwise do:
      851           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      852         end.
      853       end.
      854     end.
      855   end procedure.
      856   procedure cp-attr-value :
      857     do
      858     on error undo, return error
      859     :
      860       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      861       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      862       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      863       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      864       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      865       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      866       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      867       define output parameter p-type        as character no-undo .
      868       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      869       define variable v-format         as character no-undo .
      870       define variable v-label          as character no-undo .
      871       define variable v-range          as integer   no-undo .
      872       define variable v-user-can-edit  as logical   no-undo .
      873       define variable v-output-display as logical   no-undo .
      874       define variable v-other          as character no-undo .
      875       run cp-attr-code in this-procedure
      876         (input  p-code
      877         ,output p-type
      878         ,output v-format
      879         ,output v-label
      880         ,output v-range
      881         ,output v-user-can-edit
      882         ,output v-output-display
      883         ,output v-other
      884         ) no-error .
      885       if error-status :error then do:
      886         undo, return error return-value .
      887       end.
      888       find first buf_cash-pay-attr no-lock
      889         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      890           and buf_cash-pay-attr.curr-code  = p-curr-code
      891           and buf_cash-pay-attr.host-code  = p-host-code
      892           and buf_cash-pay-attr.obj-type   = p-obj-type
      893           and buf_cash-pay-attr.obj-code   = p-obj-code
      894           and buf_cash-pay-attr.attr-code  = p-code
      895         no-error .
      896       if avail buf_cash-pay-attr then do:
      897         assign
      898           p-value =  buf_cash-pay-attr.attr-value
      899         .
      900       end.
      901       else do:
      902         assign
      903           p-value = if p-type = 'L':U then "no":U else ""
      904         .
      905       end.
      906     end.
      907   end procedure.
      908   procedure cp-attr-write :
      909     do
      910     on error undo, return error
      911     :
      912       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      913       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      914       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      915       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      916       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      917       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      918       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      919       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      920       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      921       define variable v-type           as character no-undo .
      922       define variable v-format         as character no-undo .
      923       define variable v-label          as character no-undo .
      924       define variable v-range          as integer   no-undo .
      925       define variable v-user-can-edit  as logical   no-undo .
      926       define variable v-output-display as logical   no-undo .
      927       define variable v-other          as character no-undo .
      928       run cp-attr-code in this-procedure
      929         (input  p-code
      930         ,output v-type
      931         ,output v-format
      932         ,output v-label
      933         ,output v-range
      934         ,output v-user-can-edit
      935         ,output v-output-display
      936         ,output v-other
      937         ) no-error .
      938       if error-status :error then do:
      939         undo, return error return-value .
      940       end.
      941       find first buf_cash-pay-attr exclusive-lock
      942         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      943           and buf_cash-pay-attr.curr-code  = p-curr-code
      944           and buf_cash-pay-attr.host-code  = p-host-code
      945           and buf_cash-pay-attr.obj-type   = p-obj-type
      946           and buf_cash-pay-attr.obj-code   = p-obj-code
      947           and buf_cash-pay-attr.attr-code = p-code
      948         no-error .
      949       if not available buf_cash-pay-attr then do:
      950         create buf_cash-pay-attr .
      951         assign
      952         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      953         buf_cash-pay-attr.curr-code  = p-curr-code
      954         buf_cash-pay-attr.host-code  = p-host-code
      955         buf_cash-pay-attr.obj-type   = p-obj-type
      956         buf_cash-pay-attr.obj-code   = p-obj-code
      957         buf_cash-pay-attr.attr-code = p-code
      958         .
      959       end.
      960       assign
      961         buf_cash-pay-attr.attr-value = p-value
      962       .
      963       release buf_cash-pay-attr no-error .
      964       if error-status:error then do:
      965         undo, return error return-value .
      966       end.
      967     end.
      968   end procedure.
      969   procedure cp-attr-exist :
      970     do
      971     on error undo, return error
      972     :
      973       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      974       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      975       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      976       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      977       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      978       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      979       define output parameter p-exist   as logical  no-undo .
      980       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      981       define variable v-type           as character no-undo .
      982       define variable v-format         as character no-undo .
      983       define variable v-label          as character no-undo .
      984       define variable v-range          as integer   no-undo .
      985       define variable v-user-can-edit  as logical   no-undo .
      986       define variable v-output-display as logical   no-undo .
      987       define variable v-other          as character no-undo .
      988       run cp-attr-code in this-procedure
      989         (input  p-code
      990         ,output v-type
      991         ,output v-format
      992         ,output v-label
      993         ,output v-range
      994         ,output v-user-can-edit
      995         ,output v-output-display
      996         ,output v-other
      997         ) no-error .
      998       if error-status :error then do:
      999         undo, return error return-value .
     1000       end.
     1001       find first buf_cash-pay-attr exclusive-lock
     1002         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1003           and buf_cash-pay-attr.curr-code  = p-curr-code
     1004           and buf_cash-pay-attr.host-code  = p-host-code
     1005           and buf_cash-pay-attr.obj-type   = p-obj-type
     1006           and buf_cash-pay-attr.obj-code   = p-obj-code
     1007           and buf_cash-pay-attr.attr-code = p-code
     1008         no-error .
     1009       if  available buf_cash-pay-attr then do:
     1010         p-exist = yes.
     1011       end.
     1012     end.
     1013   end procedure.
     1014   procedure cp-attr-delete :
     1015     do
     1016     on error undo, return error
     1017     :
     1018       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1019       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1020       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1021       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1022       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1023       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1024       define output parameter p-deleted  as logical no-undo.
     1025       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1026       define variable v-type           as character no-undo .
     1027       define variable v-format         as character no-undo .
     1028       define variable v-label          as character no-undo .
     1029       define variable v-range          as integer   no-undo .
     1030       define variable v-user-can-edit  as logical   no-undo .
     1031       define variable v-output-display as logical   no-undo .
     1032       define variable v-other          as character no-undo .
     1033       run cp-attr-code in this-procedure
     1034         (input  p-code
     1035         ,output v-type
     1036         ,output v-format
     1037         ,output v-label
     1038         ,output v-range
     1039         ,output v-user-can-edit
     1040         ,output v-output-display
     1041         ,output v-other
     1042         ) no-error .
     1043       if error-status :error then do:
     1044         undo, return error return-value .
     1045       end.
     1046       find first buf_cash-pay-attr exclusive-lock
     1047         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1048           and buf_cash-pay-attr.curr-code  = p-curr-code
     1049           and buf_cash-pay-attr.host-code  = p-host-code
     1050           and buf_cash-pay-attr.obj-type   = p-obj-type
     1051           and buf_cash-pay-attr.obj-code   = p-obj-code
     1052           and buf_cash-pay-attr.attr-code = p-code
     1053         no-error NO-WAIT.
     1054       if not available buf_cash-pay-attr then do:
     1055         p-deleted = no.
     1056       end.
     1057       else do:
     1058         delete buf_cash-pay-attr no-error .
     1059         if error-status:error then do:
     1060           undo, return error return-value .
     1061         end.
     1062         p-deleted = yes.
     1063       end.
     1064     end.
     1065   end procedure.
     1066   procedure cp-attr-news :
     1067     do
     1068     on error undo, return error
     1069     :
     1070       define input  parameter p-code           as character no-undo .
     1071       define output parameter p-news           as logical   no-undo .
     1072       case p-code :
     1073               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1074               when 'grp-code':U then do:     assign     p-news = true.   end.
     1075               when 'is-use':U then do:     assign     p-news = true.   end.
     1076               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1077               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1078               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1079               when 'form_km3':U then do:     assign     p-news = false.   end.
     1080               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1081               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1082               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1083         otherwise do:
     1084           p-news = no.
     1085         end.
     1086       end.
     1087     end.
     1088   end procedure.
     1089   procedure cp-attr-hist :
     1090     do
     1091     on error undo, return error
     1092     :
     1093       define input  parameter p-code           as character no-undo .
     1094       define output parameter p-hist           as logical   no-undo .
     1095       case p-code :
     1096               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
     1097               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
     1098               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     1099               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1100               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1101               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1102               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1103         otherwise do:
     1104           p-hist = no.
     1105         end.
     1106       end.
     1107     end.
     1108   end procedure.
     1109   define new global shared variable g#lib-trn  as handle no-undo .
     1110   define new global shared variable g#lib-trn2 as handle no-undo .
     1111   define new global shared variable g#lib-trn3 as handle no-undo .
     1112   define new global shared variable g#lib-trn4 as handle no-undo .
     1113   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1114   define new global shared variable g#trdcalib as handle no-undo.
     1115   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1116                                     iInput AS INTEGER).
     1117     def var v-start-print as integer no-undo .
     1118     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1119     assign
     1120       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1121     .
     1122     RETURN v-start-print .
     1123   END FUNCTION.
     1124   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1125                                     iInput AS INTEGER).
     1126     def var v-start-print as integer no-undo .
     1127     assign
     1128       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1129     .
     1130     if v-start-print < 0 then return 0.
     1131     RETURN v-start-print .
     1132   END FUNCTION.
     1133   define variable vss-include-info11 as character format "X(65)" no-undo
     1134   initial "@(#)$Workfile$ $Revision$".
     1135   define variable v-fmtcli-name          as character    no-undo.
     1136   define variable v-fmtcli-engl-name     as character    no-undo.
     1137   define variable v-fmtcli-addres        as character    no-undo.
     1138   define variable v-fmtcli-post-addres   as character    no-undo.
     1139   define variable v-fmtcli-full-addres   as character    no-undo.
     1140   define variable v-fmtcli-phone         as character    no-undo.
     1141   define variable v-fmtcli-inn           as character    no-undo.
     1142   define variable v-fmtcli-kpp           as character    no-undo.
     1143   define variable v-fmtcli-okpo          as character    no-undo.
     1144   define variable v-fmtcli-country       as character    no-undo.
     1145   define variable v-fmtcli-city          as character    no-undo.
     1146   define variable v-fmtcli-index         as character    no-undo.
     1147   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1148   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1149   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1150   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1151   define variable v-fmtcli-bank-bik      as character    no-undo.
     1152   define variable v-fmtcli-bank-name     as character    no-undo.
     1153   define variable v-fmtcli-bank-addres   as character    no-undo.
     1154   define variable v-fmtcli-bank-city     as character    no-undo.
     1155   procedure fmtcli-get-bank :
     1156   define input parameter p-host-code      as integer          no-undo.
     1157   define input parameter p-obj-type       as character        no-undo.
     1158   define input parameter p-obj-code       as integer          no-undo.
     1159   define input parameter p-curr-code      as integer          no-undo.
     1160       define buffer buf_fin-schet     for ub.fin-schet.
     1161       define buffer buf_fin-bank      for ub.fin-bank.
     1162   do
     1163   for buf_fin-schet
     1164     , buf_fin-bank
     1165   on error undo, return error
     1166   :
     1167       assign
     1168           v-fmtcli-schet-exists       = no
     1169           v-fmtcli-bank-exists        = no
     1170           v-fmtcli-bank-r-schet       = "":U
     1171           v-fmtcli-bank-c-schet       = "":U
     1172           v-fmtcli-bank-bik           = "":U
     1173           v-fmtcli-bank-name          = "":U
     1174           v-fmtcli-bank-addres        = "":U
     1175           v-fmtcli-bank-city          = "":U
     1176       .
     1177       search-for-schet:
     1178       for each buf_fin-schet no-lock
     1179          where buf_fin-schet.host-code = p-host-code
     1180            and buf_fin-schet.cli-type  = p-obj-type
     1181            and buf_fin-schet.cli-code  = p-obj-code
     1182            and buf_fin-schet.curr-code = p-curr-code
     1183       on error undo, return error
     1184       :
     1185           if buf_fin-schet.status_   = 'удал':U
     1186           then do:
     1187           end.
     1188           else do:
     1189               assign
     1190                   v-fmtcli-schet-exists   = yes
     1191                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1192                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1193               .
     1194               find first buf_fin-bank no-lock
     1195                    where buf_fin-bank.host-code = p-host-code
     1196                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1197               no-error.
     1198               if available buf_fin-bank
     1199               then do:
     1200                   assign
     1201                       v-fmtcli-bank-exists      = yes
     1202                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1203                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1204                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1205                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1206                   .
     1207               end.
     1208               else do:
     1209                   assign
     1210                       v-fmtcli-bank-exists    = no
     1211                       v-fmtcli-bank-bik       = "":U
     1212                       v-fmtcli-bank-name      = "":U
     1213                       v-fmtcli-bank-addres    = "":U
     1214                       v-fmtcli-bank-city      = "":U
     1215                   .
     1216               end.
     1217               leave search-for-schet.
     1218           end.
     1219       end.
     1220   end.
     1221   end procedure.
     1222   procedure fmtcli-get-client :
     1223   define input parameter p-obj-type       as character    no-undo.
     1224   define input parameter p-obj-code       as integer      no-undo.
     1225       define variable v-temp-fmtcli-address      as character     no-undo.
     1226       define variable v-num-country-city    as integer      no-undo.
     1227       define buffer buf_clients   for ub.clients.
     1228       define buffer buf_firm      for ub.firm.
     1229       define buffer buf_store     for ub.store.
     1230       define buffer buf_shop      for ub.shop.
     1231       define buffer buf_person    for ub.person.
     1232   do
     1233   for buf_clients
     1234     , buf_firm
     1235     , buf_store
     1236     , buf_shop
     1237     , buf_person
     1238   on error undo, return error
     1239   :
     1240       assign
     1241           v-fmtcli-name           = "":U
     1242           v-fmtcli-addres         = "":U
     1243           v-fmtcli-post-addres    = "":U
     1244           v-fmtcli-full-addres    = "":U
     1245           v-fmtcli-phone          = "":U
     1246           v-fmtcli-inn            = "":U
     1247           v-fmtcli-kpp            = "":U
     1248           v-fmtcli-okpo           = "":U
     1249           v-fmtcli-city           = "":U
     1250           v-fmtcli-index          = "":U
     1251           v-fmtcli-country        = "":U
     1252       .
     1253       find first buf_clients no-lock
     1254            where buf_clients.obj-type = p-obj-type
     1255              and buf_clients.obj-code = p-obj-code
     1256       .
     1257       assign
     1258           v-fmtcli-name = buf_clients.obj-name
     1259       .
     1260       case buf_clients.obj-type:
     1261          when 'орг':U
     1262          then do:
     1263               find first buf_firm no-lock
     1264                    where buf_firm.firm-code = buf_clients.obj-code
     1265                    no-error
     1266               .
     1267               if available buf_firm
     1268               then do:
     1269                   assign
     1270                       v-num-country-city = num-entries( buf_firm.city )
     1271                       v-fmtcli-engl-name = buf_firm.engl-name
     1272                   .
     1273                   if v-num-country-city > 0
     1274                   then do:
     1275                       assign
     1276                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1277                       .
     1278                   end.
     1279                   if v-num-country-city > 1
     1280                   then do:
     1281                       assign
     1282                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1283                       .
     1284                   end.
     1285                   run fmtcli-concatenate-strings in this-procedure (
     1286                         input v-fmtcli-full-addres
     1287                       , input v-fmtcli-country
     1288                       , input ", ":U
     1289                       , input 50
     1290                       , output v-fmtcli-full-addres
     1291                   ).
     1292                   run fmtcli-concatenate-strings in this-procedure (
     1293                         input v-fmtcli-full-addres
     1294                       , input v-fmtcli-city
     1295                       , input ", ":U
     1296                       , input 50
     1297                       , output v-fmtcli-full-addres
     1298                   ).
     1299                   run fmtcli-concatenate-strings in this-procedure (
     1300                         input v-fmtcli-full-addres
     1301                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1302                       , input ", ":U
     1303                       , input 50
     1304                       , output v-fmtcli-full-addres
     1305                   ).
     1306                   run fmtcli-concatenate-strings in this-procedure (
     1307                         input v-fmtcli-post-addres
     1308                       , input v-fmtcli-country
     1309                       , input ", ":U
     1310                       , input 50
     1311                       , output v-fmtcli-post-addres
     1312                   ).
     1313                   run fmtcli-concatenate-strings in this-procedure (
     1314                         input v-fmtcli-post-addres
     1315                       , input v-fmtcli-city
     1316                       , input ", ":U
     1317                       , input 50
     1318                       , output v-fmtcli-post-addres
     1319                   ).
     1320                   run fmtcli-concatenate-strings in this-procedure (
     1321                         input v-fmtcli-post-addres
     1322                       , input string( buf_firm.ind )
     1323                       , input ", ":U
     1324                       , input 50
     1325                       , output v-fmtcli-post-addres
     1326                   ).
     1327                   run fmtcli-concatenate-strings in this-procedure (
     1328                         input substring( buf_firm.addres1, 1, 50 )
     1329                       , input buf_firm.addres2
     1330                       , input " ":U
     1331                       , input 50
     1332                       , output v-temp-fmtcli-address
     1333                   ).
     1334                   run fmtcli-concatenate-strings in this-procedure (
     1335                         input v-temp-fmtcli-address
     1336                       , input substring( buf_firm.addres1, 51, 50 )
     1337                       , input " ":U
     1338                       , input 50
     1339                       , output v-temp-fmtcli-address
     1340                   ).
     1341                   run fmtcli-concatenate-strings in this-procedure (
     1342                         input v-temp-fmtcli-address
     1343                       , input substring( buf_firm.addres1, 101, 50 )
     1344                       , input " ":U
     1345                       , input 50
     1346                       , output v-temp-fmtcli-address
     1347                   ).
     1348                   assign
     1349                       v-fmtcli-addres = v-temp-fmtcli-address
     1350                   .
     1351                   if buf_firm.addres1 <> ?
     1352                   then do:
     1353                       run fmtcli-concatenate-strings in this-procedure (
     1354                             input v-fmtcli-full-addres
     1355                           , input v-fmtcli-addres
     1356                           , input ", ":U
     1357                           , input 0
     1358                           , output v-fmtcli-full-addres
     1359                       ).
     1360                   end.
     1361                   run fmtcli-concatenate-strings in this-procedure (
     1362                         input substring( buf_firm.post-addr1, 1, 50 )
     1363                       , input buf_firm.post-addr2
     1364                       , input " ":U
     1365                       , input 50
     1366                       , output v-fmtcli-post-addres
     1367                   ).
     1368                   run fmtcli-concatenate-strings in this-procedure (
     1369                         input v-fmtcli-post-addres
     1370                       , input substring( buf_firm.post-addr1, 51, 50 )
     1371                       , input " ":U
     1372                       , input 50
     1373                       , output v-fmtcli-post-addres
     1374                   ).
     1375                   run fmtcli-concatenate-strings in this-procedure (
     1376                         input v-fmtcli-post-addres
     1377                       , input substring( buf_firm.post-addr1, 101, 50 )
     1378                       , input " ":U
     1379                       , input 50
     1380                       , output v-fmtcli-post-addres
     1381                   ).
     1382                   assign
     1383                       v-fmtcli-phone         = buf_firm.phone
     1384                       v-fmtcli-inn           = buf_firm.inn
     1385                       v-fmtcli-kpp           = buf_firm.kpp
     1386                       v-fmtcli-okpo          = buf_firm.okpo
     1387                       v-fmtcli-index         = string( buf_firm.ind )
     1388                   .
     1389               end.
     1390          end.
     1391          when 'маг':U
     1392          then do:
     1393               find first buf_shop no-lock
     1394                    where buf_shop.obj-code = buf_clients.obj-code
     1395               .
     1396               if available buf_shop
     1397               then do:
     1398                   run fmtcli-concatenate-strings in this-procedure (
     1399                         input buf_shop.addres1
     1400                       , input buf_shop.addres2
     1401                       , input " ":U
     1402                       , input 50
     1403                       , output v-fmtcli-addres
     1404                   ).
     1405                   assign
     1406                       v-fmtcli-full-addres = v-fmtcli-addres
     1407                       v-fmtcli-post-addres = v-fmtcli-addres
     1408                       v-fmtcli-phone       = buf_shop.phone
     1409                       v-fmtcli-inn         = "":U
     1410                       v-fmtcli-kpp         = "":U
     1411                       v-fmtcli-okpo        = "":U
     1412                       v-fmtcli-city        = "":U
     1413                       v-fmtcli-index       = "":U
     1414                   .
     1415               end.
     1416          end.
     1417          when 'скл':U
     1418          then do:
     1419               find first buf_store no-lock
     1420                    where buf_store.obj-code = buf_clients.obj-code
     1421               .
     1422               if available buf_store
     1423               then do:
     1424                   run fmtcli-concatenate-strings in this-procedure (
     1425                         input buf_store.addres1
     1426                       , input buf_store.addres2
     1427                       , input " ":U
     1428                       , input 50
     1429                       , output v-fmtcli-addres
     1430                   ).
     1431                   assign
     1432                       v-fmtcli-full-addres = v-fmtcli-addres
     1433                       v-fmtcli-phone       = buf_store.phone
     1434                       v-fmtcli-inn         = "":U
     1435                       v-fmtcli-kpp         = "":U
     1436                       v-fmtcli-okpo        = "":U
     1437                       v-fmtcli-city        = "":U
     1438                       v-fmtcli-index       = "":U
     1439                   .
     1440               end.
     1441          end.
     1442          when 'чел':U
     1443          then do:
     1444               find first buf_person no-lock
     1445                    where buf_person.psn-code = buf_clients.obj-code
     1446               .
     1447               if available buf_person
     1448               then do:
     1449                   run fmtcli-concatenate-strings in this-procedure (
     1450                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1451                                 then "":U
     1452                                 else string( buf_person.ind, "999999")
     1453                                 )
     1454                       , input buf_person.city
     1455                       , input ", ":U
     1456                       , input 0
     1457                       , output v-fmtcli-full-addres
     1458                   ).
     1459                   assign
     1460                       v-fmtcli-addres = buf_person.address
     1461                   .
     1462                   run fmtcli-concatenate-strings in this-procedure (
     1463                         input v-fmtcli-full-addres
     1464                       , input v-fmtcli-addres
     1465                       , input ", ":U
     1466                       , input 0
     1467                       , output v-fmtcli-full-addres
     1468                   ).
     1469                   assign
     1470                       v-fmtcli-phone     = buf_person.phone1
     1471                       v-fmtcli-inn       = buf_person.inn
     1472                       v-fmtcli-kpp       = buf_person.kpp
     1473                       v-fmtcli-okpo      = buf_person.okpo
     1474                       v-fmtcli-city      = buf_person.city
     1475                       v-fmtcli-index     = string( buf_person.ind )
     1476                   .
     1477               end.
     1478          end.
     1479       end case.
     1480   end.
     1481   end procedure.
     1482   procedure fmtcli-concatenate-strings :
     1483   define input parameter p-string-1       as character        no-undo.
     1484   define input parameter p-string-2       as character        no-undo.
     1485   define input parameter p-delimiter      as character        no-undo.
     1486   define input parameter p-length         as integer          no-undo.
     1487   define output parameter p-out-string    as character        no-undo.
     1488   do
     1489   on error undo, return error
     1490   :
     1491       assign
     1492           p-out-string = ( if p-string-1 = ?
     1493                            then "":U
     1494                            else trim( p-string-1 ) )
     1495       .
     1496       assign
     1497           p-out-string = p-out-string
     1498                        + ( if p-out-string = "":U
     1499                            or length( p-out-string ) = p-length
     1500                            or p-string-2 = ?
     1501                            or trim( p-string-2 ) = "":U
     1502                            then "":U
     1503                            else p-delimiter )
     1504                        + ( if p-string-2 = ?
     1505                            or trim( p-string-2 ) = "":U
     1506                            then "":U
     1507                            else trim( p-string-2 ) )
     1508       .
     1509   end.
     1510   end procedure.
