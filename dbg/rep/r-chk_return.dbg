     2055                 input p-obj-type
     2056               , input p-obj-code
     2057               , output v-torgconf-self-host-code
     2058           ).
     2059           if v-torgconf-self-host-code = 0
     2060           then do:
     2061               return error.
     2062           end.
     2063       end.
     2064       else do:
     2065           assign
     2066               v-torgconf-self-host-code = v-host-code
     2067           .
     2068       end.
