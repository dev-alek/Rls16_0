     2148   procedure torgconf-get-recepient-param :
     2149   define input parameter torgconfdoc-code   as character                  no-undo.
     2150   define output parameter v-code-rec        as integer                    no-undo .
     2151   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     2152   define output parameter v-codefirm-rec    as integer                    no-undo .
     2153   define output parameter v-curcode-rec     as integer                    no-undo .
     2154        define variable  v-recipient-code  as character                  no-undo .
     2155        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     2156        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     2157   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     2158                           input 'Recipient':U ,
     2159                          output v-recipient-code ,
     2160                          output v-trdcattr-type ) no-error .
     2161       if error-status :error then do:
     2162        message
     2163         vss-workfile vss-revision vss-description skip
     2164         "Ошибка при вызове процедуры tdat-val":U skip
     2165         "Документ: " torgconfdoc-code skip
     2166         "Атрибут: " 'Recipient':U skip
     2167         "Значение: " v-recipient skip
     2168         trim( error-status :get-message (1) ) skip
     2169         return-value skip
     2170         view-as alert-box error.
     2171       undo, return error return-value.
     2172       end.
     2173     assign
     2174       v-recipient  = v-recipient-code
     2175       v-type-rec = substring(v-recipient-code,1,3)
     2176       v-code-rec  = int(substring(v-recipient-code,4,15))
     2177       no-error
     2178     .
     2179     if v-type-rec = ? then v-type-rec = "" .
     2180     if v-code-rec  = ? then v-code-rec  =  0 .
     2181     end procedure.
