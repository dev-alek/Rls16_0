     2092               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     2093               v-torgconf-self-host-phone       = v-fmtcli-phone
     2094               v-torgconf-self-host-inn         = v-fmtcli-inn
     2095               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     2096               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     2097           .
