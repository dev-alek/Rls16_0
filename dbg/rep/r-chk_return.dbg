     2377   procedure torgconf-get-sup-param :
     2378   define input parameter p-obj-type           as character        no-undo.
     2379   define input parameter p-obj-code           as integer          no-undo.
     2380   define input parameter p-curr-code          as integer          no-undo.
     2381       define variable v-host-code    as integer      no-undo.
     2382       define variable v-par-type     as character    no-undo.
     2383   do
     2384   on error undo, return error
     2385   :
     2386       assign
     2387          v-torgconf-sup-host-code = v-host-code
     2388       .
     2389       if v-torgconf-sup-host-code = 0
     2390       then do:
     2391           assign
     2392               v-torgconf-sup-host-name           = "":U
     2393               v-torgconf-sup-host-addres         = "":U
     2394               v-torgconf-sup-host-post-addres    = "":U
     2395               v-torgconf-sup-host-phone          = "":U
     2396               v-torgconf-sup-host-inn            = "":U
     2397               v-torgconf-sup-host-kpp            = "":U
     2398               v-torgconf-sup-host-okpo           = "":U
     2399               v-torgconf-sup-host-egrip-date     = "":U
     2400               v-torgconf-sup-host-egrip-num      = "":U
     2401           .
     2402       end.
     2403       else do:
     2404           run fmtcli-get-client in this-procedure (
     2405                 input 'орг':U
     2406               , input v-torgconf-sup-host-code
     2407           ).
     2408           assign
     2409               v-torgconf-sup-host-name        = v-fmtcli-name
     2410               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2411               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2412               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2413               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2414               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2415               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2416               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2417           .
     2418           run gbl/clntat-v.p (
     2419                 input 'орг':U
     2420               , input v-torgconf-sup-host-code
     2421               , input 'egrip-date':U
     2422               , output v-torgconf-sup-host-egrip-date
     2423               , output v-par-type
     2424           ).
     2425           run gbl/clntat-v.p (
     2426                 input 'орг':U
     2427               , input v-torgconf-sup-host-code
     2428               , input 'egrip-num':U
     2429               , output v-torgconf-sup-host-egrip-num
     2430               , output v-par-type
     2431           ).
     2432           run fmtcli-get-bank in this-procedure (
     2433                 input v-host-code
     2434               , input 'орг':U
     2435               , input v-torgconf-sup-host-code
     2436               , input p-curr-code
     2437           ).
     2438       end.
     2439       assign
     2440           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2441           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2442           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2443           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2444           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2445           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2446           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2447           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2448       .
     2449       assign
     2450           v-torgconf-sup-obj-type = p-obj-type
     2451           v-torgconf-sup-obj-code = p-obj-code
     2452       .
     2453       if trim(p-obj-type) <> ""
     2454       and p-obj-code <> 0
     2455       then do:
     2456       run fmtcli-get-client in this-procedure (
     2457             input p-obj-type
     2458           , input p-obj-code
     2459       ).
     2460       assign
     2461           v-torgconf-sup-obj-name        = v-fmtcli-name
     2462           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2463           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2464           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2465           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2466           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2467           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2468       .
     2469      end.
     2470      end.
     2471   end procedure.
     2472   procedure torgconf-get-cli-param :
     2473   define input parameter p-host-obj-code      as integer          no-undo.
     2474   define input parameter p-obj-type           as character        no-undo.
     2475   define input parameter p-obj-code           as integer          no-undo.
     2476   define input parameter p-curr-code          as integer          no-undo.
     2477       define variable v-host-code    as integer      no-undo.
     2478   do
     2479   on error undo, return error
     2480   :
