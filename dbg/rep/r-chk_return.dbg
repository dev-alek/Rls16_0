     4444                  run rep/get-psn.p
     4445                  (input buf_wth-doc.deliver
     4446                  ,output v-torgconf-ogr-name
     4447                  ) .
     4448               end.
     4449               find first buf_person no-lock
     4450               where buf_person.psn-code = buf_wth-doc.deliver
     4451               no-error.
     4452               if available buf_person
     4453               then do:
     4454                  v-torgconf-ogr-post = buf_person.position.
     4455               end.
     4456               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4457               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4458            end.
     4459      end.
     4460   end.
     4461   procedure torgconf-get-reason  :
     4462   define input parameter  p-doc-code       as character        no-undo.
     4463   define input parameter  p-reason-code    as integer          no-undo .
     4464   define input parameter  p-doc-type       as character        no-undo.
     4465       if p-reason-code > 0
     4466       then do:
     4467           define buffer buf_trn-reason for ub.trn-reason.
     4468           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4469           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4470       end.
     4471       else do:
     4472           if p-doc-type = 'при':U
     4473           then  do:
     4474               define variable v-attr-type     as character    no-undo.
     4475               define variable v-attr-value    as character    no-undo.
     4476               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4477               assign v-torgconf-reason = v-attr-value .
     4478               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4479               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4480           end.
     4481       end.
     4482   end procedure.
     4483   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4484   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4485   procedure paramls-clear :
     4486     define buffer buf_temp-param for temp-param .
     4487     do
     4488     on error undo, return error return-value
     4489     :
     4490       for each buf_temp-param
     4491       on error undo, return error
     4492       :
     4493         delete buf_temp-param .
     4494       end.
     4495     end.
     4496   end procedure.
     4497   procedure paramls-write :
     4498     define input  parameter p-code     as character no-undo .
     4499     define input  parameter p-sub-code as character no-undo .
     4500     define input  parameter p-value    as character no-undo .
     4501     define buffer buf_temp-param for temp-param .
     4502     do
     4503     on error undo, return error return-value
     4504     :
     4505       find first buf_temp-param
     4506         where buf_temp-param.param-code     = p-code
     4507           and buf_temp-param.param-sub-code = p-sub-code
     4508         no-error .
     4509       if not available buf_temp-param then do:
     4510         create buf_temp-param .
     4511         assign
     4512           buf_temp-param.param-code     = p-code
     4513           buf_temp-param.param-sub-code = p-sub-code
     4514         .
     4515       end.
     4516       assign
     4517         buf_temp-param.param-value = p-value
     4518       .
     4519     end.
     4520   end procedure.
     4521   procedure paramls-read :
     4522     define input  parameter p-code          as character no-undo .
     4523     define input  parameter p-sub-code      as character no-undo .
     4524     define input  parameter p-default-value as character no-undo .
     4525     define output parameter p-value         as character no-undo .
     4526     define buffer buf_temp-param for temp-param .
     4527     do
     4528     on error undo, return error return-value
     4529     :
     4530       find first buf_temp-param
     4531         where buf_temp-param.param-code     = p-code
     4532           and buf_temp-param.param-sub-code = p-sub-code
     4533         no-error .
     4534       if available buf_temp-param then do:
     4535         assign
     4536           p-value = buf_temp-param.param-value
     4537         .
     4538       end.
     4539       else do:
     4540         assign
     4541           p-value = p-default-value
     4542         .
     4543       end.
     4544     end.
     4545   end procedure.
     4546   procedure paramls-append :
     4547     define input  parameter p-code     as character no-undo .
     4548     define input  parameter p-sub-code as character no-undo .
     4549     define input  parameter p-value    as character no-undo .
     4550     define buffer buf_temp-param for temp-param .
     4551     do
     4552     on error undo, return error return-value
     4553     :
     4554       find first buf_temp-param
     4555            where buf_temp-param.param-code     = p-code
     4556              and buf_temp-param.param-sub-code = p-sub-code
     4557         no-error .
     4558       if not available buf_temp-param then do:
     4559         create buf_temp-param .
     4560         assign
     4561           buf_temp-param.param-code     = p-code
     4562           buf_temp-param.param-sub-code = p-sub-code
     4563           buf_temp-param.param-value    = p-value
     4564         .
     4565       end.
     4566       else do:
     4567           assign
     4568               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4569           .
     4570       end.
     4571     end.
     4572   end procedure.
