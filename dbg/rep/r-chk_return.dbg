     5155   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5156   define  stream PrnLibStream.
     5157   procedure prn-lib-prn-file :
     5158     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5159     define input parameter p-DIsabledoptions as integer no-undo .
     5160     define variable v-report-name as character no-undo .
     5161     define variable v-user-action as character no-undo .
     5162     define variable v-printed     as logical   no-undo .
     5163     define variable v-exist       as logical   no-undo .
     5164     do
     5165       on error undo, return error
     5166       :
     5167       run prn-lib-get-report-name  in this-procedure (
     5168         input parParentProc
     5169         ,output v-report-name
     5170         ).
     5171   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5172   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     5173     (input  v-report-name
     5174     ,input  2
     5175     ,output v-exist
     5176     )  .
     5177       if NOT v-exist then
     5178       DO:
     5179         Message
     5180           "Нет заданий на печать ! "
     5181           view-as alert-box .
     5182         Return  .
     5183       End.
     5184       run gbl/prnfilen.w
     5185         (input  ""
     5186         ,input  p-DisabledOptions
     5187         ,input  string(v-report-name )
     5188         ,input  7
     5189         ,output v-user-action
     5190         ,output v-printed
     5191         ) .
     5192       if v-printed then
     5193       do:
     5194         return "YES" .
     5195       end.
     5196       else
     5197       do:
     5198         return "NO" .
     5199       end.
     5200     end.
     5201   end procedure.
     5202   procedure prn-lib-open-stream :
     5203     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5204     define input parameter p-page-size    as integer no-undo .
     5205     define input parameter p-is-stream    as logical no-undo .
     5206     define input parameter p-append       as logical no-undo .
     5207     define variable v-report-name as character no-undo .
     5208     do
     5209       on error undo, return error
     5210       :
     5211       run prn-lib-get-report-name  in this-procedure (
     5212         input parParentProc
     5213         ,output v-report-name
     5214         ).
     5215       if p-is-stream then
     5216       do:
     5217         if p-append then
     5218         do:
     5219           output stream PrnLibStream to value( v-report-name )
     5220             page-size value(p-page-size) append .
     5221         end.
     5222         if not p-append then
     5223         do:
     5224           output stream PrnLibStream to value( v-report-name )
     5225             page-size value(p-page-size) .
     5226         end.
     5227       end.
     5228       if not p-is-stream then
     5229       do:
     5230         if p-append then
     5231         do:
     5232           output to value( v-report-name )
     5233             page-size value(p-page-size) append .
     5234         end.
     5235         if not p-append then
     5236         do:
     5237           output to value( v-report-name )
     5238             page-size value(p-page-size) .
     5239         end.
     5240       end.
     5241     end.
     5242   end procedure.
     5243   procedure prn-lib-open-exp :
     5244     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5245     define input parameter p-is-stream    as logical no-undo .
     5246     define input parameter p-is-append    as logical no-undo .
     5247     define output parameter p-ReportFileName as char init "report" no-undo.
     5248     define output parameter p-process as logical no-undo .
     5249     define variable glog as logical no-undo .
     5250     do
     5251       on error undo, return error
     5252       :
     5253       SYSTEM-DIALOG GET-FILE p-ReportFileName
     5254         TITLE      "Укажите путь"
     5255         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     5256         ASK-OVERWRITE
     5257         CREATE-TEST-FILE
     5258         SAVE-AS
     5259         USE-FILENAME
     5260         DEFAULT-EXTENSION "txt"
     5261         UPDATE glog
     5262         .
     5263       if not glog then  return.
     5264       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     5265       if p-is-stream then
     5266       do:
     5267         if p-is-append then
     5268         do:
     5269           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5270         end.
     5271         else
     5272         do:
     5273           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5274         end.
     5275       end.
     5276       else
     5277       do:
     5278         if p-is-append then
     5279         do:
     5280           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5281         end.
     5282         else
     5283         do:
     5284           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5285         end.
     5286       end.
     5287       p-process = yes.
     5288     end.
     5289   end procedure.
     5290   procedure prn-lib-get-report-name :
     5291     define input parameter parParentProc  as widget-handle no-undo.
     5292     define output parameter p-report-name as character no-undo .
     5293     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     5294   end procedure.
     5295   procedure prn-lib-reportviewer-report-name :
