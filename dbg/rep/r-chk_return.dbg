        5   define variable vss-revision    as character no-undo init "$Revision: 5d506dbcaae6, 2911, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        7   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:14 2021 +0300 $":U .
