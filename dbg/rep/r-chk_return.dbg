     1721   procedure wthcattr-sprcli :
     1722   define input parameter parparentproc  as widget-handle no-undo.
     1723   define input parameter p-mode  as character no-undo.
     1724   define input-output parameter p-value as character no-undo .
     1725   define output parameter p-setted as logical no-undo .
     1726     DEFINE VARIABLE v-value as character no-undo .
     1727     define variable v-cli-type as character no-undo .
     1728     define variable v-cli-code as integer no-undo .
     1729     define buffer buf_clients   for ub.clients.
     1730     define variable v_rid as character no-undo.
     1731     define variable ref-rec as recid no-undo .
     1732     do
     1733     on error undo, return error
     1734     :
     1735         v-value = p-value.
     1736      if p-value <> '':U then do:
     1737       assign
     1738       v-cli-type = substring(p-value, 1, 3)
     1739       v-cli-code = integer(substring(p-value, 4))
     1740       no-error.
     1741       if error-status:error then do:
     1742         assign
     1743         v-cli-type = '':U
     1744         v-cli-code = 0
     1745         .
     1746       end.
     1747      end.
     1748      FIND FIRST buf_clients NO-LOCK WHERE
     1749               buf_clients.obj-type = v-cli-type AND
     1750               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1751      IF available(buf_clients) then do:
     1752       run ref/cli-all.w (
     1753                   input parparentproc
     1754                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1755                  ,input v-cli-type
     1756                  ,input 'все':U
     1757                  ,input 'все':U
     1758                  ,input RECID( buf_clients )
     1759                  ,input ",,,,,,NO"
     1760                  ,input ?
     1761                  ,OUTPUT v_rid ).
     1762     END.
     1763     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1764       run ref/cli-all.w (
     1765                    input parparentproc
     1766                   ,INPUT "b-sel":U
     1767                  ,input  v-cli-type
     1768                  ,input 'все':U
     1769                  ,input 'текущие':U
     1770                  ,input ?
     1771                  ,input ",,,,,,NO"
     1772                  ,input ?
     1773                  ,OUTPUT v_rid ).
     1774     END.
     1775     else do:
     1776       message
     1777       if p-value = "":U then 'Атрибут не задан!'
     1778       else substitute('Не найден клиент &1',p-value)
     1779       view-as alert-box warning.
     1780     end.
     1781     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1782       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1783       IF ERROR-STATUS:ERROR THEN DO:
     1784           RETURN NO-APPLY.
     1785       END.
     1786       FIND FIRST buf_clients NO-LOCK WHERE
     1787                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1788       IF AVAIL buf_clients THEN DO:
     1789         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1790       end.
     1791     end.
     1792     if v-value <> p-value then do:
     1793       p-value = v-value.
     1794       p-setted = yes.
     1795     end.
     1796     end.
     1797   end procedure.
     1798     define new global shared variable g#wthcalib as handle no-undo.
     1799   procedure torgconf-read :
     1800   do
     1801   on error undo, return error
     1802   :
     1803       define input parameter p-form-name  as character    no-undo.
     1804       define input parameter p-host-code  as integer      no-undo.
     1805       define input parameter p-obj-type   as character    no-undo.
     1806       define input parameter p-obj-code   as integer      no-undo.
     1807       define variable v-outdate   as character     no-undo.
     1808       define variable v-outares   as character     no-undo.
     1809       define variable v-outsend   as character     no-undo.
     1810       define variable v-outasend  as character     no-undo.
     1811       define variable v-outprops  as character     no-undo.
     1812       define variable v-outnum    as character     no-undo.
     1813       define variable v-outprim   as character     no-undo.
     1814       define variable v-outdisc   as character     no-undo.
     1815       define variable v-outsubs   as character     no-undo.
     1816       define variable v-outrecv   as character     no-undo.
     1817       define variable v-outegrp   as character     no-undo.
