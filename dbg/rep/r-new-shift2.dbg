     2412                areal-is-pay-netto = 0
     2413                areal-no-pay-qnty1 = 0
     2414                areal-no-pay-qnty2 = 0
     2415                areal-no-pay-netto = 0.
     2416         FOR EACH actreal-2 NO-LOCK
     2417             BREAK
     2418               BY actreal-2.gds-code
     2419               By actreal-2.is-pay    DESCENDING
     2420               BY actreal-2.cpay-code DESCENDING
     2421               BY actreal-2.curr-code :
     2422           if actreal-2.is-pay = yes then do:
     2423             if actreal-2.curr-code >= 0 then
