      780   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   procedure cur-time :
      782      define output parameter p-today as date      no-undo .
      783      define output parameter p-time  as integer   no-undo .
      784     do
      785     on error undo, return error
      786     :
      787       define variable v-date1 as date      no-undo .
      788       define variable v-date2 as date      no-undo .
      789       define variable v-time  as integer   no-undo .
      790       assign
      791         v-date1 = today
      792         v-time  = time
      793         v-date2 = today
      794       .
      795       if v-date1 <> v-date2
      796       then do:
      797         assign
      798           v-date1 = today
      799           v-time  = v-time
      800         .
      801       end.
      802       assign
      803         p-today = v-date1
      804         p-time  = v-time
      805       .
      806     end.
      807   end.
      808   function cur-time-date returns character
      809   :
      810     return string(today, '99/99/9999':U) .
      811   end.
      812   function cur-time-mjd returns decimal
      813   :
      814     define variable v-date as date      no-undo .
      815     define variable v-time as integer   no-undo .
      816     run cur-time in this-procedure
      817       (output v-date
      818       ,output v-time
      819       ) .
      820     return integer(v-date) - 2400002 + (v-time / 86400) .
      821   end.
      822   function cur-time-get-ending-index returns integer
      823   (input p-number as integer
      824   )
      825   :
      826     if p-number < 0
      827     or p-number = ?
      828     then do:
      829       return 1 .
      830     end.
      831     define variable v-rest as integer   no-undo .
      832     assign
      833       p-number = p-number modulo 100
      834     .
      835     if p-number < 20
      836     then do:
      837       assign
      838         v-rest = p-number
      839       .
      840     end.
      841     else do:
      842       assign
      843         v-rest = p-number modulo 10
      844       .
      845     end.
      846     case v-rest :
      847       when 1
      848       then do:
      849         return 2 .
      850       end.
      851       when 2 or
      852       when 3 or
      853       when 4
      854       then do:
      855         return 3 .
      856       end.
      857       otherwise do:
      858         return 1 .
      859       end.
      860     end case .
      861   end.
      862   procedure cur-time-mjd-to-date :
      863      define input  parameter i-mjd-diff as decimal no-undo.
      864      define output parameter o-Date     as date    no-undo.
      865      define output parameter o-Time     as integer no-undo.
      866      define variable v-day-number as integer   no-undo .
      867      if    i-mjd-diff < 0
      868         or i-mjd-diff = ?
      869      then do:
      870         return "?" .
      871      end.
      872      assign
      873         v-day-number = truncate(i-mjd-diff,0).
      874         o-Date = date(v-day-number + 2400002).
      875         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      876     .
      877   end.
      878   function cur-time-mjd-to-string returns character
      879   (input p-mjd-diff as decimal
      880   )
      881   :
      882     define variable v-day-number as integer   no-undo .
      883     define variable v-seconds    as integer   no-undo .
      884     define variable v-hour       as integer   no-undo .
      885     define variable v-min        as integer   no-undo .
      886     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      887     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      888     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      889     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      890     if p-mjd-diff < 0
      891     or p-mjd-diff = ?
      892     then do:
      893       return "?" .
      894     end.
      895     assign
      896       v-day-number = integer(truncate(p-mjd-diff,0))
      897       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      898     .
      899     if v-seconds > 86400
      900     then do:
      901       assign
      902         v-seconds = 86400 - 1
      903       .
      904     end.
      905     if v-seconds < 0
      906     then do:
      907       assign
      908         v-seconds = 0
      909       .
      910     end.
      911     assign
      912       v-hour = truncate(v-seconds / 3600, 0)
      913     .
      914     assign
      915       v-seconds = v-seconds modulo 3600
      916     .
      917     assign
      918       v-min = truncate(v-seconds / 60, 0)
      919     .
      920     assign
      921       v-seconds = v-seconds modulo 60
      922     .
      923     return
      924         (if v-day-number <> 0
      925           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      926           else ""
      927         )
      928       + (if v-day-number <> 0 or v-hour <> 0
      929           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      930           else ""
      931         )
      932       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      933           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      934           else ""
      935         )
      936       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      937       .
      938   end.
      939   function cur-time-string returns character
      940   :
      941     define variable v-date as date      no-undo .
      942     define variable v-time as integer   no-undo .
      943     run cur-time in this-procedure
      944       (output v-date
      945       ,output v-time
      946       ) .
      947     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      948   end.
      949   function cur-time-string-sec returns character
      950   :
      951     define variable v-date as date      no-undo .
      952     define variable v-time as integer   no-undo .
      953     run cur-time in this-procedure
      954       (output v-date
      955       ,output v-time
      956       ) .
      957     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      958   end.
      959   function cur-time-custom  returns character
      960   (input p-prefix as character
      961   ,input p-date-format as character
      962   ,input p-delimiter as character
      963   ,input p-time-format as character
      964   ,input p-suffix as character
      965   )
      966   :
      967     define variable v-date as date      no-undo .
      968     define variable v-time as integer   no-undo .
      969     run cur-time in this-procedure
      970       (output v-date
      971       ,output v-time
      972       ) .
      973     return
      974       p-prefix
      975       + string(v-date, p-date-format)
      976       + p-delimiter
      977       + string(v-time, p-time-format)
      978       + p-suffix
      979       .
      980   end.
      981   function cur-time-print  returns character
      982   :
      983     define variable v-date as date      no-undo .
      984     define variable v-time as integer   no-undo .
      985     run cur-time in this-procedure
      986       (output v-date
      987       ,output v-time
      988       ) .
      989     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      990   end.
      991   function cur-time-datetime returns datetime
      992   :
      993     define variable v-char as character no-undo .
      994     define variable v-datetime as datetime no-undo .
      995     v-char = cur-time-string().
      996     v-datetime = datetime(v-char).
      997     return  v-datetime.
      998   end.
      999   function cur-time-string-msec returns character
     1000   :
     1001     define variable v-date as datetime  no-undo .
     1002     v-date = now.
     1003     return string(v-date) .
     1004   end.
     1005   procedure cp-attr-code :
     1006     do
     1007     on error undo, return error
     1008     :
     1009       define input  parameter p-code           as character no-undo .
     1010       define output parameter p-type           as character no-undo .
     1011       define output parameter p-format         as character no-undo .
     1012       define output parameter p-label          as character no-undo .
     1013       define output parameter p-range          as integer   no-undo .
     1014       define output parameter p-user-can-edit  as logical   no-undo .
     1015       define output parameter p-output-display as logical   no-undo .
     1016       define output parameter p-other          as character no-undo .
     1017       case p-code :
     1018               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1019               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     1020               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     1021               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     1022               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1023               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1024               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1025               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1026               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1027               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1028         otherwise do:
     1029           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1030         end.
     1031       end.
     1032     end.
     1033   end procedure.
     1034   procedure cp-attr-tooltip :
     1035     do
     1036     on error undo, return error
     1037     :
     1038       define input  parameter p-code    as character no-undo .
     1039       define output parameter p-tooltip as character no-undo .
     1040       define output parameter p-label   as character no-undo .
     1041       case p-code :
     1042               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
     1043               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
     1044               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
     1045               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
     1046               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
     1047               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
     1048               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
     1049               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
     1050               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
     1051               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
     1052         otherwise do:
     1053           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
     1054         end.
     1055       end.
     1056     end.
     1057   end procedure.
     1058   procedure cp-attr-value :
     1059     do
     1060     on error undo, return error
     1061     :
     1062       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1063       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1064       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1065       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1066       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1067       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     1068       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     1069       define output parameter p-type        as character no-undo .
     1070       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1071       define variable v-format         as character no-undo .
     1072       define variable v-label          as character no-undo .
     1073       define variable v-range          as integer   no-undo .
     1074       define variable v-user-can-edit  as logical   no-undo .
     1075       define variable v-output-display as logical   no-undo .
     1076       define variable v-other          as character no-undo .
     1077       run cp-attr-code in this-procedure
     1078         (input  p-code
     1079         ,output p-type
     1080         ,output v-format
     1081         ,output v-label
     1082         ,output v-range
     1083         ,output v-user-can-edit
     1084         ,output v-output-display
     1085         ,output v-other
     1086         ) no-error .
     1087       if error-status :error then do:
     1088         undo, return error return-value .
     1089       end.
     1090       find first buf_cash-pay-attr no-lock
     1091         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1092           and buf_cash-pay-attr.curr-code  = p-curr-code
     1093           and buf_cash-pay-attr.host-code  = p-host-code
     1094           and buf_cash-pay-attr.obj-type   = p-obj-type
     1095           and buf_cash-pay-attr.obj-code   = p-obj-code
     1096           and buf_cash-pay-attr.attr-code  = p-code
     1097         no-error .
     1098       if avail buf_cash-pay-attr then do:
     1099         assign
     1100           p-value =  buf_cash-pay-attr.attr-value
     1101         .
     1102       end.
     1103       else do:
     1104         assign
     1105           p-value = if p-type = 'L':U then "no":U else ""
     1106         .
     1107       end.
     1108     end.
     1109   end procedure.
     1110   procedure cp-attr-write :
     1111     do
     1112     on error undo, return error
     1113     :
     1114       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1115       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1116       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1117       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1118       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1119       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1120       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     1121       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1122       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     1123       define variable v-type           as character no-undo .
     1124       define variable v-format         as character no-undo .
     1125       define variable v-label          as character no-undo .
     1126       define variable v-range          as integer   no-undo .
     1127       define variable v-user-can-edit  as logical   no-undo .
     1128       define variable v-output-display as logical   no-undo .
     1129       define variable v-other          as character no-undo .
     1130       run cp-attr-code in this-procedure
     1131         (input  p-code
     1132         ,output v-type
     1133         ,output v-format
     1134         ,output v-label
     1135         ,output v-range
     1136         ,output v-user-can-edit
     1137         ,output v-output-display
     1138         ,output v-other
     1139         ) no-error .
     1140       if error-status :error then do:
     1141         undo, return error return-value .
     1142       end.
     1143       find first buf_cash-pay-attr exclusive-lock
     1144         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1145           and buf_cash-pay-attr.curr-code  = p-curr-code
     1146           and buf_cash-pay-attr.host-code  = p-host-code
     1147           and buf_cash-pay-attr.obj-type   = p-obj-type
     1148           and buf_cash-pay-attr.obj-code   = p-obj-code
     1149           and buf_cash-pay-attr.attr-code = p-code
     1150         no-error .
     1151       if not available buf_cash-pay-attr then do:
     1152         create buf_cash-pay-attr .
     1153         assign
     1154         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1155         buf_cash-pay-attr.curr-code  = p-curr-code
     1156         buf_cash-pay-attr.host-code  = p-host-code
     1157         buf_cash-pay-attr.obj-type   = p-obj-type
     1158         buf_cash-pay-attr.obj-code   = p-obj-code
     1159         buf_cash-pay-attr.attr-code = p-code
     1160         .
     1161       end.
     1162       assign
     1163         buf_cash-pay-attr.attr-value = p-value
     1164       .
     1165       release buf_cash-pay-attr no-error .
     1166       if error-status:error then do:
     1167         undo, return error return-value .
     1168       end.
     1169     end.
     1170   end procedure.
     1171   procedure cp-attr-exist :
     1172     do
     1173     on error undo, return error
     1174     :
     1175       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1176       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1177       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1178       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1179       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1180       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1181       define output parameter p-exist   as logical  no-undo .
     1182       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1183       define variable v-type           as character no-undo .
     1184       define variable v-format         as character no-undo .
     1185       define variable v-label          as character no-undo .
     1186       define variable v-range          as integer   no-undo .
     1187       define variable v-user-can-edit  as logical   no-undo .
     1188       define variable v-output-display as logical   no-undo .
     1189       define variable v-other          as character no-undo .
     1190       run cp-attr-code in this-procedure
     1191         (input  p-code
     1192         ,output v-type
     1193         ,output v-format
     1194         ,output v-label
     1195         ,output v-range
     1196         ,output v-user-can-edit
     1197         ,output v-output-display
     1198         ,output v-other
     1199         ) no-error .
     1200       if error-status :error then do:
     1201         undo, return error return-value .
     1202       end.
     1203       find first buf_cash-pay-attr exclusive-lock
     1204         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1205           and buf_cash-pay-attr.curr-code  = p-curr-code
     1206           and buf_cash-pay-attr.host-code  = p-host-code
     1207           and buf_cash-pay-attr.obj-type   = p-obj-type
     1208           and buf_cash-pay-attr.obj-code   = p-obj-code
     1209           and buf_cash-pay-attr.attr-code = p-code
     1210         no-error .
     1211       if  available buf_cash-pay-attr then do:
     1212         p-exist = yes.
     1213       end.
     1214     end.
     1215   end procedure.
     1216   procedure cp-attr-delete :
     1217     do
     1218     on error undo, return error
     1219     :
     1220       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1221       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1222       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1223       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1224       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1225       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1226       define output parameter p-deleted  as logical no-undo.
     1227       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1228       define variable v-type           as character no-undo .
     1229       define variable v-format         as character no-undo .
     1230       define variable v-label          as character no-undo .
     1231       define variable v-range          as integer   no-undo .
     1232       define variable v-user-can-edit  as logical   no-undo .
     1233       define variable v-output-display as logical   no-undo .
     1234       define variable v-other          as character no-undo .
     1235       run cp-attr-code in this-procedure
     1236         (input  p-code
     1237         ,output v-type
     1238         ,output v-format
     1239         ,output v-label
     1240         ,output v-range
     1241         ,output v-user-can-edit
     1242         ,output v-output-display
     1243         ,output v-other
     1244         ) no-error .
     1245       if error-status :error then do:
     1246         undo, return error return-value .
     1247       end.
     1248       find first buf_cash-pay-attr exclusive-lock
     1249         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1250           and buf_cash-pay-attr.curr-code  = p-curr-code
     1251           and buf_cash-pay-attr.host-code  = p-host-code
     1252           and buf_cash-pay-attr.obj-type   = p-obj-type
     1253           and buf_cash-pay-attr.obj-code   = p-obj-code
     1254           and buf_cash-pay-attr.attr-code = p-code
     1255         no-error NO-WAIT.
     1256       if not available buf_cash-pay-attr then do:
     1257         p-deleted = no.
     1258       end.
     1259       else do:
     1260         delete buf_cash-pay-attr no-error .
     1261         if error-status:error then do:
     1262           undo, return error return-value .
     1263         end.
     1264         p-deleted = yes.
     1265       end.
     1266     end.
     1267   end procedure.
     1268   procedure cp-attr-news :
     1269     do
     1270     on error undo, return error
     1271     :
     1272       define input  parameter p-code           as character no-undo .
     1273       define output parameter p-news           as logical   no-undo .
     1274       case p-code :
     1275               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1276               when 'grp-code':U then do:     assign     p-news = true.   end.
     1277               when 'is-use':U then do:     assign     p-news = true.   end.
     1278               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1279               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1280               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1281               when 'form_km3':U then do:     assign     p-news = false.   end.
     1282               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1283               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1284               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1285         otherwise do:
     1286           p-news = no.
     1287         end.
     1288       end.
     1289     end.
     1290   end procedure.
     1291   procedure cp-attr-hist :
     1292     do
     1293     on error undo, return error
