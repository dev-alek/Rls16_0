     2494                       <th></th>
     2495                  </tr>'
     2496               ,
     2497               pol13,
     2498               string(pol14,"->>>>>>>>>>>9.99"),
     2499               string(pol15,"->>>>>>>>>>>9.99"),
     2500               string(pol16,"->>>>>>>>>>>9.99")
     2501               ).
     2502           end.
     2503         END.
     2504       END.
     2505   output stream OutStr-html close.
     2506     END.
     2507   END.
     2508        output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2509        put stream OutStr-html unformatted
     2510           substitute (
     2511           '
     2512           </tbody>
     2513           '
     2514               , chr(123), chr(125)
     2515          ).
     2516         output stream OutStr-html close.
     2517   PROCEDURE create-tincome-2 :
     2518     define input parameter p-gds-code  like ub.goods.gds-code   no-undo.
     2519     define input parameter p-doc-code  like ub.trn-doc.doc-code no-undo.
     2520     define input parameter p-qnty1     as   decimal             no-undo.
     2521     define input parameter p-qnty2     as   decimal             no-undo.
     2522     define input parameter p-supp-name as   character           no-undo.
     2523     define input parameter p-supp-code like ub.clients.obj-code no-undo.
     2524     define input parameter p-is-fact   as   logical             no-undo.
     2525     define input parameter p-ii        as   integer             no-undo.
     2526     _main:
     2527     DO ON ERROR UNDO _main, RETURN ERROR :
     2528       CREATE tincome-2.
     2529       assign tincome-2.gds-code    = p-gds-code
     2530              tincome-2.doc-code    = p-doc-code
     2531              tincome-2.qnty1       = p-qnty1
     2532              tincome-2.qnty2       = p-qnty2
     2533              tincome-2.supp-code   = p-supp-code
     2534              tincome-2.supp-name   = p-supp-name
     2535              tincome-2.is-fact     = p-is-fact
     2536              tincome-2.temperature = ?
     2537              tincome-2.ii          = p-ii        no-error.
     2538       IF ERROR-STATUS :ERROR THEN DO: UNDO _main, RETURN ERROR. END.
     2539     END.
     2540   END PROCEDURE.
