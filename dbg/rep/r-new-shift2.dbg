      157   procedure create_obj-list :
      158      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      159      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      160      do
      161      on error undo, return error return-value
      162      :
      163         define buffer cli-obj for ub.clients .
      164         define variable p-var as integer no-undo .
      165         define buffer buf_obj-list for obj-list .
      166         find last buf_obj-list  use-index pi no-error .
      167         if available buf_obj-list
      168         then
      169            p-var = buf_obj-list.obj-id + 1.
      170         else
      171            p-var = 1.
      172         find first cli-obj where
      173                   cli-obj.obj-type = p-obj-type
      174               and cli-obj.obj-code = p-obj-code
      175         no-lock no-error.
      176         if available cli-obj
      177         then do:
      178            create buf_obj-list.
      179            assign
      180               buf_obj-list.obj-id   = p-var
      181               buf_obj-list.obj-code = cli-obj.obj-code
      182               buf_obj-list.obj-type = cli-obj.obj-type
      183               buf_obj-list.obj-name = cli-obj.obj-name
      184               buf_obj-list.db-num   = cli-obj.db-num
      185            .
      186         end.
      187      end.
      188   end.
