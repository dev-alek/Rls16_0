     1810     procedure on-same-page :
     1811       define input parameter p-line-number as integer no-undo .
     1812       if p-line-number > page-size( PrnLibstream )
     1813       then do:
     1814         return .
     1815       end.
     1816       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     1817       then do:
     1818         page stream PrnLibstream .
     1819       end.
     1820     end procedure.
     1821   FUNCTION get-grp-name-code RETURNS INTEGER
     1822     ( INPUT p-cdpay-code AS integer, INPUT p-curr-code AS INTEGER, output p-grp-name as character ) :
     1823   DEFINE VARIABLE v-dopi AS INTEGER NO-UNDO INIT ?.
     1824   DEFINE VARIABLE v-value AS character NO-UNDO.
     1825   DEFINE VARIABLE v-type AS character NO-UNDO.
     1826     RUN cp-attr-value  IN THIS-PROCEDURE(
     1827        input p-cdpay-code
     1828       ,input p-curr-code
     1829       ,input 0
     1830       ,input '':U
     1831       ,input 0
     1832       ,INPUT 'grp-code':U
     1833       ,output v-value
     1834       ,OUTPUT v-type) NO-ERROR.
     1835     IF NOT ERROR-STATUS:ERROR THEN DO:
     1836         ASSIGN
     1837         v-dopi = INTEGER(entry(2, v-value, chr(4)))
     1838         p-grp-name = entry(1, v-value, chr(4) )
     1839         NO-ERROR.
     1840     END.
     1841     RETURN v-dopi.
     1842   END FUNCTION.
     1843   run rep/r-shft2r.p ( input p-obj-type
     1844                       ,input p-obj-code
     1845                       ,input X-date-Start
     1846                       ,input X-Shift-Start
     1847                       ,input X-date-End
     1848                       ,input X-Shift-End
     1849                       ,input p-previous-shift-date
     1850                       ,input p-batch
     1851                       ,input p-codex-id
     1852                       ,input p-ruleset-id
     1853                       ) no-error.
     1854   if error-status:error then do:
     1855     return error substitute("!!!Ошибка при расчете&4&1 &2 &3&4&5&4&6"
     1856                             ,vss-workfile
     1857                             ,vss-revision
     1858                             ,vss-description
     1859                             ,chr(10)
     1860                             , error-status:get-message(1)
     1861                             , return-value ).
     1862   end.
     1863       output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     1864           put stream OutStr-html unformatted
     1865               substitute (
     1866             '<tbody> <!-- Здесь начинается таблица отчета -->                                             
     1867               <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->                                 
     1868                   <th text_wrap="true" colspan="4" style="text-align: center;">Информация о продукте</th>                  
     1869                   <th text_wrap="true" colspan="7" style="text-align: center;">Расшифровка поступления</th>                
     1870                   <th text_wrap="true" colspan="4" style="text-align: center;">Расшифровка реализации</th>                 
     1871                   <th text_wrap="true" rowspan="3" style="text-align: center;">Остаток на конец кг, л</th>                       
     1872               </tr>                                                                                       
     1873               <tr>                                                                                        
     1874                   <th text_wrap="true" rowspan="2" style="text-align: center;">Наименование продукта</th>                  
     1875                   <th text_wrap="true" rowspan="2" style="text-align: center;">Код товара</th>                             
     1876                   <th text_wrap="true" rowspan="2" style="text-align: center;">Цена розничная на конец смены</th>          
     1877                   <th text_wrap="true" rowspan="2" style="text-align: center;">Остаток на начало кг, л</th>                      
     1878                   <th text_wrap="true" colspan="2" style="text-align: center;">Поставщик</th>                              
     1879                   <th text_wrap="true" rowspan="2" style="text-align: center;">Номер документа прихода (ТТН)</th>          
     1880                   <th text_wrap="true" rowspan="2" style="text-align: center;">Количество кг, л</th>
     1881                   <th text_wrap="true" rowspan="2" style="text-align: center;">Плотность кг/м3</th>
     1882                   <th text_wrap="true" rowspan="2" style="text-align: center;">ЕУ кг</th>                                              
     1883                   <th text_wrap="true" rowspan="2" style="text-align: center;">Т в гр.°С</th>         
     1884                   <th text_wrap="true" rowspan="2" style="text-align: center;">Тип расхода (тип платежа)</th>              
     1885                   <th text_wrap="true" rowspan="2" style="text-align: center;">Кол-во в литрах</th>                        
     1886                   <th text_wrap="true" rowspan="2" style="text-align: center;">Кол-во в кг</th>                    
     1887                   <th text_wrap="true" rowspan="2" style="text-align: center;">Сумма</th>                                  
     1888   
     1889               </tr>                                                                                       
     1890               <tr>                                                                                        
     1891                   <th text_wrap="true" style="text-align: center;">Наименование</th>                                       
     1892                   <th style="text-align: center;">Код</th>                                                
     1893               </tr>                                                                                       
     1894               <tr>                                                                                        
     1895                   <th style="text-align: center;">2.1</th>                                                  
     1896                   <th style="text-align: center;">2.2</th>                                                  
     1897                   <th style="text-align: center;">2.3</th>                                                  
     1898                   <th style="text-align: center;">2.4</th>                                                  
     1899                   <th style="text-align: center;">2.5</th>                                                  
     1900                   <th style="text-align: center;">2.6</th>                                                  
     1901                   <th style="text-align: center;">2.7</th>                                                  
     1902                   <th style="text-align: center;">2.8</th>                                                  
     1903                   <th style="text-align: center;">2.9</th>                                                  
     1904                   <th style="text-align: center;">2.10</th>                                                 
     1905                   <th style="text-align: center;">2.11</th>                                                 
     1906                   <th style="text-align: center;">2.12</th>                                                 
     1907                   <th style="text-align: center;">2.13</th>                                                 
     1908                   <th style="text-align: center;">2.14</th>                                                 
     1909                   <th style="text-align: center;">2.15</th>                                                 
     1910                   <th style="text-align: center;">2.16</th>                                                 
     1911               </tr>'
     1912               , chr(123), chr(125)
     1913           ).
     1914   for each actreal-2 :
     1915     delete actreal-2 .
     1916   end.
     1917   FOR EACH t-2 USE-INDEX pi :
     1918     assign areal-is-pay-qnty1 = 0
     1919            areal-is-pay-qnty2 = 0
     1920            areal-is-pay-netto = 0
     1921            areal-no-pay-qnty1 = 0
     1922            areal-no-pay-qnty2 = 0
     1923            areal-no-pay-netto = 0
     1924            areal-qnty1        = 0
     1925            areal-qnty2        = 0
     1926            areal-netto        = 0
     1927            aincome-qnty1      = 0
     1928            aincome-qnty2      = 0
     1929            loc-real-ii        = 1
     1930            loc-grpii          = 0
     1931            loc-grp-only-not-single = 0
     1932            loc-income-ii      = 0
     1933            curr-real-ii       = 1.
     1934     FIND LAST treal-2 NO-LOCK WHERE
     1935               treal-2.gds-code = t-2.gds-code AND
     1936               treal-2.is-pay   = YES          USE-INDEX vi NO-ERROR.
     1937     if available treal-2 then do:
     1938       assign loc-real-ii  = treal-2.ii + 1
     1939              curr-real-ii = treal-2.ii + 1.
     1940     end.
     1941     IF CAN-FIND( FIRST treal-2 WHERE
     1942                        treal-2.gds-code = t-2.gds-code ) THEN DO:
     1943       do v-step = 1 to 2:
     1944         if v-step = 1 then assign v-is-pay = yes.
     1945         if v-step = 2 then assign v-is-pay = no .
     1946         FOR EACH treal-2 WHERE treal-2.is-pay = v-is-pay AND treal-2.gds-code = t-2.gds-code and treal-2.curr-code >= 0 USE-INDEX pi :
     1947           assign
     1948             areal-qnty1 = areal-qnty1 + treal-2.qnty1
     1949             areal-qnty2 = areal-qnty2 + treal-2.qnty2
     1950             areal-netto = areal-netto + treal-2.netto
     1951           .
     1952           if treal-2.is-pay = yes then do:
     1953             assign
     1954             areal-is-pay-qnty1 = areal-is-pay-qnty1 + treal-2.qnty1
     1955             areal-is-pay-qnty2 = areal-is-pay-qnty2 + treal-2.qnty2
     1956             areal-is-pay-netto = areal-is-pay-netto + treal-2.netto.
     1957             if p-with-cp-grouping = yes then do:
     1958               assign
     1959               v-grp-code = ?
     1960               v-grp-code = get-grp-name-code(treal-2.cpay-code, treal-2.curr-code, output v-grp-name)
     1961               v-grp-code = (if v-grp-code = ? then 10000 else v-grp-code)
     1962               v-grp-name = (if v-grp-code = 10000
     1963                             then "(По остальным)"
     1964                             else substitute("(По гр. &1)", string(v-grp-name, "X(9)"))
     1965                             )
     1966               .
     1967               FIND FIRST grptreal-2 WHERE
     1968                           grptreal-2.gds-code = treal-2.gds-code AND
     1969                           grptreal-2.cpay-code = - v-grp-code AND
     1970                           grptreal-2.curr-code = - 1 AND
     1971                           grptreal-2.is-pay = treal-2.is-pay NO-ERROR.
     1972               if not available grptreal-2 then do:
     1973                 run create-treal-2 in this-procedure ( input treal-2.gds-code,
     1974                                                           input - v-grp-code,
     1975                                                           input - 1 ,
     1976                                                           input treal-2.qnty1,
     1977                                                           input treal-2.qnty2,
     1978                                                           input treal-2.netto,
     1979                                                           input  chr(4) + v-grp-name,
     1980                                                           input treal-2.is-pay,
     1981                                                           input loc-real-ii ) no-error.
     1982                 assign
     1983                 curr-real-ii = curr-real-ii + 1
     1984                 loc-grp-only-not-single = loc-grp-only-not-single + 1
     1985                 loc-real-ii = loc-real-ii + 1
     1986                 loc-grpii       = loc-grpii + 1
     1987                 .
     1988               end.
     1989               else do:
     1990                 assign
     1991                 loc-grp-only-not-single = (if grptreal-2.out-name  begins chr(4)
     1992                                        then (loc-grp-only-not-single - 1)
     1993                                        else loc-grp-only-not-single)
     1994                 grptreal-2.out-name = v-grp-name
     1995                 grptreal-2.qnty1 = grptreal-2.qnty1 + treal-2.qnty1
     1996                 grptreal-2.qnty2 = grptreal-2.qnty2 + treal-2.qnty2
     1997                 grptreal-2.netto = grptreal-2.netto + treal-2.netto
     1998                 .
     1999               end.
     2000             end.
     2001           end.
     2002           else do:
     2003             assign
     2004                   rc            = recid( treal-2 )
     2005             curr-real-ii         = ( if (curr-real-ii = loc-real-ii)
     2006                                      AND
     2007                                       ( (loc-real-ii - loc-grp-only-not-single) > 1
     2008                                       OR
     2009                                       can-find( first treal-2 no-lock where
     2010                                                       treal-2.gds-code =  t-2.gds-code and
     2011                                                       treal-2.is-pay   =  no           and
     2012                                                       recid( treal-2 ) <> rc ) )
     2013                                     then ( curr-real-ii + 1 )
     2014                                     else   curr-real-ii )
     2015             treal-2.ii           = curr-real-ii
     2016             curr-real-ii         = curr-real-ii + 1.
     2017             if treal-2.cpay-code <> -4 then do:
     2018               assign areal-no-pay-qnty1 = areal-no-pay-qnty1 + treal-2.qnty1
     2019                     areal-no-pay-qnty2 = areal-no-pay-qnty2 + treal-2.qnty2
     2020                     areal-no-pay-netto = areal-no-pay-netto + treal-2.netto.
     2021             end.
     2022           end.
     2023         end.
     2024       END.
     2025       if curr-real-ii - loc-grp-only-not-single > 2 then do:
     2026         run create-treal-2 in this-procedure ( input t-2.gds-code,
     2027                                                input 0,
     2028                                                input 0,
     2029                                                input areal-is-pay-qnty1,
     2030                                                input areal-is-pay-qnty2,
     2031                                                input areal-is-pay-netto,
     2032                                                input "ИТОГО ОПЛАЧ.РАСХОД",
     2033                                                input yes,
     2034                                                input loc-real-ii           ) no-error.
     2035         if loc-real-ii = curr-real-ii then do:
     2036           assign curr-real-ii = curr-real-ii + 1.
     2037         end.
     2038         run create-treal-2 in this-procedure ( input t-2.gds-code,
     2039                                                input 0,
     2040                                                input 0,
     2041                                                input areal-no-pay-qnty1,
     2042                                                input areal-no-pay-qnty2,
     2043                                                input areal-no-pay-netto,
     2044                                                input "ИТОГО ПРОЧ.РАСХОД",
     2045                                                input no,
     2046                                                input curr-real-ii         ) no-error.
     2047         assign curr-real-ii = curr-real-ii + 1.
     2048         run create-treal-2 in this-procedure ( input t-2.gds-code,
     2049                                                input 0,
     2050                                                input 0,
     2051                                                input areal-qnty1,
     2052                                                input areal-qnty2,
     2053                                                input areal-netto,
     2054                                                input "ВСЕГО РАСХОД ",
     2055                                                input ?,
     2056                                                input curr-real-ii     ) no-error.
     2057       end.
     2058     END.
     2059     FOR EACH tincome-2 WHERE
     2060              tincome-2.gds-code = t-2.gds-code
     2061              USE-INDEX vi
     2062              :
     2063       if tincome-2.supp-name = "Итого по поставщику" then do:
     2064         assign loc-income-ii = tincome-2.ii .
     2065         next.
     2066       end.
     2067       assign aincome-qnty1 = aincome-qnty1 + tincome-2.qnty1
     2068              aincome-qnty2 = aincome-qnty2 + tincome-2.qnty2
     2069              loc-income-ii = tincome-2.ii
     2070              .
     2071     END.
     2072     if loc-income-ii > 1 then do:
     2073       run create-tincome-2 in this-procedure ( input t-2.gds-code,
     2074                                                input "",
     2075                                                input aincome-qnty1,
     2076                                                input aincome-qnty2,
     2077                                                input "ИТОГО ПОСТУПЛЕНИЙ",
     2078                                                input 0,
     2079                                                input no,
     2080                                                input ( loc-income-ii + 1 ) ) no-error.
     2081       assign loc-income-ii = loc-income-ii + 1.
     2082     end.
     2083     assign t-2.lines = MAX( curr-real-ii - loc-grp-only-not-single
     2084                           , loc-income-ii, 1 ).
     2085   END.
     2086   FOR EACH t-2 NO-LOCK
     2087       BREAK
     2088         BY t-2.main-code :
     2089     v-delta = 0.
     2090     DO jj = 1 TO t-2.lines :
     2091       assign pol1      = "":U
     2092              pol2      = 0
     2093              pol3      = 0
     2094              pol4      = 0
     2095              pol5      = 0
     2096              pol6      = "":U
     2097              pol7      = 0
     2098              pol8      = "":U
     2099              pol9      = 0
     2100              pol10     = 0
     2101              pol11     = 0
     2102              pol12     = ?
     2103              pol13     = "":U
     2104              pol14     = 0
     2105              pol15     = 0
     2106              pol16     = 0
     2107              pol17     = 0
     2108              pol18     = 0
     2109              main-line = no
     2110              supp-line = no
     2111              pay-line  = no.
     2112       IF jj = 1 then do:
     2113         assign pol1      = t-2.gds-name
     2114                pol2      = t-2.main-code
     2115                pol3      = t-2.last-price
     2116                pol4      = t-2.qnty1-before
     2117                pol5      = t-2.qnty2-before
     2118                pol17     = t-2.qnty1-after
     2119                pol18     = t-2.qnty2-after
     2120                main-line = yes.
     2121         if p-batch > 0
     2122         then do:
     2123           find first buf_shift-pgds where
     2124                   buf_shift-pgds.obj-type = p-obj-type
     2125               and buf_shift-pgds.obj-code = p-obj-code
     2126               and buf_shift-pgds.shift-date = X-date-end
     2127               and buf_shift-pgds.shift-num = X-shift-end
     2128               and buf_shift-pgds.gds-code = t-2.gds-code no-error.
     2129           if available buf_shift-pgds then do:
     2130             assign
     2131             buf_shift-pgds.end-price-sale = t-2.last-price
     2132             .
     2133             release buf_shift-pgds.
     2134           end.
     2135         end.
     2136       END.
     2137       FIND FIRST tincome-2 NO-LOCK WHERE
     2138                  tincome-2.gds-code = t-2.gds-code AND
     2139                  tincome-2.ii       = jj           NO-ERROR.
     2140       IF AVAIlABLE tincome-2 THEN DO:
     2141         assign
     2142             pol8 = tincome-2.doc-code
     2143         .
     2144         ASSIGN pol6      = tincome-2.supp-name
     2145                pol7      = tincome-2.supp-code
     2146                pol9      = tincome-2.qnty1
     2147                pol10     = tincome-2.density
     2148                pol9_1    = tincome-2.naturalloss
     2149                pol11     = tincome-2.qnty2
     2150                pol12     = tincome-2.temperature
     2151                supp-line = yes.
     2152        if p-batch > 0
     2153        and tincome-2.supp-code > 0
     2154        and tincome-2.gds-code > 0
     2155        then do:
     2156         find first buf_shift-pgds-in where
     2157                   buf_shift-pgds-in.obj-type = p-obj-type
     2158               and buf_shift-pgds-in.obj-code = p-obj-code
     2159               and buf_shift-pgds-in.shift-date = X-date-end
     2160               and buf_shift-pgds-in.shift-num = X-shift-end
     2161               and buf_shift-pgds-in.gds-code = t-2.gds-code
     2162               and buf_shift-pgds-in.doc-code = tincome-2.doc-code no-error.
     2163           if not available buf_shift-pgds-in then do:
     2164             create buf_shift-pgds-in.
     2165             assign
     2166             buf_shift-pgds-in.obj-type = p-obj-type
     2167             buf_shift-pgds-in.obj-code = p-obj-code
     2168             buf_shift-pgds-in.shift-date = X-date-end
     2169             buf_shift-pgds-in.shift-num = X-shift-end
     2170             buf_shift-pgds-in.gds-code = t-2.gds-code
     2171             buf_shift-pgds-in.doc-code = tincome-2.doc-code
     2172             buf_shift-pgds-in.cli-type-code = substitute("&1&2", tincome-2.supp-type, tincome-2.supp-code)
     2173             buf_shift-pgds-in.cli-name = tincome-2.supp-name
     2174             buf_shift-pgds-in.fact-qnty = tincome-2.qnty1
     2175             buf_shift-pgds-in.fact-qnty-2 = tincome-2.qnty2
     2176             .
     2177             release buf_shift-pgds-in.
     2178           end.
     2179         end.
     2180       END.
     2181      _not-empty-group:
     2182       do while true :
     2183         FIND FIRST treal-2 NO-LOCK WHERE
     2184                   treal-2.gds-code = t-2.gds-code AND
     2185                   treal-2.ii       = jj + v-delta          NO-ERROR.
     2186         if not available treal-2 then do:
     2187           put stream OutStr-html unformatted
     2188               '<tr>' skip
     2189                       '<td text_wrap="true" rowspan="2">' + pol1 + '</td>' skip
     2190                       '<td text_wrap="true" rowspan="2" style="text-align: right;">' + if main-line <> no or string(pol2) <> ? then string(pol2) + '</td>' else "" + '</td>' skip
     2191                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol3,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + if main-line <> no or string(pol3) <> ? then fnc-convert-dot-to-colon(pol3,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2192                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol4,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if main-line <> no or string(pol4) <> ? then fnc-convert-dot-to-colon(pol4,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2193                       '<td text_wrap="true" rowspan="2">' + if supp-line <> no or pol6 <> ? then pol6 + '</td>' else "" + '</td>' skip
     2194                       '<td text_wrap="true" rowspan="2" style="text-align: right;">' + if pol7 <> 0 then string(pol7) + '</td>' else "" + '</td>' skip
     2195                       '<td text_wrap="true" rowspan="2">' + if pol8 <> "" then string(pol8) + '</td>' else "" + '</td>' skip
     2196                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol9,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if supp-line <> no or string(pol9) <> ? then fnc-convert-dot-to-colon(pol9,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2197                       '<td text_wrap="true" num="0.0000" val="' + fnc-convert-dot-to-colon(pol10,"->>>>>>>>>>>9.9999",4) + '" rowspan="2" style="text-align: right;">' + if supp-line <> no or string(pol10) <> ? then fnc-convert-dot-to-colon(pol10,"->>>>>>>>>>>9.9999",4) + '</td>' else "" + '</td>' skip
     2198                       '<td text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(pol9_1,"->>>>>>>>>>>9.999",3) + '" rowspan="2" style="text-align: right;">' + if supp-line <> no or string(pol9_1) <> ? then fnc-convert-dot-to-colon(pol9_1,"->>>>>>>>>>>9.999",3) + '</td>' else "" + '</td>' skip
     2199                       '<td text_wrap="true" num="0" val="' + fnc-convert-dot-to-colon(pol12,"->>>>>>>>>>>9",0) + '" rowspan="2" style="text-align: right;">' + if supp-line <> no or string(pol12) <> ? then fnc-convert-dot-to-colon(pol12,"->>>>>>>>>>>9",0) + '</td>' else "" + '</td>' skip
     2200                       '<td text_wrap="true" rowspan="2">' + if pay-line <> no or pol13 <> "" then pol13 + '</td>' else "" + '</td>' skip
     2201                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol14,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + if pay-line <> no or string(pol14) <> ? then fnc-convert-dot-to-colon(pol14,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2202                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol15,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + if pay-line <> no or string(pol15) <> ? then fnc-convert-dot-to-colon(pol15,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2203                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol16,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + if pay-line <> no or string(pol16) <> ? then fnc-convert-dot-to-colon(pol16,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2204                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol17,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if main-line <> no or string(pol17) <> ? then fnc-convert-dot-to-colon(pol17,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2205                '</tr>'
     2206               '<tr>' skip
     2207                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol5,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if main-line <> no or string(pol5) <> ? then fnc-convert-dot-to-colon(pol5,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2208                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol11,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if supp-line <> no or string(pol11) <> ? then fnc-convert-dot-to-colon(pol11,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2209                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol18,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if main-line <> no or string(pol18) <> ? then fnc-convert-dot-to-colon(pol18,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2210                '</tr>' skip
     2211                .
     2212             leave _not-empty-group.
     2213         end.
     2214         if available treal-2 then do:
     2215           if treal-2.cpay-code <> 0
     2216           or treal-2.curr-code= - 1
     2217           then do:
     2218             FIND FIRST actreal-2 WHERE
     2219                       actreal-2.gds-code = 0 AND
     2220                       actreal-2.cpay-code = treal-2.cpay-code AND
     2221                       actreal-2.curr-code = treal-2.curr-code AND
     2222                       actreal-2.is-pay = treal-2.is-pay NO-ERROR.
     2223             if not available actreal-2 then do:
     2224               assign acii = acii + 1.
     2225               run create-actreal-2 in this-procedure ( input 0,
     2226                                                       input treal-2.cpay-code,
     2227                                                       input treal-2.curr-code,
     2228                                                       input treal-2.qnty1,
     2229                                                       input treal-2.qnty2,
     2230                                                       input treal-2.netto,
     2231                                                       input trim(treal-2.out-name, chr(4)),
     2232                                                       input treal-2.is-pay,
     2233                                                       input acii               ) no-error.
     2234             end.
     2235             else do:
     2236               assign actreal-2.qnty1 = actreal-2.qnty1 + treal-2.qnty1
     2237                     actreal-2.qnty2 = actreal-2.qnty2 + treal-2.qnty2
     2238                     actreal-2.netto = actreal-2.netto + treal-2.netto.
     2239             end.
     2240           end.
     2241           if treal-2.is-pay = yes
     2242           and treal-2.curr-code < 0
     2243           and treal-2.out-name begins chr(4) then do:
     2244             assign
     2245             v-delta = v-delta + 1
     2246             .
     2247             next _not-empty-group.
     2248           end.
     2249           else do:
     2250             assign
     2251             pol13    = treal-2.out-name
     2252             pol14    = treal-2.qnty1
     2253             pol15    = treal-2.qnty2
     2254             pol16    = treal-2.netto
     2255             pay-line = yes
     2256             .
     2257             if p-batch > 0
     2258             and (treal-2.curr-code > 0
     2259             or not (treal-2.curr-code = 0 and treal-2.cpay-code = 0)
     2260             )
     2261             and treal-2.gds-code > 0
     2262             then do:
     2263               find first buf_shift-pgds-out where
     2264                     buf_shift-pgds-out.obj-type = p-obj-type
     2265                 and buf_shift-pgds-out.obj-code = p-obj-code
     2266                 and buf_shift-pgds-out.shift-date = X-date-end
     2267                 and buf_shift-pgds-out.shift-num = X-shift-end
     2268                 and buf_shift-pgds-out.gds-code = treal-2.gds-code
     2269                 and buf_shift-pgds-out.pay-code = treal-2.cpay-code
     2270                 and buf_shift-pgds-out.curr-code = treal-2.curr-code
     2271                 no-error.
     2272               if not available buf_shift-pgds-out then do:
     2273                 find first buf_cash-pay no-lock where
     2274                           buf_cash-pay.cdpay-code = treal-2.cpay-code
     2275                     and  buf_cash-pay.curr-code = treal-2.curr-code no-error.
     2276                 create buf_shift-pgds-out.
     2277                 assign
     2278                 buf_shift-pgds-out.obj-type = p-obj-type
     2279                 buf_shift-pgds-out.obj-code = p-obj-code
     2280                 buf_shift-pgds-out.shift-date = X-date-end
     2281                 buf_shift-pgds-out.shift-num = X-shift-end
     2282                 buf_shift-pgds-out.gds-code = treal-2.gds-code
     2283                 buf_shift-pgds-out.pay-code = treal-2.cpay-code
     2284                 buf_shift-pgds-out.curr-code = treal-2.curr-code
     2285                 buf_shift-pgds-out.out-name = treal-2.out-name
     2286                 buf_shift-pgds-out.cp-type = (if available buf_cash-pay
     2287                                               and buf_cash-pay.is-cash
     2288                                               then 1
     2289                                               else 2)
     2290                 buf_shift-pgds-out.fact-qnty = treal-2.qnty1
     2291                 buf_shift-pgds-out.fact-qnty-2 = treal-2.qnty2
     2292                 buf_shift-pgds-out.fact-sum = treal-2.netto
     2293                 .
     2294                 .
     2295               end.
     2296             end.
     2297           put stream OutStr-html unformatted
     2298                '<tr>' skip
     2299                       '<td text_wrap="true" rowspan="2">' + pol1 + '</td>' skip
     2300                       '<td text_wrap="true" rowspan="2" style="text-align: right;">' + if main-line <> no or string(pol2) <> ? then string(pol2) + '</td>' else "" + '</td>' skip
     2301                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol3,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + if main-line <> no or string(pol3) <> ? then fnc-convert-dot-to-colon(pol3,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2302                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol4,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if main-line <> no or string(pol4) <> ? then fnc-convert-dot-to-colon(pol4,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2303                       '<td text_wrap="true" rowspan="2">' + if supp-line <> no or pol6 <> ? then pol6 + '</td>' else "" + '</td>' skip
     2304                       '<td text_wrap="true" rowspan="2" style="text-align: right;">' + if pol7 <> 0 then string(pol7) + '</td>' else "" + '</td>' skip
     2305                       '<td text_wrap="true" rowspan="2">' + if pol8 <> "" then string(pol8) + '</td>' else "" + '</td>' skip
     2306                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol9,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if supp-line <> no or string(pol9) <> ? then fnc-convert-dot-to-colon(pol9,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2307                       '<td text_wrap="true" num="0.0000" val="' + fnc-convert-dot-to-colon(pol10,"->>>>>>>>>>>9.9999",4) + '" rowspan="2" style="text-align: right;">' + if supp-line <> no or string(pol10) <> ? then fnc-convert-dot-to-colon(pol10,"->>>>>>>>>>>9.9999",4) + '</td>' else "" + '</td>' skip
     2308                       '<td text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(pol9_1,"->>>>>>>>>>>9.999",3) + '" rowspan="2" style="text-align: right;">' + if supp-line <> no or string(pol9_1) <> ? then fnc-convert-dot-to-colon(pol9_1,"->>>>>>>>>>>9.999",3) + '</td>' else "" + '</td>' skip
     2309                       '<td text_wrap="true" num="0" val="' + fnc-convert-dot-to-colon(pol12,"->>>>>>>>>>>9",0) + '" rowspan="2" style="text-align: right;">' + if supp-line <> no or string(pol12) <> ? then fnc-convert-dot-to-colon(pol12,"->>>>>>>>>>>9",0) + '</td>' else "" + '</td>' skip
     2310                       '<td text_wrap="true" rowspan="2">' + if pay-line <> no or pol13 <> "" then pol13 + '</td>' else "" + '</td>' skip
     2311                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol14,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + if pay-line <> no or string(pol14) <> ? then fnc-convert-dot-to-colon(pol14,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2312                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol15,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + if pay-line <> no or string(pol15) <> ? then fnc-convert-dot-to-colon(pol15,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2313                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol16,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + if pay-line <> no or string(pol16) <> ? then fnc-convert-dot-to-colon(pol16,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2314                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol17,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if main-line <> no or string(pol17) <> ? then fnc-convert-dot-to-colon(pol17,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2315                '</tr>'
     2316               '<tr>' skip
     2317                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol5,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if main-line <> no or string(pol5) <> ? then fnc-convert-dot-to-colon(pol5,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2318                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol11,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if supp-line <> no or string(pol11) <> ? then fnc-convert-dot-to-colon(pol11,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2319                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol18,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + if main-line <> no or string(pol18) <> ? then fnc-convert-dot-to-colon(pol18,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     2320                '</tr>' skip
     2321                .
     2322             leave _not-empty-group.
     2323           end.
     2324         end.
     2325       end.
     2326       if jj <= t-2.lines then
     2327         if main-line = yes then do:
     2328           assign accum-4  = accum-4  + pol4
     2329                  accum-5  = accum-5  + pol5
     2330                  accum-17 = accum-17 + pol17
     2331                  accum-18 = accum-18 + pol18.
     2332         end.
     2333         if supp-line = yes then do:
     2334           if tincome-2.is-fact = yes then do:
     2335             assign accum-9  = accum-9  + pol9
     2336                    accum-11 = accum-11 + pol11.
     2337           end.
     2338         end.
     2339         if pay-line = yes then do:
     2340             if treal-2.cpay-code <> 0
     2341             and treal-2.curr-code <>  - 1
     2342             then do:
