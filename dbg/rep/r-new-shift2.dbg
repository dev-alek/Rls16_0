     1551   define  stream PrnLibStream.
     1552   procedure prn-lib-prn-file :
     1553     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1554     define input parameter p-DIsabledoptions as integer no-undo .
     1555     define variable v-report-name as character no-undo .
     1556     define variable v-user-action as character no-undo .
     1557     define variable v-printed     as logical   no-undo .
     1558     define variable v-exist       as logical   no-undo .
     1559     do
     1560       on error undo, return error
     1561       :
     1562       run prn-lib-get-report-name  in this-procedure (
     1563         input parParentProc
     1564         ,output v-report-name
     1565         ).
     1566   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1568     (input  v-report-name
     1569     ,input  2
     1570     ,output v-exist
     1571     )  .
     1572       if NOT v-exist then
     1573       DO:
     1574         Message
     1575           "Нет заданий на печать ! "
     1576           view-as alert-box .
     1577         Return  .
     1578       End.
     1579       run gbl/prnfilen.w
     1580         (input  ""
     1581         ,input  p-DisabledOptions
     1582         ,input  string(v-report-name )
     1583         ,input  7
     1584         ,output v-user-action
     1585         ,output v-printed
     1586         ) .
     1587       if v-printed then
     1588       do:
     1589         return "YES" .
     1590       end.
     1591       else
     1592       do:
     1593         return "NO" .
     1594       end.
     1595     end.
     1596   end procedure.
     1597   procedure prn-lib-open-stream :
     1598     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1599     define input parameter p-page-size    as integer no-undo .
     1600     define input parameter p-is-stream    as logical no-undo .
     1601     define input parameter p-append       as logical no-undo .
     1602     define variable v-report-name as character no-undo .
     1603     do
     1604       on error undo, return error
     1605       :
     1606       run prn-lib-get-report-name  in this-procedure (
     1607         input parParentProc
     1608         ,output v-report-name
     1609         ).
     1610       if p-is-stream then
     1611       do:
     1612         if p-append then
     1613         do:
     1614           output stream PrnLibStream to value( v-report-name )
     1615             page-size value(p-page-size) append .
     1616         end.
     1617         if not p-append then
     1618         do:
     1619           output stream PrnLibStream to value( v-report-name )
     1620             page-size value(p-page-size) .
     1621         end.
     1622       end.
     1623       if not p-is-stream then
     1624       do:
     1625         if p-append then
     1626         do:
     1627           output to value( v-report-name )
     1628             page-size value(p-page-size) append .
     1629         end.
     1630         if not p-append then
     1631         do:
     1632           output to value( v-report-name )
     1633             page-size value(p-page-size) .
     1634         end.
     1635       end.
     1636     end.
     1637   end procedure.
     1638   procedure prn-lib-open-exp :
     1639     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1640     define input parameter p-is-stream    as logical no-undo .
     1641     define input parameter p-is-append    as logical no-undo .
     1642     define output parameter p-ReportFileName as char init "report" no-undo.
     1643     define output parameter p-process as logical no-undo .
     1644     define variable glog as logical no-undo .
     1645     do
     1646       on error undo, return error
     1647       :
     1648       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1649         TITLE      "Укажите путь"
     1650         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1651         ASK-OVERWRITE
     1652         CREATE-TEST-FILE
     1653         SAVE-AS
     1654         USE-FILENAME
     1655         DEFAULT-EXTENSION "txt"
     1656         UPDATE glog
     1657         .
     1658       if not glog then  return.
     1659       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1660       if p-is-stream then
     1661       do:
     1662         if p-is-append then
     1663         do:
     1664           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1665         end.
     1666         else
     1667         do:
     1668           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1669         end.
     1670       end.
     1671       else
     1672       do:
     1673         if p-is-append then
     1674         do:
     1675           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1676         end.
     1677         else
     1678         do:
     1679           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1680         end.
     1681       end.
     1682       p-process = yes.
     1683     end.
     1684   end procedure.
     1685   procedure prn-lib-get-report-name :
     1686     define input parameter parParentProc  as widget-handle no-undo.
     1687     define output parameter p-report-name as character no-undo .
     1688     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1689   end procedure.
     1690   procedure prn-lib-reportviewer-report-name :
     1691     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1692     define input parameter p-report-name-html as character no-undo .
     1693     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1694   end procedure.
     1695   procedure prn-lib-reportviewer :
     1696     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1697     define input parameter p-report-name-html as character no-undo .
     1698     define input parameter p-param        as character no-undo .
     1699     define variable v-excel           as character no-undo init 'TRUE' .
     1700     define variable v-value-character as character no-undo .
     1701     define variable v-value-integer   as character no-undo .
     1702     define variable v-value-date      as date      no-undo .
     1703     define variable v-value-decimal   as decimal   no-undo .
     1704     define variable rep-excel         as logical   no-undo .
     1705     define variable excel-string      as character no-undo .
     1706     define variable v-param-type      as character no-undo .
     1707     define variable v-tth             as handle    no-undo .
     1708     run adm/shattri.p (
     1709       input "get":U
     1710       ,input  ""
     1711       ,input  0
     1712       ,input  'report-glob':U
     1713       ,input  'rep-excel':U
     1714       ,output v-value-character
     1715       ,output v-value-date
     1716       ,output v-value-decimal
     1717       ,output v-value-integer
     1718       ,output rep-excel
     1719       ,output v-param-type
     1720       ,INPUT-OUTPUT table-handle v-tth
     1721       )  .
     1722     if rep-excel then v-excel = "TRUE" .
     1723     else v-excel = "FALSE" .
     1724     if p-param eq ""
     1725     then
     1726        p-param = "EXCEL:" + v-excel.
     1727     else
     1728        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1729     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1730   end procedure.
     1731   function fnc-convert-dot-to-colon returns character
     1732       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1733   function fnc-convert-dot-to-colon returns character
     1734   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1735       define variable result as character no-undo.
     1736       define variable v-str-result as character no-undo.
     1737       if p-data = ? then p-data = 0 .
     1738       p-data = round(p-data, p-num).
     1739       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1740       return v-str-result.
     1741   END FUNCTION.
