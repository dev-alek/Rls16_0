     2356              pol14 = accum-14
     2357              pol15 = accum-15
     2358              pol16 = accum-16
     2359              pol17 = accum-17
     2360              pol18 = accum-18.
     2361           put stream OutStr-html unformatted
     2362               '<tr>' skip
     2363                       '<td text_wrap="true" rowspan="2">' + pol1 + '</td>' skip
     2364                       '<td text_wrap="true" rowspan="2" style="text-align: right;"></td>' skip
     2365                       '<td text_wrap="true" rowspan="2" style="text-align: right;"></td>' skip
     2366                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol4,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(pol4,"->>>>>>>>>>>9.99",2) + '</td>' skip
     2367                       '<td text_wrap="true" rowspan="2"></td>' skip
     2368                       '<td text_wrap="true" rowspan="2" style="text-align: right;"></td>' skip
     2369                       '<td text_wrap="true" rowspan="2"></td>' skip
     2370                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol9,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(pol9,"->>>>>>>>>>>9.99",2) + '</td>' skip
     2371                       '<td text_wrap="true" rowspan="2"></td>' skip
     2372                       '<td text_wrap="true" rowspan="2"></td>' skip
     2373                       '<td text_wrap="true" rowspan="2"></td>' skip
     2374                       '<td text_wrap="true" rowspan="2">' + pol13 + '</td>' skip
     2375                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol14,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + fnc-convert-dot-to-colon(pol14,"->>>>>>>>>>>9.99",2) + '</td>' skip
     2376                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol15,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + fnc-convert-dot-to-colon(pol15,"->>>>>>>>>>>9.99",2) + '</td>' skip
     2377                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol16,"->>>>>>>>>>>9.99",2) + '" rowspan="2" style="text-align: right;">' + fnc-convert-dot-to-colon(pol16,"->>>>>>>>>>>9.99",2) + '</td>' skip
     2378                       '<td text_wrap="true" rowspan="2"></td>' skip
     2379                '</tr>'
     2380               '<tr>' skip
     2381                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol5,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(pol5,"->>>>>>>>>>>9.99",2) + '</td>' skip
     2382                       '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(pol11,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(pol11,"->>>>>>>>>>>9.99",2) + '</td>' skip
     2383                '</tr>' skip
     2384                .
     2385       if can-find( first actreal-2 no-lock ) then do:
     2386         assign pol13 = "     в том числе:".
     2387           put stream OutStr-html unformatted
     2388               substitute (
     2389               '  <tr>
     2390                       <th></th>
     2391                       <th></th>
     2392                       <th></th>
     2393                       <th></th>
     2394                       <th></th>
     2395                       <th></th>
