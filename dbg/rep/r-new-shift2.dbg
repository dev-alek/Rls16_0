     2425                    areal-is-pay-qnty2 = areal-is-pay-qnty2 + actreal-2.qnty2
     2426                    areal-is-pay-netto = areal-is-pay-netto + actreal-2.netto.
     2427           end.
     2428           else do:
     2429             assign areal-no-pay-qnty1 = areal-no-pay-qnty1 + actreal-2.qnty1
     2430                    areal-no-pay-qnty2 = areal-no-pay-qnty2 + actreal-2.qnty2
     2431                    areal-no-pay-netto = areal-no-pay-netto + actreal-2.netto .
     2432           end.
     2433           assign pol13 = actreal-2.out-name
     2434                  pol14 = actreal-2.qnty1
     2435                  pol15 = actreal-2.qnty2
     2436                  pol16 = actreal-2.netto.
