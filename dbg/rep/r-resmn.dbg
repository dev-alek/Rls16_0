      794   define variable var-report-r-b as character no-undo .
      795   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      796   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      797     (output var-report-r-b
      798     )  .
      799   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   function breakstr returns character ( input        for-name    as character,
      801                                         input        line-length as integer,
      802                                         input-output line1       as character,
      803                                         input-output line2       as character ) :
      804     define variable ii as integer no-undo.
      805     if length( for-name ) > line-length then do:
      806       assign ii    = 1
      807              line1 = "":u
      808              line2 = "":u.
      809       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      810         assign line1 =       substring( for-name, 1, line-length     )
      811                line2 = trim( substring( for-name,    line-length + 1 ) ).
      812       end.                                                     else do:
      813         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      814           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      815                  ii    = ii    + 1.
      816           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      817             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      818           end.
      819         end.
      820         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      821       end.
      822     end.                                else do:
      823       assign line1 = for-name
      824              line2 = "":u.
      825     end.
      826     return ( line1 ).
      827   end function.
      828       def var t-addres        like ub.firm.addres1   no-undo.
      829       def var t-phone         like ub.firm.phone     no-undo.
      830       def var t-inn           like ub.firm.inn       no-undo.
      831       def var t-okpo          like ub.firm.okpo      no-undo.
      832       def var t-temp-address  like ub.firm.addres1   no-undo.
      833    do
      834    on error undo, return error return-value
      835    :
      836   define input parameter p-mainmenu-handle    as handle           no-undo.
      837   define input parameter v-doc-rec  as recid no-undo .
      838     define  variable sort-name   as logical no-undo.
      839     define  variable sort-gr     as logical no-undo.
      840     define  variable print-graft as logical no-undo.
      841     define  variable CostPrice   as logical no-undo .
      842     define  variable PrintScale  as logical no-undo .
      843   sort-gr    = yes .
      844   sort-name  = no  .
      845     define variable sort-group as logical   no-undo .
      846     if sort-gr                  then assign sort-group = yes .
      847     else                             assign sort-group = no .
      848     DEFINE temp-table temp-str no-undo
      849       field   np                as integer
      850       field   grp-name          as  char
      851       field   gds-name          as  char
      852       field   b-code            as character
      853       field   norma             as decimal
      854       field   num-rcp           as char
      855       field   p-inp             as decimal
      856       field   qnty              as decimal
      857       field   price             as decimal
      858       field   stoim             as decimal
      859     .
      860   define stream  OutStream  .
      861     def buffer buf_clients for  clients .
      862     def buffer This_Object for  clients .
      863     def buffer buf_goods        for goods .
      864     define variable qnty as decimal   no-undo .
      865     define variable sum  as decimal   no-undo .
      866     define variable num-ln as integer   no-undo .
      867     def var FullNameGds as character no-undo .
      868     def var gds-str as char no-undo.
      869     def var gds-str1 as char no-undo.
      870     def var gds-str2 as char no-undo.
      871     def var i as int no-undo.
      872     def var j as int no-undo.
      873     define variable Counter1 as integer init 0  no-undo .
      874     def var LineBuf       as char    no-undo.
      875     def var Line       as char    no-undo.
      876     def var UndLine    as char    no-undo.
      877     def var     Lines_Counter as   int  init 0  no-undo.
      878     def var     Tmp_Counter   as   int  init 0  no-undo.
      879     def var     tdoc-date     like fbr-pln.doc-date no-undo.
      880     def var     tdoc-code     like fbr-pln.doc-code no-undo.
      881     def var  abbr              as  char no-undo.
      882     def var  pp                as  char no-undo.
      883     def var sym1 as char  init ":"   no-undo.
      884     def var sym2 as char  init ":"   no-undo.
      885     def var sym3 as char  init ":"   no-undo.
      886     def var sym4 as char  init ":"   no-undo.
      887     define variable g#report-num    as integer      no-undo.
      888     define variable g#quest-print   as logical      no-undo.
      889     define variable g#log           as logical      no-undo.
      890     DEFINE FRAME plan-menu
      891           sym1 column-label ":"  format "X(1)" space(0)
      892           temp-str.b-code COLUMN-LABEL "Код":C9 format "X(9)" space(0)
      893           sym2 column-label ":"  format "X(1)" space(0)
      894           temp-str.gds-name COLUMN-LABEL " Наименование блюда":C40     format "X(40)" space(0)
      895           Sym3 column-label ":" format "X(1)" space(0)
      896           temp-str.Price COLUMN-LABEL "Цена":C13 format "->>>>>9.99" space(0)
      897           Sym4 column-label ":" format "X(1)" space(0)
      898          HEADER
      899           string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 70 format "X(13)" SKIP
      900           Line format "X(66)" AT 1
      901           with width 232 down stream-io use-text NO-BOX.
      902     run get-report-num in p-mainmenu-handle (
      903         output g#report-num
      904     ).
      905     run get-quest-print in p-mainmenu-handle (
      906         output g#quest-print
      907     ).
      908     if session:set-wait-state("compiler") then.
      909   output STREAM OutStream to value( string( session:temp-directory +
      910                                        "rpt" + string( g#report-num ) ) )
      911                                        page-size  value(62) .
      912     define variable v-prn0 as character no-undo .
      913     assign
      914       Line    = fill("-", 230)
      915       UndLine = fill("_", 230)
      916       LineBuf = fill("_", 240)
      917     .
      918     IF var-report-r-b = "rubl" THEN Assign PP = "Цены руб.".
      919                          Else Assign PP = "Цены  баз.вал." .
      920   define variable v-account as integer init 0 no-undo .
      921   define variable v-account-lavel as character no-undo .
      922   define variable v-button-stop as logical no-undo .
      923   define variable v-kol-spice as integer no-undo .
      924   define variable v-kol-spice2 as integer no-undo .
      925   define variable v-kol-spice3 as integer no-undo .
      926   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      927   DEFINE BUTTON StopBtn AUTO-END-KEY
      928        LABEL "Стоп"
      929        SIZE 10 BY 1.
      930   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      931        LABEL "Обработано записей"
      932         VIEW-AS TEXT
      933        SIZE 14 BY .67 NO-UNDO.
      934   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      935         VIEW-AS TEXT
      936        SIZE 53.25 BY .67
      937        FGCOLOR 1  NO-UNDO.
      938   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      939         VIEW-AS TEXT
      940        SIZE 53.25 BY .67
      941        FGCOLOR 1  NO-UNDO.
      942   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      943         VIEW-AS TEXT
      944        SIZE 53.25 BY .67
      945        FGCOLOR 1  NO-UNDO.
      946   DEFINE RECTANGLE RECT-1
      947        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      948        SIZE 55.13 BY 4.46.
      949   DEFINE FRAME InfoFrame
      950        StopBtn AT ROW 4.25 COL 21.75
      951        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      952        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      953        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      954        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      955        RECT-1 AT ROW 1 COL 1
      956       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      957            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      958            TITLE "Процесс"
      959            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      960   define variable mFrameView      as logical   no-undo init yes.
      961     define variable mFramHandle as handle no-undo.
      962     mFramHandle = frame InfoFrame:handle.
      963     if  log-manager:logfile-name ne ?
      964     then DO:
      965         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      966         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      967         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      968     end.
      969     mFrameView = not session:batch-mode and mFramHandle:visible.
      970     if mFrameView
      971     then do:
      972       ASSIGN
      973          FRAME InfoFrame:HIDDEN                           = TRUE
      974          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      975     end.
      976   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      977   DO:
      978     IF not StopProcessing THEN
      979       Message "Вы действительно хотите прервать" SKIP
      980               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      981                 UPDATE StopProcessing.
      982     IF StopProcessing THEN do:
      983        if mFrameView
      984        then do:
      985           HIDE FRAME InfoFrame.
      986        end.
      987     End.
      988   END.
      989   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
      990     if  log-manager:logfile-name ne ?
      991     then DO:
      992         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      993     end.
      994     if not session:batch-mode then
      995     do:
      996       VIEW FRAME InfoFrame.
      997       mFrameView = true.
      998     end.
      999      v-button-stop = false .
     1000         if mFrameView
     1001         then do:
     1002         if v-button-stop then view STOPBTN in frame InfoFrame.
     1003                          else Hide STOPBTN in frame InfoFrame.
     1004         end.
     1005   FORM with frame plan-menu .
     1006   for each fbr-pln no-lock where recid (fbr-pln) = v-doc-rec  :
     1007     FIND This_Object  WHERE This_Object.obj-type = fbr-pln.obj-type AND This_Object.obj-code = fbr-pln.obj-code  NO-LOCK.
     1008     FIND clients      WHERE clients.obj-type     = 'орг':U           AND clients.obj-code     = fbr-pln.host-code NO-LOCK.
     1009     run PrintTitul in this-procedure .
     1010    run make-tt in this-procedure .
     1011       if sort-group = yes then do:
     1012         for each temp-str no-lock break by temp-str.grp-name by if sort-name then  temp-str.gds-name Else string(temp-str.np,"999999999") :
     1013           if first-of( temp-str.grp-name) then run print-grp in this-procedure .
     1014           run print-line in this-procedure .
     1015           if last-of( temp-str.grp-name ) then  run print-grp-itog in this-procedure .
     1016         end.
     1017       end.
     1018       else do:
     1019         for each temp-str no-lock break by if sort-name then  temp-str.gds-name Else string(temp-str.np,"999999999") :
     1020           run print-line in this-procedure .
     1021         end.
     1022       end.
     1023     run print-all-itog in this-procedure .
     1024     run on-same-page in this-procedure (input 15) .
     1025     run PrintPodval in this-procedure .
     1026     page stream OutStream .
     1027   end.
     1028   HIDE STREAM OutStream FRAME plan-menu.
     1029   HIDE stream OutStream FRAME BottomFrame .
     1030   HIDE stream OutStream FRAME BottomFrame2 .
     1031   output stream OutStream CLOSE .
     1032   if mFrameView
     1033   then do:
     1034      HIDE FRAME InfoFrame.
     1035   end.
     1036   if g#quest-print = false
     1037   then do:
     1038     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1039                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
     1040                                         OUTPUT g#log ).
     1041   end.
     1042   else do:
     1043     os-command silent
     1044       value( "COPY /b " +
     1045         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1046         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1047         string( session:temp-directory) +  "$" + string( g#report-num )
     1048                 ) .
     1049     os-command silent
     1050       value( "COPY /b " +
     1051         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1052         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1053         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1054                 ) .
     1055   end.
     1056   end.
     1057   procedure print-grp :
     1058     do  on error undo, return error return-value  :
     1059       DOWN stream OutStream 1 with FRAME plan-menu .
     1060       PUT stream OutStream UNFORMATTED String("               " + TRIM(CAPS(temp-str.grp-name)))  skip  .
     1061     end.
     1062   end procedure.
     1063   procedure print-line :
     1064     do on error undo, return error return-value :
     1065     assign
     1066        Lines_Counter = Lines_Counter + 1
     1067       .
     1068     if line-counter( OutStream ) + 2 > page-size( OutStream ) then page stream OutStream.
     1069     if line-counter( OutStream ) < Tmp_Counter then
     1070       assign
     1071       .
     1072     assign
     1073       Tmp_Counter  = line-counter( OutStream )
     1074       num-ln = num-ln + 1
     1075     .
     1076     FullNameGds = temp-str.gds-name .
     1077     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     1078     assign j = 0.
     1079     DO WHILE gds-str2 <> "" :
     1080       assign gds-str = gds-str2.
     1081       gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     1082       assign j = j + 1.
     1083     END.
     1084     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     1085     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     1086     display stream OutStream
     1087       sym1     temp-str.price
     1088       sym2     temp-str.gds-name
     1089       sym3     temp-str.b-code
     1090       sym4
     1091       with FRAME plan-menu.
     1092     DOWN stream OutStream 1 with FRAME plan-menu.
     1093     if print-graft = false THEN do:
     1094     underline stream OutStream
     1095       sym1     temp-str.price
     1096       sym2     temp-str.gds-name
     1097       sym3     temp-str.b-code
     1098       sym4
     1099       with FRAME plan-menu.
     1100     DOWN stream OutStream 1 with FRAME plan-menu.
     1101     end.
     1102     end.
     1103   end procedure.
     1104   procedure print-grp-itog :
     1105     do on error undo, return error return-value :
     1106     end.
     1107   end procedure.
     1108   procedure print-all-itog :
     1109   end procedure.
     1110   procedure PrintTitul :
     1111     do  on error undo, return error return-value  :
     1112       case clients.obj-type:
     1113          when 'орг':U
     1114          then do:
     1115               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1116               if available ub.firm
     1117               then do:
     1118                   assign
     1119                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1120                       t-addres = t-addres
     1121                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1122                               then ""
     1123                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1124                             )
     1125                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1126                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1127                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1128                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1129                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1130                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1131                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1132                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1133                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1134                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1135                       t-phone = ub.firm.phone
     1136                       t-inn   = ub.firm.inn
     1137                       t-okpo  = ub.firm.okpo
     1138                   .
     1139               end.
     1140          end.
     1141          when 'маг':U
     1142          then do:
     1143               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1144               if available ub.shop
     1145               then do:
     1146                   assign
     1147                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1148                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1149                       t-phone = shop.phone
     1150                       t-inn = ""
     1151                       t-okpo = ""
     1152                   .
     1153               end.
     1154          end.
     1155          when 'скл':U
     1156          then do:
     1157               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1158               if available ub.store
     1159               then do:
     1160                   assign
     1161                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1162                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1163                       t-phone = ub.store.phone
     1164                       t-inn = ""
     1165                       t-okpo = ""
     1166                   .
     1167               end.
     1168          end.
     1169          when 'чел':U
     1170          then do:
     1171               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1172               if available ub.person
     1173               then do:
     1174                   assign
     1175                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1176                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1177                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1178                       t-phone = ub.person.phone1
     1179                       t-inn = ub.person.inn
     1180                       t-okpo = ub.person.okpo
     1181                   .
     1182               end.
     1183          end.
     1184       end case.
     1185         PUT STREAM OutStream
     1186           space(5) string( "М Е Н Ю" ) skip
     1187           space(5) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" ) format "X(120)"   skip
     1188           space(5) cur-time-date() format "x(20)"
     1189           skip .
     1190         .
     1191     end.
     1192   end procedure.
     1193   procedure PrintPodval :
     1194     do on error undo, return error return-value  :
     1195     PUT  STREAM OutStream " "
     1196     skip skip skip
     1197   " Руководитель _______________________ " skip
     1198   " Шеф повар    _______________________ " skip
     1199   " Калькулятор  _______________________ " skip
     1200         .
     1201     end.
     1202   end procedure.
     1203   PROCEDURE on-same-page :
     1204     define input parameter p-line-number as integer  no-undo .
     1205     if p-line-number > page-size( OutStream ) then return .
     1206     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     1207   end procedure.
     1208   procedure make-tt :
     1209     do
     1210     on error undo, return error return-value
     1211     :
     1212   define buffer buf_fbr-pln-line for fbr-pln-line .
     1213   define buffer buf_recipe for recipe .
     1214   define buffer buf_goods  for goods .
     1215   define variable v-cur-dn as character no-undo .
     1216   define variable v-cur-pr as decimal no-undo .
     1217   define variable v-cur-rt as decimal no-undo .
     1218   define variable v-cur-ex as decimal no-undo .
     1219   define variable v-bar-code like bar-code.b-code no-undo .
     1220    for each  buf_fbr-pln-line no-lock where buf_fbr-pln-line.doc-code = fbr-pln.doc-code
     1221                                       break by  buf_fbr-pln-line.line-num :
     1222     find first buf_recipe  where buf_recipe.recipe-code = buf_fbr-pln-line.recipe-code  no-lock  .
     1223     find first buf_goods   where buf_goods.gds-code = buf_fbr-pln-line.gds-code  no-lock .
     1224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1225     (input  buf_goods.gds-code
     1226     ,input  ?
     1227     ,output v-bar-code
     1228     )  .
     1229   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1230   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1231     (input  buf_fbr-pln-line.obj-type
     1232     ,input  buf_fbr-pln-line.obj-code
     1233     ,input  v-bar-code
     1234     ,input  0
     1235     ,input  0
     1236     ,output v-cur-dn
     1237     ,output v-cur-pr
     1238     ,output v-cur-rt
     1239     ,output v-cur-ex
     1240     )  .
     1241     define variable v-grp-fbr-name as character no-undo .
     1242     find first fbr-gds-obj no-lock where
     1243                fbr-gds-obj.gds-code = buf_goods.gds-code and
     1244                fbr-gds-obj.obj-code = buf_fbr-pln-line.obj-code and
     1245                fbr-gds-obj.obj-type = buf_fbr-pln-line.obj-type
     1246                no-error .
     1247     if error-status :error then v-grp-fbr-name = "Блюдо и гарнир" .
     1248     find first fbr-gds-grp no-lock where fbr-gds-grp.node-code = fbr-gds-obj.fbr-grp-code and
     1249                                         fbr-gds-grp.obj-code = fbr-gds-obj.obj-code     and
     1250                                         fbr-gds-grp.obj-type = fbr-gds-obj.obj-type    no-error .
     1251     if available fbr-gds-grp then v-grp-fbr-name = fbr-gds-grp.node-name .
     1252     else do:
     1253       v-grp-fbr-name = "Блюдо и гарнир" .
     1254       message
     1255               vss-workfile vss-revision vss-description skip
     1256               error-status :get-message(1)              skip
     1257               "Товар не приязан к ГРУППЕ БЛЮД"          skip
     1258               "Блюдо      : " buf_goods.artic  buf_goods.prod-code buf_goods.prod-type skip
     1259                               buf_goods.gds-name        skip
     1260                               buf_goods.grp-name        skip
     1261               "Код группы : " fbr-gds-obj.fbr-grp-code  skip
     1262               "Объект     : " fbr-gds-obj.obj-code fbr-gds-obj.obj-type skip
     1263               "Будет входить в группу  - " v-grp-fbr-name
     1264               .
     1265     end.
     1266     create temp-str .
     1267     assign
     1268       temp-str.np         = buf_fbr-pln-line.line-num
     1269       temp-str.grp-name   = v-grp-fbr-name
     1270       temp-str.gds-name   = buf_goods.gds-name
     1271       temp-str.b-code     = string(v-bar-code)
     1272       temp-str.norma      = ?
     1273       temp-str.num-rcp    = string(buf_recipe.recipe-ref-num)
     1274       temp-str.p-inp      = if buf_recipe.portion-qnty <> 0 and buf_recipe.portion-qnty <> ? then  buf_recipe.qnty / buf_recipe.portion-qnty else 0
     1275       temp-str.qnty       = buf_fbr-pln-line.fact-qnty
     1276       temp-str.price      = v-cur-pr
     1277       temp-str.stoim      = temp-str.qnty  * temp-str.price
     1278       .
     1279     end.
     1280     end.
     1281    end procedure.
