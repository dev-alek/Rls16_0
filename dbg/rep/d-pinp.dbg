      744   on help of frame D-Dialog
      745   do:
      746     run gbl/app_help.p
      747       (input this-procedure :file-name
      748       ,input ''
      749       ,input ?
      750       ) no-error.
      751     if error-status :error then do:
      752       message
      753         "Ошибка при вызове помощи"
      754         error-status :get-message(1)
      755         view-as alert-box .
      756     end.
      757   end.
      758   run minbtn-set in this-procedure .
      759   on choose of b-help in frame D-Dialog
      760   do:
      761     apply "help":u to frame D-Dialog .
      762   end.
      763   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      764   procedure minbtn-set :
      765       do
      766           on error undo, return error return-value
      767           :
      768           define variable ii              as integer       no-undo .
      769           define variable fh              as widget-handle no-undo .
      770           define variable hh              as widget-handle no-undo .
      771           define variable v-h             as handle        extent 4 no-undo .
      772           define variable v-name-button   as character     no-undo .
      773           define variable v-help-old-x    as decimal       no-undo .
      774           define variable v-help-old-y    as decimal       no-undo .
      775           define variable v-help-old-size as decimal       no-undo .
      776           define variable v-frame-width   as decimal       no-undo .
      777           define variable jj              as integer       no-undo .
      778           do
      779               on error undo, return error
      780               :
      781               assign
      782                   v-frame-width = frame D-Dialog:width - 0.3
      783                   fh            = frame D-Dialog:first-child
      784                   hh            = fh:first-child
      785                   ii            = 1
      786                   .
      787               do while valid-handle(hh):
      788                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      789                   do:
      790                       case lc(hh:name) :
      791                           when "b-help" then
      792                               do:
      793                                   hh:load-image-up("cmp/b-help.bmp":u) .
      794                                   hh:load-image-down("cmp/b-help.bmp":u) .
      795                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      796                                   hh:TOOLTIP = "Помощь" .
      797                                   v-help-old-x = hh:column .
      798                                   v-help-old-y = hh:row    .
      799                                   v-help-old-size = hh:width .
      800                                   hh:width-chars = 2.5 .
      801                               end.
      802                           when "b-print" then
      803                               do:
      804                                   hh:load-image("cmp/b-print.bmp":u) .
      805                                   hh:TOOLTIP = "Печать" .
      806                                   v-h[ii] = hh:handle .
      807                                   ii = ii + 1 .
      808                                   hh:width-chars = 3 .
      809                               end.
      810                           when "b-history" or
      811                           when "b-hist" then
      812                               do:
      813                                   hh:load-image("cmp/b-hist.bmp":u) .
      814                                   hh:TOOLTIP = "История" .
      815                                   v-h[ii] = hh:handle .
      816                                   ii = ii + 1 .
      817                                   hh:width-chars = 3 .
      818                               end.
      819                           when "b-sch" then
      820                               do:
      821                                   hh:load-image("cmp/b-sch.bmp":u) .
      822                                   hh:TOOLTIP = "Установка Фильтра" .
      823                                   v-h[ii] = hh:handle .
      824                                   ii = ii + 1 .
      825                                   hh:width-chars = 3 .
      826                               end.
      827                           when "b-hist-user" then
      828                               do:
      829                                   hh:load-image("cmp/b-hist.bmp":u) .
      830                                   hh:TOOLTIP = "История пользователя" .
      831                                   ii = ii + 1 .
      832                               end.
      833                       end case.
      834                   end.
      835                   hh = hh:next-sibling.
      836               end.
      837               b-help:column = v-frame-width - b-help:width-chars.
      838               jj = 0.
      839               repeat ii = 4 to 1 by -1 :
      840                   if valid-handle (v-h[ii] ) then
      841                   do:
      842                       jj  = jj + 1 .
      843                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      844                       v-h[ii]:row    = v-help-old-y .
      845                   end.
      846               end.
      847           end.
      848       end.
      849   end procedure.
      850   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      851       MESSAGE "A SmartDialog is not intended ":U SKIP
      852               "to be run Persistent or to be placed ":U SKIP
      853               "in another SmartObject at UIB design time.":U
      854               VIEW-AS ALERT-BOX ERROR.
      855       RUN disable_UI.
      856       DELETE PROCEDURE THIS-PROCEDURE.
      857       RETURN.
      858   END.
      859   RUN dispatch ('create-objects':U).
      860   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
      861   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
      862   MAIN-BLOCK:
      863   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      864      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      865     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      866     WAIT-FOR GO OF FRAME D-Dialog.
      867   END.
      868   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      869   PROCEDURE add-all-petrol :
      870     def var v-old-lns-cnt as integer no-undo .
      871     define variable v-added as integer no-undo .
      872     assign
      873       v-old-lns-cnt = lns-cnt
      874     .
      875     run str/gdsunitt.p
      876       (
      877        input parparentproc
      878       ,input 'топ':U
      879       ,input 'т':U
      880       ,output v-added
      881       ).
      882     do with frame D-Dialog:
      883       assign
      884         fi-goods-count :screen-value = string(lns-cnt)
      885       .
      886     end.
      887     message
      888     v-added "товаров было добавлено"
      889     view-as alert-box information .
      890   END PROCEDURE.
      891   PROCEDURE adm-create-objects :
      892   END PROCEDURE.
      893   PROCEDURE adm-row-available :
      894     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      895     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      896     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      897     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      898     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      899     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      900     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      901     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      902     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      903     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      904     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      905     IF adm-updating-record THEN RETURN.
      906     RUN get-attribute ('FIELDS-ENABLED':U).
      907     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      908     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      909         OUTPUT link-handle) NO-ERROR.
      910     IF link-handle = "":U THEN
      911         RETURN.
      912     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      913     IF NUM-ENTRIES(link-handle) > 1 THEN
      914         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      915             "encountered more than one RECORD-SOURCE.":U SKIP
      916             "The first - ":U record-source-hdl:file-name " - will be used.":U
      917                VIEW-AS ALERT-BOX ERROR.
      918     RUN get-attribute ('Key-Name':U).
      919     key-name = RETURN-VALUE.
      920     IF key-name = "":U THEN key-name = ?.
      921     IF key-name NE ? THEN DO:
      922       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      923         NO-ERROR.
      924       IF key-value NE ? THEN
      925         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      926     END.
      927   IF VALID-HANDLE (adm-object-hdl) THEN
      928       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      929   RUN notify IN THIS-PROCEDURE ('row-available':U).
      930   END PROCEDURE.
      931   PROCEDURE disable_UI :
      932     HIDE FRAME D-Dialog.
      933   END PROCEDURE.
      934   PROCEDURE display-month-name :
      935     def var v-month-name as character no-undo .
      936     do with frame D-Dialog:
      937       run gbl/monthnam.p
      938         (input integer(cb-month :screen-value)
      939         ,output v-month-name
      940         ).
      941       assign
      942         fi-month-name :screen-value = v-month-name
      943       .
      944     end.
      945   END PROCEDURE.
      946   PROCEDURE enable_UI :
      947     DISPLAY CB-Month FI-Year fi-goods-count
      948         WITH FRAME D-Dialog.
      949     ENABLE RECT-1 CB-Month b-prev-month b-next-month FI-Year b-prev-year
      950            b-next-year RECT-2 b-all-petrol b-select-goods b-print b-help b-quit
      951            fi-month-name fi-goods-count
      952         WITH FRAME D-Dialog.
      953     VIEW FRAME D-Dialog.
      954   END PROCEDURE.
      955   PROCEDURE init-gds-list :
      956     assign
      957       lns-cnt = 0
      958     .
      959     for each gds-list
      960     :
      961       assign
      962         lns-cnt = lns-cnt + 1
      963       .
      964     end.
      965   END PROCEDURE.
      966   PROCEDURE select-month :
      967     define input parameter p-shift-value as integer no-undo .
      968     def var v-current-month as integer no-undo .
      969     do with frame D-Dialog:
      970       assign
      971         v-current-month = integer (cb-month :screen-value)
      972       .
      973       assign
      974         v-current-month = v-current-month + p-shift-value
      975       .
      976       if v-current-month < 1 then do:
      977         assign
      978           v-current-month = 1
      979         .
      980       end.
      981       if v-current-month > 12 then do:
      982         assign
      983           v-current-month = 12
      984         .
      985       end.
      986       assign
      987         cb-month :screen-value = string(v-current-month)
      988       .
      989     end.
      990     run display-month-name .
      991   END PROCEDURE.
      992   PROCEDURE select-year :
      993     define input parameter p-shift-value as integer no-undo .
      994     def var v-current-year as integer no-undo .
      995     do with frame D-Dialog:
      996       assign
      997         v-current-year = integer (fi-year :screen-value)
      998       .
      999       assign
     1000         v-current-year = v-current-year + p-shift-value
     1001       .
     1002       if v-current-year < 0 then do:
     1003         assign
     1004           v-current-year = 0
     1005         .
     1006       end.
     1007       if v-current-year > 9999 then do:
     1008         assign
     1009           v-current-year = 9999
     1010         .
     1011       end.
     1012       assign
     1013         fi-year :screen-value = string(v-current-year)
     1014       .
     1015     end.
     1016     run display-month-name .
     1017   END PROCEDURE.
     1018   PROCEDURE send-records :
     1019   END PROCEDURE.
     1020   PROCEDURE state-changed :
     1021     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1022     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1023   END PROCEDURE.
