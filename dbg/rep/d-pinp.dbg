      651     run str/gds-list.w (
      652                     input parparentproc
      653                   , input v-cntxt-host-code-obj
      654                   , input v-cntxt-obj-type
      655                   , input v-cntxt-obj-code).
      656     def var v-new-lns-cnt  as integer no-undo init 0 .
      657     def var v-remove-count as integer no-undo init 0 .
      658     define buffer buf_goods for ub.goods .
      659     define buffer buf_units for ub.units .
      660     for each gds-list no-lock
      661     :
      662       find first buf_goods no-lock
      663         where buf_goods.artic     = gds-list.artic
      664           and buf_goods.prod-type = gds-list.prod-type
      665           and buf_goods.prod-code = gds-list.prod-code
      666         no-error .
      667       if not available buf_goods then do:
      668         delete gds-list .
      669         assign
      670           v-remove-count = v-remove-count + 1
      671         .
      672         next .
      673       end.
      674       find first buf_units no-lock
      675         where buf_units.unit-name = buf_goods.unit-base
      676         no-error .
      677       if not available buf_units then do:
      678         assign
      679           v-remove-count = v-remove-count + 1
      680         .
      681         delete gds-list .
      682         next .
      683       end.
      684       if not can-do(buf_units.type, 'топ':U) then do:
      685         assign
      686           v-remove-count = v-remove-count + 1
      687         .
      688         delete gds-list .
      689         next .
      690       end.
      691       assign
      692         v-new-lns-cnt = v-new-lns-cnt + 1
      693       .
      694     end.
      695     if v-remove-count <> 0 then do:
      696       message
      697         "Товар не является топливом и удален из списка." skip
      698         view-as alert-box information .
      699     end.
      700     do with frame D-Dialog:
      701       assign
      702         lns-cnt = v-new-lns-cnt
      703         fi-goods-count :screen-value = string(lns-cnt)
      704       .
      705     end.
      706   END.
      707   ON VALUE-CHANGED OF CB-Month IN FRAME D-Dialog
