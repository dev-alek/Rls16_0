      711   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712     run mainmenu_getcntxt in parparentproc
      713       (output v-cntxt-db-num
      714       ,output v-cntxt-userid
