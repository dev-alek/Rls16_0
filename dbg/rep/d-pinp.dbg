      716       ,output v-cntxt-host-code-obj
      717       ,output v-cntxt-obj-type
      718       ,output v-cntxt-obj-code
      719       ,output v-cntxt-db-num-obj
      720       ,output v-cntxt-is-admin
      721       ) .
      722   if p-title <> "" then do:
      723     assign
      724       frame D-Dialog :title = p-title
      725     .
      726   end.
