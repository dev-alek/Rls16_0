      586   define variable var-report-r-b as character no-undo .
      587   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      589     (output var-report-r-b
      590     )  .
      591   do
      592   on error undo, return error
      593   :
      594   define variable v-date1 as date   no-undo .
      595   v-date1 = date( month(today) , day(today) , year(today) - 1 ).
      596       run rep/d-report.w (
      597         input p-mainmenu-handle
      598       , input "rep/e-defect.w"
      599       , input "Отчет по фальсифицированным и забракованным партиям"
      600       , input 2
      601       , input "1,2,3,4,7":U
      602       , input "*"
      603       , input ""
      604       , input ""
      605       , input substitute("all,10,1,13,X-DATE-START=&1,X-CUSTOMER-NAME=Выбор Поставщиков", string( v-date1, "99/99/9999" ))
      606       , input no
      607       ).
      608   end.
