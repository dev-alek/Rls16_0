     5430   procedure new-tmp-page :
     5431    do
     5432    on error undo, return error return-value
     5433    :
     5434       if   num#str#  >=  63000  then do:
     5435           output stream macr_excel  close .
     5436           run paramls-write in this-procedure
     5437             (input "file"
     5438             ,input string(v-ind)
     5439             ,input v-file-name
     5440             ) .
     5441           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5442           output stream  macr_excel to value(v-file-name) .
     5443           v-ind = v-ind + 1 .
     5444           num#str# = 0 .
     5445   define variable old-s as integer no-undo .
     5446   define variable old-s2 as integer no-undo .
     5447       assign
     5448       old-s =   num#str#
     5449       .
     5450       run make-col .
     5451       assign
     5452         old-s2 =   num#str#
     5453       .
     5454      num#str# = old-s + 1  .
     5455      run proc-print-header .
     5456      num#str# = old-s2     .
     5457       end.
     5458    end.
     5459   end procedure.
     5460   procedure pp :
     5461   define input parameter ll as integer no-undo .
     5462   define input parameter uu as integer no-undo .
     5463   define input parameter ff as character no-undo .
     5464   End procedure.
     5465   procedure find-last-prise-med :
     5466   define input parameter p-artic     like ub.goods.artic no-undo .
     5467   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5468   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5469   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5470   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5471   define buffer p-gds-obj   for  ub.gds-obj .
     5472   define buffer buf_trn-doc for  ub.trn-doc .
     5473   define variable v-fact-order as decimal no-undo .
     5474   p-price = 0 .
     5475     define variable v-in-date as date      no-undo .
     5476     define variable fl as logical no-undo .
     5477     fl = yes.
     5478     v-fact-order = 0 .
     5479     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5480     :
     5481       find first p-gds-obj no-lock
     5482         where p-gds-obj.artic     = p-artic         and
     5483                 p-gds-obj.prod-type = p-prod-type     and
     5484                 p-gds-obj.prod-code = p-prod-code     and
     5485                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5486                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5487         no-error .
     5488       if available p-gds-obj then do:
     5489       if p-gds-obj.in-date = ?  then next .
     5490       if fl = yes then do:
     5491         assign
     5492           v-in-date = p-gds-obj.in-date
     5493           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5494           fl = no
     5495       .
     5496        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5497        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5498       end.
     5499         if p-gds-obj.in-date >= v-in-date   then do:
     5500            if p-gds-obj.in-date = v-in-date then do:
     5501               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5502               if available buf_trn-doc  then
     5503                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5504                     assign
     5505                       v-fact-order = buf_trn-doc.fact-order
     5506                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5507                       v-in-date =   p-gds-obj.in-date
     5508                     .
     5509                   end.
     5510            end.
     5511            else do:
     5512             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5513             if available buf_trn-doc  then
     5514                 assign
     5515                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5516                   v-in-date =    p-gds-obj.in-date
     5517                   v-fact-order = buf_trn-doc.fact-order .
     5518                 .
     5519             end.
     5520           if p-price = ? then   p-price  = 0 .
     5521         end.
     5522       end.
     5523     End .
     5524     if p-price = ? then   p-price  = 0 .
     5525   end procedure.
     5526   procedure find-mediator :
     5527   define input  parameter c-host-code as integer no-undo .
     5528   define input  parameter p-Showmediatr as logical no-undo .
     5529   define output parameter p-host-code as integer no-undo .
     5530   define output parameter p-flag as logical no-undo .
     5531   define buffer b-sysconf  for ub.sysconf.
     5532    p-host-code = 0 .
     5533    p-flag  = true .
     5534       if p-Showmediatr = true then do:
     5535       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5536             if avail ub.sysconf then DO :
     5537               p-host-code = ub.sysconf.host-code.
     5538               if tPrintRubl = false then do:
     5539                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5540                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5541                                 p-flag  = false  .
     5542                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5543                                 view-as alert-box error.
     5544                           end.
     5545               end.
     5546             end.
     5547             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5548                 create tt-obj-list no-error .
     5549                 assign tt-obj-list.obj-type = 'маг':U
     5550                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5551             end.
     5552             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5553                 create tt-obj-list no-error .
     5554                 assign tt-obj-list.obj-type = 'скл':U
     5555                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5556             end.
     5557       End.
     5558    End procedure .
     5559   PROCEDURE ob-line-stk  :
     5560   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5561   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5562   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5563   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5564   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5565   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5566   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5567   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5568   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5569   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5570   define input  parameter xTog-obj         as log                     no-undo.
     5571   define input  parameter xi               as int                     no-undo.
     5572   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5573   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5574   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5575   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5576   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5577   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5578   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5579   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5580   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5581   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5582   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5583   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5584   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5585   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5586   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5587   define buffer stk-line2 for ub.stk-line .
     5588   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5589    Assign
     5590      First-qnty  = 0
     5591      Second-qnty = 0
     5592      Quntity     = 0
     5593      First-sum  = 0
     5594      Second-sum = 0
     5595      sum        = 0
     5596      First-vat  = 0
     5597      Second-vat = 0
     5598      vat        = 0
     5599      First-slt   = 0
     5600      Second-slt  = 0
     5601      slt         = 0
     5602      First-disc  = 0
     5603      Second-disc = 0
     5604      disc        = 0
     5605     .
     5606     For each obj-list  no-lock :
     5607      if  xTog-obj THEN
     5608          if   NOT(    x-store-type     = obj-list.obj-type
     5609               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5610      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5611         find last ub.stk-line no-lock
     5612           where ub.stk-line.obj-type   = obj-list.obj-type
     5613             and ub.stk-line.obj-code   = obj-list.obj-code
     5614             and ub.stk-line.artic      = x-artic
     5615             and ub.stk-line.prod-type  = x-prod-type
     5616             and ub.stk-line.prod-code  = x-prod-code
     5617             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5618             and ub.stk-line.cat-id     = '##,##':U
     5619             and ub.stk-line.fact-order <= x-fact-order-1
     5620           use-index category
     5621           no-error .
     5622         if available ub.stk-line then do:
     5623           assign
     5624             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5625             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5626             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5627             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5628             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5629           .
     5630         end.
     5631         find last stk-line2 no-lock
     5632           where stk-line2.obj-code   = obj-list.obj-code
     5633             and stk-line2.obj-type   = obj-list.obj-type
     5634             and stk-line2.artic      = x-artic
     5635             and stk-line2.prod-type  = x-prod-type
     5636             and stk-line2.prod-code  = x-prod-code
     5637             and stk-line2.sum-type   = temp#sum-type.sum-type
     5638             and stk-line2.cat-id     = '##,##':U
     5639             and stk-line2.fact-order <= x-fact-order-2
     5640           use-index category
     5641           no-error .
     5642         if available stk-line2 then do:
     5643           assign
     5644             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5645             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5646             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5647             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5648             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5649           .
     5650         end.
     5651      end.
     5652    end.
     5653    Assign
     5654      Quntity = Second-qnty - first-qnty
     5655      sum     = Second-sum  - first-sum
     5656      vat     = Second-vat  - first-vat
     5657      slt     = Second-slt  - first-slt
     5658      disc    = Second-disc  - first-disc
     5659      .
     5660   END PROCEDURE.
     5661   procedure calc-ms-wt :
     5662   define input        parameter p-oborot-num      as decimal   no-undo .
     5663   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5664   define input-output parameter p-oborot          as decimal   no-undo .
     5665   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5666   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5667   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5668   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5669   do
     5670   on error undo, return error return-value
     5671   :
     5672   if p-is-petrol = true then return .
     5673     assign
     5674       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5675       p-bi-oborot = p-bi-oborot + p-oborot
     5676       p-bo-oborot = p-bo-oborot + p-oborot
     5677       p-b1-oborot = p-b1-oborot + p-oborot
     5678       p-b2-oborot = p-b2-oborot + p-oborot
     5679     .
     5680   end.
     5681   end procedure.
     5682   procedure calc-dens :
     5683   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5684   define input        parameter p-ostatok          as decimal   no-undo .
     5685   define input-output parameter p-density          as decimal   no-undo .
     5686   define input-output parameter p-bi-density       as decimal   no-undo .
     5687   define input-output parameter p-bo-density       as decimal   no-undo .
     5688   define input-output parameter p-b1-density       as decimal   no-undo .
     5689   define input-output parameter p-b2-density       as decimal   no-undo .
     5690   do
     5691   on error undo, return error return-value
     5692   :
     5693   if p-is-petrol = false then return .
     5694     assign
     5695       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5696       p-bi-density = 0
     5697       p-bo-density = 0
     5698       p-b1-density = 0
     5699       p-b2-density = 0
     5700     .
     5701   end.
     5702   end procedure.
     5703   procedure calc-pt-ob :
     5704   define input  parameter p-ext-doc-type    as character no-undo .
     5705   define input  parameter x-store-type      as character no-undo .
     5706   define input  parameter x-store-code      as integer   no-undo .
     5707   define input  parameter p-artic           as character no-undo .
     5708   define input  parameter p-prod-type       as character no-undo .
     5709   define input  parameter p-prod-code       as integer   no-undo .
     5710   define input-output parameter p-oborot    as decimal   no-undo .
     5711   define input-output parameter p-bi-oborot as decimal   no-undo .
     5712   define input-output parameter p-bo-oborot as decimal   no-undo .
     5713   define input-output parameter p-b1-oborot as decimal   no-undo .
     5714   define input-output parameter p-b2-oborot as decimal   no-undo .
     5715     do
     5716     on error undo, return error return-value
     5717     :
     5718   define variable v-oborot as decimal   no-undo .
     5719   define buffer buf_doc-line  for ub.doc-line  .
     5720   define buffer buf_inv-line  for ub.inv-line  .
     5721   define buffer buf1_obj-list for obj-list .
     5722   assign
     5723     v-oborot = 0
     5724   .
     5725   if p-is-petrol = false   then return .
     5726     for each buf1_obj-list no-lock :
     5727      if  xtog-obj then
     5728          if   not(x-store-type     = buf1_obj-list.obj-type
     5729               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5730       for each buf_doc-line  no-lock where
     5731             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5732             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5733             buf_doc-line.artic        = p-artic and
     5734             buf_doc-line.prod-type    = p-prod-type and
     5735             buf_doc-line.prod-code    = p-prod-code and
     5736             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5737             buf_doc-line.status_      = 'факт':U        and
     5738             buf_doc-line.fact-order   <= fact-order-2  and
     5739             buf_doc-line.fact-order   >= fact-order-1
     5740             :
     5741             for each buf_inv-line  no-lock where
     5742                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5743                 buf_inv-line.artic        = buf_doc-line.artic and
     5744                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5745                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5746                 :
     5747                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5748                     else do:
     5749                     if p-ext-doc-type = 'we':U    or
     5750                        p-ext-doc-type = 'ee':U    or
     5751                        p-ext-doc-type = 'ev':U    or
     5752                        p-ext-doc-type = 'ep':U or
     5753                        p-ext-doc-type = 'em':U     or
     5754                        p-ext-doc-type = 'wm':U     or
     5755                        p-ext-doc-type = 'es':U   then
     5756                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5757                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5758                     end.
     5759             end.
     5760       end.
     5761   end.
     5762   assign
     5763     p-oborot    = v-oborot
     5764     p-bi-oborot = p-bi-oborot + v-oborot
     5765     p-bo-oborot = p-bo-oborot + v-oborot
     5766     p-b1-oborot = p-b1-oborot + v-oborot
     5767     p-b2-oborot = p-b2-oborot + v-oborot
     5768   .
     5769   end.
     5770   end procedure.
     5771   procedure calc-density :
     5772   define input        parameter p-ext-doc-type  as character no-undo .
     5773   define input        parameter x-store-type    as character no-undo .
     5774   define input        parameter x-store-code    as integer   no-undo .
     5775   define input        parameter p-artic         as character no-undo .
     5776   define input        parameter p-prod-type     as character no-undo .
     5777   define input        parameter p-prod-code     as integer   no-undo .
     5778   define input-output parameter p-density       as decimal   no-undo .
     5779   define input-output parameter p-bi-density    as decimal   no-undo .
     5780   define input-output parameter p-bo-density    as decimal   no-undo .
     5781   define input-output parameter p-b1-density    as decimal   no-undo .
     5782   define input-output parameter p-b2-density    as decimal   no-undo .
     5783     do
     5784     on error undo, return error return-value
     5785     :
     5786   define variable v-oborot    as decimal   no-undo .
     5787   define variable v-fact-qnty as decimal   no-undo .
     5788   define buffer buf_doc-line  for ub.doc-line  .
     5789   define buffer buf_inv-line  for ub.inv-line  .
     5790   define buffer buf1_obj-list for obj-list .
     5791   assign
     5792     v-oborot     = 0
     5793     v-fact-qnty  = 0
     5794   .
     5795   if p-is-petrol = false   then return .
     5796     for each buf1_obj-list no-lock :
     5797      if  xtog-obj then
     5798          if   not(x-store-type     = buf1_obj-list.obj-type
     5799               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5800       for each buf_doc-line  no-lock where
     5801             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5802             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5803             buf_doc-line.artic        = p-artic and
     5804             buf_doc-line.prod-type    = p-prod-type and
     5805             buf_doc-line.prod-code    = p-prod-code and
     5806             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5807             buf_doc-line.status_      = 'факт':U        and
     5808             buf_doc-line.fact-order   <= fact-order-2  and
     5809             buf_doc-line.fact-order   >= fact-order-1
     5810             :
     5811             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5812             for each buf_inv-line  no-lock where
     5813                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5814                 buf_inv-line.artic        = buf_doc-line.artic and
     5815                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5816                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5817                 :
     5818                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5819                     else do:
     5820                     if p-ext-doc-type = 'we':U    or
     5821                        p-ext-doc-type = 'ee':U    or
     5822                        p-ext-doc-type = 'ev':U    or
     5823                        p-ext-doc-type = 'ep':U or
     5824                        p-ext-doc-type = 'em':U     or
     5825                        p-ext-doc-type = 'wm':U     or
     5826                        p-ext-doc-type = 'es':U   then
     5827                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5828                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5829                     end.
     5830             end.
     5831       end.
     5832       assign
     5833         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5834       .
     5835       assign
     5836         p-bi-density = p-density
     5837         p-bo-density = 0
     5838         p-b1-density = 0
     5839         p-b2-density = 0
     5840       .
     5841   end.
     5842   end.
     5843   end procedure.
