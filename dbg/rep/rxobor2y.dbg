     3518   procedure display-bo  :
     3519   define variable ll as int no-undo.
     3520   define variable kk as int no-undo.
     3521     num#str# = num#str# + 1.
     3522     num#col# = 1.
     3523     run macr_excel_char_with_format( string("ИТОГО ПО ОБЪЕКТАМ")  , num#str# , num#col#  ) .
