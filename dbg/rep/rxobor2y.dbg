     5364               l#2 = l#2 + 1
     5365               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5366             .
     5367             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     5368            end.
     5369        end.
     5370   end procedure .
