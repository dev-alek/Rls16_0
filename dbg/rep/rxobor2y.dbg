     5308    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
