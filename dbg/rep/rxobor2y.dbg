     3969     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-pc [i] -  b2-oborot-pc[3] ),  i). end.
     3970     if i = 13 then do :
