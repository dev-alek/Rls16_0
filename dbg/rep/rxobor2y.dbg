     2916                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2917                               no-lock ,
     2918           first goods where gds-obj.gds-code  = goods.gds-code
     2919                               no-lock :
     2920               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2921                   create temp-gds-list.
     2922                   assign
     2923                     temp-gds-list.prod-code = gds-obj.prod-code
     2924                     temp-gds-list.grp-name  = ""
     2925                     temp-gds-list.gds-code  = gds-obj.gds-code
     2926                     temp-gds-list.artic     = gds-obj.artic
     2927                     temp-gds-list.gds-name  = goods.gds-name
     2928                     .
     2929                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     2930                     .
     2931               end.
     2932           end.
     2933    end.
     2934     for each temp-gds-list no-lock
     2935       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2936         break
     2937           by  temp-gds-list.grp-name
     2938           by goods.artic :
     2939           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     2940   find clients where clients.obj-type = goods.prod-type and
     2941                      clients.obj-code = goods.prod-code no-lock .
     2942     assign
     2943         gds-zap-unit-base  = goods.unit-base
     2944         gds-zap-prt-root   = goods.prt-root
     2945         gds-zap-prod-type  = goods.prod-type
     2946         gds-zap-prod-code  = goods.prod-code
     2947         gds-zap-artic      = goods.artic
     2948         gds-zap-type       = goods.gds-type
     2949         gds-zap-grp-name   = goods.grp-name
     2950         gds-zap-b-code     = goods.gds-code
     2951         gds-zap-prod-name  = clients.obj-name .
     2952     if g#gds-engl then
     2953         assign gds-zap-gds-name = goods.engl-name.
     2954     else
     2955         assign gds-zap-gds-name = goods.gds-name.
     2956   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2957     (input  gds-zap-b-code
     2958     ,input  ?
     2959     ,output v-bar-code
     2960     )  .
     2961     s-bar-code = string (v-bar-code,"999999999").
     2962     run foreach in this-procedure .
     2963       if  first-of ( temp-gds-list.grp-name )  then do:
     2964           fr = true .
     2965           l-stroka = "ГРУППА : " + str .
     2966           temp-str = l-stroka.
     2967       end.
     2968      run display-line in this-procedure .
     2969      if last-of( temp-gds-list.grp-name ) then do:
     2970         s-bar-code = "Итого по " .
     2971         gds-zap-artic = substring(str,1,16) .
