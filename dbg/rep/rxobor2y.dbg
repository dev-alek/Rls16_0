     4049   b2-oborot-prc                     [kk] = 0
     4050   b2-ostatok-end                           [kk] = 0
     4051   b2-ostatok-start                         [kk] = 0
     4052   b2-oborot-sum-sale                       [kk] = 0
     4053   b2-oborot-sum-cost                       [kk] = 0
     4054   b2-oborot-ap [kk] = 0
     4055   b2-oborot-pc [kk] = 0
     4056   .
     4057   end.
     4058   end procedure.
     4059   procedure clear-bi  :
     4060   repeat kk = 1 to 13 :
     4061   assign
     4062   bi-oborot-ie         [kk] = 0
     4063   bi-oborot-ee         [kk] = 0
     4064   bi-oborot-ep      [kk] = 0
     4065   bi-oborot-es    [kk] = 0
     4066   bi-oborot-re     [kk] = 0
     4067   bi-oborot-rs [kk] = 0
     4068   bi-oborot-we         [kk] = 0
     4069   bi-oborot-vt               [kk] = 0
     4070   bi-oborot-iv         [kk] = 0
     4071   bi-oborot-ev         [kk] = 0
     4072   bi-oborot-rv     [kk] = 0
     4073   bi-oborot-em          [kk] = 0
     4074   bi-oborot-wm          [kk] = 0
     4075   bi-oborot-im          [kk] = 0
     4076   bi-oborot-ot          [kk] = 0
     4077   bi-oborot-disc                    [kk] = 0
     4078   bi-oborot-eff                     [kk] = 0
     4079   bi-oborot-prc                     [kk] = 0
     4080   bi-ostatok-end                           [kk] = 0
     4081   bi-ostatok-start                         [kk] = 0
     4082   bi-oborot-sum-sale                       [kk] = 0
     4083   bi-oborot-sum-cost                       [kk] = 0
     4084   bi-oborot-ap [kk] = 0
     4085   bi-oborot-pc [kk] = 0
     4086   .
     4087   end.
     4088   end procedure.
     4089   procedure ob-line  :
     4090   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     4091   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     4092   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     4093   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     4094   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     4095   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     4096   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     4097   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     4098   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     4099   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     4100   define input  parameter xtog-obj           as log no-undo.
     4101   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     4102   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     4103   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     4104   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     4105   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     4106   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     4107   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     4108   define variable  v-summa  as decimal extent 4 no-undo .
     4109   define variable  tt#          as int no-undo.
     4110   define variable v-ii as integer no-undo .
     4111   define variable slt  as decimal no-undo .
     4112   define variable disc  as decimal no-undo .
     4113   define variable xi as integer no-undo .
     4114   define variable v-tt as integer no-undo .
     4115    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     4116       else
     4117       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     4118       else
     4119       assign tt# = 6  v-tt = 200.
     4120     if long-p = false then do :
     4121     for each obj-list no-lock:
     4122      if  xtog-obj then
     4123          if   not(x-store-type     = obj-list.obj-type
     4124               and x-store-code    = obj-list.obj-code ) then next.
     4125           for each ub.ot-line where
     4126                     ub.ot-line.artic         = x-artic
     4127               and   ub.ot-line.prod-code    = x-prod-code
     4128               and   ub.ot-line.prod-type    = x-prod-type
     4129               and   ub.ot-line.fact-order   <= x-fact-order-2
     4130               and   ub.ot-line.fact-order   >= x-fact-order-1
     4131               and   ub.ot-line.obj-code     = obj-list.obj-code
     4132               and   ub.ot-line.obj-type     = obj-list.obj-type
     4133               and   ub.ot-line.sum-type     = x-sum-type
     4134               no-lock :
     4135               case ub.ot-line.ext-doc-type:
     4136     WHEN 'ie':U THEN DO:
     4137       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     4138             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4139             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4140         if tt# = 6 Then   assign
     4141             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4142             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4143             End.
     4144     WHEN 'ee':U THEN DO:
     4145       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     4146             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4147             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4148         if tt# = 6 Then   assign
     4149             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4150             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4151             End.
     4152     WHEN 'ep':U THEN DO:
     4153       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     4154             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4155             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4156         if tt# = 6 Then   assign
     4157             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4158             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4159             End.
     4160     WHEN 'es':U THEN DO:
     4161       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     4162             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4163             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4164         if tt# = 6 Then   assign
     4165             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4166             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4167             End.
     4168     WHEN 're':U THEN DO:
     4169       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     4170             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4171             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4172         if tt# = 6 Then   assign
     4173             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4174             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4175             End.
     4176     WHEN 'rs':U THEN DO:
     4177       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     4178             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4179             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4180         if tt# = 6 Then   assign
     4181             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4182             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4183             End.
     4184     WHEN 'we':U THEN DO:
     4185       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     4186             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4187             oborot-we[3 + tt#]   = oborot-we[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4188         if tt# = 6 Then   assign
     4189             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4190             oborot-we[10]   = oborot-we[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4191             End.
     4192     WHEN 'vt':U  OR  WHEN 'mp':U OR WHEN 'vp':U THEN DO:
     4193       ASSIGN oborot-vt[1 + tt#]   = oborot-vt[1 + tt#]   +  ub.ot-line.fact-qnty
     4194             oborot-vt[2 + tt#]   = oborot-vt[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4195             oborot-vt[3 + tt#]   = oborot-vt[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4196           if tt# = 6 Then  assign
     4197             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4198             oborot-vt[10]   = oborot-vt[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4199             End.
     4200     WHEN 'iv':U THEN DO:
     4201       ASSIGN oborot-iv[1 + tt#]   = oborot-iv[1 + tt#]   +  ub.ot-line.fact-qnty
     4202             oborot-iv[2 + tt#]   = oborot-iv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4203             oborot-iv[3 + tt#]   = oborot-iv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4204         if tt# = 6 Then   assign
     4205             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4206             oborot-iv[10]   = oborot-iv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4207             End.
     4208     WHEN 'ev':U THEN DO:
     4209       ASSIGN oborot-ev[1 + tt#]   = oborot-ev[1 + tt#]   +  ub.ot-line.fact-qnty
     4210             oborot-ev[2 + tt#]   = oborot-ev[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4211             oborot-ev[3 + tt#]   = oborot-ev[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4212         if tt# = 6 Then   assign
     4213             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4214             oborot-ev[10]   = oborot-ev[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4215             End.
     4216     WHEN 'rv':U THEN DO:
     4217       ASSIGN oborot-rv[1 + tt#]   = oborot-rv[1 + tt#]   +  ub.ot-line.fact-qnty
     4218             oborot-rv[2 + tt#]   = oborot-rv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4219             oborot-rv[3 + tt#]   = oborot-rv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4220         if tt# = 6 Then   assign
     4221             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4222             oborot-rv[10]   = oborot-rv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4223             End.
     4224     WHEN 'wm':U  OR  WHEN 'em':U THEN DO:
     4225       ASSIGN oborot-em[1 + tt#]   = oborot-em[1 + tt#]   +  ub.ot-line.fact-qnty
     4226             oborot-em[2 + tt#]   = oborot-em[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4227             oborot-em[3 + tt#]   = oborot-em[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4228           if tt# = 6 Then  assign
     4229             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4230             oborot-em[10]   = oborot-em[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4231             End.
     4232     WHEN 'im':U THEN DO:
     4233       ASSIGN oborot-im[1 + tt#]   = oborot-im[1 + tt#]   +  ub.ot-line.fact-qnty
     4234             oborot-im[2 + tt#]   = oborot-im[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4235             oborot-im[3 + tt#]   = oborot-im[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4236         if tt# = 6 Then   assign
     4237             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4238             oborot-im[10]   = oborot-im[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4239             End.
     4240     WHEN 'ot':U THEN DO:
     4241       ASSIGN oborot-ot[1 + tt#]   = oborot-ot[1 + tt#]   +  ub.ot-line.fact-qnty
     4242             oborot-ot[2 + tt#]   = oborot-ot[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4243             oborot-ot[3 + tt#]   = oborot-ot[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4244         if tt# = 6 Then   assign
     4245             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4246             oborot-ot[10]   = oborot-ot[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4247             End.
     4248     WHEN 'ap':U THEN DO:
     4249       ASSIGN oborot-ap[1 + tt#]   = oborot-ap[1 + tt#]   +  ub.ot-line.fact-qnty
     4250             oborot-ap[2 + tt#]   = oborot-ap[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4251             oborot-ap[3 + tt#]   = oborot-ap[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4252         if tt# = 6 Then   assign
     4253             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4254             oborot-ap[10]   = oborot-ap[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4255             End.
     4256     WHEN 'pc':U THEN DO:
     4257       ASSIGN oborot-pc[1 + tt#]   = oborot-pc[1 + tt#]   +  ub.ot-line.fact-qnty
     4258             oborot-pc[2 + tt#]   = oborot-pc[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4259             oborot-pc[3 + tt#]   = oborot-pc[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4260         if tt# = 6 Then   assign
     4261             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4262             oborot-pc[10]   = oborot-pc[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4263             End.
     4264               end case.
     4265           end.
     4266      end.
     4267   end.
     4268   else do:
     4269   xi = 1 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ie [1 + tt#] ,output  oborot-ie [2 + tt#] ,output  oborot-ie [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ie[10]    = oborot-ie[10]    + slt  .
     4270   xi = 2 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ee [1 + tt#] ,output  oborot-ee [2 + tt#] ,output  oborot-ee [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ee[10]    = oborot-ee[10]    + slt  .
     4271   xi = 3 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ep [1 + tt#] ,output  oborot-ep [2 + tt#] ,output  oborot-ep [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ep[10]    = oborot-ep[10]    + slt  .
     4272   xi = 4 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-es [1 + tt#] ,output  oborot-es [2 + tt#] ,output  oborot-es [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-es[10]    = oborot-es[10]    + slt  .
     4273   xi = 5 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-re [1 + tt#] ,output  oborot-re [2 + tt#] ,output  oborot-re [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-re[10]    = oborot-re[10]    + slt  .
     4274   xi = 6 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rs [1 + tt#] ,output  oborot-rs [2 + tt#] ,output  oborot-rs [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rs[10]    = oborot-rs[10]    + slt  .
     4275   xi = 7 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-we [1 + tt#] ,output  oborot-we [2 + tt#] ,output  oborot-we [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-we[10]    = oborot-we[10]    + slt  .
     4276   xi = 8 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-vt [1 + tt#] ,output  oborot-vt [2 + tt#] ,output  oborot-vt [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-vt[10]    = oborot-vt[10]    + slt  .
     4277   xi = 9 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-iv [1 + tt#] ,output  oborot-iv [2 + tt#] ,output  oborot-iv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-iv[10]    = oborot-iv[10]    + slt  .
     4278   xi = 10 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ev [1 + tt#] ,output  oborot-ev [2 + tt#] ,output  oborot-ev [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ev[10]    = oborot-ev[10]    + slt  .
     4279   xi = 11 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rv [1 + tt#] ,output  oborot-rv [2 + tt#] ,output  oborot-rv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rv[10]    = oborot-rv[10]    + slt  .
     4280   xi = 12 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-em [1 + tt#] ,output  oborot-em [2 + tt#] ,output  oborot-em [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-em[10]    = oborot-em[10]    + slt  .
     4281   xi = 13 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-im [1 + tt#] ,output  oborot-im [2 + tt#] ,output  oborot-im [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-im[10]    = oborot-im[10]    + slt  .
     4282   xi = 14 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ot [1 + tt#] ,output  oborot-ot [2 + tt#] ,output  oborot-ot [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ot[10]    = oborot-ot[10]    + slt  .
     4283   xi = 15 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ap [1 + tt#] ,output  oborot-ap [2 + tt#] ,output  oborot-ap [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ap[10]    = oborot-ap[10]    + slt  .
     4284   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     4285   end.
     4286     if tt# = 6 then do:
     4287     if  xshowmediator = false then
     4288         oborot-sum-cost[1] =
     4289         oborot-ee[2]      +
     4290         oborot-es[2] +
     4291         oborot-re[2]  +
     4292         oborot-rs[2]
     4293         .
     4294         else
     4295         oborot-sum-cost[1] =
     4296         oborot-ee[4]      +
     4297         oborot-es[4] +
     4298         oborot-re[4]  +
     4299         oborot-rs[4]
     4300         .
     4301        repeat v-ii = 1 to 1 :
     4302        v-summa[v-ii ]  =
     4303           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     4304           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     4305           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     4306           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     4307           oborot-im[v-ii ] .
     4308        end.
     4309        repeat v-ii = 2 to 4 :
     4310        v-summa[v-ii ]  =
     4311           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4312           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4313           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4314           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4315           oborot-im[v-ii + tt#] .
     4316        end.
     4317         oborot-sum-sale[1] =
     4318         oborot-ee[2 + tt#] +
     4319         oborot-es[2 + tt#] +
     4320         oborot-re[2 + tt#] +
     4321         oborot-rs[2 + tt#]
     4322         .
     4323          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4324           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4325                                                                                                     -  oborot-disc[1]
     4326           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4327           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4328           .
     4329           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4330           if oborot-sum-cost[1] <>  0 then
     4331             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4332             else oborot-prc[1] = 0.
     4333     end.
     4334   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4335   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4336   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4337   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4338   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4339   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4340   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4341   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4342   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4343   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4344   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4345   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4346   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4347   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4348   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4349   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4350   end procedure.
     4351   procedure ost-line :
     4352     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     4353     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     4354     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     4355     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     4356     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     4357     define input  parameter x-tog-shift  as logical no-undo .
     4358     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     4359     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     4360     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     4361     define input  parameter xtog-obj     as logical no-undo .
     4362     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     4363     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     4364     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     4365     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     4366     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     4367     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     4368     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     4369     define buffer buff-obj-list  for obj-list .
     4370     define buffer buff-stk-line  for ub.stk-line .
     4371     assign
     4372       Quantity = 0
     4373       Coast_R  = 0
     4374       Coast_V  = 0
     4375       VAT_R    = 0
     4376       VAT_V    = 0
     4377       SLT_R    = 0
     4378       SLT_V    = 0
     4379     .
     4380     if  x-tog-shift = false then do:
     4381       for each buff-obj-list no-lock
     4382         where xtog-obj = false
     4383            or (buff-obj-list.obj-type = x-store-type
     4384               and buff-obj-list.obj-code = x-store-code
     4385               )
     4386       on error undo, return error
     4387       :
     4388       find last buff-stk-line no-lock
     4389         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4390           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4391           and buff-stk-line.artic      = x-artic
     4392           and buff-stk-line.prod-type  = x-prod-type
     4393           and buff-stk-line.prod-code  = x-prod-code
     4394           and buff-stk-line.sum-type   = x-sum-type
     4395           and buff-stk-line.cat-id     = '##,##':U
     4396           and buff-stk-line.fact-order <= x-fact-order
     4397           and buff-stk-line.shift-num  = 0
     4398         use-index category
     4399         no-error .
     4400       if available buff-stk-line then do:
     4401         assign
     4402           Quantity = Quantity + buff-stk-line.fact-qnty
     4403           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     4404           Coast_V  = Coast_V  + buff-stk-line.sum-base
     4405           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     4406           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     4407           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     4408           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     4409         .
     4410       end.
     4411      end.
     4412     end.
     4413     else do:
     4414       for each buff-obj-list no-lock
     4415         where xtog-obj = false
     4416            or (buff-obj-list.obj-type = x-store-type
     4417               and buff-obj-list.obj-code = x-store-code
     4418               )
     4419       on error undo, return error
     4420       :
     4421         find last buff-stk-line no-lock
     4422           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4423             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4424             and buff-stk-line.artic      = x-artic
     4425             and buff-stk-line.prod-type  = x-prod-type
     4426             and buff-stk-line.prod-code  = x-prod-code
     4427             and buff-stk-line.sum-type   = x-sum-type
     4428             and buff-stk-line.cat-id     = '##,##':U
     4429             and buff-stk-line.fact-order <= x-fact-order
     4430             and buff-stk-line.shift-num  > 0
     4431           use-index category
     4432           no-error .
     4433         if available buff-stk-line then do:
     4434           assign
     4435             Quantity = Quantity +  buff-stk-line.fact-qnty
     4436             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4437             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4438             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4439             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4440             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4441             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4442           .
     4443         end.
     4444       end.
     4445     end.
     4446   end procedure.
     4447   procedure ost-lineother-tax :
     4448     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4449     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4450     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4451     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4452     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4453     define input  parameter x-tog-shift  as logical no-undo .
     4454     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4455     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4456     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4457     define input  parameter xTog-obj     as logical no-undo .
     4458     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4459     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4460     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4461     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4462     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4463     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     4464     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     4465     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     4466     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     4467     define buffer buff-obj-list  for obj-list .
     4468     define buffer buff-stk-line  for ub.stk-line .
     4469     assign
     4470       Quantity = 0
     4471       Coast_R  = 0
     4472       Coast_V  = 0
     4473       VAT_R    = 0
     4474       VAT_V    = 0
     4475       SLT_R    = 0
     4476       SLT_V    = 0
     4477       other_R  = 0
     4478       other_V  = 0
     4479     .
     4480     if  x-tog-shift = false then do:
     4481       for each buff-obj-list no-lock
     4482         where xtog-obj = false
     4483            or (buff-obj-list.obj-type = x-store-type
     4484               and buff-obj-list.obj-code = x-store-code
     4485               )
     4486       on error undo, return error
     4487       :
     4488       find last buff-stk-line no-lock
     4489         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4490           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4491           and buff-stk-line.artic      = x-artic
     4492           and buff-stk-line.prod-type  = x-prod-type
     4493           and buff-stk-line.prod-code  = x-prod-code
     4494           and buff-stk-line.sum-type   = x-sum-type
     4495           and buff-stk-line.cat-id     = '##,##':U
     4496           and buff-stk-line.fact-order <= x-fact-order
     4497           and buff-stk-line.shift-num  = 0
     4498         use-index category
     4499         no-error .
     4500       if available buff-stk-line then do:
     4501         assign
     4502           Quantity = Quantity + buff-stk-line.fact-qnty
     4503           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     4504           Coast_V  = Coast_V  + buff-stk-line.sum-base
     4505           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     4506           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     4507           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     4508           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     4509           other_R  = other_R  + buff-stk-line.other-rubl
     4510           other_V  = other_V  + buff-stk-line.other-base
     4511         .
     4512       end.
     4513    end.
     4514     end.
     4515     else do:
     4516       for each buff-obj-list no-lock
     4517         where xtog-obj = false
     4518            or (buff-obj-list.obj-type = x-store-type
     4519               and buff-obj-list.obj-code = x-store-code
     4520               )
     4521       on error undo, return error
     4522       :
     4523         find last buff-stk-line no-lock
     4524           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4525             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4526             and buff-stk-line.artic      = x-artic
     4527             and buff-stk-line.prod-type  = x-prod-type
     4528             and buff-stk-line.prod-code  = x-prod-code
     4529             and buff-stk-line.sum-type   = x-sum-type
     4530             and buff-stk-line.cat-id     = '##,##':U
     4531             and buff-stk-line.fact-order <= x-fact-order
     4532             and buff-stk-line.shift-num  > 0
     4533           use-index category
     4534           no-error .
     4535         if available buff-stk-line then do:
     4536           assign
     4537             Quantity = Quantity +  buff-stk-line.fact-qnty
     4538             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4539             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4540             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4541             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4542             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4543             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4544             other_R = other_R   +  buff-stk-line.other-rubl
     4545             other_V = other_V   +  buff-stk-line.other-base
     4546           .
     4547         end.
     4548       end.
     4549     end.
     4550   end procedure.
     4551   procedure ost-line-kg :
     4552     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4553     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4554     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4555     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4556     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4557     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4558     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4559     define buffer buff-obj-list  for obj-list .
     4560     define buffer buf_doc-line for ub.doc-line .
     4561     define buffer buf_inv-line for ub.inv-line .
     4562     do
     4563     on error undo, return error
     4564     :
     4565       for each buf_doc-line no-lock where
     4566                buf_doc-line.obj-type    = p-obj-type   and
     4567                buf_doc-line.obj-code    = p-obj-code   and
     4568                buf_doc-line.prod-type   = p-prod-type  and
     4569                buf_doc-line.prod-code   = p-prod-code  and
     4570                buf_doc-line.artic       = p-artic      and
     4571                buf_doc-line.status_     = 'факт':U      and
     4572                buf_doc-line.fact-order <= p-fact-order
     4573             by buf_doc-line.fact-order    descending
     4574       :
     4575         find first buf_inv-line no-lock where
     4576                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4577                    buf_inv-line.artic     = buf_doc-line.artic     and
     4578                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4579                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4580         if available buf_inv-line
     4581         then do:
     4582           if buf_inv-line.after-cli-qnty <> ?
     4583           then do:
     4584             assign
     4585               p-quantity-kg = buf_inv-line.after-cli-qnty
     4586             .
     4587             leave .
     4588           end.
     4589         end.
     4590       end.
     4591       if p-quantity-kg = ?
     4592       then do:
     4593         assign
     4594           p-quantity-kg = 0
     4595         .
     4596       end.
     4597     end.
     4598   end procedure.
     4599   PROCEDURE ostatok :
     4600   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4601   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4602   def input parameter x-tog-shift   as   logical             no-undo.
     4603   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4604   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4605   def input parameter x-shift-start as integer               no-undo.
     4606   def input parameter x-shift-end   as integer               no-undo.
     4607   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4608   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4609   def input parameter xTog-obj   as log no-undo.
     4610   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4611   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4612   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4613   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4614   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4615   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4616   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4617   def var              Fact-orderS   as char  no-undo.
     4618   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4619      Assign
     4620         Fact-order   = 0
     4621         Quantity     = 0
     4622         Coast_R      = 0
     4623         Coast_V      = 0
     4624         VAT_R        = 0
     4625         VAT_V        = 0 .
     4626    x-date-start-t  = x-date-start + 1 .
     4627   IF x-date-end = date('') then DO:
     4628      Fact-order = 0 .
     4629      for each obj-list
     4630          where  ( not xtog-obj or
     4631                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4632                 no-lock :
     4633         if  x-tog-shift = false then do:
     4634                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4635                               ub.stk-tot.Fact-date <=  x-date-start
     4636                               and ub.stk-tot.shift-num = 0
     4637                               USE-INDEX fact-date no-lock no-error .
     4638              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4639         End.
     4640         Else  DO :
     4641             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4642              (ub.stk-tot.shift-date  = x-date-start-t and
     4643               ub.stk-tot.shift-num  < x-shift-start or
     4644               ub.stk-tot.shift-date  < x-date-start-t  )
     4645               and ub.stk-tot.shift-num  > 0
     4646               USE-INDEX Shift-num no-lock no-error .
     4647            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4648           END.
     4649       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4650     End.
     4651   End.
     4652   Else DO:
     4653     For each obj-list  WHERE
     4654        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4655         no-lock :
     4656      IF  x-TOG-Shift = False Then DO:
     4657          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4658               ub.stk-tot.Fact-date <= x-date-end
     4659               and ub.stk-tot.shift-num = 0
     4660               USE-INDEX fact-date no-lock no-error.
     4661          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4662      END.
     4663      Else DO:
     4664           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4665               (ub.stk-tot.shift-date  = x-date-end and
     4666               ub.stk-tot.shift-num  <= x-shift-end or
     4667               ub.stk-tot.shift-date  < x-date-end       ) and
     4668               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4669               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4670       End.
     4671       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4672     End.
     4673   End.
     4674   END PROCEDURE.
     4675   procedure report-exec1  :
     4676      find first clients where x-store-type = clients.obj-type and
     4677                               x-store-code = clients.obj-code
     4678                               no-lock no-error.
     4679              if available clients then assign  objname = clients.obj-name
     4680                                                x-db-num     = clients.db-num.
     4681                                            else  objname="объект не определен".
     4682     run calcitog in this-procedure .
     4683     run print-header in this-procedure .      case retclassify :
     4684      when "grp-goods":u      then  run run2 in this-procedure .
     4685      otherwise do:
     4686        message "Ошибка вызова" view-as alert-box error .
     4687      end.
     4688      end case.
     4689     run print-footer in this-procedure .
     4690     end procedure.
     4691   procedure calc-sub-itog :
     4692   define input parameter tt as int no-undo.
     4693   define variable tt2 as integer no-undo .
     4694     if tt = 6 then tt2 = 7 .
     4695               else tt2 = tt.
     4696   repeat i# = 1 + tt to 3 + tt2 :
     4697   run sum-i (
     4698    input oborot-vt[i#]
     4699   ,input tt
     4700   ,input-output b1-oborot-vt[i#]
     4701   ,input-output b2-oborot-vt[i#]
     4702   ,input-output bi-oborot-vt[i#]
     4703   ,input-output bo-oborot-vt[i#]
     4704   ,input oborot-ie[i#]
     4705   ,input-output b1-oborot-ie[i#]
     4706   ,input-output b2-oborot-ie[i#]
     4707   ,input-output bi-oborot-ie[i#]
     4708   ,input-output bo-oborot-ie[i#]
     4709   ) .
     4710   run sum-i (
     4711    input oborot-iv[i#]
     4712   ,input tt
     4713   ,input-output b1-oborot-iv[i#]
     4714   ,input-output b2-oborot-iv[i#]
     4715   ,input-output bi-oborot-iv[i#]
     4716   ,input-output bo-oborot-iv[i#]
     4717   ,input oborot-ee[i#]
     4718   ,input-output b1-oborot-ee[i#]
     4719   ,input-output b2-oborot-ee[i#]
     4720   ,input-output bi-oborot-ee[i#]
     4721   ,input-output bo-oborot-ee[i#]
     4722   ) .
     4723   run sum-i (
     4724    input oborot-ev[i#]
     4725   ,input tt
     4726   ,input-output b1-oborot-ev[i#]
     4727   ,input-output b2-oborot-ev[i#]
     4728   ,input-output bi-oborot-ev[i#]
     4729   ,input-output bo-oborot-ev[i#]
     4730   ,input oborot-ep[i#]
     4731   ,input-output b1-oborot-ep[i#]
     4732   ,input-output b2-oborot-ep[i#]
     4733   ,input-output bi-oborot-ep[i#]
     4734   ,input-output bo-oborot-ep[i#]
     4735   ) .
     4736   run sum-i (
     4737    input oborot-rv[i#]
     4738   ,input tt
     4739   ,input-output b1-oborot-rv[i#]
     4740   ,input-output b2-oborot-rv[i#]
     4741   ,input-output bi-oborot-rv[i#]
     4742   ,input-output bo-oborot-rv[i#]
     4743   ,input oborot-es[i#]
     4744   ,input-output b1-oborot-es[i#]
     4745   ,input-output b2-oborot-es[i#]
     4746   ,input-output bi-oborot-es[i#]
     4747   ,input-output bo-oborot-es[i#]
     4748   ) .
     4749   run sum-i (
     4750    input oborot-em[i#]
     4751   ,input tt
     4752   ,input-output b1-oborot-em[i#]
     4753   ,input-output b2-oborot-em[i#]
     4754   ,input-output bi-oborot-em[i#]
     4755   ,input-output bo-oborot-em[i#]
     4756   ,input oborot-re[i#]
     4757   ,input-output b1-oborot-re[i#]
     4758   ,input-output b2-oborot-re[i#]
     4759   ,input-output bi-oborot-re[i#]
     4760   ,input-output bo-oborot-re[i#]
     4761   ) .
     4762   run sum-i (
     4763    input oborot-im[i#]
     4764   ,input tt
     4765   ,input-output b1-oborot-im[i#]
     4766   ,input-output b2-oborot-im[i#]
     4767   ,input-output bi-oborot-im[i#]
     4768   ,input-output bo-oborot-im[i#]
     4769   ,input oborot-rs[i#]
     4770   ,input-output b1-oborot-rs[i#]
     4771   ,input-output b2-oborot-rs[i#]
     4772   ,input-output bi-oborot-rs[i#]
     4773   ,input-output bo-oborot-rs[i#]
     4774   ) .
     4775   run sum-i (
     4776    input oborot-ot[i#]
     4777   ,input tt
     4778   ,input-output b1-oborot-ot[i#]
     4779   ,input-output b2-oborot-ot[i#]
     4780   ,input-output bi-oborot-ot[i#]
     4781   ,input-output bo-oborot-ot[i#]
     4782   ,input oborot-we[i#]
     4783   ,input-output b1-oborot-we[i#]
     4784   ,input-output b2-oborot-we[i#]
     4785   ,input-output bi-oborot-we[i#]
     4786   ,input-output bo-oborot-we[i#]
     4787   ) .
     4788   run sum-i (
     4789    input oborot-ap[i#]
     4790   ,input tt
     4791   ,input-output b1-oborot-ap[i#]
     4792   ,input-output b2-oborot-ap[i#]
     4793   ,input-output bi-oborot-ap[i#]
     4794   ,input-output bo-oborot-ap[i#]
     4795   ,input oborot-pc[i#]
     4796   ,input-output b1-oborot-pc[i#]
     4797   ,input-output b2-oborot-pc[i#]
     4798   ,input-output bi-oborot-pc[i#]
     4799   ,input-output bo-oborot-pc[i#]
     4800   ) .
     4801     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4802     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4803     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4804     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4805     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4806     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4807     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4808     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4809     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4810     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4811     if i# = 8 then
     4812       assign
     4813         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4814                                 bi-oborot-re[ i#]         +
     4815                                 bi-oborot-rs[ i#]    +
     4816                                 bi-oborot-es[ i#]
     4817         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4818                                 b1-oborot-re[ i#]         +
     4819                                 b1-oborot-rs[ i#]    +
     4820                                 b1-oborot-es[ i#]
     4821         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4822                                 b2-oborot-re[ i#]         +
     4823                                 b2-oborot-rs[ i#]    +
     4824                                 b2-oborot-es[ i#]
     4825         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4826                                 bo-oborot-re[ i#]         +
     4827                                 bo-oborot-rs[ i#]    +
     4828                                 bo-oborot-es[ i#]
     4829         .
     4830     if  xshowmediator = true  then do:
     4831         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4832         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4833         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4834         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4835     end.
     4836     if i# = 2 and xshowmediator = false  then
     4837         assign
     4838           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4839                                   bi-oborot-re[ i#]         +
     4840                                   bi-oborot-rs[ i#]    +
     4841                                   bi-oborot-es[ i#]
     4842           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4843                                   b1-oborot-re[ i#]         +
     4844                                   b1-oborot-rs[ i#]    +
     4845                                   b1-oborot-es[ i#]
     4846           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4847                                   b2-oborot-re[ i#]         +
     4848                                   b2-oborot-rs[ i#]    +
     4849                                   b2-oborot-es[ i#]
     4850           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4851                                   bo-oborot-re[ i#]         +
     4852                                   bo-oborot-rs[ i#]    +
     4853                                   bo-oborot-es[ i#]
     4854           .
     4855     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4856     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4857     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4858     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4859     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4860                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4861                      else bi-oborot-prc[1] = 0.
     4862     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4863                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4864                      else bo-oborot-prc[1] = 0.
     4865     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4866                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4867                      else b1-oborot-prc[1] = 0.
     4868     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4869                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4870                      else b2-oborot-prc[1] = 0.
     4871    end.
     4872   end procedure.
     4873   procedure sum-i :
     4874   define input parameter ob like oborot-ot[1] no-undo.
     4875   define input parameter tt as int  no-undo.
     4876   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4877   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4878   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4879   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4880   define input parameter ob2 like oborot-ot[1] no-undo.
     4881   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4882   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4883   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4884   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4885   assign
     4886    b1  = b1 + ob
     4887    b2  = b2 + ob
     4888    b1- = b1- + ob2
     4889    b2- = b2- + ob2
     4890    .
     4891       assign
     4892       bi = bi + ob
     4893       bo = bo + ob
     4894       bi- = bi- + ob2
     4895       bo- = bo- + ob2
     4896       .
     4897   end procedure.
     4898   procedure clear-item :
