     3845   procedure display-b2  :
     3846   define variable ll as int no-undo.
     3847   define variable kk as int no-undo.
     3848   b2-null-str#  = 1 .
     3849   b2-null-str2# = 1 .
     3850     if not show-negativ   then  run b2-null-str-pr   in this-procedure .
     3851     if not show-negativ-2 then  run b2-null-str-pr2  in this-procedure .
     3852      if not  (not show-negativ   and b2-null-str#  = 0  ) then do :
     3853         if not  (not show-negativ-2 and b2-null-str2# = 0  ) then do :
     3854   assign
     3855     num#str# = num#str# + 1
     3856     num#col# = 1.
     3857     run macr_excel_char_with_format( string( s-bar-code + ' ' + gds-zap-artic + ' ' + gds-zap-gds-name)  , num#str# , num#col#  ) .
     3858     num#col#  = 0 .
     3859     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3860     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3861     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3862     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3863     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3864     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3865   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3866   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3867   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3868   def var l-nk as integer no-undo .
     3869     Assign
     3870       LL = 0
     3871       KK = 1
     3872     .
     3873     if xShowCost      Then DO: KK = KK + 1. End.
     3874     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3875     if xShowCrsa      Then DO: KK = KK + 1. End.
     3876     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3877     if xShowSale      Then DO: KK = KK + 1. End.
     3878     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3879     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3880     if xShowmediator  Then DO: KK = KK + 1. End.
     3881     if x-tog-wt       then do: KK = KK + 1. End.
     3882     if x-tog-ms       then do: KK = KK + 1. End.
     3883     if xDens          then do: KK = KK + 1. End.
     3884     repeat i = 1 to 13 :
     3885       if i = 7 then next.
     3886       if NOT xShowCost      and i = 2   Then  next.
     3887       if NOT xShowCostNDS   and i = 3   Then  next.
     3888       if NOT xShowCrsa      and i = 5   Then  next.
     3889       if NOT xShowCrsaNds   and i = 6   Then  next.
     3890       if NOT xShowSale      and i = 8   Then  next.
     3891       if NOT xShowSaleNds   and i = 9   Then  next.
     3892       if NOT xShowSaleSlt   and i = 10  Then  next.
     3893       if NOT xShowmediator  and i = 4   Then  next.
     3894       if not x-tog-wt       and i = 11  then  next.
     3895       if not x-tog-ms       and i = 12  then  next.
     3896       if not xDens          and i = 13  then  next.
     3897       assign
     3898         LL = LL + 1
     3899         l-nk = mp-1
     3900       .
     3901     if x-vat or i <> 2  then do:
     3902     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-ostatok-start                          [i] ,  i). end.
     3903     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ie          [i] ,  i). end.
     3904     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-iv          [i] ,  i). end.
     3905     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-im           [i] ,  i). end.
     3906     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ee          [i] ,  i). end.
     3907     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ev          [i] ,  i). end.
     3908     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-em           [i] ,  i). end.
     3909     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-we          [i] ,  i). end.
     3910     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-es     [i] ,  i). end.
     3911     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-rs [i] ,  i). end.
     3912     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-re      [i] ,  i). end.
     3913     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ep       [i] ,  i). end.
     3914     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-rv      [i] ,  i). end.
     3915     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-vt                [i] ,  i). end.
     3916     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ot           [i] ,  i). end.
     3917     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-ostatok-end                            [i] ,  i). end.
     3918     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ap [i] ,  i). end.
     3919     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-pc [i] ,  i). end.
     3920     if i = 13 then do:
     3921       if "b2-" = "b1-" or "b2-" = "b2-" or "b2-" = "bi-" or "b2-" = "bo-" then do:
     3922          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3923       end.
     3924       else do:
     3925         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(b2-oborot-ee         [1] +
     3926                                                                                                                                       b2-oborot-re     [1] +
     3927                                                                                                                                       b2-oborot-es    [1] +
     3928                                                                                                                                       b2-oborot-rs[1] ) <> 0
     3929                                                                                                                               then
     3930                                                                                                                                   ABS(b2-oborot-ee         [11] +
     3931                                                                                                                                       b2-oborot-re     [11] +
     3932                                                                                                                                       b2-oborot-es    [11] +
     3933                                                                                                                                       b2-oborot-rs[11] )
     3934                                                                                                                                   /
     3935                                                                                                                                   ABS(b2-oborot-ee         [1] +
     3936                                                                                                                                       b2-oborot-re     [1] +
     3937                                                                                                                                       b2-oborot-es    [1] +
     3938                                                                                                                                       b2-oborot-rs[1] )
     3939                                                                                                                               else 0 )
     3940         ,  i). end.
     3941       end.
     3942     end.
     3943     else do:
     3944     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (b2-oborot-ee         [i] +
     3945                                                                                                                           b2-oborot-re     [i] +
     3946                                                                                                                           b2-oborot-es    [i] +
     3947                                                                                                                           b2-oborot-rs[i] )
     3948     ,  i). end.
     3949     end.
     3950     end.
     3951     if x-vat = false  and i = 2 then do:
     3952     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-ostatok-start                          [i] -  b2-ostatok-start                          [3] ),  i). end.
     3953     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ie          [i] -  b2-oborot-ie          [3] ),  i). end.
     3954     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-iv          [i] -  b2-oborot-iv          [3] ),  i). end.
     3955     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-im           [i] -  b2-oborot-im           [3] ),  i). end.
     3956     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ee          [i] -  b2-oborot-ee          [3] ),  i). end.
     3957     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ev          [i] -  b2-oborot-ev          [3] ),  i). end.
     3958     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-em           [i] -  b2-oborot-em           [3] ),  i). end.
     3959     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-we          [i] -  b2-oborot-we          [3] ),  i). end.
     3960     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-es     [i] -  b2-oborot-es     [3] ),  i). end.
     3961     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-rs [i] -  b2-oborot-rs [3] ),  i). end.
     3962     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-re      [i] -  b2-oborot-re      [3] ),  i). end.
     3963     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ep       [i] -  b2-oborot-ep       [3] ),  i). end.
     3964     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-rv      [i] -  b2-oborot-rv      [3] ),  i). end.
     3965     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-vt                [i] -  b2-oborot-vt                [3] ),  i). end.
