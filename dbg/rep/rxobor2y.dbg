     3375   procedure display-bi  :
     3376   define variable ll as int no-undo.
     3377   define variable kk as int no-undo.
     3378     num#col#  = 0 .
     3379     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3380     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3381     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3382     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3383     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3384     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3385     run macr_cell_format
     3386                                 ( 10    ,
     3387                                   true  ,
     3388                                   false ,
     3389                                   ?    ,
     3390                                   num#str# ,
     3391                                   1 ,
     3392                                   num#str# ,
     3393                                   (mp + ll + (kk * (27 - 8)))
     3394                                   ) .
     3395   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3396   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3397   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3398   def var l-nk as integer no-undo .
     3399     Assign
     3400       LL = 0
     3401       KK = 1
     3402     .
     3403     if xShowCost      Then DO: KK = KK + 1. End.
     3404     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3405     if xShowCrsa      Then DO: KK = KK + 1. End.
     3406     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3407     if xShowSale      Then DO: KK = KK + 1. End.
     3408     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3409     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3410     if xShowmediator  Then DO: KK = KK + 1. End.
     3411     if x-tog-wt       then do: KK = KK + 1. End.
     3412     if x-tog-ms       then do: KK = KK + 1. End.
     3413     if xDens          then do: KK = KK + 1. End.
     3414     repeat i = 1 to 13 :
     3415       if i = 7 then next.
     3416       if NOT xShowCost      and i = 2   Then  next.
     3417       if NOT xShowCostNDS   and i = 3   Then  next.
     3418       if NOT xShowCrsa      and i = 5   Then  next.
     3419       if NOT xShowCrsaNds   and i = 6   Then  next.
     3420       if NOT xShowSale      and i = 8   Then  next.
     3421       if NOT xShowSaleNds   and i = 9   Then  next.
     3422       if NOT xShowSaleSlt   and i = 10  Then  next.
     3423       if NOT xShowmediator  and i = 4   Then  next.
     3424       if not x-tog-wt       and i = 11  then  next.
     3425       if not x-tog-ms       and i = 12  then  next.
     3426       if not xDens          and i = 13  then  next.
     3427       assign
     3428         LL = LL + 1
     3429         l-nk = mp-1
     3430       .
     3431     if x-vat or i <> 2  then do:
     3432     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-start                          [i] ,  i). end.
     3433     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ie          [i] ,  i). end.
     3434     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-iv          [i] ,  i). end.
     3435     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-im           [i] ,  i). end.
     3436     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ee          [i] ,  i). end.
     3437     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ev          [i] ,  i). end.
     3438     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-em           [i] ,  i). end.
