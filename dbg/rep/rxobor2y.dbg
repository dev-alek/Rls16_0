     3664   procedure display-b1  :
     3665   define variable ll as int no-undo.
     3666   define variable kk as int no-undo.
     3667     b1-null-str# = 1.
     3668     b1-null-str2# = 1.
     3669     if not show-negativ   then  run b1-null-str-pr   in this-procedure .
     3670     if not show-negativ-2 then  run b1-null-str-pr2  in this-procedure .
     3671      if not     ( not show-negativ   and b1-null-str#  = 0  ) then do :
     3672         if not  ( not show-negativ-2 and b1-null-str2# = 0  ) then do :
     3673                 if sums-only then do:
     3674                     if fr0 = true then do:
     3675                           num#str# = num#str# + 1     .
     3676                           num#col# = 1.
     3677                           run macr_excel_char_with_format(  caps(tmp#stroka0)  , num#str# , num#col#  ) .
     3678                           run macr_cell_format
     3679                           ( 10    ,
     3680                             true  ,
     3681                             true  ,
     3682                             36    ,
     3683                             num#str# ,
     3684                             num#col# ,
     3685                             num#str# ,
     3686                             5 ) .
     3687                         fr0 = false .
     3688                       end.
     3689                  end.
     3690     num#str# = num#str# + 1     .
     3691     num#col# = 2 .
     3692     if substitute( "&1", sf1:screen-value )  <> "?" then
     3693       run macr_excel_char_with_format(  string(s-bar-code +
     3694                                    sf1:screen-value +
     3695                                    gds-zap-artic +
     3696                                    sf2:screen-value +
     3697                                    gds-zap-gds-name +
     3698                                    temp-str-2    )  , num#str# , num#col#  ) .
     3699      else
     3700       run macr_excel_char_with_format(  string(s-bar-code +
     3701                                    gds-zap-artic +
     3702                                    gds-zap-gds-name +
     3703                                    temp-str-2    )  , num#str# , num#col#  ) .
     3704     num#col#  = 0 .
     3705     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3706     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3707     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3708     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3709     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3710     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3711   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3712   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3713   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3714   def var l-nk as integer no-undo .
     3715     Assign
     3716       LL = 0
     3717       KK = 1
     3718     .
     3719     if xShowCost      Then DO: KK = KK + 1. End.
     3720     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3721     if xShowCrsa      Then DO: KK = KK + 1. End.
     3722     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3723     if xShowSale      Then DO: KK = KK + 1. End.
