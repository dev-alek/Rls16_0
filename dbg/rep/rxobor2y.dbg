     5237   procedure ex-display :
     5238   define input parameter par-1 as int no-undo.
     5239   define input parameter par-2 like  ostatok-start[1] no-undo.
     5240   define input parameter par-i as int no-undo.
     5241     assign num#col#  = par-1.
     5242     if par-i = 13 then do:
     5243       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     5244     end.
     5245     else do:
     5246       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     5247         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     5248       end.
     5249       else do :
     5250         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     5251       end.
     5252     end.
     5253   end procedure.
