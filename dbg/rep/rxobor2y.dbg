     3204   procedure calcitog :
     3205       run ostatok  in this-procedure (
     3206           input x-store-code  ,
     3207           input x-store-type  , x-tog-shift ,
     3208           input x-date-start - 1 ,
     3209           input date('')      , x-Shift-Start,x-Shift-End,
     3210           input 'crsa':U   ,
     3211           input '##,##':U,
     3212           input xtog-obj ,
     3213           output  quantity1  ,
     3214           output  coast_r1   ,
     3215           output  coast_v1   ,
     3216           output  vat_r1     ,
     3217           output  vat_v1     ,
     3218           output  fact-order-1 ).
     3219       run ostatok  in this-procedure (
     3220           input x-store-code  ,
     3221           input x-store-type  , x-tog-shift ,
     3222           input x-date-start  ,
     3223           input x-date-end    , x-Shift-Start,x-Shift-End,
     3224           input 'crsa':U   ,
     3225           input '##,##':U,
     3226           input xtog-obj ,
     3227           output  quantity1  ,
     3228           output  coast_r1   ,
     3229           output  coast_v1   ,
     3230           output  vat_r1     ,
     3231           output  vat_v1     ,
     3232           output  fact-order-2 ).
     3233             quantity1  = 0.
     3234             coast_r1   = 0.
     3235             coast_v1   = 0.
     3236             vat_r1     = 0.
     3237             vat_v1     = 0.
     3238   end procedure.
     3239   procedure display-str1  :
     3240   define variable ll as int no-undo.
     3241     assign
     3242       num#str# = num#str# + 1
     3243       num#col# = 0
     3244       v-gds-num = v-gds-num + 1
     3245     .
     3246     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     3247     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     3248     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     3249     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     3250     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     3251     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     3252   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3253   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3254   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3255   def var l-nk as integer no-undo .
     3256     Assign
     3257       LL = 0
     3258       KK = 1
     3259     .
     3260     if xShowCost      Then DO: KK = KK + 1. End.
     3261     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3262     if xShowCrsa      Then DO: KK = KK + 1. End.
     3263     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3264     if xShowSale      Then DO: KK = KK + 1. End.
     3265     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3266     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3267     if xShowmediator  Then DO: KK = KK + 1. End.
     3268     if x-tog-wt       then do: KK = KK + 1. End.
     3269     if x-tog-ms       then do: KK = KK + 1. End.
     3270     if xDens          then do: KK = KK + 1. End.
     3271     repeat i = 1 to 13 :
     3272       if i = 7 then next.
     3273       if NOT xShowCost      and i = 2   Then  next.
     3274       if NOT xShowCostNDS   and i = 3   Then  next.
     3275       if NOT xShowCrsa      and i = 5   Then  next.
     3276       if NOT xShowCrsaNds   and i = 6   Then  next.
     3277       if NOT xShowSale      and i = 8   Then  next.
     3278       if NOT xShowSaleNds   and i = 9   Then  next.
     3279       if NOT xShowSaleSlt   and i = 10  Then  next.
     3280       if NOT xShowmediator  and i = 4   Then  next.
     3281       if not x-tog-wt       and i = 11  then  next.
     3282       if not x-tog-ms       and i = 12  then  next.
     3283       if not xDens          and i = 13  then  next.
     3284       assign
     3285         LL = LL + 1
     3286         l-nk = mp-1
     3287       .
     3288     if x-vat or i <> 2  then do:
     3289     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-start                          [i] ,  i). end.
     3290     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ie          [i] ,  i). end.
     3291     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-iv          [i] ,  i). end.
     3292     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-im           [i] ,  i). end.
     3293     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ee          [i] ,  i). end.
     3294     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ev          [i] ,  i). end.
     3295     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-em           [i] ,  i). end.
     3296     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-we          [i] ,  i). end.
     3297     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-es     [i] ,  i). end.
     3298     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rs [i] ,  i). end.
     3299     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-re      [i] ,  i). end.
     3300     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ep       [i] ,  i). end.
     3301     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rv      [i] ,  i). end.
     3302     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-vt                [i] ,  i). end.
     3303     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ot           [i] ,  i). end.
     3304     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-end                            [i] ,  i). end.
     3305     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ap [i] ,  i). end.
     3306     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-pc [i] ,  i). end.
     3307     if i = 13 then do:
     3308       if "" = "b1-" or "" = "b2-" or "" = "bi-" or "" = "bo-" then do:
     3309          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3310       end.
     3311       else do:
     3312         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(oborot-ee         [1] +
     3313                                                                                                                                       oborot-re     [1] +
     3314                                                                                                                                       oborot-es    [1] +
     3315                                                                                                                                       oborot-rs[1] ) <> 0
     3316                                                                                                                               then
     3317                                                                                                                                   ABS(oborot-ee         [11] +
     3318                                                                                                                                       oborot-re     [11] +
     3319                                                                                                                                       oborot-es    [11] +
     3320                                                                                                                                       oborot-rs[11] )
     3321                                                                                                                                   /
     3322                                                                                                                                   ABS(oborot-ee         [1] +
     3323                                                                                                                                       oborot-re     [1] +
     3324                                                                                                                                       oborot-es    [1] +
     3325                                                                                                                                       oborot-rs[1] )
     3326                                                                                                                               else 0 )
     3327         ,  i). end.
     3328       end.
     3329     end.
     3330     else do:
     3331     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (oborot-ee         [i] +
     3332                                                                                                                           oborot-re     [i] +
     3333                                                                                                                           oborot-es    [i] +
     3334                                                                                                                           oborot-rs[i] )
     3335     ,  i). end.
     3336     end.
     3337     end.
     3338     if x-vat = false  and i = 2 then do:
     3339     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( ostatok-start                          [i] -  ostatok-start                          [3] ),  i). end.
     3340     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ie          [i] -  oborot-ie          [3] ),  i). end.
     3341     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-iv          [i] -  oborot-iv          [3] ),  i). end.
     3342     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-im           [i] -  oborot-im           [3] ),  i). end.
