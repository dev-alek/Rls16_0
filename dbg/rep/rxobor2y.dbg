     4927   procedure item-goods :
     4928    define input parameter  par-3 as char no-undo.
     4929    define input parameter  par-4 as char no-undo.
     4930        if par-4 = "goods":u  then  assign
     4931                                       gds-zap-unit-base  = goods.unit-base
     4932                                       gds-zap-prt-root   = goods.prt-root
     4933                                       gds-zap-prod-type  = goods.prod-type
     4934                                       gds-zap-prod-code  = goods.prod-code
     4935                                       gds-zap-artic      = goods.artic
     4936                                       gds-zap-type       = goods.gds-type
     4937                                       gds-zap-grp-name   = goods.grp-name
     4938                                       gds-zap-b-code     = goods.gds-code
     4939                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4940                                                                          else goods.gds-name
     4941                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4942                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4943        if par-4 = "gds-list":u  then  assign
     4944                                       gds-zap-unit-base  = gds-list.unit-base
     4945                                       gds-zap-prt-root   = gds-list.prt-root
     4946                                       gds-zap-prod-type  = gds-list.prod-type
     4947                                       gds-zap-prod-code  = gds-list.prod-code
     4948                                       gds-zap-artic      = gds-list.artic
     4949                                       gds-zap-type       = gds-list.gds-type
     4950                                       gds-zap-grp-name   = gds-list.grp-name
     4951                                       gds-zap-b-code     = gds-list.gds-code
     4952                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4953                                                                          else gds-list.gds-name
     4954                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4955                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4956       run foreach in this-procedure .
     4957   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4958     (input  gds-zap-b-code
     4959     ,input  ?
     4960     ,output v-bar-code
     4961     )  .
     4962   s-bar-code = string (v-bar-code,"999999999").
     4963       If  break_group = true  and par-3 <> "1"  then DO :
     4964            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4965            gds-zap-prod-name  = clients.obj-name.
     4966             If break_group1 = true  THEN  DO :
     4967               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4968                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4969                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4970               if par-3 = "6"  then  dO:
     4971                  if xTog-obj = true then do:
     4972                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4973                   end.
     4974                  else do:
     4975                   var-vat-pc = temp-gds-list.vat-pc  .
     4976                   end.
     4977                   assign
     4978                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4979                       b1-name = temp-str .
     4980                   end.
     4981               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4982                   fr0 = true .
     4983                   tmp#stroka0 = temp-str.
     4984               End .
     4985             End .
     4986             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4987               if par-3 = "4"
     4988                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4989                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4990               if NOT xSumsOnly THEN DO :
     4991               fr = true .
     4992               End.
     4993               break_group1 = false.
     4994             END.
     4995          break_group = false.
     4996       End.
     4997       run display-line in this-procedure .
     4998    end procedure.
