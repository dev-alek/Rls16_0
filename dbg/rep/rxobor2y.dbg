     5310    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5311       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     5312      num#str# = num#str# + 1.
