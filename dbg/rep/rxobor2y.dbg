     3440     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-es     [i] ,  i). end.
     3441     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-rs [i] ,  i). end.
     3442     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-re      [i] ,  i). end.
     3443     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ep       [i] ,  i). end.
     3444     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-rv      [i] ,  i). end.
     3445     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-vt                [i] ,  i). end.
     3446     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ot           [i] ,  i). end.
     3447     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-end                            [i] ,  i). end.
     3448     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ap [i] ,  i). end.
     3449     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-pc [i] ,  i). end.
     3450     if i = 13 then do:
     3451       if "bi-" = "b1-" or "bi-" = "b2-" or "bi-" = "bi-" or "bi-" = "bo-" then do:
     3452          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3453       end.
     3454       else do:
     3455         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bi-oborot-ee         [1] +
     3456                                                                                                                                       bi-oborot-re     [1] +
     3457                                                                                                                                       bi-oborot-es    [1] +
     3458                                                                                                                                       bi-oborot-rs[1] ) <> 0
     3459                                                                                                                               then
     3460                                                                                                                                   ABS(bi-oborot-ee         [11] +
     3461                                                                                                                                       bi-oborot-re     [11] +
     3462                                                                                                                                       bi-oborot-es    [11] +
     3463                                                                                                                                       bi-oborot-rs[11] )
     3464                                                                                                                                   /
     3465                                                                                                                                   ABS(bi-oborot-ee         [1] +
     3466                                                                                                                                       bi-oborot-re     [1] +
     3467                                                                                                                                       bi-oborot-es    [1] +
     3468                                                                                                                                       bi-oborot-rs[1] )
     3469                                                                                                                               else 0 )
     3470         ,  i). end.
     3471       end.
     3472     end.
     3473     else do:
     3474     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bi-oborot-ee         [i] +
     3475                                                                                                                           bi-oborot-re     [i] +
     3476                                                                                                                           bi-oborot-es    [i] +
     3477                                                                                                                           bi-oborot-rs[i] )
     3478     ,  i). end.
     3479     end.
     3480     end.
     3481     if x-vat = false  and i = 2 then do:
     3482     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-ostatok-start                          [i] -  bi-ostatok-start                          [3] ),  i). end.
     3483     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ie          [i] -  bi-oborot-ie          [3] ),  i). end.
     3484     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-iv          [i] -  bi-oborot-iv          [3] ),  i). end.
     3485     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-im           [i] -  bi-oborot-im           [3] ),  i). end.
     3486     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ee          [i] -  bi-oborot-ee          [3] ),  i). end.
     3487     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ev          [i] -  bi-oborot-ev          [3] ),  i). end.
     3488     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-em           [i] -  bi-oborot-em           [3] ),  i). end.
     3489     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-we          [i] -  bi-oborot-we          [3] ),  i). end.
     3490     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-es     [i] -  bi-oborot-es     [3] ),  i). end.
     3491     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-rs [i] -  bi-oborot-rs [3] ),  i). end.
     3492     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-re      [i] -  bi-oborot-re      [3] ),  i). end.
     3493     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ep       [i] -  bi-oborot-ep       [3] ),  i). end.
     3494     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-rv      [i] -  bi-oborot-rv      [3] ),  i). end.
     3495     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-vt                [i] -  bi-oborot-vt                [3] ),  i). end.
     3496     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ot           [i] -  bi-oborot-ot           [3] ),  i). end.
