      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   def var State-source as  WIDGET-HANDLE.
      679   define variable g#log  as logical   no-undo .
      680   DEFINE BUTTON BUTTON-1
      681        LABEL "Button 1"
      682        SIZE 15 BY 1.13.
      683   DEFINE VARIABLE Classify AS CHARACTER
      684        VIEW-AS RADIO-SET VERTICAL
      685        RADIO-BUTTONS
      686             "Без классификации", "no-classify":U,
      687   "Производители", "prod":U,
      688   "Группы товаров", "grp-goods":U,
      689   "Производители/Группы товаров", "prod/grp-goods":U,
      690   "Группы товаров/Производители", "grp-goods/prod":U,
      691   "Поставщики", "post":U,
      692   "Поставщики/Группы товаров", "post/grp-goods":U,
      693   "Группы товаров/Поставщики", "grp-goods/post":U,
      694   "НДС", "vat-pc":U
      695        SIZE 30.5 BY 9 NO-UNDO.
      696   DEFINE VARIABLE SortType AS CHARACTER
      697        VIEW-AS RADIO-SET VERTICAL
      698        RADIO-BUTTONS
      699             "по коду", "sort-code":U,
      700   "по артикулу", "sort-artic":U,
      701   "по наименов.", "sort-name":U
      702        SIZE 14 BY 2.75 NO-UNDO.
      703   DEFINE RECTANGLE RECT-5
      704        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      705        SIZE 32.25 BY 11.88.
      706   DEFINE RECTANGLE RECT-6
      707        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      708        SIZE 16.13 BY 5.
      709   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
      710        LABEL "Показывать нулевые остатки":L
      711        VIEW-AS TOGGLE-BOX
      712        SIZE 31.13 BY 1.13 NO-UNDO.
      713   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      714        LABEL "Только итоги":L
      715        VIEW-AS TOGGLE-BOX
      716        SIZE 16 BY 1 NO-UNDO.
      717   DEFINE VARIABLE Tog-obj AS LOGICAL INITIAL yes
      718        LABEL "Раздельно по объектам":L
      719        VIEW-AS TOGGLE-BOX
      720        SIZE 26.75 BY 1
      721        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      722   DEFINE FRAME F-Main
      723        Tog-obj AT ROW 2 COL 2.75
      724        SortType AT ROW 2.71 COL 35.38 NO-LABEL
      725        Classify AT ROW 3.63 COL 2.25 NO-LABEL
      726        SumsOnly AT ROW 12.96 COL 2.25
      727        BUTTON-1 AT ROW 13 COL 36
      728        ShowZero AT ROW 13.88 COL 2.25
      729        "Классификация :" VIEW-AS TEXT
      730             SIZE 15 BY .75 AT ROW 1.33 COL 9.5
      731             FGCOLOR 4
      732        "Сортировка :" VIEW-AS TEXT
      733             SIZE 11.5 BY .75 AT ROW 1.46 COL 36.88
      734             FGCOLOR 4
      735        RECT-5 AT ROW 1.13 COL 1.63
      736        RECT-6 AT ROW 1.13 COL 34.25
      737       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      738            SIDE-LABELS NO-UNDERLINE THREE-D
      739            AT COL 1 ROW 1 SCROLLABLE
      740            BGCOLOR 8 FGCOLOR 0 .
      741   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      742   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      743   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      744   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      745   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      746   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      747   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      748   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      749         adm-object-hdl = FRAME F-Main:HANDLE.
      750   RUN ensure-broker.
      751   THIS-PROCEDURE:ADM-DATA =
      752        'ADM1.1~`':U +
      753        'SmartObject~`':U +
      754        '~`':U +
      755        'NO ~`':U +
      756        '~`':U +
      757        '~`':U +
      758        '~`':U +
      759        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      760           + "~`":U +
      761        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      762        'Record-Source,Record-Target,TableIO-Target~`':U +
      763        '~`':U +
      764        '~`~`~`~`~`~`~`~`~`~`~`':U +
      765        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      766            THEN "^^":U
      767        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      768             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      769   PROCEDURE adm-apply-entry :
      770     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      771   END PROCEDURE.
      772   PROCEDURE adm-destroy :
      773    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      774   END PROCEDURE.
      775   PROCEDURE adm-disable :
      776       DISABLE RECT-5 RECT-6 Tog-obj SortType Classify ShowZero WITH FRAME F-Main.
      777       RUN dispatch ('disable-fields':U).
      778       RUN set-attribute-list ('ENABLED=no':U).
      779       RETURN.
      780   END PROCEDURE.
      781   PROCEDURE adm-edit-attribute-list :
      782         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      783         RETURN.
      784   END PROCEDURE.
      785   PROCEDURE adm-enable :
      786       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 Tog-obj SortType Classify ShowZero WITH FRAME F-Main.
      787       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      788       RUN set-attribute-list ('ENABLED=yes':U).
      789       RETURN.
      790   END PROCEDURE.
      791   PROCEDURE adm-exit :
      792        RUN notify ('exit':U).
      793     RETURN.
      794   END PROCEDURE.
      795   PROCEDURE adm-hide :
      796     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      797   END PROCEDURE.
      798   PROCEDURE adm-initialize :
      799     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      800   END PROCEDURE.
      801   PROCEDURE adm-show-errors :
      802       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      803       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      804           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      805       END.
      806       RETURN.
      807   END PROCEDURE.
      808   PROCEDURE adm-UIB-mode :
      809     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      810   END PROCEDURE.
      811   PROCEDURE adm-view :
      812     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      813   END PROCEDURE.
      814   PROCEDURE dispatch :
      815       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      816       RUN broker-dispatch IN adm-broker-hdl
      817           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      818       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      819   END PROCEDURE.
      820   PROCEDURE ensure-broker :
      821   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      822   IF RETURN-VALUE NE "ADM-Broker":U THEN
      823   DO:
      824       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      825       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      826   END.
      827   END PROCEDURE.
      828   PROCEDURE get-attribute :
      829     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      830     RUN broker-get-attribute IN adm-broker-hdl
      831         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      832     RETURN RETURN-VALUE.
      833   END PROCEDURE.
      834   PROCEDURE get-attribute-list :
      835     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      836     RUN broker-get-attribute-list IN adm-broker-hdl
      837         (INPUT THIS-PROCEDURE,
      838          INPUT ?,
      839          OUTPUT p-attr-list) NO-ERROR.
      840     RETURN.
      841   END PROCEDURE.
      842   PROCEDURE new-state :
      843     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      844     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      845     RETURN.
      846   END PROCEDURE.
      847   PROCEDURE notify :
      848     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      849     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      850     IF RETURN-VALUE = "ADM-ERROR":U THEN
      851         RETURN "ADM-ERROR":U.
      852     RETURN.
      853   END PROCEDURE.
      854   PROCEDURE set-attribute-list :
      855     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      856     RUN ensure-broker.
      857     RUN broker-set-attribute-list IN adm-broker-hdl
      858         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      859     RETURN.
      860   END PROCEDURE.
      861   PROCEDURE set-position :
      862       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      863       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      864       IF VALID-HANDLE(adm-object-hdl) THEN
      865       DO:
      866         ASSIGN adm-object-hdl:ROW    =   p-row
      867                adm-object-hdl:COLUMN =   p-col.
      868       END.
      869       RETURN.
      870   END PROCEDURE.
      871   PROCEDURE adm-display-fields :
      872       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      873       RETURN.
      874   END PROCEDURE.
      875   PROCEDURE adm-open-query :
      876     RETURN.
      877   END PROCEDURE.
      878   PROCEDURE adm-row-changed :
      879         IF VALID-HANDLE(adm-object-hdl) THEN
      880           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      881         RUN notify ('row-available':U).
      882         RETURN.
      883   END PROCEDURE.
      884   PROCEDURE reposition-query :
      885       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      886       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      887       RETURN.
      888   END PROCEDURE.
      889     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      890     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      891     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      892     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      893     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      894     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      895     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      896     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      897     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      898     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      899     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      900     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      901     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      902     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      903     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      904     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      905     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      906     IF "":U = "":U THEN
      907       RUN modify-list-attribute IN adm-broker-hdl
      908         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      909     RUN use-create-on-add(?).
      910   PROCEDURE adm-add-record :
      911       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      912          "must have at least one Enabled Table to perform Add.":U
      913          VIEW-AS ALERT-BOX ERROR.
      914       RETURN.
      915   END PROCEDURE.
      916   PROCEDURE adm-assign-record :
      917    MESSAGE
      918          "Object ":U THIS-PROCEDURE:FILE-NAME
      919            "must have at least one Enabled Table to perform Assign.":U
      920              VIEW-AS ALERT-BOX ERROR.
      921      RETURN.
      922     END PROCEDURE.
      923   PROCEDURE adm-assign-statement :
      924     RETURN.
      925   END PROCEDURE.
      926   PROCEDURE adm-cancel-record :
      927      RETURN.
      928     END PROCEDURE.
      929   PROCEDURE adm-copy-record :
      930       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      931        "must have at least one Enabled Table to perform Copy.":U
      932          VIEW-AS ALERT-BOX ERROR.
      933       RETURN.
      934   END PROCEDURE.
      935   PROCEDURE adm-create-record :
      936      RETURN.
      937   END PROCEDURE.
      938   PROCEDURE adm-current-changed :
      939     RETURN.
      940   END PROCEDURE.
      941   PROCEDURE adm-delete-record :
      942    MESSAGE
      943          "Object ":U THIS-PROCEDURE:FILE-NAME
      944            "must have at least one Enabled Table to perform Delete.":U
      945              VIEW-AS ALERT-BOX ERROR.
      946       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      947       RETURN.
      948   END PROCEDURE.
      949   PROCEDURE adm-disable-fields :
      950         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      951       RETURN.
      952   END PROCEDURE.
      953   PROCEDURE adm-enable-fields :
      954       RETURN.
      955   END PROCEDURE.
      956   PROCEDURE adm-end-update :
      957     RETURN.
      958   END PROCEDURE.
      959   PROCEDURE adm-reset-record :
      960       RETURN.
      961   END PROCEDURE.
      962   PROCEDURE adm-update-record :
      963       MESSAGE
      964         "Object ":U THIS-PROCEDURE:FILE-NAME
      965           "must have at least one Enabled Table to perform Update.":U
      966             VIEW-AS ALERT-BOX ERROR.
      967      RETURN.
      968   END PROCEDURE.
      969   PROCEDURE check-modified :
      970   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      971   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      972   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      973   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      974     IF check-state = "check":U THEN
      975     DO:
      976       RUN get-link-handle IN adm-broker-hdl
      977         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      978            OUTPUT group-target-list).
      979       IF group-target-list NE "":U THEN
      980       DO i = 1 TO NUM-ENTRIES(group-target-list):
      981         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      982         RUN check-modified IN curr-widget ('group-check':U).
      983         IF RETURN-VALUE NE "":U THEN
      984         DO:
      985           RUN check-modified-message(RETURN-VALUE).
      986           RETURN "":U.
      987         END.
      988       END.
      989     END.
      990     RETURN "":U.
      991   END PROCEDURE.
      992   PROCEDURE check-modified-message :
      993     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      994        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      995           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      996        IF RETURN-VALUE = "YES":U THEN
      997           RUN notify ('view,CONTAINER-SOURCE':U).
      998        MESSAGE IF p-changed-table NE ? THEN
      999           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1000           ELSE "Current values have been changed."
     1001           SKIP "  Do you wish to save those changes?"
     1002           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1003        IF ANS THEN
     1004        DO:
     1005           IF group-assign-target THEN
     1006             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1007           ELSE RUN dispatch('update-record':U).
     1008           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1009           DO:
     1010               MESSAGE "Changes to the previous record were not saved."
     1011                 VIEW-AS ALERT-BOX ERROR.
     1012               IF group-assign-target THEN
     1013                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1014               ELSE RUN dispatch ('cancel-record':U).
     1015           END.
     1016        END.
     1017        ELSE DO:
     1018          IF group-assign-target THEN
     1019             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1020          ELSE RUN dispatch('cancel-record':U).
     1021        END.
     1022        RETURN.
     1023   END PROCEDURE.
     1024   PROCEDURE get-rowid :
     1025       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1026       ASSIGN
     1027       p-table   =   adm-first-table.
     1028       RETURN.
     1029   END PROCEDURE.
     1030   PROCEDURE init-group-assign :
     1031       RUN request-attribute IN adm-broker-hdl
     1032         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1033       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1034         group-assign-target = yes.
     1035       ELSE group-assign-target = no.
     1036       RETURN.
     1037   END PROCEDURE.
     1038   PROCEDURE set-editors :
     1039       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1040       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1041       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1042       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1043       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1044       DO WHILE VALID-HANDLE (curr-widget):
     1045           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1046              curr-widget:HIDDEN = no THEN DO:
     1047             CASE p-field-setting:
     1048               WHEN "INITIALIZE":U THEN
     1049               DO:
     1050                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1051                     read-only-list +
     1052                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1053                        STRING(curr-widget).
     1054               END.
     1055               WHEN "DISABLE":U OR
     1056               WHEN "ENABLE":U THEN
     1057               DO:
     1058                   curr-widget:SENSITIVE = yes.
     1059                   RUN get-attribute ('Read-Only-Editors':U).
     1060                   IF RETURN-VALUE = ? OR
     1061                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1062                       curr-widget:READ-ONLY =
     1063                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1064               END.
     1065               WHEN "CLEAR":U THEN
     1066                   curr-widget:SCREEN-VALUE = "":U.
     1067             END CASE.
     1068           END.
     1069           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1070       END.
     1071       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1072         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1073           + '"':U).
     1074       RETURN.
     1075   END PROCEDURE.
     1076   PROCEDURE use-check-modified-all :
     1077    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1078     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1079     RETURN.
     1080   END PROCEDURE.
     1081   PROCEDURE use-create-on-add :
     1082   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1083      RETURN.
     1084   END PROCEDURE.
     1085   PROCEDURE use-initial-lock :
     1086     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1087     ASSIGN adm-initial-lock = p-attr-value.
     1088     RETURN.
     1089   END PROCEDURE.
     1090     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1091   ASSIGN
     1092          FRAME F-Main:SCROLLABLE       = FALSE
     1093          FRAME F-Main:HIDDEN           = TRUE.
     1094   ASSIGN
     1095          BUTTON-1:HIDDEN IN FRAME F-Main           = TRUE.
     1096   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1097   DO:
     1098       Assign Classify.
     1099       if Classify <>  "no-classify":U then enable SumsOnly with frame F-Main .
     1100       else  do:
     1101         SumsOnly = FALSE .
     1102         display SumsOnly with frame F-Main .
     1103         disable SumsOnly with frame F-Main .
     1104       end.
     1105   END.
     1106   if not this-procedure :persistent
     1107   then do:
     1108     message
     1109       vss-workfile vss-revision vss-description skip
     1110       "Ошибка при запуске процедуры" skip
     1111       "Данную процедуру следует запускать только с параметром persistent" skip
     1112       view-as alert-box error .
     1113     undo, return error .
     1114   end.
     1115   PROCEDURE disable_UI :
     1116     HIDE FRAME F-Main.
     1117     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1118   END PROCEDURE.
     1119   PROCEDURE my-report :
     1120   def var v-kol as integer no-undo .
     1121   v-kol = 0.
     1122   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1123   do:
     1124     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1125       (input  v-cntxt-db-num
     1126       ,input  v-cntxt-userid
     1127       ,input  0
     1128       ,input  'actn_reports_lookup-cost':U
     1129       ,input  'object':U
     1130       ,input  v-cntxt-host-code-obj
     1131       ,input  v-cntxt-obj-type
     1132       ,input  v-cntxt-obj-code
     1133       ,input  0
     1134       ,input  0
     1135       ,input  0
     1136       ,input  false
     1137       ,output g#log
     1138       )  .
     1139   end.
     1140    if not g#log then v-kol = v-kol + 1.
     1141   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1142   do:
     1143     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1144       (input  v-cntxt-db-num
     1145       ,input  v-cntxt-userid
     1146       ,input  0
     1147       ,input  'actn_reports_lookup-sale':U
     1148       ,input  'object':U
     1149       ,input  v-cntxt-host-code-obj
     1150       ,input  v-cntxt-obj-type
     1151       ,input  v-cntxt-obj-code
     1152       ,input  0
     1153       ,input  0
     1154       ,input  0
     1155       ,input  false
     1156       ,output g#log
     1157       )  .
     1158   end.
     1159    if not g#log then v-kol = v-kol + 1.
     1160    IF  v-kol >= 2  then DO:
     1161      Message "Отчет не может быть сформирован без указания цен. Но на просмотр цен у вас нет прав!             "  view-as alert-box .
     1162      return .
     1163    End.
     1164    assign sheetf.Excel-Column-Lable = ""  sheetf.Sizes = "" .
     1165    if use-column[1]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "№ п\п,"                   sheetf.Sizes = sheetf.Sizes +  "5," .
     1166    if use-column[2]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Код,"                     sheetf.Sizes = sheetf.Sizes +  "10," .
     1167    if use-column[3]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Артикул,"                 sheetf.Sizes = sheetf.Sizes +  "16," .
     1168    if use-column[4]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Название товара,"         sheetf.Sizes = sheetf.Sizes +  "40," .
     1169    if use-column[5]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Ед. изм,"                 sheetf.Sizes = sheetf.Sizes +  "3," .
     1170    if use-column[6]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Факт. кол-во,"            sheetf.Sizes = sheetf.Sizes +  "14," .
     1171    if use-column[7]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Своб. кол-во,"            sheetf.Sizes = sheetf.Sizes +  "14," .
     1172    if use-column[8]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Учет. цена с НДС,"        sheetf.Sizes = sheetf.Sizes +  "15," .
     1173    if use-column[9]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Продажная цена,"          sheetf.Sizes = sheetf.Sizes +  "15," .
     1174    if use-column[10]  = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Сумма в уч.ценах с НДС,"  sheetf.Sizes = sheetf.Sizes +  "15," .
     1175    if use-column[11]  = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Сумма наценки,"           sheetf.Sizes = sheetf.Sizes +  "15," .
     1176    if use-column[12]  = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "% наценки,"               sheetf.Sizes = sheetf.Sizes +  "9," .
     1177    if use-column[13]  = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Ожидаемое кол-во,"        sheetf.Sizes = sheetf.Sizes +  "13," .
     1178    if LENGTH( sheetf.Excel-Column-Lable ) > 0 then do:
     1179      substr ( sheetf.Excel-Column-Lable, LENGTH( sheetf.Excel-Column-Lable )) = "" .
     1180      substr ( sheetf.Sizes, LENGTH( sheetf.Sizes )) = "" .
     1181      run rep/r-zapasr.p (input base-type,input base-code,input Classify,input SortType,input SumsOnly,input ShowZero, input Tog-obj).
     1182    end.
     1183    else do:
     1184      run my-var.
     1185      return error "format-page".
     1186    end.
     1187   END PROCEDURE.
     1188   PROCEDURE my-var :
     1189   assign frame F-Main SumsOnly ShowZero  Classify SortType Tog-obj.
     1190   def var t-class as char no-undo.
     1191   def var t-sort as char no-undo.
     1192     case classify:
     1193       when "no-classify":u    then t-class =   "Без классификации" .
     1194       when "prod":u           then t-class =   "Производители"   .
     1195       when "post":u           then t-class =   "Поставщики"   .
     1196       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1197       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1198       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1199       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1200       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1201       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1202       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1203       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1204       when  "t-level":u       then t-class =   "Терминальные группы" .
     1205    end case.
     1206     case sorttype:
     1207       when "sort-pp":u               then t-sort =   "по порядку" .
     1208       when "sort-code":u             then t-sort =   "по коду" .
     1209       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1210       when "sort-qunty":u            then t-sort =   "по реализации".
     1211       when "sort-name":u             then t-sort =   "по наименованию".
     1212       when "sort-type":u             then t-sort =   "по типу ткани".
     1213       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1214       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1215    end case.
     1216   x-date-end = x-date-alone.
     1217   ReportNAme = "С О С Т О Я Н И Е    З А П А С А (с учетом резервов) на " + string(x-date-alone,"99/99/9999") .
     1218   ReportHeader = "Классификация : " + t-class + chr(10) +
     1219                  (if SumsOnly then ("Только итоги " + chr(10))  else "" )   +
     1220                 "Сортировка " + t-sort  + chr(10) +
     1221                  (if ShowZero then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) + chr(10) +
     1222                  "Цены указаны в " + (if x-SET_val_TYPE = 1 then "РУБ" else base-type )  .
     1223    sheetf.Excel-Column-Lable =
     1224             "№ п\п"
     1225     + ","  + "Код"
     1226     + ","  + "Артикул"
     1227     + ","  + "Название товара"
     1228     + ","  + "Ед. изм"
     1229     + ","  + "Факт. кол-во"
     1230     + ","  + "Своб. кол-во"
     1231     + ","  + "Учет. цена с НДС"
     1232     + ","  + "Продажная цена"
     1233     + ","  + "Сумма в уч.ценах с НДС"
     1234     + ","  + "Сумма наценки"
     1235     + ","  + "% наценки"
     1236     + ","  + "Ожидаемое кол-во"
     1237    .
     1238    sheetf.Sizes        =  "5,10,16,40,3,14,14,15,15,15,15,9,13" .
     1239    sheetf.ColFormat = "2=@;3=@;" .
     1240    Sheetf.make-correct = "true,true,true,true,true,true,true,true,true,true,true,true,true" .
     1241   END PROCEDURE.
