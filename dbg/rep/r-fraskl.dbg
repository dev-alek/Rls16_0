     1396   def buffer This_Object for  clients .
     1397   define variable qnty as decimal   no-undo .
     1398   define variable sum  as decimal   no-undo .
     1399   define variable num-ln as integer   no-undo .
     1400   define variable FullNameGds as character no-undo .
     1401   define variable gds-str as char no-undo.
     1402   define variable gds-str1 as char no-undo.
     1403   define variable gds-str2 as char no-undo.
     1404   define variable i as int no-undo.
     1405   define variable j as int no-undo.
     1406   define variable Counter1 as integer init 0  no-undo .
     1407   define variable LineBuf       as char    no-undo.
     1408   define variable Line       as char    no-undo.
     1409   define variable UndLine    as char    no-undo.
     1410   define variable     Lines_Counter as   int  init 0  no-undo.
     1411   define variable     Tmp_Counter   as   int  init 0  no-undo.
     1412   define variable     tdoc-date     like fbr-pln.doc-date no-undo.
     1413   define variable     tdoc-code     like fbr-pln.doc-code no-undo.
     1414   define variable  abbr              as  char no-undo.
