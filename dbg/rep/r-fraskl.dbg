     1432     .
     1433   define variable v-account as integer init 0 no-undo .
     1434   define variable v-account-lavel as character no-undo .
     1435   define variable v-button-stop as logical no-undo .
     1436   define variable v-kol-spice as integer no-undo .
     1437   define variable v-kol-spice2 as integer no-undo .
     1438   define variable v-kol-spice3 as integer no-undo .
     1439   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1440   DEFINE BUTTON StopBtn AUTO-END-KEY
     1441        LABEL "Стоп"
     1442        SIZE 10 BY 1.
     1443   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1444        LABEL "Обработано записей"
     1445         VIEW-AS TEXT
     1446        SIZE 14 BY .67 NO-UNDO.
     1447   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1448         VIEW-AS TEXT
     1449        SIZE 53.25 BY .67
     1450        FGCOLOR 1  NO-UNDO.
     1451   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1452         VIEW-AS TEXT
     1453        SIZE 53.25 BY .67
     1454        FGCOLOR 1  NO-UNDO.
     1455   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
