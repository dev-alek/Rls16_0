     1422   define variable sym4 as char  init ":"   no-undo.
     1423     if session:set-wait-state ("compiler") then.
     1424   output STREAM OutStream to value( string( session:temp-directory +
     1425                                        "rpt" + string( g#report-num ) ) )
     1426                                        page-size  value(ReportPageHeight) .
