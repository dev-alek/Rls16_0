     1459   DEFINE RECTANGLE RECT-1
     1460        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1461        SIZE 55.13 BY 4.46.
     1462   DEFINE FRAME InfoFrame
     1463        StopBtn AT ROW 4.25 COL 21.75
     1464        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1465        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1466        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1467        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1468        RECT-1 AT ROW 1 COL 1
     1469       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1470            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1471            TITLE "Процесс"
     1472            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1473   define variable mFrameView      as logical   no-undo init yes.
     1474     define variable mFramHandle as handle no-undo.
     1475     mFramHandle = frame InfoFrame:handle.
     1476     if  log-manager:logfile-name ne ?
     1477     then DO:
     1478         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1479         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1480         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1481     end.
     1482     mFrameView = not session:batch-mode and mFramHandle:visible.
     1483     if mFrameView
     1484     then do:
     1485       ASSIGN
     1486          FRAME InfoFrame:HIDDEN                           = TRUE
     1487          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1488     end.
     1489   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1490   DO:
     1491     IF not StopProcessing THEN
     1492       Message "Вы действительно хотите прервать" SKIP
     1493               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1494                 UPDATE StopProcessing.
     1495     IF StopProcessing THEN do:
     1496        if mFrameView
     1497        then do:
     1498           HIDE FRAME InfoFrame.
     1499        end.
     1500     End.
     1501   END.
     1502   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1503     if  log-manager:logfile-name ne ?
     1504     then DO:
     1505         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1506     end.
     1507     if not session:batch-mode then
     1508     do:
     1509       VIEW FRAME InfoFrame.
     1510       mFrameView = true.
     1511     end.
     1512      v-button-stop = false .
     1513         if mFrameView
     1514         then do:
     1515         if v-button-stop then view STOPBTN in frame InfoFrame.
     1516                          else Hide STOPBTN in frame InfoFrame.
     1517         end.
     1518   v-ind = 0    .
     1519   for each obj-list :
     1520       Output stream Macr_Excel  close .
     1521       num#str# = 0 .
     1522       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1523       output stream macr_excel to value (v-file-name)   .
     1524       v-ind = v-ind + 1.
     1525   for each temp-bl  : delete temp-bl.  end.
     1526   for each temp-ing : delete temp-ing. end.
     1527   for each temp-qnty : delete temp-qnty. end.
     1528   n-c = 0.
     1529     run make-tt.
     1530     find this_object  where this_object.obj-type = obj-list.obj-type and this_object.obj-code = obj-list.obj-code  no-lock .
     1531     find clients      where clients.obj-type     = 'орг':U            and clients.obj-code      = v-cntxt-host-code-obj no-lock .
     1532     run PrintTitul in this-procedure .
     1533     for each temp-bl no-lock break by temp-bl.id :
     1534         run print-line in this-procedure .
     1535     end.
     1536     run print-all-itog in this-procedure .
     1537     run on-same-page in this-procedure  (input 1) .
     1538     run PrintPodval in this-procedure .
     1539     run paramls-write in this-procedure
     1540        (input "file"
     1541       ,input string (v-ind) + obj-list.obj-name
     1542       ,input v-file-name
     1543       ) .
     1544   end.
     1545   output stream OutStream CLOSE .
     1546   Output stream Macr_Excel  close .
     1547   if mFrameView
     1548   then do:
     1549      HIDE FRAME InfoFrame.
     1550   end.
     1551       run paramls-write in this-procedure
     1552            (input "charcol"
     1553           ,input ""
     1554           ,input "1"
     1555           ) .
     1556   run end-proc in this-procedure .
     1557   define variable v-user-action as character no-undo .
     1558   define variable v-printed as logical   no-undo .
     1559   define variable DisabledOptions as integer   no-undo .
     1560   define variable v-orient-page as character no-undo .
     1561   run How-name in this-procedure (
     1562       input ReportPageHeight,
     1563       input ReportPageWidth,
     1564       output v-orient-page )
     1565       .
     1566   if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1567                                  else DisabledOptions = 0 .
     1568     if n-c <= 10 then  DisabledOptions = 8 .
     1569     if n-c > 10 and n-c < 66 then DisabledOptions = 9 .
     1570     if n-c >= 66 then DisabledOptions = 11 .
     1571     DisabledOptions = 11 .
     1572   run gbl/prnfilen.w
     1573      (input  ""
     1574     ,input  DisabledOptions
     1575     ,input  string (session :temp-directory) + "rpt" + string ( g#report-num )
     1576     ,input ReportFontNum
     1577     ,output v-user-action
     1578     ,output v-printed
     1579     ) .
     1580   end.
     1581   procedure print-line :
     1582     do on error undo, return error return-value :
     1583   define variable p-qnty as character no-undo .
     1584     assign
     1585        Lines_Counter = Lines_Counter + 1
     1586       .
     1587     if line-counter ( OutStream ) + 2 > page-size ( OutStream ) then page stream OutStream.
     1588     if line-counter ( OutStream ) < Tmp_Counter then
     1589       assign
     1590       .
     1591     assign
     1592       Tmp_Counter  = line-counter ( OutStream )
     1593       num-ln = num-ln + 1
     1594     .
     1595     if line-counter ( OutStream ) + j > page-size ( OutStream ) then  PAGE STREAM OutStream.
     1596   num#str# = num#str# + 1.
     1597   num#col# = 1.
     1598   temp-bl.qnty-porc = temp-bl.qnty * temp-bl.s-porc / temp-bl.qnty-netto no-error .
     1599   run macr_excel_char ( temp-bl.gds-name  , num#str# , num#col#) . assign num#col# = num#col# + 1 .
     1600   run macr_excel_dec  ( temp-bl.qnty      , num#str# , num#col#) . assign num#col# = num#col# + 1 .
     1601   run macr_excel_dec  ( temp-bl.qnty-porc , num#str# , num#col#) . assign num#col# = num#col# + 1 .
     1602   PUT STREAM OutStream UNFORMATTED
     1603       sym1                format "X(1)" space (0)
     1604       temp-bl.gds-name    format "x(30)" space (0)
     1605       sym2                format "X(1)" space (0)
     1606       temp-bl.qnty        format ">>>>>>>>9.999" space (0)
     1607       sym3                format "X(1)" space (0)
     1608       temp-bl.qnty-porc   format ">>>>>>>>9.999" space (0)
     1609       sym4                format "X(1)" space (0)
     1610   .
     1611       for each temp-ing :
     1612           p-qnty = "".
     1613           find first temp-qnty where
     1614                     temp-qnty.id-bl  = temp-bl.gds-code and
     1615                     temp-qnty.id-ing = temp-ing.gds-code no-error .
     1616           if available temp-qnty then p-qnty = string  ( temp-qnty.qnty ) .
     1617           run macr_excel_char ( p-qnty , num#str# , num#col#   ). num#col# = num#col# + 1 .
     1618           PUT STREAM OutStream UNFORMATTED
     1619               p-qnty              format "x(15)" space (0)
     1620               sym2                format "X(1)"  space (0)
     1621               .
     1622       end.
     1623   PUT STREAM OutStream UNFORMATTED skip .
     1624   end.
     1625   end procedure.
     1626   procedure print-all-itog :
     1627   define variable sss  as decimal no-undo .
     1628   for each temp-ing :
     1629     sss = 0 .
     1630     for each temp-qnty where temp-qnty.id-ing = temp-ing.gds-code :
     1631         sss = sss + temp-qnty.qnty .
     1632         temp-ing.itog = sss .
     1633     end.
     1634   end.
     1635   assign
     1636     vv0 = ":                              :             :    ИТОГО    :"
     1637     vv2 = ":------------------------------:-------------:-------------:"
     1638   .
     1639      put stream outstream unformatted  vv2 space (0)   .
     1640      for each temp-ing :
     1641         put stream outstream unformatted  "---------------:".
     1642      end.
     1643      put stream outstream unformatted skip.
     1644      put stream outstream unformatted  vv0 space (0)   .
     1645      for each temp-ing :
     1646         put stream outstream unformatted  string (temp-ing.itog,">>>>>>>>>>9.999" ) + ":" .
     1647      end.
     1648      put stream outstream unformatted skip.
     1649      put stream outstream unformatted  vv2 space (0)   .
     1650      for each temp-ing :
     1651         put stream outstream unformatted  "---------------:".
     1652      end.
     1653      put stream outstream unformatted skip.
     1654       num#str# = num#str# + 1.
     1655       num#col# = 3.
     1656       run macr_excel_char ( "ИТОГО"   , num#str# , num#col#   ) .
     1657       for each temp-ing :
     1658           num#col# = num#col# + 1.
     1659           run macr_excel_dec ( temp-ing.itog   , num#str# , num#col#   ) .
     1660       end.
     1661   end procedure.
     1662   procedure PrintTitul :
     1663     do  on error undo, return error return-value  :
     1664     define variable cc as integer no-undo .
     1665     define variable tt as integer no-undo .
     1666     define variable pp as integer no-undo .
     1667       case clients.obj-type:
     1668          when 'орг':U
     1669          then do:
     1670               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1671               if available ub.firm
     1672               then do:
     1673                   assign
     1674                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1675                       t-addres = t-addres
     1676                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1677                               then ""
     1678                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1679                             )
     1680                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1681                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1682                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1683                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1684                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1685                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1686                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1687                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1688                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1689                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1690                       t-phone = ub.firm.phone
     1691                       t-inn   = ub.firm.inn
     1692                       t-okpo  = ub.firm.okpo
     1693                   .
     1694               end.
     1695          end.
     1696          when 'маг':U
     1697          then do:
     1698               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1699               if available ub.shop
     1700               then do:
     1701                   assign
     1702                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1703                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1704                       t-phone = shop.phone
     1705                       t-inn = ""
     1706                       t-okpo = ""
     1707                   .
     1708               end.
     1709          end.
     1710          when 'скл':U
     1711          then do:
     1712               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1713               if available ub.store
     1714               then do:
     1715                   assign
     1716                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1717                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1718                       t-phone = ub.store.phone
     1719                       t-inn = ""
     1720                       t-okpo = ""
     1721                   .
     1722               end.
     1723          end.
     1724          when 'чел':U
     1725          then do:
     1726               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1727               if available ub.person
     1728               then do:
     1729                   assign
     1730                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1731                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1732                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1733                       t-phone = ub.person.phone1
     1734                       t-inn = ub.person.inn
     1735                       t-okpo = ub.person.okpo
     1736                   .
     1737               end.
     1738          end.
     1739       end case.
     1740   PUT STREAM OutStream UNFORMATTED
     1741   space (5) string ( CAPS ( This_Object.obj-name ) + "  (" + string (This_Object.obj-code) + ")" )  skip.
     1742    PUT STREAM OutStream UNFORMATTED
     1743           space (5) string ( "РАСКЛАДКА ПРОДУКТОВ" ) +
     1744                    string ( " C " )  + string (x-date-start, "99/99/9999" )  +
     1745                    string ( " ПО " ) + string (x-date-end, "99/99/9999" )
     1746                    format "X(160)"  skip
     1747                    "Дата составления " + cur-time-date() at 165 skip
     1748         .
     1749   assign
     1750     vv0 = ":                              :             : Количество  :"
     1751     vv1 = ":         Готовые блюда        : Количество  :    порций   :"
     1752     vv2 = ":------------------------------:-------------:-------------:"
     1753   .
     1754      put stream outstream unformatted  vv2 space (0)   .
     1755      for each temp-ing :
     1756         put stream outstream unformatted  "---------------:".
     1757      end.
     1758      put stream outstream unformatted skip.
     1759      put stream outstream unformatted  vv0 space (0)   .
     1760      for each temp-ing :
     1761         put stream outstream unformatted  string (substring (temp-ing.gds-name,1,15),"x(15)" ) + ":" .
     1762      end.
     1763      put stream outstream unformatted skip.
     1764      put stream outstream unformatted  vv1 space (0)   .
     1765      for each temp-ing :
     1766         put stream outstream unformatted  string (substring (temp-ing.gds-name,16,15),"x(15)" ) + ":" .
     1767      end.
     1768      put stream outstream unformatted skip.
     1769      put stream outstream unformatted  vv2 space (0)   .
     1770      for each temp-ing :
     1771         put stream outstream unformatted  "---------------:".
     1772      end.
     1773      put stream outstream unformatted skip.
     1774       run macr_cell_size ( 15 , ? , 1 , 11 , 6, 11 ) .
     1775       run macr_cell_format
     1776       ( 8       ,
     1777         false   ,
     1778         false   ,
     1779         ?       ,
     1780         1  ,
     1781         11 ,
     1782         6  ,
     1783         12 ) .
     1784       num#str# = 1.
     1785       num#col# = 1.
     1786       cc = num#str# .
     1787       run macr_excel_char ( "РАСКЛАДКА ПРОДУКТОВ"  +
     1788                    string ( " C " )  + string (x-date-start, "99/99/9999" )  +
     1789                    string ( " ПО " ) + string (x-date-end, "99/99/9999" )
     1790             , num#str# , num#col#   ) .
     1791       num#str# = num#str# + 1.
     1792       num#col# = 2.
     1793       run macr_excel_char ( string ( CAPS ( This_Object.obj-name ) + "  (" + string (This_Object.obj-code) + ")" )   , num#str# , num#col#   ) .
     1794       run macr_cell_format
     1795        ( 20    ,
     1796         true  ,
     1797         false  ,
     1798         ?    ,
     1799         cc ,
     1800         1 ,
     1801         num#str# ,
     1802         2 ) .
     1803       num#str# = num#str# + 1.
     1804       num#col# = 11.
     1805       run macr_excel_char ("Дата составления " + cur-time-date()   , num#str# , num#col#   ) .
     1806       num#str# = num#str# + 1.
     1807       num#col# = 1.
     1808       tt = num#str#  .
     1809       run macr_excel_char ( "Наименование блюда"   , num#str# , num#col#   ) .
     1810       run macr_cell_size  ( 40 , ? , num#str# , num#col# , ?, ? ) .
     1811       run macr_cell_format
     1812        ( 12    ,
     1813         true  ,
     1814         false  ,
     1815         ?    ,
     1816         pp,
     1817         1 ,
     1818         num#str# ,
     1819         3 ) .
     1820       num#col# = num#col# + 1.
     1821       run macr_excel_char ( "Количество"   , num#str# , num#col#   ) .
     1822       run macr_cell_size  ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1823       run macr_cell_format
     1824        ( 12    ,
     1825         true  ,
     1826         false  ,
     1827         ?    ,
     1828         pp,
     1829         1 ,
     1830         num#str# ,
     1831         3 ) .
     1832       num#col# = num#col# + 1.
     1833       run macr_excel_char ( "Количество порций"   , num#str# , num#col#   ) .
     1834       run macr_cell_size  ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1835       run macr_cell_format
     1836        ( 12    ,
     1837         true  ,
     1838         false  ,
     1839         ?    ,
     1840         pp,
     1841         1 ,
     1842         num#str# ,
     1843         3 ) .
     1844        put  stream macr_excel unformatted
     1845          substitute ('select("r&1c&2:r&3c&4")' , tt , 1 , num#str# ,  num#col# ) + chr(10)  +
     1846          'BORDER(2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1847          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1848          .
     1849       for each temp-ing :
     1850           num#col# = num#col# + 1.
     1851           run macr_excel_char ( temp-ing.gds-name   , num#str# , num#col#   ) .
     1852           run macr_cell_size  ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1853          run macr_cell_format
     1854            ( 12    ,
     1855             true  ,
     1856             false  ,
     1857             ?    ,
     1858             num#col#,
     1859             num#str# ,
     1860             num#str# ,
     1861             num#col# ) .
     1862           put  stream macr_excel unformatted
     1863             substitute ('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# , num#str# ,  num#col# ) + chr(10)  +
     1864             'BORDER(2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1865             'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1866             .
     1867       end.
     1868     end.
     1869   end procedure.
     1870   procedure PrintPodval :
     1871     do on error undo, return error return-value  :
     1872     end.
     1873   end procedure.
     1874   PROCEDURE on-same-page :
     1875     define input parameter p-line-number as integer  no-undo .
     1876     if p-line-number > page-size ( OutStream ) then return .
     1877     if line-counter ( OutStream ) + p-line-number > page-size ( OutStream ) then  page stream OutStream .
     1878   end procedure.
     1879   procedure make-tt :
     1880     do
     1881     on error undo, return error return-value
     1882     :
     1883   define variable sum-fact-qnty as decimal no-undo .
     1884   define variable sum-porc as decimal no-undo .
     1885   define variable sum-netto as decimal no-undo .
     1886   for each fbr-doc no-lock   where
     1887                           fbr-doc.status_    = 'факт':U and
     1888                           fbr-doc.obj-type   = obj-list.obj-type and
     1889                           fbr-doc.obj-code   = obj-list.obj-code and
     1890                           fbr-doc.fact-date  >= x-date-start and
     1891                           fbr-doc.fact-date  <= x-date-end
     1892                           :
     1893       for each fbr-line no-lock  where fbr-line.doc-code  = fbr-doc.doc-code ,
     1894           first fbr-recipe no-lock where fbr-recipe.recipe-code = fbr-line.recipe-code and
     1895                                          fbr-recipe.doc-code    = fbr-line.doc-code and
     1896                                       (   fbr-recipe.recipe-type = 'производство':U or
     1897                                          fbr-recipe.recipe-type = 'комплектация':U )
     1898        :
     1899       for each goods no-lock where          goods.artic     = fbr-line.artic         and
     1900                                             goods.prod-code = fbr-line.prod-code     and
     1901                                             goods.prod-type = fbr-line.prod-type  :
     1902       if  fbr-line.is-comp = true    then do:
     1903           sum-fact-qnty = sum-fact-qnty + fbr-line.fact-qnty.
     1904           find first temp-bl where temp-bl.gds-code = goods.gds-code no-error .
     1905             if not available temp-bl then do:
     1906                create temp-bl .
     1907                sum-fact-qnty =  0 .
     1908                sum-porc = 0.
     1909                sum-netto = 0.
     1910             end.
     1911             else do:
     1912               sum-fact-qnty =  temp-bl.qnty     .
     1913               sum-porc      = temp-bl.qnty-porc .
     1914               sum-netto     = temp-bl.qnty-netto .
     1915             end.
     1916               sum-fact-qnty = sum-fact-qnty + fbr-line.fact-qnty .
     1917               sum-porc      = sum-porc    +  (fbr-recipe.portion-qnty  * fbr-line.fact-qnty ).
     1918               sum-netto     = sum-netto   +  ( fbr-recipe.qnty * fbr-line.fact-qnty ).
     1919             assign
     1920               temp-bl.artic       = goods.artic
     1921               temp-bl.prod-type   = goods.prod-type
     1922               temp-bl.prod-code   = goods.prod-code
     1923               temp-bl.gds-name    = goods.gds-name
     1924               temp-bl.gds-code    = goods.gds-code
     1925               temp-bl.qnty        = sum-fact-qnty
     1926               temp-bl.s-porc      = sum-porc
     1927               temp-bl.qnty-porc   = sum-fact-qnty * sum-porc / sum-netto
     1928               temp-bl.qnty-netto  = sum-netto
     1929             .
     1930               run make-sum  (
     1931                     input  fbr-line.doc-code,
     1932                     input  fbr-line.recipe-code,
     1933                     input  goods.gds-code     ).
     1934       end.
     1935       else do:
     1936           find first temp-ing where temp-ing.gds-code = goods.gds-code no-error .
     1937             if not available temp-ing then do:
     1938                                            n-c = n-c + 1.
     1939                                            create temp-ing .
     1940                                            end.
     1941             assign
     1942               temp-ing.artic       = goods.artic
     1943               temp-ing.prod-type   = goods.prod-type
     1944               temp-ing.prod-code   = goods.prod-code
     1945               temp-ing.gds-name    = goods.gds-name
     1946               temp-ing.gds-code    = goods.gds-code
     1947             .
     1948       end.
     1949                  end.
     1950              end.
     1951         end.
     1952     end.
     1953    end procedure.
     1954   procedure make-sum :
     1955   do
     1956   on error undo, return error return-value
     1957    :
     1958   define input parameter x-doc-code like fbr-line.doc-code no-undo .
     1959   define input parameter x-recipe like fbr-line.recipe-code no-undo .
     1960   define input parameter x-id as integer no-undo .
     1961   define buffer comp_fbr-doc  for fbr-doc.
     1962   define buffer comp_fbr-line for fbr-line.
     1963   define buffer comp_recipe   for fbr-recipe.
     1964   define buffer comp_recipe-gds   for fbr-recipe-gds.
     1965   define buffer comp_goods for goods .
     1966   define variable tt-sum as decimal no-undo .
     1967   for each comp_fbr-doc no-lock   where
     1968                           comp_fbr-doc.doc-code    = x-doc-code
     1969                           :
     1970        for each comp_recipe-gds no-lock where
     1971                 comp_recipe-gds.doc-code    = comp_fbr-doc.doc-code      and
     1972                 comp_recipe-gds.recipe-code = x-recipe
     1973                 :
     1974       for each comp_fbr-line no-lock  where
     1975                 comp_fbr-line.doc-code      = comp_fbr-doc.doc-code and
     1976                 comp_fbr-line.recipe-code   = x-recipe and
     1977                 comp_fbr-line.artic       = comp_recipe-gds.artic         and
     1978                 comp_fbr-line.prod-code   = comp_recipe-gds.prod-code     and
     1979                 comp_fbr-line.prod-type   = comp_recipe-gds.prod-type
     1980                 :
     1981       for each comp_goods no-lock where
     1982                comp_goods.artic     = comp_fbr-line.artic         and
     1983                comp_goods.prod-code = comp_fbr-line.prod-code     and
     1984                comp_goods.prod-type = comp_fbr-line.prod-type
     1985                :
     1986           find first temp-qnty where
     1987                      temp-qnty.id-bl = x-id and
     1988                      temp-qnty.id-ing = comp_goods.gds-code
     1989                      no-error .
     1990             if not available temp-qnty then do:
     1991                 create temp-qnty .
     1992                 tt-sum = 0.
     1993                 end.
     1994                 else  tt-sum = temp-qnty.qnty.
     1995            tt-sum = tt-sum  + comp_fbr-line.fact-qnty .
     1996             assign
     1997               temp-qnty.id-bl  = x-id
     1998               temp-qnty.id-ing = comp_goods.gds-code
     1999               temp-qnty.qnty   = tt-sum
     2000             .
     2001             end.
     2002           end.
     2003       end.
     2004   end.
     2005    end.
     2006   end procedure.
     2007   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2008   procedure macr_excel_char :
     2009    do
     2010    on error undo, return error return-value
     2011    :
     2012    define input parameter  p-val as character no-undo .
     2013    define input parameter  p-row as integer no-undo .
     2014    define input parameter  p-col as integer no-undo .
     2015    if p-val = ? then p-val = "" .
     2016       put stream macr_excel unformatted
     2017             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2018    end.
     2019   end procedure.
     2020   procedure macr_excel_char_with_format :
     2021    do
     2022    on error undo, return error return-value
     2023    :
     2024    define input parameter  p-val as character no-undo .
     2025    define input parameter  p-row as integer no-undo .
     2026    define input parameter  p-col as integer no-undo .
     2027    if p-val = ? then p-val = "" .
     2028       put stream macr_excel unformatted
     2029             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2030       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2031       put stream macr_excel unformatted
     2032             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2033    end.
     2034   end procedure.
     2035   procedure macr_excel_cell_format :
     2036    do
     2037    on error undo, return error return-value
     2038    :
     2039    define input parameter  p-val    as character no-undo .
     2040    define input parameter  p-row    as integer   no-undo .
     2041    define input parameter  p-col    as integer   no-undo .
     2042    define input parameter  p-format as character no-undo .
     2043    if p-val = ? then p-val = "" .
     2044       put stream macr_excel unformatted
     2045             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2046       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2047       put stream macr_excel unformatted
     2048             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2049    end.
     2050   end procedure.
     2051   procedure macr_excel_sum :
     2052    do
     2053    on error undo, return error return-value
     2054    :
     2055    define input parameter  p-row as integer no-undo .
     2056    define input parameter  p-col as integer no-undo .
     2057    define input parameter  p-row1 as integer no-undo .
     2058    define input parameter  p-col1 as integer no-undo .
     2059    define input parameter  p-row2 as integer no-undo .
     2060    define input parameter  p-col2 as integer no-undo .
     2061       put stream macr_excel unformatted
     2062             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2063    end.
     2064   end procedure.
     2065   procedure macr_excel_dec :
     2066    do
     2067    on error undo, return error return-value
     2068    :
     2069    define input parameter  p-val as character no-undo .
     2070    define input parameter  p-row as integer   no-undo .
     2071    define input parameter  p-col as integer   no-undo .
     2072     if p-val = ? then p-val =  "" .
     2073      put  stream macr_excel unformatted
     2074           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2075    end.
     2076   end procedure.
     2077   procedure macr_cell_format :
     2078    do
     2079    on error undo, return error return-value
     2080    :
     2081    define input parameter  p-size   as integer   no-undo .
     2082    define input parameter  p-bold   as logical   no-undo .
     2083    define input parameter  p-italic as logical   no-undo .
     2084    define input parameter  p-color  as integer   no-undo .
     2085    define input parameter  p-row    as integer   no-undo .
     2086    define input parameter  p-col    as integer   no-undo .
     2087    define input parameter  p-row-2  as integer   no-undo .
     2088    define input parameter  p-col-2  as integer   no-undo .
     2089     if p-size = ? then p-size = 10 .
     2090     if p-bold = ? then p-bold = false .
     2091     if p-italic = ? then p-italic = false .
     2092     if p-row-2 = ? then p-row-2 = p-row .
     2093     if p-col-2 = ? then p-col-2 = p-col .
     2094     put  stream macr_excel unformatted
     2095      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2096     if p-color <> ? then do:
     2097        put  stream macr_excel unformatted
     2098          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2099     end.
     2100     put  stream macr_excel unformatted
     2101          substitute('format.font(,&1,&2,&3)' , p-size,
     2102                                           string ( p-bold  , "true/false" ) ,
     2103                                           string ( p-italic , "true/false" )
     2104                                           ) + chr(10) .
     2105    end.
     2106   end procedure.
     2107   procedure macr_cell_size :
     2108    do
     2109    on error undo, return error return-value
     2110    :
     2111    define input parameter  p-w   as integer   no-undo .
     2112    define input parameter  p-l   as integer   no-undo .
     2113    define input parameter  p-row    as integer   no-undo .
     2114    define input parameter  p-col    as integer   no-undo .
     2115    define input parameter  p-row-2  as integer   no-undo .
     2116    define input parameter  p-col-2  as integer   no-undo .
     2117     if p-row-2 = ? then p-row-2 = p-row .
     2118     if p-col-2 = ? then p-col-2 = p-col .
     2119     if p-w = ? then    p-w = 0 .
     2120     if p-l = ? then    p-l = 0 .
     2121    define variable s-w as character no-undo .
     2122    define variable s-l as character no-undo .
     2123    if p-w = 0 then s-w = "" .
     2124               else s-w = string(p-w)  .
     2125    if p-l = 0 then s-l = "" .
     2126               else s-l = string(p-l)  .
     2127   put  stream macr_excel unformatted
     2128        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2129   put  stream macr_excel unformatted
     2130        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2131   put  stream macr_excel unformatted
     2132        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2133    end.
     2134   end procedure.
     2135   procedure proc-print-header :
     2136    do
     2137    on error undo, return error return-value
     2138    :
     2139      find first sheetf .
     2140        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2141        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2142        var-1 =  num#str# .
     2143        repeat c-c = 1 to sheetf.excel-row-title :
     2144        num#str# = num#str# + 1 .
     2145        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2146        do c-i = 1 to p-var :
     2147           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2148           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2149           num#col# = c-i .
     2150           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2151           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2152        end.
     2153       c-i = 0.
     2154       end.
     2155       run macr_cell_format (
     2156           10       ,
     2157           true     ,
     2158           false    ,
     2159           35       ,
     2160           var-1 + 1,
     2161           1        ,
     2162           num#str# ,
     2163           num#col# )
     2164           .
     2165     put  stream macr_excel unformatted
     2166          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2167          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2168          .
     2169    end.
     2170   end procedure.
     2171   procedure end-proc :
     2172    do
     2173    on error undo, return error return-value
     2174    :
     2175     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2176     OUTPUT to VALUE (v-file-name) .
     2177     for each temp-param :
     2178       export  temp-param  .
     2179     end.
     2180    end.
     2181   end procedure.
