     1385   define variable v-ind       as integer   no-undo .
     1386   define variable num#col#    as integer no-undo .
     1387   define variable C-c    as integer no-undo .
     1388   define variable C-str  as character no-undo .
     1389   define variable str--1 as character Format "x(60)" no-undo.
     1390   define variable str--2 as integer no-undo .
     1391   define variable C-i    as integer no-undo .
     1392   define variable p-var  as integer no-undo .
     1393   define variable var-1  as integer no-undo .
     1394   define variable var-2  as integer no-undo .
