      194   procedure create_obj-list :
      195      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      196      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      197      do
      198      on error undo, return error return-value
      199      :
      200         define buffer cli-obj for ub.clients .
      201         define variable p-var as integer no-undo .
      202         define buffer buf_obj-list for obj-list .
      203         find last buf_obj-list  use-index pi no-error .
      204         if available buf_obj-list
      205         then
      206            p-var = buf_obj-list.obj-id + 1.
      207         else
      208            p-var = 1.
      209         find first cli-obj where
      210                   cli-obj.obj-type = p-obj-type
      211               and cli-obj.obj-code = p-obj-code
      212         no-lock no-error.
      213         if available cli-obj
      214         then do:
      215            create buf_obj-list.
      216            assign
      217               buf_obj-list.obj-id   = p-var
      218               buf_obj-list.obj-code = cli-obj.obj-code
      219               buf_obj-list.obj-type = cli-obj.obj-type
      220               buf_obj-list.obj-name = cli-obj.obj-name
      221               buf_obj-list.db-num   = cli-obj.db-num
      222            .
      223         end.
      224      end.
      225   end.
