      628   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      629   procedure paramls-clear :
      630     define buffer buf_temp-param for temp-param .
      631     do
      632     on error undo, return error return-value
      633     :
      634       for each buf_temp-param
      635       on error undo, return error
      636       :
      637         delete buf_temp-param .
      638       end.
      639     end.
      640   end procedure.
      641   procedure paramls-write :
      642     define input  parameter p-code     as character no-undo .
      643     define input  parameter p-sub-code as character no-undo .
      644     define input  parameter p-value    as character no-undo .
      645     define buffer buf_temp-param for temp-param .
      646     do
      647     on error undo, return error return-value
      648     :
      649       find first buf_temp-param
      650         where buf_temp-param.param-code     = p-code
      651           and buf_temp-param.param-sub-code = p-sub-code
      652         no-error .
      653       if not available buf_temp-param then do:
      654         create buf_temp-param .
      655         assign
      656           buf_temp-param.param-code     = p-code
      657           buf_temp-param.param-sub-code = p-sub-code
      658         .
      659       end.
      660       assign
      661         buf_temp-param.param-value = p-value
      662       .
      663     end.
      664   end procedure.
      665   procedure paramls-read :
      666     define input  parameter p-code          as character no-undo .
      667     define input  parameter p-sub-code      as character no-undo .
      668     define input  parameter p-default-value as character no-undo .
      669     define output parameter p-value         as character no-undo .
      670     define buffer buf_temp-param for temp-param .
      671     do
      672     on error undo, return error return-value
      673     :
      674       find first buf_temp-param
      675         where buf_temp-param.param-code     = p-code
      676           and buf_temp-param.param-sub-code = p-sub-code
      677         no-error .
      678       if available buf_temp-param then do:
      679         assign
      680           p-value = buf_temp-param.param-value
      681         .
      682       end.
      683       else do:
      684         assign
      685           p-value = p-default-value
      686         .
      687       end.
      688     end.
      689   end procedure.
      690   procedure paramls-append :
      691     define input  parameter p-code     as character no-undo .
      692     define input  parameter p-sub-code as character no-undo .
      693     define input  parameter p-value    as character no-undo .
      694     define buffer buf_temp-param for temp-param .
      695     do
      696     on error undo, return error return-value
      697     :
      698       find first buf_temp-param
      699            where buf_temp-param.param-code     = p-code
      700              and buf_temp-param.param-sub-code = p-sub-code
      701         no-error .
      702       if not available buf_temp-param then do:
      703         create buf_temp-param .
      704         assign
      705           buf_temp-param.param-code     = p-code
      706           buf_temp-param.param-sub-code = p-sub-code
      707           buf_temp-param.param-value    = p-value
      708         .
      709       end.
      710       else do:
      711           assign
      712               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      713           .
      714       end.
      715     end.
      716   end procedure.
