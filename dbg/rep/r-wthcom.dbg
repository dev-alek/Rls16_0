      182   def
      183    shared
      184   temp-table  obj-list no-undo
      185     field obj-type like ub.clients.obj-type
      186     field obj-code like ub.clients.obj-code
      187     field obj-name like ub.clients.obj-name
      188     field obj-id   as integer
