      794   procedure wthcom-init :
      795   do
      796   on error undo, return error
      797   :
      798       assign
      799           v-wthcom-sheet1-cur-data-row = 0
      800       .
      801       run gbl/_tmpfile.p (
      802             input "xd"
      803           , input ".txt"
      804           , output v-wthcom-data-file-name
      805       ).
      806       output stream excel-line to value( v-wthcom-data-file-name ).
      807       run gbl/_tmpfile.p (
      808             input "xc"
      809           , input ".txt"
      810           , output v-wthcom-cell-file-name
      811       ).
      812       output stream excel-cell to value( v-wthcom-cell-file-name ).
      813       run wthcom-write-cell-data in this-procedure (
      814             input "sheetList":U
      815           , input "Template":U
      816       ).
      817       if printrubl
      818       then do:
      819           run wthcom-write-cell-data in this-procedure (
      820                 input "Template_valutCode":U
      821               , input "0":U
      822           ).
      823       end.
      824       else do:
      825           run wthcom-write-cell-data in this-procedure (
      826                 input "Template_valutCode":U
      827               , input "1":U
      828           ).
      829       end.
      830       run wthcom-write-cell-data in this-procedure (
      831             input "Template_columnList":U
      832           , input "number,wth_name,wth_par_name,summ_4,summ_5,summ_6,summ_7,summ_8,summ_9,summ_10,summ_11,summ_12,summ_13,summ_14,summ_15,summ_16":U
      833       ).
      834       run wthcom-write-cell-data in this-procedure (
      835             input "Template_columnType":U
      836           , input "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
      837       ).
      838       run wthcom-write-cell-data in this-procedure (
      839             input "Template_subtotalList":U
      840           , input "":U
      841       ).
      842       run wthcom-write-cell-data in this-procedure (
      843             input "Template_subtotalType":U
      844           , input "":U
      845       ).
      846   end.
      847   end procedure.
      848   procedure wthcom-sheet1-write-line-data :
      849   define buffer buf_tt-line     for tt-line .
      850   define buffer buf_tt-grp      for tt-grp .
      851   define buffer buf_tt-wth-par  for tt-wth-par .
      852   define variable v-summ-4-it  as decimal format "->>>>>9"     no-undo .
      853   define variable v-summ-5-it  as decimal format "->>>>>9.999" no-undo .
      854   define variable v-summ-6-it  as decimal format "->>>>>9.99"  no-undo .
      855   define variable v-summ-7-it  as decimal format "->>>>>9.999" no-undo .
      856   define variable v-summ-8-it  as decimal format "->>>>>9.99"  no-undo .
      857   define variable v-summ-9-it  as decimal format "->>>>>9.999" no-undo .
      858   define variable v-summ-10-it as decimal format "->>>>>9.99"  no-undo .
      859   define variable v-summ-11-it as decimal format "->>>>>9.999" no-undo .
      860   define variable v-summ-12-it as decimal format "->>>>>9.99"  no-undo .
      861   define variable v-summ-13-it as decimal format "->>>>>9.999" no-undo .
      862   define variable v-summ-14-it as decimal format "->>>>>9.99"  no-undo .
      863   define variable v-summ-15-it as decimal format "->>>>>9.999" no-undo .
      864   define variable v-summ-16-it as decimal format "->>>>>9.99"  no-undo .
      865   define variable v-summ-4-vs  as decimal format "->>>>>9"     no-undo .
      866   define variable v-summ-5-vs  as decimal format "->>>>>9.999" no-undo .
      867   define variable v-summ-6-vs  as decimal format "->>>>>9.99"  no-undo .
      868   define variable v-summ-7-vs  as decimal format "->>>>>9.999" no-undo .
      869   define variable v-summ-8-vs  as decimal format "->>>>>9.99"  no-undo .
      870   define variable v-summ-9-vs  as decimal format "->>>>>9.999" no-undo .
      871   define variable v-summ-10-vs as decimal format "->>>>>9.99"  no-undo .
      872   define variable v-summ-11-vs as decimal format "->>>>>9.999" no-undo .
      873   define variable v-summ-12-vs as decimal format "->>>>>9.99"  no-undo .
      874   define variable v-summ-13-vs as decimal format "->>>>>9.999" no-undo .
      875   define variable v-summ-14-vs as decimal format "->>>>>9.99"  no-undo .
      876   define variable v-summ-15-vs as decimal format "->>>>>9.999" no-undo .
      877   define variable v-summ-16-vs as decimal format "->>>>>9.99"  no-undo .
      878   do
      879   on error undo, return error
      880   :
      881      for each buf_tt-grp
      882         :
      883         put stream excel-line unformatted
      884                               "Template":U
      885               CHR(9)   "DTA":U
      886               CHR(9)   buf_tt-grp.grp-name
      887               CHR(9)   " "
      888               CHR(9)   " "
      889               CHR(9)   " "
      890               CHR(9)   " "
      891               CHR(9)   " "
      892               CHR(9)   " "
      893               CHR(9)   " "
      894               CHR(9)   " "
      895               CHR(9)   " "
      896               CHR(9)   " "
      897               CHR(9)   " "
      898               CHR(9)   " "
      899               CHR(9)   " "
      900               CHR(9)   " "
      901               CHR(9)   " "
      902               chr(10)
      903         .
      904         put stream excel-line unformatted
      905                           "Template":U
      906            CHR(9)  "FMT":U
      907            CHR(9)   "Заголовок1"
      908            chr(10)
      909         .
      910         assign
      911            v-summ-4-it  = 0
      912            v-summ-5-it  = 0
      913            v-summ-6-it  = 0
      914            v-summ-7-it  = 0
      915            v-summ-8-it  = 0
      916            v-summ-9-it  = 0
      917            v-summ-10-it = 0
      918            v-summ-11-it = 0
      919            v-summ-12-it = 0
      920            v-summ-13-it = 0
      921            v-summ-14-it = 0
      922            v-summ-15-it = 0
      923            v-summ-16-it = 0
      924         .
      925         FOR EACH buf_tt-wth-par
      926             by number
      927            :
      928            FOR each buf_tt-line
      929               where buf_tt-line.grp-code       = buf_tt-grp.grp-code
      930                 and buf_tt-line.wth-code       = buf_tt-wth-par.wth-code
      931                 and buf_tt-line.wth-par-code   = buf_tt-wth-par.wth-par-code
      932               :
      933               put stream excel-line unformatted
      934                                     "Template":U
      935                     CHR(9)   "DTA":U
      936                     CHR(9)    buf_tt-wth-par.number
      937                     CHR(9)    buf_tt-wth-par.wth-name
      938                     CHR(9)    buf_tt-wth-par.wth-par-name
      939                     CHR(9)       buf_tt-line.summ-4                                 format "->>>>>>>>>>9"
      940                     CHR(9)       buf_tt-line.summ-5                                 format "->>>>>>>>>>9.999"
      941                     CHR(9)       buf_tt-line.summ-6                                 format "->>>>>>>>>>9.99"
      942                     CHR(9)       buf_tt-line.summ-7                                 format "->>>>>>>>>>9.999"
      943                     CHR(9)       buf_tt-line.summ-8                                 format "->>>>>>>>>>9.99"
      944                     CHR(9)       buf_tt-line.summ-9                                 format "->>>>>>>>>>9.999"
      945                     CHR(9)       buf_tt-line.summ-10                                format "->>>>>>>>>>9.99"
      946                     CHR(9)       buf_tt-line.summ-11                                format "->>>>>>>>>>9.999"
      947                     CHR(9)       buf_tt-line.summ-12                                format "->>>>>>>>>>9.99"
      948                     CHR(9)     ( buf_tt-line.summ-5        - buf_tt-line.summ-9  )  format "->>>>>>>>>>9.999"
      949                     CHR(9)     ( buf_tt-line.summ-6        - buf_tt-line.summ-10 )  format "->>>>>>>>>>9.99"
      950                     CHR(9)       buf_tt-line.summ-15                                format "->>>>>>>>>>9.999"
      951                     CHR(9)       buf_tt-line.summ-16                                format "->>>>>>>>>>9.99"
      952                     chr(10)
      953               .
      954               assign
      955                  v-summ-4-it  = v-summ-4-it   +   buf_tt-line.summ-4
      956                  v-summ-5-it  = v-summ-5-it   +   buf_tt-line.summ-5
      957                  v-summ-6-it  = v-summ-6-it   +   buf_tt-line.summ-6
      958                  v-summ-7-it  = v-summ-7-it   +   buf_tt-line.summ-7
      959                  v-summ-8-it  = v-summ-8-it   +   buf_tt-line.summ-8
      960                  v-summ-9-it  = v-summ-9-it   +   buf_tt-line.summ-9
      961                  v-summ-10-it = v-summ-10-it  +   buf_tt-line.summ-10
      962                  v-summ-11-it = v-summ-11-it  +   buf_tt-line.summ-11
      963                  v-summ-12-it = v-summ-12-it  +   buf_tt-line.summ-12
      964                  v-summ-13-it = v-summ-13-it  + ( buf_tt-line.summ-5        - buf_tt-line.summ-9  )
      965                  v-summ-14-it = v-summ-14-it  + ( buf_tt-line.summ-6        - buf_tt-line.summ-10 )
      966                  v-summ-15-it = v-summ-15-it  +   buf_tt-line.summ-15
      967                  v-summ-16-it = v-summ-16-it  +   buf_tt-line.summ-16
      968                  v-summ-4-vs  = v-summ-4-vs   +   buf_tt-line.summ-4
      969                  v-summ-5-vs  = v-summ-5-vs   +   buf_tt-line.summ-5
      970                  v-summ-6-vs  = v-summ-6-vs   +   buf_tt-line.summ-6
      971                  v-summ-7-vs  = v-summ-7-vs   +   buf_tt-line.summ-7
      972                  v-summ-8-vs  = v-summ-8-vs   +   buf_tt-line.summ-8
      973                  v-summ-9-vs  = v-summ-9-vs   +   buf_tt-line.summ-9
      974                  v-summ-10-vs = v-summ-10-vs  +   buf_tt-line.summ-10
      975                  v-summ-11-vs = v-summ-11-vs  +   buf_tt-line.summ-11
      976                  v-summ-12-vs = v-summ-12-vs  +   buf_tt-line.summ-12
      977                  v-summ-13-vs = v-summ-13-vs  + ( buf_tt-line.summ-5        - buf_tt-line.summ-9  )
      978                  v-summ-14-vs = v-summ-14-vs  + ( buf_tt-line.summ-6        - buf_tt-line.summ-10 )
      979                  v-summ-15-vs = v-summ-15-vs  +   buf_tt-line.summ-15
      980                  v-summ-16-vs = v-summ-16-vs  +   buf_tt-line.summ-16
      981              .
      982            END.
      983         end.
      984         put stream excel-line unformatted
      985                               "Template":U
      986               CHR(9)   "DTA":U
      987               CHR(9)   ""
      988               CHR(9)   "  ИТОГО:"
      989               CHR(9)   " "
      990               CHR(9)   v-summ-4-it   format "->>>>>>>>>>>9"
      991               CHR(9)   v-summ-5-it   format "->>>>>>>>>>>9.999"
      992               CHR(9)   v-summ-6-it   format "->>>>>>>>>>>9.99"
      993               CHR(9)   v-summ-7-it   format "->>>>>>>>>>>9.999"
      994               CHR(9)   v-summ-8-it   format "->>>>>>>>>>>9.99"
      995               CHR(9)   v-summ-9-it   format "->>>>>>>>>>>9.999"
      996               CHR(9)   v-summ-10-it  format "->>>>>>>>>>>9.99"
      997               CHR(9)   v-summ-11-it  format "->>>>>>>>>>>9.999"
      998               CHR(9)   v-summ-12-it  format "->>>>>>>>>>>9.99"
      999               CHR(9)   v-summ-13-it  format "->>>>>>>>>>>9.999"
     1000               CHR(9)   v-summ-14-it  format "->>>>>>>>>>>9.99"
     1001               CHR(9)   v-summ-15-it  format "->>>>>>>>>>>9.999"
     1002               CHR(9)   v-summ-16-it  format "->>>>>>>>>>>9.99"
     1003               chr(10)
     1004         .
     1005      end.
     1006      put stream excel-line unformatted
     1007                              "Template":U
     1008            CHR(9)   "DTA":U
     1009            CHR(9)   ""
     1010            CHR(9)   "  ВСЕГО:"
     1011            CHR(9)   " "
     1012            CHR(9)   v-summ-4-vs    format "->>>>>>>>>>>>>9"
     1013            CHR(9)   v-summ-5-vs    format "->>>>>>>>>>>>>9.999"
     1014            CHR(9)   v-summ-6-vs    format "->>>>>>>>>>>>>9.99"
     1015            CHR(9)   v-summ-7-vs    format "->>>>>>>>>>>>>9.999"
     1016            CHR(9)   v-summ-8-vs    format "->>>>>>>>>>>>>9.99"
     1017            CHR(9)   v-summ-9-vs    format "->>>>>>>>>>>>>9.999"
     1018            CHR(9)   v-summ-10-vs   format "->>>>>>>>>>>>>9.99"
     1019            CHR(9)   v-summ-11-vs   format "->>>>>>>>>>>>>9.999"
     1020            CHR(9)   v-summ-12-vs   format "->>>>>>>>>>>>>9.99"
     1021            CHR(9)   v-summ-13-vs   format "->>>>>>>>>>>>>9.999"
     1022            CHR(9)   v-summ-14-vs   format "->>>>>>>>>>>>>9.99"
     1023            CHR(9)   v-summ-15-vs   format "->>>>>>>>>>>>>9.999"
     1024            CHR(9)   v-summ-16-vs   format "->>>>>>>>>>>>>9.99"
     1025            chr(10)
     1026      .
     1027   end.
     1028   end procedure.
     1029   procedure wthcom-write-cell-data :
     1030   define input parameter p-data-key   as character        no-undo.
     1031   define input parameter p-data-value as character        no-undo.
     1032       define buffer buf_temp_cell-data     for temp_cell-data.
     1033   do
     1034   for buf_temp_cell-data
     1035   on error undo, return error
     1036   :
     1037       find first buf_temp_cell-data
     1038            where buf_temp_cell-data.data-key = p-data-key
     1039       no-error.
     1040       if not available buf_temp_cell-data
     1041       then do:
     1042           create buf_temp_cell-data.
     1043           assign
     1044               buf_temp_cell-data.data-key = p-data-key
     1045           .
     1046       end.
     1047       assign
     1048           buf_temp_cell-data.data-value = p-data-value
     1049       .
     1050       put stream excel-cell unformatted
     1051                           buf_temp_cell-data.data-key
     1052           CHR(9)   buf_temp_cell-data.data-value
     1053           chr(10)
     1054       .
     1055   end.
     1056   end procedure.
     1057   procedure wthcom-run-excel :
     1058   define input parameter p-header-filename    as character        no-undo.
     1059   define input parameter p-data-filename      as character        no-undo.
     1060   define variable v-template-file-name    as character    no-undo.
     1061   define variable v-vb-file-name          as character    no-undo.
     1062   define buffer buf_temp-param for temp-param .
     1063   do
     1064   for buf_temp-param
     1065   on error undo, return error
     1066   :
     1067       create buf_temp-param.
     1068       assign
     1069           v-template-file-name    = search( "exe/wth_com.xlt" )
     1070           v-vb-file-name          = search( "exe/t_form.bas" )
     1071       .
     1072       if v-template-file-name = ?
     1073       or v-template-file-name = "":U
     1074       then do:
     1075           message
     1076               "Ошибка имени файла шаблона."
     1077           view-as alert-box error.
     1078       end.
     1079       if v-vb-file-name = ?
     1080       or v-vb-file-name = "":U
     1081       then do:
     1082           message
     1083               "Ошибка имени файла кода обработки."
     1084           view-as alert-box error.
     1085       end.
     1086       run paramls-write in this-procedure (
     1087             input "template":U
     1088           , input "template-file-name":U
     1089           , input v-template-file-name
     1090       ).
     1091       run paramls-write in this-procedure (
     1092             input "template":U
     1093           , input "vb-file-name":U
     1094           , input v-vb-file-name
     1095       ).
     1096       run paramls-write in this-procedure (
     1097             input "data":U
     1098           , input "data-header-filename":U
     1099           , input p-header-filename
     1100       ).
     1101       run paramls-write in this-procedure (
     1102             input "data":U
     1103           , input "data-filename":U
     1104           , input p-data-filename
     1105       ).
     1106       run gbl/macroxlt.p (
     1107           input-output table buf_temp-param
     1108       ) no-error.
     1109       if error-status :error
     1110       then do:
     1111           message
     1112                    vss-workfile vss-revision vss-description
     1113               skip(1)
     1114               skip "Ошибка создания файла Excel."
     1115               skip return-value
     1116               skip trim(error-status :get-message(1))
     1117                    trim(error-status :get-message(2))
     1118                    trim(error-status :get-message(3))
     1119           view-as alert-box error.
     1120           undo, return error .
     1121       end.
     1122   end.
     1123   end procedure.
     1124   procedure wthcom-close :
     1125   do
     1126   on error undo, return error
     1127   :
     1128       output stream excel-line close.
     1129       output stream excel-cell close.
     1130       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1131           export "exe/wth_com.xlt" .
     1132           export "exe/t_form.bas" .
     1133           export v-wthcom-cell-file-name.
     1134           export v-wthcom-data-file-name.
     1135       output close.
     1136   end.
     1137   end procedure.
     1138      run fill-temp-table in this-procedure .
     1139      run open-stream     IN THIS-PROCEDURE .
     1140      run print-header    in this-procedure .
     1141      run print-body      in this-procedure .
     1142      run print-footer    in this-procedure .
     1143      run close-stream    IN THIS-PROCEDURE .
     1144   end.
     1145   PROCEDURE fill-temp-table :
     1146   define buffer buf_cli-grp     for ub.cli-grp .
     1147   define buffer buf_wealth      for ub.wealth .
     1148   define buffer buf_wth-par     for ub.wth-par .
     1149   define buffer buf_wth-parts   for ub.wth-parts .
     1150   define buffer buf_clients     for ub.clients .
     1151   define buffer find_clients    for ub.clients .
     1152   define buffer buf_tt-grp      for tt-grp .
     1153   define buffer buf_tt-wth-par  for tt-wth-par .
     1154   define buffer buf_tt-line     for tt-line .
     1155   define variable v-count    as integer      no-undo.
     1156   define variable v-num      as integer      no-undo.
     1157   do
     1158   on error undo, return error
     1159   :
     1160      DO v-count = 1 TO NUM-ENTRIES(p-cli-recid-list)
     1161      on error undo, next
     1162      :
     1163         find first buf_cli-grp
     1164              where buf_cli-grp.node-code = INTEGER(ENTRY(v-count, p-cli-recid-list))
     1165              no-lock
     1166              no-error
     1167              .
     1168         IF AVAILABLE buf_cli-grp
     1169         THEN DO:
     1170            create buf_tt-grp.
     1171            assign
     1172               buf_tt-grp.grp-code = buf_cli-grp.node-code
     1173               buf_tt-grp.grp-name = buf_cli-grp.node-name
     1174            .
     1175         END.
     1176      END.
     1177      assign
     1178         v-num = 1
     1179      .
     1180      DO v-count = 1 TO NUM-ENTRIES(p-wth-recid-list)
     1181      on error undo, next
     1182      :
     1183         find first buf_wealth
     1184              where buf_wealth.wth-code = INTEGER(ENTRY(v-count, p-wth-recid-list))
     1185              no-lock
     1186              no-error
     1187              .
     1188         IF AVAILABLE buf_wealth
     1189         THEN DO:
     1190            FOR EACH  buf_wth-par
     1191                WHERE buf_wth-par.wth-code = buf_wealth.wth-code
     1192                no-lock
     1193                :
     1194                create buf_tt-wth-par.
     1195                assign
     1196                  buf_tt-wth-par.wth-code       = buf_wealth.wth-code
     1197                  buf_tt-wth-par.wth-par-code   = buf_wth-par.par-code
     1198                  buf_tt-wth-par.wth-name       = buf_wealth.wth-name
     1199                  buf_tt-wth-par.wth-par-name   = SUBSTITUTE ("&1 &2", buf_wth-par.par-val, buf_wth-par.par-unit)
     1200                  buf_tt-wth-par.par-rate       = buf_wth-par.par-val
     1201                  buf_tt-wth-par.number         = v-num
     1202                  v-num                         = v-num + 1
     1203                .
     1204            END.
     1205         END.
     1206      end.
     1207      FOR EACH buf_tt-wth-par
     1208          :
     1209          FOR each buf_tt-grp
     1210          :
     1211            create buf_tt-line.
     1212            assign
     1213               buf_tt-line.grp-code     = buf_tt-grp.grp-code
     1214               buf_tt-line.wth-par-code = buf_tt-wth-par.wth-par-code
     1215               buf_tt-line.wth-code     = buf_tt-wth-par.wth-code
     1216            .
     1217            FOR EACH  buf_clients
     1218                WHERE buf_clients.grp-code = buf_tt-grp.grp-code
     1219                  AND buf_clients.obj-type = 'маг':U
     1220                no-lock
     1221                :
     1222               FOR EACH  buf_wth-parts
     1223                  WHERE buf_wth-parts.ext-doc-type = 'ee':U
     1224                  AND buf_wth-parts.wth-code     = buf_tt-wth-par.wth-code
     1225                  AND buf_wth-parts.par-code     = buf_tt-wth-par.wth-par-code
     1226                  AND buf_wth-parts.beg-dt       >= p-begin-date
     1227                  AND buf_wth-parts.beg-dt       <= p-end-date
     1228                  AND buf_wth-parts.obj-type     = buf_clients.obj-type
     1229                  AND buf_wth-parts.obj-code     = buf_clients.obj-code
     1230                  NO-LOCK
     1231                  :
     1232                  if lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) <> 0
     1233                  OR buf_wth-parts.fact-order <= 0 then next.
     1234                  assign
     1235                     buf_tt-line.summ-4 = buf_tt-line.summ-4 + buf_wth-parts.fact-qnty
     1236                     buf_tt-line.summ-5 = buf_tt-line.summ-5 + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1237                     buf_tt-line.summ-6 = buf_tt-line.summ-6 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1238                  .
     1239               END.
     1240               FOR EACH  buf_wth-parts
     1241                  WHERE buf_wth-parts.ext-doc-type       = 'xc':U
     1242                  AND buf_wth-parts.type = 'рас':U
     1243                  AND buf_wth-parts.wth-code     = buf_tt-wth-par.wth-code
     1244                  AND buf_wth-parts.par-code     = buf_tt-wth-par.wth-par-code
     1245                  AND buf_wth-parts.beg-dt       >= p-begin-date
     1246                  AND buf_wth-parts.beg-dt       <= p-end-date
     1247                  AND buf_wth-parts.obj-type     = buf_clients.obj-type
     1248                  AND buf_wth-parts.obj-code     = buf_clients.obj-code
     1249                  NO-LOCK
     1250                  :
     1251                  if lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) <> 0
     1252                  OR buf_wth-parts.fact-order <= 0 then next.
     1253                  assign
     1254                     buf_tt-line.summ-4 = buf_tt-line.summ-4 + buf_wth-parts.fact-qnty
     1255                     buf_tt-line.summ-5 = buf_tt-line.summ-5 + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1256                     buf_tt-line.summ-6 = buf_tt-line.summ-6 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1257                  .
     1258               END.
     1259               FOR EACH  buf_wth-parts
     1260                  WHERE buf_wth-parts.ext-doc-type       = 'pz':U
     1261                  AND buf_wth-parts.wth-code     = buf_tt-wth-par.wth-code
     1262                  AND buf_wth-parts.par-code     = buf_tt-wth-par.wth-par-code
     1263                  AND buf_wth-parts.beg-dt       >= p-begin-date
     1264                  AND buf_wth-parts.beg-dt       <= p-end-date
     1265                  AND buf_wth-parts.obj-type     = buf_clients.obj-type
     1266                  AND buf_wth-parts.obj-code     = buf_clients.obj-code
     1267                  NO-LOCK
     1268                  :
     1269                  if lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) <> 0
     1270                  OR buf_wth-parts.fact-order <= 0 then next.
     1271                  assign
     1272                     buf_tt-line.summ-7 = buf_tt-line.summ-7 + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1273                     buf_tt-line.summ-8 = buf_tt-line.summ-8 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1274                  .
     1275               END.
     1276               FOR EACH  buf_wth-parts
     1277                  WHERE buf_wth-parts.ext-doc-type    = 'xc':U
     1278                  AND buf_wth-parts.type              = 'при':U
     1279                  AND buf_wth-parts.wth-code     = buf_tt-wth-par.wth-code
     1280                  AND buf_wth-parts.par-code     = buf_tt-wth-par.wth-par-code
     1281                  AND buf_wth-parts.beg-dt       >= p-begin-date
     1282                  AND buf_wth-parts.beg-dt       <= p-end-date
     1283                  AND buf_wth-parts.obj-type     = buf_clients.obj-type
     1284                  AND buf_wth-parts.obj-code     = buf_clients.obj-code
     1285                  NO-LOCK
     1286                  :
     1287                  if lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) <> 0
     1288                  OR buf_wth-parts.fact-order <= 0 then next.
     1289                  assign
     1290                     buf_tt-line.summ-7 = buf_tt-line.summ-7 + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1291                     buf_tt-line.summ-8 = buf_tt-line.summ-8 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1292                  .
     1293               END.
     1294               FOR EACH  buf_wth-parts
     1295                  WHERE buf_wth-parts.ext-doc-type       = 'pc':U
     1296                  AND buf_wth-parts.wth-code     = buf_tt-wth-par.wth-code
     1297                  AND buf_wth-parts.par-code     = buf_tt-wth-par.wth-par-code
     1298                  AND buf_wth-parts.beg-dt       >= p-begin-date
     1299                  AND buf_wth-parts.beg-dt       <= p-end-date
     1300                  AND buf_wth-parts.out-obj-type     = buf_clients.obj-type
     1301                  AND buf_wth-parts.out-obj-code     = buf_clients.obj-code
     1302                  NO-LOCK
     1303                  :
     1304                  if lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) <> 0
     1305                  OR buf_wth-parts.fact-order <= 0 then next.
     1306                  IF CAN-FIND( FIRST find_clients
     1307                               WHERE find_clients.obj-type = buf_wth-parts.sale-obj-type
     1308                                 AND find_clients.obj-code = buf_wth-parts.sale-obj-code
     1309                                 AND find_clients.grp-code = buf_tt-grp.grp-code
     1310                               NO-LOCK)
     1311                  THEN DO:
     1312                     assign
     1313                        buf_tt-line.summ-9  = buf_tt-line.summ-9  + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1314                        buf_tt-line.summ-10 = buf_tt-line.summ-10 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1315                     .
     1316                  END.
     1317                  ELSE DO:
     1318                     assign
     1319                        buf_tt-line.summ-11 = buf_tt-line.summ-11 + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1320                        buf_tt-line.summ-12 = buf_tt-line.summ-12 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1321                     .
     1322                  END.
     1323               END.
     1324               FOR EACH  buf_wth-parts
     1325                  WHERE buf_wth-parts.ext-doc-type       = 'ps':U
     1326                  AND buf_wth-parts.wth-code     = buf_tt-wth-par.wth-code
     1327                  AND buf_wth-parts.par-code     = buf_tt-wth-par.wth-par-code
     1328                  AND buf_wth-parts.beg-dt       >= p-begin-date
     1329                  AND buf_wth-parts.beg-dt       <= p-end-date
     1330                  AND buf_wth-parts.out-obj-type     = buf_clients.obj-type
     1331                  AND buf_wth-parts.out-obj-code     = buf_clients.obj-code
     1332                  NO-LOCK
     1333                  :
     1334                  if lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) <> 0
     1335                  OR buf_wth-parts.fact-order <= 0 then next.
     1336                  IF CAN-FIND( FIRST find_clients
     1337                               WHERE find_clients.obj-type = buf_wth-parts.sale-obj-type
     1338                                 AND find_clients.obj-code = buf_wth-parts.sale-obj-code
     1339                                 AND find_clients.grp-code = buf_tt-grp.grp-code
     1340                               NO-LOCK)
     1341                  THEN DO:
     1342                     assign
     1343                        buf_tt-line.summ-9  = buf_tt-line.summ-9  + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1344                        buf_tt-line.summ-10 = buf_tt-line.summ-10 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1345                     .
     1346                  END.
     1347                  ELSE DO:
     1348                     assign
     1349                        buf_tt-line.summ-11 = buf_tt-line.summ-11 + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1350                        buf_tt-line.summ-12 = buf_tt-line.summ-12 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1351                     .
     1352                  END.
     1353               END.
     1354               FOR EACH  buf_wth-parts
     1355                  WHERE buf_wth-parts.ext-doc-type = 'dc':U
     1356                  AND buf_wth-parts.wth-code     = buf_tt-wth-par.wth-code
     1357                  AND buf_wth-parts.w-p-code     = buf_tt-wth-par.wth-par-code
     1358                  AND buf_wth-parts.beg-dt       >= p-begin-date
     1359                  AND buf_wth-parts.beg-dt       <= p-end-date
     1360                  AND buf_wth-parts.obj-type     = buf_clients.obj-type
     1361                  AND buf_wth-parts.obj-code     = buf_clients.obj-code
     1362                  NO-LOCK
     1363                  :
     1364                  if lookup(buf_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) <> 0
     1365                  OR buf_wth-parts.fact-order <= 0 then next.
     1366                  assign
     1367                     buf_tt-line.summ-15 = buf_tt-line.summ-15 + buf_wth-parts.fact-qnty * buf_tt-wth-par.par-rate
     1368                     buf_tt-line.summ-16 = buf_tt-line.summ-16 + buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl
     1369                  .
     1370               END.
     1371            END.
     1372         END.
     1373      END.
     1374   end.
     1375   END PROCEDURE.
     1376   PROCEDURE print-header :
     1377   do
     1378   on error undo, return error
     1379   :
     1380       run wthcom-write-cell-data in this-procedure (
     1381             input "h_date1":U
     1382           , input SUBSTITUTE("за период с &1 по &2", p-begin-date , p-end-date )
     1383       ).
     1384   end.
     1385   END PROCEDURE.
     1386   PROCEDURE print-body :
     1387   define buffer buf_tt-grp      for tt-grp .
     1388   define buffer buf_tt-line     for tt-line .
     1389   define buffer buf_tt-wth-par  for tt-wth-par .
     1390   do
     1391   on error undo, return error
     1392   :
     1393      run wthcom-sheet1-write-line-data IN THIS-PROCEDURE .
     1394   end.
     1395   END PROCEDURE.
     1396   PROCEDURE print-footer :
     1397   define variable v-dir    as character    no-undo.
     1398   define variable v-glbuh    as character    no-undo.
     1399   define variable v-oper    as character    no-undo.
     1400   define buffer buf_firm           for ub.firm .
     1401   define buffer buf_sysconf        for ub.sysconf .
     1402   define buffer buf_user-account   for ub.user-account .
     1403   do
     1404   on error undo, return error
     1405   :
     1406      find  first buf_firm
     1407            where buf_firm.firm-code = v-cntxt-host-code-obj
     1408            no-lock
     1409            no-error
     1410            .
     1411      IF AVAILABLE buf_firm
     1412      THEN DO:
     1413         assign
     1414            v-dir   = buf_firm.director
     1415         .
     1416      END.
     1417      ELSE DO:
     1418         assign
     1419            v-dir   = " "
     1420         .
     1421      END.
     1422      find  first buf_sysconf
     1423            where buf_sysconf.host-code = v-cntxt-host-code-obj
     1424            no-lock
     1425            no-error
     1426            .
     1427      IF AVAILABLE buf_sysconf
     1428      THEN DO:
     1429         assign
     1430            v-glbuh   = buf_sysconf.snr-accnt
     1431         .
     1432      END.
     1433      ELSE DO:
     1434         assign
     1435            v-glbuh   = " "
     1436         .
     1437      END.
     1438      FIND FIRST buf_user-account
     1439           WHERE buf_user-account.user-id = v-cntxt-userid
     1440           no-lock
     1441           no-error
     1442           .
     1443      IF AVAILABLE buf_user-account
     1444      THEN DO:
     1445      assign
     1446         v-oper  = SUBSTITUTE("&1 &2 &3", buf_user-account.last-name, buf_user-account.first-name, buf_user-account.second-name )
     1447      .
     1448      END.
     1449      ELSE DO:
     1450      assign
     1451         v-oper  = " "
     1452      .
     1453      END.
     1454       run wthcom-write-cell-data in this-procedure (
     1455             input "h_dir":U
     1456           , input v-dir
     1457       ).
     1458       run wthcom-write-cell-data in this-procedure (
     1459             input "h_glbuh":U
     1460           , input v-glbuh
     1461       ).
     1462       run wthcom-write-cell-data in this-procedure (
     1463             input "h_oper":U
     1464           , input v-oper
     1465       ).
     1466   end.
     1467   END PROCEDURE.
     1468   procedure open-stream :
     1469   do
     1470   on error undo, return error
     1471   :
     1472   if session :set-wait-state( "compiler" ) then.
     1473   output stream out-stream to value( string( session:temp-directory +
     1474                                        "rpt" + string( g#report-num ) ) )
     1475                                        page-size 62 .
     1476       put stream out-stream unformatted
     1477             chr(10)
     1478           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     1479           + chr(10)
     1480       .
     1481       output stream out-stream close.
     1482       run wthcom-init in this-procedure.
     1483   end.
     1484   end procedure.
     1485   procedure close-stream :
     1486   do
     1487   on error undo, return error
     1488   :
     1489       run wthcom-close in this-procedure .
     1490       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1491       os-rename
     1492           value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1493           value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1494       .
     1495   if session :set-wait-state( "" ) then.
     1496       define variable v-user-action   as character no-undo .
     1497       define variable v-printed       as logical   no-undo .
     1498       define variable DisabledOptions as integer   no-undo .
     1499       define variable v-orient-page as character no-undo .
     1500       run gbl/prnfilen.w (
     1501             input "":U
     1502           , input 8
     1503           , input string(session :temp-directory) + "rpt" + string( g#report-num )
     1504           , input ReportFontNum
     1505           , output v-user-action
     1506           , output v-printed
     1507       ).
     1508       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1509   end.
     1510   end procedure.
