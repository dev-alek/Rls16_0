     5694     field sum_doc      as decimal
     5695     field sum_base     as decimal
     5696     field sum_dif      as decimal
     5697     index pi gds-code doc-code .
     5698   define buffer buf_clients     for ub.clients .
     5699   define buffer buf_chk-disnt   for ub.chk-discnt .
     5700   define buffer buf_chk-gds     for ub.chk-gds .
     5701   define buffer buf_bar-code    for ub.bar-code .
     5702   define buffer buf_goods       for ub.goods .
     5703   define buffer buf_trn-doc     for ub.trn-doc .
     5704   define buffer buf_doc-line    for ub.doc-line .
     5705   define buffer buf_tt-doc-line for tt-doc-line .
     5706   do
     5707     on error undo, return error return-value
     5708     :
     5709     find first obj-list no-error .
     5710     if not available obj-list then
     5711     do:
     5712       message
     5713         "Не указан объект для формирования отчета!"
     5714         view-as alert-box error.
     5715       undo, return error.
     5716     end.
     5717     if x-TOG-Shift then
     5718     do:
     5719       v-period = "Смены с " + string (x-Shift-Start) + " по " + string (x-Shift-End) + " За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5720     end.
     5721     else
     5722     do:
     5723       v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5724     end.
     5725     run clients-write(INPUT v-cntxp-curr-host-code, INPUT 'орг':U, OUTPUT v-obj-name) no-error .
     5726     DEFINE VARIABLE v-today as date    no-undo .
     5727     DEFINE VARIABLE v-time  as integer no-undo .
     5728     run cur-time in this-procedure (
     5729       output v-today
     5730       , output v-time
     5731       ).
     5732     v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     5733     for each obj-list no-lock:
     5734       if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     5735       else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     5736   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5737   empty temp-table thbjattr_thbj-attr.
     5738   run adm/shattri.p (
     5739      input "get":U
     5740     ,input obj-list.obj-type
     5741     ,input obj-list.obj-code
     5742     ,input 'nakl_par':U
     5743     ,input  ""
     5744     ,output v-value-character
     5745     ,output v-value-date
     5746     ,output v-value-decimal
     5747     ,output v-value-integer
     5748     ,output v-value-logical
     5749     ,output par-type
     5750     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     5751     ) no-error .
     5752       for each thbjattr_thbj-attr :
     5753         if thbjattr_thbj-attr.prop-code = 'reasons-for-return':U  then v-reasons-for-return = v-reasons-for-return + chr(44) + thbjattr_thbj-attr.property-value-character .
     5754       end.
     5755       v-reasons-for-return = trim (v-reasons-for-return,chr(44)).
     5756       if x-TOG-Shift then
     5757       do:
     5758         for each buf_trn-doc no-lock
     5759           where buf_trn-doc.obj-code = obj-list.obj-code
     5760           and buf_trn-doc.obj-type = obj-list.obj-type
     5761           and buf_trn-doc.shift-date >= x-Date-Start
     5762           and buf_trn-doc.shift-date <= x-Date-End
     5763           and buf_trn-doc.doc-type = 'рас':U
     5764           and buf_trn-doc.status_ = 'факт':U
     5765           and lookup (string(buf_trn-doc.reason-code),v-reasons-for-return,chr(44)) > 0:
     5766           if (buf_trn-doc.shift-date = X-date-Start)
     5767             and (buf_trn-doc.shift-num < x-Shift-Start) then next.
     5768           if (buf_trn-doc.shift-date = X-date-End)
     5769             and (buf_trn-doc.shift-num > x-Shift-End) then next.
     5770           run report .
     5771         end.
     5772       end.
     5773       else
     5774       do:
     5775         for each buf_trn-doc no-lock
     5776           where buf_trn-doc.obj-code = obj-list.obj-code
     5777           and buf_trn-doc.obj-type = obj-list.obj-type
     5778           and buf_trn-doc.doc-date >= x-Date-Start
     5779           and buf_trn-doc.doc-date <= x-Date-End
     5780           and buf_trn-doc.doc-type = 'рас':U
     5781           and buf_trn-doc.status_ = 'факт':U
     5782           and lookup (string(buf_trn-doc.reason-code),v-reasons-for-return,chr(44)) > 0:
     5783           run report .
     5784         end.
     5785       end.
     5786     end.
     5787   procedure report:
     5788     for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
     5789       first gds-dtl no-lock where gds-dtl.doc-code = buf_doc-line.doc-code and gds-dtl.artic = buf_doc-line.artic and gds-dtl.prod-code = buf_doc-line.prod-code
     5790       and gds-dtl.prod-type = buf_doc-line.prod-type,
     5791       first buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and buf_goods.prod-code = buf_doc-line.prod-code
     5792       and buf_goods.prod-type = buf_doc-line.prod-type:
     5793       create tt-doc-line .
     5794       assign
     5795         tt-doc-line.obj-code     = buf_trn-doc.obj-code
     5796         tt-doc-line.obj-type     = buf_trn-doc.obj-type
     5797         tt-doc-line.obj-name     = obj-list.obj-name
     5798         tt-doc-line.shift-date   = buf_trn-doc.shift-date
     5799         tt-doc-line.shift-num    = buf_trn-doc.shift-name
     5800         tt-doc-line.doc-date     = buf_trn-doc.doc-date
     5801         tt-doc-line.ext-doc-type = buf_trn-doc.ext-doc-type
     5802         tt-doc-line.doc-code     = buf_trn-doc.doc-code
     5803         tt-doc-line.gds-code     = buf_goods.gds-code
     5804         tt-doc-line.gds-name     = buf_goods.gds-name
     5805         tt-doc-line.qnty         = gds-dtl.fact-qnty
     5806         tt-doc-line.sum_doc      = (gds-dtl.price-rubl * 100 / (buf_doc-line.VAT-pc + 100)) * tt-doc-line.qnty
     5807         tt-doc-line.sum_base     = (buf_doc-line.price-rubl * 100 / (buf_doc-line.VAT-pc + 100)) * tt-doc-line.qnty
     5808         tt-doc-line.sum_dif      = tt-doc-line.sum_doc - tt-doc-line.sum_base      .
     5809     end.
     5810   end procedure.
     5811     run get-report-num (output p-report-id).
     5812     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     5813     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     5814     put stream OutStr-html unformatted
     5815       "<!DOCTYPE HTML>" skip
     5816       ' <html>' skip
     5817       '  <head>' skip
     5818       '   <meta charset="utf-8">' skip
     5819       '    <style type="text/css">' skip
     5820       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5821       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5822       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     5823       '   </style>' skip
     5824       '  </head>' skip
     5825       .
     5826     put stream OutStr-html unformatted
     5827       '<body>' skip
     5828       '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     5829       '<thead>' skip
     5830       .
     5831     put stream OutStr-html unformatted
     5832       '<tr>' skip
     5833       '<td style="width: 160px;"></td>' skip
     5834       '<td style="width: 160px;"></td>' skip
     5835       '<td style="width: 160px;"></td>' skip
     5836       '<td style="width: 160px;"></td>' skip
     5837       '<td style="width: 160px;"></td>' skip
     5838       '<td style="width: 160px;"></td>' skip
     5839       '<td style="width: 160px;"></td>' skip
     5840       '<td style="width: 160px;"></td>' skip
     5841       '<td style="width: 160px;"></td>' skip
     5842       '<td style="width: 160px;"></td>' skip
     5843       '<td style="width: 160px;"></td>' skip
     5844       '<td style="width: 160px;"></td>' skip
     5845       '</tr>' skip
     5846       .
     5847     put stream OutStr-html unformatted
     5848       '<TR><TD colspan="12"></TD></TR>' skip
     5849       '<TR>' skip
     5850       '<TD colspan="12" style="font-weight: bold;">Отчет по изменению учетных цен</TD>' skip
     5851       '</TR>'skip
     5852       '<TR>' skip
     5853       '<TD colspan="12">' + v-period + '</TD>' skip
     5854       '</TR>'skip
     5855       '<TR>' skip
     5856       '<TD colspan="12">' + v-obj-name + '</TD>' skip
     5857       '</TR>'skip
     5858       '<TR>' skip
     5859       '<TD colspan="12">Выбор объекта:</TD>' skip
     5860       '</TR>'skip
     5861       '<TR>' skip
     5862       '<TD colspan="12">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     5863       '</TR>'skip
     5864       '</thead>' skip
     5865       '<tbody>' skip
     5866       .
     5867     put stream OutStr-html unformatted
     5868       '<TR>' skip
     5869       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">№АЗК</TD>' skip
     5870       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Дата смены</TD>' skip
     5871       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">№ смены</TD>' skip
     5872       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Дата документа</TD>' skip
     5873       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Тип документа</TD>' skip
     5874       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Номер документа</TD>' skip
     5875       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Внутренний код товара</TD>' skip
     5876       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Название товара</TD>' skip
     5877       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Кол-во по документу</TD>' skip
     5878       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Сумма в ценах документа руб. (без НДС)</TD>' skip
     5879       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Сумма в учетных ценах в БД руб. (без НДС)</TD>' skip
     5880       '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Разница между суммой учетных цен БД и суммой цен документа руб. (без НДС)</TD>' skip
     5881       '</TR>'skip
     5882       .
     5883     for each obj-list:
     5884       v-itog = 0 .
     5885       for each buf_tt-doc-line no-lock where buf_tt-doc-line.obj-code = obj-list.obj-code:
     5886         run ConvertStr-ext-doc-type (input buf_tt-doc-line.ext-doc-type, output v-name-ext-doc-type).
     5887         put stream OutStr-html unformatted
     5888           '<TR>' skip
     5889           '<TD text_wrap="true">' + string(buf_tt-doc-line.obj-name) + '</TD>' skip
     5890           '<TD text_wrap="true">' + if buf_tt-doc-line.shift-date <> ? then string(buf_tt-doc-line.shift-date) + '</TD>' else "" + '</TD>' skip
     5891           '<TD text_wrap="true">' + if buf_tt-doc-line.shift-num <> ? then string(buf_tt-doc-line.shift-num) + '</TD>' else "" + '</td>'skip
     5892           '<TD text_wrap="true">' + string(buf_tt-doc-line.doc-date) + '</TD>' skip
     5893           '<TD text_wrap="true">' + string(v-name-ext-doc-type) + '</TD>' skip
     5894           '<TD text_wrap="true">' + string(buf_tt-doc-line.doc-code) + '</TD>' skip
     5895           '<TD text_wrap="true">' + string(buf_tt-doc-line.gds-code) + '</TD>' skip
     5896           '<TD text_wrap="true">' + string(buf_tt-doc-line.gds-name) + '</TD>' skip
     5897           '<TD text_wrap="true">' + string(buf_tt-doc-line.qnty) + '</TD>' skip
     5898           '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_tt-doc-line.sum_doc,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_tt-doc-line.sum_doc,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5899           '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_tt-doc-line.sum_base,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_tt-doc-line.sum_base,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5900           '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_tt-doc-line.sum_dif,"->>>>>>>>>>>9.99",2) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_tt-doc-line.sum_dif,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5901           '</TR>'skip
     5902           .
     5903         v-itog = v-itog + buf_tt-doc-line.sum_dif .
     5904       end.
     5905       put stream OutStr-html unformatted
     5906         '<TR>' skip
     5907         '<TD text_wrap="true" style="font-weight: bold;">' + string(obj-list.obj-name + " Итог: ") + '</TD>' skip
     5908         '<TD text_wrap="true"></TD>' skip
     5909         '<TD text_wrap="true"></TD>' skip
     5910         '<TD text_wrap="true"></TD>' skip
     5911         '<TD text_wrap="true"></TD>' skip
     5912         '<TD text_wrap="true"></TD>' skip
     5913         '<TD text_wrap="true"></TD>' skip
     5914         '<TD text_wrap="true"></TD>' skip
     5915         '<TD text_wrap="true"></TD>' skip
     5916         '<TD text_wrap="true"></TD>' skip
     5917         '<TD text_wrap="true"></TD>' skip
     5918         '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-itog,"->>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: bold;">' + fnc-convert-dot-to-colon(v-itog,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5919         '</TR>'skip
     5920         .
     5921       v-sum-itog = v-sum-itog + v-itog .
     5922     end.
     5923     put stream OutStr-html unformatted
     5924       '<TR>' skip
     5925       '<TD text_wrap="true" style="font-weight: bold;">Итог общий:</TD>' skip
     5926       '<TD text_wrap="true"></TD>' skip
     5927       '<TD text_wrap="true"></TD>' skip
     5928       '<TD text_wrap="true"></TD>' skip
     5929       '<TD text_wrap="true"></TD>' skip
     5930       '<TD text_wrap="true"></TD>' skip
     5931       '<TD text_wrap="true"></TD>' skip
     5932       '<TD text_wrap="true"></TD>' skip
     5933       '<TD text_wrap="true"></TD>' skip
     5934       '<TD text_wrap="true"></TD>' skip
     5935       '<TD text_wrap="true"></TD>' skip
     5936       '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-sum-itog,"->>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: bold;">' + fnc-convert-dot-to-colon(v-sum-itog,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     5937       '</TR>'skip
     5938       .
     5939     put stream OutStr-html unformatted
     5940       '</table>' skip
     5941       '</body>' skip
     5942       '</html>' skip
     5943       .
     5944     output stream OutStr-html close.
     5945     run prn-lib-reportviewer-report-name in this-procedure (
     5946       input THIS-PROCEDURE
     5947       ,input v-file-name-rep-htm
     5948       ).
     5949   PROCEDURE get-report-num :
     5950     define output parameter p-report-num as integer no-undo .
     5951     do
     5952       on error undo, return error return-value
     5953       :
     5954       run gbl/getrpnum.p (output p-report-num).
     5955     end.
     5956   END PROCEDURE.
     5957   procedure clients-write:
     5958     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     5959     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     5960     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     5961     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     5962       and buf_clients.obj-type = p-obj-type no-error .
     5963     if AVAILABLE buf_clients then
     5964     do:
     5965       p-obj-name = buf_clients.obj-name .
     5966     end.
     5967   end.
     5968   end.
     5969   procedure ConvertStr-ext-doc-type:
     5970     define input parameter p-ext-doc-type as character no-undo.
     5971     define output parameter p-name-ext-doc-type as character no-undo.
     5972     define variable v-num-element as integer no-undo.
     5973     v-num-element = lookup(p-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     5974     p-name-ext-doc-type = entry(v-num-element, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U).
     5975     if p-ext-doc-type <> "" and v-num-element = 0 then
     5976     do:
     5977       message "Ошибка 115." view-as alert-box.
     5978       return.
     5979     end.
     5980   end procedure.
