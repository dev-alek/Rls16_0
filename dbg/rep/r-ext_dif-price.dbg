     5415   procedure thbjattr_code_reg :
     5416   define input  parameter p-upper-code     as character no-undo .
     5417   define input  parameter p-code           as character no-undo .
     5418   define output parameter p-label          as character no-undo .
     5419   define output parameter p-user-can-edit  as logical   no-undo .
