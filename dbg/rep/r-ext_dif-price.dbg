      565   define variable var-report-r-b as character no-undo .
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      572   define  shared variable RepPathName        as character no-undo .
      573   define  shared variable PrintRubl          as logical   no-undo .
      574   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      576   procedure cur-time :
      577      define output parameter p-today as date      no-undo .
      578      define output parameter p-time  as integer   no-undo .
      579     do
      580     on error undo, return error
      581     :
      582       define variable v-date1 as date      no-undo .
      583       define variable v-date2 as date      no-undo .
      584       define variable v-time  as integer   no-undo .
      585       assign
      586         v-date1 = today
      587         v-time  = time
      588         v-date2 = today
      589       .
      590       if v-date1 <> v-date2
      591       then do:
      592         assign
      593           v-date1 = today
      594           v-time  = v-time
      595         .
      596       end.
      597       assign
      598         p-today = v-date1
      599         p-time  = v-time
      600       .
      601     end.
      602   end.
      603   function cur-time-date returns character
      604   :
      605     return string(today, '99/99/9999':U) .
      606   end.
      607   function cur-time-mjd returns decimal
      608   :
      609     define variable v-date as date      no-undo .
      610     define variable v-time as integer   no-undo .
      611     run cur-time in this-procedure
      612       (output v-date
      613       ,output v-time
      614       ) .
      615     return integer(v-date) - 2400002 + (v-time / 86400) .
      616   end.
      617   function cur-time-get-ending-index returns integer
      618   (input p-number as integer
      619   )
      620   :
      621     if p-number < 0
      622     or p-number = ?
      623     then do:
      624       return 1 .
      625     end.
      626     define variable v-rest as integer   no-undo .
      627     assign
      628       p-number = p-number modulo 100
      629     .
      630     if p-number < 20
      631     then do:
      632       assign
      633         v-rest = p-number
      634       .
      635     end.
      636     else do:
      637       assign
      638         v-rest = p-number modulo 10
      639       .
      640     end.
      641     case v-rest :
      642       when 1
      643       then do:
      644         return 2 .
      645       end.
      646       when 2 or
      647       when 3 or
      648       when 4
      649       then do:
      650         return 3 .
      651       end.
      652       otherwise do:
      653         return 1 .
      654       end.
      655     end case .
      656   end.
      657   procedure cur-time-mjd-to-date :
      658      define input  parameter i-mjd-diff as decimal no-undo.
      659      define output parameter o-Date     as date    no-undo.
      660      define output parameter o-Time     as integer no-undo.
      661      define variable v-day-number as integer   no-undo .
      662      if    i-mjd-diff < 0
      663         or i-mjd-diff = ?
      664      then do:
      665         return "?" .
      666      end.
      667      assign
      668         v-day-number = truncate(i-mjd-diff,0).
      669         o-Date = date(v-day-number + 2400002).
      670         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      671     .
      672   end.
      673   function cur-time-mjd-to-string returns character
      674   (input p-mjd-diff as decimal
      675   )
      676   :
      677     define variable v-day-number as integer   no-undo .
      678     define variable v-seconds    as integer   no-undo .
      679     define variable v-hour       as integer   no-undo .
      680     define variable v-min        as integer   no-undo .
      681     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      682     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      683     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      684     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      685     if p-mjd-diff < 0
      686     or p-mjd-diff = ?
      687     then do:
      688       return "?" .
      689     end.
      690     assign
      691       v-day-number = integer(truncate(p-mjd-diff,0))
      692       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      693     .
      694     if v-seconds > 86400
      695     then do:
      696       assign
      697         v-seconds = 86400 - 1
      698       .
      699     end.
      700     if v-seconds < 0
      701     then do:
      702       assign
      703         v-seconds = 0
      704       .
      705     end.
      706     assign
      707       v-hour = truncate(v-seconds / 3600, 0)
      708     .
      709     assign
      710       v-seconds = v-seconds modulo 3600
      711     .
      712     assign
      713       v-min = truncate(v-seconds / 60, 0)
      714     .
      715     assign
      716       v-seconds = v-seconds modulo 60
      717     .
      718     return
      719         (if v-day-number <> 0
      720           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      721           else ""
      722         )
      723       + (if v-day-number <> 0 or v-hour <> 0
      724           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      725           else ""
      726         )
      727       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      728           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      729           else ""
      730         )
      731       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      732       .
      733   end.
      734   function cur-time-string returns character
      735   :
      736     define variable v-date as date      no-undo .
      737     define variable v-time as integer   no-undo .
      738     run cur-time in this-procedure
      739       (output v-date
      740       ,output v-time
      741       ) .
      742     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      743   end.
      744   function cur-time-string-sec returns character
      745   :
      746     define variable v-date as date      no-undo .
      747     define variable v-time as integer   no-undo .
      748     run cur-time in this-procedure
      749       (output v-date
      750       ,output v-time
      751       ) .
      752     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      753   end.
      754   function cur-time-custom  returns character
      755   (input p-prefix as character
      756   ,input p-date-format as character
      757   ,input p-delimiter as character
      758   ,input p-time-format as character
      759   ,input p-suffix as character
      760   )
      761   :
      762     define variable v-date as date      no-undo .
      763     define variable v-time as integer   no-undo .
      764     run cur-time in this-procedure
      765       (output v-date
      766       ,output v-time
      767       ) .
      768     return
      769       p-prefix
      770       + string(v-date, p-date-format)
      771       + p-delimiter
      772       + string(v-time, p-time-format)
      773       + p-suffix
      774       .
      775   end.
      776   function cur-time-print  returns character
      777   :
      778     define variable v-date as date      no-undo .
      779     define variable v-time as integer   no-undo .
      780     run cur-time in this-procedure
      781       (output v-date
      782       ,output v-time
      783       ) .
      784     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      785   end.
      786   function cur-time-datetime returns datetime
      787   :
      788     define variable v-char as character no-undo .
      789     define variable v-datetime as datetime no-undo .
      790     v-char = cur-time-string().
      791     v-datetime = datetime(v-char).
      792     return  v-datetime.
      793   end.
      794   function cur-time-string-msec returns character
      795   :
      796     define variable v-date as datetime  no-undo .
      797     v-date = now.
      798     return string(v-date) .
      799   end.
      800   procedure cp-attr-code :
      801     do
      802     on error undo, return error
      803     :
      804       define input  parameter p-code           as character no-undo .
      805       define output parameter p-type           as character no-undo .
      806       define output parameter p-format         as character no-undo .
      807       define output parameter p-label          as character no-undo .
      808       define output parameter p-range          as integer   no-undo .
      809       define output parameter p-user-can-edit  as logical   no-undo .
      810       define output parameter p-output-display as logical   no-undo .
      811       define output parameter p-other          as character no-undo .
      812       case p-code :
      813               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      814               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      815               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      816               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      817               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      818               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      819               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      820               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      821               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      822               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      823         otherwise do:
      824           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      825         end.
      826       end.
      827     end.
      828   end procedure.
      829   procedure cp-attr-tooltip :
      830     do
      831     on error undo, return error
      832     :
      833       define input  parameter p-code    as character no-undo .
      834       define output parameter p-tooltip as character no-undo .
      835       define output parameter p-label   as character no-undo .
      836       case p-code :
      837               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      838               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      839               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      840               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      841               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      842               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      843               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      844               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      845               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      846               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      847         otherwise do:
      848           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      849         end.
      850       end.
      851     end.
      852   end procedure.
      853   procedure cp-attr-value :
      854     do
      855     on error undo, return error
      856     :
      857       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      858       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      859       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      860       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      861       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      862       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      863       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      864       define output parameter p-type        as character no-undo .
      865       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      866       define variable v-format         as character no-undo .
      867       define variable v-label          as character no-undo .
      868       define variable v-range          as integer   no-undo .
      869       define variable v-user-can-edit  as logical   no-undo .
      870       define variable v-output-display as logical   no-undo .
      871       define variable v-other          as character no-undo .
      872       run cp-attr-code in this-procedure
      873         (input  p-code
      874         ,output p-type
      875         ,output v-format
      876         ,output v-label
      877         ,output v-range
      878         ,output v-user-can-edit
      879         ,output v-output-display
      880         ,output v-other
      881         ) no-error .
      882       if error-status :error then do:
      883         undo, return error return-value .
      884       end.
      885       find first buf_cash-pay-attr no-lock
      886         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      887           and buf_cash-pay-attr.curr-code  = p-curr-code
      888           and buf_cash-pay-attr.host-code  = p-host-code
      889           and buf_cash-pay-attr.obj-type   = p-obj-type
      890           and buf_cash-pay-attr.obj-code   = p-obj-code
      891           and buf_cash-pay-attr.attr-code  = p-code
      892         no-error .
      893       if avail buf_cash-pay-attr then do:
      894         assign
      895           p-value =  buf_cash-pay-attr.attr-value
      896         .
      897       end.
      898       else do:
      899         assign
      900           p-value = if p-type = 'L':U then "no":U else ""
      901         .
      902       end.
      903     end.
      904   end procedure.
      905   procedure cp-attr-write :
      906     do
      907     on error undo, return error
      908     :
      909       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      910       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      911       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      912       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      913       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      914       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      915       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      916       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      917       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      918       define variable v-type           as character no-undo .
      919       define variable v-format         as character no-undo .
      920       define variable v-label          as character no-undo .
      921       define variable v-range          as integer   no-undo .
      922       define variable v-user-can-edit  as logical   no-undo .
      923       define variable v-output-display as logical   no-undo .
      924       define variable v-other          as character no-undo .
      925       run cp-attr-code in this-procedure
      926         (input  p-code
      927         ,output v-type
      928         ,output v-format
      929         ,output v-label
      930         ,output v-range
      931         ,output v-user-can-edit
      932         ,output v-output-display
      933         ,output v-other
      934         ) no-error .
      935       if error-status :error then do:
      936         undo, return error return-value .
      937       end.
      938       find first buf_cash-pay-attr exclusive-lock
      939         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      940           and buf_cash-pay-attr.curr-code  = p-curr-code
      941           and buf_cash-pay-attr.host-code  = p-host-code
      942           and buf_cash-pay-attr.obj-type   = p-obj-type
      943           and buf_cash-pay-attr.obj-code   = p-obj-code
      944           and buf_cash-pay-attr.attr-code = p-code
      945         no-error .
      946       if not available buf_cash-pay-attr then do:
      947         create buf_cash-pay-attr .
      948         assign
      949         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      950         buf_cash-pay-attr.curr-code  = p-curr-code
      951         buf_cash-pay-attr.host-code  = p-host-code
      952         buf_cash-pay-attr.obj-type   = p-obj-type
      953         buf_cash-pay-attr.obj-code   = p-obj-code
      954         buf_cash-pay-attr.attr-code = p-code
      955         .
      956       end.
      957       assign
      958         buf_cash-pay-attr.attr-value = p-value
      959       .
      960       release buf_cash-pay-attr no-error .
      961       if error-status:error then do:
      962         undo, return error return-value .
      963       end.
      964     end.
      965   end procedure.
      966   procedure cp-attr-exist :
      967     do
      968     on error undo, return error
      969     :
      970       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      971       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      972       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      973       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      974       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      975       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      976       define output parameter p-exist   as logical  no-undo .
      977       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      978       define variable v-type           as character no-undo .
      979       define variable v-format         as character no-undo .
      980       define variable v-label          as character no-undo .
      981       define variable v-range          as integer   no-undo .
      982       define variable v-user-can-edit  as logical   no-undo .
      983       define variable v-output-display as logical   no-undo .
      984       define variable v-other          as character no-undo .
      985       run cp-attr-code in this-procedure
      986         (input  p-code
      987         ,output v-type
      988         ,output v-format
      989         ,output v-label
      990         ,output v-range
      991         ,output v-user-can-edit
      992         ,output v-output-display
      993         ,output v-other
      994         ) no-error .
      995       if error-status :error then do:
      996         undo, return error return-value .
      997       end.
      998       find first buf_cash-pay-attr exclusive-lock
      999         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1000           and buf_cash-pay-attr.curr-code  = p-curr-code
     1001           and buf_cash-pay-attr.host-code  = p-host-code
     1002           and buf_cash-pay-attr.obj-type   = p-obj-type
     1003           and buf_cash-pay-attr.obj-code   = p-obj-code
     1004           and buf_cash-pay-attr.attr-code = p-code
     1005         no-error .
     1006       if  available buf_cash-pay-attr then do:
     1007         p-exist = yes.
     1008       end.
     1009     end.
     1010   end procedure.
     1011   procedure cp-attr-delete :
     1012     do
     1013     on error undo, return error
     1014     :
     1015       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1016       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1017       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1018       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1019       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1020       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1021       define output parameter p-deleted  as logical no-undo.
     1022       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1023       define variable v-type           as character no-undo .
     1024       define variable v-format         as character no-undo .
     1025       define variable v-label          as character no-undo .
     1026       define variable v-range          as integer   no-undo .
     1027       define variable v-user-can-edit  as logical   no-undo .
     1028       define variable v-output-display as logical   no-undo .
     1029       define variable v-other          as character no-undo .
     1030       run cp-attr-code in this-procedure
     1031         (input  p-code
     1032         ,output v-type
     1033         ,output v-format
     1034         ,output v-label
     1035         ,output v-range
     1036         ,output v-user-can-edit
     1037         ,output v-output-display
     1038         ,output v-other
     1039         ) no-error .
     1040       if error-status :error then do:
     1041         undo, return error return-value .
     1042       end.
     1043       find first buf_cash-pay-attr exclusive-lock
     1044         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1045           and buf_cash-pay-attr.curr-code  = p-curr-code
     1046           and buf_cash-pay-attr.host-code  = p-host-code
     1047           and buf_cash-pay-attr.obj-type   = p-obj-type
     1048           and buf_cash-pay-attr.obj-code   = p-obj-code
     1049           and buf_cash-pay-attr.attr-code = p-code
     1050         no-error NO-WAIT.
     1051       if not available buf_cash-pay-attr then do:
     1052         p-deleted = no.
     1053       end.
     1054       else do:
     1055         delete buf_cash-pay-attr no-error .
     1056         if error-status:error then do:
     1057           undo, return error return-value .
     1058         end.
     1059         p-deleted = yes.
     1060       end.
     1061     end.
     1062   end procedure.
     1063   procedure cp-attr-news :
     1064     do
     1065     on error undo, return error
     1066     :
     1067       define input  parameter p-code           as character no-undo .
     1068       define output parameter p-news           as logical   no-undo .
     1069       case p-code :
     1070               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1071               when 'grp-code':U then do:     assign     p-news = true.   end.
     1072               when 'is-use':U then do:     assign     p-news = true.   end.
     1073               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1074               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1075               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1076               when 'form_km3':U then do:     assign     p-news = false.   end.
     1077               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1078               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1079               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1080         otherwise do:
     1081           p-news = no.
     1082         end.
     1083       end.
     1084     end.
     1085   end procedure.
     1086   procedure cp-attr-hist :
     1087     do
     1088     on error undo, return error
     1089     :
     1090       define input  parameter p-code           as character no-undo .
     1091       define output parameter p-hist           as logical   no-undo .
     1092       case p-code :
     1093               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
     1094               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
     1095               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     1096               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1097               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1098               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1099               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1100         otherwise do:
     1101           p-hist = no.
     1102         end.
     1103       end.
     1104     end.
     1105   end procedure.
     1106   define new global shared variable g#lib-trn  as handle no-undo .
     1107   define new global shared variable g#lib-trn2 as handle no-undo .
     1108   define new global shared variable g#lib-trn3 as handle no-undo .
     1109   define new global shared variable g#lib-trn4 as handle no-undo .
     1110   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1111   define new global shared variable g#trdcalib as handle no-undo.
     1112   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1113                                     iInput AS INTEGER).
     1114     def var v-start-print as integer no-undo .
     1115     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1116     assign
     1117       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1118     .
     1119     RETURN v-start-print .
     1120   END FUNCTION.
     1121   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1122                                     iInput AS INTEGER).
     1123     def var v-start-print as integer no-undo .
     1124     assign
     1125       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1126     .
     1127     if v-start-print < 0 then return 0.
     1128     RETURN v-start-print .
     1129   END FUNCTION.
     1130   define variable vss-include-info11 as character format "X(65)" no-undo
     1131   initial "@(#)$Workfile$ $Revision$".
     1132   define variable v-fmtcli-name          as character    no-undo.
     1133   define variable v-fmtcli-engl-name     as character    no-undo.
     1134   define variable v-fmtcli-addres        as character    no-undo.
     1135   define variable v-fmtcli-post-addres   as character    no-undo.
     1136   define variable v-fmtcli-full-addres   as character    no-undo.
     1137   define variable v-fmtcli-phone         as character    no-undo.
     1138   define variable v-fmtcli-inn           as character    no-undo.
     1139   define variable v-fmtcli-kpp           as character    no-undo.
     1140   define variable v-fmtcli-okpo          as character    no-undo.
     1141   define variable v-fmtcli-country       as character    no-undo.
     1142   define variable v-fmtcli-city          as character    no-undo.
     1143   define variable v-fmtcli-index         as character    no-undo.
     1144   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1145   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1146   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1147   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1148   define variable v-fmtcli-bank-bik      as character    no-undo.
     1149   define variable v-fmtcli-bank-name     as character    no-undo.
     1150   define variable v-fmtcli-bank-addres   as character    no-undo.
     1151   define variable v-fmtcli-bank-city     as character    no-undo.
     1152   procedure fmtcli-get-bank :
     1153   define input parameter p-host-code      as integer          no-undo.
     1154   define input parameter p-obj-type       as character        no-undo.
     1155   define input parameter p-obj-code       as integer          no-undo.
     1156   define input parameter p-curr-code      as integer          no-undo.
     1157       define buffer buf_fin-schet     for ub.fin-schet.
     1158       define buffer buf_fin-bank      for ub.fin-bank.
     1159   do
     1160   for buf_fin-schet
     1161     , buf_fin-bank
     1162   on error undo, return error
     1163   :
     1164       assign
     1165           v-fmtcli-schet-exists       = no
     1166           v-fmtcli-bank-exists        = no
     1167           v-fmtcli-bank-r-schet       = "":U
     1168           v-fmtcli-bank-c-schet       = "":U
     1169           v-fmtcli-bank-bik           = "":U
     1170           v-fmtcli-bank-name          = "":U
     1171           v-fmtcli-bank-addres        = "":U
     1172           v-fmtcli-bank-city          = "":U
     1173       .
     1174       search-for-schet:
     1175       for each buf_fin-schet no-lock
     1176          where buf_fin-schet.host-code = p-host-code
     1177            and buf_fin-schet.cli-type  = p-obj-type
     1178            and buf_fin-schet.cli-code  = p-obj-code
     1179            and buf_fin-schet.curr-code = p-curr-code
     1180       on error undo, return error
     1181       :
     1182           if buf_fin-schet.status_   = 'удал':U
     1183           then do:
     1184           end.
     1185           else do:
     1186               assign
     1187                   v-fmtcli-schet-exists   = yes
     1188                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1189                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1190               .
     1191               find first buf_fin-bank no-lock
     1192                    where buf_fin-bank.host-code = p-host-code
     1193                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1194               no-error.
     1195               if available buf_fin-bank
     1196               then do:
     1197                   assign
     1198                       v-fmtcli-bank-exists      = yes
     1199                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1200                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1201                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1202                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1203                   .
     1204               end.
     1205               else do:
     1206                   assign
     1207                       v-fmtcli-bank-exists    = no
     1208                       v-fmtcli-bank-bik       = "":U
     1209                       v-fmtcli-bank-name      = "":U
     1210                       v-fmtcli-bank-addres    = "":U
     1211                       v-fmtcli-bank-city      = "":U
     1212                   .
     1213               end.
     1214               leave search-for-schet.
     1215           end.
     1216       end.
     1217   end.
     1218   end procedure.
     1219   procedure fmtcli-get-client :
     1220   define input parameter p-obj-type       as character    no-undo.
     1221   define input parameter p-obj-code       as integer      no-undo.
     1222       define variable v-temp-fmtcli-address      as character     no-undo.
     1223       define variable v-num-country-city    as integer      no-undo.
     1224       define buffer buf_clients   for ub.clients.
     1225       define buffer buf_firm      for ub.firm.
     1226       define buffer buf_store     for ub.store.
     1227       define buffer buf_shop      for ub.shop.
     1228       define buffer buf_person    for ub.person.
     1229   do
     1230   for buf_clients
     1231     , buf_firm
     1232     , buf_store
     1233     , buf_shop
     1234     , buf_person
     1235   on error undo, return error
     1236   :
     1237       assign
     1238           v-fmtcli-name           = "":U
     1239           v-fmtcli-addres         = "":U
     1240           v-fmtcli-post-addres    = "":U
     1241           v-fmtcli-full-addres    = "":U
     1242           v-fmtcli-phone          = "":U
     1243           v-fmtcli-inn            = "":U
     1244           v-fmtcli-kpp            = "":U
     1245           v-fmtcli-okpo           = "":U
     1246           v-fmtcli-city           = "":U
     1247           v-fmtcli-index          = "":U
     1248           v-fmtcli-country        = "":U
     1249       .
     1250       find first buf_clients no-lock
     1251            where buf_clients.obj-type = p-obj-type
     1252              and buf_clients.obj-code = p-obj-code
     1253       .
     1254       assign
     1255           v-fmtcli-name = buf_clients.obj-name
     1256       .
     1257       case buf_clients.obj-type:
     1258          when 'орг':U
     1259          then do:
     1260               find first buf_firm no-lock
     1261                    where buf_firm.firm-code = buf_clients.obj-code
     1262                    no-error
     1263               .
     1264               if available buf_firm
     1265               then do:
     1266                   assign
     1267                       v-num-country-city = num-entries( buf_firm.city )
     1268                       v-fmtcli-engl-name = buf_firm.engl-name
     1269                   .
     1270                   if v-num-country-city > 0
     1271                   then do:
     1272                       assign
     1273                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1274                       .
     1275                   end.
     1276                   if v-num-country-city > 1
     1277                   then do:
     1278                       assign
     1279                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1280                       .
     1281                   end.
     1282                   run fmtcli-concatenate-strings in this-procedure (
     1283                         input v-fmtcli-full-addres
     1284                       , input v-fmtcli-country
     1285                       , input ", ":U
     1286                       , input 50
     1287                       , output v-fmtcli-full-addres
     1288                   ).
     1289                   run fmtcli-concatenate-strings in this-procedure (
     1290                         input v-fmtcli-full-addres
     1291                       , input v-fmtcli-city
     1292                       , input ", ":U
     1293                       , input 50
     1294                       , output v-fmtcli-full-addres
     1295                   ).
     1296                   run fmtcli-concatenate-strings in this-procedure (
     1297                         input v-fmtcli-full-addres
     1298                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1299                       , input ", ":U
     1300                       , input 50
     1301                       , output v-fmtcli-full-addres
     1302                   ).
     1303                   run fmtcli-concatenate-strings in this-procedure (
     1304                         input v-fmtcli-post-addres
     1305                       , input v-fmtcli-country
     1306                       , input ", ":U
     1307                       , input 50
     1308                       , output v-fmtcli-post-addres
     1309                   ).
     1310                   run fmtcli-concatenate-strings in this-procedure (
     1311                         input v-fmtcli-post-addres
     1312                       , input v-fmtcli-city
     1313                       , input ", ":U
     1314                       , input 50
     1315                       , output v-fmtcli-post-addres
     1316                   ).
     1317                   run fmtcli-concatenate-strings in this-procedure (
     1318                         input v-fmtcli-post-addres
     1319                       , input string( buf_firm.ind )
     1320                       , input ", ":U
     1321                       , input 50
     1322                       , output v-fmtcli-post-addres
     1323                   ).
     1324                   run fmtcli-concatenate-strings in this-procedure (
     1325                         input substring( buf_firm.addres1, 1, 50 )
     1326                       , input buf_firm.addres2
     1327                       , input " ":U
     1328                       , input 50
     1329                       , output v-temp-fmtcli-address
     1330                   ).
     1331                   run fmtcli-concatenate-strings in this-procedure (
     1332                         input v-temp-fmtcli-address
     1333                       , input substring( buf_firm.addres1, 51, 50 )
     1334                       , input " ":U
     1335                       , input 50
     1336                       , output v-temp-fmtcli-address
     1337                   ).
     1338                   run fmtcli-concatenate-strings in this-procedure (
     1339                         input v-temp-fmtcli-address
     1340                       , input substring( buf_firm.addres1, 101, 50 )
     1341                       , input " ":U
     1342                       , input 50
     1343                       , output v-temp-fmtcli-address
     1344                   ).
     1345                   assign
     1346                       v-fmtcli-addres = v-temp-fmtcli-address
     1347                   .
     1348                   if buf_firm.addres1 <> ?
     1349                   then do:
     1350                       run fmtcli-concatenate-strings in this-procedure (
     1351                             input v-fmtcli-full-addres
     1352                           , input v-fmtcli-addres
     1353                           , input ", ":U
     1354                           , input 0
     1355                           , output v-fmtcli-full-addres
     1356                       ).
     1357                   end.
     1358                   run fmtcli-concatenate-strings in this-procedure (
     1359                         input substring( buf_firm.post-addr1, 1, 50 )
     1360                       , input buf_firm.post-addr2
     1361                       , input " ":U
     1362                       , input 50
     1363                       , output v-fmtcli-post-addres
     1364                   ).
     1365                   run fmtcli-concatenate-strings in this-procedure (
     1366                         input v-fmtcli-post-addres
     1367                       , input substring( buf_firm.post-addr1, 51, 50 )
     1368                       , input " ":U
     1369                       , input 50
     1370                       , output v-fmtcli-post-addres
     1371                   ).
     1372                   run fmtcli-concatenate-strings in this-procedure (
     1373                         input v-fmtcli-post-addres
     1374                       , input substring( buf_firm.post-addr1, 101, 50 )
     1375                       , input " ":U
     1376                       , input 50
     1377                       , output v-fmtcli-post-addres
     1378                   ).
     1379                   assign
     1380                       v-fmtcli-phone         = buf_firm.phone
     1381                       v-fmtcli-inn           = buf_firm.inn
     1382                       v-fmtcli-kpp           = buf_firm.kpp
     1383                       v-fmtcli-okpo          = buf_firm.okpo
     1384                       v-fmtcli-index         = string( buf_firm.ind )
     1385                   .
     1386               end.
     1387          end.
     1388          when 'маг':U
     1389          then do:
     1390               find first buf_shop no-lock
     1391                    where buf_shop.obj-code = buf_clients.obj-code
     1392               .
     1393               if available buf_shop
     1394               then do:
     1395                   run fmtcli-concatenate-strings in this-procedure (
     1396                         input buf_shop.addres1
     1397                       , input buf_shop.addres2
     1398                       , input " ":U
     1399                       , input 50
     1400                       , output v-fmtcli-addres
     1401                   ).
     1402                   assign
     1403                       v-fmtcli-full-addres = v-fmtcli-addres
     1404                       v-fmtcli-post-addres = v-fmtcli-addres
     1405                       v-fmtcli-phone       = buf_shop.phone
     1406                       v-fmtcli-inn         = "":U
     1407                       v-fmtcli-kpp         = "":U
     1408                       v-fmtcli-okpo        = "":U
     1409                       v-fmtcli-city        = "":U
     1410                       v-fmtcli-index       = "":U
     1411                   .
     1412               end.
     1413          end.
     1414          when 'скл':U
     1415          then do:
     1416               find first buf_store no-lock
     1417                    where buf_store.obj-code = buf_clients.obj-code
     1418               .
     1419               if available buf_store
     1420               then do:
     1421                   run fmtcli-concatenate-strings in this-procedure (
     1422                         input buf_store.addres1
     1423                       , input buf_store.addres2
     1424                       , input " ":U
     1425                       , input 50
     1426                       , output v-fmtcli-addres
     1427                   ).
     1428                   assign
     1429                       v-fmtcli-full-addres = v-fmtcli-addres
     1430                       v-fmtcli-phone       = buf_store.phone
     1431                       v-fmtcli-inn         = "":U
     1432                       v-fmtcli-kpp         = "":U
     1433                       v-fmtcli-okpo        = "":U
     1434                       v-fmtcli-city        = "":U
     1435                       v-fmtcli-index       = "":U
     1436                   .
     1437               end.
     1438          end.
     1439          when 'чел':U
     1440          then do:
     1441               find first buf_person no-lock
     1442                    where buf_person.psn-code = buf_clients.obj-code
     1443               .
     1444               if available buf_person
     1445               then do:
     1446                   run fmtcli-concatenate-strings in this-procedure (
     1447                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1448                                 then "":U
     1449                                 else string( buf_person.ind, "999999")
     1450                                 )
     1451                       , input buf_person.city
     1452                       , input ", ":U
     1453                       , input 0
     1454                       , output v-fmtcli-full-addres
     1455                   ).
     1456                   assign
     1457                       v-fmtcli-addres = buf_person.address
     1458                   .
     1459                   run fmtcli-concatenate-strings in this-procedure (
     1460                         input v-fmtcli-full-addres
     1461                       , input v-fmtcli-addres
     1462                       , input ", ":U
     1463                       , input 0
     1464                       , output v-fmtcli-full-addres
     1465                   ).
     1466                   assign
     1467                       v-fmtcli-phone     = buf_person.phone1
     1468                       v-fmtcli-inn       = buf_person.inn
     1469                       v-fmtcli-kpp       = buf_person.kpp
     1470                       v-fmtcli-okpo      = buf_person.okpo
     1471                       v-fmtcli-city      = buf_person.city
     1472                       v-fmtcli-index     = string( buf_person.ind )
     1473                   .
     1474               end.
     1475          end.
     1476       end case.
     1477   end.
     1478   end procedure.
     1479   procedure fmtcli-concatenate-strings :
     1480   define input parameter p-string-1       as character        no-undo.
     1481   define input parameter p-string-2       as character        no-undo.
     1482   define input parameter p-delimiter      as character        no-undo.
     1483   define input parameter p-length         as integer          no-undo.
     1484   define output parameter p-out-string    as character        no-undo.
     1485   do
     1486   on error undo, return error
     1487   :
     1488       assign
     1489           p-out-string = ( if p-string-1 = ?
     1490                            then "":U
     1491                            else trim( p-string-1 ) )
     1492       .
     1493       assign
     1494           p-out-string = p-out-string
     1495                        + ( if p-out-string = "":U
     1496                            or length( p-out-string ) = p-length
     1497                            or p-string-2 = ?
     1498                            or trim( p-string-2 ) = "":U
     1499                            then "":U
     1500                            else p-delimiter )
     1501                        + ( if p-string-2 = ?
     1502                            or trim( p-string-2 ) = "":U
     1503                            then "":U
     1504                            else trim( p-string-2 ) )
     1505       .
     1506   end.
     1507   end procedure.
