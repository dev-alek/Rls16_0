     5187   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5188   define  stream PrnLibStream.
     5189   procedure prn-lib-prn-file :
     5190     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5191     define input parameter p-DIsabledoptions as integer no-undo .
     5192     define variable v-report-name as character no-undo .
     5193     define variable v-user-action as character no-undo .
     5194     define variable v-printed     as logical   no-undo .
     5195     define variable v-exist       as logical   no-undo .
     5196     do
     5197       on error undo, return error
     5198       :
     5199       run prn-lib-get-report-name  in this-procedure (
     5200         input parParentProc
     5201         ,output v-report-name
     5202         ).
     5203   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5204   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     5205     (input  v-report-name
     5206     ,input  2
     5207     ,output v-exist
     5208     )  .
     5209       if NOT v-exist then
     5210       DO:
     5211         Message
     5212           "Нет заданий на печать ! "
     5213           view-as alert-box .
     5214         Return  .
     5215       End.
     5216       run gbl/prnfilen.w
     5217         (input  ""
     5218         ,input  p-DisabledOptions
     5219         ,input  string(v-report-name )
     5220         ,input  7
     5221         ,output v-user-action
     5222         ,output v-printed
     5223         ) .
     5224       if v-printed then
     5225       do:
     5226         return "YES" .
     5227       end.
     5228       else
     5229       do:
     5230         return "NO" .
     5231       end.
     5232     end.
     5233   end procedure.
     5234   procedure prn-lib-open-stream :
     5235     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5236     define input parameter p-page-size    as integer no-undo .
     5237     define input parameter p-is-stream    as logical no-undo .
     5238     define input parameter p-append       as logical no-undo .
     5239     define variable v-report-name as character no-undo .
     5240     do
     5241       on error undo, return error
     5242       :
     5243       run prn-lib-get-report-name  in this-procedure (
     5244         input parParentProc
     5245         ,output v-report-name
     5246         ).
     5247       if p-is-stream then
     5248       do:
     5249         if p-append then
     5250         do:
     5251           output stream PrnLibStream to value( v-report-name )
     5252             page-size value(p-page-size) append .
     5253         end.
     5254         if not p-append then
     5255         do:
     5256           output stream PrnLibStream to value( v-report-name )
     5257             page-size value(p-page-size) .
     5258         end.
     5259       end.
     5260       if not p-is-stream then
     5261       do:
     5262         if p-append then
     5263         do:
     5264           output to value( v-report-name )
     5265             page-size value(p-page-size) append .
     5266         end.
     5267         if not p-append then
     5268         do:
     5269           output to value( v-report-name )
     5270             page-size value(p-page-size) .
     5271         end.
     5272       end.
     5273     end.
     5274   end procedure.
     5275   procedure prn-lib-open-exp :
     5276     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5277     define input parameter p-is-stream    as logical no-undo .
     5278     define input parameter p-is-append    as logical no-undo .
     5279     define output parameter p-ReportFileName as char init "report" no-undo.
     5280     define output parameter p-process as logical no-undo .
     5281     define variable glog as logical no-undo .
     5282     do
     5283       on error undo, return error
     5284       :
     5285       SYSTEM-DIALOG GET-FILE p-ReportFileName
     5286         TITLE      "Укажите путь"
     5287         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     5288         ASK-OVERWRITE
     5289         CREATE-TEST-FILE
     5290         SAVE-AS
     5291         USE-FILENAME
     5292         DEFAULT-EXTENSION "txt"
     5293         UPDATE glog
     5294         .
     5295       if not glog then  return.
     5296       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     5297       if p-is-stream then
     5298       do:
     5299         if p-is-append then
     5300         do:
     5301           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5302         end.
     5303         else
     5304         do:
     5305           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5306         end.
     5307       end.
     5308       else
     5309       do:
     5310         if p-is-append then
     5311         do:
     5312           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5313         end.
     5314         else
     5315         do:
     5316           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5317         end.
     5318       end.
     5319       p-process = yes.
     5320     end.
     5321   end procedure.
     5322   procedure prn-lib-get-report-name :
     5323     define input parameter parParentProc  as widget-handle no-undo.
     5324     define output parameter p-report-name as character no-undo .
     5325     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     5326   end procedure.
     5327   procedure prn-lib-reportviewer-report-name :
     5328     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5329     define input parameter p-report-name-html as character no-undo .
     5330     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     5331   end procedure.
     5332   procedure prn-lib-reportviewer :
     5333     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5334     define input parameter p-report-name-html as character no-undo .
     5335     define input parameter p-param        as character no-undo .
     5336     define variable v-excel           as character no-undo init 'TRUE' .
     5337     define variable v-value-character as character no-undo .
     5338     define variable v-value-integer   as character no-undo .
     5339     define variable v-value-date      as date      no-undo .
     5340     define variable v-value-decimal   as decimal   no-undo .
     5341     define variable rep-excel         as logical   no-undo .
     5342     define variable excel-string      as character no-undo .
     5343     define variable v-param-type      as character no-undo .
     5344     define variable v-tth             as handle    no-undo .
     5345     run adm/shattri.p (
     5346       input "get":U
     5347       ,input  ""
     5348       ,input  0
     5349       ,input  'report-glob':U
     5350       ,input  'rep-excel':U
     5351       ,output v-value-character
     5352       ,output v-value-date
     5353       ,output v-value-decimal
     5354       ,output v-value-integer
     5355       ,output rep-excel
     5356       ,output v-param-type
     5357       ,INPUT-OUTPUT table-handle v-tth
     5358       )  .
     5359     if rep-excel then v-excel = "TRUE" .
     5360     else v-excel = "FALSE" .
     5361     if p-param eq ""
     5362     then
     5363        p-param = "EXCEL:" + v-excel.
     5364     else
     5365        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     5366     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     5367   end procedure.
     5368   function fnc-convert-dot-to-colon returns character
     5369       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     5370   function fnc-convert-dot-to-colon returns character
     5371   (input p-data as decimal, input p-accur as character, input p-num as integer):
     5372       define variable result as character no-undo.
     5373       define variable v-str-result as character no-undo.
     5374       if p-data = ? then p-data = 0 .
     5375       p-data = round(p-data, p-num).
     5376       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     5377       return v-str-result.
     5378   END FUNCTION.
