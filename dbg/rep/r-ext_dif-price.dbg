     2088               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     2089               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     2090               v-torgconf-self-host-phone       = v-fmtcli-phone
     2091               v-torgconf-self-host-inn         = v-fmtcli-inn
     2092               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     2093               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     2094           .
     2095           run gbl/clntat-v.p (
     2096                 input 'орг':U
     2097               , input v-torgconf-self-host-code
     2098               , input 'egrip-date':U
     2099               , output v-torgconf-self-host-egrip-date
     2100               , output v-par-type
     2101           ).
