     2145   procedure torgconf-get-recepient-param :
     2146   define input parameter torgconfdoc-code   as character                  no-undo.
     2147   define output parameter v-code-rec        as integer                    no-undo .
     2148   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     2149   define output parameter v-codefirm-rec    as integer                    no-undo .
     2150   define output parameter v-curcode-rec     as integer                    no-undo .
     2151        define variable  v-recipient-code  as character                  no-undo .
     2152        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     2153        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     2154   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     2155                           input 'Recipient':U ,
     2156                          output v-recipient-code ,
     2157                          output v-trdcattr-type ) no-error .
     2158       if error-status :error then do:
     2159        message
     2160         vss-workfile vss-revision vss-description skip
     2161         "Ошибка при вызове процедуры tdat-val":U skip
     2162         "Документ: " torgconfdoc-code skip
     2163         "Атрибут: " 'Recipient':U skip
     2164         "Значение: " v-recipient skip
     2165         trim( error-status :get-message (1) ) skip
     2166         return-value skip
     2167         view-as alert-box error.
     2168       undo, return error return-value.
     2169       end.
     2170     assign
     2171       v-recipient  = v-recipient-code
     2172       v-type-rec = substring(v-recipient-code,1,3)
     2173       v-code-rec  = int(substring(v-recipient-code,4,15))
     2174       no-error
     2175     .
     2176     if v-type-rec = ? then v-type-rec = "" .
     2177     if v-code-rec  = ? then v-code-rec  =  0 .
     2178     end procedure.
