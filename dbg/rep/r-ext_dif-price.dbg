     5431   do
     5432   on error undo, return error return-value
     5433   :
     5434       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     5435       (input  p-upper-code
     5436       ,input  p-code
     5437       ,output p-label
     5438       ,output p-user-can-edit
     5439       ,output p-output-display
     5440       ,output p-other
     5441       ,output p-prop-list
     5442       ,output p-prop-type-list
     5443       ,output p-prop-label-list
     5444       ,output p-global
     5445       ,output p-host
     5446       ,output p-shop
     5447       ,output p-store
     5448       ,output p-db
     5449       ,output p-region
     5450       ) no-error .
     5451     if error-status :error
     5452     then do:
     5453       undo, return error substitute( "&1. &2&3&4", vss-include-info27, return-value, chr(10), error-status :get-message (1)).
     5454     end.
