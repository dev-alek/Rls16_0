     4441                  run rep/get-psn.p
     4442                  (input buf_wth-doc.deliver
     4443                  ,output v-torgconf-ogr-name
     4444                  ) .
     4445               end.
     4446               find first buf_person no-lock
     4447               where buf_person.psn-code = buf_wth-doc.deliver
     4448               no-error.
     4449               if available buf_person
     4450               then do:
     4451                  v-torgconf-ogr-post = buf_person.position.
     4452               end.
     4453               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4454               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4455            end.
     4456      end.
     4457   end.
     4458   procedure torgconf-get-reason  :
     4459   define input parameter  p-doc-code       as character        no-undo.
     4460   define input parameter  p-reason-code    as integer          no-undo .
     4461   define input parameter  p-doc-type       as character        no-undo.
     4462       if p-reason-code > 0
     4463       then do:
     4464           define buffer buf_trn-reason for ub.trn-reason.
     4465           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4466           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4467       end.
     4468       else do:
     4469           if p-doc-type = 'при':U
     4470           then  do:
     4471               define variable v-attr-type     as character    no-undo.
     4472               define variable v-attr-value    as character    no-undo.
     4473               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4474               assign v-torgconf-reason = v-attr-value .
     4475               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4476               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4477           end.
     4478       end.
     4479   end procedure.
