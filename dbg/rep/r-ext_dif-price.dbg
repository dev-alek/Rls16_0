     2374   procedure torgconf-get-sup-param :
     2375   define input parameter p-obj-type           as character        no-undo.
     2376   define input parameter p-obj-code           as integer          no-undo.
     2377   define input parameter p-curr-code          as integer          no-undo.
     2378       define variable v-host-code    as integer      no-undo.
     2379       define variable v-par-type     as character    no-undo.
     2380   do
     2381   on error undo, return error
     2382   :
     2383       assign
     2384          v-torgconf-sup-host-code = v-host-code
     2385       .
     2386       if v-torgconf-sup-host-code = 0
     2387       then do:
     2388           assign
     2389               v-torgconf-sup-host-name           = "":U
     2390               v-torgconf-sup-host-addres         = "":U
     2391               v-torgconf-sup-host-post-addres    = "":U
     2392               v-torgconf-sup-host-phone          = "":U
     2393               v-torgconf-sup-host-inn            = "":U
     2394               v-torgconf-sup-host-kpp            = "":U
     2395               v-torgconf-sup-host-okpo           = "":U
     2396               v-torgconf-sup-host-egrip-date     = "":U
     2397               v-torgconf-sup-host-egrip-num      = "":U
     2398           .
     2399       end.
     2400       else do:
     2401           run fmtcli-get-client in this-procedure (
     2402                 input 'орг':U
     2403               , input v-torgconf-sup-host-code
     2404           ).
     2405           assign
     2406               v-torgconf-sup-host-name        = v-fmtcli-name
     2407               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2408               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2409               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2410               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2411               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2412               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2413               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2414           .
     2415           run gbl/clntat-v.p (
     2416                 input 'орг':U
     2417               , input v-torgconf-sup-host-code
     2418               , input 'egrip-date':U
     2419               , output v-torgconf-sup-host-egrip-date
     2420               , output v-par-type
     2421           ).
     2422           run gbl/clntat-v.p (
     2423                 input 'орг':U
     2424               , input v-torgconf-sup-host-code
     2425               , input 'egrip-num':U
     2426               , output v-torgconf-sup-host-egrip-num
     2427               , output v-par-type
     2428           ).
     2429           run fmtcli-get-bank in this-procedure (
     2430                 input v-host-code
     2431               , input 'орг':U
     2432               , input v-torgconf-sup-host-code
     2433               , input p-curr-code
     2434           ).
     2435       end.
     2436       assign
     2437           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2438           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2439           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2440           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2441           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2442           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2443           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2444           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2445       .
     2446       assign
     2447           v-torgconf-sup-obj-type = p-obj-type
     2448           v-torgconf-sup-obj-code = p-obj-code
     2449       .
     2450       if trim(p-obj-type) <> ""
     2451       and p-obj-code <> 0
     2452       then do:
     2453       run fmtcli-get-client in this-procedure (
     2454             input p-obj-type
     2455           , input p-obj-code
     2456       ).
     2457       assign
     2458           v-torgconf-sup-obj-name        = v-fmtcli-name
     2459           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2460           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2461           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2462           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2463           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2464           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2465       .
     2466      end.
     2467      end.
     2468   end procedure.
     2469   procedure torgconf-get-cli-param :
     2470   define input parameter p-host-obj-code      as integer          no-undo.
     2471   define input parameter p-obj-type           as character        no-undo.
     2472   define input parameter p-obj-code           as integer          no-undo.
     2473   define input parameter p-curr-code          as integer          no-undo.
     2474       define variable v-host-code    as integer      no-undo.
     2475   do
     2476   on error undo, return error
     2477   :
     2478       assign
     2479           v-torgconf-cli-type = p-obj-type
     2480           v-torgconf-cli-code = p-obj-code
     2481       .
     2482       run fmtcli-get-client in this-procedure (
     2483             input p-obj-type
     2484           , input p-obj-code
     2485       ).
     2486       assign
     2487           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2488           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2489           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2490           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2491           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2492           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2493           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2494           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2495       .
     2496      run fmtcli-get-bank in this-procedure (
     2497             input p-host-obj-code
     2498           , input p-obj-type
     2499           , input p-obj-code
     2500           , input p-curr-code
     2501       ).
     2502       assign
     2503           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2504           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2505           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2506           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2507           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2508           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2509           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2510           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2511       .
     2512   end.
     2513   end procedure.
     2514   procedure torgconf-get-ship-param :
     2515   define input parameter p-host-obj-code      as integer          no-undo.
     2516   define input parameter p-obj-type           as character        no-undo.
     2517   define input parameter p-obj-code           as integer          no-undo.
     2518   define input parameter p-curr-code          as integer          no-undo.
     2519       define variable v-host-code    as integer      no-undo.
     2520   do
     2521   on error undo, return error
     2522   :
     2523       assign
     2524           v-torgconf-ship-type = p-obj-type
     2525           v-torgconf-ship-code = p-obj-code
     2526       .
     2527       if trim(p-obj-type) = ""
     2528       and p-obj-code = 0
     2529       then do:
     2530       assign
     2531           v-torgconf-ship-name         = "":U
     2532           v-torgconf-ship-addres       = "":U
     2533           v-torgconf-ship-post-addres  = "":U
     2534           v-torgconf-ship-phone        = "":U
     2535           v-torgconf-ship-inn          = "":U
     2536           v-torgconf-ship-kpp          = "":U
     2537           v-torgconf-ship-okpo         = "":U
     2538       .
     2539       end.
     2540       else do:
     2541       run fmtcli-get-client in this-procedure (
     2542             input p-obj-type
     2543           , input p-obj-code
     2544       ).
     2545       assign
     2546           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2547           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2548           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2549           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2550           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2551           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2552           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2553           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2554       .
     2555       end.
     2556           run fmtcli-get-bank in this-procedure (
     2557             input p-host-obj-code
     2558           , input p-obj-type
     2559           , input p-obj-code
     2560           , input p-curr-code
     2561       ).
     2562       assign
     2563           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2564           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2565           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2566           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2567           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2568           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2569           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2570           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2571       .
     2572   end.
     2573   end procedure.
     2574   procedure torgconf-get-holdfirm-code :
     2575   define input parameter p-obj-type   as character        no-undo.
     2576   define input parameter p-obj-code   as integer          no-undo.
     2577   define output parameter p-firm-code as integer          no-undo.
     2578       define variable v-firm-code-str     as character    no-undo.
     2579       define variable v-par-type          as character    no-undo.
     2580       define buffer buf_clients       for ub.clients.
     2581   do
     2582   for buf_clients
     2583   on error undo, return error
     2584   :
     2585       run gbl/clntat-v.p (
     2586             input p-obj-type
     2587           , input p-obj-code
     2588           , input 'holdfirm-code':U
     2589           , output v-firm-code-str
     2590           , output v-par-type
     2591       ).
     2592       assign
     2593           p-firm-code = integer( v-firm-code-str )
     2594       no-error.
     2595       if error-status :error
     2596       then do:
     2597           message
     2598               "Неверно задан код фирмы для печати накладных."
     2599           view-as alert-box warning.
     2600           assign
     2601               p-firm-code = 0
     2602           .
     2603       end.
     2604       else do:
     2605           find first buf_clients no-lock
     2606                where buf_clients.obj-type = 'орг':U
     2607                  and buf_clients.obj-code = p-firm-code
     2608           no-error.
     2609           if not available buf_clients
     2610           then do:
     2611               message
     2612                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2613                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2614               view-as alert-box warning.
     2615               assign
     2616                   p-firm-code = 0
     2617               .
     2618           end.
     2619       end.
     2620   end.
     2621   end procedure.
     2622   procedure torgconf-get-post-head:
     2623   define input  parameter p-obj-type             as character        no-undo.
     2624   define input  parameter p-obj-code             as integer          no-undo.
     2625   define output parameter p-torgconf-post-head   as character        no-undo.
     2626      define variable v-host-code         as integer      no-undo.
     2627      define buffer buf_sysconf     for ub.sysconf.
     2628        assign
     2629         p-torgconf-post-head  = ""
     2630        .
     2631   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2633     (input  p-obj-type
     2634     ,input  p-obj-code
     2635     ,output v-host-code
     2636     )  .
     2637      find first buf_sysconf no-lock
     2638      where buf_sysconf.host-code = v-host-code
     2639      no-error.
     2640      if available buf_sysconf
     2641      then do:
     2642         assign
     2643            p-torgconf-post-head = buf_sysconf.head-position
     2644         .
     2645      end.
     2646   end procedure.
     2647   procedure torgconf-get-storekeeper:
     2648   define input  parameter p-wrkr                   as integer          no-undo.
     2649   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2650   define output parameter p-torgconf-post          as character        no-undo.
     2651      define buffer buf_sysconf     for ub.sysconf.
     2652      define buffer buf_person      for ub.person.
     2653      define buffer buf_shop        for ub.shop .
     2654      define buffer buf_store       for ub.store .
     2655      if v-torgconf-outC = "no_print"
     2656      then do:
     2657         assign p-torgconf-post = ""
     2658                p-torgconf-wrkr-name = ""
     2659                .
     2660      end.
     2661      if v-torgconf-outC = "clad_doc"
     2662      then do:
     2663         run rep/get-psn.p
     2664               (input  p-wrkr
     2665               ,output p-torgconf-wrkr-name
     2666               ) .
     2667         find first buf_person no-lock
     2668         where buf_person.psn-code = p-wrkr
     2669         no-error.
     2670         if available buf_person
     2671         then do:
     2672           p-torgconf-post = buf_person.position.
     2673         end.
     2674         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2675         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2676      end.
     2677      if v-torgconf-outC = "clad_obj"
     2678      then do:
     2679         CASE v-torgconf-self-obj-type:
     2680         WHEN 'маг':U
     2681         THEN DO:
     2682            find first buf_shop no-lock
     2683            where buf_shop.obj-code = v-torgconf-self-obj-code
     2684            .
     2685            assign
     2686               p-torgconf-wrkr-name = buf_shop.store-man
     2687               p-torgconf-post = ""
     2688            .
     2689            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2690         END.
     2691         WHEN 'скл':U
     2692         THEN DO:
     2693            find first buf_store no-lock
     2694            where buf_store.obj-code = v-torgconf-self-obj-code
     2695            .
     2696            assign
     2697               p-torgconf-wrkr-name = buf_store.store-man
     2698               p-torgconf-post = ""
     2699            .
     2700            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2701         END.
     2702         OTHERWISE DO:
     2703            assign
     2704               p-torgconf-post = "":U
     2705               p-torgconf-wrkr-name = "":U
     2706            .
     2707         END.
     2708         END CASE.
     2709      end.
     2710    end procedure.
     2711   procedure torgconf-get-form-header :
     2712   define input parameter p-for-inverse    as logical          no-undo.
     2713   define input parameter p-doc-code       as character        no-undo.
     2714   define input parameter p-print-doc      as logical          no-undo.
     2715   define input parameter p-doc-date       as date             no-undo.
     2716   define input parameter p-fact-date      as date             no-undo.
     2717   define input parameter p-doc-type       as character        no-undo.
     2718   define input parameter p-status_        as character        no-undo.
     2719   define input parameter p-reverse        as logical          no-undo.
     2720   define input parameter p-sf-par         as logical          no-undo.
     2721       define variable v-attr-type         as character    no-undo.
     2722       define variable v-doc-code-standard as logical      no-undo.
     2723       define variable v-doc-date-standard as logical      no-undo.
     2724       define variable v-par-consignee-addres  as character    no-undo.
     2725       define variable v-host-code         as integer      no-undo.
     2726       define variable v-dcode-attr        as character    no-undo.
     2727       define variable v-ddate-attr        as character    no-undo.
     2728       define variable v-doc-date          as character    no-undo.
     2729       define variable v-doc-code          as character    no-undo.
     2730       define variable v-par-type          as character    no-undo.
     2731       define variable v-attr              as character    no-undo.
     2732       define buffer buf_firm          for ub.firm .
     2733       define buffer buf_clients       for ub.clients .
     2734       define buffer buf_sysconf       for ub.sysconf .
     2735       define buffer buf_shop          for ub.shop .
     2736       define buffer buf_store         for ub.store .
     2737       define buffer buf_person        for ub.person .
     2738       define buffer buf_trn-doc       for ub.trn-doc .
     2739       define buffer buf_wth-doc       for ub.wth-doc .
     2740       do
     2741   for buf_firm
     2742     , buf_clients
     2743     , buf_sysconf
     2744     , buf_shop
     2745     , buf_trn-doc
     2746     , buf_person
     2747     , buf_wth-doc
     2748   on error undo, return error
     2749   :
     2750       if p-doc-type = 'при':U
     2751       or p-doc-type = 'возврат':U
     2752       then do:
     2753           assign
     2754               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2755                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2756               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2757                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2758               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2759                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2760               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2761                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2762               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2763               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2764               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2765               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2766               v-torgconf-supplier-type    = v-torgconf-cli-type
     2767               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2768               v-torgconf-saler-type       = v-torgconf-self-host-type
     2769               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2770               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2771               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2772               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2773               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2774               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2775               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2776               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2777               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2778               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2779               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2780               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2781               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2782               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2783               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2784           .
     2785           if v-torgconf-cli-schet-exists = yes
     2786           AND v-form-name                  = "torg12":U
     2787           then do:
     2788               assign
     2789                   v-torgconf-supplier = v-torgconf-supplier
     2790                       + substitute( ", р/с &1 к/с &2"
     2791                                   , v-torgconf-cli-bank-r-schet
     2792                                   , v-torgconf-cli-bank-c-schet
     2793                                   )
     2794                   v-torgconf-suppi = v-torgconf-supplier
     2795                       + substitute( ", р/с &1 к/с &2"
     2796                                   , v-torgconf-cli-bank-r-schet
     2797                                   , v-torgconf-cli-bank-c-schet
     2798                                   )
     2799               .
     2800               if v-torgconf-cli-bank-exists = yes
     2801               then do:
     2802                   assign
     2803                       v-torgconf-supplier = v-torgconf-supplier
     2804                           + substitute( " БИК &1 в &2 &3"
     2805                                       , v-torgconf-cli-bank-bik
     2806                                       , v-torgconf-cli-bank-name
     2807                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2808                                       )
     2809                      v-torgconf-suppi = v-torgconf-supplier
     2810                           + substitute( " БИК &1 в &2 &3"
     2811                                       , v-torgconf-cli-bank-bik
     2812                                       , v-torgconf-cli-bank-name
     2813                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2814                                       )
     2815                   .
     2816               end.
     2817           end.
     2818           if v-torgconf-self-schet-exists = yes
     2819           AND v-form-name                  = "torg12":U
     2820           then do:
     2821               assign
     2822                   v-torgconf-saler = v-torgconf-saler
     2823                       + substitute( ", р/с &1 к/с &2"
     2824                                   , v-torgconf-self-bank-r-schet
     2825                                   , v-torgconf-self-bank-c-schet
     2826                                   )
     2827               .
     2828               if v-torgconf-self-bank-exists = yes
     2829               then do:
     2830                   assign
     2831                       v-torgconf-saler = v-torgconf-saler
     2832                           + substitute( " БИК &1 в &2 &3"
     2833                                       , v-torgconf-self-bank-bik
     2834                                       , v-torgconf-self-bank-name
     2835                                       , v-torgconf-self-bank-addres
     2836                                       )
     2837                   .
     2838               end.
     2839           end.
     2840           if v-torgconf-sup-schet-exists = yes
     2841           AND v-form-name                  = "torg12":U
     2842           then do:
     2843               assign
     2844                   v-torgconf-consignee = v-torgconf-consignee
     2845                       + substitute( ", р/с &1 к/с &2"
     2846                                   , v-torgconf-sup-bank-r-schet
     2847                                   , v-torgconf-sup-bank-c-schet
     2848                                   )
     2849               .
     2850             if v-torgconf-sup-bank-exists = yes
     2851              then do:
     2852                assign
     2853                   v-torgconf-consignee = v-torgconf-consignee
     2854                           + substitute( " БИК &1 в &2 &3"
     2855                                       , v-torgconf-sup-bank-bik
     2856                                       , v-torgconf-sup-bank-name
     2857                                       , v-torgconf-sup-bank-addres
     2858                                       )
     2859                   .
     2860               end.
     2861           end.
     2862      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2863      then do:
     2864          assign
     2865            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2866                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2867                                                   , v-torgconf-cli-name
     2868                                                   , ( if v-torgconf-outprncd = yes
     2869                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2870                                                         else "":U )
     2871                                                   , v-torgconf-cli-post-addres
     2872                                                   , v-torgconf-cli-phone
     2873                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2874                                                       AND v-form-name                  = "torg12":U
     2875                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2876                                                               , v-torgconf-cli-bank-r-schet
     2877                                                               , v-torgconf-cli-bank-c-schet
     2878                                                               , v-torgconf-cli-bank-bik
     2879                                                               , v-torgconf-cli-bank-name
     2880                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2881                                                         else "":U )
     2882                                                )
     2883         .
     2884      end.
     2885       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2886                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2887                                        , v-torgconf-cli-name
     2888                                        , ( if v-torgconf-outprncd = yes
     2889                                            then substitute( " (&1)", v-torgconf-cli-code )
     2890                                            else "":U )
     2891                                        , v-torgconf-cli-addres
     2892                                        , v-torgconf-cli-phone
     2893                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2894                                            AND v-form-name                  = "torg12":U
     2895                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2896                                                           , v-torgconf-cli-bank-r-schet
     2897                                                           , v-torgconf-cli-bank-c-schet
     2898                                                           , v-torgconf-cli-bank-bik
     2899                                                           , v-torgconf-cli-bank-name
     2900                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2901                                                   else "":U )
     2902                                        ).
     2903       end.
     2904       else do:
     2905       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2906                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2907                                        , v-torgconf-self-host-name
     2908                                        , ( if v-torgconf-outprncd = yes
     2909                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2910                                            else "":U )
     2911                                        , v-torgconf-self-host-addres
     2912                                        , v-torgconf-self-host-phone
     2913                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2914                                            AND v-form-name                  = "torg12":U
     2915                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2916                                                           , v-torgconf-self-bank-r-schet
     2917                                                           , v-torgconf-self-bank-c-schet
     2918                                                           , v-torgconf-self-bank-bik
     2919                                                           , v-torgconf-self-bank-name
     2920                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2921                                                   else "":U )
     2922                                           ).
     2923         if v-torgconf-outares = yes
     2924         and p-reverse = no
     2925         then do:
     2926            assign
     2927               v-par-consignee-addres = v-torgconf-ship-post-addres
     2928            .
     2929         end.
     2930         if v-torgconf-outares = no
     2931         and p-reverse = no
     2932         then do:
     2933            assign
     2934               v-par-consignee-addres = v-torgconf-ship-addres
     2935            .
     2936         end.
     2937         if p-reverse = yes
     2938         then do:
     2939             assign
     2940               v-par-consignee-addres = v-torgconf-ship-addres
     2941             .
     2942         end.
     2943           assign
     2944               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2945                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2946               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2947                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2948               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2949                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2950               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2951               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2952               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2953               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2954               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2955               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2956               v-torgconf-saler-type       = v-torgconf-cli-type
     2957               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2958               v-torgconf-consignee-type   = v-torgconf-ship-type
     2959               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2960               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2961               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2962               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2963               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2964               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2965               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2966               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2967               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2968               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2969               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2970               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2971               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2972               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2973               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2974               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2975               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2976           .
     2977           if v-torgconf-self-schet-exists = yes
     2978           AND v-form-name                  = "torg12":U
     2979           then do:
     2980               assign
     2981                   v-torgconf-supplier = v-torgconf-supplier
     2982                       + substitute( ", р/с &1 к/с &2"
     2983                                   , v-torgconf-self-bank-r-schet
     2984                                   , v-torgconf-self-bank-c-schet
     2985                                   )
     2986               .
     2987               if v-torgconf-self-bank-exists = yes
     2988               then do:
     2989                   assign
     2990                       v-torgconf-supplier = v-torgconf-supplier
     2991                           + substitute( " БИК &1 в &2 &3"
     2992                                       , v-torgconf-self-bank-bik
     2993                                       , v-torgconf-self-bank-name
     2994                                       , v-torgconf-self-bank-addres
     2995                                       )
     2996                   .
     2997               end.
     2998           end.
     2999           if v-torgconf-cli-schet-exists = yes
     3000           AND v-form-name                  = "torg12":U
     3001           then do:
     3002               assign
     3003                   v-torgconf-saler = v-torgconf-saler
     3004                       + substitute( ", р/с &1 к/с &2"
     3005                                   , v-torgconf-cli-bank-r-schet
     3006                                   , v-torgconf-cli-bank-c-schet
