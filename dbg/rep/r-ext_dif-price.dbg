     2112               , input v-torgconf-self-host-code
     2113               , input p-curr-code
     2114           ).
     2115       end.
     2116       assign
     2117           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     2118           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     2119           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
