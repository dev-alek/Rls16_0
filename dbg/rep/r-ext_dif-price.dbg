     4515   def var vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4516   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4517   procedure paramls-clear :
     4518     define buffer buf_temp-param for temp-param .
     4519     do
     4520     on error undo, return error return-value
     4521     :
     4522       for each buf_temp-param
     4523       on error undo, return error
     4524       :
     4525         delete buf_temp-param .
     4526       end.
     4527     end.
     4528   end procedure.
     4529   procedure paramls-write :
     4530     define input  parameter p-code     as character no-undo .
     4531     define input  parameter p-sub-code as character no-undo .
     4532     define input  parameter p-value    as character no-undo .
     4533     define buffer buf_temp-param for temp-param .
     4534     do
     4535     on error undo, return error return-value
     4536     :
     4537       find first buf_temp-param
     4538         where buf_temp-param.param-code     = p-code
     4539           and buf_temp-param.param-sub-code = p-sub-code
     4540         no-error .
     4541       if not available buf_temp-param then do:
     4542         create buf_temp-param .
     4543         assign
     4544           buf_temp-param.param-code     = p-code
     4545           buf_temp-param.param-sub-code = p-sub-code
     4546         .
     4547       end.
     4548       assign
     4549         buf_temp-param.param-value = p-value
     4550       .
     4551     end.
     4552   end procedure.
     4553   procedure paramls-read :
     4554     define input  parameter p-code          as character no-undo .
     4555     define input  parameter p-sub-code      as character no-undo .
     4556     define input  parameter p-default-value as character no-undo .
     4557     define output parameter p-value         as character no-undo .
     4558     define buffer buf_temp-param for temp-param .
     4559     do
     4560     on error undo, return error return-value
     4561     :
     4562       find first buf_temp-param
     4563         where buf_temp-param.param-code     = p-code
     4564           and buf_temp-param.param-sub-code = p-sub-code
     4565         no-error .
     4566       if available buf_temp-param then do:
     4567         assign
     4568           p-value = buf_temp-param.param-value
     4569         .
     4570       end.
     4571       else do:
     4572         assign
     4573           p-value = p-default-value
     4574         .
     4575       end.
     4576     end.
     4577   end procedure.
     4578   procedure paramls-append :
     4579     define input  parameter p-code     as character no-undo .
     4580     define input  parameter p-sub-code as character no-undo .
     4581     define input  parameter p-value    as character no-undo .
     4582     define buffer buf_temp-param for temp-param .
     4583     do
     4584     on error undo, return error return-value
     4585     :
     4586       find first buf_temp-param
     4587            where buf_temp-param.param-code     = p-code
     4588              and buf_temp-param.param-sub-code = p-sub-code
     4589         no-error .
     4590       if not available buf_temp-param then do:
     4591         create buf_temp-param .
     4592         assign
     4593           buf_temp-param.param-code     = p-code
     4594           buf_temp-param.param-sub-code = p-sub-code
     4595           buf_temp-param.param-value    = p-value
     4596         .
     4597       end.
     4598       else do:
     4599           assign
     4600               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4601           .
     4602       end.
     4603     end.
     4604   end procedure.
