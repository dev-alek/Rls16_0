     2076               v-torgconf-self-host-egrip-date     = "":U
     2077               v-torgconf-self-host-egrip-num      = "":U
     2078           .
     2079       end.
     2080       else do:
     2081           run fmtcli-get-client in this-procedure (
     2082                 input 'орг':U
     2083               , input v-torgconf-self-host-code
     2084           ).
