     1718   procedure wthcattr-sprcli :
     1719   define input parameter parparentproc  as widget-handle no-undo.
     1720   define input parameter p-mode  as character no-undo.
     1721   define input-output parameter p-value as character no-undo .
     1722   define output parameter p-setted as logical no-undo .
     1723     DEFINE VARIABLE v-value as character no-undo .
     1724     define variable v-cli-type as character no-undo .
     1725     define variable v-cli-code as integer no-undo .
     1726     define buffer buf_clients   for ub.clients.
     1727     define variable v_rid as character no-undo.
     1728     define variable ref-rec as recid no-undo .
     1729     do
     1730     on error undo, return error
     1731     :
     1732         v-value = p-value.
     1733      if p-value <> '':U then do:
     1734       assign
     1735       v-cli-type = substring(p-value, 1, 3)
     1736       v-cli-code = integer(substring(p-value, 4))
     1737       no-error.
     1738       if error-status:error then do:
     1739         assign
     1740         v-cli-type = '':U
     1741         v-cli-code = 0
     1742         .
     1743       end.
     1744      end.
     1745      FIND FIRST buf_clients NO-LOCK WHERE
     1746               buf_clients.obj-type = v-cli-type AND
     1747               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1748      IF available(buf_clients) then do:
     1749       run ref/cli-all.w (
     1750                   input parparentproc
     1751                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1752                  ,input v-cli-type
     1753                  ,input 'все':U
     1754                  ,input 'все':U
     1755                  ,input RECID( buf_clients )
     1756                  ,input ",,,,,,NO"
     1757                  ,input ?
     1758                  ,OUTPUT v_rid ).
     1759     END.
     1760     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1761       run ref/cli-all.w (
     1762                    input parparentproc
     1763                   ,INPUT "b-sel":U
     1764                  ,input  v-cli-type
     1765                  ,input 'все':U
     1766                  ,input 'текущие':U
     1767                  ,input ?
     1768                  ,input ",,,,,,NO"
     1769                  ,input ?
     1770                  ,OUTPUT v_rid ).
     1771     END.
     1772     else do:
     1773       message
     1774       if p-value = "":U then 'Атрибут не задан!'
     1775       else substitute('Не найден клиент &1',p-value)
     1776       view-as alert-box warning.
     1777     end.
     1778     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1779       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1780       IF ERROR-STATUS:ERROR THEN DO:
     1781           RETURN NO-APPLY.
     1782       END.
     1783       FIND FIRST buf_clients NO-LOCK WHERE
     1784                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1785       IF AVAIL buf_clients THEN DO:
     1786         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1787       end.
     1788     end.
     1789     if v-value <> p-value then do:
     1790       p-value = v-value.
     1791       p-setted = yes.
     1792     end.
     1793     end.
     1794   end procedure.
     1795     define new global shared variable g#wthcalib as handle no-undo.
     1796   procedure torgconf-read :
     1797   do
     1798   on error undo, return error
     1799   :
     1800       define input parameter p-form-name  as character    no-undo.
     1801       define input parameter p-host-code  as integer      no-undo.
     1802       define input parameter p-obj-type   as character    no-undo.
     1803       define input parameter p-obj-code   as integer      no-undo.
     1804       define variable v-outdate   as character     no-undo.
     1805       define variable v-outares   as character     no-undo.
     1806       define variable v-outsend   as character     no-undo.
     1807       define variable v-outasend  as character     no-undo.
     1808       define variable v-outprops  as character     no-undo.
     1809       define variable v-outnum    as character     no-undo.
     1810       define variable v-outprim   as character     no-undo.
     1811       define variable v-outdisc   as character     no-undo.
     1812       define variable v-outsubs   as character     no-undo.
     1813       define variable v-outrecv   as character     no-undo.
     1814       define variable v-outegrp   as character     no-undo.
     1815       define variable v-outt12    as character     no-undo.
     1816       define variable v-outappr   as character     no-undo.
     1817       define variable v-outrubl   as character     no-undo.
