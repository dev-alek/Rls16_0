     2870         "  для партии с датой прихода" string(buf_temp-last-date.last-date, '99/99/9999':u) skip
     2871         "  будет установлена дата 'Годен до'" string(buf_temp-last-date.last-date + v-date-offset, '99/99/9999':u) skip
     2872         "" skip
     2873         "Продолжить?" skip
     2874         view-as alert-box question buttons yes-no update v-ok .
     2875       run last-date-set-from-old in this-procedure
     2876         (input  v-date-offset
     2877         ) .
     2878     end.
     2879     else do:
     2880       message
     2881         "Отсутствуют партии с заданным сроком годности" skip
     2882         view-as alert-box information .
     2883     end.
     2884   END.
     2885   ON CHOOSE OF b-set-last-date IN FRAME Dialog-Frame
     2886   DO:
     2887   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2888   if lookup(self :type
     2889            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2890            ) = 0
     2891   then do:
     2892     message
     2893       "$Workfile$"
     2894       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2895       "Интерфейсный элемент" self :name  skip
     2896       "Тип" self :type  skip
     2897       "Процедура" this-procedure :file-name skip
     2898       view-as alert-box .
     2899   end.
     2900   else do:
     2901     apply "entry":u to self  .
     2902     if focus :handle <> self :handle  then do:
     2903       return no-apply .
     2904     end.
     2905   end.
     2906     define variable v-last-date as date      no-undo .
     2907     define variable v-ok        as logical   no-undo .
     2908     define buffer buf_temp-last-date for temp-last-date .
     2909     find first buf_temp-last-date
     2910       no-error .
     2911     if available buf_temp-last-date
     2912     then do:
     2913       run gbl/d-inpday.w
     2914         (
     2915          input ?
     2916         ,input "Выбор даты"
     2917         ,input "Годен до &1 (для партии товара)"
     2918         ,input ""
     2919         ,input-output v-last-date
     2920         ,output v-ok
     2921         ).
     2922       if v-ok = true
     2923       then do:
     2924         run last-date-set-date in this-procedure
     2925           (input  v-last-date
     2926           ) .
     2927       end.
     2928     end.
     2929     else do:
     2930       message
     2931         "Не выбрано ни одной партии" skip
     2932         view-as alert-box information .
     2933     end.
     2934   END.
     2935   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
     2936   DO:
     2937     if available query_temp-last-date
     2938     then do:
     2939       run sel-date in this-procedure
     2940         (input query_temp-last-date.new-last-date :handle in browse BROWSE-1
     2941         ,input "Годен до &1 (для партии товара)"
     2942         ) .
     2943     end.
     2944   END.
     2945   ON ROW-DISPLAY OF BROWSE-1 IN FRAME Dialog-Frame
     2946   DO:
     2947     if available query_temp-last-date
     2948     then do:
     2949       if query_temp-last-date.new-last-date <> query_temp-last-date.last-date
     2950       then do:
     2951         assign
     2952           query_temp-last-date.new-last-date :fgcolor in browse BROWSE-1 = BROWN_COLOR
     2953         .
     2954       end.
     2955       else do:
     2956         assign
     2957           query_temp-last-date.new-last-date :fgcolor in browse BROWSE-1 = BLACK_COLOR
     2958         .
     2959       end.
     2960     end.
     2961   END.
     2962   ON ROW-LEAVE OF BROWSE-1 IN FRAME Dialog-Frame
     2963   DO:
     2964     if available query_temp-last-date
     2965     then do:
     2966       assign
     2967         browse BROWSE-1 query_temp-last-date.new-last-date
     2968       .
     2969       if query_temp-last-date.new-last-date <> query_temp-last-date.last-date
     2970       then do:
     2971         assign
     2972           query_temp-last-date.new-last-date :fgcolor in browse BROWSE-1 = BROWN_COLOR
     2973         .
     2974       end.
     2975       else do:
     2976         assign
     2977           query_temp-last-date.new-last-date :fgcolor in browse BROWSE-1 = BLACK_COLOR
     2978         .
     2979       end.
     2980       display
     2981         query_temp-last-date.new-last-date with browse BROWSE-1 .
     2982     end.
     2983   END.
     2984   ON VALUE-CHANGED OF RS-filter IN FRAME Dialog-Frame
     2985   DO:
     2986   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
