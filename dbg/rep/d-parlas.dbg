     2433         VIEW-AS TEXT
     2434        SIZE 7.75 BY .67 NO-UNDO.
     2435   DEFINE VARIABLE RS-filter AS INTEGER
     2436        VIEW-AS RADIO-SET HORIZONTAL
     2437        RADIO-BUTTONS
     2438             "Все", 1,
     2439   "Отредактированные", 2,
     2440   "Неизменённые", 3
     2441        SIZE 46.25 BY .92
     2442        FGCOLOR 4  NO-UNDO.
     2443   DEFINE RECTANGLE rect-flt
     2444        EDGE-PIXELS 0
     2445        SIZE 0.1 BY 0.1
     2446        BGCOLOR 8 .
     2447   DEFINE NEW SHARED BUFFER query_temp-last-date FOR temp-last-date .
     2448   DEFINE NEW SHARED  QUERY BROWSE-1 FOR
     2449         query_temp-last-date SCROLLING.
     2450   DEFINE BROWSE BROWSE-1
