     2569         "Сохранить данные?"
     2570         view-as alert-box question buttons yes-no-cancel update v-ok .
     2571       if v-ok = true
     2572       then do:
     2573         run save-data in this-procedure
     2574           no-error .
     2575         if error-status :error
     2576         then do:
     2577           message
     2578             vss-workfile vss-revision vss-description skip
     2579             "Ошибка при сохранении данных" skip
     2580             error-status :get-message(1) skip
     2581             return-value skip
     2582             view-as alert-box error .
     2583           return no-apply .
     2584         end.
     2585       end.
     2586       if v-ok = ?
     2587       then do:
     2588         return no-apply .
     2589       end.
     2590     end.
     2591     APPLY "END-ERROR":U TO SELF.
     2592   END.
