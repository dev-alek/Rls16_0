     3010   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3011   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3012   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3013   on help of frame Dialog-Frame
     3014   do:
     3015     run gbl/app_help.p
     3016       (input this-procedure :file-name
     3017       ,input ''
     3018       ,input ?
     3019       ) no-error.
     3020     if error-status :error then do:
     3021       message
     3022         "Ошибка при вызове помощи"
     3023         error-status :get-message(1)
     3024         view-as alert-box .
     3025     end.
     3026   end.
     3027   run minbtn-set in this-procedure .
     3028   on choose of b-help in frame Dialog-Frame
     3029   do:
     3030     apply "help":u to frame Dialog-Frame .
     3031   end.
     3032   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3033   procedure minbtn-set :
     3034       do
     3035           on error undo, return error return-value
     3036           :
     3037           define variable ii              as integer       no-undo .
     3038           define variable fh              as widget-handle no-undo .
     3039           define variable hh              as widget-handle no-undo .
     3040           define variable v-h             as handle        extent 4 no-undo .
     3041           define variable v-name-button   as character     no-undo .
     3042           define variable v-help-old-x    as decimal       no-undo .
     3043           define variable v-help-old-y    as decimal       no-undo .
     3044           define variable v-help-old-size as decimal       no-undo .
     3045           define variable v-frame-width   as decimal       no-undo .
     3046           define variable jj              as integer       no-undo .
     3047           do
     3048               on error undo, return error
     3049               :
     3050               assign
     3051                   v-frame-width = frame Dialog-Frame:width - 0.3
     3052                   fh            = frame Dialog-Frame:first-child
     3053                   hh            = fh:first-child
     3054                   ii            = 1
     3055                   .
     3056               do while valid-handle(hh):
     3057                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3058                   do:
     3059                       case lc(hh:name) :
     3060                           when "b-help" then
     3061                               do:
     3062                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3063                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3064                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3065                                   hh:TOOLTIP = "Помощь" .
     3066                                   v-help-old-x = hh:column .
     3067                                   v-help-old-y = hh:row    .
     3068                                   v-help-old-size = hh:width .
     3069                                   hh:width-chars = 2.5 .
     3070                               end.
     3071                           when "b-print" then
     3072                               do:
     3073                                   hh:load-image("cmp/b-print.bmp":u) .
     3074                                   hh:TOOLTIP = "Печать" .
     3075                                   v-h[ii] = hh:handle .
     3076                                   ii = ii + 1 .
     3077                                   hh:width-chars = 3 .
     3078                               end.
     3079                           when "b-history" or
     3080                           when "b-hist" then
     3081                               do:
     3082                                   hh:load-image("cmp/b-hist.bmp":u) .
     3083                                   hh:TOOLTIP = "История" .
     3084                                   v-h[ii] = hh:handle .
     3085                                   ii = ii + 1 .
     3086                                   hh:width-chars = 3 .
     3087                               end.
     3088                           when "b-sch" then
     3089                               do:
     3090                                   hh:load-image("cmp/b-sch.bmp":u) .
     3091                                   hh:TOOLTIP = "Установка Фильтра" .
     3092                                   v-h[ii] = hh:handle .
     3093                                   ii = ii + 1 .
     3094                                   hh:width-chars = 3 .
     3095                               end.
     3096                           when "b-hist-user" then
     3097                               do:
     3098                                   hh:load-image("cmp/b-hist.bmp":u) .
     3099                                   hh:TOOLTIP = "История пользователя" .
     3100                                   ii = ii + 1 .
     3101                               end.
     3102                       end case.
     3103                   end.
     3104                   hh = hh:next-sibling.
     3105               end.
     3106               b-help:column = v-frame-width - b-help:width-chars.
     3107               jj = 0.
     3108               repeat ii = 4 to 1 by -1 :
     3109                   if valid-handle (v-h[ii] ) then
     3110                   do:
     3111                       jj  = jj + 1 .
     3112                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3113                       v-h[ii]:row    = v-help-old-y .
     3114                   end.
     3115               end.
     3116           end.
     3117       end.
     3118   end procedure.
     3119   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3120   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3121   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3122   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3123   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3124   define variable v-diasize-current-frame-height as decimal   no-undo .
     3125   define variable v-diasize-change-size          as logical   no-undo .
     3126   define variable v-diasize-resize-button        as handle    no-undo .
     3127   define variable v-diasize-wndmax               as logical   no-undo .
     3128   define variable v-diasize-wndstore             as logical   no-undo .
     3129   define variable v-diasize-proc-name            as character no-undo .
     3130   define variable v-diasize-browse-handle        as handle    no-undo .
     3131   define variable v-diasize-browse-number        as integer   no-undo .
     3132   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3133   define temp-table temp-diasize-handle no-undo
     3134     field handle-value  as handle
     3135     field save-position as decimal
     3136     index xpk is primary unique handle-value
     3137     .
     3138   define temp-table temp-browse-handle no-undo
     3139     field browse-type   as character
     3140     field browse-number as integer
     3141     field browse-handle as handle
     3142     field original-size as decimal
     3143     index xpk is primary unique browse-type browse-number
     3144     index xie browse-type browse-handle
     3145   .
     3146   procedure diasize_change-height :
     3147     define input  parameter p-change-value  as decimal   no-undo .
     3148     define input  parameter p-move-resize   as logical   no-undo .
     3149     define variable v-field-group-handle    as handle    no-undo .
     3150     define variable v-object-handle         as handle    no-undo .
     3151     define variable v-frame-height          as decimal   no-undo .
     3152     define variable v-frame-virtual-height  as decimal   no-undo .
     3153     define variable v-browse-height         as decimal   no-undo .
     3154     define variable v-window-height         as decimal   no-undo .
     3155     define variable v-window-virtual-height as decimal   no-undo .
     3156     define variable v-change-sign           as integer   no-undo .
     3157     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3158     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3159     if p-change-value > 0
     3160     then do:
     3161       if frame Dialog-Frame :height + p-change-value
     3162           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3163       then do:
     3164         assign
     3165           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3166                           - (frame Dialog-Frame :height-chars)
     3167         .
     3168         if p-change-value <= 0
     3169         then do:
     3170           run diasize_position-resize-button in this-procedure .
     3171           return .
     3172         end.
     3173       end.
     3174     end.
     3175     if p-change-value < 0
     3176     then do:
     3177       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3178       then do:
     3179         assign
     3180           p-change-value = v-diasize-orig-frame-height
     3181                          - (frame Dialog-Frame :height-chars)
     3182         .
     3183         if p-change-value >= 0
     3184         then do:
     3185           run diasize_position-resize-button in this-procedure .
     3186           return .
     3187         end.
     3188       end.
     3189     end.
     3190     if p-change-value >= 0
     3191     then do:
     3192       assign
     3193         v-change-sign = 1
     3194       .
     3195     end.
     3196     else do:
     3197       assign
     3198         v-change-sign = -1
     3199       .
     3200     end.
     3201     assign
     3202       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3203     .
     3204     if p-change-value = 0
     3205     then do:
     3206       run diasize_position-resize-button in this-procedure .
     3207       return .
     3208     end.
     3209     move_block:
     3210     do
     3211     on error undo move_block, retry move_block
     3212     :
     3213       if retry
     3214       then do:
     3215         do
     3216         on error undo move_block, leave move_block
     3217         :
     3218           if p-change-value > 0
     3219           then do:
     3220             for each buf_temp-diasize-handle
     3221             on error undo, next
     3222             :
     3223               assign
     3224                 v-object-handle = buf_temp-diasize-handle.handle-value
     3225               .
     3226               if v-object-handle <> v-diasize-resize-button
     3227               then do:
     3228                 assign
     3229                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3230                 .
     3231               end.
     3232             end.
     3233             assign
     3234               v-diasize-browse-handle :height = v-browse-height
     3235             .
     3236             for each buf_temp-browse-handle
     3237               where buf_temp-browse-handle.browse-type = 'height':u
     3238             on error undo, next
     3239             :
     3240               assign
     3241                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3242               .
     3243             end.
     3244             assign
     3245               frame Dialog-Frame :height = v-frame-height
     3246             .
     3247             if frame Dialog-Frame :scrollable = true
     3248             then do:
     3249               assign
     3250                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3251               .
     3252             end.
     3253             run diasize_position-resize-button in this-procedure .
     3254           end.
     3255           else do:
     3256             if frame Dialog-Frame :scrollable = true
     3257             then do:
     3258               assign
     3259                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3260               .
     3261             end.
     3262             assign
     3263               frame Dialog-Frame :height = v-frame-height
     3264             .
     3265             assign
     3266               v-diasize-browse-handle :height = v-browse-height
     3267             .
     3268             for each buf_temp-browse-handle
     3269               where buf_temp-browse-handle.browse-type = 'height':u
     3270             on error undo, next
     3271             :
     3272               assign
     3273                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3274               .
     3275             end.
     3276             for each buf_temp-diasize-handle
     3277             on error undo, next
     3278             :
     3279               assign
     3280                 v-object-handle = buf_temp-diasize-handle.handle-value
     3281               .
     3282               if v-object-handle <> v-diasize-resize-button
     3283               then do:
     3284                 assign
     3285                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3286                 .
     3287               end.
     3288             end.
     3289             run diasize_position-resize-button in this-procedure .
     3290           end.
     3291           assign
     3292             v-diasize-change-size = false
     3293           .
     3294           leave move_block .
     3295         end.
     3296       end.
     3297       assign
     3298         v-diasize-need-full-display = true
     3299       .
     3300       if v-diasize-change-size = false
     3301       then do:
     3302         assign
     3303           v-diasize-change-size = true
     3304         .
     3305       end.
     3306       else do:
     3307         return .
     3308       end.
     3309       assign
     3310         v-frame-height = frame Dialog-Frame :height
     3311         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3312         v-browse-height = v-diasize-browse-handle :height
     3313       .
     3314       for each buf_temp-browse-handle
     3315         where buf_temp-browse-handle.browse-type = 'height':u
     3316       :
     3317         assign
     3318           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3319         .
     3320       end.
     3321       for each buf_temp-diasize-handle
     3322       :
     3323         delete buf_temp-diasize-handle .
     3324       end.
     3325       assign
     3326         v-field-group-handle = frame Dialog-Frame :first-child
     3327       .
     3328       do while valid-handle(v-field-group-handle)
     3329       :
     3330         assign
     3331           v-object-handle = v-field-group-handle :first-child
     3332         .
     3333         do while valid-handle(v-object-handle)
     3334         :
     3335           if  v-object-handle <> v-diasize-browse-handle :handle
     3336           and can-query(v-object-handle, "row")
     3337           and can-query(v-object-handle, "height")
     3338           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3339           then do:
     3340             find first buf_temp-browse-handle
     3341               where buf_temp-browse-handle.browse-type   = 'height':u
     3342                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3343               no-error .
     3344             if available buf_temp-browse-handle
     3345             then do:
     3346             end.
     3347             else do:
     3348               create buf_temp-diasize-handle .
     3349               assign
     3350                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3351                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3352               .
     3353             end.
     3354           end.
     3355           assign
     3356             v-object-handle = v-object-handle :next-sibling
     3357           .
     3358         end.
     3359         assign
     3360           v-field-group-handle = v-field-group-handle :next-sibling
     3361         .
     3362       end.
     3363       do with frame Dialog-Frame
     3364       :
     3365         hide v-diasize-resize-button .
     3366         assign
     3367           v-diasize-resize-button :row    = 1
     3368           v-diasize-resize-button :column = 1
     3369         .
     3370       end.
     3371       if p-change-value > 0
     3372       then do:
     3373         if frame Dialog-Frame :scrollable = true
     3374         then do:
     3375           assign
     3376             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3377             no-error .
     3378           if error-status :error
     3379           or error-status :get-message(1) <> ""
     3380           then do:
     3381             undo move_block, retry move_block .
     3382           end.
     3383         end.
     3384         assign
     3385           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3386           no-error .
     3387         if error-status :error
     3388         or error-status :get-message(1) <> ""
     3389         then do:
     3390           undo move_block, retry move_block .
     3391         end.
     3392         assign
     3393           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3394           no-error .
     3395         if error-status :error
     3396         or error-status :get-message(1) <> ""
     3397         then do:
     3398           undo move_block, retry move_block .
     3399         end.
     3400         for each buf_temp-browse-handle
     3401           where buf_temp-browse-handle.browse-type = 'height':u
     3402         on error undo move_block, retry move_block
     3403         :
     3404           assign
     3405             buf_temp-browse-handle.browse-handle :height
     3406               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3407             no-error .
     3408           if error-status :error
     3409           or error-status :get-message(1) <> ""
     3410           then do:
     3411             undo move_block, retry move_block .
     3412           end.
     3413         end.
     3414         for each buf_temp-diasize-handle
     3415         on error undo move_block, retry move_block
     3416         :
     3417           assign
     3418             v-object-handle = buf_temp-diasize-handle.handle-value
     3419           .
     3420           if v-object-handle <> v-diasize-resize-button
     3421           then do:
     3422             assign
     3423               v-object-handle :row = v-object-handle :row + p-change-value
     3424               no-error .
     3425             if error-status :error
     3426             or error-status :get-message(1) <> ""
     3427             then do:
     3428               undo move_block, retry move_block .
     3429             end.
     3430           end.
     3431         end.
     3432       end.
     3433       else do:
     3434         for each buf_temp-diasize-handle
     3435         on error undo move_block, retry move_block
     3436         :
     3437           assign
     3438             v-object-handle = buf_temp-diasize-handle.handle-value
     3439           .
     3440           if v-object-handle <> v-diasize-resize-button
     3441           then do:
     3442             assign
     3443               v-object-handle :row = v-object-handle :row + p-change-value
     3444               no-error .
     3445             if error-status :error
     3446             or error-status :get-message(1) <> ""
     3447             then do:
     3448               undo move_block, retry move_block .
     3449             end.
     3450           end.
     3451         end.
     3452         assign
     3453           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3454           no-error .
     3455         if error-status :error
     3456         or error-status :get-message(1) <> ""
     3457         then do:
     3458           undo move_block, retry move_block .
     3459         end.
     3460         for each buf_temp-browse-handle
     3461           where buf_temp-browse-handle.browse-type = 'height':u
     3462         on error undo move_block, retry move_block
     3463         :
     3464           assign
     3465             buf_temp-browse-handle.browse-handle :height
     3466               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3467             no-error .
     3468           if error-status :error
     3469           or error-status :get-message(1) <> ""
     3470           then do:
     3471             undo move_block, retry move_block .
     3472           end.
     3473         end.
     3474         assign
     3475           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3476           no-error .
     3477         if error-status :error
     3478         or error-status :get-message(1) <> ""
     3479         then do:
     3480           undo move_block, retry move_block .
     3481         end.
     3482         if frame Dialog-Frame :scrollable = true
     3483         then do:
     3484           assign
     3485             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3486             no-error .
     3487           if error-status :error
     3488           or error-status :get-message(1) <> ""
     3489           then do:
     3490             undo move_block, retry move_block .
     3491           end.
     3492         end.
     3493       end.
     3494       if p-move-resize = true
     3495       then do:
     3496         run diasize_position-resize-button in this-procedure .
     3497       end.
     3498       if v-diasize-wndstore = true
     3499       then do:
     3500         if connected("ub") = true
     3501         then do:
     3502           define variable v-cntxt-db-num        as integer   no-undo .
     3503           define variable v-cntxt-userid        as character no-undo .
     3504           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3505                                             , OUTPUT v-cntxt-userid
     3506                                             ) .
     3507           run gbl/wndsizew.p
     3508             (input  v-cntxt-db-num
     3509             ,input  v-cntxt-userid
     3510             ,input  v-diasize-proc-name
     3511             ,input  'height':u
     3512             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3513             ) .
     3514         end.
     3515       end.
     3516     end.
     3517     assign
     3518       v-diasize-change-size = false
     3519     .
     3520   end procedure.
     3521   procedure diasize_set-height :
     3522     define input  parameter p-new-height  as decimal   no-undo .
     3523     define input  parameter p-move-resize as logical   no-undo .
     3524     do
     3525     on error undo, return error return-value
     3526     :
     3527       run diasize_change-height in this-procedure
     3528         (input  (p-new-height - frame Dialog-Frame :height)
     3529         ,input  p-move-resize
     3530         ) .
     3531     end.
     3532   end procedure.
     3533   procedure diasize_change-width :
     3534     define input  parameter p-change-value as decimal   no-undo .
     3535     define input  parameter p-move-resize  as logical   no-undo .
     3536     define variable v-field-group-handle   as handle    no-undo .
     3537     define variable v-object-handle        as handle    no-undo .
     3538     define variable v-frame-width          as decimal   no-undo .
     3539     define variable v-frame-virtual-width  as decimal   no-undo .
     3540     define variable v-browse-width         as decimal   no-undo .
     3541     define variable v-window-width         as decimal   no-undo .
     3542     define variable v-window-virtual-width as decimal   no-undo .
     3543     define variable v-change-sign          as integer   no-undo .
     3544     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3545     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3546     if p-change-value > 0
     3547     then do:
     3548       if frame Dialog-Frame :width + p-change-value >
     3549           session :width-chars
     3550       then do:
     3551         assign
     3552           p-change-value = session :width-chars - frame Dialog-Frame :width
     3553         .
     3554         if p-change-value <= 0
     3555         then do:
     3556           run diasize_position-resize-button in this-procedure .
     3557           return .
     3558         end.
     3559       end.
     3560     end.
     3561     if p-change-value < 0
     3562     then do:
     3563       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3564       then do:
     3565         assign
     3566           p-change-value = v-diasize-orig-frame-width
     3567                          - frame Dialog-Frame :width
     3568         .
     3569         if p-change-value >= 0
     3570         then do:
     3571           run diasize_position-resize-button in this-procedure .
     3572           return .
     3573         end.
     3574       end.
     3575     end.
     3576     if p-change-value >= 0
     3577     then do:
     3578       assign
     3579         v-change-sign = 1
     3580       .
     3581     end.
     3582     else do:
     3583       assign
     3584         v-change-sign = -1
     3585       .
     3586     end.
     3587     assign
     3588       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3589     .
     3590     if p-change-value = 0
     3591     then do:
     3592       run diasize_position-resize-button in this-procedure .
     3593       return .
     3594     end.
     3595     move_block:
     3596     do
     3597     on error undo move_block, leave move_block
     3598     :
     3599       if retry
     3600       then do:
     3601         do
     3602         on error undo move_block, leave move_block
     3603         :
     3604           if p-change-value > 0
     3605           then do:
     3606             for each buf_temp-diasize-handle
     3607             on error undo, next
     3608             :
     3609               assign
     3610                 v-object-handle = buf_temp-diasize-handle.handle-value
     3611               .
     3612               if v-object-handle <> v-diasize-resize-button
     3613               then do:
     3614                 assign
     3615                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3616                 .
     3617               end.
     3618             end.
     3619             assign
     3620               v-diasize-browse-handle :width = v-browse-width
     3621             .
     3622             for each buf_temp-browse-handle
     3623               where buf_temp-browse-handle.browse-type = 'width':u
     3624             on error undo, next
     3625             :
     3626               assign
     3627                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3628               .
     3629             end.
     3630             assign
     3631               frame Dialog-Frame :width = v-frame-width
     3632             .
     3633             if frame Dialog-Frame :scrollable = true
     3634             then do:
     3635               assign
     3636                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3637               .
     3638             end.
     3639             run diasize_position-resize-button in this-procedure .
     3640           end.
     3641           else do:
     3642             if frame Dialog-Frame :scrollable = true
     3643             then do:
     3644               assign
     3645                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3646               .
     3647             end.
     3648             assign
     3649               frame Dialog-Frame :width = v-frame-width
     3650             .
     3651             for each buf_temp-browse-handle
     3652               where buf_temp-browse-handle.browse-type = 'width':u
     3653             on error undo, next
     3654             :
     3655               assign
     3656                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3657               .
     3658             end.
     3659             assign
     3660               v-diasize-browse-handle :width = v-browse-width
     3661             .
     3662             for each buf_temp-diasize-handle
     3663             on error undo, next
     3664             :
     3665               assign
     3666                 v-object-handle = buf_temp-diasize-handle.handle-value
     3667               .
     3668               if v-object-handle <> v-diasize-resize-button
     3669               then do:
     3670                 assign
     3671                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3672                 .
     3673               end.
     3674             end.
     3675             run diasize_position-resize-button in this-procedure .
     3676           end.
     3677           assign
     3678             v-diasize-change-size = false
     3679           .
     3680           leave move_block .
     3681         end.
     3682       end.
     3683       assign
     3684         v-diasize-need-full-display = true
     3685       .
     3686       if v-diasize-change-size = false
     3687       then do:
     3688         assign
     3689           v-diasize-change-size = true
     3690         .
     3691       end.
     3692       else do:
     3693         return .
     3694       end.
     3695       assign
     3696         v-frame-width = frame Dialog-Frame :width
     3697         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3698         v-browse-width = v-diasize-browse-handle :width
     3699       .
     3700       for each buf_temp-browse-handle
     3701         where buf_temp-browse-handle.browse-type = 'width':u
     3702       :
     3703         assign
     3704           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3705         .
     3706       end.
     3707       for each buf_temp-diasize-handle
     3708       :
     3709         delete buf_temp-diasize-handle .
     3710       end.
     3711       assign
     3712         v-field-group-handle = frame Dialog-Frame :first-child
     3713       .
     3714       do while valid-handle(v-field-group-handle)
     3715       :
     3716         assign
     3717           v-object-handle = v-field-group-handle :first-child
     3718         .
     3719         do while valid-handle(v-object-handle)
     3720         :
     3721           if  v-object-handle <> v-diasize-browse-handle :handle
     3722           and v-object-handle <> v-diasize-resize-button
     3723           and can-query(v-object-handle, "row")
     3724           and can-query(v-object-handle, "height")
     3725           and ( v-object-handle :col + v-object-handle :width
     3726                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3727               )
     3728           then do:
     3729             find first buf_temp-browse-handle
     3730               where buf_temp-browse-handle.browse-type   = 'width':u
     3731                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3732               no-error .
     3733             if available buf_temp-browse-handle
     3734             then do:
     3735             end.
     3736             else do:
     3737               create buf_temp-diasize-handle .
     3738               assign
     3739                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3740                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3741               .
     3742             end.
     3743           end.
     3744           assign
     3745             v-object-handle = v-object-handle :next-sibling
     3746           .
     3747         end.
     3748         assign
     3749           v-field-group-handle = v-field-group-handle :next-sibling
     3750         .
     3751       end.
     3752       do with frame Dialog-Frame
     3753       :
     3754         hide v-diasize-resize-button .
     3755         v-diasize-resize-button :row = 1.
     3756         v-diasize-resize-button :column = 1.
     3757       end.
     3758       if p-change-value > 0
     3759       then do:
     3760         if frame Dialog-Frame :scrollable = true
     3761         then do:
     3762           assign
     3763             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3764             no-error .
     3765           if error-status :error
     3766           or error-status :get-message(1) <> ""
     3767           then do:
     3768             undo move_block, retry move_block.
     3769           end.
     3770         end.
     3771         assign
     3772           frame Dialog-Frame :width = v-frame-width + p-change-value
     3773           no-error .
     3774         if error-status :error
     3775         or error-status :get-message(1) <> ""
     3776         then do:
     3777           undo move_block, retry move_block.
     3778         end.
     3779         assign
     3780           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3781         no-error .
     3782         if error-status :error
     3783         or error-status :get-message(1) <> ""
     3784         then do:
     3785           undo move_block, retry move_block.
     3786         end.
     3787         for each buf_temp-browse-handle
     3788           where buf_temp-browse-handle.browse-type = 'width':u
     3789         on error undo move_block, retry move_block
     3790         :
     3791           assign
     3792             buf_temp-browse-handle.browse-handle :width
     3793               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3794             no-error .
     3795           if error-status :error
     3796           or error-status :get-message(1) <> ""
     3797           then do:
     3798             undo move_block, retry move_block .
     3799           end.
     3800         end.
     3801         for each buf_temp-diasize-handle
     3802         on error undo move_block, retry move_block
     3803         :
     3804           assign
     3805             v-object-handle = buf_temp-diasize-handle.handle-value
     3806           .
     3807           if v-object-handle <> v-diasize-resize-button
     3808           then do:
     3809             assign
     3810               v-object-handle :col = v-object-handle :col + p-change-value
     3811               no-error .
     3812             if error-status :error
     3813             or error-status :get-message(1) <> ""
     3814             then do:
     3815               undo move_block, retry move_block .
     3816             end.
     3817           end.
     3818         end.
     3819       end.
     3820       else do:
     3821         for each buf_temp-diasize-handle
     3822         on error undo move_block, retry move_block
     3823         :
     3824           assign
     3825             v-object-handle = buf_temp-diasize-handle.handle-value
     3826           .
     3827           if v-object-handle <> v-diasize-resize-button
     3828           then do:
     3829             assign
     3830               v-object-handle :col = v-object-handle :col + p-change-value
     3831               no-error .
     3832             if error-status :error
     3833             or error-status :get-message(1) <> ""
     3834             then do:
     3835               undo move_block, retry move_block .
     3836             end.
     3837           end.
     3838         end.
     3839         for each buf_temp-browse-handle
     3840           where buf_temp-browse-handle.browse-type = 'width':u
     3841         on error undo move_block, retry move_block
     3842         :
     3843           assign
     3844             buf_temp-browse-handle.browse-handle :width
     3845               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3846             no-error .
     3847           if error-status :error
     3848           or error-status :get-message(1) <> ""
     3849           then do:
     3850             undo move_block, retry move_block .
     3851           end.
     3852         end.
     3853         assign
     3854           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3855           no-error .
     3856         if error-status :error
     3857         or error-status :get-message(1) <> ""
     3858         then do:
     3859           undo move_block, retry move_block.
     3860         end.
     3861         assign
     3862           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3863         no-error .
     3864         if error-status :error
     3865         or error-status :get-message(1) <> ""
     3866         then do:
     3867           undo move_block, retry move_block.
     3868         end.
     3869         if frame Dialog-Frame :scrollable = true
     3870         then do:
     3871           assign
     3872             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3873           no-error .
     3874           if error-status :error
     3875           or error-status :get-message(1) <> ""
     3876           then do:
     3877             undo move_block, retry move_block.
     3878           end.
     3879         end.
     3880       end.
     3881       if p-move-resize
     3882       then do:
     3883         run diasize_position-resize-button in this-procedure .
     3884       end.
     3885       if v-diasize-wndstore = true
     3886       then do:
     3887         if connected("ub") = true
     3888         then do:
     3889           define variable v-cntxt-db-num        as integer   no-undo .
     3890           define variable v-cntxt-userid        as character no-undo .
     3891           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3892                                             , OUTPUT v-cntxt-userid
     3893                                             ) .
     3894           run gbl/wndsizew.p
     3895             (input  v-cntxt-db-num
     3896             ,input  v-cntxt-userid
     3897             ,input  v-diasize-proc-name
     3898             ,input  'width':u
     3899             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3900             ) .
     3901         end.
     3902       end.
     3903     end.
     3904     assign
     3905       v-diasize-change-size = false
     3906     .
     3907   end procedure.
     3908   procedure diasize_set-width :
     3909     define input  parameter p-new-width  as decimal   no-undo .
     3910     define input  parameter p-move-resize as logical   no-undo .
     3911     do
     3912     on error undo, return error return-value
     3913     :
     3914       run diasize_change-width in this-procedure
     3915         (input  (p-new-width - frame Dialog-Frame :width)
     3916         ,input  p-move-resize
     3917         ) .
     3918     end.
     3919   end procedure.
     3920   procedure diasize_position-resize-button :
     3921     do with frame Dialog-Frame
     3922     :
     3923       hide v-diasize-resize-button .
     3924       assign
     3925         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3926                     - 1
     3927                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3928         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3929                     - 1
     3930                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3931       .
     3932       view v-diasize-resize-button .
     3933     end.
     3934   end procedure.
     3935   on alt-right anywhere
     3936   do:
     3937     run diasize_change-width in this-procedure
     3938       (input 1
     3939       ,input true
     3940       ) .
     3941     return no-apply .
     3942   end.
     3943   on alt-left anywhere
     3944   do:
     3945     run diasize_change-width in this-procedure
     3946       (input -1
     3947       ,input true
     3948       ) .
     3949     return no-apply .
     3950   end.
     3951   on alt-down anywhere
     3952   do:
     3953     run diasize_change-height in this-procedure
     3954       (input 1
     3955       ,input true
     3956       ) .
     3957     return no-apply .
     3958   end.
     3959   on alt-up anywhere
     3960   do:
     3961     run diasize_change-height in this-procedure
     3962       (input -1
     3963       ,input true
     3964       ) .
     3965     return no-apply .
     3966   end.
     3967   on alt-enter of frame Dialog-Frame
     3968   do:
     3969     run diasize_maximize in this-procedure
     3970       (input  ?
     3971       ).
     3972     return no-apply .
     3973   end.
     3974   procedure diasize_end-move :
     3975     do
     3976     on error undo, return error return-value
     3977     :
     3978       define variable v-row-delta as decimal   no-undo .
     3979       define variable v-col-delta as decimal   no-undo .
     3980       define variable v-new-row as decimal   no-undo .
     3981       define variable v-new-col as decimal   no-undo .
     3982       assign
     3983         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3984         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3985       .
     3986       assign
     3987         v-row-delta = v-new-row - frame Dialog-Frame :height
     3988         v-col-delta = v-new-col - frame Dialog-Frame :width
     3989       .
     3990       run diasize_change-height in this-procedure
     3991         (input v-row-delta
     3992         ,input true
     3993         ) .
     3994       run diasize_change-width in this-procedure
     3995         (input v-col-delta
     3996         ,input true
     3997         ) .
     3998     end.
     3999   end procedure.
     4000   procedure diasize_maximize :
     4001     define input  parameter p-action as logical   no-undo .
     4002     do
     4003     on error undo, return error return-value
     4004     :
     4005       if p-action = ?
     4006       then do:
     4007         if v-diasize-need-maximize = true
     4008         then do:
     4009           assign
     4010             p-action = true
     4011           .
     4012         end.
     4013         else do:
     4014           assign
     4015             p-action = false
     4016           .
     4017         end.
     4018       end.
     4019       if p-action = true
     4020       then do:
     4021         run diasize_change-height in this-procedure
     4022           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4023               - frame Dialog-Frame :height-chars
     4024           ,input true
     4025           ) .
     4026         run diasize_change-width in this-procedure
     4027           (input session :width-chars
     4028               - frame Dialog-Frame :width-chars
     4029           ,input true
     4030           ) .
     4031         assign
     4032           v-diasize-need-maximize = false
     4033         .
     4034       end.
     4035       else do:
     4036         run diasize_change-width in this-procedure
     4037           (input v-diasize-orig-frame-width
     4038               - frame Dialog-Frame :width-chars
     4039           ,input true
     4040           ) .
     4041         run diasize_change-height in this-procedure
     4042           (input v-diasize-orig-frame-height
     4043               - frame Dialog-Frame :height-chars
     4044           ,input true
