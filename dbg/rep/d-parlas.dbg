     4147         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4148         assign
     4149           v-diasize-wndmax = false
     4150         .
     4151         if connected("ub") = true
     4152         then do:
     4153           define variable v-cntxt-db-num        as integer   no-undo .
     4154           define variable v-cntxt-userid        as character no-undo .
     4155           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4156                                             , OUTPUT v-cntxt-userid
     4157                                             ) .
     4158           run gbl/wndpar_r.p
     4159             (input  v-cntxt-db-num
     4160             ,input  v-cntxt-userid
     4161             ,input  'wndmax':U
     4162             ,output v-diasize-wndmax
     4163             ,output v-default-value
     4164             ) .
     4165         end.
     4166         assign
     4167           v-diasize-wndstore = false
     4168         .
     4169         if connected("ub") = true
     4170         then do:
     4171           run gbl/wndpar_r.p
     4172             (input  v-cntxt-db-num
     4173             ,input  v-cntxt-userid
     4174             ,input  'wndstore':U
     4175             ,output v-diasize-wndstore
     4176             ,output v-default-value
     4177             ) .
     4178         end.
     4179         assign
     4180           v-diasize-proc-name = entry(1, program-name(2), '.')
     4181         .
     4182         if v-diasize-wndstore = true
     4183         then do:
     4184           assign
     4185             v-restore-saved = false
     4186           .
     4187           if connected("ub") = true
     4188           then do:
     4189             run gbl/wndsizer.p
     4190               (input  v-cntxt-db-num
     4191               ,input  v-cntxt-userid
     4192               ,input  v-diasize-proc-name
     4193               ,input  'height':u
     4194               ,output v-resize-value-str
     4195               ) .
     4196             if v-resize-value-str <> '':U
     4197             then do:
     4198               run diasize_change-height in this-procedure
     4199                 (input  integer(v-resize-value-str)
     4200                 ,input  true
     4201                 ) .
     4202               assign
     4203                 v-restore-saved = true
     4204               .
     4205             end.
     4206           end.
     4207           if connected("ub") = true
     4208           then do:
     4209             run gbl/wndsizer.p
     4210               (input  v-cntxt-db-num
     4211               ,input  v-cntxt-userid
     4212               ,input  v-diasize-proc-name
     4213               ,input  'width':u
     4214               ,output v-resize-value-str
     4215               ) .
     4216             if v-resize-value-str <> '':U
     4217             then do:
     4218               run diasize_change-width in this-procedure
     4219                 (input  integer(v-resize-value-str)
     4220                 ,input  true
     4221                 ) .
     4222               assign
     4223                 v-restore-saved = true
     4224               .
     4225             end.
     4226           end.
     4227           if v-restore-saved <> true
     4228           then do:
     4229             if v-diasize-wndmax = true
     4230             then do:
     4231               run diasize_maximize in this-procedure
     4232                 (input  true
     4233                 ) .
     4234             end.
     4235           end.
     4236         end.
     4237         else do:
     4238           if v-diasize-wndmax = true
     4239           then do:
     4240             run diasize_maximize in this-procedure
     4241               (input  true
     4242               ) .
     4243           end.
     4244         end.
     4245       end.
     4246     end.
     4247   end procedure.
