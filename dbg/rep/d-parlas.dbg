     2177   procedure fltfield-clear :
     2178     define output parameter loc-fld as character no-undo.
     2179     define output parameter loc-lab as character no-undo .
     2180     define output parameter loc-spr as character no-undo .
     2181     define output parameter loc-dim as character no-undo .
     2182     assign
     2183       loc-fld = ""
     2184       loc-lab = ""
     2185       loc-spr = ""
     2186       loc-dim = "0"
     2187     .
     2188   end procedure .
     2189   procedure fltfield-add :
     2190     define input        parameter par-fld as character no-undo.
     2191     define input        parameter par-lab as character no-undo .
     2192     define input        parameter par-spr as character no-undo .
     2193     define input-output parameter loc-fld as character no-undo.
     2194     define input-output parameter loc-lab as character no-undo .
     2195     define input-output parameter loc-spr as character no-undo .
     2196     define input-output parameter loc-dim as character no-undo .
     2197     do
     2198     on error undo, return error
     2199     :
     2200       assign
     2201       loc-fld = if loc-dim = '0'
     2202                 then par-fld
     2203                 else (loc-fld + chr(44) + par-fld)
     2204       loc-lab = if loc-dim = '0'
     2205                 then par-lab
     2206                 else (loc-lab + chr(44) + par-lab)
     2207       loc-spr = if loc-dim = '0'
     2208                 then par-spr
     2209                 else (loc-spr + chr(44) + par-spr)
     2210       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     2211                 string(integer(if num-entries(loc-dim) > 1
     2212                               then entry(2, loc-dim)
     2213                               else entry(1, loc-dim)
     2214                               ) + 1)
     2215       no-error
     2216       .
     2217     end.
     2218   end procedure.
