     2229   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2230   procedure fltopend_fltopend :
     2231   define input parameter p-parent-handle as handle no-undo .
     2232   define input parameter p-qh as handle no-undo .
     2233   define input parameter p-flt-open-open-query  as character no-undo .
     2234   define input parameter p-where-cond as character no-undo .
     2235   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2236   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2237   define input parameter p-indexed-reposition as character no-undo .
     2238     do
     2239     on error undo, return error
     2240     :
     2241   define variable v-prepare-string as character no-undo .
     2242   define variable glog as logical no-undo .
     2243   assign
     2244   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2245                      p-where-cond + chr(32)  +
     2246                      p-use-indFIRST-query-tail + chr(32) +
     2247                      p-use-ind-sort-clmn-by + chr(32) +
     2248                      p-indexed-reposition
     2249   .
     2250   assign
     2251   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2252   if not glog
     2253   or error-status:error then do:
     2254     message error-status:get-message(1) view-as alert-box .
     2255     undo, return error .
     2256   end.
     2257   assign
     2258   glog = p-qh:query-open no-error .
     2259   if not glog
     2260   or error-status:error then do:
     2261     message error-status:get-message(1) view-as alert-box .
     2262     undo, return error .
     2263   end.
     2264     end.
     2265   end procedure.
     2266   procedure fltopend_fltfindd :
     2267   define input parameter p-parent-handle as handle no-undo .
     2268   define input parameter p-qh as handle no-undo .
     2269   define input parameter p-rowid as rowid no-undo .
     2270   define input parameter p-next as logical no-undo .
     2271   define input parameter p-lock as integer no-undo .
     2272   define input parameter p-bh as handle no-undo .
     2273   define input parameter p-where-cond as character no-undo .
     2274   define input parameter p-use-index-phrase as character no-undo .
     2275   define variable glog as logical no-undo .
     2276   define variable v-qh as handle no-undo .
     2277   define variable v-bh as handle no-undo .
     2278   define variable v-recid as recid no-undo .
     2279   define variable v-prepare-string as character no-undo .
     2280   do
     2281   on error undo, return error
     2282   on stop undo, return error
     2283   :
     2284     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2285     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2286     create query v-qh.
     2287     v-qh:set-buffers(v-bh).
     2288     v-prepare-string = substitute("for each &1 &2 &3"
     2289                                     ,v-bh:name
     2290                                     ,p-where-cond
     2291                                     ,p-use-index-phrase).
     2292     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2293     if not glog then do:
     2294       delete object v-qh.
     2295       delete object v-bh.
     2296       undo, return error .
     2297     end.
     2298     glog = v-qh:query-open no-error .
     2299     if not glog then do:
     2300       delete object v-qh.
     2301       delete object v-bh.
     2302       undo, return error .
     2303     end.
     2304     if p-next then do:
     2305       v-qh:reposition-to-rowid(p-rowid) no-error .
     2306       glog = v-qh:get-next( p-lock) no-error .
     2307       glog = v-qh:get-next( p-lock) no-error .
     2308       if not glog or v-qh:query-off-end = yes then do:
     2309         glog = v-qh:get-first( p-lock) no-error .
     2310       end.
     2311     end.
     2312     else do:
     2313       glog = v-qh:get-first( p-lock) no-error .
     2314     end.
     2315     v-recid = v-bh:recid no-error .
     2316     delete object v-qh.
     2317     delete object v-bh.
     2318     return string(v-recid) .
     2319   end.
     2320   end procedure.
     2321   procedure fltopend_fltfindq :
     2322   define input parameter p-parent-handle as handle no-undo .
     2323   define input parameter p-qh as handle no-undo .
     2324   define input parameter p-next as logical no-undo .
     2325   define input parameter p-lock as integer no-undo .
     2326   define input parameter p-flt-open-open-query  as character no-undo .
     2327   define input parameter p-where-cond as character no-undo .
     2328   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2329   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2330   define input parameter p-indexed-reposition as character no-undo .
     2331   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2332   define variable glog as logical no-undo .
     2333   define variable v-qh as handle no-undo .
     2334   define variable v-bh as handle no-undo extent 18.
     2335   define variable v-rowid as rowid no-undo extent 18.
     2336   define variable v-ii as integer no-undo .
     2337   define variable v-prepare-string as character no-undo .
     2338   do
     2339   on error undo, return error
     2340   on stop undo, return error
     2341   :
     2342     create query v-qh.
     2343     do v-ii = 1 to p-qh:num-buffers:
     2344       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2345       assign
     2346       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2347       no-error.
     2348       v-qh:add-buffer(v-bh[v-ii]).
     2349     end.
     2350     assign
     2351     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2352                       p-where-cond + chr(32)  +
     2353                       p-use-indFIRST-query-tail + chr(32) +
     2354                       p-use-ind-sort-clmn-by + chr(32) +
     2355                       p-indexed-reposition
     2356     .
     2357     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2358     if not glog then do:
     2359       delete object v-qh.
     2360       do v-ii = 1 to p-qh:num-buffers:
     2361         delete object v-bh[v-ii].
     2362       end.
     2363       undo, return error .
     2364     end.
     2365     glog = v-qh:query-open no-error .
     2366     if not glog then do:
     2367       delete object v-qh.
     2368       do v-ii = 1 to p-qh:num-buffers:
     2369         delete object v-bh[v-ii].
     2370       end.
     2371       undo, return error .
     2372     end.
     2373     if p-next then do:
     2374       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2375       glog = v-qh:get-next( p-lock) no-error .
     2376       glog = v-qh:get-next( p-lock) no-error .
     2377       if not glog or v-qh:query-off-end = yes then do:
     2378         glog = v-qh:get-first( p-lock) no-error .
     2379       end.
     2380     end.
     2381     else do:
     2382       glog = v-qh:get-first( p-lock) no-error .
     2383     end.
     2384     do v-ii = 1 to p-qh:num-buffers:
     2385       assign
     2386       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2387       no-error.
     2388     end.
     2389     delete object v-qh.
     2390     do v-ii = 1 to p-qh:num-buffers:
     2391       delete object v-bh[v-ii].
     2392     end.
     2393   end.
     2394   end procedure.
     2395   define temp-table temp-sel-obj no-undo
     2396     field obj-type as character
     2397     field obj-code as integer
     2398     index xpk is primary unique obj-type obj-code
     2399     .
     2400   define new shared temp-table temp-last-date no-undo   field gds-code      like ub.goods.gds-code   field artic         like ub.goods.artic   field prod-type     like ub.goods.prod-type   field prod-code     like ub.goods.prod-code   field part-code     like ub.parts.part-code   field obj-type      as character   field obj-code      as integer   field gds-name      like ub.goods.gds-name   field fact-qnty     like ub.parts.fact-qnty   field fact-date     as date label "Дата ПН" format "99/99/9999":u   field in-code       like ub.trn-doc.doc-code label "Номер ПН" column-label "Номер ПН"   field last-date     as date column-label " Годен до !  старый  " format "99/99/9999":u   field new-last-date as date column-label " Годен до !  новый   "  format "99/99/9999":u   field obj-full      as character label "Объект"        format "x(9)":u   field prod-full     as character label "Производитель" format "x(13)":u   field price-base    like ub.parts.price-base   field price-rubl    like ub.parts.price-rubl   field supp-type     like ub.parts.supp-type   field supp-code     like ub.parts.supp-code   field supp-full     as character label "Поставщик" format "x(13)":u   field is-supp       like ub.parts.is-supp column-label "П" format "+/-"   field cst-code      like ub.parts.cst-code format "x(31)":u   index xpk is primary unique gds-code in-code part-code obj-type obj-code   .
     2401   define variable filter-point as character no-undo init "d-parlas" .
     2402   DEFINE BUTTON b-clear-last-date
     2403        LABEL "О&чистить"
     2404        SIZE 10 BY 1.
     2405   DEFINE BUTTON b-exit AUTO-GO
     2406        LABEL "&Ввод"
     2407        SIZE 8 BY 1
     2408        BGCOLOR 8 .
     2409   DEFINE BUTTON b-sch
     2410        LABEL "&Фильтр"
     2411        SIZE 12 BY 1.
     2412   DEFINE BUTTON b-help
     2413        LABEL "Помо&щь"
     2414        SIZE 10 BY 1
     2415        BGCOLOR 8 .
     2416   DEFINE BUTTON b-quit
     2417        LABEL "&Отмена"
     2418        SIZE 8 BY 1
     2419        BGCOLOR 8 .
     2420   DEFINE BUTTON b-restore
     2421        LABEL "Восс&тановить"
     2422        SIZE 14 BY 1.
