     4261   procedure get-context :
     4262      define output parameter p-db-num as integer          no-undo.
     4263      define output parameter p-user-id as character        no-undo.
     4264      define variable v-login               as character    no-undo.
     4265      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4266      define buffer buf_user-login  for ub.user-login .
     4267      do
     4268      on error undo, return error
     4269      :
     4270            FIND FIRST buf_sys-ctrl no-lock.
     4271            ASSIGN
     4272               v-login = USERID("ub")
     4273               p-db-num = buf_sys-ctrl.db-num
     4274            .
     4275            FIND FIRST buf_user-login
     4276                 WHERE buf_user-login.db-num = p-db-num
     4277                   AND buf_user-login.user-login = v-login
     4278                 no-lock
     4279                 no-error
     4280                 .
     4281            IF AVAILABLE buf_user-login
     4282            THEN DO:
     4283               assign
     4284                  p-user-id = buf_user-login.user-id
     4285               .
     4286            END.
     4287      end.
     4288   end procedure.
