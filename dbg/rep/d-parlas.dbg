     4717   PROCEDURE make-temp-table :
     4718     define buffer buf_goods        for ub.goods .
     4719     define buffer buf_temp-obj     for temp-obj .
     4720     define buffer buf_obj-list     for obj-list .
     4721     define buffer buf_g#cli        for g#cli .
     4722     define buffer buf_tmp#grp      for tmp#grp .
     4723     define buffer buf_gds-list     for gds-list .
     4724     define variable v-ind as integer   no-undo .
     4725     do
     4726     on error undo, return error return-value
     4727     :
     4728       run waitfram-show in this-procedure
     4729         (input "Поиск партий с заданными параметрами"
     4730         ) .
     4731       case x-SelectObject :
     4732         when "firm":U
     4733         then do:
     4734           run init-temphost in this-procedure .
     4735           define variable v-host-code as integer   no-undo .
     4736   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4738     (input  p-obj-type
     4739     ,input  p-obj-code
     4740     ,output v-host-code
     4741     )  .
     4742           for each buf_temp-obj
     4743             where buf_temp-obj.host-code = v-host-code
     4744           :
     4745             run create-temp-sel-obj in this-procedure
     4746               (input  buf_temp-obj.obj-type
     4747               ,input  buf_temp-obj.obj-code
     4748               ) .
     4749           end.
     4750         end.
     4751         when "currency":U
     4752         then do:
     4753           run create-temp-sel-obj in this-procedure
     4754             (input  p-obj-type
     4755             ,input  p-obj-code
     4756             ) .
     4757         end.
     4758         when "choice":U
     4759         then do:
     4760           for each buf_obj-list
     4761           :
     4762             run create-temp-sel-obj in this-procedure
     4763               (input  buf_obj-list.obj-type
     4764               ,input  buf_obj-list.obj-code
     4765               ) .
     4766           end.
     4767         end.
     4768         when 'все':U
     4769         then do:
     4770           define buffer buf_db      for ub.db .
     4771           define buffer buf_clients for ub.clients .
     4772           for each buf_db no-lock
     4773           ,each buf_clients no-lock
     4774             where buf_clients.db-num = buf_db.db-num
     4775           :
     4776             run create-temp-sel-obj in this-procedure
     4777               (input  buf_clients.obj-type
     4778               ,input  buf_clients.obj-code
     4779               ) .
     4780           end.
     4781         end.
     4782         otherwise do:
     4783           message
     4784             vss-workfile vss-revision vss-description skip
     4785             "Внутренняя ошибка" skip
     4786             "Неизвестное значение переменной x-SelectObject" skip
     4787             "x-SelectObject" x-SelectObject skip
     4788             view-as alert-box error .
     4789           undo, return error return-value .
     4790         end.
     4791       end.
     4792       case x-SelectGood
     4793       :
     4794         when 1
     4795         then do:
     4796           for each buf_goods no-lock
     4797           :
     4798             assign
     4799               v-ind = v-ind + 1
     4800             .
     4801             if v-ind modulo 10 = 0
     4802             then do:
     4803               run waitfram-show in this-procedure
     4804                 (input substitute("Анализ товаров. Обработано &1", v-ind)
     4805                 ) .
     4806             end.
     4807             run select-parts in this-procedure
     4808               (input  buf_goods.artic
     4809               ,input  buf_goods.prod-type
     4810               ,input  buf_goods.prod-code
     4811               ) .
     4812           end.
     4813         end.
     4814         when 2
     4815         then do:
     4816           for each buf_tmp#grp
     4817           ,each buf_goods no-lock
     4818             where buf_goods.grp-name begins buf_tmp#grp.grp-name
     4819           :
     4820             assign
     4821               v-ind = v-ind + 1
     4822             .
     4823             if v-ind modulo 10 = 0
     4824             then do:
     4825               run waitfram-show in this-procedure
     4826                 (input substitute("Анализ товаров. Обработано &1", v-ind)
     4827                 ) .
     4828             end.
     4829             run select-parts in this-procedure
     4830               (input  buf_goods.artic
     4831               ,input  buf_goods.prod-type
     4832               ,input  buf_goods.prod-code
     4833               ) .
     4834           end.
     4835         end.
     4836         when 3
     4837         then do:
     4838           for each buf_g#cli
     4839           ,each buf_goods no-lock
     4840             where buf_goods.prod-type = buf_g#cli.obj-type
     4841               and buf_goods.prod-code = buf_g#cli.obj-code
     4842           :
     4843             assign
     4844               v-ind = v-ind + 1
     4845             .
     4846             if v-ind modulo 10 = 0
     4847             then do:
     4848               run waitfram-show in this-procedure
     4849                 (input substitute("Анализ товаров. Обработано &1", v-ind)
     4850                 ) .
     4851             end.
     4852             run select-parts in this-procedure
     4853               (input  buf_goods.artic
     4854               ,input  buf_goods.prod-type
     4855               ,input  buf_goods.prod-code
     4856               ) .
     4857           end.
     4858         end.
     4859         when 4 or
     4860         when 5    or
     4861         when 7
     4862         then do:
     4863           for each buf_gds-list no-lock
     4864           :
     4865             assign
     4866               v-ind = v-ind + 1
     4867             .
     4868             if v-ind modulo 10 = 0
     4869             then do:
     4870               run waitfram-show in this-procedure
     4871                 (input substitute("Анализ товаров. Обработано &1", v-ind)
     4872                 ) .
     4873             end.
     4874             run select-parts in this-procedure
     4875               (input  buf_gds-list.artic
     4876               ,input  buf_gds-list.prod-type
     4877               ,input  buf_gds-list.prod-code
     4878               ) .
     4879           end.
     4880         end.
     4881         otherwise do:
     4882           message
     4883             vss-workfile vss-revision vss-description skip
     4884             "Внутренняя ошибка" skip
     4885             "Неизвестное значение переменной x-SelectGood" skip
     4886             "x-SelectGood" x-SelectGood skip
     4887             view-as alert-box error .
     4888           undo, return error return-value .
     4889         end.
     4890       end case .
     4891       run waitfram-hide in this-procedure .
     4892     end.
     4893   END PROCEDURE.
     4894   PROCEDURE my-open-query :
     4895   define variable v-flt-open-query-def as character no-undo .
     4896     define variable sort-column-phrase as character no-undo .
     4897     define variable v-query-was-opened as logical   no-undo .
     4898     assign
     4899       sort-column-phrase = ""
     4900     .
     4901     do
     4902     on error undo, return error return-value
     4903     :
     4904       case rs-filter :
     4905         when 1
     4906         then do:
     4907   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4908   define variable  l-disable-where-45  as logical   no-undo .
     4909   define variable  l-filter-open-45    as logical   .
     4910   define variable  flt-rec-45       as recid     no-undo .
     4911   define variable  filter-name-45      as character no-undo .
     4912   define variable  where-phrase-45     as character no-undo .
     4913   define variable  sort-phrase-45      as character no-undo .
     4914   define variable  where-phrase-rus-45 as character no-undo .
     4915   define variable  sort-phrase-rus-45  as character no-undo .
     4916     run waitfram-show in this-procedure
     4917       (input "ЖДИТЕ ..."
     4918       ).
     4919   run gbl/flt-get.p
     4920     (input filter-point
     4921     ,output flt-rec-45
     4922     ,output filter-name-45
     4923     ,output where-phrase-45
     4924     ,output sort-phrase-45
     4925     ,output where-phrase-rus-45
     4926     ,output sort-phrase-rus-45
     4927     ).
     4928       run set-filter-name in this-procedure
     4929         (INPUT filter-name-45
     4930         ) no-error .
     4931     assign
     4932       l-filter-open-45 = false
     4933     .
     4934     if flt-rec-45 <> ?
     4935       or sort-column-phrase > ""
     4936     then do:
     4937       define variable  parameter-2-45 as character no-undo .
     4938       define variable  parameter-3-45 as character no-undo .
     4939       define variable  parameter-4-45 as character no-undo .
     4940       define variable  parameter-5-45 as character no-undo .
     4941       define variable  parameter-6-45 as character no-undo .
     4942       define variable  parameter-7-45 as character no-undo .
     4943         assign
     4944         parameter-3-45 =
     4945                                 "for each query_temp-last-date"
     4946         parameter-4-45 =
     4947           (
     4948             if ("true" + " " + where-phrase-45) <> ""
     4949             then "true" + " " + where-phrase-45
     4950             else "true"
     4951           )
     4952         parameter-5-45 = (" " + "" + " " + "")
     4953         parameter-6-45 = if sort-phrase-45 = ''
     4954                              then
     4955           (
     4956           " " + " " +
     4957             " " + sort-column-phrase +
     4958           " " + " "
     4959           )
     4960                              else
     4961           (
     4962           " " + " " +
     4963             " " + sort-column-phrase +
     4964           " " + sort-phrase-45
     4965           )
     4966         parameter-7-45 =
     4967           "   "
     4968       .
     4969       do
     4970       on stop undo, leave
     4971       on error undo, leave
     4972       :
     4973         assign
     4974           l-disable-where-45 =
     4975             ("true" + " " + where-phrase-45 = "")
     4976         .
     4977         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4978                             ,input query browse-1:handle
     4979                             ,input parameter-3-45
     4980                             ,input parameter-4-45
     4981                             ,input parameter-5-45
     4982                             ,input parameter-6-45
     4983                             ,input parameter-7-45
     4984                             )
     4985         .
     4986         assign
     4987           l-filter-open-45 = true
     4988         .
     4989       end.
     4990       if l-filter-open-45 = false then do:
     4991         message
     4992           "Ошибка при фильтрации / сортировке" skip
     4993           "Будут показаны записи без учета фильтра" skip
     4994           view-as alert-box .
     4995       end.
     4996       else do:
     4997           assign
     4998             v-query-was-opened = true
     4999           .
     5000       end.
     5001     end.
     5002     if l-filter-open-45 = false then do:
     5003       open query browse-1 for each query_temp-last-date
     5004         where true
     5005     .
     5006         assign
     5007           v-query-was-opened = true
     5008         .
     5009     end.
     5010     run waitfram-hide in this-procedure .
     5011         end.
     5012         when 2
     5013         then do:
     5014           open query BROWSE-1 for each query_temp-last-date
     5015             where query_temp-last-date.new-last-date <> query_temp-last-date.last-date
     5016             .
     5017         end.
     5018         when 3
     5019         then do:
     5020           open query BROWSE-1 for each query_temp-last-date
     5021             where query_temp-last-date.new-last-date = query_temp-last-date.last-date
     5022             .
     5023         end.
     5024         otherwise do:
     5025           message
     5026             vss-workfile vss-revision vss-description skip
     5027             "Внутренняя ошибка" skip
     5028             "Неизвестное значение переменной rs-filter" skip
     5029             "rs-filter" rs-filter skip
     5030             view-as alert-box error .
     5031           undo, return error return-value .
     5032         end.
     5033       end.
     5034       apply 'entry':u to query_temp-last-date.new-last-date in browse BROWSE-1 .
     5035     end.
     5036   END PROCEDURE.
     5037   PROCEDURE save-data :
     5038     define buffer buf_temp-last-date for temp-last-date .
     5039     define variable v-gds-code as integer   no-undo .
     5040     define variable v-ind as integer   no-undo .
     5041     do
     5042     on error undo, return error return-value
     5043     :
     5044       for each buf_temp-last-date
     5045         where buf_temp-last-date.new-last-date <> buf_temp-last-date.last-date
     5046       on error undo, return error return-value
     5047       :
     5048         assign
     5049           v-ind = v-ind + 1
     5050         .
     5051         if v-ind modulo 10 = 0
     5052         then do:
     5053           run waitfram-show in this-procedure
     5054             (substitute("Сохранение нового срока годности &1", v-ind)
     5055             ) .
     5056         end.
     5057   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5058   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5059     (input  buf_temp-last-date.artic
     5060     ,input  buf_temp-last-date.prod-type
     5061     ,input  buf_temp-last-date.prod-code
     5062     ,output v-gds-code
     5063     )  .
     5064         run trg/partolas.p
     5065           (input  buf_temp-last-date.obj-type
     5066           ,input  buf_temp-last-date.obj-code
     5067           ,input  buf_temp-last-date.in-code
     5068           ,input  v-gds-code
     5069           ,input  buf_temp-last-date.part-code
     5070           ,input  buf_temp-last-date.new-last-date
     5071           ) .
     5072         define variable v-send-news    as logical   no-undo .
     5073         define variable v-send-db-list as character no-undo .
     5074         define variable v-cmd          as character no-undo .
     5075         assign
     5076           v-send-news = false
     5077         .
     5078         if v-cntxt-db-num <> 0
     5079         then do:
     5080           assign
     5081             v-send-news = true
     5082             v-send-db-list = "0":u
     5083           .
     5084         end.
     5085         else do:
     5086           define buffer buf_clients for ub.clients .
     5087           find first buf_clients no-lock
     5088             where buf_clients.obj-type = buf_temp-last-date.obj-type
     5089               and buf_clients.obj-code = buf_temp-last-date.obj-code
     5090             .
     5091           if buf_clients.db-num <> 0
     5092           then do:
     5093             assign
     5094               v-send-news = true
     5095               v-send-db-list = string(buf_clients.db-num)
     5096             .
     5097           end.
     5098         end.
     5099         define variable conf-par as character no-undo.
     5100         define variable mode-erprn as logical no-undo.
     5101         define variable par-type as character no-undo.
     5102   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5103     (input  'is-erpRN'
     5104     ,input  0
     5105     ,input  ''
     5106     ,input  0
     5107     ,input  ''
     5108     ,input  ''
     5109     ,input  ''
     5110     ,input  NO
     5111     ,output conf-par
     5112     ,output par-type
     5113     ) no-error .
     5114           IF not error-status:error and conf-par = "yes":U then v-send-news = false.
     5115         if v-send-news = true
     5116         then do:
     5117           assign
     5118             v-cmd = "command":U + chr(1)
     5119                   + "parts":U + chr(1)
     5120                   + "last-date":U + chr(1)
     5121                   + buf_temp-last-date.obj-type + chr(1)
     5122                   + string(buf_temp-last-date.obj-code) + chr(1)
     5123                   + buf_temp-last-date.in-code + chr(1)
     5124                   + string(v-gds-code) + chr(1)
     5125                   + buf_temp-last-date.part-code + chr(1)
     5126                   + substitute('&1', string(buf_temp-last-date.new-last-date, '99/99/9999':u) )
     5127           .
     5128           run nws/cr-route.p
     5129             (input  'send-cmd':U
     5130             ,input  v-cmd
     5131             ,input  ?
     5132             ,input  v-send-db-list
     5133             ).
     5134         end.
     5135         output stream PrnLibStream to value("partolas.txt":u) append .
     5136         put stream PrnLibStream unformatted
     5137           cur-time-string()
     5138           " obj-type "
     5139           buf_temp-last-date.obj-type
     5140           " obj-code "
     5141           buf_temp-last-date.obj-code
     5142           " in-code "
     5143           buf_temp-last-date.in-code
     5144           " gds-code "
     5145           v-gds-code
     5146           " part-code "
     5147           buf_temp-last-date.part-code
     5148           " new-last-date "
     5149           string(buf_temp-last-date.new-last-date, '99/99/9999':u)
     5150           " old-last-date "
     5151           string(buf_temp-last-date.last-date, '99/99/9999':u)
     5152           chr(10)
     5153           .
     5154         output stream PrnLibStream close .
     5155       end.
     5156       run waitfram-hide in this-procedure .
     5157       if v-ind <> 0
     5158       then do:
     5159         message
     5160           "Изменение даты 'Годен до' завершено" skip
     5161           "Изменено партий" v-ind skip
     5162           view-as alert-box information .
     5163       end.
     5164     end.
     5165   END PROCEDURE.
     5166   PROCEDURE select-parts :
     5167     define input  parameter p-artic     as character no-undo .
     5168     define input  parameter p-prod-type as character no-undo .
     5169     define input  parameter p-prod-code as integer   no-undo .
     5170     define variable vss-description as character no-undo init "select-parts-01: выбор партий по указанным условиям".
     5171     define buffer buf_parts for ub.parts .
     5172     define buffer buf_goods for ub.goods .
     5173     define buffer buf_temp-sel-obj   for temp-sel-obj .
     5174     define buffer buf_temp-parts     for temp-parts .
     5175     define buffer buf_temp-last-date for temp-last-date .
     5176     do
     5177     on error undo, return error return-value
     5178     :
     5179       find first buf_goods no-lock
     5180         where buf_goods.artic     = p-artic
     5181           and buf_goods.prod-type = p-prod-type
     5182           and buf_goods.prod-code = p-prod-code
     5183         no-error .
     5184       if not available buf_goods
     5185       then do:
     5186         message
     5187           vss-workfile vss-revision vss-description skip
     5188           "Ошибка задания входных параметров" skip
     5189           "Не найден товар" skip
     5190           "Артикул" p-artic p-prod-type p-prod-code skip
     5191           view-as alert-box error .
     5192         undo, return error return-value .
     5193       end.
     5194       for each buf_temp-sel-obj
     5195       :
     5196         run partslib-init-temp-parts in this-procedure
     5197           (input  buf_temp-sel-obj.obj-type
     5198           ,input  buf_temp-sel-obj.obj-code
     5199           ,input  p-artic
     5200           ,input  p-prod-type
     5201           ,input  p-prod-code
     5202           ) .
     5203         for each buf_temp-parts
     5204         :
     5205           define variable v-copy-part as logical   no-undo .
     5206           assign
     5207             v-copy-part = false
     5208           .
     5209           case p-select
     5210           :
     5211             when "not-defined"
     5212             then do:
     5213               if buf_temp-parts.last-date = ?
     5214               then do:
     5215                 assign
     5216                   v-copy-part = true
     5217                 .
     5218               end.
     5219             end.
     5220             when "less-then"
     5221             then do:
     5222               if  buf_temp-parts.last-date <> ?
     5223               and buf_temp-parts.last-date < p-last-date
     5224               then do:
     5225                 assign
     5226                   v-copy-part = true
     5227                 .
     5228               end.
     5229             end.
     5230             when "all"
     5231             then do:
     5232               assign
     5233                 v-copy-part = true
     5234               .
     5235             end.
     5236             otherwise do:
     5237               message
     5238                 vss-workfile vss-revision vss-description skip
     5239                 "Внутренняя ошибка" skip
     5240                 "Неизвестное значение переменной p-select" skip
     5241                 "p-select" p-select skip
     5242                 view-as alert-box error .
     5243               undo, return error return-value .
     5244             end.
     5245           end case .
     5246           if v-copy-part = true
     5247           then do:
     5248             create buf_temp-last-date .
     5249             assign
     5250               buf_temp-last-date.gds-code      = buf_goods.gds-code
     5251               buf_temp-last-date.artic         = buf_temp-parts.artic
     5252               buf_temp-last-date.prod-type     = buf_temp-parts.prod-type
     5253               buf_temp-last-date.prod-code     = buf_temp-parts.prod-code
     5254               buf_temp-last-date.part-code     = buf_temp-parts.part-code
     5255               buf_temp-last-date.obj-type      = buf_temp-parts.obj-type
     5256               buf_temp-last-date.obj-code      = buf_temp-parts.obj-code
     5257               buf_temp-last-date.gds-name      = buf_goods.gds-name
     5258               buf_temp-last-date.fact-qnty     = buf_temp-parts.fact-qnty
     5259               buf_temp-last-date.fact-date     = buf_temp-parts.fact-date
     5260               buf_temp-last-date.in-code       = buf_temp-parts.in-code
     5261               buf_temp-last-date.last-date     = buf_temp-parts.last-date
     5262               buf_temp-last-date.new-last-date = buf_temp-parts.last-date
     5263               buf_temp-last-date.obj-full      = substitute("&1 &2"
     5264                                                 ,buf_temp-parts.obj-type
     5265                                                 ,buf_temp-parts.obj-code
     5266                                                 )
     5267               buf_temp-last-date.prod-full     = substitute("&1 &2"
     5268                                                 ,buf_temp-parts.prod-type
     5269                                                 ,buf_temp-parts.prod-code
     5270                                                 )
     5271               buf_temp-last-date.price-base    = buf_temp-parts.price-base
     5272               buf_temp-last-date.price-rubl    = buf_temp-parts.price-rubl
     5273               buf_temp-last-date.supp-type     = buf_temp-parts.supp-type
     5274               buf_temp-last-date.supp-code     = buf_temp-parts.supp-code
     5275               buf_temp-last-date.supp-full     = substitute("&1 &2"
     5276                                                 ,buf_temp-parts.supp-type
     5277                                                 ,buf_temp-parts.supp-code
     5278                                                 )
     5279               buf_temp-last-date.is-supp       = buf_temp-parts.is-supp
     5280               buf_temp-last-date.cst-code      = buf_temp-parts.cst-code
     5281             .
     5282           end.
     5283         end.
     5284       end.
     5285     end.
     5286   END PROCEDURE.
     5287   PROCEDURE set-filter-name :
     5288     define input parameter p-filter-name as character no-undo .
     5289     define variable v-title as character no-undo .
     5290     assign
     5291       v-title = "Редактирование сроков годности партий товара"
     5292     .
     5293     do with frame Dialog-Frame:
     5294       if p-filter-name > ""
     5295       then do:
     5296         assign
     5297           frame Dialog-Frame:title
     5298             = v-title + "   ФИЛЬТР: " + p-filter-name.
     5299         .
     5300         assign
     5301           rect-flt :BGCOLOR = RED_COLOR
     5302           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     5303         .
     5304       end.
     5305       else do:
     5306         assign
     5307           frame Dialog-Frame:title
     5308             = v-title
     5309         .
     5310         assign
     5311           rect-flt :BGCOLOR = GREY_COLOR
     5312           b-sch :TOOLTIP = ""
     5313         .
     5314       end.
     5315     end.
     5316   END PROCEDURE.
