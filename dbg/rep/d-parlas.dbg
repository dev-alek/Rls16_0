     4607   PROCEDURE last-date-restore :
     4608     define variable v-ind as integer   no-undo .
     4609     do
     4610     on error undo, return error return-value
     4611     :
     4612       get first BROWSE-1 .
     4613       repeat while available query_temp-last-date
     4614       :
     4615         assign
     4616           v-ind = v-ind + 1
     4617         .
     4618         if v-ind modulo 10 = 0
     4619         then do:
     4620           run waitfram-show in this-procedure
     4621             (input substitute("Восстановление первоначального срока годности &1", v-ind)
     4622             ) .
     4623         end.
     4624         assign
     4625           query_temp-last-date.new-last-date = query_temp-last-date.last-date
     4626         .
     4627         get next BROWSE-1 .
     4628       end.
     4629       run waitfram-hide in this-procedure .
     4630       run my-open-query in this-procedure .
     4631     end.
     4632   END PROCEDURE.
     4633   PROCEDURE last-date-set-date :
