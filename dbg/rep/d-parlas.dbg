      190   procedure create_obj-list :
      191      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      192      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      193      do
      194      on error undo, return error return-value
      195      :
      196         define buffer cli-obj for ub.clients .
      197         define variable p-var as integer no-undo .
      198         define buffer buf_obj-list for obj-list .
      199         find last buf_obj-list  use-index pi no-error .
      200         if available buf_obj-list
      201         then
      202            p-var = buf_obj-list.obj-id + 1.
      203         else
      204            p-var = 1.
      205         find first cli-obj where
      206                   cli-obj.obj-type = p-obj-type
      207               and cli-obj.obj-code = p-obj-code
      208         no-lock no-error.
      209         if available cli-obj
      210         then do:
      211            create buf_obj-list.
      212            assign
      213               buf_obj-list.obj-id   = p-var
      214               buf_obj-list.obj-code = cli-obj.obj-code
      215               buf_obj-list.obj-type = cli-obj.obj-type
      216               buf_obj-list.obj-name = cli-obj.obj-name
      217               buf_obj-list.db-num   = cli-obj.db-num
      218            .
      219         end.
      220      end.
      221   end.
