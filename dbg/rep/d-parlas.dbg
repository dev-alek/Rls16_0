     4137           width-pixels  = 16
     4138           visible       = true
     4139           sensitive     = true
     4140           movable       = true
     4141           triggers:
     4142             on end-move persistent run diasize_end-move in this-procedure .
     4143           end triggers.
     4144         v-diasize-resize-button :load-mouse-pointer("SIZE") .
