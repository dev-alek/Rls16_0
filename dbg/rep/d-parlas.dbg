     2499            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2500            ) = 0
     2501   then do:
     2502     message
     2503       "$Workfile$"
     2504       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2505       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     2506       "Тип" self :type in frame Dialog-Frame skip
     2507       "Процедура" this-procedure :file-name skip
     2508       view-as alert-box .
     2509   end.
     2510   else do:
     2511     apply "entry":u to b-exit in frame Dialog-Frame .
     2512     if focus :handle <> b-exit :handle in frame Dialog-Frame then do:
     2513       return no-apply .
     2514     end.
     2515   end.
     2516     define buffer buf_temp-last-date for temp-last-date .
     2517     find first buf_temp-last-date
     2518       where buf_temp-last-date.new-last-date <> buf_temp-last-date.last-date
     2519       no-error .
     2520     if available buf_temp-last-date
     2521     then do:
     2522       run save-data in this-procedure
     2523         no-error .
     2524       if error-status :error
     2525       then do:
     2526         message
     2527           vss-workfile vss-revision vss-description skip
     2528           "Ошибка при сохранении данных" skip
     2529           error-status :get-message(1) skip
     2530           return-value skip
     2531           view-as alert-box error .
     2532         return no-apply .
     2533       end.
     2534     end.
     2535   END.
