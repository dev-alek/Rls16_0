      619   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      620   define  stream PrnLibStream.
      621   procedure prn-lib-prn-file :
      622     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      623     define input parameter p-DIsabledoptions as integer no-undo .
      624     define variable v-report-name as character no-undo .
      625     define variable v-user-action as character no-undo .
      626     define variable v-printed     as logical   no-undo .
      627     define variable v-exist       as logical   no-undo .
      628     do
      629       on error undo, return error
      630       :
      631       run prn-lib-get-report-name  in this-procedure (
      632         input parParentProc
      633         ,output v-report-name
      634         ).
      635   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      636   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      637     (input  v-report-name
      638     ,input  2
      639     ,output v-exist
      640     )  .
      641       if NOT v-exist then
      642       DO:
      643         Message
      644           "Нет заданий на печать ! "
      645           view-as alert-box .
      646         Return  .
      647       End.
      648       run gbl/prnfilen.w
      649         (input  ""
      650         ,input  p-DisabledOptions
      651         ,input  string(v-report-name )
      652         ,input  7
      653         ,output v-user-action
      654         ,output v-printed
      655         ) .
      656       if v-printed then
      657       do:
      658         return "YES" .
      659       end.
      660       else
      661       do:
      662         return "NO" .
      663       end.
      664     end.
      665   end procedure.
      666   procedure prn-lib-open-stream :
      667     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      668     define input parameter p-page-size    as integer no-undo .
      669     define input parameter p-is-stream    as logical no-undo .
      670     define input parameter p-append       as logical no-undo .
      671     define variable v-report-name as character no-undo .
      672     do
      673       on error undo, return error
      674       :
      675       run prn-lib-get-report-name  in this-procedure (
      676         input parParentProc
      677         ,output v-report-name
      678         ).
      679       if p-is-stream then
      680       do:
      681         if p-append then
      682         do:
      683           output stream PrnLibStream to value( v-report-name )
      684             page-size value(p-page-size) append .
      685         end.
      686         if not p-append then
      687         do:
      688           output stream PrnLibStream to value( v-report-name )
      689             page-size value(p-page-size) .
      690         end.
      691       end.
      692       if not p-is-stream then
      693       do:
      694         if p-append then
      695         do:
      696           output to value( v-report-name )
      697             page-size value(p-page-size) append .
      698         end.
      699         if not p-append then
      700         do:
      701           output to value( v-report-name )
      702             page-size value(p-page-size) .
      703         end.
      704       end.
      705     end.
      706   end procedure.
      707   procedure prn-lib-open-exp :
      708     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      709     define input parameter p-is-stream    as logical no-undo .
      710     define input parameter p-is-append    as logical no-undo .
      711     define output parameter p-ReportFileName as char init "report" no-undo.
      712     define output parameter p-process as logical no-undo .
      713     define variable glog as logical no-undo .
      714     do
      715       on error undo, return error
      716       :
      717       SYSTEM-DIALOG GET-FILE p-ReportFileName
      718         TITLE      "Укажите путь"
      719         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      720         ASK-OVERWRITE
      721         CREATE-TEST-FILE
      722         SAVE-AS
      723         USE-FILENAME
      724         DEFAULT-EXTENSION "txt"
      725         UPDATE glog
      726         .
      727       if not glog then  return.
      728       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      729       if p-is-stream then
      730       do:
      731         if p-is-append then
      732         do:
      733           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      734         end.
      735         else
      736         do:
      737           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      738         end.
      739       end.
      740       else
      741       do:
      742         if p-is-append then
      743         do:
      744           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      745         end.
      746         else
      747         do:
      748           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      749         end.
      750       end.
      751       p-process = yes.
      752     end.
      753   end procedure.
      754   procedure prn-lib-get-report-name :
      755     define input parameter parParentProc  as widget-handle no-undo.
      756     define output parameter p-report-name as character no-undo .
      757     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      758   end procedure.
      759   procedure prn-lib-reportviewer-report-name :
      760     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      761     define input parameter p-report-name-html as character no-undo .
      762     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      763   end procedure.
      764   procedure prn-lib-reportviewer :
      765     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      766     define input parameter p-report-name-html as character no-undo .
      767     define input parameter p-param        as character no-undo .
      768     define variable v-excel           as character no-undo init 'TRUE' .
      769     define variable v-value-character as character no-undo .
      770     define variable v-value-integer   as character no-undo .
      771     define variable v-value-date      as date      no-undo .
      772     define variable v-value-decimal   as decimal   no-undo .
      773     define variable rep-excel         as logical   no-undo .
      774     define variable excel-string      as character no-undo .
      775     define variable v-param-type      as character no-undo .
      776     define variable v-tth             as handle    no-undo .
      777     run adm/shattri.p (
      778       input "get":U
      779       ,input  ""
      780       ,input  0
      781       ,input  'report-glob':U
      782       ,input  'rep-excel':U
      783       ,output v-value-character
      784       ,output v-value-date
      785       ,output v-value-decimal
      786       ,output v-value-integer
      787       ,output rep-excel
      788       ,output v-param-type
      789       ,INPUT-OUTPUT table-handle v-tth
      790       )  .
      791     if rep-excel then v-excel = "TRUE" .
      792     else v-excel = "FALSE" .
      793     if p-param eq ""
      794     then
      795        p-param = "EXCEL:" + v-excel.
      796     else
      797        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      798     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      799   end procedure.
      800   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   define  temp-table temp-host no-undo
      802     field host-code like ub.store.host-code
      803     index xpk host-code
      804   .
      805   define  temp-table temp-obj no-undo
      806     field obj-type  like ub.clients.obj-type
      807     field obj-code  like ub.clients.obj-code
      808     field host-code like ub.store.host-code
      809     field db-num    like ub.clients.db-num
      810     index xpk  obj-type obj-code
      811     index xie1 host-code
      812     index xie2 db-num host-code
      813   .
      814   procedure init-temphost:
      815     define buffer buf_store   for ub.store .
      816     define buffer buf_shop    for ub.shop .
      817     define buffer buf_clients for ub.clients .
      818     define buffer buf_db for ub.db .
      819     define buffer buf_temp-host for temp-host .
      820     define buffer buf_temp-obj for temp-obj .
      821     do
      822     on error undo, return error return-value
      823     :
      824       for each buf_store
      825       on error undo, return error
      826       :
      827         find first buf_temp-host
      828           where buf_temp-host.host-code = buf_store.host-code
      829           no-error .
      830         if not available buf_temp-host
      831         then do:
      832           create buf_temp-host .
      833           assign
      834             buf_temp-host.host-code = buf_store.host-code
      835           .
      836         end.
      837         find first buf_clients no-lock
      838           where buf_clients.obj-type = 'скл':U
      839             and buf_clients.obj-code = buf_store.obj-code
      840           no-error .
      841         if not available buf_clients
      842         then do:
      843           message
      844             "Ошибка при поиске клиента" skip
      845             "Клиент" 'скл':U buf_store.obj-code skip
      846             view-as alert-box error .
      847           undo, return error .
      848         end.
      849         create buf_temp-obj .
      850         assign
      851           buf_temp-obj.obj-type  = 'скл':U
      852           buf_temp-obj.obj-code  = buf_store.obj-code
      853           buf_temp-obj.host-code = buf_store.host-code
      854           buf_temp-obj.db-num    = buf_clients.db-num
      855         .
      856       end.
      857       for each buf_shop
      858       on error undo, return error
      859       :
      860         find first buf_temp-host
      861           where buf_temp-host.host-code = buf_shop.host-code
      862           no-error .
      863         if not available buf_temp-host
      864         then do:
      865           create buf_temp-host .
      866           assign
      867             buf_temp-host.host-code = buf_shop.host-code
      868           .
      869         end.
      870         find first buf_clients no-lock
      871           where buf_clients.obj-type = 'маг':U
      872             and buf_clients.obj-code = buf_shop.obj-code
      873           no-error .
      874         if not available buf_clients then do:
      875           message
      876             "Ошибка при поиске клиента" skip
      877             "Клиент" 'маг':U buf_shop.obj-code skip
      878             view-as alert-box error .
      879           undo, return error .
      880         end.
      881         create buf_temp-obj .
      882         assign
      883           buf_temp-obj.obj-type  = 'маг':U
      884           buf_temp-obj.obj-code  = buf_shop.obj-code
      885           buf_temp-obj.host-code = buf_shop.host-code
      886           buf_temp-obj.db-num    = buf_clients.db-num
      887         .
      888       end.
      889     end.
      890   end.
      891   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      892   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      893   procedure partslib-clear-temp-parts :
      894     define buffer buf_temp-parts for temp-parts .
      895     do
      896     on error undo, return error
      897     :
      898       for each buf_temp-parts
      899       on error undo, return error
      900       :
      901         delete buf_temp-parts .
      902       end.
      903     end.
      904   end procedure.
      905   procedure partslib-create-temp-parts :
      906     define parameter buffer buf_parts       for ub.parts .
      907     define parameter buffer buf_temp-parts  for temp-parts .
      908     define input  parameter p-goods-twounit as logical   no-undo .
      909     define variable v-base-part-code as character no-undo .
      910     do
      911     on error undo, return error
      912     :
      913       if p-goods-twounit = true
      914       then do:
      915         assign
      916           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      917         .
      918       end.
      919       else do:
      920         assign
      921           v-base-part-code = buf_parts.part-code
      922         .
      923       end.
      924       find first buf_temp-parts exclusive-lock
      925         where buf_temp-parts.obj-type  = buf_parts.obj-type
      926           and buf_temp-parts.obj-code  = buf_parts.obj-code
      927           and buf_temp-parts.artic     = buf_parts.artic
      928           and buf_temp-parts.prod-type = buf_parts.prod-type
      929           and buf_temp-parts.prod-code = buf_parts.prod-code
      930           and buf_temp-parts.in-code   = buf_parts.in-code
      931           and buf_temp-parts.out-code  = 'free-zone':U
      932           and buf_temp-parts.part-code = v-base-part-code
      933         no-error.
      934       if not available buf_temp-parts
      935       then do:
      936         create buf_temp-parts .
      937         buffer-copy buf_parts to buf_temp-parts
      938         assign
      939           buf_temp-parts.out-code  = 'free-zone':U
      940           buf_temp-parts.part-code = v-base-part-code
      941           buf_temp-parts.rsrv-free = yes
      942           buf_temp-parts.status_   = no
      943           buf_temp-parts.qnty      = 0
      944           buf_temp-parts.fact-qnty = 0
      945           buf_temp-parts.real-qnty = 0
      946           buf_temp-parts.cli-qnty  = 0
      947         .
      948       end.
      949     end.
      950   end procedure.
      951   procedure partslib-init-temp-parts :
      952     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      953     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      954     define input parameter p-artic           like ub.parts.artic     no-undo .
      955     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      956     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      957     define buffer buf_parts      for ub.parts .
      958     define buffer buf_temp-parts for temp-parts .
      959     define variable v-goods-twounit    as logical   no-undo .
      960     do
      961     on error undo, return error
      962     :
      963   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      964   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      965     (input  p-artic
      966     ,input  p-prod-type
      967     ,input  p-prod-code
      968     ,input  'twounit=request':u
      969     ,output v-goods-twounit
      970     ) no-error .
      971       if error-status :error
      972       then do:
      973         message
      974           vss-workfile vss-revision vss-description skip
      975           vss-include-info10 skip
      976           "Ошибка при определении атрибута товара" skip
      977           "Артикул" p-artic p-prod-type p-prod-code skip
      978           "twounit=request" skip
      979           error-status :get-message(1) skip
      980           return-value skip
      981           view-as alert-box error .
      982         undo, return error return-value .
      983       end.
      984       run partslib-clear-temp-parts in this-procedure .
      985       for each buf_parts
      986         where buf_parts.obj-type  = p-obj-type
      987           and buf_parts.obj-code  = p-obj-code
      988           and buf_parts.artic     = p-artic
      989           and buf_parts.prod-type = p-prod-type
      990           and buf_parts.prod-code = p-prod-code
      991           and buf_parts.rsrv-free = yes
      992           and buf_parts.status_   = no
      993           and buf_parts.in-code   <> buf_parts.out-code
      994       on error undo, return error
      995       :
      996         run partslib-create-temp-parts in this-procedure
      997           (buffer buf_parts
      998           ,buffer buf_temp-parts
      999           ,input  v-goods-twounit
     1000           ) .
     1001         define variable v-parts-qnty          as decimal   no-undo .
     1002         define variable v-parts-cli-qnty      as decimal   no-undo .
     1003         define variable v-parts-free-qnty     as decimal   no-undo .
     1004         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1005         if buf_parts.out-code = 'free-zone':U
     1006         then do:
     1007           assign
     1008             v-parts-qnty          = buf_parts.qnty
     1009             v-parts-cli-qnty      = buf_parts.cli-qnty
     1010             v-parts-free-qnty     = buf_parts.qnty
     1011             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1012           .
     1013         end.
     1014         else do:
     1015           assign
     1016             v-parts-qnty          = abs(buf_parts.qnty)
     1017             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1018             v-parts-free-qnty     = 0
     1019             v-parts-free-cli-qnty = 0
     1020           .
     1021         end.
     1022         assign
     1023           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1024           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1025           buf_temp-parts.real-qnty     = 0
     1026           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1027           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1028           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1029         .
     1030       end.
     1031     end.
     1032   end procedure.
     1033   procedure partslib-init-temp-parts-by-factord :
     1034     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1035     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1036     define input parameter p-artic              like ub.parts.artic     no-undo .
     1037     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1038     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1039     define input parameter p-fact-order         as decimal   no-undo .
     1040     define input parameter p-include-fact-order as logical   no-undo .
     1041     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1042     define buffer buf_gds-obj  for ub.gds-obj .
     1043     do
     1044     on error undo, return error
     1045     :
     1046       do transaction
     1047       on error undo, return error
     1048       :
     1049   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1050   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1051     (input  p-obj-type
     1052     ,input  p-obj-code
     1053     ,input  p-artic
     1054     ,input  p-prod-type
     1055     ,input  p-prod-code
     1056     ,buffer buf_gds-obj
     1057     ) no-error .
     1058         if error-status :error
     1059         then do:
     1060           message
     1061             vss-workfile vss-revision vss-description skip
     1062             vss-include-info10 skip
     1063             "Невозможно найти товар на объекте" skip
     1064             "Объект" p-obj-type p-obj-code skip
     1065             "Артикул" p-artic p-prod-type p-prod-code skip
     1066             error-status :get-message(1) skip
     1067             return-value skip
     1068             view-as alert-box error .
     1069           undo, return error .
     1070         end.
     1071         find current buf_gds-obj exclusive-lock .
     1072       end.
     1073       run partslib-init-temp-parts in this-procedure
     1074         (input p-obj-type
     1075         ,input p-obj-code
     1076         ,input p-artic
     1077         ,input p-prod-type
     1078         ,input p-prod-code
     1079         ) no-error .
     1080       if error-status :error
     1081       then do:
     1082         message
     1083           vss-workfile vss-revision vss-description skip
     1084           vss-include-info10 skip
     1085           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1086           "Объект" p-obj-type p-obj-code skip
     1087           "Артикул" p-artic p-prod-type p-prod-code skip
     1088           "p-fact-order" p-fact-order skip
     1089           view-as alert-box error .
     1090         undo, return error .
     1091       end.
     1092       if p-include-fact-order = true
     1093       then do:
     1094         assign
     1095           p-fact-order = p-fact-order - 0.0000000001
     1096         .
     1097       end.
     1098       define variable v-max-fact-order as character no-undo .
     1099       run factord-max-fact-order in this-procedure
     1100         (output v-max-fact-order
     1101         ) no-error .
     1102       if error-status :error
     1103       then do:
     1104         message
     1105           vss-workfile vss-revision vss-description skip
     1106           vss-include-info10 skip
     1107           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1108           "Объект" p-obj-type p-obj-code skip
     1109           "Артикул" p-artic p-prod-type p-prod-code skip
     1110           "p-fact-order" p-fact-order skip
     1111           view-as alert-box error .
     1112         undo, return error .
     1113       end.
     1114       run partslib-update-by-factord in this-procedure
     1115         (input p-obj-type
     1116         ,input p-obj-code
     1117         ,input p-artic
     1118         ,input p-prod-type
     1119         ,input p-prod-code
     1120         ,input p-fact-order
     1121         ,input v-max-fact-order
     1122         ,input false
     1123         ) no-error .
     1124       if error-status :error
     1125       then do:
     1126         message
     1127           vss-workfile vss-revision vss-description skip
     1128           vss-include-info10 skip
     1129           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1130           "Объект" p-obj-type p-obj-code skip
     1131           "Артикул" p-artic p-prod-type p-prod-code skip
     1132           "p-fact-order" p-fact-order skip
     1133           "v-max-fact-order" v-max-fact-order skip
     1134           view-as alert-box error .
     1135         undo, return error .
     1136       end.
     1137     end.
     1138   end procedure.
     1139   procedure partslib-update-by-factord :
     1140     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1141     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1142     define input parameter p-artic              like ub.parts.artic     no-undo .
     1143     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1144     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1145     define input parameter p-start-fact-order   as decimal   no-undo .
     1146     define input parameter p-end-fact-order     as decimal   no-undo .
     1147     define input parameter p-lock-gds-obj       as logical   no-undo .
     1148     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1149     define buffer buf_gds-obj  for ub.gds-obj .
     1150     define buffer buf_doc-line for ub.doc-line .
     1151     define variable v-total-parts-qnty as decimal   no-undo .
     1152     define variable v-goods-gds-goods  as logical   no-undo .
     1153     define variable v-goods-twounit    as logical   no-undo .
     1154     do
     1155     on error undo, return error
     1156     :
     1157       if p-start-fact-order > p-end-fact-order
     1158       then do:
     1159         message
     1160           vss-workfile vss-revision vss-description skip
     1161           vss-include-info10 skip
     1162           "Ошибка задания входных параметров" skip
     1163           "Начало интервала превышает конец интервала" skip
     1164           "Объект" p-obj-type p-obj-code skip
     1165           "Артикул" p-artic p-prod-type p-prod-code skip
     1166           "p-start-fact-order" p-start-fact-order skip
     1167           "p-end-fact-order"   p-end-fact-order skip
     1168           view-as alert-box error .
     1169         undo, return error .
     1170       end.
     1171       if p-lock-gds-obj = true
     1172       then do:
     1173         do transaction
     1174         on error undo, return error
     1175         :
     1176   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1178     (input  p-obj-type
     1179     ,input  p-obj-code
     1180     ,input  p-artic
     1181     ,input  p-prod-type
     1182     ,input  p-prod-code
     1183     ,buffer buf_gds-obj
     1184     ) no-error .
     1185           if error-status :error
     1186           then do:
     1187             message
     1188               vss-workfile vss-revision vss-description skip
     1189               vss-include-info10 skip
     1190               "Невозможно найти gds-obj" skip
     1191               error-status :get-message(1) skip
     1192               return-value skip
     1193               view-as alert-box error .
     1194             undo, return error .
     1195           end.
     1196           find current buf_gds-obj exclusive-lock .
     1197         end.
     1198       end.
     1199   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1201     (input  p-artic
     1202     ,input  p-prod-type
     1203     ,input  p-prod-code
     1204     ,input  'gds-goods=request':u
     1205     ,output v-goods-gds-goods
     1206     ) no-error .
     1207       if error-status :error
     1208       then do:
     1209         message
     1210           vss-workfile vss-revision vss-description skip
     1211           vss-include-info10 skip
     1212           "Ошибка при определении атрибута товара" skip
     1213           "Артикул" p-artic p-prod-type p-prod-code skip
     1214           "gds-goods=request" skip
     1215           error-status :get-message(1) skip
     1216           return-value skip
     1217           view-as alert-box error .
     1218         undo, return error return-value .
     1219       end.
     1220   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1221   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1222     (input  p-artic
     1223     ,input  p-prod-type
     1224     ,input  p-prod-code
     1225     ,input  'twounit=request':u
     1226     ,output v-goods-twounit
     1227     ) no-error .
     1228       if error-status :error
     1229       then do:
     1230         message
     1231           vss-workfile vss-revision vss-description skip
     1232           vss-include-info10 skip
     1233           "Ошибка при определении атрибута товара" skip
     1234           "Артикул" p-artic p-prod-type p-prod-code skip
     1235           "twounit=request" skip
     1236           error-status :get-message(1) skip
     1237           return-value skip
     1238           view-as alert-box error .
     1239         undo, return error return-value .
     1240       end.
     1241       for each buf_doc-line no-lock
     1242         where buf_doc-line.obj-type   = p-obj-type
     1243           and buf_doc-line.obj-code   = p-obj-code
     1244           and buf_doc-line.artic      = p-artic
     1245           and buf_doc-line.prod-type  = p-prod-type
     1246           and buf_doc-line.prod-code  = p-prod-code
     1247           and buf_doc-line.status_    = 'факт':U
     1248           and buf_doc-line.fact-order > p-start-fact-order
     1249           and buf_doc-line.fact-order <= p-end-fact-order
     1250       on error undo, return error
     1251       :
     1252         run partslib-process-document in this-procedure
     1253           (input  buf_doc-line.doc-code
     1254           ,input  p-obj-type
     1255           ,input  p-obj-code
     1256           ,input  p-artic
     1257           ,input  p-prod-type
     1258           ,input  p-prod-code
     1259           ,input  v-goods-gds-goods
     1260           ,input  v-goods-twounit
     1261           ,output v-total-parts-qnty
     1262           ) no-error .
     1263         if error-status :error
     1264         then do:
     1265           message
     1266             vss-workfile vss-revision vss-description skip
     1267             vss-include-info10 skip
     1268             "Ошибка при вызове процедуры partslib-process-document" skip
     1269             "Документ" buf_doc-line.doc-code skip
     1270             "Объект" p-obj-type p-obj-code skip
     1271             "Артикул" p-artic p-prod-type p-prod-code skip
     1272             "p-start-fact-order" p-start-fact-order skip
     1273             "p-end-fact-order" p-end-fact-order skip
     1274             error-status :get-message(1) skip
     1275             return-value skip
     1276             view-as alert-box error .
     1277           undo, return error return-value .
     1278         end.
     1279       end.
     1280     end.
     1281   end procedure.
     1282   procedure partslib-process-document :
     1283     define input  parameter p-doc-code         as character no-undo .
     1284     define input  parameter p-obj-type         as character no-undo .
     1285     define input  parameter p-obj-code         as integer   no-undo .
     1286     define input  parameter p-artic            as character no-undo .
     1287     define input  parameter p-prod-type        as character no-undo .
     1288     define input  parameter p-prod-code        as integer   no-undo .
     1289     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1290     define input  parameter p-goods-twounit    as logical   no-undo .
     1291     define output parameter p-total-parts-qnty as decimal   no-undo .
     1292     define variable v-parts-sign as integer   no-undo .
     1293     define buffer buf_trn-doc    for ub.trn-doc .
     1294     define buffer buf_doc-line   for ub.doc-line .
     1295     define buffer buf_parts      for ub.parts .
     1296     define buffer buf_temp-parts for temp-parts .
     1297     do
     1298     on error undo, return error return-value
     1299     :
     1300       find first buf_trn-doc no-lock
     1301         where buf_trn-doc.doc-code = p-doc-code
     1302         no-error .
     1303       if not available buf_trn-doc
     1304       then do:
     1305         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1306                                      ,p-doc-code
     1307                                      ) .
     1308       end.
     1309       case buf_trn-doc.doc-type
     1310       :
     1311         when 'при':U or
     1312         when 'возврат':U or
     1313         when 'инв':U
     1314         then do:
     1315           assign
     1316             v-parts-sign = -1
     1317           .
     1318         end.
     1319         when 'рас':U or
     1320         when 'спи':U
     1321         then do:
     1322           assign
     1323             v-parts-sign = 1
     1324           .
     1325         end.
     1326         otherwise do:
     1327           undo, return error substitute("Неизвестный тип документа &1"
     1328                                       ,buf_trn-doc.doc-type
     1329                                       ) .
     1330         end.
     1331       end.
     1332       find first buf_doc-line no-lock
     1333         where buf_doc-line.doc-code  = p-doc-code
     1334           and buf_doc-line.artic     = p-artic
     1335           and buf_doc-line.prod-type = p-prod-type
     1336           and buf_doc-line.prod-code = p-prod-code
     1337         no-error .
     1338       if not available buf_doc-line
     1339       then do:
     1340         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1341                                      ,p-doc-code
     1342                                      ,artic
     1343                                      ,prod-type
     1344                                      ,prod-code
     1345                                      ) .
     1346       end.
     1347       assign
     1348         p-total-parts-qnty = 0
     1349       .
     1350       if p-goods-gds-goods = true
     1351       then do:
     1352         for each buf_parts no-lock
     1353           where buf_parts.out-code  = p-doc-code
     1354             and buf_parts.obj-type  = p-obj-type
     1355             and buf_parts.obj-code  = p-obj-code
     1356             and buf_parts.artic     = p-artic
     1357             and buf_parts.prod-type = p-prod-type
     1358             and buf_parts.prod-code = p-prod-code
     1359         on error undo, return error
     1360         :
     1361           run partslib-create-temp-parts in this-procedure
     1362             (buffer buf_parts
     1363             ,buffer buf_temp-parts
     1364             ,input  p-goods-twounit
     1365             ) .
     1366           assign
     1367             p-total-parts-qnty        = p-total-parts-qnty
     1368                                       + v-parts-sign * buf_parts.fact-qnty
     1369             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1370                                       + v-parts-sign * buf_parts.fact-qnty
     1371             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1372                                       + v-parts-sign * buf_parts.fact-qnty
     1373             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1374                                       + v-parts-sign * buf_parts.cli-qnty
     1375           .
     1376           if buf_temp-parts.qnty = 0
     1377           then do:
     1378             delete buf_temp-parts .
     1379           end.
     1380         end.
     1381       end.
     1382       else do:
     1383         assign
     1384           p-total-parts-qnty = p-total-parts-qnty
     1385                              + v-parts-sign * buf_doc-line.fact-qnty
     1386         .
     1387       end.
     1388     end.
     1389   end procedure.
     1390   procedure partslib-init-temp-parts-by-date :
     1391     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1392     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1393     define input parameter p-artic           like ub.parts.artic     no-undo .
     1394     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1395     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1396     define input parameter p-fact-date       as date      no-undo .
     1397     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1398     do
     1399     on error undo, return error
     1400     :
     1401       define variable v-fact-order                as decimal   no-undo .
     1402       define variable v-shift-end-fact-order      as decimal   no-undo .
     1403       define variable v-day-end-fact-order        as decimal   no-undo .
     1404       run factord in this-procedure
     1405         (input  p-fact-date
     1406         ,input  1
     1407         ,input  1
     1408         ,input  ?
     1409         ,input  0
     1410         ,input  false
     1411         ,output v-fact-order
     1412         ,output v-shift-end-fact-order
     1413         ,output v-day-end-fact-order
     1414         ) no-error .
     1415       if error-status :error
     1416       then do:
     1417         message
     1418           vss-workfile vss-revision vss-description skip
     1419           vss-include-info10 skip
     1420           "Ошибка при определении момента времени, на который требуется остаток" skip
     1421           "Объект" p-obj-type p-obj-code skip
     1422           "Артикул" p-artic p-prod-type p-prod-code skip
     1423           "Дата" p-fact-date skip
     1424           view-as alert-box error .
     1425         undo, return error .
     1426       end.
     1427       run partslib-init-temp-parts-by-factord in this-procedure
     1428         (input p-obj-type
     1429         ,input p-obj-code
     1430         ,input p-artic
     1431         ,input p-prod-type
     1432         ,input p-prod-code
     1433         ,input v-day-end-fact-order
     1434         ,input false
     1435         ) no-error .
     1436       if error-status :error
     1437       then do:
     1438         message
     1439           vss-workfile vss-revision vss-description skip
     1440           vss-include-info10 skip
     1441           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1442           "Объект" p-obj-type p-obj-code skip
     1443           "Артикул" p-artic p-prod-type p-prod-code skip
     1444           "Дата" p-fact-date skip
     1445           view-as alert-box error .
     1446         undo, return error .
     1447       end.
     1448     end.
     1449   end procedure.
     1450   procedure partslib-calc-cost :
     1451     define output parameter p-fact-qnty      as decimal   no-undo .
     1452     define output parameter p-vat-pc         as decimal   no-undo .
     1453     define output parameter p-slt-pc         as decimal   no-undo .
     1454     define output parameter p-sum-base       as decimal   no-undo .
     1455     define output parameter p-sum-rubl       as decimal   no-undo .
     1456     define output parameter p-vat-base       as decimal   no-undo .
     1457     define output parameter p-vat-rubl       as decimal   no-undo .
     1458     define output parameter p-slt-base       as decimal   no-undo .
     1459     define output parameter p-slt-rubl       as decimal   no-undo .
     1460     define output parameter p-road-tax-base  as decimal   no-undo .
     1461     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1462     define output parameter p-transport-base as decimal   no-undo .
     1463     define output parameter p-transport-rubl as decimal   no-undo .
     1464     define output parameter p-other-base     as decimal   no-undo .
     1465     define output parameter p-other-rubl     as decimal   no-undo .
     1466     define output parameter p-excise-base    as decimal   no-undo .
     1467     define output parameter p-excise-rubl    as decimal   no-undo .
     1468     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1469     do
     1470     on error undo, return error return-value
     1471     :
     1472       define buffer buf_temp-parts for temp-parts .
     1473       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1474       define buffer   in-vatp-parts    for ub.parts   .
     1475       define buffer   in-vatp-doc      for ub.trn-doc .
     1476       define buffer   in-vatp-goods    for ub.goods   .
     1477       define buffer   in-vatp-sysconf  for ub.sysconf .
     1478       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1479       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1480       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1481       define variable varinvprb                  as   character              no-undo.
     1482       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1483       define variable cli-base-rate              as   decimal                no-undo.
     1484       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1485       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1486       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1487       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1488       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1489       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1490       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1491       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1492       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1493       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1494       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1495       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1496       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1497       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1498       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1499       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1500       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1501       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1502       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1503       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1504       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1505       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1506       define variable varinvatp-envd             as   character              no-undo.
     1507       define variable varinvatp-type             as   character              no-undo.
     1508       for each buf_temp-parts
     1509       on error undo, return error
     1510       :
     1511   assign
     1512     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1513     price-base-with-tax-loc = buf_temp-parts.price-base
     1514   .
     1515   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1516   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1517     (output varinvprb
     1518     )  .
     1519     if buf_temp-parts.out-code = 'free-zone':U     or
     1520        buf_temp-parts.out-code = 'out-zone':U   or
     1521        buf_temp-parts.doc-type = 'акт':U then do:
     1522       assign
     1523         in-vatp-have-vat-slt = yes.
     1524     end.
     1525     else do:
     1526       find first in-vatp_doc-attr no-lock
     1527         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1528           and in-vatp_doc-attr.attr-code = 'envd':U
     1529         no-error .
     1530       if not available in-vatp_doc-attr then do:
     1531         assign
     1532           in-vatp-have-vat-slt = yes.
     1533       end.
     1534       else do:
     1535            in-vatp-have-vat-slt = no.
     1536       end.
     1537     end.
     1538     assign
     1539      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1540      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1541     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1542              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1543     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1544             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1545             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1546             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1547             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1548             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1549             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1550       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1551     assign
     1552       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1553     assign
     1554       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1555       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1556       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1557       transport-cli-loc  = 0
     1558       other-cli-loc      = 0
     1559     .
     1560   ASSIGN
     1561             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1562       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1563   .
     1564         assign
     1565           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1566           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1567           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1568           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1569           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1570           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1571           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1572           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1573           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1574           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1575           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1576           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1577           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1578           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1579           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1580           p-excise-base    = p-excise-base    + 0
     1581           p-excise-rubl    = p-excise-rubl    + 0
     1582         .
     1583       end.
     1584       if p-fact-qnty      = ?
     1585       or p-sum-base       = ?
     1586       or p-sum-rubl       = ?
     1587       or p-vat-base       = ?
     1588       or p-vat-rubl       = ?
     1589       or p-slt-base       = ?
     1590       or p-slt-rubl       = ?
     1591       or p-road-tax-base  = ?
     1592       or p-road-tax-rubl  = ?
     1593       or p-transport-base = ?
     1594       or p-transport-rubl = ?
     1595       or p-other-base     = ?
     1596       or p-other-rubl     = ?
     1597       or p-excise-base    = ?
     1598       or p-excise-rubl    = ?
     1599       then do:
     1600         message
     1601           vss-workfile vss-revision vss-description skip
     1602           vss-include-info10 skip
     1603           "Программа in-vatp.i вернула неопределенные значения" skip
     1604           "p-fact-qnty"      p-fact-qnty      skip
     1605           "p-sum-base"       p-sum-base       skip
     1606           "p-sum-rubl"       p-sum-rubl       skip
     1607           "p-vat-base"       p-vat-base       skip
     1608           "p-vat-rubl"       p-vat-rubl       skip
     1609           "p-slt-base"       p-slt-base       skip
     1610           "p-slt-rubl"       p-slt-rubl       skip
     1611           "p-road-tax-base"  p-road-tax-base  skip
     1612           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1613           "p-transport-base" p-transport-base skip
     1614           "p-transport-rubl" p-transport-rubl skip
     1615           "p-other-base"     p-other-base     skip
     1616           "p-other-rubl"     p-other-rubl     skip
     1617           "p-excise-base"    p-excise-base    skip
     1618           "p-excise-rubl"    p-excise-rubl    skip
     1619           view-as alert-box error .
     1620         undo, return error .
     1621       end.
     1622     end.
     1623   end procedure.
     1624   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1625   define variable v-waitfram-action01         as character   no-undo .
     1626   define variable v-waitfram-action02         as character   no-undo .
     1627   define variable v-waitfram-action03         as character   no-undo .
     1628   define variable mWaitFramTextBeg            as character   no-undo.
     1629   define variable mWaitFramTextEnd            as character   no-undo.
     1630   define variable mWaitFramView               as logical     no-undo.
     1631   define variable mWaitProcEvent              as logical     no-undo init yes.
     1632   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1633   define variable mWaitFramStop               as logical     no-undo.
     1634   define variable mWaitFramStopUser           as logical     no-undo.
     1635   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1636   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1637   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1638   define button B-WaitFramStop auto-end-key
     1639        label "Стоп"
     1640        size 10 by 1 tooltip "Остоновить процесс".
     1641   define button B-viewProcInfo
     1642        label "Информация"
     1643        size 15 by 1 tooltip "Информация о процесс".
     1644   define frame waitfram
     1645     v-waitfram-action01 format "x(72)" no-label skip
     1646     v-waitfram-action02 format "x(72)" no-label skip
     1647     v-waitfram-action03 format "x(72)" no-label skip
     1648     B-viewProcInfo
     1649     B-WaitFramStop at row 4 col 30
     1650     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1651     .
     1652   define new global shared variable mBatchMode as logical no-undo init ?.
     1653   define variable mFramBachModHandle as handle no-undo.
     1654   mFramBachModHandle = frame waitfram:handle.
     1655   define variable mFameOldVis as logical no-undo.
     1656   define variable mVisCUrentVin as logical no-undo.
     1657   if session:batch-mode
     1658   then
     1659      mBatchMode = yes.
     1660   if mBatchMode = ? then do:
     1661     mVisCUrentVin = current-window:visible.
     1662     mFameOldVis = mFramBachModHandle:visible.
     1663     mFramBachModHandle:visible  = yes.
     1664     mBatchMode = mFramBachModHandle:visible ne yes.
     1665     mFramBachModHandle:visible = mFameOldVis.
     1666     current-window:visible = mVisCUrentVin.
     1667   end.
     1668    if  log-manager:logfile-name ne ?
     1669     then DO:
     1670         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1671         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1672         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1673     end.
     1674   on choose of B-WaitFramStop in frame waitfram
     1675   do:
     1676     mWaitFramStop = yes.
     1677     mWaitFramStopUser = yes.
     1678   end.
     1679   function waitfram-check-timeout returns logical():
     1680      define variable vtime as int64 no-undo.
     1681      if mWaitFramStopTimeOut
     1682      then
     1683         return yes.
     1684      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1685      if     mWaitFramTimeOut ne ?
     1686         and mWaitFramTimeOut ne 0
     1687         and mWaitFramTimeOut lt vtime
     1688      then do:
     1689         mWaitFramStopTimeOut = yes.
     1690      end.
     1691      return mWaitFramStopTimeOut.
     1692   end.
     1693   procedure waitfram-hide :
     1694     if not session:batch-mode
     1695     then do
     1696     on error undo, return error return-value
     1697     :
     1698       pause 0 before-hide .
     1699       if not mBatchMode then
     1700         hide frame waitfram .
     1701     if     not mWaitFramView
     1702        and mWaitProcEvent
     1703     then
     1704       process events .
     1705     end.
     1706   end procedure.
     1707   procedure waitfram-show :
     1708     define input  parameter p-message as character no-undo .
     1709     define variable v-left-margin as integer   no-undo .
     1710     if not session:batch-mode
     1711     then do
     1712     on error undo, return error return-value
     1713     :
     1714       if length(p-message) <= 70 then do:
     1715         assign
     1716           v-left-margin = integer((70 - length(p-message)) / 2)
     1717         .
     1718         assign
     1719           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1720         .
     1721         assign
     1722           v-waitfram-action01 = " "
     1723           v-waitfram-action02 = " "
     1724                                    + fill(" ", v-left-margin)
     1725                                    + p-message
     1726           v-waitfram-action03 = " "
     1727         .
     1728       end.
     1729       else do:
     1730         define variable vRindex1 as integer no-undo.
     1731         define variable vRindex2 as integer no-undo.
     1732         vRindex1 = r-index(p-message," ",70).
     1733         if vRindex1 = 0
     1734         then
     1735            vRindex1 = 70.
     1736         if length(p-message)  <= vRindex1 + 70 then do:
     1737           assign
     1738             v-waitfram-action01 = " "
     1739             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1740             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1741           .
     1742         end.
     1743         else do:
     1744           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1745           if vRindex2 <= vRindex1
     1746           then
     1747              vRindex2 = vRindex1 + 70.
     1748           assign
     1749             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1750             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1751             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1752           .
     1753         end.
     1754       end.
     1755       B-viewProcInfo:visible   in frame waitfram = no.
     1756       B-viewProcInfo:sensitive in frame waitfram = no.
     1757       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1758       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1759       if  (   mWaitFramView
     1760          or  mWaitProcEvent)
     1761          and not mBatchMode
     1762       then
     1763          display
     1764             v-waitfram-action01 skip
     1765             v-waitfram-action02 skip
     1766             v-waitfram-action03 skip
     1767          with frame waitfram .
     1768       if     mWaitFramView
     1769          then do:
     1770             if     mWaitFramInterval ne ?
     1771                and not mBatchMode
     1772             then
     1773                wait-for go of frame waitfram pause mWaitFramInterval.
     1774          end.
     1775          else
     1776             if     mWaitProcEvent
     1777                and not mBatchMode
     1778             then
     1779                process events .
     1780     end.
     1781   end procedure.
     1782      procedure waitfram-show-this:
     1783         define input  parameter iInterval as int64 no-undo.
     1784         define variable vtime as int64 no-undo.
     1785         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1786         mWaitFramInterval = iInterval.
     1787         run waitfram-show (substitute("&1&2 &3&4" ,
     1788                                       mWaitFramTextBeg ,
     1789                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1790                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1791                                       mWaitFramTextEnd
     1792                                      )
     1793                           ).
     1794      end.
     1795      procedure WaitFramRunPause:
     1796         define input  parameter iInterval as dec no-undo.
     1797         define variable vStart  as datetime-tz no-undo.
     1798         define variable vend    as datetime-tz no-undo.
     1799         define variable vint as int64 no-undo.
     1800         define variable vOk as logical no-undo.
     1801         vStart = now.
     1802         vend   = vStart.
     1803         publish "WaitFramPause" (iInterval,output vOk).
     1804         vend   =  now.
     1805         vint = vend - vStart.
     1806         vint = iInterval - vint / 1000.
     1807         if     not mWaitFramStop
     1808            and (   vint > 0
     1809                 or (    not vOk
     1810                     and iInterval eq ?
     1811                     )
     1812                 )
     1813         then
     1814            run waitfram-show-this (iInterval).
     1815         vend   =  now.
     1816         vint = vend - vStart.
     1817         vint = iInterval - vint / 1000.
     1818         if     not mWaitFramStop
     1819            and vint > 0
     1820         then do:
     1821            run gbl/pause.p (vint * 1000).
     1822         end.
     1823         if iInterval ne ?
     1824         then
     1825            publish "WaitFramStop".
     1826         waitfram-check-timeout().
     1827      end.
     1828      procedure WaitFramWaitFor:
     1829         define input  parameter iInterval as dec no-undo.
     1830         assign
     1831            mWaitFramStartProc   = now
     1832            mWaitFramStopUser    = no
     1833            mWaitFramStopTimeOut = no
     1834         .
     1835         block-wait:
     1836         do while not mWaitFramStop:
     1837            run WaitFramRunPause (iInterval).
     1838            if  waitfram-check-timeout()
     1839            then do:
     1840               leave block-wait.
     1841            end.
     1842         end.
     1843         run waitfram-hide.
     1844      end.
     1845   procedure waitfram-join :
     1846     define input  parameter p-line-1  as character no-undo .
     1847     define input  parameter p-line-2  as character no-undo .
     1848     define input  parameter p-line-3  as character no-undo .
     1849     define output parameter p-message as character no-undo .
     1850     do
     1851     on error undo, return error return-value
     1852     :
     1853       assign
     1854         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1855                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1856                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1857       .
     1858     end.
     1859   end procedure.
     1860   function waitfram-join-function returns character
     1861     (input p-line-1 as character
     1862     ,input p-line-2 as character
     1863     ,input p-line-3 as character
     1864     ).
     1865     define variable v-message as character no-undo .
     1866     run waitfram-join in this-procedure
     1867       (input  p-line-1
     1868       ,input  p-line-2
     1869       ,input  p-line-3
     1870       ,output v-message
     1871       ) .
     1872     return v-message .
     1873   end function .
     1874   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1875   procedure sel-date :
     1876     define input  parameter p-date-handle as handle    no-undo .
     1877     define input  parameter p-description as character no-undo .
     1878     do
     1879     on error undo, return error return-value
     1880     :
     1881       if (can-query (p-date-handle, "sensitive")
     1882         and
     1883         p-date-handle :sensitive = true
     1884         )
     1885       or (can-query (p-date-handle, "read-only")
     1886         and
     1887         p-date-handle :read-only = false
     1888         )
     1889       then do:
     1890         if p-date-handle :handle <> focus :handle
     1891         then do:
     1892           apply "entry":u to p-date-handle .
     1893         end.
     1894         define variable v-ok            as logical no-undo .
     1895         define variable v-curr-sv-date as date no-undo .
     1896         assign
     1897           v-curr-sv-date = date(p-date-handle :screen-value) no-error
     1898         .
     1899         if v-curr-sv-date = ?
     1900         then do:
     1901           run gbl/getcurdt.p
     1902             (output v-curr-sv-date
     1903             ) .
     1904         end.
     1905         if v-curr-sv-date <> ?
     1906         then do:
     1907           run gbl/d-inpday.w
     1908             (input ?
     1909             ,input "Выбор даты"
     1910             ,input p-description
     1911             ,input ""
     1912             ,input-output v-curr-sv-date
     1913             ,output v-ok
     1914             ).
     1915           if v-ok = true
     1916           then do:
     1917             assign
     1918               p-date-handle :screen-value = string(v-curr-sv-date) .
     1919             .
     1920           end.
     1921         end.
     1922       end.
     1923     end.
     1924   end procedure.
     1925   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1926   procedure cur-time :
     1927      define output parameter p-today as date      no-undo .
     1928      define output parameter p-time  as integer   no-undo .
     1929     do
     1930     on error undo, return error
     1931     :
     1932       define variable v-date1 as date      no-undo .
     1933       define variable v-date2 as date      no-undo .
     1934       define variable v-time  as integer   no-undo .
     1935       assign
     1936         v-date1 = today
     1937         v-time  = time
     1938         v-date2 = today
     1939       .
     1940       if v-date1 <> v-date2
     1941       then do:
     1942         assign
     1943           v-date1 = today
     1944           v-time  = v-time
     1945         .
     1946       end.
     1947       assign
     1948         p-today = v-date1
     1949         p-time  = v-time
     1950       .
     1951     end.
     1952   end.
     1953   function cur-time-date returns character
     1954   :
     1955     return string(today, '99/99/9999':U) .
     1956   end.
     1957   function cur-time-mjd returns decimal
     1958   :
     1959     define variable v-date as date      no-undo .
     1960     define variable v-time as integer   no-undo .
     1961     run cur-time in this-procedure
     1962       (output v-date
     1963       ,output v-time
     1964       ) .
     1965     return integer(v-date) - 2400002 + (v-time / 86400) .
     1966   end.
     1967   function cur-time-get-ending-index returns integer
     1968   (input p-number as integer
     1969   )
     1970   :
     1971     if p-number < 0
     1972     or p-number = ?
     1973     then do:
     1974       return 1 .
     1975     end.
     1976     define variable v-rest as integer   no-undo .
     1977     assign
     1978       p-number = p-number modulo 100
     1979     .
     1980     if p-number < 20
     1981     then do:
     1982       assign
     1983         v-rest = p-number
     1984       .
     1985     end.
     1986     else do:
     1987       assign
     1988         v-rest = p-number modulo 10
     1989       .
     1990     end.
     1991     case v-rest :
     1992       when 1
     1993       then do:
     1994         return 2 .
     1995       end.
     1996       when 2 or
     1997       when 3 or
     1998       when 4
     1999       then do:
     2000         return 3 .
     2001       end.
     2002       otherwise do:
     2003         return 1 .
     2004       end.
     2005     end case .
     2006   end.
     2007   procedure cur-time-mjd-to-date :
     2008      define input  parameter i-mjd-diff as decimal no-undo.
     2009      define output parameter o-Date     as date    no-undo.
     2010      define output parameter o-Time     as integer no-undo.
     2011      define variable v-day-number as integer   no-undo .
     2012      if    i-mjd-diff < 0
     2013         or i-mjd-diff = ?
     2014      then do:
     2015         return "?" .
     2016      end.
     2017      assign
     2018         v-day-number = truncate(i-mjd-diff,0).
     2019         o-Date = date(v-day-number + 2400002).
     2020         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2021     .
     2022   end.
     2023   function cur-time-mjd-to-string returns character
     2024   (input p-mjd-diff as decimal
     2025   )
     2026   :
     2027     define variable v-day-number as integer   no-undo .
     2028     define variable v-seconds    as integer   no-undo .
     2029     define variable v-hour       as integer   no-undo .
     2030     define variable v-min        as integer   no-undo .
     2031     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2032     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2033     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2034     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2035     if p-mjd-diff < 0
     2036     or p-mjd-diff = ?
     2037     then do:
     2038       return "?" .
     2039     end.
     2040     assign
     2041       v-day-number = integer(truncate(p-mjd-diff,0))
     2042       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2043     .
     2044     if v-seconds > 86400
     2045     then do:
     2046       assign
     2047         v-seconds = 86400 - 1
     2048       .
     2049     end.
     2050     if v-seconds < 0
     2051     then do:
     2052       assign
     2053         v-seconds = 0
     2054       .
     2055     end.
     2056     assign
     2057       v-hour = truncate(v-seconds / 3600, 0)
     2058     .
     2059     assign
     2060       v-seconds = v-seconds modulo 3600
     2061     .
     2062     assign
     2063       v-min = truncate(v-seconds / 60, 0)
     2064     .
     2065     assign
     2066       v-seconds = v-seconds modulo 60
     2067     .
     2068     return
     2069         (if v-day-number <> 0
     2070           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2071           else ""
     2072         )
     2073       + (if v-day-number <> 0 or v-hour <> 0
     2074           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2075           else ""
     2076         )
     2077       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2078           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2079           else ""
     2080         )
     2081       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2082       .
     2083   end.
     2084   function cur-time-string returns character
     2085   :
     2086     define variable v-date as date      no-undo .
     2087     define variable v-time as integer   no-undo .
     2088     run cur-time in this-procedure
     2089       (output v-date
     2090       ,output v-time
     2091       ) .
     2092     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2093   end.
     2094   function cur-time-string-sec returns character
     2095   :
     2096     define variable v-date as date      no-undo .
     2097     define variable v-time as integer   no-undo .
     2098     run cur-time in this-procedure
     2099       (output v-date
     2100       ,output v-time
     2101       ) .
     2102     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2103   end.
     2104   function cur-time-custom  returns character
     2105   (input p-prefix as character
     2106   ,input p-date-format as character
     2107   ,input p-delimiter as character
     2108   ,input p-time-format as character
     2109   ,input p-suffix as character
     2110   )
     2111   :
     2112     define variable v-date as date      no-undo .
     2113     define variable v-time as integer   no-undo .
     2114     run cur-time in this-procedure
     2115       (output v-date
     2116       ,output v-time
     2117       ) .
     2118     return
     2119       p-prefix
     2120       + string(v-date, p-date-format)
     2121       + p-delimiter
     2122       + string(v-time, p-time-format)
     2123       + p-suffix
     2124       .
     2125   end.
     2126   function cur-time-print  returns character
     2127   :
     2128     define variable v-date as date      no-undo .
     2129     define variable v-time as integer   no-undo .
     2130     run cur-time in this-procedure
     2131       (output v-date
     2132       ,output v-time
     2133       ) .
     2134     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2135   end.
     2136   function cur-time-datetime returns datetime
     2137   :
     2138     define variable v-char as character no-undo .
     2139     define variable v-datetime as datetime no-undo .
     2140     v-char = cur-time-string().
     2141     v-datetime = datetime(v-char).
     2142     return  v-datetime.
     2143   end.
     2144   function cur-time-string-msec returns character
     2145   :
     2146     define variable v-date as datetime  no-undo .
     2147     v-date = now.
     2148     return string(v-date) .
     2149   end.
