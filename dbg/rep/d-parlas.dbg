     2557     define buffer buf_temp-last-date for temp-last-date .
     2558     define variable v-ok as logical   no-undo .
     2559     find first buf_temp-last-date
     2560       where buf_temp-last-date.new-last-date <> buf_temp-last-date.last-date
     2561       no-error .
