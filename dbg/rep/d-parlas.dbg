     4500   MAIN-BLOCK:
     4501   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4502      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4503     RUN enable_UI.
     4504     WAIT-FOR GO OF FRAME Dialog-Frame.
     4505   END.
     4506   RUN disable_UI.
     4507   PROCEDURE check-record-exist :
     4508     define output parameter p-record-exist as logical   no-undo .
     4509     define buffer buf_temp-last-date for temp-last-date .
     4510     do
     4511     on error undo, return error return-value
     4512     :
     4513       find first buf_temp-last-date
     4514         no-error .
     4515       if available buf_temp-last-date
     4516       then do:
     4517         assign
     4518           p-record-exist = true
     4519         .
     4520       end.
     4521       else do:
     4522         assign
     4523           p-record-exist = false
     4524         .
     4525       end.
     4526     end.
     4527   END PROCEDURE.
     4528   PROCEDURE create-temp-sel-obj :
     4529     define input  parameter p-obj-type as character no-undo .
     4530     define input  parameter p-obj-code as integer   no-undo .
     4531     define buffer buf_temp-sel-obj for temp-sel-obj .
     4532     do
     4533     on error undo, return error return-value
     4534     :
     4535       define variable v-obj-active as logical   no-undo .
     4536   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4538     (input  p-obj-type
     4539     ,input  p-obj-code
     4540     ,input  'active=request'
     4541     ,output v-obj-active
     4542     )  .
     4543       if v-obj-active
     4544       then do:
     4545         find first buf_temp-sel-obj
     4546           where buf_temp-sel-obj.obj-type = p-obj-type
     4547             and buf_temp-sel-obj.obj-code = p-obj-code
     4548           no-error .
     4549         if not available buf_temp-sel-obj
     4550         then do:
     4551           create buf_temp-sel-obj .
     4552           assign
     4553             buf_temp-sel-obj.obj-type = p-obj-type
     4554             buf_temp-sel-obj.obj-code = p-obj-code
     4555           .
     4556         end.
     4557       end.
     4558     end.
     4559   END PROCEDURE.
     4560   PROCEDURE disable_UI :
