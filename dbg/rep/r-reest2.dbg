     2582           input x-store-type  ,x-TOG-Shift,
     2583           input x-date-start - 1 ,
     2584           input date('')      , x-Shift-Start,x-Shift-End,
     2585           input 'cost':U   ,
     2586           input '##,##':U,
     2587           input xTog-obj ,
     2588           output  Quantity1  ,
     2589           output  Coast_R1   ,
     2590           output  Coast_V1   ,
     2591           output  VAT_R1     ,
     2592           output  VAT_V1     ,
     2593           output  Fact-order-1-C ).
     2594       run ostatok  in this-procedure(
     2595           input x-store-code  ,
     2596           input x-store-type  ,x-TOG-Shift,
     2597           input x-date-start - 1 ,
     2598           input date('')      , x-Shift-Start,x-Shift-End,
     2599           input 'crsa':U   ,
     2600           input '##,##':U,
     2601           input xTog-obj ,
     2602           output  Quantity1  ,
     2603           output  Coast_R3   ,
     2604           output  Coast_V3   ,
     2605           output  VAT_R3     ,
     2606           output  VAT_V3     ,
     2607           output  Fact-order-1-P ).
     2608           Fact-order-1 = Fact-order-1-P .
     2609       run ostatok  in this-procedure (
     2610           input x-store-code  ,
     2611           input x-store-type  , x-TOG-Shift,
     2612           input x-date-start  ,
     2613           input x-date-end    , x-Shift-Start,x-Shift-End,
     2614           input 'cost':U   ,
     2615           input '##,##':U,
     2616           input xTog-obj ,
     2617           output  Quantity2  ,
     2618           output  Coast_R2   ,
     2619           output  Coast_V2   ,
     2620           output  VAT_R2     ,
     2621           output  VAT_V2     ,
     2622           output  Fact-order-2-C ).
     2623       run ostatok  in this-procedure (
     2624           input x-store-code  ,
     2625           input x-store-type  , x-TOG-Shift,
     2626           input x-date-start  ,
     2627           input x-date-end    , x-Shift-Start , x-Shift-End,
     2628           input 'crsa':U   ,
     2629           input '##,##':U,
     2630           input xTog-obj      ,
     2631           output  Quantity2  ,
     2632           output  Coast_R4   ,
     2633           output  Coast_V4   ,
     2634           output  VAT_R4     ,
     2635           output  VAT_V4     ,
     2636           output  Fact-order-2-P ).
     2637           Fact-order-2 = Fact-order-2-P .
     2638       Assign
     2639         Coast1        = if tPrintRubl then Coast_R1 else  Coast_V1
     2640         Coast-vat1    = if tPrintRubl then VAT_R1   else  VAT_V1
     2641         Coast2        = if tPrintRubl then Coast_R2 else  Coast_V2
     2642         Coast-vat2    = if tPrintRubl then VAT_R2   else  VAT_V2
     2643         Coast3        = if tPrintRubl then Coast_R3 else  Coast_V3
     2644         Coast-vat3    = if tPrintRubl then VAT_R3   else  VAT_V3
     2645         Coast4        = if tPrintRubl then Coast_R4 else  Coast_V4
     2646         Coast-vat4    = if tPrintRubl then VAT_R4   else  VAT_V4
     2647         .
     2648   END PROCEDURE.
     2649   PROCEDURE foreach :
     2650     If sliv# Then run pre-foreach in this-procedure .
     2651     for each tdedt where tdedt.id  <> 'rs':U + ',' + 'es':U  no-lock :
     2652         if tdedt.id = 'ot':U Then find-str = 'crsa':U + ','.
     2653         Else  find-str = temp-find-str.
     2654         For each ot-tot WHERE  ot-tot.obj-type = x-store-type
     2655                               AND ot-tot.obj-code    = x-store-code
     2656                               AND ot-tot.Fact-order >  fact-order-1
     2657                               AND ot-tot.Fact-order <= fact-order-2
     2658                               AND Lookup (ot-tot.sum-type  , find-str ) <> 0
     2659                               AND ot-tot.ext-doc-type = tdedt.id no-lock
     2660                               BREAK BY ot-tot.ext-doc-type BY ot-tot.fact-order BY ot-tot.doc-code :
     2661   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2662     ii = ii + 1.
     2663   IF ( ii modulo v-account = 0 )  then DO:
     2664             if  log-manager:logfile-name ne ?
     2665             then DO:
     2666                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2667             end.
     2668              if mFrameView
     2669              then do:
     2670               DISPLAY
     2671                 ii @ RecordsDone
     2672                 WITH FRAME InfoFrame.
     2673              end.
     2674   End.
     2675      if v-button-stop then  DO:
     2676            if mFrameView
     2677            then
     2678               PROCESS EVENTS.
     2679            IF StopProcessing THEN DO:
     2680            RETURN error.
     2681            End.
     2682      end.
     2683     Find ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2684     if avail ub.trn-doc then do:
     2685                       Assign
     2686                         fact-date      = ub.trn-doc.fact-date
     2687                         doc-code       = ub.ot-tot.doc-code
     2688                         cli-name       = ub.trn-doc.cli-name
     2689                         .
     2690                       end.
     2691    else do:
     2692    Assign
     2693         fact-date      = ?
     2694         doc-code       = ub.ot-tot.doc-code
     2695         cli-name       = ""
     2696         qnty           = 0
     2697         .
     2698         end.
     2699         IF ub.ot-tot.sum-type = 'crsa':U  THEN DO:
     2700                 If  ub.ot-tot.ext-doc-type = 'ot':U then DO:
     2701                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     2702                     Assign
     2703                       fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc THEN ub.price-doc.fact-date ELSE date(''))
     2704                       doc-code       = ub.ot-tot.doc-code
     2705                       cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else ""
     2706                       qnty           = ub.ot-tot.fact-qnty
     2707                       Sale-sum-ot   = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     2708                       Accumulate Sale-sum-ot (TOTAL) .
     2709                 End.
     2710               if  ub.ot-tot.ext-doc-type = 'vt':U then do :
     2711                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2712                 if avail ub.trn-doc then
     2713                                 Assign
     2714                                     fact-date      = ub.trn-doc.fact-date
     2715                                     doc-code       = ub.ot-tot.doc-code
     2716                                     cli-name       = ub.trn-doc.cli-name
     2717                                     qnty           = ub.ot-tot.fact-qnty
     2718                                     .
     2719                   if not can-find
     2720                   (first cost-ot-tot-inv where
     2721                          cost-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     2722                          cost-ot-tot-inv.sum-type = 'cost':U no-lock )
     2723                           Then
     2724                           Assign
     2725                             SumWithNDS-coast    = 0
     2726                             VAT-Sum-coast       = 0
     2727                             SLT-sum-coast       = 0
     2728                             SumWithoutNDS-coast = 0
     2729                           .
     2730                   if not can-find
     2731                   (first sale-ot-tot-inv where
     2732                          sale-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     2733                          sale-ot-tot-inv.sum-type = 'sale':U no-lock )
     2734                           Then
     2735                           Assign
     2736                             discnt-sum   =      0
     2737                             ov-sum       =      0
     2738                             VAT-Sum      =      0
     2739                             SLT-sum      =      0
     2740                             SumWithoutNDS =     0
     2741                             SumWithNDS    =     0
     2742                             .
     2743               End.
     2744         End.
     2745         IF ub.ot-tot.sum-type = 'sale':U  THEN DO:
     2746             Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2747                 If  ub.ot-tot.ext-doc-type = 'ot':U then
     2748                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     2749             Assign
     2750             fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc then ub.price-doc.fact-date ELSE date(''))
     2751             doc-code       = ub.ot-tot.doc-code
     2752             cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else " "
     2753             qnty           = ub.ot-tot.fact-qnty
     2754             SumWithNDS     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     2755             iF SumWithNDS = ? tHEN SumWithNDS = 0.
     2756             If not Available ub.trn-doc Then
     2757                Assign    discnt-sum     = 0
     2758                          ov-sum         = 0.
     2759             discnt-sum     = if tPrintRubl then ub.ot-tot.other-rubl
     2760                                            else ub.ot-tot.other-base .
     2761              iF discnt-sum = ? tHEN discnt-sum = 0.
     2762              if ub.ot-tot.ext-doc-type = 'vt':U THEN discnt-sum = 0.
     2763             Assign
     2764             VAT_pc         = 0
     2765             VAT-Sum        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     2766             SLT_pc         = 0
     2767             SLT-sum        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base.
     2768             iF VAT-Sum = ? tHEN VAT-Sum = 0.
     2769             iF SLT-sum = ? tHEN slt-Sum = 0.
     2770             SumWithoutNDS  = SumWithNDS - VAT-Sum.
     2771               FIND LAST crsa-ot-tot where
     2772                   crsa-ot-tot.doc-code = ub.ot-tot.doc-code   and
     2773                   crsa-ot-tot.sum-type = 'crsa':U    and
     2774                   crsa-ot-tot.cat-id   = ub.ot-tot.cat-id  no-lock use-index pi.
     2775                   if available crsa-ot-tot then
     2776                   sale-sum       = if tPrintRubl then crsa-ot-tot.sum-rubl else crsa-ot-tot.sum-base .
     2777                   Else sale-sum  = 0.
     2778                   ov-sum =  sale-sum - ( SumWithNDS +  discnt-sum ).
     2779             Accumulate sale-sum     (TOTAL) .
     2780             Accumulate qnty         (TOTAL) .
     2781             Accumulate SumWithNDS   (TOTAL) .
     2782             Accumulate discnt-sum   (TOTAL) .
     2783             Accumulate ov-sum       (TOTAL) .
     2784             Accumulate VAT-Sum      (TOTAL) .
     2785             Accumulate SLT-sum      (TOTAL) .
     2786             Accumulate SumWithoutNDS  (TOTAL) .
     2787          End.
     2788         IF ub.ot-tot.sum-type = 'cost':U  THEN DO:
     2789             Assign
     2790             SumWithNDS-coast     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base
     2791             VAT-Sum-coast        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     2792             SLT-sum-coast        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base
     2793             SumWithoutNDS-coast  = SumWithNDS-coast - VAT-Sum-coast.
     2794             if fact-date = date('') and ub.ot-tot.ext-doc-type <> 'ot':U then do:
     2795                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2796                 if avail ub.trn-doc then
     2797                                       Assign
     2798                                           fact-date      = ub.trn-doc.fact-date
     2799                                           doc-code       = ub.ot-tot.doc-code
     2800                                           cli-name       = ub.trn-doc.cli-name
     2801                                           .
     2802             end.
     2803             Accumulate SumWithNDS-coast          (TOTAL) .
     2804             Accumulate VAT-Sum-coast             (TOTAL) .
     2805             Accumulate SLT-sum-coast             (TOTAL) .
     2806             Accumulate SumWithoutNDS-coast       (TOTAL) .
     2807          End.
     2808        IF ub.ot-tot.sum-type BEGINS 'cost':U and ub.ot-tot.sum-type <> 'cost':U Then DO:
     2809               IF CostSum Then DO:
     2810                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2811   create tmp#taxVAT.
     2812   assign tmp#taxVAT.type    = ot-tot.sum-type
     2813         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2814         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2815         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2816         .
     2817   i = i + 1.
     2818   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2819                           and acc#taxVAT.type = tmp#taxVAT.type
     2820                           no-error.
     2821   if available acc#taxVAT then
     2822     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     2823     else do:
     2824         create acc#taxVAT.
     2825         assign acc#taxVAT.type    = ot-tot.sum-type
     2826                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2827                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2828                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2829             acc-i = acc-i + 1.
     2830     end.
     2831      End.
     2832                    Else DO:
     2833   create tmp#taxslt.
     2834   assign tmp#taxslt.type    = ot-tot.sum-type
     2835         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2836         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2837         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2838         .
     2839   j = j + 1.
     2840   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     2841                           and acc#taxslt.type = tmp#taxslt.type
     2842                           no-error.
     2843   if available acc#taxslt then
     2844     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     2845     else do:
     2846         create acc#taxslt.
     2847         assign acc#taxslt.type    = ot-tot.sum-type
     2848                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2849                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2850                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2851             acc-j = acc-j + 1.
     2852     end.
     2853     End.
     2854                 End.
     2855             End.
     2856        IF ub.ot-tot.sum-type BEGINS 'sale':U and ub.ot-tot.sum-type <> 'sale':U Then DO:
     2857                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2858   create tmp#taxVAT.
     2859   assign tmp#taxVAT.type    = ot-tot.sum-type
     2860         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2861         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2862         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2863         .
     2864   i = i + 1.
     2865   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2866                           and acc#taxVAT.type = tmp#taxVAT.type
     2867                           no-error.
     2868   if available acc#taxVAT then
     2869     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     2870     else do:
     2871         create acc#taxVAT.
     2872         assign acc#taxVAT.type    = ot-tot.sum-type
     2873                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2874                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2875                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2876             acc-i = acc-i + 1.
     2877     end.
     2878      End.
     2879                    Else DO:
     2880   create tmp#taxslt.
     2881   assign tmp#taxslt.type    = ot-tot.sum-type
     2882         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2883         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2884         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2885         .
     2886   j = j + 1.
     2887   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     2888                           and acc#taxslt.type = tmp#taxslt.type
     2889                           no-error.
     2890   if available acc#taxslt then
     2891     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     2892     else do:
     2893         create acc#taxslt.
     2894         assign acc#taxslt.type    = ot-tot.sum-type
     2895                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2896                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2897                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2898             acc-j = acc-j + 1.
     2899     end.
     2900     End.
     2901        End.
     2902         IF ub.ot-tot.sum-type BEGINS 'crsa':U and ub.ot-tot.sum-type <> 'crsa':U Then DO:
     2903                   IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2904   create tmp#taxVAT.
     2905   assign tmp#taxVAT.type    = ot-tot.sum-type
     2906         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2907         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2908         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2909         .
     2910   i = i + 1.
     2911   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2912                           and acc#taxVAT.type = tmp#taxVAT.type
     2913                           no-error.
     2914   if available acc#taxVAT then
     2915     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     2916     else do:
     2917         create acc#taxVAT.
     2918         assign acc#taxVAT.type    = ot-tot.sum-type
     2919                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2920                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2921                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2922             acc-i = acc-i + 1.
     2923     end.
     2924      End.
     2925                     Else DO:
     2926   create tmp#taxslt.
     2927   assign tmp#taxslt.type    = ot-tot.sum-type
     2928         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2929         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2930         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2931         .
     2932   j = j + 1.
     2933   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     2934                           and acc#taxslt.type = tmp#taxslt.type
     2935                           no-error.
     2936   if available acc#taxslt then
     2937     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     2938     else do:
     2939         create acc#taxslt.
     2940         assign acc#taxslt.type    = ot-tot.sum-type
     2941                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2942                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2943                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2944             acc-j = acc-j + 1.
     2945     end.
     2946     End.
     2947         End.
     2948             if first-of ( ot-tot.ext-doc-type ) then  run break-h-1.
     2949             if last-of ( ub.ot-tot.doc-code ) then do:
     2950                 if (ub.ot-tot.sum-type     =  'crsa':U  and
     2951                    not (ub.ot-tot.ext-doc-type = 'vt':U ))
     2952                    then do:
     2953                       run break-ot.
     2954                       if ub.ot-tot.ext-doc-type = 'ap':U and costsum then run break-cost.
     2955                    end.
     2956                    else do:
     2957                       run break-1str.
     2958                       if available ub.trn-doc then do:
     2959                         if (absolute(ub.trn-doc.fact-qnty) - absolute(ub.trn-doc.doc-qnty) <> 0)
     2960                             and ub.ot-tot.ext-doc-type <> 'vt':U
     2961                             then run break-akt.
     2962                         end.
     2963                       if costsum then run break-cost.
     2964                       run break-2str.
     2965                       if dispupfact then run break-disp .
     2966                    end.
     2967                run erase-var.
     2968             end.
     2969             if last-of ( ot-tot.ext-doc-type ) then do:
     2970                 qnty               = accum total       qnty                       .
     2971                 sumwithnds         = accum total       sumwithnds                 .
     2972                 discnt-sum         = accum total       discnt-sum                 .
     2973                 ov-sum             = accum total       ov-sum                     .
     2974                 vat-sum            = accum total       vat-sum                    .
     2975                 slt-sum            = accum total       slt-sum                    .
     2976                 sumwithoutnds      = accum total       sumwithoutnds              .
     2977                 sumwithnds-coast   = accum total       sumwithnds-coast           .
     2978                 vat-sum-coast      = accum total       vat-sum-coast              .
     2979                 slt-sum-coast      = accum total       slt-sum-coast              .
     2980                 sumwithoutnds-coast= accum total       sumwithoutnds-coast        .
     2981                 sale-sum-ot        = accum total       sale-sum-ot                .
     2982                 sale-sum           = (accum total       sale-sum   )  + sale-sum-ot  .
     2983   for each tmp#taxvat : delete tmp#taxvat. end.
     2984   for each acc#taxvat :
     2985     create tmp#taxvat.
     2986     assign tmp#taxvat.type   = acc#taxvat.type
     2987           tmp#taxvat.pc      = acc#taxvat.pc
     2988           tmp#taxvat.sum     = acc#taxvat.sum.
     2989   end.
     2990   i = acc-i.
     2991   for each tmp#taxslt : delete tmp#taxslt. end.
     2992   for each acc#taxslt :
     2993     create tmp#taxslt.
     2994     assign tmp#taxslt.type   = acc#taxslt.type
     2995           tmp#taxslt.pc      = acc#taxslt.pc
     2996           tmp#taxslt.sum     = acc#taxslt.sum.
     2997   end.
     2998   j = acc-j.
     2999                run break-f-1.
     3000                End.
     3001         END.
     3002     End.
     3003     If sliv#  Then run runkassa in this-procedure.
     3004   END PROCEDURE.
     3005   PROCEDURE Break-H-1 :
     3006   Display stream OutStream
     3007       sym1
     3008       sym2
     3009       sym3
     3010       CAPS (tdedt.name)  @ F-cli-name
     3011       sym4
     3012       sym5
     3013       sym6
     3014       sym7
     3015       sym8
     3016       sym9
     3017       sym10
     3018       sym11
     3019       sym12
     3020       sym13
     3021       sym14
     3022       with FRAME DocsRep .
     3023       DOWN stream  OutStream 1 with FRAME DocsRep.
     3024       run new-tmp-page .
     3025       num#str# = num#str# + 1.
     3026       num#col# = 3.
     3027       run macr_excel_char( CAPS (tdedt.name)  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3028       run macr_cell_format (
     3029           10       ,
     3030           true     ,
     3031           false    ,
     3032           35       ,
     3033           num#str# ,
     3034           3        ,
     3035           num#str# ,
     3036           3 )
     3037           .
     3038   END PROCEDURE.
     3039   PROCEDURE Break-F-1 :
     3040    run u-line in this-procedure .
     3041    assign
     3042      fact-date = date('')
     3043      doc-code  = ''
     3044      cli-name  = "ИТОГО " +  tdedt.name .
     3045      run break-1str in this-procedure .
     3046      if costsum then run break-cost in this-procedure .
     3047    run break-2str in this-procedure .
     3048    if dispupfact then
     3049       run break-disp in this-procedure .
     3050    run u-line in this-procedure .
     3051    run erase-var1 in this-procedure .
     3052    run erase-var in this-procedure .
     3053   END PROCEDURE.
     3054   PROCEDURE Break-1str :
     3055   Display stream OutStream
     3056       sym1
     3057       fact-date format "99/99/9999" @ f-fact-date
     3058       sym2
     3059       doc-code @ f-doc-code
     3060       sym3
     3061       cli-name @ f-cli-name
     3062       sym4
     3063       qnty format "->>>>>>>9.999"   @ F-qnty
     3064       sym5
     3065       sym6
     3066       sym7
     3067       sym8
     3068       sym9
     3069       sym10
     3070       sym11
     3071       sym12
     3072       sym13
     3073       sym14
     3074       with FRAME DocsRep .
     3075       DOWN stream  OutStream 1 with FRAME DocsRep.
     3076       run new-tmp-page .
     3077       num#str# = num#str# + 1.
     3078       num#col# = 1.
     3079       run macr_excel_char (if fact-date = ? then "" else  string( fact-date ,  "99/99/9999") , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3080       run macr_excel_char (doc-code , num#str# , num#col#    ) . assign    num#col# = num#col# + 1 .
     3081       run macr_excel_char (cli-name , num#str# , num#col#    ) . assign    num#col# = num#col# + 1 .
     3082       run macr_excel_dec  (qnty     , num#str# , num#col#    ) . assign    num#col# = num#col# + 1 .
     3083   END PROCEDURE.
     3084   PROCEDURE Break-ot :
     3085   if NOT (NOT NullPer And sale-sum-ot = 0 And VAT-Sum = 0 and VAT-Sum-coast = 0) THEN DO:
     3086   Display stream OutStream
     3087       sym1
     3088       fact-date format "99/99/9999" @ f-fact-date
     3089       sym2
     3090       doc-code @ f-doc-code
     3091       sym3
     3092       cli-name @ f-cli-name
     3093       sym4
     3094       qnty format "->>>>>>>9.999"   @ F-qnty
     3095       sym5
     3096       sym6
     3097       sym7
     3098       sym8
     3099       sym9
     3100       sale-sum-ot @ F-sale-sum
     3101       sym10
     3102       sym11
     3103       sym12
     3104       sym13
     3105       sym14
     3106           with FRAME DocsRep .
     3107           DOWN stream  OutStream 1 with FRAME DocsRep.
     3108       run new-tmp-page .
     3109       num#str# = num#str# + 1.
     3110       num#col# = 1.
     3111       run macr_excel_char( if fact-date = ? then "" else  string( fact-date, "99/99/9999") , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3112       run macr_excel_char(doc-code , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3113       run macr_excel_char(cli-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3114       run macr_excel_dec(qnty      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3115       num#col# = 9.
     3116       run macr_excel_dec(sale-sum-ot, num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3117    End .
     3118   END PROCEDURE.
     3119   PROCEDURE Break-2str :
     3120     define variable str-inv  as character initial "" no-undo .
     3121     define variable str-inv1 as character initial "" no-undo .
     3122     define buffer buf_doc-attr for doc-attr.
     3123     str-inv1 = "".
     3124     If Available trn-doc then do:
     3125       if not(cli-name begins "ИТОГО") then do:
     3126         find first buf_doc-attr no-lock
     3127           where buf_doc-attr.doc-code  = trn-doc.doc-code
     3128             and buf_doc-attr.attr-code = 'nids':U
     3129         no-error .
     3130         if avail buf_doc-attr then assign  str-inv1 = buf_doc-attr.attr-value .
     3131         find first buf_doc-attr no-lock
     3132           where buf_doc-attr.doc-code  = trn-doc.doc-code
     3133             and buf_doc-attr.attr-code = 'dids':U
     3134         no-error .
     3135         if avail buf_doc-attr then assign  str-inv1 =  str-inv1  +  ( if  buf_doc-attr.attr-value <> ? and buf_doc-attr.attr-value <> ""  then (  " от " + buf_doc-attr.attr-value ) else " " ).
     3136         if trim(str-inv1) <> "" then assign str-inv = "Основ. " .
     3137       end.
     3138     end.
     3139     Display stream OutStream
     3140       sym1
     3141       sym2    str-inv                           @ f-doc-code
     3142       sym3    str-inv1                          @ f-cli-name
     3143       sym4    "По документу"                    @ f-qnty
     3144       sym5    SumWithNDS                        @ F-SumWithNDS
     3145       sym6    SumWithoutNDS                     @ f-SumWithoutNDS
     3146       sym7    discnt-sum                        @ f-discnt-sum
     3147       sym8    ov-sum  when ( NO-PRISE = true )  @ f-ov-sum
     3148       sym9    sale-sum                          @ f-sale-sum
     3149       sym10   "итого"                           @ f-VAT_PC
     3150       sym11   VAT-Sum                           @ f-vat-sum
     3151       sym12
     3152       sym13   SLT-sum                           @ f-slt-sum
     3153       sym14
     3154     with FRAME DocsRep .
     3155     DOWN stream  OutStream 1 with FRAME DocsRep.
     3156       run new-tmp-page .
     3157       num#str# = num#str# + 1.
     3158       num#col# = 1.
     3159       run macr_excel_char ( ""                               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3160       run macr_excel_char ( str-inv                          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3161       run macr_excel_char ( str-inv1                         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3162       run macr_excel_char ( "По документу"                   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3163       run macr_excel_char ( SumWithNDS                       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3164       run macr_excel_char ( SumWithoutNDS                    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3165       run macr_excel_char ( discnt-sum                       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3166       run macr_excel_char ( (if NO-PRISE = true then string(ov-sum)  else "" ), num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3167       run macr_excel_char ( sale-sum                         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3168       run macr_excel_char ( "итого"                          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3169       run macr_excel_char ( VAT-Sum                          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3170       run macr_excel_char ( ""                               , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3171       run macr_excel_char ( SLT-sum                          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3172     str-inv1 = "" .
     3173     If Available trn-doc then do:
     3174       if not(cli-name begins "ИТОГО") then do:
     3175         find first buf_doc-attr no-lock
     3176           where buf_doc-attr.doc-code  = trn-doc.doc-code
     3177             and buf_doc-attr.attr-code = 'ndog':U
     3178         no-error .
     3179         if avail buf_doc-attr then assign  str-inv1 = buf_doc-attr.attr-value .
     3180         find first buf_doc-attr no-lock
     3181           where buf_doc-attr.doc-code  = trn-doc.doc-code
     3182             and buf_doc-attr.attr-code = 'ddog':U
     3183         no-error .
     3184         if avail buf_doc-attr then assign  str-inv1 =  str-inv1  +  ( if  buf_doc-attr.attr-value <> ? and buf_doc-attr.attr-value <> ""  then (  " от " + buf_doc-attr.attr-value ) else " " ).
     3185             if trim(str-inv1) <> "" then assign str-inv = "Договор " .
     3186       end.
     3187     end.
     3188     if trim(str-inv1) <> "" then do:
     3189         display stream outstream
     3190           sym1
     3191           sym2    str-inv                           @ f-doc-code
     3192           sym3    str-inv1                          @ f-cli-name
     3193           sym4
     3194           sym5
     3195           sym6
     3196           sym7
     3197           sym8
     3198           sym9
     3199           sym10
     3200           sym11
     3201           sym12
     3202           sym13
     3203           sym14
     3204         with frame docsrep .
     3205         down stream  outstream 1 with frame docsrep.
     3206       run new-tmp-page .
     3207       num#str# = num#str# + 1.
     3208       num#col# = 2.
     3209       run macr_excel_char ( str-inv  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3210       run macr_excel_char ( str-inv1 , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3211     end.
     3212     if vat-slt   then run break-vat  in this-procedure ( 'sale':U) .
     3213     if vat-slt-s then run break-vat-sub in this-procedure  ( 'sale':U) .
     3214     if vat-slt   then run break-vat  in this-procedure ( 'crsa':U) .
     3215     if vat-slt-s then run break-vat-sub in this-procedure  ( 'crsa':U) .
     3216   END PROCEDURE.
     3217   PROCEDURE Break-cost :
     3218   Display stream OutStream
     3219       sym1
     3220       sym2
     3221       sym3
     3222       sym4
     3223       "Учет" @ F-qnty
     3224       sym5
     3225       SumWithNDS-coast    @  f-SumWithNDS
     3226       sym6
     3227       SumWithoutNDS-coast @ F-SumWithoutNDS
     3228       sym7
     3229       sym8
     3230       sym9
     3231       sym10
     3232       "итого"            @ f-vat_PC
     3233       sym11
     3234       VAT-Sum-coast      @ f-VAT-Sum
     3235       sym12
     3236       space(6)
     3237       sym13
     3238       SLT-sum-coast      @ f-slt-sum
     3239       sym14
     3240       with FRAME DocsRep .
     3241       DOWN stream  OutStream 1 with FRAME DocsRep.
     3242       run new-tmp-page .
     3243       num#str# = num#str# + 1.
     3244       num#col# = 4.
     3245       run macr_excel_char("Учет"     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3246       run macr_excel_char(SumWithNDS-coast          , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3247       run macr_excel_char(SumWithoutNDS-coast       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3248       run macr_excel_char(""                        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3249       run macr_excel_char(""                        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3250       run macr_excel_char(""                        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3251       run macr_excel_char("итого"                   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3252       run macr_excel_char(VAT-Sum-coast             , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3253       run macr_excel_char( ""                       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3254       run macr_excel_char(SLT-sum-coast             , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3255       if vat-slt then   run break-vat  in this-procedure ( 'cost':U) .
     3256       if vat-slt-s then   run break-vat-sub in this-procedure  ( 'cost':U) .
     3257   END PROCEDURE.
     3258   PROCEDURE Break-Akt :
     3259    tmpact = ABSOLUTE (If Available  trn-doc then trn-doc.doc-qnty else 0 )
     3260            - ABSOLUTE (If Available trn-doc then  trn-doc.fact-qnty else 0).
     3261   Display stream OutStream
     3262       sym1
