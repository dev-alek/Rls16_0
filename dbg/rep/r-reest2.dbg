      898   define variable v-inform-launched as logical no-undo initial false .
      899   procedure proc-alt-shift-f4:
      900     define variable v-action as character no-undo .
      901     if v-inform-launched = false then do:
      902       assign
      903         v-inform-launched = true
      904       .
      905       run gbl/d-inform.w
      906         (  input self
      907         ,  input this-procedure
      908         , output v-action
      909         ) no-error .
      910       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      911       assign
      912         v-inform-launched = false
      913       .
      914     end.
      915   end.
