     3284       run macr_excel_char(tmpact                   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3285   END PROCEDURE.
     3286   PROCEDURE Break-disp :
     3287     Assign
     3288     SumWithNDS-disp     = sale-sum - SumWithoutNDS-coast
     3289     SumWithoutNDS-disp  = SumWithNDS - VAT-Sum - SLT-Sum - SumWithoutNDS-coast.
     3290   Display stream OutStream
     3291       sym1
     3292       sym2
     3293       sym3
     3294       sym4
     3295       "Наценка" @ f-qnty
     3296       sym5
     3297       SumWithNDS-disp   @ f-SumWithNDS
     3298       sym6
     3299       SumWithoutNDS-disp @ f-SumWithoutNDS
     3300       sym7
     3301       sym8
     3302       sym9
     3303       sym10
     3304       sym11
     3305       sym12
     3306       sym13
     3307       sym14
     3308           with FRAME DocsRep .
     3309           DOWN stream  OutStream 1 with FRAME DocsRep.
     3310       run new-tmp-page .
     3311       num#str# = num#str# + 1.
     3312       num#col# = 4.
     3313       run macr_excel_char("Наценка"         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3314       run macr_excel_char(SumWithNDS-disp   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3315       run macr_excel_char(SumWithoutNDS-disp, num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3316   END PROCEDURE.
     3317   PROCEDURE Break-VAT :
     3318   define input parameter par1 as char.
     3319   define variable x-pc_vat as integer no-undo .
     3320   define variable x-pc_slt as integer no-undo .
     3321   define variable x-vat-sum  as decimal format "->>,>>>,>>9.99" no-undo .
     3322   define variable x-vat    as decimal format "->>,>>>,>>9.99" no-undo .
     3323   define variable x-slt    as decimal format "->>,>>>,>>9.99" no-undo .
     3324   DEFINE buffer buff-ot-line-tax for ub.ot-line .
     3325   Find first tmp#taxVAt where tmp#taxVAt.type BEGINS par1 no-error .
     3326   Find first tmp#taxSLT where tmp#taxSLT.type BEGINS par1 no-error .
     3327           Display stream OutStream
     3328               sym1
     3329               sym2
     3330               sym3
     3331               sym4
     3332               sym5
     3333               sym6
     3334               sym7
     3335               sym8
     3336               sym9
     3337               (if par1  begins 'crsa':U then 'В прод.ценах'  else '') @ f-qnty
     3338               sym10
     3339               "---------------" @ f-SumWithNDS
     3340               "---------------" @ f-SumWithoutNDS
     3341               "---------------" @ f-discnt-sum
     3342               "---------------" @ f-ov-sum
     3343               "---------------" @ f-sale-sum
     3344               "------"         @ f-vat_PC
     3345               "-"              @ sym11
     3346               "Итоги по ставка" @ f-VAT-Sum
     3347               "м"              @ sym12
     3348               " налог"         @ f-SLT_PC
     3349               "о"              @ sym13
     3350               "в--------------" @ f-slt-sum
     3351               "-"              @ sym14
     3352               with FRAME DocsRep .
     3353               DOWN stream  OutStream 1 with FRAME DocsRep.
     3354               run new-tmp-page .
     3355               num#str# = num#str# + 1.
     3356               num#col# = 10.
     3357               run macr_excel_char("Итоги по ставкам налогов"         , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3358       Repeat k = 1 to  maximum(i,j) :
     3359           If Available tmp#taxVAt then
     3360               Assign  v-vat_pc   = tmp#taxVAt.pc
     3361                       v-vat_sum  = tmp#taxVAt.sum
     3362                       v-vat_sum_f  = tmp#taxVAt.sum_full
     3363                       .
     3364               Else
     3365               Assign  v-vat_pc   = ''
     3366                       v-vat_sum  = 0
     3367                       v-vat_sum_f  = 0 .
     3368           If available tmp#taxSLT  then
     3369               Assign v-SLT_pc    = tmp#taxSLT.pc
     3370                       v-SLT_sum  = tmp#taxSLT.sum.
     3371               Else
     3372               Assign v-SLT_pc   = ''
     3373                      v-SLT_sum  = 0 .
     3374           if NOT (decimal(v-SLT_pc) = 0 And decimal(v-vat_pc) = 0 ) THEN DO :
     3375               Display stream OutStream
     3376                   sym1 sym2 sym3 sym4
     3377                   ">" @ sym5
     3378                   v-VAT_sum_f     @ f-SumWithNDS
     3379                   "<" @ sym6
     3380                   sym7
     3381                   sym8
     3382                   sym9
     3383                   sym10
     3384                   string(integer(v-VAT_pc),">9") + '%'    @ f-vat_PC
     3385                   sym11
     3386                   v-VAT_sum      @ f-VAT-Sum
     3387                   sym12
     3388                   string(integer(v-SLT_pc),">9") + '%'     @ f-SLT_PC
     3389                   sym13
     3390                   v-SLT_sum      @ f-slt-sum
     3391                   sym14
     3392                   with FRAMe DocsRep .
     3393                   DOWN stream  OutStream 1 with FRAME DocsRep.
     3394                   run new-tmp-page .
     3395                   num#str# = num#str# + 1.
     3396                   num#col# = 5.
     3397                   run macr_excel_char(v-VAT_sum_f        , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3398                   num#col# = 10.
     3399                   run macr_excel_char(string(integer(v-VAT_pc),">9") + '%', num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3400                   run macr_excel_char(v-VAT_sum             , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3401                   run macr_excel_char(string(integer(v-SLT_pc),">9") + '%'    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3402                   run macr_excel_char(v-SLT_sum    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3403                 End.
     3404           find NEXT tmp#taxVAt where tmp#taxVAt.type BEGINS par1 no-error.
     3405           find NEXT tmp#taxSLT where tmp#taxSLT.type BEGINS par1 no-error.
     3406       End.
     3407   END PROCEDURE.
     3408   PROCEDURE Erase-var :
     3409     If vat-slt then DO:
     3410       For each tmp#taxVAt : delete tmp#taxVAT . End.
     3411       For each tmp#taxSLT : delete tmp#taxSLT . End.
     3412       assign
     3413         v-VAT_pc  = ''
     3414         v-VAT_sum = 0
     3415         v-VAT_sum_f = 0
     3416         v-SLT_pc  = ''
     3417         v-SLT_sum = 0
     3418         i = 0
     3419         J = 0
     3420       .
     3421       End.
     3422     Assign
     3423        qnty                  = 0
     3424        SumWithNDS            = 0
     3425        SumWithoutNDS         = 0
     3426        discnt-sum            = 0
     3427        ov-sum                = 0
     3428        sale-sum              = 0
     3429        sale-sum-ot           = 0
     3430        VAT_pc                = 0
     3431        VAT-Sum               = 0
     3432        SLT_pc                = 0
     3433        SLT-sum               = 0
     3434        SumWithNDS-coast      = 0
     3435        SumWithoutNDS-coast   = 0
     3436        VAT-Sum-coast         = 0
     3437        SLT-sum-coast         = 0
     3438        SumWithNDS-disp       = 0
     3439        SumWithoutNDS-disp    = 0
     3440         .
     3441   END PROCEDURE.
     3442   PROCEDURE pre-foreach :
     3443     if can-find (first tdedt where tdedt.id = 'rs':U) AND
     3444        can-find (first tdedt where tdedt.id = 'es':U)  Then  DO:
     3445        Find  First tdedt where tdedt.id = 'rs':U no-error.
     3446        delete tdedt no-error.
     3447        Find  First tdedt where tdedt.id = 'es':U no-error.
     3448        delete tdedt no-error.
     3449        create tdedt.
     3450        Assign  tdedt.id   = 'rs':U + ',' + 'es':U
     3451                tdedt.name = 'касса' .
     3452     End.
     3453    find-str = 'crsa':U + ',' + 'sale':U + ',' +
     3454          if CostSum Then
     3455                'cost':U + ','
     3456                Else "".
     3457    find-str = find-str +
     3458          if VAT-SLT Then
     3459                     'cost':U + 'v':U + ','
     3460                   + 'cost':U + 's':U + ','
     3461                   + 'sale':U + 'v':U + ','
     3462                   + 'sale':U + 's':U + ','
     3463                   + 'crsa':U + 'v':U + ','
     3464                   + 'crsa':U + 's':U + ','
     3465                   + 'crsa':U + ','
     3466                 Else ""   .
     3467    temp-find-str = find-str.
     3468   END PROCEDURE.
     3469   PROCEDURE erase-var1 :
     3470       acc-i=0.
     3471       acc-J=0.
     3472       For each acc#taxSLT : delete acc#taxSLT . End.
     3473       For each acc#taxVAt : delete acc#taxVAT . End.
     3474   END PROCEDURE.
     3475   procedure runkassa :
     3476     find-str = temp-find-str.
     3477         For each ot-tot WHERE  ot-tot.obj-type = x-store-type
     3478                                         AND ot-tot.obj-code    = x-store-code
     3479                                         AND ot-tot.Fact-order >  fact-order-1
     3480                                         AND ot-tot.Fact-order <= fact-order-2
     3481                                         AND Lookup (ot-tot.sum-type  , find-str ) <> 0
     3482                                         AND (ot-tot.ext-doc-type = 'rs':U
     3483                                         OR ot-tot.ext-doc-type = 'es':U) no-lock,
     3484                         First tdedt where tdedt.id  = 'rs':U + ',' + 'es':U  no-lock
     3485                                         BREAK BY tdedt.id BY ot-tot.fact-order BY ot-tot.doc-code :
     3486   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3487     ii = ii + 1.
     3488   IF ( ii modulo v-account = 0 )  then DO:
     3489             if  log-manager:logfile-name ne ?
     3490             then DO:
     3491                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3492             end.
     3493              if mFrameView
     3494              then do:
     3495               DISPLAY
     3496                 ii @ RecordsDone
     3497                 WITH FRAME InfoFrame.
     3498              end.
     3499   End.
     3500      if v-button-stop then  DO:
     3501            if mFrameView
     3502            then
     3503               PROCESS EVENTS.
     3504            IF StopProcessing THEN DO:
     3505            RETURN error.
     3506            End.
     3507      end.
     3508     Find ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     3509     if avail ub.trn-doc then do:
     3510                       Assign
     3511                         fact-date      = ub.trn-doc.fact-date
     3512                         doc-code       = ub.ot-tot.doc-code
     3513                         cli-name       = ub.trn-doc.cli-name
     3514                         .
     3515                       end.
     3516    else do:
     3517    Assign
     3518         fact-date      = ?
     3519         doc-code       = ub.ot-tot.doc-code
     3520         cli-name       = ""
     3521         qnty           = 0
     3522         .
     3523         end.
     3524         IF ub.ot-tot.sum-type = 'crsa':U  THEN DO:
     3525                 If  ub.ot-tot.ext-doc-type = 'ot':U then DO:
     3526                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     3527                     Assign
     3528                       fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc THEN ub.price-doc.fact-date ELSE date(''))
     3529                       doc-code       = ub.ot-tot.doc-code
     3530                       cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else ""
     3531                       qnty           = ub.ot-tot.fact-qnty
     3532                       Sale-sum-ot   = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     3533                       Accumulate Sale-sum-ot (TOTAL) .
     3534                 End.
     3535               if  ub.ot-tot.ext-doc-type = 'vt':U then do :
     3536                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     3537                 if avail ub.trn-doc then
     3538                                 Assign
     3539                                     fact-date      = ub.trn-doc.fact-date
     3540                                     doc-code       = ub.ot-tot.doc-code
     3541                                     cli-name       = ub.trn-doc.cli-name
     3542                                     qnty           = ub.ot-tot.fact-qnty
     3543                                     .
     3544                   if not can-find
     3545                   (first cost-ot-tot-inv where
     3546                          cost-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     3547                          cost-ot-tot-inv.sum-type = 'cost':U no-lock )
     3548                           Then
     3549                           Assign
     3550                             SumWithNDS-coast    = 0
     3551                             VAT-Sum-coast       = 0
     3552                             SLT-sum-coast       = 0
     3553                             SumWithoutNDS-coast = 0
     3554                           .
     3555                   if not can-find
     3556                   (first sale-ot-tot-inv where
     3557                          sale-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     3558                          sale-ot-tot-inv.sum-type = 'sale':U no-lock )
     3559                           Then
     3560                           Assign
     3561                             discnt-sum   =      0
     3562                             ov-sum       =      0
     3563                             VAT-Sum      =      0
     3564                             SLT-sum      =      0
     3565                             SumWithoutNDS =     0
     3566                             SumWithNDS    =     0
     3567                             .
     3568               End.
     3569         End.
     3570         IF ub.ot-tot.sum-type = 'sale':U  THEN DO:
     3571             Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     3572                 If  ub.ot-tot.ext-doc-type = 'ot':U then
     3573                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     3574             Assign
     3575             fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc then ub.price-doc.fact-date ELSE date(''))
     3576             doc-code       = ub.ot-tot.doc-code
     3577             cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else " "
     3578             qnty           = ub.ot-tot.fact-qnty
     3579             SumWithNDS     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     3580             iF SumWithNDS = ? tHEN SumWithNDS = 0.
     3581             If not Available ub.trn-doc Then
     3582                Assign    discnt-sum     = 0
     3583                          ov-sum         = 0.
     3584             discnt-sum     = if tPrintRubl then ub.ot-tot.other-rubl
     3585                                            else ub.ot-tot.other-base .
     3586              iF discnt-sum = ? tHEN discnt-sum = 0.
     3587              if ub.ot-tot.ext-doc-type = 'vt':U THEN discnt-sum = 0.
     3588             Assign
     3589             VAT_pc         = 0
     3590             VAT-Sum        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     3591             SLT_pc         = 0
     3592             SLT-sum        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base.
     3593             iF VAT-Sum = ? tHEN VAT-Sum = 0.
     3594             iF SLT-sum = ? tHEN slt-Sum = 0.
     3595             SumWithoutNDS  = SumWithNDS - VAT-Sum.
     3596               FIND LAST crsa-ot-tot where
     3597                   crsa-ot-tot.doc-code = ub.ot-tot.doc-code   and
     3598                   crsa-ot-tot.sum-type = 'crsa':U    and
     3599                   crsa-ot-tot.cat-id   = ub.ot-tot.cat-id  no-lock use-index pi.
     3600                   if available crsa-ot-tot then
     3601                   sale-sum       = if tPrintRubl then crsa-ot-tot.sum-rubl else crsa-ot-tot.sum-base .
     3602                   Else sale-sum  = 0.
     3603                   ov-sum =  sale-sum - ( SumWithNDS +  discnt-sum ).
     3604             Accumulate sale-sum     (TOTAL) .
     3605             Accumulate qnty         (TOTAL) .
     3606             Accumulate SumWithNDS   (TOTAL) .
     3607             Accumulate discnt-sum   (TOTAL) .
     3608             Accumulate ov-sum       (TOTAL) .
     3609             Accumulate VAT-Sum      (TOTAL) .
     3610             Accumulate SLT-sum      (TOTAL) .
     3611             Accumulate SumWithoutNDS  (TOTAL) .
     3612          End.
     3613         IF ub.ot-tot.sum-type = 'cost':U  THEN DO:
     3614             Assign
     3615             SumWithNDS-coast     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base
     3616             VAT-Sum-coast        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     3617             SLT-sum-coast        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base
     3618             SumWithoutNDS-coast  = SumWithNDS-coast - VAT-Sum-coast.
     3619             if fact-date = date('') and ub.ot-tot.ext-doc-type <> 'ot':U then do:
     3620                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     3621                 if avail ub.trn-doc then
     3622                                       Assign
     3623                                           fact-date      = ub.trn-doc.fact-date
     3624                                           doc-code       = ub.ot-tot.doc-code
     3625                                           cli-name       = ub.trn-doc.cli-name
     3626                                           .
     3627             end.
     3628             Accumulate SumWithNDS-coast          (TOTAL) .
     3629             Accumulate VAT-Sum-coast             (TOTAL) .
     3630             Accumulate SLT-sum-coast             (TOTAL) .
     3631             Accumulate SumWithoutNDS-coast       (TOTAL) .
     3632          End.
     3633        IF ub.ot-tot.sum-type BEGINS 'cost':U and ub.ot-tot.sum-type <> 'cost':U Then DO:
     3634               IF CostSum Then DO:
     3635                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     3636   create tmp#taxVAT.
     3637   assign tmp#taxVAT.type    = ot-tot.sum-type
     3638         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3639         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3640         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3641         .
     3642   i = i + 1.
     3643   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     3644                           and acc#taxVAT.type = tmp#taxVAT.type
     3645                           no-error.
     3646   if available acc#taxVAT then
     3647     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     3648     else do:
     3649         create acc#taxVAT.
     3650         assign acc#taxVAT.type    = ot-tot.sum-type
     3651                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3652                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3653                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3654             acc-i = acc-i + 1.
     3655     end.
     3656      End.
     3657                    Else DO:
     3658   create tmp#taxslt.
     3659   assign tmp#taxslt.type    = ot-tot.sum-type
     3660         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3661         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3662         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3663         .
     3664   j = j + 1.
     3665   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     3666                           and acc#taxslt.type = tmp#taxslt.type
     3667                           no-error.
     3668   if available acc#taxslt then
     3669     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     3670     else do:
     3671         create acc#taxslt.
     3672         assign acc#taxslt.type    = ot-tot.sum-type
     3673                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3674                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3675                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3676             acc-j = acc-j + 1.
     3677     end.
     3678     End.
     3679                 End.
     3680             End.
     3681        IF ub.ot-tot.sum-type BEGINS 'sale':U and ub.ot-tot.sum-type <> 'sale':U Then DO:
     3682                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     3683   create tmp#taxVAT.
     3684   assign tmp#taxVAT.type    = ot-tot.sum-type
     3685         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3686         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3687         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3688         .
     3689   i = i + 1.
     3690   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     3691                           and acc#taxVAT.type = tmp#taxVAT.type
     3692                           no-error.
     3693   if available acc#taxVAT then
     3694     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     3695     else do:
     3696         create acc#taxVAT.
     3697         assign acc#taxVAT.type    = ot-tot.sum-type
     3698                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3699                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3700                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3701             acc-i = acc-i + 1.
     3702     end.
     3703      End.
     3704                    Else DO:
     3705   create tmp#taxslt.
     3706   assign tmp#taxslt.type    = ot-tot.sum-type
     3707         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3708         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3709         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3710         .
     3711   j = j + 1.
     3712   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     3713                           and acc#taxslt.type = tmp#taxslt.type
     3714                           no-error.
     3715   if available acc#taxslt then
     3716     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     3717     else do:
     3718         create acc#taxslt.
     3719         assign acc#taxslt.type    = ot-tot.sum-type
     3720                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3721                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3722                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3723             acc-j = acc-j + 1.
     3724     end.
     3725     End.
     3726        End.
     3727         IF ub.ot-tot.sum-type BEGINS 'crsa':U and ub.ot-tot.sum-type <> 'crsa':U Then DO:
     3728                   IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     3729   create tmp#taxVAT.
     3730   assign tmp#taxVAT.type    = ot-tot.sum-type
     3731         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3732         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3733         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3734         .
     3735   i = i + 1.
     3736   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     3737                           and acc#taxVAT.type = tmp#taxVAT.type
     3738                           no-error.
     3739   if available acc#taxVAT then
     3740     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     3741     else do:
     3742         create acc#taxVAT.
     3743         assign acc#taxVAT.type    = ot-tot.sum-type
     3744                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3745                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3746                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3747             acc-i = acc-i + 1.
     3748     end.
     3749      End.
     3750                     Else DO:
     3751   create tmp#taxslt.
     3752   assign tmp#taxslt.type    = ot-tot.sum-type
     3753         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3754         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3755         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3756         .
     3757   j = j + 1.
     3758   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     3759                           and acc#taxslt.type = tmp#taxslt.type
     3760                           no-error.
     3761   if available acc#taxslt then
     3762     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     3763     else do:
     3764         create acc#taxslt.
     3765         assign acc#taxslt.type    = ot-tot.sum-type
     3766                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3767                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3768                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3769             acc-j = acc-j + 1.
     3770     end.
     3771     End.
     3772         End.
     3773             if first-of ( tdedt.id ) then  run break-h-1.
     3774             if last-of ( ub.ot-tot.doc-code ) then do:
     3775                 if (ub.ot-tot.sum-type     =  'crsa':U  and
     3776                    not (ub.ot-tot.ext-doc-type = 'vt':U ))
     3777                    then do:
     3778                       run break-ot.
     3779                       if ub.ot-tot.ext-doc-type = 'ap':U and costsum then run break-cost.
     3780                    end.
     3781                    else do:
     3782                       run break-1str.
     3783                       if available ub.trn-doc then do:
     3784                         if (absolute(ub.trn-doc.fact-qnty) - absolute(ub.trn-doc.doc-qnty) <> 0)
     3785                             and ub.ot-tot.ext-doc-type <> 'vt':U
     3786                             then run break-akt.
     3787                         end.
     3788                       if costsum then run break-cost.
     3789                       run break-2str.
     3790                       if dispupfact then run break-disp .
     3791                    end.
     3792                run erase-var.
     3793             end.
     3794             if last-of ( tdedt.id ) then do:
     3795                 qnty               = accum total       qnty                       .
     3796                 sumwithnds         = accum total       sumwithnds                 .
     3797                 discnt-sum         = accum total       discnt-sum                 .
     3798                 ov-sum             = accum total       ov-sum                     .
     3799                 vat-sum            = accum total       vat-sum                    .
     3800                 slt-sum            = accum total       slt-sum                    .
     3801                 sumwithoutnds      = accum total       sumwithoutnds              .
     3802                 sumwithnds-coast   = accum total       sumwithnds-coast           .
     3803                 vat-sum-coast      = accum total       vat-sum-coast              .
     3804                 slt-sum-coast      = accum total       slt-sum-coast              .
     3805                 sumwithoutnds-coast= accum total       sumwithoutnds-coast        .
     3806                 sale-sum-ot        = accum total       sale-sum-ot                .
     3807                 sale-sum           = (accum total       sale-sum   )  + sale-sum-ot  .
     3808   for each tmp#taxvat : delete tmp#taxvat. end.
     3809   for each acc#taxvat :
     3810     create tmp#taxvat.
     3811     assign tmp#taxvat.type   = acc#taxvat.type
     3812           tmp#taxvat.pc      = acc#taxvat.pc
     3813           tmp#taxvat.sum     = acc#taxvat.sum.
     3814   end.
     3815   i = acc-i.
     3816   for each tmp#taxslt : delete tmp#taxslt. end.
     3817   for each acc#taxslt :
     3818     create tmp#taxslt.
     3819     assign tmp#taxslt.type   = acc#taxslt.type
     3820           tmp#taxslt.pc      = acc#taxslt.pc
     3821           tmp#taxslt.sum     = acc#taxslt.sum.
     3822   end.
     3823   j = acc-j.
     3824                run break-f-1.
     3825                End.
     3826         END.
     3827   END PROCEDURE.
     3828   PROCEDURE on-same-page :
     3829     define input parameter p-line-number as integer  no-undo .
     3830     if p-line-number > page-size( OutStream ) then do:
     3831       return .
     3832     end.
     3833     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     3834       page stream OutStream .
     3835     end.
     3836   end procedure.
     3837   procedure decode-vat :
     3838   define input parameter p-vv as character no-undo .
     3839   define input parameter p-arh as character no-undo .
     3840   define input parameter p-fact-order like ub.stk-tot.fact-order no-undo .
     3841   define output parameter p-calc as integer no-undo .
     3842   define variable p-i as integer no-undo .
     3843   p-calc = 0.
     3844   If vat-slt then DO:
     3845       if p-vv = 'v':U then p-i = 1.
     3846       if p-vv = 's':U then p-i = 2.
     3847       for each b-stk-tot no-lock
     3848       where
     3849       b-stk-tot.obj-code   = x-store-code and
     3850       b-stk-tot.obj-type   = x-store-type and
     3851       b-stk-tot.fact-order = p-fact-order and
     3852       b-stk-tot.sum-type = trim(p-arh) + trim(p-vv) :
     3853           p-calc = p-calc + 1.
     3854           PUT STREAM OutStream
     3855           SPACE(32)
     3856               "в том числе со ставкой : " +
     3857               entry(p-i,b-stk-tot.cat-id)  +
     3858               " % " + String ( Round (( if tprintrubl then b-stk-tot.vat-rubl else b-stk-tot.vat-base )    , 2) )
     3859               format "x(100)"
     3860               SKIP.
     3861               run new-tmp-page .
     3862               num#str# = num#str# + 1.
     3863               num#col# = 1.
     3864               run macr_excel_char(
     3865               "в том числе со ставкой : " +
     3866               entry(p-i,b-stk-tot.cat-id)  +
     3867               " % " + String( Round(( if tprintrubl then b-stk-tot.vat-rubl else b-stk-tot.vat-base ), 2) )
     3868             , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3869       End.
     3870   End.
     3871   end procedure .
     3872   PROCEDURE Break-VAT-sub :
     3873   define input parameter par1 as char.
     3874   define variable x-pc_vat as integer no-undo .
     3875   define variable x-pc_slt as integer no-undo .
     3876   define variable x-vat-sum    as decimal format "->>,>>>,>>9.99" no-undo .
     3877   define variable x-vat    as decimal format "->>,>>>,>>9.99" no-undo .
     3878   define variable x-slt    as decimal format "->>,>>>,>>9.99" no-undo .
     3879   DEFINE buffer buff-ot-line-tax for ot-tot .
     3880   define variable vv-par as character no-undo .
     3881    vv-par =  (par1 + 'x':U).
     3882     for each buff-ot-line-tax where
     3883         buff-ot-line-tax.doc-code   = doc-code             and
     3884         buff-ot-line-tax.sum-type   = vv-par
     3885         no-lock
     3886         break  by buff-ot-line-tax.sum-type
     3887                by buff-ot-line-tax.cat-id
     3888               :
     3889         if first-of(buff-ot-line-tax.sum-type) then do:
     3890           Display stream OutStream
     3891               sym1
     3892               sym2
     3893               sym3
     3894               sym4
     3895               sym5
     3896               sym6
     3897               sym7
     3898               sym8
     3899               sym9
     3900               (if par1  begins 'crsa':U then 'В прод.ценах'  else '') @ f-qnty
     3901               sym10
     3902               "---------------" @ f-SumWithNDS
     3903               "---------------" @ f-SumWithoutNDS
     3904               "---------------" @ f-discnt-sum
     3905               "---------------" @ f-ov-sum
     3906               "---------------" @ f-sale-sum
     3907               "------"          @ F-vat_Pc
     3908               "-"               @ Sym11
     3909               "Распределение--" @ F-vat-sum
     3910               "-"               @ Sym12
     3911               "налого"          @ F-slt_Pc
     3912               "в"               @ Sym13
     3913               "---------------" @ F-slt-sum
     3914               "-"               @ Sym14
     3915               with FRAME DocsRep .
     3916               DOWN stream  OutStream 1 with FRAME DocsRep.
     3917               run new-tmp-page .
     3918               num#str# = num#str# + 1.
     3919               num#col# = 10.
     3920               run macr_excel_char("Распределение налогов"  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3921         End.
     3922         if first-of(buff-ot-line-tax.cat-id) then do:
     3923          Assign
     3924             x-pc_vat  = 0
     3925             x-pc_slt  = 0
     3926             x-vat-sum = 0
     3927             x-vat     = 0
     3928             x-slt     = 0
     3929             .
     3930         End.
     3931     Assign
     3932      x-pc_vat  = integer(entry(1,buff-ot-line-tax.cat-id ))
     3933      x-pc_slt  = integer(entry(2,buff-ot-line-tax.cat-id ))
     3934      x-vat-sum = x-vat-sum + if tPrintRubl then buff-ot-line-tax.sum-rubl else buff-ot-line-tax.sum-base
     3935      x-vat     = x-vat + if tPrintRubl then buff-ot-line-tax.vat-rubl else buff-ot-line-tax.vat-base
     3936      x-slt     = x-slt + if tPrintRubl then buff-ot-line-tax.slt-rubl else buff-ot-line-tax.slt-base
     3937      no-error
     3938      .
     3939      if error-status :error
     3940         then Assign
     3941                     x-pc_vat  = 0
     3942                     x-pc_slt  = 0
     3943                     x-vat-sum = 0
     3944                     x-vat     = 0
     3945                     x-slt     = 0
     3946                     .
     3947         if last-of (buff-ot-line-tax.cat-id) then  do :
     3948               Display stream OutStream
     3949                   sym1
     3950                   sym2
     3951                   sym3
     3952                   sym4
     3953                   "<" @ sym5
     3954                   x-VAT-sum     @ f-SumWithNDS
     3955                   ">" @ sym6
     3956                   sym7
     3957                   sym8
     3958                   sym9
     3959                   sym10
     3960                   string(integer(x-pc_vat),">9") + '%'    @ f-vat_PC
     3961                   sym11
     3962                   x-vat      @ f-VAT-Sum
     3963                   sym12
     3964                   string(integer(x-pc_slt),">9") + '%'     @ f-SLT_PC
     3965                   sym13
     3966                   x-slt      @ f-slt-sum
     3967                   sym14
     3968                   with FRAME DocsRep .
     3969                   DOWN stream  OutStream 1 with FRAME DocsRep.
     3970                   run new-tmp-page .
     3971                   num#str# = num#str# + 1.
     3972                   num#col# = 5.
     3973                   run macr_excel_char( x-VAT-sum  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3974                   num#col# = 10.
     3975                   run macr_excel_char( string(integer(x-pc_vat),">9") + '%'    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3976                   run macr_excel_char( x-vat                                   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3977                   run macr_excel_char( string(integer(x-pc_slt),">9") + '%'    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3978                   run macr_excel_char( x-slt                                   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     3979            End.
     3980     end.
     3981   END PROCEDURE.
     3982   procedure new-tmp-page :
     3983    do
     3984    on error undo, return error return-value
     3985    :
     3986       if   num#str#  >= 63000 then do:
     3987           Output stream Macr_Excel  close .
     3988           run paramls-write in this-procedure
     3989             (input "file"
     3990             ,input string(v-ind)
     3991             ,input v-file-name
     3992             ) .
     3993           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     3994           output stream  Macr_Excel to value(v-file-name) .
     3995           v-ind = v-ind + 1 .
     3996           num#str# = 0 .
     3997           run proc-print-header-my.
     3998       end.
     3999    end.
     4000   end procedure.
     4001   procedure proc-print-header-my :
     4002    do
     4003    on error undo, return error return-value
     4004    :
     4005      find first sheetf .
     4006        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     4007        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     4008        var-1 =  num#str# .
     4009        repeat c-c = 1 to sheetf.excel-row-title :
     4010        num#str# = num#str# + 1 .
     4011        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     4012        do c-i = 1 to p-var :
     4013           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     4014           str--2 = integer(entry( c-i, sheetf.sizes )) .
     4015           num#col# = c-i .
     4016           run macr_excel_char( str--1  , num#str# , num#col#  ) .
     4017           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     4018        end.
     4019       c-i = 0.
     4020       end.
     4021       run macr_cell_format (
     4022           10       ,
     4023           true     ,
     4024           false    ,
     4025           35       ,
     4026           var-1 + 1,
     4027           1        ,
     4028           num#str# ,
     4029           num#col# )
     4030           .
     4031     put  stream macr_excel unformatted
     4032          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     4033           'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     4034          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4035          .
     4036    end.
     4037   end procedure.
     4038   def var vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4039   procedure macr_excel_char :
     4040    do
     4041    on error undo, return error return-value
     4042    :
     4043    define input parameter  p-val as character no-undo .
     4044    define input parameter  p-row as integer no-undo .
     4045    define input parameter  p-col as integer no-undo .
     4046    if p-val = ? then p-val = "" .
     4047       put stream macr_excel unformatted
     4048             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4049    end.
     4050   end procedure.
     4051   procedure macr_excel_char_with_format :
     4052    do
     4053    on error undo, return error return-value
     4054    :
     4055    define input parameter  p-val as character no-undo .
     4056    define input parameter  p-row as integer no-undo .
     4057    define input parameter  p-col as integer no-undo .
     4058    if p-val = ? then p-val = "" .
     4059       put stream macr_excel unformatted
     4060             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4061       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     4062       put stream macr_excel unformatted
     4063             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4064    end.
     4065   end procedure.
     4066   procedure macr_excel_cell_format :
     4067    do
     4068    on error undo, return error return-value
     4069    :
     4070    define input parameter  p-val    as character no-undo .
     4071    define input parameter  p-row    as integer   no-undo .
     4072    define input parameter  p-col    as integer   no-undo .
     4073    define input parameter  p-format as character no-undo .
     4074    if p-val = ? then p-val = "" .
     4075       put stream macr_excel unformatted
     4076             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4077       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     4078       put stream macr_excel unformatted
     4079             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4080    end.
     4081   end procedure.
     4082   procedure macr_excel_sum :
     4083    do
     4084    on error undo, return error return-value
     4085    :
     4086    define input parameter  p-row as integer no-undo .
     4087    define input parameter  p-col as integer no-undo .
     4088    define input parameter  p-row1 as integer no-undo .
     4089    define input parameter  p-col1 as integer no-undo .
     4090    define input parameter  p-row2 as integer no-undo .
     4091    define input parameter  p-col2 as integer no-undo .
     4092       put stream macr_excel unformatted
     4093             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     4094    end.
     4095   end procedure.
     4096   procedure macr_excel_dec :
     4097    do
     4098    on error undo, return error return-value
     4099    :
     4100    define input parameter  p-val as character no-undo .
     4101    define input parameter  p-row as integer   no-undo .
     4102    define input parameter  p-col as integer   no-undo .
     4103     if p-val = ? then p-val =  "" .
     4104      put  stream macr_excel unformatted
     4105           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     4106    end.
     4107   end procedure.
     4108   procedure macr_cell_format :
     4109    do
     4110    on error undo, return error return-value
     4111    :
     4112    define input parameter  p-size   as integer   no-undo .
     4113    define input parameter  p-bold   as logical   no-undo .
     4114    define input parameter  p-italic as logical   no-undo .
     4115    define input parameter  p-color  as integer   no-undo .
     4116    define input parameter  p-row    as integer   no-undo .
     4117    define input parameter  p-col    as integer   no-undo .
     4118    define input parameter  p-row-2  as integer   no-undo .
     4119    define input parameter  p-col-2  as integer   no-undo .
     4120     if p-size = ? then p-size = 10 .
     4121     if p-bold = ? then p-bold = false .
     4122     if p-italic = ? then p-italic = false .
     4123     if p-row-2 = ? then p-row-2 = p-row .
     4124     if p-col-2 = ? then p-col-2 = p-col .
     4125     put  stream macr_excel unformatted
     4126      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     4127     if p-color <> ? then do:
     4128        put  stream macr_excel unformatted
     4129          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     4130     end.
     4131     put  stream macr_excel unformatted
     4132          substitute('format.font(,&1,&2,&3)' , p-size,
     4133                                           string ( p-bold  , "true/false" ) ,
     4134                                           string ( p-italic , "true/false" )
     4135                                           ) + chr(10) .
     4136    end.
     4137   end procedure.
     4138   procedure macr_cell_size :
     4139    do
     4140    on error undo, return error return-value
     4141    :
     4142    define input parameter  p-w   as integer   no-undo .
     4143    define input parameter  p-l   as integer   no-undo .
     4144    define input parameter  p-row    as integer   no-undo .
     4145    define input parameter  p-col    as integer   no-undo .
     4146    define input parameter  p-row-2  as integer   no-undo .
     4147    define input parameter  p-col-2  as integer   no-undo .
     4148     if p-row-2 = ? then p-row-2 = p-row .
     4149     if p-col-2 = ? then p-col-2 = p-col .
     4150     if p-w = ? then    p-w = 0 .
     4151     if p-l = ? then    p-l = 0 .
     4152    define variable s-w as character no-undo .
     4153    define variable s-l as character no-undo .
     4154    if p-w = 0 then s-w = "" .
     4155               else s-w = string(p-w)  .
     4156    if p-l = 0 then s-l = "" .
     4157               else s-l = string(p-l)  .
     4158   put  stream macr_excel unformatted
     4159        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     4160   put  stream macr_excel unformatted
     4161        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     4162   put  stream macr_excel unformatted
     4163        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     4164    end.
     4165   end procedure.
     4166   procedure proc-print-header :
     4167    do
     4168    on error undo, return error return-value
     4169    :
     4170      find first sheetf .
     4171        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     4172        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     4173        var-1 =  num#str# .
     4174        repeat c-c = 1 to sheetf.excel-row-title :
     4175        num#str# = num#str# + 1 .
     4176        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     4177        do c-i = 1 to p-var :
     4178           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     4179           str--2 = integer(entry( c-i, sheetf.sizes )) .
     4180           num#col# = c-i .
     4181           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     4182           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     4183        end.
     4184       c-i = 0.
     4185       end.
     4186       run macr_cell_format (
     4187           10       ,
     4188           true     ,
     4189           false    ,
     4190           35       ,
     4191           var-1 + 1,
     4192           1        ,
     4193           num#str# ,
     4194           num#col# )
     4195           .
     4196     put  stream macr_excel unformatted
     4197          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     4198          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4199          .
     4200    end.
     4201   end procedure.
     4202   procedure end-proc :
     4203    do
     4204    on error undo, return error return-value
     4205    :
     4206     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     4207     OUTPUT to VALUE (v-file-name) .
     4208     for each temp-param :
     4209       export  temp-param  .
     4210     end.
     4211    end.
     4212   end procedure.
