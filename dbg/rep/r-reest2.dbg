      978   then do:
      979   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      981     (input  v-cntxt-host-code-obj
      982     ,output base-code
      983     )  .
      984   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      986     (input  base-code
      987     ,input  today
      988     ,output vv-exch-rate
      989     ,output vv-exch-scale
      990     ,output base-type
      991     )  .
      992   end.
      993   run get-report-num in my-handle ( output g#report-num ).
      994   run get-gds-engl in my-handle ( output g#gds-engl ) .
      995   PROCEDURE ostatok :
      996   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      997   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      998   def input parameter x-tog-shift   as   logical             no-undo.
      999   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1000   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1001   def input parameter x-shift-start as integer               no-undo.
     1002   def input parameter x-shift-end   as integer               no-undo.
     1003   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1004   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1005   def input parameter xTog-obj   as log no-undo.
     1006   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1007   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1008   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1009   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1010   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1011   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1012   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1013   def var              Fact-orderS   as char  no-undo.
     1014   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1015      Assign
     1016         Fact-order   = 0
     1017         Quantity     = 0
     1018         Coast_R      = 0
     1019         Coast_V      = 0
     1020         VAT_R        = 0
     1021         VAT_V        = 0 .
     1022    x-date-start-t  = x-date-start + 1 .
     1023   IF x-date-end = date('') then DO:
     1024      Fact-order = 0 .
     1025      for each obj-list
     1026          where  ( not xtog-obj or
     1027                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1028                 no-lock :
     1029         if  x-tog-shift = false then do:
     1030                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1031                               ub.stk-tot.Fact-date <=  x-date-start
     1032                               and ub.stk-tot.shift-num = 0
     1033                               USE-INDEX fact-date no-lock no-error .
     1034              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1035         End.
     1036         Else  DO :
     1037             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1038              (ub.stk-tot.shift-date  = x-date-start-t and
     1039               ub.stk-tot.shift-num  < x-shift-start or
     1040               ub.stk-tot.shift-date  < x-date-start-t  )
     1041               and ub.stk-tot.shift-num  > 0
     1042               USE-INDEX Shift-num no-lock no-error .
     1043            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1044           END.
     1045       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1046     End.
     1047   End.
     1048   Else DO:
     1049     For each obj-list  WHERE
     1050        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1051         no-lock :
     1052      IF  x-TOG-Shift = False Then DO:
     1053          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1054               ub.stk-tot.Fact-date <= x-date-end
     1055               and ub.stk-tot.shift-num = 0
     1056               USE-INDEX fact-date no-lock no-error.
     1057          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1058      END.
     1059      Else DO:
     1060           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1061               (ub.stk-tot.shift-date  = x-date-end and
     1062               ub.stk-tot.shift-num  <= x-shift-end or
     1063               ub.stk-tot.shift-date  < x-date-end       ) and
     1064               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1065               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1066       End.
     1067       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1068     End.
     1069   End.
     1070   END PROCEDURE.
     1071   define temp-table temp-font no-undo
     1072     field fontnum  as integer
     1073     field fontname as character
     1074     field fontsize as character
     1075     field fonttype as character
     1076     field font-h   as integer
     1077     field font-w   as integer
     1078     field v-row    as integer
     1079     field v-col    as integer
     1080     field v-row-lans as integer
     1081     field v-col-lans as integer
     1082   index pi fontnum
     1083   .
     1084   procedure get-font-ini :
     1085     do
     1086     on error undo, return error return-value
     1087     :
     1088   define variable ii as integer   no-undo .
     1089   define variable v-font7 as character no-undo .
     1090   define variable v-font as character no-undo .
     1091   define variable loc-name as character no-undo .
     1092   define variable loc-size as character no-undo .
     1093   define variable loc-type as character no-undo .
     1094   define variable old_H as integer   no-undo .
     1095   define variable old_w as integer   no-undo .
     1096   define variable old-row  as integer   no-undo .
     1097   define variable old-col  as integer   no-undo .
     1098   define variable old-row-lans  as integer   no-undo .
     1099   define variable old-col-lans  as integer   no-undo .
     1100   define variable vv as integer   no-undo .
     1101   empty temp-table temp-font.
     1102     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1103       case num-entries (v-font7) :
     1104         when 4 then do:
     1105             assign
     1106               loc-name = entry ( 1 , v-font7 )
     1107               loc-size = entry ( 2 , v-font7 )
     1108               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1109             .
     1110         end.
     1111         when 3 then do:
     1112             assign
     1113               loc-name = entry ( 1 , v-font7 )
     1114               loc-size = entry ( 2 , v-font7 )
     1115               loc-type = entry ( 3 , v-font7 )
     1116             .
     1117         end.
     1118         when 2 then  do:
     1119             assign
     1120               loc-name = entry ( 1 , v-font7 )
     1121               loc-size = entry ( 2 , v-font7 )
     1122               loc-type = ""
     1123             .
     1124         end.
     1125         when 1 then do:
     1126             assign
     1127               loc-name = trim(entry ( 1 , v-font7 ))
     1128               loc-size = ""
     1129               loc-type = ""
     1130             .
     1131         end.
     1132       end case.
     1133     create temp-font.
     1134     assign
     1135       temp-font.fontnum  = 7
     1136       temp-font.fontname = trim(loc-name)
     1137       temp-font.fontsize = trim(loc-size)
     1138       temp-font.fonttype = trim(loc-type)
     1139       temp-font.v-row    = 62
     1140       temp-font.v-col    = 136
     1141       temp-font.v-row-lans = 43
     1142       temp-font.v-col-lans = 198
     1143     .
     1144     repeat ii = 16 to 100 :
     1145       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1146       if v-font = "" or v-font = ? then leave.
     1147       case num-entries (v-font) :
     1148         when 4 then do:
     1149             assign
     1150               loc-name = entry ( 1 , v-font )
     1151               loc-size = entry ( 2 , v-font )
     1152               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1153             .
     1154         end.
     1155         when 3 then do:
     1156             assign
     1157               loc-name = entry ( 1 , v-font )
     1158               loc-size = entry ( 2 , v-font )
     1159               loc-type = entry ( 3 , v-font )
     1160             .
     1161         end.
     1162         when 2 then do:
     1163             assign
     1164               loc-name = entry ( 1 , v-font )
     1165               loc-size = entry ( 2 , v-font )
     1166               loc-type = ""
     1167             .
     1168         end.
     1169         when 1 then do:
     1170             assign
     1171               loc-name = trim(entry ( 1 , v-font ))
     1172               loc-size = ""
     1173               loc-type = ""
     1174             .
     1175         end.
     1176       end case.
     1177     create temp-font.
     1178     assign
     1179       temp-font.fontnum  = ii
     1180       temp-font.fontname = trim(loc-name)
     1181       temp-font.fontsize = trim(loc-size)
     1182       temp-font.fonttype = trim(loc-type)
     1183     .
     1184     end.
     1185       for each temp-font :
     1186          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1187          if  vv = ? then vv =  0 .
     1188           run rep/exfont.p (
     1189             input   temp-font.fontname ,
     1190             input   vv ,
     1191             input   temp-font.fonttype ,
     1192             output  temp-font.font-h   ,
     1193             output  temp-font.font-w   )
     1194           .
     1195       end.
     1196   find first temp-font where  temp-font.fontnum  = 7  .
     1197   old_H = temp-font.font-H .
     1198   old_w = temp-font.font-W .
     1199   old-row = temp-font.v-row .
     1200   old-col = temp-font.v-col .
     1201   old-row-lans = temp-font.v-row-lans .
     1202   old-col-lans = temp-font.v-col-lans .
     1203       for each temp-font where
     1204                temp-font.fontnum  <> 7 :
     1205           assign
     1206               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1207               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1208               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1209               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1210           .
     1211       end.
     1212     end.
     1213   end procedure.
     1214   PROCEDURE How-name :
     1215   define input  parameter h as integer no-undo .
     1216   define input  parameter w as integer no-undo .
     1217   define output parameter n as character  no-undo .
     1218   define variable A4port-H as integer   no-undo init 63.
     1219   define variable A4port-W as integer   no-undo init 136.
     1220   define variable A4lans-H as integer   no-undo init 43.
     1221   define variable A4lans-W as integer   no-undo init 198.
     1222   define variable Strim-W  as integer   no-undo init 278.
     1223   run define-a4-size (
     1224        input ReportFontNum
     1225       ,output A4port-H
     1226       ,output A4port-W
     1227       ,output A4lans-H
     1228       ,output A4lans-W ).
     1229   If w >= 1 and w <= A4port-W Then DO:
     1230     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1231     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1232     If h > A4port-H              Then n = "to-file":U.
     1233   End.
     1234   If w > A4port-W and w <= A4lans-W Then DO:
     1235     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1236     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1237     If h > A4port-H              Then n = "to-file":U.
     1238   End.
     1239   If w > A4lans-W and w <= Strim-W Then DO:
     1240     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1241     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1242     If h > A4port-H              Then n = "to-file":U.
     1243   End.
     1244   If w > Strim-W Then DO:
     1245      n = "to-file":U.
     1246   End.
     1247   END PROCEDURE.
     1248   PROCEDURE define-a4-size :
     1249   define input  parameter p-ReportFontNum as integer   no-undo .
     1250   define output parameter A4port-H as integer   no-undo .
     1251   define output parameter A4port-W as integer   no-undo .
     1252   define output parameter A4lans-H as integer   no-undo .
     1253   define output parameter A4lans-W as integer   no-undo .
     1254   if not can-find (first temp-font ) then do:
     1255      run get-font-ini .
     1256   end.
     1257   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1258   if available temp-font then do:
     1259   assign
     1260     A4port-H = temp-font.v-row
     1261     A4port-W = temp-font.v-col
     1262     A4lans-H = temp-font.v-row-lans
     1263     A4lans-W = temp-font.v-col-lans
     1264   .
     1265   end.
     1266   else do:
     1267   assign
     1268     A4port-H = 63
     1269     A4port-W = 136
     1270     A4lans-H = 43
     1271     A4lans-W = 198
     1272   .
     1273   end.
     1274   END PROCEDURE.
     1275   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1276     if num-entries(string(p-dec), '.') = 2
     1277       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1278       else return( string(p-dec)) .
     1279   end function.
     1280   function format-point-to-comma returns char (input orig as char ) .
     1281   define variable rtext as character no-undo .
     1282   define variable strt as integer no-undo .
     1283   define variable leng as integer no-undo .
     1284   assign rtext = orig .
     1285   repeat:
     1286     strt =  index(rtext,'.').
     1287     if strt = 0 then leave.
     1288     leng = 1.
     1289     substring(rtext,strt,leng,"character") = v-delim .
     1290   end.
     1291   return rtext.
     1292   end function.
     1293   function format-excel-text returns char ( input start-text as char ) :
     1294   def var  i    as int no-undo.
     1295   def var  ch   as char no-undo.
     1296   def var  n    as int no-undo.
     1297   def var  ipos as int no-undo.
     1298     n = num-entries(trim(start-text), chr(10)) - 1 .
     1299     do i = 1 to n :
     1300       ipos = index( start-text, chr(10)).
     1301       if ipos > 0 then
     1302         substr( start-text, ipos, 1 ) = ' '.
     1303     end.
     1304     n = num-entries(trim(start-text), chr(13)) - 1 .
     1305     do i = 1 to n :
     1306       ipos = index( start-text, chr(13)).
     1307       if ipos > 0 then
     1308         substr( start-text, ipos, 1 ) = ' '.
     1309     end.
     1310     if index( start-text, '"' ) = 0 then
     1311       start-text =  '="'   + trim( start-text) + '"'   .
     1312       else do:
     1313         n = num-entries(trim(start-text), '"') - 1.
     1314         do i = 1 to n :
     1315           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1316         end.
     1317         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1318         start-text = '="'  + ch  + '"' .
     1319       end.
     1320     return start-text.
     1321   end.
     1322   function excel-sum returns char (input p-dec as decimal ).
     1323     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1324   end function.
     1325   function excel-qnty returns char (input p-dec as decimal ).
     1326     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1327   end function.
     1328   function format-excel-text-macr returns char ( input start-text as char ) :
     1329   def var  i    as int no-undo.
     1330   def var  ch   as char no-undo.
     1331   def var  n    as int no-undo.
     1332   def var  ipos as int no-undo.
     1333     n = num-entries(trim(start-text), chr(10)) - 1 .
     1334     do i = 1 to n :
     1335       ipos = index( start-text, chr(10)).
     1336       if ipos > 0 then
     1337         substring( start-text, ipos , 1 ) = ' '.
     1338     end.
     1339     n = num-entries(trim(start-text), chr(13)) - 1 .
     1340     do i = 1 to n :
     1341       ipos = index( start-text, chr(13)).
     1342       if ipos > 0 then
     1343         substring( start-text, ipos, 1 ) = ' '.
     1344     end.
     1345     if index( start-text, '"' ) = 0 then
     1346       start-text =  '"'   + trim( start-text) + '"'   .
     1347       else do:
     1348         n = num-entries(trim(start-text), '"') - 1.
     1349         do i = 1 to n :
     1350           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1351         end.
     1352         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1353         start-text = '"'  + ch  + '"' .
     1354       end.
     1355     n = num-entries(trim(start-text), chr(10)) - 1 .
     1356     do i = 1 to n :
     1357       ipos = index( start-text, chr(10)).
     1358       if ipos > 0 then
     1359         substring( start-text, ipos , 1 ) = ' '.
     1360     end.
     1361       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1362     return start-text.
     1363   end.
     1364   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1365   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1366   procedure paramls-clear :
     1367     define buffer buf_temp-param for temp-param .
     1368     do
     1369     on error undo, return error return-value
     1370     :
     1371       for each buf_temp-param
     1372       on error undo, return error
     1373       :
     1374         delete buf_temp-param .
     1375       end.
     1376     end.
     1377   end procedure.
     1378   procedure paramls-write :
     1379     define input  parameter p-code     as character no-undo .
     1380     define input  parameter p-sub-code as character no-undo .
     1381     define input  parameter p-value    as character no-undo .
     1382     define buffer buf_temp-param for temp-param .
     1383     do
     1384     on error undo, return error return-value
     1385     :
     1386       find first buf_temp-param
     1387         where buf_temp-param.param-code     = p-code
     1388           and buf_temp-param.param-sub-code = p-sub-code
     1389         no-error .
     1390       if not available buf_temp-param then do:
     1391         create buf_temp-param .
     1392         assign
     1393           buf_temp-param.param-code     = p-code
     1394           buf_temp-param.param-sub-code = p-sub-code
     1395         .
     1396       end.
     1397       assign
     1398         buf_temp-param.param-value = p-value
     1399       .
     1400     end.
     1401   end procedure.
     1402   procedure paramls-read :
     1403     define input  parameter p-code          as character no-undo .
     1404     define input  parameter p-sub-code      as character no-undo .
     1405     define input  parameter p-default-value as character no-undo .
     1406     define output parameter p-value         as character no-undo .
     1407     define buffer buf_temp-param for temp-param .
     1408     do
     1409     on error undo, return error return-value
     1410     :
     1411       find first buf_temp-param
     1412         where buf_temp-param.param-code     = p-code
     1413           and buf_temp-param.param-sub-code = p-sub-code
     1414         no-error .
     1415       if available buf_temp-param then do:
     1416         assign
     1417           p-value = buf_temp-param.param-value
     1418         .
     1419       end.
     1420       else do:
     1421         assign
     1422           p-value = p-default-value
     1423         .
     1424       end.
     1425     end.
     1426   end procedure.
     1427   procedure paramls-append :
     1428     define input  parameter p-code     as character no-undo .
     1429     define input  parameter p-sub-code as character no-undo .
     1430     define input  parameter p-value    as character no-undo .
     1431     define buffer buf_temp-param for temp-param .
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       find first buf_temp-param
     1436            where buf_temp-param.param-code     = p-code
     1437              and buf_temp-param.param-sub-code = p-sub-code
     1438         no-error .
     1439       if not available buf_temp-param then do:
     1440         create buf_temp-param .
     1441         assign
     1442           buf_temp-param.param-code     = p-code
     1443           buf_temp-param.param-sub-code = p-sub-code
     1444           buf_temp-param.param-value    = p-value
     1445         .
     1446       end.
     1447       else do:
     1448           assign
     1449               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1450           .
     1451       end.
     1452     end.
     1453   end procedure.
