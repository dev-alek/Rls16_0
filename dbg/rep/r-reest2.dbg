     1643   define variable v-account as integer init 0 no-undo .
     1644   define variable v-account-lavel as character no-undo .
     1645   define variable v-button-stop as logical no-undo .
     1646   define variable v-kol-spice as integer no-undo .
     1647   define variable v-kol-spice2 as integer no-undo .
     1648   define variable v-kol-spice3 as integer no-undo .
     1649   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1650   DEFINE BUTTON StopBtn AUTO-END-KEY
     1651        LABEL "Стоп"
     1652        SIZE 10 BY 1.
     1653   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1654        LABEL "Обработано записей"
     1655         VIEW-AS TEXT
     1656        SIZE 14 BY .67 NO-UNDO.
     1657   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1658         VIEW-AS TEXT
     1659        SIZE 53.25 BY .67
     1660        FGCOLOR 1  NO-UNDO.
     1661   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1662         VIEW-AS TEXT
     1663        SIZE 53.25 BY .67
     1664        FGCOLOR 1  NO-UNDO.
     1665   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1666         VIEW-AS TEXT
     1667        SIZE 53.25 BY .67
     1668        FGCOLOR 1  NO-UNDO.
     1669   DEFINE RECTANGLE RECT-1
     1670        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1671        SIZE 55.13 BY 4.46.
     1672   DEFINE FRAME InfoFrame
     1673        StopBtn AT ROW 4.25 COL 21.75
     1674        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1675        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1676        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1677        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1678        RECT-1 AT ROW 1 COL 1
     1679       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1680            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1681            TITLE "Процесс"
     1682            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1683   define variable mFrameView      as logical   no-undo init yes.
     1684     define variable mFramHandle as handle no-undo.
     1685     mFramHandle = frame InfoFrame:handle.
     1686     if  log-manager:logfile-name ne ?
     1687     then DO:
     1688         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1689         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1690         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1691     end.
     1692     mFrameView = not session:batch-mode and mFramHandle:visible.
     1693     if mFrameView
     1694     then do:
     1695       ASSIGN
     1696          FRAME InfoFrame:HIDDEN                           = TRUE
     1697          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1698     end.
     1699   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1700   DO:
     1701     IF not StopProcessing THEN
     1702       Message "Вы действительно хотите прервать" SKIP
     1703               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1704                 UPDATE StopProcessing.
     1705     IF StopProcessing THEN do:
     1706        if mFrameView
     1707        then do:
     1708           HIDE FRAME InfoFrame.
     1709        end.
     1710     End.
     1711   END.
     1712   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1713     if  log-manager:logfile-name ne ?
     1714     then DO:
     1715         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1716     end.
     1717     if not session:batch-mode then
     1718     do:
     1719       VIEW FRAME InfoFrame.
     1720       mFrameView = true.
     1721     end.
     1722      v-button-stop = false .
     1723         if mFrameView
     1724         then do:
     1725         if v-button-stop then view STOPBTN in frame InfoFrame.
     1726                          else Hide STOPBTN in frame InfoFrame.
     1727         end.
     1728          FIND first clients where clients.obj-type = x-store-type AND
     1729                                   clients.obj-code = x-store-code no-lock no-error .
     1730              If available clients then  ObjName = clients.obj-name.
     1731                                            else  ObjName = "объект не определен".
     1732        assign
     1733           i             = 0
     1734           startdate     = x-date-start
     1735           enddate       = x-date-end
     1736           PayType       = x-SET_PAY_TYPE
     1737           xTog-obj      = true
     1738           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1739           run report-execute in this-procedure .
     1740   PROCEDURE report-execute :
     1741     If (ValType=0 and x-base-code=0)  Or ValType=1
     1742                                   then   assign tPrintRubl = yes .
     1743                                   else   assign tPrintRubl = no .
     1744      curr-rep = (if tPrintRubl then "РУБ" else x-base-type ) .
     1745      NO-PRISE = true .
     1746     if var-report-r-b = "rubl"  then do:
     1747       if  x-base-code <> 0 and valtype = 2  then no-prise = false  .
     1748     end.
     1749     else do:
     1750      if  x-base-code <> 0 and valtype = 1  then no-prise = false  .
     1751     end.
     1752     run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1753     output stream macr_excel to value(v-file-name)   .
     1754     v-ind = 1    .
     1755     num#str# = 0 .
     1756   output stream OutStream to value( string( session:temp-directory +
     1757                                        "rpt" + string( g#report-num ) ) )
     1758                                        page-size  value(ReportPageHeight) .
     1759     FORM with FRAME DocsRep .
     1760   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   form header
     1762     line format "x(194)" at 1 skip
     1763     "Продолжение - на следующей странице" at 30 skip
     1764     with frame bottomframe width 232 page-bottom no-labels no-box .
     1765   view stream outstream frame bottomframe .
     1766      Line = fill("-", 194).
     1767         num#str# = num#str# + 1 .
     1768         num#col# =  1 .
     1769         run macr_excel_char_with_format( ReportNAme , num#str# , num#col#  ).
     1770         run macr_cell_format
     1771             ( 12    ,
     1772               true  ,
     1773               false ,
     1774               ?     ,
     1775               num#str# ,
     1776               num#col# ,
     1777               ? ,
     1778               ?         ) .
     1779   define variable l-ii  as integer no-undo .
     1780   define variable l-jj  as integer no-undo .
     1781   define variable l-len as integer no-undo .
     1782   define variable l-m   as integer no-undo .
     1783   do l-ii = 1 to num-entries( str1 , "chr(10)"  )    :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1784   do l-ii = 1 to num-entries( str2 , "chr(10)"  )    :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1785   do l-ii = 1 to num-entries( str3 , "chr(10)"  )    :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
