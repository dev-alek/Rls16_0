      519         .
      520   define variable vss-include-info6 as character format "X(65)" no-undo
      521   initial "@(#)$Workfile$ $Revision$".
      522   procedure grplib-get-full-name :
      523      define input parameter p-node-code  as integer      no-undo.
      524      define output parameter p-full-name as character    no-undo.
      525      do
      526   on error undo, return error
      527   :
      528       define variable v-upper-code    as integer           no-undo.
      529       define buffer buf_gds-grp       for ub.gds-grp.
      530       define buffer buf_upper_gds-grp for ub.gds-grp.
      531       find first buf_gds-grp no-lock
      532            where buf_gds-grp.node-code = p-node-code
      533       no-error.
      534       if not available buf_gds-grp
      535       then do:
      536           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      537       end.
      538       assign
      539           p-full-name  = ""
      540           v-upper-code = 1
      541       .
      542       do while buf_gds-grp.upper-code <> 0
      543       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      544       :
      545           assign
      546               p-full-name  = buf_gds-grp.node-name
      547                            + (if p-full-name <> "" then chr(47) else "")
      548                            + p-full-name
      549               v-upper-code = buf_gds-grp.upper-code
      550           .
      551           find first buf_gds-grp no-lock
      552                where buf_gds-grp.node-code = v-upper-code
      553           no-error.
      554           if not available buf_gds-grp
      555           then do:
      556               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      557                                   + string( v-upper-code )
      558                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      559           end.
      560       end.
      561       assign
      562       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      563       .
      564   end.
      565   end .
      566   procedure grplib-get-node-from-full-name :
      567   define input parameter p-full-name as character no-undo .
      568   define output parameter p-node-code as integer no-undo .
      569   define variable v-ii as integer no-undo .
      570   define variable v-upper-code as integer no-undo .
      571   define variable v-root-code as integer no-undo .
      572   define variable v-entry as character no-undo .
      573   define buffer buf_gds-grp       for ub.gds-grp.
      574   do
      575   on error undo, return error
      576   :
      577     find first buf_gds-grp no-lock
      578         where buf_gds-grp.upper-code = 0
      579     no-error .
      580     if not available buf_gds-grp
      581     then do:
      582         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      583     end.
      584     else do:
      585       assign
      586       v-root-code = buf_gds-grp.node-code
      587       .
      588     end.
      589     v-upper-code = v-root-code.
      590     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      591       assign
      592       v-entry = entry(v-ii, p-full-name, chr(47)).
      593       if v-entry = '' then leave.
      594       find first buf_gds-grp no-lock where
      595                 buf_gds-grp.node-name = v-entry
      596             and buf_gds-grp.upper-code = v-upper-code
      597             no-error.
      598       if not available buf_gds-grp then do:
      599         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      600       end.
      601       else do:
      602         p-node-code = buf_gds-grp.node-code.
      603         v-upper-code = buf_gds-grp.node-code.
      604       end.
      605     end.
      606   end.
      607   end .
      608   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   define variable v-waitfram-action01         as character   no-undo .
      610   define variable v-waitfram-action02         as character   no-undo .
      611   define variable v-waitfram-action03         as character   no-undo .
      612   define variable mWaitFramTextBeg            as character   no-undo.
      613   define variable mWaitFramTextEnd            as character   no-undo.
      614   define variable mWaitFramView               as logical     no-undo.
      615   define variable mWaitProcEvent              as logical     no-undo init yes.
      616   define variable mWaitFramInterval           as integer     no-undo init 1 .
      617   define variable mWaitFramStop               as logical     no-undo.
      618   define variable mWaitFramStopUser           as logical     no-undo.
      619   define variable mWaitFramStopTimeOut        as logical     no-undo.
      620   define variable mWaitFramStartProc          as datetime-tz no-undo.
      621   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      622   define button B-WaitFramStop auto-end-key
      623        label "Стоп"
      624        size 10 by 1 tooltip "Остоновить процесс".
      625   define button B-viewProcInfo
      626        label "Информация"
      627        size 15 by 1 tooltip "Информация о процесс".
      628   define frame waitfram
      629     v-waitfram-action01 format "x(72)" no-label skip
      630     v-waitfram-action02 format "x(72)" no-label skip
      631     v-waitfram-action03 format "x(72)" no-label skip
      632     B-viewProcInfo
      633     B-WaitFramStop at row 4 col 30
      634     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      635     .
      636   define new global shared variable mBatchMode as logical no-undo init ?.
      637   define variable mFramBachModHandle as handle no-undo.
      638   mFramBachModHandle = frame waitfram:handle.
      639   define variable mFameOldVis as logical no-undo.
      640   define variable mVisCUrentVin as logical no-undo.
      641   if session:batch-mode
      642   then
      643      mBatchMode = yes.
      644   if mBatchMode = ? then do:
      645     mVisCUrentVin = current-window:visible.
      646     mFameOldVis = mFramBachModHandle:visible.
      647     mFramBachModHandle:visible  = yes.
      648     mBatchMode = mFramBachModHandle:visible ne yes.
      649     mFramBachModHandle:visible = mFameOldVis.
      650     current-window:visible = mVisCUrentVin.
      651   end.
      652    if  log-manager:logfile-name ne ?
      653     then DO:
      654         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      655         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      656         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      657     end.
      658   on choose of B-WaitFramStop in frame waitfram
      659   do:
      660     mWaitFramStop = yes.
      661     mWaitFramStopUser = yes.
      662   end.
      663   function waitfram-check-timeout returns logical():
      664      define variable vtime as int64 no-undo.
      665      if mWaitFramStopTimeOut
      666      then
      667         return yes.
      668      vtime = ( now - mWaitFramStartProc ) / 1000 .
      669      if     mWaitFramTimeOut ne ?
      670         and mWaitFramTimeOut ne 0
      671         and mWaitFramTimeOut lt vtime
      672      then do:
      673         mWaitFramStopTimeOut = yes.
      674      end.
      675      return mWaitFramStopTimeOut.
      676   end.
      677   procedure waitfram-hide :
      678     if not session:batch-mode
      679     then do
      680     on error undo, return error return-value
      681     :
      682       pause 0 before-hide .
      683       if not mBatchMode then
      684         hide frame waitfram .
      685     if     not mWaitFramView
      686        and mWaitProcEvent
      687     then
      688       process events .
      689     end.
      690   end procedure.
      691   procedure waitfram-show :
      692     define input  parameter p-message as character no-undo .
      693     define variable v-left-margin as integer   no-undo .
      694     if not session:batch-mode
      695     then do
      696     on error undo, return error return-value
      697     :
      698       if length(p-message) <= 70 then do:
      699         assign
      700           v-left-margin = integer((70 - length(p-message)) / 2)
      701         .
      702         assign
      703           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      704         .
      705         assign
      706           v-waitfram-action01 = " "
      707           v-waitfram-action02 = " "
      708                                    + fill(" ", v-left-margin)
      709                                    + p-message
      710           v-waitfram-action03 = " "
      711         .
      712       end.
      713       else do:
      714         define variable vRindex1 as integer no-undo.
      715         define variable vRindex2 as integer no-undo.
      716         vRindex1 = r-index(p-message," ",70).
      717         if vRindex1 = 0
      718         then
      719            vRindex1 = 70.
      720         if length(p-message)  <= vRindex1 + 70 then do:
      721           assign
      722             v-waitfram-action01 = " "
      723             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      724             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      725           .
      726         end.
      727         else do:
      728           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      729           if vRindex2 <= vRindex1
      730           then
      731              vRindex2 = vRindex1 + 70.
      732           assign
      733             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      734             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      735             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      736           .
      737         end.
      738       end.
      739       B-viewProcInfo:visible   in frame waitfram = no.
      740       B-viewProcInfo:sensitive in frame waitfram = no.
      741       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      742       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      743       if  (   mWaitFramView
      744          or  mWaitProcEvent)
      745          and not mBatchMode
      746       then
      747          display
      748             v-waitfram-action01 skip
      749             v-waitfram-action02 skip
      750             v-waitfram-action03 skip
      751          with frame waitfram .
      752       if     mWaitFramView
      753          then do:
      754             if     mWaitFramInterval ne ?
      755                and not mBatchMode
      756             then
      757                wait-for go of frame waitfram pause mWaitFramInterval.
      758          end.
      759          else
      760             if     mWaitProcEvent
      761                and not mBatchMode
      762             then
      763                process events .
      764     end.
      765   end procedure.
      766      procedure waitfram-show-this:
      767         define input  parameter iInterval as int64 no-undo.
      768         define variable vtime as int64 no-undo.
      769         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      770         mWaitFramInterval = iInterval.
      771         run waitfram-show (substitute("&1&2 &3&4" ,
      772                                       mWaitFramTextBeg ,
      773                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      774                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      775                                       mWaitFramTextEnd
      776                                      )
      777                           ).
      778      end.
      779      procedure WaitFramRunPause:
      780         define input  parameter iInterval as dec no-undo.
      781         define variable vStart  as datetime-tz no-undo.
      782         define variable vend    as datetime-tz no-undo.
      783         define variable vint as int64 no-undo.
      784         define variable vOk as logical no-undo.
      785         vStart = now.
      786         vend   = vStart.
      787         publish "WaitFramPause" (iInterval,output vOk).
      788         vend   =  now.
      789         vint = vend - vStart.
      790         vint = iInterval - vint / 1000.
      791         if     not mWaitFramStop
      792            and (   vint > 0
      793                 or (    not vOk
      794                     and iInterval eq ?
      795                     )
      796                 )
      797         then
      798            run waitfram-show-this (iInterval).
      799         vend   =  now.
      800         vint = vend - vStart.
      801         vint = iInterval - vint / 1000.
      802         if     not mWaitFramStop
      803            and vint > 0
      804         then do:
      805            run gbl/pause.p (vint * 1000).
      806         end.
      807         if iInterval ne ?
      808         then
      809            publish "WaitFramStop".
      810         waitfram-check-timeout().
      811      end.
      812      procedure WaitFramWaitFor:
      813         define input  parameter iInterval as dec no-undo.
      814         assign
      815            mWaitFramStartProc   = now
      816            mWaitFramStopUser    = no
      817            mWaitFramStopTimeOut = no
      818         .
      819         block-wait:
      820         do while not mWaitFramStop:
      821            run WaitFramRunPause (iInterval).
      822            if  waitfram-check-timeout()
      823            then do:
      824               leave block-wait.
      825            end.
      826         end.
      827         run waitfram-hide.
      828      end.
      829   procedure waitfram-join :
      830     define input  parameter p-line-1  as character no-undo .
      831     define input  parameter p-line-2  as character no-undo .
      832     define input  parameter p-line-3  as character no-undo .
      833     define output parameter p-message as character no-undo .
      834     do
      835     on error undo, return error return-value
      836     :
      837       assign
      838         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      839                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      840                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      841       .
      842     end.
      843   end procedure.
      844   function waitfram-join-function returns character
      845     (input p-line-1 as character
      846     ,input p-line-2 as character
      847     ,input p-line-3 as character
      848     ).
      849     define variable v-message as character no-undo .
      850     run waitfram-join in this-procedure
      851       (input  p-line-1
      852       ,input  p-line-2
      853       ,input  p-line-3
      854       ,output v-message
      855       ) .
      856     return v-message .
      857   end function .
