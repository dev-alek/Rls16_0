      511   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   DEFINE  temp-table full-grp no-undo
      513       field grp-code like ub.gds-grp.node-code
      514       field full-name like ub.goods.grp-name
      515       field other-code as integer
