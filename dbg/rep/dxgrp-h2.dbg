      312   define  stream PrnLibStream.
      313   procedure prn-lib-prn-file :
      314     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      315     define input parameter p-DIsabledoptions as integer no-undo .
      316     define variable v-report-name as character no-undo .
      317     define variable v-user-action as character no-undo .
      318     define variable v-printed     as logical   no-undo .
      319     define variable v-exist       as logical   no-undo .
      320     do
      321       on error undo, return error
      322       :
      323       run prn-lib-get-report-name  in this-procedure (
      324         input parParentProc
      325         ,output v-report-name
      326         ).
      327   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      328   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      329     (input  v-report-name
      330     ,input  2
      331     ,output v-exist
      332     )  .
      333       if NOT v-exist then
      334       DO:
      335         Message
      336           "Нет заданий на печать ! "
      337           view-as alert-box .
      338         Return  .
      339       End.
      340       run gbl/prnfilen.w
      341         (input  ""
      342         ,input  p-DisabledOptions
      343         ,input  string(v-report-name )
      344         ,input  7
      345         ,output v-user-action
      346         ,output v-printed
      347         ) .
      348       if v-printed then
      349       do:
      350         return "YES" .
      351       end.
      352       else
      353       do:
      354         return "NO" .
      355       end.
      356     end.
      357   end procedure.
      358   procedure prn-lib-open-stream :
      359     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      360     define input parameter p-page-size    as integer no-undo .
      361     define input parameter p-is-stream    as logical no-undo .
      362     define input parameter p-append       as logical no-undo .
      363     define variable v-report-name as character no-undo .
      364     do
      365       on error undo, return error
      366       :
      367       run prn-lib-get-report-name  in this-procedure (
      368         input parParentProc
      369         ,output v-report-name
      370         ).
      371       if p-is-stream then
      372       do:
      373         if p-append then
      374         do:
      375           output stream PrnLibStream to value( v-report-name )
      376             page-size value(p-page-size) append .
      377         end.
      378         if not p-append then
      379         do:
      380           output stream PrnLibStream to value( v-report-name )
      381             page-size value(p-page-size) .
      382         end.
      383       end.
      384       if not p-is-stream then
      385       do:
      386         if p-append then
      387         do:
      388           output to value( v-report-name )
      389             page-size value(p-page-size) append .
      390         end.
      391         if not p-append then
      392         do:
      393           output to value( v-report-name )
      394             page-size value(p-page-size) .
      395         end.
      396       end.
      397     end.
      398   end procedure.
      399   procedure prn-lib-open-exp :
      400     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      401     define input parameter p-is-stream    as logical no-undo .
      402     define input parameter p-is-append    as logical no-undo .
      403     define output parameter p-ReportFileName as char init "report" no-undo.
      404     define output parameter p-process as logical no-undo .
      405     define variable glog as logical no-undo .
      406     do
      407       on error undo, return error
      408       :
      409       SYSTEM-DIALOG GET-FILE p-ReportFileName
      410         TITLE      "Укажите путь"
      411         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      412         ASK-OVERWRITE
      413         CREATE-TEST-FILE
      414         SAVE-AS
      415         USE-FILENAME
      416         DEFAULT-EXTENSION "txt"
      417         UPDATE glog
      418         .
      419       if not glog then  return.
      420       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      421       if p-is-stream then
      422       do:
      423         if p-is-append then
      424         do:
      425           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      426         end.
      427         else
      428         do:
      429           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      430         end.
      431       end.
      432       else
      433       do:
      434         if p-is-append then
      435         do:
      436           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      437         end.
      438         else
      439         do:
      440           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      441         end.
      442       end.
      443       p-process = yes.
      444     end.
      445   end procedure.
      446   procedure prn-lib-get-report-name :
      447     define input parameter parParentProc  as widget-handle no-undo.
      448     define output parameter p-report-name as character no-undo .
      449     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      450   end procedure.
      451   procedure prn-lib-reportviewer-report-name :
      452     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      453     define input parameter p-report-name-html as character no-undo .
      454     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      455   end procedure.
      456   procedure prn-lib-reportviewer :
      457     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      458     define input parameter p-report-name-html as character no-undo .
      459     define input parameter p-param        as character no-undo .
      460     define variable v-excel           as character no-undo init 'TRUE' .
      461     define variable v-value-character as character no-undo .
      462     define variable v-value-integer   as character no-undo .
      463     define variable v-value-date      as date      no-undo .
      464     define variable v-value-decimal   as decimal   no-undo .
      465     define variable rep-excel         as logical   no-undo .
      466     define variable excel-string      as character no-undo .
      467     define variable v-param-type      as character no-undo .
      468     define variable v-tth             as handle    no-undo .
      469     run adm/shattri.p (
      470       input "get":U
      471       ,input  ""
      472       ,input  0
      473       ,input  'report-glob':U
      474       ,input  'rep-excel':U
      475       ,output v-value-character
      476       ,output v-value-date
      477       ,output v-value-decimal
      478       ,output v-value-integer
      479       ,output rep-excel
      480       ,output v-param-type
      481       ,INPUT-OUTPUT table-handle v-tth
      482       )  .
      483     if rep-excel then v-excel = "TRUE" .
      484     else v-excel = "FALSE" .
      485     if p-param eq ""
      486     then
      487        p-param = "EXCEL:" + v-excel.
      488     else
      489        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      490     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      491   end procedure.
