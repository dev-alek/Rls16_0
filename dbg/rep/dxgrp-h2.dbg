      931   procedure create_obj-list :
      932      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      933      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      934      do
      935      on error undo, return error return-value
      936      :
      937         define buffer cli-obj for ub.clients .
      938         define variable p-var as integer no-undo .
      939         define buffer buf_obj-list for obj-list .
      940         find last buf_obj-list  use-index pi no-error .
      941         if available buf_obj-list
      942         then
      943            p-var = buf_obj-list.obj-id + 1.
      944         else
      945            p-var = 1.
      946         find first cli-obj where
      947                   cli-obj.obj-type = p-obj-type
      948               and cli-obj.obj-code = p-obj-code
      949         no-lock no-error.
      950         if available cli-obj
      951         then do:
      952            create buf_obj-list.
      953            assign
      954               buf_obj-list.obj-id   = p-var
      955               buf_obj-list.obj-code = cli-obj.obj-code
      956               buf_obj-list.obj-type = cli-obj.obj-type
      957               buf_obj-list.obj-name = cli-obj.obj-name
      958               buf_obj-list.db-num   = cli-obj.db-num
      959            .
      960         end.
      961      end.
      962   end.
