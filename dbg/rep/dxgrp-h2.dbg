     1379   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1380   run waitfram-show in this-procedure ("Строю дерево групп ...").
     1381   for each obj-list no-lock:
     1382     assign
     1383     accum-obj-list = accum-obj-list + 1.
     1384     if accum-obj-list > 1 then LEAVE.
     1385   end.
     1386   if rs-option = 3 then do:
     1387     create full-grp.
     1388     assign full-grp.grp-code = 0.
     1389   end.
     1390     for each ub.gds-grp no-lock:
     1391         find first for-grp where
     1392                   for-grp.upper-code = ub.gds-grp.node-code No-LOCK No-ERROR.
     1393         if not avail for-grp then do:
     1394             create full-grp.
     1395             assign full-grp.grp-code = ub.gds-grp.node-code.
     1396             run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output full-grp.full-name).
     1397             full-grp.full-name = replace(full-grp.full-name, " ", "_").
     1398         end.
     1399     end.
     1400   run waitfram-hide in this-procedure .
     1401   byobject = (if rs-option = 2 or rs-option = 3 then yes else no).
     1402   run prn-lib-open-stream  in this-procedure (
     1403                                                input parParentProc
     1404                                               ,input 62
     1405                                               ,input yes
     1406                                               ,input no
     1407                                               ).
     1408   PUT stream PrnLibStream UNFORMATTED
     1409       "Почасовая статистика розничных продаж ( по количеству ТОВАРОВ ) ЗА ПЕРИОД c " +
     1410       string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + "."      format "x(110)" SKIP(1).
     1411   define variable counter as integer no-undo .
     1412   if p-SelectGood = 4 then do:
     1413     counter = 0.
     1414     PUT STREAM PrnLibStream  "По списку товаров: " skip.
     1415     FOR EACH gds-list :
     1416         PUT STREAM PrnLibStream  unformatted
     1417         substitute("&1 &2 &3&4&5"
     1418                     , fill( chr(32), 10 )
     1419                     , gds-list.gds-code
     1420                     , gds-list.artic
     1421                     , gds-list.prod-type
     1422                     , gds-list.prod-code
     1423                     )
     1424         .
     1425         counter = counter + 1.
     1426         if counter = 3 then do:
     1427           PUT STREAM PrnLibStream  unformatted skip.
     1428           counter = 0.
     1429         end.
     1430     END.
     1431     PUT STREAM PrnLibStream  unformatted skip.
     1432   end.
     1433   if p-selectgood = 2 then do:
     1434     PUT stream PrnLibStream
     1435     space(20)  "По группам товаров: " format "x(80)" skip(0) .
     1436     for each tmp#grp:
     1437         PUT stream PrnLibStream
     1438         space(20) tmp#grp.grp-name format "x(80)" skip(0) .
     1439     end.
     1440   end.
     1441   if t-dis-card then do:
     1442     PUT stream PrnLibStream UNFORMATTED
     1443     "Только покупки по дисконтным картам" skip.
     1444     if rs-dis-card = 1 then do:
     1445       for each temp-dis-card-type No-LOCK:
     1446         PUT stream PrnLibStream UNFORMATTED
     1447         temp-dis-card-type.type
     1448         skip.
     1449       END.
     1450     end.
     1451   end.
     1452   PUT stream PrnLibStream UNFORMATTED SPACE(10) SelectObject  SKIP
     1453   by-object-str skip
     1454   .
     1455   PUT stream PrnLibStream UNFORMATTED
     1456           SKIP
     1457           cur-time-print() SKIP.
     1458   PUT stream PrnLibStream
     1459   "По_всем_группам_товаров" format "X(56)" p-XL-delim.
