     1355   define variable var-report-r-b as character no-undo .
     1356   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1358     (output var-report-r-b
     1359     )  .
     1360   DEFINE SHARED TEMP-TABLE temp-dis-card-type NO-UNDO LIKE ub.dis-card-type.
     1361   define buffer for-grp for ub.gds-grp.
     1362   define buffer b-grp-h for grp-h .
     1363   define buffer b-gds-h for gds-h .
     1364   define variable     ii      as      integer     no-undo .
     1365   define variable     kk      as      integer     no-undo .
     1366   DEFINE VARIABLE acc-gds-hour as decimal no-undo extent 24.
     1367   DEFINE VARIABLE acc-gds-qnty as decimal no-undo .
     1368   define variable cycle as integer no-undo .
     1369   define variable cycle1 as integer no-undo .
     1370   define variable accum-hour as decimal no-undo extent 24.
     1371   define variable accum-qnty as decimal no-undo .
     1372   define variable accum-obj-list as integer no-undo .
     1373   define variable v-obj-code like ub.clients.obj-code no-undo .
     1374   define variable v-obj-name like ub.clients.obj-name no-undo .
     1375   define variable obj-count as integer no-undo .
     1376   define variable byobject as logical no-undo .
     1377   define variable v-title as character no-undo .
