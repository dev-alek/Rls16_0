     1532   PUT stream PrnLibStream
     1533   "Итого_по_строке" p-XL-delim skip.
     1534   _cycle:
     1535   do cycle = 1 to 0 by -1:
     1536     if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     1537     _obj-list:
     1538     for each obj-list no-lock:
     1539       obj-count = obj-count + 1.
     1540       if not byobject and cycle = 1 then LEAVE _obj-list.
     1541       if cycle = 1 then v-obj-code = obj-list.obj-code.
     1542       if cycle = 0 then v-obj-code = 0.
     1543       if cycle = 1 then do:
     1544         FIND FIRST ub.clients NO-LOCK WHERE
     1545                   ub.clients.obj-code = v-obj-code AND
     1546                   ub.clients.obj-type = 'маг':U NO-ERROR.
     1547         if available ub.clients then do:
     1548           v-obj-name = replace(ub.clients.obj-name, chr(32), "_").
     1549         end.
     1550         else v-obj-name = string(v-obj-code).
     1551       end.
     1552       if byobject and cycle = 0 then do:
     1553         v-obj-name = "ПО_ВСЕМ_ОБЪЕКТАМ".
     1554       end.
     1555       assign
     1556       accum-hour[1]  = 0
     1557       accum-hour[2]  = 0
     1558       accum-hour[3]  = 0
     1559       accum-hour[4]  = 0
     1560       accum-hour[5]  = 0
     1561       accum-hour[6]  = 0
     1562       accum-hour[7]  = 0
     1563       accum-hour[8]  = 0
     1564       accum-hour[9]  = 0
     1565       accum-hour[10] = 0
     1566       accum-hour[11] = 0
     1567       accum-hour[12] = 0
     1568       accum-hour[13] = 0
     1569       accum-hour[14] = 0
     1570       accum-hour[15] = 0
     1571       accum-hour[16] = 0
     1572       accum-hour[17] = 0
     1573       accum-hour[18] = 0
     1574       accum-hour[19] = 0
     1575       accum-hour[20] = 0
     1576       accum-hour[21] = 0
     1577       accum-hour[22] = 0
     1578       accum-hour[23] = 0
     1579       accum-hour[24] = 0
     1580       accum-qnty     = 0
     1581       .
     1582       if rs-option <> 3 and byobject then do:
     1583         PUT stream PrnLibStream UNFORMATTED v-obj-name format "X(100)" SKIP.
     1584       end.
     1585       FOR EACH full-grp No-LOCK,
     1586           EACH grp-h NO-LOCK where
     1587               grp-h.obj-code = v-obj-code  AND
     1588               grp-h.grp-code = full-grp.grp-code
     1589       BREAK
     1590       BY full-grp.full-name
     1591       BY grp-h.grp-code:
     1592         if cycle = 0 or rs-option = 2 then do:
     1593           if first-of( grp-h.grp-code ) then do:
     1594             if not (cycle = 0 and rs-option = 3) then do:
     1595               PUT stream PrnLibStream UNFORMATTED
     1596               FULL-NAME p-XL-delim.
     1597               do cycle1 = 1 to 24.
     1598                 if use-column[cycle1 + 3] then
     1599                   PUT stream PrnLibStream UNFORMATTED
     1600                   grp-h.hour[cycle1]     p-XL-delim.
     1601               end.
     1602               PUT stream PrnLibStream UNFORMATTED
     1603               grp-h.qnty
     1604               skip.
     1605             end.
     1606             if With-Goods then do:
     1607               FOR EACH gds-h WHERE
     1608                       gds-h.grp-code = grp-h.grp-code AND
     1609                       gds-h.obj-code = v-obj-code
     1610               BREAK
     1611               BY gds-h.uniq :
     1612                 if not with-scale or gds-h.is-empty then do:
     1613                   PUT stream PrnLibStream UNFORMATTED
     1614                   string( fill( "_", 3 ) + string( gds-h.artic, "x(16)" ) +
     1615                   "_" + replace(gds-h.gds-name, " ", "_") ) p-XL-delim.
     1616                   do cycle1 = 1 to 24.
     1617                     if use-column[cycle1 + 3] then
     1618                       PUT stream PrnLibStream UNFORMATTED
     1619                       gds-h.hour[cycle1]     p-XL-delim.
     1620                   end.
     1621                   PUT stream PrnLibStream UNFORMATTED
     1622                   gds-h.qnty
     1623                   skip.
     1624                 end.
     1625                 else do:
     1626                   if first-of(gds-h.uniq) then do:
     1627                     assign
     1628                     acc-gds-hour[1] = 0
     1629                     acc-gds-hour[2] = 0
     1630                     acc-gds-hour[3] = 0
     1631                     acc-gds-hour[4] = 0
     1632                     acc-gds-hour[5] = 0
     1633                     acc-gds-hour[6] = 0
     1634                     acc-gds-hour[7] = 0
     1635                     acc-gds-hour[8] = 0
     1636                     acc-gds-hour[9] = 0
     1637                     acc-gds-hour[10] = 0
     1638                     acc-gds-hour[11] = 0
     1639                     acc-gds-hour[12] = 0
     1640                     acc-gds-hour[13] = 0
     1641                     acc-gds-hour[14] = 0
     1642                     acc-gds-hour[15] = 0
     1643                     acc-gds-hour[16] = 0
     1644                     acc-gds-hour[17] = 0
     1645                     acc-gds-hour[18] = 0
     1646                     acc-gds-hour[19] = 0
     1647                     acc-gds-hour[20] = 0
     1648                     acc-gds-hour[21] = 0
     1649                     acc-gds-hour[22] = 0
     1650                     acc-gds-hour[23] = 0
     1651                     acc-gds-hour[24] = 0
     1652                     acc-gds-qnty = 0
     1653                     .
     1654                     for each b-gds-h no-lock where
     1655                             b-gds-h.uniq = gds-h.uniq AND
     1656                             b-gds-h.obj-code = v-obj-code:
     1657                       assign
     1658                       acc-gds-hour[1]  = acc-gds-hour[1]  + b-gds-h.hour[1]
     1659                       acc-gds-hour[2]  = acc-gds-hour[2]  + b-gds-h.hour[2]
     1660                       acc-gds-hour[3]  = acc-gds-hour[3]  + b-gds-h.hour[3]
     1661                       acc-gds-hour[4]  = acc-gds-hour[4]  + b-gds-h.hour[4]
     1662                       acc-gds-hour[5]  = acc-gds-hour[5]  + b-gds-h.hour[5]
     1663                       acc-gds-hour[6]  = acc-gds-hour[6]  + b-gds-h.hour[6]
     1664                       acc-gds-hour[7]  = acc-gds-hour[7]  + b-gds-h.hour[7]
     1665                       acc-gds-hour[8]  = acc-gds-hour[8]  + b-gds-h.hour[8]
     1666                       acc-gds-hour[9]  = acc-gds-hour[9]  + b-gds-h.hour[9]
     1667                       acc-gds-hour[10] = acc-gds-hour[10] + b-gds-h.hour[10]
     1668                       acc-gds-hour[11] = acc-gds-hour[11] + b-gds-h.hour[11]
     1669                       acc-gds-hour[12] = acc-gds-hour[12] + b-gds-h.hour[12]
     1670                       acc-gds-hour[13] = acc-gds-hour[13] + b-gds-h.hour[13]
     1671                       acc-gds-hour[14] = acc-gds-hour[14] + b-gds-h.hour[14]
     1672                       acc-gds-hour[15] = acc-gds-hour[15] + b-gds-h.hour[15]
     1673                       acc-gds-hour[16] = acc-gds-hour[16] + b-gds-h.hour[16]
     1674                       acc-gds-hour[17] = acc-gds-hour[17] + b-gds-h.hour[17]
     1675                       acc-gds-hour[18] = acc-gds-hour[18] + b-gds-h.hour[18]
     1676                       acc-gds-hour[19] = acc-gds-hour[19] + b-gds-h.hour[19]
     1677                       acc-gds-hour[20] = acc-gds-hour[20] + b-gds-h.hour[20]
     1678                       acc-gds-hour[21] = acc-gds-hour[21] + b-gds-h.hour[21]
     1679                       acc-gds-hour[22] = acc-gds-hour[22] + b-gds-h.hour[22]
     1680                       acc-gds-hour[23] = acc-gds-hour[23] + b-gds-h.hour[23]
     1681                       acc-gds-hour[24] = acc-gds-hour[24] + b-gds-h.hour[24]
     1682                       acc-gds-qnty = acc-gds-qnty + b-gds-h.qnty
     1683                       .
     1684                     end.
     1685                     PUT stream PrnLibStream UNFORMATTED
     1686                           string( fill( "_", 3 ) + string( gds-h.artic, "x(16)" ) +
     1687                                       "_" + replace(gds-h.gds-name, " ", "_") )  p-XL-delim.
     1688                     do cycle1 = 1 to 24.
     1689                       if use-column[cycle1 + 3] then
     1690                         PUT stream PrnLibStream UNFORMATTED
     1691                         acc-gds-hour[cycle1]     p-XL-delim.
     1692                     end.
     1693                     PUT stream PrnLibStream UNFORMATTED
     1694                       acc-gds-qnty
     1695                       skip.
     1696                     end.
     1697                     PUT stream PrnLibStream UNFORMATTED
     1698                           string( fill( "_", 6 ) + string( gds-h.b-code) +
     1699                                       "_" + replace(gds-h.f-name, " ", "_") )  p-XL-delim.
     1700                     do cycle1 = 1 to 24.
     1701                       if use-column[cycle1 + 3] then
     1702                         PUT stream PrnLibStream UNFORMATTED
     1703                         gds-h.hour[cycle1]     p-XL-delim.
     1704                     end.
     1705                     PUT stream PrnLibStream UNFORMATTED
     1706                     gds-h.qnty
     1707                     skip.
     1708                   end.
     1709                 END .
     1710               end.
     1711             end.
     1712         end.
     1713         assign
     1714         accum-hour[1] = accum-hour[1] + grp-h.hour[1]
     1715         accum-hour[2] = accum-hour[2] + grp-h.hour[2]
     1716         accum-hour[3] = accum-hour[3] + grp-h.hour[3]
     1717         accum-hour[4] = accum-hour[4] + grp-h.hour[4]
     1718         accum-hour[5] = accum-hour[5] + grp-h.hour[5]
     1719         accum-hour[6] = accum-hour[6] + grp-h.hour[6]
     1720         accum-hour[7] = accum-hour[7] + grp-h.hour[7]
     1721         accum-hour[8] = accum-hour[8] + grp-h.hour[8]
     1722         accum-hour[9] = accum-hour[9] + grp-h.hour[9]
     1723         accum-hour[10] = accum-hour[10] + grp-h.hour[10]
     1724         accum-hour[11] = accum-hour[11] + grp-h.hour[11]
     1725         accum-hour[12] = accum-hour[12] + grp-h.hour[12]
     1726         accum-hour[13] = accum-hour[13] + grp-h.hour[13]
     1727         accum-hour[14] = accum-hour[14] + grp-h.hour[14]
     1728         accum-hour[15] = accum-hour[15] + grp-h.hour[15]
     1729         accum-hour[16] = accum-hour[16] + grp-h.hour[16]
     1730         accum-hour[17] = accum-hour[17] + grp-h.hour[17]
     1731         accum-hour[18] = accum-hour[18] + grp-h.hour[18]
     1732         accum-hour[19] = accum-hour[19] + grp-h.hour[19]
     1733         accum-hour[20] = accum-hour[20] + grp-h.hour[20]
     1734         accum-hour[21] = accum-hour[21] + grp-h.hour[21]
     1735         accum-hour[22] = accum-hour[22] + grp-h.hour[22]
     1736         accum-hour[23] = accum-hour[23] + grp-h.hour[23]
     1737         accum-hour[24] = accum-hour[24] + grp-h.hour[24]
     1738         accum-qnty = accum-qnty + grp-h.qnty
     1739         .
     1740       end.
     1741       if rs-option = 3 then do:
     1742         v-title = v-obj-name.
     1743       end.
     1744       else do:
     1745         v-title = substitute('ИТОГО_&1', v-obj-name).
     1746       end.
     1747       PUT stream PrnLibStream UNFORMATTED
     1748       v-title           p-XL-delim.
     1749       do cycle1 = 1 to 24.
     1750         if use-column[cycle1 + 3] then
     1751           PUT stream PrnLibStream UNFORMATTED
     1752           accum-hour[cycle1]     p-XL-delim.
     1753       end.
     1754       PUT stream PrnLibStream UNFORMATTED
     1755       accum-qnty           p-XL-delim
     1756       skip.
     1757       if cycle = 0 then LEAVE _obj-list.
     1758     END.
     1759   end.
     1760   output stream PrnLibStream CLOSE .
