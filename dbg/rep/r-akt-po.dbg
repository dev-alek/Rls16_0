        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id              as recid        no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: r-akt-po.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: rep/r-akt-po.p $":U .
        9   def var vss-description as character no-undo init "Печать акта и протокола переоценки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure cur-time :
       72      define output parameter p-today as date      no-undo .
       73      define output parameter p-time  as integer   no-undo .
       74     do
       75     on error undo, return error
       76     :
       77       define variable v-date1 as date      no-undo .
       78       define variable v-date2 as date      no-undo .
       79       define variable v-time  as integer   no-undo .
       80       assign
       81         v-date1 = today
       82         v-time  = time
       83         v-date2 = today
       84       .
       85       if v-date1 <> v-date2
       86       then do:
       87         assign
       88           v-date1 = today
       89           v-time  = v-time
       90         .
       91       end.
       92       assign
       93         p-today = v-date1
       94         p-time  = v-time
       95       .
       96     end.
       97   end.
       98   function cur-time-date returns character
       99   :
      100     return string(today, '99/99/9999':U) .
      101   end.
      102   function cur-time-mjd returns decimal
      103   :
      104     define variable v-date as date      no-undo .
      105     define variable v-time as integer   no-undo .
      106     run cur-time in this-procedure
      107       (output v-date
      108       ,output v-time
      109       ) .
      110     return integer(v-date) - 2400002 + (v-time / 86400) .
      111   end.
      112   function cur-time-get-ending-index returns integer
      113   (input p-number as integer
      114   )
      115   :
      116     if p-number < 0
      117     or p-number = ?
      118     then do:
      119       return 1 .
      120     end.
      121     define variable v-rest as integer   no-undo .
      122     assign
      123       p-number = p-number modulo 100
      124     .
      125     if p-number < 20
      126     then do:
      127       assign
      128         v-rest = p-number
      129       .
      130     end.
      131     else do:
      132       assign
      133         v-rest = p-number modulo 10
      134       .
      135     end.
      136     case v-rest :
      137       when 1
      138       then do:
      139         return 2 .
      140       end.
      141       when 2 or
      142       when 3 or
      143       when 4
      144       then do:
      145         return 3 .
      146       end.
      147       otherwise do:
      148         return 1 .
      149       end.
      150     end case .
      151   end.
      152   procedure cur-time-mjd-to-date :
      153      define input  parameter i-mjd-diff as decimal no-undo.
      154      define output parameter o-Date     as date    no-undo.
      155      define output parameter o-Time     as integer no-undo.
      156      define variable v-day-number as integer   no-undo .
      157      if    i-mjd-diff < 0
      158         or i-mjd-diff = ?
      159      then do:
      160         return "?" .
      161      end.
      162      assign
      163         v-day-number = truncate(i-mjd-diff,0).
      164         o-Date = date(v-day-number + 2400002).
      165         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      166     .
      167   end.
      168   function cur-time-mjd-to-string returns character
      169   (input p-mjd-diff as decimal
      170   )
      171   :
      172     define variable v-day-number as integer   no-undo .
      173     define variable v-seconds    as integer   no-undo .
      174     define variable v-hour       as integer   no-undo .
      175     define variable v-min        as integer   no-undo .
      176     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      177     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      178     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      179     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      180     if p-mjd-diff < 0
      181     or p-mjd-diff = ?
      182     then do:
      183       return "?" .
      184     end.
      185     assign
      186       v-day-number = integer(truncate(p-mjd-diff,0))
      187       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189     if v-seconds > 86400
      190     then do:
      191       assign
      192         v-seconds = 86400 - 1
      193       .
      194     end.
      195     if v-seconds < 0
      196     then do:
      197       assign
      198         v-seconds = 0
      199       .
      200     end.
      201     assign
      202       v-hour = truncate(v-seconds / 3600, 0)
      203     .
      204     assign
      205       v-seconds = v-seconds modulo 3600
      206     .
      207     assign
      208       v-min = truncate(v-seconds / 60, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 60
      212     .
      213     return
      214         (if v-day-number <> 0
      215           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0
      219           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      223           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      224           else ""
      225         )
      226       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      227       .
      228   end.
      229   function cur-time-string returns character
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      238   end.
      239   function cur-time-string-sec returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      248   end.
      249   function cur-time-custom  returns character
      250   (input p-prefix as character
      251   ,input p-date-format as character
      252   ,input p-delimiter as character
      253   ,input p-time-format as character
      254   ,input p-suffix as character
      255   )
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return
      264       p-prefix
      265       + string(v-date, p-date-format)
      266       + p-delimiter
      267       + string(v-time, p-time-format)
      268       + p-suffix
      269       .
      270   end.
      271   function cur-time-print  returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-datetime returns datetime
      282   :
      283     define variable v-char as character no-undo .
      284     define variable v-datetime as datetime no-undo .
      285     v-char = cur-time-string().
      286     v-datetime = datetime(v-char).
      287     return  v-datetime.
      288   end.
      289   function cur-time-string-msec returns character
      290   :
      291     define variable v-date as datetime  no-undo .
      292     v-date = now.
      293     return string(v-date) .
      294   end.
      295   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      297   define  shared variable RepPathName        as character no-undo .
      298   define  shared variable PrintRubl          as logical   no-undo .
      299   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      300     define variable v-cntxt-db-num        as integer   no-undo .
      301     define variable v-cntxt-userid        as character no-undo .
      302     define variable v-cntxt-level         as character no-undo .
      303     define variable v-cntxt-host-code-obj as integer   no-undo .
      304     define variable v-cntxt-obj-type      as character no-undo .
      305     define variable v-cntxt-obj-code      as integer   no-undo .
      306     define variable v-cntxt-db-num-obj    as integer   no-undo .
      307     define variable v-cntxt-is-admin      as logical   no-undo .
      308   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309     run mainmenu_getcntxt in parparentproc
      310       (output v-cntxt-db-num
      311       ,output v-cntxt-userid
      312       ,output v-cntxt-level
      313       ,output v-cntxt-host-code-obj
      314       ,output v-cntxt-obj-type
      315       ,output v-cntxt-obj-code
      316       ,output v-cntxt-db-num-obj
      317       ,output v-cntxt-is-admin
      318       ) .
      319   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      322   define variable par-type          as character no-undo.
      323   define variable v-value-character as character no-undo .
      324   define variable v-value-date      as date      no-undo .
      325   define variable v-value-decimal   as decimal   no-undo .
      326   define variable v-value-integer   as integer   no-undo .
      327   define variable v-value-logical   as logical   no-undo .
      328   do
      329   on error undo, return error
      330   :
      331     define variable g#report-num as integer   no-undo .
      332     run get-report-num  in parParentProc ( output g#report-num ).
      333     define variable g#quest-print as logical   no-undo .
      334     run get-quest-print in parParentProc ( output g#quest-print ).
      335     define variable g#log as logical   no-undo .
      336     define variable v-sort-prod         as character         no-undo.
      337     define variable v-par-type          as character         no-undo.
      338   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   empty temp-table thbjattr_thbj-attr.
      340   run adm/shattri.p (
      341      input "get":U
      342     ,input ''
      343     ,input 0
      344     ,input 'prt-glob':U
      345     ,input  ""
      346     ,output v-value-character
      347     ,output v-value-date
      348     ,output v-value-decimal
      349     ,output v-value-integer
      350     ,output v-value-logical
      351     ,output par-type
      352     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      353     ) no-error .
      354     for each thbjattr_thbj-attr :
      355         if thbjattr_thbj-attr.prop-code = 'sort-prd' then v-sort-prod = string( thbjattr_thbj-attr.property-value-logical) .
      356     end.
      357     define buffer buf_clients for clients.
      358     define buffer buf_parts   for parts .
      359     define buffer buf_trn-doc for trn-doc .
      360     define buffer buf2_trn-doc for trn-doc .
      361     define buffer buf_goods   for goods .
      362     def shared var sort-gr      as logical no-undo.
      363     def shared var sort-name    as logical no-undo.
      364     def var v-single-line       as char    no-undo.
      365     def var sym1  as char init ":"   no-undo.
      366     def var sym2  as char init ":"   no-undo.
      367     def var sym3  as char init ":"   no-undo.
      368     def var sym4  as char init ":"   no-undo.
      369     def var sym4_1  as char init ":"   no-undo.
      370     def var sym5  as char init ":"   no-undo.
      371     def var sym6  as char init ":"   no-undo.
      372     def var sym7  as char init ":"   no-undo.
      373     def var sym8  as char init ":"   no-undo.
      374     def var sym9  as char init ":"   no-undo.
      375     def var sym10 as char init ":"   no-undo.
      376     def var sym11 as char init ":"   no-undo.
      377     define variable all-qnty as decimal   no-undo .
      378     define variable all-sum1 as decimal   no-undo .
      379     define variable all-sum2 as decimal   no-undo .
      380     define variable s-isp    as character no-undo .
      381     DEFINE temp-table gds-prop no-undo
      382       field   artic            as  char
      383       field   prod-type        as  char
      384       field   prod-code        as  integer
      385       field   part-code        like parts.part-code
      386       field   in-code          like parts.in-code
      387       field   gds-code         as  integer
      388       field   gds-name         as  char
      389       field   grp-name         as  char
      390       field   b-code           as  integer
      391       field   qnty             as  decimal
      392       field   zen1             as  decimal
      393       field   sum1             as  decimal
      394       field   zen2             as  decimal
      395       field   sum2             as  decimal
      396       field   del              as  decimal
      397       field   prc              as  decimal
      398       field   number           as  character
      399       field   date-pn          as  date format "99/99/9999"
      400       field   party            as  character  format "X(25)"
      401       INDEX pi  IS PRIMARY   artic  prod-type prod-code
      402       INDEX pi1              gds-name
      403       INDEX pi2              grp-name
      404    .
      405     def var v-doc-num          like trn-doc.doc-code    no-undo.
      406     def var v-doc-date         like trn-doc.doc-date    no-undo.
      407     find first buf_trn-doc no-lock  where recid(buf_trn-doc) = rec_id .
      408     assign
      409       v-doc-num  = buf_trn-doc.doc-code
      410       v-doc-date = buf_trn-doc.doc-date
      411     .
      412     for each parts-root no-lock where parts-root.doc-code = buf_trn-doc.doc-code :
      413       create gds-prop .
      414       find first buf_goods where buf_goods.gds-code = parts-root.gds-code no-lock .
      415       find first buf_parts no-lock
      416         where buf_parts.artic     = buf_goods.artic
      417           and buf_parts.prod-code = buf_goods.prod-code
      418           and buf_parts.prod-type = buf_goods.prod-type
      419           and buf_parts.part-code = parts-root.part-code
      420           and buf_parts.in-code   = parts-root.in-code
      421           and buf_parts.out-code  = buf_trn-doc.doc-code
      422           and buf_parts.obj-code  = buf_trn-doc.obj-code
      423           and buf_parts.obj-type  = buf_trn-doc.obj-type
      424         no-error .
      425       if PrintRubl then assign gds-prop.zen2 = buf_parts.price-rubl .
      426       else              assign gds-prop.zen2 = buf_parts.price-base .
      427   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      428     (input  buf_goods.gds-code
      429     ,input  ?
      430     ,output gds-prop.b-code
      431     ) no-error .
      432       if error-status :error then do:
      433         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" buf_goods.gds-code skip
      434         view-as alert-box error .
      435       end.
      436       assign
      437         gds-prop.artic     = buf_goods.artic
      438         gds-prop.prod-type = buf_goods.prod-type
      439         gds-prop.prod-code = buf_goods.prod-code
      440         gds-prop.part-code = parts-root.part-code
      441         gds-prop.in-code   = parts-root.in-code
      442         gds-prop.gds-code  = buf_goods.gds-code
      443         gds-prop.gds-name  = buf_goods.gds-name
      444         gds-prop.qnty      = buf_parts.fact-qnty
      445         gds-prop.grp-name  = buf_goods.grp-name
      446         gds-prop.sum2      = buf_parts.fact-qnty * gds-prop.zen2
      447       .
      448       find first buf_goods where buf_goods.gds-code = parts-root.orig-gds-code no-lock .
      449       find first buf_parts no-lock
      450         where buf_parts.artic     = buf_goods.artic
      451           and buf_parts.prod-code = buf_goods.prod-code
      452           and buf_parts.prod-type = buf_goods.prod-type
      453           and buf_parts.part-code = parts-root.orig-part-code
      454           and buf_parts.in-code   = parts-root.orig-in-code
      455           and buf_parts.out-code  = buf_trn-doc.doc-code
      456           and buf_parts.obj-code  = buf_trn-doc.obj-code
      457           and buf_parts.obj-type  = buf_trn-doc.obj-type
      458         no-error .
      459        find first buf2_trn-doc no-lock
      460            where buf2_trn-doc.doc-code = buf_parts.in-code no-error.
      461         if available buf2_trn-doc then
      462                  assign
      463                  gds-prop.number    = buf2_trn-doc.doc-code
      464                  gds-prop.date-pn   = buf2_trn-doc.fact-date
      465                  gds-prop.party     = STRING(gds-prop.number) + " от " + STRING(gds-prop.date-pn)
      466                  .
      467         .
      468       if PrintRubl then assign gds-prop.zen1 = buf_parts.price-rubl .
      469       else              assign gds-prop.zen1 = buf_parts.price-base .
      470       assign
      471         gds-prop.sum1 = gds-prop.qnty * gds-prop.zen1
      472         gds-prop.del  = gds-prop.sum2 - gds-prop.sum1
      473         gds-prop.prc  = gds-prop.del * 100 / gds-prop.sum1
      474       .
      475     end.
      476     def stream out-stream .
      477     define frame f-doc1
      478           sym1              column-label ":!:"                       format "X(1)"
      479           gds-prop.b-code   column-label "Код! "                     format ">>>>>>>>>>>>9"
      480           sym2              column-label ":!:"                       format "X(1)"
      481           gds-prop.artic    column-label "Артикул! "                 format "X(16)"
      482           sym3              column-label ":!:"                       format "X(1)"
      483           gds-prop.gds-name column-label "Название товара! "         format "X(16)"
      484           sym4              column-label ":!:"                       format "X(1)"
      485           gds-prop.party    column-label "Партия! "                  format "X(25)"
      486           sym4_1            column-label ":!:"                       format "X(1)"
      487           gds-prop.qnty     column-label "Количество! "              format "->>>>>>>>9.<<"
      488           sym5              column-label ":!:"                       format "X(1)"
      489           gds-prop.zen1     column-label "Старая уч.!цена (РУБ)"     format "->>>>>>>9.99"
      490           sym6              column-label ":!:"                       format "X(1)"
      491           gds-prop.sum1     column-label "Сумма в учет.!ценах(РУБ)"     format "->>>>>>>>>>>9.99"
      492           sym7              column-label ":!:"                       format "X(1)"
      493           gds-prop.zen2     column-label "Новая уч.!цена (РУБ)"      format "->>>>>>>9.99"
      494           sym8              column-label ":!:"                       format "X(1)"
      495           gds-prop.sum2     column-label "Новая сумма в!уч. ценах(РУБ)" format "->>>>>>>>>>>9.99"
      496           sym9              column-label ":!:"                       format "X(1)"
      497           gds-prop.del      column-label "Сумма  !разницы (РУБ)"     format "->>>>>>>>9.99"
      498           sym10             column-label ":!:"                       format "X(1)"
      499           gds-prop.prc      column-label "Процент!разницы"          format "->>>>9.9%"
      500           sym11             column-label ":!:"                       format "X(1)"
      501       header
      502           cur-time-print() at 5 format "X(35)"
      503           string( "Акт переоценки " ) at 50 format "X(20)" v-doc-num format "X(10)" " от " v-doc-date format "99/99/9999"
      504           string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 120 format "X(13)" skip
      505           v-single-line format "X(190)" at 1
      506       with width 235 down stream-io use-text .
      507     define frame f-doc2
      508           sym1              column-label ":!:"                         format "X(1)"
      509           gds-prop.b-code   column-label "Код! "                       format ">>>>>>>>>>>>9"
      510           sym2              column-label ":!:"                         format "X(1)"
      511           gds-prop.artic    column-label "Артикул! "                   format "X(16)"
      512           sym3              column-label ":!:"                         format "X(1)"
      513           gds-prop.gds-name column-label "Название товара! "           format "X(16)"
      514           sym4              column-label ":!:"                         format "X(1)"
      515           gds-prop.party    column-label "Партия! "                    format "X(25)"
      516           sym4_1            column-label ":!:"                         format "X(1)"
      517           gds-prop.qnty     column-label "Количество! "                format "->>>>>>>>9.<<"
      518           sym5              column-label ":!:"                         format "X(1)"
      519           gds-prop.zen1     column-label "Старая уч.!цена (Б.Вал)"     format "->>>>>>>9.99"
      520           sym6              column-label ":!:"                         format "X(1)"
      521           gds-prop.sum1     column-label "Сумма в учет.!ценах(Б.Вал)"     format "->>>>>>>>>>>9.99"
      522           sym7              column-label ":!:"                         format "X(1)"
      523           gds-prop.zen2     column-label "Новая уч.!цена (Б.Вал)"      format "->>>>>>>9.99"
      524           sym8              column-label ":!:"                         format "X(1)"
      525           gds-prop.sum2     column-label "Новая сумма в!уч. ценах(Б.Вал)" format "->>>>>>>>>>>9.99"
      526           sym9              column-label ":!:"                         format "X(1)"
      527           gds-prop.del      column-label "Сумма раз-!ницы (Б.Вал)"     format "->>>>>>>>9.99"
      528           sym10             column-label ":!:"                         format "X(1)"
      529           gds-prop.prc      column-label "Процент!разницы"            format "->>>>9.9%"
      530           sym11             column-label ":!:"                         format "X(1)"
      531       header
      532           cur-time-print() at 5 format "X(35)"
      533           string( "Акт переоценки " ) at 50 format "X(20)" v-doc-num format "X(10)" " от " v-doc-date format "99/99/9999"
      534           string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 120 format "X(13)" skip
      535           v-single-line format "X(190)" at 1
      536       with width 235 down stream-io use-text .
      537   if session :set-wait-state( "compiler" ) then.
      538     assign   v-single-line = fill("-", 190) .
      539   output stream out-stream to value( string( session:temp-directory +
      540                                        "rpt" + string( g#report-num ) ) )
      541                                        page-size  value(43) .
      542     find first  buf_clients no-lock where buf_clients.obj-type = 'орг':U  and buf_clients.obj-code = buf_trn-doc.host-code .
      543     put stream out-stream space(50) buf_clients.obj-name format "x(70)" skip(2) .
      544     put stream out-stream space(25) string( "А К Т  переоценки учетной цены по остаткам товара поставщика "
      545        + buf_trn-doc.cli-name + " (" + buf_trn-doc.cli-type + '#' + string(buf_trn-doc.cli-code) + ")  N "
      546        + v-doc-num + " от " + string(v-doc-date,"99/99/9999") )    format "x(180)"    skip(1)
      547       .
      548     form header
      549               v-single-line format "X(190)" at 1 skip
      550               "Продолжение - на следующей странице" at 30 skip
      551               with frame Bottomframe width 235 page-bottom no-labels no-box .
      552     view stream out-stream frame bottomframe .
      553     if PrintRubl then form with frame f-doc1 .
      554     else              form with frame f-doc2 .
      555     if v-sort-prod = "yes" then do:
      556       if sort-gr then do:
      557         if sort-name then do:
      558           for each gds-prop break by gds-prop.prod-type by gds-prop.prod-code by gds-prop.grp-name by gds-prop.gds-name :
      559             if  first-of( gds-prop.prod-code) then do:
      560               run print-prod in this-procedure .
      561             end.
      562             if  first-of( gds-prop.grp-name) then do:
      563               run print-grp in this-procedure .
      564             end.
      565             run print-line in this-procedure .
      566           end.
      567         end.
      568         else do:
      569           for each gds-prop break by gds-prop.prod-type by gds-prop.prod-code by gds-prop.grp-name by gds-prop.artic :
      570             if  first-of( gds-prop.prod-code) then do:
      571               run print-prod in this-procedure .
      572             end.
      573             if  first-of( gds-prop.grp-name) then do:
      574               run print-grp in this-procedure .
      575             end.
      576             run print-line in this-procedure .
      577           end.
      578         end.
      579       end.
      580       else do:
      581         if sort-name then do:
      582           for each gds-prop break by gds-prop.prod-type by gds-prop.prod-code by gds-prop.gds-name :
      583             if  first-of( gds-prop.prod-code) then do:
      584               run print-prod in this-procedure .
      585             end.
      586             run print-line in this-procedure .
      587           end.
      588         end.
      589         else do:
      590           for each gds-prop break by gds-prop.prod-type by gds-prop.prod-code by gds-prop.artic  :
      591             if  first-of( gds-prop.prod-code) then do:
      592               run print-prod in this-procedure .
      593             end.
      594             run print-line in this-procedure .
      595           end.
      596         end.
      597       end.
      598     end.
      599     else do:
      600       if sort-gr then do:
      601         if sort-name then do:
      602           for each gds-prop break by gds-prop.grp-name by gds-prop.gds-name  :
      603             if  first-of( gds-prop.grp-name) then do:
      604               run print-grp in this-procedure .
      605             end.
      606             run print-line in this-procedure .
      607           end.
      608         end.
      609         else do:
      610           for each gds-prop break by gds-prop.grp-name by gds-prop.artic :
      611             if  first-of( gds-prop.grp-name) then do:
      612               run print-grp in this-procedure .
      613             end.
      614             run print-line in this-procedure .
      615           end.
      616         end.
      617       end.
      618       else do:
      619         if sort-name then do:
      620           for each gds-prop break by gds-prop.gds-name :
      621             run print-line in this-procedure .
      622           end.
      623         end.
      624         else do:
      625           for each gds-prop break by gds-prop.artic :
      626             run print-line in this-procedure .
      627           end.
      628         end.
      629       end.
      630     end.
      631     put stream out-stream v-single-line format "X(190)" skip .
      632     if PrintRubl then do:
      633       display stream out-stream
      634         sym1   sym2   sym3  sym4_1 "ИТОГО:" @ gds-prop.gds-name
      635         sym4   all-qnty               @ gds-prop.qnty
      636         sym5   sym6   all-sum1        @ gds-prop.sum1
      637         sym7   sym8   all-sum2        @ gds-prop.sum2
      638         sym9   (all-sum2 - all-sum1) @ gds-prop.del
      639         sym10  ((all-sum2 - all-sum1) * 100 / all-sum1) @ gds-prop.prc
      640         sym11
      641       with frame f-doc1 .
      642       down stream out-stream with frame f-doc1 .
      643     end.
      644     else do:
      645       display stream out-stream
      646         sym1   sym2   sym3  sym4_1 "ИТОГО:" @ gds-prop.gds-name
      647         sym4   all-qnty               @ gds-prop.qnty
      648         sym5   sym6   all-sum1        @ gds-prop.sum1
      649         sym7   sym8   all-sum2        @ gds-prop.sum2
      650         sym9   (all-sum2 - all-sum1) @ gds-prop.del
      651         sym10  ((all-sum2 - all-sum1) * 100 / all-sum1) @ gds-prop.prc
      652         sym11
      653       with frame f-doc2 .
      654       down stream out-stream with frame f-doc2 .
      655     end.
      656     hide stream out-stream frame Bottomframe .
      657     if line-counter( out-stream ) + 6 > page-size( out-stream ) then  page stream out-stream .
      658     find first  buf_clients no-lock where buf_clients.obj-type = 'чел':U  and buf_clients.obj-code = buf_trn-doc.agnt no-error .
      659     if available buf_clients then assign s-isp = buf_clients.obj-name .
      660     else                          assign s-isp = "" .
      661     put stream out-stream v-single-line format "X(190)" skip(2)
      662                space(10) "Подписи сторон : "    format "X(60)" skip
      663                space(10) "Зав. складом/Зав. секцией : _____________________" format "X(70)"  "От поставщика : _____________________" format "X(70)" skip(2)
      664                space(20) "Исполнитель : " s-isp   skip
      665               .
      666     output stream out-stream close.
      667   if session :set-wait-state( "" ) then.
      668   if g#quest-print = false
      669   then do:
      670     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      671                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
      672                                         OUTPUT g#log ).
      673   end.
      674   else do:
      675     os-command silent
      676       value( "COPY /b " +
      677         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      678         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      679         string( session:temp-directory) +  "$" + string( g#report-num )
      680                 ) .
      681     os-command silent
      682       value( "COPY /b " +
      683         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      684         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      685         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      686                 ) .
      687   end.
      688   end.
      689   procedure print-grp :
      690     do
      691     on error undo, return error return-value
      692     :
      693       if PrintRubl then do:
      694         display stream out-stream  sym1  gds-prop.grp-name @ gds-prop.gds-name  sym11  with frame f-doc1 .
      695         down stream out-stream with frame f-doc1 .
      696       end.
      697       else do:
      698         display stream out-stream  sym1  gds-prop.grp-name @ gds-prop.gds-name  sym11  with frame f-doc2 .
      699         down stream out-stream with frame f-doc2 .
      700       end.
      701     end.
      702   end procedure.
      703   procedure print-prod :
      704     do
      705     on error undo, return error return-value
      706     :
      707       find first buf_clients where buf_clients.obj-type = gds-prop.prod-type and buf_clients.obj-code = gds-prop.prod-code no-lock .
      708       if PrintRubl then do:
      709         display stream out-stream  sym1  buf_clients.obj-name @ gds-prop.gds-name  sym11  with frame f-doc1 .
      710         down stream out-stream with frame f-doc1 .
      711       end.
      712       else do:
      713         display stream out-stream  sym1  buf_clients.obj-name @ gds-prop.gds-name  sym11  with frame f-doc2 .
      714         down stream out-stream with frame f-doc2 .
      715       end.
      716     end.
      717   end procedure.
      718   procedure print-line :
      719     do
      720     on error undo, return error return-value
      721     :
      722       assign
      723         all-qnty = all-qnty + gds-prop.qnty
      724         all-sum1 = all-sum1 + gds-prop.sum1
      725         all-sum2 = all-sum2 + gds-prop.sum2
      726       .
      727       if PrintRubl then do:
      728         display stream out-stream
      729           sym1   gds-prop.b-code
      730           sym2   gds-prop.artic
      731           sym3   gds-prop.gds-name
      732           sym4_1 gds-prop.party
      733           sym4   gds-prop.qnty
      734           sym5   gds-prop.zen1
      735           sym6   gds-prop.sum1
      736           sym7   gds-prop.zen2
      737           sym8   gds-prop.sum2
      738           sym9   gds-prop.del
      739           sym10   gds-prop.prc
      740           sym11
      741         with frame f-doc1 .
      742         down stream out-stream with frame f-doc1 .
      743       end.
      744       else do:
      745         display stream out-stream
      746           sym1   gds-prop.b-code
      747           sym2   gds-prop.artic
      748           sym3   gds-prop.gds-name
      749           sym4_1 gds-prop.party
      750           sym4   gds-prop.qnty
      751           sym5   gds-prop.zen1
      752           sym6   gds-prop.sum1
      753           sym7   gds-prop.zen2
      754           sym8   gds-prop.sum2
      755           sym9   gds-prop.del
      756           sym10  gds-prop.prc
      757           sym11
      758         with frame f-doc2 .
      759         down stream out-stream with frame f-doc2 .
      760       end.
      761     end.
      762   end procedure.
