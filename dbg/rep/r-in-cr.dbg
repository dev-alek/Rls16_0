       25   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       26   procedure cur-time :
       27      define output parameter p-today as date      no-undo .
       28      define output parameter p-time  as integer   no-undo .
       29     do
       30     on error undo, return error
       31     :
       32       define variable v-date1 as date      no-undo .
       33       define variable v-date2 as date      no-undo .
       34       define variable v-time  as integer   no-undo .
       35       assign
       36         v-date1 = today
       37         v-time  = time
       38         v-date2 = today
       39       .
       40       if v-date1 <> v-date2
       41       then do:
       42         assign
       43           v-date1 = today
       44           v-time  = v-time
       45         .
       46       end.
       47       assign
       48         p-today = v-date1
       49         p-time  = v-time
       50       .
       51     end.
       52   end.
       53   function cur-time-date returns character
       54   :
       55     return string(today, '99/99/9999':U) .
       56   end.
       57   function cur-time-mjd returns decimal
       58   :
       59     define variable v-date as date      no-undo .
       60     define variable v-time as integer   no-undo .
       61     run cur-time in this-procedure
       62       (output v-date
       63       ,output v-time
       64       ) .
       65     return integer(v-date) - 2400002 + (v-time / 86400) .
       66   end.
       67   function cur-time-get-ending-index returns integer
       68   (input p-number as integer
       69   )
       70   :
       71     if p-number < 0
       72     or p-number = ?
       73     then do:
       74       return 1 .
       75     end.
       76     define variable v-rest as integer   no-undo .
       77     assign
       78       p-number = p-number modulo 100
       79     .
       80     if p-number < 20
       81     then do:
       82       assign
       83         v-rest = p-number
       84       .
       85     end.
       86     else do:
       87       assign
       88         v-rest = p-number modulo 10
       89       .
       90     end.
       91     case v-rest :
       92       when 1
       93       then do:
       94         return 2 .
       95       end.
       96       when 2 or
       97       when 3 or
       98       when 4
       99       then do:
      100         return 3 .
      101       end.
      102       otherwise do:
      103         return 1 .
      104       end.
      105     end case .
      106   end.
      107   procedure cur-time-mjd-to-date :
      108      define input  parameter i-mjd-diff as decimal no-undo.
      109      define output parameter o-Date     as date    no-undo.
      110      define output parameter o-Time     as integer no-undo.
      111      define variable v-day-number as integer   no-undo .
      112      if    i-mjd-diff < 0
      113         or i-mjd-diff = ?
      114      then do:
      115         return "?" .
      116      end.
      117      assign
      118         v-day-number = truncate(i-mjd-diff,0).
      119         o-Date = date(v-day-number + 2400002).
      120         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      121     .
      122   end.
      123   function cur-time-mjd-to-string returns character
      124   (input p-mjd-diff as decimal
      125   )
      126   :
      127     define variable v-day-number as integer   no-undo .
      128     define variable v-seconds    as integer   no-undo .
      129     define variable v-hour       as integer   no-undo .
      130     define variable v-min        as integer   no-undo .
      131     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      132     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      133     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      134     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      135     if p-mjd-diff < 0
      136     or p-mjd-diff = ?
      137     then do:
      138       return "?" .
      139     end.
      140     assign
      141       v-day-number = integer(truncate(p-mjd-diff,0))
      142       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      143     .
      144     if v-seconds > 86400
      145     then do:
      146       assign
      147         v-seconds = 86400 - 1
      148       .
      149     end.
      150     if v-seconds < 0
      151     then do:
      152       assign
      153         v-seconds = 0
      154       .
      155     end.
      156     assign
      157       v-hour = truncate(v-seconds / 3600, 0)
      158     .
      159     assign
      160       v-seconds = v-seconds modulo 3600
      161     .
      162     assign
      163       v-min = truncate(v-seconds / 60, 0)
      164     .
      165     assign
      166       v-seconds = v-seconds modulo 60
      167     .
      168     return
      169         (if v-day-number <> 0
      170           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      171           else ""
      172         )
      173       + (if v-day-number <> 0 or v-hour <> 0
      174           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      175           else ""
      176         )
      177       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      178           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      179           else ""
      180         )
      181       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      182       .
      183   end.
      184   function cur-time-string returns character
      185   :
      186     define variable v-date as date      no-undo .
      187     define variable v-time as integer   no-undo .
      188     run cur-time in this-procedure
      189       (output v-date
      190       ,output v-time
      191       ) .
      192     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      193   end.
      194   function cur-time-string-sec returns character
      195   :
      196     define variable v-date as date      no-undo .
      197     define variable v-time as integer   no-undo .
      198     run cur-time in this-procedure
      199       (output v-date
      200       ,output v-time
      201       ) .
      202     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      203   end.
      204   function cur-time-custom  returns character
      205   (input p-prefix as character
      206   ,input p-date-format as character
      207   ,input p-delimiter as character
      208   ,input p-time-format as character
      209   ,input p-suffix as character
      210   )
      211   :
      212     define variable v-date as date      no-undo .
      213     define variable v-time as integer   no-undo .
      214     run cur-time in this-procedure
      215       (output v-date
      216       ,output v-time
      217       ) .
      218     return
      219       p-prefix
      220       + string(v-date, p-date-format)
      221       + p-delimiter
      222       + string(v-time, p-time-format)
      223       + p-suffix
      224       .
      225   end.
      226   function cur-time-print  returns character
      227   :
      228     define variable v-date as date      no-undo .
      229     define variable v-time as integer   no-undo .
      230     run cur-time in this-procedure
      231       (output v-date
      232       ,output v-time
      233       ) .
      234     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      235   end.
      236   function cur-time-datetime returns datetime
      237   :
      238     define variable v-char as character no-undo .
      239     define variable v-datetime as datetime no-undo .
      240     v-char = cur-time-string().
      241     v-datetime = datetime(v-char).
      242     return  v-datetime.
      243   end.
      244   function cur-time-string-msec returns character
      245   :
      246     define variable v-date as datetime  no-undo .
      247     v-date = now.
      248     return string(v-date) .
      249   end.
