      323   procedure create_obj-list :
      324      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      325      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      326      do
      327      on error undo, return error return-value
      328      :
      329         define buffer cli-obj for ub.clients .
      330         define variable p-var as integer no-undo .
      331         define buffer buf_obj-list for obj-list .
      332         find last buf_obj-list  use-index pi no-error .
      333         if available buf_obj-list
      334         then
      335            p-var = buf_obj-list.obj-id + 1.
      336         else
      337            p-var = 1.
      338         find first cli-obj where
      339                   cli-obj.obj-type = p-obj-type
      340               and cli-obj.obj-code = p-obj-code
      341         no-lock no-error.
      342         if available cli-obj
      343         then do:
      344            create buf_obj-list.
      345            assign
      346               buf_obj-list.obj-id   = p-var
      347               buf_obj-list.obj-code = cli-obj.obj-code
      348               buf_obj-list.obj-type = cli-obj.obj-type
      349               buf_obj-list.obj-name = cli-obj.obj-name
      350               buf_obj-list.db-num   = cli-obj.db-num
      351            .
      352         end.
      353      end.
      354   end.
