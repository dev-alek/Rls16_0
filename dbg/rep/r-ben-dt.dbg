     3946   procedure CalculBenet :
     3947     define input parameter v-fact-order-start     as decimal no-undo .
     3948     define input parameter v-fact-order-end       as decimal no-undo .
     3949     define input parameter v-fact-order-start1    as decimal no-undo .
     3950     define input parameter v-fact-order-end1      as decimal no-undo .
     3951     define input parameter v-fact-order-start2    as decimal no-undo .
     3952     define input parameter v-fact-order-end2      as decimal no-undo .
