     4174       if use-column1[12] = yes then do:
     4175         find last buf_stk-line no-lock
     4176           where buf_stk-line.obj-type  = buf_obj-list.obj-type
     4177             and buf_stk-line.obj-code  = buf_obj-list.obj-code
     4178             and buf_stk-line.artic     = buf_goods.artic
