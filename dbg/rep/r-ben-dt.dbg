     1771   FUNCTION excel-sum2 RETURNS char (INPUT p-dec as decimal ).
     1772      RETURN(String(Round(p-dec,2))) .
     1773   END FUNCTION.
     1774   FUNCTION excel-qnty2 RETURNS char (INPUT p-dec as decimal ).
     1775      RETURN(String(Round(p-dec,3))) .
