      582   define new global shared variable g#library  as handle no-undo .
      583   define new global shared variable g#library2 as handle no-undo .
      584   define variable var-report-r-b as character no-undo .
      585   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      587     (output var-report-r-b
      588     )  .
      589   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   procedure factord :
      591     define input  parameter p-fact-date            as date    no-undo .
      592     define input  parameter p-fact-time            as integer no-undo .
      593     define input  parameter p-fact-num             as integer no-undo .
      594     define input  parameter p-shift-date           as date    no-undo .
      595     define input  parameter p-shift-num            as integer no-undo .
      596     define input  parameter p-shift-on             as logical no-undo .
      597     define output parameter p-fact-order           as decimal no-undo .
      598     define output parameter p-shift-end-fact-order as decimal no-undo .
      599     define output parameter p-day-end-fact-order   as decimal no-undo .
      600     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      601     if p-fact-date = ?
      602     then do:
      603       return error "Не указана фактическая дата" .
      604     end.
      605     define variable v-fact-date-num as integer no-undo .
      606     assign
      607       v-fact-date-num = integer(p-fact-date)
      608     .
      609     if p-fact-num = ?
      610     or p-fact-num = 0
      611     then do:
      612       return error "Не задан p-fact-num " + string(p-fact-num) .
      613     end.
      614     if p-fact-num < 0
      615     then do:
      616       return error "Отрицательный fact-num " + string(p-fact-num) .
      617     end.
      618     if p-fact-num >= 100000000
      619     then do:
      620       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      621     end.
      622     if p-shift-on = true
      623     then do:
      624       if p-shift-date = ?
      625       then do:
      626         return error "Не задана дата смены" .
      627       end.
      628       if p-shift-num = ?
      629       or p-shift-num = 0
      630       then do:
      631         return error "Не задан номер смены" .
      632       end.
      633     end.
      634     else do:
      635       assign
      636         p-shift-date = p-fact-date
      637         p-shift-num  = 24
      638       .
      639     end.
      640     define variable v-shift-offset as integer no-undo .
      641     if p-shift-date = p-fact-date
      642     then do:
      643       assign
      644         v-shift-offset = 1
      645       .
      646     end.
      647     if p-shift-date < p-fact-date
      648     then do:
      649       assign
      650         v-shift-offset = 0
      651       .
      652     end.
      653     if p-shift-date > p-fact-date
      654     then do:
      655       message
      656         vss-workfile vss-revision vss-description skip
      657         "Неправильная дата закрытия смены" skip
      658         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      659         view-as alert-box error .
      660       undo, return error
      661         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      662           ,string(p-fact-date, '99/99/9999':U)
      663           ,string(p-shift-date, '99/99/9999':U)
      664           )
      665       .
      666     end.
      667     if p-shift-num < 1
      668     or p-shift-num > 24
      669     then do:
      670       message
      671         vss-workfile vss-revision vss-description skip
      672         "Неправильный номер смены" skip
      673         "p-shift-num" p-shift-num skip
      674         view-as alert-box error .
      675       undo, return error return-value .
      676     end.
      677     assign
      678       p-fact-order           = v-fact-date-num
      679                              + v-shift-offset * 0.5
      680                              + p-shift-num    * 0.02 - 0.01
      681                              + p-fact-num     * 0.0000000001
      682       p-shift-end-fact-order = v-fact-date-num
      683                              + v-shift-offset * 0.5
      684                              + p-shift-num    * 0.02
      685       p-day-end-fact-order   = v-fact-date-num
      686                              + 0.99
      687     .
      688     if p-fact-order           <= v-fact-date-num
      689     or p-shift-end-fact-order <= v-fact-date-num
      690     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      691     or p-shift-end-fact-order >= p-day-end-fact-order
      692     then do:
      693       message
      694         vss-workfile vss-revision vss-description skip
      695         "Внутренняя ошибка при генерации фактического номера" skip
      696         "p-fact-date"            p-fact-date            skip
      697         "p-fact-time"            p-fact-time            skip
      698         "p-fact-num"             p-fact-num             skip
      699         "p-shift-date"           p-shift-date           skip
      700         "p-shift-num"            p-shift-num            skip
      701         "p-shift-on"             p-shift-on             skip
      702         "p-shift-end-fact-order" p-shift-end-fact-order skip
      703         "p-day-end-fact-order"   p-day-end-fact-order   skip
      704         "v-fact-date-num"        v-fact-date-num        skip
      705         view-as alert-box error .
      706       undo, return error return-value .
      707     end.
      708   end procedure.
      709   procedure day-begin-fact-order :
      710     define input  parameter p-fact-date            as date    no-undo .
      711     define output parameter p-day-begin-fact-order as decimal no-undo .
      712     do
      713     on error undo, return error return-value
      714     :
      715       if p-fact-date = ?
      716       then do:
      717         assign
      718           p-day-begin-fact-order = 0
      719         .
      720       end.
      721       else do:
      722         assign
      723           p-day-begin-fact-order = integer(p-fact-date)
      724         .
      725       end.
      726     end.
      727   end procedure.
      728   procedure factord-max-fact-order :
      729     define output parameter p-max-fact-order as decimal   no-undo .
      730     do
      731     on error undo, return error return-value
      732     :
      733       run day-begin-fact-order in this-procedure
      734         (input  date(1, 1, 5000)
      735         ,output p-max-fact-order
      736         ) .
      737     end.
      738   end procedure.
      739   procedure factord-cut-archive :
      740     define input  parameter p-obj-type             as character no-undo .
      741     define input  parameter p-obj-code             as integer   no-undo .
      742     define input  parameter p-fact-date            as date      no-undo .
      743     define output parameter p-shift-on             as logical   no-undo .
      744     define output parameter p-shift-date           as date      no-undo .
      745     define output parameter p-shift-num            as integer   no-undo .
      746     define output parameter p-day-end-fact-order   as decimal   no-undo .
      747     define output parameter p-shift-end-fact-order as decimal   no-undo .
      748     define variable v-fact-order as decimal   no-undo .
      749     define buffer buf_shift-obj for ub.shift-obj .
      750     do
      751     on error undo, return error return-value
      752     :
      753   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      755     (input  p-obj-type
      756     ,input  p-obj-code
      757     ,input  'shift-on=request'
      758     ,output p-shift-on
      759     ) no-error .
      760       if error-status :error
      761       then do:
      762         message
      763           vss-workfile vss-revision vss-description skip
      764           "Ошибка при определении атрибута объекта" skip
      765           "Объект" p-obj-type p-obj-code skip
      766           error-status :get-message(1) skip
      767           return-value skip
      768           view-as alert-box error .
      769         undo, return error return-value .
      770       end.
      771       if p-shift-on = false
      772       then do:
      773         assign
      774           p-shift-date               = ?
      775           p-shift-num                = 0
      776         .
      777       end.
      778       else do:
      779         find first buf_shift-obj share-lock
      780           where buf_shift-obj.obj-type   = p-obj-type
      781             and buf_shift-obj.obj-code   = p-obj-code
      782             and buf_shift-obj.shift-date > p-fact-date
      783           use-index pi
      784           no-error .
      785         if not available buf_shift-obj
      786         or buf_shift-obj.status_ <> 'зкр':U
      787         then do:
      788           message
      789             vss-workfile vss-revision vss-description skip
      790             "Невозможно вычислить последнюю смену" skip
      791             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      792             "Объект" p-obj-type p-obj-code skip
      793             "Дата" p-fact-date skip
      794             view-as alert-box error .
      795           undo, return error return-value .
      796         end.
      797         find last buf_shift-obj share-lock
      798           where buf_shift-obj.obj-type = p-obj-type
      799             and buf_shift-obj.obj-code = p-obj-code
      800             and buf_shift-obj.shift-date <= p-fact-date
      801           use-index pi
      802           no-error .
      803         if available buf_shift-obj
      804         then do:
      805           if  buf_shift-obj.status_ = 'зкр':U
      806           then do:
      807             assign
      808               p-shift-date = buf_shift-obj.shift-date
      809               p-shift-num  = buf_shift-obj.shift-num
      810             .
      811           end.
      812           else do:
      813             message
      814               vss-workfile vss-revision vss-description skip
      815               "Невозможно вычислить последнюю смену" skip
      816               "Статус смены отличен от статуса" 'зкр':U skip
      817               "Объект" p-obj-type p-obj-code skip
      818               "Дата" p-fact-date skip
      819               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      820               view-as alert-box error .
      821             undo, return error return-value .
      822           end.
      823         end.
      824         else do:
      825           assign
      826             p-shift-date = p-fact-date - 1
      827             p-shift-num  = 1
      828           .
      829         end.
      830       end.
      831       run factord in this-procedure
      832         (input  p-fact-date
      833         ,input  1
      834         ,input  1
      835         ,input  p-shift-date
      836         ,input  p-shift-num
      837         ,input  p-shift-on
      838         ,output v-fact-order
      839         ,output p-shift-end-fact-order
      840         ,output p-day-end-fact-order
      841         ) no-error .
      842       if error-status :error
      843       then do:
      844         message
      845           vss-workfile vss-revision vss-description skip
      846           "Ошибка при вызове процедуры factord"
      847           error-status :get-message(1) skip
      848           return-value skip
      849           view-as alert-box error .
      850         undo, return error return-value .
      851       end.
      852     end.
      853   end procedure.
      854   procedure factord-lock-shift :
      855     define input  parameter p-obj-type  as character no-undo .
      856     define input  parameter p-obj-code  as integer   no-undo .
      857     define input  parameter p-fact-date as date      no-undo .
      858     define parameter buffer buf_shift-obj for ub.shift-obj .
      859     define variable v-shift-on      as logical   no-undo .
      860     define variable v-extra-message as character no-undo .
      861     define variable v-error as character no-undo .
      862     do
      863     on error undo, return error return-value
      864     :
      865   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      867     (input  p-obj-type
      868     ,input  p-obj-code
      869     ,input  'shift-on=request'
      870     ,output v-shift-on
      871     ) no-error .
      872       if error-status :error
      873       then do:
      874         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      875         undo, return error v-error .
      876       end.
      877       if v-shift-on = true
      878       then do:
      879         find first buf_shift-obj share-lock
      880           where buf_shift-obj.obj-type   = p-obj-type
      881             and buf_shift-obj.obj-code   = p-obj-code
      882             and buf_shift-obj.shift-date > p-fact-date
      883           use-index pi
      884           no-error .
      885         if not available buf_shift-obj
      886         or buf_shift-obj.status_ <> 'зкр':U
      887         then do:
      888           find last buf_shift-obj
      889             where buf_shift-obj.obj-type = p-obj-type
      890               and buf_shift-obj.obj-code = p-obj-code
      891               and buf_shift-obj.status_  = 'зкр':U
      892             use-index stts
      893             no-error .
      894           if available buf_shift-obj
      895           then do:
      896             assign
      897               v-extra-message =
      898                     substitute("Дата начала последеней закрытой смены на объекте &1"
      899                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      900                               )
      901             .
      902           end.
      903           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      904           undo, return error v-error .
      905         end.
      906       end.
      907     end.
      908   end procedure.
      909   procedure factord-end-day :
      910     define input  parameter p-fact-date            as date    no-undo .
      911     define output parameter p-day-end-fact-order   as decimal no-undo .
      912     do
      913     on error undo, return error return-value
      914     :
      915       if p-fact-date = ?
      916       then do:
      917         return error "Не указана фактическая дата" .
      918       end.
      919       assign
      920         p-day-end-fact-order = integer(p-fact-date) + 0.99
      921       .
      922     end.
      923   end procedure.
      924   procedure factord-to-date :
      925     define input  parameter p-fact-order as decimal no-undo .
      926     define output parameter p-fact-date  as date    no-undo .
      927     define variable v-ref-date  as date      no-undo .
      928     define variable v-ref-delta as integer   no-undo .
      929     do
      930     on error undo, return error return-value
      931     :
      932       if p-fact-order = ?
      933       or p-fact-order = 0
      934       then do:
      935         return error "Не указан fact-order" .
      936       end.
      937       assign
      938         v-ref-date  = date(1, 1, 2000)
      939       .
      940       assign
      941         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      942       .
      943       assign
      944         p-fact-date = v-ref-date + v-ref-delta
      945       .
      946     end.
      947   end procedure.
      948   procedure factord-to-fact-num :
      949     define input  parameter p-fact-order as decimal no-undo .
      950     define output parameter p-fact-num   as integer no-undo .
      951     define variable v-fact-order-trunc as decimal no-undo .
      952     do
      953     on error undo, return error return-value
      954     :
      955       if p-fact-order = ?
      956       or p-fact-order = 0
      957       then do:
      958         return error "Не указан fact-order" .
      959       end.
      960       assign
      961        v-fact-order-trunc = truncate(p-fact-order, 2)
      962       .
      963       assign
      964         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      965       .
      966     end.
      967   end procedure.
      968   procedure factord-to-shift-num :
      969     define input  parameter p-fact-order as decimal no-undo .
      970     define output parameter p-shift-num   as integer no-undo .
      971     define variable  p-shift-numd  as decimal   no-undo .
      972     define variable v-fact-order-trunc as decimal no-undo .
      973     do
      974     on error undo, return error return-value
      975     :
      976       if p-fact-order = ?
      977       or p-fact-order = 0
      978       then do:
      979         return error "Не указан fact-order" .
      980       end.
      981       assign
      982        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      983       .
      984       if v-fact-order-trunc < 0.5 then do:
      985         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      986       end.
      987       assign
      988         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      989         .
      990        assign
      991         p-shift-num = truncate (p-shift-numd , 0)
      992       .
      993     end.
      994   end procedure.
      995   define variable vss-include-info10 as character format "X(65)" no-undo
      996   initial "@(#)$Workfile$ $Revision$".
      997   define temp-table temp_grplib_grp no-undo
      998       field sel           as character
      999       field nabor         as character
     1000       field full-name     as character
     1001       field print-code    as character
     1002       field sort-name     as character
     1003       field node-code     as integer
     1004       field upper-code    as integer
     1005       field calc-method   as character
     1006       field round-method  as character
     1007       field increase-pc   as decimal
     1008       field min-marg      as character
     1009       field max-marg      as character
     1010       field cli-type      as character
     1011       field cli-code      as integer
     1012       field notcorr      as character
     1013       field name          as character
     1014       field level         as integer
     1015       field mark          as character
     1016       index pi is primary unique sort-name
     1017       index fn full-name
     1018       index nc is unique node-code
     1019       index sl sel
     1020       index uc upper-code
     1021   .
     1022   define temp-table temp_grplib_found-grp no-undo
     1023       field full-name   as character
     1024       field sort-name   as character
     1025       field node-code   as integer
     1026       field level       as integer
     1027       field is-terminal as logical
     1028       index pi is primary unique sort-name
     1029       index fn full-name
     1030       index lv level
     1031       index it is-terminal
     1032   .
     1033   define temp-table temp_found-result-nodelist no-undo
     1034       field node-code     as recid
     1035       field processed     as logical
     1036       field sort-name     as character
     1037       field full-name     as character
     1038       index pi is primary unique node-code
     1039       index ps processed
     1040   .
     1041   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1042   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1043   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1044   procedure grplib-get-parameters :
     1045   define input parameter p-store-type     as character        no-undo.
     1046   define input parameter p-store-code     as integer          no-undo.
     1047   do
     1048   on error undo, return error
     1049   :
     1050       assign
     1051           v-grplib-not-fill-extra-info = no
     1052       .
     1053   end.
     1054   end procedure.
     1055   procedure grplib-get-sort-name :
     1056   do
     1057   on error undo, return error
     1058   :
     1059   define input parameter p-node-code  as integer      no-undo.
     1060   define output parameter p-sort-name as character    no-undo.
     1061       define variable v-upper-code    as integer           no-undo.
     1062       define buffer buf_gds-grp       for ub.gds-grp.
     1063       define buffer buf_upper_gds-grp for ub.gds-grp.
     1064       find first buf_gds-grp no-lock
     1065            where buf_gds-grp.node-code = p-node-code
     1066       no-error.
     1067       if not available buf_gds-grp
     1068       then do:
     1069           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1070       end.
     1071       assign
     1072           p-sort-name  = ""
     1073           v-upper-code = 1
     1074       .
     1075       do while buf_gds-grp.upper-code <> 0
     1076       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1077       :
     1078           assign
     1079               p-sort-name  = buf_gds-grp.node-name
     1080                            + (if p-sort-name <> "" then chr(2) else "")
     1081                            + p-sort-name
     1082               v-upper-code = buf_gds-grp.upper-code
     1083           .
     1084           find first buf_gds-grp no-lock
     1085                where buf_gds-grp.node-code = v-upper-code
     1086           no-error.
     1087           if not available buf_gds-grp
     1088           then do:
     1089               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1090                                   + string( v-upper-code )
     1091                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1092           end.
     1093       end.
     1094   end.
     1095   end procedure.
     1096   define variable vss-include-info11 as character format "X(65)" no-undo
     1097   initial "@(#)$Workfile$ $Revision$".
     1098   procedure grplib-get-full-name :
     1099      define input parameter p-node-code  as integer      no-undo.
     1100      define output parameter p-full-name as character    no-undo.
     1101      do
     1102   on error undo, return error
     1103   :
     1104       define variable v-upper-code    as integer           no-undo.
     1105       define buffer buf_gds-grp       for ub.gds-grp.
     1106       define buffer buf_upper_gds-grp for ub.gds-grp.
     1107       find first buf_gds-grp no-lock
     1108            where buf_gds-grp.node-code = p-node-code
     1109       no-error.
     1110       if not available buf_gds-grp
     1111       then do:
     1112           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1113       end.
     1114       assign
     1115           p-full-name  = ""
     1116           v-upper-code = 1
     1117       .
     1118       do while buf_gds-grp.upper-code <> 0
     1119       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1120       :
     1121           assign
     1122               p-full-name  = buf_gds-grp.node-name
     1123                            + (if p-full-name <> "" then chr(47) else "")
     1124                            + p-full-name
     1125               v-upper-code = buf_gds-grp.upper-code
     1126           .
     1127           find first buf_gds-grp no-lock
     1128                where buf_gds-grp.node-code = v-upper-code
     1129           no-error.
     1130           if not available buf_gds-grp
     1131           then do:
     1132               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1133                                   + string( v-upper-code )
     1134                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1135           end.
     1136       end.
     1137       assign
     1138       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1139       .
     1140   end.
     1141   end .
     1142   procedure grplib-get-node-from-full-name :
     1143   define input parameter p-full-name as character no-undo .
     1144   define output parameter p-node-code as integer no-undo .
     1145   define variable v-ii as integer no-undo .
     1146   define variable v-upper-code as integer no-undo .
     1147   define variable v-root-code as integer no-undo .
     1148   define variable v-entry as character no-undo .
     1149   define buffer buf_gds-grp       for ub.gds-grp.
     1150   do
     1151   on error undo, return error
     1152   :
     1153     find first buf_gds-grp no-lock
     1154         where buf_gds-grp.upper-code = 0
     1155     no-error .
     1156     if not available buf_gds-grp
     1157     then do:
     1158         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1159     end.
     1160     else do:
     1161       assign
     1162       v-root-code = buf_gds-grp.node-code
     1163       .
     1164     end.
     1165     v-upper-code = v-root-code.
     1166     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1167       assign
     1168       v-entry = entry(v-ii, p-full-name, chr(47)).
     1169       if v-entry = '' then leave.
     1170       find first buf_gds-grp no-lock where
     1171                 buf_gds-grp.node-name = v-entry
     1172             and buf_gds-grp.upper-code = v-upper-code
     1173             no-error.
     1174       if not available buf_gds-grp then do:
     1175         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1176       end.
     1177       else do:
     1178         p-node-code = buf_gds-grp.node-code.
     1179         v-upper-code = buf_gds-grp.node-code.
     1180       end.
     1181     end.
     1182   end.
     1183   end .
     1184   procedure grplib-get-root-code :
     1185   do
     1186   on error undo, return error
     1187   :
     1188   define output parameter p-root-code as integer      no-undo.
     1189       define buffer buf_gds-grp       for ub.gds-grp.
     1190       find first buf_gds-grp no-lock
     1191           where buf_gds-grp.upper-code = 0
     1192       no-error .
     1193       if not available buf_gds-grp
     1194       then do:
     1195           undo, return error .
     1196       end.
     1197       else do:
     1198           assign
     1199               p-root-code = buf_gds-grp.node-code
     1200           .
     1201       end.
     1202   end.
     1203   end procedure.
     1204   procedure grplib-find-grp-by-full-name :
     1205   do
     1206   on error undo, return error
     1207   :
     1208   define input parameter p-search-name  as character    no-undo.
     1209   define input parameter p-fill-path    as logical      no-undo.
     1210   define output parameter p-found       as logical      no-undo.
     1211       define variable v-upper-code    as integer          no-undo.
     1212       define variable v-counter       as integer           no-undo.
     1213       define variable v-level         as integer           no-undo.
     1214       define variable v-full-name     as character         no-undo.
     1215       define variable v-sort-name     as character         no-undo.
     1216       define buffer buf_gds-grp       for ub.gds-grp.
     1217       assign
     1218           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1219       .
     1220       run grplib-get-root-code ( output v-upper-code ) no-error .
     1221       if error-status :error
     1222       then do:
     1223           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1224       end.
     1225       assign
     1226           v-full-name  = ""
     1227           v-level      = num-entries( p-search-name, chr(2) )
     1228       .
     1229       for each temp_grplib_found-grp
     1230       :
     1231           delete temp_grplib_found-grp.
     1232       end.
     1233       start-name-analyze:
     1234       do v-counter = 1 to v-level
     1235       :
     1236           if v-counter < v-level
     1237           then do:
     1238               find first buf_gds-grp no-lock
     1239                    where buf_gds-grp.upper-code = v-upper-code
     1240                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1241               no-error .
     1242               if not available buf_gds-grp
     1243               then do:
     1244                   assign
     1245                       v-full-name  = p-search-name
     1246                       v-sort-name  = p-search-name
     1247                   .
     1248                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1249               end.
     1250               else do:
     1251                   assign
     1252                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1253                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1254                       v-upper-code = buf_gds-grp.node-code
     1255                   .
     1256                   if p-fill-path = yes
     1257                   then do:
     1258                       create temp_grplib_found-grp.
     1259                       assign
     1260                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1261                           temp_grplib_found-grp.sort-name = v-sort-name
     1262                           temp_grplib_found-grp.node-code = v-upper-code
     1263                           temp_grplib_found-grp.level     = v-counter
     1264                       .
     1265                   end.
     1266               end.
     1267           end.
     1268           else do:
     1269               for each buf_gds-grp no-lock
     1270                  where buf_gds-grp.upper-code = v-upper-code
     1271                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1272               :
     1273                   assign
     1274                       p-found = yes
     1275                   .
     1276                   create temp_grplib_found-grp.
     1277                   assign
     1278                       temp_grplib_found-grp.full-name = v-full-name
     1279                                                           + (if v-full-name = "" then "" else chr(47) )
     1280                                                           + buf_gds-grp.node-name + chr(47)
     1281                       temp_grplib_found-grp.sort-name = v-sort-name
     1282                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1283                                                           + buf_gds-grp.node-name
     1284                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1285                       temp_grplib_found-grp.level     = v-level
     1286                   .
     1287               end.
     1288               if p-found = no
     1289               then do:
     1290                   assign
     1291                       v-full-name  = p-search-name
     1292                       v-sort-name  = p-search-name
     1293                   .
     1294                   for each temp_grplib_found-grp
     1295                   :
     1296                       delete temp_grplib_found-grp.
     1297                   end.
     1298                   assign
     1299                       p-found = no
     1300                   .
     1301               end.
     1302           end.
     1303       end.
     1304   end.
     1305   end procedure.
     1306   procedure grplib-find-all-subgroup :
     1307   do
     1308   on error undo, return error
     1309   :
     1310   define input parameter p-start-node-code    as integer      no-undo.
     1311   define input parameter p-terminal-only      as logical      no-undo.
     1312       define variable v-start-full-name   as character     no-undo.
     1313       define variable v-start-sort-name   as character     no-undo.
     1314       define variable v-not-found         as logical       no-undo.
     1315       define variable v-is-terminal       as logical       no-undo.
     1316       define buffer buf_gds-grp           for ub.gds-grp.
     1317       create temp_found-result-nodelist.
     1318       assign
     1319           temp_found-result-nodelist.node-code = p-start-node-code
     1320           temp_found-result-nodelist.processed = no
     1321       .
     1322       run grplib-get-full-name in this-procedure (
     1323             input p-start-node-code
     1324           , output v-start-full-name
     1325       ).
     1326       run grplib-get-full-name in this-procedure (
     1327             input p-start-node-code
     1328           , output v-start-sort-name
     1329       ).
     1330       process-nodes:
     1331       do while yes
     1332       :
     1333           find first temp_found-result-nodelist
     1334                where temp_found-result-nodelist.node-code = p-start-node-code
     1335           .
     1336           assign
     1337               temp_found-result-nodelist.processed = yes
     1338           .
     1339           for each buf_gds-grp no-lock
     1340              where buf_gds-grp.upper-code = p-start-node-code
     1341           on error undo, return error
     1342           :
     1343               run grplib-is-terminal in this-procedure (
     1344                     input buf_gds-grp.node-code
     1345                   , output v-is-terminal
     1346               ).
     1347               if v-is-terminal = yes
     1348               then do:
     1349                   create temp_grplib_found-grp.
     1350                   assign
     1351                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1352                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1353                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1354                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1355                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1356                       temp_grplib_found-grp.is-terminal = yes
     1357                   .
     1358               end.
     1359               else do:
     1360                   create temp_found-result-nodelist.
     1361                   assign
     1362                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1363                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1364                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1365                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1366                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1367                       temp_found-result-nodelist.processed = no
     1368                   .
     1369                   if p-terminal-only = no
     1370                   then do:
     1371                       create temp_grplib_found-grp.
     1372                       assign
     1373                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1374                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1375                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1376                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1377                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1378                           temp_grplib_found-grp.is-terminal = no
     1379                       .
     1380                   end.
     1381               end.
     1382           end.
     1383           find first temp_found-result-nodelist
     1384                where temp_found-result-nodelist.processed = no
     1385           no-error.
     1386           if not available temp_found-result-nodelist
     1387           then do:
     1388               leave process-nodes.
     1389           end.
     1390           else do:
     1391               assign
     1392                   p-start-node-code = temp_found-result-nodelist.node-code
     1393                   v-start-full-name = temp_found-result-nodelist.full-name
     1394                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1395               .
     1396           end.
     1397       end.
     1398   end.
     1399   end procedure.
     1400   procedure grplib-expand-name :
     1401   define input parameter p-start-name as character        no-undo.
     1402   define output parameter p-end-name  as character        no-undo.
     1403       define variable v-is-terminal   as logical      no-undo.
     1404       define variable v-found         as character    no-undo.
     1405       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1406   do
     1407   for buf_temp_grplib_found-grp
     1408   on error undo, return error
     1409   :
     1410       run grplib-find-grp-by-full-name in this-procedure (
     1411             input p-start-name
     1412           , input no
     1413           , output v-found
     1414       ) no-error.
     1415       run grplib-get-max-substring in this-procedure (
     1416                   input length( p-start-name )
     1417                 , output p-end-name
     1418       ) no-error .
     1419       if error-status :error
     1420       then do:
     1421           assign
     1422               p-end-name = ""
     1423           .
     1424       end.
     1425       else do:
     1426           find first temp_grplib_found-grp
     1427               where temp_grplib_found-grp.full-name = p-end-name
     1428           no-error.
     1429           if available temp_grplib_found-grp
     1430           then do:
     1431               find first buf_temp_grplib_found-grp
     1432                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1433                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1434               no-error.
     1435               if not available buf_temp_grplib_found-grp
     1436               then do:
     1437                   run grplib-is-terminal in this-procedure (
     1438                       input temp_grplib_found-grp.node-code
     1439                       , output v-is-terminal
     1440                   ).
     1441               end.
     1442           end.
     1443       end.
     1444   end.
     1445   end procedure.
     1446   procedure grplib-get-max-substring :
     1447   do
     1448   on error undo, return error
     1449   :
     1450   define input parameter p-min-substring-length   as integer      no-undo.
     1451   define output parameter p-substring             as character    no-undo.
     1452           define variable v-char-counter  as integer           no-undo.
     1453           define variable v-current-char  as character         no-undo.
     1454           define variable v-names-counter  as integer           no-undo.
     1455           define variable v-base-string   as character         no-undo.
     1456           assign
     1457               v-char-counter  = p-min-substring-length
     1458           .
     1459           find first temp_grplib_found-grp no-error.
     1460           if not available temp_grplib_found-grp
     1461           then do:
     1462               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1463           end.
     1464           else do:
     1465               assign
     1466                   v-base-string  = temp_grplib_found-grp.full-name
     1467                   v-char-counter = 0
     1468               .
     1469               counter-block:
     1470               do while yes
     1471               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1472               :
     1473                   assign
     1474                       v-char-counter  = v-char-counter + 1
     1475                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1476                       v-names-counter = 0
     1477                   .
     1478                   compare-block:
     1479                   for each temp_grplib_found-grp
     1480                   :
     1481                       assign
     1482                           v-names-counter = v-names-counter + 1
     1483                       .
     1484                       if v-names-counter = 1
     1485                       then do:
     1486                           next compare-block.
     1487                       end.
     1488                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1489                       then do:
     1490                           leave counter-block.
     1491                       end.
     1492                   end.
     1493                   if v-names-counter = 1
     1494                   then do:
     1495                       assign
     1496                           p-substring = v-base-string
     1497                       .
     1498                       return.
     1499                   end.
     1500               end.
     1501               assign
     1502                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1503               .
     1504           end.
     1505   end.
     1506   end procedure.
     1507   procedure grplib-is-terminal :
     1508   do
     1509   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1510   :
     1511   define input parameter p-node-code      as integer      no-undo.
     1512   define output parameter p-is-terminal   as logical      no-undo.
     1513       define buffer buf_gds-grp       for ub.gds-grp.
     1514       find first buf_gds-grp no-lock
     1515           where buf_gds-grp.upper-code = p-node-code
     1516       no-error .
     1517       if not available buf_gds-grp
     1518       then do:
     1519           assign
     1520               p-is-terminal = yes
     1521           .
     1522       end.
     1523       else do:
     1524           assign
     1525               p-is-terminal = no
     1526           .
     1527       end.
     1528   end.
     1529   end procedure.
     1530   procedure grplib-have-goods :
     1531   do
     1532   on error undo, return error
     1533   :
     1534   define input parameter p-node-code      as integer      no-undo.
     1535   define output parameter p-have-goods   as logical      no-undo.
     1536       define buffer buf_goods         for ub.goods.
     1537       find first buf_goods no-lock
     1538            where buf_goods.grp-code = p-node-code
     1539       no-error .
     1540       if available buf_goods
     1541       then do:
     1542           assign
     1543               p-have-goods = yes
     1544           .
     1545       end.
     1546       else do:
     1547           assign
     1548               p-have-goods = no
     1549           .
     1550       end.
     1551   end.
     1552   end procedure.
     1553   procedure grplib-find-by-substring :
     1554   do
     1555   on error undo, return error
     1556   :
     1557   define input parameter p-start-code         as integer      no-undo.
     1558   define input parameter p-full-search-string as character    no-undo.
     1559   define output parameter p-found-code        as integer      no-undo.
     1560   define output parameter p-full-name         as character    no-undo.
     1561       define variable v-start-code     as integer           no-undo.
     1562       define variable v-found          as logical  init no  no-undo.
     1563       define buffer buf_gds-grp       for ub.gds-grp.
     1564       search-grp:
     1565       for each buf_gds-grp no-lock
     1566           where buf_gds-grp.node-code > p-start-code
     1567       :
     1568           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1569           then do:
     1570               assign
     1571                   p-found-code = buf_gds-grp.node-code
     1572                   v-found      = yes
     1573               .
     1574               run grplib-get-full-name in this-procedure (
     1575                     input p-found-code
     1576                   , output p-full-name
     1577               ) no-error .
     1578               if error-status :error
     1579               then do:
     1580                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1581               end.
     1582               leave search-grp.
     1583           end.
     1584       end.
     1585       if v-found = yes
     1586       then do:
     1587       end.
     1588       else do:
     1589           assign
     1590               p-full-name  = ""
     1591               p-found-code = 0
     1592           .
     1593       end.
     1594   end.
     1595   end procedure.
     1596   procedure grplib-analyze-grp-name :
     1597   do
     1598   on error undo, return error
     1599   :
     1600   define input parameter p-grp-name       as character            no-undo.
     1601   define input parameter p-upper-code     as integer              no-undo.
     1602   define output parameter p-error-message as character init ""    no-undo.
     1603       define variable v-char-list     as character    no-undo.
     1604       define variable v-char-counter  as integer      no-undo.
     1605       define variable v-full-name     as character    no-undo.
     1606       if p-grp-name = "" then do:
     1607           assign
     1608               p-error-message = "Название группы не может быть пустым.".
     1609           .
     1610       end.
     1611       else do:
     1612           assign
     1613               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1614           .
     1615           do v-char-counter = 1 to num-entries( v-char-list )
     1616           :
     1617               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1618               then do:
     1619                   assign
     1620                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1621                   .
     1622                   return.
     1623               end.
     1624           end.
     1625           if p-upper-code > 0
     1626           then do:
     1627               run grplib-get-full-name in this-procedure (
     1628                     input p-upper-code
     1629                   , output v-full-name
     1630               ) no-error .
     1631               if error-status :error
     1632               then do:
     1633                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1634               end.
     1635               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1636               then do:
     1637                   assign
     1638                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1639                   .
     1640               end.
     1641           end.
     1642       end.
     1643   end.
     1644   end procedure.
     1645   procedure grplib-get-lvl-num :
     1646   define input parameter p-node-code  as integer      no-undo.
     1647   define output parameter p-lvl-num   as integer      no-undo.
     1648       define variable v-full-name    as character    no-undo.
     1649   do
     1650   on error undo, return error
     1651   :
     1652       run grplib-get-full-name in this-procedure (
     1653             input p-node-code
     1654           , output v-full-name
     1655       ).
     1656       assign
     1657           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1658       .
     1659       if p-lvl-num = -1
     1660       then do:
     1661           assign
     1662               p-lvl-num = 0
     1663           .
     1664       end.
     1665   end.
     1666   end procedure.
     1667   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1668   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
