     4586   procedure PrintLine :
     4587     do
     4588     on error undo, return error return-value
     4589     :
     4590     end.
     4591     assign igr = 0 .
     4592   define variable vss-include-info34 as character format "X(65)" no-undo
     4593   initial "@(#)$Workfile$ $Revision$".
     4594     if Itog = no then do:
     4595       if Make-Excel then  put   stream ForExcel unformatted string(NumLine)                           CHR(9)
     4596                   format-excel-text( temp-BenetTov.artic )  CHR(9)
     4597                   temp-BenetTov.gds-name                    CHR(9)
     4598       .
     4599       assign   NumLine = NumLine + 1 .
     4600       if use-column1[1] = yes then if Make-Excel then  put   stream ForExcel unformatted   excel-sum2( temp-BenetTov.sum-prov )    CHR(9) .
     4601       if use-column1[2] = yes then if Make-Excel then  put   stream ForExcel unformatted   excel-sum2( temp-BenetTov.sum-beg )     CHR(9) .
     4602       if use-column1[3] = yes then if Make-Excel then  put   stream ForExcel unformatted   excel-sum2( temp-BenetTov.sum-end )     CHR(9) .
     4603     end.
     4604     if use-column1[4] = yes then do:
     4605       for each temp-date
     4606         where temp-date.type = 1
     4607       :
     4608         for each temp-SumObj :
     4609           assign
     4610             temp-SumObj.val = 0
     4611             temp-SumObj.sum = 0
     4612           .
     4613         end.
     4614         for each temp-value
     4615           where temp-value.artic     = temp-BenetTov.artic
     4616             and temp-value.prod-type = temp-BenetTov.prod-type
     4617             and temp-value.prod-code = temp-BenetTov.prod-code
     4618             and temp-value.type      = 1
     4619             and temp-value.data      = temp-date.data
     4620           :
     4621           find first temp-SumObj
     4622             where temp-SumObj.obj-type = temp-value.obj-type
     4623               and temp-SumObj.obj-code = temp-value.obj-code
     4624             .
     4625           assign
     4626             temp-SumObj.val = temp-SumObj.val + temp-value.qnty
     4627             temp-SumObj.sum = temp-SumObj.sum + temp-value.sum
     4628           .
     4629         end.
     4630         assign
     4631           val-all = 0
     4632           sum-all = 0
     4633         .
     4634         for each temp-SumObj :
     4635           assign
     4636             val-all = val-all + temp-SumObj.val
     4637             sum-all = sum-all + temp-SumObj.sum
     4638           .
     4639         end.
     4640         run SumGroup in this-procedure (val-all,sum-all) .
     4641         if Itog = no then if Make-Excel then  put   stream ForExcel unformatted  excel-qnty2(val-all)  CHR(9)  excel-sum2(sum-all)  CHR(9) .
     4642         for each obj-list :
     4643           find first temp-SumObj
     4644             where temp-SumObj.obj-type = obj-list.obj-type
     4645               and temp-SumObj.obj-code = obj-list.obj-code
