      158   procedure create_obj-list :
      159      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      160      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      161      do
      162      on error undo, return error return-value
      163      :
      164         define buffer cli-obj for ub.clients .
      165         define variable p-var as integer no-undo .
      166         define buffer buf_obj-list for obj-list .
      167         find last buf_obj-list  use-index pi no-error .
      168         if available buf_obj-list
      169         then
      170            p-var = buf_obj-list.obj-id + 1.
      171         else
      172            p-var = 1.
      173         find first cli-obj where
      174                   cli-obj.obj-type = p-obj-type
      175               and cli-obj.obj-code = p-obj-code
      176         no-lock no-error.
      177         if available cli-obj
      178         then do:
      179            create buf_obj-list.
      180            assign
      181               buf_obj-list.obj-id   = p-var
      182               buf_obj-list.obj-code = cli-obj.obj-code
      183               buf_obj-list.obj-type = cli-obj.obj-type
      184               buf_obj-list.obj-name = cli-obj.obj-name
      185               buf_obj-list.db-num   = cli-obj.db-num
      186            .
      187         end.
      188      end.
      189   end.
