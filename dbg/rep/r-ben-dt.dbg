     4208           temp-value.prod-code = buf_gds-obj.prod-code
     4209           temp-value.artic     = buf_gds-obj.artic
     4210         .
     4211         find last buf_stk-line no-lock
     4212           where buf_stk-line.obj-type  = buf_obj-list.obj-type
     4213             and buf_stk-line.obj-code  = buf_obj-list.obj-code
