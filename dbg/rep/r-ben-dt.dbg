     4115           end.
     4116         end.
     4117       end.
     4118     end.
     4119     find first temp-value no-lock
     4120       where temp-value.prod-type    = buf_gds-obj.prod-type
     4121         and temp-value.prod-code    = buf_gds-obj.prod-code
     4122         and temp-value.artic        = buf_gds-obj.artic
     4123       no-error .
     4124     if not available temp-value then do:
     4125       delete temp-BenetTov .
     4126       next .
     4127     end.
     4128     for each buf_obj-list :
     4129       for each buf_doc-line no-lock
     4130         where buf_doc-line.obj-type     = buf_obj-list.obj-type
