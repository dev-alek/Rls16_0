     4181             and buf_stk-line.sum-type  = 'crsa':U
     4182             and buf_stk-line.cat-id    = '##,##'
     4183             and buf_stk-line.fact-order < v-fact-order-end
     4184           use-index category no-error .
     4185         if available buf_stk-line then do:
     4186           create temp-value .
