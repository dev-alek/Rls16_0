     1846     define variable  v-fact-order-start     as decimal   no-undo .
     1847     define variable  v-fact-order-end       as decimal   no-undo .
     1848     define variable  v-fact-order-start1    as decimal   no-undo .
     1849     define variable  v-fact-order-end1      as decimal   no-undo .
     1850     define variable  v-fact-order-start2    as decimal   no-undo .
     1851     define variable  v-fact-order-end2      as decimal   no-undo .
     1852     define variable  Counter1 as integer   no-undo .
     1853     define variable  CurrGrpName as character no-undo .
     1854     define variable  tmp-fact-order  as decimal   no-undo .
     1855     define variable  tmp-date-start  as date      no-undo .
     1856     define variable  tmp-fact-order1 as decimal   no-undo .
     1857     define variable  tmp-date-end    as date      no-undo .
     1858     define variable  v-base-rate     as decimal   no-undo .
     1859     define variable  v-base-scale    as decimal   no-undo .
     1860     define variable  v-base-rate-z   as decimal   no-undo .
     1861     define variable  v-base-scale-z  as decimal   no-undo .
     1862     define variable  b-code          as integer   no-undo .
     1863     define variable  ii as integer no-undo .
     1864     define variable  NumObj    as integer initial 1  no-undo .
     1865     define variable  NumColumn as integer initial 0  no-undo .
     1866     define variable  NumPrice  as integer initial 0  no-undo .
     1867     define variable  NumLine   as integer initial 1  no-undo .
     1868     define variable  Num-Week   as integer initial 0  no-undo .
     1869     define variable  val-all as decimal   no-undo .
     1870     define variable  sum-all as decimal   no-undo .
     1871     define variable  ind as integer   no-undo .
     1872     define variable  igr as integer   no-undo .
     1873     define variable  is-zapr as logical   no-undo .
     1874     define variable  TitleStr1 as character no-undo .
     1875     define variable  TitleStr2 as character no-undo .
     1876     define variable  TitleStr3 as character no-undo .
     1877     define variable  TitleStr4 as character no-undo .
     1878     define variable  TitleH1 as character no-undo .
     1879     define variable  TitleH2 as character no-undo .
     1880     define variable  TitleH3 as character no-undo .
     1881     define variable  TypeValCli as integer   no-undo .
     1882     define variable  use-column1  as logical extent 20 no-undo .
     1883     define variable  NumZakaz  as integer   no-undo .
     1884     define variable  NumPrihod as integer   no-undo .
     1885     define variable  b2 as logical initial no  no-undo .
     1886     define variable  NameDate as character no-undo .
     1887     run day-begin-fact-order in this-procedure ( input x-date-start,         output v-fact-order-start ).
     1888     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),   output v-fact-order-end ).
     1889     run day-begin-fact-order in this-procedure ( input x-date-start1,        output v-fact-order-start1 ).
     1890     run day-begin-fact-order in this-procedure ( input ( x-date-end1 + 1 ),  output v-fact-order-end1 ).
     1891     run day-begin-fact-order in this-procedure ( input x-date-start2,        output v-fact-order-start2 ).
     1892     run day-begin-fact-order in this-procedure ( input ( x-date-end2 + 1 ),  output v-fact-order-end2 ).
     1893     DO ii = 1 TO 20 :
     1894       assign use-column1 [ii] = no .
     1895     end.
     1896     DO ii = 1 TO NUM-ENTRIES(ParamStr):
     1897       assign ind = integer(ENTRY(ii,ParamStr)) .
     1898       if ind > 0 and ind < 20 then assign  use-column1 [ ind ] = yes  .
     1899     end.
     1900     if use-column1[15] = yes then do:
     1901       assign  ii = 1 .
     1902       if DetalWeek = 1 then do:
     1903         assign
     1904           NameDate = "неделя"
     1905         .
     1906         if x-date-start11 <> ? and x-date-end11 <> ? then do:
     1907           Num-Week = Num-Week + 1 .
     1908           create temp-month .
     1909           assign
     1910             temp-month.ind = ii
     1911             ii = ii + 1
     1912             temp-month.dat-beg = x-date-start11
     1913             temp-month.dat-end = x-date-end11
     1914           .
     1915           run day-begin-fact-order in this-procedure ( input x-date-start11,       output temp-month.v-fact-order-start ).
     1916           run day-begin-fact-order in this-procedure ( input ( x-date-end11 + 1 ), output temp-month.v-fact-order-end ).
     1917         end.
     1918         if x-date-start12 <> ? and x-date-end12 <> ? then do:
     1919           Num-Week = Num-Week + 1 .
     1920           create temp-month .
     1921           assign
     1922             temp-month.ind = ii
     1923             ii = ii + 1
     1924             temp-month.dat-beg = x-date-start12
     1925             temp-month.dat-end = x-date-end12
     1926           .
     1927           run day-begin-fact-order in this-procedure ( input x-date-start12,       output temp-month.v-fact-order-start ).
     1928           run day-begin-fact-order in this-procedure ( input ( x-date-end12 + 1 ), output temp-month.v-fact-order-end ).
     1929         end.
     1930         if x-date-start13 <> ? and x-date-end13 <> ? then do:
     1931           Num-Week = Num-Week + 1 .
     1932           create temp-month .
     1933           assign
     1934             temp-month.ind = ii
     1935             ii = ii + 1
     1936             temp-month.dat-beg = x-date-start13
     1937             temp-month.dat-end = x-date-end13
     1938           .
     1939           run day-begin-fact-order in this-procedure ( input x-date-start13,       output temp-month.v-fact-order-start ).
     1940           run day-begin-fact-order in this-procedure ( input ( x-date-end13 + 1 ), output temp-month.v-fact-order-end ).
     1941         end.
     1942         if x-date-start14 <> ? and x-date-end14 <> ? then do:
     1943           Num-Week = Num-Week + 1 .
     1944           create temp-month .
     1945           assign
     1946             temp-month.ind = ii
     1947             ii = ii + 1
     1948             temp-month.dat-beg = x-date-start14
     1949             temp-month.dat-end = x-date-end14
     1950           .
     1951           run day-begin-fact-order in this-procedure ( input x-date-start14,       output temp-month.v-fact-order-start ).
     1952           run day-begin-fact-order in this-procedure ( input ( x-date-end14 + 1 ), output temp-month.v-fact-order-end ).
     1953         end.
     1954         if x-date-start15 <> ? and x-date-end15 <> ? then do:
     1955           Num-Week = Num-Week + 1 .
     1956           create temp-month .
     1957           assign
     1958             temp-month.ind = ii
     1959             ii = ii + 1
     1960             temp-month.dat-beg = x-date-start15
     1961             temp-month.dat-end = x-date-end15
     1962           .
     1963           run day-begin-fact-order in this-procedure ( input x-date-start15,       output temp-month.v-fact-order-start ).
     1964           run day-begin-fact-order in this-procedure ( input ( x-date-end15 + 1 ), output temp-month.v-fact-order-end ).
     1965         end.
     1966       end.
     1967       else do:
     1968         assign
     1969           NameDate = "месяц"
     1970         .
     1971         define variable mon as integer   no-undo .
     1972         define variable yer as integer   no-undo .
     1973         define variable dat as date   no-undo .
     1974         assign
     1975           mon = month(x-date-start1)
     1976           yer = year(x-date-start1)
     1977         .
     1978         create temp-month .
     1979         assign
     1980           Num-Week = Num-Week + 1
     1981           temp-month.ind                = 1
     1982           temp-month.dat-beg            = x-date-start1
     1983           temp-month.v-fact-order-start = v-fact-order-start1
     1984         .
     1985   FillDt:
     1986         do ii = 2 to 1000 :
     1987           assign mon = mon + 1 .
     1988           if mon > 12 then assign mon = 1  yer = yer + 1 .
     1989           assign
     1990             dat = date(mon,1,yer)
     1991             temp-month.dat-end = dat - 1
     1992           .
     1993           if temp-month.dat-end >= x-date-end1 then do:
     1994             assign
     1995               temp-month.dat-end          = x-date-end1
     1996               temp-month.v-fact-order-end = v-fact-order-end1
     1997             .
     1998             leave FillDt .
     1999           end.
     2000           run day-begin-fact-order in this-procedure ( input ( temp-month.dat-end + 1 ), output temp-month.v-fact-order-end ).
     2001           create temp-month .
     2002           assign
     2003             temp-month.ind = ii
     2004             Num-Week = Num-Week + 1
     2005             temp-month.dat-beg            = dat
     2006           .
     2007           run day-begin-fact-order in this-procedure ( input dat, output temp-month.v-fact-order-start ).
     2008         end.
     2009       end.
     2010     end.
     2011     assign
     2012       Counter1 = 0 .
     2013     .
