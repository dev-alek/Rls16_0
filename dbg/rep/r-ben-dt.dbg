     4062                   and temp-value.type      = 2
     4063               no-error .
     4064               if available temp-value then do:
     4065                 assign
     4066                   temp-value.qnty  = temp-value.qnty + buf_doc-line.fact-qnty
     4067                   temp-value.sum = temp-value.sum + buf_doc-line.fact-qnty * temp-BenetTov.sum-beg
     4068                 .
     4069               end.
     4070               else do:
     4071                 create temp-value .
     4072                 assign
     4073                   temp-value.type      = 2
     4074                   temp-value.obj-type  = buf_obj-list.obj-type
     4075                   temp-value.obj-code  = buf_obj-list.obj-code
     4076                   temp-value.data      = buf_trn-doc.fact-date
     4077                   temp-value.qnty      = buf_doc-line.fact-qnty
     4078                   temp-value.sum       = buf_doc-line.fact-qnty * temp-BenetTov.sum-beg
     4079                   temp-value.prod-type = buf_gds-obj.prod-type
     4080                   temp-value.prod-code = buf_gds-obj.prod-code
     4081                   temp-value.artic     = buf_gds-obj.artic
     4082                 .
     4083               end.
     4084             end.
     4085             else if buf_trn-doc.cli-code = 6 then do:
     4086               find first temp-value
     4087                 where temp-value.artic     = buf_gds-obj.artic
     4088                   and temp-value.prod-type = buf_gds-obj.prod-type
     4089                   and temp-value.prod-code = buf_gds-obj.prod-code
     4090                   and temp-value.obj-type  = buf_obj-list.obj-type
     4091                   and temp-value.obj-code  = buf_obj-list.obj-code
     4092                   and temp-value.type      = 3
     4093                 no-error .
     4094               if available temp-value then do:
     4095                 assign
     4096                   temp-value.qnty = temp-value.qnty + buf_doc-line.fact-qnty
     4097                   temp-value.sum  = temp-value.sum  + buf_doc-line.fact-qnty * temp-BenetTov.sum-beg
     4098                 .
     4099               end.
     4100               else do:
     4101                 create temp-value .
     4102                 assign
     4103                   temp-value.type      = 3
     4104                   temp-value.obj-type  = buf_obj-list.obj-type
     4105                   temp-value.obj-code  = buf_obj-list.obj-code
     4106                   temp-value.data      = buf_trn-doc.fact-date
     4107                   temp-value.qnty      = buf_doc-line.fact-qnty
     4108                   temp-value.sum       = buf_doc-line.fact-qnty * temp-BenetTov.sum-beg
     4109                   temp-value.prod-type = buf_gds-obj.prod-type
     4110                   temp-value.prod-code = buf_gds-obj.prod-code
     4111                   temp-value.artic     = buf_gds-obj.artic
     4112                 .
     4113               end.
