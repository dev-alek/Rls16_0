     1671   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1672     if num-entries(string(p-dec), '.') = 2
     1673       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1674       else return( string(p-dec)) .
     1675   end function.
     1676   function format-point-to-comma returns char (input orig as char ) .
     1677   define variable rtext as character no-undo .
     1678   define variable strt as integer no-undo .
     1679   define variable leng as integer no-undo .
     1680   assign rtext = orig .
     1681   repeat:
     1682     strt =  index(rtext,'.').
     1683     if strt = 0 then leave.
     1684     leng = 1.
     1685     substring(rtext,strt,leng,"character") = v-delim .
     1686   end.
     1687   return rtext.
     1688   end function.
     1689   function format-excel-text returns char ( input start-text as char ) :
     1690   def var  i    as int no-undo.
     1691   def var  ch   as char no-undo.
     1692   def var  n    as int no-undo.
     1693   def var  ipos as int no-undo.
     1694     n = num-entries(trim(start-text), chr(10)) - 1 .
     1695     do i = 1 to n :
     1696       ipos = index( start-text, chr(10)).
     1697       if ipos > 0 then
     1698         substr( start-text, ipos, 1 ) = ' '.
     1699     end.
     1700     n = num-entries(trim(start-text), chr(13)) - 1 .
     1701     do i = 1 to n :
     1702       ipos = index( start-text, chr(13)).
     1703       if ipos > 0 then
     1704         substr( start-text, ipos, 1 ) = ' '.
     1705     end.
     1706     if index( start-text, '"' ) = 0 then
     1707       start-text =  '="'   + trim( start-text) + '"'   .
     1708       else do:
     1709         n = num-entries(trim(start-text), '"') - 1.
     1710         do i = 1 to n :
     1711           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1712         end.
     1713         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1714         start-text = '="'  + ch  + '"' .
     1715       end.
     1716     return start-text.
     1717   end.
     1718   function excel-sum returns char (input p-dec as decimal ).
     1719     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1720   end function.
     1721   function excel-qnty returns char (input p-dec as decimal ).
     1722     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1723   end function.
     1724   function format-excel-text-macr returns char ( input start-text as char ) :
     1725   def var  i    as int no-undo.
     1726   def var  ch   as char no-undo.
     1727   def var  n    as int no-undo.
     1728   def var  ipos as int no-undo.
     1729     n = num-entries(trim(start-text), chr(10)) - 1 .
     1730     do i = 1 to n :
     1731       ipos = index( start-text, chr(10)).
     1732       if ipos > 0 then
     1733         substring( start-text, ipos , 1 ) = ' '.
     1734     end.
     1735     n = num-entries(trim(start-text), chr(13)) - 1 .
     1736     do i = 1 to n :
     1737       ipos = index( start-text, chr(13)).
     1738       if ipos > 0 then
     1739         substring( start-text, ipos, 1 ) = ' '.
     1740     end.
     1741     if index( start-text, '"' ) = 0 then
     1742       start-text =  '"'   + trim( start-text) + '"'   .
     1743       else do:
     1744         n = num-entries(trim(start-text), '"') - 1.
     1745         do i = 1 to n :
     1746           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1747         end.
     1748         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1749         start-text = '"'  + ch  + '"' .
     1750       end.
     1751     n = num-entries(trim(start-text), chr(10)) - 1 .
     1752     do i = 1 to n :
     1753       ipos = index( start-text, chr(10)).
     1754       if ipos > 0 then
     1755         substring( start-text, ipos , 1 ) = ' '.
     1756     end.
     1757       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1758     return start-text.
     1759   end.
