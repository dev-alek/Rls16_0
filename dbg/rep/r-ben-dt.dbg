     3954     on error undo, return error return-value
     3955     :
     3956     end.
     3957   define variable vss-include-info33 as character format "X(65)" no-undo
     3958   initial "@(#)$Workfile$ $Revision$".
     3959     for each buf_obj-list :
     3960       for each buf_doc-line no-lock
     3961         where buf_doc-line.obj-type   = buf_obj-list.obj-type
     3962           and buf_doc-line.obj-code   = buf_obj-list.obj-code
     3963           and buf_doc-line.prod-type  = buf_gds-obj.prod-type
     3964           and buf_doc-line.prod-code  = buf_gds-obj.prod-code
     3965           and buf_doc-line.artic      = buf_gds-obj.artic
     3966           and buf_doc-line.status_    = 'запрос':U
     3967         :
     3968         find first buf_trn-doc no-lock
     3969           where buf_trn-doc.doc-code  = buf_doc-line.doc-code
     3970         .
     3971         if buf_trn-doc.doc-date < x-date-start or buf_trn-doc.doc-date > x-date-end or buf_trn-doc.doc-date = ?  or buf_trn-doc.flag_ <> yes or buf_trn-doc.internal = yes then next .
     3972         find first temp-value
     3973           where temp-value.artic     = buf_gds-obj.artic
     3974             and temp-value.prod-type = buf_gds-obj.prod-type
     3975             and temp-value.prod-code = buf_gds-obj.prod-code
     3976             and temp-value.data      = buf_trn-doc.doc-date
     3977             and temp-value.obj-type  = buf_obj-list.obj-type
     3978             and temp-value.obj-code  = buf_obj-list.obj-code
     3979             and temp-value.type      = 1
     3980           no-error .
     3981         if available temp-value then do:
     3982           assign
     3983             temp-value.qnty  = temp-value.qnty + buf_doc-line.fact-qnty
     3984           .
     3985           if x-SET_val_TYPE = 1 then do:
     3986             assign temp-value.sum = temp-value.sum + buf_doc-line.fact-qnty * buf_doc-line.price-cli * v-base-rate-z / v-base-scale-z .
     3987           end.
     3988           else assign temp-value.sum   = temp-value.sum + buf_doc-line.fact-qnty * buf_doc-line.price-base .
     3989         end.
     3990         else do:
     3991           create temp-value .
     3992           assign
     3993             temp-value.type      = 1
     3994             temp-value.obj-type  = buf_obj-list.obj-type
     3995             temp-value.obj-code  = buf_obj-list.obj-code
     3996             temp-value.data      = buf_trn-doc.doc-date
     3997             temp-value.qnty      = buf_doc-line.fact-qnty
     3998             temp-value.sum       = temp-value.qnty * buf_doc-line.price-cli
     3999             temp-value.prod-type = buf_gds-obj.prod-type
     4000             temp-value.prod-code = buf_gds-obj.prod-code
     4001             temp-value.artic     = buf_gds-obj.artic
     4002           .
     4003            if x-SET_val_TYPE = 1 then do:
     4004             assign temp-value.sum = temp-value.sum * v-base-rate-z / v-base-scale-z .
     4005           end.
     4006         end.
     4007       end.
     4008       for each buf_doc-line no-lock
     4009         where buf_doc-line.obj-type     = buf_obj-list.obj-type
     4010           and buf_doc-line.obj-code     = buf_obj-list.obj-code
     4011           and buf_doc-line.prod-type    = buf_gds-obj.prod-type
     4012           and buf_doc-line.prod-code    = buf_gds-obj.prod-code
