     4188             temp-value.type      = 6
     4189             temp-value.obj-type  = buf_obj-list.obj-type
     4190             temp-value.obj-code  = buf_obj-list.obj-code
     4191             temp-value.qnty      = buf_stk-line.fact-qnty
     4192             temp-value.sum       = buf_stk-line.fact-qnty * temp-BenetTov.sum-beg
     4193             temp-value.prod-type = buf_gds-obj.prod-type
     4194             temp-value.prod-code = buf_gds-obj.prod-code
     4195             temp-value.artic     = buf_gds-obj.artic
     4196             temp-value.data      = x-date-end
     4197           .
