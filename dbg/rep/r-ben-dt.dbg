     5079   procedure SumGroup :
     5080     define input parameter val  as decimal no-undo .
     5081     define input parameter sum  as decimal no-undo .
     5082     do
     5083     on error undo, return error return-value
     5084     :
     5085     end.
     5086     assign  igr = igr + 1 .
     5087     find first temp-ItogAll
     5088       where temp-ItogAll.ind = igr
     5089       no-error .
     5090     if available temp-ItogAll then do:
     5091       assign
     5092         temp-ItogAll.ind = igr
     5093         temp-ItogAll.val = temp-ItogAll.val + val
     5094         temp-ItogAll.sum = temp-ItogAll.sum + sum
     5095       .
     5096     end.
     5097     if Classify = "grp-goods":u then do:
     5098       find first temp-ItogGrp
     5099         where temp-ItogGrp.ind = igr
     5100         no-error .
     5101       if available temp-ItogGrp then do:
     5102         assign
     5103           temp-ItogGrp.ind = igr
     5104           temp-ItogGrp.val = temp-ItogGrp.val + val
     5105           temp-ItogGrp.sum = temp-ItogGrp.sum + sum
     5106         .
     5107       end.
     5108     end.
     5109   end procedure.
