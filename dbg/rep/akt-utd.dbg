       87   define  stream PrnLibStream.
       88   procedure prn-lib-prn-file :
       89     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       90     define input parameter p-DIsabledoptions as integer no-undo .
       91     define variable v-report-name as character no-undo .
       92     define variable v-user-action as character no-undo .
       93     define variable v-printed     as logical   no-undo .
       94     define variable v-exist       as logical   no-undo .
       95     do
       96       on error undo, return error
       97       :
       98       run prn-lib-get-report-name  in this-procedure (
       99         input parParentProc
      100         ,output v-report-name
      101         ).
      102   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      104     (input  v-report-name
      105     ,input  2
      106     ,output v-exist
      107     )  .
      108       if NOT v-exist then
      109       DO:
      110         Message
      111           "Нет заданий на печать ! "
      112           view-as alert-box .
      113         Return  .
      114       End.
      115       run gbl/prnfilen.w
      116         (input  ""
      117         ,input  p-DisabledOptions
      118         ,input  string(v-report-name )
      119         ,input  7
      120         ,output v-user-action
      121         ,output v-printed
      122         ) .
      123       if v-printed then
      124       do:
      125         return "YES" .
      126       end.
      127       else
      128       do:
      129         return "NO" .
      130       end.
      131     end.
      132   end procedure.
      133   procedure prn-lib-open-stream :
      134     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      135     define input parameter p-page-size    as integer no-undo .
      136     define input parameter p-is-stream    as logical no-undo .
      137     define input parameter p-append       as logical no-undo .
      138     define variable v-report-name as character no-undo .
      139     do
      140       on error undo, return error
      141       :
      142       run prn-lib-get-report-name  in this-procedure (
      143         input parParentProc
      144         ,output v-report-name
      145         ).
      146       if p-is-stream then
      147       do:
      148         if p-append then
      149         do:
      150           output stream PrnLibStream to value( v-report-name )
      151             page-size value(p-page-size) append .
      152         end.
      153         if not p-append then
      154         do:
      155           output stream PrnLibStream to value( v-report-name )
      156             page-size value(p-page-size) .
      157         end.
      158       end.
      159       if not p-is-stream then
      160       do:
      161         if p-append then
      162         do:
      163           output to value( v-report-name )
      164             page-size value(p-page-size) append .
      165         end.
      166         if not p-append then
      167         do:
      168           output to value( v-report-name )
      169             page-size value(p-page-size) .
      170         end.
      171       end.
      172     end.
      173   end procedure.
      174   procedure prn-lib-open-exp :
      175     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      176     define input parameter p-is-stream    as logical no-undo .
      177     define input parameter p-is-append    as logical no-undo .
      178     define output parameter p-ReportFileName as char init "report" no-undo.
      179     define output parameter p-process as logical no-undo .
      180     define variable glog as logical no-undo .
      181     do
      182       on error undo, return error
      183       :
      184       SYSTEM-DIALOG GET-FILE p-ReportFileName
      185         TITLE      "Укажите путь"
      186         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      187         ASK-OVERWRITE
      188         CREATE-TEST-FILE
      189         SAVE-AS
      190         USE-FILENAME
      191         DEFAULT-EXTENSION "txt"
      192         UPDATE glog
      193         .
      194       if not glog then  return.
      195       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      196       if p-is-stream then
      197       do:
      198         if p-is-append then
      199         do:
      200           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      201         end.
      202         else
      203         do:
      204           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      205         end.
      206       end.
      207       else
      208       do:
      209         if p-is-append then
      210         do:
      211           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      212         end.
      213         else
      214         do:
      215           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      216         end.
      217       end.
      218       p-process = yes.
      219     end.
      220   end procedure.
      221   procedure prn-lib-get-report-name :
      222     define input parameter parParentProc  as widget-handle no-undo.
      223     define output parameter p-report-name as character no-undo .
      224     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      225   end procedure.
      226   procedure prn-lib-reportviewer-report-name :
      227     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      228     define input parameter p-report-name-html as character no-undo .
      229     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      230   end procedure.
      231   procedure prn-lib-reportviewer :
      232     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      233     define input parameter p-report-name-html as character no-undo .
      234     define input parameter p-param        as character no-undo .
      235     define variable v-excel           as character no-undo init 'TRUE' .
      236     define variable v-value-character as character no-undo .
      237     define variable v-value-integer   as character no-undo .
      238     define variable v-value-date      as date      no-undo .
      239     define variable v-value-decimal   as decimal   no-undo .
      240     define variable rep-excel         as logical   no-undo .
      241     define variable excel-string      as character no-undo .
      242     define variable v-param-type      as character no-undo .
      243     define variable v-tth             as handle    no-undo .
      244     run adm/shattri.p (
      245       input "get":U
      246       ,input  ""
      247       ,input  0
      248       ,input  'report-glob':U
      249       ,input  'rep-excel':U
      250       ,output v-value-character
      251       ,output v-value-date
      252       ,output v-value-decimal
      253       ,output v-value-integer
      254       ,output rep-excel
      255       ,output v-param-type
      256       ,INPUT-OUTPUT table-handle v-tth
      257       )  .
      258     if rep-excel then v-excel = "TRUE" .
      259     else v-excel = "FALSE" .
      260     if p-param eq ""
      261     then
      262        p-param = "EXCEL:" + v-excel.
      263     else
      264        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      265     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      266   end procedure.
      267   function fnc-convert-dot-to-colon returns character
      268       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      269   function fnc-convert-dot-to-colon returns character
      270   (input p-data as decimal, input p-accur as character, input p-num as integer):
      271       define variable result as character no-undo.
      272       define variable v-str-result as character no-undo.
      273       if p-data = ? then p-data = 0 .
      274       p-data = round(p-data, p-num).
      275       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      276       return v-str-result.
      277   END FUNCTION.
      278   define variable mDebug as logical no-undo.
      279   mDebug = session:debug-alert.
      280   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      281   define variable mDiadocApi as component-handle no-undo.
      282   define variable mDiadocConnection as component-handle no-undo.
      283   define variable m-sys-key as character no-undo.
      284   define variable marpar-type as character no-undo.
      285   define variable mPublishHand as handle  no-undo.
      286   define variable mFlaftest as logical no-undo.
      287      create "Diadoc.DiadocClient":U mDiadocApi no-error.
      288   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      289   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      290   define variable mySeqUtd as int64 no-undo init ?.
      291   if mDiadocApi eq ?
      292   then do:
      293      if  log-manager:logfile-name ne ?
      294      then
      295         log-manager:write-message("Нет библиотеки Diadoc или не удалось создать объект Diadoc.DiadocClient", "EDOError").
      296   end.
      297   else do:
      298      if  log-manager:logfile-name ne ?
      299      then
      300         log-manager:write-message(substitute ("Версия библиотеки Diadoc &1" , mDiadocApi:GetFullVersion()) , "EDOError").
      301   end.
      302   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   procedure gen-key-rec :
      304     define input  parameter p-tbl-name    as character no-undo.
      305     define input  parameter p-bh_tbl-name as handle    no-undo.
      306     define output parameter p-key-rec     as character no-undo.
      307     do
      308     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      309     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      310     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      311     :
      312       define variable fh               as handle    no-undo .
      313       define variable v-ok             as logical   no-undo .
      314       define variable v-inform         as character no-undo .
      315       define variable v-ind            as integer   no-undo .
      316       define variable v-idx-field-qnty as integer   no-undo .
      317       if p-tbl-name = ?
      318         or p-tbl-name = "":U
      319       then do:
      320         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      321       end.
      322       if not p-bh_tbl-name:available then do:
      323         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      324       end.
      325       assign
      326         p-key-rec = p-tbl-name
      327         v-inform  = p-bh_tbl-name:index-information(1)
      328         v-ind     = 2
      329       .
      330       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      331       on error undo, return error
      332       :
      333         assign
      334           v-inform = p-bh_tbl-name:index-information( v-ind )
      335           v-ind    = v-ind + 1
      336         .
      337       end.
      338       if v-inform = ?
      339         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      340         or entry( 3, v-inform, ",":U ) <> "1":U
      341       then do:
      342         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      343       end.
      344       else do:
      345         assign
      346           v-idx-field-qnty = num-entries( v-inform ) - 4
      347         .
      348         if v-idx-field-qnty < 2 then do:
      349           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      350         end.
      351         do v-ind = 1 to v-idx-field-qnty by 2
      352         on error undo, return error
      353         :
      354           assign
      355             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      356             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      357           .
      358         end.
      359       end.
      360       if p-key-rec = ? then do:
      361         assign
      362           p-key-rec = "":U
      363         .
      364         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      365       end.
      366     end.
      367     return.
      368   end procedure.
      369   procedure gen-where-keyr-tab :
      370     define input  parameter i-tableSerach as character no-undo.
      371     define input  parameter i-tablekey   as character  no-undo.
      372     define input  parameter p-key-rec    as character  no-undo.
      373     define input  parameter p-key-handle as handle     no-undo .
      374     define input  parameter p-db-name    as character  no-undo .
      375     define input  parameter p-tt-handle  as handle     no-undo .
      376     define output parameter o-Where      as character  no-undo.
      377     do
      378     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      379     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      380     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      381     :
      382       define variable v-full-tbl-name  as character no-undo .
      383       define variable bh_tbl-name      as handle    no-undo .
      384       define variable fh_key           as handle    no-undo .
      385       define variable fh_search        as handle    no-undo .
      386       define variable v-field-num      as integer   no-undo .
      387       define variable v-count-fld      as integer   no-undo .
      388       define variable v-inform         as character no-undo .
      389       define variable v-ind            as integer   no-undo .
      390       define variable v-idx-field-qnty as integer   no-undo .
      391       define variable v-field-name     as character no-undo .
      392       define variable v-field-val      as character no-undo .
      393       define variable v-word-link      as character no-undo .
      394       define variable vTable           as character no-undo.
      395       define variable bh_tbl-key       as handle    no-undo .
      396       assign
      397         p-key-rec = trim( p-key-rec )
      398       .
      399       if p-key-handle <> ? then do:
      400         if not valid-handle(p-key-handle)
      401            or p-key-handle:type <> "buffer"
      402         then do:
      403           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      404         end.
      405         if num-entries( p-key-rec, chr(3) ) > 1
      406           or p-key-rec = ?
      407           or p-key-rec = "":U
      408         then do:
      409           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      410         end.
      411       end.
      412       else do:
      413         if p-key-rec = ?
      414           or p-key-rec = "":U
      415         then do:
      416           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      417         end.
      418       end.
      419       assign
      420         vTable = entry( 1 , p-key-rec, chr(3) )
      421       .
      422       if p-tt-handle <> ?
      423         and ( not valid-handle(p-tt-handle)
      424               or p-tt-handle:type <> "buffer"
      425             )
      426       then do:
      427         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      428       end.
      429       if p-tt-handle = ? then do:
      430         assign
      431           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      432         .
      433         create buffer bh_tbl-name for table v-full-tbl-name .
      434       end.
      435       else do:
      436         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      437       end.
      438       assign
      439         v-inform = bh_tbl-name:index-information(1)
      440         v-ind    = 2
      441       .
      442       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      443       on error undo, return error
      444       :
      445         assign
      446           v-inform = bh_tbl-name:index-information( v-ind )
      447           v-ind    = v-ind + 1
      448         .
      449       end.
      450       if v-inform = ?
      451         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      452         or entry( 3, v-inform, ",":U ) <> "1":U
      453       then do:
      454         delete object bh_tbl-name no-error.
      455         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      456       end.
      457       assign
      458         v-idx-field-qnty = num-entries( v-inform ) - 4
      459       .
      460       if v-idx-field-qnty < 2 then do:
      461         delete object bh_tbl-name no-error.
      462         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      463       end.
      464       assign
      465         o-where     = "where":U
      466         v-word-link = "":U
      467         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      468         v-count-fld = 0
      469       .
      470       if i-tablekey ne "" and i-tablekey ne ?
      471       then do:
      472         assign
      473           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      474         .
      475         create buffer bh_tbl-key for table v-full-tbl-name .
      476       end.
      477       if i-tableSerach ne "" and i-tableSerach ne ?
      478       then do:
      479         delete object bh_tbl-name no-error.
      480         assign
      481           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      482         .
      483         create buffer bh_tbl-name for table v-full-tbl-name .
      484       end.
      485       block_where:
      486       do v-ind = 1 to v-idx-field-qnty by 2
      487       on error undo, return error
      488       :
      489         assign
      490           v-count-fld = v-count-fld + 1
      491         .
      492         if p-key-handle = ?
      493           and v-count-fld > v-field-num
      494         then do:
      495           leave block_where.
      496         end.
      497         define variable VfieldKeyTable as handle no-undo.
      498         assign
      499           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      500           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      501         .
      502         if     bh_tbl-key ne ?
      503         then do:
      504            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      505            if VfieldKeyTable eq ?
      506            then next block_where.
      507         end.
      508         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      509         then
      510            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      511         else
      512            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      513         if p-key-handle = ? then do:
      514           assign
      515             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      516           .
      517         end.
      518         else do:
      519           assign
      520             fh_key = p-key-handle:buffer-field( v-field-name )
      521           .
      522           if fh_key = ?
      523             or not valid-handle( fh_key )
      524           then do:
      525             delete object bh_tbl-name.
      526             if     bh_tbl-key ne ?
      527             then
      528                delete object bh_tbl-key.
      529             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      530           end.
      531           assign
      532             v-field-val = fh_key:buffer-value
      533           .
      534         end.
      535         if fh_search:data-type ="character":U then do:
      536           assign
      537             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      538             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      539             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      540             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      541             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      542             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      543             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      544             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      545             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      546             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      547             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      548             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      549             v-field-val = substitute( '"&1"', v-field-val )
      550           .
      551         end.
      552         assign
      553           o-where = substitute( "&1 &2", o-where, v-field-val )
      554         .
      555         if v-word-link = "":U then do:
      556           assign
      557             v-word-link = "and":U
      558           .
      559         end.
      560       end.
      561       delete object bh_tbl-name.
      562       if     bh_tbl-key ne ?
      563       then
      564          delete object bh_tbl-key.
      565       if p-key-handle = ?
      566         and v-count-fld <> v-field-num
      567       then do:
      568         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      569       end.
      570     end.
      571   end procedure.
      572   procedure gen-hn-keyr-tab :
      573     define input  parameter i-tableSerach as character no-undo.
      574     define input  parameter i-tablekey   as character no-undo.
      575     define input  parameter p-key-rec    as character no-undo.
      576     define input  parameter p-key-handle as handle    no-undo .
      577     define input  parameter p-db-name    as character no-undo .
      578     define input  parameter p-tt-handle  as handle    no-undo .
      579     define input  parameter p-stts-lock  as integer   no-undo .
      580     define output parameter o-hn         as handle    no-undo.
      581     define variable v-full-tbl-name as character no-undo.
      582     define variable v-where         as character no-undo.
      583     define variable bh_tbl-name     as handle    no-undo.
      584     define variable vTable          as character no-undo.
      585     do
      586     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      587     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      588     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      589         run gen-where-keyr-tab(i-tableSerach,
      590                                i-tablekey,
      591                                p-key-rec,
      592                                p-key-handle,
      593                                p-db-name,
      594                                p-tt-handle,
      595                                output v-where).
      596         if i-tableSerach ne "" and i-tableSerach ne ?
      597         then do:
      598            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      599            create buffer bh_tbl-name for table v-full-tbl-name .
      600         end.
      601         else do:
      602            if p-tt-handle = ? then do:
      603               assign
      604                  vTable = entry( 1 , p-key-rec, chr(3) )
      605               .
      606               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      607               create buffer bh_tbl-name for table v-full-tbl-name .
      608            end.
      609            else do:
      610               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      611            end.
      612         end.
      613         if p-tt-handle = ? then do:
      614            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      615         end.
      616         else do:
      617            bh_tbl-name:find-first( v-where ) no-error .
      618         end.
      619         o-hn = bh_tbl-name.
      620      end.
      621   end procedure.
      622   procedure gen-hn-keyr :
      623     define input  parameter p-key-rec    as character no-undo.
      624     define input  parameter p-key-handle as handle    no-undo .
      625     define input  parameter p-db-name    as character no-undo .
      626     define input  parameter p-tt-handle  as handle    no-undo .
      627     define input  parameter p-stts-lock  as integer   no-undo .
      628     define output parameter o-hn         as handle    no-undo.
      629     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      630   end.
      631   procedure gen-row-keyr :
      632     define input  parameter p-key-rec    as character no-undo.
      633     define input  parameter p-key-handle as handle    no-undo .
      634     define input  parameter p-db-name    as character no-undo .
      635     define input  parameter p-tt-handle  as handle    no-undo .
      636     define input  parameter p-stts-lock  as integer   no-undo .
      637     define output parameter p-tbl-row    as rowid     no-undo.
      638     define output parameter p-tbl-name   as character no-undo.
      639     define variable vHn as handle no-undo.
      640       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      641       p-tbl-row = if vHn:available then vHn:rowid else ?.
      642       p-tbl-name =  vHn:table.
      643       delete object vHn no-error.
      644     if p-tbl-row = ? then do:
      645       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      646     end.
      647     else do:
      648       return.
      649     end.
      650   end procedure.
      651   procedure gen-key-fv :
      652     define input  parameter p-key-rec    as character no-undo .
      653     define output parameter p-field-list as character no-undo .
      654     define output parameter p-value-list as character no-undo.
      655     do
      656     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      657     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      658     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      659     :
      660       define variable v-full-tbl-name  as character no-undo .
      661       define variable bh_tbl-name      as handle    no-undo .
      662       define variable v-tbl-name       as character no-undo .
      663       define variable v-field-num      as integer   no-undo .
      664       define variable v-count-fld      as integer   no-undo .
      665       define variable v-inform         as character no-undo .
      666       define variable v-ind            as integer   no-undo .
      667       define variable v-idx-field-qnty as integer   no-undo .
      668       define variable v-delim-key      as character no-undo .
      669       if p-key-rec = ?
      670         or p-key-rec = "":U
      671       then do:
      672         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      673       end.
      674       assign
      675         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      676         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      677       .
      678       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      679       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      680       assign
      681         v-inform = bh_tbl-name:index-information(1)
      682         v-ind    = 2
      683       .
      684       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      685       on error undo, return error
      686       :
      687         assign
      688           v-inform = bh_tbl-name:index-information( v-ind )
      689           v-ind    = v-ind + 1
      690         .
      691       end.
      692       if v-inform = ?
      693         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      694         or entry( 3, v-inform, ",":U ) <> "1":U
      695       then do:
      696         delete object bh_tbl-name no-error.
      697         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      698       end.
      699       assign
      700         v-idx-field-qnty = num-entries( v-inform ) - 4
      701       .
      702       if v-idx-field-qnty < 2 then do:
      703         delete object bh_tbl-name no-error.
      704         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      705       end.
      706       assign
      707         p-field-list = "":U
      708         p-value-list = "":U
      709         v-delim-key  = "":U
      710         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      711         v-count-fld  = 0
      712       .
      713       block_where:
      714       do v-ind = 1 to v-idx-field-qnty by 2
      715       on error undo, return error
      716       :
      717         assign
      718           v-count-fld = v-count-fld + 1
      719         .
      720         if v-count-fld > v-field-num then do:
      721           leave block_where.
      722         end.
      723         assign
      724           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      725           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      726         .
      727         if v-ind = 1 then do:
      728           assign
      729             v-delim-key = chr(3)
      730           .
      731         end.
      732       end.
      733       delete object bh_tbl-name.
      734       if v-count-fld <> v-field-num then do:
      735         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      736       end.
      737     end.
      738   end procedure.
      739   procedure gen-key-field :
      740     define input  parameter p-table      as character no-undo .
      741     define output parameter p-field-list as character no-undo .
      742     do
      743     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      744     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      745     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      746     :
      747       define variable v-full-tbl-name  as character no-undo .
      748       define variable bh_tbl-name      as handle    no-undo .
      749       define variable v-tbl-name       as character no-undo .
      750       define variable v-field-num      as integer   no-undo .
      751       define variable v-count-fld      as integer   no-undo .
      752       define variable v-inform         as character no-undo .
      753       define variable v-ind            as integer   no-undo .
      754       define variable v-idx-field-qnty as integer   no-undo .
      755       define variable v-delim-key      as character no-undo .
      756       if p-table = ?
      757         or p-table = "":U
      758       then do:
      759         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      760       end.
      761       assign
      762         v-tbl-name      = p-table
      763         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      764       .
      765       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      766       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      767       assign
      768         v-inform = bh_tbl-name:index-information(1)
      769         v-ind    = 2
      770       .
      771       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      772       on error undo, return error
      773       :
      774         assign
      775           v-inform = bh_tbl-name:index-information( v-ind )
      776           v-ind    = v-ind + 1
      777         .
      778       end.
      779       if v-inform = ?
      780         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      781         or entry( 3, v-inform, ",":U ) <> "1":U
      782       then do:
      783         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      784       end.
      785       assign
      786         v-idx-field-qnty = num-entries( v-inform ) - 4
      787       .
      788       if v-idx-field-qnty < 2 then do:
      789         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      790       end.
      791       assign
      792         p-field-list = "":U
      793         v-delim-key  = "":U
      794         v-count-fld  = 0
      795       .
      796       block_where:
      797       do v-ind = 1 to v-idx-field-qnty by 2
      798       on error undo, return error
      799       :
      800         assign
      801           v-count-fld = v-count-fld + 1
      802         .
      803         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      804         if v-ind = 1 then do:
      805           assign
      806             v-delim-key = chr(3)
      807           .
      808         end.
      809       end.
      810       delete object bh_tbl-name.
      811     end.
      812   end procedure.
      813   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      814   function getattrUtdex returns char
      815   (idb-num   as integer,
      816    idoc-id   as integer,
      817    iattrcode as character,
      818    iExValue  as character  ):
      819      define buffer utd-attr for utd-attr.
      820      find first utd-attr where utd-attr.db-num eq idb-num
      821                            and utd-attr.doc-id eq idoc-id
      822                            and utd-attr.attr-code eq iattrcode
      823      no-lock no-error.
      824      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      825   end.
      826   function getattrUtd returns char
      827   (idb-num   as integer,
      828    idoc-id   as integer,
      829    iattrcode as character ):
      830     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      831   end.
      832   function setattrUtd returns logical
      833   (idb-num   as integer,
      834    idoc-id   as integer,
      835    iattrcode as character,
      836    iattrval  as character ):
      837      define buffer utd-attr for utd-attr.
      838      find first utd-attr where utd-attr.db-num eq idb-num
      839                            and utd-attr.doc-id eq idoc-id
      840                            and utd-attr.attr-code eq iattrcode
      841      no-lock no-error.
      842      if not available utd-attr
      843      then do:
      844         create utd-attr.
      845         assign
      846            utd-attr.db-num    = idb-num
      847            utd-attr.doc-id    = idoc-id
      848            utd-attr.attr-code = iattrcode
      849            utd-attr.attr-value = iattrval
      850         .
      851      end.
      852      else do:
      853         if utd-attr.attr-value ne iattrval
      854         then do:
      855            find current utd-attr exclusive-lock no-error.
      856            if available utd-attr
      857            then
      858               utd-attr.attr-value = iattrval.
      859         end.
      860      end.
      861      release utd-attr.
      862   end.
      863   function GetAttrUtdlinesEx returns char
      864   (idb-num   as integer,
      865    idoc-id   as integer,
      866    ilinenum  as integer,
      867    iattrcode as character,
      868    iExValue  as character  ):
      869      define buffer utd-lines-attr for utd-lines-attr.
      870      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      871                                  and utd-lines-attr.doc-id    eq idoc-id
      872                                  and utd-lines-attr.lineNum   eq ilineNum
      873                                  and utd-lines-attr.attr-code eq iattrcode
      874      no-lock no-error.
      875      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      876   end.
      877   function GetAttrUtdlines returns char
      878   (idb-num   as integer,
      879    idoc-id   as integer,
      880    ilinenum  as integer,
      881    iattrcode as character ):
      882      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      883   end.
      884   function setattrUtdlines returns logical
      885   (idb-num   as integer,
      886    idoc-id   as integer,
      887    ilinenum  as integer,
      888    iattrcode as character,
      889    iattrval  as character ):
      890      define buffer utd-lines-attr for utd-lines-attr.
      891      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      892                                  and utd-lines-attr.doc-id    eq idoc-id
      893                                  and utd-lines-attr.lineNum   eq ilineNum
      894                                  and utd-lines-attr.attr-code eq iattrcode
      895      no-lock no-error.
      896      if not available utd-lines-attr
      897      then do:
      898         if iattrval ne ?
      899            and iattrval ne ""
      900         then do:
      901            create utd-lines-attr.
      902            assign
      903               utd-lines-attr.db-num    = idb-num
      904               utd-lines-attr.doc-id    = idoc-id
      905               utd-lines-attr.lineNum   = ilineNum
      906               utd-lines-attr.attr-code = iattrcode
      907               utd-lines-attr.attr-value = iattrval
      908            .
      909         end.
      910      end.
      911      else do:
      912         if utd-lines-attr.attr-value ne iattrval
      913         then do:
      914            find current utd-lines-attr exclusive-lock no-error.
      915            if available utd-lines-attr
      916            then do:
      917               if    iattrval eq ?
      918                  or iattrval eq ""
      919               then do:
      920                  delete utd-lines-attr.
      921               end.
      922               else do:
      923                  utd-lines-attr.attr-value = iattrval.
      924               end.
      925            end.
      926         end.
      927      end.
      928      release utd-lines-attr.
      929   end.
      930   function GetAttrUtdMarkingLinesEx returns char
      931   (idb-num   as integer,
      932    idoc-id   as integer,
      933    ilinenum  as integer,
      934    imark     as character,
      935    iattrcode as character,
      936    iExValue  as character  ):
      937      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      938      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      939                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      940                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      941                                          and utd-marking-lines-attr.mark      eq imark
      942                                          and utd-marking-lines-attr.attr-code eq iattrcode
      943      no-lock no-error.
      944      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      945   end.
      946   function GetAttrUtdMarkingLines returns char
      947   (idb-num   as integer,
      948    idoc-id   as integer,
      949    ilinenum  as integer,
      950    imark     as character,
      951    iattrcode as character ):
      952      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      953   end.
      954   function setattrUtdMarkingLines returns logical
      955   (idb-num   as integer,
      956    idoc-id   as integer,
      957    ilinenum  as integer,
      958    imark     as character,
      959    iattrcode as character,
      960    iattrval  as character ):
      961      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      962      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      963                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      964                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      965                                          and utd-marking-lines-attr.mark      eq imark
      966                                          and utd-marking-lines-attr.attr-code eq iattrcode
      967      no-lock no-error.
      968      if not available utd-marking-lines-attr
      969      then do:
      970         if iattrval ne ?
      971            and iattrval ne ""
      972         then do:
      973            create utd-marking-lines-attr.
      974            assign
      975               utd-marking-lines-attr.db-num     = idb-num
      976               utd-marking-lines-attr.doc-id     = idoc-id
      977               utd-marking-lines-attr.lineNum    = ilineNum
      978               utd-marking-lines-attr.mark       = imark
      979               utd-marking-lines-attr.attr-code  = iattrcode
      980               utd-marking-lines-attr.attr-value = iattrval
      981            .
      982         end.
      983      end.
      984      else do:
      985         if utd-marking-lines-attr.attr-value ne iattrval
      986         then do:
      987            find current utd-marking-lines-attr exclusive-lock no-error.
      988            if available utd-marking-lines-attr
      989            then do:
      990               if    iattrval eq ?
      991                  or iattrval eq ""
      992               then do:
      993                  delete utd-marking-lines-attr.
      994               end.
      995               else do:
      996                  utd-marking-lines-attr.attr-value = iattrval.
      997               end.
      998            end.
      999         end.
     1000      end.
     1001      release utd-marking-lines-attr.
     1002   end.
     1003   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1004   define new global shared variable g#attr-lib  as handle no-undo .
     1005   define variable v-attr-lib-variable as handle no-undo .
     1006   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1007   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   define variable vss-include-info10 as character format "X(65)" no-undo
     1009   initial "@(#)$Workfile$ $Revision$".
     1010   procedure xmlchar-test :
     1011   define input parameter p-in-string          as character        no-undo.
     1012   define output parameter p-out-string-enc    as character        no-undo.
     1013   define output parameter p-out-string-dec    as character        no-undo.
     1014   do
     1015   on error undo, return error
     1016   :
     1017          run xmlchar-encode in this-procedure
     1018       (
     1019             input p-in-string
     1020           , output p-out-string-enc
     1021       ).
     1022          run xmlchar-decode in this-procedure
     1023       (
     1024             input p-out-string-enc
     1025           , output p-out-string-dec
     1026       ).
     1027   end.
     1028   end .
     1029   procedure xmlchar-encode :
     1030   define input parameter p-in-string      as character        no-undo.
     1031   define output parameter p-out-string    as character        no-undo.
     1032       define variable v-position      as integer      no-undo.
     1033       define variable v-current-char  as character    no-undo.
     1034   do
     1035   on error undo, return error
     1036   :
     1037       assign
     1038           p-out-string = "":U
     1039       .
     1040       case p-in-string
     1041       :
     1042           when ?
     1043           then do:
     1044               assign
     1045                   p-out-string = "?":U
     1046               .
     1047           end.
     1048           when "?":U
     1049           then do:
     1050               assign
     1051                   p-out-string = "&#63;":U
     1052               .
     1053           end.
     1054           otherwise do:
     1055               do v-position = 1 to length( p-in-string )
     1056               :
     1057                   assign
     1058                       v-current-char = substring( p-in-string, v-position, 1 )
     1059                   .
     1060                   case v-current-char
     1061                   :
     1062                       when "&":U
     1063                       then do:
     1064                           assign
     1065                               p-out-string = p-out-string + "&amp;":U
     1066                           .
     1067                       end.
     1068                       when ">":U
     1069                       then do:
     1070                           assign
     1071                               p-out-string = p-out-string + "&gt;":U
     1072                           .
     1073                       end.
     1074                       when "<":U
     1075                       then do:
     1076                           assign
     1077                               p-out-string = p-out-string + "&lt;":U
     1078                           .
     1079                       end.
     1080                       when "'":U
     1081                       then do:
     1082                           assign
     1083                               p-out-string = p-out-string + "&apos;":U
     1084                           .
     1085                       end.
     1086                       when '"':U
     1087                       then do:
     1088                           assign
     1089                               p-out-string = p-out-string + "&quot;":U
     1090                           .
     1091                       end.
     1092                       when chr(1)
     1093                       then do:
     1094                           assign
     1095                               p-out-string = p-out-string + "":U
     1096                           .
     1097                       end.
     1098                       when chr(2)
     1099                       then do:
     1100                           assign
     1101                               p-out-string = p-out-string + "":U
     1102                           .
     1103                       end.
     1104                       when chr(3)
     1105                       then do:
     1106                           assign
     1107                               p-out-string = p-out-string + "":U
     1108                           .
     1109                       end.
     1110                       when chr(4)
     1111                       then do:
     1112                           assign
     1113                               p-out-string = p-out-string + "":U
     1114                           .
     1115                       end.
     1116                       when chr(5)
     1117                       then do:
     1118                           assign
     1119                               p-out-string = p-out-string + "":U
     1120                           .
     1121                       end.
     1122                       when chr(6)
     1123                       then do:
     1124                           assign
     1125                               p-out-string = p-out-string + "":U
     1126                           .
     1127                       end.
     1128                       when chr(7)
     1129                       then do:
     1130                           assign
     1131                               p-out-string = p-out-string + "":U
     1132                           .
     1133                       end.
     1134                       when chr(8)
     1135                       then do:
     1136                           assign
     1137                               p-out-string = p-out-string + "":U
     1138                           .
     1139                       end.
     1140                       when chr(9)
     1141                       then do:
     1142                           assign
     1143                               p-out-string = p-out-string + "":U
     1144                           .
     1145                       end.
     1146                       when chr(29)
     1147                       then do:
     1148                           assign
     1149                               p-out-string = p-out-string + "":U
     1150                           .
     1151                       end.
     1152                       when chr(10)
     1153                       then do:
     1154                           assign
     1155                               p-out-string = p-out-string + "&#10;":U
     1156                           .
     1157                       end.
     1158                       when chr(13)
     1159                       then do:
     1160                           assign
     1161                               p-out-string = p-out-string + "&#13;":U
     1162                           .
     1163                       end.
     1164                       otherwise do:
     1165                           assign
     1166                               p-out-string = p-out-string + v-current-char
     1167                           .
     1168                       end.
     1169                   end case.
     1170               end.
     1171           end.
     1172       end case.
     1173   end.
     1174   end .
     1175   procedure xmlchar-encode-1c :
     1176   define input parameter p-in-string      as character        no-undo.
     1177   define output parameter p-out-string    as character        no-undo.
     1178       define variable v-position      as integer      no-undo.
     1179       define variable v-current-char  as character    no-undo.
     1180   do
     1181   on error undo, return error
     1182   :
     1183       assign
     1184           p-out-string = "":U
     1185       .
     1186       case p-in-string
     1187       :
     1188           when ?
     1189           then do:
     1190               assign
     1191                   p-out-string = "?":U
     1192               .
     1193           end.
     1194           otherwise do:
     1195               do v-position = 1 to length( p-in-string )
     1196               :
     1197                   assign
     1198                       v-current-char = substring( p-in-string, v-position, 1 )
     1199                   .
     1200                   case v-current-char
     1201                   :
     1202                       when chr(1)
     1203                       then do:
     1204                           assign
     1205                               p-out-string = p-out-string + " ":U
     1206                           .
     1207                       end.
     1208                       when chr(2)
     1209                       then do:
     1210                           assign
     1211                               p-out-string = p-out-string + " ":U
     1212                           .
     1213                       end.
     1214                       when chr(3)
     1215                       then do:
     1216                           assign
     1217                               p-out-string = p-out-string + " ":U
     1218                           .
     1219                       end.
     1220                       when chr(4)
     1221                       then do:
     1222                           assign
     1223                               p-out-string = p-out-string + " ":U
     1224                           .
     1225                       end.
     1226                       when chr(5)
     1227                       then do:
     1228                           assign
     1229                               p-out-string = p-out-string + " ":U
     1230                           .
     1231                       end.
     1232                       when chr(6)
     1233                       then do:
     1234                           assign
     1235                               p-out-string = p-out-string + " ":U
     1236                           .
     1237                       end.
     1238                       when chr(7)
     1239                       then do:
     1240                           assign
     1241                               p-out-string = p-out-string + " ":U
     1242                           .
     1243                       end.
     1244                       when chr(8)
     1245                       then do:
     1246                           assign
     1247                               p-out-string = p-out-string + " ":U
     1248                           .
     1249                       end.
     1250                       when chr(9)
     1251                       then do:
     1252                           assign
     1253                               p-out-string = p-out-string + " ":U
     1254                           .
     1255                       end.
     1256                       when chr(29)
     1257                       then do:
     1258                           assign
     1259                               p-out-string = p-out-string + " ":U
     1260                           .
     1261                       end.
     1262                       when chr(10)
     1263                       then do:
     1264                           assign
     1265                               p-out-string = p-out-string + " ":U
     1266                           .
     1267                       end.
     1268                       when chr(13)
     1269                       then do:
     1270                           assign
     1271                               p-out-string = p-out-string + " ":U
     1272                           .
     1273                       end.
     1274                       otherwise do:
     1275                           assign
     1276                               p-out-string = p-out-string + v-current-char
     1277                           .
     1278                       end.
     1279                   end case.
     1280               end.
     1281           end.
     1282       end case.
     1283   end.
     1284   end .
     1285   procedure xmlchar-decode :
     1286   define input parameter p-in-string      as character        no-undo.
     1287   define output parameter p-out-string    as character        no-undo.
     1288       define variable v-position      as integer      no-undo.
     1289       define variable v-last-position as integer      no-undo.
     1290       define variable v-temp-integer  as integer      no-undo.
     1291       define variable v-current-char  as character    no-undo.
     1292       define variable v-next-char     as character    no-undo.
     1293       define variable v-success       as logical      no-undo.
     1294   do
     1295   on error undo, return error
     1296   :
     1297       assign
     1298           p-out-string = "":U
     1299           v-position   = 0
     1300       .
     1301       replace-cycle:
     1302       do while yes
     1303       on error undo, return error
     1304       :
     1305           assign
     1306               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1307           .
     1308           if v-last-position <= v-position
     1309           then do:
     1310               if v-position = 0
     1311               then do:
     1312                   assign
     1313                       p-out-string = p-in-string
     1314                   .
     1315               end.
     1316               else do:
     1317                   assign
     1318                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1319                   .
     1320               end.
     1321               leave replace-cycle.
     1322           end.
     1323           else do:
     1324               assign
     1325                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1326                   v-position      = v-last-position
     1327                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1328               .
     1329               if v-current-char = "#":U
     1330               then do:
     1331                   assign
     1332                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1333                   .
     1334                   if v-last-position > 0
     1335                   then do:
     1336                       run xmlchar-read-integer in this-procedure
     1337                        (
     1338                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1339                           , output v-temp-integer
     1340                           , output v-success
     1341                       ).
     1342                       if v-success = yes
     1343                       and v-temp-integer >= 1
     1344                       and v-temp-integer <= 255
     1345                       then do:
     1346                           assign
     1347                               p-out-string = p-out-string + chr( v-temp-integer )
     1348                               v-position   = v-last-position + 1
     1349                           .
     1350                       end.
     1351                       else do:
     1352                           assign
     1353                               p-out-string = p-out-string + "&":U
     1354                               v-position   = v-position   + 1
     1355                           .
     1356                       end.
     1357                   end.
     1358                   else do:
     1359                       assign
     1360                           p-out-string = p-out-string + "&":U
     1361                           v-position   = v-position   + 1
     1362                       .
     1363                   end.
     1364               end.
     1365               else do:
     1366                   case substring( p-in-string, v-position + 1, 3 )
     1367                   :
     1368                       when "lt;":U
     1369                       then do:
     1370                           assign
     1371                               p-out-string = p-out-string + "<":U
     1372                               v-position   = v-position   + 3
     1373                           .
     1374                       end.
     1375                       when "gt;":U
     1376                       then do:
     1377                           assign
     1378                               p-out-string = p-out-string + ">":U
     1379                               v-position   = v-position   + 3
     1380                           .
     1381                       end.
     1382                       otherwise do:
     1383                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1384                           then do:
     1385                               assign
     1386                                   p-out-string = p-out-string + "&":U
     1387                                   v-position   = v-position   + 4
     1388                               .
     1389                           end.
     1390                           else do:
     1391                               case substring( p-in-string, v-position + 1, 5 )
     1392                               :
     1393                                   when "quot;":U
     1394                                   then do:
     1395                                       assign
     1396                                           p-out-string = p-out-string + '"':U
     1397                                           v-position   = v-position   + 5
     1398                                       .
     1399                                   end.
     1400                                   when "apos;":U
     1401                                   then do:
     1402                                       assign
     1403                                           p-out-string = p-out-string + "'":U
     1404                                           v-position   = v-position   + 5
     1405                                       .
     1406                                   end.
     1407                                   otherwise do:
     1408                                       assign
     1409                                           p-out-string = p-out-string + "&":U
     1410                                       .
     1411                                   end.
     1412                               end case.
     1413                           end.
     1414                       end.
     1415                   end case.
     1416               end.
     1417           end.
     1418       end.
     1419   end.
     1420   end .
     1421   procedure xmlchar-read-integer :
     1422   define input parameter p-input-string      as character        no-undo.
     1423   define output parameter p-output-integer   as integer          no-undo.
     1424   define output parameter p-success       as logical          no-undo.
     1425   do
     1426   on error undo, return error
     1427   :
     1428       assign
     1429           p-output-integer = integer( p-input-string )
     1430       no-error.
     1431       if error-status :error
     1432       then do:
     1433           assign
     1434               p-success           = no
     1435               p-output-integer    = 0
     1436           .
     1437       end.
     1438       else do:
     1439           assign
     1440               p-success           = yes
     1441           .
     1442       end.
     1443   end.
     1444   end.
     1445   define variable mMRCCode  as logical    no-undo.
     1446   define variable mTypeMark as character  no-undo.
     1447   function IS-NeedMark returns logical
     1448   ( input ib-code as integer  ,
     1449     input ib-str as character ):
     1450      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1451      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1452                                    and buf_prod-bc-attr.b-str  eq ib-str
     1453                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1454        no-lock no-error.
     1455      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1456   end.
     1457   function repTegforDm return char
     1458   (iDM as char ):
     1459       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1460       define variable vteg as character no-undo.
     1461       define variable oDM as character no-undo.
     1462       define variable vi as integer no-undo.
     1463       oDM = iDm.
     1464       do vi = 1 to num-entries(vTeglist):
     1465          vTeg = entry(vi,vTeglist).
     1466          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1467       end.
     1468       return oDM.
     1469   end.
     1470   function repSpecSimbforDm return char
     1471   (iDM as char ):
     1472       define variable oDM as character no-undo.
     1473     run
     1474       xmlchar-decode(iDM, output oDM).
     1475     return repTegforDm (oDM).
     1476   end.
     1477   function CheckGtin return logical
     1478   (iGtin as char):
     1479      define variable bar_code as character no-undo.
     1480      define variable vGtin as logical no-undo init "yes".
     1481      if length(iGtin) eq 14
     1482      then do:
     1483         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1484         run str/chk-sum.p
     1485          (input-output bar_code ) no-error .
     1486         if iGtin ne  bar_code
     1487         then
     1488            vGtin = no.
     1489      end.
     1490      else
     1491         vGtin = no.
     1492      return vgtin.
     1493   end.
     1494   function repSpecSimbforXlm return char
     1495   (iDM as char ):
     1496       iDM = replace(iDM,chr(29),"").
     1497       return iDM.
     1498   end.
     1499   function getGtinByDM return char
     1500   (IDM as char):
     1501      define variable VTXT as char no-undo.
     1502      define variable vGtin as char no-undo.
     1503      vTXt = IdM.
     1504      vGtin = IDM.
     1505      if    length(vtxt) > 14
     1506      then do:
     1507         if   vtxt begins "(01)"
     1508                or vtxt begins "(02)"
     1509         then
     1510            vGtin = substring(vtxt,5,14).
     1511         else if   (vtxt begins "01"
     1512                or vtxt begins "02" )
     1513                and (   (    substring(iDm,17,2) eq "21"
     1514                         and length(vtxt) >= 21)
     1515                     or substring(iDm,17,2) eq "37"
     1516                     or substring(iDm,17,4) eq "(37)" )
     1517         then do:
     1518            vGtin = substring(vtxt,3,14).
     1519            if not checkGtin(vGtin)
     1520            then
     1521               vGtin = substring(vtxt,1,14).
     1522         end.
     1523         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1524             or length(vtxt) eq 14 + 7 + 4
     1525             or length(vtxt) eq 14 + 7
     1526         then
     1527            vGtin = substring(vtxt,1,14).
     1528      end.
     1529      if not checkGtin(vGtin)
     1530      then
     1531         vGtin = "".
     1532      return vgtin.
     1533   end.
     1534   function getGdsCodeByGtin return int
     1535   (iGtin as char):
     1536      define buffer prod-bc  for ub.prod-bc.
     1537      define buffer bar-code for ub.bar-code.
     1538      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1539      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1540      return if avail bar-code then bar-code.gds-code else ?.
     1541   end.
     1542   function getQntyCodeByGtin return decimal
     1543   (iGtin as char):
     1544      define buffer prod-bc  for ub.prod-bc.
     1545      define buffer bar-code for ub.bar-code.
     1546      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1547      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1548      return if avail bar-code then bar-code.cli-base-rate else ?.
     1549   end.
     1550   function getGdsCodeByDM return int
     1551   (iDm as char):
     1552      define variable vGtin as char no-undo.
     1553      define buffer prod-bc for ub.prod-bc.
     1554      vGtin  = getGtinByDM (IDM ).
     1555      return getGdsCodeByGtin (vGtin).
     1556   end.
     1557   function ChekTypeMarkByGds return logical
     1558   (iGds-code as integer ):
     1559      define buffer goods-attr for ub.goods-attr.
     1560      find first goods-attr where goods-attr.gds-code   = iGds-code
     1561                              and goods-attr.attr-code  = 'mark-type':U
     1562      no-lock no-error.
     1563      if available goods-attr
     1564      then do:
     1565         mTypeMark = goods-attr.attr-value.
     1566         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1567           .
     1568      end.
     1569      else
     1570         return no.
     1571   end.
     1572   function ChekTypeMarkByDm return logical
     1573   (iDM as char ):
     1574      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1575   end.
     1576   function ChekTypeMarkByGtin return logical
     1577   (iGtin as char ):
     1578      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1579   end.
     1580   function GetNextElement return character
     1581     (input iAllTeg        as logical
     1582     ,output oteg          as character
     1583     ,output otegval       as character
     1584     ,input-output pstr    as character
     1585      ):
     1586        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1587        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1588        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1589        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1590        define variable vTeg as character no-undo.
     1591        define variable vLength as integer no-undo.
     1592        define variable vi as integer no-undo.
     1593        define variable vj as integer no-undo.
     1594        define buffer code for ub.code.
     1595        find first code where Code.parent eq "MarkType"
     1596                          and Code.CodeValue   eq mTypeMark
     1597                          no-lock no-error.
     1598        if     available code
     1599           and Code.misc1 ne ""
     1600           and Code.misc1 ne ?
     1601        then do:
     1602           integer (Code.misc1) no-error.
     1603           if not error-status:error
     1604           then
     1605             entry (4,vlistleng) = Code.misc1.
     1606        end.
     1607        if iAllTeg
     1608        then
     1609           assign
     1610              vlistElem     = vlistElem    + vlistElemDop
     1611              vlistleng     = vlistleng    + vlistlengDop
     1612           .
     1613        else if mMRCCode
     1614        then
     1615           assign
     1616              vlistElem     = vlistElem    + ",(8005),8005"
     1617              vlistleng     = vlistleng    + ",000006,0006"
     1618           .
     1619       block-elem:
     1620       do vi = 1 to num-entries(vlistElem):
     1621          vTeg = entry(vi,vlistElem).
     1622          if pstr begins vTeg
     1623          then do:
     1624             if    vTeg eq "21"
     1625             then
     1626                vLength = index(pstr,chr(29)) - 2 no-error.
     1627             if vLength  <= 0
     1628             then
     1629                vLength = int(entry(vi,vlistleng)).
     1630             otegval = substring (pstr,length(vteg) + 1, vLength).
     1631             oteg = replace(replace(vteg,")",""),"(","").
     1632             vTeg = vteg + otegval.
     1633             otegval = replace(otegval,chr(29),"").
     1634             oteg = replace(replace(oteg,")",""),"(","").
     1635             pstr = substring (pstr,length(vTeg)+ 1).
     1636             vTeg = replace(vTeg,chr(29),"").
     1637             leave block-elem.
     1638          end.
     1639          else
     1640             vTeg = "".
     1641       end.
     1642       return vteg.
     1643   end.
     1644   function GetCodeIdent return character
     1645   (iDm as char):
     1646      define variable Velement   as character no-undo init "first".
     1647      define variable oCodeIdent as character no-undo.
     1648      define variable vteg as character no-undo.
     1649      define variable vtegval as character no-undo.
     1650      define variable vGtin as character no-undo.
     1651      define buffer marking for ub.marking.
     1652      for first marking no-lock where
     1653                marking.mark eq iDm
     1654            and marking.unit-ext = "LEVEL2"
     1655      :
     1656        return iDm.
     1657      end.
     1658      vGtin  = getGtinByDM (iDm ).
     1659      ChekTypeMarkByDm(idm).
     1660      if iDm begins 'tech_':U
     1661      then
     1662         oCodeIdent = iDm.
     1663      else if length(iDm) < 21
     1664      then do:
     1665         find first marking where marking.mark eq idm
     1666         no-lock no-error.
     1667         oCodeIdent = if available marking then marking.mark else  ?.
     1668      end.
     1669      else if     length(iDm) eq 29
     1670         and not iDm begins "01"
     1671         and not iDm begins "02"
     1672      then
     1673         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1674      else  if     length(iDm) >= 24
     1675               and (  iDm begins "01"
     1676                   or iDm begins "02")
     1677               and  substring(iDm,17,2) ne "21"
     1678      then do:
     1679         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1680                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1681         then
     1682            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1683         else
     1684            oCodeIdent = iDM.
     1685      end.
     1686      else  if     (   length(iDm) eq 25
     1687                    or length(iDm) eq 21)
     1688               and (not iDm begins "01"
     1689               and  not iDm begins "02")
     1690      then
     1691         oCodeIdent = substring(iDm,1,21).
     1692      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1693      then
     1694         oCodeIdent = substring(iDm,1,21).
     1695      else do while Velement ne "" and idm ne "":
     1696         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1697         oCodeIdent = oCodeIdent + Velement.
     1698      end.
     1699      return oCodeIdent.
     1700   end.
     1701   function GetTegCod return character
     1702   (icodeIdent as char, iTeg as char):
     1703      define variable Velement   as character no-undo init "first".
     1704      define variable oTeg as character no-undo init ?.
     1705      define variable vteg as character no-undo.
     1706      define variable vtegval as character no-undo.
     1707      if     ((length(icodeIdent) eq 21
     1708         and not icodeIdent begins "01"
     1709         and not icodeIdent begins "02")
     1710         or
     1711             ( length(icodeIdent) eq 25
     1712               and not icodeIdent begins "01"
     1713               and not icodeIdent begins "02"))
     1714      then do:
     1715         if iTeg eq "01" or iTeg eq "02"
     1716         then
     1717            oTeg = substring(icodeIdent,1,21).
     1718         else  if  iTeg eq "21"
     1719         then
     1720            oTeg = substring(icodeIdent,15,7).
     1721      end.
     1722      else do:
     1723         ChekTypeMarkByDm(icodeIdent).
     1724         block-teg:
     1725            do while Velement ne "" and icodeIdent ne "":
     1726            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1727            if    Velement begins iTeg
     1728               or Velement begins "(" + iTeg + ")"
     1729            then do:
     1730               oTeg = vtegval.
     1731               leave block-teg.
     1732            end.
     1733         end.
     1734      end.
     1735      return oTeg.
     1736   end.
     1737   function isOAD return logical
     1738   (icodeIdent as character):
     1739      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1740   end.
     1741   function isMark return logical
     1742   (icodeIdent as character):
     1743      define buffer buf_marking for ub.marking.
     1744      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1745             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1746   end.
     1747   function addBracketForCode return character
     1748   (icodeIdent as char):
     1749      define variable Velement   as character no-undo init "first".
     1750      define variable oTeg as character no-undo.
     1751      define variable vteg as character no-undo.
     1752      define variable vtegval as character no-undo.
     1753      define buffer marking for ub.marking.
     1754      find first marking no-lock where
     1755                 marking.mark begins icodeIdent no-error.
     1756      if    not ChekTypeMarkByDm(icodeIdent)
     1757         or length(icodeIdent) le 24
     1758         or (avail marking and marking.unit-ext = "LEVEL2")
     1759      then
     1760         oTeg = icodeIdent.
     1761      else do:
     1762         if (  icodeIdent begins "01"
     1763            or icodeIdent begins "02"
     1764            ) and CheckGtin(substring (icodeIdent,3,14))
     1765            and substring (icodeIdent,17,2) eq "21"
     1766         then do:
     1767            mMRCCode = yes.
     1768            ChekTypeMarkByDm(icodeIdent).
     1769            block-teg:
     1770            do while Velement ne "" and icodeIdent ne "":
     1771               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1772               if vteg ne ""
     1773               then
     1774                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1775            end.
     1776            mMRCCode = no.
     1777         end.
     1778         else do:
     1779            oTeg = icodeIdent.
     1780         end.
     1781      end.
     1782      return oTeg.
     1783   end.
     1784   function getlevelByCodId return int
     1785   (iCode as char):
     1786      define variable vLength as int no-undo.
     1787      define variable vLevel  as int no-undo.
     1788      if not ChekTypeMarkByDM (icode) then return ?.
     1789      vLength = length(iCode).
     1790      if    vLength eq 18
     1791         or vLength eq 20
     1792      then
     1793         Vlevel = 4.
     1794      else if vLength eq 21
     1795      then
     1796         Vlevel = 1.
     1797      else if vLength eq 25
     1798      then do:
     1799         if  iCode begins "01"
     1800         then
     1801            Vlevel = 3.
     1802         else
     1803            Vlevel = 1.
     1804      end.
     1805      else if     vLength >= 26
     1806              and vLength <= 46
     1807      then do:
     1808         if    substring(iCode,17,2) eq "11"
     1809            or substring(iCode,17,2) eq "13"
     1810            or (    substring(iCode,17,2) eq "21"
     1811                and vLength >= 33
     1812                and substring(iCode,26,4) ne "8005")
     1813         then
     1814            Vlevel = 4.
     1815         else if    vLength eq 31
     1816                 or vLength eq 38
     1817                 or vLength eq 39
     1818                 or vLength eq 45
     1819         then
     1820            Vlevel = 1.
     1821         else if    vLength eq 35
     1822                 or vLength eq 43
     1823         then
     1824            Vlevel = 3.
     1825         else
     1826            Vlevel = ?.
     1827      end.
     1828      else
     1829         Vlevel = ?.
     1830      return Vlevel.
     1831   end.
     1832   function getLevelMotpBycodid return character
     1833   (iDm as char):
     1834      define variable vLevel as integer no-undo.
     1835      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1836      vLevel = getlevelByCodId(iDm).
     1837      if    vLevel eq ?
     1838         or vLevel < 1
     1839         or vLevel > 6
     1840      then
     1841         return ?.
     1842      else
     1843         return entry(vlevel,vList).
     1844   end.
     1845   function getLevelUTDByLevelMotp return character
     1846   (iUnit as char):
     1847      define variable vLevel as integer no-undo.
     1848      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1849      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1850      vLevel = lookup(iUnit,vListMOTP).
     1851      if    vLevel eq ?
     1852         or vLevel < 1
     1853         or vLevel > 4
     1854      then
     1855         return ?.
     1856      else
     1857         return entry(vlevel,vListutd).
     1858   end.
     1859   function getLevelMotpByDM return character
     1860   (iDm as char):
     1861      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1862   end.
     1863   function getLevelUTDByCodId return character
     1864   (iDm as char):
     1865      define variable vLevel as integer no-undo.
     1866      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1867      vLevel = getlevelByCodId(iDm).
     1868      if    vLevel eq ?
     1869         or vLevel < 1
     1870         or vLevel > 4
     1871      then
     1872         return ?.
     1873      else
     1874         return entry(vlevel,vList).
     1875   end.
     1876   function getLevelUTDByDM return character
     1877   (iDm as char):
     1878      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1879   end.
     1880   define variable mNotMarkQnty as logical no-undo.
     1881   function getQntyUTDByCodId return decimal
     1882   (iDM as char):
     1883      define variable vLevel as integer no-undo.
     1884      define variable vList as character no-undo init "1,5,10,500".
     1885      define variable vGtin as character no-undo.
     1886      define variable vqnty as decimal no-undo init ?.
     1887      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1888      if vqnty eq ?
     1889      then do:
     1890         if not mNotMarkQnty
     1891         then do:
     1892            define buffer marking for ub.marking.
     1893            define variable vCodident as character no-undo.
     1894            vCodident = GetCodeIdent(idm).
     1895            find first marking where marking.mark begins vCodident no-lock no-error.
     1896            if     available marking
     1897               and marking.box-qnty ne ?
     1898            then
     1899               return marking.box-qnty.
     1900         end.
     1901         vGtin = getGtinByDm(iDM).
     1902         if ChekTypeMarkByGtin (vGtin)
     1903         then do:
     1904            vLevel = getlevelByCodId(iDM).
     1905            if     vLevel >= 1
     1906               and vLevel <= 4
     1907            then
     1908               vqnty = int(entry(vlevel,vList)).
     1909         end.
     1910         else
     1911            vqnty = getQntyCodeByGtin(vgtin).
     1912      end.
     1913      return vqnty.
     1914   end.
     1915   function getQntyUTDByDM return decimal
     1916   (iDm as char):
     1917      define variable vDM as character no-undo.
     1918      if     length (iDm) ne 25
     1919         and length (iDm) ne 29
     1920         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1921      then
     1922         vDM = substring (iDm,1,length (iDm) - 6 ).
     1923      else
     1924         vDM = substring (iDm,1,length (iDm) - 4 ).
     1925      return getQntyUTDByCodId(vDM).
     1926   end.
     1927   function getMRC4 return decimal
     1928   (iMRC as char):
     1929      define variable oMrc     as decimal no-undo init ?.
     1930      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1931      define variable vi       as integer no-undo.
     1932      define variable vfound   as integer no-undo.
     1933      define variable vposStart   as integer no-undo.
     1934      do:
     1935      OMRc = 0.
     1936      do vi = 1 to 4:
     1937         define variable vsimb as character no-undo.
     1938         vsimb = substring(iMRC,vi,1).
     1939         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1940         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1941         if vfound > 0
     1942         then
     1943            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1944         end.
     1945         OMRc = OMRc / 100.
     1946      end.
     1947      return OMRc.
     1948   end.
     1949   function getMRCByDM return decimal
     1950   (iDm as char):
     1951      define variable vMRC     as character no-undo.
     1952      define variable oMrc     as decimal no-undo init ?.
     1953      define variable Velement as character no-undo init "empty".
     1954      define variable vteg as character no-undo.
     1955      define variable vtegval as character no-undo.
     1956      if    length(idm) eq 14 + 7 + 4 + 4
     1957         or length(idm) eq 14 + 7 + 4
     1958      then do:
     1959         vMRC = substring(idm,22,4).
     1960         omrc = getMRC4(vMRC).
     1961      end.
     1962      else do:
     1963          ChekTypeMarkByDm(iDm).
     1964          block-mrc:
     1965          do while Velement ne "" and idm ne "":
     1966             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1967             if Velement begins "8005"
     1968             then do:
     1969                vMRC = substring(Velement,5,6).
     1970                leave block-mrc.
     1971             end.
     1972             else if Velement begins "(8005)"
     1973             then do:
     1974                vMRC = substring(Velement,7,6).
     1975                leave block-mrc.
     1976             end.
     1977          end.
     1978          if vMRC ne ""
     1979          then
     1980             OMRc = dec(vmrc) / 100 no-error.
     1981      end.
     1982      return OMRc.
     1983   end.
     1984   function MoveDate return Date
     1985   (idate as date,
     1986    iMonth as int64):
     1987      define variable vMonth   as int64 no-undo.
     1988      define variable vYear    as int64 no-undo.
     1989      define variable vDateNew as date  no-undo.
     1990       define variable vDay     as int64 no-undo.
     1991       vMonth = month(iDate) + iMonth.
     1992       vYear =  year(iDate).
     1993       if vMonth <= 0
     1994       then assign
     1995          vMonth = vMonth + 12
     1996           vYear  = vYear - 1
     1997       .
     1998       else if vMonth > 12
     1999       then assign
     2000          vMonth = vMonth - 12
     2001           vYear  = vYear + 1
     2002       .
     2003       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2004       do while error-status:error eq yes:
     2005          VDay = vDay + 1.
     2006          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2007       end.
     2008       if VDay > 0
     2009       then
     2010          vDateNew + 1.
     2011       return vDateNew.
     2012   end.
     2013   procedure checkEMRC:
     2014   define input  parameter iDm as character no-undo.
     2015   define output parameter vok as logical   no-undo init yes.
     2016      define variable v-value-emrc as character no-undo.
     2017      define variable v-type-emrc  as character no-undo.
     2018      define variable vDateIso     as character no-undo.
     2019      define variable vMRC         as decimal no-undo.
     2020      define variable vqnty        as decimal no-undo.
     2021      define variable vPrice       as decimal no-undo.
     2022      define variable vparent      as character no-undo.
     2023      define variable vgds-code    as integer no-undo.
     2024      define buffer code for ub.code.
     2025      vMRC = getMRCByDM(iDm).
     2026      if vMRC > 0
     2027      then do:
     2028         vgds-code = getGdsCodeByDM(iDm).
     2029         vqnty     = getQntyUTDByDM(iDm).
     2030               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2031            (
     2032             input   vgds-code
     2033            ,input   'emrc-type':U
     2034            ,output   v-value-emrc
     2035            ,output   v-type-emrc
     2036          ) no-error.
     2037          if     v-value-emrc ne ""
     2038             and v-value-emrc ne ?
     2039          then do:
     2040             vDateIso = iso-date(today).
     2041             vPrice = vMRC / vqnty.
     2042             vparent ="emc" + chr(4) + v-value-emrc.
     2043             find last code where Code.parent      eq vparent
     2044                              and Code.code        le vDateIso
     2045                              and code.status_  eq 0
     2046             no-lock no-error.
     2047             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2048             then
     2049                vOk = true .
     2050             else do:
     2051                 define variable vText      as character no-undo.
     2052                 define variable vDate      as date no-undo.
     2053                 define variable vDateLast  as character no-undo.
     2054                 define variable vDateFirst as character no-undo.
     2055                 define variable vDate3     as date no-undo.
     2056                 vdate = date(code.misc1).
     2057                 vDateLast = code.misc1.
     2058                 vDate3 = MoveDate(today, - 3 ).
     2059                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2060                                      string(vDate3  , "99/99/9999"),
     2061                                      string(vDate   , "99/99/9999")
     2062                                      ).
     2063                 vdateIso = iso-date(vdate3).
     2064                 find last code  where Code.parent      eq vparent
     2065                                   and Code.code        le vDateIso
     2066                                   and code.status_  eq 0 no-lock no-error.
     2067                 if available code
     2068                 then
     2069                    vDateIso = code.code.
     2070                 vDateFirst = vDateIso.
     2071                 vDateLast = iso-date(vdate).
     2072                 define variable vGood as logical no-undo.
     2073                 define variable vDateSale as date no-undo.
     2074                 define buffer bcode for code.
     2075                 for last code where Code.parent   eq vparent
     2076                                 and code.status_  eq 0
     2077                                 and code.code     < vDateLast
     2078                                 and code.code     >= vDateFirst
     2079                 no-lock:
     2080                    find first bcode where bCode.parent   eq vparent
     2081                                       and bcode.status_  eq 0
     2082                                       and bcode.code     > code.code no-lock no-error.
     2083                    if available bcode
     2084                    then do:
     2085                       if vPrice < dec(Code.CodeValue)
     2086                       then
     2087                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2088                                                     chr(10),
     2089                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2090                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2091                                                     ).
     2092                       else do:
     2093                          vGood = yes.
     2094                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2095                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2096                                                     chr(10),
     2097                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2098                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2099                                                     string(         vDateSale            ,"99/99/9999"),
     2100                                                     string(vDateSale - today)
     2101                                                     ).
     2102                       end.
     2103                    end.
     2104                 end.
     2105                 if vgood
     2106                 then do:
     2107                    define variable choice as integer no-undo .
     2108                    run gbl/d-askw.w (input "Уточнение"
     2109                           ,input  vText
     2110                           ,input "|"
     2111                           ,input "Принять|Вернуть"
     2112                           ,input "Принять данный товар|Вернуть товар постащику"
     2113                           ,input 1
     2114                           ,input 2
     2115                           ,output choice) no-error.
     2116                    vok = choice eq 1.
     2117                 end.
     2118                 else
     2119                    vok =false.
     2120             end.
     2121          end.
     2122      end.
     2123   end.
     2124   function addGs2Mark return character
     2125   (iMark as char):
     2126      define variable vDM   as character no-undo.
     2127      define variable vIdx  as integer   no-undo.
     2128      if index(iMark,chr(29),1) > 0
     2129      then return iMark.
     2130      if substring(iMark,26,4) = "8005" then
     2131      do:
     2132        vIdx = index(iMark,"93",26 + 4 + 5).
     2133        if vIdx > 1 then do:
     2134          vDM = substitute("&1&4&2&4&3",
     2135                           substring(iMark,1,25),
     2136                           substring(iMark,26,vIdx - 25 - 1),
     2137                           substring(iMark,vIdx),
     2138                           chr(29)) no-error.
     2139          vIdx = index(vDm,"240",vIdx + 4).
     2140          if vIdx > 0 then
     2141          do:
     2142            vDM = substitute("&1&3&2",
     2143                             substring(vDm,1,vIdx - 1),
     2144                             substring(vDm,vIdx),
     2145                             chr(29)) no-error.
     2146          end.
     2147        end.
     2148        else
     2149          vDM = substitute("&1&3&2",
     2150                           substring(iMark,1,25),
     2151                           substring(iMark,26),
     2152                           chr(29)) no-error.
     2153      end.
     2154      else if substring(iMark,32,2) = "91" then
     2155      do:
     2156        vIdx = index(iMark,"92",32).
     2157        if vIdx > 1 then
     2158          vDM = substitute("&1&4&2&4&3",
     2159                           substring(iMark,1,31),
     2160                           substring(iMark,32,vIdx - 31 - 1),
     2161                           substring(iMark,vIdx),
     2162                           chr(29)) no-error.
     2163        else
     2164          vDM = substitute("&1&3&2",
     2165                           substring(iMark,1,31),
     2166                           substring(iMark,32),
     2167                           chr(29)) no-error.
     2168      end.
     2169      else if substring(iMark,39,2) = "91" then
     2170      do:
     2171        vIdx = index(iMark,"92",38).
     2172        if vIdx > 1 then
     2173          vDM = substitute("&1&4&2&4&3",
     2174                           substring(iMark,1,38),
     2175                           substring(iMark,39,vIdx - 38 - 1),
     2176                           substring(iMark,vIdx),
     2177                           chr(29)) no-error.
     2178        else
     2179          vDM = substitute("&1&3&2",
     2180                           substring(iMark,1,38),
     2181                           substring(iMark,39),
     2182                           chr(29)) no-error.
     2183      end.
     2184      else if substring(iMark,25,2) = "93" then
     2185      do:
     2186        vIdx = index(iMark,"92",25).
     2187        if vIdx > 1 then
     2188          vDM = substitute("&1&4&2&4&3",
     2189                           substring(iMark,1,24),
     2190                           substring(iMark,25,vIdx - 24 - 1),
     2191                           substring(iMark,vIdx),
     2192                           chr(29)) no-error.
     2193        else
     2194          vIdx = index(iMark,"3103",25).
     2195          if vIdx > 0 then
     2196          vDM = substitute("&1&4&2&4&3",
     2197                           substring(iMark,1,24),
     2198                           substring(iMark,25,vIdx - 24 - 1),
     2199                           substring(iMark,vIdx),
     2200                           chr(29)) no-error.
     2201          else
     2202            vDM = substitute("&1&3&2",
     2203                             substring(iMark,1,24),
     2204                             substring(iMark,25),
     2205                             chr(29)) no-error.
     2206      end.
     2207      else if substring(iMark,32,2) = "93" then
     2208      do:
     2209        vDM = substitute("&1&3&2",
     2210              substring(iMark,1,31),
     2211              substring(iMark,32),
     2212              chr(29)) no-error.
     2213      end.
     2214      return if vDM <> "" then vDm else iMark.
     2215   end.
     2216   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2217   function AddUtdErrForTab returns logical
     2218   (idb-num         as integer ,
     2219    idoc-id         as integer ,
     2220    iTab            as character,
     2221    iObj            as handle ,
     2222    iCheckType      as character,
     2223    iCodeErr        as character,
     2224    iCheckObj       as character ):
     2225      define buffer utd-err for utd-err.
     2226      define buffer utd for utd.
     2227      find first utd where utd.db-num     eq idb-num
     2228                       and utd.doc-id     eq idoc-id
     2229                       and utd.Direction  eq 'Outbound'
     2230      no-lock no-error.
     2231      if available utd
     2232      then
     2233         return no.
     2234      define variable vRecKey as character no-undo.
     2235            run gen-key-rec (input iTab,
     2236                             input  iObj,
     2237                             output vRecKey).
     2238      find first utd-err where utd-err.db-num     eq idb-num
     2239                           and utd-err.doc-id     eq idoc-id
     2240                           and utd-err.CheckType  eq iCheckType
     2241                           and utd-err.CodeErr    eq iCodeErr
     2242                           and utd-err.CheckObj   eq iCheckObj
     2243      exclusive-lock no-error.
     2244      if not available utd-err
     2245      then do:
     2246         create utd-err.
     2247         assign
     2248            utd-err.db-num         = idb-num
     2249            utd-err.doc-id         = idoc-id
     2250            utd-err.CheckType      = iCheckType
     2251            utd-err.CodeErr        = iCodeErr
     2252            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2253            utd-err.reckey         = vRecKey
     2254            utd-err.qnty           = 1
     2255         .
     2256      end.
     2257      else
     2258         utd-err.qnty = utd-err.qnty + 1.
     2259      return utd-err.qnty eq 1.
     2260   end.
     2261   function AddUtdErr returns logical
     2262   (idb-num         as integer ,
     2263    idoc-id         as integer ,
     2264    iObj            as handle ,
     2265    iCheckType      as character,
     2266    iCodeErr        as character,
     2267    iCheckObj       as character ):
     2268      AddUtdErrForTab
     2269         (idb-num,
     2270          idoc-id,
     2271          iObj:table,
     2272          iObj,
     2273          iCheckType,
     2274          iCodeErr,
     2275          iCheckObj).
     2276   end.
     2277   function ClearUtdErrTypeCode returns logical
     2278   (idb-num         as integer,
     2279    idoc-id         as integer ,
     2280    iCheckType      as character,
     2281    iCodeErr        as character
     2282    ):
     2283      define buffer utd-err for utd-err.
     2284      if    iCheckType eq "*"
     2285         or iCheckType eq ?
     2286      then do:
     2287         if     iCodeErr ne ?
     2288            and iCodeErr ne "*"
     2289         then
     2290            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2291            view-as alert-box.
     2292         else
     2293         for each utd-err where utd-err.db-num  eq idb-num
     2294                            and utd-err.doc-id  eq idoc-id
     2295         exclusive-lock:
     2296            delete utd-err.
     2297         end.
     2298      end.
     2299      else do:
     2300         if    iCodeErr eq ?
     2301            or iCodeErr eq "*"
     2302         then do:
     2303            for each utd-err where utd-err.db-num     eq idb-num
     2304                               and utd-err.doc-id     eq idoc-id
     2305                               and utd-err.CheckType  eq iCheckType
     2306            exclusive-lock:
     2307               delete utd-err.
     2308            end.
     2309         end.
     2310         else do:
     2311            for each utd-err where utd-err.db-num     eq idb-num
     2312                               and utd-err.doc-id     eq idoc-id
     2313                               and utd-err.CheckType  eq iCheckType
     2314                               and ub.utd-err.CodeErr eq iCodeErr
     2315            exclusive-lock:
     2316               delete utd-err.
     2317            end.
     2318         end.
     2319      end.
     2320   end.
     2321   function ClearUtdErr returns logical
     2322   (idb-num         as integer,
     2323    idoc-id         as integer ,
     2324    iCheckType      as character
     2325    ):
     2326      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2327   end.
     2328   function GetMesError returns character
     2329   (itxt as character,
     2330    iobj as character ):
     2331    define variable vi as integer no-undo.
     2332    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2333       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2334    end.
     2335    return itxt.
     2336   end.
     2337   function GetTextErrorType returns character
     2338   (iCheckType as character,
     2339    iCodeErr   as character,
     2340    iChechObj  as character,
     2341    iType      as character  ):
     2342      define buffer code    for code.
     2343      define variable vError as character no-undo.
     2344      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2345                        and code.code   eq iCodeErr
     2346      no-lock no-error.
     2347      if available code
     2348      then do:
     2349         define variable vType as integer no-undo.
     2350         if code.misc3 eq "error"
     2351         then
     2352            vType = 0.
     2353         else if code.misc3 eq "warning"
     2354         then
     2355            vType = 1.
     2356         else if code.misc3 eq "Hiden"
     2357         then
     2358            vType = 2.
     2359         else
     2360            vtype = int(code.misc3) no-error.
     2361         case itype:
     2362            when "error"
     2363            then do:
     2364               if vtype eq 0
     2365               then
     2366                  vError = GetMesError(Code.CodeValue,iChechObj).
     2367            end.
     2368            when "warning"
     2369            then do:
     2370               if vtype <= 1
     2371               then
     2372                  vError = GetMesError(Code.CodeValue,iChechObj).
     2373            end.
     2374            otherwise do:
     2375               vError = GetMesError(Code.CodeValue,iChechObj).
     2376            end.
     2377         end.
     2378      end.
     2379      else
     2380         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2381      return vError.
     2382   end.
     2383   function GetTypeError returns integer
     2384   (iCheckType as character,
     2385    iCodeErr   as character):
     2386      define buffer code    for code.
     2387      define variable vType as integer no-undo.
     2388      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2389                        and code.code   eq iCodeErr
     2390      no-lock no-error.
     2391      if     not available code
     2392         and code.misc3 eq "error"
     2393      then
     2394         vType = 0.
     2395      else if code.misc3 eq "warning"
     2396      then
     2397         vType = 1.
     2398      else if code.misc3 eq "Hiden"
     2399      then
     2400         vType = 2.
     2401      else
     2402         vtype = int(code.misc3) no-error.
     2403      return vtype.
     2404   end.
     2405   function GetTextError returns character
     2406   (iCheckType as character,
     2407    iCodeErr   as character,
     2408    iChechObj  as character ):
     2409      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2410   end.
     2411   function GetErrForUtdStr returns character
     2412   (idb-num     as integer ,
     2413    idoc-id     as integer ,
     2414    iCheckType  as character
     2415    ):
     2416      define buffer utd-err for utd-err.
     2417      define buffer code    for code.
     2418      define variable vHQry as handle no-undo.
     2419      define variable vError as longchar no-undo.
     2420      define variable vErrorOne as longchar  no-undo.
     2421      define variable oError as character no-undo.
     2422      create query vHQry.
     2423      vHQry:set-buffers(buffer utd-err:handle).
     2424      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2425                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2426                               + if    iCheckType eq "*"
     2427                                    or iCheckType eq ?
     2428                                 then       ""
     2429                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2430      vHQry:query-open().
     2431      vHQry:get-first().
     2432      QRY-BLOCK:
     2433      repeat while not vHQry:query-off-end:
     2434         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2435         if     vErrorOne ne ""
     2436            and vErrorOne ne ?
     2437         then
     2438            vError = vError + ", " + vErrorOne.
     2439         vHQry:get-next().
     2440      end.
     2441      oError = substring(vError,3,4002).
     2442      return oError.
     2443   end.
     2444   function GetErrJsonForUtd returns character
     2445   (idb-num         as integer ,
     2446    idoc-id         as integer ,
     2447    iCheckType      as character
     2448    ):
     2449      define buffer utd-err for utd-err.
     2450      define variable vHQry as handle no-undo.
     2451      define variable vError as longchar no-undo.
     2452      define variable oError as character no-undo.
     2453      create query vHQry.
     2454      define variable vi as integer no-undo.
     2455      vHQry:set-buffers(buffer utd-err:handle).
     2456      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2457                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2458                               + if    iCheckType eq "*"
     2459                                    or iCheckType eq ?
     2460                                 then       ""
     2461                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2462      vHQry:query-open().
     2463      vHQry:get-first().
     2464      QRY-BLOCK:
     2465      repeat while not vHQry:query-off-end:
     2466         define variable vErrorOne as character no-undo.
     2467         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2468         if     vErrorOne ne ?
     2469            and vErrorOne ne ""
     2470         then do:
     2471            vi = vi + 1.
     2472            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2473                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2474                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2475         end.
     2476         vHQry:get-next().
     2477      end.
     2478      for first utd where utd.db-num eq idb-num
     2479                      and utd.doc-id eq idoc-id
     2480                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2481      no-lock,
     2482         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2483                                  and utd-marking-lines.doc-id eq idoc-id
     2484                                  and utd-marking-lines.doc-level eq 1
     2485      no-lock,
     2486         first marking where marking.mark eq utd-marking-lines.mark
     2487                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2488      no-lock:
     2489         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2490         if     vErrorOne ne ?
     2491            and vErrorOne ne ""
     2492         then do:
     2493            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2494                            + '","ОбъектОш":"' + marking.mark
     2495                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2496         end.
     2497      end.
     2498      if vError ne ""
     2499      then
     2500         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2501      return oError.
     2502   end.
     2503   function GetErrJsonForUtdReturn returns character
     2504   (idb-num         as integer ,
     2505    idoc-id         as integer ,
     2506    iCheckType      as character
     2507    ):
     2508      define buffer utd-err for utd-err.
     2509      define variable vHQry as handle no-undo.
     2510      define variable vError as longchar no-undo.
     2511      define variable oError as character no-undo.
     2512      define variable vi as integer no-undo.
     2513      create query vHQry.
     2514      vHQry:set-buffers(buffer utd-err:handle).
     2515      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2516                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2517                               + if    iCheckType eq "*"
     2518                                    or iCheckType eq ?
     2519                                 then       ""
     2520                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2521      vHQry:query-open().
     2522      vHQry:get-first().
     2523      QRY-BLOCK:
     2524      repeat while not vHQry:query-off-end:
     2525         define variable vErrorOne as character no-undo.
     2526         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2527         if     vErrorOne ne ?
     2528            and vErrorOne ne ""
     2529         then do:
     2530            vi = vi + 1.
     2531            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2532                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2533                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2534         end.
     2535         vHQry:get-next().
     2536      end.
     2537      if vError ne ""
     2538      then
     2539         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2540      return oError.
     2541   end.
     2542   function GetCodeTextError returns character
     2543   (iCheckType as character,
     2544    iCodeErr   as character,
     2545    iChechObj  as character,
     2546    output oCode as character,
     2547    output ovalue as character ):
     2548      define buffer code    for code.
     2549      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2550                        and code.code   eq iCodeErr
     2551      no-lock no-error.
     2552      if     available code
     2553      then do:
     2554         define variable vi as integer no-undo init ?.
     2555         vi = int(Code.misc3) no-error.
     2556         if    code.misc3 ne "error"
     2557            and vi ne 0
     2558         then
     2559            oCode = ?.
     2560         else if     Code.misc1 ne ?
     2561                 and Code.misc1 ne ""
     2562         then
     2563            assign
     2564               oCode  = GetMesError(Code.misc1,iChechObj)
     2565               ovalue = GetMesError(Code.misc2,iChechObj)
     2566            .
     2567      end.
     2568      return if oCode eq ""
     2569             then ""
     2570             else (oCode + "_" + ovalue).
     2571   end.
     2572   define temp-table TT-err no-undo
     2573     field code_ as character
     2574     field text_ as character
     2575   index code_ code_.
     2576   function GetErrTxtForUtd returns character
     2577   (idb-num         as integer ,
     2578    idoc-id         as integer ,
     2579    iCheckType      as character
     2580    ):
     2581      define buffer utd-err for utd-err.
     2582      define variable vHQry as handle no-undo.
     2583      define variable oError as character no-undo.
     2584      create query vHQry.
     2585      define variable vi as integer no-undo.
     2586      for each tt-err :
     2587         delete tt-err.
     2588      end.
     2589      vHQry:set-buffers(buffer utd-err:handle).
     2590      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2591                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2592                               + if    iCheckType eq "*"
     2593                                    or iCheckType eq ?
     2594                                 then       ""
     2595                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2596      vHQry:query-open().
     2597      vHQry:get-first().
     2598      define variable vcode as character no-undo.
     2599      define variable vvalue as character no-undo.
     2600      QRY-BLOCK:
     2601      repeat while not vHQry:query-off-end:
     2602         vi = vi + 1.
     2603         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2604         if vcode ne ?
     2605         then do:
     2606            find first tt-err where tt-err.code eq vcode
     2607            no-error.
     2608            if not available tt-err
     2609            then do:
     2610               create tt-err.
     2611               assign
     2612                  tt-err.code_ = vcode
     2613                  tt-err.text_ = vvalue
     2614               .
     2615            end.
     2616            else
     2617               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2618         end.
     2619         vHQry:get-next().
     2620      end.
     2621     find first utd where utd.db-num eq idb-num
     2622                         and utd.doc-id eq idoc-id
     2623         no-lock.
     2624      define buffer cancel_utd-lines for utd-lines.
     2625      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2626                                  and cancel_utd-lines.doc-id eq idoc-id
     2627      no-lock:
     2628         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2629         then do:
     2630            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2631                                        and utd-marking-lines.doc-id eq idoc-id
     2632                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2633            no-lock,
     2634               first marking where marking.mark eq utd-marking-lines.mark
     2635                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2636            no-lock:
     2637               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2638               find first tt-err where tt-err.code eq vcode
     2639               no-error.
     2640               if not available tt-err
     2641               then do:
     2642                  create tt-err.
     2643                  assign
     2644                     tt-err.code_ = vcode
     2645                     tt-err.text_ = vvalue
     2646                  .
     2647               end.
     2648               else
     2649                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2650            end.
     2651         end.
     2652         else do:
     2653            define variable vqnty as decimal no-undo.
     2654            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2655            if vqnty eq ? then vqnty = 0.
     2656            if vqnty ne cancel_utd-lines.Quantity
     2657            then do:
     2658               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2659               find first tt-err where tt-err.code eq vcode
     2660               no-error.
     2661               if not available tt-err
     2662               then do:
     2663                  create tt-err.
     2664                  assign
     2665                     tt-err.code_ = vcode
     2666                     tt-err.text_ = vvalue
     2667                  .
     2668               end.
     2669               else
     2670                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2671            end.
     2672         end.
     2673      end.
     2674      for each tt-err:
     2675         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2676      end.
     2677      return oError.
     2678   end.
     2679   define variable mFormatErr as character no-undo init "text".
     2680   function GetErrForUtd returns character
     2681   (idb-num         as integer ,
     2682    idoc-id         as integer ,
     2683    iType           as character
     2684    ):
     2685      if mFormatErr eq "text"
     2686      then
     2687         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2688      else do:
     2689         if itype eq "return"
     2690         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2691         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2692      end.
     2693   end.
     2694   function GetErrComText returns longchar
     2695   (icomment as character,
     2696    itext    as longchar ):
     2697       define variable vText as longchar no-undo.
     2698      if mFormatErr eq "text"
     2699      then do:
     2700         if icomment ne ""
     2701         then
     2702            icomment = substitute("comment:|&1|",icomment).
     2703         vText = icomment + itext.
     2704      end.
     2705      else do:
     2706         icomment = if icomment begins  '"'
     2707                    then icomment
     2708                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2709         vText = icomment + "," + itext.
     2710         vText = "~{" + trim(vText,",") + "~}".
     2711      end.
     2712      return vText.
     2713   end.
     2714   function CheckTypeForMarkLineType returns logical
     2715   (iObj            as handle,
     2716    iCheckType      as character,
     2717    iCodeErr        as character ,
     2718    iTypeErr        as character ):
     2719      define variable vRecKey-markLine as character no-undo.
     2720      define variable vGoodMark        as logical no-undo.
     2721      define variable vdb-num          as integer no-undo.
     2722      define variable vdoc-id          as integer no-undo.
     2723      define variable vlinenum         as integer no-undo.
     2724      define variable vErrorOne as character no-undo.
     2725      define buffer buf_utd-err for utd-err.
     2726      run gen-key-rec (input "utd-marking-lines",
     2727                       input  iObj,
     2728                       output vRecKey-markLine).
     2729      vGoodMark = yes.
     2730      vdb-num = iObj::db-num.
     2731      vdoc-id = iObj::doc-id.
     2732      vlinenum = iObj::linenum.
     2733      block-mark-err:
     2734      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2735                               and buf_utd-err.db-num = vdb-num
     2736                               and buf_utd-err.reckey = vRecKey-markLine
     2737                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2738                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2739      no-lock:
     2740         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2741         if     vErrorOne ne ?
     2742            and vErrorOne ne ""
     2743         then do:
     2744            vGoodMark = no.
     2745            leave block-mark-err.
     2746         end.
     2747      end.
     2748      return not vGoodMark.
     2749   end.
     2750   function CheckErrForMarkLineType returns logical
     2751   (iObj            as handle,
     2752    iType           as character  ):
     2753      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2754   end.
     2755   function CheckErrForMarkLine returns logical
     2756   (iObj            as handle):
     2757      return CheckErrForMarkLineType(iObj,"*").
     2758   end.
     2759   function CheckErrForLineTypeCode returns logical
     2760   (iObj                 as handle,
     2761    iCheckType           as character,
     2762    iCodeErr             as character,
     2763    iTypeErr             as character,
     2764    iOneErr              as logical):
     2765      define variable vRecKey-line     as character no-undo.
     2766      define buffer buf_utd-err for utd-err.
     2767      define variable vUtdlineError as logical no-undo.
     2768      define variable vErrorOne as character no-undo.
     2769            run gen-key-rec (input "utd-lines",
     2770                             input  iObj,
     2771                             output vRecKey-line).
     2772         define variable vdb-num as integer no-undo.
     2773         define variable vdoc-id as integer no-undo.
     2774         define variable vlinenum as integer no-undo.
     2775         vdb-num = iObj::db-num.
     2776         vdoc-id = iObj::doc-id.
     2777         vlinenum = iObj::linenum.
     2778         block-err:
     2779         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2780                                  and buf_utd-err.db-num = vdb-num
     2781                                  and buf_utd-err.reckey = vRecKey-line
     2782                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2783                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2784         no-lock:
     2785            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2786            if     vErrorOne ne ?
     2787               and vErrorOne ne ""
     2788            then do:
     2789               vUtdlineError = yes.
     2790               leave block-err.
     2791            end.
     2792         end.
     2793         if  not vUtdlineError
     2794         then do:
     2795            define variable vGoodMark as logical no-undo.
     2796            vGoodMark = yes.
     2797            block-line-err:
     2798            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2799                                         and utd-marking-lines.doc-id  eq vdoc-id
     2800                                         and utd-marking-lines.LineNum eq vLineNum
     2801            no-lock:
     2802               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2803               if     vGoodMark
     2804                  and iOneErr eq no
     2805               then
     2806                  leave block-line-err.
     2807               if     iOneErr = yes
     2808                  and not vGoodMark
     2809               then
     2810                  leave block-line-err.
     2811            end.
     2812            vUtdlineError = not vGoodMark.
     2813         end.
     2814      return vUtdlineError.
     2815   end.
     2816   function getErrForLineType returns character
     2817   (iObj            as handle,
     2818    iType           as character  ):
     2819      define variable vRecKey-line     as character no-undo.
     2820      define buffer buf_utd-err for utd-err.
     2821      define variable vUtdlineError as logical no-undo.
     2822      define variable vErrorOne as character no-undo.
     2823      define variable oError as character no-undo.
     2824            run gen-key-rec (input "utd-lines",
     2825                             input  iObj,
     2826                             output vRecKey-line).
     2827         define variable vdb-num as integer no-undo.
     2828         define variable vdoc-id as integer no-undo.
     2829         define variable vlinenum as integer no-undo.
     2830         vdb-num = iObj::db-num.
     2831         vdoc-id = iObj::doc-id.
     2832         vlinenum = iObj::linenum.
     2833         block-err:
     2834         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2835                                  and buf_utd-err.db-num = vdb-num
     2836                                  and buf_utd-err.reckey = vRecKey-line
     2837                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2838         no-lock:
     2839            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2840            if     vErrorOne ne ?
     2841               and vErrorOne ne ""
     2842            then do:
     2843               oError = oError + vErrorOne + " ".
     2844            end.
     2845         end.
     2846      return oError.
     2847   end.
     2848   function CheckErrForLineType returns logical
     2849   (iObj            as handle,
     2850    iType           as character  ):
     2851       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2852   end.
     2853   function CheckErrForLine returns logical
     2854   (iObj            as handle):
     2855      return CheckErrForLineType(iobj,"*").
     2856   end.
     2857   function CheckErrForUtd returns logical
     2858   (idb-num         as integer ,
     2859    idoc-id         as integer ):
     2860      for each utd-lines where utd-lines.db-num eq idb-num
     2861                           and utd-lines.doc-id eq idoc-id
     2862      no-lock :
     2863         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2864         then
     2865            return no.
     2866      end.
     2867      return yes.
     2868   end.
     2869   function CheckMarkUtd-28rel return logical
     2870    (input idb-num as integer,
     2871    input idoc-id as integer):
     2872    define buffer utd                   for utd.
     2873    define buffer utd-lines             for utd-lines.
     2874    define buffer utd-marking-lines     for utd-marking-lines.
     2875    define variable v-par-type as character no-undo.
     2876    define variable vgdsNoMark as logical no-undo.
     2877    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2878      define variable v-par-val  as character no-undo.
     2879      find first utd where utd.db-num eq idb-num
     2880                       and utd.doc-id eq idoc-id
     2881      no-lock no-error.
     2882      if available utd
     2883      then do:
     2884         if     utd.obj-code ne ?
     2885            and utd.obj-type ne ?
     2886         then do:
     2887            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2888            Block-utd-lines:
     2889            for each utd-lines where utd-lines.db-num eq idb-num
     2890                                 and utd-lines.doc-id eq idoc-id
     2891            no-lock:
     2892               if     utd-lines.gds-code ne ?
     2893                  and utd-lines.gds-code ne 0
     2894               then do:
     2895                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2896                       ( utd-lines.gds-code,
     2897                         'mark-type':U,
     2898                          output v-par-val,
     2899                          output v-par-type
     2900                       ).
     2901                  if     EDOParSec:IsEdo
     2902                     and EDOParSec:GetIsEDOForType(v-par-val)
     2903                  then do:
     2904                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2905                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2906                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2907                                                    and length(utd-marking-lines.mark) > 13
     2908                     no-lock no-error.
     2909                     if     avail utd-marking-lines
     2910                        and not CheckErrForLine(buffer utd-lines:handle)
     2911                     then
     2912                        leave Block-utd-lines.
     2913                  end.
     2914                  else
     2915                     vgdsNoMark = yes.
     2916               end.
     2917            end.
     2918            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2919            if vgdsNoMark then return available utd-lines . else return yes .
     2920         end.
     2921      end.
     2922      return yes.
     2923   end.
     2924   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2925   define temp-table tt-utd-mark no-undo like utd-marking-lines
     2926     field side as character.
     2927   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2928   function CheckMarkUtd return logical
     2929    (input idb-num  as integer,
     2930     input idoc-id  as integer):
     2931     define buffer utd-lines             for ub.utd-lines.
     2932     block-line:
     2933     for each utd-lines where utd-lines.db-num eq idb-num
     2934                          and utd-lines.doc-id eq idoc-id
     2935     no-lock:
     2936        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2937        then
     2938           leave block-line.
     2939     end.
     2940     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2941     return available utd-lines.
     2942   end.
     2943   function CheckNotMarkUtd return logical
     2944    (input idb-num  as integer,
     2945     input idoc-id  as integer):
     2946     define buffer utd-lines             for ub.utd-lines.
     2947     for each utd-lines where utd-lines.db-num eq idb-num
     2948                          and utd-lines.doc-id eq idoc-id
     2949     no-lock:
     2950        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2951        then
     2952           return yes.
     2953     end.
     2954     return no.
     2955   end.
     2956   function CheckMarkUtdLine return logical
     2957    (input idb-num  as integer,
     2958     input idoc-id  as integer,
     2959     input iLineNum as integer):
     2960    define buffer utd                   for utd.
     2961    define buffer utd-lines             for utd-lines.
     2962    define buffer utd-marking-lines     for utd-marking-lines.
     2963    define variable v-par-type as character no-undo.
     2964    define variable vMarking        as logical no-undo.
     2965    define variable vArtic          as logical no-undo.
     2966    define variable vTransitional   as logical no-undo.
     2967    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2968      define variable v-par-val  as character no-undo.
     2969      find first utd where utd.db-num eq idb-num
     2970                       and utd.doc-id eq idoc-id
     2971      no-lock no-error.
     2972      if available utd
     2973      then do:
     2974         if     utd.obj-code ne ?
     2975            and utd.obj-type ne ?
     2976         then do:
     2977            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2978            Block-utd-lines:
     2979            for each utd-lines where utd-lines.db-num   eq idb-num
     2980                                 and utd-lines.doc-id   eq idoc-id
     2981                                 and utd-lines.LineNum  eq iLineNum
     2982            no-lock:
     2983               if     utd-lines.gds-code ne ?
     2984                  and utd-lines.gds-code ne 0
     2985               then do:
     2986                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2987                       ( utd-lines.gds-code,
     2988                         'mark-type':U,
     2989                          output v-par-val,
     2990                          output v-par-type
     2991                       ).
     2992                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2993                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2994                  if vMarking
     2995                  then do:
     2996                     block-marking:
     2997                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2998                                                    and utd-marking-lines.doc-id   eq idoc-id
     2999                                                    and utd-marking-lines.LineNum  eq iLineNum
     3000                                                    and length(utd-marking-lines.mark) > 13
     3001                     no-lock:
     3002                        if isOAD(utd-marking-lines.mark)
     3003                        then do:
     3004                           assign
     3005                              vArtic   = yes
     3006                              vMarking = no
     3007                           .
     3008                           leave block-marking.
     3009                        end.
     3010                     end.
     3011                  end.
     3012                  if vArtic
     3013                  then do:
     3014                     block-artic:
     3015                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3016                                                    and utd-marking-lines.doc-id   eq idoc-id
     3017                                                    and utd-marking-lines.LineNum  eq iLineNum
     3018                                                    and length(utd-marking-lines.mark) > 13
     3019                     no-lock:
     3020                        if isMark(utd-marking-lines.mark)
     3021                        then do:
     3022                           assign
     3023                              vArtic   = no
     3024                              vMarking = yes
     3025                           .
     3026                           leave block-artic.
     3027                        end.
     3028                     end.
     3029                  end.
     3030                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3031                  if vTransitional
     3032                  then do:
     3033                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3034                                                    and utd-marking-lines.doc-id   eq idoc-id
     3035                                                    and utd-marking-lines.LineNum  eq iLineNum
     3036                                                    and length(utd-marking-lines.mark) > 13
     3037                     no-lock no-error.
     3038                     if not available utd-marking-lines
     3039                     then assign
     3040                        vMarking = no
     3041                        vArtic   = no
     3042                     .
     3043                  end.
     3044               end.
     3045               else
     3046                  assign
     3047                     vMarking      = yes
     3048                     vArtic        = no
     3049                     vTransitional = no
     3050                  .
     3051               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3052               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3053               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3054            end.
     3055         end.
     3056      end.
     3057      return vMarking or vArtic.
     3058   end.
     3059   function getMarkUtdLine return logical
     3060    (input  idb-num  as integer,
     3061     input  idoc-id  as integer,
     3062     input  iLineNum as integer,
     3063     output oMarking        as logical,
     3064     output oArtic          as logical,
     3065     output oTransitional   as logical):
     3066     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3067     oArtic        = not oMarking
     3068            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3069     oTransitional = (oMarking or oArtic)
     3070            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3071   end.
     3072   function CheckMarking return logical
     3073    (input idb-num as integer,
     3074    input idoc-id as integer,
     3075    input iTypeErr as character ):
     3076     define variable vMarkutd as logical no-undo.
     3077     define variable vCrErr   as logical no-undo.
     3078     define buffer utd-lines         for utd-lines.
     3079     define buffer utd-marking-lines for utd-marking-lines.
     3080     define buffer marking           for marking.
     3081     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3082      block-line:
     3083      for each utd-lines where utd-lines.db-num eq idb-num
     3084                           and utd-lines.doc-id eq idoc-id
     3085      no-lock:
     3086         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3087         then do:
     3088            for each utd-marking-lines
     3089                     where utd-marking-lines.db-num  = utd-lines.db-num
     3090                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3091                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3092            no-lock:
     3093               if isMark(utd-marking-lines.mark)
     3094               then do:
     3095                  find first marking where marking.mark eq utd-marking-lines.mark
     3096                  no-lock no-error.
     3097                  if not available marking
     3098                  then do:
     3099                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3100                     vCrErr = yes.
     3101                     next block-line.
     3102                  end.
     3103               end.
     3104            end.
     3105         end.
     3106      end.
     3107      return vCrErr.
     3108   end.
     3109   function CheckMarkForType return logical
     3110    (input idb-num   as integer,
     3111     input idoc-id   as integer):
     3112      define variable vMarking        as logical no-undo.
     3113      define variable vArtic          as logical no-undo.
     3114      define variable vTransitional   as logical no-undo.
     3115      define buffer utd-lines         for utd-lines.
     3116      define buffer utd-marking-lines for utd-marking-lines.
     3117      block-line:
     3118      for each utd-lines where utd-lines.db-num eq idb-num
     3119                           and utd-lines.doc-id eq idoc-id
     3120      no-lock:
     3121         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3122                          output vMarking         , output vArtic          , output vTransitional).
     3123         for each utd-marking-lines
     3124                     where utd-marking-lines.db-num  = utd-lines.db-num
     3125                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3126                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3127         no-lock:
     3128            if length(utd-marking-lines.mark) < 14
     3129            then do:
     3130               if (vMarking or vArtic) and not vTransitional
     3131               then
     3132                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3133            end.
     3134            else if not isMark(utd-marking-lines.mark)
     3135            then do:
     3136               if vMarking
     3137               then
     3138                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3139            end.
     3140            else do:
     3141            end.
     3142         end.
     3143      end.
     3144   end.
     3145   function WeighedProd return logical
     3146      ( input p-gds-code as integer) :
     3147      define variable v-par-val  as character no-undo.
     3148      define variable v-par-type as character no-undo.
     3149              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3150               ( p-gds-code,
     3151                 'weighed-gds':U,
     3152                  output v-par-val,
     3153                  output v-par-type
     3154               ).
     3155      return logical(v-par-val).
     3156   end.
     3157   function WghProdVariable return logical
     3158       (input p-obj-type as char,
     3159        input p-obj-code as integer,
     3160        input p-gds-code as integer) :
     3161      define variable v-wgh-val  as character no-undo.
     3162      define variable v-par-val  as character no-undo.
     3163      define variable v-par-type as character no-undo.
     3164      define variable vMarking        as logical no-undo.
     3165      define variable vArtic          as logical no-undo.
     3166      define variable vTransitional   as logical no-undo.
     3167      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3168         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3169           ( p-gds-code,
     3170             'weighed-gds':U,
     3171              output v-wgh-val,
     3172              output v-par-type
     3173           ).
     3174       if logical(v-wgh-val) = yes then do:
     3175           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3176               ( p-gds-code,
     3177                 'mark-type':U,
     3178                  output v-par-val,
     3179                  output v-par-type
     3180               ).
     3181           if v-par-val <> "" then do:
     3182               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3183               assign
     3184                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3185                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3186                  .
     3187           end.
     3188      end.
     3189      if v-wgh-val > "" and (vMarking or vArtic)
     3190      then return yes.
     3191      else return no.
     3192   end.
     3193   function MarkWeight return decimal
     3194      ( input p-mark as character) :
     3195      define buffer  buf_marking-attr for  ub.marking-attr.
     3196      define variable vMarkWeight as decimal no-undo.
     3197      vMarkWeight = 0.
     3198      if p-mark <> "" and p-mark <> ?
     3199      then do:
     3200          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3201                                        and buf_marking-attr.attr-code eq "weight"
     3202             no-lock no-error.
     3203          if not available buf_marking-attr
     3204          then do :
     3205            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3206                                          and buf_marking-attr.attr-code eq "weight"
     3207               no-lock no-error.
     3208          end .
     3209          if avail buf_marking-attr
     3210          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3211      end.
     3212      return vMarkWeight.
     3213   end.
     3214   function CheckQnty returns logical
     3215   (  input idb-num  as integer,
     3216      input idoc-id  as integer,
     3217      input iErrType as character
     3218   ):
     3219      if iErrType ne "loadUTD"
     3220      then do:
     3221         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3222         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3223         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3224      end.
     3225      if iErrType ne "CheckQnty"
     3226      then do:
     3227         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3228         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3229         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3230      end.
     3231      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3232      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3233      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3234      define buffer marking               for marking.
     3235      define buffer utd-lines             for utd-lines.
     3236      define buffer utd-marking-lines     for utd-marking-lines.
     3237      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3238      block-line:
     3239      for each utd-lines where utd-lines.db-num eq idb-num
     3240                           and utd-lines.doc-id eq idoc-id
     3241      no-lock:
     3242         define variable Vflagmark as logical no-undo.
     3243         find first buf_utd-marking-lines
     3244                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3245                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3246                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3247                         and length(buf_utd-marking-lines.mark) > 13
     3248         no-lock no-error.
     3249         if not available buf_utd-marking-lines
     3250         then
     3251            next block-line.
     3252         define variable vqntyMark as integer no-undo.
     3253         define variable vqntyOAD  as integer no-undo.
     3254         vqntyMark = 0.
     3255         vqntyOAD  = 0.
     3256         block-mark:
     3257         for each utd-marking-lines
     3258              where utd-marking-lines.db-num  = utd-lines.db-num
     3259                and utd-marking-lines.doc-id  = utd-lines.doc-id
     3260                and utd-marking-lines.LineNum = utd-lines.LineNum
     3261                and length(utd-marking-lines.mark) > 13
     3262                and utd-marking-lines.doc-level  = 1
     3263         no-lock:
     3264            if isMark(utd-marking-lines.mark)
     3265            then do:
     3266               find first marking where marking.mark eq utd-marking-lines.mark
     3267               no-lock no-error.
     3268               if available marking
     3269               then do:
     3270                  if marking.box-qnty ne ?
     3271                  then
     3272                     vqntyMark = vqntyMark + marking.box-qnty.
     3273               end.
     3274            end.
     3275            else do:
     3276               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     3277                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     3278                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     3279                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     3280                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     3281               no-lock no-error.
     3282               if available utd-marking-lines-attr
     3283               then
     3284                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     3285            end.
     3286         end.
     3287         if     utd-lines.gds-code   gt 0
     3288            and utd-lines.gds-code   ne ?
     3289            and vqntyMark            ne 0
     3290         then do:
     3291            if utd-lines.Quantity  < vqntyMark
     3292            then
     3293               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3294            else if utd-lines.Quantity  <> vqntyMark
     3295            then
     3296               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3297         end.
     3298         else if     utd-lines.gds-code   gt 0
     3299            and utd-lines.gds-code   ne ?
     3300            and vqntyOAD ne 0
     3301            and utd-lines.Quantity  ne vqntyOAD
     3302         then
     3303            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     3304      end.
     3305   end.
     3306   function CheckGds returns logical
     3307   (  input idb-num   as integer,
     3308      input idoc-id   as integer,
     3309      input iobj-type as character,
     3310      input iobj-code as integer,
     3311      input iErrType as character
     3312   ):
     3313      if iErrType ne "loadUTD"
     3314      then do:
     3315         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     3316         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     3317         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     3318         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3319         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     3320         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     3321         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     3322         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     3323         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     3324         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     3325         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     3326      end.
     3327      if iErrType ne "CheckGds"
     3328      then do:
     3329         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     3330         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     3331         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     3332         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     3333         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     3334         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     3335         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     3336         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     3337         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     3338         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     3339         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     3340      end.
     3341      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     3342      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     3343      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     3344      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3345      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     3346      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     3347      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     3348      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     3349      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     3350      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     3351      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     3352      define variable v-par-type as character no-undo.
     3353      define variable v-par-val  as character no-undo.
     3354      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3355      define buffer marking               for marking.
     3356      define buffer utd-lines             for utd-lines.
     3357      define buffer buf_utd-lines         for utd-lines.
     3358      define buffer utd-marking-lines     for utd-marking-lines.
     3359      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3360      define variable vGdsCode as integer no-undo.
     3361      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     3362      block-line:
     3363      for each utd-lines where utd-lines.db-num eq idb-num
     3364                           and utd-lines.doc-id eq idoc-id
     3365      no-lock:
     3366         vGdsCode = ?.
     3367         define variable Vflagmark as logical no-undo.
     3368         define variable VflagOAD  as logical no-undo.
     3369         assign
     3370            Vflagmark = no
     3371            VflagOAD = no
     3372         .
     3373         block-mark:
     3374         for each utd-marking-lines
     3375                  where utd-marking-lines.db-num  = utd-lines.db-num
     3376                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3377                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3378         no-lock:
     3379            if    isMark(utd-marking-lines.mark)
     3380               or isOAD (utd-marking-lines.mark)
     3381            then do:
     3382               define variable vnewGdsCode as integer no-undo.
     3383               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     3384               if isMark(utd-marking-lines.mark)
     3385               then do:
     3386                  Vflagmark = yes.
     3387                  find first marking where marking.mark eq utd-marking-lines.mark
     3388                  no-lock no-error.
     3389                  if not available marking
     3390                  then do:
     3391                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     3392                     next block-mark.
     3393                  end.
     3394                  if vnewGdsCode eq ?
     3395                  then
     3396                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     3397                  if    marking.gds-code eq 0
     3398                     or marking.gds-code eq ?
     3399                     or marking.sts eq 0
     3400                     or marking.sts eq ?
     3401                     or marking.box-qnty eq ?
     3402                     or (marking.gds-code ne vnewGdsCode
     3403                         and vnewGdsCode ne ?
     3404                         and vnewGdsCode ne 0)
     3405                  then do:
     3406                     find first marking where marking.mark eq utd-marking-lines.mark
     3407                     exclusive-lock no-error.
     3408                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     3409                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     3410                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     3411                     if    marking.gds-ext-id eq ""
     3412                        or marking.gds-ext-id eq ?
     3413                     then do:
     3414                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     3415                     end.
     3416                     else if    marking.gds-code eq 0
     3417                             or marking.gds-code eq ?
     3418                     then
     3419                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     3420                     else if     marking.sts eq 0
     3421                             or  marking.sts eq ?
     3422                     then
     3423                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     3424                  end.
     3425                  if utd-marking-lines.doc-level eq 1
     3426                  then do:
     3427                     if marking.box-qnty eq ?
     3428                     then
     3429                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3430                  end.
     3431               end.
     3432               else do:
     3433                  VflagOAD = yes.
     3434                  define variable vQnty as decimal no-undo.
     3435                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     3436                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     3437                                          utd-marking-lines.doc-id,
     3438                                          utd-marking-lines.LineNum,
     3439                                          utd-marking-lines.mark,
     3440                                          "box-qnty",
     3441                                           string(vQnty)).
     3442                  define variable vgtin as character no-undo.
     3443                  vgtin = getGtinByDM(utd-marking-lines.mark).
     3444                  if getQntyCodeByGtin(vgtin) ne 1
     3445                  then
     3446                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     3447               end.
     3448               if utd-marking-lines.gds-code ne vnewGdsCode
     3449               and vnewGdsCode ne ?
     3450               and vnewGdsCode ne 0
     3451               then do:
     3452                  find first buf_utd-marking-lines
     3453                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3454                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3455                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3456                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3457                  exclusive-lock no-error.
     3458                  if available buf_utd-marking-lines
     3459                  then do:
     3460                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     3461                  end.
     3462               end.
     3463            end.
     3464            else  do:
     3465               define variable vgdsbar as integer no-undo.
     3466               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     3467               if    utd-marking-lines.gds-code ne vgdsbar
     3468               then do:
     3469                  find first buf_utd-marking-lines
     3470                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3471                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3472                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3473                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3474                  exclusive-lock no-error.
     3475                  if available buf_utd-marking-lines
     3476                  then do:
     3477                     buf_utd-marking-lines.gds-code = vgdsbar.
     3478                  end.
     3479               end.
     3480               if vgdsbar ne ?
     3481               then do:
     3482                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3483                            ( vgdsbar,
     3484                              'mark-type':U,
     3485                              output v-par-val,
     3486                              output v-par-type
     3487                             ).
     3488                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     3489                       or  EDOParSec:GetIsArticForType(v-par-val))
     3490                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     3491                   and     EDOParSec:IsEdo
     3492                  then do:
     3493                     AddUtdErr(utd-marking-lines.db-num,
     3494                               utd-marking-lines.doc-id,
     3495                               buffer utd-marking-lines:handle,
     3496                               iErrType,
     3497                               "MarkingForTypeEDO",
     3498                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3499                  end.
     3500               end.
     3501            end.
     3502            if vGdsCode eq ?
     3503            then
     3504               vGdsCode = utd-marking-lines.gds-code.
     3505            if vGdsCode ne utd-marking-lines.gds-code
     3506            and utd-marking-lines.gds-code > 0
     3507            then do:
     3508               vGdsCode = -1.
     3509            end.
     3510         end.
     3511         if  vGdsCode = -1
     3512         then do:
     3513            vGdsCode = ?.
     3514            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     3515            next block-line.
     3516         end.
     3517         if vGdsCode ne ?
     3518         then do:
     3519                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3520                      ( vGdsCode,
     3521                        'mark-type':U,
     3522                        output v-par-val,
     3523                        output v-par-type
     3524                       ).
     3525            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     3526                and(
     3527                 (    EDOParSec:GetIsEDOForType(v-par-val)
     3528                     and not Vflagmark)
     3529                 or  (EDOParSec:GetIsArticForType(v-par-val)
     3530                     and not VflagOAD
     3531                     and not Vflagmark))
     3532            then do:
     3533               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     3534            end.
     3535         end.
     3536         if utd-lines.gds-code ne vGdsCode
     3537         then do:
     3538            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3539                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3540                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     3541            exclusive-lock no-error.
     3542            if available buf_utd-lines
     3543            then
     3544               buf_utd-lines.gds-code = vGdsCode.
     3545            release buf_utd-lines.
     3546         end.
     3547         define variable VBarCode as character no-undo.
     3548         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     3549         if VBarCode ne ?
     3550         then do:
     3551            if num-entries(VBarCode," ") > 0
     3552            then
     3553               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     3554            vgdsbar = GetGdsCodeByGtin(VBarCode).
     3555            if vgdsbar eq ? or vgdsbar eq 0
     3556            then do:
     3557               AddUtdErr(utd-lines.db-num,
     3558                         utd-lines.doc-id,
     3559                         buffer utd-lines:handle,
     3560                         iErrType,
     3561                         "NotFindGdsForBarCode",
     3562                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     3563            end.
     3564            else do:
     3565               if    utd-lines.gds-code eq ?
     3566                  or utd-lines.gds-code eq 0
     3567               then do:
     3568                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3569                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3570                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3571                  exclusive-lock no-error.
     3572                  if available buf_utd-lines
     3573                  then
     3574                     buf_utd-lines.gds-code = vgdsbar.
     3575                  release buf_utd-lines.
     3576               end.
     3577               else if utd-lines.gds-code ne vgdsbar
     3578               then do:
     3579                  AddUtdErr(utd-lines.db-num,
     3580                         utd-lines.doc-id,
     3581                         buffer utd-lines:handle,
     3582                         iErrType,
     3583                         "NotEqGgsForLineAndMark",
     3584                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     3585               end.
     3586            end.
     3587         end.
     3588         if vGdsCode eq ? and utd-lines.gds-code eq ?
     3589         then
     3590            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     3591      end.
     3592   end.
     3593   function GetUtdLineForOrig return logical
     3594   (input idb-num as integer,
     3595    input idoc-id as integer,
     3596    input ilineNum as integer,
     3597    input idb-numOrig as integer,
     3598    input idoc-idOrig as integer,
     3599    buffer edoc-lines for utd-lines):
     3600      define buffer edoc-marking-lines for ub.utd-marking-lines.
     3601      block-mark:
     3602      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     3603                                   and utd-marking-lines.doc-id  eq idoc-id
     3604                                   and utd-marking-lines.LineNum eq iLineNum
     3605                                   and utd-marking-lines.site eq "-"
     3606      no-lock:
     3607         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     3608                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     3609                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3610                     no-lock no-error.
     3611         if available edoc-marking-lines
     3612         then do:
     3613            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3614                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3615                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3616            no-lock no-error.
     3617               leave block-mark.
     3618          end.
     3619      end.
     3620       if not available edoc-lines
     3621       then do:
     3622          find  first  utd-lines where utd-lines.db-num      = idb-num
     3623                                   and utd-lines.doc-id      = idoc-id
     3624                                   and utd-lines.LineNum     = ilinenum
     3625             no-lock no-error.
     3626          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3627                                  and edoc-lines.doc-id      = idoc-idOrig
     3628                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3629          no-lock no-error.
     3630       end.
     3631       if not available edoc-lines
     3632       then
     3633          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3634                                  and edoc-lines.doc-id      = idoc-idOrig
     3635                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3636          no-lock no-error.
     3637   end.
     3638   function GetLastUTDinPack returns logical
     3639   (input idb-num as integer,
     3640    input idoc-id as integer,
     3641    output odb-num as integer,
     3642    output odoc-id as integer ) forward.
     3643   function getObgFns return logical
     3644   (input iDocumentNumber   as character ,
     3645    input iFnsParticipantId as character ,
     3646    input ikpp              as character ,
     3647    output ohost-code       as integer,
     3648    output oobj-type        as character ,
     3649    output oobj-code        as integer ,
     3650    output otext            as character  ):
     3651       define buffer ext-classif   for ext-classif.
     3652       define buffer clients       for clients.
     3653       define buffer buf_clients   for clients.
     3654       define buffer clients-attr  for clients-attr.
     3655       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3656                                and ext-classif.charkey_three eq iFnsParticipantId
     3657       no-lock no-error.
     3658       if available ext-classif
     3659       then do:
     3660          if ext-classif.CharKey_One eq 'маг':U
     3661          then do:
     3662             assign
     3663                oobj-type = ext-classif.CharKey_One
     3664                oobj-code = ext-classif.Key#_One
     3665             .
     3666             find first clients
     3667                  where clients.obj-type   = ext-classif.CharKey_One
     3668                    and clients.obj-code   = ext-classif.Key#_One
     3669             no-lock no-error .
     3670             if available clients
     3671             then
     3672                ohost-code =  clients.host-code.
     3673          end.
     3674          else do:
     3675             find first clients
     3676                  where clients.obj-type   = ext-classif.CharKey_One
     3677                    and clients.obj-code   = ext-classif.Key#_One
     3678                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3679             no-lock no-error .
     3680             if not available clients
     3681             then do:
     3682                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3683                return no.
     3684             end.
     3685             ohost-code = ext-classif.Key#_One.
     3686             block-cl:
     3687             for each clients-attr
     3688                where clients-attr.attr-code  = 'kpp':U
     3689                  and clients-attr.obj-type   = 'маг':U
     3690                  and clients-attr.attr-value = ikpp
     3691                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3692                                             and buf_clients.obj-code   = clients-attr.obj-code
     3693                                             and buf_clients.host-code  = ohost-code)
     3694             no-lock :
     3695                leave block-cl.
     3696             end.
     3697             if     available clients
     3698                and clients.obj-type eq 'маг':U
     3699             then do:
     3700                assign
     3701                   oobj-type = clients.obj-type
     3702                   oobj-code = clients.obj-code
     3703                .
     3704             end.
     3705             else if available clients-attr
     3706             then do:
     3707                assign
     3708                   oobj-type = clients-attr.obj-type
     3709                   oobj-code = clients-attr.obj-code
     3710                .
     3711             end.
     3712             else do:
     3713                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3714                return yes.
     3715             end.
     3716          end.
     3717       end.
     3718       else do:
     3719          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3720          return no.
     3721       end.
     3722       return ?.
     3723   end.
     3724   function CheckUcdForReturn return logical
     3725   (input idb-numUcd as integer,
     3726    input idoc-idUcd as integer,
     3727    input idb-numRet as integer,
     3728    input idoc-idRet as integer  ):
     3729       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3730                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3731                                    and utd-marking-lines.doc-level eq 1
     3732       no-lock:
     3733          create tt-utd-mark.
     3734          buffer-copy utd-marking-lines to tt-utd-mark
     3735          assign
     3736             tt-utd-mark.side = "+"
     3737          .
     3738       end.
     3739       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3740                                    and utd-marking-lines.doc-id eq idoc-idRet
     3741                                    and utd-marking-lines.doc-level eq 1
     3742       no-lock:
     3743          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3744          no-lock no-error.
     3745          if available tt-utd-mark
     3746          then
     3747             tt-utd-mark.side = "".
     3748          else do:
     3749             create tt-utd-mark.
     3750             buffer-copy utd-marking-lines to tt-utd-mark
     3751             assign
     3752                tt-utd-mark.side = "-"
     3753             .
     3754          end.
     3755       end.
     3756       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3757       no-lock:
     3758          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3759       end.
     3760       for each tt-utd-mark:
     3761          delete tt-utd-mark.
     3762       end.
     3763   end.
     3764   function GetLastUTDinPackAft returns logical
     3765   (input idb-num as integer,
     3766    input idoc-id as integer,
     3767    output odb-num as integer,
     3768    output odoc-id as integer ) forward.
     3769   function SaturateAndCheckUTD return character
     3770   (input idb-num as integer,
     3771    input idoc-id as integer  ):
     3772      define buffer clients-attr          for clients-attr.
     3773      define buffer clients               for clients.
     3774      define buffer Utd                   for Utd.
     3775      define buffer utd_ret               for ub.utd.
     3776      define buffer utd-lines             for utd-lines.
     3777      define buffer buf_utd-lines         for utd-lines.
     3778      define buffer buf_utddoc-lines      for utd-lines.
     3779      define buffer marking               for marking.
     3780      define buffer marking-lines         for marking-lines.
     3781      define buffer utd-marking-lines     for utd-marking-lines.
     3782      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3783      define buffer contract              for contract.
     3784      define buffer old_utd               for Utd.
     3785      define variable vError as character no-undo.
     3786      define variable vGdsCode as integer no-undo.
     3787      define variable vcli-type as character no-undo.
     3788      define variable vcli-code as integer no-undo.
     3789      define variable vhost-code as integer no-undo init ?.
     3790      define variable vcontract-code as integer no-undo.
     3791      define variable vobj-type as character no-undo init ?.
     3792      define variable vobj-code as integer no-undo init ?.
     3793      define variable volddb-num as integer no-undo.
     3794      define variable volddoc-id as integer no-undo.
     3795      define variable vMark as logical no-undo.
     3796      define variable VUcd as logical no-undo.
     3797      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3798      define variable v-par-type as character no-undo.
     3799      define variable v-par-val  as character no-undo.
     3800      define variable VFileMark as logical no-undo.
     3801      define variable vunit     as int no-undo.
     3802      define variable vunitCode as character no-undo.
     3803      define variable vMarkingUtd as logical no-undo.
     3804      find first Utd where utd.db-num eq idb-num
     3805                       and utd.doc-id eq idoc-id
     3806      no-lock no-error.
     3807      if available Utd
     3808      then do:
     3809         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     3810         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     3811         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     3812         assign
     3813               vobj-type  = utd.obj-type
     3814               vobj-code  = utd.obj-code
     3815               vhost-code = utd.host-code
     3816         .
     3817         do:
     3818            define variable vtext       as character no-undo.
     3819            define variable vhost-code1 as integer   no-undo.
     3820            define variable vobj-type1  as character no-undo.
     3821            define variable vobj-code1  as integer   no-undo.
     3822             getObgFns
     3823                       (input utd.DocumentNumber ,
     3824                        input utd.obj-FnsParticipantId ,
     3825                        input utd.obj-kpp,
     3826                        output vhost-code1,
     3827                        output vobj-type1,
     3828                        output vobj-code1,
     3829                        output vtext ).
     3830            assign
     3831               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     3832               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     3833               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     3834            .
     3835            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     3836            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     3837            block-line:
     3838            for each utd-lines where utd-lines.db-num eq utd.db-num
     3839                                 and utd-lines.doc-id eq utd.doc-id
     3840            no-lock:
     3841               vGdsCode =?.
     3842               define variable vNotMarkForLine as logical no-undo.
     3843               vNotMarkForLine = no.
     3844               if not VUcd
     3845               then do:
     3846                  find first utd-marking-lines
     3847                       where utd-marking-lines.db-num  = utd-lines.db-num
     3848                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     3849                         and utd-marking-lines.LineNum = utd-lines.LineNum
     3850                  no-lock no-error.
     3851                  if not available utd-marking-lines
     3852                  then do:
     3853                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     3854                     vNotMarkForLine = yes.
     3855                  end.
     3856               end.
     3857               block-mark:
     3858               for each utd-marking-lines
     3859                  where utd-marking-lines.db-num  = utd-lines.db-num
     3860                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3861                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3862               no-lock:
     3863                  vMark = yes.
     3864                  if     isMark(utd-marking-lines.mark)
     3865                     and utd-marking-lines.gds-code  ne 0
     3866                     and utd-marking-lines.gds-code ne ?
     3867                  then do:
     3868                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3869                           ( utd-marking-lines.gds-code,
     3870                            'mark-type':U,
     3871                            output v-par-val,
     3872                            output v-par-type
     3873                            ).
     3874                      if     not VFileMark
     3875                         and not VUcd
     3876                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     3877                      then do:
     3878                          AddUtdErr(utd.db-num,
     3879                                     utd.doc-id,
     3880                                     buffer utd-marking-lines:handle,
     3881                                     "loadUtd",
     3882                                     "NotON_NSCHFDOPPRMARK",
     3883                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3884                     end.
     3885                  end.
     3886               end.
     3887               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     3888               then do :
     3889                  if     VUcd
     3890                  then do:
     3891                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     3892                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     3893                     if available buf_utddoc-lines
     3894                     then do:
     3895                        vGdsCode = buf_utddoc-lines.gds-code.
     3896                        vunitCode = buf_utddoc-lines.UnitCode.
     3897                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     3898                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3899                        then
     3900                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3901                               "loadUtd",
     3902                               "UcdUnitChangForUtd",
     3903                               string(utd-lines.LineNum )                  + chr(4) +
     3904                               buf_utddoc-lines.UnitCode                   + chr(4) +
     3905                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3906                     end.
     3907                     if     utd-lines.UnitCode ne ?
     3908                        and utd-lines.UnitCode ne ""
     3909                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3910                     then
     3911                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3912                               "loadUtd",
     3913                               "UcdUnitChang",
     3914                               string(utd-lines.LineNum )                  + chr(4) +
     3915                               utd-lines.UnitCode                          + chr(4) +
     3916                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3917                  end.
     3918               end.
     3919               else
     3920                  vGdsCode = utd-lines.gds-code.
     3921               define variable vValText as character no-undo.
     3922               define variable vValDec  as decimal no-undo.
     3923               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     3924               if VValText = ?
     3925               then do:
     3926                  vValDec = utd-lines.Quantity.
     3927                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     3928               end.
     3929               else
     3930                  vValDec = dec(VValText).
     3931               release bar-code .
     3932               if     vGdsCode > 0 and vGdsCode ne ?
     3933               then do:
     3934                  assign
     3935                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     3936                     vunit = ?
     3937                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     3938                  no-error.
     3939                  if vunit ne 0 and vunit ne ?
     3940                  then do:
     3941                     find units where units.OKEI eq vunit no-lock no-error.
     3942                     if available units
     3943                     then
     3944                        vunitCode = units.unit-name.
     3945                  end.
     3946                  find first bar-code where bar-code.gds-code eq vGdsCode
     3947                                        and bar-code.unit-cli eq vUnitCode
     3948                  no-lock no-error.
     3949                  if not available bar-code
     3950                  then
     3951                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3952                               "loadUtd",
     3953                               "Unit",
     3954                               string(utd-lines.LineNum )                  + chr(4) +
     3955                               string(vGdsCode)                            + chr(4) +
     3956                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     3957                               vunitCode).
     3958               end.
     3959               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     3960               then do:
     3961                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3962                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3963                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3964                  exclusive-lock no-error.
     3965                  if available buf_utd-lines
     3966                  then do:
     3967                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     3968                     release buf_utd-lines.
     3969                  end.
     3970               end.
     3971               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     3972               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     3973               if     not VUcd
     3974                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     3975               then
     3976                  vMarkingUtd = yes .
     3977            end.
     3978            if not VUcd
     3979            then
     3980               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     3981            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3982                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     3983            no-lock no-error.
     3984            if available ext-classif
     3985            then
     3986               assign
     3987                  vcli-type = ext-classif.CharKey_One
     3988                  vcli-code = ext-classif.Key#_One
     3989               .
     3990            else do:
     3991               assign
     3992                 vcli-type = ?
     3993                 vcli-code = ?
     3994               .
     3995               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     3996            end.
     3997            find first contract  where contract.host-code eq vhost-code
     3998                                   and contract.cli-type  eq vcli-type
     3999                                   and contract.cli-code  eq vcli-code
     4000                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     4001            no-lock no-error.
     4002            define variable VContractEdo as logical no-undo init yes.
     4003            if available contract
     4004            then do:
     4005               assign
     4006                  VContractEdo = contract.whole-send-news > 0
     4007                  vcontract-code = contract.contract-code
     4008               .
     4009               if not VContractEdo
     4010               then
     4011                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     4012            end.
     4013            else do:
     4014               vcontract-code = ?.
     4015            end.
     4016         end.
     4017         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     4018         then do:
     4019            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     4020         end.
     4021         define variable vdoc-code as character no-undo init ?.
     4022         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4023         then do:
     4024            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4025                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4026                                 and utd_ret.Timestamp             le utd.Timestamp
     4027                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4028            no-lock no-error.
     4029            if available utd_ret
     4030            then do:
     4031               vdoc-code = utd_ret.doc-code.
     4032               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     4033            end.
     4034         end.
     4035      end.
     4036      find current utd exclusive-lock no-error.
     4037      if available utd
     4038      then do:
     4039         assign
     4040            utd.cli-type      = vcli-type      when vcli-type      ne ?
     4041            utd.cli-code      = vcli-code      when vcli-type      ne ?
     4042            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     4043            utd.contract-code = vcontract-code when vcontract-code ne ?
     4044            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     4045            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     4046            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     4047         .
     4048         if   ( utd.contract-code eq ?
     4049            or utd.contract-code eq 0)
     4050            and not vucd
     4051         then
     4052            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     4053         if utd.host-code eq ?
     4054            or utd.host-code eq 0
     4055         then
     4056            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     4057         if utd.obj-code eq ?
     4058            or utd.obj-code eq 0
     4059         then
     4060            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     4061      end.
     4062      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     4063      if vError eq ""
     4064      then do:
     4065         if utd.sts eq 0 or utd.sts eq ?
     4066         then
     4067            utd.sts = if VUcd
     4068                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     4069                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4070         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     4071         then do:
     4072            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4073         end.
     4074         if     not VUcd
     4075            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     4076         then do:
     4077            if not vMarkingUtd
     4078            then
     4079               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     4080         end.
     4081      end.
     4082      else do:
     4083         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     4084         then
     4085            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     4086      end.
     4087      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4088         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     4089      then
     4090         utd.sts-edi = ?.
     4091      else if     (not vMark and  not vucd) or not VContractEdo
     4092              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4093      then
     4094         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     4095      release utd no-error.
     4096      if error-status:error
     4097      then
     4098         return error return-value.
     4099      return vError.
     4100   end.
     4101   function ReCheckload returns logical
     4102   (idb-num as integer,
     4103    idoc-id as integer,
     4104    iload   as logical ):
     4105      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4106      define buffer buf_c-utd for ub.c-utd .
     4107      define buffer buf_utd   for ub.utd .
     4108      find first buf_utd where buf_utd.db-num eq idb-num
     4109                           and buf_utd.doc-id eq idoc-id
     4110      exclusive-lock no-error.
     4111      if available buf_utd
     4112      then do:
     4113         if    iload
     4114            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     4115         then do:
     4116            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     4117            if  error-status:error then
     4118            do:
     4119               message return-value view-as alert-box.
     4120            end.
     4121         end.
     4122         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4123            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4124            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     4125            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     4126         then do:
     4127            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     4128                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     4129                                              buf_c-utd.sts    eq buf_utd.sts and
     4130                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     4131            no-error .
     4132            if available (buf_c-utd)
     4133            then do:
     4134               buf_utd.sts = buf_c-utd.sts .
     4135               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4136            end.
     4137            else do:
     4138               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4139                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4140               then
     4141                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4142               else
     4143                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4144               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4145            end.
     4146         end.
     4147         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4148         then do:
     4149            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4150                                     input buf_utd.doc-id) .
     4151         end.
     4152      end.
     4153      release buf_utd.
     4154      unsubscribe "getNextseq".
     4155   end.
     4156   function ReCheck returns logical
     4157   (idb-num as integer,
     4158    idoc-id as integer ):
     4159      ReCheckload(idb-num,idoc-id,no).
     4160   end.
     4161   function GetLastUTDForPac returns logical
     4162   (iPackegeId as character ,
     4163    iTimestamp as datetime,
     4164    output odb-num as integer,
     4165    output odoc-id as integer ):
     4166      define buffer buf_utd for utd.
     4167      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4168                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4169                                and Buf_utd.Timestamp gt iTimestamp
     4170      no-lock no-error.
     4171      if available  buf_utd
     4172      then
     4173         assign
     4174            odb-num = buf_utd.db-num
     4175            odoc-id = buf_utd.doc-id
     4176         no-error.
     4177      else
     4178         assign
     4179            odb-num = ?
     4180            odoc-id = ?
     4181         no-error.
     4182   end.
     4183   function GetprevUTDForPac returns logical
     4184   (iPackegeId as character ,
     4185    iTimestamp as datetime,
     4186    output odb-num as integer,
     4187    output odoc-id as integer ):
     4188      define buffer buf_utd for utd.
     4189      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4190                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4191                                and Buf_utd.Timestamp < iTimestamp
     4192      no-lock no-error.
     4193      if available  buf_utd
     4194      then
     4195         assign
     4196            odb-num = buf_utd.db-num
     4197            odoc-id = buf_utd.doc-id
     4198         no-error.
     4199      else
     4200         assign
     4201            odb-num = ?
     4202            odoc-id = ?
     4203         no-error.
     4204   end.
     4205   function GetLastUTDinPackAft returns logical
     4206   (input idb-num as integer,
     4207    input idoc-id as integer,
     4208    output odb-num as integer,
     4209    output odoc-id as integer ):
     4210      define buffer buf_utd for utd.
     4211      define buffer     utd for utd.
     4212      find first utd where utd.db-num eq idb-num
     4213                       and utd.doc-id eq idoc-id
     4214      no-lock no-error.
     4215      if available utd
     4216      then do:
     4217         if utd.PackageId eq ""
     4218         then do:
     4219            assign
     4220               odb-num = utd.db-num
     4221               odoc-id = utd.doc-id
     4222            .
     4223            return yes.
     4224         end.
     4225         else do:
     4226            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4227            if    odb-num eq ?
     4228               or odoc-id eq ?
     4229            then do:
     4230               assign
     4231                  odb-num = utd.db-num
     4232                  odoc-id = utd.doc-id
     4233               .
     4234               return yes.
     4235            end.
     4236            else
     4237               return odoc-id = utd.doc-id.
     4238         end.
     4239      end.
     4240      return ?.
     4241   end.
     4242   function GetLastUTDinPackbef returns logical
     4243   (input idb-num as integer,
     4244    input idoc-id as integer,
     4245    output odb-num as integer,
     4246    output odoc-id as integer ):
     4247      define buffer buf_utd for utd.
     4248      define buffer     utd for utd.
     4249      find first utd where utd.db-num eq idb-num
     4250                       and utd.doc-id eq idoc-id
     4251      no-lock no-error.
     4252      if available utd
     4253      then do:
     4254         if utd.PackageId eq ""
     4255         then do:
     4256            assign
     4257               odb-num = utd.db-num
     4258               odoc-id = utd.doc-id
     4259            .
     4260            return yes.
     4261         end.
     4262         else do:
     4263            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4264            if    odb-num eq ?
     4265               or odoc-id eq ?
     4266            then do:
     4267               assign
     4268                  odb-num = utd.db-num
     4269                  odoc-id = utd.doc-id
     4270               .
     4271               return yes.
     4272            end.
     4273            else
     4274               return odoc-id = utd.doc-id.
     4275         end.
     4276      end.
     4277      return ?.
     4278   end.
     4279   function GetLastUTDinPack returns logical
     4280   (input idb-num as integer,
     4281    input idoc-id as integer,
     4282    output odb-num as integer,
     4283    output odoc-id as integer ):
     4284      define buffer buf_utd for utd.
     4285      define buffer     utd for utd.
     4286      find first utd where utd.db-num eq idb-num
     4287                       and utd.doc-id eq idoc-id
     4288      no-lock no-error.
     4289      if available utd
     4290      then do:
     4291         if utd.PackageId eq ""
     4292         then do:
     4293            assign
     4294               odb-num = utd.db-num
     4295               odoc-id = utd.doc-id
     4296            .
     4297            return yes.
     4298         end.
     4299         else do:
     4300            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     4301            if    odb-num eq ?
     4302               or odoc-id eq ?
     4303            then do:
     4304               assign
     4305                  odb-num = utd.db-num
     4306                  odoc-id = utd.doc-id
     4307               .
     4308               return yes.
     4309            end.
     4310            else
     4311               return odoc-id = utd.doc-id.
     4312         end.
     4313      end.
     4314      return ?.
     4315   end.
     4316   function delMark returns logical
     4317   ( buffer utd-marking-lines for utd-marking-lines ):
     4318      define buffer buf_utd-marking-line for utd-marking-lines.
     4319      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4320         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4321                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4322                                           and buf_utd-marking-line.mark      eq marking.mark
     4323         no-lock no-error.
     4324         if available  buf_utd-marking-line
     4325         then do:
     4326            delMark(buffer buf_utd-marking-line).
     4327            delete buf_utd-marking-line.
     4328         end.
     4329      end.
     4330   end.
     4331   function addMark returns logical
     4332   ( buffer utd-marking-lines for utd-marking-lines ):
     4333      define buffer buf_utd-marking-line for utd-marking-lines.
     4334      define buffer par_utd-marking-line for utd-marking-lines.
     4335      define buffer buf_utd for ub.utd .
     4336      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4337         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4338                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4339                                           and buf_utd-marking-line.mark      eq marking.mark
     4340         no-lock no-error.
     4341         if available  buf_utd-marking-line
     4342         then do:
     4343            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     4344            then do:
     4345               find current  buf_utd-marking-line exclusive-lock no-error.
     4346               if available buf_utd-marking-line
     4347               then
     4348                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     4349            end.
     4350         end.
     4351         else do:
     4352            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     4353                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     4354                                         no-error .
     4355            create buf_utd-marking-line.
     4356            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     4357            assign
     4358               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     4359               buf_utd-marking-line.mark      = marking.mark
     4360               buf_utd-marking-line.gds-code  = marking.Gds-code
     4361               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     4362                                               then marking.sts
     4363                                               else
     4364                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     4365                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     4366                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4367                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4368                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4369                                                else marking.sts
     4370            .
     4371            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4372            do:
     4373              for first par_utd-marking-line no-lock where
     4374                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     4375                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     4376                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     4377                    and par_utd-marking-line.mark    = marking.mark-parent
     4378                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4379              :
     4380                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     4381              end.
     4382            end.
     4383         end.
     4384         addMark(buffer buf_utd-marking-line).
     4385      end.
     4386   end.
     4387   function UnLockUTDMarkbuf returns logical
     4388   (buffer old_utd for utd,
     4389    iAll as logical ):
     4390      define variable voldkey    as character no-undo.
     4391         run gen-key-rec (input "utd",
     4392                          input  buffer old_utd:handle,
     4393                          output voldkey).
     4394      for each marking where marking.loc-key eq voldkey
     4395      exclusive-lock:
     4396         if    iAll
     4397            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4398                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     4399         then do:
     4400            marking.loc-key = "".
     4401            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     4402         end.
     4403      end.
     4404   end.
     4405   function UnLockUTDMark returns logical
     4406   (idb-num as integer ,idoc-id as integer ,iall as logical):
     4407      define buffer old_utd for utd.
     4408      find first old_utd where old_utd.db-num eq idb-num
     4409                           and old_utd.db-num eq idoc-id
     4410      no-lock no-error.
     4411      if available old_utd
     4412      then do:
     4413         UnLockUTDMarkbuf(buffer old_utd,iall).
     4414      end.
     4415   end.
     4416   function changSts returns logical
     4417   (idb-num as integer ,
     4418    idoc-id as integer ,
     4419    old_sts_edo as character ,
     4420    new_sts_edo as character  ):
     4421      if     old_sts_edo ne new_sts_edo
     4422         and ( new_sts_edo eq "RevocationAccepted"
     4423              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     4424              )
     4425      then
     4426         UnLockUTDMark(idb-num,idoc-id,yes).
     4427      if     old_sts_edo ne new_sts_edo
     4428         and ( new_sts_edo eq "WithRecipientSignature"
     4429           or  new_sts_edo eq "WithRecipientPartiallySignature"
     4430              )
     4431      then
     4432         UnLockUTDMark(idb-num,idoc-id,no).
     4433   end.
     4434   function SetLockUTDMark returns logical
     4435   (idb-num as integer ,idoc-id as integer ):
     4436      define buffer new_utd for utd.
     4437      define buffer old_utd for utd.
     4438      define variable volddb-num as integer no-undo.
     4439      define variable volddoc-id as integer no-undo.
     4440      define variable voldkey    as character no-undo.
     4441      define variable vnewkey    as character no-undo.
     4442      find first new_utd where new_utd.db-num eq idb-num
     4443                           and new_utd.doc-id eq idoc-id
     4444      no-lock no-error.
     4445      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     4446      then do trans:
     4447         find first old_utd where old_utd.db-num eq volddb-num
     4448                              and old_utd.doc-id eq volddoc-id
     4449         no-lock no-error.
     4450            run gen-key-rec (input "utd",
     4451                             input  buffer new_utd:handle,
     4452                             output vnewkey).
     4453            run gen-key-rec (input "utd",
     4454                             input  buffer old_utd:handle,
     4455                             output voldkey).
     4456         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     4457                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     4458         no-lock:
     4459            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     4460            if available  marking
     4461            then do:
     4462               if    marking.loc-key eq ""
     4463                  or marking.loc-key eq ?
     4464                  or marking.loc-key eq voldkey
     4465               then do:
     4466                  find current marking exclusive-lock no-error.
     4467                  if available marking
     4468                  then do:
     4469                     marking.loc-key = vnewkey.
     4470                     release marking.
     4471                  end.
     4472               end.
     4473               else if marking.loc-key ne vnewkey
     4474               then do:
     4475                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     4476               end.
     4477            end.
     4478         end.
     4479         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     4480      end.
     4481   end.
     4482   function CheckedocMark return logical
     4483   (input idb-numorig as integer,
     4484    input idoc-idorig as integer,
     4485    input idb-numedoc as integer,
     4486    input idoc-idedoc as integer  ):
     4487       define variable VChekOk    as logical   no-undo init yes.
     4488       define variable vMarkUtd   as logical   no-undo.
     4489       define variable v-par-type as character no-undo.
     4490       define variable v-par-val  as character no-undo.
     4491       define buffer buf_utd-attr      for utd-attr.
     4492       define buffer buf_utd           for utd.
     4493       define buffer utd-marking-lines for utd-marking-lines.
     4494       define buffer utd-lines         for utd-lines.
     4495       define buffer marking           for marking.
     4496       define buffer edoc-lines        for utd-lines.
     4497          for each utd-marking-lines where utd-marking-lines.db-num    eq idb-numorig
     4498                                       and utd-marking-lines.doc-id    eq idoc-idorig
     4499                                       and utd-marking-lines.doc-level eq 1
     4500                                       and utd-marking-lines.sts       eq objSrv:Env:marking:Sts:Mark:Checked_:KeyIntDB
     4501          no-lock:
     4502             if    isMark (utd-marking-lines.mark)
     4503             then do:
     4504                create tt-utd-mark.
     4505                buffer-copy utd-marking-lines to tt-utd-mark
     4506                assign
     4507                   tt-utd-mark.side = "+"
     4508                .
     4509             end.
     4510          end.
     4511          for each utd-marking-lines where utd-marking-lines.db-num eq idb-numedoc
     4512                                       and utd-marking-lines.doc-id eq idoc-idedoc
     4513                                       and utd-marking-lines.doc-level eq 1
     4514          no-lock:
     4515             if    isMark (utd-marking-lines.mark)
     4516             then do:
     4517                find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     4518                no-lock no-error.
     4519                if available tt-utd-mark
     4520                then
     4521                   tt-utd-mark.side = "".
     4522                else do:
     4523                   create tt-utd-mark.
     4524                   buffer-copy utd-marking-lines to tt-utd-mark
     4525                   assign
     4526                      tt-utd-mark.side = "-"
     4527                   .
     4528                end.
     4529             end.
     4530          end.
     4531          for each tt-utd-mark where  tt-utd-mark.side ne ""
     4532          no-lock:
     4533             AddUtdErrForTab(idb-numedoc, idoc-idedoc, "utd-marking-lines", buffer tt-utd-mark:handle, "edoc", "MarkOrig" + tt-utd-mark.side, tt-utd-mark.mark).
     4534             VChekOk = no.
     4535          end.
     4536          for each utd-lines where utd-lines.db-num    eq idb-numorig
     4537                               and utd-lines.doc-id    eq idoc-idorig
     4538          no-lock:
     4539             find first edoc-lines where edoc-lines.db-num eq idb-numedoc
     4540                                     and edoc-lines.doc-id eq idoc-idedoc
     4541                                     and edoc-lines.LineNum eq utd-lines.LineNum
     4542             no-lock no-error.
     4543             define variable VUtdlinequentity as decimal no-undo.
     4544             VUtdlinequentity = dec (getattrutdlinesex(utd-lines.db-num ,utd-lines.doc-id,utd-lines.LineNum,"QuantityBarCode","0")).
     4545             if     VUtdlinequentity eq ?
     4546                or (if available edoc-lines then edoc-lines.Quantity else 0) ne VUtdlinequentity
     4547             then
     4548                AddUtdErr(idb-numedoc, idoc-idedoc,buffer edoc-lines:handle,"edoc","lineQnty",string(edoc-lines.LineNum ) + chr(4) + string(VUtdlinequentity) + chr(4) + string(edoc-lines.Quantity ) ).
     4549          end.
     4550       for each tt-utd-mark:
     4551          delete tt-utd-mark.
     4552       end.
     4553   end.
     4554   function CheckEdoc returns character
     4555   (idb-numOrig as integer ,
     4556    idoc-idOrig as integer,
     4557    idb-num as integer ,
     4558    idoc-id as integer ):
     4559      define buffer utd  for ub.utd.
     4560      define buffer utd-lines  for ub.utd-lines.
     4561      define buffer utd-marking-lines  for ub.utd-marking-lines.
     4562      define buffer edoc-lines for ub.utd-lines.
     4563      define variable vSts as integer no-undo.
     4564      define variable vMarkutd as logical no-undo.
     4565      vSts = objSrv:Env:utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4566      Block-line:
     4567      for each utd-lines where utd-lines.db-num eq idb-num
     4568                           and utd-lines.doc-id eq idoc-id
     4569      exclusive-lock:
     4570         define variable ismarkin as logical no-undo.
     4571         define variable isOAD as logical no-undo.
     4572         define variable isper as logical no-undo.
     4573         getMarkUtdLine(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,
     4574              output ismarkin, output isOAD, output isper).
     4575         if    utd-lines.Price                eq 0
     4576            or utd-lines.Total                eq 0
     4577            or utd-lines.TotalWithVatExcluded eq 0
     4578            or utd-lines.Quantity             eq 0
     4579         then do:
     4580            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4581                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4582                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     4583            no-lock:
     4584               if    isMark(utd-marking-lines.mark)
     4585                  or isOad(utd-marking-lines.mark)
     4586               then do:
     4587                  AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Amount" , string(utd-lines.LineNum )).
     4588                  next Block-line.
     4589               end.
     4590            end.
     4591            delete utd-lines.
     4592         end.
     4593         else if   ( utd-lines.Total                ne 0
     4594                 or utd-lines.Quantity             ne 0)
     4595                 and ismarkin or isOAD
     4596         then do:
     4597            Block-mark:
     4598            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4599                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4600                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     4601            no-lock:
     4602               if  (isOAD and
     4603                     isMark(utd-marking-lines.mark)
     4604                  or isOad(utd-marking-lines.mark) )
     4605                  or (ismarkin and
     4606                     isMark(utd-marking-lines.mark))
     4607               then do:
     4608                  leave Block-mark.
     4609               end.
     4610            end.
     4611            if not available utd-marking-lines
     4612            then
     4613               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Mark" ,string(utd-lines.LineNum)).
     4614         end.
     4615      end.
     4616      for each utd-lines where utd-lines.db-num eq idb-numOrig
     4617                           and utd-lines.doc-id eq idoc-idOrig
     4618      no-lock:
     4619         find first edoc-lines where edoc-lines.db-num eq idb-num
     4620                                 and edoc-lines.doc-id eq idoc-id
     4621                                 and edoc-lines.LineNum eq utd-lines.LineNum
     4622         no-lock no-error.
     4623         if     available edoc-lines
     4624         then do:
     4625            if edoc-lines.Quantity ne 0
     4626            then do:
     4627               if edoc-lines.Price ne utd-lines.Price
     4628               then
     4629                  AddUtdErr(edoc-lines.db-num,edoc-lines.doc-id,buffer edoc-lines:handle,"Edoc","Price" ,string(edoc-lines.LineNum)).
     4630            end.
     4631         end.
     4632         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     4633         CheckedocMark(idb-numOrig , idoc-idOrig , idb-num , idoc-id).
     4634      end.
     4635      define variable vError as character no-undo.
     4636      vError = GetErrForUtdstr(idb-num , idoc-id ,"edoc").
     4637      if vError ne ""
     4638      then
     4639         vSts = objSrv:Env:utd:Sts:th:edocError:KeyIntDB.
     4640      else
     4641         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     4642      find first utd where utd.db-num eq idb-num
     4643                       and utd.doc-id eq idoc-id
     4644      exclusive-lock no-error.
     4645      if available utd
     4646      then do:
     4647         utd.sts = vsts.
     4648      end.
     4649   end.
     4650   function CrEdoc returns character
     4651   (iPack as character ,
     4652    iTimestamp as datetime):
     4653      define variable vdb-num as integer no-undo.
     4654      define variable vdoc-id as integer no-undo.
     4655      define buffer utd  for ub.utd.
     4656      define buffer edoc for ub.utd.
     4657      define buffer utd_ret   for ub.utd.
     4658      define buffer utd-attr  for ub.utd-attr.
     4659      define buffer edoc-attr for ub.utd-attr.
     4660      define buffer utd-lines  for ub.utd-lines.
     4661      define buffer edoc-lines for ub.utd-lines.
     4662      define buffer utd-lines-attr  for ub.utd-lines-attr.
     4663      define buffer edoc-lines-attr for ub.utd-lines-attr.
     4664      define buffer utd-marking-lines  for ub.utd-marking-lines.
     4665      define buffer edoc-marking-lines for ub.utd-marking-lines.
     4666      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     4667      define buffer edoc-marking-lines-attr for ub.utd-marking-lines-attr.
     4668      define variable vTimestamp  as datetime no-undo.
     4669      find last utd where utd.PackageId eq iPack
     4670                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4671                      and utd.Timestamp ge iTimestamp
     4672      no-lock no-error.
     4673      if available utd
     4674      then
     4675         return "Есть документ позже".
     4676      find last utd where utd.PackageId eq iPack
     4677                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     4678                      and utd.Timestamp le iTimestamp
     4679      no-lock no-error.
     4680      if not available utd
     4681      then
     4682         return "Не найден УКД".
     4683      define variable vdb-numOrig as integer no-undo.
     4684      define variable vdoc-idOrig as integer no-undo.
     4685      find last utd where utd.PackageId eq iPack
     4686                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4687                      and utd.Timestamp le iTimestamp
     4688      no-lock no-error.
     4689      if available utd
     4690      then do:
     4691         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4692         MySeqUtd = ?.
     4693         vTimestamp = utd.Timestamp.
     4694         create edoc.
     4695         vdb-num = utd.db-num.
     4696         vdoc-id = utd.doc-id.
     4697         buffer-copy utd except doc-id db-num DocumentExt OrganizationExt comment to edoc
     4698         assign
     4699            edoc.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4700            edoc.Timestamp = iTimestamp + 1
     4701            edoc.AmendmentRequested = no
     4702            edoc.sts-edi  = objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     4703         .
     4704         validate edoc.
     4705         for each utd-attr where utd-attr.db-num eq vdb-num
     4706                             and utd-attr.doc-id eq vdoc-id
     4707                             and utd-attr.attr-code ne "ststhbeforeCorrection"
     4708                             and utd-attr.attr-code ne "sendcode"
     4709         no-lock:
     4710            create edoc-attr.
     4711            buffer-copy utd-attr except doc-id db-num to edoc-attr
     4712            assign
     4713               edoc-attr.db-num = edoc.db-num
     4714               edoc-attr.doc-id = edoc.doc-id
     4715            .
     4716         end.
     4717         for each utd-lines where utd-lines.db-num eq vdb-num
     4718                              and utd-lines.doc-id eq vdoc-id
     4719         no-lock:
     4720            create edoc-lines.
     4721            buffer-copy utd-lines except doc-id db-num to edoc-lines
     4722            assign
     4723               edoc-lines.db-num = edoc.db-num
     4724               edoc-lines.doc-id = edoc.doc-id
     4725            .
     4726            release edoc-lines.
     4727         end.
     4728         for each utd-lines-attr where utd-lines-attr.db-num eq vdb-num
     4729                                   and utd-lines-attr.doc-id eq vdoc-id
     4730         no-lock:
     4731            create edoc-lines-attr.
     4732            buffer-copy utd-lines-attr except doc-id db-num to edoc-lines-attr
     4733            assign
     4734               edoc-lines-attr.db-num = edoc.db-num
     4735               edoc-lines-attr.doc-id = edoc.doc-id
     4736            .
     4737         end.
     4738         for each utd-marking-lines where utd-marking-lines.db-num eq vdb-num
     4739                                      and utd-marking-lines.doc-id eq vdoc-id
     4740                                      and utd-marking-lines.doc-level eq 1
     4741         no-lock:
     4742            create edoc-marking-lines.
     4743            buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     4744            assign
     4745               edoc-marking-lines.db-num = edoc.db-num
     4746               edoc-marking-lines.doc-id = edoc.doc-id
     4747            .
     4748         end.
     4749         for each utd-marking-lines-attr where utd-marking-lines-attr.db-num eq vdb-num
     4750                                           and utd-marking-lines-attr.doc-id eq vdoc-id
     4751         no-lock:
     4752            if utd-marking-lines-attr.attr-code eq "box-qnty"
     4753            then do:
     4754                find first edoc-marking-lines-attr  where edoc-marking-lines-attr.db-num    eq utd-marking-lines-attr.db-num
     4755                                                      and edoc-marking-lines-attr.doc-id    eq utd-marking-lines-attr.doc-id
     4756                                                      and edoc-marking-lines-attr.LineNum   eq utd-marking-lines-attr.LineNum
     4757                                                      and edoc-marking-lines-attr.mark      eq utd-marking-lines-attr.mark
     4758                                                      and edoc-marking-lines-attr.attr-code eq utd-marking-lines-attr.attr-code
     4759                no-lock no-error.
     4760            end.
     4761            if not avail edoc-marking-lines-attr
     4762            then do:
     4763                create edoc-marking-lines-attr.
     4764                buffer-copy utd-marking-lines-attr except doc-id db-num to edoc-marking-lines-attr
     4765                assign
     4766                   edoc-marking-lines-attr.db-num = vdb-num
     4767                   edoc-marking-lines-attr.doc-id = vdoc-id
     4768                .
     4769            end.
     4770            release edoc-marking-lines-attr.
     4771         end.
     4772         for each utd where utd.PackageId eq iPack
     4773                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4774                        and utd.Timestamp gt vTimestamp
     4775                        and utd.Timestamp le iTimestamp
     4776                        and (    utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     4777                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB
     4778                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     4779                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientPartiallySignature:KeyIntDB
     4780                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     4781                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     4782         no-lock by utd.PackageId by utd.EDocType by utd.Timestamp:
     4783            edoc.Total = edoc.Total + utd.total.
     4784            edoc.Vat = edoc.Vat + utd.Vat.
     4785            edoc.DocumentDate = utd.DocumentDate.
     4786            edoc.Timestamp = utd.Timestamp + 1.
     4787            for each utd-lines where utd-lines.db-num     = utd.db-num
     4788                                 and utd-lines.doc-id     = utd.doc-id
     4789            no-lock:
     4790               block-mark:
     4791               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     4792                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     4793                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     4794                                            and utd-marking-lines.site eq "-"
     4795                                            no-lock:
     4796                  if isOAD(utd-marking-lines.mark)
     4797                  then do:
     4798                     define variable VOAD as character no-undo.
     4799                     VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4800                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4801                                                  and edoc-marking-lines.doc-id eq edoc.doc-id
     4802                                                  and edoc-marking-lines.mark   begins VOAD
     4803                     no-lock no-error.
     4804                  end.
     4805                  else
     4806                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4807                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     4808                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4809                        no-lock no-error.
     4810                  if available edoc-marking-lines
     4811                  then do:
     4812                     find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     4813                                       and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     4814                                       and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     4815                     exclusive-lock no-error.
     4816                     leave block-mark.
     4817                  end.
     4818               end.
     4819               if not available edoc-lines
     4820               then
     4821                  find first edoc-lines where edoc-lines.db-num      = edoc.db-num
     4822                                          and edoc-lines.doc-id      = edoc.doc-id
     4823                                          and edoc-lines.ProductCode = utd-lines.ProductCode
     4824                  exclusive-lock no-error.
     4825               if not available edoc-lines
     4826               then do:
     4827                  find last edoc-lines where edoc-lines.db-num      = edoc.db-num
     4828                                         and edoc-lines.doc-id      = edoc.doc-id
     4829                  no-lock no-error.
     4830                  define variable vline as integer no-undo.
     4831                  vline = if available edoc-lines then edoc-lines.linenum + 1 else 1.
     4832                  create edoc-lines.
     4833                  buffer-copy utd-lines except doc-id db-num linenum to edoc-lines
     4834                  assign
     4835                     edoc-lines.db-num = edoc.db-num
     4836                     edoc-lines.doc-id = edoc.doc-id
     4837                     edoc-lines.linenum = vline
     4838                  .
     4839               end.
     4840               else
     4841                  assign
     4842                     edoc-lines.Vat       = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Vat_old") )       + utd-lines.Vat
     4843                     edoc-lines.Total     = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Total_old") )     + utd-lines.Total
     4844                     edoc-lines.Quantity  = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity_old_new") )  + utd-lines.Quantity.
     4845                     edoc-lines.TotalWithVatExcluded = edoc-lines.Total - edoc-lines.Vat.
     4846                  .
     4847               define variable Vqnty as decimal no-undo.
     4848               Vqnty = dec(getattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity") )
     4849                     + dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity") ).
     4850               setattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity",string(vqnty)).
     4851               if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     4852                  and edoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4853               then
     4854                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     4855                      "loadUtd",
     4856                      "UcdUnitChangForUtd",
     4857                      string(edoc-lines.LineNum )                  + chr(4) +
     4858                      edoc-lines.UnitCode                   + chr(4) +
     4859                      getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4860               if     utd-lines.UnitCode ne ?
     4861                  and utd-lines.UnitCode ne ""
     4862                  and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4863               then
     4864                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     4865                         "loadUtd",
     4866                         "UcdUnitChang",
     4867                         string(edoc-lines.LineNum )                  + chr(4) +
     4868                         utd-lines.UnitCode                          + chr(4) +
     4869                         getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4870               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     4871                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     4872                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     4873               no-lock by utd-marking-lines.site by utd-marking-lines.doc-level desc:
     4874                  if utd-marking-lines.site eq "-"
     4875                  then do:
     4876                     if isOAD(utd-marking-lines.mark)
     4877                     then do:
     4878                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4879                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4880                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4881                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4882                        exclusive-lock no-error.
     4883                        if not available edoc-marking-lines
     4884                        then
     4885                           find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4886                                                        and edoc-marking-lines.doc-id eq edoc.doc-id
     4887                                                        and edoc-marking-lines.mark   begins VOAD
     4888                           exclusive-lock no-error.
     4889                        if not available edoc-marking-lines
     4890                        then
     4891                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4892                        else do:
     4893                           define variable v37tegdoc as character no-undo.
     4894                           define variable v37tegedoc as character no-undo.
     4895                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     4896                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     4897                           vqnty = int(v37tegedoc) - int(v37tegdoc) no-error.
     4898                           if error-status:error
     4899                           then
     4900                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     4901                              view-as alert-box.
     4902                           else if vqnty = 0
     4903                           then
     4904                              delete edoc-marking-lines.
     4905                           else do:
     4906                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     4907                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4908                                             edoc-marking-lines.doc-id,
     4909                                             edoc-marking-lines.LineNum,
     4910                                             edoc-marking-lines.mark,
     4911                                             "box-qnty",
     4912                                              string(vQnty)).
     4913                           end.
     4914                        end.
     4915                     end.
     4916                     else do:
     4917                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4918                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4919                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4920                        exclusive-lock no-error.
     4921                        if available edoc-marking-lines
     4922                        then
     4923                           delete edoc-marking-lines.
     4924                        else
     4925                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4926                     end.
     4927                  end.
     4928                  else if utd-marking-lines.site eq "+"
     4929                  then do:
     4930                     if isOAD(utd-marking-lines.mark)
     4931                     then do:
     4932                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4933                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4934                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     4935                                                     and edoc-marking-lines.mark   begins VOAD
     4936                        exclusive-lock no-error.
     4937                        if available edoc-marking-lines
     4938                        then do:
     4939                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     4940                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     4941                           vqnty = int(v37tegedoc) + int(v37tegdoc) no-error.
     4942                           if error-status:error
     4943                           then
     4944                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     4945                              view-as alert-box.
     4946                           else if vqnty = 0
     4947                           then
     4948                              delete edoc-marking-lines.
     4949                           else do:
     4950                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     4951                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4952                                             edoc-marking-lines.doc-id,
     4953                                             edoc-marking-lines.LineNum,
     4954                                             edoc-marking-lines.mark,
     4955                                             "box-qnty",
     4956                                              string(vQnty)).
     4957                           end.
     4958                        end.
     4959                        else do:
     4960                           create edoc-marking-lines.
     4961                           buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     4962                           assign
     4963                              edoc-marking-lines.db-num = edoc.db-num
     4964                              edoc-marking-lines.doc-id = edoc.doc-id
     4965                           .
     4966                           setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4967                                             edoc-marking-lines.doc-id,
     4968                                             edoc-marking-lines.LineNum,
     4969                                             edoc-marking-lines.mark,
     4970                                             "box-qnty",
     4971                                              string(int(GetTegCod(edoc-marking-lines.mark,"37")))) no-error.
     4972                        end.
     4973                     end.
     4974                     else do:
     4975                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4976                                                     and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4977                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4978                     no-lock no-error.
     4979                     if not available edoc-marking-lines
     4980                     then do:
     4981                        create edoc-marking-lines.
     4982                        buffer-copy utd-marking-lines except doc-id db-num linenum to edoc-marking-lines
     4983                        assign
     4984                           edoc-marking-lines.db-num  = edoc-lines.db-num
     4985                           edoc-marking-lines.doc-id  = edoc-lines.doc-id
     4986                           edoc-marking-lines.linenum = edoc-lines.linenum
     4987                        .
     4988                     end.
     4989                     else
     4990                        AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"Edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4991                  end.
     4992               end.
     4993               release edoc-lines.
     4994            end.
     4995            release edoc-lines.
     4996         end.
     4997         find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4998                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4999                                 and utd_ret.Timestamp             le utd.Timestamp
     5000                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     5001            no-lock no-error.
     5002         if not avail utd_ret
     5003         then
     5004            CheckEdoc (vdb-num,vdoc-id,edoc.db-num,edoc.doc-id) .
     5005      end.
     5006      for each utd where utd.PackageId eq iPack
     5007                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     5008                        and utd.Timestamp < iTimestamp
     5009         exclusive-lock:
     5010            utd.sts-edi = objSrv:Env:Utd:sts:edi:Changed:KeyIntDB.
     5011            utd.sts     = objSrv:Env:Utd:sts:th:Rejection:KeyIntDB.
     5012         end.
     5013         unsubscribe "getNextseq".
     5014      end.
     5015   end.
     5016   define variable Mext-sys as integer no-undo init ?.
     5017   define variable mdb-num-local as integer no-undo.
     5018   run gbl/getdbnum.p (output mdb-num-local).
     5019   function  getExtSys returns integer
     5020   ():
     5021      define buffer ext-system      for ext-system.
     5022      define buffer ext-system-attr for ext-system-attr.
     5023      Mext-sys = ?.
     5024      block-sys-obj:
     5025      for each ext-system where ext-system.esys-type eq 12
     5026                            and ext-system.db-num    eq mdb-num-local
     5027      no-lock:
     5028          find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5029                                       and ext-system-attr.esys-id eq ext-system.esys-id
     5030                                       and ext-system-attr.esya-attr-code eq 'obj':U
     5031          no-lock no-error.
     5032          if     available ext-system-attr
     5033             and           ext-system-attr.esya-attr-value eq v-cntxt-obj-type + string(v-cntxt-obj-code)
     5034          then do:
     5035             Mext-sys = ext-system-attr.esys-id.
     5036             leave block-sys-obj.
     5037          end.
     5038      end.
     5039      if Mext-sys eq ?
     5040      then do:
     5041         block-sys-host:
     5042         for each ext-system where ext-system.esys-type eq 12
     5043                               and ext-system.db-num    eq mdb-num-local
     5044         no-lock:
     5045             find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     5046                                          and ext-system-attr.esys-id eq ext-system.esys-id
     5047                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     5048             no-lock no-error.
     5049             if     available ext-system-attr
     5050                and           ext-system-attr.esya-attr-value eq string(v-cntxt-host-code-obj)
     5051             then do:
     5052                Mext-sys = ext-system-attr.esys-id.
     5053                leave block-sys-host.
     5054             end.
     5055         end.
     5056      end.
     5057      return Mext-sys.
     5058   end.
     5059   function  getExtAttr returns character
     5060   (input icode as character ):
     5061      define variable oValue as character no-undo.
     5062      define variable vtype as character no-undo.
     5063      define buffer ext-system for ext-system.
     5064      get-key-value section "ProxyServ" key icode value oValue.
     5065      if oValue eq ?
     5066      then do:
     5067         if Mext-sys eq ?
     5068         then
     5069            getExtSys ().
     5070         find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5071                                         and ext-system.esys-id eq Mext-sys no-error.
     5072         if available ext-system
     5073         then do:
     5074                if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
     5075            (ext-system.esys-id,
     5076             mdb-num-local,
     5077             icode,
     5078             output oValue,
     5079             output vtype) no-error.
     5080          end.
     5081      end.
     5082      return if oValue eq ? then "" else oValue .
     5083   end.
     5084   function  SetExtAttr returns character
     5085   (input icode   as character,
     5086    input iValue  as character):
     5087      define variable vtype as character no-undo.
     5088      define buffer ext-system for ext-system.
     5089      if Mext-sys eq ?
     5090      then
     5091         getExtSys ().
     5092      find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     5093                                      and ext-system.esys-id eq Mext-sys no-error.
     5094      if available ext-system
     5095      then do:
     5096          if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
     5097         (ext-system.esys-id,
     5098          mdb-num-local,
     5099          icode,
     5100          iValue) no-error.
     5101       end.
     5102   end.
     5103   define stream File-stream.
     5104   function PutMes returns character
     5105   (idext as character ):
     5106      if valid-handle(mPublishHand)
     5107      then
     5108         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     5109      else do:
     5110         if idext begins "error"
     5111         then do:
     5112            message substring (idext,6)
     5113               view-as alert-box.
     5114            if mDiadocApi ne ?
     5115            then
     5116               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     5117         end.
     5118         output stream File-stream to "diadoc_user.log" append.
     5119         put stream File-stream unformatted now " " idext skip.
     5120         output stream File-stream close.
     5121      end.
     5122   end.
     5123   function PutErr returns character
     5124   (idext as character ):
     5125      define variable vi as integer no-undo.
     5126      define variable vnumerr as integer no-undo.
     5127      define variable vtext as character extent 25 no-undo .
     5128      if error-status:num-messages > 0 then do:
     5129         vnumerr = error-status:num-messages.
     5130         vnumerr = min(vnumerr,extent(vtext)).
     5131         do vi = 1 to vnumerr:
     5132            vtext[vi] = error-status:get-message(vi).
     5133         end.
     5134         idext = idext + chr(10) + "Ошибка: [":U.
     5135         do vi = 1 to vnumerr:
     5136            idext = idext + chr(10) + vtext[vi] no-error.
     5137         end.
     5138         idext = idext +  chr(10) +  " ]" no-error.
     5139         if not  idext begins "Error"
     5140         then
     5141            idext = "Error " + idext.
     5142         PutMes(idext).
     5143      end.
     5144   end.
     5145   function PutStat returns character
     5146   (itext as character,
     5147    iflag as logical):
     5148      if valid-handle(mPublishHand)
     5149      then
     5150         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     5151      PutMes(itext).
     5152   end.
     5153   function chekStop returns logical
     5154   ( ):
     5155      define variable oStop as logical no-undo.
     5156      if valid-handle(mPublishHand)
     5157      then
     5158         publish "StopProc" from mPublishHand (output oStop).
     5159      return oStop.
     5160   end.
     5161   function  putloggetdesc returns logical
     5162   (is1 as character ,is2 as character ,
     5163   is3 as character ):
     5164   end.
     5165   function  getdesc returns logical
     5166   (input iObj as component-handle):
     5167      if iObj eq ? then return false.
     5168      if mdebug
     5169      then do:
     5170      output stream File-stream to "diadoc_load.txt" append.
     5171      define variable vReflector as component-handle no-undo.
     5172      define variable vDescobj  as component-handle no-undo.
     5173      define variable vPropertyNames  as component-handle no-undo.
     5174      define variable vMethodsNames as component-handle no-undo.
     5175      define variable vMethodDesc as component-handle no-undo.
     5176      define variable vMethodsName as character  no-undo.
     5177      define variable vPropertyValue as char no-undo.
     5178      create "Diadoc.Reflector" vReflector.
     5179      vDescobj = vReflector:Describe(iObj).
     5180     put   stream File-stream  unformatted skip (1)
     5181      "------------------------------------------" skip
     5182      vDescobj:GetInterfaceName() skip.
     5183      define variable vPropertyName as character no-undo.
     5184      define variable vPropertyType as character no-undo.
     5185      .
     5186      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     5187      putloggetdesc("property","","").
     5188      define variable vi as integer no-undo.
     5189      define variable vii as integer no-undo.
     5190     put stream File-stream  unformatted skip "property" skip.
     5191     vPropertyNames = vDescobj:GetPropertiesNames().
     5192      vi= vPropertyNames:count.
     5193      do vi= 1 to vPropertyNames:count :
     5194         vPropertyName = "".
     5195         vPropertyType = "".
     5196         vPropertyValue = "".
     5197         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     5198         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     5199         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     5200         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     5201        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     5202      end.
     5203      release object vPropertyNames.
     5204      put stream File-stream  unformatted skip "method" skip.
     5205      vMethodsNames = vDescobj:GetMethodsNames().
     5206      vi = vMethodsNames:count.
     5207      do vi = 1 to vMethodsNames:count :
     5208         vMethodsName = "".
     5209         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     5210         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     5211         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     5212         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     5213         do vii  = 1 to vMethodDesc:args:count:
     5214            define variable varg as character no-undo.
     5215            varg = "".
     5216            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     5217            put stream File-stream  unformatted " args " varg  skip .
     5218            putloggetdesc(" args ",varg, "").
     5219         end.
     5220         release object vMethodDesc.
     5221      end.
     5222      release object vMethodsNames.
     5223      put stream File-stream  unformatted "end---------------------------------------" skip.
     5224      output stream File-stream close.
     5225      release object vDescobj.
     5226      release object vReflector.
     5227      end.
     5228      return true.
     5229   end.
     5230   function getxsddocum returns logical
     5231   (iOrganization as component-handle):
     5232      if iOrganization eq ? then return false.
     5233      define variable vDocumentTypes as component-handle no-undo.
     5234      define variable vDocumentType as component-handle no-undo.
     5235      define variable vFunctions as component-handle no-undo.
     5236      define variable vFunction as component-handle no-undo.
     5237      define variable vVersions as component-handle no-undo.
     5238      define variable vVersion as component-handle no-undo.
     5239      define variable vTitles as component-handle no-undo.
     5240      define variable vTitle as component-handle no-undo.
     5241      define variable vi as integer no-undo.
     5242      define variable vii as integer no-undo.
     5243      define variable viii as integer no-undo.
     5244      define variable viiii as integer no-undo.
     5245      if mdebug
     5246      then do:
     5247      output stream File-stream to "diadoc_doc.txt" append.
     5248      vDocumentTypes = iOrganization:GetDocumentTypes().
     5249      do vi =1 to vDocumentTypes:count:
     5250         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5251         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     5252         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     5253         vFunctions = vDocumentType:Functions.
     5254         do vii =1 to vFunctions:count:
     5255            vFunction = vFunctions:GetItem(vii - 1 ).
     5256            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     5257            vVersions = vFunction:Versions.
     5258            do viii =1 to vVersions:count:
     5259               vVersion = vVersions:GetItem(viii - 1 ).
     5260               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     5261               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     5262               vTitles  = vVersion:Titles.
     5263               do viiii =1 to vTitles:count:
     5264                  vTitle = vTitles:GetItem(viiii - 1 ).
     5265                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     5266                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     5267                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     5268                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     5269                  release object vTitle.
     5270               end.
     5271              release object vTitles.
     5272               release object vVersion.
     5273            end.
     5274            release object vVersions.
     5275            release object vFunction.
     5276         end.
     5277         release object vFunctions.
     5278         release object vDocumentType.
     5279      end.
     5280      release object vDocumentTypes.
     5281      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     5282     output stream File-stream close.
     5283     end.
     5284      return true.
     5285   end.
     5286   function GetDocTitleType returns character
     5287   (iOrganizationGuid as character ,
     5288   itype as character ,
     5289   ifunction as character,
     5290   iversion as character
     5291   ):
     5292      if iOrganizationGuid eq ? then return "".
     5293      define variable vOrganization  as component-handle no-undo.
     5294      define variable vDocumentTypes as component-handle no-undo.
     5295      define variable vDocumentType  as component-handle no-undo.
     5296      define variable vFunctions     as component-handle no-undo.
     5297      define variable vFunction      as component-handle no-undo.
     5298      define variable vVersions      as component-handle no-undo.
     5299      define variable vVersion       as component-handle no-undo.
     5300      define variable vTitles        as component-handle no-undo.
     5301      define variable vTitle         as component-handle no-undo.
     5302      define variable vi             as integer no-undo.
     5303      define variable vii            as integer no-undo.
     5304      define variable viii           as integer no-undo.
     5305      define variable viiii          as integer no-undo.
     5306      define variable oTitleType as character no-undo.
     5307      vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     5308      if vOrganization eq ? then return "".
     5309      vDocumentTypes = vOrganization:GetDocumentTypes().
     5310      do vi =1 to vDocumentTypes:count:
     5311         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5312         if vDocumentType:name eq iType
     5313         then do:
     5314            vFunctions = vDocumentType:Functions.
     5315            do vii =1 to vFunctions:count:
     5316               vFunction = vFunctions:GetItem(vii - 1 ).
     5317               if vFunction:name eq ifunction
     5318               then do:
     5319                  vVersions = vFunction:Versions.
     5320                  do viii =1 to vVersions:count:
     5321                     vVersion = vVersions:GetItem(viii - 1 ).
     5322                     if vVersion:version eq iversion
     5323                     then do:
     5324                        vTitles  = vVersion:Titles.
     5325                        do viiii =1 to vTitles:count:
     5326                           vTitle = vTitles:GetItem(viiii - 1 ).
     5327                           oTitleType = oTitleType + "," + vTitle:type.
     5328                           release object vTitle.
     5329                        end.
     5330                        release object vTitles.
     5331                     end.
     5332                     release object vVersion.
     5333                  end.
     5334                  release object vVersions.
     5335               end.
     5336               release object vFunction.
     5337            end.
     5338            release object vFunctions.
     5339         end.
     5340         release object vDocumentType.
     5341      end.
     5342      release object vDocumentTypes.
     5343      release object vOrganization.
     5344      return left-trim(oTitleType,",").
     5345   end.
     5346   define temp-table tt-type no-undo
     5347             field id as char
     5348             field name as character
     5349             index pi id .
     5350   define temp-table tt-Class no-undo like tt-type.
     5351   function crcode returns character
     5352   ():
     5353      define variable vtypelist as character no-undo.
     5354      define variable vtypename as character no-undo.
     5355      define variable vi as integer no-undo.
     5356      vtypelist =
     5357                 "UniversalTransferDocument|"
     5358                + "UniversalTransferDocumentRevision|"
     5359                + "UniversalCorrectionDocument|"
     5360                + "UniversalCorrectionDocumentRevision"
     5361                .
     5362      vtypename =
     5363                 "УПД|"
     5364                + "Исправление УПД|"
     5365                + "УКД|"
     5366                + "Исправление УКД"
     5367                .
     5368      do vi = 1 to num-entries(vtypelist,"|"):
     5369         create tt-type.
     5370         assign
     5371            tt-type.id   =  entry(vi,vtypelist,"|")
     5372            tt-type.name =  entry(vi,vtypename,"|")
     5373         .
     5374      end.
     5375      vtypelist = "Inbound|"
     5376                + "Outbound|"
     5377                + "Proxy".
     5378      vtypename = "входящий документ|"
     5379                + "исходящий документ|"
     5380                + "документ, переданный через промежуточного получателя|".
     5381      do vi = 1 to num-entries(vtypelist,"|"):
     5382         create tt-Class.
     5383         assign
     5384            tt-Class.id   =  entry(vi,vtypelist,"|")
     5385            tt-Class.name =  entry(vi,vtypename,"|")
     5386         .
     5387      end.
     5388   end.
     5389   crcode().
     5390   function getOrganizationInfo returns character
     5391   (input iContAgent as component-handle,
     5392                                                   output oinn as character,
     5393                                                   output oKpp as character,
     5394                                                   output oFnsParticipantId as character,
     5395                                                   output oOrgName as character,
     5396                                                   output oAdditionalInfo as character,
     5397                                                   output OarddrRus as character
     5398                                                    ):
     5399      define variable vi as integer no-undo.
     5400      define variable vContAgentOrganizationDetails   as component-handle no-undo.
     5401      define variable vAddrRus                        as component-handle no-undo.
     5402      if iContAgent ne ?
     5403      then do:
     5404         getdesc(iContAgent).
     5405         vContAgentOrganizationDetails = iContAgent:OrganizationDetails.
     5406         oinn = vContAgentOrganizationDetails:Inn.
     5407         oKpp = vContAgentOrganizationDetails:Kpp.
     5408         oFnsParticipantId = vContAgentOrganizationDetails:FnsParticipantId.
     5409         oAdditionalInfo = vContAgentOrganizationDetails:OrganizationAdditionalInfo.
     5410         getdesc(vContAgentOrganizationDetails).
     5411         oOrgName = vContAgentOrganizationDetails:OrgName.
     5412         getdesc(vContAgentOrganizationDetails:Address).
     5413         vAddrRus = vContAgentOrganizationDetails:Address:RussianAddress.
     5414         getdesc(vAddrRus ).
     5415         if vAddrRus ne ?
     5416         then do:
     5417            if vAddrRus:ZipCode ne ""
     5418            then
     5419               OarddrRus = OarddrRus + " " + vAddrRus:ZipCode.
     5420            if vAddrRus:Region ne ""
     5421            then
     5422               OarddrRus = OarddrRus + " Регион: " + vAddrRus:Region.
     5423            if vAddrRus:Territory ne ""
     5424            then
     5425               OarddrRus = OarddrRus + " Область: " + vAddrRus:Territory.
     5426            if vAddrRus:City ne ""
     5427            then
     5428               OarddrRus = OarddrRus + " Город: " + vAddrRus:City.
     5429            if vAddrRus:Locality ne ""
     5430            then
     5431               OarddrRus = OarddrRus + " Район: " + vAddrRus:Locality.
     5432            if vAddrRus:Street ne ""
     5433            then
     5434               OarddrRus = OarddrRus + " Улица: " + vAddrRus:Street.
     5435            if vAddrRus:Block ne ""
     5436            then
     5437               OarddrRus = OarddrRus + " Стр: " + vAddrRus:Block.
     5438            if vAddrRus:Building ne ""
     5439            then
     5440               OarddrRus = OarddrRus + " Дом: " + vAddrRus:Building.
     5441            if vAddrRus:Apartment ne ""
     5442            then
     5443               OarddrRus = OarddrRus + " Квартира: " + vAddrRus:Apartment.
     5444         end.
     5445         release object vAddrRus.
     5446         release object vContAgentOrganizationDetails.
     5447      end.
     5448   end.
     5449   function ConectByCertif return component-handle
     5450   (iThumbprint as character ):
     5451     if mDiadocApi eq ? then return ?.
     5452     if iThumbprint eq ""
     5453     then do:
     5454        release object mDiadocConnection no-error.
     5455        return ?.
     5456     end.
     5457      mDiadocApi:ApiClientId =  getextAttr('diadoc-key':U).
     5458      mDiadocApi:ServerUrl   =  getextAttr('server-addr':U).
     5459      define variable vSSl as character no-undo.
     5460      vSSl =  getextAttr('diadoc-ssl':U).
     5461      if vSSl ne ""
     5462         and logical(vSSl)
     5463      then
     5464         mDiadocApi:VerifySslCertificate = no.
     5465      if mDiadocApi:ApiClientId eq ""
     5466         or  mDiadocApi:ServerUrl eq ""
     5467      then do:
     5468        message "Не задан адрес сервера или ключ разработчика для внешей системы Диадок"
     5469        view-as alert-box.
     5470        release object mDiadocConnection no-error.
     5471        return ?.
     5472     end.
     5473     define variable VProxy as character no-undo.
     5474      vProxy =  getextAttr('proxy-addr':U).
     5475      if     vProxy ne ""
     5476         and vProxy ne ?
     5477      then do:
     5478         mDiadocApi:ProxyMode =  "UseProxy".
     5479         mDiadocApi:ProxySettings:Url = vProxy.
     5480         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     5481         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     5482      end.
     5483      define variable vtest as component-handle no-undo.
     5484      vtest = mDiadocApi:TestConnection2().
     5485      if not vtest:ConnectionSuccess
     5486      then do:
     5487         PutMes(vtest:ErrorText).
     5488      end.
     5489      else
     5490         mDiadocConnection = mDiadocApi:CreateConnectionByCertificate(iThumbprint,"") no-error.
     5491      if mDiadocConnection eq ?
     5492      then
     5493         PutErr("DiadocApi:CreateConnectionByCertificate:").
     5494      release object vtest.
     5495      return mDiadocConnection.
     5496   end.
     5497   function ConectByLogin return component-handle
     5498   ():
     5499      define variable vSSl as character no-undo.
     5500      if mDiadocApi eq ? then return ?.
     5501      mDiadocApi:ApiClientId = getextAttr('diadoc-key':U).
     5502      mDiadocApi:ServerUrl   = getextAttr('server-addr':U).
     5503      if mDiadocApi:ApiClientId eq ""
     5504         or  mDiadocApi:ServerUrl eq ""
     5505      then do:
     5506        PutMes( "Error Не задан адрес сервера или ключ разработчика для внешей системы Диадок").
     5507        release object mDiadocConnection no-error.
     5508        return ?.
     5509     end.
     5510     vSSl =  getextAttr('diadoc-ssl':U).
     5511     if vSSl ne ""
     5512        and logical(vSSl)
     5513     then
     5514         mDiadocApi:VerifySslCertificate = no.
     5515     define variable VProxy as character no-undo.
     5516      vProxy =  getextAttr('proxy-addr':U).
     5517      if     vProxy ne ""
     5518         and vProxy ne ?
     5519      then do:
     5520         mDiadocApi:ProxyMode =  "UseProxy".
     5521         mDiadocApi:ProxySettings:Url = vProxy.
     5522         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     5523         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     5524      end.
     5525      mDiadocConnection = mDiadocAPI:CreateConnectionByLogin(getextAttr('diadoc-user':U),getextAttr('diadoc-pwd':U)) no-error.
     5526      define variable vi as integer no-undo.
     5527      if mDiadocConnection eq ?
     5528      then
     5529         PutErr("DiadocAPI:CreateConnectionByLogin").
     5530      return mDiadocConnection.
     5531   end.
     5532   function GetDocumforid returns character
     5533   (input  iorg as character ,
     5534    input  idoc-id as character ,
     5535    output oDocument      as component-handle
     5536     ):
     5537      define variable vOrganization  as component-handle no-undo.
     5538      define variable vDocument      as component-handle no-undo.
     5539      define buffer utd           for ub.utd.
     5540      if
     5541             iorg  ne ?
     5542         and iorg  ne ""
     5543         and idoc-id ne ?
     5544         and idoc-id ne ""
     5545      then do:
     5546         vOrganization = mDiadocConnection:GetOrganizationById(iorg) no-error.
     5547         if vOrganization ne ?
     5548         then do:
     5549            oDocument = vOrganization:GetDocumentById(idoc-id,false) no-error.
     5550            if oDocument eq ?
     5551            then
     5552               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", iorg,idoc-id)).
     5553         end.
     5554         else do:
     5555            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", iorg,idoc-id)).
     5556            return "Нет доступа к организации " + iorg.
     5557         end.
     5558      end.
     5559      else
     5560         return "Нет доступа к организации не ЭДО".
     5561      release object vOrganization no-error.
     5562      return "".
     5563   end.
     5564   function GetDocum returns character
     5565   (input  idb-num as integer,
     5566    input  idoc-id as integer,
     5567    output oDocument      as component-handle
     5568     ):
     5569      define variable vOrganization  as component-handle no-undo.
     5570      define variable vDocument      as component-handle no-undo.
     5571      define buffer utd           for ub.utd.
     5572      find first utd where utd.db-num eq idb-num
     5573                       and utd.doc-id eq idoc-id
     5574      no-lock no-error.
     5575      if     available utd
     5576         and utd.OrganizationExt ne ?
     5577         and utd.OrganizationExt ne ""
     5578         and utd.DocumentExt ne ?
     5579         and utd.DocumentExt ne ""
     5580      then do:
     5581         vOrganization = mDiadocConnection:GetOrganizationById(utd.OrganizationExt) no-error.
     5582         if vOrganization ne ?
     5583         then do:
     5584            oDocument = vOrganization:GetDocumentById(utd.DocumentExt,false) no-error.
     5585            if oDocument eq ?
     5586            then
     5587               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", utd.OrganizationExt,utd.DocumentExt)).
     5588            release object vOrganization no-error.
     5589         end.
     5590         else do:
     5591            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", utd.OrganizationExt,utd.DocumentNumber)).
     5592            return "Нет доступа к организации " + utd.OrganizationExt.
     5593         end.
     5594      end.
     5595      else
     5596         return "Нет доступа к организации не ЭДО".
     5597      return "".
     5598   end.
     5599   function GetFirstUTDinPack returns logical
     5600   (input idb-num as integer,
     5601    input idoc-id as integer,
     5602    output odb-num as integer,
     5603    output odoc-id as integer ):
     5604      define buffer buf_utd for utd.
     5605      define buffer     utd for utd.
     5606      find first utd where utd.db-num eq idb-num
     5607                       and utd.doc-id eq idoc-id
     5608      no-lock no-error.
     5609      if available utd
     5610      then do:
     5611         if utd.PackageId eq ""
     5612         then do:
     5613            assign
     5614               odb-num = utd.db-num
     5615               odoc-id = utd.doc-id
     5616            .
     5617            return yes.
     5618         end.
     5619         else do:
     5620            find first buf_utd where Buf_utd.PackageId eq utd.PackageId
     5621                                 and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5622            no-lock.
     5623            assign
     5624               odb-num = buf_utd.db-num
     5625               odoc-id = buf_utd.doc-id
     5626            .
     5627            return if available buf_utd then (recid(utd) eq recid(buf_utd)) else no.
     5628         end.
     5629      end.
     5630      return ?.
     5631   end.
     5632   function AddOADLine returns integer
     5633   (iDb-num  as integer ,
     5634    iDoc-id  as integer ,
     5635    ilinenum as integer ,
     5636    iGtin    as char,
     5637    iQnty    as int,
     5638    isite    as character ):
     5639       define buffer utd-marking-lines      for ub.utd-marking-lines.
     5640       define variable vnewMark as character no-undo.
     5641       define variable vQnty    as integer   no-undo.
     5642       vnewMark = "02" + iGtin + "37" + string(iQnty).
     5643       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
     5644                                      and utd-marking-lines.db-num     = idb-num
     5645                                      and utd-marking-lines.doc-id     = idoc-id
     5646                                      and utd-marking-lines.Linenum    = iLinenum
     5647       exclusive-lock no-error.
     5648       if available utd-marking-lines
     5649       then do:
     5650          delete utd-marking-lines.
     5651          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
     5652       end.
     5653       else do:
     5654          create utd-marking-lines.
     5655          assign
     5656             utd-marking-lines.mark      = vnewMark
     5657             utd-marking-lines.db-num    = idb-num
     5658             utd-marking-lines.doc-id    = idoc-id
     5659             utd-marking-lines.Linenum   = iLinenum
     5660             utd-marking-lines.site      = isite
     5661             utd-marking-lines.doc-level = 1
     5662             utd-marking-lines.gds-code  = ?
     5663          .
     5664          vQnty = iQnty.
     5665       end.
     5666       return vQnty.
     5667    end.
     5668   function addMarkforUtd returns recid
     5669   (iDb-num  as integer ,
     5670    iDoc-id  as integer ,
     5671    ilinenum as integer ,
     5672    iMark as character  ,
     5673    isite   as character,
     5674    iUtdType as character    ):
     5675       define buffer     marking            for ub.marking.
     5676       define buffer     marking-attr       for ub.marking-attr.
     5677       define buffer utd-marking-lines      for ub.utd-marking-lines.
     5678       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     5679       define variable vMRC  as decimal no-undo.
     5680       define variable vQnty as decimal no-undo.
     5681      define variable vRec as recid no-undo.
     5682      if     imark ne "-"
     5683         and imark ne ""
     5684         and imark ne ?
     5685      then do:
     5686         imark = repTegforDm(imark).
     5687         vQnty = getQntyUTDByCodId(imark) .
     5688         find first utd-marking-lines where utd-marking-lines.mark       = imark
     5689                                        and utd-marking-lines.db-num     = idb-num
     5690                                        and utd-marking-lines.doc-id     = idoc-id
     5691                                        and utd-marking-lines.Linenum    = iLinenum
     5692         exclusive-lock no-error.
     5693         if not available utd-marking-lines
     5694         then do:
     5695            create utd-marking-lines.
     5696            assign
     5697               utd-marking-lines.mark      = imark
     5698               utd-marking-lines.db-num    = idb-num
     5699               utd-marking-lines.doc-id    = idoc-id
     5700               utd-marking-lines.Linenum   = iLinenum
     5701               utd-marking-lines.site      = isite
     5702               utd-marking-lines.doc-level = 1
     5703               utd-marking-lines.gds-code  = ?
     5704            .
     5705            create utd-marking-lines-attr.
     5706            assign
     5707               utd-marking-lines-attr.mark      = imark
     5708               utd-marking-lines-attr.db-num    = idb-num
     5709               utd-marking-lines-attr.doc-id    = idoc-id
     5710               utd-marking-lines-attr.Linenum   = iLinenum
     5711               utd-marking-lines-attr.attr-code = "box-qnty"
     5712               utd-marking-lines-attr.attr-value = string(vQnty)
     5713            .
     5714            vRec = recid(utd-marking-lines).
     5715            release utd-marking-lines-attr.
     5716            release utd-marking-lines.
     5717         end.
     5718         else do:
     5719            if    (    isite eq "-"
     5720               and utd-marking-lines.site eq "+")
     5721            or (    isite eq "+"
     5722               and utd-marking-lines.site eq "-")
     5723            then
     5724               delete utd-marking-lines.
     5725            else if isOAD (imark)
     5726            then do:
     5727               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
     5728               create utd-marking-lines-attr.
     5729               assign
     5730                  utd-marking-lines-attr.mark      = imark
     5731                  utd-marking-lines-attr.db-num    = idb-num
     5732                  utd-marking-lines-attr.doc-id    = idoc-id
     5733                  utd-marking-lines-attr.Linenum   = iLinenum
     5734                  utd-marking-lines-attr.attr-code = "box-qnty"
     5735                  utd-marking-lines-attr.attr-value = string(vQnty)
     5736               .
     5737            end.
     5738            vRec = recid(utd-marking-lines).
     5739            release utd-marking-lines.
     5740         end.
     5741         if isMark (imark)
     5742         then do:
     5743            find first marking where marking.mark eq iMark exclusive-lock no-error.
     5744            if not available marking
     5745            then do:
     5746               create marking.
     5747               marking.mark = iMark.
     5748               marking.gds-code = ?.
     5749               marking.unit     = getLevelUTDByCodId(marking.mark) .
     5750            end.
     5751            assign
     5752              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
     5753                                      getLevelMotpByCodId(marking.mark)
     5754                                   else marking.unit-ext
     5755              marking.box-qnty   = vQnty
     5756              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
     5757            .
     5758            if        (     iUtdType eq "UniversalTransferDocument"
     5759                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
     5760            then
     5761               marking.sts = ?.
     5762         end.
     5763      end.
     5764      return vRec.
     5765   end.
     5766   function isSaleMarkInUpak returns logical
     5767   (iMark    as char ):
     5768      define buffer buf_marking       for ub.marking.
     5769      for each buf_marking no-lock where
     5770               buf_marking.mark-parent = iMark
     5771      :
     5772        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
     5773           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
     5774          return true.
     5775        if isSaleMarkInUpak(buf_marking.mark) then
     5776          return true.
     5777      end.
     5778      return false.
     5779    end.
     5780   function setStatusUpak returns logical
     5781   (iDbNum   as integer ,
     5782    iDocId   as integer ,
     5783    iLineNum as integer ,
     5784    iMark    as char ,
     5785    iSts     as integer):
     5786      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     5787      define buffer buf_marking           for ub.marking.
     5788      for each buf_marking exclusive-lock where
     5789               buf_marking.mark-parent = iMark,
     5790         first buf_utd-marking-lines exclusive-lock where
     5791               buf_utd-marking-lines.doc-id  = iDocId
     5792           and buf_utd-marking-lines.db-num  = iDbNum
     5793           and buf_utd-marking-lines.lineNum = iLineNum
     5794           and buf_utd-marking-lines.mark = buf_marking.mark
     5795      :
     5796        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
     5797      end.
     5798      for first buf_utd-marking-lines exclusive-lock where
     5799                buf_utd-marking-lines.doc-id  = iDocId
     5800            and buf_utd-marking-lines.db-num  = iDbNum
     5801            and buf_utd-marking-lines.lineNum = iLineNum
     5802            and buf_utd-marking-lines.mark = iMark,
     5803          first buf_marking exclusive-lock where
     5804                buf_marking.mark = buf_utd-marking-lines.mark
     5805      :
     5806        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
     5807        then do:
     5808          assign
     5809            buf_utd-marking-lines.sts = iSts
     5810            buf_marking.sts           = iSts
     5811          .
     5812        end.
     5813      end.
     5814      return true.
     5815   end.
     5816   define temp-table tt-recid no-undo
     5817             field orgid as char
     5818             field docid as char
     5819             field parent as char
     5820             field stamp as datetime
     5821             index pi orgid docid
     5822             index parent parent  stamp.
     5823   function ProcessSystemMessStart return component-handle
     5824   (IStartStop as logical):
     5825      if mDiadocConnection eq ? then
     5826      define variable vOrganizationList as component-handle no-undo.
     5827      define variable vOrganization as component-handle no-undo.
     5828      define variable vReceiptGenerationProcess as component-handle no-undo.
     5829      define variable vi as integer no-undo.
     5830      if mDiadocConnection ne ?
     5831      then do:
     5832         vOrganizationList = mDiadocConnection:GetOrganizationList().
     5833          do vi = 1 to vOrganizationList:count:
     5834             vOrganization = vOrganizationList:GetItem(vi - 1 ).
     5835             vReceiptGenerationProcess = vOrganization:GetReceiptGenerationProcess().
     5836             release object vOrganization.
     5837             if IStartStop
     5838             then
     5839                vReceiptGenerationProcess:Start().
     5840             else
     5841                vReceiptGenerationProcess:Stop().
     5842             release object vReceiptGenerationProcess.
     5843          end.
     5844          release object vOrganizationList.
     5845      end.
     5846   end.
     5847   procedure  changeIdToGuid :
     5848   define input  parameter iOrganization as component-handle no-undo.
     5849      define variable vOrgId   as character no-undo.
     5850      define variable vOrgGuid as character no-undo.
     5851      define buffer utd for utd.
     5852      assign
     5853         vOrgId   = iOrganization:id.
     5854         vOrgGuid = iOrganization:guid
     5855      no-error.
     5856      if     error-status:num-messages eq 0
     5857         and vOrgId   ne ""
     5858         and vOrgGuid ne ""
     5859      then do:
     5860         define variable vfirst as logical no-undo init yes.
     5861         repeat preselect each utd where utd.OrganizationExt = vOrgId exclusive-lock:
     5862            find next utd.
     5863            if vfirst
     5864            then do:
     5865               PutMes("Конвертация документов").
     5866               vfirst = no.
     5867            end.
     5868            utd.OrganizationExt = vOrgGuid.
     5869            validate utd.
     5870            PutMes(substitute ("У документа &1 изменен индификатор организации с &2 на &3",ub.utd.DocumentNumber,vOrgId,utd.OrganizationExt)).
     5871         end.
     5872         if not vfirst
     5873         then
     5874            PutMes("Конвертация документов завершина.").
     5875      end.
     5876   end.
     5877   procedure getNewUpd :
     5878      define variable VLastDate as date no-undo init ?.
     5879      define variable vDocument     as component-handle no-undo.
     5880      define variable vYear         as integer no-undo.
     5881      define variable vMonth        as integer no-undo.
     5882      define variable vDay          as integer no-undo.
     5883      define variable vBegLoadDate  as date    no-undo.
     5884      define variable vLastLoadDate as date    no-undo.
     5885      define buffer utd for utd.
     5886      VLastDate = date( getextAttr('diadoc-lastload':U)) no-error.
     5887      find first sys-ctrl no-lock.
     5888      if VLastDate eq ?
     5889      then
     5890         VLastDate = sys-ctrl.cut-date + 3.
     5891      else if sys-ctrl.cut-date ne ?
     5892      then
     5893         VLastDate = max(VLastDate,sys-ctrl.cut-date + 3) .
     5894      vLastLoadDate = VLastDate.
     5895      for each tt-recid:
     5896         delete tt-recid.
     5897      end.
     5898      if chekStop() then return "Остановка пользователем".
     5899       run  UpdateUTDInform(if VLastDate eq ? then today - 365 else VLastDate - 3,today + 1,output VLastDate).
     5900      if chekStop() then return "Остановка пользователем".
     5901      if VLastDate ne ?
     5902      then do:
     5903         setextAttr('diadoc-lastload':U,string(VLastDate)).
     5904         vYear = year(vLastLoadDate).
     5905         vMonth = month(vLastLoadDate) - 2.
     5906         vDay   = day(vLastLoadDate).
     5907         if vMonth <= 0 then
     5908            assign
     5909               vMonth = vMonth + 12
     5910               vYear  = vYear - 1
     5911               .
     5912         repeat:
     5913            vBegLoadDate = date(vMonth, vDay, vYear) no-error.
     5914            if error-status:error then
     5915               vDay = vDay - 1.
     5916            else
     5917               leave.
     5918         end.
     5919         vBegLoadDate = vBegLoadDate + 1.
     5920      end.
     5921      block-rec:
     5922      for each tt-recid break by tt-recid.parent descending by tt-recid.stamp descending :
     5923         if  tt-recid.parent eq ""
     5924         then next  block-rec.
     5925         if first-of (tt-recid.parent)
     5926         then do:
     5927            for each utd where utd.PackageId eq tt-recid.parent
     5928            no-lock break by utd.PackageId descending by utd.Timestamp descending :
     5929               if chekStop() then return "Остановка пользователем".
     5930               if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     5931               then do:
     5932                  subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     5933                  MySeqUtd = ?.
     5934                  CrEdoc(utd.PackageId,utd.Timestamp).
     5935                  unsubscribe "getNextseq".
     5936                  next block-rec.
     5937               end.
     5938            end.
     5939         end.
     5940      end.
     5941      PutMes("Обновление информации по ранее загруженным документам за период c " + (if vBegLoadDate <> ? then
     5942                                                                                        string(vBegLoadDate)
     5943                                                                                     else "?")
     5944                                                                                     + " по " +
     5945                                                                                     (if vLastLoadDate <> ? then
     5946                                                                                         string(vLastLoadDate)
     5947                                                                                      else
     5948                                                                                         "?")
     5949                                                                                      ).
     5950      define variable vobj as character no-undo.
     5951      vobj = getExtAttr('host-code':U).
     5952      if vobj ne "0"
     5953      then
     5954          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     5955                         and utd.host-code eq int(vobj)
     5956                         and (   utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5957                              or utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     5958                              )
     5959          no-lock break by utd.OrganizationExt:
     5960             if chekStop() then return "Остановка пользователем".
     5961             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     5962             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     5963                                   and tt-recid.docid = utd.DocumentExt
     5964                    no-error.
     5965             if     not available tt-recid
     5966                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     5967             then do:
     5968                 run  UpdateUTDInformOne(vDocument).
     5969                release object vDocument no-error.
     5970             end.
     5971          end.
     5972      vobj = getExtAttr('obj':U).
     5973      if vobj ne ""
     5974      then
     5975          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     5976                         and utd.obj-type + string(utd.obj-code) eq vobj
     5977          no-lock break by utd.OrganizationExt:
     5978             if chekStop() then return "Остановка пользователем".
     5979             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     5980             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     5981                                   and tt-recid.docid = utd.DocumentExt
     5982                    no-error.
     5983             if     not available tt-recid
     5984                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     5985             then do:
     5986                 run  UpdateUTDInformOne(vDocument).
     5987                release object vDocument no-error.
     5988             end.
     5989          end.
     5990   end.
     5991   procedure  SendAuto:
     5992    define variable vOrganization as component-handle no-undo.
     5993    define variable vOrganizationList as component-handle no-undo.
     5994    define variable vi as integer no-undo.
     5995      if mDiadocConnection eq ?
     5996      then do:
     5997         message "По данному сертификату не удалось подключиться к Диадок"
     5998         view-as alert-box.
     5999      end.
     6000      else do:
     6001         for each tt-recid:
     6002            delete tt-recid.
     6003         end.
     6004         vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     6005         if vOrganizationList eq ? then return error ?.
     6006         vi = vOrganizationList:Count()no-error.
     6007         if vi eq ?
     6008         then
     6009            return error ?.
     6010         do vi = 1 to vOrganizationList:Count() :
     6011            vOrganization = vOrganizationList:GetItem(vi - 1 ).
     6012            define variable vorgid as character no-undo.
     6013            vorgid = vOrganization:guid.
     6014            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6015                           and utd.host-code eq v-cntxt-host-code-obj
     6016                           and utd.OrganizationExt eq vorgid
     6017            no-lock:
     6018                run  SendReceiptsAsync(utd.db-num,utd.doc-id).
     6019            end.
     6020            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6021                           and utd.host-code eq v-cntxt-host-code-obj
     6022                           and utd.OrganizationExt eq vorgid
     6023            no-lock:
     6024                run  updOneUTD(utd.db-num,utd.doc-id).
     6025            end.
     6026         end.
     6027      end.
     6028   end.
     6029   procedure SendAccept:
     6030      define input  parameter iTypeAccept     as character no-undo.
     6031      define input  parameter iReplyTask      as component-handle no-undo.
     6032      define input  parameter iOrganizationGuid as character no-undo.
     6033      define input  parameter iWorkflowId     as integer no-undo.
     6034      define input  parameter iTitleTypes    as character  no-undo.
     6035      define output parameter oOperationCode as character no-undo.
     6036      define variable vContentItems as component-handle no-undo.
     6037      define variable vContentItem  as component-handle no-undo.
     6038      define variable vSigner       as component-handle no-undo.
     6039      define variable vBuyerTitle   as component-handle no-undo.
     6040      define variable vEmployee     as component-handle no-undo.
     6041      define variable vContentOperCode as component-handle no-undo.
     6042      define variable vOrganization   as component-handle no-undo.
     6043      define variable vUserperm   as component-handle no-undo.
     6044      define variable vi as integer no-undo.
     6045     define variable vdate as date no-undo.
     6046     define variable vDocumentCreator as character no-undo.
     6047     define variable vDocumentCreatorBase as character no-undo.
     6048     define variable vOperationCode as character no-undo.
     6049     define variable vOperationContenttext as character no-undo.
     6050     define variable vOperationContent as character no-undo.
     6051     define variable vThumbprint as character no-undo.
     6052     define variable vJobTitle   as character no-undo.
     6053     vThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6054     vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     6055     if vOrganization eq ?
     6056     then do:
     6057        run str\utdacp.w (output vdate, output  vDocumentCreator, output vDocumentCreatorBase, output vOperationCode, output vOperationContent) no-error.
     6058        if vdate eq ?
     6059        then
     6060           return error "".
     6061     end.
     6062     else do:
     6063        define variable vTitleType as character no-undo.
     6064        define variable vSignSet   as component-handle no-undo.
     6065        define variable vSeller as logical no-undo.
     6066        vUserperm = vOrganization:GetUserPermissions().
     6067        vJobTitle = vUserperm:JobTitle.
     6068        release object vUserperm.
     6069        blk-tit:
     6070        do vi = 1 to num-entries(iTitleTypes):
     6071           vTitleType = entry(vi,iTitleTypes).
     6072           vSeller = index(vTitleType,"Seller") > 0.
     6073           if vSeller
     6074           then
     6075              next blk-tit.
     6076           vSignSet = vOrganization:GetExtendedSignerDetails2(vThumbprint, vTitleType) no-error.
     6077           if error-status:num-messages > 0
     6078           then do:
     6079              define variable vTasksetSign   as component-handle no-undo.
     6080              define variable vTasksetSignDetal   as component-handle no-undo.
     6081              vTasksetSign = vOrganization:CreateSetExtendedSignerDetailsTask(VThumbprint).
     6082              getdesc(vTasksetSign).
     6083              vTasksetSign:DocumentTitleType = vTitleType.
     6084              getdesc(vTasksetSign).
     6085              vTasksetSignDetal = vTasksetSign:ExtendedSignerDetailsToPost.
     6086              getdesc(vTasksetSignDetal).
     6087              vTasksetSignDetal:JobTitle  = vJobTitle    .
     6088              vTasksetSignDetal:SignerType = "LegalEntity" .
     6089              vTasksetSignDetal:SignerInfo = "".
     6090              vTasksetSignDetal:Powers = if VSeller then "InvoiceSigner"  else "PersonDocumentedOperation".
     6091              vTasksetSignDetal:Status = if VSeller then "SellerEmployee" else "BuyerEmployee".
     6092              vTasksetSignDetal:PowersBase = "Должностные обязанности".
     6093              getdesc(vTasksetSignDetal).
     6094              release object vTasksetSignDetal.
     6095              vTasksetSign:send() no-error.
     6096              if error-status:num-messages > 0 then do:
     6097                 PutErr(substitute("Error Ошибка при установке подписанта по документу &1 ", vTitleType )).
     6098              end.
     6099              release object vTasksetSign.
     6100           end.
     6101           else do:
     6102              getdesc(vSignSet).
     6103              release object vSignSet.
     6104           end.
     6105        end.
     6106        vOperationContent = if iTypeAccept eq "AcceptDocumentWithDisc"
     6107                            then "2"
     6108                            else if iTypeAccept eq "AcceptDocumentNotAccepted"
     6109                            then "3"
     6110                            else "1".
     6111        vdate = today.
     6112        vDocumentCreator = substitute("&1, ИНН~/КПП &2~/&3", vOrganization:name , vOrganization:inn , vOrganization:kpp).
     6113        release object vOrganization.
     6114     end.
     6115     if    vJobTitle eq ?
     6116        or vJobTitle eq ""
     6117     then
     6118        vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6119      if (   iWorkflowId = 3
     6120         or iWorkflowId = 5
     6121         or iWorkflowId = 8
     6122         or iWorkflowId = 11
     6123         or iWorkflowId = 12
     6124         or iWorkflowId = 13
     6125         or iWorkflowId = 16)
     6126         and iReplyTask ne ?
     6127      then do:
     6128         getdesc(iReplyTask).
     6129         vContentItems = iReplyTask:ContentItems.
     6130         getdesc(vContentItems).
     6131         do vi = 1 to vContentItems:count:
     6132            getdesc(vContentItems:GetItem(vi - 1 )).
     6133            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6134            vContentItem = vContentItems:GetItem(vi - 1 ):Content.
     6135            getdesc(vContentItem).
     6136            vBuyerTitle = vContentItem:UniversalTransferDocumentBuyerTitle no-error.
     6137            getdesc(vBuyerTitle).
     6138              if vBuyerTitle eq ?
     6139            then do:
     6140               vBuyerTitle = vContentItem:UniversalCorrectionDocumentBuyerTitle.
     6141               getdesc(vBuyerTitle).
     6142               vOperationContenttext = "C изменением стоимости согласен".
     6143            end.
     6144            else do:
     6145               oOperationCode = vOperationContent.
     6146      vOperationContenttext = if vOperationContent eq "1"
     6147                          then "Принято без разногласий"
     6148                          else if vOperationContent eq "2"
     6149                          then "Принято с разногласиями"
     6150                          else if vOperationContent eq "3"
     6151                          then "Товары не приняты"
     6152                          else vOperationContent.
     6153               getdesc(vBuyerTitle).
     6154               vEmployee = vBuyerTitle:Employee.
     6155               getdesc(vEmployee).
     6156               define variable vUser   as component-handle no-undo.
     6157               vUser = mDiadocConnection:GetMyUser().
     6158               getdesc(vUser).
     6159               vEmployee:position        = vJobTitle    .
     6160               vEmployee:FirstName       = vUser:FirstName  .
     6161               vEmployee:LastName        = vUser:LastName   .
     6162               vEmployee:MiddleName      = vUser:MiddleName .
     6163               vEmployee:EmployeeBase     = "Должностные обязанности".
     6164               release object vUser.
     6165               getdesc(vEmployee).
     6166               getdesc(mDiadocConnection:Certificate).
     6167               getdesc(vContentItem:UniversalTransferDocumentBuyerTitle).
     6168               getdesc(vBuyerTitle:ContentOperCode).
     6169               vContentOperCode = vBuyerTitle:ContentOperCode.
     6170               vContentOperCode:TotalCode = vOperationContent.
     6171               vBuyerTitle:OperationCode   = oOperationCode.
     6172               release object vContentOperCode.
     6173               release object vEmployee.
     6174            end.
     6175            vBuyerTitle:DocumentCreator = vDocumentCreator .
     6176            vBuyerTitle:DocumentCreatorBase     = vDocumentCreatorBase.
     6177            vBuyerTitle:OperationContent =  vOperationContenttext.
     6178            vBuyerTitle:AcceptanceDate   = vdate.
     6179            getdesc(vBuyerTitle).
     6180            getdesc(vBuyerTitle:Signers).
     6181            vSigner = vBuyerTitle:Signers:additems().
     6182            getdesc(vSigner).
     6183            getdesc(vSigner:SignerReference).
     6184            getdesc(vSigner:SignerDetails).
     6185            vSigner:SignerReference:CertificateThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6186            vSigner:SignerReference:boxid = iOrganizationGuid.
     6187            getdesc(vSigner:SignerReference).
     6188            release object vBuyerTitle no-error.
     6189            release object vContentItem.
     6190         end.
     6191         release object vContentItems.
     6192      end.
     6193   end.
     6194   function SendAnswer returns character
     6195   (iReplyTask as component-handle,iorg as char,iTypeAnswer as character,imes as longchar ):
     6196      define variable vContent       as component-handle no-undo.
     6197      define variable vContentItems  as component-handle no-undo.
     6198      define variable vSigner        as component-handle no-undo.
     6199      define variable vSignTask      as component-handle no-undo.
     6200      define variable vOrganization  as component-handle no-undo.
     6201      define variable vUserperm      as component-handle no-undo.
     6202      define variable vUser          as component-handle no-undo.
     6203      define variable vi as integer no-undo.
     6204      if     itypeAnswer ne "AcceptRevocation"
     6205         and iReplyTask  ne ?
     6206      then do:
     6207         getdesc(iReplyTask).
     6208         vContentItems = iReplyTask:ContentItems.
     6209         getdesc(vContentItems).
     6210         do vi = 1 to vContentItems:count:
     6211            getdesc(vContentItems:GetItem(vi - 1 )).
     6212            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6213            vContent = vContentItems:GetItem(vi - 1 ):Content.
     6214            vContent:comment =  imes.
     6215           getdesc(vContent).
     6216            vSigner = vContent:Signer.
     6217            getdesc(vSigner).
     6218            vOrganization = mDiadocConnection:GetOrganizationById(iOrg) no-error.
     6219            vUserperm = vOrganization:GetUserPermissions().
     6220            define variable vJobTitle as character no-undo.
     6221            vJobTitle = vUserperm:JobTitle.
     6222            if    vJobTitle eq ?
     6223               or vJobTitle eq ""
     6224            then
     6225               vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6226            release object vUserperm.
     6227            release object vOrganization.
     6228            vUser = mDiadocConnection:GetMyUser().
     6229            getdesc(vUser).
     6230            vSigner:Surname    = vUser:FirstName.
     6231            vSigner:FirstName  = vUser:LastName.
     6232            vSigner:Patronymic = vUser:MiddleName.
     6233            vSigner:JobTitle   = vJobTitle.
     6234            vSigner:Inn        = mDiadocConnection:Certificate:inn.
     6235            getdesc(vSigner).
     6236            release object vUser.
     6237            release object vSigner.
     6238            release object vContent.
     6239         end.
     6240         release object vContentItems.
     6241      end.
     6242   end.
     6243   procedure send:
     6244      define input  parameter iDocument as component-handle no-undo.
     6245      define input  parameter iTypeAnswer as character no-undo.
     6246      define input  parameter icomment as character no-undo.
     6247      define output parameter oOperationCode as character no-undo.
     6248      define variable vReplyTask    as component-handle no-undo.
     6249      define variable vTypeAnswer as character no-undo.
     6250      define variable vTypeAnswer_orig as character no-undo.
     6251      define variable Vmes as longchar  no-undo.
     6252      define variable vOrganizationGuid as character no-undo.
     6253      define variable vDocumentid as character no-undo.
     6254      define variable vi as integer no-undo.
     6255      if iDocument ne ?
     6256      then do:
     6257         case iTypeAnswer:
     6258            when "Подписания"                 then vTypeAnswer =  "AcceptDocument".
     6259            when "отказ подписи"              then vTypeAnswer =  "RejectDocument".
     6260            when "запрос коректировки"        then vTypeAnswer =  "CorrectionRequest".
     6261            when "Запрос анулирование"        then vTypeAnswer =  "RevocationRequest".
     6262            when "Подтверждение анулирования" then vTypeAnswer =  "AcceptRevocation".
     6263            when "отказ анулирования"         then vTypeAnswer =  "RejectRevocation".
     6264            when "подписать с расхождениями"  then vTypeAnswer =  "AcceptDocumentWithDisc".
     6265            when "подписать товар не принят"  then vTypeAnswer =  "AcceptDocumentNotAccepted".
     6266            otherwise vTypeAnswer = iTypeAnswer .
     6267         end case.
     6268         vTypeAnswer_orig = vTypeAnswer.
     6269         if    vTypeAnswer =  "AcceptDocumentWithDisc"
     6270            or vTypeAnswer =  "AcceptDocumentNotAccepted"
     6271         then
     6272            vTypeAnswer =  "AcceptDocument".
     6273         if mDiadocConnection:AuthenticateType ne "Certificate" then return error "не сертификат".
     6274         vReplyTask = iDocument:CreateReplySendTask2(vTypeAnswer).
     6275         vOrganizationGuid = iDocument:OrganizationGuid.
     6276         vDocumentid     = iDocument:DocumentId.
     6277         getdesc(iDocument).
     6278         if vTypeAnswer =  "AcceptDocument"
     6279         then do:
     6280            define variable vtitletype as character no-undo.
     6281            vTitleType = GetDocTitleType(vOrganizationGuid,iDocument:TypeNamedId,iDocument:DocumentFunction,iDocument:Version).
     6282            run sendAccept in this-procedure (vTypeAnswer_orig,
     6283                                              vReplyTask,
     6284                                              iDocument:OrganizationGuid,
     6285                                              iDocument:WorkflowId,
     6286                                              vtitletype,
     6287                                              output oOperationCode ) no-error.
     6288            if error-status:error
     6289            then
     6290               return error "".
     6291         end.
     6292         else do:
     6293            find first utd where utd.DocumentExt     = vDocumentid
     6294                             and utd.OrganizationExt = vOrganizationGuid
     6295            no-lock no-error.
     6296            if available utd
     6297            then do:
     6298               if   vTypeAnswer ne  "CorrectionRequest"
     6299                   and vTypeAnswer ne  "RejectDocument"
     6300               then
     6301                  icomment = "".
     6302               if vTypeAnswer eq  "RejectDocument"
     6303               then do:
     6304                  if icomment eq ? or icomment eq "" then icomment = utd.comment.
     6305                  Vmes = (if icomment ne ? and icomment ne "" then icomment + "," else "" ) + GetErrForUtdStr(utd.db-num,utd.doc-id,?).
     6306               end.
     6307               else do:
     6308                   Vmes = GetErrForUtd(utd.db-num,utd.doc-id,?) .
     6309                   Vmes = GetErrComText(icomment,Vmes).
     6310               end.
     6311               if mFlaftest
     6312               then do:
     6313                  output stream File-stream to "SendAnswer.txt" .
     6314                  put stream File-stream unformatted string(Vmes).
     6315                  output stream File-stream close.
     6316                  message "сформирован файл " search("SendAnswer.txt")
     6317                  view-as alert-box.
     6318                  return error "ничего не отправляем".
     6319               end.
     6320               else
     6321                  SendAnswer(vReplyTask,iDocument:OrganizationGuid, iTypeAnswer,Vmes) no-error.
     6322               if error-status:error
     6323               then
     6324                  return error "".
     6325               end.
     6326            end.
     6327         if not mFlaftest
     6328         then do:
     6329            getdesc(vReplyTask).
     6330             vReplyTask:Send() no-error.
     6331            if error-status:num-messages > 0 then do:
     6332               Puterr(substitute("Error Ошибка при выполнение действия по документу &1. ", vDocumentid )).
     6333               release object vReplyTask.
     6334               return error "Ошибка при выполнение дейстия с документом".
     6335            end.
     6336         end.
     6337      end.
     6338   end.
     6339   procedure SendReceiptsAsync :
     6340   define input  parameter idb-num as integer no-undo.
     6341   define input  parameter idoc-id as integer no-undo.
     6342      define variable vDocument as component-handle no-undo.
     6343      define buffer utd for utd.
     6344      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     6345      then do:
     6346         PutMes(substitute("Обработка подписи ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     6347         define variable vAsyncResult   as component-handle no-undo.
     6348         vAsyncResult = vDocument:SendReceiptsAsync().
     6349         release object vDocument.
     6350         PutMes(substitute("Запущена асинхронная обработка ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     6351         find first utd where utd.db-num eq idb-num
     6352                          and utd.doc-id eq idoc-id
     6353         exclusive-lock no-error.
     6354         if available utd
     6355         then do:
     6356            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6357            then do:
     6358                run  UpdateUTDInformOne(vDocument).
     6359               release object vDocument.
     6360            end.
     6361            utd.flagRI = yes.
     6362       end.
     6363         PutMes(vAsyncResult:Result).
     6364         release object vAsyncResult.
     6365         if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6366         then do:
     6367             run  UpdateUTDInformOne(vDocument).
     6368            release object vDocument.
     6369         end.
     6370      end.
     6371   end.
     6372   procedure SendAnsver:
     6373      define input  parameter idb-num as integer no-undo.
     6374      define input  parameter idoc-id as integer no-undo.
     6375      define input  parameter iTypeAnswer as character no-undo.
     6376      define input  parameter iComment as character no-undo.
     6377      define variable vSendcode as character no-undo.
     6378      define variable vDocument as component-handle no-undo.
     6379      define buffer utd for utd.
     6380      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     6381      then do:
     6382         PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2",idb-num,idoc-id,iTypeAnswer)).
     6383          run   SendReceiptsAsync(idb-num,idoc-id).
     6384            find first utd where utd.db-num eq idb-num
     6385                                   and utd.doc-id eq idoc-id
     6386                  no-lock.
     6387         if      (not utd.AmendmentRequested
     6388             and  iTypeAnswer eq "CorrectionRequest")
     6389             or iTypeAnswer ne "CorrectionRequest"
     6390         then do:
     6391             run   send in this-procedure (vDocument,iTypeAnswer,iComment,output vSendcode) no-error.
     6392            if error-status:error
     6393            then do:
     6394               release object vDocument.
     6395               return error return-value.
     6396            end.
     6397            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 Завершина",idb-num,idoc-id,iTypeAnswer)).
     6398         end.
     6399         else
     6400            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 пропущена",idb-num,idoc-id,iTypeAnswer)).
     6401         release object vDocument.
     6402         if     vSendcode ne ?
     6403            and vSendcode ne ""
     6404         then
     6405            setattrutd (idb-num,idoc-id,"sendcode",vSendcode).
     6406         if not mFlaftest
     6407         then do:
     6408            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6409            then do:
     6410                run   UpdateUTDInformOne(vDocument).
     6411               release object vDocument.
     6412            end.
     6413            if    iTypeAnswer eq "CorrectionRequest"
     6414               or iTypeAnswer eq "AcceptRevocation"
     6415               or iTypeAnswer eq "RejectRevocation"
     6416               or iTypeAnswer eq "RejectDocument"
     6417               or iTypeAnswer eq "AcceptDocument"
     6418               or iTypeAnswer eq "AcceptDocumentWithDisc"
     6419               or iTypeAnswer eq "AcceptDocumentNotAccepted"
     6420            then do:
     6421               if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6422               then do:
     6423                   run  UpdateUTDInformOne(vDocument).
     6424                  release object vDocument.
     6425               end.
     6426               if   not mFlaftest
     6427               then do trans:
     6428                  find first utd where utd.db-num eq idb-num
     6429                                   and utd.doc-id eq idoc-id
     6430                                   and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6431                  exclusive-lock no-error.
     6432                  if available utd
     6433                  then do :
     6434                     case iTypeAnswer:
     6435                        when   "AcceptDocument"               then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6436                        when   "RejectDocument"               then utd.sts-edi = if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     6437                                                                                 then ObjSrv:Env:Utd:Sts:edi:sendAutoRejected:KeyIntDB
     6438                                                                                 else ObjSrv:Env:Utd:Sts:edi:sendRejected:KeyIntDB.
     6439                        when   "CorrectionRequest"            then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendAdjustment:KeyIntDB.
     6440                        when   "AcceptRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     6441                        when   "RejectRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     6442                        when   "AcceptDocumentWithDisc"       then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6443                        when   "AcceptDocumentNotAccepted"    then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6444                     end case.
     6445                     if iTypeAnswer eq "CorrectionRequest"
     6446                     then do:
     6447                        utd.sts = ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB.
     6448                        if     utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6449                        then do:
     6450                            run   SendAnsver(idb-num,idoc-id,"AcceptDocumentWithDisc",iComment).
     6451                        end.
     6452                     end.
     6453                  end.
     6454               end.
     6455            end.
     6456         end.
     6457      end.
     6458   end.
     6459   procedure  SendResponse :
     6460      define input  parameter idb-num as integer no-undo.
     6461      define input  parameter idoc-id as integer no-undo.
     6462      define input  parameter iAccept as logical no-undo.
     6463      define input  parameter itestMod as logical no-undo.
     6464       define buffer utd for utd.
     6465       define buffer buf_utd for utd.
     6466       itestMod = not itestMod.
     6467       define variable vreturn as logical no-undo.
     6468       find first utd where utd.db-num eq idb-num
     6469                        and utd.doc-id eq idoc-id
     6470       no-lock no-error.
     6471       if available utd
     6472       then do:
     6473          if utd.EDocType              = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB
     6474          then do:
     6475             if     iAccept
     6476                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientSignature:KeyIntDB
     6477                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientPartiallySignature:KeyIntDB
     6478             then do:
     6479                vreturn = yes.
     6480                if itestMod
     6481                then do:
     6482                   for each buf_utd where buf_utd.PackageId eq utd.PackageId
     6483                                      and buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     6484                                      and buf_utd.Timestamp <= utd.Timestamp
     6485                                      and (     buf_utd.sts-edi   eq objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     6486                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6487                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     6488                   no-lock :
     6489                       run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"AcceptDocument","")no-error.
     6490                      if error-status:error then return error return-value.
     6491                   end.
     6492                end.
     6493             end.
     6494          end.
     6495          else if utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     6496          then do:
     6497             if iAccept
     6498             then do:
     6499                vreturn = yes.
     6500                if itestMod
     6501                then do:
     6502                   define variable vsend as logical no-undo.
     6503                   vsend = logical(getattrutdex (idb-num,idoc-id,"returnSend","no")).
     6504                   if vsend
     6505                   then
     6506                      return error "Документ был отправлен рание. Повторная отправка возможна через сервис.".
     6507                   find first buf_utd where buf_utd.OrganizationExt eq utd.parentOrganizationExt
     6508                                        and buf_utd.DocumentExt     eq utd.parentDocumentExt
     6509                   no-lock no-error.
     6510                   if available buf_utd
     6511                   then do:
     6512                      if getattrutd (idb-num,idoc-id,"TypeUTD") ne "счфДОП"
     6513                      then do:
     6514                          run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"CorrectionRequest",GetErrForUtd(utd.db-num,utd.doc-id,"return"))no-error.
     6515                         if error-status:error then return error return-value.
     6516                      end.
     6517                   end.
     6518                   run bge/sendutd.p(
     6519                        parparentproc,
     6520                        mDiadocConnection:Certificate:Thumbprint,
     6521                        idb-num,
     6522                        idoc-id) no-error.
     6523                   if error-status:error then return error return-value.
     6524                   do trans :
     6525                      find first utd where utd.db-num eq idb-num
     6526                                       and utd.doc-id eq idoc-id
     6527                      exclusive-lock no-error.
     6528                      utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB.
     6529                      setattrutd (idb-num,idoc-id,"returnSend","yes").
     6530                   end.
     6531                end.
     6532             end.
     6533          end.
     6534          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6535          then do:
     6536             if iAccept
     6537             then do:
     6538                vreturn = yes.
     6539                if itestMod
     6540                then
     6541                    run  SendReceiptsAsync(idb-num,idoc-id).
     6542             end.
     6543          end.
     6544          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB
     6545          then do:
     6546             if not iAccept
     6547             then do:
     6548                vreturn = yes.
     6549                if itestMod
     6550                then do:
     6551                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6552                   if error-status:error then return error return-value.
     6553                end.
     6554             end.
     6555          end.
     6556          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:RequestsMyRevocation:KeyIntDB
     6557          then do:
     6558             vreturn = yes.
     6559             if iAccept
     6560             then do:
     6561                if itestMod
     6562                then do:
     6563                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptRevocation","") no-error.
     6564                   if error-status:error then return error return-value.
     6565                end.
     6566             end.
     6567             else do:
     6568                if itestMod
     6569                then do:
     6570                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectRevocation","")no-error.
     6571                   if error-status:error then return error return-value.
     6572                end.
     6573             end.
     6574          end.
     6575          else if   utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Changed:KeyIntDB
     6576                 or utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     6577          then do:
     6578             vreturn = yes.
     6579             if iAccept
     6580             then do:
     6581                if itestMod
     6582                then do:
     6583                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocument","")no-error.
     6584                   if error-status:error then return error return-value.
     6585                end.
     6586             end.
     6587             else do:
     6588                if itestMod
     6589                then do:
     6590                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6591                   if error-status:error then return error return-value.
     6592                end.
     6593             end.
     6594          end.
     6595          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     6596          then do:
     6597             if iAccept
     6598             then do:
     6599                vreturn = yes.
     6600                if itestMod
     6601                then do:
     6602                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6603                   if error-status:error then return error return-value.
     6604                end.
     6605             end.
     6606          end.
     6607          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureAdjustment:KeyIntDB
     6608          then do:
     6609             if iAccept
     6610             then do:
     6611                vreturn = yes.
     6612                if itestMod
     6613                then do:
     6614                    run  SendAnsver in this-procedure (idb-num,idoc-id,"CorrectionRequest","")no-error.
     6615                   if error-status:error then return error return-value.
     6616                end.
     6617             end.
     6618          end.
     6619          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureNotAccepted:KeyIntDB
     6620          then do:
     6621             if iAccept
     6622             then do:
     6623                vreturn = yes.
     6624                if itestMod
     6625                then do:
     6626                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocumentNotAccepted","")no-error.
     6627                   if error-status:error then return error return-value.
     6628                end.
     6629             end.
     6630          end.
     6631          if itestmod and not vreturn
     6632          then do:
     6633             PutMes (substitute('Error Документ с № "&5" в.н. "&2" по БД "&1" в статусе "&3" выполнить операцию "&4" не возможно.',
     6634                                utd.db-num,
     6635                                utd.doc-id,
     6636                                ObjSrv:Env:Utd:Sts:EDI:GetLabel(utd.sts-edi),
     6637                                if iAccept then "Подписать" else "Отказать",
     6638                                utd.DocumentNumber)
     6639                                ).
     6640          end.
     6641       end.
     6642       return string(vreturn).
     6643   end.
     6644   define temp-table tt-pack no-undo
     6645             field orgid as char
     6646             field docid as char
     6647             field packid as char
     6648             field stamp as datetime
     6649             index pi packid   stamp   orgid  docid
     6650             .
     6651   function CheckLoad returns logical
     6652   (iDocument as component-handle,
     6653    output ohost-code as integer ,
     6654    output oObj-type  as character  ,
     6655    output oObj-code  as integer ):
     6656      define variable vFlag as logical no-undo.
     6657      define variable vDocumentChild as component-handle no-undo.
     6658      define variable vContent as component-handle no-undo.
     6659      define variable vConsignees as component-handle no-undo.
     6660      define variable vfilename as character no-undo.
     6661      oObj-type  = ?.
     6662      oObj-code  = ?.
     6663      ohost-code = ?.
     6664      define buffer ext-classif   for ext-classif.
     6665      define buffer clients       for clients.
     6666      define buffer buf_clients   for clients.
     6667      define buffer clients-attr  for clients-attr.
     6668      if   iDocument:type eq "UniversalTransferDocument"
     6669        or iDocument:type eq "UniversalTransferDocumentRevision"
     6670      then main-block :
     6671      do on error undo main-block, return error:
     6672         getdesc(iDocument).
     6673         vfilename = iDocument:filename.
     6674         if iDocument:Direction eq "Inbound"
     6675         then do:
     6676            define variable vOrganizationGuid as character no-undo.
     6677            define variable vDocumentid as character no-undo.
     6678            vOrganizationGuid = iDocument:OrganizationGuid.
     6679            vDocumentid     = iDocument:DocumentId.
     6680            find first utd where utd.DocumentExt     = vDocumentid
     6681                             and utd.OrganizationExt = vOrganizationGuid
     6682            no-lock no-error .
     6683            if available utd
     6684            then do:
     6685               assign
     6686                  Oobj-type = utd.obj-type
     6687                  Oobj-code = utd.obj-code
     6688                  ohost-code = utd.host-code.
     6689               .
     6690            end.
     6691            vDocumentChild = iDocument:GetDynamicContent("Seller") no-error.
     6692            getdesc(vDocumentChild).
     6693            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     6694               and ohost-code ne 0 and ohost-code ne ?)
     6695            then vFlag = no.
     6696            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     6697               and (ohost-code eq 0 and ohost-code eq ?))
     6698            then do:
     6699                find first clients  where clients.obj-type   = Oobj-type
     6700                                      and clients.obj-code   = Oobj-code
     6701                no-lock no-error .
     6702                if available clients
     6703                then
     6704                   ohost-code =  clients.host-code.
     6705                vFlag = no.
     6706            end.
     6707            else if vDocumentChild ne ?
     6708            then do:
     6709               if iDocument:version  eq "utd820_05_01_01"
     6710               then do:
     6711                  vContent = vDocumentChild:UniversalTransferDocument no-error.
     6712               end.
     6713               else
     6714                  vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     6715               release object vDocumentChild.
     6716               if vContent ne ?
     6717               then do:
     6718                  getdesc(vContent).
     6719                  define variable vFnsParticipantId as character no-undo.
     6720                  define variable vinn as character no-undo.
     6721                  define variable vkpp as character no-undo.
     6722                  define variable vorgname as character no-undo.
     6723                  define variable vAddrOrg as character no-undo.
     6724                  define variable vAdditionalInfo as character no-undo.
     6725                  if iDocument:version  eq "utd820_05_01_01"
     6726                  then do:
     6727                     getdesc(vContent:Sellers).
     6728                     getdesc(vContent:Sellers:Seller).
     6729                     getdesc(vContent:Sellers:Seller:GetItem(0)).
     6730                     getdesc(vContent:Sellers:Seller:GetItem(0):OrganizationDetails).
     6731                     getOrganizationInfo(vContent:Sellers:Seller:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6732                  end.
     6733                  else do:
     6734                     vFnsParticipantId =  vContent:SenderFnsParticipantId.
     6735                  end.
     6736                  find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     6737                                           and ext-classif.charkey_three eq vFnsParticipantId
     6738                  no-lock no-error.
     6739                  if available ext-classif
     6740                  then do:
     6741                     find first clients
     6742                       where clients.obj-type   = ext-classif.CharKey_One
     6743                         and clients.obj-code   = ext-classif.Key#_One
     6744                         and not can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     6745                     no-lock no-error .
     6746                     if not available clients
     6747                     then do:
     6748                        PutMes(substitute("По &1 отправитель &2 наша фирма." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6749                        return no.
     6750                     end.
     6751                  end.
     6752                  else do:
     6753                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6754                     return no.
     6755                  end.
     6756                  if iDocument:version  eq "utd820_05_01_01"
     6757                  then do:
     6758                     getdesc(vContent:Buyers).
     6759                     getdesc(vContent:Buyers:Buyer).
     6760                     getdesc(vContent:Buyers:Buyer:GetItem(0)).
     6761                     getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo,output vAddrOrg).
     6762                  end.
     6763                  else do:
     6764                     vConsignees = vContent:Consignees.
     6765                     getdesc(vConsignees).
     6766                     getdesc(vConsignees:Consignee).
     6767                     if vConsignees:Consignee:count > 0
     6768                     then do:
     6769                        getdesc(vConsignees:Consignee:GetItem(0)).
     6770                        getOrganizationInfo(vConsignees:Consignee:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6771                     end.
     6772                     release object vConsignees.
     6773                     vFnsParticipantId = vContent:RecipientFnsParticipantId.
     6774                  end.
     6775                  release object vContent.
     6776                  define variable otext as character no-undo.
     6777                  vFlag = getObgFns
     6778                             (input iDocument:DocumentNumber ,
     6779                              input vFnsParticipantId ,
     6780                              input vkpp,
     6781                              output ohost-code,
     6782                              output oobj-type,
     6783                              output oobj-code,
     6784                              output otext ).
     6785                  if otext ne "" and otext ne ?
     6786                  then
     6787                     PutMes( otext).
     6788                  if vFlag  eq no
     6789                  then
     6790                     return vFlag .
     6791               end.
     6792               else do:
     6793                  PutMes("Error Ошибка получения данных из Диадок UniversalTransferDocument" + if iDocument:version  eq "utd820_05_01_01" then "" else "WithHyphens").
     6794                  return no.
     6795               end.
     6796            end.
     6797            else do:
     6798               PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     6799               return no.
     6800            end.
     6801         end.
     6802         else
     6803            return yes.
     6804         if ohost-code eq ? or ohost-code eq 0
     6805         then do:
     6806            PutMes(substitute("По &1 не удалось определить фирму по получателю  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6807            return no.
     6808         end.
     6809      end.
     6810      else do:
     6811         define variable vdb-num as integer no-undo.
     6812         define variable vdoc-id as integer no-undo.
     6813         define variable vpack as character no-undo init ?.
     6814         define variable vcli-type as character no-undo.
     6815         define variable vcli-code as integer no-undo.
     6816         define variable vfns as character no-undo.
     6817         define variable vchar as character no-undo.
     6818         vDocumentChild = iDocument:GetDynamicContent("Seller")no-error.
     6819         if vDocumentChild eq ?
     6820         then do:
     6821            PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     6822            return no.
     6823         end.
     6824         vContent = vDocumentChild:UniversalCorrectionDocument no-error.
     6825         if vContent ne ?
     6826         then do:
     6827            getOrganizationInfo(vContent:Seller,output vchar,output vchar,vFns, output vchar,  output vchar, output vchar).
     6828            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     6829                                     and ext-classif.charkey_three eq vFns
     6830            no-lock no-error.
     6831            if available ext-classif
     6832            then do:
     6833               assign
     6834                  vcli-type = ext-classif.CharKey_One
     6835                  vcli-code = ext-classif.Key#_One
     6836               .
     6837               vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     6838               GetprevUTDForPac(vpack,iDocument:Timestamp,output vdb-num,output vdoc-id ).
     6839               release object vContent.
     6840            end.
     6841            else do:
     6842                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6843                     return no.
     6844                  end.
     6845         end.
     6846         else do:
     6847            PutErr("Error Ошибка получения данных из Диадок Seller").
     6848            return no.
     6849         end.
     6850         release object vDocumentChild.
     6851         define buffer     utd for utd.
     6852         find first utd where utd.db-num eq vdb-num
     6853                          and utd.doc-id eq vdoc-id
     6854         no-lock no-error.
     6855         if available utd
     6856         then do:
     6857            assign
     6858               oobj-type  = utd.obj-type
     6859               oobj-code  = utd.obj-code
     6860               ohost-code = utd.host-code
     6861               vfilename  = getattrutd (utd.db-num,utd.doc-id,"FileName")
     6862            .
     6863         end.
     6864         else do:
     6865            PutMes(substitute("Не найден оригенальный документ по пакету &1.",vpack)).
     6866            return no.
     6867         end.
     6868      end.
     6869      if  yes
     6870      then do:
     6871         define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6872         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(oobj-type, oobj-code).
     6873         if     not EDOParSec:IsEdo
     6874            and vfilename begins "ON_NSCHFDOPPRMARK_"
     6875         then do:
     6876            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для маркированного товара.",oobj-type,oobj-code)).
     6877            vFlag = no.
     6878         end.
     6879         else if     not EDOParSec:IsEdoNotmark
     6880                 and not vfilename begins "ON_NSCHFDOPPRMARK_"
     6881         then do:
     6882            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для не маркированного товара.",oobj-type,oobj-code)).
     6883            vFlag = no.
     6884         end.
     6885         else
     6886            vFlag = yes.
     6887      end.
     6888      return vFlag.
     6889   end.
     6890   procedure  UpdateUTDInformOne :
     6891      define input  parameter iDocument as component-handle no-undo.
     6892      define variable vOrganizationGuid as character no-undo.
     6893      define variable vDocumentId as character no-undo.
     6894      define variable vi as integer no-undo.
     6895      define variable vii as integer no-undo.
     6896      define variable viii as integer no-undo.
     6897      define variable vtext as longchar no-undo.
     6898      define buffer utd           for ub.utd.
     6899      define buffer old_utd           for ub.utd.
     6900      define buffer utd-lines      for ub.utd-lines.
     6901      define buffer marking       for ub.marking.
     6902      define buffer marking-lines for ub.marking-lines.
     6903      define buffer utd-marking-lines for ub.utd-marking-lines.
     6904      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6905      define variable vDocumentChild               as component-handle no-undo.
     6906      define variable vContent                     as component-handle no-undo.
     6907      define variable vValues                      as component-handle no-undo.
     6908      define variable vSellers                     as component-handle no-undo.
     6909      define variable vConsignees                  as component-handle no-undo.
     6910      define variable vInvoiceTable                as component-handle no-undo.
     6911      define variable vItems                       as component-handle no-undo.
     6912      define variable vExtendedInvoiceItem         as component-handle no-undo.
     6913      define variable vItemIdentificationNumber    as component-handle no-undo.
     6914      define variable vTransferBaseCol             as component-handle no-undo.
     6915      define variable vTransferBase                as component-handle no-undo.
     6916      define variable vorgname as character no-undo.
     6917      define variable vAddrOrg as character no-undo.
     6918      define variable vAdditionalInfo as character no-undo.
     6919      define variable volddb-num as integer no-undo.
     6920      define variable volddoc-id as integer no-undo.
     6921      define variable vunits  as component-handle no-undo.
     6922      define variable vunit   as component-handle no-undo.
     6923      define variable VValue  as character        no-undo.
     6924      define variable vsite   as character        no-undo.
     6925      define variable vNewUtd as logical          no-undo.
     6926      if iDocument eq ?
     6927      then
     6928        return.
     6929      vOrganizationGuid = iDocument:OrganizationGuid.
     6930      vDocumentid     = iDocument:DocumentId.
     6931      find first utd where utd.DocumentExt     = vDocumentid
     6932                       and utd.OrganizationExt = vOrganizationGuid
     6933      no-lock no-error .
     6934      find first tt-recid where tt-recid.orgid eq vOrganizationGuid
     6935                            and tt-recid.docid eq vDocumentid
     6936      no-lock no-error.
     6937      if not available tt-recid
     6938      then do trans:
     6939         if iDocument  ne ?
     6940            and (
     6941                     iDocument:type eq "UniversalTransferDocument"
     6942                  or iDocument:type eq "UniversalTransferDocumentRevision"
     6943                  or iDocument:type eq "UniversalCorrectionDocument"
     6944                 )
     6945         then do:
     6946            PutMes(substitute("Загрузка документа  &1 от &2." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6947            define variable vhost-code as integer   no-undo.
     6948            define variable vobj-type  as character no-undo.
     6949            define variable vobj-code  as integer   no-undo.
     6950            if not CheckLoad(iDocument,output vhost-code,output vobj-type,output  vobj-code )
     6951            then do:
     6952               PutMes(substitute("Документ &1 от &2 пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6953               create tt-recid.
     6954               assign
     6955                  tt-recid.orgid = vOrganizationGuid
     6956                  tt-recid.docid = vDocumentid
     6957               .
     6958               return.
     6959            end.
     6960            find first utd where utd.DocumentExt     = vDocumentid
     6961                             and utd.OrganizationExt = vOrganizationGuid
     6962            no-lock no-error  .
     6963            if available utd
     6964            then do:
     6965               if     utd.sts-edi > ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6966                  and iDocument:RevocationStatus ne "RequestsMyRevocation"
     6967               then do:
     6968                  create tt-recid.
     6969                  assign
     6970                     tt-recid.orgid = vOrganizationGuid.
     6971                     tt-recid.docid = vDocumentid
     6972                  .
     6973                  PutMes(substitute("Документ &1 от &2 в конечном статусе. Документ пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6974               end.
     6975               find current utd exclusive-lock no-error  no-wait  .
     6976               if  not available  utd
     6977               then do:
     6978                  PutMes(substitute("Документ &1 от &2 заблокирован и будет пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate )).
     6979                  return.
     6980               end.
     6981            end.
     6982            subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6983            MySeqUtd = ?.
     6984            if     not available  utd
     6985            then do:
     6986               create utd.
     6987               assign
     6988                  utd.DocumentExt      = vDocumentid
     6989                  utd.OrganizationExt  = vOrganizationGuid
     6990                  vNewUtd              = yes
     6991               .
     6992               validate utd.
     6993            end.
     6994            assign
     6995               utd.host-code = vhost-code when vhost-code ne ? and vhost-code ne 0
     6996               utd.obj-code  = vobj-code  when vobj-code  ne ? and vobj-code  ne 0
     6997               utd.obj-type  = vobj-type  when vobj-type  ne ? and vobj-type  ne ""
     6998            .
     6999            setattrutd (utd.db-num,utd.doc-id,"FileName",iDocument:FileName).
     7000            utd.RevocationStatus = iDocument:RevocationStatus.
     7001            utd.RecipientResponseStatus          = iDocument:RecipientResponseStatus.
     7002            utd.TypeId           = iDocument:type.
     7003            utd.CounteragentId   = iDocument:Counteragent:guid.
     7004            utd.CustomDocumentId = iDocument:CustomDocumentId.
     7005            utd.sts-edi = ?.
     7006            utd.DocumentNumber = iDocument:DocumentNumber.
     7007            utd.DocumentDate   = date(iDocument:DocumentDate).
     7008            utd.Timestamp      = datetime(iDocument:Timestamp) .
     7009            utd.ReceiptStatus  = iDocument:RecipientReceiptMetadata:ReceiptStatus.
     7010            utd.Direction      = iDocument:Direction.
     7011            utd.ModifyDate = today.
     7012            utd.flagRI     =    utd.ReceiptStatus eq "GeneralReceiptStatusNotAcceptable" or utd.ReceiptStatus eq "Finished".
     7013            utd.EDocType = if   iDocument:type eq "UniversalTransferDocument"
     7014                             or iDocument:type eq "UniversalTransferDocumentRevision"
     7015                           then objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7016                           else objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     7017            getdesc(iDocument).
     7018            getdesc(iDocument:Counteragent).
     7019            getdesc(iDocument:RecipientReceiptMetadata).
     7020            getdesc(iDocument:ConfirmationMetadata).
     7021            utd.AmendmentRequested = logical(iDocument:AmendmentRequested).
     7022            if iDocument:type ne "UniversalTransferDocumentRevision"
     7023            then do:
     7024                   utd.Revised = logical(iDocument:Revised).
     7025                   utd.Corrected = logical(iDocument:Corrected).
     7026            end.
     7027            vDocumentChild = iDocument:GetDynamicContent("Seller").
     7028            getdesc(vDocumentChild).
     7029            if   iDocument:type eq "UniversalTransferDocument"
     7030              or iDocument:type eq "UniversalTransferDocumentRevision"
     7031            then do:
     7032               utd.Total = iDocument:total.
     7033               utd.Vat = iDocument:Vat.
     7034            end.
     7035            else do:
     7036               utd.Total = decimal (iDocument:TotalInc) - decimal (iDocument:TotalDec).
     7037               utd.Vat = decimal (iDocument:VatInc) - decimal (iDocument:VatDec).
     7038            end.
     7039            find first utd-lines where utd-lines.db-num     = utd.db-num
     7040                                   and utd-lines.doc-id     = utd.doc-id
     7041                                   no-lock no-error.
     7042            if     (   vNewUtd
     7043                    or utd.Direction ne "Inbound"
     7044                    or not available utd-lines)
     7045               and vDocumentChild ne ?
     7046            then do:
     7047               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7048               then do:
     7049                  if iDocument:version  eq "utd820_05_01_01"
     7050                  then do:
     7051                     vContent = vDocumentChild:UniversalTransferDocument no-error.
     7052                  end.
     7053                  else
     7054                     vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     7055                  if vContent ne ?
     7056                  then do:
     7057                     getdesc(vContent).
     7058                     define variable vInfoCount as integer no-undo.
     7059                     define variable vInfos as component-handle no-undo.
     7060                     define variable vInfo as component-handle no-undo.
     7061                     vInfos = vContent:AdditionalInfoId:AdditionalInfo.
     7062                     do vInfoCount = 1 to vInfos:count:
     7063                        vInfo = vInfos:getitem(vInfoCount - 1).
     7064                        getdesc(vInfo).
     7065                        setattrutd (utd.db-num,utd.doc-id,vInfo:id,vInfo:value).
     7066                     end.
     7067                     getdesc(vContent:TransferInfo).
     7068                     getdesc(vContent:TransferInfo:TransferBases).
     7069                     vTransferBasecol = vContent:TransferInfo:TransferBases:TransferBase.
     7070                     getdesc(vTransferBasecol).
     7071                     do vi = 1 to min(vTransferBasecol:count,1):
     7072                        vTransferBase = vTransferBasecol:getitem(vi - 1).
     7073                        getdesc(vTransferBase).
     7074                        utd.BaseDocumentNumber = vTransferBase:BaseDocumentNumber.
     7075                        utd.BaseDocumentName   = vTransferBase:BaseDocumentName.
     7076                        utd.BaseDocumentDate   = date(vTransferBase:BaseDocumentDate).
     7077                        release object vTransferBase.
     7078                     end.
     7079                     release object vTransferBasecol.
     7080                     vSellers = vContent:Sellers.
     7081                     getdesc(vSellers).
     7082                     getdesc(vSellers:Seller:GetItem(0)).
     7083                     if vSellers:Seller:count > 0
     7084                     then
     7085                        getOrganizationInfo(vSellers:Seller:GetItem(0),output utd.cli-inn,output utd.cli-kpp,utd.cli-FnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7086                     release object vSellers.
     7087                     if iDocument:version  ne "utd820_05_01_01"
     7088                     then
     7089                        utd.cli-FnsParticipantId = vContent:SenderFnsParticipantId.
     7090                     utd.cli-info = vorgname + " " + vAddrOrg.
     7091                     if iDocument:version  eq "utd820_05_01_01"
     7092                     then do:
     7093                        getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output utd.obj-inn,output utd.obj-kpp,utd.obj-FnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7094                     end.
     7095                     else do:
     7096                        vConsignees = vContent:Consignees.
     7097                        getdesc(vConsignees).
     7098                        if vConsignees:Consignee:count > 0
     7099                        then do:
     7100                           getOrganizationInfo(vConsignees:Consignee:GetItem(0),output utd.obj-inn,output utd.obj-kpp,utd.obj-FnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7101                           setattrutd (utd.db-num,utd.doc-id,"Consignee_ИнфДляУчаст",vAdditionalInfo).
     7102                        end.
     7103                        utd.obj-FnsParticipantId = vContent:RecipientFnsParticipantId.
     7104                        release object vConsignees.
     7105                     end.
     7106                     utd.obj-info = vorgname + " " + vAddrOrg + " ИНН: " + utd.obj-inn + " КПП: " + utd.obj-kpp.
     7107                     vInvoiceTable = vContent:Table.
     7108                     getdesc(vInvoiceTable).
     7109                     vItems = vInvoiceTable:Item.
     7110                     release object vInvoiceTable.
     7111                     do vi = 1 to vItems:Count:
     7112                        vExtendedInvoiceItem= vItems:GetItem(vi - 1).
     7113                        getdesc(vExtendedInvoiceItem).
     7114                        find first utd-lines where utd-lines.db-num     = utd.db-num
     7115                                               and utd-lines.doc-id     = utd.doc-id
     7116                                               and utd-lines.LineNum    = vi
     7117                        exclusive-lock no-error.
     7118                        if not available  utd-lines
     7119                        then do:
     7120                           create utd-lines.
     7121                           assign
     7122                              utd-lines.db-num   = utd.db-num
     7123                              utd-lines.doc-id   = utd.doc-id
     7124                              utd-lines.Linenum  = vi
     7125                              utd-lines.gds-code = ?
     7126                           .
     7127                        end.
     7128                        utd-lines.ProductCode = vExtendedInvoiceItem:Product.
     7129                        utd-lines.UnitCode    = vExtendedInvoiceItem:UnitnAME.
     7130                        setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(vExtendedInvoiceItem:Quantity)).
     7131                        setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Unit",string(vExtendedInvoiceItem:unit)).
     7132                        utd-lines.Price       = vExtendedInvoiceItem:Price.
     7133                        utd-lines.TotalWithVatExcluded   = vExtendedInvoiceItem:SubtotalWithVatExcluded.
     7134                        utd-lines.TaxRate   =   if  vExtendedInvoiceItem:TaxRate eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate,"/"),"%")).
     7135                        utd-lines.Vat       = vExtendedInvoiceItem:Vat.
     7136                        utd-lines.Total     = vExtendedInvoiceItem:Subtotal.
     7137                        utd-lines.Article   = vExtendedInvoiceItem:ItemVendorCode.
     7138                        getdesc(vExtendedInvoiceItem:CustomsDeclarations).
     7139                        getdesc(vExtendedInvoiceItem:CustomsDeclarations:CustomsDeclaration).
     7140                        if vExtendedInvoiceItem:CustomsDeclarations:CustomsDeclaration:COUNT >= 1
     7141                        then
     7142                           getdesc(vExtendedInvoiceItem:CustomsDeclarations:CustomsDeclaration:GETITEM(0)).
     7143                        getdesc(vExtendedInvoiceItem:AdditionalInfos).
     7144                        getdesc(vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo).
     7145                        if vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo:COUNT >= 1
     7146                        then
     7147                           getdesc(vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo:GETITEM(0)).
     7148                        getdesc(vExtendedInvoiceItem:ItemTracingInfos).
     7149                        getdesc(vExtendedInvoiceItem:ItemTracingInfos:ItemTracingInfo ).
     7150                        if vExtendedInvoiceItem:ItemTracingInfos:ItemTracingInfo:COUNT >= 1
     7151                        then
     7152                           getdesc(vExtendedInvoiceItem:ItemTracingInfos:ItemTracingInfo:GETITEM(0) ).
     7153                        getdesc(vExtendedInvoiceItem:ItemIdentificationNumbers).
     7154                        getdesc(vExtendedInvoiceItem:ItemIdentificationNumbers:ItemIdentificationNumber).
     7155                        do vii = 1 to vExtendedInvoiceItem:ItemIdentificationNumbers:ItemIdentificationNumber:COUNT:
     7156                           vItemIdentificationNumber = vExtendedInvoiceItem:ItemIdentificationNumbers:ItemIdentificationNumber:GETITEM(vii - 1).
     7157                           getdesc(vItemIdentificationNumber).
     7158                           getdesc(vItemIdentificationNumber:Unit).
     7159                           if vItemIdentificationNumber:TransPackageId ne ? and vItemIdentificationNumber:TransPackageId ne ""
     7160                           then do:
     7161                              VValue = repTegforDm(vItemIdentificationNumber:TransPackageId).
     7162                              addMarkforUtd (utd-lines.db-num ,
     7163                                             utd-lines.doc-id,
     7164                                             utd-lines.Linenum,
     7165                                             VValue,
     7166                                             "",
     7167                                             iDocument:type).
     7168                           end.
     7169                           vunit = vItemIdentificationNumber:Unit.
     7170                           do viii = 1 to vunit:count:
     7171                              vValue = vunit:GETITEM(viii - 1).
     7172                              VValue = repTegforDm(VValue).
     7173                              addMarkforUtd (utd-lines.db-num ,
     7174                                             utd-lines.doc-id,
     7175                                             utd-lines.Linenum,
     7176                                             VValue,
     7177                                             "",
     7178                                             iDocument:type).
     7179                           end.
     7180                           release object  vunit.
     7181                           getdesc(vItemIdentificationNumber:PackageId).
     7182                           vunit = vItemIdentificationNumber:PackageId.
     7183                           do viii = 1 to vunit:count:
     7184                              VValue = vunit:GETITEM(viii - 1).
     7185                              VValue = repTegforDm(VValue).
     7186                              addMarkforUtd (utd-lines.db-num ,
     7187                                             utd-lines.doc-id,
     7188                                             utd-lines.Linenum,
     7189                                             VValue,
     7190                                             "",
     7191                                             iDocument:type).
     7192                           end.
     7193                           release object  vunit.
     7194                           release object vItemIdentificationNumber.
     7195                        end.
     7196                        vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     7197                        do vii = 1 to vunits:count:
     7198                           vunit = vunits:GETITEM(vii - 1).
     7199                           getdesc(vunit).
     7200                           if     vunit:Id eq "штрихкод"
     7201                               or vunit:Id eq "ean"
     7202                           then do:
     7203                              setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     7204                              setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     7205                              find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     7206                                                             and utd-marking-lines.doc-id     = utd-lines.doc-id
     7207                                                             and utd-marking-lines.Linenum    = utd-lines.Linenum
     7208                              no-lock no-error.
     7209                              if not available utd-marking-lines
     7210                              then do:
     7211                                 vtext = vunit:Value.
     7212                                 do viii = 1 to num-entries(vtext," "):
     7213                                    VValue = entry(viii,vtext," ").
     7214                                    addMarkforUtd (utd-lines.db-num ,
     7215                                             utd-lines.doc-id,
     7216                                             utd-lines.Linenum,
     7217                                             VValue,
     7218                                             "",
     7219                                             iDocument:type).
     7220                                 end.
     7221                              end.
     7222                           end.
     7223                           if vunit:Id eq "Документ о соответствии" then do:
     7224                             define variable v-sert-value as character no-undo .
     7225                             find first utd-lines-attr exclusive-lock where utd-lines-attr.doc-id = utd-lines.doc-id and
     7226                             utd-lines-attr.db-num = utd-lines.db-num and
     7227                             utd-lines-attr.LineNum = utd-lines.LineNum and
     7228                             utd-lines-attr.attr-code = "doc_sertif" no-error .
     7229                             if available (utd-lines-attr) then utd-lines-attr.attr-value = utd-lines-attr.attr-value + "; " + vunit:value .
     7230                             else setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"doc_sertif",vunit:value).
     7231                           end.
     7232                           release object  vunit.
     7233                        end.
     7234                        release object  vunits.
     7235                        release utd-lines.
     7236                        release object vExtendedInvoiceItem.
     7237                     end.
     7238                     release object vItems.
     7239                  end.
     7240                  else do:
     7241                     PutMes("Ошибка получения данных из Диадок UniversalTransferDocumentWithHyphens").
     7242                     release object vDocumentChild.
     7243                     return error "Ошибка получения данных из Диадок UniversalTransferDocumentWithHyphens".
     7244                  end.
     7245               end.
     7246               else do:
     7247                  vContent = vDocumentChild:UniversalCorrectionDocument.
     7248                  if vContent ne ?
     7249                  then do:
     7250                     getdesc(vContent).
     7251                     getdesc(vContent:Seller).
     7252                     getdesc(vContent:EventContent).
     7253                     getdesc(vContent:EventContent:CorrectionBase).
     7254                     getOrganizationInfo(vContent:Seller,output utd.cli-inn,output utd.cli-kpp,utd.cli-FnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7255                     utd.cli-info = vorgname + " " + vAddrOrg.
     7256                     do:
     7257                         vInvoiceTable = vContent:Table.
     7258                         getdesc(vInvoiceTable).
     7259                         getdesc(vInvoiceTable:TotalsInc).
     7260                         getdesc(vInvoiceTable:TotalsDec).
     7261                         getdesc(vInvoiceTable:Items).
     7262                         getdesc(vInvoiceTable:Items:item).
     7263                         vItems = vInvoiceTable:Items:item.
     7264                         release object vInvoiceTable.
     7265                         do vi = 1 to vItems:Count:
     7266                            vExtendedInvoiceItem = vItems:GetItem(vi - 1).
     7267                            getdesc(vExtendedInvoiceItem).
     7268                            getdesc(vExtendedInvoiceItem:AdditionalInfos ).
     7269                            getdesc(vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo ).
     7270                            find first utd-lines where utd-lines.db-num     = utd.db-num
     7271                                                   and utd-lines.doc-id     = utd.doc-id
     7272                                                   and utd-lines.LineNum    = vi
     7273                            exclusive-lock no-error.
     7274                            if not available  utd-lines
     7275                            then do:
     7276                               create utd-lines.
     7277                               assign
     7278                                  utd-lines.db-num   = utd.db-num
     7279                                  utd-lines.doc-id   = utd.doc-id
     7280                                  utd-lines.Linenum  = vi
     7281                                  utd-lines.gds-code = ?
     7282                               .
     7283                            end.
     7284                            utd-lines.ProductCode = vExtendedInvoiceItem:Product.
     7285                            vValues = vExtendedInvoiceItem:CorrectedValues no-error.
     7286                            if vValues ne ?
     7287                            then do:
     7288                               getdesc(vExtendedInvoiceItem:OriginalValues ).
     7289                               getdesc(vExtendedInvoiceItem:CorrectedValues ).
     7290                               getdesc(vExtendedInvoiceItem:AmountsInc ).
     7291                               getdesc(vExtendedInvoiceItem:AmountsDec ).
     7292                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Unit",string(vValues:unit)).
     7293                               define variable vQuantity as decimal no-undo.
     7294                               vQuantity    = vValues:Quantity.
     7295                               utd-lines.Price       = vValues:Price.
     7296                               utd-lines.TotalWithVatExcluded   = vValues:SubtotalWithVatExcluded.
     7297                               utd-lines.TaxRate   =   if  vValues:TaxRate eq "без ндс" then -1 else decimal(trim(entry(1,vValues:TaxRate,"/"),"%")).
     7298                               utd-lines.Vat       = vValues:Vat.
     7299                               utd-lines.Total     = vValues:Subtotal.
     7300                               release object vValues.
     7301                               vValues = vExtendedInvoiceItem:OriginalValues.
     7302                               vQuantity    = vQuantity - vValues:Quantity.
     7303                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(vQuantity)).
     7304                               utd-lines.Price       = utd-lines.Price - vValues:Price.
     7305                               utd-lines.Vat       = utd-lines.Vat - vValues:Vat.
     7306                               utd-lines.Total     = utd-lines.Total  - vValues:Subtotal.
     7307                               utd-lines.TotalWithVatExcluded   = utd-lines.TotalWithVatExcluded - vValues:SubtotalWithVatExcluded.
     7308                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old",string( vValues:Quantity)).
     7309                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Price_old"   ,string( vValues:Price)).
     7310                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TotalWithVatExcluded", string( vValues:SubtotalWithVatExcluded)).
     7311                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TaxRate_old", string(  if  vValues:TaxRate eq "без ндс" then -1 else decimal(trim(entry(1,vValues:TaxRate,"/"),"%")))).
     7312                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Vat_old"    , string( vValues:Vat)).
     7313                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Total_old",       string( vValues:Subtotal)).
     7314                               release object vValues.
     7315                               vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     7316                               do vii = 1 to vunits:count:
     7317                                  vunit = vunits:GETITEM(vii - 1).
     7318                                  getdesc(vunit).
     7319                                  if     vunit:Id eq "cis"
     7320                                     or vunit:Id eq "cis_до"
     7321                                     or vunit:Id eq "sscc"
     7322                                     or vunit:Id eq "sscc_до"
     7323                                  then do:
     7324                                     vtext = vunit:Value.
     7325                                     if vtext ne "-"
     7326                                     then do viii = 1 to num-entries(vtext," "):
     7327                                        VValue = entry(viii,vtext," ").
     7328                                        vsite = if     vunit:Id eq "cis" or vunit:Id eq "sscc" then "+" else "-".
     7329                                        addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7330                                     end.
     7331                                  end.
     7332                                  release object vunit.
     7333                               end.
     7334                               do vii = 1 to vunits:count:
     7335                                  vunit = vunits:GETITEM(vii - 1).
     7336                                  getdesc(vunit).
     7337                                  if     vunit:Id eq "штрихкод"
     7338                                      or vunit:Id eq "ean"
     7339                                  then do:
     7340                                     setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     7341                                     setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     7342                                     find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     7343                                                                    and utd-marking-lines.doc-id     = utd-lines.doc-id
     7344                                                                    and utd-marking-lines.Linenum    = utd-lines.Linenum
     7345                                     no-lock no-error.
     7346                                     if not available utd-marking-lines
     7347                                     then do:
     7348                                       vtext = vunit:Value.
     7349                                       do viii = 1 to num-entries(vtext," "):
     7350                                          VValue = entry(viii,vtext," ").
     7351                                          addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     7352                                       end.
     7353                                    end.
     7354                                 end.
     7355                                 release object  vunit.
     7356                              end.
     7357                               release object vunits.
     7358                               release utd-lines.
     7359                               release utd-marking-lines.
     7360                            end.
     7361                            else do:
     7362                               getdesc(vExtendedInvoiceItem:OriginalItemIdentificationNumbers ).
     7363                               getdesc(vExtendedInvoiceItem:OriginalItemIdentificationNumbers:ItemIdentificationNumber).
     7364                               vunits = vExtendedInvoiceItem:OriginalItemIdentificationNumbers:ItemIdentificationNumber.
     7365                               getdesc(vunits).
     7366                               vsite =  "-".
     7367                               do vii = 1 to vunits:count:
     7368                                  getdesc(vunits:GETITEM(vii - 1)).
     7369                                  vunit = vunits:GETITEM(vii - 1):unit.
     7370                                  getdesc(vunit).
     7371                                  do viii = 1 to vunit:count:
     7372                                     vvalue = vunit:GETITEM(viii - 1).
     7373                                     addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7374                                  end.
     7375                                  release object vunit.
     7376                                  vunit = vunits:GETITEM(vii - 1):PackageId.
     7377                                  getdesc(vunit).
     7378                                  do viii = 1 to vunit:count:
     7379                                     vvalue = vunit:GETITEM(viii - 1).
     7380                                     addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7381                                  end.
     7382                                  release object vunit.
     7383                               end.
     7384                               release object vunits.
     7385                               getdesc(vExtendedInvoiceItem:CorrectedItemIdentificationNumbers).
     7386                               vunits = vExtendedInvoiceItem:CorrectedItemIdentificationNumbers:ItemIdentificationNumber.
     7387                               getdesc(vunits).
     7388                               vsite =  "+".
     7389                               do vii = 1 to vunits:count:
     7390                                  getdesc(vunits:GETITEM(vii - 1)).
     7391                                  vunit = vunits:GETITEM(vii - 1):unit.
     7392                                  getdesc(vunit).
     7393                                  do viii = 1 to vunit:count:
     7394                                     vvalue = vunit:GETITEM(viii - 1).
     7395                                     addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7396                                  end.
     7397                                  release object vunit.
     7398                                  vunit = vunits:GETITEM(vii - 1):PackageId.
     7399                                  getdesc(vunit).
     7400                                  do viii = 1 to vunit:count:
     7401                                     vvalue = vunit:GETITEM(viii - 1).
     7402                                     addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7403                                  end.
     7404                                  release object vunit.
     7405                               end.
     7406                               release object vunits.
     7407                               getdesc(vExtendedInvoiceItem:TaxRate ).
     7408                               getdesc(vExtendedInvoiceItem:UnitName ).
     7409                               getdesc(vExtendedInvoiceItem:Unit ).
     7410                               getdesc(vExtendedInvoiceItem:Quantity ).
     7411                               getdesc(vExtendedInvoiceItem:Price ).
     7412                               getdesc(vExtendedInvoiceItem:Excise ).
     7413                               getdesc(vExtendedInvoiceItem:SubtotalWithVatExcluded ).
     7414                               getdesc(vExtendedInvoiceItem:Vat ).
     7415                               getdesc(vExtendedInvoiceItem:WithoutVat).
     7416                               getdesc(vExtendedInvoiceItem:Subtotal ).
     7417                               getdesc(vExtendedInvoiceItem:ItemTracingInfos ).
     7418                               getdesc(vExtendedInvoiceItem:ItemTracingInfos:ItemTracingInfo ).
     7419                               vValues = vExtendedInvoiceItem:CorrectedItemIdentificationNumbers.
     7420                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Unit",string(vExtendedInvoiceItem:Unit:CorrectedValue)).
     7421                               utd-lines.Price       = vExtendedInvoiceItem:Price:CorrectedValue.
     7422                               utd-lines.TotalWithVatExcluded   = vExtendedInvoiceItem:SubtotalWithVatExcluded:CorrectedValue.
     7423                               utd-lines.UnitCode    = vExtendedInvoiceItem:UnitName:CorrectedValue.
     7424                               utd-lines.TaxRate   =   if  vExtendedInvoiceItem:TaxRate:CorrectedValue eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate:CorrectedValue,"/"),"%")).
     7425                               utd-lines.Vat       = vExtendedInvoiceItem:Vat:CorrectedValue.
     7426                               utd-lines.Total     = vExtendedInvoiceItem:Subtotal:CorrectedValue.
     7427                               vQuantity    = dec(vExtendedInvoiceItem:Quantity:CorrectedValue) - dec(vExtendedInvoiceItem:Quantity:OriginalValue).
     7428                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(vQuantity)).
     7429                               utd-lines.Price       = utd-lines.Price - vExtendedInvoiceItem:Price:OriginalValue.
     7430                               utd-lines.Vat       = utd-lines.Vat - vExtendedInvoiceItem:Vat:OriginalValue.
     7431                               utd-lines.Total     = utd-lines.Total  - vExtendedInvoiceItem:Subtotal:OriginalValue.
     7432                               utd-lines.TotalWithVatExcluded   = utd-lines.TotalWithVatExcluded - vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue.
     7433                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old",string( vExtendedInvoiceItem:Quantity:OriginalValue)).
     7434                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Price_old"   ,string( vExtendedInvoiceItem:Price:OriginalValue)).
     7435                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TotalWithVatExcluded", string( vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue)).
     7436                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TaxRate_old", string(  if  vExtendedInvoiceItem:TaxRate:OriginalValue eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate:OriginalValue,"/"),"%")))).
     7437                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Vat_old"    , string( vExtendedInvoiceItem:Vat:OriginalValue)).
     7438                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Total_old",       string( vExtendedInvoiceItem:Subtotal:OriginalValue)).
     7439                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"UnitCode_old", vExtendedInvoiceItem:UnitName:OriginalValue).
     7440                            end.
     7441                            vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     7442                            getdesc(vunits).
     7443                            do vii = 1 to vunits:count:
     7444                               vunit = vunits:GETITEM(vii - 1).
     7445                               getdesc(vunit).
     7446                               if     vunit:Id eq "штрихкод"
     7447                                   or vunit:Id eq "ean"
     7448                               then do:
     7449                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     7450                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     7451                                  find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     7452                                                                 and utd-marking-lines.doc-id     = utd-lines.doc-id
     7453                                                                 and utd-marking-lines.Linenum    = utd-lines.Linenum
     7454                                  no-lock no-error.
     7455                                  if not available utd-marking-lines
     7456                                  then do:
     7457                                    vtext = vunit:Value.
     7458                                    do viii = 1 to num-entries(vtext," "):
     7459                                       VValue = entry(viii,vtext," ").
     7460                                       addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     7461                                    end.
     7462                                 end.
     7463                              end.
     7464                              release object  vunit.
     7465                           end.
     7466                           release object  vunits.
     7467                            release object vExtendedInvoiceItem.
     7468                         end.
     7469                         release object vItems.
     7470                     end.
     7471                     release object vContent.
     7472                  end.
     7473                  else do:
     7474                     create tt-recid.
     7475                     assign
     7476                        tt-recid.orgid = vOrganizationGuid
     7477                        tt-recid.docid = vDocumentid
     7478                     .
     7479                     PutMes("Error Ошибка получения данных из Диадок UniversalCorrectionDocument").
     7480                     release object vDocumentChild.
     7481                     return error "Ошибка получения данных из Диадок UniversalCorrectionDocument".
     7482                  end.
     7483               end.
     7484            end.
     7485            release object vDocumentChild.
     7486            define variable vsetPAck as logical no-undo.
     7487            define variable vcli-type as character no-undo.
     7488            define variable vcli-code as integer no-undo.
     7489            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7490                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     7491            no-lock no-error.
     7492            if available ext-classif
     7493            then do:
     7494               assign
     7495                  vcli-type = ext-classif.CharKey_One
     7496                  vcli-code = ext-classif.Key#_One
     7497               .
     7498               define variable vPack as character no-undo.
     7499               if   iDocument:type eq "UniversalTransferDocument"
     7500               then
     7501                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,utd.DocumentNumber,utd.DocumentDate).
     7502               else if iDocument:type eq "UniversalTransferDocumentRevision"
     7503               then
     7504                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalDocumentNumber,date(iDocument:OriginalDocumentDate)).
     7505               else
     7506                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     7507               if vPack ne utd.PackageId
     7508               then
     7509                  assign
     7510                     vsetPAck      = yes
     7511                     utd.PackageId = vPack
     7512                  .
     7513            end.
     7514            if vNewUtd or vsetPAck then do:
     7515               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7516               then do:
     7517                  if vNewUtd  then do:
     7518                     GetLastUTDinPackbef(utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7519                     find first old_utd where old_utd.db-num eq volddb-num
     7520                                          and old_utd.doc-id eq volddoc-id
     7521                        no-lock no-error.
     7522                     for each utd-marking-lines where utd-marking-lines.db-num eq utd.db-num
     7523                                                  and utd-marking-lines.doc-id eq utd.doc-id
     7524                     exclusive-lock:
     7525                        if available old_utd
     7526                           and utd.db-num ne volddb-num
     7527                           and utd.doc-id ne volddoc-id
     7528                        then
     7529                           find first buf_utd-marking-lines where buf_utd-marking-lines.mark       = utd-marking-lines.mark
     7530                                                              and buf_utd-marking-lines.db-num     = old_utd.db-num
     7531                                                              and buf_utd-marking-lines.doc-id     = old_utd.doc-id
     7532                           no-lock no-error.
     7533                        utd-marking-lines.sts = if available buf_utd-marking-lines then buf_utd-marking-lines.sts else  objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     7534                     end.
     7535                     validate utd.
     7536                     ReCheckload( utd.db-num, utd.doc-id,yes).
     7537                     subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7538                  end.
     7539               end.
     7540               else do:
     7541                  GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7542                  find first old_utd where old_utd.db-num eq volddb-num
     7543                                       and old_utd.doc-id eq volddoc-id
     7544                  no-lock no-error.
     7545                  if not available old_utd
     7546                     or (   utd.db-num eq volddb-num
     7547                        and utd.doc-id eq volddoc-id)
     7548                  then
     7549                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoAvailDoc",string(utd.PackageId) + chr(4) + string(utd.db-num) + chr(4) + string(utd.doc-id)).
     7550                  else do:
     7551                      assign
     7552                          utd.obj-inn               = old_utd.obj-inn
     7553                          utd.obj-kpp               = old_utd.obj-kpp
     7554                          utd.obj-FnsParticipantId  = old_utd.obj-FnsParticipantId
     7555                          utd.obj-info              = old_utd.obj-info
     7556                          utd.parentDocumentExt     = old_utd.DocumentExt
     7557                          utd.parentOrganizationExt = old_utd.OrganizationExt
     7558                          utd.contract-code         = old_utd.contract-code
     7559                      .
     7560                  end.
     7561                  validate utd.
     7562                  SaturateAndCheckUTD( utd.db-num, utd.doc-id).
     7563               end.
     7564            end.
     7565            GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7566            find first old_utd where old_utd.db-num eq volddb-num
     7567                                 and old_utd.doc-id eq volddoc-id
     7568            no-lock no-error.
     7569            if available old_utd
     7570            then
     7571               assign
     7572                  utd.parentDocumentExt     = old_utd.DocumentExt
     7573                  utd.parentOrganizationExt = old_utd.OrganizationExt
     7574               .
     7575            create tt-recid.
     7576            assign
     7577               tt-recid.orgid = vOrganizationGuid
     7578               tt-recid.docid = vDocumentid
     7579            .
     7580            if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     7581            then do:
     7582               tt-recid.parent = utd.PackageId.
     7583               tt-recid.stamp  = utd.Timestamp.
     7584            end.
     7585            release utd no-error.
     7586            if error-status:error
     7587            then
     7588               PutMes(substitute("Документ &1 от &2 не загружен. &3" ,iDocument:DocumentNumber,iDocument:DocumentDate,return-value) ).
     7589            else
     7590               PutMes(substitute("Документ &1 от &2 загружен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7591            unsubscribe "getNextseq".
     7592         end.
     7593      end.
     7594   end.
     7595   function packetupdd returns date
     7596   (iOrganization as component-handle, iDocument as component-handle):
     7597      define variable VPack as character no-undo.
     7598      define variable vorgid as character no-undo.
     7599      define variable vdocid as character no-undo.
     7600      define variable vstamp as datetime no-undo.
     7601      define variable VPack2 as character no-undo.
     7602      define variable vorgid2 as character no-undo.
     7603      define variable vdocid2 as character no-undo.
     7604      define variable vstamp2 as datetime no-undo.
     7605      define variable VPackage as component-handle no-undo.
     7606      define variable vi as integer no-undo.
     7607      define variable vDocument as component-handle no-undo.
     7608      define variable vDocuments as component-handle no-undo.
     7609         VPack = iDocument:PackageId.
     7610         vorgid = iDocument:OrganizationGuid.
     7611         vdocid = iDocument:DocumentId.
     7612         vstamp = iDocument:Timestamp.
     7613         find first tt-pack where tt-pack.packid eq VPack
     7614                              and tt-pack.stamp  eq vstamp
     7615                              and tt-pack.orgid  eq vorgid
     7616                              and tt-pack.docid  eq vdocid
     7617         no-lock no-error.
     7618         if not available tt-pack
     7619         then do:
     7620            create tt-pack.
     7621            assign
     7622               tt-pack.packid = VPack
     7623               tt-pack.stamp  = vstamp
     7624               tt-pack.orgid  = vorgid
     7625               tt-pack.docid  = vdocid
     7626            .
     7627         end.
     7628         getdesc(iDocument ).
     7629         getdesc(iDocument:InitialDocumentIds ).
     7630         vDocuments = iDocument:InitialDocumentIds.
     7631         do vi= 1 to vDocuments:Count:
     7632            vDocument = iOrganization:GetDocumentById(vDocuments:GetItem(vi - 1),false).
     7633            getdesc(vDocument ).
     7634            vorgid2 = vDocument:OrganizationGuid.
     7635            vdocid2 = vDocument:DocumentId.
     7636            vstamp2 = vDocument:Timestamp.
     7637            find first tt-pack where tt-pack.packid eq VPack
     7638                                 and tt-pack.stamp  eq vstamp2
     7639                                 and tt-pack.orgid  eq vorgid2
     7640                                 and tt-pack.docid  eq vdocid2
     7641            no-lock no-error.
     7642            if not available tt-pack
     7643            then do:
     7644               create tt-pack.
     7645               assign
     7646                  tt-pack.packid = VPack
     7647                  tt-pack.stamp  = vstamp2
     7648                  tt-pack.orgid  = vorgid2
     7649                  tt-pack.docid  = vdocid2
     7650               .
     7651            end.
     7652            release object vDocument.
     7653         end.
     7654         release object vDocuments.
     7655   end.
     7656   procedure UpdateUTDInform:
     7657      define input  parameter ibeg-date as date no-undo.
     7658      define input  parameter iend-date as date no-undo.
     7659      define output parameter odatelast as date no-undo.
     7660      define variable vOrganizationList as component-handle no-undo.
     7661      define variable vOrganization as component-handle no-undo.
     7662      define variable vDocumentsTask as component-handle no-undo.
     7663      define variable vDocumentList  as component-handle no-undo.
     7664      define variable vDocumentchildList  as component-handle no-undo.
     7665      define variable vDocument       as component-handle no-undo.
     7666      define buffer ext-classif_obj for ext-classif.
     7667      define buffer ext-classif_Cli  for ext-classif.
     7668      define variable vi  as integer no-undo.
     7669      define variable vii as integer no-undo.
     7670      odatelast = ibeg-date.
     7671      vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     7672      if vOrganizationList eq ? then return error ?.
     7673      vi = vOrganizationList:Count()no-error.
     7674      if vi eq ?
     7675      then
     7676         return error ?.
     7677      for each tt-recid:
     7678         delete tt-recid.
     7679      end.
     7680      for each tt-pack:
     7681         delete tt-pack.
     7682      end.
     7683      do vi = 1 to vOrganizationList:Count() :
     7684         vOrganization = vOrganizationList:GetItem(vi - 1 ).
     7685         getdesc(vOrganization).
     7686         run changeIdtoGuid(vOrganization).
     7687         vDocumentsTask = vOrganization:GetDocumentsTask().
     7688                     vDocumentsTask:FromSendDate = ibeg-date  .
     7689                     vDocumentsTask:ToSendDate   = iend-date.
     7690                     for each tt-type, each tt-Class:
     7691                         vDocumentsTask:Category     = tt-type.id + "." + tt-Class.id.
     7692                        PutMes(substitute("Формируем список зависимых документов за период с &2 по &3  &1Категория: &4 &5",
     7693                                          chr(10),
     7694                                          ibeg-date ,
     7695                                          iend-date,
     7696                                          if tt-type .id eq "Any" then "" else tt-type.name,
     7697                                          tt-Class.name)).
     7698                         vDocumentList = vDocumentsTask:GetDocuments() no-error.
     7699                         if vDocumentList ne ?
     7700                         then do:
     7701                           do vii= 1 to vDocumentList:Count:
     7702                              if chekStop() then return ?.
     7703                              vDocument = vDocumentList:GetItem(vii - 1).
     7704                              odatelast = max(odatelast,vDocument:DocumentDate) no-error.
     7705                              odatelast = min(odatelast,today).
     7706                              packetupdd(vOrganization, vDocument).
     7707                              release object vDocument.
     7708                            end.
     7709                            release object vDocumentList.
     7710                         end.
     7711                      end.
     7712                      define variable VAlldoc    as integer no-undo.
     7713                      define variable vprocessed as integer no-undo.
     7714                      for each tt-pack :
     7715                         VAlldoc = VAlldoc + 1.
     7716                      end.
     7717                      for each tt-pack :
     7718                          if chekStop() then return ?.
     7719                         if GetDocumforid (tt-pack.orgid, tt-pack.docid, output vDocument) eq ""
     7720                         then do:
     7721                             run  UpdateUTDInformOne(vDocument).
     7722                            release object vDocument.
     7723                        end.
     7724                        vprocessed = vprocessed + 1.
     7725                        PutStat (substitute ("Обработано документов &1 из &2",vprocessed,vAllDoc),yes).
     7726                     end.
     7727         release object vOrganization.
     7728         release object vDocumentsTask.
     7729      end.
     7730      release object vOrganizationList.
     7731   end.
     7732   procedure updOneUTD:
     7733      define input  parameter idb-num as integer no-undo.
     7734      define input  parameter idoc-id as integer no-undo.
     7735      define variable vDocument as component-handle no-undo.
     7736      define buffer utd for utd.
     7737      for each tt-recid:
     7738         delete tt-recid.
     7739      end.
     7740      if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7741      then do:
     7742          run  UpdateUTDInformOne(vDocument).
     7743         release object vDocument.
     7744      end.
     7745   end.
     7746   function CRnewDocum return character
     7747   (
     7748   iOrgGuid as character,
     7749   iContGuid as character,
     7750   iTypeUTD as character,
     7751    iFile as character
     7752    ):
     7753   define variable vOrganization as component-handle no-undo.
     7754   define variable vSendTask as component-handle no-undo.
     7755       vOrganization = mDiadocConnection:GetOrganizationById(iOrgGuid ) no-error.
     7756       if vOrganization ne ?
     7757       then do:
     7758          vSendTask = vOrganization:CreatePackageSendTask2().
     7759          getdesc(vSendTask).
     7760          vSendTask:CounteragentId = iContGuid  .
     7761          vSendTask:AddDocumentFromFile("UniversalTransferDocument", iTypeUTD, "utd820_05_01_01", iFile).
     7762          vSendTask:Send()no-error.
     7763          if error-status:num-messages > 0 then do:
     7764             PutErr("ERROR Ошибка отправки документа").
     7765             return error "ERROR Ошибка отправки документа".
     7766          end.
     7767          else do:
     7768             PutMes("Документ отправлен успешно.").
     7769             message "Документ отправлен успешно."
     7770             view-as alert-box.
     7771          end.
     7772          release object vSendTask.
     7773         release object vOrganization .
     7774      end.
     7775   end.
     7776   procedure MySeqForUtd:
     7777      define input  parameter iTable       as character no-undo.
     7778      define input  parameter iseqnamehist as character no-undo.
     7779      define input  parameter idb-name     as character no-undo.
     7780      define output parameter Oseq         as int64 no-undo.
     7781      if iTable begins "utd"
     7782      then do:
     7783         if myseqUtd eq ?
     7784         then
     7785            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     7786         Oseq = myseqUtd.
     7787      end.
     7788      else
     7789         Oseq = ?.
     7790      return.
     7791   end.
     7792   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
     7793     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     7794     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
     7795     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     7796   END FUNCTION.
     7797   PROCEDURE get-month-name-case :
     7798     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     7799     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
     7800     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     7801     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
     7802       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     7803         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
     7804         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
     7805         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     7806         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
     7807         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
     7808     DO ON ERROR UNDO, RETURN ERROR :
     7809       IF p-month < 1 OR p-month > 12 OR
     7810          p-case  < 1 OR p-case  >  6 THEN DO:
     7811         ASSIGN p-name = ?.
     7812       END.                           ELSE DO:
     7813         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
     7814       END.
     7815     END.
     7816   END PROCEDURE.
     7817   define stream Out-Stream.
     7818   define stream OutStr-html.
     7819   define VARIABLE p-report-id         as character no-undo .
     7820   define variable v-file-name-rep-htm as character no-undo .
     7821   define variable v-vendor-name       as character no-undo .
     7822   define variable v-vendor-inn        as character no-undo .
     7823   define variable v-org-name          as character no-undo .
     7824   define variable v-org-inn           as character no-undo .
     7825   define variable v-contr-code        as character no-undo .
     7826   define variable v-contr-date        as character no-undo .
     7827   define variable v-date              as character no-undo .
     7828   define variable v-utd-date          as character no-undo .
     7829   define variable v-gds-name          as character no-undo .
     7830   define variable v-itog-level        as integer   no-undo .
     7831   define variable v-itog-unit         as integer   no-undo .
     7832   define variable v-obj-info          as character no-undo .
     7833   define variable v-gtin              as character no-undo .
     7834   define variable ser-level           as character no-undo .
     7835   def    var      Marking             as class     mark no-undo .
     7836   Marking = ObjSrv:Env:Marking:Sts:Mark .
     7837   FUNCTION GdsName RETURNS CHARACTER
     7838     ( input p-gds-code as integer)  FORWARD.
     7839   define buffer buf_utd               for ub.utd .
     7840   define buffer buf_utd-lines         for ub.utd-lines .
     7841   define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     7842   define buffer buf_clients           for ub.clients .
     7843   define buffer buf_firm              for ub.firm .
     7844   define buffer buf_contract          for ub.contract .
     7845   define buffer buf_marking           for ub.marking .
     7846   define temp-table tt-utd no-undo
     7847     field doc-id     as integer
     7848     field db-num     as integer
     7849     field gds-name   as character
     7850     field gds-code   as integer
     7851     field gtin       as character
     7852     field qnty-unit  as integer
     7853     field qnty-level as integer
     7854     field ser-level  as character
     7855     field linenum    as integer
     7856     index pi doc-id db-num gds-code linenum
     7857     .
     7858   do
     7859     on error undo, return error return-value
     7860     :
     7861     find first buf_utd no-lock where buf_utd.doc-id = p-doc-id and buf_utd.db-num = p-db-num no-error .
     7862     if not available (buf_utd) then
     7863     do:
     7864       message "УПД не найден"
     7865         view-as alert-box.
     7866       return .
     7867     end.
     7868     find first buf_clients no-lock where buf_clients.obj-code = buf_utd.cli-code and
     7869       buf_clients.obj-type = buf_utd.cli-type no-error .
     7870      if available (buf_clients) then v-vendor-name = buf_clients.obj-name .
     7871     find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error .
     7872     if available (buf_firm) then
     7873       v-vendor-inn = "ИНН: " + buf_firm.inn .
     7874     find first buf_clients no-lock where buf_clients.obj-code = buf_utd.obj-code and
     7875       buf_clients.obj-type = buf_utd.obj-type no-error .
     7876     if available (buf_clients) then
     7877     v-obj-info = buf_clients.obj-name .
     7878     find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error .
     7879     if available (buf_firm) then
     7880       v-obj-info = v-obj-info + " ИНН: " + buf_firm.inn .
     7881   end.
     7882   find first buf_contract no-lock where buf_contract.contract-code = buf_utd.contract-code no-error .
     7883   if available (buf_contract) then
     7884   do:
     7885     v-contr-code = buf_contract.contract-prn-code .
     7886     run get-DD-Month-YYYY(buf_contract.contract-date, output v-contr-date) .
     7887   end.
     7888   run get-DD-Month-YYYY(date(today), output v-date) .
     7889   run get-DD-Month-YYYY(buf_utd.DocumentDate, output v-utd-date) .
     7890   if buf_utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB then
     7891   do:
     7892     for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd.db-num and buf_utd-marking-lines.doc-id = buf_utd.doc-id and
     7893       buf_utd-marking-lines.sts = Marking:Checked_:KeyIntDB:
     7894       find first tt-utd where tt-utd.doc-id = buf_utd-marking-lines.doc-id and tt-utd.db-num = buf_utd-marking-lines.db-num
     7895         and tt-utd.linenum = buf_utd-marking-lines.LineNum and tt-utd.gds-code = buf_utd-marking-lines.gds-code no-error .
     7896       if not available (tt-utd) then
     7897       do:
     7898         create tt-utd .
     7899         assign
     7900           tt-utd.gds-name = GdsName(buf_utd-marking-lines.gds-code)
     7901           tt-utd.doc-id   = buf_utd-marking-lines.doc-id
     7902           tt-utd.db-num   = buf_utd-marking-lines.db-num
     7903           tt-utd.linenum  = buf_utd-marking-lines.LineNum
     7904           tt-utd.gds-code = buf_utd-marking-lines.gds-code
     7905           .
     7906       end.
     7907       if tt-utd.gtin <> "" then
     7908       do:
     7909         v-gtin = getGtinByDM(buf_utd-marking-lines.mark) .
     7910         if lookup (tt-utd.gtin, v-gtin) = 0 then tt-utd.gtin = tt-utd.gtin + ", " + v-gtin .
     7911       end.
     7912       else tt-utd.gtin = getGtinByDM(buf_utd-marking-lines.mark) .
     7913       tt-utd.gtin = getGtinByDM(buf_utd-marking-lines.mark) .
     7914       if buf_utd-marking-lines.doc-level = 1 then
     7915       do:
     7916         assign
     7917           tt-utd.qnty-level = tt-utd.qnty-level + 1
     7918           .
     7919         if tt-utd.ser-level <> "" then tt-utd.ser-level = tt-utd.ser-level + " " + GetTegCod(buf_utd-marking-lines.mark,"21") .
     7920         else tt-utd.ser-level = GetTegCod(buf_utd-marking-lines.mark,"21") .
     7921       end.
     7922       else tt-utd.qnty-unit = tt-utd.qnty-unit + 1 .
     7923     end.
     7924   end.
     7925   if buf_utd.EDocType = objSrv:Env:Utd:EDocType:AKT:KeyIntDB then
     7926   do:
     7927     for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd.db-num and buf_utd-marking-lines.doc-id = buf_utd.doc-id:
     7928       find first tt-utd where tt-utd.doc-id = buf_utd-marking-lines.doc-id and tt-utd.db-num = buf_utd-marking-lines.db-num
     7929         and tt-utd.linenum = buf_utd-marking-lines.LineNum and tt-utd.gds-code = buf_utd-marking-lines.gds-code no-error .
     7930       if not available (tt-utd) then
     7931       do:
     7932         create tt-utd .
     7933         assign
     7934           tt-utd.gds-name = GdsName(buf_utd-marking-lines.gds-code)
     7935           tt-utd.doc-id   = buf_utd-marking-lines.doc-id
     7936           tt-utd.db-num   = buf_utd-marking-lines.db-num
     7937           tt-utd.linenum  = buf_utd-marking-lines.LineNum
     7938           tt-utd.gds-code = buf_utd-marking-lines.gds-code
     7939           .
     7940         tt-utd.gtin = getGtinByDM(buf_utd-marking-lines.mark) .
     7941       end.
     7942       if buf_utd-marking-lines.doc-level = 1 then
     7943       do:
     7944         find first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark no-error .
     7945         assign
     7946           tt-utd.qnty-level = tt-utd.qnty-level + 1
     7947           .
     7948         tt-utd.qnty-unit = tt-utd.qnty-unit + buf_marking.box-qnty .
     7949         if tt-utd.ser-level <> "" then tt-utd.ser-level = tt-utd.ser-level + " " + GetTegCod(buf_utd-marking-lines.mark,"21") .
     7950         else tt-utd.ser-level = GetTegCod(buf_utd-marking-lines.mark,"21") .
     7951         ser-level = "".
     7952       end.
     7953     end.
     7954   end.
     7955   run get-report-num (output p-report-id).
     7956   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     7957   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     7958   put stream OutStr-html unformatted
