     8117   PROCEDURE get-report-num :
     8118     define output parameter p-report-num as integer no-undo .
     8119     do
     8120       on error undo, return error return-value
     8121       :
     8122       run gbl/getrpnum.p (output p-report-num).
     8123     end.
     8124   END PROCEDURE.
     8125   procedure get-DD-Month-YYYY:
     8126     define input parameter p-dat-date as date no-undo.
     8127     define output parameter p-str-date as character no-undo.
     8128     define variable v-str-date  as character no-undo.
     8129     define variable v-str-day   as character no-undo.
     8130     define variable v-num-month as character no-undo.
     8131     define variable v-str-month as character no-undo.
     8132     define variable v-str-year  as character no-undo.
     8133     v-str-date = string(p-dat-date).
     8134     do:
     8135       v-str-day = string(entry(1, v-str-date, "/")).
     8136     end.
     8137     do:
     8138       v-num-month = entry(2, v-str-date, "/").
     8139       v-str-month = MonthNameRusCase(integer(v-num-month), 2).
     8140     end.
     8141     do:
     8142       v-str-year = string(year(p-dat-date)).
     8143     end.
     8144     p-str-date = '" ' + v-str-day + ' "' + " " + v-str-month + " " + v-str-year + " г.".
     8145   end procedure.
     8146   FUNCTION GdsName RETURNS CHARACTER
     8147     ( input p-gds-code as integer) :
     8148     define variable v-gds-name as character no-undo .
     8149     define buffer buf_goods for ub.goods .
     8150     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     8151     if available (buf_goods) then v-gds-name = buf_goods.gds-name .
     8152     RETURN v-gds-name.
     8153   END FUNCTION.
