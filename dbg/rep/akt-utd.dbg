     8033   v-itog-level = 0 .
     8034   v-itog-unit = 0 .
     8035   for each tt-utd no-lock by tt-utd.linenum:
     8036     v-itog-level = v-itog-level + tt-utd.qnty-level .
     8037     v-itog-unit = v-itog-unit + tt-utd.qnty-unit .
