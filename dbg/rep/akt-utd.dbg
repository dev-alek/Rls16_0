     7994     '<tr><td colspan="15" style="text-align: center; font-weight: bold;">приема-передачи товара</td></tr>'
     7995     '<tr><td colspan="15" style="text-align: center; font-weight: bold;">№' + string(buf_utd.DocumentNumber) + '</td></tr>'
     7996     '<tr>' skip
