     7981     '<td style="width: 5px;"></td>' skip
     7982     '<td style="width: 40px;"></td>' skip
     7983     '<td style="width: 20px;"></td>' skip
     7984     '<td style="width: 30px;"></td>' skip
     7985     '<td style="width: 40px;"></td>' skip
     7986     '<td style="width: 5px;"></td>' skip
     7987     '<td style="width: 20px;"></td>' skip
     7988     '<td style="width: 5px;"></td>' skip
     7989     '<td style="width: 10px;"></td>' skip
     7990     '<td style="width: 30px;"></td>' skip
     7991     '<td style="width: 40px;"></td>' skip
     7992     '</tr>' skip
