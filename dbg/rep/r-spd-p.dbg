     4533   end procedure.
     4534   procedure AddTempSum :
     4535     define input parameter  p-num as integer   no-undo .
     4536     do
     4537     on error undo, return error return-value
     4538     :
     4539       define buffer buf_Temp-Sum for Temp-Sum .
     4540       for each Temp-Sum
     4541         where Temp-Sum.type = p-num
     4542       :
     4543         find first buf_Temp-Sum
     4544           where buf_Temp-Sum.type = p-num - 1
     4545             and buf_Temp-Sum.ind  = Temp-Sum.ind
     4546         no-error .
     4547         assign Temp-Sum.sum = Temp-Sum.sum + buf_Temp-Sum.sum  .
     4548       end.
     4549     end.
     4550   end procedure.
