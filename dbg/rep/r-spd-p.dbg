     1473               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1474        .
     1475     end.
     1476   end.
     1477   assign
     1478   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1479   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1480               ASSIGN
     1481                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1482                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1483                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1484                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1485                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1486                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1487                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1488                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1489                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1490                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1491                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1492                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1493                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1494               .
     1495           end.
     1496       end.
     1497       assign
     1498           p-transport-base      = 0
     1499           p-transport-rubl      = 0
     1500           p-vat-pc              = buf_doc-line.vat-pc
     1501           p-slt-pc              = buf_doc-line.slt-pc
     1502       .
     1503     end.
     1504     if p-fact-qnty      = ?
     1505     or p-vat-pc         = ?
     1506     or p-slt-pc         = ?
     1507     or p-sum-base       = ?
     1508     or p-sum-rubl       = ?
     1509     or p-vat-base       = ?
     1510     or p-vat-rubl       = ?
     1511     or p-slt-base       = ?
     1512     or p-slt-rubl       = ?
     1513     or p-road-tax-base  = ?
     1514     or p-road-tax-rubl  = ?
     1515     or p-transport-base = ?
     1516     or p-transport-rubl = ?
     1517     or p-other-base     = ?
     1518     or p-other-rubl     = ?
     1519     or p-excise-base    = ?
     1520     or p-excise-rubl    = ?
     1521     then do:
     1522       message
     1523         vss-workfile vss-revision vss-description skip
     1524         vss-include-info14 skip
     1525         "Получены неопределенные значения" skip
     1526         "Документ" p-doc-code skip
     1527         "Артикул" p-artic p-prod-type p-prod-code skip
     1528         "fact-qnty     " p-fact-qnty      skip
