     4434       assign v-row = v-row + 1 .
     4435     end.
     4436   end procedure.
     4437   procedure PrintItog :
     4438     define input parameter  p-num as integer   no-undo .
     4439     do
     4440     on error undo, return error return-value
     4441     :
     4442       if p-provider = 1 then do:
     4443         if p-num = 2 then do:
     4444           run AddTempSum (3) .
     4445           run macr_excel_char("Итого по группе: " + temp-goods.grp-name, v-row, 2) .
     4446         end.
     4447         else run macr_excel_char("Итого: ", v-row, 2) .
     4448       end.
     4449       else do:
     4450         case p-num :
     4451           when 2 then do:
     4452             run macr_excel_char("Итого по группе: " + temp-goods-cli.grp-name, v-row, 2) .
     4453             run AddTempSum (3) .
     4454           end.
     4455           when 3 then do:
     4456             run macr_excel_char("Итого по поставщику:" + temp-goods-cli.cli, v-row, 2) .
     4457             run AddTempSum (4) .
     4458           end.
     4459           when 4 then run macr_excel_char("Итого:", v-row, 2) .
     4460         end.
     4461       end.
     4462       for each Temp-Sum
     4463         where Temp-Sum.type = p-num
     4464         :
     4465         if Temp-Sum.sum <> ? then run macr_excel_sum  ( Temp-Sum.sum, v-row, Temp-Sum.ind,  3) .
     4466         assign Temp-Sum.sum = 0 .
     4467       end.
     4468       assign v-row = v-row + 1 .
     4469     end.
     4470   end procedure.
     4471   procedure InitTempSum :
     4472     define input parameter  p-num as integer   no-undo .
     4473     do
     4474     on error undo, return error return-value
     4475     :
     4476       assign ii = 3 .
     4477       for each obj-list :
     4478         if p-rashod = yes then do:
     4479           create Temp-Sum .
     4480           assign
     4481             Temp-Sum.type = p-num
     4482             Temp-Sum.ind  = ii
     4483             Temp-Sum.sum  = 0
     4484             ii = ii + 1
     4485           .
     4486         end.
     4487         if p-speed = yes then do:
