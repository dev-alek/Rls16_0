     1215         undo, return error .
     1216       end.
     1217       find first buf_trn-doc no-lock
     1218         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1219         no-error .
     1220       if not available buf_trn-doc then do:
     1221         message
     1222           vss-workfile vss-revision vss-description skip
     1223           vss-include-info14 skip
     1224           "Не найден документ" skip
     1225           "Документ" p-doc-code skip
