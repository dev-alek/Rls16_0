     4084             and buf_stk-supp-line.prod-code = temp-goods-cli.prod-code
     4085             and buf_stk-supp-line.sum-type  = 'sadt':U + str-find
     4086             and buf_stk-supp-line.fact-order < v-fact-order-end
     4087         no-error .
     4088         if available buf_stk-supp-line then assign Temp-obj1.rashod = Temp-obj1.rashod - buf_stk-supp-line.fact-qnty .
     4089         find last buf_stk-supp-line no-lock
     4090           where buf_stk-supp-line.obj-type  = Temp-date.obj-type
     4091             and buf_stk-supp-line.obj-code  = Temp-date.obj-code
     4092             and buf_stk-supp-line.cli-type  = temp-goods-cli.cli-type
     4093             and buf_stk-supp-line.cli-code  = temp-goods-cli.cli-code
     4094             and buf_stk-supp-line.artic     = temp-goods-cli.artic
     4095             and buf_stk-supp-line.prod-type = temp-goods-cli.prod-type
     4096             and buf_stk-supp-line.prod-code = temp-goods-cli.prod-code
     4097             and buf_stk-supp-line.sum-type  = 'sadt':U + str-find
     4098             and buf_stk-supp-line.fact-order <= v-fact-order-start
     4099           no-error .
     4100         if available buf_stk-supp-line then assign Temp-obj1.rashod = Temp-obj1.rashod + buf_stk-supp-line.fact-qnty .
     4101         find last buf_stk-supp-line no-lock
     4102           where buf_stk-supp-line.obj-type  = Temp-date.obj-type
     4103             and buf_stk-supp-line.obj-code  = Temp-date.obj-code
     4104             and buf_stk-supp-line.cli-type  = temp-goods-cli.cli-type
     4105             and buf_stk-supp-line.cli-code  = temp-goods-cli.cli-code
     4106             and buf_stk-supp-line.artic     = temp-goods-cli.artic
     4107             and buf_stk-supp-line.prod-type = temp-goods-cli.prod-type
     4108             and buf_stk-supp-line.prod-code = temp-goods-cli.prod-code
     4109             and buf_stk-supp-line.sum-type  = 'sadt':U + str-find1
     4110             and buf_stk-supp-line.fact-order < v-fact-order-end
     4111         no-error .
     4112         if available buf_stk-supp-line then assign Temp-obj1.rashod = Temp-obj1.rashod - buf_stk-supp-line.fact-qnty .
     4113         find last buf_stk-supp-line no-lock
     4114           where buf_stk-supp-line.obj-type  = Temp-date.obj-type
     4115             and buf_stk-supp-line.obj-code  = Temp-date.obj-code
     4116             and buf_stk-supp-line.cli-type  = temp-goods-cli.cli-type
     4117             and buf_stk-supp-line.cli-code  = temp-goods-cli.cli-code
     4118             and buf_stk-supp-line.artic     = temp-goods-cli.artic
     4119             and buf_stk-supp-line.prod-type = temp-goods-cli.prod-type
     4120             and buf_stk-supp-line.prod-code = temp-goods-cli.prod-code
     4121             and buf_stk-supp-line.sum-type  = 'sadt':U + str-find1
     4122             and buf_stk-supp-line.fact-order <= v-fact-order-start
     4123           no-error .
     4124         if available buf_stk-supp-line then assign Temp-obj1.rashod = Temp-obj1.rashod + buf_stk-supp-line.fact-qnty .
     4125         run CalcDayNal1 (input temp-goods-cli.artic,    input temp-goods-cli.prod-type, input temp-goods-cli.prod-code,
     4126                          input Temp-date.obj-type,      input Temp-date.obj-code,
     4127                          input temp-goods-cli.cli-type, input temp-goods-cli.cli-code,  output v-day-nal) .
     4128         if v-day-nal > 0 then do:
     4129           assign
     4130             Temp-obj1.speed      = Temp-obj1.rashod * 30 / v-day-nal
     4131             temp-goods-cli.sum-speed = temp-goods-cli.sum-speed + Temp-obj1.speed
     4132           .
     4133         end.
     4134       end.
     4135       for each  buf_trn-doc no-lock
     4136         where buf_trn-doc.obj-type = Temp-date.obj-type
     4137           and buf_trn-doc.obj-code = Temp-date.obj-code
     4138           and buf_trn-doc.internal = no
     4139           and buf_trn-doc.doc-type = 'при':U
     4140           and buf_trn-doc.ext-doc-type = 'ie':U
     4141           and buf_trn-doc.status_  = 'накл':U
     4142         :
     4143         for each buf1_doc-line no-lock
     4144           where buf1_doc-line.doc-code  = buf_trn-doc.doc-code
     4145           :
     4146           find first temp-goods-cli
     4147             where temp-goods-cli.artic     = buf1_doc-line.artic
     4148               and temp-goods-cli.prod-code = buf1_doc-line.prod-code
     4149               and temp-goods-cli.prod-type = buf1_doc-line.prod-type
     4150               and temp-goods-cli.cli-code  = buf_trn-doc.cli-code
     4151               and temp-goods-cli.cli-type  = buf_trn-doc.cli-type
     4152             no-error .
     4153           if available  temp-goods-cli then do:
     4154             assign temp-goods-cli.sum-postup = temp-goods-cli.sum-postup + buf1_doc-line.fact-qnty .
     4155             find first Temp-obj1
     4156               where Temp-obj1.gds-code = temp-goods.gds-code
     4157                 and Temp-obj1.obj-type = Temp-date.obj-type
     4158                 and Temp-obj1.obj-code = Temp-date.obj-code
     4159               no-error .
     4160             if available  Temp-obj1 then assign Temp-obj1.postup = Temp-obj1.postup + buf1_doc-line.fact-qnty .
     4161           end.
     4162         end.
     4163       end.
     4164     end.
     4165     if p-null = no then do:
     4166       for each temp-goods-cli :
     4167         if temp-goods-cli.sum-reserv = 0 and temp-goods-cli.sum-postup = 0 and temp-goods-cli.sum-ostat = 0 and temp-goods-cli.sum-speed = 0 then do:
     4168           assign ii = 0 .
     4169           for each obj-list :
     4170             for each Temp-obj1
     4171               where Temp-obj1.gds-code = temp-goods-cli.gds-code
     4172                 and Temp-obj1.cli-type = temp-goods-cli.cli-type
     4173                 and Temp-obj1.cli-code = temp-goods-cli.cli-code
     4174                 and Temp-obj1.obj-type = obj-list.obj-type
     4175                 and Temp-obj1.obj-code = obj-list.obj-code
     4176             :
     4177               if Temp-obj1.rashod <> 0 or Temp-obj1.speed <> 0 or Temp-obj1.ostat <> 0 then do:
     4178                 assign ii = 1 .
     4179                 leave.
     4180               end.
     4181             end.
     4182           end.
     4183           if ii = 0 then do:
     4184             for each  Temp-obj1
     4185               where Temp-obj1.gds-code = temp-goods-cli.gds-code
     4186                 and Temp-obj1.cli-code = temp-goods-cli.cli-code
     4187                 and Temp-obj1.cli-type = temp-goods-cli.cli-type
     4188               :
     4189                 delete Temp-obj1 .
     4190             end.
     4191             delete temp-goods-cli .
     4192           end.
     4193         end.
     4194       end.
     4195     end.
     4196     end.
     4197   end procedure.
     4198   PROCEDURE CalcDayNal1 :
     4199     define input parameter  p-artic     as character no-undo .
     4200     define input parameter  p-prod-type as character no-undo .
     4201     define input parameter  p-prod-code as integer   no-undo .
     4202     define input parameter  p-obj-type  as character no-undo .
     4203     define input parameter  p-obj-code  as integer no-undo .
     4204     define input parameter  p-cli-type  as character no-undo .
     4205     define input parameter  p-cli-code  as integer no-undo .
     4206     define output parameter p-day-nal   as integer initial 0 no-undo .
     4207     define variable cur-fo as decimal   no-undo .
     4208     define variable is-null as logical initial yes no-undo .
     4209     for each Temp-DayNal :
     4210       assign Temp-DayNal.DayNal = no .
     4211       find last buf_stk-supp-line no-lock
     4212           where buf_stk-supp-line.obj-type  = p-obj-type
     4213             and buf_stk-supp-line.obj-code  = p-obj-code
     4214             and buf_stk-supp-line.cli-type  = p-cli-type
     4215             and buf_stk-supp-line.cli-code  = p-cli-code
     4216             and buf_stk-supp-line.artic     = p-artic
     4217             and buf_stk-supp-line.prod-type = p-prod-type
     4218             and buf_stk-supp-line.prod-code = p-prod-code
     4219             and buf_stk-supp-line.fact-order < Temp-DayNal.f-o2
     4220             and buf_stk-supp-line.sum-type   = 'cost':U
     4221           no-error.
     4222       if available  buf_stk-supp-line then  do:
     4223         if buf_stk-supp-line.fact-qnty <> 0 then assign Temp-DayNal.DayNal = yes .
     4224         else if buf_stk-supp-line.fact-order > Temp-DayNal.f-o1 then do:
     4225           find prev buf_stk-supp-line no-lock no-error .
     4226           if available  buf_stk-supp-line then  do:
     4227             if buf_stk-supp-line.fact-qnty <> 0 then assign Temp-DayNal.DayNal = yes .
     4228           end.
     4229         end.
     4230       end.
     4231       if Temp-DayNal.DayNal = yes then assign p-day-nal = p-day-nal + 1 .
     4232     end.
     4233   END PROCEDURE.
     4234   define variable vss-include-info38 as character format "X(65)" no-undo
     4235   initial "@(#)$Workfile$".
     4236   procedure PutColumnTitulExcel :
     4237     do
     4238     on error undo, return error return-value
     4239     :
     4240     assign
     4241       v-row = 7
     4242       v-col = 3
     4243     .
     4244     run macr_excel_char (ReportNAme, 1, 3) .
     4245     run macr_cell_format ( 11, yes, no, ?, 1, 3, 1, 3) .
     4246     run macr_excel_char (str1, 2, 1) .
     4247     run macr_excel_char (str2, 3, 1) .
     4248     run macr_excel_char (ReportHeader, 4, 1) .
     4249     run macr_excel_char("Артикул", 5, 1) .
     4250     run macr_cell_size (14,?, 5, 1,?,?).
     4251     run macr_excel_char("Наименование товара", 5, 2) .
     4252     run macr_cell_size (40,?, 5, 2,?,?).
     4253     for each obj-list :
     4254       if p-rashod and p-speed then  run macr_excel_char(obj-list.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ")", 5, v-col + 2 ) .
     4255       else   run macr_excel_char(obj-list.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ")", 5, v-col + 1 ) .
     4256       if p-rashod then do:
     4257         run macr_excel_char("внешний расход", 6, v-col) .
     4258         run macr_cell_size   (14,?, 6, v-col, 6, v-col) .
     4259         assign v-col = v-col + 1 .
     4260       end.
     4261       if p-speed then do:
     4262         run macr_excel_char("скорость продаж", 6, v-col) .
     4263         run macr_cell_size   (14,?, 6, v-col, 6, v-col) .
     4264         assign v-col = v-col + 1 .
     4265       end.
     4266       run macr_excel_char("остаток факт", 6, v-col) .
     4267       run macr_cell_size   (14,?, 6, v-col, 6, v-col) .
     4268       assign v-col = v-col + 1 .
     4269       run macr_excel_char("ожидаемое поступление", 6, v-col) .
     4270       run macr_cell_size   (14,?, 6, v-col, 6, v-col) .
     4271       assign v-col = v-col + 1 .
     4272       run macr_excel_char("количество товара в резерве", 6, v-col) .
     4273       run macr_cell_size   (14,?, 6, v-col, 6, v-col) .
     4274       assign v-col = v-col + 1 .
     4275     end.
     4276     run macr_excel_char("Суммарный остаток", 5, v-col) .
     4277     assign v-col = v-col + 1 .
     4278     run macr_excel_char("Необходимо закупить", 5, v-col) .
     4279     assign v-col = v-col + 1 .
     4280     run macr_excel_char("Поставщики, поставлявшие товар", 5, v-col) .
     4281     run macr_cell_bordur ( 5, 1, 6, v-col) .
     4282     run macr_cell_format ( 10, yes, no, 35, 5, 1, 6, v-col) .
     4283     run macr_cell_size   (14,?, 5, v-col - 4, 6, v-col) .
     4284     end.
     4285   end procedure.
     4286   procedure PrintLine :
     4287     do
     4288     on error undo, return error return-value
     4289     :
     4290     define variable show as logical initial yes no-undo .
     4291     define variable s-prov as character no-undo .
     4292     if p-null = no then do:
     4293       if temp-goods.sum-reserv = 0 and temp-goods.sum-postup = 0 and temp-goods.sum-ostat = 0 and temp-goods.sum-speed = 0 then do:
     4294         assign show = no .
     4295         for each obj-list :
     4296           find first Temp-obj1
     4297             where Temp-obj1.gds-code = temp-goods.gds-code
     4298               and Temp-obj1.obj-type = obj-list.obj-type
     4299               and Temp-obj1.obj-code = obj-list.obj-code
     4300             no-error .
     4301           if Temp-obj1.rashod <> 0 or Temp-obj1.speed <> 0 or Temp-obj1.ostat <> 0 then do:
     4302             assign show = yes .
     4303             leave.
     4304           end.
     4305         end.
     4306       end.
     4307     end.
     4308     if show = yes then do:
     4309       if  ( v-row ) >= 63000 then do:
     4310         Output stream Macr_Excel  close .
     4311         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     4312         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     4313         output stream  Macr_Excel to value(v-file-name) .
     4314         v-ind = v-ind + 1 .
     4315         run PutColumnTitulExcel in this-procedure .
     4316       end.
     4317       run macr_excel_char(temp-goods.artic, v-row, 1) .
     4318       run macr_excel_char(temp-goods.gds-name, v-row, 2) .
     4319       assign v-col = 3 .
     4320       for each obj-list :
     4321         find first Temp-obj1
     4322           where Temp-obj1.gds-code = temp-goods.gds-code
     4323             and Temp-obj1.obj-type = obj-list.obj-type
     4324             and Temp-obj1.obj-code = obj-list.obj-code
     4325           no-error .
     4326         if p-rashod = yes then do:
     4327           find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4328           assign Temp-Sum.sum = Temp-Sum.sum + Temp-obj1.rashod  .
     4329           run macr_excel_sum  ( Temp-obj1.rashod, v-row, v-col,  3) .
     4330           assign v-col = v-col + 1 .
     4331         end.
     4332         if p-speed = yes then do:
     4333           find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4334           assign Temp-Sum.sum = ? .
     4335           run macr_excel_sum  ( Temp-obj1.speed , v-row, v-col,  3) .
     4336           assign v-col = v-col + 1 .
     4337         end.
     4338         find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4339         assign Temp-Sum.sum = Temp-Sum.sum + Temp-obj1.ostat .
     4340         run macr_excel_sum  ( Temp-obj1.ostat , v-row, v-col,  3) .
     4341         assign v-col = v-col + 1 .
     4342         find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4343         assign Temp-Sum.sum = Temp-Sum.sum + Temp-obj1.postup .
     4344         run macr_excel_sum  ( Temp-obj1.postup , v-row, v-col,  3) .
     4345         assign v-col = v-col + 1 .
     4346         find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4347         assign Temp-Sum.sum = Temp-Sum.sum + Temp-obj1.reserv .
     4348         run macr_excel_sum  ( Temp-obj1.reserv , v-row, v-col,  3) .
     4349         assign v-col = v-col + 1 .
     4350       end.
     4351       find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4352       assign Temp-Sum.sum = Temp-Sum.sum + temp-goods.sum-ostat .
     4353       run macr_excel_sum  ( temp-goods.sum-ostat , v-row, v-col,  3) .
     4354       assign v-col = v-col + 1 .
     4355       find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4356       assign Temp-Sum.sum = Temp-Sum.sum + temp-goods.sum-speed * p-day / 30 - temp-goods.sum-ostat - temp-goods.sum-postup + temp-goods.sum-reserv  .
     4357       run macr_excel_sum  ( temp-goods.sum-speed * p-day / 30 - temp-goods.sum-ostat - temp-goods.sum-postup + temp-goods.sum-reserv , v-row, v-col,  3) .
     4358       assign
     4359         v-col = v-col + 1
     4360         s-prov = ""
     4361       .
     4362       for each Temp-cli where Temp-cli.gds-code = temp-goods.gds-code :
     4363          assign s-prov = s-prov + string(Temp-cli.cli-code) + ", " .
     4364       end.
     4365       run macr_excel_char(s-prov, v-row, v-col) .
     4366       assign v-row = v-row + 1 .
     4367     end.
     4368     end.
     4369   end procedure.
