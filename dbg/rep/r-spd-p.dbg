     3664           .
     3665         end.
     3666         if first-of(temp-goods-cli.grp-name ) then do:
     3667           run macr_excel_char("Группа: " + temp-goods-cli.grp-name, v-row, 2) .
     3668           assign
     3669             v-row = v-row + 1
     3670             str-grp = temp-goods-cli.grp-name
     3671           .
     3672         end.
     3673         run PrintLine1 in this-procedure .
     3674         if last-of(temp-goods-cli.grp-name ) then run PrintItog in this-procedure (2) .
     3675         if last-of(temp-goods-cli.cli )      then run PrintItog in this-procedure (3) .
     3676       end.
     3677       run PrintItog in this-procedure (4) .
     3678     end.
     3679     output stream macr_excel close .
     3680     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     3681     run end-proc .
     3682   if mFrameView
     3683   then do:
     3684      HIDE FRAME InfoFrame.
     3685   end.
     3686   if session :set-wait-state( "" ) then.
     3687     run rep/runexcel.p (v-file-name ).
     3688   end.
     3689   define variable vss-include-info36 as character format "X(65)" no-undo
     3690   initial "@(#)$Workfile$".
     3691   procedure search-prov :
     3692     do on error undo, return error return-value :
     3693       for each temp-goods :
     3694         for each obj-list :
     3695           for each buf1_doc-line no-lock
     3696             where buf1_doc-line.obj-type     = obj-list.obj-type
     3697               and buf1_doc-line.obj-code     = obj-list.obj-code
     3698               and buf1_doc-line.prod-type    = temp-goods.prod-type
     3699               and buf1_doc-line.prod-code    = temp-goods.prod-code
     3700               and buf1_doc-line.artic        = temp-goods.artic
     3701               and buf1_doc-line.ext-doc-type = 'ie':U
     3702               and buf1_doc-line.status_      = 'факт':U
     3703             :
     3704             find first buf_trn-doc no-lock
     3705               where buf_trn-doc.doc-code = buf1_doc-line.doc-code
     3706               no-error .
     3707             find first Temp-cli
     3708               where Temp-cli.gds-code = temp-goods.gds-code
     3709                 and Temp-cli.cli-type = buf_trn-doc.cli-type
     3710                 and Temp-cli.cli-code = buf_trn-doc.cli-code
     3711               no-error .
     3712             if not available Temp-cli then do:
     3713               find first buf_clients no-lock
     3714                 where buf_clients.obj-type = buf_trn-doc.cli-type
     3715                   and buf_clients.obj-code = buf_trn-doc.cli-code
     3716               no-error .
     3717               if not available buf_clients then next .
     3718               create Temp-cli.
     3719               assign
     3720                 Temp-cli.gds-code = temp-goods.gds-code
     3721                 Temp-cli.cli-type = buf_trn-doc.cli-type
     3722                 Temp-cli.cli-code = buf_trn-doc.cli-code
     3723                 Temp-cli.cli      = buf_clients.obj-name
     3724               .
     3725             end.
     3726           end.
     3727         end.
     3728       end.
     3729     end.
     3730   end procedure.
     3731   procedure Ostatok :
     3732     do
     3733     on error undo, return error return-value
     3734     :
     3735     for each Temp-date :
     3736       if Temp-date.obj-type = 'маг':U then
     3737         assign
     3738           str-find = 'es':U
     3739           str-find1 = 'rs':U
     3740         .
     3741       else
     3742         assign
     3743           str-find = 'ee':U
     3744           str-find1 = 're':U
     3745         .
     3746       for each temp-goods  :
     3747         assign Counter1 = Counter1 + 1.
     3748   IF ( Counter1 modulo v-account = 0 )  then DO:
     3749             if  log-manager:logfile-name ne ?
     3750             then DO:
     3751                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3752             end.
     3753              if mFrameView
     3754              then do:
     3755               DISPLAY
     3756                 Counter1 @ RecordsDone
     3757                 WITH FRAME InfoFrame.
     3758              end.
     3759   End.
     3760      if v-button-stop then  DO:
     3761            if mFrameView
     3762            then
     3763               PROCESS EVENTS.
     3764            IF StopProcessing THEN DO:
     3765            RETURN error.
     3766            End.
     3767      end.
     3768         find first Temp-obj1
     3769           where Temp-obj1.gds-code = temp-goods.gds-code
     3770             and Temp-obj1.obj-type = Temp-date.obj-type
     3771             and Temp-obj1.obj-code = Temp-date.obj-code
     3772           no-error .
     3773         if not available Temp-obj1 then do:
     3774           create Temp-obj1 .
     3775           assign
     3776             Temp-obj1.gds-code = temp-goods.gds-code
     3777             Temp-obj1.obj-code = Temp-date.obj-code
     3778             Temp-obj1.obj-type = Temp-date.obj-type
     3779             Temp-obj1.rashod   = 0
     3780             Temp-obj1.speed    = 0
     3781             Temp-obj1.ostat    = 0
     3782           .
     3783         end.
     3784         find last buf_stk-line no-lock
     3785           where buf_stk-line.obj-type  = Temp-date.obj-type
     3786             and buf_stk-line.obj-code  = Temp-date.obj-code
     3787             and buf_stk-line.artic     = temp-goods.artic
     3788             and buf_stk-line.prod-type = temp-goods.prod-type
     3789             and buf_stk-line.prod-code = temp-goods.prod-code
     3790             and buf_stk-line.sum-type  = 'crsa':U
     3791             and buf_stk-line.cat-id    = '##,##'
     3792             and buf_stk-line.fact-order < Temp-date.cur-fact-order
     3793           use-index category no-error .
     3794         if available buf_stk-line then do:
     3795           assign
     3796             temp-goods.sum-ostat = temp-goods.sum-ostat + buf_stk-line.fact-qnty
     3797             Temp-obj1.ostat = Temp-obj1.ostat + buf_stk-line.fact-qnty
     3798           .
     3799         end.
     3800         find last buf_stk-line no-lock
     3801           where buf_stk-line.obj-type  = Temp-date.obj-type
     3802             and buf_stk-line.obj-code  = Temp-date.obj-code
     3803             and buf_stk-line.artic     = temp-goods.artic
     3804             and buf_stk-line.prod-type = temp-goods.prod-type
     3805             and buf_stk-line.prod-code = temp-goods.prod-code
     3806             and buf_stk-line.sum-type  = 'csdt':U + str-find
     3807             and buf_stk-line.cat-id    = '##,##'
     3808             and buf_stk-line.fact-order < v-fact-order-end
     3809         no-error .
     3810         if available buf_stk-line then assign Temp-obj1.rashod = Temp-obj1.rashod - buf_stk-line.fact-qnty .
     3811         find last buf_stk-line no-lock
     3812           where buf_stk-line.obj-type  = Temp-date.obj-type
     3813             and buf_stk-line.obj-code  = Temp-date.obj-code
     3814             and buf_stk-line.artic     = temp-goods.artic
     3815             and buf_stk-line.prod-type = temp-goods.prod-type
     3816             and buf_stk-line.prod-code = temp-goods.prod-code
     3817             and buf_stk-line.sum-type  = 'csdt':U + str-find
     3818             and buf_stk-line.cat-id    = '##,##'
     3819             and buf_stk-line.fact-order <= v-fact-order-start
     3820           no-error .
     3821         if available buf_stk-line then assign Temp-obj1.rashod = Temp-obj1.rashod + buf_stk-line.fact-qnty .
     3822         find last buf_stk-line no-lock
     3823           where buf_stk-line.obj-type  = Temp-date.obj-type
     3824             and buf_stk-line.obj-code  = Temp-date.obj-code
     3825             and buf_stk-line.artic     = temp-goods.artic
     3826             and buf_stk-line.prod-type = temp-goods.prod-type
     3827             and buf_stk-line.prod-code = temp-goods.prod-code
     3828             and buf_stk-line.sum-type  = 'csdt':U + str-find1
     3829             and buf_stk-line.cat-id    = '##,##'
     3830             and buf_stk-line.fact-order < v-fact-order-end
     3831         no-error .
     3832         if available buf_stk-line then assign Temp-obj1.rashod = Temp-obj1.rashod - buf_stk-line.fact-qnty .
     3833         find last buf_stk-line no-lock
     3834           where buf_stk-line.obj-type  = Temp-date.obj-type
     3835             and buf_stk-line.obj-code  = Temp-date.obj-code
     3836             and buf_stk-line.artic     = temp-goods.artic
     3837             and buf_stk-line.prod-type = temp-goods.prod-type
     3838             and buf_stk-line.prod-code = temp-goods.prod-code
     3839             and buf_stk-line.sum-type  = 'csdt':U + str-find1
     3840             and buf_stk-line.cat-id    = '##,##'
     3841             and buf_stk-line.fact-order <= v-fact-order-start
     3842           no-error .
     3843         if available buf_stk-line then assign Temp-obj1.rashod = Temp-obj1.rashod + buf_stk-line.fact-qnty .
     3844         run CalcDayNal (input temp-goods.artic, input temp-goods.prod-type, input temp-goods.prod-code, input Temp-date.obj-type, input Temp-date.obj-code,output v-day-nal) .
     3845         if v-day-nal > 0 then do:
     3846           assign
     3847             Temp-obj1.speed      = Temp-obj1.rashod * 30 / v-day-nal
     3848             temp-goods.sum-speed = temp-goods.sum-speed + Temp-obj1.speed
     3849           .
     3850         end.
     3851       end.
     3852       for each  buf_trn-doc no-lock
     3853         where buf_trn-doc.obj-type = Temp-date.obj-type
     3854           and buf_trn-doc.obj-code = Temp-date.obj-code
     3855           and buf_trn-doc.internal = no
     3856           and buf_trn-doc.doc-type = 'при':U
     3857           and buf_trn-doc.ext-doc-type = 'ie':U
     3858           and buf_trn-doc.status_  = 'накл':U
     3859           or
     3860               buf_trn-doc.obj-type = Temp-date.obj-type
     3861           and buf_trn-doc.obj-code = Temp-date.obj-code
     3862           and buf_trn-doc.internal = yes
     3863           and buf_trn-doc.doc-type = 'при':U
     3864           and buf_trn-doc.ext-doc-type = 'iv':U
     3865           and buf_trn-doc.status_  = 'накл':U
     3866         :
     3867         for each buf1_doc-line no-lock
     3868           where buf1_doc-line.doc-code  = buf_trn-doc.doc-code
     3869           :
     3870           find first temp-goods
     3871             where temp-goods.artic     = buf1_doc-line.artic
     3872               and temp-goods.prod-code = buf1_doc-line.prod-code
     3873               and temp-goods.prod-type = buf1_doc-line.prod-type
     3874             no-error .
     3875           if available  temp-goods then do:
     3876             assign temp-goods.sum-postup = temp-goods.sum-postup + buf1_doc-line.fact-qnty .
     3877             find first Temp-obj1
     3878               where Temp-obj1.gds-code = temp-goods.gds-code
     3879                 and Temp-obj1.obj-type = Temp-date.obj-type
     3880                 and Temp-obj1.obj-code = Temp-date.obj-code
     3881               no-error .
     3882             if available  Temp-obj1 then assign Temp-obj1.postup = Temp-obj1.postup + buf1_doc-line.fact-qnty .
     3883           end.
     3884         end.
     3885       end.
     3886     end.
     3887     end.
     3888   end procedure.
     3889   PROCEDURE CalcDayNal :
     3890     define input parameter  p-artic     as character no-undo .
     3891     define input parameter  p-prod-type as character no-undo .
     3892     define input parameter  p-prod-code as integer   no-undo .
     3893     define input parameter  p-obj-type  as character no-undo .
     3894     define input parameter  p-obj-code  as integer no-undo .
     3895     define output parameter p-day-nal   as integer initial 0 no-undo .
     3896     for each Temp-DayNal :
     3897       assign Temp-DayNal.DayNal = no .
     3898       find first doc-line no-lock
     3899         where doc-line.obj-type  = p-obj-type
     3900           and doc-line.obj-code  = p-obj-code
     3901           and doc-line.prod-code = p-prod-code
     3902           and doc-line.prod-type = p-prod-type
     3903           and doc-line.artic     = p-artic
     3904           and doc-line.status_   = 'факт':U
     3905           and doc-line.fact-order >= Temp-DayNal.f-o1
     3906           and doc-line.fact-order <  Temp-DayNal.f-o2
     3907         no-error .
     3908       if available doc-line then assign Temp-DayNal.DayNal = yes .
     3909       if Temp-DayNal.DayNal = no then do:
     3910         find last stk-line no-lock
     3911           where stk-line.obj-type  = p-obj-type
     3912             and stk-line.obj-code  = p-obj-code
     3913             and stk-line.artic     = p-artic
     3914             and stk-line.prod-code = p-prod-code
     3915             and stk-line.prod-type = p-prod-type
     3916             and stk-line.fact-order < Temp-DayNal.f-o2
     3917             and stk-line.sum-type   = 'crsa':U
     3918             and stk-line.cat-id     = '##,##':U
     3919           no-error.
     3920         if available  stk-line then  do:
     3921           if stk-line.fact-qnty > 0 then assign Temp-DayNal.DayNal = yes .
     3922         end.
     3923       end.
     3924       if Temp-DayNal.DayNal = yes then assign p-day-nal = p-day-nal + 1 .
     3925     end.
     3926   END PROCEDURE.
     3927   define variable vss-include-info37 as character format "X(65)" no-undo
     3928   initial "@(#)$Workfile$".
     3929   procedure search-prov1 :
     3930     do
     3931     on error undo, return error return-value
     3932     :
     3933       for each temp-goods :
     3934         for each obj-list :
     3935           run partslib-init-temp-parts ( input obj-list.obj-type, input obj-list.obj-code, input temp-goods.artic, input temp-goods.prod-type, input temp-goods.prod-code) .
     3936           for each buf1_doc-line no-lock
     3937             where buf1_doc-line.obj-type     = obj-list.obj-type
     3938               and buf1_doc-line.obj-code     = obj-list.obj-code
     3939               and buf1_doc-line.prod-type    = temp-goods.prod-type
     3940               and buf1_doc-line.prod-code    = temp-goods.prod-code
     3941               and buf1_doc-line.artic        = temp-goods.artic
     3942               and buf1_doc-line.ext-doc-type = 'ie':U
     3943               and buf1_doc-line.status_      = 'факт':U
     3944             :
     3945             find first buf_trn-doc no-lock
     3946               where buf_trn-doc.doc-code = buf1_doc-line.doc-code
     3947               no-error .
     3948             find first temp-goods-cli
     3949               where temp-goods-cli.gds-code = temp-goods.gds-code
     3950                 and temp-goods-cli.cli-type = buf_trn-doc.cli-type
     3951                 and temp-goods-cli.cli-code = buf_trn-doc.cli-code
     3952               no-error .
     3953             if not available temp-goods-cli then do:
     3954               find first buf_clients no-lock
     3955                 where buf_clients.obj-type = buf_trn-doc.cli-type
     3956                   and buf_clients.obj-code = buf_trn-doc.cli-code
     3957               no-error .
     3958               if not available buf_clients then next .
     3959               create temp-goods-cli.
     3960               assign
     3961                 temp-goods-cli.gds-code  = temp-goods.gds-code
     3962                 temp-goods-cli.artic     = temp-goods.artic
     3963                 temp-goods-cli.prod-code = temp-goods.prod-code
     3964                 temp-goods-cli.prod-type = temp-goods.prod-type
     3965                 temp-goods-cli.gds-name  = temp-goods.gds-name
     3966                 temp-goods-cli.grp-name  = temp-goods.grp-name
     3967                 temp-goods-cli.cli-type  = buf_clients.obj-type
     3968                 temp-goods-cli.cli-code  = buf_clients.obj-code
     3969                 temp-goods-cli.cli       = buf_clients.obj-name
     3970               .
     3971               find first temp-parts
     3972                 where temp-parts.supp-type = buf_trn-doc.cli-type
     3973                   and temp-parts.supp-code = buf_trn-doc.cli-code
     3974                 no-error .
     3975               if available temp-parts then do:
     3976                 assign temp-goods-cli.sum-reserv = temp-parts.fact-qnty - temp-parts.free-qnty .
     3977                 find first Temp-obj1
     3978                   where Temp-obj1.gds-code = temp-goods-cli.gds-code
     3979                     and Temp-obj1.cli-type = temp-goods-cli.cli-type
     3980                     and Temp-obj1.cli-code = temp-goods-cli.cli-code
     3981                     and Temp-obj1.obj-type = Temp-date.obj-type
     3982                     and Temp-obj1.obj-code = Temp-date.obj-code
     3983                 no-error .
     3984                 if not available Temp-obj1 then do:
     3985                   create Temp-obj1 .
     3986                   assign
     3987                     Temp-obj1.gds-code = temp-goods.gds-code
     3988                     Temp-obj1.cli-type = temp-goods-cli.cli-type
     3989                     Temp-obj1.cli-code = temp-goods-cli.cli-code
     3990                     Temp-obj1.obj-code = obj-list.obj-code
     3991                     Temp-obj1.obj-type = obj-list.obj-type
     3992                   .
     3993                 end.
     3994                 assign Temp-obj1.reserv = Temp-obj1.reserv + buf_gds-obj.fact-qnty - buf_gds-obj.free-qnty .
     3995               end.
     3996             end.
     3997           end.
     3998         end.
     3999       end.
     4000       for each temp-goods : delete temp-goods . end.
     4001     end.
     4002   end procedure.
     4003   procedure Ostatok1 :
     4004     do
     4005     on error undo, return error return-value
     4006     :
     4007     for each Temp-date :
     4008       if Temp-date.obj-type = 'маг':U then
