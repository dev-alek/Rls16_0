     1530         "slt-pc        " p-slt-pc         skip
     1531         "sum-base      " p-sum-base       skip
     1532         "sum-rubl      " p-sum-rubl       skip
     1533         "vat-base      " p-vat-base       skip
     1534         "vat-rubl      " p-vat-rubl       skip
     1535         "slt-base      " p-slt-base       skip
     1536         "slt-rubl      " p-slt-rubl       skip
     1537         "road-tax-base " p-road-tax-base  skip
     1538         "road-tax-rubl " p-road-tax-rubl  skip
     1539         "transport-base" p-transport-base skip
     1540         "transport-rubl" p-transport-rubl skip
     1541         "other-base    " p-other-base     skip
     1542         "other-rubl    " p-other-rubl     skip
     1543         "excise-base   " p-excise-base    skip
     1544         "excise-rubl   " p-excise-rubl    skip
     1545         view-as alert-box error .
