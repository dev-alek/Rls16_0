     1233           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1234           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1235       on error undo, return error
     1236       :
     1237           if buf_trn-doc.doc-type <> 'инв':U
     1238           then do:
     1239               if buf_trn-doc.doc-type = 'при':U
     1240               or buf_trn-doc.doc-type = 'возврат':U
     1241               then do:
     1242                   assign
     1243                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1244                   .
     1245               end.
     1246               else do:
     1247                   assign
     1248                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1249                   .
     1250               end.
     1251           end.
     1252           else do:
     1253               assign
     1254                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1255               .
     1256           end.
     1257           if v-gds-dtl-fact-qnty <> 0
     1258           then do:
     1259   if buf_trn-doc.ext-doc-type = 'ot':U or
     1260      buf_trn-doc.ext-doc-type = ?                 then do:
     1261     assign
     1262      out-vatp-have-vat-slt = yes.
     1263   end.
     1264   else do:
     1265     find first out-vatp_doc-attr no-lock
     1266       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1267         and out-vatp_doc-attr.attr-code = 'envd':U
     1268         no-error .
     1269     if not available out-vatp_doc-attr then do:
