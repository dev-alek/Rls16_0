      610   procedure r-cost :
      611     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      612     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      613     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      614     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      615     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      616     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      617     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      618     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      619     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      620     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      621     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      622     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      623     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      624     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      625     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      626     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      627     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      628     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      629     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      630     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      631     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      632     do
      633     on error undo, return error
      634     :
      635       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      636       define buffer   in-vatp-parts    for ub.parts   .
      637       define buffer   in-vatp-doc      for ub.trn-doc .
      638       define buffer   in-vatp-goods    for ub.goods   .
      639       define buffer   in-vatp-sysconf  for ub.sysconf .
      640       define buffer   in-vatp_doc-attr for ub.doc-attr.
      641       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      642       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      643       define variable varinvprb                  as   character              no-undo.
      644       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      645       define variable cli-base-rate              as   decimal                no-undo.
      646       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      647       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      648       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      649       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      650       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      651       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      652       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      653       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      654       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      655       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      656       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      657       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      658       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      659       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      660       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      661       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      662       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      663       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      664       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      665       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      666       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      667       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      668       define variable varinvatp-envd             as   character              no-undo.
      669       define variable varinvatp-type             as   character              no-undo.
      670       def var v-parts-fact-qnty as decimal   no-undo .
      671       define buffer buf_parts    for ub.parts    .
      672       define buffer buf_goods    for ub.goods    .
      673       define buffer buf_trn-doc  for ub.trn-doc  .
      674       define buffer buf_doc-line for ub.doc-line .
      675       find first buf_doc-line no-lock
      676         where buf_doc-line.doc-code  = v-doc-code
      677           and buf_doc-line.artic     = v-artic
      678           and buf_doc-line.prod-type = v-prod-type
      679           and buf_doc-line.prod-code = v-prod-code
      680         no-error .
      681       if not available buf_doc-line then do:
      682         message
      683           vss-workfile vss-revision vss-description skip
      684           vss-include-info9 skip
      685           "Ошибка задания входных параметров" skip
      686           "Не найдена строка документа"  skip
      687           "Документ" v-doc-code skip
      688           "Артикул" v-artic v-prod-type v-prod-code skip
      689           view-as alert-box error .
      690         return error .
      691       end.
      692       find first buf_trn-doc no-lock
      693         where buf_trn-doc.doc-code = v-doc-code
      694         no-error .
      695       if not available buf_trn-doc then do:
      696         message
      697           vss-workfile vss-revision vss-description skip
      698           vss-include-info9 skip
      699           "Ошибка задания входных параметров" skip
      700           "Не найден документ" skip
      701           "Документ" v-doc-code skip
      702           "Артикул" v-artic v-prod-type v-prod-code skip
      703           view-as alert-box error .
      704         undo, return error .
      705       end.
      706       find first buf_goods no-lock
      707         where buf_goods.artic     = buf_doc-line.artic
      708           and buf_goods.prod-type = buf_doc-line.prod-type
      709           and buf_goods.prod-code = buf_doc-line.prod-code
      710         no-error .
      711       if not available buf_goods then do:
      712         message
      713           vss-workfile vss-revision vss-description skip
      714           vss-include-info9 skip
      715           "Ошибка задания входных параметров" skip
      716           "Не найден товар" skip
      717           "Документ" v-doc-code skip
      718           "Артикул" v-artic v-prod-type v-prod-code skip
      719           view-as alert-box error .
      720         undo, return error .
      721       end.
      722       if buf_goods.gds-type = 'т':U then do:
      723             for each buf_parts no-lock
      724               where buf_parts.out-code  = buf_trn-doc.doc-code
      725                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      726                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      727                 and buf_parts.artic     = buf_doc-line.artic
      728                 and buf_parts.prod-type = buf_doc-line.prod-type
      729                 and buf_parts.prod-code = buf_doc-line.prod-code
      730             on error undo, return error
      731             :
      732   assign
      733     price-rubl-with-tax-loc = buf_parts.price-rubl
      734     price-base-with-tax-loc = buf_parts.price-base
      735   .
      736   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      738     (output varinvprb
      739     )  .
      740     if buf_parts.out-code = 'free-zone':U     or
      741        buf_parts.out-code = 'out-zone':U   or
      742        buf_parts.doc-type = 'акт':U then do:
      743       assign
      744         in-vatp-have-vat-slt = yes.
      745     end.
      746     else do:
      747       find first in-vatp_doc-attr no-lock
      748         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      749           and in-vatp_doc-attr.attr-code = 'envd':U
      750         no-error .
      751       if not available in-vatp_doc-attr then do:
      752         assign
      753           in-vatp-have-vat-slt = yes.
      754       end.
      755       else do:
      756            in-vatp-have-vat-slt = no.
      757       end.
      758     end.
      759     assign
      760      price-cli-with-tax-loc = buf_parts.price-cli
      761      cli-base-rate          = buf_parts.cli-base-rate.
      762     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      763              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      764     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      765             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      766             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      767             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      768             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      769             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      770             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      771       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      772     assign
      773       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      774     assign
      775       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      776       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      777       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      778       transport-cli-loc  = 0
      779       other-cli-loc      = 0
      780     .
      781   ASSIGN
      782             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      783       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      784   .
      785               assign
      786                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
      787                                       or buf_trn-doc.doc-type = 'возврат':U
      788                                       or buf_trn-doc.doc-type = 'инв':U
      789                                       then buf_parts.fact-qnty
      790                                       else - buf_parts.fact-qnty
      791                                      )
      792               .
      793               assign
      794                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
      795                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
      796                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
      797                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
      798                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
      799                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
      800                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
      801                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
      802                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
      803                 v-excise-base         =   0
      804                 v-excise-rubl         =   0
      805                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
      806                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
      807                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
      808                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
      809               .
      810           end.
      811   assign
      812     price-rubl-with-tax-loc = buf_doc-line.price-rubl
      813     price-base-with-tax-loc = buf_doc-line.price-base
      814   .
      815   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      816   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      817     (output varinvprb
      818     )  .
      819      find first in-vatp_doc-attr no-lock
      820       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
