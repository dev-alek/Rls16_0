     4409         assign v-col = v-col + 1 .
     4410         find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4411         assign Temp-Sum.sum = Temp-Sum.sum + Temp-obj1.postup  .
     4412         run macr_excel_sum  ( Temp-obj1.postup , v-row, v-col,  3) .
     4413         assign v-col = v-col + 1 .
     4414         find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4415         assign Temp-Sum.sum = Temp-Sum.sum + Temp-obj1.reserv  .
     4416         run macr_excel_sum  ( Temp-obj1.reserv , v-row, v-col,  3) .
     4417         assign v-col = v-col + 1 .
     4418       end.
     4419       find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4420       assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-cli.sum-ostat .
     4421       run macr_excel_sum  ( temp-goods-cli.sum-ostat , v-row, v-col,  3) .
     4422       assign v-col = v-col + 1 .
     4423       find first Temp-Sum where Temp-Sum.type = 2 and Temp-Sum.ind  = v-col no-error .
     4424       assign Temp-Sum.sum = Temp-Sum.sum + temp-goods-cli.sum-speed * p-day / 30 - temp-goods-cli.sum-ostat - temp-goods-cli.sum-postup + temp-goods-cli.sum-reserv  .
     4425       run macr_excel_sum  ( temp-goods-cli.sum-speed * p-day / 30 - temp-goods-cli.sum-ostat - temp-goods-cli.sum-postup + temp-goods-cli.sum-reserv , v-row, v-col,  3) .
     4426       assign
     4427         v-col = v-col + 1
     4428         s-prov = ""
     4429       .
     4430       for each Temp-cli where Temp-cli.gds-code = temp-goods-cli.gds-code :
     4431          assign s-prov = s-prov + string(Temp-cli.cli-code) + ", " .
     4432       end.
