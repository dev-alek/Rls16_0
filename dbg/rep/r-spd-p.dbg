     4050             Temp-obj1.gds-code = temp-goods-cli.gds-code
     4051             Temp-obj1.cli-type = temp-goods-cli.cli-type
     4052             Temp-obj1.cli-code = temp-goods-cli.cli-code
     4053             Temp-obj1.obj-code = Temp-date.obj-code
     4054             Temp-obj1.obj-type = Temp-date.obj-type
     4055             Temp-obj1.rashod   = 0
     4056             Temp-obj1.speed    = 0
     4057             Temp-obj1.ostat    = 0
     4058           .
     4059         end.
     4060         find last buf_stk-supp-line no-lock
     4061           where buf_stk-supp-line.obj-type  = Temp-date.obj-type
     4062             and buf_stk-supp-line.obj-code  = Temp-date.obj-code
     4063             and buf_stk-supp-line.cli-type  = temp-goods-cli.cli-type
     4064             and buf_stk-supp-line.cli-code  = temp-goods-cli.cli-code
     4065             and buf_stk-supp-line.artic     = temp-goods-cli.artic
     4066             and buf_stk-supp-line.prod-type = temp-goods-cli.prod-type
     4067             and buf_stk-supp-line.prod-code = temp-goods-cli.prod-code
     4068             and buf_stk-supp-line.fact-order < Temp-date.cur-fact-order
     4069             and buf_stk-supp-line.sum-type  = 'cost':U
     4070           no-error .
     4071         if available buf_stk-supp-line then do:
     4072           assign
     4073             temp-goods-cli.sum-ostat = temp-goods-cli.sum-ostat + buf_stk-supp-line.fact-qnty
     4074             Temp-obj1.ostat = Temp-obj1.ostat + buf_stk-supp-line.fact-qnty
     4075           .
     4076         end.
     4077         find last buf_stk-supp-line no-lock
     4078           where buf_stk-supp-line.obj-type  = Temp-date.obj-type
     4079             and buf_stk-supp-line.obj-code  = Temp-date.obj-code
     4080             and buf_stk-supp-line.cli-type  = temp-goods-cli.cli-type
     4081             and buf_stk-supp-line.cli-code  = temp-goods-cli.cli-code
     4082             and buf_stk-supp-line.artic     = temp-goods-cli.artic
