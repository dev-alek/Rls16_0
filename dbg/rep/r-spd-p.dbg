     4040         find first Temp-obj1
     4041           where Temp-obj1.gds-code = temp-goods-cli.gds-code
     4042             and Temp-obj1.cli-type = temp-goods-cli.cli-type
     4043             and Temp-obj1.cli-code = temp-goods-cli.cli-code
     4044             and Temp-obj1.obj-type = Temp-date.obj-type
     4045             and Temp-obj1.obj-code = Temp-date.obj-code
     4046           no-error .
     4047         if not available Temp-obj1 then do:
