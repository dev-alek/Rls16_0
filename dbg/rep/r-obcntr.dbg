     2861     then DO:
     2862         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2863     end.
     2864     if not session:batch-mode then
     2865     do:
     2866       VIEW FRAME InfoFrame.
     2867       mFrameView = true.
     2868     end.
     2869      v-button-stop = false .
     2870         if mFrameView
     2871         then do:
     2872         if v-button-stop then view STOPBTN in frame InfoFrame.
     2873                          else Hide STOPBTN in frame InfoFrame.
     2874         end.
     2875     case x-SET_val_TYPE :
