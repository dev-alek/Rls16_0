     3216           and buf_ot-line.prod-code    = buf_doc-line.prod-code
     3217           and buf_trn-doc.ext-doc-type = 're':U
     3218       :
     3219         if buf_ot-line.sum-type = 'cost':U
     3220           or buf_ot-line.sum-type = 'cssr':U
     3221         then do:
     3222           assign
     3223             buy-data.cost-sum-rubl-ret  =  buy-data.cost-sum-rubl-ret + abs(buf_ot-line.sum-rubl)
     3224             buy-data.cost-sum-base-ret  =  buy-data.cost-sum-base-ret + abs(buf_ot-line.sum-base)
     3225           .
