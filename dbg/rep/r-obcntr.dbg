     3753             itog-all-qnty                                                               @ F-qnty-all
     3754             itog-cost-sum-rubl-all   when ( v-print-rubl = true  and show-cost = true)  @ F-all
     3755             itog-sale-sum-rubl-all   when ( v-print-rubl = true  and show-sale = true)  @ F-all
     3756             itog-cost-sum-base-all   when ( v-print-rubl = false and show-cost = true)  @ F-all
     3757             itog-sale-sum-base-all   when ( v-print-rubl = false and show-sale = true)  @ F-all
     3758             with frame obcntr .
     3759             down stream Outstream 1 with frame obcntr .
     3760             underline stream outstream F-pos-cli-code F-Artic F-Fullname F-qnty-all F-all  with frame obcntr .
     3761     end.
     3762   end procedure .
     3763   procedure print-excel .
     3764   run proc-print-header in this-procedure .
     3765   if p-detdoctip = true then do :
     3766   put  stream macr_excel unformatted
     3767          substitute('select("r&1c&2:r&3c&4 ")' , 7 , 1 , num#str# ,  9 ) + chr(10)  +
     3768          'BORDER( 2, 2, 2, 2, , , , , , , ) '  + chr(10) .
     3769   end.
     3770   else do :
     3771   put  stream macr_excel unformatted
     3772          substitute('select("r&1c&2:r&3c&4 ")' , 7 , 1 , num#str# ,  5 ) + chr(10)  +
     3773          'BORDER( 2, 2, 2, 2, , , , , , , ) '  + chr(10) .
     3774   end.
     3775   num#str# = num#str# + 1 .
     3776   for each itog by itog.obj-name :
     3777           Counter1 = Counter1 + 1.
     3778   IF ( Counter1 modulo v-account = 0 )  then DO:
     3779             if  log-manager:logfile-name ne ?
     3780             then DO:
     3781                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3782             end.
     3783              if mFrameView
     3784              then do:
     3785               DISPLAY
     3786                 Counter1 @ RecordsDone
     3787                 WITH FRAME InfoFrame.
     3788              end.
     3789   End.
     3790      if v-button-stop then  DO:
     3791            if mFrameView
     3792            then
     3793               PROCESS EVENTS.
     3794            IF StopProcessing THEN DO:
     3795            RETURN error.
     3796            End.
     3797      end.
     3798           if p-detgoods = true then do :
     3799                 assign num#col# = 3.
     3800                 run macr_excel_char_with_format in this-procedure
     3801                   (input  itog.obj-name
     3802                   ,input  num#str#
     3803                   ,input  num#col#
     3804                   ) .
     3805                   run macr_cell_format in this-procedure
     3806                     (input 10
     3807                     ,input true
     3808                     ,input false
     3809                     ,input ?
     3810                     ,input num#str#
     3811                     ,input num#col#
     3812                     ,input ?
     3813                     ,input ?
     3814                     ) .
     3815                 assign num#str# = num#str# + 1 .
     3816                 for each buy-data
     3817                 where buy-data.obj-type = itog.obj-type
     3818                 and   buy-data.obj-code = itog.obj-code
     3819                 :
     3820                       assign num#col# = 1 .
     3821                       run macr_excel_char_with_format in this-procedure
     3822                         (input  buy-data.gds-code
     3823                         ,input  num#str#
     3824                         ,input  num#col#
     3825                         ) .
     3826                       assign num#col# = num#col# + 1 .
     3827                       run macr_excel_char_with_format in this-procedure
     3828                         (input  buy-data.artic
     3829                         ,input  num#str#
     3830                         ,input  num#col#
     3831                         ) .
     3832                       assign num#col# = num#col# + 1 .
     3833                       run macr_excel_char_with_format in this-procedure
     3834                         (input  buy-data.name
     3835                         ,input  num#str#
     3836                         ,input  num#col#
     3837                         ) .
     3838                       assign num#col# = num#col# + 1 .
     3839   if p-detdoctip = true then do:
     3840   if v-print-rubl = true then do:
     3841       if show-cost = true then do:
     3842                   run macr_excel_dec in this-procedure (input buy-data.ras-qnty, input num#str#, input num#col# ) .
     3843                   run macr_cell_format in this-procedure
     3844                     (input 10
     3845                     ,input false
     3846                     ,input false
     3847                     ,input ?
     3848                     ,input num#str#
     3849                     ,input num#col#
     3850                     ,input ?
     3851                     ,input ?
     3852                     ) .
     3853                   num#col# = num#col# + 1.
     3854                   run macr_excel_dec in this-procedure (input string(buy-data.cost-sum-rubl-ras, "->>>>>>>>9.99"), input num#str#, input num#col# ) .
     3855                   run macr_cell_format in this-procedure
     3856                     (input 10
     3857                     ,input false
     3858                     ,input false
     3859                     ,input ?
     3860                     ,input num#str#
     3861                     ,input num#col#
     3862                     ,input ?
     3863                     ,input ?
     3864                     ) .
     3865                   num#col# = num#col# + 1.
     3866                   run macr_excel_dec in this-procedure (input buy-data.ret-qnty, input num#str#, input num#col# ) .
     3867                   run macr_cell_format in this-procedure
     3868                     (input 10
     3869                     ,input false
     3870                     ,input false
     3871                     ,input ?
     3872                     ,input num#str#
     3873                     ,input num#col#
     3874                     ,input ?
     3875                     ,input ?
     3876                     ) .
     3877                   num#col# = num#col# + 1.
     3878                   run macr_excel_dec in this-procedure (input string(buy-data.cost-sum-rubl-ret, "->>>>>>>>9.99"), input num#str#, input num#col# ) .
     3879                   run macr_cell_format in this-procedure
     3880                     (input 10
     3881                     ,input false
     3882                     ,input false
     3883                     ,input ?
     3884                     ,input num#str#
     3885                     ,input num#col#
     3886                     ,input ?
     3887                     ,input ?
     3888                     ) .
     3889                   num#col# = num#col# + 1.
     3890       end.
     3891       else do:
     3892                   run macr_excel_dec in this-procedure (input buy-data.ras-qnty, input num#str#, input num#col# ) .
     3893                   run macr_cell_format in this-procedure
     3894                     (input 10
     3895                     ,input false
     3896                     ,input false
