     3293         where buy-data.obj-type  = G#CUSTOMER.obj-type
     3294           and buy-data.obj-code  = G#CUSTOMER.obj-code
     3295           and buy-data.gds-code  = tt-goods.gds-code
     3296         no-error .
     3297       if NOT available buy-data then do:
     3298         create buy-data .
     3299         assign
     3300           buy-data.obj-type    =  G#CUSTOMER.obj-type
     3301           buy-data.obj-code    =  G#CUSTOMER.obj-code
     3302           buy-data.obj-name    =  G#CUSTOMER.obj-name
     3303           buy-data.gds-code    =  tt-goods.gds-code
     3304           buy-data.artic       =  tt-goods.artic
     3305         .
     3306         find first buf_goods no-lock
     3307           where buf_goods.artic     = buf_doc-line.artic
     3308             and buf_goods.prod-type = buf_doc-line.prod-type
     3309             and buf_goods.prod-code = buf_doc-line.prod-code
     3310           no-error  .
     3311         if available buf_goods then do:
     3312           assign
     3313             buy-data.name  =  buf_goods.gds-name
     3314           .
     3315         end.
     3316       end.
     3317       find first buf_ot-line
     3318         where buf_ot-line.doc-code     = buf_trn-doc.doc-code
     3319           and buf_ot-line.artic        = buf_doc-line.artic
     3320           and buf_ot-line.prod-type    = buf_doc-line.prod-type
     3321           and buf_ot-line.prod-code    = buf_doc-line.prod-code
     3322           and buf_trn-doc.ext-doc-type = 'ee':U
     3323         no-error .
     3324       if available buf_ot-line then do:
     3325         assign
     3326           buy-data.ras-qnty = buy-data.ras-qnty + abs(buf_ot-line.fact-qnty)
     3327         .
     3328       end.
     3329       for each buf_ot-line no-lock
     3330         where buf_ot-line.doc-code     = buf_trn-doc.doc-code
     3331           and buf_ot-line.artic        = buf_doc-line.artic
     3332           and buf_ot-line.prod-type    = buf_doc-line.prod-type
     3333           and buf_ot-line.prod-code    = buf_doc-line.prod-code
     3334           and buf_trn-doc.ext-doc-type = 'ee':U
     3335       :
     3336         if buf_ot-line.sum-type = 'cost':U
     3337           or buf_ot-line.sum-type = 'cssr':U
     3338         then do:
     3339           assign
     3340             buy-data.cost-sum-rubl-ras  =  buy-data.cost-sum-rubl-ras + ABS(buf_ot-line.sum-rubl)
     3341             buy-data.cost-sum-base-ras  =  buy-data.cost-sum-base-ras + abs(buf_ot-line.sum-base)
     3342           .
     3343         end.
     3344         if buf_ot-line.sum-type = 'sale':U
     3345           or buf_ot-line.sum-type = 'sasr':U
     3346         then do:
     3347           assign
     3348             buy-data.sale-sum-rubl-ras  =  buy-data.sale-sum-rubl-ras + abs(buf_ot-line.sum-rubl)
     3349             buy-data.sale-sum-base-ras  =  buy-data.sale-sum-base-ras + abs(buf_ot-line.sum-base)
     3350           .
     3351         end.
     3352       end.
     3353       find first buf_ot-line
     3354         where buf_ot-line.doc-code     = buf_trn-doc.doc-code
     3355           and buf_ot-line.artic        = buf_doc-line.artic
