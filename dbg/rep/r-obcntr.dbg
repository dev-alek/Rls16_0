      799   function diff-list returns character (
      800     input parfirst-list  as character,
      801     input parsecond-list as character,
      802     input pardelim       as character).
      803     if pardelim = ""
      804     or pardelim = ?
      805     then do:
      806       assign
      807         pardelim = ","
      808       .
      809     end.
      810     def var ind as integer no-undo .
      811     def var v-elem as character no-undo .
      812     def var v-result-list as character no-undo init "".
      813     def var v-num-parfirst-list as integer no-undo .
      814     assign
      815       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      816     .
      817     do ind = 1 to v-num-parfirst-list
      818     :
      819       assign
      820         v-elem = entry(ind, parfirst-list, pardelim)
      821       .
      822       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      823         assign
      824           v-result-list = v-result-list
      825                         + (if v-result-list > "" then pardelim else "")
      826                         + v-elem
      827         .
      828       end.
      829     end.
      830     return v-result-list .
      831   end function.
      832   function add-list returns character (
      833    input parfirst-list  as character,
      834    input parsecond-list as character,
      835    input pardelim       as character).
      836     if pardelim = ""
      837     or pardelim = ?
      838     then do:
      839       assign
      840         pardelim = ","
      841       .
      842     end.
      843     def var ind as integer no-undo .
      844     def var v-elem as character no-undo .
      845     def var v-result-list as character no-undo init "".
      846     def var v-num-parfirst-list as integer no-undo .
      847     assign
      848       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      849     .
      850     do ind = 1 to v-num-parfirst-list
      851     :
      852       assign
      853         v-elem = entry(ind, parfirst-list, pardelim)
      854       .
      855       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      856         assign
      857           v-result-list = v-result-list
      858                         + (if v-result-list > "" then pardelim else "")
      859                         + v-elem
      860         .
      861       end.
      862     end.
      863     def var v-num-parsecond-list as integer no-undo .
      864     assign
      865       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      866     .
      867     do ind = 1 to v-num-parsecond-list
      868     :
      869       assign
      870         v-elem = entry(ind, parsecond-list, pardelim)
      871       .
      872       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      873         assign
      874           v-result-list = v-result-list
      875                         + (if v-result-list > "" then pardelim else "")
      876                         + v-elem
      877         .
      878       end.
      879     end.
      880     return v-result-list .
      881   end function.
      882   function cross-list returns character (
      883    input parfirst-list  as character,
      884    input parsecond-list as character,
      885    input pardelim       as character).
      886     if pardelim = ""
      887     or pardelim = ?
      888     then do:
      889       assign
      890         pardelim = ","
      891       .
      892     end.
      893     def var ind as integer no-undo .
      894     def var v-elem as character no-undo .
      895     def var v-result-list as character no-undo init "".
      896     def var v-num-parfirst-list as integer no-undo .
      897     assign
      898       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      899     .
      900     do ind = 1 to v-num-parfirst-list
      901     :
      902       assign
      903         v-elem = entry(ind, parfirst-list, pardelim)
      904       .
      905       if lookup(v-elem, v-result-list, pardelim) = 0
      906       and lookup(v-elem, parsecond-list, pardelim) > 0
      907       then do:
      908         assign
      909           v-result-list = v-result-list
      910                         + (if v-result-list > "" then pardelim else "")
      911                         + v-elem
      912         .
      913       end.
      914     end.
      915     return v-result-list .
      916   end function.
      917   function radio-label returns character (
      918    input par-rs-value  as character,
      919    input par-rs-radio-buttons as character)
      920    .
      921    DEFINE variable v-result-label as character no-undo.
      922    assign
      923    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      924                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      925                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      926                             ), par-rs-radio-buttons
      927                           )
      928    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      929    .
      930   return v-result-label.
      931   end function.
      932   function m-radio-label returns character (
      933    input par-rs-value  as character,
      934    input par-rs-radio-buttons as character,
      935    input par-delim as character
      936    )
      937    .
      938    DEFINE variable v-result-label as character no-undo.
      939    assign
      940    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      941                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      942                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      943                             ), par-rs-radio-buttons, par-delim
      944                           )
      945    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      946    .
      947   return v-result-label.
      948   end function.
      949   FUNCTION mixlist returns character
      950   (
      951    input parfirst-list  as character
      952    ,input parsecond-list as character
      953    ,input pardelim       as character
      954    ,input pardelim-result as character ) :
      955     if pardelim = ""
      956     or pardelim = ?
      957     then do:
      958       assign
      959         pardelim = ","
      960       .
      961     end.
      962     def var ind as integer no-undo .
      963     def var v-elem1 as character no-undo .
      964     def var v-elem2 as character no-undo .
      965     def var v-result-list as character no-undo init "".
      966     do ind = 1 to num-entries(parfirst-list, pardelim)
      967     :
      968       assign
      969         v-elem1 = entry(ind, parfirst-list, pardelim)
      970         v-elem2 = entry(ind, parsecond-list, pardelim)
      971       .
      972         assign
      973           v-result-list = v-result-list
      974                         + (if v-result-list > "" then pardelim-result else "")
      975                         + v-elem1 + pardelim-result + v-elem2
      976         .
      977     end.
      978     return v-result-list .
      979   END FUNCTION.
