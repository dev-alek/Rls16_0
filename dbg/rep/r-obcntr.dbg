     2834     then DO:
     2835         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2836         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2837         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2838     end.
     2839     mFrameView = not session:batch-mode and mFramHandle:visible.
     2840     if mFrameView
     2841     then do:
     2842       ASSIGN
     2843          FRAME InfoFrame:HIDDEN                           = TRUE
     2844          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2845     end.
     2846   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2847   DO:
     2848     IF not StopProcessing THEN
     2849       Message "Вы действительно хотите прервать" SKIP
     2850               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2851                 UPDATE StopProcessing.
