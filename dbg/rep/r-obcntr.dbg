     3187             buy-data.cost-sum-rubl-ras  =  buy-data.cost-sum-rubl-ras + ABS(buf_ot-line.sum-rubl)
     3188             buy-data.cost-sum-base-ras  =  buy-data.cost-sum-base-ras + abs(buf_ot-line.sum-base)
     3189           .
