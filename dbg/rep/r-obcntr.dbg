      364   procedure create_obj-list :
      365      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      366      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      367      do
      368      on error undo, return error return-value
      369      :
      370         define buffer cli-obj for ub.clients .
      371         define variable p-var as integer no-undo .
      372         define buffer buf_obj-list for obj-list .
      373         find last buf_obj-list  use-index pi no-error .
      374         if available buf_obj-list
      375         then
      376            p-var = buf_obj-list.obj-id + 1.
      377         else
      378            p-var = 1.
      379         find first cli-obj where
      380                   cli-obj.obj-type = p-obj-type
      381               and cli-obj.obj-code = p-obj-code
      382         no-lock no-error.
      383         if available cli-obj
      384         then do:
      385            create buf_obj-list.
      386            assign
      387               buf_obj-list.obj-id   = p-var
      388               buf_obj-list.obj-code = cli-obj.obj-code
      389               buf_obj-list.obj-type = cli-obj.obj-type
      390               buf_obj-list.obj-name = cli-obj.obj-name
      391               buf_obj-list.db-num   = cli-obj.db-num
      392            .
      393         end.
      394      end.
      395   end.
