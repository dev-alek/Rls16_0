     2902   run report-execute.
     2903   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     2904     if num-entries(string(p-dec), '.') = 2
     2905       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     2906       else return( string(p-dec)) .
     2907   end function.
     2908   function format-point-to-comma returns char (input orig as char ) .
     2909   define variable rtext as character no-undo .
     2910   define variable strt as integer no-undo .
     2911   define variable leng as integer no-undo .
     2912   assign rtext = orig .
     2913   repeat:
     2914     strt =  index(rtext,'.').
     2915     if strt = 0 then leave.
     2916     leng = 1.
     2917     substring(rtext,strt,leng,"character") = v-delim .
     2918   end.
     2919   return rtext.
     2920   end function.
     2921   function format-excel-text returns char ( input start-text as char ) :
     2922   def var  i    as int no-undo.
     2923   def var  ch   as char no-undo.
     2924   def var  n    as int no-undo.
     2925   def var  ipos as int no-undo.
     2926     n = num-entries(trim(start-text), chr(10)) - 1 .
     2927     do i = 1 to n :
     2928       ipos = index( start-text, chr(10)).
     2929       if ipos > 0 then
     2930         substr( start-text, ipos, 1 ) = ' '.
     2931     end.
     2932     n = num-entries(trim(start-text), chr(13)) - 1 .
     2933     do i = 1 to n :
     2934       ipos = index( start-text, chr(13)).
     2935       if ipos > 0 then
     2936         substr( start-text, ipos, 1 ) = ' '.
     2937     end.
     2938     if index( start-text, '"' ) = 0 then
     2939       start-text =  '="'   + trim( start-text) + '"'   .
     2940       else do:
     2941         n = num-entries(trim(start-text), '"') - 1.
     2942         do i = 1 to n :
     2943           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2944         end.
     2945         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2946         start-text = '="'  + ch  + '"' .
     2947       end.
     2948     return start-text.
     2949   end.
     2950   function excel-sum returns char (input p-dec as decimal ).
     2951     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     2952   end function.
     2953   function excel-qnty returns char (input p-dec as decimal ).
     2954     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     2955   end function.
     2956   function format-excel-text-macr returns char ( input start-text as char ) :
     2957   def var  i    as int no-undo.
     2958   def var  ch   as char no-undo.
     2959   def var  n    as int no-undo.
     2960   def var  ipos as int no-undo.
     2961     n = num-entries(trim(start-text), chr(10)) - 1 .
     2962     do i = 1 to n :
     2963       ipos = index( start-text, chr(10)).
     2964       if ipos > 0 then
     2965         substring( start-text, ipos , 1 ) = ' '.
     2966     end.
     2967     n = num-entries(trim(start-text), chr(13)) - 1 .
     2968     do i = 1 to n :
     2969       ipos = index( start-text, chr(13)).
     2970       if ipos > 0 then
     2971         substring( start-text, ipos, 1 ) = ' '.
     2972     end.
     2973     if index( start-text, '"' ) = 0 then
     2974       start-text =  '"'   + trim( start-text) + '"'   .
     2975       else do:
     2976         n = num-entries(trim(start-text), '"') - 1.
     2977         do i = 1 to n :
     2978           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2979         end.
     2980         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2981         start-text = '"'  + ch  + '"' .
     2982       end.
     2983     n = num-entries(trim(start-text), chr(10)) - 1 .
     2984     do i = 1 to n :
     2985       ipos = index( start-text, chr(10)).
     2986       if ipos > 0 then
     2987         substring( start-text, ipos , 1 ) = ' '.
     2988     end.
     2989       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     2990     return start-text.
     2991   end.
     2992   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     2993   define variable  str  as char format "X(60)"  no-undo.
     2994   define variable  str2 as char no-undo.
     2995   define variable v-r as character no-undo init "" .
     2996   define variable  i#i as int no-undo.
     2997   STR = "".
     2998   repeat i#i =1 to lavel#:
     2999       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     3000       else do:
     3001           str2 = entry(i#i,grp-name, chr(47)) no-error.
     3002           if not error-status:error  and str2 <> "":u then
     3003                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     3004           end.
     3005   end.
     3006   if str <> ? then do:
     3007   v-r = str + chr(47) .
     3008   end.
     3009   RETURN v-r .
     3010   END FUNCTION.
     3011   procedure report-execute :
     3012     if (valtype=0 and x-base-code=0)  or valtype=1
     3013       then   assign tprintrubl = yes .
     3014       else   assign tprintrubl = no .
     3015     run waitfram-show ( 'Подождите ...' ) .
     3016   output stream outstream to value( string( session:temp-directory +
     3017                                        "rpt" + string( g#report-num ) ) )
     3018                                        page-size  value(reportpageheight) .
     3019     assign
     3020     make-excel      = yes
     3021     v-file-name     = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     3022     v-file-name-ind = 1
     3023   .
     3024   output stream macr_excel to value(v-file-name) .
     3025     run display-title .
     3026   run report-exec1.
     3027   run calc-itog .
     3028   run print-text .
     3029   run print-excel .
     3030   end procedure.
     3031   procedure display-title :
     3032   num#str# = 1.
     3033   num#col# = 1.
     3034   put stream outstream  reportname  at 20 format "x(170)" skip
     3035                         trim(str1)  at 20 format "x(75)" .
     3036   run macr_excel_char_with_format in this-procedure
     3037                   (input  reportname
     3038                   ,input  num#str#
     3039                   ,input  num#col#
     3040                   ) .
     3041   run macr_cell_format in this-procedure
     3042     (input 18
     3043     ,input true
     3044     ,input false
     3045     ,input ?
     3046     ,input num#str#
     3047     ,input num#col#
     3048     ,input ?
     3049     ,input ?
     3050     ) .
     3051   num#str# = num#str# + 1.
     3052   run macr_excel_char_with_format in this-procedure
     3053                   (input  str1
     3054                   ,input  num#str#
     3055                   ,input  num#col#
     3056                   ) .
     3057   num#str# = num#str# + 1.
     3058   repeat i = 1 to num-entries(str2,chr(10)) :
     3059     put stream outstream entry(i,str2,chr(10))  at 1 format "x(170)" skip .
     3060   end.
     3061   run macr_excel_char_with_format in this-procedure
     3062                   (input  str2
     3063                   ,input  num#str#
     3064                   ,input  num#col#
     3065                   ) .
     3066   num#str# = num#str# + 1.
     3067   put stream outstream trim(str3)  at 1 format "x(75)" skip.
     3068   run macr_excel_char_with_format in this-procedure
     3069                   (input  str3
     3070                   ,input  num#str#
     3071                   ,input  num#col#
     3072                   ) .
     3073   num#str# = num#str# + 1.
     3074   repeat i = 1 to num-entries(str4,chr(10)) :
     3075     put stream outstream entry(i,str4,chr(10))  at 1 format "x(170)" skip .
     3076   end.
     3077   run macr_excel_char_with_format in this-procedure
     3078                   (input  str4
     3079                   ,input  num#str#
     3080                   ,input  num#col#
     3081                   ) .
     3082   num#str# = num#str# + 1.
     3083   repeat i = 1 to num-entries(reportheader,chr(10)) :
     3084     put stream outstream entry(i,reportheader,chr(10))  at 1 format "x(170)" skip .
     3085   end.
     3086   end procedure.
     3087   procedure report-exec1  :
     3088      find first a-clients where p-curr-host-type = a-clients.obj-type and
     3089                                 p-curr-host-code = a-clients.obj-code no-lock no-error.
     3090     if available a-clients then  objname = a-clients.obj-name. else  objname = "объект не определен".
     3091     run waitfram-show (objname) .
     3092     run create-tt-goods.
     3093   find first G#CUSTOMER no-error .
