      981   define new global shared variable g#trdcalib as handle no-undo.
      982   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      983   define  stream PrnLibStream.
      984   procedure prn-lib-prn-file :
      985     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      986     define input parameter p-DIsabledoptions as integer no-undo .
      987     define variable v-report-name as character no-undo .
      988     define variable v-user-action as character no-undo .
      989     define variable v-printed     as logical   no-undo .
      990     define variable v-exist       as logical   no-undo .
      991     do
      992       on error undo, return error
      993       :
      994       run prn-lib-get-report-name  in this-procedure (
      995         input parParentProc
      996         ,output v-report-name
      997         ).
      998   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      999   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1000     (input  v-report-name
     1001     ,input  2
     1002     ,output v-exist
     1003     )  .
     1004       if NOT v-exist then
     1005       DO:
     1006         Message
     1007           "Нет заданий на печать ! "
     1008           view-as alert-box .
     1009         Return  .
     1010       End.
     1011       run gbl/prnfilen.w
     1012         (input  ""
     1013         ,input  p-DisabledOptions
     1014         ,input  string(v-report-name )
     1015         ,input  7
     1016         ,output v-user-action
     1017         ,output v-printed
     1018         ) .
     1019       if v-printed then
     1020       do:
     1021         return "YES" .
     1022       end.
     1023       else
     1024       do:
     1025         return "NO" .
     1026       end.
     1027     end.
     1028   end procedure.
     1029   procedure prn-lib-open-stream :
     1030     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1031     define input parameter p-page-size    as integer no-undo .
     1032     define input parameter p-is-stream    as logical no-undo .
     1033     define input parameter p-append       as logical no-undo .
     1034     define variable v-report-name as character no-undo .
     1035     do
     1036       on error undo, return error
     1037       :
     1038       run prn-lib-get-report-name  in this-procedure (
     1039         input parParentProc
     1040         ,output v-report-name
     1041         ).
     1042       if p-is-stream then
     1043       do:
     1044         if p-append then
     1045         do:
     1046           output stream PrnLibStream to value( v-report-name )
     1047             page-size value(p-page-size) append .
     1048         end.
     1049         if not p-append then
     1050         do:
     1051           output stream PrnLibStream to value( v-report-name )
     1052             page-size value(p-page-size) .
     1053         end.
     1054       end.
     1055       if not p-is-stream then
     1056       do:
     1057         if p-append then
     1058         do:
     1059           output to value( v-report-name )
     1060             page-size value(p-page-size) append .
     1061         end.
     1062         if not p-append then
     1063         do:
     1064           output to value( v-report-name )
     1065             page-size value(p-page-size) .
     1066         end.
     1067       end.
     1068     end.
     1069   end procedure.
     1070   procedure prn-lib-open-exp :
     1071     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1072     define input parameter p-is-stream    as logical no-undo .
     1073     define input parameter p-is-append    as logical no-undo .
     1074     define output parameter p-ReportFileName as char init "report" no-undo.
     1075     define output parameter p-process as logical no-undo .
     1076     define variable glog as logical no-undo .
     1077     do
     1078       on error undo, return error
     1079       :
     1080       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1081         TITLE      "Укажите путь"
     1082         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1083         ASK-OVERWRITE
     1084         CREATE-TEST-FILE
     1085         SAVE-AS
     1086         USE-FILENAME
     1087         DEFAULT-EXTENSION "txt"
     1088         UPDATE glog
     1089         .
     1090       if not glog then  return.
     1091       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1092       if p-is-stream then
     1093       do:
     1094         if p-is-append then
     1095         do:
     1096           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1097         end.
     1098         else
     1099         do:
     1100           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1101         end.
     1102       end.
     1103       else
     1104       do:
     1105         if p-is-append then
     1106         do:
     1107           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1108         end.
     1109         else
     1110         do:
     1111           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1112         end.
     1113       end.
     1114       p-process = yes.
     1115     end.
     1116   end procedure.
     1117   procedure prn-lib-get-report-name :
     1118     define input parameter parParentProc  as widget-handle no-undo.
     1119     define output parameter p-report-name as character no-undo .
     1120     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1121   end procedure.
     1122   procedure prn-lib-reportviewer-report-name :
     1123     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1124     define input parameter p-report-name-html as character no-undo .
     1125     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1126   end procedure.
     1127   procedure prn-lib-reportviewer :
     1128     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1129     define input parameter p-report-name-html as character no-undo .
     1130     define input parameter p-param        as character no-undo .
     1131     define variable v-excel           as character no-undo init 'TRUE' .
     1132     define variable v-value-character as character no-undo .
     1133     define variable v-value-integer   as character no-undo .
     1134     define variable v-value-date      as date      no-undo .
     1135     define variable v-value-decimal   as decimal   no-undo .
     1136     define variable rep-excel         as logical   no-undo .
     1137     define variable excel-string      as character no-undo .
     1138     define variable v-param-type      as character no-undo .
     1139     define variable v-tth             as handle    no-undo .
     1140     run adm/shattri.p (
     1141       input "get":U
     1142       ,input  ""
     1143       ,input  0
     1144       ,input  'report-glob':U
     1145       ,input  'rep-excel':U
     1146       ,output v-value-character
     1147       ,output v-value-date
     1148       ,output v-value-decimal
     1149       ,output v-value-integer
     1150       ,output rep-excel
     1151       ,output v-param-type
     1152       ,INPUT-OUTPUT table-handle v-tth
     1153       )  .
     1154     if rep-excel then v-excel = "TRUE" .
     1155     else v-excel = "FALSE" .
     1156     if p-param eq ""
     1157     then
     1158        p-param = "EXCEL:" + v-excel.
     1159     else
     1160        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1161     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1162   end procedure.
     1163   define variable vss-include-info12 as character format "X(65)" no-undo
     1164   initial "@(#)$Workfile$ $Revision$".
     1165   define variable v-fmtcli-name          as character    no-undo.
     1166   define variable v-fmtcli-engl-name     as character    no-undo.
     1167   define variable v-fmtcli-addres        as character    no-undo.
     1168   define variable v-fmtcli-post-addres   as character    no-undo.
     1169   define variable v-fmtcli-full-addres   as character    no-undo.
     1170   define variable v-fmtcli-phone         as character    no-undo.
     1171   define variable v-fmtcli-inn           as character    no-undo.
     1172   define variable v-fmtcli-kpp           as character    no-undo.
     1173   define variable v-fmtcli-okpo          as character    no-undo.
     1174   define variable v-fmtcli-country       as character    no-undo.
     1175   define variable v-fmtcli-city          as character    no-undo.
     1176   define variable v-fmtcli-index         as character    no-undo.
     1177   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1178   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1179   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1180   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1181   define variable v-fmtcli-bank-bik      as character    no-undo.
     1182   define variable v-fmtcli-bank-name     as character    no-undo.
     1183   define variable v-fmtcli-bank-addres   as character    no-undo.
     1184   define variable v-fmtcli-bank-city     as character    no-undo.
     1185   procedure fmtcli-get-bank :
     1186   define input parameter p-host-code      as integer          no-undo.
     1187   define input parameter p-obj-type       as character        no-undo.
     1188   define input parameter p-obj-code       as integer          no-undo.
     1189   define input parameter p-curr-code      as integer          no-undo.
     1190       define buffer buf_fin-schet     for ub.fin-schet.
     1191       define buffer buf_fin-bank      for ub.fin-bank.
     1192   do
     1193   for buf_fin-schet
     1194     , buf_fin-bank
     1195   on error undo, return error
     1196   :
     1197       assign
     1198           v-fmtcli-schet-exists       = no
     1199           v-fmtcli-bank-exists        = no
     1200           v-fmtcli-bank-r-schet       = "":U
     1201           v-fmtcli-bank-c-schet       = "":U
     1202           v-fmtcli-bank-bik           = "":U
     1203           v-fmtcli-bank-name          = "":U
     1204           v-fmtcli-bank-addres        = "":U
     1205           v-fmtcli-bank-city          = "":U
     1206       .
     1207       search-for-schet:
     1208       for each buf_fin-schet no-lock
     1209          where buf_fin-schet.host-code = p-host-code
     1210            and buf_fin-schet.cli-type  = p-obj-type
     1211            and buf_fin-schet.cli-code  = p-obj-code
     1212            and buf_fin-schet.curr-code = p-curr-code
     1213       on error undo, return error
     1214       :
     1215           if buf_fin-schet.status_   = 'удал':U
     1216           then do:
     1217           end.
     1218           else do:
     1219               assign
     1220                   v-fmtcli-schet-exists   = yes
     1221                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1222                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1223               .
     1224               find first buf_fin-bank no-lock
     1225                    where buf_fin-bank.host-code = p-host-code
     1226                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1227               no-error.
     1228               if available buf_fin-bank
     1229               then do:
     1230                   assign
     1231                       v-fmtcli-bank-exists      = yes
     1232                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1233                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1234                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1235                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1236                   .
     1237               end.
     1238               else do:
     1239                   assign
     1240                       v-fmtcli-bank-exists    = no
     1241                       v-fmtcli-bank-bik       = "":U
     1242                       v-fmtcli-bank-name      = "":U
     1243                       v-fmtcli-bank-addres    = "":U
     1244                       v-fmtcli-bank-city      = "":U
     1245                   .
     1246               end.
     1247               leave search-for-schet.
     1248           end.
     1249       end.
     1250   end.
     1251   end procedure.
     1252   procedure fmtcli-get-client :
     1253   define input parameter p-obj-type       as character    no-undo.
     1254   define input parameter p-obj-code       as integer      no-undo.
     1255       define variable v-temp-fmtcli-address      as character     no-undo.
     1256       define variable v-num-country-city    as integer      no-undo.
     1257       define buffer buf_clients   for ub.clients.
     1258       define buffer buf_firm      for ub.firm.
     1259       define buffer buf_store     for ub.store.
     1260       define buffer buf_shop      for ub.shop.
     1261       define buffer buf_person    for ub.person.
     1262   do
     1263   for buf_clients
     1264     , buf_firm
     1265     , buf_store
     1266     , buf_shop
     1267     , buf_person
     1268   on error undo, return error
     1269   :
     1270       assign
     1271           v-fmtcli-name           = "":U
     1272           v-fmtcli-addres         = "":U
     1273           v-fmtcli-post-addres    = "":U
     1274           v-fmtcli-full-addres    = "":U
     1275           v-fmtcli-phone          = "":U
     1276           v-fmtcli-inn            = "":U
     1277           v-fmtcli-kpp            = "":U
     1278           v-fmtcli-okpo           = "":U
     1279           v-fmtcli-city           = "":U
     1280           v-fmtcli-index          = "":U
     1281           v-fmtcli-country        = "":U
     1282       .
     1283       find first buf_clients no-lock
     1284            where buf_clients.obj-type = p-obj-type
     1285              and buf_clients.obj-code = p-obj-code
     1286       .
     1287       assign
     1288           v-fmtcli-name = buf_clients.obj-name
     1289       .
     1290       case buf_clients.obj-type:
     1291          when 'орг':U
     1292          then do:
     1293               find first buf_firm no-lock
     1294                    where buf_firm.firm-code = buf_clients.obj-code
     1295                    no-error
     1296               .
     1297               if available buf_firm
     1298               then do:
     1299                   assign
     1300                       v-num-country-city = num-entries( buf_firm.city )
     1301                       v-fmtcli-engl-name = buf_firm.engl-name
     1302                   .
     1303                   if v-num-country-city > 0
     1304                   then do:
     1305                       assign
     1306                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1307                       .
     1308                   end.
     1309                   if v-num-country-city > 1
     1310                   then do:
     1311                       assign
     1312                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1313                       .
     1314                   end.
     1315                   run fmtcli-concatenate-strings in this-procedure (
     1316                         input v-fmtcli-full-addres
     1317                       , input v-fmtcli-country
     1318                       , input ", ":U
     1319                       , input 50
     1320                       , output v-fmtcli-full-addres
     1321                   ).
     1322                   run fmtcli-concatenate-strings in this-procedure (
     1323                         input v-fmtcli-full-addres
     1324                       , input v-fmtcli-city
     1325                       , input ", ":U
     1326                       , input 50
     1327                       , output v-fmtcli-full-addres
     1328                   ).
     1329                   run fmtcli-concatenate-strings in this-procedure (
     1330                         input v-fmtcli-full-addres
     1331                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1332                       , input ", ":U
     1333                       , input 50
     1334                       , output v-fmtcli-full-addres
     1335                   ).
     1336                   run fmtcli-concatenate-strings in this-procedure (
     1337                         input v-fmtcli-post-addres
     1338                       , input v-fmtcli-country
     1339                       , input ", ":U
     1340                       , input 50
     1341                       , output v-fmtcli-post-addres
     1342                   ).
     1343                   run fmtcli-concatenate-strings in this-procedure (
     1344                         input v-fmtcli-post-addres
     1345                       , input v-fmtcli-city
     1346                       , input ", ":U
     1347                       , input 50
     1348                       , output v-fmtcli-post-addres
     1349                   ).
     1350                   run fmtcli-concatenate-strings in this-procedure (
     1351                         input v-fmtcli-post-addres
     1352                       , input string( buf_firm.ind )
     1353                       , input ", ":U
     1354                       , input 50
     1355                       , output v-fmtcli-post-addres
     1356                   ).
     1357                   run fmtcli-concatenate-strings in this-procedure (
     1358                         input substring( buf_firm.addres1, 1, 50 )
     1359                       , input buf_firm.addres2
     1360                       , input " ":U
     1361                       , input 50
     1362                       , output v-temp-fmtcli-address
     1363                   ).
     1364                   run fmtcli-concatenate-strings in this-procedure (
     1365                         input v-temp-fmtcli-address
     1366                       , input substring( buf_firm.addres1, 51, 50 )
     1367                       , input " ":U
     1368                       , input 50
     1369                       , output v-temp-fmtcli-address
     1370                   ).
     1371                   run fmtcli-concatenate-strings in this-procedure (
     1372                         input v-temp-fmtcli-address
     1373                       , input substring( buf_firm.addres1, 101, 50 )
     1374                       , input " ":U
     1375                       , input 50
     1376                       , output v-temp-fmtcli-address
     1377                   ).
     1378                   assign
     1379                       v-fmtcli-addres = v-temp-fmtcli-address
     1380                   .
     1381                   if buf_firm.addres1 <> ?
     1382                   then do:
     1383                       run fmtcli-concatenate-strings in this-procedure (
     1384                             input v-fmtcli-full-addres
     1385                           , input v-fmtcli-addres
     1386                           , input ", ":U
     1387                           , input 0
     1388                           , output v-fmtcli-full-addres
     1389                       ).
     1390                   end.
     1391                   run fmtcli-concatenate-strings in this-procedure (
     1392                         input substring( buf_firm.post-addr1, 1, 50 )
     1393                       , input buf_firm.post-addr2
     1394                       , input " ":U
     1395                       , input 50
     1396                       , output v-fmtcli-post-addres
     1397                   ).
     1398                   run fmtcli-concatenate-strings in this-procedure (
     1399                         input v-fmtcli-post-addres
     1400                       , input substring( buf_firm.post-addr1, 51, 50 )
     1401                       , input " ":U
     1402                       , input 50
     1403                       , output v-fmtcli-post-addres
     1404                   ).
     1405                   run fmtcli-concatenate-strings in this-procedure (
     1406                         input v-fmtcli-post-addres
     1407                       , input substring( buf_firm.post-addr1, 101, 50 )
     1408                       , input " ":U
     1409                       , input 50
     1410                       , output v-fmtcli-post-addres
     1411                   ).
     1412                   assign
     1413                       v-fmtcli-phone         = buf_firm.phone
     1414                       v-fmtcli-inn           = buf_firm.inn
     1415                       v-fmtcli-kpp           = buf_firm.kpp
     1416                       v-fmtcli-okpo          = buf_firm.okpo
     1417                       v-fmtcli-index         = string( buf_firm.ind )
     1418                   .
     1419               end.
     1420          end.
     1421          when 'маг':U
     1422          then do:
     1423               find first buf_shop no-lock
     1424                    where buf_shop.obj-code = buf_clients.obj-code
     1425               .
     1426               if available buf_shop
     1427               then do:
     1428                   run fmtcli-concatenate-strings in this-procedure (
     1429                         input buf_shop.addres1
     1430                       , input buf_shop.addres2
     1431                       , input " ":U
     1432                       , input 50
     1433                       , output v-fmtcli-addres
     1434                   ).
     1435                   assign
     1436                       v-fmtcli-full-addres = v-fmtcli-addres
     1437                       v-fmtcli-post-addres = v-fmtcli-addres
     1438                       v-fmtcli-phone       = buf_shop.phone
     1439                       v-fmtcli-inn         = "":U
     1440                       v-fmtcli-kpp         = "":U
     1441                       v-fmtcli-okpo        = "":U
     1442                       v-fmtcli-city        = "":U
     1443                       v-fmtcli-index       = "":U
     1444                   .
     1445               end.
     1446          end.
     1447          when 'скл':U
     1448          then do:
     1449               find first buf_store no-lock
     1450                    where buf_store.obj-code = buf_clients.obj-code
     1451               .
     1452               if available buf_store
     1453               then do:
     1454                   run fmtcli-concatenate-strings in this-procedure (
     1455                         input buf_store.addres1
     1456                       , input buf_store.addres2
     1457                       , input " ":U
     1458                       , input 50
     1459                       , output v-fmtcli-addres
     1460                   ).
     1461                   assign
     1462                       v-fmtcli-full-addres = v-fmtcli-addres
     1463                       v-fmtcli-phone       = buf_store.phone
     1464                       v-fmtcli-inn         = "":U
     1465                       v-fmtcli-kpp         = "":U
     1466                       v-fmtcli-okpo        = "":U
     1467                       v-fmtcli-city        = "":U
     1468                       v-fmtcli-index       = "":U
     1469                   .
     1470               end.
     1471          end.
     1472          when 'чел':U
     1473          then do:
     1474               find first buf_person no-lock
     1475                    where buf_person.psn-code = buf_clients.obj-code
     1476               .
     1477               if available buf_person
     1478               then do:
     1479                   run fmtcli-concatenate-strings in this-procedure (
     1480                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1481                                 then "":U
     1482                                 else string( buf_person.ind, "999999")
     1483                                 )
     1484                       , input buf_person.city
     1485                       , input ", ":U
     1486                       , input 0
     1487                       , output v-fmtcli-full-addres
     1488                   ).
     1489                   assign
     1490                       v-fmtcli-addres = buf_person.address
     1491                   .
     1492                   run fmtcli-concatenate-strings in this-procedure (
     1493                         input v-fmtcli-full-addres
     1494                       , input v-fmtcli-addres
     1495                       , input ", ":U
     1496                       , input 0
     1497                       , output v-fmtcli-full-addres
     1498                   ).
     1499                   assign
     1500                       v-fmtcli-phone     = buf_person.phone1
     1501                       v-fmtcli-inn       = buf_person.inn
     1502                       v-fmtcli-kpp       = buf_person.kpp
     1503                       v-fmtcli-okpo      = buf_person.okpo
     1504                       v-fmtcli-city      = buf_person.city
     1505                       v-fmtcli-index     = string( buf_person.ind )
     1506                   .
     1507               end.
     1508          end.
     1509       end case.
     1510   end.
     1511   end procedure.
     1512   procedure fmtcli-concatenate-strings :
     1513   define input parameter p-string-1       as character        no-undo.
     1514   define input parameter p-string-2       as character        no-undo.
     1515   define input parameter p-delimiter      as character        no-undo.
     1516   define input parameter p-length         as integer          no-undo.
     1517   define output parameter p-out-string    as character        no-undo.
     1518   do
     1519   on error undo, return error
     1520   :
     1521       assign
     1522           p-out-string = ( if p-string-1 = ?
     1523                            then "":U
     1524                            else trim( p-string-1 ) )
     1525       .
     1526       assign
     1527           p-out-string = p-out-string
     1528                        + ( if p-out-string = "":U
     1529                            or length( p-out-string ) = p-length
     1530                            or p-string-2 = ?
     1531                            or trim( p-string-2 ) = "":U
     1532                            then "":U
     1533                            else p-delimiter )
     1534                        + ( if p-string-2 = ?
     1535                            or trim( p-string-2 ) = "":U
     1536                            then "":U
     1537                            else trim( p-string-2 ) )
     1538       .
     1539   end.
     1540   end procedure.
     1541   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1542   procedure proc-alt-shift-f2:
     1543     if not ibs.th.gbl.gbl-var:rcode
     1544   then
     1545     run gbl\inidebug.p .
     1546   end.
     1547   procedure proc-alt-shift-f3:
     1548     run gbl/prvssinf.p
     1549       ( input this-procedure
     1550       ) .
     1551   end.
     1552   define variable v-inform-launched as logical no-undo initial false .
     1553   procedure proc-alt-shift-f4:
     1554     define variable v-action as character no-undo .
     1555     if v-inform-launched = false then do:
     1556       assign
     1557         v-inform-launched = true
     1558       .
     1559       run gbl/d-inform.w
     1560         (  input self
     1561         ,  input this-procedure
     1562         , output v-action
     1563         ) no-error .
     1564       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1565       assign
     1566         v-inform-launched = false
     1567       .
     1568     end.
     1569   end.
     1570   procedure proc-alt-f1:
     1571     run gbl/corrhelp.p
     1572       (input this-procedure
     1573       ) .
     1574   end .
     1575   on alt-shift-f2 anywhere do:
     1576     run proc-alt-shift-f2.
     1577   end.
     1578   on alt-shift-f3 anywhere do:
     1579     run proc-alt-shift-f3 in this-procedure .
     1580   end.
     1581   on alt-shift-f4 anywhere do:
     1582     run proc-alt-shift-f4 in this-procedure.
     1583   end.
     1584   on alt-f1 anywhere do:
     1585     run proc-alt-f1 in this-procedure .
     1586   end.
     1587   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1588   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1589   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1590   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1591   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1592   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1593   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1594   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1595   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1596   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1597   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1598   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1599   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1600   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1601   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1602   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1603   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1604   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1605   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1606   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1607   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1608   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1609   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1610   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1611   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1612   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
