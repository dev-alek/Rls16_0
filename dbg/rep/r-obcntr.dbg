     3232             buy-data.sale-sum-base-ret  =  buy-data.sale-sum-base-ret + abs(buf_ot-line.sum-base)
     3233           .
     3234         end.
     3235       end.
     3236       assign
     3237         buy-data.sale-sum-rubl-all  =  buy-data.sale-sum-rubl-ras - buy-data.sale-sum-rubl-ret
     3238         buy-data.sale-sum-base-all  =  buy-data.sale-sum-base-ras - buy-data.sale-sum-base-ret
     3239         buy-data.cost-sum-rubl-all  =  buy-data.cost-sum-rubl-ras - buy-data.cost-sum-rubl-ret
     3240         buy-data.cost-sum-base-all  =  buy-data.cost-sum-base-ras - buy-data.cost-sum-base-ret
     3241         buy-data.all-qnty           =  buy-data.ras-qnty          - buy-data.ret-qnty
     3242       .
     3243     end.
     3244   end.
     3245             end.
     3246         end.
     3247     end.
     3248   Else for each G#CUSTOMER no-lock
     3249         ,each obj-list
     3250        :
     3251     for each buf_trn-doc no-lock
     3252                 where buf_trn-doc.obj-code     = obj-list.obj-code
     3253                 and   buf_trn-doc.obj-type     = obj-list.obj-type
     3254                 and   buf_trn-doc.cli-type     = G#CUSTOMER.obj-type
     3255                 and   buf_trn-doc.cli-code     = G#CUSTOMER.obj-code
     3256                 and   buf_trn-doc.fact-date   >= x-date-start
     3257                 and   buf_trn-doc.fact-date   <= x-date-end
     3258                 and ( buf_trn-doc.ext-doc-type = 'ee':U
     3259                   or  buf_trn-doc.ext-doc-type = 're':U )
     3260                 and buf_trn-doc.status_        = 'факт':U
     3261                 :
     3262                     assign Counter1 = Counter1 + 1.
     3263   IF ( Counter1 modulo v-account = 0 )  then DO:
     3264             if  log-manager:logfile-name ne ?
     3265             then DO:
     3266                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3267             end.
     3268              if mFrameView
     3269              then do:
     3270               DISPLAY
     3271                 Counter1 @ RecordsDone
     3272                 WITH FRAME InfoFrame.
     3273              end.
     3274   End.
     3275      if v-button-stop then  DO:
     3276            if mFrameView
     3277            then
     3278               PROCESS EVENTS.
     3279            IF StopProcessing THEN DO:
     3280            RETURN error.
     3281            End.
     3282      end.
     3283   for each buf_doc-line no-lock
     3284     where buf_doc-line.doc-code = buf_trn-doc.doc-code
     3285   :
     3286     find first tt-goods no-lock
     3287       where tt-goods.artic     = buf_doc-line.artic
     3288         and tt-goods.prod-type = buf_doc-line.prod-type
     3289         and tt-goods.prod-code = buf_doc-line.prod-code
     3290       no-error .
     3291     if available tt-goods then do :
