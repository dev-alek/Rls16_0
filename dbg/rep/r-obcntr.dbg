     3391         buy-data.sale-sum-base-all  =  buy-data.sale-sum-base-ras - buy-data.sale-sum-base-ret
     3392         buy-data.cost-sum-rubl-all  =  buy-data.cost-sum-rubl-ras - buy-data.cost-sum-rubl-ret
     3393         buy-data.cost-sum-base-all  =  buy-data.cost-sum-base-ras - buy-data.cost-sum-base-ret
     3394         buy-data.all-qnty           =  buy-data.ras-qnty          - buy-data.ret-qnty
     3395       .
     3396     end.
     3397   end.
     3398     end.
     3399   end.
     3400   end procedure.
     3401   procedure create-tt-goods :
     3402     define variable v-curr-grp-name as character no-undo .
     3403     define variable v-host-code     like ub.clients.host-code  no-undo .
     3404     do on error undo, return error return-value :
     3405       run waitfram-show in this-procedure ( "Формирование списка товаров..." ) .
     3406       empty temp-table tt-goods.
     3407       for each obj-list :
     3408         case x-SelectGood :
     3409           when 1 then do:
     3410             for each buf_gds-obj no-lock
     3411               where buf_gds-obj.obj-type  = obj-list.obj-type
     3412                 and buf_gds-obj.obj-code  = obj-list.obj-code
     3413               :
     3414               run fill-tt in this-procedure .
     3415             end.
     3416           end.
     3417           when 3 then do:
     3418             for each G#cli :
     3419               for each buf_gds-obj  no-lock
     3420                 where buf_gds-obj.obj-type  = obj-list.obj-type
     3421                   and buf_gds-obj.obj-code  = obj-list.obj-code
     3422                   and buf_gds-obj.prod-type = G#cli.obj-type
     3423                   and buf_gds-obj.prod-code = G#cli.obj-code
     3424                 use-index pi  :
     3425                 run fill-tt in this-procedure .
     3426               end .
     3427             end .
     3428           end .
     3429           when 2 then do:
     3430             for each tmp#grp :
     3431               run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     3432               for each buf_gds-obj no-lock
     3433                 where buf_gds-obj.obj-type = obj-list.obj-type
     3434                   and buf_gds-obj.obj-code = obj-list.obj-code
     3435                   and buf_gds-obj.grp-name begins v-curr-grp-name
     3436                 use-index obj-grp :
     3437                 run fill-tt in this-procedure .
     3438               end .
     3439             end.
     3440           end.
     3441           otherwise do:
     3442             for each gds-list ,
     3443                 each buf_gds-obj no-lock
     3444               where buf_gds-obj.obj-type  = obj-list.obj-type
     3445                 and buf_gds-obj.obj-code  = obj-list.obj-code
     3446                 and buf_gds-obj.artic     = gds-list.artic
     3447                 and buf_gds-obj.prod-type = gds-list.prod-type
     3448                 and buf_gds-obj.prod-code = gds-list.prod-code
     3449               :
     3450               run fill-tt in this-procedure .
     3451             end.
     3452           end.
     3453         end case.
     3454       end.
     3455       run waitfram-hide in this-procedure .
     3456     end.
     3457   end procedure.
     3458   procedure fill-tt :
     3459     do  on error undo, return error return-value :
     3460       find first tt-goods no-lock
     3461       where tt-goods.artic     = buf_gds-obj.artic
     3462         and tt-goods.prod-type = buf_gds-obj.prod-type
     3463         and tt-goods.prod-code = buf_gds-obj.prod-code
     3464         no-error.
     3465       if not available tt-goods then do:
     3466         create tt-goods.
     3467         assign
     3468           v-gds-counter      = v-gds-counter + 1
     3469           tt-goods.prod-type = buf_gds-obj.prod-type
     3470           tt-goods.prod-code = buf_gds-obj.prod-code
     3471           tt-goods.artic     = buf_gds-obj.artic
     3472           tt-goods.gds-code  = buf_gds-obj.gds-code
     3473         .
     3474       end.
     3475     end.
     3476   end procedure.
     3477   procedure clear-tt :
     3478   do
     3479   on error undo, return error return-value
     3480   :
     3481     empty temp-table tt-goods.
     3482   end.
     3483   end procedure.
     3484   procedure calc-itog :
     3485   for each buy-data by buy-data.obj-name :
     3486        find first itog
     3487        where itog.obj-code = buy-data.obj-code
     3488          and itog.obj-type = buy-data.obj-type
     3489          no-error .
     3490          if available itog then do:
     3491             assign Counter1 = Counter1 + 1.
     3492   IF ( Counter1 modulo v-account = 0 )  then DO:
     3493             if  log-manager:logfile-name ne ?
     3494             then DO:
     3495                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3496             end.
     3497              if mFrameView
     3498              then do:
     3499               DISPLAY
     3500                 Counter1 @ RecordsDone
     3501                 WITH FRAME InfoFrame.
     3502              end.
     3503   End.
     3504      if v-button-stop then  DO:
     3505            if mFrameView
     3506            then
     3507               PROCESS EVENTS.
     3508            IF StopProcessing THEN DO:
     3509            RETURN error.
     3510            End.
     3511      end.
     3512             assign
     3513                   itog.ret-qnty          = itog.ret-qnty          + buy-data.ret-qnty
     3514                   itog.ras-qnty          = itog.ras-qnty          + buy-data.ras-qnty
     3515                   itog.all-qnty          = itog.all-qnty          + buy-data.all-qnty
     3516                   itog.cost-sum-rubl-ras = itog.cost-sum-rubl-ras + buy-data.cost-sum-rubl-ras
     3517                   itog.cost-sum-base-ras = itog.cost-sum-base-ras + buy-data.cost-sum-base-ras
     3518                   itog.sale-sum-rubl-ras = itog.sale-sum-rubl-ras + buy-data.sale-sum-rubl-ras
     3519                   itog.sale-sum-base-ras = itog.sale-sum-base-ras + buy-data.sale-sum-base-ras
     3520                   itog.cost-sum-rubl-ret = itog.cost-sum-rubl-ret + buy-data.cost-sum-rubl-ret
     3521                   itog.cost-sum-base-ret = itog.cost-sum-base-ret + buy-data.cost-sum-base-ret
     3522                   itog.sale-sum-rubl-ret = itog.sale-sum-rubl-ret + buy-data.sale-sum-rubl-ret
     3523                   itog.sale-sum-base-ret = itog.sale-sum-base-ret + buy-data.sale-sum-base-ret
     3524                   itog.cost-sum-rubl-all = itog.cost-sum-rubl-all + buy-data.cost-sum-rubl-all
     3525                   itog.cost-sum-base-all = itog.cost-sum-base-all + buy-data.cost-sum-base-all
     3526                   itog.sale-sum-rubl-all = itog.sale-sum-rubl-all + buy-data.sale-sum-rubl-all
     3527                   itog.sale-sum-base-all = itog.sale-sum-base-all + buy-data.sale-sum-base-all
     3528             .
     3529          end.
     3530          else do:
     3531             create itog.
     3532             assign
     3533                   itog.ret-qnty          = itog.ret-qnty          + buy-data.ret-qnty
     3534                   itog.ras-qnty          = itog.ras-qnty          + buy-data.ras-qnty
     3535                   itog.all-qnty          = itog.all-qnty          + buy-data.all-qnty
     3536                   itog.cost-sum-rubl-ras = itog.cost-sum-rubl-ras + buy-data.cost-sum-rubl-ras
     3537                   itog.cost-sum-base-ras = itog.cost-sum-base-ras + buy-data.cost-sum-base-ras
     3538                   itog.sale-sum-rubl-ras = itog.sale-sum-rubl-ras + buy-data.sale-sum-rubl-ras
     3539                   itog.sale-sum-base-ras = itog.sale-sum-base-ras + buy-data.sale-sum-base-ras
     3540                   itog.cost-sum-rubl-ret = itog.cost-sum-rubl-ret + buy-data.cost-sum-rubl-ret
     3541                   itog.cost-sum-base-ret = itog.cost-sum-base-ret + buy-data.cost-sum-base-ret
     3542                   itog.sale-sum-rubl-ret = itog.sale-sum-rubl-ret + buy-data.sale-sum-rubl-ret
     3543                   itog.sale-sum-base-ret = itog.sale-sum-base-ret + buy-data.sale-sum-base-ret
     3544                   itog.cost-sum-rubl-all = itog.cost-sum-rubl-all + buy-data.cost-sum-rubl-all
     3545                   itog.cost-sum-base-all = itog.cost-sum-base-all + buy-data.cost-sum-base-all
     3546                   itog.sale-sum-rubl-all = itog.sale-sum-rubl-all + buy-data.sale-sum-rubl-all
     3547                   itog.sale-sum-base-all = itog.sale-sum-base-all + buy-data.sale-sum-base-all
     3548                   itog.obj-code          = buy-data.obj-code
     3549                   itog.obj-type          = buy-data.obj-type
     3550                   itog.obj-name          = buy-data.obj-name
     3551               .
     3552          end.
     3553   end.
     3554   for each itog :
     3555                  assign
     3556                   itog-cost-sum-rubl-ras = itog-cost-sum-rubl-ras + itog.cost-sum-rubl-ras
     3557                   itog-cost-sum-base-ras = itog-cost-sum-base-ras + itog.cost-sum-base-ras
     3558                   itog-sale-sum-rubl-ras = itog-sale-sum-rubl-ras + itog.sale-sum-rubl-ras
     3559                   itog-sale-sum-base-ras = itog-sale-sum-base-ras + itog.sale-sum-base-ras
     3560                   itog-cost-sum-rubl-ret = itog-cost-sum-rubl-ret + itog.cost-sum-rubl-ret
     3561                   itog-cost-sum-base-ret = itog-cost-sum-base-ret + itog.cost-sum-base-ret
     3562                   itog-sale-sum-rubl-ret = itog-sale-sum-rubl-ret + itog.sale-sum-rubl-ret
     3563                   itog-sale-sum-base-ret = itog-sale-sum-base-ret + itog.sale-sum-base-ret
     3564                   itog-cost-sum-rubl-all = itog-cost-sum-rubl-all + itog.cost-sum-rubl-all
     3565                   itog-cost-sum-base-all = itog-cost-sum-base-all + itog.cost-sum-base-all
     3566                   itog-sale-sum-rubl-all = itog-sale-sum-rubl-all + itog.sale-sum-rubl-all
     3567                   itog-sale-sum-base-all = itog-sale-sum-base-all + itog.sale-sum-base-all
     3568                   itog-ret-qnty          = itog-ret-qnty          + itog.ret-qnty
     3569                   itog-ras-qnty          = itog-ras-qnty          + itog.ras-qnty
     3570                   itog-all-qnty          = itog-all-qnty          + itog.all-qnty
     3571                  .
     3572   end.
     3573   end procedure.
     3574   procedure print-text :
     3575     if p-detdoctip = true
     3576     then do :
     3577     DEFINE FRAME obcntr-det
     3578             sym1            column-label ":!:"                      format "x(1)"                 space(0)
     3579             F-pos-cli-code  column-label "Код ! ":C9                format "x(9)"                 space(0)
     3580             sym2            column-label ":!:"                      format "x(1)"                 space(0)
     3581             F-Artic         column-label "Артикул! ":C16            format "X(16)"                space(0)
     3582             sym3            column-label ":!:"                      format "x(1)"                 space(0)
     3583             F-Fullname      column-label "Наименование! ":C40       format "X(40)"                space(0)
     3584             sym4            column-label ":!:"                      format "x(1)"                 space(0)
     3585             F-qnty-ras      column-label "Количество! Расход ":C12  format "->>>>>>9.999"         space(0)
     3586             sym5            column-label ":!:"                      format "x(1)"                 space(0)
     3587             F-rashod        column-label "Расход ! ":C15            format "->>>>>>>>>>9.99"      space(0)
     3588             sym6            column-label ":!:"                      format "x(1)"                 space(0)
     3589             F-qnty-ret      column-label "Количество! Возврат ":C12 format "->>>>>>9.999"         space(0)
     3590             sym7            column-label ":!:"                      format "x(1)"                 space(0)
     3591             F-return        column-label "Возврат ! ":C15           format "->>>>>>>>>>9.99"      space(0)
     3592             sym8            column-label ":!:"                      format "x(1)"                 space(0)
     3593             F-qnty-all      column-label "Итого! количество":C12    format "->>>>>>9.999"         space(0)
     3594             sym9            column-label ":!:"                      format "x(1)"                 space(0)
     3595             F-all           column-label "Итого! обороты!":C15      format "->>>>>>>>>>9.99"      space(0)
     3596             sym10           column-label ":!:"                      format "x(1)"                 space(0)
     3597         HEADER
     3598             string( "Страница " + string((PAGE-NUMBER( OutStream ) + 1) , ">>>>9") ) AT 140 format "X(15)" skip
     3599             Line format "X(160)" at 1 skip
     3600       with width 235  down stream-io use-text NO-BOX.
     3601           FORM HEADER
     3602               "Продолжение - на следующей странице" AT 100 SKIP
     3603         with FRAME Outstream width 235  PAGE-BOTTOM NO-LABELS no-box.
     3604       VIEW stream Outstream FRAME obcntr-det .
     3605       FORM with FRAME obcntr-det .
     3606     end.
     3607     else do:
     3608     DEFINE FRAME obcntr
     3609             sym1            column-label ":!:"                      format "x(1)"                 space(0)
     3610             F-pos-cli-code  column-label "Код !  ":C9               format "x(9)"                 space(0)
     3611             sym2            column-label ":!:"                      format "x(1)"                 space(0)
     3612             F-Artic         column-label "Артикул! ":C16            format "X(16)"                space(0)
     3613             sym3            column-label ":!:"                      format "x(1)"                 space(0)
     3614             F-Fullname      column-label "Наименование! ":C40       format "X(40)"                space(0)
     3615             sym4            column-label ":!:"                      format "x(1)"                 space(0)
     3616             F-qnty-all      column-label "Количество! ":C12         format "->>>>>>9.999"         space(0)
     3617             sym5            column-label ":!:"                      format "x(1)"                 space(0)
     3618             F-all           column-label "Итого обороты! ":C15      format "->>>>>>>>>>9.99"      space(0)
     3619             sym6            column-label ":!:"                      format "x(1)"                 space(0)
     3620         HEADER
     3621             string( "Страница " + string((PAGE-NUMBER( OutStream ) + 1) , ">>>>9") ) AT 78 format "X(15)" skip
     3622             Line format "X(98)" AT 1 skip
     3623       with width 235 down stream-io use-text NO-BOX.
     3624       FORM HEADER
     3625         "Продолжение - на следующей странице" AT 30 SKIP
     3626         with FRAME Outstream width 235 PAGE-BOTTOM NO-LABELS no-box.
     3627       VIEW stream Outstream FRAME obcntr .
     3628       FORM with FRAME obcntr .
     3629     end.
     3630     for each itog by itog.obj-name:
     3631         if p-detdoctip = true then do:
     3632             display stream Outstream
     3633             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 when p-detgoods = true
     3634             itog.obj-name                                      when p-detgoods = true    @ F-Fullname
     3635             with frame obcntr-det .
     3636             down stream Outstream 1 with frame obcntr-det .
     3637             for each buy-data
     3638             where buy-data.obj-type = itog.obj-type
     3639             and   buy-data.obj-code = itog.obj-code
     3640             and   p-detgoods = true
     3641             :
     3642                 display stream Outstream
     3643                     sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     3644                     buy-data.gds-code           @ F-pos-cli-code
     3645                     buy-data.artic              @ F-Artic
     3646                     buy-data.name               @ F-Fullname
     3647                     buy-data.ras-qnty           @ F-qnty-ras
     3648                     buy-data.ret-qnty           @ F-qnty-ret
     3649                     buy-data.all-qnty           @ F-qnty-all
     3650                     buy-data.cost-sum-rubl-ras  when ( v-print-rubl = true and show-cost = true) @ F-rashod
     3651                     buy-data.sale-sum-rubl-ras  when ( v-print-rubl = true and show-sale = true) @ F-rashod
     3652                     buy-data.cost-sum-base-ras  when ( v-print-rubl = false and show-cost = true) @ F-rashod
     3653                     buy-data.sale-sum-base-ras  when ( v-print-rubl = false and show-sale = true) @ F-rashod
     3654                     buy-data.sale-sum-rubl-ret  when ( v-print-rubl = true and show-sale = true) @ F-return
     3655                     buy-data.cost-sum-rubl-ret  when ( v-print-rubl = true and show-cost = true) @ F-return
     3656                     buy-data.sale-sum-base-ret  when ( v-print-rubl = false and show-sale = true) @ F-return
     3657                     buy-data.cost-sum-base-ret  when ( v-print-rubl = false and show-cost = true) @ F-return
     3658                     buy-data.sale-sum-rubl-all  when ( v-print-rubl = true and show-sale = true) @ F-all
     3659                     buy-data.cost-sum-rubl-all  when ( v-print-rubl = true and show-cost = true) @ F-all
     3660                     buy-data.sale-sum-base-all  when ( v-print-rubl = false and show-sale = true) @ F-all
     3661                     buy-data.cost-sum-base-all  when ( v-print-rubl = false and show-cost = true) @ F-all
     3662                     with frame obcntr-det .
     3663                     down stream Outstream 1 with frame obcntr-det .
     3664             end.
     3665             display stream Outstream
     3666             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     3667             ("Итого " + itog.obj-name) when p-detgoods = true @ F-fullname
     3668             itog.obj-name              when p-detgoods = false  @ F-fullname
     3669             itog.ras-qnty                                                                    @ F-qnty-ras
     3670             itog.ret-qnty                                                                    @ F-qnty-ret
     3671             itog.all-qnty                                                                    @ F-qnty-all
     3672             itog.cost-sum-rubl-ras   when ( v-print-rubl = true  and show-cost = true)       @ F-rashod
     3673             itog.sale-sum-rubl-ras   when ( v-print-rubl = true  and show-sale = true)       @ F-rashod
     3674             itog.cost-sum-base-ras   when ( v-print-rubl = false and show-cost = true)       @ F-rashod
     3675             itog.sale-sum-base-ras   when ( v-print-rubl = false and show-sale = true)       @ F-rashod
     3676             itog.cost-sum-rubl-ret   when ( v-print-rubl = true  and show-cost = true)       @ F-return
     3677             itog.sale-sum-rubl-ret   when ( v-print-rubl = true  and show-sale = true)       @ F-return
     3678             itog.cost-sum-base-ret   when ( v-print-rubl = false and show-cost = true)       @ F-return
     3679             itog.sale-sum-base-ret   when ( v-print-rubl = false and show-sale = true)       @ F-return
     3680             itog.cost-sum-rubl-all   when ( v-print-rubl = true  and show-cost = true)       @ F-all
     3681             itog.sale-sum-rubl-all   when ( v-print-rubl = true  and show-sale = true)       @ F-all
     3682             itog.cost-sum-base-all   when ( v-print-rubl = false and show-cost = true)       @ F-all
     3683             itog.sale-sum-base-all   when ( v-print-rubl = false and show-sale = true)       @ F-all
     3684             with frame obcntr-det .
     3685             down stream Outstream 1 with frame obcntr-det .
     3686             underline stream outstream F-pos-cli-code F-Artic F-Fullname F-qnty-ras F-qnty-ret F-qnty-all F-rashod F-return F-all with frame obcntr-det .
     3687         end.
     3688         else do :
     3689             display stream Outstream
     3690                 sym1 sym2 sym3 sym4 sym5 sym6  when p-detgoods = true
     3691                 itog.obj-name                  when p-detgoods = true     @ F-Fullname
     3692                 with frame obcntr .
     3693                 down stream Outstream 1 with frame obcntr .
     3694             for each buy-data
     3695             where buy-data.obj-type = itog.obj-type
     3696             and   buy-data.obj-code = itog.obj-code
     3697             and p-detgoods = true
     3698             :
     3699                 display stream Outstream
     3700                     sym1 sym2 sym3 sym4 sym5 sym6
     3701                     buy-data.gds-code             @ F-pos-cli-code
     3702                     buy-data.artic                @ F-Artic
     3703                     buy-data.name                 @ F-Fullname
     3704                     buy-data.all-qnty             @ F-qnty-all
     3705                     buy-data.sale-sum-rubl-all  when ( v-print-rubl = true  and show-sale = true) @ F-all
     3706                     buy-data.cost-sum-rubl-all  when ( v-print-rubl = true  and show-cost = true) @ F-all
     3707                     buy-data.sale-sum-base-all  when ( v-print-rubl = false and show-sale = true) @ F-all
     3708                     buy-data.cost-sum-base-all  when ( v-print-rubl = false and show-cost = true) @ F-all
     3709                     with frame obcntr .
     3710                   down stream Outstream 1 with frame obcntr .
     3711             end.
     3712             display stream Outstream
     3713             sym1 sym2 sym3 sym4 sym5 sym6
     3714             ("Итого " + itog.obj-name)            when p-detgoods = true                @ F-fullname
     3715             itog.obj-name                         when p-detgoods = false               @ F-fullname
     3716             itog.all-qnty                                                               @ F-qnty-all
     3717             itog.cost-sum-rubl-all   when ( v-print-rubl = true  and show-cost = true)  @ F-all
     3718             itog.sale-sum-rubl-all   when ( v-print-rubl = true  and show-sale = true)  @ F-all
     3719             itog.cost-sum-base-all   when ( v-print-rubl = false and show-cost = true)  @ F-all
     3720             itog.sale-sum-base-all   when ( v-print-rubl = false and show-sale = true)  @ F-all
     3721             with frame obcntr .
     3722             down stream Outstream 1 with frame obcntr .
     3723             underline stream outstream F-pos-cli-code F-Artic F-Fullname F-qnty-all F-all  with frame obcntr .
     3724         end.
     3725     end.
     3726     if p-detdoctip = true then do:
     3727         display stream Outstream
     3728         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     3729         "Итого по всем контрагентам: " @ F-fullname
     3730             itog-ras-qnty                                                                    @ F-qnty-ras
     3731             itog-ret-qnty                                                                    @ F-qnty-ret
     3732             itog-all-qnty                                                                    @ F-qnty-all
     3733             itog-cost-sum-rubl-ras   when ( v-print-rubl = true  and show-cost = true)       @ F-rashod
     3734             itog-sale-sum-rubl-ras   when ( v-print-rubl = true  and show-sale = true)       @ F-rashod
     3735             itog-cost-sum-base-ras   when ( v-print-rubl = false and show-cost = true)       @ F-rashod
     3736             itog-sale-sum-base-ras   when ( v-print-rubl = false and show-sale = true)       @ F-rashod
     3737             itog-cost-sum-rubl-ret   when ( v-print-rubl = true  and show-cost = true)       @ F-return
     3738             itog-sale-sum-rubl-ret   when ( v-print-rubl = true  and show-sale = true)       @ F-return
     3739             itog-cost-sum-base-ret   when ( v-print-rubl = false and show-cost = true)       @ F-return
     3740             itog-sale-sum-base-ret   when ( v-print-rubl = false and show-sale = true)       @ F-return
     3741             itog-cost-sum-rubl-all   when ( v-print-rubl = true  and show-cost = true)       @ F-all
     3742             itog-sale-sum-rubl-all   when ( v-print-rubl = true  and show-sale = true)       @ F-all
     3743             itog-cost-sum-base-all   when ( v-print-rubl = false and show-cost = true)       @ F-all
     3744             itog-sale-sum-base-all   when ( v-print-rubl = false and show-sale = true)       @ F-all
     3745         with frame obcntr-det .
     3746         down stream Outstream 1 with frame obcntr-det .
     3747         underline stream outstream F-pos-cli-code F-Artic F-Fullname F-qnty-ras F-qnty-ret F-qnty-all F-rashod F-return F-all with frame obcntr-det .
     3748     end.
     3749     else do:
