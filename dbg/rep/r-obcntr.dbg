     1616   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1617   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1618   procedure paramls-clear :
     1619     define buffer buf_temp-param for temp-param .
     1620     do
     1621     on error undo, return error return-value
     1622     :
     1623       for each buf_temp-param
     1624       on error undo, return error
     1625       :
     1626         delete buf_temp-param .
     1627       end.
     1628     end.
     1629   end procedure.
     1630   procedure paramls-write :
     1631     define input  parameter p-code     as character no-undo .
     1632     define input  parameter p-sub-code as character no-undo .
     1633     define input  parameter p-value    as character no-undo .
     1634     define buffer buf_temp-param for temp-param .
     1635     do
     1636     on error undo, return error return-value
     1637     :
     1638       find first buf_temp-param
     1639         where buf_temp-param.param-code     = p-code
     1640           and buf_temp-param.param-sub-code = p-sub-code
     1641         no-error .
     1642       if not available buf_temp-param then do:
     1643         create buf_temp-param .
     1644         assign
     1645           buf_temp-param.param-code     = p-code
     1646           buf_temp-param.param-sub-code = p-sub-code
     1647         .
     1648       end.
     1649       assign
     1650         buf_temp-param.param-value = p-value
     1651       .
     1652     end.
     1653   end procedure.
     1654   procedure paramls-read :
     1655     define input  parameter p-code          as character no-undo .
     1656     define input  parameter p-sub-code      as character no-undo .
     1657     define input  parameter p-default-value as character no-undo .
     1658     define output parameter p-value         as character no-undo .
     1659     define buffer buf_temp-param for temp-param .
     1660     do
     1661     on error undo, return error return-value
     1662     :
     1663       find first buf_temp-param
     1664         where buf_temp-param.param-code     = p-code
     1665           and buf_temp-param.param-sub-code = p-sub-code
     1666         no-error .
     1667       if available buf_temp-param then do:
     1668         assign
     1669           p-value = buf_temp-param.param-value
     1670         .
     1671       end.
     1672       else do:
     1673         assign
     1674           p-value = p-default-value
     1675         .
     1676       end.
     1677     end.
     1678   end procedure.
     1679   procedure paramls-append :
     1680     define input  parameter p-code     as character no-undo .
     1681     define input  parameter p-sub-code as character no-undo .
     1682     define input  parameter p-value    as character no-undo .
     1683     define buffer buf_temp-param for temp-param .
     1684     do
     1685     on error undo, return error return-value
     1686     :
     1687       find first buf_temp-param
     1688            where buf_temp-param.param-code     = p-code
     1689              and buf_temp-param.param-sub-code = p-sub-code
     1690         no-error .
     1691       if not available buf_temp-param then do:
     1692         create buf_temp-param .
     1693         assign
     1694           buf_temp-param.param-code     = p-code
     1695           buf_temp-param.param-sub-code = p-sub-code
     1696           buf_temp-param.param-value    = p-value
     1697         .
     1698       end.
     1699       else do:
     1700           assign
     1701               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1702           .
     1703       end.
     1704     end.
     1705   end procedure.
     1706   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1707   define variable v-waitfram-action01         as character   no-undo .
     1708   define variable v-waitfram-action02         as character   no-undo .
     1709   define variable v-waitfram-action03         as character   no-undo .
     1710   define variable mWaitFramTextBeg            as character   no-undo.
     1711   define variable mWaitFramTextEnd            as character   no-undo.
     1712   define variable mWaitFramView               as logical     no-undo.
     1713   define variable mWaitProcEvent              as logical     no-undo init yes.
     1714   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1715   define variable mWaitFramStop               as logical     no-undo.
     1716   define variable mWaitFramStopUser           as logical     no-undo.
     1717   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1718   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1719   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1720   define button B-WaitFramStop auto-end-key
     1721        label "Стоп"
     1722        size 10 by 1 tooltip "Остоновить процесс".
     1723   define button B-viewProcInfo
     1724        label "Информация"
     1725        size 15 by 1 tooltip "Информация о процесс".
     1726   define frame waitfram
     1727     v-waitfram-action01 format "x(72)" no-label skip
     1728     v-waitfram-action02 format "x(72)" no-label skip
     1729     v-waitfram-action03 format "x(72)" no-label skip
     1730     B-viewProcInfo
     1731     B-WaitFramStop at row 4 col 30
     1732     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1733     .
     1734   define new global shared variable mBatchMode as logical no-undo init ?.
     1735   define variable mFramBachModHandle as handle no-undo.
     1736   mFramBachModHandle = frame waitfram:handle.
     1737   define variable mFameOldVis as logical no-undo.
     1738   define variable mVisCUrentVin as logical no-undo.
     1739   if session:batch-mode
     1740   then
     1741      mBatchMode = yes.
     1742   if mBatchMode = ? then do:
     1743     mVisCUrentVin = current-window:visible.
     1744     mFameOldVis = mFramBachModHandle:visible.
     1745     mFramBachModHandle:visible  = yes.
     1746     mBatchMode = mFramBachModHandle:visible ne yes.
     1747     mFramBachModHandle:visible = mFameOldVis.
     1748     current-window:visible = mVisCUrentVin.
     1749   end.
     1750    if  log-manager:logfile-name ne ?
     1751     then DO:
     1752         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1753         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1754         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1755     end.
     1756   on choose of B-WaitFramStop in frame waitfram
     1757   do:
     1758     mWaitFramStop = yes.
     1759     mWaitFramStopUser = yes.
     1760   end.
     1761   function waitfram-check-timeout returns logical():
     1762      define variable vtime as int64 no-undo.
     1763      if mWaitFramStopTimeOut
     1764      then
     1765         return yes.
     1766      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1767      if     mWaitFramTimeOut ne ?
     1768         and mWaitFramTimeOut ne 0
     1769         and mWaitFramTimeOut lt vtime
     1770      then do:
     1771         mWaitFramStopTimeOut = yes.
     1772      end.
     1773      return mWaitFramStopTimeOut.
     1774   end.
     1775   procedure waitfram-hide :
     1776     if not session:batch-mode
     1777     then do
     1778     on error undo, return error return-value
     1779     :
     1780       pause 0 before-hide .
     1781       if not mBatchMode then
     1782         hide frame waitfram .
     1783     if     not mWaitFramView
     1784        and mWaitProcEvent
     1785     then
     1786       process events .
     1787     end.
     1788   end procedure.
     1789   procedure waitfram-show :
     1790     define input  parameter p-message as character no-undo .
     1791     define variable v-left-margin as integer   no-undo .
     1792     if not session:batch-mode
     1793     then do
     1794     on error undo, return error return-value
     1795     :
     1796       if length(p-message) <= 70 then do:
     1797         assign
     1798           v-left-margin = integer((70 - length(p-message)) / 2)
     1799         .
     1800         assign
     1801           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1802         .
     1803         assign
     1804           v-waitfram-action01 = " "
     1805           v-waitfram-action02 = " "
     1806                                    + fill(" ", v-left-margin)
     1807                                    + p-message
     1808           v-waitfram-action03 = " "
     1809         .
     1810       end.
     1811       else do:
     1812         define variable vRindex1 as integer no-undo.
     1813         define variable vRindex2 as integer no-undo.
     1814         vRindex1 = r-index(p-message," ",70).
     1815         if vRindex1 = 0
     1816         then
     1817            vRindex1 = 70.
     1818         if length(p-message)  <= vRindex1 + 70 then do:
     1819           assign
     1820             v-waitfram-action01 = " "
     1821             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1822             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1823           .
     1824         end.
     1825         else do:
     1826           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1827           if vRindex2 <= vRindex1
     1828           then
     1829              vRindex2 = vRindex1 + 70.
     1830           assign
     1831             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1832             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1833             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1834           .
     1835         end.
     1836       end.
     1837       B-viewProcInfo:visible   in frame waitfram = no.
     1838       B-viewProcInfo:sensitive in frame waitfram = no.
     1839       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1840       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1841       if  (   mWaitFramView
     1842          or  mWaitProcEvent)
     1843          and not mBatchMode
     1844       then
     1845          display
     1846             v-waitfram-action01 skip
     1847             v-waitfram-action02 skip
     1848             v-waitfram-action03 skip
     1849          with frame waitfram .
     1850       if     mWaitFramView
     1851          then do:
     1852             if     mWaitFramInterval ne ?
     1853                and not mBatchMode
     1854             then
     1855                wait-for go of frame waitfram pause mWaitFramInterval.
     1856          end.
     1857          else
     1858             if     mWaitProcEvent
     1859                and not mBatchMode
     1860             then
     1861                process events .
     1862     end.
     1863   end procedure.
     1864      procedure waitfram-show-this:
     1865         define input  parameter iInterval as int64 no-undo.
     1866         define variable vtime as int64 no-undo.
     1867         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1868         mWaitFramInterval = iInterval.
     1869         run waitfram-show (substitute("&1&2 &3&4" ,
     1870                                       mWaitFramTextBeg ,
     1871                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1872                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1873                                       mWaitFramTextEnd
     1874                                      )
     1875                           ).
     1876      end.
     1877      procedure WaitFramRunPause:
     1878         define input  parameter iInterval as dec no-undo.
     1879         define variable vStart  as datetime-tz no-undo.
     1880         define variable vend    as datetime-tz no-undo.
     1881         define variable vint as int64 no-undo.
     1882         define variable vOk as logical no-undo.
     1883         vStart = now.
     1884         vend   = vStart.
     1885         publish "WaitFramPause" (iInterval,output vOk).
     1886         vend   =  now.
     1887         vint = vend - vStart.
     1888         vint = iInterval - vint / 1000.
     1889         if     not mWaitFramStop
     1890            and (   vint > 0
     1891                 or (    not vOk
     1892                     and iInterval eq ?
     1893                     )
     1894                 )
     1895         then
     1896            run waitfram-show-this (iInterval).
     1897         vend   =  now.
     1898         vint = vend - vStart.
     1899         vint = iInterval - vint / 1000.
     1900         if     not mWaitFramStop
     1901            and vint > 0
     1902         then do:
     1903            run gbl/pause.p (vint * 1000).
     1904         end.
     1905         if iInterval ne ?
     1906         then
     1907            publish "WaitFramStop".
     1908         waitfram-check-timeout().
     1909      end.
     1910      procedure WaitFramWaitFor:
     1911         define input  parameter iInterval as dec no-undo.
     1912         assign
     1913            mWaitFramStartProc   = now
     1914            mWaitFramStopUser    = no
     1915            mWaitFramStopTimeOut = no
     1916         .
     1917         block-wait:
     1918         do while not mWaitFramStop:
     1919            run WaitFramRunPause (iInterval).
     1920            if  waitfram-check-timeout()
     1921            then do:
     1922               leave block-wait.
     1923            end.
     1924         end.
     1925         run waitfram-hide.
     1926      end.
     1927   procedure waitfram-join :
     1928     define input  parameter p-line-1  as character no-undo .
     1929     define input  parameter p-line-2  as character no-undo .
     1930     define input  parameter p-line-3  as character no-undo .
     1931     define output parameter p-message as character no-undo .
     1932     do
     1933     on error undo, return error return-value
     1934     :
     1935       assign
     1936         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1937                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1938                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1939       .
     1940     end.
     1941   end procedure.
     1942   function waitfram-join-function returns character
     1943     (input p-line-1 as character
     1944     ,input p-line-2 as character
     1945     ,input p-line-3 as character
     1946     ).
     1947     define variable v-message as character no-undo .
     1948     run waitfram-join in this-procedure
     1949       (input  p-line-1
     1950       ,input  p-line-2
     1951       ,input  p-line-3
     1952       ,output v-message
     1953       ) .
     1954     return v-message .
     1955   end function .
     1956   define variable vss-include-info16 as character format "X(65)" no-undo
     1957   initial "@(#)$Workfile$ $Revision$".
     1958   procedure grplib-get-full-name :
     1959      define input parameter p-node-code  as integer      no-undo.
     1960      define output parameter p-full-name as character    no-undo.
     1961      do
     1962   on error undo, return error
     1963   :
     1964       define variable v-upper-code    as integer           no-undo.
     1965       define buffer buf_gds-grp       for ub.gds-grp.
     1966       define buffer buf_upper_gds-grp for ub.gds-grp.
     1967       find first buf_gds-grp no-lock
     1968            where buf_gds-grp.node-code = p-node-code
     1969       no-error.
     1970       if not available buf_gds-grp
     1971       then do:
     1972           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1973       end.
     1974       assign
     1975           p-full-name  = ""
     1976           v-upper-code = 1
     1977       .
     1978       do while buf_gds-grp.upper-code <> 0
     1979       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1980       :
     1981           assign
     1982               p-full-name  = buf_gds-grp.node-name
     1983                            + (if p-full-name <> "" then chr(47) else "")
     1984                            + p-full-name
     1985               v-upper-code = buf_gds-grp.upper-code
     1986           .
     1987           find first buf_gds-grp no-lock
     1988                where buf_gds-grp.node-code = v-upper-code
     1989           no-error.
     1990           if not available buf_gds-grp
     1991           then do:
     1992               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1993                                   + string( v-upper-code )
     1994                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1995           end.
     1996       end.
     1997       assign
     1998       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1999       .
     2000   end.
     2001   end .
     2002   procedure grplib-get-node-from-full-name :
     2003   define input parameter p-full-name as character no-undo .
     2004   define output parameter p-node-code as integer no-undo .
     2005   define variable v-ii as integer no-undo .
     2006   define variable v-upper-code as integer no-undo .
     2007   define variable v-root-code as integer no-undo .
     2008   define variable v-entry as character no-undo .
     2009   define buffer buf_gds-grp       for ub.gds-grp.
     2010   do
     2011   on error undo, return error
     2012   :
     2013     find first buf_gds-grp no-lock
     2014         where buf_gds-grp.upper-code = 0
     2015     no-error .
     2016     if not available buf_gds-grp
     2017     then do:
     2018         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2019     end.
     2020     else do:
     2021       assign
     2022       v-root-code = buf_gds-grp.node-code
     2023       .
     2024     end.
     2025     v-upper-code = v-root-code.
     2026     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2027       assign
     2028       v-entry = entry(v-ii, p-full-name, chr(47)).
     2029       if v-entry = '' then leave.
     2030       find first buf_gds-grp no-lock where
     2031                 buf_gds-grp.node-name = v-entry
     2032             and buf_gds-grp.upper-code = v-upper-code
     2033             no-error.
     2034       if not available buf_gds-grp then do:
     2035         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2036       end.
     2037       else do:
     2038         p-node-code = buf_gds-grp.node-code.
     2039         v-upper-code = buf_gds-grp.node-code.
     2040       end.
     2041     end.
     2042   end.
     2043   end .
     2044   define input parameter p-curr-host-code  like ub.clients.obj-code   no-undo .
     2045   define input parameter p-curr-host-type  like ub.clients.obj-type   no-undo .
     2046   define input parameter x-base-type       like ub.currency.curr-abbr no-undo .
     2047   define input parameter x-base-code       like ub.currency.curr-code no-undo .
     2048   define input parameter p-detgoods        as logical                 no-undo .
     2049   define input parameter p-detdoctip       as logical                 no-undo .
     2050   define variable v-curr-r-b         as character   no-undo .
     2051   define variable v-print-rubl       as logical     no-undo .
     2052   def var v-old-name as char.
     2053   define temp-table temp-font no-undo
     2054     field fontnum  as integer
     2055     field fontname as character
     2056     field fontsize as character
     2057     field fonttype as character
     2058     field font-h   as integer
     2059     field font-w   as integer
     2060     field v-row    as integer
     2061     field v-col    as integer
     2062     field v-row-lans as integer
     2063     field v-col-lans as integer
     2064   index pi fontnum
     2065   .
     2066   procedure get-font-ini :
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070   define variable ii as integer   no-undo .
     2071   define variable v-font7 as character no-undo .
     2072   define variable v-font as character no-undo .
     2073   define variable loc-name as character no-undo .
     2074   define variable loc-size as character no-undo .
     2075   define variable loc-type as character no-undo .
     2076   define variable old_H as integer   no-undo .
     2077   define variable old_w as integer   no-undo .
     2078   define variable old-row  as integer   no-undo .
     2079   define variable old-col  as integer   no-undo .
     2080   define variable old-row-lans  as integer   no-undo .
     2081   define variable old-col-lans  as integer   no-undo .
     2082   define variable vv as integer   no-undo .
     2083   empty temp-table temp-font.
     2084     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     2085       case num-entries (v-font7) :
     2086         when 4 then do:
     2087             assign
     2088               loc-name = entry ( 1 , v-font7 )
     2089               loc-size = entry ( 2 , v-font7 )
     2090               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     2091             .
     2092         end.
     2093         when 3 then do:
     2094             assign
     2095               loc-name = entry ( 1 , v-font7 )
     2096               loc-size = entry ( 2 , v-font7 )
     2097               loc-type = entry ( 3 , v-font7 )
     2098             .
     2099         end.
     2100         when 2 then  do:
     2101             assign
     2102               loc-name = entry ( 1 , v-font7 )
     2103               loc-size = entry ( 2 , v-font7 )
     2104               loc-type = ""
     2105             .
     2106         end.
     2107         when 1 then do:
     2108             assign
     2109               loc-name = trim(entry ( 1 , v-font7 ))
     2110               loc-size = ""
     2111               loc-type = ""
     2112             .
     2113         end.
     2114       end case.
     2115     create temp-font.
     2116     assign
     2117       temp-font.fontnum  = 7
     2118       temp-font.fontname = trim(loc-name)
     2119       temp-font.fontsize = trim(loc-size)
     2120       temp-font.fonttype = trim(loc-type)
     2121       temp-font.v-row    = 62
     2122       temp-font.v-col    = 136
     2123       temp-font.v-row-lans = 43
     2124       temp-font.v-col-lans = 198
     2125     .
     2126     repeat ii = 16 to 100 :
     2127       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     2128       if v-font = "" or v-font = ? then leave.
     2129       case num-entries (v-font) :
     2130         when 4 then do:
     2131             assign
     2132               loc-name = entry ( 1 , v-font )
     2133               loc-size = entry ( 2 , v-font )
     2134               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     2135             .
     2136         end.
     2137         when 3 then do:
     2138             assign
     2139               loc-name = entry ( 1 , v-font )
     2140               loc-size = entry ( 2 , v-font )
     2141               loc-type = entry ( 3 , v-font )
     2142             .
     2143         end.
     2144         when 2 then do:
     2145             assign
     2146               loc-name = entry ( 1 , v-font )
     2147               loc-size = entry ( 2 , v-font )
     2148               loc-type = ""
     2149             .
     2150         end.
     2151         when 1 then do:
     2152             assign
     2153               loc-name = trim(entry ( 1 , v-font ))
     2154               loc-size = ""
     2155               loc-type = ""
     2156             .
     2157         end.
     2158       end case.
     2159     create temp-font.
     2160     assign
     2161       temp-font.fontnum  = ii
     2162       temp-font.fontname = trim(loc-name)
     2163       temp-font.fontsize = trim(loc-size)
     2164       temp-font.fonttype = trim(loc-type)
     2165     .
     2166     end.
     2167       for each temp-font :
     2168          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     2169          if  vv = ? then vv =  0 .
     2170           run rep/exfont.p (
     2171             input   temp-font.fontname ,
     2172             input   vv ,
     2173             input   temp-font.fonttype ,
     2174             output  temp-font.font-h   ,
     2175             output  temp-font.font-w   )
     2176           .
     2177       end.
     2178   find first temp-font where  temp-font.fontnum  = 7  .
     2179   old_H = temp-font.font-H .
     2180   old_w = temp-font.font-W .
     2181   old-row = temp-font.v-row .
     2182   old-col = temp-font.v-col .
     2183   old-row-lans = temp-font.v-row-lans .
     2184   old-col-lans = temp-font.v-col-lans .
     2185       for each temp-font where
     2186                temp-font.fontnum  <> 7 :
     2187           assign
     2188               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2189               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2190               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2191               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2192           .
     2193       end.
     2194     end.
     2195   end procedure.
     2196   PROCEDURE How-name :
     2197   define input  parameter h as integer no-undo .
     2198   define input  parameter w as integer no-undo .
     2199   define output parameter n as character  no-undo .
     2200   define variable A4port-H as integer   no-undo init 63.
     2201   define variable A4port-W as integer   no-undo init 136.
     2202   define variable A4lans-H as integer   no-undo init 43.
     2203   define variable A4lans-W as integer   no-undo init 198.
     2204   define variable Strim-W  as integer   no-undo init 278.
     2205   run define-a4-size (
     2206        input ReportFontNum
     2207       ,output A4port-H
     2208       ,output A4port-W
     2209       ,output A4lans-H
     2210       ,output A4lans-W ).
     2211   If w >= 1 and w <= A4port-W Then DO:
     2212     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2213     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2214     If h > A4port-H              Then n = "to-file":U.
     2215   End.
     2216   If w > A4port-W and w <= A4lans-W Then DO:
     2217     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2218     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2219     If h > A4port-H              Then n = "to-file":U.
     2220   End.
     2221   If w > A4lans-W and w <= Strim-W Then DO:
     2222     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2223     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2224     If h > A4port-H              Then n = "to-file":U.
     2225   End.
     2226   If w > Strim-W Then DO:
     2227      n = "to-file":U.
     2228   End.
     2229   END PROCEDURE.
     2230   PROCEDURE define-a4-size :
     2231   define input  parameter p-ReportFontNum as integer   no-undo .
     2232   define output parameter A4port-H as integer   no-undo .
     2233   define output parameter A4port-W as integer   no-undo .
     2234   define output parameter A4lans-H as integer   no-undo .
     2235   define output parameter A4lans-W as integer   no-undo .
     2236   if not can-find (first temp-font ) then do:
     2237      run get-font-ini .
     2238   end.
     2239   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2240   if available temp-font then do:
     2241   assign
     2242     A4port-H = temp-font.v-row
     2243     A4port-W = temp-font.v-col
     2244     A4lans-H = temp-font.v-row-lans
     2245     A4lans-W = temp-font.v-col-lans
     2246   .
     2247   end.
     2248   else do:
     2249   assign
     2250     A4port-H = 63
     2251     A4port-W = 136
     2252     A4lans-H = 43
     2253     A4lans-W = 198
     2254   .
     2255   end.
     2256   END PROCEDURE.
     2257   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2258   procedure factord :
     2259     define input  parameter p-fact-date            as date    no-undo .
     2260     define input  parameter p-fact-time            as integer no-undo .
     2261     define input  parameter p-fact-num             as integer no-undo .
     2262     define input  parameter p-shift-date           as date    no-undo .
     2263     define input  parameter p-shift-num            as integer no-undo .
     2264     define input  parameter p-shift-on             as logical no-undo .
     2265     define output parameter p-fact-order           as decimal no-undo .
     2266     define output parameter p-shift-end-fact-order as decimal no-undo .
     2267     define output parameter p-day-end-fact-order   as decimal no-undo .
     2268     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2269     if p-fact-date = ?
     2270     then do:
     2271       return error "Не указана фактическая дата" .
     2272     end.
     2273     define variable v-fact-date-num as integer no-undo .
     2274     assign
     2275       v-fact-date-num = integer(p-fact-date)
     2276     .
     2277     if p-fact-num = ?
     2278     or p-fact-num = 0
     2279     then do:
     2280       return error "Не задан p-fact-num " + string(p-fact-num) .
     2281     end.
     2282     if p-fact-num < 0
     2283     then do:
     2284       return error "Отрицательный fact-num " + string(p-fact-num) .
     2285     end.
     2286     if p-fact-num >= 100000000
     2287     then do:
     2288       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2289     end.
     2290     if p-shift-on = true
     2291     then do:
     2292       if p-shift-date = ?
     2293       then do:
     2294         return error "Не задана дата смены" .
     2295       end.
     2296       if p-shift-num = ?
     2297       or p-shift-num = 0
     2298       then do:
     2299         return error "Не задан номер смены" .
     2300       end.
     2301     end.
     2302     else do:
     2303       assign
     2304         p-shift-date = p-fact-date
     2305         p-shift-num  = 24
     2306       .
     2307     end.
     2308     define variable v-shift-offset as integer no-undo .
     2309     if p-shift-date = p-fact-date
     2310     then do:
     2311       assign
     2312         v-shift-offset = 1
     2313       .
     2314     end.
     2315     if p-shift-date < p-fact-date
     2316     then do:
     2317       assign
     2318         v-shift-offset = 0
     2319       .
     2320     end.
     2321     if p-shift-date > p-fact-date
     2322     then do:
     2323       message
     2324         vss-workfile vss-revision vss-description skip
     2325         "Неправильная дата закрытия смены" skip
     2326         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2327         view-as alert-box error .
     2328       undo, return error
     2329         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2330           ,string(p-fact-date, '99/99/9999':U)
     2331           ,string(p-shift-date, '99/99/9999':U)
     2332           )
     2333       .
     2334     end.
     2335     if p-shift-num < 1
     2336     or p-shift-num > 24
     2337     then do:
     2338       message
     2339         vss-workfile vss-revision vss-description skip
     2340         "Неправильный номер смены" skip
     2341         "p-shift-num" p-shift-num skip
     2342         view-as alert-box error .
     2343       undo, return error return-value .
     2344     end.
     2345     assign
     2346       p-fact-order           = v-fact-date-num
     2347                              + v-shift-offset * 0.5
     2348                              + p-shift-num    * 0.02 - 0.01
     2349                              + p-fact-num     * 0.0000000001
     2350       p-shift-end-fact-order = v-fact-date-num
     2351                              + v-shift-offset * 0.5
     2352                              + p-shift-num    * 0.02
     2353       p-day-end-fact-order   = v-fact-date-num
     2354                              + 0.99
     2355     .
     2356     if p-fact-order           <= v-fact-date-num
     2357     or p-shift-end-fact-order <= v-fact-date-num
     2358     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2359     or p-shift-end-fact-order >= p-day-end-fact-order
     2360     then do:
     2361       message
     2362         vss-workfile vss-revision vss-description skip
     2363         "Внутренняя ошибка при генерации фактического номера" skip
     2364         "p-fact-date"            p-fact-date            skip
     2365         "p-fact-time"            p-fact-time            skip
     2366         "p-fact-num"             p-fact-num             skip
     2367         "p-shift-date"           p-shift-date           skip
     2368         "p-shift-num"            p-shift-num            skip
     2369         "p-shift-on"             p-shift-on             skip
     2370         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2371         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2372         "v-fact-date-num"        v-fact-date-num        skip
     2373         view-as alert-box error .
     2374       undo, return error return-value .
     2375     end.
     2376   end procedure.
     2377   procedure day-begin-fact-order :
     2378     define input  parameter p-fact-date            as date    no-undo .
     2379     define output parameter p-day-begin-fact-order as decimal no-undo .
     2380     do
     2381     on error undo, return error return-value
     2382     :
     2383       if p-fact-date = ?
     2384       then do:
     2385         assign
     2386           p-day-begin-fact-order = 0
     2387         .
     2388       end.
     2389       else do:
     2390         assign
     2391           p-day-begin-fact-order = integer(p-fact-date)
     2392         .
     2393       end.
     2394     end.
     2395   end procedure.
     2396   procedure factord-max-fact-order :
     2397     define output parameter p-max-fact-order as decimal   no-undo .
     2398     do
     2399     on error undo, return error return-value
     2400     :
     2401       run day-begin-fact-order in this-procedure
     2402         (input  date(1, 1, 5000)
     2403         ,output p-max-fact-order
     2404         ) .
     2405     end.
     2406   end procedure.
     2407   procedure factord-cut-archive :
     2408     define input  parameter p-obj-type             as character no-undo .
     2409     define input  parameter p-obj-code             as integer   no-undo .
     2410     define input  parameter p-fact-date            as date      no-undo .
     2411     define output parameter p-shift-on             as logical   no-undo .
     2412     define output parameter p-shift-date           as date      no-undo .
     2413     define output parameter p-shift-num            as integer   no-undo .
     2414     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2415     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2416     define variable v-fact-order as decimal   no-undo .
     2417     define buffer buf_shift-obj for ub.shift-obj .
     2418     do
     2419     on error undo, return error return-value
     2420     :
     2421   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2423     (input  p-obj-type
     2424     ,input  p-obj-code
     2425     ,input  'shift-on=request'
     2426     ,output p-shift-on
     2427     ) no-error .
     2428       if error-status :error
     2429       then do:
     2430         message
     2431           vss-workfile vss-revision vss-description skip
     2432           "Ошибка при определении атрибута объекта" skip
     2433           "Объект" p-obj-type p-obj-code skip
     2434           error-status :get-message(1) skip
     2435           return-value skip
     2436           view-as alert-box error .
     2437         undo, return error return-value .
     2438       end.
     2439       if p-shift-on = false
     2440       then do:
     2441         assign
     2442           p-shift-date               = ?
     2443           p-shift-num                = 0
     2444         .
     2445       end.
     2446       else do:
     2447         find first buf_shift-obj share-lock
     2448           where buf_shift-obj.obj-type   = p-obj-type
     2449             and buf_shift-obj.obj-code   = p-obj-code
     2450             and buf_shift-obj.shift-date > p-fact-date
     2451           use-index pi
     2452           no-error .
     2453         if not available buf_shift-obj
     2454         or buf_shift-obj.status_ <> 'зкр':U
     2455         then do:
     2456           message
     2457             vss-workfile vss-revision vss-description skip
     2458             "Невозможно вычислить последнюю смену" skip
     2459             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2460             "Объект" p-obj-type p-obj-code skip
     2461             "Дата" p-fact-date skip
     2462             view-as alert-box error .
     2463           undo, return error return-value .
     2464         end.
     2465         find last buf_shift-obj share-lock
     2466           where buf_shift-obj.obj-type = p-obj-type
     2467             and buf_shift-obj.obj-code = p-obj-code
     2468             and buf_shift-obj.shift-date <= p-fact-date
     2469           use-index pi
     2470           no-error .
     2471         if available buf_shift-obj
     2472         then do:
     2473           if  buf_shift-obj.status_ = 'зкр':U
     2474           then do:
     2475             assign
     2476               p-shift-date = buf_shift-obj.shift-date
     2477               p-shift-num  = buf_shift-obj.shift-num
     2478             .
     2479           end.
     2480           else do:
     2481             message
     2482               vss-workfile vss-revision vss-description skip
     2483               "Невозможно вычислить последнюю смену" skip
     2484               "Статус смены отличен от статуса" 'зкр':U skip
     2485               "Объект" p-obj-type p-obj-code skip
     2486               "Дата" p-fact-date skip
     2487               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2488               view-as alert-box error .
     2489             undo, return error return-value .
     2490           end.
     2491         end.
     2492         else do:
     2493           assign
     2494             p-shift-date = p-fact-date - 1
     2495             p-shift-num  = 1
     2496           .
     2497         end.
     2498       end.
     2499       run factord in this-procedure
     2500         (input  p-fact-date
     2501         ,input  1
     2502         ,input  1
     2503         ,input  p-shift-date
     2504         ,input  p-shift-num
     2505         ,input  p-shift-on
     2506         ,output v-fact-order
     2507         ,output p-shift-end-fact-order
     2508         ,output p-day-end-fact-order
     2509         ) no-error .
     2510       if error-status :error
     2511       then do:
     2512         message
     2513           vss-workfile vss-revision vss-description skip
     2514           "Ошибка при вызове процедуры factord"
     2515           error-status :get-message(1) skip
     2516           return-value skip
     2517           view-as alert-box error .
     2518         undo, return error return-value .
     2519       end.
     2520     end.
     2521   end procedure.
     2522   procedure factord-lock-shift :
     2523     define input  parameter p-obj-type  as character no-undo .
     2524     define input  parameter p-obj-code  as integer   no-undo .
     2525     define input  parameter p-fact-date as date      no-undo .
     2526     define parameter buffer buf_shift-obj for ub.shift-obj .
     2527     define variable v-shift-on      as logical   no-undo .
     2528     define variable v-extra-message as character no-undo .
     2529     define variable v-error as character no-undo .
     2530     do
     2531     on error undo, return error return-value
     2532     :
     2533   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2534   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2535     (input  p-obj-type
     2536     ,input  p-obj-code
     2537     ,input  'shift-on=request'
     2538     ,output v-shift-on
     2539     ) no-error .
     2540       if error-status :error
     2541       then do:
     2542         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2543         undo, return error v-error .
     2544       end.
     2545       if v-shift-on = true
     2546       then do:
     2547         find first buf_shift-obj share-lock
     2548           where buf_shift-obj.obj-type   = p-obj-type
     2549             and buf_shift-obj.obj-code   = p-obj-code
     2550             and buf_shift-obj.shift-date > p-fact-date
     2551           use-index pi
     2552           no-error .
     2553         if not available buf_shift-obj
     2554         or buf_shift-obj.status_ <> 'зкр':U
     2555         then do:
     2556           find last buf_shift-obj
     2557             where buf_shift-obj.obj-type = p-obj-type
     2558               and buf_shift-obj.obj-code = p-obj-code
     2559               and buf_shift-obj.status_  = 'зкр':U
     2560             use-index stts
     2561             no-error .
     2562           if available buf_shift-obj
     2563           then do:
     2564             assign
     2565               v-extra-message =
     2566                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2567                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2568                               )
     2569             .
     2570           end.
     2571           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2572           undo, return error v-error .
     2573         end.
     2574       end.
     2575     end.
     2576   end procedure.
     2577   procedure factord-end-day :
     2578     define input  parameter p-fact-date            as date    no-undo .
     2579     define output parameter p-day-end-fact-order   as decimal no-undo .
     2580     do
     2581     on error undo, return error return-value
     2582     :
     2583       if p-fact-date = ?
     2584       then do:
     2585         return error "Не указана фактическая дата" .
     2586       end.
     2587       assign
     2588         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2589       .
     2590     end.
     2591   end procedure.
     2592   procedure factord-to-date :
     2593     define input  parameter p-fact-order as decimal no-undo .
     2594     define output parameter p-fact-date  as date    no-undo .
     2595     define variable v-ref-date  as date      no-undo .
     2596     define variable v-ref-delta as integer   no-undo .
     2597     do
     2598     on error undo, return error return-value
     2599     :
     2600       if p-fact-order = ?
     2601       or p-fact-order = 0
     2602       then do:
     2603         return error "Не указан fact-order" .
     2604       end.
     2605       assign
     2606         v-ref-date  = date(1, 1, 2000)
     2607       .
     2608       assign
     2609         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2610       .
     2611       assign
     2612         p-fact-date = v-ref-date + v-ref-delta
     2613       .
     2614     end.
     2615   end procedure.
     2616   procedure factord-to-fact-num :
     2617     define input  parameter p-fact-order as decimal no-undo .
     2618     define output parameter p-fact-num   as integer no-undo .
     2619     define variable v-fact-order-trunc as decimal no-undo .
     2620     do
     2621     on error undo, return error return-value
     2622     :
     2623       if p-fact-order = ?
     2624       or p-fact-order = 0
     2625       then do:
     2626         return error "Не указан fact-order" .
     2627       end.
     2628       assign
     2629        v-fact-order-trunc = truncate(p-fact-order, 2)
     2630       .
     2631       assign
     2632         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2633       .
     2634     end.
     2635   end procedure.
     2636   procedure factord-to-shift-num :
     2637     define input  parameter p-fact-order as decimal no-undo .
     2638     define output parameter p-shift-num   as integer no-undo .
     2639     define variable  p-shift-numd  as decimal   no-undo .
     2640     define variable v-fact-order-trunc as decimal no-undo .
     2641     do
     2642     on error undo, return error return-value
     2643     :
     2644       if p-fact-order = ?
     2645       or p-fact-order = 0
     2646       then do:
     2647         return error "Не указан fact-order" .
     2648       end.
     2649       assign
     2650        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2651       .
     2652       if v-fact-order-trunc < 0.5 then do:
     2653         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2654       end.
     2655       assign
     2656         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2657         .
     2658        assign
     2659         p-shift-num = truncate (p-shift-numd , 0)
     2660       .
     2661     end.
     2662   end procedure.
