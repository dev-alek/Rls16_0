     5094       else do:
     5095                   run macr_excel_dec in this-procedure (input itog-all-qnty, input num#str#, input num#col# ) .
     5096                   run macr_cell_format in this-procedure
     5097                     (input 10
     5098                     ,input true
     5099                     ,input false
     5100                     ,input ?
     5101                     ,input num#str#
     5102                     ,input num#col#
     5103                     ,input ?
     5104                     ,input ?
     5105                     ) .
     5106                   num#col# = num#col# + 1.
     5107                   run macr_excel_dec in this-procedure (input string(itog-sale-sum-rubl-all, "->>>>>>>>9.99"), input num#str#, input num#col# ) .
     5108                   run macr_cell_format in this-procedure
     5109                     (input 10
     5110                     ,input true
     5111                     ,input false
     5112                     ,input ?
     5113                     ,input num#str#
     5114                     ,input num#col#
     5115                     ,input ?
     5116                     ,input ?
     5117                     ) .
     5118                   num#col# = num#col# + 1.
     5119                   num#str# = num#str# + 1.
     5120       end.
     5121     end.
     5122     else do:
     5123       if show-cost = true then do:
     5124                   run macr_excel_dec in this-procedure (input itog-all-qnty, input num#str#, input num#col# ) .
     5125                   run macr_cell_format in this-procedure
     5126                     (input 10
     5127                     ,input true
     5128                     ,input false
     5129                     ,input ?
     5130                     ,input num#str#
     5131                     ,input num#col#
     5132                     ,input ?
     5133                     ,input ?
     5134                     ) .
     5135                   num#col# = num#col# + 1.
     5136                   run macr_excel_dec in this-procedure (input string(itog-cost-sum-base-all, "->>>>>>>>9.99"), input num#str#, input num#col# ) .
     5137                   run macr_cell_format in this-procedure
     5138                     (input 10
     5139                     ,input true
     5140                     ,input false
     5141                     ,input ?
     5142                     ,input num#str#
     5143                     ,input num#col#
     5144                     ,input ?
     5145                     ,input ?
     5146                     ) .
     5147                   num#col# = num#col# + 1.
     5148                   num#str# = num#str# + 1.
     5149       end.
     5150       else do:
     5151                   run macr_excel_dec in this-procedure (input itog-all-qnty, input num#str#, input num#col# ) .
     5152                   run macr_cell_format in this-procedure
     5153                     (input 10
     5154                     ,input true
     5155                     ,input false
     5156                     ,input ?
     5157                     ,input num#str#
     5158                     ,input num#col#
     5159                     ,input ?
     5160                     ,input ?
     5161                     ) .
     5162                   num#col# = num#col# + 1.
     5163                   run macr_excel_dec in this-procedure (input string(itog-sale-sum-base-all, "->>>>>>>>9.99"), input num#str#, input num#col# ) .
     5164                   run macr_cell_format in this-procedure
     5165                     (input 10
     5166                     ,input true
     5167                     ,input false
     5168                     ,input ?
     5169                     ,input num#str#
     5170                     ,input num#col#
     5171                     ,input ?
     5172                     ,input ?
     5173                     ) .
     5174                   num#col# = num#col# + 1.
     5175                   num#str# = num#str# + 1.
     5176       end.
     5177   end.
     5178   hide   stream outstream frame obcntr .
     5179   output stream outstream close.
     5180   run waitfram-hide in this-procedure .
     5181   Output stream Macr_Excel  close .
     5182   run paramls-write in this-procedure
     5183     (input  "file"
     5184     ,input  string(v-file-name-ind)
     5185     ,input  v-file-name
     5186     ) .
     5187   run end-proc in this-procedure .
     5188   run gbl/prnfilen.w
     5189            ( input  ""
     5190            , input  8
     5191            , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     5192            , input  ReportFontNum
     5193            , output v-user-action
     5194            , output v-printed
     5195            ) .
     5196     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     5197   end procedure .
     5198   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5199   procedure macr_excel_char :
     5200    do
     5201    on error undo, return error return-value
     5202    :
     5203    define input parameter  p-val as character no-undo .
     5204    define input parameter  p-row as integer no-undo .
     5205    define input parameter  p-col as integer no-undo .
     5206    if p-val = ? then p-val = "" .
     5207       put stream macr_excel unformatted
     5208             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5209    end.
     5210   end procedure.
     5211   procedure macr_excel_char_with_format :
     5212    do
     5213    on error undo, return error return-value
     5214    :
     5215    define input parameter  p-val as character no-undo .
     5216    define input parameter  p-row as integer no-undo .
     5217    define input parameter  p-col as integer no-undo .
     5218    if p-val = ? then p-val = "" .
     5219       put stream macr_excel unformatted
     5220             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     5221       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     5222       put stream macr_excel unformatted
     5223             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5224    end.
     5225   end procedure.
     5226   procedure macr_excel_cell_format :
     5227    do
     5228    on error undo, return error return-value
     5229    :
     5230    define input parameter  p-val    as character no-undo .
     5231    define input parameter  p-row    as integer   no-undo .
     5232    define input parameter  p-col    as integer   no-undo .
     5233    define input parameter  p-format as character no-undo .
     5234    if p-val = ? then p-val = "" .
     5235       put stream macr_excel unformatted
     5236             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     5237       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     5238       put stream macr_excel unformatted
     5239             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     5240    end.
     5241   end procedure.
     5242   procedure macr_excel_sum :
     5243    do
     5244    on error undo, return error return-value
     5245    :
     5246    define input parameter  p-row as integer no-undo .
     5247    define input parameter  p-col as integer no-undo .
     5248    define input parameter  p-row1 as integer no-undo .
     5249    define input parameter  p-col1 as integer no-undo .
     5250    define input parameter  p-row2 as integer no-undo .
     5251    define input parameter  p-col2 as integer no-undo .
     5252       put stream macr_excel unformatted
     5253             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     5254    end.
     5255   end procedure.
     5256   procedure macr_excel_dec :
     5257    do
     5258    on error undo, return error return-value
     5259    :
     5260    define input parameter  p-val as character no-undo .
     5261    define input parameter  p-row as integer   no-undo .
     5262    define input parameter  p-col as integer   no-undo .
     5263     if p-val = ? then p-val =  "" .
     5264      put  stream macr_excel unformatted
     5265           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     5266    end.
     5267   end procedure.
     5268   procedure macr_cell_format :
     5269    do
     5270    on error undo, return error return-value
     5271    :
     5272    define input parameter  p-size   as integer   no-undo .
     5273    define input parameter  p-bold   as logical   no-undo .
     5274    define input parameter  p-italic as logical   no-undo .
     5275    define input parameter  p-color  as integer   no-undo .
     5276    define input parameter  p-row    as integer   no-undo .
     5277    define input parameter  p-col    as integer   no-undo .
     5278    define input parameter  p-row-2  as integer   no-undo .
     5279    define input parameter  p-col-2  as integer   no-undo .
     5280     if p-size = ? then p-size = 10 .
     5281     if p-bold = ? then p-bold = false .
     5282     if p-italic = ? then p-italic = false .
     5283     if p-row-2 = ? then p-row-2 = p-row .
     5284     if p-col-2 = ? then p-col-2 = p-col .
     5285     put  stream macr_excel unformatted
     5286      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     5287     if p-color <> ? then do:
     5288        put  stream macr_excel unformatted
     5289          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     5290     end.
     5291     put  stream macr_excel unformatted
     5292          substitute('format.font(,&1,&2,&3)' , p-size,
     5293                                           string ( p-bold  , "true/false" ) ,
     5294                                           string ( p-italic , "true/false" )
     5295                                           ) + chr(10) .
     5296    end.
     5297   end procedure.
     5298   procedure macr_cell_size :
     5299    do
     5300    on error undo, return error return-value
     5301    :
     5302    define input parameter  p-w   as integer   no-undo .
     5303    define input parameter  p-l   as integer   no-undo .
     5304    define input parameter  p-row    as integer   no-undo .
     5305    define input parameter  p-col    as integer   no-undo .
     5306    define input parameter  p-row-2  as integer   no-undo .
     5307    define input parameter  p-col-2  as integer   no-undo .
     5308     if p-row-2 = ? then p-row-2 = p-row .
     5309     if p-col-2 = ? then p-col-2 = p-col .
     5310     if p-w = ? then    p-w = 0 .
     5311     if p-l = ? then    p-l = 0 .
     5312    define variable s-w as character no-undo .
     5313    define variable s-l as character no-undo .
     5314    if p-w = 0 then s-w = "" .
     5315               else s-w = string(p-w)  .
     5316    if p-l = 0 then s-l = "" .
     5317               else s-l = string(p-l)  .
     5318   put  stream macr_excel unformatted
     5319        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     5320   put  stream macr_excel unformatted
     5321        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     5322   put  stream macr_excel unformatted
     5323        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     5324    end.
     5325   end procedure.
     5326   procedure proc-print-header :
     5327    do
     5328    on error undo, return error return-value
     5329    :
     5330      find first sheetf .
     5331        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     5332        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     5333        var-1 =  num#str# .
     5334        repeat c-c = 1 to sheetf.excel-row-title :
     5335        num#str# = num#str# + 1 .
     5336        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     5337        do c-i = 1 to p-var :
     5338           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     5339           str--2 = integer(entry( c-i, sheetf.sizes )) .
     5340           num#col# = c-i .
     5341           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     5342           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     5343        end.
     5344       c-i = 0.
     5345       end.
     5346       run macr_cell_format (
     5347           10       ,
     5348           true     ,
     5349           false    ,
     5350           35       ,
     5351           var-1 + 1,
     5352           1        ,
     5353           num#str# ,
     5354           num#col# )
     5355           .
     5356     put  stream macr_excel unformatted
     5357          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     5358          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     5359          .
     5360    end.
     5361   end procedure.
     5362   procedure end-proc :
     5363    do
     5364    on error undo, return error return-value
     5365    :
     5366     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     5367     OUTPUT to VALUE (v-file-name) .
     5368     for each temp-param :
     5369       export  temp-param  .
     5370     end.
     5371    end.
     5372   end procedure.
