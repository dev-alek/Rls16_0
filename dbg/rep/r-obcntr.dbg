     3196             buy-data.sale-sum-base-ras  =  buy-data.sale-sum-base-ras + abs(buf_ot-line.sum-base)
     3197           .
     3198         end.
     3199       end.
     3200       find first buf_ot-line
     3201         where buf_ot-line.doc-code     = buf_trn-doc.doc-code
     3202           and buf_ot-line.artic        = buf_doc-line.artic
     3203           and buf_ot-line.prod-type    = buf_doc-line.prod-type
