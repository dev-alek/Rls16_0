      786   function get-user-login returns character
      787     ( p-user-id as character ) :
      788     define variable v-user-login as character no-undo .
      789     run procedure-get-user-login in this-procedure (
      790         input p-user-id
      791       , output v-user-login
      792     ) .
      793     return v-user-login .
      794   end function.
      795   procedure procedure-get-user-login :
      796   define input  parameter p-user-id    as character no-undo .
      797   define output parameter p-user-login as character no-undo .
      798       define buffer buf_user-login for ub.user-login .
      799   do
      800   for buf_user-login
      801   on error undo, return error return-value
      802   :
      803       assign
      804           p-user-login = "":U
      805       .
      806       for each buf_user-login no-lock
      807          where buf_user-login.user-id = p-user-id
      808       by buf_user-login.db-num
      809       :
      810           assign
      811               p-user-login = substitute( "&1&2&3"
      812                                   , p-user-login
      813                                   , ( if p-user-login = "":U then "":U else ",":U )
      814                                   , buf_user-login.db-num )
      815           .
      816       end.
      817   end.
      818   end procedure.
      819   procedure SetAttrUserId:
      820      define input  parameter iDb-num      as integer   no-undo.
      821      define input  parameter iUserId      as character no-undo.
      822      define input  parameter iAttrCode    as character no-undo.
      823      define input  parameter iAttrValue   as character no-undo.
      824      define buffer user-login-attr  for ub.user-login-attr .
      825      find first user-login-attr where user-login-attr.db-num    eq idb-num
      826                                   and user-login-attr.user-id   eq iuserid
      827                                   and user-login-attr.attr-code eq iAttrCode
      828      exclusive-lock no-error.
      829      if     not available user-login-attr
      830         and iAttrValue ne ?
      831      then do:
      832         create user-login-attr.
      833         assign
      834            user-login-attr.db-num     = idb-num
      835            user-login-attr.user-id    = iuserid
      836            user-login-attr.attr-code  = iAttrCode
      837         .
      838      end.
      839      if iAttrValue eq ?
      840      then do:
      841         if available ub.user-login-attr
      842         then
      843            delete ub.user-login-attr.
      844      end.
      845      else
      846         user-login-attr.attr-value = iAttrValue.
      847   end procedure.
      848   function GetAttrUserId returns character (
      849      input iDb-num      as integer  ,
      850      input iUserId      as character,
      851      input iAttrCode    as character):
      852      define buffer user-login-attr  for ub.user-login-attr .
      853      find first user-login-attr where user-login-attr.db-num    eq idb-num
      854                                   and user-login-attr.user-id   eq iuserid
      855                                   and user-login-attr.attr-code eq iAttrCode
      856      no-lock no-error.
      857      return if not available ub.user-login-attr then ? else ub.user-login-attr.attr-value.
      858   end function.
      859   procedure getAccountSetting :
      860      define input  parameter i-user-id  as character no-undo.
      861      define output parameter o-adm-Ubd  as logical no-undo init ?.
      862      define output parameter v-adm-GBD  as logical no-undo.
      863      define output parameter o-superAdm as logical no-undo.
      864      define input-output parameter table for UserDbAdm .
      865      define variable v-adm-Ubd-int as integer no-undo.
      866      define buffer user-login for ub.user-login.
      867      define buffer db         for ub.db.
      868      define buffer user-account-attr for ub.user-account-attr.
      869      find first user-login where user-login.db-num  eq 0
      870                              and user-login.user-id eq i-user-id
      871      no-lock no-error.
      872      if available user-login
      873      then
      874         v-adm-gbd = user-login.user-administrator.
      875      else
      876         v-adm-gbd = ?.
      877      for each userDbAdm:
      878         delete userDbAdm.
      879      end.
      880      block-db:
      881      for each db where db.db-num ne 0 no-lock:
      882         if G#db-num ne 0
      883            and G#db-num ne db.db-num
      884         then
      885            next block-db.
      886         create UserDbAdm.
      887         UserDbAdm.db-num = ub.db.db-num.
      888         find first user-login where user-login.db-num  eq db.db-num
      889                                 and user-login.user-id eq i-user-id
      890         no-lock no-error.
      891         if not available user-login
      892         then
      893            v-adm-Ubd-int = 2.
      894         else if user-login.status_ eq 1
      895         then do:
      896            v-adm-Ubd-int = 2.
      897             UserDbAdm.db-block = yes.
      898             UserDbAdm.db-usr   = yes.
      899         end.
      900         else if user-login.user-administrator
      901         then do:
      902            UserDbAdm.db-adm = yes.
      903            UserDbAdm.db-usr = yes.
      904            if v-adm-Ubd-int eq 0
      905            then
      906               v-adm-Ubd-int = 1.
      907            else if v-adm-Ubd-int eq 3
      908            then do:
      909               v-adm-Ubd-int = 2.
      910            end.
      911         end.
      912         else do:
      913            if available ub.user-login
      914            then
      915               UserDbAdm.db-usr = yes.
      916            if v-adm-Ubd-int eq 0
      917            then
      918               v-adm-Ubd-int = 3.
      919            else if v-adm-Ubd-int eq 1
      920            then do:
      921               v-adm-Ubd-int = 2.
      922            end.
      923         end.
      924      end.
      925      if  v-adm-Ubd-int eq 1
      926      then
      927         o-adm-Ubd = true.
      928      else if v-adm-Ubd-int eq 3
      929      then
      930         o-adm-Ubd = false.
      931      find first user-account-attr where user-account-attr.user-id  eq i-user-id
      932                                     and user-account-attr.attr-code  eq "superADm"
      933      no-lock no-error.
      934      o-superAdm =  available user-account-attr and logical (user-account-attr.attr-value ) no-error.
      935   end.
      936   function check_alphanumeric returns character (
      937   input ipwd as character ,
      938   input itype as character ):
      939      define variable vCharEng as character no-undo
      940      init "abcdefghijklmnopqrstuvwxyz".
      941      define variable vCharRus as character no-undo
      942      init "йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЯЧСМИТЬБЮЁЭ".
      943      define variable vi as integer no-undo.
      944      define variable vdigitFl as logical no-undo.
      945      define variable vCharEngFl as logical no-undo.
      946      define variable vCharRusFl as logical no-undo.
      947      define variable vCharSpeFl as logical no-undo.
      948      define variable vTextNew as character no-undo.
      949      define variable vTextOld as character no-undo.
      950      vTextNew = ipwd.
      951      vTextOld = vTextNew.
      952      do vi = 0 to 9:
      953         vTextNew = replace(vTextNew,string (vi),"").
      954      end.
      955      if length(vTextOld) ne length(vTextNew)
      956      then
      957         vdigitFL = yes.
      958      vTextOld = vTextNew.
      959      do vi = 1 to length(vCharEng):
      960         vTextNew = replace(vtextNew,substring(vCharEng,vi,1),"").
      961      end.
      962      if length(vTextOld) ne length(vTextNew)
      963      then
      964         vCharEngFl = yes.
      965      vTextOld = vTextNew.
      966      do vi = 1 to length(vCharRus):
      967         vTextNew = replace(vtextNew,substring(vCharRus,vi,1),"").
      968      end.
      969      if length(vTextOld) ne length(vTextNew)
      970      then
      971         vCharEngFl = yes.
      972      if length(vTextNew) > 0
      973      then
      974         vCharSpeFl = yes.
      975      define variable vReturn as character no-undo.
      976      assign
      977         vReturn = vReturn + ", " + "не содержит цифр"           when lookup ("digit",   itype) > 0 and not vdigitFl
      978         vReturn = vReturn + ", " + "не содержит латинских букв" when lookup ("CharEng", itype) > 0 and not vCharEngFl
      979         vReturn = vReturn + ", " + "не содержит русских букв"   when lookup ("CharRus", itype) > 0 and not vCharRusFl
      980         vReturn = vReturn + ", " + "не содержит спец символов"  when lookup ("CharSpe", itype) > 0 and not vCharSpeFl
      981         vReturn = vReturn + ", " + "не содержит символов"       when lookup ("Char",    itype) > 0 and not (vCharEngFl or vCharRusFl or vCharSpeFl)
      982      .
      983      vReturn = substring (vReturn,3) no-error.
      984      return vReturn.
      985   end.
      986   procedure SaveLastPWD:
      987      define input  parameter iDb-num as integer   no-undo.
      988      define input  parameter iUserId as character no-undo.
      989      define input  parameter IPWD    as character no-undo.
      990      define buffer user-login-attr  for ub.user-login-attr .
      991      find first user-login-attr where user-login-attr.db-num    eq idb-num
      992                                   and user-login-attr.user-id   eq iuserid
      993                                   and user-login-attr.attr-code eq "LastPWD"
      994      exclusive-lock no-error.
      995      if not available user-login-attr
      996      then do:
      997         create user-login-attr.
      998         assign
      999            user-login-attr.db-num     = idb-num
     1000            user-login-attr.user-id    = iuserid
     1001            user-login-attr.attr-code  = "LastPWD"
     1002            user-login-attr.attr-value = ipwd
     1003         .
     1004      end.
     1005      else do:
     1006         user-login-attr.attr-value = user-login.user-password-encoded + chr(5) + user-login-attr.attr-value .
     1007         if num-entries (user-login-attr.attr-value , chr(5)) > 50
     1008         then
     1009            user-login-attr.attr-value = substring (user-login-attr.attr-value,1,r-index(user-login-attr.attr-value, chr(5)) - 1).
     1010      end.
     1011   end procedure.
     1012   function  CheckLastPWD returns character  (
     1013      input  iDb-num    as integer  ,
     1014      input  iUserId    as character,
     1015      input  IPWD       as character,
     1016      input  Iadm       as logical ) :
     1017      define buffer user-login       for ub.user-login .
     1018      define buffer user-login-attr  for ub.user-login-attr .
     1019      define variable vError as character  no-undo.
     1020      define variable v-obyznumbukv as logical no-undo .
     1021      define variable v-minparol as integer no-undo .
     1022      define variable v-tth as handle no-undo .
     1023      define variable VadmSuff as character no-undo.
     1024      define variable v-param-type as character no-undo .
     1025      define variable v-value-character as character no-undo .
     1026      define variable v-value-date as date no-undo .
     1027      define variable v-value-decimal as decimal no-undo .
     1028      define variable v-value-integer as integer no-undo .
     1029      define variable v-value-logical as logical no-undo .
     1030      find first user-login where user-login.db-num    eq idb-num
     1031                              and user-login.user-id   eq iUserId
     1032      no-lock no-error.
     1033      if Iadm
     1034      then
     1035         VadmSuff = 'Adm':U.
     1036      run adm/shattri.p (
     1037           input "get":U
     1038           ,input  '':U
     1039           ,input  0
     1040           ,input  'staff':U
     1041           ,input  'minparol':U + VadmSuff
     1042           ,output v-value-character
     1043           ,output v-value-date
     1044           ,output v-value-decimal
     1045           ,output v-minparol
     1046           ,output v-value-logical
     1047           ,output v-param-type
     1048           ,input-output table-handle v-tth
     1049           )  .
     1050       if v-minparol <> 0  then do:
     1051          if length(ipwd) < v-minparol
     1052           then do:
     1053              vError = substitute ("Длина поля должна быть не менее &1" , v-minparol).
     1054           end.
     1055       end.
     1056       run adm/shattri.p (
     1057           input "get":U
     1058           ,input  '':U
     1059           ,input  0
     1060           ,input  'staff':U
     1061           ,input  'obyznumbukv':U + VadmSuff
     1062           ,output v-value-character
     1063           ,output v-value-date
     1064           ,output v-value-decimal
     1065           ,output v-value-integer
     1066           ,output v-obyznumbukv
     1067           ,output v-param-type
     1068           ,input-output table-handle v-tth
     1069           )  .
     1070      if v-obyznumbukv = true
     1071      then do:
     1072         if check_alphanumeric(ipwd,"Digit,Char") ne ""
     1073         then do:
     1074            vError = vError + (if vError eq "" then "" else ", " )
     1075                   + "В пароле должны содержаться буквы и цифры".
     1076         end.
     1077      end.
     1078      define variable v-encode-value as character no-undo.
     1079      define variable v-Lastpaswd    as integer no-undo.
     1080      run adm/pswd-enc.p
     1081         (input  encode(ipwd)
     1082         ,output v-encode-value
     1083         ).
     1084      v-encode-value = encode(v-encode-value).
     1085      run adm/shattri.p (
     1086           input "get":U
     1087           ,input  '':U
     1088           ,input  0
     1089           ,input  'staff':U
     1090           ,input  'LastPaswd':U + VadmSuff
     1091           ,output v-value-character
     1092           ,output v-value-date
     1093           ,output v-value-decimal
     1094           ,output v-Lastpaswd
     1095           ,output v-value-logical
     1096           ,output v-param-type
     1097           ,input-output table-handle v-tth
     1098           )  .
     1099      if v-Lastpaswd ne 0
     1100      then do:
     1101         define variable vLastPwd as character no-undo.
     1102         vLastPwd = GetAttrUserId(iDb-num, iUserId, "LastPWD").
     1103         if vLastPwd ne ?
     1104         then do:
     1105            define variable Vi as integer no-undo.
     1106            vi = lookup (v-encode-value,vLastPwd,chr(5)).
     1107            if     vi ne 0
     1108               and vi le v-Lastpaswd
     1109            then
     1110               vError = vError + (if vError eq "" then "" else ", " )
     1111                      + substitute ("пароль не должен совпадать с последими &1 паролями",v-Lastpaswd).
     1112         end.
     1113      end.
     1114      delete object v-tth.
     1115      return vError.
     1116   end function.
     1117   procedure availOneAdm:
     1118      define input-output parameter table for UserDbAdm.
     1119      define output parameter oAdm as logical no-undo.
     1120      find first UserDbAdm where UserDbAdm.db-adm no-lock no-error.
     1121      oadm = available UserDbAdm.
     1122   end.
     1123   procedure update-user-login:
     1124      define input  parameter i-db-num     as integer          no-undo.
     1125      define input  parameter i-user-id    as character        no-undo.
     1126      define input  parameter i-user-login as character no-undo.
     1127      define input  parameter i-max-discnt as decimal no-undo.
     1128      define input  parameter i-quest-print as logical no-undo.
     1129      define input  parameter i-encoded-pass as character no-undo.
     1130      define input  parameter i-nextcon as logical no-undo.
     1131      define input  parameter i-user-administrator as logical no-undo.
     1132      define input  parameter i-Manual     as logical no-undo.
     1133      define input  parameter i-adm-gbd as logical no-undo.
     1134      define input  parameter i-adm-ubd as logical no-undo.
     1135      define input-output parameter table for UserDbAdm.
     1136      define buffer buf_user-login        for user-login.
     1137      do
     1138   for buf_user-login
     1139   on error undo, return error
     1140   :
     1141           if     i-Manual
     1142              and G#db-num eq 0
     1143           then do:
     1144              if     i-adm-gbd ne ?
     1145              then do:
     1146                 do transaction
     1147                 on error undo, return error return-value
     1148                 :
     1149                     find first buf_user-login where buf_user-login.db-num             eq 0
     1150                                                 and buf_user-login.user-login         eq i-user-login
     1151                                                 and buf_user-login.status_            eq 0
     1152                                                 and buf_user-login.user-id            ne i-user-id
     1153                     no-lock no-error.
     1154                     if available buf_user-login
     1155                     then
     1156                        undo, return error "Уже есть такой логин в ГБД".
     1157                     find first buf_user-login where buf_user-login.db-num             = 0
     1158                                                 and buf_user-login.user-id            = i-user-id
     1159                     exclusive-lock no-error.
     1160                     if not available buf_user-login
     1161                     then do:
     1162                        create buf_user-login .
     1163                        assign
     1164                            buf_user-login.db-num             = 0
     1165                            buf_user-login.user-id            = i-user-id
     1166                            buf_user-login.status_            = 0
     1167                        .
     1168                     end.
     1169                     assign
     1170                         buf_user-login.user-login         = i-user-login
     1171                         buf_user-login.user-administrator = i-adm-gbd
     1172                         buf_user-login.max-discnt         = i-max-discnt
     1173                         buf_user-login.quest-print        = i-quest-print
     1174                         buf_user-login.user-password-encoded = i-encoded-pass
     1175                     .
     1176                     if i-nextcon ne ?
     1177                     then do:
     1178                        run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1179                     end.
     1180                     run addobj(buf_user-login.db-num,buf_user-login.user-id) no-error.
     1181                     if error-status:error
     1182                     then
     1183                        return error return-value.
     1184                 end.
     1185              end.
     1186              else do transaction on error undo, return error return-value:
     1187                  find first buf_user-login where buf_user-login.db-num             = 0
     1188                                              and buf_user-login.user-id            = i-user-id
     1189                  exclusive-lock no-error.
     1190                  if available buf_user-login
     1191                  then
     1192                     delete buf_user-login.
     1193              end.
     1194              if     i-adm-ubd ne ?
     1195              then do:
     1196                 do transaction
     1197                 on error undo, return error return-value
     1198                 :
     1199                     define variable vDbError as character no-undo.
     1200                     block-db:
     1201                     for each db where db.db-num ne 0
     1202                     no-lock:
     1203                        find first buf_user-login where buf_user-login.db-num             eq db.db-num
     1204                                                    and buf_user-login.user-login         eq i-user-login
     1205                                                    and buf_user-login.status_            eq 0
     1206                                                    and buf_user-login.user-id            ne i-user-id
     1207                        no-lock no-error.
     1208                        if available buf_user-login
     1209                        then do:
     1210                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1211                           next block-db.
     1212                        end.
     1213                        find first buf_user-login where buf_user-login.db-num             = db.db-num
     1214                                                    and buf_user-login.user-id            = i-user-id
     1215                        exclusive-lock no-error.
     1216                        if not available buf_user-login
     1217                        then do:
     1218                           create buf_user-login .
     1219                           assign
     1220                               buf_user-login.db-num             = db.db-num
     1221                               buf_user-login.user-id            = i-user-id
     1222                               buf_user-login.status_            = 0
     1223                               buf_user-login.user-password-encoded = i-encoded-pass
     1224                           .
     1225                        end.
     1226                        assign
     1227                            buf_user-login.status_            = 0 when i-db-num ne G#db-num
     1228                            buf_user-login.user-login         = i-user-login
     1229                            buf_user-login.user-administrator = i-adm-ubd
     1230                            buf_user-login.max-discnt         = i-max-discnt
     1231                            buf_user-login.quest-print        = i-quest-print
     1232                        .
     1233                        if i-nextcon ne ?
     1234                        then do:
     1235                           run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1236                        end.
     1237                        run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1238                        if error-status:error
     1239                        then
     1240                           return error return-value.
     1241                    end.
     1242                    if vDbError ne ""
     1243                    then
     1244                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1245                 end.
     1246              end.
     1247              else do:
     1248                 do transaction
     1249                 on error undo, return error return-value
     1250                 :
     1251                     block-UserDb:
     1252                     for each UserDbAdm where UserDbAdm.db-num ne 0
     1253                     no-lock:
     1254                        find first buf_user-login where buf_user-login.db-num             eq UserDbAdm.db-num
     1255                                                    and buf_user-login.user-login         eq i-user-login
     1256                                                    and buf_user-login.status_            eq 0
     1257                                                    and buf_user-login.user-id            ne i-user-id
     1258                        no-lock no-error.
     1259                        if available buf_user-login and UserDbAdm.db-usr
     1260                        then do:
     1261                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1262                           next block-UserDb.
     1263                        end.
     1264                        find first buf_user-login where buf_user-login.db-num             = UserDbAdm.db-num
     1265                                                    and buf_user-login.user-id            = i-user-id
     1266                        exclusive-lock no-error.
     1267                        if UserDbAdm.db-usr
     1268                        then do:
     1269                           if not available buf_user-login
     1270                           then do:
     1271                              create buf_user-login .
     1272                              assign
     1273                                  buf_user-login.db-num             = UserDbAdm.db-num
     1274                                  buf_user-login.user-id            = i-user-id
     1275                                  buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0
     1276                                  buf_user-login.user-password-encoded = i-encoded-pass
     1277                              .
     1278                           end.
     1279                           assign
     1280                               buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0 when i-db-num ne G#db-num or G#db-num = 0
     1281                               buf_user-login.user-login         = i-user-login
     1282                               buf_user-login.user-administrator = UserDbAdm.db-adm
     1283                               buf_user-login.max-discnt         = i-max-discnt
     1284                               buf_user-login.quest-print        = i-quest-print
     1285                           .
     1286                           if i-nextcon ne ?
     1287                           then do:
     1288                              run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1289                           end.
     1290                           if UserDbAdm.db-adm
     1291                           then do:
     1292                              run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1293                              if error-status:error
     1294                              then
     1295                                 undo, return error return-value.
     1296                           end.
     1297                       end.
     1298                       else do:
     1299                          if available buf_user-login
     1300                          then do:
     1301                             define variable vok as logical no-undo.
     1302                             run procedure-user-login-delete-question (UserDbAdm.db-num,i-user-id, no, output vok).
     1303                             if not vok
     1304                             then
     1305                                undo, return error return-value.
     1306                          end.
     1307                       end.
     1308                    end.
     1309                     if vDbError ne ""
     1310                     then
     1311                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1312                 end.
     1313              end.
     1314           end.
     1315           else do transaction
     1316           on error undo, return error return-value
     1317           :
     1318              find first buf_user-login where buf_user-login.db-num             = i-db-num
     1319                                          and buf_user-login.user-id            = i-user-id
     1320              exclusive-lock no-error.
     1321              if not available buf_user-login
     1322              then do:
     1323                 create buf_user-login .
     1324                 assign
     1325                    buf_user-login.db-num             = i-db-num
     1326                    buf_user-login.user-id            = i-user-id
     1327                    buf_user-login.status_            = 0
     1328                 .
     1329              end.
     1330              assign
     1331                   buf_user-login.user-login         = i-user-login
     1332                   buf_user-login.user-administrator = i-user-administrator
     1333                   buf_user-login.max-discnt         = i-max-discnt
     1334                   buf_user-login.quest-print        = i-quest-print
     1335                   buf_user-login.user-password-encoded = i-encoded-pass
     1336               .
     1337               if i-user-administrator
     1338               then
     1339                  run addobj(buf_user-login.db-num,buf_user-login.user-id).
     1340               if i-nextcon ne ?
     1341               then do:
     1342                  run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1343               end.
     1344           end.
     1345       end.
     1346   end procedure.
     1347   procedure addobj:
     1348      define input  parameter i-db-num as integer no-undo.
     1349      define input  parameter i-user-id as character no-undo.
     1350      define buffer buf_user-obj     for ub.user-obj.
     1351      define buffer buf_clients      for ub.clients.
     1352      if i-db-num <> 0 then do:
     1353          for each buf_clients
     1354              where buf_clients.db-num = i-db-num
     1355              and ( buf_clients.obj-type = 'маг':U
     1356                 or buf_clients.obj-type = 'скл':U
     1357                  )
     1358              no-lock:
     1359             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1360                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1361                                     and buf_user-obj.user-id      = i-user-id
     1362                                     and buf_user-obj.db-num       = i-db-num
     1363                                   no-lock)
     1364                                   then next.
     1365             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1366          end.
     1367       end.
     1368       else do:
     1369          for each buf_clients
     1370              where
     1371                  ( buf_clients.obj-type = 'маг':U
     1372                 or buf_clients.obj-type = 'скл':U
     1373                  )
     1374              no-lock:
     1375             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1376                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1377                                     and buf_user-obj.user-id      = i-user-id
     1378                                     and buf_user-obj.db-num       = i-db-num
     1379                                   no-lock)
     1380                                   then next.
     1381             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1382          end.
     1383       end.
     1384   end.
     1385   procedure enbl-obj :
     1386      define input  parameter i-db-num  as integer   no-undo.
     1387      define input  parameter i-user-id as character no-undo.
     1388      define input  parameter i-type    as character no-undo.
     1389      define input  parameter i-code    as integer   no-undo.
     1390       define variable v-host-code    as integer      no-undo.
     1391       define variable v-host-name    as character    no-undo.
     1392       define variable v-base-code    as integer      no-undo.
     1393       define buffer buf_user-obj      for ub.user-obj.
     1394       define buffer buf_user-host     for ub.user-host.
     1395       define buffer buf_clients       for ub.clients.
     1396   do
     1397   for buf_user-obj
     1398     , buf_user-host
     1399     , buf_clients
     1400   on error undo, return error
     1401   :
     1402       find first buf_user-obj exclusive-lock
     1403            where buf_user-obj.db-num    = i-db-num
     1404              and buf_user-obj.user-id   = i-user-id
     1405              and buf_user-obj.obj-type  = i-type
     1406              and buf_user-obj.obj-code  = i-code
     1407       no-error.
     1408       if not available buf_user-obj
     1409       then do:
     1410           find first buf_clients no-lock
     1411                where buf_clients.obj-type = i-type
     1412                  and buf_clients.obj-code = i-code
     1413           .
     1414   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1416     (input  i-type
     1417     ,input  i-code
     1418     ,output v-host-code
     1419     ,output v-host-name
     1420     )  .
     1421   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1423     (input  v-host-code
     1424     ,output v-base-code
     1425     )  .
     1426           create buf_user-obj.
     1427           assign
     1428               buf_user-obj.db-num    = i-db-num
     1429               buf_user-obj.user-id   = i-user-id
     1430               buf_user-obj.obj-type  = i-type
     1431               buf_user-obj.obj-code  = i-code
     1432               buf_user-obj.host-code = v-host-code
     1433           .
     1434           find first buf_user-host exclusive-lock
     1435                where buf_user-host.db-num    = i-db-num
     1436                  and buf_user-host.user-id   = i-user-id
     1437                  and buf_user-host.host-code = v-host-code
     1438           no-error.
     1439           if not available buf_user-host
     1440           then do:
     1441               create buf_user-host.
     1442               assign
     1443                   buf_user-host.db-num    = i-db-num
     1444                   buf_user-host.user-id   = i-user-id
     1445                   buf_user-host.host-code = v-host-code
     1446               .
     1447           end.
     1448      end.
     1449   end.
     1450   end procedure.
     1451   procedure procedure-user-login-change-password :
     1452      define input  parameter p-db-num         as integer          no-undo.
     1453      define input  parameter p-user-id        as character        no-undo.
     1454      define input  parameter iChange          as logical          no-undo.
     1455      define variable v-can-edit         as logical   no-undo .
     1456      define variable v-encoded-pass     as character no-undo .
     1457      define variable v-encoded-pass-old as character no-undo .
     1458      define variable v-nextcon          as logical   no-undo .
     1459      define variable VadmSuff           as character no-undo.
     1460      define variable vChange as logical no-undo.
     1461      define variable v-param-type as character no-undo .
     1462      define variable v-value-character as character no-undo .
     1463      define variable v-value-date as date no-undo .
     1464      define variable v-value-decimal as decimal no-undo .
     1465      define variable v-value-integer as integer no-undo .
     1466      define variable v-value-logical as logical no-undo .
     1467      define variable v-tth           as handle  no-undo .
     1468      define buffer buf_lock_user-login for user-login.
     1469      define buffer buf_init_user-account for user-account.
     1470      do:
     1471         find first buf_lock_user-login no-lock
     1472                 where buf_lock_user-login.db-num  = p-db-num
     1473                   and buf_lock_user-login.user-id = p-user-id
     1474         no-error.
     1475         if not available buf_lock_user-login then do:
     1476            message
     1477               "Нельзя редактировать пароль пока не заведен логин для пользователя" skip
     1478               view-as alert-box error .
     1479               undo, return error "Нельзя редактировать пароль пока не заведен логин для пользователя" .
     1480         end.
     1481         vChange = buf_lock_user-login.user-login eq userid ("ub") or iChange.
     1482         if     available buf_lock_user-login
     1483            and buf_lock_user-login.user-administrator
     1484         then
     1485            VadmSuff = 'Adm':U.
     1486         define variable v-TimeAvail as integer no-undo.
     1487         define variable v-DateChg   as date    no-undo.
     1488         define variable v-Time      as integer no-undo.
     1489         run cur-time-mjd-to-date (buf_lock_user-login.user-password-set-mjd, output v-DateChg, output v-Time).
     1490         run adm/shattri.p (
     1491              input "get":U
     1492              ,input  '':U
     1493              ,input  0
     1494              ,input  'staff':U
     1495              ,input  'TimeBlock':U + VadmSuff
     1496              ,output v-value-character
     1497              ,output v-value-date
     1498              ,output v-value-decimal
     1499              ,output v-TimeAvail
     1500              ,output v-value-logical
     1501              ,output v-param-type
     1502              ,input-output table-handle v-tth
     1503              )  .
     1504         if     not iChange
     1505            and v-TimeAvail ne 0
     1506            and v-DateChg + v-TimeAvail < today
     1507         then do:
     1508            do trans:
     1509               find current buf_lock_user-login exclusive-lock.
     1510               buf_lock_user-login.status_ = 1.
     1511            end.
     1512            return error "Ваша учетная запись заблокирована." .
     1513         end.
     1514         run adm/shattri.p (
     1515              input "get":U
     1516              ,input  '':U
     1517              ,input  0
     1518              ,input  'staff':U
     1519              ,input  'TimeAvail':U + VadmSuff
     1520              ,output v-value-character
     1521              ,output v-value-date
     1522              ,output v-value-decimal
     1523              ,output v-TimeAvail
     1524              ,output v-value-logical
     1525              ,output v-param-type
     1526              ,input-output table-handle v-tth
     1527              )  .
     1528         delete object v-tth.
     1529         define variable vfl as logical no-undo.
     1530         vfl = logical(GetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect")) no-error.
     1531         if    vfl eq yes
     1532            or (     v-TimeAvail ne 0
     1533                 and v-DateChg + v-TimeAvail < today)
     1534            or iChange
     1535         then do:
     1536             find first buf_init_user-account where buf_init_user-account.user-id = buf_lock_user-login.user-id
     1537             no-lock.
     1538             assign
     1539             v-encoded-pass-old = buf_lock_user-login.user-password-encoded
     1540             v-encoded-pass     = buf_lock_user-login.user-password-encoded.
     1541             do while v-encoded-pass = v-encoded-pass-old or v-encoded-pass eq ?:
     1542                v-encoded-pass = v-encoded-pass-old.
     1543                run adm/chg-pswd.w ( input  this-procedure
     1544                                   , input  p-db-num
     1545                                   , input  buf_lock_user-login.user-id
     1546                                   , input  buf_lock_user-login.user-login
     1547                                   , input  substitute('&1 &2 &3':U, buf_init_user-account.last-name
     1548                                                                   , buf_init_user-account.first-name
     1549                                                                   , buf_init_user-account.second-name
     1550                                          )
     1551                                   , input  iChange
     1552                                   , input  yes
     1553                                   , input  buf_lock_user-login.user-password-encoded
     1554                                   , input  yes
     1555                                   , input  buf_lock_user-login.user-administrator
     1556                                   , output v-encoded-pass
     1557                                   , output v-nextcon
     1558                                   ) no-error .
     1559               if error-status :error
     1560               then do:
     1561                 message
     1562                    vss-workfile vss-revision vss-description skip
     1563                    "Ошибка при вызове процедуры" 'adm/chg-pswd.w':U skip
     1564                    error-status :get-message(1) skip
     1565                    return-value skip
     1566                    view-as alert-box error .
     1567                 undo, return error return-value .
     1568                end.
     1569                if    v-encoded-pass = v-encoded-pass-old
     1570                then do:
     1571                    message
     1572                       vss-workfile vss-revision vss-description skip
     1573                       "Старый пароль и новый равны. Смените пароль.":U skip
     1574                       error-status :get-message(1) skip
     1575                       return-value skip
     1576                       view-as alert-box error .
     1577                end.
     1578                else if v-encoded-pass eq ?
     1579                then do:
     1580                   message  "Отказ от смены пароля. Работа дальше не возможна"
     1581                   view-as alert-box error.
     1582                   return error "Отказ от смены пароля. Работа дальше не возможна".
     1583                end.
     1584             end.
     1585             if v-encoded-pass <> ? then
     1586             do trans:
     1587                find current buf_lock_user-login
     1588                      exclusive-lock
     1589                   .
     1590                assign
     1591                   buf_lock_user-login.user-password-encoded = v-encoded-pass
     1592                .
     1593                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect", if vChange then v-nextcon else ?).
     1594                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdUserId", string(g#userid)).
     1595                release buf_lock_user-login .
     1596                message
     1597                   "Пароль успешно изменен"
     1598                   view-as alert-box information
     1599                .
     1600             end.
     1601          end.
     1602      end.
     1603   end procedure.
     1604   procedure procedure-user-login-delete :
     1605      define input  parameter i-db-num     as integer          no-undo.
     1606      define input  parameter i-user-id    as character        no-undo.
     1607      define output parameter o-deleted   as logical          no-undo.
     1608      run procedure-user-login-delete-question (i-db-num,i-user-id,yes,output o-deleted).
     1609   end.
     1610   procedure procedure-user-login-delete-question :
     1611   define input  parameter i-db-num     as integer          no-undo.
     1612   define input  parameter i-user-id    as character        no-undo.
     1613   define input  parameter i-question as logical no-undo.
     1614   define output parameter o-deleted   as logical          no-undo.
     1615     define variable v-can-edit as logical   no-undo .
     1616       define buffer buf_user-login         for user-login .
     1617       define buffer buf_user-account       for user-account.
     1618       define buffer buf_init_user-account  for user-account.
     1619   do
     1620   for buf_user-login
     1621     , buf_user-account
     1622   on error undo, return error return-value
     1623   :
     1624       assign
     1625           o-deleted = no
     1626       .
     1627       find first buf_init_user-account no-lock
     1628            where buf_init_user-account.user-id = i-user-id
     1629           .
     1630       if available buf_init_user-account
     1631       then do:
     1632         do transaction
     1633         on error undo, return error return-value
     1634         :
     1635           run can-edit-login in this-procedure (
     1636                 input  i-db-num
     1637               , output v-can-edit
     1638           ).
     1639           if v-can-edit <> true
     1640           then do:
     1641             message
     1642               "Нельзя удалять логин пользователя для базы" i-db-num
     1643             view-as alert-box error .
     1644             undo, return error return-value .
     1645           end.
     1646           find first buf_user-login exclusive-lock
     1647                where buf_user-login.db-num  = i-db-num
     1648                  and buf_user-login.user-id = i-user-id
     1649           no-error no-wait.
     1650           if not available buf_user-login
     1651           then do:
     1652             if locked( buf_user-login )
     1653             then do:
     1654               find first buf_user-login no-lock
     1655                    where buf_user-login.db-num  = i-db-num
     1656                      and buf_user-login.user-id = i-user-id
     1657               .
     1658               message
     1659                 "Удаление логина невозможно" skip
     1660                 "Пользователь в данный момент работает в системе" skip
     1661                 "БД" i-db-num skip
     1662                 "Идентификатор" i-user-id skip
     1663                 "Псевдоним"                    buf_init_user-account.nik skip
     1664                 "Имя пользователя"             buf_init_user-account.last-name buf_init_user-account.first-name buf_init_user-account.second-name skip
     1665                 "Компьютер"                    buf_user-login.last-login-computer-name skip
     1666                 "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     1667                 "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     1668                 "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     1669                 "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     1670                 "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     1671                 "Дата и время входа в систему" sys-time_mjd-to-loc-str-func( buf_user-login.last-login-mjd ) skip
     1672                 view-as alert-box error .
     1673             end.
     1674             else do:
     1675               message
     1676                 "У пользователя нет логина" skip
     1677                 "БД" i-db-num skip
     1678                 "Идентификатор" i-user-id skip
     1679                 "Удаление невозможно" skip
     1680                 view-as alert-box error .
     1681             end.
     1682             undo, return error return-value .
     1683           end.
     1684           define variable v-ok as logical   no-undo .
     1685           if not i-question
     1686           then
     1687              v-ok = yes.
     1688           else do:
     1689              find first buf_user-account no-lock
     1690                   where buf_user-account.user-id = buf_user-login.user-id
     1691              .
     1692              message
     1693                "Удаление логина пользователя"
     1694                skip "Идентификатор" buf_user-account.user-id
     1695                skip "Псевдоним"    buf_user-account.nik
     1696                skip "Пользователь" buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name
     1697                skip "Логин для базы данных" buf_user-login.db-num
     1698                skip "Логин" buf_user-login.user-login
     1699                skip (1)
     1700                "После удаления пользователь не сможет работать в базе данных" buf_user-login.db-num skip
     1701                skip (1)
     1702                "Продолжить?"
     1703              view-as alert-box question
     1704              buttons yes-no
     1705              update v-ok .
     1706           end.
     1707           if v-ok = yes
     1708           then do:
     1709               run str/usrlog03.p (
     1710                     input buf_user-login.db-num
     1711                   , input buf_user-login.user-id
     1712               ).
     1713               assign
     1714                   o-deleted = yes
     1715               .
     1716           end.
     1717         end.
     1718       end.
     1719     end.
     1720   end procedure.
     1721   DEFINE VARIABLE i-user-id AS CHARACTER LABEL "id" FORMAT "x(15)" no-undo.
     1722   DEFINE VARIABLE o-adm-Ubd  as logical no-undo.
     1723   DEFINE VARIABLE v-adm-GBD  as logical no-undo.
     1724   DEFINE VARIABLE o-superAdm as logical no-undo.
     1725   DEFINE VARIABLE v-TabUserAdm as handle no-undo.
     1726   DEFINE stream OutStr-html.
     1727   define variable ubd-chr as character no-undo.
     1728   define variable nom-ubd-chr as character no-undo.
     1729   define variable nom-ubd-chr_na as character no-undo.
     1730   define variable gbd-chr as character no-undo.
     1731   define variable superadm-chr as character no-undo.
     1732   DEFINE INPUT  PARAMETER  v-report-name-html-list AS CHARACTER NO-UNDO.
     1733       output stream OutStr-html to value(v-report-name-html-list) convert target 'UTF-8'.
     1734       put stream OutStr-html unformatted
     1735           "<!DOCTYPE HTML>" skip
     1736           ' <html>' skip
     1737           '  <head>' skip
     1738           '   <meta charset="utf-8">' skip
     1739           '    <style type="text/css">' skip
     1740           '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1741           '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1742           '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1743           '   </style>' skip
     1744           '  </head>' skip
     1745           '<body>' skip
     1746           '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     1747           '<thead>' skip
     1748           ' <tr class="set_columns">' skip
     1749           ' <td style="width:50px"></td>' skip
     1750           ' <td style="width:200px"></td>' skip
     1751           ' <td style="width:60px"></td>' skip
     1752           ' <td style="width:60px"></td>' skip
     1753           ' <td style="width:60px"></td>' skip
     1754           ' <td style="width:60px"></td>' skip
     1755           ' <td style="width:60px"></td>' skip
     1756           '</tr>' skip
     1757           '<tr><!-- шапка таблицы -->' skip
     1758           '<td colspan="8" style="text-align: right;"> </td>' skip
     1759           '</tr>' skip
     1760           '<tr>' skip
     1761           '<td colspan="8" style="font-weight: bold; text-align: center;">Список пользователей с правами доступа к бд.</td>' skip
     1762           '</tr>' skip
     1763           '</thead>' skip
     1764           '<tr>' skip
     1765           '<td style="width: 50px; text-align: center;">User ID</td>' skip
     1766           '<td style="width: 200px; text-align: center;">Пользователь</td>' skip
     1767           '<td style="width: 60px; text-align: center;">  админ   GBD  </td>' skip
     1768           '<td style="width: 60px; text-align: center;">    superadmin  </td>' skip
     1769           '<td style="width: 60px; text-align: center">  админ UBD</td>' skip
     1770           '<td style="width: 60px; text-align: center">  Адм. БД </td>' skip
     1771           '<td style="width: 60px; text-align: center">  Польз. БД </td>' skip
     1772           '</tr>' skip
     1773           '<tbody>'
     1774           .
     1775    FOR EACH user-account NO-LOCK:
     1776          run getAccountSetting(input user-account.user-id,
     1777                                   output o-adm-Ubd,
     1778                                   output v-adm-GBD,
     1779                                   output o-superAdm,
     1780                                   input-output table-handle v-TabUserAdm).
     1781    if v-adm-GBD = yes OR o-superAdm = yes OR o-adm-Ubd = yes then
     1782      do:
     1783           if  v-adm-GBD = yes THEN
     1784                   gbd-chr = "да ".
     1785           ELSE IF v-adm-GBD = no THEN
     1786                   gbd-chr = "нет ".
     1787           ELSE
     1788                   gbd-chr = "".
     1789           if  o-superAdm = yes THEN
     1790                   superadm-chr = "да ".
     1791           ELSE IF o-superAdm = no THEN
     1792                   superadm-chr = "нет ".
     1793           ELSE
     1794                   superadm-chr = "".
     1795           if  o-adm-Ubd = yes THEN
     1796                   ubd-chr = "да".
     1797           ELSE IF o-adm-Ubd = no THEN
     1798                   ubd-chr = "нет ".
     1799           ELSE
     1800                   ubd-chr = "".
     1801                FOR EACH user-login   WHERE user-account.user-id = user-login.user-id and user-login.db <>0 and user-login.user-administrator = yes  NO-LOCK:
     1802                     nom-ubd-chr = nom-ubd-chr + "," +  STRING(user-login.db-num) NO-ERROR .
     1803                 END.
     1804                FOR EACH user-login   WHERE user-account.user-id = user-login.user-id
     1805                                     and user-login.db <> 0 and user-login.user-administrator = no  NO-LOCK:
     1806                     nom-ubd-chr_na = nom-ubd-chr_na + "," +  STRING(user-login.db-num) NO-ERROR .
     1807                END.
     1808           nom-ubd-chr = SUBSTRING(nom-ubd-chr,2).
     1809           nom-ubd-chr_na = SUBSTRING(nom-ubd-chr_na,2).
     1810           put stream OutStr-html unformatted
     1811               '<tr>' skip
     1812               '<td style="width: 50px;"> '  user-account.user-id '</td>' skip
     1813               '<td style="width: 200px;"> ' user-account.first-name " "  user-account.last-name '</td>' skip
     1814               '<td style="width: 60px; text-align: center"> ' gbd-chr '</td>' skip
     1815               '<td style="width: 60px; text-align: center"> ' superadm-chr '</td>' skip
     1816               '<td style="width: 60px; text-align: center"> ' ubd-chr '</td>' skip
     1817               '<td style="width: 60px;">' nom-ubd-chr  '</td>' skip
     1818               '<td style="width: 60px;">' nom-ubd-chr_na '</td>' skip
     1819               '</tr>' skip
     1820               .
     1821           nom-ubd-chr = ''.
     1822           nom-ubd-chr_na = ''.
     1823          END.
     1824    END.
     1825   put stream OutStr-html unformatted
     1826   '<tbody>' skip
     1827   '</table>'
     1828   .
     1829   output stream OutStr-html close.
