        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 4886e87b5a2b, 3169, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        4   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:23 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: adm_bd.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/adm_bd.p $":U .
        7   define variable vss-description as character no-undo init "Процедура для записи истории по БД добавляемые в группу".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define temp-table UserDbAdm
       78   field db-num as integer
       79   field db-adm as logical
       80   field db-usr as logical
       81   field db-block as logical
       82   index pi is unique db-num
       83   index adm db-adm db-usr
       84   .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   procedure sys-time_get-sys :
      312     define output parameter p-year         as integer   no-undo .
      313     define output parameter p-month        as integer   no-undo .
      314     define output parameter p-day          as integer   no-undo .
      315     define output parameter p-hour         as integer   no-undo .
      316     define output parameter p-minute       as integer   no-undo .
      317     define output parameter p-second       as integer   no-undo .
      318     define output parameter p-milliseconds as integer   no-undo .
      319     define variable v-system-time-structure as memptr    no-undo.
      320     do
      321     on error undo, return error return-value
      322     :
      323       assign
      324         set-size(v-system-time-structure) = 16
      325       .
      326       run GetSystemTime
      327         (input  get-pointer-value(v-system-time-structure)
      328         ) .
      329       assign
      330         p-year         = get-short(v-system-time-structure,  1)
      331         p-month        = get-short(v-system-time-structure,  3)
      332         p-day          = get-short(v-system-time-structure,  7)
      333         p-hour         = get-short(v-system-time-structure,  9)
      334         p-minute       = get-short(v-system-time-structure, 11)
      335         p-second       = get-short(v-system-time-structure, 13)
      336         p-milliseconds = get-short(v-system-time-structure, 15)
      337       .
      338       assign
      339         set-size(v-system-time-structure) = 0
      340       .
      341     end.
      342   end procedure.
      343   procedure sys-time_get-comp-user-name :
      344     define output parameter p-computer-name as character no-undo .
      345     define output parameter p-user-name     as character no-undo .
      346     define output parameter p-process-pid   as integer   no-undo .
      347     define variable v-return-value  as integer   no-undo .
      348     define variable v-buffer-length as integer   no-undo .
      349     define variable v-buffer-memptr as memptr    no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       assign
      354         v-buffer-length = 1024
      355         set-size(v-buffer-memptr) = v-buffer-length + 4
      356       .
      357       assign
      358         put-long(v-buffer-memptr, 1) = v-buffer-length
      359       .
      360       run GetComputerNameA
      361         (input  get-pointer-value(v-buffer-memptr) + 4
      362         ,input  get-pointer-value(v-buffer-memptr)
      363         ,output v-return-value
      364         ) .
      365       if v-return-value <> 0
      366       then do:
      367         assign
      368           p-computer-name = get-string(v-buffer-memptr, 5)
      369         .
      370       end.
      371       assign
      372         put-long(v-buffer-memptr, 1) = v-buffer-length
      373       .
      374       run GetUserNameA
      375         (input  get-pointer-value(v-buffer-memptr) + 4
      376         ,input  get-pointer-value(v-buffer-memptr)
      377         ,output v-return-value
      378         ) .
      379       if v-return-value <> 0
      380       then do:
      381         assign
      382           p-user-name = get-string(v-buffer-memptr, 5)
      383         .
      384       end.
      385       run GetCurrentProcessId
      386         (output p-process-pid
      387         ) .
      388       assign
      389         set-size(v-buffer-memptr) = 0
      390       .
      391     end.
      392   end procedure.
      393   procedure sys-time_get-http :
      394     define output parameter p-http-time as character no-undo .
      395     define variable v-year         as integer   no-undo .
      396     define variable v-month        as integer   no-undo .
      397     define variable v-day-of-week  as integer   no-undo .
      398     define variable v-day          as integer   no-undo .
      399     define variable v-hour         as integer   no-undo .
      400     define variable v-minute       as integer   no-undo .
      401     define variable v-second       as integer   no-undo .
      402     define variable v-milliseconds as integer   no-undo .
      403     do
      404     on error undo, return error return-value
      405     :
      406       run sys-time_get-sys in this-procedure
      407         (output v-year
      408         ,output v-month
      409         ,output v-day
      410         ,output v-hour
      411         ,output v-minute
      412         ,output v-second
      413         ,output v-milliseconds
      414         ) .
      415       assign
      416         v-day-of-week = weekday(date(v-month, v-day, v-year))
      417         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      418                     + ', ':u
      419                     + string(v-day, '99':u)
      420                     + ' ':u
      421                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      422                     + ' ':u
      423                     + string(v-year, '9999':u)
      424                     + ' ':u
      425                     + string(v-hour, '99':u)
      426                     + ':':u
      427                     + string(v-minute, '99':u)
      428                     + ':':u
      429                     + string(v-second, '99':u)
      430                     + ' ':u
      431                     + 'GMT':u
      432       .
      433     end.
      434   end procedure.
      435   procedure sys-time_set-sys :
      436     define input  parameter p-year         as integer   no-undo .
      437     define input  parameter p-month        as integer   no-undo .
      438     define input  parameter p-day          as integer   no-undo .
      439     define input  parameter p-hour         as integer   no-undo .
      440     define input  parameter p-minute       as integer   no-undo .
      441     define input  parameter p-second       as integer   no-undo .
      442     define input  parameter p-milliseconds as integer   no-undo .
      443     define variable v-system-time-structure as memptr    no-undo.
      444     define variable v-return-value as integer   no-undo .
      445     define variable v-day-of-week  as integer   no-undo .
      446     do
      447     on error undo, return error return-value
      448     :
      449       assign
      450         v-day-of-week = weekday(date(p-month, p-day, p-year))
      451       .
      452       assign
      453         set-size(v-system-time-structure) = 16
      454       .
      455       assign
      456         put-short(v-system-time-structure,  1) = p-year
      457         put-short(v-system-time-structure,  3) = p-month
      458         put-short(v-system-time-structure,  5) = v-day-of-week
      459         put-short(v-system-time-structure,  7) = p-day
      460         put-short(v-system-time-structure,  9) = p-hour
      461         put-short(v-system-time-structure, 11) = p-minute
      462         put-short(v-system-time-structure, 13) = p-second
      463         put-short(v-system-time-structure, 15) = p-milliseconds
      464       .
      465       run SetSystemTime
      466         (input  get-pointer-value(v-system-time-structure)
      467         ,output v-return-value
      468         ) .
      469       assign
      470         set-size(v-system-time-structure) = 0
      471       .
      472       if v-return-value = 0
      473       then do:
      474         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      475       end.
      476     end.
      477   end procedure.
      478   procedure sys-time_sys-to-mjd :
      479     define input  parameter p-year         as integer   no-undo .
      480     define input  parameter p-month        as integer   no-undo .
      481     define input  parameter p-day          as integer   no-undo .
      482     define input  parameter p-hour         as integer   no-undo .
      483     define input  parameter p-minute       as integer   no-undo .
      484     define input  parameter p-second       as integer   no-undo .
      485     define input  parameter p-milliseconds as integer   no-undo .
      486     define output parameter p-mjd          as decimal   no-undo .
      487     define variable v-year-correction as decimal   no-undo .
      488     define variable v-shift-year as decimal   no-undo .
      489     do
      490     on error undo, return error return-value
      491     :
      492       assign
      493         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      494         v-shift-year      = decimal(p-year) + v-year-correction
      495         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      496               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      497               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      498               + decimal(p-day) - 2432076.0
      499               + p-hour / 24.0
      500               + p-minute / 1440.0
      501               + p-second / 86400.0
      502               + p-milliseconds / 86400000.0
      503       .
      504     end.
      505   end procedure.
      506   procedure sys-time_sys-to-loc :
      507     define input  parameter p-sys-year         as integer   no-undo .
      508     define input  parameter p-sys-month        as integer   no-undo .
      509     define input  parameter p-sys-day          as integer   no-undo .
      510     define input  parameter p-sys-hour         as integer   no-undo .
      511     define input  parameter p-sys-minute       as integer   no-undo .
      512     define input  parameter p-sys-second       as integer   no-undo .
      513     define input  parameter p-sys-milliseconds as integer   no-undo .
      514     define output parameter p-loc-year         as integer   no-undo .
      515     define output parameter p-loc-month        as integer   no-undo .
      516     define output parameter p-loc-day          as integer   no-undo .
      517     define output parameter p-loc-hour         as integer   no-undo .
      518     define output parameter p-loc-minute       as integer   no-undo .
      519     define output parameter p-loc-second       as integer   no-undo .
      520     define output parameter p-loc-milliseconds as integer   no-undo .
      521     define variable v-system-time-structure as memptr    no-undo.
      522     define variable v-return-value          as integer   no-undo .
      523     define variable v-sys-day-of-week       as integer   no-undo .
      524     do
      525     on error undo, return error return-value
      526     :
      527       assign
      528         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      529       .
      530       assign
      531         set-size(v-system-time-structure) = 32
      532       .
      533       assign
      534         put-short(v-system-time-structure,  1) = p-sys-year
      535         put-short(v-system-time-structure,  3) = p-sys-month
      536         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      537         put-short(v-system-time-structure,  7) = p-sys-day
      538         put-short(v-system-time-structure,  9) = p-sys-hour
      539         put-short(v-system-time-structure, 11) = p-sys-minute
      540         put-short(v-system-time-structure, 13) = p-sys-second
      541         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      542       .
      543       run SystemTimeToTzSpecificLocalTime
      544         (input  0
      545         ,input  get-pointer-value(v-system-time-structure)
      546         ,input  get-pointer-value(v-system-time-structure) + 16
      547         ,output v-return-value
      548         ) .
      549       assign
      550         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      551         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      552         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      553         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      554         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      555         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      556         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      557       .
      558       assign
      559         set-size(v-system-time-structure) = 0
      560       .
      561       if v-return-value = 0
      562       then do:
      563         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      564       end.
      565     end.
      566   end procedure.
      567   procedure sys-time_mjd-to-sys :
      568     define input  parameter p-mjd          as decimal   no-undo .
      569     define output parameter p-year         as integer   no-undo .
      570     define output parameter p-month        as integer   no-undo .
      571     define output parameter p-day          as integer   no-undo .
      572     define output parameter p-hour         as integer   no-undo .
      573     define output parameter p-minute       as integer   no-undo .
      574     define output parameter p-second       as integer   no-undo .
      575     define output parameter p-milliseconds as integer   no-undo .
      576     define variable v-year-correction as decimal   no-undo .
      577     define variable v-shift-year      as decimal   no-undo .
      578     define variable v-conv-date     as date      no-undo .
      579     define variable v-int-part      as integer   no-undo .
      580     define variable v-fraction-part as decimal   no-undo .
      581     do
      582     on error undo, return error return-value
      583     :
      584       assign
      585         v-int-part      = integer(truncate(p-mjd, 0))
      586         v-fraction-part = p-mjd - v-int-part
      587         v-conv-date     = date(11, 17, 1858) + v-int-part
      588         p-year          = year(v-conv-date)
      589         p-month         = month(v-conv-date)
      590         p-day           = day(v-conv-date)
      591         v-fraction-part = v-fraction-part * 24.0
      592         p-hour          = integer(truncate(v-fraction-part, 0))
      593         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      594         p-minute        = integer(truncate(v-fraction-part, 0))
      595         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      596         p-second        = integer(truncate(v-fraction-part, 0))
      597         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      598         p-milliseconds  = integer(v-fraction-part)
      599       .
      600     end.
      601   end procedure.
      602   procedure sys-time_mjd-to-loc :
      603     define input  parameter p-mjd              as decimal   no-undo .
      604     define output parameter p-loc-year         as integer   no-undo .
      605     define output parameter p-loc-month        as integer   no-undo .
      606     define output parameter p-loc-day          as integer   no-undo .
      607     define output parameter p-loc-hour         as integer   no-undo .
      608     define output parameter p-loc-minute       as integer   no-undo .
      609     define output parameter p-loc-second       as integer   no-undo .
      610     define output parameter p-loc-milliseconds as integer   no-undo .
      611     define variable v-sys-year         as integer   no-undo .
      612     define variable v-sys-month        as integer   no-undo .
      613     define variable v-sys-day          as integer   no-undo .
      614     define variable v-sys-hour         as integer   no-undo .
      615     define variable v-sys-minute       as integer   no-undo .
      616     define variable v-sys-second       as integer   no-undo .
      617     define variable v-sys-milliseconds as integer   no-undo .
      618     do
      619     on error undo, return error return-value
      620     :
      621       run sys-time_mjd-to-sys
      622         (input  p-mjd
      623         ,output v-sys-year
      624         ,output v-sys-month
      625         ,output v-sys-day
      626         ,output v-sys-hour
      627         ,output v-sys-minute
      628         ,output v-sys-second
      629         ,output v-sys-milliseconds
      630         ) .
      631       run sys-time_sys-to-loc
      632         (input  v-sys-year
      633         ,input  v-sys-month
      634         ,input  v-sys-day
      635         ,input  v-sys-hour
      636         ,input  v-sys-minute
      637         ,input  v-sys-second
      638         ,input  v-sys-milliseconds
      639         ,output p-loc-year
      640         ,output p-loc-month
      641         ,output p-loc-day
      642         ,output p-loc-hour
      643         ,output p-loc-minute
      644         ,output p-loc-second
      645         ,output p-loc-milliseconds
      646         ) .
      647     end.
      648   end procedure.
      649   function sys-time_get-mjd-func returns decimal
      650   :
      651     define variable v-year         as integer   no-undo .
      652     define variable v-month        as integer   no-undo .
      653     define variable v-day          as integer   no-undo .
      654     define variable v-hour         as integer   no-undo .
      655     define variable v-minute       as integer   no-undo .
      656     define variable v-second       as integer   no-undo .
      657     define variable v-milliseconds as integer   no-undo .
      658     define variable v-mjd          as decimal   no-undo .
      659     run sys-time_get-sys in this-procedure
      660       (output v-year
      661       ,output v-month
      662       ,output v-day
      663       ,output v-hour
      664       ,output v-minute
      665       ,output v-second
      666       ,output v-milliseconds
      667       ) .
      668     run sys-time_sys-to-mjd in this-procedure
      669       (input  v-year
      670       ,input  v-month
      671       ,input  v-day
      672       ,input  v-hour
      673       ,input  v-minute
      674       ,input  v-second
      675       ,input  v-milliseconds
      676       ,output v-mjd
      677       ) .
      678     return v-mjd .
      679   end function .
      680   function sys-time_get-sys-str-func returns character
      681   :
      682     define variable v-utc-time as character no-undo .
      683     define variable v-year         as integer   no-undo .
      684     define variable v-month        as integer   no-undo .
      685     define variable v-day          as integer   no-undo .
      686     define variable v-hour         as integer   no-undo .
      687     define variable v-minute       as integer   no-undo .
      688     define variable v-second       as integer   no-undo .
      689     define variable v-milliseconds as integer   no-undo .
      690     run sys-time_get-sys in this-procedure
      691       (output v-year
      692       ,output v-month
      693       ,output v-day
      694       ,output v-hour
      695       ,output v-minute
      696       ,output v-second
      697       ,output v-milliseconds
      698       ) .
      699     assign
      700       v-utc-time  = 'UTC ':u
      701                   + string(v-year,         '9999':u)
      702                   + '/':u
      703                   + string(v-month,        '99':u)
      704                   + '/':u
      705                   + string(v-day,          '99':u)
      706                   + ' ':u
      707                   + string(v-hour,         '99':u)
      708                   + ':':u
      709                   + string(v-minute,       '99':u)
      710                   + ':':u
      711                   + string(v-second,       '99':u)
      712                   + ' ':u
      713                   + string(v-milliseconds, '999':u)
      714     .
      715     return v-utc-time.
      716   end function .
      717   function sys-time_mjd-to-loc-str-func returns character
      718     (v-sys-mjd as decimal)
      719   :
      720     define variable v-loc-str          as character no-undo .
      721     define variable v-loc-year         as integer   no-undo .
      722     define variable v-loc-month        as integer   no-undo .
      723     define variable v-loc-day          as integer   no-undo .
      724     define variable v-loc-hour         as integer   no-undo .
      725     define variable v-loc-minute       as integer   no-undo .
      726     define variable v-loc-second       as integer   no-undo .
      727     define variable v-loc-milliseconds as integer   no-undo .
      728     run sys-time_mjd-to-loc in this-procedure
      729       (input  v-sys-mjd
      730       ,output v-loc-year
      731       ,output v-loc-month
      732       ,output v-loc-day
      733       ,output v-loc-hour
      734       ,output v-loc-minute
      735       ,output v-loc-second
      736       ,output v-loc-milliseconds
      737       ) .
      738     assign
      739       v-loc-str = substitute('&1/&2/&3 &4:&5'
      740                             ,string(v-loc-day,    '99':U)
      741                             ,string(v-loc-month,  '99':U)
      742                             ,string(v-loc-year,   '9999':U)
      743                             ,string(v-loc-hour,   '99':U)
      744                             ,string(v-loc-minute, '99':U)
      745                             )
      746     .
      747     return v-loc-str .
      748   end function .
