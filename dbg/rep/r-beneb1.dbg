     1233   PROCEDURE no-benq.
     1234   DEFINE OUTPUT PARAMETER found as logical init no.
     1235   define buffer buf_chk-doc for ub.chk-doc.
     1236   FOR EACH obj-list WHERE
     1237           obj-list.obj-type = 'маг':U NO-LOCK :
     1238     CASE X-Radio-Task > 1 :
     1239       WHEN YES THEN DO:
     1240         FOR EACH buf_chk-doc NO-LOCK WHERE
     1241                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1242                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1243                 (
     1244                   buf_chk-doc.shift-date >= X-date-start AND
     1245                   buf_chk-doc.shift-date <= X-date-end)
     1246                   AND
     1247                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1248           IF X-Radio-Task = 3 AND
     1249           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1250             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1251           IF X-Radio-Task = 4 AND
     1252           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1253           found = yes.
     1254           return.
     1255         END.
     1256       END.
     1257       WHEN NO THEN DO:
     1258         FOR EACH buf_chk-doc NO-LOCK WHERE
     1259               buf_chk-doc.obj-type = obj-list.obj-type AND
     1260               buf_chk-doc.obj-code = obj-list.obj-code AND
     1261               buf_chk-doc.chk-date >= X-date-start AND
     1262               buf_chk-doc.chk-date <= X-date-end   AND
     1263               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1264           found = yes.
     1265           return.
     1266         END.
     1267        END.
     1268      END CASE.
     1269    END.
     1270   END PROCEDURE.
     1271   PROCEDURE no-benqi.
     1272   DEFINE OUTPUT PARAMETER found as logical init no.
     1273   define buffer buf_chk-doc for ub.chk-doc.
     1274   define buffer buf_inkas for ub.inkas.
     1275   FOR EACH obj-list WHERE
     1276         obj-list.obj-type = 'маг':U NO-LOCK :
     1277     CASE X-Radio-Task > 1 :
     1278       WHEN YES THEN DO:
     1279         FOR EACH buf_chk-doc No-LOCK WHERE
     1280                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1281                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1282                 (
     1283                   buf_chk-doc.shift-date >= X-date-start AND
     1284                   buf_chk-doc.shift-date <= X-date-end)
     1285                   AND
     1286                   buf_Chk-doc.out-code = ? AND
     1287                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1288           IF X-Radio-Task = 3 AND
     1289           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1290             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1291           IF X-Radio-Task = 4 AND
     1292           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1293           found = yes.
     1294           return.
     1295         END.
     1296         FOR EACH buf_inkas No-LOCK WHERE
     1297                   buf_inkas.obj-type = obj-list.obj-type AND
     1298                   buf_inkas.obj-code = obj-list.obj-code AND
     1299                   (
     1300                   buf_inkas.shift-date >= X-date-start AND
     1301                   buf_inkas.shift-date <= X-date-end):
     1302           if buf_inkas.status_ = 'факт':U
     1303           or buf_inkas.status_ = 'запрос':U then next.
     1304           IF X-Radio-Task = 3 AND
     1305           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1306             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1307           IF X-Radio-Task = 4 AND
     1308           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1309           found = yes.
     1310           return.
     1311         END.
     1312       END.
     1313       WHEN NO THEN DO:
     1314         FOR EACH buf_chk-doc NO-LOCK WHERE
     1315                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1316                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1317                 buf_chk-doc.chk-date >= X-date-start AND
     1318                 buf_chk-doc.chk-date <= X-date-end   AND
     1319                 buf_Chk-doc.out-code = ? AND
     1320                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1321           found = yes.
     1322           return.
     1323         END.
     1324         FOR EACH buf_inkas NO-LOCK WHERE
     1325                 buf_inkas.obj-type = obj-list.obj-type AND
     1326                 buf_inkas.obj-code = obj-list.obj-code AND
     1327                 buf_inkas.doc-date >= X-date-start AND
     1328                 buf_inkas.doc-date <= X-date-end :
     1329           if buf_inkas.status_ = 'факт':U
     1330           or buf_inkas.status_ = 'запрос':U then next.
     1331           found = yes.
     1332           return.
     1333         END.
     1334       END.
     1335     END CASE.
     1336   END.
     1337   END PROCEDURE.
