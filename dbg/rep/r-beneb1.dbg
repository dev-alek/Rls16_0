     1378   PROCEDURE no-benq-i-office.
     1379   DEFINE OUTPUT PARAMETER found as logical init no.
     1380   define buffer buf_sale-doc for ub.sale-doc.
     1381   CASE X-Radio-Task > 1:
     1382     WHEN YES then do:
     1383       FOR EACH obj-list WHERE
     1384               obj-list.obj-type = 'маг':U NO-LOCK :
     1385         FOR EACH buf_sale-doc NO-LOCK WHERE
     1386                  buf_Sale-doc.obj-type = obj-list.obj-type
     1387              AND buf_sale-doc.obj-code = obj-list.obj-code
     1388              AND buf_sale-doc.status_ = 'факт':U
     1389              AND buf_sale-doc.chr-office = 'у':U
     1390              AND (
     1391                 buf_sale-doc.shift-date >= X-date-start
     1392                 AND
     1393                 buf_sale-doc.shift-date <= X-date-end):
     1394           IF X-Radio-Task = 3 AND
     1395           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1396             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1397           IF X-Radio-Task = 4 AND
     1398           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1399           found = yes.
     1400           return.
     1401         END.
     1402       END.
     1403     END.
     1404     WHEN NO THEN DO:
     1405       FOR EACH obj-list WHERE
     1406               obj-list.obj-type = 'маг':U NO-LOCK :
     1407         FOR EACH buf_sale-doc NO-LOCK WHERE
     1408                 buf_sale-doc.obj-type = obj-list.obj-type
     1409            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1410            AND  buf_sale-doc.status_ = 'факт':U
     1411            AND  buf_sale-doc.chr-office = 'у':U
     1412            AND  buf_sale-doc.doc-date >= X-date-start
     1413            AND  buf_sale-doc.doc-date <= X-date-end :
     1414           found = yes.
     1415           return.
