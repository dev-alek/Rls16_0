     1450       HEADER  date_string format "X(35)" AT 5
     1451                           string( "( Б.Вал. - " + caps( trim( base-type ) ) + " )" ) format "X(20)" AT 42
     1452                           "Страница " AT 65 PAGE-NUMBER( PrnLibStream )  AT 75 FORMAT ">>9" SKIP
     1453                       Line format "X(82)" AT 1
     1454       with width 160 down stream-io use-text .
     1455   DEFINE FRAME ZUM-PayCodes-base
     1456           sym1 column-label ":" format "X(1)"
     1457           benefits.pay-name column-label "Вид оплаты" format "X(41)"
     1458           sym6 column-label ":" format "X(1)"
     1459           benefits.tot-r-b column-label "Сумма (вал.продаж)"  format "->,>>>,>>>,>>>,>>9.99"
     1460           sym7 column-label ":" format "X(1)"
     1461           benefits.pcnt column-label "% от суммы" format "->>>>9.99%"
     1462           sym8 column-label ":" format "X(1)"
     1463       with width 160 down stream-io use-text NO-LABELS.
     1464   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1466   procedure cur-time :
     1467      define output parameter p-today as date      no-undo .
     1468      define output parameter p-time  as integer   no-undo .
     1469     do
     1470     on error undo, return error
     1471     :
     1472       define variable v-date1 as date      no-undo .
     1473       define variable v-date2 as date      no-undo .
     1474       define variable v-time  as integer   no-undo .
     1475       assign
     1476         v-date1 = today
     1477         v-time  = time
     1478         v-date2 = today
     1479       .
     1480       if v-date1 <> v-date2
     1481       then do:
     1482         assign
     1483           v-date1 = today
     1484           v-time  = v-time
     1485         .
     1486       end.
     1487       assign
     1488         p-today = v-date1
     1489         p-time  = v-time
     1490       .
     1491     end.
     1492   end.
     1493   function cur-time-date returns character
     1494   :
     1495     return string(today, '99/99/9999':U) .
     1496   end.
     1497   function cur-time-mjd returns decimal
     1498   :
     1499     define variable v-date as date      no-undo .
     1500     define variable v-time as integer   no-undo .
     1501     run cur-time in this-procedure
     1502       (output v-date
     1503       ,output v-time
     1504       ) .
     1505     return integer(v-date) - 2400002 + (v-time / 86400) .
     1506   end.
     1507   function cur-time-get-ending-index returns integer
     1508   (input p-number as integer
     1509   )
     1510   :
     1511     if p-number < 0
     1512     or p-number = ?
     1513     then do:
     1514       return 1 .
     1515     end.
     1516     define variable v-rest as integer   no-undo .
     1517     assign
     1518       p-number = p-number modulo 100
     1519     .
     1520     if p-number < 20
     1521     then do:
     1522       assign
     1523         v-rest = p-number
     1524       .
     1525     end.
     1526     else do:
     1527       assign
     1528         v-rest = p-number modulo 10
     1529       .
     1530     end.
     1531     case v-rest :
     1532       when 1
     1533       then do:
     1534         return 2 .
     1535       end.
     1536       when 2 or
     1537       when 3 or
     1538       when 4
     1539       then do:
     1540         return 3 .
     1541       end.
     1542       otherwise do:
     1543         return 1 .
     1544       end.
     1545     end case .
     1546   end.
     1547   procedure cur-time-mjd-to-date :
     1548      define input  parameter i-mjd-diff as decimal no-undo.
     1549      define output parameter o-Date     as date    no-undo.
     1550      define output parameter o-Time     as integer no-undo.
     1551      define variable v-day-number as integer   no-undo .
     1552      if    i-mjd-diff < 0
     1553         or i-mjd-diff = ?
     1554      then do:
     1555         return "?" .
     1556      end.
     1557      assign
     1558         v-day-number = truncate(i-mjd-diff,0).
     1559         o-Date = date(v-day-number + 2400002).
     1560         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1561     .
     1562   end.
     1563   function cur-time-mjd-to-string returns character
     1564   (input p-mjd-diff as decimal
     1565   )
     1566   :
     1567     define variable v-day-number as integer   no-undo .
     1568     define variable v-seconds    as integer   no-undo .
     1569     define variable v-hour       as integer   no-undo .
     1570     define variable v-min        as integer   no-undo .
     1571     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1572     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1573     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1574     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1575     if p-mjd-diff < 0
     1576     or p-mjd-diff = ?
     1577     then do:
     1578       return "?" .
     1579     end.
     1580     assign
     1581       v-day-number = integer(truncate(p-mjd-diff,0))
     1582       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1583     .
     1584     if v-seconds > 86400
     1585     then do:
     1586       assign
     1587         v-seconds = 86400 - 1
     1588       .
     1589     end.
     1590     if v-seconds < 0
     1591     then do:
     1592       assign
     1593         v-seconds = 0
     1594       .
     1595     end.
     1596     assign
     1597       v-hour = truncate(v-seconds / 3600, 0)
     1598     .
     1599     assign
     1600       v-seconds = v-seconds modulo 3600
     1601     .
     1602     assign
     1603       v-min = truncate(v-seconds / 60, 0)
     1604     .
     1605     assign
     1606       v-seconds = v-seconds modulo 60
     1607     .
     1608     return
     1609         (if v-day-number <> 0
     1610           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1611           else ""
     1612         )
     1613       + (if v-day-number <> 0 or v-hour <> 0
     1614           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1615           else ""
     1616         )
     1617       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1618           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1619           else ""
     1620         )
     1621       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1622       .
     1623   end.
     1624   function cur-time-string returns character
     1625   :
     1626     define variable v-date as date      no-undo .
     1627     define variable v-time as integer   no-undo .
     1628     run cur-time in this-procedure
     1629       (output v-date
     1630       ,output v-time
     1631       ) .
     1632     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1633   end.
     1634   function cur-time-string-sec returns character
     1635   :
     1636     define variable v-date as date      no-undo .
     1637     define variable v-time as integer   no-undo .
     1638     run cur-time in this-procedure
     1639       (output v-date
     1640       ,output v-time
     1641       ) .
     1642     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1643   end.
     1644   function cur-time-custom  returns character
     1645   (input p-prefix as character
     1646   ,input p-date-format as character
     1647   ,input p-delimiter as character
     1648   ,input p-time-format as character
     1649   ,input p-suffix as character
     1650   )
     1651   :
     1652     define variable v-date as date      no-undo .
     1653     define variable v-time as integer   no-undo .
     1654     run cur-time in this-procedure
     1655       (output v-date
     1656       ,output v-time
     1657       ) .
     1658     return
     1659       p-prefix
     1660       + string(v-date, p-date-format)
     1661       + p-delimiter
     1662       + string(v-time, p-time-format)
     1663       + p-suffix
     1664       .
     1665   end.
     1666   function cur-time-print  returns character
     1667   :
     1668     define variable v-date as date      no-undo .
     1669     define variable v-time as integer   no-undo .
     1670     run cur-time in this-procedure
     1671       (output v-date
     1672       ,output v-time
     1673       ) .
     1674     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1675   end.
     1676   function cur-time-datetime returns datetime
     1677   :
     1678     define variable v-char as character no-undo .
     1679     define variable v-datetime as datetime no-undo .
     1680     v-char = cur-time-string().
     1681     v-datetime = datetime(v-char).
     1682     return  v-datetime.
     1683   end.
     1684   function cur-time-string-msec returns character
     1685   :
     1686     define variable v-date as datetime  no-undo .
     1687     v-date = now.
     1688     return string(v-date) .
     1689   end.
     1690   function fnc-convert-dot-to-colon returns character
     1691       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1692   function fnc-convert-dot-to-colon returns character
     1693   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1694       define variable result as character no-undo.
     1695       define variable v-str-result as character no-undo.
     1696       if p-data = ? then p-data = 0 .
     1697       p-data = round(p-data, p-num).
     1698       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1699       return v-str-result.
     1700   END FUNCTION.
     1701   function putRowAmount1 returns character private
     1702   (input p-curr-name as character
     1703   ,input p-total1    as decimal
     1704   ) :
     1705   define variable v-row-amount as character no-undo .
     1706   define variable v-curr-name  as character no-undo .
     1707     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1708     v-row-amount = substitute (
     1709         '<td>&1</td><td num="0.00" val="&2">&2</td><td><br /></td><td><br /></td>'
     1710         , v-curr-name
     1711         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1712     ) .
     1713     return v-row-amount .
     1714   end function .
     1715   function putRowAmount returns character private
     1716   (input p-curr-name as character
     1717   ,input p-total1    as decimal
     1718   ,input p-total2    as decimal
     1719   ,input p-total3    as decimal
     1720   ) :
     1721   define variable v-row-amount as character no-undo .
     1722   define variable v-curr-name  as character no-undo .
     1723     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1724     v-row-amount = substitute (
     1725         '<td>&1</td><td num="0.00" val="&2">&2</td><td num="0.00" val="&3">&3</td><td num="0.00" val="&4">&4</td>'
     1726         , v-curr-name
     1727         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1728         , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1729         , fnc-convert-dot-to-colon(p-total3, "->>>>>>>>>>>9.99", 2)
     1730     ) .
     1731     return v-row-amount .
     1732   end function .
     1733   function putRowDayTotal1 returns character private
     1734   (input p-numchk-fisc as integer
     1735   ,input p-total1    as decimal
     1736   ) :
     1737   define variable v-day-amount as character no-undo .
     1738     v-day-amount = substitute (
     1739       '<td colspan="3">средн.чек: &1</td><td num="0.00" val="&2" class="sumtotal">&2</td><td><br /></td><td><br /></td>'
     1740       , ROUND(p-total1 / p-numchk-fisc, 2)
     1741       , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1742     ) .
     1743     return v-day-amount .
     1744   end function .
     1745   function putRowDayTotal returns character private
     1746   (input p-numchk-fisc as integer
     1747   ,input p-total1    as decimal
     1748   ,input p-total2    as decimal
     1749   ) :
     1750   define variable v-day-amount as character no-undo .
     1751     v-day-amount = substitute (
     1752       '<td colspan="3">средн.чек: &1</td><td num="0.00" val="&2" class="sumtotal">&2</td><td><br /></td><td num="0.00" val="&3" class="sumtotal">&3</td>'
     1753       , ROUND(p-total1 / p-numchk-fisc, 2)
     1754       , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1755       , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1756     ) .
     1757     return v-day-amount .
     1758   end function .
     1759   define VARIABLE v-report-id         as integer   no-undo .
     1760   define variable v-report-name       as character no-undo .
     1761   define variable v-file-name-rep-htm as character no-undo .
     1762   define stream OutStr-html.
     1763   define variable v-vsex-cas  as character no-undo.
     1764   define variable v-avg-chk   as decimal decimals  2 no-undo .
     1765   define variable v-times     as character no-undo.
     1766   define variable v-td-date   as character no-undo.
     1767   define variable v-pcnt      as decimal decimals  2 no-undo .
     1768   define variable v-accum     as decimal no-undo .
     1769   define variable v-accum-b   as decimal no-undo .
     1770   define variable v-accum-r   as decimal no-undo .
     1771   define variable v-accum-t   as decimal no-undo .
     1772   define variable v-accum-s   as decimal no-undo .
     1773   define variable v-chk-count as integer no-undo .
     1774   define variable v-err-message as character no-undo .
     1775   define query qben-chk-count for ben-chk-count .
     1776   empty temp-table benefits .
     1777   empty temp-table inkas-num .
     1778   empty temp-table day_sum .
     1779   empty temp-table all-days_sum .
     1780   empty temp-table ben-chk-count .
     1781   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1782   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1783     (output v-curr-r-b
     1784     )  .
     1785   if v-curr-r-b = 'base':U then do:
     1786       sale-price-type = base-type.
     1787   end.
     1788   else sale-price-type = "рублей".
     1789   run no-benqi(output NotInc).
     1790     run rep/r-beneq1.p (
     1791                    input parparentproc
     1792                   ,input cas-num
     1793                   ,input no
     1794                   ,input v-curr-r-b
     1795                   ,output allday-basesum
     1796                   ,output allday-Rublsum
     1797                   ,output ObjAmount
     1798                   ,output ChkAmount
     1799                   ) no-error.
     1800     if error-status:error then do :
     1801       v-err-message = substitute("Ошибка формирования отчёта&1&2&1&3&1всего ошибок &4",
     1802                                  chr(10), return-value, error-status:get-message(1), error-status:num-messages) .
     1803       message v-err-message view-as alert-box.
     1804       return error return-value.
     1805     end .
     1806   if not can-find (first benefits) then do:
     1807     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     1808     return.
     1809   end.
     1810   if x-date-start = x-date-end
     1811   then choice = TRUE .
     1812   else choice = HowBreak .
     1813       run prn-lib-get-report-name  in this-procedure (
     1814                                                          input parParentProc
     1815                                                         ,output v-report-name
     1816                                                       ).
     1817     assign
     1818       v-file-name-rep-htm = v-report-name + ".html"
     1819       date_string = cur-time-print()
     1820       v-vsex-cas = IF cas-num = 0 then "ВСЕХ КАСС" ELSE ("КАССЫ " + string(cas-num))
     1821       v-avg-chk  = if ChkAmount > 0 then round(
     1822    AllDay-BaseSum / ChkAmount
     1823                          , 2 ) else 0
     1824     .
     1825   do :
     1826     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1827     put stream OutStr-html unformatted
     1828       "<!DOCTYPE HTML>" skip
     1829       '<html>' skip
     1830       '<head>' skip
     1831       '  <meta charset="utf-8">' skip
     1832       '  <style type="text/css">' skip
     1833       '      table ~{border-collapse: collapse~;~}' skip
     1834       '      tbody td, th ~{border: 1px solid black~; height: 14px~;}' skip
     1835       '      tbody td:nth-child(4), tbody td:nth-child(5), tbody td:nth-child(6) ~{text-align: right~; padding-right: 4px~;~}' skip
     1836       '      tfoot td ~{height: 14px~;}' skip
     1837       '      .sumtotal ~{text-align: right~; padding-right: 4px~;~}' skip
     1838       '  </style>' skip
     1839       '</head>' skip
     1840       '<body>' skip
     1841       '<TABLE name="1" fit_to_page="true" orientation="portrait">' skip
     1842       '<thead>' skip
     1843       '  <tr class="set_columns">' skip
     1844       '    <td style="width:  53px;"></td>' skip
     1845       '    <td style="width: 124px;"></td>' skip
     1846       '    <td style="width: 31px;"></td>' skip
     1847       '    <td style="width: 71px;"></td>' skip
     1848       '    <td style="width: 63px;"></td>' skip
     1849       '    <td style="width: 63px;"></td>' skip
     1850       '    <td style="width: 49px;"></td>' skip
     1851       '    <td style="width: 41px;"></td>' skip
     1852       '  </tr>' skip
     1853       '  <tr>' skip
     1854       '    <td colspan="8">' + date_string + '</td>' skip
     1855       '  </tr>' skip
     1856       '  <tr>' skip
     1857       '    <td colspan="8">ОТЧЕТ  О  ВЫРУЧКЕ  ' + str1
     1858            + '<br />' + str4
     1859            + '<br />( сформирован по ВСЕМ ЧЕКАМ '
     1860            + (IF NotInc then v-vsex-cas + ", включая невошедшие в отчеты о продажах" else v-vsex-cas )
     1861            + ' )'
     1862            + '<br />'
     1863            + substitute("( всего чеков : &1, в среднем &2 &3 / чек )",  ChkAmount,  v-avg-chk,  sale-price-type  )
     1864            + '</td>' skip
     1865       '  </tr>' skip
     1866     .
     1867     put stream OutStr-html unformatted
     1868       '</thead>' skip
     1869       '<tbody>' skip
     1870       '  <tr>' skip
     1871       '    <th>Дата</th>' skip
     1872       '    <th>Вид оплаты</th>' skip
     1873       '    <th></th>' skip
     1874       '    <th>Сумма в ' (if v-curr-r-b = 'base':U then 'Б.Вал.' else 'рублях') '</th>' skip
     1875       '    <th></th>' skip
     1876       '    <th></th>' skip
     1877       '    <th>~% от суммы</th>' skip
     1878       '    <th>Кол-во фиск. чеков</th>' skip
     1879       '  </tr>' skip
     1880     .
     1881   end .
     1882   FOR EACH obj-list WHERE
     1883             obj-list.obj-type = 'маг':U ,
     1884       EACH all-days_sum WHERE
     1885             all-days_sum.obj-type = obj-list.obj-type AND
     1886             all-days_sum.obj-code = obj-list.obj-code
     1887   BREAK
     1888   BY obj-list.obj-type
     1889   BY obj-list.obj-code :
     1890     ACCUMULATE
     1891     all-days_sum.tot-base ( TOTAL )
     1892     all-days_sum.tot-rubl ( TOTAL )
     1893     all-days_sum.tot-r-b  ( TOTAL )
     1894     all-days_sum.chk-cnt-all ( TOTAL )
     1895     all-days_sum.chk-cnt-nf  ( TOTAL )
     1896     obj-list.obj-code ( COUNT ) .
     1897       run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1898                                     ", компоновка отчёта " ) .
     1899       FIND FIRST clients no-lock
     1900            WHERE clients.obj-type = obj-list.obj-type
     1901              AND clients.obj-code = obj-list.obj-code no-error .
     1902       put stream OutStr-html unformatted
     1903         '  <tr><td colspan="8">'
     1904         if available clients then clients.obj-name else '<br />'
     1905         '</td></tr>' skip
     1906       .
     1907     if choice then do:
     1908       FOR EACH benefits WHERE
     1909                 benefits.obj-type = obj-list.obj-type AND
     1910                 benefits.obj-code = obj-list.obj-code
     1911       BREAK
     1912       BY benefits.obj-type
     1913       BY benefits.obj-code
     1914       BY benefits.date_
     1915       BY benefits.pay-code
     1916       BY benefits.curr-code :
     1917         if first-of( benefits.date_ ) then do:
     1918           FIND FIRST day_sum WHERE
     1919                     day_sum.obj-type = obj-list.obj-type AND
     1920                     day_sum.obj-code = obj-list.obj-code AND
     1921                     day_sum.date_ = benefits.date_   NO-ERROR.
     1922           DatePrinted = FALSE .
     1923         end.
     1924         benefits.pcnt = round( benefits.tot-rubl / day_sum.tot-rubl * 100 , 2 ) .
     1925         if benefits.tot-base <> 0 or day_sum.chk-cnt-all > 0 or day_sum.chk-cnt-nf > 0
     1926         then do:
     1927           if DatePrinted then assign
     1928             v-td-date = '<br />'
     1929           .
     1930           else assign
     1931             v-td-date   = string(benefits.date_)
     1932             DatePrinted = TRUE
     1933           .
     1934           open query qben-chk-count
     1935            preselect each ben-chk-count
     1936                     where ben-chk-count.date_     = benefits.date_
     1937                       and ben-chk-count.pay-code  = benefits.pay-code
     1938                       and ben-chk-count.obj-code  = obj-list.obj-code
     1939                       and ben-chk-count.obj-type  = obj-list.obj-type
     1940                       and ben-chk-count.curr-code = benefits.curr-code.
     1941           v-chk-count = query qben-chk-count:num-results .
     1942           close query qben-chk-count.
     1943           put stream OutStr-html unformatted
     1944             '  <tr>'
     1945                 '<td>' + v-td-date + '</td>'
     1946                 '<td>' + benefits.pay-name + '</td>'
     1947                 putRowAmount1 ("", benefits.tot-r-b)
     1948             substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(benefits.pcnt,    "->>9.99",2)  )
     1949             substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     1950             '</tr>' skip
     1951           .
     1952         end.
     1953         if last-of( benefits.date_ ) then  do:
     1954           if day_sum.chk-cnt-all > day_sum.chk-cnt-nf then do:
     1955             put stream OutStr-html unformatted
     1956               '  <tr>'
     1957               putRowDayTotal1 ( day_sum.chk-cnt-all - day_sum.chk-cnt-nf, day_sum.tot-r-b )
     1958               '<td>100.00%</td>'
     1959               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  day_sum.chk-cnt-all - day_sum.chk-cnt-nf  )
     1960               '</tr>' skip
     1961             .
     1962           end.
     1963         end.
     1964         if last-of (benefits.obj-code) then do:
     1965           put stream OutStr-html unformatted
     1966               '<tr><td colspan="3">ИТОГО:</td>'
     1967               substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     1968               '<td></td>'
     1969               '<td></td>'
     1970               '<td>100.00%</td>'
     1971               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     1972               '</tr>' skip
     1973           .
     1974         end.
     1975       END.
     1976     end.
     1977     else do:
     1978       FOR EACH benefits WHERE
     1979                benefits.obj-type = obj-list.obj-type AND
     1980                benefits.obj-code = obj-list.obj-code
     1981       BREAK
     1982       BY benefits.obj-type
     1983       BY benefits.obj-code
     1984       BY benefits.pay-code
     1985       BY benefits.curr-code :
     1986         ACCUMULATE
     1987           benefits.tot-base ( TOTAL )
     1988           benefits.tot-rubl ( TOTAL )
     1989           benefits.tot-r-b ( TOTAL )
     1990           benefits.tot-sum ( SUB-TOTAL BY benefits.curr-code )
     1991           benefits.tot-base ( SUB-TOTAL BY benefits.curr-code )
     1992           benefits.tot-rubl ( SUB-TOTAL BY benefits.curr-code )
     1993           benefits.tot-r-b ( SUB-TOTAL BY benefits.curr-code )
     1994         .
     1995         if first-of( benefits.curr-code ) then do:
     1996           v-accum-b = 0 .
     1997           v-accum-t = 0 .
     1998           define buffer buf_benefits for benefits .
     1999           for each buf_benefits where buf_benefits.obj-type  = benefits.obj-type
     2000                                   and buf_benefits.obj-code  = benefits.obj-code
     2001                                   and buf_benefits.pay-code  = benefits.pay-code
     2002                                   and buf_benefits.curr-code = benefits.curr-code :
     2003             v-accum-b = v-accum-b + buf_benefits.tot-base .
     2004             v-accum-t = v-accum-t + buf_benefits.tot-r-b .
     2005           end .
     2006         end.
     2007         if last-of( benefits.curr-code ) then do:
     2008           define variable v-if-accum as decimal no-undo .
     2009             v-if-accum = v-accum-t .
     2010           if v-if-accum <> 0 then do :
     2011           open query qben-chk-count
     2012            preselect each ben-chk-count
     2013                     where ben-chk-count.obj-type  = obj-list.obj-type
     2014                       and ben-chk-count.obj-code  = obj-list.obj-code
     2015                       and ben-chk-count.pay-code  = benefits.pay-code
     2016                       and ben-chk-count.curr-code = benefits.curr-code.
     2017           v-chk-count = query qben-chk-count:num-results .
     2018           close query qben-chk-count.
     2019           put stream OutStr-html unformatted
     2020             '  <tr>'
     2021                 '<td></td>'
     2022                 '<td>' + benefits.pay-name + '</td>'
     2023           .
     2024           v-pcnt = round(  v-accum-t  /  all-days_sum.tot-r-b  *  100   , 2 ) .
     2025           v-accum = v-accum-t .
     2026           put stream OutStr-html unformatted
     2027             putRowAmount1 ("", v-accum)
     2028           .
     2029             put stream OutStr-html unformatted
     2030               substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(v-pcnt,"->>9.99",2)  )
     2031               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2032               '</tr>' skip
     2033             .
     2034           end.
     2035         end.
     2036         if last-of (benefits.obj-code) then do:
     2037           put stream OutStr-html unformatted
     2038               '  <tr><td colspan="3">ИТОГО:</td>'
     2039               substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL benefits.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2040               '<td></td>'
     2041               '<td></td>'
     2042               '<td>100.00%</td>'
     2043               substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     2044               '</tr>' skip
     2045           .
     2046         end.
     2047       END.
     2048     end.
     2049     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then  do:
     2050       put stream OutStr-html unformatted
     2051         '<tr><td colspan="3">ИТОГО по всем</td>' +
     2052         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2053         '<td></td>'
     2054         '<td></td>'
     2055         '<td></td>'
     2056         substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',
     2057           (ACCUM TOTAL all-days_sum.chk-cnt-all) - (ACCUM TOTAL all-days_sum.chk-cnt-nf)  )
     2058         '</tr>' skip
     2059       .
     2060     end.
     2061   END.
     2062   if choice AND ( ObjAmount > 1 ) then do:
     2063     FOR EACH benefits
     2064     BREAK
     2065     BY benefits.pay-code :
     2066       ACCUMULATE
     2067       benefits.tot-base ( SUB-TOTAL BY benefits.pay-code )
     2068       benefits.tot-rubl ( SUB-TOTAL BY benefits.pay-code )
     2069       benefits.tot-r-b  ( SUB-TOTAL BY benefits.pay-code )
     2070       .
     2071       if last-of( benefits.pay-code ) AND
     2072           ( ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base ) <> 0 then do:
     2073         open query qben-chk-count
     2074          preselect each ben-chk-count
     2075                   where ben-chk-count.pay-code  = benefits.pay-code.
     2076         v-chk-count = query qben-chk-count:num-results .
     2077         close query qben-chk-count.
     2078         put stream OutStr-html unformatted
     2079           substitute(  '  <tr><td colspan="3">/итого по &1</td>',  benefits.pay-name  )
     2080           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-r-b,"->>>>>>>>>>>9.99",2)  )
     2081           '<td></td>'
     2082           '<td></td>'
     2083           '<td></td>'
     2084           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2085           '</tr>' skip
     2086         .
     2087       end.
     2088     END.
     2089   end.
     2090   put stream OutStr-html unformatted
     2091     '</tbody>' skip
     2092     '<tfoot>' skip
     2093   .
     2094   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2095     put stream OutStr-html unformatted
     2096       '  <tr><td colspan="8"><br /></td></tr>' skip
     2097       '  <tr><td colspan="4">Директор _______________</td><td colspan="4">Старший продавец ______________</td></tr>' skip
     2098       '  <tr><td colspan="8"><br /></td></tr>' skip
     2099       '  <tr><td colspan="4">Бухгалтер ______________</td><td colspan="4">Кассир ________________________</td></tr>' skip
     2100     .
     2101   end.
     2102   put stream OutStr-html unformatted
     2103     '</tfoot>' skip
     2104     '</table>' skip
     2105     '</body>' skip
     2106     '</html>' skip
     2107   .
     2108   output stream OutStr-html close.
     2109   run prn-lib-reportviewer in this-procedure (
     2110       input this-procedure
     2111       ,input v-file-name-rep-htm
     2112       ,input ""
     2113       ) no-error.
     2114   if error-status:error then
     2115   do:
     2116       message return-value view-as alert-box.
     2117       return .
     2118   end.
