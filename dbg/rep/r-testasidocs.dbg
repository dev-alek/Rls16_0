     5769       '</body>' skip
     5770       '</html>' skip
     5771     .
     5772     output stream OutStr-html close.
     5773     run prn-lib-reportviewer-report-name in this-procedure (
     5774       input THIS-PROCEDURE
     5775       ,input v-file-name-rep-htm
     5776       ).
     5777   end procedure .
     5778   PROCEDURE get-report-num :
     5779     define output parameter p-report-num as integer no-undo .
     5780     do
     5781       on error undo, return error return-value
     5782       :
     5783       run gbl/getrpnum.p (output p-report-num).
     5784     end.
     5785   END PROCEDURE.
