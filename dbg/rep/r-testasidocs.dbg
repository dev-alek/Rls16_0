     5154   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5155   define  stream PrnLibStream.
     5156   procedure prn-lib-prn-file :
     5157     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5158     define input parameter p-DIsabledoptions as integer no-undo .
     5159     define variable v-report-name as character no-undo .
     5160     define variable v-user-action as character no-undo .
     5161     define variable v-printed     as logical   no-undo .
     5162     define variable v-exist       as logical   no-undo .
     5163     do
     5164       on error undo, return error
     5165       :
     5166       run prn-lib-get-report-name  in this-procedure (
     5167         input parParentProc
     5168         ,output v-report-name
     5169         ).
     5170   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     5172     (input  v-report-name
     5173     ,input  2
     5174     ,output v-exist
     5175     )  .
     5176       if NOT v-exist then
     5177       DO:
     5178         Message
     5179           "Нет заданий на печать ! "
     5180           view-as alert-box .
     5181         Return  .
     5182       End.
     5183       run gbl/prnfilen.w
     5184         (input  ""
     5185         ,input  p-DisabledOptions
     5186         ,input  string(v-report-name )
     5187         ,input  7
     5188         ,output v-user-action
     5189         ,output v-printed
     5190         ) .
     5191       if v-printed then
     5192       do:
     5193         return "YES" .
     5194       end.
     5195       else
     5196       do:
     5197         return "NO" .
     5198       end.
     5199     end.
     5200   end procedure.
     5201   procedure prn-lib-open-stream :
     5202     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5203     define input parameter p-page-size    as integer no-undo .
     5204     define input parameter p-is-stream    as logical no-undo .
     5205     define input parameter p-append       as logical no-undo .
     5206     define variable v-report-name as character no-undo .
     5207     do
     5208       on error undo, return error
     5209       :
     5210       run prn-lib-get-report-name  in this-procedure (
     5211         input parParentProc
     5212         ,output v-report-name
     5213         ).
     5214       if p-is-stream then
     5215       do:
     5216         if p-append then
     5217         do:
     5218           output stream PrnLibStream to value( v-report-name )
     5219             page-size value(p-page-size) append .
     5220         end.
     5221         if not p-append then
     5222         do:
     5223           output stream PrnLibStream to value( v-report-name )
     5224             page-size value(p-page-size) .
     5225         end.
     5226       end.
     5227       if not p-is-stream then
     5228       do:
     5229         if p-append then
     5230         do:
     5231           output to value( v-report-name )
     5232             page-size value(p-page-size) append .
     5233         end.
     5234         if not p-append then
     5235         do:
     5236           output to value( v-report-name )
     5237             page-size value(p-page-size) .
     5238         end.
     5239       end.
     5240     end.
     5241   end procedure.
     5242   procedure prn-lib-open-exp :
     5243     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5244     define input parameter p-is-stream    as logical no-undo .
     5245     define input parameter p-is-append    as logical no-undo .
     5246     define output parameter p-ReportFileName as char init "report" no-undo.
     5247     define output parameter p-process as logical no-undo .
     5248     define variable glog as logical no-undo .
     5249     do
     5250       on error undo, return error
     5251       :
     5252       SYSTEM-DIALOG GET-FILE p-ReportFileName
     5253         TITLE      "Укажите путь"
     5254         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     5255         ASK-OVERWRITE
     5256         CREATE-TEST-FILE
     5257         SAVE-AS
     5258         USE-FILENAME
     5259         DEFAULT-EXTENSION "txt"
     5260         UPDATE glog
     5261         .
     5262       if not glog then  return.
     5263       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     5264       if p-is-stream then
     5265       do:
     5266         if p-is-append then
     5267         do:
     5268           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5269         end.
     5270         else
     5271         do:
     5272           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5273         end.
     5274       end.
     5275       else
     5276       do:
     5277         if p-is-append then
     5278         do:
     5279           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5280         end.
     5281         else
     5282         do:
     5283           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5284         end.
     5285       end.
     5286       p-process = yes.
     5287     end.
     5288   end procedure.
     5289   procedure prn-lib-get-report-name :
     5290     define input parameter parParentProc  as widget-handle no-undo.
     5291     define output parameter p-report-name as character no-undo .
     5292     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     5293   end procedure.
