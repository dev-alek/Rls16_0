     2138           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     2139           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     2140           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2141           v-torgconf-self-obj-phone      = v-fmtcli-phone
     2142           v-torgconf-self-obj-inn        = v-fmtcli-inn
     2143           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     2144       .
     2145   end.
     2146   end procedure.
     2147   procedure torgconf-get-recepient-param :
     2148   define input parameter torgconfdoc-code   as character                  no-undo.
     2149   define output parameter v-code-rec        as integer                    no-undo .
     2150   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     2151   define output parameter v-codefirm-rec    as integer                    no-undo .
     2152   define output parameter v-curcode-rec     as integer                    no-undo .
     2153        define variable  v-recipient-code  as character                  no-undo .
     2154        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     2155        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     2156   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     2157                           input 'Recipient':U ,
     2158                          output v-recipient-code ,
     2159                          output v-trdcattr-type ) no-error .
     2160       if error-status :error then do:
     2161        message
     2162         vss-workfile vss-revision vss-description skip
     2163         "Ошибка при вызове процедуры tdat-val":U skip
     2164         "Документ: " torgconfdoc-code skip
     2165         "Атрибут: " 'Recipient':U skip
     2166         "Значение: " v-recipient skip
     2167         trim( error-status :get-message (1) ) skip
     2168         return-value skip
     2169         view-as alert-box error.
     2170       undo, return error return-value.
     2171       end.
     2172     assign
     2173       v-recipient  = v-recipient-code
     2174       v-type-rec = substring(v-recipient-code,1,3)
     2175       v-code-rec  = int(substring(v-recipient-code,4,15))
     2176       no-error
     2177     .
     2178     if v-type-rec = ? then v-type-rec = "" .
     2179     if v-code-rec  = ? then v-code-rec  =  0 .
     2180     end procedure.
