     2376   procedure torgconf-get-sup-param :
     2377   define input parameter p-obj-type           as character        no-undo.
     2378   define input parameter p-obj-code           as integer          no-undo.
     2379   define input parameter p-curr-code          as integer          no-undo.
     2380       define variable v-host-code    as integer      no-undo.
     2381       define variable v-par-type     as character    no-undo.
     2382   do
     2383   on error undo, return error
     2384   :
     2385       assign
     2386          v-torgconf-sup-host-code = v-host-code
     2387       .
     2388       if v-torgconf-sup-host-code = 0
     2389       then do:
     2390           assign
     2391               v-torgconf-sup-host-name           = "":U
     2392               v-torgconf-sup-host-addres         = "":U
     2393               v-torgconf-sup-host-post-addres    = "":U
     2394               v-torgconf-sup-host-phone          = "":U
     2395               v-torgconf-sup-host-inn            = "":U
     2396               v-torgconf-sup-host-kpp            = "":U
     2397               v-torgconf-sup-host-okpo           = "":U
     2398               v-torgconf-sup-host-egrip-date     = "":U
     2399               v-torgconf-sup-host-egrip-num      = "":U
     2400           .
     2401       end.
     2402       else do:
     2403           run fmtcli-get-client in this-procedure (
     2404                 input 'орг':U
     2405               , input v-torgconf-sup-host-code
     2406           ).
     2407           assign
     2408               v-torgconf-sup-host-name        = v-fmtcli-name
     2409               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2410               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2411               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2412               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2413               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2414               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2415               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2416           .
     2417           run gbl/clntat-v.p (
     2418                 input 'орг':U
     2419               , input v-torgconf-sup-host-code
     2420               , input 'egrip-date':U
     2421               , output v-torgconf-sup-host-egrip-date
     2422               , output v-par-type
     2423           ).
     2424           run gbl/clntat-v.p (
     2425                 input 'орг':U
     2426               , input v-torgconf-sup-host-code
     2427               , input 'egrip-num':U
     2428               , output v-torgconf-sup-host-egrip-num
     2429               , output v-par-type
     2430           ).
     2431           run fmtcli-get-bank in this-procedure (
     2432                 input v-host-code
     2433               , input 'орг':U
     2434               , input v-torgconf-sup-host-code
     2435               , input p-curr-code
     2436           ).
     2437       end.
     2438       assign
     2439           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2440           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2441           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2442           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2443           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2444           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2445           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2446           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2447       .
     2448       assign
     2449           v-torgconf-sup-obj-type = p-obj-type
     2450           v-torgconf-sup-obj-code = p-obj-code
     2451       .
     2452       if trim(p-obj-type) <> ""
     2453       and p-obj-code <> 0
     2454       then do:
     2455       run fmtcli-get-client in this-procedure (
     2456             input p-obj-type
     2457           , input p-obj-code
     2458       ).
     2459       assign
     2460           v-torgconf-sup-obj-name        = v-fmtcli-name
     2461           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2462           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2463           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2464           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2465           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2466           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2467       .
     2468      end.
     2469      end.
     2470   end procedure.
     2471   procedure torgconf-get-cli-param :
     2472   define input parameter p-host-obj-code      as integer          no-undo.
     2473   define input parameter p-obj-type           as character        no-undo.
     2474   define input parameter p-obj-code           as integer          no-undo.
     2475   define input parameter p-curr-code          as integer          no-undo.
     2476       define variable v-host-code    as integer      no-undo.
     2477   do
     2478   on error undo, return error
     2479   :
     2480       assign
     2481           v-torgconf-cli-type = p-obj-type
     2482           v-torgconf-cli-code = p-obj-code
     2483       .
     2484       run fmtcli-get-client in this-procedure (
     2485             input p-obj-type
     2486           , input p-obj-code
     2487       ).
     2488       assign
     2489           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2490           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2491           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2492           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2493           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2494           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2495           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2496           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2497       .
     2498      run fmtcli-get-bank in this-procedure (
     2499             input p-host-obj-code
     2500           , input p-obj-type
     2501           , input p-obj-code
     2502           , input p-curr-code
     2503       ).
     2504       assign
     2505           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2506           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2507           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2508           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2509           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2510           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2511           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2512           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2513       .
     2514   end.
     2515   end procedure.
     2516   procedure torgconf-get-ship-param :
     2517   define input parameter p-host-obj-code      as integer          no-undo.
     2518   define input parameter p-obj-type           as character        no-undo.
     2519   define input parameter p-obj-code           as integer          no-undo.
     2520   define input parameter p-curr-code          as integer          no-undo.
     2521       define variable v-host-code    as integer      no-undo.
     2522   do
     2523   on error undo, return error
     2524   :
     2525       assign
     2526           v-torgconf-ship-type = p-obj-type
     2527           v-torgconf-ship-code = p-obj-code
     2528       .
     2529       if trim(p-obj-type) = ""
     2530       and p-obj-code = 0
     2531       then do:
     2532       assign
     2533           v-torgconf-ship-name         = "":U
     2534           v-torgconf-ship-addres       = "":U
     2535           v-torgconf-ship-post-addres  = "":U
     2536           v-torgconf-ship-phone        = "":U
     2537           v-torgconf-ship-inn          = "":U
     2538           v-torgconf-ship-kpp          = "":U
     2539           v-torgconf-ship-okpo         = "":U
     2540       .
     2541       end.
     2542       else do:
     2543       run fmtcli-get-client in this-procedure (
     2544             input p-obj-type
     2545           , input p-obj-code
     2546       ).
     2547       assign
     2548           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2549           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2550           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2551           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2552           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2553           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2554           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2555           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2556       .
     2557       end.
     2558           run fmtcli-get-bank in this-procedure (
     2559             input p-host-obj-code
     2560           , input p-obj-type
     2561           , input p-obj-code
     2562           , input p-curr-code
     2563       ).
     2564       assign
     2565           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2566           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2567           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2568           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2569           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2570           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2571           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2572           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2573       .
     2574   end.
     2575   end procedure.
     2576   procedure torgconf-get-holdfirm-code :
     2577   define input parameter p-obj-type   as character        no-undo.
     2578   define input parameter p-obj-code   as integer          no-undo.
     2579   define output parameter p-firm-code as integer          no-undo.
     2580       define variable v-firm-code-str     as character    no-undo.
     2581       define variable v-par-type          as character    no-undo.
     2582       define buffer buf_clients       for ub.clients.
     2583   do
     2584   for buf_clients
     2585   on error undo, return error
     2586   :
     2587       run gbl/clntat-v.p (
     2588             input p-obj-type
     2589           , input p-obj-code
     2590           , input 'holdfirm-code':U
     2591           , output v-firm-code-str
     2592           , output v-par-type
     2593       ).
     2594       assign
     2595           p-firm-code = integer( v-firm-code-str )
     2596       no-error.
     2597       if error-status :error
     2598       then do:
     2599           message
     2600               "Неверно задан код фирмы для печати накладных."
     2601           view-as alert-box warning.
     2602           assign
     2603               p-firm-code = 0
     2604           .
     2605       end.
     2606       else do:
     2607           find first buf_clients no-lock
     2608                where buf_clients.obj-type = 'орг':U
     2609                  and buf_clients.obj-code = p-firm-code
     2610           no-error.
     2611           if not available buf_clients
     2612           then do:
     2613               message
     2614                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2615                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2616               view-as alert-box warning.
     2617               assign
     2618                   p-firm-code = 0
     2619               .
     2620           end.
     2621       end.
     2622   end.
     2623   end procedure.
     2624   procedure torgconf-get-post-head:
     2625   define input  parameter p-obj-type             as character        no-undo.
     2626   define input  parameter p-obj-code             as integer          no-undo.
     2627   define output parameter p-torgconf-post-head   as character        no-undo.
     2628      define variable v-host-code         as integer      no-undo.
     2629      define buffer buf_sysconf     for ub.sysconf.
     2630        assign
     2631         p-torgconf-post-head  = ""
     2632        .
     2633   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2635     (input  p-obj-type
     2636     ,input  p-obj-code
     2637     ,output v-host-code
     2638     )  .
     2639      find first buf_sysconf no-lock
     2640      where buf_sysconf.host-code = v-host-code
     2641      no-error.
     2642      if available buf_sysconf
     2643      then do:
     2644         assign
     2645            p-torgconf-post-head = buf_sysconf.head-position
     2646         .
     2647      end.
     2648   end procedure.
     2649   procedure torgconf-get-storekeeper:
     2650   define input  parameter p-wrkr                   as integer          no-undo.
     2651   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2652   define output parameter p-torgconf-post          as character        no-undo.
     2653      define buffer buf_sysconf     for ub.sysconf.
     2654      define buffer buf_person      for ub.person.
     2655      define buffer buf_shop        for ub.shop .
     2656      define buffer buf_store       for ub.store .
     2657      if v-torgconf-outC = "no_print"
     2658      then do:
     2659         assign p-torgconf-post = ""
     2660                p-torgconf-wrkr-name = ""
     2661                .
     2662      end.
     2663      if v-torgconf-outC = "clad_doc"
     2664      then do:
     2665         run rep/get-psn.p
     2666               (input  p-wrkr
     2667               ,output p-torgconf-wrkr-name
     2668               ) .
     2669         find first buf_person no-lock
     2670         where buf_person.psn-code = p-wrkr
     2671         no-error.
     2672         if available buf_person
     2673         then do:
     2674           p-torgconf-post = buf_person.position.
     2675         end.
     2676         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2677         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2678      end.
     2679      if v-torgconf-outC = "clad_obj"
     2680      then do:
     2681         CASE v-torgconf-self-obj-type:
     2682         WHEN 'маг':U
     2683         THEN DO:
     2684            find first buf_shop no-lock
     2685            where buf_shop.obj-code = v-torgconf-self-obj-code
     2686            .
     2687            assign
     2688               p-torgconf-wrkr-name = buf_shop.store-man
     2689               p-torgconf-post = ""
     2690            .
     2691            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2692         END.
     2693         WHEN 'скл':U
     2694         THEN DO:
     2695            find first buf_store no-lock
     2696            where buf_store.obj-code = v-torgconf-self-obj-code
     2697            .
     2698            assign
     2699               p-torgconf-wrkr-name = buf_store.store-man
     2700               p-torgconf-post = ""
     2701            .
     2702            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2703         END.
     2704         OTHERWISE DO:
     2705            assign
     2706               p-torgconf-post = "":U
     2707               p-torgconf-wrkr-name = "":U
     2708            .
     2709         END.
     2710         END CASE.
     2711      end.
     2712    end procedure.
     2713   procedure torgconf-get-form-header :
     2714   define input parameter p-for-inverse    as logical          no-undo.
     2715   define input parameter p-doc-code       as character        no-undo.
     2716   define input parameter p-print-doc      as logical          no-undo.
     2717   define input parameter p-doc-date       as date             no-undo.
     2718   define input parameter p-fact-date      as date             no-undo.
     2719   define input parameter p-doc-type       as character        no-undo.
     2720   define input parameter p-status_        as character        no-undo.
     2721   define input parameter p-reverse        as logical          no-undo.
     2722   define input parameter p-sf-par         as logical          no-undo.
     2723       define variable v-attr-type         as character    no-undo.
     2724       define variable v-doc-code-standard as logical      no-undo.
     2725       define variable v-doc-date-standard as logical      no-undo.
     2726       define variable v-par-consignee-addres  as character    no-undo.
     2727       define variable v-host-code         as integer      no-undo.
     2728       define variable v-dcode-attr        as character    no-undo.
     2729       define variable v-ddate-attr        as character    no-undo.
     2730       define variable v-doc-date          as character    no-undo.
     2731       define variable v-doc-code          as character    no-undo.
     2732       define variable v-par-type          as character    no-undo.
     2733       define variable v-attr              as character    no-undo.
     2734       define buffer buf_firm          for ub.firm .
     2735       define buffer buf_clients       for ub.clients .
     2736       define buffer buf_sysconf       for ub.sysconf .
     2737       define buffer buf_shop          for ub.shop .
     2738       define buffer buf_store         for ub.store .
     2739       define buffer buf_person        for ub.person .
     2740       define buffer buf_trn-doc       for ub.trn-doc .
     2741       define buffer buf_wth-doc       for ub.wth-doc .
     2742       do
     2743   for buf_firm
     2744     , buf_clients
     2745     , buf_sysconf
     2746     , buf_shop
     2747     , buf_trn-doc
     2748     , buf_person
     2749     , buf_wth-doc
     2750   on error undo, return error
     2751   :
     2752       if p-doc-type = 'при':U
     2753       or p-doc-type = 'возврат':U
     2754       then do:
     2755           assign
     2756               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2757                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2758               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2759                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2760               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2761                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2762               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2763                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2764               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2765               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2766               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2767               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2768               v-torgconf-supplier-type    = v-torgconf-cli-type
     2769               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2770               v-torgconf-saler-type       = v-torgconf-self-host-type
     2771               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2772               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2773               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2774               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2775               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2776               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2777               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2778               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2779               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2780               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2781               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2782               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2783               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2784               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2785               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2786           .
     2787           if v-torgconf-cli-schet-exists = yes
     2788           AND v-form-name                  = "torg12":U
     2789           then do:
     2790               assign
     2791                   v-torgconf-supplier = v-torgconf-supplier
     2792                       + substitute( ", р/с &1 к/с &2"
     2793                                   , v-torgconf-cli-bank-r-schet
     2794                                   , v-torgconf-cli-bank-c-schet
     2795                                   )
     2796                   v-torgconf-suppi = v-torgconf-supplier
     2797                       + substitute( ", р/с &1 к/с &2"
     2798                                   , v-torgconf-cli-bank-r-schet
     2799                                   , v-torgconf-cli-bank-c-schet
     2800                                   )
     2801               .
     2802               if v-torgconf-cli-bank-exists = yes
     2803               then do:
     2804                   assign
     2805                       v-torgconf-supplier = v-torgconf-supplier
     2806                           + substitute( " БИК &1 в &2 &3"
     2807                                       , v-torgconf-cli-bank-bik
     2808                                       , v-torgconf-cli-bank-name
     2809                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2810                                       )
     2811                      v-torgconf-suppi = v-torgconf-supplier
     2812                           + substitute( " БИК &1 в &2 &3"
     2813                                       , v-torgconf-cli-bank-bik
     2814                                       , v-torgconf-cli-bank-name
     2815                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2816                                       )
     2817                   .
     2818               end.
     2819           end.
     2820           if v-torgconf-self-schet-exists = yes
     2821           AND v-form-name                  = "torg12":U
     2822           then do:
     2823               assign
     2824                   v-torgconf-saler = v-torgconf-saler
     2825                       + substitute( ", р/с &1 к/с &2"
     2826                                   , v-torgconf-self-bank-r-schet
     2827                                   , v-torgconf-self-bank-c-schet
     2828                                   )
     2829               .
     2830               if v-torgconf-self-bank-exists = yes
     2831               then do:
     2832                   assign
     2833                       v-torgconf-saler = v-torgconf-saler
     2834                           + substitute( " БИК &1 в &2 &3"
     2835                                       , v-torgconf-self-bank-bik
     2836                                       , v-torgconf-self-bank-name
     2837                                       , v-torgconf-self-bank-addres
     2838                                       )
     2839                   .
     2840               end.
     2841           end.
     2842           if v-torgconf-sup-schet-exists = yes
     2843           AND v-form-name                  = "torg12":U
     2844           then do:
     2845               assign
     2846                   v-torgconf-consignee = v-torgconf-consignee
     2847                       + substitute( ", р/с &1 к/с &2"
     2848                                   , v-torgconf-sup-bank-r-schet
     2849                                   , v-torgconf-sup-bank-c-schet
     2850                                   )
     2851               .
     2852             if v-torgconf-sup-bank-exists = yes
     2853              then do:
     2854                assign
     2855                   v-torgconf-consignee = v-torgconf-consignee
     2856                           + substitute( " БИК &1 в &2 &3"
     2857                                       , v-torgconf-sup-bank-bik
     2858                                       , v-torgconf-sup-bank-name
     2859                                       , v-torgconf-sup-bank-addres
     2860                                       )
     2861                   .
     2862               end.
     2863           end.
     2864      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2865      then do:
     2866          assign
     2867            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2868                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2869                                                   , v-torgconf-cli-name
     2870                                                   , ( if v-torgconf-outprncd = yes
     2871                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2872                                                         else "":U )
     2873                                                   , v-torgconf-cli-post-addres
     2874                                                   , v-torgconf-cli-phone
     2875                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2876                                                       AND v-form-name                  = "torg12":U
     2877                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2878                                                               , v-torgconf-cli-bank-r-schet
     2879                                                               , v-torgconf-cli-bank-c-schet
     2880                                                               , v-torgconf-cli-bank-bik
     2881                                                               , v-torgconf-cli-bank-name
     2882                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2883                                                         else "":U )
     2884                                                )
     2885         .
     2886      end.
     2887       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2888                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2889                                        , v-torgconf-cli-name
     2890                                        , ( if v-torgconf-outprncd = yes
     2891                                            then substitute( " (&1)", v-torgconf-cli-code )
     2892                                            else "":U )
     2893                                        , v-torgconf-cli-addres
     2894                                        , v-torgconf-cli-phone
     2895                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2896                                            AND v-form-name                  = "torg12":U
     2897                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2898                                                           , v-torgconf-cli-bank-r-schet
     2899                                                           , v-torgconf-cli-bank-c-schet
     2900                                                           , v-torgconf-cli-bank-bik
     2901                                                           , v-torgconf-cli-bank-name
     2902                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2903                                                   else "":U )
     2904                                        ).
     2905       end.
     2906       else do:
     2907       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2908                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2909                                        , v-torgconf-self-host-name
     2910                                        , ( if v-torgconf-outprncd = yes
     2911                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2912                                            else "":U )
     2913                                        , v-torgconf-self-host-addres
     2914                                        , v-torgconf-self-host-phone
     2915                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2916                                            AND v-form-name                  = "torg12":U
     2917                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2918                                                           , v-torgconf-self-bank-r-schet
     2919                                                           , v-torgconf-self-bank-c-schet
     2920                                                           , v-torgconf-self-bank-bik
     2921                                                           , v-torgconf-self-bank-name
     2922                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2923                                                   else "":U )
     2924                                           ).
     2925         if v-torgconf-outares = yes
     2926         and p-reverse = no
     2927         then do:
     2928            assign
     2929               v-par-consignee-addres = v-torgconf-ship-post-addres
     2930            .
     2931         end.
     2932         if v-torgconf-outares = no
     2933         and p-reverse = no
     2934         then do:
     2935            assign
     2936               v-par-consignee-addres = v-torgconf-ship-addres
     2937            .
     2938         end.
     2939         if p-reverse = yes
     2940         then do:
     2941             assign
     2942               v-par-consignee-addres = v-torgconf-ship-addres
     2943             .
     2944         end.
     2945           assign
     2946               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2947                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2948               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2949                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2950               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2951                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2952               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2953               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2954               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2955               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2956               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2957               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2958               v-torgconf-saler-type       = v-torgconf-cli-type
     2959               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2960               v-torgconf-consignee-type   = v-torgconf-ship-type
     2961               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2962               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2963               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2964               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2965               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2966               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2967               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2968               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2969               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2970               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2971               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2972               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2973               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2974               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2975               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2976               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2977               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2978           .
     2979           if v-torgconf-self-schet-exists = yes
     2980           AND v-form-name                  = "torg12":U
     2981           then do:
     2982               assign
     2983                   v-torgconf-supplier = v-torgconf-supplier
     2984                       + substitute( ", р/с &1 к/с &2"
     2985                                   , v-torgconf-self-bank-r-schet
     2986                                   , v-torgconf-self-bank-c-schet
     2987                                   )
     2988               .
     2989               if v-torgconf-self-bank-exists = yes
     2990               then do:
     2991                   assign
     2992                       v-torgconf-supplier = v-torgconf-supplier
     2993                           + substitute( " БИК &1 в &2 &3"
     2994                                       , v-torgconf-self-bank-bik
     2995                                       , v-torgconf-self-bank-name
     2996                                       , v-torgconf-self-bank-addres
     2997                                       )
     2998                   .
     2999               end.
     3000           end.
     3001           if v-torgconf-cli-schet-exists = yes
     3002           AND v-form-name                  = "torg12":U
     3003           then do:
     3004               assign
     3005                   v-torgconf-saler = v-torgconf-saler
     3006                       + substitute( ", р/с &1 к/с &2"
     3007                                   , v-torgconf-cli-bank-r-schet
     3008                                   , v-torgconf-cli-bank-c-schet
