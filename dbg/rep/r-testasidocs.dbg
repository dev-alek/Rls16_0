     4443                  run rep/get-psn.p
     4444                  (input buf_wth-doc.deliver
     4445                  ,output v-torgconf-ogr-name
     4446                  ) .
     4447               end.
     4448               find first buf_person no-lock
     4449               where buf_person.psn-code = buf_wth-doc.deliver
     4450               no-error.
     4451               if available buf_person
     4452               then do:
     4453                  v-torgconf-ogr-post = buf_person.position.
     4454               end.
     4455               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4456               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4457            end.
     4458      end.
     4459   end.
     4460   procedure torgconf-get-reason  :
     4461   define input parameter  p-doc-code       as character        no-undo.
     4462   define input parameter  p-reason-code    as integer          no-undo .
     4463   define input parameter  p-doc-type       as character        no-undo.
     4464       if p-reason-code > 0
     4465       then do:
     4466           define buffer buf_trn-reason for ub.trn-reason.
     4467           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4468           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4469       end.
     4470       else do:
     4471           if p-doc-type = 'при':U
     4472           then  do:
     4473               define variable v-attr-type     as character    no-undo.
     4474               define variable v-attr-value    as character    no-undo.
     4475               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4476               assign v-torgconf-reason = v-attr-value .
     4477               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4478               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4479           end.
     4480       end.
     4481   end procedure.
     4482   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4483   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4484   procedure paramls-clear :
     4485     define buffer buf_temp-param for temp-param .
     4486     do
     4487     on error undo, return error return-value
     4488     :
     4489       for each buf_temp-param
     4490       on error undo, return error
     4491       :
     4492         delete buf_temp-param .
     4493       end.
     4494     end.
     4495   end procedure.
     4496   procedure paramls-write :
     4497     define input  parameter p-code     as character no-undo .
     4498     define input  parameter p-sub-code as character no-undo .
     4499     define input  parameter p-value    as character no-undo .
     4500     define buffer buf_temp-param for temp-param .
     4501     do
     4502     on error undo, return error return-value
     4503     :
     4504       find first buf_temp-param
     4505         where buf_temp-param.param-code     = p-code
     4506           and buf_temp-param.param-sub-code = p-sub-code
     4507         no-error .
     4508       if not available buf_temp-param then do:
     4509         create buf_temp-param .
     4510         assign
     4511           buf_temp-param.param-code     = p-code
     4512           buf_temp-param.param-sub-code = p-sub-code
     4513         .
     4514       end.
     4515       assign
     4516         buf_temp-param.param-value = p-value
     4517       .
     4518     end.
     4519   end procedure.
     4520   procedure paramls-read :
     4521     define input  parameter p-code          as character no-undo .
     4522     define input  parameter p-sub-code      as character no-undo .
     4523     define input  parameter p-default-value as character no-undo .
     4524     define output parameter p-value         as character no-undo .
     4525     define buffer buf_temp-param for temp-param .
     4526     do
     4527     on error undo, return error return-value
     4528     :
     4529       find first buf_temp-param
     4530         where buf_temp-param.param-code     = p-code
     4531           and buf_temp-param.param-sub-code = p-sub-code
     4532         no-error .
     4533       if available buf_temp-param then do:
     4534         assign
     4535           p-value = buf_temp-param.param-value
     4536         .
     4537       end.
     4538       else do:
     4539         assign
     4540           p-value = p-default-value
     4541         .
     4542       end.
     4543     end.
     4544   end procedure.
     4545   procedure paramls-append :
     4546     define input  parameter p-code     as character no-undo .
     4547     define input  parameter p-sub-code as character no-undo .
     4548     define input  parameter p-value    as character no-undo .
     4549     define buffer buf_temp-param for temp-param .
     4550     do
     4551     on error undo, return error return-value
     4552     :
     4553       find first buf_temp-param
     4554            where buf_temp-param.param-code     = p-code
     4555              and buf_temp-param.param-sub-code = p-sub-code
     4556         no-error .
     4557       if not available buf_temp-param then do:
     4558         create buf_temp-param .
     4559         assign
     4560           buf_temp-param.param-code     = p-code
     4561           buf_temp-param.param-sub-code = p-sub-code
     4562           buf_temp-param.param-value    = p-value
     4563         .
     4564       end.
     4565       else do:
     4566           assign
     4567               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4568           .
     4569       end.
     4570     end.
     4571   end procedure.
