     2071               v-torgconf-self-host-name           = "":U
     2072               v-torgconf-self-host-addres         = "":U
     2073               v-torgconf-self-host-post-addres    = "":U
     2074               v-torgconf-self-host-phone          = "":U
     2075               v-torgconf-self-host-inn            = "":U
     2076               v-torgconf-self-host-kpp            = "":U
     2077               v-torgconf-self-host-okpo           = "":U
     2078               v-torgconf-self-host-egrip-date     = "":U
     2079               v-torgconf-self-host-egrip-num      = "":U
     2080           .
     2081       end.
     2082       else do:
     2083           run fmtcli-get-client in this-procedure (
     2084                 input 'орг':U
     2085               , input v-torgconf-self-host-code
     2086           ).
     2087           assign
     2088               v-torgconf-self-host-name        = v-fmtcli-name
     2089               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     2090               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     2091               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     2092               v-torgconf-self-host-phone       = v-fmtcli-phone
     2093               v-torgconf-self-host-inn         = v-fmtcli-inn
     2094               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     2095               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     2096           .
     2097           run gbl/clntat-v.p (
     2098                 input 'орг':U
     2099               , input v-torgconf-self-host-code
     2100               , input 'egrip-date':U
     2101               , output v-torgconf-self-host-egrip-date
     2102               , output v-par-type
     2103           ).
     2104           run gbl/clntat-v.p (
     2105                 input 'орг':U
     2106               , input v-torgconf-self-host-code
     2107               , input 'egrip-num':U
     2108               , output v-torgconf-self-host-egrip-num
     2109               , output v-par-type
     2110           ).
     2111           run fmtcli-get-bank in this-procedure (
     2112                 input v-host-code
     2113               , input 'орг':U
     2114               , input v-torgconf-self-host-code
     2115               , input p-curr-code
     2116           ).
     2117       end.
     2118       assign
     2119           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     2120           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     2121           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     2122           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     2123           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     2124           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     2125           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     2126           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     2127       .
     2128       assign
     2129           v-torgconf-self-obj-type = p-obj-type
     2130           v-torgconf-self-obj-code = p-obj-code
     2131       .
     2132       run fmtcli-get-client in this-procedure (
     2133             input p-obj-type
     2134           , input p-obj-code
     2135       ).
