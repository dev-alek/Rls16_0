     5298   end procedure.
     5299   procedure prn-lib-reportviewer :
     5300     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5301     define input parameter p-report-name-html as character no-undo .
     5302     define input parameter p-param        as character no-undo .
     5303     define variable v-excel           as character no-undo init 'TRUE' .
     5304     define variable v-value-character as character no-undo .
     5305     define variable v-value-integer   as character no-undo .
     5306     define variable v-value-date      as date      no-undo .
     5307     define variable v-value-decimal   as decimal   no-undo .
     5308     define variable rep-excel         as logical   no-undo .
     5309     define variable excel-string      as character no-undo .
     5310     define variable v-param-type      as character no-undo .
     5311     define variable v-tth             as handle    no-undo .
     5312     run adm/shattri.p (
     5313       input "get":U
     5314       ,input  ""
     5315       ,input  0
     5316       ,input  'report-glob':U
     5317       ,input  'rep-excel':U
     5318       ,output v-value-character
     5319       ,output v-value-date
     5320       ,output v-value-decimal
     5321       ,output v-value-integer
     5322       ,output rep-excel
     5323       ,output v-param-type
     5324       ,INPUT-OUTPUT table-handle v-tth
     5325       )  .
     5326     if rep-excel then v-excel = "TRUE" .
     5327     else v-excel = "FALSE" .
     5328     if p-param eq ""
     5329     then
     5330        p-param = "EXCEL:" + v-excel.
     5331     else
     5332        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     5333     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     5334   end procedure.
     5335   function fnc-convert-dot-to-colon returns character
     5336       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     5337   function fnc-convert-dot-to-colon returns character
     5338   (input p-data as decimal, input p-accur as character, input p-num as integer):
     5339       define variable result as character no-undo.
     5340       define variable v-str-result as character no-undo.
     5341       if p-data = ? then p-data = 0 .
     5342       p-data = round(p-data, p-num).
     5343       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     5344       return v-str-result.
     5345   END FUNCTION.
     5346   define stream OutStr-html.
     5347   DEFINE TEMP-TABLE tt-result
     5348     field num                     as integer
     5349     field obj-type                as character
     5350     field obj-code                as integer
     5351     field obj-name                as character
     5352     field shift-date              like rvs-doc.shift-date
     5353     field shift-num               like rvs-doc.shift-num
     5354     field rvs-code                as character
     5355     field doc-date                as date
     5356     field gds-code                as integer
     5357     field gds-name                as character
     5358     field pl-code                 as integer
     5359     field loc1                    as character
     5360     field state-level-total       as decimal
     5361     field izmer-density           as decimal
     5362     field pomi-density            as decimal
     5363     field state-temperature       as decimal
     5364     field state-mass              as decimal
     5365     field level-total             as decimal
     5366     field density                 as decimal
     5367     field asi-pomi-density        as decimal
     5368     field temperature             as decimal
     5369     field mass                    as decimal
     5370     field diff-density-gram       as decimal
     5371     field diff-density            as decimal
     5372     field diff-mass-kilo          as decimal
     5373     field diff-mass               as decimal
     5374     field test-asi-type           as character
     5375     field asi-type-name           as character
     5376     index pi
     5377       obj-type obj-code rvs-code gds-code pl-code
     5378   .
     5379   function fDec2Str returns character
     5380      (input idec as decimal,
     5381       input iformat as char):
     5382      define variable vdecstr as character no-undo.
     5383      if idec = ? then
     5384         vdecstr = "".
     5385      else
     5386         vdecstr = trim(string(idec, iformat)).
     5387      return vdecstr.
     5388   end function.
     5389   define VARIABLE p-report-id         as character no-undo .
     5390   define variable v-file-name-rep-htm as character no-undo .
     5391   define variable v-period            as character no-undo .
     5392   define variable v-list-obj          as character no-undo .
     5393   define variable v-print-date        as character no-undo .
     5394   define variable ii                  as integer   no-undo .
     5395   define buffer buf_rvs-doc       for ub.rvs-doc .
     5396   define buffer buf_doc-attr      for ub.doc-attr .
     5397   define buffer buf_rvs-line      for ub.rvs-line .
     5398   define buffer buf_rvs-line-attr for ub.rvs-line-attr .
     5399   define buffer buf_goods         for ub.goods .
     5400   define buffer buf_place         for ub.place .
     5401   do
     5402   on error undo, return error return-value
     5403   :
     5404     find first obj-list no-error .
     5405     if not available obj-list then
     5406     do:
     5407       message
     5408         "Не указан объект для формирования отчета!"
     5409         view-as alert-box error.
     5410       undo, return error.
     5411     end.
     5412     if x-TOG-Shift then
     5413     do:
     5414       v-period = "Смены с " + string (x-Shift-Start) + " по " + string (x-Shift-End) + " За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5415     end.
     5416     else
     5417     do:
     5418       v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     5419     end.
     5420     DEFINE VARIABLE v-today as date    no-undo .
     5421     DEFINE VARIABLE v-time  as integer no-undo .
     5422     run cur-time in this-procedure (
     5423       output v-today
     5424       , output v-time
     5425       ).
     5426     v-print-date = "Дата печати: " + string (v-today,"99.99.9999") + ", время: " + string(truncate (v-time / 3600, 0)) + ":" + string((v-time modulo 3600) / 60,"99")  + ":" + string((v-time modulo 3600) / 360,"99").
     5427     assign ii = 0 .
     5428     empty temp-table tt-result .
     5429     for each obj-list no-lock:
     5430       if v-list-obj = "" then v-list-obj = string(obj-list.obj-name).
     5431       else v-list-obj = v-list-obj + ", " + string(obj-list.obj-name).
     5432       if x-TOG-Shift
     5433       then do:
     5434         for each buf_rvs-doc no-lock where buf_rvs-doc.obj-type   = obj-list.obj-type
     5435                                        and buf_rvs-doc.obj-code   = obj-list.obj-code
     5436                                        and buf_rvs-doc.rvs-type   = 'проверка':U
     5437                                        and buf_rvs-doc.status_    = 'факт':U
     5438                                        and (buf_rvs-doc.shift-date > X-date-Start or (buf_rvs-doc.shift-date = X-date-Start and buf_rvs-doc.shift-num >= x-Shift-Start))
     5439                                        and (buf_rvs-doc.shift-date < X-date-End or (buf_rvs-doc.shift-date = X-date-End and buf_rvs-doc.shift-num <= x-Shift-End))
     5440         :
     5441           run fill-tt .
     5442         end .
     5443       end.
     5444       else do:
     5445         for each buf_rvs-doc no-lock where buf_rvs-doc.obj-type   = obj-list.obj-type
     5446                                        and buf_rvs-doc.obj-code   = obj-list.obj-code
     5447                                        and buf_rvs-doc.rvs-type   = 'проверка':U
     5448                                        and buf_rvs-doc.status_    = 'факт':U
     5449                                        and buf_rvs-doc.fact-date >= X-date-Start
     5450                                        and buf_rvs-doc.fact-date <= X-date-End
     5451         :
     5452           run fill-tt .
     5453         end .
     5454       end.
     5455     end.
     5456     run print-report .
     5457   end .
     5458   procedure fill-tt :
     5459     define variable v-test-asi-type    as character no-undo .
     5460     define variable v-izmer-density    as decimal no-undo .
     5461     define variable v-pomi-density     as decimal no-undo .
     5462     define variable v-temp-izm-vol     as decimal no-undo .
     5463     define variable v-asi-pomi-density as decimal no-undo .
     5464     define variable v-diff             as decimal no-undo .
     5465     for first buf_doc-attr no-lock where buf_doc-attr.doc-code  = buf_rvs-doc.rvs-code
     5466                                      and buf_doc-attr.attr-code = "test-asi-type"
     5467     :
     5468       v-test-asi-type = buf_doc-attr.attr-value .
     5469     end .
     5470     if p-test-asi-type <> "all"
     5471     and p-test-asi-type <> v-test-asi-type
     5472     then do :
     5473       return .
     5474     end .
     5475     for each buf_rvs-line no-lock where buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     5476                                     and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     5477                                     and buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code,
     5478       first buf_goods no-lock where buf_goods.gds-code = buf_rvs-line.gds-code,
     5479       first buf_place no-lock where buf_place.obj-type = buf_rvs-line.obj-type
     5480                                 and buf_place.obj-code = buf_rvs-line.obj-code
     5481                                 and buf_place.pl-code  = buf_rvs-line.pl-code
     5482     :
     5483       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     5484                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     5485                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     5486                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     5487                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     5488                                             and buf_rvs-line-attr.attr-code = "izmer-density"
     5489       :
     5490         assign v-izmer-density = decimal(buf_rvs-line-attr.attr-value) .
     5491       end .
     5492       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     5493                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     5494                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     5495                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     5496                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     5497                                             and buf_rvs-line-attr.attr-code = "pomi-density"
     5498       :
     5499         assign v-pomi-density = decimal(buf_rvs-line-attr.attr-value) .
     5500       end .
     5501       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     5502                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     5503                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     5504                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     5505                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     5506                                             and buf_rvs-line-attr.attr-code = "asi-pomi-density"
     5507       :
     5508         assign v-asi-pomi-density = decimal(buf_rvs-line-attr.attr-value) .
     5509       end .
     5510       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     5511                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     5512                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     5513                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     5514                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     5515                                             and buf_rvs-line-attr.attr-code = "test-asi-diff"
     5516       :
     5517         assign v-diff = decimal(buf_rvs-line-attr.attr-value) .
     5518       end .
     5519       for first buf_rvs-line-attr no-lock where buf_rvs-line-attr.obj-code  = buf_rvs-line.obj-code
     5520                                             and buf_rvs-line-attr.obj-type  = buf_rvs-line.obj-type
     5521                                             and buf_rvs-line-attr.gds-code  = buf_rvs-line.gds-code
     5522                                             and buf_rvs-line-attr.pl-code   = buf_rvs-line.pl-code
     5523                                             and buf_rvs-line-attr.rvs-code  = buf_rvs-line.rvs-code
     5524                                             and buf_rvs-line-attr.attr-code = "temp-izm-vol"
     5525       :
     5526         assign v-temp-izm-vol = decimal(buf_rvs-line-attr.attr-value) .
     5527       end .
     5528       create tt-result .
     5529       assign
     5530         ii = ii + 1
     5531         tt-result.num               = ii
     5532         tt-result.obj-type          = buf_rvs-doc.obj-type
     5533         tt-result.obj-code          = buf_rvs-doc.obj-code
     5534         tt-result.obj-name          = obj-list.obj-name
     5535         tt-result.shift-date        = buf_rvs-doc.shift-date
     5536         tt-result.shift-num         = buf_rvs-doc.shift-num
     5537         tt-result.rvs-code          = buf_rvs-doc.rvs-code
     5538         tt-result.doc-date          = buf_rvs-doc.doc-date
     5539         tt-result.gds-code          = buf_goods.gds-code
     5540         tt-result.gds-name          = buf_goods.gds-name
     5541         tt-result.pl-code           = buf_place.pl-code
     5542         tt-result.loc1              = buf_place.loc1
     5543         tt-result.test-asi-type     = v-test-asi-type
     5544       .
     5545       case v-test-asi-type :
     5546         when "test-asi_dens-place"
     5547         then do :
     5548           assign
     5549             tt-result.state-level-total = ?
     5550             tt-result.izmer-density     = v-izmer-density
     5551             tt-result.pomi-density      = ?
     5552             tt-result.state-temperature = ?
     5553             tt-result.state-mass        = ?
     5554             tt-result.level-total       = ?
     5555             tt-result.density           = buf_rvs-line.density
     5556             tt-result.asi-pomi-density  = ?
     5557             tt-result.temperature       = ?
     5558             tt-result.mass              = ?
     5559             tt-result.diff-density-gram = v-diff / 1000
     5560             tt-result.diff-density      = v-diff
     5561             tt-result.diff-mass-kilo    = ?
     5562             tt-result.diff-mass         = ?
     5563             tt-result.asi-type-name     = "Резервуар"
     5564           .
     5565         end .
     5566         when "test-asi_dens-pump"
     5567         then do :
     5568           assign
     5569             tt-result.state-level-total = ?
     5570             tt-result.izmer-density     = v-izmer-density
     5571             tt-result.pomi-density      = v-pomi-density
     5572             tt-result.state-temperature = v-temp-izm-vol
     5573             tt-result.state-mass        = ?
     5574             tt-result.level-total       = ?
     5575             tt-result.density           = buf_rvs-line.density
     5576             tt-result.asi-pomi-density  = v-asi-pomi-density
     5577             tt-result.temperature       = buf_rvs-line.temperature
     5578             tt-result.mass              = ?
     5579             tt-result.diff-density-gram = v-diff / 1000
     5580             tt-result.diff-density      = v-diff
     5581             tt-result.diff-mass-kilo    = ?
     5582             tt-result.diff-mass         = ?
     5583             tt-result.asi-type-name     = "ТРК"
     5584           .
     5585         end .
     5586         when "test-asi_mass"
     5587         then do :
     5588           assign
     5589             tt-result.state-level-total = buf_rvs-line.state-level-total
     5590             tt-result.izmer-density     = v-izmer-density
     5591             tt-result.pomi-density      = v-pomi-density
     5592             tt-result.state-temperature = v-temp-izm-vol
     5593             tt-result.state-mass        = buf_rvs-line.state-measure-cli-qnty
     5594             tt-result.level-total       = buf_rvs-line.level-total
     5595             tt-result.density           = buf_rvs-line.density
     5596             tt-result.asi-pomi-density  = ?
     5597             tt-result.temperature       = buf_rvs-line.temperature
     5598             tt-result.mass              = buf_rvs-line.measure-cli-qnty
     5599             tt-result.diff-density-gram = ?
     5600             tt-result.diff-density      = ?
     5601             tt-result.diff-mass-kilo    = ABS(buf_rvs-line.state-measure-cli-qnty - buf_rvs-line.measure-cli-qnty)
     5602             tt-result.diff-mass         = v-diff
     5603             tt-result.asi-type-name     = "Масса"
     5604           .
     5605         end .
     5606       end case .
     5607     end .
     5608   end procedure .
     5609   procedure print-report :
     5610     run get-report-num (output p-report-id).
     5611     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     5612     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     5613     put stream OutStr-html unformatted
     5614   "<!DOCTYPE HTML>" skip
     5615   ' <html>' skip
     5616   '  <head>' skip
     5617   '   <meta charset="utf-8">' skip
     5618   '    <style type="text/css">' skip
     5619   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5620   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     5621   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     5622   '   </style>' skip
     5623   '  </head>' skip
     5624     .
     5625     put stream OutStr-html unformatted
     5626       '<body>' skip
     5627       '<TABLE name="1" outline_below="true" fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     5628       '<thead>' skip
     5629     .
     5630     put stream OutStr-html unformatted
     5631       '<tr class="set_columns">' skip
     5632       '<td style="width: 40px;"></td>' skip
     5633       '<td style="width: 100px;"></td>' skip
     5634       '<td style="width: 100px;"></td>' skip
     5635       '<td style="width: 60px;"></td>' skip
     5636       '<td style="width: 80px;"></td>' skip
     5637       '<td style="width: 100px;"></td>' skip
     5638       '<td style="width: 100px;"></td>' skip
     5639       '<td style="width: 50px;"></td>' skip
     5640       '<td style="width: 120px;"></td>' skip
     5641       '<td style="width: 120px;"></td>' skip
     5642       '<td style="width: 120px;"></td>' skip
     5643       '<td style="width: 120px;"></td>' skip
     5644       '<td style="width: 120px;"></td>' skip
     5645       '<td style="width: 120px;"></td>' skip
     5646       '<td style="width: 120px;"></td>' skip
     5647       '<td style="width: 120px;"></td>' skip
     5648       '<td style="width: 120px;"></td>' skip
     5649       '<td style="width: 120px;"></td>' skip
     5650       '<td style="width: 120px;"></td>' skip
     5651       '<td style="width: 120px;"></td>' skip
     5652       '<td style="width: 120px;"></td>' skip
     5653       '<td style="width: 120px;"></td>' skip
     5654       '<td style="width: 120px;"></td>' skip
     5655       '</tr>' skip
     5656     .
     5657     put stream OutStr-html unformatted
     5658       '<TR><TD colspan="23"></TD></TR>' skip
     5659       '<TR>' skip
     5660       '<TD colspan="23" style="font-weight: bold;">Отчет Результат проверки корректности работы АСИ в резервуаре</TD>' skip
     5661       '</TR>'skip
     5662       '<TR>' skip
     5663       '<TD colspan="23">' + v-period + '</TD>' skip
     5664       '</TR>'skip
     5665       '<TR>' skip
     5666       '<TD colspan="23">Выбор объекта: ' + v-list-obj + '</TD>' skip
     5667       '</TR>'skip
     5668       '<TR>' skip
     5669       '<TD colspan="23">' + v-print-date + '</TD>' skip
     5670       '</TR>'skip
     5671       '</thead>' skip
     5672     .
     5673     put stream OutStr-html unformatted
     5674       '<tbody>' skip
     5675       '<TR>' skip
     5676       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">№ п/п</TH>' skip
     5677       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">АЗК/АЗС</TH>' skip
     5678       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Дата смены</TH>' skip
     5679       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Номер смены</TH>' skip
     5680       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Номер документа проверки</TH>' skip
     5681       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Дата документа проверки</TH>' skip
     5682       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Марка НП</TH>' skip
     5683       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Номер резервура</TH>' skip
     5684       '<TH text_wrap="true" colspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Фактические замеры комиссии</TH>' skip
     5685       '<TH text_wrap="true" colspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Данные замеров АСИ в резервуаре</TH>' skip
     5686       '<TH text_wrap="true" colspan="4" style="text-align: center; font-weight: bold; background-color: silver;">Результат расчета проверки</TH>' skip
     5687       '<TH text_wrap="true" rowspan="5" style="text-align: center; font-weight: bold; background-color: silver;">Тип проверки</TH>' skip
     5688       '</TR>'skip
     5689       '<TR>' skip
     5690       '<TH text_wrap="true" rowspan="4" style="text-align: center; font-weight: bold; background-color: silver;">Уровень по метроштоку, см</TH>' skip
     5691       '<TH text_wrap="true" rowspan="4" style="text-align: center; font-weight: bold; background-color: silver;">Плотность по замерам, г/см3</TH>' skip
     5692       '<TH text_wrap="true" rowspan="4" style="text-align: center; font-weight: bold; background-color: silver;">Плотность, приведенная к стандартной температуре, г/см3</TH>' skip
     5693       '<TH text_wrap="true" rowspan="4" style="text-align: center; font-weight: bold; background-color: silver;">Температура, С</TH>' skip
