     1720   procedure wthcattr-sprcli :
     1721   define input parameter parparentproc  as widget-handle no-undo.
     1722   define input parameter p-mode  as character no-undo.
     1723   define input-output parameter p-value as character no-undo .
     1724   define output parameter p-setted as logical no-undo .
     1725     DEFINE VARIABLE v-value as character no-undo .
     1726     define variable v-cli-type as character no-undo .
     1727     define variable v-cli-code as integer no-undo .
     1728     define buffer buf_clients   for ub.clients.
     1729     define variable v_rid as character no-undo.
     1730     define variable ref-rec as recid no-undo .
     1731     do
     1732     on error undo, return error
     1733     :
     1734         v-value = p-value.
     1735      if p-value <> '':U then do:
     1736       assign
     1737       v-cli-type = substring(p-value, 1, 3)
     1738       v-cli-code = integer(substring(p-value, 4))
     1739       no-error.
     1740       if error-status:error then do:
     1741         assign
     1742         v-cli-type = '':U
     1743         v-cli-code = 0
     1744         .
     1745       end.
     1746      end.
     1747      FIND FIRST buf_clients NO-LOCK WHERE
     1748               buf_clients.obj-type = v-cli-type AND
     1749               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1750      IF available(buf_clients) then do:
     1751       run ref/cli-all.w (
     1752                   input parparentproc
     1753                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1754                  ,input v-cli-type
     1755                  ,input 'все':U
     1756                  ,input 'все':U
     1757                  ,input RECID( buf_clients )
     1758                  ,input ",,,,,,NO"
     1759                  ,input ?
     1760                  ,OUTPUT v_rid ).
     1761     END.
     1762     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1763       run ref/cli-all.w (
     1764                    input parparentproc
     1765                   ,INPUT "b-sel":U
     1766                  ,input  v-cli-type
     1767                  ,input 'все':U
     1768                  ,input 'текущие':U
     1769                  ,input ?
     1770                  ,input ",,,,,,NO"
     1771                  ,input ?
     1772                  ,OUTPUT v_rid ).
     1773     END.
     1774     else do:
     1775       message
     1776       if p-value = "":U then 'Атрибут не задан!'
     1777       else substitute('Не найден клиент &1',p-value)
     1778       view-as alert-box warning.
     1779     end.
     1780     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1781       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1782       IF ERROR-STATUS:ERROR THEN DO:
     1783           RETURN NO-APPLY.
     1784       END.
     1785       FIND FIRST buf_clients NO-LOCK WHERE
     1786                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1787       IF AVAIL buf_clients THEN DO:
     1788         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1789       end.
     1790     end.
     1791     if v-value <> p-value then do:
     1792       p-value = v-value.
     1793       p-setted = yes.
     1794     end.
     1795     end.
     1796   end procedure.
     1797     define new global shared variable g#wthcalib as handle no-undo.
     1798   procedure torgconf-read :
     1799   do
     1800   on error undo, return error
     1801   :
     1802       define input parameter p-form-name  as character    no-undo.
     1803       define input parameter p-host-code  as integer      no-undo.
     1804       define input parameter p-obj-type   as character    no-undo.
     1805       define input parameter p-obj-code   as integer      no-undo.
     1806       define variable v-outdate   as character     no-undo.
     1807       define variable v-outares   as character     no-undo.
     1808       define variable v-outsend   as character     no-undo.
     1809       define variable v-outasend  as character     no-undo.
     1810       define variable v-outprops  as character     no-undo.
     1811       define variable v-outnum    as character     no-undo.
     1812       define variable v-outprim   as character     no-undo.
     1813       define variable v-outdisc   as character     no-undo.
     1814       define variable v-outsubs   as character     no-undo.
     1815       define variable v-outrecv   as character     no-undo.
     1816       define variable v-outegrp   as character     no-undo.
     1817       define variable v-outt12    as character     no-undo.
     1818       define variable v-outappr   as character     no-undo.
     1819       define variable v-outrubl   as character     no-undo.
