      567   define variable var-report-r-b as character no-undo .
      568   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      570     (output var-report-r-b
      571     )  .
      572   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      574   define  shared variable RepPathName        as character no-undo .
      575   define  shared variable PrintRubl          as logical   no-undo .
      576   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   procedure cur-time :
      579      define output parameter p-today as date      no-undo .
      580      define output parameter p-time  as integer   no-undo .
      581     do
      582     on error undo, return error
      583     :
      584       define variable v-date1 as date      no-undo .
      585       define variable v-date2 as date      no-undo .
      586       define variable v-time  as integer   no-undo .
      587       assign
      588         v-date1 = today
      589         v-time  = time
      590         v-date2 = today
      591       .
      592       if v-date1 <> v-date2
      593       then do:
      594         assign
      595           v-date1 = today
      596           v-time  = v-time
      597         .
      598       end.
      599       assign
      600         p-today = v-date1
      601         p-time  = v-time
      602       .
      603     end.
      604   end.
      605   function cur-time-date returns character
      606   :
      607     return string(today, '99/99/9999':U) .
      608   end.
      609   function cur-time-mjd returns decimal
      610   :
      611     define variable v-date as date      no-undo .
      612     define variable v-time as integer   no-undo .
      613     run cur-time in this-procedure
      614       (output v-date
      615       ,output v-time
      616       ) .
      617     return integer(v-date) - 2400002 + (v-time / 86400) .
      618   end.
      619   function cur-time-get-ending-index returns integer
      620   (input p-number as integer
      621   )
      622   :
      623     if p-number < 0
      624     or p-number = ?
      625     then do:
      626       return 1 .
      627     end.
      628     define variable v-rest as integer   no-undo .
      629     assign
      630       p-number = p-number modulo 100
      631     .
      632     if p-number < 20
      633     then do:
      634       assign
      635         v-rest = p-number
      636       .
      637     end.
      638     else do:
      639       assign
      640         v-rest = p-number modulo 10
      641       .
      642     end.
      643     case v-rest :
      644       when 1
      645       then do:
      646         return 2 .
      647       end.
      648       when 2 or
      649       when 3 or
      650       when 4
      651       then do:
      652         return 3 .
      653       end.
      654       otherwise do:
      655         return 1 .
      656       end.
      657     end case .
      658   end.
      659   procedure cur-time-mjd-to-date :
      660      define input  parameter i-mjd-diff as decimal no-undo.
      661      define output parameter o-Date     as date    no-undo.
      662      define output parameter o-Time     as integer no-undo.
      663      define variable v-day-number as integer   no-undo .
      664      if    i-mjd-diff < 0
      665         or i-mjd-diff = ?
      666      then do:
      667         return "?" .
      668      end.
      669      assign
      670         v-day-number = truncate(i-mjd-diff,0).
      671         o-Date = date(v-day-number + 2400002).
      672         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      673     .
      674   end.
      675   function cur-time-mjd-to-string returns character
      676   (input p-mjd-diff as decimal
      677   )
      678   :
      679     define variable v-day-number as integer   no-undo .
      680     define variable v-seconds    as integer   no-undo .
      681     define variable v-hour       as integer   no-undo .
      682     define variable v-min        as integer   no-undo .
      683     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      684     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      685     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      686     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      687     if p-mjd-diff < 0
      688     or p-mjd-diff = ?
      689     then do:
      690       return "?" .
      691     end.
      692     assign
      693       v-day-number = integer(truncate(p-mjd-diff,0))
      694       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      695     .
      696     if v-seconds > 86400
      697     then do:
      698       assign
      699         v-seconds = 86400 - 1
      700       .
      701     end.
      702     if v-seconds < 0
      703     then do:
      704       assign
      705         v-seconds = 0
      706       .
      707     end.
      708     assign
      709       v-hour = truncate(v-seconds / 3600, 0)
      710     .
      711     assign
      712       v-seconds = v-seconds modulo 3600
      713     .
      714     assign
      715       v-min = truncate(v-seconds / 60, 0)
      716     .
      717     assign
      718       v-seconds = v-seconds modulo 60
      719     .
      720     return
      721         (if v-day-number <> 0
      722           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      723           else ""
      724         )
      725       + (if v-day-number <> 0 or v-hour <> 0
      726           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      727           else ""
      728         )
      729       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      730           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      731           else ""
      732         )
      733       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      734       .
      735   end.
      736   function cur-time-string returns character
      737   :
      738     define variable v-date as date      no-undo .
      739     define variable v-time as integer   no-undo .
      740     run cur-time in this-procedure
      741       (output v-date
      742       ,output v-time
      743       ) .
      744     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      745   end.
      746   function cur-time-string-sec returns character
      747   :
      748     define variable v-date as date      no-undo .
      749     define variable v-time as integer   no-undo .
      750     run cur-time in this-procedure
      751       (output v-date
      752       ,output v-time
      753       ) .
      754     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      755   end.
      756   function cur-time-custom  returns character
      757   (input p-prefix as character
      758   ,input p-date-format as character
      759   ,input p-delimiter as character
      760   ,input p-time-format as character
      761   ,input p-suffix as character
      762   )
      763   :
      764     define variable v-date as date      no-undo .
      765     define variable v-time as integer   no-undo .
      766     run cur-time in this-procedure
      767       (output v-date
      768       ,output v-time
      769       ) .
      770     return
      771       p-prefix
      772       + string(v-date, p-date-format)
      773       + p-delimiter
      774       + string(v-time, p-time-format)
      775       + p-suffix
      776       .
      777   end.
      778   function cur-time-print  returns character
      779   :
      780     define variable v-date as date      no-undo .
      781     define variable v-time as integer   no-undo .
      782     run cur-time in this-procedure
      783       (output v-date
      784       ,output v-time
      785       ) .
      786     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      787   end.
      788   function cur-time-datetime returns datetime
      789   :
      790     define variable v-char as character no-undo .
      791     define variable v-datetime as datetime no-undo .
      792     v-char = cur-time-string().
      793     v-datetime = datetime(v-char).
      794     return  v-datetime.
      795   end.
      796   function cur-time-string-msec returns character
      797   :
      798     define variable v-date as datetime  no-undo .
      799     v-date = now.
      800     return string(v-date) .
      801   end.
      802   procedure cp-attr-code :
      803     do
      804     on error undo, return error
      805     :
      806       define input  parameter p-code           as character no-undo .
      807       define output parameter p-type           as character no-undo .
      808       define output parameter p-format         as character no-undo .
      809       define output parameter p-label          as character no-undo .
      810       define output parameter p-range          as integer   no-undo .
      811       define output parameter p-user-can-edit  as logical   no-undo .
      812       define output parameter p-output-display as logical   no-undo .
      813       define output parameter p-other          as character no-undo .
      814       case p-code :
      815               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      816               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      817               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      818               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      819               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      820               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      821               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      822               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      823               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      824               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      825         otherwise do:
      826           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      827         end.
      828       end.
      829     end.
      830   end procedure.
      831   procedure cp-attr-tooltip :
      832     do
      833     on error undo, return error
      834     :
      835       define input  parameter p-code    as character no-undo .
      836       define output parameter p-tooltip as character no-undo .
      837       define output parameter p-label   as character no-undo .
      838       case p-code :
      839               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      840               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      841               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      842               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      843               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      844               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      845               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      846               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      847               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      848               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      849         otherwise do:
      850           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      851         end.
      852       end.
      853     end.
      854   end procedure.
      855   procedure cp-attr-value :
      856     do
      857     on error undo, return error
      858     :
      859       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      860       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      861       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      862       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      863       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      864       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      865       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      866       define output parameter p-type        as character no-undo .
      867       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      868       define variable v-format         as character no-undo .
      869       define variable v-label          as character no-undo .
      870       define variable v-range          as integer   no-undo .
      871       define variable v-user-can-edit  as logical   no-undo .
      872       define variable v-output-display as logical   no-undo .
      873       define variable v-other          as character no-undo .
      874       run cp-attr-code in this-procedure
      875         (input  p-code
      876         ,output p-type
      877         ,output v-format
      878         ,output v-label
      879         ,output v-range
      880         ,output v-user-can-edit
      881         ,output v-output-display
      882         ,output v-other
      883         ) no-error .
      884       if error-status :error then do:
      885         undo, return error return-value .
      886       end.
      887       find first buf_cash-pay-attr no-lock
      888         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      889           and buf_cash-pay-attr.curr-code  = p-curr-code
      890           and buf_cash-pay-attr.host-code  = p-host-code
      891           and buf_cash-pay-attr.obj-type   = p-obj-type
      892           and buf_cash-pay-attr.obj-code   = p-obj-code
      893           and buf_cash-pay-attr.attr-code  = p-code
      894         no-error .
      895       if avail buf_cash-pay-attr then do:
      896         assign
      897           p-value =  buf_cash-pay-attr.attr-value
      898         .
      899       end.
      900       else do:
      901         assign
      902           p-value = if p-type = 'L':U then "no":U else ""
      903         .
      904       end.
      905     end.
      906   end procedure.
      907   procedure cp-attr-write :
      908     do
      909     on error undo, return error
      910     :
      911       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      912       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      913       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      914       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      915       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      916       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      917       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      918       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      919       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      920       define variable v-type           as character no-undo .
      921       define variable v-format         as character no-undo .
      922       define variable v-label          as character no-undo .
      923       define variable v-range          as integer   no-undo .
      924       define variable v-user-can-edit  as logical   no-undo .
      925       define variable v-output-display as logical   no-undo .
      926       define variable v-other          as character no-undo .
      927       run cp-attr-code in this-procedure
      928         (input  p-code
      929         ,output v-type
      930         ,output v-format
      931         ,output v-label
      932         ,output v-range
      933         ,output v-user-can-edit
      934         ,output v-output-display
      935         ,output v-other
      936         ) no-error .
      937       if error-status :error then do:
      938         undo, return error return-value .
      939       end.
      940       find first buf_cash-pay-attr exclusive-lock
      941         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      942           and buf_cash-pay-attr.curr-code  = p-curr-code
      943           and buf_cash-pay-attr.host-code  = p-host-code
      944           and buf_cash-pay-attr.obj-type   = p-obj-type
      945           and buf_cash-pay-attr.obj-code   = p-obj-code
      946           and buf_cash-pay-attr.attr-code = p-code
      947         no-error .
      948       if not available buf_cash-pay-attr then do:
      949         create buf_cash-pay-attr .
      950         assign
      951         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      952         buf_cash-pay-attr.curr-code  = p-curr-code
      953         buf_cash-pay-attr.host-code  = p-host-code
      954         buf_cash-pay-attr.obj-type   = p-obj-type
      955         buf_cash-pay-attr.obj-code   = p-obj-code
      956         buf_cash-pay-attr.attr-code = p-code
      957         .
      958       end.
      959       assign
      960         buf_cash-pay-attr.attr-value = p-value
      961       .
      962       release buf_cash-pay-attr no-error .
      963       if error-status:error then do:
      964         undo, return error return-value .
      965       end.
      966     end.
      967   end procedure.
      968   procedure cp-attr-exist :
      969     do
      970     on error undo, return error
      971     :
      972       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      973       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      974       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      975       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      976       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      977       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      978       define output parameter p-exist   as logical  no-undo .
      979       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      980       define variable v-type           as character no-undo .
      981       define variable v-format         as character no-undo .
      982       define variable v-label          as character no-undo .
      983       define variable v-range          as integer   no-undo .
      984       define variable v-user-can-edit  as logical   no-undo .
      985       define variable v-output-display as logical   no-undo .
      986       define variable v-other          as character no-undo .
      987       run cp-attr-code in this-procedure
      988         (input  p-code
      989         ,output v-type
      990         ,output v-format
      991         ,output v-label
      992         ,output v-range
      993         ,output v-user-can-edit
      994         ,output v-output-display
      995         ,output v-other
      996         ) no-error .
      997       if error-status :error then do:
      998         undo, return error return-value .
      999       end.
     1000       find first buf_cash-pay-attr exclusive-lock
     1001         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1002           and buf_cash-pay-attr.curr-code  = p-curr-code
     1003           and buf_cash-pay-attr.host-code  = p-host-code
     1004           and buf_cash-pay-attr.obj-type   = p-obj-type
     1005           and buf_cash-pay-attr.obj-code   = p-obj-code
     1006           and buf_cash-pay-attr.attr-code = p-code
     1007         no-error .
     1008       if  available buf_cash-pay-attr then do:
     1009         p-exist = yes.
     1010       end.
     1011     end.
     1012   end procedure.
     1013   procedure cp-attr-delete :
     1014     do
     1015     on error undo, return error
     1016     :
     1017       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1018       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1019       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1020       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1021       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1022       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1023       define output parameter p-deleted  as logical no-undo.
     1024       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1025       define variable v-type           as character no-undo .
     1026       define variable v-format         as character no-undo .
     1027       define variable v-label          as character no-undo .
     1028       define variable v-range          as integer   no-undo .
     1029       define variable v-user-can-edit  as logical   no-undo .
     1030       define variable v-output-display as logical   no-undo .
     1031       define variable v-other          as character no-undo .
     1032       run cp-attr-code in this-procedure
     1033         (input  p-code
     1034         ,output v-type
     1035         ,output v-format
     1036         ,output v-label
     1037         ,output v-range
     1038         ,output v-user-can-edit
     1039         ,output v-output-display
     1040         ,output v-other
     1041         ) no-error .
     1042       if error-status :error then do:
     1043         undo, return error return-value .
     1044       end.
     1045       find first buf_cash-pay-attr exclusive-lock
     1046         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1047           and buf_cash-pay-attr.curr-code  = p-curr-code
     1048           and buf_cash-pay-attr.host-code  = p-host-code
     1049           and buf_cash-pay-attr.obj-type   = p-obj-type
     1050           and buf_cash-pay-attr.obj-code   = p-obj-code
     1051           and buf_cash-pay-attr.attr-code = p-code
     1052         no-error NO-WAIT.
     1053       if not available buf_cash-pay-attr then do:
     1054         p-deleted = no.
     1055       end.
     1056       else do:
     1057         delete buf_cash-pay-attr no-error .
     1058         if error-status:error then do:
     1059           undo, return error return-value .
     1060         end.
     1061         p-deleted = yes.
     1062       end.
     1063     end.
     1064   end procedure.
     1065   procedure cp-attr-news :
     1066     do
     1067     on error undo, return error
     1068     :
     1069       define input  parameter p-code           as character no-undo .
     1070       define output parameter p-news           as logical   no-undo .
     1071       case p-code :
     1072               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1073               when 'grp-code':U then do:     assign     p-news = true.   end.
     1074               when 'is-use':U then do:     assign     p-news = true.   end.
     1075               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1076               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1077               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1078               when 'form_km3':U then do:     assign     p-news = false.   end.
     1079               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1080               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1081               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1082         otherwise do:
     1083           p-news = no.
     1084         end.
     1085       end.
     1086     end.
     1087   end procedure.
     1088   procedure cp-attr-hist :
     1089     do
     1090     on error undo, return error
     1091     :
     1092       define input  parameter p-code           as character no-undo .
     1093       define output parameter p-hist           as logical   no-undo .
     1094       case p-code :
     1095               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
     1096               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
     1097               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     1098               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1099               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1100               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1101               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1102         otherwise do:
     1103           p-hist = no.
     1104         end.
     1105       end.
     1106     end.
     1107   end procedure.
     1108   define new global shared variable g#lib-trn  as handle no-undo .
     1109   define new global shared variable g#lib-trn2 as handle no-undo .
     1110   define new global shared variable g#lib-trn3 as handle no-undo .
     1111   define new global shared variable g#lib-trn4 as handle no-undo .
     1112   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1113   define new global shared variable g#trdcalib as handle no-undo.
     1114   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1115                                     iInput AS INTEGER).
     1116     def var v-start-print as integer no-undo .
     1117     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1118     assign
     1119       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1120     .
     1121     RETURN v-start-print .
     1122   END FUNCTION.
     1123   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1124                                     iInput AS INTEGER).
     1125     def var v-start-print as integer no-undo .
     1126     assign
     1127       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1128     .
     1129     if v-start-print < 0 then return 0.
     1130     RETURN v-start-print .
     1131   END FUNCTION.
     1132   define variable vss-include-info11 as character format "X(65)" no-undo
     1133   initial "@(#)$Workfile$ $Revision$".
     1134   define variable v-fmtcli-name          as character    no-undo.
     1135   define variable v-fmtcli-engl-name     as character    no-undo.
     1136   define variable v-fmtcli-addres        as character    no-undo.
     1137   define variable v-fmtcli-post-addres   as character    no-undo.
     1138   define variable v-fmtcli-full-addres   as character    no-undo.
     1139   define variable v-fmtcli-phone         as character    no-undo.
     1140   define variable v-fmtcli-inn           as character    no-undo.
     1141   define variable v-fmtcli-kpp           as character    no-undo.
     1142   define variable v-fmtcli-okpo          as character    no-undo.
     1143   define variable v-fmtcli-country       as character    no-undo.
     1144   define variable v-fmtcli-city          as character    no-undo.
     1145   define variable v-fmtcli-index         as character    no-undo.
     1146   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1147   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1148   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1149   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1150   define variable v-fmtcli-bank-bik      as character    no-undo.
     1151   define variable v-fmtcli-bank-name     as character    no-undo.
     1152   define variable v-fmtcli-bank-addres   as character    no-undo.
     1153   define variable v-fmtcli-bank-city     as character    no-undo.
     1154   procedure fmtcli-get-bank :
     1155   define input parameter p-host-code      as integer          no-undo.
     1156   define input parameter p-obj-type       as character        no-undo.
     1157   define input parameter p-obj-code       as integer          no-undo.
     1158   define input parameter p-curr-code      as integer          no-undo.
     1159       define buffer buf_fin-schet     for ub.fin-schet.
     1160       define buffer buf_fin-bank      for ub.fin-bank.
     1161   do
     1162   for buf_fin-schet
     1163     , buf_fin-bank
     1164   on error undo, return error
     1165   :
     1166       assign
     1167           v-fmtcli-schet-exists       = no
     1168           v-fmtcli-bank-exists        = no
     1169           v-fmtcli-bank-r-schet       = "":U
     1170           v-fmtcli-bank-c-schet       = "":U
     1171           v-fmtcli-bank-bik           = "":U
     1172           v-fmtcli-bank-name          = "":U
     1173           v-fmtcli-bank-addres        = "":U
     1174           v-fmtcli-bank-city          = "":U
     1175       .
     1176       search-for-schet:
     1177       for each buf_fin-schet no-lock
     1178          where buf_fin-schet.host-code = p-host-code
     1179            and buf_fin-schet.cli-type  = p-obj-type
     1180            and buf_fin-schet.cli-code  = p-obj-code
     1181            and buf_fin-schet.curr-code = p-curr-code
     1182       on error undo, return error
     1183       :
     1184           if buf_fin-schet.status_   = 'удал':U
     1185           then do:
     1186           end.
     1187           else do:
     1188               assign
     1189                   v-fmtcli-schet-exists   = yes
     1190                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1191                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1192               .
     1193               find first buf_fin-bank no-lock
     1194                    where buf_fin-bank.host-code = p-host-code
     1195                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1196               no-error.
     1197               if available buf_fin-bank
     1198               then do:
     1199                   assign
     1200                       v-fmtcli-bank-exists      = yes
     1201                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1202                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1203                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1204                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1205                   .
     1206               end.
     1207               else do:
     1208                   assign
     1209                       v-fmtcli-bank-exists    = no
     1210                       v-fmtcli-bank-bik       = "":U
     1211                       v-fmtcli-bank-name      = "":U
     1212                       v-fmtcli-bank-addres    = "":U
     1213                       v-fmtcli-bank-city      = "":U
     1214                   .
     1215               end.
     1216               leave search-for-schet.
     1217           end.
     1218       end.
     1219   end.
     1220   end procedure.
     1221   procedure fmtcli-get-client :
     1222   define input parameter p-obj-type       as character    no-undo.
     1223   define input parameter p-obj-code       as integer      no-undo.
     1224       define variable v-temp-fmtcli-address      as character     no-undo.
     1225       define variable v-num-country-city    as integer      no-undo.
     1226       define buffer buf_clients   for ub.clients.
     1227       define buffer buf_firm      for ub.firm.
     1228       define buffer buf_store     for ub.store.
     1229       define buffer buf_shop      for ub.shop.
     1230       define buffer buf_person    for ub.person.
     1231   do
     1232   for buf_clients
     1233     , buf_firm
     1234     , buf_store
     1235     , buf_shop
     1236     , buf_person
     1237   on error undo, return error
     1238   :
     1239       assign
     1240           v-fmtcli-name           = "":U
     1241           v-fmtcli-addres         = "":U
     1242           v-fmtcli-post-addres    = "":U
     1243           v-fmtcli-full-addres    = "":U
     1244           v-fmtcli-phone          = "":U
     1245           v-fmtcli-inn            = "":U
     1246           v-fmtcli-kpp            = "":U
     1247           v-fmtcli-okpo           = "":U
     1248           v-fmtcli-city           = "":U
     1249           v-fmtcli-index          = "":U
     1250           v-fmtcli-country        = "":U
     1251       .
     1252       find first buf_clients no-lock
     1253            where buf_clients.obj-type = p-obj-type
     1254              and buf_clients.obj-code = p-obj-code
     1255       .
     1256       assign
     1257           v-fmtcli-name = buf_clients.obj-name
     1258       .
     1259       case buf_clients.obj-type:
     1260          when 'орг':U
     1261          then do:
     1262               find first buf_firm no-lock
     1263                    where buf_firm.firm-code = buf_clients.obj-code
     1264                    no-error
     1265               .
     1266               if available buf_firm
     1267               then do:
     1268                   assign
     1269                       v-num-country-city = num-entries( buf_firm.city )
     1270                       v-fmtcli-engl-name = buf_firm.engl-name
     1271                   .
     1272                   if v-num-country-city > 0
     1273                   then do:
     1274                       assign
     1275                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1276                       .
     1277                   end.
     1278                   if v-num-country-city > 1
     1279                   then do:
     1280                       assign
     1281                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1282                       .
     1283                   end.
     1284                   run fmtcli-concatenate-strings in this-procedure (
     1285                         input v-fmtcli-full-addres
     1286                       , input v-fmtcli-country
     1287                       , input ", ":U
     1288                       , input 50
     1289                       , output v-fmtcli-full-addres
     1290                   ).
     1291                   run fmtcli-concatenate-strings in this-procedure (
     1292                         input v-fmtcli-full-addres
     1293                       , input v-fmtcli-city
     1294                       , input ", ":U
     1295                       , input 50
     1296                       , output v-fmtcli-full-addres
     1297                   ).
     1298                   run fmtcli-concatenate-strings in this-procedure (
     1299                         input v-fmtcli-full-addres
     1300                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1301                       , input ", ":U
     1302                       , input 50
     1303                       , output v-fmtcli-full-addres
     1304                   ).
     1305                   run fmtcli-concatenate-strings in this-procedure (
     1306                         input v-fmtcli-post-addres
     1307                       , input v-fmtcli-country
     1308                       , input ", ":U
     1309                       , input 50
     1310                       , output v-fmtcli-post-addres
     1311                   ).
     1312                   run fmtcli-concatenate-strings in this-procedure (
     1313                         input v-fmtcli-post-addres
     1314                       , input v-fmtcli-city
     1315                       , input ", ":U
     1316                       , input 50
     1317                       , output v-fmtcli-post-addres
     1318                   ).
     1319                   run fmtcli-concatenate-strings in this-procedure (
     1320                         input v-fmtcli-post-addres
     1321                       , input string( buf_firm.ind )
     1322                       , input ", ":U
     1323                       , input 50
     1324                       , output v-fmtcli-post-addres
     1325                   ).
     1326                   run fmtcli-concatenate-strings in this-procedure (
     1327                         input substring( buf_firm.addres1, 1, 50 )
     1328                       , input buf_firm.addres2
     1329                       , input " ":U
     1330                       , input 50
     1331                       , output v-temp-fmtcli-address
     1332                   ).
     1333                   run fmtcli-concatenate-strings in this-procedure (
     1334                         input v-temp-fmtcli-address
     1335                       , input substring( buf_firm.addres1, 51, 50 )
     1336                       , input " ":U
     1337                       , input 50
     1338                       , output v-temp-fmtcli-address
     1339                   ).
     1340                   run fmtcli-concatenate-strings in this-procedure (
     1341                         input v-temp-fmtcli-address
     1342                       , input substring( buf_firm.addres1, 101, 50 )
     1343                       , input " ":U
     1344                       , input 50
     1345                       , output v-temp-fmtcli-address
     1346                   ).
     1347                   assign
     1348                       v-fmtcli-addres = v-temp-fmtcli-address
     1349                   .
     1350                   if buf_firm.addres1 <> ?
     1351                   then do:
     1352                       run fmtcli-concatenate-strings in this-procedure (
     1353                             input v-fmtcli-full-addres
     1354                           , input v-fmtcli-addres
     1355                           , input ", ":U
     1356                           , input 0
     1357                           , output v-fmtcli-full-addres
     1358                       ).
     1359                   end.
     1360                   run fmtcli-concatenate-strings in this-procedure (
     1361                         input substring( buf_firm.post-addr1, 1, 50 )
     1362                       , input buf_firm.post-addr2
     1363                       , input " ":U
     1364                       , input 50
     1365                       , output v-fmtcli-post-addres
     1366                   ).
     1367                   run fmtcli-concatenate-strings in this-procedure (
     1368                         input v-fmtcli-post-addres
     1369                       , input substring( buf_firm.post-addr1, 51, 50 )
     1370                       , input " ":U
     1371                       , input 50
     1372                       , output v-fmtcli-post-addres
     1373                   ).
     1374                   run fmtcli-concatenate-strings in this-procedure (
     1375                         input v-fmtcli-post-addres
     1376                       , input substring( buf_firm.post-addr1, 101, 50 )
     1377                       , input " ":U
     1378                       , input 50
     1379                       , output v-fmtcli-post-addres
     1380                   ).
     1381                   assign
     1382                       v-fmtcli-phone         = buf_firm.phone
     1383                       v-fmtcli-inn           = buf_firm.inn
     1384                       v-fmtcli-kpp           = buf_firm.kpp
     1385                       v-fmtcli-okpo          = buf_firm.okpo
     1386                       v-fmtcli-index         = string( buf_firm.ind )
     1387                   .
     1388               end.
     1389          end.
     1390          when 'маг':U
     1391          then do:
     1392               find first buf_shop no-lock
     1393                    where buf_shop.obj-code = buf_clients.obj-code
     1394               .
     1395               if available buf_shop
     1396               then do:
     1397                   run fmtcli-concatenate-strings in this-procedure (
     1398                         input buf_shop.addres1
     1399                       , input buf_shop.addres2
     1400                       , input " ":U
     1401                       , input 50
     1402                       , output v-fmtcli-addres
     1403                   ).
     1404                   assign
     1405                       v-fmtcli-full-addres = v-fmtcli-addres
     1406                       v-fmtcli-post-addres = v-fmtcli-addres
     1407                       v-fmtcli-phone       = buf_shop.phone
     1408                       v-fmtcli-inn         = "":U
     1409                       v-fmtcli-kpp         = "":U
     1410                       v-fmtcli-okpo        = "":U
     1411                       v-fmtcli-city        = "":U
     1412                       v-fmtcli-index       = "":U
     1413                   .
     1414               end.
     1415          end.
     1416          when 'скл':U
     1417          then do:
     1418               find first buf_store no-lock
     1419                    where buf_store.obj-code = buf_clients.obj-code
     1420               .
     1421               if available buf_store
     1422               then do:
     1423                   run fmtcli-concatenate-strings in this-procedure (
     1424                         input buf_store.addres1
     1425                       , input buf_store.addres2
     1426                       , input " ":U
     1427                       , input 50
     1428                       , output v-fmtcli-addres
     1429                   ).
     1430                   assign
     1431                       v-fmtcli-full-addres = v-fmtcli-addres
     1432                       v-fmtcli-phone       = buf_store.phone
     1433                       v-fmtcli-inn         = "":U
     1434                       v-fmtcli-kpp         = "":U
     1435                       v-fmtcli-okpo        = "":U
     1436                       v-fmtcli-city        = "":U
     1437                       v-fmtcli-index       = "":U
     1438                   .
     1439               end.
     1440          end.
     1441          when 'чел':U
     1442          then do:
     1443               find first buf_person no-lock
     1444                    where buf_person.psn-code = buf_clients.obj-code
     1445               .
     1446               if available buf_person
     1447               then do:
     1448                   run fmtcli-concatenate-strings in this-procedure (
     1449                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1450                                 then "":U
     1451                                 else string( buf_person.ind, "999999")
     1452                                 )
     1453                       , input buf_person.city
     1454                       , input ", ":U
     1455                       , input 0
     1456                       , output v-fmtcli-full-addres
     1457                   ).
     1458                   assign
     1459                       v-fmtcli-addres = buf_person.address
     1460                   .
     1461                   run fmtcli-concatenate-strings in this-procedure (
     1462                         input v-fmtcli-full-addres
     1463                       , input v-fmtcli-addres
     1464                       , input ", ":U
     1465                       , input 0
     1466                       , output v-fmtcli-full-addres
     1467                   ).
     1468                   assign
     1469                       v-fmtcli-phone     = buf_person.phone1
     1470                       v-fmtcli-inn       = buf_person.inn
     1471                       v-fmtcli-kpp       = buf_person.kpp
     1472                       v-fmtcli-okpo      = buf_person.okpo
     1473                       v-fmtcli-city      = buf_person.city
     1474                       v-fmtcli-index     = string( buf_person.ind )
     1475                   .
     1476               end.
     1477          end.
     1478       end case.
     1479   end.
     1480   end procedure.
     1481   procedure fmtcli-concatenate-strings :
     1482   define input parameter p-string-1       as character        no-undo.
     1483   define input parameter p-string-2       as character        no-undo.
     1484   define input parameter p-delimiter      as character        no-undo.
     1485   define input parameter p-length         as integer          no-undo.
     1486   define output parameter p-out-string    as character        no-undo.
     1487   do
     1488   on error undo, return error
     1489   :
     1490       assign
     1491           p-out-string = ( if p-string-1 = ?
     1492                            then "":U
     1493                            else trim( p-string-1 ) )
     1494       .
     1495       assign
     1496           p-out-string = p-out-string
     1497                        + ( if p-out-string = "":U
     1498                            or length( p-out-string ) = p-length
     1499                            or p-string-2 = ?
     1500                            or trim( p-string-2 ) = "":U
     1501                            then "":U
     1502                            else p-delimiter )
     1503                        + ( if p-string-2 = ?
     1504                            or trim( p-string-2 ) = "":U
     1505                            then "":U
     1506                            else trim( p-string-2 ) )
     1507       .
     1508   end.
     1509   end procedure.
