     1371   else do:
     1372     assign
     1373       bf_tt-allsum.vat-base-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecl  - road-tax-base-salecl  - slt-base-salecl ) * parvat-pc / (100 + parvat-pc) * cl_tt-clcparts.fact-qnty)
     1374       bf_tt-allsum.vat-rubl-doc = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecl  - road-tax-rubl-salecl  - slt-rubl-salecl ) * parvat-pc / (100 + parvat-pc) * cl_tt-clcparts.fact-qnty)
     1375       bf_tt-allsum.vat-base-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-base-with-tax-salecur - road-tax-base-salecur - slt-base-salecur) * parcurvat-pc / (100 + parcurvat-pc) * cl_tt-clcparts.fact-qnty)
     1376       bf_tt-allsum.vat-rubl-cur = (if out-vatp-have-vat-sltcur <> yes then 0 else (price-rubl-with-tax-salecur - road-tax-rubl-salecur - slt-rubl-salecur) * parcurvat-pc / (100 + parcurvat-pc) * cl_tt-clcparts.fact-qnty)
     1377       .
     1378   end.
     1379   if bf_tt-allsum.vat-base-doc = ? then bf_tt-allsum.vat-base-doc = 0.
     1380   if bf_tt-allsum.vat-rubl-doc = ? then bf_tt-allsum.vat-rubl-doc = 0.
     1381   assign
     1382     bf_tt-allsum.sum-dsc-base-acc     = (if price-base-with-tax-loccl    = ? then 0 else price-base-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     1383     bf_tt-allsum.sum-dsc-rubl-acc     = (if price-rubl-with-tax-loccl    = ? then 0 else price-rubl-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     1384     bf_tt-allsum.sum-dsc-cli-acc      = (if (price-cli-with-tax-loccl +
     1385                                              road-tax-cli-loccl       +
     1386                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     1387                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     1388                                              ) / cli-base-ratecl = ? then 0
     1389                                           else
     1390                                             (price-cli-with-tax-loccl +
     1391                                              road-tax-cli-loccl       +
     1392                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     1393                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     1394                                              ) / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     1395     bf_tt-allsum.dsc-base-acc         = 0
     1396     bf_tt-allsum.dsc-rubl-acc         = 0
     1397     bf_tt-allsum.dsc-cli-acc          = 0
     1398     bf_tt-allsum.vat-base-acc         = (if vat-base-loccl      = ? then 0 else vat-base-loccl      * cl_tt-clcparts.fact-qnty)
     1399     bf_tt-allsum.vat-rubl-acc         = (if vat-rubl-loccl      = ? then 0 else vat-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     1400     bf_tt-allsum.vat-cli-acc          = (if vat-cli-loccl / cli-base-ratecl      = ? then 0 else vat-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.fact-qnty)
     1401     bf_tt-allsum.slt-base-acc         = (if slt-base-loccl      = ? then 0 else slt-base-loccl      * cl_tt-clcparts.fact-qnty)
     1402     bf_tt-allsum.slt-rubl-acc         = (if slt-rubl-loccl      = ? then 0 else slt-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     1403     bf_tt-allsum.slt-cli-acc          = (if slt-cli-loccl / cli-base-ratecl      = ? then 0 else slt-cli-loccl / cli-base-ratecl      * cl_tt-clcparts.fact-qnty)
     1404     bf_tt-allsum.road-tax-base-acc    = (if road-tax-base-loccl = ? then 0 else road-tax-base-loccl * cl_tt-clcparts.fact-qnty)
     1405     bf_tt-allsum.road-tax-rubl-acc    = (if road-tax-rubl-loccl = ? then 0 else road-tax-rubl-loccl * cl_tt-clcparts.fact-qnty)
     1406     bf_tt-allsum.road-tax-cli-acc     = (if road-tax-cli-loccl / cli-base-ratecl = ? then 0 else road-tax-cli-loccl / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     1407     bf_tt-allsum.excise-base-acc      = 0
     1408     bf_tt-allsum.excise-rubl-acc      = 0
     1409     bf_tt-allsum.excise-cli-acc       = 0
     1410     bf_tt-allsum.transport-base-acc   = (if transport-base-loccl   = ? then 0 else transport-base-loccl  * cl_tt-clcparts.fact-qnty)
     1411     bf_tt-allsum.transport-rubl-acc   = (if transport-rubl-loccl   = ? then 0 else transport-rubl-loccl  * cl_tt-clcparts.fact-qnty)
     1412     bf_tt-allsum.transport-cli-acc    = (if transport-cli-loccl / cli-base-ratecl   = ? then 0 else transport-cli-loccl / cli-base-ratecl  * cl_tt-clcparts.fact-qnty)
     1413     bf_tt-allsum.other-base-acc       = (if other-base-loccl       = ? then 0 else other-base-loccl      * cl_tt-clcparts.fact-qnty)
     1414     bf_tt-allsum.other-rubl-acc       = (if other-rubl-loccl       = ? then 0 else other-rubl-loccl      * cl_tt-clcparts.fact-qnty)
     1415     bf_tt-allsum.other-cli-acc        = (if other-cli-loccl / cli-base-ratecl       = ? then 0 else other-cli-loccl     / cli-base-ratecl  * cl_tt-clcparts.fact-qnty).
     1416   create bfs_tt-allsum.
     1417   assign
     1418     bfs_tt-allsum.sum-type = 'основная_сумма_со_знаком':U.
     1419   if pardoc-type = 'инв':U or
     1420      pardoc-type = 'при':U    or
     1421      pardoc-type = 'возврат':U    then do:
     1422      buffer-copy bf_tt-allsum except bf_tt-allsum.sum-type to bfs_tt-allsum.
     1423   end.
     1424   else do:
     1425     assign
     1426       bfs_tt-allsum.fact-qnty           =  - bf_tt-allsum.fact-qnty
     1427       bfs_tt-allsum.cli-qnty            =  - bf_tt-allsum.cli-qnty
     1428       bfs_tt-allsum.sum-dsc-base-doc    =  - bf_tt-allsum.sum-dsc-base-doc
     1429       bfs_tt-allsum.sum-dsc-rubl-doc    =  - bf_tt-allsum.sum-dsc-rubl-doc
     1430       bfs_tt-allsum.dsc-base-doc        =  - bf_tt-allsum.dsc-base-doc
     1431       bfs_tt-allsum.dsc-rubl-doc        =  - bf_tt-allsum.dsc-rubl-doc
     1432       bfs_tt-allsum.vat-base-doc        =  - bf_tt-allsum.vat-base-doc
     1433       bfs_tt-allsum.vat-rubl-doc        =  - bf_tt-allsum.vat-rubl-doc
     1434       bfs_tt-allsum.vat-base-buyer-doc  =  - bf_tt-allsum.vat-base-buyer-doc
     1435       bfs_tt-allsum.vat-rubl-buyer-doc  =  - bf_tt-allsum.vat-rubl-buyer-doc
     1436       bfs_tt-allsum.slt-base-doc        =  - bf_tt-allsum.slt-base-doc
     1437       bfs_tt-allsum.slt-rubl-doc        =  - bf_tt-allsum.slt-rubl-doc
     1438       bfs_tt-allsum.road-tax-base-doc   =  - bf_tt-allsum.road-tax-base-doc
     1439       bfs_tt-allsum.road-tax-rubl-doc   =  - bf_tt-allsum.road-tax-rubl-doc
     1440       bfs_tt-allsum.excise-base-doc     =  - bf_tt-allsum.excise-base-doc
     1441       bfs_tt-allsum.excise-rubl-doc     =  - bf_tt-allsum.excise-rubl-doc
     1442       bfs_tt-allsum.sum-dsc-base-cur    =  - bf_tt-allsum.sum-dsc-base-cur
     1443       bfs_tt-allsum.sum-dsc-rubl-cur    =  - bf_tt-allsum.sum-dsc-rubl-cur
     1444       bfs_tt-allsum.dsc-base-cur        =  - bf_tt-allsum.dsc-base-cur
     1445       bfs_tt-allsum.dsc-rubl-cur        =  - bf_tt-allsum.dsc-rubl-cur
     1446       bfs_tt-allsum.vat-base-cur        =  - bf_tt-allsum.vat-base-cur
     1447       bfs_tt-allsum.vat-rubl-cur        =  - bf_tt-allsum.vat-rubl-cur
     1448       bfs_tt-allsum.vat-base-buyer-cur  =  - bf_tt-allsum.vat-base-buyer-cur
     1449       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
     1450       bfs_tt-allsum.slt-base-cur        =  - bf_tt-allsum.slt-base-cur
     1451       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     1452       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     1453       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     1454       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     1455       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     1456       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     1457       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     1458       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     1459       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     1460       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     1461       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     1462       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     1463       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     1464       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     1465       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     1466       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     1467       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     1468       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     1469       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     1470       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     1471       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     1472       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     1473       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     1474       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     1475       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     1476       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     1477       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     1478       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     1479       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     1480   end.
     1481   create bfpc_tt-allsum.
     1482   create bfspc_tt-allsum.
     1483   case cl_tt-clcparts.purch-code :
     1484   when 1           then do:
     1485     assign
     1486       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     1487       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     1488     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1489     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1490   end.
     1491   when 4    then do:
     1492     assign
     1493       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     1494       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     1495     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1496     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1497   end.
     1498   when 3 then do:
     1499     assign
     1500       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     1501       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     1502     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     1503     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     1504   end.
     1505   when 2 then do:
     1506     assign
     1507       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     1508       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     1509     assign
     1510       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     1511       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     1512       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     1513       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
     1514       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     1515       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     1516       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     1517       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
     1518       bfpc_tt-allsum.vat-base-buyer-doc  = bf_tt-allsum.vat-base-buyer-doc  - bf_tt-allsum.vat-base-acc
     1519       bfpc_tt-allsum.vat-rubl-buyer-doc  = bf_tt-allsum.vat-rubl-buyer-doc  - bf_tt-allsum.vat-rubl-acc
     1520       bfpc_tt-allsum.slt-base-doc        = bf_tt-allsum.slt-base-doc        - bf_tt-allsum.slt-base-acc
     1521       bfpc_tt-allsum.slt-rubl-doc        = bf_tt-allsum.slt-rubl-doc        - bf_tt-allsum.slt-rubl-acc
     1522       bfpc_tt-allsum.road-tax-base-doc   = bf_tt-allsum.road-tax-base-doc   - bf_tt-allsum.road-tax-base-acc
     1523       bfpc_tt-allsum.road-tax-rubl-doc   = bf_tt-allsum.road-tax-rubl-doc   - bf_tt-allsum.road-tax-rubl-acc
     1524       bfpc_tt-allsum.excise-base-doc     = bf_tt-allsum.excise-base-doc
