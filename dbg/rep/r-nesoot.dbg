     3257                           v-tot-downSub_Price-Rubl = ( if buf_temp_line-by-parts.delta-qnty > 0 then buf_temp_line-by-parts.delta-sum-rubl else 0 )
     3258                       .
     3259                   end.
     3260                   assign
     3261                       v-tot-fact-qnty          = v-tot-fact-qnty          + buf_parts.fact-qnty
     3262                       v-tot-doc-qnty           = v-tot-doc-qnty           + buf_parts.qnty
     3263                       v-tot-fact-qnty-base     = v-tot-fact-qnty-base     + tt-allsum.sum-dsc-base-acc
     3264                       v-tot-fact-qnty-rubl     = v-tot-fact-qnty-rubl     + tt-allsum.sum-dsc-rubl-acc
     3265                       v-tot-dsc-doc-qnty-base  = 0
     3266                       v-tot-dsc-doc-qnty-rubl  = 0
     3267                       v-tot-dsc-fact-qnty-base = 0
     3268                       v-tot-dsc-fact-qnty-rubl = 0
     3269                   .
     3270               end.
     3271               for each buf_temp_line-by-parts
     3272               on error undo, return error
     3273               :
     3274   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3275     (input  buf_goods.gds-code
     3276     ,input  ?
     3277     ,output v-b-code
     3278     )  .
     3279                   if PrintRubl
     3280                   then do:
