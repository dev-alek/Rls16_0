     2506   define frame x1
     2507           sym1                column-label ":!:"                      format "X(1)" space(0)
     2508           ub.bar-code.b-code     column-label "Код     ! "               format ">>>>>>>>>9"
     2509           buf_goods.artic         column-label "Артикул! "                format "X(16)"
     2510           v-gds-name            column-label "Наименование! "           format "X(33)"
     2511           tprice-base         column-label "Цена за ед.!(Б.вал.) "    format ">>>,>>>,>>9.99"
     2512           buf_gds-dtl.doc-qnty    column-label "Количество  !по док-ту"   format "->>>>>>9.<<<"
     2513           buf_gds-dtl.fact-qnty   column-label "Количество   !фактически" format "->>>>>>>9.<<<"
     2514           Sub_Qnty            column-label "Разница кол-во! "         format "->>,>>>,>>9.<<"
     2515           Sub_Price-Base      column-label "Разница сумма!(Б.вал.) "  format "->>>,>>>,>>9.99" space(0)
     2516           sym2                column-label ":!:"                      format "X(1)"
     2517       header
     2518           cur-time-print() at 5 format "X(35)"
     2519           string( "Страница " + string( PAGE-NUMBER, ">>9") ) at 110 format "X(13)" skip
     2520           Line no-label format "X(136)" at 1
     2521       with width 235 down stream-io use-text .
     2522   define frame x1-rubl
     2523           sym1                column-label ":!:"                      format "X(1)" space(0)
     2524           ub.bar-code.b-code     column-label "Код! "                    format ">>>>>>>>>9"
     2525           buf_goods.artic         column-label "Артикул! "                format "X(16)"
     2526           v-gds-name            column-label "Наименование! "           format "X(33)"
     2527           tprice-rubl         column-label "Цена за ед.!(РУБ)"        format ">>>,>>>,>>9.99"
     2528           buf_gds-dtl.doc-qnty    column-label "Количество  !по док-ту"   format "->>>>>>9.<<<"
     2529           buf_gds-dtl.fact-qnty   column-label "Количество   !фактически" format "->>>>>>>9.<<<"
     2530           Sub_Qnty            column-label "Разница кол-во! "         format "->>,>>>,>>9.<<"
     2531           Sub_Price-Rubl      column-label "Разница сумма!(РУБ)"      format "->>>,>>>,>>9.99" space(0)
     2532           sym2                column-label ":!:"                      format "X(1)"
     2533       header
     2534           cur-time-print() at 5 format "X(35)"
     2535           string( "Страница " + string( PAGE-NUMBER, ">>9") ) at 110 format "X(13)" skip
     2536           Line no-label format "X(136)" at 1
     2537       with width 235 down stream-io use-text .
