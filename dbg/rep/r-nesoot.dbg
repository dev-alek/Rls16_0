     2546           s2          column-label "Дата"             format "99/99/9999"
     2547           tqnty_      column-label "Количество"       format "->>>>,>>9.<<<"
     2548           tsum_rubl   column-label "Сумма (РУБ)"      format "->>>>>>,>>>,>>9.99"
     2549       with width 235 down stream-io use-text .
     2550   do
     2551   for buf_our_clients
     2552     , buf_clients
     2553     , buf_trn-doc
     2554     , buf_doc-line
     2555     , buf_gds-dtl
     2556     , buf_goods
     2557     , buf_parts
     2558     , buf_temp_line-by-parts
     2559   on error undo, return error
     2560   :
     2561   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2562     run mainmenu_getcntxt in p-mainmenu-handle
     2563       (output v-cntxt-db-num
     2564       ,output v-cntxt-userid
     2565       ,output v-cntxt-level
     2566       ,output v-cntxt-host-code-obj
     2567       ,output v-cntxt-obj-type
     2568       ,output v-cntxt-obj-code
     2569       ,output v-cntxt-db-num-obj
