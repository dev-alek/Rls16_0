     3352                               UpSub_Price-Base    = Sub_Price-Base
     3353                               UpSub_Price-Rubl    = Sub_Price-Rubl
     3354                               downSub_Qnty        = 0
     3355                               downSub_Price-Base  = 0
     3356                               downSub_Price-Rubl  = 0
     3357                           .
