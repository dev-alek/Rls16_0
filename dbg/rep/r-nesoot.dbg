     1872         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     1873         bf_tt-allsum-line.dsc-base-acc         =  0
     1874         bf_tt-allsum-line.dsc-rubl-acc         =  0
     1875         bf_tt-allsum-line.dsc-cli-acc          =  0
     1876         bf_tt-allsum-line.slt-base-acc         =  0
     1877         bf_tt-allsum-line.slt-rubl-acc         =  0
     1878         bf_tt-allsum-line.slt-cli-acc          =  0
     1879         bf_tt-allsum-line.road-tax-base-acc    =  0
     1880         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     1881         bf_tt-allsum-line.road-tax-cli-acc     =  0
     1882         bf_tt-allsum-line.excise-base-acc      =  0
     1883         bf_tt-allsum-line.excise-rubl-acc      =  0
