     3302                           buf_temp_line-by-parts.doc-qnty                                             @ buf_gds-dtl.doc-qnty
     3303                           buf_temp_line-by-parts.fact-qnty                                            @ buf_gds-dtl.fact-qnty
     3304                           buf_temp_line-by-parts.delta-qnty                                           @ Sub_Qnty
     3305                           buf_temp_line-by-parts.delta-sum-base                                       @ Sub_Price-Base
     3306                           sym2
     3307                       with frame x1.
     3308                       down 1 with frame x1.
     3309                   end.
     3310               end.
     3311           end.
     3312           else do:
     3313               for each buf_gds-dtl no-lock
