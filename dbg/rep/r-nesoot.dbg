     1751   end.
     1752   end procedure.
     1753   procedure clcprtsl_calc-line :
     1754   define input  parameter parrec-line as recid no-undo.
     1755   define variable v-tax-date         as   date                     no-undo.
     1756   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1757   define variable varr-b             as   character                no-undo.
     1758   define variable varr-btype         as   character                no-undo.
     1759   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1760   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1761   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1762   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1763   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1764   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1765   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1766   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1767   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1768   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1769   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1770   define variable varexcise          like ub.price-list.excise     no-undo.
     1771   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1772   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1773   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1774   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1775   define variable v-varsum           as decimal                  no-undo.
     1776   define variable varprice-salef as decimal   no-undo .
     1777   define buffer bf_trn-doc             for ub.trn-doc.
     1778   define buffer bf_doc-line            for ub.doc-line.
     1779   define buffer bf_gds-dtl             for ub.gds-dtl.
     1780   define buffer bf_goods               for ub.goods.
     1781   define buffer bf_parts               for ub.parts.
     1782   define buffer bf_sysconf             for ub.sysconf.
     1783   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1784   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1785   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1786   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1787   define buffer buf_parts        for ub.parts.
     1788   v-calcbypart = no.
     1789   do on error undo, return error return-value :
     1790   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1792     (output varr-b
     1793     )  .
     1794     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1795     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1796     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1797                               bf_goods.prod-type = bf_doc-line.prod-type and
     1798                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1799     if bf_trn-doc.fact-date <> ?        then do:
     1800       assign v-tax-date = bf_trn-doc.fact-date.
     1801     end.
     1802     else do:
     1803       assign v-tax-date = ?.
     1804     end.
     1805   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1806   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1807     (input  bf_goods.gds-code
     1808     ,input  '1':U
     1809     ,input  v-tax-date
     1810     ,input  bf_trn-doc.host-code
     1811     ,input  bf_trn-doc.obj-type
     1812     ,input  bf_trn-doc.obj-code
     1813     ,output v-vat-pc
     1814     ) no-error .
     1815     if error-status :error
     1816     or v-vat-pc = ? then do:
     1817        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1818     end.
     1819     if bf_goods.gds-type = 'у':U or
     1820        bf_trn-doc.status_ = 'запрос':U then do:
     1821       for each bf_tt-allsum-line
     1822       on error undo, return error return-value
     1823        :
     1824         delete bf_tt-allsum-line.
     1825       end.
     1826       create bf_tt-allsum-line.
     1827       assign
     1828        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1829       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1830                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1831                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1832                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1833         assign
     1834           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1835           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1836           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1837           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1838           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1839           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1840           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1841           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1842           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1843           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1844           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1845           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1846           bf_tt-allsum-line.vat-cli-acc          =  ?
     1847           .
     1848       end.
     1849       assign
     1850         bf_tt-allsum-line.cli-qnty             =  ?
     1851         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1852         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1853         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1854         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1855         bf_tt-allsum-line.road-tax-base-doc    =  0
     1856         bf_tt-allsum-line.road-tax-rubl-doc    =  0
