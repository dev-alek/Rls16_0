     1955           bfs_tt-allsum-line.other-cli-acc       =  - bf_tt-allsum-line.other-cli-acc
     1956           .
     1957       end.
     1958       create bfo_tt-allsum-line.
     1959       assign
     1960         bfo_tt-allsum-line.sum-type = 'сумма_по_услуге':U.
     1961       buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfo_tt-allsum-line.
     1962       create bfos_tt-allsum-line.
     1963       assign
     1964         bfos_tt-allsum-line.sum-type = 'сумма_по_услуге_со_знаком':U.
     1965       buffer-copy bfs_tt-allsum-line except bfs_tt-allsum-line.sum-type to bfos_tt-allsum-line.
     1966     end.
     1967     else do:
     1968       assign
     1969         varlastcur-base      = 0
     1970         varlastcur-road-tax  = 0
     1971         varlastcur-excise    = 0
     1972         varcur-base          = 0
     1973         varcur-road-tax      = 0
     1974         varcur-excise        = 0
     1975         varcur-vat-pc        = 0
     1976         varcur-slt-pc        = 0
     1977         varcur-fact-qnty     = 0
     1978       .
     1979   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1980     (input  bf_goods.gds-code
     1981     ,input  ?
     1982     ,output varb-code
     1983     )  .
     1984   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1985   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     1986     (input  bf_trn-doc.obj-type
     1987     ,input  bf_trn-doc.obj-code
     1988     ,input  varb-code
     1989     ,input  0
     1990     ,input  bf_trn-doc.fact-order
     1991     ,output vardoc-num
     1992     ,output varprice-sale
     1993     ,output varroad-tax
     1994     ,output varexcise
     1995     ,output varcur-vat-pc
     1996     ,output varcur-slt-pc
     1997     )  .
     1998       if varprice-sale = ?
     1999       then do:
     2000         assign
     2001           varcur-vat-pc = 0
     2002           varcur-slt-pc = 0
     2003         .
     2004       end.
     2005   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2006   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2007     (input  bf_goods.gds-code
     2008     ,input  '1':U
     2009     ,input  bf_trn-doc.fact-date
     2010     ,input  bf_trn-doc.host-code
     2011     ,input  bf_trn-doc.obj-type
     2012     ,input  bf_trn-doc.obj-code
     2013     ,output varcur-vat-pc
     2014     ) no-error .
     2015       if varcur-vat-pc = ?
     2016       then do:
     2017         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2018       end.
     2019       if varcur-slt-pc = ?
     2020       then do:
     2021         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2022       end.
     2023       v-calcbypart = no.
     2024       if bf_doc-line.whole-send-news = integer('1':U)   then
     2025       v-calcbypart = yes.
     2026       else do:
     2027       for each bf_gds-dtl no-lock
     2028         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2029           and bf_gds-dtl.artic     = bf_doc-line.artic
     2030           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     2031           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     2032       on error undo, return error return-value
     2033       :
     2034   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2035     (input  bf_goods.gds-code
     2036     ,input  bf_gds-dtl.prt-code
     2037     ,output varb-code
     2038     ) no-error .
     2039   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2041     (input  bf_trn-doc.obj-type
     2042     ,input  bf_trn-doc.obj-code
     2043     ,input  varb-code
     2044     ,input  0
     2045     ,input  bf_trn-doc.fact-order
     2046     ,output vardoc-num
     2047     ,output varprice-sale
     2048     ,output varroad-tax
     2049     ,output varexcise
     2050     )  .
     2051             if varprice-sale = ?
     2052             then do:
     2053               assign
     2054                 varprice-sale = 0
     2055                 varroad-tax   = 0
     2056                 varexcise     = 0
     2057               .
     2058             end.
     2059             assign
     2060               varlastcur-base     = varprice-sale
     2061               varlastcur-road-tax = varroad-tax
     2062               varlastcur-excise   = varexcise
     2063               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2064               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2065               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2066               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2067             .
     2068         end.
     2069       end.
     2070       if varcur-fact-qnty = 0 then do:
     2071         assign
     2072           varcur-base      = varlastcur-base
     2073           varcur-road-tax  = varlastcur-road-tax
     2074           varcur-excise    = varlastcur-excise
     2075         .
     2076       end.
     2077       else do:
     2078         assign
     2079           varcur-base      = varcur-base      / varcur-fact-qnty
     2080           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2081           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2082         .
     2083       end.
     2084       if varcur-vat-pc = ?
     2085       then do:
     2086         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2087       end.
     2088       if varcur-slt-pc = ?
     2089       then do:
     2090         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2091       end.
     2092       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2093       assign
     2094         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2095       if varcur-cons-vat-pc = ? then do:
     2096         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     2097       end.
     2098       define buffer buf_tt-clcparts for tt-clcparts .
     2099       for each buf_tt-clcparts
     2100       on error undo, return error return-value
     2101       :
     2102         delete buf_tt-clcparts.
     2103       end.
     2104       for each bf_parts no-lock
     2105         where bf_parts.out-code  = bf_doc-line.doc-code
     2106           and bf_parts.obj-type  = bf_doc-line.obj-type
     2107           and bf_parts.obj-code  = bf_doc-line.obj-code
     2108           and bf_parts.artic     = bf_doc-line.artic
     2109           and bf_parts.prod-type = bf_doc-line.prod-type
     2110           and bf_parts.prod-code = bf_doc-line.prod-code
     2111       on error undo, return error return-value
     2112       :
     2113         create buf_tt-clcparts .
     2114         buffer-copy bf_parts to buf_tt-clcparts .
     2115         if v-calcbypart = yes   then do:
     2116   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2117     (buffer bf_parts
     2118     ,output v-b-pcode
     2119     ) no-error .
     2120   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2121   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2122     (input  bf_parts.obj-type
     2123     ,input  bf_parts.obj-code
     2124     ,input  v-b-pcode
     2125     ,input  0
     2126     ,input  bf_trn-doc.fact-order
     2127     ,output vardoc-num
     2128     ,output varprice-salef
     2129     ,output varroad-tax
     2130     ,output varexcise
     2131     ) no-error .
     2132             if varprice-sale = ?
     2133             then do:
     2134               assign
     2135                 varprice-salef = 0
     2136                 varroad-tax   = 0
     2137                 varexcise     = 0
     2138               .
     2139             end.
     2140             assign
     2141             part-cur-base  = varprice-salef
     2142             part-cur-road-tax  = varroad-tax
     2143             part-cur-excise = varexcise.
     2144         end.
     2145       end.
     2146       run clcprtsl_calc-ttable in this-procedure
     2147         (input yes,
     2148          input yes,
     2149          input bf_doc-line.road-tax,
     2150          input bf_doc-line.excise,
     2151          input bf_doc-line.vat-pc,
     2152          input bf_doc-line.cons-vat-pc,
     2153          input bf_doc-line.slt-pc,
     2154          input bf_trn-doc.base-rate,
     2155          input bf_trn-doc.base-scale,
     2156          input varr-b,
     2157          input varcur-base,
     2158          input varcur-road-tax,
     2159          input varcur-excise,
     2160          input varcur-vat-pc,
     2161          input varcur-cons-vat-pc,
     2162          input varcur-slt-pc
     2163          ) no-error.
     2164       if error-status:error then do:
     2165         message
     2166           vss-workfile vss-revision vss-description skip
     2167           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     2168           return-value skip
     2169           trim(error-status :get-message(1))
     2170           trim(error-status :get-message(2))
     2171           trim(error-status :get-message(3))
     2172           trim(error-status :get-message(4))
     2173           trim(error-status :get-message(5)) skip
     2174           view-as alert-box error.
     2175         undo, return error .
     2176       end.
     2177     end.
     2178   end.
     2179   end.
     2180   procedure clcprtsl_calc-ttable :
     2181   define input parameter paris-doc           as   logical                 no-undo.
     2182   define input parameter paris-cur           as   logical                 no-undo.
     2183   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2184   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2185   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2186   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2187   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2188   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2189   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2190   define input parameter parr-b              as   character               no-undo.
     2191   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2192   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2193   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2194   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2195   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2196   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2197   define buffer bf_tt-allsum      for tt-allsum.
     2198   define buffer bf_tt-clcparts    for tt-clcparts.
     2199   define buffer bf_tt-allsum-line for tt-allsum-line.
     2200   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2201   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2202   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2203   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2204   define variable varexcise          like ub.price-list.excise     no-undo.
     2205   do on error undo, return error return-value :
     2206   for each bf_tt-allsum-line
     2207   on error undo, return error return-value
     2208    :
     2209     delete bf_tt-allsum-line.
     2210   end.
     2211   for each bf_tt-allsum
     2212   on error undo, return error return-value
     2213   :
     2214     delete bf_tt-allsum.
     2215   end.
     2216   for each bf_tt-clcparts
     2217   on error undo, return error return-value
     2218   :
     2219   if v-calcbypart then do:
     2220             assign
     2221             parcur-base =   bf_tt-clcparts.part-cur-base
     2222             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2223             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2224             .
     2225   end.
