      998       assign
      999         varcurclprice-base = out-vatp_gds-dtlcl.cur-base
     1000         varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base * ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)).
     1001     end.
     1002     else do:
     1003       assign
     1004         varcurclprice-base = out-vatp_gds-dtlcl.cur-base / ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base))
     1005         varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base.
     1006     end.
