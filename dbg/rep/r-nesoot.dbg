     2577       ).
     2578   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2579   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2580     (input  v-cntxt-host-code-obj
     2581     ,output v-base-code
     2582     )  .
     2583   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2584   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2585     (output v-sys-key
     2586     ) no-error .
     2587       find first buf_trn-doc no-lock
     2588            where recid( buf_trn-doc ) = rec_id
     2589       .
     2590       if not buf_trn-doc.print-rubl
     2591       then do:
     2592           message "Документ печатать в РУБЛЯХ ?"
     2593           view-as ALERT-BOX QUESTIon BUTtonS yes-no TITLE "" UPdate PrintRubl.
     2594       end.
     2595       else do:
     2596           assign PrintRubl = yes .
     2597       end.
     2598   Line = fill("-", 140).
     2599   find first buf_clients no-lock
     2600        where buf_clients.obj-type = buf_trn-doc.cli-type
     2601          and buf_clients.obj-code = buf_trn-doc.cli-code
     2602   .
     2603   find first ub.pay-type no-lock
     2604        where ub.pay-type.obj-code = buf_trn-doc.pay-code
     2605   no-error.
     2606   assign
     2607       s1 = ( if available ub.pay-type then ub.pay-type.obj-name else "" )
     2608   .
     2609   find first buf_our_clients no-lock
     2610        where buf_our_clients.obj-type = buf_trn-doc.obj-type
     2611          and buf_our_clients.obj-code = buf_trn-doc.obj-code
     2612   .
     2613   run rep/get-psn.p ( input buf_trn-doc.boss, output s2 ).
     2614   run rep/get-psn.p ( input buf_trn-doc.wrkr, output s3 ).
     2615   run rep/get-psn.p ( input buf_trn-doc.agnt, output Isp_name ) .
     2616   output   to value( string( session:temp-directory +
     2617                                        "rpt" + string( g#report-num ) ) )
     2618                                        page-size 62 .
     2619   put
     2620       skip
     2621       space(35) "АКТ НЕСООТВЕТСТВИЯ по " format "X(22)"
     2622   .
     2623   case buf_trn-doc.doc-type :
     2624       when 'при':U
     2625       then do:
     2626           put
     2627               "приходной накладной N " format "X(22)"
     2628           .
     2629       end.
     2630       when 'рас':U
     2631       then do:
     2632           if buf_trn-doc.internal
     2633           then do:
     2634               put
     2635                   "требованию N " format "X(13)"
     2636               .
     2637           end.
     2638           else do:
     2639               put
     2640                   "расходной накладной N " format "X(22)"
     2641               .
     2642           end.
     2643       end.
     2644       when 'возврат':U
     2645       then do:
     2646           put
     2647               "возвратной накладной N " format "X(24)"
     2648           .
     2649       end.
     2650       when 'инв':U
     2651       then do:
     2652           case buf_trn-doc.ext-doc-type
     2653           :
     2654               when 'vt':U
     2655               then do:
     2656                   put
     2657                       "инвентаризационной описи N " format "X(30)"
     2658                   .
     2659               end.
     2660               when 'vp':U
     2661               then do:
     2662                   put
     2663                       "пересортицы N " format "X(30)"
     2664                   .
     2665               end.
     2666               when 'ap':U
     2667               then do:
     2668                   put
     2669                       "документа коррекции учетных цен N " format "X(34)"
     2670                   .
     2671               end.
     2672               when 'pc':U
     2673               then do:
     2674                   put
     2675                       "документа смены типа приобретения N " format "x(36)"
     2676                   .
     2677               end.
     2678           end case.
     2679       end.
     2680   end case.
     2681   put
     2682       substitute( "&1 от &2/&3/&4"
     2683                   , buf_trn-doc.doc-code
     2684                   , day( buf_trn-doc.doc-date )
     2685                   , month( buf_trn-doc.doc-date )
     2686                   , year( buf_trn-doc.doc-date ) )
     2687                                                       format "X(100)"
     2688       skip(1)
     2689   .
     2690   if lookup( buf_trn-doc.doc-type, 'при,возврат':U ) <> 0
     2691   then do:
     2692     if v-sys-key begins "Repin" then do:
     2693       define buffer b_host for ub.clients .
     2694       find first b_host no-lock where b_host.obj-type = 'орг':U and b_host.obj-code = buf_trn-doc.host-code .
     2695       put space(10) "Поставщик  : "  buf_clients.obj-name format "x(40)"  skip
     2696           space(10) "Покупатель : "  b_host.obj-name format "x(40)"  skip
     2697           space(10) "Получатель : "  buf_our_clients.obj-type format "x(4)" buf_our_clients.obj-name format "x(40)"  skip(1)
     2698       .
     2699     end.
     2700     else do:
     2701       put
     2702           space(10)
     2703           "От кого : "
     2704           buf_clients.obj-name format "x(40)"
     2705           skip
     2706       .
     2707   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-xst in g#trdcalib (  input buf_trn-doc.doc-code ,
     2708                           input 'nids':U ,
     2709                          output v-exists-ord-num )  .
     2710       if v-exists-ord-num = yes
     2711       then do:
     2712   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     2713                           input 'nids':U ,
     2714                          output v-attr-value ,
     2715                          output v-attr-type )  .
     2716           assign
     2717               v-ord-num = v-attr-value
     2718           .
     2719   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     2720                           input 'dids':U ,
     2721                          output v-attr-value ,
     2722                          output v-attr-type )  .
     2723           assign
     2724               v-ord-num = v-ord-num + " от " + v-attr-value
     2725           .
     2726           put space(10)
     2727               "Заказ   : "
     2728               v-ord-num  format "x(40)"
     2729               skip
     2730           .
     2731       end.
     2732       put space(10)
     2733           "Кому    : " buf_our_clients.obj-type format "x(4)"
     2734           buf_our_clients.obj-name format "x(40)"
     2735           skip(1)
     2736       .
     2737     end.
     2738   end.
     2739   else do:
     2740       if buf_trn-doc.doc-type = 'инв':U
     2741       then do:
     2742           put
     2743                   space(10) "От кого : "
     2744                   buf_our_clients.obj-name format "x(40)"
     2745               skip
     2746                   space(10) "Кому    : "
     2747                   buf_our_clients.obj-name format "x(40)"
     2748               skip(1)
     2749           .
     2750       end.
     2751       else do:
     2752           put
     2753                   space(10) "От кого : "
     2754                   buf_our_clients.obj-name format "x(40)"
     2755               skip
     2756                   space(10) "Кому    : "
     2757                   buf_clients.obj-name format "x(40)"
     2758               skip(1)
     2759           .
     2760       end.
     2761   end.
     2762   put
     2763           space(10) "Торговый представитель : " + s2          format "X(60)"
     2764           space(5)  "Кладовщик              : " + s3          format "X(60)"
     2765       skip
     2766           space(10) "Исполнитель            : " + Isp_name    format "X(60)"
     2767           space(5)  "Вид оплаты             : " + s1          format "X(60)"
     2768       skip
     2769   .
     2770       put
     2771           space(75)
     2772           "Курс                   : " + string( buf_trn-doc.base-rate / buf_trn-doc.base-scale, ">>>,>>9.9999" ) format "X(60)"
     2773           skip(1)
     2774       .
     2775   if CostPrice = yes
     2776   then do:
     2777       put
     2778           space(40) "Указаны учетные цены." format "X(60)"
     2779           skip
     2780       .
     2781   end.
     2782   else do:
     2783       put
     2784           space(40) "Указаны  цены  документа." format "X(60)"
     2785           skip
     2786       .
     2787   end.
     2788   if PrintRubl
     2789   then do:
     2790       form with frame x1-rubl.
     2791   end.
     2792   else do:
     2793       form with frame x1.
     2794   end.
     2795   form header
     2796           Line format "X(136)" at 1
     2797           skip "Продолжение - на следующей странице" at 30
     2798           skip
