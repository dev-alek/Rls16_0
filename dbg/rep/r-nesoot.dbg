     2539           s1          no-label                        format "X(20)"
     2540           s2          column-label "Дата"             format "99/99/9999"
     2541           tqnty_      column-label "Количество"       format "->>>>,>>9.<<<"
     2542           tsum_base   column-label "Сумма (Б.вал.)"   format "->>,>>>,>>>,>>9.99"
     2543       with  width 235 down stream-io use-text .
