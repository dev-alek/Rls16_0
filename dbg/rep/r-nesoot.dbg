     3242                           v-tot-downSub_Qnty       = v-tot-downSub_Qnty       + ( if buf_temp_line-by-parts.delta-qnty > 0 then buf_temp_line-by-parts.delta-qnty else 0 )
     3243                           v-tot-downSub_Price-Base = v-tot-downSub_Price-Base + ( if buf_temp_line-by-parts.delta-qnty > 0 then buf_temp_line-by-parts.delta-sum-base else 0 )
     3244                           v-tot-downSub_Price-Rubl = v-tot-downSub_Price-Rubl + ( if buf_temp_line-by-parts.delta-qnty > 0 then buf_temp_line-by-parts.delta-sum-rubl else 0 )
     3245                       .
     3246                   end.
     3247                   else do:
     3248                       assign
