     3287                           buf_temp_line-by-parts.doc-qnty                                             @ buf_gds-dtl.doc-qnty
     3288                           buf_temp_line-by-parts.fact-qnty                                            @ buf_gds-dtl.fact-qnty
     3289                           buf_temp_line-by-parts.delta-qnty                                           @ Sub_Qnty
     3290                           buf_temp_line-by-parts.delta-sum-rubl                                       @ Sub_Price-Rubl
     3291                           sym2
     3292                       with frame x1-rubl.
     3293                       down 1 with frame x1-rubl.
     3294                   end.
     3295                   else do:
     3296                       display
     3297                           sym1
     3298                           v-b-code                                                                    @ ub.bar-code.b-code
     3299                           buf_goods.artic
