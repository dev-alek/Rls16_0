     3359                       else do:
     3360                           assign
     3361                               UpSub_Qnty          = 0
     3362                               UpSub_Price-Base    = 0
     3363                               UpSub_Price-Rubl    = 0
     3364                               downSub_Qnty        = Sub_Qnty
     3365                               downSub_Price-Base  = Sub_Price-Base
     3366                               downSub_Price-Rubl  = Sub_Price-Rubl
     3367                           .
     3368                       end.
     3369                   end.
     3370                   else do:
