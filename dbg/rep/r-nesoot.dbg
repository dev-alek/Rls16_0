     3325                       v-tot-doc-qnty            = v-tot-doc-qnty            + buf_gds-dtl.doc-qnty
     3326                       v-tot-doc-qnty-base   = v-tot-doc-qnty-base   + ( buf_gds-dtl.doc-qnty  * tprice-base )
     3327                       v-tot-doc-qnty-rubl   = v-tot-doc-qnty-rubl   + ( buf_gds-dtl.doc-qnty  * tprice-rubl )
     3328                       v-tot-fact-qnty-base  = v-tot-fact-qnty-base  + ( buf_gds-dtl.fact-qnty * tprice-base )
     3329                       v-tot-fact-qnty-rubl  = v-tot-fact-qnty-rubl  + ( buf_gds-dtl.fact-qnty * tprice-rubl )
     3330                       v-tot-dsc-doc-qnty-base   = v-tot-dsc-doc-qnty-base   + ( buf_gds-dtl.doc-qnty  * buf_gds-dtl.discnt-base )
     3331                       v-tot-dsc-doc-qnty-rubl   = v-tot-dsc-doc-qnty-rubl   + ( buf_gds-dtl.doc-qnty  * buf_gds-dtl.discnt-rubl )
