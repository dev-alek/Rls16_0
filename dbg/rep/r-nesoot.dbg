     1944           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
     1945           bfs_tt-allsum-line.road-tax-rubl-acc   =  - bf_tt-allsum-line.road-tax-rubl-acc
     1946           bfs_tt-allsum-line.road-tax-cli-acc    =  - bf_tt-allsum-line.road-tax-cli-acc
     1947           bfs_tt-allsum-line.excise-base-acc     =  - bf_tt-allsum-line.excise-base-acc
     1948           bfs_tt-allsum-line.excise-rubl-acc     =  - bf_tt-allsum-line.excise-rubl-acc
     1949           bfs_tt-allsum-line.excise-cli-acc      =  - bf_tt-allsum-line.excise-cli-acc
     1950           bfs_tt-allsum-line.transport-base-acc  =  - bf_tt-allsum-line.transport-base-acc
     1951           bfs_tt-allsum-line.transport-rubl-acc  =  - bf_tt-allsum-line.transport-rubl-acc
     1952           bfs_tt-allsum-line.transport-cli-acc   =  - bf_tt-allsum-line.transport-cli-acc
     1953           bfs_tt-allsum-line.other-base-acc      =  - bf_tt-allsum-line.other-base-acc
