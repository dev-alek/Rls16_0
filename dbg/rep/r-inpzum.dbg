     5296   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     5297     (input  buf_goods.artic
     5298     ,input  buf_goods.prod-type
     5299     ,input  buf_goods.prod-code
     5300     ,output v-root-node
     5301     )  .
     5302   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     5303     (input  v-root-node
     5304     ,input  'empty-scale=request'
     5305     ,output empty-scale
     5306     )  .
     5307       assign
     5308         Price       = buf_doc-line.fact-qnty
     5309         qnty        = buf_doc-line.doc-qnty
     5310         all-qnty    = all-qnty    + qnty
     5311         all-stoim   = all-stoim   + Price
     5312       .
     5313       if empty-scale = no and PrintScale = yes then do:
     5314         display stream out_stream sym1  Lines_Counter sym2 tb-code sym3 buf_goods.artic sym4 gds_name sym5 buf_goods.unit-base sym6 sym7 sym8 sym9 with frame akt.
     5315         down stream out_stream with frame akt .
     5316         if buf_goods.engl-name <> "" then  do:
     5317           display stream out_stream sym1 sym2 buf_goods.engl-name  @ gds_name  sym5 sym6 sym8 sym7 sym9  with frame akt .
     5318           down stream out_stream 1 with frame akt .
     5319         end.
     5320         for each buf_gds-dtl no-lock
     5321           where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     5322             and buf_gds-dtl.artic     = buf_doc-line.artic
     5323             and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     5324             and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     5325           :
     5326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5327     (input  buf_goods.gds-code
     5328     ,input  buf_gds-dtl.prt-code
     5329     ,output b-code
     5330     ) no-error .
     5331           if error-status :error then do:
     5332             message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip  "Код товара" buf_goods.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip
     5333             view-as alert-box error .
     5334           end.
     5335           find first gds-prt where gds-prt.node-code  = buf_gds-dtl.prt-code no-lock no-error .
     5336           display stream out_stream
     5337             sym1  sym2   string(b-code)           @ tb-code
     5338             sym3 sym4    ('  /'+ gds-prt.f-name)  @ gds_name
     5339             sym5 sym6    buf_gds-dtl.fact-qnty    @ Price
     5340             sym7         buf_gds-dtl.doc-qnty     @ qnty
     5341             sym8 (buf_gds-dtl.fact-qnty - buf_gds-dtl.doc-qnty ) @ stoim
     5342             sym9
     5343           with frame akt.
     5344           down stream out_stream with frame akt .
     5345         end.
     5346       end.
     5347       else do:
     5348         display stream out_stream sym1 Lines_Counter sym2 tb-code sym3 buf_goods.artic sym4 gds_name sym5 buf_goods.unit-base sym6  Price sym7 qnty sym8 (Price - qnty) @ stoim sym9  with frame akt.
     5349         down stream out_stream with frame akt .
     5350         if buf_goods.engl-name <> "" then  do:
     5351           display stream out_stream sym1 sym2 buf_goods.engl-name  @ gds_name  sym5 sym6 sym8 sym7 sym9  with frame akt .
     5352           down stream out_stream 1 with frame akt .
     5353         end.
     5354       end.
     5355         end.
     5356         when 2
     5357         then do:
     5358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5359     (input  buf_goods.gds-code
     5360     ,input  ?
     5361     ,output b-code
     5362     ) no-error .
