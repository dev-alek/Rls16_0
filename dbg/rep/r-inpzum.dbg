     5364       message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" buf_goods.gds-code skip
     5365       view-as alert-box error .
     5366     end.
     5367     assign
     5368       gds_name = buf_goods.gds-name
     5369       Lines_Counter = Lines_Counter + 1
     5370       tb-code = string(b-code)
     5371     .
