     4438       "Ошибка при определении атрибута признака" skip
     4439       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     4440       "Признак" varroot-node skip
     4441       "Запрашивался атрибут" "empty-scale=request" skip
     4442       error-status :get-message(1) skip
     4443       return-value skip
