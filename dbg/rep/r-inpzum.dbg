     5157                                            "Начальник склада__________" format "X(35)" skip.
     5158       hide stream Out_stream frame Akt-Bottomframe .
     5159     end.
     5160     output stream Out_stream close .
     5161     run print.
     5162   end.
     5163   procedure print-titul :
     5164     do on error undo, return error return-value :
     5165       if num-form > 1
     5166       then do:
     5167         if buf_trn-doc.internal then put stream Out_stream  "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - П Р И Х О Д   N " at 22 format "X(55)"
     5168                    v-doc-code format "X(10)" "  от  " v-doc-date-string format "X(10)" skip(1) .
     5169         else put stream Out_stream "П Р И Х О Д Н А Я   Н А К Л А Д Н А Я   N  " at 32 format "X(45)" v-doc-code format "X(10)" "  от  " v-doc-date-string format "X(10)" skip(1) .
     5170         put stream Out_stream string( "Отправитель  : " + buf_clients.obj-name + " (" + buf_clients.obj-type + " " + string(buf_clients.obj-code) + ")" ) at 10 format "X(120)" skip
     5171                 string( "Получатель   : " + Our_Host.obj-name + ",  " + Our_Object.obj-name ) at 10 format "X(125)" skip(1) .
     5172         find pay-type where pay-type.obj-code = buf_trn-doc.pay-code no-lock no-error .
     5173         if buf_trn-doc.internal
     5174         then do:
     5175           put stream Out_stream "Вид оплаты   : " at 10 format  "x(15)" ( if available pay-type then pay-type.obj-name else "?" ) format "X(60)" skip .
     5176         end.
     5177         else do:
     5178           put stream Out_stream "Основание    : " at 10 format  "x(15)" ( if buf_trn-doc.ord-num <> "" then  "заказ N" + trim(buf_trn-doc.ord-num)
     5179               else fill( " ", 10) ) format "X(110)" skip "Инвойс       : " at 10 format "x(15)"
     5180               ( if buf_trn-doc.inv-num <> "" then fill(" ", 10 - length(trim(string( buf_trn-doc.inv-num)))) +
     5181               trim(string( buf_trn-doc.inv-num, "x(8)") ) else fill( " ", 8) ) format "X(10)" skip.
     5182             if Rubl_Coeff <> 1 then put stream Out_stream "Таможня      : " at 10 format "x(15)" buf_trn-doc.exch-date format "99.99.9999" skip.
     5183           put stream Out_stream "Вид оплаты   : " at 10 format "X(15)" ( if available pay-type then pay-type.obj-name else "?" ) format "X(30)" skip.
     5184             if Rubl_Coeff <> 1 then put stream Out_stream "Курс         : " at 10 format "x(15)" Rubl_Coeff format ">>>,>>9.9999" skip .
     5185             if buf_trn-doc.discnt-pc <> 0 then put stream Out_stream "Тамож. налог : " at 10 format "X(15)" buf_trn-doc.discnt-pc skip .
     5186         end.
     5187         if v-torgconf-outprim = no
     5188         then do:
     5189           put stream Out_stream "Примечание   : "  at 10  format "X(15)" (if not( buf_trn-doc.PS BEGinS "@" ) then buf_trn-doc.PS else "" )  format "X(100)" skip(1) .
     5190         end.
     5191         case num-form :
     5192           when 2 then form with frame Zum-rubl .
     5193           when 3 then form with frame Nakl-rubl .
     5194           when 4 then form with frame Zum-jew .
     5195         end.
     5196         form header
     5197           Line format "X(136)" at 1 skip  "Продолжение - на следующей странице" at 30 skip
     5198           with frame Bottomframe width 232 page-bottom no-labels no-box.
     5199         view stream Out_stream frame Bottomframe .
     5200       end.
     5201       else do:
     5202         put stream Out_stream "Приходный  акт  N  " at 40 format "X(20)" v-doc-code format "X(8)"
     5203                 "  от  " v-doc-date-string format "X(10)" skip(1) "на осмотр и приемку товаров, поступивших " at 30 format "X(45)"
     5204                 (if buf_trn-doc.obj-type = 'скл':U then "на склад" else "в магазин") format "X(10)" Our_Object.obj-name format "X(40)" skip
     5205                 Our_Host.obj-name at 30 format "X(45)" " от поставщика " format "X(15)" skip  "согласно ________________" at 30 format "X(25)"
     5206                 " N ____________" format "X(15)" " от " '"____"_____________' format "X(20)"
     5207                 string( string( year( buf_trn-doc.doc-date ) ) + " г." )  format "X(20)" skip(1) .
     5208         if not buf_trn-doc.internal then
     5209           put stream Out_stream  "Заказ        : "
     5210               at 40 format  "x(15)"  ( if buf_trn-doc.ord-num <> "" then fill(" ", 10 - length(trim(string( buf_trn-doc.ord-num)))) +
     5211               trim(string( buf_trn-doc.ord-num, "x(10)") ) else fill( " ", 10) ) format "X(10)"
     5212               "Таможня : " at 75 format "x(12)" space(3) buf_trn-doc.exch-date format "99.99.9999" skip
     5213               "Инвойс       : " at 40 format "x(15)" ( if buf_trn-doc.inv-num = "" then "   " else buf_trn-doc.inv-num ) format "x(20)"
     5214               "Курс    : " format "x(12)" space(3) Rubl_Coeff format ">>>,>>9.9999" skip(1) .
     5215         form with frame AKT .
     5216         form header
     5217              Line format "X(136)" at 1 skip "Продолжение - на следующей странице" at 30 skip
     5218              with frame Akt-Bottomframe width 160 page-bottom no-labels no-box.
     5219         view stream Out_stream frame Akt-Bottomframe .
     5220       end.
     5221     end.
     5222   end procedure.
     5223   procedure Print-prod :
     5224     do on error undo, return error return-value :
     5225       find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-lock .
     5226       case num-form :
     5227         when 1
     5228         then do:
     5229           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym9 with frame akt .
     5230           down stream out_stream 1 with frame akt .
     5231         end.
     5232         when 2
     5233         then do:
     5234           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym9 with frame Zum-rubl .
     5235           down stream out_stream 1 with frame Zum-rubl .
     5236         end.
     5237         when 3
     5238         then do:
     5239           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame rubl .
     5240           down stream out_stream 1 with frame rubl .
     5241         end.
     5242         when 4
     5243         then do:
     5244           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym9 with frame Zum-jew .
     5245           down stream out_stream 1 with frame Zum-jew .
     5246         end.
     5247       end.
     5248     end.
     5249   end procedure.
     5250   procedure print-grp :
     5251     do on error undo, return error return-value :
     5252       case num-form :
     5253         when 1
     5254         then do:
     5255           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym9 with frame akt .
     5256           down stream out_stream 1 with frame akt .
     5257         end.
     5258         when 2
     5259         then do:
     5260           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym9 with frame Zum-rubl .
     5261           down stream out_stream 1 with frame Zum-rubl .
     5262         end.
     5263         when 3
     5264         then do:
     5265           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame rubl .
     5266           down stream out_stream 1 with frame rubl .
     5267         end.
     5268         when 4
     5269         then do:
     5270           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym9 with frame Zum-jew .
     5271           down stream out_stream 1 with frame Zum-jew .
     5272         end.
     5273       end.
     5274     end.
     5275   end procedure.
     5276   procedure print-line :
     5277     do on error undo, return error return-value :
     5278       case num-form :
     5279         when 1
     5280         then do:
     5281   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5282     (input  buf_goods.gds-code
     5283     ,input  ?
     5284     ,output b-code
     5285     ) no-error .
