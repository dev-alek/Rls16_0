     1085       define variable v-outB      as character     no-undo.
     1086       define variable v-outC      as character     no-undo.
     1087       assign
     1088           v-torgconf-outdate  = no
     1089           v-torgconf-outnum   = no
     1090           v-torgconf-outprim  = no
     1091           v-torgconf-outdisc  = no
     1092           v-torgconf-outsubs  = no
     1093           v-torgconf-outrecv  = no
     1094           v-torgconf-outegrp  = no
     1095           v-torgconf-outt12   = no
     1096           v-torgconf-outappr  = no
     1097           v-torgconf-outrubl  = no
     1098           v-torgconf-outhold  = no
     1099           v-torgconf-outobj   = no
     1100           v-torgconf-outexlst = no
     1101           v-torgconf-outexpas = "":U
     1102           v-torgconf-outprncd = yes
     1103           v-torgconf-outares  = no
     1104           v-torgconf-outsend  = no
     1105           v-torgconf-outasend  = no
     1106           v-torgconf-outprops  = no
     1107           v-form-name          = p-form-name
     1108       .
     1109   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1110   empty temp-table thbjattr_thbj-attr.
     1111   run adm/shattri.p (
     1112      input "get":U
     1113     ,input ''
     1114     ,input 0
     1115     ,input 'prt-glob':U
     1116     ,input  ""
     1117     ,output v-value-character
     1118     ,output v-value-date
     1119     ,output v-value-decimal
     1120     ,output v-value-integer
     1121     ,output v-value-logical
     1122     ,output par-type
     1123     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1124     ) no-error .
     1125   for each thbjattr_thbj-attr :
     1126       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1127       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1128       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1129   end.
     1130   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   empty temp-table thbjattr_thbj-attr.
     1132   run adm/shattri.p (
     1133      input "get":U
     1134     ,input p-obj-type
     1135     ,input p-obj-code
     1136     ,input 'prt-obj':U
     1137     ,input  ""
     1138     ,output v-value-character
     1139     ,output v-value-date
     1140     ,output v-value-decimal
     1141     ,output v-value-integer
     1142     ,output v-value-logical
     1143     ,output par-type
     1144     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1145     ) no-error .
     1146   for each thbjattr_thbj-attr :
     1147       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1148       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1149       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1150       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1151       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1152       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1153       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1154       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1155       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1156       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1157       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1158       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1159       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1160       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1161       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1162       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1163       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1164       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1165       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1166   end.
     1167       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1168       if error-status :error
     1169       then do:
     1170           assign
     1171               v-torgconf-outexpas = "":U
     1172           .
     1173       end.
     1174       assign
     1175           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1176       .
     1177       if p-form-name <> ""
     1178       and p-form-name <> ?
     1179       then do:
     1180           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1181           if error-status :error
     1182           then do:
     1183               assign
     1184                   v-outexlst           = ""
     1185               .
     1186           end.
     1187           if lookup( p-form-name, v-outdate ) <> 0
     1188           then do:
     1189               assign
     1190                   v-torgconf-outdate  = yes
     1191               .
     1192           end.
     1193           if lookup( p-form-name, v-outares ) <> 0
     1194           then do:
     1195               assign
     1196                   v-torgconf-outares  = yes
     1197               .
     1198           end.
     1199           if lookup( p-form-name, v-outnum  ) <> 0
     1200           then do:
     1201               assign
     1202                   v-torgconf-outnum   = yes
     1203               .
     1204           end.
     1205           if lookup( p-form-name, v-outprim ) <> 0
     1206           then do:
     1207               assign
     1208                   v-torgconf-outprim  = yes
     1209               .
     1210           end.
     1211           if lookup( p-form-name, v-outdisc ) <> 0
     1212           then do:
     1213               assign
     1214                   v-torgconf-outdisc  = yes
     1215               .
     1216           end.
     1217           if lookup( p-form-name, v-outsubs ) <> 0
     1218           then do:
     1219               assign
     1220                   v-torgconf-outsubs  = yes
     1221               .
     1222           end.
     1223           if lookup( p-form-name, v-outrecv ) <> 0
     1224           then do:
     1225               assign
     1226                   v-torgconf-outrecv  = yes
     1227               .
     1228           end.
     1229           if lookup( p-form-name, v-outegrp ) <> 0
     1230           then do:
     1231               assign
     1232                   v-torgconf-outegrp  = yes
     1233               .
     1234           end.
     1235           if lookup( p-form-name, v-outt12  ) <> 0
     1236           then do:
     1237               assign
     1238                   v-torgconf-outt12   = yes
     1239               .
     1240           end.
     1241           if lookup( p-form-name, v-outappr  ) <> 0
     1242           then do:
     1243               assign
     1244                   v-torgconf-outappr   = yes
     1245               .
     1246           end.
     1247           if lookup( p-form-name, v-outrubl  ) <> 0
     1248           then do:
     1249               assign
     1250                   v-torgconf-outrubl   = yes
     1251               .
     1252           end.
     1253           if lookup( p-form-name, v-outhold  ) <> 0
     1254           then do:
     1255               assign
     1256                   v-torgconf-outhold   = yes
     1257               .
     1258           end.
     1259           if lookup( p-form-name, v-outobj   ) <> 0
     1260           then do:
     1261               assign
     1262                   v-torgconf-outobj    = yes
     1263               .
     1264           end.
     1265           if lookup( p-form-name, v-outsend   ) <> 0
     1266           then do:
     1267               assign
     1268                   v-torgconf-outsend    = yes
     1269               .
     1270           end.
     1271           if lookup( p-form-name, v-outasend   ) <> 0
     1272           then do:
     1273               assign
     1274                   v-torgconf-outasend    = yes
     1275               .
     1276           end.
     1277           if lookup( p-form-name, v-outprops   ) <> 0
     1278           then do:
